// انتظار: data-route
واردسازی دام

ناپایا واردشده := نادرست
ناپایا اخیر := وکتور {} برگردان وکتور<رشته>

ناب تابع نام ناحیه(ر: رشته): رشته:
    اگر ر برابر "alborz":
        برگشت "البرز"
    وگرنه ر برابر "zagros":
        برگشت "زاگرس"
    وگرنه ر برابر "sabalan":
        برگشت "سبلان"
    پایان
    برگشت ""
پایان

تابع کوه های ناحیه(ر: رشته): وکتور<رشته>:
    ناپایا و_ := وکتور {} برگردان وکتور<رشته>
    اگر ر برابر "alborz":
        و_.افزودن("darband")
        و_.افزودن("damavand")
    وگرنه ر برابر "zagros":
        و_.افزودن("zardkuh")
        و_.افزودن("dasht-e-lar")
    وگرنه ر برابر "sabalan":
        و_.افزودن("sabalan-camp")
    پایان
    برگشت و_
پایان

ناب تابع نام کوه(ت: رشته): رشته:
    اگر ت برابر "darband":
        برگشت "دربند به شیرپلا"
    وگرنه ت برابر "damavand":
        برگشت "قله دماوند"
    وگرنه ت برابر "zardkuh":
        برگشت "چرخه زردکوه"
    وگرنه ت برابر "dasht-e-lar":
        برگشت "دشت لار"
    وگرنه ت برابر "sabalan-camp":
        برگشت "پناهگاه سبلان"
    پایان
    برگشت ""
پایان

ناب تابع طول کوه(ت: رشته): صحیح:
    اگر ت برابر "darband":
        برگشت 6
    وگرنه ت برابر "damavand":
        برگشت 14
    وگرنه ت برابر "zardkuh":
        برگشت 10
    وگرنه ت برابر "dasht-e-lar":
        برگشت 9
    وگرنه ت برابر "sabalan-camp":
        برگشت 17
    پایان
    برگشت 0
پایان

ناب تابع سختی کوه(ت: رشته): رشته:
    اگر طول کوه(ت) بزرگتربرابر 14:
        برگشت "سخت"
    وگرنه طول کوه(ت) بزرگتربرابر 9:
        برگشت "متوسط"
    پایان
    برگشت "آسان"
پایان

تابع ثبت بازدید(ت: رشته):
    اگر اخیر.طول() برابر 0 یا اخیر[اخیر.طول() - 1] نابرابر ت:
        اخیر.افزودن(ت)
    پایان
پایان

تابع همه ناحیه ها(): وکتور<رشته>:
    ناپایا و_ := وکتور {} برگردان وکتور<رشته>
    و_.افزودن("alborz")
    و_.افزودن("zagros")
    و_.افزودن("sabalan")
    برگشت و_
پایان

تابع یافته ها(پرسش: رشته): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    واژه := پرسش.کوچک()
    هر ر در همه ناحیه ها():
        هر ت در کوه های ناحیه(ر):
            اگر واژه.طول() بزرگتر 0 و نام کوه(ت).کوچک().دربردارد(واژه):
                خروجی.افزودن(ر + "/" + ت)
            پایان
        پایان
    پایان
    برگشت خروجی
پایان

تابع خروج():
    واردشده = نادرست
    صفحه.مسیر.برو("/")
پایان

تابع همین جاست(پریفیکس: رشته): منطقی:
    برگشت صفحه.مسیر.نشانی برابر پریفیکس یا صفحه.مسیر.نشانی.شروع با(پریفیکس + "/")
پایان

همگانی بخش ناوبر(نام کوتاه: رشته، نوشته ناو: رشته، فعال: منطقی):
    پیوند:
        مقصد = "/" + نام کوتاه
        فاصله = 8، 14
        گردی = 10
        رنگ = "#d8e8d8"
        تزیین متن = "هیچ"
        اشاره:
            پس زمینه = "#2d6a42"
        پایان
        اگر فعال:
            پس زمینه = "#ffffff"
            رنگ = "#1f4d2e"
            وزن قلم = 700
        پایان
        محتوا = نوشته ناو
    پایان
پایان

همگانی بخش کارت کوه(ناحیه: رشته، کوه: رشته):
    پیوند:
        مقصد = "/guides/" + ناحیه + "/" + کوه
        چیدمان = "ستون"
        شکاف = 4
        فاصله = 16
        گردی = 14
        پس زمینه = "#ffffff"
        رنگ = "#1b2a1f"
        تزیین متن = "هیچ"
        کادر = 1، "توپر"، "#d5e0d3"
        گذار = 160ms
        اشاره:
            سایه = 0، 6، 18، "#1f4d2e33"
        پایان
        اگر صفحه.تیره:
            پس زمینه = "#1b261d"
            رنگ = "#e6efe6"
            کادر = 1، "توپر"، "#2c3d2f"
        پایان
        قوی:
            محتوا = نام کوه(کوه)
        پایان
        ریز:
            شفافیت = 0.75
            محتوا = نام ناحیه(ناحیه) + ", " + طول کوه(کوه) + " کیلومتر"
        پایان
        نشان سختی:
            رده سختی = سختی کوه(کوه)
        پایان
    پایان
پایان

همگانی بخش نان ریز(ناحیه: رشته، کوه: رشته):
    ناوبری:
        چیدمان = "ردیف"
        شکاف = 8
        اندازه قلم = 14
        شفافیت = 0.85
        پیوند:
            مقصد = "/guides"
            محتوا = "راهنماها"
        پایان
        تکه:
            محتوا = "/"
        پایان
        پیوند:
            مقصد = "/guides/" + ناحیه
            محتوا = نام ناحیه(ناحیه)
        پایان
        اگر کوه نابرابر "":
            تکه:
                محتوا = "/"
            پایان
            تکه:
                محتوا = نام کوه(کوه)
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "کوه‌نما"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, system-ui, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = "#f4f7f2"
        رنگ = "#1b2a1f"
        اگر صفحه.تیره:
            پس زمینه = #101712
            رنگ = #e6efe6
        پایان
        سرصفحه:
            چیدمان = "ردیف"
            تراز = "وسط"
            شکاف = 18
            فاصله = 14، 28
            پس زمینه = "#1f4d2e"
            پیوند:
                مقصد = "/"
                رنگ = "#ffffff"
                اندازه قلم = 22
                وزن قلم = 800
                تزیین متن = "هیچ"
                محتوا = "کوه‌نما"
            پایان
            ناوبری:
                چیدمان = "ردیف"
                شکاف = 6
                رشد = 1
                ناوبر:
                    نام کوتاه = "guides"
                    فعال = همین جاست("/guides")
                    نوشته ناو = "راهنماها"
                پایان
                ناوبر:
                    نام کوتاه = "search"
                    فعال = همین جاست("/search")
                    نوشته ناو = "جستجو"
                پایان
                ناوبر:
                    نام کوتاه = "help/start/first-hike"
                    فعال = همین جاست("/help/start/first-hike")
                    نوشته ناو = "راهنما"
                پایان
            پایان
            اگر واردشده:
                ناوبر:
                    نام کوتاه = "account"
                    فعال = همین جاست("/account")
                    نوشته ناو = "حساب من"
                پایان
                دکمه:
                    شناسه = "signout"
                    فاصله = 6، 12
                    گردی = 8
                    کادر = 0
                    پس زمینه = "#d8e8d8"
                    کلیک = خروج
                    محتوا = "خروج"
                پایان
            وگرنه:
                ناوبر:
                    نام کوتاه = "login"
                    فعال = همین جاست("/login")
                    نوشته ناو = "ورود"
                پایان
            پایان
        پایان
        اصلی:
            بیشینه عرض = 980
            فضا = 0، "خودکار"
            فاصله = 28
            Outlet: پایان
        پایان
        پاورقی:
            فاصله = 20، 28
            ترازمتن = "وسط"
            شفافیت = 0.7
            محتوا = "کوه‌نما، " + اخیر.طول() + " مسیر در این بازدید باز شد"
        پایان
    پایان
پایان
