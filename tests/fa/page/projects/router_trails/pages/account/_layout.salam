همگانی بخش چیدمان حساب:
    صفحه.نگهبان(واردشده)
    جعبه:
        چیدمان = ردیف
        شکاف = 24
        ناوبری:
            عرض = 180
            شکاف = 6
            ناوبر:
                نام کوتاه = "account"
                فعال = همین جاست("/account")
                نوشته ناو = "نمای کلی"
            پایان
            ناوبر:
                نام کوتاه = "account/history"
                فعال = همین جاست("/account/history")
                نوشته ناو = "تاریخچه"
            پایان
        پایان
        جعبه:
            رشد = 1
            Outlet: پایان
        پایان
    پایان
پایان
