همگانی بخش تاریخچه حساب:
    عنوان = "تاریخچه"
    جعبه:
        شکاف = 10
        سرتیتر:
            اندازه = 1
            محتوا = "تازه باز شده‌ها"
        پایان
        اگر اخیر.طول() برابر 0:
            پاراگراف:
                محتوا = "هنوز چیزی نیست."
            پایان
        پایان
        فهرست:
            هر ت در اخیر:
                مورد:
                    محتوا = نام کوه(ت)
                پایان
            پایان
        پایان
    پایان
پایان
