همگانی بخش حساب من:
    عنوان = "حساب من"
    جعبه:
        شکاف = 10
        سرتیتر:
            اندازه = 1
            محتوا = "خوش آمدی آیدا"
        پایان
        پاراگراف:
            محتوا = "شما " + اخیر.طول() + " مسیر را تا امروز باز کرده‌اید."
        پایان
    پایان
پایان
