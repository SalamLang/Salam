همگانی بخش چیدمان راهنماها:
    جعبه:
        چیدمان = "ردیف"
        شکاف = 28
        شکستن خط = درست
        ناوبری:
            عرض = 200
            شکاف = 6
            قوی:
                محتوا = "منطقه‌ها"
            پایان
            هر ش، ر در همه ناحیه ها():
                ناوبر:
                    کلید = ش
                    نام کوتاه = "guides/" + ر
                    فعال = همین جاست("/guides/" + ر)
                    نوشته ناو = نام ناحیه(ر)
                پایان
            پایان
        پایان
        جعبه:
            رشد = 1
            کمینه عرض = 280
            Outlet: پایان
        پایان
    پایان
پایان
