همگانی بخش همه راهنماها:
    عنوان = "راهنماها"
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = "همه راهنماها"
        پایان
        هر شماره، ر در همه ناحیه ها():
            جعبه:
                کلید = شماره
                شکاف = 8
                سرتیتر:
                    اندازه = 3
                    محتوا = نام ناحیه(ر)
                پایان
                جعبه:
                    چیدمان = "شبکه"
                    چندستونی = "repeat(fill, minmax(200, 1fr))"
                    شکاف = 10
                    هر ردیف، ت در کوه های ناحیه(ر):
                        کارت کوه:
                            کلید = ردیف
                            ناحیه = ر
                            کوه = ت
                        پایان
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
