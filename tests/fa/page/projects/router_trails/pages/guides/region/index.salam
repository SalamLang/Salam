همگانی بخش صفحه‌ناحیه(ناحیه: رشته):
    مسیر = "/guides/:ناحیه"
    عنوان = نام ناحیه(ناحیه)
    جعبه:
        شکاف = 12
        اگر نام ناحیه(ناحیه) نابرابر "":
            نان ریز:
                ناحیه = ناحیه
                کوه = ""
            پایان
            سرتیتر:
                اندازه = 1
                محتوا = نام ناحیه(ناحیه)
            پایان
            جعبه:
                چیدمان = شبکه
                چندستونی = "repeat(fill, minmax(200, 1fr))"
                شکاف = 10
                هر ت در کوه های ناحیه(ناحیه):
                    کارت کوه:
                        ناحیه = ناحیه
                        کوه = ت
                    پایان
                پایان
            پایان
        وگرنه:
            پاراگراف:
                محتوا = "چنین مسیری نیست."
            پایان
        پایان
    پایان
پایان
