 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش صفحه‌کوه(ناحیه: رشته، کوه: رشته):
    مسیر = "/guides/:ناحیه/:کوه"
    عنوان = نام کوه(کوه)
    جعبه:
        شکاف = 12
        اگر نام کوه(کوه) نابرابر "" و نام ناحیه(ناحیه) نابرابر "":
            نان ریز:
                ناحیه = ناحیه
                کوه = کوه
            پایان
            سرتیتر:
                اندازه = 1
                محتوا = نام کوه(کوه)
            پایان
            جعبه:
                چیدمان = "ردیف"
                شکاف = 10
                تراز = "وسط"
                نشان سختی:
                    رده سختی = سختی کوه(کوه)
                پایان
                تکه:
                    شناسه = "km"
                    محتوا = طول کوه(کوه) + " کیلومتر"
                پایان
            پایان
            دکمه:
                شناسه = "mark"
                خود تراز = "ابتدا"
                فاصله = 10، 18
                گردی = 10
                کادر = 0
                پس زمینه = "#1f4d2e"
                رنگ = "#ffffff"
                کلیک = (): ثبت بازدید(کوه) پایان
                محتوا = "ثبت به عنوان بازدید شده"
            پایان
            دکمه:
                شناسه = "next"
                خود تراز = "ابتدا"
                فاصله = 8، 14
                گردی = 10
                کادر = 1، توپر، #b9cbb7
                پس زمینه = "شفاف"
                کلیک = (): صفحه.مسیر.برو("/guides/" + ناحیه) پایان
                محتوا = "مسیرهای بیشتر در " + نام ناحیه(ناحیه)
            پایان
        وگرنه:
            پاراگراف:
                محتوا = "چنین مسیری نیست."
            پایان
        پایان
    پایان
پایان
