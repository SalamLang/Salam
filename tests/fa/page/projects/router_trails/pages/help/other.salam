همگانی بخش راهنما(باقی: رشته):
    مسیر = "/help/*باقی"
    عنوان = "راهنما"
    بخش‌ها := باقی.بشکاف("/")
    جعبه:
        شکاف = 10
        سرتیتر:
            اندازه = 1
            محتوا = "راهنما: " + باقی
        پایان
        پاراگراف:
            شناسه = "depth"
            محتوا = بخش‌ها.طول() + " بخش زیر /help"
        پایان
        پیوند:
            مقصد = "/help/start/first-hike"
            محتوا = "اولین کوهپیمایی"
        پایان
        پیوند:
            مقصد = "/help/gear/boots/fit"
            محتوا = "انتخاب کفش کوه"
        پایان
    پایان
پایان
