همگانی بخش خانه:
    عنوان = "کوه‌نما"
    پرسش := ""
    جعبه:
        شکاف = 20
        سرتیتر:
            اندازه = 1
            محتوا = "کوهپیمایی بعدی‌ات را پیدا کن"
        پایان
        پاراگراف:
            بیشینه عرض = 560
            محتوا = "راهنمای " + همه ناحیه ها().طول() + " منطقه کوهستانی، با طول مسیر و سختی هر کدام."
        پایان
        فرم:
            چیدمان = ردیف
            شکاف = 8
            ارسال = (ی: صحیح۶۴):
                دام.جلوگیری پیش فرض(ی)
                صفحه.مسیر.برو("/search?q=" + پرسش)
            پایان
            ورودی:
                شناسه = "q"
                نوع = جستجو
                جانگهدار = "جستجوی مسیر"
                فاصله = 10، 14
                گردی = 10
                کادر = 1، توپر، #b9cbb7
                پیوند = پرسش
            پایان
            دکمه:
                شناسه = "go"
                نوع = ارسال
                فاصله = 10، 18
                گردی = 10
                کادر = 0
                پس زمینه = #1f4d2e
                رنگ = #ffffff
                محتوا = "جستجو"
            پایان
        پایان
        جعبه:
            چیدمان = شبکه
            چندستونی = "repeat(fill, minmax(220, 1fr))"
            شکاف = 14
            هر ر در همه ناحیه ها():
                کارت کوه:
                    ناحیه = ر
                    کوه = کوه های ناحیه(ر)[0]
                پایان
            پایان
        پایان
    پایان
پایان
