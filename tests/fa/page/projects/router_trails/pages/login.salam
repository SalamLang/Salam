همگانی بخش ورود:
    عنوان = "ورود"
    جعبه:
        شکاف = 12
        بیشینه عرض = 360
        سرتیتر:
            اندازه = 1
            محتوا = "ورود"
        پایان
        پاراگراف:
            محتوا = "بخش حساب فقط بعد از ورود باز می‌شود."
        پایان
        دکمه:
            شناسه = "signin"
            فاصله = 10، 18
            گردی = 10
            کادر = 0
            پس زمینه = "#1f4d2e"
            رنگ = "#ffffff"
            کلیک = ():
                واردشده = درست
                صفحه.مسیر.هدایت("/account")
            پایان
            محتوا = "ورود به عنوان آیدا"
        پایان
        دکمه:
            شناسه = "back"
            فاصله = 8، 14
            گردی = 10
            کادر = 1، "توپر"، "#b9cbb7"
            پس زمینه = "شفاف"
            کلیک = (): صفحه.مسیر.عقب() پایان
            محتوا = "بازگشت"
        پایان
    پایان
پایان
