// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش جستجو:
    عنوان = "جستجو"
    پرسش := ""
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 1
            محتوا = "جستجو"
        پایان
        ورودی:
            شناسه = "term"
            نوع = جستجو
            جانگهدار = "نام مسیر"
            فاصله = 10، 14
            گردی = 10
            کادر = 1، توپر، #b9cbb7
            مقدار = صفحه.مسیر.مقدار پرسمان("q")
            ورودی = (و_: رشته): پرسش = و_ پایان
        پایان
        دکمه:
            شناسه = "apply"
            فاصله = 8، 16
            گردی = 10
            کادر = 0
            پس زمینه = #1f4d2e
            رنگ = #ffffff
            کلیک = (): صفحه.مسیر.هدایت("/search?q=" + پرسش) پایان
            محتوا = "اعمال"
        پایان
        اگر صفحه.مسیر.مقدار پرسمان("q") برابر "":
            پاراگراف:
                محتوا = "بخشی از نام مسیر را بنویس."
            پایان
        وگرنه:
            پاراگراف:
                شناسه = "count"
                محتوا = یافته ها(صفحه.مسیر.مقدار پرسمان("q")).طول() + " نتیجه برای " + صفحه.مسیر.مقدار پرسمان("q")
            پایان
            هر نتیجه در یافته ها(صفحه.مسیر.مقدار پرسمان("q")):
                کارت کوه:
                    ناحیه = نتیجه.بشکاف("/")[0]
                    کوه = نتیجه.بشکاف("/")[1]
                پایان
            پایان
        پایان
    پایان
پایان
