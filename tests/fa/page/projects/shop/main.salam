// انتظار: <meta name="salam-router" content="history">
// انتظار: function __salam_route_pick(
پایا کالاها := [1، 2، 3، 4، 5، 6]

ناپایا سبد := وکتور {} برگردان وکتور<صحیح>

ناب تابع نام کالا(شناسه: صحیح): رشته:
    اگر شناسه برابر 1:
        برگشت "چراغ مطالعه"
    وگرنه شناسه برابر 2:
        برگشت "دفترچه"
    وگرنه شناسه برابر 3:
        برگشت "هدفون"
    وگرنه شناسه برابر 4:
        برگشت "لیوان قهوه"
    وگرنه شناسه برابر 5:
        برگشت "کوله‌پشتی"
    پایان
    برگشت "گیاه"
پایان

ناب تابع نماد کالا(شناسه: صحیح): رشته:
    اگر شناسه برابر 1:
        برگشت "💡"
    وگرنه شناسه برابر 2:
        برگشت "📓"
    وگرنه شناسه برابر 3:
        برگشت "🎧"
    وگرنه شناسه برابر 4:
        برگشت "☕"
    وگرنه شناسه برابر 5:
        برگشت "🎒"
    پایان
    برگشت "🪴"
پایان

ناب تابع بهای کالا(شناسه: صحیح): صحیح:
    اگر شناسه برابر 1:
        برگشت 39
    وگرنه شناسه برابر 2:
        برگشت 12
    وگرنه شناسه برابر 3:
        برگشت 89
    وگرنه شناسه برابر 4:
        برگشت 15
    وگرنه شناسه برابر 5:
        برگشت 64
    پایان
    برگشت 24
پایان

ناب تابع جمع کل(): صحیح:
    ناپایا ت := 0
    هر شناسه در سبد:
        ت += بهای کالا(شناسه)
    پایان
    برگشت ت
پایان

تابع حذف از سبد(جای: صحیح):
    ناپایا ماندنی := وکتور {} برگردان وکتور<صحیح>
    تکرار سبد.طول() در ی:
        اگر ی نابرابر جای:
            ماندنی.افزودن(سبد.دریافت(ی))
        پایان
    پایان
    سبد = ماندنی
پایان

همگانی بخش کاشی(شناسه: صحیح):
    جعبه:
        رشد = 1
        پایه = 0
        کمینه عرض = 200
        بیشینه عرض = 260
        فاصله = 18
        شکاف = 10
        گردی = 16
        پس زمینه = #ffffff
        کادر = 1، توپر، #ebe7e0
        گذار = 180ms، نرم انتها
        اشاره:
            سایه = 0، 14، 30، #2b1d0e1a
            جابه‌جایی = 0، -2
        پایان
        جعبه:
            ارتفاع = 120
            گردی = 12
            پس زمینه = #f6efe6
            تراز = وسط
            چینش = وسط
            اندازه قلم = 52
            محتوا = نماد کالا(شناسه)
        پایان
        پاراگراف:
            وزن قلم = 700
            محتوا = نام کالا(شناسه)
        پایان
        جعبه:
            چیدمان = ردیف
            تراز = وسط
            چینش = میان
            پاراگراف:
                رنگ = #8a5a2b
                وزن قلم = 700
                محتوا = بهای کالا(شناسه) + " دلار"
            پایان
            پیوند:
                مقصد = "/product/" + شناسه
                رنگ = #8a5a2b
                تزیین متن = هیچ
                وزن قلم = 600
                محتوا = "دیدن"
            پایان
        پایان
    پایان
پایان

