// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش سبد خرید:
    عنوان = "سبد"
    جعبه:
        شکاف = 16
        بیشینه عرض = 640
        سرتیتر:
            اندازه = 1
            محتوا = "سبد شما"
        پایان
        اگر سبد.طول() برابر 0:
            پاراگراف:
                رنگ = #6b5d4f
                محتوا = "سبد خالی است."
            پایان
            پیوند:
                مقصد = "/"
                رنگ = #8a5a2b
                محتوا = "چیز خوبی پیدا کنید"
            پایان
        وگرنه:
            فهرست:
                شکاف = 10
                فاصله = 0
                هر ی، شناسه در سبد:
                    ردیف سبد:
                        جای = ی
                        شناسه = شناسه
                    پایان
                پایان
            پایان
            جعبه:
                چیدمان = ردیف
                چینش = میان
                تراز = وسط
                پاراگراف:
                    اندازه قلم = 20
                    وزن قلم = 700
                    محتوا = "جمع " + جمع کل() + " دلار"
                پایان
                پیوند:
                    مقصد = "/checkout"
                    فاصله = 12، 20
                    گردی = 12
                    پس زمینه = #2b1d0e
                    رنگ = #ffffff
                    تزیین متن = هیچ
                    وزن قلم = 600
                    محتوا = "پرداخت"
                پایان
            پایان
        پایان
    پایان
پایان
