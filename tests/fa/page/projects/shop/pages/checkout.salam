همگانی بخش پرداخت:
    عنوان = "پرداخت"
    نگهبان = سبد.طول() بزرگتر 0
    هدایت = "/cart"
    جعبه:
        شکاف = 16
        بیشینه عرض = 520
        سرتیتر: اندازه = 1 محتوا = "پرداخت" پایان
        پاراگراف: محتوا = سبد.طول() + " کالا، " + جمع کل() + " دلار" پایان
        دکمه:
            شناسه = "place"
            فاصله = 12، 20
            گردی = 12
            پس زمینه = #2b1d0e
            رنگ = #ffffff
            وزن قلم = 600
            کلیک = ():
                سبد = وکتور {} برگردان وکتور<صحیح>
                صفحه.هدایت("/thanks")
            پایان
            محتوا = "ثبت سفارش"
        پایان
    پایان
پایان
