همگانی بخش پرداخت:
    عنوان = "پرداخت"
    جعبه:
        شکاف = 16
        بیشینه عرض = 520
        سرتیتر:
            اندازه = 1
            محتوا = "پرداخت"
        پایان
        اگر سبد.طول() برابر 0:
            پاراگراف:
                محتوا = "سبد شما خالی است."
            پایان
            پیوند:
                مقصد = "/"
                رنگ = #8a5a2b
                محتوا = "چیزی پیدا کنید"
            پایان
        وگرنه:
            پاراگراف:
                محتوا = سبد.طول() + " کالا، " + جمع کل() + " دلار"
            پایان
            دکمه:
                شناسه = "place"
                فاصله = 12، 20
                گردی = 12
                پس زمینه = #2b1d0e
                رنگ = #ffffff
                وزن قلم = 600
                کلیک = ():
                    سبد = وکتور {} برگردان وکتور<صحیح>
                    صفحه.مسیر.هدایت("/thanks")
                پایان
                محتوا = "ثبت سفارش"
            پایان
        پایان
    پایان
پایان
