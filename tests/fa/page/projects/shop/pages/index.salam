همگانی بخش فروشگاه:
    عنوان = "فروشگاه"
    جعبه:
        شکاف = 20
        سرتیتر: اندازه = 1 محتوا = "تازه‌ها" پایان
        پاراگراف: رنگ = #6b5d4f محتوا = "چیزهای کوچک برای میزی آرام." پایان
        جعبه:
            چیدمان = ردیف
            شکستن خط = درست
            شکاف = 16
            هر شناسه در کالاها:
                کاشی: شناسه = شناسه پایان
            پایان
        پایان
    پایان
پایان
