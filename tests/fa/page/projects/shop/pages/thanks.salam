همگانی بخش سپاس:
    عنوان = "سپاس"
    جعبه:
        شکاف = 12
        تراز = وسط
        ترازمتن = وسط
        فاصله = 40
        پاراگراف: اندازه قلم = 56 محتوا = "🎉" پایان
        سرتیتر: اندازه = 1 محتوا = "سپاس" پایان
        پیوند: مقصد = "/" رنگ = #8a5a2b محتوا = "ادامه‌ی خرید" پایان
    پایان
پایان
