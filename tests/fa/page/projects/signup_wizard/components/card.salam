همگانی بخش کارت(متن سرتیتر: رشته):
    جعبه:
        فاصله = 26
        شکاف = 12
        گردی = 18
        پس زمینه = "#ffffff"
        کادر = 1، "توپر"، "#e4def4"
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = متن سرتیتر
        پایان
        content: پایان
    پایان
پایان

همگانی بخش هشدار(پیام: رشته):
    پاراگراف:
        کلاس = "note"
        فضا = 0
        کمینه ارتفاع = 18
        اندازه قلم = 13
        رنگ = "#b3261e"
        محتوا = پیام
    پایان
پایان
