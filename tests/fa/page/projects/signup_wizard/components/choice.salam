همگانی بخش گزینه(عنوان کوتاه: رشته، فعال: منطقی، انتخاب):
    دکمه:
        کلاس = "choice"
        نوع = دکمه
        فاصله = 9، 16
        گردی = 999
        نشانگر = اشاره
        کادر = 1، توپر، #cfc6e6
        پس زمینه = #ffffff
        رنگ = #251d3a
        اگر فعال:
            پس زمینه = #5b3fd1
            رنگ = #ffffff
            کادر = 1، توپر، #5b3fd1
        پایان
        aria pressed = فعال ? "true" : "false"
        کلیک = انتخاب
        محتوا = عنوان کوتاه
    پایان
پایان
