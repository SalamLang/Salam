همگانی بخش گزینه طرح(کد: رشته، توضیح: رشته):
    دکمه:
        کلاس = "plan"
        فاصله = 16
        شکاف = 4
        گردی = 14
        ترازمتن = "چپ"
        نشانگر = "اشاره"
        پس زمینه = #ffffff
        کادر = 2، "توپر"، "#e4def4"
        اگر طرح برابر کد:
            کادر = 2، "توپر"، "#5b3fd1"
            پس زمینه = #f1ecfd
        پایان
        کلیک = ():
            طرح = کد
        پایان
        قوی:
            محتوا = نام طرح(کد) + ((بهای طرح(کد) بزرگتر 0) ? "، " + بهای طرح(کد) + " دلار در ماه" : "، رایگان")
        پایان
        تکه:
            رنگ = "#5d5478"
            محتوا = توضیح
        پایان
    پایان
پایان
