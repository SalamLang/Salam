// انتظار: function __salam_route_pick(
// انتظار: حساب خود را بسازید
واردسازی دام

ناپایا ایمیل := ""
ناپایا گذرواژه := ""
ناپایا تکرار_ گذرواژه := ""
ناپایا نام کامل := ""
ناپایا کشور := ""
ناپایا نقش := ""
ناپایا طرح := "free"
ناپایا قوانین := نادرست
ناپایا خبرنامه := درست
ناپایا ساخته شد := نادرست

تابع ایمیل خوب است(رشته: رشته): منطقی:
    موقت := رشته.پیراست()
    برگشت موقت.طول() بزرگتربرابر 6 و موقت.دربردارد("@") و موقت.دربردارد(".")
پایان

تابع رقم دارد(رشته: رشته): منطقی:
    تکرار رشته.طول() در ی:
        نویسه := رشته.زیررشته(ی، 1)
        اگر نویسه بزرگتربرابر "0" و نویسه کوچکتربرابر "9":
            برگشت درست
        پایان
    پایان
    برگشت نادرست
پایان

تابع گذرواژه خوب است(رشته: رشته): منطقی:
    برگشت رشته.طول() بزرگتربرابر 8 و رقم دارد(رشته)
پایان

تابع حساب درست_ است(): منطقی:
    برگشت ایمیل خوب است(ایمیل) و گذرواژه خوب است(گذرواژه) و تکرار_ گذرواژه برابر گذرواژه
پایان

تابع نمایه درست_ است(): منطقی:
    برگشت نام کامل.پیراست().طول() بزرگتربرابر 2 و کشور.طول() بزرگتر 0 و نقش.طول() بزرگتر 0
پایان

تابع طرح درست_ است(): منطقی:
    برگشت طرح برابر "free" یا طرح برابر "pro" یا طرح برابر "team"
پایان

تابع بهای طرح(طرح ورودی_: رشته): صحیح:
    اگر طرح ورودی_ برابر "pro":
        برگشت 12
    وگرنه طرح ورودی_ برابر "team":
        برگشت 39
    پایان
    برگشت 0
پایان

تابع نام طرح(طرح ورودی_: رشته): رشته:
    اگر طرح ورودی_ برابر "pro":
        برگشت "حرفه‌ای"
    وگرنه طرح ورودی_ برابر "team":
        برگشت "تیمی"
    پایان
    برگشت "رایگان"
پایان

تابع پنهان شده(رشته: رشته): رشته:
    ناپایا خروجی := ""
    تکرار رشته.طول():
        خروجی += "*"
    پایان
    برگشت خروجی
پایان

تابع پایان_ کار():
    اگر حساب درست_ است() و نمایه درست_ است() و طرح درست_ است() و قوانین:
        ساخته شد = درست
        صفحه.مسیر.هدایت("/welcome")
    پایان
پایان

بخش نقطه گام(عدد: صحیح، عنوان کوتاه: رشته، گام: صحیح):
    جعبه:
        رشد = 1
        شکاف = 4
        ترازمتن = "وسط"
        اندازه قلم = 12
        رنگ = "#9a90b8"
        اگر گام بزرگتربرابر عدد:
            رنگ = "#5b3fd1"
        پایان
        اگر گام برابر عدد:
            وزن قلم = 700
        پایان
        محتوا = عدد + ". " + عنوان کوتاه
    پایان
پایان

بخش قطعه(عدد: صحیح، گام: صحیح):
    جعبه:
        رشد = 1
        ارتفاع = 8
        گردی = 999
        پس زمینه = "#ddd6f0"
        اگر گام بزرگتربرابر عدد:
            پس زمینه = "#5b3fd1"
        پایان
    پایان
پایان

