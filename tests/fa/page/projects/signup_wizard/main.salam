همگانی بخش ناوبر گام(بازگشت: رشته، عنوان کوتاه: رشته، معتبر: منطقی، مقصد گام: رشته):
    جعبه:
        چیدمان = "ردیف"
        چینش = "میان"
        تراز = "وسط"
        فضا = 8، 0، 0، 0
        اگر بازگشت.طول() بزرگتر 0:
            پیوند:
                کلاس = "back"
                مقصد = بازگشت
                رنگ = "#5b3fd1"
                محتوا = "بازگشت"
            پایان
        وگرنه:
            تکه: پایان
        پایان
        دکمه:
            کلاس = "next"
            فاصله = 12، 22
            گردی = 10
            کادر = 0
            پس زمینه = "#5b3fd1"
            رنگ = "#ffffff"
            وزن قلم = 700
            نشانگر = "اشاره"
            اگر وارونه معتبر:
                شفافیت = 0.4
                نشانگر = وارونه اللووید
            پایان
            aria disabled = معتبر ? "false" : "true"
            کلیک = ():
                اگر معتبر:
                    صفحه.مسیر.برو(مقصد گام)
                پایان
            پایان
            محتوا = عنوان کوتاه
        پایان
    پایان
پایان

صفحه:
    حالت = "هش"
    عنوان = "حساب خود را بسازید"
    زبان = "fa"
    قلم = "Vazirmatn, system-ui, sans-serif"
