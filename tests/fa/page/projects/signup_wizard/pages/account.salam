 *
 */
همگانی بخش گام حساب:
    عنوان = "گام ۱: حساب"
    پیشرفت:
        گام = 1
    پایان
    کارت:
        متن سرتیتر = "حساب شما"
        برچسب:
            برای = "mail"
            وزن قلم = 600
            محتوا = "ایمیل"
        پایان
        ورودی:
            شناسه = "mail"
            نوع = ایمیل
            فاصله = 10، 12
            گردی = 10
            کادر = 1، "توپر"، "#cfc6e6"
            پیوند = ایمیل
        پایان
        هشدار:
            پیام = (ایمیل.طول() بزرگتر 0 و وارونه ایمیل خوب است(ایمیل)) ? "این شبیه نشانی ایمیل نیست." : ""
        پایان
        برچسب:
            برای = "word"
            وزن قلم = 600
            محتوا = "گذرواژه"
        پایان
        ورودی:
            شناسه = "word"
            نوع = گذرواژه
            فاصله = 10، 12
            گردی = 10
            کادر = 1، "توپر"، "#cfc6e6"
            پیوند = گذرواژه
        پایان
        هشدار:
            پیام = (گذرواژه.طول() بزرگتر 0 و وارونه گذرواژه خوب است(گذرواژه)) ? "هشت نویسه یا بیشتر، همراه با یک رقم." : ""
        پایان
        برچسب:
            برای = "again"
            وزن قلم = 600
            محتوا = "تکرار گذرواژه"
        پایان
        ورودی:
            شناسه = "again"
            نوع = گذرواژه
            فاصله = 10، 12
            گردی = 10
            کادر = 1، "توپر"، "#cfc6e6"
            پیوند = تکرار_ گذرواژه
        پایان
        هشدار:
            پیام = (تکرار_ گذرواژه.طول() بزرگتر 0 و تکرار_ گذرواژه نابرابر گذرواژه) ? "دو گذرواژه یکی نیستند." : ""
        پایان
        ناوبر گام:
            بازگشت = "/"
            عنوان کوتاه = "بعدی"
            معتبر = حساب درست_ است()
            مقصد گام = "/profile"
        پایان
    پایان
پایان
