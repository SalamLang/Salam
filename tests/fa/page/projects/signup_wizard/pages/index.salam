            شناسه = "begin"
            مقصد = "/account"
            فاصله = 12، 22
            گردی = 10
            پس زمینه = "#5b3fd1"
            رنگ = "#ffffff"
            تزیین متن = "هیچ"
            ترازمتن = "وسط"
            وزن قلم = 700
