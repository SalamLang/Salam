    عنوان = "حساب خود را بسازید"
    کارت:
        متن سرتیتر = "حساب خود را بسازید"
        پاراگراف:
            فضا = 0
            رنگ = "#5d5478"
            محتوا = "چهار گام کوتاه: حساب، نمایه، طرح و یک مرور پایانی."
        پایان
