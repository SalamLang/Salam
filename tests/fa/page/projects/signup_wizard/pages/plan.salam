همگانی بخش گام طرح:
    صفحه.نگهبان(حساب درست_ است() و نمایه درست_ است())
    عنوان = "گام ۳: طرح"
    پیشرفت:
        گام = 3
    پایان
    کارت:
        متن سرتیتر = "یک طرح برگزینید"
        گزینه طرح:
            کد = "free"
            توضیح = "یک پروژه و پشتیبانی انجمن."
        پایان
        گزینه طرح:
            کد = "pro"
            توضیح = "پروژه نامحدود و پشتیبانی ایمیلی."
        پایان
        گزینه طرح:
            کد = "team"
            توضیح = "همه امکانات حرفه‌ای، با فضای کاری مشترک."
        پایان
        گزینه:
            عنوان کوتاه = خبرنامه ? "خبرنامه: روشن" : "خبرنامه: خاموش"
            فعال = خبرنامه
            انتخاب = ():
                خبرنامه = وارونه خبرنامه
            پایان
        پایان
        ناوبر گام:
            بازگشت = "/profile"
            عنوان کوتاه = "مرور"
            معتبر = طرح درست_ است()
            مقصد گام = "/review"
        پایان
    پایان
پایان
