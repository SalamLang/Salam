همگانی بخش گام نمایه:
    صفحه.نگهبان(حساب درست_ است())
    عنوان = "گام ۲: نمایه"
    پیشرفت:
        گام = 2
    پایان
    کارت:
        متن سرتیتر = "درباره شما"
        برچسب:
            برای = "fullname"
            وزن قلم = 600
            محتوا = "نام کامل"
        پایان
        ورودی:
            شناسه = "fullname"
            فاصله = 10، 12
            گردی = 10
            کادر = 1، "توپر"، "#cfc6e6"
            پیوند = نام کامل
        پایان
        هشدار:
            پیام = (نام کامل.طول() بزرگتر 0 و نام کامل.پیراست().طول() کوچکتر 2) ? "دست کم دو نویسه." : ""
        پایان
        پاراگراف:
            فضا = 0
            وزن قلم = 600
            محتوا = "کشور"
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 8
            گزینه:
                عنوان کوتاه = "آلمان"
                فعال = (کشور برابر "de")
                انتخاب = ():
                    کشور = "de"
                پایان
            پایان
            گزینه:
                عنوان کوتاه = "ایران"
                فعال = (کشور برابر "ir")
                انتخاب = ():
                    کشور = "ir"
                پایان
            پایان
            گزینه:
                عنوان کوتاه = "ایالات متحده"
                فعال = (کشور برابر "us")
                انتخاب = ():
                    کشور = "us"
                پایان
            پایان
        پایان
        پاراگراف:
            فضا = 0
            وزن قلم = 600
            محتوا = "چه کاره‌اید؟"
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 8
            گزینه:
                عنوان کوتاه = "برنامه‌نویس"
                فعال = (نقش برابر "dev")
                انتخاب = ():
                    نقش = "dev"
                پایان
            پایان
            گزینه:
                عنوان کوتاه = "طراح"
                فعال = (نقش برابر "design")
                انتخاب = ():
                    نقش = "design"
                پایان
            پایان
            گزینه:
                عنوان کوتاه = "چیز دیگر"
                فعال = (نقش برابر "other")
                انتخاب = ():
                    نقش = "other"
                پایان
            پایان
        پایان
        ناوبر گام:
            بازگشت = "/account"
            عنوان کوتاه = "بعدی"
            معتبر = نمایه درست_ است()
            مقصد گام = "/plan"
        پایان
    پایان
پایان
