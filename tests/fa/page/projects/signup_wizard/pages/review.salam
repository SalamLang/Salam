بخش سطر مرور(عنوان کوتاه: رشته، مقدار نشان: رشته، ویرایش: رشته):
    جعبه:
        چیدمان = "ردیف"
        چینش = "میان"
        تراز = "وسط"
        فاصله = 8، 0
        کادر پایین = 1، توپر، #eee9f8
        جعبه:
            تکه:
                اندازه قلم = 12
                رنگ = "#7a7096"
                محتوا = عنوان کوتاه
            پایان
            قوی:
                کلاس = "value"
                محتوا = مقدار نشان
            پایان
        پایان
        پیوند:
            مقصد = ویرایش
            رنگ = "#5b3fd1"
            اندازه قلم = 13
            محتوا = "ویرایش"
        پایان
    پایان
پایان

همگانی بخش گام مرور:
    صفحه.نگهبان(حساب درست_ است() و نمایه درست_ است() و طرح درست_ است())
    عنوان = "گام ۴: مرور"
    پیشرفت:
        گام = 4
    پایان
    کارت:
        متن سرتیتر = "مرور و ساخت"
        سطر مرور:
            عنوان کوتاه = "ایمیل"
            مقدار نشان = ایمیل.پیراست()
            ویرایش = "/account"
        پایان
        سطر مرور:
            عنوان کوتاه = "گذرواژه"
            مقدار نشان = پنهان شده(گذرواژه)
            ویرایش = "/account"
        پایان
        سطر مرور:
            عنوان کوتاه = "نام"
            مقدار نشان = نام کامل.پیراست()
            ویرایش = "/profile"
        پایان
        سطر مرور:
            عنوان کوتاه = "کشور و نقش"
            مقدار نشان = کشور + " , " + نقش
            ویرایش = "/profile"
        پایان
        سطر مرور:
            عنوان کوتاه = "طرح"
            مقدار نشان = نام طرح(طرح) + (خبرنامه ? "، با خبرنامه" : "، بدون خبرنامه")
            ویرایش = "/plan"
        پایان
        گزینه:
            عنوان کوتاه = قوانین ? "قوانین پذیرفته شد" : "قوانین را می‌پذیرم"
            فعال = قوانین
            انتخاب = ():
                قوانین = وارونه قوانین
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            چینش = "میان"
            تراز = "وسط"
            پیوند:
                کلاس = "back"
                مقصد = "/plan"
                رنگ = "#5b3fd1"
                محتوا = "بازگشت"
            پایان
            دکمه:
                شناسه = "create"
                فاصله = 12، 22
                گردی = 10
                کادر = 0
                پس زمینه = "#5b3fd1"
                رنگ = "#ffffff"
                وزن قلم = 700
                اگر وارونه قوانین:
                    شفافیت = 0.4
                    نشانگر = وارونه اللووید
                پایان
                aria disabled = قوانین ? "false" : "true"
                کلیک = پایان_ کار
                محتوا = "ساخت حساب"
            پایان
        پایان
    پایان
پایان
