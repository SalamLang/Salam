همگانی بخش خوش آمد:
    صفحه.نگهبان(ساخته شد)
    عنوان = "خوش آمدید"
    کارت:
        متن سرتیتر = "خوش آمدید، " + نام کامل.پیراست()
        پاراگراف:
            شناسه = "done"
            فضا = 0
            محتوا = "حساب " + نام طرح(طرح) + " برای " + ایمیل.پیراست() + " آماده است."
        پایان
    پایان
پایان
