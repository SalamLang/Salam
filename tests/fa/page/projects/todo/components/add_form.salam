واردسازی دام
همگانی بخش فرم افزودن:
    فرم:
        شکاف = 6
        ارسال = (رخداد: صحیح۶۴):
            دام.جلوگیری پیش فرض(رخداد)
            افزودن کار()
        پایان
        جعبه:
            چیدمان = "row"
            شکاف = 8
            ورودی:
                شناسه = "draft"
                رشد = 1
                فاصله = 12، 14
                گردی = 12
                کادر = 2، "solid"، "#d7dbea"
                اندازه قلم = 16
                جانگهدار = "چه کاری مانده؟"
                برچسب دسترسی‌پذیری = "کار تازه"
                پیوند = پیش‌نویس
            پایان
            دکمه:
                شناسه = "add"
                نوع = «ارسال»
                فاصله = 0، 20
                گردی = 12
                کادر = 0
                پس زمینه = "#4c5bd4"
                رنگ = "#ffffff"
                وزن قلم = 600
                نشانگر = "pointer"
                محتوا = "افزودن"
            پایان
        پایان
        اگر مشکل.طول() بزرگتر 0:
            پاراگراف:
                شناسه = "problem"
                فضا = 0
                رنگ = "#b42318"
                اندازه قلم = 14
                نقش = "alert"
                محتوا = مشکل
            پایان
        پایان
    پایان
پایان
