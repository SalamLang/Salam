همگانی بخش نوار پاکسازی:
    اگر شمار انجام‌شده() بزرگتر 0:
        جعبه:
            چیدمان = "row"
            چینش = "end"
            دکمه:
                شناسه = "clear"
                فاصله = 8، 14
                گردی = 10
                کادر = 1، "solid"، "#d7dbea"
                پس زمینه = "#ffffff"
                رنگ = "#b42318"
                نشانگر = "pointer"
                کلیک = پاک کردن انجام‌شده‌ها
                محتوا = "پاک کردن انجام‌شده‌ها (" + شمار انجام‌شده() + ")"
            پایان
        پایان
    پایان
پایان
