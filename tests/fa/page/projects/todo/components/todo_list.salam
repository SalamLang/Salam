همگانی بخش فهرست کارها(پالایه: رشته، پیام خالی: رشته):
    اگر شمار نمایش(پالایه) برابر 0:
        پاراگراف:
            کلاس = "empty"
            ترازمتن = «وسط»
            شفافیت = 0.6
            فاصله = 24
            محتوا = پیام خالی
        پایان
    وگرنه:
        فهرست:
            فاصله = 0
            فضا = 0
            شکاف = 8
            هر شماره، _ در متن‌ها:
                اگر نمایشی(پالایه، شماره):
                    ردیف کار:
                        جای = شماره
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
