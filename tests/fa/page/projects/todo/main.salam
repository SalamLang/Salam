// انتظار: <meta name="salam-router" content="history">
// انتظار: function __salam_route_pick(
// انتظار: کارهای من
// انتظار نه: var __salam_rt_hash = true
واردسازی دام

ناپایا متن‌ها := بارگذاری متن‌ها()
ناپایا انجام‌شده‌ها := بارگذاری انجام‌شده‌ها()
ناپایا پیش‌نویس := ""
ناپایا مشکل := ""
ناپایا ویرایش جاری := -1
ناپایا متن ویرایش := ""

تابع ذخیره():
    ناپایا خروجی := ""
    تکرار متن‌ها.طول() در شماره:
        خروجی += (انجام‌شده‌ها.بگیر(شماره) ? "1" : "0") + متن‌ها.بگیر(شماره) + "\n"
    پایان
    دام.تنظیم متن ذخیره("todo.items"، خروجی)
پایان

تابع خط‌های ذخیره(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    خام := دام.دریافت متن ذخیره("todo.items")
    اگر خام.طول() برابر 0:
        خروجی.افزودن("0مطالعه‌ی راهنمای مسیریاب")
        خروجی.افزودن("1نوشتن تخته‌ی کانبان")
        خروجی.افزودن("0انتشار برنامه")
        برگشت خروجی
    پایان
    تکه‌ها := خام.بشکاف("\n")
    تکرار تکه‌ها.طول() در شماره:
        اگر تکه‌ها.بگیر(شماره).طول() بزرگتر 1:
            خروجی.افزودن(تکه‌ها.بگیر(شماره))
        پایان
    پایان
    برگشت خروجی
پایان

تابع بارگذاری متن‌ها(): وکتور<رشته>:
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    خط‌ها := خط‌های ذخیره()
    تکرار خط‌ها.طول() در شماره:
        خروجی.افزودن(خط‌ها.بگیر(شماره).زیررشته(1، خط‌ها.بگیر(شماره).طول()))
    پایان
    برگشت خروجی
پایان

تابع بارگذاری انجام‌شده‌ها(): وکتور<منطقی>:
    ناپایا خروجی := وکتور {} برگردان وکتور<منطقی>
    خط‌ها := خط‌های ذخیره()
    تکرار خط‌ها.طول() در شماره:
        خروجی.افزودن(خط‌ها.بگیر(شماره).زیررشته(0، 1) برابر "1")
    پایان
    برگشت خروجی
پایان

تابع افزودن کار():
    پاک‌شده := پیش‌نویس.پیراست()
    اگر پاک‌شده.طول() برابر 0:
        مشکل = "اول چیزی بنویسید"
        برگشت
    پایان
    اگر پاک‌شده.طول() بزرگتر 60:
        مشکل = "از ۶۰ نویسه بیشتر نشود"
        برگشت
    پایان
    متن‌ها.بیفزا(پاک‌شده)
    انجام‌شده‌ها.بیفزا(نادرست)
    پیش‌نویس = ""
    مشکل = ""
    ذخیره()
پایان

تابع انجام شده است(شماره: صحیح): منطقی:
    برگشت انجام‌شده‌ها.بگیر(شماره)
پایان

تابع تغییر وضعیت(شماره: صحیح):
    انجام‌شده‌ها.بنشان(شماره، وارونه انجام‌شده‌ها.بگیر(شماره))
    ذخیره()
پایان

تابع حذف(شماره: صحیح):
    متن‌ها.حذف‌در(شماره)
    انجام‌شده‌ها.حذف‌در(شماره)
    اگر ویرایش جاری برابر شماره:
        ویرایش جاری = -1
    پایان
    ذخیره()
پایان

تابع پاک کردن انجام‌شده‌ها():
    ناپایا شماره := متن‌ها.طول() - 1
    تا شماره بزرگتربرابر 0:
        اگر انجام‌شده‌ها.بگیر(شماره):
            متن‌ها.حذف‌در(شماره)
            انجام‌شده‌ها.حذف‌در(شماره)
        پایان
        شماره--
    پایان
    ویرایش جاری = -1
    ذخیره()
پایان

تابع شروع ویرایش(شماره: صحیح):
    ویرایش جاری = شماره
    متن ویرایش = متن‌ها.بگیر(شماره)
پایان

تابع ثبت ویرایش():
    اگر ویرایش جاری کوچکتر 0:
        برگشت
    پایان
    پاک‌شده := متن ویرایش.پیراست()
    اگر پاک‌شده.طول() برابر 0:
        حذف(ویرایش جاری)
    وگرنه:
        متن‌ها.بنشان(ویرایش جاری، پاک‌شده)
    پایان
    ویرایش جاری = -1
    ذخیره()
پایان

تابع یدیت کلید(رخداد: صحیح۶۴):
    اگر دام.کلید رویداد(رخداد) برابر "Enter":
        ثبت ویرایش()
    وگرنه دام.کلید رویداد(رخداد) برابر "Escape":
        انصراف ویرایش()
    پایان
پایان

تابع انصراف ویرایش():
    ویرایش جاری = -1
پایان

تابع شمار باقی‌مانده(): صحیح:
    ناپایا عدد := 0
    تکرار انجام‌شده‌ها.طول() در شماره:
        اگر وارونه انجام‌شده‌ها.بگیر(شماره):
            عدد++
        پایان
    پایان
    برگشت عدد
پایان

تابع شمار انجام‌شده(): صحیح:
    برگشت انجام‌شده‌ها.طول() - شمار باقی‌مانده()
پایان

تابع نمایشی(پالایه: رشته، شماره: صحیح): منطقی:
    اگر پالایه برابر "active":
        برگشت وارونه انجام‌شده‌ها.بگیر(شماره)
    پایان
    اگر پالایه برابر "done":
        برگشت انجام‌شده‌ها.بگیر(شماره)
    پایان
    برگشت درست
پایان

تابع شمار نمایش(پالایه: رشته): صحیح:
    ناپایا عدد := 0
    تکرار متن‌ها.طول() در شماره:
        اگر نمایشی(پالایه، شماره):
            عدد++
        پایان
    پایان
    برگشت عدد
پایان

تابع جمع(عدد: صحیح): رشته:
    برگشت عدد برابر 1 ? "مورد" : "مورد"
پایان

همگانی بخش ردیف کار(جای: صحیح):
    مورد:
        چیدمان = "row"
        تراز = "center"
        شکاف = 10
        فاصله = 10، 12
        گردی = 12
        پس زمینه = "#ffffff"
        سایه = 0، 1، 3، "#1b1e2b14"
        ورودی:
            نوع = «تیک»
            تیک خورده = انجام شده است(جای)
            برچسب دسترسی‌پذیری = "انجام شد"
            تغییر = (): تغییر وضعیت(جای) پایان
        پایان
        اگر ویرایش جاری برابر جای:
            ورودی:
                کلاس = "editor"
                رشد = 1
                فاصله = 6، 8
                گردی = 8
                کادر = 2، "solid"، "#4c5bd4"
                اندازه قلم = 16
                تمرکز خودکار = درست
                پیوند = متن ویرایش
                از دست رفتن فوکوس = ثبت ویرایش
                فشردن کلید = (رخداد: صحیح۶۴): یدیت کلید(رخداد) پایان
            پایان
        وگرنه:
            تکه:
                کلاس = "label"
                رشد = 1
                نشانگر = "text"
                رنگ = انجام شده است(جای) ? "#8a8fa8" : "#1b1e2b"
                دو کلیک = (): شروع ویرایش(جای) پایان
                محتوا = متن‌ها.بگیر(جای)
            پایان
            پیوند:
                مقصد = "/item/" + جای
                اندازه قلم = 13
                رنگ = "#6a70a0"
                محتوا = "جزئیات"
            پایان
        پایان
        دکمه:
            کلاس = "remove"
            کادر = 0
            پس زمینه = «شفاف»
            رنگ = "#8a8fa8"
            نشانگر = "pointer"
            برچسب دسترسی‌پذیری = "حذف"
            اشاره:
                رنگ = "#b42318"
            پایان
            کلیک = (): حذف(جای) پایان
            محتوا = "×"
        پایان
    پایان
پایان

همگانی بخش نوار پالایه:
    ناوبری:
        چیدمان = "row"
        شکاف = 8
        برچسب دسترسی‌پذیری = "پالایه"
        گزینه پالایه:
            راه = ""
            برچسب = "همه"
            تعداد = متن‌ها.طول()
        پایان
        گزینه پالایه:
            راه = "active"
            برچسب = "باقی‌مانده"
            تعداد = شمار باقی‌مانده()
        پایان
        گزینه پالایه:
            راه = "done"
            برچسب = "انجام شد"
            تعداد = شمار انجام‌شده()
        پایان
    پایان
پایان

بخش گزینه پالایه(راه: رشته، برچسب: رشته، تعداد: صحیح):
    پیوند:
        مقصد = "/" + راه
        فاصله = 6، 14
        گردی = 20
        تزیین متن = «هیچ»
        اندازه قلم = 14
        پس زمینه = "#e4e7f5"
        رنگ = "#3a3f66"
        اگر صفحه.مسیر.نشانی برابر "/" + راه:
            پس زمینه = "#4c5bd4"
            رنگ = "#ffffff"
        پایان
        محتوا = برچسب + " " + تعداد
    پایان
پایان

صفحه:
    عنوان = "کارهای من"
    زبان = "fa"
    قلم = "Vazirmatn, Tahoma, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = "#f4f5fa"
        رنگ = "#1b1e2b"
        فاصله = 24، 16
        اصلی:
            بیشینه عرض = 560
            فضا = 0، "auto"
            شکاف = 16
            سرصفحه:
                شکاف = 4
                سرتیتر:
                    اندازه = 1
                    فضا = 0
                    اندازه قلم = 32
                    محتوا = "کارهای من"
                پایان
                پاراگراف:
                    فضا = 0
                    شفافیت = 0.65
                    شناسه = "summary"
                    محتوا = شمار باقی‌مانده() + " " + جمع(شمار باقی‌مانده()) + " مانده"
                پایان
            پایان
            فرم افزودن: پایان
            نوار پالایه: پایان
            نمای مسیر: پایان
            نوار پاکسازی: پایان
        پایان
    پایان
پایان
