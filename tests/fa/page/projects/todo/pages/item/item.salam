همگانی بخش برگه کار(کد: صحیح):
    مسیر = "/item/:کد"
    عنوان = "جزئیات کار"
    جعبه:
        شکاف = 12
        فاصله = 16
        گردی = 12
        پس زمینه = "#ffffff"
        اگر کد کوچکتر متن‌ها.طول():
            سرتیتر:
                اندازه = 2
                فضا = 0
                محتوا = متن‌ها.بگیر(کد)
            پایان
            پاراگراف:
                شناسه = "state"
                فضا = 0
                محتوا = انجام‌شده‌ها.بگیر(کد) ? "وضعیت: انجام شده" : "وضعیت: هنوز مانده"
            پایان
            دکمه:
                شناسه = "flip"
                فاصله = 8، 14
                گردی = 10
                کادر = 0
                پس زمینه = "#e4e7f5"
                نشانگر = "اشاره"
                کلیک = (): تغییر وضعیت(کد) پایان
                محتوا = انجام‌شده‌ها.بگیر(کد) ? "برگرداندن به باقی‌مانده" : "علامت انجام‌شده"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 2
                محتوا = "چنین کاری نیست"
            پایان
        پایان
        پیوند:
            مقصد = "/"
            محتوا = "بازگشت به فهرست"
        پایان
    پایان
پایان
