همگانی بخش ستون(درصد: صحیح، شرح: رشته، قرائت: رشته):
    جعبه:
        کلاس = "bar"
        تراز = وسط
        شکاف = 4
        رشد = 1
        ریز:
            محتوا = قرائت
        پایان
        جعبه:
            عرض = 100%
            ارتفاع = 100
            چینش = انتها
            پس زمینه = #e5eeee
            گردی = 8
            سرریز = پنهان
            جعبه:
                عرض = 100%
                ارتفاع = درصد + "%"
                پس زمینه = #0d9488
            پایان
        پایان
        ریز:
            شفافیت = 0.7
            محتوا = شرح
        پایان
    پایان
پایان
