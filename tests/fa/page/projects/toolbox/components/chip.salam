همگانی بخش تراشه(برچسب: رشته، برگزیده: منطقی، گروه: صحیح، کد: صحیح):
    دکمه:
        کلاس = "chip"
        فاصله = 6، 14
        گردی = 999
        کادر = 1، توپر، #0d9488
        پس زمینه = شفاف
        رنگ = #0d9488
        نشانگر = اشاره
        اگر برگزیده:
            پس زمینه = #0d9488
            رنگ = #ffffff
        پایان
        کلیک = ():
            گزینش‌تراشه(گروه، کد)
        پایان
        محتوا = برچسب
    پایان
پایان
