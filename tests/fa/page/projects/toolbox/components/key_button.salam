همگانی بخش دکمه‌ماشین(برچسب: رشته، رنگ: صحیح، کنش):
    دکمه:
        فاصله = 16، 0
        اندازه قلم = 20
        گردی = 12
        کادر = 0
        پس زمینه = #ffffff
        رنگ = #14211f
        نشانگر = اشاره
        سایه = 0، 1، 2، #00000022
        اگر رنگ برابر 1:
            پس زمینه = #0d9488
            رنگ = #ffffff
        پایان
        اگر رنگ برابر 2:
            پس زمینه = #e5e7eb
        پایان
        کلیک = کنش
        محتوا = برچسب
    پایان
پایان
