همگانی بخش خط‌مارک‌داون(قالبی: صحیح، متن: رشته):
    اگر قالبی برابر 1:
        سرتیتر:
            کلاس = "md-h1"
            اندازه = 1
            فضا = 4، 0
            محتوا = متن
        پایان
    وگرنه قالبی برابر 2:
        سرتیتر:
            کلاس = "md-h2"
            اندازه = 2
            فضا = 4، 0
            محتوا = متن
        پایان
    وگرنه قالبی برابر 3:
        جعبه:
            کلاس = "md-li"
            چیدمان = "ردیف"
            شکاف = 8
            فاصله = 0، 12
            تکه:
                محتوا = "•"
            پایان
            پاراگراف:
                فضا = 2، 0
                هر جایگاه، تکه در متن.بشکاف("**"):
                    اگر جایگاه % 2 برابر 1:
                        قوی:
                            کلید = جایگاه
                            محتوا = تکه
                        پایان
                    وگرنه:
                        تکه:
                            کلید = جایگاه
                            محتوا = تکه
                        پایان
                    پایان
                پایان
            پایان
        پایان
    وگرنه قالبی برابر 4:
        پاراگراف:
            کلاس = "md-p"
            فضا = 4، 0
            هر جایگاه، تکه در متن.بشکاف("**"):
                اگر جایگاه % 2 برابر 1:
                    قوی:
                        کلید = جایگاه
                        محتوا = تکه
                    پایان
                وگرنه:
                    تکه:
                        کلید = جایگاه
                        محتوا = تکه
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
