همگانی بخش نمونه‌رنگ(نمونه: رشته، قفلی: منطقی، شماره: صحیح):
    جعبه:
        کلاس = "swatch"
        رشد = 1
        پایه = 0
        کمینه عرض = 90
        شکاف = 6
        جعبه:
            ارتفاع = 110
            گردی = 12
            پس زمینه = نمونه
        پایان
        ریز:
            کلاس = "css"
            محتوا = نمونه
        پایان
        دکمه:
            کلاس = "lock"
            فاصله = 4، 8
            گردی = 999
            کادر = 1، "توپر"، "#0d9488"
            پس زمینه = شفاف
            رنگ = #0d9488
            نشانگر = "اشاره"
            اگر قفلی:
                پس زمینه = #0d9488
                رنگ = #ffffff
            پایان
            کلیک = ():
                تغییر‌قفل(شماره)
            پایان
            محتوا = قفلی ? "قفل شد" : "قفل"
        پایان
    پایان
پایان
