واردسازی دام

پایا پنج‌تایی := [0، 1، 2، 3، 4]
پایا شهرها := [0، 1، 2، 3]
پایا درصدها := [0، 10، 15، 18، 20]

ناپایا نمایش‌ماشین := "0"
ناپایا انباره‌ماشین := 0.0
ناپایا عمل‌ماشین := ""
ناپایا تازه‌ماشین := درست
ناپایا تاریخچه‌ماشین := وکتور {} برگردان وکتور<رشته>

ناپایا دسته‌تبدیل := 0
ناپایا از‌واحد := 0
ناپایا به‌واحد := 1
ناپایا متن‌تبدیل := "1"

ناپایا متن‌صورتحساب := "48.50"
ناپایا درصد‌انعام := 15
ناپایا تعداد‌نفرات := 2

ناپایا متن‌مارک‌داون := "# یادداشت انتشار\n\nزبان صفحه حالا **مسیریاب** و *بخش‌ها* دارد.\n\n## نکته‌ها\n- مسیریاب فایلی\n- زمان‌سنج و **bind**\n- واژه‌های فارسی"

ناپایا رنگمایه := 210
ناپایا طرح‌رنگ := 0
ناپایا قفل‌رنگ := وکتور {} برگردان وکتور<رشته>
ناپایا قفل‌شده := بذر‌قفل‌ها()

ناپایا فارنهایت‌باشد := نادرست

تابع بذر‌قفل‌ها(): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    تکرار 5:
        خروجی.افزودن(0)
        قفل‌رنگ.افزودن("")
    پایان
    برگشت خروجی
پایان

ناب تابع دورقمی(عدد: صحیح): رشته:
    اگر عدد کوچکتر 10:
        برگشت "0" + عدد
    پایان
    برگشت "" + عدد
پایان

ناب تابع عدد‌مرتب(مقدار‌م: اعشار۶۴): رشته:
    منفی := مقدار‌م کوچکتر 0.0
    اندازه := منفی ? 0.0 - مقدار‌م : مقدار‌م
    مقیاس‌شده := (اندازه * 1000000.0 + 0.5) برگردان صحیح۶۴
    بخش‌صحیح := مقیاس‌شده / 1000000
    کسری := مقیاس‌شده % 1000000
    ناپایا خروجی := "" + بخش‌صحیح
    اگر کسری بزرگتر 0:
        ناپایا ارقام := "" + کسری
        تا ارقام.طول() کوچکتر 6:
            ارقام = "0" + ارقام
        پایان
        تا ارقام.طول() بزرگتر 1 و ارقام.ختم با("0"):
            ارقام = ارقام.زیررشته(0، ارقام.طول() - 1)
        پایان
        خروجی = خروجی + "." + ارقام
    پایان
    اگر منفی و مقیاس‌شده بزرگتر 0:
        خروجی = "-" + خروجی
    پایان
    برگشت خروجی
پایان

تابع رقم‌ماشین(رقم‌د: رشته):
    اگر تازه‌ماشین:
        نمایش‌ماشین = رقم‌د برابر "." ? "0." : رقم‌د
        تازه‌ماشین = نادرست
        برگشت
    پایان
    اگر رقم‌د برابر "." و نمایش‌ماشین.دربردارد("."):
        برگشت
    پایان
    اگر نمایش‌ماشین برابر "0" و رقم‌د نابرابر ".":
        نمایش‌ماشین = رقم‌د
    وگرنه:
        نمایش‌ماشین += رقم‌د
    پایان
پایان

تابع ترکیب‌ماشین(چپ‌عملوند: اعشار۶۴، وپ: رشته، راست‌عملوند: اعشار۶۴): اعشار۶۴:
    اگر وپ برابر "+":
        برگشت چپ‌عملوند + راست‌عملوند
    وگرنه وپ برابر "-":
        برگشت چپ‌عملوند - راست‌عملوند
    وگرنه وپ برابر "*":
        برگشت چپ‌عملوند * راست‌عملوند
    پایان
    برگشت راست‌عملوند برابر 0.0 ? 0.0 : چپ‌عملوند / راست‌عملوند
پایان

تابع عملگر‌ماشین(وپ: رشته):
    اگر عمل‌ماشین نابرابر "" و وارونه تازه‌ماشین:
        برابری‌ماشین()
    پایان
    انباره‌ماشین = نمایش‌ماشین.به اعشار()
    عمل‌ماشین = وپ
    تازه‌ماشین = درست
پایان

تابع برابری‌ماشین():
    اگر عمل‌ماشین برابر "":
        برگشت
    پایان
    راست‌عملوند := نمایش‌ماشین.به اعشار()
    اگر عمل‌ماشین برابر "/" و راست‌عملوند برابر 0.0:
        نمایش‌ماشین = "خطا"
        عمل‌ماشین = ""
        تازه‌ماشین = درست
        برگشت
    پایان
    پاسخ‌حساب := ترکیب‌ماشین(انباره‌ماشین، عمل‌ماشین، راست‌عملوند)
    تاریخچه‌ماشین.افزودن(عدد‌مرتب(انباره‌ماشین) + " " + عمل‌ماشین + " " + عدد‌مرتب(راست‌عملوند) + " = " + عدد‌مرتب(پاسخ‌حساب))
    نمایش‌ماشین = عدد‌مرتب(پاسخ‌حساب)
    انباره‌ماشین = پاسخ‌حساب
    عمل‌ماشین = ""
    تازه‌ماشین = درست
پایان

تابع پاک‌ماشین():
    نمایش‌ماشین = "0"
    انباره‌ماشین = 0.0
    عمل‌ماشین = ""
    تازه‌ماشین = درست
پایان

تابع برگشت‌ماشین():
    اگر تازه‌ماشین یا نمایش‌ماشین.طول() کوچکتربرابر 1:
        نمایش‌ماشین = "0"
        تازه‌ماشین = درست
    وگرنه:
        نمایش‌ماشین = نمایش‌ماشین.زیررشته(0، نمایش‌ماشین.طول() - 1)
    پایان
پایان

تابع قرینه‌ماشین():
    اگر نمایش‌ماشین نابرابر "0" و نمایش‌ماشین نابرابر "خطا":
        نمایش‌ماشین = نمایش‌ماشین.شروع با("-") ? نمایش‌ماشین.زیررشته(1، نمایش‌ماشین.طول() - 1) : "-" + نمایش‌ماشین
    پایان
پایان

تابع کلید‌ماشین(رویداد: صحیح۶۴):
    کلید := دام.کلید رویداد(رویداد)
    اگر کلید.طول() برابر 1 و "0123456789.".دربردارد(کلید):
        رقم‌ماشین(کلید)
    وگرنه کلید برابر "+" یا کلید برابر "-" یا کلید برابر "*" یا کلید برابر "/":
        عملگر‌ماشین(کلید)
    وگرنه کلید برابر "Enter" یا کلید برابر "=":
        برابری‌ماشین()
    وگرنه کلید برابر "Backspace":
        برگشت‌ماشین()
    وگرنه کلید برابر "Escape" یا کلید برابر "c":
        پاک‌ماشین()
    پایان
پایان

تابع گزینش‌تراشه(گروه: صحیح، کد: صحیح):
    اگر گروه برابر 0:
        تعیین‌دسته(کد)
    وگرنه گروه برابر 1:
        از‌واحد = کد
    وگرنه گروه برابر 2:
        به‌واحد = کد
    وگرنه گروه برابر 3:
        درصد‌انعام = کد
    وگرنه:
        طرح‌رنگ = کد
    پایان
پایان

ناب تابع شمار‌واحدها(رده: صحیح): صحیح:
    برگشت رده برابر 2 ? 3 : 4
پایان

ناب تابع نام‌واحد(رده: صحیح، جایگاه: صحیح): رشته:
    اگر رده برابر 0:
        برگشت جایگاه برابر 0 ? "m" : (جایگاه برابر 1 ? "km" : (جایگاه برابر 2 ? "mi" : "ft"))
    وگرنه رده برابر 1:
        برگشت جایگاه برابر 0 ? "kg" : (جایگاه برابر 1 ? "g" : (جایگاه برابر 2 ? "lb" : "oz"))
    پایان
    برگشت جایگاه برابر 0 ? "C" : (جایگاه برابر 1 ? "F" : "K")
پایان

ناب تابع نام‌دسته(رده: صحیح): رشته:
    برگشت رده برابر 0 ? "طول" : (رده برابر 1 ? "جرم" : "دما")
پایان

ناب تابع ضریب‌واحد(رده: صحیح، جایگاه: صحیح): اعشار۶۴:
    اگر رده برابر 0:
        برگشت جایگاه برابر 0 ? 1.0 : (جایگاه برابر 1 ? 1000.0 : (جایگاه برابر 2 ? 1609.344 : 0.3048))
    پایان
    برگشت جایگاه برابر 0 ? 1.0 : (جایگاه برابر 1 ? 0.001 : (جایگاه برابر 2 ? 0.45359237 : 0.028349523125))
پایان

ناب تابع به‌پایه(رده: صحیح، جایگاه: صحیح، مقدار‌م: اعشار۶۴): اعشار۶۴:
    اگر رده برابر 2:
        برگشت جایگاه برابر 0 ? مقدار‌م : (جایگاه برابر 1 ? (مقدار‌م - 32.0) * 5.0 / 9.0 : مقدار‌م - 273.15)
    پایان
    برگشت مقدار‌م * ضریب‌واحد(رده، جایگاه)
پایان

ناب تابع از‌پایه(رده: صحیح، جایگاه: صحیح، مقدار‌م: اعشار۶۴): اعشار۶۴:
    اگر رده برابر 2:
        برگشت جایگاه برابر 0 ? مقدار‌م : (جایگاه برابر 1 ? مقدار‌م * 9.0 / 5.0 + 32.0 : مقدار‌م + 273.15)
    پایان
    برگشت مقدار‌م / ضریب‌واحد(رده، جایگاه)
پایان

ناب تابع نتیجه‌تبدیل(): رشته:
    مقدار‌م := متن‌تبدیل.به اعشار()
    برگشت عدد‌مرتب(از‌پایه(دسته‌تبدیل، به‌واحد، به‌پایه(دسته‌تبدیل، از‌واحد، مقدار‌م)))
پایان

تابع تعیین‌دسته(رده: صحیح):
    دسته‌تبدیل = رده
    از‌واحد = 0
    به‌واحد = 1
پایان

تابع جابجایی‌واحدها():
    نگه‌دار := از‌واحد
    از‌واحد = به‌واحد
    به‌واحد = نگه‌دار
پایان

ناب تابع سنت‌صورتحساب(): صحیح:
    برگشت (متن‌صورتحساب.به اعشار() * 100.0 + 0.5) برگردان صحیح
پایان

ناب تابع صورتحساب‌درست(): منطقی:
    برگشت متن‌صورتحساب.به اعشار() بزرگتر 0.0
پایان

ناب تابع سنت‌انعام(): صحیح:
    برگشت سنت‌صورتحساب() * درصد‌انعام / 100
پایان

ناب تابع سنت‌کل(): صحیح:
    برگشت سنت‌صورتحساب() + سنت‌انعام()
پایان

ناب تابع سنت‌هرنفر(): صحیح:
    برگشت (سنت‌کل() + تعداد‌نفرات - 1) / تعداد‌نفرات
پایان

ناب تابع پول‌متن(سنت‌ها: صحیح): رشته:
    برگشت "$" + (سنت‌ها / 100) + "." + دورقمی(سنت‌ها % 100)
پایان

تابع نفرات‌بیشتر(گام‌نفر: صحیح):
    تعداد‌نفرات += گام‌نفر
    اگر تعداد‌نفرات کوچکتر 1:
        تعداد‌نفرات = 1
    پایان
    اگر تعداد‌نفرات بزرگتر 20:
        تعداد‌نفرات = 20
    پایان
پایان

ناب تابع نوع‌خط(خط‌متن: رشته): صحیح:
    اگر خط‌متن.طول() برابر 0:
        برگشت 0
    وگرنه خط‌متن.شروع با("## "):
        برگشت 2
    وگرنه خط‌متن.شروع با("# "):
        برگشت 1
    وگرنه خط‌متن.شروع با("- "):
        برگشت 3
    پایان
    برگشت 4
پایان

ناب تابع متن‌خط(خط‌متن: رشته): رشته:
    قالب := نوع‌خط(خط‌متن)
    اگر قالب برابر 1 یا قالب برابر 3:
        برگشت خط‌متن.زیررشته(2، خط‌متن.طول() - 2)
    وگرنه قالب برابر 2:
        برگشت خط‌متن.زیررشته(3، خط‌متن.طول() - 3)
    پایان
    برگشت خط‌متن
پایان

ناب تابع واژه‌های‌مارک‌داون(): صحیح:
    ناپایا کل := 0
    هر تکه در متن‌مارک‌داون.بشکاف(" "):
        اگر تکه.پیراست().طول() بزرگتر 0:
            کل++
        پایان
    پایان
    برگشت کل
پایان

ناب تابع نام‌طرح(کدام: صحیح): رشته:
    برگشت کدام برابر 0 ? "همسایه" : (کدام برابر 1 ? "مکمل" : (کدام برابر 2 ? "سه‌گانه" : "تک‌رنگ"))
پایان

ناب تابع جابجایی‌رنگ(جایگاه: صحیح): صحیح:
    اگر طرح‌رنگ برابر 0:
        برگشت (جایگاه - 2) * 20
    وگرنه طرح‌رنگ برابر 1:
        برگشت جایگاه کوچکتر 2 ? جایگاه * 15 : (جایگاه برابر 2 ? 180 : 180 + (جایگاه - 2) * 15)
    وگرنه طرح‌رنگ برابر 2:
        برگشت (جایگاه % 3) * 120
    پایان
    برگشت 0
پایان

ناب تابع رنگ‌نمونه(جایگاه: صحیح): رشته:
    اگر قفل‌شده[جایگاه] برابر 1:
        برگشت قفل‌رنگ[جایگاه]
    پایان
    روشنایی := 28 + جایگاه * 14
    ساعت‌ن := (رنگمایه + جابجایی‌رنگ(جایگاه) + 360) % 360
    برگشت "hsl(" + ساعت‌ن + ", 65%, " + روشنایی + "%)"
پایان

تابع تغییر‌قفل(جایگاه: صحیح):
    اگر قفل‌شده[جایگاه] برابر 0:
        قفل‌رنگ[جایگاه] = رنگ‌نمونه(جایگاه)
    پایان
    قفل‌شده[جایگاه] = 1 - قفل‌شده[جایگاه]
پایان

تابع رنگمایه‌تصادفی():
    رنگمایه = (دام.تصادفی() * 360.0) برگردان صحیح
پایان

تابع کلید‌رنگ(رویداد: صحیح۶۴):
    اگر دام.کلید رویداد(رویداد) برابر " ":
        دام.جلوگیری پیش فرض(رویداد)
        رنگمایه‌تصادفی()
    پایان
پایان

ناب تابع نام‌شهر(شهر‌ج: صحیح): رشته:
    برگشت شهر‌ج برابر 0 ? "تهران" : (شهر‌ج برابر 1 ? "اسلو" : (شهر‌ج برابر 2 ? "لیما" : "اوزاکا"))
پایان

ناب تابع نشانک‌شهر(شهر‌ج: صحیح): رشته:
    برگشت شهر‌ج برابر 0 ? "tehran" : (شهر‌ج برابر 1 ? "oslo" : (شهر‌ج برابر 2 ? "lima" : "osaka"))
پایان

ناب تابع جایگاه‌شهر(سلوگ: رشته): صحیح:
    هر شهر‌ج در شهرها:
        اگر نشانک‌شهر(شهر‌ج) برابر سلوگ:
            برگشت شهر‌ج
        پایان
    پایان
    برگشت -1
پایان

ناب تابع دمای‌شهر(شهر‌ج: صحیح): صحیح:
    برگشت شهر‌ج برابر 0 ? 28 : (شهر‌ج برابر 1 ? 6 : (شهر‌ج برابر 2 ? 19 : 22))
پایان

ناب تابع آسمان‌شهر(شهر‌ج: صحیح): رشته:
    برگشت شهر‌ج برابر 0 ? "صاف و خشک" : (شهر‌ج برابر 1 ? "برف سبک" : (شهر‌ج برابر 2 ? "مه صبحگاهی" : "بارش گذرا"))
پایان

ناب تابع رطوبت‌شهر(شهر‌ج: صحیح): صحیح:
    برگشت شهر‌ج برابر 0 ? 18 : (شهر‌ج برابر 1 ? 81 : (شهر‌ج برابر 2 ? 88 : 69))
پایان

ناب تابع باد‌شهر(شهر‌ج: صحیح): صحیح:
    برگشت شهر‌ج برابر 0 ? 9 : (شهر‌ج برابر 1 ? 21 : (شهر‌ج برابر 2 ? 12 : 15))
پایان

ناب تابع دمای‌ساعت(شهر‌ج: صحیح، ساعت‌ن: صحیح): صحیح:
    برگشت دمای‌شهر(شهر‌ج) + (ساعت‌ن برابر 0 ? -2 : (ساعت‌ن برابر 1 ? 0 : (ساعت‌ن برابر 2 ? 3 : (ساعت‌ن برابر 3 ? 2 : (ساعت‌ن برابر 4 ? -1 : -3)))))
پایان

ناب تابع متن‌دما(سانتی‌گراد: صحیح): رشته:
    اگر فارنهایت‌باشد:
        برگشت ((سانتی‌گراد * 9 / 5) + 32) + " F"
    پایان
    برگشت سانتی‌گراد + " C"
پایان

صفحه:
    عنوان = "جعبه‌ابزار"
    زبان = "fa"
    خانواده قلم = "Tahoma, system-ui, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = #f3f6f6
        رنگ = #14211f
        سرصفحه:
            چیدمان = ردیف
            تراز = وسط
            شکستن خط = درست
            شکاف = 12
            فاصله = 14، 24
            پس زمینه = #0d9488
            پیوند:
                to = "/"
                اندازه قلم = 22
                وزن قلم = 800
                رنگ = #ffffff
                تزیین متن = هیچ
                محتوا = "جعبه‌ابزار"
            پایان
            ناوبری:
                چیدمان = ردیف
                شکستن خط = درست
                شکاف = 4
                پیوند:
                    to = "/calc"
                    فاصله = 6، 12
                    رنگ = #ffffff
                    تزیین متن = هیچ
                    محتوا = "ماشین‌حساب"
                پایان
                پیوند:
                    to = "/convert"
                    فاصله = 6، 12
                    رنگ = #ffffff
                    تزیین متن = هیچ
                    محتوا = "مبدل"
                پایان
                پیوند:
                    to = "/tip"
                    فاصله = 6، 12
                    رنگ = #ffffff
                    تزیین متن = هیچ
                    محتوا = "انعام"
                پایان
                پیوند:
                    to = "/markdown"
                    فاصله = 6، 12
                    رنگ = #ffffff
                    تزیین متن = هیچ
                    محتوا = "مارک‌داون"
                پایان
                پیوند:
                    to = "/palette"
                    فاصله = 6، 12
