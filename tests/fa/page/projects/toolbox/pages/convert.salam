همگانی بخش مبدل:
    عنوان = "مبدل"
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "مبدل واحد"
        پایان
        جعبه:
            چیدمان = ردیف
            شکستن خط = درست
            شکاف = 8
            هر رده در [0، 1، 2]:
                تراشه:
                    برچسب = نام‌دسته(رده)
                    برگزیده = (دسته‌تبدیل برابر رده)
                    کد = رده
                    گروه = 0
                پایان
            پایان
        پایان
        ورودی:
            شناسه = "amount"
            فاصله = 10، 14
            گردی = 10
            کادر = 1، توپر، #b9c7c5
            اندازه قلم = 20
            پیوند = متن‌تبدیل
        پایان
        جعبه:
            شکاف = 6
            ریز:
                محتوا = "از"
            پایان
            جعبه:
                چیدمان = ردیف
                شکستن خط = درست
                شکاف = 8
                هر جایگاه در [0، 1، 2، 3]:
                    اگر جایگاه کوچکتر شمار‌واحدها(دسته‌تبدیل):
                        تراشه:
                            برچسب = نام‌واحد(دسته‌تبدیل، جایگاه)
                            برگزیده = (از‌واحد برابر جایگاه)
                            کد = جایگاه
                            گروه = 1
                        پایان
                    پایان
                پایان
            پایان
            ریز:
                محتوا = "به"
            پایان
            جعبه:
                چیدمان = ردیف
                شکستن خط = درست
                شکاف = 8
                هر جایگاه در [0، 1، 2، 3]:
                    اگر جایگاه کوچکتر شمار‌واحدها(دسته‌تبدیل):
                        تراشه:
                            برچسب = نام‌واحد(دسته‌تبدیل، جایگاه)
                            برگزیده = (به‌واحد برابر جایگاه)
                            کد = جایگاه
                            گروه = 2
                        پایان
                    پایان
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 12
            دکمه:
                شناسه = "swap"
                فاصله = 8، 16
                گردی = 10
                کادر = 1، توپر، #0d9488
                پس زمینه = شفاف
                رنگ = #0d9488
                نشانگر = اشاره
                کلیک = جابجایی‌واحدها
                محتوا = "جابجایی واحدها"
            پایان
            پاراگراف:
                شناسه = "answer"
                فضا = 0
                اندازه قلم = 24
                وزن قلم = 700
                محتوا = متن‌تبدیل + " " + نام‌واحد(دسته‌تبدیل، از‌واحد) + " = " + نتیجه‌تبدیل() + " " + نام‌واحد(دسته‌تبدیل، به‌واحد)
            پایان
        پایان
    پایان
پایان
