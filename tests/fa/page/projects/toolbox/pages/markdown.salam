همگانی بخش مارک‌داون:
    عنوان = "مارک‌داون"
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "پیش‌نمایش مارک‌داون"
        پایان
        جعبه:
            چیدمان = ردیف
            شکستن خط = درست
            شکاف = 16
            ورودی:
                شناسه = "source"
                نوع = "ناحیه متن"
                ردیف‌ها = 14
                رشد = 1
                پایه = 0
                کمینه عرض = 260
                فاصله = 12
                گردی = 12
                کادر = 1، توپر، #b9c7c5
                خانواده قلم = "ui-monospace, monospace"
                پیوند = متن‌مارک‌داون
            پایان
            جعبه:
                شناسه = "preview"
                رشد = 1
                پایه = 0
                کمینه عرض = 260
                فاصله = 12
                گردی = 12
                پس زمینه = #ffffff
                هر خط‌متن در متن‌مارک‌داون.بشکاف("\n"):
                    خط‌مارک‌داون:
                        قالبی = نوع‌خط(خط‌متن)
                        متن = متن‌خط(خط‌متن)
                    پایان
                پایان
            پایان
        پایان
        ریز:
            شناسه = "words"
            شفافیت = 0.7
            محتوا = واژه‌های‌مارک‌داون() + " واژه"
        پایان
    پایان
پایان
