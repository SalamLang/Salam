// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش پالت:
    عنوان = "پالت"
    جعبه:
        شناسه = "palette-box"
        فشردن کلید = کلید‌رنگ
        ترتیب جهش = 0
        شکاف = 14
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "پالت‌ساز"
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 8
            هر ش، شماره‌طرح در [0، 1، 2، 3]:
                تراشه:
                    کلید = ش
                    برچسب = نام‌طرح(شماره‌طرح)
                    برگزیده = (طرح‌رنگ برابر شماره‌طرح)
                    کد = شماره‌طرح
                    گروه = 4
                پایان
            پایان
        پایان
        برچسب:
            شکاف = 6
            تکه:
                شناسه = "hue-label"
                محتوا = "رنگمایه " + رنگمایه
            پایان
            ورودی:
                شناسه = "hue"
                نوع = "بازه"
                کمینه = 0
                بیشینه = 359
                مقدار = رنگمایه
                ورودی = (نوشته: رشته):
                    رنگمایه = نوشته.به صحیح()
                پایان
            پایان
        پایان
        دکمه:
            شناسه = "random"
            فاصله = 10، 20
            گردی = 10
            کادر = 0
            پس زمینه = "#0d9488"
            رنگ = "#ffffff"
            نشانگر = "اشاره"
            کلیک = رنگمایه‌تصادفی
            محتوا = "رنگمایه تصادفی (فاصله)"
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 10
            هر ش، جایگاه در پنج‌تایی:
                نمونه‌رنگ:
                    کلید = ش
                    نمونه = رنگ‌نمونه(جایگاه)
                    قفلی = (قفل‌شده[جایگاه] برابر 1)
                    شماره = جایگاه
                پایان
            پایان
        پایان
    پایان
پایان
