// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش انعام:
    عنوان = "تقسیم انعام"
    جعبه:
        شکاف = 14
        بیشینه عرض = 460
        سرتیتر:
            اندازه = 2
            فضا = 0
            محتوا = "تقسیم انعام"
        پایان
        برچسب:
            شکاف = 6
            تکه:
                محتوا = "مبلغ صورتحساب"
            پایان
            ورودی:
                شناسه = "bill"
                فاصله = 10، 14
                گردی = 10
                کادر = 1، توپر، #b9c7c5
                اندازه قلم = 20
                پیوند = متن‌صورتحساب
            پایان
        پایان
        اگر وارونه صورتحساب‌درست():
            پاراگراف:
                شناسه = "bill-error"
                فضا = 0
                رنگ = #dc2626
                محتوا = "مبلغی بیشتر از صفر بنویسید، مثلا 48.50"
            پایان
        پایان
        جعبه:
            شکاف = 6
            تکه:
                محتوا = "انعام " + درصد‌انعام + "%"
            پایان
            جعبه:
                چیدمان = ردیف
                شکستن خط = درست
                شکاف = 8
                هر درصدی در درصدها:
                    تراشه:
                        برچسب = درصدی + "%"
                        برگزیده = (درصد‌انعام برابر درصدی)
                        کد = درصدی
                        گروه = 3
                    پایان
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 10
            تکه:
                محتوا = "نفرات"
            پایان
            دکمه:
                شناسه = "fewer"
                فاصله = 6، 14
                گردی = 999
                کادر = 1، توپر، #0d9488
                پس زمینه = شفاف
                نشانگر = اشاره
                کلیک = ():
                    نفرات‌بیشتر(-1)
                پایان
                محتوا = "-"
            پایان
            قوی:
                شناسه = "party"
                محتوا = تعداد‌نفرات
            پایان
            دکمه:
                شناسه = "more"
                فاصله = 6، 14
                گردی = 999
                کادر = 1، توپر، #0d9488
                پس زمینه = شفاف
                نشانگر = اشاره
                کلیک = ():
                    نفرات‌بیشتر(1)
                پایان
                محتوا = "+"
            پایان
        پایان
        اگر صورتحساب‌درست():
            جعبه:
                فاصله = 16
                گردی = 14
                پس زمینه = #ffffff
                شکاف = 6
                پاراگراف:
                    شناسه = "tip-amount"
                    فضا = 0
                    محتوا = "انعام: " + پول‌متن(سنت‌انعام())
                پایان
                پاراگراف:
                    شناسه = "total"
                    فضا = 0
                    محتوا = "جمع: " + پول‌متن(سنت‌کل())
                پایان
                پاراگراف:
                    شناسه = "each"
                    فضا = 0
                    اندازه قلم = 22
                    وزن قلم = 700
                    محتوا = "هر نفر: " + پول‌متن(سنت‌هرنفر())
                پایان
            پایان
        پایان
    پایان
پایان
