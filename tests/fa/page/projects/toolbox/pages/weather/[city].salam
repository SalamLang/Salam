 */
همگانی بخش پیش‌بینی(city: رشته):
    عنوان = "هوا"
    جعبه:
        شکاف = 14
        اگر جایگاه‌شهر(city) بزرگتربرابر 0:
            پیوند:
                to = "/weather"
                رنگ = "#0d9488"
                تزیین متن = "هیچ"
                محتوا = "همه شهرها"
            پایان
            سرتیتر:
                شناسه = "city-name"
                اندازه = 1
                فضا = 0
                محتوا = نام‌شهر(جایگاه‌شهر(city))
            پایان
            پاراگراف:
                شناسه = "now"
                فضا = 0
                اندازه قلم = 28
                محتوا = متن‌دما(دمای‌شهر(جایگاه‌شهر(city))) + ", " + آسمان‌شهر(جایگاه‌شهر(city))
            پایان
            پاراگراف:
                شناسه = "extras"
                فضا = 0
                شفافیت = 0.75
                محتوا = "رطوبت " + رطوبت‌شهر(جایگاه‌شهر(city)) + "٪، باد " + باد‌شهر(جایگاه‌شهر(city)) + " کیلومتر بر ساعت"
            پایان
            جعبه:
                چیدمان = "ردیف"
                شکاف = 8
                هر _، ساعت‌ن در [0، 1، 2، 3، 4، 5]:
                    ستون:
                        درصد = 30 + دمای‌ساعت(جایگاه‌شهر(city)، ساعت‌ن) * 2
                        شرح = (9 + ساعت‌ن * 3) + ":00"
                        قرائت = متن‌دما(دمای‌ساعت(جایگاه‌شهر(city)، ساعت‌ن))
                    پایان
                پایان
            پایان
            برچسب:
                چیدمان = "ردیف"
                تراز = "وسط"
                شکاف = 8
                ورودی:
                    شناسه = "fahrenheit-detail"
                    نوع = "تیک"
                    پیوند = فارنهایت‌باشد
                پایان
                تکه:
                    محتوا = "فارنهایت"
                پایان
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 2
                محتوا = "هوای این شهر نیست: " + city
            پایان
            پیوند:
                to = "/weather"
                محتوا = "یک شهر شناخته‌شده انتخاب کنید"
            پایان
        پایان
    پایان
پایان
