همگانی بخش فهرست‌شهرها:
    عنوان = "هوا"
    جعبه:
        شکاف = 14
        جعبه:
            چیدمان = "ردیف"
            تراز = "وسط"
            چینش = "میان"
            سرتیتر:
                اندازه = 2
                فضا = 0
                محتوا = "هوا"
            پایان
            برچسب:
                چیدمان = "ردیف"
                تراز = "وسط"
                شکاف = 8
                ورودی:
                    شناسه = "fahrenheit"
                    نوع = "تیک"
                    پیوند = فارنهایت‌باشد
                پایان
                تکه:
                    محتوا = "فارنهایت"
                پایان
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکستن خط = درست
            شکاف = 12
            هر شهر‌ج در شهرها:
                پیوند:
                    کلاس = "city"
                    to = "/weather/" + نشانک‌شهر(شهر‌ج)
                    رشد = 1
                    پایه = 0
                    کمینه عرض = 140
                    فاصله = 14
                    گردی = 14
                    پس زمینه = "#ffffff"
                    رنگ = "#14211f"
                    تزیین متن = "هیچ"
                    جعبه:
                        اندازه قلم = 14
                        محتوا = نام‌شهر(شهر‌ج)
                    پایان
                    جعبه:
                        اندازه قلم = 30
                        وزن قلم = 700
                        محتوا = متن‌دما(دمای‌شهر(شهر‌ج))
                    پایان
                    ریز:
                        شفافیت = 0.7
                        محتوا = آسمان‌شهر(شهر‌ج)
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
