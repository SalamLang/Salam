// انتظار: src: url("https://cdn.example.com/Estedad-Bold.woff2") format("woff2"); font-weight: 700;
// انتظار: font-family: استعداد, sans-serif;
صفحه:
    قلم: نام = «استعداد» منبع = «https://cdn.example.com/Estedad-Light.woff2» وزن = «300» پایان
    قلم: نام = «استعداد» منبع = «https://cdn.example.com/Estedad-Bold.woff2» وزن = «700» پایان
    جعبه:
        محتوا = «درود»
        خانواده قلم = «استعداد, sans-serif»
    پایان
پایان
