// انتظار: background-image:conic-gradient(from 0deg,#ff0000,#0000ff)
// انتظار: conic-gradient(from 45deg,#ff0000,#0000ff)
// انتظار: radial-gradient(circle,#ff0000,#0000ff)
صفحه:
    جعبه: محتوا = "x0" پس‌زمینه = conic(red، blue) پایان
    جعبه: محتوا = "x1" پس‌زمینه = conic(۴۵، red، blue) پایان
    جعبه: محتوا = "x2" پس‌زمینه = radial(دایره، red، blue) پایان
پایان
