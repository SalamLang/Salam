صفحه:
    عنوان = "واژه‌های چینش"
    جعبه:
        چیدمان = ردیف
        چینش = میان
        جعبه: عرض = 20 پایان
        جعبه: عرض = 20 پایان
    پایان
    جعبه:
        چیدمان = ردیف
        چینش = پیرامون
        جعبه: عرض = 20 پایان
    پایان
    جعبه:
        چیدمان = ردیف
        چینش = یکسان
        جعبه: عرض = 20 پایان
    پایان
پایان
