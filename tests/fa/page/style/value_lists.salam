صفحه:
    جعبه:
        فاصله = ۸، ۱۶
        کادر = ۲، یکپارچه، #3366aa
        عرض = ۵۰٪
        شکاف = 1em، ۲۵٪
        سایه کادر = [۰، ۴، ۸، #000]، [0, 1, 2, red]
        محتوا = "الف"
    پایان
پایان
