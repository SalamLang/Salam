// انتظار: @media not (width < 900px)
// انتظار: @media (width >= 600px)
صفحه:
    جعبه:
        نمایان = نادرست
        اگر عرض صفحه کوچکتر 900:
            نمایان = درست
        پایان
        پاراگراف: محتوا = "فقط باریک" پایان
    پایان
    جعبه:
        چیدمان = "ردیف"
        اگر عرض صفحه بزرگتربرابر 600:
            نمایان = نادرست
        پایان
        پاراگراف: محتوا = "در پهن پنهان" پایان
    پایان
پایان
