واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    v := ریلیب.ساخت بردار دو(1.5، 2.5)
    سرچاپ v.ایکس، v.وای
    w := ریلیب.ساخت بردار سه(1.0، 2.0، 3.0)
    سرچاپ w.ایکس، w.وای، w.زد
    r := ریلیب.ساخت مستطیل(10.0، 20.0، 30.0، 40.0)
    سرچاپ r.ایکس، r.وای، r.عرض، r.ارتفاع
    c := ریلیب.ساخت رنگ شفاف(10، 20، 30، 40)
    سرچاپ c.قرمز، c.سبز، c.آبی، c.شفافیت
    سرچاپ ریلیب.ساخت رنگ(1، 2، 3).شفافیت
    رنگ قرمز := ریلیب.قرمز()
    سرچاپ رنگ قرمز.قرمز، رنگ قرمز.سبز، رنگ قرمز.آبی، رنگ قرمز.شفافیت
    سرچاپ ریلیب.شفاف().شفافیت
    سرچاپ ریلیب.رنگ‌ها برابرند(ریلیب.سفید()، ریلیب.ساخت رنگ شفاف(255، 255، 255، 255))
    سرچاپ ریلیب.کلید فاصله، ریلیب.کلید گریز، ریلیب.کلید ای، ریلیب.کلید اف پنج، ریلیب.کلید عددی ورود
    سرچاپ ریلیب.دکمه چپ ماوس، ریلیب.دکمه وسط ماوس
    سرچاپ ریلیب.پرچم همگام‌سازی عمودی | ریلیب.پرچم پنجره تغییر اندازه‌پذیر
    سرچاپ ریلیب.گزارش هشدار، ریلیب.ترکیب افزایشی، ریلیب.دوربین مداری
    دوربین سه‌بعدی := ریلیب.ساخت دوربین سه‌بعدی(ریلیب.ساخت بردار سه(0.0، 10.0، 10.0)، ریلیب.ساخت بردار سه(0.0، 0.0، 0.0)، ریلیب.ساخت بردار سه(0.0، 1.0، 0.0)، 45.0، ریلیب.نمایش پرسپکتیو)
    سرچاپ دوربین سه‌بعدی.مکان.وای، دوربین سه‌بعدی.میدان دید، دوربین سه‌بعدی.نمایش
    دوربین دوبعدی := ریلیب.ساخت دوربین دوبعدی(ریلیب.ساخت بردار دو(1.0، 2.0)، ریلیب.ساخت بردار دو(3.0، 4.0)، 5.0، 6.0)
    سرچاپ دوربین دوبعدی.جابه‌جایی.وای، دوربین دوبعدی.هدف.ایکس، دوربین دوبعدی.چرخش، دوربین دوبعدی.بزرگنمایی
پایان
