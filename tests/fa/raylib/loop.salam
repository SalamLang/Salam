واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.تنظیم پرچم‌های پیکربندی(ریلیب.پرچم همگام‌سازی عمودی)
    ریلیب.ایجاد پنجره(800، 450، "Salam raylib")
    ریلیب.تنظیم نرخ فریم هدف(60)
    ناپایا x := 100.0
    ناپایا frames := 0
    تا وارونه ریلیب.پنجره باید بسته شود():
        x += 50.0 * ریلیب.زمان فریم() برگردان اعشار۶۴
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم دایره(x برگردان صحیح، 225، 40.0، ریلیب.عنابی())
        ریلیب.رسم مستطیل رکوردی(ریلیب.ساخت مستطیل(10.0، 10.0، 100.0، 50.0)، ریلیب.کم‌رنگ کردن(ریلیب.آبی()، 0.5))
        ریلیب.رسم متن("frame"، 20، 20، 20، ریلیب.خاکستری تیره())
        ریلیب.پایان رسم()
        frames += 1
    پایان
    ریلیب.بستن پنجره()
    سرچاپ "frames"، frames
    سرچاپ "x"، x
پایان
