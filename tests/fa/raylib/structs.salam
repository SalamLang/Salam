واردسازی رابط گرافیکی.ریلیب

درون‌داد:
    تابع salam_mock_last(): اعشار۶۴
پایان

تابع ریشه:
    m := ریلیب.مکان ماوس()
    سرچاپ "mouse"، m.ایکس، m.وای
    سرچاپ "frame"، ریلیب.زمان فریم()
    سرچاپ "width"، ریلیب.عرض صفحه()
    سرچاپ "rand"، ریلیب.مقدار تصادفی(3، 4)
    a := ریلیب.ساخت مستطیل(0.0، 0.0، 10.0، 10.0)
    b := ریلیب.ساخت مستطیل(5.0، 5.0، 10.0، 10.0)
    c := ریلیب.ساخت مستطیل(50.0، 50.0، 1.0، 1.0)
    سرچاپ "recs"، ریلیب.برخورد مستطیل‌ها(a، b)، ریلیب.برخورد مستطیل‌ها(a، c)
    f := ریلیب.کم‌رنگ کردن(ریلیب.ساخت رنگ(1، 2، 3)، 0.5)
    سرچاپ "fade"، f.قرمز، f.سبز، f.آبی، f.شفافیت
    سرچاپ "toint"، ریلیب.رنگ به عدد(ریلیب.ساخت رنگ شفاف(1، 2، 3، 4))
    سرچاپ "key"، ریلیب.کلید پایین است(ریلیب.کلید ای)، ریلیب.کلید پایین است(ریلیب.کلید بی)
    t := ریلیب.بارگذاری بافت("x.png")
    سرچاپ "tex"، t.شناسه، t.عرض، t.ارتفاع، t.سطح‌های مینی، t.قالب
    تصویر := ریلیب.تولید تصویر تک‌رنگ(16، 8، ریلیب.ساخت رنگ شفاف(5، 0، 0، 9))
    سرچاپ "img"، تصویر.عرض، تصویر.ارتفاع، تصویر.سطح‌های مینی، تصویر.قالب
    قلم := ریلیب.قلم پیش‌فرض()
    اندازه := ریلیب.اندازه‌گیری متن با قلم(قلم، "abc"، 20.0، 1.0)
    سرچاپ "measure"، اندازه.ایکس، اندازه.وای
    دوربین := ریلیب.ساخت دوربین دوبعدی(ریلیب.ساخت بردار دو(100.0، 0.0)، ریلیب.ساخت بردار دو(0.0، 7.0)، 2.0، 3.0)
    ماتریس۲ := ریلیب.ماتریس دوربین دوبعدی(دوربین)
    سرچاپ "matrix"، ماتریس۲.درایه صفر، ماتریس۲.درایه پنج، ماتریس۲.درایه دوازده، ماتریس۲.درایه سیزده
    شعاع := ریلیب.پرتو { مکان = ریلیب.ساخت بردار سه(1.0، 0.0، 0.0)، جهت = ریلیب.ساخت بردار سه(0.0، 0.0، 9.0) }
    نتیجه پرتو := ریلیب.برخورد پرتو‌کره(شعاع، ریلیب.ساخت بردار سه(0.0، 2.0، 0.0)، 4.0)
    سرچاپ "ray"، نتیجه پرتو.برخورد کرده، نتیجه پرتو.فاصله، نتیجه پرتو.نقطه.زد، نتیجه پرتو.عمود.وای
    مدل نمونه := ریلیب.مدل { شمار مش = 3، شمار استخوان = 5 }
    جعبه := ریلیب.جعبه کران مدل(مدل نمونه)
    سرچاپ "bbox"، جعبه.کمینه.ایکس، جعبه.بیشینه.وای، جعبه.بیشینه.زد
    ریلیب.رسم پیشرفته بافت(t، ریلیب.ساخت مستطیل(0.0، 0.0، 8.0، 8.0)، ریلیب.ساخت مستطیل(0.0، 0.0، 1.0، 16.0)، ریلیب.ساخت بردار دو(0.0، 4.0)، 2.0، ریلیب.ساخت رنگ(0، 0، 100))
    سرچاپ "drawpro"، salam_mock_last()
    ریلیب.تنظیم ماتریس سایه‌زن(ریلیب.سایه‌زن { شناسه = 5 برگردان طبیعی۳۲ }، 2، ریلیب.ماتریس { درایه پانزده = 1.5 برگردان اعشار۳۲ })
    سرچاپ "shadermat"، salam_mock_last()
    انیمیشن := ریلیب.پویانمایی مدل { شمار استخوان = 2، شمار فریم = 10 }
    ریلیب.به‌روزرسانی پویانمایی مدل(مدل نمونه، انیمیشن، 1)
    سرچاپ "anim"، salam_mock_last()
    سرچاپ "monitor"، ریلیب.نام نمایشگر(0)، ریلیب.نام نمایشگر(1)
    ناپایا عکس := ریلیب.تولید تصویر تک‌رنگ(4، 4، ریلیب.شفاف())
    ریلیب.تغییر اندازه تصویر(عکس، 30، 20)
    سرچاپ "resize"، عکس.عرض، عکس.ارتفاع
    ناپایا نقطه برخورد := ریلیب.ساخت بردار دو(0.0، 0.0)
    موفق := ریلیب.برخورد خط‌ها(ریلیب.ساخت بردار دو(0.0، 0.0)، ریلیب.ساخت بردار دو(1.0، 1.0)، ریلیب.ساخت بردار دو(0.0، 1.0)، ریلیب.ساخت بردار دو(1.0، 0.0)، نقطه برخورد)
    سرچاپ "lines"، موفق، نقطه برخورد.ایکس، نقطه برخورد.وای
    ناپایا n := 0
    ریلیب.بارگذاری داده پرونده("f"، n)
    سرچاپ "filedata"، n
پایان
