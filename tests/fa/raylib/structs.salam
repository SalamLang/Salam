واردسازی رابط گرافیکی.ریلیب

درون‌داد:
    تابع salam_mock_last(): اعشار۶۴
پایان

تابع ریشه:
    m := ریلیب.مکان ماوس()
    سرچاپ "mouse"، m.ایکس، m.وای
    سرچاپ "frame"، ریلیب.زمان فریم()
    سرچاپ "width"، ریلیب.عرض صفحه()
    سرچاپ "rand"، ریلیب.مقدار تصادفی(3، 4)
    a := ریلیب.ساخت مستطیل(0.0، 0.0، 10.0، 10.0)
    b := ریلیب.ساخت مستطیل(5.0، 5.0، 10.0، 10.0)
    c := ریلیب.ساخت مستطیل(50.0، 50.0، 1.0، 1.0)
    سرچاپ "recs"، ریلیب.برخورد مستطیل‌ها(a، b)، ریلیب.برخورد مستطیل‌ها(a، c)
    f := ریلیب.کم‌رنگ کردن(ریلیب.ساخت رنگ(1، 2، 3)، 0.5)
    سرچاپ "fade"، f.قرمز، f.سبز، f.آبی، f.شفافیت
    سرچاپ "toint"، ریلیب.رنگ به عدد(ریلیب.ساخت رنگ شفاف(1، 2، 3، 4))
    سرچاپ "key"، ریلیب.کلید پایین است(ریلیب.کلید ای)، ریلیب.کلید پایین است(ریلیب.کلید بی)
    t := ریلیب.بارگذاری بافت("x.png")
    سرچاپ "tex"، t.شناسه، t.عرض، t.ارتفاع، t.سطح‌های مینی، t.قالب
    img := ریلیب.تولید تصویر تک‌رنگ(16، 8، ریلیب.ساخت رنگ شفاف(5، 0، 0، 9))
    سرچاپ "img"، img.عرض، img.ارتفاع، img.سطح‌های مینی، img.قالب
    font := ریلیب.قلم پیش‌فرض()
    sz := ریلیب.اندازه‌گیری متن با قلم(font، "abc"، 20.0، 1.0)
    سرچاپ "measure"، sz.ایکس، sz.وای
    cam := ریلیب.ساخت دوربین دوبعدی(ریلیب.ساخت بردار دو(100.0، 0.0)، ریلیب.ساخت بردار دو(0.0، 7.0)، 2.0، 3.0)
    mat := ریلیب.ماتریس دوربین دوبعدی(cam)
    سرچاپ "matrix"، mat.درایه صفر، mat.درایه پنج، mat.درایه دوازده، mat.درایه سیزده
    ray := ریلیب.پرتو { مکان = ریلیب.ساخت بردار سه(1.0، 0.0، 0.0)، جهت = ریلیب.ساخت بردار سه(0.0، 0.0، 9.0) }
    rc := ریلیب.برخورد پرتو‌کره(ray، ریلیب.ساخت بردار سه(0.0، 2.0، 0.0)، 4.0)
    سرچاپ "ray"، rc.برخورد کرده، rc.فاصله، rc.نقطه.زد، rc.عمود.وای
    model := ریلیب.مدل { شمار مش = 3، شمار استخوان = 5 }
    bb := ریلیب.جعبه کران مدل(model)
    سرچاپ "bbox"، bb.کمینه.ایکس، bb.بیشینه.وای، bb.بیشینه.زد
    ریلیب.رسم پیشرفته بافت(t، ریلیب.ساخت مستطیل(0.0، 0.0، 8.0، 8.0)، ریلیب.ساخت مستطیل(0.0، 0.0، 1.0، 16.0)، ریلیب.ساخت بردار دو(0.0، 4.0)، 2.0، ریلیب.ساخت رنگ(0، 0، 100))
    سرچاپ "drawpro"، salam_mock_last()
    ریلیب.تنظیم ماتریس سایه‌زن(ریلیب.سایه‌زن { شناسه = 5 برگردان طبیعی۳۲ }، 2، ریلیب.ماتریس { درایه پانزده = 1.5 برگردان اعشار۳۲ })
    سرچاپ "shadermat"، salam_mock_last()
    anim := ریلیب.پویانمایی مدل { شمار استخوان = 2، شمار فریم = 10 }
    ریلیب.به‌روزرسانی پویانمایی مدل(model، anim، 1)
    سرچاپ "anim"، salam_mock_last()
    سرچاپ "monitor"، ریلیب.نام نمایشگر(0)، ریلیب.نام نمایشگر(1)
    ناپایا pic := ریلیب.تولید تصویر تک‌رنگ(4، 4، ریلیب.شفاف())
    ریلیب.تغییر اندازه تصویر(pic، 30، 20)
    سرچاپ "resize"، pic.عرض، pic.ارتفاع
    ناپایا hitp := ریلیب.ساخت بردار دو(0.0، 0.0)
    ok := ریلیب.برخورد خط‌ها(ریلیب.ساخت بردار دو(0.0، 0.0)، ریلیب.ساخت بردار دو(1.0، 1.0)، ریلیب.ساخت بردار دو(0.0، 1.0)، ریلیب.ساخت بردار دو(1.0، 0.0)، hitp)
    سرچاپ "lines"، ok، hitp.ایکس، hitp.وای
    ناپایا n := 0
    ریلیب.بارگذاری داده پرونده("f"، n)
    سرچاپ "filedata"، n
پایان
