بسته ریشه

واردسازی اس اس ال
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع خدمت():
    کارگزار := تی سی پی.پیوند(19306)
    همگام سازی.اتمام(آماده)
    زمینه := اس اس ال.زمینه جدید سرور("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    تکرار 3:
        c := تی سی پی.پذیرش(کارگزار)
        اتصال := اس اس ال.پوشاندن(زمینه، c.توصیفگر)
        اگر اس اس ال.پذیرش(اتصال):
            پیام := اس اس ال.خواندن(اتصال، 1024)
            اس اس ال.نوشتن(اتصال، "echo:" + پیام)
        پایان
        اس اس ال.بستن(اتصال)
        تی سی پی.بستن(c)
    پایان
    اس اس ال.بستن زمینه(زمینه)
    تی سی پی.بستن سرور(کارگزار)
پایان

تابع اتصال آزمایشی(برچسب: رشته، کمینه نسخه: صحیح۶۴، پرونده اعتماد: منطقی، مسیرهای پیش‌فرض: منطقی، حالت تایید: صحیح):
    زمینه := اس اس ال.زمینه جدید مشتری()
    سرچاپ برچسب
    سرچاپ اس اس ال.تنظیم کمینه نسخه(زمینه، کمینه نسخه)
    اگر پرونده اعتماد:
        اس اس ال.بارگذاری مکان تایید(زمینه، "tests/fixtures/ssl/server.crt")
    پایان
    اگر مسیرهای پیش‌فرض:
        سرچاپ اس اس ال.تنظیم مسیرهای پیش‌فرض تایید(زمینه)
    پایان
    اس اس ال.تنظیم تایید(زمینه، حالت تایید)
    c := تی سی پی.شماره گیری("127.0.0.1"، 19306)
    اتصال := اس اس ال.پوشاندن(زمینه، c.توصیفگر)
    اس اس ال.تنظیم نام میزبان(اتصال، "127.0.0.1")
    موفق := اس اس ال.اتصال برقرار کردن(اتصال)
    سرچاپ موفق
    سرچاپ اس اس ال.نتیجه تایید(اتصال) برابر اس اس ال.گواهی معتبر
    اگر موفق:
        اس اس ال.نوشتن(اتصال، برچسب)
        سرچاپ "  " + اس اس ال.خواندن(اتصال، 1024)
    وگرنه:
        سرچاپ "  err: " + اس اس ال.متن خطای اتصال(اتصال)
    پایان
    اس اس ال.بستن(اتصال)
    تی سی پی.بستن(c)
    اس اس ال.بستن زمینه(زمینه)
پایان

تابع آفلاین():
    زمینه := اس اس ال.زمینه جدید مشتری()
    سرچاپ اس اس ال.تنظیم کمینه نسخه(زمینه، اس اس ال.تی ال اس۱۲)
    سرچاپ اس اس ال.تنظیم کمینه نسخه(زمینه، اس اس ال.تی ال اس۱۳)
    سرچاپ اس اس ال.تنظیم کمینه نسخه(زمینه، اس اس ال.تی ال اس۱۳ + 1)
    سرچاپ اس اس ال.تنظیم کمینه نسخه(زمینه، 0 - 1)
    سرچاپ اس اس ال.تنظیم مسیرهای پیش‌فرض تایید(زمینه)
    اس اس ال.بستن زمینه(زمینه)
    هیچ := اس اس ال.پوشاندن(اس اس ال.زمینه { دسته = پوچ }، 0 - 1)
    سرچاپ اس اس ال.نتیجه تایید(هیچ)
    سرچاپ اس اس ال.طرف مقابل تاییدشده(هیچ)
    سرچاپ اس اس ال.تنظیم کمینه نسخه(اس اس ال.زمینه { دسته = پوچ }، اس اس ال.تی ال اس۱۲)
    سرچاپ اس اس ال.تنظیم مسیرهای پیش‌فرض تایید(اس اس ال.زمینه { دسته = پوچ })
    سرچاپ اس اس ال.آخرین متن خطا() برابر ""
    نامعتبر := اس اس ال.زمینه جدید سرور("tests/fixtures/ssl/missing.crt"، "tests/fixtures/ssl/missing.key")
    سرچاپ اس اس ال.زمینه معتبر(نامعتبر)
    سرچاپ اس اس ال.آخرین متن خطا()
    سرچاپ اس اس ال.آخرین متن خطا() برابر ""
پایان

تابع ریشه:
    آفلاین()
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(خدمت)
    همگام سازی.انتظار(آماده)
    اتصال آزمایشی("pinned"، اس اس ال.تی ال اس۱۳، درست، نادرست، اس اس ال.تایید طرف مقابل)
    اتصال آزمایشی("skipped"، اس اس ال.تی ال اس۱۲، نادرست، نادرست، اس اس ال.بدون تایید)
    اتصال آزمایشی("systemroots"، اس اس ال.تی ال اس۱۲، درست، درست، اس اس ال.تایید طرف مقابل)
    نخ‌پیوند(t)
پایان
