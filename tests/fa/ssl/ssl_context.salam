بسته ریشه

واردسازی اس اس ال
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع serve():
    srv := تی سی پی.پیوند(19306)
    همگام سازی.اتمام(ready)
    ctx := اس اس ال.زمینه جدید سرور("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    تکرار 3:
        c := تی سی پی.پذیرش(srv)
        conn := اس اس ال.پوشاندن(ctx، c.توصیفگر)
        اگر اس اس ال.پذیرش(conn):
            msg := اس اس ال.خواندن(conn، 1024)
            اس اس ال.نوشتن(conn، "echo:" + msg)
        پایان
        اس اس ال.بستن(conn)
        تی سی پی.بستن(c)
    پایان
    اس اس ال.بستن زمینه(ctx)
    تی سی پی.بستن سرور(srv)
پایان

تابع attempt(label: رشته، min_version: صحیح۶۴، trust_file: منطقی، default_paths: منطقی، verify: صحیح):
    ctx := اس اس ال.زمینه جدید مشتری()
    سرچاپ label
    سرچاپ اس اس ال.تنظیم کمینه نسخه(ctx، min_version)
    اگر trust_file:
        اس اس ال.بارگذاری مکان تایید(ctx، "tests/fixtures/ssl/server.crt")
    پایان
    اگر default_paths:
        سرچاپ اس اس ال.تنظیم مسیرهای پیش‌فرض تایید(ctx)
    پایان
    اس اس ال.تنظیم تایید(ctx، verify)
    c := تی سی پی.شماره گیری("127.0.0.1"، 19306)
    conn := اس اس ال.پوشاندن(ctx، c.توصیفگر)
    اس اس ال.تنظیم نام میزبان(conn، "127.0.0.1")
    ok := اس اس ال.اتصال برقرار کردن(conn)
    سرچاپ ok
    سرچاپ اس اس ال.نتیجه تایید(conn) برابر اس اس ال.گواهی معتبر
    اگر ok:
        اس اس ال.نوشتن(conn، label)
        سرچاپ "  " + اس اس ال.خواندن(conn، 1024)
    وگرنه:
        سرچاپ "  err: " + اس اس ال.متن خطای اتصال(conn)
    پایان
    اس اس ال.بستن(conn)
    تی سی پی.بستن(c)
    اس اس ال.بستن زمینه(ctx)
پایان

تابع offline():
    ctx := اس اس ال.زمینه جدید مشتری()
    سرچاپ اس اس ال.تنظیم کمینه نسخه(ctx، اس اس ال.تی ال اس۱۲)
    سرچاپ اس اس ال.تنظیم کمینه نسخه(ctx، اس اس ال.تی ال اس۱۳)
    سرچاپ اس اس ال.تنظیم کمینه نسخه(ctx، اس اس ال.تی ال اس۱۳ + 1)
    سرچاپ اس اس ال.تنظیم کمینه نسخه(ctx، 0 - 1)
    سرچاپ اس اس ال.تنظیم مسیرهای پیش‌فرض تایید(ctx)
    اس اس ال.بستن زمینه(ctx)
    none := اس اس ال.پوشاندن(اس اس ال.زمینه { دسته = پوچ }، 0 - 1)
    سرچاپ اس اس ال.نتیجه تایید(none)
    سرچاپ اس اس ال.طرف مقابل تاییدشده(none)
    سرچاپ اس اس ال.تنظیم کمینه نسخه(اس اس ال.زمینه { دسته = پوچ }، اس اس ال.تی ال اس۱۲)
    سرچاپ اس اس ال.تنظیم مسیرهای پیش‌فرض تایید(اس اس ال.زمینه { دسته = پوچ })
    سرچاپ اس اس ال.آخرین متن خطا() برابر ""
    bad := اس اس ال.زمینه جدید سرور("tests/fixtures/ssl/missing.crt"، "tests/fixtures/ssl/missing.key")
    سرچاپ اس اس ال.زمینه معتبر(bad)
    سرچاپ اس اس ال.آخرین متن خطا()
    سرچاپ اس اس ال.آخرین متن خطا() برابر ""
پایان

تابع ریشه:
    offline()
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve)
    همگام سازی.انتظار(ready)
    attempt("pinned"، اس اس ال.تی ال اس۱۳، درست، نادرست، اس اس ال.تایید طرف مقابل)
    attempt("skipped"، اس اس ال.تی ال اس۱۲، نادرست، نادرست، اس اس ال.بدون تایید)
    attempt("systemroots"، اس اس ال.تی ال اس۱۲، درست، درست، اس اس ال.تایید طرف مقابل)
    نخ‌پیوند(t)
پایان
