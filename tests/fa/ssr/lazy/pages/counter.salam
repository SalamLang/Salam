همگانی بخش شمارنده:
    عنوان = "شمارنده"
    ناپایا تعداد := 0
    سرتیتر: محتوا = "سرتیتر شمارنده" پایان
    پاراگراف: محتوا = "واژه‌های شمارنده" پایان
    دکمه:
        شناسه = "add"
        محتوا = "افزودن " + تعداد
        کلیک = (): تعداد++ پایان
    پایان
پایان
