همگانی بخش پرش:
    عنوان = "پرش"
    پاراگراف: محتوا = "واژه‌های پرش" پایان
    دکمه:
        شناسه = "go-about"
        محتوا = "برو"
        کلیک = (): صفحه.مسیر.برو("/about") پایان
    پایان
پایان
