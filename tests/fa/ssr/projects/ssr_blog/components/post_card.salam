همگانی بخش کارت نوشته(کوتاه: رشته، تیتر: رشته، روز: رشته، موضوع: رشته):
    پیوند:
        مقصد = "/post/" + کوتاه
        چیدمان = "ستون"
        شکاف = 4
        فاصله = 16، 0
        کادر پایین = 1، "توپر"، "#e3dccb"
        رنگ = "#2a2620"
        تزیین متن = "هیچ"
        سرتیتر:
            اندازه = 2
            محتوا = تیتر
        پایان
        ریز:
            شفافیت = 0.65
            محتوا = روز + " در " + موضوع
        پایان
    پایان
پایان
