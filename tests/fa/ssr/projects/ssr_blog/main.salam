واردسازی محیط
واردسازی شبکه.اچ تی تی پی
واردسازی کدگذاری.جیسون

ساختار نوشته:
    همگانی کوتاه: رشته = ""
    همگانی تیتر نوشته: رشته = ""
    همگانی موضوع: رشته = ""
    همگانی روز: رشته = ""
    همگانی شرح: رشته = ""
پایان

ساختار فهرست:
    همگانی نوشته‌ها: وکتور<نوشته> = وکتور {} برگردان وکتور<نوشته>
پایان

سرور تابع بیاورفهرست(موضوع: رشته): وکتور<نوشته>:
    ر := اچ تی تی پی.دریافت(محیط.دریافت("BLOG_API") + "/posts?tag=" + موضوع)
    ناپایا فید := فهرست {}
    تلاش:
        جیسون.واسریال سازی(ر.بدنه، فید)
    گرفتن خطا ی:
        سرچاپ "فید خراب:"، ی.پیام
    پایان
    برگشت فید.پوستس
پایان

سرور تابع بگیرنوشته(کوتاه: رشته): نوشته:
    ر := اچ تی تی پی.دریافت(محیط.دریافت("BLOG_API") + "/posts/" + کوتاه)
    ناپایا پ := نوشته {}
    تلاش:
        جیسون.واسریال سازی(ر.بدنه، پ)
    گرفتن خطا ی:
        سرچاپ "نوشته خراب:"، ی.پیام
    پایان
    برگشت پ
پایان

صفحه:
    عنوان = "دفتر یادداشت"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = #fbf8f1
        رنگ = #2a2620
        سرصفحه:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 22
            فاصله = 18، 32
            کادر پایین = 1، توپر، #e3dccb
            پیوند:
                مقصد = "/"
                اندازه قلم = 24
                وزن قلم = 700
                رنگ = #2a2620
                تزیین متن = هیچ
                محتوا = "دفتر یادداشت"
            پایان
            ناوبری:
                چیدمان = ردیف
                شکاف = 16
                پیوند:
                    مقصد = "/"
                    رنگ = #6b5c3a
                    محتوا = "نوشته‌ها"
                پایان
                پیوند:
                    مقصد = "/tag/travel"
                    رنگ = #6b5c3a
                    محتوا = "سفر"
                پایان
                پیوند:
                    مقصد = "/tag/code"
                    رنگ = #6b5c3a
                    محتوا = "برنامه‌نویسی"
                پایان
                پیوند:
                    مقصد = "/about"
                    رنگ = #6b5c3a
                    محتوا = "درباره"
                پایان
            پایان
        پایان
        اصلی:
            بیشینه عرض = 680
            فضا = 0، خودکار
            فاصله = 32
            نمای مسیر: پایان
        پایان
        پاورقی:
            فاصله = 24، 32
            ترازمتن = وسط
            شفافیت = 0.6
            محتوا = "روی سرور ساخته می‌شود و در مرورگر زنده می‌شود."
        پایان
    پایان
پایان
