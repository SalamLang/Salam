همگانی بخش درباره بلاگ:
    عنوان = "درباره"
    پیش ساخت = ["/about"]
    جعبه:
        شکاف = 10
        سرتیتر:
            اندازه = 1
            محتوا = "درباره این بلاگ"
        پایان
        پاراگراف:
            محتوا = "دفتر یادداشت یک بلاگ کوچک است که با سلام نوشته شده. سرور هر نشانی را با صفحه آماده پاسخ می‌دهد و بعد از بارگیری اسکریپت، مرورگر کار را در دست می‌گیرد."
        پایان
    پایان
پایان
