همگانی بخش خانه:
    عنوان = "دفتر یادداشت"
    نوشته‌ها := فهرست‌نوشته‌ها("")
    جعبه:
        شکاف = 6
        سرتیتر:
            اندازه = 1
            محتوا = "تازه‌ترین نوشته‌ها"
        پایان
        اگر نوشته‌ها.طول() برابر 0:
            پاراگراف:
                محتوا = "هنوز نوشته‌ای نیست."
            پایان
        پایان
        هر پ در نوشته‌ها:
            کارت نوشته:
                کوتاه = پ.کوتاه
                تیتر = پ.تیتر نوشته
                روز = پ.روز
                موضوع = پ.موضوع
            پایان
        پایان
    پایان
پایان
