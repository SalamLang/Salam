همگانی بخش صفحه‌نوشته(کوتاه: رشته):
    مسیر = "/post/:کوتاه"
    نوشته من := بگیرنوشته(کوتاه)
    پسندها := 0
    عنوان = "نوشته " + کوتاه
    جعبه:
        شکاف = 12
        اگر نوشته من.تیتر نوشته برابر "":
            سرتیتر:
                اندازه = 1
                محتوا = "این نوشته وجود ندارد"
            پایان
            پیوند:
                مقصد = "/"
                محتوا = "بازگشت به همه نوشته‌ها"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = نوشته من.تیتر نوشته
            پایان
            ریز:
                شفافیت = 0.65
                محتوا = نوشته من.روز + " در " + نوشته من.موضوع
            پایان
            پاراگراف:
                ارتفاع خط = 1.8
                محتوا = نوشته من.شرح
            پایان
            دکمه:
                شناسه = "like"
                خود تراز = ابتدا
                فاصله = 8، 16
                گردی = 20
                کادر = 1، توپر، #c9b98f
                پس زمینه = #fff7e0
                کلیک = (): پسندها++ پایان
                محتوا = "پسندیدم " + پسندها
            پایان
        پایان
    پایان
پایان
