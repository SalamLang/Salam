همگانی بخش صفحه‌موضوع(گروه: رشته):
    مسیر = "/tag/:گروه"
    عنوان = "موضوع " + گروه
    نوشته‌ها := بیاورفهرست(گروه)
    جعبه:
        شکاف = 6
        سرتیتر:
            اندازه = 1
            محتوا = "نوشته‌های " + گروه
        پایان
        هر پ در نوشته‌ها:
            کارت نوشته:
                کوتاه = پ.کوتاه
                تیتر = پ.تیتر نوشته
                روز = پ.روز
                موضوع = پ.موضوع
            پایان
        پایان
    پایان
پایان
