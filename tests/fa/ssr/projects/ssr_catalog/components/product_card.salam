همگانی بخش کارت کالا(شماره کالا: صحیح، کالای من: رشته، بها: صحیح، موجودی: صحیح):
    پیوند:
        مقصد = "/product/" + شماره کالا
        چیدمان = ستون
        شکاف = 6
        فاصله = 16
        گردی = 14
        پس زمینه = #ffffff
        رنگ = #1c2b26
        تزیین متن = هیچ
        کادر = 1، توپر، #dce6e1
        اشاره:
            سایه = 0، 6، 18، #12372a22
        پایان
        قوی:
            محتوا = کالای من
        پایان
        تکه:
            محتوا = "$" + بها
        پایان
        اگر موجودی بزرگتر 0:
            ریز:
                رنگ = #1c6b45
                محتوا = موجودی + " عدد موجود"
            پایان
        وگرنه:
            ریز:
                رنگ = #5b6b64
                محتوا = "تمام شد"
            پایان
        پایان
    پایان
پایان
