واردسازی محیط
واردسازی رشته
واردسازی شبکه.اچ تی تی پی
واردسازی کدگذاری.جیسون

ناپایا سبد := وکتور {} برگردان وکتور<صحیح>
ساختار کالا:
    همگانی شماره: صحیح = 0
    همگانی نام: رشته = ""
    همگانی دسته: رشته = ""
    همگانی بها: صحیح = 0
    همگانی موجودی: صحیح = 0
    همگانی توضیح: رشته = ""
پایان

ساختار سیاهه:
    همگانی اقلام: وکتور<کالا> = وکتور {} برگردان وکتور<کالا>
پایان

ساختار رسید:
    همگانی موفق: منطقی = نادرست
    همگانی باقی: صحیح = 0
پایان


سرور تابع بیاورکالاها(دسته: رشته): وکتور<کالا>:
    ر := اچ تی تی پی.دریافت(محیط.دریافت("SHOP_API") + "/products?category=" + دسته)
    ناپایا سیاهه من := سیاهه {}
    تلاش:
        جیسون.واسریال سازی(ر.بدنه، سیاهه من)
    گرفتن خطا ی:
        سرچاپ "سیاهه خراب:"، ی.پیام
    پایان
    برگشت سیاهه من.اقلام
پایان

سرور تابع بگیرکالا(شماره: صحیح): کالا:
    ر := اچ تی تی پی.دریافت(محیط.دریافت("SHOP_API") + "/products/" + رشته.از عدد(شماره برگردان صحیح۶۴))
    ناپایا ک := کالا {}
    تلاش:
        جیسون.واسریال سازی(ر.بدنه، ک)
    گرفتن خطا ی:
        سرچاپ "کالای خراب:"، ی.پیام
    پایان
    برگشت ک
پایان

سرور تابع رزرو(شماره: صحیح، تعداد: صحیح): رسید:
    ناپایا سرآیندها := اچ تی تی پی.سرصفحه جدید()
    سرآیندها.درج("Authorization"، "Bearer " + محیط.دریافت("SHOP_TOKEN"))
    متن درخواست := "{\"id\":" + رشته.از عدد(شماره برگردان صحیح۶۴) + ",\"qty\":" + رشته.از عدد(تعداد برگردان صحیح۶۴) + "}"
    ر := اچ تی تی پی.ارسال با(محیط.دریافت("SHOP_API") + "/reserve"، متن درخواست، سرآیندها)
    ناپایا خروجی := رسید {}
    تلاش:
        جیسون.واسریال سازی(ر.بدنه، خروجی)
    گرفتن خطا ی:
        سرچاپ "رسید خراب:"، ی.پیام
    پایان
    برگشت خروجی
پایان

تابع افزودن به سبد(شماره: صحیح):
    سبد.افزودن(شماره)
پایان

صفحه:
    عنوان = "بقالی سر کوچه"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, system-ui, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = #f5f7f6
        رنگ = #1c2b26
        سرصفحه:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 20
            فاصله = 14، 28
            پس زمینه = #12372a
            پیوند:
                مقصد = "/"
                رنگ = #ffffff
                اندازه قلم = 22
                وزن قلم = 800
                تزیین متن = هیچ
                محتوا = "بقالی سر کوچه"
            پایان
            ناوبری:
                چیدمان = ردیف
                شکاف = 14
                رشد = 1
                پیوند:
                    مقصد = "/?cat=fruit"
                    رنگ = #cfe8dc
                    محتوا = "میوه"
                پایان
                پیوند:
                    مقصد = "/?cat=bakery"
                    رنگ = #cfe8dc
                    محتوا = "نانوایی"
                پایان
                پیوند:
                    مقصد = "/?cat=drinks"
                    رنگ = #cfe8dc
                    محتوا = "نوشیدنی"
                پایان
            پایان
            پیوند:
                مقصد = "/basket"
                رنگ = #ffffff
                محتوا = "سبد (" + سبد.طول() + ")"
            پایان
        پایان
        اصلی:
            بیشینه عرض = 920
            فضا = 0، خودکار
            فاصله = 28
            نمای مسیر: پایان
        پایان
    پایان
پایان
