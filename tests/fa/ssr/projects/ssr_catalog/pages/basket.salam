همگانی بخش سبد خرید:
    عنوان = "سبد"
    جعبه:
        شکاف = 10
        سرتیتر:
            اندازه = 1
            محتوا = "سبد شما"
        پایان
        اگر سبد.طول() برابر 0:
            پاراگراف:
                محتوا = "هنوز چیزی رزرو نشده."
            پایان
        پایان
        فهرست:
            هر شماره در سبد:
                مورد:
                    پیوند:
                        مقصد = "/product/" + شماره
                        محتوا = "کالای " + شماره
                    پایان
                پایان
            پایان
        پایان
        دکمه:
            شناسه = "empty"
            خود تراز = ابتدا
            فاصله = 8، 16
            گردی = 10
            کلیک = (): سبد = وکتور {} برگردان وکتور<صحیح> پایان
            محتوا = "خالی کردن سبد"
        پایان
    پایان
پایان
