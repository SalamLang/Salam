همگانی بخش خانه:
    عنوان = "بقالی سر کوچه"
    اقلام := بیاورکالاها(صفحه.مسیر.مقدار پرسمان("cat"))
    جعبه:
        شکاف = 14
        سرتیتر:
            اندازه = 1
            محتوا = (صفحه.مسیر.مقدار پرسمان("cat") برابر "" ? "همه کالاها" : "دسته: " + صفحه.مسیر.مقدار پرسمان("cat"))
        پایان
        اگر اقلام.طول() برابر 0:
            پاراگراف:
                محتوا = "در این دسته چیزی نیست."
            پایان
        پایان
        جعبه:
            چیدمان = "شبکه"
            چندستونی = "repeat(fill, minmax(200, 1fr))"
            شکاف = 14
            هر _، ک در اقلام:
                کارت کالا:
                    شماره کالا = ک.شماره
                    کالای من = ک.نام
                    بها = ک.بها
                    موجودی = ک.موجودی
                پایان
            پایان
        پایان
    پایان
پایان
