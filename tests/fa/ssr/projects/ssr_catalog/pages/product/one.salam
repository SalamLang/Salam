همگانی بخش صفحه‌کالا(شماره: صحیح):
    مسیر = "/product/:شماره"
    عنوان = "کالای " + شماره
    ک := بگیرکالا(شماره)
    یادداشت := ""
    جعبه:
        شکاف = 12
        اگر ک.نام برابر "":
            سرتیتر:
                اندازه = 1
                محتوا = "چنین کالایی نیست"
            پایان
            پیوند:
                مقصد = "/"
                محتوا = "بازگشت به فروشگاه"
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 1
                محتوا = ک.نام
            پایان
            پاراگراف:
                محتوا = ک.توضیح
            پایان
            قوی:
                محتوا = "$" + ک.بها
            پایان
            دکمه:
                شناسه = "reserve"
                خود تراز = ابتدا
                فاصله = 10، 20
                گردی = 10
                کادر = 0
                پس زمینه = #12372a
                رنگ = #ffffff
                غیرفعال = (ک.موجودی برابر 0)
                کلیک = ():
                    پاسخ := رزرو(ک.شماره، 1)
                    اگر پاسخ.موفق:
                        افزودن به سبد(ک.شماره)
                        یادداشت = "رزرو شد، " + پاسخ.باقی + " عدد مانده"
                    وگرنه:
                        یادداشت = "رزرو نشد"
                    پایان
                پایان
                محتوا = "یکی رزرو کن"
            پایان
            پاراگراف:
                شناسه = "note"
                محتوا = یادداشت
            پایان
        پایان
    پایان
پایان
