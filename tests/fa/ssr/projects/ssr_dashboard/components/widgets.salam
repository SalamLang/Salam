همگانی بخش کارت آمار(نام آمار: رشته، رقم: رشته):
    جعبه:
        شکاف = 4
        فاصله = 16
        گردی = 14
        پس زمینه = "#ffffff"
        ریز:
            شفافیت = 0.65
            محتوا = نام آمار
        پایان
        قوی:
            اندازه قلم = 26
            محتوا = رقم
        پایان
    پایان
پایان

همگانی بخش میله(روز: رشته، مقدار: صحیح):
    جعبه:
        چیدمان = "ردیف"
        تراز = "وسط"
        شکاف = 10
        ریز:
            عرض = 40
            محتوا = روز
        پایان
        پیشرفت:
            رشد = 1
            مقدار = مقدار
            بیشینه = 20
        پایان
        ریز:
            عرض = 24
            محتوا = مقدار
        پایان
    پایان
پایان

همگانی بخش برچسب وضعیت(مرحله: رشته):
    اگر مرحله برابر "shipped":
        تکه:
            فاصله = 2، 10
            گردی = 20
            اندازه قلم = 13
            پس زمینه = "#d7f5e3"
            رنگ = "#14532d"
            محتوا = مرحله
        پایان
    وگرنه:
        تکه:
            فاصله = 2، 10
            گردی = 20
            اندازه قلم = 13
            پس زمینه = "#fff3cd"
            رنگ = "#6b5200"
            محتوا = مرحله
        پایان
    پایان
پایان
