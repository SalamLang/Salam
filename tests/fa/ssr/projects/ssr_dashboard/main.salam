واردسازی محیط
واردسازی رشته
واردسازی شبکه.اچ تی تی پی
واردسازی کدگذاری.جیسون

ساختار تایید:
    همگانی موفق: منطقی = نادرست
پایان

ساختار نقطه:
    همگانی روز: رشته = ""
    همگانی مقدار: صحیح = 0
پایان

ساختار گزارش:
    همگانی سفارش‌ها: صحیح = 0
    همگانی درآمد: صحیح = 0
    همگانی بازدید: صحیح = 0
پایان

ساختار سری:
    همگانی نقطه‌ها: وکتور<نقطه> = وکتور {} برگردان وکتور<نقطه>
پایان

ساختار سفارش:
    همگانی شماره: صحیح = 0
    همگانی مشتری: رشته = ""
    همگانی مبلغ: صحیح = 0
    همگانی وضعیت: رشته = ""
پایان

ساختار سیاهه:
    همگانی ردیف‌ها: وکتور<سفارش> = وکتور {} برگردان وکتور<سفارش>
پایان


تابع سرآیند میزبان(): نگاشت<رشته، رشته>:
    ناپایا سرآیند := اچ تی تی پی.سرصفحه جدید()
    سرآیند.درج("Authorization"، "Bearer " + محیط.دریافت("DESK_TOKEN"))
    برگشت سرآیند
پایان

سرور تابع بگیرگزارش(): گزارش:
    پاسخ := اچ تی تی پی.دریافت با(محیط.دریافت("DESK_API") + "/overview"، سرآیند میزبان())
    ناپایا ج := گزارش {}
    تلاش:
        جیسون.واسریال سازی(پاسخ.بدنه، ج)
    گرفتن خطا ی:
        سرچاپ "گزارش خراب:"، ی.پیام
    پایان
    برگشت ج
پایان

سرور تابع بیاورهفته(): وکتور<نقطه>:
    پاسخ := اچ تی تی پی.دریافت با(محیط.دریافت("DESK_API") + "/weekly"، سرآیند میزبان())
    ناپایا ش := سری {}
    تلاش:
        جیسون.واسریال سازی(پاسخ.بدنه، ش)
    گرفتن خطا ی:
        سرچاپ "رشته خراب:"، ی.پیام
    پایان
    برگشت ش.نقطه‌ها
پایان

سرور تابع بیاورسفارشها(مرحله: رشته): وکتور<سفارش>:
    پاسخ := اچ تی تی پی.دریافت با(محیط.دریافت("DESK_API") + "/orders?status=" + مرحله، سرآیند میزبان())
    ناپایا فهرست من := سیاهه {}
    تلاش:
        جیسون.واسریال سازی(پاسخ.بدنه، فهرست من)
    گرفتن خطا ی:
        سرچاپ "سفارش‌های خراب:"، ی.پیام
    پایان
    برگشت فهرست من.ردیف‌ها
پایان

سرور تابع بگیرسفارش(کد: صحیح): سفارش:
    پاسخ := اچ تی تی پی.دریافت با(محیط.دریافت("DESK_API") + "/orders/" + رشته.از عدد(کد برگردان صحیح۶۴)، سرآیند میزبان())
    ناپایا س := سفارش {}
    تلاش:
        جیسون.واسریال سازی(پاسخ.بدنه، س)
    گرفتن خطا ی:
        سرچاپ "سفارش خراب:"، ی.پیام
    پایان
    برگشت س
پایان

سرور تابع ارسالکن(کد: صحیح): تایید:
    پاسخ := اچ تی تی پی.ارسال با(محیط.دریافت("DESK_API") + "/orders/" + رشته.از عدد(کد برگردان صحیح۶۴) + "/ship"، ""، سرآیند میزبان())
    ناپایا آ := تایید {}
    آ.موفق = پاسخ.وضعیت برابر 200
    برگشت آ
پایان

صفحه:
    عنوان = "میز سفارش"
    زبان = "fa"
    خانواده قلم = "Vazirmatn, system-ui, sans-serif"
    جعبه:
        کمینه ارتفاع = 100vh
        پس زمینه = #eef1f6
        رنگ = #1b2236
        سرصفحه:
            چیدمان = ردیف
            تراز = وسط
            شکاف = 18
            فاصله = 14، 28
            پس زمینه = #1b2236
            پیوند:
                مقصد = "/"
                رنگ = #ffffff
                اندازه قلم = 20
                وزن قلم = 800
                تزیین متن = هیچ
                محتوا = "میز سفارش"
            پایان
            پیوند:
                مقصد = "/desk"
                رنگ = #c9d2ee
                محتوا = "نمای کلی"
            پایان
            پیوند:
                مقصد = "/desk/orders"
                رنگ = #c9d2ee
                محتوا = "سفارش‌ها"
            پایان
        پایان
        اصلی:
            بیشینه عرض = 940
            فضا = 0، خودکار
            فاصله = 28
            نمای مسیر: پایان
        پایان
    پایان
پایان
