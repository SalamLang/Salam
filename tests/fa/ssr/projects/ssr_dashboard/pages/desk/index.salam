// زبان: فارسی
/*
 * Salam Programming Language (2018-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */
همگانی بخش نمای کلی:
    عنوان = "نمای کلی"
    ج := بگیرگزارش()
    جعبه:
        شکاف = 16
        سرتیتر:
            اندازه = 1
            محتوا = "نمای کلی"
        پایان
        جعبه:
            چیدمان = شبکه
            چندستونی = "repeat(fill, minmax(180, 1fr))"
            شکاف = 12
            کارت آمار:
                نام آمار = "سفارش‌ها"
                رقم = "" + ج.سفارش‌ها
            پایان
            کارت آمار:
                نام آمار = "درآمد"
                رقم = "$" + ج.درآمد
            پایان
            کارت آمار:
                نام آمار = "بازدیدکنندگان"
                رقم = "" + ج.بازدید
            پایان
        پایان
        جعبه:
            فاصله = 16
            گردی = 14
            پس زمینه = #ffffff
            سرتیتر:
                اندازه = 3
                محتوا = "سفارش‌های این هفته"
            پایان
            جعبه:
                چیدمان = ردیف
                شکاف = 14
                چینش = پیرامون
                هر نق در ج.هفته:
                    میله:
                        روز = نق.روز
                        مقدار = نق.مقدار
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
