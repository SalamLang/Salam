همگانی بخش صفحه‌سفارش‌ها:
    عنوان = "سفارش‌ها"
    ردیف‌های سفارش := بیاورسفارشها(صفحه.مسیر.مقدار پرسمان("status"))
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = "سفارش‌ها"
        پایان
        جعبه:
            چیدمان = "ردیف"
            شکاف = 10
            پیوند:
                مقصد = "/desk/orders"
                محتوا = "همه"
            پایان
            پیوند:
                مقصد = "/desk/orders?status=pending"
                محتوا = "در انتظار"
            پایان
            پیوند:
                مقصد = "/desk/orders?status=shipped"
                محتوا = "ارسال‌شده"
            پایان
        پایان
        جدول:
            سرصفحه:
                ردیف:
                    ستون:
                        محتوا = "سفارش"
                    پایان
                    ستون:
                        محتوا = "مشتری"
                    پایان
                    ستون:
                        محتوا = "مبلغ"
                    پایان
                    ستون:
                        محتوا = "وضعیت"
                    پایان
                پایان
            پایان
            اصلی:
                هر شماره، س در ردیف‌های سفارش:
                    ردیف:
                        کلید = شماره
                        ستون:
                            پیوند:
                                مقصد = "/order/" + س.شماره
                                محتوا = "#" + س.شماره
                            پایان
                        پایان
                        ستون:
                            محتوا = س.مشتری
                        پایان
                        ستون:
                            محتوا = "$" + س.مبلغ
                        پایان
                        ستون:
                            برچسب وضعیت:
                                مرحله = س.وضعیت
                            پایان
                        پایان
                    پایان
                پایان
            پایان
        پایان
    پایان
پایان
