همگانی بخش صفحه‌سفارش(کد: صحیح):
    مسیر = "/order/:کد"
    عنوان = "سفارش"
    س := بگیرسفارش(کد)
    پیام := ""
    جعبه:
        شکاف = 12
        سرتیتر:
            اندازه = 1
            محتوا = "سفارش شماره " + کد
        پایان
        اگر س.شماره برابر 0:
            پاراگراف:
                محتوا = "این سفارش وجود ندارد."
            پایان
        وگرنه:
            پاراگراف:
                محتوا = س.مشتری
            پایان
            برچسب وضعیت:
                مرحله = س.وضعیت
            پایان
            دکمه:
                شناسه = "ship-btn"
                خود تراز = ابتدا
                فاصله = 10، 18
                گردی = 10
                غیرفعال = (س.وضعیت برابر "shipped")
                کلیک = ():
                    پاسخ ارسال := ثبت‌ارسال(س.شماره)
                    اگر پاسخ ارسال.موفق:
                        پیام = "ارسال‌شده ثبت شد"
                    وگرنه:
                        پیام = "فروشگاه نپذیرفت"
                    پایان
                پایان
                محتوا = "ثبت به عنوان ارسال‌شده"
            پایان
            پاراگراف:
                شناسه = "msg"
                محتوا = پیام
            پایان
        پایان
        پیوند:
            مقصد = "/desk/orders"
            محتوا = "همه سفارش‌ها"
        پایان
    پایان
پایان
