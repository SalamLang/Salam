همگانی بخش شمارنده:
    عنوان = "شمارنده"
    n := 0
    سرتیتر:
        محتوا = "شمارنده"
    پایان
    دکمه:
        شناسه = "inc"
        کلیک = (): n++ پایان
        محتوا = "افزودن"
    پایان
    پاراگراف:
        شناسه = "count"
        محتوا = "تعداد " + n
    پایان
پایان
