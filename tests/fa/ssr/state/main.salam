واردسازی رشته

ناپایا شمارش := 0

ساختار جزئیات:
    همگانی برچسب متن: رشته = ""
    همگانی اندازه: صحیح = 0
پایان

@en "Next"
سرور تابع بعدی(): صحیح:
    شمارش++
    سرچاپ "Next ran"
    برگشت شمارش
پایان

@en "Other"
سرور تابع دیگر(آغاز: صحیح): صحیح:
    سرچاپ "Other ran"
    برگشت آغاز + 40
پایان

@en "Names"
سرور تابع نام‌ها(): وکتور<رشته>:
    سرچاپ "Names ran"
    ناپایا فهرست := وکتور {} برگردان وکتور<رشته>
    فهرست.درج("one")
    فهرست.درج("two")
    برگشت فهرست
پایان

@en "Details"
سرور تابع شرح(): جزئیات:
    سرچاپ "Details ran"
    برگشت جزئیات { برچسب متن = رشته.بزرگ("box")، اندازه = 3 }
پایان

صفحه:
    عنوان = "وضعیت"
    ناوبری:
        پیوند:
            شناسه = "to-home"
            مقصد = "/"
            محتوا = "خانه"
        پایان
        پیوند:
            شناسه = "to-other"
            مقصد = "/other"
            محتوا = "دیگر"
        پایان
    پایان
    نمای مسیر: پایان
پایان
