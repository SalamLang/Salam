همگانی بخش خانه:
    مقدار تازه := بعدی() برگردان صحیح
    جعبه:
        پاراگراف:
            شناسه = "value"
            محتوا = "مقدار " + مقدار تازه
        پایان
        دکمه:
            شناسه = "reload"
            کلیک = (): مقدار تازه = بعدی() پایان
            محتوا = "تازه"
        پایان
    پایان
پایان
