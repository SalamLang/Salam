بخش شمارش‌گر(آغاز: صحیح):
    عدد := دیگر(آغاز) برگردان صحیح
    دکمه:
        شناسه = "again"
        کلیک = (): عدد = دیگر(عدد) پایان
        محتوا = "دوباره " + عدد
    پایان
پایان

همگانی بخش صفحه‌دیگر:
    نام‌های فهرست := نام‌ها() برگردان وکتور<رشته>
    مشخصات := شرح() برگردان جزئیات
    پایه عدد := 2
    جعبه:
        پاراگراف:
            شناسه = "info"
            محتوا = مشخصات.برچسب متن + " " + مشخصات.اندازه + " " + نام‌های فهرست.طول()
        پایان
        دکمه:
            شناسه = "add"
            کلیک = (): نام‌های فهرست.افزودن("three") مشخصات.اندازه++ پایان
            محتوا = "افزودن"
        پایان
        شمارش‌گر:
            آغاز = پایه عدد
        پایان
    پایان
پایان
