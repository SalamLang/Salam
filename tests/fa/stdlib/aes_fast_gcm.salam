بسته ریشه

واردسازی تی ال اس
واردسازی حافظه
واردسازی رشته
واردسازی رمزنگاری

ناپایا failures := 0

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures += 1
    پایان
پایان

تابع hexof(p: تهی*، n: صحیح): رشته:
    b := p برگردان طبیعی۸*
    d := "0123456789abcdef"
    ناپایا s := ""
    تکرار n در i:
        v := b[i] برگردان صحیح
        s += d.زیررشته(v >> 4، 1)
        s += d.زیررشته(v & 15، 1)
    پایان
    برگشت s
پایان

تابع unhex(h: رشته): تهی*:
    n := رشته.طول(h) / 2
    p := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    b := p برگردان طبیعی۸*
    d := "0123456789abcdef"
    تکرار n در i:
        b[i] = ((رشته.اندیس(d، h.زیررشته(i * 2، 1)) << 4) | رشته.اندیس(d، h.زیررشته(i * 2 + 1، 1))) برگردان طبیعی۸
    پایان
    برگشت p
پایان

تابع same(a: تهی*، b: تهی*، n: صحیح): منطقی:
    x := a برگردان طبیعی۸*
    y := b برگردان طبیعی۸*
    تکرار n در i:
        اگر x[i] نابرابر y[i]:
            برگشت نادرست
        پایان
    پایان
    برگشت درست
پایان

تابع sha_prefix(p: تهی*، n: صحیح): رشته:
    out := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    رمزنگاری.شا۲۵۶ بایت(p، n، out)
    r := hexof(out، 8)
    حافظه.آزادسازی(out)
    برگشت r
پایان

تابع nist():
    key := unhex("feffe9928665731c6d6a8f9467308308")
    nonce := unhex("cafebabefacedbaddecaf888")
    aad := unhex("feedfacedeadbeeffeedfacedeadbeefabaddad2")
    pt := unhex("d9313225f88406e5a55909c5aff5269a86a7a9531534f7da2e4c303d8a318a721c3c0c95956809532fcf0e2449a6b525b16aedf5aa0de657ba637b39")
    out := حافظه.تخصیص صفرشده(76 برگردان طبیعی۶۴)
    check("nist case 4 seal"، تی ال اس.مهر خام ای ای اس جی سی ام(key، 16، nonce، aad، 20، pt، 60، out))
    check("nist case 4 bytes"، hexof(out، 76) برابر "42831ec2217774244b7221b784d0d49ce3aa212f2c02a4e035c17e2329aca12e21d514b25466931c7d8f6a5aac84aa051ba30b396a0aac973d58e0915bc94fbc3221a5db94fae95ae7121a47")
    z := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    zn := حافظه.تخصیص صفرشده(12 برگردان طبیعی۶۴)
    o2 := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    تی ال اس.مهر خام ای ای اس جی سی ام(z، 16، zn، z، 0، z، 16، o2)
    check("nist case 2"، hexof(o2، 32) برابر "0388dace60b6a392f328c2b971b2fe78ab6e47d42cec13bdf53a67b21257bddf")
    o3 := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    تی ال اس.مهر خام ای ای اس جی سی ام(z، 32، zn، z، 0، z، 16، o3)
    check("nist case 14"، hexof(o3، 32) برابر "cea7403d4d606b6e074ec5d3baf39d18d0d1c8a799996bf0265b98b5d48ab919")
    bb := out برگردان طبیعی۸*
    bb[3] = bb[3] ^ (1 برگردان طبیعی۸)
    back := حافظه.تخصیص صفرشده(80 برگردان طبیعی۶۴)
    check("open tampered body fails"، وارونه تی ال اس.گشودن خام ای ای اس جی سی ام(key، 16، nonce، aad، 20، out، 76، back))
    bb[3] = bb[3] ^ (1 برگردان طبیعی۸)
    bb[70] = bb[70] ^ (1 برگردان طبیعی۸)
    check("open tampered tag fails"، وارونه تی ال اس.گشودن خام ای ای اس جی سی ام(key، 16، nonce، aad، 20، out، 76، back))
    bb[70] = bb[70] ^ (1 برگردان طبیعی۸)
    check("open restored"، تی ال اس.گشودن خام ای ای اس جی سی ام(key، 16، nonce، aad، 20، out، 76، back))
    check("open plaintext"، hexof(back، 60) برابر hexof(pt، 60))
    check("open short input"، وارونه تی ال اس.گشودن خام ای ای اس جی سی ام(key، 16، nonce، aad، 20، out، 8، back))
    check("bad key length"، وارونه تی ال اس.مهر خام ای ای اس جی سی ام(key، 24، nonce، aad، 20، pt، 60، out))
پایان

تابع case(klen: صحیح، n: صحیح، al: صحیح، tag: رشته، body: رشته):
    key := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    nonce := حافظه.تخصیص صفرشده(12 برگردان طبیعی۶۴)
    aad := حافظه.تخصیص صفرشده(64 برگردان طبیعی۶۴)
    pt := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    out := حافظه.تخصیص صفرشده((n + 16) برگردان طبیعی۶۴)
    back := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    kb := key برگردان طبیعی۸*
    تکرار 32 در i:
        kb[i] = (i * 7 + klen) برگردان طبیعی۸
    پایان
    nb := nonce برگردان طبیعی۸*
    تکرار 12 در i:
        nb[i] = (i * 13 + 5) برگردان طبیعی۸
    پایان
    ab := aad برگردان طبیعی۸*
    تکرار 64 در i:
        ab[i] = (i * 3 + 1) برگردان طبیعی۸
    پایان
    pb := pt برگردان طبیعی۸*
    تکرار n در i:
        pb[i] = (i * 31 + 17) برگردان طبیعی۸
    پایان
    تی ال اس.مهر خام ای ای اس جی سی ام(key، klen، nonce، aad، al، pt، n، out)
    tg := ((out برگردان صحیح۶۴) + (n برگردان صحیح۶۴)) برگردان تهی*
    ok := hexof(tg، 16) برابر tag و sha_prefix(out، n) برابر body
    open := تی ال اس.گشودن خام ای ای اس جی سی ام(key، klen، nonce، aad، al، out، n + 16، back)
    plain := same(back، pt، n)
    check("aes-" + رشته.از عدد(klen * 8) + " gcm size " + رشته.از عدد(n) + " aad " + رشته.از عدد(al)، ok و open و plain)
    ctx := تی ال اس.ای ای دی جدید(klen برابر 16 ? تی ال اس.ای ای دی ای ای اس۱۲۸ جی سی ام : تی ال اس.ای ای دی ای ای اس۲۵۶ جی سی ام، key)
    out2 := حافظه.تخصیص صفرشده((n + 16) برگردان طبیعی۶۴)
    تی ال اس.مهر ای ای دی(ctx، nonce، aad، al، pt، n، out2)
    check("aead ctx matches size " + رشته.از عدد(n)، same(out، out2، n + 16))
    حافظه.تنظیم(back، 0، (n + 1) برگردان طبیعی۶۴)
    check("aead ctx open size " + رشته.از عدد(n)، تی ال اس.گشودن ای ای دی(ctx، nonce، aad، al، out2، n، back) و same(back، pt، n))
    تی ال اس.آزادسازی ای ای دی(ctx)
    حافظه.آزادسازی(key)
    حافظه.آزادسازی(nonce)
    حافظه.آزادسازی(aad)
    حافظه.آزادسازی(pt)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(out2)
    حافظه.آزادسازی(back)
پایان

