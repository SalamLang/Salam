بسته ریشه

واردسازی تی ال اس
واردسازی پردازنده
واردسازی حافظه
واردسازی رشته

ناپایا failures := 0
ناپایا seed := 12345

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures++
    پایان
پایان

تابع rnd(): صحیح:
    seed = (seed * 1103515245 + 12345) & 0x7fffffff
    برگشت seed >> 8
پایان

تابع fill(p: تهی*، n: صحیح):
    b := p برگردان طبیعی۸*
    تکرار n در i:
        b[i] = (rnd() & 255) برگردان طبیعی۸
    پایان
پایان

تابع same(a: تهی*، b: تهی*، n: صحیح): منطقی:
    x := a برگردان طبیعی۸*
    y := b برگردان طبیعی۸*
    ناپایا d := 0
    تکرار n در i:
        d |= (x[i] ^ y[i]) برگردان صحیح
    پایان
    برگشت d برابر 0
پایان

تابع both(klen: صحیح، n: صحیح، al: صحیح):
    key := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    nonce := حافظه.تخصیص صفرشده(12 برگردان طبیعی۶۴)
    aad := حافظه.تخصیص صفرشده(80 برگردان طبیعی۶۴)
    pt := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    hw := حافظه.تخصیص صفرشده((n + 17) برگردان طبیعی۶۴)
    sw := حافظه.تخصیص صفرشده((n + 17) برگردان طبیعی۶۴)
    back := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    fill(key، 32)
    fill(nonce، 12)
    fill(aad، 80)
    fill(pt، n)
    پردازنده.تنظیم سخت افزار(درست)
    تی ال اس.مهر خام ای ای اس جی سی ام(key، klen، nonce، aad، al، pt، n، hw)
    پردازنده.تنظیم سخت افزار(نادرست)
    تی ال اس.مهر خام ای ای اس جی سی ام(key، klen، nonce، aad، al، pt، n، sw)
    same_out := same(hw، sw، n + 16)
    پردازنده.تنظیم سخت افزار(درست)
    open_hw := تی ال اس.گشودن خام ای ای اس جی سی ام(key، klen، nonce، aad، al، sw، n + 16، back)
    ok1 := open_hw و same(back، pt، n)
    حافظه.تنظیم(back، 0، (n + 1) برگردان طبیعی۶۴)
    پردازنده.تنظیم سخت افزار(نادرست)
    open_sw := تی ال اس.گشودن خام ای ای اس جی سی ام(key، klen، nonce، aad، al، hw، n + 16، back)
    ok2 := open_sw و same(back، pt، n)
    پردازنده.تنظیم سخت افزار(درست)
    hb := hw برگردان طبیعی۸*
    hb[n + (rnd() & 15)] ^= (1 برگردان طبیعی۸)
    bad_tag := وارونه تی ال اس.گشودن خام ای ای اس جی سی ام(key، klen، nonce، aad، al، hw، n + 16، back)
    ctx := تی ال اس.ای ای دی جدید(klen برابر 16 ? تی ال اس.ای ای دی ای ای اس۱۲۸ جی سی ام : تی ال اس.ای ای دی ای ای اس۲۵۶ جی سی ام، key)
    out3 := حافظه.تخصیص صفرشده((n + 17) برگردان طبیعی۶۴)
    تی ال اس.مهر ای ای دی(ctx، nonce، aad، al، pt، n، out3)
    ctx_same := same(out3، sw، n + 16)
    تی ال اس.آزادسازی ای ای دی(ctx)
    check("aes-" + رشته.از عدد(klen * 8) + " size " + رشته.از عدد(n) + " aad " + رشته.از عدد(al)، same_out و ok1 و ok2 و bad_tag و ctx_same)
    اگر n بزرگتر 0:
        پردازنده.تنظیم سخت افزار(درست)
        تی ال اس.مهر خام ای ای اس جی سی ام(key، klen، nonce، aad، al، pt، n، hw)
        hb[rnd() % n] ^= (4 برگردان طبیعی۸)
        check("tampered body rejected " + رشته.از عدد(n)، وارونه تی ال اس.گشودن خام ای ای اس جی سی ام(key، klen، nonce، aad، al، hw، n + 16، back))
    پایان
    حافظه.آزادسازی(key)
    حافظه.آزادسازی(nonce)
    حافظه.آزادسازی(aad)
    حافظه.آزادسازی(pt)
    حافظه.آزادسازی(hw)
    حافظه.آزادسازی(sw)
    حافظه.آزادسازی(back)
    حافظه.آزادسازی(out3)
پایان

تابع ریشه():
    پردازنده.تنظیم سخت افزار(نادرست)
    check("hardware can be forced off"، وارونه پردازنده.دارای رمز سخت افزاری())
    پردازنده.تنظیم سخت افزار(درست)
    sizes := [0، 1، 15، 16، 17، 31، 32، 33، 47، 48، 63، 64، 65، 100، 127، 128، 129، 143، 144، 191، 192، 255، 256، 257، 511، 1000، 1500، 4095، 4096، 4097، 8192، 16384، 16401، 70000]
    هر n در sizes:
        both(16، n، n % 41)
        both(32، n، (n * 3) % 80)
    پایان
    سرچاپ "failures"، failures
پایان
