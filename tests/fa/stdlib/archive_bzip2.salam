بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی آزمایش
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه

تابع ریشه(): صحیح:
    tmpdir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_bzip2_file_test")
    دیرکن حافظه.آزادسازی(tmpdir برگردان تهی*)
    سیستم عامل.ساخت پوشه ها(tmpdir)

    ناپایا text := فشرده سازی.بافر از رشته("bzip2 files: the quick brown fox jumps over the lazy dog, again and again and again.\n")
    src := مسیر پرونده.پیوند(tmpdir، "plain.txt")
    packed := مسیر پرونده.پیوند(tmpdir، "plain.txt.bz2")
    back := مسیر پرونده.پیوند(tmpdir، "plain_back.txt")
    missing := مسیر پرونده.پیوند(tmpdir، "no_such_file.bz2")
    junk := مسیر پرونده.پیوند(tmpdir، "junk.bz2")
    دیرکن حافظه.آزادسازی(src برگردان تهی*)
    دیرکن حافظه.آزادسازی(packed برگردان تهی*)
    دیرکن حافظه.آزادسازی(back برگردان تهی*)
    دیرکن حافظه.آزادسازی(missing برگردان تهی*)
    دیرکن حافظه.آزادسازی(junk برگردان تهی*)

    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی(src، text.داده، text.طول))
    آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده بی زیپ دو(src، packed))
    آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده بی زیپ دو(packed، back))
    ناپایا rok := نادرست
    ناپایا got := بایگانی.خواندن پرونده دودویی(back، rok)
    آزمایش.ادعای درستی(rok)
    آزمایش.ادعای درستی(فشرده سازی.برابری بافر(got، text))
    فشرده سازی.آزادسازی بافر(got)

    ناپایا head := بایگانی.خواندن پرونده دودویی(packed، rok)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(head، 0)، 66)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(head، 1)، 90)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(head، 2)، 104)
    فشرده سازی.آزادسازی بافر(head)

    آزمایش.ادعای نادرستی(بایگانی.فشرده سازی پرونده بی زیپ دو(missing، packed))
    آزمایش.ادعای نادرستی(بایگانی.کدگشایی پرونده بی زیپ دو(missing، back))
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی(junk، text.داده، text.طول))
    آزمایش.ادعای نادرستی(بایگانی.کدگشایی پرونده بی زیپ دو(junk، back))

    _ := سیستم عامل.حذف(src)
    _ := سیستم عامل.حذف(packed)
    _ := سیستم عامل.حذف(back)
    _ := سیستم عامل.حذف(junk)
    فشرده سازی.آزادسازی بافر(text)
    برگشت آزمایش.خلاصه()
پایان
