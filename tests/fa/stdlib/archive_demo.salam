بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی آزمایش
واردسازی سیستم عامل
واردسازی رشته
واردسازی مسیر پرونده
واردسازی حافظه

تابع repeat_str(s: رشته، count: صحیح): رشته:
    ناپایا b := رشته.سازنده()
    ناپایا i := 0
    تا i کوچکتر count:
        رشته.افزودن به بافر(b، s)
        i++
    پایان
    out := رشته.رشته بافر(b)
    رشته.آزادسازی بافر(b)
    برگشت out
پایان

تابع _rar_write_file_block(b &: فشرده سازی.بافر بایت، name: رشته، data: رشته):
    name_len := name.طول()
    data_len := data.طول()
    head_size := 7 + 25 + name_len
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 0x74)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، head_size)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، data_len)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، data_len)
    فشرده سازی.افزودن بایت(b، 0)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، فشرده سازی.چک جمع سی آر سی رشته(data) برگردان صحیح)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 20)
    فشرده سازی.افزودن بایت(b، 0x30)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، name_len)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0x20)
    فشرده سازی.افزودن بایت‌ها(b، name برگردان تهی*، name_len)
    فشرده سازی.افزودن بایت‌ها(b، data برگردان تهی*، data_len)
پایان

تابع build_synthetic_rar(name1: رشته، data1: رشته، name2: رشته، data2: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(b، 0x52)
    فشرده سازی.افزودن بایت(b، 0x61)
    فشرده سازی.افزودن بایت(b، 0x72)
    فشرده سازی.افزودن بایت(b، 0x21)
    فشرده سازی.افزودن بایت(b، 0x1a)
    فشرده سازی.افزودن بایت(b، 0x07)
    فشرده سازی.افزودن بایت(b، 0x00)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 0x73)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 13)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0)
    _rar_write_file_block(b، name1، data1)
    _rar_write_file_block(b، name2، data2)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 0x7b)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 7)
    برگشت b
پایان

تابع build_synthetic_rar5(name: رشته، data: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(b، 0x52)
    فشرده سازی.افزودن بایت(b، 0x61)
    فشرده سازی.افزودن بایت(b، 0x72)
    فشرده سازی.افزودن بایت(b، 0x21)
    فشرده سازی.افزودن بایت(b، 0x1a)
    فشرده سازی.افزودن بایت(b، 0x07)
    فشرده سازی.افزودن بایت(b، 0x01)
    فشرده سازی.افزودن بایت(b، 0x00)

    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 2)
    فشرده سازی.افزودن بایت(b، 1)
    فشرده سازی.افزودن بایت(b، 0)

    name_len := name.طول()
    data_len := data.طول()
    header_data_len := 9 + name_len
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، header_data_len)
    فشرده سازی.افزودن بایت(b، 2)
    فشرده سازی.افزودن بایت(b، 2)
    فشرده سازی.افزودن بایت(b، data_len)
    فشرده سازی.افزودن بایت(b، 0)
    فشرده سازی.افزودن بایت(b، data_len)
    فشرده سازی.افزودن بایت(b، 0)
    فشرده سازی.افزودن بایت(b، 0)
    فشرده سازی.افزودن بایت(b، 0)
    فشرده سازی.افزودن بایت(b، name_len)
    فشرده سازی.افزودن بایت‌ها(b، name برگردان تهی*، name_len)
    فشرده سازی.افزودن بایت‌ها(b، data برگردان تهی*، data_len)

    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 2)
    فشرده سازی.افزودن بایت(b، 5)
    فشرده سازی.افزودن بایت(b، 0)
    برگشت b
پایان

تابع ریشه:
    tmpdir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_archive_test")
    دیرکن حافظه.آزادسازی(tmpdir برگردان تهی*)
    سیستم عامل.ساخت پوشه ها(tmpdir)

    text1 := "The quick brown fox jumps over the lazy dog.\n"
    text2 := repeat_str("Salam archive test data, repeated for a real compression ratio. "، 100)
    ناپایا d1 := فشرده سازی.بافر از رشته(text1)
    ناپایا d2 := فشرده سازی.بافر از رشته(text2)
    حافظه.آزادسازی(text2 برگردان تهی*)

    p1 := مسیر پرونده.پیوند(tmpdir، "sample1.txt")
    دیرکن حافظه.آزادسازی(p1 برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی(p1، d1.داده، d1.طول))
    gzpath := مسیر پرونده.پیوند(tmpdir، "sample1.txt.gz")
    دیرکن حافظه.آزادسازی(gzpath برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده جی زیپ(p1، gzpath))
    gzout := مسیر پرونده.پیوند(tmpdir، "sample1_from_gz.txt")
    دیرکن حافظه.آزادسازی(gzout برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده جی زیپ(gzpath، gzout))
    ناپایا ok1 := نادرست
    ناپایا r1 := بایگانی.خواندن پرونده دودویی(gzout، ok1)
    آزمایش.ادعای درستی(ok1)
    آزمایش.ادعا با پیام(فشرده سازی.برابری بافر(d1، r1)، "gzip file round-trip mismatch")
    فشرده سازی.آزادسازی بافر(r1)

    p2 := مسیر پرونده.پیوند(tmpdir، "sample2.txt")
    دیرکن حافظه.آزادسازی(p2 برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی(p2، d2.داده، d2.طول))

    ناپایا zfiles := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    zfiles.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("sample1.txt"، d1.داده، d1.طول، 8))
    zfiles.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("sample2.txt"، d2.داده، d2.طول، 0))
    zippath := مسیر پرونده.پیوند(tmpdir، "test.zip")
    دیرکن حافظه.آزادسازی(zippath برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده زیپ(zfiles، zippath))
    دیرکن zfiles.آزادکن()

    ناپایا zok := نادرست
    ناپایا zipbuf := بایگانی.خواندن پرونده دودویی(zippath، zok)
    آزمایش.ادعای درستی(zok)
    ناپایا zentries := بایگانی.فهرست زیپ(zipbuf.داده، zipbuf.طول) برگردان وکتور<بایگانی.مدخل>
    آزمایش.ادعای برابری عدد(zentries.طول()، 2)
    دیرکن بایگانی.آزادسازی فهرست(zentries)

    ناپایا ze1ok := نادرست
    ناپایا ze1 := بایگانی.استخراج با نام از زیپ(zipbuf.داده، zipbuf.طول، "sample1.txt"، ze1ok)
    آزمایش.ادعای درستی(ze1ok)
    آزمایش.ادعا با پیام(فشرده سازی.برابری بافر(d1، ze1)، "zip deflate entry mismatch")
    فشرده سازی.آزادسازی بافر(ze1)

    ناپایا ze2ok := نادرست
    ناپایا ze2 := بایگانی.استخراج با نام از زیپ(zipbuf.داده، zipbuf.طول، "sample2.txt"، ze2ok)
    آزمایش.ادعای درستی(ze2ok)
    آزمایش.ادعا با پیام(فشرده سازی.برابری بافر(d2، ze2)، "zip store entry mismatch")
    فشرده سازی.آزادسازی بافر(ze2)

    zextractdir := مسیر پرونده.پیوند(tmpdir، "zip_extracted")
    دیرکن حافظه.آزادسازی(zextractdir برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.استخراج همه از زیپ(zipbuf.داده، zipbuf.طول، zextractdir))
    فشرده سازی.آزادسازی بافر(zipbuf)

    ناپایا tfiles := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    tfiles.بیفزا(بایگانی.ساخت ورودی پرونده تار("sample1.txt"، d1.داده، d1.طول، نادرست))
    tfiles.بیفزا(بایگانی.ساخت ورودی پرونده تار("sub/"، 0 برگردان تهی*، 0، درست))
    tfiles.بیفزا(بایگانی.ساخت ورودی پرونده تار("sub/sample2.txt"، d2.داده، d2.طول، نادرست))
    tarpath := مسیر پرونده.پیوند(tmpdir، "test.tar")
    دیرکن حافظه.آزادسازی(tarpath برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده تار(tfiles، tarpath))
    دیرکن tfiles.آزادکن()

    ناپایا tok := نادرست
    ناپایا tarbuf := بایگانی.خواندن پرونده دودویی(tarpath، tok)
    آزمایش.ادعای درستی(tok)
    ناپایا tentries := بایگانی.فهرست تار(tarbuf.داده، tarbuf.طول) برگردان وکتور<بایگانی.مدخل>
    آزمایش.ادعای برابری عدد(tentries.طول()، 3)
    دیرکن بایگانی.آزادسازی فهرست(tentries)

    ناپایا te1ok := نادرست
    ناپایا te1 := بایگانی.استخراج با نام از تار(tarbuf.داده، tarbuf.طول، "sample1.txt"، te1ok)
    آزمایش.ادعای درستی(te1ok)
    آزمایش.ادعا با پیام(فشرده سازی.برابری بافر(d1، te1)، "tar entry mismatch")
    فشرده سازی.آزادسازی بافر(te1)

    ناپایا te2ok := نادرست
    ناپایا te2 := بایگانی.استخراج با نام از تار(tarbuf.داده، tarbuf.طول، "sub/sample2.txt"، te2ok)
    آزمایش.ادعای درستی(te2ok)
    آزمایش.ادعا با پیام(فشرده سازی.برابری بافر(d2، te2)، "tar nested entry mismatch")
    فشرده سازی.آزادسازی بافر(te2)

    textractdir := مسیر پرونده.پیوند(tmpdir، "tar_extracted")
    دیرکن حافظه.آزادسازی(textractdir برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.استخراج همه از تار(tarbuf.داده، tarbuf.طول، textractdir))
    فشرده سازی.آزادسازی بافر(tarbuf)

    slipdir := مسیر پرونده.پیوند(tmpdir، "slip")
    دیرکن حافظه.آزادسازی(slipdir برگردان تهی*)
    innerdir := مسیر پرونده.پیوند(slipdir، "inner")
    دیرکن حافظه.آزادسازی(innerdir برگردان تهی*)
    escaped_zip := مسیر پرونده.پیوند(slipdir، "escaped_zip.txt")
    up_zip := مسیر پرونده.پیوند(slipdir، "up_zip.txt")
    escaped_tar := مسیر پرونده.پیوند(slipdir، "escaped_tar.txt")
    kept_zip := مسیر پرونده.پیوند(innerdir، "kept_zip.txt")
    kept_tar := مسیر پرونده.پیوند(innerdir، "kept_tar.txt")
    _ := سیستم عامل.حذف(escaped_zip)
    _ := سیستم عامل.حذف(up_zip)
    _ := سیستم عامل.حذف(escaped_tar)
    ناپایا sfiles := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    sfiles.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("../escaped_zip.txt"، d1.داده، d1.طول، 0))
    sfiles.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("/abs_zip.txt"، d1.داده، d1.طول، 0))
    sfiles.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("a/../../up_zip.txt"، d1.داده، d1.طول، 0))
    sfiles.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("kept_zip.txt"، d1.داده، d1.طول، 0))
    ناپایا slipzip := بایگانی.ساخت زیپ(sfiles)
    sfiles.آزادکن()
    آزمایش.ادعای نادرستی(بایگانی.استخراج همه از زیپ(slipzip.داده، slipzip.طول، innerdir))
    فشرده سازی.آزادسازی بافر(slipzip)
    ناپایا tslip := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    tslip.بیفزا(بایگانی.ساخت ورودی پرونده تار("../escaped_tar.txt"، d1.داده، d1.طول، نادرست))
    tslip.بیفزا(بایگانی.ساخت ورودی پرونده تار("kept_tar.txt"، d1.داده، d1.طول، نادرست))
    ناپایا sliptar := بایگانی.ساخت تار(tslip)
    tslip.آزادکن()
    آزمایش.ادعای نادرستی(بایگانی.استخراج همه از تار(sliptar.داده، sliptar.طول، innerdir))
    فشرده سازی.آزادسازی بافر(sliptar)
    آزمایش.ادعای نادرستی(سیستم عامل.وجود دارد(escaped_zip))
    آزمایش.ادعای نادرستی(سیستم عامل.وجود دارد(up_zip))
    آزمایش.ادعای نادرستی(سیستم عامل.وجود دارد(escaped_tar))
    آزمایش.ادعای درستی(سیستم عامل.وجود دارد(kept_zip))
    آزمایش.ادعای درستی(سیستم عامل.وجود دارد(kept_tar))
    حافظه.آزادسازی(escaped_zip برگردان تهی*)
    حافظه.آزادسازی(up_zip برگردان تهی*)
    حافظه.آزادسازی(escaped_tar برگردان تهی*)
    حافظه.آزادسازی(kept_zip برگردان تهی*)
    حافظه.آزادسازی(kept_tar برگردان تهی*)

    ناپایا rarbuf := build_synthetic_rar("hi.txt"، "Hi Salam!"، "sub/nested.txt"، "Nested RAR content")
    آزمایش.ادعای درستی(بایگانی.آر ای آر است(rarbuf.داده، rarbuf.طول))
    ناپایا rentries := بایگانی.فهرست آر ای آر(rarbuf.داده، rarbuf.طول) برگردان وکتور<بایگانی.مدخل>
    آزمایش.ادعای برابری عدد(rentries.طول()، 2)
    دیرکن بایگانی.آزادسازی فهرست(rentries)

    ناپایا re1ok := نادرست
    ناپایا re1 := بایگانی.استخراج با نام از آر ای آر(rarbuf.داده، rarbuf.طول، "hi.txt"، re1ok)
    آزمایش.ادعای درستی(re1ok)
    re1s := فشرده سازی.بافر به رشته(re1)
    آزمایش.ادعای برابری رشته(re1s، "Hi Salam!")
    حافظه.آزادسازی(re1s برگردان تهی*)
    فشرده سازی.آزادسازی بافر(re1)

    ناپایا re2ok := نادرست
    ناپایا re2 := بایگانی.استخراج با نام از آر ای آر(rarbuf.داده، rarbuf.طول، "sub/nested.txt"، re2ok)
    آزمایش.ادعای درستی(re2ok)
    re2s := فشرده سازی.بافر به رشته(re2)
    آزمایش.ادعای برابری رشته(re2s، "Nested RAR content")
    حافظه.آزادسازی(re2s برگردان تهی*)
    فشرده سازی.آزادسازی بافر(re2)
    فشرده سازی.آزادسازی بافر(rarbuf)

    ناپایا rar5buf := build_synthetic_rar5("hello5.txt"، "Hello RAR5!")
    آزمایش.ادعای درستی(بایگانی.آر ای آر است(rar5buf.داده، rar5buf.طول))
    ناپایا r5entries := بایگانی.فهرست آر ای آر(rar5buf.داده، rar5buf.طول) برگردان وکتور<بایگانی.مدخل>
    آزمایش.ادعای برابری عدد(r5entries.طول()، 1)
    r5e := r5entries.بگیر(0)
    آزمایش.ادعای برابری رشته(r5e.نام، "hello5.txt")
    آزمایش.ادعای برابری عدد(r5e.روش، 0)
    دیرکن بایگانی.آزادسازی فهرست(r5entries)

    ناپایا r5ok := نادرست
    ناپایا r5x := بایگانی.استخراج با نام از آر ای آر(rar5buf.داده، rar5buf.طول، "hello5.txt"، r5ok)
    آزمایش.ادعای درستی(r5ok)
    r5xs := فشرده سازی.بافر به رشته(r5x)
    آزمایش.ادعای برابری رشته(r5xs، "Hello RAR5!")
    حافظه.آزادسازی(r5xs برگردان تهی*)
    فشرده سازی.آزادسازی بافر(r5x)
    فشرده سازی.آزادسازی بافر(rar5buf)

    ناپایا bin := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(bin، 0)
    فشرده سازی.افزودن بایت(bin، 1)
    فشرده سازی.افزودن بایت(bin، 2)
    فشرده سازی.افزودن بایت(bin، 0)
    فشرده سازی.افزودن بایت(bin، 0)
    فشرده سازی.افزودن بایت(bin، 255)
    فشرده سازی.افزودن بایت(bin، 254)
    فشرده سازی.افزودن بایت(bin، 0)

    ناپایا bfiles := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    bfiles.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("bin.dat"، bin.داده، bin.طول، 8))
    binzip := مسیر پرونده.پیوند(tmpdir، "bin.zip")
    دیرکن حافظه.آزادسازی(binzip برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده زیپ(bfiles، binzip))
    دیرکن bfiles.آزادکن()

    ناپایا bzok := نادرست
    ناپایا binzipbuf := بایگانی.خواندن پرونده دودویی(binzip، bzok)
    ناپایا bxok := نادرست
    ناپایا bx := بایگانی.استخراج با نام از زیپ(binzipbuf.داده، binzipbuf.طول، "bin.dat"، bxok)
    آزمایش.ادعای درستی(bxok)
    آزمایش.ادعا با پیام(فشرده سازی.برابری بافر(bin، bx)، "zip binary entry mismatch")
    فشرده سازی.آزادسازی بافر(bx)
    فشرده سازی.آزادسازی بافر(binzipbuf)
    فشرده سازی.آزادسازی بافر(bin)

    فشرده سازی.آزادسازی بافر(d1)
    فشرده سازی.آزادسازی بافر(d2)
    سیستم عامل.حذف همه(tmpdir)

    برگشت آزمایش.خلاصه()
پایان
