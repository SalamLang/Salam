بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه

تابع بلوک بایگانی(b &: فشرده سازی.بافر بایت، نام: رشته، محتوا: رشته):
    طول نام := نام.طول()
    طول محتوا := محتوا.طول()
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 0x74)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 32 + طول نام)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، طول محتوا)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، طول محتوا)
    فشرده سازی.افزودن بایت(b، 0)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 20)
    فشرده سازی.افزودن بایت(b، 0x30)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، طول نام)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0x20)
    فشرده سازی.افزودن بایت‌ها(b، نام برگردان تهی*، طول نام)
    فشرده سازی.افزودن بایت‌ها(b، محتوا برگردان تهی*، طول محتوا)
پایان

تابع ساخت آر ای آر(): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(b، 0x52)
    فشرده سازی.افزودن بایت(b، 0x61)
    فشرده سازی.افزودن بایت(b، 0x72)
    فشرده سازی.افزودن بایت(b، 0x21)
    فشرده سازی.افزودن بایت(b، 0x1a)
    فشرده سازی.افزودن بایت(b، 0x07)
    فشرده سازی.افزودن بایت(b، 0x00)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 0x73)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 13)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0)
    بلوک بایگانی(b، "top.txt"، "top level")
    بلوک بایگانی(b، "sub/inner.txt"، "inner file")
    بلوک بایگانی(b، "../escape.txt"، "nope")
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 0x7b)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 7)
    برگشت b
پایان

تابع خواندن متن(مسیر: رشته): رشته:
    ناپایا موفق := نادرست
    محتوای پرونده := بایگانی.خواندن پرونده دودویی(مسیر، موفق)
    اگر وارونه موفق:
        برگشت "missing"
    پایان
    برگشت فشرده سازی.بافر به رشته(محتوای پرونده)
پایان

تابع ریشه:
    ناپایا ترتیب کوچک := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(ترتیب کوچک، 0x34)
    فشرده سازی.افزودن بایت(ترتیب کوچک، 0x12)
    فشرده سازی.افزودن بایت(ترتیب کوچک، 0x78)
    فشرده سازی.افزودن بایت(ترتیب کوچک، 0x56)
    فشرده سازی.افزودن بایت(ترتیب کوچک، 0x7f)
    سرچاپ بایگانی.خواندن شانزده بیتی کم ارزش‌اول(ترتیب کوچک.داده، 0)، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(ترتیب کوچک.داده، 2)، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(ترتیب کوچک.داده، 3)
    سرچاپ بایگانی.خواندن عدد۳۲ کم ارزش‌اول(ترتیب کوچک.داده، 0)، بایگانی.خواندن عدد۳۲ کم ارزش‌اول(ترتیب کوچک.داده، 1)
    ناپایا چرخه کامل := فشرده سازی.بافر بایت جدید()
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(چرخه کامل، 305419896)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(چرخه کامل، 513)
    سرچاپ بایگانی.خواندن عدد۳۲ کم ارزش‌اول(چرخه کامل.داده، 0)، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(چرخه کامل.داده، 4)

    متن := "a payload that is longer than ten bytes"
    ناپایا فهرست پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    فهرست پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("p.txt"، متن برگردان تهی*، متن.طول()، 8))
    z := بایگانی.ساخت زیپ(فهرست پرونده‌ها)
    ناپایا موفق := نادرست
    کوچک := بایگانی.استخراج با نام از زیپ با سقف(z.داده، z.طول، "p.txt"، 10، موفق)
    سرچاپ موفق، کوچک.طول
    دقیق := بایگانی.استخراج با نام از زیپ با سقف(z.داده، z.طول، "p.txt"، متن.طول()، موفق)
    سرچاپ موفق، فشرده سازی.بافر به رشته(دقیق) برابر متن
    بازشده := بایگانی.استخراج با نام از زیپ با سقف(z.داده، z.طول، "p.txt"، 0، موفق)
    سرچاپ موفق، بازشده.طول
    _ := بایگانی.استخراج با نام از زیپ با سقف(z.داده، z.طول، "none"، 100، موفق)
    سرچاپ موفق

    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_archive_extra")
    سیستم عامل.حذف همه(پوشه)
    آرشیو := ساخت آر ای آر()
    سرچاپ بایگانی.آر ای آر است(آرشیو.داده، آرشیو.طول)، بایگانی.فهرست آر ای آر(آرشیو.داده، آرشیو.طول).طول()
    سرچاپ بایگانی.استخراج همه از آر ای آر(آرشیو.داده، آرشیو.طول، پوشه)
    بالا := مسیر پرونده.پیوند(پوشه، "top.txt")
    درونی := مسیر پرونده.پیوند(پوشه، "sub/inner.txt")
    فرار := مسیر پرونده.پیوند(پوشه، "../escape.txt")
    سرچاپ خواندن متن(بالا)
    سرچاپ خواندن متن(درونی)
    سرچاپ سیستم عامل.وجود دارد(فرار)
    سیستم عامل.حذف همه(پوشه)
    حافظه.آزادسازی(پوشه برگردان تهی*)
پایان
