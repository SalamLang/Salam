تابع build_rar(): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(b، 0x52)
    فشرده سازی.افزودن بایت(b، 0x61)
    فشرده سازی.افزودن بایت(b، 0x72)
    فشرده سازی.افزودن بایت(b، 0x21)
    فشرده سازی.افزودن بایت(b، 0x1a)
    فشرده سازی.افزودن بایت(b، 0x07)
    فشرده سازی.افزودن بایت(b، 0x00)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 0x73)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 13)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(b، 0)
    rar_block(b، "top.txt"، "top level")
    rar_block(b، "sub/inner.txt"، "inner file")
    rar_block(b، "../escape.txt"، "nope")
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    فشرده سازی.افزودن بایت(b، 0x7b)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 0)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(b، 7)
    برگشت b
پایان

تابع read_text(path: رشته): رشته:
    ناپایا ok := نادرست
    buf := بایگانی.خواندن پرونده دودویی(path، ok)
    اگر وارونه ok:
        برگشت "missing"
    پایان
    برگشت فشرده سازی.بافر به رشته(buf)
پایان

تابع ریشه:
    ناپایا le := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(le، 0x34)
    فشرده سازی.افزودن بایت(le، 0x12)
    فشرده سازی.افزودن بایت(le، 0x78)
    فشرده سازی.افزودن بایت(le، 0x56)
    فشرده سازی.افزودن بایت(le، 0x7f)
    سرچاپ بایگانی.خواندن شانزده بیتی کم ارزش‌اول(le.داده، 0)، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(le.داده، 2)، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(le.داده، 3)
    سرچاپ بایگانی.خواندن عدد۳۲ کم ارزش‌اول(le.داده، 0)، بایگانی.خواندن عدد۳۲ کم ارزش‌اول(le.داده، 1)
    ناپایا round := فشرده سازی.بافر بایت جدید()
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(round، 305419896)
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(round، 513)
    سرچاپ بایگانی.خواندن عدد۳۲ کم ارزش‌اول(round.داده، 0)، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(round.داده، 4)

    body := "a payload that is longer than ten bytes"
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("p.txt"، body برگردان تهی*، body.طول()، 8))
    z := بایگانی.ساخت زیپ(files)
    ناپایا ok := نادرست
    small := بایگانی.استخراج با نام از زیپ با سقف(z.داده، z.طول، "p.txt"، 10، ok)
    سرچاپ ok، small.طول
    exact := بایگانی.استخراج با نام از زیپ با سقف(z.داده، z.طول، "p.txt"، body.طول()، ok)
    سرچاپ ok، فشرده سازی.بافر به رشته(exact) برابر body
    open := بایگانی.استخراج با نام از زیپ با سقف(z.داده، z.طول، "p.txt"، 0، ok)
    سرچاپ ok، open.طول
    _ := بایگانی.استخراج با نام از زیپ با سقف(z.داده، z.طول، "none"، 100، ok)
    سرچاپ ok

    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_archive_extra")
    سیستم عامل.حذف همه(dir)
    rar := build_rar()
    سرچاپ بایگانی.آر ای آر است(rar.داده، rar.طول)، بایگانی.فهرست آر ای آر(rar.داده، rar.طول).طول()
    سرچاپ بایگانی.استخراج همه از آر ای آر(rar.داده، rar.طول، dir)
    top := مسیر پرونده.پیوند(dir، "top.txt")
    inner := مسیر پرونده.پیوند(dir، "sub/inner.txt")
    escape := مسیر پرونده.پیوند(dir، "../escape.txt")
    سرچاپ read_text(top)
    سرچاپ read_text(inner)
    سرچاپ سیستم عامل.وجود دارد(escape)
    سیستم عامل.حذف همه(dir)
    حافظه.آزادسازی(dir برگردان تهی*)
پایان
