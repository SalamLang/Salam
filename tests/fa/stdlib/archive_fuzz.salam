ساختار Rng:
    همگانی s: طبیعی۶۴ = 88172645463325252 برگردان طبیعی۶۴
پایان

تابع next(r &: Rng): صحیح:
    ناپایا x := r.s
    x ^= x << (13 برگردان طبیعی۶۴)
    x ^= x >> (7 برگردان طبیعی۶۴)
    x ^= x << (17 برگردان طبیعی۶۴)
    r.s = x
    برگشت ((x >> (11 برگردان طبیعی۶۴)) & (0x7fffffff برگردان طبیعی۶۴)) برگردان صحیح
پایان

تابع below(r &: Rng، n: صحیح): صحیح:
    اگر n کوچکتربرابر 0: برگشت 0 پایان
    برگشت next(r) % n
پایان

تابع hexv(c: صحیح): صحیح:
    اگر c بزرگتربرابر 97: برگشت c - 87 پایان
    برگشت c - 48
پایان

تابع unhex(h: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := h برگردان طبیعی۸*
    ناپایا i := 0
    تا i + 1 کوچکتر h.طول():
        فشرده سازی.افزودن بایت(b، hexv(bp[i] برگردان صحیح) * 16 + hexv(bp[i + 1] برگردان صحیح))
        i += 2
    پایان
    برگشت b
پایان

تابع make_files(): وکتور<بایگانی.ورودی پرونده>:
    ناپایا v := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    v.بیفزا(بایگانی.ساخت ورودی پرونده("docs/"، پوچ، 0، درست))
    v.بیفزا(بایگانی.ساخت ورودی پرونده("docs/a.txt"، "hello hello hello hello hello hello" برگردان تهی*، 35، نادرست))
    v.بیفزا(بایگانی.ساخت ورودی پرونده("b.bin"، "0123456789abcdef0123456789abcdef" برگردان تهی*، 32، نادرست))
    برگشت v
پایان

تابع mutate(r &: Rng، src: فشرده سازی.بافر بایت): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.کپی بافر(src)
    اگر out.طول برابر 0: برگشت out پایان
    p := out.داده برگردان طبیعی۸*
    kind := below(r، 8)
    اگر kind برابر 0:
        out.طول = below(r، out.طول)
    وگرنه kind برابر 1:
        تکرار 1 + below(r، 8):
            at := below(r، out.طول)
            p[at] = ((p[at] برگردان صحیح) ^ (1 << below(r، 8))) برگردان طبیعی۸
        پایان
    وگرنه kind برابر 2:
        تکرار 1 + below(r، 4):
            p[below(r، out.طول)] = below(r، 256) برگردان طبیعی۸
        پایان
    وگرنه kind برابر 3:
        a := below(r، out.طول)
        b := below(r، out.طول)
        n := below(r، out.طول - (a بزرگتر b ? a : b) + 1)
        تکرار n در i:
            p[b + i] = p[a + i]
        پایان
    وگرنه kind برابر 4:
        at := below(r، out.طول)
        w := 1 + below(r، 8)
        تکرار w در i:
            اگر at + i کوچکتر out.طول: p[at + i] = 255 برگردان طبیعی۸ پایان
        پایان
    وگرنه kind برابر 5:
        at := below(r، out.طول)
        w := 1 + below(r، 16)
        تکرار w در i:
            اگر at + i کوچکتر out.طول: p[at + i] = 0 برگردان طبیعی۸ پایان
        پایان
    وگرنه kind برابر 6:
        at := below(r، out.طول)
        w := 1 + below(r، 8)
        ناپایا ins := فشرده سازی.بافر بایت جدید()
        فشرده سازی.افزودن بایت‌ها(ins، out.داده، at)
        تکرار w:
            فشرده سازی.افزودن بایت(ins، below(r، 256))
        پایان
        فشرده سازی.افزودن بایت‌ها(ins، ((out.داده برگردان صحیح۶۴) + (at برگردان صحیح۶۴)) برگردان تهی*، out.طول - at)
        فشرده سازی.آزادسازی بافر(out)
        out = ins
    وگرنه:
        at := below(r، out.طول)
        w := 1 + below(r، 8)
        ناپایا del := فشرده سازی.بافر بایت جدید()
        فشرده سازی.افزودن بایت‌ها(del، out.داده، at)
        اگر at + w کوچکتر out.طول:
            فشرده سازی.افزودن بایت‌ها(del، ((out.داده برگردان صحیح۶۴) + ((at + w) برگردان صحیح۶۴)) برگردان تهی*، out.طول - at - w)
        پایان
        فشرده سازی.آزادسازی بافر(out)
        out = del
    پایان
    برگشت out
پایان


تابع getb(b: فشرده سازی.بافر بایت، i: صحیح): صحیح:
    اگر i کوچکتر 0 یا i بزرگتربرابر b.طول: برگشت 0 پایان
    برگشت (b.داده برگردان طبیعی۸*)[i] برگردان صحیح
پایان

تابع setb(b &: فشرده سازی.بافر بایت، i: صحیح، v: صحیح):
    اگر i بزرگتربرابر 0 و i کوچکتر b.طول: (b.داده برگردان طبیعی۸*)[i] = (v & 255) برگردان طبیعی۸ پایان
پایان

تابع get32(b: فشرده سازی.بافر بایت، i: صحیح): صحیح:
    برگشت getb(b، i) | (getb(b، i + 1) << 8) | (getb(b، i + 2) << 16) | (getb(b، i + 3) << 24)
پایان

تابع put32(b &: فشرده سازی.بافر بایت، i: صحیح، v: صحیح):
    setb(b، i، v)
    setb(b، i + 1، v >> 8)
    setb(b، i + 2، v >> 16)
    setb(b، i + 3، v >> 24)
پایان

تابع crc_range(b: فشرده سازی.بافر بایت، from: صحیح، n: صحیح): صحیح:
    اگر from کوچکتر 0 یا n کوچکتر 0 یا from + n بزرگتر b.طول: برگشت 0 پایان
    برگشت فشرده سازی.چک جمع سی آر سی(((b.داده برگردان صحیح۶۴) + (from برگردان صحیح۶۴)) برگردان تهی*، n) برگردان صحیح
پایان

تابع nasty(r &: Rng): صحیح:
    k := below(r، 8)
    اگر k برابر 0: برگشت 0 پایان
    اگر k برابر 1: برگشت 255 پایان
    اگر k برابر 2: برگشت 127 پایان
    اگر k برابر 3: برگشت 128 پایان
    اگر k برابر 4: برگشت 1 پایان
    اگر k برابر 5: برگشت 254 پایان
    برگشت below(r، 256)
پایان

تابع scramble(r &: Rng، b &: فشرده سازی.بافر بایت، from: صحیح، n: صحیح):
    اگر n کوچکتربرابر 0: برگشت پایان
    تکرار 1 + below(r، 3):
        at := from + below(r، n)
        اگر below(r، 3) برابر 0:
            setb(b، at، getb(b، at) ^ (1 << below(r، 8)))
        وگرنه:
            setb(b، at، nasty(r))
        پایان
    پایان
پایان

تابع rar5_fix(r &: Rng، b &: فشرده سازی.بافر بایت): منطقی:
    ناپایا hits := وکتور {} برگردان وکتور<صحیح>
    ناپایا pos := 8
    تا pos + 8 کوچکتر b.طول و pos کوچکتر 70000:
        ناپایا l := 0
        ناپایا sz := 0
        ناپایا sh := 0
        ناپایا i := pos + 4
        تا i کوچکتر pos + 14 و l کوچکتر 4:
            v := getb(b، i)
            sz |= (v & 127) << sh
            sh += 7
            l++
            i++
            اگر (v & 128) برابر 0: بشکن پایان
        پایان
        اگر l بزرگتر 0 و sz بزرگتر 1 و sz کوچکتر 60000 و pos + 4 + l + sz کوچکتربرابر b.طول:
            اگر crc_range(b، pos + 4، l + sz) برابر get32(b، pos): hits.بیفزا(pos) پایان
        پایان
        pos++
    پایان
    اگر hits.طول() برابر 0: برگشت نادرست پایان
    h := hits.بگیر(below(r، hits.طول()))
    ناپایا l := 1
    ناپایا sz := getb(b، h + 4)
    اگر (sz & 128) نابرابر 0:
        sz = (sz & 127) | (getb(b، h + 5) << 7)
        l = 2
    پایان
    scramble(r، b، h + 4 + l، sz)
    put32(b، h، crc_range(b، h + 4، l + sz))
    hits.آزادکن()
    برگشت درست
پایان

تابع rar4_fix(r &: Rng، b &: فشرده سازی.بافر بایت): منطقی:
    ناپایا hits := وکتور {} برگردان وکتور<صحیح>
    ناپایا pos := 7
    تا pos + 7 کوچکتر b.طول و pos کوچکتر 70000:
        t := getb(b، pos + 2)
        sz := getb(b، pos + 5) | (getb(b، pos + 6) << 8)
        اگر t بزرگتربرابر 0x72 و t کوچکتربرابر 0x7b و sz بزرگتربرابر 7 و pos + sz کوچکتربرابر b.طول:
            اگر (crc_range(b، pos + 2، sz - 2) & 65535) برابر (getb(b، pos) | (getb(b، pos + 1) << 8)): hits.بیفزا(pos) پایان
        پایان
        pos++
    پایان
    اگر hits.طول() برابر 0: برگشت نادرست پایان
    h := hits.بگیر(below(r، hits.طول()))
    sz := getb(b، h + 5) | (getb(b، h + 6) << 8)
    scramble(r، b، h + 3، sz - 3)
    c := crc_range(b، h + 2، sz - 2)
    setb(b، h، c)
    setb(b، h + 1، c >> 8)
    hits.آزادکن()
    برگشت درست
پایان

تابع xz_fix(r &: Rng، b &: فشرده سازی.بافر بایت): منطقی:
    اگر b.طول کوچکتر 36: برگشت نادرست پایان
    k := below(r، 4)
    اگر k برابر 0:
        scramble(r، b، 6، 2)
        put32(b، 8، crc_range(b، 6، 2))
        برگشت درست
    پایان
    اگر k برابر 1:
        hs := (getb(b، 12) + 1) * 4
        اگر hs کوچکتر 8 یا 12 + hs بزرگتر b.طول: برگشت نادرست پایان
        scramble(r، b، 13، hs - 5)
        put32(b، 12 + hs - 4، crc_range(b، 12، hs - 4))
        برگشت درست
    پایان
    اگر k برابر 2:
        bs := (get32(b، b.طول - 8) + 1) * 4
        ipos := b.طول - 12 - bs
        اگر bs کوچکتر 8 یا ipos کوچکتر 12: برگشت نادرست پایان
        scramble(r، b، ipos، bs - 4)
        put32(b، ipos + bs - 4، crc_range(b، ipos، bs - 4))
        برگشت درست
    پایان
    scramble(r، b، b.طول - 8، 6)
    put32(b، b.طول - 12، crc_range(b، b.طول - 8، 6))
    برگشت درست
پایان

تابع zip_fix(r &: Rng، b &: فشرده سازی.بافر بایت): منطقی:
    ناپایا hits := وکتور {} برگردان وکتور<صحیح>
    ناپایا pos := 0
    تا pos + 4 کوچکتر b.طول و pos کوچکتر 70000:
        اگر getb(b، pos) برابر 0x50 و getb(b، pos + 1) برابر 0x4b:
            t := getb(b، pos + 2)
            اگر (t برابر 3 و getb(b، pos + 3) برابر 4) یا (t برابر 1 و getb(b، pos + 3) برابر 2) یا (t برابر 5 و getb(b، pos + 3) برابر 6): hits.بیفزا(pos) پایان
        پایان
        pos++
    پایان
    اگر hits.طول() برابر 0: برگشت نادرست پایان
    h := hits.بگیر(below(r، hits.طول()))
    at := h + 4 + below(r، 40)
    اگر below(r، 2) برابر 0:
        put32(b، at، nasty(r) * 16777216 + nasty(r))
    وگرنه:
        setb(b، at، nasty(r))
    پایان
    hits.آزادکن()
    برگشت درست
پایان

تابع gz_fix(r &: Rng، b &: فشرده سازی.بافر بایت): منطقی:
    اگر b.طول کوچکتر 30: برگشت نادرست پایان
    ناپایا ok := نادرست
    ناپایا full := فشرده سازی.کدگشایی جی زیپ با سقف(b.داده، b.طول، 1048576، ok)
    اگر وارونه ok: فشرده سازی.آزادسازی بافر(full) برگشت نادرست پایان
    pos := 10 + below(r، b.طول - 18)
    scramble(r، b، pos، 3)
    ناپایا ok2 := نادرست
    ناپایا out := فشرده سازی.کدگشایی دیفلیت خام با سقف(((b.داده برگردان صحیح۶۴) + (10 برگردان صحیح۶۴)) برگردان تهی*، b.طول - 18، 0، 1048576، ok2)
    put32(b، b.طول - 8، فشرده سازی.چک جمع سی آر سی(out.داده، out.طول) برگردان صحیح)
    put32(b، b.طول - 4، out.طول)
    فشرده سازی.آزادسازی بافر(out)
    فشرده سازی.آزادسازی بافر(full)
    برگشت درست
پایان

تابع mutate2(r &: Rng، src: فشرده سازی.بافر بایت): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.کپی بافر(src)
    ناپایا done := نادرست
    اگر out.طول بزرگتر 16:
        اگر getb(out، 0) برابر 0x52 و getb(out، 1) برابر 0x61 و getb(out، 6) برابر 1:
            done = rar5_fix(r، out)
        وگرنه getb(out، 0) برابر 0x52 و getb(out، 1) برابر 0x61:
            done = rar4_fix(r، out)
        وگرنه getb(out، 0) برابر 0xfd و getb(out، 1) برابر 0x37:
            done = xz_fix(r، out)
        وگرنه getb(out، 0) برابر 0x50 و getb(out، 1) برابر 0x4b:
            done = zip_fix(r، out)
        وگرنه getb(out، 0) برابر 0x1f و getb(out، 1) برابر 0x8b:
            done = gz_fix(r، out)
        پایان
    پایان
    اگر وارونه done:
        فشرده سازی.آزادسازی بافر(out)
        برگشت mutate(r، src)
    پایان
    برگشت out
پایان

تابع file_paths(b: فشرده سازی.بافر بایت، dest: رشته):
    p := سیستم عامل.پوشه موقت() + "/salam_fz_in.bin"
    out := سیستم عامل.پوشه موقت() + "/salam_fz_out.bin"
    _ := بایگانی.نوشتن پرونده دودویی از بافر(p، b)
    ناپایا rf := بایگانی.بازکردن پرونده آر ای آر(p)
    اگر rf.وضعیت برابر بایگانی.آر ای آر موفق:
        ناپایا es := بایگانی.مدخل های پرونده آر ای آر(rf)
        ناپایا k := 0
        تا k کوچکتر es.طول() و k کوچکتر 4:
            _ := بایگانی.استخراج از پرونده آر ای آر به پرونده(rf، es.بگیر(k).نام، out، 4194304 برگردان صحیح۶۴، 33554432 برگردان صحیح۶۴)
            k++
        پایان
        بایگانی.آزادسازی فهرست(es)
        _ := بایگانی.استخراج همه از پرونده آر ای آر(rf، dest، 4194304 برگردان صحیح۶۴، 33554432 برگردان صحیح۶۴)
    پایان
    بایگانی.بستن پرونده آر ای آر(rf)
    ناپایا zf := بایگانی.بازکردن پرونده زیپ(p)
    اگر zf.وضعیت برابر بایگانی.زیپ موفق:
        _ := بایگانی.استخراج همه از پرونده زیپ(zf، dest، 4194304 برگردان صحیح۶۴)
    پایان
    بایگانی.بستن پرونده زیپ(zf)
    _ := بایگانی.استخراج همه از پرونده تار(p، dest، 4194304 برگردان صحیح۶۴)
