تابع ریشه:
    args := سیستم عامل.آرگومان ها()
    ناپایا rounds := 2
    ناپایا seed := 1
    ناپایا verbose := نادرست
    اگر args.طول() بزرگتر 1: rounds = تبدیل.رشته به عدد با پیش فرض(args.بگیر(1)، 2) پایان
    اگر args.طول() بزرگتر 2: seed = تبدیل.رشته به عدد با پیش فرض(args.بگیر(2)، 1) پایان
    اگر args.طول() بزرگتر 3: verbose = درست پایان
    ناپایا r := Rng {}
    r.s = (88172645463325252 + seed * 7919) برگردان طبیعی۶۴
    ناپایا corpus := seeds()
    dest := سیستم عامل.پوشه موقت() + "/salam_fuzz_out"
    ناپایا cases := 0
    ناپایا i := 0
    تا i کوچکتر corpus.طول():
        ناپایا j := 0
        تا j کوچکتر rounds:
            اگر verbose: نادرست‌سرچاپ "seed"، i، j پایان
            ناپایا m := mutate2(r، corpus.بگیر(i))
            اگر verbose: _ := بایگانی.نوشتن پرونده دودویی از بافر(سیستم عامل.پوشه موقت() + "/salam_fuzz_last.bin"، m) پایان
            exercise(m، j % 4 برابر 0، dest)
            فشرده سازی.آزادسازی بافر(m)
            سیستم عامل.حذف همه(dest)
            cases++
            j++
        پایان
        i++
    پایان
    ناپایا kb := 0
    تا kb کوچکتر corpus.طول():
        exercise(corpus.بگیر(kb)، نادرست، dest)
        kb++
    پایان
    سرچاپ "fuzz cases"، cases
    ناپایا k := 0
    تا k کوچکتر corpus.طول():
        ناپایا c := corpus.بگیر(k)
        فشرده سازی.آزادسازی بافر(c)
        k++
    پایان
    corpus.آزادکن()
پایان
