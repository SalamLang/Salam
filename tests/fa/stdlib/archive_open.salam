پایا SEVENZ := """

"""

تابع hex_val(c: صحیح): صحیح:
    اگر c بزرگتربرابر 97: برگشت c - 87 پایان
    برگشت c - 48
پایان

تابع unhex(h: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := h برگردان طبیعی۸*
    ناپایا i := 0
    تا i کوچکتر h.طول():
        c := bp[i] برگردان صحیح
        اگر (c بزرگتربرابر 48 و c کوچکتربرابر 57) یا (c بزرگتربرابر 97 و c کوچکتربرابر 102):
            اگر i + 1 کوچکتر h.طول():
                فشرده سازی.افزودن بایت(b، hex_val(c) * 16 + hex_val(bp[i + 1] برگردان صحیح))
            پایان
            i += 2
        وگرنه:
            i++
        پایان
    پایان
    برگشت b
پایان

تابع make_files(): وکتور<بایگانی.ورودی پرونده>:
    ناپایا v := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    v.بیفزا(بایگانی.ساخت ورودی پرونده("docs/"، پوچ، 0، درست))
    v.بیفزا(بایگانی.ساخت ورودی پرونده("docs/a.txt"، "hello hello hello hello" برگردان تهی*، 23، نادرست))
    v.بیفزا(بایگانی.ساخت ورودی پرونده("b.txt"، "bee" برگردان تهی*، 3، نادرست))
    برگشت v
پایان

تابع roundtrip(label: رشته، format: صحیح):
    ناپایا files := make_files()
    ناپایا st := 0
    ناپایا buf := بایگانی.ساخت بایگانی در بافر(format، files، st)
    ناپایا arc := بایگانی.بازکردن بایگانی(buf.داده، buf.طول، "")
    سرچاپ label، st، بایگانی.نام قالب(arc.قالب)، arc.وضعیت
    ناپایا es := بایگانی.فهرست بایگانی(arc)
    سرچاپ es.طول()
    ناپایا data := بایگانی.خواندن از بایگانی(arc، "docs/a.txt")
    سرچاپ arc.وضعیت، data.طول
    فشرده سازی.آزادسازی بافر(data)
    ناپایا miss := بایگانی.خواندن از بایگانی(arc، "nope")
    سرچاپ arc.وضعیت، بایگانی.متن وضعیت بایگانی(arc.وضعیت)
    فشرده سازی.آزادسازی بافر(miss)
    بایگانی.آزادسازی فهرست(es)
    dest := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_open_demo")
    سیستم عامل.حذف همه(dest)
    n := بایگانی.استخراج همه از بایگانی(arc، dest)
    سرچاپ n، arc.وضعیت، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dest، "docs/a.txt"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dest، "b.txt"))
    سیستم عامل.حذف همه(dest)
    بایگانی.بستن بایگانی(arc)
    فشرده سازی.آزادسازی بافر(buf)
    files.آزادکن()
پایان

تابع single(label: رشته، format: صحیح):
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    files.بیفزا(بایگانی.ساخت ورودی پرونده("x.txt"، "single stream" برگردان تهی*، 13، نادرست))
    ناپایا st := 0
    ناپایا buf := بایگانی.ساخت بایگانی در بافر(format، files، st)
    ناپایا arc := بایگانی.بازکردن بایگانی(buf.داده، buf.طول، "")
    ناپایا es := بایگانی.فهرست بایگانی(arc)
    ناپایا data := بایگانی.خواندن از بایگانی(arc، "")
    سرچاپ label، st، بایگانی.نام قالب(arc.قالب)، es.طول()، data.طول، arc.وضعیت
    فشرده سازی.آزادسازی بافر(data)
    بایگانی.آزادسازی فهرست(es)
    بایگانی.بستن بایگانی(arc)
    فشرده سازی.آزادسازی بافر(buf)
    files.آزادکن()
پایان


تابع unsafe_cases():
    dest := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_open_unsafe")
    سیستم عامل.حذف همه(dest)
    ناپایا zs := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    zs.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("ok.txt"، "fine" برگردان تهی*، 4، 0))
    zs.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("../evil.txt"، "bad" برگردان تهی*، 3، 0))
    ناپایا zb := بایگانی.ساخت زیپ(zs)
    ناپایا za := بایگانی.بازکردن بایگانی(zb.داده، zb.طول، "")
    سرچاپ بایگانی.استخراج همه از بایگانی(za، dest)، za.وضعیت، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dest، "ok.txt"))
    بایگانی.بستن بایگانی(za)
    فشرده سازی.آزادسازی بافر(zb)
    ناپایا ts := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    ts.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("link"، "../../etc"))
    ناپایا tb := بایگانی.ساخت تار(ts)
    ناپایا ta := بایگانی.بازکردن بایگانی(tb.داده، tb.طول، "")
    سرچاپ بایگانی.استخراج همه از بایگانی(ta، dest)، ta.وضعیت
    بایگانی.بستن بایگانی(ta)
    فشرده سازی.آزادسازی بافر(tb)
    ناپایا hs := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    hs.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("d"، "sub"))
    hs.بیفزا(بایگانی.ساخت ورودی پرونده تار("d/x.txt"، "x" برگردان تهی*، 1، نادرست))
    ناپایا hb := بایگانی.ساخت تار(hs)
    ناپایا ha := بایگانی.بازکردن بایگانی(hb.داده، hb.طول، "")
    سرچاپ بایگانی.استخراج همه از بایگانی(ha، dest)، ha.وضعیت
    بایگانی.بستن بایگانی(ha)
    فشرده سازی.آزادسازی بافر(hb)
    files := make_files()
    ناپایا st := 0
    ناپایا buf := بایگانی.ساخت بایگانی در بافر(بایگانی.قالب زیپ، files، st)
    ناپایا lim := بایگانی.سقف های پیش فرض()
    lim.بیشینه مدخل = 2
    ناپایا a1 := بایگانی.بازکردن با سقف(buf.داده، buf.طول، ""، lim)
    سرچاپ بایگانی.استخراج همه از بایگانی(a1، dest)، a1.وضعیت
    بایگانی.بستن بایگانی(a1)
    lim = بایگانی.سقف های پیش فرض()
    lim.بیشینه اندازه مدخل = 10 برگردان صحیح۶۴
    ناپایا a2 := بایگانی.بازکردن با سقف(buf.داده، buf.طول، ""، lim)
    سرچاپ بایگانی.استخراج همه از بایگانی(a2، dest)، a2.وضعیت
    ناپایا d2 := بایگانی.خواندن از بایگانی(a2، "docs/a.txt")
    سرچاپ d2.طول، a2.وضعیت
    فشرده سازی.آزادسازی بافر(d2)
    بایگانی.بستن بایگانی(a2)
    ناپایا big := فشرده سازی.بافر بایت جدید()
    ناپایا zero := فشرده سازی.بافر بایت جدید()
    تکرار 4096:
        فشرده سازی.افزودن بایت(zero، 0)
    پایان
    تکرار 300:
        فشرده سازی.افزودن بافر(big، zero)
    پایان
