    lim = بایگانی.سقف های پیش فرض()
    lim.بیشینه اندازه کل = 1000000 برگردان صحیح۶۴
    ناپایا a4 := بایگانی.بازکردن با سقف(gz.داده، gz.طول، ""، lim)
    سرچاپ a4.وضعیت، بایگانی.متن وضعیت بایگانی(a4.وضعیت)
    بایگانی.بستن بایگانی(a4)
    made := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_open_made.zip")
    سرچاپ بایگانی.ساخت بایگانی(made، files)، سیستم عامل.وجود دارد(made)
    سیستم عامل.حذف(made)
    فشرده سازی.آزادسازی بافر(buf)
    فشرده سازی.آزادسازی بافر(big)
    فشرده سازی.آزادسازی بافر(zbuf)
    فشرده سازی.آزادسازی بافر(gz)
    bf.آزادکن()
    سیستم عامل.حذف همه(dest)
