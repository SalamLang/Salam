تابع file_cases():
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_open_files")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا files := make_files()
    path := مسیر پرونده.پیوند(dir، "pack.tgz")
    سرچاپ بایگانی.ساخت بایگانی(path، files)
    ناپایا st := 0
    ناپایا es := بایگانی.فهرست پرونده بایگانی(path، ""، st)
    سرچاپ es.طول()، st
    بایگانی.آزادسازی فهرست(es)
    out := مسیر پرونده.پیوند(dir، "out")
    سرچاپ بایگانی.استخراج پرونده بایگانی(path، out، ""، st)، st، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(out، "b.txt"))
    ناپایا arc := بایگانی.بازکردن پرونده بایگانی(path، "")
    سرچاپ بایگانی.تشخیص قالب(arc.داده، arc.طول) برابر بایگانی.قالب جی زیپ، بایگانی.نام قالب(arc.قالب)
    سرچاپ بایگانی.استخراج یک مدخل(arc، "docs/a.txt"، مسیر پرونده.پیوند(dir، "one"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "one/docs/a.txt"))
    سرچاپ بایگانی.استخراج یک مدخل(arc، "missing"، مسیر پرونده.پیوند(dir، "one"))، arc.وضعیت
    ناپایا lim := بایگانی.سقف های پیش فرض()
    lim.بیشینه اندازه مدخل = 5 برگردان صحیح۶۴
    بایگانی.تنظیم سقف ها(arc، lim)
    سرچاپ بایگانی.استخراج یک مدخل(arc، "docs/a.txt"، مسیر پرونده.پیوند(dir، "two"))، arc.وضعیت
    بایگانی.بستن بایگانی(arc)
    سیستم عامل.حذف همه(dir)
    files.آزادکن()
پایان

تابع ریشه:
    unsafe_cases()
    file_cases()
    roundtrip("zip"، بایگانی.قالب زیپ)
    roundtrip("tar"، بایگانی.قالب تار)
    roundtrip("tgz"، بایگانی.قالب تار جی زیپ)
    roundtrip("tbz2"، بایگانی.قالب تار بی زیپ دو)
    roundtrip("rar"، بایگانی.قالب آر ای آر)
    single("gz"، بایگانی.قالب جی زیپ)
    single("bz2"، بایگانی.قالب بی زیپ دو)
    ناپایا z := unhex(SEVENZ)
    ناپایا arc := بایگانی.بازکردن بایگانی(z.داده، z.طول، "")
    ناپایا es := بایگانی.فهرست بایگانی(arc)
    سرچاپ بایگانی.نام قالب(arc.قالب)، arc.وضعیت، es.طول()
    بایگانی.آزادسازی فهرست(es)
    بایگانی.بستن بایگانی(arc)
    فشرده سازی.آزادسازی بافر(z)
    سرچاپ بایگانی.تشخیص قالب از نام("a.TAR.GZ")، بایگانی.تشخیص قالب از نام("x.tgz")، بایگانی.تشخیص قالب از نام("x.7z")، بایگانی.تشخیص قالب از نام("x.bin")
    junk := بایگانی.بازکردن بایگانی("plain text here" برگردان تهی*، 15، "")
    سرچاپ بایگانی.نام قالب(junk.قالب)، junk.وضعیت، بایگانی.متن وضعیت بایگانی(junk.وضعیت)
    zst := بایگانی.بازکردن بایگانی("\x28\xb5\x2f\xfdabcd" برگردان تهی*، 8، "")
    سرچاپ بایگانی.نام قالب(zst.قالب)، بایگانی.متن وضعیت بایگانی(zst.وضعیت)
    bad := بایگانی.بازکردن پرونده بایگانی("/nonexistent/file.zip"، "")
    سرچاپ بایگانی.متن وضعیت بایگانی(bad.وضعیت)
    ناپایا files := make_files()
    سرچاپ بایگانی.ساخت بایگانی("/tmp/x.7z"، files)، بایگانی.ساخت بایگانی("/tmp/x.xyz"، files)
    files.آزادکن()
پایان
