    ناپایا bf := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    bf.بیفزا(بایگانی.ساخت ورودی پرونده("z.bin"، big.داده، big.طول، نادرست))
    ناپایا zbuf := بایگانی.ساخت بایگانی در بافر(بایگانی.قالب تار، bf، st)
    ناپایا gz := فشرده سازی.فشرده سازی جی زیپ بافر(zbuf)
