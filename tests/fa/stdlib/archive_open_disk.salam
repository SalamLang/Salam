بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع files(): وکتور<بایگانی.ورودی پرونده>:
    ناپایا v := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    v.بیفزا(بایگانی.ساخت ورودی پرونده("docs/"، پوچ، 0، درست))
    v.بیفزا(بایگانی.ساخت ورودی پرونده("docs/a.txt"، "hello hello hello hello" برگردان تهی*، 23، نادرست))
    v.بیفزا(بایگانی.ساخت ورودی پرونده("b.txt"، "bee" برگردان تهی*، 3، نادرست))
    برگشت v
پایان

تابع drop(p: رشته):
    حافظه.آزادسازی(p برگردان تهی*)
پایان

تابع has(a: رشته، b: رشته): منطقی:
    p := مسیر پرونده.پیوند(a، b)
    r := سیستم عامل.وجود دارد(p)
    drop(p)
    برگشت r
پایان

تابع one(dir: رشته، ext: رشته):
    pname := "pack." + ext
    path := مسیر پرونده.پیوند(dir، pname)
    ناپایا fs := files()
    سرچاپ ext، بایگانی.ساخت بایگانی(path، fs)
    fs.آزادکن()
    ناپایا arc := بایگانی.بازکردن پرونده بایگانی(path، "")
    سرچاپ "  open"، بایگانی.نام قالب(arc.قالب)، arc.وضعیت، arc.روی دیسک نابرابر 0، arc.داده برابر پوچ
    ناپایا es := بایگانی.فهرست بایگانی(arc)
    سرچاپ "  list"، es.طول()، arc.وضعیت
    بایگانی.آزادسازی فهرست(es)
    ناپایا data := بایگانی.خواندن از بایگانی(arc، "docs/a.txt")
    text := فشرده سازی.بافر به رشته(data)
    سرچاپ "  read"، text، arc.وضعیت
    drop(text)
    فشرده سازی.آزادسازی بافر(data)
    ناپایا none := بایگانی.خواندن از بایگانی(arc، "missing")
    سرچاپ "  missing"، none.طول، arc.وضعیت
    فشرده سازی.آزادسازی بافر(none)
    odir := "one_" + ext
    one_dir := مسیر پرونده.پیوند(dir، odir)
    سرچاپ "  extract"، بایگانی.استخراج یک مدخل(arc، "b.txt"، one_dir)، has(one_dir، "b.txt")
    adir := "all_" + ext
    all_dir := مسیر پرونده.پیوند(dir، adir)
    سرچاپ "  all"، بایگانی.استخراج همه از بایگانی(arc، all_dir)، arc.وضعیت، has(all_dir، "docs/a.txt")
    ناپایا lim := بایگانی.سقف های پیش فرض()
    lim.بیشینه اندازه مدخل = 5 برگردان صحیح۶۴
    بایگانی.تنظیم سقف ها(arc، lim)
    ldir := "lim_" + ext
    lim_dir := مسیر پرونده.پیوند(dir، ldir)
    سرچاپ "  limit"، بایگانی.استخراج همه از بایگانی(arc، lim_dir)، arc.وضعیت
    بایگانی.بستن بایگانی(arc)
    ناپایا st := 0
    ناپایا listed := بایگانی.فهرست پرونده بایگانی(path، ""، st)
    سرچاپ "  listfile"، listed.طول()، st
    بایگانی.آزادسازی فهرست(listed)
    edir := "ef_" + ext
    ef_dir := مسیر پرونده.پیوند(dir، edir)
    سرچاپ "  extractfile"، بایگانی.استخراج پرونده بایگانی(path، ef_dir، ""، st)، st
    drop(pname)
    drop(path)
    drop(odir)
    drop(one_dir)
    drop(adir)
    drop(all_dir)
    drop(ldir)
    drop(lim_dir)
    drop(edir)
    drop(ef_dir)
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_open_disk_demo")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    one(dir، "zip")
    one(dir، "tar")
    one(dir، "tgz")
    one(dir، "7z")
    one(dir، "rar")
    gz := مسیر پرونده.پیوند(dir، "single.txt.gz")
    ناپایا fs := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    fs.بیفزا(بایگانی.ساخت ورودی پرونده("single.txt"، "just one file" برگردان تهی*، 13، نادرست))
    سرچاپ بایگانی.ساخت بایگانی(gz، fs)
    fs.آزادکن()
    ناپایا arc := بایگانی.بازکردن پرونده بایگانی(gz، "")
    سرچاپ بایگانی.نام قالب(arc.قالب)، arc.وضعیت، arc.روی دیسک نابرابر 0
    بایگانی.بستن بایگانی(arc)
    bad := مسیر پرونده.پیوند(dir، "junk.zip")
    ناپایا text := فشرده سازی.بافر از رشته("this is not a zip file at all, only some text")
    بایگانی.نوشتن پرونده دودویی از بافر(bad، text)
    فشرده سازی.آزادسازی بافر(text)
    ناپایا junk := بایگانی.بازکردن پرونده بایگانی(bad، "")
    سرچاپ بایگانی.متن وضعیت بایگانی(junk.وضعیت)
    بایگانی.بستن بایگانی(junk)
    سرچاپ بایگانی.تشخیص قالب("PK\x03\x04" برگردان تهی*، 4) برابر بایگانی.قالب زیپ
    سیستم عامل.حذف همه(dir)
    drop(gz)
    drop(bad)
    drop(dir)
پایان
