بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع has(a: رشته، b: رشته): منطقی:
    p := مسیر پرونده.پیوند(a، b)
    r := سیستم عامل.وجود دارد(p)
    حافظه.آزادسازی(p برگردان تهی*)
    برگشت r
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_tgzs_demo_fa")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    path := مسیر پرونده.پیوند(dir، "big.tgz")
    size := 40000000
    zeros := حافظه.تخصیص صفرشده(size برگردان طبیعی۶۴)
    ناپایا fs := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    fs.بیفزا(بایگانی.ساخت ورودی پرونده("first.txt"، "first entry" برگردان تهی*، 11، نادرست))
    fs.بیفزا(بایگانی.ساخت ورودی پرونده("zeros.bin"، zeros، size، نادرست))
    fs.بیفزا(بایگانی.ساخت ورودی پرونده("last.txt"، "last entry" برگردان تهی*، 10، نادرست))
    سرچاپ "create"، بایگانی.ساخت بایگانی(path، fs)
    fs.آزادکن()
    حافظه.آزادسازی(zeros)

    ناپایا arc := بایگانی.بازکردن پرونده بایگانی(path، "")
    سرچاپ "open"، بایگانی.نام قالب(arc.قالب)، arc.وضعیت، arc.روی دیسک نابرابر 0، arc.پرونده موقت.طول()
    ناپایا es := بایگانی.فهرست بایگانی(arc)
    سرچاپ "list"، es.طول()، arc.وضعیت
    هر e در es:
        سرچاپ e.نام، e.اندازه
    پایان
    بایگانی.آزادسازی فهرست(es)
    ناپایا first := بایگانی.خواندن از بایگانی(arc، "last.txt")
    سرچاپ "read"، فشرده سازی.بافر به رشته(first)، arc.وضعیت
    فشرده سازی.آزادسازی بافر(first)
    ناپایا none := بایگانی.خواندن از بایگانی(arc، "missing")
    سرچاپ "missing"، none.طول، arc.وضعیت
    فشرده سازی.آزادسازی بافر(none)
    one := مسیر پرونده.پیوند(dir، "one")
    سرچاپ "extract"، بایگانی.استخراج یک مدخل(arc، "zeros.bin"، one)، has(one، "zeros.bin")
    all := مسیر پرونده.پیوند(dir، "all")
    سرچاپ "all"، بایگانی.استخراج همه از بایگانی(arc، all)، arc.وضعیت، has(all، "first.txt")، has(all، "last.txt")

    ناپایا lim := بایگانی.سقف های پیش فرض()
    lim.بیشینه اندازه کل = 1000000 برگردان صحیح۶۴
    بایگانی.تنظیم سقف ها(arc، lim)
    ناپایا capped := بایگانی.فهرست بایگانی(arc)
    سرچاپ "total cap"، capped.طول()، arc.وضعیت
    بایگانی.آزادسازی فهرست(capped)
    lim.بیشینه اندازه کل = 4294967296 برگردان صحیح۶۴
    lim.بیشینه اندازه مدخل = 1000000 برگردان صحیح۶۴
    بایگانی.تنظیم سقف ها(arc، lim)
    سرچاپ "entry cap"، بایگانی.استخراج یک مدخل(arc، "zeros.bin"، مسیر پرونده.پیوند(dir، "capped"))، arc.وضعیت
    بایگانی.بستن بایگانی(arc)

    ناپایا rok := نادرست
    ناپایا packed := بایگانی.خواندن پرونده دودویی(path، rok)
    سرچاپ "bytes"، rok، packed.طول بزرگتر 100
    ناپایا raw := packed.داده برگردان طبیعی۸*
    at := packed.طول - 12
    raw[at] = ((raw[at] برگردان صحیح) ^ 255) برگردان طبیعی۸
    سرچاپ "rewrite"، بایگانی.نوشتن پرونده دودویی از بافر(path، packed)
    فشرده سازی.آزادسازی بافر(packed)
    ناپایا bad := بایگانی.بازکردن پرونده بایگانی(path، "")
    سرچاپ "bad open"، bad.وضعیت، bad.روی دیسک نابرابر 0
    ناپایا head := بایگانی.خواندن از بایگانی(bad، "first.txt")
    سرچاپ "early"، فشرده سازی.بافر به رشته(head)، bad.وضعیت
    فشرده سازی.آزادسازی بافر(head)
    ناپایا tail := بایگانی.خواندن از بایگانی(bad، "last.txt")
    سرچاپ "late"، tail.طول، bad.وضعیت
    فشرده سازی.آزادسازی بافر(tail)
    بایگانی.بستن بایگانی(bad)
    سیستم عامل.حذف همه(dir)
    حافظه.آزادسازی(path برگردان تهی*)
    حافظه.آزادسازی(dir برگردان تهی*)
پایان
