پایا CONTAINERS := [1، 2، 3، 4، 5، 12، 10، 9]

ساختار Item:
    همگانی name: رشته = ""
    همگانی data: رشته = ""
    همگانی link: رشته = ""
    همگانی kind: صحیح = 0
    همگانی raw: تهی* = پوچ
    همگانی n: صحیح = 0
پایان

تابع hexv(c: صحیح): صحیح:
    اگر c بزرگتربرابر 97: برگشت c - 87 پایان
    برگشت c - 48
پایان

تابع unhex(h: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := h برگردان طبیعی۸*
    ناپایا i := 0
    تا i کوچکتر h.طول():
        c := bp[i] برگردان صحیح
        اگر (c بزرگتربرابر 48 و c کوچکتربرابر 57) یا (c بزرگتربرابر 97 و c کوچکتربرابر 102):
            اگر i + 1 کوچکتر h.طول():
                فشرده سازی.افزودن بایت(b، hexv(c) * 16 + hexv(bp[i + 1] برگردان صحیح))
            پایان
            i += 2
        وگرنه:
            i++
        پایان
    پایان
    برگشت b
پایان

تابع file(name: رشته، data: رشته): Item:
    برگشت Item { name = name، data = data، raw = data برگردان تهی*، n = data.طول() }
پایان

تابع sym(name: رشته، target: رشته): Item:
    برگشت Item { name = name، link = target، kind = 1 }
پایان

تابع hard(name: رشته، target: رشته): Item:
    برگشت Item { name = name، link = target، kind = 2 }
پایان

تابع has(dir: رشته، rel: رشته): منطقی:
    p := مسیر پرونده.پیوند(dir، rel)
    r := سیستم عامل.وجود دارد(p)
    حافظه.آزادسازی(p برگردان تهی*)
    برگشت r
پایان

تابع ext(fmt: صحیح): رشته:
    اگر fmt برابر 1: برگشت ".zip" پایان
    اگر fmt برابر 2: برگشت ".tar" پایان
    اگر fmt برابر 3: برگشت ".tar.gz" پایان
    اگر fmt برابر 4: برگشت ".tar.bz2" پایان
    اگر fmt برابر 5: برگشت ".tar.xz" پایان
    اگر fmt برابر 12: برگشت ".tar.zst" پایان
    اگر fmt برابر 10: برگشت ".7z" پایان
    اگر fmt برابر 9: برگشت ".rar" پایان
    اگر fmt برابر 6: برگشت ".gz" پایان
    اگر fmt برابر 7: برگشت ".bz2" پایان
    اگر fmt برابر 8: برگشت ".xz" پایان
    برگشت ".zst"
پایان

تابع tag(prefix: رشته، fmt: صحیح، n: صحیح): رشته:
    برگشت prefix + " " + بایگانی.نام قالب(fmt) + " " + رشته.از عدد(n برگردان صحیح۶۴)
پایان

تابع pack_stream(fmt: صحیح، data: تهی*، n: صحیح): فشرده سازی.بافر بایت:
    اگر fmt برابر 6: برگشت فشرده سازی.فشرده سازی جی زیپ(data، n) پایان
    اگر fmt برابر 7: برگشت فشرده سازی.فشرده سازی بی زیپ دو(data، n) پایان
    اگر fmt برابر 8: برگشت فشرده سازی.فشرده سازی ایکس زد(data، n) پایان
    برگشت فشرده سازی.فشرده سازی زستد(data، n)
پایان

تابع build(fmt: صحیح، items: وکتور<Item>): فشرده سازی.بافر بایت:
    اگر fmt برابر 1:
        ناپایا zs := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
        هر it در items:
            اگر it.kind برابر 0: zs.بیفزا(بایگانی.ساخت ورودی پرونده زیپ(it.name، it.raw، it.n، 8)) پایان
        پایان
        out := بایگانی.ساخت زیپ(zs)
        zs.آزادکن()
        برگشت out
    پایان
    اگر fmt برابر 10:
        ناپایا ss := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
        هر it در items:
            ناپایا si := بایگانی.ساخت ورودی پرونده هفت زد(it.name، it.raw، it.n، نادرست)
            اگر it.kind برابر 1: si.پیوند = it.link پایان
            اگر it.kind نابرابر 2: ss.بیفزا(si) پایان
        پایان
        out := بایگانی.ساخت هفت زد(ss)
        ss.آزادکن()
        برگشت out
    پایان
    اگر fmt برابر 9:
        ناپایا rs := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده آر ای آر>
        هر it در items:
            اگر it.kind برابر 0: rs.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر(it.name، it.raw، it.n، نادرست)) پایان
        پایان
        out := بایگانی.ساخت آر ای آر(rs)
        rs.آزادکن()
        برگشت out
    پایان
    ناپایا ts := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    هر it در items:
        اگر it.kind برابر 1:
            ts.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار(it.name، it.link))
        وگرنه it.kind برابر 2:
            ts.بیفزا(بایگانی.ساخت ورودی پیوند سخت تار(it.name، it.link))
        وگرنه:
            ts.بیفزا(بایگانی.ساخت ورودی پرونده تار(it.name، it.raw، it.n، نادرست))
        پایان
    پایان
    ناپایا tar := بایگانی.ساخت تار(ts)
    ts.آزادکن()
    اگر fmt برابر 2: برگشت tar پایان
    ناپایا out := فشرده سازی.بافر بایت جدید()
    اگر fmt برابر 3:
        out = فشرده سازی.فشرده سازی جی زیپ بافر(tar)
    وگرنه fmt برابر 4:
        out = فشرده سازی.فشرده سازی بی زیپ دو بافر(tar)
    وگرنه fmt برابر 5:
        out = فشرده سازی.فشرده سازی ایکس زد بافر(tar)
    وگرنه:
        out = فشرده سازی.فشرده سازی زستد بافر(tar)
    پایان
    فشرده سازی.آزادسازی بافر(tar)
    برگشت out
پایان

تابع attempt(label: رشته، buf: فشرده سازی.بافر بایت، fmt: صحیح، lim: بایگانی.سقف ها، disk: منطقی، root: رشته):
    dest := مسیر پرونده.پیوند(root، "d")
    سیستم عامل.حذف همه(dest)
    ناپایا path := ""
    ناپایا arc := بایگانی.بایگانی {}
    اگر disk:
        path = مسیر پرونده.پیوند(root، "in" + ext(fmt))
        _ := بایگانی.نوشتن پرونده دودویی از بافر(path، buf)
        arc = بایگانی.بازکردن پرونده بایگانی(path، "")
        بایگانی.تنظیم سقف ها(arc، lim)
    وگرنه:
        arc = بایگانی.بازکردن با سقف(buf.داده، buf.طول، ""، lim)
    پایان
    n := بایگانی.استخراج همه از بایگانی(arc، dest)
    st := arc.وضعیت
    ناپایا es := بایگانی.فهرست بایگانی(arc)
    ناپایا rd := 0
    اگر es.طول() بزرگتر 0:
        ناپایا got := بایگانی.خواندن از بایگانی(arc، es.بگیر(0).نام)
        rd = arc.وضعیت
        فشرده سازی.آزادسازی بافر(got)
    پایان
    بایگانی.آزادسازی فهرست(es)
    بایگانی.بستن بایگانی(arc)
    سرچاپ label، disk ? "disk" : "mem"، "files"، n، "status"، st، "read"، rd
    اگر disk:
        سیستم عامل.حذف(path)
        حافظه.آزادسازی(path برگردان تهی*)
    پایان
    سیستم عامل.حذف همه(dest)
    حافظه.آزادسازی(dest برگردان تهی*)
پایان

تابع slip_names(): وکتور<رشته>:
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.بیفزا("../evil.txt")
    v.بیفزا("a/../../evil.txt")
    v.بیفزا("/salam_safe_abs.txt")
    v.بیفزا("C:\\salam_safe_win.txt")
    v.بیفزا("..\\evil.txt")
    v.بیفزا("x\\..\\..\\evil.txt")
    برگشت v
پایان

تابع stray(dir: رشته): منطقی:
    bad := has(dir، "evil.txt")
    ev := مسیر پرونده.پیوند(dir، "evil.txt")
    سیستم عامل.حذف(ev)
    حافظه.آزادسازی(ev برگردان تهی*)
    برگشت bad
پایان

تابع escaped(root: رشته): منطقی:
    parent := مسیر پرونده.پوشه(root)
    ناپایا bad := stray(root)
    اگر stray(parent):
        bad = درست
    پایان
    حافظه.آزادسازی(parent برگردان تهی*)
    اگر سیستم عامل.وجود دارد("/salam_safe_abs.txt"):
        bad = درست
        سیستم عامل.حذف("/salam_safe_abs.txt")
    پایان
    برگشت bad
پایان

تابع zip_slip(root: رشته):
    names := slip_names()
    هر fmt در CONTAINERS:
        ناپایا i := 0
        تا i کوچکتر names.طول():
            ناپایا items := وکتور {} برگردان وکتور<Item>
            items.بیفزا(file("ok.txt"، "fine fine fine fine"))
            items.بیفزا(file(names.بگیر(i)، "bad bad bad bad"))
            ناپایا buf := build(fmt، items)
            label := tag("slip"، fmt، i)
            attempt(label، buf، fmt، بایگانی.سقف های پیش فرض()، نادرست، root)
            attempt(label، buf، fmt، بایگانی.سقف های پیش فرض()، درست، root)
            سرچاپ "  escaped"، escaped(root)
            فشرده سازی.آزادسازی بافر(buf)
            items.آزادکن()
            i++
        پایان
    پایان
پایان

تابع link_cases(root: رشته):
    ناپایا sets := وکتور {} برگردان وکتور<وکتور<Item>>
    ناپایا a := وکتور {} برگردان وکتور<Item>
    a.بیفزا(sym("l"، "../../etc"))
    sets.بیفزا(a)
    ناپایا b := وکتور {} برگردان وکتور<Item>
    b.بیفزا(sym("l"، "/etc"))
    sets.بیفزا(b)
    ناپایا c := وکتور {} برگردان وکتور<Item>
    c.بیفزا(hard("h"، "../evil.txt"))
    sets.بیفزا(c)
    ناپایا d := وکتور {} برگردان وکتور<Item>
    d.بیفزا(hard("h"، "/etc/passwd"))
    sets.بیفزا(d)
    ناپایا e := وکتور {} برگردان وکتور<Item>
    e.بیفزا(sym("d"، "sub"))
    e.بیفزا(file("d/x.txt"، "through"))
    sets.بیفزا(e)
    ناپایا f := وکتور {} برگردان وکتور<Item>
    f.بیفزا(sym("up"، ".."))
    f.بیفزا(file("up/evil.txt"، "through"))
    sets.بیفزا(f)
    ناپایا g := وکتور {} برگردان وکتور<Item>
    g.بیفزا(file("ok.txt"، "fine"))
    g.بیفزا(sym("fine"، "ok.txt"))
    sets.بیفزا(g)
    هر fmt در [2، 3، 4، 5، 12، 10]:
        ناپایا i := 0
        تا i کوچکتر sets.طول():
            اگر fmt برابر 10 و (i برابر 2 یا i برابر 3):
                i++
                گذر
            پایان
            ناپایا buf := build(fmt، sets.بگیر(i))
            label := tag("link"، fmt، i)
            attempt(label، buf، fmt، بایگانی.سقف های پیش فرض()، نادرست، root)
            attempt(label، buf، fmt، بایگانی.سقف های پیش فرض()، درست، root)
            سرچاپ "  escaped"، escaped(root)
            فشرده سازی.آزادسازی بافر(buf)
            i++
        پایان
    پایان
    هر hex در [EVIL5، SYM4]:
        ناپایا buf := unhex(hex)
        attempt("link rar"، buf، 9، بایگانی.سقف های پیش فرض()، نادرست، root)
        attempt("link rar"، buf، 9، بایگانی.سقف های پیش فرض()، درست، root)
        سرچاپ "  escaped"، escaped(root)
        فشرده سازی.آزادسازی بافر(buf)
    پایان
    ناپایا k := 0
    تا k کوچکتر sets.طول():
        sets.بگیر(k).آزادکن()
        k++
    پایان
    sets.آزادکن()
پایان

تابع zeros(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا z := فشرده سازی.بافر بایت جدید()
    ناپایا chunk := فشرده سازی.بافر بایت جدید()
    تکرار 4096:
        فشرده سازی.افزودن بایت(chunk، 0)
    پایان
    تکرار n / 4096:
        فشرده سازی.افزودن بافر(z، chunk)
    پایان
    فشرده سازی.آزادسازی بافر(chunk)
    برگشت z
پایان

تابع bomb_cases(root: رشته):
    ناپایا big := zeros(3145728)
    هر fmt در [1، 2، 3، 4، 5، 12، 10، 9، 6، 7، 8، 11]:
        ناپایا buf := فشرده سازی.بافر بایت جدید()
        اگر fmt برابر 6 یا fmt برابر 7 یا fmt برابر 8 یا fmt برابر 11:
            buf = pack_stream(fmt، big.داده، big.طول)
        وگرنه:
            ناپایا items := وکتور {} برگردان وکتور<Item>
            items.بیفزا(Item { name = "zeros.bin"، raw = big.داده، n = big.طول })
            buf = build(fmt، items)
            items.آزادکن()
        پایان
        ناپایا lim := بایگانی.سقف های پیش فرض()
        lim.بیشینه نسبت فشرده سازی = 10
        attempt(tag("ratio"، fmt، 0)، buf، fmt، lim، نادرست، root)
        attempt(tag("ratio"، fmt، 0)، buf، fmt، lim، درست، root)
        lim = بایگانی.سقف های پیش فرض()
        lim.بیشینه اندازه کل = 1000000 برگردان صحیح۶۴
        attempt(tag("total"، fmt، 0)، buf، fmt، lim، نادرست، root)
        attempt(tag("total"، fmt، 0)، buf، fmt، lim، درست، root)
        lim = بایگانی.سقف های پیش فرض()
        lim.بیشینه اندازه مدخل = 1000000 برگردان صحیح۶۴
        attempt(tag("entry"، fmt، 0)، buf، fmt، lim، نادرست، root)
        attempt(tag("entry"، fmt، 0)، buf، fmt، lim، درست، root)
        lim = بایگانی.سقف های پیش فرض()
        attempt(tag("plain"، fmt، 0)، buf، fmt، lim، نادرست، root)
        فشرده سازی.آزادسازی بافر(buf)
    پایان
    فشرده سازی.آزادسازی بافر(big)
پایان

تابع many_cases(root: رشته):
    هر fmt در CONTAINERS:
        ناپایا items := وکتور {} برگردان وکتور<Item>
        ناپایا i := 0
        تا i کوچکتر 40:
            items.بیفزا(file("f" + رشته.از عدد(i برگردان صحیح۶۴) + ".txt"، "x"))
            i++
        پایان
        ناپایا buf := build(fmt، items)
        ناپایا lim := بایگانی.سقف های پیش فرض()
        lim.بیشینه مدخل = 10
        attempt(tag("count"، fmt، 0)، buf، fmt، lim، نادرست، root)
        attempt(tag("count"، fmt، 0)، buf، fmt، lim، درست، root)
        lim.بیشینه مدخل = 40
        attempt(tag("count ok"، fmt، 0)، buf، fmt، lim، نادرست، root)
        attempt(tag("count ok"، fmt، 0)، buf، fmt، lim، درست، root)
        فشرده سازی.آزادسازی بافر(buf)
        items.آزادکن()
    پایان
پایان

تابع poke(fmt: صحیح، buf: فشرده سازی.بافر بایت، disk: منطقی، root: رشته): صحیح:
    ناپایا lim := بایگانی.سقف های پیش فرض()
    lim.بیشینه اندازه کل = 4194304 برگردان صحیح۶۴
    lim.بیشینه اندازه مدخل = 2097152 برگردان صحیح۶۴
    dest := مسیر پرونده.پیوند(root، "d")
    سیستم عامل.حذف همه(dest)
    ناپایا path := ""
    ناپایا arc := بایگانی.بایگانی {}
    اگر disk:
        path = مسیر پرونده.پیوند(root، "in" + ext(fmt))
        _ := بایگانی.نوشتن پرونده دودویی از بافر(path، buf)
        arc = بایگانی.بازکردن پرونده بایگانی(path، "")
        بایگانی.تنظیم سقف ها(arc، lim)
    وگرنه:
        arc = بایگانی.بازکردن با سقف(buf.داده، buf.طول، ""، lim)
    پایان
    ناپایا es := بایگانی.فهرست بایگانی(arc)
    ناپایا k := 0
    تا k کوچکتر es.طول() و k کوچکتر 4:
        ناپایا got := بایگانی.خواندن از بایگانی(arc، es.بگیر(k).نام)
        فشرده سازی.آزادسازی بافر(got)
        k++
    پایان
    بایگانی.آزادسازی فهرست(es)
    _ := بایگانی.استخراج همه از بایگانی(arc، dest)
    st := arc.وضعیت
    بایگانی.بستن بایگانی(arc)
    اگر disk:
        سیستم عامل.حذف(path)
        حافظه.آزادسازی(path برگردان تهی*)
    پایان
    سیستم عامل.حذف همه(dest)
    حافظه.آزادسازی(dest برگردان تهی*)
    برگشت st
پایان

تابع corrupt_cases(root: رشته):
    هر fmt در [1، 2، 3، 4، 5، 12، 10، 9، 6، 7، 8، 11]:
        ناپایا items := وکتور {} برگردان وکتور<Item>
        items.بیفزا(file("docs/a.txt"، "hello hello hello hello hello hello"))
        items.بیفزا(file("b.bin"، "0123456789abcdef0123456789abcdef"))
        ناپایا buf := فشرده سازی.بافر بایت جدید()
        اگر fmt برابر 6 یا fmt برابر 7 یا fmt برابر 8 یا fmt برابر 11:
            buf = pack_stream(fmt، "hello hello hello hello hello" برگردان تهی*، 29)
        وگرنه:
            buf = build(fmt، items)
        پایان
        ناپایا runs := 0
        ناپایا nothing := فشرده سازی.بافر بایت جدید()
        empty := poke(fmt، nothing، نادرست، root)
        فشرده سازی.آزادسازی بافر(nothing)
        ناپایا cut := 1
        تا cut کوچکتر 16:
            ناپایا part := فشرده سازی.کپی بافر(buf)
            part.طول = buf.طول * cut / 16
            _ := poke(fmt، part، نادرست، root)
            _ := poke(fmt، part، درست، root)
            runs += 2
            فشرده سازی.آزادسازی بافر(part)
            cut++
        پایان
        ناپایا pos := 0
        تا pos کوچکتر buf.طول:
            ناپایا flip := فشرده سازی.کپی بافر(buf)
            p := flip.داده برگردان طبیعی۸*
            p[pos] = ((p[pos] برگردان صحیح) ^ 255) برگردان طبیعی۸
            _ := poke(fmt، flip، نادرست، root)
            runs++
            فشرده سازی.آزادسازی بافر(flip)
            pos += 1 + buf.طول / 40
        پایان
        سرچاپ tag("corrupt"، fmt، 0)، "empty bad"، empty نابرابر 0، "runs"، runs
        فشرده سازی.آزادسازی بافر(buf)
        items.آزادکن()
    پایان
پایان

تابع ریشه:
    root := مسیر پرونده.پیوند(مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_safety")، "r")
    parent := مسیر پرونده.پوشه(root)
    سیستم عامل.حذف همه(parent)
    بایگانی.اطمینان از پوشه(root)
    سرچاپ "== zip slip"
    zip_slip(root)
    سرچاپ "== links"
    link_cases(root)
    سرچاپ "== bombs"
    bomb_cases(root)
    سرچاپ "== entry count"
    many_cases(root)
    سرچاپ "== corrupt"
    corrupt_cases(root)
    سیستم عامل.حذف همه(parent)
    حافظه.آزادسازی(root برگردان تهی*)
    حافظه.آزادسازی(parent برگردان تهی*)
پایان
