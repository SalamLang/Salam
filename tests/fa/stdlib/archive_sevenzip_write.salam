// زبان: فارسی
بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی آزمایش
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه

تابع make_data(n: صحیح، seed: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = (x * 1103515245 + 12345) & 0x7fffffff
        اگر (n / 300) % 2 برابر 0:
            فشرده سازی.افزودن بایت(b، 97 + (x >> 16) % 5)
        وگرنه:
            فشرده سازی.افزودن بایت(b، 32 + (x >> 16) % 90)
        پایان
    پایان
    برگشت b
پایان

تابع same_file(path: رشته، want: فشرده سازی.بافر بایت، len: صحیح): منطقی:
    ناپایا ok := نادرست
    ناپایا got := بایگانی.خواندن پرونده دودویی(path، ok)
    r := ok و got.طول برابر len و فشرده سازی.چک جمع سی آر سی(got.داده، len) برابر فشرده سازی.چک جمع سی آر سی(want.داده، len)
    فشرده سازی.آزادسازی بافر(got)
    برگشت r
پایان

تابع check_file(arc: رشته، dir: رشته، a: فشرده سازی.بافر بایت، b: فشرده سازی.بافر بایت):
    ناپایا sf := بایگانی.بازکردن پرونده هفت زد(arc، "")
    آزمایش.ادعای برابری عدد(sf.وضعیت، 0)
    dest := مسیر پرونده.پیوند(dir، "got.bin")
    آزمایش.ادعای برابری عدد(بایگانی.استخراج از پرونده هفت زد به پرونده(sf، "dir/path.txt"، dest، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)، 0)
    آزمایش.ادعای درستی(same_file(dest، a، a.طول))
    آزمایش.ادعای برابری عدد(بایگانی.استخراج از پرونده هفت زد به پرونده(sf، "mem.txt"، dest، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)، 0)
    آزمایش.ادعای درستی(same_file(dest، b، b.طول))
    آزمایش.ادعای برابری عدد(بایگانی.استخراج از پرونده هفت زد به پرونده(sf، "tiny.txt"، dest، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)، 0)
    ناپایا rok := نادرست
    ناپایا tiny := بایگانی.خواندن پرونده دودویی(dest، rok)
    آزمایش.ادعای درستی(rok و فشرده سازی.بافر به رشته(tiny) برابر "hi")
    فشرده سازی.آزادسازی بافر(tiny)
    بایگانی.بستن پرونده هفت زد(sf)
    سیستم عامل.حذف(dest)
پایان

تابع check_mem(arc: رشته، a: فشرده سازی.بافر بایت، b: فشرده سازی.بافر بایت):
    ناپایا rok := نادرست
    ناپایا whole := بایگانی.خواندن پرونده دودویی(arc، rok)
    آزمایش.ادعای درستی(rok)
    ناپایا ok := نادرست
    ناپایا one := بایگانی.استخراج با نام از هفت زد(whole.داده، whole.طول، "dir/path.txt"، ok)
    آزمایش.ادعای درستی(ok و one.طول برابر a.طول و فشرده سازی.چک جمع سی آر سی(one.داده، one.طول) برابر فشرده سازی.چک جمع سی آر سی(a.داده، a.طول))
    فشرده سازی.آزادسازی بافر(one)
    ناپایا two := بایگانی.استخراج با نام از هفت زد(whole.داده، whole.طول، "mem.txt"، ok)
    آزمایش.ادعای درستی(ok و two.طول برابر b.طول و فشرده سازی.چک جمع سی آر سی(two.داده، two.طول) برابر فشرده سازی.چک جمع سی آر سی(b.داده، b.طول))
    فشرده سازی.آزادسازی بافر(two)
    ناپایا three := بایگانی.استخراج با نام از هفت زد(whole.داده، whole.طول، "tiny.txt"، ok)
    آزمایش.ادعای درستی(ok و فشرده سازی.بافر به رشته(three) برابر "hi")
    فشرده سازی.آزادسازی بافر(three)
    ents := بایگانی.فهرست هفت زد(whole.داده، whole.طول)
    آزمایش.ادعای برابری عدد(ents.طول()، 5)
    فشرده سازی.آزادسازی بافر(whole)
پایان

تابع ریشه(): صحیح:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sevenzip_write_test")
    دیرکن حافظه.آزادسازی(dir برگردان تهی*)
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)

    ناپایا a := make_data(60000، 1)
    ناپایا b := make_data(9000، 2)
    src := مسیر پرونده.پیوند(dir، "a.in")
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی(src، a.داده، a.طول))

    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("dir/"، پوچ، 0، درست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد از مسیر("dir/path.txt"، src))
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("mem.txt"، b.داده، b.طول، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("empty.txt"، پوچ، 0، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("tiny.txt"، "hi" برگردان تهی*، 2، نادرست))

    هر lv در [0، 1، 5، 9، 40]:
        arc := مسیر پرونده.پیوند(dir، "level.7z")
        آزمایش.ادعای درستی(بایگانی.ساخت پرونده هفت زد با سطح(files، arc، lv))
        check_file(arc، dir، a، b)
        check_mem(arc، a، b)
        ناپایا packed := بایگانی.ساخت هفت زد با سطح(files، lv)
        آزمایش.ادعای درستی(packed.طول بزرگتر 32)
        ناپایا ok := نادرست
        ناپایا one := بایگانی.استخراج با نام از هفت زد(packed.داده، packed.طول، "dir/path.txt"، ok)
        آزمایش.ادعای درستی(ok و one.طول برابر a.طول)
        فشرده سازی.آزادسازی بافر(one)
        اگر lv بزرگتر 0:
            آزمایش.ادعای درستی(packed.طول کوچکتر a.طول)
        پایان
        فشرده سازی.آزادسازی بافر(packed)
    پایان

    plain := مسیر پرونده.پیوند(dir، "plain.7z")
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده هفت زد(files، plain))
    ناپایا stored := بایگانی.ساخت هفت زد(files)
    آزمایش.ادعای درستی(stored.طول بزرگتر a.طول + b.طول)
    فشرده سازی.آزادسازی بافر(stored)

    ناپایا bad := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    bad.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("ok.txt"، b.داده، b.طول، نادرست))
    bad.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد از مسیر("gone.txt"، مسیر پرونده.پیوند(dir، "no_such_input")))
    never := مسیر پرونده.پیوند(dir، "never.7z")
    آزمایش.ادعای نادرستی(بایگانی.ساخت پرونده هفت زد(bad، never))
    آزمایش.ادعای نادرستی(سیستم عامل.وجود دارد(never))
    آزمایش.ادعای نادرستی(بایگانی.ساخت پرونده هفت زد با سطح(bad، never، 5))
    آزمایش.ادعای نادرستی(سیستم عامل.وجود دارد(never))
    ناپایا none := بایگانی.ساخت هفت زد با سطح(bad، 3)
    آزمایش.ادعای برابری عدد(none.طول، 0)
    فشرده سازی.آزادسازی بافر(none)

    فشرده سازی.آزادسازی بافر(a)
    فشرده سازی.آزادسازی بافر(b)
    سیستم عامل.حذف همه(dir)
    برگشت آزمایش.خلاصه()
پایان
