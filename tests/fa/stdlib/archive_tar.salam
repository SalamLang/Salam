بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل
واردسازی سیستم پرونده
واردسازی مسیر پرونده

تابع hex_val(c: صحیح): صحیح:
    اگر c بزرگتربرابر 97: برگشت c - 87 پایان
    برگشت c - 48
پایان

تابع unhex(h: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := h برگردان طبیعی۸*
    ناپایا i := 0
    تا i + 1 کوچکتر h.طول():
        فشرده سازی.افزودن بایت(b، hex_val(bp[i] برگردان صحیح) * 16 + hex_val(bp[i + 1] برگردان صحیح))
        i += 2
    پایان
    برگشت b
پایان

تابع short(s: رشته): رشته:
    اگر s.طول() بزرگتر 40:
        برگشت s.زیررشته(0، 12) + "..." + s.زیررشته(s.طول() - 12، 12)
    پایان
    برگشت s
پایان

تابع show(label: رشته، gz: رشته):
    ناپایا z := unhex(gz)
    ناپایا ok := نادرست
    ناپایا es := بایگانی.فهرست تار جی زیپ(z.داده، z.طول، ok)
    سرچاپ "=="، label، ok، es.طول()
    هر e در es:
        سرچاپ e.نوع، e.پوشه، e.نام.طول()، short(e.نام)، e.پیوند.طول()، short(e.پیوند)، e.اندازه، e.زمان تغییر، e.دسترسی
    پایان
    بایگانی.آزادسازی فهرست(es)
    فشرده سازی.آزادسازی بافر(z)
پایان

تابع read_text(path: رشته): رشته:
    ناپایا ok := نادرست
    b := بایگانی.خواندن پرونده دودویی(path، ok)
    اگر وارونه ok: برگشت "missing" پایان
    برگشت فشرده سازی.بافر به رشته(b)
پایان

تابع ریشه:
    show("gnu"، "")
    show("ustar"، "1f8b08000000000002ff4bd62ba92861a02d300002331313300d04e834109833189a981a99989b1b981818311898189a9a1b31281830d0019416972416019d426d7313a902f493a802703bb3a028352db3828b61148c8251300a46c1c802008e3757a100080000")
    show("pax"، "")
    show("global"، "")
    show("7z"، "1f8b08000000000002ff2b4e2d4bcdd32ba92861a01d300002331313300d04e8344896c1d0d4c8dcc4c8d0d004c836303037333266503060a003282d2e492c52506018a1a01814ff5c0ca360148c8251300a4618000018cd7efb00080000")

    root := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_tar_extra_fa")
    سیستم عامل.حذف همه(root)
    gz := unhex("")
    out1 := مسیر پرونده.پیوند(root، "gnu")
    سرچاپ بایگانی.استخراج همه از تار جی زیپ(gz.داده، gz.طول، out1)
    سرچاپ read_text(مسیر پرونده.پیوند(out1، "a.txt"))، read_text(مسیر پرونده.پیوند(out1، "hl"))، read_text(مسیر پرونده.پیوند(out1، "sl"))
    long := "g".تکرار(50) + "/" + "h".تکرار(50) + "/" + "i".تکرار(20) + ".txt"
    سرچاپ read_text(مسیر پرونده.پیوند(out1، long))
    سرچاپ read_text(مسیر پرونده.پیوند(out1، "é日本.txt"))
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(out1، "emptydir"))
    ناپایا gok := نادرست
    one := بایگانی.استخراج با نام از تار جی زیپ(gz.داده، gz.طول، "./a.txt"، gok)
    سرچاپ gok، فشرده سازی.بافر به رشته(one)
    perm := سیستم پرونده.مجوزها(مسیر پرونده.پیوند(out1، "a.txt"))
    mt := سیستم پرونده.زمان تغییر(مسیر پرونده.پیوند(out1، "a.txt"))
    سرچاپ سلام سیستم ویندوز یا perm برابر 420
    سرچاپ سلام سیستم ویندوز یا اندازه‌گونه(تهی*) نابرابر 8 یا mt برابر (1700000000 برگردان صحیح۶۴)

    ناپایا fl := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    d := فشرده سازی.بافر از رشته("payload\n")
    ناپایا f0 := بایگانی.ساخت ورودی پرونده تار("a.txt"، d.داده، d.طول، نادرست)
    f0.زمان تغییر = 1700000000 برگردان صحیح۶۴
    f0.دسترسی = 0o640
    fl.بیفزا(f0)
    fl.بیفزا(بایگانی.ساخت ورودی پرونده تار("dir"، پوچ، 0، درست))
    fl.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("dir/sl"، "../a.txt"))
    fl.بیفزا(بایگانی.ساخت ورودی پیوند سخت تار("hl"، "a.txt"))
    split := "p1234567890/".تکرار(6) + "x/" + "n".تکرار(90) + ".txt"
    fl.بیفزا(بایگانی.ساخت ورودی پرونده تار(split، d.داده، d.طول، نادرست))
    deep := "q".تکرار(150) + "/f.txt"
    fl.بیفزا(بایگانی.ساخت ورودی پرونده تار(deep، d.داده، d.طول، نادرست))
    wide := "é日本-" + "z".تکرار(200) + ".txt"
    fl.بیفزا(بایگانی.ساخت ورودی پرونده تار(wide، d.داده، d.طول، نادرست))
    fl.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("l".تکرار(120)، "t".تکرار(130)))
    ناپایا big := بایگانی.ساخت ورودی پرونده تار("late.txt"، d.داده، d.طول، نادرست)
    big.زمان تغییر = 99999999999 برگردان صحیح۶۴
    fl.بیفزا(big)
    t := بایگانی.ساخت تار(fl)
    سرچاپ t.طول % 512
    ناپایا es := بایگانی.فهرست تار(t.داده، t.طول)
    هر e در es:
        سرچاپ e.نوع، e.نام.طول()، e.پیوند.طول()، e.اندازه، e.زمان تغییر، e.دسترسی
    پایان
    بایگانی.آزادسازی فهرست(es)
    سرچاپ بایگانی.فهرست تار(t.داده، t.طول).بگیر(4).نام برابر split
    out2 := مسیر پرونده.پیوند(root، "made")
    سرچاپ بایگانی.استخراج همه از تار(t.داده، t.طول، out2)
    سرچاپ read_text(مسیر پرونده.پیوند(out2، "hl"))، read_text(مسیر پرونده.پیوند(out2، "dir/sl"))، read_text(مسیر پرونده.پیوند(out2، split))، read_text(مسیر پرونده.پیوند(out2، wide))
    سرچاپ read_text(مسیر پرونده.پیوند(out2، "late.txt"))
    tg := بایگانی.ساخت تار جی زیپ(fl)
    ناپایا tok := نادرست
    ناپایا tes := بایگانی.فهرست تار جی زیپ(tg.داده، tg.طول، tok)
    سرچاپ tok، tes.طول()
    بایگانی.آزادسازی فهرست(tes)
    tl := بایگانی.فهرست تار جی زیپ با سقف(tg.داده، tg.طول، 1000، tok)
    سرچاپ tok، tl.طول()
    سرچاپ بایگانی.استخراج همه از تار جی زیپ با سقف(tg.داده، tg.طول، مسیر پرونده.پیوند(root، "capped")، 1000)، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(root، "capped"))
    one2 := بایگانی.استخراج با نام از تار جی زیپ با سقف(tg.داده، tg.طول، "late.txt"، 1000، tok)
    سرچاپ tok، one2.طول
    one3 := بایگانی.استخراج با نام از تار جی زیپ(tg.داده، tg.طول، "late.txt"، tok)
    سرچاپ tok، فشرده سازی.بافر به رشته(one3)
    سرچاپ بایگانی.ساخت پرونده تار جی زیپ(fl، مسیر پرونده.پیوند(root، "x.tar.gz"))
    سرچاپ بایگانی.استخراج همه از تار جی زیپ(tg.داده، tg.طول، مسیر پرونده.پیوند(root، "viagz"))
    سرچاپ read_text(مسیر پرونده.پیوند(root، "viagz/a.txt"))
    junk := فشرده سازی.بافر از رشته("not gzip data at all, just text")
    سرچاپ بایگانی.استخراج همه از تار جی زیپ(junk.داده، junk.طول، مسیر پرونده.پیوند(root، "junk"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(root، "junk"))

    ناپایا bad := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    bad.بیفزا(بایگانی.ساخت ورودی پرونده تار("ok.txt"، d.داده، d.طول، نادرست))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("abs"، "/etc/passwd"))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("up"، ".."))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("deep/up"، "../../x"))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("mid"، "a/../.."))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("empty"، ""))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند سخت تار("hard"، "../outside.txt"))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند سخت تار("hard2"، "/etc/passwd"))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("dot"، "."))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("dot/back"، ".."))
    bad.بیفزا(بایگانی.ساخت ورودی پرونده تار("dot/escape.txt"، d.داده، d.طول، نادرست))
    bad.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("good"، "ok.txt"))
    b := بایگانی.ساخت تار(bad)
    sec := مسیر پرونده.پیوند(root، "sec")
    inner := مسیر پرونده.پیوند(sec، "inner")
    سرچاپ بایگانی.استخراج همه از تار(b.داده، b.طول، inner)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(sec، "escape.txt"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(sec، "outside.txt"))
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(inner، "abs"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(inner، "up"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(inner، "hard"))
    سرچاپ read_text(مسیر پرونده.پیوند(inner، "ok.txt"))، read_text(مسیر پرونده.پیوند(inner، "good"))

    سیستم عامل.حذف همه(root)
پایان
