واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    دایرکتوری := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_archive_tar_demo")
    سیستم عامل.حذف همه(دایرکتوری)
    سیستم عامل.ساخت پوشه ها(دایرکتوری)
    خروجی تار := مسیر پرونده.پیوند(دایرکتوری، "out.tar")
    خروجی فشرده := مسیر پرونده.پیوند(دایرکتوری، "out.tar.gz")
    تار بازگشتی := مسیر پرونده.پیوند(دایرکتوری، "back.tar")
    پوشه استخراج := مسیر پرونده.پیوند(دایرکتوری، "untarred")
    ژرف := مسیر پرونده.پیوند(دایرکتوری، "a/b/c")
    ژرف ایکس := مسیر پرونده.پیوند(ژرف، "x.bin")
    ژرف ایگرگ := مسیر پرونده.پیوند(ژرف، "y.bin")
    ب := فشرده سازی.بافر از رشته("خط اول\nخط دوم\n")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes"، پوچ، ۰، درست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/a.txt"، ب.داده، ب.طول، نادرست))
    ت := بایگانی.ساخت تار(پرونده‌ها)
    سرچاپ ت.طول % ۵۱۲
    ناپایا فهرست := بایگانی.فهرست تار(ت.داده، ت.طول)
    هر م در فهرست:
        سرچاپ م.نام، م.اندازه، م.پوشه
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    ناپایا خوب := نادرست
    الف := بایگانی.استخراج با نام از تار(ت.داده، ت.طول، "notes/a.txt"، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(الف)
    سرچاپ بایگانی.ساخت پرونده تار(پرونده‌ها، خروجی تار)، بایگانی.استخراج همه از تار(ت.داده، ت.طول، پوشه استخراج)
    سرچاپ بایگانی.فشرده سازی پرونده جی زیپ(خروجی تار، خروجی فشرده)، بایگانی.کدگشایی پرونده جی زیپ(خروجی فشرده، تار بازگشتی)
    ک := بایگانی.خواندن پرونده دودویی(تار بازگشتی، خوب)
    سرچاپ خوب، ک.طول == ت.طول
    بایگانی.اطمینان از پوشه(ژرف)
    سرچاپ بایگانی.نوشتن پرونده دودویی(ژرف ایکس، ب.داده، ۳)، بایگانی.نوشتن پرونده دودویی از بافر(ژرف ایگرگ، ب)
    ناپایا ب۲ := فشرده سازی.بافر بایت جدید()
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(ب۲، ۵۱۳)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(ب۲، ۷۰۰۰۰)
    سرچاپ بایگانی.خواندن شانزده بیتی کم ارزش‌اول(ب۲.داده، ۰)، بایگانی.خواندن عدد۳۲ کم ارزش‌اول(ب۲.داده، ۲)
    سیستم عامل.حذف همه(دایرکتوری)
