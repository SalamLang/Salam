// زبان: فارسی
بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی آزمایش
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه

تابع make_data(n: صحیح، seed: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = (x * 1103515245 + 12345) & 0x7fffffff
        فشرده سازی.افزودن بایت(b، 32 + (x >> 16) % 90)
    پایان
    برگشت b
پایان

تابع put(dir: رشته، name: رشته، data: فشرده سازی.بافر بایت): رشته:
    path := مسیر پرونده.پیوند(dir، name)
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی(path، data.داده، data.طول))
    برگشت path
پایان

تابع same_file(path: رشته، want: فشرده سازی.بافر بایت): منطقی:
    ناپایا ok := نادرست
    ناپایا got := بایگانی.خواندن پرونده دودویی(path، ok)
    r := ok و فشرده سازی.برابری بافر(got، want)
    فشرده سازی.آزادسازی بافر(got)
    برگشت r
پایان

تابع check_tree(root: رشته، a: فشرده سازی.بافر بایت، b: فشرده سازی.بافر بایت، c: فشرده سازی.بافر بایت، m: فشرده سازی.بافر بایت):
    آزمایش.ادعای درستی(same_file(مسیر پرونده.پیوند(root، "big.bin")، a))
    آزمایش.ادعای درستی(same_file(مسیر پرونده.پیوند(root، "sub/exact.bin")، b))
    آزمایش.ادعای درستی(same_file(مسیر پرونده.پیوند(root، "sub/empty.bin")، c))
    آزمایش.ادعای درستی(same_file(مسیر پرونده.پیوند(root، "mem.txt")، m))
پایان

تابع ریشه(): صحیح:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_tar_stream_test")
    دیرکن حافظه.آزادسازی(dir برگردان تهی*)
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    بایگانی.تنظیم اندازه قطعه نوشتن(4096)

    ناپایا a := make_data(70001، 1)
    ناپایا b := make_data(4096، 2)
    ناپایا c := فشرده سازی.بافر بایت جدید()
    ناپایا m := make_data(777، 3)
    pa := put(dir، "a.in"، a)
    pb := put(dir، "b.in"، b)
    pc := put(dir، "c.in"، c)

    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار از مسیر("big.bin"، pa))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("sub/"، پوچ، 0، درست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار از مسیر("sub/exact.bin"، pb))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار از مسیر("sub/empty.bin"، pc))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("mem.txt"، m.داده، m.طول، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("link"، "big.bin"))

    plain := مسیر پرونده.پیوند(dir، "out.tar")
    gz := مسیر پرونده.پیوند(dir، "out.tar.gz")
    zs := مسیر پرونده.پیوند(dir، "out.tar.zst")
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده تار(files، plain))
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده تار جی زیپ(files، gz))
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده تار زستد(files، zs))

    ناپایا mem_tar := بایگانی.ساخت تار(files)
    آزمایش.ادعای درستی(mem_tar.طول بزرگتر 0)
    آزمایش.ادعای درستی(same_file(plain، mem_tar))
    آزمایش.ادعای برابری عدد(mem_tar.طول % 512، 0)
    فشرده سازی.آزادسازی بافر(mem_tar)

    r1 := مسیر پرونده.پیوند(dir، "x1")
    آزمایش.ادعای برابری عدد(بایگانی.استخراج همه از پرونده تار(plain، r1، 0 برگردان صحیح۶۴)، 0)
    check_tree(r1، a، b، c، m)

    r2 := مسیر پرونده.پیوند(dir، "x2")
    آزمایش.ادعای برابری عدد(بایگانی.استخراج همه از پرونده تار جی زیپ(gz، r2، 0 برگردان صحیح۶۴)، 0)
    check_tree(r2، a، b، c، m)

    r3 := مسیر پرونده.پیوند(dir، "x3")
    ناپایا rok := نادرست
    ناپایا zpacked := بایگانی.خواندن پرونده دودویی(zs، rok)
    آزمایش.ادعای درستی(rok)
    آزمایش.ادعای درستی(بایگانی.استخراج همه از تار زستد(zpacked.داده، zpacked.طول، r3))
    فشرده سازی.آزادسازی بافر(zpacked)
    check_tree(r3، a، b، c، m)

    آزمایش.ادعای درستی(بایگانی.ساخت پرونده تار زستد با سطح(files، zs، 1))
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده تار زستد با سطح(files، zs، 9))
    zpacked = بایگانی.خواندن پرونده دودویی(zs، rok)
    r4 := مسیر پرونده.پیوند(dir، "x4")
    آزمایش.ادعای درستی(بایگانی.استخراج همه از تار زستد(zpacked.داده، zpacked.طول، r4))
    فشرده سازی.آزادسازی بافر(zpacked)
    check_tree(r4، a، b، c، m)

    ناپایا bad := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    bad.بیفزا(بایگانی.ساخت ورودی پرونده تار("ok.txt"، m.داده، m.طول، نادرست))
    bad.بیفزا(بایگانی.ساخت ورودی پرونده تار از مسیر("gone.bin"، مسیر پرونده.پیوند(dir، "no_such_input")))
    never := مسیر پرونده.پیوند(dir، "never.tar")
    آزمایش.ادعای نادرستی(بایگانی.ساخت پرونده تار(bad، never))
    آزمایش.ادعای نادرستی(سیستم عامل.وجود دارد(never))
    آزمایش.ادعای نادرستی(بایگانی.ساخت پرونده تار جی زیپ(bad، never))
    آزمایش.ادعای نادرستی(بایگانی.ساخت پرونده تار زستد(bad، never))
    آزمایش.ادعای نادرستی(سیستم عامل.وجود دارد(never))
    ناپایا none := بایگانی.ساخت تار(bad)
    آزمایش.ادعای برابری عدد(none.طول، 0)
    فشرده سازی.آزادسازی بافر(none)

    فشرده سازی.آزادسازی بافر(a)
    فشرده سازی.آزادسازی بافر(b)
    فشرده سازی.آزادسازی بافر(c)
    فشرده سازی.آزادسازی بافر(m)
    سیستم عامل.حذف همه(dir)
    برگشت آزمایش.خلاصه()
پایان
