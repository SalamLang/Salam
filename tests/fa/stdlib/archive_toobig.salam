بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع code(why: صحیح): رشته:
    اگر why برابر فشرده سازی.کدگشایی موفق: برگشت "ok" پایان
    اگر why برابر فشرده سازی.کدگشایی بزرگ: برگشت "too big" پایان
    برگشت "corrupt"
پایان

تابع check(label: رشته، packed &: فشرده سازی.بافر بایت، kind: صحیح):
    ناپایا why := -1
    ناپایا out := فشرده سازی.بافر بایت جدید()
    اگر kind برابر 0:
        out = فشرده سازی.کدگشایی جی زیپ با علت(packed.داده، packed.طول، 1000، why)
    وگرنه kind برابر 1:
        out = فشرده سازی.کدگشایی بی زیپ دو با علت(packed.داده، packed.طول، 1000، why)
    وگرنه kind برابر 2:
        out = فشرده سازی.کدگشایی ایکس زد با علت(packed.داده، packed.طول، 1000، why)
    وگرنه:
        out = فشرده سازی.کدگشایی الزد ام ای با علت(packed.داده، packed.طول، 1000، why)
    پایان
    فشرده سازی.آزادسازی بافر(out)
    capped := code(why)
    ناپایا free := فشرده سازی.بافر بایت جدید()
    اگر kind برابر 0:
        free = فشرده سازی.کدگشایی جی زیپ با علت(packed.داده، packed.طول، 0، why)
    وگرنه kind برابر 1:
        free = فشرده سازی.کدگشایی بی زیپ دو با علت(packed.داده، packed.طول، 0، why)
    وگرنه kind برابر 2:
        free = فشرده سازی.کدگشایی ایکس زد با علت(packed.داده، packed.طول، 0، why)
    وگرنه:
        free = فشرده سازی.کدگشایی الزد ام ای با علت(packed.داده، packed.طول، 0، why)
    پایان
    سرچاپ label، capped، code(why)، free.طول
    فشرده سازی.آزادسازی بافر(free)
    cut := packed.طول - 5
    ناپایا bad := فشرده سازی.بافر بایت جدید()
    اگر kind برابر 0:
        bad = فشرده سازی.کدگشایی جی زیپ با علت(packed.داده، cut، 0، why)
    وگرنه kind برابر 1:
        bad = فشرده سازی.کدگشایی بی زیپ دو با علت(packed.داده، cut، 0، why)
    وگرنه kind برابر 2:
        bad = فشرده سازی.کدگشایی ایکس زد با علت(packed.داده، cut، 0، why)
    وگرنه:
        bad = فشرده سازی.کدگشایی الزد ام ای با علت(packed.داده، cut، 0، why)
    پایان
    سرچاپ " cut"، code(why)
    فشرده سازی.آزادسازی بافر(bad)
    فشرده سازی.آزادسازی بافر(packed)
پایان

تابع tmp(name: رشته): رشته:
    t := سیستم عامل.پوشه موقت()
    r := مسیر پرونده.پیوند(t، name)
    حافظه.آزادسازی(t برگردان تهی*)
    برگشت r
پایان

تابع ریشه():
    ناپایا raw := فشرده سازی.بافر بایت جدید()
    ناپایا i := 0
    تا i کوچکتر 50000:
        فشرده سازی.افزودن بایت(raw، 97 + (i % 7))
        i++
    پایان
    ناپایا p0 := فشرده سازی.فشرده سازی جی زیپ(raw.داده، raw.طول)
    check("gzip"، p0، 0)
    ناپایا p1 := فشرده سازی.فشرده سازی بی زیپ دو(raw.داده، raw.طول)
    check("bzip2"، p1، 1)
    ناپایا p2 := فشرده سازی.فشرده سازی ایکس زد(raw.داده، raw.طول)
    check("xz"، p2، 2)
    ناپایا p3 := فشرده سازی.فشرده سازی الزد ام ای(raw.داده، raw.طول)
    check("lzma"، p3، 3)

    src := tmp("salam_toobig_src.bin")
    ناپایا ok := بایگانی.نوشتن پرونده دودویی از بافر(src، raw)
    packed := tmp("salam_toobig.xz")
    back := tmp("salam_toobig_back.bin")
    ok = بایگانی.فشرده سازی پرونده ایکس زد(src، packed)
    سرچاپ "xz cap"، بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده ایکس زد با سقف(packed، back، 1000 برگردان صحیح۶۴))، سیستم عامل.وجود دارد(back)
    سرچاپ "xz free"، بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده ایکس زد با سقف(packed، back، 0 برگردان صحیح۶۴))
    ok = بایگانی.فشرده سازی پرونده بی زیپ دو(src، packed)
    سرچاپ "bz2 cap"، بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده بی زیپ دو با سقف(packed، back، 1000 برگردان صحیح۶۴))
    سرچاپ "bz2 free"، بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده بی زیپ دو با سقف(packed، back، 0 برگردان صحیح۶۴))
    سرچاپ "lzma missing"، بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده الزد ام ای با سقف(src، back، 0 برگردان صحیح۶۴))
    سرچاپ "texts"، بایگانی.متن وضعیت زیپ(بایگانی.زیپ خطای ورودی خروجی)، "|"، بایگانی.متن وضعیت آر ای آر(بایگانی.آر ای آر رمزگذاری شده)، "|"، بایگانی.متن وضعیت هفت زد(بایگانی.هفت زد مسیر ناامن)، "|"، بایگانی.متن وضعیت تار(بایگانی.تار بیش از حد بزرگ)
    سیستم عامل.حذف(src)
    سیستم عامل.حذف(packed)
    سیستم عامل.حذف(back)
    فشرده سازی.آزادسازی بافر(raw)
پایان
