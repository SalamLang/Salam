بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی آزمایش
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی تبدیل

تابع make_data(n: صحیح، seed: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n در i:
        x = (x * 1103515245 + 12345) & 0x7fffffff
        اگر (i / 700) % 3 برابر 0:
            فشرده سازی.افزودن بایت(b، 97 + (x >> 16) % 6)
        وگرنه:
            فشرده سازی.افزودن بایت(b، 32 + (x >> 16) % 90)
        پایان
    پایان
    برگشت b
پایان

تابع p(dir: رشته، name: رشته): رشته:
    برگشت مسیر پرونده.پیوند(dir، name)
پایان

تابع same(path: رشته، want: فشرده سازی.بافر بایت): منطقی:
    ناپایا ok := نادرست
    ناپایا got := بایگانی.خواندن پرونده دودویی(path، ok)
    r := ok و فشرده سازی.برابری بافر(got، want)
    فشرده سازی.آزادسازی بافر(got)
    برگشت r
پایان

تابع roundtrip(dir: رشته، data: فشرده سازی.بافر بایت، tag: رشته):
    src := p(dir، "src_" + tag)
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی(src، data.داده، data.طول))

    gz := p(dir، tag + ".gz")
    ناپایا back := p(dir، tag + ".gz.out")
    آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده جی زیپ(src، gz))
    آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده جی زیپ(gz، back))
    آزمایش.ادعای درستی(same(back، data))
    ناپایا rok := نادرست
    ناپایا packed := بایگانی.خواندن پرونده دودویی(gz، rok)
    ناپایا gok := نادرست
    ناپایا mem_out := فشرده سازی.کدگشایی جی زیپ(packed.داده، packed.طول، gok)
    آزمایش.ادعای درستی(gok و فشرده سازی.برابری بافر(mem_out، data))
    فشرده سازی.آزادسازی بافر(mem_out)
    فشرده سازی.آزادسازی بافر(packed)

    bz := p(dir، tag + ".bz2")
    back = p(dir، tag + ".bz2.out")
    آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده بی زیپ دو(src، bz))
    آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده بی زیپ دو(bz، back))
    آزمایش.ادعای درستی(same(back، data))

    xz := p(dir، tag + ".xz")
    back = p(dir، tag + ".xz.out")
    آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده ایکس زد(src، xz))
    آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده ایکس زد(xz، back))
    آزمایش.ادعای درستی(same(back، data))

    zs := p(dir، tag + ".zst")
    back = p(dir، tag + ".zst.out")
    آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده زستد(src، zs))
    آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده زستد(zs، back))
    آزمایش.ادعای درستی(same(back، data))
پایان

تابع levels(dir: رشته، data: فشرده سازی.بافر بایت):
    src := p(dir، "lv_src")
    back := p(dir، "lv_back")
    out := p(dir، "lv_out")
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی(src، data.داده، data.طول))
    هر lv در [0، 1، 5، 9، 99]:
        آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده بی زیپ دو با سطح(src، out، lv))
        آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده بی زیپ دو(out، back))
        آزمایش.ادعای درستی(same(back، data))
        آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده ایکس زد با سطح(src، out، lv))
        آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده ایکس زد(out، back))
        آزمایش.ادعای درستی(same(back، data))
        آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده الزد ام ای با سطح(src، out، lv))
        آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده الزد ام ای(out، back))
        آزمایش.ادعای درستی(same(back، data))
    پایان
    هر lv در [0، 1، 3، 7]:
        آزمایش.ادعای درستی(بایگانی.فشرده سازی پرونده زستد با سطح(src، out، lv))
        آزمایش.ادعای درستی(بایگانی.کدگشایی پرونده زستد(out، back))
        آزمایش.ادعای درستی(same(back، data))
    پایان
پایان

تابع ریشه(): صحیح:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_write_stream_test")
    دیرکن حافظه.آزادسازی(dir برگردان تهی*)
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    بایگانی.تنظیم اندازه قطعه نوشتن(4096)

    sizes := [0، 1، 4095، 4096، 4097، 8192، 30001]
    هر n در sizes:
        ناپایا data := make_data(n، n + 7)
        roundtrip(dir، data، "n" + تبدیل.قالب عدد(n برگردان صحیح۶۴))
        فشرده سازی.آزادسازی بافر(data)
    پایان

    ناپایا big := make_data(20000، 3)
    levels(dir، big)
    فشرده سازی.آزادسازی بافر(big)

    missing := p(dir، "no_such_input")
    out := p(dir، "never_written")
    آزمایش.ادعای نادرستی(بایگانی.فشرده سازی پرونده جی زیپ(missing، out))
    آزمایش.ادعای نادرستی(بایگانی.فشرده سازی پرونده بی زیپ دو(missing، out))
    آزمایش.ادعای نادرستی(بایگانی.فشرده سازی پرونده ایکس زد(missing، out))
    آزمایش.ادعای نادرستی(بایگانی.فشرده سازی پرونده زستد(missing، out))
    آزمایش.ادعای نادرستی(سیستم عامل.وجود دارد(out))

    سیستم عامل.حذف همه(dir)
    برگشت آزمایش.خلاصه()
پایان
