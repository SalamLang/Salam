بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل
واردسازی رشته
واردسازی سیستم پرونده

تابع hexval(c: صحیح): صحیح:
    برگشت c کوچکتربرابر 57 ? c - 48 : c - 87
پایان

تابع from_hex(h: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := h برگردان طبیعی۸*
    ناپایا i := 0
    تا i کوچکتر h.طول():
        فشرده سازی.افزودن بایت(b، hexval(bp[i] برگردان صحیح) * 16 + hexval(bp[i + 1] برگردان صحیح))
        i += 2
    پایان
    برگشت b
پایان

تابع fixture(name: رشته): فشرده سازی.بافر بایت:
    اگر name برابر "7z":
        برگشت from_hex("")
    پایان
    اگر name برابر "info":
        برگشت from_hex("")
    پایان
    اگر name برابر "info_fz":
        برگشت from_hex("")
    پایان
    اگر name برابر "py_deflate":
        برگشت from_hex("")
    پایان
    اگر name برابر "py_stored":
        برگشت from_hex("")
    پایان
    اگر name برابر "py_z64_stored":
        برگشت from_hex("")
    پایان
    برگشت فشرده سازی.بافر بایت جدید()
پایان

تابع text_of(b: فشرده سازی.بافر بایت): رشته:
    برگشت فشرده سازی.بافر به رشته(b)
پایان

تابع show(label: رشته):
    d := fixture(label)
    ناپایا entries := بایگانی.فهرست زیپ(d.داده، d.طول)
    ناپایا checked := 0
    bad := بایگانی.بررسی زیپ(d.داده، d.طول، checked)
    سرچاپ label، entries.طول()، "checked"، checked، "bad"، bad
    هر e در entries:
        سرچاپ " "، e.نام، e.اندازه، e.روش، e.پوشه، e.زمان تغییر
    پایان
    بایگانی.آزادسازی فهرست(entries)
    ناپایا status := 0
    a := بایگانی.استخراج تایید شده از زیپ(d.داده، d.طول، "docs/a.txt"، 0، status)
    سرچاپ " a.txt"، status، a.طول، text_of(a).زیررشته(0، 9)
پایان

تابع patch_byte(b: فشرده سازی.بافر بایت، at: صحیح، v: صحیح):
    bp := b.داده برگردان طبیعی۸*
    bp[at] = v برگردان طبیعی۸
پایان

تابع find_sig(b: فشرده سازی.بافر بایت، sig: صحیح، from: صحیح): صحیح:
    ناپایا i := from
    تا i + 4 کوچکتربرابر b.طول:
        اگر بایگانی.خواندن عدد۳۲ کم ارزش‌اول(b.داده، i) برابر sig:
            برگشت i
        پایان
        i++
    پایان
    برگشت -1
پایان

تابع ریشه:
    show("7z")
    show("info")
    show("info_fz")
    show("py_deflate")
    show("py_stored")
    show("py_z64_stored")

    fz := fixture("info_fz")
    سرچاپ "zip64 eocd"، find_sig(fz، 0x06064b50، 0) بزرگتر 0، find_sig(fz، 0x07064b50، 0) بزرگتر 0

    ناپایا status := 0
    st := fixture("py_stored")
    ناپایا ok := نادرست
    fa_name := "سلام/نام.txt"
    fa := بایگانی.استخراج تایید شده از زیپ(st.داده، st.طول، fa_name، 0، status)
    سرچاپ status، text_of(fa).طول()
    miss := بایگانی.استخراج تایید شده از زیپ(st.داده، st.طول، "none"، 0، status)
    سرچاپ status، miss.طول، بایگانی.متن وضعیت زیپ(status)
    capped := بایگانی.استخراج تایید شده از زیپ(st.داده، st.طول، "docs/a.txt"، 10، status)
    سرچاپ status، capped.طول، بایگانی.متن وضعیت زیپ(status)

    at := find_sig(st، 0x04034b50، 0)
    سرچاپ "first local"، at
    data_at := find_sig(st، 0x04034b50، at + 4)
    patch_byte(st، data_at + 30 + 10 + 3، 0x5a)
    bad := بایگانی.استخراج تایید شده از زیپ(st.داده، st.طول، "docs/a.txt"، 0، status)
    سرچاپ status، bad.طول، بایگانی.متن وضعیت زیپ(status)
    plain := بایگانی.استخراج با نام از زیپ(st.داده، st.طول، "docs/a.txt"، ok)
    سرچاپ ok، plain.طول، text_of(plain).زیررشته(3، 1)
    ناپایا checked := 0
    سرچاپ بایگانی.بررسی زیپ(st.داده، st.طول، checked)، checked
    ناپایا broken := بایگانی.مدخل های خراب زیپ(st.داده، st.طول)
    هر e در broken:
        سرچاپ "bad entry"، e.نام
    پایان
    بایگانی.آزادسازی فهرست(broken)
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_zip_upgrade")
    سیستم عامل.حذف همه(dir)
    سرچاپ بایگانی.استخراج همه از زیپ(st.داده، st.طول، dir)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "docs/a.txt"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "empty.txt"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "سلام/نام.txt"))
    سیستم عامل.حذف همه(dir)

    pyz := fixture("py_deflate")
    سرچاپ بایگانی.استخراج همه از زیپ(pyz.داده، pyz.طول، dir)
    سرچاپ سلام سیستم ویندوز یا اندازه‌گونه(تهی*) نابرابر 8 یا سیستم پرونده.زمان تغییر(مسیر پرونده.پیوند(dir، "docs/a.txt")) برابر (1621247444 برگردان صحیح۶۴)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "سلام/نام.txt"))
    سیستم عامل.حذف همه(dir)

    junk := فشرده سازی.بافر از رشته("this is not a zip file at all, just text")
    سرچاپ بایگانی.بررسی زیپ(junk.داده، junk.طول، checked)، checked، بایگانی.فهرست زیپ(junk.داده، junk.طول).طول()
    _ := بایگانی.استخراج تایید شده از زیپ(junk.داده، junk.طول، "x"، 0، status)
    سرچاپ بایگانی.متن وضعیت زیپ(status)

    body := "persian name, dated file, persian name, dated file"
    b := فشرده سازی.بافر از رشته(body)
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    ناپایا f1 := بایگانی.ساخت ورودی پرونده زیپ("سلام.txt"، b.داده، b.طول، 8)
    f1.زمان تغییر = 1700000000 برگردان صحیح۶۴
    ناپایا f2 := بایگانی.ساخت ورودی پرونده زیپ("plain.txt"، b.داده، b.طول، 0)
    f2.زمان تغییر = 951782400 برگردان صحیح۶۴
    ناپایا f3 := بایگانی.ساخت ورودی پرونده زیپ("old.txt"، b.داده، b.طول، 8)
    f3.زمان تغییر = 100 برگردان صحیح۶۴
    ناپایا f4 := بایگانی.ساخت ورودی پرونده زیپ("future.txt"، b.داده، b.طول، 8)
    f4.زمان تغییر = 9000000000 برگردان صحیح۶۴
    files.بیفزا(f1)
    files.بیفزا(f2)
    files.بیفزا(f3)
    files.بیفزا(f4)
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("dir/"، پوچ، 0، 0))
    z := بایگانی.ساخت زیپ(files)
    ناپایا listed := بایگانی.فهرست زیپ(z.داده، z.طول)
    هر e در listed:
        سرچاپ e.نام، e.اندازه، e.زمان تغییر
    پایان
    بایگانی.آزادسازی فهرست(listed)
    first := find_sig(z، 0x04034b50، 0)
    second := find_sig(z، 0x04034b50، first + 4)
    سرچاپ "flags"، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(z.داده، first + 6)، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(z.داده، second + 6)
    central := find_sig(z، 0x02014b50، 0)
    سرچاپ "central flag"، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(z.داده، central + 8)، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(z.داده، central + 12)، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(z.داده، central + 14)
    سرچاپ بایگانی.بررسی زیپ(z.داده، z.طول، checked)، checked

    z64 := بایگانی.ساخت زیپ بزرگ(files)
    سرچاپ "zip64"، find_sig(z64، 0x06064b50، 0) بزرگتر 0، find_sig(z64، 0x07064b50، 0) بزرگتر 0، z64.طول بزرگتر z.طول
    ناپایا listed64 := بایگانی.فهرست زیپ(z64.داده، z64.طول)
    سرچاپ listed64.طول()، listed64.بگیر(0).نام، listed64.بگیر(0).اندازه، listed64.بگیر(0).زمان تغییر
    بایگانی.آزادسازی فهرست(listed64)
    سرچاپ بایگانی.بررسی زیپ(z64.داده، z64.طول، checked)، checked
    back := بایگانی.استخراج تایید شده از زیپ(z64.داده، z64.طول، "plain.txt"، 0، status)
    سرچاپ status، text_of(back) برابر body
    eocd := z64.طول - 22
    سرچاپ "eocd"، بایگانی.خواندن شانزده بیتی کم ارزش‌اول(z64.داده، eocd + 10)، بایگانی.خواندن عدد۳۲ کم ارزش‌اول(z64.داده، eocd + 16)

    huge := بایگانی.ساخت زیپ بزرگ(files)
    c1 := find_sig(huge، 0x02014b50، 0)
    extra_at := c1 + 46 + 12 + 4
    patch_byte(huge، extra_at + 4، 1)
    patch_byte(huge، extra_at + 8 + 4، 1)
    ناپایا hl := بایگانی.فهرست زیپ(huge.داده، huge.طول)
    سرچاپ hl.بگیر(0).نام، hl.بگیر(0).اندازه، hl.بگیر(0).اندازه فشرده
    بایگانی.آزادسازی فهرست(hl)
    big2 := بایگانی.استخراج تایید شده از زیپ(huge.داده، huge.طول، "سلام.txt"، 0، status)
    سرچاپ status، big2.طول، بایگانی.متن وضعیت زیپ(status)
    _ := بایگانی.استخراج با نام از زیپ(huge.داده، huge.طول، "سلام.txt"، ok)
    سرچاپ ok
    سرچاپ بایگانی.بررسی زیپ(huge.داده، huge.طول، checked)، checked

    ناپایا cut := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(cut، z64.داده، z64.طول - 30)
    سرچاپ بایگانی.فهرست زیپ(cut.داده، cut.طول).طول()، بایگانی.بررسی زیپ(cut.داده، cut.طول، checked)
    ناپایا chopped := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(chopped، z64.داده، z64.طول)
    patch_byte(chopped، z64.طول - 22 - 20 - 56 + 48، 0xff)
    patch_byte(chopped، z64.طول - 22 - 20 - 56 + 49، 0xff)
    سرچاپ بایگانی.فهرست زیپ(chopped.داده، chopped.طول).طول()

    ناپایا wide := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    ناپایا i := 0
    تا i کوچکتر 66000:
        wide.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("f/" + رشته.از عدد(i برگردان صحیح۶۴)، پوچ، 0، 0))
        i++
    پایان
    wz := بایگانی.ساخت زیپ(wide)
    wl := بایگانی.فهرست زیپ(wz.داده، wz.طول)
    سرچاپ wl.طول()، wl.بگیر(65999).نام، find_sig(wz، 0x06064b50، wz.طول - 200) بزرگتر 0
    سرچاپ بایگانی.بررسی زیپ(wz.داده، wz.طول، checked)، checked

    سرچاپ "limits"
    ناپایا bad_in := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    bad_in.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("neg"، b.داده، -5، 0))
    سرچاپ بایگانی.ساخت زیپ(bad_in).طول
    ناپایا nul_in := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    nul_in.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("nul"، پوچ، 10، 0))
    سرچاپ بایگانی.ساخت زیپ(nul_in).طول
    ناپایا big_in := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    big_in.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("big"، b.داده، 2000000000، 0))
    سرچاپ بایگانی.ساخت زیپ(big_in).طول، بایگانی.ساخت زیپ بزرگ(big_in).طول
    سرچاپ بایگانی.ساخت پرونده زیپ(big_in، مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_zip_never.zip"))
    ناپایا long_in := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    long_in.بیفزا(بایگانی.ساخت ورودی پرونده زیپ(repeat_str("n"، 70000)، b.داده، 5، 0))
    سرچاپ بایگانی.ساخت زیپ(long_in).طول
پایان

تابع repeat_str(s: رشته، count: صحیح): رشته:
    ناپایا b := رشته.سازنده()
    ناپایا i := 0
    تا i کوچکتر count:
        رشته.افزودن به بافر(b، s)
        i++
    پایان
    out := رشته.رشته بافر(b)
    رشته.آزادسازی بافر(b)
    برگشت out
پایان
