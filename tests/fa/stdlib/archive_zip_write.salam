// زبان: فارسی
بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی آزمایش
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی تبدیل

تابع make_data(n: صحیح، seed: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = (x * 1103515245 + 12345) & 0x7fffffff
        فشرده سازی.افزودن بایت(b، 32 + (x >> 16) % 90)
    پایان
    برگشت b
پایان

تابع same_file(path: رشته، want: فشرده سازی.بافر بایت، len: صحیح): منطقی:
    ناپایا ok := نادرست
    ناپایا got := بایگانی.خواندن پرونده دودویی(path، ok)
    r := ok و got.طول برابر len و فشرده سازی.چک جمع سی آر سی(got.داده، len) برابر فشرده سازی.چک جمع سی آر سی(want.داده، len)
    فشرده سازی.آزادسازی بافر(got)
    برگشت r
پایان

تابع check(zf &: بایگانی.پرونده زیپ، name: رشته، password: رشته، want: فشرده سازی.بافر بایت، len: صحیح، dir: رشته):
    بایگانی.تنظیم گذرواژه پرونده زیپ(zf، password)
    dest := مسیر پرونده.پیوند(dir، "got.bin")
    آزمایش.ادعای برابری عدد(بایگانی.استخراج از پرونده زیپ به پرونده(zf، name، dest، 0 برگردان صحیح۶۴)، بایگانی.زیپ موفق)
    آزمایش.ادعای درستی(same_file(dest، want، len))
    سیستم عامل.حذف(dest)
پایان

تابع ریشه(): صحیح:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_zip_write_test")
    دیرکن حافظه.آزادسازی(dir برگردان تهی*)
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    بایگانی.تنظیم اندازه قطعه نوشتن(4096)

    ناپایا a := make_data(30000، 1)
    ناپایا b := make_data(5000، 2)
    src := مسیر پرونده.پیوند(dir، "a.in")
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی(src، a.داده، a.طول))

    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ از مسیر("p_deflate.txt"، src، بایگانی.روش زیپ دیفلیت، 0))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ از مسیر("p_store.txt"، src، بایگانی.روش زیپ ذخیره، 0))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ از مسیر("p_bzip2.txt"، src، بایگانی.روش زیپ بی زیپ دو، 3))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("m_deflate.txt"، b.داده، b.طول، بایگانی.روش زیپ دیفلیت))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("m_zstd.txt"، b.داده، b.طول، بایگانی.روش زیپ زد استاندارد))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("m_lzma.txt"، b.داده، b.طول، بایگانی.روش زیپ الزد ام ای))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ رمزدار("e_classic.txt"، b.داده، b.طول، بایگانی.روش زیپ دیفلیت، 0، "one"، بایگانی.رمزگذاری زیپ کریپتو))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ رمزدار("e_aes256.txt"، b.داده، b.طول، بایگانی.روش زیپ دیفلیت، 0، "two"، بایگانی.رمزگذاری زیپ خودکار))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ رمزدار("e_aes128.txt"، b.داده، 1000، بایگانی.روش زیپ ذخیره، 0، "three"، بایگانی.رمزگذاری زیپ ای ای اس۱۲۸))
    ناپایا pa := بایگانی.ساخت ورودی پرونده زیپ از مسیر("e_path_aes192.txt"، src، بایگانی.روش زیپ دیفلیت، 0)
    pa.گذرواژه = "four"
    pa.رمزگذاری = بایگانی.رمزگذاری زیپ ای ای اس۱۹۲
    files.بیفزا(pa)
    ناپایا pc := بایگانی.ساخت ورودی پرونده زیپ از مسیر("e_path_classic.txt"، src، بایگانی.روش زیپ ذخیره، 0)
    pc.گذرواژه = "five"
    pc.رمزگذاری = بایگانی.رمزگذاری زیپ کریپتو
    files.بیفزا(pc)
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("dir/"، پوچ، 0، بایگانی.روش زیپ ذخیره))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("empty.txt"، پوچ، 0، بایگانی.روش زیپ دیفلیت))

    zip_path := مسیر پرونده.پیوند(dir، "w.zip")
    zip64_path := مسیر پرونده.پیوند(dir، "w64.zip")
    mem_path := مسیر پرونده.پیوند(dir، "wm.zip")
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده زیپ(files، zip_path))
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده زیپ بزرگ(files، zip64_path))
    ناپایا mem_zip := بایگانی.ساخت زیپ(files)
    آزمایش.ادعای درستی(mem_zip.طول بزرگتر 0)
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی از بافر(mem_path، mem_zip))
    فشرده سازی.آزادسازی بافر(mem_zip)

    هر zp در [zip_path، zip64_path، mem_path]:
        ناپایا zf := بایگانی.بازکردن پرونده زیپ(zp)
        آزمایش.ادعای برابری عدد(zf.وضعیت، بایگانی.زیپ موفق)
        آزمایش.ادعای برابری عدد(zf.شمار برگردان صحیح، 13)
        check(zf، "p_deflate.txt"، ""، a، a.طول، dir)
        check(zf، "p_store.txt"، ""، a، a.طول، dir)
        check(zf، "p_bzip2.txt"، ""، a، a.طول، dir)
        check(zf، "m_deflate.txt"، ""، b، b.طول، dir)
        check(zf، "m_zstd.txt"، ""، b، b.طول، dir)
        check(zf، "m_lzma.txt"، ""، b، b.طول، dir)
        check(zf، "e_classic.txt"، "one"، b، b.طول، dir)
        check(zf، "e_aes256.txt"، "two"، b، b.طول، dir)
        check(zf، "e_aes128.txt"، "three"، b، 1000، dir)
        check(zf، "e_path_aes192.txt"، "four"، a، a.طول، dir)
        check(zf، "e_path_classic.txt"، "five"، a، a.طول، dir)
        check(zf، "empty.txt"، ""، b، 0، dir)
        dest := مسیر پرونده.پیوند(dir، "nope.bin")
        بایگانی.تنظیم گذرواژه پرونده زیپ(zf، "")
        آزمایش.ادعای برابری عدد(بایگانی.استخراج از پرونده زیپ به پرونده(zf، "e_aes256.txt"، dest، 0 برگردان صحیح۶۴)، بایگانی.زیپ رمزگذاری شده)
        بایگانی.تنظیم گذرواژه پرونده زیپ(zf، "wrong password")
        آزمایش.ادعای برابری عدد(بایگانی.استخراج از پرونده زیپ به پرونده(zf، "e_aes256.txt"، dest، 0 برگردان صحیح۶۴)، بایگانی.زیپ گذرواژه اشتباه)
        بایگانی.بستن پرونده زیپ(zf)
    پایان

    ناپایا rok := نادرست
    ناپایا whole := بایگانی.خواندن پرونده دودویی(zip_path، rok)
    ناپایا gok := نادرست
    ناپایا one := بایگانی.استخراج با نام از زیپ(whole.داده، whole.طول، "m_deflate.txt"، gok)
    آزمایش.ادعای درستی(gok و فشرده سازی.چک جمع سی آر سی(one.داده، one.طول) برابر فشرده سازی.چک جمع سی آر سی(b.داده، b.طول) و one.طول برابر b.طول)
    فشرده سازی.آزادسازی بافر(one)
    ناپایا two := بایگانی.استخراج با نام از زیپ(whole.داده، whole.طول، "p_deflate.txt"، gok)
    آزمایش.ادعای درستی(gok و two.طول برابر a.طول و فشرده سازی.چک جمع سی آر سی(two.داده، two.طول) برابر فشرده سازی.چک جمع سی آر سی(a.داده، a.طول))
    فشرده سازی.آزادسازی بافر(two)
    فشرده سازی.آزادسازی بافر(whole)

    ناپایا many := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    تکرار 66000 در i:
        many.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("d/f" + تبدیل.قالب عدد(i برگردان صحیح۶۴)، پوچ، 0، بایگانی.روش زیپ ذخیره))
    پایان
    many_path := مسیر پرونده.پیوند(dir، "many.zip")
    آزمایش.ادعای درستی(بایگانی.ساخت پرونده زیپ(many، many_path))
    ناپایا mz := بایگانی.بازکردن پرونده زیپ(many_path)
    آزمایش.ادعای برابری عدد(mz.وضعیت، بایگانی.زیپ موفق)
    آزمایش.ادعای برابری عدد(mz.شمار برگردان صحیح، 66000)
    بایگانی.بستن پرونده زیپ(mz)

    ناپایا bad := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    bad.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("ok.txt"، b.داده، b.طول، بایگانی.روش زیپ دیفلیت))
    bad.بیفزا(بایگانی.ساخت ورودی پرونده زیپ از مسیر("gone.txt"، مسیر پرونده.پیوند(dir، "no_such_input")، بایگانی.روش زیپ دیفلیت، 0))
    never := مسیر پرونده.پیوند(dir، "never.zip")
    آزمایش.ادعای نادرستی(بایگانی.ساخت پرونده زیپ(bad، never))
    آزمایش.ادعای نادرستی(سیستم عامل.وجود دارد(never))
    ناپایا none := بایگانی.ساخت زیپ(bad)
    آزمایش.ادعای برابری عدد(none.طول، 0)
    فشرده سازی.آزادسازی بافر(none)

    فشرده سازی.آزادسازی بافر(a)
    فشرده سازی.آزادسازی بافر(b)
    سیستم عامل.حذف همه(dir)
    برگشت آزمایش.خلاصه()
پایان
