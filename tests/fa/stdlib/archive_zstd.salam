بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

پایا TAR_ZST := """
28b52ffd046865040012861311907db0413366107777857e139cf3244501e9cb223cdbf9c2a3512693565a25ef3c5a12
e051fa4f6901d23406c165dc4595f24120c465196bf00218b314fab59049a88053fe1f20a41ee49d070b1520002fcc32
ebfd690fc64c258d01a44a41001e577a0c54e2c8b80376ea006b00a316100c7b8001a63a9e9ae8531cf4c46d04150183
02d84e060e2b40389e
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع read_text(path: رشته): رشته:
    ناپایا ok := نادرست
    b := بایگانی.خواندن پرونده دودویی(path، ok)
    اگر وارونه ok:
        برگشت "missing"
    پایان
    برگشت فشرده سازی.بافر به رشته(b)
پایان

تابع ریشه:
    root := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_archive_zstd_test")
    سیستم عامل.حذف همه(root)
    سیستم عامل.ساخت پوشه ها(root)

    سرچاپ "== files =="
    plain := مسیر پرونده.پیوند(root، "plain.txt")
    packed := مسیر پرونده.پیوند(root، "plain.txt.zst")
    back := مسیر پرونده.پیوند(root، "back.txt")
    text := فشرده سازی.بافر از رشته("zstd files: the quick brown fox jumps over the lazy dog, again and again and again.\n".تکرار(4))
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(plain، text)
    سرچاپ بایگانی.فشرده سازی پرونده زستد(plain، packed)
    ناپایا ok := نادرست
    z := بایگانی.خواندن پرونده دودویی(packed، ok)
    سرچاپ ok، فشرده سازی.زستد است(z.داده، z.طول)، z.طول کوچکتر text.طول
    سرچاپ بایگانی.کدگشایی پرونده زستد(packed، back)، read_text(back) برابر فشرده سازی.بافر به رشته(text)
    سرچاپ بایگانی.فشرده سازی پرونده زستد با سطح(plain، packed، 19)، بایگانی.کدگشایی پرونده زستد(packed، back)، read_text(back) برابر فشرده سازی.بافر به رشته(text)
    سرچاپ بایگانی.فشرده سازی پرونده زستد با سطح(plain، packed، 0)، بایگانی.کدگشایی پرونده زستد(packed، back)، read_text(back) برابر فشرده سازی.بافر به رشته(text)
    سرچاپ بایگانی.کدگشایی پرونده زستد(plain، back)
    سرچاپ بایگانی.فشرده سازی پرونده زستد(مسیر پرونده.پیوند(root، "missing")، packed)
    سرچاپ بایگانی.کدگشایی پرونده زستد(مسیر پرونده.پیوند(root، "missing")، back)

    سرچاپ "== tar.zst from tar and zstd =="
    tz := unhex(TAR_ZST)
    ناپایا es := بایگانی.فهرست تار زستد(tz.داده، tz.طول، ok)
    سرچاپ ok، es.طول()
    هر e در es:
        سرچاپ e.نوع، e.پوشه، e.نام، e.اندازه
    پایان
    بایگانی.آزادسازی فهرست(es)
    out1 := مسیر پرونده.پیوند(root، "ex")
    سرچاپ بایگانی.استخراج همه از تار زستد(tz.داده، tz.طول، out1)
    سرچاپ read_text(مسیر پرونده.پیوند(out1، "a.txt")).طول()، read_text(مسیر پرونده.پیوند(out1، "sub/b.txt")).طول()، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(out1، "empty"))
    one := بایگانی.استخراج با نام از تار زستد(tz.داده، tz.طول، "a.txt"، ok)
    سرچاپ ok، فشرده سازی.بافر به رشته(one)
    miss := بایگانی.استخراج با نام از تار زستد(tz.داده، tz.طول، "nothere"، ok)
    سرچاپ ok، miss.طول
    سرچاپ بایگانی.فهرست تار زستد با سقف(tz.داده، tz.طول، 100، ok).طول()، ok
    سرچاپ بایگانی.استخراج همه از تار زستد با سقف(tz.داده، tz.طول، مسیر پرونده.پیوند(root، "capped")، 100)، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(root، "capped"))
    سرچاپ بایگانی.استخراج همه از تار زستد با سقف(tz.داده، tz.طول، مسیر پرونده.پیوند(root، "roomy")، 100000)
    one2 := بایگانی.استخراج با نام از تار زستد با سقف(tz.داده، tz.طول، "a.txt"، 100، ok)
    سرچاپ ok، one2.طول

    سرچاپ "== tar.zst made here =="
    ناپایا fl := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    d := فشرده سازی.بافر از رشته("payload\n")
    ناپایا f0 := بایگانی.ساخت ورودی پرونده تار("a.txt"، d.داده، d.طول، نادرست)
    f0.زمان تغییر = 1700000000 برگردان صحیح۶۴
    fl.بیفزا(f0)
    fl.بیفزا(بایگانی.ساخت ورودی پرونده تار("dir"، پوچ، 0، درست))
    big := فشرده سازی.بافر از رشته("0123456789".تکرار(1000))
    fl.بیفزا(بایگانی.ساخت ورودی پرونده تار("dir/big.txt"، big.داده، big.طول، نادرست))
    tg := بایگانی.ساخت تار زستد(fl)
    سرچاپ فشرده سازی.زستد است(tg.داده، tg.طول)، tg.طول کوچکتر 2000
    ناپایا tes := بایگانی.فهرست تار زستد(tg.داده، tg.طول، ok)
    سرچاپ ok، tes.طول()
    بایگانی.آزادسازی فهرست(tes)
    out2 := مسیر پرونده.پیوند(root، "made")
    سرچاپ بایگانی.استخراج همه از تار زستد(tg.داده، tg.طول، out2)
    سرچاپ read_text(مسیر پرونده.پیوند(out2، "a.txt")).پیراست()، read_text(مسیر پرونده.پیوند(out2، "dir/big.txt")).طول()
    path := مسیر پرونده.پیوند(root، "x.tar.zst")
    سرچاپ بایگانی.ساخت پرونده تار زستد(fl، path)
    fz := بایگانی.خواندن پرونده دودویی(path، ok)
    سرچاپ ok، فشرده سازی.برابری بافر(fz، tg)
    junk := فشرده سازی.بافر از رشته("not zstd data at all, just text")
    سرچاپ بایگانی.استخراج همه از تار زستد(junk.داده، junk.طول، مسیر پرونده.پیوند(root، "junk"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(root، "junk"))
    jl := بایگانی.فهرست تار زستد(junk.داده، junk.طول، ok)
    سرچاپ ok، jl.طول()

    سیستم عامل.حذف همه(root)
پایان
