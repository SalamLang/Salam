بسته ریشه

واردسازی صدا
واردسازی فشرده سازی
واردسازی آزمایش

تابع two_bytes(a: صحیح، b: صحیح): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(out، a)
    فشرده سازی.افزودن بایت(out، b)
    برگشت out
پایان

تابع ریشه:
    سرچاپ "most significant bit first"
    src := two_bytes(0xA5، 0x3C)
    ناپایا r := صدا.خواننده بیت از بافر(src)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r، 4)، 10)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r، 4)، 5)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r، 8)، 60)
    آزمایش.ادعای نادرستی(صدا.خواننده خراب(r))

    سرچاپ "single bits"
    ناپایا r2 := صدا.خواننده بیت از بافر(src)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت(r2)، 1)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت(r2)، 0)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت(r2)، 1)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت(r2)، 0)
    آزمایش.ادعای برابری عدد(صدا.جای خواننده(r2)، 4)

    سرچاپ "wide and signed reads"
    ناپایا r3 := صدا.خواننده بیت از بافر(src)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r3، 16)، 0xA53C)
    ناپایا r4 := صدا.خواننده بیت از بافر(src)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها علامتدار(r4، 4)، -6)
    ناپایا r5 := صدا.خواننده بیت از بافر(src)
    آزمایش.ادعای برابری عدد۶۴(صدا.خواندن بیت‌ها بزرگ(r5، 16)، 0xA53C برگردان صحیح۶۴)
    ناپایا r6 := صدا.خواننده بیت از بافر(src)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r6، 0)، 0)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r6، 33)، 0)

    سرچاپ "unary codes"
    ناپایا uw := صدا.نویسنده بیت جدید()
    صدا.نوشتن یکانی(uw، 0)
    صدا.نوشتن یکانی(uw، 3)
    صدا.نوشتن یکانی(uw، 5)
    ubuf := صدا.پایان نویسنده(uw)
    ناپایا ur := صدا.خواننده بیت از بافر(ubuf)
    آزمایش.ادعای برابری عدد(صدا.خواندن یکانی(ur)، 0)
    آزمایش.ادعای برابری عدد(صدا.خواندن یکانی(ur)، 3)
    آزمایش.ادعای برابری عدد(صدا.خواندن یکانی(ur)، 5)

    سرچاپ "skip, align and seek"
    ناپایا r7 := صدا.خواننده بیت از بافر(src)
    صدا.پرش بیت(r7، 8)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r7، 8)، 60)
    ناپایا r8 := صدا.خواننده بیت از بافر(src)
    صدا.خواندن بیت‌ها(r8، 3)
    صدا.همتراز کردن خواننده(r8)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r8، 8)، 60)
    ناپایا r9 := صدا.خواننده بیت از بافر(src)
    صدا.جابجایی خواننده(r9، 8)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r9، 8)، 60)
    صدا.جابجایی خواننده(r9، 4)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r9، 4)، 5)
    ناپایا r10 := صدا.خواننده بیت از بافر(src)
    آزمایش.ادعای برابری عدد(صدا.باقیمانده خواننده(r10)، 16)
    صدا.خواندن بیت‌ها(r10، 5)
    آزمایش.ادعای برابری عدد(صدا.باقیمانده خواننده(r10)، 11)

    سرچاپ "reading past the end sets the bad flag"
    ناپایا short := صدا.خواننده بیت جدید(src.داده، 1)
    صدا.خواندن بیت‌ها(short، 16)
    آزمایش.ادعای درستی(صدا.خواننده خراب(short))

    سرچاپ "writer round-trip"
    ناپایا w := صدا.نویسنده بیت جدید()
    صدا.نوشتن بیت‌ها(w، 10، 4)
    صدا.نوشتن بیت‌ها(w، 5، 4)
    صدا.نوشتن بیت‌ها(w، 60، 8)
    out := صدا.پایان نویسنده(w)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(out)، 2)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(out، 0)، 0xA5)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(out، 1)، 0x3C)

    سرچاپ "writer pads the last byte"
    ناپایا w2 := صدا.نویسنده بیت جدید()
    صدا.نوشتن بیت‌ها(w2، 1، 1)
    آزمایش.ادعای برابری عدد(صدا.طول نویسنده(w2)، 0)
    out2 := صدا.پایان نویسنده(w2)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(out2)، 1)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(out2، 0)، 128)

    سرچاپ "a long value survives the full width"
    ناپایا w3 := صدا.نویسنده بیت جدید()
    صدا.نوشتن بیت‌ها(w3، 0x123456 برگردان صحیح۶۴، 24)
    out3 := صدا.پایان نویسنده(w3)
    ناپایا r11 := صدا.خواننده بیت از بافر(out3)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r11، 24)، 0x123456)

    صدا.آزادسازی نویسنده(w)
    صدا.آزادسازی نویسنده(w2)
    صدا.آزادسازی نویسنده(w3)
    صدا.آزادسازی نویسنده(uw)
    فشرده سازی.آزادسازی بافر(src)
    برگشت آزمایش.خلاصه()
پایان
