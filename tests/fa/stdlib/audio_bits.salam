بسته ریشه

واردسازی صدا
واردسازی فشرده سازی
واردسازی آزمایش

تابع دو بایت(a: صحیح، b: صحیح): فشرده سازی.بافر بایت:
    ناپایا خروجی := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(خروجی، a)
    فشرده سازی.افزودن بایت(خروجی، b)
    برگشت خروجی
پایان

تابع ریشه:
    سرچاپ "most significant bit first"
    ناپایا منبع := دو بایت(0xA5، 0x3C)
    ناپایا r := صدا.خواننده بیت از بافر(منبع)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r، 4)، 10)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r، 4)، 5)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(r، 8)، 60)
    آزمایش.ادعای نادرستی(صدا.خواننده خراب(r))

    سرچاپ "single bits"
    ناپایا خواننده۲ := صدا.خواننده بیت از بافر(منبع)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت(خواننده۲)، 1)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت(خواننده۲)، 0)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت(خواننده۲)، 1)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت(خواننده۲)، 0)
    آزمایش.ادعای برابری عدد(صدا.جای خواننده(خواننده۲)، 4)

    سرچاپ "wide and signed reads"
    ناپایا خواننده۳ := صدا.خواننده بیت از بافر(منبع)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(خواننده۳، 16)، 0xA53C)
    ناپایا خواننده۴ := صدا.خواننده بیت از بافر(منبع)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها علامتدار(خواننده۴، 4)، -6)
    ناپایا خواننده۵ := صدا.خواننده بیت از بافر(منبع)
    آزمایش.ادعای برابری عدد۶۴(صدا.خواندن بیت‌ها بزرگ(خواننده۵، 16)، 0xA53C برگردان صحیح۶۴)
    ناپایا خواننده۶ := صدا.خواننده بیت از بافر(منبع)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(خواننده۶، 0)، 0)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(خواننده۶، 33)، 0)

    سرچاپ "unary codes"
    ناپایا نویسنده یکانی := صدا.نویسنده بیت جدید()
    صدا.نوشتن یکانی(نویسنده یکانی، 0)
    صدا.نوشتن یکانی(نویسنده یکانی، 3)
    صدا.نوشتن یکانی(نویسنده یکانی، 5)
    بافر یکانی := صدا.پایان نویسنده(نویسنده یکانی)
    ناپایا خواننده یکانی := صدا.خواننده بیت از بافر(بافر یکانی)
    آزمایش.ادعای برابری عدد(صدا.خواندن یکانی(خواننده یکانی)، 0)
    آزمایش.ادعای برابری عدد(صدا.خواندن یکانی(خواننده یکانی)، 3)
    آزمایش.ادعای برابری عدد(صدا.خواندن یکانی(خواننده یکانی)، 5)

    سرچاپ "skip, align and seek"
    ناپایا خواننده۷ := صدا.خواننده بیت از بافر(منبع)
    صدا.پرش بیت(خواننده۷، 8)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(خواننده۷، 8)، 60)
    ناپایا خواننده۸ := صدا.خواننده بیت از بافر(منبع)
    صدا.خواندن بیت‌ها(خواننده۸، 3)
    صدا.همتراز کردن خواننده(خواننده۸)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(خواننده۸، 8)، 60)
    ناپایا خواننده۹ := صدا.خواننده بیت از بافر(منبع)
    صدا.جابجایی خواننده(خواننده۹، 8)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(خواننده۹، 8)، 60)
    صدا.جابجایی خواننده(خواننده۹، 4)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(خواننده۹، 4)، 5)
    ناپایا خواننده۱۰ := صدا.خواننده بیت از بافر(منبع)
    آزمایش.ادعای برابری عدد(صدا.باقیمانده خواننده(خواننده۱۰)، 16)
    صدا.خواندن بیت‌ها(خواننده۱۰، 5)
    آزمایش.ادعای برابری عدد(صدا.باقیمانده خواننده(خواننده۱۰)، 11)

    سرچاپ "reading past the end sets the bad flag"
    ناپایا کوتاه := صدا.خواننده بیت جدید(منبع.داده، 1)
    صدا.خواندن بیت‌ها(کوتاه، 16)
    آزمایش.ادعای درستی(صدا.خواننده خراب(کوتاه))

    سرچاپ "writer round-trip"
    ناپایا w := صدا.نویسنده بیت جدید()
    صدا.نوشتن بیت‌ها(w، 10، 4)
    صدا.نوشتن بیت‌ها(w، 5، 4)
    صدا.نوشتن بیت‌ها(w، 60، 8)
    خروجی := صدا.پایان نویسنده(w)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(خروجی)، 2)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(خروجی، 0)، 0xA5)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(خروجی، 1)، 0x3C)

    سرچاپ "writer pads the last byte"
    ناپایا نویسنده۲ := صدا.نویسنده بیت جدید()
    صدا.نوشتن بیت‌ها(نویسنده۲، 1، 1)
    آزمایش.ادعای برابری عدد(صدا.طول نویسنده(نویسنده۲)، 0)
    خروجی۲ := صدا.پایان نویسنده(نویسنده۲)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(خروجی۲)، 1)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(خروجی۲، 0)، 128)

    سرچاپ "a long value survives the full width"
    ناپایا نویسنده۳ := صدا.نویسنده بیت جدید()
    صدا.نوشتن بیت‌ها(نویسنده۳، 0x123456 برگردان صحیح۶۴، 24)
    خروجی۳ := صدا.پایان نویسنده(نویسنده۳)
    ناپایا خواننده۱۱ := صدا.خواننده بیت از بافر(خروجی۳)
    آزمایش.ادعای برابری عدد(صدا.خواندن بیت‌ها(خواننده۱۱، 24)، 0x123456)

    صدا.آزادسازی نویسنده(w)
    صدا.آزادسازی نویسنده(نویسنده۲)
    صدا.آزادسازی نویسنده(نویسنده۳)
    صدا.آزادسازی نویسنده(نویسنده یکانی)
    فشرده سازی.آزادسازی بافر(منبع)
    برگشت آزمایش.خلاصه()
پایان
