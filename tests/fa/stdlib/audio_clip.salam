بسته ریشه

واردسازی صدا
واردسازی ریاضی
واردسازی آزمایش

تابع شیب(نرخ: صحیح، کانال: صحیح، فریم: صحیح): صدا.قطعه:
    ناپایا نو := صدا.جدید(نرخ، کانال، فریم)
    ناپایا ش := 0
    تا ش کوچکتر فریم:
        ناپایا ک := 0
        تا ک کوچکتر کانال:
            صدا.تنظیم نمونه(نو، ش، ک، ((ش * کانال + ک) برگردان اعشار۶۴) / 64.0)
            ک += 1
        پایان
        ش += 1
    پایان
    برگشت نو
پایان

تابع ریشه:
    سرچاپ "هسته"
    ناپایا ق := صدا.جدید(44100، 2، 100)
    آزمایش.ادعای نادرستی(صدا.خالی است(ق))
    آزمایش.ادعای برابری عدد(ق.نرخ، 44100)
    آزمایش.ادعای برابری عدد(ق.کانال ها، 2)
    آزمایش.ادعای برابری عدد(ق.فریم ها، 100)
    آزمایش.ادعای برابری عدد(صدا.شمار نمونه(ق)، 200)
    آزمایش.ادعای برابری عدد(ق.بیت ها، 0)
    آزمایش.ادعا(صدا.خالی است(صدا.جدید(0، 2، 10)))

    سرچاپ "دسترسی"
    صدا.تنظیم نمونه(ق، 0، 0، 0.5)
    صدا.تنظیم نمونه(ق، 0، 1، -0.25)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(ق، 0، 0)، 0.5، 0.0)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(ق، 0، 1)، -0.25، 0.0)
    صدا.افزودن نمونه(ق، 0، 0، 0.25)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(ق، 0، 0)، 0.75، 0.0)
    آزمایش.ادعا(صدا.در محدوده(ق، 99، 1))
    آزمایش.ادعای نادرستی(صدا.در محدوده(ق، 100، 0))
    آزمایش.ادعای برابری اعشار(صدا.نمونه(ق، 500، 0)، 0.0، 0.0)

    سرچاپ "زمان"
    د := صدا.جدید(8000، 1، 4000)
    آزمایش.ادعای برابری اعشار(صدا.مدت(د)، 0.5، 0.0)
    آزمایش.ادعای برابری عدد(صدا.فریم در زمان(د، 0.25)، 2000)
    آزمایش.ادعای برابری اعشار(صدا.ثانیه در فریم(د، 2000)، 0.25، 0.0)
    س := صدا.سکوت جدید(8000، 1، 0.5)
    آزمایش.ادعای برابری عدد(س.فریم ها، 4000)

    سرچاپ "سنجش"
    ناپایا م := صدا.جدید(8000، 1، 4)
    صدا.تنظیم نمونه(م، 0، 0، 1.0)
    صدا.تنظیم نمونه(م، 1، 0، -0.5)
    صدا.تنظیم نمونه(م، 3، 0، 0.25)
    آزمایش.ادعای برابری اعشار(صدا.اوج(م)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(صدا.جذر میانگین مربع(م)، ریاضی.جذر(0.328125)، 0.000000001)
    آزمایش.ادعای برابری اعشار(صدا.بهره به دسیبل(1.0)، 0.0، 0.0)
    آزمایش.ادعای برابری اعشار(صدا.دسیبل به بهره(0.0)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(صدا.بهره به دسیبل(0.0)، صدا.کف سکوت، 0.0)
    آزمایش.ادعای برابری اعشار(صدا.انحراف جریان مستقیم(م)، 0.1875، 0.000000001)
    آزمایش.ادعا(صدا.بریده است(م))
    آزمایش.ادعای برابری عدد(صدا.شمار بریده(م)، 1)
    آزمایش.ادعای نادرستی(صدا.ساکت است(م، -60.0))
    آزمایش.ادعای برابری عدد(صدا.نخستین صدا(م، -60.0)، 0)
    آزمایش.ادعای برابری عدد(صدا.آخرین صدا(م، -60.0)، 3)

    سرچاپ "ویرایش"
    ر := شیب(8000، 1، 8)
    بریده := صدا.برش(ر، 2، 3)
    آزمایش.ادعای برابری عدد(بریده.فریم ها، 3)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(بریده، 0، 0)، 2.0 / 64.0، 0.0)
    ناپایا واگرد := صدا.کپی(ر)
    صدا.وارونه کردن(واگرد)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(واگرد، 0، 0)، 7.0 / 64.0، 0.0)
    پیو := صدا.پیوند(بریده، بریده)
    آزمایش.ادعای برابری عدد(پیو.فریم ها، 6)
    تکر := صدا.تکرار صدا(بریده، 4)
    آزمایش.ادعای برابری عدد(تکر.فریم ها، 12)
    آم := صدا.آمیختن(ر، ر، 1.0، 1.0)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(آم، 3، 0)، 6.0 / 64.0، 0.0)
    ناپایا گ := صدا.کپی(ر)
    صدا.مقیاس(گ، 2.0)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(گ، 1، 0)، 2.0 / 64.0، 0.0)
    ناپایا هن := صدا.کپی(ر)
    صدا.هنجارسازی(هن، 0.0)
    آزمایش.ادعای برابری اعشار(صدا.اوج(هن)، 1.0، 0.000000001)
    ناپایا مح := صدا.کپی(ر)
    صدا.محو ورودی(مح، صدا.مدت(مح))
    آزمایش.ادعای برابری اعشار(صدا.نمونه(مح، 0، 0)، 0.0، 0.0)
    ناپایا سر := صدا.قطعه {}
    ناپایا دنباله := صدا.قطعه {}
    صدا.شکافتن(ر، 0.0005، سر، دنباله)
    آزمایش.ادعای برابری عدد(سر.فریم ها، 4)
    آزمایش.ادعای برابری عدد(دنباله.فریم ها، 4)

    سرچاپ "برگردان"
    دو := شیب(8000، 2، 4)
    تک := صدا.به یک‌کاناله(دو)
    آزمایش.ادعای برابری عدد(تک.کانال ها، 1)
    پهن := صدا.به دوکاناله(تک)
    آزمایش.ادعای برابری عدد(پهن.کانال ها، 2)
    کانالی := صدا.کانال(دو، 1)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(کانالی، 0، 0)، 1.0 / 64.0، 0.0)
    ناپایا تکه‌ها := صدا.جداسازی کانال‌ها(دو)
    آزمایش.ادعای برابری عدد(تکه‌ها.طول()، 2)
    بافته := صدا.درهم‌بافی کانال‌ها(تکه‌ها)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(بافته، 2، 1)، صدا.نمونه(دو، 2، 1)، 0.0)
    نیم := صدا.به نرخ(شیب(8000، 1، 8)، 4000)
    آزمایش.ادعای برابری عدد(نیم.نرخ، 4000)
    آزمایش.ادعای برابری عدد(نیم.فریم ها، 4)
    چهار := صدا.به بیت(شیب(8000، 1، 8)، 4)
    آزمایش.ادعای برابری عدد(چهار.بیت ها، 4)

    سرچاپ "ساکت کردن و آزادسازی"
    ناپایا ز := صدا.کپی(ر)
    صدا.ساکت کردن(ز)
    آزمایش.ادعای برابری اعشار(صدا.اوج(ز)، 0.0، 0.0)
    صدا.آزادسازی(ز)
    آزمایش.ادعا(صدا.خالی است(ز))
    آزمایش.ادعای برابری عدد(ز.فریم ها، 0)

    برگشت آزمایش.خلاصه()
پایان
