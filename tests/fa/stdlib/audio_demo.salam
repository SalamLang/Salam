بسته ریشه

واردسازی صدا
واردسازی صدا.کدک
واردسازی صدا.پردازش سیگنال
واردسازی صدا.ویو
واردسازی فشرده سازی
واردسازی ریاضی
واردسازی حافظه
واردسازی مسیر پرونده
واردسازی سیستم عامل
واردسازی آزمایش

تابع chord(rate: صحیح، seconds: اعشار۶۴): صدا.قطعه:
    frames := ((rate برگردان اعشار۶۴) * seconds) برگردان صحیح
    ناپایا c := صدا.جدید(rate، 2، frames)
    ناپایا f := 0
    تا f کوچکتر frames:
        t := (f برگردان اعشار۶۴) / (rate برگردان اعشار۶۴)
        ناپایا v := 0.3 * ریاضی.سینوس(2.0 * ریاضی.پی * 220.0 * t)
        v += 0.2 * ریاضی.سینوس(2.0 * ریاضی.پی * 277.18 * t)
        v += 0.2 * ریاضی.سینوس(2.0 * ریاضی.پی * 329.63 * t)
        صدا.تنظیم نمونه(c، f، 0، v)
        صدا.تنظیم نمونه(c، f، 1، v * 0.8)
        f += 1
    پایان
    برگشت c
پایان

تابع ریشه:
    سرچاپ "build a three note chord"
    ناپایا song := chord(44100، 0.25)
    آزمایش.ادعای برابری عدد(song.فریم ها، 11025)
    آزمایش.ادعای برابری عدد(song.کانال ها، 2)
    آزمایش.ادعا با پیام(صدا.اوج(song) بزرگتر 0.1، "the chord should make sound")

    سرچاپ "shape it"
    صدا.هنجارسازی(song، -1.0)
    آزمایش.ادعای برابری اعشار(صدا.اوج(song)، صدا.دسیبل به بهره(-1.0)، 0.000001)
    صدا.محو ورودی(song، 0.02)
    صدا.محو خروجی(song، 0.05)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(song، 0، 0)، 0.0، 0.0)
    lp := پردازش سیگنال.صافی پایین(2000.0، 0.707، 44100)
    پردازش سیگنال.پردازش همه کانال‌ها(lp، song)
    آزمایش.ادعای نادرستی(صدا.بریده است(song))

    سرچاپ "find the lowest note in the spectrum"
    mono := صدا.به یک‌کاناله(song)
    n := 8192
    ناپایا re := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا im := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا i := 0
    تا i کوچکتر n:
        w := پردازش سیگنال.مقدار پنجره(پردازش سیگنال.پنجره هان، i، n، 0.0)
        re.بیفزا(صدا.نمونه(mono، i + 1024، 0) * w)
        im.بیفزا(0.0)
        i += 1
    پایان
    آزمایش.ادعای درستی(پردازش سیگنال.تبدیل فوریه برداری(re، im))
    mags := پردازش سیگنال.اندازه(re.ارجاع(0)، im.ارجاع(0)، n / 2)
    peak := پردازش سیگنال.خانه اوج(mags)
    freq := پردازش سیگنال.بسامد خانه(peak، n، 44100)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(freq - 220.0) کوچکتر 10.0، "the strongest partial should be the root")

    سرچاپ "write it, read it back and check it survived"
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_demo.wav")
    دیرکن حافظه.آزادسازی(path برگردان تهی*)
    آزمایش.ادعای درستی(کدک.ذخیره(song، path))
    ناپایا ok := نادرست
    ناپایا back := کدک.بازکردن(path، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای برابری عدد(back.فریم ها، song.فریم ها)
    آزمایش.ادعای برابری عدد(back.بیت ها، 16)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(song، back) بزرگتر 0.9999، "the file should match what was written")

    سرچاپ "resample it for a smaller file"
    small := پردازش سیگنال.بازنمونه سینک(back، 22050، 16)
    آزمایش.ادعای برابری عدد(small.نرخ، 22050)
    آزمایش.ادعای برابری عدد(small.فریم ها، 5512)
    quiet := ویو.کدگذاری میولا(small)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(quiet)، 44 + 5512 * 2)
    full := ویو.کدگذاری ویو با بیت(small، 16)
    آزمایش.ادعا با پیام((فشرده سازی.طول بافر(quiet) - 44) * 2 برابر فشرده سازی.طول بافر(full) - 44، "mu-law should halve the data")

    سرچاپ "report"
    ناپایا pok := نادرست
    info := کدک.بررسی پرونده(path، pok)
    آزمایش.ادعای درستی(pok)
    آزمایش.ادعای برابری رشته(صدا.نام قالب(info.قالب)، "wav")
    آزمایش.ادعای برابری عدد(info.کانال ها، 2)
    آزمایش.ادعای درستی(info.بی اتلاف)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(info.مدت - 0.25) کوچکتر 0.001، "a quarter of a second")

    فشرده سازی.آزادسازی بافر(quiet)
    فشرده سازی.آزادسازی بافر(full)
    re.آزادکن()
    im.آزادکن()
    mags.آزادکن()
    صدا.آزادسازی(song)
    صدا.آزادسازی(mono)
    صدا.آزادسازی(back)
    صدا.آزادسازی(small)
    برگشت آزمایش.خلاصه()
پایان
