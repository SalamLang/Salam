بسته ریشه

واردسازی صدا
واردسازی صدا.کدک
واردسازی صدا.پردازش سیگنال
واردسازی صدا.ویو
واردسازی فشرده سازی
واردسازی ریاضی
واردسازی حافظه
واردسازی مسیر پرونده
واردسازی سیستم عامل
واردسازی آزمایش

تابع آکورد(نرخ نمونه: صحیح، ثانیه: اعشار۶۴): صدا.قطعه:
    تعداد فریم := ((نرخ نمونه برگردان اعشار۶۴) * ثانیه) برگردان صحیح
    ناپایا c := صدا.جدید(نرخ نمونه، 2، تعداد فریم)
    ناپایا f := 0
    تا f کوچکتر تعداد فریم:
        t := (f برگردان اعشار۶۴) / (نرخ نمونه برگردان اعشار۶۴)
        ناپایا v := 0.3 * ریاضی.سینوس(2.0 * ریاضی.پی * 220.0 * t)
        v += 0.2 * ریاضی.سینوس(2.0 * ریاضی.پی * 277.18 * t)
        v += 0.2 * ریاضی.سینوس(2.0 * ریاضی.پی * 329.63 * t)
        صدا.تنظیم نمونه(c، f، 0، v)
        صدا.تنظیم نمونه(c، f، 1، v * 0.8)
        f += 1
    پایان
    برگشت c
پایان

تابع ریشه:
    سرچاپ "build a three note chord"
    ناپایا آهنگ := آکورد(44100، 0.25)
    آزمایش.ادعای برابری عدد(آهنگ.فریم ها، 11025)
    آزمایش.ادعای برابری عدد(آهنگ.کانال ها، 2)
    آزمایش.ادعا با پیام(صدا.اوج(آهنگ) بزرگتر 0.1، "the chord should make sound")

    سرچاپ "shape it"
    صدا.هنجارسازی(آهنگ، -1.0)
    آزمایش.ادعای برابری اعشار(صدا.اوج(آهنگ)، صدا.دسیبل به بهره(-1.0)، 0.000001)
    صدا.محو ورودی(آهنگ، 0.02)
    صدا.محو خروجی(آهنگ، 0.05)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(آهنگ، 0، 0)، 0.0، 0.0)
    صافی := پردازش سیگنال.صافی پایین(2000.0، 0.707، 44100)
    پردازش سیگنال.پردازش همه کانال‌ها(صافی، آهنگ)
    آزمایش.ادعای نادرستی(صدا.بریده است(آهنگ))

    سرچاپ "find the lowest note in the spectrum"
    ناپایا تک‌کاناله := صدا.به یک‌کاناله(آهنگ)
    n := 8192
    ناپایا حقیقی := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا موهومی := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا i := 0
    تا i کوچکتر n:
        w := پردازش سیگنال.مقدار پنجره(پردازش سیگنال.پنجره هان، i، n، 0.0)
        حقیقی.بیفزا(صدا.نمونه(تک‌کاناله، i + 1024، 0) * w)
        موهومی.بیفزا(0.0)
        i += 1
    پایان
    آزمایش.ادعای درستی(پردازش سیگنال.تبدیل فوریه برداری(حقیقی، موهومی))
    اندازه‌ها := پردازش سیگنال.اندازه(حقیقی.ارجاع(0)، موهومی.ارجاع(0)، n / 2)
    اوج := پردازش سیگنال.خانه اوج(اندازه‌ها)
    بسامد := پردازش سیگنال.بسامد خانه(اوج، n، 44100)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(بسامد - 220.0) کوچکتر 10.0، "the strongest partial should be the root")

    سرچاپ "write it, read it back and check it survived"
    مسیر := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_demo.wav")
    دیرکن حافظه.آزادسازی(مسیر برگردان تهی*)
    آزمایش.ادعای درستی(کدک.ذخیره(آهنگ، مسیر))
    ناپایا موفق := نادرست
    ناپایا بازخوانی := کدک.بازکردن(مسیر، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای برابری عدد(بازخوانی.فریم ها، آهنگ.فریم ها)
    آزمایش.ادعای برابری عدد(بازخوانی.بیت ها، 16)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(آهنگ، بازخوانی) بزرگتر 0.9999، "the file should match what was written")

    سرچاپ "resample it for a smaller file"
    ناپایا کوچک := پردازش سیگنال.بازنمونه سینک(بازخوانی، 22050، 16)
    آزمایش.ادعای برابری عدد(کوچک.نرخ، 22050)
    آزمایش.ادعای برابری عدد(کوچک.فریم ها، 5512)
    ناپایا میولا := ویو.کدگذاری میولا(کوچک)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(میولا)، 44 + 5512 * 2)
    ناپایا کامل := ویو.کدگذاری ویو با بیت(کوچک، 16)
    آزمایش.ادعا با پیام((فشرده سازی.طول بافر(میولا) - 44) * 2 برابر فشرده سازی.طول بافر(کامل) - 44، "mu-law should halve the data")

    سرچاپ "report"
    ناپایا بررسی موفق := نادرست
    اطلاعات := کدک.بررسی پرونده(مسیر، بررسی موفق)
    آزمایش.ادعای درستی(بررسی موفق)
    آزمایش.ادعای برابری رشته(صدا.نام قالب(اطلاعات.قالب)، "wav")
    آزمایش.ادعای برابری عدد(اطلاعات.کانال ها، 2)
    آزمایش.ادعای درستی(اطلاعات.بی اتلاف)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(اطلاعات.مدت - 0.25) کوچکتر 0.001، "a quarter of a second")

    فشرده سازی.آزادسازی بافر(میولا)
    فشرده سازی.آزادسازی بافر(کامل)
    حقیقی.آزادکن()
    موهومی.آزادکن()
    اندازه‌ها.آزادکن()
    صدا.آزادسازی(آهنگ)
    صدا.آزادسازی(تک‌کاناله)
    صدا.آزادسازی(بازخوانی)
    صدا.آزادسازی(کوچک)
    برگشت آزمایش.خلاصه()
پایان
