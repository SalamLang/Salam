/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی ریاضی
واردسازی آزمایش

تابع tone(rate: صحیح، freq: اعشار۶۴، frames: صحیح): صدا.قطعه:
    ناپایا c := صدا.جدید(rate، 1، frames)
    ناپایا i := 0
    تا i کوچکتر frames:
        صدا.تنظیم نمونه(c، i، 0، ریاضی.سینوس(2.0 * ریاضی.پی * freq * (i برگردان اعشار۶۴) / (rate برگردان اعشار۶۴)))
        i += 1
    پایان
    برگشت c
پایان

تابع ریشه:
    سرچاپ "powers of two"
    آزمایش.ادعای درستی(پردازش سیگنال.توان دو است(1024))
    آزمایش.ادعای نادرستی(پردازش سیگنال.توان دو است(1000))
    آزمایش.ادعای نادرستی(پردازش سیگنال.توان دو است(0))
    آزمایش.ادعای برابری عدد(پردازش سیگنال.توان دو بعدی(1000)، 1024)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.توان دو بعدی(1024)، 1024)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.توان دو بعدی(1)، 1)

    سرچاپ "complex arithmetic"
    a := پردازش سیگنال.مختلط { حقیقی = 3.0، موهومی = 4.0 }
    b := پردازش سیگنال.مختلط { حقیقی = 1.0، موهومی = -2.0 }
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.اندازه مختلط(a)، 5.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.جمع مختلط(a، b).حقیقی، 4.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.جمع مختلط(a، b).موهومی، 2.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.تفریق مختلط(a، b).موهومی، 6.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ضرب مختلط(a، b).حقیقی، 11.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ضرب مختلط(a، b).موهومی، -2.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.مقیاس مختلط(a، 2.0).حقیقی، 6.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.همیوغ مختلط(a).موهومی، -4.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.زاویه مختلط(پردازش سیگنال.مختلط { حقیقی = 0.0، موهومی = 1.0 })، ریاضی.پی / 2.0، 0.000000001)
    polar := پردازش سیگنال.مختلط از قطبی(2.0، 0.0)
    آزمایش.ادعای برابری اعشار(polar.حقیقی، 2.0، 0.000000001)

    سرچاپ "a complex exponential gives one peak"
    n := 64
    k := 5
    ناپایا re := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا im := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا re0 := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا im0 := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا i := 0
    تا i کوچکتر n:
        ang := 2.0 * ریاضی.پی * (k برگردان اعشار۶۴) * (i برگردان اعشار۶۴) / (n برگردان اعشار۶۴)
        re.بیفزا(ریاضی.کسینوس(ang))
        im.بیفزا(ریاضی.سینوس(ang))
        re0.بیفزا(ریاضی.کسینوس(ang))
        im0.بیفزا(ریاضی.سینوس(ang))
        i += 1
    پایان
    آزمایش.ادعای درستی(پردازش سیگنال.تبدیل فوریه برداری(re، im))
    mags := پردازش سیگنال.اندازه(re.ارجاع(0)، im.ارجاع(0)، n)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.خانه اوج(mags)، k)
    آزمایش.ادعای برابری اعشار(mags.بگیر(k)، n برگردان اعشار۶۴، 0.000001)
    ناپایا leak := 0.0
    ناپایا bin := 0
    تا bin کوچکتر n:
        اگر bin نابرابر k و mags.بگیر(bin) بزرگتر leak:
            leak = mags.بگیر(bin)
        پایان
        bin += 1
    پایان
    آزمایش.ادعا با پیام(leak کوچکتر 0.000000001، "energy should not leak outside the peak bin")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.بسامد خانه(k، n، 48000)، 3750.0، 0.000000001)

    سرچاپ "the inverse puts it back"
    آزمایش.ادعای درستی(پردازش سیگنال.تبدیل فوریه وارون برداری(re، im))
    ناپایا worst := 0.0
    ناپایا m := 0
    تا m کوچکتر n:
        d := ریاضی.قدرمطلق(re.بگیر(m) - re0.بگیر(m))
        اگر d بزرگتر worst:
            worst = d
        پایان
        e := ریاضی.قدرمطلق(im.بگیر(m) - im0.بگیر(m))
        اگر e بزرگتر worst:
            worst = e
        پایان
        m += 1
    پایان
    آزمایش.ادعا با پیام(worst کوچکتر 0.000000001، "the round-trip should return the input")
    آزمایش.ادعای نادرستی(پردازش سیگنال.تبدیل فوریه(re.ارجاع(0)، im.ارجاع(0)، 15))
    آزمایش.ادعای برابری عدد(پردازش سیگنال.خانه اوج(وکتور {} برگردان وکتور<اعشار۶۴>)، -1)

    سرچاپ "windows"
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.بسل صفر(0.0)، 1.0، 0.000000001)
    hann := پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره هان، 9، 0.0)
    آزمایش.ادعای برابری عدد(hann.طول()، 9)
    آزمایش.ادعای برابری اعشار(hann.بگیر(0)، 0.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(hann.بگیر(8)، 0.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(hann.بگیر(4)، 1.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.مقدار پنجره(پردازش سیگنال.پنجره مستطیلی، 0، 9، 0.0)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.مقدار پنجره(پردازش سیگنال.پنجره همینگ، 0، 9، 0.0)، 0.08، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره کایزر، 9، 8.6).بگیر(4)، 1.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره بلکمن، 9، 0.0).بگیر(4)، 1.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره سینوسی، 9، 0.0).بگیر(4)، 1.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره وربیس، 9، 0.0).بگیر(0)، 0.0، 0.000000001)
    آزمایش.ادعای برابری رشته(پردازش سیگنال.نام پنجره(پردازش سیگنال.پنجره هان)، "hann")
    آزمایش.ادعای برابری رشته(پردازش سیگنال.نام پنجره(99)، "unknown")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.جمع پنجره(پردازش سیگنال.پنجره مستطیلی، 8، 0.0)، 8.0، 0.0)
    ناپایا wbuf := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا wi := 0
    تا wi کوچکتر 8:
        wbuf.بیفزا(1.0)
        wi += 1
    پایان
    پردازش سیگنال.اعمال پنجره(wbuf.ارجاع(0)، 8، پردازش سیگنال.پنجره هان، 0.0)
    آزمایش.ادعای برابری اعشار(wbuf.بگیر(0)، 0.0، 0.000000001)

    سرچاپ "biquad responses follow the cookbook"
    lp := پردازش سیگنال.صافی پایین(1000.0، 0.707، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(lp، 100.0، 48000) بزرگتر 0.99، "a low pass should pass 100 Hz")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(lp، 1000.0، 48000)، 0.7071، 0.01)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(lp، 10000.0، 48000) کوچکتر 0.02، "a low pass should stop 10 kHz")
    hp := پردازش سیگنال.صافی بالا(1000.0، 0.707، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(hp، 10000.0، 48000) بزرگتر 0.99، "a high pass should pass 10 kHz")
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(hp، 100.0، 48000) کوچکتر 0.02، "a high pass should stop 100 Hz")
    bp := پردازش سیگنال.صافی میان(1000.0، 1.0، 48000)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(bp، 1000.0، 48000)، 1.0، 0.01)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(bp، 100.0، 48000) کوچکتر 0.2، "a band pass should stop 100 Hz")
    nt := پردازش سیگنال.صافی شکاف(1000.0، 1.0، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(nt، 1000.0، 48000) کوچکتر 0.01، "a notch should stop its centre")
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(nt، 100.0، 48000) بزرگتر 0.9، "a notch should pass elsewhere")
    ap := پردازش سیگنال.صافی همه(1000.0، 0.707، 48000)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(ap، 500.0، 48000)، 1.0، 0.000001)
    pk := پردازش سیگنال.قله(1000.0، 1.0، 6.0، 48000)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(pk، 1000.0، 48000)، 1.9952623149688795، 0.01)
    ls := پردازش سیگنال.قفسه پایین(1000.0، 0.707، 6.0، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(ls، 50.0، 48000) بزرگتر 1.9، "a low shelf should lift the bottom")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(ls، 20000.0، 48000)، 1.0، 0.05)
    hs := پردازش سیگنال.قفسه بالا(1000.0، 0.707، 6.0، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(hs، 20000.0، 48000) بزرگتر 1.9، "a high shelf should lift the top")

    سرچاپ "filtering a real tone"
    ناپایا hi := tone(48000، 10000.0، 2048)
    before := صدا.جذر میانگین مربع(hi)
    پردازش سیگنال.پردازش همه کانال‌ها(lp، hi)
    after := صدا.جذر میانگین مربع(hi)
    آزمایش.ادعا با پیام(صدا.بهره به دسیبل(after / before) کوچکتر -20.0، "the low pass should cut a 10 kHz tone")
    ناپایا lo := tone(48000، 100.0، 2048)
    lo_before := صدا.جذر میانگین مربع(lo)
    پردازش سیگنال.پردازش همه کانال‌ها(lp، lo)
    آزمایش.ادعا با پیام(صدا.بهره به دسیبل(صدا.جذر میانگین مربع(lo) / lo_before) بزرگتر -1.0، "the low pass should keep a 100 Hz tone")
    ناپایا step := پردازش سیگنال.صافی پایین(1000.0، 0.707، 48000)
    پردازش سیگنال.گام دوقطبی(step، 1.0)
    پردازش سیگنال.بازنشانی دوقطبی(step)
    آزمایش.ادعای برابری اعشار(step.ز۱، 0.0، 0.0)
    آزمایش.ادعای برابری اعشار(step.ز۲، 0.0، 0.0)

    سرچاپ "resampling keeps the signal"
    src := tone(44100، 440.0، 4410)
    up := پردازش سیگنال.بازنمونه سینک(src، 48000، 16)
    آزمایش.ادعای برابری عدد(up.نرخ، 48000)
    آزمایش.ادعای برابری عدد(up.فریم ها، 4800)
    back := پردازش سیگنال.بازنمونه سینک(up، 44100، 16)
    آزمایش.ادعای برابری عدد(back.فریم ها، 4410)
    inner_a := صدا.برش(src، 64، src.فریم ها - 128)
    inner_b := صدا.برش(back، 64، back.فریم ها - 128)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(inner_a، inner_b) بزرگتر 0.999، "sinc resampling should keep the signal")
    cub := پردازش سیگنال.بازنمونه مکعبی(src، 48000)
    cback := پردازش سیگنال.بازنمونه مکعبی(cub، 44100)
    inner_c := صدا.برش(cback، 64، cback.فریم ها - 128)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(inner_a، inner_c) بزرگتر 0.999، "cubic resampling should keep the signal")
    lin := پردازش سیگنال.بازنمونه به(src، 48000، پردازش سیگنال.کیفیت خطی)
    آزمایش.ادعای برابری عدد(lin.نرخ، 48000)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.بازنمونه به(src، 48000، پردازش سیگنال.کیفیت مکعبی).نرخ، 48000)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.بازنمونه به(src، 48000، پردازش سیگنال.کیفیت سینک).نرخ، 48000)
    same := پردازش سیگنال.بازنمونه سینک(src، 44100، 16)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.همبستگی(src، same)، 1.0، 0.000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.همبستگی(src، صدا.قطعه {})، 0.0، 0.0)

    سرچاپ "removing a dc offset"
    ناپایا dc := tone(8000، 100.0، 800)
    صدا.مقیاس(dc، 0.5)
    ناپایا j := 0
    تا j کوچکتر dc.فریم ها:
        صدا.افزودن نمونه(dc، j، 0، 0.25)
        j += 1
    پایان
    آزمایش.ادعا با پیام(صدا.انحراف جریان مستقیم(dc) بزرگتر 0.2، "the offset should be there first")
    پردازش سیگنال.حذف جریان مستقیم(dc)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(صدا.انحراف جریان مستقیم(dc)) کوچکتر 0.000001، "the offset should be gone")

    صدا.آزادسازی(hi)
    صدا.آزادسازی(lo)
    صدا.آزادسازی(src)
    صدا.آزادسازی(up)
    صدا.آزادسازی(back)
    صدا.آزادسازی(cub)
    صدا.آزادسازی(cback)
    صدا.آزادسازی(lin)
    صدا.آزادسازی(same)
    صدا.آزادسازی(inner_a)
    صدا.آزادسازی(inner_b)
    صدا.آزادسازی(inner_c)
    صدا.آزادسازی(dc)
    برگشت آزمایش.خلاصه()
پایان
