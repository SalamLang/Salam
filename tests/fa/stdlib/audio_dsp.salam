بسته ریشه

واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی ریاضی
واردسازی آزمایش

تابع آوا(نرخ نمونه: صحیح، بسامد: اعشار۶۴، تعداد فریم: صحیح): صدا.قطعه:
    ناپایا c := صدا.جدید(نرخ نمونه، 1، تعداد فریم)
    ناپایا i := 0
    تا i کوچکتر تعداد فریم:
        صدا.تنظیم نمونه(c، i، 0، ریاضی.سینوس(2.0 * ریاضی.پی * بسامد * (i برگردان اعشار۶۴) / (نرخ نمونه برگردان اعشار۶۴)))
        i += 1
    پایان
    برگشت c
پایان

تابع ریشه:
    سرچاپ "powers of two"
    آزمایش.ادعای درستی(پردازش سیگنال.توان دو است(1024))
    آزمایش.ادعای نادرستی(پردازش سیگنال.توان دو است(1000))
    آزمایش.ادعای نادرستی(پردازش سیگنال.توان دو است(0))
    آزمایش.ادعای برابری عدد(پردازش سیگنال.توان دو بعدی(1000)، 1024)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.توان دو بعدی(1024)، 1024)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.توان دو بعدی(1)، 1)

    سرچاپ "complex arithmetic"
    a := پردازش سیگنال.مختلط { حقیقی = 3.0، موهومی = 4.0 }
    b := پردازش سیگنال.مختلط { حقیقی = 1.0، موهومی = -2.0 }
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.اندازه مختلط(a)، 5.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.جمع مختلط(a، b).حقیقی، 4.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.جمع مختلط(a، b).موهومی، 2.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.تفریق مختلط(a، b).موهومی، 6.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ضرب مختلط(a، b).حقیقی، 11.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ضرب مختلط(a، b).موهومی، -2.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.مقیاس مختلط(a، 2.0).حقیقی، 6.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.همیوغ مختلط(a).موهومی، -4.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.زاویه مختلط(پردازش سیگنال.مختلط { حقیقی = 0.0، موهومی = 1.0 })، ریاضی.پی / 2.0، 0.000000001)
    قطبی := پردازش سیگنال.مختلط از قطبی(2.0، 0.0)
    آزمایش.ادعای برابری اعشار(قطبی.حقیقی، 2.0، 0.000000001)

    سرچاپ "a complex exponential gives one peak"
    n := 64
    k := 5
    ناپایا حقیقی := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا موهومی := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا حقیقی اولیه := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا موهومی اولیه := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا i := 0
    تا i کوچکتر n:
        زاویه := 2.0 * ریاضی.پی * (k برگردان اعشار۶۴) * (i برگردان اعشار۶۴) / (n برگردان اعشار۶۴)
        حقیقی.بیفزا(ریاضی.کسینوس(زاویه))
        موهومی.بیفزا(ریاضی.سینوس(زاویه))
        حقیقی اولیه.بیفزا(ریاضی.کسینوس(زاویه))
        موهومی اولیه.بیفزا(ریاضی.سینوس(زاویه))
        i += 1
    پایان
    آزمایش.ادعای درستی(پردازش سیگنال.تبدیل فوریه برداری(حقیقی، موهومی))
    اندازه‌ها := پردازش سیگنال.اندازه(حقیقی.ارجاع(0)، موهومی.ارجاع(0)، n)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.خانه اوج(اندازه‌ها)، k)
    آزمایش.ادعای برابری اعشار(اندازه‌ها.بگیر(k)، n برگردان اعشار۶۴، 0.000001)
    ناپایا نشت := 0.0
    ناپایا خانه := 0
    تا خانه کوچکتر n:
        اگر خانه نابرابر k و اندازه‌ها.بگیر(خانه) بزرگتر نشت:
            نشت = اندازه‌ها.بگیر(خانه)
        پایان
        خانه += 1
    پایان
    آزمایش.ادعا با پیام(نشت کوچکتر 0.000000001، "energy should not leak outside the peak bin")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.بسامد خانه(k، n، 48000)، 3750.0، 0.000000001)

    سرچاپ "the inverse puts it back"
    آزمایش.ادعای درستی(پردازش سیگنال.تبدیل فوریه وارون برداری(حقیقی، موهومی))
    ناپایا بدترین := 0.0
    ناپایا m := 0
    تا m کوچکتر n:
        d := ریاضی.قدرمطلق(حقیقی.بگیر(m) - حقیقی اولیه.بگیر(m))
        اگر d بزرگتر بدترین:
            بدترین = d
        پایان
        e := ریاضی.قدرمطلق(موهومی.بگیر(m) - موهومی اولیه.بگیر(m))
        اگر e بزرگتر بدترین:
            بدترین = e
        پایان
        m += 1
    پایان
    آزمایش.ادعا با پیام(بدترین کوچکتر 0.000000001، "the round-trip should return the input")
    آزمایش.ادعای نادرستی(پردازش سیگنال.تبدیل فوریه(حقیقی.ارجاع(0)، موهومی.ارجاع(0)، 15))
    آزمایش.ادعای برابری عدد(پردازش سیگنال.خانه اوج(وکتور {} برگردان وکتور<اعشار۶۴>)، -1)

    سرچاپ "windows"
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.بسل صفر(0.0)، 1.0، 0.000000001)
    هان := پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره هان، 9، 0.0)
    آزمایش.ادعای برابری عدد(هان.طول()، 9)
    آزمایش.ادعای برابری اعشار(هان.بگیر(0)، 0.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(هان.بگیر(8)، 0.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(هان.بگیر(4)، 1.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.مقدار پنجره(پردازش سیگنال.پنجره مستطیلی، 0، 9، 0.0)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.مقدار پنجره(پردازش سیگنال.پنجره همینگ، 0، 9، 0.0)، 0.08، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره کایزر، 9، 8.6).بگیر(4)، 1.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره بلکمن، 9، 0.0).بگیر(4)، 1.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره سینوسی، 9، 0.0).بگیر(4)، 1.0، 0.000000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.ساخت پنجره(پردازش سیگنال.پنجره وربیس، 9، 0.0).بگیر(0)، 0.0، 0.000000001)
    آزمایش.ادعای برابری رشته(پردازش سیگنال.نام پنجره(پردازش سیگنال.پنجره هان)، "hann")
    آزمایش.ادعای برابری رشته(پردازش سیگنال.نام پنجره(99)، "unknown")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.جمع پنجره(پردازش سیگنال.پنجره مستطیلی، 8، 0.0)، 8.0، 0.0)
    ناپایا بافر پنجره := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا شمارنده پنجره := 0
    تا شمارنده پنجره کوچکتر 8:
        بافر پنجره.بیفزا(1.0)
        شمارنده پنجره += 1
    پایان
    پردازش سیگنال.اعمال پنجره(بافر پنجره.ارجاع(0)، 8، پردازش سیگنال.پنجره هان، 0.0)
    آزمایش.ادعای برابری اعشار(بافر پنجره.بگیر(0)، 0.0، 0.000000001)

    سرچاپ "biquad responses follow the cookbook"
    پایین‌گذر := پردازش سیگنال.صافی پایین(1000.0، 0.707، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(پایین‌گذر، 100.0، 48000) بزرگتر 0.99، "a low pass should pass 100 Hz")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(پایین‌گذر، 1000.0، 48000)، 0.7071، 0.01)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(پایین‌گذر، 10000.0، 48000) کوچکتر 0.02، "a low pass should stop 10 kHz")
    بالاگذر := پردازش سیگنال.صافی بالا(1000.0، 0.707، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(بالاگذر، 10000.0، 48000) بزرگتر 0.99، "a high pass should pass 10 kHz")
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(بالاگذر، 100.0، 48000) کوچکتر 0.02، "a high pass should stop 100 Hz")
    میان‌گذر := پردازش سیگنال.صافی میان(1000.0، 1.0، 48000)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(میان‌گذر، 1000.0، 48000)، 1.0، 0.01)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(میان‌گذر، 100.0، 48000) کوچکتر 0.2، "a band pass should stop 100 Hz")
    شکاف := پردازش سیگنال.صافی شکاف(1000.0، 1.0، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(شکاف، 1000.0، 48000) کوچکتر 0.01، "a notch should stop its centre")
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(شکاف، 100.0، 48000) بزرگتر 0.9، "a notch should pass elsewhere")
    همه‌گذر := پردازش سیگنال.صافی همه(1000.0، 0.707، 48000)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(همه‌گذر، 500.0، 48000)، 1.0، 0.000001)
    اوج‌گیر := پردازش سیگنال.قله(1000.0، 1.0، 6.0، 48000)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(اوج‌گیر، 1000.0، 48000)، 1.9952623149688795، 0.01)
    قفسه بم := پردازش سیگنال.قفسه پایین(1000.0، 0.707، 6.0، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(قفسه بم، 50.0، 48000) بزرگتر 1.9، "a low shelf should lift the bottom")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.پاسخ دوقطبی(قفسه بم، 20000.0، 48000)، 1.0، 0.05)
    قفسه زیر := پردازش سیگنال.قفسه بالا(1000.0، 0.707، 6.0، 48000)
    آزمایش.ادعا با پیام(پردازش سیگنال.پاسخ دوقطبی(قفسه زیر، 20000.0، 48000) بزرگتر 1.9، "a high shelf should lift the top")

    سرچاپ "filtering a real tone"
    ناپایا صدای زیر := آوا(48000، 10000.0، 2048)
    پیش := صدا.جذر میانگین مربع(صدای زیر)
    پردازش سیگنال.پردازش همه کانال‌ها(پایین‌گذر، صدای زیر)
    پس := صدا.جذر میانگین مربع(صدای زیر)
    آزمایش.ادعا با پیام(صدا.بهره به دسیبل(پس / پیش) کوچکتر -20.0، "the low pass should cut a 10 kHz tone")
    ناپایا صدای بم := آوا(48000، 100.0، 2048)
    بم پیش := صدا.جذر میانگین مربع(صدای بم)
    پردازش سیگنال.پردازش همه کانال‌ها(پایین‌گذر، صدای بم)
    آزمایش.ادعا با پیام(صدا.بهره به دسیبل(صدا.جذر میانگین مربع(صدای بم) / بم پیش) بزرگتر -1.0، "the low pass should keep a 100 Hz tone")
    ناپایا گام := پردازش سیگنال.صافی پایین(1000.0، 0.707، 48000)
    پردازش سیگنال.گام دوقطبی(گام، 1.0)
    پردازش سیگنال.بازنشانی دوقطبی(گام)
    آزمایش.ادعای برابری اعشار(گام.ز۱، 0.0، 0.0)
    آزمایش.ادعای برابری اعشار(گام.ز۲، 0.0، 0.0)

    سرچاپ "resampling keeps the signal"
    ناپایا منبع := آوا(44100، 440.0، 4410)
    ناپایا بالارفته := پردازش سیگنال.بازنمونه سینک(منبع، 48000، 16)
    آزمایش.ادعای برابری عدد(بالارفته.نرخ، 48000)
    آزمایش.ادعای برابری عدد(بالارفته.فریم ها، 4800)
    ناپایا بازخوانی := پردازش سیگنال.بازنمونه سینک(بالارفته، 44100، 16)
    آزمایش.ادعای برابری عدد(بازخوانی.فریم ها، 4410)
    ناپایا درونی الف := صدا.برش(منبع، 64، منبع.فریم ها - 128)
    ناپایا درونی ب := صدا.برش(بازخوانی، 64، بازخوانی.فریم ها - 128)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(درونی الف، درونی ب) بزرگتر 0.999، "sinc resampling should keep the signal")
    ناپایا مکعبی := پردازش سیگنال.بازنمونه مکعبی(منبع، 48000)
    ناپایا بازگشت مکعبی := پردازش سیگنال.بازنمونه مکعبی(مکعبی، 44100)
    ناپایا درونی ج := صدا.برش(بازگشت مکعبی، 64، بازگشت مکعبی.فریم ها - 128)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(درونی الف، درونی ج) بزرگتر 0.999، "cubic resampling should keep the signal")
    ناپایا خطی := پردازش سیگنال.بازنمونه به(منبع، 48000، پردازش سیگنال.کیفیت خطی)
    آزمایش.ادعای برابری عدد(خطی.نرخ، 48000)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.بازنمونه به(منبع، 48000، پردازش سیگنال.کیفیت مکعبی).نرخ، 48000)
    آزمایش.ادعای برابری عدد(پردازش سیگنال.بازنمونه به(منبع، 48000، پردازش سیگنال.کیفیت سینک).نرخ، 48000)
    ناپایا همان := پردازش سیگنال.بازنمونه سینک(منبع، 44100، 16)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.همبستگی(منبع، همان)، 1.0، 0.000001)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.همبستگی(منبع، صدا.قطعه {})، 0.0، 0.0)

    سرچاپ "removing a dc offset"
    ناپایا جریان مستقیم := آوا(8000، 100.0، 800)
    صدا.مقیاس(جریان مستقیم، 0.5)
    ناپایا j := 0
    تا j کوچکتر جریان مستقیم.فریم ها:
        صدا.افزودن نمونه(جریان مستقیم، j، 0، 0.25)
        j += 1
    پایان
    آزمایش.ادعا با پیام(صدا.انحراف جریان مستقیم(جریان مستقیم) بزرگتر 0.2، "the offset should be there first")
    پردازش سیگنال.حذف جریان مستقیم(جریان مستقیم)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(صدا.انحراف جریان مستقیم(جریان مستقیم)) کوچکتر 0.000001، "the offset should be gone")

    صدا.آزادسازی(صدای زیر)
    صدا.آزادسازی(صدای بم)
    صدا.آزادسازی(منبع)
    صدا.آزادسازی(بالارفته)
    صدا.آزادسازی(بازخوانی)
    صدا.آزادسازی(مکعبی)
    صدا.آزادسازی(بازگشت مکعبی)
    صدا.آزادسازی(خطی)
    صدا.آزادسازی(همان)
    صدا.آزادسازی(درونی الف)
    صدا.آزادسازی(درونی ب)
    صدا.آزادسازی(درونی ج)
    صدا.آزادسازی(جریان مستقیم)
    برگشت آزمایش.خلاصه()
پایان
