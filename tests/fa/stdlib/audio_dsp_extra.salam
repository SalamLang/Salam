بسته ریشه

واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی صدا.صداساز
واردسازی ریاضی

تابع ریشه:
    سرچاپ "spectrum helpers"
    n := 8
    ناپایا حقیقی := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا موهومی := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا i := 0
    تا i کوچکتر n:
        حقیقی.بیفزا(ریاضی.کسینوس(2.0 * ریاضی.پی * 2.0 * (i برگردان اعشار۶۴) / (n برگردان اعشار۶۴)))
        موهومی.بیفزا(0.0)
        i++
    پایان
    اصلی := حقیقی.بگیر(1)
    سرچاپ پردازش سیگنال.تبدیل فوریه(حقیقی.ارجاع(0)، موهومی.ارجاع(0)، n)
    توان := پردازش سیگنال.طیف توان(حقیقی.ارجاع(0)، موهومی.ارجاع(0)، n)
    سرچاپ توان.طول()، ریاضی.گردکردن(توان.بگیر(2))، ریاضی.گردکردن(توان.بگیر(6))، توان.بگیر(0) کوچکتر 0.000001
    فاز := پردازش سیگنال.فاز(حقیقی.ارجاع(0)، موهومی.ارجاع(0)، n)
    سرچاپ فاز.طول()، ریاضی.قدرمطلق(فاز.بگیر(2)) کوچکتر 0.000001
    سرچاپ پردازش سیگنال.تبدیل فوریه وارون(حقیقی.ارجاع(0)، موهومی.ارجاع(0)، n)
    سرچاپ ریاضی.قدرمطلق(حقیقی.بگیر(1) - اصلی) کوچکتر 0.000000001، ریاضی.قدرمطلق(موهومی.بگیر(1)) کوچکتر 0.000000001
    سرچاپ پردازش سیگنال.تبدیل فوریه وارون(حقیقی.ارجاع(0)، موهومی.ارجاع(0)، 6)

    سرچاپ "biquad over a clip"
    ناپایا منبع := صداساز.نوا(2000.0، 0.05، 8000، صداساز.موج سینوسی)
    ناپایا پایین := صدا.کپی(منبع)
    ناپایا صافی پایین := پردازش سیگنال.صافی پایین(200.0، 0.707، 8000)
    پردازش سیگنال.پردازش دوقطبی(صافی پایین، پایین، 0)
    سرچاپ پایین.فریم ها برابر منبع.فریم ها، صدا.جذر میانگین مربع(پایین) کوچکتر صدا.جذر میانگین مربع(منبع) * 0.2
    ناپایا دوباره := صدا.کپی(منبع)
    صافی پایین۲ := پردازش سیگنال.صافی پایین(200.0، 0.707، 8000)
    پردازش سیگنال.پردازش همه کانال‌ها(صافی پایین۲، دوباره)
    سرچاپ صدا.نمونه(دوباره، 100، 0) برابر صدا.نمونه(پایین، 100، 0)
    ناپایا حفظ شده := صدا.کپی(منبع)
    ناپایا صافی بالا := پردازش سیگنال.صافی بالا(200.0، 0.707، 8000)
    پردازش سیگنال.پردازش دوقطبی(صافی بالا، حفظ شده، 0)
    سرچاپ صدا.جذر میانگین مربع(حفظ شده) بزرگتر صدا.جذر میانگین مربع(منبع) * 0.9
    ناپایا دست‌نخورده := صدا.کپی(منبع)
    ناپایا هرکدام := پردازش سیگنال.صافی پایین(200.0، 0.707، 8000)
    پردازش سیگنال.پردازش دوقطبی(هرکدام، دست‌نخورده، 5)
    سرچاپ صدا.نمونه(دست‌نخورده، 100، 0) برابر صدا.نمونه(منبع، 100، 0)

    سرچاپ "delay"
    ناپایا تاخیر := صدا.جدید(1000، 1، 100)
    صدا.تنظیم نمونه(تاخیر، 0، 0، 1.0)
    پردازش سیگنال.تاخیر(تاخیر، 0.01، 0.5، 1.0)
    سرچاپ صدا.نمونه(تاخیر، 0، 0)، صدا.نمونه(تاخیر، 9، 0)، صدا.نمونه(تاخیر، 10، 0)، صدا.نمونه(تاخیر، 11، 0)
    ناپایا ردشده := صدا.جدید(1000، 1، 100)
    صدا.تنظیم نمونه(ردشده، 0، 0، 1.0)
    پردازش سیگنال.تاخیر(ردشده، 0.0، 0.5، 1.0)
    پردازش سیگنال.تاخیر(ردشده، 5.0، 0.5، 1.0)
    سرچاپ صدا.نمونه(ردشده، 0، 0)، صدا.اوج(ردشده)

    سرچاپ "oscillator"
    ناپایا نوساز := صداساز.نوساز جدید(صداساز.موج مربعی، 1000.0، 8000)
    سرچاپ نوساز.موج برابر صداساز.موج مربعی، نوساز.بسامد، نوساز.نرخ
    ناپایا دنباله := ""
    ناپایا k := 0
    تا k کوچکتر 16:
        v := صداساز.نمونه بعدی نوساز(نوساز)
        دنباله += v بزرگتر 0.0 ? "+" : "-"
        k++
    پایان
    سرچاپ دنباله
    ناپایا اره‌ای := صداساز.نوساز جدید(صداساز.موج اره‌ای، 2000.0، 8000)
    سرچاپ صداساز.نمونه بعدی نوساز(اره‌ای)، صداساز.نمونه بعدی نوساز(اره‌ای)، صداساز.نمونه بعدی نوساز(اره‌ای)، صداساز.نمونه بعدی نوساز(اره‌ای)، صداساز.نمونه بعدی نوساز(اره‌ای)
    ناپایا سینوسی := صداساز.نوساز جدید(صداساز.موج سینوسی، 1000.0، 8000)
    سرچاپ صداساز.نمونه بعدی نوساز(سینوسی)، ریاضی.قدرمطلق(صداساز.نمونه بعدی نوساز(سینوسی) - ریاضی.سینوس(ریاضی.پی / 4.0)) کوچکتر 0.000001
    ناپایا متوقف := صداساز.نوساز جدید(صداساز.موج اره‌ای، 440.0، 0)
    سرچاپ صداساز.نمونه بعدی نوساز(متوقف)، صداساز.نمونه بعدی نوساز(متوقف)

    صدا.آزادسازی(منبع)
    صدا.آزادسازی(پایین)
    صدا.آزادسازی(دوباره)
    صدا.آزادسازی(حفظ شده)
    صدا.آزادسازی(دست‌نخورده)
    صدا.آزادسازی(تاخیر)
    صدا.آزادسازی(ردشده)
پایان
