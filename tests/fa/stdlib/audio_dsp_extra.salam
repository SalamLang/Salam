بسته ریشه

واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی صدا.صداساز
واردسازی ریاضی

تابع ریشه:
    سرچاپ "spectrum helpers"
    n := 8
    ناپایا re := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا im := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا i := 0
    تا i کوچکتر n:
        re.بیفزا(ریاضی.کسینوس(2.0 * ریاضی.پی * 2.0 * (i برگردان اعشار۶۴) / (n برگردان اعشار۶۴)))
        im.بیفزا(0.0)
        i += 1
    پایان
    orig := re.بگیر(1)
    سرچاپ پردازش سیگنال.تبدیل فوریه(re.ارجاع(0)، im.ارجاع(0)، n)
    pw := پردازش سیگنال.طیف توان(re.ارجاع(0)، im.ارجاع(0)، n)
    سرچاپ pw.طول()، ریاضی.گردکردن(pw.بگیر(2))، ریاضی.گردکردن(pw.بگیر(6))، pw.بگیر(0) کوچکتر 0.000001
    ph := پردازش سیگنال.فاز(re.ارجاع(0)، im.ارجاع(0)، n)
    سرچاپ ph.طول()، ریاضی.قدرمطلق(ph.بگیر(2)) کوچکتر 0.000001
    سرچاپ پردازش سیگنال.تبدیل فوریه وارون(re.ارجاع(0)، im.ارجاع(0)، n)
    سرچاپ ریاضی.قدرمطلق(re.بگیر(1) - orig) کوچکتر 0.000000001، ریاضی.قدرمطلق(im.بگیر(1)) کوچکتر 0.000000001
    سرچاپ پردازش سیگنال.تبدیل فوریه وارون(re.ارجاع(0)، im.ارجاع(0)، 6)

    سرچاپ "biquad over a clip"
    ناپایا src := صداساز.نوا(2000.0، 0.05، 8000، صداساز.موج سینوسی)
    ناپایا low := صدا.کپی(src)
    ناپایا lp := پردازش سیگنال.صافی پایین(200.0، 0.707، 8000)
    پردازش سیگنال.پردازش دوقطبی(lp، low، 0)
    سرچاپ low.فریم ها برابر src.فریم ها، صدا.جذر میانگین مربع(low) کوچکتر صدا.جذر میانگین مربع(src) * 0.2
    ناپایا again := صدا.کپی(src)
    lp2 := پردازش سیگنال.صافی پایین(200.0، 0.707، 8000)
    پردازش سیگنال.پردازش همه کانال‌ها(lp2، again)
    سرچاپ صدا.نمونه(again، 100، 0) برابر صدا.نمونه(low، 100، 0)
    ناپایا keep := صدا.کپی(src)
    ناپایا hp := پردازش سیگنال.صافی بالا(200.0، 0.707، 8000)
    پردازش سیگنال.پردازش دوقطبی(hp، keep، 0)
    سرچاپ صدا.جذر میانگین مربع(keep) بزرگتر صدا.جذر میانگین مربع(src) * 0.9
    ناپایا untouched := صدا.کپی(src)
    ناپایا any := پردازش سیگنال.صافی پایین(200.0، 0.707، 8000)
    پردازش سیگنال.پردازش دوقطبی(any، untouched، 5)
    سرچاپ صدا.نمونه(untouched، 100، 0) برابر صدا.نمونه(src، 100، 0)

    سرچاپ "delay"
    ناپایا d := صدا.جدید(1000، 1، 100)
    صدا.تنظیم نمونه(d، 0، 0، 1.0)
    پردازش سیگنال.تاخیر(d، 0.01، 0.5، 1.0)
    سرچاپ صدا.نمونه(d، 0، 0)، صدا.نمونه(d، 9، 0)، صدا.نمونه(d، 10، 0)، صدا.نمونه(d، 11، 0)
    ناپایا skipped := صدا.جدید(1000، 1، 100)
    صدا.تنظیم نمونه(skipped، 0، 0، 1.0)
    پردازش سیگنال.تاخیر(skipped، 0.0، 0.5، 1.0)
    پردازش سیگنال.تاخیر(skipped، 5.0، 0.5، 1.0)
    سرچاپ صدا.نمونه(skipped، 0، 0)، صدا.اوج(skipped)

    سرچاپ "oscillator"
    ناپایا o := صداساز.نوساز جدید(صداساز.موج مربعی، 1000.0، 8000)
    سرچاپ o.موج برابر صداساز.موج مربعی، o.بسامد، o.نرخ
    ناپایا seq := ""
    ناپایا k := 0
    تا k کوچکتر 16:
        v := صداساز.نمونه بعدی نوساز(o)
        seq += v بزرگتر 0.0 ? "+" : "-"
        k += 1
    پایان
    سرچاپ seq
    ناپایا saw := صداساز.نوساز جدید(صداساز.موج اره‌ای، 2000.0، 8000)
    سرچاپ صداساز.نمونه بعدی نوساز(saw)، صداساز.نمونه بعدی نوساز(saw)، صداساز.نمونه بعدی نوساز(saw)، صداساز.نمونه بعدی نوساز(saw)، صداساز.نمونه بعدی نوساز(saw)
    ناپایا sine := صداساز.نوساز جدید(صداساز.موج سینوسی، 1000.0، 8000)
    سرچاپ صداساز.نمونه بعدی نوساز(sine)، ریاضی.قدرمطلق(صداساز.نمونه بعدی نوساز(sine) - ریاضی.سینوس(ریاضی.پی / 4.0)) کوچکتر 0.000001
    ناپایا stopped := صداساز.نوساز جدید(صداساز.موج اره‌ای، 440.0، 0)
    سرچاپ صداساز.نمونه بعدی نوساز(stopped)، صداساز.نمونه بعدی نوساز(stopped)

    صدا.آزادسازی(src)
    صدا.آزادسازی(low)
    صدا.آزادسازی(again)
    صدا.آزادسازی(keep)
    صدا.آزادسازی(untouched)
    صدا.آزادسازی(d)
    صدا.آزادسازی(skipped)
پایان
