/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی صدا.موسیقی
واردسازی صدا.صداساز
واردسازی ریاضی
واردسازی آزمایش

تابع tone(rate: صحیح، freq: اعشار۶۴، seconds: اعشار۶۴): صدا.قطعه:
    برگشت صداساز.نوا(freq، seconds، rate، صداساز.موج سینوسی)
پایان

تابع ریشه:
    سرچاپ "echo lengthens the clip and repeats it"
    ناپایا src := tone(22050، 440.0، 0.1)
    ناپایا e := پردازش سیگنال.پژواک(src، 0.05، 2، 0.5)
    آزمایش.ادعای برابری عدد(e.نرخ، 22050)
    آزمایش.ادعای برابری عدد(e.فریم ها، src.فریم ها + 2 * 1102)
    آزمایش.ادعا با پیام(صدا.اوج(e) بزرگتر صدا.اوج(src) * 0.9، "the echo keeps the level up")
    lag := 1102
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(صدا.نمونه(e، lag + 10، 0) - (صدا.نمونه(src، lag + 10، 0) + صدا.نمونه(src، 10، 0) * 0.5)) کوچکتر 0.001، "the first repeat lands a lag later at half gain")

    سرچاپ "reverb stays bounded and mixes"
    ناپایا rv := پردازش سیگنال.بازآوا(src، 0.5، 0.3)
    آزمایش.ادعای برابری عدد(rv.فریم ها، src.فریم ها)
    آزمایش.ادعا با پیام(صدا.اوج(rv) کوچکتربرابر 1.0، "reverb should not run away")
    ناپایا dry := پردازش سیگنال.بازآوا(src، 0.5، 0.0)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(صدا.نمونه(dry، 50، 0) - صدا.نمونه(src، 50، 0)) کوچکتر 0.0001، "a zero mix leaves the signal alone")

    سرچاپ "chorus and flanger keep the length and move the sound"
    ناپایا ch := پردازش سیگنال.همخوان(src، 0.5، 2.0، 0.5)
    آزمایش.ادعای برابری عدد(ch.فریم ها، src.فریم ها)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(src، ch) کوچکتر 0.999، "chorus should change the signal")
    ناپایا fl := پردازش سیگنال.فلنجر(src، 0.5، 1.0، 0.5)
    آزمایش.ادعای برابری عدد(fl.فریم ها، src.فریم ها)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(src، fl) کوچکتر 0.9999، "flanger should change the signal")

    سرچاپ "tremolo moves the level without moving the pitch"
    ناپایا tr := صدا.کپی(src)
    پردازش سیگنال.لرزش دامنه(tr، 10.0، 1.0)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع(tr) کوچکتر صدا.جذر میانگین مربع(src)، "tremolo dips the level")
    آزمایش.ادعا با پیام(صدا.اوج(tr) کوچکتربرابر صدا.اوج(src) + 0.0001، "tremolo never lifts the peak")

    سرچاپ "a compressor pulls a loud signal down"
    ناپایا loud := tone(22050، 440.0، 0.1)
    k := پردازش سیگنال.فشرده‌ساز { آستانه = -20.0، نسبت = 8.0، حمله = 0.001، رهایش = 0.05 }
    ناپایا squashed := صدا.کپی(loud)
    پردازش سیگنال.پردازش فشرده‌ساز(k، squashed)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع دسیبل(squashed) کوچکتر صدا.جذر میانگین مربع دسیبل(loud) - 6.0، "a loud signal should come down hard")
    ناپایا quiet := صدا.کپی(loud)
    صدا.بهره(quiet، -40.0)
    before := صدا.جذر میانگین مربع دسیبل(quiet)
    پردازش سیگنال.پردازش فشرده‌ساز(k، quiet)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(صدا.جذر میانگین مربع دسیبل(quiet) - before) کوچکتر 1.0، "a quiet signal passes untouched")

    سرچاپ "a limiter holds a ceiling"
    ناپایا hot := صدا.کپی(loud)
    صدا.مقیاس(hot، 4.0)
    پردازش سیگنال.پردازش محدودساز(hot، -1.0)
    آزمایش.ادعا با پیام(صدا.اوج(hot) کوچکتربرابر 1.0، "nothing past full scale")
    آزمایش.ادعا با پیام(صدا.اوج دسیبل(hot) کوچکتر 0.0، "and under the ceiling")

    سرچاپ "a gate silences what sits below it"
    ناپایا mixed := صدا.جدید(22050، 1، 4410)
    ناپایا i := 0
    تا i کوچکتر 2205:
        صدا.تنظیم نمونه(mixed، i، 0، 0.5 * ریاضی.سینوس(2.0 * ریاضی.پی * 440.0 * (i برگردان اعشار۶۴) / 22050.0))
        i += 1
    پایان
    ناپایا j := 2205
    تا j کوچکتر 4410:
        صدا.تنظیم نمونه(mixed، j، 0، 0.001)
        j += 1
    پایان
    پردازش سیگنال.پردازش دروازه(mixed، -40.0، 0.001)
    ناپایا head := صدا.برش(mixed، 0، 2000)
    آزمایش.ادعا با پیام(صدا.اوج(head) بزرگتر 0.4، "the loud half survives")
    صدا.آزادسازی(head)
    tail := صدا.برش(mixed، 3000، 1000)
    آزمایش.ادعا با پیام(صدا.اوج(tail) کوچکتر 0.0005، "the quiet half is gated out")

    سرچاپ "zero crossing rate rises with pitch"
    ناپایا lowp := tone(22050، 110.0، 0.1)
    ناپایا highp := tone(22050، 1760.0، 0.1)
    آزمایش.ادعا با پیام(پردازش سیگنال.نرخ صفرگذر(highp) بزرگتر پردازش سیگنال.نرخ صفرگذر(lowp) * 4.0، "a higher tone crosses zero more often")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.نرخ صفرگذر(صدا.قطعه {})، 0.0، 0.0)

    سرچاپ "pitch detection finds the note"
    هر f در [220.0، 440.0]:
        ناپایا t := tone(22050، f، 0.1)
        got := پردازش سیگنال.شناسایی زیروبمی(t، 0، 2048)
        آزمایش.ادعا با پیام(ریاضی.قدرمطلق(got - f) / f کوچکتر 0.05، "the detected pitch should be within five percent")
        صدا.آزادسازی(t)
    پایان
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.شناسایی زیروبمی(صدا.قطعه {}، 0، 2048)، 0.0، 0.0)
    ناپایا silence := صدا.جدید(22050، 1، 4096)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.شناسایی زیروبمی(silence، 0، 2048)، 0.0، 0.0)

    سرچاپ "a detected pitch maps back to a note name"
    ناپایا a4 := tone(44100، 440.0، 0.1)
    hz := پردازش سیگنال.شناسایی زیروبمی(a4، 0، 4096)
    آزمایش.ادعای برابری عدد(موسیقی.بسامد به نت(hz)، 69)

    سرچاپ "spectra and their shape"
    ناپایا rich := صداساز.افزایشی(220.0، 8، 0.7، 0.12، 22050)
    ناپایا s := پردازش سیگنال.تبدیل فوریه کوتاه(rich، 1024، 256، پردازش سیگنال.پنجره هان)
    آزمایش.ادعا با پیام(s.فریم ها بزرگتر 1، "the spectrogram should have frames")
    آزمایش.ادعای برابری عدد(s.خانه‌ها، 512)
    آزمایش.ادعای برابری عدد(s.نرخ، 22050)
    آزمایش.ادعا با پیام(پردازش سیگنال.طیف در(s، 0، 0) بزرگتربرابر 0.0، "bins are magnitudes")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.طیف در(s، 0، 9999)، 0.0، 0.0)
    cen := پردازش سیگنال.مرکز طیفی(s، 1)
    آزمایش.ادعا با پیام(cen بزرگتر 100.0 و cen کوچکتر 5000.0، "the centroid should sit in the band")
    roll := پردازش سیگنال.افت طیفی(s، 1، 0.85)
    آزمایش.ادعا با پیام(roll بزرگتربرابر cen * 0.5، "rolloff sits above the centroid region")
    flat := پردازش سیگنال.تختی طیفی(s، 1)
    آزمایش.ادعا با پیام(flat بزرگتربرابر 0.0 و flat کوچکتربرابر 1.0، "flatness is a ratio")
    ناپایا noise := صداساز.نوفه سپید(0.12، 22050)
    ناپایا ns := پردازش سیگنال.تبدیل فوریه کوتاه(noise، 1024، 256، پردازش سیگنال.پنجره هان)
    آزمایش.ادعا با پیام(پردازش سیگنال.تختی طیفی(ns، 1) بزرگتر flat، "noise is flatter than a harmonic tone")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.شار طیفی(s، 0)، 0.0، 0.0)
    پردازش سیگنال.آزادسازی طیف(ns)

    سرچاپ "onsets and tempo"
    ناپایا beat := صدا.جدید(22050، 1، 22050)
    ناپایا b := 0
    تا b کوچکتر 8:
        at := b * 2756
        ناپایا k2 := 0
        تا k2 کوچکتر 1000:
            اگر at + k2 کوچکتر beat.فریم ها:
                env := 1.0 - (k2 برگردان اعشار۶۴) / 1000.0
                صدا.تنظیم نمونه(beat، at + k2، 0، 0.8 * env * ریاضی.سینوس(2.0 * ریاضی.پی * 600.0 * (k2 برگردان اعشار۶۴) / 22050.0))
            پایان
            k2 += 1
        پایان
        b += 1
    پایان
    ناپایا onsets := پردازش سیگنال.شناسایی آغازها(beat، 1024، 256)
    آزمایش.ادعا با پیام(onsets.طول() بزرگتربرابر 4، "the clicks should be found")
    bpm := پردازش سیگنال.شناسایی ضربان(beat)
    آزمایش.ادعا با پیام(bpm بزرگتر 60.0 و bpm کوچکتر 200.0، "the tempo should be in range")
    onsets.آزادکن()
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.شناسایی ضربان(صدا.قطعه {})، 0.0، 0.0)

    سرچاپ "loudness in lufs"
    lu := پردازش سیگنال.بلندی لافز(loud)
    آزمایش.ادعا با پیام(lu کوچکتر 0.0 و lu بزرگتر -40.0، "a full scale tone sits near the top")
    ناپایا soft := صدا.کپی(loud)
    صدا.بهره(soft، -20.0)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق((پردازش سیگنال.بلندی لافز(soft) - lu) + 20.0) کوچکتر 1.0، "twenty decibels down reads twenty lower")
    ناپایا norm := صدا.کپی(loud)
    پردازش سیگنال.هنجارسازی لافز(norm، -16.0)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(پردازش سیگنال.بلندی لافز(norm) + 16.0) کوچکتر 1.0، "normalising lands on the target")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.بلندی لافز(صدا.قطعه {})، صدا.کف سکوت، 0.0)
    tp := پردازش سیگنال.اوج راستین دسیبل(loud)
    آزمایش.ادعا با پیام(tp بزرگتربرابر صدا.اوج دسیبل(loud) - 0.01، "the true peak is never under the sample peak")

    سرچاپ "time stretching and pitch shifting"
    ناپایا longer := پردازش سیگنال.کشش زمانی(src، 2.0)
    آزمایش.ادعای برابری عدد(longer.فریم ها، src.فریم ها * 2)
    آزمایش.ادعای برابری عدد(longer.نرخ، src.نرخ)
    آزمایش.ادعا با پیام(صدا.اوج(longer) بزرگتر 0.5، "stretching keeps the level")
    ناپایا shorter := پردازش سیگنال.کشش زمانی(src، 0.5)
    آزمایش.ادعای برابری عدد(shorter.فریم ها، src.فریم ها / 2)
    آزمایش.ادعای درستی(صدا.خالی است(پردازش سیگنال.کشش زمانی(src، 0.0)))
    ناپایا up := پردازش سیگنال.جابجایی زیروبمی(a4، 12.0)
    آزمایش.ادعای برابری عدد(up.نرخ، a4.نرخ)
    shifted := پردازش سیگنال.شناسایی زیروبمی(up، 0، 4096)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(shifted - 880.0) / 880.0 کوچکتر 0.1، "an octave up should land near 880")

    صدا.آزادسازی(src)
    صدا.آزادسازی(e)
    صدا.آزادسازی(rv)
    صدا.آزادسازی(dry)
    صدا.آزادسازی(ch)
    صدا.آزادسازی(fl)
    صدا.آزادسازی(tr)
    صدا.آزادسازی(loud)
    صدا.آزادسازی(squashed)
    صدا.آزادسازی(quiet)
    صدا.آزادسازی(hot)
    صدا.آزادسازی(mixed)
    صدا.آزادسازی(tail)
    صدا.آزادسازی(lowp)
    صدا.آزادسازی(highp)
    صدا.آزادسازی(silence)
    صدا.آزادسازی(a4)
    صدا.آزادسازی(rich)
    صدا.آزادسازی(noise)
    صدا.آزادسازی(beat)
    صدا.آزادسازی(soft)
    صدا.آزادسازی(norm)
    صدا.آزادسازی(longer)
    صدا.آزادسازی(shorter)
    صدا.آزادسازی(up)
    پردازش سیگنال.آزادسازی طیف(s)
    برگشت آزمایش.خلاصه()
پایان
