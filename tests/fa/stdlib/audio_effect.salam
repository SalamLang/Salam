بسته ریشه

واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی صدا.موسیقی
واردسازی صدا.صداساز
واردسازی ریاضی
واردسازی آزمایش

تابع آوا(نرخ نمونه: صحیح، بسامد: اعشار۶۴، ثانیه: اعشار۶۴): صدا.قطعه:
    برگشت صداساز.نوا(بسامد، ثانیه، نرخ نمونه، صداساز.موج سینوسی)
پایان

تابع ریشه:
    سرچاپ "echo lengthens the clip and repeats it"
    ناپایا منبع := آوا(22050، 440.0، 0.1)
    ناپایا e := پردازش سیگنال.پژواک(منبع، 0.05، 2، 0.5)
    آزمایش.ادعای برابری عدد(e.نرخ، 22050)
    آزمایش.ادعای برابری عدد(e.فریم ها، منبع.فریم ها + 2 * 1102)
    آزمایش.ادعا با پیام(صدا.اوج(e) بزرگتر صدا.اوج(منبع) * 0.9، "the echo keeps the level up")
    تاخیر := 1102
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(صدا.نمونه(e، تاخیر + 10، 0) - (صدا.نمونه(منبع، تاخیر + 10، 0) + صدا.نمونه(منبع، 10، 0) * 0.5)) کوچکتر 0.001، "the first repeat lands a lag later at half gain")

    سرچاپ "reverb stays bounded and mixes"
    ناپایا بازآوا شده := پردازش سیگنال.بازآوا(منبع، 0.5، 0.3)
    آزمایش.ادعای برابری عدد(بازآوا شده.فریم ها، منبع.فریم ها)
    آزمایش.ادعا با پیام(صدا.اوج(بازآوا شده) کوچکتربرابر 1.0، "reverb should not run away")
    ناپایا خشک := پردازش سیگنال.بازآوا(منبع، 0.5، 0.0)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(صدا.نمونه(خشک، 50، 0) - صدا.نمونه(منبع، 50، 0)) کوچکتر 0.0001، "a zero mix leaves the signal alone")

    سرچاپ "chorus and flanger keep the length and move the sound"
    ناپایا کر شده := پردازش سیگنال.همخوان(منبع، 0.5، 2.0، 0.5)
    آزمایش.ادعای برابری عدد(کر شده.فریم ها، منبع.فریم ها)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(منبع، کر شده) کوچکتر 0.999، "chorus should change the signal")
    ناپایا فلنجر شده := پردازش سیگنال.فلنجر(منبع، 0.5، 1.0، 0.5)
    آزمایش.ادعای برابری عدد(فلنجر شده.فریم ها، منبع.فریم ها)
    آزمایش.ادعا با پیام(پردازش سیگنال.همبستگی(منبع، فلنجر شده) کوچکتر 0.9999، "flanger should change the signal")

    سرچاپ "tremolo moves the level without moving the pitch"
    ناپایا لرزان := صدا.کپی(منبع)
    پردازش سیگنال.لرزش دامنه(لرزان، 10.0، 1.0)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع(لرزان) کوچکتر صدا.جذر میانگین مربع(منبع)، "tremolo dips the level")
    آزمایش.ادعا با پیام(صدا.اوج(لرزان) کوچکتربرابر صدا.اوج(منبع) + 0.0001، "tremolo never lifts the peak")

    سرچاپ "a compressor pulls a loud signal down"
    ناپایا بلند := آوا(22050، 440.0، 0.1)
    k := پردازش سیگنال.فشرده‌ساز { آستانه = -20.0، نسبت = 8.0، حمله = 0.001، رهایش = 0.05 }
    ناپایا فشرده := صدا.کپی(بلند)
    پردازش سیگنال.پردازش فشرده‌ساز(k، فشرده)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع دسیبل(فشرده) کوچکتر صدا.جذر میانگین مربع دسیبل(بلند) - 6.0، "a loud signal should come down hard")
    ناپایا آرام := صدا.کپی(بلند)
    صدا.بهره(آرام، -40.0)
    پیش := صدا.جذر میانگین مربع دسیبل(آرام)
    پردازش سیگنال.پردازش فشرده‌ساز(k، آرام)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(صدا.جذر میانگین مربع دسیبل(آرام) - پیش) کوچکتر 1.0، "a quiet signal passes untouched")

    سرچاپ "a limiter holds a ceiling"
    ناپایا داغ := صدا.کپی(بلند)
    صدا.مقیاس(داغ، 4.0)
    پردازش سیگنال.پردازش محدودساز(داغ، -1.0)
    آزمایش.ادعا با پیام(صدا.اوج(داغ) کوچکتربرابر 1.0، "nothing past full scale")
    آزمایش.ادعا با پیام(صدا.اوج دسیبل(داغ) کوچکتر 0.0، "and under the ceiling")

    سرچاپ "a gate silences what sits below it"
    ناپایا آمیخته := صدا.جدید(22050، 1، 4410)
    ناپایا i := 0
    تا i کوچکتر 2205:
        صدا.تنظیم نمونه(آمیخته، i، 0، 0.5 * ریاضی.سینوس(2.0 * ریاضی.پی * 440.0 * (i برگردان اعشار۶۴) / 22050.0))
        i++
    پایان
    ناپایا j := 2205
    تا j کوچکتر 4410:
        صدا.تنظیم نمونه(آمیخته، j، 0، 0.001)
        j++
    پایان
    پردازش سیگنال.پردازش دروازه(آمیخته، -40.0، 0.001)
    ناپایا سر := صدا.برش(آمیخته، 0، 2000)
    آزمایش.ادعا با پیام(صدا.اوج(سر) بزرگتر 0.4، "the loud half survives")
    صدا.آزادسازی(سر)
    ناپایا دم := صدا.برش(آمیخته، 3000، 1000)
    آزمایش.ادعا با پیام(صدا.اوج(دم) کوچکتر 0.0005، "the quiet half is gated out")

    سرچاپ "zero crossing rate rises with pitch"
    ناپایا کم‌صدا := آوا(22050، 110.0، 0.1)
    ناپایا پرصدا := آوا(22050، 1760.0، 0.1)
    آزمایش.ادعا با پیام(پردازش سیگنال.نرخ صفرگذر(پرصدا) بزرگتر پردازش سیگنال.نرخ صفرگذر(کم‌صدا) * 4.0، "a higher tone crosses zero more often")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.نرخ صفرگذر(صدا.قطعه {})، 0.0، 0.0)

    سرچاپ "pitch detection finds the note"
    هر f در [220.0، 440.0]:
        ناپایا t := آوا(22050، f، 0.1)
        یافته := پردازش سیگنال.شناسایی زیروبمی(t، 0، 2048)
        آزمایش.ادعا با پیام(ریاضی.قدرمطلق(یافته - f) / f کوچکتر 0.05، "the detected pitch should be within five percent")
        صدا.آزادسازی(t)
    پایان
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.شناسایی زیروبمی(صدا.قطعه {}، 0، 2048)، 0.0، 0.0)
    ناپایا سکوت := صدا.جدید(22050، 1، 4096)
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.شناسایی زیروبمی(سکوت، 0، 2048)، 0.0، 0.0)

    سرچاپ "a detected pitch maps back to a note name"
    ناپایا لا۴ := آوا(44100، 440.0، 0.1)
    هرتز := پردازش سیگنال.شناسایی زیروبمی(لا۴، 0، 4096)
    آزمایش.ادعای برابری عدد(موسیقی.بسامد به نت(هرتز)، 69)

    سرچاپ "spectra and their shape"
    ناپایا غنی := صداساز.افزایشی(220.0، 8، 0.7، 0.12، 22050)
    ناپایا s := پردازش سیگنال.تبدیل فوریه کوتاه(غنی، 1024، 256، پردازش سیگنال.پنجره هان)
    آزمایش.ادعا با پیام(s.فریم ها بزرگتر 1، "the spectrogram should have frames")
    آزمایش.ادعای برابری عدد(s.خانه‌ها، 512)
    آزمایش.ادعای برابری عدد(s.نرخ، 22050)
    آزمایش.ادعا با پیام(پردازش سیگنال.طیف در(s، 0، 0) بزرگتربرابر 0.0، "bins are magnitudes")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.طیف در(s، 0، 9999)، 0.0، 0.0)
    مرکز := پردازش سیگنال.مرکز طیفی(s، 1)
    آزمایش.ادعا با پیام(مرکز بزرگتر 100.0 و مرکز کوچکتر 5000.0، "the centroid should sit in the band")
    افت := پردازش سیگنال.افت طیفی(s، 1، 0.85)
    آزمایش.ادعا با پیام(افت بزرگتربرابر مرکز * 0.5، "rolloff sits above the centroid region")
    تختی := پردازش سیگنال.تختی طیفی(s، 1)
    آزمایش.ادعا با پیام(تختی بزرگتربرابر 0.0 و تختی کوچکتربرابر 1.0، "flatness is a ratio")
    ناپایا نویز := صداساز.نوفه سپید(0.12، 22050)
    ناپایا طیف نویز := پردازش سیگنال.تبدیل فوریه کوتاه(نویز، 1024، 256، پردازش سیگنال.پنجره هان)
    آزمایش.ادعا با پیام(پردازش سیگنال.تختی طیفی(طیف نویز، 1) بزرگتر تختی، "noise is flatter than a harmonic tone")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.شار طیفی(s، 0)، 0.0، 0.0)
    پردازش سیگنال.آزادسازی طیف(طیف نویز)

    سرچاپ "onsets and tempo"
    ناپایا ضرب := صدا.جدید(22050، 1، 22050)
    ناپایا b := 0
    تا b کوچکتر 8:
        آغاز := b * 2756
        ناپایا شمارنده دوم := 0
        تا شمارنده دوم کوچکتر 1000:
            اگر آغاز + شمارنده دوم کوچکتر ضرب.فریم ها:
                پوشش := 1.0 - (شمارنده دوم برگردان اعشار۶۴) / 1000.0
                صدا.تنظیم نمونه(ضرب، آغاز + شمارنده دوم، 0، 0.8 * پوشش * ریاضی.سینوس(2.0 * ریاضی.پی * 600.0 * (شمارنده دوم برگردان اعشار۶۴) / 22050.0))
            پایان
            شمارنده دوم++
        پایان
        b++
    پایان
    ناپایا آغازها := پردازش سیگنال.شناسایی آغازها(ضرب، 1024، 256)
    آزمایش.ادعا با پیام(آغازها.طول() بزرگتربرابر 4، "the clicks should be found")
    ضربان := پردازش سیگنال.شناسایی ضربان(ضرب)
    آزمایش.ادعا با پیام(ضربان بزرگتر 60.0 و ضربان کوچکتر 200.0، "the tempo should be in range")
    آغازها.آزادکن()
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.شناسایی ضربان(صدا.قطعه {})، 0.0، 0.0)

    سرچاپ "loudness in lufs"
    بلندی := پردازش سیگنال.بلندی لافز(بلند)
    آزمایش.ادعا با پیام(بلندی کوچکتر 0.0 و بلندی بزرگتر -40.0، "a full scale tone sits near the top")
    ناپایا ملایم := صدا.کپی(بلند)
    صدا.بهره(ملایم، -20.0)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق((پردازش سیگنال.بلندی لافز(ملایم) - بلندی) + 20.0) کوچکتر 1.0، "twenty decibels down reads twenty lower")
    ناپایا هنجار := صدا.کپی(بلند)
    پردازش سیگنال.هنجارسازی لافز(هنجار، -16.0)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(پردازش سیگنال.بلندی لافز(هنجار) + 16.0) کوچکتر 1.0، "normalising lands on the target")
    آزمایش.ادعای برابری اعشار(پردازش سیگنال.بلندی لافز(صدا.قطعه {})، صدا.کف سکوت، 0.0)
    اوج راستین := پردازش سیگنال.اوج راستین دسیبل(بلند)
    آزمایش.ادعا با پیام(اوج راستین بزرگتربرابر صدا.اوج دسیبل(بلند) - 0.01، "the true peak is never under the sample peak")

    سرچاپ "time stretching and pitch shifting"
    ناپایا بلندتر := پردازش سیگنال.کشش زمانی(منبع، 2.0)
    آزمایش.ادعای برابری عدد(بلندتر.فریم ها، منبع.فریم ها * 2)
    آزمایش.ادعای برابری عدد(بلندتر.نرخ، منبع.نرخ)
    آزمایش.ادعا با پیام(صدا.اوج(بلندتر) بزرگتر 0.5، "stretching keeps the level")
    ناپایا کوتاهتر := پردازش سیگنال.کشش زمانی(منبع، 0.5)
    آزمایش.ادعای برابری عدد(کوتاهتر.فریم ها، منبع.فریم ها / 2)
    آزمایش.ادعای درستی(صدا.خالی است(پردازش سیگنال.کشش زمانی(منبع، 0.0)))
    ناپایا بالارفته := پردازش سیگنال.جابجایی زیروبمی(لا۴، 12.0)
    آزمایش.ادعای برابری عدد(بالارفته.نرخ، لا۴.نرخ)
    جابجا شده := پردازش سیگنال.شناسایی زیروبمی(بالارفته، 0، 4096)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(جابجا شده - 880.0) / 880.0 کوچکتر 0.1، "an octave up should land near 880")

    صدا.آزادسازی(منبع)
    صدا.آزادسازی(e)
    صدا.آزادسازی(بازآوا شده)
    صدا.آزادسازی(خشک)
    صدا.آزادسازی(کر شده)
    صدا.آزادسازی(فلنجر شده)
    صدا.آزادسازی(لرزان)
    صدا.آزادسازی(بلند)
    صدا.آزادسازی(فشرده)
    صدا.آزادسازی(آرام)
    صدا.آزادسازی(داغ)
    صدا.آزادسازی(آمیخته)
    صدا.آزادسازی(دم)
    صدا.آزادسازی(کم‌صدا)
    صدا.آزادسازی(پرصدا)
    صدا.آزادسازی(سکوت)
    صدا.آزادسازی(لا۴)
    صدا.آزادسازی(غنی)
    صدا.آزادسازی(نویز)
    صدا.آزادسازی(ضرب)
    صدا.آزادسازی(ملایم)
    صدا.آزادسازی(هنجار)
    صدا.آزادسازی(بلندتر)
    صدا.آزادسازی(کوتاهتر)
    صدا.آزادسازی(بالارفته)
    پردازش سیگنال.آزادسازی طیف(s)
    برگشت آزمایش.خلاصه()
پایان
