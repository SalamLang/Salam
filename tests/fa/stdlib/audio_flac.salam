بسته ریشه

واردسازی صدا
واردسازی صدا.فلاک
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی ریاضی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی تصادفی
واردسازی آزمایش

تابع کوانتیزه(نرخ نمونه: صحیح، تعداد کانال: صحیح، تعداد فریم: صحیح، تعداد بیت: صحیح، نوع: صحیح): صدا.قطعه:
    ناپایا c := صدا.جدید(نرخ نمونه، تعداد کانال، تعداد فریم)
    تصادفی.بذر(12345 برگردان صحیح۶۴)
    ناپایا i := 0
    تا i کوچکتر تعداد فریم:
        t := (i برگردان اعشار۶۴) / (نرخ نمونه برگردان اعشار۶۴)
        ناپایا کانال := 0
        تا کانال کوچکتر تعداد کانال:
            ناپایا v := 0.0
            اگر نوع برابر 0:
                v = 0.5 * ریاضی.سینوس(2.0 * ریاضی.پی * (220.0 + 110.0 * (کانال برگردان اعشار۶۴)) * t)
            وگرنه نوع برابر 1:
                v = تصادفی.اعشار در بازه(-0.8، 0.8)
            وگرنه نوع برابر 2:
                v = 0.25
            وگرنه:
                v = ((i % 7) برگردان اعشار۶۴) / 16.0 - 0.2
            پایان
            صدا.تنظیم نمونه(c، i، کانال، v)
            کانال += 1
        پایان
        i += 1
    پایان
    ناپایا q := صدا.به بیت(c، تعداد بیت)
    q.بیت ها = تعداد بیت
    صدا.آزادسازی(c)
    برگشت q
پایان

تابع بدترین اختلاف(a: صدا.قطعه، b: صدا.قطعه): اعشار۶۴:
    ناپایا w := 0.0
    ناپایا f := 0
    تا f کوچکتر a.فریم ها:
        ناپایا کانال := 0
        تا کانال کوچکتر a.کانال ها:
            d := ریاضی.قدرمطلق(صدا.نمونه(b، f، کانال) - صدا.نمونه(a، f، کانال))
            اگر d بزرگتر w:
                w = d
            پایان
            کانال += 1
        پایان
        f += 1
    پایان
    برگشت w
پایان

تابع آزمون چرخشی(منبع: صدا.قطعه، سطح فشرده‌سازی: صحیح): صحیح:
    ناپایا کدگذاری شده := فلاک.کدگذاری فلاک با سطح(منبع، سطح فشرده‌سازی)
    آزمایش.ادعا با پیام(فشرده سازی.طول بافر(کدگذاری شده) بزرگتر 42، "flac encoder produced nothing")
    آزمایش.ادعا با پیام(فلاک.فلاک است(کدگذاری شده.داده، کدگذاری شده.طول)، "flac not a flac stream")
    ناپایا اطلاعات جریان := فلاک.آگاهی جریان {}
    آزمایش.ادعا با پیام(فلاک.خواندن آگاهی جریان(کدگذاری شده.داده، کدگذاری شده.طول، اطلاعات جریان)، "flac no streaminfo")
    آزمایش.ادعا با پیام(اطلاعات جریان.نرخ برابر منبع.نرخ، "flac rate")
    آزمایش.ادعا با پیام(اطلاعات جریان.کانال ها برابر منبع.کانال ها، "flac channels")
    آزمایش.ادعا با پیام(اطلاعات جریان.بیت ها برابر منبع.بیت ها، "flac bits")
    آزمایش.ادعا با پیام((اطلاعات جریان.شمار کل برگردان صحیح) برابر منبع.فریم ها، "flac total")
    آزمایش.ادعا با پیام(اطلاعات جریان.ام‌دی۵.طول برابر 16، "flac md5 length")
    فلاک.آزادسازی آگاهی جریان(اطلاعات جریان)
    ناپایا موفق := نادرست
    ناپایا بازخوانی := فلاک.کدگشایی فلاک(کدگذاری شده.داده، کدگذاری شده.طول، موفق)
    آزمایش.ادعا با پیام(موفق، "flac decode failed")
    آزمایش.ادعا با پیام(بازخوانی.فریم ها برابر منبع.فریم ها، "flac frame count")
    آزمایش.ادعا با پیام(بازخوانی.کانال ها برابر منبع.کانال ها، "flac channel count")
    آزمایش.ادعا با پیام(بازخوانی.نرخ برابر منبع.نرخ، "flac decoded rate")
    آزمایش.ادعا با پیام(بازخوانی.بیت ها برابر منبع.بیت ها، "flac decoded bits")
    آزمایش.ادعا با پیام(بدترین اختلاف(منبع، بازخوانی) برابر 0.0، "flac not lossless")
    آزمایش.ادعا با پیام(فلاک.بازبینی فلاک(کدگذاری شده.داده، کدگذاری شده.طول)، "flac verify failed")
    اندازه := فشرده سازی.طول بافر(کدگذاری شده)
    فشرده سازی.آزادسازی بافر(کدگذاری شده)
    صدا.آزادسازی(بازخوانی)
    برگشت اندازه
پایان

تابع ریشه:
    سرچاپ "a tone is lossless and compresses hard"
    ناپایا آوا := کوانتیزه(44100، 2، 8000، 16، 0)
    اندازه آوا := آزمون چرخشی(آوا، 5)
    خام := آوا.فریم ها * آوا.کانال ها * 2
    آزمایش.ادعا با پیام(اندازه آوا کوچکتر خام / 2، "a tone should compress past half")

    سرچاپ "noise is lossless even though it cannot compress"
    ناپایا نویز := کوانتیزه(44100، 2، 4000، 16، 1)
    اندازه نویز := آزمون چرخشی(نویز، 5)
    آزمایش.ادعا با پیام(اندازه نویز بزرگتر خام / 8، "noise should not shrink much")

    سرچاپ "a constant block uses the constant subframe"
    ناپایا ثابت := کوانتیزه(8000، 1، 2000، 16، 2)
    اندازه ثابت := آزمون چرخشی(ثابت، 5)
    آزمایش.ادعا با پیام(اندازه ثابت کوچکتر 400، "a constant signal should be tiny")

    سرچاپ "a sawtooth, where a fixed predictor wins"
    ناپایا دندانه‌ای := کوانتیزه(16000، 1، 3000، 16، 3)
    آزمون چرخشی(دندانه‌ای، 5)

    سرچاپ "mono, stereo and more channels"
    ناپایا تک‌کاناله := کوانتیزه(22050، 1، 2000، 16، 0)
    آزمون چرخشی(تک‌کاناله، 5)
    ناپایا چهارکاناله := کوانتیزه(48000، 4، 1500، 16، 0)
    آزمون چرخشی(چهارکاناله، 5)

    سرچاپ "8, 16 and 24 bit all stay lossless"
    ناپایا هشت‌بیتی := کوانتیزه(8000، 1، 2000، 8، 0)
    آزمون چرخشی(هشت‌بیتی، 5)
    ناپایا بیست‌وچهاربیتی := کوانتیزه(48000، 2، 2000، 24، 0)
    آزمون چرخشی(بیست‌وچهاربیتی، 5)

    سرچاپ "every level round-trips"
    هر سطح در [0، 2، 5، 8]:
        آزمون چرخشی(آوا، سطح)
    پایان

    سرچاپ "odd lengths and a partial last block"
    ناپایا فرد := کوانتیزه(44100، 2، 4097، 16، 0)
    آزمون چرخشی(فرد، 5)
    ناپایا ریز := کوانتیزه(44100، 1، 3، 16، 0)
    آزمون چرخشی(ریز، 5)

    سرچاپ "probe reads the header alone"
    ناپایا کدگذاری شده := فلاک.کدگذاری فلاک(آوا)
    ناپایا بررسی موفق := نادرست
    اطلاعات := فلاک.بررسی فلاک(کدگذاری شده.داده، کدگذاری شده.طول، بررسی موفق)
    آزمایش.ادعای درستی(بررسی موفق)
    آزمایش.ادعای برابری عدد(اطلاعات.قالب، صدا.قالب فلاک)
    آزمایش.ادعای برابری عدد(اطلاعات.نرخ، 44100)
    آزمایش.ادعای برابری عدد(اطلاعات.کانال ها، 2)
    آزمایش.ادعای برابری عدد(اطلاعات.بیت ها، 16)
    آزمایش.ادعای برابری عدد(اطلاعات.فریم ها، 8000)
    آزمایش.ادعای درستی(اطلاعات.بی اتلاف)
    آزمایش.ادعا با پیام(اطلاعات.مدت بزرگتر 0.18 و اطلاعات.مدت کوچکتر 0.19، "about a fifth of a second")

    سرچاپ "metadata blocks and frame headers"
    بلوک‌ها := فلاک.بلوک‌ها(کدگذاری شده.داده، کدگذاری شده.طول)
    آزمایش.ادعای برابری عدد(بلوک‌ها.طول()، 1)
    آزمایش.ادعای برابری عدد(بلوک‌ها.بگیر(0).گونه، فلاک.بلوک آگاهی جریان)
    آزمایش.ادعای درستی(بلوک‌ها.بگیر(0).آخرین)
    آزمایش.ادعای برابری عدد(بلوک‌ها.بگیر(0).اندازه، 34)
    ناپایا اطلاعات جریان۲ := فلاک.آگاهی جریان {}
    آزمایش.ادعای درستی(فلاک.خواندن آگاهی جریان(کدگذاری شده.داده، کدگذاری شده.طول، اطلاعات جریان۲))
    آزمایش.ادعای برابری عدد(اطلاعات جریان۲.جای صدا، 42)
    ناپایا اطلاعات فریم := فلاک.آگاهی فریم {}
    سرآیند := فلاک.خواندن سرآیند فریم(کدگذاری شده.داده، کدگذاری شده.طول، اطلاعات جریان۲.جای صدا، اطلاعات جریان۲، اطلاعات فریم)
    آزمایش.ادعا با پیام(سرآیند بزرگتر 0، "the first frame header should parse")
    آزمایش.ادعای برابری عدد(اطلاعات فریم.کانال ها، 2)
    آزمایش.ادعای برابری عدد(اطلاعات فریم.بیت ها، 16)
    آزمایش.ادعای برابری عدد(اطلاعات فریم.نرخ، 44100)
    آزمایش.ادعای برابری عدد(اطلاعات فریم.اندازه بلوک، 4096)
    فلاک.آزادسازی آگاهی جریان(اطلاعات جریان۲)

    سرچاپ "crc helpers"
    ناپایا بافر آزمایشی := فشرده سازی.بافر بایت جدید()
    هر b در [1، 2، 3، 4]:
        فشرده سازی.افزودن بایت(بافر آزمایشی، b)
    پایان
    آزمایش.ادعا با پیام(فلاک.سی‌آر‌سی۸(بافر آزمایشی.داده، 0، 4) بزرگتربرابر 0، "crc8 runs")
    آزمایش.ادعا با پیام(فلاک.سی‌آر‌سی۱۶(بافر آزمایشی.داده، 0، 4) بزرگتربرابر 0، "crc16 runs")
    آزمایش.ادعای برابری عدد(فلاک.سی‌آر‌سی۸(بافر آزمایشی.داده، 0، 0)، 0)
    آزمایش.ادعای برابری عدد(فلاک.سی‌آر‌سی۱۶ بافر(بافر آزمایشی، 0، 4)، فلاک.سی‌آر‌سی۱۶(بافر آزمایشی.داده، 0، 4))

    سرچاپ "refusals"
    آزمایش.ادعای نادرستی(فلاک.فلاک است(بافر آزمایشی.داده، 4))
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(فلاک.کدگذاری فلاک(صدا.قطعه {}))، 0)
    ناپایا نامعتبر := نادرست
    فلاک.کدگشایی فلاک(بافر آزمایشی.داده، بافر آزمایشی.طول، نامعتبر)
    آزمایش.ادعای نادرستی(نامعتبر)
    آزمایش.ادعای نادرستی(فلاک.بازبینی فلاک(بافر آزمایشی.داده، بافر آزمایشی.طول))
    ناپایا اطلاعات جریان۳ := فلاک.آگاهی جریان {}
    آزمایش.ادعای نادرستی(فلاک.خواندن آگاهی جریان(بافر آزمایشی.داده، بافر آزمایشی.طول، اطلاعات جریان۳))

    سرچاپ "files on disk"
    مسیر := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_flac.flac")
    دیرکن حافظه.آزادسازی(مسیر برگردان تهی*)
    آزمایش.ادعای درستی(فلاک.ذخیره فلاک(آوا، مسیر))
    ناپایا موفق دیسک := نادرست
    ناپایا دیسک := فلاک.بازکردن فلاک(مسیر، موفق دیسک)
    آزمایش.ادعای درستی(موفق دیسک)
    آزمایش.ادعای برابری اعشار(بدترین اختلاف(آوا، دیسک)، 0.0، 0.0)
    آزمایش.ادعای درستی(فلاک.ذخیره فلاک با سطح(آوا، مسیر، 8))
    ناپایا موفق بررسی := نادرست
    اطلاعات دیسک := فلاک.بررسی پرونده فلاک(مسیر، موفق بررسی)
    آزمایش.ادعای درستی(موفق بررسی)
    آزمایش.ادعای برابری عدد(اطلاعات دیسک.فریم ها، 8000)
    ناپایا حذف شده := نادرست
    ناموجود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_flac_none.flac")
    دیرکن حافظه.آزادسازی(ناموجود برگردان تهی*)
    فلاک.بازکردن فلاک(ناموجود، حذف شده)
    آزمایش.ادعای نادرستی(حذف شده)

    فشرده سازی.آزادسازی بافر(کدگذاری شده)
    فشرده سازی.آزادسازی بافر(بافر آزمایشی)
    بلوک‌ها.آزادکن()
    صدا.آزادسازی(آوا)
    صدا.آزادسازی(نویز)
    صدا.آزادسازی(ثابت)
    صدا.آزادسازی(دندانه‌ای)
    صدا.آزادسازی(تک‌کاناله)
    صدا.آزادسازی(چهارکاناله)
    صدا.آزادسازی(هشت‌بیتی)
    صدا.آزادسازی(بیست‌وچهاربیتی)
    صدا.آزادسازی(فرد)
    صدا.آزادسازی(ریز)
    صدا.آزادسازی(دیسک)
    برگشت آزمایش.خلاصه()
پایان
