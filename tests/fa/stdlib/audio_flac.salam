بسته ریشه

واردسازی صدا
واردسازی صدا.فلاک
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی ریاضی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی تصادفی
واردسازی آزمایش

تابع quantized(rate: صحیح، channels: صحیح، frames: صحیح، bits: صحیح، kind: صحیح): صدا.قطعه:
    ناپایا c := صدا.جدید(rate، channels، frames)
    تصادفی.بذر(12345 برگردان صحیح۶۴)
    ناپایا i := 0
    تا i کوچکتر frames:
        t := (i برگردان اعشار۶۴) / (rate برگردان اعشار۶۴)
        ناپایا ch := 0
        تا ch کوچکتر channels:
            ناپایا v := 0.0
            اگر kind برابر 0:
                v = 0.5 * ریاضی.سینوس(2.0 * ریاضی.پی * (220.0 + 110.0 * (ch برگردان اعشار۶۴)) * t)
            وگرنه kind برابر 1:
                v = تصادفی.اعشار در بازه(-0.8، 0.8)
            وگرنه kind برابر 2:
                v = 0.25
            وگرنه:
                v = ((i % 7) برگردان اعشار۶۴) / 16.0 - 0.2
            پایان
            صدا.تنظیم نمونه(c، i، ch، v)
            ch += 1
        پایان
        i += 1
    پایان
    ناپایا q := صدا.به بیت(c، bits)
    q.بیت ها = bits
    صدا.آزادسازی(c)
    برگشت q
پایان

تابع worst(a: صدا.قطعه، b: صدا.قطعه): اعشار۶۴:
    ناپایا w := 0.0
    ناپایا f := 0
    تا f کوچکتر a.فریم ها:
        ناپایا ch := 0
        تا ch کوچکتر a.کانال ها:
            d := ریاضی.قدرمطلق(صدا.نمونه(b، f، ch) - صدا.نمونه(a، f، ch))
            اگر d بزرگتر w:
                w = d
            پایان
            ch += 1
        پایان
        f += 1
    پایان
    برگشت w
پایان

تابع roundtrip(src: صدا.قطعه، level: صحیح): صحیح:
    enc := فلاک.کدگذاری فلاک با سطح(src، level)
    آزمایش.ادعا با پیام(فشرده سازی.طول بافر(enc) بزرگتر 42، "flac encoder produced nothing")
    آزمایش.ادعا با پیام(فلاک.فلاک است(enc.داده، enc.طول)، "flac not a flac stream")
    ناپایا si := فلاک.آگاهی جریان {}
    آزمایش.ادعا با پیام(فلاک.خواندن آگاهی جریان(enc.داده، enc.طول، si)، "flac no streaminfo")
    آزمایش.ادعا با پیام(si.نرخ برابر src.نرخ، "flac rate")
    آزمایش.ادعا با پیام(si.کانال ها برابر src.کانال ها، "flac channels")
    آزمایش.ادعا با پیام(si.بیت ها برابر src.بیت ها، "flac bits")
    آزمایش.ادعا با پیام((si.شمار کل برگردان صحیح) برابر src.فریم ها، "flac total")
    آزمایش.ادعا با پیام(si.ام‌دی۵.طول برابر 16، "flac md5 length")
    فلاک.آزادسازی آگاهی جریان(si)
    ناپایا ok := نادرست
    ناپایا back := فلاک.کدگشایی فلاک(enc.داده، enc.طول، ok)
    آزمایش.ادعا با پیام(ok، "flac decode failed")
    آزمایش.ادعا با پیام(back.فریم ها برابر src.فریم ها، "flac frame count")
    آزمایش.ادعا با پیام(back.کانال ها برابر src.کانال ها، "flac channel count")
    آزمایش.ادعا با پیام(back.نرخ برابر src.نرخ، "flac decoded rate")
    آزمایش.ادعا با پیام(back.بیت ها برابر src.بیت ها، "flac decoded bits")
    آزمایش.ادعا با پیام(worst(src، back) برابر 0.0، "flac not lossless")
    آزمایش.ادعا با پیام(فلاک.بازبینی فلاک(enc.داده، enc.طول)، "flac verify failed")
    size := فشرده سازی.طول بافر(enc)
    فشرده سازی.آزادسازی بافر(enc)
    صدا.آزادسازی(back)
    برگشت size
پایان

تابع ریشه:
    سرچاپ "a tone is lossless and compresses hard"
    ناپایا tone := quantized(44100، 2، 8000، 16، 0)
    tone_size := roundtrip(tone، 5)
    raw := tone.فریم ها * tone.کانال ها * 2
    آزمایش.ادعا با پیام(tone_size کوچکتر raw / 2، "a tone should compress past half")

    سرچاپ "noise is lossless even though it cannot compress"
    ناپایا noise := quantized(44100، 2، 4000، 16، 1)
    noise_size := roundtrip(noise، 5)
    آزمایش.ادعا با پیام(noise_size بزرگتر raw / 8، "noise should not shrink much")

    سرچاپ "a constant block uses the constant subframe"
    ناپایا flat := quantized(8000، 1، 2000، 16، 2)
    flat_size := roundtrip(flat، 5)
    آزمایش.ادعا با پیام(flat_size کوچکتر 400، "a constant signal should be tiny")

    سرچاپ "a sawtooth, where a fixed predictor wins"
    ناپایا saw := quantized(16000، 1، 3000، 16، 3)
    roundtrip(saw، 5)

    سرچاپ "mono, stereo and more channels"
    ناپایا m1 := quantized(22050، 1، 2000، 16، 0)
    roundtrip(m1، 5)
    ناپایا m4 := quantized(48000، 4، 1500، 16، 0)
    roundtrip(m4، 5)

    سرچاپ "8, 16 and 24 bit all stay lossless"
    ناپایا b8 := quantized(8000، 1، 2000، 8، 0)
    roundtrip(b8، 5)
    ناپایا b24 := quantized(48000، 2، 2000، 24، 0)
    roundtrip(b24، 5)

    سرچاپ "every level round-trips"
    هر lv در [0، 2، 5، 8]:
        roundtrip(tone، lv)
    پایان

    سرچاپ "odd lengths and a partial last block"
    ناپایا odd := quantized(44100، 2، 4097، 16، 0)
    roundtrip(odd، 5)
    ناپایا tiny := quantized(44100، 1، 3، 16، 0)
    roundtrip(tiny، 5)

    سرچاپ "probe reads the header alone"
    enc := فلاک.کدگذاری فلاک(tone)
    ناپایا pok := نادرست
    info := فلاک.بررسی فلاک(enc.داده، enc.طول، pok)
    آزمایش.ادعای درستی(pok)
    آزمایش.ادعای برابری عدد(info.قالب، صدا.قالب فلاک)
    آزمایش.ادعای برابری عدد(info.نرخ، 44100)
    آزمایش.ادعای برابری عدد(info.کانال ها، 2)
    آزمایش.ادعای برابری عدد(info.بیت ها، 16)
    آزمایش.ادعای برابری عدد(info.فریم ها، 8000)
    آزمایش.ادعای درستی(info.بی اتلاف)
    آزمایش.ادعا با پیام(info.مدت بزرگتر 0.18 و info.مدت کوچکتر 0.19، "about a fifth of a second")

    سرچاپ "metadata blocks and frame headers"
    blocks := فلاک.بلوک‌ها(enc.داده، enc.طول)
    آزمایش.ادعای برابری عدد(blocks.طول()، 1)
    آزمایش.ادعای برابری عدد(blocks.بگیر(0).گونه، فلاک.بلوک آگاهی جریان)
    آزمایش.ادعای درستی(blocks.بگیر(0).آخرین)
    آزمایش.ادعای برابری عدد(blocks.بگیر(0).اندازه، 34)
    ناپایا si2 := فلاک.آگاهی جریان {}
    آزمایش.ادعای درستی(فلاک.خواندن آگاهی جریان(enc.داده، enc.طول، si2))
    آزمایش.ادعای برابری عدد(si2.جای صدا، 42)
    ناپایا fi := فلاک.آگاهی فریم {}
    head := فلاک.خواندن سرآیند فریم(enc.داده، enc.طول، si2.جای صدا، si2، fi)
    آزمایش.ادعا با پیام(head بزرگتر 0، "the first frame header should parse")
    آزمایش.ادعای برابری عدد(fi.کانال ها، 2)
    آزمایش.ادعای برابری عدد(fi.بیت ها، 16)
    آزمایش.ادعای برابری عدد(fi.نرخ، 44100)
    آزمایش.ادعای برابری عدد(fi.اندازه بلوک، 4096)
    فلاک.آزادسازی آگاهی جریان(si2)

    سرچاپ "crc helpers"
    ناپایا probe := فشرده سازی.بافر بایت جدید()
    هر b در [1، 2، 3، 4]:
        فشرده سازی.افزودن بایت(probe، b)
    پایان
    آزمایش.ادعا با پیام(فلاک.سی‌آر‌سی۸(probe.داده، 0، 4) بزرگتربرابر 0، "crc8 runs")
    آزمایش.ادعا با پیام(فلاک.سی‌آر‌سی۱۶(probe.داده، 0، 4) بزرگتربرابر 0، "crc16 runs")
    آزمایش.ادعای برابری عدد(فلاک.سی‌آر‌سی۸(probe.داده، 0، 0)، 0)
    آزمایش.ادعای برابری عدد(فلاک.سی‌آر‌سی۱۶ بافر(probe، 0، 4)، فلاک.سی‌آر‌سی۱۶(probe.داده، 0، 4))

    سرچاپ "refusals"
    آزمایش.ادعای نادرستی(فلاک.فلاک است(probe.داده، 4))
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(فلاک.کدگذاری فلاک(صدا.قطعه {}))، 0)
    ناپایا bad := نادرست
    فلاک.کدگشایی فلاک(probe.داده، probe.طول، bad)
    آزمایش.ادعای نادرستی(bad)
    آزمایش.ادعای نادرستی(فلاک.بازبینی فلاک(probe.داده، probe.طول))
    ناپایا si3 := فلاک.آگاهی جریان {}
    آزمایش.ادعای نادرستی(فلاک.خواندن آگاهی جریان(probe.داده، probe.طول، si3))

    سرچاپ "files on disk"
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_flac.flac")
    دیرکن حافظه.آزادسازی(path برگردان تهی*)
    آزمایش.ادعای درستی(فلاک.ذخیره فلاک(tone، path))
    ناپایا dok := نادرست
    ناپایا disk := فلاک.بازکردن فلاک(path، dok)
    آزمایش.ادعای درستی(dok)
    آزمایش.ادعای برابری اعشار(worst(tone، disk)، 0.0، 0.0)
    آزمایش.ادعای درستی(فلاک.ذخیره فلاک با سطح(tone، path، 8))
    ناپایا iok := نادرست
    dinfo := فلاک.بررسی پرونده فلاک(path، iok)
    آزمایش.ادعای درستی(iok)
    آزمایش.ادعای برابری عدد(dinfo.فریم ها، 8000)
    ناپایا gone := نادرست
    missing := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_flac_none.flac")
    دیرکن حافظه.آزادسازی(missing برگردان تهی*)
    فلاک.بازکردن فلاک(missing، gone)
    آزمایش.ادعای نادرستی(gone)

    فشرده سازی.آزادسازی بافر(enc)
    فشرده سازی.آزادسازی بافر(probe)
    blocks.آزادکن()
    صدا.آزادسازی(tone)
    صدا.آزادسازی(noise)
    صدا.آزادسازی(flat)
    صدا.آزادسازی(saw)
    صدا.آزادسازی(m1)
    صدا.آزادسازی(m4)
    صدا.آزادسازی(b8)
    صدا.آزادسازی(b24)
    صدا.آزادسازی(odd)
    صدا.آزادسازی(tiny)
    صدا.آزادسازی(disk)
    برگشت آزمایش.خلاصه()
پایان
