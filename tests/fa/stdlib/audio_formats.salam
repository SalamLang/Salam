بسته ریشه

واردسازی صدا
واردسازی صدا.ایف
واردسازی صدا.ای‌یو
واردسازی صدا.کدک
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی ریاضی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی آزمایش

تابع make_clip(rate: صحیح، channels: صحیح، frames: صحیح، denom: اعشار۶۴، step: صحیح): صدا.قطعه:
    ناپایا c := صدا.جدید(rate، channels، frames)
    ناپایا f := 0
    تا f کوچکتر frames:
        ناپایا ch := 0
        تا ch کوچکتر channels:
            k := ((f * channels + ch) * step) - (frames * channels * step) / 2
            صدا.تنظیم نمونه(c، f، ch، (k برگردان اعشار۶۴) / denom)
            ch += 1
        پایان
        f += 1
    پایان
    برگشت c
پایان

تابع worst(a: صدا.قطعه، b: صدا.قطعه): اعشار۶۴:
    ناپایا w := 0.0
    ناپایا f := 0
    تا f کوچکتر a.فریم ها:
        ناپایا ch := 0
        تا ch کوچکتر a.کانال ها:
            d := ریاضی.قدرمطلق(صدا.نمونه(b، f، ch) - صدا.نمونه(a، f، ch))
            اگر d بزرگتر w:
                w = d
            پایان
            ch += 1
        پایان
        f += 1
    پایان
    برگشت w
پایان

تابع ریشه:
    سرچاپ "aiff round-trips bit for bit"
    c16 := make_clip(44100، 2، 64، 32768.0، 501)
    c24 := make_clip(48000، 2، 64، 8388608.0، 131071)
    c8 := make_clip(8000، 1، 64، 128.0، 1)
    هر pair در [16، 24، 8]:
        src := pair برابر 16 ? c16 : (pair برابر 24 ? c24 : c8)
        enc := ایف.کدگذاری ایف با بیت(src، pair)
        آزمایش.ادعای درستی(ایف.ایف است(enc.داده، enc.طول))
        ناپایا ok := نادرست
        ناپایا back := ایف.کدگشایی ایف(enc.داده، enc.طول، ok)
        آزمایش.ادعای درستی(ok)
        آزمایش.ادعای برابری عدد(back.فریم ها، src.فریم ها)
        آزمایش.ادعای برابری عدد(back.کانال ها، src.کانال ها)
        آزمایش.ادعای برابری عدد(back.نرخ، src.نرخ)
        آزمایش.ادعای برابری عدد(back.بیت ها، pair)
        آزمایش.ادعای برابری اعشار(worst(src، back)، 0.0، 0.0)
        فشرده سازی.آزادسازی بافر(enc)
        صدا.آزادسازی(back)
    پایان

    سرچاپ "the 80 bit sample rate survives every common value"
    هر rate در [8000، 11025، 16000، 22050، 32000، 44100، 48000، 88200، 96000، 192000]:
        ناپایا one := صدا.جدید(rate، 1، 4)
        enc := ایف.کدگذاری ایف با بیت(one، 16)
        ناپایا cm := ایف.مشترک {}
        آزمایش.ادعای درستی(ایف.خواندن مشترک(enc.داده، enc.طول، cm))
        آزمایش.ادعای برابری عدد(cm.نرخ، rate)
        فشرده سازی.آزادسازی بافر(enc)
        صدا.آزادسازی(one)
    پایان

    سرچاپ "aiff headers and refusals"
    enc := ایف.کدگذاری ایف با بیت(c16، 16)
    ناپایا cm := ایف.مشترک {}
    آزمایش.ادعای درستی(ایف.خواندن مشترک(enc.داده، enc.طول، cm))
    آزمایش.ادعای برابری عدد(cm.کانال ها، 2)
    آزمایش.ادعای برابری عدد(cm.فریم ها، 64)
    آزمایش.ادعای برابری عدد(cm.بیت ها، 16)
    آزمایش.ادعای برابری عدد(cm.روش فشرده، ایف.فشرده هیچ)
    ناپایا pok := نادرست
    info := ایف.بررسی ایف(enc.داده، enc.طول، pok)
    آزمایش.ادعای درستی(pok)
    آزمایش.ادعای برابری عدد(info.قالب، صدا.قالب ایف)
    آزمایش.ادعای برابری عدد(info.فریم ها، 64)
    آزمایش.ادعای درستی(info.بی اتلاف)
    آزمایش.ادعای نادرستی(ایف.ایف است(enc.داده، 4))
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ایف.کدگذاری ایف با بیت(c16، 12))، 0)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ایف.کدگذاری ایف(صدا.قطعه {}))، 0)

    سرچاپ "au round-trips bit for bit"
    هر bits در [8، 16، 24، 32]:
        src := bits برابر 8 ? c8 : (bits برابر 24 ? c24 : c16)
        enc2 := ای‌یو.کدگذاری ای‌یو با رمز(src، bits برابر 8 ? ای‌یو.رمز پی‌سی‌ام۸ : (bits برابر 16 ? ای‌یو.رمز پی‌سی‌ام۱۶ : (bits برابر 24 ? ای‌یو.رمز پی‌سی‌ام۲۴ : ای‌یو.رمز پی‌سی‌ام۳۲)))
        آزمایش.ادعای درستی(ای‌یو.ای‌یو است(enc2.داده، enc2.طول))
        ناپایا ok2 := نادرست
        ناپایا back2 := ای‌یو.کدگشایی ای‌یو(enc2.داده، enc2.طول، ok2)
        آزمایش.ادعای درستی(ok2)
        آزمایش.ادعای برابری عدد(back2.فریم ها، src.فریم ها)
        آزمایش.ادعای برابری عدد(back2.بیت ها، bits)
        اگر bits برابر 32:
            آزمایش.ادعا با پیام(worst(src، back2) بزرگتربرابر 0.0، "32 bit au decodes")
        وگرنه:
            آزمایش.ادعای برابری اعشار(worst(src، back2)، 0.0، 0.0)
        پایان
        فشرده سازی.آزادسازی بافر(enc2)
        صدا.آزادسازی(back2)
    پایان

    سرچاپ "au floats and companding"
    fenc := ای‌یو.کدگذاری ای‌یو با رمز(c16، ای‌یو.رمز اعشار۳۲)
    ناپایا fok := نادرست
    ناپایا fback := ای‌یو.کدگشایی ای‌یو(fenc.داده، fenc.طول، fok)
    آزمایش.ادعای درستی(fok)
    آزمایش.ادعای برابری اعشار(worst(c16، fback)، 0.0، 0.0)
    menc := ای‌یو.کدگذاری ای‌یو با رمز(c16، ای‌یو.رمز میولا)
    ناپایا mok := نادرست
    ناپایا mback := ای‌یو.کدگشایی ای‌یو(menc.داده، menc.طول، mok)
    آزمایش.ادعای درستی(mok)
    آزمایش.ادعای برابری عدد(mback.بیت ها، 16)
    آزمایش.ادعا با پیام(worst(c16، mback) کوچکتر 0.05، "au mu-law stays close")
    aenc := ای‌یو.کدگذاری ای‌یو با رمز(c16، ای‌یو.رمز ای‌لا)
    ناپایا aok := نادرست
    ناپایا aback := ای‌یو.کدگشایی ای‌یو(aenc.داده، aenc.طول، aok)
    آزمایش.ادعای درستی(aok)
    آزمایش.ادعا با پیام(worst(c16، aback) کوچکتر 0.05، "au a-law stays close")

    سرچاپ "au headers and refusals"
    ناپایا h := ای‌یو.سرآیند {}
    آزمایش.ادعای درستی(ای‌یو.خواندن سرآیند(menc.داده، menc.طول، h))
    آزمایش.ادعای برابری عدد(h.جای داده، ای‌یو.اندازه سرآیند)
    آزمایش.ادعای برابری عدد(h.رمزگذاری، ای‌یو.رمز میولا)
    آزمایش.ادعای برابری عدد(h.نرخ، 44100)
    آزمایش.ادعای برابری عدد(h.کانال ها، 2)
    آزمایش.ادعای برابری عدد(h.اندازه داده، 64 * 2)
    ناپایا aupok := نادرست
    auinfo := ای‌یو.بررسی ای‌یو(menc.داده، menc.طول، aupok)
    آزمایش.ادعای درستی(aupok)
    آزمایش.ادعای برابری عدد(auinfo.قالب، صدا.قالب اواسنیدی)
    آزمایش.ادعای نادرستی(auinfo.بی اتلاف)
    آزمایش.ادعای نادرستی(ای‌یو.ای‌یو است(menc.داده، 8))
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ای‌یو.کدگذاری ای‌یو با رمز(c16، 99))، 0)

    سرچاپ "both reach the generic entry points"
    آزمایش.ادعای درستی(کدک.کدگشایی شدنی(صدا.قالب ایف))
    آزمایش.ادعای درستی(کدک.کدگشایی شدنی(صدا.قالب اواسنیدی))
    آزمایش.ادعای درستی(کدک.کدگذاری شدنی(صدا.قالب ایف))
    ناپایا fmts := کدک.قالب‌ها()
    آزمایش.ادعای برابری عدد(fmts.طول()، 4)
    fmts.آزادکن()
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(enc.داده، enc.طول)، صدا.قالب ایف)
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(menc.داده، menc.طول)، صدا.قالب اواسنیدی)
    ناپایا gok := نادرست
    ناپایا gback := کدک.کدگشایی(enc.داده، enc.طول، gok)
    آزمایش.ادعای درستی(gok)
    آزمایش.ادعای برابری عدد(gback.فریم ها، 64)

    سرچاپ "a clip that remembers its depth keeps it through a generic save"
    c24.بیت ها = 24
    آزمایش.ادعای برابری عدد(c24.بیت ها، 24)

    سرچاپ "and to disk by extension"
    apath := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_fmt.aiff")
    دیرکن حافظه.آزادسازی(apath برگردان تهی*)
    upath := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_fmt.au")
    دیرکن حافظه.آزادسازی(upath برگردان تهی*)
    آزمایش.ادعای درستی(کدک.ذخیره(c24، apath))
    آزمایش.ادعای درستی(کدک.ذخیره(c24، upath))
    ناپایا dok := نادرست
    ناپایا adisk := کدک.بازکردن(apath، dok)
    آزمایش.ادعای درستی(dok)
    آزمایش.ادعای برابری عدد(adisk.بیت ها، 24)
    آزمایش.ادعای برابری اعشار(worst(c24، adisk)، 0.0، 0.0)
    ناپایا uok := نادرست
    ناپایا udisk := کدک.بازکردن(upath، uok)
    آزمایش.ادعای درستی(uok)
    آزمایش.ادعای برابری عدد(udisk.بیت ها، 24)
    آزمایش.ادعای برابری اعشار(worst(c24، udisk)، 0.0، 0.0)
    آزمایش.ادعای درستی(ایف.ذخیره ایف با بیت(c16، apath، 16))
    آزمایش.ادعای درستی(ای‌یو.ذخیره ای‌یو(c16، upath))
    ناپایا nok := نادرست
    gonepath := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_none.aiff")
    دیرکن حافظه.آزادسازی(gonepath برگردان تهی*)
    ایف.بازکردن ایف(gonepath، nok)
    آزمایش.ادعای نادرستی(nok)

    فشرده سازی.آزادسازی بافر(enc)
    فشرده سازی.آزادسازی بافر(fenc)
    فشرده سازی.آزادسازی بافر(menc)
    فشرده سازی.آزادسازی بافر(aenc)
    صدا.آزادسازی(c8)
    صدا.آزادسازی(c16)
    صدا.آزادسازی(c24)
    صدا.آزادسازی(fback)
    صدا.آزادسازی(mback)
    صدا.آزادسازی(aback)
    صدا.آزادسازی(gback)
    صدا.آزادسازی(adisk)
    صدا.آزادسازی(udisk)
    برگشت آزمایش.خلاصه()
پایان
