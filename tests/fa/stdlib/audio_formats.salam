بسته ریشه

واردسازی صدا
واردسازی صدا.ایف
واردسازی صدا.ای‌یو
واردسازی صدا.کدک
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی ریاضی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی آزمایش

تابع ساخت قطعه(نرخ: صحیح، تعداد کانال: صحیح، تعداد فریم: صحیح، مخرج: اعشار۶۴، گام: صحیح): صدا.قطعه:
    ناپایا c := صدا.جدید(نرخ، تعداد کانال، تعداد فریم)
    ناپایا f := 0
    تا f کوچکتر تعداد فریم:
        ناپایا کانال := 0
        تا کانال کوچکتر تعداد کانال:
            k := ((f * تعداد کانال + کانال) * گام) - (تعداد فریم * تعداد کانال * گام) / 2
            صدا.تنظیم نمونه(c، f، کانال، (k برگردان اعشار۶۴) / مخرج)
            کانال++
        پایان
        f++
    پایان
    برگشت c
پایان

تابع بدترین اختلاف(a: صدا.قطعه، b: صدا.قطعه): اعشار۶۴:
    ناپایا w := 0.0
    ناپایا f := 0
    تا f کوچکتر a.فریم ها:
        ناپایا کانال := 0
        تا کانال کوچکتر a.کانال ها:
            d := ریاضی.قدرمطلق(صدا.نمونه(b، f، کانال) - صدا.نمونه(a، f، کانال))
            اگر d بزرگتر w:
                w = d
            پایان
            کانال++
        پایان
        f++
    پایان
    برگشت w
پایان

تابع ریشه:
    سرچاپ "aiff round-trips bit for bit"
    ناپایا قطعه۱۶ := ساخت قطعه(44100، 2، 64، 32768.0، 501)
    ناپایا قطعه۲۴ := ساخت قطعه(48000، 2، 64، 8388608.0، 131071)
    ناپایا قطعه۸ := ساخت قطعه(8000، 1، 64، 128.0، 1)
    هر عمق در [16، 24، 8]:
        منبع := عمق برابر 16 ? قطعه۱۶ : (عمق برابر 24 ? قطعه۲۴ : قطعه۸)
        ناپایا کدگذاری شده := ایف.کدگذاری ایف با بیت(منبع، عمق)
        آزمایش.ادعای درستی(ایف.ایف است(کدگذاری شده.داده، کدگذاری شده.طول))
        ناپایا موفق := نادرست
        ناپایا بازخوانی := ایف.کدگشایی ایف(کدگذاری شده.داده، کدگذاری شده.طول، موفق)
        آزمایش.ادعای درستی(موفق)
        آزمایش.ادعای برابری عدد(بازخوانی.فریم ها، منبع.فریم ها)
        آزمایش.ادعای برابری عدد(بازخوانی.کانال ها، منبع.کانال ها)
        آزمایش.ادعای برابری عدد(بازخوانی.نرخ، منبع.نرخ)
        آزمایش.ادعای برابری عدد(بازخوانی.بیت ها، عمق)
        آزمایش.ادعای برابری اعشار(بدترین اختلاف(منبع، بازخوانی)، 0.0، 0.0)
        فشرده سازی.آزادسازی بافر(کدگذاری شده)
        صدا.آزادسازی(بازخوانی)
    پایان

    سرچاپ "the 80 bit sample rate survives every common value"
    هر نرخ در [8000، 11025، 16000، 22050، 32000، 44100، 48000، 88200، 96000، 192000]:
        ناپایا تک := صدا.جدید(نرخ، 1، 4)
        ناپایا کدگذاری شده := ایف.کدگذاری ایف با بیت(تک، 16)
        ناپایا مشترک شده := ایف.مشترک {}
        آزمایش.ادعای درستی(ایف.خواندن مشترک(کدگذاری شده.داده، کدگذاری شده.طول، مشترک شده))
        آزمایش.ادعای برابری عدد(مشترک شده.نرخ، نرخ)
        فشرده سازی.آزادسازی بافر(کدگذاری شده)
        صدا.آزادسازی(تک)
    پایان

    سرچاپ "aiff headers and refusals"
    ناپایا کدگذاری شده := ایف.کدگذاری ایف با بیت(قطعه۱۶، 16)
    ناپایا مشترک شده := ایف.مشترک {}
    آزمایش.ادعای درستی(ایف.خواندن مشترک(کدگذاری شده.داده، کدگذاری شده.طول، مشترک شده))
    آزمایش.ادعای برابری عدد(مشترک شده.کانال ها، 2)
    آزمایش.ادعای برابری عدد(مشترک شده.فریم ها، 64)
    آزمایش.ادعای برابری عدد(مشترک شده.بیت ها، 16)
    آزمایش.ادعای برابری عدد(مشترک شده.روش فشرده، ایف.فشرده هیچ)
    ناپایا بررسی موفق := نادرست
    اطلاعات := ایف.بررسی ایف(کدگذاری شده.داده، کدگذاری شده.طول، بررسی موفق)
    آزمایش.ادعای درستی(بررسی موفق)
    آزمایش.ادعای برابری عدد(اطلاعات.قالب، صدا.قالب ایف)
    آزمایش.ادعای برابری عدد(اطلاعات.فریم ها، 64)
    آزمایش.ادعای درستی(اطلاعات.بی اتلاف)
    آزمایش.ادعای نادرستی(ایف.ایف است(کدگذاری شده.داده، 4))
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ایف.کدگذاری ایف با بیت(قطعه۱۶، 12))، 0)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ایف.کدگذاری ایف(صدا.قطعه {}))، 0)

    سرچاپ "au round-trips bit for bit"
    هر بیت در [8، 16، 24، 32]:
        منبع := بیت برابر 8 ? قطعه۸ : (بیت برابر 24 ? قطعه۲۴ : قطعه۱۶)
        ناپایا کدگذاری شده۲ := ای‌یو.کدگذاری ای‌یو با رمز(منبع، بیت برابر 8 ? ای‌یو.رمز پی‌سی‌ام۸ : (بیت برابر 16 ? ای‌یو.رمز پی‌سی‌ام۱۶ : (بیت برابر 24 ? ای‌یو.رمز پی‌سی‌ام۲۴ : ای‌یو.رمز پی‌سی‌ام۳۲)))
        آزمایش.ادعای درستی(ای‌یو.ای‌یو است(کدگذاری شده۲.داده، کدگذاری شده۲.طول))
        ناپایا موفق۲ := نادرست
        ناپایا بازخوانی۲ := ای‌یو.کدگشایی ای‌یو(کدگذاری شده۲.داده، کدگذاری شده۲.طول، موفق۲)
        آزمایش.ادعای درستی(موفق۲)
        آزمایش.ادعای برابری عدد(بازخوانی۲.فریم ها، منبع.فریم ها)
        آزمایش.ادعای برابری عدد(بازخوانی۲.بیت ها، بیت)
        اگر بیت برابر 32:
            آزمایش.ادعا با پیام(بدترین اختلاف(منبع، بازخوانی۲) بزرگتربرابر 0.0، "32 bit au decodes")
        وگرنه:
            آزمایش.ادعای برابری اعشار(بدترین اختلاف(منبع، بازخوانی۲)، 0.0، 0.0)
        پایان
        فشرده سازی.آزادسازی بافر(کدگذاری شده۲)
        صدا.آزادسازی(بازخوانی۲)
    پایان

    سرچاپ "au floats and companding"
    ناپایا کدگذاری اعشار := ای‌یو.کدگذاری ای‌یو با رمز(قطعه۱۶، ای‌یو.رمز اعشار۳۲)
    ناپایا موفق اعشار := نادرست
    ناپایا بازخوانی اعشار := ای‌یو.کدگشایی ای‌یو(کدگذاری اعشار.داده، کدگذاری اعشار.طول، موفق اعشار)
    آزمایش.ادعای درستی(موفق اعشار)
    آزمایش.ادعای برابری اعشار(بدترین اختلاف(قطعه۱۶، بازخوانی اعشار)، 0.0، 0.0)
    ناپایا کدگذاری میولا := ای‌یو.کدگذاری ای‌یو با رمز(قطعه۱۶، ای‌یو.رمز میولا)
    ناپایا موفق میولا := نادرست
    ناپایا بازخوانی میولا := ای‌یو.کدگشایی ای‌یو(کدگذاری میولا.داده، کدگذاری میولا.طول، موفق میولا)
    آزمایش.ادعای درستی(موفق میولا)
    آزمایش.ادعای برابری عدد(بازخوانی میولا.بیت ها، 16)
    آزمایش.ادعا با پیام(بدترین اختلاف(قطعه۱۶، بازخوانی میولا) کوچکتر 0.05، "au mu-law stays close")
    ناپایا کدگذاری ای‌لا := ای‌یو.کدگذاری ای‌یو با رمز(قطعه۱۶، ای‌یو.رمز ای‌لا)
    ناپایا موفق ای‌لا := نادرست
    ناپایا بازخوانی ای‌لا := ای‌یو.کدگشایی ای‌یو(کدگذاری ای‌لا.داده، کدگذاری ای‌لا.طول، موفق ای‌لا)
    آزمایش.ادعای درستی(موفق ای‌لا)
    آزمایش.ادعا با پیام(بدترین اختلاف(قطعه۱۶، بازخوانی ای‌لا) کوچکتر 0.05، "au a-law stays close")

    سرچاپ "au headers and refusals"
    ناپایا سرآیند ای‌یو := ای‌یو.سرآیند {}
    آزمایش.ادعای درستی(ای‌یو.خواندن سرآیند(کدگذاری میولا.داده، کدگذاری میولا.طول، سرآیند ای‌یو))
    آزمایش.ادعای برابری عدد(سرآیند ای‌یو.جای داده، ای‌یو.اندازه سرآیند)
    آزمایش.ادعای برابری عدد(سرآیند ای‌یو.رمزگذاری، ای‌یو.رمز میولا)
    آزمایش.ادعای برابری عدد(سرآیند ای‌یو.نرخ، 44100)
    آزمایش.ادعای برابری عدد(سرآیند ای‌یو.کانال ها، 2)
    آزمایش.ادعای برابری عدد(سرآیند ای‌یو.اندازه داده، 64 * 2)
    ناپایا بررسی موفق ای‌یو := نادرست
    اطلاعات ای‌یو := ای‌یو.بررسی ای‌یو(کدگذاری میولا.داده، کدگذاری میولا.طول، بررسی موفق ای‌یو)
    آزمایش.ادعای درستی(بررسی موفق ای‌یو)
    آزمایش.ادعای برابری عدد(اطلاعات ای‌یو.قالب، صدا.قالب اواسنیدی)
    آزمایش.ادعای نادرستی(اطلاعات ای‌یو.بی اتلاف)
    آزمایش.ادعای نادرستی(ای‌یو.ای‌یو است(کدگذاری میولا.داده، 8))
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ای‌یو.کدگذاری ای‌یو با رمز(قطعه۱۶، 99))، 0)

    سرچاپ "both reach the generic entry points"
    آزمایش.ادعای درستی(کدک.کدگشایی شدنی(صدا.قالب ایف))
    آزمایش.ادعای درستی(کدک.کدگشایی شدنی(صدا.قالب اواسنیدی))
    آزمایش.ادعای درستی(کدک.کدگذاری شدنی(صدا.قالب ایف))
    ناپایا قالب‌ها := کدک.قالب‌ها()
    آزمایش.ادعای برابری عدد(قالب‌ها.طول()، 4)
    قالب‌ها.آزادکن()
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(کدگذاری شده.داده، کدگذاری شده.طول)، صدا.قالب ایف)
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(کدگذاری میولا.داده، کدگذاری میولا.طول)، صدا.قالب اواسنیدی)
    ناپایا موفق عمومی := نادرست
    ناپایا بازخوانی عمومی := کدک.کدگشایی(کدگذاری شده.داده، کدگذاری شده.طول، موفق عمومی)
    آزمایش.ادعای درستی(موفق عمومی)
    آزمایش.ادعای برابری عدد(بازخوانی عمومی.فریم ها، 64)

    سرچاپ "a clip that remembers its depth keeps it through a generic save"
    قطعه۲۴.بیت ها = 24
    آزمایش.ادعای برابری عدد(قطعه۲۴.بیت ها، 24)

    سرچاپ "and to disk by extension"
    مسیر ایف := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_fmt.aiff")
    دیرکن حافظه.آزادسازی(مسیر ایف برگردان تهی*)
    مسیر ای‌یو := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_fmt.au")
    دیرکن حافظه.آزادسازی(مسیر ای‌یو برگردان تهی*)
    آزمایش.ادعای درستی(کدک.ذخیره(قطعه۲۴، مسیر ایف))
    آزمایش.ادعای درستی(کدک.ذخیره(قطعه۲۴، مسیر ای‌یو))
    ناپایا موفق دیسک := نادرست
    ناپایا دیسک ایف := کدک.بازکردن(مسیر ایف، موفق دیسک)
    آزمایش.ادعای درستی(موفق دیسک)
    آزمایش.ادعای برابری عدد(دیسک ایف.بیت ها، 24)
    آزمایش.ادعای برابری اعشار(بدترین اختلاف(قطعه۲۴، دیسک ایف)، 0.0، 0.0)
    ناپایا موفق دیسک ای‌یو := نادرست
    ناپایا دیسک ای‌یو := کدک.بازکردن(مسیر ای‌یو، موفق دیسک ای‌یو)
    آزمایش.ادعای درستی(موفق دیسک ای‌یو)
    آزمایش.ادعای برابری عدد(دیسک ای‌یو.بیت ها، 24)
    آزمایش.ادعای برابری اعشار(بدترین اختلاف(قطعه۲۴، دیسک ای‌یو)، 0.0، 0.0)
    آزمایش.ادعای درستی(ایف.ذخیره ایف با بیت(قطعه۱۶، مسیر ایف، 16))
    آزمایش.ادعای درستی(ای‌یو.ذخیره ای‌یو(قطعه۱۶، مسیر ای‌یو))
    ناپایا موفق ناموجود := نادرست
    مسیر ناموجود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_none.aiff")
    دیرکن حافظه.آزادسازی(مسیر ناموجود برگردان تهی*)
    ایف.بازکردن ایف(مسیر ناموجود، موفق ناموجود)
    آزمایش.ادعای نادرستی(موفق ناموجود)

    فشرده سازی.آزادسازی بافر(کدگذاری شده)
    فشرده سازی.آزادسازی بافر(کدگذاری اعشار)
    فشرده سازی.آزادسازی بافر(کدگذاری میولا)
    فشرده سازی.آزادسازی بافر(کدگذاری ای‌لا)
    صدا.آزادسازی(قطعه۸)
    صدا.آزادسازی(قطعه۱۶)
    صدا.آزادسازی(قطعه۲۴)
    صدا.آزادسازی(بازخوانی اعشار)
    صدا.آزادسازی(بازخوانی میولا)
    صدا.آزادسازی(بازخوانی ای‌لا)
    صدا.آزادسازی(بازخوانی عمومی)
    صدا.آزادسازی(دیسک ایف)
    صدا.آزادسازی(دیسک ای‌یو)
    برگشت آزمایش.خلاصه()
پایان
