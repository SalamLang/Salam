بسته ریشه

واردسازی بایگانی
واردسازی صدا
واردسازی صدا.کدک
واردسازی صدا.ام‌پی‌تری
واردسازی صدا.برچسب صدا
واردسازی فشرده سازی
واردسازی ریاضی
واردسازی آزمایش

تابع ریشه:
    سرچاپ "a constant bitrate mpeg-1 file"
    ناپایا ok := نادرست
    cbr := بایگانی.خواندن پرونده دودویی("tests/fixtures/audio/cbr.mp3"، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(cbr)، 1462)
    آزمایش.ادعای درستی(ام‌پی‌تری.ام‌پی‌تری است(cbr.داده، cbr.طول))
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(cbr.داده، cbr.طول)، صدا.قالب ام‌پی‌تری)
    آزمایش.ادعای نادرستی(برچسب صدا.آی‌دی۳ دو دارد(cbr.داده، cbr.طول))
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.آغاز صدا(cbr.داده، cbr.طول)، 0)

    ناپایا h := ام‌پی‌تری.سرآیند {}
    آزمایش.ادعای درستی(ام‌پی‌تری.خواندن سرآیند(cbr.داده، cbr.طول، 0، h))
    آزمایش.ادعای برابری عدد(h.نگارش، ام‌پی‌تری.نگارش یک)
    آزمایش.ادعای برابری عدد(h.لایه، ام‌پی‌تری.لایه سه)
    آزمایش.ادعای برابری عدد(h.نرخ، 44100)
    آزمایش.ادعای برابری عدد(h.نرخ بیت، 64)
    آزمایش.ادعای برابری عدد(h.کانال ها، 1)
    آزمایش.ادعای برابری عدد(h.حالت، ام‌پی‌تری.حالت یک‌کاناله)
    آزمایش.ادعای برابری عدد(h.نمونه‌ها، 1152)
    آزمایش.ادعای برابری عدد(h.اندازه فریم، 144 * 64 * 1000 / 44100 + h.لایی)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.شمار فریم‌ها(cbr.داده، cbr.طول)، 7)

    ناپایا pok := نادرست
    cinfo := ام‌پی‌تری.بررسی ام‌پی‌تری(cbr.داده، cbr.طول، pok)
    آزمایش.ادعای درستی(pok)
    آزمایش.ادعای برابری عدد(cinfo.قالب، صدا.قالب ام‌پی‌تری)
    آزمایش.ادعای برابری عدد(cinfo.نرخ، 44100)
    آزمایش.ادعای برابری عدد(cinfo.کانال ها، 1)
    آزمایش.ادعای برابری عدد(cinfo.بیت ها، 16)
    آزمایش.ادعای نادرستی(cinfo.بی اتلاف)
    آزمایش.ادعای برابری عدد(cinfo.فریم ها، 7 * 1152)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(cinfo.مدت - 0.1828) کوچکتر 0.001، "about a fifth of a second")
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق صحیح(cinfo.نرخ بیت - 64000) کوچکتر 2000، "near 64 kbit")

    سرچاپ "frame walking and seeking"
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.فریم در(cbr.داده، cbr.طول، 0)، 0)
    آزمایش.ادعا با پیام(ام‌پی‌تری.فریم در(cbr.داده، cbr.طول، 3) بزرگتر 0، "the fourth frame should be found")
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.فریم در(cbr.داده، cbr.طول، 99)، -1)
    آزمایش.ادعا با پیام(ام‌پی‌تری.جستن به ثانیه(cbr.داده، cbr.طول، 0.1) بزرگتر 0، "seeking inside the file works")
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.جستن به ثانیه(cbr.داده، cbr.طول، 99.0)، -1)
    ناپایا heads := ام‌پی‌تری.سرآیندها(cbr.داده، cbr.طول)
    آزمایش.ادعای برابری عدد(heads.طول()، 7)
    آزمایش.ادعای برابری عدد(heads.بگیر(0).نرخ، 44100)
    آزمایش.ادعای برابری عدد(heads.بگیر(6).نرخ، 44100)
    ناپایا total := 0
    ناپایا i := 0
    تا i کوچکتر heads.طول():
        total += heads.بگیر(i).اندازه فریم
        i += 1
    پایان
    آزمایش.ادعای برابری عدد(total، 1462)
    heads.آزادکن()

    سرچاپ "a variable bitrate mpeg-2 file with a tag"
    ناپایا vok := نادرست
    vbr := بایگانی.خواندن پرونده دودویی("tests/fixtures/audio/vbr.mp3"، vok)
    آزمایش.ادعای درستی(vok)
    آزمایش.ادعای درستی(برچسب صدا.آی‌دی۳ دو دارد(vbr.داده، vbr.طول))
    آزمایش.ادعای برابری عدد(برچسب صدا.اندازه آی‌دی۳ دو(vbr.داده، vbr.طول)، 44)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.آغاز صدا(vbr.داده، vbr.طول)، 44)
    ناپایا vh := ام‌پی‌تری.سرآیند {}
    آزمایش.ادعای درستی(ام‌پی‌تری.خواندن سرآیند(vbr.داده، vbr.طول، 44، vh))
    آزمایش.ادعای برابری عدد(vh.نگارش، ام‌پی‌تری.نگارش دو)
    آزمایش.ادعای برابری عدد(vh.لایه، ام‌پی‌تری.لایه سه)
    آزمایش.ادعای برابری عدد(vh.نرخ، 22050)
    آزمایش.ادعای برابری عدد(vh.کانال ها، 2)
    آزمایش.ادعای برابری عدد(vh.نمونه‌ها، 576)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.شمار فریم‌ها(vbr.داده، vbr.طول)، 11)

    ناپایا vinfo := ام‌پی‌تری.آگاهی نرخ متغیر {}
    آزمایش.ادعای درستی(ام‌پی‌تری.خواندن آگاهی نرخ متغیر(vbr.داده، vbr.طول، vinfo))
    آزمایش.ادعای درستی(vinfo.یافت شد)
    آزمایش.ادعای برابری عدد(vinfo.فریم ها، 10)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.شمار فریم‌ها(vbr.داده، vbr.طول)، vinfo.فریم ها + 1)
    آزمایش.ادعا با پیام(vinfo.بایت‌ها بزرگتر 0، "the xing header should carry a byte count")

    ناپایا vpok := نادرست
    vprobe := ام‌پی‌تری.بررسی ام‌پی‌تری(vbr.داده، vbr.طول، vpok)
    آزمایش.ادعای درستی(vpok)
    آزمایش.ادعای برابری عدد(vprobe.نرخ، 22050)
    آزمایش.ادعای برابری عدد(vprobe.کانال ها، 2)
    آزمایش.ادعای درستی(vprobe.نرخ متغیر)
    آزمایش.ادعا با پیام(vprobe.فریم ها بزرگتر 0، "a vbr file still reports a length")

    سرچاپ "the bitrates really do vary"
    ناپایا vheads := ام‌پی‌تری.سرآیندها(vbr.داده، vbr.طول)
    آزمایش.ادعای برابری عدد(vheads.طول()، 11)
    ناپایا lo := 1000
    ناپایا hi := 0
    ناپایا k := 0
    تا k کوچکتر vheads.طول():
        b := vheads.بگیر(k).نرخ بیت
        اگر b کوچکتر lo:
            lo = b
        پایان
        اگر b بزرگتر hi:
            hi = b
        پایان
        k += 1
    پایان
    آزمایش.ادعا با پیام(hi بزرگتر lo، "a vbr file should use more than one bitrate")
    vheads.آزادکن()

    سرچاپ "samples per frame by version and layer"
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش یک، ام‌پی‌تری.لایه سه)، 1152)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش دو، ام‌پی‌تری.لایه سه)، 576)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش دوونیم، ام‌پی‌تری.لایه سه)، 576)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش یک، ام‌پی‌تری.لایه یک)، 384)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش یک، ام‌پی‌تری.لایه دو)، 1152)

    سرچاپ "sync search and refusals"
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.یافتن همگامی(cbr.داده، cbr.طول، 0)، 0)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.یافتن همگامی(vbr.داده، vbr.طول، 0)، 44)
    ناپایا junk := فشرده سازی.بافر بایت جدید()
    ناپایا j := 0
    تا j کوچکتر 64:
        فشرده سازی.افزودن بایت(junk، j)
        j += 1
    پایان
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.یافتن همگامی(junk.داده، junk.طول، 0)، -1)
    آزمایش.ادعای نادرستی(ام‌پی‌تری.ام‌پی‌تری است(junk.داده، junk.طول))
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.شمار فریم‌ها(junk.داده، junk.طول)، 0)
    ناپایا bad := ام‌پی‌تری.سرآیند {}
    آزمایش.ادعای نادرستی(ام‌پی‌تری.خواندن سرآیند(junk.داده، junk.طول، 0، bad))
    آزمایش.ادعای نادرستی(ام‌پی‌تری.خواندن سرآیند(cbr.داده، cbr.طول، 1460، bad))
    ناپایا nok := نادرست
    ام‌پی‌تری.بررسی ام‌پی‌تری(junk.داده، junk.طول، nok)
    آزمایش.ادعای نادرستی(nok)
    ناپایا vn := ام‌پی‌تری.آگاهی نرخ متغیر {}
    آزمایش.ادعای نادرستی(ام‌پی‌تری.خواندن آگاهی نرخ متغیر(cbr.داده، cbr.طول، vn))

    سرچاپ "mp3 audio decoding is not carried yet"
    آزمایش.ادعای نادرستی(کدک.کدگشایی شدنی(صدا.قالب ام‌پی‌تری))
    آزمایش.ادعای نادرستی(کدک.کدگذاری شدنی(صدا.قالب ام‌پی‌تری))
    ناپایا dok := نادرست
    کدک.کدگشایی(cbr.داده، cbr.طول، dok)
    آزمایش.ادعای نادرستی(dok)

    سرچاپ "probing from a path"
    ناپایا fok := نادرست
    finfo := ام‌پی‌تری.بررسی پرونده ام‌پی‌تری("tests/fixtures/audio/cbr.mp3"، fok)
    آزمایش.ادعای درستی(fok)
    آزمایش.ادعای برابری عدد(finfo.نرخ، 44100)
    ناپایا gone := نادرست
    ام‌پی‌تری.بررسی پرونده ام‌پی‌تری("tests/fixtures/audio/nope.mp3"، gone)
    آزمایش.ادعای نادرستی(gone)

    فشرده سازی.آزادسازی بافر(cbr)
    فشرده سازی.آزادسازی بافر(vbr)
    فشرده سازی.آزادسازی بافر(junk)
    برگشت آزمایش.خلاصه()
پایان
