بسته ریشه

واردسازی بایگانی
واردسازی صدا
واردسازی صدا.کدک
واردسازی صدا.ام‌پی‌تری
واردسازی صدا.برچسب صدا
واردسازی فشرده سازی
واردسازی ریاضی
واردسازی آزمایش

تابع ریشه:
    سرچاپ "a constant bitrate mpeg-1 file"
    ناپایا موفق := نادرست
    ناپایا فایل ثابت := بایگانی.خواندن پرونده دودویی("tests/fixtures/audio/cbr.mp3"، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(فایل ثابت)، 1462)
    آزمایش.ادعای درستی(ام‌پی‌تری.ام‌پی‌تری است(فایل ثابت.داده، فایل ثابت.طول))
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(فایل ثابت.داده، فایل ثابت.طول)، صدا.قالب ام‌پی‌تری)
    آزمایش.ادعای نادرستی(برچسب صدا.آی‌دی۳ دو دارد(فایل ثابت.داده، فایل ثابت.طول))
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.آغاز صدا(فایل ثابت.داده، فایل ثابت.طول)، 0)

    ناپایا h := ام‌پی‌تری.سرآیند {}
    آزمایش.ادعای درستی(ام‌پی‌تری.خواندن سرآیند(فایل ثابت.داده، فایل ثابت.طول، 0، h))
    آزمایش.ادعای برابری عدد(h.نگارش، ام‌پی‌تری.نگارش یک)
    آزمایش.ادعای برابری عدد(h.لایه، ام‌پی‌تری.لایه سه)
    آزمایش.ادعای برابری عدد(h.نرخ، 44100)
    آزمایش.ادعای برابری عدد(h.نرخ بیت، 64)
    آزمایش.ادعای برابری عدد(h.کانال ها، 1)
    آزمایش.ادعای برابری عدد(h.حالت، ام‌پی‌تری.حالت یک‌کاناله)
    آزمایش.ادعای برابری عدد(h.نمونه‌ها، 1152)
    آزمایش.ادعای برابری عدد(h.اندازه فریم، 144 * 64 * 1000 / 44100 + h.لایی)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.شمار فریم‌ها(فایل ثابت.داده، فایل ثابت.طول)، 7)

    ناپایا بررسی موفق := نادرست
    اطلاعات ثابت := ام‌پی‌تری.بررسی ام‌پی‌تری(فایل ثابت.داده، فایل ثابت.طول، بررسی موفق)
    آزمایش.ادعای درستی(بررسی موفق)
    آزمایش.ادعای برابری عدد(اطلاعات ثابت.قالب، صدا.قالب ام‌پی‌تری)
    آزمایش.ادعای برابری عدد(اطلاعات ثابت.نرخ، 44100)
    آزمایش.ادعای برابری عدد(اطلاعات ثابت.کانال ها، 1)
    آزمایش.ادعای برابری عدد(اطلاعات ثابت.بیت ها، 16)
    آزمایش.ادعای نادرستی(اطلاعات ثابت.بی اتلاف)
    آزمایش.ادعای برابری عدد(اطلاعات ثابت.فریم ها، 7 * 1152)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(اطلاعات ثابت.مدت - 0.1828) کوچکتر 0.001، "about a fifth of a second")
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق صحیح(اطلاعات ثابت.نرخ بیت - 64000) کوچکتر 2000، "near 64 kbit")

    سرچاپ "frame walking and seeking"
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.فریم در(فایل ثابت.داده، فایل ثابت.طول، 0)، 0)
    آزمایش.ادعا با پیام(ام‌پی‌تری.فریم در(فایل ثابت.داده، فایل ثابت.طول، 3) بزرگتر 0، "the fourth frame should be found")
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.فریم در(فایل ثابت.داده، فایل ثابت.طول، 99)، -1)
    آزمایش.ادعا با پیام(ام‌پی‌تری.جستن به ثانیه(فایل ثابت.داده، فایل ثابت.طول، 0.1) بزرگتر 0، "seeking inside the file works")
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.جستن به ثانیه(فایل ثابت.داده، فایل ثابت.طول، 99.0)، -1)
    ناپایا سرآیندها := ام‌پی‌تری.سرآیندها(فایل ثابت.داده، فایل ثابت.طول)
    آزمایش.ادعای برابری عدد(سرآیندها.طول()، 7)
    آزمایش.ادعای برابری عدد(سرآیندها.بگیر(0).نرخ، 44100)
    آزمایش.ادعای برابری عدد(سرآیندها.بگیر(6).نرخ، 44100)
    ناپایا جمع := 0
    ناپایا i := 0
    تا i کوچکتر سرآیندها.طول():
        جمع += سرآیندها.بگیر(i).اندازه فریم
        i++
    پایان
    آزمایش.ادعای برابری عدد(جمع، 1462)
    سرآیندها.آزادکن()

    سرچاپ "a variable bitrate mpeg-2 file with a tag"
    ناپایا موفق متغیر := نادرست
    ناپایا فایل متغیر := بایگانی.خواندن پرونده دودویی("tests/fixtures/audio/vbr.mp3"، موفق متغیر)
    آزمایش.ادعای درستی(موفق متغیر)
    آزمایش.ادعای درستی(برچسب صدا.آی‌دی۳ دو دارد(فایل متغیر.داده، فایل متغیر.طول))
    آزمایش.ادعای برابری عدد(برچسب صدا.اندازه آی‌دی۳ دو(فایل متغیر.داده، فایل متغیر.طول)، 44)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.آغاز صدا(فایل متغیر.داده، فایل متغیر.طول)، 44)
    ناپایا سرآیند متغیر := ام‌پی‌تری.سرآیند {}
    آزمایش.ادعای درستی(ام‌پی‌تری.خواندن سرآیند(فایل متغیر.داده، فایل متغیر.طول، 44، سرآیند متغیر))
    آزمایش.ادعای برابری عدد(سرآیند متغیر.نگارش، ام‌پی‌تری.نگارش دو)
    آزمایش.ادعای برابری عدد(سرآیند متغیر.لایه، ام‌پی‌تری.لایه سه)
    آزمایش.ادعای برابری عدد(سرآیند متغیر.نرخ، 22050)
    آزمایش.ادعای برابری عدد(سرآیند متغیر.کانال ها، 2)
    آزمایش.ادعای برابری عدد(سرآیند متغیر.نمونه‌ها، 576)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.شمار فریم‌ها(فایل متغیر.داده، فایل متغیر.طول)، 11)

    ناپایا اطلاعات متغیر := ام‌پی‌تری.آگاهی نرخ متغیر {}
    آزمایش.ادعای درستی(ام‌پی‌تری.خواندن آگاهی نرخ متغیر(فایل متغیر.داده، فایل متغیر.طول، اطلاعات متغیر))
    آزمایش.ادعای درستی(اطلاعات متغیر.یافت شد)
    آزمایش.ادعای برابری عدد(اطلاعات متغیر.فریم ها، 10)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.شمار فریم‌ها(فایل متغیر.داده، فایل متغیر.طول)، اطلاعات متغیر.فریم ها + 1)
    آزمایش.ادعا با پیام(اطلاعات متغیر.بایت‌ها بزرگتر 0، "the xing header should carry a byte count")

    ناپایا بررسی موفق متغیر := نادرست
    بررسی متغیر := ام‌پی‌تری.بررسی ام‌پی‌تری(فایل متغیر.داده، فایل متغیر.طول، بررسی موفق متغیر)
    آزمایش.ادعای درستی(بررسی موفق متغیر)
    آزمایش.ادعای برابری عدد(بررسی متغیر.نرخ، 22050)
    آزمایش.ادعای برابری عدد(بررسی متغیر.کانال ها، 2)
    آزمایش.ادعای درستی(بررسی متغیر.نرخ متغیر)
    آزمایش.ادعا با پیام(بررسی متغیر.فریم ها بزرگتر 0، "a vbr file still reports a length")

    سرچاپ "the bitrates really do vary"
    ناپایا سرآیندهای متغیر := ام‌پی‌تری.سرآیندها(فایل متغیر.داده، فایل متغیر.طول)
    آزمایش.ادعای برابری عدد(سرآیندهای متغیر.طول()، 11)
    ناپایا کمینه := 1000
    ناپایا بیشینه := 0
    ناپایا k := 0
    تا k کوچکتر سرآیندهای متغیر.طول():
        b := سرآیندهای متغیر.بگیر(k).نرخ بیت
        اگر b کوچکتر کمینه:
            کمینه = b
        پایان
        اگر b بزرگتر بیشینه:
            بیشینه = b
        پایان
        k++
    پایان
    آزمایش.ادعا با پیام(بیشینه بزرگتر کمینه، "a vbr file should use more than one bitrate")
    سرآیندهای متغیر.آزادکن()

    سرچاپ "samples per frame by version and layer"
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش یک، ام‌پی‌تری.لایه سه)، 1152)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش دو، ام‌پی‌تری.لایه سه)، 576)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش دوونیم، ام‌پی‌تری.لایه سه)، 576)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش یک، ام‌پی‌تری.لایه یک)، 384)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش یک، ام‌پی‌تری.لایه دو)، 1152)

    سرچاپ "sync search and refusals"
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.یافتن همگامی(فایل ثابت.داده، فایل ثابت.طول، 0)، 0)
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.یافتن همگامی(فایل متغیر.داده، فایل متغیر.طول، 0)، 44)
    ناپایا زباله := فشرده سازی.بافر بایت جدید()
    ناپایا j := 0
    تا j کوچکتر 64:
        فشرده سازی.افزودن بایت(زباله، j)
        j++
    پایان
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.یافتن همگامی(زباله.داده، زباله.طول، 0)، -1)
    آزمایش.ادعای نادرستی(ام‌پی‌تری.ام‌پی‌تری است(زباله.داده، زباله.طول))
    آزمایش.ادعای برابری عدد(ام‌پی‌تری.شمار فریم‌ها(زباله.داده، زباله.طول)، 0)
    ناپایا نامعتبر := ام‌پی‌تری.سرآیند {}
    آزمایش.ادعای نادرستی(ام‌پی‌تری.خواندن سرآیند(زباله.داده، زباله.طول، 0، نامعتبر))
    آزمایش.ادعای نادرستی(ام‌پی‌تری.خواندن سرآیند(فایل ثابت.داده، فایل ثابت.طول، 1460، نامعتبر))
    ناپایا موفق زباله := نادرست
    ام‌پی‌تری.بررسی ام‌پی‌تری(زباله.داده، زباله.طول، موفق زباله)
    آزمایش.ادعای نادرستی(موفق زباله)
    ناپایا آگاهی ناموجود := ام‌پی‌تری.آگاهی نرخ متغیر {}
    آزمایش.ادعای نادرستی(ام‌پی‌تری.خواندن آگاهی نرخ متغیر(فایل ثابت.داده، فایل ثابت.طول، آگاهی ناموجود))

    سرچاپ "mp3 audio decoding is not carried yet"
    آزمایش.ادعای نادرستی(کدک.کدگشایی شدنی(صدا.قالب ام‌پی‌تری))
    آزمایش.ادعای نادرستی(کدک.کدگذاری شدنی(صدا.قالب ام‌پی‌تری))
    ناپایا موفق کدگشایی := نادرست
    کدک.کدگشایی(فایل ثابت.داده، فایل ثابت.طول، موفق کدگشایی)
    آزمایش.ادعای نادرستی(موفق کدگشایی)

    سرچاپ "probing from a path"
    ناپایا موفق مسیر := نادرست
    اطلاعات مسیر := ام‌پی‌تری.بررسی پرونده ام‌پی‌تری("tests/fixtures/audio/cbr.mp3"، موفق مسیر)
    آزمایش.ادعای درستی(موفق مسیر)
    آزمایش.ادعای برابری عدد(اطلاعات مسیر.نرخ، 44100)
    ناپایا حذف شده := نادرست
    ام‌پی‌تری.بررسی پرونده ام‌پی‌تری("tests/fixtures/audio/nope.mp3"، حذف شده)
    آزمایش.ادعای نادرستی(حذف شده)

    فشرده سازی.آزادسازی بافر(فایل ثابت)
    فشرده سازی.آزادسازی بافر(فایل متغیر)
    فشرده سازی.آزادسازی بافر(زباله)
    برگشت آزمایش.خلاصه()
پایان
