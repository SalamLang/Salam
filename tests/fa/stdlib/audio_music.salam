بسته ریشه

واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی صدا.میدی
واردسازی صدا.موسیقی
واردسازی صدا.صداساز
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی ریاضی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی آزمایش

تابع بسامد اوج(c: صدا.قطعه، n: صحیح): اعشار۶۴:
    ناپایا حقیقی := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا موهومی := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا i := 0
    تا i کوچکتر n:
        w := پردازش سیگنال.مقدار پنجره(پردازش سیگنال.پنجره هان، i، n، 0.0)
        حقیقی.بیفزا(صدا.نمونه(c، i، 0) * w)
        موهومی.بیفزا(0.0)
        i += 1
    پایان
    پردازش سیگنال.تبدیل فوریه برداری(حقیقی، موهومی)
    اندازه‌ها := پردازش سیگنال.اندازه(حقیقی.ارجاع(0)، موهومی.ارجاع(0)، n / 2)
    خانه := پردازش سیگنال.خانه اوج(اندازه‌ها)
    خروجی := پردازش سیگنال.بسامد خانه(خانه، n، c.نرخ)
    حقیقی.آزادکن()
    موهومی.آزادکن()
    اندازه‌ها.آزادکن()
    برگشت خروجی
پایان

تابع ریشه:
    سرچاپ "notes and frequencies"
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد(69)، 440.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد(81)، 880.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد(57)، 220.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد(60)، 261.6255653005986، 0.0001)
    آزمایش.ادعای برابری عدد(موسیقی.بسامد به نت(440.0)، 69)
    آزمایش.ادعای برابری عدد(موسیقی.بسامد به نت(261.63)، 60)
    آزمایش.ادعای برابری عدد(موسیقی.بسامد به نت(0.0)، 0)
    آزمایش.ادعای برابری عدد(موسیقی.اکتاو(60)، 4)
    آزمایش.ادعای برابری عدد(موسیقی.رده صدا(61)، 1)
    آزمایش.ادعای برابری عدد(موسیقی.رده صدا(-1)، 11)
    آزمایش.ادعای برابری عدد(موسیقی.ترانهاد(60، 7)، 67)
    آزمایش.ادعای برابری عدد(موسیقی.فاصله(60، 67)، 7)
    آزمایش.ادعای برابری اعشار(موسیقی.سنت(440.0، 880.0)، 1200.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.بسامد به سنت(440.0، 69)، 0.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد با سنت(69، 1200.0)، 880.0، 0.000001)

    سرچاپ "note names round-trip"
    هر شماره در [60، 61، 69، 0، 127]:
        نام := موسیقی.نام نت(شماره)
        آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت(نام)، شماره)
        حافظه.آزادسازی(نام برگردان تهی*)
    پایان
    نت۶۰ := موسیقی.نام نت(60)
    آزمایش.ادعای برابری رشته(نت۶۰، "C4")
    حافظه.آزادسازی(نت۶۰ برگردان تهی*)
    نت۶۱ := موسیقی.نام نت(61)
    آزمایش.ادعای برابری رشته(نت۶۱، "C#4")
    حافظه.آزادسازی(نت۶۱ برگردان تهی*)
    نت۶۹ := موسیقی.نام نت(69)
    آزمایش.ادعای برابری رشته(نت۶۹، "A4")
    حافظه.آزادسازی(نت۶۹ برگردان تهی*)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("c4")، 60)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("Db4")، 61)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("x9")، -1)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("")، -1)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("C")، -1)

    سرچاپ "scales and chords"
    ناپایا بزرگ := موسیقی.گام(موسیقی.گام بزرگ)
    آزمایش.ادعای برابری عدد(بزرگ.طول()، 7)
    آزمایش.ادعای برابری عدد(بزرگ.بگیر(0)، 0)
    آزمایش.ادعای برابری عدد(بزرگ.بگیر(6)، 11)
    بزرگ.آزادکن()
    ناپایا کروماتیک := موسیقی.گام(موسیقی.گام کروماتیک)
    آزمایش.ادعای برابری عدد(کروماتیک.طول()، 12)
    کروماتیک.آزادکن()
    ناپایا پنج‌نتی := موسیقی.گام(موسیقی.گام پنج‌نت)
    آزمایش.ادعای برابری عدد(پنج‌نتی.طول()، 5)
    پنج‌نتی.آزادکن()
    ناپایا بلوز := موسیقی.گام(موسیقی.گام بلوز)
    آزمایش.ادعای برابری عدد(بلوز.طول()، 6)
    بلوز.آزادکن()
    ناپایا نت‌ها := موسیقی.نت‌های گام(60، موسیقی.گام بزرگ، 8)
    آزمایش.ادعای برابری عدد(نت‌ها.طول()، 8)
    آزمایش.ادعای برابری عدد(نت‌ها.بگیر(0)، 60)
    آزمایش.ادعای برابری عدد(نت‌ها.بگیر(7)، 72)
    نت‌ها.آزادکن()
    ناپایا سه‌گانه := موسیقی.نت‌های آکورد(60، موسیقی.آکورد بزرگ)
    آزمایش.ادعای برابری عدد(سه‌گانه.طول()، 3)
    آزمایش.ادعای برابری عدد(سه‌گانه.بگیر(1)، 64)
    آزمایش.ادعای برابری عدد(سه‌گانه.بگیر(2)، 67)
    سه‌گانه.آزادکن()
    ناپایا کوچک۷ := موسیقی.نت‌های آکورد(60، موسیقی.آکورد کوچک۷)
    آزمایش.ادعای برابری عدد(کوچک۷.طول()، 4)
    آزمایش.ادعای برابری عدد(کوچک۷.بگیر(3)، 70)
    کوچک۷.آزادکن()
    ناپایا کاسته := موسیقی.آکورد(موسیقی.آکورد کاسته)
    آزمایش.ادعای برابری عدد(کاسته.بگیر(2)، 6)
    کاسته.آزادکن()

    سرچاپ "persian dastgah carries quarter tones"
    ناپایا شور := موسیقی.دستگاه(موسیقی.دستگاه شور)
    آزمایش.ادعای برابری عدد(شور.طول()، 7)
    آزمایش.ادعای برابری اعشار(شور.بگیر(2)، 350.0، 0.0)
    شور.آزادکن()
    ناپایا ماهور := موسیقی.دستگاه(موسیقی.دستگاه ماهور)
    آزمایش.ادعای برابری اعشار(ماهور.بگیر(2)، 400.0، 0.0)
    ماهور.آزادکن()
    ناپایا بسامدها := موسیقی.بسامدهای دستگاه(60، موسیقی.دستگاه شور)
    آزمایش.ادعای برابری عدد(بسامدها.طول()، 7)
    آزمایش.ادعای برابری اعشار(بسامدها.بگیر(0)، موسیقی.نت به بسامد(60)، 0.000001)
    آزمایش.ادعا با پیام(بسامدها.بگیر(2) بزرگتر موسیقی.نت به بسامد(63)، "the third of shur sits above a minor third")
    آزمایش.ادعا با پیام(بسامدها.بگیر(2) کوچکتر موسیقی.نت به بسامد(64)، "and below a major third")
    بسامدها.آزادکن()
    آزمایش.ادعای برابری اعشار(موسیقی.سنت کرن، -50.0، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.سنت سری، 50.0، 0.0)

    سرچاپ "just and pythagorean tunings"
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت طبیعی(0)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت طبیعی(7)، 1.5، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت طبیعی(4)، 1.25، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت فیثاغورسی(0)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت فیثاغورسی(7)، 1.5، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت فیثاغورسی(2)، 1.125، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت فیثاغورسی(5)، 4.0 / 3.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.بسامد طبیعی(69، 7)، 660.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.ثانیه ضربه(120.0)، 0.5، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.ثانیه ضربه(0.0)، 0.0، 0.0)

    سرچاپ "oscillators make the pitch they are asked for"
    ناپایا سینوسی := صداساز.نوا(440.0، 0.2، 44100، صداساز.موج سینوسی)
    آزمایش.ادعای برابری عدد(سینوسی.نرخ، 44100)
    آزمایش.ادعای برابری عدد(سینوسی.فریم ها، 8820)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(بسامد اوج(سینوسی، 8192) - 440.0) کوچکتر 12.0، "a sine should peak at its pitch")
    آزمایش.ادعا با پیام(صدا.اوج(سینوسی) بزرگتر 0.9، "a sine should reach full scale")
    ناپایا اره‌ای := صداساز.نوا(220.0، 0.2، 44100، صداساز.موج اره‌ای)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(بسامد اوج(اره‌ای، 8192) - 220.0) کوچکتر 12.0، "a saw should peak at its pitch")
    ناپایا مربعی := صداساز.نوا(330.0، 0.2، 44100، صداساز.موج مربعی)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(بسامد اوج(مربعی، 8192) - 330.0) کوچکتر 12.0، "a square should peak at its pitch")
    ناپایا مثلثی := صداساز.نوا(550.0، 0.2، 44100، صداساز.موج مثلثی)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(بسامد اوج(مثلثی، 8192) - 550.0) کوچکتر 12.0، "a triangle should peak at its pitch")
    آزمایش.ادعای برابری اعشار(صداساز.مقدار موج(صداساز.موج سینوسی، 0.0، 0.5)، 0.0، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.مقدار موج(صداساز.موج اره‌ای، 0.5، 0.5)، 0.0، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.مقدار موج(صداساز.موج مربعی، 0.25، 0.5)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(صداساز.مقدار موج(صداساز.موج مربعی، 0.75، 0.5)، -1.0، 0.0)

    سرچاپ "envelopes rise, hold and fall"
    e := صداساز.پوشش { حمله = 0.1، افت = 0.1، پایداری = 0.5، رهایش = 0.2 }
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.0، 1.0)، 0.0، 0.0)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.05، 1.0)، 0.5، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.1، 1.0)، 1.0، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.2، 1.0)، 0.5، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.5، 1.0)، 0.5، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 1.2، 1.0)، 0.0، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 5.0، 1.0)، 0.0، 0.0)
    آزمایش.ادعای برابری اعشار(صداساز.درازی کل پوشش(e، 1.0)، 1.2، 0.000001)
    ناپایا شکل‌داده := صداساز.نوا با پوشش(440.0، 0.2، 22050، صداساز.موج سینوسی، e، 0.8)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(شکل‌داده، 0، 0)، 0.0، 0.0)
    آزمایش.ادعا با پیام(صدا.اوج(شکل‌داده) کوچکتربرابر 0.81، "the envelope should hold the gain down")

    سرچاپ "chords, noise and other voices"
    ناپایا بسامدهای آکورد := موسیقی.بسامدهای دستگاه(57، موسیقی.دستگاه شور)
    ناپایا آکورد := صداساز.آکورد(بسامدهای آکورد، 0.2، 22050، صداساز.موج سینوسی)
    آزمایش.ادعا با پیام(صدا.اوج(آکورد) بزرگتر 0.1، "a chord should make sound")
    آزمایش.ادعا با پیام(وارونه صدا.بریده است(آکورد)، "a chord should not clip")
    بسامدهای آکورد.آزادکن()
    ناپایا سپید := صداساز.نوفه سپید(0.1، 22050)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع(سپید) بزرگتر 0.3، "white noise should be loud")
    ناپایا صورتی := صداساز.نوفه صورتی(0.1، 22050)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع(صورتی) بزرگتر 0.01، "pink noise should make sound")
    ناپایا قهوه‌ای := صداساز.نوفه قهوه‌ای(0.1، 22050)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع(قهوه‌ای) بزرگتر 0.001، "brown noise should make sound")
    ناپایا اف‌ام := صداساز.نوا اف‌ام(220.0، 2.0، 3.0، 0.2، 22050)
    آزمایش.ادعا با پیام(صدا.اوج(اف‌ام) بزرگتر 0.5، "fm should make sound")
    ناپایا افزایشی := صداساز.افزایشی(220.0، 6، 0.6، 0.2، 44100)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(بسامد اوج(افزایشی، 8192) - 220.0) کوچکتر 12.0، "additive should keep its fundamental")
    ناپایا کارپلوس := صداساز.کارپلوس استرانگ(220.0، 0.3، 22050، 0.99)
    آزمایش.ادعا با پیام(صدا.اوج(کارپلوس) بزرگتر 0.1، "karplus strong should make sound")

    سرچاپ "a rendered phrase"
    ناپایا عبارت := وکتور {} برگردان وکتور<صداساز.نت>
    ناپایا گام := موسیقی.نت‌های گام(60، موسیقی.گام بزرگ، 8)
    ناپایا k := 0
    تا k کوچکتر گام.طول():
        عبارت.بیفزا(صداساز.نت در(گام.بگیر(k)، (k برگردان اعشار۶۴) * 0.1، 0.09، 0.4، صداساز.موج سینوسی))
        k += 1
    پایان
    گام.آزادکن()
    ناپایا آهنگ := صداساز.ساختن نت‌ها(عبارت، 22050، 2، e)
    آزمایش.ادعای برابری عدد(آهنگ.کانال ها، 2)
    آزمایش.ادعا با پیام(آهنگ.فریم ها بزرگتر 0، "the phrase should have length")
    آزمایش.ادعا با پیام(صدا.اوج(آهنگ) بزرگتر 0.1، "the phrase should make sound")
    آزمایش.ادعا با پیام(وارونه صدا.بریده است(آهنگ)، "the phrase should not clip")
    عبارت.آزادکن()
    ناپایا هیچ := صداساز.ساختن نت‌ها(وکتور {} برگردان وکتور<صداساز.نت>، 22050، 1، e)
    آزمایش.ادعای درستی(صدا.خالی است(هیچ))

    سرچاپ "midi round-trip"
    ناپایا f := میدی.آهنگ جدید(480)
    آزمایش.ادعای برابری عدد(f.تقسیم، 480)
    آزمایش.ادعای برابری اعشار(میدی.ضربان(f)، 120.0، 0.000001)
    ناپایا t := میدی.ترک جدید()
    میدی.افزودن ضرباهنگ(t، 0، 120.0)
    میدی.افزودن برنامه(t، 0، 0، 0)
    میدی.افزودن واپایش(t، 0، 7، 100، 0)
    ناپایا s := 0
    تا s کوچکتر 4:
        میدی.افزودن نت(t، s * 480، 240، 60 + s * 2، 100، 0)
        s += 1
    پایان
    میدی.افزودن ترک(f، t)
    آزمایش.ادعای برابری عدد(f.ترک‌ها.طول()، 1)
    آزمایش.ادعای برابری عدد(میدی.تیک کل(f)، 3 * 480 + 240)
    آزمایش.ادعای برابری اعشار(میدی.تیک به ثانیه(f، 480)، 0.5، 0.000001)
    آزمایش.ادعای برابری عدد(میدی.ثانیه به تیک(f، 0.5)، 480)

    ناپایا کدگذاری شده := میدی.کدگذاری میدی(f)
    آزمایش.ادعا با پیام(فشرده سازی.طول بافر(کدگذاری شده) بزرگتر 22، "the midi file should have a body")
    آزمایش.ادعای درستی(میدی.میدی است(کدگذاری شده.داده، کدگذاری شده.طول))
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(کدگذاری شده.داده، کدگذاری شده.طول)، صدا.قالب میدی)
    ناپایا موفق := نادرست
    ناپایا بازخوانی := میدی.کدگشایی میدی(کدگذاری شده.داده، کدگذاری شده.طول، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای برابری عدد(بازخوانی.تقسیم، 480)
    آزمایش.ادعای برابری عدد(بازخوانی.ترک‌ها.طول()، 1)
    آزمایش.ادعای برابری اعشار(میدی.ضربان(بازخوانی)، 120.0، 0.01)
    آزمایش.ادعای برابری عدد(میدی.تیک کل(بازخوانی)، 3 * 480 + 240)

    سرچاپ "notes come back and render"
    ناپایا یافته := میدی.نت‌ها(بازخوانی)
    آزمایش.ادعای برابری عدد(یافته.طول()، 4)
    آزمایش.ادعای برابری عدد(یافته.بگیر(0).شماره نت، 60)
    آزمایش.ادعای برابری عدد(یافته.بگیر(3).شماره نت، 66)
    آزمایش.ادعای برابری اعشار(یافته.بگیر(1).آغاز، 0.5، 0.000001)
    آزمایش.ادعای برابری اعشار(یافته.بگیر(0).درازی، 0.25، 0.000001)
    یافته.آزادکن()
    ناپایا ساخته شده := میدی.ساختن(بازخوانی، 22050، 1)
    آزمایش.ادعا با پیام(ساخته شده.فریم ها بزرگتر 0، "the midi should render")
    آزمایش.ادعا با پیام(صدا.اوج(ساخته شده) بزرگتر 0.05، "the midi should make sound")
    آزمایش.ادعای برابری رشته(میدی.نام برنامه(0)، "Acoustic Grand Piano")
    آزمایش.ادعای برابری رشته(میدی.نام برنامه(200)، "")

    سرچاپ "midi on disk and refusals"
    مسیر := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_song.mid")
    دیرکن حافظه.آزادسازی(مسیر برگردان تهی*)
    آزمایش.ادعای درستی(میدی.ذخیره میدی(f، مسیر))
    ناپایا موفق دیسک := نادرست
    ناپایا دیسک := میدی.بازکردن میدی(مسیر، موفق دیسک)
    آزمایش.ادعای درستی(موفق دیسک)
    آزمایش.ادعای برابری عدد(دیسک.ترک‌ها.طول()، 1)
    ناپایا حذف شده := نادرست
    ناموجود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_song_none.mid")
    دیرکن حافظه.آزادسازی(ناموجود برگردان تهی*)
    میدی.بازکردن میدی(ناموجود، حذف شده)
    آزمایش.ادعای نادرستی(حذف شده)
    ناپایا خالی := میدی.آهنگ جدید(480)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(میدی.کدگذاری میدی(خالی))، 0)
    آزمایش.ادعای نادرستی(میدی.میدی است(کدگذاری شده.داده، 8))
    ناپایا نامعتبر := نادرست
    میدی.کدگشایی میدی(کدگذاری شده.داده، 8، نامعتبر)
    آزمایش.ادعای نادرستی(نامعتبر)
    میدی.آزادسازی آهنگ(خالی)

    فشرده سازی.آزادسازی بافر(کدگذاری شده)
    صدا.آزادسازی(سینوسی)
    صدا.آزادسازی(اره‌ای)
    صدا.آزادسازی(مربعی)
    صدا.آزادسازی(مثلثی)
    صدا.آزادسازی(شکل‌داده)
    صدا.آزادسازی(آکورد)
    صدا.آزادسازی(سپید)
    صدا.آزادسازی(صورتی)
    صدا.آزادسازی(قهوه‌ای)
    صدا.آزادسازی(اف‌ام)
    صدا.آزادسازی(افزایشی)
    صدا.آزادسازی(کارپلوس)
    صدا.آزادسازی(آهنگ)
    صدا.آزادسازی(هیچ)
    صدا.آزادسازی(ساخته شده)
    میدی.آزادسازی آهنگ(f)
    میدی.آزادسازی آهنگ(بازخوانی)
    میدی.آزادسازی آهنگ(دیسک)
    برگشت آزمایش.خلاصه()
پایان
