بسته ریشه

واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی صدا.میدی
واردسازی صدا.موسیقی
واردسازی صدا.صداساز
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی ریاضی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی آزمایش

تابع peak_freq(c: صدا.قطعه، n: صحیح): اعشار۶۴:
    ناپایا re := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا im := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا i := 0
    تا i کوچکتر n:
        w := پردازش سیگنال.مقدار پنجره(پردازش سیگنال.پنجره هان، i، n، 0.0)
        re.بیفزا(صدا.نمونه(c، i، 0) * w)
        im.بیفزا(0.0)
        i += 1
    پایان
    پردازش سیگنال.تبدیل فوریه برداری(re، im)
    mags := پردازش سیگنال.اندازه(re.ارجاع(0)، im.ارجاع(0)، n / 2)
    bin := پردازش سیگنال.خانه اوج(mags)
    out := پردازش سیگنال.بسامد خانه(bin، n، c.نرخ)
    re.آزادکن()
    im.آزادکن()
    mags.آزادکن()
    برگشت out
پایان

تابع ریشه:
    سرچاپ "notes and frequencies"
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد(69)، 440.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد(81)، 880.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد(57)، 220.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد(60)، 261.6255653005986، 0.0001)
    آزمایش.ادعای برابری عدد(موسیقی.بسامد به نت(440.0)، 69)
    آزمایش.ادعای برابری عدد(موسیقی.بسامد به نت(261.63)، 60)
    آزمایش.ادعای برابری عدد(موسیقی.بسامد به نت(0.0)، 0)
    آزمایش.ادعای برابری عدد(موسیقی.اکتاو(60)، 4)
    آزمایش.ادعای برابری عدد(موسیقی.رده صدا(61)، 1)
    آزمایش.ادعای برابری عدد(موسیقی.رده صدا(-1)، 11)
    آزمایش.ادعای برابری عدد(موسیقی.ترانهاد(60، 7)، 67)
    آزمایش.ادعای برابری عدد(موسیقی.فاصله(60، 67)، 7)
    آزمایش.ادعای برابری اعشار(موسیقی.سنت(440.0، 880.0)، 1200.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.بسامد به سنت(440.0، 69)، 0.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.نت به بسامد با سنت(69، 1200.0)، 880.0، 0.000001)

    سرچاپ "note names round-trip"
    هر pair در [60، 61، 69، 0، 127]:
        name := موسیقی.نام نت(pair)
        آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت(name)، pair)
        حافظه.آزادسازی(name برگردان تهی*)
    پایان
    n60 := موسیقی.نام نت(60)
    آزمایش.ادعای برابری رشته(n60، "C4")
    حافظه.آزادسازی(n60 برگردان تهی*)
    n61 := موسیقی.نام نت(61)
    آزمایش.ادعای برابری رشته(n61، "C#4")
    حافظه.آزادسازی(n61 برگردان تهی*)
    n69 := موسیقی.نام نت(69)
    آزمایش.ادعای برابری رشته(n69، "A4")
    حافظه.آزادسازی(n69 برگردان تهی*)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("c4")، 60)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("Db4")، 61)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("x9")، -1)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("")، -1)
    آزمایش.ادعای برابری عدد(موسیقی.خواندن نام نت("C")، -1)

    سرچاپ "scales and chords"
    ناپایا maj := موسیقی.گام(موسیقی.گام بزرگ)
    آزمایش.ادعای برابری عدد(maj.طول()، 7)
    آزمایش.ادعای برابری عدد(maj.بگیر(0)، 0)
    آزمایش.ادعای برابری عدد(maj.بگیر(6)، 11)
    maj.آزادکن()
    ناپایا chrom := موسیقی.گام(موسیقی.گام کروماتیک)
    آزمایش.ادعای برابری عدد(chrom.طول()، 12)
    chrom.آزادکن()
    ناپایا pent := موسیقی.گام(موسیقی.گام پنج‌نت)
    آزمایش.ادعای برابری عدد(pent.طول()، 5)
    pent.آزادکن()
    ناپایا blues := موسیقی.گام(موسیقی.گام بلوز)
    آزمایش.ادعای برابری عدد(blues.طول()، 6)
    blues.آزادکن()
    ناپایا notes := موسیقی.نت‌های گام(60، موسیقی.گام بزرگ، 8)
    آزمایش.ادعای برابری عدد(notes.طول()، 8)
    آزمایش.ادعای برابری عدد(notes.بگیر(0)، 60)
    آزمایش.ادعای برابری عدد(notes.بگیر(7)، 72)
    notes.آزادکن()
    ناپایا tri := موسیقی.نت‌های آکورد(60، موسیقی.آکورد بزرگ)
    آزمایش.ادعای برابری عدد(tri.طول()، 3)
    آزمایش.ادعای برابری عدد(tri.بگیر(1)، 64)
    آزمایش.ادعای برابری عدد(tri.بگیر(2)، 67)
    tri.آزادکن()
    ناپایا m7 := موسیقی.نت‌های آکورد(60، موسیقی.آکورد کوچک۷)
    آزمایش.ادعای برابری عدد(m7.طول()، 4)
    آزمایش.ادعای برابری عدد(m7.بگیر(3)، 70)
    m7.آزادکن()
    ناپایا dim := موسیقی.آکورد(موسیقی.آکورد کاسته)
    آزمایش.ادعای برابری عدد(dim.بگیر(2)، 6)
    dim.آزادکن()

    سرچاپ "persian dastgah carries quarter tones"
    ناپایا shur := موسیقی.دستگاه(موسیقی.دستگاه شور)
    آزمایش.ادعای برابری عدد(shur.طول()، 7)
    آزمایش.ادعای برابری اعشار(shur.بگیر(2)، 350.0، 0.0)
    shur.آزادکن()
    ناپایا mahur := موسیقی.دستگاه(موسیقی.دستگاه ماهور)
    آزمایش.ادعای برابری اعشار(mahur.بگیر(2)، 400.0، 0.0)
    mahur.آزادکن()
    ناپایا freqs := موسیقی.بسامدهای دستگاه(60، موسیقی.دستگاه شور)
    آزمایش.ادعای برابری عدد(freqs.طول()، 7)
    آزمایش.ادعای برابری اعشار(freqs.بگیر(0)، موسیقی.نت به بسامد(60)، 0.000001)
    آزمایش.ادعا با پیام(freqs.بگیر(2) بزرگتر موسیقی.نت به بسامد(63)، "the third of shur sits above a minor third")
    آزمایش.ادعا با پیام(freqs.بگیر(2) کوچکتر موسیقی.نت به بسامد(64)، "and below a major third")
    freqs.آزادکن()
    آزمایش.ادعای برابری اعشار(موسیقی.سنت کرن، -50.0، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.سنت سری، 50.0، 0.0)

    سرچاپ "just and pythagorean tunings"
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت طبیعی(0)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت طبیعی(7)، 1.5، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت طبیعی(4)، 1.25، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت فیثاغورسی(0)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت فیثاغورسی(7)، 1.5، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت فیثاغورسی(2)، 1.125، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.نسبت فیثاغورسی(5)، 4.0 / 3.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.بسامد طبیعی(69، 7)، 660.0، 0.000001)
    آزمایش.ادعای برابری اعشار(موسیقی.ثانیه ضربه(120.0)، 0.5، 0.0)
    آزمایش.ادعای برابری اعشار(موسیقی.ثانیه ضربه(0.0)، 0.0، 0.0)

    سرچاپ "oscillators make the pitch they are asked for"
    ناپایا sine := صداساز.نوا(440.0، 0.2، 44100، صداساز.موج سینوسی)
    آزمایش.ادعای برابری عدد(sine.نرخ، 44100)
    آزمایش.ادعای برابری عدد(sine.فریم ها، 8820)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(peak_freq(sine، 8192) - 440.0) کوچکتر 12.0، "a sine should peak at its pitch")
    آزمایش.ادعا با پیام(صدا.اوج(sine) بزرگتر 0.9، "a sine should reach full scale")
    ناپایا saw := صداساز.نوا(220.0، 0.2، 44100، صداساز.موج اره‌ای)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(peak_freq(saw، 8192) - 220.0) کوچکتر 12.0، "a saw should peak at its pitch")
    ناپایا sq := صداساز.نوا(330.0، 0.2، 44100، صداساز.موج مربعی)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(peak_freq(sq، 8192) - 330.0) کوچکتر 12.0، "a square should peak at its pitch")
    ناپایا tr := صداساز.نوا(550.0، 0.2، 44100، صداساز.موج مثلثی)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(peak_freq(tr، 8192) - 550.0) کوچکتر 12.0، "a triangle should peak at its pitch")
    آزمایش.ادعای برابری اعشار(صداساز.مقدار موج(صداساز.موج سینوسی، 0.0، 0.5)، 0.0، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.مقدار موج(صداساز.موج اره‌ای، 0.5، 0.5)، 0.0، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.مقدار موج(صداساز.موج مربعی، 0.25، 0.5)، 1.0، 0.0)
    آزمایش.ادعای برابری اعشار(صداساز.مقدار موج(صداساز.موج مربعی، 0.75، 0.5)، -1.0، 0.0)

    سرچاپ "envelopes rise, hold and fall"
    e := صداساز.پوشش { حمله = 0.1، افت = 0.1، پایداری = 0.5، رهایش = 0.2 }
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.0، 1.0)، 0.0، 0.0)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.05، 1.0)، 0.5، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.1، 1.0)، 1.0، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.2، 1.0)، 0.5، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 0.5، 1.0)، 0.5، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 1.2، 1.0)، 0.0، 0.000001)
    آزمایش.ادعای برابری اعشار(صداساز.پوشش در زمان(e، 5.0، 1.0)، 0.0، 0.0)
    آزمایش.ادعای برابری اعشار(صداساز.درازی کل پوشش(e، 1.0)، 1.2، 0.000001)
    ناپایا shaped := صداساز.نوا با پوشش(440.0، 0.2، 22050، صداساز.موج سینوسی، e، 0.8)
    آزمایش.ادعای برابری اعشار(صدا.نمونه(shaped، 0، 0)، 0.0، 0.0)
    آزمایش.ادعا با پیام(صدا.اوج(shaped) کوچکتربرابر 0.81، "the envelope should hold the gain down")

    سرچاپ "chords, noise and other voices"
    ناپایا cf := موسیقی.بسامدهای دستگاه(57، موسیقی.دستگاه شور)
    ناپایا ch := صداساز.آکورد(cf، 0.2، 22050، صداساز.موج سینوسی)
    آزمایش.ادعا با پیام(صدا.اوج(ch) بزرگتر 0.1، "a chord should make sound")
    آزمایش.ادعا با پیام(وارونه صدا.بریده است(ch)، "a chord should not clip")
    cf.آزادکن()
    ناپایا wn := صداساز.نوفه سپید(0.1، 22050)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع(wn) بزرگتر 0.3، "white noise should be loud")
    ناپایا pn := صداساز.نوفه صورتی(0.1، 22050)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع(pn) بزرگتر 0.01، "pink noise should make sound")
    ناپایا bn := صداساز.نوفه قهوه‌ای(0.1، 22050)
    آزمایش.ادعا با پیام(صدا.جذر میانگین مربع(bn) بزرگتر 0.001، "brown noise should make sound")
    ناپایا fm := صداساز.نوا اف‌ام(220.0، 2.0، 3.0، 0.2، 22050)
    آزمایش.ادعا با پیام(صدا.اوج(fm) بزرگتر 0.5، "fm should make sound")
    ناپایا add := صداساز.افزایشی(220.0، 6، 0.6، 0.2، 44100)
    آزمایش.ادعا با پیام(ریاضی.قدرمطلق(peak_freq(add، 8192) - 220.0) کوچکتر 12.0، "additive should keep its fundamental")
    ناپایا ks := صداساز.کارپلوس استرانگ(220.0، 0.3، 22050، 0.99)
    آزمایش.ادعا با پیام(صدا.اوج(ks) بزرگتر 0.1، "karplus strong should make sound")

    سرچاپ "a rendered phrase"
    ناپایا phrase := وکتور {} برگردان وکتور<صداساز.نت>
    ناپایا scale := موسیقی.نت‌های گام(60، موسیقی.گام بزرگ، 8)
    ناپایا k := 0
    تا k کوچکتر scale.طول():
        phrase.بیفزا(صداساز.نت در(scale.بگیر(k)، (k برگردان اعشار۶۴) * 0.1، 0.09، 0.4، صداساز.موج سینوسی))
        k += 1
    پایان
    scale.آزادکن()
    ناپایا song := صداساز.ساختن نت‌ها(phrase، 22050، 2، e)
    آزمایش.ادعای برابری عدد(song.کانال ها، 2)
    آزمایش.ادعا با پیام(song.فریم ها بزرگتر 0، "the phrase should have length")
    آزمایش.ادعا با پیام(صدا.اوج(song) بزرگتر 0.1، "the phrase should make sound")
    آزمایش.ادعا با پیام(وارونه صدا.بریده است(song)، "the phrase should not clip")
    phrase.آزادکن()
    ناپایا nothing := صداساز.ساختن نت‌ها(وکتور {} برگردان وکتور<صداساز.نت>، 22050، 1، e)
    آزمایش.ادعای درستی(صدا.خالی است(nothing))

    سرچاپ "midi round-trip"
    ناپایا f := میدی.آهنگ جدید(480)
    آزمایش.ادعای برابری عدد(f.تقسیم، 480)
    آزمایش.ادعای برابری اعشار(میدی.ضربان(f)، 120.0، 0.000001)
    ناپایا t := میدی.ترک جدید()
    میدی.افزودن ضرباهنگ(t، 0، 120.0)
    میدی.افزودن برنامه(t، 0، 0، 0)
    میدی.افزودن واپایش(t، 0، 7، 100، 0)
    ناپایا s := 0
    تا s کوچکتر 4:
        میدی.افزودن نت(t، s * 480، 240، 60 + s * 2، 100، 0)
        s += 1
    پایان
    میدی.افزودن ترک(f، t)
    آزمایش.ادعای برابری عدد(f.ترک‌ها.طول()، 1)
    آزمایش.ادعای برابری عدد(میدی.تیک کل(f)، 3 * 480 + 240)
    آزمایش.ادعای برابری اعشار(میدی.تیک به ثانیه(f، 480)، 0.5، 0.000001)
    آزمایش.ادعای برابری عدد(میدی.ثانیه به تیک(f، 0.5)، 480)

    enc := میدی.کدگذاری میدی(f)
    آزمایش.ادعا با پیام(فشرده سازی.طول بافر(enc) بزرگتر 22، "the midi file should have a body")
    آزمایش.ادعای درستی(میدی.میدی است(enc.داده، enc.طول))
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(enc.داده، enc.طول)، صدا.قالب میدی)
    ناپایا ok := نادرست
    ناپایا back := میدی.کدگشایی میدی(enc.داده، enc.طول، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای برابری عدد(back.تقسیم، 480)
    آزمایش.ادعای برابری عدد(back.ترک‌ها.طول()، 1)
    آزمایش.ادعای برابری اعشار(میدی.ضربان(back)، 120.0، 0.01)
    آزمایش.ادعای برابری عدد(میدی.تیک کل(back)، 3 * 480 + 240)

    سرچاپ "notes come back and render"
    ناپایا got := میدی.نت‌ها(back)
    آزمایش.ادعای برابری عدد(got.طول()، 4)
    آزمایش.ادعای برابری عدد(got.بگیر(0).شماره نت، 60)
    آزمایش.ادعای برابری عدد(got.بگیر(3).شماره نت، 66)
    آزمایش.ادعای برابری اعشار(got.بگیر(1).آغاز، 0.5، 0.000001)
    آزمایش.ادعای برابری اعشار(got.بگیر(0).درازی، 0.25، 0.000001)
    got.آزادکن()
    ناپایا rendered := میدی.ساختن(back، 22050، 1)
    آزمایش.ادعا با پیام(rendered.فریم ها بزرگتر 0، "the midi should render")
    آزمایش.ادعا با پیام(صدا.اوج(rendered) بزرگتر 0.05، "the midi should make sound")
    آزمایش.ادعای برابری رشته(میدی.نام برنامه(0)، "Acoustic Grand Piano")
    آزمایش.ادعای برابری رشته(میدی.نام برنامه(200)، "")

    سرچاپ "midi on disk and refusals"
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_song.mid")
    دیرکن حافظه.آزادسازی(path برگردان تهی*)
    آزمایش.ادعای درستی(میدی.ذخیره میدی(f، path))
    ناپایا dok := نادرست
    ناپایا disk := میدی.بازکردن میدی(path، dok)
    آزمایش.ادعای درستی(dok)
    آزمایش.ادعای برابری عدد(disk.ترک‌ها.طول()، 1)
    ناپایا gone := نادرست
    missing := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_song_none.mid")
    دیرکن حافظه.آزادسازی(missing برگردان تهی*)
    میدی.بازکردن میدی(missing، gone)
    آزمایش.ادعای نادرستی(gone)
    ناپایا empty := میدی.آهنگ جدید(480)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(میدی.کدگذاری میدی(empty))، 0)
    آزمایش.ادعای نادرستی(میدی.میدی است(enc.داده، 8))
    ناپایا bad := نادرست
    میدی.کدگشایی میدی(enc.داده، 8، bad)
    آزمایش.ادعای نادرستی(bad)
    میدی.آزادسازی آهنگ(empty)

    فشرده سازی.آزادسازی بافر(enc)
    صدا.آزادسازی(sine)
    صدا.آزادسازی(saw)
    صدا.آزادسازی(sq)
    صدا.آزادسازی(tr)
    صدا.آزادسازی(shaped)
    صدا.آزادسازی(ch)
    صدا.آزادسازی(wn)
    صدا.آزادسازی(pn)
    صدا.آزادسازی(bn)
    صدا.آزادسازی(fm)
    صدا.آزادسازی(add)
    صدا.آزادسازی(ks)
    صدا.آزادسازی(song)
    صدا.آزادسازی(nothing)
    صدا.آزادسازی(rendered)
    میدی.آزادسازی آهنگ(f)
    میدی.آزادسازی آهنگ(back)
    میدی.آزادسازی آهنگ(disk)
    برگشت آزمایش.خلاصه()
پایان
