بسته ریشه

واردسازی صدا
واردسازی صدا.ویو
واردسازی صدا.کدک
واردسازی صدا.پردازش سیگنال
واردسازی فشرده سازی
واردسازی ریاضی

تابع آهنگ ساز(نرخ: صحیح، کانال: صحیح، فریم: صحیح): صدا.قطعه:
    ناپایا نو := صدا.جدید(نرخ، کانال، فریم)
    ناپایا شماره := 0
    تا شماره کوچکتر فریم:
        صدا.تنظیم نمونه(نو، شماره، 0، ریاضی.سینوس(2.0 * ریاضی.پی * 440.0 * (شماره برگردان اعشار۶۴) / (نرخ برگردان اعشار۶۴)) * 0.5)
        شماره += 1
    پایان
    برگشت نو
پایان

تابع ریشه:
    سرچاپ "ساختن و خواندن"
    ناپایا آهنگ := آهنگ ساز(8000، 1، 400)
    سرچاپ "  شمار نمونه:"، صدا.شمار نمونه(آهنگ)
    سرچاپ "  مدت:"، صدا.مدت(آهنگ)
    سرچاپ "  بیشترین اوج زیر یک:"، صدا.اوج(آهنگ) کوچکتر 1.0

    سرچاپ "ویرایش"
    صدا.هنجارسازی(آهنگ، 0.0)
    سرچاپ "  اوج پس از هنجارسازی:"، صدا.اوج(آهنگ)
    ناپایا بریده := صدا.برش(آهنگ، 0، 100)
    سرچاپ "  فریم های برش:"، بریده.فریم ها
    ناپایا تک := صدا.به یک‌کاناله(صدا.به دوکاناله(بریده))
    سرچاپ "  کانال پس از رفت و برگشت:"، تک.کانال ها

    سرچاپ "ویو"
    ناپایا بافر := ویو.کدگذاری ویو(بریده)
    سرچاپ "  اندازه پرونده:"، فشرده سازی.طول بافر(بافر)
    ناپایا درستی := نادرست
    ناپایا برگشته := ویو.کدگشایی ویو(بافر.داده، بافر.طول، درستی)
    سرچاپ "  کدگشایی شد:"، درستی
    سرچاپ "  فریم ها برابرند:"، برگشته.فریم ها برابر بریده.فریم ها
    سرچاپ "  شانزده بیتی:"، برگشته.بیت ها برابر 16

    سرچاپ "شناسایی قالب"
    سرچاپ "  نام قالب:"، صدا.نام قالب(صدا.شناسایی قالب(بافر.داده، بافر.طول))
    سرچاپ "  قالب از پسوند:"، صدا.نام قالب(صدا.قالب از پسوند("ترانه.flac"))
    سرچاپ "  بی اتلاف:"، صدا.قالب بی‌اتلاف است(صدا.قالب ویو)

    سرچاپ "کدک همگانی"
    سرچاپ "  ویو کدگشایی می‌شود:"، کدک.کدگشایی شدنی(صدا.قالب ویو)
    سرچاپ "  ام‌پی‌تری هنوز نه:"، کدک.کدگشایی شدنی(صدا.قالب ام‌پی‌تری)

    سرچاپ "پردازش سیگنال"
    صافی := پردازش سیگنال.صافی پایین(1000.0، 0.707، 8000)
    سرچاپ "  بهره در صد هرتز بالای نیم:"، پردازش سیگنال.پاسخ دوقطبی(صافی، 100.0، 8000) بزرگتر 0.5
    سرچاپ "  توان دو بعدی هزار:"، پردازش سیگنال.توان دو بعدی(1000)
    سرچاپ "  بسل صفر:"، پردازش سیگنال.بسل صفر(0.0)
    ناپایا کم := پردازش سیگنال.بازنمونه سینک(بریده، 4000، 16)
    سرچاپ "  نرخ پس از بازنمونه:"، کم.نرخ

    فشرده سازی.آزادسازی بافر(بافر)
    صدا.آزادسازی(آهنگ)
    صدا.آزادسازی(بریده)
    صدا.آزادسازی(تک)
    صدا.آزادسازی(برگشته)
    صدا.آزادسازی(کم)
    برگشت 0
پایان
