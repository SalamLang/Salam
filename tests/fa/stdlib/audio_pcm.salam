بسته ریشه

واردسازی صدا
واردسازی فشرده سازی
واردسازی ریاضی

تابع ریشه:
    ناپایا c := صدا.جدید(8000، 1، 4)
    صدا.تنظیم نمونه(c، 0، 0، 0.5)
    صدا.تنظیم نمونه(c، 1، 0، -0.5)
    صدا.تنظیم نمونه(c، 2، 0، 0.25)
    صدا.تنظیم نمونه(c، 3، 0، 0.0)

    سرچاپ "integer pcm"
    ناپایا le := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری پی‌سی‌ام(le، c، 16، نادرست، نادرست)
    ناپایا be := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری پی‌سی‌ام(be، c، 16، درست، نادرست)
    سرچاپ فشرده سازی.طول بافر(le)، فشرده سازی.طول بافر(be)
    سرچاپ فشرده سازی.دریافت بایت(le، 0)، فشرده سازی.دریافت بایت(le، 1)، فشرده سازی.دریافت بایت(be، 0)، فشرده سازی.دریافت بایت(be، 1)
    ناپایا a := صدا.جدید(8000، 1، 4)
    ناپایا b := صدا.جدید(8000، 1، 4)
    سرچاپ صدا.کدگشایی پی‌سی‌ام(le.داده، 0، a، 16، نادرست، نادرست)
    سرچاپ صدا.کدگشایی پی‌سی‌ام(be.داده، 0، b، 16، درست، نادرست)
    سرچاپ صدا.نمونه(a، 0، 0)، صدا.نمونه(a، 1، 0)، صدا.نمونه(a، 2، 0)، صدا.نمونه(a، 3، 0)
    سرچاپ صدا.نمونه(b، 0، 0) برابر صدا.نمونه(a، 0، 0)، صدا.نمونه(b، 1، 0) برابر صدا.نمونه(a، 1، 0)

    سرچاپ "unsigned eight bit"
    ناپایا u8 := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری پی‌سی‌ام(u8، c، 8، نادرست، درست)
    سرچاپ فشرده سازی.طول بافر(u8)، فشرده سازی.دریافت بایت(u8، 0)، فشرده سازی.دریافت بایت(u8، 3)
    ناپایا d := صدا.جدید(8000، 1، 4)
    سرچاپ صدا.کدگشایی پی‌سی‌ام(u8.داده، 0، d، 8، نادرست، درست)
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(d، 0، 0) - 0.5) کوچکتر 0.01

    سرچاپ "float pcm"
    ناپایا f32 := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری اعشاری(f32، c، 32، نادرست)
    ناپایا f64 := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری اعشاری(f64، c، 64، درست)
    سرچاپ فشرده سازی.طول بافر(f32)، فشرده سازی.طول بافر(f64)
    ناپایا e := صدا.جدید(8000، 1، 4)
    ناپایا g := صدا.جدید(8000، 1، 4)
    سرچاپ صدا.کدگشایی اعشاری(f32.داده، f32.طول، 0، e، 32، نادرست)
    سرچاپ صدا.کدگشایی اعشاری(f64.داده، f64.طول، 0، g، 64، درست)
    سرچاپ صدا.نمونه(e، 1، 0)، صدا.نمونه(g، 2، 0)
    سرچاپ صدا.کدگشایی اعشاری(f32.داده، 3، 0، e، 32، نادرست)

    سرچاپ "companded pcm"
    ناپایا mu := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری فشرده(mu، c، نادرست)
    ناپایا al := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری فشرده(al، c، درست)
    سرچاپ فشرده سازی.طول بافر(mu)، فشرده سازی.طول بافر(al)
    ناپایا h := صدا.جدید(8000، 1، 4)
    ناپایا k := صدا.جدید(8000، 1، 4)
    سرچاپ صدا.کدگشایی فشرده(mu.داده، 0، h، نادرست)
    سرچاپ صدا.کدگشایی فشرده(al.داده، 0، k، درست)
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(h، 1، 0) + 0.5) کوچکتر 0.02، ریاضی.قدرمطلق(صدا.نمونه(k، 1، 0) + 0.5) کوچکتر 0.02
    سرچاپ صدا.نمونه(h، 3، 0)، صدا.نمونه(k، 3، 0) کوچکتر 0.001

    سرچاپ "mix at an offset"
    ناپایا dst := صدا.جدید(8000، 1، 6)
    ناپایا src := صدا.جدید(8000، 1، 3)
    صدا.تنظیم نمونه(src، 0، 0، 0.5)
    صدا.تنظیم نمونه(src، 1، 0، 0.25)
    صدا.تنظیم نمونه(src، 2، 0، 1.0)
    صدا.آمیختن در(dst، src، 2، 0.5)
    سرچاپ صدا.نمونه(dst، 1، 0)، صدا.نمونه(dst، 2، 0)، صدا.نمونه(dst، 3، 0)، صدا.نمونه(dst، 4، 0)، صدا.نمونه(dst، 5، 0)
    صدا.آمیختن در(dst، src، 5، 1.0)
    سرچاپ صدا.نمونه(dst، 5، 0)
    صدا.آمیختن در(dst، src، -2، 1.0)
    سرچاپ صدا.نمونه(dst، 0، 0)، صدا.نمونه(dst، 1، 0)

    سرچاپ "rms of a range"
    سرچاپ صدا.جذر میانگین مربع بازه(src، 0، 1)، صدا.جذر میانگین مربع بازه(src، 2، 1)، صدا.جذر میانگین مربع بازه(src، 0، 0)
    سرچاپ صدا.جذر میانگین مربع بازه(src، 1، 100) برابر صدا.جذر میانگین مربع بازه(src، 1، 2)
    سرچاپ صدا.جذر میانگین مربع بازه(src، 0، 3) برابر صدا.جذر میانگین مربع(src)

    سرچاپ "bit writer"
    ناپایا w := صدا.نویسنده بیت جدید()
    صدا.نوشتن بیت(w، 1)
    صدا.نوشتن بیت(w، 0)
    صدا.نوشتن بیت(w، 1)
    سرچاپ صدا.طول نویسنده(w)
    صدا.همتراز کردن نویسنده(w)
    سرچاپ صدا.طول نویسنده(w)
    صدا.نوشتن بیت‌ها(w، 255، 8)
    out := صدا.پایان نویسنده(w)
    سرچاپ فشرده سازی.طول بافر(out)، فشرده سازی.دریافت بایت(out، 0)، فشرده سازی.دریافت بایت(out، 1)
    ناپایا p := صدا.نویسنده بیت جدید()
    صدا.همتراز کردن نویسنده(p)
    سرچاپ صدا.طول نویسنده(p)
    صدا.آزادسازی نویسنده(w)
    صدا.آزادسازی نویسنده(p)

    فشرده سازی.آزادسازی بافر(le)
    فشرده سازی.آزادسازی بافر(be)
    فشرده سازی.آزادسازی بافر(u8)
    فشرده سازی.آزادسازی بافر(f32)
    فشرده سازی.آزادسازی بافر(f64)
    فشرده سازی.آزادسازی بافر(mu)
    فشرده سازی.آزادسازی بافر(al)
    صدا.آزادسازی(c)
    صدا.آزادسازی(a)
    صدا.آزادسازی(b)
    صدا.آزادسازی(d)
    صدا.آزادسازی(e)
    صدا.آزادسازی(g)
    صدا.آزادسازی(h)
    صدا.آزادسازی(k)
    صدا.آزادسازی(dst)
    صدا.آزادسازی(src)
پایان
