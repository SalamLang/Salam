بسته ریشه

واردسازی صدا
واردسازی فشرده سازی
واردسازی ریاضی

تابع ریشه:
    ناپایا c := صدا.جدید(8000، 1، 4)
    صدا.تنظیم نمونه(c، 0، 0، 0.5)
    صدا.تنظیم نمونه(c، 1، 0، -0.5)
    صدا.تنظیم نمونه(c، 2، 0، 0.25)
    صدا.تنظیم نمونه(c، 3، 0، 0.0)

    سرچاپ "integer pcm"
    ناپایا کوچک‌پایان := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری پی‌سی‌ام(کوچک‌پایان، c، 16، نادرست، نادرست)
    ناپایا بزرگ‌پایان := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری پی‌سی‌ام(بزرگ‌پایان، c، 16، درست، نادرست)
    سرچاپ فشرده سازی.طول بافر(کوچک‌پایان)، فشرده سازی.طول بافر(بزرگ‌پایان)
    سرچاپ فشرده سازی.دریافت بایت(کوچک‌پایان، 0)، فشرده سازی.دریافت بایت(کوچک‌پایان، 1)، فشرده سازی.دریافت بایت(بزرگ‌پایان، 0)، فشرده سازی.دریافت بایت(بزرگ‌پایان، 1)
    ناپایا a := صدا.جدید(8000، 1، 4)
    ناپایا b := صدا.جدید(8000، 1، 4)
    سرچاپ صدا.کدگشایی پی‌سی‌ام(کوچک‌پایان.داده، 0، a، 16، نادرست، نادرست)
    سرچاپ صدا.کدگشایی پی‌سی‌ام(بزرگ‌پایان.داده، 0، b، 16، درست، نادرست)
    سرچاپ صدا.نمونه(a، 0، 0)، صدا.نمونه(a، 1، 0)، صدا.نمونه(a، 2، 0)، صدا.نمونه(a، 3، 0)
    سرچاپ صدا.نمونه(b، 0، 0) برابر صدا.نمونه(a، 0، 0)، صدا.نمونه(b، 1، 0) برابر صدا.نمونه(a، 1، 0)

    سرچاپ "unsigned eight bit"
    ناپایا بدون‌علامت۸ := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری پی‌سی‌ام(بدون‌علامت۸، c، 8، نادرست، درست)
    سرچاپ فشرده سازی.طول بافر(بدون‌علامت۸)، فشرده سازی.دریافت بایت(بدون‌علامت۸، 0)، فشرده سازی.دریافت بایت(بدون‌علامت۸، 3)
    ناپایا d := صدا.جدید(8000، 1، 4)
    سرچاپ صدا.کدگشایی پی‌سی‌ام(بدون‌علامت۸.داده، 0، d، 8، نادرست، درست)
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(d، 0، 0) - 0.5) کوچکتر 0.01

    سرچاپ "float pcm"
    ناپایا اعشاری۳۲ := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری اعشاری(اعشاری۳۲، c، 32، نادرست)
    ناپایا اعشاری۶۴ := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری اعشاری(اعشاری۶۴، c، 64، درست)
    سرچاپ فشرده سازی.طول بافر(اعشاری۳۲)، فشرده سازی.طول بافر(اعشاری۶۴)
    ناپایا e := صدا.جدید(8000، 1، 4)
    ناپایا g := صدا.جدید(8000، 1، 4)
    سرچاپ صدا.کدگشایی اعشاری(اعشاری۳۲.داده، اعشاری۳۲.طول، 0، e، 32، نادرست)
    سرچاپ صدا.کدگشایی اعشاری(اعشاری۶۴.داده، اعشاری۶۴.طول، 0، g، 64، درست)
    سرچاپ صدا.نمونه(e، 1، 0)، صدا.نمونه(g، 2، 0)
    سرچاپ صدا.کدگشایی اعشاری(اعشاری۳۲.داده، 3، 0، e، 32، نادرست)

    سرچاپ "companded pcm"
    ناپایا میولا := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری فشرده(میولا، c، نادرست)
    ناپایا ای‌لا := فشرده سازی.بافر بایت جدید()
    صدا.کدگذاری فشرده(ای‌لا، c، درست)
    سرچاپ فشرده سازی.طول بافر(میولا)، فشرده سازی.طول بافر(ای‌لا)
    ناپایا h := صدا.جدید(8000، 1، 4)
    ناپایا k := صدا.جدید(8000، 1، 4)
    سرچاپ صدا.کدگشایی فشرده(میولا.داده، 0، h، نادرست)
    سرچاپ صدا.کدگشایی فشرده(ای‌لا.داده، 0، k، درست)
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(h، 1، 0) + 0.5) کوچکتر 0.02، ریاضی.قدرمطلق(صدا.نمونه(k، 1، 0) + 0.5) کوچکتر 0.02
    سرچاپ صدا.نمونه(h، 3، 0)، صدا.نمونه(k، 3، 0) کوچکتر 0.001

    سرچاپ "mix at an offset"
    ناپایا مقصد := صدا.جدید(8000، 1، 6)
    ناپایا منبع := صدا.جدید(8000، 1، 3)
    صدا.تنظیم نمونه(منبع، 0، 0، 0.5)
    صدا.تنظیم نمونه(منبع، 1، 0، 0.25)
    صدا.تنظیم نمونه(منبع، 2، 0، 1.0)
    صدا.آمیختن در(مقصد، منبع، 2، 0.5)
    سرچاپ صدا.نمونه(مقصد، 1، 0)، صدا.نمونه(مقصد، 2، 0)، صدا.نمونه(مقصد، 3، 0)، صدا.نمونه(مقصد، 4، 0)، صدا.نمونه(مقصد، 5، 0)
    صدا.آمیختن در(مقصد، منبع، 5، 1.0)
    سرچاپ صدا.نمونه(مقصد، 5، 0)
    صدا.آمیختن در(مقصد، منبع، -2، 1.0)
    سرچاپ صدا.نمونه(مقصد، 0، 0)، صدا.نمونه(مقصد، 1، 0)

    سرچاپ "rms of a range"
    سرچاپ صدا.جذر میانگین مربع بازه(منبع، 0، 1)، صدا.جذر میانگین مربع بازه(منبع، 2، 1)، صدا.جذر میانگین مربع بازه(منبع، 0، 0)
    سرچاپ صدا.جذر میانگین مربع بازه(منبع، 1، 100) برابر صدا.جذر میانگین مربع بازه(منبع، 1، 2)
    سرچاپ صدا.جذر میانگین مربع بازه(منبع، 0، 3) برابر صدا.جذر میانگین مربع(منبع)

    سرچاپ "bit writer"
    ناپایا w := صدا.نویسنده بیت جدید()
    صدا.نوشتن بیت(w، 1)
    صدا.نوشتن بیت(w، 0)
    صدا.نوشتن بیت(w، 1)
    سرچاپ صدا.طول نویسنده(w)
    صدا.همتراز کردن نویسنده(w)
    سرچاپ صدا.طول نویسنده(w)
    صدا.نوشتن بیت‌ها(w، 255، 8)
    خروجی := صدا.پایان نویسنده(w)
    سرچاپ فشرده سازی.طول بافر(خروجی)، فشرده سازی.دریافت بایت(خروجی، 0)، فشرده سازی.دریافت بایت(خروجی، 1)
    ناپایا p := صدا.نویسنده بیت جدید()
    صدا.همتراز کردن نویسنده(p)
    سرچاپ صدا.طول نویسنده(p)
    صدا.آزادسازی نویسنده(w)
    صدا.آزادسازی نویسنده(p)

    فشرده سازی.آزادسازی بافر(کوچک‌پایان)
    فشرده سازی.آزادسازی بافر(بزرگ‌پایان)
    فشرده سازی.آزادسازی بافر(بدون‌علامت۸)
    فشرده سازی.آزادسازی بافر(اعشاری۳۲)
    فشرده سازی.آزادسازی بافر(اعشاری۶۴)
    فشرده سازی.آزادسازی بافر(میولا)
    فشرده سازی.آزادسازی بافر(ای‌لا)
    صدا.آزادسازی(c)
    صدا.آزادسازی(a)
    صدا.آزادسازی(b)
    صدا.آزادسازی(d)
    صدا.آزادسازی(e)
    صدا.آزادسازی(g)
    صدا.آزادسازی(h)
    صدا.آزادسازی(k)
    صدا.آزادسازی(مقصد)
    صدا.آزادسازی(منبع)
پایان
