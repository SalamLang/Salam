بسته ریشه

واردسازی بایگانی
واردسازی صدا
واردسازی صدا.ایف
واردسازی صدا.ای‌یو
واردسازی صدا.کدک
واردسازی صدا.ویو
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی ریاضی
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا c := صدا.جدید(8000، 1، 32)
    صدا.تنظیم نمونه(c، 3، 0، 0.5)
    صدا.تنظیم نمونه(c، 4، 0، -0.5)
    c.بیت ها = 16

    سرچاپ "wav files"
    مسیر ویو := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save.wav")
    دیرکن حافظه.آزادسازی(مسیر ویو برگردان تهی*)
    سرچاپ ویو.ذخیره ویو(c، مسیر ویو)
    ناپایا موفق ویو := نادرست
    ناپایا بازخوانی ویو := ویو.بازکردن ویو(مسیر ویو، موفق ویو)
    سرچاپ موفق ویو، بازخوانی ویو.نرخ، بازخوانی ویو.کانال ها، بازخوانی ویو.بیت ها، بازخوانی ویو.فریم ها
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(بازخوانی ویو، 3، 0) - 0.5) کوچکتر 0.001، ریاضی.قدرمطلق(صدا.نمونه(بازخوانی ویو، 4، 0) + 0.5) کوچکتر 0.001
    مسیر اعشاری := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save_f32.wav")
    دیرکن حافظه.آزادسازی(مسیر اعشاری برگردان تهی*)
    سرچاپ ویو.ذخیره ویو اعشاری(c، مسیر اعشاری)
    ناپایا موفق اعشاری := نادرست
    ناپایا بازخوانی اعشاری := ویو.بازکردن ویو(مسیر اعشاری، موفق اعشاری)
    سرچاپ موفق اعشاری، بازخوانی اعشاری.بیت ها، صدا.نمونه(بازخوانی اعشاری، 3، 0)، صدا.نمونه(بازخوانی اعشاری، 4، 0)
    سرچاپ ویو.ذخیره ویو(c، مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_no_such_dir/x.wav"))

    سرچاپ "aiff file"
    مسیر ایف := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save.aiff")
    دیرکن حافظه.آزادسازی(مسیر ایف برگردان تهی*)
    سرچاپ ایف.ذخیره ایف(c، مسیر ایف)
    ناپایا موفق ایف := نادرست
    ناپایا بازخوانی ایف := ایف.بازکردن ایف(مسیر ایف، موفق ایف)
    سرچاپ موفق ایف، بازخوانی ایف.نرخ، بازخوانی ایف.بیت ها، بازخوانی ایف.فریم ها
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(بازخوانی ایف، 3، 0) - 0.5) کوچکتر 0.001

    سرچاپ "au encode and open"
    ناپایا کدگذاری شده := ای‌یو.کدگذاری ای‌یو(c)
    سرچاپ ای‌یو.ای‌یو است(کدگذاری شده.داده، کدگذاری شده.طول)، فشرده سازی.طول بافر(کدگذاری شده) برابر ای‌یو.اندازه سرآیند + 64
    ناپایا h := ای‌یو.سرآیند {}
    سرچاپ ای‌یو.خواندن سرآیند(کدگذاری شده.داده، کدگذاری شده.طول، h)، h.رمزگذاری برابر ای‌یو.رمز پی‌سی‌ام۱۶، h.نرخ، h.کانال ها
    مسیر ای‌یو := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save.au")
    دیرکن حافظه.آزادسازی(مسیر ای‌یو برگردان تهی*)
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(مسیر ای‌یو، کدگذاری شده)
    ناپایا موفق ای‌یو := نادرست
    ناپایا بازخوانی ای‌یو := ای‌یو.بازکردن ای‌یو(مسیر ای‌یو، موفق ای‌یو)
    سرچاپ موفق ای‌یو، بازخوانی ای‌یو.نرخ، بازخوانی ای‌یو.فریم ها، بازخوانی ای‌یو.بیت ها
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(بازخوانی ای‌یو، 4، 0) + 0.5) کوچکتر 0.001
    ناپایا حذف شده := نادرست
    ای‌یو.بازکردن ای‌یو(مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save_none.au")، حذف شده)
    سرچاپ حذف شده
    سرچاپ فشرده سازی.طول بافر(ای‌یو.کدگذاری ای‌یو(صدا.قطعه {}))

    سرچاپ "probing by content"
    ناپایا بافر ویو := ویو.کدگذاری ویو(c)
    ناپایا بافر ایف := ایف.کدگذاری ایف(c)
    هر شماره در [0، 1، 2]:
        ناپایا بررسی موفق := نادرست
        ناپایا اطلاعات := صدا.آگاهی {}
        اگر شماره برابر 0:
            اطلاعات = کدک.بررسی(بافر ویو.داده، بافر ویو.طول، بررسی موفق)
        پایان
        اگر شماره برابر 1:
            اطلاعات = کدک.بررسی(بافر ایف.داده، بافر ایف.طول، بررسی موفق)
        پایان
        اگر شماره برابر 2:
            اطلاعات = کدک.بررسی(کدگذاری شده.داده، کدگذاری شده.طول، بررسی موفق)
        پایان
        سرچاپ بررسی موفق، اطلاعات.نرخ، اطلاعات.کانال ها، اطلاعات.بیت ها، اطلاعات.فریم ها
    پایان
    ناپایا موفق بررسی کوتاه := درست
    کدک.بررسی(بافر ویو.داده، 6، موفق بررسی کوتاه)
    سرچاپ موفق بررسی کوتاه

    فشرده سازی.آزادسازی بافر(کدگذاری شده)
    فشرده سازی.آزادسازی بافر(بافر ویو)
    فشرده سازی.آزادسازی بافر(بافر ایف)
    صدا.آزادسازی(c)
    صدا.آزادسازی(بازخوانی ویو)
    صدا.آزادسازی(بازخوانی اعشاری)
    صدا.آزادسازی(بازخوانی ایف)
    صدا.آزادسازی(بازخوانی ای‌یو)
پایان
