بسته ریشه

واردسازی بایگانی
واردسازی صدا
واردسازی صدا.ایف
واردسازی صدا.ای‌یو
واردسازی صدا.کدک
واردسازی صدا.ویو
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی ریاضی
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا c := صدا.جدید(8000، 1، 32)
    صدا.تنظیم نمونه(c، 3، 0، 0.5)
    صدا.تنظیم نمونه(c، 4، 0، -0.5)
    c.بیت ها = 16

    سرچاپ "wav files"
    wpath := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save.wav")
    دیرکن حافظه.آزادسازی(wpath برگردان تهی*)
    سرچاپ ویو.ذخیره ویو(c، wpath)
    ناپایا wok := نادرست
    ناپایا wback := ویو.بازکردن ویو(wpath، wok)
    سرچاپ wok، wback.نرخ، wback.کانال ها، wback.بیت ها، wback.فریم ها
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(wback، 3، 0) - 0.5) کوچکتر 0.001، ریاضی.قدرمطلق(صدا.نمونه(wback، 4، 0) + 0.5) کوچکتر 0.001
    fpath := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save_f32.wav")
    دیرکن حافظه.آزادسازی(fpath برگردان تهی*)
    سرچاپ ویو.ذخیره ویو اعشاری(c، fpath)
    ناپایا fok := نادرست
    ناپایا fback := ویو.بازکردن ویو(fpath، fok)
    سرچاپ fok، fback.بیت ها، صدا.نمونه(fback، 3، 0)، صدا.نمونه(fback، 4، 0)
    سرچاپ ویو.ذخیره ویو(c، مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_no_such_dir/x.wav"))

    سرچاپ "aiff file"
    apath := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save.aiff")
    دیرکن حافظه.آزادسازی(apath برگردان تهی*)
    سرچاپ ایف.ذخیره ایف(c، apath)
    ناپایا aok := نادرست
    ناپایا aback := ایف.بازکردن ایف(apath، aok)
    سرچاپ aok، aback.نرخ، aback.بیت ها، aback.فریم ها
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(aback، 3، 0) - 0.5) کوچکتر 0.001

    سرچاپ "au encode and open"
    ناپایا enc := ای‌یو.کدگذاری ای‌یو(c)
    سرچاپ ای‌یو.ای‌یو است(enc.داده، enc.طول)، فشرده سازی.طول بافر(enc) برابر ای‌یو.اندازه سرآیند + 64
    ناپایا h := ای‌یو.سرآیند {}
    سرچاپ ای‌یو.خواندن سرآیند(enc.داده، enc.طول، h)، h.رمزگذاری برابر ای‌یو.رمز پی‌سی‌ام۱۶، h.نرخ، h.کانال ها
    upath := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save.au")
    دیرکن حافظه.آزادسازی(upath برگردان تهی*)
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(upath، enc)
    ناپایا uok := نادرست
    ناپایا uback := ای‌یو.بازکردن ای‌یو(upath، uok)
    سرچاپ uok، uback.نرخ، uback.فریم ها، uback.بیت ها
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(uback، 4، 0) + 0.5) کوچکتر 0.001
    ناپایا gone := نادرست
    ای‌یو.بازکردن ای‌یو(مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_save_none.au")، gone)
    سرچاپ gone
    سرچاپ فشرده سازی.طول بافر(ای‌یو.کدگذاری ای‌یو(صدا.قطعه {}))

    سرچاپ "probing by content"
    ناپایا wbuf := ویو.کدگذاری ویو(c)
    ناپایا abuf := ایف.کدگذاری ایف(c)
    هر pair در [0، 1، 2]:
        ناپایا pok := نادرست
        ناپایا info := صدا.آگاهی {}
        اگر pair برابر 0:
            info = کدک.بررسی(wbuf.داده، wbuf.طول، pok)
        پایان
        اگر pair برابر 1:
            info = کدک.بررسی(abuf.داده، abuf.طول، pok)
        پایان
        اگر pair برابر 2:
            info = کدک.بررسی(enc.داده، enc.طول، pok)
        پایان
        سرچاپ pok، info.نرخ، info.کانال ها، info.بیت ها، info.فریم ها
    پایان
    ناپایا nok := درست
    کدک.بررسی(wbuf.داده، 6، nok)
    سرچاپ nok

    فشرده سازی.آزادسازی بافر(enc)
    فشرده سازی.آزادسازی بافر(wbuf)
    فشرده سازی.آزادسازی بافر(abuf)
    صدا.آزادسازی(c)
    صدا.آزادسازی(wback)
    صدا.آزادسازی(fback)
    صدا.آزادسازی(aback)
    صدا.آزادسازی(uback)
پایان
