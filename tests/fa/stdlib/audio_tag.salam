بسته ریشه

واردسازی بایگانی
واردسازی صدا.برچسب صدا
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته
واردسازی آزمایش

تابع fill(t &: برچسب صدا.برچسب‌ها):
    t.عنوان = رشته.رونوشت("Shiraz Nights")
    t.هنرمند = رشته.رونوشت("Darya")
    t.آلبوم = رشته.رونوشت("Zagros")
    t.هنرمند آلبوم = رشته.رونوشت("Various")
    t.آهنگساز = رشته.رونوشت("Rahim")
    t.سبک = رشته.رونوشت("Folk")
    t.یادداشت = رشته.رونوشت("a note")
    t.سال = 2026
    t.شماره قطعه = 3
    t.شمار قطعه‌ها = 12
    t.شماره دیسک = 1
    t.ضربان = 96
پایان

تابع flac_with(comment: فشرده سازی.بافر بایت): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(out، 102)
    فشرده سازی.افزودن بایت(out، 76)
    فشرده سازی.افزودن بایت(out، 97)
    فشرده سازی.افزودن بایت(out، 67)
    فشرده سازی.افزودن بایت(out، 128 | برچسب صدا.بلوک یادداشت وربیس)
    n := فشرده سازی.طول بافر(comment)
    فشرده سازی.افزودن بایت(out، (n >> 16) & 255)
    فشرده سازی.افزودن بایت(out، (n >> 8) & 255)
    فشرده سازی.افزودن بایت(out، n & 255)
    فشرده سازی.افزودن بافر(out، comment)
    برگشت out
پایان

تابع ریشه:
    سرچاپ "id3v1 round-trip"
    ناپایا src := برچسب صدا.برچسب‌های جدید()
    fill(src)
    v1 := برچسب صدا.نوشتن آی‌دی۳ یک(src)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(v1)، 128)
    ناپایا file1 := فشرده سازی.بافر بایت جدید()
    ناپایا pad := 0
    تا pad کوچکتر 64:
        فشرده سازی.افزودن بایت(file1، 0)
        pad += 1
    پایان
    فشرده سازی.افزودن بافر(file1، v1)
    آزمایش.ادعای درستی(برچسب صدا.آی‌دی۳ یک دارد(file1.داده، file1.طول))
    ناپایا got1 := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن آی‌دی۳ یک(file1.داده، file1.طول، got1))
    آزمایش.ادعای برابری رشته(got1.عنوان، "Shiraz Nights")
    آزمایش.ادعای برابری رشته(got1.هنرمند، "Darya")
    آزمایش.ادعای برابری رشته(got1.آلبوم، "Zagros")
    آزمایش.ادعای برابری رشته(got1.یادداشت، "a note")
    آزمایش.ادعای برابری عدد(got1.سال، 2026)
    آزمایش.ادعای برابری عدد(got1.شماره قطعه، 3)
    آزمایش.ادعای درستی(برچسب صدا.برچسب دارد(got1))
    آزمایش.ادعای برابری عدد(برچسب صدا.پایان صدا(file1.داده، file1.طول)، 64)

    سرچاپ "id3v2 round-trip"
    v2 := برچسب صدا.نوشتن آی‌دی۳ دو(src)
    آزمایش.ادعای درستی(برچسب صدا.آی‌دی۳ دو دارد(v2.داده، v2.طول))
    آزمایش.ادعای برابری عدد(برچسب صدا.نگارش آی‌دی۳ دو(v2.داده، v2.طول)، 4)
    آزمایش.ادعای برابری عدد(برچسب صدا.اندازه آی‌دی۳ دو(v2.داده، v2.طول)، فشرده سازی.طول بافر(v2))
    ناپایا got2 := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن آی‌دی۳ دو(v2.داده، v2.طول، got2))
    آزمایش.ادعای برابری رشته(got2.عنوان، "Shiraz Nights")
    آزمایش.ادعای برابری رشته(got2.هنرمند، "Darya")
    آزمایش.ادعای برابری رشته(got2.آلبوم، "Zagros")
    آزمایش.ادعای برابری رشته(got2.هنرمند آلبوم، "Various")
    آزمایش.ادعای برابری رشته(got2.آهنگساز، "Rahim")
    آزمایش.ادعای برابری رشته(got2.سبک، "Folk")
    آزمایش.ادعای برابری عدد(got2.سال، 2026)
    آزمایش.ادعای برابری عدد(got2.شماره قطعه، 3)
    آزمایش.ادعای برابری عدد(got2.شمار قطعه‌ها، 12)
    آزمایش.ادعای برابری عدد(got2.شماره دیسک، 1)
    آزمایش.ادعای برابری عدد(got2.ضربان، 96)

    سرچاپ "persian text survives utf-8"
    ناپایا fa := برچسب صدا.برچسب‌های جدید()
    fa.عنوان = رشته.رونوشت("شب‌های شیراز")
    fa.هنرمند = رشته.رونوشت("دریا")
    fav2 := برچسب صدا.نوشتن آی‌دی۳ دو(fa)
    ناپایا faback := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن آی‌دی۳ دو(fav2.داده، fav2.طول، faback))
    آزمایش.ادعای برابری رشته(faback.عنوان، "شب‌های شیراز")
    آزمایش.ادعای برابری رشته(faback.هنرمند، "دریا")

    سرچاپ "vorbis comments round-trip"
    vc := برچسب صدا.نوشتن یادداشت وربیس(src)
    ناپایا gotv := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن یادداشت وربیس(vc.داده، 0، vc.طول، gotv))
    آزمایش.ادعای برابری رشته(gotv.عنوان، "Shiraz Nights")
    آزمایش.ادعای برابری رشته(gotv.هنرمند، "Darya")
    آزمایش.ادعای برابری رشته(gotv.سبک، "Folk")
    آزمایش.ادعای برابری عدد(gotv.سال، 2026)
    آزمایش.ادعای برابری عدد(gotv.شماره قطعه، 3)
    آزمایش.ادعای برابری عدد(gotv.شمار قطعه‌ها، 12)
    آزمایش.ادعای برابری عدد(gotv.ضربان، 96)

    سرچاپ "vorbis comments inside a flac stream"
    fl := flac_with(vc)
    آزمایش.ادعای درستی(برچسب صدا.فلاک برچسبدار است(fl.داده، fl.طول))
    blocks := برچسب صدا.بلوک‌های فلاک(fl.داده، fl.طول)
    آزمایش.ادعای برابری عدد(blocks.طول()، 1)
    آزمایش.ادعای برابری عدد(blocks.بگیر(0).گونه، برچسب صدا.بلوک یادداشت وربیس)
    آزمایش.ادعای درستی(blocks.بگیر(0).آخرین)
    ناپایا gotf := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن برچسب فلاک(fl.داده، fl.طول، gotf))
    آزمایش.ادعای برابری رشته(gotf.آلبوم، "Zagros")

    سرچاپ "the dispatcher picks the right reader"
    ناپایا aok := نادرست
    ناپایا auto := برچسب صدا.خواندن برچسب‌ها(v2.داده، v2.طول، aok)
    آزمایش.ادعای درستی(aok)
    آزمایش.ادعای برابری رشته(auto.عنوان، "Shiraz Nights")
    ناپایا bok := نادرست
    ناپایا autof := برچسب صدا.خواندن برچسب‌ها(fl.داده، fl.طول، bok)
    آزمایش.ادعای درستی(bok)
    آزمایش.ادعای برابری رشته(autof.هنرمند، "Darya")
    ناپایا cok := نادرست
    ناپایا auto1 := برچسب صدا.خواندن برچسب‌ها(file1.داده، file1.طول، cok)
    آزمایش.ادعای درستی(cok)
    آزمایش.ادعای برابری رشته(auto1.آلبوم، "Zagros")
    ناپایا dok := نادرست
    ناپایا nothing := برچسب صدا.خواندن برچسب‌ها(vc.داده، vc.طول، dok)
    آزمایش.ادعای نادرستی(dok)
    آزمایش.ادعای نادرستی(برچسب صدا.برچسب دارد(nothing))

    سرچاپ "stripping tags leaves the audio alone"
    ناپایا full := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بافر(full، v2)
    ناپایا body := 0
    تا body کوچکتر 100:
        فشرده سازی.افزودن بایت(full، 65 + (body % 26))
        body += 1
    پایان
    فشرده سازی.افزودن بافر(full، v1)
    آزمایش.ادعای برابری عدد(برچسب صدا.آغاز صدا(full.داده، full.طول)، فشرده سازی.طول بافر(v2))
    آزمایش.ادعای برابری عدد(برچسب صدا.پایان صدا(full.داده، full.طول)، فشرده سازی.طول بافر(full) - 128)
    bare := برچسب صدا.برداشتن برچسب‌ها(full.داده، full.طول)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(bare)، 100)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(bare، 0)، 65)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(bare، 25)، 90)

    سرچاپ "genre names and empty tags"
    آزمایش.ادعای برابری رشته(برچسب صدا.نام سبک(17)، "Rock")
    آزمایش.ادعای برابری رشته(برچسب صدا.نام سبک(8)، "Jazz")
    آزمایش.ادعای برابری رشته(برچسب صدا.نام سبک(200)، "")
    ناپایا blank := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای نادرستی(برچسب صدا.برچسب دارد(blank))
    empty := برچسب صدا.نوشتن آی‌دی۳ دو(blank)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(empty)، 10)
    آزمایش.ادعای نادرستی(برچسب صدا.خواندن آی‌دی۳ دو(empty.داده، empty.طول، blank))

    سرچاپ "tags on a file"
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_tag.mp3")
    دیرکن حافظه.آزادسازی(path برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی از بافر(path، full))
    ناپایا fok := نادرست
    ناپایا fromdisk := برچسب صدا.خواندن برچسب‌های پرونده(path، fok)
    آزمایش.ادعای درستی(fok)
    آزمایش.ادعای برابری رشته(fromdisk.عنوان، "Shiraz Nights")
    ناپایا gone := نادرست
    missing := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_tag_none.mp3")
    دیرکن حافظه.آزادسازی(missing برگردان تهی*)
    برچسب صدا.خواندن برچسب‌های پرونده(missing، gone)
    آزمایش.ادعای نادرستی(gone)

    برچسب صدا.آزادسازی برچسب‌ها(src)
    برچسب صدا.آزادسازی برچسب‌ها(got1)
    برچسب صدا.آزادسازی برچسب‌ها(got2)
    برچسب صدا.آزادسازی برچسب‌ها(fa)
    برچسب صدا.آزادسازی برچسب‌ها(faback)
    برچسب صدا.آزادسازی برچسب‌ها(gotv)
    برچسب صدا.آزادسازی برچسب‌ها(gotf)
    برچسب صدا.آزادسازی برچسب‌ها(auto)
    برچسب صدا.آزادسازی برچسب‌ها(autof)
    برچسب صدا.آزادسازی برچسب‌ها(auto1)
    برچسب صدا.آزادسازی برچسب‌ها(nothing)
    برچسب صدا.آزادسازی برچسب‌ها(blank)
    برچسب صدا.آزادسازی برچسب‌ها(fromdisk)
    فشرده سازی.آزادسازی بافر(v1)
    فشرده سازی.آزادسازی بافر(v2)
    فشرده سازی.آزادسازی بافر(fav2)
    فشرده سازی.آزادسازی بافر(vc)
    فشرده سازی.آزادسازی بافر(fl)
    فشرده سازی.آزادسازی بافر(file1)
    فشرده سازی.آزادسازی بافر(full)
    فشرده سازی.آزادسازی بافر(bare)
    فشرده سازی.آزادسازی بافر(empty)
    blocks.آزادکن()
    برگشت آزمایش.خلاصه()
پایان
