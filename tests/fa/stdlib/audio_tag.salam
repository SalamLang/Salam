بسته ریشه

واردسازی بایگانی
واردسازی صدا.برچسب صدا
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته
واردسازی آزمایش

تابع پر کردن(t &: برچسب صدا.برچسب‌ها):
    t.عنوان = رشته.رونوشت("Shiraz Nights")
    t.هنرمند = رشته.رونوشت("Darya")
    t.آلبوم = رشته.رونوشت("Zagros")
    t.هنرمند آلبوم = رشته.رونوشت("Various")
    t.آهنگساز = رشته.رونوشت("Rahim")
    t.سبک = رشته.رونوشت("Folk")
    t.یادداشت = رشته.رونوشت("a note")
    t.سال = 2026
    t.شماره قطعه = 3
    t.شمار قطعه‌ها = 12
    t.شماره دیسک = 1
    t.ضربان = 96
پایان

تابع فلاک با یادداشت(بلوک یادداشت: فشرده سازی.بافر بایت): فشرده سازی.بافر بایت:
    ناپایا خروجی := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(خروجی، 102)
    فشرده سازی.افزودن بایت(خروجی، 76)
    فشرده سازی.افزودن بایت(خروجی، 97)
    فشرده سازی.افزودن بایت(خروجی، 67)
    فشرده سازی.افزودن بایت(خروجی، 128 | برچسب صدا.بلوک یادداشت وربیس)
    n := فشرده سازی.طول بافر(بلوک یادداشت)
    فشرده سازی.افزودن بایت(خروجی، (n >> 16) & 255)
    فشرده سازی.افزودن بایت(خروجی، (n >> 8) & 255)
    فشرده سازی.افزودن بایت(خروجی، n & 255)
    فشرده سازی.افزودن بافر(خروجی، بلوک یادداشت)
    برگشت خروجی
پایان

تابع ریشه:
    سرچاپ "id3v1 round-trip"
    ناپایا منبع := برچسب صدا.برچسب‌های جدید()
    پر کردن(منبع)
    ناپایا نسخه۱ := برچسب صدا.نوشتن آی‌دی۳ یک(منبع)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(نسخه۱)، 128)
    ناپایا پرونده۱ := فشرده سازی.بافر بایت جدید()
    ناپایا حاشیه := 0
    تا حاشیه کوچکتر 64:
        فشرده سازی.افزودن بایت(پرونده۱، 0)
        حاشیه++
    پایان
    فشرده سازی.افزودن بافر(پرونده۱، نسخه۱)
    آزمایش.ادعای درستی(برچسب صدا.آی‌دی۳ یک دارد(پرونده۱.داده، پرونده۱.طول))
    ناپایا خوانده۱ := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن آی‌دی۳ یک(پرونده۱.داده، پرونده۱.طول، خوانده۱))
    آزمایش.ادعای برابری رشته(خوانده۱.عنوان، "Shiraz Nights")
    آزمایش.ادعای برابری رشته(خوانده۱.هنرمند، "Darya")
    آزمایش.ادعای برابری رشته(خوانده۱.آلبوم، "Zagros")
    آزمایش.ادعای برابری رشته(خوانده۱.یادداشت، "a note")
    آزمایش.ادعای برابری عدد(خوانده۱.سال، 2026)
    آزمایش.ادعای برابری عدد(خوانده۱.شماره قطعه، 3)
    آزمایش.ادعای درستی(برچسب صدا.برچسب دارد(خوانده۱))
    آزمایش.ادعای برابری عدد(برچسب صدا.پایان صدا(پرونده۱.داده، پرونده۱.طول)، 64)

    سرچاپ "id3v2 round-trip"
    ناپایا نسخه۲ := برچسب صدا.نوشتن آی‌دی۳ دو(منبع)
    آزمایش.ادعای درستی(برچسب صدا.آی‌دی۳ دو دارد(نسخه۲.داده، نسخه۲.طول))
    آزمایش.ادعای برابری عدد(برچسب صدا.نگارش آی‌دی۳ دو(نسخه۲.داده، نسخه۲.طول)، 4)
    آزمایش.ادعای برابری عدد(برچسب صدا.اندازه آی‌دی۳ دو(نسخه۲.داده، نسخه۲.طول)، فشرده سازی.طول بافر(نسخه۲))
    ناپایا خوانده۲ := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن آی‌دی۳ دو(نسخه۲.داده، نسخه۲.طول، خوانده۲))
    آزمایش.ادعای برابری رشته(خوانده۲.عنوان، "Shiraz Nights")
    آزمایش.ادعای برابری رشته(خوانده۲.هنرمند، "Darya")
    آزمایش.ادعای برابری رشته(خوانده۲.آلبوم، "Zagros")
    آزمایش.ادعای برابری رشته(خوانده۲.هنرمند آلبوم، "Various")
    آزمایش.ادعای برابری رشته(خوانده۲.آهنگساز، "Rahim")
    آزمایش.ادعای برابری رشته(خوانده۲.سبک، "Folk")
    آزمایش.ادعای برابری عدد(خوانده۲.سال، 2026)
    آزمایش.ادعای برابری عدد(خوانده۲.شماره قطعه، 3)
    آزمایش.ادعای برابری عدد(خوانده۲.شمار قطعه‌ها، 12)
    آزمایش.ادعای برابری عدد(خوانده۲.شماره دیسک، 1)
    آزمایش.ادعای برابری عدد(خوانده۲.ضربان، 96)

    سرچاپ "persian text survives utf-8"
    ناپایا فارسی := برچسب صدا.برچسب‌های جدید()
    فارسی.عنوان = رشته.رونوشت("شب‌های شیراز")
    فارسی.هنرمند = رشته.رونوشت("دریا")
    ناپایا نسخه فارسی := برچسب صدا.نوشتن آی‌دی۳ دو(فارسی)
    ناپایا خوانده فارسی := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن آی‌دی۳ دو(نسخه فارسی.داده، نسخه فارسی.طول، خوانده فارسی))
    آزمایش.ادعای برابری رشته(خوانده فارسی.عنوان، "شب‌های شیراز")
    آزمایش.ادعای برابری رشته(خوانده فارسی.هنرمند، "دریا")

    سرچاپ "vorbis comments round-trip"
    ناپایا یادداشت وربیس := برچسب صدا.نوشتن یادداشت وربیس(منبع)
    ناپایا خوانده وربیس := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن یادداشت وربیس(یادداشت وربیس.داده، 0، یادداشت وربیس.طول، خوانده وربیس))
    آزمایش.ادعای برابری رشته(خوانده وربیس.عنوان، "Shiraz Nights")
    آزمایش.ادعای برابری رشته(خوانده وربیس.هنرمند، "Darya")
    آزمایش.ادعای برابری رشته(خوانده وربیس.سبک، "Folk")
    آزمایش.ادعای برابری عدد(خوانده وربیس.سال، 2026)
    آزمایش.ادعای برابری عدد(خوانده وربیس.شماره قطعه، 3)
    آزمایش.ادعای برابری عدد(خوانده وربیس.شمار قطعه‌ها، 12)
    آزمایش.ادعای برابری عدد(خوانده وربیس.ضربان، 96)

    سرچاپ "vorbis comments inside a flac stream"
    ناپایا جریان فلاک := فلاک با یادداشت(یادداشت وربیس)
    آزمایش.ادعای درستی(برچسب صدا.فلاک برچسبدار است(جریان فلاک.داده، جریان فلاک.طول))
    بلوک‌ها := برچسب صدا.بلوک‌های فلاک(جریان فلاک.داده، جریان فلاک.طول)
    آزمایش.ادعای برابری عدد(بلوک‌ها.طول()، 1)
    آزمایش.ادعای برابری عدد(بلوک‌ها.بگیر(0).گونه، برچسب صدا.بلوک یادداشت وربیس)
    آزمایش.ادعای درستی(بلوک‌ها.بگیر(0).آخرین)
    ناپایا خوانده فلاک := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای درستی(برچسب صدا.خواندن برچسب فلاک(جریان فلاک.داده، جریان فلاک.طول، خوانده فلاک))
    آزمایش.ادعای برابری رشته(خوانده فلاک.آلبوم، "Zagros")

    سرچاپ "the dispatcher picks the right reader"
    ناپایا موفق الف := نادرست
    ناپایا خودکار := برچسب صدا.خواندن برچسب‌ها(نسخه۲.داده، نسخه۲.طول، موفق الف)
    آزمایش.ادعای درستی(موفق الف)
    آزمایش.ادعای برابری رشته(خودکار.عنوان، "Shiraz Nights")
    ناپایا موفق ب := نادرست
    ناپایا خودکار فلاک := برچسب صدا.خواندن برچسب‌ها(جریان فلاک.داده، جریان فلاک.طول، موفق ب)
    آزمایش.ادعای درستی(موفق ب)
    آزمایش.ادعای برابری رشته(خودکار فلاک.هنرمند، "Darya")
    ناپایا موفق ج := نادرست
    ناپایا خودکار۱ := برچسب صدا.خواندن برچسب‌ها(پرونده۱.داده، پرونده۱.طول، موفق ج)
    آزمایش.ادعای درستی(موفق ج)
    آزمایش.ادعای برابری رشته(خودکار۱.آلبوم، "Zagros")
    ناپایا موفق د := نادرست
    ناپایا هیچ := برچسب صدا.خواندن برچسب‌ها(یادداشت وربیس.داده، یادداشت وربیس.طول، موفق د)
    آزمایش.ادعای نادرستی(موفق د)
    آزمایش.ادعای نادرستی(برچسب صدا.برچسب دارد(هیچ))

    سرچاپ "stripping tags leaves the audio alone"
    ناپایا کامل := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بافر(کامل، نسخه۲)
    ناپایا بدنه := 0
    تا بدنه کوچکتر 100:
        فشرده سازی.افزودن بایت(کامل، 65 + (بدنه % 26))
        بدنه++
    پایان
    فشرده سازی.افزودن بافر(کامل، نسخه۱)
    آزمایش.ادعای برابری عدد(برچسب صدا.آغاز صدا(کامل.داده، کامل.طول)، فشرده سازی.طول بافر(نسخه۲))
    آزمایش.ادعای برابری عدد(برچسب صدا.پایان صدا(کامل.داده، کامل.طول)، فشرده سازی.طول بافر(کامل) - 128)
    ناپایا برهنه := برچسب صدا.برداشتن برچسب‌ها(کامل.داده، کامل.طول)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(برهنه)، 100)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(برهنه، 0)، 65)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(برهنه، 25)، 90)

    سرچاپ "genre names and empty tags"
    آزمایش.ادعای برابری رشته(برچسب صدا.نام سبک(17)، "Rock")
    آزمایش.ادعای برابری رشته(برچسب صدا.نام سبک(8)، "Jazz")
    آزمایش.ادعای برابری رشته(برچسب صدا.نام سبک(200)، "")
    ناپایا بدون برچسب := برچسب صدا.برچسب‌های جدید()
    آزمایش.ادعای نادرستی(برچسب صدا.برچسب دارد(بدون برچسب))
    ناپایا خالی := برچسب صدا.نوشتن آی‌دی۳ دو(بدون برچسب)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(خالی)، 10)
    آزمایش.ادعای نادرستی(برچسب صدا.خواندن آی‌دی۳ دو(خالی.داده، خالی.طول، بدون برچسب))

    سرچاپ "tags on a file"
    مسیر := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_tag.mp3")
    دیرکن حافظه.آزادسازی(مسیر برگردان تهی*)
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی از بافر(مسیر، کامل))
    ناپایا موفق پرونده := نادرست
    ناپایا از دیسک := برچسب صدا.خواندن برچسب‌های پرونده(مسیر، موفق پرونده)
    آزمایش.ادعای درستی(موفق پرونده)
    آزمایش.ادعای برابری رشته(از دیسک.عنوان، "Shiraz Nights")
    ناپایا حذف شده := نادرست
    ناموجود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_tag_none.mp3")
    دیرکن حافظه.آزادسازی(ناموجود برگردان تهی*)
    برچسب صدا.خواندن برچسب‌های پرونده(ناموجود، حذف شده)
    آزمایش.ادعای نادرستی(حذف شده)

    برچسب صدا.آزادسازی برچسب‌ها(منبع)
    برچسب صدا.آزادسازی برچسب‌ها(خوانده۱)
    برچسب صدا.آزادسازی برچسب‌ها(خوانده۲)
    برچسب صدا.آزادسازی برچسب‌ها(فارسی)
    برچسب صدا.آزادسازی برچسب‌ها(خوانده فارسی)
    برچسب صدا.آزادسازی برچسب‌ها(خوانده وربیس)
    برچسب صدا.آزادسازی برچسب‌ها(خوانده فلاک)
    برچسب صدا.آزادسازی برچسب‌ها(خودکار)
    برچسب صدا.آزادسازی برچسب‌ها(خودکار فلاک)
    برچسب صدا.آزادسازی برچسب‌ها(خودکار۱)
    برچسب صدا.آزادسازی برچسب‌ها(هیچ)
    برچسب صدا.آزادسازی برچسب‌ها(بدون برچسب)
    برچسب صدا.آزادسازی برچسب‌ها(از دیسک)
    فشرده سازی.آزادسازی بافر(نسخه۱)
    فشرده سازی.آزادسازی بافر(نسخه۲)
    فشرده سازی.آزادسازی بافر(نسخه فارسی)
    فشرده سازی.آزادسازی بافر(یادداشت وربیس)
    فشرده سازی.آزادسازی بافر(جریان فلاک)
    فشرده سازی.آزادسازی بافر(پرونده۱)
    فشرده سازی.آزادسازی بافر(کامل)
    فشرده سازی.آزادسازی بافر(برهنه)
    فشرده سازی.آزادسازی بافر(خالی)
    بلوک‌ها.آزادکن()
    برگشت آزمایش.خلاصه()
پایان
