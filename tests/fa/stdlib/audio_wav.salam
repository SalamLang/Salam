بسته ریشه

واردسازی صدا
واردسازی صدا.ویو
واردسازی فشرده سازی
واردسازی کدگذاری.دودویی
واردسازی ریاضی
واردسازی حافظه
واردسازی مسیر پرونده
واردسازی سیستم عامل
واردسازی آزمایش

تابع make_clip(rate: صحیح، channels: صحیح، frames: صحیح، denom: اعشار۶۴، step: صحیح): صدا.قطعه:
    ناپایا c := صدا.جدید(rate، channels، frames)
    ناپایا f := 0
    تا f کوچکتر frames:
        ناپایا ch := 0
        تا ch کوچکتر channels:
            k := ((f * channels + ch) * step) - (frames * channels * step) / 2
            صدا.تنظیم نمونه(c، f، ch، (k برگردان اعشار۶۴) / denom)
            ch += 1
        پایان
        f += 1
    پایان
    برگشت c
پایان

تابع worst_diff(a: صدا.قطعه، b: صدا.قطعه): اعشار۶۴:
    ناپایا worst := 0.0
    ناپایا f := 0
    تا f کوچکتر a.فریم ها:
        ناپایا ch := 0
        تا ch کوچکتر a.کانال ها:
            d := ریاضی.قدرمطلق(صدا.نمونه(b، f، ch) - صدا.نمونه(a، f، ch))
            اگر d بزرگتر worst:
                worst = d
            پایان
            ch += 1
        پایان
        f += 1
    پایان
    برگشت worst
پایان

تابع roundtrip(c: صدا.قطعه، bits: صحیح): اعشار۶۴:
    enc := ویو.کدگذاری ویو با بیت(c، bits)
    ناپایا ok := نادرست
    ناپایا back := ویو.کدگشایی ویو(enc.داده، enc.طول، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای برابری عدد(back.فریم ها، c.فریم ها)
    آزمایش.ادعای برابری عدد(back.کانال ها، c.کانال ها)
    آزمایش.ادعای برابری عدد(back.نرخ، c.نرخ)
    آزمایش.ادعای برابری عدد(back.بیت ها، bits)
    d := worst_diff(c، back)
    فشرده سازی.آزادسازی بافر(enc)
    صدا.آزادسازی(back)
    برگشت d
پایان

تابع build_pcm32(rate: صحیح، vals: وکتور<صحیح>): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    data_bytes := vals.طول() * 4
    فشرده سازی.افزودن بایت(b، 82)
    فشرده سازی.افزودن بایت(b، 73)
    فشرده سازی.افزودن بایت(b، 70)
    فشرده سازی.افزودن بایت(b، 70)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، 36 + data_bytes)
    فشرده سازی.افزودن بایت(b، 87)
    فشرده سازی.افزودن بایت(b، 65)
    فشرده سازی.افزودن بایت(b، 86)
    فشرده سازی.افزودن بایت(b، 69)
    فشرده سازی.افزودن بایت(b، 102)
    فشرده سازی.افزودن بایت(b، 109)
    فشرده سازی.افزودن بایت(b، 116)
    فشرده سازی.افزودن بایت(b، 32)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، 16)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(b، 1)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(b، 1)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، rate)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، rate * 4)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(b، 4)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(b، 32)
    فشرده سازی.افزودن بایت(b، 100)
    فشرده سازی.افزودن بایت(b، 97)
    فشرده سازی.افزودن بایت(b، 116)
    فشرده سازی.افزودن بایت(b، 97)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، data_bytes)
    هر v در vals:
        دودویی.نوشتن صحیح۳۲ کوچک‌انتها(b، v)
    پایان
    برگشت b
پایان

تابع ریشه:
    سرچاپ "detection and headers"
    c16 := make_clip(44100، 2، 64، 32768.0، 501)
    enc := ویو.کدگذاری ویو(c16)
    آزمایش.ادعای درستی(ویو.ویو است(enc.داده، enc.طول))
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(enc.داده، enc.طول)، صدا.قالب ویو)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(enc)، 44 + 64 * 2 * 2)
    ناپایا fmt := ویو.قالب {}
    آزمایش.ادعای درستی(ویو.خواندن قالب(enc.داده، enc.طول، fmt))
    آزمایش.ادعای برابری عدد(fmt.کدک، ویو.کدک پی‌سی‌ام)
    آزمایش.ادعای برابری عدد(fmt.کانال ها، 2)
    آزمایش.ادعای برابری عدد(fmt.نرخ، 44100)
    آزمایش.ادعای برابری عدد(fmt.بیت ها، 16)
    آزمایش.ادعای برابری عدد(fmt.همترازی بلوک، 4)
    آزمایش.ادعای برابری عدد(fmt.نرخ بایت، 44100 * 4)
    آزمایش.ادعای نادرستی(ویو.ویو است(enc.داده، 4))

    سرچاپ "chunk walking"
    chunks := ویو.تکه‌ها(enc.داده، enc.طول)
    آزمایش.ادعای برابری عدد(chunks.طول()، 2)
    ناپایا data_chunk := ویو.تکه {}
    آزمایش.ادعای درستی(ویو.یافتن تکه(enc.داده، enc.طول، ویو.برچسب("data")، data_chunk))
    آزمایش.ادعای برابری عدد(data_chunk.جابجایی، 44)
    آزمایش.ادعای برابری عدد(data_chunk.اندازه، 64 * 2 * 2)
    ناپایا missing := ویو.تکه {}
    آزمایش.ادعای نادرستی(ویو.یافتن تکه(enc.داده، enc.طول، ویو.برچسب("cue ")، missing))

    سرچاپ "probe"
    ناپایا pok := نادرست
    info := ویو.بررسی ویو(enc.داده، enc.طول، pok)
    آزمایش.ادعای درستی(pok)
    آزمایش.ادعای برابری عدد(info.قالب، صدا.قالب ویو)
    آزمایش.ادعای برابری عدد(info.فریم ها، 64)
    آزمایش.ادعای برابری عدد(info.کانال ها، 2)
    آزمایش.ادعای برابری عدد(info.بیت ها، 16)
    آزمایش.ادعای درستی(info.بی اتلاف)
    آزمایش.ادعای برابری عدد(info.نرخ بیت، 44100 * 2 * 16)

    سرچاپ "8, 16 and 24 bit pcm round-trip bit for bit"
    c8 := make_clip(8000، 1، 64، 128.0، 1)
    آزمایش.ادعای برابری اعشار(roundtrip(c8، 8)، 0.0، 0.0)
    آزمایش.ادعای برابری اعشار(roundtrip(c16، 16)، 0.0، 0.0)
    c24 := make_clip(48000، 2، 64، 8388608.0، 131071)
    آزمایش.ادعای برابری اعشار(roundtrip(c24، 24)، 0.0، 0.0)

    سرچاپ "ieee float round-trips bit for bit"
    fenc := ویو.کدگذاری ویو اعشاری(c16)
    ناپایا fok := نادرست
    ناپایا fback := ویو.کدگشایی ویو(fenc.داده، fenc.طول، fok)
    آزمایش.ادعای درستی(fok)
    آزمایش.ادعای برابری عدد(fback.بیت ها، 32)
    آزمایش.ادعای برابری اعشار(worst_diff(c16، fback)، 0.0، 0.0)

    سرچاپ "a real 32 bit source loses its low bits in an f32 clip"
    ناپایا vals := وکتور {} برگردان وکتور<صحیح>
    vals.بیفزا(0x12345678)
    vals.بیفزا(0x7FFFFFFF)
    vals.بیفزا(-0x12345679)
    vals.بیفزا(0x00FFFFFF)
    src32 := build_pcm32(48000، vals)
    ناپایا ok32 := نادرست
    ناپایا got32 := ویو.کدگشایی ویو(src32.داده، src32.طول، ok32)
    آزمایش.ادعای درستی(ok32)
    آزمایش.ادعای برابری عدد(got32.بیت ها، 32)
    re32 := ویو.کدگذاری ویو با بیت(got32، 32)
    ناپایا differs := نادرست
    ناپایا last_survived := درست
    ناپایا bi := 44
    تا bi کوچکتر فشرده سازی.طول بافر(src32):
        اگر فشرده سازی.دریافت بایت(src32، bi) نابرابر فشرده سازی.دریافت بایت(re32، bi):
            differs = درست
            اگر bi بزرگتربرابر 56:
                last_survived = نادرست
            پایان
        پایان
        bi += 1
    پایان
    آزمایش.ادعا با پیام(differs، "a 32 bit source should not survive an f32 clip")
    آزمایش.ادعا با پیام(last_survived، "a 24 bit value in the same file should survive")

    سرچاپ "g711 companding"
    آزمایش.ادعای برابری عدد(صدا.میولا به پی‌سی‌ام(صدا.پی‌سی‌ام به میولا(0))، 0)
    آزمایش.ادعای برابری عدد(صدا.پی‌سی‌ام به میولا(0)، 255)
    آزمایش.ادعای برابری عدد(صدا.پی‌سی‌ام به میولا(16000)، 144)
    آزمایش.ادعای برابری عدد(صدا.میولا به پی‌سی‌ام(144)، 15996)
    آزمایش.ادعای برابری عدد(صدا.پی‌سی‌ام به ای‌لا(16000)، 186)
    آزمایش.ادعای برابری عدد(صدا.ای‌لا به پی‌سی‌ام(186)، 16128)
    ناپایا mu := 0
    ناپایا al := 0
    ناپایا near_mu := 0
    ناپایا near_al := 0
    ناپایا v := -32768
    تا v کوچکتر 32768:
        dm := ریاضی.قدرمطلق صحیح(صدا.میولا به پی‌سی‌ام(صدا.پی‌سی‌ام به میولا(v)) - v)
        da := ریاضی.قدرمطلق صحیح(صدا.ای‌لا به پی‌سی‌ام(صدا.پی‌سی‌ام به ای‌لا(v)) - v)
        اگر dm بزرگتر mu:
            mu = dm
        پایان
        اگر da بزرگتر al:
            al = da
        پایان
        اگر ریاضی.قدرمطلق صحیح(v) کوچکتربرابر 256:
            اگر dm بزرگتر near_mu:
                near_mu = dm
            پایان
            اگر da بزرگتر near_al:
                near_al = da
            پایان
        پایان
        v += 7
    پایان
    آزمایش.ادعا با پیام(mu کوچکتربرابر 820، "mu-law error should stay under 2.5 percent of full scale")
    آزمایش.ادعا با پیام(al کوچکتربرابر 820، "a-law error should stay under 2.5 percent of full scale")
    آزمایش.ادعا با پیام(near_mu کوچکتربرابر 12، "mu-law should be fine grained near silence")
    آزمایش.ادعا با پیام(near_al کوچکتربرابر 8، "a-law should be fine grained near silence")

    سرچاپ "companded files decode through the normal path"
    menc := ویو.کدگذاری میولا(c16)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(menc)، 44 + 64 * 2)
    ناپایا mok := نادرست
    ناپایا mback := ویو.کدگشایی ویو(menc.داده، menc.طول، mok)
    آزمایش.ادعای درستی(mok)
    آزمایش.ادعای برابری عدد(mback.فریم ها، 64)
    آزمایش.ادعا با پیام(worst_diff(c16، mback) کوچکتر 0.05، "mu-law should stay close")
    aenc := ویو.کدگذاری ای‌لا(c16)
    ناپایا aok := نادرست
    ناپایا aback := ویو.کدگشایی ویو(aenc.داده، aenc.طول، aok)
    آزمایش.ادعای درستی(aok)
    آزمایش.ادعا با پیام(worst_diff(c16، aback) کوچکتر 0.05، "a-law should stay close")

    سرچاپ "files on disk"
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_wav_test.wav")
    دیرکن حافظه.آزادسازی(path برگردان تهی*)
    آزمایش.ادعای درستی(ویو.ذخیره ویو با بیت(c24، path، 24))
    ناپایا dok := نادرست
    ناپایا disk := ویو.بازکردن ویو(path، dok)
    آزمایش.ادعای درستی(dok)
    آزمایش.ادعای برابری عدد(disk.بیت ها، 24)
    آزمایش.ادعای برابری اعشار(worst_diff(c24، disk)، 0.0، 0.0)
    ناپایا iok := نادرست
    disk_info := ویو.بررسی پرونده ویو(path، iok)
    آزمایش.ادعای درستی(iok)
    آزمایش.ادعای برابری عدد(disk_info.فریم ها، 64)
    ناپایا bad := نادرست
    gone := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_missing.wav")
    دیرکن حافظه.آزادسازی(gone برگردان تهی*)
    ویو.بازکردن ویو(gone، bad)
    آزمایش.ادعای نادرستی(bad)

    سرچاپ "refusals"
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ویو.کدگذاری ویو با بیت(c16، 12))، 0)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ویو.کدگذاری ویو(صدا.قطعه {}))، 0)

    فشرده سازی.آزادسازی بافر(enc)
    فشرده سازی.آزادسازی بافر(fenc)
    فشرده سازی.آزادسازی بافر(src32)
    فشرده سازی.آزادسازی بافر(re32)
    فشرده سازی.آزادسازی بافر(menc)
    فشرده سازی.آزادسازی بافر(aenc)
    صدا.آزادسازی(fback)
    صدا.آزادسازی(got32)
    صدا.آزادسازی(mback)
    صدا.آزادسازی(aback)
    صدا.آزادسازی(disk)
    برگشت آزمایش.خلاصه()
پایان
