بسته ریشه

واردسازی صدا
واردسازی صدا.ویو
واردسازی فشرده سازی
واردسازی کدگذاری.دودویی
واردسازی ریاضی
واردسازی حافظه
واردسازی مسیر پرونده
واردسازی سیستم عامل
واردسازی آزمایش

تابع ساخت قطعه(نرخ: صحیح، تعداد کانال: صحیح، تعداد فریم: صحیح، مخرج: اعشار۶۴، گام: صحیح): صدا.قطعه:
    ناپایا c := صدا.جدید(نرخ، تعداد کانال، تعداد فریم)
    ناپایا f := 0
    تا f کوچکتر تعداد فریم:
        ناپایا کانال := 0
        تا کانال کوچکتر تعداد کانال:
            k := ((f * تعداد کانال + کانال) * گام) - (تعداد فریم * تعداد کانال * گام) / 2
            صدا.تنظیم نمونه(c، f، کانال، (k برگردان اعشار۶۴) / مخرج)
            کانال += 1
        پایان
        f += 1
    پایان
    برگشت c
پایان

تابع اختلاف بیشینه(a: صدا.قطعه، b: صدا.قطعه): اعشار۶۴:
    ناپایا بیشینه := 0.0
    ناپایا f := 0
    تا f کوچکتر a.فریم ها:
        ناپایا کانال := 0
        تا کانال کوچکتر a.کانال ها:
            d := ریاضی.قدرمطلق(صدا.نمونه(b، f، کانال) - صدا.نمونه(a، f، کانال))
            اگر d بزرگتر بیشینه:
                بیشینه = d
            پایان
            کانال += 1
        پایان
        f += 1
    پایان
    برگشت بیشینه
پایان

تابع آزمون چرخشی(c: صدا.قطعه، تعداد بیت: صحیح): اعشار۶۴:
    ناپایا کدگذاری شده := ویو.کدگذاری ویو با بیت(c، تعداد بیت)
    ناپایا موفق := نادرست
    ناپایا بازخوانی := ویو.کدگشایی ویو(کدگذاری شده.داده، کدگذاری شده.طول، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای برابری عدد(بازخوانی.فریم ها، c.فریم ها)
    آزمایش.ادعای برابری عدد(بازخوانی.کانال ها، c.کانال ها)
    آزمایش.ادعای برابری عدد(بازخوانی.نرخ، c.نرخ)
    آزمایش.ادعای برابری عدد(بازخوانی.بیت ها، تعداد بیت)
    d := اختلاف بیشینه(c، بازخوانی)
    فشرده سازی.آزادسازی بافر(کدگذاری شده)
    صدا.آزادسازی(بازخوانی)
    برگشت d
پایان

تابع ساخت پی‌سی‌ام۳۲(نرخ: صحیح، مقادیر: وکتور<صحیح>): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    بایت‌های داده := مقادیر.طول() * 4
    فشرده سازی.افزودن بایت(b، 82)
    فشرده سازی.افزودن بایت(b، 73)
    فشرده سازی.افزودن بایت(b، 70)
    فشرده سازی.افزودن بایت(b، 70)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، 36 + بایت‌های داده)
    فشرده سازی.افزودن بایت(b، 87)
    فشرده سازی.افزودن بایت(b، 65)
    فشرده سازی.افزودن بایت(b، 86)
    فشرده سازی.افزودن بایت(b، 69)
    فشرده سازی.افزودن بایت(b، 102)
    فشرده سازی.افزودن بایت(b، 109)
    فشرده سازی.افزودن بایت(b، 116)
    فشرده سازی.افزودن بایت(b، 32)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، 16)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(b، 1)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(b، 1)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، نرخ)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، نرخ * 4)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(b، 4)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(b، 32)
    فشرده سازی.افزودن بایت(b، 100)
    فشرده سازی.افزودن بایت(b، 97)
    فشرده سازی.افزودن بایت(b، 116)
    فشرده سازی.افزودن بایت(b، 97)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(b، بایت‌های داده)
    هر v در مقادیر:
        دودویی.نوشتن صحیح۳۲ کوچک‌انتها(b، v)
    پایان
    برگشت b
پایان

تابع ریشه:
    سرچاپ "detection and headers"
    قطعه۱۶ := ساخت قطعه(44100، 2، 64، 32768.0، 501)
    ناپایا کدگذاری شده := ویو.کدگذاری ویو(قطعه۱۶)
    آزمایش.ادعای درستی(ویو.ویو است(کدگذاری شده.داده، کدگذاری شده.طول))
    آزمایش.ادعای برابری عدد(صدا.شناسایی قالب(کدگذاری شده.داده، کدگذاری شده.طول)، صدا.قالب ویو)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(کدگذاری شده)، 44 + 64 * 2 * 2)
    ناپایا قالب فایل := ویو.قالب {}
    آزمایش.ادعای درستی(ویو.خواندن قالب(کدگذاری شده.داده، کدگذاری شده.طول، قالب فایل))
    آزمایش.ادعای برابری عدد(قالب فایل.کدک، ویو.کدک پی‌سی‌ام)
    آزمایش.ادعای برابری عدد(قالب فایل.کانال ها، 2)
    آزمایش.ادعای برابری عدد(قالب فایل.نرخ، 44100)
    آزمایش.ادعای برابری عدد(قالب فایل.بیت ها، 16)
    آزمایش.ادعای برابری عدد(قالب فایل.همترازی بلوک، 4)
    آزمایش.ادعای برابری عدد(قالب فایل.نرخ بایت، 44100 * 4)
    آزمایش.ادعای نادرستی(ویو.ویو است(کدگذاری شده.داده، 4))

    سرچاپ "chunk walking"
    تکه‌ها := ویو.تکه‌ها(کدگذاری شده.داده، کدگذاری شده.طول)
    آزمایش.ادعای برابری عدد(تکه‌ها.طول()، 2)
    ناپایا تکه داده := ویو.تکه {}
    آزمایش.ادعای درستی(ویو.یافتن تکه(کدگذاری شده.داده، کدگذاری شده.طول، ویو.برچسب("data")، تکه داده))
    آزمایش.ادعای برابری عدد(تکه داده.جابجایی، 44)
    آزمایش.ادعای برابری عدد(تکه داده.اندازه، 64 * 2 * 2)
    ناپایا ناموجود := ویو.تکه {}
    آزمایش.ادعای نادرستی(ویو.یافتن تکه(کدگذاری شده.داده، کدگذاری شده.طول، ویو.برچسب("cue ")، ناموجود))

    سرچاپ "probe"
    ناپایا بررسی موفق := نادرست
    اطلاعات := ویو.بررسی ویو(کدگذاری شده.داده، کدگذاری شده.طول، بررسی موفق)
    آزمایش.ادعای درستی(بررسی موفق)
    آزمایش.ادعای برابری عدد(اطلاعات.قالب، صدا.قالب ویو)
    آزمایش.ادعای برابری عدد(اطلاعات.فریم ها، 64)
    آزمایش.ادعای برابری عدد(اطلاعات.کانال ها، 2)
    آزمایش.ادعای برابری عدد(اطلاعات.بیت ها، 16)
    آزمایش.ادعای درستی(اطلاعات.بی اتلاف)
    آزمایش.ادعای برابری عدد(اطلاعات.نرخ بیت، 44100 * 2 * 16)

    سرچاپ "8, 16 and 24 bit pcm round-trip bit for bit"
    قطعه۸ := ساخت قطعه(8000، 1، 64، 128.0، 1)
    آزمایش.ادعای برابری اعشار(آزمون چرخشی(قطعه۸، 8)، 0.0، 0.0)
    آزمایش.ادعای برابری اعشار(آزمون چرخشی(قطعه۱۶، 16)، 0.0، 0.0)
    قطعه۲۴ := ساخت قطعه(48000، 2، 64، 8388608.0، 131071)
    آزمایش.ادعای برابری اعشار(آزمون چرخشی(قطعه۲۴، 24)، 0.0، 0.0)

    سرچاپ "ieee float round-trips bit for bit"
    ناپایا کدگذاری اعشاری := ویو.کدگذاری ویو اعشاری(قطعه۱۶)
    ناپایا موفق اعشاری := نادرست
    ناپایا بازخوانی اعشاری := ویو.کدگشایی ویو(کدگذاری اعشاری.داده، کدگذاری اعشاری.طول، موفق اعشاری)
    آزمایش.ادعای درستی(موفق اعشاری)
    آزمایش.ادعای برابری عدد(بازخوانی اعشاری.بیت ها، 32)
    آزمایش.ادعای برابری اعشار(اختلاف بیشینه(قطعه۱۶، بازخوانی اعشاری)، 0.0، 0.0)

    سرچاپ "a real 32 bit source loses its low bits in an f32 clip"
    ناپایا مقادیر := وکتور {} برگردان وکتور<صحیح>
    مقادیر.بیفزا(0x12345678)
    مقادیر.بیفزا(0x7FFFFFFF)
    مقادیر.بیفزا(-0x12345679)
    مقادیر.بیفزا(0x00FFFFFF)
    ناپایا منبع۳۲ := ساخت پی‌سی‌ام۳۲(48000، مقادیر)
    ناپایا موفق۳۲ := نادرست
    ناپایا خوانده۳۲ := ویو.کدگشایی ویو(منبع۳۲.داده، منبع۳۲.طول، موفق۳۲)
    آزمایش.ادعای درستی(موفق۳۲)
    آزمایش.ادعای برابری عدد(خوانده۳۲.بیت ها، 32)
    ناپایا بازکدگذاری۳۲ := ویو.کدگذاری ویو با بیت(خوانده۳۲، 32)
    ناپایا متفاوت := نادرست
    ناپایا آخرین سالم := درست
    ناپایا شاخص بایت := 44
    تا شاخص بایت کوچکتر فشرده سازی.طول بافر(منبع۳۲):
        اگر فشرده سازی.دریافت بایت(منبع۳۲، شاخص بایت) نابرابر فشرده سازی.دریافت بایت(بازکدگذاری۳۲، شاخص بایت):
            متفاوت = درست
            اگر شاخص بایت بزرگتربرابر 56:
                آخرین سالم = نادرست
            پایان
        پایان
        شاخص بایت += 1
    پایان
    آزمایش.ادعا با پیام(متفاوت، "a 32 bit source should not survive an f32 clip")
    آزمایش.ادعا با پیام(آخرین سالم، "a 24 bit value in the same file should survive")

    سرچاپ "g711 companding"
    آزمایش.ادعای برابری عدد(صدا.میولا به پی‌سی‌ام(صدا.پی‌سی‌ام به میولا(0))، 0)
    آزمایش.ادعای برابری عدد(صدا.پی‌سی‌ام به میولا(0)، 255)
    آزمایش.ادعای برابری عدد(صدا.پی‌سی‌ام به میولا(16000)، 144)
    آزمایش.ادعای برابری عدد(صدا.میولا به پی‌سی‌ام(144)، 15996)
    آزمایش.ادعای برابری عدد(صدا.پی‌سی‌ام به ای‌لا(16000)، 186)
    آزمایش.ادعای برابری عدد(صدا.ای‌لا به پی‌سی‌ام(186)، 16128)
    ناپایا میولا := 0
    ناپایا ای‌لا := 0
    ناپایا نزدیک میولا := 0
    ناپایا نزدیک ای‌لا := 0
    ناپایا v := -32768
    تا v کوچکتر 32768:
        اختلاف میولا := ریاضی.قدرمطلق صحیح(صدا.میولا به پی‌سی‌ام(صدا.پی‌سی‌ام به میولا(v)) - v)
        اختلاف ای‌لا := ریاضی.قدرمطلق صحیح(صدا.ای‌لا به پی‌سی‌ام(صدا.پی‌سی‌ام به ای‌لا(v)) - v)
        اگر اختلاف میولا بزرگتر میولا:
            میولا = اختلاف میولا
        پایان
        اگر اختلاف ای‌لا بزرگتر ای‌لا:
            ای‌لا = اختلاف ای‌لا
        پایان
        اگر ریاضی.قدرمطلق صحیح(v) کوچکتربرابر 256:
            اگر اختلاف میولا بزرگتر نزدیک میولا:
                نزدیک میولا = اختلاف میولا
            پایان
            اگر اختلاف ای‌لا بزرگتر نزدیک ای‌لا:
                نزدیک ای‌لا = اختلاف ای‌لا
            پایان
        پایان
        v += 7
    پایان
    آزمایش.ادعا با پیام(میولا کوچکتربرابر 820، "mu-law error should stay under 2.5 percent of full scale")
    آزمایش.ادعا با پیام(ای‌لا کوچکتربرابر 820، "a-law error should stay under 2.5 percent of full scale")
    آزمایش.ادعا با پیام(نزدیک میولا کوچکتربرابر 12، "mu-law should be fine grained near silence")
    آزمایش.ادعا با پیام(نزدیک ای‌لا کوچکتربرابر 8، "a-law should be fine grained near silence")

    سرچاپ "companded files decode through the normal path"
    ناپایا کدگذاری میولا := ویو.کدگذاری میولا(قطعه۱۶)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(کدگذاری میولا)، 44 + 64 * 2)
    ناپایا موفق میولا := نادرست
    ناپایا بازخوانی میولا := ویو.کدگشایی ویو(کدگذاری میولا.داده، کدگذاری میولا.طول، موفق میولا)
    آزمایش.ادعای درستی(موفق میولا)
    آزمایش.ادعای برابری عدد(بازخوانی میولا.فریم ها، 64)
    آزمایش.ادعا با پیام(اختلاف بیشینه(قطعه۱۶، بازخوانی میولا) کوچکتر 0.05، "mu-law should stay close")
    ناپایا کدگذاری ای‌لا := ویو.کدگذاری ای‌لا(قطعه۱۶)
    ناپایا موفق ای‌لا := نادرست
    ناپایا بازخوانی ای‌لا := ویو.کدگشایی ویو(کدگذاری ای‌لا.داده، کدگذاری ای‌لا.طول، موفق ای‌لا)
    آزمایش.ادعای درستی(موفق ای‌لا)
    آزمایش.ادعا با پیام(اختلاف بیشینه(قطعه۱۶، بازخوانی ای‌لا) کوچکتر 0.05، "a-law should stay close")

    سرچاپ "files on disk"
    مسیر := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_wav_test.wav")
    دیرکن حافظه.آزادسازی(مسیر برگردان تهی*)
    آزمایش.ادعای درستی(ویو.ذخیره ویو با بیت(قطعه۲۴، مسیر، 24))
    ناپایا موفق دیسک := نادرست
    ناپایا دیسک := ویو.بازکردن ویو(مسیر، موفق دیسک)
    آزمایش.ادعای درستی(موفق دیسک)
    آزمایش.ادعای برابری عدد(دیسک.بیت ها، 24)
    آزمایش.ادعای برابری اعشار(اختلاف بیشینه(قطعه۲۴، دیسک)، 0.0، 0.0)
    ناپایا موفق بررسی := نادرست
    اطلاعات دیسک := ویو.بررسی پرونده ویو(مسیر، موفق بررسی)
    آزمایش.ادعای درستی(موفق بررسی)
    آزمایش.ادعای برابری عدد(اطلاعات دیسک.فریم ها، 64)
    ناپایا خطا := نادرست
    مسیر ناموجود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_audio_missing.wav")
    دیرکن حافظه.آزادسازی(مسیر ناموجود برگردان تهی*)
    ویو.بازکردن ویو(مسیر ناموجود، خطا)
    آزمایش.ادعای نادرستی(خطا)

    سرچاپ "refusals"
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ویو.کدگذاری ویو با بیت(قطعه۱۶، 12))، 0)
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(ویو.کدگذاری ویو(صدا.قطعه {}))، 0)

    فشرده سازی.آزادسازی بافر(کدگذاری شده)
    فشرده سازی.آزادسازی بافر(کدگذاری اعشاری)
    فشرده سازی.آزادسازی بافر(منبع۳۲)
    فشرده سازی.آزادسازی بافر(بازکدگذاری۳۲)
    فشرده سازی.آزادسازی بافر(کدگذاری میولا)
    فشرده سازی.آزادسازی بافر(کدگذاری ای‌لا)
    صدا.آزادسازی(بازخوانی اعشاری)
    صدا.آزادسازی(خوانده۳۲)
    صدا.آزادسازی(بازخوانی میولا)
    صدا.آزادسازی(بازخوانی ای‌لا)
    صدا.آزادسازی(دیسک)
    برگشت آزمایش.خلاصه()
پایان
