تابع test_multipart():
    c := cfg()
    arm(xml_ok("<InitiateMultipartUploadResult><Bucket>bkt</Bucket><Key>big.bin</Key><UploadId>U1</UploadId></InitiateMultipartUploadResult>"))
    ناپایا u := ای دبلیو اس.اس۳ آغاز بارگذاری(c، "big.bin"، ای دبلیو اس.گزینه‌های نوشتن { نوع محتوا = "application/octet-stream" })
