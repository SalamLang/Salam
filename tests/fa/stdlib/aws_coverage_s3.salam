پایا PORT := 19931
پایا ACCESS_KEY := "AKIAIOSFODNN7EXAMPLE"
پایا SECRET_KEY := "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"

ناپایا wg := همگام سازی.گروه انتظار جدید()
ناپایا replies := وکتور {} برگردان وکتور<رشته>
ناپایا reply_at := 0
ناپایا lines := وکتور {} برگردان وکتور<رشته>
ناپایا heads := وکتور {} برگردان وکتور<رشته>
ناپایا bodies := وکتور {} برگردان وکتور<رشته>

تابع at(p: تهی*، off: صحیح): تهی*:
    برگشت ((p برگردان صحیح۶۴) + (off برگردان صحیح۶۴)) برگردان تهی*
پایان

تابع byte_at(p: تهی*، i: صحیح): صحیح:
    bp := p برگردان طبیعی۸*
    برگشت bp[i] برگردان صحیح
پایان

تابع to_str(p: تهی*، n: صحیح): رشته:
    ناپایا sb := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(sb)
    تکرار n در i:
        رشته.افزودن نویسه به بافر(sb، byte_at(p، i))
    پایان
    برگشت رشته.رشته بافر(sb)
پایان

تابع hdr_get(head: رشته، name: رشته): رشته:
    lower := head.کوچک()
    needle := "\r\n" + name.کوچک() + ":"
    found := lower.بیاب(needle)
    اگر found کوچکتر 0: برگشت "" پایان
    start := found + needle.طول()
    ناپایا stop := رشته.اندیس از(head، "\r\n"، start)
    اگر stop کوچکتر 0: stop = head.طول() پایان
    برگشت head.زیررشته(start، stop - start).پیراست()
پایان

تابع read_request(c: تی سی پی.اتصال شبکه، head &: رشته، body &: رشته): منطقی:
    cap := 65536
    buf := حافظه.تخصیص(cap برگردان طبیعی۶۴)
    اگر buf برابر پوچ: برگشت نادرست پایان
    دیرکن حافظه.آزادسازی(buf)
    ناپایا have := 0
    ناپایا head_end := 0 - 1
    تا head_end کوچکتر 0 و have کوچکتر cap:
        got := تی سی پی.خواندن بایت(c، at(buf، have)، cap - have)
        اگر got کوچکتربرابر 0: بشکن پایان
        have += got
        ناپایا i := 0
        تا i + 3 کوچکتر have و head_end کوچکتر 0:
            اگر byte_at(buf، i) برابر 13 و byte_at(buf، i + 1) برابر 10 و byte_at(buf، i + 2) برابر 13 و byte_at(buf، i + 3) برابر 10:
                head_end = i + 4
            پایان
            i += 1
        پایان
    پایان
    اگر head_end کوچکتر 0: برگشت نادرست پایان
    head = to_str(buf، head_end)
    cl := hdr_get(head، "Content-Length")
    ناپایا want := 0
    اگر cl.طول() بزرگتر 0: want = cl.به صحیح() پایان
    ناپایا kept := have - head_end
    اگر kept بزرگتر 4096: kept = 4096 پایان
    body = to_str(at(buf، head_end)، kept)
    ناپایا seen := have - head_end
    تا seen کوچکتر want:
        got := تی سی پی.خواندن بایت(c، buf، cap)
        اگر got کوچکتربرابر 0: بشکن پایان
        اگر body.طول() کوچکتر 4096:
            ناپایا more := got
            اگر body.طول() + more بزرگتر 4096: more = 4096 - body.طول() پایان
            body = body + to_str(buf، more)
        پایان
        seen += got
    پایان
    برگشت درست
پایان

تابع http(status: صحیح، extra: رشته، body: رشته): رشته:
    برگشت "HTTP/1.1 " + status + " X\r\n" + extra + "Content-Length: " + body.طول() + "\r\nConnection: close\r\n\r\n" + body
پایان

تابع http_head(status: صحیح، extra: رشته، claimed: صحیح): رشته:
    برگشت "HTTP/1.1 " + status + " X\r\n" + extra + "Content-Length: " + claimed + "\r\nConnection: close\r\n\r\n"
پایان

تابع xml_ok(body: رشته): رشته:
    برگشت http(200، "Content-Type: application/xml\r\n"، body)
پایان

تابع arm(reply: رشته):
    replies.بیفزا(reply)
پایان

تابع serve():
    srv := تی سی پی.پیوند(PORT)
    همگام سازی.اتمام(wg)
    ناپایا running := درست
    تا running:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            running = نادرست
        وگرنه:
            ناپایا head := ""
            ناپایا body := ""
            اگر read_request(c، head، body):
                sp := head.بیاب(" ")
                sp2 := رشته.اندیس از(head، " "، sp + 1)
                line := head.زیررشته(0، sp2)
                lines.بیفزا(line)
                heads.بیفزا(head)
                bodies.بیفزا(body)
                اگر line.بیاب("/__stop") بزرگتربرابر 0:
                    running = نادرست
                    تی سی پی.نوشتن(c، http(204، ""، ""))
                وگرنه:
                    ناپایا reply := http(200، ""، "")
                    اگر reply_at کوچکتر replies.طول():
                        reply = replies.بگیر(reply_at)
                        reply_at += 1
                    پایان
                    تی سی پی.نوشتن(c، reply)
                پایان
            پایان
            تی سی پی.بستن(c)
        پایان
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع last_line(): رشته:
    اگر lines.طول() برابر 0: برگشت "" پایان
    برگشت lines.بگیر(lines.طول() - 1)
پایان

تابع last_head(): رشته:
    اگر heads.طول() برابر 0: برگشت "" پایان
    برگشت heads.بگیر(heads.طول() - 1)
پایان

تابع last_body(): رشته:
    اگر bodies.طول() برابر 0: برگشت "" پایان
    برگشت bodies.بگیر(bodies.طول() - 1)
پایان

تابع has_header(name: رشته، value: رشته): منطقی:
    برگشت hdr_get(last_head()، name) برابر value
پایان

تابع drained(): منطقی:
    برگشت reply_at برابر replies.طول()
پایان

تابع cfg(): ای دبلیو اس.پیکربندی:
    برگشت ای دبلیو اس.پیکربندی {
        نقطه پایانی = "http://127.0.0.1:19931"، سطل = "bkt"، کلید دسترسی = ACCESS_KEY، کلید رمز = SECRET_KEY،
        شمار کوشش = 1
    }
پایان

