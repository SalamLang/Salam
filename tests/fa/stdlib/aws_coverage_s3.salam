ناپایا گروه انتظار := همگام سازی.گروه انتظار جدید()
ناپایا پاسخ‌ها := وکتور {} برگردان وکتور<رشته>
ناپایا شاخص پاسخ := 0
ناپایا خط‌ها := وکتور {} برگردان وکتور<رشته>
ناپایا سرآیندها := وکتور {} برگردان وکتور<رشته>
ناپایا بدنه‌ها := وکتور {} برگردان وکتور<رشته>

تابع جابجایی اشاره‌گر(اشاره‌گر: تهی*، فاصله: صحیح): تهی*:
    برگشت ((اشاره‌گر برگردان صحیح۶۴) + (فاصله برگردان صحیح۶۴)) برگردان تهی*
پایان

تابع بایت موقعیت(اشاره‌گر: تهی*، i: صحیح): صحیح:
    بایت‌ها := اشاره‌گر برگردان طبیعی۸*
    برگشت بایت‌ها[i] برگردان صحیح
پایان

تابع به رشته(اشاره‌گر: تهی*، n: صحیح): رشته:
    ناپایا سازنده := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(سازنده)
    تکرار n در i:
        رشته.افزودن نویسه به بافر(سازنده، بایت موقعیت(اشاره‌گر، i))
    پایان
    برگشت رشته.رشته بافر(سازنده)
پایان

تابع مقدار سرآیند(سرآیند: رشته، نام: رشته): رشته:
    حروف کوچک := سرآیند.کوچک()
    الگو := "\r\n" + نام.کوچک() + ":"
    یافته := حروف کوچک.بیاب(الگو)
    اگر یافته کوچکتر 0: برگشت "" پایان
    آغاز := یافته + الگو.طول()
    ناپایا انتها := رشته.اندیس از(سرآیند، "\r\n"، آغاز)
    اگر انتها کوچکتر 0: انتها = سرآیند.طول() پایان
    برگشت سرآیند.زیررشته(آغاز، انتها - آغاز).پیراست()
پایان

تابع خواندن درخواست(c: تی سی پی.اتصال شبکه، سرآیند &: رشته، بدنه &: رشته): منطقی:
    ظرفیت := 65536
    بافر := حافظه.تخصیص(ظرفیت برگردان طبیعی۶۴)
    اگر بافر برابر پوچ: برگشت نادرست پایان
    دیرکن حافظه.آزادسازی(بافر)
    ناپایا خوانده شده := 0
    ناپایا انتهای سرآیند := 0 - 1
    تا انتهای سرآیند کوچکتر 0 و خوانده شده کوچکتر ظرفیت:
        دریافتی := تی سی پی.خواندن بایت(c، جابجایی اشاره‌گر(بافر، خوانده شده)، ظرفیت - خوانده شده)
        اگر دریافتی کوچکتربرابر 0: بشکن پایان
        خوانده شده += دریافتی
        ناپایا i := 0
        تا i + 3 کوچکتر خوانده شده و انتهای سرآیند کوچکتر 0:
            اگر بایت موقعیت(بافر، i) برابر 13 و بایت موقعیت(بافر، i + 1) برابر 10 و بایت موقعیت(بافر، i + 2) برابر 13 و بایت موقعیت(بافر، i + 3) برابر 10:
                انتهای سرآیند = i + 4
            پایان
            i += 1
        پایان
    پایان
    اگر انتهای سرآیند کوچکتر 0: برگشت نادرست پایان
    سرآیند = به رشته(بافر، انتهای سرآیند)
    طول محتوا := مقدار سرآیند(سرآیند، "Content-Length")
    ناپایا مورد انتظار := 0
    اگر طول محتوا.طول() بزرگتر 0: مورد انتظار = طول محتوا.به صحیح() پایان
    ناپایا نگهداری شده := خوانده شده - انتهای سرآیند
    اگر نگهداری شده بزرگتر 4096: نگهداری شده = 4096 پایان
    بدنه = به رشته(جابجایی اشاره‌گر(بافر، انتهای سرآیند)، نگهداری شده)
    ناپایا دیده شده := خوانده شده - انتهای سرآیند
    تا دیده شده کوچکتر مورد انتظار:
        دریافتی := تی سی پی.خواندن بایت(c، بافر، ظرفیت)
        اگر دریافتی کوچکتربرابر 0: بشکن پایان
        اگر بدنه.طول() کوچکتر 4096:
            ناپایا بیشتر := دریافتی
            اگر بدنه.طول() + بیشتر بزرگتر 4096: بیشتر = 4096 - بدنه.طول() پایان
            بدنه = بدنه + به رشته(بافر، بیشتر)
        پایان
        دیده شده += دریافتی
    پایان
    برگشت درست
پایان

تابع پاسخ اچ‌تی‌تی‌پی(وضعیت: صحیح، سرآیند اضافه: رشته، بدنه: رشته): رشته:
    برگشت "HTTP/1.1 " + وضعیت + " X\r\n" + سرآیند اضافه + "Content-Length: " + بدنه.طول() + "\r\nConnection: close\r\n\r\n" + بدنه
پایان

تابع سرآیند اچ‌تی‌تی‌پی(وضعیت: صحیح، سرآیند اضافه: رشته، ادعا شده: صحیح): رشته:
    برگشت "HTTP/1.1 " + وضعیت + " X\r\n" + سرآیند اضافه + "Content-Length: " + ادعا شده + "\r\nConnection: close\r\n\r\n"
پایان

تابع پاسخ اکس‌ام‌ال(بدنه: رشته): رشته:
    برگشت پاسخ اچ‌تی‌تی‌پی(200، "Content-Type: application/xml\r\n"، بدنه)
پایان

تابع ثبت پاسخ(پاسخ: رشته):
    پاسخ‌ها.بیفزا(پاسخ)
پایان

تابع خدمت():
    کارگزار := تی سی پی.پیوند(PORT)
    همگام سازی.اتمام(گروه انتظار)
    ناپایا فعال := درست
    تا فعال:
        c := تی سی پی.پذیرش(کارگزار)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            فعال = نادرست
        وگرنه:
            ناپایا سرآیند := ""
            ناپایا بدنه := ""
            اگر خواندن درخواست(c، سرآیند، بدنه):
                فاصله اول := سرآیند.بیاب(" ")
                فاصله دوم := رشته.اندیس از(سرآیند، " "، فاصله اول + 1)
                خط := سرآیند.زیررشته(0، فاصله دوم)
                خط‌ها.بیفزا(خط)
                سرآیندها.بیفزا(سرآیند)
                بدنه‌ها.بیفزا(بدنه)
                اگر خط.بیاب("/__stop") بزرگتربرابر 0:
                    فعال = نادرست
                    تی سی پی.نوشتن(c، پاسخ اچ‌تی‌تی‌پی(204، ""، ""))
                وگرنه:
                    ناپایا پاسخ := پاسخ اچ‌تی‌تی‌پی(200، ""، "")
                    اگر شاخص پاسخ کوچکتر پاسخ‌ها.طول():
                        پاسخ = پاسخ‌ها.بگیر(شاخص پاسخ)
                        شاخص پاسخ += 1
                    پایان
                    تی سی پی.نوشتن(c، پاسخ)
                پایان
            پایان
            تی سی پی.بستن(c)
        پایان
    پایان
    تی سی پی.بستن سرور(کارگزار)
پایان

تابع آخرین خط(): رشته:
    اگر خط‌ها.طول() برابر 0: برگشت "" پایان
    برگشت خط‌ها.بگیر(خط‌ها.طول() - 1)
پایان

تابع آخرین سرآیند(): رشته:
    اگر سرآیندها.طول() برابر 0: برگشت "" پایان
    برگشت سرآیندها.بگیر(سرآیندها.طول() - 1)
پایان

تابع آخرین بدنه(): رشته:
    اگر بدنه‌ها.طول() برابر 0: برگشت "" پایان
    برگشت بدنه‌ها.بگیر(بدنه‌ها.طول() - 1)
پایان

تابع سرآیند دارد(نام: رشته، مقدار: رشته): منطقی:
    برگشت مقدار سرآیند(آخرین سرآیند()، نام) برابر مقدار
پایان

تابع تخلیه شده(): منطقی:
    برگشت شاخص پاسخ برابر پاسخ‌ها.طول()
پایان

تابع پیکربندی آزمون(): ای دبلیو اس.پیکربندی:
