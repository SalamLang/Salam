    آزمایش.ادعای برابری عدد۶۴(ای دبلیو اس.بایت‌های بارگذاری(u)، 103 برگردان صحیح۶۴)
    bad_number := ای دبلیو اس.اس۳ بارگذاری بخش(c، u، 0، one برگردان تهی*، 1)
    آزمایش.ادعای نادرستی(bad_number.موفق)

    arm(xml_ok("<CompleteMultipartUploadResult><ETag>\"final-3\"</ETag></CompleteMultipartUploadResult>"))
    done := ای دبلیو اس.اس۳ تکمیل بارگذاری(c، u)
    آزمایش.ادعای درستی(done.موفق)
    آزمایش.ادعای برابری رشته(done.ای تگ، "final-3")
    آزمایش.ادعای برابری رشته(last_line()، "POST /bkt/big.bin?uploadId=U1")
    sorted := last_body().بیاب("<PartNumber>1</PartNumber>") کوچکتر last_body().بیاب("<PartNumber>2</PartNumber>")
    آزمایش.ادعای درستی(sorted)
    آزمایش.ادعای درستی(last_body().بیاب("&quot;p3&quot;") بزرگتر 0)
    arm(xml_ok("<Error><Code>InvalidPart</Code><Message>x</Message></Error>"))
    آزمایش.ادعای برابری رشته(ای دبلیو اس.اس۳ تکمیل بارگذاری(c، u).کد، "InvalidPart")
    arm(http(204، ""، ""))
    آزمایش.ادعای درستی(ای دبلیو اس.اس۳ لغو بارگذاری(c، u).موفق)
    آزمایش.ادعای برابری رشته(last_line()، "DELETE /bkt/big.bin?uploadId=U1")
    ای دبلیو اس.آزادسازی بخش‌ها(u)
    آزمایش.ادعای برابری عدد(ای دبلیو اس.بخش‌های بارگذاری(u)، 0)
    آزمایش.ادعای نادرستی(ای دبلیو اس.اس۳ تکمیل بارگذاری(c، u).موفق)

    arm(xml_ok("<ListPartsResult><IsTruncated>false</IsTruncated><Part><PartNumber>1</PartNumber><ETag>\"p1\"</ETag><Size>5242880</Size></Part><Part><PartNumber>2</PartNumber><ETag>\"p2\"</ETag><Size>7</Size></Part></ListPartsResult>"))
