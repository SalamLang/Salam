    آزمایش.ادعای نادرستی(ای دبلیو اس.اس۳ توقیف قانونی(c، "o/a.txt"))
    ثبت پاسخ(پاسخ اچ‌تی‌تی‌پی(200، ""، ""))
    آزمایش.ادعای درستی(ای دبلیو اس.اس۳ تنظیم نگهداری(c، "o/a.txt"، "compliance"، 1700000000 برگردان صحیح۶۴).موفق)
    آزمایش.ادعای برابری رشته(آخرین خط()، "PUT /bkt/o/a.txt?retention=")
    آزمایش.ادعای درستی(آخرین بدنه().بیاب("<Mode>COMPLIANCE</Mode>") بزرگتر 0)
    آزمایش.ادعای درستی(آخرین بدنه().بیاب("<RetainUntilDate>2023-11-14T22:13:20Z</RetainUntilDate>") بزرگتر 0)
    ثبت پاسخ(پاسخ اچ‌تی‌تی‌پی(200، ""، ""))
    آزمایش.ادعای درستی(ای دبلیو اس.اس۳ تنظیم نگهداری(c، "o/a.txt"، "other"، 1700000000 برگردان صحیح۶۴).موفق)
    آزمایش.ادعای درستی(آخرین بدنه().بیاب("<Mode>GOVERNANCE</Mode>") بزرگتر 0)
    آزمایش.ادعای درستی(تخلیه شده())
پایان

تابع فهرست صفحه(کلیدها: رشته، توکن: رشته، بریده شده: منطقی): رشته:
    ناپایا بیشتر := "false"
    اگر بریده شده: بیشتر = "true" پایان
    ناپایا خروجی := "<ListBucketResult><Name>bkt</Name><IsTruncated>" + بیشتر + "</IsTruncated>"
    اگر توکن نابرابر "": خروجی += "<NextContinuationToken>" + توکن + "</NextContinuationToken>" پایان
    برگشت خروجی + کلیدها + "</ListBucketResult>"
پایان

تابع آیتم فهرست(کلید: رشته، اندازه: صحیح): رشته:
    برگشت "<Contents><Key>" + کلید + "</Key><Size>" + اندازه + "</Size><ETag>\"e\"</ETag><LastModified>2024-01-02T03:04:05.000Z</LastModified></Contents>"
پایان

