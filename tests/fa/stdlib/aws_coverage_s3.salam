تابع test_files():
    c := cfg()
    root := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_aws_coverage_files")
    پوشه.حذف همه(root)
    پوشه.ساخت پوشه ها(مسیر پرونده.پیوند(root، "tree/inner"))
    note := مسیر پرونده.پیوند(root، "note.txt")
    پرونده.نوشتن متن(note، "hello")
    پرونده.نوشتن متن(مسیر پرونده.پیوند(root، "tree/top.csv")، "a,b")
    پرونده.نوشتن متن(مسیر پرونده.پیوند(root، "tree/inner/leaf.txt")، "leaf")
    آزمایش.ادعای برابری رشته(ای دبلیو اس.اس۳ ای‌تگ پرونده(note، 0)، "5d41402abc4b2a76b9719d911017c592")
    آزمایش.ادعای برابری رشته(ای دبلیو اس.اس۳ ای‌تگ پرونده(مسیر پرونده.پیوند(root، "missing.txt")، 0)، "")

    arm(http(200، "ETag: \"up1\"\r\n"، ""))
    up := ای دبلیو اس.اس۳ بارگذاری پرونده(c، "docs/note.txt"، note، ای دبلیو اس.گزینه‌های نوشتن {})
    آزمایش.ادعای درستی(up.موفق)
    آزمایش.ادعای برابری عدد۶۴(up.بایت‌ها، 5 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد(up.شمار بخش‌ها، 1)
    آزمایش.ادعای برابری رشته(up.ای تگ، "up1")
    آزمایش.ادعای برابری رشته(last_line()، "PUT /bkt/docs/note.txt")
    آزمایش.ادعای برابری رشته(last_body()، "hello")
    آزمایش.ادعای درستی(رشته.شروع با(hdr_get(last_head()، "Content-Type")، "text/plain"))
    arm(http(200، "ETag: \"up2\"\r\n"، ""))
    named := ای دبلیو اس.اس۳ بارگذاری پرونده با نوع(c، "docs/blob"، note، "application/x-custom")
    آزمایش.ادعای درستی(named.موفق)
    آزمایش.ادعای درستی(has_header("Content-Type"، "application/x-custom"))
    absent := ای دبلیو اس.اس۳ بارگذاری پرونده(c، "docs/none"، مسیر پرونده.پیوند(root، "missing.txt")، ای دبلیو اس.گزینه‌های نوشتن {})
    آزمایش.ادعای نادرستی(absent.موفق)

    arm(http(200، "ETag: \"d1\"\r\n"، ""))
    arm(http(200، "ETag: \"d2\"\r\n"، ""))
    seen := lines.طول()
    batch := ای دبلیو اس.اس۳ بارگذاری پوشه(c، مسیر پرونده.پیوند(root، "tree")، "backup"، ای دبلیو اس.گزینه‌های نوشتن {})
    آزمایش.ادعای درستی(batch.موفق)
    آزمایش.ادعای برابری عدد(batch.شمار پرونده‌ها، 2)
    آزمایش.ادعای برابری عدد۶۴(batch.مجموع بایت‌ها، 7 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد(lines.طول()، seen + 2)
    targets := lines.بگیر(seen) + " " + lines.بگیر(seen + 1)
    آزمایش.ادعای درستی(targets.بیاب("PUT /bkt/backup/top.csv") بزرگتربرابر 0)
    آزمایش.ادعای درستی(targets.بیاب("PUT /bkt/backup/inner/leaf.txt") بزرگتربرابر 0)
    notdir := ای دبلیو اس.اس۳ بارگذاری پوشه(c، note، "x"، ای دبلیو اس.گزینه‌های نوشتن {})
    آزمایش.ادعای نادرستی(notdir.موفق)
    آزمایش.ادعای برابری رشته(notdir.کد، "NotADirectory")

    out := مسیر پرونده.پیوند(root، "down.txt")
    arm(http_head(200، "ETag: \"g1\"\r\n"، 5))
    arm(http(206، ""، "hello"))
    got := ای دبلیو اس.اس۳ دریافت پرونده(c، "docs/note.txt"، out)
    آزمایش.ادعای درستی(got.موفق)
    آزمایش.ادعای برابری عدد۶۴(got.بایت‌ها، 5 برگردان صحیح۶۴)
    آزمایش.ادعای برابری رشته(پرونده.خواندن متن(out)، "hello")
    آزمایش.ادعای درستی(has_header("Range"، "bytes=0-4"))
    arm(http_head(404، ""، 0))
    آزمایش.ادعای نادرستی(ای دبلیو اس.اس۳ دریافت پرونده(c، "docs/none.txt"، مسیر پرونده.پیوند(root، "none.txt")).موفق)

    arm(xml_ok(page(entry("pre/a.txt"، 1) + entry("pre/sub/b.txt"، 2) + entry("pre/sub/"، 0)، ""، نادرست)))
    arm(http_head(200، ""، 1))
    arm(http(206، ""، "A"))
    arm(http_head(200، ""، 2))
    arm(http(206، ""، "BB"))
    dest := مسیر پرونده.پیوند(root، "mirror")
    pulled := ای دبلیو اس.اس۳ دریافت پیشوند(c، "pre/"، dest)
    آزمایش.ادعای درستی(pulled.موفق)
    آزمایش.ادعای برابری عدد(pulled.شمار پرونده‌ها، 2)
    آزمایش.ادعای برابری عدد(pulled.ردشده‌ها، 1)
    آزمایش.ادعای برابری عدد۶۴(pulled.مجموع بایت‌ها، 3 برگردان صحیح۶۴)
    آزمایش.ادعای برابری رشته(پرونده.خواندن متن(مسیر پرونده.پیوند(dest، "a.txt"))، "A")
    آزمایش.ادعای برابری رشته(پرونده.خواندن متن(مسیر پرونده.پیوند(dest، "sub/b.txt"))، "BB")
    پوشه.حذف همه(root)
    آزمایش.ادعای درستی(drained())
