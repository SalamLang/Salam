    آزمایش.ادعای درستی(سرآیند دارد("x-amz-copy-source-range"، "bytes=0-99"))
    آزمایش.ادعای برابری عدد(ای دبلیو اس.بخش‌های بارگذاری(u)، 3)
    آزمایش.ادعای برابری عدد۶۴(ای دبلیو اس.بایت‌های بارگذاری(u)، 103 برگردان صحیح۶۴)
    شماره نامعتبر := ای دبلیو اس.اس۳ بارگذاری بخش(c، u، 0، اولی برگردان تهی*، 1)
    آزمایش.ادعای نادرستی(شماره نامعتبر.موفق)

    ثبت پاسخ(پاسخ اکس‌ام‌ال("<CompleteMultipartUploadResult><ETag>\"final-3\"</ETag></CompleteMultipartUploadResult>"))
    انجام شده := ای دبلیو اس.اس۳ تکمیل بارگذاری(c، u)
    آزمایش.ادعای درستی(انجام شده.موفق)
    آزمایش.ادعای برابری رشته(انجام شده.ای تگ، "final-3")
    آزمایش.ادعای برابری رشته(آخرین خط()، "POST /bkt/big.bin?uploadId=U1")
    مرتب := آخرین بدنه().بیاب("<PartNumber>1</PartNumber>") کوچکتر آخرین بدنه().بیاب("<PartNumber>2</PartNumber>")
