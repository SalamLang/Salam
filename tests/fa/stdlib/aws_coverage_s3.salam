تابع test_wire():
    c := پیکربندی آزمون()
    ناپایا درخواست سطل := ای دبلیو اس.درخواست سطل جدید("PUT"، "other"، "dir/file.bin")
    ای دبلیو اس.تنظیم پرسمان عددی(درخواست سطل، "partNumber"، 4)
    ای دبلیو اس.تنظیم پرچم(درخواست سطل، "uploads")
    محتوا := "payload!"
    ای دبلیو اس.تنظیم بدنه(درخواست سطل، محتوا برگردان تهی*، 8)
    ای دبلیو اس.تنظیم بار امضانشده(درخواست سطل)
    ثبت پاسخ(پاسخ اچ‌تی‌تی‌پی(200، "ETag: \"w1\"\r\nx-custom: yes\r\n"، ""))
    پاسخ درخواست := ای دبلیو اس.اجرای درخواست(c، درخواست سطل)
    آزمایش.ادعای درستی(پاسخ درخواست.موفق)
    آزمایش.ادعای برابری رشته(آخرین خط()، "PUT /other/dir/file.bin?partNumber=4&uploads=")
    آزمایش.ادعای برابری رشته(آخرین بدنه()، "payload!")
    آزمایش.ادعای درستی(سرآیند دارد("x-amz-content-sha256"، ای دبلیو اس.بار امضانشده))
    آزمایش.ادعای برابری رشته(ای دبلیو اس.سرآیند نتیجه(پاسخ درخواست، "x-custom")، "yes")

    درخواست سرویس := ای دبلیو اس.درخواست سرویس جدید("GET")
    ثبت پاسخ(پاسخ اکس‌ام‌ال("<Buckets/>"))
    آزمایش.ادعای درستی(ای دبلیو اس.اجرای درخواست(c، درخواست سرویس).موفق)
    آزمایش.ادعای برابری رشته(آخرین خط()، "GET /")

    ثبت پاسخ(پاسخ اچ‌تی‌تی‌پی(200، "ETag: \"b1\"\r\nx-note: raw\r\n"، "binary-ish"))
    ناپایا خام := ای دبلیو اس.اجرای درخواست بایتی(c، ای دبلیو اس.درخواست جدید("GET"، "blob"))
    آزمایش.ادعای درستی(خام.موفق)
    آزمایش.ادعای برابری عدد(خام.طول، 10)
    آزمایش.ادعای برابری رشته(ای دبلیو اس.سرآیند بایت‌ها(خام، "x-note")، "raw")
    آزمایش.ادعای برابری رشته(خام.ای تگ، "b1")
    ای دبلیو اس.آزادسازی بایت‌ها(خام)
    ثبت پاسخ(پاسخ اچ‌تی‌تی‌پی(404، ""، "<Error><Code>NoSuchKey</Code></Error>"))
    ناپایا گمشده := ای دبلیو اس.اجرای درخواست بایتی(c، ای دبلیو اس.درخواست جدید("GET"، "blob"))
    آزمایش.ادعای نادرستی(گمشده.موفق)
    آزمایش.ادعای برابری رشته(گمشده.کد، "NoSuchKey")
    ای دبلیو اس.آزادسازی بایت‌ها(گمشده)

    ساده := ای دبلیو اس.با سطل(c، "else")
    آزمایش.ادعای برابری رشته(ساده.سطل، "else")
    توکن := ای دبلیو اس.با توکن نشست(c، "tok")
    آزمایش.ادعای برابری رشته(توکن.توکن نشست، "tok")
    کوشا := ای دبلیو اس.با کوشش دوباره(c، 5، 20)
    آزمایش.ادعای برابری عدد(کوشا.شمار کوشش، 5)
    آزمایش.ادعای برابری عدد(کوشا.فاصله پایه کوشش دوباره، 20)
    اعتبارها := ای دبلیو اس.با اعتبارنامه(ای دبلیو اس.پیکربندی جدید("http://x"، "b")، "AK"، "SK")
    آزمایش.ادعای برابری رشته(اعتبارها.کلید دسترسی، "AK")
    آزمایش.ادعای برابری رشته(اعتبارها.کلید رمز، "SK")
    ناکامی := ای دبلیو اس.شکست("because")
    آزمایش.ادعای نادرستی(ناکامی.موفق)
    آزمایش.ادعای برابری رشته(ناکامی.خطا، "because")
    آزمایش.ادعای درستی(تخلیه شده())
