پایان

تابع page(keys: رشته، token: رشته، truncated: منطقی): رشته:
    ناپایا more := "false"
    اگر truncated: more = "true" پایان
    ناپایا out := "<ListBucketResult><Name>bkt</Name><IsTruncated>" + more + "</IsTruncated>"
    اگر token نابرابر "": out += "<NextContinuationToken>" + token + "</NextContinuationToken>" پایان
    برگشت out + keys + "</ListBucketResult>"
پایان

تابع entry(key: رشته، size: صحیح): رشته:
    برگشت "<Contents><Key>" + key + "</Key><Size>" + size + "</Size><ETag>\"e\"</ETag><LastModified>2024-01-02T03:04:05.000Z</LastModified></Contents>"
پایان

تابع test_listing():
