    آزمایش.ادعای برابری رشته(last_body()، "Action=GetQueueUrl&Version=2012-11-05&QueueName=jobs")
    arm(http(400، ""، "<ErrorResponse><Error><Code>AWS.SimpleQueueService.NonExistentQueue</Code></Error></ErrorResponse>"))
    آزمایش.ادعای برابری رشته(ای دبلیو اس.اس کیو اس نشانی صف(c، "ghost")، "")

    ناپایا attrs := ای دبلیو اس.سرآیندهای جدید()
    ای دبلیو اس.تنظیم سرآیند(attrs، "VisibilityTimeout"، "45")
