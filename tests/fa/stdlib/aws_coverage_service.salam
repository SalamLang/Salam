    آزمایش.ادعای درستی(last_body().بیاب("Attribute.1.Name=VisibilityTimeout&Attribute.1.Value=45") بزرگتر 0)
    ای دبلیو اس.آزادسازی سرآیندها(attrs)

    arm(xml_ok("<ListQueuesResponse><ListQueuesResult><QueueUrl>" + QUEUE + "</QueueUrl><QueueUrl>" + QUEUE + "-dead</QueueUrl></ListQueuesResult></ListQueuesResponse>"))
