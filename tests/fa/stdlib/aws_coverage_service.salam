    آزمایش.ادعای برابری رشته(ای دبلیو اس.نقطه پایانی ای دبلیو اس("us-east-1")، "https://s3.amazonaws.com")
    آزمایش.ادعای برابری رشته(ای دبلیو اس.نقطه پایانی ای دبلیو اس("eu-west-1")، "https://s3.eu-west-1.amazonaws.com")
    wasabi := ای دبلیو اس.برای واسابی("eu-central-1"، "b1")
    آزمایش.ادعای برابری رشته(wasabi.نقطه پایانی، "https://s3.eu-central-1.wasabisys.com")
    آزمایش.ادعای برابری رشته(wasabi.منطقه، "eu-central-1")
    آزمایش.ادعای نادرستی(wasabi.سبک مسیر)
    backblaze := ای دبلیو اس.برای بک‌بلیز("us-west-004"، "b2")
    آزمایش.ادعای برابری رشته(backblaze.نقطه پایانی، "https://s3.us-west-004.backblazeb2.com")
    آزمایش.ادعای برابری رشته(backblaze.سطل، "b2")
    custom := ای دبلیو اس.برای نقطه پایانی("http://localhost:9000/"، ""، "b3")
    آزمایش.ادعای برابری رشته(custom.نقطه پایانی، "http://localhost:9000")
    آزمایش.ادعای برابری رشته(custom.منطقه، "us-east-1")
    آزمایش.ادعای درستی(custom.سبک مسیر)
    regional := ای دبلیو اس.برای نقطه پایانی("http://localhost:9000"، "eu-north-1"، "b3")
    آزمایش.ادعای برابری رشته(regional.منطقه، "eu-north-1")
