    آزمایش.ادعای برابری عدد(ای دبلیو اس.اس کیو اس طول صف(c، QUEUE)، 0 - 1)

    ناپایا changes := ای دبلیو اس.سرآیندهای جدید()
    ای دبلیو اس.تنظیم سرآیند(changes، "DelaySeconds"، "5")
    arm(xml_ok("<SetQueueAttributesResponse/>"))
    آزمایش.ادعای درستی(ای دبلیو اس.اس کیو اس تنظیم ویژگی‌ها(c، QUEUE، changes).موفق)
    آزمایش.ادعای درستی(last_body().بیاب("Action=SetQueueAttributes&") برابر 0)
    آزمایش.ادعای درستی(last_body().بیاب("Attribute.1.Name=DelaySeconds&Attribute.1.Value=5") بزرگتر 0)
    ای دبلیو اس.آزادسازی سرآیندها(changes)
    محیط.تنظیم("AWS_ENDPOINT_URL_SQS"، "")
    آزمایش.ادعای درستی(drained())
پایان

تابع ریشه:
    همگام سازی.افزودن(wg، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve)
    همگام سازی.انتظار(wg)
    test_signing()
    test_presign()
    test_presets()
    test_environment()
    test_profiles()
    test_sts()
    test_calls()
    test_sqs_queues()
    test_sqs_messages()
    test_sqs_attributes()
    ای دبلیو اس.اس۳ حذف(cfg()، "__stop")
    نخ‌پیوند(t)
    آزمایش.خلاصه()
    برگشت 0
