تابع test_calls():
    c := cfg()
    ناپایا call := ای دبلیو اس.فراخوان رست جدید("lambda"، "GET"، "/2015-03-31/functions")
    ای دبلیو اس.سرآیند فراخوان(call، "X-Trace"، "abc")
    ای دبلیو اس.سرآیند فراخوان(call، "X-Skipped"، "")
    ای دبلیو اس.پرسمان فراخوان(call، "MaxItems"، "5")
    ای دبلیو اس.پرسمان فراخوان(call، "Marker"، "m 1")
    head := ای دبلیو اس.فراخوان آماده(c، call، 1369353600 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(رشته.شروع با(head، "GET /2015-03-31/functions?Marker=m%201&MaxItems=5 HTTP/1.1\r\n"))
    آزمایش.ادعای درستی(head.بیاب("\r\nx-trace: abc\r\n") بزرگتر 0 یا head.بیاب("\r\nX-Trace: abc\r\n") بزرگتر 0)
    آزمایش.ادعای درستی(head.بیاب("X-Skipped") کوچکتر 0)
    آزمایش.ادعای درستی(head.بیاب("/20130524/us-east-1/lambda/aws4_request") بزرگتر 0)
    ناپایا posted := ای دبلیو اس.فراخوان رست جدید("lambda"، "POST"، "/2015-03-31/functions/f/invocations")
    ای دبلیو اس.بدنه فراخوان(posted، "{\"n\":1}"، "application/json")
    sent := ای دبلیو اس.فراخوان آماده(c، posted، 1369353600 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(sent.بیاب("Content-Type: application/json") بزرگتر 0 یا sent.بیاب("content-type: application/json") بزرگتر 0)
    آزمایش.ادعای درستی(sent.بیاب("\r\n\r\n{\"n\":1}") بزرگتر 0)
    آزمایش.ادعای برابری رشته(ای دبلیو اس.متن بدنه فراخوان(posted)، "{\"n\":1}")
    ای دبلیو اس.بدنه فراخوان(posted، "{\"n\":2}"، "")
    آزمایش.ادعای برابری رشته(ای دبلیو اس.متن بدنه فراخوان(posted)، "{\"n\":2}")
    ای دبلیو اس.آزادسازی فراخوان(call)
    ای دبلیو اس.آزادسازی فراخوان(posted)
