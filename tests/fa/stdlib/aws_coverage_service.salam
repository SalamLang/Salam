تابع test_profiles():
    root := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_aws_coverage_profiles")
    پوشه.حذف همه(root)
    پوشه.ساخت پوشه ها(root)
    credentials := مسیر پرونده.پیوند(root، "credentials")
    config := مسیر پرونده.پیوند(root، "config")
    پرونده.نوشتن متن(credentials، "[default]\naws_access_key_id = DEFKEY\naws_secret_access_key = DEFSECRET\n\n[work]\naws_access_key_id = WORKKEY\naws_secret_access_key = WORKSECRET\naws_session_token = WORKTOKEN\n")
    پرونده.نوشتن متن(config، "[default]\nregion = us-west-1\n\n[profile work]\nregion = eu-north-1\n\n[profile deploy]\nrole_arn = arn:aws:iam::123456789012:role/deploy\nsource_profile = work\nregion = us-west-2\n")
    محیط.تنظیم("AWS_SHARED_CREDENTIALS_FILE"، credentials)
    محیط.تنظیم("AWS_CONFIG_FILE"، config)
    آزمایش.ادعای برابری رشته(ای دبلیو اس.مسیر اعتبارنامه‌ها()، credentials)
    آزمایش.ادعای برابری رشته(ای دبلیو اس.مسیر پیکربندی()، config)
    محیط.تنظیم("AWS_PROFILE"، "")

    work := ای دبلیو اس.پیکربندی از نمایه("work"، "pbkt")
    آزمایش.ادعای برابری رشته(work.کلید دسترسی، "WORKKEY")
    آزمایش.ادعای برابری رشته(work.کلید رمز، "WORKSECRET")
    آزمایش.ادعای برابری رشته(work.توکن نشست، "WORKTOKEN")
    آزمایش.ادعای برابری رشته(work.منطقه، "eu-north-1")
