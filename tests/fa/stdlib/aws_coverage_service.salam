    arm(xml_ok("<ChangeMessageVisibilityResponse/>"))
    آزمایش.ادعای درستی(ای دبلیو اس.اس کیو اس تغییر پنهان‌ماندن(c، QUEUE، "rh1"، 120).موفق)
    آزمایش.ادعای درستی(last_body().بیاب("Action=ChangeMessageVisibility&") برابر 0)
