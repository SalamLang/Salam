    ای دبلیو اس.سرآیند فراخوان(فراخوان، "X-Trace"، "abc")
    ای دبلیو اس.سرآیند فراخوان(فراخوان، "X-Skipped"، "")
    ای دبلیو اس.پرسمان فراخوان(فراخوان، "MaxItems"، "5")
    ای دبلیو اس.پرسمان فراخوان(فراخوان، "Marker"، "m 1")
    سرآیند := ای دبلیو اس.فراخوان آماده(c، فراخوان، 1369353600 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(رشته.شروع با(سرآیند، "GET /2015-03-31/functions?Marker=m%201&MaxItems=5 HTTP/1.1\r\n"))
    آزمایش.ادعای درستی(سرآیند.بیاب("\r\nx-trace: abc\r\n") بزرگتر 0 یا سرآیند.بیاب("\r\nX-Trace: abc\r\n") بزرگتر 0)
    آزمایش.ادعای درستی(سرآیند.بیاب("X-Skipped") کوچکتر 0)
    آزمایش.ادعای درستی(سرآیند.بیاب("/20130524/us-east-1/lambda/aws4_request") بزرگتر 0)
    ناپایا ارسالی := ای دبلیو اس.فراخوان رست جدید("lambda"، "POST"، "/2015-03-31/functions/f/invocations")
    ای دبلیو اس.بدنه فراخوان(ارسالی، "{\"n\":1}"، "application/json")
    فرستاده := ای دبلیو اس.فراخوان آماده(c، ارسالی، 1369353600 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(فرستاده.بیاب("Content-Type: application/json") بزرگتر 0 یا فرستاده.بیاب("content-type: application/json") بزرگتر 0)
    آزمایش.ادعای درستی(فرستاده.بیاب("\r\n\r\n{\"n\":1}") بزرگتر 0)
    آزمایش.ادعای برابری رشته(ای دبلیو اس.متن بدنه فراخوان(ارسالی)، "{\"n\":1}")
    ای دبلیو اس.بدنه فراخوان(ارسالی، "{\"n\":2}"، "")
    آزمایش.ادعای برابری رشته(ای دبلیو اس.متن بدنه فراخوان(ارسالی)، "{\"n\":2}")
    ای دبلیو اس.آزادسازی فراخوان(فراخوان)
    ای دبلیو اس.آزادسازی فراخوان(ارسالی)
