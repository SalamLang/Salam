بسته ریشه

واردسازی ای دبلیو اس
واردسازی محیط
واردسازی حافظه
واردسازی رشته
واردسازی همگام سازی
واردسازی شبکه.تی سی پی

ناپایا PORT := 0
ناپایا wg := همگام سازی.گروه انتظار جدید()
ناپایا token_reply := ""
ناپایا gets := 0

تابع read_head(c: تی سی پی.اتصال شبکه): رشته:
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(buf)
    ناپایا sb := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(sb)
    تا وارونه رشته.شامل است(رشته.رشته بافر(sb)، "\r\n\r\n"):
        got := تی سی پی.خواندن بایت(c، buf، 4096)
        اگر got کوچکتربرابر 0: بشکن پایان
        تکرار got در i:
            رشته.افزودن نویسه به بافر(sb، (buf برگردان طبیعی۸*)[i] برگردان صحیح)
        پایان
    پایان
    برگشت رشته.رشته بافر(sb)
پایان

تابع http(status: صحیح، body: رشته): رشته:
    برگشت "HTTP/1.1 " + status + " X\r\nContent-Length: " + body.طول() + "\r\nConnection: close\r\n\r\n" + body
پایان

تابع answer(head: رشته): رشته:
    اگر رشته.شروع با(head، "PUT /latest/api/token "):
        برگشت token_reply
    پایان
    gets += 1
    اگر وارونه رشته.شامل است(head، "X-aws-ec2-metadata-token: tok-1\r\n"):
        برگشت http(401، "")
    پایان
    اگر رشته.شروع با(head، "GET /latest/meta-data/iam/security-credentials/ "):
        برگشت http(200، "role-a\n")
    پایان
    اگر رشته.شروع با(head، "GET /latest/meta-data/iam/security-credentials/role-a "):
        برگشت http(200، `{"AccessKeyId":"AK","SecretAccessKey":"SK","Token":"ST"}`)
    پایان
    اگر رشته.شروع با(head، "GET /latest/meta-data/placement/region "):
        برگشت http(200، "eu-west-1\n")
    پایان
    برگشت http(404، "")
پایان

تابع serve():
    srv := تی سی پی.پیوند(0)
    PORT = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(wg)
    ناپایا running := درست
    تا running:
        c := تی سی پی.پذیرش(srv)
        head := read_head(c)
        اگر رشته.شروع با(head، "GET /__stop "):
            running = نادرست
        وگرنه:
            تی سی پی.نوشتن(c، answer(head))
        پایان
        تی سی پی.بستن(c)
    پایان
    تی سی پی.بستن سرور(srv)
پایان

تابع show(label: رشته):
    gets = 0
    creds := ای دبلیو اس.اعتبارنامه از ماشین(2000)
    سرچاپ label، "ok"، creds.پیدا شد، "key"، creds.کلید دسترسی، "code"، creds.کد
    سرچاپ label، "error"، creds.خطا
    سرچاپ label، "region"، ای دبلیو اس.منطقه ماشین(2000)
    سرچاپ label، "metadata reads"، gets
پایان

تابع ریشه:
    همگام سازی.افزودن(wg، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve)
    همگام سازی.انتظار(wg)
    base := "http://127.0.0.1:" + PORT
    محیط.تنظیم("AWS_EC2_METADATA_DISABLED"، "")
    محیط.تنظیم("AWS_EC2_METADATA_SERVICE_ENDPOINT"، base)

    token_reply = http(200، "tok-1\n")
    show("good")

    token_reply = http(403، "<html>denied\r\nX-Bad: yes</html>")
    show("denied")

    token_reply = http(503، "tok-1")
    show("unavailable")

    token_reply = http(200، "")
    show("empty")

    c := تی سی پی.شماره گیری("127.0.0.1"، PORT)
    تی سی پی.نوشتن(c، "GET /__stop HTTP/1.1\r\n\r\n")
    تی سی پی.بستن(c)
    نخ‌پیوند(t)
    برگشت 0
پایان
