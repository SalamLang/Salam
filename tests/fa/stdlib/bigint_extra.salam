بسته ریشه

واردسازی عدد بزرگ
واردسازی آزمایش

تابع expect(x: عدد بزرگ.صحیح، want: رشته):
    ناپایا v := x
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(v)، want)
    v.آزادکن()
پایان

تابع ریشه:
    سرچاپ "small integer helpers"
    ناپایا a := عدد بزرگ.از صحیح(1000000007 برگردان صحیح۶۴)
    expect(عدد بزرگ.تفریق صحیح(a، 8 برگردان صحیح۶۴)، "999999999")
    expect(عدد بزرگ.تفریق صحیح(a، 2000000000 برگردان صحیح۶۴)، "-999999993")
    expect(عدد بزرگ.مربع(a)، "1000000014000000049")
    آزمایش.ادعای درستی(عدد بزرگ.یکسان با صحیح است(a، 1000000007 برگردان صحیح۶۴))
    آزمایش.ادعای نادرستی(عدد بزرگ.یکسان با صحیح است(a، 7 برگردان صحیح۶۴))
    آزمایش.ادعای برابری عدد(عدد بزرگ.پیمانه صحیح(a، 1000 برگردان صحیح۶۴) برگردان صحیح، 7)
    ناپایا rem := 0 برگردان صحیح۶۴
    expect(عدد بزرگ.تقسیم صحیح(a، 1000 برگردان صحیح۶۴، rem)، "1000000")
    آزمایش.ادعای برابری عدد(rem برگردان صحیح، 7)
    expect(عدد بزرگ.تقسیم صحیح(a، 0 برگردان صحیح۶۴، rem)، "0")
    آزمایش.ادعای برابری عدد(rem برگردان صحیح، 0)

    سرچاپ "in place updates"
    عدد بزرگ.افزودن صحیح به(a، 3 برگردان صحیح۶۴)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "1000000010")
    عدد بزرگ.افزودن صحیح به(a، 0 - 10 برگردان صحیح۶۴)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "1000000000")
    عدد بزرگ.شیفت چپ در جا(a، 4)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "16000000000")
    عدد بزرگ.شیفت راست در جا(a، 8)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "62500000")
    عدد بزرگ.شیفت راست در جا(a، 100)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "0")
    a.آزادسازی()

    سرچاپ "unsigned and bits"
    ناپایا big := عدد بزرگ.از صحیح بی‌علامت(18446744073709551615 برگردان طبیعی۶۴)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(big)، "18446744073709551615")
    آزمایش.ادعای برابری عدد(عدد بزرگ.طول بیت(big)، 64)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(big، 0)، 1)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(big، 63)، 1)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(big، 64)، 0)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(big، 0 - 1)، 0)
    عدد بزرگ.شیفت راست در جا(big، 63)
    آزمایش.ادعای برابری عدد(عدد بزرگ.طول بیت(big)، 1)
    big.آزادسازی()
    ناپایا five := عدد بزرگ.از صحیح(5 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد(عدد بزرگ.طول بیت(five)، 3)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(five، 1)، 0)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(five، 2)، 1)
    five.آزادسازی()

    سرچاپ "floor division"
    ناپایا x := عدد بزرگ.از صحیح(0 - 7 برگردان صحیح۶۴)
    ناپایا y := عدد بزرگ.از صحیح(2 برگردان صحیح۶۴)
    ناپایا q := عدد بزرگ.صحیح {}
    ناپایا r := عدد بزرگ.صحیح {}
    آزمایش.ادعای درستی(عدد بزرگ.تقسیم کف با باقیمانده(x، y، q، r))
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(q)، "-4")
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(r)، "1")
    ناپایا tq := عدد بزرگ.صحیح {}
    ناپایا tr := عدد بزرگ.صحیح {}
    آزمایش.ادعای درستی(عدد بزرگ.تقسیم با باقیمانده(x، y، tq، tr))
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(tq)، "-3")
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(tr)، "-1")
    ناپایا zero := عدد بزرگ.از صحیح(0 برگردان صحیح۶۴)
    آزمایش.ادعای نادرستی(عدد بزرگ.تقسیم کف با باقیمانده(x، zero، q، r))
    q.آزادسازی()
    r.آزادسازی()
    tq.آزادسازی()
    tr.آزادسازی()
    x.آزادسازی()
    y.آزادسازی()
    zero.آزادسازی()

    سرچاپ "parse with a base"
    ناپایا ok := نادرست
    ناپایا h := عدد بزرگ.تجزیه با پایه("ff"، 16، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(h)، "255")
    h.آزادسازی()
    ناپایا b := عدد بزرگ.تجزیه با پایه("-101"، 2، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(b)، "-5")
    b.آزادسازی()
    ناپایا bad := عدد بزرگ.تجزیه با پایه("12"، 2، ok)
    آزمایش.ادعای نادرستی(ok)
    bad.آزادسازی()
    ناپایا huge := عدد بزرگ.تجزیه با پایه("zzzzzzzzzzzzzzzzzzzzzzzz"، 36، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای برابری عدد(عدد بزرگ.طول بیت(huge)، 125)
    آزمایش.ادعای درستی(عدد بزرگ.به صحیح محدود(huge) برابر 9223372036854775807)
    huge.آزادسازی()

    سرچاپ "clamped conversion"
    ناپایا n := عدد بزرگ.از صحیح(0 - 12 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد(عدد بزرگ.به صحیح محدود(n) برگردان صحیح، 0 - 12)
    n.آزادسازی()
    ناپایا over := عدد بزرگ.تجزیه("100000000000000000000000"، ok)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(over)، "100000000000000000000000")
    آزمایش.ادعای درستی(عدد بزرگ.به صحیح محدود(over) برابر 9223372036854775807)
    ناپایا under := عدد بزرگ.تجزیه("-100000000000000000000000"، ok)
    آزمایش.ادعای درستی(عدد بزرگ.به صحیح محدود(under) کوچکتر 0 - 9223372036854775807)
    over.آزادسازی()
    under.آزادسازی()
    برگشت آزمایش.خلاصه()
پایان
