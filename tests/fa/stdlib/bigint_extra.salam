بسته ریشه

واردسازی عدد بزرگ
واردسازی آزمایش

تابع بررسی(x: عدد بزرگ.صحیح، مورد انتظار: رشته):
    ناپایا v := x
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(v)، مورد انتظار)
    v.آزادکن()
پایان

تابع ریشه:
    سرچاپ "small integer helpers"
    ناپایا a := عدد بزرگ.از صحیح(1000000007 برگردان صحیح۶۴)
    بررسی(عدد بزرگ.تفریق صحیح(a، 8 برگردان صحیح۶۴)، "999999999")
    بررسی(عدد بزرگ.تفریق صحیح(a، 2000000000 برگردان صحیح۶۴)، "-999999993")
    بررسی(عدد بزرگ.مربع(a)، "1000000014000000049")
    آزمایش.ادعای درستی(عدد بزرگ.یکسان با صحیح است(a، 1000000007 برگردان صحیح۶۴))
    آزمایش.ادعای نادرستی(عدد بزرگ.یکسان با صحیح است(a، 7 برگردان صحیح۶۴))
    آزمایش.ادعای برابری عدد(عدد بزرگ.پیمانه صحیح(a، 1000 برگردان صحیح۶۴) برگردان صحیح، 7)
    ناپایا باقیمانده := 0 برگردان صحیح۶۴
    بررسی(عدد بزرگ.تقسیم صحیح(a، 1000 برگردان صحیح۶۴، باقیمانده)، "1000000")
    آزمایش.ادعای برابری عدد(باقیمانده برگردان صحیح، 7)
    بررسی(عدد بزرگ.تقسیم صحیح(a، 0 برگردان صحیح۶۴، باقیمانده)، "0")
    آزمایش.ادعای برابری عدد(باقیمانده برگردان صحیح، 0)

    سرچاپ "in place updates"
    عدد بزرگ.افزودن صحیح به(a، 3 برگردان صحیح۶۴)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "1000000010")
    عدد بزرگ.افزودن صحیح به(a، 0 - 10 برگردان صحیح۶۴)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "1000000000")
    عدد بزرگ.شیفت چپ در جا(a، 4)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "16000000000")
    عدد بزرگ.شیفت راست در جا(a، 8)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "62500000")
    عدد بزرگ.شیفت راست در جا(a، 100)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(a)، "0")
    a.آزادسازی()

    سرچاپ "unsigned and bits"
    ناپایا عدد کلان := عدد بزرگ.از صحیح بی‌علامت(18446744073709551615 برگردان طبیعی۶۴)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(عدد کلان)، "18446744073709551615")
    آزمایش.ادعای برابری عدد(عدد بزرگ.طول بیت(عدد کلان)، 64)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(عدد کلان، 0)، 1)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(عدد کلان، 63)، 1)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(عدد کلان، 64)، 0)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(عدد کلان، 0 - 1)، 0)
    عدد بزرگ.شیفت راست در جا(عدد کلان، 63)
    آزمایش.ادعای برابری عدد(عدد بزرگ.طول بیت(عدد کلان)، 1)
    عدد کلان.آزادسازی()
    ناپایا پنج := عدد بزرگ.از صحیح(5 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد(عدد بزرگ.طول بیت(پنج)، 3)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(پنج، 1)، 0)
    آزمایش.ادعای برابری عدد(عدد بزرگ.بیت(پنج، 2)، 1)
    پنج.آزادسازی()

    سرچاپ "floor division"
    ناپایا x := عدد بزرگ.از صحیح(0 - 7 برگردان صحیح۶۴)
    ناپایا y := عدد بزرگ.از صحیح(2 برگردان صحیح۶۴)
    ناپایا q := عدد بزرگ.صحیح {}
    ناپایا r := عدد بزرگ.صحیح {}
    آزمایش.ادعای درستی(عدد بزرگ.تقسیم کف با باقیمانده(x، y، q، r))
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(q)، "-4")
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(r)، "1")
    ناپایا خارج برشی := عدد بزرگ.صحیح {}
    ناپایا باقیمانده برشی := عدد بزرگ.صحیح {}
    آزمایش.ادعای درستی(عدد بزرگ.تقسیم با باقیمانده(x، y، خارج برشی، باقیمانده برشی))
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(خارج برشی)، "-3")
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(باقیمانده برشی)، "-1")
    ناپایا صفر := عدد بزرگ.از صحیح(0 برگردان صحیح۶۴)
    آزمایش.ادعای نادرستی(عدد بزرگ.تقسیم کف با باقیمانده(x، صفر، q، r))
    q.آزادسازی()
    r.آزادسازی()
    خارج برشی.آزادسازی()
    باقیمانده برشی.آزادسازی()
    x.آزادسازی()
    y.آزادسازی()
    صفر.آزادسازی()

    سرچاپ "parse with a base"
    ناپایا موفق := نادرست
    ناپایا h := عدد بزرگ.تجزیه با پایه("ff"، 16، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(h)، "255")
    h.آزادسازی()
    ناپایا b := عدد بزرگ.تجزیه با پایه("-101"، 2، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(b)، "-5")
    b.آزادسازی()
    ناپایا نامعتبر := عدد بزرگ.تجزیه با پایه("12"، 2، موفق)
    آزمایش.ادعای نادرستی(موفق)
    نامعتبر.آزادسازی()
    ناپایا عظیم := عدد بزرگ.تجزیه با پایه("zzzzzzzzzzzzzzzzzzzzzzzz"، 36، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای برابری عدد(عدد بزرگ.طول بیت(عظیم)، 125)
    آزمایش.ادعای درستی(عدد بزرگ.به صحیح محدود(عظیم) برابر 9223372036854775807)
    عظیم.آزادسازی()

    سرچاپ "clamped conversion"
    ناپایا n := عدد بزرگ.از صحیح(0 - 12 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد(عدد بزرگ.به صحیح محدود(n) برگردان صحیح، 0 - 12)
    n.آزادسازی()
    ناپایا سرریز := عدد بزرگ.تجزیه("100000000000000000000000"، موفق)
    آزمایش.ادعای برابری رشته(عدد بزرگ.به رشته(سرریز)، "100000000000000000000000")
    آزمایش.ادعای درستی(عدد بزرگ.به صحیح محدود(سرریز) برابر 9223372036854775807)
    ناپایا زیرریز := عدد بزرگ.تجزیه("-100000000000000000000000"، موفق)
    آزمایش.ادعای درستی(عدد بزرگ.به صحیح محدود(زیرریز) کوچکتر 0 - 9223372036854775807)
    سرریز.آزادسازی()
    زیرریز.آزادسازی()
    برگشت آزمایش.خلاصه()
پایان
