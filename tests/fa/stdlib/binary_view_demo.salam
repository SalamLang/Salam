// زبان: فارسی
واردسازی کدگذاری.دودویی
واردسازی حافظه

تابع ریشه:
    raw := حافظه.تخصیص صفرشده(40 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(raw)
    v := دودویی.نمای بایت جدید(raw، 40)
    سرچاپ دودویی.گذاشتن طبیعی۳۲ کوچک‌انتها(v، 0، 0xFADE0CC0 برگردان صحیح۶۴)، دودویی.گذاشتن طبیعی۳۲ بزرگ‌انتها(v، 4، 0xFADE0CC0 برگردان صحیح۶۴)، دودویی.گذاشتن طبیعی۱۶ کوچک‌انتها(v، 8، 0xBEEF برگردان صحیح۶۴)، دودویی.گذاشتن طبیعی۱۶ بزرگ‌انتها(v، 10، 0xBEEF برگردان صحیح۶۴)
    سرچاپ دودویی.گرفتن طبیعی۳۲ کوچک‌انتها(v، 0)، دودویی.گرفتن طبیعی۳۲ بزرگ‌انتها(v، 4)، دودویی.گرفتن طبیعی۳۲ کوچک‌انتها(v، 4)، دودویی.گرفتن طبیعی۱۶ کوچک‌انتها(v، 8)، دودویی.گرفتن طبیعی۱۶ بزرگ‌انتها(v، 8)، دودویی.گرفتن طبیعی۱۶ بزرگ‌انتها(v، 10)
    سرچاپ دودویی.گذاشتن طبیعی۶۴ کوچک‌انتها(v، 16، 0x0123456789ABCDEF برگردان صحیح۶۴)، دودویی.گرفتن طبیعی۶۴ کوچک‌انتها(v، 16)، دودویی.گرفتن طبیعی۶۴ بزرگ‌انتها(v، 16)، دودویی.گرفتن طبیعی۸(v، 16)، دودویی.گرفتن طبیعی۸(v، 23)
    سرچاپ دودویی.گذاشتن طبیعی۶۴ بزرگ‌انتها(v، 24، 258 برگردان صحیح۶۴)، دودویی.گرفتن طبیعی۶۴ بزرگ‌انتها(v، 24)، دودویی.گرفتن طبیعی۶۴ کوچک‌انتها(v، 24)، دودویی.گرفتن طبیعی۸(v، 31)
    سرچاپ دودویی.گذاشتن طبیعی۸(v، 32، 104 برگردان صحیح۶۴)، دودویی.گذاشتن طبیعی۸(v، 33، 105 برگردان صحیح۶۴)
    name := دودویی.رشته با صفر پایانی(v، 32)
    fixed := دودویی.رشته با پهنای ثابت(v، 32، 2)
    سرچاپ name، fixed، name.طول()، دودویی.رشته با صفر پایانی(v، 39).طول()
    سرچاپ دودویی.دارد(v، 38، 2)، دودویی.دارد(v، 39، 2)، دودویی.دارد(v، 0 - 1، 1)
    سرچاپ دودویی.گرفتن طبیعی۳۲ کوچک‌انتها(v، 38)، دودویی.گذاشتن طبیعی۳۲ کوچک‌انتها(v، 38، 1 برگردان صحیح۶۴)، دودویی.گذاشتن طبیعی۸(v، 40، 1 برگردان صحیح۶۴)
    w := دودویی.نمای بایت جدید(پوچ، 0)
    سرچاپ دودویی.گرفتن طبیعی۸(w، 0)، دودویی.رشته با صفر پایانی(w، 0).طول()، دودویی.دارد(w، 0، 0)
