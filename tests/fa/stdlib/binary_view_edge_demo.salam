    سرچاپ "utf-8 text"
    متن := "سلام"
    شمار بایت := متن.طول()
    نمای متن := دودویی.نمای بایت جدید(متن برگردان تهی*، شمار بایت)
    سرچاپ شمار بایت، دودویی.گرفتن طبیعی۸(نمای متن، 0)، دودویی.گرفتن طبیعی۸(نمای متن، 1)، دودویی.گرفتن طبیعی۱۶ بزرگ‌انتها(نمای متن، 0)، دودویی.گرفتن طبیعی۱۶ کوچک‌انتها(نمای متن، 0)
