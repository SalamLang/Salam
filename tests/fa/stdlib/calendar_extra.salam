بسته ریشه

واردسازی تقویم
واردسازی آزمایش

تابع ریشه:
    سرچاپ "julian day numbers"
    نوروز := تقویم.تاریخ جلالی { سال = 1403، ماه = 1، روز = 1 }
    شماره روز := تقویم.جلالی به روز ژولیانی(نوروز)
    میلادی := تقویم.تاریخ میلادی { سال = 2024، ماه = 3، روز = 20 }
    آزمایش.ادعای درستی(شماره روز برابر تقویم.میلادی به روز ژولیانی(میلادی))
    بازخوانی := تقویم.روز ژولیانی به جلالی(شماره روز)
    آزمایش.ادعای برابری عدد(بازخوانی.سال، 1403)
    آزمایش.ادعای برابری عدد(بازخوانی.ماه، 1)
    آزمایش.ادعای برابری عدد(بازخوانی.روز، 1)
    قبلی := تقویم.روز ژولیانی به جلالی(شماره روز - 1 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد(قبلی.سال، 1402)
    آزمایش.ادعای برابری عدد(قبلی.ماه، 12)
    آزمایش.ادعای برابری عدد(قبلی.روز، 29)
    آزمایش.ادعای درستی(تقویم.جلالی به روز ژولیانی(قبلی) برابر شماره روز - 1 برگردان صحیح۶۴)

    هجری := تقویم.روز ژولیانی به هجری(شماره روز)
    آزمایش.ادعای برابری عدد(هجری.سال، 1445)
    آزمایش.ادعای برابری عدد(هجری.ماه، 9)
    آزمایش.ادعای برابری عدد(هجری.روز، 10)
    سرچاپ هجری.سال، هجری.ماه، هجری.روز

    سرچاپ "epoch conversions"
    زمان یونیکس := تقویم.میلادی به زمان یونیکس(میلادی، 12، 0، 0)
    j := تقویم.زمان به جلالی(زمان یونیکس)
    سرچاپ j.سال، j.ماه، j.روز
    h := تقویم.زمان به هجری(زمان یونیکس)
    سرچاپ h.سال، h.ماه، h.روز
    آزمایش.ادعای برابری عدد(j.سال، 1403)
    آزمایش.ادعای برابری عدد(h.سال، هجری.سال)
    آزمایش.ادعای برابری عدد(h.ماه، هجری.ماه)
    آزمایش.ادعای برابری عدد(h.روز، هجری.روز)

    سرچاپ "jalali weeks"
    هفته۱ := تقویم.افزودن هفته جلالی(نوروز، 1)
    سرچاپ هفته۱.سال، هفته۱.ماه، هفته۱.روز
    هفته۲ := تقویم.افزودن هفته جلالی(نوروز، 5)
    سرچاپ هفته۲.سال، هفته۲.ماه، هفته۲.روز
    هفته۳ := تقویم.افزودن هفته جلالی(نوروز، 0 - 1)
    سرچاپ هفته۳.سال، هفته۳.ماه، هفته۳.روز
    هفته۴ := تقویم.افزودن هفته جلالی(نوروز، 0)
    آزمایش.ادعای درستی(تقویم.مقایسه تاریخ جلالی(هفته۴، نوروز) برابر 0)

    سرچاپ "hijri month end and names"
    رمضان := تقویم.تاریخ هجری قمری { سال = 1445، ماه = 9، روز = 9 }
    آخر := تقویم.پایان ماه هجری(رمضان)
    سرچاپ آخر.سال، آخر.ماه، آخر.روز
    آزمایش.ادعای برابری عدد(آخر.روز، تقویم.روزهای ماه هجری(1445، 9))
    سرچاپ تقویم.قالب طولانی هجری فارسی(رمضان)
    سرچاپ تقویم.قالب طولانی هجری فارسی(آخر)

    سرچاپ "fixed zones"
    مکه := تقویم.منطقه زمانی مکه()
    سرچاپ مکه.نام، مکه.اختلاف دقیقه‌ای
    استانبول := تقویم.منطقه زمانی استانبول()
    سرچاپ استانبول.نام، استانبول.اختلاف دقیقه‌ای
    لندن := تقویم.منطقه زمانی لندن()
    سرچاپ لندن.نام، لندن.اختلاف دقیقه‌ای

    سرچاپ "zone offsets in seconds"
    زمستان := تقویم.میلادی به زمان یونیکس(تقویم.تاریخ میلادی { سال = 2024، ماه = 1، روز = 15 }، 12، 0، 0)
    تابستان := تقویم.میلادی به زمان یونیکس(تقویم.تاریخ میلادی { سال = 2024، ماه = 7، روز = 15 }، 12، 0، 0)
    ناپایا منطقه لندن := تقویم.بارگذاری منطقه("Europe/London")
    اگر منطقه لندن.بارگذاری شد:
        سرچاپ تقویم.اختلاف ثانیه منطقه(منطقه لندن، زمستان)، تقویم.اختلاف ثانیه منطقه(منطقه لندن، تابستان)
    وگرنه:
        سرچاپ 0، 3600
    پایان
    تقویم.آزادسازی منطقه(منطقه لندن)
    ناپایا ناموجود := تقویم.بارگذاری منطقه("Nowhere/Atlantis")
    سرچاپ تقویم.اختلاف ثانیه منطقه(ناموجود، زمستان)
    تقویم.آزادسازی منطقه(ناموجود)
    برگشت آزمایش.خلاصه()
پایان
