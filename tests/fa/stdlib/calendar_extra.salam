بسته ریشه

واردسازی تقویم
واردسازی آزمایش

تابع ریشه:
    سرچاپ "julian day numbers"
    nowruz := تقویم.تاریخ جلالی { سال = 1403، ماه = 1، روز = 1 }
    jdn := تقویم.جلالی به روز ژولیانی(nowruz)
    greg := تقویم.تاریخ میلادی { سال = 2024، ماه = 3، روز = 20 }
    آزمایش.ادعای درستی(jdn برابر تقویم.میلادی به روز ژولیانی(greg))
    back := تقویم.روز ژولیانی به جلالی(jdn)
    آزمایش.ادعای برابری عدد(back.سال، 1403)
    آزمایش.ادعای برابری عدد(back.ماه، 1)
    آزمایش.ادعای برابری عدد(back.روز، 1)
    prev := تقویم.روز ژولیانی به جلالی(jdn - 1 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد(prev.سال، 1402)
    آزمایش.ادعای برابری عدد(prev.ماه، 12)
    آزمایش.ادعای برابری عدد(prev.روز، 29)
    آزمایش.ادعای درستی(تقویم.جلالی به روز ژولیانی(prev) برابر jdn - 1 برگردان صحیح۶۴)

    hij := تقویم.روز ژولیانی به هجری(jdn)
    آزمایش.ادعای برابری عدد(hij.سال، 1445)
    آزمایش.ادعای برابری عدد(hij.ماه، 9)
    آزمایش.ادعای برابری عدد(hij.روز، 10)
    سرچاپ hij.سال، hij.ماه، hij.روز

    سرچاپ "epoch conversions"
    epoch := تقویم.میلادی به زمان یونیکس(greg، 12، 0، 0)
    j := تقویم.زمان به جلالی(epoch)
    سرچاپ j.سال، j.ماه، j.روز
    h := تقویم.زمان به هجری(epoch)
    سرچاپ h.سال، h.ماه، h.روز
    آزمایش.ادعای برابری عدد(j.سال، 1403)
    آزمایش.ادعای برابری عدد(h.سال، hij.سال)
    آزمایش.ادعای برابری عدد(h.ماه، hij.ماه)
    آزمایش.ادعای برابری عدد(h.روز، hij.روز)

    سرچاپ "jalali weeks"
    w1 := تقویم.افزودن هفته جلالی(nowruz، 1)
    سرچاپ w1.سال، w1.ماه، w1.روز
    w2 := تقویم.افزودن هفته جلالی(nowruz، 5)
    سرچاپ w2.سال، w2.ماه، w2.روز
    w3 := تقویم.افزودن هفته جلالی(nowruz، 0 - 1)
    سرچاپ w3.سال، w3.ماه، w3.روز
    w4 := تقویم.افزودن هفته جلالی(nowruz، 0)
    آزمایش.ادعای درستی(تقویم.مقایسه تاریخ جلالی(w4، nowruz) برابر 0)

    سرچاپ "hijri month end and names"
    ramadan := تقویم.تاریخ هجری قمری { سال = 1445، ماه = 9، روز = 9 }
    last := تقویم.پایان ماه هجری(ramadan)
    سرچاپ last.سال، last.ماه، last.روز
    آزمایش.ادعای برابری عدد(last.روز، تقویم.روزهای ماه هجری(1445، 9))
    سرچاپ تقویم.قالب طولانی هجری فارسی(ramadan)
    سرچاپ تقویم.قالب طولانی هجری فارسی(last)

    سرچاپ "fixed zones"
    mecca := تقویم.منطقه زمانی مکه()
    سرچاپ mecca.نام، mecca.اختلاف دقیقه‌ای
    istanbul := تقویم.منطقه زمانی استانبول()
    سرچاپ istanbul.نام، istanbul.اختلاف دقیقه‌ای
    london := تقویم.منطقه زمانی لندن()
    سرچاپ london.نام، london.اختلاف دقیقه‌ای

    سرچاپ "zone offsets in seconds"
    winter := تقویم.میلادی به زمان یونیکس(تقویم.تاریخ میلادی { سال = 2024، ماه = 1، روز = 15 }، 12، 0، 0)
    summer := تقویم.میلادی به زمان یونیکس(تقویم.تاریخ میلادی { سال = 2024، ماه = 7، روز = 15 }، 12، 0، 0)
    ناپایا ldn := تقویم.بارگذاری منطقه("Europe/London")
    اگر ldn.بارگذاری شد:
        سرچاپ تقویم.اختلاف ثانیه منطقه(ldn، winter)، تقویم.اختلاف ثانیه منطقه(ldn، summer)
    وگرنه:
        سرچاپ 0، 3600
    پایان
    تقویم.آزادسازی منطقه(ldn)
    ناپایا missing := تقویم.بارگذاری منطقه("Nowhere/Atlantis")
    سرچاپ تقویم.اختلاف ثانیه منطقه(missing، winter)
    تقویم.آزادسازی منطقه(missing)
    برگشت آزمایش.خلاصه()
پایان
