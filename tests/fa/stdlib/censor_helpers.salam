واردسازی شبکه.سانسورشکن
واردسازی فشرده سازی

پایا HELLO := ``

تابع same(a: فشرده سازی.بافر بایت، b: فشرده سازی.بافر بایت): منطقی:
    برگشت فشرده سازی.برابری بافر(a، b)
پایان

تابع sum(v: وکتور<صحیح>): صحیح:
    ناپایا t := 0
    تکرار v.طول() در i:
        t += v.بگیر(i)
    پایان
    برگشت t
پایان

تابع payload_of(pieces: وکتور<فشرده سازی.بافر بایت>): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    تکرار pieces.طول() در i:
        b := pieces.بگیر(i)
        فشرده سازی.افزودن بایت‌ها(out، ((b.داده برگردان صحیح۶۴) + 5) برگردان تهی*، b.طول - 5)
    پایان
    برگشت out
پایان

تابع ریشه:
    hello := سانسورشکن.از هگز(HELLO)
    سرچاپ "hello bytes"، hello.طول
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل(hello.داده، hello.طول))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل("GET / HTTP/1.1" برگردان تهی*، 14))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل("POST /x" برگردان تهی*، 7))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل("SSH-2.0-OpenSSH_9.6" برگردان تهی*، 19))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل("GE" برگردان تهی*، 2))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل("zzzz" برگردان تهی*، 4))
    s5 := سانسورشکن.از هگز("050100")
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل(s5.داده، s5.طول))
    s4 := سانسورشکن.از هگز("0401005000000001")
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل(s4.داده، s4.طول))

    ch := سانسورشکن.تجزیه پیام آغازین(hello.داده، hello.طول)
    سرچاپ ch.معتبر، ch.ناقص، ch.طول رکورد
    سرچاپ ch.نام سرور، ch.جایگاه نام سرور، ch.طول نام سرور
    سرچاپ ch.نسخه رکورد، ch.نسخه پیام، ch.طول شناسه نشست، ch.شمار رمزها، ch.شمار افزونه‌ها
    سرچاپ ch.دارای تی ال اس سیزده، ch.دارای ای سی اچ، ch.پروتکل‌های برنامه.طول()، ch.پروتکل‌های برنامه.بگیر(0)، ch.پروتکل‌های برنامه.بگیر(1)
    سرچاپ سانسورشکن.استخراج نام سرور(hello.داده، 200)
    cut := سانسورشکن.تجزیه پیام آغازین(hello.داده، 200)
    سرچاپ cut.معتبر، cut.ناقص، cut.نام سرور
    سرچاپ سانسورشکن.تجزیه پیام آغازین(hello.داده، 60).نام سرور.طول()
    سرچاپ سانسورشکن.تجزیه پیام آغازین("GET / HTTP/1.1" برگردان تهی*، 14).معتبر

    even := سانسورشکن.اندازه تکه‌ها(100، سانسورشکن.تقسیم مساوی، 3، 0، 1 برگردان صحیح۶۴)
    سرچاپ even.بگیر(0)، even.بگیر(1)، even.بگیر(2)، sum(even)
    rnd := سانسورشکن.اندازه تکه‌ها(1000، سانسورشکن.تقسیم تصادفی، 5، 0، 42 برگردان صحیح۶۴)
    سرچاپ rnd.طول()، sum(rnd)
    rnd2 := سانسورشکن.اندازه تکه‌ها(1000، سانسورشکن.تقسیم تصادفی، 5، 0، 42 برگردان صحیح۶۴)
    سرچاپ rnd.بگیر(0) برابر rnd2.بگیر(0)، rnd.بگیر(4) برابر rnd2.بگیر(4)
    first := سانسورشکن.اندازه تکه‌ها(517، سانسورشکن.تقسیم پس از نخستین تکه، 2، 5، 0 برگردان صحیح۶۴)
    سرچاپ first.بگیر(0)، first.بگیر(1)
    many := سانسورشکن.اندازه تکه‌ها(3، سانسورشکن.تقسیم مساوی، 10، 0، 0 برگردان صحیح۶۴)
    سرچاپ many.طول()، sum(many)

    ssz := سانسورشکن.اندازه تکه‌ها از روی نام سرور(hello.داده، hello.طول، نادرست)
    سرچاپ ssz.بگیر(0)، ssz.بگیر(1)، sum(ssz)
    ssz2 := سانسورشکن.اندازه تکه‌ها از روی نام سرور(hello.داده، hello.طول، درست)
    سرچاپ ssz2.طول()، ssz2.بگیر(0)، ssz2.بگیر(1)، sum(ssz2)

    ناپایا parts := سانسورشکن.برش(hello.داده، hello.طول، ssz)
    joined := سانسورشکن.پیوست(parts)
    سرچاپ parts.طول()، same(joined، hello)
    سانسورشکن.آزاد کردن تکه‌ها(parts)

    ناپایا recs := سانسورشکن.تکه‌تکه کردن پیام آغازین(hello.داده، hello.طول، 4، سانسورشکن.تقسیم مساوی، 0 برگردان صحیح۶۴)
    سرچاپ recs.طول()
    first_rec := recs.بگیر(0)
    سرچاپ first_rec.طول، فشرده سازی.دریافت بایت(first_rec، 0)، فشرده سازی.دریافت بایت(first_rec، 1)، فشرده سازی.دریافت بایت(first_rec، 2)، فشرده سازی.دریافت بایت(first_rec، 3) * 256 + فشرده سازی.دریافت بایت(first_rec، 4)
    ناپایا orig_payload := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(orig_payload، ((hello.داده برگردان صحیح۶۴) + 5) برگردان تهی*، hello.طول - 5)
    سرچاپ same(payload_of(recs)، orig_payload)
    all := سانسورشکن.پیوست(recs)
    سرچاپ all.طول، all.طول برابر hello.طول + 15
    سانسورشکن.آزاد کردن تکه‌ها(recs)

    body := "secret payload"
    wrapped := سانسورشکن.پوشاندن رکورد(body برگردان تهی*، body.طول()، 20)
    سرچاپ wrapped.طول، فشرده سازی.دریافت بایت(wrapped، 0)، فشرده سازی.دریافت بایت(wrapped، 1)، فشرده سازی.دریافت بایت(wrapped، 2)
    ناپایا got := فشرده سازی.بافر بایت جدید()
    سرچاپ سانسورشکن.گشودن رکورد(wrapped.داده، wrapped.طول، got)، got.طول
    سرچاپ سانسورشکن.گشودن رکورد(wrapped.داده، wrapped.طول - 1، got)
    سرچاپ سانسورشکن.گشودن رکورد(hello.داده، hello.طول، got)
    ناپایا big := فشرده سازی.بافر بایت جدید()
    تکرار 40000 در i:
        فشرده سازی.افزودن بایت(big، i % 251)
    پایان
    stream := سانسورشکن.پوشاندن جریان(big.داده، big.طول، 5، 50)
    ناپایا back := فشرده سازی.بافر بایت جدید()
    ناپایا off := 0
    ناپایا nrec := 0
    تا off کوچکتر stream.طول:
        used := سانسورشکن.گشودن رکورد(((stream.داده برگردان صحیح۶۴) + (off برگردان صحیح۶۴)) برگردان تهی*، stream.طول - off، back)
        اگر used کوچکتربرابر 0:
            بشکن
        پایان
        off += used
        nrec++
    پایان
    سرچاپ nrec، same(back، big)، off برابر stream.طول
    pl := سانسورشکن.طول لایه(100، 10، 10، 64)
    سرچاپ pl
    سرچاپ سانسورشکن.بایت‌های تصادفی(32).طول، سانسورشکن.عدد تصادفی(5، 5)
    r := سانسورشکن.عدد تصادفی(10، 20)
    سرچاپ r بزرگتربرابر 10، r کوچکتربرابر 20

    ناپایا set := سانسورشکن.مجموعه دامنه جدید()
    سرچاپ سانسورشکن.افزودن قاعده(set، "example.com")، سانسورشکن.افزودن قاعده(set، "full:only.test.org")، سانسورشکن.افزودن قاعده(set، "keyword:torrent")، سانسورشکن.افزودن قاعده(set، "domain:*.cdn.net")، سانسورشکن.افزودن قاعده(set، "regexp:a.*")، سانسورشکن.افزودن قاعده(set، "  ")
    سرچاپ سانسورشکن.افزودن قاعده‌ها(set، "# comment\nblocked.io # trailing\n\nfoo.bar\n")
    سرچاپ سانسورشکن.تطبیق دامنه(set، "example.com")، سانسورشکن.تطبیق دامنه(set، "WWW.Example.COM.")، سانسورشکن.تطبیق دامنه(set، "badexample.com")
    سرچاپ سانسورشکن.تطبیق دامنه(set، "only.test.org")، سانسورشکن.تطبیق دامنه(set، "x.only.test.org")، سانسورشکن.تطبیق دامنه(set، "my-torrent-site.xyz")
    سرچاپ سانسورشکن.تطبیق دامنه(set، "a.b.cdn.net")، سانسورشکن.تطبیق دامنه(set، "x.blocked.io")، سانسورشکن.تطبیق دامنه(set، "net")

    ناپایا cl := سانسورشکن.دسته‌بند جدید(سانسورشکن.تصمیم پراکسی)
    cl.مستقیم = سانسورشکن.مجموعه مستقیم ایران()
    cl.مسدود = سانسورشکن.مجموعه دامنه جدید()
    سرچاپ سانسورشکن.افزودن قاعده(cl.مسدود، "ads.example.org")
    سرچاپ سانسورشکن.دسته‌بندی(cl، "www.digikala.com")، سانسورشکن.دسته‌بندی(cl، "mail.sharif.ir")، سانسورشکن.دسته‌بندی(cl، "youtube.com")، سانسورشکن.دسته‌بندی(cl، "ads.example.org")، سانسورشکن.دسته‌بندی(cl، "192.168.1.5")، سانسورشکن.دسته‌بندی(cl، "172.20.0.1")، سانسورشکن.دسته‌بندی(cl، "172.40.0.1")
    filtered := سانسورشکن.مجموعه فیلترشده()
    سرچاپ سانسورشکن.تطبیق دامنه(filtered، "m.youtube.com")، سانسورشکن.تطبیق دامنه(filtered، "digikala.com")

    ناپایا g := سانسورشکن.نگهبان کاوش جدید(3، 1000 برگردان صحیح۶۴، 5000 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.اجازه نگهبان(g، "1.2.3.4"، 0 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.ثبت شکست(g، "1.2.3.4"، 100 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(g، "1.2.3.4"، 200 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(g، "1.2.3.4"، 300 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.اجازه نگهبان(g، "1.2.3.4"، 400 برگردان صحیح۶۴)، سانسورشکن.اجازه نگهبان(g، "5.6.7.8"، 400 برگردان صحیح۶۴)، سانسورشکن.اجازه نگهبان(g، "1.2.3.4"، 5400 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.ثبت شکست(g، "9.9.9.9"، 0 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(g، "9.9.9.9"، 2000 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(g، "9.9.9.9"، 2100 برگردان صحیح۶۴)
    ناپایا rc := سانسورشکن.حافظه تکرار جدید(1000 برگردان صحیح۶۴، 4)
    سرچاپ سانسورشکن.تکراری است(rc، "a"، 0 برگردان صحیح۶۴)، سانسورشکن.تکراری است(rc، "a"، 500 برگردان صحیح۶۴)، سانسورشکن.تکراری است(rc، "a"، 1600 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.باید جایگزین شود(نادرست)، سانسورشکن.باید جایگزین شود(درست)
    سرچاپ سانسورشکن.پاسخ طعمه().زیررشته(0، 22)
پایان
