واردسازی شبکه.سانسورشکن
واردسازی فشرده سازی

تابع ریشه:
    ناپایا b := سانسورشکن.از هگز("00ff10")
    سرچاپ سانسورشکن.به هگز(b)
    فشرده سازی.آزادسازی بافر(b)

    ناپایا ds := سانسورشکن.مجموعه دامنه جدید()
    سانسورشکن.آزاد کردن مجموعه دامنه(ds)
    سرچاپ سانسورشکن.میزبان خصوصی("192.168.1.5")، سانسورشکن.میزبان خصوصی("example.com")
    سرچاپ سانسورشکن.فهرست مستقیم ایران().طول() بزرگتر 0، سانسورشکن.فهرست فیلترشده().طول() بزرگتر 0

    ناپایا g := سانسورشکن.نگهبان کاوش جدید(3، 60000 برگردان صحیح۶۴، 600000 برگردان صحیح۶۴)
    سانسورشکن.ثبت موفقیت(g، "10.0.0.1")
    سرچاپ سانسورشکن.اجازه نگهبان(g، "10.0.0.1"، 1 برگردان صحیح۶۴)
    سانسورشکن.آزاد کردن نگهبان(g)

    ناپایا rc := سانسورشکن.حافظه تکرار جدید(1000 برگردان صحیح۶۴، 16)
    سرچاپ سانسورشکن.تکراری است(rc، "k"، 1 برگردان صحیح۶۴)
    سانسورشکن.آزاد کردن حافظه تکرار(rc)

    d := سانسورشکن.تاخیر تصادفی(5، 9)
    سرچاپ d بزرگتربرابر 5 و d کوچکتربرابر 9

    ناپایا sizes := وکتور {} برگردان وکتور<صحیح>
    sizes.بیفزا(2)
    sizes.بیفزا(3)
    rec := سانسورشکن.از هگز("1603010005aabbccddee")
    ناپایا parts := سانسورشکن.تکه‌تکه کردن رکوردها(rec.داده، rec.طول، sizes)
    سرچاپ parts.طول()
    تکرار parts.طول() در i:
        سرچاپ سانسورشکن.به هگز(parts.بگیر(i))
    پایان
پایان
