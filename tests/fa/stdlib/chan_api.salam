بسته ریشه

واردسازی کانال

تابع ریشه:
    c := کانال.جدید(3 برگردان صحیح۶۴) برگردان کانال.کانال<رشته>
    سرچاپ "cap:"، کانال.ظرفیت(c)، "len:"، کانال.طول(c)

    values := وکتور {} برگردان وکتور<رشته>
    values.بیفزا("a")
    values.بیفزا("b")
    سرچاپ "send all:"، کانال.فرستادن همه(c، values)
    سرچاپ "queued:"، کانال.طول(c)
    values.آزادکن()

    ناپایا ok := نادرست
    سرچاپ "recv:"، کانال.دریافت(c، ok)، ok
    سرچاپ "try recv:"، کانال.کوشش برای دریافت(c، ok)، ok
    کانال.بستن(c)
    سرچاپ "closed:"، کانال.بسته است(c)، "send after close:"، کانال.کوشش برای فرستادن(c، "x")

    rest := کانال.تخلیه(c)
    سرچاپ "drained:"، rest.طول()
    rest.آزادکن()

    slow := کانال.جدید(1 برگردان صحیح۶۴) برگردان کانال.کانال<صحیح۶۴>
    سرچاپ "send timeout:"، کانال.فرستادن با مهلت(slow، 1 برگردان صحیح۶۴، 100 برگردان صحیح۶۴)
    سرچاپ "send timeout full:"، کانال.فرستادن با مهلت(slow، 2 برگردان صحیح۶۴، 20 برگردان صحیح۶۴)

    idle := کانال.جدید(0 برگردان صحیح۶۴) برگردان کانال.کانال<صحیح۶۴>
    ناپایا timed_out := درست
    _ := کانال.دریافت با مهلت(idle، timed_out، 20 برگردان صحیح۶۴)
    سرچاپ "recv timeout:"، timed_out

    nums := وکتور {} برگردان وکتور<صحیح۶۴>
    nums.بیفزا(1 برگردان صحیح۶۴)
    nums.بیفزا(2 برگردان صحیح۶۴)
    taken := کانال.برداشتن(slow، 1 برگردان صحیح۶۴)
    سرچاپ "take:"، taken.طول()
    taken.آزادکن()
    nums.آزادکن()

    a := کانال.جدید(1 برگردان صحیح۶۴) برگردان کانال.کانال<صحیح۶۴>
    b := کانال.جدید(1 برگردان صحیح۶۴) برگردان کانال.کانال<صحیح۶۴>
    ناپایا cs := وکتور {} برگردان وکتور<کانال.کانال<صحیح۶۴>>
    cs.بیفزا(a)
    cs.بیفزا(b)
    ناپایا got := 0 برگردان صحیح۶۴
    سرچاپ "try select:"، کانال.کوشش برای گزینش(cs، got)

    کانال.فرستادن(b، 7 برگردان صحیح۶۴)
    سرچاپ "select recv:"، کانال.گزینش دریافت(cs، got، ok، 100 برگردان صحیح۶۴)، got، ok
    سرچاپ "select send:"، کانال.گزینش فرستادن(cs، 9 برگردان صحیح۶۴، 100 برگردان صحیح۶۴)
    سرچاپ "select send again:"، کانال.گزینش فرستادن(cs، 10 برگردان صحیح۶۴، 100 برگردان صحیح۶۴)
    سرچاپ "select send full:"، کانال.کوشش برای گزینش فرستادن(cs، 11 برگردان صحیح۶۴)

    cs.آزادکن()
    a.آزادسازی()
    b.آزادسازی()
    idle.آزادسازی()
    slow.آزادسازی()
پایان
