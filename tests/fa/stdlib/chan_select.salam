بسته ریشه

واردسازی کانال
واردسازی استخر

تابع ریشه:
    ناپایا a := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
    ناپایا b := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
    a.مقداردهی(4 برگردان صحیح۶۴)
    b.مقداردهی(4 برگردان صحیح۶۴)
    ناپایا cs := وکتور {} برگردان وکتور<کانال.کانال<صحیح۶۴>>
    cs.بیفزا(a)
    cs.بیفزا(b)
    p := استخر.جدید(2 برگردان صحیح۶۴، 4 برگردان صحیح۶۴)
    استخر.ارسال(p، (): b.فرستادن(42 برگردان صحیح۶۴) پایان)
    ناپایا got := 0 برگردان صحیح۶۴
    idx := کانال.گزینش(cs، got، 1000 برگردان صحیح۶۴)
    سرچاپ "from: "، idx، " value: "، got
    سرچاپ "timeout: "، کانال.گزینش(cs، got، 20 برگردان صحیح۶۴)
    a.بستن()
    b.بستن()
    سرچاپ "closed: "، کانال.گزینش(cs، got، 20 برگردان صحیح۶۴)
    استخر.توقف(p)
    a.آزادسازی()
    b.آزادسازی()
پایان
