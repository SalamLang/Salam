بسته ریشه

واردسازی کانال
واردسازی استخر
واردسازی همگام سازی

ناپایا a := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
ناپایا b := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>

تابع late_sender():
    همگام سازی.خواب میلی ثانیه(100)
    b.فرستادن(5 برگردان صحیح۶۴)
پایان

تابع ریشه:
    a.مقداردهی(1 برگردان صحیح۶۴)
    b.مقداردهی(0 برگردان صحیح۶۴)
    ناپایا all := وکتور {} برگردان وکتور<کانال.کانال<صحیح۶۴>>
    all.بیفزا(a)
    all.بیفزا(b)
    p := استخر.جدید(2 برگردان صحیح۶۴، 4 برگردان صحیح۶۴)
    استخر.ارسال(p، (): late_sender() پایان)
    ناپایا v := 0 برگردان صحیح۶۴
    t0 := همگام سازی.اکنون میلی ثانیه()
    idx := کانال.گزینش(all، v، 0 برگردان صحیح۶۴ - 1)
    waited := همگام سازی.اکنون میلی ثانیه() - t0
    سرچاپ "index: "، idx، " value: "، v
    سرچاپ "waited for the sender: "، waited بزرگتربرابر 90
    سرچاپ "woke promptly: "، waited کوچکتر 400
    استخر.انتظار(p)

    ناپایا total := 0 برگردان صحیح۶۴
    تکرار 200:
        استخر.ارسال(p، (): a.فرستادن(1 برگردان صحیح۶۴) پایان)
        کانال.گزینش(all، v، 1000 برگردان صحیح۶۴)
        total += v
    پایان
    استخر.انتظار(p)
    سرچاپ "received: "، total

    a.بستن()
    سرچاپ "closed one: "، کانال.گزینش(all، v، 20 برگردان صحیح۶۴)
    b.بستن()
    سرچاپ "all closed: "، کانال.گزینش(all، v، 20 برگردان صحیح۶۴)
    استخر.توقف(p)
    a.آزادسازی()
    b.آزادسازی()
پایان
