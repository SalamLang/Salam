بسته ریشه

واردسازی خط فرمان
واردسازی پرچم
واردسازی اشکال زدایی

تابع ریشه:
    ناپایا برنامه := خط فرمان.جدید("tool"، "demo tool"، "1.2.0")
    خط فرمان.ثبت(برنامه، "build"، "compile the project")
    خط فرمان.ثبت(برنامه، "test"، "run the tests")
    سرچاپ خط فرمان.شرح دستور(برنامه، "build")
    سرچاپ خط فرمان.شرح دستور(برنامه، "test")
    سرچاپ خط فرمان.شرح دستور(برنامه، "deploy").طول()

    ناپایا پرچم‌ها := پرچم.جدید("tool build"، "build")
    پرچم.افزودن رشته(پرچم‌ها، "out"، "o"، "a.out"، "output")
    پرچم.افزودن منطقی(پرچم‌ها، "fast"، "f"، نادرست، "fast mode")
    پرچم.افزودن صحیح(پرچم‌ها، "jobs"، "j"، 1، "jobs")
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    نام‌ها.بیفزا("out")
    نام‌ها.بیفزا("jobs")
    ناپایا ناموجودها := خط فرمان.الزامی بودن پرچم‌ها(پرچم‌ها، نام‌ها)
    سرچاپ ناموجودها.طول()
    ناپایا آرگومان‌ها := وکتور {} برگردان وکتور<رشته>
    آرگومان‌ها.بیفزا("--out")
    آرگومان‌ها.بیفزا("x.bin")
    سرچاپ پرچم.تجزیه(پرچم‌ها، آرگومان‌ها)
    ناموجودها = خط فرمان.الزامی بودن پرچم‌ها(پرچم‌ها، نام‌ها)
    سرچاپ ناموجودها.طول()
    سرچاپ ناموجودها.بگیر(0)
    پرچم.آزادسازی(پرچم‌ها)

    سرچاپ خط فرمان.درخواست با پیش فرض("Name"، "guest")
    سرچاپ خط فرمان.درخواست("Email").طول()

    سرچاپ اشکال زدایی.ردیابی فعال است()
    اشکال زدایی.فعال‌سازی ردیابی(درست)
    سرچاپ اشکال زدایی.ردیابی فعال است()
    اشکال زدایی.فعال‌سازی ردیابی(نادرست)
    سرچاپ اشکال زدایی.ردیابی فعال است()
پایان
