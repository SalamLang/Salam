بسته ریشه

واردسازی خط فرمان
واردسازی پرچم
واردسازی اشکال زدایی

تابع ریشه:
    ناپایا app := خط فرمان.جدید("tool"، "demo tool"، "1.2.0")
    خط فرمان.ثبت(app، "build"، "compile the project")
    خط فرمان.ثبت(app، "test"، "run the tests")
    سرچاپ خط فرمان.شرح دستور(app، "build")
    سرچاپ خط فرمان.شرح دستور(app، "test")
    سرچاپ خط فرمان.شرح دستور(app، "deploy").طول()

    ناپایا fs := پرچم.جدید("tool build"، "build")
    پرچم.افزودن رشته(fs، "out"، "o"، "a.out"، "output")
    پرچم.افزودن منطقی(fs، "fast"، "f"، نادرست، "fast mode")
    پرچم.افزودن صحیح(fs، "jobs"، "j"، 1، "jobs")
    ناپایا names := وکتور {} برگردان وکتور<رشته>
    names.بیفزا("out")
    names.بیفزا("jobs")
    ناپایا missing := خط فرمان.الزامی بودن پرچم‌ها(fs، names)
    سرچاپ missing.طول()
    ناپایا args := وکتور {} برگردان وکتور<رشته>
    args.بیفزا("--out")
    args.بیفزا("x.bin")
    سرچاپ پرچم.تجزیه(fs، args)
    missing = خط فرمان.الزامی بودن پرچم‌ها(fs، names)
    سرچاپ missing.طول()
    سرچاپ missing.بگیر(0)
    پرچم.آزادسازی(fs)

    سرچاپ خط فرمان.درخواست با پیش فرض("Name"، "guest")
    سرچاپ خط فرمان.درخواست("Email").طول()

    سرچاپ اشکال زدایی.ردیابی فعال است()
    اشکال زدایی.فعال‌سازی ردیابی(درست)
    سرچاپ اشکال زدایی.ردیابی فعال است()
    اشکال زدایی.فعال‌سازی ردیابی(نادرست)
    سرچاپ اشکال زدایی.ردیابی فعال است()
پایان
