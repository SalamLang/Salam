بسته جعلی

واردسازی رشته
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا _codes := وکتور {} برگردان وکتور<صحیح>
ناپایا _bodies := وکتور {} برگردان وکتور<رشته>
ناپایا _heads := وکتور {} برگردان وکتور<رشته>
ناپایا _next := 0
ناپایا _last := ""
ناپایا _count := 0

تابع _handle(h: صحیح۶۴):
    ctx := اچ تی تی پی.زمینه جدید(h)
    method := اچ تی تی پی.روش(ctx)
    path := اچ تی تی پی.مسیر(ctx)
    query := اچ تی تی پی.پرسمان خام(ctx)
    _count++
    ناپایا line := method + " " + path
    اگر query.طول() بزرگتر 0: line = line + "?" + query پایان
    user := اچ تی تی پی.سرصفحه(ctx، "X-ClickHouse-User")
    اگر user.طول() بزرگتر 0: line = line + "\n  user: " + user پایان
    key := اچ تی تی پی.سرصفحه(ctx، "X-ClickHouse-Key")
    اگر key.طول() بزرگتر 0: line = line + "\n  key: " + key پایان
    body := اچ تی تی پی.بدنه(ctx)
    اگر body.طول() بزرگتر 0: line = line + "\n  body: " + رشته.پیرایش راست(body) پایان
    _last = line
    اگر _next بزرگتربرابر _codes.طول():
        اچ تی تی پی.تنظیم وضعیت(ctx، 500)
        اچ تی تی پی.متن(ctx، "Code: 999. DB::Exception: no reply queued")
        برگشت
    پایان
    code := _codes.بگیر(_next)
    reply := _bodies.بگیر(_next)
    head := _heads.بگیر(_next)
    _next++
    اگر head.طول() بزرگتر 0:
        c := head.بیاب(":")
        اچ تی تی پی.تنظیم سرصفحه(ctx، head.زیررشته(0، c)، head.زیررشته(c + 1، head.طول() - c - 1))
    پایان
    اچ تی تی پی.تنظیم وضعیت(ctx، code)
    اچ تی تی پی.متن(ctx، reply)
پایان

همگانی تابع ثبت‌پاسخ(code: صحیح، body: رشته):
    _codes.بیفزا(code)
    _bodies.بیفزا(body)
    _heads.بیفزا("")
پایان

همگانی تابع ثبت‌پاسخ با سرآیند(code: صحیح، body: رشته، header: رشته):
    _codes.بیفزا(code)
    _bodies.بیفزا(body)
    _heads.بیفزا(header)
پایان

همگانی تابع آخرین(): رشته:
    برگشت _last
پایان

همگانی تابع شمار(): صحیح:
    برگشت _count
پایان

همگانی تابع آغاز آزاد(): صحیح:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/*"، _handle)
    مسیریاب.ارسال(r، "/*"، _handle)
    ناپایا s := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.استفاده(s، r)
    برگشت اچ تی تی پی.اجرا در پس زمینه با درگاه(s)
پایان
