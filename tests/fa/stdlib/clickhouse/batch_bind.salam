واردسازی رشته
واردسازی دیتابیس.کلیک هاوس

فراخوانی جعلی "_fake.salam"

ناپایا PORT := 0

تابع one(a: رشته): وکتور<رشته>:
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.بیفزا(a)
    برگشت v
پایان

تابع two(a: رشته، b: رشته): وکتور<رشته>:
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.بیفزا(a)
    v.بیفزا(b)
    برگشت v
پایان

تابع ریشه:
    سرچاپ کلیک هاوس.آرگومان رشته("a\\b'c\nd\te")
    سرچاپ کلیک هاوس.نقل قول شناسه("my`col")
    سرچاپ کلیک هاوس.آرگومان صحیح(-5 برگردان صحیح۶۴)، کلیک هاوس.آرگومان طبیعی(18446744073709551615 برگردان طبیعی۶۴)، کلیک هاوس.آرگومان اعشاری(2.5)
    سرچاپ کلیک هاوس.آرگومان منطقی(درست)، کلیک هاوس.آرگومان تهی()
    سرچاپ کلیک هاوس.آرگومان آرایه(two("1"، "2"))، کلیک هاوس.آرگومان چندتایی(two("1"، کلیک هاوس.آرگومان رشته("x")))
    سرچاپ کلیک هاوس.آرگومان نگاشت(one(کلیک هاوس.آرگومان رشته("k"))، one("1"))

    سرچاپ کلیک هاوس.پیوند("SELECT ? AS a, '?' AS b, \"?\" AS c, `?` AS d -- ?\n, ? /* ? */"، two("1"، "2"))
    سرچاپ "short:"، کلیک هاوس.پیوند("SELECT ?, ?"، one("1")).طول()
    سرچاپ "long:"، کلیک هاوس.پیوند("SELECT 1"، one("1")).طول()

    سرچاپ کلیک هاوس.نوع پایه("LowCardinality(Nullable(String))")، کلیک هاوس.نوع تهی‌پذیر است("LowCardinality(Nullable(String))")، کلیک هاوس.نوع تهی‌پذیر است("String")
    سرچاپ کلیک هاوس.نوع عنصر("Array(Nullable(Int32))")، کلیک هاوس.دسته نوع("Array(Int32)")، کلیک هاوس.دسته نوع("Decimal(18, 4)")، کلیک هاوس.دسته نوع("Date32")، کلیک هاوس.دسته نوع("Enum8('a' = 1)")

    جعلی.ثبت‌پاسخ(200، "")
    PORT = جعلی.آغاز آزاد()
    اگر PORT برابر 0:
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا o := کلیک هاوس.گزینه‌های پیش‌فرض()
    o.نشانی = "127.0.0.1:" + رشته.از عدد(PORT برگردان صحیح۶۴)
    ناپایا c := کلیک هاوس.باز کردن(o)

    ناپایا b := c.آماده‌سازی دسته("INSERT INTO events (id, name, tags);")
    سرچاپ "append:"، b.افزودن(three("1"، کلیک هاوس.آرگومان رشته("start")، کلیک هاوس.آرگومان آرایه(one(کلیک هاوس.آرگومان رشته("a")))))
    سرچاپ "append:"، b.افزودن(three("2"، کلیک هاوس.آرگومان رشته("stop")، کلیک هاوس.آرگومان آرایه(وکتور {} برگردان وکتور<رشته>)))
    سرچاپ "len:"، b.طول()
    سرچاپ "send:"، c.ارسال دسته(b)
    سرچاپ جعلی.آخرین()

    ناپایا short := c.آماده‌سازی دسته("INSERT INTO events (id, name) VALUES")
    سرچاپ "short append:"، short.افزودن(one("1"))، short.خطا()
    سرچاپ "short send:"، c.ارسال دسته(short)

    wrong := c.آماده‌سازی دسته("SELECT 1")
    سرچاپ "wrong:"، wrong.خطا()

    empty := c.آماده‌سازی دسته("INSERT INTO events")
    سرچاپ "empty send:"، c.ارسال دسته(empty)، c.خطا()
پایان

تابع three(a: رشته، b: رشته، c: رشته): وکتور<رشته>:
    ناپایا v := two(a، b)
    v.بیفزا(c)
    برگشت v
پایان
