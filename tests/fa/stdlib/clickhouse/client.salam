واردسازی رشته
واردسازی دیتابیس.کلیک هاوس

فراخوانی جعلی "_fake.salam"

ناپایا PORT := 0

تابع ریشه:
    جعلی.ثبت‌پاسخ(200، "Ok.\n")
    جعلی.ثبت‌پاسخ(200، "")
    جعلی.ثبت‌پاسخ با سرآیند(200، ""، "X-ClickHouse-Summary:{\"read_rows\":\"0\",\"written_rows\":\"3\"}")
    جعلی.ثبت‌پاسخ(404، "Code: 60. DB::Exception: Table default.nope does not exist. (UNKNOWN_TABLE)\n")
    جعلی.ثبت‌پاسخ(200، "Ok.\n")
    PORT = جعلی.آغاز آزاد()
    اگر PORT برابر 0:
        سرچاپ "fake server did not start"
        برگشت
    پایان
    addr := "127.0.0.1:" + رشته.از عدد(PORT برگردان صحیح۶۴)

    ناپایا o := کلیک هاوس.گزینه‌های پیش‌فرض()
    o.نشانی = addr
    o.پایگاه داده = "shop"
    o.نام کاربری = "alice"
    o.گذرواژه = "s3cret"
    o.تنظیمات.درج("max_threads"، "2")
    ناپایا c := کلیک هاوس.باز کردن(o)
    سرچاپ "ping:"، c.پینگ()
    سرچاپ جعلی.آخرین()

    سرچاپ "exec:"، c.اجرا("CREATE TABLE t (id UInt64) ENGINE = Memory"، وکتور {} برگردان وکتور<رشته>)
    سرچاپ جعلی.آخرین()

    ناپایا args := وکتور {} برگردان وکتور<رشته>
    args.بیفزا(کلیک هاوس.آرگومان صحیح(7 برگردان صحیح۶۴))
    args.بیفزا(کلیک هاوس.آرگومان رشته("o'brien"))
    سرچاپ "exec args:"، c.اجرا("INSERT INTO t VALUES (?, ?)"، args)
    سرچاپ جعلی.آخرین()

    سرچاپ "written:"، c.ردیف‌های نوشته
    سرچاپ "bad:"، c.اجرا("DROP TABLE nope"، وکتور {} برگردان وکتور<رشته>)
    سرچاپ "code:"، c.کد()، "ok:"، c.معتبر()
    سرچاپ "error:"، رشته.پیرایش(c.خطا())
    سرچاپ "ping again:"، c.پینگ()
    c.بستن()
    سرچاپ "closed ping:"، c.پینگ()، c.خطا()

    d := کلیک هاوس.باز کردن نشانی("clickhouse://bob:p%40ss@db.example.com:9001/logs?secure=false&max_threads=4")
    سرچاپ d.پایه، d.گزینه‌ها.نام کاربری، d.گزینه‌ها.گذرواژه، d.گزینه‌ها.پایگاه داده، d.گزینه‌ها.تنظیمات.بگیر("max_threads")
    e := کلیک هاوس.باز کردن نشانی("https://host.example.com")
    سرچاپ e.پایه، e.گزینه‌ها.نام کاربری
    f := کلیک هاوس.باز کردن نشانی("not a url")
    سرچاپ "bad url:"، f.معتبر()، f.خطا()
پایان
