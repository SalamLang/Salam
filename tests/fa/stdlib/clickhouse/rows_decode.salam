واردسازی رشته
واردسازی دیتابیس.کلیک هاوس

فراخوانی جعلی "_fake.salam"

پایا SAMPLE := `{"meta":[{"name":"id","type":"UInt64"},{"name":"delta","type":"Int64"},{"name":"name","type":"Nullable(String)"},{"name":"score","type":"Float64"},{"name":"tags","type":"Array(String)"},{"name":"at","type":"DateTime('UTC')"},{"name":"ok","type":"Bool"}],"data":[["18446744073709551615","-9223372036854775808","line \"one\"\nsecond",1.5,["a","b,c"],"2024-05-06 07:08:09",true],["1","42",null,"nan",[],"2024-05-06 07:08:10",false]],"rows":2,"statistics":{"elapsed":0.001,"rows_read":2,"bytes_read":64}}`

ناپایا PORT := 0

تابع ریشه:
    جعلی.ثبت‌پاسخ(200، SAMPLE)
    جعلی.ثبت‌پاسخ(200، `{"meta":[{"name":"version()","type":"String"}],"data":[["24.8.1.1"]],"rows":1}`)
    جعلی.ثبت‌پاسخ(200، `{"meta":[{"name":"n","type":"UInt64"}],"data":[["9007199254740993"]],"rows":1}`)
    جعلی.ثبت‌پاسخ(200، `{"meta":[],"data":[],"rows":0}`)
    جعلی.ثبت‌پاسخ(500، "Code: 62. DB::Exception: Syntax error: failed at position 1. (SYNTAX_ERROR)\n")
    PORT = جعلی.آغاز آزاد()
    اگر PORT برابر 0:
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا o := کلیک هاوس.گزینه‌های پیش‌فرض()
    o.نشانی = "127.0.0.1:" + رشته.از عدد(PORT برگردان صحیح۶۴)
    ناپایا c := کلیک هاوس.باز کردن(o)

    ناپایا args := وکتور {} برگردان وکتور<رشته>
    args.بیفزا(کلیک هاوس.آرگومان طبیعی(1 برگردان طبیعی۶۴))
    ناپایا rows := c.پرسمان("SELECT * FROM t WHERE id >= ?"، args)
    سرچاپ جعلی.آخرین()
    سرچاپ "ok:"، rows.معتبر()، "cols:"، rows.تعداد ستون()، "rows:"، rows.تعداد ردیف()
    تکرار rows.تعداد ستون() در i:
        سرچاپ i، rows.نام ستون(i)، rows.نوع ستون(i)، rows.دسته ستون(i)
    پایان
    تا rows.بعدی():
        سرچاپ "id:"، rows.طبیعی۶۴(0)، "delta:"، rows.صحیح۶۴(1)
        سرچاپ "name:"، rows.تهی است(2)، rows.متن(2)
        سرچاپ "score:"، rows.اعشار(3)، "ok:"، rows.منطقی(6)
        tags := rows.فهرست(4)
        سرچاپ "tags:"، tags.طول()، rows.خام(4)
        سرچاپ "at:"، rows.متن با نام("at")، rows.شماره ستون("at")، rows.شماره ستون("zzz")
    پایان
    rows.بستن()

    سرچاپ "version:"، c.نسخه کارگزار()
    سرچاپ "big:"، c.پرسمان عدد("SELECT 2 * 4503599627370496 + 1")
    سرچاپ جعلی.آخرین()

    empty := c.پرسمان("SELECT 1 WHERE 0"، وکتور {} برگردان وکتور<رشته>)
    سرچاپ "empty:"، empty.معتبر()، empty.تعداد ردیف()، empty.تعداد ستون()

    bad := c.پرسمان("SELEC 1"، وکتور {} برگردان وکتور<رشته>)
    سرچاپ "bad:"، bad.معتبر()، c.کد()
    سرچاپ bad.خطا()

    ناپایا few := وکتور {} برگردان وکتور<رشته>
    few.بیفزا("1")
    r2 := c.پرسمان("SELECT ?, ?"، few)
    سرچاپ "mismatch:"، r2.معتبر()، r2.خطا()
پایان
