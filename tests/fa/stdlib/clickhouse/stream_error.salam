واردسازی رشته
واردسازی دیتابیس
واردسازی دیتابیس.کلیک هاوس

فراخوانی جعلی "_fake.salam"

ناپایا PORT := 0

تابع ریشه:
    good := `{"meta":[{"name":"n","type":"UInt8"}],"data":[[1],[2]],"rows":2}` + "\n"
    جعلی.ثبت‌پاسخ(200، good + "Code: 395. DB::Exception: Value passed to 'throwIf' function is non-zero. (FUNCTION_THROW_IF_VALUE_IS_NON_ZERO)\n")
    جعلی.ثبت‌پاسخ با سرآیند(200، ""، "X-ClickHouse-Exception-Code:241")
    جعلی.ثبت‌پاسخ(200، `{"meta":[],"data":[` + "\n\r\n__exception__\r\nabcdefghijklmnop\r\nCode: 241. DB::Exception: Memory limit exceeded\r\n55 abcdefghijklmnop\r\n__exception__\r\n")
    جعلی.ثبت‌پاسخ(200، good)
    جعلی.ثبت‌پاسخ(200، `{"meta":[{"name":"s","type":"String"}],"data":[["Code: 1. DB::Exception"]],"rows":1}` + "\n")
    جعلی.ثبت‌پاسخ(200، `{"meta":[{"name":"a","type":"UInt8"},{"name":"b","type":"String"}],"data":[[7,"x"]],"rows":1}` + "\n")
    جعلی.ثبت‌پاسخ(200، "")
    جعلی.ثبت‌پاسخ(200، `{"meta":[{"name":"n","type":"Int64"},{"name":"f","type":"Float64"},{"name":"s","type":"String"}],"data":[["5",1.5,"hi"],["6",2.5,null]],"rows":2}` + "\n")
    جعلی.ثبت‌پاسخ(200، "")
    جعلی.ثبت‌پاسخ(404، "Code: 60. DB::Exception: no table\n")
    PORT = جعلی.آغاز آزاد()
    اگر PORT برابر 0:
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا o := کلیک هاوس.گزینه‌های پیش‌فرض()
    o.نشانی = "127.0.0.1:" + رشته.از عدد(PORT برگردان صحیح۶۴)
    ناپایا c := کلیک هاوس.باز کردن(o)
    none := وکتور {} برگردان وکتور<رشته>

    ناپایا rows := c.پرسمان("SELECT throwIf(1)"، none)
    سرچاپ "trailing:"، rows.معتبر()، c.کد()
    سرچاپ رشته.پیرایش(c.خطا())
    سرچاپ "exec header:"، c.اجرا("INSERT INTO t VALUES (1)"، none)، c.کد()
    rows = c.پرسمان("SELECT 1"، none)
    سرچاپ "marker:"، rows.معتبر()، c.کد()
    سرچاپ رشته.پیرایش(c.خطا())
    rows = c.پرسمان("SELECT 1"، none)
    سرچاپ "clean:"، rows.معتبر()، c.کد()، rows.تعداد ردیف()
    rows = c.پرسمان("SELECT 'Code: 1. DB::Exception'"، none)
    سرچاپ "in data:"، rows.معتبر()، rows.بعدی()، rows.متن(0)

    ناپایا settings := نگاشت {} برگردان نگاشت<رشته، رشته>
    settings.درج("max_execution_time"، "5")
    row := c.پرسمان یک ردیف("SELECT 7, 'x'"، none)
    سرچاپ "row:"، row.طول()، row.بگیر(0)، row.بگیر(1)
    سرچاپ "exec with:"، c.اجرا با تنظیمات("OPTIMIZE TABLE t"، none، settings)
    سرچاپ جعلی.آخرین()

    d := کلیک هاوس.به دیتابیس(c)
    سرچاپ "kind:"، d.نوع()، دیتابیس.کلیک هاوس
    r := d.پرسمان("SELECT n, f, s FROM t")
    سرچاپ "cols:"، r.تعداد ستون()، r.نام ستون(2)
    تا r.بعدی():
        سرچاپ r.عدد صحیح۶۴(0)، r.عدد اعشار(1)، r.خالی است(2)، r.متن(2)، r.نوع ستون(0)، r.نوع ستون(1)، r.نوع ستون(2)
    پایان
    r.بستن()
    سرچاپ "run:"، دیتابیس.اجرا کن(d، "TRUNCATE TABLE t")
    سرچاپ "bad:"، d.اجرا("DROP TABLE nope")، d.خطا() != ""
    سرچاپ "quote:"، d.نقل قول("a'b")
    tx := d.شروع تراکنش()
    سرچاپ "tx:"، tx.معتبر()، tx.ثبت تراکنش()، tx.بازگردانی()
پایان
