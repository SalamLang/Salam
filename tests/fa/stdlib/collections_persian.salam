واردسازی مجموعه ها
واردسازی عدد بزرگ
واردسازی اعشاری

روال ریشه:
    ناپایا پ := مجموعه ها.پشته {} برگردان مجموعه ها.پشته<صحیح>
    پ.افزودن(۳)
    پ.بیفزا(۴)
    سرچاپ پ.مشاهده()، پ.اندازه()، پ.خالی است()
    پ.آزادسازی()
    ناپایا د := مجموعه ها.صف دوسر {} برگردان مجموعه ها.صف دوسر<صحیح>
    د.افزودن به ابتدا(۵)
    سرچاپ د.اندازه()
    د.آزادسازی()
    ز := مجموعه ها.زوج { first = ۱، second = "یک" } برگردان مجموعه ها.زوج<صحیح، رشته>
    سرچاپ ز.first، ز.second
    ناپایا ع := عدد بزرگ.از صحیح(۶)
    سرچاپ ع.زوج است()، ع.به رشته()
    ع.آزادسازی()
    هر ش در [اعشاری.شیوه گردکردن.Down، اعشاری.شیوه گردکردن.HalfEven]:
        چاپ ش برگردان صحیح، ""
    پایان
    سرچاپ ""
