بسته ریشه

واردسازی فشرده سازی
واردسازی آزمایش

تابع hex_val(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57: برگشت c - 48 پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102: برگشت c - 87 پایان
    برگشت c - 55
پایان

تابع hex_buf(s: رشته): فشرده سازی.بافر بایت:
    n := s.طول() / 2
    p := s برگردان طبیعی۸*
    ناپایا b := فشرده سازی.بافر بایت جدید با ظرفیت(n)
    تکرار n در i:
        فشرده سازی.افزودن بایت(b، hex_val(p[i * 2] برگردان صحیح) * 16 + hex_val(p[i * 2 + 1] برگردان صحیح))
    پایان
    برگشت b
پایان

تابع lcg_buf(n: صحیح، mask: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید با ظرفیت(n)
    ناپایا x := 12345 برگردان طبیعی۳۲
    تکرار n:
        x = x * (1103515245 برگردان طبیعی۳۲) + (12345 برگردان طبیعی۳۲)
        فشرده سازی.افزودن بایت(b، ((x >> 16) برگردان صحیح) & mask)
    پایان
    برگشت b
پایان

تابع check_fixture(hex: رشته، want: رشته، label: رشته):
    ناپایا src := hex_buf(hex)
    ناپایا ok := نادرست
    ناپایا out := فشرده سازی.کدگشایی بی زیپ دو بافر(src، ok)
    آزمایش.ادعا با پیام(ok، label)
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(out)، want)
    فشرده سازی.آزادسازی بافر(out)
    فشرده سازی.آزادسازی بافر(src)
پایان

تابع round_trip(b: فشرده سازی.بافر بایت، level: صحیح، label: رشته):
    ناپایا packed := فشرده سازی.فشرده سازی بی زیپ دو با سطح(b.داده، b.طول، level)
    ناپایا ok := نادرست
    ناپایا out := فشرده سازی.کدگشایی بی زیپ دو بافر(packed، ok)
    آزمایش.ادعا با پیام(ok، label)
    آزمایش.ادعای برابری عدد(out.طول، b.طول)
    آزمایش.ادعای درستی(فشرده سازی.برابری بافر(out، b))
    فشرده سازی.آزادسازی بافر(out)
    فشرده سازی.آزادسازی بافر(packed)
پایان

تابع ریشه(): صحیح:
    text := "Salam, world! Bzip2 sorts blocks with the Burrows-Wheeler transform.\n"
    check_fixture("425a6831314159265359f5dc17c70000085f80001060071000100008803f6fde902000488a69fa9a8c351a68699a468449e9326d01184613d0f76aba6a1f3f0315093695606a10a59c6e5d6316aa3ec0321a2c4eee48872629fc8e65c030c4183b177245385090f5dc17c7"، text، "bzip2 -1")
    check_fixture("425a68393141592653597c4073c70000195f80001060071000100008803f6fde902000705000000002bfd551a23c8d4c9a06691ea62d182a9365514db3e22b95520a3b356ec98aa8a906abd9b983cacb386ea26e114573274559b172928d20c165e8bf26b3c26ba092cbe092f7f1772453850907c4073c70"، text + text + text، "python level 9")
    check_fixture("425a683917724538509000000000"، ""، "empty stream")
    check_fixture("425a683931415926535981b02d8b00000004002000200021184682ee48a70a12103605b160"، "A"، "one byte")
    check_fixture("425a68393141592653592a045d3800000251800010400023221c002000310030201a62730b4908271e2ee48a70a1205408ba70425a683931415926535984529094000005d180001040002e039c0020002200d0d040d0340504bd384f1e1e2ee48a70a12108a52128"، "first stream\nsecond stream\n"، "two streams")

    ناپایا rsrc := hex_buf("")
    ناپایا rok := نادرست
    ناپایا rout := فشرده سازی.کدگشایی بی زیپ دو بافر(rsrc، rok)
    آزمایش.ادعای درستی(rok)
    آزمایش.ادعای برابری عدد(rout.طول، 300)
    ناپایا rgood := درست
    تکرار 300 در i:
        اگر فشرده سازی.دریافت بایت(rout، i) نابرابر (i * 7 + i / 5) % 251: rgood = نادرست پایان
    پایان
    آزمایش.ادعای درستی(rgood)
    فشرده سازی.آزادسازی بافر(rout)
    فشرده سازی.آزادسازی بافر(rsrc)

    ناپایا runs := فشرده سازی.بافر بایت جدید()
    تکرار 300: فشرده سازی.افزودن بایت(runs، 97) پایان
    تکرار 5: فشرده سازی.افزودن بایت(runs، 98) پایان
    تکرار 255: فشرده سازی.افزودن بایت(runs، 99) پایان
    تکرار 256: فشرده سازی.افزودن بایت(runs، 100) پایان
    فشرده سازی.افزودن بایت(runs، 120)
    فشرده سازی.افزودن بایت(runs، 121)
    فشرده سازی.افزودن بایت(runs، 122)
    ناپایا rsrc2 := hex_buf("425a68393141592653590d1a6d660000035180a00000203c000070000820002191a9e86a1003048092ca2de1cd1543a73f7c5dc914e142403469b598")
    ناپایا rok2 := نادرست
    ناپایا rout2 := فشرده سازی.کدگشایی بی زیپ دو بافر(rsrc2، rok2)
    آزمایش.ادعای درستی(rok2)
    آزمایش.ادعای درستی(فشرده سازی.برابری بافر(rout2، runs))
    فشرده سازی.آزادسازی بافر(rout2)
    فشرده سازی.آزادسازی بافر(rsrc2)
    round_trip(runs، 9، "runs")
    فشرده سازی.آزادسازی بافر(runs)

    empty := فشرده سازی.بافر بایت جدید()
    ناپایا ep := فشرده سازی.فشرده سازی بی زیپ دو(empty.داده، 0)
    آزمایش.ادعای برابری عدد(ep.طول، 14)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(ep، 0)، 66)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(ep، 1)، 90)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(ep، 2)، 104)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(ep، 3)، 57)
    فشرده سازی.آزادسازی بافر(ep)
    round_trip(empty، 9، "empty")

    ناپایا one := lcg_buf(1، 255)
    round_trip(one، 1، "one byte")
    فشرده سازی.آزادسازی بافر(one)

    ناپایا noise := lcg_buf(300000، 255)
    round_trip(noise، 9، "noise level 9")
    round_trip(noise، 1، "noise level 1")
    فشرده سازی.آزادسازی بافر(noise)

    ناپایا few := lcg_buf(450000، 3)
    round_trip(few، 4، "four symbols level 4")
    round_trip(few، 9، "four symbols level 9")
    فشرده سازی.آزادسازی بافر(few)

    ناپایا edge := lcg_buf(900000، 7)
    round_trip(edge، 9، "900000 bytes")
    فشرده سازی.آزادسازی بافر(edge)
    ناپایا edge2 := lcg_buf(899981، 7)
    round_trip(edge2، 9، "block limit")
    فشرده سازی.آزادسازی بافر(edge2)

    ناپایا zeros := فشرده سازی.بافر بایت جدید با ظرفیت(2000000)
    تکرار 2000000: فشرده سازی.افزودن بایت(zeros، 0) پایان
    ناپایا zp := فشرده سازی.فشرده سازی بی زیپ دو(zeros.داده، zeros.طول)
    آزمایش.ادعای درستی(zp.طول کوچکتر 100)
    ناپایا zok := نادرست
    ناپایا zout := فشرده سازی.کدگشایی بی زیپ دو بافر(zp، zok)
    آزمایش.ادعای درستی(zok)
    آزمایش.ادعای درستی(فشرده سازی.برابری بافر(zout، zeros))
    فشرده سازی.آزادسازی بافر(zout)

    zok = درست
    zout = فشرده سازی.کدگشایی بی زیپ دو با سقف(zp.داده، zp.طول، 1000، zok)
    آزمایش.ادعای نادرستی(zok)
    آزمایش.ادعای برابری عدد(zout.طول، 0)
    فشرده سازی.آزادسازی بافر(zout)
    zout = فشرده سازی.کدگشایی بی زیپ دو با سقف(zp.داده، zp.طول، 1999999، zok)
    آزمایش.ادعای نادرستی(zok)
    فشرده سازی.آزادسازی بافر(zout)
    zout = فشرده سازی.کدگشایی بی زیپ دو با سقف(zp.داده، zp.طول، 2000000، zok)
    آزمایش.ادعای درستی(zok)
    آزمایش.ادعای برابری عدد(zout.طول، 2000000)
    فشرده سازی.آزادسازی بافر(zout)
    فشرده سازی.آزادسازی بافر(zp)
    فشرده سازی.آزادسازی بافر(zeros)

    ناپایا multi := lcg_buf(450000، 15)
    ناپایا mp := فشرده سازی.فشرده سازی بی زیپ دو با سطح(multi.داده، multi.طول، 1)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(mp، 3)، 49)
    ناپایا mok := نادرست
    ناپایا mout := فشرده سازی.کدگشایی بی زیپ دو بافر(mp، mok)
    آزمایش.ادعای درستی(mok)
    آزمایش.ادعای درستی(فشرده سازی.برابری بافر(mout، multi))
    فشرده سازی.آزادسازی بافر(mout)

    ناپایا two := فشرده سازی.کپی بافر(mp)
    فشرده سازی.افزودن بافر(two، mp)
    mout = فشرده سازی.کدگشایی بی زیپ دو بافر(two، mok)
    آزمایش.ادعای درستی(mok)
    آزمایش.ادعای برابری عدد(mout.طول، multi.طول * 2)
    فشرده سازی.آزادسازی بافر(mout)
    فشرده سازی.آزادسازی بافر(two)

    ناپایا flipped := فشرده سازی.کپی بافر(mp)
    فشرده سازی.تنظیم بایت(flipped، flipped.طول / 2، فشرده سازی.دریافت بایت(flipped، flipped.طول / 2) ^ 16)
    mok = درست
    mout = فشرده سازی.کدگشایی بی زیپ دو بافر(flipped، mok)
    آزمایش.ادعای نادرستی(mok)
    آزمایش.ادعای برابری عدد(mout.طول، 0)
    فشرده سازی.آزادسازی بافر(mout)
    فشرده سازی.آزادسازی بافر(flipped)

    ناپایا cut := فشرده سازی.کپی بافر(mp)
    cut.طول -= 5
    mok = درست
    mout = فشرده سازی.کدگشایی بی زیپ دو بافر(cut، mok)
    آزمایش.ادعای نادرستی(mok)
    فشرده سازی.آزادسازی بافر(mout)
    cut.طول = 3
    mok = درست
    mout = فشرده سازی.کدگشایی بی زیپ دو بافر(cut، mok)
    آزمایش.ادعای نادرستی(mok)
    فشرده سازی.آزادسازی بافر(mout)
    cut.طول = 0
    فشرده سازی.آزادسازی بافر(cut)

    ناپایا badcrc := فشرده سازی.کپی بافر(mp)
    فشرده سازی.تنظیم بایت(badcrc، badcrc.طول - 2، فشرده سازی.دریافت بایت(badcrc، badcrc.طول - 2) ^ 1)
    mok = درست
    mout = فشرده سازی.کدگشایی بی زیپ دو بافر(badcrc، mok)
    آزمایش.ادعای نادرستی(mok)
    فشرده سازی.آزادسازی بافر(mout)
    فشرده سازی.آزادسازی بافر(badcrc)

    ناپایا badmagic := فشرده سازی.کپی بافر(mp)
    فشرده سازی.تنظیم بایت(badmagic، 0، 67)
    mok = درست
    mout = فشرده سازی.کدگشایی بی زیپ دو بافر(badmagic، mok)
    آزمایش.ادعای نادرستی(mok)
    فشرده سازی.آزادسازی بافر(mout)
    فشرده سازی.آزادسازی بافر(badmagic)

    ناپایا junk := فشرده سازی.کپی بافر(mp)
    فشرده سازی.افزودن بایت(junk، 0)
    mok = درست
    mout = فشرده سازی.کدگشایی بی زیپ دو بافر(junk، mok)
    آزمایش.ادعای نادرستی(mok)
    فشرده سازی.آزادسازی بافر(mout)
    فشرده سازی.آزادسازی بافر(junk)

    ناپایا lvl0 := فشرده سازی.فشرده سازی بی زیپ دو با سطح(multi.داده، 10، 0)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(lvl0، 3)، 49)
    فشرده سازی.آزادسازی بافر(lvl0)
    ناپایا lvl99 := فشرده سازی.فشرده سازی بی زیپ دو با سطح(multi.داده، 10، 99)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(lvl99، 3)، 57)
    فشرده سازی.آزادسازی بافر(lvl99)

    ناپایا sb := فشرده سازی.فشرده سازی بی زیپ دو رشته(text)
    ناپایا sok := نادرست
    ناپایا sd := فشرده سازی.کدگشایی بی زیپ دو(sb.داده، sb.طول، sok)
    آزمایش.ادعای درستی(sok)
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(sd)، text)
    فشرده سازی.آزادسازی بافر(sd)
    فشرده سازی.آزادسازی بافر(sb)
    ناپایا bb := فشرده سازی.فشرده سازی بی زیپ دو بافر(multi)
    آزمایش.ادعای برابری عدد(فشرده سازی.دریافت بایت(bb، 3)، 57)
    فشرده سازی.آزادسازی بافر(bb)

    فشرده سازی.آزادسازی بافر(mp)
    فشرده سازی.آزادسازی بافر(multi)
    برگشت آزمایش.خلاصه()
پایان
