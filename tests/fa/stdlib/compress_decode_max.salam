بسته ریشه

واردسازی فشرده سازی

تابع check(label: رشته، method: صحیح، plain: فشرده سازی.بافر بایت):
    ناپایا packed := فشرده سازی.فشرده سازی(method، plain.داده، plain.طول)
    ناپایا ok := نادرست
    ناپایا back := فشرده سازی.کدگشایی با سقف(method، packed.داده، packed.طول، 0، ok)
    سرچاپ label، ok، فشرده سازی.برابری بافر(back، plain)
    فشرده سازی.آزادسازی بافر(back)
    ناپایا small := فشرده سازی.کدگشایی با سقف(method، packed.داده، packed.طول، 4، ok)
    سرچاپ label، "capped"، ok، small.طول
    فشرده سازی.آزادسازی بافر(small)
    ناپایا cut := فشرده سازی.کدگشایی با سقف(method، packed.داده، packed.طول / 2، 0، ok)
    سرچاپ label، "truncated"، ok، cut.طول
    فشرده سازی.آزادسازی بافر(cut)
    ناپایا junk := فشرده سازی.بافر بایت جدید()
    تکرار 64 در i:
        فشرده سازی.افزودن بایت(junk، (i * 37 + 11) & 255)
    پایان
    ناپایا bad := فشرده سازی.کدگشایی با سقف(method، junk.داده، junk.طول، 0، ok)
    سرچاپ label، "junk"، ok، bad.طول
    فشرده سازی.آزادسازی بافر(bad)
    فشرده سازی.آزادسازی بافر(junk)
    فشرده سازی.آزادسازی بافر(packed)
پایان

تابع قالب(v: صحیح[]): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    هر x در v:
        فشرده سازی.افزودن بایت(b، x)
    پایان
    برگشت b
پایان

تابع ریشه:
    ناپایا plain := فشرده سازی.بافر از رشته("abracadabra abracadabra abracadabra, salam salam salam")
    check("rle"، فشرده سازی.روش آر ال ای، plain)
    check("huffman"، فشرده سازی.روش هافمن، plain)
    check("lz77"، فشرده سازی.روش الزد۷۷، plain)
    check("lzw"، فشرده سازی.روش ال زد دبلیو، plain)
    check("deflate"، فشرده سازی.روش دیفلیت، plain)
    check("bwt"، فشرده سازی.روش باروز ویلر، plain)
    ناپایا ok := نادرست
    ناپایا inr := قالب([255، 255، 255، 255، 0])
    ناپایا r := فشرده سازی.کدگشایی طول اجرا با سقف(inr.داده، inr.طول، 0، ok)
    سرچاپ ok، r.طول
    ناپایا inh := قالب([127، 255، 255، 255، 1])
    ناپایا h := فشرده سازی.کدگشایی هافمن با سقف(inh.داده، inh.طول، 0، ok)
    سرچاپ ok، h.طول
    ناپایا inl := قالب([0، 0، 0، 16، 255، 255])
    ناپایا l := فشرده سازی.کدگشایی الزد۷۷ با سقف(inl.داده، inl.طول، 0، ok)
    سرچاپ ok، l.طول
    ناپایا inw := قالب([0، 0، 0، 16، 255، 255])
    ناپایا w := فشرده سازی.کدگشایی ال زد دبلیو با سقف(inw.داده، inw.طول، 0، ok)
    سرچاپ ok، w.طول
    ناپایا ind := قالب([0، 0، 0، 16، 255، 255])
    ناپایا d := فشرده سازی.کدگشایی دیفلیت با سقف(ind.داده، ind.طول، 0، ok)
    سرچاپ ok، d.طول
    ناپایا inb := قالب([0، 0، 0، 16، 255، 255، 255، 255])
    ناپایا b := فشرده سازی.کدگشایی باروز ویلر با سقف(inb.داده، inb.طول، 0، ok)
    سرچاپ ok، b.طول
    فشرده سازی.آزادسازی بافر(r)
    فشرده سازی.آزادسازی بافر(inr)
    فشرده سازی.آزادسازی بافر(h)
    فشرده سازی.آزادسازی بافر(inh)
    فشرده سازی.آزادسازی بافر(l)
    فشرده سازی.آزادسازی بافر(inl)
    فشرده سازی.آزادسازی بافر(w)
    فشرده سازی.آزادسازی بافر(inw)
    فشرده سازی.آزادسازی بافر(d)
    فشرده سازی.آزادسازی بافر(ind)
    فشرده سازی.آزادسازی بافر(b)
    فشرده سازی.آزادسازی بافر(inb)
    فشرده سازی.آزادسازی بافر(plain)
پایان
