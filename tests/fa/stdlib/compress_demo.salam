بسته ریشه

واردسازی فشرده سازی
واردسازی حافظه
واردسازی رشته
واردسازی آزمایش

تابع named(ok: منطقی، a: رشته، b: رشته، c: رشته):
    ناپایا sb := رشته.سازنده()
    رشته.افزودن به بافر(sb، a)
    رشته.افزودن به بافر(sb، b)
    رشته.افزودن به بافر(sb، c)
    m := رشته.رشته بافر(sb)
    رشته.آزادسازی بافر(sb)
    آزمایش.ادعا با پیام(ok، m)
    حافظه.آزادسازی(m برگردان تهی*)
پایان

تابع roundtrip_check(tag: رشته، s: رشته، orig: فشرده سازی.بافر بایت، decoded: فشرده سازی.بافر بایت):
    named(فشرده سازی.برابری بافر(orig، decoded)، tag، s، " round-trip mismatch")
پایان

تابع check_rle(s: رشته):
    ناپایا orig := فشرده سازی.بافر از رشته(s)
    ناپایا comp := فشرده سازی.فشرده سازی طول اجرا(orig.داده، orig.طول)
    ناپایا decomp := فشرده سازی.کدگشایی طول اجرا(comp.داده، comp.طول)
    roundtrip_check("rle:"، s، orig، decomp)
    فشرده سازی.آزادسازی بافر(orig)
    فشرده سازی.آزادسازی بافر(comp)
    فشرده سازی.آزادسازی بافر(decomp)
پایان

تابع check_huffman(s: رشته):
    ناپایا orig := فشرده سازی.بافر از رشته(s)
    ناپایا comp := فشرده سازی.فشرده سازی هافمن(orig.داده، orig.طول)
    ناپایا decomp := فشرده سازی.کدگشایی هافمن(comp.داده، comp.طول)
    roundtrip_check("huffman:"، s، orig، decomp)
    فشرده سازی.آزادسازی بافر(orig)
    فشرده سازی.آزادسازی بافر(comp)
    فشرده سازی.آزادسازی بافر(decomp)
پایان

تابع check_lz77(s: رشته):
    ناپایا orig := فشرده سازی.بافر از رشته(s)
    ناپایا comp := فشرده سازی.فشرده سازی الزد۷۷(orig.داده، orig.طول)
    ناپایا decomp := فشرده سازی.کدگشایی الزد۷۷(comp.داده، comp.طول)
    roundtrip_check("lz77:"، s، orig، decomp)
    فشرده سازی.آزادسازی بافر(orig)
    فشرده سازی.آزادسازی بافر(comp)
    فشرده سازی.آزادسازی بافر(decomp)
پایان

تابع check_lzw(s: رشته):
    ناپایا orig := فشرده سازی.بافر از رشته(s)
    ناپایا comp := فشرده سازی.فشرده سازی ال زد دبلیو(orig.داده، orig.طول)
    ناپایا decomp := فشرده سازی.کدگشایی ال زد دبلیو(comp.داده، comp.طول)
    roundtrip_check("lzw:"، s، orig، decomp)
    فشرده سازی.آزادسازی بافر(orig)
    فشرده سازی.آزادسازی بافر(comp)
    فشرده سازی.آزادسازی بافر(decomp)
پایان

تابع check_deflate(s: رشته):
    ناپایا orig := فشرده سازی.بافر از رشته(s)
    ناپایا comp := فشرده سازی.فشرده سازی دیفلیت(orig.داده، orig.طول)
    ناپایا decomp := فشرده سازی.کدگشایی دیفلیت(comp.داده، comp.طول)
    roundtrip_check("deflate:"، s، orig، decomp)
    فشرده سازی.آزادسازی بافر(orig)
    فشرده سازی.آزادسازی بافر(comp)
    فشرده سازی.آزادسازی بافر(decomp)
پایان

تابع check_bwt(s: رشته):
    ناپایا orig := فشرده سازی.بافر از رشته(s)
    ناپایا comp := فشرده سازی.فشرده سازی باروز ویلر(orig.داده، orig.طول)
    ناپایا decomp := فشرده سازی.کدگشایی باروز ویلر(comp.داده، comp.طول)
    roundtrip_check("bwt:"، s، orig، decomp)
    فشرده سازی.آزادسازی بافر(orig)
    فشرده سازی.آزادسازی بافر(comp)
    فشرده سازی.آزادسازی بافر(decomp)
پایان

تابع check_raw_deflate(s: رشته):
    ناپایا orig := فشرده سازی.بافر از رشته(s)
    ناپایا comp := فشرده سازی.دیفلیت خام(orig.داده، orig.طول)
    ناپایا ok := نادرست
    ناپایا decomp := فشرده سازی.کدگشایی دیفلیت خام(comp.داده، comp.طول، orig.طول، ok)
    named(ok، "raw_deflate:"، s، " reported not ok")
    roundtrip_check("raw_deflate:"، s، orig، decomp)
    فشرده سازی.آزادسازی بافر(orig)
    فشرده سازی.آزادسازی بافر(comp)
    فشرده سازی.آزادسازی بافر(decomp)
پایان

تابع check_gzip(s: رشته):
    ناپایا orig := فشرده سازی.بافر از رشته(s)
    ناپایا comp := فشرده سازی.فشرده سازی جی زیپ(orig.داده، orig.طول)
    ناپایا ok := نادرست
    ناپایا decomp := فشرده سازی.کدگشایی جی زیپ(comp.داده، comp.طول، ok)
    named(ok، "gzip:"، s، " reported not ok")
    roundtrip_check("gzip:"، s، orig، decomp)
    فشرده سازی.آزادسازی بافر(orig)
    فشرده سازی.آزادسازی بافر(comp)
    فشرده سازی.آزادسازی بافر(decomp)
پایان

تابع repeat_str(s: رشته، count: صحیح): رشته:
    ناپایا sb := رشته.سازنده()
    ناپایا i := 0
    تا i کوچکتر count:
        رشته.افزودن به بافر(sb، s)
        i++
    پایان
    out := رشته.رشته بافر(sb)
    رشته.آزادسازی بافر(sb)
    برگشت out
پایان

تابع check_corrupt_inflate(bytes: رشته):
    ناپایا buf := فشرده سازی.بافر بایت جدید()
    parts := bytes.بشکاف(" ")
    تکرار parts.طول() در i:
        part := parts.بگیر(i)
        فشرده سازی.افزودن بایت(buf، part.به صحیح())
        حافظه.آزادسازی(part برگردان تهی*)
    پایان
    parts.آزادکن()
    ناپایا ok := درست
    ناپایا out := فشرده سازی.کدگشایی دیفلیت خام(buf.داده، buf.طول، 0، ok)
    named(وارونه ok، "corrupt inflate:"، bytes، " reported ok")
    فشرده سازی.آزادسازی بافر(out)
    فشرده سازی.آزادسازی بافر(buf)
پایان

تابع ریشه:
    آزمایش.ادعای برابری عدد(فشرده سازی.چک جمع سی آر سی رشته("123456789") برگردان صحیح، -873187034)
    آزمایش.ادعای برابری عدد(فشرده سازی.چک جمع ادلر رشته("Wikipedia") برگردان صحیح، 300286872)
    آزمایش.ادعای برابری عدد(فشرده سازی.چک جمع سی آر سی رشته("") برگردان صحیح، 0)

    corpus := [
        ""
        "a"
        "abcdefgh"
        "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
        "aaabbbbbbbbccccccccccccccccddddddefgh"
        "the quick brown fox jumps over the lazy dog the quick brown fox jumps over the lazy dog"
        "bananabananabananabanana"
        "mississippi"
        "abababababababababab"
    ]

    ناپایا i := 0
    تا i کوچکتر 9:
        s := corpus[i]
        check_rle(s)
        check_huffman(s)
        check_lz77(s)
        check_lzw(s)
        check_deflate(s)
        check_bwt(s)
        check_raw_deflate(s)
        check_gzip(s)
        i++
    پایان

    check_corrupt_inflate("61 102 201")
    check_corrupt_inflate("124 12 228 94 61")
    check_corrupt_inflate("133 51 167 86 13")
    check_corrupt_inflate("77 202 24 37 48 187 29 109")

    long_text := repeat_str("The quick brown fox jumps over the lazy dog. "، 200)
    check_lzw(long_text)
    حافظه.آزادسازی(long_text برگردان تهی*)

    ناپایا bin := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(bin، 0)
    فشرده سازی.افزودن بایت(bin، 1)
    فشرده سازی.افزودن بایت(bin، 2)
    فشرده سازی.افزودن بایت(bin، 0)
    فشرده سازی.افزودن بایت(bin، 0)
    فشرده سازی.افزودن بایت(bin، 255)
    فشرده سازی.افزودن بایت(bin، 254)
    فشرده سازی.افزودن بایت(bin، 0)

    ناپایا bc := فشرده سازی.فشرده سازی هافمن(bin.داده، bin.طول)
    ناپایا bd := فشرده سازی.کدگشایی هافمن(bc.داده، bc.طول)
    roundtrip_check("binary:huffman"، ""، bin، bd)
    فشرده سازی.آزادسازی بافر(bc)
    فشرده سازی.آزادسازی بافر(bd)

    bc = فشرده سازی.فشرده سازی طول اجرا(bin.داده، bin.طول)
    bd = فشرده سازی.کدگشایی طول اجرا(bc.داده، bc.طول)
    roundtrip_check("binary:rle"، ""، bin، bd)
    فشرده سازی.آزادسازی بافر(bc)
    فشرده سازی.آزادسازی بافر(bd)

    bc = فشرده سازی.فشرده سازی الزد۷۷(bin.داده، bin.طول)
    bd = فشرده سازی.کدگشایی الزد۷۷(bc.داده، bc.طول)
    roundtrip_check("binary:lz77"، ""، bin، bd)
    فشرده سازی.آزادسازی بافر(bc)
    فشرده سازی.آزادسازی بافر(bd)

    bc = فشرده سازی.فشرده سازی ال زد دبلیو(bin.داده، bin.طول)
    bd = فشرده سازی.کدگشایی ال زد دبلیو(bc.داده، bc.طول)
    roundtrip_check("binary:lzw"، ""، bin، bd)
    فشرده سازی.آزادسازی بافر(bc)
    فشرده سازی.آزادسازی بافر(bd)

    bc = فشرده سازی.فشرده سازی دیفلیت(bin.داده، bin.طول)
    bd = فشرده سازی.کدگشایی دیفلیت(bc.داده، bc.طول)
    roundtrip_check("binary:deflate"، ""، bin، bd)
    فشرده سازی.آزادسازی بافر(bc)
    فشرده سازی.آزادسازی بافر(bd)

    bc = فشرده سازی.فشرده سازی باروز ویلر(bin.داده، bin.طول)
    bd = فشرده سازی.کدگشایی باروز ویلر(bc.داده، bc.طول)
    roundtrip_check("binary:bwt"، ""، bin، bd)
    فشرده سازی.آزادسازی بافر(bc)
    فشرده سازی.آزادسازی بافر(bd)

    bc = فشرده سازی.دیفلیت خام(bin.داده، bin.طول)
    ناپایا raw_ok := نادرست
    bd = فشرده سازی.کدگشایی دیفلیت خام(bc.داده، bc.طول، bin.طول، raw_ok)
    آزمایش.ادعا با پیام(raw_ok، "binary:raw_deflate reported not ok")
    roundtrip_check("binary:raw_deflate"، ""، bin، bd)
    فشرده سازی.آزادسازی بافر(bc)
    فشرده سازی.آزادسازی بافر(bd)

    bc = فشرده سازی.فشرده سازی جی زیپ(bin.داده، bin.طول)
    ناپایا gz_ok := نادرست
    bd = فشرده سازی.کدگشایی جی زیپ(bc.داده، bc.طول، gz_ok)
    آزمایش.ادعا با پیام(gz_ok، "binary:gzip reported not ok")
    roundtrip_check("binary:gzip"، ""، bin، bd)
    فشرده سازی.آزادسازی بافر(bc)
    فشرده سازی.آزادسازی بافر(bd)

    فشرده سازی.آزادسازی بافر(bin)

    ناپایا text := فشرده سازی.بافر از رشته("the quick brown fox jumps over the lazy dog the quick brown fox jumps over the lazy dog")
    methods := [
        فشرده سازی.روش هیچ، فشرده سازی.روش آر ال ای، فشرده سازی.روش هافمن
        فشرده سازی.روش الزد۷۷، فشرده سازی.روش ال زد دبلیو، فشرده سازی.روش دیفلیت، فشرده سازی.روش باروز ویلر
    ]
    ناپایا m := 0
    تا m کوچکتر 7:
        method := methods[m]
        ناپایا mc := فشرده سازی.فشرده سازی بافر(method، text)
        ناپایا md := فشرده سازی.کدگشایی بافر(method، mc)
        method_name := رشته.از عدد(method برگردان صحیح۶۴)
        named(فشرده سازی.برابری بافر(text، md)، "dispatch method "، method_name، " round-trip mismatch")
        حافظه.آزادسازی(method_name برگردان تهی*)
        فشرده سازی.آزادسازی بافر(mc)
        فشرده سازی.آزادسازی بافر(md)
        m++
    پایان

    ناپایا winner := فشرده سازی.روش هیچ
    ناپایا best := فشرده سازی.بهترین فشرده سازی(text.داده، text.طول، winner)
    ناپایا bestDecoded := فشرده سازی.کدگشایی(winner، best.داده، best.طول)
    آزمایش.ادعا با پیام(فشرده سازی.برابری بافر(text، bestDecoded)، "CompressBest round-trip mismatch")
    آزمایش.ادعای درستی(فشرده سازی.طول بافر(best) کوچکتربرابر فشرده سازی.طول بافر(text) + 5)
    فشرده سازی.آزادسازی بافر(best)
    فشرده سازی.آزادسازی بافر(bestDecoded)
    فشرده سازی.آزادسازی بافر(text)

    برگشت آزمایش.خلاصه()
پایان
