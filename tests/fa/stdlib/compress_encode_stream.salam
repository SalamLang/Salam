بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع emit(p: تهی*، n: صحیح، c: تهی*): منطقی:
    فشرده سازی.افزودن بایت‌ها((c برگردان فشرده سازی.بافر بایت*)[0]، p، n)
    برگشت درست
پایان

تابع make(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید با ظرفیت(n + 16)
    ناپایا s := 12345 برگردان صحیح۶۴
    ناپایا i := 0
    تا i کوچکتر n:
        s = (s * 1103515245 + 12345) & 0x7fffffff
        v := ((s >> 16) & 255) برگردان صحیح
        اگر (i / 4096) % 3 برابر 0:
            فشرده سازی.افزودن بایت(out، v)
            i++
        وگرنه:
            run := 1 + (v & 15)
            تکرار run:
                اگر i کوچکتر n:
                    فشرده سازی.افزودن بایت(out، 97 + (v & 7))
                    i++
                پایان
            پایان
        پایان
    پایان
    برگشت out
پایان

تابع stream(kind: صحیح، path: رشته، total: صحیح، level: صحیح): فشرده سازی.بافر بایت:
    fp := فشرده سازی.بازکردن پرونده برای خواندن(path)
    holder := حافظه.تخصیص صفرشده(اندازه‌گونه(فشرده سازی.بافر بایت)) برگردان فشرده سازی.بافر بایت*
    holder[0] = فشرده سازی.بافر بایت جدید()
    cb := (p: تهی*، n: صحیح، c: تهی*): برگشت emit(p، n، c) پایان
    ناپایا sink := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، cb، holder برگردان تهی*)
    ناپایا ok := نادرست
    اگر kind برابر 0:
        ok = فشرده سازی.فشرده سازی بی زیپ دو پرونده به مقصد(fp، 0 برگردان صحیح۶۴، total برگردان صحیح۶۴، level، sink)
    وگرنه kind برابر 1:
        ok = فشرده سازی.فشرده سازی زستد پرونده به مقصد(fp، 0 برگردان صحیح۶۴، total برگردان صحیح۶۴، level، sink)
    وگرنه:
        ok = فشرده سازی.فشرده سازی الزد ام ای پرونده به مقصد(fp، 0 برگردان صحیح۶۴، total برگردان صحیح۶۴، level، درست، sink)
    پایان
    فشرده سازی.بستن پرونده(fp)
    ناپایا out := holder[0]
    حافظه.آزادسازی(holder برگردان تهی*)
    اگر وارونه ok:
        فشرده سازی.آزادسازی بافر(out)
        برگشت فشرده سازی.بافر بایت جدید()
    پایان
    برگشت out
پایان

تابع check(name: رشته، kind: صحیح، total: صحیح، level: صحیح):
    ناپایا data := make(total)
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_enc_stream_fa_" + name)
    بایگانی.نوشتن پرونده دودویی از بافر(path، data)
    ناپایا packed := stream(kind، path، total، level)
    ناپایا ok := نادرست
    ناپایا back := فشرده سازی.بافر بایت جدید()
    ناپایا shot := فشرده سازی.بافر بایت جدید()
    اگر kind برابر 0:
        back = فشرده سازی.کدگشایی بی زیپ دو(packed.داده، packed.طول، ok)
        shot = فشرده سازی.فشرده سازی بی زیپ دو با سطح(data.داده، data.طول، level)
    وگرنه kind برابر 1:
        back = فشرده سازی.کدگشایی زستد(packed.داده، packed.طول، ok)
        shot = فشرده سازی.فشرده سازی زستد با سطح(data.داده، data.طول، level)
    وگرنه:
        raw := ((packed.داده برگردان صحیح۶۴) + (5 برگردان صحیح۶۴)) برگردان تهی*
        back = فشرده سازی.کدگشایی الزد ام ای خام(packed.داده، 5، raw، packed.طول - 5، total، 0، ok)
        shot = فشرده سازی.فشرده سازی الزد ام ای با سطح(data.داده، data.طول، level)
    پایان
    same := فشرده سازی.برابری بافر(back، data)
    ناپایا like := packed.طول بزرگتر 0
    اگر kind برابر 2:
        diff := packed.طول - 5 - (shot.طول - 13)
        like = diff * 100 کوچکتربرابر shot.طول و 0 - diff * 100 کوچکتربرابر shot.طول
    وگرنه:
        like = فشرده سازی.برابری بافر(packed، shot)
    پایان
    سرچاپ name، total، "roundtrip"، ok و same، "like one-shot"، like، "smaller"، packed.طول کوچکتر total
    سیستم عامل.حذف(path)
    حافظه.آزادسازی(path برگردان تهی*)
    فشرده سازی.آزادسازی بافر(data)
    فشرده سازی.آزادسازی بافر(packed)
    فشرده سازی.آزادسازی بافر(back)
    فشرده سازی.آزادسازی بافر(shot)
پایان

تابع ریشه:
    check("bz_empty"، 0، 0، 9)
    check("bz_small"، 0، 1000، 9)
    check("bz_blocks"، 0، 2500000، 1)
    check("zs_empty"، 1، 0، 3)
    check("zs_small"، 1، 70000، 3)
    check("zs_window"، 1، 9000000، 3)
    check("zs_raw"، 1، 300000، 0)
    check("lz_empty"، 2، 0، 6)
    check("lz_small"، 2، 5000، 6)
    check("lz_window"، 2، 9000000، 1)
    check("lz_big_dict"، 2، 3000000، 6)
پایان
