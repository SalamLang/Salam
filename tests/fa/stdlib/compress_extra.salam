بسته ریشه

واردسازی فشرده سازی

تابع ریشه:
    سرچاپ فشرده سازی.چک جمع سی آر سی رشته("123456789") برگردان صحیح
    b := فشرده سازی.بافر از رشته("123456789")
    سرچاپ فشرده سازی.چک جمع سی آر سی(b.داده، b.طول) برگردان صحیح، فشرده سازی.چک جمع سی آر سی بافر(b) برگردان صحیح
    سرچاپ فشرده سازی.چک جمع ادلر(b.داده، b.طول) برگردان صحیح، فشرده سازی.چک جمع ادلر بافر(b) برگردان صحیح، فشرده سازی.چک جمع ادلر رشته("123456789") برگردان صحیح

    ناپایا w := فشرده سازی.نویسنده بیت جدید()
    فشرده سازی.نوشتن بیت(w، 1)
    فشرده سازی.نوشتن بیت(w، 0)
    فشرده سازی.نوشتن بیت‌ها(w، 5، 3)
    فشرده سازی.نوشتن بیت‌ها(w، 1000، 11)
    سرچاپ فشرده سازی.طول نویسنده بیت(w)
    فشرده سازی.تخلیه بیت(w)
    سرچاپ فشرده سازی.طول نویسنده بیت(w)
    ناپایا r := فشرده سازی.خواننده بیت از بافر(w.بافر)
    سرچاپ فشرده سازی.خواندن بیت(r)، فشرده سازی.خواندن بیت(r)، فشرده سازی.خواندن بیت‌ها(r، 3)، فشرده سازی.خواندن بیت‌ها(r، 11)
    سرچاپ r.خراب
    _ := فشرده سازی.خواندن بیت‌ها(r، 16)
    سرچاپ r.خراب
    ناپایا r2 := فشرده سازی.خواننده بیت جدید(w.بافر.داده، 1)
    سرچاپ فشرده سازی.خواندن بیت‌ها(r2، 8)، r2.خراب
    فشرده سازی.آزادسازی نویسنده بیت(w)

    ناپایا cap := فشرده سازی.بافر بایت جدید با ظرفیت(4)
    فشرده سازی.افزودن عدد۳۲(cap، 258)
    فشرده سازی.افزودن بایت(cap، 255)
    سرچاپ فشرده سازی.طول بافر(cap)، فشرده سازی.بافر به پایه۶۴(cap)
    ناپایا rd := فشرده سازی.خواننده از بافر(cap)
    سرچاپ فشرده سازی.خواندن بایت(rd)، فشرده سازی.خواندن بایت(rd)، فشرده سازی.خواندن بایت(rd)، فشرده سازی.خواندن بایت(rd)
    ناپایا rd2 := فشرده سازی.خواننده از بافر(cap)
    two := فشرده سازی.خواندن بایت‌ها(rd2، 2)
    سرچاپ فشرده سازی.طول بافر(two)، فشرده سازی.باقیمانده(rd2)، rd2.خراب
    ناپایا rd3 := فشرده سازی.خواننده از بافر(cap)
    سرچاپ فشرده سازی.خواندن عدد۳۲(rd3)، فشرده سازی.خواندن بایت(rd3)، rd3.خراب
    سرچاپ فشرده سازی.بافر به پایه۶۴(فشرده سازی.بافر از رشته("foobar"))
    فشرده سازی.آزادسازی بافر(two)
    فشرده سازی.آزادسازی بافر(cap)

    ناپایا primary := 0
    src := فشرده سازی.بافر از رشته("banana")
    t := فشرده سازی.تبدیل باروز ویلر(src.داده، src.طول، primary)
    سرچاپ فشرده سازی.بافر به رشته(t)، primary
    back := فشرده سازی.معکوس باروز ویلر(t.داده، t.طول، primary)
    سرچاپ فشرده سازی.بافر به رشته(back)
    m := فشرده سازی.کدگذاری انتقال به جلو(src)
    سرچاپ فشرده سازی.طول بافر(m)، فشرده سازی.دریافت بایت(m، 0)، فشرده سازی.دریافت بایت(m، 1)، فشرده سازی.دریافت بایت(m، 2)
    سرچاپ فشرده سازی.بافر به رشته(فشرده سازی.کدگشایی انتقال به جلو(m))

    text := "to be or not to be, to be or not to be"
    c := فشرده سازی.فشرده سازی رشته(فشرده سازی.روش آر ال ای، text)
    سرچاپ فشرده سازی.بافر به رشته(فشرده سازی.کدگشایی(فشرده سازی.روش آر ال ای، c.داده، c.طول)) برابر text
    هر mm در [فشرده سازی.روش هیچ، فشرده سازی.روش هافمن، فشرده سازی.روش الزد۷۷، فشرده سازی.روش ال زد دبلیو، فشرده سازی.روش دیفلیت، فشرده سازی.روش باروز ویلر]:
        z := فشرده سازی.فشرده سازی(mm، text برگردان تهی*، text.طول())
        d := فشرده سازی.کدگشایی(mm، z.داده، z.طول)
        سرچاپ mm، فشرده سازی.بافر به رشته(d) برابر text
    پایان
    سرچاپ فشرده سازی.نسبت(50، 100)، فشرده سازی.نسبت(1، 4)، فشرده سازی.نسبت(5، 0)

    g := فشرده سازی.فشرده سازی جی زیپ رشته(text)
    ناپایا ok := نادرست
    gd := فشرده سازی.کدگشایی جی زیپ بافر(g، ok)
    سرچاپ ok، فشرده سازی.بافر به رشته(gd) برابر text
    _ := فشرده سازی.کدگشایی جی زیپ با سقف(g.داده، g.طول، 5، ok)
    سرچاپ ok
    gm := فشرده سازی.کدگشایی جی زیپ با سقف(g.داده، g.طول، 0، ok)
    سرچاپ ok، فشرده سازی.بافر به رشته(gm) برابر text
    raw := فشرده سازی.دیفلیت خام(text برگردان تهی*، text.طول())
    _ := فشرده سازی.کدگشایی دیفلیت خام با سقف(raw.داده، raw.طول، text.طول()، 5، ok)
    سرچاپ ok
    rm := فشرده سازی.کدگشایی دیفلیت خام با سقف(raw.داده، raw.طول، text.طول()، 0، ok)
    سرچاپ ok، فشرده سازی.بافر به رشته(rm) برابر text
پایان
