بسته ریشه

واردسازی فشرده سازی

تابع ریشه:
    سرچاپ فشرده سازی.چک جمع سی آر سی رشته("123456789") برگردان صحیح
    b := فشرده سازی.بافر از رشته("123456789")
    سرچاپ فشرده سازی.چک جمع سی آر سی(b.داده، b.طول) برگردان صحیح، فشرده سازی.چک جمع سی آر سی بافر(b) برگردان صحیح
    سرچاپ فشرده سازی.چک جمع ادلر(b.داده، b.طول) برگردان صحیح، فشرده سازی.چک جمع ادلر بافر(b) برگردان صحیح، فشرده سازی.چک جمع ادلر رشته("123456789") برگردان صحیح

    ناپایا w := فشرده سازی.نویسنده بیت جدید()
    فشرده سازی.نوشتن بیت(w، 1)
    فشرده سازی.نوشتن بیت(w، 0)
    فشرده سازی.نوشتن بیت‌ها(w، 5، 3)
    فشرده سازی.نوشتن بیت‌ها(w، 1000، 11)
    سرچاپ فشرده سازی.طول نویسنده بیت(w)
    فشرده سازی.تخلیه بیت(w)
    سرچاپ فشرده سازی.طول نویسنده بیت(w)
    ناپایا r := فشرده سازی.خواننده بیت از بافر(w.بافر)
    سرچاپ فشرده سازی.خواندن بیت(r)، فشرده سازی.خواندن بیت(r)، فشرده سازی.خواندن بیت‌ها(r، 3)، فشرده سازی.خواندن بیت‌ها(r، 11)
    سرچاپ r.خراب
    _ := فشرده سازی.خواندن بیت‌ها(r، 16)
    سرچاپ r.خراب
    ناپایا خواننده بیت۲ := فشرده سازی.خواننده بیت جدید(w.بافر.داده، 1)
    سرچاپ فشرده سازی.خواندن بیت‌ها(خواننده بیت۲، 8)، خواننده بیت۲.خراب
    فشرده سازی.آزادسازی نویسنده بیت(w)

    ناپایا بافر ظرفیتی := فشرده سازی.بافر بایت جدید با ظرفیت(4)
    فشرده سازی.افزودن عدد۳۲(بافر ظرفیتی، 258)
    فشرده سازی.افزودن بایت(بافر ظرفیتی، 255)
    سرچاپ فشرده سازی.طول بافر(بافر ظرفیتی)، فشرده سازی.بافر به پایه۶۴(بافر ظرفیتی)
    ناپایا خواننده بایت := فشرده سازی.خواننده از بافر(بافر ظرفیتی)
    سرچاپ فشرده سازی.خواندن بایت(خواننده بایت)، فشرده سازی.خواندن بایت(خواننده بایت)، فشرده سازی.خواندن بایت(خواننده بایت)، فشرده سازی.خواندن بایت(خواننده بایت)
    ناپایا خواننده بایت۲ := فشرده سازی.خواننده از بافر(بافر ظرفیتی)
    ناپایا دو بایت := فشرده سازی.خواندن بایت‌ها(خواننده بایت۲، 2)
    سرچاپ فشرده سازی.طول بافر(دو بایت)، فشرده سازی.باقیمانده(خواننده بایت۲)، خواننده بایت۲.خراب
    ناپایا خواننده بایت۳ := فشرده سازی.خواننده از بافر(بافر ظرفیتی)
    سرچاپ فشرده سازی.خواندن عدد۳۲(خواننده بایت۳)، فشرده سازی.خواندن بایت(خواننده بایت۳)، خواننده بایت۳.خراب
    سرچاپ فشرده سازی.بافر به پایه۶۴(فشرده سازی.بافر از رشته("foobar"))
    فشرده سازی.آزادسازی بافر(دو بایت)
    فشرده سازی.آزادسازی بافر(بافر ظرفیتی)

    ناپایا اصلی := 0
    منبع := فشرده سازی.بافر از رشته("banana")
    t := فشرده سازی.تبدیل باروز ویلر(منبع.داده، منبع.طول، اصلی)
    سرچاپ فشرده سازی.بافر به رشته(t)، اصلی
    بازخوانی := فشرده سازی.معکوس باروز ویلر(t.داده، t.طول، اصلی)
    سرچاپ فشرده سازی.بافر به رشته(بازخوانی)
    m := فشرده سازی.کدگذاری انتقال به جلو(منبع)
    سرچاپ فشرده سازی.طول بافر(m)، فشرده سازی.دریافت بایت(m، 0)، فشرده سازی.دریافت بایت(m، 1)، فشرده سازی.دریافت بایت(m، 2)
    سرچاپ فشرده سازی.بافر به رشته(فشرده سازی.کدگشایی انتقال به جلو(m))

    متن := "to be or not to be, to be or not to be"
    c := فشرده سازی.فشرده سازی رشته(فشرده سازی.روش آر ال ای، متن)
    سرچاپ فشرده سازی.بافر به رشته(فشرده سازی.کدگشایی(فشرده سازی.روش آر ال ای، c.داده، c.طول)) برابر متن
    هر روش در [فشرده سازی.روش هیچ، فشرده سازی.روش هافمن، فشرده سازی.روش الزد۷۷، فشرده سازی.روش ال زد دبلیو، فشرده سازی.روش دیفلیت، فشرده سازی.روش باروز ویلر]:
        z := فشرده سازی.فشرده سازی(روش، متن برگردان تهی*، متن.طول())
        d := فشرده سازی.کدگشایی(روش، z.داده، z.طول)
        سرچاپ روش، فشرده سازی.بافر به رشته(d) برابر متن
    پایان
    سرچاپ فشرده سازی.نسبت(50، 100)، فشرده سازی.نسبت(1، 4)، فشرده سازی.نسبت(5، 0)

    g := فشرده سازی.فشرده سازی جی زیپ رشته(متن)
    ناپایا موفق := نادرست
    کدگشا := فشرده سازی.کدگشایی جی زیپ بافر(g، موفق)
    سرچاپ موفق، فشرده سازی.بافر به رشته(کدگشا) برابر متن
    _ := فشرده سازی.کدگشایی جی زیپ با سقف(g.داده، g.طول، 5، موفق)
    سرچاپ موفق
    کدگشا بدون سقف := فشرده سازی.کدگشایی جی زیپ با سقف(g.داده، g.طول، 0، موفق)
    سرچاپ موفق، فشرده سازی.بافر به رشته(کدگشا بدون سقف) برابر متن
    خام := فشرده سازی.دیفلیت خام(متن برگردان تهی*، متن.طول())
    _ := فشرده سازی.کدگشایی دیفلیت خام با سقف(خام.داده، خام.طول، متن.طول()، 5، موفق)
    سرچاپ موفق
    خام بدون سقف := فشرده سازی.کدگشایی دیفلیت خام با سقف(خام.داده، خام.طول، متن.طول()، 0، موفق)
    سرچاپ موفق، فشرده سازی.بافر به رشته(خام بدون سقف) برابر متن
پایان
