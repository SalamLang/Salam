بسته ریشه

واردسازی فشرده سازی
واردسازی حافظه
واردسازی آزمایش

تابع assert_buf_str(b: فشرده سازی.بافر بایت، want: رشته):
    got := فشرده سازی.بافر به رشته(b)
    آزمایش.ادعای برابری رشته(got، want)
    اگر got.طول() بزرگتر 0:
        حافظه.آزادسازی(got برگردان تهی*)
    پایان
پایان

تابع ریشه(): صحیح:
    text := "the quick brown fox jumps over the lazy dog"
    ناپایا packed := فشرده سازی.فشرده سازی جی زیپ رشته(text)
    ناپایا ok := نادرست
    ناپایا out := فشرده سازی.کدگشایی جی زیپ بافر(packed، ok)
    آزمایش.ادعای درستی(ok)
    assert_buf_str(out، text)
    فشرده سازی.آزادسازی بافر(out)

    // A corrupted CRC32 in the trailer must be noticed, not ignored.
    ناپایا bad_crc := فشرده سازی.کپی بافر(packed)
    فشرده سازی.تنظیم بایت(bad_crc، bad_crc.طول - 8، (فشرده سازی.دریافت بایت(bad_crc، bad_crc.طول - 8) ^ 1))
    ok = درست
    out = فشرده سازی.کدگشایی جی زیپ بافر(bad_crc، ok)
    آزمایش.ادعای نادرستی(ok)
    آزمایش.ادعای برابری عدد(out.طول، 0)
    فشرده سازی.آزادسازی بافر(out)
    فشرده سازی.آزادسازی بافر(bad_crc)

    // The uncompressed length (ISIZE) is checked too.
    ناپایا bad_size := فشرده سازی.کپی بافر(packed)
    فشرده سازی.تنظیم بایت(bad_size، bad_size.طول - 1، (فشرده سازی.دریافت بایت(bad_size، bad_size.طول - 1) + 1) & 255)
    ok = درست
    out = فشرده سازی.کدگشایی جی زیپ بافر(bad_size، ok)
    آزمایش.ادعای نادرستی(ok)
    آزمایش.ادعای برابری عدد(out.طول، 0)
    فشرده سازی.آزادسازی بافر(out)
    فشرده سازی.آزادسازی بافر(bad_size)

    // A copy that is left alone still round-trips.
    ok = نادرست
    out = فشرده سازی.کدگشایی جی زیپ بافر(packed، ok)
    آزمایش.ادعای درستی(ok)
    assert_buf_str(out، text)
    فشرده سازی.آزادسازی بافر(out)
    فشرده سازی.آزادسازی بافر(packed)

    برگشت آزمایش.خلاصه()
پایان
