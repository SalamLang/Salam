واردسازی فشرده سازی

تابع ریشه:
    متن := "سلام جی‌زیپ! سلام جی‌زیپ! سلام جی‌زیپ!"
    ج := فشرده سازی.فشرده سازی جی زیپ رشته(متن)
    سرچاپ فشرده سازی.دریافت بایت(ج، ۰)، فشرده سازی.دریافت بایت(ج، ۱)
    ناپایا خوب := نادرست
    ب := فشرده سازی.کدگشایی جی زیپ بافر(ج، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(ب) == متن
    ب۲ := فشرده سازی.بافر از رشته(متن)
    ج۲ := فشرده سازی.فشرده سازی جی زیپ بافر(ب۲)
    ج۳ := فشرده سازی.فشرده سازی جی زیپ(ب۲.داده، ب۲.طول)
    سرچاپ فشرده سازی.برابری بافر(ج۲، ج۳)
    _ := فشرده سازی.کدگشایی جی زیپ(ب۲.داده، ب۲.طول، خوب)
    سرچاپ خوب
    د := فشرده سازی.فشرده سازی دیفلیت(ب۲.داده، ب۲.طول)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی دیفلیت(د.داده، د.طول)، ب۲)
    خام := فشرده سازی.دیفلیت خام(ب۲.داده، ب۲.طول)
    باز := فشرده سازی.کدگشایی دیفلیت خام(خام.داده، خام.طول، ب۲.طول، خوب)
    سرچاپ خوب، فشرده سازی.برابری بافر(باز، ب۲)
    _ := فشرده سازی.کدگشایی دیفلیت خام با سقف(خام.داده، خام.طول، ب۲.طول، ۱۰، خوب)
    سرچاپ خوب
    کامل := فشرده سازی.کدگشایی دیفلیت خام با سقف(خام.داده، خام.طول، ب۲.طول، ۱۰۰۰، خوب)
    سرچاپ خوب، فشرده سازی.برابری بافر(کامل، ب۲)
    _ := فشرده سازی.کدگشایی جی زیپ با سقف(ج.داده، ج.طول، ۱۰، خوب)
    سرچاپ خوب
    همه := فشرده سازی.کدگشایی جی زیپ با سقف(ج.داده، ج.طول، ۱۰۰۰، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(همه) == متن
پایان
