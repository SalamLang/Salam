// زبان: فارسی
بسته ریشه

واردسازی فشرده سازی
واردسازی آزمایش

تابع make_data(n: صحیح، seed: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = (x * 1103515245 + 12345) & 0x7fffffff
        فشرده سازی.افزودن بایت(b، 97 + (x >> 16) % 7)
    پایان
    برگشت b
پایان

تابع ریشه(): صحیح:
    ناپایا data := make_data(50000، 5)
    ناپایا w := فشرده سازی.نویسنده بیت جدید()
    ناپایا at := 0
    تا at کوچکتر data.طول:
        ناپایا take := 12345
        اگر data.طول - at کوچکتر take:
            take = data.طول - at
        پایان
        last := at + take بزرگتربرابر data.طول
        فشرده سازی.دیفلیت خام در نویسنده(w، ((data.داده برگردان صحیح۶۴) + (at برگردان صحیح۶۴)) برگردان تهی*، take، last)
        at += take
    پایان
    فشرده سازی.تخلیه بیت(w)
    ناپایا ok := نادرست
    ناپایا out := فشرده سازی.کدگشایی دیفلیت خام(w.بافر.داده، w.بافر.طول، data.طول، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای درستی(فشرده سازی.برابری بافر(out، data))
    فشرده سازی.آزادسازی بافر(out)

    ناپایا whole := فشرده سازی.دیفلیت خام(data.داده، data.طول)
    ناپایا again := فشرده سازی.کدگشایی دیفلیت خام(whole.داده، whole.طول، data.طول، ok)
    آزمایش.ادعای درستی(ok و فشرده سازی.برابری بافر(again، data))
    فشرده سازی.آزادسازی بافر(again)
    فشرده سازی.آزادسازی بافر(whole)

    ناپایا empty := فشرده سازی.نویسنده بیت جدید()
    فشرده سازی.دیفلیت خام در نویسنده(empty، پوچ، 0، درست)
    فشرده سازی.تخلیه بیت(empty)
    ناپایا none := فشرده سازی.کدگشایی دیفلیت خام(empty.بافر.داده، empty.بافر.طول، 0، ok)
    آزمایش.ادعای درستی(ok و none.طول برابر 0)
    فشرده سازی.آزادسازی بافر(none)
    فشرده سازی.آزادسازی نویسنده بیت(empty)

    فشرده سازی.آزادسازی نویسنده بیت(w)
    فشرده سازی.آزادسازی بافر(data)
    برگشت آزمایش.خلاصه()
پایان
