واردسازی فشرده سازی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    base := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_compress_stream_fa")
    سیستم عامل.حذف همه(base)
    سیستم عامل.ساخت پوشه ها(base)
    text := "stream me, stream me, stream me. " * 100
    packed := فشرده سازی.دیفلیت خام(text برگردان تهی*، text.طول())

    ناپایا sink := فشرده سازی.بازکردن مقصد(مسیر پرونده.پیوند(base، "packed.bin")، 0 برگردان صحیح۶۴)
    سرچاپ فشرده سازی.نوشتن در مقصد(sink، packed.داده، packed.طول)، sink.نوشته شده برابر (packed.طول برگردان صحیح۶۴)، sink.ناموفق
    سرچاپ فشرده سازی.بستن مقصد(sink)، sink.پرونده برابر پوچ

    fp := فشرده سازی.بازکردن پرونده برای خواندن(مسیر پرونده.پیوند(base، "packed.bin"))
    size := فشرده سازی.اندازه پرونده(fp)
    سرچاپ size برابر (packed.طول برگردان صحیح۶۴)
    head := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    got := فشرده سازی.خواندن از جایگاه پرونده(fp، 0 برگردان صحیح۶۴، head، 4)
    سرچاپ got، فشرده سازی.جابجایی در پرونده(fp، 0 برگردان صحیح۶۴)
    حافظه.آزادسازی(head)

    ناپایا reader := فشرده سازی.خواننده بیت از پرونده(fp، 0 برگردان صحیح۶۴، size)
    سرچاپ reader.پرونده برابر fp، reader.باقی مانده برابر size
    ناپایا out := فشرده سازی.بازکردن مقصد(مسیر پرونده.پیوند(base، "text.txt")، 0 برگردان صحیح۶۴)
    ok := فشرده سازی.کدگشایی دیفلیت خام به مقصد(reader، out، نادرست)
    فشرده سازی.آزادسازی خواننده بیت پرونده(reader)
    سرچاپ ok، فشرده سازی.بستن مقصد(out)، out.نوشته شده برابر (text.طول() برگردان صحیح۶۴)، out.چک جمع برابر فشرده سازی.چک جمع سی آر سی رشته(text)

    ناپایا small := فشرده سازی.بازکردن مقصد(مسیر پرونده.پیوند(base، "small.txt")، 100 برگردان صحیح۶۴)
    ناپایا again := فشرده سازی.خواننده بیت از پرونده(fp، 0 برگردان صحیح۶۴، size)
    سرچاپ فشرده سازی.کدگشایی دیفلیت خام به مقصد(again، small، نادرست)، small.فراتر از سقف، small.سقف
    فشرده سازی.آزادسازی خواننده بیت پرونده(again)
    فشرده سازی.بستن مقصد(small)

    ناپایا part := فشرده سازی.بازکردن مقصد(مسیر پرونده.پیوند(base، "part.bin")، 0 برگردان صحیح۶۴)
    سرچاپ فشرده سازی.رونوشت از پرونده به مقصد(part، fp، 2 برگردان صحیح۶۴، 10 برگردان صحیح۶۴)، part.نوشته شده
    فشرده سازی.بستن مقصد(part)
    فشرده سازی.بستن پرونده(fp)

    first := "hello, "
    second := "world"
    running := فشرده سازی.به‌روزرسانی چک جمع سی آر سی(فشرده سازی.به‌روزرسانی چک جمع سی آر سی(0 برگردان طبیعی۳۲، first برگردان تهی*، first.طول())، second برگردان تهی*، second.طول())
    سرچاپ running برابر فشرده سازی.چک جمع سی آر سی رشته(first + second)

    gen := (off: صحیح۶۴، dst: تهی*، n: صحیح، _c: تهی*):
        p := dst برگردان طبیعی۸*
        تکرار n در k:
            p[k] = ((off + (k برگردان صحیح۶۴)) & (255 برگردان صحیح۶۴)) برگردان طبیعی۸
        پایان
        برگشت n
    پایان
    marker := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    cfp := فشرده سازی.بازکردن خواندن تابعی(1000 برگردان صحیح۶۴، gen، marker)
    سرچاپ فشرده سازی.اندازه پرونده(cfp)، فشرده سازی.بافت خواندن تابعی(cfp) برابر marker
    probe := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    سرچاپ فشرده سازی.خواندن از جایگاه پرونده(cfp، 258 برگردان صحیح۶۴، probe، 4)، (probe برگردان طبیعی۸*)[0]، (probe برگردان طبیعی۸*)[3]
    فشرده سازی.بستن پرونده(cfp)
    حافظه.آزادسازی(probe)
    حافظه.آزادسازی(marker)

    call := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴) برگردان طبیعی۸*
    call[0] = 0xE8 برگردان طبیعی۸
    call[2] = 1 برگردان طبیعی۸
    ناپایا mask := 0
    done := فشرده سازی.گام فیلتر شاخه(فشرده سازی.فیلتر ایکس۸۶، call برگردان تهی*، 16، 0 برگردان صحیح۶۴، mask)
    سرچاپ done، call[1] برگردان صحیح، call[2] برگردان صحیح، call[3] برگردان صحیح، call[4] برگردان صحیح، mask
    حافظه.آزادسازی(call برگردان تهی*)

    wf := فشرده سازی.بازکردن پرونده برای نوشتن(مسیر پرونده.پیوند(base، "empty.bin"))
    سرچاپ فشرده سازی.اندازه پرونده(wf)
    فشرده سازی.بستن پرونده(wf)
    سرچاپ فشرده سازی.بازکردن پرونده برای خواندن("no-such-file.bin") برابر پوچ
    سیستم عامل.حذف همه(base)
پایان
