واردسازی تبدیل

تابع نمایش(برچسب: رشته، خ: خطا):
    سرچاپ برچسب + ": " + خ.نام نوع() + " | " + خ.پیام + " [" + خ.کد + "، " + خ.ستون + "]"
پایان

تابع خواندن عدد(برچسب: رشته، متن: رشته):
    تلاش:
        سرچاپ برچسب + ": " + تبدیل.تجزیه عدد(متن)
    گرفتن خطا خ:
        نمایش(برچسب، خ)
    پایان
پایان

تابع خواندن اعشار(برچسب: رشته، متن: رشته):
    تلاش:
        سرچاپ برچسب + ": " + تبدیل.تجزیه اعشار(متن)
    گرفتن خطا خ:
        نمایش(برچسب، خ)
    پایان
پایان

تابع مجموع(تکه‌ها: رشته[]): صحیح۶۴ خطادار:
    ناپایا حاصل := ۰ برگردان صحیح۶۴
    هر تکه در تکه‌ها:
        حاصل += تلاش تبدیل.تجزیه عدد(تکه)
    پایان
    برگشت حاصل
پایان

تابع ریشه:
    خواندن عدد("رقم فارسی"، " -۱۴۰۳ ")
    خواندن عدد("رشته‌ی خالی"، "")
    خواندن عدد("حرف پس از رقم"، "۱۲abc")
    خواندن عدد("عدد بزرگ"، "99999999999999999999")
    خواندن اعشار("ممیز فارسی"، "۳٫۷۵")
    خواندن اعشار("ویرگول"، "۳,۷۵")
    تلاش:
        سرچاپ تبدیل.رشته به عدد("3000000000")
    گرفتن خطا خ:
        نمایش("رشته به عدد"، خ)
        سرچاپ خ.است(نوع خطا.خارج از بازه)
    پایان
    تلاش:
        سرچاپ تبدیل.تجزیه منطقی("yes")، تبدیل.تجزیه شانزده("0x1f")
        سرچاپ تبدیل.تجزیه منطقی("بله")
    گرفتن خطا خ:
        نمایش("تجزیه منطقی"، خ)
    پایان
    سرچاپ تبدیل.تجزیه عدد با پیش فرض("x"، -۱)، تبدیل.رشته به عدد با پیش فرض("۸۰"، ۰)، تبدیل.تجزیه اعشار با پیش فرض(""، ۱.۵)، تبدیل.تجزیه منطقی با پیش فرض("True"، نادرست)، تبدیل.تجزیه شانزده با پیش فرض("g"، ۰)
    تلاش:
        سرچاپ مجموع(["۱"، "۲"، "3"])
        سرچاپ مجموع(["۱"، "دو"])
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
    پایان
پایان
