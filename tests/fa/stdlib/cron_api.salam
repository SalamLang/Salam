بسته ریشه

واردسازی کرون

پایا ZONE := "Invalid/Nowhere"
پایا OFF := 210
پایا NOON := 1792843200

تابع ریشه:
    سرچاپ "offset fallback: "، کرون.اختلاف ثانیه منطقه(ZONE، OFF، NOON برگردان صحیح۶۴)
    سرچاپ "offset negative: "، کرون.اختلاف ثانیه منطقه(ZONE، -300، NOON برگردان صحیح۶۴)

    every5 := کرون.تجزیه("*/5 * * * *")
    سرچاپ "local 0 min: "، کرون.تطبیق محلی(every5، 1792843200 برگردان صحیح۶۴)
    سرچاپ "local 5 min: "، کرون.تطبیق محلی(every5، 1792843500 برگردان صحیح۶۴)
    سرچاپ "local 7 min: "، کرون.تطبیق محلی(every5، 1792843620 برگردان صحیح۶۴)

    daily := کرون.تجزیه("0 12 * * *")
    سرچاپ "daily noon: "، کرون.تطبیق محلی(daily، 1792843200 برگردان صحیح۶۴)
    سرچاپ "daily 12:01: "، کرون.تطبیق محلی(daily، 1792843260 برگردان صحیح۶۴)

    bad := کرون.تجزیه("nope")
    سرچاپ "invalid expr: "، کرون.تطبیق محلی(bad، 1792843200 برگردان صحیح۶۴)

    shifted := NOON برگردان صحیح۶۴ + کرون.اختلاف ثانیه منطقه(ZONE، OFF، NOON برگردان صحیح۶۴)
    سرچاپ "shifted 15:30: "، کرون.تطبیق محلی(کرون.تجزیه("30 15 * * *")، shifted)
پایان
