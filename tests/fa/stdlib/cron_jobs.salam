// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی حافظه
واردسازی زمان
واردسازی کرون

پایا ZONE := "Invalid/Nowhere"
پایا OFF := 0
پایا AFTER := 1792800300

ناپایا hits := پوچ برگردان صحیح۶۴*
ناپایا befores := پوچ برگردان صحیح۶۴*
ناپایا afters := پوچ برگردان صحیح۶۴*

ناپایا errors := پوچ برگردان صحیح۶۴*

تابع tick(_id: صحیح۶۴):
    اتمی‌بیفزا(hits، 1 برگردان صحیح۶۴)
پایان

تابع before(_id: صحیح۶۴):
    اتمی‌بیفزا(befores، 1 برگردان صحیح۶۴)
پایان

تابع flaky(id: صحیح۶۴):
    کرون.شکست(id)
پایان

تابع onerror(_id: صحیح۶۴):
    اتمی‌بیفزا(errors، 1 برگردان صحیح۶۴)
پایان

تابع after(_id: صحیح۶۴):
    اتمی‌بیفزا(afters، 1 برگردان صحیح۶۴)
پایان

تابع slow(_id: صحیح۶۴):
    زمان.خواب(50)
پایان

تابع settle():
    ناپایا waited := 0
    ناپایا any := درست
    تا any و waited کوچکتر 500:
        any = نادرست
        تکرار کرون.کل() در i:
            اگر کرون.مشغول است(i): any = درست پایان
        پایان
        زمان.خواب(10)
        waited += 1
    پایان
پایان

تابع fire(now: صحیح۶۴): صحیح:
    n := کرون.اجرای موعد(now)
    settle()
    برگشت n
پایان

تابع ریشه:
    hits = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    befores = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    afters = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    کرون.تنظیم منطقه(ZONE، OFF)

    sec := کرون.تجزیه("15,45 * * * * *")
    five := کرون.تجزیه("* * * * *")
    bad := کرون.تجزیه("60 * * * * *")
    seven := کرون.تجزیه("* * * * * * *")
    سرچاپ "six fields: "، sec.معتبر، " with seconds: "، sec.با ثانیه
    سرچاپ "five fields: "، five.با ثانیه
    سرچاپ "bad seconds: "، bad.معتبر
    سرچاپ "seven fields: "، seven.معتبر
    سرچاپ "next 1: "، کرون.بعدی(sec، AFTER برگردان صحیح۶۴، ZONE، OFF)
    سرچاپ "next 2: "، کرون.بعدی(sec، (AFTER + 15) برگردان صحیح۶۴، ZONE، OFF)
    سرچاپ "next 3: "، کرون.بعدی(sec، (AFTER + 45) برگردان صحیح۶۴، ZONE، OFF)

    سرچاپ "bad daily: "، کرون.روزانه در("x"، "25:00"، tick)
    سرچاپ "bad every: "، کرون.هر("x"، 0، tick)
    سرچاپ "bad between: "، کرون.هر بین("x"، 5، 2، tick)
    سرچاپ "bad monthly: "، کرون.ماهانه در("x"، 32، "10:00"، tick)

    کرون.پیش از اجرا(before)
    کرون.پس از اجرا(after)

    daily := کرون.روزانه در("daily"، "10:30"، tick)
    سرچاپ "daily next: "، کرون.اجرای بعدی(daily، AFTER برگردان صحیح۶۴)
    سرچاپ "fire 10:30: "، fire(1792837800 برگردان صحیح۶۴)
    سرچاپ "fire 10:31: "، fire(1792837860 برگردان صحیح۶۴)

    weekly := کرون.هفتگی در("weekly"، "mon"، "09:15:30"، tick)
    سرچاپ "weekly next: "، کرون.اجرای بعدی(weekly، AFTER برگردان صحیح۶۴)

    monthly := کرون.ماهانه در("monthly"، 15، "00:00"، tick)
    سرچاپ "monthly next: "، کرون.اجرای بعدی(monthly، AFTER برگردان صحیح۶۴)

    سرچاپ "once id: "، کرون.یک بار("once"، 1792900000 برگردان صحیح۶۴، tick) بزرگتربرابر 0
    سرچاپ "once early: "، fire(1792899999 برگردان صحیح۶۴)
    سرچاپ "once due: "، fire(1792900000 برگردان صحیح۶۴)
    سرچاپ "once again: "، fire(1792900000 برگردان صحیح۶۴)

    limited := کرون.افزودن("limited"، "* * * * *"، tick)
    کرون.محدودیت(limited، 2)
    سرچاپ "limited 1: "، fire(1792800000 برگردان صحیح۶۴)
    سرچاپ "limited 2: "، fire(1792800060 برگردان صحیح۶۴)
    سرچاپ "limited 3: "، fire(1792800120 برگردان صحیح۶۴)
    سرچاپ "limited runs: "، کرون.تعداد اجرا(limited)

    window := کرون.افزودن("window"، "* * * * *"، tick)
    کرون.شروع از(window، 1792801000 برگردان صحیح۶۴)
    کرون.توقف در(window، 1792802000 برگردان صحیح۶۴)
    سرچاپ "window before: "، fire(1792800900 برگردان صحیح۶۴)
    سرچاپ "window inside: "، fire(1792801500 برگردان صحیح۶۴)
    سرچاپ "window after: "، fire(1792802100 برگردان صحیح۶۴)
    سرچاپ "window next: "، کرون.اجرای بعدی(window، 1792800000 برگردان صحیح۶۴)

    t1 := کرون.افزودن("t1"، "* * * * *"، tick)
    t2 := کرون.افزودن("t2"، "* * * * *"، tick)
    کرون.تنظیم برچسب(t1، "ops,nightly")
    کرون.تنظیم برچسب(t2، "ops")
    سرچاپ "has tag: "، کرون.برچسب دارد(t1، "nightly")، " "، کرون.برچسب دارد(t2، "nightly")
    سرچاپ "count before: "، کرون.تعداد()
    سرچاپ "removed: "، کرون.حذف با برچسب("ops")
    سرچاپ "count after: "، کرون.تعداد()
    سرچاپ "find window: "، کرون.یافتن("window") برابر window
    سرچاپ "find removed: "، کرون.یافتن("t1")

    کرون.حذف(window)
    سرچاپ "find gone: "، کرون.یافتن("window")

    id := کرون.هر("fast"، 30، tick)
    کرون.صف(id)
    سرچاپ "run now: "، کرون.اجرای فوری(id)
    settle()
    سرچاپ "runs: "، کرون.تعداد اجرا(id)، " last run set: "، کرون.آخرین اجرا(id) بزرگتر (0 برگردان صحیح۶۴)
    started := کرون.آخرین اجرا(id)
    finished := کرون.آخرین اتمام(id)
    سرچاپ "finished set: "، finished بزرگتربرابر started

    nb := اتمی‌بخوان(befores)
    na := اتمی‌بخوان(afters)
    سرچاپ "hooks balanced: "، nb برابر na
    سرچاپ "hooks ran: "، nb بزرگتر (0 برگردان صحیح۶۴)

    errors = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    کرون.هنگام خطا(onerror)
    fid := کرون.هر("flaky"، 30، flaky)
    سرچاپ "flaky now: "، کرون.اجرای فوری(fid)
    settle()
    سرچاپ "failures: "، کرون.تعداد شکست(fid)، " handler: "، اتمی‌بخوان(errors)

    کرون.سقف هم‌زمانی(1)
    a := کرون.افزودن("cap a"، "* * * * *"، slow)
    b := کرون.افزودن("cap b"، "* * * * *"، slow)
    سرچاپ "capped: "، fire(1792900200 برگردان صحیح۶۴)، " "، کرون.تعداد اجرا(a) + کرون.تعداد اجرا(b)
    کرون.سقف هم‌زمانی(0)
پایان
