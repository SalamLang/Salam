 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته
واردسازی زمان
واردسازی کرون
واردسازی هسته

پایا ZONE := "Invalid/Nowhere"
پایا AT := 1792900200

ناپایا zero := 0
ناپایا slot := 5
ناپایا table := [1، 2، 3]
ناپایا ran := پوچ برگردان صحیح۶۴*
ناپایا panics := پوچ برگردان صحیح۶۴*
ناپایا events := پوچ برگردان صحیح۶۴*
ناپایا lockable := درست

تابع work(_id: صحیح۶۴):
    اتمی‌بیفزا(ran، 1 برگردان صحیح۶۴)
پایان

تابع boom(_id: صحیح۶۴):
    هسته.خطای مرگبار("boom")
پایان

تابع divide(_id: صحیح۶۴):
    سرچاپ 10 / zero
پایان

تابع index(_id: صحیح۶۴):
    سرچاپ table[slot]
پایان

تابع spoke(_id: صحیح۶۴):
    اتمی‌بیفزا(panics، 1 برگردان صحیح۶۴)
پایان

تابع watch(arg: صحیح۶۴):
    kind := کرون.نوع رویداد(arg)
    اتمی‌بیفزا(events، kind برگردان صحیح۶۴)
پایان

تابع gate(id: صحیح۶۴):
    اگر lockable: کرون.اعطا(id) پایان
پایان

تابع settle():
    ناپایا waited := 0
    ناپایا any := درست
    تا any و waited کوچکتر 500:
        any = نادرست
        تکرار کرون.کل() در i:
            اگر کرون.مشغول است(i): any = درست پایان
        پایان
        زمان.خواب(10)
        waited += 1
    پایان
پایان

تابع fire(now: صحیح۶۴): صحیح:
    n := کرون.اجرای موعد(now)
    settle()
    برگشت n
پایان

تابع ریشه:
    ran = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    panics = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    events = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    کرون.تنظیم منطقه(ZONE، 0)
    کرون.هنگام خطای مرگبار(spoke)
    کرون.هنگام رویداد(watch)

    good := کرون.افزودن("good"، "* * * * *"، work)
    b := کرون.افزودن("boom"، "* * * * *"، boom)
    d := کرون.افزودن("divide"، "* * * * *"، divide)
    x := کرون.افزودن("index"، "* * * * *"، index)
    سرچاپ "started: "، fire(AT برگردان صحیح۶۴)
    سرچاپ "program survived"
    سرچاپ "good ran: "، اتمی‌بخوان(ran)
    سرچاپ "panics: "، کرون.تعداد خطای مرگبار(b)، " "، کرون.تعداد خطای مرگبار(d)، " "، کرون.تعداد خطای مرگبار(x)، " handler: "، اتمی‌بخوان(panics)
    سرچاپ "failures counted: "، کرون.تعداد شکست(b)
    سرچاپ "busy after panic: "، کرون.مشغول است(b)، " "، کرون.مشغول است(d)، " "، کرون.مشغول است(x)
    سرچاپ "last panic recorded: "، کرون.آخرین خطای مرگبار().طول() بزرگتر 0
    سرچاپ "running: "، کرون.در حال اجرا()
    سرچاپ "second round: "، fire((AT + 60) برگردان صحیح۶۴)
    سرچاپ "good ran: "، اتمی‌بخوان(ran)، " panics: "، کرون.تعداد خطای مرگبار(b)
    سرچاپ "events seen: "، اتمی‌بخوان(events) بزرگتر (0 برگردان صحیح۶۴)

    m := کرون.سنجه‌ها()
    سرچاپ "metric runs: "، رشته.شامل است(m، "cron_job_runs_total{job=\"good\"} 2")
    سرچاپ "metric panics: "، رشته.شامل است(m، "cron_job_panics_total{job=\"boom\"} 2")
    سرچاپ "metric running: "، رشته.شامل است(m، "cron_jobs_running 0")
    سرچاپ "metric type: "، رشته.شامل است(m، "# TYPE cron_job_duration_ms_max gauge")

    کرون.حذف(b)
    کرون.حذف(d)
    کرون.حذف(x)
    کرون.حذف(good)

    کرون.تنظیم قفل(gate، 0 برگردان صحیح۶۴)
    leader := کرون.افزودن("leader"، "* * * * *"، work)
    lockable = نادرست
    before := اتمی‌بخوان(ran)
    سرچاپ "denied start: "، fire((AT + 120) برگردان صحیح۶۴)
    سرچاپ "denied ran: "، اتمی‌بخوان(ran) - before، " denied: "، کرون.قفل رد شد(leader)، " runs: "، کرون.تعداد اجرا(leader)
    lockable = درست
    سرچاپ "granted start: "، fire((AT + 180) برگردان صحیح۶۴)
    سرچاپ "key: "، کرون.کلید قفل(leader)
    کرون.حذف(leader)

    dir := "cron_locks_test"
    سرچاپ "file locker: "، کرون.قفل پوشه(dir، 120)
    one := کرون.افزودن("shared job"، "* * * * *"، work)
    two := کرون.افزودن("shared job"، "* * * * *"، work)
    first := اتمی‌بخوان(ran)
    fire((AT + 240) برگردان صحیح۶۴)
    سرچاپ "only one instance ran: "، اتمی‌بخوان(ran) - first
    سرچاپ "denied on the other: "، کرون.قفل رد شد(one) + کرون.قفل رد شد(two)
    کرون.حذف قفل()
    سیستم عامل.حذف همه(dir)
پایان
