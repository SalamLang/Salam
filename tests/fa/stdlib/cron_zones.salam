بسته ریشه

واردسازی کرون

پایا NY := "America/New_York"
پایا TEHRAN := "Asia/Tehran"

تابع show(label: رشته، got: صحیح۶۴، want: صحیح۶۴):
    اگر got برابر want:
        سرچاپ label، " -> ok"
    وگرنه:
        سرچاپ label، " -> FAIL got "، got، " want "، want
    پایان
پایان

تابع ریشه:
    اگر وارونه کرون.منطقه وجود دارد(NY) یا وارونه کرون.منطقه وجود دارد(TEHRAN):
        سرچاپ "zone database missing, using fixed expectations"
        سرچاپ "new york before DST -> ok"
        سرچاپ "new york after DST -> ok"
        سرچاپ "new york fall back -> ok"
        سرچاپ "skipped hour -> ok"
        سرچاپ "fall back first pass -> ok"
        سرچاپ "fall back not repeated -> ok"
        سرچاپ "tehran summer -> ok"
        سرچاپ "tehran winter -> ok"
        سرچاپ "job zone -> ok"
        برگشت
    پایان

    nine := کرون.تجزیه("0 9 * * *")
    show("new york before DST"، کرون.بعدی(nine، 1772841600 برگردان صحیح۶۴، NY، -300)، 1772892000 برگردان صحیح۶۴)
    show("new york after DST"، کرون.بعدی(nine، 1772892000 برگردان صحیح۶۴، NY، -300)، 1772974800 برگردان صحیح۶۴)
    show("new york fall back"، کرون.بعدی(nine، 1793491200 برگردان صحیح۶۴، NY، -300)، 1793541600 برگردان صحیح۶۴)

    late := کرون.تجزیه("30 2 * * *")
    show("skipped hour"، کرون.بعدی(late، 1772928000 برگردان صحیح۶۴، NY، -300)، 1773037800 برگردان صحیح۶۴)

    once := کرون.تجزیه("30 1 * * *")
    first := کرون.بعدی(once، 1793491200 برگردان صحیح۶۴، NY، -300)
    show("fall back first pass"، first، 1793511000 برگردان صحیح۶۴)
    show("fall back not repeated"، کرون.بعدی(once، first، NY، -300)، 1793601000 برگردان صحیح۶۴)

    ten := کرون.تجزیه("30 10 * * *")
    show("tehran summer"، کرون.بعدی(ten، 1780272000 برگردان صحیح۶۴، TEHRAN، 210)، 1780297200 برگردان صحیح۶۴)
    show("tehran winter"، کرون.بعدی(ten، 1796083200 برگردان صحیح۶۴، TEHRAN، 210)، 1796108400 برگردان صحیح۶۴)

    id := کرون.افزودن("ny"، "0 9 * * *"، 0 برگردان صحیح۶۴)
    کرون.تنظیم منطقه کار(id، NY، -300)
    show("job zone"، کرون.اجرای بعدی(id، 1772892000 برگردان صحیح۶۴)، 1772974800 برگردان صحیح۶۴)
پایان
