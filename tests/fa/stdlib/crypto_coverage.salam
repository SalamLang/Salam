بسته ریشه

واردسازی آزمایش
واردسازی رمزنگاری
واردسازی حافظه
واردسازی رشته

ناب تابع hexdigit(v: صحیح): صحیح:
    اگر v کوچکتر 10: برگشت 48 + v پایان
    برگشت 87 + v
پایان

تابع hex_of(p: تهی*، n: صحیح): رشته:
    bp := p برگردان طبیعی۸*
    ناپایا sb := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(sb)
    تکرار n در i:
        b := bp[i] برگردان صحیح
        رشته.افزودن نویسه به بافر(sb، hexdigit(b / 16))
        رشته.افزودن نویسه به بافر(sb، hexdigit(b % 16))
    پایان
    out := رشته.رشته بافر(sb)
    برگشت out
پایان

تابع test_digests():
    msg := "abc"
    out := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(out)
    رمزنگاری.ام دی۵ بایت(msg برگردان تهی*، 3، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 16)، "900150983cd24fb0d6963f7d28e17f72")
    رمزنگاری.شا۱ بایت(msg برگردان تهی*، 3، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 20)، "a9993e364706816aba3e25717850c26c9cd0d89d")
    رمزنگاری.شا۳۸۴ بایت(msg برگردان تهی*، 3، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 48)، "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    رمزنگاری.شا۵۱۲ بایت(msg برگردان تهی*، 3، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 64)، "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
پایان

تابع test_streaming():
    out := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(out)
    ناپایا s := رمزنگاری.شا۲۵۶ جدید()
    رمزنگاری.به روز رسانی شا۲۵۶(s، "a" برگردان تهی*، 1)
    رمزنگاری.به روز رسانی شا۲۵۶(s، "bc" برگردان تهی*، 2)
    رمزنگاری.نهایی شا۲۵۶(s، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 32)، "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    ناپایا s3 := رمزنگاری.شا۳۸۴ جدید()
    رمزنگاری.به روز رسانی شا۵۱۲(s3، "a" برگردان تهی*، 1)
    رمزنگاری.به روز رسانی شا۵۱۲(s3، "bc" برگردان تهی*، 2)
    رمزنگاری.نهایی شا۵۱۲(s3، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 48)، "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    ناپایا s5 := رمزنگاری.شا۵۱۲ جدید()
    رمزنگاری.به روز رسانی شا۵۱۲(s5، "ab" برگردان تهی*، 2)
    رمزنگاری.به روز رسانی شا۵۱۲(s5، "c" برگردان تهی*، 1)
    رمزنگاری.نهایی شا۵۱۲(s5، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 64)، "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
پایان

تابع test_hmac():
    key := "Jefe"
    data := "what do ya want for nothing?"
    out := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(out)
    رمزنگاری.اچ مک شا۱ بایتی(key، data، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 20)، "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    آزمایش.ادعای برابری رشته(رمزنگاری.اچ مک شا۱ شانزدهی(key، data)، "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    آزمایش.ادعای برابری رشته(رمزنگاری.اچ مک شا۱ بیس۶۴(key، data)، "7/zfauXrL6LSdBbV8YTfnCWafHk=")
    رمزنگاری.اچ مک شا۱ خام(key برگردان تهی*، 4، data برگردان تهی*، data.طول()، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 20)، "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    رمزنگاری.اچ مک شا۳۸۴ بایت(key، data، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 48)، "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
    رمزنگاری.اچ مک شا۵۱۲ بایت(key، data، out)
    آزمایش.ادعای برابری رشته(hex_of(out، 64)، "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
پایان

تابع test_bcrypt_salt():
    salt := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(salt)
    a := رمزنگاری.درهم بی کریپت با نمک("secret"، 4، salt)
    b := رمزنگاری.درهم بی کریپت با نمک("secret"، 4، salt)
    آزمایش.ادعای برابری رشته(a، b)
    آزمایش.ادعای برابری عدد(a.طول()، 60)
    آزمایش.ادعای برابری رشته(a.زیررشته(0، 7)، "$2y$04$")
    آزمایش.ادعای برابری رشته(a.زیررشته(7، 22)، "......................")
    آزمایش.ادعای درستی(رمزنگاری.تایید بی کریپت("secret"، a))
    آزمایش.ادعای نادرستی(رمزنگاری.تایید بی کریپت("other"، a))
    آزمایش.ادعای برابری عدد(رمزنگاری.هزینه بی کریپت(a)، 4)
پایان

تابع test_random_and_hash():
    buf := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(buf)
    other := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(other)
    رمزنگاری.بایت های تصادفی(buf، 32)
    رمزنگاری.بایت های تصادفی(other، 32)
    آزمایش.ادعای نابرابری رشته(hex_of(buf، 32)، hex_of(other، 32))
    zero := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(zero)
    آزمایش.ادعای نابرابری رشته(hex_of(buf، 32)، hex_of(zero، 32))
    آزمایش.ادعای درستی(رمزنگاری.درهم بایت("abc" برگردان تهی*، 3 برگردان طبیعی۶۴) برابر رمزنگاری.درهم بایت("abc" برگردان تهی*، 3 برگردان طبیعی۶۴))
    آزمایش.ادعای درستی(رمزنگاری.درهم بایت("abc" برگردان تهی*، 3 برگردان طبیعی۶۴) نابرابر رمزنگاری.درهم بایت("abd" برگردان تهی*، 3 برگردان طبیعی۶۴))
پایان

تابع ریشه:
    test_digests()
    test_streaming()
    test_hmac()
    test_bcrypt_salt()
    test_random_and_hash()
    آزمایش.خلاصه()
    برگشت 0
پایان
