بسته ریشه

واردسازی آزمایش
واردسازی رمزنگاری
واردسازی حافظه
واردسازی رشته

ناب تابع رقم شانزده‌دهی(v: صحیح): صحیح:
    اگر v کوچکتر 10: برگشت 48 + v پایان
    برگشت 87 + v
پایان

تابع متن شانزده‌دهی(p: تهی*، n: صحیح): رشته:
    بایت‌ها := p برگردان طبیعی۸*
    ناپایا سازنده := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(سازنده)
    تکرار n در i:
        b := بایت‌ها[i] برگردان صحیح
        رشته.افزودن نویسه به بافر(سازنده، رقم شانزده‌دهی(b / 16))
        رشته.افزودن نویسه به بافر(سازنده، رقم شانزده‌دهی(b % 16))
    پایان
    خروجی := رشته.رشته بافر(سازنده)
    برگشت خروجی
پایان

تابع test_digests():
    پیام := "abc"
    خروجی := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(خروجی)
    رمزنگاری.ام دی۵ بایت(پیام برگردان تهی*، 3، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 16)، "900150983cd24fb0d6963f7d28e17f72")
    رمزنگاری.شا۱ بایت(پیام برگردان تهی*، 3، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 20)، "a9993e364706816aba3e25717850c26c9cd0d89d")
    رمزنگاری.شا۳۸۴ بایت(پیام برگردان تهی*، 3، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 48)، "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    رمزنگاری.شا۵۱۲ بایت(پیام برگردان تهی*، 3، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 64)، "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
پایان

تابع test_streaming():
    خروجی := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(خروجی)
    ناپایا s := رمزنگاری.شا۲۵۶ جدید()
    رمزنگاری.به روز رسانی شا۲۵۶(s، "a" برگردان تهی*، 1)
    رمزنگاری.به روز رسانی شا۲۵۶(s، "bc" برگردان تهی*، 2)
    رمزنگاری.نهایی شا۲۵۶(s، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 32)، "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    ناپایا حالت۳۸۴ := رمزنگاری.شا۳۸۴ جدید()
    رمزنگاری.به روز رسانی شا۵۱۲(حالت۳۸۴، "a" برگردان تهی*، 1)
    رمزنگاری.به روز رسانی شا۵۱۲(حالت۳۸۴، "bc" برگردان تهی*، 2)
    رمزنگاری.نهایی شا۵۱۲(حالت۳۸۴، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 48)، "cb00753f45a35e8bb5a03d699ac65007272c32ab0eded1631a8b605a43ff5bed8086072ba1e7cc2358baeca134c825a7")
    ناپایا حالت۵۱۲ := رمزنگاری.شا۵۱۲ جدید()
    رمزنگاری.به روز رسانی شا۵۱۲(حالت۵۱۲، "ab" برگردان تهی*، 2)
    رمزنگاری.به روز رسانی شا۵۱۲(حالت۵۱۲، "c" برگردان تهی*، 1)
    رمزنگاری.نهایی شا۵۱۲(حالت۵۱۲، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 64)، "ddaf35a193617abacc417349ae20413112e6fa4e89a97ea20a9eeee64b55d39a2192992a274fc1a836ba3c23a3feebbd454d4423643ce80e2a9ac94fa54ca49f")
پایان

تابع test_hmac():
    کلید := "Jefe"
    داده‌ها := "what do ya want for nothing?"
    خروجی := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(خروجی)
    رمزنگاری.اچ مک شا۱ بایتی(کلید، داده‌ها، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 20)، "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    آزمایش.ادعای برابری رشته(رمزنگاری.اچ مک شا۱ شانزدهی(کلید، داده‌ها)، "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    آزمایش.ادعای برابری رشته(رمزنگاری.اچ مک شا۱ بیس۶۴(کلید، داده‌ها)، "7/zfauXrL6LSdBbV8YTfnCWafHk=")
    رمزنگاری.اچ مک شا۱ خام(کلید برگردان تهی*، 4، داده‌ها برگردان تهی*، داده‌ها.طول()، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 20)، "effcdf6ae5eb2fa2d27416d5f184df9c259a7c79")
    رمزنگاری.اچ مک شا۳۸۴ بایت(کلید، داده‌ها، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 48)، "af45d2e376484031617f78d2b58a6b1b9c7ef464f5a01b47e42ec3736322445e8e2240ca5e69e2c78b3239ecfab21649")
    رمزنگاری.اچ مک شا۵۱۲ بایت(کلید، داده‌ها، خروجی)
    آزمایش.ادعای برابری رشته(متن شانزده‌دهی(خروجی، 64)، "164b7a7bfcf819e2e395fbe73b56e0a387bd64222e831fd610270cd7ea2505549758bf75c05a994a6d034f65f8f0e6fdcaeab1a34d4a6b4b636e070a38bce737")
پایان

تابع test_bcrypt_salt():
    نمک := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(نمک)
    a := رمزنگاری.درهم بی کریپت با نمک("secret"، 4، نمک)
    b := رمزنگاری.درهم بی کریپت با نمک("secret"، 4، نمک)
    آزمایش.ادعای برابری رشته(a، b)
    آزمایش.ادعای برابری عدد(a.طول()، 60)
    آزمایش.ادعای برابری رشته(a.زیررشته(0، 7)، "$2y$04$")
    آزمایش.ادعای برابری رشته(a.زیررشته(7، 22)، "......................")
    آزمایش.ادعای درستی(رمزنگاری.تایید بی کریپت("secret"، a))
    آزمایش.ادعای نادرستی(رمزنگاری.تایید بی کریپت("other"، a))
    آزمایش.ادعای برابری عدد(رمزنگاری.هزینه بی کریپت(a)، 4)
پایان

تابع test_random_and_hash():
    بافر := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(بافر)
    دیگری := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(دیگری)
    رمزنگاری.بایت های تصادفی(بافر، 32)
    رمزنگاری.بایت های تصادفی(دیگری، 32)
    آزمایش.ادعای نابرابری رشته(متن شانزده‌دهی(بافر، 32)، متن شانزده‌دهی(دیگری، 32))
    صفر := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(صفر)
    آزمایش.ادعای نابرابری رشته(متن شانزده‌دهی(بافر، 32)، متن شانزده‌دهی(صفر، 32))
    آزمایش.ادعای درستی(رمزنگاری.درهم بایت("abc" برگردان تهی*، 3 برگردان طبیعی۶۴) برابر رمزنگاری.درهم بایت("abc" برگردان تهی*، 3 برگردان طبیعی۶۴))
    آزمایش.ادعای درستی(رمزنگاری.درهم بایت("abc" برگردان تهی*، 3 برگردان طبیعی۶۴) نابرابر رمزنگاری.درهم بایت("abe" برگردان تهی*، 3 برگردان طبیعی۶۴))
پایان

تابع ریشه:
    test_digests()
    test_streaming()
    test_hmac()
    test_bcrypt_salt()
    test_random_and_hash()
    آزمایش.خلاصه()
    برگشت 0
پایان
