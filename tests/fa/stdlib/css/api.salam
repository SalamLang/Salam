// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس
واردسازی رشته
واردسازی حافظه

تابع media(cond: رشته، env: سی اس اس.محیط):
    سرچاپ "media"، cond، سی اس اس.تطبیق رسانه(cond، env)
پایان

تابع ریشه:
    ua := سی اس اس.سی اس اس پیش فرض()
    سرچاپ "default style sheet has h1 rule"، رشته.شامل است(ua، "h1 { font-size: 2em")
    سرچاپ "tags"، سی اس اس.برچسب نوع("paragraph")، سی اس اس.برچسب نوع("box")، سی اس اس.برچسب نوع("item")، سی اس اس.برچسب نوع("text area")، سی اس اس.برچسب نوع("page")، سی اس اس.برچسب نوع("h3")
    ناپایا sheet := سی اس اس.برگه خالی()
    دیرکن sheet.آزادسازی برگه()
    سرچاپ "empty"، sheet.شمار قاعده ها()
    سرچاپ "defaults"، sheet.افزودن پیش فرض ها() بزرگتر 50، sheet.شمار قاعده ها() بزرگتر 100
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    els.بیفزا(سی اس اس.عنصر تازه("page"، -1))
    ناپایا a := سی اس اس.عنصر تازه("link"، 0)
    a.افزودن ویژگی("href"، "/home")
    سرچاپ "attr"، a.ویژگی دارد("href")، a.ویژگی دارد("title")
    els.بیفزا(a)
    ناپایا b := سی اس اس.عنصر تازه("link"، 0)
    b.افزودن ویژگی("href"، "/about")
    els.بیفزا(b)
    ناپایا c := سی اس اس.عنصر تازه("paragraph"، 0)
    c.اعلان های پایه = "color: red"
    els.بیفزا(c)
    سرچاپ "before compute"، sheet.شمار عنصرها()، sheet.شناسه سبک(0)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط {})
    سرچاپ "elements"، sheet.شمار عنصرها()، "same style for both links"، sheet.شناسه سبک(1) برابر sheet.شناسه سبک(2)، "paragraph differs"، sheet.شناسه سبک(3) نابرابر sheet.شناسه سبک(1)
    سرچاپ "cascades"، sheet.شمار آبشارها()، "distinct"، sheet.شمار سبک های یکتا()
    narrow := سی اس اس.محیط { پهنای پنجره = 500.0، بلندی پنجره = 800.0، حالت تیره = درست، حرکت کمتر = درست }
    wide := سی اس اس.محیط { پهنای پنجره = 1280.0، بلندی پنجره = 720.0 }
    media("(max-width: 600px)"، narrow)
    media("(max-width: 600px)"، wide)
    media("(min-width: 600px) and (orientation: landscape)"، wide)
    media("screen and (prefers-color-scheme: dark)"، narrow)
    media("not print"، wide)
    media("print"، wide)
    media("(400px <= width <= 700px)"، narrow)
    media("(width > 1000px), (prefers-reduced-motion: reduce)"، narrow)
    media("(hover: hover) and (pointer: fine)"، wide)
    media("(min-aspect-ratio: 16/9)"، wide)
    media("(max-width: 40em)"، narrow)
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
    حافظه.آزادسازی(ua برگردان تهی*)
پایان
