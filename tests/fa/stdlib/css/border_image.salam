واردسازی رابط گرافیکی.سی اس اس
واردسازی حافظه

تابع show_style(cs: سی اس اس.سبک‌محاسبه‌شده):
    names := ["border-image-source"، "border-image-slice"، "border-image-width"، "border-image-outset"، "border-image-repeat"]
    تکرار طول(names) در i:
        v := سی اس اس.متن مقدار(cs، names[i])
        سرچاپ "   "، names[i]، "="، v
        حافظه.آزادسازی(v برگردان تهی*)
    پایان
پایان

تابع text_path(decls: رشته):
    ناپایا sheet := سی اس اس.برگه تازه()
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا e := سی اس اس.عنصر تازه("box"، -1)
    e.اعلان های پایه = decls
    els.بیفزا(e)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 800.0، بلندی پنجره = 600.0 })
    سرچاپ decls
    show_style(sheet.سبک عنصر(0))
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
    sheet.آزادسازی برگه()
پایان

تابع typed_path(decls: رشته):
    ناپایا p := سی اس اس.برنامه سبک تازه()
    _id := سی اس اس.ترجمه سی اس اس(p، "div { " + decls + " }")
    ناپایا sheet := سی اس اس.برگه از برنامه(p)
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا e := سی اس اس.عنصر تازه("box"، -1)
    e.برچسب عنصر = "div"
    els.بیفزا(e)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 800.0، بلندی پنجره = 600.0 })
    cs := sheet.سبک عنصر(0)
    سرچاپ "typed"، decls
    show_style(cs)
    bi := cs.تصویر لبه
    سرچاپ "    slice kinds"، bi.برش بالا.قسم درازا برابر سی اس اس.نوع‌درازا.Number، bi.برش بالا.درصد دارد، "fill"، bi.پرکردن میانه، "stops"، bi.منبع تصویر لبه.ایستگاه های رنگ.طول()
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
    sheet.آزادسازی برگه()
    p.آزادسازی برنامه()
پایان

تابع ریشه:
    text_path("color: red")
    text_path("border-image: linear-gradient(red, blue) 1")
    text_path("border-image: url(frame.png) 30 fill / 10px / 4px round space")
    text_path("border-image: repeat linear-gradient(45deg, #000, #fc0) 25% 10 / auto 2 3em")
    text_path("border-image: radial-gradient(#fff, #000) 10 / / 2")
    text_path("border-image-source: none; border-image-slice: fill 1 2; border-image-width: 1px 2 30% auto; border-image-outset: 1 2px; border-image-repeat: round")
    text_path("border-image: linear-gradient(red, blue) 1; border: 2px solid green")
    text_path("border-image-slice: -1")
    text_path("border-image-slice: 1 fill 2")
    text_path("border-image-width: -2px")
    text_path("border-image-outset: 10%")
    text_path("border-image-repeat: repeat-x")
    text_path("border-image: 1 / 2 / 3 / 4")
    typed_path("border-image: linear-gradient(to right, #0a0, oklch(70% 0.1 200)) 30 fill / 12px / 4px repeat")
    typed_path("border-image-slice: 20%; border-image-width: 3; border-image-outset: calc(2px + 1px)")
پایان
