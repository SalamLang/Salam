// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس

تابع add(els &: وکتور<سی اس اس.عنصر>، kind: رشته، parent: صحیح، base: رشته): صحیح:
    ناپایا e := سی اس اس.عنصر تازه(kind، parent)
    e.اعلان های پایه = base
    els.بیفزا(e)
    برگشت els.طول() - 1
پایان

تابع free_all(els &: وکتور<سی اس اس.عنصر>):
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان

تابع box(label: رشته، cs: سی اس اس.سبک‌محاسبه‌شده):
    سرچاپ label، "display"، cs.نمایش، "margin"، سی اس اس.متن درازا(cs.حاشیه بالا)، سی اس اس.متن درازا(cs.حاشیه راست)، سی اس اس.متن درازا(cs.حاشیه پایین)، سی اس اس.متن درازا(cs.حاشیه چپ)، "padding"، سی اس اس.متن درازا(cs.فاصله داخلی بالا)، سی اس اس.متن درازا(cs.فاصله داخلی چپ)
پایان

تابع text(label: رشته، cs: سی اس اس.سبک‌محاسبه‌شده):
    سرچاپ label، "font"، cs.سایز قلم، cs.وزن قلم، cs.حالت قلم، cs.خانواده قلم، "color"، سی اس اس.متن رنگ(cs.رنگ متن)، "line"، cs.ارتفاع خط
پایان

تابع ریشه:
    ناپایا sheet := سی اس اس.برگه تازه()
    دیرکن sheet.آزادسازی برگه()
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    body := add(els، "page"، -1، "")
    h1 := add(els، "h1"، body، "")
    sec := add(els، "section"، body، "")
    h1s := add(els، "h1"، sec، "")
    p := add(els، "paragraph"، body، "")
    b := add(els، "bold"، p، "")
    code := add(els، "code"، p، "")
    ul := add(els، "list"، body، "")
    li := add(els، "item"، ul، "")
    ul2 := add(els، "list"، li، "")
    link := add(els، "link"، body، "")
    ناپایا le := els.ارجاع(link)
    le.افزودن ویژگی("href"، "/x")
    btn := add(els، "button"، body، "")
    inp := add(els، "input"، body، "")
    hr := add(els، "line"، body، "")
    small := add(els، "small"، p، "")
    sub := add(els، "subscript"، p، "")
    table := add(els، "table"، body، "")
    td := add(els، "cell"، table، "")
    mark := add(els، "mark"، p، "")
    pre := add(els، "preformatted"، body، "")
    bq := add(els، "block quote"، body، "")
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط {})
    box("body"، sheet.سبک عنصر(body))
    box("h1"، sheet.سبک عنصر(h1))
    text("h1"، sheet.سبک عنصر(h1))
    text("section h1"، sheet.سبک عنصر(h1s))
    box("section h1"، sheet.سبک عنصر(h1s))
    box("p"، sheet.سبک عنصر(p))
    text("b"، sheet.سبک عنصر(b))
    text("code"، sheet.سبک عنصر(code))
    box("ul"، sheet.سبک عنصر(ul))
    box("nested ul"، sheet.سبک عنصر(ul2))
    سرچاپ "list types"، sheet.سبک عنصر(ul).نوع نشانه فهرست، sheet.سبک عنصر(ul2).نوع نشانه فهرست، "li"، sheet.سبک عنصر(li).نمایش
    a := sheet.سبک عنصر(link)
    سرچاپ "link"، سی اس اس.متن رنگ(a.رنگ متن)، a.زیرخط، a.نشانگر
    bt := sheet.سبک عنصر(btn)
    سرچاپ "button"، bt.نمایش، bt.سایز قلم، bt.خانواده قلم، سی اس اس.متن درازا(bt.فاصله داخلی چپ)، bt.مرز بالا.پهنای ضلع، bt.مرز بالا.سبک ضلع، سی اس اس.متن رنگ(bt.مرز بالا.رنگ ضلع)، سی اس اس.متن رنگ(bt.رنگ پس زمینه)، bt.ترازبندی متن، bt.ظاهر
    it := sheet.سبک عنصر(inp)
    سرچاپ "input"، سی اس اس.متن درازا(it.فاصله داخلی بالا)، سی اس اس.متن درازا(it.فاصله داخلی چپ)، it.مرز چپ.پهنای ضلع، it.مرز چپ.سبک ضلع، سی اس اس.متن رنگ(it.رنگ پس زمینه)، it.نشانگر
    h := sheet.سبک عنصر(hr)
    سرچاپ "hr"، سی اس اس.متن درازا(h.حاشیه بالا)، سی اس اس.متن درازا(h.حاشیه چپ)، h.مرز بالا.پهنای ضلع، h.مرز بالا.سبک ضلع، سی اس اس.متن رنگ(h.مرز بالا.رنگ ضلع)، h.سرریز افقی
    سرچاپ "small"، sheet.سبک عنصر(small).سایز قلم، "sub"، sheet.سبک عنصر(sub).سایز قلم، sheet.سبک عنصر(sub).ترازبندی عمودی
    t := sheet.سبک عنصر(table)
    سرچاپ "table"، t.نمایش، t.فاصله مرزها افقی، t.سنجش جعبه، "td"، sheet.سبک عنصر(td).نمایش، سی اس اس.متن درازا(sheet.سبک عنصر(td).فاصله داخلی بالا)
    سرچاپ "mark"، سی اس اس.متن رنگ(sheet.سبک عنصر(mark).رنگ پس زمینه)، "pre"، sheet.سبک عنصر(pre).فضای سفید متن، sheet.سبک عنصر(pre).سایز قلم
    box("blockquote"، sheet.سبک عنصر(bq))
    free_all(els)

    ناپایا s2 := سی اس اس.برگه تازه()
    دیرکن s2.آزادسازی برگه()
    _r1 := s2.افزودن قاعده("p"، "color: green; margin: 2px")
    _r2 := s2.افزودن قاعده(".note"، "color: blue")
    _r3 := s2.افزودن قاعده("#first"، "color: purple")
    _r4 := s2.افزودن قاعده("p"، "color: orange !important")
    _r5 := s2.افزودن قاعده("div p"، "font-size: 30px")
    _r6 := s2.افزودن قاعده(".warn"، "border: 1px solid; padding: inherit; margin: initial; color: unset")
    _r7 := s2.افزودن قاعده رسانه("(max-width: 600px)"، ".resp"، "width: 100px")
    _r8 := s2.افزودن قاعده رسانه("(prefers-color-scheme: dark)"، ".resp"، "background-color: black")
    _r9 := s2.افزودن سی اس اس("@media (orientation: portrait) { .resp { height: 50px } } .x:hover .y { color: red }")
    ناپایا e2 := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    root := add(e2، "page"، -1، "color: #123456; font-size: 18px; line-height: 1.5; padding: 7px")
    div := add(e2، "box"، root، "letter-spacing: 1px")
    ناپایا de := e2.ارجاع(div)
    de.کلاس های عنصر = "x"
    p1 := add(e2، "paragraph"، div، "")
    ناپایا pe := e2.ارجاع(p1)
    pe.شناسه عنصر = "first"
    pe.کلاس های عنصر = "note"
    w := add(e2، "box"، root، "padding: 3px")
    ناپایا we := e2.ارجاع(w)
    we.کلاس های عنصر = "warn"
    resp := add(e2، "box"، root، "width: 300px; color: maroon")
    ناپایا re := e2.ارجاع(resp)
    re.کلاس های عنصر = "resp"
    re.اعلان های اشاره = "color: navy"
    re.اعلان های تمرکز = "outline: 2px solid red"
    re.افزودن رسانه("(min-width: 900px)"، "width: 500px")
    y := add(e2، "span"، div، "")
    ناپایا ye := e2.ارجاع(y)
    ye.کلاس های عنصر = "y"
    rtl := add(e2، "box"، root، "direction: rtl; margin-inline-start: 10px; padding-inline-end: 4px; border-start-start-radius: 6px; text-align: end")
    child := add(e2، "box"، rtl، "")
    flex := add(e2، "box"، root، "display: flex")
    item := add(e2، "span"، flex، "")
    abs := add(e2، "span"، root، "position: absolute; float: left")
    lone := add(e2، "box"، root، "border-width: 5px; outline-width: 3px")
    _n2 := s2.محاسبه سبک ها(e2، سی اس اس.محیط { پهنای پنجره = 1000.0، بلندی پنجره = 800.0 })
    pp := s2.سبک عنصر(p1)
    سرچاپ "important wins"، سی اس اس.متن رنگ(pp.رنگ متن)، "descendant"، pp.سایز قلم، "inherited spacing"، pp.فاصله حروف، "line"، pp.ارتفاع خط
    ws := s2.سبک عنصر(w)
    سرچاپ "keywords"، سی اس اس.متن درازا(ws.فاصله داخلی بالا)، سی اس اس.متن درازا(ws.حاشیه بالا)، سی اس اس.متن رنگ(ws.رنگ متن)، ws.مرز بالا.پهنای ضلع، سی اس اس.متن رنگ(ws.مرز بالا.رنگ ضلع)
    rs := s2.سبک عنصر(resp)
    سرچاپ "media"، سی اس اس.متن درازا(rs.پهنا)، سی اس اس.متن درازا(rs.بلندی)، سی اس اس.متن رنگ(rs.رنگ پس زمینه)، سی اس اس.متن رنگ(rs.رنگ متن)
    سرچاپ "rtl"، s2.سبک عنصر(rtl).جهت نوشتار، سی اس اس.متن درازا(s2.سبک عنصر(rtl).حاشیه راست)، سی اس اس.متن درازا(s2.سبک عنصر(rtl).حاشیه چپ)، سی اس اس.متن درازا(s2.سبک عنصر(rtl).فاصله داخلی چپ)، سی اس اس.متن درازا(s2.سبک عنصر(rtl).گردی بالا راست.شعاع افقی)، s2.سبک عنصر(rtl).ترازبندی متن، "child inherits"، s2.سبک عنصر(child).جهت نوشتار، s2.سبک عنصر(child).ترازبندی متن
    سرچاپ "blockify"، s2.سبک عنصر(item).نمایش، s2.سبک عنصر(abs).نمایش، s2.سبک عنصر(abs).شناور
    سرچاپ "no style no width"، s2.سبک عنصر(lone).مرز بالا.پهنای ضلع، s2.سبک عنصر(lone).خط دور.پهنای ضلع
    ناپایا re2 := e2.ارجاع(resp)
    re2.زیر اشاره = درست
    سرچاپ "restyled"، s2.سبک دهی دوباره(e2، resp)، سی اس اس.متن رنگ(s2.سبک عنصر(resp).رنگ متن)
    ناپایا re3 := e2.ارجاع(resp)
    re3.دارای تمرکز = درست
    سرچاپ "restyled"، s2.سبک دهی دوباره(e2، resp)، s2.سبک عنصر(resp).خط دور.پهنای ضلع، s2.سبک عنصر(resp).خط دور.سبک ضلع
    سرچاپ "before hover y"، سی اس اس.متن رنگ(s2.سبک عنصر(y).رنگ متن)
    top := سی اس اس.زنجیره اشاره(e2، y)
    سرچاپ "chain top"، top، "restyled"، s2.سبک دهی دوباره(e2، top)، "y"، سی اس اس.متن رنگ(s2.سبک عنصر(y).رنگ متن)، "resp"، سی اس اس.متن رنگ(s2.سبک عنصر(resp).رنگ متن)
    _n3 := s2.محاسبه سبک ها(e2، سی اس اس.محیط { پهنای پنجره = 500.0، بلندی پنجره = 800.0، حالت تیره = درست })
    rs2 := s2.سبک عنصر(resp)
    سرچاپ "narrow dark"، سی اس اس.متن درازا(rs2.پهنا)، سی اس اس.متن درازا(rs2.بلندی)، سی اس اس.متن رنگ(rs2.رنگ پس زمینه)
    free_all(e2)

    ناپایا s3 := سی اس اس.برگه خالی()
    دیرکن s3.آزادسازی برگه()
    _c := s3.افزودن سی اس اس(":root { --brand: #0ea5e9; --space: 8px } .card { --space: 12px; padding: var(--space); color: var(--brand) } html { color-scheme: light dark }")
    ناپایا e3 := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    r3 := add(e3، "page"، -1، "background-color: canvas; color: canvastext")
    card := add(e3، "box"، r3، "")
    ناپایا ce := e3.ارجاع(card)
    ce.کلاس های عنصر = "card"
    inner := add(e3، "box"، card، "margin: var(--space)")
    _n4 := s3.محاسبه سبک ها(e3، سی اس اس.محیط {})
    سرچاپ "vars"، سی اس اس.متن درازا(s3.سبک عنصر(card).فاصله داخلی بالا)، سی اس اس.متن رنگ(s3.سبک عنصر(card).رنگ متن)، سی اس اس.متن درازا(s3.سبک عنصر(inner).حاشیه بالا)، "var text"، s3.متغیر سفارشی(inner، "--space")
    سرچاپ "light"، سی اس اس.متن رنگ(s3.سبک عنصر(r3).رنگ پس زمینه)، سی اس اس.متن رنگ(s3.سبک عنصر(r3).رنگ متن)
    _n5 := s3.محاسبه سبک ها(e3، سی اس اس.محیط { حالت تیره = درست })
    سرچاپ "dark"، سی اس اس.متن رنگ(s3.سبک عنصر(r3).رنگ پس زمینه)، سی اس اس.متن رنگ(s3.سبک عنصر(r3).رنگ متن)، s3.سبک عنصر(r3).تیره به کار رفته
    root_style := s3.سبک ریشه()
    سرچاپ "root"، root_style.نمایش، root_style.طرح رنگ عنصر
    free_all(e3)
پایان
