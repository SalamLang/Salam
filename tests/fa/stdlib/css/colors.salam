// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس
واردسازی حافظه

تابع hex_of(text: رشته): رشته:
    ناپایا p := سی اس اس.برنامه سبک تازه()
    _id := سی اس اس.ترجمه اعلان ها(p، "color: " + text)
    src := سی اس اس.متن برنامه سبک(p، "s"، "css")
    k := src.بیاب("ColorValue(")
    ناپایا r := "unresolved"
    اگر k بزرگتربرابر 0:
        rest := src.زیررشته(k + 11، src.طول() - k - 11)
        r = rest.زیررشته(0، rest.بیاب(")"))
        حافظه.آزادسازی(rest برگردان تهی*)
    پایان
    حافظه.آزادسازی(src برگردان تهی*)
    p.آزادسازی برنامه()
    برگشت r
پایان

تابع ریشه:
    forms := [
        `#3366aa`،
        `#3366aa80`،
        `#abc`،
        `rebeccapurple`،
        `transparent`،
        `rgb(255 128 0)`،
        `rgb(255 128 0 / 50%)`،
        `rgba(10, 20, 30, 0.4)`،
        `rgb(100%, 50%, 0%)`،
        `rgb(300 -20 128.6)`،
        `rgb(none 128 255)`،
        `hsl(210 50% 40%)`،
        `hsl(210deg 50% 40% / 0.5)`،
        `hsla(120, 100%, 25%, 0.75)`،
        `hsl(0.5turn 60 70)`،
        `hsl(-30 80% 60%)`،
        `hsl(200 0% 50%)`،
        `hsl(30 150% 50%)`،
        `hwb(210 20% 30%)`،
        `hwb(90 60% 60%)`،
        `hwb(320deg 10% 5% / 80%)`،
        `lab(50 20 -30)`،
        `lab(75% 40% -20%)`،
        `lab(90 -60 80)`،
        `lab(0 0 0)`،
        `lab(100 0 0)`،
        `lch(60 40 120)`،
        `lch(50% 50% 270deg)`،
        `lch(70 100 30)`،
        `oklab(0.6 0.1 -0.1)`،
        `oklab(70% 20% -30%)`،
        `oklab(0.9 -0.15 0.15)`،
        `oklch(0.7 0.1 30)`،
        `oklch(60% 0.15 250)`،
        `oklch(0.8 0.3 140)`،
        `oklch(0.5 0.4 30)`،
        `oklch(1 0 0)`،
        `color(srgb 0.2 0.4 0.6)`،
        `color(srgb 50% 25% 75% / 0.5)`،
        `color(srgb-linear 0.2 0.4 0.6)`،
        `color(display-p3 0.3 0.6 0.4)`،
        `color(display-p3 1 0 0)`،
        `color(a98-rgb 0.5 0.3 0.8)`،
        `color(prophoto-rgb 0.4 0.4 0.5)`،
        `color(rec2020 0.3 0.5 0.4)`،
        `color(xyz 0.2 0.3 0.4)`،
        `color(xyz-d50 0.2 0.3 0.4)`،
        `color(xyz-d65 0.4 0.3 0.2)`،
        `color-mix(in srgb, red, blue)`،
        `color-mix(in srgb, red 30%, blue)`،
        `color-mix(in srgb-linear, red, blue)`،
        `color-mix(in oklab, red, blue)`،
        `color-mix(in oklch, red, blue)`،
        `color-mix(in oklch longer hue, red, blue)`،
        `color-mix(in oklch increasing hue, red 40%, blue)`،
        `color-mix(in oklch decreasing hue, red, blue)`،
        `color-mix(in lab, #3366aa, white 25%)`،
        `color-mix(in lch, gold, teal)`،
        `color-mix(in hsl, red, lime)`،
        `color-mix(in hwb, red 20%, blue 40%)`،
        `color-mix(in srgb, red 20%, blue 20%)`،
        `color-mix(in srgb, rgb(255 0 0 / 0.2), blue)`،
        `color-mix(in oklab, transparent, red)`،
        `color-mix(in xyz, purple, orange)`،
        `color-mix(in display-p3, red, green)`،
        `color-mix(in srgb, color-mix(in oklch, red, yellow), blue 70%)`،
        `rgb(from #3366aa r g b / 50%)`،
        `rgb(from red b g r)`،
        `hsl(from teal h s 80)`،
        `oklch(from #ff8800 l c 200)`،
        `lab(from navy 60 a b)`،
        `color(from red srgb r g 0.5)`،
        `light-dark(#111, #eee)`
    ]
    تکرار طول(forms) در i:
        ناپایا c := سی اس اس.رنگ‌سی‌اس‌اس {}
        ok := سی اس اس.تجزیه رنگ(forms[i]، c)
        سرچاپ forms[i]، ok، c.قرمز، c.سبز، c.آبی، c.آلفا، hex_of(forms[i])
    پایان
    سرچاپ "scheme pair"، hex_of("light-dark(CanvasText, Canvas)")، hex_of("ButtonFace")، hex_of("Highlight")
    سرچاپ "current color stays"، hex_of("currentColor")، hex_of("color-mix(in srgb, currentColor, red)")
    سرچاپ "mix"، سی اس اس.متن رنگ(سی اس اس.آمیختن رنگ ها(سی اس اس.رنگ‌سی‌اس‌اس { قرمز = 255، آلفا = 0 }، سی اس اس.رنگ‌سی‌اس‌اس { آبی = 255 }، 0.5))
پایان
