// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس
واردسازی رشته

پایا PAGE_CSS := `
body { font-family: Vazirmatn, sans-serif; background: #f8fafc; color: #0f172a;  }
* { box-sizing: border-box;  }
.card p:first-child, nav > a:hover { color: #334155; margin: 0px 0px 8px;  }
li:nth-child(2n) { background: #f1f5f9;  }
button:focus-visible { outline: 3px solid var(--brand, #2563eb); outline-offset: 2px;  }
.e { background: linear-gradient(90deg, #0ea5e9, #6366f1); color: white; padding: 16px 24px;  }
.f { font-size: 2rem; letter-spacing: -0.02em;  }
.g { padding: 4px 8px; border-radius: 999px;  }
.card { display: flex; flex-wrap: wrap; gap: 12px 1em; padding: var(--space, 12px); border: 1px solid #e2e8f0; border-radius: 12px / 8px; box-shadow: 0 1px 2px rgba(0, 0, 0, .1), inset 0 0 0 1px #fff;  }
@media (max-width: 600px) { .card { display: block; padding: 8px;  } }
.i { line-height: 1.5; text-transform: uppercase;  }
.j { background: hsl(210 80% 50%); color: white; border: none; padding: 6px 12px; transition: background 200ms ease-in-out, transform 0.1s; cursor: pointer; transform: translateY(-1px) scale(1.02);  }
.j:hover { background: #1d4ed8;  }
.k { width: calc(100% - 2em); font-size: 14px;  }
.l { direction: rtl; text-align: start; margin-inline-start: 20px; padding-inline-end: 6px; border-inline-start: 4px solid var(--brand, #2563eb);  }
.m { font-weight: bold;  }
.n { padding: 4px;  }
.o { text-align: right;  }
.p { font: italic 600 14px/20px Georgia, serif; opacity: 0.8; text-decoration: underline dotted;  }
`

پایا PROPS := "display margin-top margin-right margin-bottom margin-left padding-top padding-right padding-bottom padding-left border-top-width border-top-style border-top-color border-left-width border-left-color border-top-left-radius color background-color background-image font-size font-weight font-style font-family line-height letter-spacing text-align text-transform text-decoration-line direction box-shadow transform transition-property transition-duration row-gap column-gap flex-wrap opacity cursor list-style-type white-space box-sizing vertical-align width"

ساختار Node:
    همگانی kind: رشته = ""
    همگانی tag: رشته = ""
    همگانی parent: صحیح = -1
    همگانی classes: رشته = ""
    همگانی id: رشته = ""
    همگانی base: رشته = ""
    همگانی hover: رشته = ""
پایان

تابع node(nodes &: وکتور<Node>، kind: رشته، tag: رشته، parent: صحیح، classes: رشته، base: رشته): صحیح:
    nodes.بیفزا(Node { kind = kind، tag = tag، parent = parent، classes = classes، base = base })
    برگشت nodes.طول() - 1
پایان

تابع page(nodes &: وکتور<Node>):
    body := node(nodes، "page"، "body"، -1، ""، "font-family: Vazirmatn, sans-serif; background: #f8fafc; color: #0f172a")
    header := node(nodes، "header"، "header"، body، "e"، "background: linear-gradient(90deg, #0ea5e9, #6366f1); color: white; padding: 16px 24px")
    _h := node(nodes، "heading"، "h1"، header، "f"، "font-size: 2rem; letter-spacing: -0.02em")
    nav := node(nodes، "nav"، "nav"، header، ""، "")
    _a1 := node(nodes، "link"، "a"، nav، ""، "")
    _a2 := node(nodes، "link"، "a"، nav، "g"، "padding: 4px 8px; border-radius: 999px")
    card := node(nodes، "box"، "div"، body، "card"، "display: flex; flex-wrap: wrap; gap: 12px 1em; padding: var(--space, 12px); border: 1px solid #e2e8f0; border-radius: 12px / 8px; box-shadow: 0 1px 2px rgba(0, 0, 0, .1), inset 0 0 0 1px #fff")
    _p := node(nodes، "paragraph"، "p"، card، "i"، "line-height: 1.5; text-transform: uppercase")
    btn := node(nodes، "button"، "button"، card، "j"، "background: hsl(210 80% 50%); color: white; border: none; padding: 6px 12px; transition: background 200ms ease-in-out, transform 0.1s; cursor: pointer; transform: translateY(-1px) scale(1.02)")
    ناپایا bn := nodes.ارجاع(btn)
    bn.hover = "background: #1d4ed8"
    _in := node(nodes، "input"، "input"، card، "k"، "width: calc(100% - 2em); font-size: 14px")
    ul := node(nodes، "list"، "ul"، card، ""، "")
    تکرار 3:
        _li := node(nodes، "item"، "li"، ul، ""، "")
    پایان
    rtl := node(nodes، "box"، "div"، card، "l"، "direction: rtl; text-align: start; margin-inline-start: 20px; padding-inline-end: 6px; border-inline-start: 4px solid var(--brand, #2563eb)")
    _sp := node(nodes، "span"، "span"، rtl، "m"، "font-weight: bold")
    _pre := node(nodes، "preformatted"، "pre"، card، ""، "")
    table := node(nodes، "table"، "table"، card، ""، "")
    tbody := node(nodes، "table body"، "tbody"، table، ""، "")
    tr := node(nodes، "row"، "tr"، tbody، ""، "")
    _td1 := node(nodes، "cell"، "td"، tr، "n"، "padding: 4px")
    _td2 := node(nodes، "cell"، "td"، tr، "o"، "text-align: right")
    footer := node(nodes، "footer"، "footer"، body، "p"، "font: italic 600 14px/20px Georgia, serif; opacity: 0.8; text-decoration: underline dotted")
    _fp := node(nodes، "paragraph"، "p"، footer، ""، "")
پایان

تابع elements(nodes: وکتور<Node>، with_decls: منطقی): وکتور<سی اس اس.عنصر>:
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    تکرار nodes.طول() در i:
        n := nodes[i]
        ناپایا e := سی اس اس.عنصر تازه(n.kind، n.parent)
        e.برچسب عنصر = n.tag
        e.کلاس های عنصر = n.classes
        اگر n.classes برابر "card":
            e.شناسه عنصر = "main"
            اگر with_decls:
                e.افزودن رسانه("(max-width: 600px)"، "display: block; padding: 8px")
            پایان
        پایان
        اگر n.tag برابر "a":
            e.افزودن ویژگی("href"، "/a")
        پایان
        اگر n.tag برابر "input":
            e.افزودن ویژگی("type"، "text")
            e.افزودن ویژگی("placeholder"، "Name")
        پایان
        اگر with_decls:
            اگر n.tag نابرابر "body":
                e.کلاس های عنصر = n.classes برابر "card" ? "card" : ""
            پایان
            e.اعلان های پایه = n.base
            e.اعلان های اشاره = n.hover
        پایان
        els.بیفزا(e)
    پایان
    برگشت els
پایان

تابع free_els(els &: وکتور<سی اس اس.عنصر>):
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان

تابع dump(sheet &: سی اس اس.برگه‌سبک، els: وکتور<سی اس اس.عنصر>، props: وکتور<رشته>):
    تکرار els.طول() در i:
        cs := sheet.سبک عنصر(i)
        e := els[i]
        سرچاپ "#" + i، e.برچسب عنصر + (e.کلاس های عنصر.طول() بزرگتر 0 ? "." + e.کلاس های عنصر : "")
        تکرار props.طول() در k:
            v := سی اس اس.متن مقدار(cs، props[k])
            سرچاپ "  " + props[k] + "=" + v
        پایان
    پایان
پایان

تابع mismatches(a &: سی اس اس.برگه‌سبک، b &: سی اس اس.برگه‌سبک، n: صحیح، props: وکتور<رشته>): صحیح:
    ناپایا bad := 0
    تکرار n در i:
        ca := a.سبک عنصر(i)
        cb := b.سبک عنصر(i)
        تکرار props.طول() در k:
            va := سی اس اس.متن مقدار(ca، props[k])
            vb := سی اس اس.متن مقدار(cb، props[k])
            اگر va نابرابر vb:
                سرچاپ "mismatch"، i، props[k]، va، vb
                bad++
            پایان
        پایان
    پایان
    برگشت bad
پایان

تابع ریشه:
    ناپایا props := رشته.واژه ها(PROPS)
    دیرکن props.آزادکن()
    ناپایا nodes := وکتور {} برگردان وکتور<Node>
    دیرکن nodes.آزادکن()
    page(nodes)
    ناپایا a := سی اس اس.برگه تازه()
    دیرکن a.آزادسازی برگه()
    سرچاپ "rules"، a.افزودن سی اس اس(PAGE_CSS)
    ناپایا ea := elements(nodes، نادرست)
    _na := a.محاسبه سبک ها(ea، سی اس اس.محیط { پهنای پنجره = 800.0، بلندی پنجره = 600.0 })
    سرچاپ "== style sheet mode, 800 wide"
    dump(a، ea، props)
    ناپایا b := سی اس اس.برگه تازه()
    دیرکن b.آزادسازی برگه()
    _g1 := b.افزودن قاعده("*"، "box-sizing: border-box")
    _g2 := b.افزودن قاعده(".card p:first-child, nav > a:hover"، "color: #334155; margin: 0px 0px 8px")
    _g3 := b.افزودن قاعده("li:nth-child(2n)"، "background: #f1f5f9")
    _g4 := b.افزودن قاعده("button:focus-visible"، "outline: 3px solid var(--brand, #2563eb); outline-offset: 2px")
    ناپایا eb := elements(nodes، درست)
    _nb := b.محاسبه سبک ها(eb، سی اس اس.محیط { پهنای پنجره = 800.0، بلندی پنجره = 600.0 })
    سرچاپ "== declaration mode agrees:"، mismatches(a، b، ea.طول()، props) برابر 0
    _na2 := a.محاسبه سبک ها(ea، سی اس اس.محیط { پهنای پنجره = 500.0، بلندی پنجره = 600.0 })
    _nb2 := b.محاسبه سبک ها(eb، سی اس اس.محیط { پهنای پنجره = 500.0، بلندی پنجره = 600.0 })
    سرچاپ "== 500 wide, modes agree:"، mismatches(a، b، ea.طول()، props) برابر 0
    card := a.سبک عنصر(6)
    سرچاپ "card"، سی اس اس.متن مقدار(card، "display")، سی اس اس.متن مقدار(card، "padding-top")، "p"، سی اس اس.متن مقدار(a.سبک عنصر(7)، "display")
    ناپایا hb := eb.ارجاع(8)
    hb.زیر اشاره = درست
    ناپایا ha := ea.ارجاع(8)
    ha.زیر اشاره = درست
    سرچاپ "hover restyle"، a.سبک دهی دوباره(ea، 8)، b.سبک دهی دوباره(eb، 8)، سی اس اس.متن مقدار(a.سبک عنصر(8)، "background-color")، سی اس اس.متن مقدار(b.سبک عنصر(8)، "background-color")
    ناپایا fa := ea.ارجاع(8)
    fa.تمرکز نمایان = درست
    _r := a.سبک دهی دوباره(ea، 8)
    سرچاپ "focus ring"، سی اس اس.متن مقدار(a.سبک عنصر(8)، "outline-style")، سی اس اس.متن مقدار(a.سبک عنصر(8)، "outline-width")، سی اس اس.متن مقدار(a.سبک عنصر(8)، "outline-color")، سی اس اس.متن مقدار(a.سبک عنصر(8)، "outline-offset")
    سرچاپ "distinct styles"، a.شمار سبک های یکتا()، "for"، ea.طول()، "elements"
    free_els(ea)
    free_els(eb)
پایان
