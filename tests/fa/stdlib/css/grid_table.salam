واردسازی رابط گرافیکی.سی اس اس
واردسازی رابط گرافیکی.جعبه سی اس اس
واردسازی حافظه

تابع one(sheet &: سی اس اس.برگه‌سبک، decls: رشته): سی اس اس.سبک‌محاسبه‌شده:
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا root := سی اس اس.عنصر تازه("page"، -1)
    root.اعلان های پایه = "font-size: 20px"
    els.بیفزا(root)
    ناپایا e := سی اس اس.عنصر تازه("box"، 0)
    e.اعلان های پایه = decls
    els.بیفزا(e)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 800.0، بلندی پنجره = 600.0 })
    cs := sheet.سبک عنصر(1)
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
    برگشت cs
پایان

تابع show(sheet &: سی اس اس.برگه‌سبک، decls: رشته، props: رشته):
    cs := one(sheet، decls)
    سرچاپ decls
    names := props.بشکاف(" ")
    هر p در names:
        v := سی اس اس.متن مقدار(cs، p)
        سرچاپ "  " + p + ": " + v
        حافظه.آزادسازی(v برگردان تهی*)
    پایان
    names.آزادکن()
پایان

تابع ریشه:
    ناپایا sheet := سی اس اس.برگه تازه()
    دیرکن sheet.آزادسازی برگه()
    show(sheet، "display: grid; grid-template-columns: 100px 1fr 2em"، "display grid-template-columns grid-template-rows")
    show(sheet، "grid-template-columns: repeat(auto-fill, minmax(5em, 1fr)) [end]"، "grid-template-columns")
    show(sheet، "grid-template-columns: [a b] fit-content(40%) min-content max-content auto"، "grid-template-columns")
    show(sheet، "grid-template-columns: 10px 1fr; grid-template-columns: 1fr minmax(1fr, 10px)"، "grid-template-columns")
    show(sheet، "grid-template-rows: none"، "grid-template-rows")
    show(sheet، "grid-template-areas: 'head head' 'side main'"، "grid-template-areas")
    show(sheet، "grid-template-areas: 'a b' 'b b'"، "grid-template-areas")
    show(sheet، "grid-auto-columns: 50px; grid-auto-rows: minmax(1em, auto) 2fr"، "grid-auto-columns grid-auto-rows")
    show(sheet، "grid-auto-flow: column dense"، "grid-auto-flow")
    show(sheet، "grid-auto-flow: dense"، "grid-auto-flow")
    show(sheet، "grid-row: 2 / span 3; grid-column: main"، "grid-row-start grid-row-end grid-column-start grid-column-end")
    show(sheet، "grid-area: head"، "grid-row-start grid-column-start grid-row-end grid-column-end")
    show(sheet، "grid-area: 1 / 2 / -1"، "grid-row-start grid-column-start grid-row-end grid-column-end")
    show(sheet، "grid-column-start: span foo 2; grid-row-end: -1"، "grid-column-start grid-row-end")
    show(sheet، "grid-template: 'a a' 40px 'b c' 1fr / 100px auto"، "grid-template-areas grid-template-rows grid-template-columns")
    show(sheet، "grid-template: 50px 1fr / repeat(3, 1fr)"، "grid-template-rows grid-template-columns grid-template-areas")
    show(sheet، "grid: auto-flow dense 30px / 1fr 1fr"، "grid-template-rows grid-template-columns grid-auto-flow grid-auto-rows grid-auto-columns")
    show(sheet، "grid: 100px / auto-flow 2em"، "grid-template-rows grid-template-columns grid-auto-flow grid-auto-columns")
    show(sheet، "place-self: center end"، "align-self justify-self")
    show(sheet، "justify-items: start"، "justify-items")
    show(sheet، "display: table; border-collapse: collapse; border-spacing: 2px 4px; table-layout: fixed; caption-side: bottom"، "display border-collapse border-spacing table-layout caption-side")
    show(sheet، "display: table-cell; vertical-align: middle"، "display vertical-align")
    cs := one(sheet، "display: inline-grid; grid-template-columns: 1fr 2em; grid-row: 2; justify-self: end; justify-items: center")
    st := سی اس اس.به جعبه(cs)
    سرچاپ "box"، st.نمایش برابر جعبه سی اس اس.نوع‌نمایش.شبکه درون خطی، st.الگوی ستون های شبکه، st.آغاز سطر شبکه، st.چینش خود برابر جعبه سی اس اس.نوع‌تراز.تراز انتها، st.چینش آیتم ها برابر جعبه سی اس اس.نوع‌تراز.تراز میانه
    ct := one(sheet، "display: table; border-collapse: collapse; border-spacing: 3px 5px; table-layout: fixed; caption-side: bottom")
    tb := سی اس اس.به جعبه(ct)
    سرچاپ "table"، tb.نمایش برابر جعبه سی اس اس.نوع‌نمایش.جدول، tb.ادغام مرز برابر جعبه سی اس اس.نوع‌ادغام‌مرز.مرز ادغام شده، tb.فاصله مرز افقی، tb.فاصله مرز عمودی، tb.چینش جدول برابر جعبه سی اس اس.نوع‌چینش‌جدول.چینش ثابت جدول، tb.سوی عنوان برابر جعبه سی اس اس.نوع‌سوی‌عنوان.عنوان پایین
    cc := one(sheet، "display: table-cell; vertical-align: bottom")
    cb := سی اس اس.به جعبه(cc)
    سرچاپ "cell"، cb.نمایش برابر جعبه سی اس اس.نوع‌نمایش.خانه جدول، cb.تراز عمودی برابر جعبه سی اس اس.نوع‌تراز‌عمودی.تراز عمودی پایین
    سرچاپ "valid"، جعبه سی اس اس.فهرست ردیف معتبر است("1fr [x] 20px")، جعبه سی اس اس.فهرست ردیف معتبر است("1fr 1fr)")، جعبه سی اس اس.خط شبکه معتبر است("span 2")، جعبه سی اس اس.خط شبکه معتبر است("0")، جعبه سی اس اس.نواحی شبکه معتبر است("'a .' 'a b'")، جعبه سی اس اس.اندازه های ردیف معتبر است("10px auto")
پایان
