واردسازی رابط گرافیکی.سی اس اس
واردسازی ریاضی
واردسازی حافظه

تابع mix(a: رشته، b: رشته):
    ناپایا ca := سی اس اس.رنگ‌سی‌اس‌اس {}
    ناپایا cb := سی اس اس.رنگ‌سی‌اس‌اس {}
    _x := سی اس اس.تجزیه رنگ(a، ca)
    _y := سی اس اس.تجزیه رنگ(b، cb)
    سرچاپ a، "->"، b، "legacy"، ca.رنگ قدیمی، cb.رنگ قدیمی
    هر f در [0.25، 0.5، 0.75]:
        m := سی اس اس.آمیختن رنگ ها(ca، cb، f)
        t := سی اس اس.متن رنگ(m)
        سرچاپ "   "، f، t، m.رنگ قدیمی
        حافظه.آزادسازی(t برگردان تهی*)
    پایان
پایان

تابع stops(image: رشته، length: اعشار۶۴، every: صحیح):
    ناپایا sheet := سی اس اس.برگه تازه()
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا e := سی اس اس.عنصر تازه("box"، -1)
    e.اعلان های پایه = "background-image: " + image
    els.بیفزا(e)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 800.0، بلندی پنجره = 600.0 })
    cs := sheet.سبک عنصر(0)
    l := cs.لایه های پس زمینه[0]
    ناپایا v := سی اس اس.ایستگاه های شیب(l، length)
    سرچاپ image، "length"، length، "stops"، v.طول()، "space"، l.فضای درون یابی، "hue"، l.روش درون یابی فام، "explicit"، l.فضای درون یابی نوشته شده
    تکرار v.طول() در i:
        اگر i % every برابر 0 یا i برابر v.طول() - 1:
            t := سی اس اس.متن رنگ(v[i].رنگ ایستگاه)
            سرچاپ "   "، ریاضی.گردکردن(v[i].جای ایستگاه.پیکسل درازا * 100.0) / 100.0، t
            حافظه.آزادسازی(t برگردان تهی*)
        پایان
    پایان
    v.آزادکن()
    vt := سی اس اس.متن مقدار(cs، "background-image")
    سرچاپ "   "، vt
    حافظه.آزادسازی(vt برگردان تهی*)
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
    sheet.آزادسازی برگه()
پایان

تابع ریشه:
    mix("red"، "blue")
    mix("oklch(70% 0.15 30)"، "oklch(60% 0.12 250)")
    mix("red"، "oklab(0.5 0 -0.2)")
    mix("#ff000080"، "lab(50% 40 -30)")
    mix("rgb(255 0 0)"، "color(srgb 0 0 1)")
    mix("transparent"، "oklch(80% 0.1 140)")
    mix("hsl(120 100% 50%)"، "hwb(240 0% 0%)")
    stops("linear-gradient(90deg, red, 20%, blue)"، 300.0، 1)
    stops("linear-gradient(90deg, red, 80%, blue)"، 300.0، 1)
    stops("linear-gradient(90deg, #000 10%, 30%, #fff 90%)"، 300.0، 1)
    stops("linear-gradient(90deg, red, 50%, blue)"، 300.0، 1)
    stops("linear-gradient(90deg, red, 0%, blue)"، 300.0، 1)
    stops("linear-gradient(90deg, red calc(10% + 20px), blue calc(100% - 40px))"، 300.0، 1)
    stops("linear-gradient(90deg, red 50px, blue 40px, lime)"، 300.0، 1)
    stops("linear-gradient(90deg in oklab, red, blue)"، 300.0، 9)
    stops("linear-gradient(90deg, oklch(60% 0.2 30), oklch(70% 0.15 250))"، 300.0، 9)
    stops("linear-gradient(90deg in oklch longer hue, red, blue)"، 300.0، 9)
    stops("linear-gradient(90deg in oklab, red, 25%, blue calc(50% + 30px), lime)"، 300.0، 12)
    stops("conic-gradient(red, 90deg, blue)"، 360.0، 1)
پایان
