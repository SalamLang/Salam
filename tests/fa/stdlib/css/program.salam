واردسازی رابط گرافیکی.سی اس اس

پایا RULE_CSS := `@media (prefers-color-scheme: dark) { body { background: #111; color: #eee } } ul li:first-child + li { margin-left: 1em } li::marker { color: red }`

تابع compile(p &: سی اس اس.برنامه‌سبک): صحیح:
    _r1 := سی اس اس.ترجمه قاعده(p، "*"، "box-sizing:border-box"، "")
    _r2 := سی اس اس.ترجمه قاعده(p، ".card"، "padding:12px; border:2px solid #3366aa; border-radius:10px; box-shadow:0 4px 8px rgba(0,0,0,.25); background:#fff"، "")
    _r3 := سی اس اس.ترجمه قاعده(p، ".card:hover"، "background:#ffeecc"، "")
    _r4 := سی اس اس.ترجمه قاعده(p، "h3, .title > b"، "margin:0 0 4px; font: italic bold 15px/1.4 Georgia, serif; color: hsl(210 50% 40%)"، "")
    _r5 := سی اس اس.ترجمه قاعده(p، ".wide"، "width: calc(100% - 2em); --gap: 8px; gap: var(--gap)"، "(max-width: 600px)")
    _r6 := سی اس اس.ترجمه قاعده(p، "a:not(.x)"، "text-decoration: underline dotted; transition: color .2s ease-in-out"، "")
    _r7 := سی اس اس.ترجمه قاعده(p، "p"، "color: red !important; transform: rotate(45deg) translate(2px, 3px)"، "")
    _r8 := سی اس اس.ترجمه قاعده(p، ".pic"، "background-image: url(a.png); font-family: \"My Font\", serif"، "")
    _n := سی اس اس.ترجمه سی اس اس(p، RULE_CSS)
    برگشت سی اس اس.ترجمه اعلان ها(p، "display:flex;gap:12px;padding:16px;background:linear-gradient(to right, #f00 0%, #00f 100%)")
