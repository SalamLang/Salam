تابع add(els &: وکتور<سی اس اس.عنصر>، tag: رشته، parent: صحیح، classes: رشته): صحیح:
    ناپایا e := سی اس اس.عنصر تازه("box"، parent)
    e.برچسب عنصر = tag
    e.کلاس های عنصر = classes
    els.بیفزا(e)
    برگشت els.طول() - 1
پایان

تابع free_all(els &: وکتور<سی اس اس.عنصر>):
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان

تابع tree(els &: وکتور<سی اس اس.عنصر>):
    body := add(els، "body"، -1، "")
    card := add(els، "div"، body، "card")
    _h3 := add(els، "h3"، card، "")
    p := add(els، "p"، card، "")
    _a := add(els، "a"، p، "")
    ul := add(els، "ul"، body، "")
    _li1 := add(els، "li"، ul، "")
    _li2 := add(els، "li"، ul، "")
    _wide := add(els، "div"، body، "wide")
    _plain := add(els، "div"، body، "")
پایان

تابع show(label: رشته، a: سی اس اس.برگه‌سبک، b: سی اس اس.برگه‌سبک، n: صحیح):
    props := ["display"، "width"، "padding-top"، "margin-left"، "margin-bottom"، "border-top"، "border-top-left-radius"، "box-shadow"، "background-color"، "background-image"، "color"، "font-size"، "font-family"، "font-style"، "font-weight"، "line-height"، "row-gap"، "column-gap"، "text-decoration-line"، "transition-duration"، "transform"، "box-sizing"]
    ناپایا same := 0
    ناپایا diff := 0
    تکرار n در i:
        sa := a.سبک عنصر(i)
        sb := b.سبک عنصر(i)
        تکرار طول(props) در k:
            va := سی اس اس.متن مقدار(sa، props[k])
            vb := سی اس اس.متن مقدار(sb، props[k])
            اگر va برابر vb:
                same++
            وگرنه:
                diff++
                سرچاپ label، "differs"، i، props[k]، va، "/"، vb
            پایان
        پایان
    پایان
    سرچاپ label، "same"، same، "different"، diff
پایان

تابع ریشه:
    ناپایا p := سی اس اس.برنامه سبک تازه()
    base := compile(p)
    src_a := سی اس اس.متن برنامه سبک(p، "styles"، "css")
    سرچاپ "base list"، base، "again"، سی اس اس.ترجمه اعلان ها(p، "display:flex;gap:12px;padding:16px;background:linear-gradient(to right, #f00 0%, #00f 100%)")
    سرچاپ "empty list"، سی اس اس.ترجمه اعلان ها(p، "  ")
    سرچاپ "bad rule"، سی اس اس.ترجمه قاعده(p، "a[["، "color: red"، "")
    _bad := سی اس اس.ترجمه اعلان ها(p، "colr: red; width: banana")
    سرچاپ "errors"، سی اس اس.شمار خطاهای برنامه(p)
    تکرار سی اس اس.شمار خطاهای برنامه(p) در i:
        e := سی اس اس.خطای برنامه(p، i)
        سرچاپ " "، e
    پایان
    ناپایا q := styles()
    src_b := سی اس اس.متن برنامه سبک(q، "styles"، "css")
    سرچاپ "source round trip"، src_a برابر src_b، src_a.طول() بزرگتر 1000
    fa := سی اس اس.متن برنامه سبک(سی اس اس.برنامه سبک تازه()، "سبک ها"، "سی اس اس")
    سرچاپ "persian empty"، fa.طول() بزرگتر 0، fa.دربردارد("برنامه‌سبک")، fa.دربردارد("برنامه سبک تازه")
    ناپایا text_sheet := سی اس اس.برگه تازه()
    _a1 := text_sheet.افزودن قاعده("*"، "box-sizing:border-box")
    _a2 := text_sheet.افزودن قاعده(".card"، "padding:12px; border:2px solid #3366aa; border-radius:10px; box-shadow:0 4px 8px rgba(0,0,0,.25); background:#fff")
    _a3 := text_sheet.افزودن قاعده(".card:hover"، "background:#ffeecc")
    _a4 := text_sheet.افزودن قاعده("h3, .title > b"، "margin:0 0 4px; font: italic bold 15px/1.4 Georgia, serif; color: hsl(210 50% 40%)")
    _a5 := text_sheet.افزودن قاعده رسانه("(max-width: 600px)"، ".wide"، "width: calc(100% - 2em); --gap: 8px; gap: var(--gap)")
    _a6 := text_sheet.افزودن قاعده("a:not(.x)"، "text-decoration: underline dotted; transition: color .2s ease-in-out")
    _a7 := text_sheet.افزودن قاعده("p"، "color: red !important; transform: rotate(45deg) translate(2px, 3px)")
    _a8 := text_sheet.افزودن سی اس اس(RULE_CSS)
    ناپایا prog_sheet := سی اس اس.برگه از برنامه(q)
    ناپایا ea := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا eb := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    tree(ea)
    tree(eb)
    ناپایا pa := ea.ارجاع(9)
    pa.اعلان های پایه = "display:flex;gap:12px;padding:16px;background:linear-gradient(to right, #f00 0%, #00f 100%)"
    ناپایا pb := eb.ارجاع(9)
    pb.شناسه اعلان پایه = base
    env := سی اس اس.محیط { پهنای پنجره = ۵۰۰.۰، حالت تیره = درست }
    _c1 := text_sheet.محاسبه سبک ها(ea، env)
    _c2 := prog_sheet.محاسبه سبک ها(eb، env)
    show("start"، text_sheet، prog_sheet، ea.طول())
    ناپایا ha := ea.ارجاع(1)
    ha.زیر اشاره = درست
    ناپایا hb := eb.ارجاع(1)
    hb.زیر اشاره = درست
    _r1 := text_sheet.سبک دهی دوباره(ea، 1)
    _r2 := prog_sheet.سبک دهی دوباره(eb، 1)
    show("hover"، text_sheet، prog_sheet، ea.طول())
    سرچاپ "card hover"، سی اس اس.متن مقدار(prog_sheet.سبک عنصر(1)، "background-color")
    سرچاپ "wide"، سی اس اس.متن مقدار(prog_sheet.سبک عنصر(8)، "width")، سی اس اس.متن مقدار(prog_sheet.سبک عنصر(8)، "row-gap")
    w1 := سی اس اس.اعلان زمان اجرا(q، "width"، "120px")
    w2 := سی اس اس.اعلان زمان اجرا(q، "width"، "120px")
    سرچاپ "dyn same id"، w1 برابر w2، "bad"، سی اس اس.اعلان زمان اجرا(q، "width"، "banana")
    ناپایا pd := eb.ارجاع(2)
    pd.شناسه های اعلان زمان اجرا.بیفزا(w1)
    سرچاپ "synced"، prog_sheet.افزودن برنامه(q)
    _c3 := prog_sheet.محاسبه سبک ها(eb، env)
    سرچاپ "dyn width"، سی اس اس.متن مقدار(prog_sheet.سبک عنصر(2)، "width")
    free_all(ea)
    free_all(eb)
    text_sheet.آزادسازی برگه()
    prog_sheet.آزادسازی برگه()
    q.آزادسازی برنامه()
    p.آزادسازی برنامه()
