واردسازی رابط گرافیکی.سی اس اس

تابع ریشه:
    ناپایا p := سی اس اس.برنامه سبک تازه()
    ناپایا q := p
    first := سی اس اس.ترجمه اعلان ها(p، "color:red")
    سرچاپ "first list: " + first
    p.آزادسازی برنامه()
    second := سی اس اس.ترجمه اعلان ها(q، "color:blue")
    سرچاپ "after the original was freed, a copy compiles into a fresh program: " + second
    سرچاپ "errors: " + سی اس اس.شمار خطاهای برنامه(q)
    q.آزادسازی برنامه()
پایان
