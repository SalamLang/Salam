specificity * = 0 0 0
specificity li = 0 0 1
specificity ul li = 0 0 2
specificity ul ol+li = 0 0 3
specificity h1 + *[rel=up] = 0 1 1
specificity ul ol li.red = 0 1 3
specificity li.red.level = 0 2 1
specificity #x34y = 1 0 0
specificity #s12:not(foo) = 1 0 1
specificity .foo :is(.bar, #baz) = 1 1 0
specificity :where(#a, .b) p = 0 0 1
specificity a:hover::before = -1 -1 -1
specificity p:nth-child(2n+1 of .x) = -1 -1 -1
match * @ 6 true
match nav @ 1 true
match #top @ 1 true
match .bar.dark @ 1 true
match .bar.light @ 1 false
match nav a @ 3 true
match nav > a @ 3 true
match body > a @ 3 false
match body a @ 3 true
match html > body > nav @ 1 true
match :root @ 0 false
match a:first-child @ 2 true
match a:last-child @ 4 true
match a:nth-child(2) @ 3 true
match a:nth-child(odd) @ 4 true
match a:nth-child(even) @ 4 false
match a:nth-last-child(1) @ 4 true
match a:nth-child(-n+2) @ 4 false
match p:first-of-type @ 7 true
match p:last-of-type @ 8 true
match h2 + p @ 7 true
match h2 + p @ 8 false
match h2 ~ p @ 8 true
match a:hover @ 3 true
match a:hover @ 2 false
match a:not(.first) @ 2 false
match a:not(.first) @ 3 true
match a:is(.first, .last) @ 4 true
match a:where(.x, .item) @ 3 true
match a[href] @ 2 true
match a[href] @ 3 false
match a[href="/home"] @ 2 true
match a[href^="/h"] @ 2 true
match a[href$=me] @ 2 true
match a[href*=om] @ 2 true
match a[class~=first] @ 2 true
match a[lang|=fa] @ 2 true
match a:lang(fa) @ 2 true
match a[HREF="/HOME" i] @ 2 true
match input[type=text]:required @ 9 true
match input:optional @ 9 false
match :placeholder-shown @ 9 true
match a:any-link @ 2 true
match a, p @ 8 true
match p::before @ 7 false
match p > @ 7 false
match p:unknown @ 7 false
