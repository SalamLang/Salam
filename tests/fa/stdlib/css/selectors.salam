// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس

تابع spec(sel: رشته):
    s := سی اس اس.ویژگی مندی گزینشگر(sel)
    سرچاپ "specificity"، sel، "="، s.شمار شناسه ها، s.شمار کلاس ها، s.شمار نوع ها
پایان

تابع add(els &: وکتور<سی اس اس.عنصر>، kind: رشته، parent: صحیح، id: رشته، classes: رشته): صحیح:
    ناپایا e := سی اس اس.عنصر تازه(kind، parent)
    e.شناسه عنصر = id
    e.کلاس های عنصر = classes
    els.بیفزا(e)
    برگشت els.طول() - 1
پایان

تابع check(sheet &: سی اس اس.برگه‌سبک، els &: وکتور<سی اس اس.عنصر>، sel: رشته، i: صحیح):
    سرچاپ "match"، sel، "@"، i، sheet.تطبیق گزینشگر(sel، els، i)
پایان

تابع ریشه:
    spec("*")
    spec("li")
    spec("ul li")
    spec("ul ol+li")
    spec("h1 + *[rel=up]")
    spec("ul ol li.red")
    spec("li.red.level")
    spec("#x34y")
    spec("#s12:not(foo)")
    spec(".foo :is(.bar, #baz)")
    spec(":where(#a, .b) p")
    spec("a:hover::before")
    spec("p:nth-child(2n+1 of .x)")
    ناپایا sheet := سی اس اس.برگه خالی()
    دیرکن sheet.آزادسازی برگه()
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    body := add(els، "page"، -1، ""، "")
    nav := add(els، "nav"، body، "top"، "bar dark")
    a1 := add(els، "link"، nav، ""، "item first")
    a2 := add(els، "link"، nav، ""، "item")
    a3 := add(els، "link"، nav، ""، "item last")
    sec := add(els، "section"، body، ""، "")
    h := add(els، "h2"، sec، ""، "")
    p1 := add(els، "paragraph"، sec، ""، "lead")
    p2 := add(els، "paragraph"، sec، ""، "")
    inp := add(els، "input"، sec، "name"، "")
    ناپایا ie := els.ارجاع(inp)
    ie.افزودن ویژگی("type"، "text")
    ie.افزودن ویژگی("required"، "")
    ie.افزودن ویژگی("placeholder"، "Your name")
    ناپایا ae := els.ارجاع(a1)
    ae.افزودن ویژگی("href"، "/home")
    ae.افزودن ویژگی("lang"، "fa-IR")
    ناپایا a2e := els.ارجاع(a2)
    a2e.زیر اشاره = درست
    check(sheet، els، "*"، h)
    check(sheet، els، "nav"، nav)
    check(sheet، els، "#top"، nav)
    check(sheet، els، ".bar.dark"، nav)
    check(sheet، els، ".bar.light"، nav)
    check(sheet، els، "nav a"، a2)
    check(sheet، els، "nav > a"، a2)
    check(sheet، els، "body > a"، a2)
    check(sheet، els، "body a"، a2)
    check(sheet، els، "html > body > nav"، nav)
    check(sheet، els، ":root"، body)
    check(sheet، els، "a:first-child"، a1)
    check(sheet، els، "a:last-child"، a3)
    check(sheet، els، "a:nth-child(2)"، a2)
    check(sheet، els، "a:nth-child(odd)"، a3)
    check(sheet، els، "a:nth-child(even)"، a3)
    check(sheet، els، "a:nth-last-child(1)"، a3)
    check(sheet، els، "a:nth-child(-n+2)"، a3)
    check(sheet، els، "p:first-of-type"، p1)
    check(sheet، els، "p:last-of-type"، p2)
    check(sheet، els، "h2 + p"، p1)
    check(sheet، els، "h2 + p"، p2)
    check(sheet، els، "h2 ~ p"، p2)
    check(sheet، els، "a:hover"، a2)
    check(sheet، els، "a:hover"، a1)
    check(sheet، els، "a:not(.first)"، a1)
    check(sheet، els، "a:not(.first)"، a2)
    check(sheet، els، "a:is(.first, .last)"، a3)
    check(sheet، els، "a:where(.x, .item)"، a2)
    check(sheet، els، "a[href]"، a1)
    check(sheet، els، "a[href]"، a2)
    check(sheet، els، "a[href=\"/home\"]"، a1)
    check(sheet، els، "a[href^=\"/h\"]"، a1)
    check(sheet، els، "a[href$=me]"، a1)
    check(sheet، els، "a[href*=om]"، a1)
    check(sheet، els، "a[class~=first]"، a1)
    check(sheet، els، "a[lang|=fa]"، a1)
    check(sheet، els، "a:lang(fa)"، a1)
    check(sheet، els، "a[HREF=\"/HOME\" i]"، a1)
    check(sheet، els، "input[type=text]:required"، inp)
    check(sheet، els، "input:optional"، inp)
    check(sheet، els، ":placeholder-shown"، inp)
    check(sheet، els، "a:any-link"، a1)
    check(sheet، els، "a, p"، p2)
    check(sheet، els، "p::before"، p1)
    check(sheet، els، "p >"، p1)
    check(sheet، els، "p:unknown"، p1)
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان
