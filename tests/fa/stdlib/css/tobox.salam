// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس
واردسازی رابط گرافیکی.جعبه سی اس اس

تابع len_of(l: جعبه سی اس اس.درازا): رشته:
    برگشت "" + (l.قسم درازا برگردان صحیح) + ":" + l.مقدار درازا
پایان

تابع show(label: رشته، st: جعبه سی اس اس.سبک):
    سرچاپ label، "display"، st.نمایش، "position"، st.جایگاه، "sizing"، st.سنجش جعبه
    سرچاپ "  width"، len_of(st.پهنا)، "height"، len_of(st.بلندی)، "min"، len_of(st.کمینه پهنا)، "max"، len_of(st.بیشینه پهنا)
    سرچاپ "  margin"، len_of(st.حاشیه بیرونی.سوی بالا)، len_of(st.حاشیه بیرونی.سوی راست)، len_of(st.حاشیه بیرونی.سوی پایین)، len_of(st.حاشیه بیرونی.سوی چپ)
    سرچاپ "  padding"، len_of(st.حاشیه درونی.سوی بالا)، len_of(st.حاشیه درونی.سوی چپ)، "border"، len_of(st.مرز.سوی بالا)، len_of(st.مرز.سوی چپ)
    سرچاپ "  inset"، len_of(st.فاصله جایگاه.سوی بالا)، len_of(st.فاصله جایگاه.سوی چپ)، "flex"، st.جهت فلکس، st.شکست فلکس، st.رشد فلکس، st.کوچک شدن فلکس، len_of(st.پایه فلکس)
    سرچاپ "  align"، st.چینش محتوا، st.تراز آیتم ها، st.تراز خود، "gap"، len_of(st.فاصله سطرها)، len_of(st.فاصله ستون ها)، "order"، st.ترتیب، "dir"، st.جهت، "overflow"، st.سرریز افقی، st.سرریز عمودی، "ratio"، st.نسبت ابعاد
پایان

تابع ریشه:
    ناپایا sheet := سی اس اس.برگه تازه()
    دیرکن sheet.آزادسازی برگه()
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    els.بیفزا(سی اس اس.عنصر تازه("page"، -1))
    ناپایا a := سی اس اس.عنصر تازه("box"، 0)
    a.اعلان های پایه = "display: flex; flex-flow: row-reverse wrap; justify-content: space-between; align-items: center; gap: 10px 5%; padding: 1em 2%; border: 3px solid; width: 50%; max-width: 600px; min-height: 2rem; box-sizing: border-box; overflow: hidden; border-radius: 50% / 10px"
    els.بیفزا(a)
    ناپایا b := سی اس اس.عنصر تازه("box"، 1)
    b.اعلان های پایه = "flex: 1 0 120px; order: 2; align-self: flex-end; margin: auto 10px; aspect-ratio: 4 / 3"
    els.بیفزا(b)
    ناپایا c := سی اس اس.عنصر تازه("box"، 1)
    c.اعلان های پایه = "position: absolute; top: 5px; left: calc(50% - 20px); width: min(100%, 300px); direction: rtl"
    els.بیفزا(c)
    ناپایا d := سی اس اس.عنصر تازه("span"، 0)
    d.اعلان های پایه = "width: 100px"
    els.بیفزا(d)
    ناپایا f := سی اس اس.عنصر تازه("box"، 0)
    f.اعلان های پایه = "border-radius: 80px"
    els.بیفزا(f)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 1000.0، بلندی پنجره = 700.0 })
    show("flex container"، سی اس اس.به جعبه(sheet.سبک عنصر(1)))
    show("flex item"، سی اس اس.به جعبه(sheet.سبک عنصر(2)))
    show("absolute"، سی اس اس.به جعبه(sheet.سبک عنصر(3)))
    show("absolute resolved in 400x300"، سی اس اس.به جعبه درون(sheet.سبک عنصر(3)، 400.0، 300.0))
    show("inline"، سی اس اس.به جعبه(sheet.سبک عنصر(4)))
    ناپایا tree := جعبه سی اس اس.درخت {}
    root := tree.افزودن گره(سی اس اس.به جعبه(sheet.سبک عنصر(0)))
    box := tree.افزودن گره(سی اس اس.به جعبه(sheet.سبک عنصر(1)))
    item := tree.افزودن گره(سی اس اس.به جعبه(sheet.سبک عنصر(2)))
    tree.افزودن فرزند(root، box)
    tree.افزودن فرزند(box، item)
    tree.محاسبه(root، جعبه سی اس اس.معین(1000.0)، جعبه سی اس اس.معین(700.0))
    lb := tree.جانمایی گره(box)
    li := tree.جانمایی گره(item)
    سرچاپ "layout box"، lb.ایکس، lb.ایگرگ، lb.پهنای جعبه، lb.بلندی جعبه، "item"، li.ایکس، li.ایگرگ، li.پهنای جعبه، li.بلندی جعبه
    r := سی اس اس.شعاع های به کار رفته(sheet.سبک عنصر(1)، 100.0، 50.0)
    سرچاپ "radii"، r.بالا چپ افقی، r.بالا چپ عمودی، r.پایین راست افقی، r.پایین راست عمودی
    r2 := سی اس اس.شعاع های به کار رفته(sheet.سبک عنصر(5)، 100.0، 50.0)
    سرچاپ "radii scaled"، r2.بالا چپ افقی، r2.بالا چپ عمودی، r2.بالا راست افقی، r2.پایین چپ عمودی
    سرچاپ "needs basis"، سی اس اس.نیاز به پایه(sheet.سبک عنصر(1))، سی اس اس.نیاز به پایه(sheet.سبک عنصر(3))
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان
