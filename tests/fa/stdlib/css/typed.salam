تابع free_all(els &: وکتور<سی اس اس.عنصر>):
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان

تابع source_lines(decls: رشته):
    ناپایا p := سی اس اس.برنامه سبک تازه()
    _id := سی اس اس.ترجمه اعلان ها(p، decls)
    src := سی اس اس.متن برنامه سبک(p، "s"، "css")
    lines := src.بشکاف("\n")
    تکرار lines.طول() در i:
        اگر lines[i].دربردارد("AddTyped") یا lines[i].دربردارد("AddVarDecl"):
            سرچاپ lines[i]
        پایان
        حافظه.آزادسازی(lines[i] برگردان تهی*)
    پایان
    lines.آزادکن()
    حافظه.آزادسازی(src برگردان تهی*)
    p.آزادسازی برنامه()
