تابع scheme(css_text: رشته):
    ناپایا p := سی اس اس.برنامه سبک تازه()
    _n := سی اس اس.ترجمه سی اس اس(p، css_text)
    ناپایا s := سی اس اس.برگه از برنامه(p)
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    body := add(els، "body"، -1، "")
    تکرار 20:
        _x := add(els، "div"، body، "plain")
    پایان
    _l := add(els، "div"، body، "ld")
    _y := add(els، "button"، body، "")
    _m := add(els، "div"، body، "m")
    _c := s.محاسبه سبک ها(els، سی اس اس.محیط {})
    سرچاپ "light"، سی اس اس.متن مقدار(s.سبک عنصر(21)، "background-color")، سی اس اس.متن مقدار(s.سبک عنصر(22)، "background-color")، سی اس اس.متن مقدار(s.سبک عنصر(23)، "border-top-width")، سی اس اس.متن مقدار(s.سبک عنصر(1)، "color")
    سرچاپ "to dark restyled"، s.تنظیم طرح رنگ(els، درست)، "again"، s.تنظیم طرح رنگ(els، درست)
    سرچاپ "dark"، سی اس اس.متن مقدار(s.سبک عنصر(21)، "background-color")، سی اس اس.متن مقدار(s.سبک عنصر(22)، "background-color")، سی اس اس.متن مقدار(s.سبک عنصر(23)، "border-top-width")، سی اس اس.متن مقدار(s.سبک عنصر(1)، "color")
    سرچاپ "to light restyled"، s.تنظیم طرح رنگ(els، نادرست)
    سرچاپ "light"، سی اس اس.متن مقدار(s.سبک عنصر(21)، "background-color")، سی اس اس.متن مقدار(s.سبک عنصر(22)، "background-color")، سی اس اس.متن مقدار(s.سبک عنصر(23)، "border-top-width")
    free_all(els)
    s.آزادسازی برگه()
    p.آزادسازی برنامه()
