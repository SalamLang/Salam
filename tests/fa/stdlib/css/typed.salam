تابع gradient(decl: رشته):
    ناپایا sheet := سی اس اس.برگه تازه()
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا e := سی اس اس.عنصر تازه("box"، -1)
    e.اعلان های پایه = decl
    els.بیفزا(e)
    _c := sheet.محاسبه سبک ها(els، سی اس اس.محیط {})
    l := sheet.سبک عنصر(0).لایه های پس زمینه[0]
    ناپایا line := "" + l.ایستگاه های رنگ.طول() + ":"
    هر st در l.ایستگاه های رنگ:
        c := سی اس اس.متن رنگ(st.رنگ ایستگاه)
        p := سی اس اس.متن درازا(st.جای ایستگاه)
        line = line + " " + c + "@" + p
        حافظه.آزادسازی(c برگردان تهی*)
        حافظه.آزادسازی(p برگردان تهی*)
    پایان
    سرچاپ decl
    سرچاپ "   "، line
    free_all(els)
    sheet.آزادسازی برگه()
