// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس

تابع one(sheet &: سی اس اس.برگه‌سبک، decls: رشته): سی اس اس.سبک‌محاسبه‌شده:
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا root := سی اس اس.عنصر تازه("page"، -1)
    root.اعلان های پایه = "font-size: 20px; color: #336699"
    els.بیفزا(root)
    ناپایا e := سی اس اس.عنصر تازه("box"، 0)
    e.اعلان های پایه = decls
    els.بیفزا(e)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 800.0، بلندی پنجره = 600.0 })
    cs := sheet.سبک عنصر(1)
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
    برگشت cs
پایان

تابع color(label: رشته، text: رشته):
    ناپایا c := سی اس اس.رنگ‌سی‌اس‌اس {}
    ok := سی اس اس.تجزیه رنگ(text، c)
    سرچاپ label، ok، سی اس اس.متن رنگ(c)
پایان

تابع len(sheet &: سی اس اس.برگه‌سبک، decl: رشته):
    cs := one(sheet، "width: " + decl)
    سرچاپ decl، "=>"، سی اس اس.متن درازا(cs.پهنا)
پایان

تابع ریشه:
    ناپایا sheet := سی اس اس.برگه تازه()
    دیرکن sheet.آزادسازی برگه()
    color("hex3"، "#f80")
    color("hex4"، "#f808")
    color("hex6"، "#336699")
    color("hex8"، "#33669980")
    color("rgb"، "rgb(10, 20, 30)")
    color("rgba"، "rgba(10, 20, 30, 0.5)")
    color("rgb pct"، "rgb(100% 50% 0%)")
    color("rgb space"، "rgb(10 20 30 / 25%)")
    color("hsl"، "hsl(120, 100%, 50%)")
    color("hsla"، "hsla(240 100% 50% / 0.5)")
    color("hwb"، "hwb(0 0% 0%)")
    color("hwb grey"، "hwb(90 60% 60%)")
    color("named"، "rebeccapurple")
    color("transparent"، "transparent")
    color("bad"، "rgb(1, 2)")
    len(sheet، "10px")
    len(sheet، "2em")
    len(sheet، "1.5rem")
    len(sheet، "50%")
    len(sheet، "10vw")
    len(sheet، "10vh")
    len(sheet، "10vmin")
    len(sheet، "10vmax")
    len(sheet، "2ch")
    len(sheet، "2ex")
    len(sheet، "12pt")
    len(sheet، "1in")
    len(sheet، "2.54cm")
    len(sheet، "10mm")
    len(sheet، "calc(100% - 2em)")
    len(sheet، "calc(10px + 2 * 3px)")
    len(sheet، "calc((100% - 20px) / 2)")
    len(sheet، "min(100%, 24rem)")
    len(sheet، "max(10px, 1em)")
    len(sheet، "clamp(10px, 5vw, 30px)")
    len(sheet، "clamp(1rem, 50%, 40rem)")
    len(sheet، "fit-content")
    len(sheet، "max-content")
    m := one(sheet، "width: min(100%, 24rem)")
    سرچاپ "resolve min at 300:"، سی اس اس.حل درازا(m.پهنا، 300.0)، "at 600:"، سی اس اس.حل درازا(m.پهنا، 600.0)
    c2 := one(sheet، "width: calc(100% - 2em)")
    سرچاپ "resolve calc at 200:"، سی اس اس.حل درازا(c2.پهنا، 200.0)
    cc := one(sheet، "border: 2px solid currentColor; background-color: color-mix(in srgb, red, blue)")
    سرچاپ "currentColor"، سی اس اس.متن رنگ(cc.مرز بالا.رنگ ضلع)، "color-mix"، سی اس اس.متن رنگ(cc.رنگ پس زمینه)
    g := one(sheet، "background-image: linear-gradient(45deg, red, blue 40%, green); background-color: navy")
    l := g.لایه های پس زمینه[0]
    سرچاپ "linear"، l.نوع تصویر لایه، l.زاویه گرادیان، l.ایستگاه های رنگ.طول()، سی اس اس.متن رنگ(l.ایستگاه های رنگ[1].رنگ ایستگاه)، سی اس اس.متن درازا(l.ایستگاه های رنگ[1].جای ایستگاه)، l.ایستگاه های رنگ[0].جای دارد، سی اس اس.متن رنگ(g.رنگ پس زمینه)
    g2 := one(sheet، "background-image: repeating-linear-gradient(to top right, #000 0 10px, #fff 10px 20px)")
    l2 := g2.لایه های پس زمینه[0]
    سرچاپ "repeating corner"، l2.گرادیان تکراری، l2.سوی افقی گرادیان، l2.سوی عمودی گرادیان، l2.ایستگاه های رنگ.طول()
    g3 := one(sheet، "background: radial-gradient(circle 40px at 25% 75%, white, black), url(a.png) no-repeat right 10px top / 50% auto, #eee")
    سرچاپ "layers"، g3.لایه های پس زمینه.طول()، سی اس اس.متن رنگ(g3.رنگ پس زمینه)
    r := g3.لایه های پس زمینه[0]
    سرچاپ "radial"، r.نوع تصویر لایه، r.شکل گرادیان، r.گستره گرادیان، سی اس اس.متن درازا(r.شعاع افقی گرادیان)، سی اس اس.متن درازا(r.مرکز افقی گرادیان)، سی اس اس.متن درازا(r.مرکز عمودی گرادیان)
    u := g3.لایه های پس زمینه[1]
    سرچاپ "url"، u.نوع تصویر لایه، u.نشانی تصویر، u.کاشی افقی لایه، u.کاشی عمودی لایه، سی اس اس.متن درازا(u.جای افقی لایه)، سی اس اس.متن درازا(u.جای عمودی لایه)، سی اس اس.متن درازا(u.پهنای لایه)، سی اس اس.متن درازا(u.بلندی لایه)
    g4 := one(sheet، "background-image: conic-gradient(from 90deg at 10px 20px, red 0deg, blue 0.5turn, red)")
    c4 := g4.لایه های پس زمینه[0]
    سرچاپ "conic"، c4.نوع تصویر لایه، c4.زاویه گرادیان، سی اس اس.متن درازا(c4.مرکز افقی گرادیان)، سی اس اس.متن درازا(c4.ایستگاه های رنگ[1].جای ایستگاه)
    sh := one(sheet، "box-shadow: 0 1px 2px rgba(0,0,0,.1), inset 0 0 0 1px #fff, 3px 3px red")
    تکرار sh.سایه های جعبه.طول() در i:
        s := sh.سایه های جعبه[i]
        سرچاپ "shadow"، s.جابجایی افقی سایه، s.جابجایی عمودی سایه، s.تاری سایه، s.گسترش سایه، s.سایه داخلی، سی اس اس.متن رنگ(s.رنگ سایه)
    پایان
    ts := one(sheet، "text-shadow: 1px 1px 2px black, 0 0 1em blue")
    سرچاپ "text shadows"، ts.سایه های متن.طول()، ts.سایه های متن[1].تاری سایه
    tf := one(sheet، "transform: translate(10px, 50%) scale(2) rotate(45deg) skewX(10deg) matrix(1, 0, 0, 1, 5, 6); transform-origin: left top")
    تکرار tf.تبدیل ها.طول() در i:
        tfn := tf.تبدیل ها[i]
        سرچاپ "transform"، tfn.قسم کارکرد تبدیل، سی اس اس.متن درازا(tfn.جابجایی افقی)، سی اس اس.متن درازا(tfn.جابجایی عمودی)، tfn.ضریب الف، tfn.ضریب ب، tfn.ضریب ث، tfn.ضریب ج
    پایان
    سرچاپ "origin"، سی اس اس.متن درازا(tf.مبدأ تبدیل افقی)، سی اس اس.متن درازا(tf.مبدأ تبدیل عمودی)
    mm := سی اس اس.ماتریس تبدیل(one(sheet، "transform: translate(10px, 20px) scale(2)")، 100.0، 50.0)
    سرچاپ "matrix"، mm.خانه الف، mm.خانه ب، mm.خانه پ، mm.خانه ت، mm.خانه ث، mm.خانه ج
    rt := سی اس اس.ماتریس تبدیل(one(sheet، "rotate: 90deg; transform-origin: 0 0")، 100.0، 50.0)
    سرچاپ "rotate matrix"، rt.خانه الف، rt.خانه ب، rt.خانه پ، rt.خانه ت
    tr := one(sheet، "transition: background 200ms ease-in-out, transform 0.1s steps(4, jump-start) 50ms")
    تکرار tr.گذارها.طول() در i:
        t := tr.گذارها[i]
        سرچاپ "transition"، t.ویژگی گذار، t.مدت گذار، t.درنگ گذار، t.زمان بندی گذار.قسم زمان بندی، t.زمان بندی گذار.ایکس یک، t.زمان بندی گذار.شمار پله ها، t.زمان بندی گذار.جای پرش
    پایان
    سرچاپ "ease at 0.5"، سی اس اس.مقدار تسهیل(سی اس اس.زمان‌بندی {}، 0.5)
    سرچاپ "linear at 0.3"، سی اس اس.مقدار تسهیل(سی اس اس.زمان‌بندی { قسم زمان بندی = سی اس اس.نوع‌زمان‌بندی.Linear }، 0.3)
    سرچاپ "steps at 0.3"، سی اس اس.مقدار تسهیل(سی اس اس.زمان‌بندی { قسم زمان بندی = سی اس اس.نوع‌زمان‌بندی.Steps، شمار پله ها = 4 }، 0.3)
    f := one(sheet، "font: italic small-caps bold 12px/1.5 \"Vazirmatn\", Tahoma, sans-serif")
    سرچاپ "font"، f.حالت قلم، f.حروف کوچک بزرگ، f.وزن قلم، f.سایز قلم، f.ارتفاع خط، f.ضریب ارتفاع خط، f.خانواده قلم
    fams := سی اس اس.خانواده های قلم(f)
    سرچاپ "families"، fams.طول()، fams[0]، fams[2]
    fams.آزادکن()
    f2 := one(sheet، "font-size: larger; font-weight: bolder; line-height: 150%; letter-spacing: 0.1em")
    سرچاپ "relative font"، f2.سایز قلم، f2.وزن قلم، f2.ارتفاع خط، f2.فاصله حروف
    f3 := one(sheet، "font-family: Times New Roman, serif; font-size: x-large")
    سرچاپ f3.خانواده قلم، f3.سایز قلم
    v := one(sheet، "--gap: 12px; --brand: #ff0000; --pad: var(--gap); padding: var(--pad) 4px; color: var(--brand); margin: var(--missing, 7px); width: var(--nope)")
    سرچاپ "var"، سی اس اس.متن درازا(v.فاصله داخلی بالا)، سی اس اس.متن درازا(v.فاصله داخلی راست)، سی اس اس.متن رنگ(v.رنگ متن)، سی اس اس.متن درازا(v.حاشیه چپ)، سی اس اس.متن درازا(v.پهنا)
    url := one(sheet، "list-style: square inside url(\"dot.png\"); cursor: url(hand.cur) 4 4, pointer")
    سرچاپ "list"، url.نوع نشانه فهرست، url.جای نشانه فهرست، url.تصویر نشانه فهرست، url.نشانگر
    nums := one(sheet، "opacity: 50%; z-index: 7; order: -1; flex-grow: 2; aspect-ratio: 16 / 9")
    سرچاپ "numbers"، nums.ماتی، nums.عمق لایه، nums.عمق خودکار، nums.ترتیب، nums.رشد فلکس، nums.نسبت ابعاد
    bad := one(sheet، "width: 10; height: -5px; color: notacolor; opacity: 0.5; opacity: banana")
    سرچاپ "invalid dropped"، سی اس اس.متن درازا(bad.پهنا)، سی اس اس.متن درازا(bad.بلندی)، سی اس اس.متن رنگ(bad.رنگ متن)، bad.ماتی
پایان
