تابع ahem(text: رشته، mi: جعبه سی اس اس.داده‌سنجش): جعبه سی اس اس.سنجیده:
    words := text.بشکاف("|")
    دیرکن words.آزادکن()
    ناپایا minl := 0
    ناپایا maxl := 0
    هر w در words:
        اگر w.طول() بزرگتر minl:
            minl = w.طول()
        پایان
        maxl += w.طول()
    پایان
    ناپایا iw := 0.0
    اگر mi.پهنا معلوم است:
        iw = mi.پهنای معلوم
    وگرنه:
        ترابرد mi.پهنای موجود.قسم فضا:
            جعبه سی اس اس.نوع‌فضا.فضای کمینه محتوا:
                iw = (minl برگردان اعشار۶۴) * 10.0
                بشکن
            پایان
            جعبه سی اس اس.نوع‌فضا.فضای بیشینه محتوا:
                iw = (maxl برگردان اعشار۶۴) * 10.0
                بشکن
            پایان
            جعبه سی اس اس.نوع‌فضا.فضای معین:
                iw = mi.پهنای موجود.مقدار فضا
                اگر iw بزرگتر (maxl برگردان اعشار۶۴) * 10.0:
                    iw = (maxl برگردان اعشار۶۴) * 10.0
                پایان
            پایان
        پایان
    پایان
    اگر iw کوچکتر (minl برگردان اعشار۶۴) * 10.0:
        iw = (minl برگردان اعشار۶۴) * 10.0
    پایان
    ناپایا bh := 0.0
    اگر mi.بلندی معلوم است:
        bh = mi.بلندی معلوم
    وگرنه:
        per := (iw / 10.0) برگردان صحیح
        ناپایا lines := 1
        ناپایا cur := 0
        هر w در words:
            اگر cur + w.طول() بزرگتر per:
                اگر cur بزرگتر 0:
                    lines++
                پایان
                cur = w.طول()
            وگرنه:
                cur += w.طول()
            پایان
        پایان
        bh = (lines برگردان اعشار۶۴) * 10.0
    پایان
    برگشت جعبه سی اس اس.سنجش شده با خط پایه(iw، bh، 8.0)
پایان

تابع space_of(v: رشته): جعبه سی اس اس.فضا:
    اگر v برابر "max":
        برگشت جعبه سی اس اس.فضای بیشینه()
    پایان
    اگر v برابر "min":
        برگشت جعبه سی اس اس.فضای کمینه()
    پایان
    برگشت جعبه سی اس اس.معین(v.به اعشار())
پایان

تابع near(a: اعشار۶۴، b: اعشار۶۴): منطقی:
    d := a - b
    برگشت d کوچکتر 0.1 و d بزرگتر -0.1
پایان

تابع run_case(name: رشته، nodes: وکتور<رشته>، variant: رشته، nums: وکتور<رشته>، vw: جعبه سی اس اس.فضا، vh: جعبه سی اس اس.فضا): منطقی:
    ناپایا t := جعبه سی اس اس.درخت {}
    دیرکن t.آزاد کردن()
    ناپایا stack := وکتور {} برگردان وکتور<صحیح>
    دیرکن stack.آزادکن()
    content := variant.شروع با("c")
    rtl := variant.ختم با("r")
    هر line در nodes:
        parts := line.بشکاف(" ")
        دیرکن parts.آزادکن()
        depth := parts.بگیر(1).به صحیح()
        ناپایا st := جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.فلکس، سنجش جعبه = content ? جعبه سی اس اس.نوع‌سنجش‌جعبه.جعبه محتوا : جعبه سی اس اس.نوع‌سنجش‌جعبه.جعبه مرز، جهت = rtl ? جعبه سی اس اس.نوع‌جهت.راست به چپ : جعبه سی اس اس.نوع‌جهت.چپ به راست }
        ناپایا text := ""
        تکرار parts.طول() - 2 در k:
            kv := parts.بگیر(k + 2)
            at := kv.indexOf("=")
            key := kv.زیررشته(0، at)
            val := kv.زیررشته(at + 1، kv.طول() - at - 1)
            اگر key برابر "T":
                text = val
            وگرنه:
                apply(st، key، val)
            پایان
        پایان
        id := t.افزودن گره(st)
        اگر text.طول() بزرگتر 0:
            t.تنظیم سنجش(id، (mi: جعبه سی اس اس.داده‌سنجش): برگشت ahem(text، mi) پایان)
        پایان
        تا stack.طول() بزرگتر depth:
            _x := stack.دربیاور()
        پایان
        اگر depth بزرگتر 0:
            t.افزودن فرزند(stack.بگیر(depth - 1)، id)
        پایان
        stack.بیفزا(id)
    پایان
    t.محاسبه(0، vw، vh)
    ناپایا ok := درست
    تکرار t.شمار گره ها() در id:
        ناپایا l := t.جانمایی گره(id)
        اگر id بزرگتر 0 و t.سبک گره(id).جایگاه برابر جعبه سی اس اس.نوع‌جایگاه.مطلق:
            ناپایا cb := t.والد(id)
            تا cb بزرگتر 0 و t.سبک گره(cb).جایگاه برابر جعبه سی اس اس.نوع‌جایگاه.عادی:
                cb = t.والد(cb)
            پایان
            cl := t.جانمایی گره(cb)
            l.ایکس = l.ایکس مطلق - cl.ایکس مطلق
            l.ایگرگ = l.ایگرگ مطلق - cl.ایگرگ مطلق
        پایان
        ex := nums.بگیر(id * 4).به اعشار()
        ey := nums.بگیر(id * 4 + 1).به اعشار()
        ew := nums.بگیر(id * 4 + 2).به اعشار()
        eh := nums.بگیر(id * 4 + 3).به اعشار()
        اگر وارونه (near(l.ایکس، ex) و near(l.ایگرگ، ey) و near(l.پهنای جعبه، ew) و near(l.بلندی جعبه، eh)):
            ok = نادرست
            سرچاپ "FAIL"، name، variant، "node"، id، "got"، l.ایکس، l.ایگرگ، l.پهنای جعبه، l.بلندی جعبه، "want"، ex، ey، ew، eh
        پایان
    پایان
    برگشت ok
پایان

همگانی تابع Run(data: رشته): صحیح:
    lines := data.بشکاف("\n")
    دیرکن lines.آزادکن()
    ناپایا fixtures := 0
    ناپایا cases := 0
    ناپایا failed := 0
    ناپایا name := ""
    ناپایا vw := جعبه سی اس اس.فضای بیشینه()
    ناپایا vh := جعبه سی اس اس.فضای بیشینه()
    ناپایا nodes := وکتور {} برگردان وکتور<رشته>
    دیرکن nodes.آزادکن()
    هر line در lines:
        اگر line.طول() کوچکتر 3:
            گذر
        پایان
        parts := line.بشکاف(" ")
        دیرکن parts.آزادکن()
        tag := parts.بگیر(0)
        اگر tag برابر "F":
            fixtures++
            name = parts.بگیر(1)
            vw = space_of(parts.بگیر(2))
            vh = space_of(parts.بگیر(3))
            تا nodes.طول() بزرگتر 0:
                _old := nodes.دربیاور()
            پایان
        وگرنه tag برابر "N":
            nodes.بیفزا(line)
        وگرنه tag برابر "E":
            ناپایا nums := وکتور {} برگردان وکتور<رشته>
            تکرار parts.طول() - 2 در k:
                nums.بیفزا(parts.بگیر(k + 2))
            پایان
            variants := parts.بگیر(1).بشکاف(",")
            هر v در variants:
                cases++
                اگر وارونه run_case(name، nodes، v، nums، vw، vh):
                    failed++
                پایان
            پایان
            variants.آزادکن()
            nums.آزادکن()
        پایان
    پایان
    سرچاپ "fixtures"، fixtures، "cases"، cases، "failed"، failed
    برگشت failed
پایان
