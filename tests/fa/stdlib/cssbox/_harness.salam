        "gce":
            s.انتهای ستون شبکه = رشته.جایگزینی(v، "_"، " ")
            بشکن
        پایان
        "grs":
            s.آغاز سطر شبکه = رشته.جایگزینی(v، "_"، " ")
            بشکن
        پایان
        "gre":
            s.انتهای سطر شبکه = رشته.جایگزینی(v، "_"، " ")
            بشکن
        پایان
        "js":
            s.چینش خود = align_of(v)
            بشکن
        پایان
        "ji":
            s.چینش آیتم ها = align_of(v)
            بشکن
        پایان
        "cs"، "span":
            s.گستره ستون = v.به صحیح()
            بشکن
        پایان
        "rs":
            s.گستره سطر = v.به صحیح()
            بشکن
        پایان
        "bsx":
            s.فاصله مرز افقی = v.به اعشار()
            s.فاصله مرز عمودی = v.به اعشار()
            بشکن
        پایان
        "bsy":
            s.فاصله مرز عمودی = v.به اعشار()
            بشکن
        پایان
        "bc":
            s.ادغام مرز = جعبه سی اس اس.نوع‌ادغام‌مرز.مرز ادغام شده
            بشکن
        پایان
        "bk":
            bk := kind_of(v)
            s.خطوط مرز = جعبه سی اس اس.خطوط‌مرز { خط بالا = bk، خط راست = bk، خط پایین = bk، خط چپ = bk }
            بشکن
        پایان
        "bkt":
            s.خطوط مرز.خط بالا = kind_of(v)
            بشکن
        پایان
        "bkr":
            s.خطوط مرز.خط راست = kind_of(v)
