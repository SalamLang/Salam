            بشکن
        پایان
        "sw":
            s.پهنای نوار پیمایش = v.به اعشار()
            بشکن
        پایان
        "dir":
            s.جهت = v برابر "rtl" ? جعبه سی اس اس.نوع‌جهت.راست به چپ : جعبه سی اس اس.نوع‌جهت.چپ به راست
            بشکن
        پایان
        "bs":
            s.سنجش جعبه = v برابر "c" ? جعبه سی اس اس.نوع‌سنجش‌جعبه.جعبه محتوا : جعبه سی اس اس.نوع‌سنجش‌جعبه.جعبه مرز
            بشکن
        پایان
