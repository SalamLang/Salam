            بشکن
        پایان
        "ac":
            s.تراز محتوا = align_of(v)
            بشکن
        پایان
        "jc":
            s.چینش محتوا = align_of(v)
            بشکن
        پایان
        "fd":
            s.جهت فلکس = direction_of(v)
            بشکن
        پایان
        "fw":
            اگر v برابر "wrap":
                s.شکست فلکس = جعبه سی اس اس.نوع‌شکست‌فلکس.شکستن
            وگرنه v برابر "wr":
                s.شکست فلکس = جعبه سی اس اس.نوع‌شکست‌فلکس.شکستن وارون
            پایان
            بشکن
        پایان
        "fg":
            s.رشد فلکس = v.به اعشار()
            بشکن
        پایان
        "fs":
            s.کوچک شدن فلکس = v.به اعشار()
            بشکن
        پایان
