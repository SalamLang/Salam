بسته harness

واردسازی رابط گرافیکی.جعبه سی اس اس
واردسازی رشته

تابع len_of(v: رشته): جعبه سی اس اس.درازا:
    ترابرد v:
        "auto":
            برگشت جعبه سی اس اس.خودکار()
        پایان
        "min":
            برگشت جعبه سی اس اس.کمینه محتوا()
        پایان
        "max":
            برگشت جعبه سی اس اس.بیشینه محتوا()
        پایان
        "fit":
            برگشت جعبه سی اس اس.اندازه محتوا()
        پایان
        "stretch":
            برگشت جعبه سی اس اس.کشیده()
        پایان
        وگرنه:
        پایان
    پایان
    اگر v.ختم با("%"):
        برگشت جعبه سی اس اس.درصد(v.زیررشته(0، v.طول() - 1).به اعشار())
    پایان
    برگشت جعبه سی اس اس.پیکسل(v.به اعشار())
پایان

