        "dotted": برگشت جعبه سی اس اس.نوع‌خط‌مرز.خط نقطه چین پایان
        "dashed": برگشت جعبه سی اس اس.نوع‌خط‌مرز.خط خط چین پایان
        "double": برگشت جعبه سی اس اس.نوع‌خط‌مرز.خط دوتایی پایان
        وگرنه: برگشت جعبه سی اس اس.نوع‌خط‌مرز.خط پیوسته پایان
    پایان
    برگشت جعبه سی اس اس.نوع‌خط‌مرز.خط پیوسته
پایان

تابع apply(s &: جعبه سی اس اس.سبک، k: رشته، v: رشته):
    ترابرد k:
        "d":
            s.نمایش = display_of(v)
            بشکن
        پایان
        "p":
            اگر v برابر "abs":
                s.جایگاه = جعبه سی اس اس.نوع‌جایگاه.مطلق
            وگرنه v برابر "rel":
                s.جایگاه = جعبه سی اس اس.نوع‌جایگاه.نسبی
            پایان
            بشکن
        پایان
