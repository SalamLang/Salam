            بشکن
        پایان
        "bt":
            s.مرز.سوی بالا = len_of(v)
            بشکن
        پایان
        "bl":
            s.مرز.سوی چپ = len_of(v)
            بشکن
        پایان
        "bb":
            s.مرز.سوی پایین = len_of(v)
            بشکن
        پایان
        "br":
