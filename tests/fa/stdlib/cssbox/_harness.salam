            بشکن
        پایان
        "rg":
            s.فاصله سطرها = len_of(v)
            بشکن
        پایان
        "ar":
            s.نسبت ابعاد = v.به اعشار()
            بشکن
        پایان
        "ai":
            s.تراز آیتم ها = align_of(v)
            بشکن
        پایان
        "as":
