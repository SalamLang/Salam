واردسازی رابط گرافیکی.جعبه سی اس اس

تابع show(t: جعبه سی اس اس.درخت، label: رشته، id: صحیح):
    l := t.جانمایی گره(id)
    سرچاپ label، l.ایکس، l.ایگرگ، l.پهنای جعبه، l.بلندی جعبه، "abs"، l.ایکس مطلق، l.ایگرگ مطلق، "scroll"، l.پهنای پیمایش، l.بلندی پیمایش
پایان

تابع list3(a: صحیح، b: صحیح، c: صحیح): وکتور<صحیح>:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    هر x در [a، b، c]:
        اگر x بزرگتربرابر 0:
            v.بیفزا(x)
        پایان
    پایان
    برگشت v
پایان

تابع text_of(width: اعشار۶۴، mi: جعبه سی اس اس.داده‌سنجش): جعبه سی اس اس.سنجیده:
    اگر mi.پهنای موجود.قسم فضا برابر جعبه سی اس اس.نوع‌فضا.فضای کمینه محتوا:
        برگشت جعبه سی اس اس.سنجش شده(width / 2.0، 36.0)
    پایان
    اگر mi.پهنای موجود.قسم فضا برابر جعبه سی اس اس.نوع‌فضا.فضای معین و mi.پهنای موجود.مقدار فضا کوچکتر width:
        برگشت جعبه سی اس اس.سنجش شده(mi.پهنای موجود.مقدار فضا، 36.0)
    پایان
    برگشت جعبه سی اس اس.سنجش شده(width، 18.0)
پایان

تابع ریشه:
    ناپایا t := جعبه سی اس اس.درخت {}
    دیرکن t.آزاد کردن()
    root := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(300.0)، حاشیه درونی = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(10.0)) })
    row := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.فلکس، بلندی = جعبه سی اس اس.پیکسل(40.0)، فاصله ستون ها = جعبه سی اس اس.پیکسل(5.0) })
    a := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(50.0)، ترتیب = 2 })
    b := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.درصد(20.0)، ترتیب = 1 })
    c := t.افزودن گره(جعبه سی اس اس.سبک { رشد فلکس = 1.0، حاشیه بیرونی = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.خودکار()، جعبه سی اس اس.پیکسل(0.0)، جعبه سی اس اس.خودکار()، جعبه سی اس اس.پیکسل(0.0))، بلندی = جعبه سی اس اس.پیکسل(10.0) })
    kids := list3(a، b، c)
    t.تنظیم فرزندان(row، kids)
    kids.آزادکن()
    wrap := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.فقط فرزندان })
    ib := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.بلوکی درون خطی، حاشیه درونی = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(5.0))، مرز = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(1.0)) })
    txt := t.افزودن گره(جعبه سی اس اس.سبک {})
    t.تنظیم سنجش(txt، (_mi: جعبه سی اس اس.داده‌سنجش): برگشت جعبه سی اس اس.سنجش شده با خط پایه(80.0، 20.0، 15.0) پایان)
    t.افزودن فرزند(ib، txt)
    t.افزودن فرزند(wrap، ib)
    holder := t.افزودن گره(جعبه سی اس اس.سبک { بلندی = جعبه سی اس اس.پیکسل(30.0)، حاشیه بیرونی = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.پیکسل(20.0)، جعبه سی اس اس.پیکسل(0.0)، جعبه سی اس اس.پیکسل(0.0)، جعبه سی اس اس.پیکسل(0.0)) })
    abs := t.افزودن گره(جعبه سی اس اس.سبک { جایگاه = جعبه سی اس اس.نوع‌جایگاه.مطلق، فاصله جایگاه = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.خودکار()، جعبه سی اس اس.پیکسل(0.0)، جعبه سی اس اس.خودکار()، جعبه سی اس اس.خودکار())، پهنا = جعبه سی اس اس.پیکسل(10.0)، بلندی = جعبه سی اس اس.پیکسل(10.0) })
    t.افزودن فرزند(holder، abs)
    rel := t.افزودن گره(جعبه سی اس اس.سبک { جایگاه = جعبه سی اس اس.نوع‌جایگاه.نسبی، بلندی = جعبه سی اس اس.پیکسل(20.0)، فاصله جایگاه = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.پیکسل(3.0)، جعبه سی اس اس.خودکار()، جعبه سی اس اس.خودکار()، جعبه سی اس اس.پیکسل(4.0)) })
    inner := t.افزودن گره(جعبه سی اس اس.سبک { جایگاه = جعبه سی اس اس.نوع‌جایگاه.مطلق، فاصله جایگاه = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(2.0)) })
    t.افزودن فرزند(rel، inner)
    fixed := t.افزودن گره(جعبه سی اس اس.سبک { جایگاه = جعبه سی اس اس.نوع‌جایگاه.ثابت، فاصله جایگاه = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.خودکار()، جعبه سی اس اس.پیکسل(5.0)، جعبه سی اس اس.پیکسل(5.0)، جعبه سی اس اس.خودکار())، پهنا = جعبه سی اس اس.پیکسل(20.0)، بلندی = جعبه سی اس اس.پیکسل(20.0) })
    scroller := t.افزودن گره(جعبه سی اس اس.سبک { بلندی = جعبه سی اس اس.پیکسل(50.0)، سرریز عمودی = جعبه سی اس اس.نوع‌سرریز.پیمایشی، پهنای نوار پیمایش = 15.0، سنجش جعبه = جعبه سی اس اس.نوع‌سنجش‌جعبه.جعبه مرز، مرز = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(2.0)) })
    tall := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(400.0)، بلندی = جعبه سی اس اس.پیکسل(120.0) })
    t.افزودن فرزند(scroller، tall)
    mc := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.بیشینه محتوا() })
    mct := t.افزودن گره(جعبه سی اس اس.سبک {})
    t.تنظیم سنجش(mct، (mi: جعبه سی اس اس.داده‌سنجش): برگشت text_of(120.0، mi) پایان)
    t.افزودن فرزند(mc، mct)
    nc := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.کمینه محتوا() })
    nct := t.افزودن گره(جعبه سی اس اس.سبک {})
    t.تنظیم سنجش(nct، (mi: جعبه سی اس اس.داده‌سنجش): برگشت text_of(120.0، mi) پایان)
    t.افزودن فرزند(nc، nct)
    fc := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.اندازه محتوا()، نسبت ابعاد = 4.0 })
    fct := t.افزودن گره(جعبه سی اس اس.سبک {})
    t.تنظیم سنجش(fct، (mi: جعبه سی اس اس.داده‌سنجش): برگشت text_of(500.0، mi) پایان)
    t.افزودن فرزند(fc، fct)
    rtl := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.فلکس، جهت = جعبه سی اس اس.نوع‌جهت.راست به چپ، شکست فلکس = جعبه سی اس اس.نوع‌شکست‌فلکس.شکستن، چینش محتوا = جعبه سی اس اس.نوع‌تراز.فاصله میان، تراز آیتم ها = جعبه سی اس اس.نوع‌تراز.تراز میانه، تراز محتوا = جعبه سی اس اس.نوع‌تراز.تراز میانه، بلندی = جعبه سی اس اس.پیکسل(60.0)، کمینه بلندی = جعبه سی اس اس.پیکسل(10.0)، بیشینه پهنا = جعبه سی اس اس.پیکسل(250.0) })
    تکرار 3 در i:
        cell := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(90.0)، بلندی = جعبه سی اس اس.پیکسل(10.0 + (i برگردان اعشار۶۴) * 5.0)، کوچک شدن فلکس = 0.0، پایه فلکس = جعبه سی اس اس.خودکار() })
        t.افزودن فرزند(rtl، cell)
    پایان
    col := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.فلکس، جهت فلکس = جعبه سی اس اس.نوع‌جهت‌فلکس.ستونی وارون، بلندی = جعبه سی اس اس.پیکسل(50.0)، فاصله سطرها = جعبه سی اس اس.پیکسل(4.0)، تراز آیتم ها = جعبه سی اس اس.نوع‌تراز.تراز انتهای فلکس })
    s1 := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(30.0)، بلندی = جعبه سی اس اس.پیکسل(10.0)، تراز خود = جعبه سی اس اس.نوع‌تراز.تراز کشیده })
    s2 := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(30.0)، رشد فلکس = 1.0، بیشینه بلندی = جعبه سی اس اس.پیکسل(20.0)، کمینه پهنا = جعبه سی اس اس.پیکسل(40.0) })
    s3 := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.بدون نمایش، بلندی = جعبه سی اس اس.پیکسل(99.0) })
    ck := list3(s1، s2، s3)
    t.تنظیم فرزندان(col، ck)
    ck.آزادکن()
    st := t.افزودن گره(جعبه سی اس اس.سبک { بلندی = جعبه سی اس اس.کشیده()، بیشینه بلندی = جعبه سی اس اس.خودکار() })
    ناپایا all := وکتور {} برگردان وکتور<صحیح>
    هر x در [row، wrap، holder، rel، fixed، scroller، mc، nc، fc، rtl، col، st]:
        all.بیفزا(x)
    پایان
    t.تنظیم فرزندان(root، all)
    all.آزادکن()
    t.محاسبه(root، جعبه سی اس اس.معین(800.0)، جعبه سی اس اس.معین(600.0))
    سرچاپ "nodes"، t.شمار گره ها()، "children"، t.شمار فرزندان(root)، "first"، t.فرزند(root، 0)، "parent"، t.والد(a)، "missing"، t.فرزند(root، 99)
    show(t، "root"، root)
    show(t، "row"، row)
    show(t، "a"، a)
    show(t، "b"، b)
    show(t، "c"، c)
    show(t، "contents"، wrap)
    show(t، "inline-block"، ib)
    show(t، "text"، txt)
    show(t، "holder"، holder)
    show(t، "abs"، abs)
    show(t، "rel"، rel)
    show(t، "inner"، inner)
    show(t، "fixed"، fixed)
    show(t، "scroller"، scroller)
    show(t، "tall"، tall)
    show(t، "max-content"، mc)
    show(t، "min-content"، nc)
    show(t، "fit-content"، fc)
    show(t، "rtl"، rtl)
    تکرار 3 در i:
        show(t، "rtl cell"، t.فرزند(rtl، i))
    پایان
    show(t، "col"، col)
    show(t، "s1"، s1)
    show(t، "s2"، s2)
    show(t، "s3"، s3)
    show(t، "stretch"، st)
    l := t.جانمایی گره(ib)
    سرچاپ "ib baseline"، l.دارای خط پایه، l.خط پایه، "content"، l.ایکس محتوا، l.ایگرگ محتوا، l.پهنای محتوا، l.بلندی محتوا
    سرچاپ "ib padding"، l.حاشیه درونی جعبه.لبه بالا، l.حاشیه درونی جعبه.لبه راست، l.حاشیه درونی جعبه.لبه پایین، l.حاشیه درونی جعبه.لبه چپ، "border"، l.مرز جعبه.لبه بالا، l.مرز جعبه.لبه راست، l.مرز جعبه.لبه پایین، l.مرز جعبه.لبه چپ
    m := t.جانمایی گره(c)
    سرچاپ "c margin"، m.حاشیه بیرونی جعبه.لبه بالا، m.حاشیه بیرونی جعبه.لبه راست، m.حاشیه بیرونی جعبه.لبه پایین، m.حاشیه بیرونی جعبه.لبه چپ
    sl := t.جانمایی گره(scroller)
    سرچاپ "scroller sb"، sl.پهنای نوار پیمایش جعبه، sl.بلندی نوار پیمایش جعبه، "content"، sl.پهنای محتوا، sl.بلندی محتوا
    t.صفر کردن شمارنده ها()
    t.محاسبه(root، جعبه سی اس اس.معین(800.0)، جعبه سی اس اس.معین(600.0))
    سرچاپ "unchanged calls"، t.شمار محاسبه ها()، t.شمار سنجش ها()، "dirty"، t.تغییر کرده است(root)
    t.علامت تغییر(mct)
    سرچاپ "after mark dirty"، t.تغییر کرده است(mct)، t.تغییر کرده است(root)، t.تغییر کرده است(a)
    t.محاسبه(root، جعبه سی اس اس.معین(800.0)، جعبه سی اس اس.معین(600.0))
    سرچاپ "one leaf calls"، t.شمار محاسبه ها()، t.شمار سنجش ها()
    t.صفر کردن شمارنده ها()
    ناپایا sty := t.سبک گره(a)
    sty.پهنا = جعبه سی اس اس.پیکسل(70.0)
    t.تنظیم سبک(a، sty)
    t.محاسبه(root، جعبه سی اس اس.معین(800.0)، جعبه سی اس اس.معین(600.0))
    show(t، "a wider"، a)
    show(t، "c after"، c)
    سرچاپ "style change calls"، t.شمار محاسبه ها()
    t.حذف سنجش(txt)
    t.محاسبه(root، جعبه سی اس اس.معین(500.0)، جعبه سی اس اس.معین(400.0))
    show(t، "ib cleared"، ib)
    show(t، "fixed 500"، fixed)
    t.تنظیم گردکردن(نادرست)
    t.محاسبه(root، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای کمینه())
    show(t، "b unrounded"، b)
    سرچاپ "kinds"، جعبه سی اس اس.معین(1.0).قسم فضا برابر جعبه سی اس اس.نوع‌فضا.فضای معین، جعبه سی اس اس.فضای کمینه().قسم فضا برابر جعبه سی اس اس.نوع‌فضا.فضای کمینه محتوا، جعبه سی اس اس.فضای بیشینه().قسم فضا برابر جعبه سی اس اس.نوع‌فضا.فضای بیشینه محتوا
    سرچاپ "lengths"، جعبه سی اس اس.کشیده().قسم درازا برابر جعبه سی اس اس.نوع‌درازا.درازای کشیده، جعبه سی اس اس.درصد(5.0).مقدار درازا، جعبه سی اس اس.خودکار().قسم درازا برابر جعبه سی اس اس.نوع‌درازا.درازای خودکار
پایان
