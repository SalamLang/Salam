واردسازی رابط گرافیکی.جعبه سی اس اس

تابع text_measure(n: صحیح، mi: جعبه سی اس اس.داده‌سنجش): جعبه سی اس اس.سنجیده:
    full := (n برگردان اعشار۶۴) * 7.0
    ناپایا w := full
    اگر mi.پهنای موجود.قسم فضا برابر جعبه سی اس اس.نوع‌فضا.فضای کمینه محتوا:
        w = 35.0
    وگرنه mi.پهنای موجود.قسم فضا برابر جعبه سی اس اس.نوع‌فضا.فضای معین و mi.پهنای موجود.مقدار فضا کوچکتر full:
        w = mi.پهنای موجود.مقدار فضا
        اگر w کوچکتر 35.0:
            w = 35.0
        پایان
    پایان
    lines := ((full / w) برگردان صحیح) + 1
    برگشت جعبه سی اس اس.سنجش شده با خط پایه(w، (lines برگردان اعشار۶۴) * 16.0، 12.0)
پایان

تابع ریشه:
    ناپایا t := جعبه سی اس اس.درخت {}
    دیرکن t.آزاد کردن()
    root := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.فلکس، جهت فلکس = جعبه سی اس اس.نوع‌جهت‌فلکس.ستونی، حاشیه درونی = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(8.0)) })
    ناپایا leaf := 0
    تکرار 50 در r:
        row := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.فلکس، شکست فلکس = جعبه سی اس اس.نوع‌شکست‌فلکس.شکستن، فاصله ستون ها = جعبه سی اس اس.پیکسل(4.0)، فاصله سطرها = جعبه سی اس اس.پیکسل(2.0) })
        t.افزودن فرزند(root، row)
        تکرار 100 در c:
            id := t.افزودن گره(جعبه سی اس اس.سبک { رشد فلکس = 1.0، حاشیه درونی = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(2.0)) })
            n := 3 + (r * 7 + c * 3) % 11
            t.تنظیم سنجش(id، (mi: جعبه سی اس اس.داده‌سنجش): برگشت text_measure(n، mi) پایان)
            t.افزودن فرزند(row، id)
            اگر r برابر 25 و c برابر 50:
                leaf = id
            پایان
        پایان
    پایان
    t.محاسبه(root، جعبه سی اس اس.معین(1280.0)، جعبه سی اس اس.معین(800.0))
    سرچاپ "nodes"، t.شمار گره ها()، "first layout calls"، t.شمار محاسبه ها()، "measures"، t.شمار سنجش ها()
    l := t.جانمایی گره(root)
    سرچاپ "root"، l.پهنای جعبه، l.بلندی جعبه
    t.صفر کردن شمارنده ها()
    t.محاسبه(root، جعبه سی اس اس.معین(1280.0)، جعبه سی اس اس.معین(800.0))
    سرچاپ "unchanged calls"، t.شمار محاسبه ها()، "measures"، t.شمار سنجش ها()
    t.تنظیم سنجش(leaf، (mi: جعبه سی اس اس.داده‌سنجش): برگشت text_measure(40، mi) پایان)
    t.محاسبه(root، جعبه سی اس اس.معین(1280.0)، جعبه سی اس اس.معین(800.0))
    سرچاپ "one leaf calls"، t.شمار محاسبه ها()، "measures"، t.شمار سنجش ها()
    ll := t.جانمایی گره(leaf)
    سرچاپ "leaf"، ll.ایکس، ll.ایگرگ، ll.پهنای جعبه، ll.بلندی جعبه
    t.صفر کردن شمارنده ها()
    t.محاسبه(root، جعبه سی اس اس.معین(1000.0)، جعبه سی اس اس.معین(800.0))
    سرچاپ "resize calls"، t.شمار محاسبه ها()، "measures"، t.شمار سنجش ها()
    سرچاپ "root"، t.جانمایی گره(root).پهنای جعبه، t.جانمایی گره(root).بلندی جعبه
پایان
