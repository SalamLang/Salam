واردسازی رابط گرافیکی.جعبه سی اس اس

تابع run_list(flex: منطقی، text: منطقی): صحیح:
    ناپایا t := جعبه سی اس اس.درخت {}
    دیرکن t.آزاد کردن()
    body := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(300.0) })
    ناپایا ls := جعبه سی اس اس.سبک { بلندی = جعبه سی اس اس.پیکسل(200.0)، سرریز افقی = جعبه سی اس اس.نوع‌سرریز.پیمایش خودکار، سرریز عمودی = جعبه سی اس اس.نوع‌سرریز.پیمایش خودکار، مرز = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(1.0)) }
    اگر flex:
        ls.نمایش = جعبه سی اس اس.نوع‌نمایش.فلکس
        ls.جهت فلکس = جعبه سی اس اس.نوع‌جهت‌فلکس.ستونی
    پایان
    list := t.افزودن گره(ls)
    t.افزودن فرزند(body، list)
    row := جعبه سی اس اس.سبک { بلندی = جعبه سی اس اس.پیکسل(20.0)، مرز = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.پیکسل(0.0)، جعبه سی اس اس.پیکسل(0.0)، جعبه سی اس اس.پیکسل(1.0)، جعبه سی اس اس.پیکسل(0.0)) }
    تکرار 2000:
        c := t.افزودن گره(row)
        اگر text:
            t.تنظیم سنجش(c، (_mi: جعبه سی اس اس.داده‌سنجش): برگشت جعبه سی اس اس.سنجش شده(100.0، 20.0) پایان)
        پایان
        t.افزودن فرزند(list، c)
    پایان
    t.محاسبه(body، جعبه سی اس اس.معین(300.0)، جعبه سی اس اس.معین(240.0))
    first := t.جانمایی گره(list).بلندی پیمایش
    ناپایا hover := row
    hover.حاشیه درونی = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(0.0))
    t.تنظیم سبک(t.فرزند(list، 1000)، hover)
    t.محاسبه(body، جعبه سی اس اس.معین(300.0)، جعبه سی اس اس.معین(240.0))
    l := t.جانمایی گره(list)
    last := t.جانمایی گره(t.فرزند(list، 1999))
    سرچاپ "flex"، flex، "text"، text، "scroll height"، first، l.بلندی پیمایش، "client"، l.بلندی محتوا، "last row"، last.ایگرگ، last.بلندی جعبه
    برگشت l.بلندی پیمایش برگردان صحیح
پایان

تابع ریشه:
    _a := run_list(نادرست، نادرست)
    _b := run_list(نادرست، درست)
    _c := run_list(درست، نادرست)
    _d := run_list(درست، درست)
پایان
