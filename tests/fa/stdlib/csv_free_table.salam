بسته ریشه

واردسازی کدگذاری.سی اس وی

تابع ریشه:
    تلاش:
        ناپایا جدول := سی اس وی.خواندن همه("name,age\nada,36\ngrace,45\n")
        سرچاپ جدول.ردیف‌ها.طول()، جدول.ردیف‌ها.بگیر(1).خانه‌ها.بگیر(0)، جدول.ردیف‌ها.بگیر(2).خانه‌ها.بگیر(1)
        سی اس وی.آزادسازی جدول(جدول)
        سرچاپ جدول.ردیف‌ها.طول()
        ناپایا دوباره := سی اس وی.خواندن همه("x,y\r\n1,2\r\n")
        سرچاپ سی اس وی.نوشتن همه(دوباره) برابر "x,y\r\n1,2"
        سی اس وی.آزادسازی جدول(دوباره)
        ناپایا جدول خالی := سی اس وی.خواندن همه("")
        سرچاپ جدول خالی.ردیف‌ها.طول()
        سی اس وی.آزادسازی جدول(جدول خالی)
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
پایان
