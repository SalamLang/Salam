بسته ریشه

واردسازی کدگذاری.سی اس وی

تابع ریشه:
    تلاش:
        ناپایا table := سی اس وی.خواندن همه("name,age\nada,36\ngrace,45\n")
        سرچاپ table.ردیف‌ها.طول()، table.ردیف‌ها.بگیر(1).خانه‌ها.بگیر(0)، table.ردیف‌ها.بگیر(2).خانه‌ها.بگیر(1)
        سی اس وی.آزادسازی جدول(table)
        سرچاپ table.ردیف‌ها.طول()
        ناپایا again := سی اس وی.خواندن همه("x,y\r\n1,2\r\n")
        سرچاپ سی اس وی.نوشتن همه(again) برابر "x,y\r\n1,2"
        سی اس وی.آزادسازی جدول(again)
        ناپایا none := سی اس وی.خواندن همه("")
        سرچاپ none.ردیف‌ها.طول()
        سی اس وی.آزادسازی جدول(none)
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
پایان
