بسته ریشه

واردسازی زمینه
واردسازی همگام سازی

تابع ریشه:
    root := زمینه.پس زمینه()
    سرچاپ "root deadline: "، زمینه.موعد(root)

    far := همگام سازی.اکنون میلی ثانیه() + 600000 برگردان صحیح۶۴
    timed := زمینه.با موعد(root، far)
    سرچاپ "deadline kept: "، زمینه.موعد(timed) برابر far
    سرچاپ "deadline done: "، زمینه.تمام شده(timed)
    سرچاپ "deadline err: "، زمینه.خطا(timed)

    child := زمینه.با لغو(timed)
    سرچاپ "inherited: "، زمینه.موعد(child) برابر far

    sooner := زمینه.با موعد(child، far - 1000 برگردان صحیح۶۴)
    سرچاپ "nearest wins: "، زمینه.موعد(sooner) برابر far - 1000 برگردان صحیح۶۴

    past := زمینه.با موعد(root، همگام سازی.اکنون میلی ثانیه() - 10 برگردان صحیح۶۴)
    سرچاپ "past done: "، زمینه.تمام شده(past)
    سرچاپ "past err: "، زمینه.خطا(past)
    سرچاپ "past wait: "، زمینه.انتظار(past، 50 برگردان صحیح۶۴)

    زمینه.لغو(child)
    سرچاپ "cancel done: "، زمینه.تمام شده(child)
    سرچاپ "cancel err: "، زمینه.خطا(child)
    سرچاپ "parent unaffected: "، زمینه.تمام شده(timed)

    زمینه.آزادسازی(past)
    زمینه.آزادسازی(sooner)
    زمینه.آزادسازی(child)
    زمینه.آزادسازی(timed)
    زمینه.آزادسازی(root)
پایان
