بسته ریشه

واردسازی زمینه
واردسازی همگام سازی

تابع ریشه:
    پیشینه := زمینه.پس زمینه()
    سرچاپ "root deadline: "، زمینه.موعد(پیشینه)

    دور := همگام سازی.اکنون میلی ثانیه() + 600000 برگردان صحیح۶۴
    موعددار := زمینه.با موعد(پیشینه، دور)
    سرچاپ "deadline kept: "، زمینه.موعد(موعددار) برابر دور
    سرچاپ "deadline done: "، زمینه.تمام شده(موعددار)
    سرچاپ "deadline err: "، زمینه.خطا(موعددار)

    فرزند := زمینه.با لغو(موعددار)
    سرچاپ "inherited: "، زمینه.موعد(فرزند) برابر دور

    زودتر := زمینه.با موعد(فرزند، دور - 1000 برگردان صحیح۶۴)
    سرچاپ "nearest wins: "، زمینه.موعد(زودتر) برابر دور - 1000 برگردان صحیح۶۴

    گذشته := زمینه.با موعد(پیشینه، همگام سازی.اکنون میلی ثانیه() - 10 برگردان صحیح۶۴)
    سرچاپ "past done: "، زمینه.تمام شده(گذشته)
    سرچاپ "past err: "، زمینه.خطا(گذشته)
    سرچاپ "past wait: "، زمینه.انتظار(گذشته، 50 برگردان صحیح۶۴)

    زمینه.لغو(فرزند)
    سرچاپ "cancel done: "، زمینه.تمام شده(فرزند)
    سرچاپ "cancel err: "، زمینه.خطا(فرزند)
    سرچاپ "parent unaffected: "، زمینه.تمام شده(موعددار)

    زمینه.آزادسازی(گذشته)
    زمینه.آزادسازی(زودتر)
    زمینه.آزادسازی(فرزند)
    زمینه.آزادسازی(موعددار)
    زمینه.آزادسازی(پیشینه)
پایان
