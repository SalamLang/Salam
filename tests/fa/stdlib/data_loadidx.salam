بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی داده
واردسازی کدگذاری.دودویی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    دودویی.نوشتن طبیعی۸(b، 0)
    دودویی.نوشتن طبیعی۸(b، 0)
    دودویی.نوشتن طبیعی۸(b، 8)
    دودویی.نوشتن طبیعی۸(b، 2)
    دودویی.نوشتن طبیعی۳۲ بزرگ‌انتها(b، 3)
    دودویی.نوشتن طبیعی۳۲ بزرگ‌انتها(b، 2)
    تکرار 6 در i:
        دودویی.نوشتن طبیعی۸(b، i * 3)
    پایان
    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_data_loadidx")
    بایگانی.اطمینان از پوشه(پوشه)
    مسیر ساده := مسیر پرونده.پیوند(پوشه، "plain-idx")
    مسیر فشرده := مسیر پرونده.پیوند(پوشه، "packed-idx.gz")
    مسیر ناموجود := مسیر پرونده.پیوند(پوشه، "missing-idx")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(مسیر ساده، b)
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(مسیر فشرده، فشرده سازی.فشرده سازی جی زیپ بافر(b))
    تلاش:
        m := داده.بارگذاری آی‌دی‌ایکس(مسیر ساده)
        سرچاپ m.سطرها، m.ستون‌ها، m.عنصر(0، 0)، m.عنصر(1، 1)، m.عنصر(2، 1)
        g := داده.بارگذاری آی‌دی‌ایکس(مسیر فشرده)
        سرچاپ g.سطرها، g.ستون‌ها، g.عنصر(2، 1)
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    تلاش:
        _ := داده.بارگذاری آی‌دی‌ایکس(مسیر ناموجود)
        سرچاپ "loaded"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.یافت نشد)، e.پیام، e.مسیر برابر مسیر ناموجود
    پایان
    زباله := فشرده سازی.بافر از رشته("not an idx file")
    مسیر نامعتبر := مسیر پرونده.پیوند(پوشه، "bad-idx")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(مسیر نامعتبر، زباله)
    تلاش:
        _ := داده.بارگذاری آی‌دی‌ایکس(مسیر نامعتبر)
        سرچاپ "loaded"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.نحو)، e.کد، e.جایگاه، e.مسیر برابر مسیر نامعتبر
        سرچاپ e.پیام
    پایان
    سیستم عامل.حذف همه(پوشه)
    حافظه.آزادسازی(پوشه برگردان تهی*)
پایان
