بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی داده
واردسازی کدگذاری.دودویی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    دودویی.نوشتن طبیعی۸(b، 0)
    دودویی.نوشتن طبیعی۸(b، 0)
    دودویی.نوشتن طبیعی۸(b، 8)
    دودویی.نوشتن طبیعی۸(b، 2)
    دودویی.نوشتن طبیعی۳۲ بزرگ‌انتها(b، 3)
    دودویی.نوشتن طبیعی۳۲ بزرگ‌انتها(b، 2)
    تکرار 6 در i:
        دودویی.نوشتن طبیعی۸(b، i * 3)
    پایان
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_data_loadidx")
    بایگانی.اطمینان از پوشه(dir)
    plain := مسیر پرونده.پیوند(dir، "plain-idx")
    packed := مسیر پرونده.پیوند(dir، "packed-idx.gz")
    missing := مسیر پرونده.پیوند(dir، "missing-idx")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(plain، b)
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(packed، فشرده سازی.فشرده سازی جی زیپ بافر(b))
    ناپایا ok := نادرست
    m := داده.بارگذاری آی‌دی‌ایکس(plain، ok)
    سرچاپ ok، m.سطرها، m.ستون‌ها، m.عنصر(0، 0)، m.عنصر(1، 1)، m.عنصر(2، 1)
    g := داده.بارگذاری آی‌دی‌ایکس(packed، ok)
    سرچاپ ok، g.سطرها، g.ستون‌ها، g.عنصر(2، 1)
    _ := داده.بارگذاری آی‌دی‌ایکس(missing، ok)
    سرچاپ ok
    junk := فشرده سازی.بافر از رشته("not an idx file")
    bad := مسیر پرونده.پیوند(dir، "bad-idx")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(bad، junk)
    _ := داده.بارگذاری آی‌دی‌ایکس(bad، ok)
    سرچاپ ok
    سیستم عامل.حذف همه(dir)
    حافظه.آزادسازی(dir برگردان تهی*)
پایان
