واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع ریشه:
    d := اس کیو لایت.بازکردن(":memory:")
    c := اس کیو لایت.اتصال(d)

    ناپایا آماده‌سازی := وکتور {} برگردان وکتور<رشته>
    آماده‌سازی.بیفزا("CREATE TABLE t (a INTEGER, b REAL)")
    آماده‌سازی.بیفزا("INSERT INTO t VALUES (9000000000, 1.5)")
    آماده‌سازی.بیفزا("INSERT INTO t VALUES (2, 2.25)")
    سرچاپ دیتابیس.اجرای همه(c، آماده‌سازی)

    ناپایا ناقص := وکتور {} برگردان وکتور<رشته>
    ناقص.بیفزا("INSERT INTO t VALUES (3, 3.0)")
    ناقص.بیفزا("INSERT INTO missing VALUES (1)")
    ناقص.بیفزا("INSERT INTO t VALUES (4, 4.0)")
    سرچاپ دیتابیس.اجرای همه(c، ناقص)

    سرچاپ دیتابیس.پرسمان عدد۶۴(c، "SELECT MAX(a) FROM t")
    سرچاپ دیتابیس.پرسمان عدد۶۴(c، "SELECT a FROM missing")
    سرچاپ دیتابیس.پرسمان اعشار(c، "SELECT SUM(b) FROM t WHERE a < 100")
    سرچاپ دیتابیس.پرسمان اعشار(c، "SELECT b FROM missing")

    سرچاپ دیتابیس.نقل قول("plain")
    سرچاپ دیتابیس.نقل قول("it's")
    سرچاپ دیتابیس.نقل قول("")
    سرچاپ دیتابیس.اجرا کن(c، "INSERT INTO t VALUES (5, " + دیتابیس.نقل قول("7") + ")")

    ناپایا m := دیتابیس.مهاجرت گر در("schema_log")
    دیتابیس.افزودن مهاجرت(m، 1، "users"، "CREATE TABLE users (id INTEGER PRIMARY KEY)"، "DROP TABLE users")
    سرچاپ دیتابیس.ساخت جدول(m، c)
    سرچاپ دیتابیس.پرسمان عدد(c، "SELECT COUNT(*) FROM schema_log")
    سرچاپ دیتابیس.مهاجرت به بالا(m، c)
    سرچاپ دیتابیس.پرسمان عدد(c، "SELECT COUNT(*) FROM schema_log")
    سرچاپ دیتابیس.نسخه طرح‌واره(m، c)
    دیتابیس.آزادکردن مهاجرت گر(m)

    ناپایا p := دیتابیس.استخر جدید(2)
    سرچاپ دیتابیس.افزودن(p، c)
    سرچاپ دیتابیس.اندازه(p)
    دیتابیس.بستن همه(p)
    سرچاپ دیتابیس.اندازه(p)، دیتابیس.بیکار(p)
    دیتابیس.آزادکردن(p)
پایان
