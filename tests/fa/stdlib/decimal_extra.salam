بسته ریشه

واردسازی اعشاری
واردسازی آزمایش

تابع expect(d: اعشاری.اعشاری، want: رشته):
    ناپایا v := d
    آزمایش.ادعای برابری رشته(اعشاری.به رشته(v)، want)
    v.آزادکن()
پایان

تابع ریشه:
    سرچاپ "subtracting a plain integer"
    ناپایا price := اعشاری.تجزیه با پیش فرض("19.99")
    expect(اعشاری.تفریق صحیح(price، 5 برگردان صحیح۶۴)، "14.99")
    expect(اعشاری.تفریق صحیح(price، 0 برگردان صحیح۶۴)، "19.99")
    expect(اعشاری.تفریق صحیح(price، 20 برگردان صحیح۶۴)، "-0.01")
    expect(اعشاری.تفریق صحیح(price، 0 - 1 برگردان صحیح۶۴)، "20.99")
    ناپایا whole := اعشاری.از صحیح(10 برگردان صحیح۶۴)
    expect(اعشاری.تفریق صحیح(whole، 3 برگردان صحیح۶۴)، "7")
    ناپایا tiny := اعشاری.تجزیه با پیش فرض("0.000001")
    expect(اعشاری.تفریق صحیح(tiny، 1 برگردان صحیح۶۴)، "-0.999999")
    ناپایا sub := اعشاری.تفریق صحیح(price، 5 برگردان صحیح۶۴)
    ناپایا again := اعشاری.جمع(sub، اعشاری.از صحیح(5 برگردان صحیح۶۴))
    آزمایش.ادعای درستی(اعشاری.یکسان است(again، price))
    sub.آزادسازی()
    again.آزادسازی()
    price.آزادسازی()
    whole.آزادسازی()
    tiny.آزادسازی()
    برگشت آزمایش.خلاصه()
پایان
