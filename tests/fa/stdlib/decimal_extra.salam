بسته ریشه

واردسازی اعشاری
واردسازی آزمایش

تابع بررسی(d: اعشاری.اعشاری، مورد انتظار: رشته):
    ناپایا v := d
    آزمایش.ادعای برابری رشته(اعشاری.به رشته(v)، مورد انتظار)
    v.آزادکن()
پایان

تابع ریشه:
    سرچاپ "subtracting a plain integer"
    ناپایا قیمت := اعشاری.تجزیه با پیش فرض("19.99")
    بررسی(اعشاری.تفریق صحیح(قیمت، 5 برگردان صحیح۶۴)، "14.99")
    بررسی(اعشاری.تفریق صحیح(قیمت، 0 برگردان صحیح۶۴)، "19.99")
    بررسی(اعشاری.تفریق صحیح(قیمت، 20 برگردان صحیح۶۴)، "-0.01")
    بررسی(اعشاری.تفریق صحیح(قیمت، 0 - 1 برگردان صحیح۶۴)، "20.99")
    ناپایا کامل := اعشاری.از صحیح(10 برگردان صحیح۶۴)
    بررسی(اعشاری.تفریق صحیح(کامل، 3 برگردان صحیح۶۴)، "7")
    ناپایا ریز := اعشاری.تجزیه با پیش فرض("0.000001")
    بررسی(اعشاری.تفریق صحیح(ریز، 1 برگردان صحیح۶۴)، "-0.999999")
    ناپایا تفریق شده := اعشاری.تفریق صحیح(قیمت، 5 برگردان صحیح۶۴)
    ناپایا دوباره := اعشاری.جمع(تفریق شده، اعشاری.از صحیح(5 برگردان صحیح۶۴))
    آزمایش.ادعای درستی(اعشاری.یکسان است(دوباره، قیمت))
    تفریق شده.آزادسازی()
    دوباره.آزادسازی()
    قیمت.آزادسازی()
    کامل.آزادسازی()
    ریز.آزادسازی()
    برگشت آزمایش.خلاصه()
پایان
