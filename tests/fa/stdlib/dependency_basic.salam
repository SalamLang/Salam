// زبان: فارسی
واردسازی وابستگی
واردسازی رشته

ناپایا log := وکتور {} برگردان وکتور<رشته>

میانجی Store:
    تابع Find(id: صحیح): رشته
پایان

ساختار MemStore:
    همگانی tag: رشته = ""
    همگانی تابع Find(id: صحیح): رشته:
        برگشت این.tag + رشته.از عدد(id)
    پایان
پایان

ساختار Service:
    همگانی store: پویا Store = MemStore {}
    همگانی name: رشته = ""
پایان

ساختار Handler:
    همگانی svc: Service = Service {}
پایان

تابع ریشه:
    c := وابستگی.ساخت()
    وابستگی.فراهم کردن(c، "MemStore"، ""، MemStore {}، (_c: وابستگی.ظرف): برگشت MemStore { tag = "row-" } پایان)
    وابستگی.پیوند(c، "Store"، "MemStore")
    وابستگی.فراهم کردن(c، "Service"، "Store"، Service {}، (cx: وابستگی.ظرف):
        ناپایا s := MemStore {}
        _ok := وابستگی.گرفتن(cx، "MemStore"، s)
        برگشت Service { store = s، name = "svc" }
    پایان)
    وابستگی.فراهم کردن(c، "Handler"، "Service"، Handler {}، (cx: وابستگی.ظرف):
        ناپایا s := Service {}
        _ok := وابستگی.گرفتن(cx، "Service"، s)
        برگشت Handler { svc = s }
    پایان)
    وابستگی.هنگام بستن(c، "MemStore"، MemStore {}، (m: MemStore): log.بیفزا("close store " + m.tag) پایان)
    وابستگی.هنگام بستن(c، "Service"، Service {}، (s: Service): log.بیفزا("close service " + s.name) پایان)
    err := وابستگی.ساختن گراف(c)
    سرچاپ "build:"، err برابر "" ? "ok" : err
    ناپایا h := Handler {}
    سرچاپ وابستگی.گرفتن(c، "Handler"، h)
    سرچاپ h.svc.name، h.svc.store.Find(7)
    order := وابستگی.ساخته شده(c)
    دیرکن order.آزادکن()
    هر n در order:
        سرچاپ "built"، n
    پایان
    وابستگی.بستن(c)
    هر l در log:
        سرچاپ l
    پایان
    log.آزادکن()

    bad := وابستگی.ساخت()
    وابستگی.فراهم کردن(bad، "A"، "B"، Service {}، (_c: وابستگی.ظرف): برگشت Service {} پایان)
    سرچاپ وابستگی.ساختن گراف(bad)
    وابستگی.بستن(bad)

    cyc := وابستگی.ساخت()
    وابستگی.فراهم کردن(cyc، "A"، "B"، Service {}، (_c: وابستگی.ظرف): برگشت Service {} پایان)
    وابستگی.فراهم کردن(cyc، "B"، "A"، Service {}، (_c: وابستگی.ظرف): برگشت Service {} پایان)
    سرچاپ وابستگی.ساختن گراف(cyc)
    وابستگی.بستن(cyc)

    dup := وابستگی.ساخت()
    وابستگی.مقدار(dup، "N"، 1)
    وابستگی.مقدار(dup، "N"، 2)
    سرچاپ وابستگی.ساختن گراف(dup)
    وابستگی.بستن(dup)
پایان
