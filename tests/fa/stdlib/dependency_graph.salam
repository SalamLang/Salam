// زبان: فارسی
واردسازی وابستگی
واردسازی رشته

ساختار Cfg:
    همگانی dsn: رشته = ""
    همگانی n: صحیح = 0
پایان

تابع level_name(i: صحیح): رشته:
    برگشت "L" + رشته.از عدد(i)
پایان

تابع ریشه:
    c := وابستگی.ساخت()
    وابستگی.مقدار(c، "Cfg"، Cfg { dsn = "db://x"، n = 5 })
    ناپایا cfg := Cfg {}
    سرچاپ وابستگی.گرفتن(c، "Cfg"، cfg)، cfg.dsn، cfg.n
    سرچاپ وابستگی.گرفتن(c، "Nope"، cfg)، وابستگی.خطا(c)
    سرچاپ وابستگی.تعداد(c)
    وابستگی.بستن(c)

    deep := وابستگی.ساخت()
    وابستگی.مقدار(deep، "L0"، 1)
    تکرار 1 تا 200 در i:
        prev := level_name(i - 1)
        وابستگی.فراهم کردن(deep، level_name(i)، prev، 0، (cx: وابستگی.ظرف):
            ناپایا v := 0
            _ok := وابستگی.گرفتن(cx، prev، v)
            برگشت v + 1
        پایان)
    پایان
    سرچاپ وابستگی.ساختن گراف(deep) برابر "" ? "sound" : "broken"
    ناپایا top := 0
    سرچاپ وابستگی.گرفتن(deep، "L200"، top)، top
    built := وابستگی.ساخته شده(deep)
    سرچاپ built.طول()، built.بگیر(0)، built.بگیر(200)
    built.آزادکن()
    وابستگی.بستن(deep)

    loop := وابستگی.ساخت()
    وابستگی.فراهم کردن(loop، "X"، ""، 0، (cx: وابستگی.ظرف):
        ناپایا v := 0
        _ok := وابستگی.گرفتن(cx، "X"، v)
        برگشت v
    پایان)
    ناپایا x := 0
    سرچاپ وابستگی.گرفتن(loop، "X"، x)، وابستگی.خطا(loop)
    وابستگی.بستن(loop)

    self := وابستگی.ساخت()
    وابستگی.فراهم کردن(self، "S"، "S"، 0، (_c: وابستگی.ظرف): برگشت 1 پایان)
    سرچاپ وابستگی.ساختن گراف(self)
    وابستگی.بستن(self)
پایان
