واردسازی سازنده‌ها
واردسازی سیستم عامل
واردسازی رشته

تابع بررسی(نام: رشته، گوود: منطقی):
    اگر گوود:
        سرچاپ "PASS " + نام
    وگرنه:
        سرچاپ "FAIL " + نام
    پایان
پایان

تابع دارد(متن: رشته، پییکی: رشته): منطقی:
    برگشت متن.بیاب(پییکی) بزرگتربرابر 0
پایان

تابع ریشه:
    باسی := سیستم عامل.پوشه موقت() + "/salam_design_cfg_" + رشته.از عدد(سیستم عامل.شناسه فرآیند())
    سیستم عامل.ساخت پوشه(باسی)
    سیستم عامل.ساخت پوشه(باسی + "/site")
    سیستم عامل.ساخت پوشه(باسی + "/site/pages")
    سیستم عامل.نوشتن پرونده(
        باسی + "/site/design.toml"،
        "palette = \"brand\"\ntheme = \"dark\"\nfont-sans = \"Inter, sans-serif\"\nfont-url = \"https://fonts.googleapis.com/css2?family=Inter:wght@400;700\"\nfont-face = \"Brand+Sans /f/b.woff2 400 700\"\n\n[tokens]\ndark-ring = \"red\"\n\n[palette.brand]\nbase = \"zinc\"\nprimary = \"oklch(0.6 0.2 260)\"\ndark-primary = \"oklch(0.7 0.15 260)\"\n"
    )
    سیستم عامل.تغییر پوشه(باسی + "/site/pages")
    ناپایا پگ := سازنده‌ها.گره {}
    پگ.name = "page"
    پگ.attrs = " data-tokens=\"radius: 2rem\""
    ر1 := سازنده‌ها.طراحی صفحه(پگ)
    بررسی("custom palette primary"، دارد(ر1.shared_css، "--primary:light-dark(oklch(0.6 0.2 260),oklch(0.7 0.15 260));"))
    بررسی("base palette used"، دارد(ر1.shared_css، "--background:light-dark(oklch(1 0 0),oklch(0.141 0.005 285.823))"))
    بررسی("page token wins"، دارد(ر1.shared_css، "--radius:2rem;"))
    بررسی("config token"، دارد(ر1.shared_css، "oklch(0.705 0.015 286.067),red"))
    بررسی("config font"، دارد(ر1.shared_css، "--ds-font-sans:Inter, sans-serif"))
    بررسی("config theme"، دارد(ر1.shared_css، ":root:not([data-theme]){color-scheme:dark}"))
    بررسی("font face"، دارد(ر1.shared_css، "@font-face{font-family:\"Brand Sans\";src:url(\"/f/b.woff2\") format(\"woff2\");font-weight:400 700;font-style:normal;font-display:swap}"))
    بررسی("font link"، دارد(ر1.head، "<link rel=\"stylesheet\" href=\"https://fonts.googleapis.com/css2?family=Inter:wght@400;700\">"))
    بررسی("preconnect"، دارد(ر1.head، "https://fonts.gstatic.com"))
    پگ.attrs = " data-tokens=\"font-sans: Georgia, serif\""
    ر4 := سازنده‌ها.طراحی صفحه(پگ)
    بررسی("page font wins"، دارد(ر4.shared_css، "--ds-font-sans:Georgia, serif") و وارونه دارد(ر4.shared_css، "Inter, sans-serif"))
    پگ.attrs = " data-palette=\"zinc\" data-design=\"none\""
    ر2 := سازنده‌ها.طراحی صفحه(پگ)
    بررسی("page design none wins"، ر2.shared_css.بیاب("--primary") کوچکتر 0)
    پگ.attrs = " data-tokens=\"primry: red\""
    ر3 := سازنده‌ها.طراحی صفحه(پگ)
    بررسی("unknown token warns"، دارد(ر3.head، "salam-design-warning") و دارد(ر3.head، "unknown design token &#39;primry&#39;"))
    سیستم عامل.تغییر پوشه("/")
    سیستم عامل.حذف(باسی + "/site/design.toml")
    سیستم عامل.حذف پوشه(باسی + "/site/pages")
    سیستم عامل.حذف پوشه(باسی + "/site")
    سیستم عامل.حذف پوشه(باسی)
    کونف := سازنده‌ها.خواندن پیکربندی طراحی("[package]\nname = \"x\"\n\n[design]\nthemes = \"dark\" # comment\n[deps]\nz = 1\n[design.palette.a]\nbase = \"slate\"\n"، نادرست)
    بررسی("salam.toml design only"، وارونه دارد(کونف، "package") و وارونه دارد(کونف، "deps"))
    بررسی("salam.toml value"، سازنده‌ها.مقدار پیکربندی طراحی(سازنده‌ها.بخش پیکربندی طراحی(کونف، "design")، "themes") برابر "dark")
    بررسی("salam.toml palette"، سازنده‌ها.مقدار پیکربندی طراحی(سازنده‌ها.بخش پیکربندی طراحی(کونف، "design.palette.a")، "base") برابر "slate")
پایان
