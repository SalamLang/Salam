// زبان: فارسی
واردسازی متن.تفاوت

تابع show(lines: وکتور<رشته>):
    هر line در lines:
        سرچاپ line
    پایان
پایان

تابع ریشه:
    old := "one\ntwo\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\n"
    fresh := "one\n2\nthree\nfour\nfive\nsix\nseven\neight\nnine\nten\neleven\n"

    a := تفاوت.خط ها(old)
    b := تفاوت.خط ها(fresh)
    دیرکن a.آزادکن()
    دیرکن b.آزادکن()
    سرچاپ "lines"، a.طول()، b.طول()

    سرچاپ "context 1"
    one := تفاوت.تفاوت یکپارچه(a، b، "old.txt"، "new.txt"، 1)
    show(one)
    one.آزادکن()

    سرچاپ "context 0"
    none := تفاوت.تفاوت یکپارچه(a، b، "old.txt"، "new.txt"، 0)
    show(none)
    none.آزادکن()

    چاپ "text form:\n" + تفاوت.تفاوت یکپارچه متن(old، fresh، "a"، "b"، 3)
    سرچاپ "same text:"، تفاوت.تفاوت یکپارچه متن(old، old، "a"، "b"، 3).طول()

    ops := تفاوت.دستورهای ویرایش(a، b)
    هر op در ops:
        سرچاپ op.نوع، op.آغاز الف، op.انتهای الف، op.آغاز ب، op.انتهای ب
    پایان
    ops.آزادکن()

    سرچاپ تفاوت.همسان، تفاوت.جایگزین، تفاوت.حذف شده، تفاوت.افزوده

    سرچاپ تفاوت.نسبت شباهت(a، b)
    سرچاپ تفاوت.نسبت شباهت متن("abcd"، "bcde")
    سرچاپ تفاوت.نسبت شباهت متن(""، "")، تفاوت.نسبت شباهت متن("abc"، "xyz")، تفاوت.نسبت شباهت متن("same"، "same")

    groups := تفاوت.دستورهای ویرایش گروه بندی شده(a، b، 1)
    سرچاپ "groups"، groups.طول()
    هر g در groups:
        g.آزادکن()
    پایان
    groups.آزادکن()

    x := تفاوت.خط ها("a\r\nb\r\n")
    سرچاپ x.طول()، x.بگیر(0) + "|" + x.بگیر(1) + "|"
    x.آزادکن()
پایان
