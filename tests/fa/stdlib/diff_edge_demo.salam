// زبان: فارسی
واردسازی متن.تفاوت
واردسازی رشته


تابع نام نوع(ن: صحیح): رشته:
    ترابرد ن:
        تفاوت.همسان:
            برگشت "equal"
        پایان
        تفاوت.جایگزین:
            برگشت "replace"
        پایان
        تفاوت.حذف شده:
            برگشت "delete"
        پایان
        وگرنه:
            برگشت "insert"
        پایان
    پایان
پایان

تابع خط دستورها(الف۱: وکتور<رشته>، ب۱: وکتور<رشته>): رشته:
    دستورها := تفاوت.دستورهای ویرایش(الف۱، ب۱)
    ناپایا خروجی := ""
    هر دستور در دستورها:
        خروجی = خروجی + نام نوع(دستور.نوع) + "[" + رشته.از عدد(دستور.آغاز الف برگردان صحیح۶۴) + ":" + رشته.از عدد(دستور.انتهای الف برگردان صحیح۶۴) + "," + رشته.از عدد(دستور.آغاز ب برگردان صحیح۶۴) + ":" + رشته.از عدد(دستور.انتهای ب برگردان صحیح۶۴) + "] "
    پایان
    دستورها.آزادکن()
    برگشت خروجی
پایان

تابع شماره دار(تعداد: صحیح، رد: صحیح، واژه: رشته): رشته:
    ناپایا خروجی := ""
    تکرار تعداد در ا:
        اگر ا برابر رد:
            خروجی = خروجی + واژه + "\n"
        وگرنه:
            خروجی = خروجی + "line " + رشته.از عدد(ا برگردان صحیح۶۴) + "\n"
        پایان
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    خالی := تفاوت.خط ها("")
    یک := تفاوت.خط ها("a")
    خط تنها := تفاوت.خط ها("\n")
    دو := تفاوت.خط ها("a\nb")
    ویندوزی := تفاوت.خط ها("a\r\nb\r\n\r\n")
    سرچاپ خالی.طول()، یک.طول()، خط تنها.طول()، دو.طول()، ویندوزی.طول()
    سرچاپ "[" + خط تنها.بگیر(0) + "]"، "[" + ویندوزی.بگیر(2) + "]"

    سرچاپ "empty vs empty:"، خط دستورها(خالی، خالی)
    سرچاپ "empty vs two:"، خط دستورها(خالی، دو)
    سرچاپ "two vs empty:"، خط دستورها(دو، خالی)
    سرچاپ "same:"، خط دستورها(دو، دو)
    الف := تفاوت.خط ها("a\nb\nc")
    ب := تفاوت.خط ها("x\ny\nz")
    سرچاپ "all different:"، خط دستورها(الف، ب)
    پ := تفاوت.خط ها("a\nb\nc\nd")
    ت := تفاوت.خط ها("a\nc\nd\ne")
    سرچاپ "mixed:"، خط دستورها(پ، ت)

    سرچاپ "unified empty:"، تفاوت.تفاوت یکپارچه(خالی، خالی، "a"، "b"، 3).طول()
    سرچاپ "unified same:"، تفاوت.تفاوت یکپارچه(دو، دو، "a"، "b"، 3).طول()
    چاپ تفاوت.تفاوت یکپارچه متن(""، "new\n"، "a"، "b"، 3)
    چاپ تفاوت.تفاوت یکپارچه متن("old\n"، ""، "a"، "b"، 3)
    چاپ تفاوت.تفاوت یکپارچه متن("a\r\nb\r\n"، "a\nb\n"، "a"، "b"، 3).طول()
    سرچاپ ""
    چاپ تفاوت.تفاوت یکپارچه متن("a\nb"، "a\nc"، ""، ""، 0)
    چاپ تفاوت.تفاوت یکپارچه متن("a\nb\nc"، "a\nb\nc\nd"، "one"، "two"، 100)
    چاپ تفاوت.تفاوت یکپارچه متن("a\nb\nc"، "a\nb\nc\nd"، "one"، "two"، 0 - 5)

    قدیمی := "سلام\nدنیا\nخداحافظ\n"
    تازه := "سلام\nجهان\nخداحافظ\n"
    چاپ تفاوت.تفاوت یکپارچه متن(قدیمی، تازه، "قدیم"، "جدید"، 1)
    سرچاپ تفاوت.نسبت شباهت متن("سلام"، "سلام")، تفاوت.نسبت شباهت متن("سلام"، "سلامت")، تفاوت.نسبت شباهت متن("ab"، "")

    سرچاپ تفاوت.نسبت شباهت(خالی، خالی)، تفاوت.نسبت شباهت(خالی، دو)، تفاوت.نسبت شباهت(دو، دو)، تفاوت.نسبت شباهت(الف، ب)

    بزرگ الف := تفاوت.خط ها(شماره دار(20000، 0 - 1، ""))
    بزرگ ب := تفاوت.خط ها(شماره دار(20000، 10000، "changed"))
    بزرگ := تفاوت.تفاوت یکپارچه(بزرگ الف، بزرگ ب، "a"، "b"، 2)
    سرچاپ "big:"، بزرگ الف.طول()، بزرگ.طول()
    هر خ در بزرگ:
        سرچاپ خ
    پایان

    گروه ها := تفاوت.دستورهای ویرایش گروه بندی شده(بزرگ الف، بزرگ ب، 3)
    سرچاپ "big groups:"، گروه ها.طول()، گروه ها.بگیر(0).طول()
    هر گ در گروه ها:
        گ.آزادکن()
    پایان
    گروه ها.آزادکن()
    گروه های یکسان := تفاوت.دستورهای ویرایش گروه بندی شده(دو، دو، 3)
    سرچاپ "equal groups:"، گروه های یکسان.طول()
    گروه های یکسان.آزادکن()
    هیچ := تفاوت.دستورهای ویرایش گروه بندی شده(خالی، خالی، 3)
    سرچاپ "empty groups:"، هیچ.طول()
    هیچ.آزادکن()
    بزرگ.آزادکن()
    بزرگ الف.آزادکن()
    بزرگ ب.آزادکن()
    خالی.آزادکن()
    یک.آزادکن()
    خط تنها.آزادکن()
    دو.آزادکن()
    ویندوزی.آزادکن()
    الف.آزادکن()
    ب.آزادکن()
    پ.آزادکن()
    ت.آزادکن()
پایان
