واردسازی سیستم عامل.بارگذاری کتابخانه

تابع ریشه:
    سرچاپ "supported:"، بارگذاری کتابخانه.پشتیبانی می شود()
    اگر وارونه بارگذاری کتابخانه.پشتیبانی می شود():
        برگشت
    پایان
    lib := بارگذاری کتابخانه.باز کردن برنامه()
    دیرکن بارگذاری کتابخانه.بستن(lib)
    ناپایا m := lib
    اگر سلام سیستم لینوکس:
        m = بارگذاری کتابخانه.باز کردن("libm.so.6")
    پایان
    none := [0 برگردان اندازه]
    سرچاپ "pow:"، بارگذاری کتابخانه.فراخوانی ترکیبی اعشار(بارگذاری کتابخانه.نماد(m، "pow")، none[: 0]، [2.0، 10.0])
    سرچاپ "hypot:"، بارگذاری کتابخانه.فراخوانی ترکیبی اعشار(بارگذاری کتابخانه.نماد(m، "hypot")، none[: 0]، [3.0، 4.0])
    سرچاپ "ldexp:"، بارگذاری کتابخانه.فراخوانی ترکیبی اعشار(بارگذاری کتابخانه.نماد(m، "ldexp")، [3 برگردان اندازه]، [1.5])
    سرچاپ "lround:"، بارگذاری کتابخانه.فراخوانی ترکیبی(بارگذاری کتابخانه.نماد(m، "lround")، none[: 0]، [2.6])
    سرچاپ "labs:"، بارگذاری کتابخانه.فراخوانی ترکیبی(بارگذاری کتابخانه.نماد(lib، "labs")، [(0 - 7) برگردان اندازه]، [0.0])
    سرچاپ "null:"، بارگذاری کتابخانه.فراخوانی ترکیبی(پوچ، none[: 0]، [1.0])، بارگذاری کتابخانه.فراخوانی ترکیبی اعشار(پوچ، none[: 0]، [1.0])
    سرچاپ "too many:"، بارگذاری کتابخانه.فراخوانی ترکیبی(بارگذاری کتابخانه.نماد(lib، "labs")، [1 برگردان اندازه، 2، 3، 4، 5، 6، 7]، [0.0])
پایان
