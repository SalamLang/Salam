واردسازی حافظه
واردسازی فشرده سازی
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی
واردسازی همگام سازی
واردسازی تی ال اس

ناپایا port := 0
ناپایا plain_conns := 0
ناپایا h2_conns := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع rec(name: رشته، rtype: صحیح، ttl: صحیح، data: رشته): دی‌ان‌اس.رکورد:
    برگشت دی‌ان‌اس.رکورد { نام دامنه = name، نوع رکورد = rtype، رده = 1، زمان ماندگاری = ttl، داده = data }
پایان

تابع refuse_http1(sec &: تی ال اس.اتصال):
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    _n := تی ال اس.خواندن بایت(sec، buf، 4096)
    reply := "HTTP/1.1 505 HTTP Version Not Supported\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
    _w := تی ال اس.نوشتن بایت(sec، reply برگردان تهی*، reply.طول())
    حافظه.آزادسازی(buf)
    تی ال اس.بستن اتصال(sec)
پایان

تابع answer_h2(sec &: تی ال اس.اتصال):
    ناپایا c := اچ تی تی پی۲.اتصال جدید(اچ تی تی پی۲.ترابری امن(sec)، درست)
    اگر وارونه اچ تی تی پی۲.دست‌دهی سرور(c):
        برگشت
    پایان
    ناپایا n := 0
    تا n کوچکتر 40:
        s := اچ تی تی پی۲.جریان با شناسه(c، 1)
        اگر s.مشغول و s.انتهای جریان:
            بشکن
        پایان
        اگر اچ تی تی پی۲.دریافت رویداد(c) برابر اچ تی تی پی۲.نتیجه خطا:
            برگشت
        پایان
        n++
    پایان
    s := اچ تی تی پی۲.جریان با شناسه(c، 1)
    q := دی‌ان‌اس.کدگشایی(s.بدنه.داده، s.بدنه.طول)
    qn := q.پرسش‌ها.پرسش‌ها.بگیر(0)
    ناپایا recs := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    recs.بیفزا(rec(qn.نام دامنه، دی‌ان‌اس.نوع آ، 60، "10.9.8.7"))
    ناپایا out := دی‌اوه‌اچ.کدگذاری پاسخ(q.شناسه، qn.نام دامنه، qn.نوع رکورد، 0، recs)
    recs.آزادکن()
    ناپایا hl := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(hl، ":status"، "200")
    اچ تی تی پی۲.افزودن سرآیند(hl، "content-type"، "application/dns-message")
    _a := اچ تی تی پی۲.ارسال سرآیندها(c، 1، hl، نادرست)
    _b := اچ تی تی پی۲.ارسال داده(c، 1، out، درست)
    فشرده سازی.آزادسازی بافر(out)
    اچ تی تی پی۲.انتظار اتمام جریان(c، 1، 4)
    اچ تی تی پی۲.بستن اتصال(c)
پایان

تابع server():
    cfg := تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    l := تی سی پی.پیوند(0)
    port = تی سی پی.درگاه(l)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(l)
        ناپایا sec := تی ال اس.پوشش کارساز(c.توصیفگر، cfg)
        اگر وارونه تی ال اس.اتصال معتبر(sec):
            گذر
        پایان
        اگر plain_conns برابر 0:
            plain_conns++
            refuse_http1(sec)
        وگرنه:
            h2_conns++
            answer_h2(sec)
        پایان
    پایان
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
    ناپایا s := دی‌اوه‌اچ.کارگزار جدید("local"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ پست، "https://localhost:" + port + "/dns-query")
    s.ناامن = درست
    s.نشانی‌های راه‌انداز.بیفزا("127.0.0.1")
    r1 := دی‌اوه‌اچ.پرسش(s، "one.test"، دی‌ان‌اس.نوع آ، 5000)
    سرچاپ "first query after a 505:"، r1.معتبر، r1.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده
    r2 := دی‌اوه‌اچ.پرسش(s، "two.test"، دی‌ان‌اس.نوع آ، 5000)
    سرچاپ "next query goes straight to h2:"، r2.معتبر، r2.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده
    سرچاپ "http/1.1 attempts"، plain_conns، "h2 connections"، h2_conns
پایان
