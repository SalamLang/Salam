واردسازی حافظه
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا http_port := 0
ناپایا served := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع reply(c: تی سی پی.اتصال شبکه، text: رشته):
    _w := تی سی پی.نوشتن بایت(c، text برگردان تهی*، text.طول())
پایان

تابع flood(c: تی سی پی.اتصال شبکه):
    chunk := حافظه.تخصیص صفرشده(65536 برگردان طبیعی۶۴)
    reply(c، "HTTP/1.1 200 OK\r\nContent-Length: 99999999\r\n\r\n")
    ناپایا sent := 0
    تا sent کوچکتر 6000000:
        w := تی سی پی.نوشتن بایت(c، chunk، 65536)
        اگر w کوچکتربرابر 0:
            بشکن
        پایان
        sent += w
    پایان
    حافظه.آزادسازی(chunk)
پایان

تابع serve_conn(c: تی سی پی.اتصال شبکه):
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    n := تی سی پی.خواندن بایت(c، buf، 4096)
    حافظه.آزادسازی(buf)
    اگر n بزرگتر 0:
        served++
        اگر served برابر 1:
            reply(c، "HTTP/1.1 200 OK\r\nContent-Length: -5\r\n\r\nabcdefghijkl")
        وگرنه served برابر 2:
            reply(c، "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\nfffffffffffffff\r\nabc\r\n0\r\n\r\n")
        وگرنه served برابر 3:
            reply(c، "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n80000000\r\nabc\r\n0\r\n\r\n")
        وگرنه:
            flood(c)
        پایان
    پایان
    تی سی پی.بستن(c)
پایان

تابع http_server():
    srv := تی سی پی.پیوند(0)
    http_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        serve_conn(c)
    پایان
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(http_server)
    همگام سازی.انتظار(ready)
    s := دی‌اوه‌اچ.کارگزار جدید("hostile"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ پست، "http://127.0.0.1:" + http_port + "/dns-query")
    r1 := دی‌اوه‌اچ.پرسش(s، "one.test"، دی‌ان‌اس.نوع آ، 3000)
    سرچاپ "negative content-length"، r1.معتبر، r1.خطا
    r2 := دی‌اوه‌اچ.پرسش(s، "two.test"، دی‌ان‌اس.نوع آ، 3000)
    سرچاپ "oversized chunk"، r2.معتبر، r2.خطا
    r3 := دی‌اوه‌اچ.پرسش(s، "three.test"، دی‌ان‌اس.نوع آ، 3000)
    سرچاپ "wrapping chunk size"، r3.معتبر، r3.خطا
    r4 := دی‌اوه‌اچ.پرسش(s، "four.test"، دی‌ان‌اس.نوع آ، 8000)
    سرچاپ "endless body"، r4.معتبر، r4.خطا
    دی‌اوه‌اچ.بستن اتصال‌های بی‌کار()
پایان
