واردسازی حافظه
واردسازی رشته
واردسازی فشرده سازی
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا http_port := 0
ناپایا accepts := 0
ناپایا requests := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع rec(name: رشته، rtype: صحیح، ttl: صحیح، data: رشته): دی‌ان‌اس.رکورد:
    برگشت دی‌ان‌اس.رکورد { نام دامنه = name، نوع رکورد = rtype، رده = 1، زمان ماندگاری = ttl، داده = data }
پایان

تابع head_end(p: تهی*، n: صحیح): صحیح:
    b := p برگردان طبیعی۸*
    ناپایا i := 0
    تا i + 4 کوچکتربرابر n:
        اگر b[i] برابر 13 و b[i + 1] برابر 10 و b[i + 2] برابر 13 و b[i + 3] برابر 10:
            برگشت i
        پایان
        i++
    پایان
    برگشت 0 - 1
پایان

تابع serve_conn(c: تی سی پی.اتصال شبکه):
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    تا درست:
        n := تی سی پی.خواندن بایت(c، buf، 4096)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        he := head_end(buf، n)
        اگر he کوچکتر 0:
            بشکن
        پایان
        requests++
        wire := ((buf برگردان صحیح۶۴) + (he برگردان صحیح۶۴) + 4) برگردان تهی*
        q := دی‌ان‌اس.کدگشایی(wire، n - he - 4)
        qn := q.پرسش‌ها.پرسش‌ها.بگیر(0)
        ناپایا recs := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
        recs.بیفزا(rec(qn.نام دامنه، دی‌ان‌اس.نوع آ، 60، "10.0.0.7"))
        ناپایا out := دی‌اوه‌اچ.کدگذاری پاسخ(q.شناسه، qn.نام دامنه، qn.نوع رکورد، 0، recs)
        recs.آزادکن()
        head := "HTTP/1.1 200 OK\r\nContent-Type: application/dns-message\r\nContent-Length: " + رشته.از عدد(out.طول برگردان صحیح۶۴) + "\r\n\r\n"
        _a := تی سی پی.نوشتن بایت(c، head برگردان تهی*، head.طول())
        _b := تی سی پی.نوشتن بایت(c، out.داده، out.طول)
        فشرده سازی.آزادسازی بافر(out)
    پایان
    حافظه.آزادسازی(buf)
    تی سی پی.بستن(c)
پایان

تابع http_server():
    srv := تی سی پی.پیوند(0)
    http_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        accepts++
        serve_conn(c)
    پایان
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(http_server)
    همگام سازی.انتظار(ready)

    s := دی‌اوه‌اچ.کارگزار جدید("local"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ پست، "http://127.0.0.1:" + http_port + "/dns-query")
    r1 := دی‌اوه‌اچ.پرسش(s، "one.test"، دی‌ان‌اس.نوع آ، 3000)
    سرچاپ r1.معتبر، r1.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده
    r2 := دی‌اوه‌اچ.پرسش(s، "two.test"، دی‌ان‌اس.نوع آ، 3000)
    سرچاپ r2.معتبر، r2.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده
    r3 := دی‌اوه‌اچ.پرسش(s، "three.test"، دی‌ان‌اس.نوع آ، 3000)
    سرچاپ r3.معتبر
    سرچاپ "accepts"، accepts، "requests"، requests، "reused"، دی‌اوه‌اچ.اتصال‌های بازاستفاده‌شده()
    دی‌اوه‌اچ.بستن اتصال‌های بی‌کار()
    r4 := دی‌اوه‌اچ.پرسش(s، "four.test"، دی‌ان‌اس.نوع آ، 3000)
    سرچاپ r4.معتبر، "accepts"، accepts، "reused"، دی‌اوه‌اچ.اتصال‌های بازاستفاده‌شده()
    دی‌اوه‌اچ.بستن اتصال‌های بی‌کار()

    ناپایا one := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    one.بیفزا(s)
    rs := دی‌اوه‌اچ.حل‌کننده جدید(one)
    stub := دی‌اوه‌اچ.راه‌اندازی کارگزار محلی(rs، ""، 0)
    سرچاپ "stub"، stub.معتبر، stub.میزبان، stub.تی سی پی فعال
    c := تی سی پی.شماره گیری("127.0.0.1"، stub.درگاه)
    سرچاپ تی سی پی.اتصال معتبر(c)
    ناپایا i := 0
    تا i کوچکتر 2:
        qw := دی‌ان‌اس.کدگذاری پرسش("tcp" + i + ".test"، دی‌ان‌اس.نوع آ، 100 + i)
        hdr := حافظه.تخصیص(2 برگردان طبیعی۶۴)
        (hdr برگردان طبیعی۸*)[0] = ((qw.طول >> 8) & 255) برگردان طبیعی۸
        (hdr برگردان طبیعی۸*)[1] = (qw.طول & 255) برگردان طبیعی۸
        _w1 := تی سی پی.نوشتن بایت(c، hdr، 2)
        _w2 := تی سی پی.نوشتن بایت(c، qw.داده، qw.طول)
        rb := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
        _r1 := تی سی پی.خواندن بایت(c، rb، 2)
        want := ((rb برگردان طبیعی۸*)[0] برگردان صحیح) * 256 + ((rb برگردان طبیعی۸*)[1] برگردان صحیح)
        ناپایا got := 0
        تا got کوچکتر want:
            k := تی سی پی.خواندن بایت(c، ((rb برگردان صحیح۶۴) + (got برگردان صحیح۶۴)) برگردان تهی*، want - got)
            اگر k کوچکتربرابر 0:
                بشکن
            پایان
            got += k
        پایان
        sm := دی‌ان‌اس.کدگشایی(rb، got)
        سرچاپ "tcp answer"، sm.شناسه، sm.کد نتیجه، sm.پاسخ‌ها.رکوردها.بگیر(0).داده
        حافظه.آزادسازی(rb)
        حافظه.آزادسازی(hdr)
        i++
    پایان
    تی سی پی.بستن(c)
    سرچاپ دی‌اوه‌اچ.شمار پاسخ‌های کارگزار محلی(stub)
    دی‌اوه‌اچ.توقف کارگزار محلی(stub)
پایان
