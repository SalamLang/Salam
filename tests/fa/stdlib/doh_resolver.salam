واردسازی حافظه
واردسازی رشته
واردسازی فشرده سازی
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.تی سی پی
واردسازی شبکه.یو دی پی
واردسازی همگام سازی
واردسازی تی ال اس

ناپایا http_port := 0
ناپایا tls_port := 0
ناپایا dot_port := 0
ناپایا udp_port := 0
ناپایا queries := 0
ناپایا last_method := ""
ناپایا chunked := نادرست
ناپایا ready := همگام سازی.گروه انتظار جدید()

ساختار MIo:
    همگانی use_tls: منطقی = نادرست
    همگانی tc: تی سی پی.اتصال شبکه = تی سی پی.اتصال شبکه {}
    همگانی sc: تی ال اس.اتصال = تی ال اس.اتصال {}
پایان

تابع io_read(io &: MIo، buf: تهی*، max: صحیح): صحیح:
    اگر io.use_tls:
        برگشت تی ال اس.خواندن بایت(io.sc، buf، max)
    پایان
    برگشت تی سی پی.خواندن بایت(io.tc، buf، max)
پایان

تابع io_write(io &: MIo، p: تهی*، n: صحیح): منطقی:
    اگر io.use_tls:
        برگشت تی ال اس.نوشتن بایت(io.sc، p، n) برابر n
    پایان
    برگشت تی سی پی.نوشتن بایت(io.tc، p، n) برابر n
پایان

تابع io_close(io &: MIo):
    اگر io.use_tls:
        تی ال اس.بستن اتصال(io.sc)
    وگرنه:
        تی سی پی.بستن(io.tc)
    پایان
پایان

تابع rec(name: رشته، rtype: صحیح، ttl: صحیح، data: رشته): دی‌ان‌اس.رکورد:
    برگشت دی‌ان‌اس.رکورد { نام دامنه = name، نوع رکورد = rtype، رده = 1، زمان ماندگاری = ttl، داده = data }
پایان

تابع answer_for(p: تهی*، n: صحیح): فشرده سازی.بافر بایت:
    queries++
    q := دی‌ان‌اس.کدگشایی(p، n)
    qn := q.پرسش‌ها.پرسش‌ها.بگیر(0)
    ناپایا recs := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    ناپایا rcode := 0
    اگر qn.نام دامنه برابر "a.test" و qn.نوع رکورد برابر دی‌ان‌اس.نوع آ:
        recs.بیفزا(rec("a.test"، دی‌ان‌اس.نوع آ، 120، "10.0.0.1"))
        recs.بیفزا(rec("a.test"، دی‌ان‌اس.نوع آ، 300، "10.0.0.2"))
    وگرنه qn.نام دامنه برابر "v6.test" و qn.نوع رکورد برابر دی‌ان‌اس.نوع کواداِی:
        recs.بیفزا(rec("v6.test"، دی‌ان‌اس.نوع کواداِی، 300، "2001:db8::5"))
    وگرنه qn.نام دامنه برابر "txt.test" و qn.نوع رکورد برابر دی‌ان‌اس.نوع تی‌ایکس‌تی:
        recs.بیفزا(rec("txt.test"، دی‌ان‌اس.نوع تی‌ایکس‌تی، 60، "hello world"))
    وگرنه qn.نام دامنه برابر "alias.test":
        recs.بیفزا(rec("alias.test"، دی‌ان‌اس.نوع سی‌نیم، 60، "target.test"))
        اگر qn.نوع رکورد برابر دی‌ان‌اس.نوع آ:
            recs.بیفزا(rec("target.test"، دی‌ان‌اس.نوع آ، 60، "10.9.9.9"))
        پایان
    وگرنه qn.نام دامنه برابر "empty.test":
        rcode = 0
    وگرنه:
        rcode = 3
    پایان
    out := دی‌اوه‌اچ.کدگذاری پاسخ(q.شناسه، qn.نام دامنه، qn.نوع رکورد، rcode، recs)
    recs.آزادکن()
    برگشت out
پایان

تابع b64url_decode(s: رشته): فشرده سازی.بافر بایت:
    alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    ناپایا out := فشرده سازی.بافر بایت جدید()
    ناپایا acc := 0
    ناپایا bits := 0
    تکرار s.طول() در i:
        v := alphabet.بیاب(s.زیررشته(i، 1))
        اگر v کوچکتر 0:
            بشکن
        پایان
        acc = (acc << 6) | v
        bits += 6
        اگر bits بزرگتربرابر 8:
            bits -= 8
            فشرده سازی.افزودن بایت(out، (acc >> bits) & 255)
            acc = acc & ((1 << bits) - 1)
        پایان
    پایان
    برگشت out
پایان

تابع find_text(b: فشرده سازی.بافر بایت، pat: رشته): صحیح:
    pl := pat.طول()
    ناپایا i := 0
    تا i + pl کوچکتربرابر b.طول:
        ناپایا m := درست
        تکرار pl در j:
            اگر فشرده سازی.دریافت بایت(b، i + j) نابرابر (pat برگردان طبیعی۸*)[j] برگردان صحیح:
                m = نادرست
                بشکن
            پایان
        پایان
        اگر m:
            برگشت i
        پایان
        i++
    پایان
    برگشت 0 - 1
پایان

تابع text_at(b: فشرده سازی.بافر بایت، off: صحیح، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، ((b.داده برگردان صحیح۶۴) + (off برگردان صحیح۶۴)) برگردان تهی*، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع serve_http(io &: MIo):
    ناپایا raw := فشرده سازی.بافر بایت جدید()
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    ناپایا hend := 0 - 1
    ناپایا need := 0
    تا درست:
        n := io_read(io، buf، 4096)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        فشرده سازی.افزودن بایت‌ها(raw، buf، n)
        hend = find_text(raw، "\r\n\r\n")
        اگر hend بزرگتربرابر 0:
            head := رشته.کوچک(text_at(raw، 0، hend))
            cl := head.بیاب("content-length:")
            اگر cl بزرگتربرابر 0:
                rest := head.زیررشته(cl + 15، head.طول() - cl - 15)
                ناپایا e := rest.بیاب("\r\n")
                اگر e کوچکتر 0:
                    e = rest.طول()
                پایان
                need = رشته.پیرایش(rest.زیررشته(0، e)).به صحیح()
            پایان
            اگر raw.طول بزرگتربرابر hend + 4 + need:
                بشکن
            پایان
        پایان
    پایان
    حافظه.آزادسازی(buf)
    اگر hend کوچکتر 0:
        فشرده سازی.آزادسازی بافر(raw)
        برگشت
    پایان
    ناپایا wire := فشرده سازی.بافر بایت جدید()
    sp := text_at(raw، 0، 4)
    اگر sp برابر "POST":
        last_method = "POST"
        فشرده سازی.افزودن بایت‌ها(wire، ((raw.داده برگردان صحیح۶۴) + (hend برگردان صحیح۶۴) + 4) برگردان تهی*، need)
    وگرنه:
        last_method = "GET"
        line := text_at(raw، 0، find_text(raw، "\r\n"))
        di := line.بیاب("dns=")
        rest := line.زیررشته(di + 4، line.طول() - di - 4)
        sp2 := rest.بیاب(" ")
        wire = b64url_decode(rest.زیررشته(0، sp2))
    پایان
    ناپایا reply_buf := answer_for(wire.داده، wire.طول)
    ناپایا resp := فشرده سازی.بافر بایت جدید()
    ناپایا head := "HTTP/1.1 200 OK\r\nContent-Type: application/dns-message\r\nConnection: close\r\n"
    اگر chunked:
        head = head + "Transfer-Encoding: chunked\r\n\r\n"
        فشرده سازی.افزودن بایت‌ها(resp، head برگردان تهی*، head.طول())
        half := reply_buf.طول / 2
        hexd := "0123456789abcdef"
        ناپایا h1 := ""
        ناپایا v1 := half
        تا v1 بزرگتر 0:
            h1 = hexd.زیررشته(v1 % 16، 1) + h1
            v1 = v1 / 16
        پایان
        ناپایا h2 := ""
        ناپایا v2 := reply_buf.طول - half
        تا v2 بزرگتر 0:
            h2 = hexd.زیررشته(v2 % 16، 1) + h2
            v2 = v2 / 16
        پایان
        c1 := h1 + "\r\n"
        فشرده سازی.افزودن بایت‌ها(resp، c1 برگردان تهی*، c1.طول())
        فشرده سازی.افزودن بایت‌ها(resp، reply_buf.داده، half)
        c2 := "\r\n" + h2 + "\r\n"
        فشرده سازی.افزودن بایت‌ها(resp، c2 برگردان تهی*، c2.طول())
        فشرده سازی.افزودن بایت‌ها(resp، ((reply_buf.داده برگردان صحیح۶۴) + (half برگردان صحیح۶۴)) برگردان تهی*، reply_buf.طول - half)
        c3 := "\r\n0\r\n\r\n"
        فشرده سازی.افزودن بایت‌ها(resp، c3 برگردان تهی*، c3.طول())
    وگرنه:
        head = head + "Content-Length: " + رشته.از عدد(reply_buf.طول برگردان صحیح۶۴) + "\r\n\r\n"
        فشرده سازی.افزودن بایت‌ها(resp، head برگردان تهی*، head.طول())
        فشرده سازی.افزودن بافر(resp، reply_buf)
    پایان
    _ok := io_write(io، resp.داده، resp.طول)
    فشرده سازی.آزادسازی بافر(resp)
    فشرده سازی.آزادسازی بافر(reply_buf)
    فشرده سازی.آزادسازی بافر(wire)
    فشرده سازی.آزادسازی بافر(raw)
پایان

تابع http_server():
    srv := تی سی پی.پیوند(0)
    http_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        ناپایا io := MIo { tc = c }
        serve_http(io)
        io_close(io)
    پایان
پایان

تابع tls_server():
    srv := تی سی پی.پیوند(0)
    tls_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    cfg := تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    تا درست:
        c := تی سی پی.پذیرش(srv)
        sc := تی ال اس.پوشش کارساز(c.توصیفگر، cfg)
        اگر تی ال اس.اتصال معتبر(sc):
            ناپایا io := MIo { use_tls = درست، sc = sc }
            serve_http(io)
            io_close(io)
        پایان
    پایان
پایان

تابع dot_server():
    srv := تی سی پی.پیوند(0)
    dot_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    cfg := تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    تا درست:
        c := تی سی پی.پذیرش(srv)
        sc := تی ال اس.پوشش کارساز(c.توصیفگر، cfg)
        اگر تی ال اس.اتصال معتبر(sc):
            ناپایا io := MIo { use_tls = درست، sc = sc }
            buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
            ناپایا raw := فشرده سازی.بافر بایت جدید()
            تا درست:
                n := io_read(io، buf، 4096)
                اگر n کوچکتربرابر 0:
                    بشکن
                پایان
                فشرده سازی.افزودن بایت‌ها(raw، buf، n)
                اگر raw.طول بزرگتربرابر 2 و raw.طول بزرگتربرابر 2 + فشرده سازی.دریافت بایت(raw، 0) * 256 + فشرده سازی.دریافت بایت(raw، 1):
                    بشکن
                پایان
            پایان
            اگر raw.طول بزرگتر 2:
                ناپایا reply_buf := answer_for(((raw.داده برگردان صحیح۶۴) + 2) برگردان تهی*، raw.طول - 2)
                ناپایا out := فشرده سازی.بافر بایت جدید()
                فشرده سازی.افزودن بایت(out، (reply_buf.طول >> 8) & 255)
                فشرده سازی.افزودن بایت(out، reply_buf.طول & 255)
                فشرده سازی.افزودن بافر(out، reply_buf)
                _ok := io_write(io، out.داده، out.طول)
                فشرده سازی.آزادسازی بافر(out)
                فشرده سازی.آزادسازی بافر(reply_buf)
            پایان
            فشرده سازی.آزادسازی بافر(raw)
            حافظه.آزادسازی(buf)
            io_close(io)
        پایان
    پایان
پایان

تابع udp_server():
    s := یو دی پی.پیوند(0)
    udp_port = یو دی پی.درگاه(s)
    همگام سازی.اتمام(ready)
    buf := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    ناپایا fh := ""
    ناپایا fp := 0
    تا درست:
        n := یو دی پی.دریافت بایت(s، buf، 2048، fh، fp)
        اگر n بزرگتر 0:
            reply_buf := answer_for(buf، n)
            _sent := یو دی پی.ارسال بایت(s، fh، fp، reply_buf.داده، reply_buf.طول)
        پایان
    پایان
پایان

تابع first_ip(v: وکتور<رشته>): رشته:
    اگر v.طول() برابر 0:
        برگشت "none"
    پایان
    برگشت v.بگیر(0)
پایان

تابع ریشه:
    سرچاپ دی‌اوه‌اچ.نشانی آی‌پی است("1.2.3.4")، دی‌اوه‌اچ.نشانی آی‌پی است("2001:db8::1")، دی‌اوه‌اچ.نشانی آی‌پی است("dns.google")، دی‌اوه‌اچ.نشانی آی‌پی است("1.2.3")
    u := دی‌اوه‌اچ.تجزیه نشانی وب("https://dns.example.net/dns-query")
    سرچاپ u.معتبر، u.با تی ال اس، u.میزبان، u.درگاه، u.مسیر
    u2 := دی‌اوه‌اچ.تجزیه نشانی وب("http://127.0.0.1:8053/q?x=1")
    سرچاپ u2.معتبر، u2.با تی ال اس، u2.میزبان، u2.درگاه، u2.مسیر
    سرچاپ دی‌اوه‌اچ.تجزیه نشانی وب("ftp://x").معتبر
    cf := دی‌اوه‌اچ.کلودفلر()
    سرچاپ cf.نشانی، cf.میزبان، cf.مسیر، cf.نشانی‌های راه‌انداز.بگیر(0)، cf.نشانی‌های راه‌انداز.بگیر(1)
    سرچاپ دی‌اوه‌اچ.گوگل().میزبان، دی‌اوه‌اچ.کواد نه().نشانی‌های راه‌انداز.بگیر(0)، دی‌اوه‌اچ.کلودفلر دی‌اوه‌تی().درگاه، دی‌اوه‌اچ.کلودفلر دی‌اوه‌تی().میزبان
    iran := دی‌اوه‌اچ.کارگزارهای ساده ایران()
    سرچاپ iran.طول()، iran.بگیر(0).نام، iran.بگیر(0).نشانی‌های راه‌انداز.بگیر(0)، iran.بگیر(2).نشانی‌های راه‌انداز.بگیر(0)، iran.بگیر(0).درگاه، iran.بگیر(0).نوع
    سرچاپ دی‌اوه‌اچ.کارگزارهای پیش‌فرض().طول()

    ناپایا recs := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    recs.بیفزا(rec("example.com"، دی‌ان‌اس.نوع آ، 60، "93.184.216.34"))
    recs.بیفزا(rec("example.com"، دی‌ان‌اس.نوع کواداِی، 60، "2001:db8::1"))
    recs.بیفزا(rec("example.com"، دی‌ان‌اس.نوع تی‌ایکس‌تی، 60، "v=spf1 -all"))
    recs.بیفزا(rec("example.com"، دی‌ان‌اس.نوع سی‌نیم، 60، "www.example.com"))
    enc := دی‌اوه‌اچ.کدگذاری پاسخ(4660، "example.com"، دی‌ان‌اس.نوع آ، 0، recs)
    سرچاپ enc.طول
    dec := دی‌ان‌اس.کدگشایی(enc.داده، enc.طول)
    سرچاپ dec.شناسه، dec.نشانه پاسخ، dec.کد نتیجه، dec.پرسش‌ها.پرسش‌ها.طول()، dec.پاسخ‌ها.رکوردها.طول()
    تکرار dec.پاسخ‌ها.رکوردها.طول() در i:
        r := dec.پاسخ‌ها.رکوردها.بگیر(i)
        سرچاپ r.نام دامنه، r.نوع رکورد، r.زمان ماندگاری، r.داده
    پایان
    nx := دی‌اوه‌اچ.کدگذاری پاسخ(7، "nope.test"، دی‌ان‌اس.نوع آ، 3، وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>)
    سرچاپ دی‌ان‌اس.کدگشایی(nx.داده، nx.طول).کد نتیجه

    همگام سازی.افزودن(ready، 4 برگردان صحیح۶۴)
    _t1 := نخ‌ساز(http_server)
    _t2 := نخ‌ساز(tls_server)
    _t3 := نخ‌ساز(dot_server)
    _t4 := نخ‌ساز(udp_server)
    همگام سازی.انتظار(ready)

    ناپایا post := دی‌اوه‌اچ.کارگزار جدید("mock-post"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ پست، "http://127.0.0.1:" + رشته.از عدد(http_port برگردان صحیح۶۴) + "/dns-query")
    post.نشانی‌های راه‌انداز.بیفزا("127.0.0.1")
    q := دی‌اوه‌اچ.پرسش(post، "a.test"، دی‌ان‌اس.نوع آ، 3000)
    سرچاپ q.معتبر، q.پیام.کد نتیجه، q.پیام.پاسخ‌ها.رکوردها.طول()، q.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده، last_method

    ناپایا get := دی‌اوه‌اچ.کارگزار جدید("mock-get"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ گت، "http://127.0.0.1:" + رشته.از عدد(http_port برگردان صحیح۶۴) + "/dns-query")
    get.نشانی‌های راه‌انداز.بیفزا("127.0.0.1")
    qg := دی‌اوه‌اچ.پرسش(get، "v6.test"، دی‌ان‌اس.نوع کواداِی، 3000)
    سرچاپ qg.معتبر، qg.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده، last_method

