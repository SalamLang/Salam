واردسازی حافظه
واردسازی فشرده سازی
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.یو دی پی
واردسازی همگام سازی

ناپایا udp_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع udp_server():
    s := یو دی پی.پیوند(0)
    udp_port = یو دی پی.درگاه(s)
    همگام سازی.اتمام(ready)
    buf := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    ناپایا fh := ""
    ناپایا fp := 0
    تا درست:
        n := یو دی پی.دریافت بایت(s، buf، 2048، fh، fp)
        اگر n بزرگتربرابر 12:
            q := دی‌ان‌اس.کدگشایی(buf، n)
            qn := q.پرسش‌ها.پرسش‌ها.بگیر(0)
            ناپایا recs := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
            recs.بیفزا(دی‌ان‌اس.رکورد { نام دامنه = qn.نام دامنه، نوع رکورد = دی‌ان‌اس.نوع آ، رده = 1، زمان ماندگاری = 100، داده = "10.4.4.4" })
            ناپایا out := دی‌اوه‌اچ.کدگذاری پاسخ(q.شناسه، qn.نام دامنه، qn.نوع رکورد، 0، recs)
            recs.آزادکن()
            _x := یو دی پی.ارسال بایت(s، fh، fp، out.داده، out.طول)
            فشرده سازی.آزادسازی بافر(out)
        پایان
    پایان
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(udp_server)
    همگام سازی.انتظار(ready)

    ناپایا ip4 := فشرده سازی.بافر بایت جدید()
    سرچاپ دی‌اوه‌اچ.تجزیه آی‌پی۴("1.2.3.4"، ip4)، ip4.طول
    ناپایا ip6 := فشرده سازی.بافر بایت جدید()
    سرچاپ دی‌اوه‌اچ.تجزیه آی‌پی۶("2001:db8::1"، ip6)، ip6.طول

    ناپایا s := دی‌اوه‌اچ.کلودفلر()
    s = دی‌اوه‌اچ.با نشانی راه‌انداز(s، "9.9.9.10")
    سرچاپ s.نشانی‌های راه‌انداز.طول()
    سرچاپ دی‌اوه‌اچ.گوگل دی‌اوه‌تی().میزبان، دی‌اوه‌اچ.کواد نه دی‌اوه‌تی().میزبان
    ناپایا sh := دی‌اوه‌اچ.شکن()
    ناپایا s4 := دی‌اوه‌اچ.چهارصدوسه()
    ناپایا el := دی‌اوه‌اچ.الکترو()
    ناپایا rd := دی‌اوه‌اچ.رادار()
    سرچاپ sh.طول()، s4.طول()، el.طول()، rd.طول()
    سرچاپ sh.بگیر(0).نشانی‌های راه‌انداز.بگیر(0)، s4.بگیر(0).نشانی‌های راه‌انداز.بگیر(0)، el.بگیر(0).نشانی‌های راه‌انداز.بگیر(0)، rd.بگیر(0).نشانی‌های راه‌انداز.بگیر(0)
    دی‌اوه‌اچ.آزاد کردن کارگزارها(sh)
    دی‌اوه‌اچ.آزاد کردن کارگزارها(s4)
    دی‌اوه‌اچ.آزاد کردن کارگزارها(el)
    دی‌اوه‌اچ.آزاد کردن کارگزارها(rd)

    ناپایا plain := دی‌اوه‌اچ.کارگزار ساده جدید("local"، "127.0.0.1")
    plain.درگاه = udp_port
    ناپایا r := دی‌اوه‌اچ.پرسش از نشانی(plain، "127.0.0.1"، "q.test"، دی‌ان‌اس.نوع آ، 2000)
    سرچاپ r.معتبر، r.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده
    دی‌اوه‌اچ.آزاد کردن پاسخ(r)

    ناپایا one := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    one.بیفزا(plain)
    rs := دی‌اوه‌اچ.حل‌کننده جدید(one)
    ناپایا boot := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    boot.بیفزا(plain)
    دی‌اوه‌اچ.تعیین کارگزارهای راه‌انداز(rs، boot)
    دی‌اوه‌اچ.تعیین حدود ماندگاری(rs، 20، 3600، 5)
    ناپایا a := دی‌اوه‌اچ.حل(rs، "r.test"، دی‌ان‌اس.نوع آ)
    سرچاپ a.معتبر، a.از حافظه
    دی‌اوه‌اچ.آزاد کردن پاسخ نهایی(a)
پایان
