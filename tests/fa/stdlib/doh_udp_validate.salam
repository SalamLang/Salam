واردسازی حافظه
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.یو دی پی
واردسازی همگام سازی

ناپایا mode := 0
ناپایا ports := وکتور {} برگردان وکتور<صحیح>
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا server_port := 0

تابع send_copy(s: یو دی پی.سوکت یو دی پی، host: رشته، port: صحیح، src: تهی*، n: صحیح، patch_at: صحیح، patch_to: صحیح):
    out := حافظه.تخصیص(n برگردان طبیعی۶۴)
    حافظه.کپی(out، src، n برگردان طبیعی۶۴)
    p := out برگردان طبیعی۸*
    p[2] = ((p[2] برگردان صحیح) | 128) برگردان طبیعی۸
    اگر patch_at بزرگتربرابر 0:
        p[patch_at] = patch_to برگردان طبیعی۸
    پایان
    یو دی پی.ارسال بایت(s، host، port، out، n)
    حافظه.آزادسازی(out)
پایان

تابع dns_server():
    s := یو دی پی.پیوند(0)
    server_port = یو دی پی.درگاه(s)
    other := یو دی پی.پیوند(0)
    همگام سازی.اتمام(ready)
    buf := حافظه.تخصیص(1024 برگردان طبیعی۶۴)
    تا درست:
        ناپایا fh := ""
        ناپایا fp := 0
        n := یو دی پی.دریافت بایت(s، buf، 1024، fh، fp)
        اگر n کوچکتر 17: گذر پایان
        ports.بیفزا(fp)
        b := buf برگردان طبیعی۸*
        اگر mode برابر 1:
            send_copy(s، fh، fp، buf، n، 1، ((b[1] برگردان صحیح) + 1) & 255)
        وگرنه mode برابر 2:
            send_copy(s، fh، fp، buf، n، 13، 122)
        وگرنه mode برابر 3:
            send_copy(s، fh، fp، buf، n، n - 3، 28)
        وگرنه mode برابر 4:
            send_copy(s، fh، fp، buf، n، 5، 0)
        وگرنه mode برابر 5:
            send_copy(other، fh، fp، buf، n، 1، ((b[1] برگردان صحیح) + 1) & 255)
            send_copy(other، fh، fp، buf، n، 0 - 1، 0)
        وگرنه mode برابر 7:
            send_copy(s، fh، fp، buf، n، 13، 122)
        وگرنه mode برابر 8:
            send_copy(s، fh، fp، buf، n، n - 3، 28)
        وگرنه mode برابر 9:
            send_copy(s، fh، fp، buf، n، 5، 0)
        وگرنه mode برابر 10:
            send_copy(s، fh، fp، buf، n، 1، ((b[1] برگردان صحیح) + 1) & 255)
        وگرنه mode برابر 6:
            send_copy(s، fh، fp، buf، n، 13، (b[13] برگردان صحیح) - 32)
            گذر
        پایان
        اگر mode کوچکتر 6:
            send_copy(s، fh، fp، buf، n، 0 - 1، 0)
        پایان
    پایان
پایان

تابع probe(label: رشته، srv: دی‌اوه‌اچ.کارگزار، name: رشته، kind: صحیح): منطقی:
    r := دی‌اوه‌اچ.پرسش(srv، name، kind، 1500)
    سرچاپ label، r.معتبر، r.خطا
    برگشت r.معتبر
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(dns_server)
    همگام سازی.انتظار(ready)
    ناپایا srv := دی‌اوه‌اچ.کارگزار ساده جدید("mock"، "127.0.0.1")
    srv.درگاه = server_port

    mode = 0
    probe("honest reply"، srv، "plain.test"، دی‌ان‌اس.نوع آ)
    mode = 1
    probe("a forged id first, then the real reply"، srv، "idforge.test"، دی‌ان‌اس.نوع آ)
    mode = 2
    probe("a reply for another name first"، srv، "namecheck.test"، دی‌ان‌اس.نوع آ)
    mode = 3
    probe("a reply for another type first"، srv، "typecheck.test"، دی‌ان‌اس.نوع آ)
    mode = 4
    probe("a reply with no question first"، srv، "noq.test"، دی‌ان‌اس.نوع آ)
    mode = 5
    probe("forged replies from another source port first"، srv، "port.test"، دی‌ان‌اس.نوع آ)
    mode = 6
    probe("a reply with the name in upper case is accepted"، srv، "case.test"، دی‌ان‌اس.نوع آ)
    mode = 7
    probe("only a reply for another name"، srv، "onlyname.test"، دی‌ان‌اس.نوع آ)
    mode = 8
    probe("only a reply for another type"، srv، "onlytype.test"، دی‌ان‌اس.نوع آ)
    mode = 9
    probe("only a reply with no question"، srv، "onlynoq.test"، دی‌ان‌اس.نوع آ)
    mode = 10
    probe("only a reply with the wrong id"، srv، "onlyid.test"، دی‌ان‌اس.نوع آ)
    mode = 0
    ports = وکتور {} برگردان وکتور<صحیح>
    تکرار 12 در i:
        mode = 0
        دی‌اوه‌اچ.پرسش(srv، "p" + i + ".test"، دی‌ان‌اس.نوع آ، 1500)
    پایان
    ناپایا seen := نگاشت {} برگردان نگاشت<رشته، منطقی>
    ناپایا high := درست
    تکرار ports.طول() در i:
        seen.درج("" + ports[i]، درست)
        اگر ports[i] کوچکتر 20000: high = نادرست پایان
    پایان
    سرچاپ "source ports are spread:"، seen.اندازه() بزرگتربرابر 8، "and in the high range:"، high
پایان
