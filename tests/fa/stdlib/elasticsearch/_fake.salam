بسته جعلی

واردسازی رشته
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا _کلیدها := وکتور {} برگردان وکتور<رشته>
ناپایا _کدها := وکتور {} برگردان وکتور<صحیح>
ناپایا _بدنه‌ها := وکتور {} برگردان وکتور<رشته>
ناپایا _مصرف‌شده := وکتور {} برگردان وکتور<منطقی>
ناپایا _آخری := ""
ناپایا _شمارش := 0

تابع _رسیدگی(ی: صحیح۶۴):
    بافت := اچ تی تی پی.زمینه جدید(ی)
    روش := اچ تی تی پی.روش(بافت)
    مسیر := اچ تی تی پی.مسیر(بافت)
    پرس‌وجو := اچ تی تی پی.پرسمان خام(بافت)
    ناپایا هدف := مسیر
    اگر پرس‌وجو.طول() بزرگتر 0: هدف = مسیر + "?" + پرس‌وجو پایان
    _شمارش += 1
    _آخری = روش + " " + هدف
    احراز := اچ تی تی پی.سرصفحه(بافت، "Authorization")
    اگر احراز.طول() بزرگتر 0: _آخری = _آخری + "\n  auth: " + احراز پایان
    نوع‌محتوا := اچ تی تی پی.سرصفحه(بافت، "Content-Type")
    اگر نوع‌محتوا.طول() بزرگتر 0 و نوع‌محتوا نابرابر "application/json": _آخری = _آخری + "\n  type: " + نوع‌محتوا پایان
    بدنه := اچ تی تی پی.بدنه(بافت)
    اگر بدنه.طول() بزرگتر 0: _آخری = _آخری + "\n  body: " + رشته.پیرایش راست(بدنه) پایان
    کلیدمسیر := روش + " " + مسیر
    ناپایا انتخاب := -1
    تکرار _کلیدها.طول() در ش:
        اگر انتخاب کوچکتر 0 و _کلیدها.بگیر(ش) برابر کلیدمسیر و وارونه _مصرف‌شده.بگیر(ش):
            انتخاب = ش
        پایان
    پایان
    اگر انتخاب کوچکتر 0:
        تکرار _کلیدها.طول() در ش:
            اگر _کلیدها.بگیر(ش) برابر کلیدمسیر: انتخاب = ش پایان
        پایان
    وگرنه:
        _مصرف‌شده.بنشان(انتخاب، درست)
    پایان
    اگر انتخاب کوچکتر 0:
        اچ تی تی پی.تنظیم وضعیت(بافت، 404)
        اچ تی تی پی.جیسون(بافت، `{"error":{"root_cause":[{"type":"resource_not_found_exception","reason":"no route for ` + کلیدمسیر + `"}],"type":"resource_not_found_exception","reason":"no route for ` + کلیدمسیر + `"},"status":404}`)
        برگشت
    پایان
    اچ تی تی پی.تنظیم وضعیت(بافت، _کدها.بگیر(انتخاب))
    اچ تی تی پی.جیسون(بافت، _بدنه‌ها.بگیر(انتخاب))
پایان

همگانی تابع ثبت‌پاسخ(روش: رشته، مسیر: رشته، کد: صحیح، بدنه: رشته):
    _کلیدها.بیفزا(روش + " " + مسیر)
    _کدها.بیفزا(کد)
    _بدنه‌ها.بیفزا(بدنه)
    _مصرف‌شده.بیفزا(نادرست)
پایان

همگانی تابع آخرین(): رشته:
    برگشت _آخری
پایان

همگانی تابع شمار(): صحیح:
    برگشت _شمارش
پایان

همگانی تابع آغاز(شماره‌درگاه: صحیح): منطقی:
    ناپایا پ := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(پ، "/*"، _رسیدگی)
    مسیریاب.سر(پ، "/*"، _رسیدگی)
    مسیریاب.ارسال(پ، "/*"، _رسیدگی)
    مسیریاب.قراردادن(پ، "/*"، _رسیدگی)
    مسیریاب.حذف(پ، "/*"، _رسیدگی)
    سرور := اچ تی تی پی.سرور جدید(شماره‌درگاه)
    اچ تی تی پی.استفاده(سرور، پ)
    برگشت اچ تی تی پی.اجرا در پس زمینه(سرور)
پایان
