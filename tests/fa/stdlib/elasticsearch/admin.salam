    ناپایا ک := الستیک سرچ.اتصال("http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))

    گام("put pipeline:"، بله(الستیک سرچ.تنظیم خط لوله(ک، "clean"، `{"processors":[{"lowercase":{"field":"tag"}}]}`)))
    سرچاپ "get pipeline:"، الستیک سرچ.دریافت خط لوله(ک، "clean")
    گام("simulate:"، الستیک سرچ.شبیه‌سازی خط لوله(ک، "clean"، `{"docs":[{"_source":{"tag":"LOUD"}}]}`))
    گام("delete pipeline:"، بله(الستیک سرچ.حذف خط لوله(ک، "clean")))

    گام("create stream:"، بله(الستیک سرچ.ایجاد جریان داده(ک، "logs-web")))
    سرچاپ "stream:"، الستیک سرچ.دریافت جریان داده(ک، "logs-web")
    گام("rollover:"، بله(الستیک سرچ.چرخش نمایه(ک، "logs-web"، `{"conditions":{"max_age":"7d"}}`)))
    گام("delete stream:"، بله(الستیک سرچ.حذف جریان داده(ک، "logs-web")))

    گام("put policy:"، بله(الستیک سرچ.تنظیم سیاست چرخه عمر(ک، "month"، `{"policy":{"phases":{"delete":{"min_age":"30d","actions":{"delete":{}}}}}}`)))
    سرچاپ "get policy:"، الستیک سرچ.دریافت سیاست چرخه عمر(ک، "month")
    گام("delete policy:"، بله(الستیک سرچ.حذف سیاست چرخه عمر(ک، "month")))

    گام("repository:"، بله(الستیک سرچ.تنظیم مخزن پشتیبان(ک، "backups"، `{"type":"fs","settings":{"location":"/mnt/backups"}}`)))
    گام("snapshot:"، بله(الستیک سرچ.ایجاد پشتیبان(ک، "backups"، "nightly"، `{"indices":"books"}`)))
    سرچاپ "snapshots:"، الستیک سرچ.فهرست پشتیبان‌ها(ک، "backups")
    گام("restore:"، بله(الستیک سرچ.بازیابی پشتیبان(ک، "backups"، "nightly"، `{"indices":"books","rename_pattern":"(.+)","rename_replacement":"restored-$1"}`)))
    گام("delete snapshot:"، بله(الستیک سرچ.حذف پشتیبان(ک، "backups"، "nightly")))
    گام("delete repository:"، بله(الستیک سرچ.حذف مخزن پشتیبان(ک، "backups")))

    گام("cluster settings:"، بله(الستیک سرچ.تنظیم تنظیمات خوشه(ک، `{"persistent":{"indices.recovery.max_bytes_per_sec":"100mb"}}`)))
