واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19863

تابع ریشه:
    بدنه := `{"took":3,"hits":{"total":{"value":120,"relation":"eq"},"hits":[]},"aggregations":{"by_author":{"buckets":[{"key":"ferdowsi","doc_count":70,"avg_year":{"value":1010.0}},{"key":"saadi","doc_count":50,"avg_year":{"value":1258.5}}]},"oldest":{"value":940.0},"authors":{"value":2},"per_century":{"buckets":[{"key_as_string":"1000-01-01","key":-30610224000000,"doc_count":70}]}}}`
    جعلی.ثبت‌پاسخ("POST"، "/books/_search"، 200، بدنه)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا ک := الستیک سرچ.اتصال("http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))

    برپایه‌نویسنده := الستیک سرچ.زیرتجمیع‌ها(الستیک سرچ.تجمیع واژه‌ها("author"، 10)، الستیک سرچ.افزودن تجمیع(""، "avg_year"، الستیک سرچ.تجمیع میانگین("year")))
    ناپایا تجمیع‌ها := الستیک سرچ.افزودن تجمیع(""، "by_author"، برپایه‌نویسنده)
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "oldest"، الستیک سرچ.تجمیع کمینه("year"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "newest"، الستیک سرچ.تجمیع بیشینه("year"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "pages"، الستیک سرچ.تجمیع جمع("pages"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "authors"، الستیک سرچ.تجمیع یکتا("author"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "with_isbn"، الستیک سرچ.تجمیع شمار مقدار("isbn"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "price_stats"، الستیک سرچ.تجمیع آمار("price"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "price_steps"، الستیک سرچ.تجمیع بافت‌نگار("price"، 5.0))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "per_century"، الستیک سرچ.تجمیع بافت‌نگار تاریخ("published"، "year"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "epics"، الستیک سرچ.تجمیع پالایه(الستیک سرچ.واژه("tags"، "epic")))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "best"، الستیک سرچ.تجمیع برترین یافته‌ها(1))
    سرچاپ "aggs:"، تجمیع‌ها

    نتیجه := الستیک سرچ.جستجو(ک، "books"، الستیک سرچ.درخواست جستجو { size = 0، aggs = تجمیع‌ها })
    سرچاپ "sent:"، جعلی.آخرین()
    سرچاپ "total:"، نتیجه.total
    سرچاپ "oldest:"، الستیک سرچ.مقدار تجمیع(نتیجه، "oldest")، "authors:"، الستیک سرچ.مقدار تجمیع(نتیجه، "authors")
    هر د در الستیک سرچ.سطل‌های تجمیع(نتیجه، "by_author"):
        سرچاپ "  author"، د.key، د.doc_count، الستیک سرچ.مقدار تجمیع در(د.raw، "avg_year")
    پایان
    هر د در الستیک سرچ.سطل‌های تجمیع(نتیجه، "per_century"):
        سرچاپ "  century"، د.key، د.doc_count
    پایان
    سرچاپ "raw:"، الستیک سرچ.تجمیع خام(نتیجه، "oldest")
    سرچاپ "in raw:"، الستیک سرچ.سطل‌های تجمیع در(نتیجه.aggregations، "by_author").طول()
    الستیک سرچ.بستن(ک)
پایان
