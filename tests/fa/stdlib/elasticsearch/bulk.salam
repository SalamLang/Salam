واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19865

تابع ریشه:
    جعلی.ثبت‌پاسخ("POST"، "/_bulk"، 200، `{"took":12,"errors":true,"items":[{"index":{"_index":"logs","_id":"1","status":201,"result":"created","_version":1}},{"create":{"_index":"logs","_id":"2","status":409,"error":{"type":"version_conflict_engine_exception","reason":"[2]: document already exists"}}},{"update":{"_index":"logs","_id":"3","status":200,"result":"updated","_version":2}},{"update":{"_index":"logs","_id":"4","status":201,"result":"created","_version":1}},{"delete":{"_index":"logs","_id":"5","status":404,"result":"not_found"}}]}`)
    جعلی.ثبت‌پاسخ("POST"، "/logs/_bulk"، 200، `{"took":3,"errors":false,"items":[{"index":{"_index":"logs","_id":"auto","status":201,"result":"created","_version":1}}]}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا ک := الستیک سرچ.اتصال("http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))

    ناپایا د := الستیک سرچ.دسته‌ای تازه()
    الستیک سرچ.نمایه کردن دسته‌ای(د، "logs"، "1"، "{\n  \"level\": \"info\",\n  \"msg\": \"started\"\n}")
    الستیک سرچ.ایجاد دسته‌ای(د، "logs"، "2"، `{"level":"warn"}`)
    الستیک سرچ.به‌روزرسانی دسته‌ای(د، "logs"، "3"، `{"level":"error"}`)
    الستیک سرچ.درج روزآمد دسته‌ای(د، "logs"، "4"، `{"level":"debug"}`)
    الستیک سرچ.حذف دسته‌ای(د، "logs"، "5")
    سرچاپ "actions:"، الستیک سرچ.طول دسته‌ای(د)
    چاپ الستیک سرچ.بدنه دسته‌ای(د)
    نتیجه := الستیک سرچ.اجرای دسته‌ای(ک، د)
    سرچاپ "sent:"، جعلی.آخرین()
    سرچاپ "result:"، نتیجه.موفق، نتیجه.وضعیت، نتیجه.زمان اجرا، نتیجه.خطا دارد، نتیجه.تعداد موفق، نتیجه.تعداد ناموفق
    سرچاپ "error:"، نتیجه.خطا
    هر قلم در نتیجه.اقلام:
        سرچاپ "  "، قلم.عملیات، قلم.نمایه، قلم.شناسه، قلم.وضعیت، قلم.موفق، قلم.نتیجه، قلم.نسخه، قلم.نوع خطا، قلم.دلیل خطا
    پایان

    الستیک سرچ.بازنشانی دسته‌ای(د)
    سرچاپ "after reset:"، الستیک سرچ.طول دسته‌ای(د)، الستیک سرچ.بدنه دسته‌ای(د).طول()
    الستیک سرچ.نمایه کردن دسته‌ای(د، ""، ""، `{"level":"info"}`)
    دومی := الستیک سرچ.اجرای دسته‌ای با گزینه(ک، "logs"، د، الستیک سرچ.گزینه‌ها { تازه‌سازی = الستیک سرچ.تازه‌سازی با انتظار، خط لوله = "logs-clean" })
    سرچاپ "default index:"، دومی.موفق، دومی.تعداد موفق، جعلی.آخرین()
    بی‌عمل := الستیک سرچ.اجرای دسته‌ای(ک، الستیک سرچ.دسته‌ای تازه())
    سرچاپ "empty bulk:"، بی‌عمل.موفق، بی‌عمل.اقلام.طول()
    تجزیه‌شده := الستیک سرچ.تجزیه نتیجه دسته‌ای(`{"took":1,"errors":false,"items":[{"delete":{"_id":"9","status":200,"result":"deleted"}}]}`)
    سرچاپ "parsed:"، تجزیه‌شده.موفق، تجزیه‌شده.اقلام.بگیر(0).عملیات، تجزیه‌شده.اقلام.بگیر(0).نتیجه
    الستیک سرچ.بستن(ک)
پایان
