واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19860
پایا شناسه‌ابری := "demo:ZXUtd2VzdC0xLmF3cy5mb3VuZC5pbyRjZWM2ZjI2MWE3NGJmMjRjZTMzYmI4ODExYjg0Mjk0ZiRjNmYyZTRmZDZkMTQ0M2Q2ZjM4ZDkzY2U2ZTk2MzM2Yw=="

تابع نمایش‌گره‌ها(برچسب: رشته، ک: الستیک سرچ.کارخواه):
    سرچاپ برچسب، الستیک سرچ.معتبر(ک)، الستیک سرچ.گره‌ها(ک)، "auth:"، الستیک سرچ.سرآیند احراز(ک)
پایان

تابع ریشه:
    جعلی.ثبت‌پاسخ("HEAD"، "/"، 200، "")
    جعلی.ثبت‌پاسخ("GET"، "/"، 200، `{"name":"node-1","cluster_name":"demo","cluster_uuid":"u-1","version":{"number":"8.15.3","build_flavor":"default","lucene_version":"9.11.1"},"tagline":"You Know, for Search"}`)
    جعلی.ثبت‌پاسخ("GET"، "/_cluster/health"، 200، `{"cluster_name":"demo","status":"green","number_of_nodes":1}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    نشانی := "http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴)

    ناپایا ک := الستیک سرچ.اتصال با رمز(نشانی، "elastic"، "s3cret")
    سرچاپ "ping:"، الستیک سرچ.پینگ(ک)
    سرچاپ جعلی.آخرین()
    آگاهی := الستیک سرچ.دریافت اطلاعات(ک)
    سرچاپ "info:"، آگاهی.ok، آگاهی.name، آگاهی.cluster_name، آگاهی.version، آگاهی.distribution، آگاهی.lucene_version
    سرچاپ "distribution:"، الستیک سرچ.توزیع(ک)، الستیک سرچ.اوپن سرچ است(ک)
    الستیک سرچ.بستن(ک)
    سرچاپ "closed:"، الستیک سرچ.معتبر(ک)

    ناپایا کلیدی := الستیک سرچ.اتصال با کلید(نشانی، "key-id:key-secret")
    الستیک سرچ.پینگ(کلیدی)
    سرچاپ "api key:"، جعلی.آخرین()
    الستیک سرچ.بستن(کلیدی)

    ناپایا پیکر := الستیک سرچ.پیکربندی پیش‌فرض()
    پیکر.nodes = وکتور {} برگردان وکتور<رشته>
    پیکر.nodes.بیفزا(نشانی)
    پیکر.bearer = "service-token"
    پیکر.timeout_ms = 5000
    پیکر.max_retries = 1
    پیکر.keep_alive = نادرست
    پیکر.headers.درج("X-Opaque-Id"، "salam-example")
    ناپایا د := الستیک سرچ.کارخواه تازه(پیکر)
    ی := الستیک سرچ.سلامت خوشه(د)
    سرچاپ "bearer:"، جعلی.آخرین()
    سرچاپ "health:"، ی.ok، ی.status، ی.nodes
    الستیک سرچ.بستن(د)

    ناپایا چندگره := الستیک سرچ.اتصال("http://es-1:9200, https://admin:p%40ss@es-2.example.com/prefix/ ,localhost")
    نمایش‌گره‌ها("nodes:"، چندگره)
    الستیک سرچ.بستن(چندگره)

    سرچاپ "cloud url:"، الستیک سرچ.کدگشایی شناسه ابری(شناسه‌ابری)
    ناپایا ابری := الستیک سرچ.اتصال ابری(شناسه‌ابری، "ZW5jb2RlZC1rZXk=")
    نمایش‌گره‌ها("cloud:"، ابری)
    الستیک سرچ.بستن(ابری)

    ناپایا خراب := الستیک سرچ.اتصال("ftp://nowhere")
    سرچاپ "bad url:"، الستیک سرچ.معتبر(خراب)، الستیک سرچ.خطا(خراب)
    الستیک سرچ.بستن(خراب)

    ناپایا خام := الستیک سرچ.اتصال(نشانی)
    پ := الستیک سرچ.انجام(خام، "GET"، "/_cat/health?format=json"، "")
    سرچاپ "perform:"، پ.ok، پ.status، پ.error_type
    سرچاپ "  "، پ.error
    سرچاپ "state:"، الستیک سرچ.وضعیت(خام)، الستیک سرچ.نوع خطا(خام)
    سرچاپ "reason:"، الستیک سرچ.علت خطا(خام)
    سرچاپ "basic:"، الستیک سرچ.کدگذاری پایه("elastic"، "s3cret")
    سرچاپ "defaults:"، الستیک سرچ.نشانی پیش‌فرض، الستیک سرچ.درگاه پیش‌فرض، الستیک سرچ.مهلت گره از کار افتاده
    الستیک سرچ.بستن(خام)
پایان
