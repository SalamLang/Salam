واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19867

تابع ریشه:
    جعلی.ثبت‌پاسخ("HEAD"، "/"، 200، "")
    جعلی.ثبت‌پاسخ("GET"، "/"، 200، `{"name":"node-1","cluster_name":"library","cluster_uuid":"abc","version":{"distribution":"opensearch","number":"2.17.1","build_flavor":"","lucene_version":"9.11.1"},"tagline":"The OpenSearch Project: https://opensearch.org/"}`)
    جعلی.ثبت‌پاسخ("GET"، "/_cluster/health"، 200، `{"cluster_name":"library","status":"yellow","timed_out":false,"number_of_nodes":3,"number_of_data_nodes":2,"active_primary_shards":10,"active_shards":18,"relocating_shards":0,"initializing_shards":1,"unassigned_shards":2,"number_of_pending_tasks":0,"active_shards_percent_as_number":85.7}`)
    جعلی.ثبت‌پاسخ("GET"، "/_cluster/stats"، 200، `{"cluster_name":"library","indices":{"count":4}}`)
    جعلی.ثبت‌پاسخ("GET"، "/_nodes"، 200، `{"_nodes":{"total":3}}`)
    جعلی.ثبت‌پاسخ("GET"، "/_cat/indices/books*"، 200، `[{"health":"green","status":"open","index":"books","uuid":"u1","pri":"1","rep":"1","docs.count":"1200","docs.deleted":"3","store.size":"52428"},{"health":"yellow","status":"open","index":"books_v2","uuid":"u2","pri":"2","rep":"0","docs.count":"1240","docs.deleted":"0","store.size":"61440"}]`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا ک := الستیک سرچ.اتصال("http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))
    سرچاپ "ping:"، الستیک سرچ.پینگ(ک)، جعلی.آخرین()
    آگاهی := الستیک سرچ.دریافت اطلاعات(ک)
    سرچاپ "info:"، آگاهی.name، آگاهی.cluster_name، آگاهی.cluster_uuid، آگاهی.version، آگاهی.distribution، آگاهی.lucene_version
    سرچاپ "tagline:"، آگاهی.tagline
    سرچاپ "opensearch:"، الستیک سرچ.اوپن سرچ است(ک)، الستیک سرچ.توزیع(ک)
    ی := الستیک سرچ.سلامت خوشه(ک)
    سرچاپ "health:"، ی.ok، ی.cluster_name، ی.status، ی.timed_out، ی.nodes، ی.data_nodes
    سرچاپ "shards:"، ی.active_primary_shards، ی.active_shards، ی.relocating_shards، ی.initializing_shards، ی.unassigned_shards، ی.pending_tasks، ی.active_shards_percent
    نوشته := الستیک سرچ.انتظار برای وضعیت(ک، "green"، "10s")
    سرچاپ "wait:"، نوشته.ok، نوشته.status، جعلی.آخرین()
    سرچاپ "stats:"، الستیک سرچ.آمار خوشه(ک)
    سرچاپ "nodes:"، الستیک سرچ.اطلاعات گره‌ها(ک)
    هر نمایه در الستیک سرچ.فهرست نمایه‌ها(ک، "books*"):
        سرچاپ "index:"، نمایه.index، نمایه.health، نمایه.status، نمایه.uuid، نمایه.primaries، نمایه.replicas، نمایه.docs_count، نمایه.docs_deleted، نمایه.store_size
    پایان
    سرچاپ "  "، جعلی.آخرین()
    الستیک سرچ.بستن(ک)
پایان
