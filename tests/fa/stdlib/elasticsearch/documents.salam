واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19861

تابع نمایش‌نوشتن(برچسب: رشته، نوشته: الستیک سرچ.نتیجه نوشتن):
    سرچاپ برچسب، نوشته.ok، نوشته.status، نوشته.result، نوشته.index، نوشته.id، نوشته.version، نوشته.seq_no، نوشته.primary_term
    سرچاپ "  "، جعلی.آخرین()
    اگر وارونه نوشته.ok: سرچاپ "  error:"، نوشته.error پایان
پایان

تابع ریشه:
    ساخته‌شد := `{"_index":"books","_id":"1","_version":1,"result":"created","_seq_no":0,"_primary_term":1}`
    جعلی.ثبت‌پاسخ("PUT"، "/books/_doc/1"، 201، ساخته‌شد)
    جعلی.ثبت‌پاسخ("POST"، "/books/_doc"، 201، `{"_index":"books","_id":"Zx81","_version":1,"result":"created","_seq_no":1,"_primary_term":1}`)
    جعلی.ثبت‌پاسخ("PUT"، "/books/_create/2"، 409، `{"error":{"type":"version_conflict_engine_exception","reason":"[2]: document already exists"},"status":409}`)
    جعلی.ثبت‌پاسخ("GET"، "/books/_doc/1"، 200، `{"_index":"books","_id":"1","_version":3,"_seq_no":5,"_primary_term":1,"found":true,"_source":{"title":"Shahnameh","year":1010}}`)
    جعلی.ثبت‌پاسخ("GET"، "/books/_doc/404"، 404، `{"_index":"books","_id":"404","found":false}`)
    جعلی.ثبت‌پاسخ("GET"، "/books/_source/1"، 200، `{"title":"Shahnameh","year":1010}`)
    جعلی.ثبت‌پاسخ("HEAD"، "/books/_doc/1"، 200، "")
    جعلی.ثبت‌پاسخ("POST"، "/books/_update/1"، 200، `{"_index":"books","_id":"1","_version":4,"result":"updated","_seq_no":6,"_primary_term":1}`)
    جعلی.ثبت‌پاسخ("DELETE"، "/books/_doc/1"، 200، `{"_index":"books","_id":"1","_version":5,"result":"deleted","_seq_no":7,"_primary_term":1}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_mget"، 200، `{"docs":[{"_index":"books","_id":"1","found":true,"_version":1,"_source":{"title":"Shahnameh"}},{"_index":"books","_id":"9","found":false}]}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_count"، 200، `{"count":42}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا ک := الستیک سرچ.اتصال("http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))

    نمایش‌نوشتن("index:"، الستیک سرچ.نمایه کردن(ک، "books"، "1"، `{"title":"Shahnameh","year":1010}`))
    نمایش‌نوشتن("index with options:"، الستیک سرچ.نمایه کردن با گزینه(ک، "books"، "1"، "{\n  \"title\": \"Masnavi\"\n}"، الستیک سرچ.گزینه‌ها { refresh = الستیک سرچ.تازه‌سازی با انتظار، routing = "poetry"، pipeline = "clean"، if_seq_no = 0، if_primary_term = 1 }))
    نمایش‌نوشتن("auto id:"، الستیک سرچ.نمایه کردن(ک، "books"، ""، `{"title":"Golestan"}`))
    نمایش‌نوشتن("create existing:"، الستیک سرچ.ایجاد(ک، "books"، "2"، `{"title":"Bustan"}`))
    نمایش‌نوشتن("create auto id:"، الستیک سرچ.ایجاد با گزینه(ک، "books"، ""، `{"title":"Divan"}`، الستیک سرچ.گزینه‌ها { refresh = الستیک سرچ.تازه‌سازی فوری }))

    س := الستیک سرچ.دریافت(ک، "books"، "1")
    سرچاپ "get:"، س.found، س.id، س.version، س.seq_no، س.primary_term، س.source
    ناموجود := الستیک سرچ.دریافت(ک، "books"، "404")
    سرچاپ "missing:"، ناموجود.found، ناموجود.error.طول()
    پالایش‌شده := الستیک سرچ.دریافت با گزینه(ک، "books"، "1"، الستیک سرچ.گزینه‌ها { source = "title"، routing = "poetry" })
    سرچاپ "get with:"، پالایش‌شده.found، جعلی.آخرین()
    سرچاپ "source:"، الستیک سرچ.دریافت منبع(ک، "books"، "1")
    سرچاپ "exists:"، الستیک سرچ.موجود است(ک، "books"، "1")، الستیک سرچ.موجود است(ک، "books"، "2")

    نمایش‌نوشتن("update:"، الستیک سرچ.به‌روزرسانی(ک، "books"، "1"، `{"year":1011}`))
    نمایش‌نوشتن("update with:"، الستیک سرچ.به‌روزرسانی با گزینه(ک، "books"، "1"، `{"year":1012}`، الستیک سرچ.گزینه‌ها { retry_on_conflict = 3، source = "true" }))
    نمایش‌نوشتن("upsert:"، الستیک سرچ.درج روزآمد(ک، "books"، "1"، `{"title":"Shahnameh"}`))
    سرچاپ "script:"، الستیک سرچ.اسکریپت("ctx._source.year += params.n"، `{"n": 1}`)
    نمایش‌نوشتن("update script:"، الستیک سرچ.به‌روزرسانی با اسکریپت(ک، "books"، "1"، "ctx._source.year += params.n"، `{"n": 1}`))
    نمایش‌نوشتن("delete:"، الستیک سرچ.حذف(ک، "books"، "1"))
    نمایش‌نوشتن("delete with:"، الستیک سرچ.حذف با گزینه(ک، "books"، "1"، الستیک سرچ.گزینه‌ها { refresh = الستیک سرچ.بدون تازه‌سازی، timeout = "5s" }))

    ناپایا شناسه‌ها := وکتور {} برگردان وکتور<رشته>
    شناسه‌ها.بیفزا("1")
    شناسه‌ها.بیفزا("9")
    هر برگه در الستیک سرچ.دریافت چندگانه(ک، "books"، شناسه‌ها):
        سرچاپ "mget:"، برگه.id، برگه.found، برگه.source
    پایان
    سرچاپ "  "، جعلی.آخرین()
    سرچاپ "count:"، الستیک سرچ.شمارش(ک، "books"، الستیک سرچ.واژه("author"، "ferdowsi"))
    سرچاپ "  "، جعلی.آخرین()
    الستیک سرچ.بستن(ک)
پایان
