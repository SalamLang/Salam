create index: true
   PUT /books
  body: {"settings":{"number_of_shards":1},"mappings":{"properties":{"title":{"type":"text"},"year":{"type":"integer"}}}}
exists: true false
get index: {"books":{"aliases":{},"settings":{}}}
mapping: {"books":{"mappings":{"properties":{"title":{"type":"text"}}}}}
put mapping: true
   PUT /books/_mapping
  body: {"properties":{"isbn":{"type":"keyword"}}}
settings: {"books":{"settings":{"index":{"number_of_replicas":"0"}}}}
put settings: true
   PUT /books/_settings
  body: {"index":{"refresh_interval":"5s"}}
refresh: true
   POST /books/_refresh
refresh all: true
   POST /_refresh
flush: true
   POST /books/_flush
force merge: true
   POST /books/_forcemerge?max_num_segments=1
close: true
   POST /books/_close
open: true
   POST /books/_open
alias: true
   PUT /books/_alias/library
alias exists: true
alias targets: ["books", "books_v2"]
swap alias: true
   POST /_aliases
  body: {"actions": [{"remove": {"index": "books", "alias": "library"}}, {"add": {"index": "books_v2", "alias": "library"}}]}
delete alias: true
   DELETE /books/_alias/library
template: true
   PUT /_index_template/books_tpl
  body: {"index_patterns":["books-*"],"template":{"settings":{"number_of_replicas":0}}}
template exists: true
delete template: true
   DELETE /_index_template/books_tpl
reindex: 42
   POST /_reindex?refresh=true
  body: {"source": {"index": "books"}, "dest": {"index": "books_v2"}}
analyze: ["book", "of", "kings"]
   POST /_analyze
  body: {"analyzer": "standard", "text": "Book of Kings"}
index analyze: ["شاهنامه"]
delete index: true
   DELETE /books
