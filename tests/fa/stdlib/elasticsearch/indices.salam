واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19866
پایا تاییدیه := `{"acknowledged":true}`

تابع گام(برچسب: رشته، موفق: منطقی):
    سرچاپ برچسب، موفق
    سرچاپ "  "، جعلی.آخرین()
پایان

تابع ریشه:
    جعلی.ثبت‌پاسخ("PUT"، "/books"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("HEAD"، "/books"، 200، "")
    جعلی.ثبت‌پاسخ("GET"، "/books"، 200، `{"books":{"aliases":{},"settings":{}}}`)
    جعلی.ثبت‌پاسخ("GET"، "/books/_mapping"، 200، `{"books":{"mappings":{"properties":{"title":{"type":"text"}}}}}`)
    جعلی.ثبت‌پاسخ("PUT"، "/books/_mapping"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("GET"، "/books/_settings"، 200، `{"books":{"settings":{"index":{"number_of_replicas":"0"}}}}`)
    جعلی.ثبت‌پاسخ("PUT"، "/books/_settings"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("POST"، "/books/_refresh"، 200، `{"_shards":{"total":1}}`)
    جعلی.ثبت‌پاسخ("POST"، "/_refresh"، 200، `{"_shards":{"total":5}}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_flush"، 200، `{"_shards":{"total":1}}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_forcemerge"، 200، `{"_shards":{"total":1}}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_close"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("POST"، "/books/_open"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("PUT"، "/books/_alias/library"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("HEAD"، "/_alias/library"، 200، "")
    جعلی.ثبت‌پاسخ("GET"، "/_alias/library"، 200، `{"books":{"aliases":{"library":{}}},"books_v2":{"aliases":{"library":{}}}}`)
    جعلی.ثبت‌پاسخ("POST"، "/_aliases"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("DELETE"، "/books/_alias/library"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("PUT"، "/_index_template/books_tpl"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("HEAD"، "/_index_template/books_tpl"، 200، "")
    جعلی.ثبت‌پاسخ("DELETE"، "/_index_template/books_tpl"، 200، تاییدیه)
    جعلی.ثبت‌پاسخ("POST"، "/_reindex"، 200، `{"created":40,"updated":2}`)
    جعلی.ثبت‌پاسخ("POST"، "/_analyze"، 200، `{"tokens":[{"token":"book"},{"token":"of"},{"token":"kings"}]}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_analyze"، 200، `{"tokens":[{"token":"شاهنامه"}]}`)
    جعلی.ثبت‌پاسخ("DELETE"، "/books"، 200، تاییدیه)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا ک := الستیک سرچ.اتصال("http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))

    طرح‌نگاشت := `{"settings":{"number_of_shards":1},"mappings":{"properties":{"title":{"type":"text"},"year":{"type":"integer"}}}}`
    گام("create index:"، الستیک سرچ.ایجاد نمایه(ک، "books"، طرح‌نگاشت))
    سرچاپ "exists:"، الستیک سرچ.نمایه موجود است(ک، "books")، الستیک سرچ.نمایه موجود است(ک، "nope")
    سرچاپ "get index:"، الستیک سرچ.دریافت نمایه(ک، "books")
    سرچاپ "mapping:"، الستیک سرچ.دریافت نگاشت(ک، "books")
    گام("put mapping:"، الستیک سرچ.تنظیم نگاشت(ک، "books"، `{"properties":{"isbn":{"type":"keyword"}}}`))
    سرچاپ "settings:"، الستیک سرچ.دریافت تنظیمات(ک، "books")
    گام("put settings:"، الستیک سرچ.تنظیم تنظیمات(ک، "books"، `{"index":{"refresh_interval":"5s"}}`))
    گام("refresh:"، الستیک سرچ.تازه‌سازی(ک، "books"))
    گام("refresh all:"، الستیک سرچ.تازه‌سازی(ک، ""))
    گام("flush:"، الستیک سرچ.تخلیه(ک، "books"))
    گام("force merge:"، الستیک سرچ.ادغام اجباری(ک، "books"، 1))
    گام("close:"، الستیک سرچ.بستن نمایه(ک، "books"))
    گام("open:"، الستیک سرچ.گشودن نمایه(ک، "books"))
    گام("alias:"، الستیک سرچ.تنظیم نام مستعار(ک، "books"، "library"))
    سرچاپ "alias exists:"، الستیک سرچ.نام مستعار موجود است(ک، "library")
    سرچاپ "alias targets:"، الستیک سرچ.دریافت نام مستعار(ک، "library")
    گام("swap alias:"، الستیک سرچ.جابجایی نام مستعار(ک، "library"، "books"، "books_v2"))
    گام("delete alias:"، الستیک سرچ.حذف نام مستعار(ک، "books"، "library"))
    گام("template:"، الستیک سرچ.تنظیم الگوی نمایه(ک، "books_tpl"، `{"index_patterns":["books-*"],"template":{"settings":{"number_of_replicas":0}}}`))
    سرچاپ "template exists:"، الستیک سرچ.الگوی نمایه موجود است(ک، "books_tpl")
    گام("delete template:"، الستیک سرچ.حذف الگوی نمایه(ک، "books_tpl"))
    سرچاپ "reindex:"، الستیک سرچ.نمایه‌سازی دوباره(ک، "books"، "books_v2")
    سرچاپ "  "، جعلی.آخرین()
    سرچاپ "analyze:"، الستیک سرچ.تحلیل(ک، ""، "standard"، "Book of Kings")
    سرچاپ "  "، جعلی.آخرین()
    سرچاپ "index analyze:"، الستیک سرچ.تحلیل(ک، "books"، ""، "شاهنامه")
    گام("delete index:"، الستیک سرچ.حذف نمایه(ک، "books"))
    الستیک سرچ.بستن(ک)
