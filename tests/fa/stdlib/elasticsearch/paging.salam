واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19864

تابع صفحه(شناسه‌ها: رشته، شناسه‌پیمایش: رشته): رشته:
    برگشت `{"_scroll_id":"` + شناسه‌پیمایش + `","took":1,"hits":{"total":{"value":3,"relation":"eq"},"hits":[` + شناسه‌ها + `]}}`
پایان

تابع ریشه:
    جعلی.ثبت‌پاسخ("POST"، "/books/_search"، 200، صفحه(`{"_id":"1"},{"_id":"2"}`، "S1"))
    جعلی.ثبت‌پاسخ("POST"، "/_search/scroll"، 200، صفحه(`{"_id":"3"}`، "S1"))
    جعلی.ثبت‌پاسخ("POST"، "/_search/scroll"، 200، صفحه(""، "S1"))
    جعلی.ثبت‌پاسخ("DELETE"، "/_search/scroll"، 200، `{"succeeded":true,"num_freed":1}`)
    جعلی.ثبت‌پاسخ("GET"، "/"، 200، `{"version":{"number":"8.15.3"}}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_pit"، 200، `{"id":"PIT-1"}`)
    جعلی.ثبت‌پاسخ("POST"، "/_search"، 200، `{"pit_id":"PIT-1","hits":{"total":{"value":3,"relation":"eq"},"hits":[{"_id":"1","sort":[10,1]},{"_id":"2","sort":[20,2]}]}}`)
    جعلی.ثبت‌پاسخ("POST"، "/_search"، 200، `{"pit_id":"PIT-1","hits":{"total":{"value":3,"relation":"eq"},"hits":[{"_id":"3","sort":[30,3]}]}}`)
    جعلی.ثبت‌پاسخ("POST"، "/_search"، 200، `{"pit_id":"PIT-1","hits":{"total":{"value":3,"relation":"eq"},"hits":[]}}`)
    جعلی.ثبت‌پاسخ("DELETE"، "/_pit"، 200، `{"succeeded":true,"num_freed":1}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_msearch"، 200، `{"responses":[{"status":200,"hits":{"total":{"value":7,"relation":"eq"},"hits":[]}},{"status":400,"error":{"type":"parsing_exception","reason":"bad query"}}]}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_delete_by_query"، 200، `{"deleted":4}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_update_by_query"، 200، `{"updated":6}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا ک := الستیک سرچ.اتصال("http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))

    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    ترتیب.بیفزا(الستیک سرچ.مرتب صعودی("year"))
    ناپایا نتیجه := الستیک سرچ.جستجوی پیمایشی(ک، "books"، الستیک سرچ.درخواست جستجو { پرسمان = الستیک سرچ.تطبیق همه()، اندازه = 2، مرتب‌سازی = ترتیب }، "1m")
    سرچاپ "scroll start:"، جعلی.آخرین()
    ناپایا دیده‌شده := 0
    تا نتیجه.موفق و نتیجه.یافته‌ها.طول() بزرگتر 0:
        هر ی در نتیجه.یافته‌ها:
            سرچاپ "  scrolled"، ی.شناسه
        پایان
        دیده‌شده += نتیجه.یافته‌ها.طول()
        نتیجه = الستیک سرچ.پیمایش(ک، نتیجه.شناسه پیمایش، "1m")
    پایان
    سرچاپ "scroll next:"، جعلی.آخرین()
    سرچاپ "scrolled total:"، دیده‌شده، الستیک سرچ.پاک کردن پیمایش(ک، نتیجه.شناسه پیمایش)
    سرچاپ "  "، جعلی.آخرین()

    نقطه := الستیک سرچ.گشودن نقطه زمانی(ک، "books"، "1m")
    سرچاپ "pit:"، نقطه، جعلی.آخرین()
    ناپایا نشانگر := ""
    ناپایا ادامه := درست
    تا ادامه:
        ص := الستیک سرچ.جستجو(ک، ""، الستیک سرچ.درخواست جستجو { اندازه = 2، مرتب‌سازی = ترتیب، شناسه نقطه زمانی = نقطه، مدت نگهداری نقطه زمانی = "1m"، نشانگر ادامه = نشانگر })
        اگر ص.یافته‌ها.طول() برابر 0:
            ادامه = نادرست
        وگرنه:
            هر ی در ص.یافته‌ها:
                سرچاپ "  pit hit"، ی.شناسه، ی.مرتب‌سازی
            پایان
            نشانگر = ص.یافته‌ها.بگیر(ص.یافته‌ها.طول() - 1).مرتب‌سازی
        پایان
    پایان
    سرچاپ "pit page:"، جعلی.آخرین()
    سرچاپ "pit closed:"، الستیک سرچ.بستن نقطه زمانی(ک، نقطه)، جعلی.آخرین()

    ناپایا بدنه‌ها := وکتور {} برگردان وکتور<رشته>
    بدنه‌ها.بیفزا(الستیک سرچ.بدنه جستجو(الستیک سرچ.درخواست جستجو { پرسمان = الستیک سرچ.واژه("tag"، "a")، اندازه = 0 }))
    بدنه‌ها.بیفزا("{\n \"query\": {\"bogus\": {}}\n}")
    هر پ در الستیک سرچ.جستجوی چندگانه(ک، "books"، بدنه‌ها):
        سرچاپ "msearch:"، پ.موفق، پ.وضعیت، پ.کل، پ.خطا
    پایان
    سرچاپ "  "، جعلی.آخرین()

    سرچاپ "delete by query:"، الستیک سرچ.حذف با پرسمان(ک، "books"، الستیک سرچ.واژه("status"، "draft"))
    سرچاپ "  "، جعلی.آخرین()
    سرچاپ "with options:"، الستیک سرچ.حذف با پرسمان با گزینه(ک، "books"، ""، الستیک سرچ.گزینه‌ها { تازه‌سازی = الستیک سرچ.تازه‌سازی با انتظار، تعارض‌ها = "proceed"، مسیریابی = "r1" })
    سرچاپ "  "، جعلی.آخرین()
    سرچاپ "update by query:"، الستیک سرچ.به‌روزرسانی با پرسمان(ک، "books"، الستیک سرچ.واژه("tag"، "a")، الستیک سرچ.اسکریپت("ctx._source.views += 1"، ""))
    سرچاپ "  "، جعلی.آخرین()
    سرچاپ "update with:"، الستیک سرچ.به‌روزرسانی با پرسمان با گزینه(ک، "books"، ""، الستیک سرچ.اسکریپت("ctx._source.views = 0"، "")، الستیک سرچ.گزینه‌ها { تازه‌سازی = الستیک سرچ.تازه‌سازی فوری، مهلت = "1m" })
    سرچاپ "  "، جعلی.آخرین()
    الستیک سرچ.بستن(ک)
پایان
