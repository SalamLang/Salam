واردسازی دیتابیس.الستیک سرچ

تابع جفت(ج: رشته، د: رشته): وکتور<رشته>:
    ناپایا بردار := وکتور {} برگردان وکتور<رشته>
    بردار.بیفزا(ج)
    بردار.بیفزا(د)
    برگشت بردار
پایان

تابع یکی(ج: رشته): وکتور<رشته>:
    ناپایا بردار := وکتور {} برگردان وکتور<رشته>
    بردار.بیفزا(ج)
    برگشت بردار
پایان

تابع ریشه:
    سرچاپ "match all:"، الستیک سرچ.تطبیق همه()
    سرچاپ "match none:"، الستیک سرچ.تطبیق هیچ()
    سرچاپ "match:"، الستیک سرچ.تطبیق("title"، "persian poetry")
    سرچاپ "match and:"، الستیک سرچ.تطبیق همه واژه‌ها("title"، "persian poetry")
    سرچاپ "match fuzzy:"، الستیک سرچ.تطبیق تقریبی("title"، "shahname")
    سرچاپ "phrase:"، الستیک سرچ.تطبیق عبارت("title"، "book of kings")
    سرچاپ "phrase prefix:"، الستیک سرچ.تطبیق پیشوند عبارت("title"، "book of k")
    سرچاپ "multi match:"، الستیک سرچ.تطبیق چندگانه("ferdowsi"، جفت("title^3"، "body"))
    سرچاپ "term:"، الستیک سرچ.واژه("status"، "published")
    سرچاپ "term int:"، الستیک سرچ.واژه عددی("year"، 1010 برگردان صحیح۶۴)
    سرچاپ "term bool:"، الستیک سرچ.واژه منطقی("in_stock"، درست)
    سرچاپ "terms:"، الستیک سرچ.واژه‌ها("tags"، جفت("epic"، "classic"))
    سرچاپ "range:"، الستیک سرچ.بازه("year"، "900"، "1500")
    سرچاپ "open range:"، الستیک سرچ.بازه("price"، ""، "20")
    سرچاپ "exclusive:"، الستیک سرچ.بازه باز("published"، "now-1y"، "now")
    سرچاپ "exists:"، الستیک سرچ.فیلد موجود("isbn")
    سرچاپ "prefix:"، الستیک سرچ.پیشوند("author"، "ferd")
    سرچاپ "wildcard:"، الستیک سرچ.نویسه عام("author"، "f*si")
    سرچاپ "regexp:"، الستیک سرچ.عبارت باقاعده("isbn"، "97[89].*")
    سرچاپ "fuzzy:"، الستیک سرچ.تقریبی("author"، "ferdosi")
    سرچاپ "ids:"، الستیک سرچ.شناسه‌ها(جفت("1"، "2"))
    سرچاپ "query string:"، الستیک سرچ.رشته پرسمان("title:(epic OR poem) AND year:[900 TO 1500]")
    سرچاپ "simple:"، الستیک سرچ.رشته پرسمان ساده("epic +persian"، یکی("title"))
    بایدها := یکی(الستیک سرچ.تطبیق("title"، "poem"))
    پالایه := یکی(الستیک سرچ.بازه("year"، "900"، ""))
    شایدها := جفت(الستیک سرچ.واژه("tags"، "epic")، الستیک سرچ.واژه("tags"، "lyric"))
    نبایدها := یکی(الستیک سرچ.واژه("status"، "draft"))
    سرچاپ "bool:"، الستیک سرچ.ترکیب منطقی(بایدها، پالایه، شایدها، نبایدها)
    سرچاپ "should only:"، الستیک سرچ.ترکیب منطقی(وکتور {} برگردان وکتور<رشته>، وکتور {} برگردان وکتور<رشته>، شایدها، وکتور {} برگردان وکتور<رشته>)
    سرچاپ "and:"، الستیک سرچ.همه شرط‌ها(بایدها)
    سرچاپ "or:"، الستیک سرچ.یکی از شرط‌ها(شایدها)
    سرچاپ "not:"، الستیک سرچ.نقیض(الستیک سرچ.واژه("status"، "draft"))
    سرچاپ "filtered:"، الستیک سرچ.پالایش شده(الستیک سرچ.تطبیق("title"، "poem")، پالایه)
    سرچاپ "constant score:"، الستیک سرچ.امتیاز ثابت(الستیک سرچ.واژه("status"، "published"))
    سرچاپ "nested:"، الستیک سرچ.تودرتو("reviews"، الستیک سرچ.بازه("reviews.stars"، "4"، ""))
    سرچاپ "geo:"، الستیک سرچ.فاصله جغرافیایی("store"، 35.6892، 51.389، "5km")
    ناپایا بردارعددی := وکتور {} برگردان وکتور<اعشار۶۴>
    بردارعددی.بیفزا(0.12)
    بردارعددی.بیفزا(-0.5)
    بردارعددی.بیفزا(0.75)
    سرچاپ "knn:"، الستیک سرچ.نزدیک‌ترین همسایه‌ها("embedding"، بردارعددی، 10، 100)
    سرچاپ "sort:"، الستیک سرچ.مرتب صعودی("year")، الستیک سرچ.مرتب نزولی("_score")
    سرچاپ "highlight:"، الستیک سرچ.برجسته‌سازی(جفت("title"، "body"))
    سرچاپ "add member:"، الستیک سرچ.افزودن عضو(الستیک سرچ.تطبیق("title"، "poem")، "boost"، "2")
پایان
