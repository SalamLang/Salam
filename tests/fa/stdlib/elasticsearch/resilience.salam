واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19870
پایا درگاه‌مرده := 19871

تابع ریشه:
    جعلی.ثبت‌پاسخ("GET"، "/_cluster/health"، 503، `{"error":{"type":"cluster_block_exception","reason":"blocked by: [SERVICE_UNAVAILABLE/1/state not recovered]"},"status":503}`)
    جعلی.ثبت‌پاسخ("GET"، "/_cluster/health"، 200، `{"cluster_name":"library","status":"green","number_of_nodes":1}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_count"، 200، `{"count":7}`)
    جعلی.ثبت‌پاسخ("HEAD"، "/"، 200، "")
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    زنده := "http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴)
    مرده := "http://127.0.0.1:" + رشته.از عدد(درگاه‌مرده برگردان صحیح۶۴)

    ناپایا پیکر := الستیک سرچ.پیکربندی { max_retries = 2، timeout_ms = 2000 }
    پیکر.nodes.بیفزا(مرده)
    پیکر.nodes.بیفزا(زنده)
    ناپایا ک := الستیک سرچ.کارخواه تازه(پیکر)
    پیشین := جعلی.شمار()
    ی := الستیک سرچ.سلامت خوشه(ک)
    سرچاپ "health after a 503 and a dead node:"، ی.ok، ی.status، "requests that reached the server:"، جعلی.شمار() - پیشین
    سرچاپ "count:"، الستیک سرچ.شمارش(ک، "books"، "")
    سرچاپ "status:"، الستیک سرچ.وضعیت(ک)، "error:"، الستیک سرچ.خطا(ک).طول()

    تکرار 3:
        الستیک سرچ.پینگ(ک)
    پایان
    سرچاپ "pings go straight to the live node:"، الستیک سرچ.خطا(ک).طول() برابر 0
    الستیک سرچ.بستن(ک)

    ناپایا یکی := الستیک سرچ.اتصال(مرده)
    سرچاپ "dead node:"، الستیک سرچ.پینگ(یکی)، رشته.شامل است(الستیک سرچ.خطا(یکی)، "could not connect")
    الستیک سرچ.بستن(یکی)

    ناپایا پیکرساده := الستیک سرچ.پیکربندی { keep_alive = نادرست }
    پیکرساده.nodes.بیفزا(زنده)
    ناپایا ساده := الستیک سرچ.کارخواه تازه(پیکرساده)
    سرچاپ "keep_alive off:"، الستیک سرچ.پینگ(ساده)، الستیک سرچ.شمارش(ساده، "books"، "")
    الستیک سرچ.بستن(ساده)
پایان
