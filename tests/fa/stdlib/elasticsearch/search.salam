واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19862

تابع ریشه:
    پاسخ‌جستجو := `{"took":4,"timed_out":false,"hits":{"total":{"value":2,"relation":"eq"},"max_score":2.5,"hits":[{"_index":"books","_id":"1","_score":2.5,"_source":{"title":"Shahnameh"},"highlight":{"title":["<em>Shahnameh</em>"]},"fields":{"year":[1010]}},{"_index":"books","_id":"7","_score":1.25,"_source":{"title":"Garshasp-nama"},"sort":[1066,"7"]}]}}`
    جعلی.ثبت‌پاسخ("POST"، "/books/_search"، 200، پاسخ‌جستجو)
    جعلی.ثبت‌پاسخ("POST"، "/books,articles/_search"، 200، پاسخ‌جستجو)
    جعلی.ثبت‌پاسخ("POST"، "/_search"، 200، `{"took":1,"timed_out":true,"hits":{"total":{"value":10000,"relation":"gte"},"max_score":null,"hits":[]}}`)
    جعلی.ثبت‌پاسخ("POST"، "/books/_search"، 400، `{"error":{"root_cause":[{"type":"parsing_exception","reason":"unknown query [bogus]"}],"type":"search_phase_execution_exception","reason":"all shards failed"},"status":400}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا ک := الستیک سرچ.اتصال("http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))

    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    ترتیب.بیفزا(الستیک سرچ.مرتب نزولی("year"))
    ترتیب.بیفزا(الستیک سرچ.مرتب صعودی("_id"))
    ناپایا عنوان := وکتور {} برگردان وکتور<رشته>
    عنوان.بیفزا("title")
    ناپایا کنارگذاشته := وکتور {} برگردان وکتور<رشته>
    کنارگذاشته.بیفزا("secret")
    ناپایا افزوده := وکتور {} برگردان وکتور<رشته>
    افزوده.بیفزا(`"explain": false`)
    درخواست := الستیک سرچ.درخواست جستجو {
        query = الستیک سرچ.تطبیق("title"، "shahnameh")، from = 0، size = 2، sort = ترتیب، source = عنوان، source_excludes = کنارگذاشته، fields = عنوان، highlight = الستیک سرچ.برجسته‌سازی(عنوان)، post_filter = الستیک سرچ.واژه("status"، "published")، collapse = "author"، track_total_hits = "true"، min_score = "0.5"، timeout = "2s"، extra = افزوده
    }
    سرچاپ "body:"، الستیک سرچ.بدنه جستجو(درخواست)
    نتیجه := الستیک سرچ.جستجو(ک، "books"، درخواست)
    سرچاپ "search:"، نتیجه.ok، نتیجه.status، نتیجه.took، نتیجه.timed_out، نتیجه.total، نتیجه.total_relation، نتیجه.max_score، نتیجه.hits.طول()
    هر ی در نتیجه.hits:
        سرچاپ "  hit"، ی.index، ی.id، ی.score، ی.source
        سرچاپ "    highlight:"، ی.highlight، "fields:"، ی.fields، "sort:"، ی.sort
    پایان

    سریع := الستیک سرچ.جستجوی پرسمان(ک، "books,articles"، الستیک سرچ.تطبیق عبارت("title"، "book of kings")، 5)
    سرچاپ "query:"، سریع.total، جعلی.آخرین()
    خام := الستیک سرچ.جستجوی خام(ک، ""، `{"query":{"match_all":{}},"size":0}`)
    سرچاپ "raw:"، خام.ok، خام.timed_out، خام.total، خام.total_relation، خام.hits.طول()
    بی‌منبع := الستیک سرچ.بدنه جستجو(الستیک سرچ.درخواست جستجو { no_source = درست، size = 0، track_total_hits = "100" })
    سرچاپ "no source:"، بی‌منبع
    ناپایا بردارعددی := وکتور {} برگردان وکتور<اعشار۶۴>
    بردارعددی.بیفزا(0.1)
    بردارعددی.بیفزا(0.2)
    سرچاپ "knn body:"، الستیک سرچ.بدنه جستجو(الستیک سرچ.درخواست جستجو { knn = الستیک سرچ.نزدیک‌ترین همسایه‌ها("embedding"، بردارعددی، 3، 30)، size = 3 })
    خراب := الستیک سرچ.جستجوی خام(ک، "books"، `{"query":{"bogus":{}}}`)
    سرچاپ "error:"، خراب.ok، خراب.status، خراب.error
    تجزیه‌شده := الستیک سرچ.تجزیه نتیجه جستجو(`{"took":2,"hits":{"total":5,"hits":[{"_id":"x","_score":null}]},"_scroll_id":"S1","pit_id":"P1","suggest":{"s":[]}}`)
    سرچاپ "parsed:"، تجزیه‌شده.ok، تجزیه‌شده.total، تجزیه‌شده.total_relation، تجزیه‌شده.scroll_id، تجزیه‌شده.pit_id، تجزیه‌شده.suggest، تجزیه‌شده.hits.بگیر(0).id
    الستیک سرچ.بستن(ک)
پایان
