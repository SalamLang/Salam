واردسازی رشته
واردسازی دیتابیس
واردسازی دیتابیس.الستیک سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19868

تابع گزارش(رابط: پویا دیتابیس.اتصال):
    سرچاپ "conn:"، رابط.نوع()، رابط.معتبر()، رابط.پینگ()
    ردیف‌ها := رابط.پرسمان("SELECT author, COUNT(*) AS n FROM books GROUP BY author")
    تا ردیف‌ها.بعدی():
        سرچاپ "  group"، ردیف‌ها.متن(0)، ردیف‌ها.عدد صحیح(1)
    پایان
    ردیف‌ها.بستن()
    سرچاپ "exec:"، رابط.اجرا("DELETE FROM books")، رابط.خطا()
    تراکنش := رابط.شروع تراکنش()
    سرچاپ "tx:"، تراکنش.معتبر()، تراکنش.ثبت تراکنش()، تراکنش.بازگردانی()، رابط.شناسه آخرین درج()، رابط.تعداد تغییرات()
    سرچاپ "quote:"، رابط.نقل قول("it's")
پایان

تابع ریشه:
    جعلی.ثبت‌پاسخ("GET"، "/"، 200، `{"version":{"number":"8.15.3"}}`)
    جعلی.ثبت‌پاسخ("POST"، "/_sql"، 200، `{"columns":[{"name":"title","type":"text"},{"name":"year","type":"integer"},{"name":"price","type":"double"},{"name":"in_stock","type":"boolean"}],"rows":[["Shahnameh",1010,12.5,true],["Golestan",1258,null,false]],"cursor":"C1"}`)
    جعلی.ثبت‌پاسخ("POST"، "/_sql"، 200، `{"rows":[["Bustan",1257,9.0,true]]}`)
    جعلی.ثبت‌پاسخ("POST"، "/_sql"، 200، `{"columns":[{"name":"author","type":"keyword"},{"name":"n","type":"long"}],"rows":[["ferdowsi",70],["saadi",50]]}`)
    جعلی.ثبت‌پاسخ("POST"، "/_sql"، 200، "title\n---------\nShahnameh\n")
    جعلی.ثبت‌پاسخ("POST"، "/_sql/translate"، 200، `{"size":1000,"query":{"term":{"author":{"value":"saadi"}}}}`)
    جعلی.ثبت‌پاسخ("POST"، "/_sql"، 400، `{"error":{"type":"verification_exception","reason":"Unknown column [nope]"},"status":400}`)
    جعلی.ثبت‌پاسخ("HEAD"، "/"، 200، "")
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server did not start"
        برگشت
    پایان
    ناپایا ک := الستیک سرچ.اتصال("http://127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))

    ناپایا پارامترها := وکتور {} برگردان وکتور<رشته>
    پارامترها.بیفزا("900")
    پارامترها.بیفزا(`"poetry"`)
    ناپایا ردیف‌ها := الستیک سرچ.اس کیو ال با پارامتر(ک، "SELECT title, year, price, in_stock FROM books WHERE year > ? AND genre = ? ORDER BY year"، پارامترها، 2)
    سرچاپ "sent:"، جعلی.آخرین()
    سرچاپ "columns:"، ردیف‌ها.معتبر()، ردیف‌ها.تعداد ستون()، ردیف‌ها.نام ستون(0)، ردیف‌ها.نام نوع ستون(1)، ردیف‌ها.نوع ستون(1) برابر دیتابیس.نوع صحیح، ردیف‌ها.نوع ستون(2) برابر دیتابیس.نوع اعشاری
    تا ردیف‌ها.بعدی():
        سرچاپ "  row"، ردیف‌ها.متن(0)، ردیف‌ها.عدد صحیح(1)، ردیف‌ها.عدد صحیح۶۴(1)، ردیف‌ها.عدد اعشار(2)، ردیف‌ها.خالی است(2)، ردیف‌ها.عدد صحیح(3)
    پایان
    سرچاپ "next page:"، جعلی.آخرین()
    ردیف‌ها.بستن()

    گزارش(الستیک سرچ.اتصال عمومی(ک))

    چاپ "text: "، الستیک سرچ.متن اس کیو ال(ک، "SELECT title FROM books LIMIT 1")
    سرچاپ "translate:"، الستیک سرچ.ترجمه اس کیو ال(ک، "SELECT * FROM books WHERE author = 'saadi'")
    ناپایا خراب := الستیک سرچ.اس کیو ال(ک، "SELECT nope FROM books")
    سرچاپ "bad:"، خراب.معتبر()، خراب.خطا()
    خراب.بستن()
    الستیک سرچ.بستن(ک)
پایان
