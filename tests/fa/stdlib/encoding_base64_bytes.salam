بسته ریشه

واردسازی فشرده سازی
واردسازی کدگذاری

تابع ریشه:
    text := "salam"
    سرچاپ کدگذاری.کدگذاری بایت‌ها پایه۶۴(text برگردان تهی*، text.طول())
    سرچاپ کدگذاری.کدگذاری بایت‌ها پایه۶۴(text برگردان تهی*، 3)
    سرچاپ کدگذاری.کدگذاری بایت‌ها پایه۶۴(text برگردان تهی*، 0) برابر ""
    b := فشرده سازی.بافر از رشته("any bytes")
    تلاش:
        سرچاپ کدگذاری.کدگذاری بایت‌ها پایه۶۴(b.داده، b.طول)، کدگذاری.کدگشایی پایه۶۴(کدگذاری.کدگذاری بایت‌ها پایه۶۴(b.داده، b.طول))
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
پایان
