بسته ریشه

واردسازی محیط
واردسازی سیستم پرونده.مسیر
واردسازی ورودی خروجی
واردسازی سیستم عامل

تابع ریشه:
    p := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_env_dotenv_api.env")
    سیستم عامل.حذف(p)
    ورودی خروجی.نوشتن پرونده(p، "SALAM_DOTENV_A=first\nSALAM_DOTENV_B=second\n")
    محیط.حذف("SALAM_DOTENV_A")
    محیط.تنظیم("SALAM_DOTENV_B"، "preset")
    سرچاپ "loaded: "، محیط.بارگذاری نقطه‌محیط(p)
    سرچاپ "A: "، محیط.دریافت("SALAM_DOTENV_A")
    سرچاپ "B overridden: "، محیط.دریافت("SALAM_DOTENV_B")
    سرچاپ "missing file: "، محیط.بارگذاری نقطه‌محیط(مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_env_dotenv_missing.env"))
    سیستم عامل.حذف(p)
    محیط.حذف("SALAM_DOTENV_A")
    محیط.حذف("SALAM_DOTENV_B")
پایان
