بسته ریشه

واردسازی کدگذاری.پرونده محیط

تابع strict(text: رشته):
    تلاش:
        ناپایا d := پرونده محیط.تجزیه سخت گیرانه(text)
        سرچاپ نادرست، پرونده محیط.طول(d)، پرونده محیط.دریافت(d، "B")، پرونده محیط.دریافت(d، "C")
        پرونده محیط.آزادسازی(d)
    گرفتن خطا e:
        سرچاپ درست، e.است(نوع خطا.نحو)، e.پیام، e.خط
    پایان
پایان

تابع ریشه:
    strict("A=1\nB=two\nC=\"three words\"\n")
    strict("A=1\nthis is not a pair\nB=2\n")
    strict("A=\"open\nB=2\n")
    ناپایا lax := پرونده محیط.تجزیه("A=1\nthis is not a pair\nB=2\n")
    سرچاپ پرونده محیط.طول(lax)، پرونده محیط.معتبر("A=1\nB=2\n")، پرونده محیط.معتبر("A=1\nnope\n")
    پرونده محیط.آزادسازی(lax)
پایان
