بسته ریشه

واردسازی کدگذاری.پرونده محیط

تابع ریشه:
    تلاش:
        ناپایا سالم := پرونده محیط.تجزیه سخت گیرانه("A=1\nB=two\nC=\"three words\"\n")
        سرچاپ پرونده محیط.طول(سالم)، پرونده محیط.دریافت(سالم، "B")، پرونده محیط.دریافت(سالم، "C")
        پرونده محیط.آزادسازی(سالم)
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    تلاش:
        ناپایا ناسالم := پرونده محیط.تجزیه سخت گیرانه("A=1\nthis is not a pair\nB=2\n")
        سرچاپ پرونده محیط.طول(ناسالم)
        پرونده محیط.آزادسازی(ناسالم)
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.نحو)، e.پیام، e.جایگاه، e.خط، e.ستون
        سرچاپ e.به رشته()
    پایان
    تلاش:
        ناپایا باز مانده := پرونده محیط.تجزیه سخت گیرانه("A=\"open\nB=2\n")
        سرچاپ پرونده محیط.طول(باز مانده)
        پرونده محیط.آزادسازی(باز مانده)
    گرفتن خطا e:
        سرچاپ e.نام نوع()، e.پیام
    پایان
    ناپایا آسان‌گیر := پرونده محیط.تجزیه("A=1\nthis is not a pair\nB=2\n")
    سرچاپ پرونده محیط.طول(آسان‌گیر)، پرونده محیط.معتبر("A=1\nB=2\n")، پرونده محیط.معتبر("A=1\nnope\n")
    پرونده محیط.آزادسازی(آسان‌گیر)
پایان
