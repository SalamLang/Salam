بسته ریشه

واردسازی کدگذاری.پرونده محیط

تابع ریشه:
    تلاش:
        ناپایا good := پرونده محیط.تجزیه سخت گیرانه("A=1\nB=two\nC=\"three words\"\n")
        سرچاپ پرونده محیط.طول(good)، پرونده محیط.دریافت(good، "B")، پرونده محیط.دریافت(good، "C")
        پرونده محیط.آزادسازی(good)
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    تلاش:
        ناپایا bad := پرونده محیط.تجزیه سخت گیرانه("A=1\nthis is not a pair\nB=2\n")
        سرچاپ پرونده محیط.طول(bad)
        پرونده محیط.آزادسازی(bad)
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.نحو)، e.پیام، e.جایگاه، e.خط، e.ستون
        سرچاپ e.به رشته()
    پایان
    تلاش:
        ناپایا open := پرونده محیط.تجزیه سخت گیرانه("A=\"open\nB=2\n")
        سرچاپ پرونده محیط.طول(open)
        پرونده محیط.آزادسازی(open)
    گرفتن خطا e:
        سرچاپ e.نام نوع()، e.پیام
    پایان
    ناپایا lax := پرونده محیط.تجزیه("A=1\nthis is not a pair\nB=2\n")
    سرچاپ پرونده محیط.طول(lax)، پرونده محیط.معتبر("A=1\nB=2\n")، پرونده محیط.معتبر("A=1\nnope\n")
    پرونده محیط.آزادسازی(lax)
پایان
