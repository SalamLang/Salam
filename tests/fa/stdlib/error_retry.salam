بسته ریشه

واردسازی خطاها

تابع ریشه:
    timeout := خطا.جدید(نوع خطا.اتمام زمان، "slow upstream")
    down := خطا.جدید(نوع خطا.ناموجود، "service down")
    disk := خطا.جدید(نوع خطا.ورودی خروجی، "disk hiccup")
    missing := خطا.جدید(نوع خطا.یافت نشد، "no such key")

    سرچاپ "timeout retryable: "، خطاها.قابل تکرار است(timeout)
    سرچاپ "unavailable retryable: "، خطاها.قابل تکرار است(down)
    سرچاپ "io retryable: "، خطاها.قابل تکرار است(disk)
    سرچاپ "not found retryable: "، خطاها.قابل تکرار است(missing)

    ناپایا policy := خطاها.سیاست تکرار جدید(3، 100، 1000)
    سرچاپ "retry attempt 1: "، خطاها.باید تکرار شود(policy، timeout، 1)
    سرچاپ "retry attempt 2: "، خطاها.باید تکرار شود(policy، down، 2)
    سرچاپ "retry attempt 3: "، خطاها.باید تکرار شود(policy، timeout، 3)
    سرچاپ "never retry: "، خطاها.باید تکرار شود(policy، missing، 1)
پایان
