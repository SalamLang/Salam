بسته ریشه

واردسازی خطاها

تابع ریشه:
    خطای زمان := خطا.جدید(نوع خطا.اتمام زمان، "slow upstream")
    خطای خدمت := خطا.جدید(نوع خطا.ناموجود، "service down")
    خطای دیسک := خطا.جدید(نوع خطا.ورودی خروجی، "disk hiccup")
    خطای کلید := خطا.جدید(نوع خطا.یافت نشد، "no such key")

    سرچاپ "timeout retryable: "، خطاها.قابل تکرار است(خطای زمان)
    سرچاپ "unavailable retryable: "، خطاها.قابل تکرار است(خطای خدمت)
    سرچاپ "io retryable: "، خطاها.قابل تکرار است(خطای دیسک)
    سرچاپ "not found retryable: "، خطاها.قابل تکرار است(خطای کلید)

    ناپایا سیاست := خطاها.سیاست تکرار جدید(3، 100، 1000)
    سرچاپ "retry attempt 1: "، خطاها.باید تکرار شود(سیاست، خطای زمان، 1)
    سرچاپ "retry attempt 2: "، خطاها.باید تکرار شود(سیاست، خطای خدمت، 2)
    سرچاپ "retry attempt 3: "، خطاها.باید تکرار شود(سیاست، خطای زمان، 3)
    سرچاپ "never retry: "، خطاها.باید تکرار شود(سیاست، خطای کلید، 1)
پایان
