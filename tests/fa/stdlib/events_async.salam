بسته ریشه

واردسازی رویدادها
واردسازی حافظه

ناپایا total := 0
ناپایا last := 0
ناپایا ordered := درست
ناپایا seen := 0

تابع add(ev: رویدادها.رویداد<صحیح>):
    total += ev.داده
    اگر ev.داده نابرابر last + 1:
        ordered = نادرست
    پایان
    last = ev.داده
    seen++
پایان

تابع worker(p: رویدادها.انتشاردهنده<صحیح>*):
    رویدادها.پردازش صف(p[0])
پایان

تابع ریشه:
    e := رویدادها.جدید ناهمگام(4) برگردان رویدادها.انتشاردهنده<صحیح>
    box := حافظه.تخصیص صفرشده(اندازه‌گونه(رویدادها.انتشاردهنده<صحیح>) برگردان طبیعی۶۴) برگردان رویدادها.انتشاردهنده<صحیح>*
    box[0] = e
    th := نخ‌ساز(worker، box)
    _id := رویدادها.روی(e، "tick"، (ev: رویدادها.رویداد<صحیح>): add(ev) پایان)

    سرچاپ "first queued"، رویدادها.انتشار ناهمگام(e، "tick"، 1)
    تکرار 2 تا 200 در i:
        _ok := رویدادها.انتشار ناهمگام(e، "tick"، i)
    پایان
    رویدادها.تخلیه(e)
    سرچاپ "seen"، seen
    سرچاپ "total"، total
    سرچاپ "ordered"، ordered
    سرچاپ "pending"، رویدادها.در انتظار(e)

    _ok := رویدادها.انتشار ناهمگام(e، "tick"، 201)
    _ok2 := رویدادها.انتشار ناهمگام(e، "other"، 999)
    رویدادها.بستن(e)
    نخ‌پیوند(th)
    سرچاپ "after close seen"، seen
    سرچاپ "total"، total
    سرچاپ "emit after close"، رویدادها.انتشار ناهمگام(e، "tick"، 5)
    رویدادها.بستن(e)

    plain := رویدادها.جدید() برگردان رویدادها.انتشاردهنده<صحیح>
    سرچاپ "async on sync emitter"، رویدادها.انتشار ناهمگام(plain، "x"، 1)
    رویدادها.آزادکن(plain)
    رویدادها.آزادکن(e)
    حافظه.آزادسازی(box برگردان تهی*)
    برگشت 0
پایان
