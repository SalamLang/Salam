بسته ریشه

واردسازی رویدادها

ناپایا hits := 0

تابع ریشه:
    e := رویدادها.جدید() برگردان رویدادها.انتشاردهنده<صحیح>
    ناپایا ids := وکتور {} برگردان وکتور<صحیح>
    تکرار 100:
        ids.بیفزا(رویدادها.روی(e، "x"، (ev: رویدادها.رویداد<صحیح>): hits = hits + ev.داده پایان))
    پایان
    سرچاپ "len"، رویدادها.تعداد(e)
    سرچاپ "calls"، رویدادها.انتشار(e، "x"، 1)
    سرچاپ "hits"، hits
    سرچاپ "off"، رویدادها.خاموش(e، ids.بگیر(50))
    سرچاپ "calls"، رویدادها.انتشار(e، "x"، 1)
    سرچاپ "hits"، hits
    ids.آزادکن()
    رویدادها.آزادکن(e)
    برگشت 0
پایان
