بسته ریشه

واردسازی اکسل
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    پوشه آزمون := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_excel_direct")
    سیستم عامل.حذف همه(پوشه آزمون)
    سیستم عامل.ساخت پوشه ها(پوشه آزمون)
    ناپایا کتاب := اکسل.کتاب کار جدید()
    s := کتاب.افزودن برگه("Totals")
    s.تنظیم رشته(0، 0، "item")
    s.تنظیم رشته(0، 1، "qty")
    s.تنظیم رشته(1، 0، "tea")
    s.تنظیم عدد(1، 1، 12.5)
    s.تنظیم منطقی(2، 0، درست)
    s.تنظیم فرمول(2، 1، "B2*2"، 25.0)
    کتاب.افزودن برگه("Empty")

    پرونده اُدی‌اس := مسیر پرونده.پیوند(پوشه آزمون، "direct.ods")
    پرونده ایکس‌ال‌اس‌ایکس := مسیر پرونده.پیوند(پوشه آزمون، "direct.xlsx")
    سرچاپ اکسل.نوشتن اُدی‌اس(کتاب، پرونده اُدی‌اس)، اکسل.نوشتن ایکس‌ال‌اس‌ایکس(کتاب، پرونده ایکس‌ال‌اس‌ایکس)

    ناپایا موفق := نادرست
    ناپایا پیام خطا := ""
    ناپایا a := اکسل.خواندن اُدی‌اس(پرونده اُدی‌اس، موفق، پیام خطا)
    سرچاپ موفق، a.شمار برگه‌ها()، a.برگه در(0).نام، a.برگه در(1).نام
    t := a.برگه("Totals")
    سرچاپ t.دریافت رشته(0، 0)، t.دریافت رشته(1، 0)، t.دریافت عدد(1، 1)، t.دریافت منطقی(2، 0)، t.دریافت فرمول(2، 1)، t.شمار سطرها()، t.شمار ستون‌ها()

    ناپایا b := اکسل.خواندن ایکس‌ال‌اس‌ایکس(پرونده ایکس‌ال‌اس‌ایکس، موفق، پیام خطا)
    سرچاپ موفق، b.شمار برگه‌ها()، b.برگه در(0).نام
    u := b.برگه("Totals")
    سرچاپ u.دریافت رشته(0، 1)، u.دریافت رشته(1، 0)، u.دریافت عدد(1، 1)، u.دریافت منطقی(2، 0)، u.دریافت فرمول(2، 1)

    مسیر ناموجود := مسیر پرونده.پیوند(پوشه آزمون، "none.ods")
    _ := اکسل.خواندن اُدی‌اس(مسیر ناموجود، موفق، پیام خطا)
    سرچاپ موفق، پیام خطا نابرابر ""
    _ := اکسل.خواندن ایکس‌ال‌اس‌ایکس(مسیر ناموجود، موفق، پیام خطا)
    سرچاپ موفق، پیام خطا نابرابر ""
    _ := اکسل.خواندن ایکس‌ال‌اس‌ایکس(پرونده اُدی‌اس، موفق، پیام خطا)
    سرچاپ موفق
    _ := اکسل.خواندن اُدی‌اس(پرونده ایکس‌ال‌اس‌ایکس، موفق، پیام خطا)
    سرچاپ موفق

    a.آزادسازی()
    b.آزادسازی()
    کتاب.آزادسازی()
    سیستم عامل.حذف همه(پوشه آزمون)
پایان
