بسته ریشه

واردسازی اکسل
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_excel_direct")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا book := اکسل.کتاب کار جدید()
    s := book.افزودن برگه("Totals")
    s.تنظیم رشته(0، 0، "item")
    s.تنظیم رشته(0، 1، "qty")
    s.تنظیم رشته(1، 0، "tea")
    s.تنظیم عدد(1، 1، 12.5)
    s.تنظیم منطقی(2، 0، درست)
    s.تنظیم فرمول(2، 1، "B2*2"، 25.0)
    book.افزودن برگه("Empty")

    ods := مسیر پرونده.پیوند(dir، "direct.ods")
    xlsx := مسیر پرونده.پیوند(dir، "direct.xlsx")
    سرچاپ اکسل.نوشتن اُدی‌اس(book، ods)، اکسل.نوشتن ایکس‌ال‌اس‌ایکس(book، xlsx)

    ناپایا ok := نادرست
    ناپایا err := ""
    ناپایا a := اکسل.خواندن اُدی‌اس(ods، ok، err)
    سرچاپ ok، a.شمار برگه‌ها()، a.برگه در(0).نام، a.برگه در(1).نام
    t := a.برگه("Totals")
    سرچاپ t.دریافت رشته(0، 0)، t.دریافت رشته(1، 0)، t.دریافت عدد(1، 1)، t.دریافت منطقی(2، 0)، t.دریافت فرمول(2، 1)، t.شمار سطرها()، t.شمار ستون‌ها()

    ناپایا b := اکسل.خواندن ایکس‌ال‌اس‌ایکس(xlsx، ok، err)
    سرچاپ ok، b.شمار برگه‌ها()، b.برگه در(0).نام
    u := b.برگه("Totals")
    سرچاپ u.دریافت رشته(0، 1)، u.دریافت رشته(1، 0)، u.دریافت عدد(1، 1)، u.دریافت منطقی(2، 0)، u.دریافت فرمول(2، 1)

    missing := مسیر پرونده.پیوند(dir، "none.ods")
    _ := اکسل.خواندن اُدی‌اس(missing، ok، err)
    سرچاپ ok، err نابرابر ""
    _ := اکسل.خواندن ایکس‌ال‌اس‌ایکس(missing، ok، err)
    سرچاپ ok، err نابرابر ""
    _ := اکسل.خواندن ایکس‌ال‌اس‌ایکس(ods، ok، err)
    سرچاپ ok
    _ := اکسل.خواندن اُدی‌اس(xlsx، ok، err)
    سرچاپ ok

    a.آزادسازی()
    b.آزادسازی()
    book.آزادسازی()
    سیستم عامل.حذف همه(dir)
پایان
