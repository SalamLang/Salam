بسته ریشه

واردسازی قالب بندی
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه

تابع ریشه:
    مسیر := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_fmt_extra.txt")
    دیرکن حافظه.آزادسازی(مسیر برگردان تهی*)

    سرچاپ "formatted writes to a file"
    ناپایا آرگومان ها := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگومان ها.آزادکن()
    آرگومان ها.بیفزا("Tehran")
    آرگومان ها.بیفزا(قالب بندی.عدد صحیح(37 برگردان صحیح۶۴))
    f := سیستم عامل.بازکردن(مسیر، "wb")
    سرچاپ قالب بندی.قالب نوشتن(f، "{} is {} degrees\n"، آرگومان ها)
    سرچاپ قالب بندی.قالب نوشتن(f، "no placeholders\n"، آرگومان ها)
    ناپایا فهرست خالی := وکتور {} برگردان وکتور<رشته>
    دیرکن فهرست خالی.آزادکن()
    سرچاپ قالب بندی.قالب نوشتن(f، "plain text"، فهرست خالی)
    ورودی خروجی.بستن(f)
    چاپ ورودی خروجی.خواندن پرونده(مسیر)
    سرچاپ ""
    سرچاپ "---"
    سرچاپ قالب بندی.قالب رشته("{} is {} degrees"، آرگومان ها)
    سیستم عامل.حذف(مسیر)
پایان
