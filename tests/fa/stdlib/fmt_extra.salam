بسته ریشه

واردسازی قالب بندی
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه

تابع ریشه:
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_fmt_extra.txt")
    دیرکن حافظه.آزادسازی(path برگردان تهی*)

    سرچاپ "formatted writes to a file"
    ناپایا args := وکتور {} برگردان وکتور<رشته>
    دیرکن args.آزادکن()
    args.بیفزا("Tehran")
    args.بیفزا(قالب بندی.عدد صحیح(37 برگردان صحیح۶۴))
    f := سیستم عامل.بازکردن(path، "wb")
    سرچاپ قالب بندی.قالب نوشتن(f، "{} is {} degrees\n"، args)
    سرچاپ قالب بندی.قالب نوشتن(f، "no placeholders\n"، args)
    ناپایا empty := وکتور {} برگردان وکتور<رشته>
    دیرکن empty.آزادکن()
    سرچاپ قالب بندی.قالب نوشتن(f، "plain text"، empty)
    ورودی خروجی.بستن(f)
    چاپ ورودی خروجی.خواندن پرونده(path)
    سرچاپ ""
    سرچاپ "---"
    سرچاپ قالب بندی.قالب رشته("{} is {} degrees"، args)
    سیستم عامل.حذف(path)
پایان
