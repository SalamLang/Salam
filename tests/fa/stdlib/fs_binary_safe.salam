بسته ریشه

واردسازی آزمایش
واردسازی سیستم پرونده
واردسازی سیستم پرونده.مسیر
واردسازی سیستم عامل
واردسازی سیستم عامل.خطا
واردسازی رمزنگاری

تابع ریشه:
    دودویی := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_fs_binary_safe_fa.bin")
    متنی := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_fs_binary_safe_fa.txt")
    تهی := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_fs_binary_safe_fa.empty")
    گمشده := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_fs_binary_safe_fa_missing.bin")
    سیستم عامل.حذف(گمشده)

    ناپایا داده := وکتور {} برگردان وکتور<طبیعی۸>
    دیرکن داده.آزاد()
    تکرار 1000 در شماره:
        داده.افزودن(((شماره * 7) % 256) برگردان طبیعی۸)
    پایان
    آزمایش.ادعای برابری عدد(سیستم پرونده.نوشتن همه بایت‌ها(دودویی، داده)، 1000)
    آزمایش.ادعای برابری عدد۶۴(سیستم پرونده.اندازه(دودویی)، 1000 برگردان صحیح۶۴)

    بازخوانی := سیستم پرونده.خواندن همه بایت‌ها(دودویی)
    دیرکن بازخوانی.آزادکن()
    آزمایش.ادعای برابری عدد(بازخوانی.طول()، 1000)
    ناپایا یکسان := درست
    تکرار 1000 در شماره:
        اگر بازخوانی.دریافت(شماره) نابرابر داده.دریافت(شماره): یکسان = نادرست پایان
    پایان
    آزمایش.ادعای درستی(یکسان)

    آزمایش.ادعای برابری رشته(سیستم پرونده.هش ام‌دی۵(دودویی)، "de809ff794e91b68f9e91a2b7030bcb0")
    آزمایش.ادعای برابری رشته(
        سیستم پرونده.هش شا۱(دودویی)، "38f3aa587f4aa04965a359f9151092759b3a4c2a"
    )
    آزمایش.ادعای برابری رشته(
        سیستم پرونده.هش شا۲۵۶(دودویی)،
        "89f4ff56a25dd1db06a4ce6033603775d705fb96f30f8693733fef602a1ca532"
    )
    آزمایش.ادعای برابری رشته(
        سیستم پرونده.هش شا۵۱۲(دودویی)،
        "5c3d2be85b82f8ace3dbd4cf34e814cf68201a9f3e5730253ee42fd46fbe6db2e68ab158e76a103df431f3ad279d8fa3ff6b148e21ced56feb321a6d28d101f1"
    )

    آزمایش.ادعای درستی(سیستم پرونده.نوشتن متن(متنی، "salam, files") بزرگتربرابر 0)
    آزمایش.ادعای برابری رشته(سیستم پرونده.هش ام‌دی۵(متنی)، رمزنگاری.ام دی۵ شانزدهی("salam, files"))
    آزمایش.ادعای برابری رشته(سیستم پرونده.هش شا۱(متنی)، رمزنگاری.شا۱ شانزدهی("salam, files"))
    آزمایش.ادعای برابری رشته(سیستم پرونده.هش شا۲۵۶(متنی)، رمزنگاری.شا۲۵۶ شانزدهی("salam, files"))
    آزمایش.ادعای برابری رشته(سیستم پرونده.هش شا۵۱۲(متنی)، رمزنگاری.شا۵۱۲ شانزدهی("salam, files"))

    بردار خالی := وکتور {} برگردان وکتور<طبیعی۸>
    آزمایش.ادعای برابری عدد(
        سیستم پرونده.نوشتن همه بایت‌ها(تهی، بردار خالی)، 0
    )
    آزمایش.ادعای درستی(سیستم پرونده.وجود دارد(تهی))
    هیچ := سیستم پرونده.خواندن همه بایت‌ها(تهی)
    دیرکن هیچ.آزادکن()
    آزمایش.ادعای برابری عدد(هیچ.طول()، 0)
    آزمایش.ادعای برابری رشته(
        سیستم پرونده.هش شا۲۵۶(تهی)،
        "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    )

    خطا.پاک کردن خطا()
    نیست := سیستم پرونده.خواندن همه بایت‌ها(گمشده)
    دیرکن نیست.آزادکن()
    آزمایش.ادعای برابری عدد(نیست.طول()، 0)
    آزمایش.ادعای درستی(خطا.خطا دارد())
    آزمایش.ادعای برابری عدد(خطا.کد آخرین خطا()، خطا.خطای ورودی خروجی)
    آزمایش.ادعای برابری رشته(خطا.پیام آخرین خطا()، "read failed")
    آزمایش.ادعای برابری رشته(خطا.عملیات آخرین خطا()، "ReadAllBytes")
    آزمایش.ادعای برابری رشته(خطا.مسیر آخرین خطا()، گمشده)
    آزمایش.ادعای برابری عدد(خطا.کد سیستمی آخرین خطا()، 0)
    آزمایش.ادعای برابری عدد(خطا.آخرین خطا().کد، خطا.خطای ورودی خروجی)
    آزمایش.ادعای برابری رشته(سیستم پرونده.هش شا۲۵۶(گمشده)، "")
    آزمایش.ادعای برابری رشته(خطا.عملیات آخرین خطا()، "Sha256Hex")

    خطا.تنظیم خطا(خطا.پرونده یافت نشد، "gone"، "Probe"، ""، 2)
    آزمایش.ادعای برابری رشته(خطا.نام خطا(خطا.کد آخرین خطا())، "FileNotFound")
    آزمایش.ادعای برابری رشته(
        خطا.قالب‌بندی خطا(خطا.آخرین خطا())، "FileNotFound: gone [op=Probe] [sys=2]"
    )
    آزمایش.ادعای برابری رشته(خطا.توصیف آخرین خطا()، "FileNotFound: gone [op=Probe] [sys=2]")
    خطا.پاک کردن خطا()
    آزمایش.ادعای نادرستی(خطا.خطا دارد())

    اگر سلام سیستم لینوکس:
        پروک := سیستم پرونده.خواندن همه بایت‌ها("/proc/self/status")
        آزمایش.ادعای درستی(پروک.طول() بزرگتر 0)
        پروک.آزادکن()
    وگرنه:
        آزمایش.ادعای درستی(درست)
    پایان

    سیستم پرونده.حذف(دودویی)
    سیستم پرونده.حذف(متنی)
    سیستم پرونده.حذف(تهی)
    برگشت آزمایش.خلاصه()
پایان
