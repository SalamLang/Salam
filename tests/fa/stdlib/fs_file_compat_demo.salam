بسته ریشه

واردسازی آزمایش
واردسازی سیستم پرونده
واردسازی سیستم پرونده.پرونده
واردسازی سیستم عامل

تابع size_of(i: سیستم پرونده.اطلاعات پرونده): صحیح۶۴: برگشت i.اندازه پایان

تابع found(i: پرونده.اطلاعات پرونده): منطقی: برگشت i.وجود دارد پایان

تابع ریشه:
    dir := سیستم عامل.پوشه موقت()
    p := dir + "/salam_fs_compat.txt"
    q := dir + "/salam_fs_compat_copy.txt"
    r := dir + "/salam_fs_compat_moved.txt"
    پرونده.حذف(p)
    پرونده.حذف(q)
    پرونده.حذف(r)

    آزمایش.ادعای درستی(پرونده.نوشتن متن(p، "legacy") بزرگتربرابر 0)
    آزمایش.ادعای برابری رشته(پرونده.خواندن متن(p)، سیستم پرونده.خواندن متن(p))
    آزمایش.ادعای برابری رشته(پرونده.خواندن همه(p)، "legacy")
    آزمایش.ادعای برابری عدد(پرونده.خواندن خط‌ها(p).طول()، 1)
    آزمایش.ادعای برابری رشته(پرونده.خواندن بایت‌ها(p، 3)، "leg")
    آزمایش.ادعای درستی(پرونده.افزودن(p، "!") بزرگتربرابر 0)
    آزمایش.ادعای درستی(پرونده.نوشتن بایت‌ها(q، "bytes") بزرگتربرابر 0)
    آزمایش.ادعای برابری عدد(پرونده.نوشتن اتمی(q، "atomic")، 0)
    f := پرونده.بازکردن(q، "rb")
    آزمایش.ادعای درستی(f نابرابر پوچ)
    پرونده.بستن(f)

    آزمایش.ادعای برابری عدد(پرونده.کپی(p، q)، 0)
    آزمایش.ادعای درستی(پرونده.وجود دارد(q))
    آزمایش.ادعای برابری عدد(پرونده.جابجایی(q، r)، 0)
    آزمایش.ادعای برابری عدد(پرونده.تغییر نام(r، q)، 0)
    آزمایش.ادعای برابری عدد۶۴(پرونده.اندازه(q)، 7 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد۶۴(size_of(پرونده.وضعیت(q))، سیستم پرونده.اندازه(q))
    آزمایش.ادعای درستی(found(سیستم پرونده.وضعیت(q)))
    آزمایش.ادعای برابری عدد۶۴(پرونده.زمان تغییر(p)، سیستم پرونده.زمان تغییر(p))
    آزمایش.ادعای درستی(پرونده.زمان دسترسی(p) بزرگتر 0)
    آزمایش.ادعای درستی(پرونده.زمان ایجاد(p) بزرگتربرابر 0)
    آزمایش.ادعای برابری عدد(پرونده.تغییر مجوز(p، 420)، 0)
    آزمایش.ادعای برابری عدد(پرونده.مجوزها(p)، سیستم پرونده.مجوزها(p))
    آزمایش.ادعای برابری رشته(پرونده.پسوند(p)، ".txt")
    آزمایش.ادعای برابری رشته(پرونده.نوع مایم("x.json")، "application/json")
    آزمایش.ادعای برابری رشته(پرونده.هش ام‌دی۵(p)، سیستم پرونده.هش ام‌دی۵(p))
    آزمایش.ادعای برابری رشته(پرونده.هش شا۱(p)، سیستم پرونده.هش شا۱(p))
    آزمایش.ادعای برابری رشته(پرونده.هش شا۲۵۶(p)، سیستم پرونده.هش شا۲۵۶(p))
    آزمایش.ادعای برابری رشته(پرونده.هش شا۵۱۲(p)، سیستم پرونده.هش شا۵۱۲(p))
    آزمایش.ادعای برابری عدد(پرونده.حذف(p)، 0)
    آزمایش.ادعای برابری عدد(پرونده.حذف(q)، 0)
    آزمایش.ادعای نادرستی(سیستم پرونده.وجود دارد(p))
    برگشت آزمایش.خلاصه()
پایان
