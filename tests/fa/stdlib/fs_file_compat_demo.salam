بسته ریشه

واردسازی آزمایش
واردسازی سیستم پرونده
واردسازی سیستم پرونده.پرونده
واردسازی سیستم عامل

تابع size_of(i: سیستم پرونده.اطلاعات پرونده): صحیح۶۴: برگشت i.اندازه پایان

تابع ریشه:
    p := سیستم عامل.پوشه موقت() + "/salam_fs_compat.txt"
    q := سیستم عامل.پوشه موقت() + "/salam_fs_compat_copy.txt"
    پرونده.حذف(p)
    پرونده.حذف(q)

    آزمایش.ادعای درستی(پرونده.نوشتن متن(p، "legacy") بزرگتربرابر 0)
    آزمایش.ادعای برابری رشته(پرونده.خواندن متن(p)، سیستم پرونده.خواندن متن(p))
    آزمایش.ادعای برابری رشته(پرونده.خواندن همه(p)، "legacy")
    آزمایش.ادعای برابری عدد(پرونده.خواندن خط‌ها(p).طول()، 1)
    آزمایش.ادعای برابری عدد(پرونده.کپی(p، q)، 0)
    آزمایش.ادعای درستی(پرونده.وجود دارد(q))
    آزمایش.ادعای برابری عدد۶۴(پرونده.اندازه(q)، 6 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد۶۴(size_of(پرونده.وضعیت(q))، سیستم پرونده.اندازه(q))
    آزمایش.ادعای برابری عدد۶۴(پرونده.زمان تغییر(p)، سیستم پرونده.زمان تغییر(p))
    آزمایش.ادعای برابری رشته(پرونده.نوع مایم("x.json")، "application/json")
    آزمایش.ادعای برابری رشته(پرونده.هش ام‌دی۵(p)، سیستم پرونده.هش ام‌دی۵(p))
    آزمایش.ادعای برابری عدد(پرونده.حذف(p)، 0)
    آزمایش.ادعای برابری عدد(پرونده.حذف(q)، 0)
    آزمایش.ادعای نادرستی(سیستم پرونده.وجود دارد(p))
    برگشت آزمایش.خلاصه()
پایان
