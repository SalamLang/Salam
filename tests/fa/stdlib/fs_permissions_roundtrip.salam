بسته ریشه

واردسازی آزمایش
واردسازی سیستم پرونده
واردسازی سیستم پرونده.مسیر
واردسازی سیستم عامل

تابع هدف(حالت: صحیح): صحیح:
    ناپایا نتیجه := حالت
    اگر سلام سیستم ویندوز:
        نتیجه = (حالت & 0o200) نابرابر 0 ? 0o666 : 0o444
    پایان
    برگشت نتیجه
پایان

تابع ریشه:
    آزمون := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_fs_perm_roundtrip_fa.txt")
    گمشده := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_fs_perm_roundtrip_fa_missing.txt")
    سیستم عامل.حذف(گمشده)
    آزمایش.ادعای درستی(سیستم پرونده.نوشتن متن(آزمون، "x") بزرگتربرابر 0)

    هر حالت در [0o640، 0o755، 0o600، 0o444، 0o644]:
        آزمایش.ادعای برابری عدد(سیستم پرونده.تغییر مجوز(آزمون، حالت)، 0)
        فعلی := سیستم پرونده.مجوزها(آزمون)
        آزمایش.ادعای برابری عدد(فعلی، هدف(حالت))
        آزمایش.ادعای برابری عدد(سیستم پرونده.تغییر مجوز(آزمون، فعلی)، 0)
        آزمایش.ادعای برابری عدد(سیستم پرونده.مجوزها(آزمون)، فعلی)
        آزمایش.ادعای برابری عدد(سیستم پرونده.وضعیت(آزمون).مجوزها، فعلی)
    پایان

    اطلاعات := سیستم پرونده.وضعیت(آزمون)
    آزمایش.ادعای درستی(اطلاعات.وجود دارد)
    آزمایش.ادعای برابری عدد۶۴(اطلاعات.اندازه، 1 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد۶۴(اطلاعات.زمان تغییر، سیستم پرونده.زمان تغییر(آزمون))
    آزمایش.ادعای درستی(اطلاعات.زمان تغییر بزرگتر 0)
    آزمایش.ادعای درستی(اطلاعات.زمان دسترسی بزرگتر 0)
    آزمایش.ادعای درستی(اطلاعات.زمان ایجاد بزرگتربرابر 0)

    آزمایش.ادعای برابری عدد(سیستم پرونده.مجوزها(گمشده)، 0 - 1)
    آزمایش.ادعای برابری عدد۶۴(سیستم پرونده.زمان تغییر(گمشده)، 0 - 1)
    آزمایش.ادعای برابری عدد۶۴(سیستم پرونده.زمان دسترسی(گمشده)، 0 - 1)
    آزمایش.ادعای برابری عدد۶۴(سیستم پرونده.زمان ایجاد(گمشده)، 0 - 1)
    آزمایش.ادعای برابری عدد(سیستم پرونده.تغییر مجوز(گمشده، 0o644)، 0 - 1)
    آزمایش.ادعای نادرستی(سیستم پرونده.وضعیت(گمشده).وجود دارد)

    آزمایش.ادعای برابری عدد(سیستم پرونده.حذف(آزمون)، 0)
    برگشت آزمایش.خلاصه()
پایان
