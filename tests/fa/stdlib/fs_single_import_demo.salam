بسته ریشه

واردسازی آزمایش
واردسازی سیستم پرونده
واردسازی سیستم عامل

تابع ریشه:
    dir := سیستم عامل.پوشه موقت()
    a := dir + "/salam_fs_single_a.txt"
    b := dir + "/salam_fs_single_b.txt"
    c := dir + "/salam_fs_single_c.txt"
    سیستم پرونده.حذف(a)
    سیستم پرونده.حذف(b)
    سیستم پرونده.حذف(c)

    آزمایش.ادعای درستی(سیستم پرونده.نوشتن متن(a، "one\ntwo\n") بزرگتربرابر 0)
    آزمایش.ادعای برابری رشته(سیستم پرونده.خواندن متن(a)، "one\ntwo\n")
    آزمایش.ادعای برابری رشته(سیستم پرونده.خواندن همه(a)، "one\ntwo\n")
    آزمایش.ادعای برابری عدد(سیستم پرونده.خواندن خط‌ها(a).طول()، 2)
    آزمایش.ادعای درستی(سیستم پرونده.افزودن(a، "three\n") بزرگتربرابر 0)
    آزمایش.ادعای برابری عدد(سیستم پرونده.خواندن خط‌ها(a).طول()، 3)
    آزمایش.ادعای برابری رشته(سیستم پرونده.خواندن بایت‌ها(a، 3)، "one")
    آزمایش.ادعای درستی(سیستم پرونده.نوشتن بایت‌ها(b، "raw") بزرگتربرابر 0)
    آزمایش.ادعای برابری رشته(سیستم پرونده.خواندن متن(b)، "raw")
    آزمایش.ادعای برابری عدد(سیستم پرونده.نوشتن اتمی(b، "atomic")، 0)
    آزمایش.ادعای برابری رشته(سیستم پرونده.خواندن متن(b)، "atomic")

    f := سیستم پرونده.بازکردن(a، "rb")
    آزمایش.ادعای درستی(f نابرابر پوچ)
    سیستم پرونده.بستن(f)

    آزمایش.ادعای برابری عدد(سیستم پرونده.کپی(a، b)، 0)
    آزمایش.ادعای برابری رشته(سیستم پرونده.خواندن متن(b)، سیستم پرونده.خواندن متن(a))
    آزمایش.ادعای برابری عدد(سیستم پرونده.جابجایی(b، c)، 0)
    آزمایش.ادعای نادرستی(سیستم پرونده.وجود دارد(b))
    آزمایش.ادعای درستی(سیستم پرونده.وجود دارد(c))
    آزمایش.ادعای برابری عدد(سیستم پرونده.تغییر نام(c، b)، 0)
    آزمایش.ادعای برابری عدد(سیستم پرونده.جابجایی(b، c)، 0)
    آزمایش.ادعای برابری رشته(سیستم پرونده.پسوند(c)، ".txt")

    info := سیستم پرونده.وضعیت(c)
    آزمایش.ادعای درستی(info.وجود دارد)
    آزمایش.ادعای برابری عدد۶۴(info.اندازه، 14 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(سیستم پرونده.زمان تغییر(c) بزرگتر 0)
    آزمایش.ادعای برابری عدد۶۴(سیستم پرونده.اندازه(c)، info.اندازه)
    آزمایش.ادعای برابری عدد(سیستم پرونده.تغییر مجوز(c، 420)، 0)
    آزمایش.ادعای برابری عدد(سیستم پرونده.مجوزها(c)، 644)
    آزمایش.ادعای درستی(سیستم پرونده.زمان دسترسی(c) بزرگتر 0)
    آزمایش.ادعای درستی(سیستم پرونده.زمان ایجاد(c) بزرگتربرابر 0)
    آزمایش.ادعای برابری رشته(سیستم پرونده.نوع مایم(c)، "text/plain")
    آزمایش.ادعای برابری رشته(سیستم پرونده.هش شا۲۵۶(a)، سیستم پرونده.هش شا۲۵۶(c))
    آزمایش.ادعای برابری عدد(سیستم پرونده.هش شا۱(c).طول()، 40)
    آزمایش.ادعای برابری عدد(سیستم پرونده.هش شا۵۱۲(c).طول()، 128)
    آزمایش.ادعای برابری عدد(سیستم پرونده.هش ام‌دی۵(c).طول()، 32)

    آزمایش.ادعای برابری عدد(سیستم پرونده.حذف(a)، 0)
    آزمایش.ادعای برابری عدد(سیستم پرونده.حذف(c)، 0)
    آزمایش.ادعای نادرستی(سیستم پرونده.وضعیت(a).وجود دارد)
    برگشت آزمایش.خلاصه()
پایان
