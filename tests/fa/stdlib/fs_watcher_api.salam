واردسازی سیستم پرونده.ناظر
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع ریشه:
    پوشه := سیستم عامل.پوشه موقت() + "/salam_watch_api_fa_" + رشته.از عدد(سیستم عامل.شناسه فرآیند())
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه)
    ورودی خروجی.نوشتن پرونده(پوشه + "/a.txt"، "one")
    ناپایا ناظر۱ := ناظر.جدید(پوشه)
    سرچاپ ناظر.آماده است(ناظر۱)
    ناظر.تصویر فوری(ناظر۱)
    سرچاپ ناظر.آماده است(ناظر۱)
    سرچاپ رشته.پایان با(ناظر.ریشه(ناظر۱)، "salam_watch_api_fa_" + رشته.از عدد(سیستم عامل.شناسه فرآیند()))
    سرچاپ رشته.طول(ناظر.پشتیبان(ناظر۱)) بزرگتر 0
    سرچاپ ناظر.بومی است(ناظر۱) یا رشته.یکسان است(ناظر.پشتیبان(ناظر۱)، "polling")
    ناپایا بیکار := ناظر.بررسی(ناظر۱)
    سرچاپ بیکار.طول()
    ناظر.آزادسازی رویدادها(بیکار)
    ورودی خروجی.نوشتن پرونده(پوشه + "/b.txt"، "two")
    ناپایا دیده := ناظر.بررسی با تاخیر(ناظر۱، 10)
    سرچاپ دیده.طول()
    ناظر.آزادسازی رویدادها(دیده)
    ورودی خروجی.نوشتن پرونده(پوشه + "/c.txt"، "three")
    ناظر.بازنشانی(ناظر۱)
    ناپایا آرام := ناظر.بررسی(ناظر۱)
    سرچاپ آرام.طول()
    ناظر.آزادسازی رویدادها(آرام)
    ناظر.آزادسازی(ناظر۱)
    سیستم عامل.حذف همه(پوشه)
پایان
