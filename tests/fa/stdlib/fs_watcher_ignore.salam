واردسازی سیستم پرونده.ناظر
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع شمار(رویدادها &: وکتور<ناظر.رویداد>، نوع: ناظر.نوع رویداد، پسوند: رشته): صحیح:
    ناپایا تعداد := 0
    تکرار رویدادها.طول() در ا:
        ر := رویدادها.دریافت(ا)
        اگر ر.نوع برابر نوع و رشته.پایان با(ر.مسیر، پسوند):
            تعداد++
        پایان
    پایان
    برگشت تعداد
پایان

تابع ریشه:
    پوشه := سیستم عامل.پوشه موقت() + "/salam_watch_ignore_fa_" + رشته.از عدد(سیستم عامل.شناسه فرآیند())
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه + "/src")
    سیستم عامل.ساخت پوشه ها(پوشه + "/node_modules")
    ورودی خروجی.نوشتن پرونده(پوشه + "/src/a.salam"، "one")
    ناپایا ناظر۱ := ناظر.جدید(پوشه)
    ناظر.نادیده گرفتن(ناظر۱، "node_modules")
    ناظر.نادیده گرفتن پنهان ها(ناظر۱)
    ناظر.تصویر فوری(ناظر۱)

    ورودی خروجی.نوشتن پرونده(پوشه + "/src/b.salam"، "two")
    ورودی خروجی.نوشتن پرونده(پوشه + "/src/a.salam"، "one more")
    ورودی خروجی.نوشتن پرونده(پوشه + "/node_modules/x.js"، "x")
    ورودی خروجی.نوشتن پرونده(پوشه + "/.hidden"، "h")
    ورودی خروجی.نوشتن پرونده(پوشه + "/src/a.salam.swp"، "s")
    ناپایا رویدادها := ناظر.بررسی آرام(ناظر۱، 50)
    سرچاپ شمار(رویدادها، ناظر.نوع رویداد.ساخته شد، "b.salam")
    سرچاپ شمار(رویدادها، ناظر.نوع رویداد.تغییر کرد، "a.salam")
    سرچاپ شمار(رویدادها، ناظر.نوع رویداد.ساخته شد، "x.js")
    سرچاپ شمار(رویدادها، ناظر.نوع رویداد.ساخته شد، ".hidden")
    سرچاپ شمار(رویدادها، ناظر.نوع رویداد.ساخته شد، ".swp")
    ناظر.آزادسازی رویدادها(رویدادها)

    سیستم عامل.حذف(پوشه + "/src/b.salam")
    ناپایا رفته := ناظر.بررسی آرام(ناظر۱، 50)
    سرچاپ شمار(رفته، ناظر.نوع رویداد.حذف شد، "b.salam")
    ناظر.آزادسازی رویدادها(رفته)
    ناپایا آرام := ناظر.بررسی آرام(ناظر۱، 50)
    سرچاپ آرام.طول()
    ناظر.آزادسازی رویدادها(آرام)
    ناظر.آزادسازی(ناظر۱)
    سیستم عامل.حذف همه(پوشه)
پایان
