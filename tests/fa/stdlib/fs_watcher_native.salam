واردسازی سیستم پرونده.ناظر
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع شمار(رویدادها &: وکتور<ناظر.رویداد>، نوع: ناظر.نوع رویداد، پسوند: رشته): صحیح:
    ناپایا تعداد := 0
    تکرار رویدادها.طول() در ا:
        ر := رویدادها.دریافت(ا)
        اگر ر.نوع برابر نوع و رشته.پایان با(ر.مسیر، پسوند):
            تعداد++
        پایان
    پایان
    برگشت تعداد
پایان

تابع ریشه:
    پوشه := سیستم عامل.پوشه موقت() + "/salam_watch_native_fa_" + رشته.از عدد(سیستم عامل.شناسه فرآیند())
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه)
    ورودی خروجی.نوشتن پرونده(پوشه + "/a.txt"، "aaaa")
    ناپایا ناظر۱ := ناظر.جدید(پوشه)
    ناظر.تصویر فوری(ناظر۱)

    ورودی خروجی.نوشتن پرونده(پوشه + "/b.txt"، "new")
    سرچاپ ناظر.انتظار(ناظر۱، 300)
    ناپایا الف := ناظر.بررسی آرام(ناظر۱، 30)
    سرچاپ شمار(الف، ناظر.نوع رویداد.ساخته شد، "b.txt")
    ناظر.آزادسازی رویدادها(الف)

    سیستم عامل.ساخت پوشه ها(پوشه + "/sub/deep")
    سرچاپ ناظر.انتظار(ناظر۱، 300)
    ناپایا ب := ناظر.بررسی آرام(ناظر۱، 30)
    سرچاپ شمار(ب، ناظر.نوع رویداد.ساخته شد، "deep")
    ناظر.آزادسازی رویدادها(ب)

    ورودی خروجی.نوشتن پرونده(پوشه + "/sub/deep/n.txt"، "x")
    سرچاپ ناظر.انتظار(ناظر۱، 300)
    ناپایا پ := ناظر.بررسی آرام(ناظر۱، 30)
    سرچاپ شمار(پ، ناظر.نوع رویداد.ساخته شد، "n.txt")
    ناظر.آزادسازی رویدادها(پ)

    ورودی خروجی.نوشتن پرونده(پوشه + "/a.txt"، "bbbb")
    سرچاپ ناظر.انتظار(ناظر۱، 300)
    ناپایا ت := ناظر.بررسی آرام(ناظر۱، 30)
    سرچاپ شمار(ت، ناظر.نوع رویداد.تغییر کرد، "a.txt")
    ناظر.آزادسازی رویدادها(ت)

    سیستم عامل.حذف(پوشه + "/b.txt")
    سرچاپ ناظر.انتظار(ناظر۱، 300)
    ناپایا ث := ناظر.بررسی آرام(ناظر۱، 30)
    سرچاپ شمار(ث، ناظر.نوع رویداد.حذف شد، "b.txt")
    ناظر.آزادسازی رویدادها(ث)

    ناظر.آزادسازی(ناظر۱)
    سیستم عامل.حذف همه(پوشه)
پایان
