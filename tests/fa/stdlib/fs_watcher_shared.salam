واردسازی سیستم پرونده.ناظر
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع ساخته شده ها(رویدادها &: وکتور<ناظر.رویداد>، پسوند: رشته): صحیح:
    ناپایا تعداد := 0
    تکرار رویدادها.طول() در ا:
        ر := رویدادها.دریافت(ا)
        اگر ر.نوع برابر ناظر.نوع رویداد.ساخته شد و رشته.پایان با(ر.مسیر، پسوند):
            تعداد++
        پایان
    پایان
    برگشت تعداد
پایان

تابع ریشه:
    پوشه := سیستم عامل.پوشه موقت() + "/salam_watch_shared_fa_" + رشته.از عدد(سیستم عامل.شناسه فرآیند())
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه + "/real")
    پیوند := سیستم عامل.اجرا("ln -s " + پوشه + "/real " + پوشه + "/alias") برابر 0
    ناپایا ناظر۱ := ناظر.جدید(پوشه)
    ناظر.تصویر فوری(ناظر۱)
    اگر پیوند:
        سیستم عامل.حذف(پوشه + "/alias")
    پایان
    ناپایا اول := ناظر.بررسی آرام(ناظر۱، 20)
    ناظر.آزادسازی رویدادها(اول)
    _تخلیه := ناظر.انتظار(ناظر۱، 50)
    سرچاپ پیوند
    ورودی خروجی.نوشتن پرونده(پوشه + "/real/new.txt"، "x")
    سرچاپ ناظر.انتظار(ناظر۱، 500)
    ناپایا دیده := ناظر.بررسی آرام(ناظر۱، 20)
    سرچاپ ساخته شده ها(دیده، "new.txt")
    ناظر.آزادسازی رویدادها(دیده)
    ناظر.آزادسازی(ناظر۱)
    سیستم عامل.حذف همه(پوشه)
پایان
