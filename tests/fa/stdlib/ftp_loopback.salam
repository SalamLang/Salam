بسته ریشه

واردسازی اف‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی تی ال اس
واردسازی رشته
واردسازی همگام سازی
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی سیستم پرونده.پرونده
واردسازی سیستم پرونده.پوشه
واردسازی آزمایش

پایا PORT := 19921
پایا DPORT := 19922
پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"
پایا SESSIONS := 5

ناپایا wg := همگام سازی.گروه انتظار جدید()

ساختار Fs:
    همگانی names: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
    همگانی blobs: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
    همگانی dirs: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
پایان

ساختار Sess:
    همگانی ctl: تی سی پی.اتصال شبکه = تی سی پی.اتصال شبکه {}
    همگانی sc: تی ال اس.اتصال = تی ال اس.اتصال {}
    همگانی dc: تی سی پی.اتصال شبکه = تی سی پی.اتصال شبکه {}
    همگانی dtc: تی ال اس.اتصال = تی ال اس.اتصال {}
    همگانی secure: منطقی = نادرست
    همگانی prot: منطقی = نادرست
    همگانی dsecure: منطقی = نادرست
    همگانی epsv: منطقی = نادرست
    همگانی alive: منطقی = نادرست
    همگانی buf: رشته = ""
    همگانی cwd: رشته = "/"
    همگانی rnfr: رشته = ""
پایان

تابع recv_line(s &: Sess): رشته:
    تا s.alive:
        at := s.buf.بیاب("\r\n")
        اگر at بزرگتربرابر 0:
            line := s.buf.زیررشته(0، at)
            s.buf = s.buf.زیررشته(at + 2، s.buf.طول() - at - 2)
            برگشت line
        پایان
        ناپایا chunk := ""
        اگر s.secure:
            chunk = تی ال اس.خواندن(s.sc، 4096)
        وگرنه:
            chunk = تی سی پی.خواندن(s.ctl، 4096)
        پایان
        اگر chunk.طول() برابر 0:
            s.alive = نادرست
        وگرنه:
            s.buf += chunk
        پایان
    پایان
    برگشت ""
پایان

تابع say(s &: Sess، line: رشته):
    اگر s.secure:
        _ := تی ال اس.نوشتن(s.sc، line + "\r\n")
    وگرنه:
        _ := تی سی پی.نوشتن(s.ctl، line + "\r\n")
    پایان
پایان

تابع absolute(cwd: رشته، p: رشته): رشته:
    ناپایا raw := p
    اگر وارونه رشته.شروع با(raw، "/"):
        اگر cwd برابر "/":
            raw = "/" + raw
        وگرنه:
            raw = cwd + "/" + raw
        پایان
    پایان
    parts := رشته.تفکیک کردن(raw، "/")
    ناپایا out := وکتور {} برگردان وکتور<رشته>
    هر part در parts:
        اگر part برابر "..":
            اگر out.طول() بزرگتر 0:
                _ := out.دربیاور()
            پایان
        وگرنه part نابرابر "" و part نابرابر ".":
            out.بیفزا(part)
        پایان
    پایان
    اگر out.طول() برابر 0:
        برگشت "/"
    پایان
    برگشت "/" + رشته.بپیوند(out، "/")
پایان

تابع parent_of(p: رشته): رشته:
    ناپایا slash := 0 - 1
    تکرار p.طول() در i:
        اگر p.زیررشته(i، 1) برابر "/":
            slash = i
        پایان
    پایان
    اگر slash کوچکتربرابر 0:
        برگشت "/"
    پایان
    برگشت p.زیررشته(0، slash)
پایان

تابع base_of(p: رشته): رشته:
    ناپایا slash := 0 - 1
    تکرار p.طول() در i:
        اگر p.زیررشته(i، 1) برابر "/":
            slash = i
        پایان
    پایان
    برگشت p.زیررشته(slash + 1، p.طول() - slash - 1)
پایان

تابع file_at(fs &: Fs، path: رشته): صحیح:
    ناپایا i := 0
    تا i کوچکتر fs.names.طول():
        اگر fs.names.بگیر(i) برابر path:
            برگشت i
        پایان
        i += 1
    پایان
    برگشت 0 - 1
پایان

تابع dir_at(fs &: Fs، path: رشته): صحیح:
    ناپایا i := 0
    تا i کوچکتر fs.dirs.طول():
        اگر fs.dirs.بگیر(i) برابر path:
            برگشت i
        پایان
        i += 1
    پایان
    برگشت 0 - 1
پایان

تابع put_file(fs &: Fs، path: رشته، body: رشته، append: منطقی):
    at := file_at(fs، path)
    اگر at کوچکتر 0:
        fs.names.بیفزا(path)
        fs.blobs.بیفزا(body)
    وگرنه append:
        fs.blobs.بنشان(at، fs.blobs.بگیر(at) + body)
    وگرنه:
        fs.blobs.بنشان(at، body)
    پایان
پایان

تابع has_children(fs &: Fs، path: رشته): منطقی:
    ناپایا i := 0
    تا i کوچکتر fs.names.طول():
        اگر fs.names.بگیر(i) نابرابر "" و parent_of(fs.names.بگیر(i)) برابر path:
            برگشت درست
        پایان
        i += 1
    پایان
    i = 0
    تا i کوچکتر fs.dirs.طول():
        اگر fs.dirs.بگیر(i) نابرابر "" و fs.dirs.بگیر(i) نابرابر "/" و parent_of(fs.dirs.بگیر(i)) برابر path:
            برگشت درست
        پایان
        i += 1
    پایان
    برگشت نادرست
پایان

تابع listing(fs &: Fs، path: رشته، names_only: منطقی): رشته:
    ناپایا out := ""
    ناپایا i := 0
    تا i کوچکتر fs.dirs.طول():
        d := fs.dirs.بگیر(i)
        اگر d نابرابر "" و d نابرابر "/" و parent_of(d) برابر path:
            اگر names_only:
                out += base_of(d) + "\r\n"
            وگرنه:
                out += "drwxr-xr-x    2 ftp      ftp          4096 Aug 19 10:00 " + base_of(d) + "\r\n"
            پایان
        پایان
        i += 1
    پایان
    i = 0
    تا i کوچکتر fs.names.طول():
        f := fs.names.بگیر(i)
        اگر f نابرابر "" و parent_of(f) برابر path:
            اگر names_only:
                out += base_of(f) + "\r\n"
            وگرنه:
                out += "-rw-r--r--    1 ftp      ftp          " + رشته.از عدد(fs.blobs.بگیر(i).طول()) + " Aug 19 10:00 " + base_of(f) + "\r\n"
            پایان
        پایان
        i += 1
    پایان
    اگر path برابر "/" و وارونه names_only:
        out += "lrwxrwxrwx    1 ftp      ftp          9 Aug 19 10:00 shortcut -> hello.txt\r\n"
    پایان
    برگشت out
پایان

تابع open_data(s &: Sess، dsrv: تی سی پی.سرور، scfg: تی ال اس.پیکربندی کارساز): منطقی:
    s.dc = تی سی پی.پذیرش(dsrv)
    s.dsecure = نادرست
    اگر s.prot:
        s.dtc = تی ال اس.پوشش کارساز(s.dc.توصیفگر، scfg)
        اگر وارونه تی ال اس.اتصال معتبر(s.dtc):
            برگشت نادرست
        پایان
        s.dsecure = درست
    پایان
    برگشت درست
پایان

تابع data_send(s &: Sess، payload: رشته):
    اگر s.dsecure:
        اگر payload.طول() بزرگتر 0:
            _ := تی ال اس.نوشتن(s.dtc، payload)
        پایان
        تی ال اس.بستن اتصال(s.dtc)
    وگرنه:
        اگر payload.طول() بزرگتر 0:
            _ := تی سی پی.نوشتن(s.dc، payload)
        پایان
        تی سی پی.بستن(s.dc)
    پایان
پایان

تابع data_recv(s &: Sess): رشته:
    ناپایا body := ""
    ناپایا more := درست
    تا more:
        ناپایا chunk := ""
        اگر s.dsecure:
            chunk = تی ال اس.خواندن(s.dtc، 8192)
        وگرنه:
            chunk = تی سی پی.خواندن(s.dc، 8192)
        پایان
        اگر chunk.طول() برابر 0:
            more = نادرست
        وگرنه:
            body += chunk
        پایان
    پایان
    اگر s.dsecure:
        تی ال اس.بستن اتصال(s.dtc)
    وگرنه:
        تی سی پی.بستن(s.dc)
    پایان
    برگشت body
پایان

تابع handle(c: تی سی پی.اتصال شبکه، index: صحیح، fs &: Fs، dsrv: تی سی پی.سرور، scfg: تی ال اس.پیکربندی کارساز):
    ناپایا s := Sess {}
    s.ctl = c
    s.alive = درست
    s.cwd = "/"
    s.epsv = index نابرابر 4
    say(s، "220 mock ftp ready")
    تا s.alive:
        line := recv_line(s)
        اگر وارونه s.alive:
            بشکن
        پایان
        sp := line.بیاب(" ")
        ناپایا verb := line
        ناپایا arg := ""
        اگر sp بزرگتربرابر 0:
            verb = line.زیررشته(0، sp)
            arg = line.زیررشته(sp + 1، line.طول() - sp - 1)
        پایان
        اگر verb برابر "USER":
            say(s، "331 password please")
        وگرنه verb برابر "PASS":
            اگر arg برابر "secret":
                say(s، "230 welcome")
            وگرنه:
                say(s، "530 login incorrect")
            پایان
        وگرنه verb برابر "AUTH":
            say(s، "234 go ahead")
            s.sc = تی ال اس.پوشش کارساز(c.توصیفگر، scfg)
            اگر وارونه تی ال اس.اتصال معتبر(s.sc):
                s.alive = نادرست
            وگرنه:
                s.secure = درست
                s.buf = ""
            پایان
        وگرنه verb برابر "PBSZ":
            say(s، "200 ok")
        وگرنه verb برابر "PROT":
            اگر arg برابر "P":
                s.prot = درست
                say(s، "200 private")
            وگرنه:
                say(s، "200 clear")
            پایان
        وگرنه verb برابر "SYST":
            say(s، "215 UNIX Type: L8")
        وگرنه verb برابر "FEAT":
            say(s، "211-Features:\r\n EPSV\r\n PASV\r\n211 End")
        وگرنه verb برابر "NOOP":
            say(s، "200 noop")
        وگرنه verb برابر "TYPE":
            say(s، "200 type set")
        وگرنه verb برابر "PWD":
            say(s، "257 \"" + s.cwd + "\" is the current directory")
        وگرنه verb برابر "CWD":
            target := absolute(s.cwd، arg)
            اگر dir_at(fs، target) بزرگتربرابر 0:
                s.cwd = target
                say(s، "250 directory changed")
            وگرنه:
                say(s، "550 no such directory")
            پایان
        وگرنه verb برابر "CDUP":
            s.cwd = parent_of(s.cwd)
            say(s، "250 directory changed")
        وگرنه verb برابر "MKD":
            target := absolute(s.cwd، arg)
            اگر dir_at(fs، target) بزرگتربرابر 0:
                say(s، "550 exists")
            وگرنه:
                fs.dirs.بیفزا(target)
                say(s، "257 \"" + target + "\" created")
            پایان
        وگرنه verb برابر "RMD":
            target := absolute(s.cwd، arg)
            at := dir_at(fs، target)
            اگر at بزرگتربرابر 0 و وارونه has_children(fs، target):
                fs.dirs.بنشان(at، "")
                say(s، "250 removed")
            وگرنه:
                say(s، "550 cannot remove")
            پایان
        وگرنه verb برابر "DELE":
            at := file_at(fs، absolute(s.cwd، arg))
            اگر at بزرگتربرابر 0:
                fs.names.بنشان(at، "")
                say(s، "250 deleted")
            وگرنه:
                say(s، "550 no such file")
            پایان
        وگرنه verb برابر "RNFR":
            s.rnfr = absolute(s.cwd، arg)
            اگر file_at(fs، s.rnfr) بزرگتربرابر 0:
                say(s، "350 ready for destination")
            وگرنه:
                say(s، "550 no such file")
            پایان
        وگرنه verb برابر "RNTO":
            at := file_at(fs، s.rnfr)
            اگر at بزرگتربرابر 0:
                fs.names.بنشان(at، absolute(s.cwd، arg))
                say(s، "250 renamed")
            وگرنه:
                say(s، "503 send RNFR first")
            پایان
        وگرنه verb برابر "SIZE":
            at := file_at(fs، absolute(s.cwd، arg))
            اگر at بزرگتربرابر 0:
                say(s، "213 " + رشته.از عدد(fs.blobs.بگیر(at).طول()))
            وگرنه:
                say(s، "550 no such file")
            پایان
        وگرنه verb برابر "MDTM":
            اگر file_at(fs، absolute(s.cwd، arg)) بزرگتربرابر 0:
                say(s، "213 20260102030405")
            وگرنه:
                say(s، "550 no such file")
            پایان
        وگرنه verb برابر "EPSV":
            اگر s.epsv:
                say(s، "229 Entering Extended Passive Mode (|||" + رشته.از عدد(DPORT) + "|)")
                اگر وارونه open_data(s، dsrv، scfg):
                    s.alive = نادرست
                پایان
            وگرنه:
                say(s، "500 EPSV is not supported")
            پایان
        وگرنه verb برابر "PASV":
            say(s، "227 Entering Passive Mode (127,0,0,1," + رشته.از عدد(DPORT / 256) + "," + رشته.از عدد(DPORT % 256) + ")")
            اگر وارونه open_data(s، dsrv، scfg):
                s.alive = نادرست
            پایان
        وگرنه verb برابر "LIST" یا verb برابر "NLST":
            ناپایا where := s.cwd
            اگر arg نابرابر "":
                where = absolute(s.cwd، arg)
            پایان
            say(s، "150 here comes the listing")
            data_send(s، listing(fs، where، verb برابر "NLST"))
            say(s، "226 done")
        وگرنه verb برابر "RETR":
            at := file_at(fs، absolute(s.cwd، arg))
            اگر at کوچکتر 0:
                say(s، "550 no such file")
                s.dc = تی سی پی.اتصال شبکه {}
                تی سی پی.بستن(s.dc)
            وگرنه:
                say(s، "150 sending")
                data_send(s، fs.blobs.بگیر(at))
                say(s، "226 done")
            پایان
        وگرنه verb برابر "STOR" یا verb برابر "APPE":
            say(s، "150 receiving")
            body := data_recv(s)
            put_file(fs، absolute(s.cwd، arg)، body، verb برابر "APPE")
            say(s، "226 done")
        وگرنه verb برابر "QUIT":
            say(s، "221 bye")
            s.alive = نادرست
        وگرنه:
            say(s، "502 not implemented")
        پایان
    پایان
    اگر s.secure:
        تی ال اس.بستن اتصال(s.sc)
    وگرنه:
        تی سی پی.بستن(c)
    پایان
پایان

تابع serve():
    srv := تی سی پی.پیوند(PORT)
    dsrv := تی سی پی.پیوند(DPORT)
    همگام سازی.اتمام(wg)
    scfg := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    ناپایا fs := Fs {}
    fs.dirs.بیفزا("/")
    fs.dirs.بیفزا("/pub")
    fs.names.بیفزا("/hello.txt")
    fs.blobs.بیفزا("hello ftp\n")
    fs.names.بیفزا("/pub/a.txt")
    fs.blobs.بیفزا("alpha")
    ناپایا index := 0
    تا index کوچکتر SESSIONS:
        c := تی سی پی.پذیرش(srv)
        handle(c، index، fs، dsrv، scfg)
        index += 1
    پایان
    تی سی پی.بستن سرور(dsrv)
    تی سی پی.بستن سرور(srv)
پایان

تابع tls_config(): تی ال اس.پیکربندی:
    ناپایا cfg := تی ال اس.پیکربندی جدید("127.0.0.1")
    cfg.پرونده گواهی ریشه = CERT
    برگشت cfg
پایان

تابع test_plain():
    ناپایا c := اف‌تی‌پی.اتصال("127.0.0.1"، PORT)
    آزمایش.ادعای درستی(اف‌تی‌پی.سالم(c))
    آزمایش.ادعای برابری عدد(اف‌تی‌پی.آخرین کد(c)، 220)
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.آخرین پاسخ(c)، "220 mock ftp ready")
    آزمایش.ادعای نادرستی(اف‌تی‌پی.امن(c))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.داده امن(c))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.ورود(c، "ali"، "wrong"))
    آزمایش.ادعای برابری عدد(اف‌تی‌پی.آخرین کد(c)، 530)
    آزمایش.ادعای درستی(اف‌تی‌پی.ورود(c، "ali"، "secret"))
    آزمایش.ادعای درستی(اف‌تی‌پی.بی‌کار(c))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.سامانه(c)، "215 UNIX Type: L8")
    features := اف‌تی‌پی.قابلیت‌ها(c)
    آزمایش.ادعای درستی(features.بیاب(" EPSV") بزرگتر 0)
    آزمایش.ادعای درستی(features.بیاب("211 End") بزرگتر 0)
    آزمایش.ادعای درستی(اف‌تی‌پی.دودویی(c))
    آزمایش.ادعای درستی(اف‌تی‌پی.متنی(c))
    آزمایش.ادعای برابری عدد(اف‌تی‌پی.فرمان(c، "NOOP")، 200)
    آزمایش.ادعای برابری عدد(اف‌تی‌پی.فرمان(c، "BOGUS")، 502)
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.مسیر جاری(c)، "/")

    آزمایش.ادعای درستی(اف‌تی‌پی.ساخت پوشه(c، "work"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.ساخت پوشه(c، "work"))
    آزمایش.ادعای درستی(اف‌تی‌پی.تغییر مسیر(c، "work"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.مسیر جاری(c)، "/work")
    آزمایش.ادعای درستی(اف‌تی‌پی.یک سطح بالا(c))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.مسیر جاری(c)، "/")
    آزمایش.ادعای نادرستی(اف‌تی‌پی.تغییر مسیر(c، "missing"))
    آزمایش.ادعای درستی(اف‌تی‌پی.ساخت مسیر کامل(c، "/deep/er/still"))
    آزمایش.ادعای درستی(اف‌تی‌پی.پوشه است(c، "/deep/er/still"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.پوشه است(c، "/hello.txt"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.مسیر جاری(c)، "/")

    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(c، "hello.txt")، "hello ftp\n")
    آزمایش.ادعای درستی(اف‌تی‌پی.نوشتن(c، "work/new.txt"، "first"))
    آزمایش.ادعای درستی(اف‌تی‌پی.افزودن(c، "work/new.txt"، "+second"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(c، "work/new.txt")، "first+second")
    آزمایش.ادعای برابری عدد۶۴(اف‌تی‌پی.اندازه(c، "work/new.txt")، 12 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد۶۴(اف‌تی‌پی.اندازه(c، "nothing")، 0 - 1 برگردان صحیح۶۴)
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.زمان تغییر(c، "hello.txt")، "20260102030405")
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.زمان تغییر(c، "nothing")، "")
    آزمایش.ادعای درستی(اف‌تی‌پی.وجود دارد(c، "hello.txt"))
    آزمایش.ادعای درستی(اف‌تی‌پی.وجود دارد(c، "work"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.وجود دارد(c، "nothing"))
    آزمایش.ادعای درستی(اف‌تی‌پی.پیوند است(c، "/shortcut"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.پیوند است(c، "/hello.txt"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.پیوند است(c، "/"))

    raw := اف‌تی‌پی.فهرست خام(c، "/")
    آزمایش.ادعای درستی(raw.بیاب("hello.txt") بزرگتر 0)
    آزمایش.ادعای درستی(raw.بیاب("shortcut -> hello.txt") بزرگتر 0)
    entries := اف‌تی‌پی.فهرست(c، "/pub")
    آزمایش.ادعای برابری عدد(entries.طول()، 1)
    آزمایش.ادعای برابری رشته(entries.بگیر(0).نام، "a.txt")
    آزمایش.ادعای برابری عدد۶۴(entries.بگیر(0).اندازه، 5 برگردان صحیح۶۴)
    entries.آزادکن()
    names := اف‌تی‌پی.فهرست نام‌ها(c، "/")
    آزمایش.ادعای برابری عدد(names.طول()، 4)
    آزمایش.ادعای برابری رشته(names.بگیر(0)، "pub")
    آزمایش.ادعای برابری رشته(names.بگیر(3)، "hello.txt")
    names.آزادکن()
    here := اف‌تی‌پی.فهرست نام‌ها(c، "")
    آزمایش.ادعای برابری عدد(here.طول()، 4)
    here.آزادکن()

    آزمایش.ادعای درستی(اف‌تی‌پی.تغییر نام(c، "work/new.txt"، "work/old.txt"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.تغییر نام(c، "work/new.txt"، "work/older.txt"))
    آزمایش.ادعای درستی(اف‌تی‌پی.انتقال(c، "work/old.txt"، "moved.txt"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(c، "moved.txt")، "first+second")
    آزمایش.ادعای درستی(اف‌تی‌پی.حذف(c، "moved.txt"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.حذف(c، "moved.txt"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.وجود دارد(c، "moved.txt"))

    local := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_ftp_coverage")
    پوشه.حذف همه(local)
    پوشه.ساخت پوشه ها(local)
    one := مسیر پرونده.پیوند(local، "one.txt")
    آزمایش.ادعای درستی(اف‌تی‌پی.دریافت(c، "hello.txt"، one))
    آزمایش.ادعای برابری رشته(پرونده.خواندن متن(one)، "hello ftp\n")
    آزمایش.ادعای نادرستی(اف‌تی‌پی.دریافت(c، "nothing"، مسیر پرونده.پیوند(local، "none.txt")))
    پرونده.نوشتن متن(مسیر پرونده.پیوند(local، "up.txt")، "uploaded body")
    آزمایش.ادعای درستی(اف‌تی‌پی.ارسال(c، مسیر پرونده.پیوند(local، "up.txt")، "up.txt"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(c، "up.txt")، "uploaded body")
    آزمایش.ادعای نادرستی(اف‌تی‌پی.ارسال(c، مسیر پرونده.پیوند(local، "absent.txt")، "absent.txt"))

    tree := مسیر پرونده.پیوند(local، "tree")
    پوشه.ساخت پوشه ها(مسیر پرونده.پیوند(tree، "inner"))
    پرونده.نوشتن متن(مسیر پرونده.پیوند(tree، "top.txt")، "top")
    پرونده.نوشتن متن(مسیر پرونده.پیوند(tree، "inner/leaf.txt")، "leaf")
    آزمایش.ادعای درستی(اف‌تی‌پی.ارسال پوشه(c، tree، "/uploaded"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(c، "/uploaded/top.txt")، "top")
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(c، "/uploaded/inner/leaf.txt")، "leaf")
    back := مسیر پرونده.پیوند(local، "back")
    آزمایش.ادعای درستی(اف‌تی‌پی.دریافت پوشه(c، "/uploaded"، back))
    آزمایش.ادعای برابری رشته(پرونده.خواندن متن(مسیر پرونده.پیوند(back، "top.txt"))، "top")
    آزمایش.ادعای برابری رشته(پرونده.خواندن متن(مسیر پرونده.پیوند(back، "inner/leaf.txt"))، "leaf")
    آزمایش.ادعای درستی(اف‌تی‌پی.حذف همه(c، "/uploaded"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.وجود دارد(c، "/uploaded"))
    پوشه.حذف همه(local)

    اف‌تی‌پی.بستن(c)
    آزمایش.ادعای نادرستی(اف‌تی‌پی.سالم(c))
پایان

تابع test_implicit_tls():
    ناپایا c := اف‌تی‌پی.اتصال امن با تنظیمات("127.0.0.1"، PORT، tls_config())
    آزمایش.ادعای درستی(اف‌تی‌پی.سالم(c))
    آزمایش.ادعای درستی(اف‌تی‌پی.امن(c))
    آزمایش.ادعای درستی(اف‌تی‌پی.داده امن(c))
    آزمایش.ادعای درستی(اف‌تی‌پی.ورود(c، "ali"، "secret"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.مسیر جاری(c)، "/")
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(c، "hello.txt")، "hello ftp\n")
    آزمایش.ادعای درستی(اف‌تی‌پی.نوشتن(c، "secure.txt"، "over tls"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(c، "secure.txt")، "over tls")
    آزمایش.ادعای درستی(اف‌تی‌پی.فهرست خام(c، "/").بیاب("secure.txt") بزرگتر 0)
    اف‌تی‌پی.خروج(c)
    آزمایش.ادعای نادرستی(اف‌تی‌پی.امن(c))
پایان

تابع test_untrusted():
    c := اف‌تی‌پی.اتصال امن("127.0.0.1"، PORT)
    آزمایش.ادعای نادرستی(اف‌تی‌پی.سالم(c))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.امن(c))
    d := اف‌تی‌پی.اتصال("127.0.0.1"، PORT)
    آزمایش.ادعای درستی(اف‌تی‌پی.سالم(d))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.احراز تی‌ال‌اس(d))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.امن(d))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.داده امن(d))
پایان

تابع test_explicit_tls_passive():
    ناپایا c := اف‌تی‌پی.اتصال("127.0.0.1"، PORT)
    آزمایش.ادعای درستی(اف‌تی‌پی.سالم(c))
    آزمایش.ادعای درستی(اف‌تی‌پی.ارتقا به تی‌ال‌اس(c، tls_config()))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.ارتقا به تی‌ال‌اس(c، tls_config()))
    آزمایش.ادعای درستی(اف‌تی‌پی.امن(c))
    آزمایش.ادعای درستی(اف‌تی‌پی.داده امن(c))
    آزمایش.ادعای درستی(اف‌تی‌پی.ورود(c، "ali"، "secret"))
    آزمایش.ادعای درستی(اف‌تی‌پی.نوشتن(c، "passive.txt"، "via pasv"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(c، "passive.txt")، "via pasv")
    آزمایش.ادعای برابری عدد(اف‌تی‌پی.فرمان(c، "EPSV")، 500)
    اف‌تی‌پی.بستن(c)
پایان

تابع ریشه:
    همگام سازی.افزودن(wg، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve)
    همگام سازی.انتظار(wg)
    test_plain()
    test_implicit_tls()
    test_untrusted()
    test_explicit_tls_passive()
    نخ‌پیوند(t)
    آزمایش.خلاصه()
    برگشت 0
