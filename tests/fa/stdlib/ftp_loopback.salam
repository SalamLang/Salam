بسته ریشه

واردسازی اف‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی تی ال اس
واردسازی رشته
واردسازی همگام سازی
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی سیستم پرونده.پرونده
واردسازی سیستم پرونده.پوشه
واردسازی آزمایش

پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"
پایا SESSIONS := 5

ناپایا PORT := 0
ناپایا DPORT := 0
ناپایا گروه انتظار := همگام سازی.گروه انتظار جدید()

ساختار سامانه‌پرونده:
    همگانی نام ها: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
    همگانی محتواها: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
    همگانی شاخه ها: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
پایان

ساختار نشست:
    همگانی اتصال کنترل: تی سی پی.اتصال شبکه = تی سی پی.اتصال شبکه {}
    همگانی اتصال امن کنترل: تی ال اس.اتصال = تی ال اس.اتصال {}
    همگانی اتصال داده: تی سی پی.اتصال شبکه = تی سی پی.اتصال شبکه {}
    همگانی اتصال امن داده: تی ال اس.اتصال = تی ال اس.اتصال {}
    همگانی امن: منطقی = نادرست
    همگانی داده محافظت‌شده: منطقی = نادرست
    همگانی داده امن: منطقی = نادرست
    همگانی حالت توسعه‌یافته: منطقی = نادرست
    همگانی زنده: منطقی = نادرست
    همگانی بافر دریافت: رشته = ""
    همگانی شاخه جاری: رشته = "/"
    همگانی مبدا تغییر نام: رشته = ""
پایان

تابع دریافت خط(s &: نشست): رشته:
    تا s.زنده:
        جایگاه := s.بافر دریافت.بیاب("\r\n")
        اگر جایگاه بزرگتربرابر 0:
            خط := s.بافر دریافت.زیررشته(0، جایگاه)
            s.بافر دریافت = s.بافر دریافت.زیررشته(جایگاه + 2، s.بافر دریافت.طول() - جایگاه - 2)
            برگشت خط
        پایان
        ناپایا تکه := ""
        اگر s.امن:
            تکه = تی ال اس.خواندن(s.اتصال امن کنترل، 4096)
        وگرنه:
            تکه = تی سی پی.خواندن(s.اتصال کنترل، 4096)
        پایان
        اگر تکه.طول() برابر 0:
            s.زنده = نادرست
        وگرنه:
            s.بافر دریافت += تکه
        پایان
    پایان
    برگشت ""
پایان

تابع گفتن(s &: نشست، خط: رشته):
    اگر s.امن:
        _ := تی ال اس.نوشتن(s.اتصال امن کنترل، خط + "\r\n")
    وگرنه:
        _ := تی سی پی.نوشتن(s.اتصال کنترل، خط + "\r\n")
    پایان
پایان

تابع مسیر مطلق(شاخه جاری: رشته، p: رشته): رشته:
    ناپایا خام := p
    اگر وارونه رشته.شروع با(خام، "/"):
        اگر شاخه جاری برابر "/":
            خام = "/" + خام
        وگرنه:
            خام = شاخه جاری + "/" + خام
        پایان
    پایان
    اجزا := رشته.تفکیک کردن(خام، "/")
    ناپایا نتیجه := وکتور {} برگردان وکتور<رشته>
    هر جزء در اجزا:
        اگر جزء برابر "..":
            اگر نتیجه.طول() بزرگتر 0:
                _ := نتیجه.دربیاور()
            پایان
        وگرنه جزء نابرابر "" و جزء نابرابر ".":
            نتیجه.بیفزا(جزء)
        پایان
    پایان
    اگر نتیجه.طول() برابر 0:
        برگشت "/"
    پایان
    برگشت "/" + رشته.بپیوند(نتیجه، "/")
پایان

تابع والد مسیر(p: رشته): رشته:
    ناپایا جایگاه اسلش := 0 - 1
    تکرار p.طول() در i:
        اگر p.زیررشته(i، 1) برابر "/":
            جایگاه اسلش = i
        پایان
    پایان
    اگر جایگاه اسلش کوچکتربرابر 0:
        برگشت "/"
    پایان
    برگشت p.زیررشته(0، جایگاه اسلش)
پایان

تابع نام پایه(p: رشته): رشته:
    ناپایا جایگاه اسلش := 0 - 1
    تکرار p.طول() در i:
        اگر p.زیررشته(i، 1) برابر "/":
            جایگاه اسلش = i
        پایان
    پایان
    برگشت p.زیررشته(جایگاه اسلش + 1، p.طول() - جایگاه اسلش - 1)
پایان

تابع شاخص فایل(سامانه &: سامانه‌پرونده، مسیر: رشته): صحیح:
    ناپایا i := 0
    تا i کوچکتر سامانه.نام ها.طول():
        اگر سامانه.نام ها.بگیر(i) برابر مسیر:
            برگشت i
        پایان
        i++
    پایان
    برگشت 0 - 1
پایان

تابع شاخص شاخه(سامانه &: سامانه‌پرونده، مسیر: رشته): صحیح:
    ناپایا i := 0
    تا i کوچکتر سامانه.شاخه ها.طول():
        اگر سامانه.شاخه ها.بگیر(i) برابر مسیر:
            برگشت i
        پایان
        i++
    پایان
    برگشت 0 - 1
پایان

تابع ثبت فایل(سامانه &: سامانه‌پرونده، مسیر: رشته، بدنه: رشته، افزودنی: منطقی):
    جایگاه := شاخص فایل(سامانه، مسیر)
    اگر جایگاه کوچکتر 0:
        سامانه.نام ها.بیفزا(مسیر)
        سامانه.محتواها.بیفزا(بدنه)
    وگرنه افزودنی:
        سامانه.محتواها.بنشان(جایگاه، سامانه.محتواها.بگیر(جایگاه) + بدنه)
    وگرنه:
        سامانه.محتواها.بنشان(جایگاه، بدنه)
    پایان
پایان

تابع دارای فرزند(سامانه &: سامانه‌پرونده، مسیر: رشته): منطقی:
    ناپایا i := 0
    تا i کوچکتر سامانه.نام ها.طول():
        اگر سامانه.نام ها.بگیر(i) نابرابر "" و والد مسیر(سامانه.نام ها.بگیر(i)) برابر مسیر:
            برگشت درست
        پایان
        i++
    پایان
    i = 0
    تا i کوچکتر سامانه.شاخه ها.طول():
        اگر سامانه.شاخه ها.بگیر(i) نابرابر "" و سامانه.شاخه ها.بگیر(i) نابرابر "/" و والد مسیر(سامانه.شاخه ها.بگیر(i)) برابر مسیر:
            برگشت درست
        پایان
        i++
    پایان
    برگشت نادرست
پایان

تابع ساخت فهرست(سامانه &: سامانه‌پرونده، مسیر: رشته، فقط نام ها: منطقی): رشته:
    ناپایا نتیجه := ""
    ناپایا i := 0
    تا i کوچکتر سامانه.شاخه ها.طول():
        d := سامانه.شاخه ها.بگیر(i)
        اگر d نابرابر "" و d نابرابر "/" و والد مسیر(d) برابر مسیر:
            اگر فقط نام ها:
                نتیجه += نام پایه(d) + "\r\n"
            وگرنه:
                نتیجه += "drwxr-xr-x    2 ftp      ftp          4096 Aug 19 10:00 " + نام پایه(d) + "\r\n"
            پایان
        پایان
        i++
    پایان
    i = 0
    تا i کوچکتر سامانه.نام ها.طول():
        f := سامانه.نام ها.بگیر(i)
        اگر f نابرابر "" و والد مسیر(f) برابر مسیر:
            اگر فقط نام ها:
                نتیجه += نام پایه(f) + "\r\n"
            وگرنه:
                نتیجه += "-rw-r--r--    1 ftp      ftp          " + رشته.از عدد(سامانه.محتواها.بگیر(i).طول()) + " Aug 19 10:00 " + نام پایه(f) + "\r\n"
            پایان
        پایان
        i++
    پایان
    اگر مسیر برابر "/" و وارونه فقط نام ها:
        نتیجه += "lrwxrwxrwx    1 ftp      ftp          9 Aug 19 10:00 shortcut -> hello.txt\r\n"
    پایان
    برگشت نتیجه
پایان

تابع باز کردن داده(s &: نشست، سرور داده: تی سی پی.سرور، پیکربندی سرور: تی ال اس.پیکربندی کارساز): منطقی:
    s.اتصال داده = تی سی پی.پذیرش(سرور داده)
    s.داده امن = نادرست
    اگر s.داده محافظت‌شده:
        s.اتصال امن داده = تی ال اس.پوشش کارساز(s.اتصال داده.توصیفگر، پیکربندی سرور)
        اگر وارونه تی ال اس.اتصال معتبر(s.اتصال امن داده):
            برگشت نادرست
        پایان
        s.داده امن = درست
    پایان
    برگشت درست
پایان

تابع ارسال داده(s &: نشست، بار: رشته):
    اگر s.داده امن:
        اگر بار.طول() بزرگتر 0:
            _ := تی ال اس.نوشتن(s.اتصال امن داده، بار)
        پایان
        تی ال اس.بستن اتصال(s.اتصال امن داده)
    وگرنه:
        اگر بار.طول() بزرگتر 0:
            _ := تی سی پی.نوشتن(s.اتصال داده، بار)
        پایان
        تی سی پی.بستن(s.اتصال داده)
    پایان
پایان

تابع دریافت داده(s &: نشست): رشته:
    ناپایا بدنه := ""
    ناپایا بیشتر هست := درست
    تا بیشتر هست:
        ناپایا تکه := ""
        اگر s.داده امن:
            تکه = تی ال اس.خواندن(s.اتصال امن داده، 8192)
        وگرنه:
            تکه = تی سی پی.خواندن(s.اتصال داده، 8192)
        پایان
        اگر تکه.طول() برابر 0:
            بیشتر هست = نادرست
        وگرنه:
            بدنه += تکه
        پایان
    پایان
    اگر s.داده امن:
        تی ال اس.بستن اتصال(s.اتصال امن داده)
    وگرنه:
        تی سی پی.بستن(s.اتصال داده)
    پایان
    برگشت بدنه
پایان

تابع رسیدگی(c: تی سی پی.اتصال شبکه، شماره: صحیح، سامانه &: سامانه‌پرونده، سرور داده: تی سی پی.سرور، پیکربندی سرور: تی ال اس.پیکربندی کارساز):
    ناپایا s := نشست {}
    s.اتصال کنترل = c
    s.زنده = درست
    s.شاخه جاری = "/"
    s.حالت توسعه‌یافته = شماره نابرابر 4
    گفتن(s، "220 mock ftp ready")
    تا s.زنده:
        خط := دریافت خط(s)
        اگر وارونه s.زنده:
            بشکن
        پایان
        جایگاه فاصله := خط.بیاب(" ")
        ناپایا دستور := خط
        ناپایا آرگومان := ""
        اگر جایگاه فاصله بزرگتربرابر 0:
            دستور = خط.زیررشته(0، جایگاه فاصله)
            آرگومان = خط.زیررشته(جایگاه فاصله + 1، خط.طول() - جایگاه فاصله - 1)
        پایان
        اگر دستور برابر "USER":
            گفتن(s، "331 password please")
        وگرنه دستور برابر "PASS":
            اگر آرگومان برابر "secret":
                گفتن(s، "230 welcome")
            وگرنه:
                گفتن(s، "530 login incorrect")
            پایان
        وگرنه دستور برابر "AUTH":
            گفتن(s، "234 go ahead")
            s.اتصال امن کنترل = تی ال اس.پوشش کارساز(c.توصیفگر، پیکربندی سرور)
            اگر وارونه تی ال اس.اتصال معتبر(s.اتصال امن کنترل):
                s.زنده = نادرست
            وگرنه:
                s.امن = درست
                s.بافر دریافت = ""
            پایان
        وگرنه دستور برابر "PBSZ":
            گفتن(s، "200 ok")
        وگرنه دستور برابر "PROT":
            اگر آرگومان برابر "P":
                s.داده محافظت‌شده = درست
                گفتن(s، "200 private")
            وگرنه:
                گفتن(s، "200 clear")
            پایان
        وگرنه دستور برابر "SYST":
            گفتن(s، "215 UNIX Type: L8")
        وگرنه دستور برابر "FEAT":
            گفتن(s، "211-Features:\r\n EPSV\r\n PASV\r\n211 End")
        وگرنه دستور برابر "NOOP":
            گفتن(s، "200 noop")
        وگرنه دستور برابر "TYPE":
            گفتن(s، "200 type set")
        وگرنه دستور برابر "PWD":
            گفتن(s، "257 \"" + s.شاخه جاری + "\" is the current directory")
        وگرنه دستور برابر "CWD":
            مقصد := مسیر مطلق(s.شاخه جاری، آرگومان)
            اگر شاخص شاخه(سامانه، مقصد) بزرگتربرابر 0:
                s.شاخه جاری = مقصد
                گفتن(s، "250 directory changed")
            وگرنه:
                گفتن(s، "550 no such directory")
            پایان
        وگرنه دستور برابر "CDUP":
            s.شاخه جاری = والد مسیر(s.شاخه جاری)
            گفتن(s، "250 directory changed")
        وگرنه دستور برابر "MKD":
            مقصد := مسیر مطلق(s.شاخه جاری، آرگومان)
            اگر شاخص شاخه(سامانه، مقصد) بزرگتربرابر 0:
                گفتن(s، "550 exists")
            وگرنه:
                سامانه.شاخه ها.بیفزا(مقصد)
                گفتن(s، "257 \"" + مقصد + "\" created")
            پایان
        وگرنه دستور برابر "RMD":
            مقصد := مسیر مطلق(s.شاخه جاری، آرگومان)
            جایگاه := شاخص شاخه(سامانه، مقصد)
            اگر جایگاه بزرگتربرابر 0 و وارونه دارای فرزند(سامانه، مقصد):
                سامانه.شاخه ها.بنشان(جایگاه، "")
                گفتن(s، "250 removed")
            وگرنه:
                گفتن(s، "550 cannot remove")
            پایان
        وگرنه دستور برابر "DELE":
            جایگاه := شاخص فایل(سامانه، مسیر مطلق(s.شاخه جاری، آرگومان))
            اگر جایگاه بزرگتربرابر 0:
                سامانه.نام ها.بنشان(جایگاه، "")
                گفتن(s، "250 deleted")
            وگرنه:
                گفتن(s، "550 no such file")
            پایان
        وگرنه دستور برابر "RNFR":
            s.مبدا تغییر نام = مسیر مطلق(s.شاخه جاری، آرگومان)
            اگر شاخص فایل(سامانه، s.مبدا تغییر نام) بزرگتربرابر 0:
                گفتن(s، "350 ready for destination")
            وگرنه:
                گفتن(s، "550 no such file")
            پایان
        وگرنه دستور برابر "RNTO":
            جایگاه := شاخص فایل(سامانه، s.مبدا تغییر نام)
            اگر جایگاه بزرگتربرابر 0:
                سامانه.نام ها.بنشان(جایگاه، مسیر مطلق(s.شاخه جاری، آرگومان))
                گفتن(s، "250 renamed")
            وگرنه:
                گفتن(s، "503 send RNFR first")
            پایان
        وگرنه دستور برابر "SIZE":
            جایگاه := شاخص فایل(سامانه، مسیر مطلق(s.شاخه جاری، آرگومان))
            اگر جایگاه بزرگتربرابر 0:
                گفتن(s، "213 " + رشته.از عدد(سامانه.محتواها.بگیر(جایگاه).طول()))
            وگرنه:
                گفتن(s، "550 no such file")
            پایان
        وگرنه دستور برابر "MDTM":
            اگر شاخص فایل(سامانه، مسیر مطلق(s.شاخه جاری، آرگومان)) بزرگتربرابر 0:
                گفتن(s، "213 20260102030405")
            وگرنه:
                گفتن(s، "550 no such file")
            پایان
        وگرنه دستور برابر "EPSV":
            اگر s.حالت توسعه‌یافته:
                گفتن(s، "229 Entering Extended Passive Mode (|||" + رشته.از عدد(DPORT) + "|)")
                اگر وارونه باز کردن داده(s، سرور داده، پیکربندی سرور):
                    s.زنده = نادرست
                پایان
            وگرنه:
                گفتن(s، "500 EPSV is not supported")
            پایان
        وگرنه دستور برابر "PASV":
            گفتن(s، "227 Entering Passive Mode (127,0,0,1," + رشته.از عدد(DPORT / 256) + "," + رشته.از عدد(DPORT % 256) + ")")
            اگر وارونه باز کردن داده(s، سرور داده، پیکربندی سرور):
                s.زنده = نادرست
            پایان
        وگرنه دستور برابر "LIST" یا دستور برابر "NLST":
            ناپایا محل := s.شاخه جاری
            اگر آرگومان نابرابر "":
                محل = مسیر مطلق(s.شاخه جاری، آرگومان)
            پایان
            گفتن(s، "150 here comes the listing")
            ارسال داده(s، ساخت فهرست(سامانه، محل، دستور برابر "NLST"))
            گفتن(s، "226 done")
        وگرنه دستور برابر "RETR":
            جایگاه := شاخص فایل(سامانه، مسیر مطلق(s.شاخه جاری، آرگومان))
            اگر جایگاه کوچکتر 0:
                گفتن(s، "550 no such file")
                s.اتصال داده = تی سی پی.اتصال شبکه {}
                تی سی پی.بستن(s.اتصال داده)
            وگرنه:
                گفتن(s، "150 sending")
                ارسال داده(s، سامانه.محتواها.بگیر(جایگاه))
                گفتن(s، "226 done")
            پایان
        وگرنه دستور برابر "STOR" یا دستور برابر "APPE":
            گفتن(s، "150 receiving")
            بدنه := دریافت داده(s)
            ثبت فایل(سامانه، مسیر مطلق(s.شاخه جاری، آرگومان)، بدنه، دستور برابر "APPE")
            گفتن(s، "226 done")
        وگرنه دستور برابر "QUIT":
            گفتن(s، "221 bye")
            s.زنده = نادرست
        وگرنه:
            گفتن(s، "502 not implemented")
        پایان
    پایان
    اگر s.امن:
        تی ال اس.بستن اتصال(s.اتصال امن کنترل)
    وگرنه:
        تی سی پی.بستن(c)
    پایان
