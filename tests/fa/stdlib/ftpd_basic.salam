// زبان: فارسی
بسته ریشه

واردسازی سرور اف‌تی‌پی
واردسازی اف‌تی‌پی
واردسازی آزمایش
واردسازی سیستم پرونده.پوشه
واردسازی همگام سازی

پایا ریشه‌آزمون := "/tmp/salam_ftpd_std_test_fa"

ناپایا سرور := سرور اف‌تی‌پی.سرور {}
ناپایا آماده := همگام سازی.گروه انتظار جدید()

ناپایا سرور یک بار := سرور اف‌تی‌پی.سرور {}
ناپایا آماده یک بار := همگام سازی.گروه انتظار جدید()

تابع پیکربندی آزمون(): سرور اف‌تی‌پی.پیکربندی:
    ناپایا پیکربندی := سرور اف‌تی‌پی.پیکربندی نو()
    پیکربندی.میزبان = "127.0.0.1"
    پیکربندی.درگاه = 0
    پیکربندی.ریشه = ریشه‌آزمون
    پیکربندی.اجازه ناشناس = درست
    پیکربندی.کاربر ناشناس = "anonymous"
    پیکربندی.شروع غیرفعال = 45000
    پیکربندی.پایان غیرفعال = 45000
    برگشت پیکربندی
پایان

// حلقه خدمت در نخ جداگانه اجرا می شود تا کارخواه بتواند به آن وصل شود.
تابع خدمت همیشگی():
    سرور = سرور اف‌تی‌پی.جدید(پیکربندی آزمون())
    اگر وارونه(سرور اف‌تی‌پی.گوش دادن(سرور)):
        همگام سازی.اتمام(آماده)
        برگشت
    پایان
    همگام سازی.اتمام(آماده)
    سرور اف‌تی‌پی.خدمت(سرور)
پایان

تابع خدمت یک بار():
    سرور یک بار = سرور اف‌تی‌پی.جدید(پیکربندی آزمون())
    اگر وارونه(سرور اف‌تی‌پی.گوش دادن(سرور یک بار)):
        همگام سازی.اتمام(آماده یک بار)
        برگشت
    پایان
    همگام سازی.اتمام(آماده یک بار)
    انجام شد := سرور اف‌تی‌پی.یک‌بار خدمت(سرور یک بار)
    اگر وارونه(انجام شد):
        سرور یک بار.در حال اجرا = نادرست
    پایان
پایان

تابع آزمون نشست ناشناس():
    ناپایا کارخواه := اف‌تی‌پی.اتصال("127.0.0.1", سرور اف‌تی‌پی.درگاه(سرور))
    آزمایش.ادعای درستی(اف‌تی‌پی.سالم(کارخواه))
    آزمایش.ادعای درستی(اف‌تی‌پی.ورود(کارخواه, "anonymous", "guest@example.com"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.مسیر جاری(کارخواه), "/")
    آزمایش.ادعای درستی(اف‌تی‌پی.نوشتن(کارخواه, "hello.txt", "hello salam"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(کارخواه, "hello.txt"), "hello salam")
    آزمایش.ادعای درستی(اف‌تی‌پی.افزودن(کارخواه, "hello.txt", " ftp"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(کارخواه, "hello.txt"), "hello salam ftp")
    آزمایش.ادعای برابری عدد۶۴(اف‌تی‌پی.اندازه(کارخواه, "hello.txt"), 15)
    آزمایش.ادعای درستی(اف‌تی‌پی.ساخت پوشه(کارخواه, "docs"))
    آزمایش.ادعای درستی(اف‌تی‌پی.تغییر مسیر(کارخواه, "docs"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.مسیر جاری(کارخواه), "/docs")
    آزمایش.ادعای درستی(اف‌تی‌پی.نوشتن(کارخواه, "note.txt", "note"))
    آزمایش.ادعای درستی(اف‌تی‌پی.یک سطح بالا(کارخواه))
    نام‌ها := اف‌تی‌پی.فهرست نام‌ها(کارخواه, "/")
    آزمایش.ادعای درستی(نام‌ها.طول() >= 2)
    آزمایش.ادعای درستی(اف‌تی‌پی.پوشه است(کارخواه, "docs"))
    آزمایش.ادعای درستی(اف‌تی‌پی.تغییر نام(کارخواه, "hello.txt", "renamed.txt"))
    آزمایش.ادعای درستی(اف‌تی‌پی.وجود دارد(کارخواه, "renamed.txt"))
    آزمایش.ادعای نادرستی(اف‌تی‌پی.وجود دارد(کارخواه, "hello.txt"))
    آزمایش.ادعای درستی(اف‌تی‌پی.حذف(کارخواه, "renamed.txt"))
    آزمایش.ادعای درستی(اف‌تی‌پی.حذف همه(کارخواه, "docs"))
    اف‌تی‌پی.خروج(کارخواه)
    اف‌تی‌پی.بستن(کارخواه)
پایان

تابع آزمون یک بار():
    ناپایا کارخواه := اف‌تی‌پی.اتصال("127.0.0.1", سرور اف‌تی‌پی.درگاه(سرور یک بار))
    آزمایش.ادعای درستی(اف‌تی‌پی.سالم(کارخواه))
    آزمایش.ادعای درستی(اف‌تی‌پی.ورود(کارخواه, "anonymous", ""))
    آزمایش.ادعای درستی(اف‌تی‌پی.نوشتن(کارخواه, "once.txt", "one"))
    آزمایش.ادعای برابری رشته(اف‌تی‌پی.خواندن(کارخواه, "once.txt"), "one")
    اف‌تی‌پی.بستن(کارخواه)
پایان

تابع ریشه:
    پوشه.حذف همه(ریشه‌آزمون)
    پوشه.ساخت پوشه ها(ریشه‌آزمون)
    آزمایش.ادعای درستی(پوشه.پوشه است(ریشه‌آزمون))

    همگام سازی.افزودن(آماده, 1 برگردان صحیح۶۴)
    کارگر := نخ‌ساز(خدمت همیشگی)
    همگام سازی.انتظار(آماده)
    آزمون نشست ناشناس()
    سرور.در حال اجرا = نادرست
    // بیدار کردن پذیرش مسدودشده تا حلقه خدمت وضعیت تازه را ببیند.
    ناپایا بیدار := اف‌تی‌پی.اتصال("127.0.0.1", سرور اف‌تی‌پی.درگاه(سرور))
    اف‌تی‌پی.بستن(بیدار)
    نخ‌پیوند(کارگر)
    سرور اف‌تی‌پی.بستن(سرور)

    پوشه.حذف همه(ریشه‌آزمون)
    پوشه.ساخت پوشه ها(ریشه‌آزمون)
    همگام سازی.افزودن(آماده یک بار, 1 برگردان صحیح۶۴)
    کارگر یک بار := نخ‌ساز(خدمت یک بار)
    همگام سازی.انتظار(آماده یک بار)
    آزمون یک بار()
    نخ‌پیوند(کارگر یک بار)
    سرور اف‌تی‌پی.بستن(سرور یک بار)

    پوشه.حذف همه(ریشه‌آزمون)
    آزمایش.خلاصه()
    برگشت 0
پایان
