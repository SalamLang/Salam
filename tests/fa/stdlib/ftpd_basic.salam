// زبان: فارسی
بسته ریشه

واردسازی سرور اف‌تی‌پی
واردسازی اف‌تی‌پی
واردسازی آزمایش
واردسازی سیستم عامل
واردسازی سیستم پرونده
واردسازی سیستم پرونده.پوشه
واردسازی زمان
واردسازی همگام سازی

ناپایا سرور := سرور اف‌تی‌پی.سرور {}
ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا ریشه := "/tmp/opencode/ftpd_test_root_fa"

تابع اجرای سرور():
    سیستم پرونده.پوشه.ساخت همه(ریشه)
    ناپایا پیکربندی := سرور اف‌تی‌پی.پیکربندی نو()
    پیکربندی.میزبان = "127.0.0.1"
    پیکربندی.درگاه = 0
    پیکربندی.ریشه = ریشه
    پیکربندی.اجازه ناشناس = درست
    پیکربندی.شروع غیرفعال = 45200
    پیکربندی.پایان غیرفعال = 45300
    سرور = سرور اف‌تی‌پی.جدید(پیکربندی)
    سرور اف‌تی‌پی.گوش دادن(سرور)
    همگام سازی.انجام شد(آماده)
    تکرار 10 در i:
        سرور اف‌تی‌پی.یک‌بار خدمت(سرور)
    پایان
    سرور اف‌تی‌پی.بستن(سرور)
پایان

تابع آزمون پایه():
    کارخواه := اف‌تی‌پی.اتصال("127.0.0.1"، سرور اف‌تی‌پی.درگاه(سرور))
    آزمایش.تایید درست(اف‌تی‌پی.سالم(کارخواه))
    آزمایش.تایید درست(اف‌تی‌پی.ورود(کارخواه، "anonymous"، ""))
    آزمایش.تایید برابری رشته(اف‌تی‌پی.شاخه جاری(کارخواه)، "/")
    آزمایش.تایید درست(اف‌تی‌پی.نوشتن(کارخواه، "hello.txt"، "salam"))
    آزمایش.تایید برابری رشته(اف‌تی‌پی.خواندن(کارخواه، "hello.txt")، "salam")
    اف‌تی‌پی.بستن(کارخواه)
پایان

تابع ریشه:
    سیستم پرونده.پوشه.حذف همه(ریشه)
    همگام سازی.افزودن(آماده، 1 برگردان عدد صحیح ۶۴)
    کار := همزاد(اجرای سرور)
    همگام سازی.صبر(آماده)
    زمان.خواب(50)
    آزمون پایه()
    پیوستن(کار)
    سیستم پرونده.پوشه.حذف همه(ریشه)
    آزمایش.خلاصه()
    برگشت 0
پایان
