// زبان: فارسی
واردسازی مسیر پرونده
واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده.پرونده
واردسازی سیستم عامل
واردسازی سیستم عامل.موقت
واردسازی سیستم پرونده.مسیر

تابع check(pattern: رشته، name: رشته):
    سرچاپ pattern، name، مسیر پرونده.تطبیق الگو(pattern، name)
پایان

تابع show(items: وکتور<رشته>، root: رشته):
    هر item در items:
        سرچاپ item.زیررشته(root.طول()، item.طول() - root.طول())
    پایان
    items.آزادکن()
پایان

تابع ریشه:
    check("*.py"، "tool.py")
    check("*.py"، "dir/tool.py")
    check("**/*.py"، "tool.py")
    check("**/*.py"، "a/b/tool.py")
    check("**/x"، "ax")
    check("a/**"، "a/b/c")
    check("a?c"، "abc")
    check("a?c"، "a/c")
    check("a[b-d]c"، "acc")
    check("a[!b-d]c"، "acc")
    check("a[^b-d]c"، "aec")
    check("a\\*"، "a*")
    check("*"، "")
    check("["، "[")
    check("pi?ata"، "piñata")
    check("lib*/**/*.so"، "libx/a/b/c.so")
    سرچاپ مسیر پرونده.الگو دارد("a/b.txt")، مسیر پرونده.الگو دارد("a/*.txt")، مسیر پرونده.الگو دارد("a[1]")، مسیر.تطبیق الگو("*.salam"، "x.salam")

    root := موقت.پوشه موقت()
    دیرکن موقت.حذف پوشه(root)
    سیستم عامل.ساخت پوشه ها(root + "/src/deep/deeper")
    سیستم عامل.ساخت پوشه ها(root + "/docs")
    names := ["src/a.c"، "src/b.h"، "src/deep/c.c"، "src/deep/deeper/d.c"، "docs/readme.md"، "top.c"]
    هر rel در names:
        پرونده.نوشتن متن(root + "/" + rel، "x")
    پایان

    سرچاپ "glob src/*.c"
    show(پوشه.الگوجویی(root + "/src/*.c")، root)
    سرچاپ "glob src/**/*.c"
    show(پوشه.الگوجویی(root + "/src/**/*.c")، root)
    سرچاپ "glob */*.?"
    show(پوشه.الگوجویی(root + "/*/*.?")، root)
    سرچاپ "glob nothing"
    show(پوشه.الگوجویی(root + "/none/*.c")، root)
    سرچاپ "glob literal"
    show(پوشه.الگوجویی(root + "/top.c")، root)
    سرچاپ "walk *.c"
    show(پوشه.پیمایش با الگو(root، "*.c")، root)
    سرچاپ "walk src/**/*.c"
    show(پوشه.پیمایش با الگو(root، "src/**/*.c")، root)
    سرچاپ "walk docs/*"
    show(پوشه.پیمایش با الگو(root، "docs/*")، root)
پایان
