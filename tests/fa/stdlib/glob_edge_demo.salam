// زبان: فارسی
واردسازی مسیر پرونده
واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده
واردسازی سیستم عامل
واردسازی سیستم عامل.موقت
واردسازی سیستم پرونده.مسیر

تابع بررسی(الگو: رشته، نام: رشته):
    سرچاپ الگو + " ~ " + نام، مسیر پرونده.تطبیق الگو(الگو، نام)
پایان

تابع نمایش(موارد: وکتور<رشته>، پوشه اصلی: رشته):
    هر مورد در موارد:
        سرچاپ "  " + مورد.زیررشته(پوشه اصلی.طول()، مورد.طول() - پوشه اصلی.طول())
    پایان
    سرچاپ "  count"، موارد.طول()
    موارد.آزادکن()
پایان

تابع ریشه:
    سرچاپ "empty and literal"
    بررسی(""، "")
    بررسی(""، "a")
    بررسی("a"، "")
    بررسی("a"، "a")
    بررسی("a"، "A")
    بررسی("abc"، "ab")
    بررسی("ab"، "abc")
    بررسی("a.b"، "a.b")
    بررسی("a.b"، "axb")

    سرچاپ "star"
    بررسی("*"، "abc")
    بررسی("*"، "a/b")
    بررسی("**"، "a/b/c")
    بررسی("a*"، "a")
    بررسی("*a"، "ba")
    بررسی("a*b*c"، "aXbYc")
    بررسی("a*b*c"، "aXbY")
    بررسی("**/a"، "a")
    بررسی("**/a"، "x/y/a")
    بررسی("a/**/b"، "a/b")
    بررسی("a/**/b"، "a/x/y/b")
    بررسی("a/**/b"، "a/xb")
    بررسی("a**b"، "aXXb")
    بررسی("a**b"، "a/b")
    بررسی("a/*/c"، "a/b/c")
    بررسی("a/*/c"، "a/b/d/c")

    سرچاپ "question"
    بررسی("?"، "a")
    بررسی("?"، "")
    بررسی("?"، "ab")
    بررسی("??"، "ab")
    بررسی("a?c"، "a/c")

    سرچاپ "classes"
    بررسی("[abc]"، "b")
    بررسی("[abc]"، "d")
    بررسی("[a-c]"، "c")
    بررسی("[a-c]"، "d")
    بررسی("[c-a]"، "b")
    بررسی("[!a]"، "b")
    بررسی("[!a]"، "a")
    بررسی("[^a]"، "b")
    بررسی("[a-]"، "-")
    بررسی("[]a]"، "]")
    بررسی("[a"، "a")
    بررسی("[a-c"، "b")
    بررسی("x["، "x")
    بررسی("[a-cx-z]"، "y")
    بررسی("[0-9][0-9]"، "42")
    بررسی("[0-9][0-9]"، "4x")
    بررسی("[!0-9]*"، "abc")
    بررسی("[!0-9]*"، "1bc")

    سرچاپ "escapes"
    بررسی("\\*"، "*")
    بررسی("\\*"، "a")
    بررسی("\\?"، "?")
    بررسی("a\\"، "a")
    بررسی("a\\"، "a\\")
    بررسی("\\[a]"، "[a]")
    بررسی("a\\/b"، "a/b")

    سرچاپ "unicode"
    بررسی("?"، "س")
    بررسی("??"، "س")
    بررسی("سلام*"، "سلام دنیا")
    بررسی("س?ام"، "سلام")
    بررسی("[ب-ن]"، "ل")
    بررسی("[ب-ن]"، "ا")
    بررسی("*.txt"، "سلام.txt")
    بررسی("é"، "é")
    بررسی("?"، "é")

    سرچاپ "meta"
    سرچاپ مسیر پرونده.الگو دارد("")، مسیر پرونده.الگو دارد("plain")، مسیر پرونده.الگو دارد("a/b/c.txt")
    سرچاپ مسیر پرونده.الگو دارد("*")، مسیر پرونده.الگو دارد("a?")، مسیر پرونده.الگو دارد("[a]")، مسیر پرونده.الگو دارد("a\\b")
    سرچاپ مسیر پرونده.الگو دارد("**")، مسیر پرونده.الگو دارد("a]")، مسیر پرونده.الگو دارد("a{b}")، مسیر پرونده.الگو دارد("!a")
    سرچاپ مسیر.الگو دارد("x*")، مسیر.الگو دارد("x")، مسیر.تطبیق الگو("[a-c]?"، "b1")، مسیر.تطبیق الگو("[a-c]?"، "d1")

    پوشه اصلی := موقت.پوشه موقت()
    دیرکن موقت.حذف پوشه(پوشه اصلی)
    سیستم عامل.ساخت پوشه ها(پوشه اصلی + "/sub/deep")
    سیستم عامل.ساخت پوشه ها(پوشه اصلی + "/empty")
    نام ها := [".hidden"، "a.txt"، "b.TXT"، "سلام.txt"، "سلام۲.txt"، "sub/x.txt"، "sub/y.c"، "sub/deep/z.txt"، "sub/.dot"]
    هر مسیر در نام ها:
        سیستم پرونده.نوشتن متن(پوشه اصلی + "/" + مسیر، "x")
    پایان

    سرچاپ "glob"
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/*")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/.*")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/*.txt")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/*.[tT][xX][tT]")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/**")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/**/*.txt")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/sub/**/z.txt")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/sub/deep/../x.txt")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/s?b/*")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/empty/*")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/empty")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/missing")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/missing/*")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/a.txt/*")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "//sub//x.txt")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/سلام*")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/سلام?.txt")، پوشه اصلی)
    نمایش(پوشه.الگوجویی(پوشه اصلی + "/*/*/*")، پوشه اصلی)
    نمایش(پوشه.الگوجویی("")، پوشه اصلی)

    سرچاپ "walk"
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "*.txt")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "*.c")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "z.txt")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "sub/*")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "**/*.txt")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "sub/**")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "empty")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "*")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی + "/"، "*.c")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی + "/sub"، "*.txt")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی + "/missing"، "*")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "")، پوشه اصلی)
    نمایش(پوشه.پیمایش با الگو(پوشه اصلی، "[a-")، پوشه اصلی)
پایان
