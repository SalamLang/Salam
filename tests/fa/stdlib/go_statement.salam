بسته ریشه

واردسازی حافظه
واردسازی استخر

ناپایا جمع := پوچ برگردان صحیح۶۴*

تابع افزودن(n: صحیح۶۴):
    اتمی‌بیفزا(جمع، n)
پایان

تابع افزودن دو(n: صحیح۶۴، اضافه: صحیح۶۴):
    اتمی‌بیفزا(جمع، n + اضافه)
پایان

تابع ریشه:
    جمع = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    تکرار 10 در i:
        برو افزودن((i + 1) برگردان صحیح۶۴)
    پایان
    استخر.انتظار برو()
    سرچاپ "sum of 1..10: "، اتمی‌بخوان(جمع)

    ناپایا پایه := 100
    برو افزودن دو(پایه برگردان صحیح۶۴، 5 برگردان صحیح۶۴)
    پایه = 0
    استخر.انتظار برو()
    سرچاپ "args copied when go ran: "، اتمی‌بخوان(جمع)

    ناپایا برو := درست
    تا برو:
        برو = نادرست
    پایان
    سرچاپ "go still works as a name: "، برو
    حافظه.آزادسازی(جمع برگردان تهی*)
پایان
