بسته ریشه

واردسازی گراف
واردسازی تبدیل

تابع f(x: اعشار۶۴): رشته:
    اگر x کوچکتر 0.00005 و x بزرگتر 0.0 - 0.00005:
        برگشت "0"
    پایان
    برگشت تبدیل.قالب اعشار با دقت(x، 4)
پایان

تابع نمایش وکتور(برچسب: رشته، v: وکتور<صحیح>):
    ناپایا s := برچسب
    تکرار v.طول() در i:
        s = s.پیوست(" ").پیوست(تبدیل.قالب عدد(v.بگیر(i) برگردان صحیح۶۴))
    پایان
    سرچاپ s
پایان

تابع نمایش اعشاری(برچسب: رشته، v: وکتور<اعشار۶۴>):
    ناپایا s := برچسب
    تکرار v.طول() در i:
        s = s.پیوست(" ").پیوست(f(v.بگیر(i)))
    پایان
    سرچاپ s
پایان

تابع ساخت نمونه(): گراف.گراف:
    ناپایا g := گراف.بی‌جهت جدید(4)
    g.افزودن یال وزن‌دار(0، 1، 2.0)
    g.افزودن یال وزن‌دار(1، 2، 3.0)
    g.افزودن یال وزن‌دار(2، 3، 4.0)
    g.افزودن یال وزن‌دار(3، 3، 1.0)
    برگشت g
پایان

تابع ریشه:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    گراف.دنباله(v، 5)
    نمایش وکتور("iota"، v)
    گراف.وارونه‌سازی(v)
    نمایش وکتور("reversed"، v)
    سرچاپ گراف.بیشینه صحیح(v)، گراف.مجموع صحیح(v)
    گراف.پرکردن صحیح(v، 3، 7)
    نمایش وکتور("fill"، v)
    ناپایا وکتور اعشاری := وکتور {} برگردان وکتور<اعشار۶۴>
    گراف.پرکردن اعشاری(وکتور اعشاری، 4، 0.5)
    سرچاپ f(گراف.مجموع اعشاری(وکتور اعشاری))
    ناپایا وکتور منطقی := وکتور {} برگردان وکتور<منطقی>
    گراف.پرکردن منطقی(وکتور منطقی، 3، درست)
    سرچاپ وکتور منطقی.طول()، وکتور منطقی.بگیر(2)
    v.آزادکن()
    وکتور اعشاری.آزادکن()
    وکتور منطقی.آزادکن()

    ناپایا مبداها := وکتور {} برگردان وکتور<صحیح>
    ناپایا مقصدها := وکتور {} برگردان وکتور<صحیح>
    مبداها.بیفزا(0)
    مبداها.بیفزا(1)
    مقصدها.بیفزا(1)
    مقصدها.بیفزا(2)
    ناپایا حاصل از یال := گراف.از یال‌ها(3، مبداها، مقصدها، درست)
    سرچاپ حاصل از یال.مرتبه()، حاصل از یال.اندازه()، حاصل از یال.جهت‌دار، حاصل از یال.دارای یال(1، 2)، حاصل از یال.دارای یال(2، 1)
    مبداها.آزادکن()
    مقصدها.آزادکن()
    حاصل از یال.آزادسازی()

    ناپایا تهی نمونه := گراف.گراف تهی(3)
    سرچاپ تهی نمونه.مرتبه()، تهی نمونه.اندازه()
    تهی نمونه.آزادسازی()

    ناپایا اتحادیه := گراف.مجموعه مجزا جدید(5)
    اتحادیه.یکی‌سازی(0، 1)
    اتحادیه.یکی‌سازی(3، 4)
    سرچاپ اتحادیه.شمار()، اتحادیه.متصل(0، 1)، اتحادیه.متصل(1، 3)
    اتحادیه.آزادسازی()

    ناپایا g := ساخت نمونه()
    سرچاپ g.اندازه()، گراف.دارای طوقه(g)، گراف.وزن کل(g)
    ناپایا بی‌طوقه := گراف.حذف طوقه‌ها(g)
    سرچاپ بی‌طوقه.اندازه()، گراف.دارای طوقه(بی‌طوقه)، گراف.وزن کل(بی‌طوقه)

    ناپایا نسخه جهت‌دار := گراف.به جهت‌دار(بی‌طوقه)
    سرچاپ نسخه جهت‌دار.جهت‌دار، نسخه جهت‌دار.اندازه()
    ناپایا نسخه بی‌جهت := گراف.به بی‌جهت(نسخه جهت‌دار)
    سرچاپ نسخه بی‌جهت.جهت‌دار، نسخه بی‌جهت.اندازه()
    نسخه جهت‌دار.آزادسازی()
    نسخه بی‌جهت.آزادسازی()

    ناپایا نگه‌دار := وکتور {} برگردان وکتور<منطقی>
    نگه‌دار.بیفزا(درست)
    نگه‌دار.بیفزا(درست)
    نگه‌دار.بیفزا(نادرست)
    نگه‌دار.بیفزا(درست)
    ناپایا نگاشت := وکتور {} برگردان وکتور<صحیح>
    ناپایا زیر گراف := گراف.زیرگراف با نگاشت(بی‌طوقه، نگه‌دار، نگاشت)
    سرچاپ زیر گراف.مرتبه()، زیر گراف.اندازه()
    نمایش وکتور("map"، نگاشت)
    زیر گراف.آزادسازی()
    نگاشت.آزادکن()
    نگه‌دار.آزادکن()

    ناپایا یال نگه‌دار := وکتور {} برگردان وکتور<منطقی>
    یال نگه‌دار.بیفزا(درست)
    یال نگه‌دار.بیفزا(نادرست)
    یال نگه‌دار.بیفزا(درست)
    ناپایا زیر یالی := گراف.زیرگراف یالی(بی‌طوقه، یال نگه‌دار)
    سرچاپ زیر یالی.مرتبه()، زیر یالی.اندازه()، زیر یالی.دارای یال(1، 2)، زیر یالی.دارای یال(0، 1)
    زیر یالی.آزادسازی()
    یال نگه‌دار.آزادکن()

    ناپایا دومی := گراف.بی‌جهت جدید(5)
    دومی.افزودن یال(0، 1)
    دومی.افزودن یال(3، 4)
    ناپایا حاصل اجتماع := گراف.اجتماع(بی‌طوقه، دومی)
    سرچاپ حاصل اجتماع.مرتبه()، حاصل اجتماع.اندازه()
    ناپایا اجتماع مجزا نمونه := گراف.اجتماع مجزا(بی‌طوقه، دومی)
    سرچاپ اجتماع مجزا نمونه.مرتبه()، اجتماع مجزا نمونه.اندازه()، اجتماع مجزا نمونه.دارای یال(5، 6)
    ناپایا حاصل اشتراک := گراف.اشتراک(بی‌طوقه، دومی)
    سرچاپ حاصل اشتراک.مرتبه()، حاصل اشتراک.اندازه()، حاصل اشتراک.دارای یال(0، 1)
    حاصل اجتماع.آزادسازی()
    اجتماع مجزا نمونه.آزادسازی()
    حاصل اشتراک.آزادسازی()
    دومی.آزادسازی()
    بی‌طوقه.آزادسازی()
    g.آزادسازی()

    ناپایا p := گراف.گراف مسیر(3)
    ناپایا a := گراف.ماتریس مجاورت(p)
    ناپایا w := گراف.ماتریس وزن(p)
    ناپایا d := گراف.ماتریس درجه(p)
    ناپایا لاپلاس := گراف.لاپلاس بهنجار(p)
    سرچاپ f(a.عنصر(0، 1))، f(w.عنصر(0، 1))، f(d.عنصر(1، 1))، f(لاپلاس.عنصر(0، 0))، f(لاپلاس.عنصر(0، 1))
    ناپایا همانی := گراف.ماتریس همانی(3)
    ناپایا حاصل ضرب := گراف.ضرب ماتریس(a، a)
    ناپایا توان سوم := گراف.توان ماتریس(a، 3)
    سرچاپ f(همانی.رد())، f(حاصل ضرب.عنصر(0، 0))، f(حاصل ضرب.عنصر(0، 2))، f(توان سوم.عنصر(0، 1))، f(توان سوم.عنصر(1، 1))
    ناپایا ماتریس مستطیلی := گراف.ماتریس جدید(2، 3)
    ماتریس مستطیلی.تنظیم(1، 2، 4.5)
    سرچاپ ماتریس مستطیلی.سطرها، ماتریس مستطیلی.ستون‌ها، f(ماتریس مستطیلی.عنصر(1، 2))
    ناپایا ماتریس مربعی := گراف.ماتریس جدید(2، 2)
    ماتریس مربعی.تنظیم(0، 0، 2.0)
    ماتریس مربعی.تنظیم(0، 1، 1.0)
    ماتریس مربعی.تنظیم(1، 0، 1.0)
    ماتریس مربعی.تنظیم(1، 1، 3.0)
    سرچاپ f(گراف.دترمینان(ماتریس مربعی))
    ناپایا ویژه ها := گراف.مقادیر ویژه متقارن(ماتریس مربعی)
    نمایش اعشاری("eig"، ویژه ها)
    ناپایا طیف نمونه := گراف.طیف مجاورت(p)
    نمایش اعشاری("spectrum"، طیف نمونه)
    ویژه ها.آزادسازی()
    طیف نمونه.آزادسازی()
    a.آزادسازی()
    w.آزادسازی()
    d.آزادسازی()
    لاپلاس.آزادسازی()
    همانی.آزادسازی()
    حاصل ضرب.آزادسازی()
    توان سوم.آزادسازی()
    ماتریس مستطیلی.آزادسازی()
    ماتریس مربعی.آزادسازی()
    p.آزادسازی()
پایان
