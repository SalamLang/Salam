بسته ریشه

واردسازی گراف
واردسازی تبدیل

تابع f(x: اعشار۶۴): رشته:
    اگر x کوچکتر 0.00005 و x بزرگتر 0.0 - 0.00005:
        برگشت "0"
    پایان
    برگشت تبدیل.قالب اعشار با دقت(x، 4)
پایان

تابع show(label: رشته، v: وکتور<صحیح>):
    ناپایا s := label
    تکرار v.طول() در i:
        s = s.پیوست(" ").پیوست(تبدیل.قالب عدد(v.بگیر(i) برگردان صحیح۶۴))
    پایان
    سرچاپ s
پایان

تابع showf(label: رشته، v: وکتور<اعشار۶۴>):
    ناپایا s := label
    تکرار v.طول() در i:
        s = s.پیوست(" ").پیوست(f(v.بگیر(i)))
    پایان
    سرچاپ s
پایان

تابع sample(): گراف.گراف:
    ناپایا g := گراف.بی‌جهت جدید(4)
    g.افزودن یال وزن‌دار(0، 1، 2.0)
    g.افزودن یال وزن‌دار(1، 2، 3.0)
    g.افزودن یال وزن‌دار(2، 3، 4.0)
    g.افزودن یال وزن‌دار(3، 3، 1.0)
    برگشت g
پایان

تابع ریشه:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    گراف.دنباله(v، 5)
    show("iota"، v)
    گراف.وارونه‌سازی(v)
    show("reversed"، v)
    سرچاپ گراف.بیشینه صحیح(v)، گراف.مجموع صحیح(v)
    گراف.پرکردن صحیح(v، 3، 7)
    show("fill"، v)
    ناپایا fl := وکتور {} برگردان وکتور<اعشار۶۴>
    گراف.پرکردن اعشاری(fl، 4، 0.5)
    سرچاپ f(گراف.مجموع اعشاری(fl))
    ناپایا fb := وکتور {} برگردان وکتور<منطقی>
    گراف.پرکردن منطقی(fb، 3، درست)
    سرچاپ fb.طول()، fb.بگیر(2)
    v.آزادکن()
    fl.آزادکن()
    fb.آزادکن()

    ناپایا us := وکتور {} برگردان وکتور<صحیح>
    ناپایا vs := وکتور {} برگردان وکتور<صحیح>
    us.بیفزا(0)
    us.بیفزا(1)
    vs.بیفزا(1)
    vs.بیفزا(2)
    ناپایا fe := گراف.از یال‌ها(3، us، vs، درست)
    سرچاپ fe.مرتبه()، fe.اندازه()، fe.جهت‌دار، fe.دارای یال(1، 2)، fe.دارای یال(2، 1)
    us.آزادکن()
    vs.آزادکن()
    fe.آزادسازی()

    ناپایا e0 := گراف.گراف تهی(3)
    سرچاپ e0.مرتبه()، e0.اندازه()
    e0.آزادسازی()

    ناپایا ds := گراف.مجموعه مجزا جدید(5)
    ds.یکی‌سازی(0، 1)
    ds.یکی‌سازی(3، 4)
    سرچاپ ds.شمار()، ds.متصل(0، 1)، ds.متصل(1، 3)
    ds.آزادسازی()

    ناپایا g := sample()
    سرچاپ g.اندازه()، گراف.دارای طوقه(g)، گراف.وزن کل(g)
    ناپایا ns := گراف.حذف طوقه‌ها(g)
    سرچاپ ns.اندازه()، گراف.دارای طوقه(ns)، گراف.وزن کل(ns)

    ناپایا dir := گراف.به جهت‌دار(ns)
    سرچاپ dir.جهت‌دار، dir.اندازه()
    ناپایا und := گراف.به بی‌جهت(dir)
    سرچاپ und.جهت‌دار، und.اندازه()
    dir.آزادسازی()
    und.آزادسازی()

    ناپایا keep := وکتور {} برگردان وکتور<منطقی>
    keep.بیفزا(درست)
    keep.بیفزا(درست)
    keep.بیفزا(نادرست)
    keep.بیفزا(درست)
    ناپایا map := وکتور {} برگردان وکتور<صحیح>
    ناپایا sub := گراف.زیرگراف با نگاشت(ns، keep، map)
    سرچاپ sub.مرتبه()، sub.اندازه()
    show("map"، map)
    sub.آزادسازی()
    map.آزادکن()
    keep.آزادکن()

    ناپایا ek := وکتور {} برگردان وکتور<منطقی>
    ek.بیفزا(درست)
    ek.بیفزا(نادرست)
    ek.بیفزا(درست)
    ناپایا es := گراف.زیرگراف یالی(ns، ek)
    سرچاپ es.مرتبه()، es.اندازه()، es.دارای یال(1، 2)، es.دارای یال(0، 1)
    es.آزادسازی()
    ek.آزادکن()

    ناپایا other := گراف.بی‌جهت جدید(5)
    other.افزودن یال(0، 1)
    other.افزودن یال(3، 4)
    ناپایا un := گراف.اجتماع(ns، other)
    سرچاپ un.مرتبه()، un.اندازه()
    ناپایا du := گراف.اجتماع مجزا(ns، other)
    سرچاپ du.مرتبه()، du.اندازه()، du.دارای یال(5، 6)
    ناپایا inter := گراف.اشتراک(ns، other)
    سرچاپ inter.مرتبه()، inter.اندازه()، inter.دارای یال(0، 1)
    un.آزادسازی()
    du.آزادسازی()
    inter.آزادسازی()
    other.آزادسازی()
    ns.آزادسازی()
    g.آزادسازی()

    ناپایا p := گراف.گراف مسیر(3)
    ناپایا a := گراف.ماتریس مجاورت(p)
    ناپایا w := گراف.ماتریس وزن(p)
    ناپایا d := گراف.ماتریس درجه(p)
    ناپایا nl := گراف.لاپلاس بهنجار(p)
    سرچاپ f(a.عنصر(0، 1))، f(w.عنصر(0، 1))، f(d.عنصر(1، 1))، f(nl.عنصر(0، 0))، f(nl.عنصر(0، 1))
    ناپایا id := گراف.ماتریس همانی(3)
    ناپایا prod := گراف.ضرب ماتریس(a، a)
    ناپایا pw := گراف.توان ماتریس(a، 3)
    سرچاپ f(id.رد())، f(prod.عنصر(0، 0))، f(prod.عنصر(0، 2))، f(pw.عنصر(0، 1))، f(pw.عنصر(1، 1))
    ناپایا nm := گراف.ماتریس جدید(2، 3)
    nm.تنظیم(1، 2، 4.5)
    سرچاپ nm.سطرها، nm.ستون‌ها، f(nm.عنصر(1، 2))
    ناپایا sq := گراف.ماتریس جدید(2، 2)
    sq.تنظیم(0، 0، 2.0)
    sq.تنظیم(0، 1، 1.0)
    sq.تنظیم(1، 0، 1.0)
    sq.تنظیم(1، 1، 3.0)
    سرچاپ f(گراف.دترمینان(sq))
    ناپایا ev := گراف.مقادیر ویژه متقارن(sq)
    showf("eig"، ev)
    ناپایا sp := گراف.طیف مجاورت(p)
    showf("spectrum"، sp)
    ev.آزادسازی()
    sp.آزادسازی()
    a.آزادسازی()
    w.آزادسازی()
    d.آزادسازی()
    nl.آزادسازی()
    id.آزادسازی()
    prod.آزادسازی()
    pw.آزادسازی()
    nm.آزادسازی()
    sq.آزادسازی()
    p.آزادسازی()
پایان
