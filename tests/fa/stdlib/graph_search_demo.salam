بسته ریشه

واردسازی گراف
واردسازی تبدیل

تابع f(x: اعشار۶۴): رشته:
    اگر x کوچکتر 0.00005 و x بزرگتر 0.0 - 0.00005:
        برگشت "0"
    پایان
    برگشت تبدیل.قالب اعشار با دقت(x، 4)
پایان

تابع show(label: رشته، v: وکتور<صحیح>):
    ناپایا s := label
    تکرار v.طول() در i:
        s = s.پیوست(" ").پیوست(تبدیل.قالب عدد(v.بگیر(i) برگردان صحیح۶۴))
    پایان
    سرچاپ s
پایان

تابع showf(label: رشته، v: وکتور<اعشار۶۴>):
    ناپایا s := label
    تکرار v.طول() در i:
        s = s.پیوست(" ").پیوست(f(v.بگیر(i)))
    پایان
    سرچاپ s
پایان

تابع diamond(): گراف.گراف:
    ناپایا g := گراف.جهت‌دار جدید(5)
    g.افزودن یال(0، 1)
    g.افزودن یال(0، 2)
    g.افزودن یال(1، 3)
    g.افزودن یال(2، 3)
    g.افزودن یال(3، 4)
    برگشت g
پایان

تابع ریشه:
    ناپایا g := diamond()
    ناپایا dist := وکتور {} برگردان وکتور<صحیح>
    ناپایا parent := وکتور {} برگردان وکتور<صحیح>
    گراف.پیمایش سطحی از(g، 0، dist، parent)
    show("dist"، dist)
    show("parent"، parent)
    ناپایا path := گراف.مسیر از والدها(parent، 0، 4)
    show("path"، path)
    ناپایا bo := گراف.ترتیب سطحی(g، 0)
    show("bfs"، bo)
    ناپایا po := گراف.ترتیب پسین عمقی(g، 0)
    show("post"، po)
    ناپایا forest := گراف.جنگل عمقی(g)
    show("forest"، forest)
    ناپایا reach := گراف.دست‌یافتنی(g، 2)
    سرچاپ reach.بگیر(0)، reach.بگیر(3)، reach.بگیر(4)
    سرچاپ گراف.شمار دست‌یافتنی(g، 0)، گراف.شمار دست‌یافتنی(g، 3)، گراف.شمار دست‌یافتنی(g، 4)
    dist.آزادکن()
    parent.آزادکن()
    path.آزادسازی()
    bo.آزادسازی()
    po.آزادسازی()
    forest.آزادسازی()
    reach.آزادسازی()

    ناپایا order := وکتور {} برگردان وکتور<صحیح>
    سرچاپ گراف.مرتب‌سازی توپولوژیک(g، order)
    show("topo"، order)
    ناپایا pc := گراف.شمارش مسیرها(g، 0)
    showf("paths"، pc)
    سرچاپ گراف.شمار مؤلفه قوی(g)
    ناپایا hops := گراف.همه فاصله‌های گامی(g)
    سرچاپ hops.عنصر(0، 4)، hops.عنصر(4، 0)، hops.عنصر(1، 2)
    hops.آزادسازی()
    ناپایا icen := گراف.مرکزیت درجه ورودی(g)
    ناپایا ocen := گراف.مرکزیت درجه خروجی(g)
    showf("in"، icen)
    showf("out"، ocen)
    گراف.مقیاس به مجموع(icen)
    سرچاپ f(گراف.مجموع اعشاری(icen))
    icen.آزادسازی()
    ocen.آزادسازی()
    pc.آزادسازی()
    order.آزادکن()

    ناپایا cyc := گراف.جهت‌دار جدید(3)
    cyc.افزودن یال(0، 1)
    cyc.افزودن یال(1، 2)
    cyc.افزودن یال(2، 0)
    ناپایا co := وکتور {} برگردان وکتور<صحیح>
    سرچاپ گراف.مرتب‌سازی توپولوژیک(cyc، co)
    سرچاپ گراف.شمار مؤلفه قوی(cyc)
    co.آزادکن()
    cyc.آزادسازی()

    ناپایا fnet := گراف.شار از گراف(g)
    سرچاپ f(گراف.بیشینه شار(fnet، 0، 4))
    fnet.آزادسازی()
    g.آزادسازی()

    ناپایا sq := گراف.گراف دور(4)
    ناپایا col := وکتور {} برگردان وکتور<صحیح>
    سرچاپ گراف.دوبخشی است(sq، col)
    show("colors"، col)
    ناپایا ord := وکتور {} برگردان وکتور<صحیح>
    گراف.دنباله(ord، 4)
    ناپایا gc := گراف.رنگ‌آمیزی حریصانه(sq، ord)
    show("greedy"، gc)
    سرچاپ گراف.رنگ‌آمیزی معتبر است(sq، gc)
    gc.آزادسازی()
    col.آزادکن()
    ord.آزادکن()
    ناپایا tri := گراف.گراف دور(3)
    ناپایا col3 := وکتور {} برگردان وکتور<صحیح>
    سرچاپ گراف.دوبخشی است(tri، col3)
    col3.آزادکن()
    tri.آزادسازی()

    سرچاپ گراف.برون‌مرکزی(sq، 0)
    ناپایا ecc := گراف.همه برون‌مرکزی‌ها(sq)
    show("ecc"، ecc)
    ecc.آزادسازی()
    سرچاپ f(گراف.میانگین طول مسیر(sq))
    سرچاپ f(گراف.وزن درخت پوشا(sq))
    ناپایا indep := گراف.بیشینه مجموعه مستقل(sq)
    سرچاپ indep.طول()
    indep.آزادسازی()
    ناپایا tour := گراف.ابتکاری فروشنده دوره‌گرد(sq، 0)
    سرچاپ tour.طول()
    show("tour"، tour)
    tour.آزادسازی()
    sq.آزادسازی()

    ناپایا w := گراف.بی‌جهت جدید(4)
    w.افزودن یال وزن‌دار(0، 1، 1.5)
    w.افزودن یال وزن‌دار(1، 2، 2.5)
    w.افزودن یال وزن‌دار(2، 3، 3.0)
    سرچاپ f(گراف.قطر وزنی(w))
    سرچاپ f(گراف.وزن درخت پوشا(w))
    ناپایا star := گراف.گراف ستاره(5)
    سرچاپ f(گراف.همگون‌گرایی(star))
    star.آزادسازی()
    w.آزادسازی()

    ناپایا t := گراف.گراف مسیر(4)
    ناپایا tp := وکتور {} برگردان وکتور<صحیح>
    ناپایا tord := وکتور {} برگردان وکتور<صحیح>
    گراف.ریشه‌دار کردن(t، 0، tp، tord)
    show("tparent"، tp)
    show("torder"، tord)
    سرچاپ گراف.درخت به رشته(t، 0)
    tp.آزادکن()
    tord.آزادکن()
    t.آزادسازی()
پایان
