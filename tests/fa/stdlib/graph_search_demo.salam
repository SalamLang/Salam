بسته ریشه

واردسازی گراف
واردسازی تبدیل

تابع f(x: اعشار۶۴): رشته:
    اگر x کوچکتر 0.00005 و x بزرگتر 0.0 - 0.00005:
        برگشت "0"
    پایان
    برگشت تبدیل.قالب اعشار با دقت(x، 4)
پایان

تابع نمایش وکتور(برچسب: رشته، v: وکتور<صحیح>):
    ناپایا s := برچسب
    تکرار v.طول() در i:
        s = s.پیوست(" ").پیوست(تبدیل.قالب عدد(v.بگیر(i) برگردان صحیح۶۴))
    پایان
    سرچاپ s
پایان

تابع نمایش اعشاری(برچسب: رشته، v: وکتور<اعشار۶۴>):
    ناپایا s := برچسب
    تکرار v.طول() در i:
        s = s.پیوست(" ").پیوست(f(v.بگیر(i)))
    پایان
    سرچاپ s
پایان

تابع ساخت لوزی(): گراف.گراف:
    ناپایا g := گراف.جهت‌دار جدید(5)
    g.افزودن یال(0، 1)
    g.افزودن یال(0، 2)
    g.افزودن یال(1، 3)
    g.افزودن یال(2، 3)
    g.افزودن یال(3، 4)
    برگشت g
پایان

تابع ریشه:
    ناپایا g := ساخت لوزی()
    ناپایا فاصله ها := وکتور {} برگردان وکتور<صحیح>
    ناپایا والدها := وکتور {} برگردان وکتور<صحیح>
    گراف.پیمایش سطحی از(g، 0، فاصله ها، والدها)
    نمایش وکتور("dist"، فاصله ها)
    نمایش وکتور("parent"، والدها)
    ناپایا مسیر := گراف.مسیر از والدها(والدها، 0، 4)
    نمایش وکتور("path"، مسیر)
    ناپایا سطحی := گراف.ترتیب سطحی(g، 0)
    نمایش وکتور("bfs"، سطحی)
    ناپایا پسین := گراف.ترتیب پسین عمقی(g، 0)
    نمایش وکتور("post"، پسین)
    ناپایا جنگل := گراف.جنگل عمقی(g)
    نمایش وکتور("forest"، جنگل)
    ناپایا دست‌یافته := گراف.دست‌یافتنی(g، 2)
    سرچاپ دست‌یافته.بگیر(0)، دست‌یافته.بگیر(3)، دست‌یافته.بگیر(4)
    سرچاپ گراف.شمار دست‌یافتنی(g، 0)، گراف.شمار دست‌یافتنی(g، 3)، گراف.شمار دست‌یافتنی(g، 4)
    فاصله ها.آزادکن()
    والدها.آزادکن()
    مسیر.آزادسازی()
    سطحی.آزادسازی()
    پسین.آزادسازی()
    جنگل.آزادسازی()
    دست‌یافته.آزادسازی()

    ناپایا ترتیب := وکتور {} برگردان وکتور<صحیح>
    سرچاپ گراف.مرتب‌سازی توپولوژیک(g، ترتیب)
    نمایش وکتور("topo"، ترتیب)
    ناپایا تعداد مسیرها := گراف.شمارش مسیرها(g، 0)
    نمایش اعشاری("paths"، تعداد مسیرها)
    سرچاپ گراف.شمار مؤلفه قوی(g)
    ناپایا گام ها := گراف.همه فاصله‌های گامی(g)
    سرچاپ گام ها.عنصر(0، 4)، گام ها.عنصر(4، 0)، گام ها.عنصر(1، 2)
    گام ها.آزادسازی()
    ناپایا مرکز دریافتی := گراف.مرکزیت درجه ورودی(g)
    ناپایا مرکز ارسالی := گراف.مرکزیت درجه خروجی(g)
    نمایش اعشاری("in"، مرکز دریافتی)
    نمایش اعشاری("out"، مرکز ارسالی)
    گراف.مقیاس به مجموع(مرکز دریافتی)
    سرچاپ f(گراف.مجموع اعشاری(مرکز دریافتی))
    مرکز دریافتی.آزادسازی()
    مرکز ارسالی.آزادسازی()
    تعداد مسیرها.آزادسازی()
    ترتیب.آزادکن()

    ناپایا چرخه := گراف.جهت‌دار جدید(3)
    چرخه.افزودن یال(0، 1)
    چرخه.افزودن یال(1، 2)
    چرخه.افزودن یال(2، 0)
    ناپایا ترتیب چرخه := وکتور {} برگردان وکتور<صحیح>
    سرچاپ گراف.مرتب‌سازی توپولوژیک(چرخه، ترتیب چرخه)
    سرچاپ گراف.شمار مؤلفه قوی(چرخه)
    ترتیب چرخه.آزادکن()
    چرخه.آزادسازی()

    ناپایا شبکه شار := گراف.شار از گراف(g)
    سرچاپ f(گراف.بیشینه شار(شبکه شار، 0، 4))
    شبکه شار.آزادسازی()
    g.آزادسازی()

    ناپایا مربع := گراف.گراف دور(4)
    ناپایا رنگ ها := وکتور {} برگردان وکتور<صحیح>
    سرچاپ گراف.دوبخشی است(مربع، رنگ ها)
    نمایش وکتور("colors"، رنگ ها)
    ناپایا ترتیب رنگ := وکتور {} برگردان وکتور<صحیح>
    گراف.دنباله(ترتیب رنگ، 4)
    ناپایا رنگ حریصانه := گراف.رنگ‌آمیزی حریصانه(مربع، ترتیب رنگ)
    نمایش وکتور("greedy"، رنگ حریصانه)
    سرچاپ گراف.رنگ‌آمیزی معتبر است(مربع، رنگ حریصانه)
    رنگ حریصانه.آزادسازی()
    رنگ ها.آزادکن()
    ترتیب رنگ.آزادکن()
    ناپایا مثلث := گراف.گراف دور(3)
    ناپایا رنگ مثلث := وکتور {} برگردان وکتور<صحیح>
    سرچاپ گراف.دوبخشی است(مثلث، رنگ مثلث)
    رنگ مثلث.آزادکن()
    مثلث.آزادسازی()

    سرچاپ گراف.برون‌مرکزی(مربع، 0)
    ناپایا برون‌مرکزی ها := گراف.همه برون‌مرکزی‌ها(مربع)
    نمایش وکتور("ecc"، برون‌مرکزی ها)
    برون‌مرکزی ها.آزادسازی()
    سرچاپ f(گراف.میانگین طول مسیر(مربع))
    سرچاپ f(گراف.وزن درخت پوشا(مربع))
    ناپایا مستقل := گراف.بیشینه مجموعه مستقل(مربع)
    سرچاپ مستقل.طول()
    مستقل.آزادسازی()
    ناپایا تور := گراف.ابتکاری فروشنده دوره‌گرد(مربع، 0)
    سرچاپ تور.طول()
    نمایش وکتور("tour"، تور)
    تور.آزادسازی()
    مربع.آزادسازی()

    ناپایا w := گراف.بی‌جهت جدید(4)
    w.افزودن یال وزن‌دار(0، 1، 1.5)
    w.افزودن یال وزن‌دار(1، 2، 2.5)
    w.افزودن یال وزن‌دار(2، 3، 3.0)
    سرچاپ f(گراف.قطر وزنی(w))
    سرچاپ f(گراف.وزن درخت پوشا(w))
    ناپایا ستاره := گراف.گراف ستاره(5)
    سرچاپ f(گراف.همگون‌گرایی(ستاره))
    ستاره.آزادسازی()
    w.آزادسازی()

    ناپایا t := گراف.گراف مسیر(4)
    ناپایا والد درخت := وکتور {} برگردان وکتور<صحیح>
    ناپایا ترتیب درخت := وکتور {} برگردان وکتور<صحیح>
    گراف.ریشه‌دار کردن(t، 0، والد درخت، ترتیب درخت)
    نمایش وکتور("tparent"، والد درخت)
    نمایش وکتور("torder"، ترتیب درخت)
    سرچاپ گراف.درخت به رشته(t، 0)
    والد درخت.آزادکن()
    ترتیب درخت.آزادکن()
    t.آزادسازی()
پایان
