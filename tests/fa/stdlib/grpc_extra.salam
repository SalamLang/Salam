بسته ریشه

واردسازی جی آر پی سی
واردسازی فشرده سازی
واردسازی آزمایش
واردسازی همگام سازی
واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی

ناپایا گروه سرور := همگام سازی.گروه انتظار جدید()
ناپایا درگاه سرور := 0
ناپایا کارگزار := جی آر پی سی.سرور جدید(0)
ناپایا کارگزار مستقیم := تی سی پی.سرور {}

تابع برچسب زن(شناسه فراخوان: صحیح۶۴):
    ناپایا موفق := نادرست
    جی آر پی سی.دریافت متن(شناسه فراخوان، موفق)
    جی آر پی سی.ارسال متن(شناسه فراخوان، "reply")
    جی آر پی سی.تنظیم وضعیت(شناسه فراخوان، جی آر پی سی.وضعیت بدون خطا، "")
پایان

تابع خدمت حلقه محلی():
    جی آر پی سی.گوش دادن(کارگزار)
    درگاه سرور = جی آر پی سی.درگاه(کارگزار)
    همگام سازی.اتمام(گروه سرور)
    جی آر پی سی.خدمت به تعداد(کارگزار، 1)
پایان

تابع خدمت مستقیم():
    c := تی سی پی.پذیرش(کارگزار مستقیم)
    آزمایش.ادعای برابری عدد(جی آر پی سی.خدمت به اتصال(c.توصیفگر)، 1)
    تی سی پی.بستن(c)
پایان

تابع بررسی فراداده سرآیندها():
    ناپایا فراداده := جی آر پی سی.فراداده جدید()
    جی آر پی سی.افزودن فراداده(فراداده، "x-user"، "ali")
    جی آر پی سی.افزودن فراداده دودویی(فراداده، "blob-bin"، "raw")
    آزمایش.ادعای برابری رشته(جی آر پی سی.مقدار فراداده(فراداده، 0)، "ali")
    آزمایش.ادعای برابری رشته(جی آر پی سی.مقدار فراداده(فراداده، 1)، "raw")
    آزمایش.ادعای برابری رشته(جی آر پی سی.مقدار فراداده(فراداده، 9)، "")

    ناپایا سرآیندهای من := اچ تی تی پی۲.فهرست سرآیندها {}
    جی آر پی سی.فراداده به سرآیند(فراداده، سرآیندهای من)
    آزمایش.ادعای برابری رشته(اچ تی تی پی۲.دریافت سرآیند(سرآیندهای من، "x-user")، "ali")
    آزمایش.ادعای برابری رشته(اچ تی تی پی۲.دریافت سرآیند(سرآیندهای من، "blob-bin")، "cmF3")

    اچ تی تی پی۲.افزودن سرآیند(سرآیندهای من، "grpc-status"، "0")
    بازگشتی := جی آر پی سی.فراداده از سرآیند(سرآیندهای من)
    آزمایش.ادعای برابری عدد(جی آر پی سی.تعداد فراداده(بازگشتی)، 2)
    آزمایش.ادعای برابری رشته(جی آر پی سی.دریافت فراداده(بازگشتی، "x-user")، "ali")
    آزمایش.ادعای برابری رشته(جی آر پی سی.دریافت فراداده(بازگشتی، "blob-bin")، "raw")
    آزمایش.ادعای نادرستی(جی آر پی سی.فراداده دارد(بازگشتی، "grpc-status"))
پایان

تابع بررسی بازنشانی ثبت():
    آزمایش.ادعای درستی(جی آر پی سی.متد دارد("/demo.Tagger/Tag"))
    جی آر پی سی.بازنشانی متدها()
    آزمایش.ادعای نادرستی(جی آر پی سی.متد دارد("/demo.Tagger/Tag"))
    آزمایش.ادعای برابری عدد(جی آر پی سی.تعداد متدها()، 0)
    جی آر پی سی.ثبت متد("/demo.Tagger/Tag"، برچسب زن)
    آزمایش.ادعای برابری عدد(جی آر پی سی.تعداد متدها()، 1)
پایان

تابع بررسی توقف سرور():
    ناپایا s := جی آر پی سی.سرور جدید(0)
    آزمایش.ادعای درستی(جی آر پی سی.گوش دادن(s))
    p := جی آر پی سی.درگاه(s)
    آزمایش.ادعای درستی(p بزرگتر 0)
    جی آر پی سی.توقف سرور(s)
    کانال متوقف := جی آر پی سی.اتصال("127.0.0.1"، p)
    آزمایش.ادعای نادرستی(جی آر پی سی.کانال معتبر(کانال متوقف))
پایان

تابع بررسی شکست اتصال امن():
    کانال := جی آر پی سی.اتصال امن("127.0.0.1"، 1)
    آزمایش.ادعای نادرستی(جی آر پی سی.کانال معتبر(کانال))
    آزمایش.ادعای درستی(جی آر پی سی.خطای کانال(کانال) نابرابر "")
پایان

تابع بررسی فراخوان زنده():
    همگام سازی.افزودن(گروه سرور، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(خدمت حلقه محلی)
    همگام سازی.انتظار(گروه سرور)
    آزمایش.ادعای درستی(درگاه سرور بزرگتر 0)

    ناپایا کانال := جی آر پی سی.اتصال("127.0.0.1"، درگاه سرور)
    آزمایش.ادعای درستی(جی آر پی سی.کانال معتبر(کانال))
    جی آر پی سی.فعال‌سازی فشرده‌سازی(کانال، درست)

    ناپایا فراداده := جی آر پی سی.فراداده جدید()
    جی آر پی سی.افزودن فراداده(فراداده، "x-trace"، "t1")
    ناپایا وضعیت نمونه := جی آر پی سی.وضعیت {}
    ناپایا درخواست := فشرده سازی.بافر از رشته("hi")
    ناپایا پاسخ := جی آر پی سی.فراخوان یگانه(کانال، "/demo.Tagger/Tag"، درخواست، فراداده، وضعیت نمونه)
    آزمایش.ادعای برابری عدد(وضعیت نمونه.کد، جی آر پی سی.وضعیت بدون خطا)
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(پاسخ)، "reply")

    شناسه جریان := جی آر پی سی.شروع فراخوان(کانال، "/demo.Tagger/Tag"، فراداده)
    ناپایا بدنه := فشرده سازی.بافر از رشته("hi")
    آزمایش.ادعای درستی(جی آر پی سی.ارسال پیام(کانال، شناسه جریان، بدنه، نادرست))
    آزمایش.ادعای درستی(جی آر پی سی.بستن ارسال(کانال، شناسه جریان))
    ناپایا موفق := نادرست
    ناپایا دریافتی := جی آر پی سی.دریافت پیام(کانال، شناسه جریان، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(دریافتی)، "reply")
    پایانی := جی آر پی سی.پایان فراخوان(کانال، شناسه جریان)
    آزمایش.ادعای برابری عدد(پایانی.کد، جی آر پی سی.وضعیت بدون خطا)
    سرآیندهای دریافتی := جی آر پی سی.سرآیندهای فراخوان(کانال، شناسه جریان)
    دنباله ها := جی آر پی سی.دنباله‌های فراخوان(کانال، شناسه جریان)
    آزمایش.ادعای نادرستی(جی آر پی سی.فراداده دارد(سرآیندهای دریافتی، "grpc-status"))
    آزمایش.ادعای برابری عدد(جی آر پی سی.تعداد فراداده(دنباله ها)، 0)

    فشرده سازی.آزادسازی بافر(درخواست)
    فشرده سازی.آزادسازی بافر(پاسخ)
    فشرده سازی.آزادسازی بافر(بدنه)
    فشرده سازی.آزادسازی بافر(دریافتی)
    جی آر پی سی.بستن کانال(کانال)
    نخ‌پیوند(t)

    کارگزار مستقیم = تی سی پی.پیوند(0)
    نخ دوم := نخ‌ساز(خدمت مستقیم)
    ناپایا کانال مستقیم := جی آر پی سی.اتصال("127.0.0.1"، تی سی پی.درگاه(کارگزار مستقیم))
    آزمایش.ادعای درستی(جی آر پی سی.کانال معتبر(کانال مستقیم))
    ناپایا وضعیت مستقیم := جی آر پی سی.وضعیت {}
    آزمایش.ادعای برابری رشته(جی آر پی سی.فراخوان یگانه متنی(کانال مستقیم، "/demo.Tagger/Tag"، "hi"، وضعیت مستقیم)، "reply")
    آزمایش.ادعای برابری عدد(وضعیت مستقیم.کد، جی آر پی سی.وضعیت بدون خطا)
    جی آر پی سی.بستن کانال(کانال مستقیم)
    نخ‌پیوند(نخ دوم)
    تی سی پی.بستن سرور(کارگزار مستقیم)
پایان

تابع ریشه:
    جی آر پی سی.ثبت متد("/demo.Tagger/Tag"، برچسب زن)
    بررسی فراداده سرآیندها()
    بررسی توقف سرور()
    بررسی شکست اتصال امن()
    بررسی فراخوان زنده()
    بررسی بازنشانی ثبت()
    برگشت آزمایش.خلاصه()
پایان
