بسته ریشه

واردسازی جی آر پی سی
واردسازی فشرده سازی
واردسازی آزمایش
واردسازی همگام سازی
واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی

ناپایا srv wg := همگام سازی.گروه انتظار جدید()
ناپایا bound port := 0
ناپایا server := جی آر پی سی.سرور جدید(0)
ناپایا direct server := تی سی پی.سرور {}

تابع tagger(call: صحیح۶۴):
    ناپایا ok := نادرست
    جی آر پی سی.دریافت متن(call، ok)
    جی آر پی سی.ارسال متن(call، "reply")
    جی آر پی سی.تنظیم وضعیت(call، جی آر پی سی.وضعیت بدون خطا، "")
پایان

تابع serve loopback():
    جی آر پی سی.گوش دادن(server)
    bound port = جی آر پی سی.درگاه(server)
    همگام سازی.اتمام(srv wg)
    جی آر پی سی.خدمت به تعداد(server، 1)
پایان

تابع serve direct():
    c := تی سی پی.پذیرش(direct server)
    آزمایش.ادعای برابری عدد(جی آر پی سی.خدمت به اتصال(c.توصیفگر)، 1)
    تی سی پی.بستن(c)
پایان

تابع check metadata headers():
    ناپایا md := جی آر پی سی.فراداده جدید()
    جی آر پی سی.افزودن فراداده(md، "x-user"، "ali")
    جی آر پی سی.افزودن فراداده دودویی(md، "blob-bin"، "raw")
    آزمایش.ادعای برابری رشته(جی آر پی سی.مقدار فراداده(md، 0)، "ali")
    آزمایش.ادعای برابری رشته(جی آر پی سی.مقدار فراداده(md، 1)، "raw")
    آزمایش.ادعای برابری رشته(جی آر پی سی.مقدار فراداده(md، 9)، "")

    ناپایا hl := اچ تی تی پی۲.فهرست سرآیندها {}
    جی آر پی سی.فراداده به سرآیند(md، hl)
    آزمایش.ادعای برابری رشته(اچ تی تی پی۲.دریافت سرآیند(hl، "x-user")، "ali")
    آزمایش.ادعای برابری رشته(اچ تی تی پی۲.دریافت سرآیند(hl، "blob-bin")، "cmF3")

    اچ تی تی پی۲.افزودن سرآیند(hl، "grpc-status"، "0")
    back := جی آر پی سی.فراداده از سرآیند(hl)
    آزمایش.ادعای برابری عدد(جی آر پی سی.تعداد فراداده(back)، 2)
    آزمایش.ادعای برابری رشته(جی آر پی سی.دریافت فراداده(back، "x-user")، "ali")
    آزمایش.ادعای برابری رشته(جی آر پی سی.دریافت فراداده(back، "blob-bin")، "raw")
    آزمایش.ادعای نادرستی(جی آر پی سی.فراداده دارد(back، "grpc-status"))
پایان

تابع check registry reset():
    آزمایش.ادعای درستی(جی آر پی سی.متد دارد("/demo.Tagger/Tag"))
    جی آر پی سی.بازنشانی متدها()
    آزمایش.ادعای نادرستی(جی آر پی سی.متد دارد("/demo.Tagger/Tag"))
    آزمایش.ادعای برابری عدد(جی آر پی سی.تعداد متدها()، 0)
    جی آر پی سی.ثبت متد("/demo.Tagger/Tag"، tagger)
    آزمایش.ادعای برابری عدد(جی آر پی سی.تعداد متدها()، 1)
پایان

تابع check stop server():
    ناپایا s := جی آر پی سی.سرور جدید(0)
    آزمایش.ادعای درستی(جی آر پی سی.گوش دادن(s))
    p := جی آر پی سی.درگاه(s)
    آزمایش.ادعای درستی(p بزرگتر 0)
    جی آر پی سی.توقف سرور(s)
    gone := جی آر پی سی.اتصال("127.0.0.1"، p)
    آزمایش.ادعای نادرستی(جی آر پی سی.کانال معتبر(gone))
پایان

تابع check tls dial failure():
    ch := جی آر پی سی.اتصال امن("127.0.0.1"، 1)
    آزمایش.ادعای نادرستی(جی آر پی سی.کانال معتبر(ch))
    آزمایش.ادعای درستی(جی آر پی سی.خطای کانال(ch) نابرابر "")
پایان

تابع check live calls():
    همگام سازی.افزودن(srv wg، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve loopback)
    همگام سازی.انتظار(srv wg)
    آزمایش.ادعای درستی(bound port بزرگتر 0)

    ناپایا ch := جی آر پی سی.اتصال("127.0.0.1"، bound port)
    آزمایش.ادعای درستی(جی آر پی سی.کانال معتبر(ch))
    جی آر پی سی.فعال‌سازی فشرده‌سازی(ch، درست)

    ناپایا md := جی آر پی سی.فراداده جدید()
    جی آر پی سی.افزودن فراداده(md، "x-trace"، "t1")
    ناپایا st := جی آر پی سی.وضعیت {}
    ناپایا req := فشرده سازی.بافر از رشته("hi")
    ناپایا reply := جی آر پی سی.فراخوان یگانه(ch، "/demo.Tagger/Tag"، req، md، st)
    آزمایش.ادعای برابری عدد(st.کد، جی آر پی سی.وضعیت بدون خطا)
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(reply)، "reply")

    sid := جی آر پی سی.شروع فراخوان(ch، "/demo.Tagger/Tag"، md)
    ناپایا body := فشرده سازی.بافر از رشته("hi")
    آزمایش.ادعای درستی(جی آر پی سی.ارسال پیام(ch، sid، body، نادرست))
    آزمایش.ادعای درستی(جی آر پی سی.بستن ارسال(ch، sid))
    ناپایا ok := نادرست
    ناپایا got := جی آر پی سی.دریافت پیام(ch، sid، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(got)، "reply")
    fin := جی آر پی سی.پایان فراخوان(ch، sid)
    آزمایش.ادعای برابری عدد(fin.کد، جی آر پی سی.وضعیت بدون خطا)
    headers := جی آر پی سی.سرآیندهای فراخوان(ch، sid)
    trailers := جی آر پی سی.دنباله‌های فراخوان(ch، sid)
    آزمایش.ادعای نادرستی(جی آر پی سی.فراداده دارد(headers، "grpc-status"))
    آزمایش.ادعای برابری عدد(جی آر پی سی.تعداد فراداده(trailers)، 0)

    فشرده سازی.آزادسازی بافر(req)
    فشرده سازی.آزادسازی بافر(reply)
    فشرده سازی.آزادسازی بافر(body)
    فشرده سازی.آزادسازی بافر(got)
    جی آر پی سی.بستن کانال(ch)
    نخ‌پیوند(t)

    direct server = تی سی پی.پیوند(0)
    t2 := نخ‌ساز(serve direct)
    ناپایا dch := جی آر پی سی.اتصال("127.0.0.1"، تی سی پی.درگاه(direct server))
    آزمایش.ادعای درستی(جی آر پی سی.کانال معتبر(dch))
    ناپایا dst := جی آر پی سی.وضعیت {}
    آزمایش.ادعای برابری رشته(جی آر پی سی.فراخوان یگانه متنی(dch، "/demo.Tagger/Tag"، "hi"، dst)، "reply")
    آزمایش.ادعای برابری عدد(dst.کد، جی آر پی سی.وضعیت بدون خطا)
    جی آر پی سی.بستن کانال(dch)
    نخ‌پیوند(t2)
    تی سی پی.بستن سرور(direct server)
پایان

تابع ریشه:
    جی آر پی سی.ثبت متد("/demo.Tagger/Tag"، tagger)
    check metadata headers()
    check stop server()
    check tls dial failure()
    check live calls()
    check registry reset()
    برگشت آزمایش.خلاصه()
پایان
