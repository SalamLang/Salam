واردسازی رابط گرافیکی.رنگ
واردسازی ریاضی

تابع r4(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 10000.0) / 10000.0 + 0.0
پایان

تابع channels(label: رشته، c: رنگ.رنگ):
    سرچاپ label، "=>"، r4(c.قرمز)، r4(c.سبز)، r4(c.آبی)، r4(c.آلفا)، رنگ.سی اس اس(c)
پایان

تابع parsed(text: رشته): رنگ.رنگ:
    ناپایا c := رنگ.رنگ {}
    اگر وارونه رنگ.تجزیه(text، c):
        سرچاپ "unexpected error:"، رنگ.خطا(text)
    پایان
    برگشت c
پایان

تابع ریشه:
    سرچاپ "reference values"
    هر text در ["lab(29.2345% 39.3825 20.0664)"، "lch(52.2345% 72.2 56.2)"، "oklab(40.101% 0.1147 0.0453)"، "oklch(59.686% 0.15619 49.7694)"، "hwb(194 0% 0%)"، "color(display-p3 1 0 0)"، "color(rec2020 0.5 0.3 0.2)"، "color(prophoto-rgb 0.5 0.3 0.2)"، "color(a98-rgb 0.5 0.3 0.2)"، "color(xyz-d50 0.3 0.2 0.1)"، "color(xyz-d65 0.3 0.2 0.1)"، "color(srgb-linear 0.5 0.3 0.2)"، "color(xyz-d65 0.9505 1 1.089)"، "color(xyz-d50 0.9643 1 0.8251)"، "lab(100 0 0)"، "oklab(1 0 0)"]:
        channels(text، parsed(text))
    پایان
    سرچاپ "constructors"
    channels("Rgb(51, 102, 170)"، رنگ.آر جی بی(51، 102، 170))
    channels("Rgba(51, 102, 170, 0.5)"، رنگ.آر جی بی آلفا(51، 102، 170، 0.5))
    channels("Hex(0x3366aa)"، رنگ.هگز(0x3366aa))
    channels("New(0.2, 0.4, 0.6, 1.0)"، رنگ.تازه(0.2، 0.4، 0.6، 1.0))
    channels("Hsl(210, 0.5, 0.4)"، رنگ.اچ اس ال(210.0، 0.5، 0.4))
    channels("Hwb(194, 0, 0)"، رنگ.اچ دبلیو بی(194.0، 0.0، 0.0))
    channels("Lab(29.2345, 39.3825, 20.0664)"، رنگ.ال ای بی(29.2345، 39.3825، 20.0664))
    channels("Lch(52.2345, 72.2, 56.2)"، رنگ.ال سی اچ(52.2345، 72.2، 56.2))
    channels("Oklab(0.40101, 0.1147, 0.0453)"، رنگ.اوکی ال ای بی(0.40101، 0.1147، 0.0453))
    channels("Oklch(0.59686, 0.15619, 49.7694)"، رنگ.اوکی ال سی اچ(0.59686، 0.15619، 49.7694))
    channels("Cmyk(0, 0.4, 0.6, 0.1)"، رنگ.سی ام وای کی(0.0، 0.4، 0.6، 0.1))
    channels("Current()"، رنگ.رنگ کنونی())
    سرچاپ "argb"
    سرچاپ "Argb red"، رنگ.ای آر جی بی(parsed("red"))
    سرچاپ "Argb #3366aa80"، رنگ.ای آر جی بی(parsed("#3366aa80"))
    سرچاپ "Argb transparent"، رنگ.ای آر جی بی(parsed("transparent"))
    سرچاپ "Argb current"، رنگ.ای آر جی بی(رنگ.رنگ کنونی())
    سرچاپ "Argb clamps display-p3 red"، رنگ.ای آر جی بی(parsed("color(display-p3 1 0 0)"))
    سرچاپ "Argb clamps New(1.5, -0.5, 0.5, 2)"، رنگ.ای آر جی بی(رنگ.تازه(1.5، -0.5، 0.5، 2.0))
    channels("FromArgb(0xff3366aa)"، رنگ.از ای آر جی بی(0xff3366aa برگردان طبیعی۳۲))
    channels("FromArgb(0x803366aa)"، رنگ.از ای آر جی بی(0x803366aa برگردان طبیعی۳۲))
    channels("FromArgb(0)"، رنگ.از ای آر جی بی(0 برگردان طبیعی۳۲))
    سرچاپ "round trips"
    هر text در ["red"، "#3366aa"، "#3366aa80"، "rgb(1 2 3 / 0.1)"، "hsl(300, 76%, 72%)"، "oklch(0.7 0.25 30)"، "oklch(0.5 0.1 180)"، "color(display-p3 1 0 0)"، "color(rec2020 0.9 0.1 0.3 / 0.75)"، "light dark(white, #333)"، "light dark(current, color(display-p3 0 1 0))"، "current"، "transparent"]:
        c := parsed(text)
        css := رنگ.سی اس اس(c)
        back := parsed(css)
        argb_same := رنگ.ای آر جی بی(c) برابر رنگ.ای آر جی بی(رنگ.از ای آر جی بی(رنگ.ای آر جی بی(c)))
        سرچاپ text، "=>"، css، "=>"، رنگ.سی اس اس(back)، رنگ.یکسان(c، back) یا css برابر رنگ.سی اس اس(back)، argb_same
    پایان
    سرچاپ "source"
    هر text در ["red"، "#3366aa80"، "transparent"، "current"، "hsl(210, 50%, 40%)"، "oklch(0.7 0.25 30)"، "light dark(white, black)"، "light dark(rgb(1 2 3 / 0.5), current)"]:
        سرچاپ text، "=>"، رنگ.کد سلام(parsed(text))
    پایان
پایان
