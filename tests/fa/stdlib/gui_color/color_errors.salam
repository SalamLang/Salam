واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    هر text در [""، "   "، "redd"، "blu"، "notacolour"، "#"، "#12"، "#12345"، "#1234567"، "#ggg"، "#12x"، "rgb"، "rgb("، "rgb()"، "rgb(51, 102)"، "rgb(51, 102, 170, 0.5, 1)"، "rgb(51 102 170 0.5)"، "rgb(51, 102 170)"، "rgb(51 102, 170)"، "rgb(51, 102, 170 / 0.5)"، "rgb(51 102 170 / 0.5 / 1)"، "rgb(300, 0, 0)"، "rgb(-1, 0, 0)"، "rgb(120%, 0%, 0%)"، "rgba(0, 0, 0, 2)"، "rgba(0, 0, 0, 150%)"، "rgb(a, b, c)"، "rgb(10px, 0, 0)"، "rgb(51, 102, 170"، "rgb(51, 102, 170))"، "red blue"، "red, blue"، "hsl(50%, 50%, 40%)"، "hsl(210, 150%, 40%)"، "hsl(210foo, 50%, 40%)"، "hsl(210, 50%)"، "hwb(10, 120%, 0%)"، "lab(120 0 0)"، "lch(50 -10 30)"، "oklab(2 0 0)"، "oklch(0.5 -0.1 30)"، "oklch(0.5, 0.1)"، "cmyk(0, 0, 0)"، "cmyk(2, 0, 0, 0)"، "color()"، "color(1, 2, 3)"، "color(cmyk, 1, 2, 3)"، "color(srgb, 1, 2)"، "color(display p3 1, 2, 3)"، "mix(red)"، "mix(red blue)"، "mix(red, blue, 2)"، "mix(red, blue, 30%, cmyk)"، "mix(red, blue, 30%, 2)"، "mix(current, red)"، "mix(red, light dark(current, blue))"، "mix(red, blue, 30%"، "light dark(red)"، "light dark(red, blue, green)"، "foo(1, 2, 3)"، "rgb(1, 2, 3) red"، "rgb(1, 2, 3) @"، "قرمزی"، "mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(mix(red, blue), red), red), red), red), red), red), red), red), red), red), red), red), red), red), red), red)"]:
        ناپایا c := رنگ.رنگ {}
        ok := رنگ.تجزیه(text، c)
        سرچاپ "[" + text + "]"، ok، رنگ.خطا(text)
    پایان
    سرچاپ "valid gives empty error: [" + رنگ.خطا("red") + "]"
پایان
