واردسازی رابط گرافیکی.رنگ
واردسازی ریاضی

تابع r4(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 10000.0) / 10000.0 + 0.0
پایان

تابع parsed(text: رشته): رنگ.رنگ:
    ناپایا c := رنگ.رنگ {}
    اگر وارونه رنگ.تجزیه(text، c):
        سرچاپ "unexpected error:"، رنگ.خطا(text)
    پایان
    برگشت c
پایان

تابع ریشه:
    red := parsed("red")
    blue := parsed("blue")
    white := parsed("white")
    black := parsed("black")
    سرچاپ "mix"
    هر t در [0.0، 0.25، 0.5، 0.75، 1.0، -1.0، 2.0]:
        سرچاپ "Mix red blue"، t، رنگ.سی اس اس(رنگ.آمیختن(red، blue، t))
    پایان
    هر sp در ["oklab"، "oklch"، "lab"، "lch"، "srgb"، "srgb linear"، "srgb-linear"، "hsl"، "hwb"، "xyz"، "xyz d50"، "display p3"، "a98 rgb"، "prophoto rgb"، "rec2020"، "unknown"]:
        سرچاپ "MixIn red blue 0.5"، sp، رنگ.سی اس اس(رنگ.آمیختن با فضا(red، blue، 0.5، sp))
    پایان
    سرچاپ "MixIn hue shorter arc"، رنگ.سی اس اس(رنگ.آمیختن با فضا(parsed("hsl(350, 100%, 50%)")، parsed("hsl(10, 100%, 50%)")، 0.5، "hsl"))
    سرچاپ "MixIn grey keeps the other hue"، رنگ.سی اس اس(رنگ.آمیختن با فضا(parsed("grey")، parsed("oklch(0.6 0.2 140)")، 0.5، "oklch"))
    سرچاپ "lerp"
    هر t در [0.0، 0.1، 0.5، 0.9، 1.0]:
        سرچاپ "Lerp white black"، t، رنگ.سی اس اس(رنگ.درون یابی(white، black، t))
    پایان
    سرچاپ "Lerp overshoots"، r4(رنگ.درون یابی(black، white، 1.1).قرمز)
    سرچاپ "Lerp transparent red 0.5"، رنگ.سی اس اس(رنگ.درون یابی(parsed("transparent")، red، 0.5))
    سرچاپ "Lerp premultiplied"، رنگ.سی اس اس(رنگ.درون یابی(parsed("rgb(255 0 0 / 0.1)")، parsed("rgb(0 0 255 / 0.9)")، 0.5))
    سرچاپ "Lerp current"، رنگ.سی اس اس(رنگ.درون یابی(رنگ.رنگ کنونی()، red، 0.4))، رنگ.سی اس اس(رنگ.درون یابی(رنگ.رنگ کنونی()، red، 0.6))
    ld := parsed("light dark(white, black)")
    سرچاپ "Lerp light dark"، رنگ.سی اس اس(رنگ.درون یابی(ld، red، 0.5))
    سرچاپ "light dark"
    سرچاپ "HasDark"، رنگ.تیره دارد(ld)، رنگ.تیره دارد(red)
    سرچاپ "Light"، رنگ.سی اس اس(رنگ.روشن(ld))، "Dark"، رنگ.سی اس اس(رنگ.تیره(ld))
    سرچاپ "Dark without a dark variant"، رنگ.سی اس اس(رنگ.تیره(red))
    سرچاپ "LightDark"، رنگ.سی اس اس(رنگ.روشن تیره(red، blue))
    سرچاپ "LightDark of light darks"، رنگ.سی اس اس(رنگ.روشن تیره(ld، parsed("light dark(red, green)")))
    سرچاپ "accessibility"
    سرچاپ "Luminance"، r4(رنگ.درخشندگی(white))، r4(رنگ.درخشندگی(black))، r4(رنگ.درخشندگی(red))، r4(رنگ.درخشندگی(parsed("#777")))، r4(رنگ.درخشندگی(parsed("#3366aa")))
    سرچاپ "Contrast"، r4(رنگ.نسبت تضاد(white، black))، r4(رنگ.نسبت تضاد(black، white))، r4(رنگ.نسبت تضاد(parsed("#777")، white))، r4(رنگ.نسبت تضاد(parsed("#3366aa")، white))، r4(رنگ.نسبت تضاد(red، red))
    سرچاپ "Lighten"، رنگ.سی اس اس(رنگ.روشن تر(parsed("#3366aa")، 0.1))، رنگ.سی اس اس(رنگ.روشن تر(black، 2.0))، رنگ.سی اس اس(رنگ.روشن تر(ld، 0.1))
    سرچاپ "Darken"، رنگ.سی اس اس(رنگ.تیره تر(parsed("#3366aa")، 0.1))، رنگ.سی اس اس(رنگ.تیره تر(white، 2.0))، رنگ.سی اس اس(رنگ.تیره تر(رنگ.رنگ کنونی()، 0.1))
    سرچاپ "helpers"
    سرچاپ "WithAlpha"، رنگ.سی اس اس(رنگ.با آلفا(red، 0.5))، رنگ.سی اس اس(رنگ.با آلفا(ld، 0.25))
    سرچاپ "Equal"، رنگ.یکسان(red، parsed("#f00"))، رنگ.یکسان(red، parsed("#f01"))، رنگ.یکسان(ld، parsed("light-dark(#fff, #000)"))، رنگ.یکسان(رنگ.رنگ کنونی()، parsed("current"))
    سرچاپ "InGamut"، رنگ.درون گستره(red)، رنگ.درون گستره(parsed("color(display-p3 1 0 0)"))، رنگ.درون گستره(parsed("light dark(white, color(rec2020 1 0 0))"))، رنگ.درون گستره(رنگ.رنگ کنونی())
پایان
