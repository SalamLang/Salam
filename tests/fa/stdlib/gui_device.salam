واردسازی رابط گرافیکی.دستگاه

ناپایا changes := 0

تابع state_name(s: دستگاه.وضعیت مجوز): رشته:
    اگر s برابر دستگاه.وضعیت مجوز.داده شده:
        برگشت "granted"
    پایان
    اگر s برابر دستگاه.وضعیت مجوز.رد شده:
        برگشت "denied"
    پایان
    برگشت "not asked"
پایان

تابع ریشه:
    سرچاپ "platform"، دستگاه.سکو()
    سرچاپ "can share"، دستگاه.قابل اشتراک()
    سرچاپ "share"، دستگاه.اشتراک‌گذاری("hello"، "https://salamlang.ir")
    سرچاپ "share url only"، دستگاه.اشتراک‌گذاری(""، "https://salamlang.ir")
    سرچاپ "share nothing"، دستگاه.اشتراک‌گذاری(""، "")
    سرچاپ "can vibrate"، دستگاه.قابل لرزش()
    سرچاپ "vibrate"، دستگاه.لرزاندن(50)
    سرچاپ "vibrate zero"، دستگاه.لرزاندن(0)
    سرچاپ "haptic tap"، دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.ضربه)
    سرچاپ "haptic heavy"، دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.سنگین)
    سرچاپ "haptic success"، دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.موفق)
    سرچاپ "haptic failure"، دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.ناموفق)
    سرچاپ "camera"، state_name(دستگاه.بررسی مجوز(دستگاه.مجوز.دوربین))
    سرچاپ "location"، state_name(دستگاه.بررسی مجوز(دستگاه.مجوز.مکان))
    سرچاپ "request"، دستگاه.درخواست مجوز(دستگاه.مجوز.اعلان ها)
    دستگاه.آگاه کردن()
    دستگاه.هنگام تغییر((): changes++ پایان)
    دستگاه.آگاه کردن()
    دستگاه.آگاه کردن()
    سرچاپ "changes"، changes
    سرچاپ "show"، دستگاه.نمایش اعلان(1، "Title"، "Body")
    سرچاپ "show empty"، دستگاه.نمایش اعلان(1، ""، "")
    سرچاپ "schedule"، دستگاه.زمان بندی اعلان(2، "Title"، "Body"، 10)
    سرچاپ "schedule now"، دستگاه.زمان بندی اعلان(2، "Title"، "Body"، 0)
    سرچاپ "cancel"، دستگاه.لغو اعلان(2)
    سرچاپ "locate"، دستگاه.درخواست مکان()
    سرچاپ "idle"، دستگاه.وضعیت یابی() برابر دستگاه.وضعیت مکان.بیکار
    here := دستگاه.آخرین مکان()
    سرچاپ "here"، here.عرض جغرافیایی، here.طول جغرافیایی، here.دقت
    سرچاپ "pick"، دستگاه.برگزیدن عکس()
    سرچاپ "take"، دستگاه.گرفتن عکس()
    سرچاپ "photo idle"، دستگاه.وضعیت عکس گیری() برابر دستگاه.وضعیت عکس.بیکار
    سرچاپ "photo path"، دستگاه.آخرین عکس().طول()
    سرچاپ "data dir"، دستگاه.پوشه داده().طول()
    سرچاپ "cache dir"، دستگاه.پوشه حافظه نهان().طول()
    سرچاپ "documents dir"، دستگاه.پوشه اسناد().طول()
    سرچاپ "temp dir"، دستگاه.پوشه موقت().طول()
    سرچاپ "secure set"، دستگاه.ذخیره امن("token"، "abc")
    سرچاپ "secure empty key"، دستگاه.ذخیره امن(""، "abc")
    سرچاپ "secure get"، دستگاه.خواندن امن("token").طول()
    سرچاپ "secure delete"، دستگاه.حذف امن("token")
پایان
