واردسازی رابط گرافیکی.دستگاه

ناپایا changes := 0

تابع state_name(s: دستگاه.وضعیت مجوز): رشته:
    اگر s برابر دستگاه.وضعیت مجوز.داده شده:
        برگشت "granted"
    پایان
    اگر s برابر دستگاه.وضعیت مجوز.رد شده:
        برگشت "denied"
    پایان
    برگشت "not asked"
پایان

تابع ریشه:
    سرچاپ "platform"، دستگاه.سکو()
    سرچاپ "can share"، دستگاه.قابل اشتراک()
    سرچاپ "share"، دستگاه.اشتراک‌گذاری("hello"، "https://salamlang.ir")
    سرچاپ "share url only"، دستگاه.اشتراک‌گذاری(""، "https://salamlang.ir")
    سرچاپ "share nothing"، دستگاه.اشتراک‌گذاری(""، "")
    سرچاپ "can vibrate"، دستگاه.قابل لرزش()
    سرچاپ "vibrate"، دستگاه.لرزاندن(50)
    سرچاپ "vibrate zero"، دستگاه.لرزاندن(0)
    سرچاپ "haptic tap"، دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.ضربه)
    سرچاپ "haptic heavy"، دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.سنگین)
    سرچاپ "haptic success"، دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.موفق)
    سرچاپ "haptic failure"، دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.ناموفق)
    سرچاپ "camera"، state_name(دستگاه.بررسی مجوز(دستگاه.مجوز.دوربین))
    سرچاپ "location"، state_name(دستگاه.بررسی مجوز(دستگاه.مجوز.مکان))
    سرچاپ "request"، دستگاه.درخواست مجوز(دستگاه.مجوز.اعلان ها)
    دستگاه.آگاه کردن()
    دستگاه.هنگام تغییر((): changes++ پایان)
    دستگاه.آگاه کردن()
    دستگاه.آگاه کردن()
    سرچاپ "changes"، changes
پایان
