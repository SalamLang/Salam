واردسازی رابط گرافیکی.چیدمان

تابع show_len(name: رشته، l: چیدمان.درازا):
    سرچاپ name، l.پیکسل، l.درصد، l.نوع
پایان

تابع ریشه:
    show_len("Px"، چیدمان.پیکسلی(12.0))
    show_len("Pct"، چیدمان.درصدی(0.5))
    show_len("PxPct"، چیدمان.پیکسل باضافه درصد(-8.0، 1.0))
    show_len("Auto"، چیدمان.خودکار())
    show_len("Fill"، چیدمان.پرکننده())
    show_len("Fit"، چیدمان.به اندازه محتوا())
    show_len("MinContent"، چیدمان.کمینه محتوا())
    show_len("MaxContent"، چیدمان.بیشینه محتوا())
    show_len("NoLimit"، چیدمان.بی‌حد())
    سرچاپ "kinds"، چیدمان.درازای‌ثابت، چیدمان.درازای‌خودکار، چیدمان.درازای‌پرکننده، چیدمان.درازای‌اندازه‌محتوا، چیدمان.درازای‌کمینه‌محتوا، چیدمان.درازای‌بیشینه‌محتوا، چیدمان.درازای‌تهی
    e := چیدمان.همه لبه‌ها(چیدمان.پیکسلی(4.0))
    سرچاپ "All"، e.بالا.پیکسل، e.انتها.پیکسل، e.پایین.پیکسل، e.آغاز.پیکسل، e.چپ.نوع، e.راست.نوع
    s := چیدمان.چهار لبه(چیدمان.پیکسلی(1.0)، چیدمان.پیکسلی(2.0)، چیدمان.پیکسلی(3.0)، چیدمان.پیکسلی(4.0))
    سرچاپ "Sides"، s.بالا.پیکسل، s.انتها.پیکسل، s.پایین.پیکسل، s.آغاز.پیکسل
    tl := چیدمان.شیار با درازا(چیدمان.پیکسلی(30.0))
    سرچاپ "TrackLen"، tl.کمینه.پیکسل، tl.بیشینه.پیکسل، tl.سهم
    tf := چیدمان.شیار سهمی(2.0)
    سرچاپ "TrackFr"، tf.کمینه.نوع، tf.سهم
    ta := چیدمان.شیار خودکار()
    سرچاپ "TrackAuto"، ta.کمینه.نوع، ta.بیشینه.نوع
    tm := چیدمان.شیار کمینه بیشینه(چیدمان.شیار با درازا(چیدمان.پیکسلی(10.0))، چیدمان.شیار سهمی(1.0))
    سرچاپ "TrackMinMax"، tm.کمینه.پیکسل، tm.سهم
    tfit := چیدمان.شیار اندازه محتوا(چیدمان.پیکسلی(80.0))
    سرچاپ "TrackFit"، tfit.بیشینه.پیکسل، tfit.اندازه محتوا
    ناپایا inner := وکتور {} برگردان وکتور<چیدمان.شیار>
    inner.افزودن(tl)
    inner.افزودن(tf)
    rp := چیدمان.شیارهای تکراری(چیدمان.تکرار‌پرکننده، inner)
    سرچاپ "Repeat"، rp.شمار تکرار، rp.شیارها.طول()، چیدمان.تکرار‌اندازه‌محتوا
    st := چیدمان.سبک چیدمان {}
    سرچاپ "defaults"، st.چینش، st.تراز، st.پخش، st.تراز محتوا، st.رشد، st.کاهش، st.پایه.نوع، st.پهنا.نوع، st.بیشینه پهنا.نوع، st.کمینه پهنا.نوع، st.پیدا، st.جهت، st.گستره ستون

    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(5.0)) })
    a := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(20.0) })
    b := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(30.0) })
    c := t.افزودن(b، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، فاصله بیرونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(3.0)) })
    سرچاپ "valid"، t.معتبر(root)، t.معتبر(c)، t.معتبر(99)، t.معتبر(-1)
    سرچاپ "count"، t.شمار گره‌ها()، "parent"، t.والد(c)، t.والد(root)، "children"، t.شمار فرزندان(root)، t.فرزند(root، 1)، t.فرزند(root، 5)
    سرچاپ "style"، t.سبک(a).پهنا.پیکسل، t.سبک(99).پهنا.نوع
    t.چیدن(200.0، 100.0)
    سرچاپ "c"، t.ایکس(c)، t.ایگرگ(c)، t.پهنا(c)، t.بلندی(c)، "abs"، t.ایکس مطلق(c)، t.ایگرگ مطلق(c)، "baseline"، t.خط پایه(c)
    سرچاپ "layer"، t.لایه(c)، "dirty"، t.تغییر کرده(c)
    t.علامت تغییر(c)
    سرچاپ "marked"، t.تغییر کرده(c)، t.تغییر کرده(b)، t.تغییر کرده(a)
    t.تنظیم سنجش(a، (_id: صحیح، _w: اعشار۶۴، _h: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 7.0، بلندی = 9.0 } پایان)
    t.چیدن(200.0، 100.0)
    سرچاپ "measured"، t.پهنا(a)، t.شمار سنجش‌ها() بزرگتر 0
    t.حذف سنجش(a)
    t.چیدن(200.0، 100.0)
    سرچاپ "cleared"، t.پهنا(a)
    t.جابجایی(c، root، 0)
    t.جابجایی(root، c، 0)
    t.چیدن(200.0، 100.0)
    سرچاپ "moved"، t.فرزند(root، 0)، t.والد(c)، "cycle refused"، t.والد(root)
    t.حذف(b)
    سرچاپ "removed"، t.معتبر(b)، t.شمار فرزندان(root)، t.شمار گره‌ها()
    t.تنظیم پیمایش(root، 5.0، 5.0)
    سرچاپ "scroll"، t.پیمایش افقی(root)، t.پیمایش عمودی(root)، t.پهنای محتوا(root)، t.بلندی محتوا(root)
    order := t.ترتیب نقاشی(root)
    سرچاپ "paint order"، order.طول()
    calls := t.شمار چیدن‌ها()
    t.صفر کردن شمارنده‌ها()
    سرچاپ "counters"، calls بزرگتر 0، t.شمار چیدن‌ها()، t.شمار سنجش‌ها()
    سرچاپ "invalid ids"، t.ایکس(-3)، t.پهنا(500)، t.شمار فرزندان(77)، t.والد(77)
    order.آزادکن()
    ناپایا cols := وکتور {} برگردان وکتور<چیدمان.شیار>
    cols.افزودن(چیدمان.شیار سهمی(1.0))
    cols.افزودن(چیدمان.شیار سهمی(1.0))
    g := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = cols })
    cols.آزادسازی()
    cell := t.افزودن(g، چیدمان.سبک چیدمان {})
    t.افزودن(g، چیدمان.سبک چیدمان {})
    t.چیدن(200.0، 100.0)
    سرچاپ "grid keeps its own tracks"، t.پهنا(cell)، t.سبک(g).ستون‌ها.طول()
    t.آزادسازی()
    سرچاپ "freed"، t.شمار گره‌ها()
پایان
