واردسازی رابط گرافیکی.چیدمان
واردسازی ریاضی

تابع r(v: اعشار۶۴): اعشار۶۴:
    x := ریاضی.گردکردن(v * 100.0) / 100.0
    اگر x برابر 0.0:
        برگشت 0.0
    پایان
    برگشت x
پایان

تابع dump(t &: چیدمان.درخت چیدمان، id: صحیح، depth: صحیح):
    ناپایا pad := ""
    تکرار depth:
        pad += "  "
    پایان
    سرچاپ pad + "#" + id، r(t.ایکس(id))، r(t.ایگرگ(id))، r(t.پهنا(id))، r(t.بلندی(id))
    تکرار t.شمار فرزندان(id) در i:
        dump(t، t.فرزند(id، i)، depth + 1)
    پایان
پایان

تابع box(w: اعشار۶۴، h: اعشار۶۴): چیدمان.سبک چیدمان:
    برگشت چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(w)، بلندی = چیدمان.پیکسلی(h) }
پایان

تابع run(title: رشته، t &: چیدمان.درخت چیدمان، w: اعشار۶۴، h: اعشار۶۴):
    t.چیدن(w، h)
    سرچاپ "=="، title
    dump(t، 0، 0)
پایان

تابع column_basics():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0))، پهنای مرز = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(2.0))، فاصله سطرها = چیدمان.پیکسلی(4.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(30.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(20.0)، پهنا = چیدمان.پیکسلی(50.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، فاصله بیرونی = چیدمان.چهار لبه(چیدمان.پیکسلی(5.0)، چیدمان.پیکسلی(7.0)، چیدمان.پیکسلی(3.0)، چیدمان.پیکسلی(6.0)) })
    t.افزودن(root، چیدمان.سبک چیدمان { رشد = 1.0 })
    run("column: stretch, padding, border, gap, margins, grow"، t، 200.0، 200.0)
پایان

تابع row_grow_shrink():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(40.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(100.0)، رشد = 1.0 })
    t.افزودن(root، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(100.0)، رشد = 3.0 })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(50.0) })
    run("row: grow by factor"، t، 350.0، 100.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(40.0) })
    s.افزودن(sr، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(200.0) })
    s.افزودن(sr، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(100.0)، کاهش = 2.0 })
    s.افزودن(sr، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(100.0)، کاهش = 0.0 })
    run("row: shrink weighted by basis"، s، 300.0، 100.0)
پایان

تابع resolve_loop():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(20.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(0.0)، رشد = 1.0، بیشینه پهنا = چیدمان.پیکسلی(50.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(0.0)، رشد = 1.0 })
    t.افزودن(root، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(0.0)، رشد = 1.0، کمینه پهنا = چیدمان.پیکسلی(150.0) })
    run("row: max and min violations freeze and redistribute"، t، 300.0، 100.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(20.0) })
    s.افزودن(sr، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(100.0)، رشد = 0.25 })
    s.افزودن(sr، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(100.0)، رشد = 0.25 })
    run("row: grow factors below one leave space"، s، 400.0، 100.0)
    ناپایا u := چیدمان.درخت تازه()
    ur := u.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(20.0) })
    u.افزودن(ur، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(200.0)، کمینه پهنا = چیدمان.پیکسلی(180.0) })
    u.افزودن(ur، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(200.0) })
    run("row: shrink with a min width"، u، 300.0، 100.0)
پایان

تابع align_items():
    names := ["start"، "center"، "end"، "stretch"]
    هر i، a در [چیدمان.تراز‌آغاز، چیدمان.تراز‌وسط، چیدمان.تراز‌انتها، چیدمان.تراز‌کشیده]:
        ناپایا t := چیدمان.درخت تازه()
        root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، تراز = a، بلندی = چیدمان.پیکسلی(100.0) })
        t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(30.0)، بلندی = چیدمان.پیکسلی(20.0) })
        t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(30.0) })
        t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(30.0)، بلندی = چیدمان.پیکسلی(40.0)، تراز اختصاصی = چیدمان.تراز‌انتها })
        run("row align " + names[i]، t، 200.0، 200.0)
    پایان
    ناپایا c := چیدمان.درخت تازه()
    cr := c.افزودن(-1، چیدمان.سبک چیدمان { تراز = چیدمان.تراز‌وسط })
    c.افزودن(cr، box(50.0، 10.0))
    c.افزودن(cr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، بیشینه پهنا = چیدمان.پیکسلی(80.0)، تراز اختصاصی = چیدمان.تراز‌کشیده })
    c.افزودن(cr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، تراز اختصاصی = چیدمان.تراز‌آغاز })
    run("column align center, self stretch with max, self start"، c، 200.0، 200.0)
پایان

تابع justify():
    names := ["start"، "center"، "end"، "between"، "around"، "evenly"]
    هر i، j در [چیدمان.تراز‌آغاز، چیدمان.تراز‌وسط، چیدمان.تراز‌انتها، چیدمان.تراز‌فاصله‌میانی، چیدمان.تراز‌فاصله‌پیرامون، چیدمان.تراز‌فاصله‌یکسان]:
        ناپایا t := چیدمان.درخت تازه()
        root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، پخش = j، بلندی = چیدمان.پیکسلی(10.0)، فاصله ستون‌ها = چیدمان.پیکسلی(10.0) })
        t.افزودن(root، box(40.0، 10.0))
        t.افزودن(root، box(40.0، 10.0))
        t.افزودن(root، box(40.0، 10.0))
        run("row justify " + names[i]، t، 300.0، 100.0)
    پایان
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، پخش = چیدمان.تراز‌فاصله‌پیرامون، بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(150.0)، بلندی = چیدمان.پیکسلی(10.0)، کاهش = 0.0 })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(10.0)، کاهش = 0.0 })
    run("row justify around with negative free space centres"، t، 200.0، 100.0)
پایان

تابع baseline():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، تراز = چیدمان.تراز‌خط‌پایه })
    a := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(40.0) })
    t.تنظیم سنجش(a، (_id: صحیح، _w: اعشار۶۴، _h: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 40.0، بلندی = 20.0، خط پایه = 16.0 } پایان)
    b := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(40.0)، فاصله درونی = چیدمان.چهار لبه(چیدمان.پیکسلی(10.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)) })
    t.تنظیم سنجش(b، (_id: صحیح، _w: اعشار۶۴، _h: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 40.0، بلندی = 30.0، خط پایه = 24.0 } پایان)
    t.افزودن(root، box(40.0، 15.0))
    run("row baseline alignment"، t، 300.0، 100.0)
    سرچاپ "baseline"، t.خط پایه(root)، t.خط پایه(a)، t.خط پایه(b)
پایان

تابع auto_margins():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(60.0) })
    t.افزودن(root، box(40.0، 20.0))
    ناپایا st := box(40.0، 20.0)
    st.فاصله بیرونی.آغاز = چیدمان.خودکار()
    t.افزودن(root، st)
    ناپایا mid := box(40.0، 20.0)
    mid.فاصله بیرونی = چیدمان.همه لبه‌ها(چیدمان.خودکار())
    t.افزودن(root، mid)
    run("row auto margins push and centre"، t، 300.0، 100.0)
پایان

تابع order_reverse():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(10.0)، ترتیب = 2 })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(20.0)، ترتیب = -1 })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(30.0) })
    run("row order"، t، 100.0، 100.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، برعکس = درست، بلندی = چیدمان.پیکسلی(10.0)، فاصله ستون‌ها = چیدمان.پیکسلی(5.0) })
    s.افزودن(sr، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(10.0) })
    s.افزودن(sr، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(20.0) })
    run("row reverse packs at the end"، s، 100.0، 100.0)
    ناپایا c := چیدمان.درخت تازه()
    cr := c.افزودن(-1، چیدمان.سبک چیدمان { برعکس = درست، پخش = چیدمان.تراز‌انتها })
    c.افزودن(cr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0) })
    c.افزودن(cr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(20.0) })
    run("column reverse with justify end"، c، 50.0، 100.0)
پایان

تابع aspect():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { تراز = چیدمان.تراز‌آغاز })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(160.0)، نسبت ابعاد = 16.0 / 9.0 })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(50.0)، نسبت ابعاد = 2.0 })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(100.0)، نسبت ابعاد = 1.0، بیشینه بلندی = چیدمان.پیکسلی(40.0) })
    run("aspect ratio"، t، 300.0، 300.0)
پایان

تابع auto_min():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان {})
    تکرار 3 در i:
        ناپایا st := چیدمان.سبک چیدمان {}
        اگر i بزرگتر 0:
            st.کمینه بلندی = چیدمان.خودکار()
        پایان
        id := t.افزودن(root، st)
        t.تنظیم سنجش(id، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴):
            ناپایا lines := 1.0
            اگر w بزرگتربرابر 0.0 و w کوچکتر 100.0:
                lines = 3.0
            پایان
            برگشت چیدمان.ابعاد { پهنا = 100.0، بلندی = lines * 20.0، خط پایه = 15.0 }
        پایان)
    پایان
    run("column too short: default min 0 shrinks, min auto keeps the content height"، t، 200.0، 50.0)
    ناپایا rt := چیدمان.درخت تازه()
    rr := rt.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری })
    تکرار 2 در i:
        ناپایا st := چیدمان.سبک چیدمان {}
        اگر i برابر 1:
            st.کمینه پهنا = چیدمان.خودکار()
        پایان
        id := rt.افزودن(rr، st)
        rt.تنظیم سنجش(id، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴):
            اگر w کوچکتر 0.0 یا w بزرگتربرابر 120.0:
                برگشت چیدمان.ابعاد { پهنا = 120.0، بلندی = 10.0 }
            پایان
            اگر w کوچکتر 70.0:
                برگشت چیدمان.ابعاد { پهنا = 70.0، بلندی = 30.0 }
            پایان
            برگشت چیدمان.ابعاد { پهنا = w، بلندی = 20.0 }
        پایان)
    پایان
    run("row too narrow: min auto stops at the min content width"، rt، 100.0، 50.0)
پایان

تابع ریشه:
    column_basics()
    row_grow_shrink()
    resolve_loop()
    align_items()
    justify()
    baseline()
    auto_margins()
    order_reverse()
    aspect()
    auto_min()
پایان
