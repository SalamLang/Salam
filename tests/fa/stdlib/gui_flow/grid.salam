واردسازی رابط گرافیکی.چیدمان
واردسازی ریاضی

تابع r(v: اعشار۶۴): اعشار۶۴:
    x := ریاضی.گردکردن(v * 100.0) / 100.0
    اگر x برابر 0.0:
        برگشت 0.0
    پایان
    برگشت x
پایان

تابع dump(t &: چیدمان.درخت چیدمان، id: صحیح، depth: صحیح):
    ناپایا pad := ""
    تکرار depth:
        pad += "  "
    پایان
    سرچاپ pad + "#" + id، r(t.ایکس(id))، r(t.ایگرگ(id))، r(t.پهنا(id))، r(t.بلندی(id))
    تکرار t.شمار فرزندان(id) در i:
        dump(t، t.فرزند(id، i)، depth + 1)
    پایان
پایان

تابع box(w: اعشار۶۴، h: اعشار۶۴): چیدمان.سبک چیدمان:
    برگشت چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(w)، بلندی = چیدمان.پیکسلی(h) }
پایان

تابع run(title: رشته، t &: چیدمان.درخت چیدمان، w: اعشار۶۴، h: اعشار۶۴):
    t.چیدن(w، h)
    سرچاپ "=="، title
    dump(t، 0، 0)
پایان

تابع tracks(a: چیدمان.شیار، b: چیدمان.شیار، c: چیدمان.شیار): وکتور<چیدمان.شیار>:
    ناپایا v := وکتور {} برگردان وکتور<چیدمان.شیار>
    v.افزودن(a)
    v.افزودن(b)
    v.افزودن(c)
    برگشت v
پایان

تابع one(a: چیدمان.شیار): وکتور<چیدمان.شیار>:
    ناپایا v := وکتور {} برگردان وکتور<چیدمان.شیار>
    v.افزودن(a)
    برگشت v
پایان

تابع text(t &: چیدمان.درخت چیدمان، parent: صحیح، minw: اعشار۶۴، maxw: اعشار۶۴، h: اعشار۶۴): صحیح:
    id := t.افزودن(parent، چیدمان.سبک چیدمان {})
    t.تنظیم سنجش(id، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = w کوچکتر 0.0 ? maxw : (w کوچکتر minw ? minw : (w بزرگتر maxw ? maxw : w))، بلندی = h } پایان)
    برگشت id
پایان

تابع fixed_fr_percent():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = tracks(چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار با درازا(چیدمان.درصدی(0.25))، چیدمان.شیار سهمی(1.0))، سطرها = one(چیدمان.شیار با درازا(چیدمان.پیکسلی(30.0)))، فاصله ستون‌ها = چیدمان.پیکسلی(10.0)، فاصله سطرها = چیدمان.پیکسلی(4.0) })
    تکرار 5:
        t.افزودن(root، چیدمان.سبک چیدمان {})
    پایان
    run("px, percent, fr and auto rows"، t، 420.0، 300.0)
پایان

تابع intrinsic_tracks():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = tracks(چیدمان.شیار با درازا(چیدمان.کمینه محتوا())، چیدمان.شیار با درازا(چیدمان.بیشینه محتوا())، چیدمان.شیار خودکار())، تراز = چیدمان.تراز‌آغاز })
    text(t، root، 30.0، 120.0، 10.0)
    text(t، root، 40.0، 90.0، 10.0)
    text(t، root، 20.0، 50.0، 10.0)
    run("min content, max content and auto columns"، t، 400.0، 300.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = tracks(چیدمان.شیار اندازه محتوا(چیدمان.پیکسلی(60.0))، چیدمان.شیار کمینه بیشینه(چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار سهمی(1.0))، چیدمان.شیار کمینه بیشینه(چیدمان.شیار با درازا(چیدمان.پیکسلی(30.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(80.0)))) })
    text(s، sr، 30.0، 120.0، 10.0)
    text(s، sr، 10.0، 10.0، 10.0)
    text(s، sr، 10.0، 10.0، 10.0)
    run("fit(60), minmax(50, 1fr), minmax(30, 80)"، s، 200.0، 300.0)
    run("same grid squeezed"، s، 120.0، 300.0)
پایان

تابع repeats():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = one(چیدمان.شیارهای تکراری(3، one(چیدمان.شیار سهمی(1.0))))، سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(20.0)) })
    تکرار 4:
        t.افزودن(root، چیدمان.سبک چیدمان {})
    پایان
    run("repeat(3, 1fr), auto rows 20"، t، 300.0، 300.0)
    ناپایا f := چیدمان.درخت تازه()
    fr := f.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = one(چیدمان.شیارهای تکراری(چیدمان.تکرار‌پرکننده، one(چیدمان.شیار با درازا(چیدمان.پیکسلی(70.0)))))، فاصله ستون‌ها = چیدمان.پیکسلی(10.0)، سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(10.0)) })
    تکرار 2:
        f.افزودن(fr، چیدمان.سبک چیدمان {})
    پایان
    run("repeat(fill, 70) with gap 10 in 250"، f، 250.0، 300.0)
    ناپایا g := چیدمان.درخت تازه()
    gr := g.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = one(چیدمان.شیارهای تکراری(چیدمان.تکرار‌اندازه‌محتوا، one(چیدمان.شیار کمینه بیشینه(چیدمان.شیار با درازا(چیدمان.پیکسلی(70.0))، چیدمان.شیار سهمی(1.0)))))، فاصله ستون‌ها = چیدمان.پیکسلی(10.0)، سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(10.0)) })
    تکرار 2:
        g.افزودن(gr، چیدمان.سبک چیدمان {})
    پایان
    run("repeat(fit, minmax(70, 1fr)) collapses empty tracks"، g، 250.0، 300.0)
پایان

تابع placement():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = tracks(چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0)))، سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(10.0)) })
    t.افزودن(root، چیدمان.سبک چیدمان { ستون = 2، سطر = 2 })
    t.افزودن(root، چیدمان.سبک چیدمان { ستون = -1، گستره سطر = 2 })
    t.افزودن(root، چیدمان.سبک چیدمان { گستره ستون = 2 })
    t.افزودن(root، چیدمان.سبک چیدمان { گستره ستون = 2 })
    t.افزودن(root، چیدمان.سبک چیدمان {})
    t.افزودن(root، چیدمان.سبک چیدمان { سطر = 1 })
    t.افزودن(root، چیدمان.سبک چیدمان { ستون = 4 })
    run("explicit lines, negative lines, spans, implicit column"، t، 300.0، 300.0)
    ناپایا d := چیدمان.درخت تازه()
    dr := d.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، جریان خودکار = چیدمان.جریان‌سطری‌فشرده، ستون‌ها = tracks(چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0)))، سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(10.0)) })
    d.افزودن(dr، چیدمان.سبک چیدمان {})
    d.افزودن(dr، چیدمان.سبک چیدمان { گستره ستون = 3 })
    d.افزودن(dr، چیدمان.سبک چیدمان {})
    d.افزودن(dr، چیدمان.سبک چیدمان {})
    run("dense fills the hole"، d، 300.0، 300.0)
    ناپایا c := چیدمان.درخت تازه()
    cr := c.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، جریان خودکار = چیدمان.جریان‌ستونی، سطرها = tracks(چیدمان.شیار با درازا(چیدمان.پیکسلی(10.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(10.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(10.0)))، ستون‌های خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(40.0)) })
    تکرار 5:
        c.افزودن(cr، چیدمان.سبک چیدمان {})
    پایان
    run("auto flow column"، c، 300.0، 300.0)
پایان

تابع alignment():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = tracks(چیدمان.شیار با درازا(چیدمان.پیکسلی(60.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(60.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(60.0)))، سطرها = one(چیدمان.شیار با درازا(چیدمان.پیکسلی(40.0)))، تراز = چیدمان.تراز‌وسط })
    t.افزودن(root، box(20.0، 10.0))
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، پخش اختصاصی = چیدمان.تراز‌انتها، پهنا = چیدمان.پیکسلی(20.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { تراز اختصاصی = چیدمان.تراز‌کشیده، پخش اختصاصی = چیدمان.تراز‌وسط، پهنا = چیدمان.پیکسلی(20.0) })
    run("align center, justify self end and center"، t، 300.0، 300.0)
    names := ["center"، "end"، "between"، "around"، "evenly"]
    هر i، m در [چیدمان.تراز‌وسط، چیدمان.تراز‌انتها، چیدمان.تراز‌فاصله‌میانی، چیدمان.تراز‌فاصله‌پیرامون، چیدمان.تراز‌فاصله‌یکسان]:
        ناپایا g := چیدمان.درخت تازه()
        gr := g.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = tracks(چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0)))، سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(20.0))، پخش = m، تراز محتوا = m، بلندی = چیدمان.پیکسلی(100.0) })
        تکرار 4:
            g.افزودن(gr، چیدمان.سبک چیدمان {})
        پایان
        run("grid content " + names[i]، g، 250.0، 300.0)
    پایان
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = one(چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0)))، سطرها = tracks(چیدمان.شیار خودکار()، چیدمان.شیار با درازا(چیدمان.پیکسلی(20.0))، چیدمان.شیار خودکار())، تراز محتوا = چیدمان.تراز‌کشیده، بلندی = چیدمان.پیکسلی(100.0) })
    تکرار 3:
        s.افزودن(sr، چیدمان.سبک چیدمان {})
    پایان
    run("align content stretch grows auto rows"، s، 250.0، 300.0)
پایان

تابع baseline_rows():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = tracks(چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0))، چیدمان.شیار با درازا(چیدمان.پیکسلی(50.0)))، تراز = چیدمان.تراز‌خط‌پایه })
    a := t.افزودن(root، چیدمان.سبک چیدمان {})
    t.تنظیم سنجش(a، (_id: صحیح، _w: اعشار۶۴، _h: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 10.0، بلندی = 20.0، خط پایه = 15.0 } پایان)
    b := t.افزودن(root، چیدمان.سبک چیدمان {})
    t.تنظیم سنجش(b، (_id: صحیح، _w: اعشار۶۴، _h: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 10.0، بلندی = 30.0، خط پایه = 25.0 } پایان)
    t.افزودن(root، box(10.0، 8.0))
    run("baseline aligned row"، t، 300.0، 300.0)
پایان

تابع ریشه:
    fixed_fr_percent()
    intrinsic_tracks()
    repeats()
    placement()
    alignment()
    baseline_rows()
پایان
