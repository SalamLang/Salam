واردسازی رابط گرافیکی.چیدمان
واردسازی ریاضی

تابع r(v: اعشار۶۴): اعشار۶۴:
    x := ریاضی.گردکردن(v * 100.0) / 100.0
    اگر x برابر 0.0:
        برگشت 0.0
    پایان
    برگشت x
پایان

تابع dump(t &: چیدمان.درخت چیدمان، id: صحیح، depth: صحیح):
    ناپایا pad := ""
    تکرار depth:
        pad += "  "
    پایان
    سرچاپ pad + "#" + id، r(t.ایکس(id))، r(t.ایگرگ(id))، r(t.پهنا(id))، r(t.بلندی(id))
    تکرار t.شمار فرزندان(id) در i:
        dump(t، t.فرزند(id، i)، depth + 1)
    پایان
پایان


تابع label(t &: چیدمان.درخت چیدمان، parent: صحیح، chars: صحیح): صحیح:
    id := t.افزودن(parent، چیدمان.سبک چیدمان {})
    t.تنظیم سنجش(id، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴):
        full := (chars برگردان اعشار۶۴) * 8.0
        اگر w کوچکتر 0.0 یا w بزرگتربرابر full:
            برگشت چیدمان.ابعاد { پهنا = full، بلندی = 16.0، خط پایه = 12.0 }
        پایان
        lines := ((full / _max_one(w)) برگردان صحیح) + 1
        برگشت چیدمان.ابعاد { پهنا = w، بلندی = (lines برگردان اعشار۶۴) * 16.0، خط پایه = 12.0 }
    پایان)
    برگشت id
پایان

تابع _max_one(v: اعشار۶۴): اعشار۶۴:
    اگر v کوچکتر 8.0:
        برگشت 8.0
    پایان
    برگشت v
پایان

تابع counts(t &: چیدمان.درخت چیدمان، what: رشته):
    سرچاپ what، "layout calls"، t.شمار چیدن‌ها()، "measure calls"، t.شمار سنجش‌ها()
    t.صفر کردن شمارنده‌ها()
پایان

تابع ریشه:
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { فاصله سطرها = چیدمان.پیکسلی(2.0) })
    ناپایا rows := وکتور {} برگردان وکتور<صحیح>
    ناپایا first := وکتور {} برگردان وکتور<صحیح>
    تکرار 100 در i:
        rw := t.افزودن(root، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، فاصله ستون‌ها = چیدمان.پیکسلی(4.0)، کاهش = 0.0 })
        rows.افزودن(rw)
        first.افزودن(label(t، rw، 5 + i % 7))
        label(t، rw، 3)
        t.افزودن(rw، چیدمان.سبک چیدمان { رشد = 1.0 })
    پایان
    t.چیدن(400.0، 300.0)
    counts(t، "first layout:")
    سرچاپ "content height"، t.بلندی محتوا(root)
    t.چیدن(400.0، 300.0)
    counts(t، "same size again:")
    سرچاپ "dirty after layout"، t.تغییر کرده(root)، t.تغییر کرده(first.دریافت(50))
    leaf := first.دریافت(50)
    ناپایا st := t.سبک(leaf)
    st.پهنا = چیدمان.پیکسلی(100.0)
    t.تنظیم سبک(leaf، st)
    سرچاپ "dirty path"، t.تغییر کرده(leaf)، t.تغییر کرده(rows.دریافت(50))، t.تغییر کرده(root)، "sibling row clean"، وارونه t.تغییر کرده(rows.دریافت(49))
    t.چیدن(400.0، 300.0)
    counts(t، "one leaf width changed:")
    dump(t، rows.دریافت(50)، 0)
    t.علامت تغییر(first.دریافت(10))
    t.چیدن(400.0، 300.0)
    counts(t، "one text marked dirty:")
    t.چیدن(300.0، 300.0)
    counts(t، "viewport resized:")
    t.حذف(rows.دریافت(0))
    t.چیدن(300.0، 300.0)
    counts(t، "first row removed:")
    سرچاپ "children"، t.شمار فرزندان(root)، "count"، t.شمار گره‌ها()، "first row now at"، t.ایگرگ(rows.دریافت(1))
    t.جابجایی(rows.دریافت(99)، root، 0)
    t.چیدن(300.0، 300.0)
    counts(t، "last row moved to the top:")
    سرچاپ "moved row at"، t.ایگرگ(rows.دریافت(99))، "next at"، t.ایگرگ(rows.دریافت(1))
    n := t.افزودن(rows.دریافت(5)، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(10.0) })
    سرچاپ "removed id reused"، n برابر rows.دریافت(0)
    t.چیدن(300.0، 300.0)
    counts(t، "child added:")
    t.حذف سنجش(first.دریافت(20))
    t.چیدن(300.0، 300.0)
    counts(t، "measure cleared:")
    سرچاپ "cleared leaf width"، t.پهنا(first.دریافت(20))
پایان
