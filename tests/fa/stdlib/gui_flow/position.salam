واردسازی رابط گرافیکی.چیدمان
واردسازی ریاضی

تابع r(v: اعشار۶۴): اعشار۶۴:
    x := ریاضی.گردکردن(v * 100.0) / 100.0
    اگر x برابر 0.0:
        برگشت 0.0
    پایان
    برگشت x
پایان

تابع dump(t &: چیدمان.درخت چیدمان، id: صحیح، depth: صحیح):
    ناپایا pad := ""
    تکرار depth:
        pad += "  "
    پایان
    سرچاپ pad + "#" + id، r(t.ایکس(id))، r(t.ایگرگ(id))، r(t.پهنا(id))، r(t.بلندی(id))
    تکرار t.شمار فرزندان(id) در i:
        dump(t، t.فرزند(id، i)، depth + 1)
    پایان
پایان

تابع box(w: اعشار۶۴، h: اعشار۶۴): چیدمان.سبک چیدمان:
    برگشت چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(w)، بلندی = چیدمان.پیکسلی(h) }
پایان

تابع run(title: رشته، t &: چیدمان.درخت چیدمان، w: اعشار۶۴، h: اعشار۶۴):
    t.چیدن(w، h)
    سرچاپ "=="، title
    dump(t، 0، 0)
پایان

تابع ins(top: چیدمان.درازا، trailing: چیدمان.درازا، bottom: چیدمان.درازا، leading: چیدمان.درازا): چیدمان.لبه‌ها:
    برگشت چیدمان.چهار لبه(top، trailing، bottom، leading)
پایان

تابع absolute():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0))، پهنای مرز = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(5.0))، پهنا = چیدمان.پیکسلی(300.0)، بلندی = چیدمان.پیکسلی(200.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(30.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، فاصله جایگاه = ins(چیدمان.پیکسلی(10.0)، چیدمان.خودکار()، چیدمان.خودکار()، چیدمان.پیکسلی(20.0))، پهنا = چیدمان.پیکسلی(50.0)، بلندی = چیدمان.پیکسلی(40.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، فاصله جایگاه = ins(چیدمان.پیکسلی(10.0)، چیدمان.پیکسلی(10.0)، چیدمان.پیکسلی(10.0)، چیدمان.پیکسلی(10.0)) })
    t.افزودن(root، چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، فاصله جایگاه = ins(چیدمان.خودکار()، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)، چیدمان.خودکار())، پهنا = چیدمان.درصدی(0.5)، بلندی = چیدمان.پیکسلی(20.0) })
    ناپایا c := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، فاصله جایگاه = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(0.0))، پهنا = چیدمان.پیکسلی(60.0)، بلندی = چیدمان.پیکسلی(30.0) }
    c.فاصله بیرونی = چیدمان.همه لبه‌ها(چیدمان.خودکار())
    t.افزودن(root، c)
    ناپایا st := box(25.0، 25.0)
    st.جایگاه = چیدمان.جایگاه‌مطلق
    t.افزودن(root، st)
    ناپایا lr := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، پهنا = چیدمان.پیکسلی(10.0)، بلندی = چیدمان.پیکسلی(10.0) }
    lr.فاصله جایگاه.چپ = چیدمان.پیکسلی(1.0)
    lr.فاصله جایگاه.بالا = چیدمان.پیکسلی(2.0)
    t.افزودن(root، lr)
    run("absolute: insets, stretch between insets, percent, centred, static"، t، 400.0، 400.0)
پایان

تابع fixed():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(20.0)) })
    inner := t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(50.0)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(7.0)) })
    f := t.افزودن(inner، چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌ثابت، فاصله جایگاه = ins(چیدمان.خودکار()، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0))، بلندی = چیدمان.پیکسلی(30.0) })
    run("fixed: placed against the viewport"، t، 300.0، 200.0)
    سرچاپ "fixed abs"، t.ایکس مطلق(f)، t.ایگرگ مطلق(f)
    t.چیدن(500.0، 250.0)
    سرچاپ "after resize"، t.ایکس مطلق(f)، t.ایگرگ مطلق(f)، t.پهنا(f)، t.بلندی(f)
پایان

تابع sticky():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(100.0)، سرریز عمودی = چیدمان.سرریز‌پیمایش })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(40.0)، کاهش = 0.0 })
    ناپایا hs := چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(20.0)، کاهش = 0.0، جایگاه = چیدمان.جایگاه‌چسبان }
    hs.فاصله جایگاه.بالا = چیدمان.پیکسلی(0.0)
    h := t.افزودن(root، hs)
    sect := t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(200.0)، کاهش = 0.0 })
    ناپایا inner := چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، جایگاه = چیدمان.جایگاه‌چسبان }
    inner.فاصله جایگاه.بالا = چیدمان.پیکسلی(5.0)
    inner.فاصله جایگاه.پایین = چیدمان.پیکسلی(5.0)
    s2 := t.افزودن(sect، inner)
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(300.0)، کاهش = 0.0 })
    t.چیدن(200.0، 100.0)
    سرچاپ "content"، t.پهنای محتوا(root)، t.بلندی محتوا(root)
    هر sy در [0.0، 30.0، 100.0، 250.0، 2000.0]:
        t.تنظیم پیمایش(root، 0.0، sy)
        سرچاپ "scroll"، sy، "->"، t.پیمایش عمودی(root)، "header y"، t.ایگرگ(h)، "abs"، t.ایگرگ مطلق(h)، "inner y"، t.ایگرگ(s2)، "abs"، t.ایگرگ مطلق(s2)
    پایان
پایان

تابع scroll():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(50.0)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(5.0))، پهنای مرز = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(1.0))، سرریز افقی = چیدمان.سرریز‌خودکار })
    a := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(80.0)، کاهش = 0.0 })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(80.0)، کاهش = 0.0، فاصله بیرونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(10.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)) })
    t.چیدن(400.0، 400.0)
    سرچاپ "content"، t.پهنای محتوا(root)، t.بلندی محتوا(root)
    t.تنظیم پیمایش(root، 40.0، 10.0)
    سرچاپ "scroll"، t.پیمایش افقی(root)، t.پیمایش عمودی(root)، "a at"، t.ایکس(a)، t.ایگرگ(a)
    t.تنظیم پیمایش(root، 500.0، 0.0)
    سرچاپ "clamped"، t.پیمایش افقی(root)، "a at"، t.ایکس(a)
    ناپایا v := چیدمان.درخت تازه()
    vr := v.افزودن(-1، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(50.0) })
    v.افزودن(vr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(80.0)، کاهش = 0.0 })
    v.چیدن(400.0، 400.0)
    v.تنظیم پیمایش(vr، 0.0، 20.0)
    سرچاپ "visible overflow does not scroll"، v.پیمایش عمودی(vr)، v.بلندی محتوا(vr)
پایان

تابع static_positions():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، پخش = چیدمان.تراز‌وسط، تراز = چیدمان.تراز‌انتها، پهنا = چیدمان.پیکسلی(200.0)، بلندی = چیدمان.پیکسلی(100.0)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0)) })
    t.افزودن(root، box(40.0، 20.0))
    ناپایا a := box(30.0، 30.0)
    a.جایگاه = چیدمان.جایگاه‌مطلق
    t.افزودن(root، a)
    ناپایا b := box(30.0، 30.0)
    b.جایگاه = چیدمان.جایگاه‌مطلق
    b.فاصله جایگاه.بالا = چیدمان.پیکسلی(0.0)
    t.افزودن(root، b)
    col := t.افزودن(root، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌ستونی، پهنا = چیدمان.پیکسلی(60.0)، بلندی = چیدمان.پیکسلی(60.0)، جهت = چیدمان.جهت‌راست‌به‌چپ، تراز = چیدمان.تراز‌آغاز، پخش = چیدمان.تراز‌انتها })
    ناپایا c := box(10.0، 10.0)
    c.جایگاه = چیدمان.جایگاه‌مطلق
    t.افزودن(col، c)
    run("absolute with no insets: static position from justify and align"، t، 300.0، 300.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { سرریز عمودی = چیدمان.سرریز‌پیمایش، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(5.0)) })
    s.افزودن(sr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(500.0)، کاهش = 0.0 })
    holder := s.افزودن(sr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(50.0)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(3.0)) })
    ناپایا f := box(20.0، 20.0)
    f.جایگاه = چیدمان.جایگاه‌ثابت
    f.فاصله جایگاه.چپ = چیدمان.پیکسلی(7.0)
    fx := s.افزودن(holder، f)
    s.چیدن(200.0، 300.0)
    سرچاپ "fixed with only left: abs"، s.ایکس مطلق(fx)، s.ایگرگ مطلق(fx)
    s.تنظیم پیمایش(sr، 0.0، 200.0)
    سرچاپ "after scrolling the page it stays"، s.ایکس مطلق(fx)، s.ایگرگ مطلق(fx)، "relative y"، s.ایگرگ(fx)
پایان

تابع static_in_flow_and_grid():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.به اندازه محتوا()، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(5.0)) })
    t.افزودن(root، box(40.0، 10.0))
    t.افزودن(root، box(40.0، 10.0))
    t.افزودن(root، box(40.0، 10.0))
    ناپایا a := box(8.0، 8.0)
    a.جایگاه = چیدمان.جایگاه‌مطلق
    t.افزودن(root، a)
    ناپایا b := box(8.0، 8.0)
    b.جایگاه = چیدمان.جایگاه‌مطلق
    t.جابجایی(t.افزودن(root، b)، root، 1)
    run("absolute in a flow parent sits where it would be inline"، t، 300.0، 300.0)
    ناپایا cols := وکتور {} برگردان وکتور<چیدمان.شیار>
    cols.افزودن(چیدمان.شیار سهمی(1.0))
    cols.افزودن(چیدمان.شیار سهمی(1.0))
    ناپایا g := چیدمان.درخت تازه()
    gr := g.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = cols، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(50.0)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0))، پهنای مرز = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(2.0))، جهت = چیدمان.جهت‌راست‌به‌چپ })
    g.افزودن(gr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0) })
    ناپایا c := box(8.0، 8.0)
    c.جایگاه = چیدمان.جایگاه‌مطلق
    c.فاصله بیرونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(1.0))
    g.افزودن(gr، c)
    run("absolute in an rtl grid sits at the start corner of the padding box"، g، 300.0، 300.0)
پایان

تابع overflow_pairs():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(50.0)، سرریز افقی = چیدمان.سرریز‌پنهان })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(80.0)، پهنا = چیدمان.پیکسلی(150.0)، کاهش = 0.0 })
    t.چیدن(300.0، 300.0)
    t.تنظیم پیمایش(root، 30.0، 20.0)
    سرچاپ "hidden x makes visible y auto:"، t.پهنای محتوا(root)، t.بلندی محتوا(root)، t.پیمایش افقی(root)، t.پیمایش عمودی(root)
پایان

تابع ریشه:
    static_in_flow_and_grid()
    overflow_pairs()
    static_positions()
    absolute()
    fixed()
    sticky()
    scroll()
پایان
