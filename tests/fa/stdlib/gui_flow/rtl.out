== rtl row starts at the right, padding start is on the right
#0 0 0 300 10
  #1 262 0 30 10
  #2 217 0 40 10
  #3 162 0 50 10
== rtl row reverse starts at the left
#0 0 0 300 10
  #1 0 0 30 10
  #2 30 0 40 10
  #3 70 0 50 10
== rtl row justify end packs at the left
#0 0 0 300 10
  #1 90 0 30 10
  #2 50 0 40 10
  #3 0 0 50 10
== rtl column: start margin on the right, left and right stay physical
#0 0 0 200 100
  #1 20 0 175 10
  #2 150 10 50 10
  #3 0 20 50 10
== rtl column wrap places columns from the right
#0 0 0 200 20
  #1 170 0 30 10
  #2 160 10 40 10
  #3 110 0 50 10
== rtl grid: column 1 on the right, justify start is right
#0 0 0 300 100
  #1 260 0 40 10
  #2 230 0 20 10
  #3 0 0 180 10
  #4 0 10 180 10
== rtl flow runs right to left
#0 0 0 100 20
  #1 70 0 30 10
  #2 30 0 40 10
  #3 50 10 50 10
== rtl flow with text align left
#0 0 0 100 20
  #1 40 0 30 10
  #2 0 0 40 10
  #3 0 10 50 10
== rtl stack start is right
#0 0 0 100 50
  #1 80 0 20 20
  #2 0 0 20 20
== rtl absolute: start inset from the right, static at the right
#0 0 0 200 100
  #1 165 5 30 30
  #2 160 10 30 30
  #3 5 10 30 30
== direction inherits from the parent
#0 0 0 100 100
  #1 0 0 100 10
    #2 90 0 10 10
  #3 0 10 100 10
    #4 0 0 10 10
== switching the root to ltr mirrors the subtree
#0 0 0 100 100
  #1 0 0 100 10
    #2 0 0 10 10
  #3 0 10 100 10
    #4 0 0 10 10
rtl content 160 first at 20
scroll -30 -30 first at 50
scroll 30 clamps 0
