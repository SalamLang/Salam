واردسازی رابط گرافیکی.چیدمان
واردسازی ریاضی

تابع r(v: اعشار۶۴): اعشار۶۴:
    x := ریاضی.گردکردن(v * 100.0) / 100.0
    اگر x برابر 0.0:
        برگشت 0.0
    پایان
    برگشت x
پایان

تابع dump(t &: چیدمان.درخت چیدمان، id: صحیح، depth: صحیح):
    ناپایا pad := ""
    تکرار depth:
        pad += "  "
    پایان
    سرچاپ pad + "#" + id، r(t.ایکس(id))، r(t.ایگرگ(id))، r(t.پهنا(id))، r(t.بلندی(id))
    تکرار t.شمار فرزندان(id) در i:
        dump(t، t.فرزند(id، i)، depth + 1)
    پایان
پایان

تابع box(w: اعشار۶۴، h: اعشار۶۴): چیدمان.سبک چیدمان:
    برگشت چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(w)، بلندی = چیدمان.پیکسلی(h) }
پایان

تابع run(title: رشته، t &: چیدمان.درخت چیدمان، w: اعشار۶۴، h: اعشار۶۴):
    t.چیدن(w، h)
    سرچاپ "=="، title
    dump(t، 0، 0)
پایان

تابع three(t &: چیدمان.درخت چیدمان، root: صحیح):
    t.افزودن(root، box(30.0، 10.0))
    t.افزودن(root، box(40.0، 10.0))
    t.افزودن(root، box(50.0، 10.0))
پایان

تابع row_rtl():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، جهت = چیدمان.جهت‌راست‌به‌چپ، فاصله ستون‌ها = چیدمان.پیکسلی(5.0)، بلندی = چیدمان.پیکسلی(10.0)، فاصله درونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(8.0)) })
    three(t، root)
    run("rtl row starts at the right, padding start is on the right"، t، 300.0، 100.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، جهت = چیدمان.جهت‌راست‌به‌چپ، برعکس = درست، بلندی = چیدمان.پیکسلی(10.0) })
    three(s، sr)
    run("rtl row reverse starts at the left"، s، 300.0، 100.0)
    ناپایا j := چیدمان.درخت تازه()
    jr := j.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، جهت = چیدمان.جهت‌راست‌به‌چپ، پخش = چیدمان.تراز‌انتها، بلندی = چیدمان.پیکسلی(10.0) })
    three(j، jr)
    run("rtl row justify end packs at the left"، j، 300.0، 100.0)
پایان

تابع margins_rtl():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { جهت = چیدمان.جهت‌راست‌به‌چپ })
    ناپایا m := چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0) }
    m.فاصله بیرونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(20.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(5.0))
    t.افزودن(root، m)
    ناپایا p := چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، پهنا = چیدمان.پیکسلی(50.0)، تراز اختصاصی = چیدمان.تراز‌آغاز }
    p.فاصله بیرونی.چپ = چیدمان.پیکسلی(3.0)
    t.افزودن(root، p)
    ناپایا q := چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، پهنا = چیدمان.پیکسلی(50.0)، تراز اختصاصی = چیدمان.تراز‌انتها }
    q.فاصله بیرونی.آغاز = چیدمان.پیکسلی(7.0)
    q.فاصله بیرونی.راست = چیدمان.پیکسلی(1.0)
    t.افزودن(root، q)
    run("rtl column: start margin on the right, left and right stay physical"، t، 200.0، 100.0)
پایان

تابع column_wrap_rtl():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { جهت = چیدمان.جهت‌راست‌به‌چپ، شکستن = درست، بلندی = چیدمان.پیکسلی(20.0)، تراز = چیدمان.تراز‌آغاز })
    three(t، root)
    run("rtl column wrap places columns from the right"، t، 200.0، 100.0)
پایان

تابع grid_rtl():
    ناپایا cols := وکتور {} برگردان وکتور<چیدمان.شیار>
    cols.افزودن(چیدمان.شیار با درازا(چیدمان.پیکسلی(40.0)))
    cols.افزودن(چیدمان.شیار با درازا(چیدمان.پیکسلی(60.0)))
    cols.افزودن(چیدمان.شیار سهمی(1.0))
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، جهت = چیدمان.جهت‌راست‌به‌چپ، ستون‌ها = cols، فاصله ستون‌ها = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، پهنا = چیدمان.پیکسلی(20.0)، پخش اختصاصی = چیدمان.تراز‌آغاز })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0)، ستون = -1 })
    run("rtl grid: column 1 on the right, justify start is right"، t، 300.0، 100.0)
پایان

تابع flow_rtl():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، جهت = چیدمان.جهت‌راست‌به‌چپ، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.به اندازه محتوا() })
    three(t، root)
    run("rtl flow runs right to left"، t، 200.0، 100.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، جهت = چیدمان.جهت‌راست‌به‌چپ، تراز متن = چیدمان.متن‌چپ، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.به اندازه محتوا() })
    three(s، sr)
    run("rtl flow with text align left"، s، 200.0، 100.0)
پایان

تابع stack_rtl():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌پشته‌ای، جهت = چیدمان.جهت‌راست‌به‌چپ، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(50.0) })
    t.افزودن(root، box(20.0، 20.0))
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(20.0)، بلندی = چیدمان.پیکسلی(20.0)، پخش اختصاصی = چیدمان.تراز‌انتها })
    run("rtl stack start is right"، t، 200.0، 100.0)
پایان

تابع absolute_rtl():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { جهت = چیدمان.جهت‌راست‌به‌چپ، پهنا = چیدمان.پیکسلی(200.0)، بلندی = چیدمان.پیکسلی(100.0)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0)) })
    ناپایا a := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، پهنا = چیدمان.پیکسلی(30.0)، بلندی = چیدمان.پیکسلی(30.0) }
    a.فاصله جایگاه.آغاز = چیدمان.پیکسلی(5.0)
    a.فاصله جایگاه.بالا = چیدمان.پیکسلی(5.0)
    t.افزودن(root، a)
    t.افزودن(root، چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، پهنا = چیدمان.پیکسلی(30.0)، بلندی = چیدمان.پیکسلی(30.0) })
    ناپایا b := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، پهنا = چیدمان.پیکسلی(30.0)، بلندی = چیدمان.پیکسلی(30.0) }
    b.فاصله جایگاه.چپ = چیدمان.پیکسلی(5.0)
    t.افزودن(root، b)
    run("rtl absolute: start inset from the right, static at the right"، t، 300.0، 300.0)
پایان

تابع inherit():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { جهت = چیدمان.جهت‌راست‌به‌چپ })
    mid := t.افزودن(root، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(mid، box(10.0، 10.0))
    ltr := t.افزودن(root، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(10.0)، جهت = چیدمان.جهت‌چپ‌به‌راست })
    t.افزودن(ltr، box(10.0، 10.0))
    run("direction inherits from the parent"، t، 100.0، 100.0)
    ناپایا st := t.سبک(root)
    st.جهت = چیدمان.جهت‌چپ‌به‌راست
    t.تنظیم سبک(root، st)
    run("switching the root to ltr mirrors the subtree"، t، 100.0، 100.0)
پایان

تابع scroll_rtl():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، جهت = چیدمان.جهت‌راست‌به‌چپ، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(20.0)، سرریز افقی = چیدمان.سرریز‌پیمایش })
    a := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(80.0)، کاهش = 0.0 })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(80.0)، کاهش = 0.0 })
    t.چیدن(300.0، 300.0)
    سرچاپ "rtl content"، t.پهنای محتوا(root)، "first at"، t.ایکس(a)
    t.تنظیم پیمایش(root، -30.0، 0.0)
    سرچاپ "scroll -30"، t.پیمایش افقی(root)، "first at"، t.ایکس(a)
    t.تنظیم پیمایش(root، 30.0، 0.0)
    سرچاپ "scroll 30 clamps"، t.پیمایش افقی(root)
پایان

تابع ریشه:
    row_rtl()
    margins_rtl()
    column_wrap_rtl()
    grid_rtl()
    flow_rtl()
    stack_rtl()
    absolute_rtl()
    inherit()
    scroll_rtl()
پایان
