واردسازی رابط گرافیکی.چیدمان
واردسازی ریاضی

تابع r(v: اعشار۶۴): اعشار۶۴:
    x := ریاضی.گردکردن(v * 100.0) / 100.0
    اگر x برابر 0.0:
        برگشت 0.0
    پایان
    برگشت x
پایان

تابع dump(t &: چیدمان.درخت چیدمان، id: صحیح، depth: صحیح):
    ناپایا pad := ""
    تکرار depth:
        pad += "  "
    پایان
    سرچاپ pad + "#" + id، r(t.ایکس(id))، r(t.ایگرگ(id))، r(t.پهنا(id))، r(t.بلندی(id))
    تکرار t.شمار فرزندان(id) در i:
        dump(t، t.فرزند(id، i)، depth + 1)
    پایان
پایان

تابع box(w: اعشار۶۴، h: اعشار۶۴): چیدمان.سبک چیدمان:
    برگشت چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(w)، بلندی = چیدمان.پیکسلی(h) }
پایان

تابع run(title: رشته، t &: چیدمان.درخت چیدمان، w: اعشار۶۴، h: اعشار۶۴):
    t.چیدن(w، h)
    سرچاپ "=="، title
    dump(t، 0، 0)
پایان

تابع words(t &: چیدمان.درخت چیدمان، parent: صحیح، style: چیدمان.سبک چیدمان، count: صحیح): صحیح:
    id := t.افزودن(parent، style)
    t.تنظیم سنجش(id، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴):
        ناپایا per := count
        اگر w بزرگتربرابر 0.0:
            per = ((w + 5.0) / 25.0) برگردان صحیح
            اگر per کوچکتر 1:
                per = 1
            پایان
            اگر per بزرگتر count:
                per = count
            پایان
        پایان
        lines := (count + per - 1) / per
        برگشت چیدمان.ابعاد { پهنا = (per برگردان اعشار۶۴) * 25.0 - 5.0، بلندی = (lines برگردان اعشار۶۴) * 10.0، خط پایه = 8.0 }
    پایان)
    برگشت id
پایان

تابع width_kinds():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0))، تراز = چیدمان.تراز‌آغاز })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(120.0)، بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.درصدی(0.5)، بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسل باضافه درصد(-20.0، 0.5)، بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پرکننده()، بلندی = چیدمان.پیکسلی(10.0)، فاصله بیرونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(30.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(10.0)) })
    words(t، root، چیدمان.سبک چیدمان {}، 6)
    words(t، root، چیدمان.سبک چیدمان { پهنا = چیدمان.به اندازه محتوا() }، 20)
    words(t، root، چیدمان.سبک چیدمان { پهنا = چیدمان.کمینه محتوا() }، 6)
    words(t، root، چیدمان.سبک چیدمان { پهنا = چیدمان.بیشینه محتوا() }، 20)
    run("len, percent, percent minus px, fill, auto, fit, min content, max content"، t، 300.0، 400.0)
پایان

تابع min_max():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { تراز = چیدمان.تراز‌آغاز })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(500.0)، بیشینه پهنا = چیدمان.درصدی(0.5)، بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(5.0)، کمینه پهنا = چیدمان.پیکسلی(40.0)، بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(100.0)، کمینه پهنا = چیدمان.پیکسلی(80.0)، بیشینه پهنا = چیدمان.پیکسلی(60.0)، بلندی = چیدمان.پیکسلی(10.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(10.0)، بلندی = چیدمان.پیکسلی(500.0)، بیشینه بلندی = چیدمان.پیکسلی(20.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(10.0)، کمینه بلندی = چیدمان.پیکسلی(15.0) })
    words(t، root، چیدمان.سبک چیدمان { بیشینه پهنا = چیدمان.کمینه محتوا() }، 6)
    run("max percent, min over width, min wins over max, max height, min height, max min content"، t، 300.0، 400.0)
پایان

تابع hidden():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، فاصله ستون‌ها = چیدمان.پیکسلی(10.0)، بلندی = چیدمان.پیکسلی(20.0) })
    t.افزودن(root، box(30.0، 20.0))
    h := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(30.0)، پیدا = نادرست })
    t.افزودن(h، box(10.0، 10.0))
    t.افزودن(root، box(30.0، 20.0))
    run("visible false takes no space and no gap"، t، 200.0، 100.0)
پایان

تابع nested_percent():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.درصدی(0.05)) })
    a := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.درصدی(0.5)، بلندی = چیدمان.درصدی(0.5)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0))، تراز = چیدمان.تراز‌آغاز })
    t.افزودن(a، چیدمان.سبک چیدمان { پهنا = چیدمان.درصدی(0.5)، بلندی = چیدمان.درصدی(0.25) })
    run("nested percent of the content box"، t، 400.0، 400.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { بلندی = چیدمان.به اندازه محتوا()، تراز = چیدمان.تراز‌آغاز })
    s.افزودن(sr، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(20.0)، بلندی = چیدمان.درصدی(0.5) })
    run("percent height of a content sized parent is auto"، s، 400.0، 400.0)
پایان

تابع zero_and_overflow():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(30.0)) })
    t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(10.0) })
    run("viewport smaller than padding"، t، 40.0، 0.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(0.0)، بلندی = چیدمان.پیکسلی(0.0) })
    s.افزودن(sr، box(0.0، 0.0))
    s.افزودن(sr، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(10.0)، بلندی = چیدمان.پیکسلی(10.0)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(8.0)) })
    run("zero sizes and padding larger than the box"، s، 100.0، 100.0)
    ناپایا o := چیدمان.درخت تازه()
    oroot := o.افزودن(-1، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(50.0) })
    o.افزودن(oroot، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(40.0)، کاهش = 0.0 })
    o.افزودن(oroot، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(40.0)، کاهش = 0.0 })
    o.افزودن(oroot، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(300.0)، بلندی = چیدمان.پیکسلی(10.0)، کاهش = 0.0 })
    run("children overflow a fixed column"، o، 100.0، 100.0)
    سرچاپ "content"، o.پهنای محتوا(oroot)، o.بلندی محتوا(oroot)
    ناپایا n := چیدمان.درخت تازه()
    nr := n.افزودن(-1، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(50.0) })
    n.افزودن(nr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(40.0) })
    n.افزودن(nr، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(60.0)، کاهش = 2.0 })
    run("negative free space shrinks a column"، n، 100.0، 100.0)
پایان

تابع text_in_row():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، تراز = چیدمان.تراز‌آغاز })
    words(t، root، چیدمان.سبک چیدمان { کاهش = 1.0 }، 10)
    words(t، root، چیدمان.سبک چیدمان {}، 4)
    run("two texts shrink in a narrow row"، t، 200.0، 100.0)
    سرچاپ "measures"، t.شمار سنجش‌ها()
پایان

تابع ریشه:
    width_kinds()
    min_max()
    hidden()
    nested_percent()
    zero_and_overflow()
    text_in_row()
پایان
