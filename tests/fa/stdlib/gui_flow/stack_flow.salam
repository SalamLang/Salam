واردسازی رابط گرافیکی.چیدمان
واردسازی ریاضی

تابع r(v: اعشار۶۴): اعشار۶۴:
    x := ریاضی.گردکردن(v * 100.0) / 100.0
    اگر x برابر 0.0:
        برگشت 0.0
    پایان
    برگشت x
پایان

تابع dump(t &: چیدمان.درخت چیدمان، id: صحیح، depth: صحیح):
    ناپایا pad := ""
    تکرار depth:
        pad += "  "
    پایان
    سرچاپ pad + "#" + id، r(t.ایکس(id))، r(t.ایگرگ(id))، r(t.پهنا(id))، r(t.بلندی(id))
    تکرار t.شمار فرزندان(id) در i:
        dump(t، t.فرزند(id، i)، depth + 1)
    پایان
پایان

تابع box(w: اعشار۶۴، h: اعشار۶۴): چیدمان.سبک چیدمان:
    برگشت چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(w)، بلندی = چیدمان.پیکسلی(h) }
پایان

تابع run(title: رشته، t &: چیدمان.درخت چیدمان، w: اعشار۶۴، h: اعشار۶۴):
    t.چیدن(w، h)
    سرچاپ "=="، title
    dump(t، 0، 0)
پایان

تابع words(t &: چیدمان.درخت چیدمان، parent: صحیح، style: چیدمان.سبک چیدمان، count: صحیح): صحیح:
    id := t.افزودن(parent، style)
    t.تنظیم سنجش(id، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴):
        ناپایا per := count
        اگر w بزرگتربرابر 0.0:
            per = ((w + 5.0) / 25.0) برگردان صحیح
            اگر per کوچکتر 1:
                per = 1
            پایان
            اگر per بزرگتر count:
                per = count
            پایان
        پایان
        lines := (count + per - 1) / per
        برگشت چیدمان.ابعاد { پهنا = (per برگردان اعشار۶۴) * 25.0 - 5.0، بلندی = (lines برگردان اعشار۶۴) * 10.0، خط پایه = 8.0 }
    پایان)
    برگشت id
پایان

تابع glyph(t &: چیدمان.درخت چیدمان، parent: صحیح، w: اعشار۶۴، h: اعشار۶۴، base: اعشار۶۴): صحیح:
    id := t.افزودن(parent، چیدمان.سبک چیدمان {})
    t.تنظیم سنجش(id، (_id: صحیح، _aw: اعشار۶۴، _ah: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = w، بلندی = h، خط پایه = base } پایان)
    برگشت id
پایان

تابع stack():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌پشته‌ای، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0))، پهنا = چیدمان.پیکسلی(200.0)، بلندی = چیدمان.به اندازه محتوا() })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پرکننده()، بلندی = چیدمان.پیکسلی(80.0) })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(50.0)، بلندی = چیدمان.پیکسلی(20.0)، پخش اختصاصی = چیدمان.تراز‌انتها، تراز اختصاصی = چیدمان.تراز‌انتها })
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(40.0)، بلندی = چیدمان.پیکسلی(40.0)، پخش اختصاصی = چیدمان.تراز‌وسط، تراز اختصاصی = چیدمان.تراز‌وسط، لایه = 2 })
    t.افزودن(root، چیدمان.سبک چیدمان { پخش اختصاصی = چیدمان.تراز‌کشیده، بلندی = چیدمان.پیکسلی(10.0)، لایه = -1 })
    words(t، root، چیدمان.سبک چیدمان { تراز اختصاصی = چیدمان.تراز‌آغاز }، 3)
    run("stack: one cell, later on top"، t، 400.0، 400.0)
    چاپ "paint order"
    هر id در t.ترتیب نقاشی(root):
        چاپ " "، id، "("، t.لایه(id)، ")"
    پایان
    سرچاپ ""
    ناپایا c := چیدمان.درخت تازه()
    cr := c.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌پشته‌ای، پخش = چیدمان.تراز‌وسط، تراز = چیدمان.تراز‌انتها، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(100.0) })
    c.افزودن(cr، box(20.0، 20.0))
    ناپایا m := box(20.0، 20.0)
    m.فاصله بیرونی = چیدمان.همه لبه‌ها(چیدمان.خودکار())
    c.افزودن(cr، m)
    run("stack: container justify and align, auto margins centre"، c، 400.0، 400.0)
پایان

تابع flow_layout():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.به اندازه محتوا()، فاصله ستون‌ها = چیدمان.پیکسلی(4.0)، فاصله سطرها = چیدمان.پیکسلی(2.0) })
    glyph(t، root، 30.0، 12.0، 10.0)
    glyph(t، root، 30.0، 20.0، 16.0)
    glyph(t، root، 30.0، 12.0، 10.0)
    glyph(t، root، 50.0، 12.0، 10.0)
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(20.0)، بلندی = چیدمان.پیکسلی(6.0) })
    run("flow: wrap onto lines, baseline aligned, gap ignored"، t، 400.0، 400.0)
    سرچاپ "baseline"، t.خط پایه(root)
    names := ["start"، "center"، "end"، "justify"، "left"، "right"]
    هر i، ta در [چیدمان.متن‌از‌آغاز، چیدمان.متن‌وسط، چیدمان.متن‌از‌انتها، چیدمان.متن‌تمام‌چین، چیدمان.متن‌چپ، چیدمان.متن‌راست]:
        ناپایا s := چیدمان.درخت تازه()
        sr := s.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، تراز متن = ta، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.به اندازه محتوا() })
        glyph(s، sr، 30.0، 10.0، 8.0)
        glyph(s، sr، 30.0، 10.0، 8.0)
        glyph(s، sr، 30.0، 10.0، 8.0)
        glyph(s، sr، 30.0، 10.0، 8.0)
        run("flow text align " + names[i]، s، 400.0، 400.0)
    پایان
    ناپایا a := چیدمان.درخت تازه()
    ar := a.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، پهنا = چیدمان.پیکسلی(200.0)، بلندی = چیدمان.به اندازه محتوا() })
    glyph(a، ar، 30.0، 30.0، 25.0)
    ناپایا top := چیدمان.سبک چیدمان { تراز اختصاصی = چیدمان.تراز‌آغاز }
    top.فاصله بیرونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(5.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(5.0))
    g1 := a.افزودن(ar، top)
    a.تنظیم سنجش(g1، (_id: صحیح، _aw: اعشار۶۴، _ah: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 10.0، بلندی = 10.0، خط پایه = 8.0 } پایان)
    g2 := a.افزودن(ar، چیدمان.سبک چیدمان { تراز اختصاصی = چیدمان.تراز‌وسط })
    a.تنظیم سنجش(g2، (_id: صحیح، _aw: اعشار۶۴، _ah: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 10.0، بلندی = 10.0، خط پایه = 8.0 } پایان)
    g3 := a.افزودن(ar، چیدمان.سبک چیدمان { تراز اختصاصی = چیدمان.تراز‌انتها })
    a.تنظیم سنجش(g3، (_id: صحیح، _aw: اعشار۶۴، _ah: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 10.0، بلندی = 10.0، خط پایه = 8.0 } پایان)
    words(a، ar، چیدمان.سبک چیدمان {}، 12)
    run("flow: self alignment in a line and a text leaf"، a، 400.0، 400.0)
پایان

تابع last_baselines():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، پهنا = چیدمان.پیکسلی(300.0)، بلندی = چیدمان.به اندازه محتوا() })
    glyph(t، root، 20.0، 10.0، 8.0)
    para := t.افزودن(root، چیدمان.سبک چیدمان {})
    t.تنظیم سنجش(para، (_id: صحیح، _aw: اعشار۶۴، _ah: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 50.0، بلندی = 30.0، خط پایه = 8.0، خط پایه آخر = 28.0 } پایان)
    inner := t.افزودن(root، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، پهنا = چیدمان.پیکسلی(40.0)، بلندی = چیدمان.به اندازه محتوا() })
    glyph(t، inner، 30.0، 10.0، 8.0)
    glyph(t، inner، 30.0، 10.0، 8.0)
    t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(20.0)، بلندی = چیدمان.پیکسلی(12.0)، فاصله بیرونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(4.0)، چیدمان.پیکسلی(0.0)) })
    clip := t.افزودن(root، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، پهنا = چیدمان.پیکسلی(40.0)، بلندی = چیدمان.به اندازه محتوا()، سرریز افقی = چیدمان.سرریز‌پنهان })
    glyph(t، clip، 30.0، 10.0، 8.0)
    row := t.افزودن(root، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، پهنا = چیدمان.پیکسلی(40.0) })
    glyph(t، row، 30.0، 20.0، 5.0)
    run("flow children sit on their last baseline, boxes without one on the bottom margin edge, a row on its first"، t، 400.0، 400.0)
پایان

تابع ریشه:
    last_baselines()
    stack()
    flow_layout()
پایان
