واردسازی رابط گرافیکی.چیدمان
واردسازی ریاضی

تابع r(v: اعشار۶۴): اعشار۶۴:
    x := ریاضی.گردکردن(v * 100.0) / 100.0
    اگر x برابر 0.0:
        برگشت 0.0
    پایان
    برگشت x
پایان

تابع dump(t &: چیدمان.درخت چیدمان، id: صحیح، depth: صحیح):
    ناپایا pad := ""
    تکرار depth:
        pad += "  "
    پایان
    سرچاپ pad + "#" + id، r(t.ایکس(id))، r(t.ایگرگ(id))، r(t.پهنا(id))، r(t.بلندی(id))
    تکرار t.شمار فرزندان(id) در i:
        dump(t، t.فرزند(id، i)، depth + 1)
    پایان
پایان

تابع box(w: اعشار۶۴، h: اعشار۶۴): چیدمان.سبک چیدمان:
    برگشت چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(w)، بلندی = چیدمان.پیکسلی(h) }
پایان

تابع run(title: رشته، t &: چیدمان.درخت چیدمان، w: اعشار۶۴، h: اعشار۶۴):
    t.چیدن(w، h)
    سرچاپ "=="، title
    dump(t، 0، 0)
پایان

تابع items(t &: چیدمان.درخت چیدمان، root: صحیح، n: صحیح، w: اعشار۶۴، h: اعشار۶۴):
    تکرار n:
        t.افزودن(root، box(w، h))
    پایان
پایان

تابع row_wrap():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، شکستن = درست، فاصله ستون‌ها = چیدمان.پیکسلی(10.0)، فاصله سطرها = چیدمان.پیکسلی(5.0)، تراز = چیدمان.تراز‌آغاز })
    items(t، root، 5، 60.0، 20.0)
    run("row wrap into lines"، t، 200.0، 200.0)
پایان

تابع align_content():
    names := ["start"، "center"، "end"، "stretch"، "between"، "around"، "evenly"]
    هر i، ac در [چیدمان.تراز‌آغاز، چیدمان.تراز‌وسط، چیدمان.تراز‌انتها، چیدمان.تراز‌کشیده، چیدمان.تراز‌فاصله‌میانی، چیدمان.تراز‌فاصله‌پیرامون، چیدمان.تراز‌فاصله‌یکسان]:
        ناپایا t := چیدمان.درخت تازه()
        root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، شکستن = درست، تراز محتوا = ac، بلندی = چیدمان.پیکسلی(100.0) })
        t.افزودن(root، box(60.0، 20.0))
        t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(60.0) })
        t.افزودن(root، box(60.0، 10.0))
        run("align content " + names[i]، t، 130.0، 200.0)
    پایان
پایان

تابع column_wrap():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { شکستن = درست، بلندی = چیدمان.پیکسلی(100.0)، تراز = چیدمان.تراز‌آغاز، فاصله ستون‌ها = چیدمان.پیکسلی(4.0) })
    items(t، root، 5، 30.0، 40.0)
    run("column wrap into columns"، t، 200.0، 200.0)
    ناپایا s := چیدمان.درخت تازه()
    sr := s.افزودن(-1، چیدمان.سبک چیدمان { شکستن = درست، بیشینه بلندی = چیدمان.پیکسلی(90.0)، بلندی = چیدمان.به اندازه محتوا()، تراز = چیدمان.تراز‌آغاز })
    items(s، sr، 3، 30.0، 40.0)
    run("column wrap limited by max height"، s، 200.0، 200.0)
پایان

تابع wrap_grow():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، شکستن = درست، بلندی = چیدمان.به اندازه محتوا() })
    تکرار 3:
        t.افزودن(root، چیدمان.سبک چیدمان { پایه = چیدمان.پیکسلی(80.0)، رشد = 1.0، بلندی = چیدمان.پیکسلی(10.0) })
    پایان
    run("wrapped items grow per line"، t، 200.0، 200.0)
پایان

تابع wrap_reverse():
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، شکستن = درست، برعکس = درست، بلندی = چیدمان.به اندازه محتوا() })
    items(t، root، 3، 80.0، 10.0)
    run("row wrap reverse"، t، 200.0، 200.0)
پایان

تابع ریشه:
    row_wrap()
    align_content()
    column_wrap()
    wrap_grow()
    wrap_reverse()
پایان
