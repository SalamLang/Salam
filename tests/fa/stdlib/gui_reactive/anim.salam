بسته ریشه

واردسازی رابط گرافیکی.واکنشی
واردسازی ریاضی

ناپایا left := واکنشی.ویژگی‌اعشاری {}
ناپایا doubled := واکنشی.ویژگی‌اعشاری {}
ناپایا count := واکنشی.ویژگی‌صحیح {}
ناپایا tint := واکنشی.ویژگی‌صحیح {}
ناپایا hover := واکنشی.ویژگی‌منطقی {}
ناپایا glow := واکنشی.ویژگی‌اعشاری {}
ناپایا frames := 0

تابع r4(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 10000.0) / 10000.0
پایان

تابع show_easing(name: رشته، e: واکنشی.نرمش):
    سرچاپ name، r4(e.مقدار لحظه(0.0))، r4(e.مقدار لحظه(0.25))، r4(e.مقدار لحظه(0.5))، r4(e.مقدار لحظه(0.75))، r4(e.مقدار لحظه(1.0))
پایان

تابع check_easings():
    fb := واکنشی.نرمش خطی()
    show_easing("linear"، واکنشی.خواندن نرمش("linear"، fb))
    show_easing("ease"، واکنشی.خواندن نرمش("ease"، fb))
    show_easing("ease-in"، واکنشی.خواندن نرمش("ease-in"، fb))
    show_easing("ease-out"، واکنشی.خواندن نرمش("ease-out"، fb))
    show_easing("ease-in-out"، واکنشی.خواندن نرمش("EASE-IN-OUT"، fb))
    show_easing("cubic-bezier"، واکنشی.خواندن نرمش("cubic-bezier(0.1, 0.7, 1.0, 0.1)"، fb))
    show_easing("EaseIn()"، واکنشی.نرمش ورود())
    show_easing("EaseOut()"، واکنشی.نرمش خروج())
    show_easing("overshoot"، واکنشی.نرمش بزیه(0.34، 1.56، 0.64، 1.0))
    show_easing("steps(4)"، واکنشی.خواندن نرمش("steps(4)"، fb))
    show_easing("steps(4, jump-start)"، واکنشی.خواندن نرمش("steps(4, jump-start)"، fb))
    show_easing("steps(4, jump-none)"، واکنشی.خواندن نرمش("steps(4, jump-none)"، fb))
    show_easing("steps(4, jump-both)"، واکنشی.خواندن نرمش("steps(4, jump-both)"، fb))
    show_easing("step-start"، واکنشی.خواندن نرمش("step-start"، fb))
    show_easing("step-end"، واکنشی.خواندن نرمش("step-end"، fb))
    bad := واکنشی.خواندن نرمش("cubic-bezier(2, 0, 0, 1)"، واکنشی.نرمش عادی())
    سرچاپ "bad x falls back to ease"، bad.گونه برابر واکنشی.گونه‌نرمش.بزیه مکعبی، bad.ایکس یک
    junk := واکنشی.خواندن نرمش("wobble"، fb)
    سرچاپ "unknown falls back"، junk.گونه برابر واکنشی.گونه‌نرمش.خطی
پایان

تابع frame(t: صحیح۶۴):
    واکنشی.تنظیم زمان(t)
    سرچاپ "t"، t، "left"، r4(left.بخوان())، "doubled"، r4(doubled.بخوان())، "running"، واکنشی.پویانمایی جاری()
پایان

تابع check_animation():
    واکنشی.تنظیم زمان(0 برگردان صحیح۶۴)
    left = واکنشی.اعشاری تازه(0.0).نام بده("left")
    left.پویانمایی(واکنشی.پویانمایی‌ویژگی { مدت = 1000، نرمش = واکنشی.نرمش ورود خروج() })
    doubled = واکنشی.اعشاری تازه(0.0)
    doubled.پیوند((): برگشت left.بخوان() * 2.0 پایان)
    سرچاپ "start"، left.بخوان()، "running"، واکنشی.پویانمایی جاری()
    t := واکنشی.ردیابی((): _v := doubled.بخوان() پایان، (): frames++ پایان)
    left.بنشان(100.0)
    سرچاپ "after set"، left.بخوان()، "running"، واکنشی.پویانمایی جاری()، "count"، واکنشی.شمار پویانمایی ها()
    تکرار 0 تا 1000 هر 250 در ms:
        _r := t.تازه کن()
        frame(ms برگردان صحیح۶۴)
    پایان
    سرچاپ "frames requested"، frames
    frame(1200 برگردان صحیح۶۴)
    سرچاپ "frames after the end"، frames
    واکنشی.تنظیم زمان(2000 برگردان صحیح۶۴)
    left.بنشان(0.0)
    frame(2000 برگردان صحیح۶۴)
    frame(2500 برگردان صحیح۶۴)
    left.بنشان(80.0)
    frame(2500 برگردان صحیح۶۴)
    frame(3000 برگردان صحیح۶۴)
    frame(3500 برگردان صحیح۶۴)
    t.آزاد کن()
پایان

تابع check_clock():
    واکنشی.تنظیم زمان(5000 برگردان صحیح۶۴)
    واکنشی.جلو بردن زمان(250 برگردان صحیح۶۴)
    سرچاپ "clock"، واکنشی.اکنون()
    seen := واکنشی.صحیح۶۴ تازه(0 برگردان صحیح۶۴)
    seen.پیوند((): برگشت واکنشی.اکنون() / 1000 پایان)
    سرچاپ "seconds"، seen.بخوان()
    واکنشی.جلو بردن زمان(1000 برگردان صحیح۶۴)
    سرچاپ "seconds after a tick"، seen.بخوان()
    seen.آزاد کن()
پایان

تابع check_int_and_delay():
    واکنشی.تنظیم زمان(10000 برگردان صحیح۶۴)
    count = واکنشی.صحیح تازه(0)
    count.پویانمایی(واکنشی.پویانمایی‌ویژگی { مدت = 400، درنگ = 100، نرمش = واکنشی.نرمش پله ای(4، واکنشی.جای‌پله.پرش انتها) })
    count.بنشان(8)
    تکرار 0 تا 600 هر 100 در ms:
        واکنشی.تنظیم زمان(10000 برگردان صحیح۶۴ + (ms برگردان صحیح۶۴))
        سرچاپ "count at"، ms، count.بخوان()
    پایان
پایان

تابع check_color():
    واکنشی.تنظیم زمان(20000 برگردان صحیح۶۴)
    tint = واکنشی.صحیح تازه(0xFF000000 برگردان صحیح)
    tint.پویانمایی(واکنشی.پویانمایی‌ویژگی { مدت = 200، رنگی = درست })
    tint.بنشان(0x80FF8040 برگردان صحیح)
    تکرار 0 تا 200 هر 100 در ms:
        واکنشی.تنظیم زمان(20000 برگردان صحیح۶۴ + (ms برگردان صحیح۶۴))
        سرچاپ "tint at"، ms، (tint.بخوان() برگردان صحیح۶۴) & 0xFFFFFFFF
    پایان
پایان

تابع check_bound_target():
    واکنشی.تنظیم زمان(30000 برگردان صحیح۶۴)
    hover = واکنشی.منطقی تازه(نادرست)
    glow = واکنشی.اعشاری تازه(0.0)
    glow.پیوند((): برگشت hover.بخوان() ? 1.0 : 0.0 پایان)
    glow.پویانمایی(واکنشی.پویانمایی‌ویژگی { مدت = 100 })
    سرچاپ "glow"، glow.بخوان()، "has binding"، glow.پیوند دارد()
    hover.بنشان(درست)
    واکنشی.تنظیم زمان(30050 برگردان صحیح۶۴)
    سرچاپ "glow half way"، r4(glow.بخوان())
    واکنشی.تنظیم زمان(30200 برگردان صحیح۶۴)
    سرچاپ "glow done"، glow.بخوان()، "running"، واکنشی.پویانمایی جاری()
    glow.بنشان(0.25)
    واکنشی.تنظیم زمان(30250 برگردان صحیح۶۴)
    سرچاپ "set on an animated binding"، r4(glow.بخوان())، "binding replaced"، glow.پیوند دارد()
    hover.بنشان(نادرست)
    واکنشی.تنظیم زمان(30400 برگردان صحیح۶۴)
    سرچاپ "hover no longer drives it"، glow.بخوان()
پایان

تابع ریشه:
    check_easings()
    check_animation()
    check_clock()
    check_int_and_delay()
    check_color()
    check_bound_target()
    left.آزاد کن()
    doubled.آزاد کن()
    count.آزاد کن()
    tint.آزاد کن()
    hover.آزاد کن()
    glow.آزاد کن()
    سرچاپ "running at the end"، واکنشی.شمار پویانمایی ها()
    واکنشی.بازنشانی()
پایان
