بسته ریشه

واردسازی رابط گرافیکی.واکنشی
واردسازی حافظه

ناپایا width := واکنشی.ویژگی‌صحیح {}
ناپایا height := واکنشی.ویژگی‌صحیح {}
ناپایا area := واکنشی.ویژگی‌صحیح {}
ناپایا label := واکنشی.ویژگی‌متنی {}
ناپایا use_width := واکنشی.ویژگی‌منطقی {}
ناپایا pick := واکنشی.ویژگی‌صحیح {}
ناپایا runs := 0
ناپایا fixed := واکنشی.ویژگی‌صحیح {}
ناپایا watched := واکنشی.ویژگی‌صحیح {}

تابع show_error(label: رشته):
    e := واکنشی.آخرین خطا()
    سرچاپ label، e
    حافظه.آزادسازی(e برگردان تهی*)
پایان

تابع check_tracking():
    width = واکنشی.صحیح تازه(3).نام بده("width")
    height = واکنشی.صحیح تازه(4).نام بده("height")
    area = واکنشی.صحیح تازه(0).نام بده("area")
    area.پیوند((): برگشت width.بخوان() * height.بخوان() پایان)
    label = واکنشی.متن تازه("").نام بده("label")
    label.پیوند((): برگشت "area " + area.بخوان() پایان)
    سرچاپ "area"، area.بخوان()، label.بخوان()
    width.بنشان(10)
    سرچاپ "area dirty"، area.کهنه است()، "label dirty"، label.کهنه است()
    سرچاپ "area"، area.بخوان()، label.بخوان()
    height.بنشان(4)
    سرچاپ "same value keeps area clean"، area.کهنه است()
پایان

تابع check_laziness():
    before := واکنشی.شمار ارزیابی()
    width.بنشان(1)
    width.بنشان(2)
    width.بنشان(3)
    سرچاپ "evaluations after three sets"، واکنشی.شمار ارزیابی() - before
    سرچاپ "area"، area.بخوان()
    سرچاپ "evaluations after one read"، واکنشی.شمار ارزیابی() - before
    سرچاپ "area again"، area.بخوان()
    سرچاپ "evaluations after a second read"، واکنشی.شمار ارزیابی() - before
پایان

تابع check_propagation():
    سرچاپ "label before"، label.بخوان()
    marks := واکنشی.شمار نشانه گذاری()
    width.بنشان(5)
    first := واکنشی.شمار نشانه گذاری() - marks
    width.بنشان(6)
    second := واکنشی.شمار نشانه گذاری() - marks - first
    سرچاپ "marks on the first set"، first
    سرچاپ "marks on the second set"، second
    سرچاپ "label"، label.بخوان()
پایان

تابع check_conditional():
    use_width = واکنشی.منطقی تازه(درست).نام بده("use width")
    pick = واکنشی.صحیح تازه(0).نام بده("pick")
    pick.پیوند(():
        runs++
        اگر use_width.بخوان():
            برگشت width.بخوان()
        پایان
        برگشت height.بخوان()
    پایان)
    سرچاپ "pick"، pick.بخوان()
    use_width.بنشان(نادرست)
    سرچاپ "pick"، pick.بخوان()
    width.بنشان(99)
    سرچاپ "width no longer read, pick dirty"، pick.کهنه است()
    height.بنشان(7)
    سرچاپ "height read now, pick dirty"، pick.کهنه است()، pick.بخوان()
پایان

تابع check_set_removes_binding():
    سرچاپ "area has binding"، area.پیوند دارد()
    area.بنشان(1000)
    سرچاپ "area has binding"، area.پیوند دارد()، "area"، area.بخوان()
    width.بنشان(2)
    سرچاپ "area after width change"، area.بخوان()، "label"، label.بخوان()
    area.پیوند((): برگشت width.بخوان() + 1 پایان)
    سرچاپ "rebound area"، area.بخوان()، "label"، label.بخوان()
پایان

تابع check_constants():
    fixed = واکنشی.صحیح ثابت(42)
    s := واکنشی.متن ثابت("fixed")
    nodes := واکنشی.گره های زنده()
    edges := واکنشی.یال های زنده()
    doubled := واکنشی.صحیح تازه(0)
    doubled.پیوند((): برگشت fixed.بخوان() * 2 پایان)
    سرچاپ "constant"، fixed.بخوان()، s.بخوان()، "doubled"، doubled.بخوان()
    سرچاپ "nodes added"، واکنشی.گره های زنده() - nodes
    سرچاپ "edges added by reading a constant"، واکنشی.یال های زنده() - edges
    fixed.بنشان(1)
    show_error("error")
    doubled.آزاد کن()
پایان

تابع check_peek():
    watched = واکنشی.صحیح تازه(1)
    p := واکنشی.صحیح تازه(0)
    p.پیوند((): برگشت watched.نگاه() + 100 پایان)
    سرچاپ "peek"، p.بخوان()
    watched.بنشان(2)
    سرچاپ "untracked read leaves p clean"، p.کهنه است()، p.بخوان()
    watched.آزاد کن()
    p.آزاد کن()
پایان

تابع ریشه:
    واکنشی.چاپ خطاها(نادرست)
    check_tracking()
    check_laziness()
    check_propagation()
    check_conditional()
    check_set_removes_binding()
    check_constants()
    check_peek()
    سرچاپ "binding runs of pick"، runs
    واکنشی.بازنشانی()
    سرچاپ "nodes after reset"، واکنشی.گره های زنده()
پایان
