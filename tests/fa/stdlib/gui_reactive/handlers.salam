بسته ریشه

واردسازی رابط گرافیکی.واکنشی

ناپایا x := واکنشی.ویژگی‌صحیح {}
ناپایا y := واکنشی.ویژگی‌صحیح {}
ناپایا sum := واکنشی.ویژگی‌صحیح {}
ناپایا title := واکنشی.ویژگی‌متنی {}
ناپایا redraws := 0
ناپایا paints := 0
ناپایا sum_calls := 0
ناپایا title_calls := 0
ناپایا seen := 0
ناپایا first := واکنشی.ویژگی‌صحیح {}
ناپایا second := واکنشی.ویژگی‌صحیح {}

تابع paint():
    paints++
    seen = sum.بخوان()
پایان

تابع check_tracker():
    x = واکنشی.صحیح تازه(1).نام بده("x")
    y = واکنشی.صحیح تازه(2).نام بده("y")
    sum = واکنشی.صحیح تازه(0).نام بده("sum")
    sum.پیوند((): برگشت x.بخوان() + y.بخوان() پایان)
    t := واکنشی.ردیابی((): paint() پایان، (): redraws++ پایان)
    سرچاپ "painted"، paints، "seen"، seen، "redraws"، redraws
    x.بنشان(10)
    y.بنشان(20)
    سرچاپ "after two sets: dirty"، t.کهنه است()، "redraws"، redraws، "paints"، paints
    سرچاپ "refresh ran"، t.تازه کن()، "seen"، seen، "paints"، paints
    سرچاپ "refresh again ran"، t.تازه کن()
    x.بنشان(11)
    سرچاپ "redraws"، redraws، "dirty"، t.کهنه است()
    t.آزاد کن()
    x.بنشان(12)
    سرچاپ "freed tracker gets no call"، redraws
    plain := واکنشی.ردیابی((): seen = y.بخوان() پایان)
    y.بنشان(21)
    سرچاپ "tracker without callback dirty"، plain.کهنه است()، plain.تازه کن()، seen
    plain.آزاد کن()
پایان

تابع check_handlers():
    title = واکنشی.متن تازه("a")
    h1 := واکنشی.هنگام تغییر(sum، (): sum_calls++ پایان)
    h2 := واکنشی.هنگام تغییر(title، ():
        title_calls++
        سرچاپ "  title is now"، title.بخوان()
    پایان)
    x.بنشان(100)
    y.بنشان(200)
    x.بنشان(101)
    سرچاپ "calls before running"، sum_calls، "pending"، واکنشی.کنترل‌کننده های منتظر()
    سرچاپ "handlers run"، واکنشی.اجرای کنترل‌کننده ها()، "sum calls"، sum_calls
    سرچاپ "nothing pending"، واکنشی.اجرای کنترل‌کننده ها()
    x.بنشان(101)
    سرچاپ "same value runs nothing"، واکنشی.اجرای کنترل‌کننده ها()
    x.بنشان(50)
    y.بنشان(251)
    سرچاپ "bound value unchanged"، sum.بخوان()، "runs"، واکنشی.اجرای کنترل‌کننده ها()، "sum calls"، sum_calls
    title.بنشان("b")
    title.بنشان("c")
    سرچاپ "two sets, one call"، واکنشی.اجرای کنترل‌کننده ها()، title_calls
    h1.آزاد کن()
    h2.آزاد کن()
پایان

تابع check_chain():
    first = واکنشی.صحیح تازه(0)
    second = واکنشی.صحیح تازه(0)
    h := واکنشی.هنگام تغییر(first، (): second.بنشان(first.بخوان() * 2) پایان)
    h2 := واکنشی.هنگام تغییر(second، (): سرچاپ "  second is"، second.بخوان() پایان)
    first.بنشان(4)
    سرچاپ "chained handler runs"، واکنشی.اجرای کنترل‌کننده ها()
    h.آزاد کن()
    h2.آزاد کن()
    first.آزاد کن()
    second.آزاد کن()
پایان

تابع check_batch():
    t := واکنشی.ردیابی((): seen = x.بخوان() + y.بخوان() پایان، ():
        redraws++
        سرچاپ "  redraw requested, in batch"، واکنشی.داخل دسته()
    پایان)
    before := redraws
    واکنشی.آغاز دسته()
    x.بنشان(1)
    y.بنشان(2)
    سرچاپ "inside the batch the callback waits"، redraws - before
    واکنشی.اتمام دسته()
    سرچاپ "after the batch"، redraws - before
    _r := t.تازه کن()
    واکنشی.دسته(():
        x.بنشان(3)
        y.بنشان(4)
        x.بنشان(5)
    پایان)
    سرچاپ "batch helper"، redraws - before، "seen before refresh"، seen
    _r2 := t.تازه کن()
    سرچاپ "seen after refresh"، seen
    t.آزاد کن()
پایان

تابع ریشه:
    check_tracker()
    check_handlers()
    check_chain()
    check_batch()
    x.آزاد کن()
    y.آزاد کن()
    sum.آزاد کن()
    title.آزاد کن()
    سرچاپ "nodes left"، واکنشی.گره های زنده()، "edges left"، واکنشی.یال های زنده()
    واکنشی.بازنشانی()
پایان
