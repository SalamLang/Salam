بسته ریشه

واردسازی رابط گرافیکی.واکنشی
واردسازی حافظه

ناپایا a := واکنشی.ویژگی‌صحیح {}
ناپایا b := واکنشی.ویژگی‌صحیح {}
ناپایا c := واکنشی.ویژگی‌صحیح {}
ناپایا self_ref := واکنشی.ویژگی‌اعشاری {}
ناپایا counter := واکنشی.ویژگی‌صحیح {}

تابع show_error(label: رشته):
    e := واکنشی.آخرین خطا()
    سرچاپ label، e
    حافظه.آزادسازی(e برگردان تهی*)
پایان

تابع check_cycle():
    a = واکنشی.صحیح تازه(1).نام بده("width")
    b = واکنشی.صحیح تازه(0).نام بده("min width")
    c = واکنشی.صحیح تازه(0).نام بده("preferred width")
    b.پیوند((): برگشت c.بخوان() + 1 پایان)
    c.پیوند((): برگشت a.بخوان() + b.بخوان() پایان)
    سرچاپ "value with the loop cut"، b.بخوان()
    سرچاپ "errors"، واکنشی.شمار خطاها()
    show_error("last error")
    a.بنشان(5)
    سرچاپ "still answers"، c.بخوان()، "errors"، واکنشی.شمار خطاها()
    c.پیوند((): برگشت a.بخوان() * 2 پایان)
    سرچاپ "loop removed"، b.بخوان()، c.بخوان()، "errors"، واکنشی.شمار خطاها()
پایان

تابع check_self():
    self_ref = واکنشی.اعشاری تازه(1.5)
    self_ref.پیوند((): برگشت self_ref.بخوان() + 1.0 پایان)
    سرچاپ "self reference"، self_ref.بخوان()
    show_error("last error")
پایان

تابع check_set_inside():
    counter = واکنشی.صحیح تازه(0).نام بده("counter")
    counter.پیوند(():
        counter.بنشان(7)
        برگشت 3
    پایان)
    سرچاپ "set inside its binding"، counter.بخوان()
    show_error("last error")
    counter.آزاد کن()
پایان

تابع ریشه:
    واکنشی.چاپ خطاها(نادرست)
    check_cycle()
    check_self()
    check_set_inside()
    a.آزاد کن()
    b.آزاد کن()
    c.آزاد کن()
    self_ref.آزاد کن()
    واکنشی.بازنشانی()
پایان
