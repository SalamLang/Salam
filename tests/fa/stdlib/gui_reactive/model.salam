بسته ریشه

واردسازی رابط گرافیکی.واکنشی

ناپایا todos := واکنشی.مدل‌فهرست {} برگردان واکنشی.مدل‌فهرست<Todo>
ناپایا summary := واکنشی.ویژگی‌متنی {}
ناپایا first_title := واکنشی.ویژگی‌متنی {}
ناپایا origin := واکنشی.ویژگی {} برگردان واکنشی.ویژگی<Point>
ناپایا offset := واکنشی.ویژگی‌صحیح {}
ناپایا moved := واکنشی.ویژگی {} برگردان واکنشی.ویژگی<Point>
ناپایا events := 0

ساختار Todo:
    همگانی title: رشته = ""
    همگانی done: منطقی = نادرست
پایان

ساختار Point:
    همگانی x: صحیح = 0
    همگانی y: صحیح = 0
پایان

تابع describe(ev: واکنشی.رویداد‌مدل):
    events++
    ناپایا name := "reset"
    اگر ev.گونه برابر واکنشی.تغییر‌مدل.سطر تغییر کرد:
        name = "row changed"
    وگرنه ev.گونه برابر واکنشی.تغییر‌مدل.سطرها افزوده شد:
        name = "rows inserted"
    وگرنه ev.گونه برابر واکنشی.تغییر‌مدل.سطرها حذف شد:
        name = "rows removed"
    پایان
    سرچاپ "  event"، name، "at"، ev.شماره، "count"، ev.شمار
پایان

تابع count_done(): صحیح:
    ناپایا n := 0
    تکرار todos.طول() در i:
        اگر todos.بخوان(i).done:
            n++
        پایان
    پایان
    برگشت n
پایان

تابع check_model():
    todos = واکنشی.مدل فهرست تازه() برگردان واکنشی.مدل‌فهرست<Todo>
    id := todos.گوش بده((ev: واکنشی.رویداد‌مدل): describe(ev) پایان)
    summary = واکنشی.متن تازه("")
    summary.پیوند((): برگشت "" + count_done() + " of " + todos.طول() + " done" پایان)
    first_title = واکنشی.متن تازه("")
    first_title.پیوند رونوشتی((): برگشت todos.طول() بزرگتر 0 ? todos.بخوان(0).title : "none" پایان)
    سرچاپ summary.بخوان()، "|"، first_title.بخوان()
    todos.بیفزا(Todo { title = "write tests" })
    todos.بیفزا(Todo { title = "write docs" })
    todos.درج کن(0، Todo { title = "read the study"، done = درست })
    سرچاپ summary.بخوان()، "|"، first_title.بخوان()
    todos.بنشان(1، Todo { title = "write tests"، done = درست })
    سرچاپ summary.بخوان()
    todos.حذف کن(0، 2)
    سرچاپ summary.بخوان()، "|"، first_title.بخوان()
    ناپایا fresh := وکتور {} برگردان وکتور<Todo>
    fresh.بیفزا(Todo { title = "a" })
    fresh.بیفزا(Todo { title = "b"، done = درست })
    todos.جایگزین کن(fresh)
    fresh.آزادکن()
    سرچاپ summary.بخوان()، "|"، first_title.بخوان()
    h := todos.هنگام تغییر((): سرچاپ "  model handler ran" پایان)
    todos.بنشان(0، Todo { title = "a"، done = درست })
    todos.بیفزا(Todo { title = "c" })
    سرچاپ "handlers run"، واکنشی.اجرای کنترل‌کننده ها()
    todos.گوش نده(id)
    todos.پاک کن()
    سرچاپ summary.بخوان()، "|"، first_title.بخوان()، "| events"، events
    h.آزاد کن()
پایان

تابع check_generic():
    origin = واکنشی.ویژگی تازه(Point { x = 1، y = 2 }).نام بده("origin")
    offset = واکنشی.صحیح تازه(10)
    moved = واکنشی.ویژگی تازه(Point {})
    moved.پیوند(():
        o := origin.بخوان()
        برگشت Point { x = o.x + offset.بخوان()، y = o.y }
    پایان)
    سرچاپ "moved"، moved.بخوان()
    offset.بنشان(20)
    سرچاپ "moved"، moved.بخوان()
    origin.بنشان(Point { x = 5، y = 6 })
    سرچاپ "moved"، moved.بخوان()، "bound"، moved.پیوند دارد()
    h := moved.هنگام تغییر((): سرچاپ "  moved changed" پایان)
    offset.بنشان(30)
    سرچاپ "handlers run"، واکنشی.اجرای کنترل‌کننده ها()
    moved.بنشان(Point { x = 0، y = 0 })
    سرچاپ "set drops the binding"، moved.پیوند دارد()، moved.بخوان()
    h.آزاد کن()
پایان

تابع ریشه:
    check_model()
    check_generic()
    todos.آزاد کن()
    summary.آزاد کن()
    first_title.آزاد کن()
    origin.آزاد کن()
    offset.آزاد کن()
    moved.آزاد کن()
    سرچاپ "nodes left"، واکنشی.گره های زنده()، "edges left"، واکنشی.یال های زنده()
    واکنشی.بازنشانی()
پایان
