بسته ریشه

واردسازی رابط گرافیکی.واکنشی
واردسازی حافظه

ناپایا text := واکنشی.ویژگی‌متنی {}
ناپایا field := واکنشی.ویژگی‌متنی {}
ناپایا shout := واکنشی.ویژگی‌متنی {}
ناپایا slider := واکنشی.ویژگی‌اعشاری {}
ناپایا spin := واکنشی.ویژگی‌اعشاری {}
ناپایا knob := واکنشی.ویژگی‌اعشاری {}
ناپایا base := واکنشی.ویژگی‌اعشاری {}

تابع show_error(label: رشته):
    e := واکنشی.آخرین خطا()
    سرچاپ label، e
    حافظه.آزادسازی(e برگردان تهی*)
پایان

تابع check_strings():
    text = واکنشی.متن تازه("hello").نام بده("model text")
    field = واکنشی.متن تازه("").نام بده("input field")
    واکنشی.همبند کن(text، field)
    سرچاپ "linked"، text.بخوان()، field.بخوان()
    shout = واکنشی.متن تازه("")
    shout.پیوند((): برگشت field.بخوان() + "!" پایان)
    سرچاپ "shout"، shout.بخوان()
    field.بنشان("typed")
    سرچاپ "after typing"، text.بخوان()، field.بخوان()، shout.بخوان()
    text.بنشان("reset")
    سرچاپ "after model set"، text.بخوان()، field.بخوان()، shout.بخوان()
    سرچاپ "field keeps its two-way binding"، field.پیوند دارد()
پایان

تابع check_three_way():
    slider = واکنشی.اعشاری تازه(0.5)
    spin = واکنشی.اعشاری تازه(0.0)
    knob = واکنشی.اعشاری تازه(0.0)
    واکنشی.همبند کن(slider، spin)
    واکنشی.همبند کن(spin، knob)
    سرچاپ "three way"، slider.بخوان()، spin.بخوان()، knob.بخوان()
    knob.بنشان(0.75)
    سرچاپ "knob set"، slider.بخوان()، spin.بخوان()، knob.بخوان()
    spin.جدا کن()
    spin.بنشان(0.1)
    سرچاپ "after unlink"، slider.بخوان()، spin.بخوان()، knob.بخوان()
    slider.بنشان(0.2)
    سرچاپ "slider set"، slider.بخوان()، spin.بخوان()، knob.بخوان()
پایان

تابع check_bound_group():
    base = واکنشی.اعشاری تازه(2.0)
    a := واکنشی.اعشاری تازه(0.0)
    b := واکنشی.اعشاری تازه(0.0)
    a.پیوند((): برگشت base.بخوان() * 10.0 پایان)
    واکنشی.همبند کن(a، b)
    سرچاپ "group follows the binding"، a.بخوان()، b.بخوان()
    base.بنشان(3.0)
    سرچاپ "base changed"، a.بخوان()، b.بخوان()
    b.بنشان(1.5)
    سرچاپ "set replaces the group binding"، a.بخوان()، b.بخوان()
    base.بنشان(4.0)
    سرچاپ "base no longer drives it"، a.بخوان()، b.بخوان()
    a.پیوند((): برگشت base.بخوان() + 0.5 پایان)
    سرچاپ "bind on a member binds the group"، a.بخوان()، b.بخوان()
    a.آزاد کن()
    b.آزاد کن()
پایان

تابع check_mismatch():
    i := واکنشی.صحیح تازه(1)
    c := واکنشی.صحیح ثابت(2)
    واکنشی.همبند کن(i، c)
    show_error("error")
    i.آزاد کن()
پایان

تابع ریشه:
    واکنشی.چاپ خطاها(نادرست)
    check_strings()
    check_three_way()
    check_bound_group()
    check_mismatch()
    text.آزاد کن()
    field.آزاد کن()
    shout.آزاد کن()
    slider.آزاد کن()
    spin.آزاد کن()
    knob.آزاد کن()
    base.آزاد کن()
    سرچاپ "nodes left"، واکنشی.گره های زنده()، "edges left"، واکنشی.یال های زنده()
    واکنشی.بازنشانی()
پایان
