واردسازی رابط گرافیکی.سبک

تابع check(name: رشته، text: رشته):
    p := سبک.ویژگی با نام(name)
    ناپایا v := سبک.مقدار {}
    اگر وارونه سبک.تجزیه(p، text، v):
        سرچاپ name، "REJECTED"، text
        برگشت
    پایان
    f := سبک.قالب(p، v)
    ناپایا w := سبک.مقدار {}
    again := سبک.تجزیه(p، f، w) و سبک.سی اس اس(p، v) برابر سبک.سی اس اس(p، w) و سبک.قالب(p، w) برابر f
    سرچاپ name، "|"، text، "|"، f، "|"، سبک.سی اس اس(p، v)، "|"، again ? "round trip" : "DIFFERS"
پایان

تابع ریشه:
    check("border"، "1, solid, red")
    check("border"، "red, 1, solid")
    check("border"، "solid, red, 1")
    check("border"، "dashed, 2, #3366aa")
