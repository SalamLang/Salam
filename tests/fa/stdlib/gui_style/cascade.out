-- defaults that differ from a box
box: same as box
page: min height = 100vh; background = #ffffff
h1: layout = flow; margin = 0.5em, 0, 0.5em, 0; font size = 2em; font weight = 700; line height = 1.25
h2: layout = flow; margin = 0.5em, 0, 0.5em, 0; font size = 1.5em; font weight = 700; line height = 1.25
h3: layout = flow; margin = 0.5em, 0, 0.5em, 0; font size = 1.25em; font weight = 700; line height = 1.25
h4: layout = flow; margin = 0.5em, 0, 0.5em, 0; font size = 1em; font weight = 700; line height = 1.25
h5: layout = flow; margin = 0.5em, 0, 0.5em, 0; font size = 0.875em; font weight = 700; line height = 1.25
h6: layout = flow; margin = 0.5em, 0, 0.5em, 0; font size = 0.75em; font weight = 700; line height = 1.25
paragraph: layout = flow; margin = 0.5em, 0, 0.5em, 0
span: layout = flow
bold: layout = flow; font weight = 700
italic: layout = flow; italic = true
code: layout = flow; font = mono; font size = 0.875em
preformatted: layout = flow; margin = 0.5em, 0, 0.5em, 0; font = mono; font size = 0.875em; wrap text = false; white space = keep
link: layout = flow; cursor = pointer; color = #1a73e8; decoration = underline
small: layout = flow; font size = 0.833em
subscript: layout = flow; font size = 0.75em
mark: layout = flow; background = #ffff00
deleted: layout = flow; decoration = strike
inserted: layout = flow; decoration = underline
abbreviation: layout = flow; decoration = underline; decoration style = dotted
button: layout = row; align = center; justify = center; padding = 4, 12, 4, 12; background = #f0f0f0; border = 1, #8f8f9d; border width = 1, 1, 1, 1; border color = #8f8f9d, #8f8f9d, #8f8f9d, #8f8f9d; radius = 4, 4, 4, 4; cursor = pointer; selectable = false
input: width = 12em; padding = 4, 8, 4, 8; background = #ffffff; border = 1, #8f8f9d; border width = 1, 1, 1, 1; border color = #8f8f9d, #8f8f9d, #8f8f9d, #8f8f9d; radius = 4, 4, 4, 4; cursor = text
text area: width = 20em; height = 5em; padding = 4, 8, 4, 8; background = #ffffff; border = 1, #8f8f9d; border width = 1, 1, 1, 1; border color = #8f8f9d, #8f8f9d, #8f8f9d, #8f8f9d; radius = 4, 4, 4, 4; cursor = text; white space = keep
select: padding = 4, 8, 4, 8; background = #ffffff; border = 1, #8f8f9d; border width = 1, 1, 1, 1; border color = #8f8f9d, #8f8f9d, #8f8f9d, #8f8f9d; radius = 4, 4, 4, 4; cursor = pointer
checkbox: width = 16; height = 16; cursor = pointer
radio: width = 16; height = 16; cursor = pointer
image: layout = flow
video: layout = flow
list: padding = 0, 0, 0, 2em; margin = 0.5em, 0, 0.5em, 0
ordered list: padding = 0, 0, 0, 2em; margin = 0.5em, 0, 0.5em, 0
item: layout = flow
table: same as box
row: layout = row
cell: layout = flow; grow = 1; basis = 0; padding = 2, 4, 2, 4
header cell: layout = flow; grow = 1; basis = 0; padding = 2, 4, 2, 4; font weight = 700; text align = center
caption: layout = flow; margin = 0.5em, 0, 0.5em, 0; text align = center
line: margin = 0.5em, 0, 0.5em, 0; border = 1, #8f8f9d; border width = 1, 0, 0, 0; border color = #8f8f9d, current, current, current
form: same as box
label: layout = flow
nav: same as box
header: same as box
footer: same as box
section: same as box
article: same as box
block quote: margin = 0.5em, 2em, 0.5em, 2em
field set: padding = 8, 12, 8, 12; border = 1, #8f8f9d; border width = 1, 1, 1, 1; border color = #8f8f9d, #8f8f9d, #8f8f9d, #8f8f9d
progress: width = 10em; height = 1em
پاراگراف: layout = flow; margin = 0.5em, 0, 0.5em, 0
دکمه: layout = row; align = center; justify = center; padding = 4, 12, 4, 12; background = #f0f0f0; border = 1, #8f8f9d; border width = 1, 1, 1, 1; border color = #8f8f9d, #8f8f9d, #8f8f9d, #8f8f9d; radius = 4, 4, 4, 4; cursor = pointer; selectable = false
p: layout = flow; margin = 0.5em, 0, 0.5em, 0
unknown thing: same as box
