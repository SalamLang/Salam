واردسازی رابط گرافیکی.سبک

تابع side_prop(name: رشته): منطقی:
    هر pre در ["padding "، "margin "، "border top"، "border bottom"، "border start"، "border end"، "border left"، "border right"، "radius "]:
        اگر name.طول() بزرگتر pre.طول() و name.زیررشته(0، pre.طول()) برابر pre:
            برگشت درست
        پایان
        اگر name برابر pre:
            برگشت درست
        پایان
    پایان
    برگشت نادرست
پایان

تابع show(s: سبک.ظاهر، names: رشته[]):
    هر n در names:
        p := سبک.ویژگی با نام(n)
        سرچاپ "   "، n، "="، سبک.قالب(p، سبک.بگیر(s، p))
    پایان
پایان

تابع set(s &: سبک.ظاهر، name: رشته، text: رشته):
    p := سبک.ویژگی با نام(name)
    ناپایا v := سبک.مقدار {}
    اگر وارونه سبک.تجزیه(p، text، v):
        سرچاپ "bad"، name، text
        برگشت
    پایان
    سبک.بگذار(s، p، v)
پایان

تابع ریشه:
    box := سبک.ظاهر {}
    سرچاپ "-- defaults that differ from a box"
    هر el در ["box"، "page"، "h1"، "h2"، "h3"، "h4"، "h5"، "h6"، "paragraph"، "span"، "bold"، "italic"، "code"، "preformatted"، "link"، "small"، "subscript"، "mark"، "deleted"، "inserted"، "abbreviation"، "button"، "input"، "text area"، "select"، "checkbox"، "radio"، "image"، "video"، "list"، "ordered list"، "item"، "table"، "row"، "cell"، "header cell"، "caption"، "line"، "form"، "label"، "nav"، "header"، "footer"، "section"، "article"، "block quote"، "field set"، "progress"، "پاراگراف"، "دکمه"، "p"، "unknown thing"]:
        s := سبک.پیش فرض(el)
        ناپایا diff := ""
        تکرار سبک.شمار‌ویژگی‌ها در p:
            a := سبک.قالب(p، سبک.بگیر(s، p))
            اگر وارونه side_prop(سبک.نام ویژگی(p)) و a نابرابر سبک.قالب(p، سبک.بگیر(box، p)):
                diff += "; " + سبک.نام ویژگی(p) + " = " + a
            پایان
        پایان
        سرچاپ el + ":" + (diff برابر "" ? " same as box" : diff.زیررشته(1، diff.طول() - 1))
    پایان
    سرچاپ "-- every example set then read back"
    تکرار سبک.شمار‌ویژگی‌ها در p:
        ناپایا s := سبک.ظاهر {}
        info := سبک.اطلاعات(p)
        ناپایا v := سبک.مقدار {}
        _ok := سبک.تجزیه(p، info.نمونه، v)
        سبک.بگذار(s، p، v)
        سرچاپ "  "، info.نام، "="، info.نمونه، "->"، سبک.قالب(p، سبک.بگیر(s، p))
    پایان
    سرچاپ "-- shorthands and sides"
    ناپایا s := سبک.ظاهر {}
    set(s، "padding"، "1, 2, 3, 4")
    set(s، "padding x"، "10")
    show(s، ["padding"، "padding start"، "padding end"، "padding left"، "padding right"])
    set(s، "direction"، "rtl")
    set(s، "padding left"، "7")
    set(s، "margin right"، "auto")
    set(s، "border left"، "3, dashed, red")
    show(s، ["padding"، "padding left"، "margin"، "border start"، "border end"، "border right"])
    set(s، "border"، "1, solid, blue")
    set(s، "border top"، "4, double, green")
    show(s، ["border top"، "border bottom"، "border width"، "border color"])
    set(s، "radius"، "8, 2")
    show(s، ["radius"، "radius bottom end"])
    set(s، "overflow"، "hidden")
    set(s، "overflow y"، "scroll")
    show(s، ["overflow"، "overflow x"])
    set(s، "background position"، "bottom")
    set(s، "origin"، "top")
    set(s، "scale"، "2")
    set(s، "translate"، "5")
    show(s، ["background position"، "origin"، "scale"، "translate"])
    سرچاپ "-- typed fields"
    ناپایا t := سبک.ظاهر {}
    set(t، "layout"، "row")
    set(t، "gap"، "8")
    set(t، "width"، "100% - 20")
    set(t، "font weight"، "bold")
    set(t، "line height"، "20px")
    set(t، "transition"، "[200, ease out], [1s, linear, 50]")
    set(t، "transition properties"، "opacity, color")
    set(t، "font"، "\"Vazirmatn\", sans")
    set(t، "shadow"، "0, 2, 4, black")
    set(t، "background"، "linear(90, red, blue), white")
    set(t، "columns"، "repeat(2, 1fr), 100")
    سرچاپ t.چیدمان برابر سبک.واژه‌ردیف، t.شکاف ردیف.پیکسل، t.شکاف ستون.پیکسل، t.عرض.طول.درصد، t.عرض.طول.پیکسل، t.وزن قلم
    سرچاپ t.ارتفاع خط، t.طول ارتفاع خط.پیکسل، t.گذار.طول()، t.گذار.بگیر(1).مدت، t.گذار.بگیر(1).تاخیر، t.گذار.بگیر(0).نرمش.گونه برابر سبک.نرمش‌انتها
    سرچاپ t.ویژگی‌های گذار.طول()، t.ویژگی‌های گذار.بگیر(0) برابر سبک.ویژگی‌شفافیت، t.قلم.بگیر(0)، t.قلم.بگیر(1)
    سرچاپ t.سایه.طول()، t.سایه.بگیر(0).تاری.پیکسل، t.پس‌زمینه.طول()، t.پس‌زمینه.بگیر(0).گونه برابر سبک.رنگ‌آمیزی‌خطی، t.پس‌زمینه.بگیر(1).گونه برابر سبک.رنگ‌آمیزی‌رنگ
    سرچاپ t.ستون‌ها.طول()، t.ستون‌ها.بگیر(0).گونه برابر سبک.شیار‌تکراری، t.ستون‌ها.بگیر(0).شمار، t.ستون‌ها.بگیر(0).گستره، t.ستون‌ها.بگیر(1).طول.سهم
    سرچاپ "-- inheritance"
    ناپایا parent := سبک.پیش فرض("page")
    set(parent، "color"، "#336699")
    set(parent، "font size"، "20")
    set(parent، "direction"، "rtl")
    set(parent، "padding"، "30")
    set(parent، "cursor"، "pointer")
    set(parent، "decoration"، "underline")
    ناپایا h := سبک.پیش فرض("h1")
    سبک.ارث بری(parent، h)
    show(h، ["color"، "font size"، "direction"، "padding"، "cursor"، "decoration"، "font weight"])
    ناپایا a := سبک.پیش فرض("link")
    سبک.ارث بری(parent، a)
    show(a، ["color"، "font size"، "cursor"])
    ناپایا p := سبک.پیش فرض("paragraph")
    سبک.ارث بری(parent، p)
    set(p، "color"، "black")
    show(p، ["color"، "font size"، "margin"])
    ناپایا inh := ""
    تکرار سبک.شمار‌ویژگی‌ها در i:
        اگر سبک.ارثی است(i):
            inh += " " + سبک.نام ویژگی(i) + ","
        پایان
    پایان
    سرچاپ "inherited:" + inh
پایان
