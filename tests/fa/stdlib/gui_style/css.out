layout = column
    display:var(--salam-o,block) flex;flex-direction:var(--salam-dir,column);--salam-rev:column-reverse
layout = row
    display:var(--salam-o,block) flex;flex-direction:var(--salam-dir,row);--salam-rev:row-reverse
layout = grid
    display:var(--salam-o,block) grid
layout = stack
    display:var(--salam-o,block) grid;grid-template:minmax(0,1fr)/minmax(0,1fr);justify-items:var(--salam-j,start);&>*{grid-area:1/1}
layout = flow
    display:var(--salam-o,block) var(--salam-fi,flow-root);&>*{--salam-o:inline}
reverse = true
    --salam-dir:var(--salam-rev)
visible = false
    display:none!important
clip = true
    overflow:clip
interactive = false
    pointer-events:none
width = fill
    width:-webkit-fill-available;width:-moz-available;width:stretch
width = fit
    width:fit-content
width = 100% - 20
    width:calc(100% - 20px)
width = 50% + 1em - 2
    width:calc(50% + 1em - 2px)
padding = 8
    padding:8px
padding = 8, 16
    padding-block:8px;padding-inline:16px
padding = 8, 16, 4
    padding-top:8px;padding-inline:16px;padding-bottom:4px
padding = 8, 16, 4, 2
    padding-top:8px;padding-inline-end:16px;padding-bottom:4px;padding-inline-start:2px
margin = 0, auto
    margin-block:0;margin-inline:auto
inset = 0
    inset:0
inset = 0, 10, 20, 30
    top:0;inset-inline-end:10px;bottom:20px;inset-inline-start:30px
radius = 8
    border-radius:8px
radius = 8, 0
    border-start-start-radius:8px;border-start-end-radius:0;border-end-end-radius:8px;border-end-start-radius:0
radius = 1, 2, 3, 4
    border-start-start-radius:1px;border-start-end-radius:2px;border-end-end-radius:3px;border-end-start-radius:4px
radius top start = 12
    border-start-start-radius:12px
border width = 1, 2, 3, 4
    border-top-width:1px;border-inline-end-width:2px;border-bottom-width:3px;border-inline-start-width:4px
border color = red, green, blue
    border-top-color:#ff0000;border-inline-color:#008000;border-bottom-color:#0000ff
border start = 2, dotted, #3366aa
    border-inline-start:2px dotted #3366aa
blur = 4
    --salam-f-blur:blur(4px);filter:var(--salam-f-blur,) var(--salam-f-brightness,) var(--salam-f-contrast,) var(--salam-f-grayscale,) var(--salam-f-saturate,) var(--salam-f-sepia,) var(--salam-f-invert,) var(--salam-f-hue-rotate,)
blur = 0
    --salam-f-blur:initial
backdrop blur = 12
    --salam-b-blur:blur(12px);-webkit-backdrop-filter:var(--salam-b-blur,) var(--salam-b-brightness,) var(--salam-b-contrast,) var(--salam-b-grayscale,) var(--salam-b-saturate,) var(--salam-b-sepia,) var(--salam-b-invert,) var(--salam-b-hue-rotate,);backdrop-filter:var(--salam-b-blur,) var(--salam-b-brightness,) var(--salam-b-contrast,) var(--salam-b-grayscale,) var(--salam-b-saturate,) var(--salam-b-sepia,) var(--salam-b-invert,) var(--salam-b-hue-rotate,)
grayscale = 50%
    --salam-f-grayscale:grayscale(0.5);filter:var(--salam-f-blur,) var(--salam-f-brightness,) var(--salam-f-contrast,) var(--salam-f-grayscale,) var(--salam-f-saturate,) var(--salam-f-sepia,) var(--salam-f-invert,) var(--salam-f-hue-rotate,)
translate = 10, -4
    translate:10px -4px
translate = 0
    translate:none
rotate = 0.5turn
    rotate:180deg
scale = 2, 0.5
    scale:2 0.5
skew = 10
    transform:skew(10deg)
origin = start, bottom
    transform-origin:var(--salam-start,left) bottom
justify = evenly
    justify-content:space-evenly;--salam-j:start
align = end
    align-items:flex-end
align self = start
    align-self:flex-start;vertical-align:top
columns = repeat(fill, minmax(120, 1fr))
    grid-template-columns:repeat(auto-fill,minmax(120px,1fr))
rows = auto, minmax(min content, 300), fit(50%)
    grid-template-rows:auto minmax(min-content,300px) fit-content(50%)
auto flow = column dense
    grid-auto-flow:column dense
column = -1
    grid-column:span var(--salam-cspan,1) / -1
row span = 2
    --salam-rspan:2
layer = 3
    z-index:3
background = red
    background-color:#ff0000;background-image:none
background = linear(to right, red, blue)
    background-color:transparent;background-image:linear-gradient(to right,#ff0000,#0000ff)
background = #00000080, image("photo.png")
    background-color:transparent;background-image:linear-gradient(#00000080,#00000080),url("photo.png")
background = radial(circle, [20%, 30%], white, black 80%)
    background-color:transparent;background-image:radial-gradient(circle at 20% 30%,#ffffff,#000000 80%)
background = conic(90, red, yellow, red)
    background-color:transparent;background-image:conic-gradient(from 90deg,#ff0000,#ffff00,#ff0000)
background = none
    background-color:transparent;background-image:none
background position = end, top
    background-position:var(--salam-end,right) top
background repeat = true
    background-repeat:repeat
shadow = [0, 4, 8, #00000040], [0, 0, 0, 1, red, inset]
    box-shadow:0 4px 8px 0 #00000040,inset 0 0 0 1px #ff0000
text shadow = 0, 1, 2, black
    text-shadow:0 1px 2px #000000
opacity = 75%
    opacity:0.75
cursor = resize x
    cursor:ew-resize
image fit = scale down
    object-fit:scale-down
font = "Vazirmatn", system
    font-family:"Vazirmatn",system-ui
font weight = medium
    font-weight:500
line height = 24px
    line-height:24px
decoration = strike
    text-decoration-line:line-through
transform text = capitalize
    text-transform:capitalize
white space = keep
    white-space-collapse:preserve
direction = ltr
    direction:ltr;--salam-bidi:isolate;--salam-start:left;--salam-end:right
ellipsis = true
    text-overflow:ellipsis;overflow:hidden;text-wrap-mode:nowrap
max lines = 3
    display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:3;line-clamp:3;overflow:hidden
max lines = none
    -webkit-line-clamp:none;line-clamp:none
selectable = false
    -webkit-user-select:none;user-select:none
transition = 200ms
    transition-duration:200ms;transition-timing-function:ease;transition-delay:0ms
transition = [200, ease(0.2, 0, 0, 1)], [1s, linear, 100]
    transition-duration:200ms,1000ms;transition-timing-function:cubic-bezier(0.2,0,0,1),linear;transition-delay:0ms,100ms
transition = 500, spring(200, 10)
    transition-duration:500ms;transition-timing-function:linear(0,0.1046,0.3558,0.661,0.9441,1.1556,1.2745,1.3045,1.2654,1.1853,1.0919,1.0076,0.9465,0.9137,0.9076,0.9216,0.947,0.9754,1.0004,1.018,1.027,1.0279,1.0231,1.0151,1.0065,0.9991,0.994,0.9916,0.9916,0.9932,0.9957,0.9983,1.0005,1.002,1.0026,1.0025,1.002,1.0012,1.0004,0.9998,1);transition-delay:0ms
transition properties = opacity, blur, radius
    transition-property:opacity,filter,border-radius
transition properties = all
    transition-property:gap,flex-grow,flex-shrink,flex-basis,top,bottom,inset-inline-start,inset-inline-end,left,right,inset,width,height,min-width,min-height,max-width,max-height,aspect-ratio,padding,margin,background-color,background-image,background-size,background-position,border-width,border-color,border-radius,outline-width,outline-color,outline-offset,box-shadow,opacity,filter,backdrop-filter,translate,rotate,scale,transform,transform-origin,accent-color,caret-color,scrollbar-color,color,font-size,font-weight,line-height,letter-spacing,word-spacing,text-decoration-color,text-decoration-thickness,text-shadow
-- base sheet
*,::before,::after{box-sizing:border-box;margin:0;padding:0;border:0 solid currentColor}
[hidden]{display:none!important}
:where(input,button,textarea,select){font:inherit;color:inherit;letter-spacing:inherit;word-spacing:inherit;line-height:inherit;text-align:inherit;text-transform:inherit}
:where(q)::before,:where(q)::after{content:none}
:where(table){border-collapse:collapse;border-spacing:0}
:where(:focus-visible){outline:2px solid var(--salam-accent,#1a73e8);outline-offset:2px}
:where(:not(head,head *,script,style,template,br,wbr,option,optgroup,datalist,area,source,track,param,noscript,svg *,math *)){--salam-o:block;--salam-fi:initial;--salam-cspan:initial;--salam-rspan:initial;--salam-dir:initial;--salam-rev:column-reverse;--salam-j:initial;unicode-bidi:var(--salam-bidi,plaintext);--salam-f-blur:initial;--salam-b-blur:initial;--salam-f-brightness:initial;--salam-b-brightness:initial;--salam-f-contrast:initial;--salam-b-contrast:initial;--salam-f-grayscale:initial;--salam-b-grayscale:initial;--salam-f-saturate:initial;--salam-b-saturate:initial;--salam-f-sepia:initial;--salam-b-sepia:initial;--salam-f-invert:initial;--salam-b-invert:initial;--salam-f-hue-rotate:initial;--salam-b-hue-rotate:initial;display:var(--salam-o,block) flex;flex-direction:var(--salam-dir,column);--salam-rev:column-reverse;gap:0 0;align-items:stretch;justify-content:flex-start;--salam-j:start;align-content:flex-start;flex-wrap:nowrap;--salam-dir:initial;grid-template-columns:none;grid-template-rows:none;grid-auto-columns:auto;grid-auto-rows:auto;grid-auto-flow:row;flex-grow:0;flex-shrink:1;flex-basis:auto;align-self:auto;vertical-align:baseline;justify-self:auto;grid-column:auto / span var(--salam-cspan,1);grid-row:auto / span var(--salam-rspan,1);--salam-cspan:1;--salam-rspan:1;order:0;position:relative;top:auto;inset-inline-end:auto;bottom:auto;inset-inline-start:auto;z-index:auto;width:auto;height:auto;min-width:auto;min-height:auto;max-width:none;max-height:none;aspect-ratio:auto;padding-top:0;padding-inline-end:0;padding-bottom:0;padding-inline-start:0;margin-top:0;margin-inline-end:0;margin-bottom:0;margin-inline-start:0;overflow:visible visible;background-color:#00000000;background-image:none;background-size:auto auto;background-position:var(--salam-start,left) top;background-repeat:no-repeat;border-top-width:0;border-inline-end-width:0;border-bottom-width:0;border-inline-start-width:0;border-top-color:currentColor;border-inline-end-color:currentColor;border-bottom-color:currentColor;border-inline-start-color:currentColor;border-start-start-radius:0;border-start-end-radius:0;border-end-end-radius:0;border-end-start-radius:0;outline-offset:0;box-shadow:none;opacity:1;mix-blend-mode:normal;translate:none;rotate:none;scale:none;transform:none;transform-origin:center center;object-fit:fill;scrollbar-width:auto;text-decoration-line:none;text-decoration-color:currentColor;text-decoration-style:solid;text-decoration-thickness:auto;transition-duration:0s;transition-delay:0s;border-style:solid solid solid solid;transition-property:gap,flex-grow,flex-shrink,flex-basis,top,bottom,inset-inline-start,inset-inline-end,left,right,inset,width,height,min-width,min-height,max-width,max-height,aspect-ratio,padding,margin,background-color,background-image,background-size,background-position,border-width,border-color,border-radius,outline-width,outline-color,outline-offset,box-shadow,opacity,filter,backdrop-filter,translate,rotate,scale,transform,transform-origin,accent-color,caret-color,scrollbar-color,color,font-size,font-weight,line-height,letter-spacing,word-spacing,text-decoration-color,text-decoration-thickness,text-shadow}
:where(html){--salam-start:left;--salam-end:right;cursor:auto;pointer-events:auto;-webkit-user-select:text;user-select:text;accent-color:#1a73e8;--salam-accent:#1a73e8;caret-color:currentColor;scrollbar-color:#00000066 #00000000;color:#000000;font-family:sans-serif;font-size:16px;font-weight:400;font-style:normal;line-height:1.5;letter-spacing:0;word-spacing:0;text-align:start;text-transform:none;text-wrap-mode:wrap;--salam-bidi:plaintext;white-space-collapse:collapse;text-shadow:none;font-feature-settings:normal}
:where(html,body){min-height:100vh;background-color:#ffffff;background-image:none}
:where(span,b,strong,i,em,cite,var,dfn,code,kbd,samp,a,small,sub,sup,mark,del,s,ins,u,abbr,bdi,bdo,data,time,output,q,label){--salam-fi:flow}
:where(h1){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;font-size:2em;font-weight:700;line-height:1.25;&>*{--salam-o:inline}}
:where(h2){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;font-size:1.5em;font-weight:700;line-height:1.25;&>*{--salam-o:inline}}
:where(h3){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;font-size:1.25em;font-weight:700;line-height:1.25;&>*{--salam-o:inline}}
:where(h4){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;font-size:1em;font-weight:700;line-height:1.25;&>*{--salam-o:inline}}
:where(h5){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;font-size:0.875em;font-weight:700;line-height:1.25;&>*{--salam-o:inline}}
:where(h6){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;font-size:0.75em;font-weight:700;line-height:1.25;&>*{--salam-o:inline}}
:where(p,dl,dt){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;&>*{--salam-o:inline}}
:where(span,bdi,bdo,data,time,output,q){display:var(--salam-o,block) var(--salam-fi,flow-root);&>*{--salam-o:inline}}
:where(b,strong){display:var(--salam-o,block) var(--salam-fi,flow-root);font-weight:700;&>*{--salam-o:inline}}
:where(i,em,cite,var,dfn){display:var(--salam-o,block) var(--salam-fi,flow-root);font-style:italic;&>*{--salam-o:inline}}
:where(code,kbd,samp){display:var(--salam-o,block) var(--salam-fi,flow-root);font-family:monospace;font-size:0.875em;&>*{--salam-o:inline}}
:where(pre){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;font-family:monospace;font-size:0.875em;text-wrap-mode:nowrap;white-space-collapse:preserve;&>*{--salam-o:inline}}
:where(a){display:var(--salam-o,block) var(--salam-fi,flow-root);text-decoration-line:underline;cursor:pointer;color:#1a73e8;&>*{--salam-o:inline}}
:where(small){display:var(--salam-o,block) var(--salam-fi,flow-root);font-size:0.833em;&>*{--salam-o:inline}}
:where(sub,sup){display:var(--salam-o,block) var(--salam-fi,flow-root);font-size:0.75em;&>*{--salam-o:inline}}
:where(mark){display:var(--salam-o,block) var(--salam-fi,flow-root);background-color:#ffff00;background-image:none;&>*{--salam-o:inline}}
:where(del,s){display:var(--salam-o,block) var(--salam-fi,flow-root);text-decoration-line:line-through;&>*{--salam-o:inline}}
:where(ins,u){display:var(--salam-o,block) var(--salam-fi,flow-root);text-decoration-line:underline;&>*{--salam-o:inline}}
:where(abbr){display:var(--salam-o,block) var(--salam-fi,flow-root);text-decoration-line:underline;text-decoration-style:dotted;&>*{--salam-o:inline}}
:where(button){display:var(--salam-o,block) flex;flex-direction:var(--salam-dir,row);--salam-rev:row-reverse;align-items:center;justify-content:center;--salam-j:center;padding-top:4px;padding-inline-end:12px;padding-bottom:4px;padding-inline-start:12px;background-color:#f0f0f0;background-image:none;border-top-width:1px;border-inline-end-width:1px;border-bottom-width:1px;border-inline-start-width:1px;border-top-color:#8f8f9d;border-inline-end-color:#8f8f9d;border-bottom-color:#8f8f9d;border-inline-start-color:#8f8f9d;border-start-start-radius:4px;border-start-end-radius:4px;border-end-end-radius:4px;border-end-start-radius:4px;cursor:pointer;-webkit-user-select:none;user-select:none}
:where(input:not([type=checkbox],[type=radio],[type=range],[type=color],[type=file],[type=hidden],[type=image])){width:12em;padding-top:4px;padding-inline-end:8px;padding-bottom:4px;padding-inline-start:8px;background-color:#ffffff;background-image:none;border-top-width:1px;border-inline-end-width:1px;border-bottom-width:1px;border-inline-start-width:1px;border-top-color:#8f8f9d;border-inline-end-color:#8f8f9d;border-bottom-color:#8f8f9d;border-inline-start-color:#8f8f9d;border-start-start-radius:4px;border-start-end-radius:4px;border-end-end-radius:4px;border-end-start-radius:4px;cursor:text}
:where(textarea){width:20em;height:5em;padding-top:4px;padding-inline-end:8px;padding-bottom:4px;padding-inline-start:8px;background-color:#ffffff;background-image:none;border-top-width:1px;border-inline-end-width:1px;border-bottom-width:1px;border-inline-start-width:1px;border-top-color:#8f8f9d;border-inline-end-color:#8f8f9d;border-bottom-color:#8f8f9d;border-inline-start-color:#8f8f9d;border-start-start-radius:4px;border-start-end-radius:4px;border-end-end-radius:4px;border-end-start-radius:4px;cursor:text;white-space-collapse:preserve}
:where(select){padding-top:4px;padding-inline-end:8px;padding-bottom:4px;padding-inline-start:8px;background-color:#ffffff;background-image:none;border-top-width:1px;border-inline-end-width:1px;border-bottom-width:1px;border-inline-start-width:1px;border-top-color:#8f8f9d;border-inline-end-color:#8f8f9d;border-bottom-color:#8f8f9d;border-inline-start-color:#8f8f9d;border-start-start-radius:4px;border-start-end-radius:4px;border-end-end-radius:4px;border-end-start-radius:4px;cursor:pointer}
:where(input[type=checkbox]){width:16px;height:16px;cursor:pointer}
:where(input[type=radio]){width:16px;height:16px;cursor:pointer}
:where(img,picture){display:var(--salam-o,block) var(--salam-fi,flow-root);&>*{--salam-o:inline}}
:where(video,canvas,iframe,svg,embed,object,audio){display:var(--salam-o,block) var(--salam-fi,flow-root);&>*{--salam-o:inline}}
:where(ul,menu){padding-top:0;padding-inline-end:0;padding-bottom:0;padding-inline-start:2em;margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0}
:where(ol){padding-top:0;padding-inline-end:0;padding-bottom:0;padding-inline-start:2em;margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0}
:where(li){display:var(--salam-o,block) var(--salam-fi,flow-root);display:list-item;&>*{--salam-o:inline}}
:where(dd){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0;margin-inline-end:0;margin-bottom:0;margin-inline-start:2em;&>*{--salam-o:inline}}
:where(td){display:var(--salam-o,block) var(--salam-fi,flow-root);flex-grow:1;flex-basis:0;padding-top:2px;padding-inline-end:4px;padding-bottom:2px;padding-inline-start:4px;&>*{--salam-o:inline}}
:where(th){display:var(--salam-o,block) var(--salam-fi,flow-root);flex-grow:1;flex-basis:0;padding-top:2px;padding-inline-end:4px;padding-bottom:2px;padding-inline-start:4px;font-weight:700;text-align:center;&>*{--salam-o:inline}}
:where(caption,figcaption,legend){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;text-align:center;&>*{--salam-o:inline}}
:where(hr){margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;border-top-width:1px;border-inline-end-width:0;border-bottom-width:0;border-inline-start-width:0;border-top-color:#8f8f9d;border-inline-end-color:currentColor;border-bottom-color:currentColor;border-inline-start-color:currentColor}
:where(label){display:var(--salam-o,block) var(--salam-fi,flow-root);&>*{--salam-o:inline}}
:where(summary){display:var(--salam-o,block) var(--salam-fi,flow-root);margin-top:0.5em;margin-inline-end:0;margin-bottom:0.5em;margin-inline-start:0;cursor:pointer;&>*{--salam-o:inline}}
:where(blockquote,figure){margin-top:0.5em;margin-inline-end:2em;margin-bottom:0.5em;margin-inline-start:2em}
:where(fieldset){padding-top:8px;padding-inline-end:12px;padding-bottom:8px;padding-inline-start:12px;border-top-width:1px;border-inline-end-width:1px;border-bottom-width:1px;border-inline-start-width:1px;border-top-color:#8f8f9d;border-inline-end-color:#8f8f9d;border-bottom-color:#8f8f9d;border-inline-start-color:#8f8f9d}
:where(progress,meter){width:10em;height:1em}

