واردسازی رابط گرافیکی.سبک

تابع css(name: رشته، text: رشته):
    p := سبک.ویژگی با نام(name)
    ناپایا v := سبک.مقدار {}
    اگر وارونه سبک.تجزیه(p، text، v):
        سرچاپ name، "REJECTED"، سبک.خطا(p، text)
        برگشت
    پایان
    سرچاپ name، "="، text
    سرچاپ "   "، سبک.سی اس اس(p، v)
پایان

تابع ریشه:
