واردسازی رابط گرافیکی.سبک

تابع ریشه:
    سرچاپ "row"، سبک.زبان واژه("row")
    سرچاپ "ردیف"، سبک.زبان واژه("ردیف")
    سرچاپ "center"، سبک.زبان واژه("center")
    سرچاپ "none"، سبک.زبان واژه("none")
    سرچاپ "nothing"، سبک.زبان واژه("zzz not a word")
