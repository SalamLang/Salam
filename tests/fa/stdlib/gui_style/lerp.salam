واردسازی رابط گرافیکی.سبک

تابع lerp(name: رشته، a: رشته، b: رشته):
    p := سبک.ویژگی با نام(name)
    ناپایا va := سبک.مقدار {}
    ناپایا vb := سبک.مقدار {}
    اگر وارونه سبک.تجزیه(p، a، va) یا وارونه سبک.تجزیه(p، b، vb):
        سرچاپ "bad"، name
        برگشت
    پایان
    ناپایا line := name + ": " + a + " -> " + b + " |"
    هر t در [0.0، 0.25، 0.5، 1.0]:
        line += " " + سبک.قالب(p، سبک.میان یابی(p، va، vb، t)) + " |"
    پایان
    سرچاپ line
پایان

تابع ریشه:
    lerp("width"، "100"، "200")
    lerp("width"، "100%"، "100% - 40")
    lerp("width"، "50%"، "10em")
    lerp("width"، "auto"، "200")
    lerp("padding"، "0"، "10, 20")
    lerp("margin"، "0"، "auto")
    lerp("opacity"، "0"، "1")
    lerp("font weight"، "normal"، "bold")
    lerp("color"، "black"، "white")
    lerp("color"، "red"، "blue")
    lerp("color"، "current"، "red")
    lerp("background"، "white"، "black")
    lerp("background"، "linear(90, red, blue)"، "linear(180, blue, red)")
    lerp("background"، "linear(90, red, blue)"، "radial(red, blue)")
    lerp("shadow"، "none"، "0, 4, 8, black")
    lerp("shadow"، "0, 2, 4, red"، "[0, 8, 16, blue], [0, 0, 2, black]")
    lerp("text shadow"، "1, 1, red"، "3, 3, 6, red")
    lerp("translate"، "0"، "100, 50")
    lerp("rotate"، "0"، "1turn")
    lerp("scale"، "1"، "2, 3")
    lerp("skew"، "0"، "20")
    lerp("radius"، "0"، "10")
    lerp("border"، "1, solid, red"، "5, solid, blue")
    lerp("border"، "1, solid, red"، "5, dashed, blue")
    lerp("blur"، "0"، "10")
    lerp("hue rotate"، "0"، "180")
    lerp("line height"، "1"، "2")
    lerp("letter spacing"، "0"، "0.1em")
    lerp("grow"، "0"، "1")
    lerp("layout"، "row"، "column")
    lerp("align"، "start"، "end")
    lerp("transition"، "100"، "200")
    سرچاپ "-- easing"
    هر name در ["linear"، "ease"، "ease in"، "ease out"، "ease in out"، "ease(0.2, 0, 0, 1)"، "steps(4)"، "spring(170, 26)"، "spring(100, 5)"، "spring(100, 30)"]:
        ناپایا v := سبک.مقدار {}
        _ok := سبک.تجزیه(سبک.ویژگی‌گذار، "100, " + name، v)
        e := v.اجزا.بگیر(1).نرمش
        ناپایا out := name + ":"
        هر t در [0.0، 0.1، 0.25، 0.5، 0.75، 0.9، 1.0]:
            x := (سبک.نرمش در(e، t) * 10000.0 + 0.5) برگردان صحیح
            out += " " + x
        پایان
        سرچاپ out
    پایان
پایان
