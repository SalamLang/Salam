واردسازی رابط گرافیکی.سبک

تابع kind_name(k: صحیح): رشته:
    names := [""، "word"، "bool"، "number"، "int"، "length"، "angle"، "color"، "paint"، "tracks"، "border"، "shadow"، "text shadow"، "transition"، "props"، "fonts"، "strings"]
    برگشت names[k]
پایان

تابع show(p: صحیح، text: رشته):
    ناپایا v := سبک.مقدار {}
    اگر وارونه سبک.تجزیه(p، text، v):
        سرچاپ "  FAIL"، text، سبک.خطا(p، text)
        برگشت
    پایان
    سرچاپ "  " + text، "=>"، سبک.قالب(p، v)، "|"، سبک.سی اس اس(p، v)
پایان

تابع ریشه:
    سرچاپ "properties"، سبک.شمار‌ویژگی‌ها، "keywords"، سبک.شمار‌واژه‌ها - 1
    تکرار سبک.شمار‌ویژگی‌ها در p:
        info := سبک.اطلاعات(p)
        ناپایا flags := ""
        اگر سبک.ارثی است(p):
            flags += " inherited"
        پایان
        اگر سبک.پویانما است(p):
            flags += " animatable"
        پایان
        same := سبک.ویژگی با نام(سبک.نام ویژگی(p)) برابر p و سبک.ویژگی با نام(سبک.نام فارسی ویژگی(p)) برابر p
        سرچاپ p، سبک.نام ویژگی(p)، "/"، سبک.نام فارسی ویژگی(p)، "/"، kind_name(info.گونه) + flags، "/ found"، same
        اگر info.واژه‌ها نابرابر "":
            ناپایا ws := ""
            هر w در سبک.واژه‌های ویژگی(p):
                ws += " " + سبک.نام واژه(w) + "=" + سبک.نام فارسی واژه(w)
            پایان
            سرچاپ "  words" + ws
        پایان
        show(p، info.آغازین)
        show(p، info.نمونه)
    پایان
    ناپایا ok := 0
    تکرار سبک.شمار‌واژه‌ها - 1 در k:
        id := k + 1
        اگر سبک.واژه با نام(سبک.نام واژه(id)) برابر id و سبک.واژه با نام(سبک.نام فارسی واژه(id)) برابر id:
            ok++
        پایان
    پایان
    سرچاپ "keywords found by en and fa name:"، ok
    سرچاپ سبک.ویژگی با نام("Min  Width")، سبک.ویژگی با نام("فضا")، سبک.ویژگی با نام("nope")، سبک.واژه با نام("nope")
پایان
