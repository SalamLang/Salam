واردسازی رابط گرافیکی.سبک

تابع same(prop: صحیح، built: سبک.مقدار، text: رشته):
    ناپایا parsed := سبک.مقدار {}
    _ok := سبک.تجزیه(prop، text، parsed)
    a := سبک.قالب(prop، built)
    سرچاپ سبک.نام ویژگی(prop)، "="، a، a برابر سبک.قالب(prop، parsed) ? "matches" : "DIFFERS"
پایان

تابع ریشه:
    تکرار سبک.شمار‌ویژگی‌ها در p:
        info := سبک.اطلاعات(p)
        ناپایا v := سبک.مقدار {}
        _ok := سبک.تجزیه(p، info.نمونه، v)
        سرچاپ info.نام، "="، info.نمونه
        سرچاپ "   "، سبک.منبع(p، v)
    پایان
    سرچاپ "-- built by hand the way Source writes them"
    same(سبک.ویژگی‌فاصله، سبک.یک(سبک.از طول(سبک.پیکسل(8.0))).با(سبک.از طول(سبک.ام(1.0)))، "8, 1em")
    same(سبک.ویژگی‌عرض، سبک.یک(سبک.از طول(سبک.طول { درصد = 100.0، پیکسل = -20.0 }))، "100% - 20")
    same(سبک.ویژگی‌ارتفاع، سبک.یک(سبک.از طول(سبک.ارتفاع دید(50.0)))، "50vh")
    same(سبک.ویژگی‌بیشینه‌عرض، سبک.یک(سبک.از طول(سبک.عرض دید(80.0)))، "80vw")
    same(سبک.ویژگی‌کمینه‌عرض، سبک.یک(سبک.از طول(سبک.کمینه دید(10.0)))، "10vmin")
    same(سبک.ویژگی‌کمینه‌ارتفاع، سبک.یک(سبک.از طول(سبک.بیشینه دید(10.0)))، "10vmax")
    same(سبک.ویژگی‌اندازه‌قلم، سبک.یک(سبک.از طول(سبک.رم(1.25)))، "1.25rem")
    same(سبک.ویژگی‌شکاف، سبک.یک(سبک.از طول(سبک.درصد(5.0)))، "5%")
    same(سبک.ویژگی‌شفافیت، سبک.یک(سبک.از عدد(0.5))، "0.5")
    same(سبک.ویژگی‌ترتیب‌نمایش، سبک.یک(سبک.از صحیح(-2))، "-2")
    same(سبک.ویژگی‌پیچش، سبک.یک(سبک.از منطقی(درست))، "true")
    same(سبک.ویژگی‌چرخش، سبک.یک(سبک.از زاویه(30.0))، "30")
    same(سبک.ویژگی‌چیدمان، سبک.یک(سبک.از واژه(سبک.واژه‌پشته))، "stack")
    same(سبک.ویژگی‌رنگ، سبک.یک(سبک.از رنگ(سبک.رنگ از(1.0، 0.0، 0.0، 1.0)))، "red")
    same(سبک.ویژگی‌رنگ‌نشانگر‌متن، سبک.یک(سبک.از رنگ(سبک.رنگ جاری()))، "current")
    same(سبک.ویژگی‌رنگ، سبک.یک(سبک.از رنگ(سبک.روشن تیره(سبک.رنگ از(1.0، 1.0، 1.0، 1.0)، سبک.رنگ از(0.0، 0.0، 0.0، 1.0))))، "light dark(white, black)")
    same(سبک.ویژگی‌قلم، سبک.یک(سبک.از رشته("Vazirmatn")).با(سبک.از واژه(سبک.واژه‌ساده))، "\"Vazirmatn\", sans")
    same(سبک.ویژگی‌پس‌زمینه، سبک.یک(سبک.از رنگ‌آمیزی(سبک.گرادیان(سبک.رنگ‌آمیزی‌خطی، 90.0، 0، نادرست، سبک.درصد(50.0)، سبک.درصد(50.0)، نادرست).افزودن ایستگاه(سبک.رنگ از(1.0، 0.0، 0.0، 1.0)، سبک.طول {}، نادرست).افزودن ایستگاه(سبک.رنگ از(0.0، 0.0، 1.0، 1.0)، سبک.درصد(80.0)، درست)))، "linear(90, red, blue 80%)")
    same(سبک.ویژگی‌پس‌زمینه، سبک.یک(سبک.از رنگ‌آمیزی(سبک.تصویر("a.png")))، "image(\"a.png\")")
    same(سبک.ویژگی‌گذار، سبک.یک(سبک.از زمان(200.0)).با(سبک.از نرمش(سبک.نرمش { گونه = سبک.نرمش‌انتها })).با(سبک.از زمان(0.0)).سپس(سبک.از زمان(100.0)).با(سبک.از نرمش(سبک.نرمش { گونه = سبک.نرمش‌گام، گام‌ها = 3 })).با(سبک.از زمان(10.0))، "[200, ease out], [100, steps(3), 10]")
    same(سبک.ویژگی‌ستون‌ها، سبک.یک(سبک.از شیار(سبک.شیار { گونه = سبک.شیار‌تکراری، شمار = 2، گستره = 1 })).با(سبک.از شیار(سبک.شیار { طول = سبک.سهم(1.0) }))، "repeat(2, 1fr)")
    same(سبک.ویژگی‌ویژگی‌های‌گذار، سبک.یک(سبک.از ویژگی(سبک.ویژگی‌شفافیت))، "opacity")
    سرچاپ سبک.منبع(سبک.ویژگی‌عرض، سبک.مقدار {})
پایان
