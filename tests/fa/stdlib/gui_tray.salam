واردسازی رابط گرافیکی.سینی
واردسازی رابط گرافیکی.پنجره ها
واردسازی رابط گرافیکی.رابط کاربری

ناپایا wakes := 0

تابع kind_name(kind: سینی.نوع‌رویداد): رشته:
    اگر kind برابر سینی.نوع‌رویداد.کلیک:
        برگشت "click"
    پایان
    اگر kind برابر سینی.نوع‌رویداد.دوبار کلیک:
        برگشت "double click"
    پایان
    برگشت "menu"
پایان

تابع ریشه:
    show := سینی.گزینه تازه("show"، "Show")
    سرچاپ "item"، show.شناسه، show.برچسب، show.فعال، show.تیک خورده، show.جداکننده
    auto := سینی.گزینه تیک دار("auto"، "Auto connect"، درست)
    سرچاپ "check"، auto.شناسه، auto.برچسب، auto.تیک خورده
    line := سینی.خط جدا()
    سرچاپ "separator"، line.جداکننده، line.شناسه.طول()
    off := سینی.گزینه { شناسه = "off"، برچسب = "Off"، فعال = نادرست }
    سرچاپ "disabled"، off.فعال
    سرچاپ "shown"، سینی.نمایان است()
    _s := سینی.پشتیبانی شده()
    سرچاپ "backend named"، سینی.سامانه پشتیبان().طول() بزرگتر 0
    سرچاپ "missing icon"،
        سینی.نمایش("no/such/icon.png"، "Idle"، وکتور {} برگردان وکتور<سینی.گزینه>)،
        سینی.آخرین خطا().طول() بزرگتر 0
    سرچاپ "still hidden"، سینی.نمایان است()
    ناپایا items := وکتور {} برگردان وکتور<سینی.گزینه>
    items.افزودن(show)
    items.افزودن(line)
    items.افزودن(auto)
    سینی.تنظیم منو(items)
    سینی.تنظیم راهنما("Idle")
    سرچاپ "bad icon"، سینی.تنظیم نماد("no/such/icon.png")
    سینی.پنهان کردن()
    سرچاپ "pending"، سینی.رویدادهای مانده()
    سینی.تنظیم بیدارباش((): wakes++ پایان)
    سینی.فرستادن رویداد(سینی.رویداد { نوع = سینی.نوع‌رویداد.کلیک })
    سینی.فرستادن رویداد(سینی.رویداد { نوع = سینی.نوع‌رویداد.انتخاب گزینه، شناسه گزینه = "show" })
    سینی.فرستادن رویداد(سینی.رویداد { نوع = سینی.نوع‌رویداد.دوبار کلیک })
    سرچاپ "pending"، سینی.رویدادهای مانده()، "wakes"، wakes
    ناپایا ev := سینی.رویداد {}
    تا سینی.برداشتن رویداد(ev):
        سرچاپ "event"، kind_name(ev.نوع)، ev.شناسه گزینه
    پایان
    سرچاپ "pending"، سینی.رویدادهای مانده()، "empty"، سینی.برداشتن رویداد(ev)

    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { پهنا = 200.0، بلندی = 100.0، بی سر = درست })
    سرچاپ "visible"، w.نمایان است()
    w.پنهان کردن()
    سرچاپ "hidden"، w.نمایان است()، w.باز است()
    w.نمایش دادن()
    سرچاپ "shown again"، w.نمایان است()
    quiet := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره {
        پهنا = 10.0،
        بلندی = 10.0،
        بی سر = درست،
        نمایان = نادرست
    })
    سرچاپ "starts hidden"، quiet.نمایان است()
    quiet.نمایش دادن()
    سرچاپ "now visible"، quiet.نمایان است()

    رابط کاربری.هنگام درخواست بستن((): برگشت نادرست پایان)
    رابط کاربری.پنهان کردن پنجره()
    رابط کاربری.نمایش پنجره()
    سرچاپ "ui window"، رابط کاربری.پنجره نمایان است()
پایان
