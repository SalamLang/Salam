واردسازی رابط گرافیکی.حروف‌چینی

تابع probe(p: حروف‌چینی.بند، l: حروف‌چینی.چیدمان متن، offsets: وکتور<صحیح>):
    هر off در offsets:
        down := حروف‌چینی.مستطیل نشانگر(p، l، حروف‌چینی.جای متن { جابجایی = off })
        up := حروف‌چینی.مستطیل نشانگر(p، l، حروف‌چینی.جای متن { جابجایی = off، وابسته به پیش = درست })
        سرچاپ "caret"، off، down.ایکس، down.ایگرگ، down.بلندی، "up"، up.ایکس، up.ایگرگ
    پایان
    ناپایا x := -4.0
    چاپ "hit"
    تا x کوچکتر l.پهنا + 8.0:
        h := حروف‌چینی.آزمون برخورد(p، l، x، 4.0)
        چاپ " "، h.جابجایی
        اگر h.وابسته به پیش:
            چاپ "u"
        پایان
        x += 5.0
    پایان
    سرچاپ ""
پایان

تابع walk(p: حروف‌چینی.بند، l: حروف‌چینی.چیدمان متن، right: منطقی، start: صحیح، steps: صحیح):
    ناپایا pos := حروف‌چینی.جای متن { جابجایی = start }
    چاپ right ? "right" : "left"
    تکرار steps:
        pos = حروف‌چینی.جابجایی دیداری(p، l، pos، right)
        چاپ " "، pos.جابجایی
        اگر pos.وابسته به پیش:
            چاپ "u"
        پایان
        چاپ "/"، pos.خط
    پایان
    سرچاپ ""
پایان

تابع selection(p: حروف‌چینی.بند، l: حروف‌چینی.چیدمان متن، a: صحیح، b: صحیح):
    rects := حروف‌چینی.مستطیل‌های گزینش(p، l، a، b)
    چاپ "select "، a، "-"، b، ":"
    هر r در rects:
        چاپ " ["، r.ایکس، " "، r.ایگرگ، " "، r.پهنا، " "، r.بلندی، "]"
    پایان
    سرچاپ ""
    rects.آزادکن()
پایان

تابع str_len(p: حروف‌چینی.بند): صحیح:
    برگشت p.نویسه‌ها.بگیر(p.نویسه‌ها.طول() - 1).جابجایی + 1
پایان

تابع ریشه:
    ناپایا fc := حروف‌چینی.مجموعه قلم تازه()
    حروف‌چینی.افزودن پرونده قلم(fc، "books/fonts/XB Zar.ttf")
    ناپایا spans := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    spans.بیفزا(حروف‌چینی.تکه متن { متن = "ab سلام cd"، خانواده‌های قلم = "XB Zar"، اندازه = 20.0 })
    ناپایا st := حروف‌چینی.سبک بند {}
    st.جهت = حروف‌چینی.جهت متن چپ به راست
    st.فاصله‌های سفید = حروف‌چینی.فاصله سفید.PreWrap
    ناپایا p := حروف‌چینی.بند تازه(fc، spans، st)
    ناپایا l := حروف‌چینی.چیدن بند(p، fc، 0.0)
    سرچاپ "ltr paragraph with an rtl word"
    ناپایا offs := وکتور {} برگردان وکتور<صحیح>
    هر o در [0، 1، 2، 3، 5، 7، 9، 11، 12، 13، 14]:
        offs.بیفزا(o)
    پایان
    probe(p، l، offs)
    walk(p، l، درست، 0، 14)
    walk(p، l، نادرست، 14، 14)
    selection(p، l، 1، 7)
    selection(p، l، 7، 1)
    selection(p، l، 5، 13)
    سرچاپ "graphemes"، حروف‌چینی.خوشه بعدی(p، 3)، حروف‌چینی.خوشه بعدی(p، 4)، حروف‌چینی.خوشه پیشین(p، 5)، حروف‌چینی.خوشه پیشین(p، 0)
    سرچاپ "words"، حروف‌چینی.انتهای واژه بعدی(p، 0)، حروف‌چینی.انتهای واژه بعدی(p، 2)، حروف‌چینی.آغاز واژه پیشین(p، 14)، حروف‌چینی.آغاز واژه پیشین(p، 7)
    حروف‌چینی.آزادسازی چیدمان(l)
    حروف‌چینی.آزادسازی بند(p)
    spans.آزادکن()
    ناپایا fa := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    fa.بیفزا(حروف‌چینی.تکه متن { متن = "کتاب‌ها و دفترها روی میز ABC هستند"، خانواده‌های قلم = "XB Zar"، اندازه = 18.0 })
    ناپایا st2 := حروف‌چینی.سبک بند {}
    st2.فاصله‌های سفید = حروف‌چینی.فاصله سفید.PreWrap
    ناپایا q := حروف‌چینی.بند تازه(fc، fa، st2)
    ناپایا ql := حروف‌چینی.چیدن بند(q، fc، 90.0)
    سرچاپ "rtl paragraph on"، ql.خط‌ها.طول()، "lines"
    هر lb در ql.خط‌ها:
        سرچاپ "line"، lb.آغاز، lb.انتهای بایت، lb.بالا، lb.بلندی
    پایان
    ناپایا qo := وکتور {} برگردان وکتور<صحیح>
    ناپایا at := 0
    تا at کوچکتر str_len(q):
        qo.بیفزا(at)
        at = حروف‌چینی.خوشه بعدی(q، at)
    پایان
    qo.بیفزا(at)
    probe(q، ql، qo)
    walk(q، ql، نادرست، 0، 24)
    walk(q، ql، درست، at، 24)
    selection(q، ql، 10، 40)
    h := حروف‌چینی.آزمون برخورد(q، ql، 30.0، 40.0)
    سرچاپ "second line hit"، h.جابجایی، h.خط، h.وابسته به پیش
    سرچاپ "words"، حروف‌چینی.انتهای واژه بعدی(q، 0)، حروف‌چینی.آغاز واژه پیشین(q، 18)، حروف‌چینی.خوشه بعدی(q، 6)، حروف‌چینی.خوشه پیشین(q، 8)
    حروف‌چینی.آزادسازی چیدمان(ql)
    حروف‌چینی.آزادسازی بند(q)
    fa.آزادکن()
    offs.آزادکن()
    qo.آزادکن()
    حروف‌چینی.آزادسازی مجموعه قلم(fc)
پایان
