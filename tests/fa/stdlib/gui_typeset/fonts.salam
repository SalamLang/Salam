واردسازی رابط گرافیکی.حروف‌چینی
واردسازی بایگانی
واردسازی فشرده سازی

تابع check_font(path: رشته):
    ناپایا ok := نادرست
    ناپایا f := حروف‌چینی.بارگذاری قلم(path، ok)
    سرچاپ "font"، ok، حروف‌چینی.قلم معتبر(f)، حروف‌چینی.واحد در ام(f)، حروف‌چینی.تعداد نویسه‌ها(f)
    سرچاپ "names"، حروف‌چینی.نام خانواده(f)، "|"، حروف‌چینی.نام سبک قلم(f)، "|"، حروف‌چینی.نام کامل قلم(f)، "|"، حروف‌چینی.متن نام(f، 1)
    سرچاپ "style"، حروف‌چینی.وزن قلم(f)، حروف‌چینی.مورب است(f)
    m := حروف‌چینی.متریک‌ها(f)
    سرچاپ "metrics"، m.واحد ام، m.صعود، m.نزول، m.فاصله سطرها، m.ارتفاع ایکس، m.ارتفاع حرف بزرگ، m.جای زیرخط، m.ضخامت زیرخط
    سرچاپ "pixels"، حروف‌چینی.ضریب مقیاس(f، 20.48)، حروف‌چینی.صعود پیکسلی(f، 20.48)، حروف‌چینی.نزول پیکسلی(f، 20.48)، حروف‌چینی.ارتفاع خط پیکسلی(f، 20.48)
    هر cp در [0x41، 0x61، 0x0628، 0x06CC، 0x200C، 0x4E00]:
        g := حروف‌چینی.اندیس نویسه(f، cp)
        ناپایا x0 := 0
        ناپایا y0 := 0
        ناپایا x1 := 0
        ناپایا y1 := 0
        has := حروف‌چینی.کادر نویسه(f، g، x0، y0، x1، y1)
        سرچاپ "cmap"، cp، g، حروف‌چینی.پیشروی نویسه(f، g)، حروف‌چینی.نویسه طرح دارد(f، g)، has، x0، y0، x1، y1
    پایان
    سرچاپ "kern"، حروف‌چینی.کرنینگ(f، حروف‌چینی.اندیس نویسه(f، 0x41)، حروف‌چینی.اندیس نویسه(f، 0x56))
    حروف‌چینی.آزادسازی قلم(f)
    سرچاپ "freed"، حروف‌چینی.قلم معتبر(f)
پایان

تابع check_bytes():
    ناپایا ok := نادرست
    ناپایا buf := بایگانی.خواندن پرونده دودویی("books/fonts/XB Zar It.ttf"، ok)
    سرچاپ "bytes"، ok، حروف‌چینی.شمار چهره‌ها(buf.داده، buf.طول)، حروف‌چینی.قلم سی‌اف‌اف است(buf.داده، buf.طول)
    ناپایا pok := نادرست
    f := حروف‌چینی.خواندن قلم(buf.داده، buf.طول، pok)
    سرچاپ "parsed"، pok، حروف‌چینی.نام خانواده(f)، حروف‌چینی.مورب است(f)
    ناپایا bad := نادرست
    g := حروف‌چینی.خواندن قلم با اندیس(buf.داده، buf.طول، 1، bad)
    سرچاپ "index 1"، bad، حروف‌چینی.قلم معتبر(g)
    ناپایا fc := حروف‌چینی.مجموعه قلم تازه()
    سرچاپ "added bytes"، حروف‌چینی.افزودن قلم از بایت‌ها(fc، buf.داده، buf.طول)
    سرچاپ "added font"، حروف‌چینی.افزودن قلم(fc، f)
    سرچاپ "faces"، حروف‌چینی.شمار چهره‌های مجموعه(fc)
    حروف‌چینی.آزادسازی مجموعه قلم(fc)
    فشرده سازی.آزادسازی بافر(buf)
    ناپایا lok := نادرست
    ناپایا h := حروف‌چینی.بارگذاری قلم با اندیس("books/fonts/XB Zar.ttf"، 0، lok)
    سرچاپ "load index"، lok، حروف‌چینی.نام خانواده(h)
    حروف‌چینی.آزادسازی قلم(h)
پایان

تابع check_collection():
    ناپایا fc := حروف‌چینی.مجموعه قلم تازه()
    سرچاپ "file"، حروف‌چینی.افزودن پرونده قلم(fc، "books/fonts/XB Zar.ttf")، حروف‌چینی.افزودن پرونده قلم(fc، "books/fonts/XB Zar Bd.ttf")، حروف‌چینی.افزودن پرونده قلم(fc، "books/fonts/DejaVuSansMono.ttf")، حروف‌چینی.افزودن پرونده قلم(fc، "books/fonts/missing.ttf")
    هر face در fc.چهره‌ها:
        سرچاپ "face"، face.خانواده، face.سبک، face.وزن، face.مورب، face.بارشده
    پایان
    سرچاپ "find"، حروف‌چینی.یافتن چهره(fc، "xb zar"، 700، نادرست)، حروف‌چینی.یافتن چهره(fc، "XB Zar"، 400، نادرست)، حروف‌چینی.یافتن چهره(fc، "XB Zar"، 900، درست)، حروف‌چینی.یافتن چهره(fc، "Nope"، 400، نادرست)
    سرچاپ "fallback"، حروف‌چینی.چهره برای نویسه(fc، "DejaVu Sans Mono, XB Zar"، 400، نادرست، 0x0628)، حروف‌چینی.چهره برای نویسه(fc، "DejaVu Sans Mono, XB Zar"، 400، نادرست، 0x41)، حروف‌چینی.چهره برای نویسه(fc، "monospace"، 400، نادرست، 0x06F1)، حروف‌چینی.چهره برای نویسه(fc، "XB Zar"، 400، نادرست، 0x4E00)
    f := حروف‌چینی.قلم چهره(fc، 1)
    سرچاپ "face font"، حروف‌چینی.وزن قلم(f)، حروف‌چینی.قلم معتبر(حروف‌چینی.قلم چهره(fc، 9))
    حروف‌چینی.آزادسازی مجموعه قلم(fc)
    ناپایا dir := حروف‌چینی.مجموعه قلم تازه()
    n := حروف‌چینی.افزودن پوشه قلم(dir، "books/fonts")
    سرچاپ "dir"، n بزرگتر 90، حروف‌چینی.یافتن چهره(dir، "XM Yekan"، 400، نادرست) بزرگتربرابر 0، حروف‌چینی.یافتن چهره(dir، "Latin Modern Mono"، 400، نادرست)
    حروف‌چینی.آزادسازی مجموعه قلم(dir)
    dirs := حروف‌چینی.پوشه‌های قلم سیستم()
    سرچاپ "system dirs"، dirs.طول() بزرگتر 0
    dirs.آزادکن()
    ناپایا sys := حروف‌چینی.مجموعه قلم تازه()
    سرچاپ "system fonts"، حروف‌چینی.افزودن قلم‌های سیستم(sys) بزرگتربرابر 0
    حروف‌چینی.آزادسازی مجموعه قلم(sys)
پایان

تابع ریشه:
    check_font("books/fonts/XB Zar.ttf")
    check_font("books/fonts/XB Zar BdIt.ttf")
    check_font("books/fonts/DejaVuSansMono.ttf")
    check_bytes()
    check_collection()
پایان
