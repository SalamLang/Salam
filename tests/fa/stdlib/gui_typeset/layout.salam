واردسازی رابط گرافیکی.حروف‌چینی

تابع show(p &: حروف‌چینی.بند، fc &: حروف‌چینی.مجموعه قلم، w: اعشار۶۴):
    ناپایا l := حروف‌چینی.چیدن بند(p، fc، w)
    سرچاپ "width"، w، "size"، l.پهنا، l.بلندی، "lines"، l.خط‌ها.طول()، "truncated"، l.بریده‌شده
    هر lb در l.خط‌ها:
        چاپ "  line "، lb.آغاز، "-"، lb.انتهای بایت، " x="، lb.ایکس، " w="، lb.پهنا، " base="، lb.خط پایه، " h="، lb.بلندی، " rtl="، lb.راست به چپ، " hard="، lb.شکست سخت، " |"
        ناپایا k := lb.آغاز دنباله
        تا k کوچکتر lb.آغاز دنباله + lb.شمار دنباله:
            r := l.دنباله‌ها.بگیر(k)
            چاپ " ["، r.آغاز، "-"، r.انتهای بایت، " x="، r.ایکس، " w="، r.پهنا
            اگر r.راست به چپ:
                چاپ " rtl"
            پایان
            اگر r.سه نقطه:
                چاپ " ellipsis"
            پایان
            چاپ " tag="، r.برچسب، " glyphs="، r.شمار گلیف، "]"
            k++
        پایان
        سرچاپ ""
    پایان
    اگر l.گلیف‌ها.طول() بزرگتر 0:
        g := l.گلیف‌ها.بگیر(0)
        سرچاپ "  first glyph"، g.شناسه، g.ایکس، g.ایگرگ، g.خوشه، g.پیشروی
    پایان
    حروف‌چینی.آزادسازی چیدمان(l)
پایان

تابع para(fc &: حروف‌چینی.مجموعه قلم، spans: وکتور<حروف‌چینی.تکه متن>، st: حروف‌چینی.سبک بند، widths: وکتور<اعشار۶۴>):
    ناپایا p := حروف‌چینی.بند تازه(fc، spans، st)
    سرچاپ "min"، حروف‌چینی.پهنای کمینه محتوا(p)، "max"، حروف‌چینی.پهنای بیشینه محتوا(p)، "runs"، p.دنباله‌ها.طول()، "glyphs"، p.گلیف‌ها.طول()، "chars"، p.نویسه‌ها.طول()
    هر w در widths:
        show(p، fc، w)
    پایان
    حروف‌چینی.آزادسازی بند(p)
پایان

تابع ریشه:
    ناپایا fc := حروف‌چینی.مجموعه قلم تازه()
    حروف‌چینی.افزودن پرونده قلم(fc، "books/fonts/XB Zar.ttf")
    حروف‌چینی.افزودن پرونده قلم(fc، "books/fonts/DejaVuSansMono.ttf")
    ناپایا mixed := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    mixed.بیفزا(حروف‌چینی.تکه متن { متن = "سلام دنیا، این یک "، خانواده‌های قلم = "XB Zar"، اندازه = 20.0، برچسب = 1 })
    mixed.بیفزا(حروف‌چینی.تکه متن { متن = "Hello World"، خانواده‌های قلم = "DejaVu Sans Mono"، اندازه = 16.0، برچسب = 2 })
    mixed.بیفزا(حروف‌چینی.تکه متن { متن = " آزمایش است."، خانواده‌های قلم = "XB Zar"، اندازه = 20.0، برچسب = 3 })
    ناپایا widths := وکتور {} برگردان وکتور<اعشار۶۴>
    widths.بیفزا(0.0)
    widths.بیفزا(150.0)
    widths.بیفزا(80.0)
    سرچاپ "mixed rtl"
    para(fc، mixed، حروف‌چینی.سبک بند {}، widths)
    p0 := حروف‌چینی.بند تازه(fc، mixed، حروف‌چینی.سبک بند {})
    سرچاپ "span at"، حروف‌چینی.تکه جای(p0، 0)، حروف‌چینی.تکه جای(p0، 32)، حروف‌چینی.تکه جای(p0، 50)، p0.آغاز تکه‌ها.طول()
    ناپایا p1 := p0
    حروف‌چینی.آزادسازی بند(p1)
    ناپایا one := وکتور {} برگردان وکتور<اعشار۶۴>
    one.بیفزا(120.0)
    ناپایا latin := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    latin.بیفزا(حروف‌چینی.تکه متن { متن = "The quick brown fox jumps over the lazy dog"، خانواده‌های قلم = "monospace"، اندازه = 10.0، بلندی خط = 14.0 })
    هر al در [حروف‌چینی.چینش متن.Start، حروف‌چینی.چینش متن.End، حروف‌چینی.چینش متن.Center، حروف‌چینی.چینش متن.Justify، حروف‌چینی.چینش متن.Right]:
        ناپایا st := حروف‌چینی.سبک بند {}
        st.چینش = al
        سرچاپ "align"، al
        para(fc، latin، st، one)
    پایان
    ناپایا ell := حروف‌چینی.سبک بند {}
    ell.فاصله‌های سفید = حروف‌چینی.فاصله سفید.NoWrap
    ell.سه نقطه = درست
    سرچاپ "nowrap ellipsis"
    para(fc، latin، ell، one)
    ناپایا two := حروف‌چینی.سبک بند {}
    two.بیشینه خط‌ها = 2
    two.سه نقطه = درست
    سرچاپ "two lines"
    para(fc، latin، two، one)
    ناپایا rtl_ell := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    rtl_ell.بیفزا(حروف‌چینی.تکه متن { متن = "این یک جمله بلند فارسی برای آزمودن سه نقطه است"، خانواده‌های قلم = "XB Zar"، اندازه = 16.0 })
    سرچاپ "rtl ellipsis"
    para(fc، rtl_ell، ell، one)
    ناپایا pre := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    pre.بیفزا(حروف‌چینی.تکه متن { متن = "  two  spaces\nnext   line\n"، خانواده‌های قلم = "monospace"، اندازه = 10.0 })
    هر ws در [حروف‌چینی.فاصله سفید.Normal، حروف‌چینی.فاصله سفید.Pre، حروف‌چینی.فاصله سفید.PreWrap]:
        ناپایا st := حروف‌چینی.سبک بند {}
        st.فاصله‌های سفید = ws
        سرچاپ "white space"، ws
        para(fc، pre، st، one)
    پایان
    ناپایا long := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    long.بیفزا(حروف‌چینی.تکه متن { متن = "supercalifragilistic word"، خانواده‌های قلم = "monospace"، اندازه = 10.0، فاصله حرف‌ها = 1.0 })
    ناپایا narrow := وکتور {} برگردان وکتور<اعشار۶۴>
    narrow.بیفزا(60.0)
    هر ow در [حروف‌چینی.شکستن سرریز.Normal، حروف‌چینی.شکستن سرریز.Anywhere، حروف‌چینی.شکستن سرریز.BreakWord]:
        ناپایا st := حروف‌چینی.سبک بند {}
        st.شکستن سرریز = ow
        سرچاپ "overflow wrap"، ow
        para(fc، long، st، narrow)
    پایان
    ناپایا zw := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    zw.بیفزا(حروف‌چینی.تکه متن { متن = "می‌خواهم کتاب‌ها را بخوانم"، خانواده‌های قلم = "XB Zar"، اندازه = 16.0، فاصله واژه‌ها = 4.0، ضریب بلندی خط = 2.0 })
    ناپایا zws := وکتور {} برگردان وکتور<اعشار۶۴>
    zws.بیفزا(70.0)
    سرچاپ "zwnj words"
    para(fc، zw، حروف‌چینی.سبک بند {}، zws)
    ناپایا ltr := حروف‌چینی.سبک بند {}
    ltr.جهت = حروف‌چینی.جهت متن چپ به راست
    سرچاپ "forced ltr"
    para(fc، zw، ltr، zws)
    mixed.آزادکن()
    widths.آزادکن()
    one.آزادکن()
    latin.آزادکن()
    rtl_ell.آزادکن()
    pre.آزادکن()
    long.آزادکن()
    narrow.آزادکن()
    zw.آزادکن()
    zws.آزادکن()
    حروف‌چینی.آزادسازی مجموعه قلم(fc)
پایان
