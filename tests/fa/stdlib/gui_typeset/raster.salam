واردسازی رابط گرافیکی.حروف‌چینی

تابع coverage_sum(m: حروف‌چینی.ماسک گلیف): صحیح:
    ناپایا total := 0
    اگر m.داده برابر پوچ:
        برگشت 0
    پایان
    bp := m.داده برگردان طبیعی۸*
    تکرار m.بلندی در y:
        تکرار m.پهنا در x:
            total += bp[y * m.گام سطر + x] برگردان صحیح
        پایان
    پایان
    برگشت total
پایان

تابع show(f: حروف‌چینی.قلم، cp: صحیح، size: اعشار۶۴، sub: صحیح):
    ناپایا m := حروف‌چینی.شطرنجی کردن گلیف(f، حروف‌چینی.اندیس نویسه(f، cp)، size، sub)
    سرچاپ "mask"، cp، size، sub، m.پهنا، m.بلندی، m.گام سطر، m.چپ، m.بالا، coverage_sum(m)، حروف‌چینی.درهم ماسک گلیف(m)
    حروف‌چینی.آزادسازی ماسک گلیف(m)
پایان

تابع ریشه:
    ناپایا ok := نادرست
    ناپایا zar := حروف‌چینی.بارگذاری قلم("books/fonts/XB Zar.ttf"، ok)
    ناپایا mono := حروف‌چینی.بارگذاری قلم("books/fonts/DejaVuSansMono.ttf"، ok)
    هر cp در [0x41، 0x61، 0x67، 0x2E]:
        show(mono، cp، 16.0، 0)
    پایان
    تکرار 4 در q:
        show(mono، 0x6F، 13.5، q)
    پایان
    هر cp در [0x0634، 0x06AF، 0x0644، 0x06F4]:
        show(zar، cp، 24.0، 0)
    پایان
    show(zar، 0x20، 24.0، 0)
    show(zar، 0x0628، 0.0، 0)
    سرچاپ "subpixel"، حروف‌چینی.زیرپیکسل(10.0)، حروف‌چینی.زیرپیکسل(10.3)، حروف‌چینی.زیرپیکسل(10.6)، حروف‌چینی.زیرپیکسل(-0.3)، حروف‌چینی.زیرپیکسل(10.9)
    ناپایا m := حروف‌چینی.شطرنجی کردن گلیف(mono، حروف‌چینی.اندیس نویسه(mono، 0x61)، 16.0، حروف‌چینی.زیرپیکسل(10.3))
    سرچاپ "origin"، حروف‌چینی.مبدا افقی گلیف(10.3، m)، حروف‌چینی.مبدا عمودی گلیف(20.4، m)، حروف‌چینی.مبدا افقی گلیف(-0.3، m)، حروف‌چینی.مبدا عمودی گلیف(-3.6، m)
    حروف‌چینی.آزادسازی ماسک گلیف(m)
    ناپایا cache := حروف‌چینی.نهانگاه گلیف تازه(1000)
    ناپایا row := 0
    تا row کوچکتر 3:
        هر cp در [0x61، 0x62، 0x63، 0x61، 0x64]:
            g := حروف‌چینی.گلیف نهان(cache، mono، حروف‌چینی.اندیس نویسه(mono، cp)، 16.0، 4.0 + (row برگردان اعشار۶۴) * 0.25)
            چاپ g.پهنا، "x"، g.بلندی، " "
        پایان
        سرچاپ "| hits"، cache.برخوردها، "misses"، cache.نیافته‌ها، "bytes"، cache.بایت‌ها، cache.بایت‌ها کوچکتربرابر cache.گنجایش
        row++
    پایان
    حروف‌چینی.آزادسازی نهانگاه گلیف(cache)
    سرچاپ "after free"، cache.بایت‌ها
    ناپایا o := حروف‌چینی.طرح تبدیل‌شده(mono، حروف‌چینی.اندیس نویسه(mono، 0x4F)، 0.01، 0.0، 0.0، -0.01، 5.0، 20.0)
    سرچاپ "outline"، o.نقطه‌ها.طول()، o.پایان‌های کانتور.طول()
    ناپایا cov := حروف‌چینی.پوشش طرح(o، 40، 40)
    ناپایا sum := 0.0
    هر v در cov.مقدارها:
        sum += v
    پایان
    سرچاپ "coverage"، cov.ایکس، cov.ایگرگ، cov.پهنا، cov.بلندی، sum بزرگتر 50.0، sum کوچکتر 150.0
    حروف‌چینی.آزادسازی سطرهای پوشش(cov)
    حروف‌چینی.آزادسازی طرح(o)
    حروف‌چینی.آزادسازی قلم(zar)
    حروف‌چینی.آزادسازی قلم(mono)
پایان
