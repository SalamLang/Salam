واردسازی رابط گرافیکی.حروف‌چینی

تابع show(f: حروف‌چینی.قلم، text: رشته، rtl: منطقی، lang: رشته):
    gs := حروف‌چینی.شکل‌دهی متن(f، text، rtl، ""، lang)
    چاپ text، " =>"
    هر g در gs:
        چاپ " "، g.شناسه، ":"، g.خوشه، ":"، g.پیشروی افقی
        اگر g.جابجایی افقی نابرابر 0 یا g.جابجایی عمودی نابرابر 0:
            چاپ "@"، g.جابجایی افقی، ","، g.جابجایی عمودی
        پایان
    پایان
    سرچاپ ""
    gs.آزادکن()
پایان

تابع ریشه:
    ناپایا ok := نادرست
    ناپایا zar := حروف‌چینی.بارگذاری قلم("books/fonts/XB Zar.ttf"، ok)
    ناپایا mono := حروف‌چینی.بارگذاری قلم("books/fonts/DejaVuSansMono.ttf"، ok)
    سرچاپ "joining"
    show(zar، "سلام دنیا"، درست، "fa")
    show(zar، "کتاب‌های من"، درست، "fa")
    show(zar، "می‌خواهم بروم"، درست، "fa")
    show(zar، "لا الله"، درست، "fa")
    show(zar، "بالله"، درست، "fa")
    show(zar، "فرهنگ"، درست، "fa")
    show(zar، "گفت‌وگو؟ (۱۲۳)"، درست، "fa")
    سرچاپ "kerning"
    show(zar، "AVAWAY To"، نادرست، "en")
    show(zar، "office ffi"، نادرست، "en")
    show(zar، "دک رگ زک"، درست، "fa")
    سرچاپ "marks"
    show(mono، "éä́"، نادرست، "")
    show(mono، "Åño"، نادرست، "")
    show(mono، "بِسْمِ اللَّهِ"، درست، "ar")
    show(zar، "مُحَمَّدٌ"، درست، "fa")
    show(mono، "سَلامٌ"، درست، "fa")
    سرچاپ "legacy"
    سرچاپ حروف‌چینی.شکل‌دهی عربی("لا سلام")
    سرچاپ حروف‌چینی.متن راست به چپ است("سلام")، حروف‌چینی.متن راست به چپ است("abc")
    سرچاپ حروف‌چینی.جهت پایه("abc سلام") برابر حروف‌چینی.جهت متن چپ به راست، حروف‌چینی.جهت پایه("سلام abc") برابر حروف‌چینی.جهت متن راست به چپ
    سرچاپ حروف‌چینی.به ترتیب نمایشی("abc سلام (x) 12"، حروف‌چینی.جهت متن خودکار)
    v := حروف‌چینی.کدهای نمایشی("سلام"، حروف‌چینی.جهت متن خودکار، درست)
    هر cp در v:
        چاپ cp، " "
    پایان
    سرچاپ ""
    v.آزادکن()
    حروف‌چینی.آزادسازی قلم(zar)
    حروف‌چینی.آزادسازی قلم(mono)
پایان
