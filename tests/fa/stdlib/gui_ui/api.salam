واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک
واردسازی سیستم عامل

ناپایا hovered := 0

تابع patches(): وکتور<رابط کاربری.وصله‌سبک>:
    ناپایا all := رابط کاربری.بی وصله()
    ناپایا p := رابط کاربری.وصله تازه()
    ناپایا v := سبک.مقدار {}
    اگر سبک.تجزیه(سبک.ویژگی‌پس‌زمینه، "#ff0000"، v):
        p.بیفزا(سبک.ویژگی‌پس‌زمینه، v)
    پایان
    سرچاپ "patch"، p.طول()، p.ویژگی‌ها.طول()، p.مقدارها.طول()
    all.بیفزا(p)
    برگشت all
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.عنوان صفحه("Api")
    b.زبان صفحه("fa")
    b.جهت صفحه("rtl")
    b.گشودن عنصر("box")
    b.شناسه عنصر("one")
    b.کلید عنصر("k")
    b.ویژگی عنصر("data-x"، "1")
    b.ویژگی دودویی عنصر("disabled"، درست)
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌عرض، "40")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌ارتفاع، "20")
    b.وصله عنصر(رابط کاربری.حالت پایه، 0)
    ناپایا v := سبک.مقدار {}
    اگر سبک.تجزیه(سبک.ویژگی‌پس‌زمینه، "#0000ff"، v):
        b.تنظیم سبک(رابط کاربری.حالت شناور، سبک.ویژگی‌پس‌زمینه، v)
    پایان
    b.رسیدگی رخداد("click"، (): hovered++ پایان)
    b.بستن عنصر()
پایان

تابع interactive():
    o := رابط کاربری.گزینه‌ها { پهنا = 320.0، بلندی = 200.0، عنوان = "Api" }
    رابط کاربری.اجرای صفحه با((): برگشت patches() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، o)
    رابط کاربری.اجرای صفحه((): برگشت patches() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان)
    سرچاپ رابط کاربری.گزارش درخت()
پایان

تابع ریشه:
    سرچاپ رابط کاربری.گزارش صفحه((): برگشت patches() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 200، 100)
    ناپایا c := رابط کاربری.نگاره صفحه با مقیاس((): برگشت patches() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 200، 100، 2.0)
    سرچاپ "scaled"، c.پهنا، c.بلندی
    p := c.پیکسل(340، 20)
    سرچاپ "pixel"، p.قرمز، p.سبز، p.آبی
    c.رهاسازی()
    سرچاپ "states"،
        رابط کاربری.حالت پایه،
        رابط کاربری.حالت شناور،
        رابط کاربری.حالت تمرکز،
        رابط کاربری.حالت تمرکز درون،
        رابط کاربری.حالت فعال،
        رابط کاربری.حالت غیرفعال،
        رابط کاربری.حالت تیک خورده،
        رابط کاربری.حالت نامعتبر،
        رابط کاربری.حالت جای نوشته،
        رابط کاربری.حالت گزینش
    args := سیستم عامل.آرگومان ها()
    اگر args.طول() بزرگتر 100:
        interactive()
    پایان
    args.آزادسازی()
پایان
