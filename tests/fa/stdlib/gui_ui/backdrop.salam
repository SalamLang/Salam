واردسازی رابط گرافیکی.رابط کاربری

تابع page(): رشته:
    برگشت `<!doctype html><html lang="en"><head><title>Backdrop</title><style>body{margin:0;background:#fff}.s{position:absolute;width:60px;height:60px}.st{position:absolute;left:0;top:200px;width:360px;height:100px;background:repeating-linear-gradient(90deg,#e33 0 10px,#33e 10px 20px)}.b{position:absolute;width:80px;height:50px}.h:hover{background:#0c0}</style></head><body><div class="s" style="left:10px;top:10px;background:#e33"></div><div class="b" style="left:30px;top:30px;backdrop-filter:invert(1);border-radius:10px"></div><div style="position:absolute;left:130px;top:0;width:110px;height:100px;opacity:0.6"><div class="s" style="left:10px;top:10px;background:rgba(255,0,0,0.5)"></div><div class="b" style="left:20px;top:30px;backdrop-filter:grayscale(1)"></div></div><div class="b" style="left:250px;top:20px;background:#e33"></div><div class="b" style="left:270px;top:40px;backdrop-filter:invert(1);opacity:0.5;background:rgba(0,0,255,0.3)"></div><div style="position:absolute;left:10px;top:100px;width:150px;height:90px;filter:brightness(1)"><div class="s" style="left:0;top:0;background:rgba(255,0,0,0.5)"></div><div class="b" style="left:20px;top:20px;backdrop-filter:invert(1)"></div></div><div class="st"></div><div class="s h" id="h" style="left:300px;top:210px;width:30px;height:30px"></div><div class="b" style="left:20px;top:220px;backdrop-filter:blur(4px)"></div><div class="b" style="left:0;top:220px;width:10px;height:60px;backdrop-filter:blur(6px)"></div><div class="b" style="left:120px;top:210px;width:120px;height:80px;backdrop-filter:sepia(1)"><div class="b" style="left:20px;top:15px;backdrop-filter:invert(1);background:rgba(0,255,0,0.2)"></div></div><div class="b" style="left:270px;top:205px;backdrop-filter:blur(3px) brightness(0.5);pointer-events:none"></div></body></html>`
پایان

تابع probe(x: صحیح، y: صحیح):
    c := رابط کاربری.قاب().پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی
پایان

تابع check(label: رشته):
    partial := رابط کاربری.قاب().چکیده()
    رابط کاربری.بازنگاری کامل()
    full := رابط کاربری.قاب().چکیده()
    سرچاپ label، "same"، partial برابر full
پایان

تابع ریشه:
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 360.0، بلندی = 300.0، بی سر = درست })
    _alive := رابط کاربری.گام(0)
    probe(60، 50)
    probe(100، 70)
    probe(150، 20)
    probe(160، 50)
    probe(200، 80)
    probe(300، 60)
    probe(330، 85)
    probe(15، 110)
    probe(40، 140)
    probe(25، 240)
    probe(5، 250)
    probe(130، 215)
    probe(170، 240)
    probe(200، 270)
    probe(300، 215)
    probe(340، 250)
    رابط کاربری.اجرای گام ها("hover #h")
    check("hover under blur")
    probe(300، 215)
    probe(320، 230)
    رابط کاربری.اجرای گام ها("move 5 5")
    check("leave")
    probe(320، 230)
    رابط کاربری.توقف()
پایان
