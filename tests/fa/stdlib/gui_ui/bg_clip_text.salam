واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ x، y، c.قرمز، c.سبز، c.آبی
پایان

تابع ریشه:
    _f := رابط کاربری.افزودن پرونده قلم("books/fonts/DejaVuSansMono.ttf")
    ناپایا a := رابط کاربری.نگاره(`<!doctype html><html><head><style>body{margin:0;background:#fff;font:40px/50px DejaVu Sans Mono}.t{background:linear-gradient(90deg,#f00,#00f);background-clip:text;color:transparent;width:200px;padding:5px}.v{background:linear-gradient(#ff0,#0ff) text,#333;color:rgba(0,0,0,0);width:200px}.w{background:#0a0;background-clip:text;color:transparent;width:200px}</style></head><body><div class="t">██ <span style="color:rgba(255,255,255,0.5)">█</span></div><div class="v">█ █</div><div class="w">█<b style="display:inline-block">█</b></div></body></html>`، 300، 200)
    سرچاپ "clip text"، a.چکیده()
    probe(a، 10، 30)
    probe(a، 40، 30)
    probe(a، 70، 30)
    probe(a، 90، 30)
    probe(a، 10، 70)
    probe(a، 10، 100)
    probe(a، 30، 85)
    probe(a، 60، 85)
    probe(a، 10، 140)
    probe(a، 40، 140)
    probe(a، 150، 140)
    a.رهاسازی()
پایان
