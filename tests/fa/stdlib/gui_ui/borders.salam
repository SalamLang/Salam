واردسازی رابط گرافیکی.رابط کاربری

تابع page(): رشته:
    برگشت `<!doctype html><html lang="en"><head><title>Borders</title><style>body{margin:0;background:#fff}.b{position:absolute;width:100px;height:60px}</style></head><body><div class="b" style="left:10px;top:10px;border:6px solid transparent;border-radius:14px;background:linear-gradient(#fff,#fff) padding-box,linear-gradient(45deg,#e33,#33e) border-box"></div><div class="b" style="left:140px;top:10px;border:10px solid rgba(0,0,0,0.2);background:linear-gradient(red,blue)"></div><div class="b" style="left:270px;top:10px;padding:8px;border:4px solid #333;background:#9c9 content-box"></div><div class="b" style="left:10px;top:110px;background:radial-gradient(circle at 30% 40%,#ff0,#f0f 60%,#00f)"></div><div class="b" style="left:140px;top:110px;background:linear-gradient(90deg,#000,#fff) 0 0/20px 20px"></div><div class="b" style="left:270px;top:110px;background:conic-gradient(from 45deg,red,yellow,lime,aqua,blue,magenta,red) center/40px 30px no-repeat,#ddd"></div><div class="b" style="left:10px;top:200px;border:10px solid;border-image:linear-gradient(45deg,#e33,#33e) 1"></div><div class="b" style="left:140px;top:200px;border:12px solid;border-image:linear-gradient(to right,#0a0,#ff0,#a0a) 30 / 12px / 4px stretch"></div><div class="b" id="g" style="left:270px;top:200px;border:8px solid red;border-image:linear-gradient(#333,#ccc) 8 fill / 1 / 0 round"></div></body></html>`
پایان

تابع probe(x: صحیح، y: صحیح):
    c := رابط کاربری.قاب().پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی
پایان

تابع check(label: رشته):
    partial := رابط کاربری.قاب().چکیده()
    رابط کاربری.بازنگاری کامل()
    full := رابط کاربری.قاب().چکیده()
    سرچاپ label، "same"، partial برابر full
پایان

تابع ریشه:
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 400.0، بلندی = 300.0، بی سر = درست })
    _alive := رابط کاربری.گام(0)
    probe(40، 13)
    probe(13، 40)
    probe(60، 40)
    probe(150، 15)
    probe(190، 50)
    probe(285، 25)
    probe(275، 15)
    probe(40، 140)
    probe(150، 130)
    probe(165، 130)
    probe(320، 140)
    probe(280، 120)
    probe(15، 240)
    probe(60، 205)
    probe(200، 205)
    probe(145، 230)
    probe(240، 250)
    probe(300، 230)
    probe(275، 205)
    check("first")
    رابط کاربری.اجرای گام ها("resize 380 280")
    check("resize")
    probe(300، 230)
    رابط کاربری.توقف()
پایان
