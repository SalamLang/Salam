واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ x، y، c.قرمز، c.سبز، c.آبی
پایان

تابع ریشه:
    ناپایا a := رابط کاربری.نگاره(`<!doctype html><html><head><style>body{margin:0;background:#fff}table{border-collapse:collapse;margin:10px}td{width:30px;height:20px;padding:0}.a td{border:2px solid #00f}.a td.w{border:6px solid #f00}.a td.d{border:4px dashed #0a0}.b{border:5px solid #888}.b td{border:1px solid #000}.b tr.r{border-bottom:3px solid #c0c}.c td{border:3px solid #08f}.c td.h{border-left-style:hidden}</style></head><body><table class="a"><tr><td></td><td class="w"></td><td></td></tr><tr><td class="d"></td><td></td><td></td></tr></table><table class="b"><tr class="r"><td></td><td></td></tr><tr><td></td><td></td></tr></table><table class="c"><tr><td></td><td class="h"></td><td></td></tr></table></body></html>`، 300، 200)
    سرچاپ "collapsed"، a.چکیده()
    probe(a، 11، 20)
    probe(a، 45، 20)
    probe(a، 11، 50)
    a.رهاسازی()
    ناپایا b := رابط کاربری.نگاره(`<!doctype html><html><head><style>body{margin:0;background:#fff}table{border-collapse:collapse;margin:8px}td{width:24px;height:16px;padding:0}.t1 td{border:3px solid #36c}.t1 td.x{border:3px double #c33}.t1 td.y{border-right:3px dotted #393}.t1 td.z{border-bottom:3px solid #f90}.t2 td{border:1px solid #444}.t2 col.k{border:4px solid #a0a}.t2 tbody{border:3px solid #0aa}.t3{direction:rtl}.t3 td{border:2px solid #555}.t3 td.w{border-left:5px solid #e33}.t4 td{border:6px groove #8a8}.t4 td.r{border-style:ridge}.t4 td.i{border-style:inset}.t4 td.o{border-style:outset}.t5 td{border:2px solid #000}.t5 td.s{border-color:#f00}.t5 td.u{border-color:#00f}</style></head><body><table class="t1"><tr><td></td><td class="x"></td><td class="y"></td></tr><tr><td class="z" colspan="2"></td><td rowspan="2"></td></tr><tr><td></td><td class="x"></td></tr></table><table class="t2"><colgroup><col><col class="k"><col></colgroup><thead><tr><td></td><td></td><td></td></tr></thead><tbody><tr><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td></tr></tbody></table><table class="t3"><tr><td></td><td class="w"></td><td></td></tr><tr><td></td><td></td><td class="w"></td></tr></table><table class="t4"><tr><td></td><td class="r"></td><td class="i"></td><td class="o"></td></tr></table><table class="t5"><tr><td class="s"></td><td class="u"></td></tr><tr><td class="u"></td><td class="s"></td></tr></table></body></html>`، 300، 280)
    سرچاپ "styles"، b.چکیده()
    probe(b، 9، 191)
    probe(b، 9، 194)
    probe(b، 9، 216)
    b.رهاسازی()
پایان
