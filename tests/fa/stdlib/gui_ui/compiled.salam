واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سی اس اس
واردسازی رشته

پایا ROW := "display:flex;gap:12px;padding:16px;background:#f4f6fa"
پایا CARD := "padding:12px;border:2px solid #3366aa;border-radius:10px;box-shadow:0 4px 8px rgba(0,0,0,0.25);background:#ffffff"
پایا CARD_HOVER := "background:#ffeecc"
پایا BTN := "padding:8px 16px;border-radius:6px"
پایا BTN_HOVER := "background:#88aaff"

ناپایا count := 0

تابع compile(p &: سی اس اس.برنامه‌سبک):
    _a := سی اس اس.ترجمه اعلان ها(p، ROW)
    _b := سی اس اس.ترجمه اعلان ها(p، CARD)
    _c := سی اس اس.ترجمه اعلان ها(p، CARD_HOVER)
    _d := سی اس اس.ترجمه اعلان ها(p، BTN)
    _e := سی اس اس.ترجمه اعلان ها(p، BTN_HOVER)
پایان

