پایان

تابع html_view(): رشته:
    ناپایا b := رشته.سازنده()
    رشته.افزودن به بافر(b، `<!doctype html><html lang="en" dir="ltr"><head><title>Cards</title><style>`)
    رشته.افزودن به بافر(b، ".a{" + ROW + "}.card{" + CARD + "}.card:hover{" + CARD_HOVER + "}.b{" + BTN + "}.b:hover{" + BTN_HOVER + "}")
    رشته.افزودن به بافر(b، `</style></head><body><div class="a" id="row">`)
    names := ["Tea"، "Coffee"، "Juice"]
    تکرار 3 در i:
        رشته.افزودن به بافر(b، `<div class="card" key="k` + i + `" id="c` + i + `"><h3>` + names[i] + `</h3><p>Fresh ` + names[i] + `</p></div>`)
    پایان
    رشته.افزودن به بافر(b، `</div><button class="b" id="order" type="button" onclick="order()">Order ` + count + `</button>`)
    اگر count بزرگتر 1:
        رشته.افزودن به بافر(b، `<p id="many" style="width:` + (40 * count) + `px">Many</p>`)
    پایان
    رشته.افزودن به بافر(b، `</body></html>`)
    r := رشته.رشته بافر(b)
    رشته.آزادسازی بافر(b)
    برگشت r
پایان

تابع page(b: رابط کاربری.سازنده‌صفحه):
    b.عنوان صفحه("Cards")
    b.زبان صفحه("en")
    b.جهت صفحه("ltr")
    b.گشودن عنصر("div")
    b.اعلان های عنصر(0، -1، -1، -1)
    b.شناسه عنصر("row")
    names := ["Tea"، "Coffee"، "Juice"]
    تکرار 3 در i:
        b.گشودن عنصر("div")
        b.اعلان های عنصر(1، 2، -1، -1)
        b.کلاس عنصر("card")
        b.کلید عنصر("k" + i)
        b.شناسه عنصر("c" + i)
        b.گشودن عنصر("h3")
        b.متن فرزند(names[i])
        b.بستن عنصر()
        b.گشودن عنصر("p")
        b.متن فرزند("Fresh " + names[i])
        b.بستن عنصر()
        b.بستن عنصر()
    پایان
    b.بستن عنصر()
    b.گشودن عنصر("button")
    b.اعلان های عنصر(3، 4، -1، -1)
    b.شناسه عنصر("order")
    b.ویژگی عنصر("type"، "button")
    b.ویژگی دودویی عنصر("disabled"، نادرست)
    b.رسیدگی رخداد("click"، (): order() پایان)
    b.متن فرزند("Order " + count)
    b.بستن عنصر()
    اگر count بزرگتر 1:
        b.گشودن عنصر("p")
        b.شناسه عنصر("many")
        b.سبک زمان اجرا("width"، (40 * count) + "px")
        b.متن فرزند("Many")
        b.بستن عنصر()
    پایان
پایان

تابع order():
    count++
    ev := رابط کاربری.رخداد جاری()
    سرچاپ "order"، count، ev.گونه رخداد، ev.هدف
پایان

تابع ریشه:
    ناپایا p := سی اس اس.برنامه سبک تازه()
    compile(p)
    ناپایا q := styles()
    سرچاپ "source round trip"، سی اس اس.متن برنامه سبک(p، "styles"، "css") برابر سی اس اس.متن برنامه سبک(q، "styles"، "css")
    p.آزادسازی برنامه()
    q.آزادسازی برنامه()
    steps := "dump\nhash\nhover #c1\nhash\nclick #order\nclick #order\ndump\nhash\nquit"
    سرچاپ "html path"
    رابط کاربری.ثبت رسیدگی("order"، (): order() پایان)
    رابط کاربری.اجرا با((): برگشت html_view() پایان، رابط کاربری.گزینه‌ها { بی سر = درست، پهنا = ۴۸۰.۰، بلندی = ۳۲۰.۰، گام های آزمایشی = steps })
    count = 0
    سرچاپ "compiled path"
    رابط کاربری.اجرای ترجمه شده با((): برگشت styles() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان، رابط کاربری.گزینه‌ها { بی سر = درست، پهنا = ۴۸۰.۰، بلندی = ۳۲۰.۰، گام های آزمایشی = steps })
    count = 0
    اگر count بزرگتر 99:
        رابط کاربری.اجرای ترجمه شده((): برگشت styles() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان)
    پایان
    ناپایا a := رابط کاربری.نگاره(html_view()، 480، 320)
    ناپایا c := رابط کاربری.نگاره ترجمه شده((): برگشت styles() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان، 480، 320)
    سرچاپ "render same"، a.چکیده() برابر c.چکیده()، a.پهنا، c.بلندی
    a.رهاسازی()
    c.رهاسازی()
پایان
