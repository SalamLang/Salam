واردسازی رابط گرافیکی.رابط کاربری

ناپایا changes := ""
ناپایا submitted := 0

تابع page(): رشته:
    برگشت `<!doctype html><html lang="en" dir="ltr"><head><title>Controls</title></head><body><form id="f" onsubmit="sent(event)"><label for="agree" id="agree-label">I agree</label><input id="agree" type="checkbox" onchange="changed(event)"><input id="r1" type="radio" name="size" value="s" checked><input id="r2" type="radio" name="size" value="m" onchange="changed(event)"><input id="q" type="text" placeholder="Search" value="start"><input id="pw" type="password"><input id="num" type="number"><select id="pick" onchange="changed(event)"><option value="a">Apple</option><option value="b">Banana</option><option value="c">Cherry</option></select><input id="vol" type="range" min="0" max="10" value="5"><textarea id="note" rows="3">line</textarea><button id="go">Send</button></form><details id="more"><summary id="sum">More</summary><p id="inside">Inside</p></details><progress value="7" max="10"></progress><meter value="0.25"></meter></body></html>`
پایان

تابع show(id: رشته):
    e := رابط کاربری.با شناسه(id)
    سرچاپ id، "value"، e.مقدار عنصر()، "checked"، e.تیک خورده است()
پایان

تابع ریشه:
    _f := رابط کاربری.افزودن پرونده قلم("books/fonts/XB Zar.ttf")
    رابط کاربری.ثبت رسیدگی("changed"، ():
        ev := رابط کاربری.رخداد جاری()
        changes += ev.هدف + "=" + ev.مقدار + "/" + ev.تیک خورده + " "
    پایان)
    رابط کاربری.ثبت رسیدگی("sent"، (): submitted++ پایان)
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 700.0، بلندی = 400.0، بی سر = درست })
    رابط کاربری.اجرای گام ها(`click #agree-label
click #r2
click #q
key ctrl+a
type replaced
key shift+Left
key shift+Left
key Delete
click #pw
type secret
click #num
type 4x2
key Enter`)
    show("agree")
    show("r1")
    show("r2")
    show("q")
    show("pw")
    show("num")
    سرچاپ "submitted"، submitted
    رابط کاربری.اجرای گام ها(`click #pick
key Down
key Down
key Enter
click #vol
key Right
key Right
click #note
key End
key Enter
type more
click #sum
dump`)
    show("pick")
    show("vol")
    show("note")
    سرچاپ "changes"، changes
    رابط کاربری.با شناسه("q").تنظیم مقدار("set from code")
    رابط کاربری.با شناسه("agree").تنظیم تیک(نادرست)
    رابط کاربری.با شناسه("more").تنظیم ویژگی("title"، "x")
    رابط کاربری.با شناسه("go").افزودن کلاس("primary")
    سرچاپ "has class"، رابط کاربری.با شناسه("go").دارای کلاس("primary")، "attr"، رابط کاربری.با شناسه("more").ویژگی("title")
    رابط کاربری.اجرای گام ها(`click #sum
click #go`)
    show("q")
    show("agree")
    سرچاپ "submitted"، submitted، "inside"، رابط کاربری.با شناسه("inside").مستطیل().height
    رابط کاربری.توقف()
پایان
