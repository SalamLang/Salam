واردسازی رابط گرافیکی.رابط کاربری

ناپایا inputs := 0

تابع page(): رشته:
    برگشت `<!doctype html><html lang="en"><head><title>Editing</title><style>body{margin:0;font:16px sans-serif}textarea{width:120px;height:60px}input{width:100px}</style></head><body><input id="i" value="hello world wide web" oninput="changed()"><br><textarea id="t">one two three
four five six
seven eight nine
ten eleven twelve
thirteen</textarea><textarea id="w" wrap="off">a very long line that does not wrap at all</textarea><input id="p" value="سلام دنیا abc" dir="rtl"></body></html>`
پایان

تابع changed():
    inputs++
پایان

تابع check(label: رشته):
    partial := رابط کاربری.قاب().چکیده()
    رابط کاربری.بازنگاری کامل()
    full := رابط کاربری.قاب().چکیده()
    سرچاپ label، "same"، partial برابر full
پایان

تابع ریشه:
    _f := رابط کاربری.افزودن پرونده قلم("books/fonts/XB Zar.ttf")
    رابط کاربری.ثبت رسیدگی("changed"، (): changed() پایان)
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 400.0، بلندی = 240.0، بی سر = درست })
    _alive := رابط کاربری.گام(0)
    رابط کاربری.اجرای گام ها("click #i\nkey End\nsel\nkey shift+Left\nkey shift+Left\nsel\nwait 1000\ndblclick #i\nsel\nwait 1000\ntripleclick #i\nsel")
    check("input")
    رابط کاربری.اجرای گام ها("wait 1000\nclick #t\nkey ctrl+End\nsel\nkey Up\nkey Up\nsel\nkey Home\nsel\nkey shift+End\nsel\nwait 1000\ntripleclick #t\nsel")
    check("textarea")
    رابط کاربری.اجرای گام ها("wait 1000\nclick #t\nkey ctrl+Home\nsel\nscroll #t 40\nsel\nscroll #t 400\nsel")
    check("wheel")
    رابط کاربری.اجرای گام ها("wait 1000\nclick #w\nkey End\nsel\nkey Home\nsel")
    check("no wrap")
    رابط کاربری.اجرای گام ها("wait 1000\nclick #i\nkey End\nime سل\nsel\nime سلا\nsel")
    check("preedit")
    رابط کاربری.اجرای گام ها("commit سلام\nsel")
    سرچاپ رابط کاربری.با شناسه("i").مقدار عنصر()، "inputs"، inputs
    رابط کاربری.اجرای گام ها("wait 1000\nclick #p\nkey Home\nsel\nkey Left\nkey Left\nsel\nkey Right\nsel\nkey shift+Left\nsel\ntype ب\nsel")
    check("rtl")
    سرچاپ رابط کاربری.با شناسه("p").مقدار عنصر()
    رابط کاربری.اجرای گام ها("wait 1000\ndrag 10 10 60 10\nsel")
    check("drag select")
    رابط کاربری.توقف()
