واردسازی رابط گرافیکی.رابط کاربری

ناپایا n := 0

تابع page(): رشته:
    برگشت `<!doctype html><html lang="en"><head><title>Effects</title><style>body{margin:0;font:18px sans-serif}.bar{position:absolute;top:0;width:10px;height:300px;background:#000}.f{position:absolute;left:20px;top:20px;width:60px;height:40px;background:rgb(200,60,20)}.f:hover{filter:grayscale(1) blur(2px)}.d{position:absolute;left:120px;top:20px;width:60px;height:40px;background:#36c;filter:drop-shadow(4px 4px 3px rgba(0,0,0,.6))}.g{position:absolute;left:30px;top:100px;width:120px;height:60px;backdrop-filter:blur(3px);border-radius:8px}.t{position:absolute;left:200px;top:110px;text-shadow:2px 2px 2px #0a0,-1px 0 0 #f00}.o{position:absolute;left:220px;top:200px;width:60px;height:40px;outline:3px dotted #00f;outline-offset:5px;border:3px dashed #c00;border-radius:14px}</style></head><body><div class="bar" style="left:40px"></div><div class="bar" style="left:100px"></div><div class="f" id="f"></div><div class="d"></div><div class="g" id="g" onclick="hit()"></div><div class="t">Shadow ` + n + `</div><div class="o"></div></body></html>`
پایان

تابع hit():
    n++
پایان

تابع probe(x: صحیح، y: صحیح):
    c := رابط کاربری.قاب().پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی
پایان

تابع check(label: رشته):
    partial := رابط کاربری.قاب().چکیده()
    رابط کاربری.بازنگاری کامل()
    full := رابط کاربری.قاب().چکیده()
    سرچاپ label، "same"، partial برابر full
پایان

تابع ریشه:
    رابط کاربری.ثبت رسیدگی("hit"، (): hit() پایان)
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 360.0، بلندی = 300.0، بی سر = درست })
    _alive := رابط کاربری.گام(0)
    probe(50، 40)
    probe(186، 64)
    probe(46، 130)
    probe(70، 130)
    probe(10، 200)
    رابط کاربری.اجرای گام ها("hover #f")
    check("hover filter")
    probe(50، 40)
    probe(22، 22)
    رابط کاربری.اجرای گام ها("click #g")
    check("click under backdrop")
    رابط کاربری.اجرای گام ها("move 350 290")
    check("leave")
    سرچاپ "n"، n
    رابط کاربری.توقف()
پایان
