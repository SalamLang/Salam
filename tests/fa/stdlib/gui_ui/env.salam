واردسازی رابط گرافیکی.رابط کاربری

ناپایا seen_w := 0
ناپایا seen_h := 0
ناپایا seen_rtl := نادرست

تابع none(): وکتور<رابط کاربری.وصله‌سبک>:
    برگشت رابط کاربری.بی وصله()
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.محیط صفحه(
        (w: صحیح، h: صحیح، _dark: منطقی، _touch: منطقی، _reduced: منطقی، _contrast: منطقی، rtl: منطقی): seen_w = w
        seen_h = h
        seen_rtl = rtl پایان
    )
    b.جهت صفحه("rtl")
    b.گشودن عنصر("box")
    b.شناسه عنصر("a")
    b.بستن عنصر()
پایان

تابع ریشه():
    _d := رابط کاربری.گزارش صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 320، 200)
    سرچاپ seen_w، seen_h، seen_rtl
    _e := رابط کاربری.گزارش صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 800، 600)
    سرچاپ seen_w، seen_h، seen_rtl
پایان
