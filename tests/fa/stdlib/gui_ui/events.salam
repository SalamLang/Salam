واردسازی رابط گرافیکی.رابط کاربری

ناپایا count := 0
ناپایا typed := ""
ناپایا keys := ""
ناپایا log := ""
ناپایا page := 1

تابع home(): رشته:
    برگشت `<!doctype html><html lang="en" dir="ltr"><head><title>Events</title><style>button{padding:4px 8px}button:hover{background:rgb(200, 220, 255)}button:focus{outline:2px solid blue}.big{font-size:20px}</style></head><body><h1 class="big" id="title">Count ` + count + `</h1><button id="inc" onclick="__sl_ev_1()">Add</button><button id="dec" onclick="window['dec one'](event)" ondblclick="dbl()">Less</button><input id="name" type="text" oninput="typed(event)" onkeydown="key(event)"><p id="echo">` + typed + `</p><div id="outer" onclick="outer()"><span id="inner">inner text</span></div><a id="ext" href="https://example.com/x">site</a> <a id="next" href="/second">next page</a><button id="last" tabindex="1">first in tab order</button></body></html>`
پایان

تابع second(): رشته:
    برگشت `<!doctype html><html><head><title>Second</title></head><body><p id="msg">second page</p><a id="back" href="/">back</a></body></html>`
پایان

تابع ریشه:
    _f := رابط کاربری.افزودن پرونده قلم("books/fonts/XB Zar.ttf")
    رابط کاربری.ثبت رسیدگی("__sl_ev_1"، (): count++ پایان)
    رابط کاربری.ثبت رسیدگی("dec one"، ():
        count--
        log += "dec(" + رابط کاربری.رخداد جاری().گونه رخداد + "," + رابط کاربری.رخداد جاری().هدف + ") "
    پایان)
    رابط کاربری.ثبت رسیدگی("dbl"، (): log += "dbl " پایان)
    رابط کاربری.ثبت رسیدگی("typed"، ():
        typed = رابط کاربری.رخداد جاری().مقدار
    پایان)
    رابط کاربری.ثبت رسیدگی("key"، ():
        keys += رابط کاربری.رخداد جاری().کلید + " "
    پایان)
    رابط کاربری.ثبت رسیدگی("outer"، ():
        log += "outer(" + رابط کاربری.رخداد جاری().هدف + ") "
    پایان)
    رابط کاربری.تنظیم بازکننده نشانی((url: رشته): برگشت url.طول() بزرگتر 0 پایان)
    رابط کاربری.صفحه برنامه("/second"، (): برگشت second() پایان)
    رابط کاربری.صفحه برنامه("/"، (): برگشت home() پایان)
    ok := رابط کاربری.آغاز((): برگشت home() پایان، رابط کاربری.گزینه‌ها { پهنا = 480.0، بلندی = 320.0، بی سر = درست })
    سرچاپ "started"، ok، رابط کاربری.پنجره جاری().عنوان پنجره()
    رابط کاربری.اجرای گام ها(`click #inc
click #inc
click #inc
dump`)
    سرچاپ "count"، count
    رابط کاربری.اجرای گام ها(`hover #dec`)
    s := رابط کاربری.با شناسه("dec").سبک محاسبه شده()
    سرچاپ "hover background"، s.رنگ پس زمینه.قرمز، s.رنگ پس زمینه.سبز، s.رنگ پس زمینه.آبی
    رابط کاربری.اجرای گام ها(`click #dec
dblclick #dec
click #name
type hello
key Backspace
key Left
type X
focus`)
    سرچاپ "count"، count، "typed"، typed، "keys"، keys
    سرچاپ "value"، رابط کاربری.با شناسه("name").مقدار عنصر()، "echo"، رابط کاربری.با شناسه("echo").متن عنصر()
    رابط کاربری.اجرای گام ها(`click #inner
key Tab
focus
key Tab
focus
key shift+Tab
focus
click #ext`)
    سرچاپ "log"، log
    urls := رابط کاربری.نشانی های باز شده()
    سرچاپ "opened"، urls.طول()، urls[0]
    رابط کاربری.اجرای گام ها(`click #next
dump
click #back`)
    سرچاپ "title back"، رابط کاربری.با شناسه("title").متن عنصر()، "frames"، رابط کاربری.شمار قاب() بزرگتر 0
    رابط کاربری.توقف()
پایان
