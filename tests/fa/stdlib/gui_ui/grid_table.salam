واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، label: رشته، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ label، x، y، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    grid := `<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"><title>Grid</title><style>*{box-sizing:border-box}body{margin:0}.g{display:grid;grid-template-columns:100px 1fr 2fr;grid-template-rows:40px auto;gap:10px 6px;width:400px;padding:5px;background:#eee}.g div{background:#88c}.a{grid-column:1 / 3;height:20px}.b{grid-row:span 2;width:30px;justify-self:end}.c{height:50px}.d{grid-column:2 / -1;height:15px;align-self:end}.h{display:grid;grid-template-areas:"head head" "side main";grid-template-columns:80px 1fr;grid-auto-rows:minmax(30px, auto);width:300px;margin-top:12px}.h div{background:#c88}.hd{grid-area:head}.sd{grid-area:side}.mn{grid-area:main;height:60px}.r{display:grid;grid-template-columns:repeat(auto-fill, minmax(70px, 1fr));gap:4px;width:250px;margin-top:8px}.r div{height:18px;background:#8c8}</style></head><body><div class="g" id="g"><div class="a" id="ga"></div><div class="b" id="gb"></div><div class="c" id="gc"></div><div class="d" id="gd"></div><div id="ge"></div></div><div class="h" id="h"><div class="hd" id="hd"></div><div class="sd" id="sd"></div><div class="mn" id="mn"></div></div><div class="r" id="r"><div id="r1"></div><div id="r2"></div><div id="r3"></div><div id="r4"></div></div></body></html>`
    چاپ رابط کاربری.گزارش سند(grid، 640، 320)
    ناپایا cv := رابط کاربری.نگاره(grid، 640، 320)
    probe(cv، "grid gap"، 107، 30)
    probe(cv، "grid item"، 20، 15)
    probe(cv، "area main"، 150، 200)
    probe(cv، "auto fill"، 166، 260)
    cv.رهاسازی()
    table := `<!doctype html><html lang="en" dir="ltr"><head><meta charset="utf-8"><title>Table</title><style>*{box-sizing:border-box}body{margin:0}caption{text-align:left}table{border-spacing:4px 2px;background:#eee}td,th{padding:3px;border:1px solid #444;background:#cce}.w60{width:60px}.h40{height:40px}.x{display:block;width:30px;height:10px;background:#448}.y{display:block;width:70px;height:16px;background:#844}table.c{border-collapse:collapse;margin-top:10px;width:300px}table.c td{border:2px solid #222}</style></head><body><table id="t1"><caption><span class="x" id="cap"></span></caption><thead><tr id="hr"><th id="h1"><span class="x"></span></th><th id="h2" colspan="2"><span class="y"></span></th></tr></thead><tbody><tr id="r1"><td id="c11" class="w60"><span class="x"></span></td><td id="c12" rowspan="2" style="vertical-align:middle"><span class="x" id="mid"></span></td><td id="c13" class="h40"><span class="y"></span></td></tr><tr id="r2"><td id="c21"><span class="y"></span></td><td id="c23" style="vertical-align:bottom"><span class="x" id="bot"></span></td></tr></tbody></table><table class="c" id="t2"><tr><td id="d1"><span class="x"></span></td><td id="d2"><span class="y"></span></td></tr><tr><td id="d3" colspan="2"><span class="x"></span></td></tr></table></body></html>`
    چاپ رابط کاربری.گزارش سند(table، 640، 200)
    ناپایا tv := رابط کاربری.نگاره(table، 640، 200)
    probe(tv، "spacing"، 2، 20)
    probe(tv، "cell"، 40، 45)
    probe(tv، "cell border"، 4، 45)
    probe(tv، "collapsed edge"، 98، 130)
    probe(tv، "collapsed inside"، 60، 130)
    probe(tv، "collapsed outer"، 0، 130)
    tv.رهاسازی()
پایان
