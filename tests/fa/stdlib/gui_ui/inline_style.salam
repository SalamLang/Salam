واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سی اس اس

ناپایا wide := نادرست

تابع styles(): سی اس اس.برنامه‌سبک:
    ناپایا p := سی اس اس.برنامه سبک تازه()
    _a := سی اس اس.ترجمه اعلان ها(p، "width:50px;height:10px;background:#00f")
    _b := سی اس اس.ترجمه اعلان ها(p، "width:90px;height:12px")
    _c := سی اس اس.ترجمه سی اس اس(p، "body{margin:0;font-size:0;line-height:0}#d{width:70px!important}div#x.k{width:80px;height:6px}#t{height:5px}")
    برگشت p
پایان

تابع page(b: رابط کاربری.سازنده‌صفحه):
    b.گشودن عنصر("div")
    b.اعلان های عنصر(0، 1، -1، -1)
    b.شناسه عنصر("a")
    b.سبک زمان اجرا("width"، wide ? "30px" : "20px")
    b.بستن عنصر()
    b.گشودن عنصر("div")
    b.شناسه عنصر("x")
    b.کلاس عنصر("k")
    b.ویژگی عنصر("style"، "width:25px")
    b.بستن عنصر()
    b.گشودن عنصر("div")
    b.اعلان های عنصر(0، -1، -1، -1)
    b.شناسه عنصر("d")
    b.سبک زمان اجرا("width"، "15px")
    b.بستن عنصر()
    b.گشودن عنصر("div")
    b.شناسه عنصر("t")
    b.رسیدگی رخداد("click"، (): wide = وارونه wide پایان)
    b.بستن عنصر()
پایان

تابع ریشه:
    چاپ رابط کاربری.گزارش سند(`<!doctype html><html><head><style>body{margin:0;font-size:0;line-height:0}#a{width:50px;height:10px}div.box#b.x{width:60px!important;height:10px}.c{height:30px}div div#d.c{width:70px}.e{width:40px!important}</style></head><body><div id="a" style="width:20px;height:5px"></div><div id="b" class="box x" style="width:25px"></div><div class="c" style="height:8px;width:33px"></div><div><div id="d" class="c" style="width:12px;height:4px"></div></div><div class="e" style="width:15px!important;height:3px"></div><img width="44" height="6" style="width:22px"></body></html>`، 640، 480)
    steps := "dump\nhover #a\ndump\nclick #t\ndump\nquit"
    رابط کاربری.اجرای ترجمه شده با((): برگشت styles() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان، رابط کاربری.گزینه‌ها { بی سر = درست، پهنا = ۳۲۰.۰، بلندی = ۲۰۰.۰، گام های آزمایشی = steps })
پایان
