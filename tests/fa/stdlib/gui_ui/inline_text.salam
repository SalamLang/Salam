واردسازی رابط گرافیکی.رابط کاربری

تابع ریشه:
    _a := رابط کاربری.افزودن پرونده قلم("books/fonts/XB Zar.ttf")
    _b := رابط کاربری.افزودن پرونده قلم("books/fonts/DejaVuSansMono.ttf")
    fa := `<!doctype html><html lang="fa" dir="rtl"><head><title>متن</title><style>code{background:#eee}.c{text-align:center}.w{width:160px;border:1px solid #999}mark{background:yellow}</style></head><body><p id="mix">این یک <b id="bold">جمله</b> با <a id="link" href="#mix">پیوند</a> و <code id="code">code()</code> و عدد ۱۲۳ و English text است.</p><p class="w" id="wrap">متنی بلند که باید در چند خط شکسته شود تا شکستن خط آزموده شود.</p><p class="c" id="center">وسط<br>چین</p><ol><li>اول</li><li>دوم</li></ol><p id="ltr" dir="ltr">Left to right with <mark id="m">سلام</mark> inside.</p></body></html>`
    چاپ رابط کاربری.گزارش سند(fa، 360، 400)
    ناپایا cv := رابط کاربری.نگاره(fa، 360، 400)
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
    en := `<!doctype html><html lang="en"><head><style>pre{margin:0}.ls{letter-spacing:3px}</style></head><body><pre id="pre">a  b
  c</pre><p class="ls" id="ls">spaced</p><p id="u"><u>under</u> <s>strike</s> <small>small</small> <sub>sub</sub></p></body></html>`
    چاپ رابط کاربری.گزارش سند(en، 300، 200)
پایان
