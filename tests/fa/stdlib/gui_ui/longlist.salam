واردسازی رابط گرافیکی.رابط کاربری
واردسازی رشته

ناپایا picked := -1

تابع page(): رشته:
    ناپایا b := رشته.سازنده()
    رشته.افزودن به بافر(b، `<!doctype html><html lang="en"><head><title>List</title><style>body{margin:0}#list{height:200px;overflow:auto;border:1px solid #ccc}.it{height:20px;border-bottom:1px solid #eee}.it:hover{background:#eef}.sel{background:#fd8}</style></head><body><div id="list">`)
    تکرار 2000 در i:
        رشته.افزودن به بافر(b، `<div class="it` + (i برابر picked ? " sel" : "") + `" id="i` + i + `" onclick="pick()"></div>`)
    پایان
    رشته.افزودن به بافر(b، `</div></body></html>`)
    r := رشته.رشته بافر(b)
    رشته.آزادسازی بافر(b)
    برگشت r
پایان

تابع pick():
    t := رابط کاربری.رخداد جاری().هدف
    picked = t.زیررشته(1، t.طول() - 1).به صحیح()
پایان

تابع check(label: رشته):
    partial := رابط کاربری.قاب().چکیده()
    رابط کاربری.بازنگاری کامل()
    full := رابط کاربری.قاب().چکیده()
    سرچاپ label، "same"، partial برابر full، "picked"، picked
پایان

تابع ریشه:
    رابط کاربری.ثبت رسیدگی("pick"، (): pick() پایان)
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 300.0، بلندی = 240.0، بی سر = درست })
    _alive := رابط کاربری.گام(0)
    رابط کاربری.اجرای گام ها("move 100 50")
    check("hover")
    رابط کاربری.اجرای گام ها("scroll #list 400")
    check("scroll")
    رابط کاربری.اجرای گام ها("drag 100 15 100 15")
    check("click after scroll")
    رابط کاربری.اجرای گام ها("scroll #list 4000")
    check("scroll further")
    رابط کاربری.اجرای گام ها("drag 100 190 100 190")
    check("click last rows")
    رابط کاربری.اجرای گام ها("click #i5")
    check("script click")
    رابط کاربری.توقف()
پایان
