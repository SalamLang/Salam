واردسازی رابط گرافیکی.رابط کاربری
واردسازی رشته

ناپایا picked := -1

تابع page(): رشته:
    ناپایا b := رشته.سازنده()
    رشته.افزودن به بافر(b، `<!doctype html><html lang="en"><head><title>Rows</title><style>body{margin:0}#list{height:200px;overflow:auto;border:1px solid #ccc}.it{height:20px;border-bottom:1px solid #eee;font-size:12px}</style></head><body><div id="list">`)
    تکرار 1000 در i:
        رشته.افزودن به بافر(b، `<div class="it" tabindex="0" id="i` + i + `" onclick="pick()"><span id="s` + i + `">Row ` + i + `</span></div>`)
    پایان
    رشته.افزودن به بافر(b، `</div></body></html>`)
    r := رشته.رشته بافر(b)
    رشته.آزادسازی بافر(b)
    برگشت r
پایان

تابع pick():
    t := رابط کاربری.رخداد جاری().هدف
    picked = t.زیررشته(1، t.طول() - 1).به صحیح()
    سرچاپ "picked"، picked
پایان

تابع show(id: رشته):
    r := رابط کاربری.با شناسه(id).مستطیل()
    سرچاپ id، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع scroll():
    سرچاپ "scrollTop"، 1 - رابط کاربری.با شناسه("i0").مستطیل().ایگرگ
پایان

تابع ریشه:
    _f := رابط کاربری.افزودن پرونده قلم("books/fonts/DejaVuSansMono.ttf")
    رابط کاربری.ثبت رسیدگی("pick"، (): pick() پایان)
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 300.0، بلندی = 240.0، بی سر = درست })
    _s := رابط کاربری.گام(0)
    show("i0")
    show("i500")
    show("s500")
    رابط کاربری.با شناسه("i500").تمرکز()
    _s2 := رابط کاربری.گام(0)
    show("i500")
    scroll()
    رابط کاربری.با شناسه("i505").تمرکز()
    _s3 := رابط کاربری.گام(0)
    scroll()
    رابط کاربری.با شناسه("i400").تمرکز()
    _s4 := رابط کاربری.گام(0)
    scroll()
    رابط کاربری.با شناسه("i700").نمایان کردن()
    _s5 := رابط کاربری.گام(0)
    scroll()
    show("i700")
    رابط کاربری.اجرای گام ها("click #i900")
    scroll()
    رابط کاربری.اجرای گام ها("reveal #i20")
    scroll()
    رابط کاربری.توقف()
پایان
