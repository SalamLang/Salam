واردسازی رابط گرافیکی.رابط کاربری
واردسازی رشته

ناپایا picked := -1

تابع page(): رشته:
    ناپایا b := رشته.سازنده()
    رشته.افزودن به بافر(b، `<!doctype html><html lang="en"><head><title>Rows</title><style>body{margin:0}#list{height:200px;overflow:auto;border:1px solid #ccc}.it{height:20px;border-bottom:1px solid #eee;font-size:12px}</style></head><body><div id="list">`)
    تکرار 10000 در i:
        رشته.افزودن به بافر(b، `<div class="it" tabindex="0" id="i` + i + `" onclick="pick()">Row ` + i + `</div>`)
    پایان
    رشته.افزودن به بافر(b، `</div></body></html>`)
    r := رشته.رشته بافر(b)
    رشته.آزادسازی بافر(b)
    برگشت r
پایان

تابع pick():
    t := رابط کاربری.رخداد جاری().هدف
    picked = t.زیررشته(1، t.طول() - 1).به صحیح()
    سرچاپ "picked"، picked
پایان

تابع show(id: رشته):
    r := رابط کاربری.با شناسه(id).مستطیل()
    سرچاپ id، r.ایگرگ، r.بلندی
پایان

تابع ریشه:
    _f := رابط کاربری.افزودن پرونده قلم("books/fonts/DejaVuSansMono.ttf")
    رابط کاربری.ثبت رسیدگی("pick"، (): pick() پایان)
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 300.0، بلندی = 240.0، بی سر = درست })
    _s := رابط کاربری.گام(0)
    سرچاپ "first layout boxes"، رابط کاربری.شمار چینش آخر() کوچکتر 100
    show("i0")
    show("i5000")
    رابط کاربری.اجرای گام ها("scroll #list 1000000")
    show("i9999")
    رابط کاربری.اجرای گام ها("click #i9999")
    رابط کاربری.اجرای گام ها("scroll #list -1000000")
    show("i0")
    show("i9999")
    رابط کاربری.با شناسه("i9998").تمرکز()
    رابط کاربری.اجرای گام ها("key Tab")
    رابط کاربری.اجرای گام ها("focus")
    show("i9999")
    رابط کاربری.اجرای گام ها("click #i9999")
    رابط کاربری.اجرای گام ها("scroll #list -400")
    رابط کاربری.اجرای گام ها("click #i9975")
    رابط کاربری.توقف()
پایان
