واردسازی رابط گرافیکی.رابط کاربری

تابع probe(label: رشته، x: صحیح، y: صحیح):
    c := رابط کاربری.قاب().پیکسل(x، y)
    سرچاپ label، c.قرمز، c.سبز، c.آبی
پایان

تابع ریشه:
    _f := رابط کاربری.افزودن پرونده قلم("books/fonts/XB Zar.ttf")
    doc := `<!doctype html>
<html lang="en" dir="ltr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Cards</title>
  <style>
.a { display: flex; gap: 12px; padding: 16px; background: #f4f6fa;  }
.card { padding: 12px; border: 2px solid #3366aa; border-radius: 10px; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.25); background: #ffffff;  }
.card:hover { background: #ffeecc;  }
.b { padding: 8px 16px; border-radius: 6px;  }
.b:hover { background: #88aaff;  }
  </style>
</head>
<body>
<div class="a" id="row">
  <div class="card">
    <h3>Tea</h3>
    <p>Fresh Tea</p>
  </div>
  <div class="card">
    <h3>Coffee</h3>
    <p>Fresh Coffee</p>
  </div>
  <div class="card">
    <h3>Juice</h3>
    <p>Fresh Juice</p>
  </div>
</div>
<button class="b" id="order">Order</button>
</body>
</html>`
    _ok := رابط کاربری.آغاز سند(doc، رابط کاربری.گزینه‌ها { پهنا = 420.0، بلندی = 260.0، بی سر = درست })
    _alive := رابط کاربری.گام(0)
    چاپ رابط کاربری.گزارش درخت()
    first := رابط کاربری.قاب().چکیده()
    probe("card"، 40، 40)
    probe("card border"، 25، 60)
    probe("row background"، 12، 12)
    probe("shadow below card"، 60، 162)
    رابط کاربری.اجرای گام ها(`hover .card`)
    probe("hovered card"، 40، 40)
    سرچاپ "damage rects"، رابط کاربری.شمار آسیب آخر()
    partial := رابط کاربری.قاب().چکیده()
    رابط کاربری.بازنگاری کامل()
    سرچاپ "partial equals full"، partial برابر رابط کاربری.قاب().چکیده()
    رابط کاربری.اجرای گام ها(`hover #order`)
    probe("card after leave"، 40، 40)
    b := رابط کاربری.با شناسه("order").مستطیل()
    probe("hovered button"، (b.ایکس + 4.0) برگردان صحیح، (b.ایگرگ + 4.0) برگردان صحیح)
    ناپایا cv := رابط کاربری.نگاره(doc، 420، 260)
    سرچاپ "render equals first frame"، cv.چکیده() برابر first
    cv.رهاسازی()
    رابط کاربری.توقف()
پایان
