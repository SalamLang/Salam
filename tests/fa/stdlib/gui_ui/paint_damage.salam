// زبان: فارسی
واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک

ناپایا وهیکه := 0
ناپایا گام := 0

تابع ستی(ب: رابط کاربری.سازنده‌صفحه، کلید: رشته، مقدار: رشته):
    ب.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی با نام(کلید)، مقدار)
پایان

تابع پیکک(اندیس: صحیح، بیفوری: رشته، افتیر: رشته): رشته:
    اگر گام برابر 1 و وهیکه برابر اندیس:
        برگشت افتیر
    پایان
    برگشت بیفوری
پایان

تابع کیلل(ب: رابط کاربری.سازنده‌صفحه، چپ: صحیح، بالا: صحیح، بگ: رشته):
    ب.گشودن عنصر("box")
    ستی(ب، "position"، "absolute")
    ستی(ب، "left"، "" + چپ)
    ستی(ب، "top"، "" + بالا)
    ستی(ب، "width"، "50")
    ستی(ب، "height"، "40")
    ستی(ب، "background"، بگ)
پایان

تابع وییو(ب: رابط کاربری.سازنده‌صفحه):
    ب.گشودن عنصر("box")
    ستی(ب، "background"، "#eeeeee")
    کیلل(ب، 10، 10، پیکک(0، "#ff0000"، "#0000ff"))
    ب.بستن عنصر()
    کیلل(ب، 80، 10، "#ffffff")
    ستی(ب، "shadow"، پیکک(1، "[4, 4, 6, 0, #00000080]"، "[12, 10, 10, 2, #ff000080]"))
    ب.بستن عنصر()
    کیلل(ب، 150، 10، "#ffffff")
    ستی(ب، "outline"، پیکک(2، "2, solid, #ff0000"، "6, dashed, #0000ff"))
    ستی(ب، "outline offset"، "3")
    ب.بستن عنصر()
    کیلل(ب، 220، 10، "#ffffff")
    ستی(ب، "blur"، پیکک(3، "1"، "6"))
    ب.گشودن عنصر("box")
    ستی(ب، "width"، "20")
    ستی(ب، "height"، "20")
    ستی(ب، "background"، "#00aa00")
    ب.بستن عنصر()
    ب.بستن عنصر()
    کیلل(ب، 10، 80، "#008800")
    ستی(ب، "rotate"، پیکک(4، "10"، "40"))
    ب.بستن عنصر()
    کیلل(ب، 80، 80، "#cc6600")
    ستی(ب، "opacity"، پیکک(5، "1"، "0.4"))
    ب.گشودن عنصر("box")
    ستی(ب، "width"، "20")
    ستی(ب، "height"، "20")
    ستی(ب، "background"، "#000000")
    ب.بستن عنصر()
    ب.بستن عنصر()
    کیلل(ب، 150، 80، "linear(90, #ff0000, #0000ff)")
    ب.بستن عنصر()
    کیلل(ب، 165، 90، "#ffffff40")
    ستی(ب، "backdrop blur"، "4")
    ستی(ب، "radius"، پیکک(6، "4"، "16"))
    ب.بستن عنصر()
    کیلل(ب، 220، 80، "#336699")
    ستی(ب، "scale"، پیکک(7، "1"، "1.5"))
    ستی(ب، "skew"، پیکک(7، "0"، "15"))
    ب.بستن عنصر()
    ب.گشودن عنصر("paragraph")
    ستی(ب، "position"، "absolute")
    ستی(ب، "left"، "10")
    ستی(ب، "top"، "140")
    ستی(ب، "text shadow"، "[1, 1, 2, #00000080]")
    ستی(ب، "decoration"، پیکک(8، "none"، "underline"))
    ب.متن فرزند(پیکک(8، "partial"، "partial paint"))
    ب.بستن عنصر()
    ب.بستن عنصر()
پایان

تابع اجرا(نام: رشته، کاسی: صحیح، سکالی: اعشار۶۴):
    وهیکه = کاسی
    گام = 0
    نپ := (): برگشت رابط کاربری.بی وصله() پایان
    وو := (ب: رابط کاربری.سازنده‌صفحه): وییو(ب) پایان
    باز := رابط کاربری.گشودن بوم بی پنجره(نپ، وو، 300، 180، سکالی)
    اگر باز برابر نادرست:
        سرچاپ "open failed"
    پایان
    گام = 1
    اریا := رابط کاربری.به روز رسانی بوم بی پنجره(درست)
    پارت := رابط کاربری.بوم بی پنجره().چکیده()
    رابط کاربری.نقاشی دوباره همه بوم بی پنجره()
    اگاین := رابط کاربری.بوم بی پنجره().چکیده()
    رابط کاربری.بستن بوم بی پنجره()
    فولل := رابط کاربری.نگاره صفحه با مقیاس(نپ، وو، 300، 180، سکالی)
    فه := فولل.چکیده()
    فولل.رهاسازی()
    سرچاپ نام، سکالی، "damaged"، اریا بزرگتر 0، "same"، پارت برابر فه، "repaint all"، اگاین برابر فه
پایان

تابع ریشه:
    افزوده := رابط کاربری.افزودن پرونده قلم("books/fonts/DejaVuSansMono.ttf")
    اگر افزوده برابر 0:
        سرچاپ "font missing"
    پایان
    سرچاپ "missing dir"، رابط کاربری.افزودن پوشه قلم("books/fonts/none")
    نامیس := [
        "fill"، "shadow"، "outline"، "blur child"، "rotate"، "opacity group"، "backdrop"،
        "scale skew"، "text"
    ]
    تکرار نامیس.طول() در ی:
        اجرا(نامیس[ی]، ی، 1.0)
        اجرا(نامیس[ی]، ی، 2.0)
    پایان
پایان
