// زبان: فارسی
واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک
واردسازی رابط گرافیکی.نقاشی

تابع ستی(ب: رابط کاربری.سازنده‌صفحه، کلید: رشته، مقدار: رشته):
    ب.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی با نام(کلید)، مقدار)
پایان

تابع کیلل(ب: رابط کاربری.سازنده‌صفحه، چپ: صحیح، بالا: صحیح، بگ: رشته):
    ب.گشودن عنصر("box")
    ستی(ب، "position"، "absolute")
    ستی(ب، "left"، "" + چپ)
    ستی(ب، "top"، "" + بالا)
    ستی(ب، "width"، "40")
    ستی(ب، "height"، "40")
    ستی(ب، "background"، بگ)
پایان

تابع وییو(ب: رابط کاربری.سازنده‌صفحه):
    ب.گشودن عنصر("box")
    ستی(ب، "background"، "white")
    کیلل(ب، 10، 10، "#ff0000")
    ب.بستن عنصر()
    کیلل(ب، 60، 10، "linear(90, #000000, #ffffff)")
    ب.بستن عنصر()
    کیلل(ب، 110، 10، "#00ff00")
    ستی(ب، "border"، "5, solid, #0000ff")
    ستی(ب، "radius"، "20")
    ب.بستن عنصر()
    کیلل(ب، 160، 10، "#ffffff")
    ستی(ب، "shadow"، "[10, 10, 0, 0, #000000]")
    ب.بستن عنصر()
    کیلل(ب، 210، 10، "#ff0000")
    ستی(ب، "opacity"، "0.5")
    ب.بستن عنصر()
    کیلل(ب، 260، 10، "#ff0000")
    ستی(ب، "grayscale"، "1")
    ب.بستن عنصر()
    کیلل(ب، 10، 60، "#808080")
    ستی(ب، "blend"، "multiply")
    ب.بستن عنصر()
    کیلل(ب، 60، 60، "#00ff00")
    ستی(ب، "overflow"، "hidden")
    ب.گشودن عنصر("box")
    ستی(ب، "position"، "absolute")
    ستی(ب، "left"، "20")
    ستی(ب، "top"، "20")
    ستی(ب، "width"، "40")
    ستی(ب، "height"، "40")
    ستی(ب، "background"، "#ff0000")
    ب.بستن عنصر()
    ب.بستن عنصر()
    کیلل(ب، 110، 60، "#ffffff")
    ستی(ب، "outline"، "4, solid, #ff0000")
    ستی(ب، "outline offset"، "2")
    ب.بستن عنصر()
    کیلل(ب، 160، 60، "#0000ff")
    ستی(ب، "scale"، "2")
    ب.بستن عنصر()
    کیلل(ب، 230، 60، "#0000ff")
    ستی(ب، "translate"، "20, 0")
    ستی(ب، "scale"، "0.5")
    ب.بستن عنصر()
    کیلل(ب، 290، 60، "#ffffff")
    ستی(ب، "border"، "4, double, #000000")
    ب.بستن عنصر()
    کیلل(ب، 10، 110، "#ffffff")
    ستی(ب، "shadow"، "[0, 0, 0, 10, #ff0000, inset]")
    ب.بستن عنصر()
    ب.گشودن عنصر("checkbox")
    ستی(ب، "position"، "absolute")
    ستی(ب، "left"، "60")
    ستی(ب، "top"، "110")
    ب.ویژگی دودویی عنصر("checked"، درست)
    ب.بستن عنصر()
    ب.گشودن عنصر("progress")
    ستی(ب، "position"، "absolute")
    ستی(ب، "left"، "90")
    ستی(ب، "top"، "110")
    ستی(ب، "width"، "100")
    ستی(ب، "height"، "16")
    ب.ویژگی عنصر("value"، "0.5")
    ب.بستن عنصر()
    ب.بستن عنصر()
پایان

تابع پروبی(نام: رشته، کانواس: نقاشی.بوم، پکس: صحیح، پی: صحیح):
    سرچاپ نام، کانواس.پیکسل خام(پکس، پی)
پایان

تابع ریشه:
    نپ := (): برگشت رابط کاربری.بی وصله() پایان
    وو := (ب: رابط کاربری.سازنده‌صفحه): وییو(ب) پایان
    کانواس := رابط کاربری.نگاره صفحه(نپ، وو، 360، 160)
    پروبی("solid"، کانواس، 30، 30)
    پروبی("gradient left"، کانواس، 61، 30)
    پروبی("gradient right"، کانواس، 99، 30)
    پروبی("border"، کانواس، 112، 30)
    پروبی("radius corner"، کانواس، 111، 11)
    پروبی("shadow"، کانواس، 205، 25)
    پروبی("opacity"، کانواس، 230، 30)
    پروبی("grayscale"، کانواس، 280، 30)
    پروبی("multiply"، کانواس، 30، 80)
    پروبی("clip inside"، کانواس، 90، 90)
    پروبی("clip outside"، کانواس، 90، 105)
    پروبی("outline"، کانواس، 130، 57)
    پروبی("scale"، کانواس، 160، 100)
    پروبی("translate"، کانواس، 270، 80)
    پروبی("double outer"، کانواس، 290، 80)
    پروبی("double gap"، کانواس، 291، 80)
    پروبی("double inner"، کانواس، 293، 80)
    پروبی("inset shadow"، کانواس، 12، 130)
    پروبی("checkbox"، کانواس، 62، 112)
    پروبی("progress fill"، کانواس، 100، 118)
    پروبی("progress rest"، کانواس، 180، 118)
    کانواس.رهاسازی()
پایان
