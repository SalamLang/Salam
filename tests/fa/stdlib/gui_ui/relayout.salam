واردسازی رابط گرافیکی.رابط کاربری
واردسازی رشته

ناپایا count := 0

تابع page(): رشته:
    ناپایا b := رشته.سازنده()
    رشته.افزودن به بافر(b، `<!doctype html><html lang="en"><head><title>Relayout</title><style>body{margin:8px}.grid{display:grid;grid-template-columns:repeat(4, 1fr);gap:6px}.c{padding:6px;border:1px solid #888}h3{margin:0;font-size:14px}p{margin:0}</style></head><body><p id="count">Count ` + count + `</p><div class="grid">`)
    تکرار 40 در i:
        رشته.افزودن به بافر(b، `<div class="c"><h3>Item ` + i + `</h3><p>Text for item ` + i + `</p></div>`)
    پایان
    رشته.افزودن به بافر(b، `</div><table><tr><td>a</td><td>b</td></tr></table></body></html>`)
    r := رشته.رشته بافر(b)
    رشته.آزادسازی بافر(b)
    برگشت r
پایان

تابع ریشه:
    _f := رابط کاربری.افزودن پرونده قلم("books/fonts/DejaVuSansMono.ttf")
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 640.0، بلندی = 480.0، بی سر = درست })
    _s := رابط کاربری.گام(0)
    first := رابط کاربری.شمار چینش آخر()
    سرچاپ "first layout"، first
    رابط کاربری.تازه سازی()
    _s2 := رابط کاربری.گام(0)
    سرچاپ "same view again"، رابط کاربری.شمار چینش آخر()
    count = 7
    رابط کاربری.تازه سازی()
    _s3 := رابط کاربری.گام(0)
    سرچاپ "one text changed"، رابط کاربری.شمار چینش آخر()
    count = 123456
    رابط کاربری.تازه سازی()
    _s4 := رابط کاربری.گام(0)
    سرچاپ "text grew"، رابط کاربری.شمار چینش آخر()
    h := رابط کاربری.قاب().چکیده()
    ناپایا full := رابط کاربری.نگاره(page()، 640، 480)
    سرچاپ "pixels equal a full layout"، h برابر full.چکیده()
    full.رهاسازی()
    رابط کاربری.توقف()
پایان
