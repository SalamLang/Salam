واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک
واردسازی رابط گرافیکی.نقاشی

تابع none(): وکتور<رابط کاربری.وصله‌سبک>:
    برگشت رابط کاربری.بی وصله()
پایان

تابع setv(b: رابط کاربری.سازنده‌صفحه، prop: صحیح، text: رشته):
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، prop، text)
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.عنوان صفحه("Cards")
    b.گشودن عنصر("box")
    b.شناسه عنصر("row")
    setv(b، سبک.ویژگی‌چیدمان، "row")
    setv(b، سبک.ویژگی‌شکاف، "10")
    setv(b، سبک.ویژگی‌فاصله، "16")
    setv(b، سبک.ویژگی‌پس‌زمینه، "#f4f6fa")
    b.گشودن عنصر("box")
    b.شناسه عنصر("tea")
    setv(b، سبک.ویژگی‌عرض، "100")
    setv(b، سبک.ویژگی‌ارتفاع، "60")
    setv(b، سبک.ویژگی‌پس‌زمینه، "#ff0000")
    b.بستن عنصر()
    b.گشودن عنصر("box")
    b.شناسه عنصر("coffee")
    setv(b، سبک.ویژگی‌عرض، "100")
    setv(b، سبک.ویژگی‌ارتفاع، "60")
    setv(b، سبک.ویژگی‌پس‌زمینه، "#0000ff")
    b.بستن عنصر()
    b.بستن عنصر()
پایان

تابع probe(c: نقاشی.بوم، label: رشته، x: صحیح، y: صحیح):
    p := c.پیکسل(x، y)
    سرچاپ label، p.قرمز، p.سبز، p.آبی
پایان

تابع ریشه:
    d := رابط کاربری.گزارش صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 400، 200)
    سرچاپ d
    ناپایا c := رابط کاربری.نگاره صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 400، 200)
    سرچاپ "size"، c.پهنا، c.بلندی
    probe(c، "padding"، 4، 4)
    probe(c، "tea"، 60، 40)
    probe(c، "gap"، 121، 40)
    probe(c، "coffee"، 180، 40)
    probe(c، "below"، 60، 150)
    c.رهاسازی()
پایان
