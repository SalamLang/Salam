واردسازی رابط گرافیکی.رابط کاربری

ناپایا hits := 0
ناپایا misses := 0

تابع page(): رشته:
    برگشت `<!doctype html><html lang="en"><head><title>Transforms</title><style>body{margin:0}#bg{position:absolute;left:0;top:0;width:400px;height:300px}#r{position:absolute;left:100px;top:50px;width:100px;height:20px;background:#36c;transform:rotate(90deg)}#s{position:absolute;left:220px;top:40px;width:60px;height:40px;background:#c63;border:4px dashed #222;border-radius:10px;transform:translate(10px,5px) scale(1.5) skewX(10deg);transform-origin:0 0;transition:transform 100ms linear}#s:hover{transform:rotate(45deg)}#m{position:absolute;left:40px;top:180px;width:80px;height:50px;background:#9c6;transform:matrix(1,0.2,-0.2,1,0,0);overflow:hidden}#m p{margin:0;width:200px;height:20px;background:#333}</style></head><body><div id="bg" onclick="miss()"></div><div id="r" onclick="hit()"></div><div id="s"></div><div id="m"><p></p></div></body></html>`
پایان

تابع hit():
    hits++
پایان

تابع miss():
    misses++
پایان

تابع check(label: رشته):
    partial := رابط کاربری.قاب().چکیده()
    رابط کاربری.بازنگاری کامل()
    full := رابط کاربری.قاب().چکیده()
    سرچاپ label، "same"، partial برابر full، "hits"، hits، "misses"، misses
پایان

تابع ریشه:
    رابط کاربری.ثبت رسیدگی("hit"، (): hit() پایان)
    رابط کاربری.ثبت رسیدگی("miss"، (): miss() پایان)
    _ok := رابط کاربری.آغاز((): برگشت page() پایان، رابط کاربری.گزینه‌ها { پهنا = 400.0، بلندی = 300.0، بی سر = درست })
    _alive := رابط کاربری.گام(0)
    رابط کاربری.اجرای گام ها("drag 150 100 150 100")
    check("inside rotated")
    رابط کاربری.اجرای گام ها("drag 110 60 110 60")
    check("outside rotated")
    رابط کاربری.اجرای گام ها("click #r")
    check("script click")
    r := رابط کاربری.با شناسه("r").مستطیل()
    سرچاپ "layout box"، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
    رابط کاربری.اجرای گام ها("hover #s\nwait 50")
    check("half way")
    رابط کاربری.اجرای گام ها("wait 100")
    check("done")
    رابط کاربری.اجرای گام ها("move 5 5")
    check("back")
    رابط کاربری.اجرای گام ها("wait 200")
    check("rest")
    رابط کاربری.توقف()
پایان
