واردسازی رابط گرافیکی.پنجره ها

تابع show(e: پنجره ها.رویداد):
    سرچاپ e.نوع برگردان صحیح، e.شماره پنجره، e.ایکس، e.ایگرگ، e.دکمه برگردان صحیح، e.شمار کلیک، e.کلیدهای تغییر، e.جابجایی عمودی، e.واحد جابجایی برگردان صحیح، e.کلید برگردان صحیح، e.کد فیزیکی، e.تکراری، e.متن، e.جای نشانگر
پایان

تابع drain():
    ناپایا e := پنجره ها.سرکشی رویداد()
    تا e.نوع نابرابر پنجره ها.نوع‌رویداد.هیچ رویداد:
        show(e)
        e = پنجره ها.سرکشی رویداد()
    پایان
پایان

تابع ریشه:
    پنجره ها.تنظیم ساعت دستی(درست)
    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { عنوان = "events"، پهنا = 200.0، بلندی = 100.0، بی سر = درست، مقیاس = 1.5 })
    سرچاپ "open"، w.باز است()، w.بی سر است()، w.عنوان پنجره()، w.ضریب مقیاس()
    سرچاپ "size"، w.اندازه()
    drain()
    سرچاپ "focused"، w.متمرکز است()
    w.درخواست بازکشی دوباره()
    w.درخواست بازکشی دوباره()
    drain()
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.ورود اشاره گر، شماره پنجره = w.شناسه، ایکس = 5.0، ایگرگ = 6.0 })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن دکمه، شماره پنجره = w.شناسه، ایکس = 10.0، ایگرگ = 12.0، دکمه = پنجره ها.دکمه‌موشی.دکمه چپ })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.رها کردن دکمه، شماره پنجره = w.شناسه، ایکس = 10.0، ایگرگ = 12.0، دکمه = پنجره ها.دکمه‌موشی.دکمه چپ })
    پنجره ها.جلو بردن ساعت(100)
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن دکمه، شماره پنجره = w.شناسه، ایکس = 11.0، ایگرگ = 12.0، دکمه = پنجره ها.دکمه‌موشی.دکمه چپ })
    پنجره ها.جلو بردن ساعت(900)
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن دکمه، شماره پنجره = w.شناسه، ایکس = 11.0، ایگرگ = 12.0، دکمه = پنجره ها.دکمه‌موشی.دکمه چپ })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن دکمه، شماره پنجره = w.شناسه، ایکس = 11.0، ایگرگ = 12.0، دکمه = پنجره ها.دکمه‌موشی.دکمه راست })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.چرخش چرخ، شماره پنجره = w.شناسه، جابجایی عمودی = 3.0، واحد جابجایی = پنجره ها.واحدچرخش.چرخش خطی })
    drain()
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن کلید، شماره پنجره = w.شناسه، کلید = پنجره ها.کلیدها.کلید ای، کد فیزیکی = 38، کلیدهای تغییر = پنجره ها.تغییرشیفت })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.ورود متن، شماره پنجره = w.شناسه، متن = "A"، کلیدهای تغییر = پنجره ها.تغییرشیفت })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن کلید، شماره پنجره = w.شناسه، کلید = پنجره ها.کلیدها.کلید ای، کد فیزیکی = 38، کلیدهای تغییر = پنجره ها.تغییرشیفت، تکراری = درست })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.رها کردن کلید، شماره پنجره = w.شناسه، کلید = پنجره ها.کلیدها.کلید ای، کد فیزیکی = 38 })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.پیش نویس نویسه ساز، شماره پنجره = w.شناسه، متن = "سل"، جای نشانگر = 4 })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.ثبت نویسه ساز، شماره پنجره = w.شناسه، متن = "سلام" })
    drain()
    سرچاپ "keys"، پنجره ها.کلیدها.کلید گریز برگردان صحیح، پنجره ها.کلیدها.کلید اف۱۲ برگردان صحیح، پنجره ها.کلیدها.کلید منوی زمینه برگردان صحیح
    سرچاپ "mods"، پنجره ها.تغییرشیفت | پنجره ها.تغییرکنترل | پنجره ها.تغییرآلت | پنجره ها.تغییرسوپر
    w.تنظیم اندازه(300.0، 150.0)
    e := پنجره ها.سرکشی رویداد()
    سرچاپ "resized"، e.نوع برابر پنجره ها.نوع‌رویداد.تغییر اندازه، e.پهنا، e.بلندی، e.پهنای فیزیکی، e.بلندی فیزیکی
    r := پنجره ها.سرکشی رویداد()
    سرچاپ "redraw after resize"، r.نوع برابر پنجره ها.نوع‌رویداد.درخواست بازکشی
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.تغییر مقیاس، شماره پنجره = w.شناسه، مقیاس = 2.0 })
    s := پنجره ها.سرکشی رویداد()
    سرچاپ "scale"، s.مقیاس، s.پهنا، s.بلندی، s.پهنای فیزیکی، w.ضریب مقیاس()
    drain()
    w.تنظیم کمترین اندازه(250.0، 120.0)
    w.تنظیم بیشترین اندازه(400.0، 200.0)
    w.تنظیم اندازه(100.0، 900.0)
    سرچاپ "clamped"، w.اندازه()
    drain()
    w.تنظیم نشانگر(پنجره ها.شکل‌نشانگر.نشانگر متن)
    سرچاپ "cursor"، w.نشانگر کنونی() برگردان صحیح
    w.تنظیم جای نویسه ساز(12.0، 30.0، 2.0، 18.0)
    سرچاپ "ime"، w.جای نویسه ساز()
    w.تنظیم تمام صفحه(درست)
    سرچاپ "fullscreen"، w.تمام صفحه است()
    w.تنظیم تمام صفحه(نادرست)
    w.کمینه کردن()
    w.بیشینه کردن()
    w.بازگرداندن()
    سرچاپ "fullscreen"، w.تمام صفحه است()
    w.تنظیم عنوان("renamed")
    سرچاپ "title"، w.عنوان پنجره()
    سرچاپ "scheme"، پنجره ها.طرح رنگ کنونی() برگردان صحیح
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.تغییر طرح رنگ، طرح = پنجره ها.طرح‌رنگ.تیره })
    c := پنجره ها.سرکشی رویداد()
    سرچاپ "scheme changed"، c.نوع برابر پنجره ها.نوع‌رویداد.تغییر طرح رنگ، پنجره ها.طرح رنگ کنونی() برابر پنجره ها.طرح‌رنگ.تیره
    other := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { عنوان = "second"، پهنا = 50.0، بلندی = 40.0، بی سر = درست، نمایان = نادرست })
    سرچاپ "windows"، پنجره ها.شمار پنجره های باز()، other.شناسه
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.درخواست بستن، شماره پنجره = other.شناسه })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.از دست دادن تمرکز، شماره پنجره = w.شناسه })
    drain()
    other.بستن()
    w.متمرکز کردن()
    drain()
    سرچاپ "after close"، other.باز است()، پنجره ها.شمار پنجره های باز()، other.اندازه()، other.دستگیره() برابر پوچ
    پنجره ها.بیدار کردن()
    سرچاپ "wake"، پنجره ها.سرکشی رویداد().نوع برابر پنجره ها.نوع‌رویداد.بیدارباش
    w.بستن()
    سرچاپ "done"، پنجره ها.شمار پنجره های باز()، پنجره ها.انتظار رویداد(50).نوع برگردان صحیح، پنجره ها.ساعت()
پایان
