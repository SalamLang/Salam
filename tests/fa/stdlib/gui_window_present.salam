واردسازی رابط گرافیکی.پنجره ها
واردسازی حافظه

تابع fill(pixels: طبیعی۳۲*، width: صحیح، height: صحیح، color: طبیعی۳۲):
    تکرار width * height در i:
        pixels[i] = color
    پایان
پایان

تابع checksum(w: پنجره ها.پنجره، width: صحیح، height: صحیح): طبیعی۳۲:
    ناپایا sum := 0 برگردان طبیعی۳۲
    تکرار height در y:
        تکرار width در x:
            sum = sum * (31 برگردان طبیعی۳۲) + w.نقطه در(x، y)
        پایان
    پایان
    برگشت sum
پایان

تابع ریشه:
    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { عنوان = "present"، پهنا = 8.0، بلندی = 6.0، بی سر = درست })
    سرچاپ "before"، w.شمار ارائه()، w.نقطه در(0، 0)
    width := 8
    height := 6
    stride := width * 4
    pixels := حافظه.تخصیص صفرشده(((width * height) * 4) برگردان طبیعی۶۴) برگردان طبیعی۳۲*
    دیرکن حافظه.آزادسازی(pixels برگردان تهی*)
    تکرار height در y:
        تکرار width در x:
            pixels[y * width + x] = (0xFF000000 برگردان طبیعی۳۲) | ((x * 30) برگردان طبیعی۳۲ << 16) | ((y * 40) برگردان طبیعی۳۲ << 8)
        پایان
    پایان
    سرچاپ "full"، w.ارائه کامل(pixels برگردان تهی*، width، height، stride)، w.آخرین ناحیه تغییر()، w.شمار آخرین ناحیه ها()
    سرچاپ "pixels"، w.نقطه در(0، 0)، w.نقطه در(7، 5)، w.نقطه نمایش داده شده(3، 2)، w.نقطه در(8، 0)، w.نقطه در(-1، 0)
    سرچاپ "sum"، checksum(w، width، height)
    fill(pixels، width، height، 0xFF102030 برگردان طبیعی۳۲)
    ناپایا damage := وکتور {} برگردان وکتور<پنجره ها.مستطیل>
    دیرکن damage.آزادکن()
    damage.بیفزا(پنجره ها.مستطیل { ایکس = 1، ایگرگ = 1، پهنا = 2، بلندی = 2 })
    damage.بیفزا(پنجره ها.مستطیل { ایکس = 6، ایگرگ = 4، پهنا = 10، بلندی = 10 })
    damage.بیفزا(پنجره ها.مستطیل { ایکس = -5، ایگرگ = 0، پهنا = 3، بلندی = 3 })
    سرچاپ "damage"، w.ارائه(pixels برگردان تهی*، width، height، stride، damage)، w.آخرین ناحیه تغییر()، w.شمار آخرین ناحیه ها()
    سرچاپ "kept"، w.نقطه در(0، 0)، w.نقطه در(3، 3)، w.نقطه در(5، 5)
    سرچاپ "changed"، w.نقطه در(1، 1)، w.نقطه در(2، 2)، w.نقطه در(7، 5)، w.نقطه در(6، 4)
    سرچاپ "sum"، checksum(w، width، height)
    big := حافظه.تخصیص صفرشده(((10 * 4) * 4) برگردان طبیعی۶۴) برگردان طبیعی۳۲*
    دیرکن حافظه.آزادسازی(big برگردان تهی*)
    fill(big، 10، 4، 0x80402010 برگردان طبیعی۳۲)
    سرچاپ "resized buffer"، w.ارائه(big برگردان تهی*، 4، 3، 40، damage)، w.آخرین ناحیه تغییر()، w.نقطه در(3، 2)، w.نقطه در(5، 0)
    سرچاپ "bad"، w.ارائه کامل(پوچ، 4، 3، 16)، w.ارائه کامل(big برگردان تهی*، 4، 3، 8)، w.شمار ارائه()
    سرچاپ "icon"، w.تنظیم نماد(big برگردان تهی*، 2، 2، 40)، w.تنظیم نماد(big برگردان تهی*، 0، 2، 40)
    w.بستن()
    سرچاپ "closed"، w.ارائه کامل(big برگردان تهی*، 4، 3، 40)، w.نقطه در(0، 0)، w.شمار ارائه()
پایان
