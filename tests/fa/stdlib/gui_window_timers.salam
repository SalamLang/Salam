واردسازی رابط گرافیکی.پنجره ها
واردسازی حافظه

تابع ریشه:
    پنجره ها.تنظیم ساعت دستی(درست)
    سرچاپ "clock"، پنجره ها.ساعت()
    once := پنجره ها.تنظیم زمان سنج(250، نادرست)
    every := پنجره ها.تنظیم زمان سنج(100، درست)
    ناپایا seen := 0
    تا seen کوچکتر 6:
        e := پنجره ها.انتظار رویداد(-1)
        اگر e.نوع برابر پنجره ها.نوع‌رویداد.زنگ زمان سنج:
            name := e.زمان سنج برابر once ? "once" : e.زمان سنج برابر every ? "every" : "?"
            سرچاپ "timer"، name، پنجره ها.ساعت()
            seen++
        پایان
    پایان
    پنجره ها.پاک کردن زمان سنج(every)
    e := پنجره ها.انتظار رویداد(1000)
    سرچاپ "after clear"، e.نوع برگردان صحیح، پنجره ها.ساعت()
    سرچاپ "nothing left"، پنجره ها.انتظار رویداد(-1).نوع برگردان صحیح، پنجره ها.ساعت()
    پنجره ها.جلو بردن ساعت(40)
    سرچاپ "advanced"، پنجره ها.ساعت()
    پنجره ها.تنظیم ساعت دستی(نادرست)
    پنجره ها.تنظیم ساعت دستی(درست)
    سرچاپ "restarted"، پنجره ها.ساعت()
    پنجره ها.بیدار کردن()
    پنجره ها.بیدار کردن()
    سرچاپ "woken"، پنجره ها.انتظار رویداد(-1).نوع برابر پنجره ها.نوع‌رویداد.بیدارباش، پنجره ها.سرکشی رویداد().نوع برگردان صحیح
    سرچاپ "set"، پنجره ها.تنظیم متن کلیپ بورد("سلام, clipboard")
    text := پنجره ها.متن کلیپ بورد()
    سرچاپ "clipboard"، text
    حافظه.آزادسازی(text برگردان تهی*)
    سرچاپ "set again"، پنجره ها.تنظیم متن کلیپ بورد("")
    empty := پنجره ها.متن کلیپ بورد()
    سرچاپ "empty"، empty.طول()
    حافظه.آزادسازی(empty برگردان تهی*)
    سرچاپ "error"، پنجره ها.آخرین خطا().طول()
پایان
