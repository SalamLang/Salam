واردسازی رابط گرافیکی.پنجره ها
واردسازی حافظه
واردسازی زمان

تابع waker():
    زمان.خواب(100)
    پنجره ها.بیدار کردن()
پایان

تابع next_of(kind: پنجره ها.نوع‌رویداد): پنجره ها.رویداد:
    تکرار 200:
        e := پنجره ها.انتظار رویداد(50)
        اگر e.نوع برابر kind:
            برگشت e
        پایان
    پایان
    برگشت پنجره ها.رویداد {}
پایان

تابع ریشه:
    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { عنوان = "x11 readback"، پهنا = 64.0، بلندی = 48.0، مقیاس = 1.0 })
    سرچاپ "open"، w.باز است()، w.بی سر است()، w.دستگیره() نابرابر پوچ
    first := next_of(پنجره ها.نوع‌رویداد.درخواست بازکشی)
    سرچاپ "redraw"، first.پهنای فیزیکی، first.بلندی فیزیکی
    pixels := حافظه.تخصیص صفرشده(((64 * 48) * 4) برگردان طبیعی۶۴) برگردان طبیعی۳۲*
    دیرکن حافظه.آزادسازی(pixels برگردان تهی*)
    تکرار 48 در y:
        تکرار 64 در x:
            pixels[y * 64 + x] = (0xFF800000 برگردان طبیعی۳۲) | ((x برگردان طبیعی۳۲) << 8) | (y برگردان طبیعی۳۲)
        پایان
    پایان
    سرچاپ "present"، w.ارائه کامل(pixels برگردان تهی*، 64، 48، 256)
    سرچاپ "shown"، w.نقطه نمایش داده شده(0، 0)، w.نقطه نمایش داده شده(10، 20)، w.نقطه نمایش داده شده(63، 47)
    سرچاپ "same"، w.نقطه نمایش داده شده(10، 20) برابر w.نقطه در(10، 20)
    تکرار 64 * 48 در i:
        pixels[i] = 0xFF00FF00 برگردان طبیعی۳۲
    پایان
    ناپایا damage := وکتور {} برگردان وکتور<پنجره ها.مستطیل>
    دیرکن damage.آزادکن()
    damage.بیفزا(پنجره ها.مستطیل { ایکس = 4، ایگرگ = 4، پهنا = 8، بلندی = 8 })
    سرچاپ "damage"، w.ارائه(pixels برگردان تهی*، 64، 48، 256، damage)
    سرچاپ "inside"، w.نقطه نمایش داده شده(5، 5)، "outside"، w.نقطه نمایش داده شده(20، 20)
    w.تنظیم اندازه(80.0، 60.0)
    r := next_of(پنجره ها.نوع‌رویداد.تغییر اندازه)
    سرچاپ "resized"، r.پهنا، r.بلندی، w.اندازه()
    w.تنظیم عنوان("x11 readback, renamed")
    w.تنظیم نشانگر(پنجره ها.شکل‌نشانگر.نشانگر متن)
    w.تنظیم نشانگر(پنجره ها.شکل‌نشانگر.نشانگر پنهان)
    w.تنظیم جای نویسه ساز(4.0، 4.0، 2.0، 16.0)
    سرچاپ "clipboard set"، پنجره ها.تنظیم متن کلیپ بورد("سلام from X11")
    text := پنجره ها.متن کلیپ بورد()
    سرچاپ "clipboard"، text
    حافظه.آزادسازی(text برگردان تهی*)
    timer := پنجره ها.تنظیم زمان سنج(30، نادرست)
    سرچاپ "timer"، next_of(پنجره ها.نوع‌رویداد.زنگ زمان سنج).زمان سنج برابر timer
    thread := نخ‌ساز(waker)
    سرچاپ "wake"، next_of(پنجره ها.نوع‌رویداد.بیدارباش).نوع برابر پنجره ها.نوع‌رویداد.بیدارباش
    نخ‌پیوند(thread)
    w.بستن()
    سرچاپ "closed"، w.باز است()، پنجره ها.شمار پنجره های باز()
پایان
