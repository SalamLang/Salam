// زبان: فارسی
واردسازی کدگذاری.اچ تی ام ال

تابع ریشه:
    سرچاپ اچ تی ام ال.بازگردانی("a &lt; b &amp;&amp; c &gt; d &quot;x&quot; &apos;y&apos;")
    سرچاپ اچ تی ام ال.بازگردانی("&#65;&#x42;&#X43; &#233; &#x1F600;")
    سرچاپ اچ تی ام ال.بازگردانی("&copy; &copy &notit; &amp &bogus; &NotEqualTilde;")
    سرچاپ اچ تی ام ال.بازگردانی("&#128; &#0; &#xD800; &#1; end&")
    سرچاپ اچ تی ام ال.بازگردانی("no entities here")
    سرچاپ اچ تی ام ال.بازگردانی("&lt;p&gt;caf&eacute; &mdash; &euro;5&lt;/p&gt;")
    سرچاپ اچ تی ام ال.فرار(`<a href="x">it's & co</a>`)
    سرچاپ اچ تی ام ال.فرار متن(`<a href="x">it's & co</a>`)
    سرچاپ اچ تی ام ال.بازگردانی(اچ تی ام ال.فرار(`<b>"q" & 'r'</b>`))
پایان
