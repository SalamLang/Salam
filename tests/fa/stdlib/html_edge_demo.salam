// زبان: فارسی
واردسازی کدگذاری.اچ تی ام ال
واردسازی رشته

تابع ریشه:
    سرچاپ "[" + اچ تی ام ال.بازگردانی موجودیت ها("") + "]"، "[" + اچ تی ام ال.اسکیپ("") + "]"، "[" + اچ تی ام ال.اسکیپ متن("") + "]"
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&amp;lt;")، اچ تی ام ال.بازگردانی موجودیت ها(اچ تی ام ال.بازگردانی موجودیت ها("&amp;lt;"))
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&LT; &Lt; &AMP; &amp;")، اچ تی ام ال.بازگردانی موجودیت ها("&lt &gt &quot &amp")
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&nbsp;|").طول()، اچ تی ام ال.بازگردانی موجودیت ها("&#160;|").طول()
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&#65 &#x41 &#65;&#66")، اچ تی ام ال.بازگردانی موجودیت ها("&#x; &#; &#xg; &#12a;")
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&#1114111;").طول()، اچ تی ام ال.بازگردانی موجودیت ها("&#1114112;").طول()، اچ تی ام ال.بازگردانی موجودیت ها("&#99999999999999999999;").طول()
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&#x110000; &#xFFFFFFFF;").طول()
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&#13;&#10;").طول()، اچ تی ام ال.بازگردانی موجودیت ها("&#9;").طول()
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&#150; &#8211; &#x80; &#x9f;")
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&#0;|&#xD800;|&#xDFFF;|&#xFFFE;").طول()
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("a & b && c &; &&amp;")
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&notin; &not; &noti; &notit;")
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&copy&copy; &reg &REG; &ampx; &amp;x")
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("سلام &lt;دنیا&gt; &#1587;&#1604;&#1575;&#1605; &zwnj;|").طول()
    سرچاپ اچ تی ام ال.اسکیپ("سلام <دنیا> & 'جهان'")
    سرچاپ اچ تی ام ال.اسکیپ متن("سلام <دنیا> & 'جهان' \"x\"")
    سرچاپ اچ تی ام ال.اسکیپ("\"\"''&&<<>>")
    سرچاپ اچ تی ام ال.اسکیپ("plain text 123")، اچ تی ام ال.اسکیپ متن("plain text 123")
    سرچاپ اچ تی ام ال.اسکیپ("a\nb\tc\r")، اچ تی ام ال.اسکیپ("é€").طول()

    ناپایا تکه ها := وکتور {} برگردان وکتور<رشته>
    تکرار 5000:
        تکه ها.بیفزا("<tag attr=\"v\">x & y</tag>")
    پایان
    بلند := رشته.بپیوند(تکه ها، "\n")
    تکه ها.آزادکن()
    اسکیپ شده := اچ تی ام ال.اسکیپ(بلند)
    برگشته := اچ تی ام ال.بازگردانی موجودیت ها(اسکیپ شده)
    سرچاپ بلند.طول()، اسکیپ شده.طول()، برگشته برابر بلند
    فقط متن := اچ تی ام ال.اسکیپ متن(بلند)
    سرچاپ فقط متن.طول()، اچ تی ام ال.بازگردانی موجودیت ها(فقط متن) برابر بلند

    نام ها := ["alpha"، "beta"، "hellip"، "rarr"، "hearts"، "Aacute"، "ouml"، "szlig"، "THORN"، "frac12"، "times"، "deg"]
    هر ن در نام ها:
        سرچاپ ن، اچ تی ام ال.بازگردانی موجودیت ها("&" + ن + ";").طول()، اچ تی ام ال.بازگردانی موجودیت ها("&" + ن + ";") برابر "&" + ن + ";"
    پایان
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&hellip;&rarr;&hearts;")
    سرچاپ اچ تی ام ال.بازگردانی موجودیت ها("&unknownthing; &x; &1;")
پایان
