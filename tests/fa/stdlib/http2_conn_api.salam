// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی
واردسازی فشرده سازی

تابع بافر از متن(متن: رشته): فشرده سازی.بافر بایت:
    برگشت فشرده سازی.بافر از رشته(متن)
پایان

تابع ریشه:
    سوکت سرور := تی سی پی.پیوند(0)
    شماره درگاه := تی سی پی.درگاه(سوکت سرور)
    سوکت کارخواه := تی سی پی.شماره گیری("127.0.0.1"، شماره درگاه)
    سوکت پذیرفته := تی سی پی.پذیرش(سوکت سرور)
    سرچاپ "sockets: "، تی سی پی.اتصال معتبر(سوکت کارخواه)، تی سی پی.اتصال معتبر(سوکت پذیرفته)

    ناپایا ترابری کارخواه := اچ تی تی پی۲.ترابری ساده(سوکت کارخواه.توصیفگر)
    ترابری سرور := اچ تی تی پی۲.ترابری ساده(سوکت پذیرفته.توصیفگر)
    سرچاپ "plain transport ok: "، ترابری کارخواه.سالم، ترابری سرور.سالم
    سرچاپ "plain kind: "، ترابری کارخواه.نوع برابر اچ تی تی پی۲.انتقال ساده
    ترابری نامعتبر := اچ تی تی پی۲.ترابری ساده(0 - 1)
    سرچاپ "invalid fd: "، ترابری نامعتبر.سالم

    ناپایا اتصال کارخواه := اچ تی تی پی۲.اتصال جدید(ترابری کارخواه، نادرست)
    ناپایا اتصال سرور := اچ تی تی پی۲.اتصال جدید(ترابری سرور، درست)
    سرچاپ "fresh conns: "، اچ تی تی پی۲.اتصال معتبر(اتصال کارخواه)، اچ تی تی پی۲.اتصال معتبر(اتصال سرور)
    سرچاپ "client first id: "، اتصال کارخواه.شناسه بعدی
    سرچاپ "server first id: "، اتصال سرور.شناسه بعدی

    سرچاپ "client handshake: "، اچ تی تی پی۲.دست‌دهی کارخواه(اتصال کارخواه)
    سرچاپ "server handshake: "، اچ تی تی پی۲.دست‌دهی سرور(اتصال سرور)
    سرچاپ "conns ok: "، اچ تی تی پی۲.اتصال معتبر(اتصال کارخواه)، اچ تی تی پی۲.اتصال معتبر(اتصال سرور)
    سرچاپ "server sees client settings: "، اچ تی تی پی۲.دریافت رویداد(اتصال سرور)
    سرچاپ "client sees server settings: "، اچ تی تی پی۲.دریافت رویداد(اتصال کارخواه)

    شناسه := اچ تی تی پی۲.شناسه جریان بعدی(اتصال کارخواه)
    سرچاپ "stream id: "، شناسه
    سرچاپ "next stream id: "، اچ تی تی پی۲.شناسه جریان بعدی(اتصال کارخواه)
    سرچاپ "client streams: "، اچ تی تی پی۲.تعداد جریان‌ها(اتصال کارخواه)
    سرچاپ "stream known: "، اچ تی تی پی۲.جریان با شناسه(اتصال کارخواه، شناسه).مشغول
    سرچاپ "unknown stream: "، اچ تی تی پی۲.جریان با شناسه(اتصال کارخواه، 99).مشغول

    ناپایا درخواست := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(درخواست، ":method"، "POST")
    اچ تی تی پی۲.افزودن سرآیند(درخواست، ":scheme"، "http")
    اچ تی تی پی۲.افزودن سرآیند(درخواست، ":path"، "/upload")
    اچ تی تی پی۲.افزودن سرآیند(درخواست، ":authority"، "localhost")
    اچ تی تی پی۲.افزودن سرآیند حساس(درخواست، "authorization"، "secret")
    سرچاپ "send headers: "، اچ تی تی پی۲.ارسال سرآیندها(اتصال کارخواه، شناسه، درخواست، نادرست)

    ناپایا بدنه := بافر از متن("hello over h2")
    سرچاپ "send data: "، اچ تی تی پی۲.ارسال داده(اتصال کارخواه، شناسه، بدنه، نادرست)

    ناپایا دنباله := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(دنباله، "x-checksum"، "abc")
    سرچاپ "send trailers: "، اچ تی تی پی۲.ارسال دنباله‌ها(اتصال کارخواه، شناسه، دنباله)

    دیده شد := اچ تی تی پی۲.انتظار سرآیند(اتصال سرور، 10)
    سرچاپ "headers on stream: "، دیده شد برابر شناسه
    سرچاپ "server streams: "، اچ تی تی پی۲.تعداد جریان‌ها(اتصال سرور)
    سرچاپ "await end: "، اچ تی تی پی۲.انتظار اتمام جریان(اتصال سرور، شناسه، 10)
    s := اچ تی تی پی۲.جریان با شناسه(اتصال سرور، شناسه)
    سرچاپ "method: "، اچ تی تی پی۲.دریافت سرآیند(s.سرآیندها، ":method")
    سرچاپ "path: "، اچ تی تی پی۲.دریافت سرآیند(s.سرآیندها، ":path")
    سرچاپ "authorization: "، اچ تی تی پی۲.دریافت سرآیند(s.سرآیندها، "authorization")
    سرچاپ "body: "، فشرده سازی.بافر به رشته(s.بدنه)
    سرچاپ "trailer: "، اچ تی تی پی۲.دریافت سرآیند(s.سرآیندهای پایانی، "x-checksum")
    سرچاپ "ended: "، s.انتهای جریان

    ناپایا پاسخ := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(پاسخ، ":status"، "200")
    سرچاپ "send response: "، اچ تی تی پی۲.ارسال سرآیندها(اتصال سرور، شناسه، پاسخ، درست)
    سرچاپ "client await: "، اچ تی تی پی۲.انتظار اتمام جریان(اتصال کارخواه، شناسه، 10)
    سرچاپ "status: "، اچ تی تی پی۲.دریافت سرآیند(اچ تی تی پی۲.جریان با شناسه(اتصال کارخواه، شناسه).سرآیندها، ":status")

    ناپایا بار := بافر از متن("pingpong")
    سرچاپ "send ping: "، اچ تی تی پی۲.ارسال پینگ(اتصال کارخواه، بار)
    سرچاپ "server poll ping: "، اچ تی تی پی۲.دریافت رویداد(اتصال سرور)
    سرچاپ "client poll pong: "، اچ تی تی پی۲.دریافت رویداد(اتصال کارخواه)

    شناسه دیگر := اچ تی تی پی۲.شناسه جریان بعدی(اتصال کارخواه)
    سرچاپ "send reset: "، اچ تی تی پی۲.ارسال بازنشانی جریان(اتصال کارخواه، شناسه دیگر، اچ تی تی پی۲.کد لغو)
    سرچاپ "server poll reset: "، اچ تی تی پی۲.دریافت رویداد(اتصال سرور) برابر شناسه دیگر
    جریان بازنشانی := اچ تی تی پی۲.جریان با شناسه(اتصال سرور، شناسه دیگر)
    سرچاپ "stream reset: "، جریان بازنشانی.بازنشانی‌شده، اچ تی تی پی۲.نام خطا(جریان بازنشانی.کد خطا)
    سرچاپ "await reset: "، اچ تی تی پی۲.انتظار اتمام جریان(اتصال سرور، شناسه دیگر، 3)

    سرچاپ "send goaway: "، اچ تی تی پی۲.ارسال خداحافظی(اتصال سرور، اچ تی تی پی۲.کد بدون خطا، "bye")
    سرچاپ "client poll goaway: "، اچ تی تی پی۲.دریافت رویداد(اتصال کارخواه)
    سرچاپ "goaway seen: "، اتصال کارخواه.قاب خاتمه، اچ تی تی پی۲.نام خطا(اتصال کارخواه.آخرین کد خطا)

    ناپایا بافر خالی := فشرده سازی.بافر بایت جدید()
    سرچاپ "await nothing: "، اچ تی تی پی۲.انتظار سرآیند(اتصال کارخواه، 0) برابر اچ تی تی پی۲.نتیجه خطا

    فشرده سازی.آزادسازی بافر(بافر خالی)
    فشرده سازی.آزادسازی بافر(بار)
    فشرده سازی.آزادسازی بافر(بدنه)
    اچ تی تی پی۲.بستن اتصال(اتصال سرور)
    سرچاپ "server closed: "، اچ تی تی پی۲.اتصال معتبر(اتصال سرور)
    سرچاپ "poll after peer close: "، اچ تی تی پی۲.دریافت رویداد(اتصال کارخواه) برابر اچ تی تی پی۲.نتیجه خطا
    اچ تی تی پی۲.بستن ترابری(ترابری کارخواه)
    سرچاپ "transport closed: "، ترابری کارخواه.سالم
    تی سی پی.بستن سرور(سوکت سرور)
پایان
