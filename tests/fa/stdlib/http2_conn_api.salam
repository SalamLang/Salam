// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی
واردسازی فشرده سازی

تابع bytes of(text: رشته): فشرده سازی.بافر بایت:
    برگشت فشرده سازی.بافر از رشته(text)
پایان

تابع ریشه:
    srv := تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(srv)
    cli := تی سی پی.شماره گیری("127.0.0.1"، port)
    acc := تی سی پی.پذیرش(srv)
    سرچاپ "sockets: "، تی سی پی.اتصال معتبر(cli)، تی سی پی.اتصال معتبر(acc)

    ناپایا ct := اچ تی تی پی۲.ترابری ساده(cli.توصیفگر)
    st := اچ تی تی پی۲.ترابری ساده(acc.توصیفگر)
    سرچاپ "plain transport ok: "، ct.سالم، st.سالم
    سرچاپ "plain kind: "، ct.نوع برابر اچ تی تی پی۲.انتقال ساده
    bad := اچ تی تی پی۲.ترابری ساده(0 - 1)
    سرچاپ "invalid fd: "، bad.سالم

    ناپایا cc := اچ تی تی پی۲.اتصال جدید(ct، نادرست)
    ناپایا sc := اچ تی تی پی۲.اتصال جدید(st، درست)
    سرچاپ "fresh conns: "، اچ تی تی پی۲.اتصال معتبر(cc)، اچ تی تی پی۲.اتصال معتبر(sc)
    سرچاپ "client first id: "، cc.شناسه بعدی
    سرچاپ "server first id: "، sc.شناسه بعدی

    سرچاپ "client handshake: "، اچ تی تی پی۲.دست‌دهی کارخواه(cc)
    سرچاپ "server handshake: "، اچ تی تی پی۲.دست‌دهی سرور(sc)
    سرچاپ "conns ok: "، اچ تی تی پی۲.اتصال معتبر(cc)، اچ تی تی پی۲.اتصال معتبر(sc)
    سرچاپ "server sees client settings: "، اچ تی تی پی۲.دریافت رویداد(sc)
    سرچاپ "client sees server settings: "، اچ تی تی پی۲.دریافت رویداد(cc)

    id := اچ تی تی پی۲.شناسه جریان بعدی(cc)
    سرچاپ "stream id: "، id
    سرچاپ "next stream id: "، اچ تی تی پی۲.شناسه جریان بعدی(cc)
    سرچاپ "client streams: "، اچ تی تی پی۲.تعداد جریان‌ها(cc)
    سرچاپ "stream known: "، اچ تی تی پی۲.جریان با شناسه(cc، id).مشغول
    سرچاپ "unknown stream: "، اچ تی تی پی۲.جریان با شناسه(cc، 99).مشغول

    ناپایا req := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(req، ":method"، "POST")
    اچ تی تی پی۲.افزودن سرآیند(req، ":scheme"، "http")
    اچ تی تی پی۲.افزودن سرآیند(req، ":path"، "/upload")
    اچ تی تی پی۲.افزودن سرآیند(req، ":authority"، "localhost")
    اچ تی تی پی۲.افزودن سرآیند حساس(req، "authorization"، "secret")
    سرچاپ "send headers: "، اچ تی تی پی۲.ارسال سرآیندها(cc، id، req، نادرست)

    ناپایا body := bytes of("hello over h2")
    سرچاپ "send data: "، اچ تی تی پی۲.ارسال داده(cc، id، body، نادرست)

    ناپایا trailer := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(trailer، "x-checksum"، "abc")
    سرچاپ "send trailers: "، اچ تی تی پی۲.ارسال دنباله‌ها(cc، id، trailer)

    seen := اچ تی تی پی۲.انتظار سرآیند(sc، 10)
    سرچاپ "headers on stream: "، seen برابر id
    سرچاپ "server streams: "، اچ تی تی پی۲.تعداد جریان‌ها(sc)
    سرچاپ "await end: "، اچ تی تی پی۲.انتظار اتمام جریان(sc، id، 10)
    s := اچ تی تی پی۲.جریان با شناسه(sc، id)
    سرچاپ "method: "، اچ تی تی پی۲.دریافت سرآیند(s.سرآیندها، ":method")
    سرچاپ "path: "، اچ تی تی پی۲.دریافت سرآیند(s.سرآیندها، ":path")
    سرچاپ "authorization: "، اچ تی تی پی۲.دریافت سرآیند(s.سرآیندها، "authorization")
    سرچاپ "body: "، فشرده سازی.بافر به رشته(s.بدنه)
    سرچاپ "trailer: "، اچ تی تی پی۲.دریافت سرآیند(s.سرآیندهای پایانی، "x-checksum")
    سرچاپ "ended: "، s.انتهای جریان

    ناپایا resp := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(resp، ":status"، "200")
    سرچاپ "send response: "، اچ تی تی پی۲.ارسال سرآیندها(sc، id، resp، درست)
    سرچاپ "client await: "، اچ تی تی پی۲.انتظار اتمام جریان(cc، id، 10)
    سرچاپ "status: "، اچ تی تی پی۲.دریافت سرآیند(اچ تی تی پی۲.جریان با شناسه(cc، id).سرآیندها، ":status")

    ناپایا payload := bytes of("pingpong")
    سرچاپ "send ping: "، اچ تی تی پی۲.ارسال پینگ(cc، payload)
    سرچاپ "server poll ping: "، اچ تی تی پی۲.دریافت رویداد(sc)
    سرچاپ "client poll pong: "، اچ تی تی پی۲.دریافت رویداد(cc)

    other := اچ تی تی پی۲.شناسه جریان بعدی(cc)
    سرچاپ "send reset: "، اچ تی تی پی۲.ارسال بازنشانی جریان(cc، other، اچ تی تی پی۲.کد لغو)
    سرچاپ "server poll reset: "، اچ تی تی پی۲.دریافت رویداد(sc) برابر other
    rs := اچ تی تی پی۲.جریان با شناسه(sc، other)
    سرچاپ "stream reset: "، rs.بازنشانی‌شده، اچ تی تی پی۲.نام خطا(rs.کد خطا)
    سرچاپ "await reset: "، اچ تی تی پی۲.انتظار اتمام جریان(sc، other، 3)

    سرچاپ "send goaway: "، اچ تی تی پی۲.ارسال خداحافظی(sc، اچ تی تی پی۲.کد بدون خطا، "bye")
    سرچاپ "client poll goaway: "، اچ تی تی پی۲.دریافت رویداد(cc)
    سرچاپ "goaway seen: "، cc.قاب خاتمه، اچ تی تی پی۲.نام خطا(cc.آخرین کد خطا)

    ناپایا empty := فشرده سازی.بافر بایت جدید()
    سرچاپ "await nothing: "، اچ تی تی پی۲.انتظار سرآیند(cc، 0) برابر اچ تی تی پی۲.نتیجه خطا

    فشرده سازی.آزادسازی بافر(empty)
    فشرده سازی.آزادسازی بافر(payload)
    فشرده سازی.آزادسازی بافر(body)
    اچ تی تی پی۲.بستن اتصال(sc)
    سرچاپ "server closed: "، اچ تی تی پی۲.اتصال معتبر(sc)
    سرچاپ "poll after peer close: "، اچ تی تی پی۲.دریافت رویداد(cc) برابر اچ تی تی پی۲.نتیجه خطا
    اچ تی تی پی۲.بستن ترابری(ct)
    سرچاپ "transport closed: "، ct.سالم
    تی سی پی.بستن سرور(srv)
پایان
