بسته ریشه

واردسازی شبکه.اچ تی تی پی۲
واردسازی فشرده سازی
واردسازی تبدیل

تابع شانزدهی از بافر(b: فشرده سازی.بافر بایت): رشته:
    ناپایا نتیجه := ""
    ناپایا i := 0
    تا i کوچکتر فشرده سازی.طول بافر(b):
        v := فشرده سازی.دریافت بایت(b، i)
        اگر v کوچکتر 16: نتیجه += "0" پایان
        نتیجه += تبدیل.قالب شانزده(v برگردان طبیعی۶۴).کوچک()
        i++
    پایان
    برگشت نتیجه
پایان

تابع ریشه:
    سرچاپ "huffman len www.example.com: "، اچ تی تی پی۲.طول کدشده متن("www.example.com")
    سرچاپ "huffman len no-cache: "، اچ تی تی پی۲.طول کدشده متن("no-cache")
    سرچاپ "huffman len empty: "، اچ تی تی پی۲.طول کدشده متن("")
    متن := "custom-key"
    سرچاپ "huffman len raw: "، اچ تی تی پی۲.طول کدشده هافمن(متن برگردان تهی*، متن.طول())
    ناپایا فشرده := اچ تی تی پی۲.کدگذاری متن هافمن(متن)
    سرچاپ "len matches encoding: "، فشرده سازی.طول بافر(فشرده) برابر اچ تی تی پی۲.طول کدشده متن(متن)
    فشرده سازی.آزادسازی بافر(فشرده)

    ناپایا سرآیندهای من := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(سرآیندهای من، "accept"، "text/html")
    اچ تی تی پی۲.افزودن سرآیند حساس(سرآیندهای من، "authorization"، "token")
    سرچاپ "has accept: "، اچ تی تی پی۲.سرآیند دارد(سرآیندهای من، "accept")
    سرچاپ "has authorization: "، اچ تی تی پی۲.سرآیند دارد(سرآیندهای من، "authorization")
    سرچاپ "has cookie: "، اچ تی تی پی۲.سرآیند دارد(سرآیندهای من، "cookie")
    سرچاپ "plain is not sensitive: "، سرآیندهای من.سرآیندها.بگیر(0).حساس
    سرچاپ "added sensitive: "، سرآیندهای من.سرآیندها.بگیر(1).حساس

    سرآیند محرمانه := اچ تی تی پی۲.سرآیند حساس("password"، "secret")
    سرچاپ "sensitive header: "، سرآیند محرمانه.نام، سرآیند محرمانه.مقدار، سرآیند محرمانه.حساس

    ناپایا جدول := اچ تی تی پی۲.جدول پویا جدید(4096)
    ناپایا نتیجه := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری سرآیند(نتیجه، جدول، اچ تی تی پی۲.سرآیند جدید(":method"، "GET")، درست)
    سرچاپ "indexed: "، شانزدهی از بافر(نتیجه)
    سرچاپ "table untouched: "، اچ تی تی پی۲.تعداد جدول پویا(جدول)

    ناپایا حرفی := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری سرآیند(حرفی، جدول، اچ تی تی پی۲.سرآیند جدید("custom-key"، "custom-value")، نادرست)
    سرچاپ "literal: "، شانزدهی از بافر(حرفی)
    سرچاپ "table grew: "، اچ تی تی پی۲.تعداد جدول پویا(جدول)

    ناپایا بدون نمایه := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری سرآیند(بدون نمایه، جدول، سرآیند محرمانه، نادرست)
    سرچاپ "never indexed: "، شانزدهی از بافر(بدون نمایه)
    سرچاپ "table unchanged: "، اچ تی تی پی۲.تعداد جدول پویا(جدول)

    ناپایا موفق := نادرست
    مدخل := اچ تی تی پی۲.دریافت از جدول(جدول، 62، موفق)
    سرچاپ "dynamic entry: "، موفق، مدخل.نام، مدخل.مقدار
    مدخل ایستا := اچ تی تی پی۲.دریافت از جدول(جدول، 2، موفق)
    سرچاپ "static entry: "، موفق، مدخل ایستا.نام، مدخل ایستا.مقدار
    اچ تی تی پی۲.دریافت از جدول(جدول، 63، موفق)
    سرچاپ "past the end: "، موفق
    اچ تی تی پی۲.دریافت از جدول(جدول، 0، موفق)
    سرچاپ "index zero: "، موفق

    ناپایا به‌روزرسانی صفر := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری تغییر اندازه جدول(به‌روزرسانی صفر، جدول، 0)
    سرچاپ "size update zero: "، شانزدهی از بافر(به‌روزرسانی صفر)
    سرچاپ "table emptied: "، اچ تی تی پی۲.تعداد جدول پویا(جدول)، اچ تی تی پی۲.اندازه جدول پویا(جدول)
    ناپایا به‌روزرسانی کامل := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری تغییر اندازه جدول(به‌روزرسانی کامل، جدول، 4096)
    سرچاپ "size update 4096: "، شانزدهی از بافر(به‌روزرسانی کامل)

    ناپایا جدول رمزگشا := اچ تی تی پی۲.جدول پویا جدید(4096)
    ناپایا رمزگشایی موفق := نادرست
    رمزگشایی شده := اچ تی تی پی۲.کدگشایی فهرست سرآیند(جدول رمزگشا، حرفی، رمزگشایی موفق)
    سرچاپ "decoded literal: "، رمزگشایی موفق، اچ تی تی پی۲.دریافت سرآیند(رمزگشایی شده، "custom-key")

    ناپایا f := اچ تی تی پی۲.قاب جدید(اچ تی تی پی۲.قاب سرصفحه‌ها، اچ تی تی پی۲.پرچم لایه‌گذاری، 1)
    فشرده سازی.افزودن بایت(f.بار، 2)
    فشرده سازی.افزودن بایت(f.بار، 0x82)
    فشرده سازی.افزودن بایت(f.بار، 0x86)
    فشرده سازی.افزودن بایت(f.بار، 0)
    فشرده سازی.افزودن بایت(f.بار، 0)
    ناپایا بلوک موفق := نادرست
    ناپایا بلوک := اچ تی تی پی۲.بلوک سرآیند قاب(f، بلوک موفق)
    سرچاپ "padded block: "، بلوک موفق، شانزدهی از بافر(بلوک)
    فشرده سازی.آزادسازی بافر(بلوک)
    اچ تی تی پی۲.آزادسازی قاب(f)

    ناپایا قاب کوتاه := اچ تی تی پی۲.قاب جدید(اچ تی تی پی۲.قاب سرصفحه‌ها، اچ تی تی پی۲.پرچم لایه‌گذاری، 1)
    ناپایا کوتاه موفق := درست
    ناپایا بلوک خالی := اچ تی تی پی۲.بلوک سرآیند قاب(قاب کوتاه، کوتاه موفق)
    سرچاپ "padded but empty: "، کوتاه موفق، فشرده سازی.طول بافر(بلوک خالی)
    فشرده سازی.آزادسازی بافر(بلوک خالی)
    اچ تی تی پی۲.آزادسازی قاب(قاب کوتاه)

    ناپایا قاب اولویت := اچ تی تی پی۲.قاب جدید(اچ تی تی پی۲.قاب سرصفحه‌ها، اچ تی تی پی۲.پرچم اولویت، 1)
    تکرار 5:
        فشرده سازی.افزودن بایت(قاب اولویت.بار، 0)
    پایان
    فشرده سازی.افزودن بایت(قاب اولویت.بار، 0x84)
    ناپایا اولویت موفق := نادرست
    ناپایا بلوک اولویت := اچ تی تی پی۲.بلوک سرآیند قاب(قاب اولویت، اولویت موفق)
    سرچاپ "priority block: "، اولویت موفق، شانزدهی از بافر(بلوک اولویت)
    فشرده سازی.آزادسازی بافر(بلوک اولویت)
    اچ تی تی پی۲.آزادسازی قاب(قاب اولویت)

    فشرده سازی.آزادسازی بافر(به‌روزرسانی کامل)
    فشرده سازی.آزادسازی بافر(به‌روزرسانی صفر)
    فشرده سازی.آزادسازی بافر(بدون نمایه)
    فشرده سازی.آزادسازی بافر(حرفی)
    فشرده سازی.آزادسازی بافر(نتیجه)
پایان
