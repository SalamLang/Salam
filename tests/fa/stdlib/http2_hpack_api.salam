بسته ریشه

واردسازی شبکه.اچ تی تی پی۲
واردسازی فشرده سازی
واردسازی تبدیل

تابع hex of(b: فشرده سازی.بافر بایت): رشته:
    ناپایا out := ""
    ناپایا i := 0
    تا i کوچکتر فشرده سازی.طول بافر(b):
        v := فشرده سازی.دریافت بایت(b، i)
        اگر v کوچکتر 16: out = out + "0" پایان
        out = out + تبدیل.قالب شانزده(v برگردان طبیعی۶۴).کوچک()
        i += 1
    پایان
    برگشت out
پایان

تابع ریشه:
    سرچاپ "huffman len www.example.com: "، اچ تی تی پی۲.طول کدشده متن("www.example.com")
    سرچاپ "huffman len no-cache: "، اچ تی تی پی۲.طول کدشده متن("no-cache")
    سرچاپ "huffman len empty: "، اچ تی تی پی۲.طول کدشده متن("")
    text := "custom-key"
    سرچاپ "huffman len raw: "، اچ تی تی پی۲.طول کدشده هافمن(text برگردان تهی*، text.طول())
    ناپایا packed := اچ تی تی پی۲.کدگذاری متن هافمن(text)
    سرچاپ "len matches encoding: "، فشرده سازی.طول بافر(packed) برابر اچ تی تی پی۲.طول کدشده متن(text)
    فشرده سازی.آزادسازی بافر(packed)

    ناپایا hl := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(hl، "accept"، "text/html")
    اچ تی تی پی۲.افزودن سرآیند حساس(hl، "authorization"، "token")
    سرچاپ "has accept: "، اچ تی تی پی۲.سرآیند دارد(hl، "accept")
    سرچاپ "has authorization: "، اچ تی تی پی۲.سرآیند دارد(hl، "authorization")
    سرچاپ "has cookie: "، اچ تی تی پی۲.سرآیند دارد(hl، "cookie")
    سرچاپ "plain is not sensitive: "، hl.سرآیندها.بگیر(0).حساس
    سرچاپ "added sensitive: "، hl.سرآیندها.بگیر(1).حساس

    secret := اچ تی تی پی۲.سرآیند حساس("password"، "secret")
    سرچاپ "sensitive header: "، secret.نام، secret.مقدار، secret.حساس

    ناپایا table := اچ تی تی پی۲.جدول پویا جدید(4096)
    ناپایا out := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری سرآیند(out، table، اچ تی تی پی۲.سرآیند جدید(":method"، "GET")، درست)
    سرچاپ "indexed: "، hex of(out)
    سرچاپ "table untouched: "، اچ تی تی پی۲.تعداد جدول پویا(table)

    ناپایا lit := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری سرآیند(lit، table، اچ تی تی پی۲.سرآیند جدید("custom-key"، "custom-value")، نادرست)
    سرچاپ "literal: "، hex of(lit)
    سرچاپ "table grew: "، اچ تی تی پی۲.تعداد جدول پویا(table)

    ناپایا never := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری سرآیند(never، table، secret، نادرست)
    سرچاپ "never indexed: "، hex of(never)
    سرچاپ "table unchanged: "، اچ تی تی پی۲.تعداد جدول پویا(table)

    ناپایا ok := نادرست
    entry := اچ تی تی پی۲.دریافت از جدول(table، 62، ok)
    سرچاپ "dynamic entry: "، ok، entry.نام، entry.مقدار
    stat := اچ تی تی پی۲.دریافت از جدول(table، 2، ok)
    سرچاپ "static entry: "، ok، stat.نام، stat.مقدار
    اچ تی تی پی۲.دریافت از جدول(table، 63، ok)
    سرچاپ "past the end: "، ok
    اچ تی تی پی۲.دریافت از جدول(table، 0، ok)
    سرچاپ "index zero: "، ok

    ناپایا upd := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری تغییر اندازه جدول(upd، table، 0)
    سرچاپ "size update zero: "، hex of(upd)
    سرچاپ "table emptied: "، اچ تی تی پی۲.تعداد جدول پویا(table)، اچ تی تی پی۲.اندازه جدول پویا(table)
    ناپایا upd2 := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.کدگذاری تغییر اندازه جدول(upd2، table، 4096)
    سرچاپ "size update 4096: "، hex of(upd2)

    ناپایا dec := اچ تی تی پی۲.جدول پویا جدید(4096)
    ناپایا dok := نادرست
    back := اچ تی تی پی۲.کدگشایی فهرست سرآیند(dec، lit، dok)
    سرچاپ "decoded literal: "، dok، اچ تی تی پی۲.دریافت سرآیند(back، "custom-key")

    ناپایا f := اچ تی تی پی۲.قاب جدید(اچ تی تی پی۲.قاب سرصفحه‌ها، اچ تی تی پی۲.پرچم لایه‌گذاری، 1)
    فشرده سازی.افزودن بایت(f.بار، 2)
    فشرده سازی.افزودن بایت(f.بار، 0x82)
    فشرده سازی.افزودن بایت(f.بار، 0x86)
    فشرده سازی.افزودن بایت(f.بار، 0)
    فشرده سازی.افزودن بایت(f.بار، 0)
    ناپایا bok := نادرست
    ناپایا block := اچ تی تی پی۲.بلوک سرآیند قاب(f، bok)
    سرچاپ "padded block: "، bok، hex of(block)
    فشرده سازی.آزادسازی بافر(block)
    اچ تی تی پی۲.آزادسازی قاب(f)

    ناپایا short := اچ تی تی پی۲.قاب جدید(اچ تی تی پی۲.قاب سرصفحه‌ها، اچ تی تی پی۲.پرچم لایه‌گذاری، 1)
    ناپایا sok := درست
    ناپایا empty := اچ تی تی پی۲.بلوک سرآیند قاب(short، sok)
    سرچاپ "padded but empty: "، sok، فشرده سازی.طول بافر(empty)
    فشرده سازی.آزادسازی بافر(empty)
    اچ تی تی پی۲.آزادسازی قاب(short)

    ناپایا prio := اچ تی تی پی۲.قاب جدید(اچ تی تی پی۲.قاب سرصفحه‌ها، اچ تی تی پی۲.پرچم اولویت، 1)
    تکرار 5:
        فشرده سازی.افزودن بایت(prio.بار، 0)
    پایان
    فشرده سازی.افزودن بایت(prio.بار، 0x84)
    ناپایا pok := نادرست
    ناپایا pblock := اچ تی تی پی۲.بلوک سرآیند قاب(prio، pok)
    سرچاپ "priority block: "، pok، hex of(pblock)
    فشرده سازی.آزادسازی بافر(pblock)
    اچ تی تی پی۲.آزادسازی قاب(prio)

    فشرده سازی.آزادسازی بافر(upd2)
    فشرده سازی.آزادسازی بافر(upd)
    فشرده سازی.آزادسازی بافر(never)
    فشرده سازی.آزادسازی بافر(lit)
    فشرده سازی.آزادسازی بافر(out)
پایان
