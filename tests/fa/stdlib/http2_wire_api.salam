// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی
واردسازی تی ال اس
واردسازی فشرده سازی

تابع ریشه:
    srv := تی سی پی.پیوند(0)
    cli := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(srv))
    acc := تی سی پی.پذیرش(srv)
    ناپایا ct := اچ تی تی پی۲.ترابری ساده(cli.توصیفگر)
    ناپایا st := اچ تی تی پی۲.ترابری ساده(acc.توصیفگر)

    سرچاپ "write preface: "، اچ تی تی پی۲.نوشتن پیش‌درآمد(ct)
    سرچاپ "read preface: "، اچ تی تی پی۲.خواندن پیش‌درآمد(st)

    ناپایا payload := فشرده سازی.بافر از رشته("12345678")
    ناپایا ping := اچ تی تی پی۲.ساخت پینگ(payload، نادرست)
    سرچاپ "ping frame: "، ping.نوع برابر اچ تی تی پی۲.قاب پینگ، ping.شناسه جریان، فشرده سازی.طول بافر(ping.بار)
    سرچاپ "ping ack flag: "، اچ تی تی پی۲.قاب پرچم دارد(ping، اچ تی تی پی۲.پرچم تایید)
    سرچاپ "write ping: "، اچ تی تی پی۲.نوشتن قاب(ct، ping)
    ناپایا got := اچ تی تی پی۲.خواندن قاب(st، اچ تی تی پی۲.اندازه پیش‌فرض قاب)
    سرچاپ "read ping: "، got.خوانده‌شده، got.نوع برابر اچ تی تی پی۲.قاب پینگ، فشرده سازی.بافر به رشته(got.بار)
    اچ تی تی پی۲.آزادسازی قاب(got)
    اچ تی تی پی۲.آزادسازی قاب(ping)

    ناپایا short := فشرده سازی.بافر از رشته("abc")
    ناپایا pong := اچ تی تی پی۲.ساخت پینگ(short، درست)
    سرچاپ "pong ack flag: "، اچ تی تی پی۲.قاب پرچم دارد(pong، اچ تی تی پی۲.پرچم تایید)
    سرچاپ "padded payload: "، فشرده سازی.طول بافر(pong.بار)، فشرده سازی.دریافت بایت(pong.بار، 2)، فشرده سازی.دریافت بایت(pong.بار، 3)
    اچ تی تی پی۲.آزادسازی قاب(pong)

    ناپایا ack := اچ تی تی پی۲.ساخت تایید تنظیمات()
    سرچاپ "settings ack: "، ack.نوع برابر اچ تی تی پی۲.قاب تنظیمات، اچ تی تی پی۲.قاب پرچم دارد(ack، اچ تی تی پی۲.پرچم تایید)، فشرده سازی.طول بافر(ack.بار)
    سرچاپ "write ack: "، اچ تی تی پی۲.نوشتن قاب(st، ack)
    ناپایا back := اچ تی تی پی۲.خواندن قاب(ct، اچ تی تی پی۲.اندازه پیش‌فرض قاب)
    سرچاپ "read ack: "، back.خوانده‌شده، back.نوع برابر اچ تی تی پی۲.قاب تنظیمات، اچ تی تی پی۲.قاب پرچم دارد(back، اچ تی تی پی۲.پرچم تایید)
    اچ تی تی پی۲.آزادسازی قاب(back)
    اچ تی تی پی۲.آزادسازی قاب(ack)

    ناپایا entries := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.درج تنظیم(entries، اچ تی تی پی۲.تنظیم بیشینه اندازه قاب، 32768)
    اچ تی تی پی۲.درج تنظیم(entries، اچ تی تی پی۲.تنظیم بیشینه جریان‌های همزمان، 7)
    سرچاپ "setting bytes: "، فشرده سازی.طول بافر(entries)
    سرچاپ "first id: "، فشرده سازی.دریافت بایت(entries، 0) * 256 + فشرده سازی.دریافت بایت(entries، 1)
    سرچاپ "first value: "، فشرده سازی.دریافت بایت(entries، 4) * 256 + فشرده سازی.دریافت بایت(entries، 5)
    سرچاپ "second value: "، فشرده سازی.دریافت بایت(entries، 11)
    ناپایا sf := اچ تی تی پی۲.قاب جدید(اچ تی تی پی۲.قاب تنظیمات، 0، 0)
    فشرده سازی.افزودن بافر(sf.بار، entries)
    ناپایا applied := اچ تی تی پی۲.تنظیمات پیش‌فرض()
    سرچاپ "apply: "، اچ تی تی پی۲.اعمال تنظیمات(applied، sf)
    سرچاپ "applied: "، applied.بیشترین اندازه قاب، applied.بیشترین جریان همزمان
    اچ تی تی پی۲.آزادسازی قاب(sf)
    فشرده سازی.آزادسازی بافر(entries)

    تی سی پی.نوشتن(cli، "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    سرچاپ "wrong preface: "، اچ تی تی پی۲.خواندن پیش‌درآمد(st)

    tc := تی ال اس.اتصال {}
    tt := اچ تی تی پی۲.ترابری امن(tc)
    سرچاپ "tls transport kind: "، tt.نوع برابر اچ تی تی پی۲.انتقال امن
    سرچاپ "tls transport ok: "، tt.سالم

    فشرده سازی.آزادسازی بافر(short)
    فشرده سازی.آزادسازی بافر(payload)
    اچ تی تی پی۲.بستن ترابری(ct)
    اچ تی تی پی۲.بستن ترابری(st)
    سرچاپ "closed: "، ct.سالم، st.سالم
    تی سی پی.بستن سرور(srv)
پایان
