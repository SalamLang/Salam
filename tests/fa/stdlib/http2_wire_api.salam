بسته ریشه

واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی
واردسازی تی ال اس
واردسازی فشرده سازی

تابع ریشه:
    سوکت سرور := تی سی پی.پیوند(0)
    سوکت کارخواه := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(سوکت سرور))
    سوکت پذیرفته := تی سی پی.پذیرش(سوکت سرور)
    ناپایا ترابری کارخواه := اچ تی تی پی۲.ترابری ساده(سوکت کارخواه.توصیفگر)
    ناپایا ترابری سرور := اچ تی تی پی۲.ترابری ساده(سوکت پذیرفته.توصیفگر)

    سرچاپ "write preface: "، اچ تی تی پی۲.نوشتن پیش‌درآمد(ترابری کارخواه)
    سرچاپ "read preface: "، اچ تی تی پی۲.خواندن پیش‌درآمد(ترابری سرور)

    ناپایا بار := فشرده سازی.بافر از رشته("12345678")
    ناپایا قاب پینگ := اچ تی تی پی۲.ساخت پینگ(بار، نادرست)
    سرچاپ "ping frame: "، قاب پینگ.نوع برابر اچ تی تی پی۲.قاب پینگ، قاب پینگ.شناسه جریان، فشرده سازی.طول بافر(قاب پینگ.بار)
    سرچاپ "ping ack flag: "، اچ تی تی پی۲.قاب پرچم دارد(قاب پینگ، اچ تی تی پی۲.پرچم تایید)
    سرچاپ "write ping: "، اچ تی تی پی۲.نوشتن قاب(ترابری کارخواه، قاب پینگ)
    ناپایا دریافتی := اچ تی تی پی۲.خواندن قاب(ترابری سرور، اچ تی تی پی۲.اندازه پیش‌فرض قاب)
    سرچاپ "read ping: "، دریافتی.خوانده‌شده، دریافتی.نوع برابر اچ تی تی پی۲.قاب پینگ، فشرده سازی.بافر به رشته(دریافتی.بار)
    اچ تی تی پی۲.آزادسازی قاب(دریافتی)
    اچ تی تی پی۲.آزادسازی قاب(قاب پینگ)

    ناپایا کوتاه := فشرده سازی.بافر از رشته("abc")
    ناپایا قاب پونگ := اچ تی تی پی۲.ساخت پینگ(کوتاه، درست)
    سرچاپ "pong ack flag: "، اچ تی تی پی۲.قاب پرچم دارد(قاب پونگ، اچ تی تی پی۲.پرچم تایید)
    سرچاپ "padded payload: "، فشرده سازی.طول بافر(قاب پونگ.بار)، فشرده سازی.دریافت بایت(قاب پونگ.بار، 2)، فشرده سازی.دریافت بایت(قاب پونگ.بار، 3)
    اچ تی تی پی۲.آزادسازی قاب(قاب پونگ)

    ناپایا قاب تایید := اچ تی تی پی۲.ساخت تایید تنظیمات()
    سرچاپ "settings ack: "، قاب تایید.نوع برابر اچ تی تی پی۲.قاب تنظیمات، اچ تی تی پی۲.قاب پرچم دارد(قاب تایید، اچ تی تی پی۲.پرچم تایید)، فشرده سازی.طول بافر(قاب تایید.بار)
    سرچاپ "write ack: "، اچ تی تی پی۲.نوشتن قاب(ترابری سرور، قاب تایید)
    ناپایا تایید دریافتی := اچ تی تی پی۲.خواندن قاب(ترابری کارخواه، اچ تی تی پی۲.اندازه پیش‌فرض قاب)
    سرچاپ "read ack: "، تایید دریافتی.خوانده‌شده، تایید دریافتی.نوع برابر اچ تی تی پی۲.قاب تنظیمات، اچ تی تی پی۲.قاب پرچم دارد(تایید دریافتی، اچ تی تی پی۲.پرچم تایید)
    اچ تی تی پی۲.آزادسازی قاب(تایید دریافتی)
    اچ تی تی پی۲.آزادسازی قاب(قاب تایید)

    ناپایا مدخل ها := فشرده سازی.بافر بایت جدید()
    اچ تی تی پی۲.درج تنظیم(مدخل ها، اچ تی تی پی۲.تنظیم بیشینه اندازه قاب، 32768)
    اچ تی تی پی۲.درج تنظیم(مدخل ها، اچ تی تی پی۲.تنظیم بیشینه جریان‌های همزمان، 7)
    سرچاپ "setting bytes: "، فشرده سازی.طول بافر(مدخل ها)
    سرچاپ "first id: "، فشرده سازی.دریافت بایت(مدخل ها، 0) * 256 + فشرده سازی.دریافت بایت(مدخل ها، 1)
    سرچاپ "first value: "، فشرده سازی.دریافت بایت(مدخل ها، 4) * 256 + فشرده سازی.دریافت بایت(مدخل ها، 5)
    سرچاپ "second value: "، فشرده سازی.دریافت بایت(مدخل ها، 11)
    ناپایا قاب تنظیمات := اچ تی تی پی۲.قاب جدید(اچ تی تی پی۲.قاب تنظیمات، 0، 0)
    فشرده سازی.افزودن بافر(قاب تنظیمات.بار، مدخل ها)
    ناپایا اعمال شده := اچ تی تی پی۲.تنظیمات پیش‌فرض()
    سرچاپ "apply: "، اچ تی تی پی۲.اعمال تنظیمات(اعمال شده، قاب تنظیمات)
    سرچاپ "applied: "، اعمال شده.بیشترین اندازه قاب، اعمال شده.بیشترین جریان همزمان
    اچ تی تی پی۲.آزادسازی قاب(قاب تنظیمات)
    فشرده سازی.آزادسازی بافر(مدخل ها)

    تی سی پی.نوشتن(سوکت کارخواه، "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    سرچاپ "wrong preface: "، اچ تی تی پی۲.خواندن پیش‌درآمد(ترابری سرور)

    اتصال امن := تی ال اس.اتصال {}
    ترابری تی ال اس := اچ تی تی پی۲.ترابری امن(اتصال امن)
    سرچاپ "tls transport kind: "، ترابری تی ال اس.نوع برابر اچ تی تی پی۲.انتقال امن
    سرچاپ "tls transport ok: "، ترابری تی ال اس.سالم

    فشرده سازی.آزادسازی بافر(کوتاه)
    فشرده سازی.آزادسازی بافر(بار)
    اچ تی تی پی۲.بستن ترابری(ترابری کارخواه)
    اچ تی تی پی۲.بستن ترابری(ترابری سرور)
    سرچاپ "closed: "، ترابری کارخواه.سالم، ترابری سرور.سالم
    تی سی پی.بستن سرور(سوکت سرور)
پایان
