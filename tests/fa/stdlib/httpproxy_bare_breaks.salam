واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی

تابع ریشه():
    good := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET http://a.example/ HTTP/1.1\r\nHost: a.example\r\nX-A: 1\r\n\r\n")
    سرچاپ "plain head"، good.معتبر
    lf := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET http://a.example/ HTTP/1.1\r\nHost: a.example\r\nX-A: 1\nContent-Length: 5\r\n\r\n")
    سرچاپ "bare LF in a value"، lf.معتبر، lf.خطا
    cr := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET http://a.example/ HTTP/1.1\r\nHost: a.example\r\nX-A: 1\rX-B: 2\r\n\r\n")
    سرچاپ "bare CR in a value"، cr.معتبر، cr.خطا
    path := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET http://a.example/x\nHost:evil HTTP/1.1\r\nHost: a.example\r\n\r\n")
    سرچاپ "bare LF in the target"، path.معتبر
    rs := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند پاسخ("HTTP/1.1 200 OK\r\nX-A: 1\nSet-Cookie: s=1\r\n\r\n")
    سرچاپ "bare LF in a response"، rs.معتبر
    rok := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند پاسخ("HTTP/1.1 200 OK\r\nX-A: 1\r\n\r\n")
    سرچاپ "plain response"، rok.معتبر
پایان
