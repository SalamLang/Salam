واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی رشته

ناپایا seen_hosts := ""
ناپایا origin_port := 0

تابع origin_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    ناپایا buf := ""
    تا buf.بیاب("\r\n\r\n") کوچکتر 0:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        buf += d
    پایان
    h := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست(buf)
    body := "path " + h.هدف + " host " + پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(h، "host")
    تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: " + body.طول() + "\r\nConnection: close\r\n\r\n" + body)
    تی سی پی.بستن(c)
پایان

تابع origin_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(origin_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        تی سی پی.نوشتن(c، d)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع show(label: رشته، r: پراکسی اچ‌تی‌تی‌پی.پاسخ):
    سرچاپ label + ": ok=" + r.موفق + " status=" + r.وضعیت + " body=[" + رشته.جایگزینی(r.بدنه، ":" + origin_port، ":PORT") + "] " + r.خطا
پایان

تابع tunnel_round(label: رشته، cl: پراکسی اچ‌تی‌تی‌پی.کلاینت، host: رشته، port: صحیح):
    r := پراکسی اچ‌تی‌تی‌پی.اتصال(cl، host، port)
    سرچاپ label + ": ok=" + r.موفق + " status=" + r.وضعیت
    اگر r.موفق:
        r.جریان.نوشتن("through the tunnel")
        سرچاپ r.جریان.خواندن(100)
        r.جریان.بستن()
    پایان
پایان

تابع ریشه:
    probe := تی سی پی.پیوند روی("::1"، 0)
    اگر وارونه تی سی پی.معتبر(probe):
        سرچاپ "ipv6 unavailable"
        برگشت
    پایان
    تی سی پی.بستن سرور(probe)

    hp := پراکسی اچ‌تی‌تی‌پی.جداسازی میزبان درگاه("[2001:db8::1]:8080"، 80)
    سرچاپ hp.معتبر، hp.میزبان، hp.درگاه، hp.درگاه دارد
    hp2 := پراکسی اچ‌تی‌تی‌پی.جداسازی میزبان درگاه("[::1]"، 443)
    سرچاپ hp2.معتبر، hp2.میزبان، hp2.درگاه، hp2.درگاه دارد
    سرچاپ پراکسی اچ‌تی‌تی‌پی.جداسازی میزبان درگاه("::1:80"، 80).معتبر، پراکسی اچ‌تی‌تی‌پی.جداسازی میزبان درگاه("[::1"، 80).معتبر، پراکسی اچ‌تی‌تی‌پی.جداسازی میزبان درگاه("[::1]x"، 80).معتبر
    u := پراکسی اچ‌تی‌تی‌پی.تجزیه نشانی وب("http://user@[2001:db8::2]:8081/a/b?q=1")
    سرچاپ u.معتبر، u.میزبان، u.درگاه، u.مسیر
    u2 := پراکسی اچ‌تی‌تی‌پی.تجزیه نشانی وب("https://[::1]/")
    سرچاپ u2.معتبر، u2.میزبان، u2.درگاه

    os := تی سی پی.پیوند روی("::1"، 0)
    ساکس.برو(origin_accept، os.توصیفگر برگردان تهی*)
    oport := تی سی پی.درگاه(os)
    origin_port = oport
    es := تی سی پی.پیوند روی("::1"، 0)
    ساکس.برو(echo_accept، es.توصیفگر برگردان تهی*)
    eport := تی سی پی.درگاه(es)
    origin := "http://[::1]:" + oport

    ناپایا cfg4 := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(cfg4، درست)
    sv4 := پراکسی اچ‌تی‌تی‌پی.شروع(cfg4)
    سرچاپ "v4 proxy up"، sv4.موفق
    cl4 := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، sv4.درگاه)
    show("absolute uri to [::1]"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl4، origin + "/hello"))
    show("post to [::1]"، پراکسی اچ‌تی‌تی‌پی.ارسال(cl4، origin + "/echo"، "text/plain"، "x"))
    tunnel_round("connect [::1]"، cl4، "::1"، eport)
    conn := پراکسی اچ‌تی‌تی‌پی.شماره‌گیری اتصال(cl4، "::1"، eport)
    تی سی پی.نوشتن(conn، "dial conn")
    سرچاپ تی سی پی.خواندن(conn، 100)
    تی سی پی.بستن(conn)
    raw := تی سی پی.شماره گیری("127.0.0.1"، sv4.درگاه)
    تی سی پی.نوشتن(raw، "CONNECT [::1]:" + eport + " HTTP/1.1\r\nHost: [::1]:" + eport + "\r\n\r\n")
    سرچاپ تی سی پی.خواندن(raw، 200).زیررشته(0، 15)
    تی سی پی.نوشتن(raw، "raw tunnel")
    سرچاپ تی سی پی.خواندن(raw، 100)
    تی سی پی.بستن(raw)
    free := تی سی پی.درگاه آزاد()
    show("v6 upstream refused"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl4، "http://[::1]:" + free + "/"))
    پراکسی اچ‌تی‌تی‌پی.توقف(sv4)

    ناپایا cfg6 := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(cfg6، درست)
    cfg6.میزبان پیوند = "::1"
    cfg6.اجازه = (method: رشته، host: رشته، _port: صحیح): seen_hosts += method + "@" + host + ";" برگشت درست پایان
    sv6 := پراکسی اچ‌تی‌تی‌پی.شروع(cfg6)
    سرچاپ "v6 proxy up"، sv6.موفق، sv6.میزبان
    cl6 := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("::1"، sv6.درگاه)
    show("via v6 proxy absolute uri"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl6، origin + "/hello"))
    tunnel_round("via v6 proxy connect"، cl6، "::1"، eport)
    سرچاپ seen_hosts
    پراکسی اچ‌تی‌تی‌پی.توقف(sv6)

    ناپایا cfgd := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(cfgd، درست)
    cfgd.میزبان پیوند = "::"
    تونل.افزودن بازه مجاز(cfgd.سیاست مقصد، "::1/128")
    تونل.افزودن بازه مجاز(cfgd.سیاست مقصد، "127.0.0.0/8")
    svd := پراکسی اچ‌تی‌تی‌پی.شروع(cfgd)
    سرچاپ "dual proxy up"، svd.موفق
    show("dual via v4"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، svd.درگاه)، origin + "/hello"))
    show("dual via v6"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("::1"، svd.درگاه)، origin + "/hello"))
    پراکسی اچ‌تی‌تی‌پی.توقف(svd)
پایان
