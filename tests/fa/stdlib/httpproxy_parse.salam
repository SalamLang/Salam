واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی رشته

تابع show(label: رشته، h: پراکسی اچ‌تی‌تی‌پی.سرآیند):
    سرچاپ label + ": ok=" + h.معتبر + " " + h.خطا
پایان

تابع ریشه:
    r := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET http://example.com:8080/a/b?x=1 HTTP/1.1\r\nHost: example.com:8080\r\nProxy-Authorization: Basic dXNlcjpwYXNz\r\nConnection: keep-alive, X-Drop\r\nX-Drop: 1\r\n\r\n")
    سرچاپ r.معتبر، r.روش، r.هدف، r.نسخه، r.نام‌ها.طول()
    سرچاپ پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(r، "HOST") + "|" + پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(r، "x-drop") + "|" + پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(r، "missing") + "|"
    سرچاپ پراکسی اچ‌تی‌تی‌پی.سرآیند دارد(r، "proxy-authorization")، پراکسی اچ‌تی‌تی‌پی.سرآیند توکن دارد(r، "connection"، "KEEP-ALIVE")، پراکسی اچ‌تی‌تی‌پی.سرآیند توکن دارد(r، "connection"، "close")، پراکسی اچ‌تی‌تی‌پی.تعداد سرآیند(r، "host")

    show("lowercase method ok"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("get / HTTP/1.1\r\n\r\n"))
    show("bad method"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("G@T / HTTP/1.1\r\n\r\n"))
    show("missing version"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET /\r\n\r\n"))
    show("http 2"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET / HTTP/2.0\r\n\r\n"))
    show("http 0.9"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET / HTTP/0.9\r\n\r\n"))
    show("extra spaces"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET  / HTTP/1.1\r\n\r\n"))
    show("no colon"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET / HTTP/1.1\r\nBroken header\r\n\r\n"))
    show("space before colon"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET / HTTP/1.1\r\nHost : a\r\n\r\n"))
    show("folded"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET / HTTP/1.1\r\nA: b\r\n c\r\n\r\n"))
    show("empty name"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET / HTTP/1.1\r\n: v\r\n\r\n"))
    show("empty"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست(""))
    ناپایا many := "GET / HTTP/1.1\r\n"
    تکرار 201 در i:
        many += "X" + i + ": 1\r\n"
    پایان
    show("too many headers"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست(many + "\r\n"))
    ناپایا ok200 := "GET / HTTP/1.1\r\n"
    تکرار 200 در i:
        ok200 += "X" + i + ": 1\r\n"
    پایان
    show("exactly 200 headers"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست(ok200 + "\r\n"))
    show("head too big"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست("GET / HTTP/1.1\r\nX: " + "a".تکرار(70000) + "\r\n\r\n"))

    p := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند پاسخ("HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm=\"x\"\r\nContent-Length: 0\r\n\r\n")
    سرچاپ p.معتبر، p.وضعیت، p.دلیل، پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(p، "proxy-authenticate")
    p2 := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند پاسخ("HTTP/1.0 204\r\n\r\n")
    سرچاپ p2.معتبر، p2.وضعیت، "[" + p2.دلیل + "]"
    show("short status line"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند پاسخ("HTTP/1.1 20\r\n\r\n"))
    show("non numeric status"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند پاسخ("HTTP/1.1 2x0 OK\r\n\r\n"))
    show("bad response version"، پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند پاسخ("ICY 200 OK\r\n\r\n"))

    urls := ["http://example.com"، "http://example.com/"، "HTTP://Example.COM:81/p?q=1#frag"، "http://u:p@host:8080/x"، "http://[::1]:8080/x"، "http://[2001:db8::1]/"، "https://secure.example/a"، "http://example.com?x=1"، "ftp://example.com/"، "example.com/path"، "http://"، "http://host:0/"، "http://host:99999/"، "http://host:abc/"، "http://a b/"، "/relative"]
    هر u در urls:
        x := پراکسی اچ‌تی‌تی‌پی.تجزیه نشانی وب(u)
        اگر x.معتبر:
            سرچاپ u + " -> " + x.طرح + " " + x.میزبان + " " + x.درگاه + " " + x.مسیر
        وگرنه:
            سرچاپ u + " -> invalid"
        پایان
    پایان

    hosts := ["example.com:443"، "example.com"، "[::1]:8443"، "[::1]"، "::1"، "a:b:c"، ":80"، "host:"، "host:0"، "host:65536"، "host:65535"، "ho st:1"، "host/x:1"، "user@host:1"، ""]
    هر t در hosts:
        x := پراکسی اچ‌تی‌تی‌پی.جداسازی میزبان درگاه(t، 80)
        اگر x.معتبر:
            سرچاپ "[" + t + "] -> " + x.میزبان + " " + x.درگاه + " explicit=" + x.درگاه دارد
        وگرنه:
            سرچاپ "[" + t + "] -> invalid"
        پایان
    پایان

    سرچاپ پراکسی اچ‌تی‌تی‌پی.سرآیند بیسیک("user"، "pass")
    ناپایا u := ""
    ناپایا pw := ""
    سرچاپ پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک("Basic dXNlcjpwYXNz"، u، pw)، u، pw
    سرچاپ پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک("basic dXNlcjo="، u، pw)، u + "|" + pw + "|"
    سرچاپ پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک("Basic dTpwOndpdGg6Y29sb24="، u، pw)، u، pw
    سرچاپ پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک("Bearer abc"، u، pw)، پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک("Basic"، u، pw)، پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک("Basic !!!"، u، pw)، پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک("Basic bm9jb2xvbg=="، u، pw)

    hop := ["Connection"، "keep-alive"، "Proxy-Authenticate"، "PROXY-AUTHORIZATION"، "TE"، "Trailer"، "Transfer-Encoding"، "Upgrade"، "Proxy-Connection"، "Host"، "Content-Length"، "Accept"، "Cookie"]
    هر n در hop:
        سرچاپ n + " hop=" + پراکسی اچ‌تی‌تی‌پی.از نوع گام‌به‌گام(n)
    پایان

    سرچاپ رشته.جایگزینی(پراکسی اچ‌تی‌تی‌پی.متن پاسخ(407، "Proxy-Authenticate: Basic realm=\"r\"\r\n"، ""، نادرست)، "\r\n"، "|")
    سرچاپ رشته.جایگزینی(پراکسی اچ‌تی‌تی‌پی.متن پاسخ(502، ""، "bad\n"، درست)، "\r\n"، "|")
    سرچاپ پراکسی اچ‌تی‌تی‌پی.دلیل وضعیت(403) + "|" + پراکسی اچ‌تی‌تی‌پی.دلیل وضعیت(502) + "|" + پراکسی اچ‌تی‌تی‌پی.دلیل وضعیت(999)
پایان
