واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

تابع origin_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    d := تی سی پی.خواندن(c، 4096)
    اگر d.طول() بزرگتر 0:
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: 6\r\nConnection: close\r\n\r\norigin")
    پایان
    تی سی پی.بستن(c)
پایان

تابع origin_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(origin_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع show(label: رشته، r: پراکسی اچ‌تی‌تی‌پی.پاسخ):
    سرچاپ label + ": ok=" + r.موفق + " status=" + r.وضعیت + " body=[" + r.بدنه + "]"
پایان

تابع connect_status(label: رشته، cl: پراکسی اچ‌تی‌تی‌پی.کلاینت، host: رشته، port: صحیح):
    r := پراکسی اچ‌تی‌تی‌پی.اتصال(cl، host، port)
    سرچاپ label + ": " + r.وضعیت
    اگر r.موفق:
        r.جریان.بستن()
    پایان
پایان

تابع ریشه:
    osock := تی سی پی.پیوند(0)
    oport := تی سی پی.درگاه(osock)
    ساکس.برو(origin_accept، osock.توصیفگر برگردان تهی*)
    ob := "http://127.0.0.1:" + oport + "/"

    dsv := پراکسی اچ‌تی‌تی‌پی.شروع(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0))
    dcl := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، dsv.درگاه)
    show("default, plain request to loopback"، پراکسی اچ‌تی‌تی‌پی.دریافت(dcl، ob))
    show("default, plain request to a loopback name"، پراکسی اچ‌تی‌تی‌پی.دریافت(dcl، "http://localhost:" + oport + "/"))
    show("default, plain request to the metadata address"، پراکسی اچ‌تی‌تی‌پی.دریافت(dcl، "http://169.254.169.254/latest/meta-data/"))
    show("default, plain request to a private address"، پراکسی اچ‌تی‌تی‌پی.دریافت(dcl، "http://192.168.0.1/"))
    connect_status("default, connect to loopback"، dcl، "127.0.0.1"، oport)
    connect_status("default, connect to a private address"، dcl، "10.0.0.1"، 443)
    connect_status("default, connect to a mapped address"، dcl، "::ffff:a00:1"، 443)
    پراکسی اچ‌تی‌تی‌پی.توقف(dsv)

    ناپایا apcfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(apcfg، درست)
    asv := پراکسی اچ‌تی‌تی‌پی.شروع(apcfg)
    acl_c := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، asv.درگاه)
    show("allow_private on loopback, plain request"، پراکسی اچ‌تی‌تی‌پی.دریافت(acl_c، ob))
    connect_status("allow_private on loopback, connect"، acl_c، "127.0.0.1"، oport)
    پراکسی اچ‌تی‌تی‌پی.توقف(asv)

    ناپایا widecfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    widecfg.میزبان پیوند = "0.0.0.0"
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(widecfg، درست)
    wsv := پراکسی اچ‌تی‌تی‌پی.شروع(widecfg)
    wcl := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، wsv.درگاه)
    show("allow_private on a public bind is ignored"، پراکسی اچ‌تی‌تی‌پی.دریافت(wcl، ob))
    پراکسی اچ‌تی‌تی‌پی.توقف(wsv)

    ناپایا aclcfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(aclcfg، درست)
    تونل.افزودن پسوند ممنوع(aclcfg.سیاست مقصد، "blocked.example")
    تونل.افزودن بازه ممنوع(aclcfg.سیاست مقصد، "10.0.0.0/8")
    ssv := پراکسی اچ‌تی‌تی‌پی.شروع(aclcfg)
    scl := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، ssv.درگاه)
    show("deny domain suffix"، پراکسی اچ‌تی‌تی‌پی.دریافت(scl، "http://www.blocked.example/"))
    connect_status("deny cidr"، scl، "10.1.2.3"، 443)
    show("everything else on loopback still works"، پراکسی اچ‌تی‌تی‌پی.دریافت(scl، ob))
    پراکسی اچ‌تی‌تی‌پی.توقف(ssv)
پایان
