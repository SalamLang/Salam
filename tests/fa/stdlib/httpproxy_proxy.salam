واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی همگام سازی

ناپایا origin_conns := 0

تابع send_text(c: تی سی پی.اتصال شبکه، text: رشته):
    تی سی پی.نوشتن(c، text)
پایان

تابع fill(c: تی سی پی.اتصال شبکه، buf &: رشته، marker: رشته): منطقی:
    تا buf.بیاب(marker) کوچکتر 0:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: برگشت نادرست پایان
        buf += d
    پایان
    برگشت درست
پایان

تابع need(c: تی سی پی.اتصال شبکه، buf &: رشته، n: صحیح): منطقی:
    تا buf.طول() کوچکتر n:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: برگشت نادرست پایان
        buf += d
    پایان
    برگشت درست
پایان

تابع respond(c: تی سی پی.اتصال شبکه، status: رشته، extra: رشته، body: رشته):
    send_text(c، "HTTP/1.1 " + status + "\r\n" + extra + "Content-Length: " + body.طول() + "\r\n\r\n" + body)
پایان

تابع origin_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    ناپایا buf := ""
    تا درست:
        اگر وارونه fill(c، buf، "\r\n\r\n"): بشکن پایان
        idx := buf.بیاب("\r\n\r\n")
        head := buf.زیررشته(0، idx + 4)
        buf = buf.زیررشته(idx + 4، buf.طول() - idx - 4)
        h := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست(head)
        ناپایا body := ""
        cl := پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(h، "content-length")
        اگر cl.طول() بزرگتر 0:
            n := cl.به صحیح()
            اگر وارونه need(c، buf، n): بشکن پایان
            body = buf.زیررشته(0، n)
            buf = buf.زیررشته(n، buf.طول() - n)
        وگرنه پراکسی اچ‌تی‌تی‌پی.سرآیند توکن دارد(h، "transfer-encoding"، "chunked"):
            تا درست:
                اگر وارونه fill(c، buf، "\r\n"): بشکن پایان
                nl := buf.بیاب("\r\n")
                size := buf.زیررشته(0، nl).به صحیح()
                buf = buf.زیررشته(nl + 2، buf.طول() - nl - 2)
                اگر size برابر 0:
                    اگر وارونه need(c، buf، 2): بشکن پایان
                    buf = buf.زیررشته(2، buf.طول() - 2)
                    بشکن
                پایان
                اگر وارونه need(c، buf، size + 2): بشکن پایان
                body += buf.زیررشته(0، size)
                buf = buf.زیررشته(size + 2، buf.طول() - size - 2)
            پایان
        پایان
        path := h.هدف
        اگر path برابر "/hello":
            respond(c، "200 OK"، "Content-Type: text/plain\r\n"، "hello")
        وگرنه path برابر "/echo":
            respond(c، "200 OK"، ""، "echo:" + body + " via " + h.روش)
        وگرنه path برابر "/chunked":
            send_text(c، "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\nwiki\r\n5\r\npedia\r\n0\r\n\r\n")
        وگرنه path برابر "/close":
            send_text(c، "HTTP/1.1 200 OK\r\nConnection: close\r\n\r\nuntil close body")
            بشکن
        وگرنه path برابر "/headers":
            ناپایا seen := ""
            تکرار h.نام‌ها.طول() در i:
                seen += h.نام‌ها.بگیر(i).کوچک() + ","
            پایان
            respond(c، "200 OK"، "Connection: keep-alive\r\nKeep-Alive: timeout=5\r\nX-Origin: yes\r\n"، "host=" + پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(h، "host") + " names=" + seen)
        وگرنه path برابر "/head":
            send_text(c، "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\n")
        وگرنه path برابر "/missing":
            respond(c، "404 Not Found"، ""، "nope")
        وگرنه path برابر "/nocontent":
            send_text(c، "HTTP/1.1 204 No Content\r\n\r\n")
        وگرنه path برابر "/continue":
            respond(c، "200 OK"، ""، "got " + body)
        وگرنه path برابر "/upgrade":
            send_text(c، "HTTP/1.1 101 Switching Protocols\r\nUpgrade: test\r\nConnection: Upgrade\r\n\r\n")
            تا درست:
                d := تی سی پی.خواندن(c، 1024)
                اگر d.طول() برابر 0: بشکن پایان
                تی سی پی.نوشتن(c، "up:" + d)
            پایان
            بشکن
        وگرنه path برابر "/garbage":
            send_text(c، "this is not http\r\n\r\n")
            بشکن
        وگرنه path برابر "/truncate":
            send_text(c، "HTTP/1.1 200 OK\r\nContent-Length: 100\r\n\r\nshort")
            بشکن
        وگرنه:
            respond(c، "200 OK"، ""، "path " + path)
        پایان
        اگر پراکسی اچ‌تی‌تی‌پی.سرآیند توکن دارد(h، "connection"، "close"): بشکن پایان
    پایان
    تی سی پی.بستن(c)
پایان

تابع origin_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        origin_conns++
        ساکس.برو(origin_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        تی سی پی.نوشتن(c، d)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع raw(port: صحیح، request: رشته، wait_ms: صحیح): رشته:
    c := تی سی پی.شماره گیری("127.0.0.1"، port)
    تی سی پی.تنظیم مهلت خواندن(c، wait_ms)
    تی سی پی.نوشتن(c، request)
    ناپایا out := ""
    تا درست:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        out += d
    پایان
    تی سی پی.بستن(c)
    برگشت out
پایان

تابع status_of(text: رشته): رشته:
    nl := text.بیاب("\r\n")
    اگر nl کوچکتر 0: برگشت "(none)" پایان
    برگشت text.زیررشته(0، nl)
پایان

تابع show(label: رشته، r: پراکسی اچ‌تی‌تی‌پی.پاسخ):
    سرچاپ label + ": ok=" + r.موفق + " status=" + r.وضعیت + " len=" + r.طول بدنه + " body=[" + r.بدنه + "] " + r.خطا
پایان

تابع ریشه:
    os := تی سی پی.پیوند(0)
    oport := تی سی پی.درگاه(os)
    ساکس.برو(origin_accept، os.توصیفگر برگردان تهی*)
    es := تی سی پی.پیوند(0)
    eport := تی سی پی.درگاه(es)
    ساکس.برو(echo_accept، es.توصیفگر برگردان تهی*)
    ob := "http://127.0.0.1:" + oport

    ناپایا cfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    cfg.مهلت دست‌دهی میلی‌ثانیه = 800
    cfg.مهلت بی‌کاری میلی‌ثانیه = 3000
    sv := پراکسی اچ‌تی‌تی‌پی.شروع(cfg)
    سرچاپ "proxy up: " + sv.موفق
    cl := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، sv.درگاه)

    show("get hello"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/hello"))
    show("get chunked"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/chunked"))
    show("get until close"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/close"))
    show("get 404"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/missing"))
    show("get 204"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/nocontent"))
    show("get other path"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/a/b?c=d"))
    show("post echo"، پراکسی اچ‌تی‌تی‌پی.ارسال(cl، ob + "/echo"، "text/plain"، "payload"))
    show("head"، پراکسی اچ‌تی‌تی‌پی.درخواست(cl، "HEAD"، ob + "/head"، ""، ""))
    show("garbage upstream"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/garbage"))
    show("truncated upstream"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/truncate"))
    show("localhost name"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، "http://localhost:" + oport + "/hello"))
    show("https url refused"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، "https://localhost/"))
    free := تی سی پی.درگاه آزاد()
    show("upstream refused"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، "http://127.0.0.1:" + free + "/"))

    hr := پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/headers")
    سرچاپ "x-origin kept: " + پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(hr.سرآیند، "x-origin") + " keep-alive stripped: [" + پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(hr.سرآیند، "keep-alive") + "]"
    hr2 := پراکسی اچ‌تی‌تی‌پی.درخواست(cl، "GET"، ob + "/headers"، "Connection: keep-alive, X-Drop\r\nX-Drop: 1\r\nKeep-Alive: 5\r\nTE: trailers\r\nProxy-Connection: keep-alive\r\nX-Keep: 1\r\nAccept: */*\r\n"، "")
    سرچاپ رشته.جایگزینی(hr2.بدنه، ":" + oport، ":PORT")

    f1 := raw(sv.درگاه، "GET " + ob + "/hello HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"، 1500)
    سرچاپ status_of(f1) + " | closes=" + f1.دربردارد("Connection: close") + " | body=" + f1.زیررشته(f1.بیاب("\r\n\r\n") + 4، 5)

    before := origin_conns
    ka := تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    تی سی پی.تنظیم مهلت خواندن(ka، 1500)
    ناپایا got := ""
    تکرار 3:
        تی سی پی.نوشتن(ka، "GET " + ob + "/hello HTTP/1.1\r\nHost: x\r\n\r\n")
        ناپایا one := ""
        تا وارونه (one.دربردارد("\r\n\r\n") و one.ختم با("hello")):
            d := تی سی پی.خواندن(ka، 4096)
            اگر d.طول() برابر 0: بشکن پایان
            one += d
        پایان
        got += status_of(one) + ";"
    پایان
    تی سی پی.بستن(ka)
    سرچاپ "keep-alive: " + got + " new origin connections: " + (origin_conns - before)

    pipe := raw(sv.درگاه، "GET " + ob + "/hello HTTP/1.1\r\nHost: x\r\n\r\nGET " + ob + "/missing HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"، 1500)
    سرچاپ "pipelined: " + pipe.بیاب("200 OK") + " " + (pipe.بیاب("404 Not Found") بزرگتر pipe.بیاب("200 OK")) + " hello=" + pipe.دربردارد("hello") + " nope=" + pipe.دربردارد("nope")

    ch := raw(sv.درگاه، "POST " + ob + "/echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n"، 1500)
    سرچاپ "chunked request: " + status_of(ch) + " " + ch.دربردارد("echo:hello world via POST")

    ex := تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    تی سی پی.تنظیم مهلت خواندن(ex، 1500)
    تی سی پی.نوشتن(ex، "POST " + ob + "/continue HTTP/1.1\r\nHost: x\r\nExpect: 100-continue\r\nContent-Length: 4\r\nConnection: close\r\n\r\n")
    سرچاپ "expect: " + رشته.جایگزینی(تی سی پی.خواندن(ex، 100)، "\r\n"، "|")
    تی سی پی.نوشتن(ex، "data")
    ناپایا exr := ""
    تا درست:
        d := تی سی پی.خواندن(ex، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        exr += d
    پایان
    سرچاپ status_of(exr) + " " + exr.دربردارد("got data")
    تی سی پی.بستن(ex)

    up := تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    تی سی پی.تنظیم مهلت خواندن(up، 1500)
    تی سی پی.نوشتن(up، "GET " + ob + "/upgrade HTTP/1.1\r\nHost: x\r\nConnection: Upgrade\r\nUpgrade: test\r\n\r\n")
    uh := تی سی پی.خواندن(up، 4096)
    سرچاپ "upgrade: " + status_of(uh) + " " + uh.دربردارد("Upgrade: test")
    تی سی پی.نوشتن(up، "ping")
    سرچاپ تی سی پی.خواندن(up، 100)
    تی سی پی.بستن(up)

    cr := پراکسی اچ‌تی‌تی‌پی.اتصال(cl، "127.0.0.1"، eport)
    سرچاپ "connect echo: ok=" + cr.موفق + " status=" + cr.وضعیت
    cr.جریان.نوشتن("tunnelled bytes")
    سرچاپ cr.جریان.خواندن(100)
    cr.جریان.بستن()
    cr2 := پراکسی اچ‌تی‌تی‌پی.اتصال(cl، "localhost"، eport)
    cr2.جریان.نوشتن("by name")
    سرچاپ cr2.موفق، cr2.جریان.خواندن(100)
    cr2.جریان.بستن()
    dc := پراکسی اچ‌تی‌تی‌پی.شماره‌گیری اتصال(cl، "127.0.0.1"، eport)
    تی سی پی.نوشتن(dc، "dialconn")
    سرچاپ تی سی پی.خواندن(dc، 100)
    تی سی پی.بستن(dc)
    bad := پراکسی اچ‌تی‌تی‌پی.اتصال(cl، "127.0.0.1"، free)
    سرچاپ "connect refused: ok=" + bad.موفق + " status=" + bad.وضعیت + " " + bad.خطا

    cx := تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    تی سی پی.تنظیم مهلت خواندن(cx، 1500)
    تی سی پی.نوشتن(cx، "CONNECT 127.0.0.1:" + eport + " HTTP/1.1\r\nHost: x\r\n\r\nearly bytes")
    ناپایا cxr := ""
    تا وارونه cxr.دربردارد("early bytes"):
        d := تی سی پی.خواندن(cx، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        cxr += d
    پایان
    سرچاپ "connect with early data: " + status_of(cxr) + " " + cxr.دربردارد("early bytes")
    تی سی پی.بستن(cx)

    سرچاپ "garbage: " + status_of(raw(sv.درگاه، "GARBAGE\r\n\r\n"، 1500))
    سرچاپ "bad version: " + status_of(raw(sv.درگاه، "GET http://x/ HTTP/3.0\r\n\r\n"، 1500))
    سرچاپ "relative uri: " + status_of(raw(sv.درگاه، "GET /hello HTTP/1.1\r\nHost: x\r\n\r\n"، 1500))
    سرچاپ "ftp uri: " + status_of(raw(sv.درگاه، "GET ftp://x/ HTTP/1.1\r\nHost: x\r\n\r\n"، 1500))
    سرچاپ "connect no port: " + status_of(raw(sv.درگاه، "CONNECT example.com HTTP/1.1\r\n\r\n"، 1500))
    سرچاپ "connect bad port: " + status_of(raw(sv.درگاه، "CONNECT example.com:99999 HTTP/1.1\r\n\r\n"، 1500))
    سرچاپ "cl and te: " + status_of(raw(sv.درگاه، "POST " + ob + "/echo HTTP/1.1\r\nHost: x\r\nContent-Length: 4\r\nTransfer-Encoding: chunked\r\n\r\n"، 1500))
    سرچاپ "two different cl: " + status_of(raw(sv.درگاه، "POST " + ob + "/echo HTTP/1.1\r\nHost: x\r\nContent-Length: 4\r\nContent-Length: 5\r\n\r\n"، 1500))
    سرچاپ "bad cl: " + status_of(raw(sv.درگاه، "POST " + ob + "/echo HTTP/1.1\r\nHost: x\r\nContent-Length: -1\r\n\r\n"، 1500))
    سرچاپ "gzip te: " + status_of(raw(sv.درگاه، "POST " + ob + "/echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: gzip\r\n\r\n"، 1500))
    سرچاپ "huge head: " + status_of(raw(sv.درگاه، "GET " + ob + "/ HTTP/1.1\r\nX-Big: " + "a".تکرار(70000) + "\r\n\r\n"، 1500))
    سرچاپ "head without end then close: " + raw(sv.درگاه، "GET " + ob + "/ HTTP/1.1\r\nHost"، 300).طول()
    سرچاپ "idle client closed: " + raw(sv.درگاه، ""، 2500).طول()
    سرچاپ "chunk garbage: " + status_of(raw(sv.درگاه، "POST " + ob + "/echo HTTP/1.1\r\nHost: x\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\nZZ\r\n"، 1500))

    show("still serving"، پراکسی اچ‌تی‌تی‌پی.دریافت(cl، ob + "/hello"))
    پراکسی اچ‌تی‌تی‌پی.توقف(sv)

    ناپایا acfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.افزودن کاربر(acfg، "alice"، "s3cret")
    asv := پراکسی اچ‌تی‌تی‌پی.شروع(acfg)
    na := raw(asv.درگاه، "GET " + ob + "/hello HTTP/1.1\r\nHost: x\r\nConnection: close\r\n\r\n"، 1500)
    سرچاپ "no auth: " + status_of(na) + " challenge=" + na.دربردارد("Proxy-Authenticate: Basic realm=\"Salam proxy\"")
    wa := raw(asv.درگاه، "GET " + ob + "/hello HTTP/1.1\r\nHost: x\r\nProxy-Authorization: " + پراکسی اچ‌تی‌تی‌پی.سرآیند بیسیک("alice"، "wrong") + "\r\nConnection: close\r\n\r\n"، 1500)
    سرچاپ "wrong password: " + status_of(wa)
    ua := raw(asv.درگاه، "GET " + ob + "/hello HTTP/1.1\r\nHost: x\r\nProxy-Authorization: " + پراکسی اچ‌تی‌تی‌پی.سرآیند بیسیک("eve"، "s3cret") + "\r\nConnection: close\r\n\r\n"، 1500)
    سرچاپ "wrong user: " + status_of(ua)
    ba := raw(asv.درگاه، "GET " + ob + "/hello HTTP/1.1\r\nHost: x\r\nProxy-Authorization: Basic !!!\r\nConnection: close\r\n\r\n"، 1500)
    سرچاپ "bad credentials syntax: " + status_of(ba)
    show("auth good get"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، asv.درگاه، "alice"، "s3cret")، ob + "/hello"))
    show("auth missing get"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، asv.درگاه)، ob + "/hello"))
    gc := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، asv.درگاه، "alice"، "s3cret")، "127.0.0.1"، eport)
    سرچاپ "auth good connect: " + gc.موفق + " " + gc.وضعیت
    gc.جریان.بستن()
    mc := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، asv.درگاه)، "127.0.0.1"، eport)
    سرچاپ "auth missing connect: " + mc.موفق + " " + mc.وضعیت + " " + mc.خطا
    retry := تی سی پی.شماره گیری("127.0.0.1"، asv.درگاه)
    تی سی پی.تنظیم مهلت خواندن(retry، 1500)
    تی سی پی.نوشتن(retry، "GET " + ob + "/hello HTTP/1.1\r\nHost: x\r\n\r\n")
    r1 := تی سی پی.خواندن(retry، 4096)
    تی سی پی.نوشتن(retry، "GET " + ob + "/hello HTTP/1.1\r\nHost: x\r\nProxy-Authorization: " + پراکسی اچ‌تی‌تی‌پی.سرآیند بیسیک("alice"، "s3cret") + "\r\n\r\n")
    r2 := تی سی پی.خواندن(retry، 4096)
    سرچاپ "challenge then retry on one connection: " + status_of(r1) + " / " + status_of(r2)
    تی سی پی.بستن(retry)
    پراکسی اچ‌تی‌تی‌پی.توقف(asv)

    ناپایا ccfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.تعیین احراز هویت(ccfg، (u: رشته، p: رشته): برگشت u برابر "bob" و p برابر "pw" پایان)
    csv := پراکسی اچ‌تی‌تی‌پی.شروع(ccfg)
    show("callback auth"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، csv.درگاه، "bob"، "pw")، ob + "/hello"))
    show("callback auth bad"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، csv.درگاه، "bob"، "no")، ob + "/hello"))
    پراکسی اچ‌تی‌تی‌پی.توقف(csv)

    ناپایا pcfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    pcfg.اجازه = (m: رشته، h: رشته، p: صحیح): برگشت وارونه (h برابر "blocked.example" یا p برابر 25 یا (m برابر "DELETE")) پایان
    psv := پراکسی اچ‌تی‌تی‌پی.شروع(pcfg)
    pc := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، psv.درگاه)
    show("acl allows"، پراکسی اچ‌تی‌تی‌پی.دریافت(pc، ob + "/hello"))
    show("acl blocks host"، پراکسی اچ‌تی‌تی‌پی.دریافت(pc، "http://blocked.example/x"))
    show("acl blocks port"، پراکسی اچ‌تی‌تی‌پی.دریافت(pc، "http://127.0.0.1:25/"))
    show("acl blocks method"، پراکسی اچ‌تی‌تی‌پی.درخواست(pc، "DELETE"، ob + "/hello"، ""، ""))
    سرچاپ "acl blocks connect: " + پراکسی اچ‌تی‌تی‌پی.اتصال(pc، "blocked.example"، 443).وضعیت
    سرچاپ "acl allows connect: " + پراکسی اچ‌تی‌تی‌پی.اتصال(pc، "127.0.0.1"، eport).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(psv)

    ناپایا ocfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    ocfg.اجازه کانکت = نادرست
    osv := پراکسی اچ‌تی‌تی‌پی.شروع(ocfg)
    سرچاپ "connect disabled: " + پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، osv.درگاه)، "127.0.0.1"، eport).وضعیت
    show("plain still on"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، osv.درگاه)، ob + "/hello"))
    پراکسی اچ‌تی‌تی‌پی.توقف(osv)

    ناپایا dcfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    dcfg.اجازه درخواست ساده = نادرست
    dsv := پراکسی اچ‌تی‌تی‌پی.شروع(dcfg)
    show("plain disabled"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، dsv.درگاه)، ob + "/hello"))
    سرچاپ "connect still on: " + پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، dsv.درگاه)، "127.0.0.1"، eport).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(dsv)

    ناپایا rcfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.تعیین اتصال به مقصد(
        rcfg، (h: رشته، _p: صحیح): اگر h برابر "origin.internal": برگشت ساکس.اتصال مستقیم("127.0.0.1"، oport، 2000) پایان برگشت ساکس.خروجی { موفق = نادرست، کد = ساکس.کد شبکه در دسترس نیست، خطا = "no route" } پایان
    )
    rsv := پراکسی اچ‌تی‌تی‌پی.شروع(rcfg)
    rc := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، rsv.درگاه)
    show("routed by callback"، پراکسی اچ‌تی‌تی‌پی.دریافت(rc، "http://origin.internal/hello"))
    show("callback refuses"، پراکسی اچ‌تی‌تی‌پی.دریافت(rc، "http://elsewhere.internal/hello"))
    سرچاپ "callback refuses connect: " + پراکسی اچ‌تی‌تی‌پی.اتصال(rc، "elsewhere.internal"، 443).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(rsv)

    سرچاپ "stopped: " + تی سی پی.اتصال معتبر(تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه))
    همگام سازی.خواب میلی ثانیه(10)
پایان
