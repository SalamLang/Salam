واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تونل

تابع ریشه:
    p1 := تونل.لوله جدید()
    a1 := تونل.سر اول لوله(p1)
    b1 := تونل.سر دوم لوله(p1)
    a1.نوشتن("CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\n\r\n")
    ناپایا inb := پراکسی اچ‌تی‌تی‌پی.ورودی جدید(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0))
    sess := inb.دست‌دهی(b1)
    سرچاپ sess.موفق، sess.مقصد.میزبان، sess.مقصد.درگاه
    inb.پاسخ(b1، sess، درست)
    سرچاپ a1.خواندن(64).شروع با("HTTP/1.1 200")

    p2 := تونل.لوله جدید()
    a2 := تونل.سر اول لوله(p2)
    b2 := تونل.سر دوم لوله(p2)
    b2.نوشتن("HTTP/1.1 200 Connection established\r\n\r\n")
    ناپایا conn := پراکسی اچ‌تی‌تی‌پی.رابط جدید(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("10.0.0.1"، 3128))
    سرچاپ conn.کارساز().میزبان، conn.کارساز().درگاه
    سرچاپ conn.دست‌دهی(a2، تونل.نشانی جدید("example.org"، 443))
    سرچاپ b2.خواندن(200).شروع با("CONNECT example.org:443")

    p3 := تونل.لوله جدید()
    a3 := تونل.سر اول لوله(p3)
    b3 := تونل.سر دوم لوله(p3)
    b3.نوشتن("HTTP/1.1 403 Forbidden\r\n\r\n")
    r := پراکسی اچ‌تی‌تی‌پی.دست‌دهی کلاینت(a3، پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("10.0.0.1"، 3128)، "example.org"، 443)
    سرچاپ r.موفق

    p4 := تونل.لوله جدید()
    a4 := تونل.سر اول لوله(p4)
    b4 := تونل.سر دوم لوله(p4)
    a4.نوشتن("NONSENSE\r\n\r\n")
    پراکسی اچ‌تی‌تی‌پی.رسیدگی(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)، b4)
    سرچاپ a4.خواندن(64).شروع با("HTTP/1.1 400")

    ناپایا bad := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    bad.میزبان پیوند = "203.0.113.1"
    سرچاپ پراکسی اچ‌تی‌تی‌پی.خدمت‌رسانی(bad)
پایان
