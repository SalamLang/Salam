واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        تی سی پی.نوشتن(c، d)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع origin_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    d := تی سی پی.خواندن(c، 4096)
    اگر d.طول() بزرگتر 0:
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: 11\r\nConnection: close\r\n\r\nhello https")
    پایان
    تی سی پی.بستن(c)
پایان

تابع origin_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(origin_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع ریشه:
    es := تی سی پی.پیوند(0)
    eport := تی سی پی.درگاه(es)
    ساکس.برو(echo_accept، es.توصیفگر برگردان تهی*)
    os := تی سی پی.پیوند(0)
    oport := تی سی پی.درگاه(os)
    ساکس.برو(origin_accept، os.توصیفگر برگردان تهی*)

    ناپایا missing := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    سرچاپ "bad cert path: " + پراکسی اچ‌تی‌تی‌پی.تعیین تی ال اس(missing، "tests/fixtures/ssl/none.crt"، "tests/fixtures/ssl/none.key")
    سرچاپ "start refused without tls: " + پراکسی اچ‌تی‌تی‌پی.شروع(missing).موفق

    ناپایا cfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    سرچاپ "tls configured: " + پراکسی اچ‌تی‌تی‌پی.تعیین تی ال اس(cfg، "tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    پراکسی اچ‌تی‌تی‌پی.افزودن کاربر(cfg، "alice"، "s3cret")
    sv := پراکسی اچ‌تی‌تی‌پی.شروع(cfg)
    سرچاپ "https proxy up: " + sv.موفق

    ناپایا cl := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، sv.درگاه، "alice"، "s3cret")
    cl.امن = درست
    cl.بدون اعتبارسنجی = درست
    cl.نام سرور = "localhost"
    r := پراکسی اچ‌تی‌تی‌پی.اتصال(cl، "127.0.0.1"، eport)
    سرچاپ "connect over tls: ok=" + r.موفق + " status=" + r.وضعیت
    r.جریان.نوشتن("secret tunnel")
    سرچاپ r.جریان.خواندن(100)
    r.جریان.نوشتن("second write")
    سرچاپ r.جریان.خواندن(100)
    r.جریان.بستن()

    g := پراکسی اچ‌تی‌تی‌پی.دریافت(cl، "http://127.0.0.1:" + oport + "/")
    سرچاپ "plain http via https proxy: ok=" + g.موفق + " status=" + g.وضعیت + " body=" + g.بدنه

    ناپایا bad := cl
    bad.گذرواژه = "wrong"
    b := پراکسی اچ‌تی‌تی‌پی.اتصال(bad، "127.0.0.1"، eport)
    سرچاپ "wrong password over tls: ok=" + b.موفق + " status=" + b.وضعیت

    ناپایا strict := cl
    strict.بدون اعتبارسنجی = نادرست
    s := پراکسی اچ‌تی‌تی‌پی.اتصال(strict، "127.0.0.1"، eport)
    سرچاپ "self signed rejected: ok=" + s.موفق

    plain := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، sv.درگاه، "alice"، "s3cret")
    p := پراکسی اچ‌تی‌تی‌پی.اتصال(plain، "127.0.0.1"، eport)
    سرچاپ "plain client against tls proxy: ok=" + p.موفق

    again := پراکسی اچ‌تی‌تی‌پی.اتصال(cl، "127.0.0.1"، eport)
    سرچاپ "still serving: " + again.موفق
    again.جریان.بستن()
    پراکسی اچ‌تی‌تی‌پی.توقف(sv)
پایان
