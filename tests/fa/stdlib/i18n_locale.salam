بسته ریشه

واردسازی بین‌المللی‌سازی
واردسازی سیستم عامل
واردسازی ورودی خروجی
واردسازی محیط
واردسازی سیستم پرونده.مسیر

تابع ریشه:
    ناپایا فهرست ترجمه := بین‌المللی‌سازی.جدید("en")
    بین‌المللی‌سازی.تنظیم(فهرست ترجمه، "en"، "hello"، "Hello")
    سرچاپ بین‌المللی‌سازی.دریافت خام(فهرست ترجمه، "en"، "hello")
    سرچاپ بین‌المللی‌سازی.دریافت خام(فهرست ترجمه، "fa"، "hello").طول()
    سرچاپ بین‌المللی‌سازی.دریافت خام(فهرست ترجمه، "en"، "missing").طول()

    مسیر پرونده زبان := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_i18n_locale_test.env")
    ورودی خروجی.نوشتن پرونده(مسیر پرونده زبان، "bye=Goodbye\nthanks=Thank you\n")
    سرچاپ بین‌المللی‌سازی.بارگذاری زبان(فهرست ترجمه، "en"، مسیر پرونده زبان)
    سیستم عامل.حذف(مسیر پرونده زبان)
    سرچاپ بین‌المللی‌سازی.دریافت خام(فهرست ترجمه، "en"، "bye")
    سرچاپ بین‌المللی‌سازی.ترجمه(فهرست ترجمه، "en"، "thanks")
    سرچاپ بین‌المللی‌سازی.دارد(فهرست ترجمه، "en"، "bye")

    محیط.تنظیم("SALAM_LOCALE"، "fa_IR.UTF-8")
    سرچاپ بین‌المللی‌سازی.تشخیص زبان()
    محیط.تنظیم("SALAM_LOCALE"، "pt-BR")
    سرچاپ بین‌المللی‌سازی.تشخیص زبان()
    محیط.تنظیم("SALAM_LOCALE"، "DE")
    سرچاپ بین‌المللی‌سازی.تشخیص زبان()
    بین‌المللی‌سازی.آزادسازی(فهرست ترجمه)
پایان
