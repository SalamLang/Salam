بسته ریشه

واردسازی بین‌المللی‌سازی
واردسازی سیستم عامل
واردسازی ورودی خروجی
واردسازی محیط
واردسازی سیستم پرونده.مسیر

تابع ریشه:
    ناپایا cat := بین‌المللی‌سازی.جدید("en")
    بین‌المللی‌سازی.تنظیم(cat، "en"، "hello"، "Hello")
    سرچاپ بین‌المللی‌سازی.دریافت خام(cat، "en"، "hello")
    سرچاپ بین‌المللی‌سازی.دریافت خام(cat، "fa"، "hello").طول()
    سرچاپ بین‌المللی‌سازی.دریافت خام(cat، "en"، "missing").طول()

    file := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_i18n_locale_test.env")
    ورودی خروجی.نوشتن پرونده(file، "bye=Goodbye\nthanks=Thank you\n")
    سرچاپ بین‌المللی‌سازی.بارگذاری زبان(cat، "en"، file)
    سیستم عامل.حذف(file)
    سرچاپ بین‌المللی‌سازی.دریافت خام(cat، "en"، "bye")
    سرچاپ بین‌المللی‌سازی.ترجمه(cat، "en"، "thanks")
    سرچاپ بین‌المللی‌سازی.دارد(cat، "en"، "bye")

    محیط.تنظیم("SALAM_LOCALE"، "fa_IR.UTF-8")
    سرچاپ بین‌المللی‌سازی.تشخیص زبان()
    محیط.تنظیم("SALAM_LOCALE"، "pt-BR")
    سرچاپ بین‌المللی‌سازی.تشخیص زبان()
    محیط.تنظیم("SALAM_LOCALE"، "DE")
    سرچاپ بین‌المللی‌سازی.تشخیص زبان()
    بین‌المللی‌سازی.آزادسازی(cat)
پایان
