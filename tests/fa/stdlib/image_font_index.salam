    ناپایا مختصات افقی := وکتور {} برگردان وکتور<صحیح>
    ناپایا مختصات عمودی := وکتور {} برگردان وکتور<صحیح>
    ناپایا انتهای کانتورها := وکتور {} برگردان وکتور<صحیح>
    افزودن نقطه(مختصات افقی، مختصات عمودی، 100، 0)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 900، 0)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 900، 800)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 100، 800)
    انتهای کانتورها.بیفزا(3)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 300، 200)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 300، 600)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 700، 600)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 700، 200)
    انتهای کانتورها.بیفزا(7)
