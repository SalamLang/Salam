بسته ریشه

واردسازی تصویر
واردسازی فشرده سازی
واردسازی بایگانی
واردسازی آزمایش
واردسازی سیستم عامل
واردسازی مسیر پرونده

پایا UPEM := 1000
پایا NUM_GLYPHS := 4
پایا TTF_NUM_TABLES := 7

تابع be16(b &: فشرده سازی.بافر بایت، v: صحیح):
    فشرده سازی.افزودن بایت(b، (v >> 8) & 255)
    فشرده سازی.افزودن بایت(b، v & 255)
پایان

تابع be32(b &: فشرده سازی.بافر بایت، v: صحیح):
    be16(b، (v >> 16) & 0xFFFF)
    be16(b، v & 0xFFFF)
پایان

تابع pad4(n: صحیح): صحیح:
    برگشت ((n + 3) / 4) * 4
پایان

تابع pad_to4(b &: فشرده سازی.بافر بایت):
    تا (b.طول % 4) نابرابر 0:
        فشرده سازی.افزودن بایت(b، 0)
    پایان
پایان

تابع build_glyph(xs &: وکتور<صحیح>، ys &: وکتور<صحیح>، ends &: وکتور<صحیح>): فشرده سازی.بافر بایت:
    ناپایا g := فشرده سازی.بافر بایت جدید()
    n := xs.طول()
    ناپایا minx := xs.بگیر(0)
    ناپایا maxx := xs.بگیر(0)
    ناپایا miny := ys.بگیر(0)
    ناپایا maxy := ys.بگیر(0)
    ناپایا i := 1
    تا i کوچکتر n:
        اگر xs.بگیر(i) کوچکتر minx: minx = xs.بگیر(i) پایان
        اگر xs.بگیر(i) بزرگتر maxx: maxx = xs.بگیر(i) پایان
        اگر ys.بگیر(i) کوچکتر miny: miny = ys.بگیر(i) پایان
        اگر ys.بگیر(i) بزرگتر maxy: maxy = ys.بگیر(i) پایان
        i += 1
    پایان
    be16(g، ends.طول())
    be16(g، minx & 0xFFFF)
    be16(g، miny & 0xFFFF)
    be16(g، maxx & 0xFFFF)
    be16(g، maxy & 0xFFFF)
    ناپایا k := 0
    تا k کوچکتر ends.طول():
        be16(g، ends.بگیر(k))
        k += 1
    پایان
    be16(g، 0)
    ناپایا p := 0
    تا p کوچکتر n:
        فشرده سازی.افزودن بایت(g، 1)
        p += 1
    پایان
    ناپایا prev := 0
    ناپایا a := 0
    تا a کوچکتر n:
        be16(g، (xs.بگیر(a) - prev) & 0xFFFF)
        prev = xs.بگیر(a)
        a += 1
    پایان
    prev = 0
    ناپایا b := 0
    تا b کوچکتر n:
        be16(g، (ys.بگیر(b) - prev) & 0xFFFF)
        prev = ys.بگیر(b)
        b += 1
    پایان
    pad_to4(g)
    برگشت g
پایان

تابع push_pt(xs &: وکتور<صحیح>، ys &: وکتور<صحیح>، x: صحیح، y: صحیح):
    xs.بیفزا(x)
    ys.بیفزا(y)
پایان

تابع glyph_square(): فشرده سازی.بافر بایت:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    ناپایا ys := وکتور {} برگردان وکتور<صحیح>
    ناپایا ends := وکتور {} برگردان وکتور<صحیح>
    push_pt(xs، ys، 100، 0)
    push_pt(xs، ys، 700، 0)
    push_pt(xs، ys، 700، 700)
    push_pt(xs، ys، 100، 700)
    ends.بیفزا(3)
    out := build_glyph(xs، ys، ends)
    xs.آزادکن()
    ys.آزادکن()
    ends.آزادکن()
    برگشت out
پایان

تابع glyph_ring(): فشرده سازی.بافر بایت:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    ناپایا ys := وکتور {} برگردان وکتور<صحیح>
    ناپایا ends := وکتور {} برگردان وکتور<صحیح>
    push_pt(xs، ys، 100، 0)
    push_pt(xs، ys، 900، 0)
    push_pt(xs، ys، 900، 800)
    push_pt(xs، ys، 100، 800)
    ends.بیفزا(3)
    push_pt(xs، ys، 300، 200)
    push_pt(xs، ys، 300، 600)
    push_pt(xs، ys، 700، 600)
    push_pt(xs، ys، 700، 200)
    ends.بیفزا(7)
    out := build_glyph(xs، ys، ends)
    xs.آزادکن()
    ys.آزادکن()
    ends.آزادکن()
    برگشت out
پایان

تابع glyph_triangle(): فشرده سازی.بافر بایت:
    ناپایا xs := وکتور {} برگردان وکتور<صحیح>
    ناپایا ys := وکتور {} برگردان وکتور<صحیح>
    ناپایا ends := وکتور {} برگردان وکتور<صحیح>
    push_pt(xs، ys، 0، 0)
    push_pt(xs، ys، 800، 0)
    push_pt(xs، ys، 400، 800)
    ends.بیفزا(2)
    out := build_glyph(xs، ys، ends)
    xs.آزادکن()
    ys.آزادکن()
    ends.آزادکن()
    برگشت out
پایان

تابع build_head(): فشرده سازی.بافر بایت:
    ناپایا t := فشرده سازی.بافر بایت جدید()
    be32(t، 0x00010000)
    be32(t، 0x00010000)
    be32(t، 0)
    be32(t، 0x5F0F3CF5)
    be16(t، 0)
    be16(t، UPEM)
    be32(t، 0)
    be32(t، 0)
    be32(t، 0)
    be32(t، 0)
    be16(t، 0)
    be16(t، 0)
    be16(t، 900)
    be16(t، 800)
    be16(t، 0)
    be16(t، 8)
    be16(t، 2)
    be16(t، 0)
    be16(t، 0)
    برگشت t
پایان

تابع build_maxp(): فشرده سازی.بافر بایت:
    ناپایا t := فشرده سازی.بافر بایت جدید()
    be32(t، 0x00010000)
    be16(t، NUM_GLYPHS)
    ناپایا i := 0
    تا i کوچکتر 13:
        be16(t، 0)
        i += 1
    پایان
    برگشت t
پایان

تابع build_hhea(): فشرده سازی.بافر بایت:
    ناپایا t := فشرده سازی.بافر بایت جدید()
    be32(t، 0x00010000)
    be16(t، 800)
    be16(t، (0 - 200) & 0xFFFF)
    be16(t، 100)
    be16(t، 1000)
    be16(t، 0)
    be16(t، 0)
    be16(t، 900)
    be16(t، 1)
    be16(t، 0)
    be16(t، 0)
    ناپایا i := 0
    تا i کوچکتر 4:
        be16(t، 0)
        i += 1
    پایان
    be16(t، 0)
    be16(t، NUM_GLYPHS)
    برگشت t
پایان

تابع build_hmtx(): فشرده سازی.بافر بایت:
    ناپایا t := فشرده سازی.بافر بایت جدید()
    be16(t، 500)
    be16(t، 0)
    be16(t، 800)
    be16(t، 100)
    be16(t، 1000)
    be16(t، 100)
    be16(t، 900)
    be16(t، 0)
    برگشت t
پایان

تابع build_cmap(): فشرده سازی.بافر بایت:
    ناپایا t := فشرده سازی.بافر بایت جدید()
    be16(t، 0)
    be16(t، 1)
    be16(t، 3)
    be16(t، 1)
    be32(t، 12)
    be16(t، 4)
    be16(t، 32)
    be16(t، 0)
    be16(t، 4)
    be16(t، 4)
    be16(t، 1)
    be16(t، 0)
    be16(t، 0x43)
    be16(t، 0xFFFF)
    be16(t، 0)
    be16(t، 0x41)
    be16(t، 0xFFFF)
    be16(t، (0 - 64) & 0xFFFF)
    be16(t، 1)
    be16(t، 0)
    be16(t، 0)
    برگشت t
پایان

تابع build_glyf(loca &: فشرده سازی.بافر بایت): فشرده سازی.بافر بایت:
    ناپایا t := فشرده سازی.بافر بایت جدید()
    be16(loca، 0)
    be16(loca، 0)
    sq := glyph_square()
    فشرده سازی.افزودن بافر(t، sq)
    فشرده سازی.آزادسازی بافر(sq)
    be16(loca، t.طول / 2)
    rg := glyph_ring()
    فشرده سازی.افزودن بافر(t، rg)
    فشرده سازی.آزادسازی بافر(rg)
    be16(loca، t.طول / 2)
    tr := glyph_triangle()
    فشرده سازی.افزودن بافر(t، tr)
    فشرده سازی.آزادسازی بافر(tr)
    be16(loca، t.طول / 2)
    برگشت t
پایان

تابع put_record(out &: فشرده سازی.بافر بایت، tag: صحیح، off: صحیح، len: صحیح):
    be32(out، tag)
    be32(out، 0)
    be32(out، off)
    be32(out، len)
پایان

تابع build_ttf(): فشرده سازی.بافر بایت:
    ناپایا loca := فشرده سازی.بافر بایت جدید()
    glyf := build_glyf(loca)
    cmap := build_cmap()
    head := build_head()
    hhea := build_hhea()
    hmtx := build_hmtx()
    maxp := build_maxp()

    ناپایا off := 12 + 16 * TTF_NUM_TABLES
    off_cmap := off
    off = off + pad4(cmap.طول)
    off_glyf := off
    off = off + pad4(glyf.طول)
    off_head := off
    off = off + pad4(head.طول)
    off_hhea := off
    off = off + pad4(hhea.طول)
    off_hmtx := off
    off = off + pad4(hmtx.طول)
    off_loca := off
    off = off + pad4(loca.طول)
    off_maxp := off

    ناپایا out := فشرده سازی.بافر بایت جدید()
    be32(out، 0x00010000)
    be16(out، TTF_NUM_TABLES)
    be16(out، 64)
    be16(out، 2)
    be16(out، 48)
    put_record(out، 0x636D6170، off_cmap، cmap.طول)
    put_record(out، 0x676C7966، off_glyf، glyf.طول)
    put_record(out، 0x68656164، off_head، head.طول)
    put_record(out، 0x68686561، off_hhea، hhea.طول)
    put_record(out، 0x686D7478، off_hmtx، hmtx.طول)
    put_record(out، 0x6C6F6361، off_loca، loca.طول)
    put_record(out، 0x6D617870، off_maxp، maxp.طول)

    فشرده سازی.افزودن بافر(out، cmap)
    pad_to4(out)
    فشرده سازی.افزودن بافر(out، glyf)
    pad_to4(out)
    فشرده سازی.افزودن بافر(out، head)
    pad_to4(out)
    فشرده سازی.افزودن بافر(out، hhea)
    pad_to4(out)
    فشرده سازی.افزودن بافر(out، hmtx)
    pad_to4(out)
    فشرده سازی.افزودن بافر(out، loca)
    pad_to4(out)
    فشرده سازی.افزودن بافر(out، maxp)
    pad_to4(out)

    فشرده سازی.آزادسازی بافر(cmap)
    فشرده سازی.آزادسازی بافر(glyf)
    فشرده سازی.آزادسازی بافر(head)
    فشرده سازی.آزادسازی بافر(hhea)
    فشرده سازی.آزادسازی بافر(hmtx)
    فشرده سازی.آزادسازی بافر(loca)
    فشرده سازی.آزادسازی بافر(maxp)
    برگشت out
پایان

تابع ریشه:
    ttf := build_ttf()
    tmpdir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_font_index_test")
    سیستم عامل.ساخت پوشه ها(tmpdir)
    path := مسیر پرونده.پیوند(tmpdir، "synthetic.ttf")
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی از بافر(path، ttf))

    ناپایا ok := نادرست
    f := تصویر.بارگذاری قلم با اندیس(path، 0، ok)
    سرچاپ "index 0 ok: "، ok
    سرچاپ "index 0 valid: "، تصویر.قلم معتبر(f)
    سرچاپ "units per em: "، تصویر.واحد در ام(f)
    تصویر.آزادسازی قلم(f)

    ناپایا ok1 := درست
    other := تصویر.بارگذاری قلم با اندیس(path، 1، ok1)
    سرچاپ "index 1 ok: "، ok1
    سرچاپ "index 1 valid: "، تصویر.قلم معتبر(other)
    تصویر.آزادسازی قلم(other)

    ناپایا ok2 := درست
    neg := تصویر.بارگذاری قلم با اندیس(path، -1، ok2)
    سرچاپ "negative index ok: "، ok2
    تصویر.آزادسازی قلم(neg)

    ناپایا ok3 := درست
    gone := تصویر.بارگذاری قلم با اندیس(مسیر پرونده.پیوند(tmpdir، "absent.ttf")، 0، ok3)
    سرچاپ "missing file ok: "، ok3
    تصویر.آزادسازی قلم(gone)

    فشرده سازی.آزادسازی بافر(ttf)
    سیستم عامل.حذف همه(tmpdir)
    برگشت آزمایش.خلاصه()
پایان
