تابع ساخت جدول گلایف(جدول لوکا &: فشرده سازی.بافر بایت): فشرده سازی.بافر بایت:
    ناپایا t := فشرده سازی.بافر بایت جدید()
    نوشتن دوبایتی(جدول لوکا، 0)
    نوشتن دوبایتی(جدول لوکا، 0)
    ناپایا مربع := گلیف مربع()
    فشرده سازی.افزودن بافر(t، مربع)
    فشرده سازی.آزادسازی بافر(مربع)
    نوشتن دوبایتی(جدول لوکا، t.طول / 2)
    ناپایا حلقه := گلیف حلقه()
    فشرده سازی.افزودن بافر(t، حلقه)
    فشرده سازی.آزادسازی بافر(حلقه)
    نوشتن دوبایتی(جدول لوکا، t.طول / 2)
    ناپایا مثلث := گلیف مثلث()
    فشرده سازی.افزودن بافر(t، مثلث)
    فشرده سازی.آزادسازی بافر(مثلث)
    نوشتن دوبایتی(جدول لوکا، t.طول / 2)
    برگشت t
پایان

تابع نوشتن رکورد(نتیجه &: فشرده سازی.بافر بایت، برچسب: صحیح، جابجایی: صحیح، طول رکورد: صحیح):
    نوشتن چهاربایتی(نتیجه، برچسب)
    نوشتن چهاربایتی(نتیجه، 0)
    نوشتن چهاربایتی(نتیجه، جابجایی)
    نوشتن چهاربایتی(نتیجه، طول رکورد)
پایان

تابع ساخت قلم(): فشرده سازی.بافر بایت:
    ناپایا جدول لوکا := فشرده سازی.بافر بایت جدید()
    ناپایا جدول گلایف := ساخت جدول گلایف(جدول لوکا)
    ناپایا جدول سی‌مپ := ساخت جدول سی‌مپ()
    ناپایا جدول هد := ساخت جدول هد()
    ناپایا جدول اچ‌هی‌اِی := ساخت جدول اچ‌هی‌اِی()
    ناپایا جدول اچ‌ام‌تی‌ایکس := ساخت جدول اچ‌ام‌تی‌ایکس()
    ناپایا جدول مکس‌پی := ساخت جدول مکس‌پی()

    ناپایا جابجایی := 12 + 16 * TTF_NUM_TABLES
    جابجایی سی‌مپ := جابجایی
    جابجایی = جابجایی + گرد چهار(جدول سی‌مپ.طول)
    جابجایی گلایف := جابجایی
    جابجایی = جابجایی + گرد چهار(جدول گلایف.طول)
    جابجایی هد := جابجایی
    جابجایی = جابجایی + گرد چهار(جدول هد.طول)
    جابجایی اچ‌هی‌اِی := جابجایی
    جابجایی = جابجایی + گرد چهار(جدول اچ‌هی‌اِی.طول)
    جابجایی اچ‌ام‌تی‌ایکس := جابجایی
    جابجایی = جابجایی + گرد چهار(جدول اچ‌ام‌تی‌ایکس.طول)
    جابجایی لوکا := جابجایی
    جابجایی = جابجایی + گرد چهار(جدول لوکا.طول)
    جابجایی مکس‌پی := جابجایی

    ناپایا نتیجه := فشرده سازی.بافر بایت جدید()
    نوشتن چهاربایتی(نتیجه، 0x00010000)
    نوشتن دوبایتی(نتیجه، TTF_NUM_TABLES)
    نوشتن دوبایتی(نتیجه، 64)
    نوشتن دوبایتی(نتیجه، 2)
    نوشتن دوبایتی(نتیجه، 48)
    نوشتن رکورد(نتیجه، 0x636D6170، جابجایی سی‌مپ، جدول سی‌مپ.طول)
    نوشتن رکورد(نتیجه، 0x676C7966، جابجایی گلایف، جدول گلایف.طول)
    نوشتن رکورد(نتیجه، 0x68656164، جابجایی هد، جدول هد.طول)
    نوشتن رکورد(نتیجه، 0x68686561، جابجایی اچ‌هی‌اِی، جدول اچ‌هی‌اِی.طول)
    نوشتن رکورد(نتیجه، 0x686D7478، جابجایی اچ‌ام‌تی‌ایکس، جدول اچ‌ام‌تی‌ایکس.طول)
    نوشتن رکورد(نتیجه، 0x6C6F6361، جابجایی لوکا، جدول لوکا.طول)
    نوشتن رکورد(نتیجه، 0x6D617870، جابجایی مکس‌پی، جدول مکس‌پی.طول)

    فشرده سازی.افزودن بافر(نتیجه، جدول سی‌مپ)
    تراز چهار(نتیجه)
    فشرده سازی.افزودن بافر(نتیجه، جدول گلایف)
    تراز چهار(نتیجه)
    فشرده سازی.افزودن بافر(نتیجه، جدول هد)
    تراز چهار(نتیجه)
    فشرده سازی.افزودن بافر(نتیجه، جدول اچ‌هی‌اِی)
    تراز چهار(نتیجه)
    فشرده سازی.افزودن بافر(نتیجه، جدول اچ‌ام‌تی‌ایکس)
    تراز چهار(نتیجه)
    فشرده سازی.افزودن بافر(نتیجه، جدول لوکا)
    تراز چهار(نتیجه)
    فشرده سازی.افزودن بافر(نتیجه، جدول مکس‌پی)
    تراز چهار(نتیجه)

    فشرده سازی.آزادسازی بافر(جدول سی‌مپ)
    فشرده سازی.آزادسازی بافر(جدول گلایف)
    فشرده سازی.آزادسازی بافر(جدول هد)
    فشرده سازی.آزادسازی بافر(جدول اچ‌هی‌اِی)
    فشرده سازی.آزادسازی بافر(جدول اچ‌ام‌تی‌ایکس)
    فشرده سازی.آزادسازی بافر(جدول لوکا)
    فشرده سازی.آزادسازی بافر(جدول مکس‌پی)
    برگشت نتیجه
پایان

تابع ریشه:
    ناپایا قلم := ساخت قلم()
    پوشه آزمون := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_font_index_test")
    سیستم عامل.ساخت پوشه ها(پوشه آزمون)
    مسیر قلم := مسیر پرونده.پیوند(پوشه آزمون، "synthetic.ttf")
    آزمایش.ادعای درستی(بایگانی.نوشتن پرونده دودویی از بافر(مسیر قلم، قلم))

    ناپایا موفق := نادرست
    ناپایا f := تصویر.بارگذاری قلم با اندیس(مسیر قلم، 0، موفق)
    سرچاپ "index 0 ok: "، موفق
    سرچاپ "index 0 valid: "، تصویر.قلم معتبر(f)
    سرچاپ "units per em: "، تصویر.واحد در ام(f)
    تصویر.آزادسازی قلم(f)

    ناپایا موفق شاخص یک := درست
    ناپایا قلم دوم := تصویر.بارگذاری قلم با اندیس(مسیر قلم، 1، موفق شاخص یک)
    سرچاپ "index 1 ok: "، موفق شاخص یک
    سرچاپ "index 1 valid: "، تصویر.قلم معتبر(قلم دوم)
    تصویر.آزادسازی قلم(قلم دوم)

    ناپایا موفق شاخص منفی := درست
    ناپایا قلم منفی := تصویر.بارگذاری قلم با اندیس(مسیر قلم، -1، موفق شاخص منفی)
    سرچاپ "negative index ok: "، موفق شاخص منفی
    تصویر.آزادسازی قلم(قلم منفی)

    ناپایا موفق پرونده ناموجود := درست
    ناپایا قلم ناموجود := تصویر.بارگذاری قلم با اندیس(مسیر پرونده.پیوند(پوشه آزمون، "absent.ttf")، 0، موفق پرونده ناموجود)
    سرچاپ "missing file ok: "، موفق پرونده ناموجود
    تصویر.آزادسازی قلم(قلم ناموجود)

    فشرده سازی.آزادسازی بافر(قلم)
    سیستم عامل.حذف همه(پوشه آزمون)
    برگشت آزمایش.خلاصه()
پایان
