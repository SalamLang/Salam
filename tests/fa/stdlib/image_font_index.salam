بسته ریشه

واردسازی تصویر
واردسازی فشرده سازی
واردسازی بایگانی
واردسازی آزمایش
واردسازی سیستم عامل
واردسازی مسیر پرونده

پایا UPEM := 1000
پایا NUM_GLYPHS := 4
پایا TTF_NUM_TABLES := 7

تابع نوشتن دوبایتی(b &: فشرده سازی.بافر بایت، v: صحیح):
    فشرده سازی.افزودن بایت(b، (v >> 8) & 255)
    فشرده سازی.افزودن بایت(b، v & 255)
پایان

تابع نوشتن چهاربایتی(b &: فشرده سازی.بافر بایت، v: صحیح):
    نوشتن دوبایتی(b، (v >> 16) & 0xFFFF)
    نوشتن دوبایتی(b، v & 0xFFFF)
پایان

تابع گرد چهار(n: صحیح): صحیح:
    برگشت ((n + 3) / 4) * 4
پایان

تابع تراز چهار(b &: فشرده سازی.بافر بایت):
    تا (b.طول % 4) نابرابر 0:
        فشرده سازی.افزودن بایت(b، 0)
    پایان
پایان

تابع ساخت گلیف(مختصات افقی &: وکتور<صحیح>، مختصات عمودی &: وکتور<صحیح>، انتهای کانتورها &: وکتور<صحیح>): فشرده سازی.بافر بایت:
    ناپایا g := فشرده سازی.بافر بایت جدید()
    n := مختصات افقی.طول()
    ناپایا کمینه افقی := مختصات افقی.بگیر(0)
    ناپایا بیشینه افقی := مختصات افقی.بگیر(0)
    ناپایا کمینه عمودی := مختصات عمودی.بگیر(0)
    ناپایا بیشینه عمودی := مختصات عمودی.بگیر(0)
    ناپایا i := 1
    تا i کوچکتر n:
        اگر مختصات افقی.بگیر(i) کوچکتر کمینه افقی: کمینه افقی = مختصات افقی.بگیر(i) پایان
        اگر مختصات افقی.بگیر(i) بزرگتر بیشینه افقی: بیشینه افقی = مختصات افقی.بگیر(i) پایان
        اگر مختصات عمودی.بگیر(i) کوچکتر کمینه عمودی: کمینه عمودی = مختصات عمودی.بگیر(i) پایان
        اگر مختصات عمودی.بگیر(i) بزرگتر بیشینه عمودی: بیشینه عمودی = مختصات عمودی.بگیر(i) پایان
        i += 1
    پایان
    نوشتن دوبایتی(g، انتهای کانتورها.طول())
    نوشتن دوبایتی(g، کمینه افقی & 0xFFFF)
    نوشتن دوبایتی(g، کمینه عمودی & 0xFFFF)
    نوشتن دوبایتی(g، بیشینه افقی & 0xFFFF)
    نوشتن دوبایتی(g، بیشینه عمودی & 0xFFFF)
    ناپایا k := 0
    تا k کوچکتر انتهای کانتورها.طول():
        نوشتن دوبایتی(g، انتهای کانتورها.بگیر(k))
        k += 1
    پایان
    نوشتن دوبایتی(g، 0)
    ناپایا p := 0
    تا p کوچکتر n:
        فشرده سازی.افزودن بایت(g، 1)
        p += 1
    پایان
    ناپایا قبلی := 0
    ناپایا a := 0
    تا a کوچکتر n:
        نوشتن دوبایتی(g، (مختصات افقی.بگیر(a) - قبلی) & 0xFFFF)
        قبلی = مختصات افقی.بگیر(a)
        a += 1
    پایان
    قبلی = 0
    ناپایا b := 0
    تا b کوچکتر n:
        نوشتن دوبایتی(g، (مختصات عمودی.بگیر(b) - قبلی) & 0xFFFF)
        قبلی = مختصات عمودی.بگیر(b)
        b += 1
    پایان
    تراز چهار(g)
    برگشت g
پایان

تابع افزودن نقطه(مختصات افقی &: وکتور<صحیح>، مختصات عمودی &: وکتور<صحیح>، x: صحیح، y: صحیح):
    مختصات افقی.بیفزا(x)
    مختصات عمودی.بیفزا(y)
پایان

تابع گلیف مربع(): فشرده سازی.بافر بایت:
    ناپایا مختصات افقی := وکتور {} برگردان وکتور<صحیح>
    ناپایا مختصات عمودی := وکتور {} برگردان وکتور<صحیح>
    ناپایا انتهای کانتورها := وکتور {} برگردان وکتور<صحیح>
    افزودن نقطه(مختصات افقی، مختصات عمودی، 100، 0)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 700، 0)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 700، 700)
    افزودن نقطه(مختصات افقی، مختصات عمودی، 100، 700)
    انتهای کانتورها.بیفزا(3)
    نتیجه := ساخت گلیف(مختصات افقی، مختصات عمودی، انتهای کانتورها)
    مختصات افقی.آزادکن()
    مختصات عمودی.آزادکن()
    انتهای کانتورها.آزادکن()
    برگشت نتیجه
پایان

