بسته ریشه

واردسازی تصویر
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    ناپایا img := تصویر.جدید(24، 16)
    تکرار 16 در y:
        تکرار 24 در x:
            تصویر.تنظیم پیکسل(img، x، y، تصویر.قرمز سبز آبی(x * 10، y * 14، 128))
        پایان
    پایان
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_jpeg_save_test")
    سیستم عامل.ساخت پوشه ها(dir)
    path := مسیر پرونده.پیوند(dir، "out.jpg")

    opts := تصویر.گزینه‌های جی‌پگ { کیفیت = 95، کاهش نمونه‌های رنگ = نادرست، توضیح = "saved" }
    سرچاپ "saved: "، تصویر.ذخیره جی‌پگ با گزینه(img، path، opts)
    سرچاپ "size positive: "، سیستم عامل.اندازه پرونده(path) بزرگتر 0

    ناپایا ok := نادرست
    ناپایا back := تصویر.بازکردن(path، ok)
    سرچاپ "reopened: "، ok
    سرچاپ "dimensions: "، back.عرض، "x"، back.ارتفاع
    سرچاپ "close to original: "، تصویر.میانگین خطای مطلق(img، back) کوچکتر 8.0

    سرچاپ "unwritable: "، تصویر.ذخیره جی‌پگ با گزینه(img، مسیر پرونده.پیوند(dir، "no/such/dir/out.jpg")، opts)

    تصویر.آزادسازی(back)
    تصویر.آزادسازی(img)
    سیستم عامل.حذف همه(dir)
پایان
