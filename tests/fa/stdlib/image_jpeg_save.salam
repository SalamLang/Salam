بسته ریشه

واردسازی هوش مصنوعی.تصویر
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    ناپایا تصویر اصلی := تصویر.جدید(24، 16)
    تکرار 16 در y:
        تکرار 24 در x:
            تصویر.تنظیم پیکسل(تصویر اصلی، x، y، تصویر.قرمز سبز آبی(x * 10، y * 14، 128))
        پایان
    پایان
    پوشه آزمون := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_jpeg_save_test")
    سیستم عامل.ساخت پوشه ها(پوشه آزمون)
    مسیر ذخیره := مسیر پرونده.پیوند(پوشه آزمون، "out.jpg")

    گزینه ها := تصویر.گزینه‌های جی‌پگ { کیفیت = 95، کاهش نمونه‌های رنگ = نادرست، توضیح = "saved" }
    سرچاپ "saved: "، تصویر.ذخیره جی‌پگ با گزینه(تصویر اصلی، مسیر ذخیره، گزینه ها)
    سرچاپ "size positive: "، سیستم عامل.اندازه پرونده(مسیر ذخیره) بزرگتر 0

    ناپایا موفق := نادرست
    ناپایا تصویر بازخوانده := تصویر.بازکردن(مسیر ذخیره، موفق)
    سرچاپ "reopened: "، موفق
    سرچاپ "dimensions: "، تصویر بازخوانده.عرض، "x"، تصویر بازخوانده.ارتفاع
    سرچاپ "close to original: "، تصویر.میانگین خطای مطلق(تصویر اصلی، تصویر بازخوانده) کوچکتر 8.0

    سرچاپ "unwritable: "، تصویر.ذخیره جی‌پگ با گزینه(تصویر اصلی، مسیر پرونده.پیوند(پوشه آزمون، "no/such/dir/out.jpg")، گزینه ها)

    تصویر.آزادسازی(تصویر بازخوانده)
    تصویر.آزادسازی(تصویر اصلی)
    سیستم عامل.حذف همه(پوشه آزمون)
پایان
