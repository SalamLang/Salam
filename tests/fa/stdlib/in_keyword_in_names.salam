واردسازی تصویر
واردسازی عدد بزرگ

تابع ریشه:
    ت := تصویر.جدید(4، 3)
    سرچاپ تصویر.در محدوده(ت، 1، 1)، تصویر.در محدوده(ت، 9، 1)

    ناپایا آ := عدد بزرگ.از صحیح(6)
    ب := عدد بزرگ.از صحیح(7)
    عدد بزرگ.ضرب در(آ، ب)
    سرچاپ عدد بزرگ.به رشته(آ)

    فهرست := [0، 5]
    هر م در فهرست:
        سرچاپ تصویر.در محدوده(ت، م، 0)
    پایان
    تکرار 0 تا 4 هر 2 در ی:
        سرچاپ تصویر.در محدوده(ت، ی، 2)
    پایان
پایان
