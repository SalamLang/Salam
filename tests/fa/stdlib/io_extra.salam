بسته ریشه

واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی رشته

تابع ریشه:
    dir := سیستم عامل.پوشه موقت()
    path := مسیر پرونده.پیوند(dir، "salam_io_extra.txt")
    دیرکن حافظه.آزادسازی(path برگردان تهی*)

    سرچاپ "writing lines"
    ناپایا lines := وکتور {} برگردان وکتور<رشته>
    دیرکن lines.آزادکن()
    lines.بیفزا("alpha")
    lines.بیفزا("beta")
    lines.بیفزا("gamma")
    سرچاپ ورودی خروجی.نوشتن خط ها(path، lines)
    سرچاپ ورودی خروجی.خواندن پرونده(path) برابر "alpha\nbeta\ngamma\n"
    ناپایا none := وکتور {} برگردان وکتور<رشته>
    دیرکن none.آزادکن()
    سرچاپ ورودی خروجی.نوشتن خط ها(path، none)
    سرچاپ رشته.طول(ورودی خروجی.خواندن پرونده(path))
    سرچاپ ورودی خروجی.نوشتن خط ها(مسیر پرونده.پیوند(dir، "salam_io_missing_dir/x.txt")، lines)

    سرچاپ "reading lines and seeking"
    ورودی خروجی.نوشتن خط ها(path، lines)
    f := سیستم عامل.بازکردن(path، "rb")
    سرچاپ ورودی خروجی.خواندن خط(f)
    سرچاپ ورودی خروجی.خواندن خط(f)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 0، 0)
    سرچاپ ورودی خروجی.خواندن خط(f)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 6، 0)
    سرچاپ ورودی خروجی.خواندن(f، 4 برگردان طبیعی۶۴)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 0 - 6، 2)
    سرچاپ ورودی خروجی.خواندن خط(f)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 0، 0)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 2، 1)
    سرچاپ ورودی خروجی.خواندن(f، 3 برگردان طبیعی۶۴)
    ورودی خروجی.بستن(f)

    سرچاپ "standard error"
    ورودی خروجی.نوشتن خطا("warning: ")
    ورودی خروجی.نوشتن خطا("")
    ورودی خروجی.نوشتن خطا با خط جدید("this goes to stderr")
    سرچاپ "stdout stays clean"
    سیستم عامل.حذف(path)
پایان
