بسته ریشه

واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی رشته

تابع ریشه:
    پوشه آزمون := سیستم عامل.پوشه موقت()
    مسیر آزمون := مسیر پرونده.پیوند(پوشه آزمون، "salam_io_extra.txt")
    دیرکن حافظه.آزادسازی(مسیر آزمون برگردان تهی*)

    سرچاپ "writing lines"
    ناپایا فهرست خطوط := وکتور {} برگردان وکتور<رشته>
    دیرکن فهرست خطوط.آزادکن()
    فهرست خطوط.بیفزا("alpha")
    فهرست خطوط.بیفزا("beta")
    فهرست خطوط.بیفزا("gamma")
    سرچاپ ورودی خروجی.نوشتن خط ها(مسیر آزمون، فهرست خطوط)
    سرچاپ ورودی خروجی.خواندن پرونده(مسیر آزمون) برابر "alpha\nbeta\ngamma\n"
    ناپایا فهرست خالی := وکتور {} برگردان وکتور<رشته>
    دیرکن فهرست خالی.آزادکن()
    سرچاپ ورودی خروجی.نوشتن خط ها(مسیر آزمون، فهرست خالی)
    سرچاپ رشته.طول(ورودی خروجی.خواندن پرونده(مسیر آزمون))
    سرچاپ ورودی خروجی.نوشتن خط ها(مسیر پرونده.پیوند(پوشه آزمون، "salam_io_missing_dir/x.txt")، فهرست خطوط)

    سرچاپ "reading lines and seeking"
    ورودی خروجی.نوشتن خط ها(مسیر آزمون، فهرست خطوط)
    f := سیستم عامل.بازکردن(مسیر آزمون، "rb")
    سرچاپ ورودی خروجی.خواندن خط(f)
    سرچاپ ورودی خروجی.خواندن خط(f)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 0، 0)
    سرچاپ ورودی خروجی.خواندن خط(f)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 6، 0)
    سرچاپ ورودی خروجی.خواندن(f، 4 برگردان طبیعی۶۴)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 0 - 6، 2)
    سرچاپ ورودی خروجی.خواندن خط(f)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 0، 0)
    سرچاپ ورودی خروجی.جابجایی مکان نما(f، 2، 1)
    سرچاپ ورودی خروجی.خواندن(f، 3 برگردان طبیعی۶۴)
    ورودی خروجی.بستن(f)

    سرچاپ "standard error"
    ورودی خروجی.نوشتن خطا("warning: ")
    ورودی خروجی.نوشتن خطا("")
    ورودی خروجی.نوشتن خطا با خط جدید("this goes to stderr")
    سرچاپ "stdout stays clean"
    سیستم عامل.حذف(مسیر آزمون)
پایان
