// زبان: فارسی
واردسازی سیستم عامل.بارگذاری کتابخانه
واردسازی سیستم عامل.نگاشت حافظه

تابع گزارش(برچسب: رشته، نتیجه: منطقی):
    سرچاپ برچسب، نتیجه
پایان

تابع پایین(ایکس: اندازه): صحیح۶۴:
    برگشت (ایکس برگردان صحیح۶۴) & 0xFFFFFFFF
پایان

تابع ساخت کد(ن: صحیح، خروجی: طبیعی۸*، جا: صحیح): صحیح:
    ناپایا ک := جا
    اگر ن برابر 0:
        خروجی[ک] = 0xb8 برگردان طبیعی۸
        خروجی[ک + 1] = 77 برگردان طبیعی۸
        خروجی[ک + 2] = 0 برگردان طبیعی۸
        خروجی[ک + 3] = 0 برگردان طبیعی۸
        خروجی[ک + 4] = 0 برگردان طبیعی۸
        خروجی[ک + 5] = 0xc3 برگردان طبیعی۸
        برگشت 6
    پایان
    سر := [0x48، 0x89، 0xf8]
    ثبات ها := [0x48، 0x01، 0xf0، 0x48، 0x01، 0xd0، 0x48، 0x01، 0xc8، 0x4c، 0x01، 0xc0، 0x4c، 0x01، 0xc8]
    هفتم := [0x48، 0x03، 0x44، 0x24، 0x08]
    هشتم := [0x48، 0x03، 0x44، 0x24، 0x10]
    تکرار 3 در ا:
        خروجی[ک + ا] = سر[ا] برگردان طبیعی۸
    پایان
    ک += 3
    اگر ن بزرگتر 1:
        تعداد := (ن بزرگتر 6 ? 6 : ن) - 1
        تکرار تعداد * 3 در ا:
            خروجی[ک + ا] = ثبات ها[ا] برگردان طبیعی۸
        پایان
        ک += تعداد * 3
    پایان
    اگر ن بزرگتربرابر 7:
        تکرار 5 در ا:
            خروجی[ک + ا] = هفتم[ا] برگردان طبیعی۸
        پایان
        ک += 5
    پایان
    اگر ن بزرگتربرابر 8:
        تکرار 5 در ا:
            خروجی[ک + ا] = هشتم[ا] برگردان طبیعی۸
        پایان
        ک += 5
    پایان
    خروجی[ک] = 0xc3 برگردان طبیعی۸
    برگشت ک + 1 - جا
پایان

تابع ریشه:
    برگه := نگاشت حافظه.اندازه صفحه()
    گزارش("page size"، برگه بزرگتربرابر 4096 و برگه % 1024 برابر 0)

    اگر نگاشت حافظه.پشتیبانی می شود():
        یک := نگاشت حافظه.تخصیص(1، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی نوشتن)
        گزارش("one byte maps"، یک نابرابر پوچ)
        بایت ها := یک برگردان طبیعی۸*
        ناپایا صفر := درست
        تکرار برگه در ا:
            اگر بایت ها[ا] نابرابر 0:
                صفر = نادرست
            پایان
        پایان
        گزارش("fresh pages are zero"، صفر)
        بایت ها[0] = 7 برگردان طبیعی۸
        بایت ها[برگه - 1] = 9 برگردان طبیعی۸
        گزارش("whole page is writable"، بایت ها[0] برابر 7 و بایت ها[برگه - 1] برابر 9)
        گزارش("make read only"، نگاشت حافظه.تغییر دسترسی(یک، 1، نگاشت حافظه.دسترسی خواندن))
        گزارش("value kept"، بایت ها[0] برابر 7)
        گزارش("make writable again"، نگاشت حافظه.تغییر دسترسی(یک، برگه، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی نوشتن))
        گزارش("free with the small size"، نگاشت حافظه.آزادسازی(یک، 1))

        چند := نگاشت حافظه.تخصیص(3 * برگه، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی نوشتن)
        گزارش("three pages"، چند نابرابر پوچ)
        بایت های چند := چند برگردان طبیعی۸*
        بایت های چند[3 * برگه - 1] = 5 برگردان طبیعی۸
        گزارش("last byte"، بایت های چند[3 * برگه - 1] برابر 5)
        گزارش("no access"، نگاشت حافظه.تغییر دسترسی(چند، 3 * برگه، نگاشت حافظه.بدون دسترسی))
        گزارش("access again"، نگاشت حافظه.تغییر دسترسی(چند، 3 * برگه، نگاشت حافظه.دسترسی خواندن))
        گزارش("read after protect"، بایت های چند[3 * برگه - 1] برابر 5)
        گزارش("free"، نگاشت حافظه.آزادسازی(چند، 3 * برگه))

        هیچ := نگاشت حافظه.تخصیص(برگه، نگاشت حافظه.بدون دسترسی)
        گزارش("no-access mapping"، هیچ نابرابر پوچ)
        گزارش("open it up"، نگاشت حافظه.تغییر دسترسی(هیچ، برگه، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی نوشتن))
        گزارش("free again"، نگاشت حافظه.آزادسازی(هیچ، برگه))

        گزارش("zero size"، نگاشت حافظه.تخصیص(0، نگاشت حافظه.دسترسی خواندن) برابر پوچ)
        گزارش("negative size"، نگاشت حافظه.تخصیص(0 - 1، نگاشت حافظه.دسترسی خواندن) برابر پوچ)
        گزارش("null free"، وارونه نگاشت حافظه.آزادسازی(پوچ، برگه))
        گزارش("null protect"، وارونه نگاشت حافظه.تغییر دسترسی(پوچ، برگه، نگاشت حافظه.دسترسی خواندن))
    وگرنه:
        هر برچسب در ["one byte maps"، "fresh pages are zero"، "whole page is writable"، "make read only"، "value kept"، "make writable again"، "free with the small size"، "three pages"، "last byte"، "no access"، "access again"، "read after protect"، "free"، "no-access mapping"، "open it up"، "free again"، "zero size"، "negative size"، "null free"، "null protect"]:
            گزارش(برچسب، درست)
        پایان
    پایان

    اگر بارگذاری کتابخانه.پشتیبانی می شود():
        کتابخانه := بارگذاری کتابخانه.باز کردن برنامه()
        دوباره := بارگذاری کتابخانه.باز کردن برنامه()
        گزارش("open self twice"، کتابخانه نابرابر پوچ و دوباره نابرابر پوچ)
        گزارش("null library has no symbols"، بارگذاری کتابخانه.نماد(پوچ، "strlen") برابر پوچ)
        گزارش("empty name"، بارگذاری کتابخانه.نماد(کتابخانه، "") برابر پوچ)
        گزارش("close null"، وارونه بارگذاری کتابخانه.بستن(پوچ))
        گزارش("close"، بارگذاری کتابخانه.بستن(دوباره))

        متن := "abc"
        دیگر := "abz"
        گزارش("strlen"، بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(کتابخانه، "strlen")، [(متن برگردان تهی*) برگردان اندازه]) برابر 3)
        گزارش("abs"، پایین(بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(کتابخانه، "abs")، [(0 - 5) برگردان اندازه])) برابر 5)
        گزارش("toupper"، پایین(بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(کتابخانه، "toupper")، [97 برگردان اندازه])) برابر 65)
        گزارش("strcmp"، پایین(بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(کتابخانه، "strcmp")، [(متن برگردان تهی*) برگردان اندازه، (دیگر برگردان تهی*) برگردان اندازه])) نابرابر 0)
        گزارش("strncmp"، پایین(بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(کتابخانه، "strncmp")، [(متن برگردان تهی*) برگردان اندازه، (دیگر برگردان تهی*) برگردان اندازه، 2 برگردان اندازه])) برابر 0)
        گزارش("memcmp"، پایین(بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(کتابخانه، "memcmp")، [(متن برگردان تهی*) برگردان اندازه، (دیگر برگردان تهی*) برگردان اندازه، 3 برگردان اندازه])) نابرابر 0)
        گزارش("null function"، بارگذاری کتابخانه.فراخوان(پوچ، [1 برگردان اندازه، 2]) برابر 0)
        گزارش("nine arguments"، بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(کتابخانه، "strlen")، [1 برگردان اندازه، 2، 3، 4، 5، 6، 7، 8، 9]) برابر 0)

        ناموجود := بارگذاری کتابخانه.باز کردن("libsalam-no-such-library.so.1")
        گزارش("missing library"، ناموجود برابر پوچ)
        گزارش("error text"، بارگذاری کتابخانه.خطا().طول() بزرگتر 0)
        گزارش("missing close"، وارونه بارگذاری کتابخانه.بستن(ناموجود))
        گزارش("missing symbol"، بارگذاری کتابخانه.نماد(کتابخانه، "salam_no_such_symbol") برابر پوچ)
        گزارش("close self"، بارگذاری کتابخانه.بستن(کتابخانه))
    وگرنه:
        هر برچسب در ["open self twice"، "null library has no symbols"، "empty name"، "close null"، "close"، "strlen"، "abs"، "toupper"، "strcmp"، "strncmp"، "memcmp"، "null function"، "nine arguments"، "missing library"، "error text"، "missing close"، "missing symbol"، "close self"]:
            گزارش(برچسب، درست)
        پایان
    پایان

    اگر سلام معماری ایکس۶۴ و بارگذاری کتابخانه.پشتیبانی می شود() و نگاشت حافظه.پشتیبانی می شود():
        کد := نگاشت حافظه.تخصیص(برگه، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی نوشتن)
        خروجی := کد برگردان طبیعی۸*
        ناپایا مصرف := 0
        ناپایا آغازها := وکتور {} برگردان وکتور<صحیح>
        دیرکن آغازها.آزادکن()
        تکرار 0 تا 8 در ن:
            آغازها.بیفزا(مصرف)
            مصرف += ساخت کد(ن، خروجی، مصرف)
            مصرف = (مصرف + 15) & (0 - 16)
        پایان
        گزارش("stubs fit"، مصرف کوچکتر برگه)
        گزارش("run them"، نگاشت حافظه.تغییر دسترسی(کد، برگه، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی اجرا))
        پایه := کد برگردان صحیح۶۴
        هیچ := [0 برگردان اندازه]
        گزارش("0 arguments"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(0) برگردان صحیح۶۴) برگردان تهی*، هیچ[: 0]) برابر 77)
        گزارش("1 argument"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(1) برگردان صحیح۶۴) برگردان تهی*، [5 برگردان اندازه]) برابر 5)
        گزارش("2 arguments"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(2) برگردان صحیح۶۴) برگردان تهی*، [1 برگردان اندازه، 2]) برابر 3)
        گزارش("3 arguments"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(3) برگردان صحیح۶۴) برگردان تهی*، [1 برگردان اندازه، 2، 3]) برابر 6)
        گزارش("4 arguments"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(4) برگردان صحیح۶۴) برگردان تهی*، [1 برگردان اندازه، 2، 3، 4]) برابر 10)
        گزارش("5 arguments"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(5) برگردان صحیح۶۴) برگردان تهی*، [1 برگردان اندازه، 2، 3، 4، 5]) برابر 15)
        گزارش("6 arguments"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(6) برگردان صحیح۶۴) برگردان تهی*، [1 برگردان اندازه، 2، 3، 4، 5، 6]) برابر 21)
        گزارش("7 arguments"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(7) برگردان صحیح۶۴) برگردان تهی*، [1 برگردان اندازه، 2، 3، 4، 5، 6، 7]) برابر 28)
        گزارش("8 arguments"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(8) برگردان صحیح۶۴) برگردان تهی*، [1 برگردان اندازه، 2، 3، 4، 5، 6، 7، 8]) برابر 36)
        گزارش("negative argument"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(2) برگردان صحیح۶۴) برگردان تهی*، [(0 - 3) برگردان اندازه، 1]) برابر (0 - 2) برگردان اندازه)
        گزارش("9 arguments"، بارگذاری کتابخانه.فراخوان((پایه + آغازها.بگیر(8) برگردان صحیح۶۴) برگردان تهی*، [1 برگردان اندازه، 2، 3، 4، 5، 6، 7، 8، 9]) برابر 0)
        گزارش("free code"، نگاشت حافظه.آزادسازی(کد، برگه))
    وگرنه:
        هر برچسب در ["stubs fit"، "run them"، "0 arguments"، "1 argument"، "2 arguments"، "3 arguments"، "4 arguments"، "5 arguments"، "6 arguments"، "7 arguments"، "8 arguments"، "negative argument"، "9 arguments"، "free code"]:
            گزارش(برچسب، درست)
        پایان
    پایان
پایان
