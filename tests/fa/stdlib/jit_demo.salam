    سرچاپ "protections"، نگاشت حافظه.بدون دسترسی، نگاشت حافظه.دسترسی خواندن، نگاشت حافظه.دسترسی نوشتن، نگاشت حافظه.دسترسی اجرا
    سرچاپ "page size is a power of two:"، نگاشت حافظه.اندازه صفحه() بزرگتربرابر 4096 و (نگاشت حافظه.اندازه صفحه() & (نگاشت حافظه.اندازه صفحه() - 1)) برابر 0

    سرچاپ "supported:"، بارگذاری کتابخانه.پشتیبانی می شود()، نگاشت حافظه.پشتیبانی می شود()
    اگر وارونه بارگذاری کتابخانه.پشتیبانی می شود():
        برگشت
    پایان

    lib := بارگذاری کتابخانه.باز کردن برنامه()
    سرچاپ "self:"، lib نابرابر پوچ
    سرچاپ "strlen:"، بارگذاری کتابخانه.نماد(lib، "strlen") نابرابر پوچ، "nothing:"، بارگذاری کتابخانه.نماد(lib، "salam_no_such_symbol") برابر پوچ
    s := "hello, world"
    سرچاپ بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(lib، "strlen")، [(s برگردان تهی*) برگردان اندازه])
    سرچاپ بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(lib، "labs")، [(0 - 42) برگردان اندازه])
    سرچاپ بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(lib، "strcmp")، [(s برگردان تهی*) برگردان اندازه، (s برگردان تهی*) برگردان اندازه])
    سرچاپ بارگذاری کتابخانه.فراخوان(پوچ، [1 برگردان اندازه])
    none := [0 برگردان اندازه]
    سرچاپ بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(lib، "getpid")، none[: 0]) بزرگتر 0
    سرچاپ بارگذاری کتابخانه.بستن(lib)

    missing := بارگذاری کتابخانه.باز کردن("libsalam-no-such-library.so.1")
    سرچاپ "missing library:"، missing برابر پوچ، بارگذاری کتابخانه.خطا().طول() بزرگتر 0

    اگر سلام معماری ایکس۶۴:
        page := نگاشت حافظه.اندازه صفحه()
        mem1 := نگاشت حافظه.تخصیص(page، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی نوشتن)
        سرچاپ "mapped:"، mem1 نابرابر پوچ
        bytes := mem1 برگردان طبیعی۸*
        c := code()
        تکرار 29 در i:
            bytes[i] = c[i] برگردان طبیعی۸
        پایان
        سرچاپ "protect:"، نگاشت حافظه.تغییر دسترسی(mem1، page، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی اجرا)
        سرچاپ "sum of eight arguments:"، بارگذاری کتابخانه.فراخوان(mem1، [1 برگردان اندازه، 2، 3، 4، 5، 6، 7، 8])
        سرچاپ "free:"، نگاشت حافظه.آزادسازی(mem1، page)
        سرچاپ "zero size:"، نگاشت حافظه.تخصیص(0، نگاشت حافظه.دسترسی خواندن) برابر پوچ، نگاشت حافظه.آزادسازی(پوچ، page)
