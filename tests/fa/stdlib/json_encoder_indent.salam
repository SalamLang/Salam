بسته ریشه

واردسازی کدگذاری.جیسون
واردسازی کدگذاری.مقدار

ساختار Point:
    همگانی x: صحیح = 0
    همگانی y: صحیح = 0
پایان

تابع ریشه:
    ناپایا arr := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(arr، مقدار.مقدار صحیح(1 برگردان صحیح۶۴))
    مقدار.افزودن به آرایه(arr، مقدار.مقدار رشته("two"))
    ناپایا enc := جیسون.کدگذار حافظه با تورفتگی("  ")
    enc.کدگذاری(arr)
    سرچاپ enc.متن()
    ناپایا flat := جیسون.کدگذار حافظه()
    flat.کدگذاری(arr)
    سرچاپ flat.متن()
    ناپایا tabs := جیسون.کدگذار حافظه با تورفتگی("\t")
    tabs.کدگذاری(arr)
    سرچاپ tabs.متن().طول() بزرگتر flat.متن().طول()

    envelope := جیسون.پوشش طرحواره(Point {})
    سرچاپ جیسون.ادغام طرحواره(envelope) برابر جیسون.طرحواره(Point {})
    سرچاپ جیسون.ادغام طرحواره("{}")
    سرچاپ جیسون.طرحواره(Point {}).طول() بزرگتر 40
پایان
