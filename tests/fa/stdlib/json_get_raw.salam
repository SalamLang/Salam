بسته ریشه

واردسازی کدگذاری.جیسون

تابع ریشه:
    متن := "{\"name\":\"a \\\"b\\\"\",\"n\":7,\"list\":[1,\"x\"],\"o\":{\"k\":true}}"
    سرچاپ جیسون.دریافت خام(متن، "name")
    سرچاپ جیسون.دریافت خام(متن، "n")
    سرچاپ جیسون.دریافت خام(متن، "list")
    سرچاپ جیسون.دریافت خام(متن، "o")
    سرچاپ جیسون.دریافت خام(متن، "missing").طول()
    سرچاپ جیسون.دریافت(متن، "name")
پایان
