بسته ریشه

واردسازی کدگذاری.جیسون

تابع ریشه:
    متن := "{\"نام\":\"\",\"b\":\"x\",\"c\":null,\"o\":{\"inner\":1}}"
    سرچاپ جیسون.دارد(متن، "نام")
    سرچاپ جیسون.دارد(متن، "b")
    سرچاپ جیسون.دارد(متن، "c")
    سرچاپ جیسون.دارد(متن، "inner")
    سرچاپ جیسون.دارد(متن، "نیست")
    سرچاپ جیسون.دریافت خام(متن، "نام")
پایان
