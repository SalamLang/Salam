بسته ریشه

واردسازی جی دبلیو تی

پایا گواهی := "claim-types-secret-kept-on-the-server"

تابع امضاشده(بار: رشته): رشته:
    متن امضا := جی دبلیو تی.کدگذاری پایه۶۴ نشانی(`{"alg":"HS256","typ":"JWT"}`) + "." + جی دبلیو تی.کدگذاری پایه۶۴ نشانی(بار)
    برگشت متن امضا + "." + جی دبلیو تی.امضای ورودی(متن امضا، جی دبلیو تی.الگوریتم اچ اس۲۵۶، گواهی)
پایان

تابع بررسی(برچسب: رشته، بار: رشته):
    ناپایا گزینه := جی دبلیو تی.گزینه های پیش فرض()
    گزینه.اکنون = 1700000000 برگردان صحیح۶۴
    چاپ برچسب
    چاپ ": "
    اگر جی دبلیو تی.معتبر است(امضاشده(بار)، گواهی، گزینه):
        سرچاپ "accepted"
    وگرنه:
        سرچاپ "rejected"
    پایان
پایان

تابع ریشه:
    بررسی("numeric exp in the future"، `{"exp":1700000600}`)
    بررسی("numeric exp in the past"، `{"exp":1}`)
    بررسی("string exp"، `{"exp":"1"}`)
    بررسی("string exp in the future"، `{"exp":"1700000600"}`)
    بررسی("boolean exp"، `{"exp":true}`)
    بررسی("null exp"، `{"exp":null}`)
    بررسی("string nbf"، `{"nbf":"1"}`)
    بررسی("string iat"، `{"iat":"1"}`)
    بررسی("double minus exp"، `{"exp":--1}`)
    بررسی("glued numbers exp"، `{"exp":1-2}`)
    بررسی("leading zero exp"، `{"exp":01}`)
    بررسی("plus sign exp"، `{"exp":+1700000600}`)
    بررسی("bare dot exp"، `{"exp":.5}`)
    بررسی("exponent nbf"، `{"nbf":1.7e9}`)
    بررسی("fraction exp in the future"، `{"exp":1700000600.5}`)
    بررسی("negative iat"، `{"iat":-1}`)
    بررسی("no time claims"، `{"sub":"u"}`)
    خالی := جی دبلیو تی.گزینه های پیش فرض()
    سرچاپ "empty secret: " + جی دبلیو تی.معتبر است(امضاشده(`{"sub":"u"}`)، ""، خالی)
پایان
