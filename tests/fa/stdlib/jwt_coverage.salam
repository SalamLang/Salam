بسته ریشه

واردسازی جی دبلیو تی
واردسازی حافظه
واردسازی آزمایش
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا نگهبان کل := جی دبلیو تی.نگهبان جدید("a-server-secret-only-the-server-knows")

تابع چه کسی(زمینه: صحیح۶۴):
    اچ تی تی پی.متن(زمینه، "bearer=" + جی دبلیو تی.توکن حامل(زمینه) + " from=" + جی دبلیو تی.توکن از(زمینه، نگهبان کل))
پایان

تابع بدون گواهی نمونه(زمینه: صحیح۶۴):
    جی دبلیو تی.بدون گواهی(زمینه، نگهبان کل)
پایان

تابع ورود کاربر(زمینه: صحیح۶۴):
    تلاش:
        توکن صادرشده := جی دبلیو تی.صدور برای(نگهبان کل، "42"، 3600)
        جی دبلیو تی.تنظیم کوکی نشست(زمینه، نگهبان کل، توکن صادرشده، 3600)
        اچ تی تی پی.متن(زمینه، توکن صادرشده)
    گرفتن خطا e:
        اچ تی تی پی.تنظیم وضعیت(زمینه، 500)
        اچ تی تی پی.متن(زمینه، e.کد)
    پایان
پایان

تابع test_b64url_bytes():
    بافر := حافظه.تخصیص(6 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(بافر)
    اشاره‌گر بایت := بافر برگردان طبیعی۸*
    اشاره‌گر بایت[0] = 0xfb برگردان طبیعی۸
    اشاره‌گر بایت[1] = 0xff برگردان طبیعی۸
    اشاره‌گر بایت[2] = 0xfe برگردان طبیعی۸
    اشاره‌گر بایت[3] = 0x00 برگردان طبیعی۸
    اشاره‌گر بایت[4] = 0x41 برگردان طبیعی۸
    اشاره‌گر بایت[5] = 0x42 برگردان طبیعی۸
    آزمایش.ادعای برابری رشته(جی دبلیو تی.کدگذاری پایه۶۴ نشانی بایت(بافر، 6)، "-__-AEFC")
    آزمایش.ادعای برابری رشته(جی دبلیو تی.کدگذاری پایه۶۴ نشانی بایت(بافر، 3)، "-__-")
    آزمایش.ادعای برابری رشته(جی دبلیو تی.کدگذاری پایه۶۴ نشانی بایت(بافر، 0)، "")
پایان

تابع test_claim_times():
    ناپایا c := جی دبلیو تی.ادعاهای جدید()
    جی دبلیو تی.انقضا در(c، 600 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.زمان انقضا - c.زمان صدور برابر 600 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.زمان صدور بزرگتر 1600000000 برگردان صحیح۶۴)
    جی دبلیو تی.معتبر نه پیش از(c، 30 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.آغاز اعتبار - c.زمان صدور بزرگتربرابر 29 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.آغاز اعتبار - c.زمان صدور کوچکتربرابر 31 برگردان صحیح۶۴)
    جی دبلیو تی.معتبر نه پیش از(c، -5 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.آغاز اعتبار کوچکتر c.زمان صدور + 1 برگردان صحیح۶۴)
پایان

تابع test_http():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/who"، چه کسی)
    مسیریاب.دریافت(r، "/missing"، بدون گواهی نمونه)
    مسیریاب.ارسال(r، "/login"، ورود کاربر)
    ناپایا s := اچ تی تی پی.سرور جدید(19890)
    اچ تی تی پی.استفاده(s، r)
    _ := اچ تی تی پی.اجرا در پس زمینه(s)
    نشانی پایه := "http://127.0.0.1:19890"

    نگهبان کل.کوکی = "session"
    پاسخ ساده := اچ تی تی پی.دریافت(نشانی پایه + "/who")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(پاسخ ساده)، "bearer= from=")

    ناپایا سرصفحه حامل := اچ تی تی پی.سرصفحه جدید()
    سرصفحه حامل.درج("Authorization"، "Bearer abc.def.ghi")
    پاسخ سرصفحه := اچ تی تی پی.دریافت با(نشانی پایه + "/who"، سرصفحه حامل)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(پاسخ سرصفحه)، "bearer=abc.def.ghi from=abc.def.ghi")

    ناپایا سرصفحه کوکی := اچ تی تی پی.سرصفحه جدید()
    سرصفحه کوکی.درج("Cookie"، "session=cookie.token.value")
    پاسخ کوکی := اچ تی تی پی.دریافت با(نشانی پایه + "/who"، سرصفحه کوکی)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(پاسخ کوکی)، "bearer= from=cookie.token.value")

    ناپایا سرصفحه هردو := اچ تی تی پی.سرصفحه جدید()
    سرصفحه هردو.درج("Authorization"، "Bearer first")
    سرصفحه هردو.درج("Cookie"، "session=second")
    پاسخ برنده := اچ تی تی پی.دریافت با(نشانی پایه + "/who"، سرصفحه هردو)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(پاسخ برنده)، "bearer=first from=first")

    پاسخ رد شده := اچ تی تی پی.دریافت(نشانی پایه + "/missing")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(پاسخ رد شده)، 401)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(پاسخ رد شده)، `{"error":"unauthorized","reason":"missing bearer token"}`)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.سرصفحه ها(پاسخ رد شده).بگیر("WWW-Authenticate")، `Bearer realm="api"`)

    پاسخ ورود := اچ تی تی پی.ارسال(نشانی پایه + "/login"، "")
    توکن صادرشده := اچ تی تی پی.بدنه(پاسخ ورود)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.نگاشت کوکی(پاسخ ورود).بگیر("session")، توکن صادرشده)
    آزمایش.ادعای درستی(توکن صادرشده.طول() بزرگتر 20)
پایان

تابع ریشه:
    test_b64url_bytes()
    test_claim_times()
    test_http()
    آزمایش.خلاصه()
    برگشت 0
پایان
