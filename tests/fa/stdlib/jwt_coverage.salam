بسته ریشه

واردسازی جی دبلیو تی
واردسازی حافظه
واردسازی آزمایش
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا guard := جی دبلیو تی.نگهبان جدید("a-server-secret-only-the-server-knows")

تابع whoami(ctx: صحیح۶۴):
    اچ تی تی پی.متن(ctx، "bearer=" + جی دبلیو تی.توکن حامل(ctx) + " from=" + جی دبلیو تی.توکن از(ctx، guard))
پایان

تابع missing(ctx: صحیح۶۴):
    جی دبلیو تی.بدون گواهی(ctx، guard)
پایان

تابع login(ctx: صحیح۶۴):
    تلاش:
        token := جی دبلیو تی.صدور برای(guard، "42"، 3600)
        جی دبلیو تی.تنظیم کوکی نشست(ctx، guard، token، 3600)
        اچ تی تی پی.متن(ctx، token)
    گرفتن خطا e:
        اچ تی تی پی.تنظیم وضعیت(ctx، 500)
        اچ تی تی پی.متن(ctx، e.کد)
    پایان
پایان

تابع test_b64url_bytes():
    buf := حافظه.تخصیص(6 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(buf)
    bp := buf برگردان طبیعی۸*
    bp[0] = 0xfb برگردان طبیعی۸
    bp[1] = 0xff برگردان طبیعی۸
    bp[2] = 0xfe برگردان طبیعی۸
    bp[3] = 0x00 برگردان طبیعی۸
    bp[4] = 0x41 برگردان طبیعی۸
    bp[5] = 0x42 برگردان طبیعی۸
    آزمایش.ادعای برابری رشته(جی دبلیو تی.کدگذاری پایه۶۴ نشانی بایت(buf، 6)، "-__-AEFC")
    آزمایش.ادعای برابری رشته(جی دبلیو تی.کدگذاری پایه۶۴ نشانی بایت(buf، 3)، "-__-")
    آزمایش.ادعای برابری رشته(جی دبلیو تی.کدگذاری پایه۶۴ نشانی بایت(buf، 0)، "")
پایان

تابع test_claim_times():
    ناپایا c := جی دبلیو تی.ادعاهای جدید()
    جی دبلیو تی.انقضا در(c، 600 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.زمان انقضا - c.زمان صدور برابر 600 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.زمان صدور بزرگتر 1600000000 برگردان صحیح۶۴)
    جی دبلیو تی.معتبر نه پیش از(c، 30 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.آغاز اعتبار - c.زمان صدور بزرگتربرابر 29 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.آغاز اعتبار - c.زمان صدور کوچکتربرابر 31 برگردان صحیح۶۴)
    جی دبلیو تی.معتبر نه پیش از(c، -5 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(c.آغاز اعتبار کوچکتر c.زمان صدور + 1 برگردان صحیح۶۴)
پایان

تابع test_http():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/who"، whoami)
    مسیریاب.دریافت(r، "/missing"، missing)
    مسیریاب.ارسال(r، "/login"، login)
    ناپایا s := اچ تی تی پی.سرور جدید(19890)
    اچ تی تی پی.استفاده(s، r)
    _ := اچ تی تی پی.اجرا در پس زمینه(s)
    base := "http://127.0.0.1:19890"

    guard.کوکی = "session"
    plain := اچ تی تی پی.دریافت(base + "/who")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(plain)، "bearer= from=")

    ناپایا bearer := اچ تی تی پی.سرصفحه جدید()
    bearer.درج("Authorization"، "Bearer abc.def.ghi")
    viaheader := اچ تی تی پی.دریافت با(base + "/who"، bearer)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(viaheader)، "bearer=abc.def.ghi from=abc.def.ghi")

    ناپایا cookie := اچ تی تی پی.سرصفحه جدید()
    cookie.درج("Cookie"، "session=cookie.token.value")
    viacookie := اچ تی تی پی.دریافت با(base + "/who"، cookie)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(viacookie)، "bearer= from=cookie.token.value")

    ناپایا both := اچ تی تی پی.سرصفحه جدید()
    both.درج("Authorization"، "Bearer first")
    both.درج("Cookie"، "session=second")
    wins := اچ تی تی پی.دریافت با(base + "/who"، both)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(wins)، "bearer=first from=first")

    denied := اچ تی تی پی.دریافت(base + "/missing")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(denied)، 401)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(denied)، `{"error":"unauthorized","reason":"missing bearer token"}`)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.سرصفحه ها(denied).بگیر("WWW-Authenticate")، `Bearer realm="api"`)

    signed := اچ تی تی پی.ارسال(base + "/login"، "")
    token := اچ تی تی پی.بدنه(signed)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.نگاشت کوکی(signed).بگیر("session")، token)
    آزمایش.ادعای درستی(token.طول() بزرگتر 20)
پایان

تابع ریشه:
    test_b64url_bytes()
    test_claim_times()
    test_http()
    آزمایش.خلاصه()
    برگشت 0
پایان
