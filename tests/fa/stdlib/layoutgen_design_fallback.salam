بسته ریشه

واردسازی سازنده‌ها

تابع صفحه(نام: رشته): سازنده‌ها.گره:
    ناپایا n := سازنده‌ها.گره {}
    اگر نام نابرابر "":
        n.attrs = " data-design=\"" + نام + "\""
    پایان
    برگشت n
پایان

تابع نمایش(نام: رشته):
    سازنده‌ها.طراحی صفحه(صفحه(نام))
    سرچاپ سازنده‌ها.نام طراحی() + " " + سازنده‌ها.انتخاب طراحی("acme"، "S"، "A") + " " + سازنده‌ها.انتخاب طراحی("acme"، "S"، "")
پایان

تابع ریشه:
    نمایش("")
    نمایش("shadcn")
    نمایش("acme")
    نمایش("none")
پایان
