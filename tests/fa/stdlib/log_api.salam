بسته ریشه

واردسازی گزارش
واردسازی سیستم پرونده.مسیر
واردسازی ورودی خروجی
واردسازی رشته
واردسازی سیستم عامل

تابع vec(a: رشته، b: رشته): وکتور<رشته>:
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.بیفزا(a)
    v.بیفزا(b)
    برگشت v
پایان

تابع ریشه:
    گزارش.نمایش زمان(نادرست)
    گزارش.تنظیم سطح(گزارش.سطح اشکال زدایی)
    گزارش.به خروجی استاندارد()
    گزارش.تنظیم پیشوند("app")

    سرچاپ "format default: "، گزارش.دریافت قالب()
    گزارش.اشکال زدایی قالبی("loaded {} items"، vec("3"، "unused"))
    گزارش.خطا قالبی("failed {} on {}"، vec("write"، "disk"))
    گزارش.هشدار قالبی("careful {}"، vec("now"، "unused"))
    گزارش.اطلاعات قالبی("hello {}"، vec("world"، "unused"))

    keys := vec("user"، "role")
    vals := vec("ali"، "admin user")
    گزارش.اشکال زدایی با فیلد("debug kv"، keys، vals)
    گزارش.اطلاعات با فیلد("info kv"، keys، vals)
    گزارش.هشدار با فیلد("warn kv"، keys، vals)
    گزارش.خطا با فیلد("error kv"، keys، vals)

    گزارش.تنظیم قالب(گزارش.قالب جیسون)
    سرچاپ "format json: "، گزارش.دریافت قالب()
    گزارش.اطلاعات با فیلد("json kv"، keys، vals)
    گزارش.تنظیم قالب(گزارش.قالب متن)

    dir := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_log_api_test")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    file := مسیر.پیوند(dir، "app.log")

    سرچاپ "to file: "، گزارش.به پرونده(file)
    گزارش.اطلاعات("into the file")
    گزارش.هشدار با فیلد("file kv"، keys، vals)
    گزارش.بستن پرونده()
    گزارش.اطلاعات("back on stdout")
    سرچاپ "file content:"
    چاپ ورودی خروجی.خواندن پرونده(file)

    گزارش.تنظیم چرخش(60 برگردان صحیح۶۴، 2)
    سرچاپ "to file again: "، گزارش.به پرونده(file)
    تکرار 6 در i:
        گزارش.اطلاعات قالبی("rotating line {}"، vec(conv_str(i)، "unused"))
    پایان
    گزارش.بستن پرونده()
    سرچاپ "rotated backup: "، سیستم عامل.وجود دارد(file.پیوست(".1"))
    سرچاپ "second backup: "، سیستم عامل.وجود دارد(file.پیوست(".2"))
    سرچاپ "no third backup: "، سیستم عامل.وجود دارد(file.پیوست(".3"))

    سرچاپ "bad path: "، گزارش.به پرونده(مسیر.پیوند(dir، "missing/sub/app.log"))
    سیستم عامل.حذف همه(dir)
پایان

تابع conv_str(i: صحیح): رشته:
    برگشت رشته.از عدد(i برگردان صحیح۶۴)
پایان
