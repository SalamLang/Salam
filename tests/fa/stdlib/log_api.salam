بسته ریشه

واردسازی گزارش
واردسازی سیستم پرونده.مسیر
واردسازی ورودی خروجی
واردسازی رشته
واردسازی سیستم عامل

تابع ساخت جفت(a: رشته، b: رشته): وکتور<رشته>:
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.بیفزا(a)
    v.بیفزا(b)
    برگشت v
پایان

تابع ریشه:
    گزارش.نمایش زمان(نادرست)
    گزارش.تنظیم سطح(گزارش.سطح اشکال زدایی)
    گزارش.به خروجی استاندارد()
    گزارش.تنظیم پیشوند("app")

    سرچاپ "format default: "، گزارش.دریافت قالب()
    گزارش.اشکال زدایی قالبی("loaded {} items"، ساخت جفت("3"، "unused"))
    گزارش.خطا قالبی("failed {} on {}"، ساخت جفت("write"، "disk"))
    گزارش.هشدار قالبی("careful {}"، ساخت جفت("now"، "unused"))
    گزارش.اطلاعات قالبی("hello {}"، ساخت جفت("world"، "unused"))

    کلیدها := ساخت جفت("user"، "role")
    مقادیر := ساخت جفت("ali"، "admin user")
    گزارش.اشکال زدایی با فیلد("debug kv"، کلیدها، مقادیر)
    گزارش.اطلاعات با فیلد("info kv"، کلیدها، مقادیر)
    گزارش.هشدار با فیلد("warn kv"، کلیدها، مقادیر)
    گزارش.خطا با فیلد("error kv"، کلیدها، مقادیر)

    گزارش.تنظیم قالب(گزارش.قالب جیسون)
    سرچاپ "format json: "، گزارش.دریافت قالب()
    گزارش.اطلاعات با فیلد("json kv"، کلیدها، مقادیر)
    گزارش.تنظیم قالب(گزارش.قالب متن)

    پوشه آزمون := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_log_api_test")
    سیستم عامل.حذف همه(پوشه آزمون)
    سیستم عامل.ساخت پوشه ها(پوشه آزمون)
    مسیر گزارش := مسیر.پیوند(پوشه آزمون، "app.log")

    سرچاپ "to file: "، گزارش.به پرونده(مسیر گزارش)
    گزارش.اطلاعات("into the file")
    گزارش.هشدار با فیلد("file kv"، کلیدها، مقادیر)
    گزارش.بستن پرونده()
    گزارش.اطلاعات("back on stdout")
    سرچاپ "file content:"
    چاپ ورودی خروجی.خواندن پرونده(مسیر گزارش)

    گزارش.تنظیم چرخش(60 برگردان صحیح۶۴، 2)
    سرچاپ "to file again: "، گزارش.به پرونده(مسیر گزارش)
    تکرار 6 در i:
        گزارش.اطلاعات قالبی("rotating line {}"، ساخت جفت(عدد به رشته(i)، "unused"))
    پایان
    گزارش.بستن پرونده()
    سرچاپ "rotated backup: "، سیستم عامل.وجود دارد(مسیر گزارش.پیوست(".1"))
    سرچاپ "second backup: "، سیستم عامل.وجود دارد(مسیر گزارش.پیوست(".2"))
    سرچاپ "no third backup: "، سیستم عامل.وجود دارد(مسیر گزارش.پیوست(".3"))

    سرچاپ "bad path: "، گزارش.به پرونده(مسیر.پیوند(پوشه آزمون، "missing/sub/app.log"))
    سیستم عامل.حذف همه(پوشه آزمون)
پایان

تابع عدد به رشته(i: صحیح): رشته:
    برگشت رشته.از عدد(i برگردان صحیح۶۴)
پایان
