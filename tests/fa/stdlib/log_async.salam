بسته ریشه

واردسازی گزارش

تابع ریشه:
    گزارش.نمایش زمان(نادرست)
    گزارش.تنظیم سطح(گزارش.سطح اشکال زدایی)
    گزارش.به خروجی استاندارد()
    گزارش.تنظیم پیشوند("async")

    started := گزارش.شروع ناهمگام(8 برگردان صحیح۶۴)
    again := گزارش.شروع ناهمگام(8 برگردان صحیح۶۴)
    گزارش.اشکال زدایی("one")
    گزارش.اطلاعات("two")
    گزارش.هشدار("three")
    گزارش.تخلیه()
    running := گزارش.ناهمگام است()

    گزارش.توقف ناهمگام()
    stopped := گزارش.ناهمگام است()

    restarted := گزارش.شروع ناهمگام(2 برگردان صحیح۶۴)
    گزارش.خطا("four")
    گزارش.توقف ناهمگام()

    سرچاپ "start:"، started
    سرچاپ "again:"، again
    سرچاپ "async:"، running
    سرچاپ "stopped:"، stopped
    سرچاپ "restart:"، restarted
    سرچاپ "done"
پایان
