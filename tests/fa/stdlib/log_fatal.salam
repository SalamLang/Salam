بسته ریشه

واردسازی گزارش
واردسازی سیستم پرونده.مسیر
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    dir := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_log_fatal_test")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    file := مسیر.پیوند(dir، "fatal.log")

    pid := فرآیند.انشعاب()
    اگر pid برابر 0:
        گزارش.نمایش زمان(نادرست)
        گزارش.به پرونده(file)
        گزارش.مهلک("cannot continue")
    پایان
    اگر pid کوچکتر 0:
        سرچاپ "fork unavailable"
        سیستم عامل.حذف همه(dir)
        برگشت 0
    پایان
    سرچاپ "child exit: "، فرآیند.انتظار شناسه(pid)
    چاپ ورودی خروجی.خواندن پرونده(file)
    سیستم عامل.حذف همه(dir)
    برگشت 0
پایان
