بسته ریشه

واردسازی گزارش
واردسازی سیستم پرونده.مسیر
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    پوشه آزمون := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_log_fatal_test")
    سیستم عامل.حذف همه(پوشه آزمون)
    سیستم عامل.ساخت پوشه ها(پوشه آزمون)
    مسیر گزارش := مسیر.پیوند(پوشه آزمون، "fatal.log")

    شناسه فرزند := فرآیند.انشعاب()
    اگر شناسه فرزند برابر 0:
        گزارش.نمایش زمان(نادرست)
        گزارش.به پرونده(مسیر گزارش)
        گزارش.مهلک("cannot continue")
    پایان
    اگر شناسه فرزند کوچکتر 0:
        سرچاپ "fork unavailable"
        سیستم عامل.حذف همه(پوشه آزمون)
        برگشت 0
    پایان
    سرچاپ "child exit: "، فرآیند.انتظار شناسه(شناسه فرزند)
    چاپ ورودی خروجی.خواندن پرونده(مسیر گزارش)
    سیستم عامل.حذف همه(پوشه آزمون)
    برگشت 0
پایان
