بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته

تابع text(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    تکرار n در i:
        line := "row " + رشته.از عدد((i * i) برگردان صحیح۶۴) + " streams through a window\n"
        فشرده سازی.افزودن بایت‌ها(b، line برگردان تهی*، line.طول())
    پایان
    برگشت b
پایان

تابع collect(p: تهی*، n: صحیح، c: تهی*): منطقی:
    فشرده سازی.افزودن بایت‌ها((c برگردان فشرده سازی.بافر بایت*)[0]، p، n)
    برگشت درست
پایان

تابع run(label: رشته، kind: صحیح، file: رشته، off: صحیح۶۴، len: صحیح۶۴، head: فشرده سازی.بافر بایت، want: فشرده سازی.بافر بایت، memcap: صحیح۶۴):
    fp := فشرده سازی.بازکردن پرونده برای خواندن(file)
    acc := حافظه.تخصیص صفرشده(اندازه‌گونه(فشرده سازی.بافر بایت)) برگردان فشرده سازی.بافر بایت*
    acc[0] = فشرده سازی.بافر بایت جدید()
    ناپایا sink := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، acc برگردان تهی*)
    ناپایا st := 0
    اگر kind برابر 1:
        st = فشرده سازی.کدگشایی الزد ام ای از پرونده به مقصد(head.داده، 5، fp، off، len، want.طول برگردان صحیح۶۴، sink، memcap)
    وگرنه:
        st = فشرده سازی.کدگشایی الزد ام ای۲ از پرونده به مقصد(فشرده سازی.دریافت بایت(head، 0)، fp، off، len، want.طول برگردان صحیح۶۴، sink، memcap)
    پایان
    فشرده سازی.بستن پرونده(fp)
    same := فشرده سازی.برابری بافر(acc[0]، want)
    سرچاپ label، "status"، st، "written"، sink.نوشته شده، "same"، same
    فشرده سازی.آزادسازی بافر(acc[0])
    حافظه.آزادسازی(acc برگردان تهی*)
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_lzma_stream_demo")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا want := text(4000)
    ناپایا lz := فشرده سازی.فشرده سازی الزد ام ای(want.داده، want.طول)
    lzpath := مسیر پرونده.پیوند(dir، "a.lzma")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(lzpath، lz)
    ناپایا props := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(props، lz.داده، 5)
    run("lzma"، 1، lzpath، 13 برگردان صحیح۶۴، (lz.طول - 13) برگردان صحیح۶۴، props، want، 0 برگردان صحیح۶۴)
    run("lzma memcap"، 1، lzpath، 13 برگردان صحیح۶۴، (lz.طول - 13) برگردان صحیح۶۴، props، want، 100 برگردان صحیح۶۴)
    run("lzma cut"، 1، lzpath، 13 برگردان صحیح۶۴، ((lz.طول - 13) / 2) برگردان صحیح۶۴، props، want، 0 برگردان صحیح۶۴)
    ناپایا xz := فشرده سازی.فشرده سازی ایکس زد(want.داده، want.طول)
    xzpath := مسیر پرونده.پیوند(dir، "a.xz")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(xzpath، xz)
    bh := (فشرده سازی.دریافت بایت(xz، 12) + 1) * 4
    flags := فشرده سازی.دریافت بایت(xz، 13)
    dictb := فشرده سازی.دریافت بایت(xz، 16)
    سرچاپ "xz block"، flags & 192، فشرده سازی.دریافت بایت(xz، 14)، dictb بزرگتربرابر 0
    ناپایا dp := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(dp، dictb)
    run("lzma2"، 2، xzpath، (12 + bh) برگردان صحیح۶۴، (xz.طول - 12 - bh) برگردان صحیح۶۴، dp، want، 0 برگردان صحیح۶۴)
    run("lzma2 memcap"، 2، xzpath، (12 + bh) برگردان صحیح۶۴، (xz.طول - 12 - bh) برگردان صحیح۶۴، dp، want، 100 برگردان صحیح۶۴)
    run("lzma2 cut"، 2، xzpath، (12 + bh) برگردان صحیح۶۴، ((xz.طول - 12 - bh) / 2) برگردان صحیح۶۴، dp، want، 0 برگردان صحیح۶۴)
    سیستم عامل.حذف همه(dir)
    فشرده سازی.آزادسازی بافر(want)
    فشرده سازی.آزادسازی بافر(lz)
    فشرده سازی.آزادسازی بافر(xz)
    فشرده سازی.آزادسازی بافر(props)
    فشرده سازی.آزادسازی بافر(dp)
    حافظه.آزادسازی(lzpath برگردان تهی*)
    حافظه.آزادسازی(xzpath برگردان تهی*)
    حافظه.آزادسازی(dir برگردان تهی*)
پایان
