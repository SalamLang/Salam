بسته ریشه

واردسازی ریاضی

تابع near(x: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(x * 1000000.0) / 1000000.0
پایان

تابع ریشه:
    سرچاپ "integers"
    سرچاپ ریاضی.قدرمطلق صحیح۶۴(0 - 9000000000 برگردان صحیح۶۴)، ریاضی.قدرمطلق صحیح۶۴(9000000000 برگردان صحیح۶۴)، ریاضی.قدرمطلق صحیح۶۴(0 برگردان صحیح۶۴)
    i64min := 0 - 9223372036854775807 برگردان صحیح۶۴ - 1
    i32min := 0 - 2147483647 - 1
    سرچاپ ریاضی.قدرمطلق صحیح۶۴(i64min)، ریاضی.قدرمطلق صحیح(i32min)، ریاضی.قدرمطلق صحیح(0 - 2147483647)

    سرچاپ "gcd and lcm at the minimum"
    سرچاپ ریاضی.ب م م۶۴(i64min، 4)، ریاضی.ب م م۶۴(4، i64min)، ریاضی.ب م م۶۴(i64min، 0 - 1)، ریاضی.ب م م۶۴(i64min، 6)
    سرچاپ ریاضی.ب م م۶۴(i64min، i64min)، ریاضی.ب م م۶۴(i64min، 0)، ریاضی.ب م م۶۴(0 - 48، 18)
    سرچاپ ریاضی.بزرگترین مقسوم علیه مشترک(i32min، 4)، ریاضی.بزرگترین مقسوم علیه مشترک(4، i32min)، ریاضی.بزرگترین مقسوم علیه مشترک(i32min، 0 - 1)، ریاضی.بزرگترین مقسوم علیه مشترک(i32min، i32min)
    سرچاپ ریاضی.کوچکترین مضرب مشترک(0 - 4، 6)، ریاضی.کوچکترین مضرب مشترک(i32min، 2)، ریاضی.کوچکترین مضرب مشترک(i32min، 3)، ریاضی.کوچکترین مضرب مشترک(65536، 65537)، ریاضی.کوچکترین مضرب مشترک(0، 5)
    سرچاپ ریاضی.فاکتوریل(20)، ریاضی.فاکتوریل(21)، ریاضی.فاکتوریل(0)

    سرچاپ "angles"
    سرچاپ near(ریاضی.رادیان(180.0))، near(ریاضی.رادیان(90.0))، near(ریاضی.رادیان(0.0 - 45.0))
    سرچاپ near(ریاضی.درجه(ریاضی.پی))، near(ریاضی.درجه(ریاضی.پی / 2.0))، near(ریاضی.درجه(0.0))
    سرچاپ near(ریاضی.درجه(ریاضی.رادیان(37.5)))

    سرچاپ "atan2 by quadrant"
    سرچاپ near(ریاضی.وارون تانژانت دو(1.0، 1.0))، near(ریاضی.وارون تانژانت دو(1.0، 0.0 - 1.0))
    سرچاپ near(ریاضی.وارون تانژانت دو(0.0 - 1.0، 0.0 - 1.0))، near(ریاضی.وارون تانژانت دو(0.0 - 1.0، 1.0))
    سرچاپ near(ریاضی.درجه(ریاضی.وارون تانژانت دو(0.0، 0.0 - 1.0)))، ریاضی.وارون تانژانت دو(0.0، 1.0)

    سرچاپ "hypotenuse"
    سرچاپ ریاضی.وتر(3.0، 4.0)، ریاضی.وتر(0.0 - 3.0، 4.0)، ریاضی.وتر(0.0، 0.0)
    سرچاپ near(ریاضی.وتر(1.0، 1.0))

    سرچاپ "clamping floats"
    سرچاپ ریاضی.محدودسازی اعشار(5.5، 0.0، 10.0)، ریاضی.محدودسازی اعشار(0.0 - 3.0، 0.0، 10.0)، ریاضی.محدودسازی اعشار(42.0، 0.0، 10.0)
    سرچاپ ریاضی.محدودسازی اعشار(0.0، 0.0، 0.0)، ریاضی.محدودسازی اعشار(0.5، 0.0، 1.0)
پایان
