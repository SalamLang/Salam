بسته ریشه

واردسازی ماتریس
واردسازی ریاضی

تابع rnd(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 1000.0) / 1000.0
پایان

تابع mk2(a: اعشار۶۴، b: اعشار۶۴، c: اعشار۶۴، d: اعشار۶۴): ماتریس.ماتریس:
    ناپایا m := ماتریس.صفرها(2، 2)
    m.تنظیم(0، 0، a)
    m.تنظیم(0، 1، b)
    m.تنظیم(1، 0، c)
    m.تنظیم(1، 1، d)
    برگشت m
پایان

تابع col(a: اعشار۶۴، b: اعشار۶۴): ماتریس.ماتریس:
    ناپایا m := ماتریس.صفرها(2، 1)
    m.تنظیم(0، 0، a)
    m.تنظیم(1، 0، b)
    برگشت m
پایان

تابع ریشه:
    ناپایا spd := mk2(4.0، 2.0، 2.0، 3.0)
    ناپایا l := ماتریس.چولسکی(spd)
    ناپایا rhs := col(10.0، 8.0)
    ناپایا x := ماتریس.حل چولسکی(l، rhs)
    سرچاپ "cholesky x: "، rnd(x.عنصر(0، 0))، rnd(x.عنصر(1، 0))
    ناپایا wrong := ماتریس.صفرها(3، 1)
    ناپایا none := ماتریس.حل چولسکی(l، wrong)
    سرچاپ "cholesky mismatch: "، none.سطرها، none.ستون‌ها

    ناپایا tall := ماتریس.صفرها(3، 2)
    tall.تنظیم(0، 0، 1.0)
    tall.تنظیم(0، 1، 0.0)
    tall.تنظیم(1، 0، 1.0)
    tall.تنظیم(1، 1، 1.0)
    tall.تنظیم(2، 0، 1.0)
    tall.تنظیم(2، 1، 2.0)
    ناپایا truth := col(1.0، 2.0)
    ناپایا b := ماتریس.ضرب ماتریسی(tall، truth)
    ناپایا f := ماتریس.تجزیه کیوآر(tall)
    ناپایا qx := ماتریس.حل کیوآر(f، b)
    سرچاپ "qr x: "، rnd(qx.عنصر(0، 0))، rnd(qx.عنصر(1، 0))
    ناپایا short := ماتریس.صفرها(2، 1)
    ناپایا qnone := ماتریس.حل کیوآر(f، short)
    سرچاپ "qr mismatch: "، qnone.سطرها، qnone.ستون‌ها

    ناپایا sym := mk2(2.0، 1.0، 1.0، 2.0)
    ناپایا es := ماتریس.مقادیر ویژه خودکار(sym)
    سرچاپ "symmetric: "، es.همگرا، es.اندازه
    lo := ریاضی.کمینه(es.جزء حقیقی.عنصر(0، 0)، es.جزء حقیقی.عنصر(0، 1))
    hi := ریاضی.بیشینه(es.جزء حقیقی.عنصر(0، 0)، es.جزء حقیقی.عنصر(0، 1))
    سرچاپ "symmetric values: "، rnd(lo)، rnd(hi)
    سرچاپ "symmetric imaginary zero: "، es.جزء موهومی.عنصر(0، 0) برابر 0.0 و es.جزء موهومی.عنصر(0، 1) برابر 0.0

    ناپایا rot := mk2(0.0، -1.0، 1.0، 0.0)
    ناپایا er := ماتریس.مقادیر ویژه خودکار(rot)
    سرچاپ "rotation: "، er.همگرا، er.اندازه
    سرچاپ "rotation real zero: "، rnd(er.جزء حقیقی.عنصر(0، 0))، rnd(er.جزء حقیقی.عنصر(0، 1))
    سرچاپ "rotation imaginary: "، rnd(ریاضی.قدرمطلق(er.جزء موهومی.عنصر(0، 0)))، rnd(ریاضی.قدرمطلق(er.جزء موهومی.عنصر(0، 1)))

    es.آزادسازی()
    er.آزادسازی()
    qnone.آزادسازی()
    short.آزادسازی()
    qx.آزادسازی()
    f.آزادسازی()
    b.آزادسازی()
    truth.آزادکن()
    tall.آزادسازی()
    none.آزادسازی()
    wrong.آزادسازی()
    x.آزادسازی()
    rhs.آزادکن()
    l.آزادسازی()
    spd.آزادکن()
    sym.آزادکن()
    rot.آزادکن()
پایان
