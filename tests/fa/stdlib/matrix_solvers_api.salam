بسته ریشه

واردسازی ماتریس
واردسازی ریاضی

تابع گرد کردن سه رقمی(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 1000.0) / 1000.0
پایان

تابع ساخت دوبعدی(a: اعشار۶۴، b: اعشار۶۴، c: اعشار۶۴، d: اعشار۶۴): ماتریس.ماتریس:
    ناپایا m := ماتریس.صفرها(2، 2)
    m.تنظیم(0، 0، a)
    m.تنظیم(0، 1، b)
    m.تنظیم(1، 0، c)
    m.تنظیم(1، 1، d)
    برگشت m
پایان

تابع ساخت ستونی(a: اعشار۶۴، b: اعشار۶۴): ماتریس.ماتریس:
    ناپایا m := ماتریس.صفرها(2، 1)
    m.تنظیم(0، 0، a)
    m.تنظیم(1، 0، b)
    برگشت m
پایان

تابع ریشه:
    ناپایا مثبت معین := ساخت دوبعدی(4.0، 2.0، 2.0، 3.0)
    ناپایا l := ماتریس.چولسکی(مثبت معین)
    ناپایا سمت راست := ساخت ستونی(10.0، 8.0)
    ناپایا x := ماتریس.حل چولسکی(l، سمت راست)
    سرچاپ "cholesky x: "، گرد کردن سه رقمی(x.عنصر(0، 0))، گرد کردن سه رقمی(x.عنصر(1، 0))
    ناپایا ناهمخوان := ماتریس.صفرها(3، 1)
    ناپایا حل ناسازگار := ماتریس.حل چولسکی(l، ناهمخوان)
    سرچاپ "cholesky mismatch: "، حل ناسازگار.سطرها، حل ناسازگار.ستون‌ها

    ناپایا بلند := ماتریس.صفرها(3، 2)
    بلند.تنظیم(0، 0، 1.0)
    بلند.تنظیم(0، 1، 0.0)
    بلند.تنظیم(1، 0، 1.0)
    بلند.تنظیم(1، 1، 1.0)
    بلند.تنظیم(2، 0، 1.0)
    بلند.تنظیم(2، 1، 2.0)
    ناپایا جواب واقعی := ساخت ستونی(1.0، 2.0)
    ناپایا b := ماتریس.ضرب ماتریسی(بلند، جواب واقعی)
    ناپایا f := ماتریس.تجزیه کیوآر(بلند)
    ناپایا جواب کیوآر := ماتریس.حل کیوآر(f، b)
    سرچاپ "qr x: "، گرد کردن سه رقمی(جواب کیوآر.عنصر(0، 0))، گرد کردن سه رقمی(جواب کیوآر.عنصر(1، 0))
    ناپایا سمت راست کوتاه := ماتریس.صفرها(2، 1)
    ناپایا کیوآر ناسازگار := ماتریس.حل کیوآر(f، سمت راست کوتاه)
    سرچاپ "qr mismatch: "، کیوآر ناسازگار.سطرها، کیوآر ناسازگار.ستون‌ها

    ناپایا متقارن := ساخت دوبعدی(2.0، 1.0، 1.0، 2.0)
    ناپایا مقادیر متقارن := ماتریس.مقادیر ویژه خودکار(متقارن)
    سرچاپ "symmetric: "، مقادیر متقارن.همگرا، مقادیر متقارن.اندازه
    کمینه := ریاضی.کمینه(مقادیر متقارن.جزء حقیقی.عنصر(0، 0)، مقادیر متقارن.جزء حقیقی.عنصر(0، 1))
    بیشینه := ریاضی.بیشینه(مقادیر متقارن.جزء حقیقی.عنصر(0، 0)، مقادیر متقارن.جزء حقیقی.عنصر(0، 1))
    سرچاپ "symmetric values: "، گرد کردن سه رقمی(کمینه)، گرد کردن سه رقمی(بیشینه)
    سرچاپ "symmetric imaginary zero: "، مقادیر متقارن.جزء موهومی.عنصر(0، 0) برابر 0.0 و مقادیر متقارن.جزء موهومی.عنصر(0، 1) برابر 0.0

    ناپایا چرخش := ساخت دوبعدی(0.0، -1.0، 1.0، 0.0)
    ناپایا مقادیر چرخش := ماتریس.مقادیر ویژه خودکار(چرخش)
    سرچاپ "rotation: "، مقادیر چرخش.همگرا، مقادیر چرخش.اندازه
    سرچاپ "rotation real zero: "، گرد کردن سه رقمی(مقادیر چرخش.جزء حقیقی.عنصر(0، 0))، گرد کردن سه رقمی(مقادیر چرخش.جزء حقیقی.عنصر(0، 1))
    سرچاپ "rotation imaginary: "، گرد کردن سه رقمی(ریاضی.قدرمطلق(مقادیر چرخش.جزء موهومی.عنصر(0، 0)))، گرد کردن سه رقمی(ریاضی.قدرمطلق(مقادیر چرخش.جزء موهومی.عنصر(0، 1)))

    مقادیر متقارن.آزادسازی()
    مقادیر چرخش.آزادسازی()
    کیوآر ناسازگار.آزادسازی()
    سمت راست کوتاه.آزادسازی()
    جواب کیوآر.آزادسازی()
    f.آزادسازی()
    b.آزادسازی()
    جواب واقعی.آزادکن()
    بلند.آزادسازی()
    حل ناسازگار.آزادسازی()
    ناهمخوان.آزادسازی()
    x.آزادسازی()
    سمت راست.آزادکن()
    l.آزادسازی()
    مثبت معین.آزادکن()
    متقارن.آزادکن()
    چرخش.آزادکن()
پایان
