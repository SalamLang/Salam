بسته نمایشی

واردسازی زمان
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا کلیدها := وکتور {} برگردان وکتور<رشته>
ناپایا کدها := وکتور {} برگردان وکتور<صحیح>
ناپایا بدنه‌ها := وکتور {} برگردان وکتور<رشته>
ناپایا مصرف‌شده‌ها := وکتور {} برگردان وکتور<منطقی>
ناپایا درخواست آخر := ""
ناپایا میزبان آخر := ""
ناپایا طول آخر := ""
ناپایا کلید تاخیر := ""
ناپایا میزان تاخیر := 0

تابع رسیدگی(دستگیره: صحیح۶۴):
    زمینه := اچ تی تی پی.زمینه جدید(دستگیره)
    روش := اچ تی تی پی.روش(زمینه)
    مسیر := اچ تی تی پی.مسیر(زمینه)
    رشته پرسش := اچ تی تی پی.پرسمان خام(زمینه)
    ناپایا هدف := مسیر
    اگر رشته پرسش.طول() بزرگتر 0: هدف = مسیر + "?" + رشته پرسش پایان
    درخواست آخر = روش + " " + هدف
    مجوز := اچ تی تی پی.سرصفحه(زمینه، "Authorization")
    اگر مجوز.طول() بزرگتر 0: درخواست آخر = درخواست آخر + "\n  مجوز: " + مجوز پایان
    نوع داده := اچ تی تی پی.سرصفحه(زمینه، "Content-Type")
    اگر نوع داده.طول() بزرگتر 0: درخواست آخر = درخواست آخر + "\n  نوع: " + نوع داده پایان
    بدنه := اچ تی تی پی.بدنه(زمینه)
    اگر بدنه.طول() بزرگتر 0: درخواست آخر = درخواست آخر + "\n  بدنه: " + بدنه پایان
    میزبان آخر = "میزبان " + اچ تی تی پی.سرصفحه(زمینه، "Host")
    طول آخر = "طول " + اچ تی تی پی.سرصفحه(زمینه، "Content-Length")
    کلید := روش + " " + مسیر
    اگر کلید برابر کلید تاخیر: زمان.خواب(میزان تاخیر) پایان
    ناپایا انتخاب := -1
    تکرار کلیدها.طول() در شماره:
        اگر انتخاب کوچکتر 0 و کلیدها.بگیر(شماره) برابر کلید و وارونه مصرف‌شده‌ها.بگیر(شماره):
            انتخاب = شماره
        پایان
    پایان
    اگر انتخاب کوچکتر 0:
        تکرار کلیدها.طول() در شماره:
            اگر کلیدها.بگیر(شماره) برابر کلید: انتخاب = شماره پایان
        پایان
    وگرنه:
        مصرف‌شده‌ها.بنشان(انتخاب، درست)
    پایان
    اگر انتخاب کوچکتر 0:
        اچ تی تی پی.تنظیم وضعیت(زمینه، 404)
        اچ تی تی پی.جیسون(زمینه، `{"message":"no route for ` + کلید + `","code":"not_found","type":"invalid_request","link":"https://docs.meilisearch.com/errors#not_found"}`)
        برگشت
    پایان
    اچ تی تی پی.تنظیم وضعیت(زمینه، کدها.بگیر(انتخاب))
    اچ تی تی پی.جیسون(زمینه، بدنه‌ها.بگیر(انتخاب))
پایان

همگانی تابع ثبت پاسخ(روش: رشته، مسیر: رشته، کد: صحیح، بدنه: رشته):
    کلیدها.بیفزا(روش + " " + مسیر)
    کدها.بیفزا(کد)
    بدنه‌ها.بیفزا(بدنه)
    مصرف‌شده‌ها.بیفزا(نادرست)
پایان

همگانی تابع آخرین(): رشته:
    برگشت درخواست آخر
پایان

همگانی تابع آخرین میزبان(): رشته:
    برگشت میزبان آخر
پایان

همگانی تابع آخرین طول(): رشته:
    برگشت طول آخر
پایان

همگانی تابع کند کن(روش: رشته، مسیر: رشته، میلی‌ثانیه: صحیح):
    کلید تاخیر = روش + " " + مسیر
    میزان تاخیر = میلی‌ثانیه
پایان

همگانی تابع شروع(شماره درگاه: صحیح): منطقی:
    ناپایا مسیرها := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(مسیرها، "/*"، رسیدگی)
    مسیریاب.ارسال(مسیرها، "/*"، رسیدگی)
    مسیریاب.قراردادن(مسیرها، "/*"، رسیدگی)
    مسیریاب.وصله(مسیرها، "/*"، رسیدگی)
    مسیریاب.حذف(مسیرها، "/*"، رسیدگی)
    سرور := اچ تی تی پی.سرور جدید(شماره درگاه)
    اچ تی تی پی.استفاده(سرور، مسیرها)
    برگشت اچ تی تی پی.اجرا در پس زمینه(سرور)
پایان
