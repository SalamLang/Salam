واردسازی دیتابیس.میلیسرچ
واردسازی رشته

فراخوانی نمایشی "../_fake.salam"

ناپایا درگاه := 0

تابع ریشه:
    نمایشی.ثبت پاسخ("GET"، "/health"، 200، `{"status":"available"}`)
    نمایشی.ثبت پاسخ("GET"، "/version"، 200، `{"commitSha":"4c4c06b","commitDate":"2026-09-30T12:00:00Z","pkgVersion":"1.55.0"}`)
    نمایشی.ثبت پاسخ("GET"، "/stats"، 200، `{"databaseSize":1048576,"usedDatabaseSize":524288,"lastUpdate":"2026-10-01T08:00:00Z","indexes":{"movies":{"numberOfDocuments":3,"isIndexing":false}}}`)
    درگاه = نمایشی.شروع آزاد()
    اگر درگاه برابر 0:
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان

    کارخواه := میلیسرچ.جدید("127.0.0.1:" + درگاه + "/"، "masterKey")
    سرچاپ "سرور: " + رشته.جایگزینی(کارخواه.میزبان، ":" + درگاه، ":PORT")
    ناپایا اشکال := میلیسرچ.خطا {}

    اگر وارونه میلیسرچ.سالم است(کارخواه):
        سرچاپ "میلی‌سرچ در دسترس نیست"
        برگشت 1
    پایان
    سرچاپ "سلامت: " + میلیسرچ.سلامت(کارخواه، اشکال)

    نسخه := میلیسرچ.دریافت نسخه(کارخواه، اشکال)
    سرچاپ "نسخه: " + نسخه.شماره نسخه + " (" + نسخه.شناسه کامیت + ")"

    آمار := میلیسرچ.دریافت آمار(کارخواه، اشکال)
    سرچاپ "بایت‌های پایگاه داده: " + آمار.اندازه پایگاه داده + "، در استفاده: " + آمار.اندازه به کار رفته
    سرچاپ "آخرین تغییر: " + آمار.آخرین تغییر

    برنامه := میلیسرچ.با عامل(کارخواه، "movie-shop/2.1")
    سرچاپ "عامل: " + برنامه.عامل
    سریع := میلیسرچ.با مهلت(کارخواه، 2000)
    سرچاپ "مهلت به میلی‌ثانیه: " + سریع.مهلت
    برگشت 0
پایان
