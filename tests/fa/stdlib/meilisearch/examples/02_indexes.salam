واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19821

تابع ریشه:
    نمایشی.ثبت پاسخ("POST"، "/indexes"، 202، `{"taskUid":1,"indexUid":"movies","status":"enqueued","type":"indexCreation","enqueuedAt":"2026-10-01T08:00:00Z"}`)
    نمایشی.ثبت پاسخ("GET"، "/tasks/1"، 200، `{"uid":1,"indexUid":"movies","status":"succeeded","type":"indexCreation","duration":"PT0.004S"}`)
    نمایشی.ثبت پاسخ("GET"، "/indexes/movies"، 200، `{"uid":"movies","primaryKey":"شناسه","createdAt":"2026-10-01T08:00:00Z","updatedAt":"2026-10-01T08:00:00Z"}`)
    نمایشی.ثبت پاسخ("GET"، "/indexes"، 200، `{"results":[{"uid":"books","primaryKey":"isbn"},{"uid":"movies","primaryKey":"شناسه"}],"offset":0,"limit":20,"total":2}`)
    نمایشی.ثبت پاسخ("PATCH"، "/indexes/movies"، 202، `{"taskUid":2,"indexUid":"movies","status":"enqueued","type":"indexUpdate"}`)
    نمایشی.ثبت پاسخ("POST"، "/swap-indexes"، 202، `{"taskUid":3,"indexUid":null,"status":"enqueued","type":"indexSwap"}`)
    نمایشی.ثبت پاسخ("GET"، "/indexes/movies/stats"، 200، `{"numberOfDocuments":3,"isIndexing":false,"fieldDistribution":{"شناسه":3,"عنوان":3,"ژانر":3}}`)
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/fields"، 200، `{"results":[{"name":"ژانر","displayed":{"enabled":true},"searchable":{"enabled":true},"sortable":{"enabled":false},"distinct":{"enabled":false},"filterable":{"enabled":true}},{"name":"عنوان","displayed":{"enabled":true},"searchable":{"enabled":true},"sortable":{"enabled":false},"distinct":{"enabled":false},"filterable":{"enabled":false}}],"offset":0,"limit":20,"total":2}`)
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/compact"، 202، `{"taskUid":4,"indexUid":"movies","status":"enqueued","type":"indexCompaction"}`)
    نمایشی.ثبت پاسخ("DELETE"، "/indexes/old_movies"، 202، `{"taskUid":5,"indexUid":"old_movies","status":"enqueued","type":"indexDeletion"}`)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    رسید := میلیسرچ.ایجاد نمایه(کارخواه، "movies"، "شناسه"، اشکال)
    کار := میلیسرچ.انتظار(کارخواه، رسید، اشکال)
    سرچاپ "ساخت movies: " + کار.وضعیت + " در " + کار.مدت

    نمایه := میلیسرچ.دریافت نمایه(کارخواه، "movies"، اشکال)
    سرچاپ "نمایه: " + نمایه.شناسه یکتا + "، کلید اصلی: " + نمایه.کلید اصلی

    صفحه := میلیسرچ.فهرست نمایه‌ها(کارخواه، 0، 20، اشکال)
    سرچاپ "نمایه‌ها: " + صفحه.کل
    هر مورد در صفحه.نتیجه‌ها:
        سرچاپ "  " + مورد.شناسه یکتا + " (" + مورد.کلید اصلی + ")"
    پایان

    سرچاپ "کار تغییر نام: " + میلیسرچ.تغییر نام نمایه(کارخواه، "movies"، "films"، اشکال).نوع

    ناپایا جابجایی‌ها := وکتور {} برگردان وکتور<میلیسرچ.جابجایی نمایه>
    جابجایی‌ها.بیفزا(میلیسرچ.جابجایی نمایه { نخست = "movies"، دوم = "movies_rebuilt" })
    سرچاپ "کار جابجایی: " + میلیسرچ.جابجایی نمایه‌ها(کارخواه، جابجایی‌ها، اشکال).نوع

    آمار := میلیسرچ.دریافت آمار نمایه(کارخواه، "movies"، اشکال)
    سرچاپ "سندها: " + آمار.تعداد سندها + "، فیلدها: " + آمار.توزیع فیلد

    فیلدها := میلیسرچ.فهرست فیلدها(کارخواه، "movies"، میلیسرچ.پرسش فیلدها {}، اشکال)
    هر فیلد در فیلدها.نتیجه‌ها:
        سرچاپ "فیلد " + فیلد.نام + ": قابل جستجو=" + فیلد.قابل جستجو + " قابل فیلتر=" + فیلد.قابل فیلتر
    پایان

    سرچاپ "کار فشرده‌سازی: " + میلیسرچ.فشرده‌سازی نمایه(کارخواه، "movies"، اشکال).نوع
    سرچاپ "کار حذف: " + میلیسرچ.حذف نمایه(کارخواه، "old_movies"، اشکال).نوع
    برگشت 0
پایان
