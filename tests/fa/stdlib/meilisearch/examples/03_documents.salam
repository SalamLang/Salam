واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19822

ساختار فیلم:
    همگانی شناسه: صحیح = 0
    همگانی عنوان: رشته = ""
    همگانی ژانر: رشته = ""
    همگانی سال: صحیح = 0
پایان

تابع ریشه:
    صف شده := `{"taskUid":10,"indexUid":"movies","status":"enqueued","type":"documentAdditionOrUpdate"}`
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/documents"، 202، صف شده)
    نمایشی.ثبت پاسخ("PUT"، "/indexes/movies/documents"، 202، صف شده)
    نمایشی.ثبت پاسخ("GET"، "/tasks/10"، 200، `{"uid":10,"indexUid":"movies","status":"succeeded","type":"documentAdditionOrUpdate","details":{"receivedDocuments":3,"indexedDocuments":3}}`)
    نمایشی.ثبت پاسخ("GET"، "/indexes/movies/documents/2"، 200، `{"شناسه":2,"عنوان":"Moana","ژانر":"Family","سال":2016}`)
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/documents/fetch"، 200، `{"results":[{"شناسه":1,"عنوان":"Heat","ژانر":"Crime","سال":1995},{"شناسه":2,"عنوان":"Moana","ژانر":"Family","سال":2016}],"offset":0,"limit":2,"total":3}`)
    نمایشی.ثبت پاسخ("DELETE"، "/indexes/movies/documents/3"، 202، `{"taskUid":11,"indexUid":"movies","status":"enqueued","type":"documentDeletion"}`)
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/documents/delete"، 202، `{"taskUid":12,"indexUid":"movies","status":"enqueued","type":"documentDeletion"}`)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    سندها := `[{"شناسه": 1, "عنوان": "Heat", "ژانر": "Crime", "سال": 1995}, {"شناسه": 2, "عنوان": "Moana", "ژانر": "Family", "سال": 2016}, {"شناسه": 3, "عنوان": "Alien", "ژانر": "Horror", "سال": 1979}]`
    کار := میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندها(کارخواه، "movies"، سندها، "شناسه"، اشکال)، اشکال)
    سرچاپ "افزودن: " + کار.وضعیت + " " + کار.جزئیات

    ناپایا فیلم‌ها := وکتور {} برگردان وکتور<فیلم>
    فیلم‌ها.بیفزا(فیلم { شناسه = 4، عنوان = "Up"، ژانر = "Family"، سال = 2009 })
    میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندهای نوع(کارخواه، "movies"، فیلم‌ها، "شناسه"، اشکال)، اشکال)
    سرچاپ "افزودن نوع‌دار فرستاده شد: " + (نمایشی.آخرین().طول() بزرگتر 0)

    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی سندها(کارخواه، "movies"، `[{"شناسه": 1, "سال": 1996}]`، ""، اشکال)، اشکال)
    سرچاپ "به‌روزرسانی بخشی: " + میلیسرچ.موفق(اشکال)

    ناپایا اثر := فیلم {}
    اگر میلیسرچ.دریافت سند به نوع(کارخواه، "movies"، "2"، اثر، اشکال):
        سرچاپ "سند ۲: " + اثر.عنوان + " (" + اثر.سال + ")"
    پایان

    ناپایا پرسش := میلیسرچ.پرسش سند { حد = 2، فیلتر = "سال > 1990" }
    پرسش.فیلدها.بیفزا("عنوان")
    صفحه := میلیسرچ.دریافت سندها(کارخواه، "movies"، پرسش، اشکال)
    ناپایا یافته‌ها := وکتور {} برگردان وکتور<فیلم>
    میلیسرچ.سندها به نوع(صفحه، یافته‌ها، اشکال)
    سرچاپ "صفحه از " + صفحه.کل + ":"
    هر مورد در یافته‌ها:
        سرچاپ "  " + مورد.شناسه + " " + مورد.عنوان
    پایان

    سرچاپ "حذف یکی: " + میلیسرچ.حذف سند(کارخواه، "movies"، "3"، اشکال).نوع
    سرچاپ "حذف قدیمی‌ها: " + میلیسرچ.حذف سندها با فیلتر(کارخواه، "movies"، "سال < 1980"، اشکال).نوع
    برگشت 0
پایان
