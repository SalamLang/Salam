واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19823

تابع ریشه:
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/documents"، 202، `{"taskUid":20,"indexUid":"movies","status":"enqueued","type":"documentAdditionOrUpdate","customMetadata":"nightly-import"}`)
    نمایشی.ثبت پاسخ("PUT"، "/indexes/movies/documents"، 202، `{"taskUid":21,"indexUid":"movies","status":"enqueued","type":"documentAdditionOrUpdate"}`)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    ان‌دی‌جیسون := "{\"شناسه\": 5, \"عنوان\": \"Arrival\"}\n{\"شناسه\": 6, \"عنوان\": \"Dune\"}\n"
    میلیسرچ.افزودن سندهای ان‌دی‌جیسون(کارخواه، "movies"، ان‌دی‌جیسون، "شناسه"، اشکال)
    سرچاپ "ان‌دی‌جیسون: " + نمایشی.آخرین()

    سی‌اس‌وی := "شناسه;عنوان;سال:number\n7;Heat;1995\n"
    میلیسرچ.افزودن سندهای سی‌اس‌وی(کارخواه، "movies"، سی‌اس‌وی، "شناسه"، ";"، اشکال)
    سرچاپ "سی‌اس‌وی: " + نمایشی.آخرین()

    ناپایا انبوه := وکتور {} برگردان وکتور<رشته>
    تکرار 5 در شماره:
        انبوه.بیفزا(`{"شناسه": ` + (100 + شماره) + `, "عنوان": "Movie ` + شماره + `"}`)
    پایان
    کارها := میلیسرچ.افزودن سندها در دسته‌ها(کارخواه، "movies"، انبوه، 2، "شناسه"، اشکال)
    سرچاپ "دسته‌های فرستاده: " + کارها.طول()

    برچسب‌خورده := میلیسرچ.با فراداده(کارخواه، "nightly-import")
    رسید := میلیسرچ.افزودن سندها(برچسب‌خورده، "movies"، `[{"شناسه": 8, "عنوان": "Up"}]`، ""، اشکال)
    سرچاپ "کار برچسب‌دار: " + رسید.شناسه کار + " " + رسید.فراداده سفارشی

    گزینه‌ها := میلیسرچ.گزینه‌های سند { ادغام = درست، بدون ساخت = درست }
    میلیسرچ.افزودن سندها با گزینه(کارخواه، "movies"، `[{"شناسه": 8, "سال": 2009}]`، گزینه‌ها، اشکال)
    سرچاپ "فقط به‌روزرسانی موجودها: " + نمایشی.آخرین()
    برگشت 0
پایان
