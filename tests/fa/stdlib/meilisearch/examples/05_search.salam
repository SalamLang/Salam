واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19824

ساختار فیلم:
    همگانی شناسه: صحیح = 0
    همگانی عنوان: رشته = ""
    همگانی ژانر: رشته = ""
    همگانی سال: صحیح = 0
پایان

تابع ریشه:
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/search"، 200، `{"hits":[{"شناسه":3,"عنوان":"Alien","ژانر":"Horror","سال":1979},{"شناسه":9,"عنوان":"Aliens","ژانر":"Action","سال":1986}],"query":"alien","processingTimeMs":2,"limit":20,"offset":0,"estimatedTotalHits":2}`)
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/search"، 200، `{"hits":[{"شناسه":2,"عنوان":"Moana","ژانر":"Family","سال":2016,"_formatted":{"عنوان":"<em>Moana</em>"}}],"query":"moana","processingTimeMs":1,"limit":5,"offset":0,"estimatedTotalHits":1,"facetDistribution":{"ژانر":{"Family":1}}}`)
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/search"، 200، `{"hits":[{"شناسه":4,"عنوان":"Up","ژانر":"Family","سال":2009}],"query":"","processingTimeMs":1,"hitsPerPage":1,"page":2,"totalHits":3,"totalPages":3}`)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "searchKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    نتیجه := میلیسرچ.پرسش(کارخواه، "movies"، "alien"، اشکال)
    سرچاپ "\"" + نتیجه.پرسش + "\": " + نتیجه.تخمین کل نتایج + " نتیجه در " + نتیجه.زمان پردازش + " میلی‌ثانیه"
    ناپایا فیلم‌ها := وکتور {} برگردان وکتور<فیلم>
    میلیسرچ.نتایج به نوع(نتیجه، فیلم‌ها، اشکال)
    هر اثر در فیلم‌ها:
        سرچاپ "  " + اثر.عنوان + " (" + اثر.سال + ")"
    پایان

    ناپایا جستار := میلیسرچ.درخواست جستجو { پرسش = "moana"، حد = 5، فیلتر = "سال > 2000 AND ژانر = Family" }
    جستار.مرتب‌سازی.بیفزا("سال:desc")
    جستار.وجه‌ها.بیفزا("ژانر")
    جستار.ویژگی‌های برجسته.بیفزا("عنوان")
    جستار.راهبرد تطبیق = میلیسرچ.تطبیق همه
    فیلترشده := میلیسرچ.جستجو(کارخواه، "movies"، جستار، اشکال)
    سرچاپ "فیلترشده: " + فیلترشده.نتایج.بگیر(0)
    سرچاپ "وجه‌ها: " + فیلترشده.توزیع وجه

    صفحه‌بندی‌شده := میلیسرچ.جستجو(کارخواه، "movies"، میلیسرچ.درخواست جستجو { شماره صفحه = 2، نتایج صفحه = 1 }، اشکال)
    سرچاپ "صفحه " + صفحه‌بندی‌شده.شماره صفحه + " از " + صفحه‌بندی‌شده.کل صفحه‌ها + " (" + صفحه‌بندی‌شده.کل نتایج + " نتیجه)"
    برگشت 0
پایان
