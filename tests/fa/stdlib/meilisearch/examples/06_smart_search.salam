واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19825

تابع ریشه:
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/search"، 200، `{"hits":[{"شناسه":5,"عنوان":"Arrival"}],"query":"aliens who talk","processingTimeMs":8,"limit":20,"offset":0,"estimatedTotalHits":1,"semanticHitCount":1}`)
    نمایشی.ثبت پاسخ("POST"، "/multi-search"، 200، `{"results":[{"indexUid":"movies","hits":[{"شناسه":2}],"query":"moana","processingTimeMs":1,"limit":20,"offset":0,"estimatedTotalHits":1},{"indexUid":"books","hits":[],"query":"moana","processingTimeMs":0,"limit":20,"offset":0,"estimatedTotalHits":0}]}`)
    نمایشی.ثبت پاسخ("POST"، "/multi-search"، 200، `{"hits":[{"شناسه":2,"_federation":{"indexUid":"movies"}},{"شناسه":41,"_federation":{"indexUid":"books"}}],"processingTimeMs":2,"limit":10,"offset":0,"estimatedTotalHits":2}`)
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/facet-search"، 200، `{"facetHits":[{"value":"Family","count":2},{"value":"Fantasy","count":1}],"facetQuery":"fa","processingTimeMs":0}`)
    نمایشی.ثبت پاسخ("POST"، "/indexes/movies/similar"، 200، `{"hits":[{"شناسه":6,"عنوان":"Dune"}],"شناسه":"5","processingTimeMs":3,"limit":3,"offset":0,"estimatedTotalHits":1}`)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "searchKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    ترکیبی := میلیسرچ.درخواست جستجو { پرسش = "aliens who talk"، جاساز ترکیبی = "default"، نسبت معنایی = 0.8 }
    نتیجه := میلیسرچ.جستجو(کارخواه، "movies"، ترکیبی، اشکال)
    سرچاپ "ترکیبی: " + نتیجه.نتایج.بگیر(0) + "، بر پایه معنا: " + نتیجه.شمار نتایج معنایی

    ناپایا پرسش‌ها := وکتور {} برگردان وکتور<میلیسرچ.پرسش چندگانه>
    پرسش‌ها.بیفزا(میلیسرچ.پرسش چندگانه { نمایه = "movies"، درخواست = میلیسرچ.درخواست جستجو { پرسش = "moana" } })
    پرسش‌ها.بیفزا(میلیسرچ.پرسش چندگانه { نمایه = "books"، درخواست = میلیسرچ.درخواست جستجو { پرسش = "moana" } })
    هر تک در میلیسرچ.جستجوی چندگانه(کارخواه، پرسش‌ها، اشکال):
        سرچاپ "چندگانه " + تک.نمایه + ": " + تک.نتایج.طول()
    پایان

    ادغام‌شده := میلیسرچ.جستجوی فدرال(کارخواه، پرسش‌ها، میلیسرچ.فدراسیون { حد = 10 }، اشکال)
    سرچاپ "فدرال: " + ادغام‌شده.نتایج.طول() + " نتیجه"

    وجه‌ها := میلیسرچ.جستجوی وجه(کارخواه، "movies"، میلیسرچ.درخواست جستجوی وجه { نام وجه = "ژانر"، پرسش وجه = "fa" }، اشکال)
    هر وجه در وجه‌ها.نتایج:
        سرچاپ "ژانر " + وجه.مقدار + ": " + وجه.شمار
    پایان

    مشابه := میلیسرچ.سندهای مشابه(کارخواه، "movies"، میلیسرچ.درخواست مشابه { شناسه = "5"، جاساز = "default"، حد = 3 }، اشکال)
    سرچاپ "شبیه Arrival: " + مشابه.نتایج.بگیر(0)
    برگشت 0
پایان
