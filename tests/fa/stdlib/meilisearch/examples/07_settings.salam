واردسازی دیتابیس.میلیسرچ
واردسازی رشته

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19826

تابع ریشه:
    صف شده := `{"taskUid":30,"indexUid":"movies","status":"enqueued","type":"settingsUpdate"}`
    پایه := "/indexes/movies/settings"
    نمایشی.ثبت پاسخ("PATCH"، پایه، 202، صف شده)
    نمایشی.ثبت پاسخ("GET"، "/tasks/30"، 200، `{"uid":30,"indexUid":"movies","status":"succeeded","type":"settingsUpdate"}`)
    نمایشی.ثبت پاسخ("GET"، پایه، 200، `{"filterableAttributes":["ژانر","سال"],"sortableAttributes":["سال"],"stopWords":["the"]}`)
    نمایشی.ثبت پاسخ("PUT"، پایه + "/filterable-attributes"، 202، صف شده)
    نمایشی.ثبت پاسخ("GET"، پایه + "/filterable-attributes"، 200، `["ژانر","سال"]`)
    نمایشی.ثبت پاسخ("PUT"، پایه + "/sortable-attributes"، 202، صف شده)
    نمایشی.ثبت پاسخ("PUT"، پایه + "/ranking-rules"، 202، صف شده)
    نمایشی.ثبت پاسخ("PUT"، پایه + "/synonyms"، 202، صف شده)
    نمایشی.ثبت پاسخ("PATCH"، پایه + "/typo-tolerance"، 202، صف شده)
    نمایشی.ثبت پاسخ("PUT"، پایه + "/distinct-attribute"، 202، صف شده)
    نمایشی.ثبت پاسخ("GET"، پایه + "/search-cutoff-ms"، 200، `150`)
    نمایشی.ثبت پاسخ("DELETE"، پایه + "/stop-words"، 202، صف شده)
    نمایشی.ثبت پاسخ("DELETE"، پایه، 202، صف شده)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    کار := میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی تنظیمات(کارخواه، "movies"، `{"filterableAttributes": ["ژانر", "سال"], "stopWords": ["the"]}`، اشکال)، اشکال)
    سرچاپ "تنظیمات: " + کار.وضعیت
    سرچاپ "همه: " + میلیسرچ.دریافت تنظیمات(کارخواه، "movies"، اشکال)

    ناپایا قابل فیلتر := وکتور {} برگردان وکتور<رشته>
    قابل فیلتر.بیفزا("ژانر")
    قابل فیلتر.بیفزا("سال")
    میلیسرچ.به‌روزرسانی ویژگی‌های قابل فیلتر(کارخواه، "movies"، قابل فیلتر، اشکال)
    سرچاپ "قابل فیلتر: " + رشته.بپیوند(میلیسرچ.دریافت ویژگی‌های قابل فیلتر(کارخواه، "movies"، اشکال)، ", ")

    ناپایا قابل مرتب‌سازی := وکتور {} برگردان وکتور<رشته>
    قابل مرتب‌سازی.بیفزا("سال")
    میلیسرچ.به‌روزرسانی ویژگی‌های قابل مرتب‌سازی(کارخواه، "movies"، قابل مرتب‌سازی، اشکال)

    ناپایا قاعده‌ها := وکتور {} برگردان وکتور<رشته>
    قاعده‌ها.بیفزا("words")
    قاعده‌ها.بیفزا("typo")
    قاعده‌ها.بیفزا("سال:desc")
    میلیسرچ.به‌روزرسانی قواعد رتبه‌بندی(کارخواه، "movies"، قاعده‌ها، اشکال)
    سرچاپ "قاعده‌های رتبه‌بندی: " + نمایشی.آخرین()

    میلیسرچ.به‌روزرسانی مترادف‌ها(کارخواه، "movies"، `{"film": ["movie"], "movie": ["film"]}`، اشکال)
    میلیسرچ.به‌روزرسانی تحمل غلط املایی(کارخواه، "movies"، `{"minWordSizeForTypos": {"oneTypo": 4}}`، اشکال)
    میلیسرچ.به‌روزرسانی ویژگی متمایز(کارخواه، "movies"، "عنوان"، اشکال)
    سرچاپ "مهلت جستجو به میلی‌ثانیه: " + میلیسرچ.دریافت مهلت جستجو(کارخواه، "movies"، اشکال)
    سرچاپ "بازنشانی کلمات توقف: " + میلیسرچ.بازنشانی کلمات توقف(کارخواه، "movies"، اشکال).نوع
    سرچاپ "بازنشانی همه: " + میلیسرچ.بازنشانی تنظیمات(کارخواه، "movies"، اشکال).نوع
    برگشت 0
پایان
