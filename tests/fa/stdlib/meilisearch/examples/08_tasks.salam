واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19827

تابع ریشه:
    نمایشی.ثبت پاسخ("GET"، "/tasks/40"، 200، `{"uid":40,"indexUid":"movies","status":"processing","type":"documentAdditionOrUpdate"}`)
    نمایشی.ثبت پاسخ("GET"، "/tasks/40"، 200، `{"uid":40,"batchUid":7,"indexUid":"movies","status":"succeeded","type":"documentAdditionOrUpdate","duration":"PT0.120S","details":{"indexedDocuments":1000}}`)
    نمایشی.ثبت پاسخ("GET"، "/tasks/41"، 200، `{"uid":41,"indexUid":"movies","status":"failed","type":"settingsUpdate","error":{"message":"Attribute ` + "`rating`" + ` is not filterable.","code":"invalid_search_filter","type":"invalid_request","link":"https://docs.meilisearch.com/errors#invalid_search_filter"}}`)
    نمایشی.ثبت پاسخ("GET"، "/tasks"، 200، `{"results":[{"uid":41,"indexUid":"movies","status":"failed","type":"settingsUpdate"},{"uid":40,"indexUid":"movies","status":"succeeded","type":"documentAdditionOrUpdate"}],"total":2,"limit":20,"from":41,"next":null}`)
    نمایشی.ثبت پاسخ("POST"، "/tasks/cancel"، 200، `{"taskUid":42,"indexUid":null,"status":"enqueued","type":"taskCancelation"}`)
    نمایشی.ثبت پاسخ("DELETE"، "/tasks"، 200، `{"taskUid":43,"indexUid":null,"status":"enqueued","type":"taskDeletion"}`)
    نمایشی.ثبت پاسخ("GET"، "/batches/7"، 200، `{"uid":7,"stats":{"totalNbTasks":1,"status":{"succeeded":1}},"duration":"PT0.121S","batchStrategy":"batched all enqueued tasks"}`)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    انجام‌شده := میلیسرچ.انتظار برای کار(کارخواه، 40، 10000، 10، اشکال)
    سرچاپ "کار ۴۰: " + انجام‌شده.وضعیت + " در " + انجام‌شده.مدت + " " + انجام‌شده.جزئیات

    شکست‌خورده := میلیسرچ.انتظار برای کار(کارخواه، 41، 10000، 10، اشکال)
    سرچاپ "کار ۴۱: " + شکست‌خورده.وضعیت
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ "خطا: " + اشکال.کد + ": " + اشکال.پیام
    پایان

    ناپایا پرسش := میلیسرچ.پرسش کار { حد = 20 }
    پرسش.نمایه‌ها.بیفزا("movies")
    پرسش.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت موفق)
    پرسش.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت ناموفق)
    صفحه := میلیسرچ.دریافت کارها(کارخواه، پرسش، اشکال)
    سرچاپ "کارها: " + صفحه.کل
    هر کار در صفحه.نتیجه‌ها:
        سرچاپ "  " + کار.شناسه یکتا + " " + کار.نوع + " " + کار.وضعیت
    پایان

    ناپایا معوق := میلیسرچ.پرسش کار {}
    معوق.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت در صف)
    سرچاپ "لغو: " + میلیسرچ.لغو کارها(کارخواه، معوق، اشکال).نوع
    ناپایا قدیمی := میلیسرچ.پرسش کار { اتمام پیش از = "2026-01-01T00:00:00Z" }
    قدیمی.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت موفق)
    سرچاپ "پاک‌سازی: " + میلیسرچ.حذف کارها(کارخواه، قدیمی، اشکال).نوع

    دسته := میلیسرچ.دریافت دسته(کارخواه، انجام‌شده.شناسه دسته، اشکال)
    سرچاپ "دسته " + دسته.شناسه یکتا + ": " + دسته.راهبرد دسته
    برگشت 0
پایان
