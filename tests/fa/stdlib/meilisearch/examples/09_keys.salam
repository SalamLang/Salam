واردسازی دیتابیس.میلیسرچ
واردسازی جی دبلیو تی
واردسازی رشته

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19828

تابع ریشه:
    ساخته‌شده := `{"name":"Web search","description":"Search only","key":"web-search-key","uid":"aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee","actions":["search"],"indexes":["movies"],"expiresAt":null,"createdAt":"2026-10-01T08:00:00Z","updatedAt":"2026-10-01T08:00:00Z"}`
    نمایشی.ثبت پاسخ("POST"، "/keys"، 201، ساخته‌شده)
    نمایشی.ثبت پاسخ("GET"، "/keys"، 200، `{"results":[` + ساخته‌شده + `],"offset":0,"limit":20,"total":1}`)
    نمایشی.ثبت پاسخ("PATCH"، "/keys/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"، 200، ساخته‌شده)
    نمایشی.ثبت پاسخ("DELETE"، "/keys/aaaaaaaa-bbbb-cccc-dddd-eeeeeeeeeeee"، 204، ``)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    مدیر := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    ناپایا جستار := میلیسرچ.درخواست کلید { نام = "جستجوی وب"، توضیح = "فقط جستجو" }
    جستار.کنش‌ها.بیفزا("search")
    جستار.نمایه‌های مجاز.بیفزا("movies")
    کلید := میلیسرچ.ایجاد کلید(مدیر، جستار، اشکال)
    سرچاپ "کلید: " + کلید.نام + " می‌تواند " + رشته.بپیوند(کلید.کنش‌ها، ",") + " روی " + رشته.بپیوند(کلید.نمایه‌های مجاز، ",")

    صفحه := میلیسرچ.دریافت کلیدها(مدیر، 0، 20، اشکال)
    سرچاپ "کلیدها: " + صفحه.کل
    میلیسرچ.به‌روزرسانی کلید(مدیر، کلید.شناسه یکتا، "جستجوی وب"، "فقط جستجو، فقط movies"، اشکال)
    سرچاپ "به‌روز شد: " + میلیسرچ.موفق(اشکال)

    قاعده‌ها := `{"movies": {"filter": "user_id = 42"}}`
    توکن := میلیسرچ.توکن مستاجر(کلید.شناسه یکتا، کلید.کلید، قاعده‌ها، 0، اشکال)
    ناپایا کد := 0
    بررسی‌شده := جی دبلیو تی.تایید اچ اس۲۵۶(توکن، کلید.کلید، کد)
    سرچاپ "توکن مستاجر معتبر: " + جی دبلیو تی.معتبر است(توکن، کلید.کلید، جی دبلیو تی.گزینه های پیش فرض()) + "، قاعده‌ها: " + جی دبلیو تی.خام(بررسی‌شده، "searchRules")
    کاربر := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، توکن)
    سرچاپ "کارخواه کاربر آماده: " + (کاربر.کلید دسترسی.طول() بزرگتر 0)

    سرچاپ "حذف شد: " + میلیسرچ.حذف کلید(مدیر، کلید.شناسه یکتا، اشکال)
    برگشت 0
پایان
