واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19829

تابع ریشه:
    ساخته‌شده := `{"uuid":"11111111-2222-3333-4444-555555555555","url":"https://shop.example/hooks/meili","headers":{"X-Shop":"1"},"isEditable":true}`
    نمایشی.ثبت پاسخ("POST"، "/webhooks"، 201، ساخته‌شده)
    نمایشی.ثبت پاسخ("GET"، "/webhooks"، 200، `{"results":[` + ساخته‌شده + `]}`)
    نمایشی.ثبت پاسخ("PATCH"، "/webhooks/11111111-2222-3333-4444-555555555555"، 200، `{"uuid":"11111111-2222-3333-4444-555555555555","url":"https://shop.example/hooks/v2","headers":{"X-Shop":"1"},"isEditable":true}`)
    نمایشی.ثبت پاسخ("DELETE"، "/webhooks/11111111-2222-3333-4444-555555555555"، 204، ``)
    نمایشی.ثبت پاسخ("PATCH"، "/dynamic-search-rules/black-friday"، 202، `{"taskUid":50,"indexUid":null,"status":"enqueued","type":"dynamicSearchRulesUpdate"}`)
    نمایشی.ثبت پاسخ("POST"، "/dynamic-search-rules"، 200، `{"results":[{"uid":"black-friday","active":true,"precedence":1,"conditions":{"query":{"words":"sale"}},"actions":{"pin":[{"id":"42","position":0}]}}],"offset":0,"limit":20,"total":1}`)
    نمایشی.ثبت پاسخ("DELETE"، "/dynamic-search-rules/black-friday"، 202، `{"taskUid":51,"indexUid":null,"status":"enqueued","type":"dynamicSearchRulesDeletion"}`)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    هوک := میلیسرچ.ایجاد وب هوک(کارخواه، "https://shop.example/hooks/meili"، `{"X-Shop": "1"}`، اشکال)
    سرچاپ "وب‌هوک: " + هوک.نشانی + " قابل ویرایش=" + هوک.قابل ویرایش
    سرچاپ "وب‌هوک‌ها: " + میلیسرچ.فهرست وب هوک‌ها(کارخواه، اشکال).طول()
    منتقل‌شده := میلیسرچ.به‌روزرسانی وب هوک(کارخواه، هوک.شناسه جهانی، "https://shop.example/hooks/v2"، ""، اشکال)
    سرچاپ "منتقل شد به: " + منتقل‌شده.نشانی
    سرچاپ "وب‌هوک حذف شد: " + میلیسرچ.حذف وب هوک(کارخواه، هوک.شناسه جهانی، اشکال)

    سنجاق := `{"active": true, "precedence": 1, "conditions": {"query": {"words": "sale"}}, "actions": {"pin": [{"id": "42", "position": 0}]}}`
    سرچاپ "قاعده ذخیره شد: " + میلیسرچ.به‌روزرسانی قاعده جستجو(کارخواه، "black-friday"، سنجاق، اشکال).نوع
    قاعده‌ها := میلیسرچ.فهرست قاعده‌های جستجو(کارخواه، میلیسرچ.پرسش قاعده جستجو { فعال = 1 }، اشکال)
    هر قاعده در قاعده‌ها.نتیجه‌ها:
        سرچاپ "قاعده " + قاعده.شناسه یکتا + " فعال=" + قاعده.فعال + " سنجاق می‌کند " + قاعده.کنش‌ها
    پایان
    سرچاپ "قاعده حذف شد: " + میلیسرچ.حذف قاعده جستجو(کارخواه، "black-friday"، اشکال).نوع
    برگشت 0
پایان
