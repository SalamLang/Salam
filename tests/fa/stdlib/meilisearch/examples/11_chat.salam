واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19830

تابع ریشه:
    نمایشی.ثبت پاسخ("PATCH"، "/chats/support/settings"، 200، `{"source":"openAi","apiKey":"XXX...","prompts":{"system":"You help customers find movies."}}`)
    نمایشی.ثبت پاسخ("GET"، "/chats"، 200، `{"results":[{"uid":"support"}],"offset":0,"limit":20,"total":1}`)
    نمایشی.ثبت پاسخ("POST"، "/chats/support/chat/completions"، 200، "data: {\"choices\":[{\"delta\":{\"content\":\"Try Arrival.\"}}]}\n\ndata: [DONE]\n\n")
    نمایشی.ثبت پاسخ("DELETE"، "/chats/support"، 204، ``)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    تنظیمات := `{"source": "openAi", "apiKey": "sk-your-key", "prompts": {"system": "You help customers find movies."}}`
    سرچاپ "فضای گفتگو: " + میلیسرچ.به‌روزرسانی تنظیمات گفتگو(کارخواه، "support"، تنظیمات، اشکال)
    فضاها := میلیسرچ.فهرست فضاهای گفتگو(کارخواه، 0، 20، اشکال)
    سرچاپ "فضاهای گفتگو: " + فضاها.کل + " (" + فضاها.نتیجه‌ها.بگیر(0) + ")"

    پرسش کاربر := `{"model": "gpt-4o-mini", "stream": true, "messages": [{"role": "user", "content": "A smart film about aliens?"}]}`
    پاسخ := میلیسرچ.تکمیل گفتگو(کارخواه، "support"، پرسش کاربر، اشکال)
    هر خط در پاسخ.بشکاف("\n"):
        اگر خط.طول() بزرگتر 0: سرچاپ "جریان: " + خط پایان
    پایان
    سرچاپ "فضای گفتگو حذف شد: " + میلیسرچ.حذف فضای گفتگو(کارخواه، "support"، اشکال)
    برگشت 0
پایان
