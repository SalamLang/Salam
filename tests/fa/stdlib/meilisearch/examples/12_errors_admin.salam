واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "../_fake.salam"

پایا درگاه := 19831

تابع ریشه:
    نمایشی.ثبت پاسخ("GET"، "/indexes/ghost"، 404، `{"message":"Index ` + "`ghost`" + ` not found.","code":"index_not_found","type":"invalid_request","link":"https://docs.meilisearch.com/errors#index_not_found"}`)
    نمایشی.ثبت پاسخ("POST"، "/dumps"، 202، `{"taskUid":60,"indexUid":null,"status":"enqueued","type":"dumpCreation"}`)
    نمایشی.ثبت پاسخ("POST"، "/snapshots"، 202، `{"taskUid":61,"indexUid":null,"status":"enqueued","type":"snapshotCreation"}`)
    نمایشی.ثبت پاسخ("GET"، "/experimental-features"، 200، `{"metrics":false,"chatCompletions":false}`)
    نمایشی.ثبت پاسخ("PATCH"، "/experimental-features"، 200، `{"metrics":true,"chatCompletions":false}`)
    نمایشی.ثبت پاسخ("GET"، "/metrics"، 200، "meilisearch_index_count 2\n")
    نمایشی.ثبت پاسخ("POST"، "/logs/stderr"، 204، ``)
    نمایشی.ثبت پاسخ("GET"، "/indexes"، 200، `{"results":[],"offset":0,"limit":1,"total":0}`)
    اگر وارونه نمایشی.شروع(درگاه):
        سرچاپ "سرور نمونه راه نیفتاد"
        برگشت 1
    پایان
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:" + درگاه، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    میلیسرچ.دریافت نمایه(کارخواه، "ghost"، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
        سرچاپ "وضعیت " + اشکال.وضعیت + "، کد " + اشکال.کد + "، نوع " + اشکال.نوع
        سرچاپ "مستندات: " + اشکال.پیوند
    پایان

    خاموش := میلیسرچ.جدید("http://127.0.0.1:1"، "masterKey")
    میلیسرچ.سلامت(خاموش، اشکال)
    سرچاپ "در دسترس نیست: " + اشکال.کد

    سرچاپ "دامپ: " + میلیسرچ.ایجاد دامپ(کارخواه، اشکال).نوع
    سرچاپ "اسنپ‌شات: " + میلیسرچ.ایجاد اسنپ‌شات(کارخواه، اشکال).نوع
    سرچاپ "ویژگی‌ها: " + میلیسرچ.دریافت ویژگی‌های آزمایشی(کارخواه، اشکال)
    سرچاپ "ویژگی‌ها اکنون: " + میلیسرچ.به‌روزرسانی ویژگی‌های آزمایشی(کارخواه، `{"metrics": true}`، اشکال)
    سرچاپ "معیارها: " + میلیسرچ.دریافت معیارها(کارخواه، اشکال).طول() + " بایت"
    سرچاپ "سطح گزارش تنظیم شد: " + میلیسرچ.تنظیم گزارش خطای استاندارد(کارخواه، "info"، اشکال)
    سرچاپ "درخواست خام: " + میلیسرچ.درخواست(کارخواه، "GET"، "/indexes?limit=1"، ""، اشکال)
    برگشت 0
پایان
