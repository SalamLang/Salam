واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "_fake.salam"

پایا PORT := 19811

تابع show(label: رشته، t: میلیسرچ.اطلاعات کار، err: میلیسرچ.خطا):
    سرچاپ label + ": " + نمایشی.آخرین()
    سرچاپ "  -> task " + t.شناسه کار + " " + t.نوع
    اگر وارونه میلیسرچ.موفق(err):
        سرچاپ "  error: " + میلیسرچ.متن خطا(err)
    پایان
پایان

تابع list(v: وکتور<رشته>): رشته:
    ناپایا out := ""
    هر s در v:
        out = out + "<" + s + ">"
    پایان
    برگشت out
پایان

تابع ریشه:
    queued := `{"taskUid":31,"indexUid":"movies","status":"enqueued","type":"settingsUpdate","enqueuedAt":"2025-01-02T03:04:05Z"}`
    base := "/indexes/movies/settings"
    نمایشی.ثبت پاسخ("DELETE"، base + "/chat"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/dictionary"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/displayed-attributes"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/distinct-attribute"، 202، queued)
