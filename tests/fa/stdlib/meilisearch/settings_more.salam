    show("proximity-precision reset"، میلیسرچ.بازنشانی دقت مجاورت(c، "movies"، err)، err)
    show("search-cutoff-ms reset"، میلیسرچ.بازنشانی مهلت جستجو(c، "movies"، err)، err)
    show("searchable-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های قابل جستجو(c، "movies"، err)، err)
    show("separator-tokens reset"، میلیسرچ.بازنشانی نشانه‌های جداکننده(c، "movies"، err)، err)
    show("sortable-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های قابل مرتب‌سازی(c، "movies"، err)، err)
    show("synonyms reset"، میلیسرچ.بازنشانی مترادف‌ها(c، "movies"، err)، err)
    show("typo-tolerance reset"، میلیسرچ.بازنشانی تحمل غلط املایی(c، "movies"، err)، err)
    show("stop words reset"، میلیسرچ.بازنشانی تنظیم(c، "movies"، "stop-words"، err)، err)
    سرچاپ "network: " + میلیسرچ.دریافت شبکه(c، err)
    سرچاپ "network update: " + میلیسرچ.به‌روزرسانی شبکه(c، `{"self":"ms-1"}`، err)
    سرچاپ نمایشی.آخرین()
    show("export"، میلیسرچ.صدور(c، `{"url":"http://other:7700"}`، err)، err)
    برگشت 0
