    نمایشی.ثبت پاسخ("DELETE"، base + "/pagination"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/prefix-search"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/proximity-precision"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/search-cutoff-ms"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/searchable-attributes"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/separator-tokens"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/sortable-attributes"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/synonyms"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/typo-tolerance"، 202، queued)
    نمایشی.ثبت پاسخ("GET"، base + "/displayed-attributes"، 200، `["title","year"]`)
    نمایشی.ثبت پاسخ("GET"، base + "/searchable-attributes"، 200، `["title"]`)
    نمایشی.ثبت پاسخ("GET"، base + "/sortable-attributes"، 200، `["year"]`)
    نمایشی.ثبت پاسخ("GET"، base + "/dictionary"، 200، `["J.R.R."]`)
    نمایشی.ثبت پاسخ("GET"، base + "/separator-tokens"، 200، `["|"]`)
    نمایشی.ثبت پاسخ("GET"، base + "/non-separator-tokens"، 200، `["#"]`)
    نمایشی.ثبت پاسخ("GET"، base + "/embedders"، 200، `{"default":{"source":"userProvided"}}`)
    نمایشی.ثبت پاسخ("GET"، base + "/faceting"، 200، `{"maxValuesPerFacet":100}`)
    نمایشی.ثبت پاسخ("GET"، base + "/localized-attributes"، 200، `[]`)
    نمایشی.ثبت پاسخ("GET"، base + "/pagination"، 200، `{"maxTotalHits":1000}`)
    نمایشی.ثبت پاسخ("GET"، base + "/prefix-search"، 200، `"indexingTime"`)
    نمایشی.ثبت پاسخ("GET"، base + "/typo-tolerance"، 200، `{"enabled":true}`)
    نمایشی.ثبت پاسخ("GET"، base + "/chat"، 200، `{"description":"movies"}`)
    نمایشی.ثبت پاسخ("PUT"، base + "/stop-words"، 202، queued)
    نمایشی.ثبت پاسخ("PUT"، base + "/non-separator-tokens"، 202، queued)
    نمایشی.ثبت پاسخ("PUT"، base + "/proximity-precision"، 202، queued)
    نمایشی.ثبت پاسخ("PATCH"، base + "/chat"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/stop-words"، 202، queued)
    نمایشی.ثبت پاسخ("DELETE"، base + "/non-separator-tokens"، 202، queued)
    نمایشی.ثبت پاسخ("GET"، "/network"، 200، `{"self":"ms-0","remotes":{}}`)
    نمایشی.ثبت پاسخ("PATCH"، "/network"، 200، `{"self":"ms-1","remotes":{}}`)
    نمایشی.ثبت پاسخ("POST"، "/export"، 202، `{"taskUid":32,"indexUid":null,"status":"enqueued","type":"export","enqueuedAt":"2025-01-02T03:04:05Z"}`)
    اگر وارونه نمایشی.شروع(PORT):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    c := میلیسرچ.جدید("http://127.0.0.1:" + PORT، "masterKey")
    ناپایا err := میلیسرچ.خطا {}

    سرچاپ "displayed-attributes: " + list(میلیسرچ.دریافت ویژگی‌های نمایشی(c، "movies"، err))
    سرچاپ "searchable-attributes: " + list(میلیسرچ.دریافت ویژگی‌های قابل جستجو(c، "movies"، err))
    سرچاپ "sortable-attributes: " + list(میلیسرچ.دریافت ویژگی‌های قابل مرتب‌سازی(c، "movies"، err))
    سرچاپ "dictionary: " + list(میلیسرچ.دریافت واژه‌نامه(c، "movies"، err))
    سرچاپ "separator-tokens: " + list(میلیسرچ.دریافت نشانه‌های جداکننده(c، "movies"، err))
    سرچاپ "non-separator-tokens: " + list(میلیسرچ.دریافت نشانه‌های غیر جداکننده(c، "movies"، err))
    سرچاپ "embedders: " + میلیسرچ.دریافت جاسازها(c، "movies"، err)
    سرچاپ "faceting: " + میلیسرچ.دریافت وجه‌بندی(c، "movies"، err)
    سرچاپ "localized-attributes: " + میلیسرچ.دریافت ویژگی‌های محلی(c، "movies"، err)
    سرچاپ "pagination: " + میلیسرچ.دریافت صفحه‌بندی(c، "movies"، err)
    سرچاپ "prefix-search: " + میلیسرچ.دریافت جستجوی پیشوندی(c، "movies"، err)
    سرچاپ "typo-tolerance: " + میلیسرچ.دریافت تحمل غلط املایی(c، "movies"، err)
    سرچاپ "chat: " + میلیسرچ.دریافت گفتگو(c، "movies"، err)
    ناپایا words := وکتور {} برگردان وکتور<رشته>
    words.بیفزا("the")
    words.بیفزا("a")
    show("stop words"، میلیسرچ.به‌روزرسانی کلمات توقف(c، "movies"، words، err)، err)
    show("non separators"، میلیسرچ.به‌روزرسانی نشانه‌های غیر جداکننده(c، "movies"، words، err)، err)
    show("proximity"، میلیسرچ.به‌روزرسانی دقت مجاورت(c، "movies"، "byAttribute"، err)، err)
    show("chat"، میلیسرچ.به‌روزرسانی گفتگو(c، "movies"، `{"description":"movies"}`، err)، err)
    show("chat reset"، میلیسرچ.بازنشانی گفتگو(c، "movies"، err)، err)
    show("dictionary reset"، میلیسرچ.بازنشانی واژه‌نامه(c، "movies"، err)، err)
    show("displayed-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های نمایشی(c، "movies"، err)، err)
    show("distinct-attribute reset"، میلیسرچ.بازنشانی ویژگی متمایز(c، "movies"، err)، err)
    show("facet-search reset"، میلیسرچ.بازنشانی جستجوی وجه(c، "movies"، err)، err)
    show("faceting reset"، میلیسرچ.بازنشانی وجه‌بندی(c، "movies"، err)، err)
    show("filterable-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های قابل فیلتر(c، "movies"، err)، err)
    show("localized-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های محلی(c، "movies"، err)، err)
    show("pagination reset"، میلیسرچ.بازنشانی صفحه‌بندی(c، "movies"، err)، err)
