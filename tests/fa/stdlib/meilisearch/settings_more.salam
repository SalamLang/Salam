واردسازی دیتابیس.میلیسرچ

فراخوانی نمایشی "_fake.salam"

ناپایا PORT := 0

تابع نمایش نتیجه(برچسب: رشته، t: میلیسرچ.اطلاعات کار، پیام خطا: میلیسرچ.خطا):
    سرچاپ برچسب + ": " + نمایشی.آخرین()
    سرچاپ "  -> task " + t.شناسه کار + " " + t.نوع
    اگر وارونه میلیسرچ.موفق(پیام خطا):
        سرچاپ "  error: " + میلیسرچ.متن خطا(پیام خطا)
    پایان
پایان

تابع فهرست متن(v: وکتور<رشته>): رشته:
    ناپایا خروجی := ""
    هر s در v:
        خروجی = خروجی + "<" + s + ">"
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    پاسخ صف := `{"taskUid":31,"indexUid":"movies","status":"enqueued","type":"settingsUpdate","enqueuedAt":"2025-01-02T03:04:05Z"}`
    مسیر پایه := "/indexes/movies/settings"
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/chat"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/dictionary"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/displayed-attributes"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/distinct-attribute"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/facet-search"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/faceting"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/filterable-attributes"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/localized-attributes"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/pagination"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/prefix-search"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/proximity-precision"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/search-cutoff-ms"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/searchable-attributes"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/separator-tokens"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/sortable-attributes"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/synonyms"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/typo-tolerance"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/displayed-attributes"، 200، `["title","year"]`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/searchable-attributes"، 200، `["title"]`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/sortable-attributes"، 200، `["year"]`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/dictionary"، 200، `["J.R.R."]`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/separator-tokens"، 200، `["|"]`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/non-separator-tokens"، 200، `["#"]`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/embedders"، 200، `{"default":{"source":"userProvided"}}`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/faceting"، 200، `{"maxValuesPerFacet":100}`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/localized-attributes"، 200، `[]`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/pagination"، 200، `{"maxTotalHits":1000}`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/prefix-search"، 200، `"indexingTime"`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/typo-tolerance"، 200، `{"enabled":true}`)
    نمایشی.ثبت پاسخ("GET"، مسیر پایه + "/chat"، 200، `{"description":"movies"}`)
    نمایشی.ثبت پاسخ("PUT"، مسیر پایه + "/stop-words"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("PUT"، مسیر پایه + "/non-separator-tokens"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("PUT"، مسیر پایه + "/proximity-precision"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("PATCH"، مسیر پایه + "/chat"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/stop-words"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("DELETE"، مسیر پایه + "/non-separator-tokens"، 202، پاسخ صف)
    نمایشی.ثبت پاسخ("GET"، "/network"، 200، `{"self":"ms-0","remotes":{}}`)
    نمایشی.ثبت پاسخ("PATCH"، "/network"، 200، `{"self":"ms-1","remotes":{}}`)
    نمایشی.ثبت پاسخ("POST"، "/export"، 202، `{"taskUid":32,"indexUid":null,"status":"enqueued","type":"export","enqueuedAt":"2025-01-02T03:04:05Z"}`)
    PORT = نمایشی.شروع آزاد()
    اگر PORT برابر 0:
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    c := میلیسرچ.جدید("http://127.0.0.1:" + PORT، "masterKey")
    ناپایا پیام خطا := میلیسرچ.خطا {}

    سرچاپ "displayed-attributes: " + فهرست متن(میلیسرچ.دریافت ویژگی‌های نمایشی(c، "movies"، پیام خطا))
    سرچاپ "searchable-attributes: " + فهرست متن(میلیسرچ.دریافت ویژگی‌های قابل جستجو(c، "movies"، پیام خطا))
    سرچاپ "sortable-attributes: " + فهرست متن(میلیسرچ.دریافت ویژگی‌های قابل مرتب‌سازی(c، "movies"، پیام خطا))
    سرچاپ "dictionary: " + فهرست متن(میلیسرچ.دریافت واژه‌نامه(c، "movies"، پیام خطا))
    سرچاپ "separator-tokens: " + فهرست متن(میلیسرچ.دریافت نشانه‌های جداکننده(c، "movies"، پیام خطا))
    سرچاپ "non-separator-tokens: " + فهرست متن(میلیسرچ.دریافت نشانه‌های غیر جداکننده(c، "movies"، پیام خطا))
    سرچاپ "embedders: " + میلیسرچ.دریافت جاسازها(c، "movies"، پیام خطا)
    سرچاپ "faceting: " + میلیسرچ.دریافت وجه‌بندی(c، "movies"، پیام خطا)
    سرچاپ "localized-attributes: " + میلیسرچ.دریافت ویژگی‌های محلی(c، "movies"، پیام خطا)
    سرچاپ "pagination: " + میلیسرچ.دریافت صفحه‌بندی(c، "movies"، پیام خطا)
    سرچاپ "prefix-search: " + میلیسرچ.دریافت جستجوی پیشوندی(c، "movies"، پیام خطا)
    سرچاپ "typo-tolerance: " + میلیسرچ.دریافت تحمل غلط املایی(c، "movies"، پیام خطا)
    سرچاپ "chat: " + میلیسرچ.دریافت گفتگو(c، "movies"، پیام خطا)
    ناپایا واژه ها := وکتور {} برگردان وکتور<رشته>
    واژه ها.بیفزا("the")
    واژه ها.بیفزا("a")
    نمایش نتیجه("stop words"، میلیسرچ.به‌روزرسانی کلمات توقف(c، "movies"، واژه ها، پیام خطا)، پیام خطا)
    نمایش نتیجه("non separators"، میلیسرچ.به‌روزرسانی نشانه‌های غیر جداکننده(c، "movies"، واژه ها، پیام خطا)، پیام خطا)
    نمایش نتیجه("proximity"، میلیسرچ.به‌روزرسانی دقت مجاورت(c، "movies"، "byAttribute"، پیام خطا)، پیام خطا)
    نمایش نتیجه("chat"، میلیسرچ.به‌روزرسانی گفتگو(c، "movies"، `{"description":"movies"}`، پیام خطا)، پیام خطا)
    نمایش نتیجه("chat reset"، میلیسرچ.بازنشانی گفتگو(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("dictionary reset"، میلیسرچ.بازنشانی واژه‌نامه(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("displayed-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های نمایشی(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("distinct-attribute reset"، میلیسرچ.بازنشانی ویژگی متمایز(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("facet-search reset"، میلیسرچ.بازنشانی جستجوی وجه(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("faceting reset"، میلیسرچ.بازنشانی وجه‌بندی(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("filterable-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های قابل فیلتر(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("localized-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های محلی(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("pagination reset"، میلیسرچ.بازنشانی صفحه‌بندی(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("prefix-search reset"، میلیسرچ.بازنشانی جستجوی پیشوندی(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("proximity-precision reset"، میلیسرچ.بازنشانی دقت مجاورت(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("search-cutoff-ms reset"، میلیسرچ.بازنشانی مهلت جستجو(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("searchable-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های قابل جستجو(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("separator-tokens reset"، میلیسرچ.بازنشانی نشانه‌های جداکننده(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("sortable-attributes reset"، میلیسرچ.بازنشانی ویژگی‌های قابل مرتب‌سازی(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("synonyms reset"، میلیسرچ.بازنشانی مترادف‌ها(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("typo-tolerance reset"، میلیسرچ.بازنشانی تحمل غلط املایی(c، "movies"، پیام خطا)، پیام خطا)
    نمایش نتیجه("stop words reset"، میلیسرچ.بازنشانی تنظیم(c، "movies"، "stop-words"، پیام خطا)، پیام خطا)
    سرچاپ "network: " + میلیسرچ.دریافت شبکه(c، پیام خطا)
    سرچاپ "network update: " + میلیسرچ.به‌روزرسانی شبکه(c، `{"self":"ms-1"}`، پیام خطا)
    سرچاپ نمایشی.آخرین()
    نمایش نتیجه("export"، میلیسرچ.صدور(c، `{"url":"http://other:7700"}`، پیام خطا)، پیام خطا)
    برگشت 0
پایان
