بسته ریشه

واردسازی حافظه

تابع ریشه:
    arr := حافظه.تخصیص آرایه(4 برگردان طبیعی۶۴، 8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    سرچاپ "array allocated: "، arr نابرابر پوچ
    سرچاپ "array zeroed: "، arr[0] برابر 0 برگردان صحیح۶۴ و arr[3] برابر 0 برگردان صحیح۶۴
    arr[2] = 42 برگردان صحیح۶۴
    سرچاپ "array write: "، arr[2]
    سرچاپ "zero count: "، حافظه.تخصیص آرایه(0 برگردان طبیعی۶۴، 8 برگردان طبیعی۶۴) برابر پوچ
    سرچاپ "zero size: "، حافظه.تخصیص آرایه(8 برگردان طبیعی۶۴، 0 برگردان طبیعی۶۴) برابر پوچ
    سرچاپ "overflow: "، حافظه.تخصیص آرایه(0xFFFFFFFFFFFFFFFF برگردان طبیعی۶۴، 16 برگردان طبیعی۶۴) برابر پوچ

    buf := حافظه.تخصیص(8 برگردان طبیعی۶۴) برگردان طبیعی۸*
    تکرار 8 در i:
        buf[i] = (i + 1) برگردان طبیعی۸
    پایان
    حافظه.جابجایی حافظه((buf برگردان طبیعی۶۴ + 2 برگردان طبیعی۶۴) برگردان تهی*، buf برگردان تهی*، 4 برگردان طبیعی۶۴)
    سرچاپ "overlapping move: "، buf[0]، buf[1]، buf[2]، buf[3]، buf[4]، buf[5]، buf[6]
    سرچاپ "same pointer: "، حافظه.جابجایی حافظه(buf برگردان تهی*، buf برگردان تهی*، 4 برگردان طبیعی۶۴) برابر buf برگردان تهی*
    سرچاپ "zero length: "، حافظه.جابجایی حافظه(buf برگردان تهی*، arr برگردان تهی*، 0 برگردان طبیعی۶۴) برابر buf برگردان تهی*

    live := حافظه.بایت های زنده()
    peak := حافظه.بیشترین بایت ها()
    سرچاپ "peak covers live: "، peak بزرگتربرابر live
    سرچاپ "debug implies active: "، حافظه.اشکال زدایی حافظه فعال است() برابر نادرست یا حافظه.بررسی حافظه فعال است()
    سرچاپ "asan implies active: "، حافظه.ای سن فعال است() برابر نادرست یا حافظه.بررسی حافظه فعال است()
    سرچاپ "active is either: "، حافظه.بررسی حافظه فعال است() برابر (حافظه.اشکال زدایی حافظه فعال است() یا حافظه.ای سن فعال است())

    حافظه.آزادسازی(buf برگردان تهی*)
    حافظه.آزادسازی(arr برگردان تهی*)

    ناپایا a := حافظه.قلمرو جدید(64 برگردان طبیعی۶۴)
    سرچاپ "arena capacity: "، حافظه.ظرفیت قلمرو(a)
    سرچاپ "arena remaining: "، حافظه.باقیمانده قلمرو(a)
    zeroed := حافظه.تخصیص صفرشده در قلمرو(a، 10 برگردان طبیعی۶۴) برگردان طبیعی۸*
    سرچاپ "zeroed block: "، zeroed نابرابر پوچ و zeroed[0] برابر 0 برگردان طبیعی۸ و zeroed[9] برابر 0 برگردان طبیعی۸
    سرچاپ "used rounds to 8: "، حافظه.استفاده شده قلمرو(a)
    سرچاپ "remaining after: "، حافظه.باقیمانده قلمرو(a)
    سرچاپ "too big: "، حافظه.تخصیص در قلمرو(a، 100 برگردان طبیعی۶۴) برابر پوچ
    حافظه.بازنشانی قلمرو(a)
    سرچاپ "after reset used: "، حافظه.استفاده شده قلمرو(a)
    سرچاپ "after reset remaining: "، حافظه.باقیمانده قلمرو(a)
    حافظه.آزادسازی قلمرو(a)

    ناپایا p := حافظه.استخر جدید(20 برگردان طبیعی۶۴، 3 برگردان طبیعی۶۴)
    سرچاپ "pool block size: "، حافظه.اندازه بلوک(p)
    سرچاپ "pool capacity: "، حافظه.ظرفیت استخر(p)
    first := حافظه.تخصیص از استخر(p)
    حافظه.تخصیص از استخر(p)
    حافظه.تخصیص از استخر(p)
    سرچاپ "pool exhausted: "، حافظه.تخصیص از استخر(p) برابر پوچ
    حافظه.بازگشت به استخر(p، first)
    سرچاپ "block reused: "، حافظه.تخصیص از استخر(p) برابر first
    حافظه.نابودسازی استخر(p)
پایان
