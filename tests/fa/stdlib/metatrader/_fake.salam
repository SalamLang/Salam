// زبان: فارسی
بسته fake

واردسازی رشته
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا _keys := وکتور {} برگردان وکتور<رشته>
ناپایا _codes := وکتور {} برگردان وکتور<صحیح>
ناپایا _bodies := وکتور {} برگردان وکتور<رشته>
ناپایا _used := وکتور {} برگردان وکتور<منطقی>
ناپایا _last := ""
ناپایا _count := 0

تابع _handle(h: صحیح۶۴):
    ctx := اچ تی تی پی.زمینه جدید(h)
    method := اچ تی تی پی.روش(ctx)
    path := اچ تی تی پی.مسیر(ctx)
    query := اچ تی تی پی.پرسمان خام(ctx)
    ناپایا target := path
    اگر query.طول() بزرگتر 0: target = path + "?" + query پایان
    _count += 1
    _last = method + " " + target
    body := اچ تی تی پی.بدنه(ctx)
    اگر body.طول() بزرگتر 0: _last = _last + "\n  body: " + رشته.پیرایش راست(body) پایان
    key := method + " " + path
    ناپایا pick := -1
    تکرار _keys.طول() در i:
        اگر pick کوچکتر 0 و _keys.بگیر(i) برابر key و وارونه _used.بگیر(i):
            pick = i
        پایان
    پایان
    اگر pick کوچکتر 0:
        تکرار _keys.طول() در i:
            اگر _keys.بگیر(i) برابر key: pick = i پایان
        پایان
    وگرنه:
        _used.بنشان(pick، درست)
    پایان
    اگر pick کوچکتر 0:
        اچ تی تی پی.تنظیم وضعیت(ctx، 404)
        اچ تی تی پی.جیسون(ctx، `{"error":"no route for ` + key + `"}`)
        برگشت
    پایان
    اچ تی تی پی.تنظیم وضعیت(ctx، _codes.بگیر(pick))
    اچ تی تی پی.جیسون(ctx، _bodies.بگیر(pick))
پایان

همگانی تابع On(method: رشته، path: رشته، code: صحیح، body: رشته):
    _keys.بیفزا(method + " " + path)
    _codes.بیفزا(code)
    _bodies.بیفزا(body)
    _used.بیفزا(نادرست)
پایان

همگانی تابع Last(): رشته:
    برگشت _last
پایان

همگانی تابع Count(): صحیح:
    برگشت _count
پایان

همگانی تابع Start(port: صحیح): منطقی:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/*"، _handle)
    مسیریاب.ارسال(r، "/*"، _handle)
    s := اچ تی تی پی.سرور جدید(port)
    اچ تی تی پی.استفاده(s، r)
    برگشت اچ تی تی پی.اجرا در پس زمینه(s)
پایان
