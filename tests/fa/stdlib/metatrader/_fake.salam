// زبان: فارسی
بسته جعلی

واردسازی رشته
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا _keys := وکتور {} برگردان وکتور<رشته>
ناپایا _codes := وکتور {} برگردان وکتور<صحیح>
ناپایا _bodies := وکتور {} برگردان وکتور<رشته>
ناپایا _used := وکتور {} برگردان وکتور<منطقی>
ناپایا _last := ""
ناپایا _count := 0

تابع _handle(h: صحیح۶۴):
    زمینه := اچ تی تی پی.زمینه جدید(h)
    روش درخواست := اچ تی تی پی.روش(زمینه)
    مسیر درخواست := اچ تی تی پی.مسیر(زمینه)
    پرسمان := اچ تی تی پی.پرسمان خام(زمینه)
    ناپایا مقصد := مسیر درخواست
    اگر پرسمان.طول() بزرگتر 0: مقصد = مسیر درخواست + "?" + پرسمان پایان
    _count++
    _last = روش درخواست + " " + مقصد
    بدنه := اچ تی تی پی.بدنه(زمینه)
    اگر بدنه.طول() بزرگتر 0: _last = _last + "\n  body: " + رشته.پیرایش راست(بدنه) پایان
    کلید := روش درخواست + " " + مسیر درخواست
    ناپایا شاخص := -1
    تکرار _keys.طول() در i:
        اگر شاخص کوچکتر 0 و _keys.بگیر(i) برابر کلید و وارونه _used.بگیر(i):
            شاخص = i
        پایان
    پایان
    اگر شاخص کوچکتر 0:
        تکرار _keys.طول() در i:
            اگر _keys.بگیر(i) برابر کلید: شاخص = i پایان
        پایان
    وگرنه:
        _used.بنشان(شاخص، درست)
    پایان
    اگر شاخص کوچکتر 0:
        اچ تی تی پی.تنظیم وضعیت(زمینه، 404)
        اچ تی تی پی.جیسون(زمینه، `{"error":"no route for ` + کلید + `"}`)
        برگشت
    پایان
    اچ تی تی پی.تنظیم وضعیت(زمینه، _codes.بگیر(شاخص))
    اچ تی تی پی.جیسون(زمینه، _bodies.بگیر(شاخص))
پایان

همگانی تابع ثبت پاسخ(روش درخواست: رشته، مسیر درخواست: رشته، کد وضعیت: صحیح، بدنه: رشته):
    _keys.بیفزا(روش درخواست + " " + مسیر درخواست)
    _codes.بیفزا(کد وضعیت)
    _bodies.بیفزا(بدنه)
    _used.بیفزا(نادرست)
پایان

همگانی تابع آخرین(): رشته:
    برگشت _last
پایان

همگانی تابع شمار(): صحیح:
    برگشت _count
پایان

همگانی تابع آغاز آزاد(): صحیح:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/*"، _handle)
    مسیریاب.ارسال(r، "/*"، _handle)
    ناپایا s := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.استفاده(s، r)
    برگشت اچ تی تی پی.اجرا در پس زمینه با درگاه(s)
پایان
