واردسازی متاتریدر

فراخوانی جعلی "_fake.salam"

پایا PORT := 19902

تابع ریشه:
    جعلی.ثبت پاسخ("GET"، "/account_info"، 200، `{"login":12345,"balance":10000.5,"equity":10050.75,"currency":"USD","leverage":100,"trade_allowed":true,"server":"Demo-Server","company":"Demo Broker"}`)
    جعلی.ثبت پاسخ("GET"، "/terminal_info"، 200، `{"build":4530,"connected":true,"trade_allowed":true,"company":"MetaQuotes","name":"MetaTrader 5","language":"English"}`)
    جعلی.آغاز(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    حساب := متاتریدر.دریافت اطلاعات حساب()
    سرچاپ حساب.شناسه ورود، حساب.موجودی، حساب.دارایی خالص، حساب.ارز
    سرچاپ حساب.اهرم، حساب.معامله مجاز، حساب.سرور، حساب.شرکت

    ترمینال := متاتریدر.دریافت اطلاعات ترمینال()
    سرچاپ ترمینال.شماره ساخت، ترمینال.متصل، ترمینال.معامله مجاز
    سرچاپ ترمینال.شرکت، ترمینال.نام، ترمینال.زبان ترمینال

    سرچاپ متاتریدر.موفق()
پایان
