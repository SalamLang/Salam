واردسازی متاتریدر

فراخوانی fake "_fake.salam"

پایا PORT := 19902

تابع ریشه:
    fake.On("GET"، "/account_info"، 200، `{"login":12345,"balance":10000.5,"equity":10050.75,"currency":"USD","leverage":100,"trade_allowed":true,"server":"Demo-Server","company":"Demo Broker"}`)
    fake.On("GET"، "/terminal_info"، 200، `{"build":4530,"connected":true,"trade_allowed":true,"company":"MetaQuotes","name":"MetaTrader 5","language":"English"}`)
    fake.Start(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    acc := متاتریدر.دریافت اطلاعات حساب()
    سرچاپ acc.شناسه ورود، acc.موجودی، acc.دارایی خالص، acc.ارز
    سرچاپ acc.اهرم، acc.معامله مجاز، acc.سرور، acc.شرکت

    term := متاتریدر.دریافت اطلاعات ترمینال()
    سرچاپ term.شماره ساخت، term.متصل، term.معامله مجاز
    سرچاپ term.شرکت، term.نام، term.زبان ترمینال

    سرچاپ متاتریدر.موفق()
پایان
