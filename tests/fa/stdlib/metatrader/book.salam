واردسازی متاتریدر

فراخوانی جعلی "_fake.salam"

ناپایا PORT := 0

تابع ریشه:
    جعلی.ثبت پاسخ("POST"، "/market_book_add"، 200، `{}`)
    جعلی.ثبت پاسخ(
        "GET"،
        "/market_book_get"،
        200،
        `[{"book_type":1,"price":1.0821,"volume":5,"volume_dbl":5.0}, {"book_type":0,"price":1.0823,"volume":3,"volume_dbl":3.0}]`
    )
    جعلی.ثبت پاسخ("POST"، "/market_book_release"، 200، `{}`)
    PORT = جعلی.آغاز آزاد()
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    سرچاپ متاتریدر.افزودن دفتر سفارش("EURUSD")
    book := متاتریدر.دریافت دفتر سفارش("EURUSD")
    سرچاپ book.طول()
    هر e در book:
        سرچاپ e.نوع سطح دفتر، e.قیمت، e.حجم، e.حجم اعشاری
    پایان
    سرچاپ متاتریدر.آزادسازی دفتر سفارش("EURUSD")
پایان
