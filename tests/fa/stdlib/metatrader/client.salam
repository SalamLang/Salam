واردسازی متاتریدر

فراخوانی جعلی "_fake.salam"

پایا PORT := 19901

تابع ریشه:
    جعلی.ثبت پاسخ("POST"، "/initialize"، 200، `{}`)
    جعلی.ثبت پاسخ("POST"، "/login"، 200، `{}`)
    جعلی.ثبت پاسخ("GET"، "/version"، 200، `{"terminal_version":500,"build":4530,"build_release_date":"Oct 1 2026"}`)
    جعلی.ثبت پاسخ("POST"، "/shutdown"، 200، `{}`)
    جعلی.آغاز(PORT)

    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)
    سرچاپ متاتریدر.نشانی پل()

    سرچاپ متاتریدر.آغاز()
    خطای آخر := متاتریدر.آخرین خطا()
    سرچاپ خطای آخر.کد، خطای آخر.توضیح
    سرچاپ متاتریدر.متصل است()
    سرچاپ متاتریدر.موفق()

    سرچاپ متاتریدر.ورود(12345 برگردان صحیح۶۴، "secret"، "Demo-Server")
    سرچاپ متاتریدر.متصل است()

    نسخه ترمینال := متاتریدر.نسخه()
    سرچاپ نسخه ترمینال.نسخه ترمینال، نسخه ترمینال.شماره ساخت، نسخه ترمینال.تاریخ انتشار ساخت

    متاتریدر.پایان()
    سرچاپ متاتریدر.متصل است()
پایان
