واردسازی متاتریدر

فراخوانی fake "_fake.salam"

پایا PORT := 19901

تابع ریشه:
    fake.On("POST"، "/initialize"، 200، `{}`)
    fake.On("POST"، "/login"، 200، `{}`)
    fake.On("GET"، "/version"، 200، `{"terminal_version":500,"build":4530,"build_release_date":"Oct 1 2026"}`)
    fake.On("POST"، "/shutdown"، 200، `{}`)
    fake.Start(PORT)

    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)
    سرچاپ متاتریدر.نشانی پل()

    سرچاپ متاتریدر.آغاز()
    err := متاتریدر.آخرین خطا()
    سرچاپ err.کد، err.توضیح
    سرچاپ متاتریدر.متصل است()
    سرچاپ متاتریدر.موفق()

    سرچاپ متاتریدر.ورود(12345 برگردان صحیح۶۴، "secret"، "Demo-Server")
    سرچاپ متاتریدر.متصل است()

    ver := متاتریدر.نسخه()
    سرچاپ ver.نسخه ترمینال، ver.شماره ساخت، ver.تاریخ انتشار ساخت

    متاتریدر.پایان()
    سرچاپ متاتریدر.متصل است()
پایان
