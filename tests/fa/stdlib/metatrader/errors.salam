واردسازی متاتریدر

فراخوانی جعلی "_fake.salam"

ناپایا PORT := 0

تابع گزارش وضعیت(برچسب: رشته):
    خطای آخر := متاتریدر.آخرین خطا()
    سرچاپ برچسب، متاتریدر.موفق()، خطای آخر.کد
پایان

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:19999")
    سرچاپ متاتریدر.آغاز()
    گزارش وضعیت("no bridge running")

    جعلی.ثبت پاسخ("GET"، "/account_info"، 500، `{"error":"internal error"}`)
    PORT = جعلی.آغاز آزاد()
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    حساب := متاتریدر.دریافت اطلاعات حساب()
    سرچاپ حساب.شناسه ورود
    گزارش وضعیت("http 500")

    جعلی.ثبت پاسخ("GET"، "/account_info"، 200، `{"login":1}`)
    حساب دوم := متاتریدر.دریافت اطلاعات حساب()
    سرچاپ حساب دوم.شناسه ورود
    گزارش وضعیت("recovered")
پایان
