واردسازی متاتریدر

فراخوانی fake "_fake.salam"

پایا PORT := 19911

تابع report(label: رشته):
    err := متاتریدر.آخرین خطا()
    سرچاپ label، متاتریدر.موفق()، err.کد
پایان

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:19999")
    سرچاپ متاتریدر.آغاز()
    report("no bridge running")

    fake.On("GET"، "/account_info"، 500، `{"error":"internal error"}`)
    fake.Start(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    acc := متاتریدر.دریافت اطلاعات حساب()
    سرچاپ acc.شناسه ورود
    report("http 500")

    fake.On("GET"، "/account_info"، 200، `{"login":1}`)
    acc2 := متاتریدر.دریافت اطلاعات حساب()
    سرچاپ acc2.شناسه ورود
    report("recovered")
پایان
