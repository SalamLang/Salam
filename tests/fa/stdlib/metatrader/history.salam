واردسازی متاتریدر

فراخوانی fake "_fake.salam"

پایا PORT := 19910

تابع ریشه:
    fake.On("GET"، "/history_orders_total"، 200، `1`)
    fake.On("GET"، "/history_orders_get"، 200، `[{"ticket":3001,"symbol":"EURUSD","order_type":0,"state":4,"volume_initial":1.0,"price_open":1.08}]`)
    fake.On("GET"، "/history_deals_total"، 200، `1`)
    fake.On("GET"، "/history_deals_get"، 200، `[{"ticket":4001,"order":3001,"symbol":"EURUSD","deal_type":0,"entry":0,"volume":1.0,"price":1.08,"profit":21.0,"commission":-0.7,"swap":0.0}]`)
    fake.Start(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    سرچاپ متاتریدر.تعداد سفارش‌های تاریخچه(0 برگردان صحیح۶۴، 1800000000 برگردان صحیح۶۴)
    ho := متاتریدر.دریافت سفارش‌های تاریخچه(0 برگردان صحیح۶۴، 1800000000 برگردان صحیح۶۴)
    سرچاپ ho.طول()
    هر o در ho:
        سرچاپ o.شماره تیکت، o.نماد، o.نوع سفارش، o.وضعیت، o.حجم اولیه، o.قیمت ورود
    پایان
    سرچاپ متاتریدر.دریافت سفارش‌های تاریخچه با گروه(0 برگردان صحیح۶۴، 1800000000 برگردان صحیح۶۴، "*").طول()، fake.Last()
    سرچاپ متاتریدر.دریافت سفارش تاریخچه با شماره(3001 برگردان صحیح۶۴).طول()، fake.Last()
    سرچاپ متاتریدر.دریافت سفارش‌های تاریخچه با پوزیشن(3001 برگردان صحیح۶۴).طول()، fake.Last()

    سرچاپ متاتریدر.تعداد معامله‌های تاریخچه(0 برگردان صحیح۶۴، 1800000000 برگردان صحیح۶۴)
    hd := متاتریدر.دریافت معامله‌های تاریخچه(0 برگردان صحیح۶۴، 1800000000 برگردان صحیح۶۴)
    سرچاپ hd.طول()
    هر d در hd:
        سرچاپ d.شماره تیکت، d.شماره سفارش، d.نماد، d.نوع معامله، d.نوع ورود، d.حجم، d.قیمت، d.سود، d.کمیسیون
    پایان
    سرچاپ متاتریدر.دریافت معامله‌های تاریخچه با گروه(0 برگردان صحیح۶۴، 1800000000 برگردان صحیح۶۴، "*").طول()، fake.Last()
    سرچاپ متاتریدر.دریافت معامله تاریخچه با شماره(4001 برگردان صحیح۶۴).طول()، fake.Last()
    سرچاپ متاتریدر.دریافت معامله‌های تاریخچه با پوزیشن(3001 برگردان صحیح۶۴).طول()، fake.Last()
پایان
