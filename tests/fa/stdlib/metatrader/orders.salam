واردسازی متاتریدر

فراخوانی fake "_fake.salam"

پایا PORT := 19907

تابع ریشه:
    fake.On("GET"، "/orders_total"، 200، `2`)
    fake.On("GET"، "/orders_get"، 200، `[{"ticket":1001,"symbol":"EURUSD","order_type":0,"state":1,"volume_current":1.0,"price_open":1.08,"magic":7}, {"ticket":1002,"symbol":"GBPUSD","order_type":1,"state":1,"volume_current":2.0,"price_open":1.26,"magic":7}]`)
    fake.On("POST"، "/order_calc_margin"، 200، `108.5`)
    fake.On("POST"، "/order_calc_profit"، 200، `12.75`)
    fake.Start(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    سرچاپ متاتریدر.تعداد سفارش‌های فعال()

    all := متاتریدر.دریافت سفارش‌های فعال()
    سرچاپ all.طول()
    هر o در all:
        سرچاپ o.شماره تیکت، o.نماد، o.نوع سفارش، o.وضعیت، o.حجم فعلی، o.قیمت ورود، o.شناسه ربات
    پایان

    bySymbol := متاتریدر.دریافت سفارش‌های فعال با نماد("EURUSD")
    سرچاپ bySymbol.طول()، fake.Last()

    byGroup := متاتریدر.دریافت سفارش‌های فعال با گروه("*USD*")
    سرچاپ byGroup.طول()، fake.Last()

    byTicket := متاتریدر.دریافت سفارش فعال با شماره(1001 برگردان صحیح۶۴)
    سرچاپ byTicket.طول()، fake.Last()

    margin := متاتریدر.محاسبه حاشیه سفارش(متاتریدر.سفارش خرید، "EURUSD"، 1.0، 1.08)
    سرچاپ margin

    profit := متاتریدر.محاسبه سود سفارش(متاتریدر.سفارش خرید، "EURUSD"، 1.0، 1.08، 1.09)
    سرچاپ profit
پایان
