واردسازی متاتریدر

فراخوانی جعلی "_fake.salam"

پایا PORT := 19907

تابع ریشه:
    جعلی.ثبت پاسخ("GET"، "/orders_total"، 200، `2`)
    جعلی.ثبت پاسخ("GET"، "/orders_get"، 200، `[{"ticket":1001,"symbol":"EURUSD","order_type":0,"state":1,"volume_current":1.0,"price_open":1.08,"magic":7}, {"ticket":1002,"symbol":"GBPUSD","order_type":1,"state":1,"volume_current":2.0,"price_open":1.26,"magic":7}]`)
    جعلی.ثبت پاسخ("POST"، "/order_calc_margin"، 200، `108.5`)
    جعلی.ثبت پاسخ("POST"، "/order_calc_profit"، 200، `12.75`)
    جعلی.آغاز(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    سرچاپ متاتریدر.تعداد سفارش‌های فعال()

    همه := متاتریدر.دریافت سفارش‌های فعال()
    سرچاپ همه.طول()
    هر o در همه:
        سرچاپ o.شماره تیکت، o.نماد، o.نوع سفارش، o.وضعیت، o.حجم فعلی، o.قیمت ورود، o.شناسه ربات
    پایان

    سفارش های نماد := متاتریدر.دریافت سفارش‌های فعال با نماد("EURUSD")
    سرچاپ سفارش های نماد.طول()، جعلی.آخرین()

    سفارش های گروه := متاتریدر.دریافت سفارش‌های فعال با گروه("*USD*")
    سرچاپ سفارش های گروه.طول()، جعلی.آخرین()

    سفارش تیکت := متاتریدر.دریافت سفارش فعال با شماره(1001 برگردان صحیح۶۴)
    سرچاپ سفارش تیکت.طول()، جعلی.آخرین()

    حاشیه := متاتریدر.محاسبه حاشیه سفارش(متاتریدر.سفارش خرید، "EURUSD"، 1.0، 1.08)
    سرچاپ حاشیه

    سود := متاتریدر.محاسبه سود سفارش(متاتریدر.سفارش خرید، "EURUSD"، 1.0، 1.08، 1.09)
    سرچاپ سود
پایان
