واردسازی متاتریدر

فراخوانی جعلی "_fake.salam"

ناپایا PORT := 0

تابع ریشه:
    جعلی.ثبت پاسخ("GET"، "/positions_total"، 200، `1`)
    جعلی.ثبت پاسخ("GET"، "/positions_get"، 200، `[{"ticket":2001,"symbol":"EURUSD","position_type":0,"volume":1.0,"price_open":1.08,"price_current":1.0821,"profit":21.0,"swap":0.0,"magic":7}]`)
    PORT = جعلی.آغاز آزاد()
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    سرچاپ متاتریدر.تعداد پوزیشن‌های باز()

    all := متاتریدر.دریافت پوزیشن‌های باز()
    سرچاپ all.طول()
    هر p در all:
        سرچاپ p.شماره تیکت، p.نماد، p.نوع پوزیشن، p.حجم، p.قیمت ورود، p.قیمت فعلی، p.سود
    پایان

    سرچاپ متاتریدر.دریافت پوزیشن‌های باز با نماد("EURUSD").طول()، جعلی.آخرین()
    سرچاپ متاتریدر.دریافت پوزیشن‌های باز با گروه("*USD*").طول()، جعلی.آخرین()
    سرچاپ متاتریدر.دریافت پوزیشن باز با شماره(2001 برگردان صحیح۶۴).طول()، جعلی.آخرین()
پایان
