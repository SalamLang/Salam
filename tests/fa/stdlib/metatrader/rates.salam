واردسازی متاتریدر

فراخوانی fake "_fake.salam"

پایا PORT := 19905

تابع ریشه:
    fake.On("GET"، "/copy_rates_from"، 200، `[{"time":1700000000,"open":1.08,"high":1.081,"low":1.079,"close":1.0805,"tick_volume":150,"spread":2,"real_volume":0}, {"time":1700000060,"open":1.0805,"high":1.082,"low":1.0801,"close":1.0815,"tick_volume":132,"spread":2,"real_volume":0}]`)
    fake.On("GET"، "/copy_rates_from_pos"، 200، `[{"time":1700000000,"open":1.08,"high":1.081,"low":1.079,"close":1.0805,"tick_volume":150,"spread":2,"real_volume":0}]`)
    fake.On("GET"، "/copy_rates_range"، 200، `[{"time":1700000000,"open":1.08,"high":1.081,"low":1.079,"close":1.0805,"tick_volume":150,"spread":2,"real_volume":0}]`)
    fake.Start(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    rates := متاتریدر.کپی کندل‌ها از تاریخ("EURUSD"، متاتریدر.بازه یک دقیقه، 1700000000 برگردان صحیح۶۴، 2)
    سرچاپ rates.طول()
    هر r در rates:
        سرچاپ r.زمان، r.قیمت باز، r.بیشترین قیمت، r.کمترین قیمت، r.قیمت‌بسته، r.حجم تیک، r.اسپرد
    پایان
    سرچاپ fake.Last()

    rates2 := متاتریدر.کپی کندل‌ها از موقعیت("EURUSD"، متاتریدر.بازه یک دقیقه، 0، 1)
    سرچاپ rates2.طول()
    سرچاپ fake.Last()

    rates3 := متاتریدر.کپی‌کندل‌ها‌در‌بازه("EURUSD"، متاتریدر.بازه یک دقیقه، 1700000000 برگردان صحیح۶۴، 1700000100 برگردان صحیح۶۴)
    سرچاپ rates3.طول()
    سرچاپ fake.Last()
پایان
