واردسازی متاتریدر

فراخوانی جعلی "_fake.salam"

پایا PORT := 19903

تابع ریشه:
    جعلی.ثبت پاسخ("GET"، "/symbols_total"، 200، `120`)
    جعلی.ثبت پاسخ("GET"، "/symbols_get"، 200، `[{"name":"EURUSD","digits":5,"bid":1.0821,"ask":1.0823}, {"name":"GBPUSD","digits":5,"bid":1.2601,"ask":1.2603}]`)
    جعلی.ثبت پاسخ("GET"، "/symbol_info"، 200، `{"name":"EURUSD","digits":5,"point":0.00001,"spread":2,"volume_min":0.01,"volume_max":500.0,"trade_contract_size":100000.0,"currency_base":"EUR","currency_profit":"USD"}`)
    جعلی.ثبت پاسخ("GET"، "/symbol_info_tick"، 200، `{"time":1700000000,"bid":1.0821,"ask":1.0823,"last":0.0,"volume":0,"flags":6}`)
    جعلی.ثبت پاسخ("POST"، "/symbol_select"، 200، `{}`)
    جعلی.آغاز(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    سرچاپ متاتریدر.تعداد نمادها()

    همه := متاتریدر.دریافت نمادها()
    سرچاپ همه.طول()، همه.بگیر(0).نام، همه.بگیر(1).نام

    دلاری ها := متاتریدر.دریافت نمادها با گروه("*USD*")
    سرچاپ دلاری ها.طول()، جعلی.آخرین()

    اطلاعات نماد := متاتریدر.دریافت اطلاعات نماد("EURUSD")
    سرچاپ اطلاعات نماد.نام، اطلاعات نماد.رقم اعشار، اطلاعات نماد.اندازه پوینت، اطلاعات نماد.اسپرد
    سرچاپ اطلاعات نماد.حداقل حجم، اطلاعات نماد.حداکثر حجم، اطلاعات نماد.اندازه قرارداد
    سرچاپ اطلاعات نماد.ارز پایه، اطلاعات نماد.ارز سود

    نوسان := متاتریدر.نوسان نماد("EURUSD")
    سرچاپ نوسان.زمان، نوسان.قیمت خرید، نوسان.قیمت فروش، نوسان.پرچم‌ها

    سرچاپ متاتریدر.انتخاب نماد("EURUSD"، درست)
پایان
