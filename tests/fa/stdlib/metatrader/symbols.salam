واردسازی متاتریدر

فراخوانی fake "_fake.salam"

پایا PORT := 19903

تابع ریشه:
    fake.On("GET"، "/symbols_total"، 200، `120`)
    fake.On("GET"، "/symbols_get"، 200، `[{"name":"EURUSD","digits":5,"bid":1.0821,"ask":1.0823}, {"name":"GBPUSD","digits":5,"bid":1.2601,"ask":1.2603}]`)
    fake.On("GET"، "/symbol_info"، 200، `{"name":"EURUSD","digits":5,"point":0.00001,"spread":2,"volume_min":0.01,"volume_max":500.0,"trade_contract_size":100000.0,"currency_base":"EUR","currency_profit":"USD"}`)
    fake.On("GET"، "/symbol_info_tick"، 200، `{"time":1700000000,"bid":1.0821,"ask":1.0823,"last":0.0,"volume":0,"flags":6}`)
    fake.On("POST"، "/symbol_select"، 200، `{}`)
    fake.Start(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    سرچاپ متاتریدر.تعداد نمادها()

    all := متاتریدر.دریافت نمادها()
    سرچاپ all.طول()، all.بگیر(0).name، all.بگیر(1).name

    sym := متاتریدر.دریافت اطلاعات نماد("EURUSD")
    سرچاپ sym.name، sym.digits، sym.point، sym.spread
    سرچاپ sym.volume_min، sym.volume_max، sym.trade_contract_size
    سرچاپ sym.currency_base، sym.currency_profit

    tick := متاتریدر.نوسان نماد("EURUSD")
    سرچاپ tick.time، tick.bid، tick.ask، tick.flags

    سرچاپ متاتریدر.انتخاب نماد("EURUSD"، درست)
پایان
