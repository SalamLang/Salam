واردسازی متاتریدر

فراخوانی جعلی "_fake.salam"

پایا PORT := 19906

تابع ریشه:
    جعلی.ثبت پاسخ("GET"، "/copy_ticks_from"، 200، `[{"time":1700000000,"bid":1.0821,"ask":1.0823,"last":0.0,"volume":0,"time_msc":1700000000123,"flags":6,"volume_real":0.0}]`)
    جعلی.ثبت پاسخ("GET"، "/copy_ticks_range"، 200، `[{"time":1700000000,"bid":1.0821,"ask":1.0823,"last":0.0,"volume":0,"time_msc":1700000000123,"flags":6,"volume_real":0.0}, {"time":1700000001,"bid":1.0822,"ask":1.0824,"last":0.0,"volume":0,"time_msc":1700000001456,"flags":6,"volume_real":0.0}]`)
    جعلی.آغاز(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    نوسان ها := متاتریدر.کپی نوسانات از تاریخ("EURUSD"، 1700000000 برگردان صحیح۶۴، 10، متاتریدر.تمام نوسانات قیمت)
    سرچاپ نوسان ها.طول()
    هر t در نوسان ها:
        سرچاپ t.زمان، t.قیمت خرید، t.قیمت فروش، t.زمان به میلی‌ثانیه، t.پرچم‌ها
    پایان

    نوسان های بازه := متاتریدر.کپی‌نوسانات‌در‌بازه("EURUSD"، 1700000000 برگردان صحیح۶۴، 1700000002 برگردان صحیح۶۴، متاتریدر.تمام نوسانات قیمت)
    سرچاپ نوسان های بازه.طول()
پایان
