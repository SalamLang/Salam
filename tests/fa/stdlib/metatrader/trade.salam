واردسازی متاتریدر

فراخوانی fake "_fake.salam"

پایا PORT := 19908

تابع ریشه:
    fake.On("POST"، "/order_check"، 200، `{"retcode":0,"balance":10000.0,"equity":10000.0,"profit":0.0,"margin":108.5,"margin_free":9891.5,"margin_level":9216.0,"comment":"Done"}`)
    fake.On("POST"، "/order_send"، 200، `{"retcode":10009,"deal":55001,"order":66001,"volume":1.0,"price":1.0821,"bid":1.0820,"ask":1.0822,"comment":"Request executed"}`)
    fake.Start(PORT)
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    ناپایا req := متاتریدر.درخواست معامله {}
    req.action = متاتریدر.عملیات معامله فوری
    req.symbol = "EURUSD"
    req.volume = 1.0
    req.order_type = متاتریدر.سفارش خرید
    req.type_filling = متاتریدر.پرشدن‌فوری‌یا‌لغو
    req.type_time = متاتریدر.معتبر‌تا‌لغو
    req.deviation = 20

    chk := متاتریدر.بررسی سفارش(req)
    سرچاپ chk.retcode، chk.margin، chk.margin_free، chk.comment
    سرچاپ fake.Last()

    snd := متاتریدر.ارسال سفارش(req)
    سرچاپ snd.retcode برابر متاتریدر.کد اجرای کامل
    سرچاپ snd.deal، snd.order، snd.volume، snd.price، snd.comment
پایان
