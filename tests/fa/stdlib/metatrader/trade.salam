واردسازی متاتریدر

فراخوانی جعلی "_fake.salam"

ناپایا PORT := 0

تابع ریشه:
    جعلی.ثبت پاسخ("POST"، "/order_check"، 200، `{"retcode":0,"balance":10000.0,"equity":10000.0,"profit":0.0,"margin":108.5,"margin_free":9891.5,"margin_level":9216.0,"comment":"Done"}`)
    جعلی.ثبت پاسخ("POST"، "/order_send"، 200، `{"retcode":10009,"deal":55001,"order":66001,"volume":1.0,"price":1.0821,"bid":1.0820,"ask":1.0822,"comment":"Request executed"}`)
    PORT = جعلی.آغاز آزاد()
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:" + PORT)

    ناپایا درخواست := متاتریدر.درخواست معامله {}
    درخواست.عملیات = متاتریدر.عملیات معامله فوری
    درخواست.نماد = "EURUSD"
    درخواست.حجم = 1.0
    درخواست.نوع سفارش = متاتریدر.سفارش خرید
    درخواست.نوع پرشدن = متاتریدر.پرشدن فوری
    درخواست.نوع زمان = متاتریدر.اعتبار نامحدود
    درخواست.انحراف مجاز = 20

    نتیجه بررسی := متاتریدر.بررسی سفارش(درخواست)
    سرچاپ نتیجه بررسی.کد نتیجه، نتیجه بررسی.حاشیه، نتیجه بررسی.حاشیه آزاد، نتیجه بررسی.یادداشت
    سرچاپ جعلی.آخرین()

    نتیجه ارسال := متاتریدر.ارسال سفارش(درخواست)
    سرچاپ نتیجه ارسال.کد نتیجه برابر متاتریدر.کد اجرای کامل
    سرچاپ نتیجه ارسال.شماره معامله، نتیجه ارسال.شماره سفارش، نتیجه ارسال.حجم، نتیجه ارسال.قیمت، نتیجه ارسال.یادداشت
پایان
