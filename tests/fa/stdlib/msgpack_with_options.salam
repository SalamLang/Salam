بسته ریشه

واردسازی فشرده سازی
واردسازی کدگذاری.مسج‌پک
واردسازی کدگذاری.مقدار

تابع ریشه:
    long := "0123456789012345678901234567890123456789"
    compact := مسج‌پک.سریال سازی سفارشی(مقدار.مقدار رشته(long)، مسج‌پک.گزینه‌های مسج‌پک { قالب کوتاه رشته = درست })
    wide := مسج‌پک.سریال سازی سفارشی(مقدار.مقدار رشته(long)، مسج‌پک.گزینه‌های مسج‌پک { قالب کوتاه رشته = نادرست })
    سرچاپ فشرده سازی.طول بافر(compact)، فشرده سازی.دریافت بایت(compact، 0)، فشرده سازی.طول بافر(wide)، فشرده سازی.دریافت بایت(wide، 0)
    سرچاپ فشرده سازی.برابری بافر(compact، مسج‌پک.سریال سازی(مقدار.مقدار رشته(long)))

    تلاش:
        back := مسج‌پک.واسریال سازی(wide)
        سرچاپ مقدار.به رشته(back) برابر long
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان

    ناپایا raw := فشرده سازی.بافر بایت جدید()
    هر b در [146، 1، 163، 97، 98، 99]:
        فشرده سازی.افزودن بایت(raw، b)
    پایان
    تلاش:
        v := مسج‌پک.واسریال سازی بایت‌ها(raw.داده، raw.طول)
        سرچاپ مقدار.آرایه است(v)، مقدار.طول آرایه(v)، مقدار.به صحیح(مقدار.عضو آرایه(v، 0))، مقدار.به رشته(مقدار.عضو آرایه(v، 1))
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    تلاش:
        _ := مسج‌پک.واسریال سازی بایت‌ها(raw.داده، 3)
        سرچاپ "decoded"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.اتمام ناگهانی)، e.به رشته()
    پایان
    تلاش:
        _ := مسج‌پک.واسریال سازی بایت‌ها(raw.داده، 0)
        سرچاپ "decoded"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.اتمام ناگهانی)، e.به رشته()
    پایان
پایان
