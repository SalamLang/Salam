بسته ریشه

واردسازی فشرده سازی
واردسازی کدگذاری.مسج‌پک
واردسازی کدگذاری.مقدار

تابع ریشه:
    رشته بلند := "0123456789012345678901234567890123456789"
    فشرده := مسج‌پک.سریال سازی سفارشی(مقدار.مقدار رشته(رشته بلند)، مسج‌پک.گزینه‌های مسج‌پک { قالب کوتاه رشته = درست })
    گسترده := مسج‌پک.سریال سازی سفارشی(مقدار.مقدار رشته(رشته بلند)، مسج‌پک.گزینه‌های مسج‌پک { قالب کوتاه رشته = نادرست })
    سرچاپ فشرده سازی.طول بافر(فشرده)، فشرده سازی.دریافت بایت(فشرده، 0)، فشرده سازی.طول بافر(گسترده)، فشرده سازی.دریافت بایت(گسترده، 0)
    سرچاپ فشرده سازی.برابری بافر(فشرده، مسج‌پک.سریال سازی(مقدار.مقدار رشته(رشته بلند)))

    تلاش:
        بازگشتی := مسج‌پک.واسریال سازی(گسترده)
        سرچاپ مقدار.به رشته(بازگشتی) برابر رشته بلند
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان

    ناپایا بایت خام := فشرده سازی.بافر بایت جدید()
    هر b در [146، 1، 163، 97، 98، 99]:
        فشرده سازی.افزودن بایت(بایت خام، b)
    پایان
    تلاش:
        v := مسج‌پک.واسریال سازی بایت‌ها(بایت خام.داده، بایت خام.طول)
        سرچاپ مقدار.آرایه است(v)، مقدار.طول آرایه(v)، مقدار.به صحیح(مقدار.عضو آرایه(v، 0))، مقدار.به رشته(مقدار.عضو آرایه(v، 1))
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    تلاش:
        _ := مسج‌پک.واسریال سازی بایت‌ها(بایت خام.داده، 3)
        سرچاپ "decoded"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.اتمام ناگهانی)، e.به رشته()
    پایان
    تلاش:
        _ := مسج‌پک.واسریال سازی بایت‌ها(بایت خام.داده، 0)
        سرچاپ "decoded"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.اتمام ناگهانی)، e.به رشته()
    پایان
پایان
