بسته ریشه

واردسازی شبکه.نتس
واردسازی شبکه.تی سی پی
واردسازی کدگذاری
واردسازی رشته
واردسازی تبدیل

ناپایا SRV := تی سی پی.سرور {}
ناپایا kv_keys := وکتور {} برگردان وکتور<رشته>
ناپایا kv_vals := وکتور {} برگردان وکتور<رشته>
ناپایا kv_dels := وکتور {} برگردان وکتور<منطقی>
ناپایا created := ""
ناپایا flow_replies := 0
ناپایا acks := 0

ساختار Sess:
    همگانی c: تی سی پی.اتصال شبکه = تی سی پی.اتصال شبکه {}
    همگانی buf: رشته = ""
    همگانی alive: منطقی = درست
    همگانی sids: وکتور<صحیح> = وکتور {} برگردان وکتور<صحیح>
    همگانی subjects: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
پایان

تابع fill(s &: Sess):
    chunk := تی سی پی.خواندن(s.c، 65536)
    اگر chunk.طول() برابر 0:
        s.alive = نادرست
    وگرنه:
        s.buf += chunk
    پایان
پایان

تابع line(s &: Sess): رشته:
    تا s.alive:
        at := s.buf.بیاب("\r\n")
        اگر at بزرگتربرابر 0:
            l := s.buf.زیررشته(0، at)
            s.buf = s.buf.زیررشته(at + 2، s.buf.طول() - at - 2)
            برگشت l
        پایان
        fill(s)
    پایان
    برگشت ""
پایان

تابع bytes(s &: Sess، n: صحیح): رشته:
    تا s.alive:
        اگر s.buf.طول() بزرگتربرابر n + 2:
            d := s.buf.زیررشته(0، n)
            s.buf = s.buf.زیررشته(n + 2، s.buf.طول() - n - 2)
            برگشت d
        پایان
        fill(s)
    پایان
    برگشت ""
پایان

تابع say(s &: Sess، text: رشته):
    _ := تی سی پی.نوشتن(s.c، text)
پایان

تابع sid_of(s &: Sess، subject: رشته): صحیح:
    تکرار s.sids.طول() در i:
        اگر s.sids.بگیر(i) بزرگتر 0 و نتس.تطبیق موضوع(s.subjects.بگیر(i)، subject):
            برگشت s.sids.بگیر(i)
        پایان
    پایان
    برگشت 0
پایان

تابع answer(s &: Sess، reply: رشته، data: رشته):
    sid := sid_of(s، reply)
    اگر sid بزرگتر 0:
        say(s، "MSG " + reply + " " + تبدیل.قالب عدد(sid برگردان صحیح۶۴) + " " + تبدیل.قالب عدد(data.طول() برگردان صحیح۶۴) + "\r\n" + data + "\r\n")
    پایان
پایان

تابع last_index(key: رشته): صحیح:
    ناپایا found := 0 - 1
    تکرار kv_keys.طول() در i:
        اگر kv_keys.بگیر(i) برابر key:
            found = i
        پایان
    پایان
    برگشت found
پایان

تابع push_to(s &: Sess، subject: رشته، reply: رشته، data: رشته):
    sid := sid_of(s، subject)
    say(s، "MSG orders.x " + تبدیل.قالب عدد(sid برگردان صحیح۶۴) + " " + reply + " " + تبدیل.قالب عدد(data.طول() برگردان صحیح۶۴) + "\r\n" + data + "\r\n")
پایان

تابع publish_op(s &: Sess، subject: رشته، reply: رشته، hdr: رشته، data: رشته):
    اگر subject برابر "$JS.API.STREAM.CREATE.KV_cfg":
        created = data
        answer(s، reply، `{"config":{"name":"KV_cfg"}}`)
    وگرنه subject.شروع با("$KV.cfg."):
        kv_keys.بیفزا(subject)
        kv_vals.بیفزا(data)
        kv_dels.بیفزا(hdr.بیاب("KV-Operation: DEL") بزرگتربرابر 0)
        answer(s، reply، `{"stream":"KV_cfg","seq":` + تبدیل.قالب عدد(kv_keys.طول() برگردان صحیح۶۴) + "}")
    وگرنه subject برابر "$JS.API.STREAM.MSG.GET.KV_cfg":
        at := data.بیاب("$KV.cfg.")
        key := data.زیررشته(at، data.طول() - at - 2)
        idx := last_index(key)
        اگر idx کوچکتر 0:
            answer(s، reply، `{"error":{"code":404,"err_code":10037,"description":"no message found"}}`)
        وگرنه:
            ناپایا body := `{"message":{"subject":"` + key + `","seq":` + تبدیل.قالب عدد((idx + 1) برگردان صحیح۶۴) + `,"data":"` + کدگذاری.کدگذاری پایه۶۴(kv_vals.بگیر(idx)) + `"`
            اگر kv_dels.بگیر(idx):
                body += `,"hdrs":"` + کدگذاری.کدگذاری پایه۶۴("NATS/1.0\r\nKV-Operation: DEL\r\n\r\n") + `"`
            پایان
            answer(s، reply، body + "}}")
        پایان
    وگرنه subject برابر "$JS.API.CONSUMER.DURABLE.CREATE.ORDERS.push":
        created = data
        answer(s، reply، `{"name":"push"}`)
        hb := "NATS/1.0 100 FlowControl Request\r\n\r\n"
        sid := sid_of(s، "deliver.push")
        say(s، "HMSG deliver.push " + تبدیل.قالب عدد(sid برگردان صحیح۶۴) + " $JS.FC.1 " + تبدیل.قالب عدد(hb.طول() برگردان صحیح۶۴) + " " + تبدیل.قالب عدد(hb.طول() برگردان صحیح۶۴) + "\r\n" + hb + "\r\n")
        push_to(s، "deliver.push"، "$JS.ACK.ORDERS.push.1.1.1.0.0"، "first")
        push_to(s، "deliver.push"، "$JS.ACK.ORDERS.push.1.2.2.0.0"، "second")
    وگرنه subject.شروع با("$JS.FC."):
        flow_replies++
    وگرنه subject.شروع با("$JS.ACK."):
        acks++
    وگرنه subject برابر "$test.acks":
        answer(s، reply، تبدیل.قالب عدد(acks برگردان صحیح۶۴) + "/" + تبدیل.قالب عدد(flow_replies برگردان صحیح۶۴))
    پایان
پایان

تابع serve():
    ناپایا s := Sess {}
    s.c = تی سی پی.پذیرش(SRV)
    say(s، `INFO {"server_id":"FAKE","version":"2.10.0","host":"127.0.0.1","port":4222,"headers":true,"max_payload":1048576,"proto":1,"jetstream":true}` + "\r\n")
    تا s.alive:
        l := line(s)
        اگر l برابر "PING":
            say(s، "PONG\r\n")
        وگرنه l.شروع با("SUB "):
            a := رشته.واژه ها(l)
            s.subjects.بیفزا(a.بگیر(1))
            s.sids.بیفزا(a.بگیر(a.طول() - 1).به صحیح())
        وگرنه l.شروع با("UNSUB "):
            a := رشته.واژه ها(l)
            تکرار s.sids.طول() در i:
                اگر s.sids.بگیر(i) برابر a.بگیر(1).به صحیح() و a.طول() برابر 2:
                    s.sids.بنشان(i، 0)
                پایان
            پایان
        وگرنه l.شروع با("PUB "):
            a := رشته.واژه ها(l)
            n := a.بگیر(a.طول() - 1).به صحیح()
            data := bytes(s، n)
            publish_op(s، a.بگیر(1)، a.طول() برابر 4 ? a.بگیر(2) : ""، ""، data)
        وگرنه l.شروع با("HPUB "):
            a := رشته.واژه ها(l)
            total := a.بگیر(a.طول() - 1).به صحیح()
            hl := a.بگیر(a.طول() - 2).به صحیح()
            blob := bytes(s، total)
            publish_op(s، a.بگیر(1)، a.طول() برابر 5 ? a.بگیر(2) : ""، blob.زیررشته(0، hl)، blob.زیررشته(hl، total - hl))
        پایان
    پایان
    تی سی پی.بستن(s.c)
پایان

تابع ریشه:
    SRV = تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(SRV)
    t := نخ‌ساز(serve)
    ناپایا nc := نتس.برقراری اتصال("nats://127.0.0.1:" + تبدیل.قالب عدد(port برگردان صحیح۶۴))

    سرچاپ "-- key value"
    made := نتس.ساخت سطل کی‌وی(nc، "cfg"، 5، 1000)
    سرچاپ "create:"، made.سالم، created.بیاب(`"name": "KV_cfg"`) بزرگتربرابر 0، created.بیاب(`"$KV.cfg.>"`) بزرگتربرابر 0، created.بیاب(`"max_msgs_per_subject":5`) بزرگتربرابر 0
    p1 := نتس.نوشتن کی‌وی(nc، "cfg"، "color"، "blue"، 1000)
    سرچاپ "put:"، p1.سالم، p1.شماره، p1.جریان
    p2 := نتس.نوشتن کی‌وی(nc، "cfg"، "color"، "green"، 1000)
    سرچاپ "put again:"، p2.شماره
    g := نتس.خواندن کی‌وی(nc، "cfg"، "color"، 1000)
    سرچاپ "get:"، g.سالم، g.یافت شد، g.مقدار، g.ویرایش
    miss := نتس.خواندن کی‌وی(nc، "cfg"، "nothing"، 1000)
    سرچاپ "missing:"، miss.سالم، miss.یافت شد، miss.خطا
    gone := نتس.حذف کی‌وی(nc، "cfg"، "color"، 1000)
    سرچاپ "delete:"، gone.سالم، gone.شماره
    after := نتس.خواندن کی‌وی(nc، "cfg"، "color"، 1000)
    سرچاپ "after delete:"، after.سالم، after.یافت شد، after.حذف شده، after.خطا
    bad := نتس.نوشتن کی‌وی(nc، "cfg"، "a b"، "x"، 1000)
    سرچاپ "bad key:"، bad.سالم، bad.خطا

    سرچاپ "-- push consumer"
    sub := نتس.اشتراک(nc، "deliver.push")
    pc := نتس.افزودن مصرف‌کننده فشاری(nc، "ORDERS"، "push"، "orders.>"، "deliver.push"، ""، 1000)
    سرچاپ "consumer:"، pc.سالم، created.بیاب(`"deliver_subject": "deliver.push"`) بزرگتربرابر 0، created.بیاب(`"flow_control":true`) بزرگتربرابر 0
    ناپایا m := نتس.پیام فشاری بعدی(nc، sub، 1000)
    سرچاپ m.سالم، m.داده، نتس.شماره پیام جریان(m)
    نتس.تایید(nc، m)
    m = نتس.پیام فشاری بعدی(nc، sub، 1000)
    سرچاپ m.سالم، m.داده، نتس.شماره پیام جریان(m)
    نتس.تایید(nc، m)
    none := نتس.پیام فشاری بعدی(nc، sub، 100)
    سرچاپ none.سالم، none.خطا
    tally := نتس.درخواست(nc، "$test.acks"، ""، 1000)
    سرچاپ "acks/flow replies:"، tally.داده
    نتس.بستن(nc)
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(SRV)
پایان
