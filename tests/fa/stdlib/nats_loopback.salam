بسته ریشه

واردسازی شبکه.نتس
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی تبدیل

ناپایا SRV := تی سی پی.سرور {}
ناپایا trace := ""
ناپایا stored := وکتور {} برگردان وکتور<رشته>
ناپایا acked := 0

ساختار Sess:
    همگانی c: تی سی پی.اتصال شبکه = تی سی پی.اتصال شبکه {}
    همگانی buf: رشته = ""
    همگانی alive: منطقی = درست
    همگانی sids: وکتور<صحیح> = وکتور {} برگردان وکتور<صحیح>
    همگانی subjects: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
    همگانی queues: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
    همگانی maxes: وکتور<صحیح> = وکتور {} برگردان وکتور<صحیح>
    همگانی counts: وکتور<صحیح> = وکتور {} برگردان وکتور<صحیح>
    همگانی connect: رشته = ""
    همگانی no_resp: منطقی = نادرست
پایان

تابع fill(s &: Sess):
    chunk := تی سی پی.خواندن(s.c، 65536)
    اگر chunk.طول() برابر 0:
        s.alive = نادرست
    وگرنه:
        s.buf += chunk
    پایان
پایان

تابع line(s &: Sess): رشته:
    تا s.alive:
        at := s.buf.بیاب("\r\n")
        اگر at بزرگتربرابر 0:
            l := s.buf.زیررشته(0، at)
            s.buf = s.buf.زیررشته(at + 2، s.buf.طول() - at - 2)
            برگشت l
        پایان
        fill(s)
    پایان
    برگشت ""
پایان

تابع bytes(s &: Sess، n: صحیح): رشته:
    تا s.alive:
        اگر s.buf.طول() بزرگتربرابر n + 2:
            d := s.buf.زیررشته(0، n)
            s.buf = s.buf.زیررشته(n + 2، s.buf.طول() - n - 2)
            برگشت d
        پایان
        fill(s)
    پایان
    برگشت ""
پایان

تابع say(s &: Sess، text: رشته):
    _ := تی سی پی.نوشتن(s.c، text)
پایان

تابع sid_of(s &: Sess، subject: رشته): صحیح:
    تکرار s.sids.طول() در i:
        اگر s.sids.بگیر(i) بزرگتر 0 و نتس.تطبیق موضوع(s.subjects.بگیر(i)، subject):
            برگشت s.sids.بگیر(i)
        پایان
    پایان
    برگشت 0
پایان

تابع deliver(s &: Sess، subject: رشته، reply: رشته، hdr: رشته، data: رشته): صحیح:
    ناپایا n := 0
    ناپایا groups := وکتور {} برگردان وکتور<رشته>
    دیرکن groups.آزادکن()
    تکرار s.sids.طول() در i:
        sid := s.sids.بگیر(i)
        اگر sid بزرگتر 0 و نتس.تطبیق موضوع(s.subjects.بگیر(i)، subject):
            q := s.queues.بگیر(i)
            ناپایا skip := نادرست
            اگر q نابرابر "":
                تکرار groups.طول() در j:
                    اگر groups.بگیر(j) برابر q:
                        skip = درست
                    پایان
                پایان
                groups.بیفزا(q)
            پایان
            اگر وارونه skip:
                head := subject + " " + تبدیل.قالب عدد(sid برگردان صحیح۶۴) + (reply نابرابر "" ? " " + reply : "")
                اگر hdr برابر "":
                    say(s، "MSG " + head + " " + تبدیل.قالب عدد(data.طول() برگردان صحیح۶۴) + "\r\n" + data + "\r\n")
                وگرنه:
                    say(s، "HMSG " + head + " " + تبدیل.قالب عدد(hdr.طول() برگردان صحیح۶۴) + " " + تبدیل.قالب عدد((hdr.طول() + data.طول()) برگردان صحیح۶۴) + "\r\n" + hdr + data + "\r\n")
                پایان
                n++
                s.counts.بنشان(i، s.counts.بگیر(i) + 1)
                اگر s.maxes.بگیر(i) بزرگتر 0 و s.counts.بگیر(i) بزرگتربرابر s.maxes.بگیر(i):
                    s.sids.بنشان(i، 0)
                پایان
            پایان
        پایان
    پایان
    برگشت n
پایان

تابع answer(s &: Sess، reply: رشته، data: رشته):
    sid := sid_of(s، reply)
    اگر sid بزرگتر 0:
        say(s، "MSG " + reply + " " + تبدیل.قالب عدد(sid برگردان صحیح۶۴) + " " + تبدیل.قالب عدد(data.طول() برگردان صحیح۶۴) + "\r\n" + data + "\r\n")
    پایان
پایان

تابع js_reply(s &: Sess، subject: رشته، reply: رشته، data: رشته):
    اگر subject برابر "$JS.API.STREAM.CREATE.ORDERS":
        answer(s، reply، `{"type":"io.نتس.جت‌استریم.api.v1.stream_create_response","config":{"name":"ORDERS"}}`)
    وگرنه subject برابر "$JS.API.STREAM.INFO.ORDERS":
        st := `{"messages":` + تبدیل.قالب عدد(stored.طول() برگردان صحیح۶۴) + `,"bytes":10,"first_seq":1,"last_seq":` + تبدیل.قالب عدد(stored.طول() برگردان صحیح۶۴) + `,"consumer_count":1}`
        answer(s، reply، `{"config":{"name":"ORDERS"},"state":` + st + "}")
    وگرنه subject برابر "$JS.API.CONSUMER.DURABLE.CREATE.ORDERS.worker":
        answer(s، reply، `{"name":"worker"}`)
    وگرنه subject.شروع با("$JS.API.CONSUMER.MSG.NEXT.ORDERS.worker"):
        want := json_batch(data)
        ناپایا sent := 0
        تکرار stored.طول() در i:
            اگر sent کوچکتر want و stored.بگیر(i) نابرابر "":
                seq := تبدیل.قالب عدد((i + 1) برگردان صحیح۶۴)
                sid := sid_of(s، reply)
                body := stored.بگیر(i)
                rp := "$JS.ACK.ORDERS.worker.1." + seq + "." + seq + ".0.0"
                say(s، "MSG orders.new " + تبدیل.قالب عدد(sid برگردان صحیح۶۴) + " " + rp + " " + تبدیل.قالب عدد(body.طول() برگردان صحیح۶۴) + "\r\n" + body + "\r\n")
                sent++
            پایان
        پایان
        اگر sent برابر 0:
            hdr := "NATS/1.0 404 No Messages\r\n\r\n"
            say(s، "HMSG " + reply + " " + تبدیل.قالب عدد(sid_of(s، reply) برگردان صحیح۶۴) + " " + تبدیل.قالب عدد(hdr.طول() برگردان صحیح۶۴) + " " + تبدیل.قالب عدد(hdr.طول() برگردان صحیح۶۴) + "\r\n" + hdr + "\r\n")
        پایان
    وگرنه:
        answer(s، reply، `{"error":{"code":503,"err_code":10039,"description":"jetstream not enabled"}}`)
    پایان
پایان

تابع json_batch(data: رشته): صحیح:
    at := data.بیاب(`"batch":`)
    اگر at کوچکتر 0:
        برگشت 1
    پایان
    rest := data.زیررشته(at + 8، data.طول() - at - 8)
    ناپایا end_at := rest.بیاب(",")
    اگر end_at کوچکتر 0:
        end_at = rest.بیاب("}")
    پایان
    برگشت rest.زیررشته(0، end_at).به صحیح()
پایان

تابع publish_op(s &: Sess، subject: رشته، reply: رشته، hdr: رشته، data: رشته):
    اگر subject برابر "$test.connect" و reply نابرابر "":
        answer(s، reply، s.connect)
        برگشت
    پایان
    اگر subject.شروع با("$JS.API.") و reply نابرابر "":
        js_reply(s، subject، reply، data)
        برگشت
    پایان
    اگر subject.شروع با("$JS.ACK."):
        acked++
        برگشت
    پایان
    اگر subject برابر "$test.acks" و reply نابرابر "":
        answer(s، reply، تبدیل.قالب عدد(acked برگردان صحیح۶۴))
        برگشت
    پایان
    اگر subject.شروع با("orders.") و reply نابرابر "":
        stored.بیفزا(data)
        answer(s، reply، `{"stream":"ORDERS","seq":` + تبدیل.قالب عدد(stored.طول() برگردان صحیح۶۴) + "}")
        برگشت
    پایان
    اگر subject برابر "svc.echo" و reply نابرابر "":
        answer(s، reply، "re:" + data)
        برگشت
    پایان
    اگر subject برابر "silent":
        برگشت
    پایان
    got := deliver(s، subject، reply، hdr، data)
    اگر got برابر 0 و reply نابرابر "" و s.no_resp:
        h := "NATS/1.0 503\r\n\r\n"
        sid := sid_of(s، reply)
        اگر sid بزرگتر 0:
            say(s، "HMSG " + reply + " " + تبدیل.قالب عدد(sid برگردان صحیح۶۴) + " " + تبدیل.قالب عدد(h.طول() برگردان صحیح۶۴) + " " + تبدیل.قالب عدد(h.طول() برگردان صحیح۶۴) + "\r\n" + h + "\r\n")
        پایان
    پایان
پایان

تابع serve():
    ناپایا s := Sess {}
    s.c = تی سی پی.پذیرش(SRV)
    say(s، `INFO {"server_id":"FAKE","server_name":"fake","version":"2.10.0","host":"127.0.0.1","port":4222,"headers":true,"max_payload":1048576,"proto":1,"jetstream":true,"client_id":7}` + "\r\n")
    تا s.alive:
        l := line(s)
        اگر l.شروع با("CONNECT "):
            s.connect = l.زیررشته(8، l.طول() - 8)
            s.no_resp = s.connect.بیاب(`"no_responders": true`) بزرگتربرابر 0
        وگرنه l برابر "PING":
            say(s، "PONG\r\n")
        وگرنه l.شروع با("SUB "):
            a := رشته.واژه ها(l)
            اگر a.طول() برابر 4:
                s.subjects.بیفزا(a.بگیر(1))
                s.queues.بیفزا(a.بگیر(2))
                s.maxes.بیفزا(0)
                s.counts.بیفزا(0)
                s.sids.بیفزا(a.بگیر(3).به صحیح())
            وگرنه:
                s.subjects.بیفزا(a.بگیر(1))
                s.queues.بیفزا("")
                s.maxes.بیفزا(0)
                s.counts.بیفزا(0)
                s.sids.بیفزا(a.بگیر(2).به صحیح())
            پایان
        وگرنه l.شروع با("UNSUB "):
            a := رشته.واژه ها(l)
            تکرار s.sids.طول() در i:
                اگر s.sids.بگیر(i) برابر a.بگیر(1).به صحیح():
                    اگر a.طول() بزرگتر 2:
                        s.maxes.بنشان(i، a.بگیر(2).به صحیح())
                    وگرنه:
                        s.sids.بنشان(i، 0)
                    پایان
                پایان
            پایان
        وگرنه l.شروع با("PUB "):
            a := رشته.واژه ها(l)
            n := a.بگیر(a.طول() - 1).به صحیح()
            data := bytes(s، n)
            publish_op(s، a.بگیر(1)، a.طول() برابر 4 ? a.بگیر(2) : ""، ""، data)
        وگرنه l.شروع با("HPUB "):
            a := رشته.واژه ها(l)
            total := a.بگیر(a.طول() - 1).به صحیح()
            hl := a.بگیر(a.طول() - 2).به صحیح()
            blob := bytes(s، total)
            publish_op(s، a.بگیر(1)، a.طول() برابر 5 ? a.بگیر(2) : ""، blob.زیررشته(0، hl)، blob.زیررشته(hl، total - hl))
        پایان
    پایان
    تی سی پی.بستن(s.c)
پایان

تابع note(m: نتس.پیام):
    trace += m.موضوع + "=" + m.داده + ";"
پایان

تابع shout(m: نتس.پیام): رشته:
    برگشت رشته.بزرگ(m.داده)
پایان

تابع ریشه:
    SRV = تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(SRV)
    t := نخ‌ساز(serve)

    سرچاپ "-- subjects and headers"
    سرچاپ نتس.موضوع معتبر("a.b.c")، نتس.موضوع معتبر("a..b")، نتس.موضوع معتبر("a b")، نتس.موضوع معتبر(".a")، نتس.موضوع معتبر("")
    سرچاپ نتس.تطبیق موضوع("a.*.c"، "a.b.c")، نتس.تطبیق موضوع("a.*"، "a.b.c")، نتس.تطبیق موضوع("a.>"، "a.b.c")، نتس.تطبیق موضوع("a.>"، "a")، نتس.تطبیق موضوع("a.b"، "a.b")
    ناپایا h := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(h، "Trace-Id"، "abc")
    نتس.افزودن سرآیند(h، "Tag"، "one")
    نتس.افزودن سرآیند(h، "Tag"، "two")
    سرچاپ نتس.گرفتن سرآیند(h، "trace-id")، نتس.مقدارهای سرآیند(h، "TAG").طول()، نتس.سرآیند دارد(h، "nope")
    نتس.تنظیم سرآیند(h، "Tag"، "only")
    سرچاپ نتس.شمار سرآیند(h)
    enc := نتس.رمزگذاری سرآیند(h)
    سرچاپ رشته.جایگزینی(enc، "\r\n"، "|")
    ناپایا code := 0
    ناپایا text := ""
    back := نتس.تجزیه سرآیند("NATS/1.0 503 No Responders\r\nA: 1\r\nB: two words\r\n\r\n"، code، text)
    سرچاپ code، text، نتس.گرفتن سرآیند(back، "b")، نتس.شمار سرآیند(back)

    سرچاپ "-- connect"
    ناپایا opts := نتس.گزینه های پیش‌فرض()
    opts.نام = "tester"
    opts.کاربر = "alice"
    opts.گذرواژه = "pw"
    ناپایا nc := نتس.برقراری اتصال با گزینه("nats://127.0.0.1:" + تبدیل.قالب عدد(port برگردان صحیح۶۴)، opts)
    سرچاپ "connected:"، نتس.وصل است(nc)، "closed:"، نتس.بسته شده است(nc)
    سرچاپ "server:"، nc.اطلاعات.شناسه کارگزار، nc.اطلاعات.نگارش، nc.اطلاعات.سرآیند پشتیبانی، nc.اطلاعات.بیشینه اندازه بار، nc.اطلاعات.جت‌استریم
    sent := نتس.درخواست(nc، "$test.connect"، ""، 1000)
    سرچاپ "connect has name:"، sent.داده.بیاب(`"name": "tester"`) بزرگتربرابر 0، "user:"، sent.داده.بیاب(`"user": "alice"`) بزرگتربرابر 0، "lang:"، sent.داده.بیاب(`"lang": "salam"`) بزرگتربرابر 0، "headers:"، sent.داده.بیاب(`"headers": true`) بزرگتربرابر 0

    سرچاپ "-- pub/sub"
    sub := نتس.اشتراک(nc، "greet.*")
    نتس.انتشار(nc، "greet.bob"، "hello bob")
    نتس.انتشار(nc، "other"، "ignored")
    ناپایا m := نتس.پیام بعدی(nc، sub، 1000)
    سرچاپ m.سالم، m.موضوع، m.داده، m.پاسخ به برابر ""
    none := نتس.پیام بعدی(nc، sub، 100)
    سرچاپ none.سالم، none.خطا
    ناپایا hh := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(hh، "K"، "v1")
    نتس.افزودن سرآیند(hh، "K"، "v2")
    نتس.انتشار با سرآیند(nc، "greet.hdr"، hh، "with headers")
    m = نتس.پیام بعدی(nc، sub، 1000)
    سرچاپ m.سالم، m.داده، نتس.مقدارهای سرآیند(m.سرآیند، "k").طول()، نتس.گرفتن سرآیند(m.سرآیند، "K")
    نتس.انتشار(nc، "greet.multi"، "line1\r\nline2\nline3")
    m = نتس.پیام بعدی(nc، sub، 1000)
    سرچاپ رشته.جایگزینی(رشته.جایگزینی(m.داده، "\r\n"، "|")، "\n"، "/")
    ناپایا big := ""
    تکرار 2000:
        big += "0123456789abcdefghij0123456789abcdefghij"
    پایان
    نتس.انتشار(nc، "greet.big"، big)
    m = نتس.پیام بعدی(nc، sub، 2000)
    سرچاپ "big:"، m.سالم، m.داده.طول()، m.داده برابر big
    سرچاپ "pending:"، نتس.صف مانده(nc، sub)، "subs:"، نتس.شمار اشتراک(nc)

    سرچاپ "-- queue, handler, replier"
    q1 := نتس.اشتراک صف(nc، "work"، "pool")
    q2 := نتس.اشتراک صف(nc، "work"، "pool")
    نتس.انتشار(nc، "work"، "job1")
    نتس.انتشار(nc، "work"، "job2")
    نتس.تخلیه(nc، 1000)
    سرچاپ "queue split:"، نتس.صف مانده(nc، q1) + نتس.صف مانده(nc، q2)، نتس.صف مانده(nc، q2)
    نتس.اشتراک با دستگیره(nc، "events.>"، ""، (m: نتس.پیام): note(m) پایان)
    نتس.انتشار(nc، "events.a.b"، "x")
    نتس.انتشار(nc، "events.c"، "y")
    نتس.تخلیه(nc، 1000)
    سرچاپ "handler trace:"، trace
    نتس.اشتراک پاسخگو(nc، "svc.up"، ""، (m: نتس.پیام): برگشت shout(m) پایان)
    ناپایا r := نتس.درخواست(nc، "svc.up"، "quiet"، 1000)
    سرچاپ "replier:"، r.سالم، r.داده
    نتس.تخلیه(nc، 1000)

    سرچاپ "-- request/reply"
    r = نتس.درخواست(nc، "svc.echo"، "ping"، 1000)
    سرچاپ r.سالم، r.داده
    r = نتس.درخواست(nc، "nobody.home"، "x"، 1000)
    سرچاپ r.سالم، r.خطا
    r = نتس.درخواست(nc، "silent"، "x"، 150)
    سرچاپ r.سالم، r.خطا
    inbox := نتس.صندوق تازه(nc)
    سرچاپ "inbox prefix:"، inbox.شروع با("_INBOX.")، inbox.طول()
    rs := نتس.اشتراک(nc، "ask")
    ri := نتس.اشتراک(nc، "answers")
    نتس.انتشار درخواست(nc، "ask"، "answers"، "question")
    ask := نتس.پیام بعدی(nc، rs، 1000)
    سرچاپ "ask:"، ask.داده، ask.پاسخ به
    نتس.پاسخ(nc، ask، "42")
    reply_msg := نتس.پیام بعدی(nc، ri، 1000)
    سرچاپ "answer:"، reply_msg.داده

    سرچاپ "-- unsubscribe"
    au := نتس.اشتراک(nc، "auto")
    نتس.لغو خودکار اشتراک(nc، au، 2)
    نتس.انتشار(nc، "auto"، "1")
    نتس.انتشار(nc، "auto"، "2")
    نتس.انتشار(nc، "auto"، "3")
    نتس.تخلیه(nc، 1000)
    سرچاپ "auto:"، نتس.تحویل شده(nc، au)، نتس.صف مانده(nc، au)، نتس.اشتراک فعال است(nc، au)
    نتس.لغو اشتراک(nc، sub)
    سرچاپ "after unsub:"، نتس.اشتراک فعال است(nc، sub)
    سرچاپ "bad subject:"، نتس.انتشار(nc، "a b"، "x")، nc.خطا

    سرچاپ "-- jetstream"
    subjects := وکتور {} برگردان وکتور<رشته>
    subjects.بیفزا("orders.*")
    cr := نتس.افزودن جریان(nc، "ORDERS"، subjects، 1000)
    سرچاپ "stream:"، cr.سالم
    a1 := نتس.انتشار جت‌استریم(nc، "orders.new"، "order-1"، 1000)
    a2 := نتس.انتشار جت‌استریم(nc، "orders.new"، "order-2"، 1000)
    سرچاپ "acks:"، a1.سالم، a1.جریان، a1.شماره، a2.شماره، a2.تکراری
    info := نتس.اطلاعات جریان(nc، "ORDERS"، 1000)
    سرچاپ "info:"، info.سالم، info.پیام ها، info.واپسین شماره، info.مصرف‌کننده ها
    cc := نتس.افزودن مصرف‌کننده(nc، "ORDERS"، "worker"، "orders.*"، 1000)
    سرچاپ "consumer:"، cc.سالم
    batch := نتس.واکشی(nc، "ORDERS"، "worker"، 5، 500)
    سرچاپ "fetched:"، batch.پیام ها.طول()، batch.خطا برابر ""
    هر fm در batch.پیام ها:
        سرچاپ fm.داده، نتس.شماره پیام جریان(fm)
        نتس.تایید(nc، fm)
    پایان
    ak := نتس.درخواست(nc، "$test.acks"، ""، 1000)
    سرچاپ "acked:"، ak.داده
    missing := نتس.درخواست جت‌استریم(nc، "STREAM.INFO.NOPE"، ""، 1000)
    سرچاپ "error:"، missing.سالم، missing.کد، missing.خطا

    سرچاپ "-- limits"
    huge := رشته.تکرار("0123456789abcdefghij0123456789abcdefghij0123456789abcdefghij"، 20000)
    سرچاپ "too big:"، نتس.انتشار(nc، "big"، huge)، nc.خطا، نتس.بیشینه اندازه بار(nc)

    سرچاپ "-- drain"
    نتس.اشتراک با دستگیره(nc، "last.*"، ""، (m: نتس.پیام): note(m) پایان)
    نتس.انتشار(nc، "last.one"، "bye")
    سرچاپ "drained:"، نتس.تخلیه کامل(nc، 1000)
    سرچاپ "closed:"، نتس.بسته شده است(nc)، نتس.وصل است(nc)
    سرچاپ "after drain:"، trace.بیاب("last.one=bye") بزرگتربرابر 0
    سرچاپ "publish when closed:"، نتس.انتشار(nc، "x"، "y")، nc.خطا
    نتس.بستن(nc)

    سرچاپ "-- connect failure"
    dead := نتس.برقراری اتصال("nats://127.0.0.1:1")
    سرچاپ dead.سالم، نتس.بسته شده است(dead)، نتس.آخرین خطا(dead).شروع با("could not connect")
    bad := نتس.برقراری اتصال("ftp://host")
    سرچاپ bad.سالم، نتس.آخرین خطا(bad)

    نخ‌پیوند(t)
    تی سی پی.بستن سرور(SRV)
پایان
