بسته ریشه

واردسازی شبکه.نتس
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی تبدیل

ناپایا SRV := تی سی پی.سرور {}
ناپایا sessions := 0

ساختار Sess:
    همگانی c: تی سی پی.اتصال شبکه = تی سی پی.اتصال شبکه {}
    همگانی buf: رشته = ""
    همگانی alive: منطقی = درست
    همگانی sids: وکتور<صحیح> = وکتور {} برگردان وکتور<صحیح>
    همگانی subjects: وکتور<رشته> = وکتور {} برگردان وکتور<رشته>
    همگانی maxes: وکتور<صحیح> = وکتور {} برگردان وکتور<صحیح>
    همگانی counts: وکتور<صحیح> = وکتور {} برگردان وکتور<صحیح>
پایان

تابع fill(s &: Sess):
    chunk := تی سی پی.خواندن(s.c، 65536)
    اگر chunk.طول() برابر 0:
        s.alive = نادرست
    وگرنه:
        s.buf += chunk
    پایان
پایان

تابع line(s &: Sess): رشته:
    تا s.alive:
        at := s.buf.بیاب("\r\n")
        اگر at بزرگتربرابر 0:
            l := s.buf.زیررشته(0، at)
            s.buf = s.buf.زیررشته(at + 2، s.buf.طول() - at - 2)
            برگشت l
        پایان
        fill(s)
    پایان
    برگشت ""
پایان

تابع bytes(s &: Sess، n: صحیح): رشته:
    تا s.alive:
        اگر s.buf.طول() بزرگتربرابر n + 2:
            d := s.buf.زیررشته(0، n)
            s.buf = s.buf.زیررشته(n + 2، s.buf.طول() - n - 2)
            برگشت d
        پایان
        fill(s)
    پایان
    برگشت ""
پایان

تابع say(s &: Sess، text: رشته):
    _ := تی سی پی.نوشتن(s.c، text)
پایان

تابع deliver(s &: Sess، subject: رشته، data: رشته):
    تکرار s.sids.طول() در i:
        sid := s.sids.بگیر(i)
        اگر sid بزرگتر 0 و نتس.تطبیق موضوع(s.subjects.بگیر(i)، subject):
            say(s، "MSG " + subject + " " + تبدیل.قالب عدد(sid برگردان صحیح۶۴) + " " + تبدیل.قالب عدد(data.طول() برگردان صحیح۶۴) + "\r\n" + data + "\r\n")
            s.counts.بنشان(i، s.counts.بگیر(i) + 1)
            اگر s.maxes.بگیر(i) بزرگتر 0 و s.counts.بگیر(i) بزرگتربرابر s.maxes.بگیر(i):
                s.sids.بنشان(i، 0)
            پایان
        پایان
    پایان
پایان

تابع serve_one():
    ناپایا s := Sess {}
    s.c = تی سی پی.پذیرش(SRV)
    sessions += 1
    say(s، `INFO {"server_id":"FAKE","version":"2.10.0","host":"127.0.0.1","port":4222,"headers":true,"max_payload":1048576,"proto":1}` + "\r\n")
    تا s.alive:
        l := line(s)
        اگر l برابر "PING":
            say(s، "PONG\r\n")
        وگرنه l.شروع با("SUB "):
            a := رشته.واژه ها(l)
            s.subjects.بیفزا(a.بگیر(1))
            s.maxes.بیفزا(0)
            s.counts.بیفزا(0)
            s.sids.بیفزا(a.بگیر(a.طول() - 1).به صحیح())
        وگرنه l.شروع با("UNSUB "):
            a := رشته.واژه ها(l)
            تکرار s.sids.طول() در i:
                اگر s.sids.بگیر(i) برابر a.بگیر(1).به صحیح():
                    اگر a.طول() بزرگتر 2:
                        s.maxes.بنشان(i، a.بگیر(2).به صحیح())
                    وگرنه:
                        s.sids.بنشان(i، 0)
                    پایان
                پایان
            پایان
        وگرنه l.شروع با("PUB "):
            a := رشته.واژه ها(l)
            n := a.بگیر(a.طول() - 1).به صحیح()
            data := bytes(s، n)
            اگر a.بگیر(1) برابر "drop":
                s.alive = نادرست
            وگرنه:
                deliver(s، a.بگیر(1)، data)
            پایان
        پایان
    پایان
    تی سی پی.بستن(s.c)
پایان

تابع serve():
    serve_one()
    serve_one()
    serve_one()
    serve_one()
پایان

تابع wait_lost(nc &: نتس.اتصال نتس): منطقی:
    تکرار 100:
        اگر نتس.در حال اتصال دوباره(nc) یا نتس.بسته شده است(nc):
            برگشت درست
        پایان
        نتس.پردازش(nc، 50)
    پایان
    برگشت نادرست
پایان

تابع ریشه:
    SRV = تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(SRV)
    url := "nats://127.0.0.1:" + تبدیل.قالب عدد(port برگردان صحیح۶۴)
    t := نخ‌ساز(serve)

    سرچاپ "-- reconnect with a pool"
    ناپایا opts := نتس.گزینه های پیش‌فرض()
    opts.بیشینه اتصال دوباره = 5
    opts.انتظار اتصال دوباره میلی‌ثانیه = 20
    opts.کارگزارها.بیفزا("nats://127.0.0.1:1")
    ناپایا nc := نتس.برقراری اتصال با گزینه(url، opts)
    سرچاپ "connected:"، نتس.وصل است(nc)، نتس.شمار اتصال دوباره(nc)
    all := نتس.اشتراک(nc، "a.*")
    two := نتس.اشتراک(nc، "b")
    نتس.لغو خودکار اشتراک(nc، two، 3)
    نتس.انتشار(nc، "b"، "b1")
    نتس.انتشار(nc، "b"، "b2")
    ناپایا m := نتس.پیام بعدی(nc، two، 1000)
    سرچاپ m.داده
    m = نتس.پیام بعدی(nc، two، 1000)
    سرچاپ m.داده

    نتس.انتشار(nc، "drop"، "")
    سرچاپ "lost:"، wait_lost(nc)، نتس.وصل است(nc)، نتس.در حال اتصال دوباره(nc)
    queued := نتس.انتشار(nc، "a.x"، "while down")
    سرچاپ "buffered:"، queued، نتس.بایت‌های بافر شده(nc) بزرگتر 0
    m = نتس.پیام بعدی(nc، all، 3000)
    سرچاپ "after reconnect:"، m.سالم، m.موضوع، m.داده
    سرچاپ "reconnects:"، نتس.شمار اتصال دوباره(nc)، "connected:"، نتس.وصل است(nc)، "buffered:"، نتس.بایت‌های بافر شده(nc)
    سرچاپ "sessions:"، sessions

    نتس.انتشار(nc، "b"، "b3")
    m = نتس.پیام بعدی(nc، two، 1000)
    سرچاپ m.داده، نتس.اشتراک فعال است(nc، two)
    نتس.انتشار(nc، "b"، "b4")
    سرچاپ "flush:"، نتس.تخلیه(nc، 1000)
    سرچاپ "b after limit:"، نتس.صف مانده(nc، two)، نتس.تحویل شده(nc، two)

    نتس.انتشار(nc، "drop"، "")
    سرچاپ "lost again:"، wait_lost(nc)
    سرچاپ "flush over reconnect:"، نتس.تخلیه(nc، 3000)، نتس.شمار اتصال دوباره(nc)
    نتس.انتشار(nc، "a.y"، "second")
    m = نتس.پیام بعدی(nc، all، 1000)
    سرچاپ m.سالم، m.داده
    نتس.بستن(nc)

    سرچاپ "-- giving up"
    ناپایا o2 := نتس.گزینه های پیش‌فرض()
    o2.بیشینه اتصال دوباره = 2
    o2.انتظار اتصال دوباره میلی‌ثانیه = 10
    ناپایا gone := نتس.برقراری اتصال با گزینه(url، o2)
    سرچاپ "connected:"، نتس.وصل است(gone)
    نتس.انتشار(gone، "drop"، "")
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(SRV)
    سرچاپ "lost:"، wait_lost(gone)
    z := نتس.اشتراک(gone، "z")
    r := نتس.پیام بعدی(gone، z، 2000)
    سرچاپ r.سالم، r.خطا
    سرچاپ "closed:"، نتس.بسته شده است(gone)، نتس.آخرین خطا(gone)
پایان
