واردسازی ناوبری

تابع ریشه:
    سرچاپ ناوبری.تطبیق("/users/:id"، "/users/42")
    سرچاپ ناوبری.پارامتر("/users/:id"، "/users/42"، "id")
    سرچاپ ناوبری.تطبیق("/users/:id?"، "/users")
    سرچاپ ناوبری.پارامتر("/files/*path"، "/files/a/b.txt"، "path")
    سرچاپ ناوبری.مقدار پرسمان("q=hello+world&page=2"، "q")
    سرچاپ ناوبری.بازگشایی("a%2Fb")
    سرچاپ ناوبری.رتبه("/users/new") بزرگتر ناوبری.رتبه("/users/:id")
    سرچاپ ناوبری.عدد صحیح است("42")
    م := ناوبری.مسیر { نشانی = "/users/42"، پرسمان = "tab=posts"، الگو = "/users/:id" }
    سرچاپ م.نشانی + " " + م.پرسمان + " " + م.الگو
    سرچاپ ناوبری.یکسان سازی("a//b/./c/../d/")
    ناپایا مسیر := ""
    ناپایا پرس := ""
    ناوبری.جداسازی نشانی("/search?q=salam#top"، مسیر، پرس)
    سرچاپ مسیر + " | " + پرس
    سرچاپ ناوبری.حل نشانی("/users/3"، "edit")
    سرچاپ ناوبری.حل نشانی("/users/3"، "..")
    سرچاپ ناوبری.حل نشانی("/users/3"، "?page=2")
    سرچاپ ناوبری.نشانی صفحه(درست، ""، "/about")
    سرچاپ ناوبری.نشانی صفحه(نادرست، "/app"، "/about")
    سرچاپ ناوبری.برداشتن پایه("/app"، "/app/about")
    ناپایا ت := ناوبری.تاریخچه جدید("/")
    ناوبری.افزودن(ت، "/users")
    ناوبری.افزودن(ت، "/users/3")
    سرچاپ ناوبری.کنونی(ت) + " depth " + ناوبری.ژرفا(ت)
    سرچاپ ناوبری.عقب(ت)
    سرچاپ ناوبری.کنونی(ت) + " can go forward " + ناوبری.جلو ممکن(ت)
    ناوبری.جایگزینی(ت، "/teams")
    سرچاپ ناوبری.کنونی(ت) + " can go back " + ناوبری.عقب ممکن(ت)
    سرچاپ ناوبری.جلو(ت)
    ناوبری.بازنشانی(ت، "/home")
    سرچاپ ناوبری.کنونی(ت) + " " + ت.مدخل ها.طول() + " " + ت.جایگاه
پایان
