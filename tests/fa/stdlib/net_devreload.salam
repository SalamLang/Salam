واردسازی شبکه.بازخوانی توسعه
واردسازی رشته

تابع ریشه:
    سرچاپ بازخوانی توسعه.فعال است()
    بازخوانی توسعه.آماده سازی("e1"، "")
    سرچاپ بازخوانی توسعه.فعال است()
    صفحه := بازخوانی توسعه.افزودن به صفحه("<html><head><title>t</title></head><body><p>x</p></body></html>")
    سرچاپ رشته.شامل است(صفحه، "/__salam_hmr")
    سرچاپ رشته.شروع با(صفحه، "<html><head><script data-salam-hmr>")
    سرچاپ رشته.شامل است(صفحه، "</script></body></html>")
    سرچاپ رشته.شامل است(صفحه، "<p>x</p><script data-salam-hmr>")
    ساده := بازخوانی توسعه.افزودن به صفحه("<p>no body</p>")
    سرچاپ رشته.پایان با(ساده، "</script>")
    سرچاپ رشته.شامل است(بازخوانی توسعه.اسکریپت()، "EventSource")
    سرچاپ بازخوانی توسعه.زبان پیام()
    بازخوانی توسعه.تنظیم زبان پیام("fa")
