واردسازی شبکه.بازخوانی توسعه
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی رشته

تابع نبض(ک: صحیح۶۴):
    بازخوانی توسعه.رسیدگی به رویدادها(ک)
پایان

تابع ریشه:
    سرچاپ بازخوانی توسعه.آماده سازی از محیط()
    بازخوانی توسعه.آماده سازی درون برنامه("e9"، "")
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/__salam_hmr"، نبض)
    ناپایا س := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.استفاده(س، م)
    درگاه := اچ تی تی پی.اجرا در پس زمینه با درگاه(س)
    پایه := "http://127.0.0.1:" + رشته.از عدد(درگاه) + "/__salam_hmr"
    اول := اچ تی تی پی.دریافت(پایه)
    سرچاپ اول.وضعیت
    سرچاپ رشته.شامل است(اول.سرصفحه، "text/event-stream")
    سرچاپ رشته.شامل است(اول.بدنه، "\"kind\":\"hello\"")
    بازخوانی توسعه.اعلام تغییر(1)
    دیگر := اچ تی تی پی.درخواست خام("GET"، پایه، "Last-Event-ID: other:0:0\r\n"، "")
    سرچاپ رشته.شامل است(دیگر.بدنه، "\"kind\":\"reload\"")
    عوض := اچ تی تی پی.درخواست خام("GET"، پایه، "Last-Event-ID: e9:0:0\r\n"، "")
    سرچاپ رشته.شامل است(عوض.بدنه، "\"kind\":\"css\"")
پایان
