بسته ریشه

واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.تی سی پی
واردسازی فشرده سازی
واردسازی سیستم عامل
واردسازی ورودی خروجی
واردسازی تی ال اس
واردسازی آزمایش

پایا PORT := 23811

ناپایا raw server := تی سی پی.سرور {}

تابع cookie probe(h: صحیح۶۴):
    all := اچ تی تی پی.کوکی ها(h)
    ctx := اچ تی تی پی.زمینه جدید(h)
    اچ تی تی پی.متن(h، "" + all.اندازه() + " " + اچ تی تی پی.کوکی دارد(h، "sid") + " " + اچ تی تی پی.کوکی دارد(h، "nope") + " " + اچ تی تی پی.کوکی دارد(ctx، "lang") + " " + اچ تی تی پی.کوکی ها(ctx).اندازه())
    اچ تی تی پی.پاک کردن کوکی در مسیر(h، "scoped"، "/admin"، "example.org")
پایان

تابع port probe(h: صحیح۶۴):
    ctx := اچ تی تی پی.زمینه جدید(h)
    conn := اچ تی تی پی.اتصال مربوط به(ctx)
    اچ تی تی پی.متن(h، "" + (اچ تی تی پی.درگاه محلی(h) برابر PORT) + " " + تی سی پی.اتصال معتبر(conn))
پایان

تابع slice(h: صحیح۶۴):
    path := سیستم عامل.پوشه موقت() + "/salam_http_extra.txt"
    اگر اچ تی تی پی.ارسال بخشی از پرونده(h، path، "text/plain"، 6، 5):
        اچ تی تی پی.تنظیم وضعیت(h، 206)
    وگرنه:
        اچ تی تی پی.تنظیم وضعیت(h، 416)
        اچ تی تی پی.متن(h، "bad range")
    پایان
پایان

تابع too far(h: صحیح۶۴):
    path := سیستم عامل.پوشه موقت() + "/salam_http_extra.txt"
    اگر اچ تی تی پی.ارسال بخشی از پرونده(h، path، "text/plain"، 6، 500):
        اچ تی تی پی.تنظیم وضعیت(h، 206)
    وگرنه:
        اچ تی تی پی.تنظیم وضعیت(h، 416)
        اچ تی تی پی.متن(h، "bad range")
    پایان
پایان

تابع echo(h: صحیح۶۴):
    اچ تی تی پی.تنظیم سرصفحه(h، "X-Seen"، "yes")
    اچ تی تی پی.متن(h، اچ تی تی پی.روش(h) + ":" + اچ تی تی پی.سرصفحه(h، "X-Token") + ":" + اچ تی تی پی.بدنه(h))
پایان

تابع own probe(h: صحیح۶۴):
    اچ تی تی پی.متن(h، اچ تی تی پی.مالکیت(h، اچ تی تی پی.روش(h)))
پایان

تابع start server():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/cookies"، cookie probe)
    مسیریاب.دریافت(r، "/port"، port probe)
    مسیریاب.دریافت(r، "/slice"، slice)
    مسیریاب.دریافت(r، "/own"، own probe)
    مسیریاب.دریافت(r، "/far"، too far)
    هر m در ["GET"، "PUT"، "PATCH"، "OPTIONS"، "HEAD"]:
        مسیریاب.روش(r، m، "/echo"، echo)
    پایان
    ناپایا s := اچ تی تی پی.سرور جدید(PORT)
    اچ تی تی پی.پنهان سازی توکن(s)
    اچ تی تی پی.استفاده(s، r)
    آزمایش.ادعای درستی(اچ تی تی پی.اجرا در پس زمینه(s))
پایان

تابع check client verbs():
    url := "http://127.0.0.1:23811/echo"
    ناپایا h := اچ تی تی پی.سرصفحه جدید()
    h.درج("X-Token"، "t9")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(اچ تی تی پی.قرار دادن با(url، "p"، h))، "PUT:t9:p")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(اچ تی تی پی.وصله با(url، "q"، h))، "PATCH:t9:q")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(اچ تی تی پی.گزینه ها با(url، h))، "OPTIONS:t9:")
    head := اچ تی تی پی.سرصفحه با(url، h)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(head)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.دریافت سرصفحه(head، "x-seen")، "yes")
    آزمایش.ادعای شامل بودن(اچ تی تی پی.سرصفحه های خام(head)، "200 OK")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.دریافت سرصفحه(head، "server")، "Salam")

    bytes := اچ تی تی پی.دریافت بایت ها با(url، h)
    آزمایش.ادعای برابری عدد(bytes.وضعیت، 200)
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(bytes.بدنه)، "GET:t9:")
پایان

تابع check forms cookies():
    ناپایا form := اچ تی تی پی.سرصفحه جدید()
    form.درج("q"، "a b&c")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.کدگذاری فرم(form)، "q=a%20b%26c")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.کدگذاری فرم(اچ تی تی پی.سرصفحه جدید())، "")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.سرصفحه کوکی(اچ تی تی پی.سرصفحه جدید())، "")
    ناپایا jar := اچ تی تی پی.سرصفحه جدید()
    jar.درج("lang"، "en")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.سرصفحه کوکی(jar)، "lang=en")
    jar.درج("sid"، "abc")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.سرصفحه کوکی(jar).طول()، 16)

    gone := اچ تی تی پی.کوکی منقضی شده("sid"، "/x"، "example.org")
    آزمایش.ادعای برابری رشته(gone.مسیر، "/x")
    آزمایش.ادعای برابری رشته(gone.دامنه، "example.org")
    آزمایش.ادعای برابری عدد(gone.حداکثر‌عمر، 0 - 1)
    آزمایش.ادعای درستی(gone.دارای‌حداکثر‌عمر)

    ناپایا headers := اچ تی تی پی.سرصفحه جدید()
    headers.درج("Cookie"، "sid=abc; lang=en")
    r := اچ تی تی پی.دریافت با("http://127.0.0.1:23811/cookies"، headers)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(r)، "2 true false true 2")
    lines := اچ تی تی پی.خطوط کوکی(r)
    آزمایش.ادعای برابری عدد(lines.طول()، 1)
    آزمایش.ادعای شامل بودن(lines.بگیر(0)، "scoped=")
    آزمایش.ادعای شامل بودن(lines.بگیر(0)، "Path=/admin")
    آزمایش.ادعای شامل بودن(lines.بگیر(0)، "Domain=example.org")
پایان

تابع check handler helpers():
    r := اچ تی تی پی.دریافت("http://127.0.0.1:23811/port")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(r)، "true true")

    path := سیستم عامل.پوشه موقت() + "/salam_http_extra.txt"
    ورودی خروجی.نوشتن پرونده(path، "hello from a file")
    ناپایا size := 0 برگردان صحیح۶۴
    ناپایا mtime := 0 برگردان صحیح۶۴
    آزمایش.ادعای درستی(اچ تی تی پی.وضعیت پرونده(path، size، mtime))
    آزمایش.ادعای برابری عدد(size برگردان صحیح، 17)
    آزمایش.ادعای نادرستی(اچ تی تی پی.وضعیت پرونده(path + ".missing"، size، mtime))

    part := اچ تی تی پی.دریافت("http://127.0.0.1:23811/slice")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(part)، 206)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(part)، "from ")
    far := اچ تی تی پی.دریافت("http://127.0.0.1:23811/far")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(far)، 416)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(far)، "bad range")
    سیستم عامل.حذف(path)
پایان

تابع responder():
    تکرار 3:
        conn := تی سی پی.پذیرش(raw server)
        _ := تی سی پی.خواندن(conn، 4096)
        تی سی پی.نوشتن اچ تی تی پی(conn، "200 OK"، "text/plain"، "raw reply")
        تی سی پی.بستن(conn)
    پایان
پایان

تابع check raw endpoint():
    raw server = تی سی پی.پیوند(0)
    t := نخ‌ساز(responder)
    ep := اچ تی تی پی.تجزیه نقطه پایانی("http://127.0.0.1:" + تی سی پی.درگاه(raw server))
    آزمایش.ادعای درستی(اچ تی تی پی.نقطه پایانی موفق(ep))
    آزمایش.ادعای نادرستی(اچ تی تی پی.نقطه پایانی موفق(اچ تی تی پی.تجزیه نقطه پایانی("")))
    head := "GET / HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"

    ناپایا a := اچ تی تی پی.ارسال خام با مهلت(ep، head، پوچ، 0، 2000)
    آزمایش.ادعای برابری عدد(a.وضعیت، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.متن پاسخ خام(a)، "raw reply")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.مقدار سرصفحه(a.سرصفحه، "Content-Type")، "text/plain")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.مقدار سرصفحه(a.سرصفحه، "x-missing")، "")
    اچ تی تی پی.آزادسازی پاسخ خام(a)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.متن پاسخ خام(a)، "")

    cfg := تی ال اس.پیکربندی جدید("127.0.0.1")
    ناپایا plain := اچ تی تی پی.ارسال خام با پیکربندی امن(ep، head، پوچ، 0، 2000، cfg)
    آزمایش.ادعای برابری عدد(plain.وضعیت، 200)
    اچ تی تی پی.آزادسازی پاسخ خام(plain)

    old := اچ تی تی پی.سقف پاسخ خام()
    اچ تی تی پی.تنظیم سقف پاسخ خام(10)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.سقف پاسخ خام()، 10)
    ناپایا c := اچ تی تی پی.ارسال خام با مهلت(ep، head، پوچ، 0، 2000)
    آزمایش.ادعای درستی(c.اندازه کوچکتربرابر 10 یا وارونه c.موفق)
    اچ تی تی پی.آزادسازی پاسخ خام(c)
    اچ تی تی پی.تنظیم سقف پاسخ خام(old)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.سقف پاسخ خام()، old)
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(raw server)
پایان

تابع check run tls busy():
    busy := تی سی پی.پیوند(0)
    s := اچ تی تی پی.سرور جدید(تی سی پی.درگاه(busy))
    اچ تی تی پی.اجرای امن(s، "no-such-cert.pem"، "no-such-key.pem")
    تی سی پی.بستن سرور(busy)
پایان

تابع check header limit():
    اچ تی تی پی.بیشینه بایت سرایند(0)
    ناپایا big := اچ تی تی پی.سرصفحه جدید()
    big.درج("X-Big"، "a".تکرار(80000))
    r := اچ تی تی پی.دریافت با("http://127.0.0.1:23811/echo"، big)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(r)، 431)
    اچ تی تی پی.بیشینه بایت سرایند(200000)
    ok := اچ تی تی پی.دریافت با("http://127.0.0.1:23811/echo"، big)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(ok)، 200)
    اچ تی تی پی.بیشینه بایت سرایند(300)
    ناپایا mid := اچ تی تی پی.سرصفحه جدید()
    mid.درج("X-Mid"، "a".تکرار(2000))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت با("http://127.0.0.1:23811/echo"، mid))، 431)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت("http://127.0.0.1:23811/echo"))، 200)
    اچ تی تی پی.بیشینه بایت سرایند(65536)
    owned := اچ تی تی پی.دریافت("http://127.0.0.1:23811/own")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(owned)، "GET")
پایان

تابع ریشه:
    start server()
    check client verbs()
    check forms cookies()
    check handler helpers()
    check raw endpoint()
    check run tls busy()
    check header limit()
    برگشت آزمایش.خلاصه()
پایان
