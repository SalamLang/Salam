بسته ریشه

واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.تی سی پی
واردسازی فشرده سازی
واردسازی سیستم عامل
واردسازی ورودی خروجی
واردسازی تی ال اس
واردسازی آزمایش

ناپایا PORT := 0
ناپایا خادم خام := تی سی پی.سرور {}

تابع بررسی کوکی(h: صحیح۶۴):
    همه کوکی ها := اچ تی تی پی.کوکی ها(h)
    زمینه := اچ تی تی پی.زمینه جدید(h)
    اچ تی تی پی.متن(h، "" + همه کوکی ها.اندازه() + " " + اچ تی تی پی.کوکی دارد(h، "sid") + " " + اچ تی تی پی.کوکی دارد(h، "nope") + " " + اچ تی تی پی.کوکی دارد(زمینه، "lang") + " " + اچ تی تی پی.کوکی ها(زمینه).اندازه())
    اچ تی تی پی.پاک کردن کوکی در مسیر(h، "scoped"، "/admin"، "example.org")
پایان

تابع بررسی درگاه(h: صحیح۶۴):
    زمینه := اچ تی تی پی.زمینه جدید(h)
    اتصال := اچ تی تی پی.اتصال مربوط به(زمینه)
    اچ تی تی پی.متن(h، "" + (اچ تی تی پی.درگاه محلی(h) برابر PORT) + " " + تی سی پی.اتصال معتبر(اتصال))
پایان

تابع بخشی(h: صحیح۶۴):
    مسیر پرونده := سیستم عامل.پوشه موقت() + "/salam_http_extra.txt"
    اگر اچ تی تی پی.ارسال بخشی از پرونده(h، مسیر پرونده، "text/plain"، 6، 5):
        اچ تی تی پی.تنظیم وضعیت(h، 206)
    وگرنه:
        اچ تی تی پی.تنظیم وضعیت(h، 416)
        اچ تی تی پی.متن(h، "bad range")
    پایان
پایان

تابع قطعه دور(h: صحیح۶۴):
    مسیر پرونده := سیستم عامل.پوشه موقت() + "/salam_http_extra.txt"
    اگر اچ تی تی پی.ارسال بخشی از پرونده(h، مسیر پرونده، "text/plain"، 6، 500):
        اچ تی تی پی.تنظیم وضعیت(h، 206)
    وگرنه:
        اچ تی تی پی.تنظیم وضعیت(h، 416)
        اچ تی تی پی.متن(h، "bad range")
    پایان
پایان

تابع پژواک(h: صحیح۶۴):
    اچ تی تی پی.تنظیم سرصفحه(h، "X-Seen"، "yes")
    اچ تی تی پی.متن(h، اچ تی تی پی.روش(h) + ":" + اچ تی تی پی.سرصفحه(h، "X-Token") + ":" + اچ تی تی پی.بدنه(h))
پایان

تابع بررسی مالکیت(h: صحیح۶۴):
    اچ تی تی پی.متن(h، اچ تی تی پی.مالکیت(h، اچ تی تی پی.روش(h)))
پایان

تابع راه اندازی خادم():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/cookies"، بررسی کوکی)
    مسیریاب.دریافت(r، "/port"، بررسی درگاه)
    مسیریاب.دریافت(r، "/slice"، بخشی)
    مسیریاب.دریافت(r، "/own"، بررسی مالکیت)
    مسیریاب.دریافت(r، "/far"، قطعه دور)
    هر m در ["GET"، "PUT"، "PATCH"، "OPTIONS"، "HEAD"]:
        مسیریاب.روش(r، m، "/echo"، پژواک)
    پایان
    ناپایا s := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.پنهان سازی توکن(s)
    اچ تی تی پی.استفاده(s، r)
    PORT = اچ تی تی پی.اجرا در پس زمینه با درگاه(s)
    آزمایش.ادعای درستی(PORT بزرگتر 0)
پایان

تابع بررسی روش های مشتری():
    نشانی := "http://127.0.0.1:" + PORT + "/echo"
    ناپایا h := اچ تی تی پی.سرصفحه جدید()
    h.درج("X-Token"، "t9")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(اچ تی تی پی.قرار دادن با(نشانی، "p"، h))، "PUT:t9:p")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(اچ تی تی پی.وصله با(نشانی، "q"، h))، "PATCH:t9:q")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(اچ تی تی پی.گزینه ها با(نشانی، h))، "OPTIONS:t9:")
    پاسخ سرایند := اچ تی تی پی.سرصفحه با(نشانی، h)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(پاسخ سرایند)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.دریافت سرصفحه(پاسخ سرایند، "x-seen")، "yes")
    آزمایش.ادعای شامل بودن(اچ تی تی پی.سرصفحه های خام(پاسخ سرایند)، "200 OK")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.دریافت سرصفحه(پاسخ سرایند، "server")، "Salam")

    پاسخ بایتی := اچ تی تی پی.دریافت بایت ها با(نشانی، h)
    آزمایش.ادعای برابری عدد(پاسخ بایتی.وضعیت، 200)
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(پاسخ بایتی.بدنه)، "GET:t9:")
پایان

تابع بررسی فرم کوکی():
    ناپایا فرم := اچ تی تی پی.سرصفحه جدید()
    فرم.درج("q"، "a b&c")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.کدگذاری فرم(فرم)، "q=a%20b%26c")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.کدگذاری فرم(اچ تی تی پی.سرصفحه جدید())، "")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.سرصفحه کوکی(اچ تی تی پی.سرصفحه جدید())، "")
    ناپایا ظرف کوکی := اچ تی تی پی.سرصفحه جدید()
    ظرف کوکی.درج("lang"، "en")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.سرصفحه کوکی(ظرف کوکی)، "lang=en")
    ظرف کوکی.درج("sid"، "abc")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.سرصفحه کوکی(ظرف کوکی).طول()، 16)

    کوکی حذفی := اچ تی تی پی.کوکی منقضی شده("sid"، "/x"، "example.org")
    آزمایش.ادعای برابری رشته(کوکی حذفی.مسیر، "/x")
    آزمایش.ادعای برابری رشته(کوکی حذفی.دامنه، "example.org")
    آزمایش.ادعای برابری عدد(کوکی حذفی.حداکثر‌عمر، 0 - 1)
    آزمایش.ادعای درستی(کوکی حذفی.دارای‌حداکثر‌عمر)

    ناپایا سرصفحه ها := اچ تی تی پی.سرصفحه جدید()
    سرصفحه ها.درج("Cookie"، "sid=abc; lang=en")
    r := اچ تی تی پی.دریافت با("http://127.0.0.1:" + PORT + "/cookies"، سرصفحه ها)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(r)، "2 true false true 2")
    خطوط := اچ تی تی پی.خطوط کوکی(r)
    آزمایش.ادعای برابری عدد(خطوط.طول()، 1)
    آزمایش.ادعای شامل بودن(خطوط.بگیر(0)، "scoped=")
    آزمایش.ادعای شامل بودن(خطوط.بگیر(0)، "Path=/admin")
    آزمایش.ادعای شامل بودن(خطوط.بگیر(0)، "Domain=example.org")
پایان

تابع بررسی یاری دهنده ها():
    r := اچ تی تی پی.دریافت("http://127.0.0.1:" + PORT + "/port")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(r)، "true true")

    مسیر پرونده := سیستم عامل.پوشه موقت() + "/salam_http_extra.txt"
    ورودی خروجی.نوشتن پرونده(مسیر پرونده، "hello from a file")
    ناپایا اندازه پرونده := 0 برگردان صحیح۶۴
    ناپایا زمان تغییر := 0 برگردان صحیح۶۴
    آزمایش.ادعای درستی(اچ تی تی پی.وضعیت پرونده(مسیر پرونده، اندازه پرونده، زمان تغییر))
    آزمایش.ادعای برابری عدد(اندازه پرونده برگردان صحیح، 17)
    آزمایش.ادعای نادرستی(اچ تی تی پی.وضعیت پرونده(مسیر پرونده + ".missing"، اندازه پرونده، زمان تغییر))

    قطعه پاسخ := اچ تی تی پی.دریافت("http://127.0.0.1:" + PORT + "/slice")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(قطعه پاسخ)، 206)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(قطعه پاسخ)، "from ")
    پاسخ دور := اچ تی تی پی.دریافت("http://127.0.0.1:" + PORT + "/far")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(پاسخ دور)، 416)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(پاسخ دور)، "bad range")
    سیستم عامل.حذف(مسیر پرونده)
پایان

تابع پاسخگو():
    تکرار 3:
        اتصال := تی سی پی.پذیرش(خادم خام)
        _ := تی سی پی.خواندن(اتصال، 4096)
        تی سی پی.نوشتن اچ تی تی پی(اتصال، "200 OK"، "text/plain"، "raw reply")
        تی سی پی.بستن(اتصال)
    پایان
پایان

تابع بررسی نقطه پایانی خام():
    خادم خام = تی سی پی.پیوند(0)
    t := نخ‌ساز(پاسخگو)
    نقطه := اچ تی تی پی.تجزیه نقطه پایانی("http://127.0.0.1:" + تی سی پی.درگاه(خادم خام))
    آزمایش.ادعای درستی(اچ تی تی پی.نقطه پایانی موفق(نقطه))
    آزمایش.ادعای نادرستی(اچ تی تی پی.نقطه پایانی موفق(اچ تی تی پی.تجزیه نقطه پایانی("")))
    پاسخ سرایند := "GET / HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"

    ناپایا a := اچ تی تی پی.ارسال خام با مهلت(نقطه، پاسخ سرایند، پوچ، 0، 2000)
    آزمایش.ادعای برابری عدد(a.وضعیت، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.متن پاسخ خام(a)، "raw reply")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.مقدار سرصفحه(a.سرصفحه، "Content-Type")، "text/plain")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.مقدار سرصفحه(a.سرصفحه، "x-missing")، "")
    اچ تی تی پی.آزادسازی پاسخ خام(a)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.متن پاسخ خام(a)، "")

    تنظیمات := تی ال اس.پیکربندی جدید("127.0.0.1")
    ناپایا پاسخ امن := اچ تی تی پی.ارسال خام با پیکربندی امن(نقطه، پاسخ سرایند، پوچ، 0، 2000، تنظیمات)
    آزمایش.ادعای برابری عدد(پاسخ امن.وضعیت، 200)
    اچ تی تی پی.آزادسازی پاسخ خام(پاسخ امن)

    سقف قبلی := اچ تی تی پی.سقف پاسخ خام()
    اچ تی تی پی.تنظیم سقف پاسخ خام(10)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.سقف پاسخ خام()، 10)
    ناپایا c := اچ تی تی پی.ارسال خام با مهلت(نقطه، پاسخ سرایند، پوچ، 0، 2000)
    آزمایش.ادعای درستی(c.اندازه کوچکتربرابر 10 یا وارونه c.موفق)
    اچ تی تی پی.آزادسازی پاسخ خام(c)
    اچ تی تی پی.تنظیم سقف پاسخ خام(سقف قبلی)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.سقف پاسخ خام()، سقف قبلی)
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(خادم خام)
پایان

تابع بررسی اجرای امن مشغول():
    مشغول := تی سی پی.پیوند(0)
    s := اچ تی تی پی.سرور جدید(تی سی پی.درگاه(مشغول))
    اچ تی تی پی.اجرای امن(s، "no-such-cert.pem"، "no-such-key.pem")
    تی سی پی.بستن سرور(مشغول)
پایان

تابع بررسی سقف سرایند():
    اچ تی تی پی.بیشینه بایت سرایند(0)
    ناپایا بزرگ := اچ تی تی پی.سرصفحه جدید()
    بزرگ.درج("X-Big"، "a".تکرار(80000))
    r := اچ تی تی پی.دریافت با("http://127.0.0.1:" + PORT + "/echo"، بزرگ)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(r)، 431)
    اچ تی تی پی.بیشینه بایت سرایند(200000)
    پاسخ موفق := اچ تی تی پی.دریافت با("http://127.0.0.1:" + PORT + "/echo"، بزرگ)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(پاسخ موفق)، 200)
    اچ تی تی پی.بیشینه بایت سرایند(300)
    ناپایا میانی := اچ تی تی پی.سرصفحه جدید()
    میانی.درج("X-Mid"، "a".تکرار(2000))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت با("http://127.0.0.1:" + PORT + "/echo"، میانی))، 431)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت("http://127.0.0.1:" + PORT + "/echo"))، 200)
    اچ تی تی پی.بیشینه بایت سرایند(65536)
    پاسخ مالکیت := اچ تی تی پی.دریافت("http://127.0.0.1:" + PORT + "/own")
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(پاسخ مالکیت)، "GET")
پایان

تابع ریشه:
    راه اندازی خادم()
    بررسی روش های مشتری()
    بررسی فرم کوکی()
    بررسی یاری دهنده ها()
    بررسی نقطه پایانی خام()
    بررسی اجرای امن مشغول()
    بررسی سقف سرایند()
    برگشت آزمایش.خلاصه()
پایان
