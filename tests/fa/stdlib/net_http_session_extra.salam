بسته ریشه

واردسازی شبکه.اچ تی تی پی.نشست
واردسازی آزمایش

تابع check values():
    ناپایا s := نشست.جدید()
    آزمایش.ادعای نادرستی(نشست.مقدار دارد(s، "user"))
    نشست.تنظیم مقدار(s، "user"، "ali")
    نشست.تنظیم مقدار(s، "role"، "admin")
    آزمایش.ادعای درستی(نشست.مقدار دارد(s، "user"))
    آزمایش.ادعای برابری رشته(نشست.مقدار(s، "user")، "ali")

    آزمایش.ادعای درستی(نشست.حذف مقدار(s، "user"))
    آزمایش.ادعای نادرستی(نشست.حذف مقدار(s، "user"))
    آزمایش.ادعای نادرستی(نشست.مقدار دارد(s، "user"))
    آزمایش.ادعای درستی(نشست.مقدار دارد(s، "role"))

    نشست.پاک کردن مقادیر(s)
    آزمایش.ادعای نادرستی(نشست.مقدار دارد(s، "role"))
    آزمایش.ادعای برابری رشته(نشست.مقدار(s، "role")، "")
    نشست.نابودسازی(s.شناسه)
پایان

تابع check cleanup():
    نشست.پیکربندی("sid"، 60، نادرست، "Lax")
    fresh := نشست.جدید()
    ناپایا stale := نشست.جدید()
    stale.آخرین استفاده = 1
    نشست.ذخیره(stale)
    آزمایش.ادعای برابری عدد(نشست.پاکسازی منقضی شده ها()، 1)
    آزمایش.ادعای برابری عدد(نشست.پاکسازی منقضی شده ها()، 0)

    ناپایا ok := نادرست
    نشست.دریافت(fresh.شناسه، ok)
    آزمایش.ادعای درستی(ok)
    ناپایا gone := نادرست
    نشست.دریافت(stale.شناسه، gone)
    آزمایش.ادعای نادرستی(gone)
    نشست.نابودسازی(fresh.شناسه)
پایان

تابع ریشه:
    check values()
    check cleanup()
    برگشت آزمایش.خلاصه()
پایان
