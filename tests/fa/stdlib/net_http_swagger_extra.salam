بسته ریشه

واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.اچ تی تی پی.سواگر
واردسازی سیستم عامل
واردسازی آزمایش
واردسازی شبکه.تی سی پی

ساختار ورود:
    همگانی کاربر: رشته = ""
    همگانی رمز: رشته = ""
پایان

ساختار یادداشت:
    همگانی متن: رشته = ""
پایان

تابع ورود کاربر(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "login") پایان
تابع یادداشت ها(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "notes") پایان
تابع بارگذاری(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "upload") پایان
تابع برگه(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "page") پایان
تابع پینگ(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "ping") پایان

تابع ساخت مسیریاب(): مسیریاب.مسیریاب:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(r، "/api/login"، ورود کاربر)
    مسیریاب.ارسال(r، "/api/notes"، یادداشت ها)
    مسیریاب.قراردادن(r، "/api/upload"، بارگذاری)
    مسیریاب.دریافت(r، "/api/page"، برگه)
    مسیریاب.دریافت(r، "/api/ping"، پینگ)
    مسیریاب.دریافت(r، "/other/ping"، پینگ)
    برگشت r
پایان

تابع بررسی بدنه ها():
    r := ساخت مسیریاب()
    ناپایا سند := سواگر.جدید("Extras"، "0.1.0")
    سواگر.احراز هویت کلید(سند، "key"، "header"، "X-API-Key")
    سواگر.پویش با پیشوند(سند، r، "/api")

    _a := سواگر.انتخاب مسیر(سند، "POST"، "/api/login")
    سواگر.می پذیرد فرم(سند، "credentials"، ورود {})
    سواگر.برمی گرداند متن(سند، 200، "a plain greeting")

    _b := سواگر.انتخاب مسیر(سند، "POST"، "/api/notes")
    سواگر.می پذیرد اختیاری(سند، "an optional note"، یادداشت {})
    سواگر.برمی گرداند اچ تی ام ال(سند، 200، "the rendered note")

    _c := سواگر.انتخاب مسیر(سند، "PUT"، "/api/upload")
    سواگر.می پذیرد خام(سند، "raw bytes"، "application/octet-stream"، سواگر.طرحواره دودویی، درست)
    سواگر.امن(سند، "key")

    مشخصات سند := سواگر.مشخصات(سند)
    آزمایش.ادعای شامل بودن(مشخصات سند، "\"/api/login\"")
    آزمایش.ادعای شامل بودن(مشخصات سند، "\"/api/ping\"")
    آزمایش.ادعای نادرستی(مشخصات سند.بیاب("/other/ping") بزرگتربرابر 0)
    آزمایش.ادعای شامل بودن(مشخصات سند، "application/x-www-form-urlencoded")
    آزمایش.ادعای شامل بودن(مشخصات سند، "text/plain")
    آزمایش.ادعای شامل بودن(مشخصات سند، "text/html")
    آزمایش.ادعای شامل بودن(مشخصات سند، "application/octet-stream")
    آزمایش.ادعای شامل بودن(مشخصات سند، "\"apiKey\"")
    آزمایش.ادعای شامل بودن(مشخصات سند، "X-API-Key")
    آزمایش.ادعای شامل بودن(مشخصات سند، "\"required\":false")

    زیبا := سواگر.مشخصات با تورفتگی(سند)
    آزمایش.ادعای درستی(زیبا.طول() بزرگتر مشخصات سند.طول())
    آزمایش.ادعای شامل بودن(زیبا، "\n")

    مسیر پرونده := سیستم عامل.پوشه موقت() + "/salam_swagger_extra.json"
    آزمایش.ادعای درستی(سواگر.نوشتن مشخصات(سند، مسیر پرونده))
    آزمایش.ادعای برابری رشته(سواگر.مشخصات از پرونده(مسیر پرونده)، زیبا)
    سیستم عامل.حذف(مسیر پرونده)
    آزمایش.ادعای برابری رشته(سواگر.مشخصات از پرونده(مسیر پرونده)، "")
پایان

تابع بررسی سرو مشخصات():
    مشخصات سند := "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Fixed\",\"version\":\"1\"},\"paths\":{}}"
    ناپایا درگاه := 0
    ناپایا سرو موفق := نادرست
    ناپایا دفعه ها := 0
    تا وارونه سرو موفق و دفعه ها کوچکتر 20:
        درگاه = تی سی پی.درگاه آزاد()
        سرو موفق = سواگر.سرو مشخصات(مشخصات سند، "Fixed"، درگاه)
        دفعه ها += 1
    پایان
    آزمایش.ادعای درستی(سرو موفق)
    خانه := اچ تی تی پی.دریافت("http://127.0.0.1:" + درگاه + "/")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(خانه)، 200)
    آزمایش.ادعای شامل بودن(اچ تی تی پی.بدنه(خانه)، "<title>Fixed</title>")
    پاسخ سرو شده := اچ تی تی پی.دریافت("http://127.0.0.1:" + درگاه + "/openapi.json")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(پاسخ سرو شده)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(پاسخ سرو شده)، مشخصات سند)
پایان

تابع ریشه:
    بررسی بدنه ها()
    بررسی سرو مشخصات()
    برگشت آزمایش.خلاصه()
پایان
