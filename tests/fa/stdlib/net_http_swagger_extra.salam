بسته ریشه

واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.اچ تی تی پی.سواگر
واردسازی سیستم عامل
واردسازی آزمایش

ساختار Login:
    همگانی user: رشته = ""
    همگانی secret: رشته = ""
پایان

ساختار Note:
    همگانی text: رشته = ""
پایان

تابع login(ctx: صحیح۶۴): اچ تی تی پی.متن(ctx، "login") پایان
تابع notes(ctx: صحیح۶۴): اچ تی تی پی.متن(ctx، "notes") پایان
تابع upload(ctx: صحیح۶۴): اچ تی تی پی.متن(ctx، "upload") پایان
تابع page(ctx: صحیح۶۴): اچ تی تی پی.متن(ctx، "page") پایان
تابع ping(ctx: صحیح۶۴): اچ تی تی پی.متن(ctx، "ping") پایان

تابع build router(): مسیریاب.مسیریاب:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(r، "/api/login"، login)
    مسیریاب.ارسال(r، "/api/notes"، notes)
    مسیریاب.قراردادن(r، "/api/upload"، upload)
    مسیریاب.دریافت(r، "/api/page"، page)
    مسیریاب.دریافت(r، "/api/ping"، ping)
    مسیریاب.دریافت(r، "/other/ping"، ping)
    برگشت r
پایان

تابع check bodies():
    r := build router()
    ناپایا doc := سواگر.جدید("Extras"، "0.1.0")
    سواگر.احراز هویت کلید(doc، "key"، "header"، "X-API-Key")
    سواگر.پویش با پیشوند(doc، r، "/api")

    _a := سواگر.انتخاب مسیر(doc، "POST"، "/api/login")
    سواگر.می پذیرد فرم(doc، "credentials"، Login {})
    سواگر.برمی گرداند متن(doc، 200، "a plain greeting")

    _b := سواگر.انتخاب مسیر(doc، "POST"، "/api/notes")
    سواگر.می پذیرد اختیاری(doc، "an optional note"، Note {})
    سواگر.برمی گرداند اچ تی ام ال(doc، 200، "the rendered note")

    _c := سواگر.انتخاب مسیر(doc، "PUT"، "/api/upload")
    سواگر.می پذیرد خام(doc، "raw bytes"، "application/octet-stream"، سواگر.طرحواره دودویی، درست)
    سواگر.امن(doc، "key")

    spec := سواگر.مشخصات(doc)
    آزمایش.ادعای شامل بودن(spec، "\"/api/login\"")
    آزمایش.ادعای شامل بودن(spec، "\"/api/ping\"")
    آزمایش.ادعای نادرستی(spec.بیاب("/other/ping") بزرگتربرابر 0)
    آزمایش.ادعای شامل بودن(spec، "application/x-www-form-urlencoded")
    آزمایش.ادعای شامل بودن(spec، "text/plain")
    آزمایش.ادعای شامل بودن(spec، "text/html")
    آزمایش.ادعای شامل بودن(spec، "application/octet-stream")
    آزمایش.ادعای شامل بودن(spec، "\"apiKey\"")
    آزمایش.ادعای شامل بودن(spec، "X-API-Key")
    آزمایش.ادعای شامل بودن(spec، "\"required\":false")

    pretty := سواگر.مشخصات با تورفتگی(doc)
    آزمایش.ادعای درستی(pretty.طول() بزرگتر spec.طول())
    آزمایش.ادعای شامل بودن(pretty، "\n")

    path := سیستم عامل.پوشه موقت() + "/salam_swagger_extra.json"
    آزمایش.ادعای درستی(سواگر.نوشتن مشخصات(doc، path))
    آزمایش.ادعای برابری رشته(سواگر.مشخصات از پرونده(path)، pretty)
    سیستم عامل.حذف(path)
    آزمایش.ادعای برابری رشته(سواگر.مشخصات از پرونده(path)، "")
پایان

تابع check serve spec():
    spec := "{\"openapi\":\"3.0.3\",\"info\":{\"title\":\"Fixed\",\"version\":\"1\"},\"paths\":{}}"
    آزمایش.ادعای درستی(سواگر.سرو مشخصات(spec، "Fixed"، 23821))
    home := اچ تی تی پی.دریافت("http://127.0.0.1:23821/")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(home)، 200)
    آزمایش.ادعای شامل بودن(اچ تی تی پی.بدنه(home)، "<title>Fixed</title>")
    served := اچ تی تی پی.دریافت("http://127.0.0.1:23821/openapi.json")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(served)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(served)، spec)
پایان

تابع ریشه:
    check bodies()
    check serve spec()
    برگشت آزمایش.خلاصه()
پایان
