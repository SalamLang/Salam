بسته ریشه

واردسازی شبکه.سرور وب
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی آزمایش

تابع ریشه:
    path := سیستم عامل.پوشه موقت() + "/salam_httpd_extra.salam"
    ورودی خروجی.نوشتن پرونده(path، "server:\n    site:\n        listen = 8081\n        names = \"alpha.test www.alpha.test\"\n    end\n    site:\n        listen = 8081\n        names = \"beta.test\"\n    end\nend\n")
    آزمایش.ادعای درستی(سرور وب.بارگذاری پرونده(path))
    آزمایش.ادعای برابری عدد(سرور وب.شمار مشکل ها()، 0)
    آزمایش.ادعای برابری عدد(سرور وب.شمار سایت ها()، 2)
    آزمایش.ادعای برابری رشته(سرور وب.نام های سایت(0)، "alpha.test www.alpha.test")
    آزمایش.ادعای برابری رشته(سرور وب.نام های سایت(1)، "beta.test")
    آزمایش.ادعای برابری عدد(سرور وب.سایت برای("beta.test"، 8081)، 1)
    سیستم عامل.حذف(path)

    آزمایش.ادعای نادرستی(سرور وب.بارگذاری پرونده(path))
    آزمایش.ادعای برابری عدد(سرور وب.شمار مشکل ها()، 1)
    آزمایش.ادعای شامل بودن(سرور وب.مشکل شماره(0)، "cannot read the config file")
    آزمایش.ادعای برابری عدد(سرور وب.شمار سایت ها()، 0)

    ورودی خروجی.نوشتن پرونده(path، "server:\n    sit:\n    end\nend\n")
    آزمایش.ادعای نادرستی(سرور وب.بارگذاری پرونده(path))
    آزمایش.ادعای درستی(سرور وب.شمار مشکل ها() بزرگتر 0)
    سیستم عامل.حذف(path)
    برگشت آزمایش.خلاصه()
پایان
