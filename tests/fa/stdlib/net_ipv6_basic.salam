واردسازی حافظه
واردسازی شبکه.داخلی.سوکت خام
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.یو دی پی

ناپایا last_peer := ""

تابع acceptor(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        last_peer = تی سی پی.نشانی همتای اتصال(c)
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() بزرگتر 0: تی سی پی.نوشتن(c، d) پایان
        تی سی پی.بستن(c)
    پایان
پایان

تابع udp_echo(arg: صحیح۶۴):
    s := یو دی پی.سوکت یو دی پی { توصیفگر = arg }
    buf := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    تا درست:
        ناپایا h := ""
        ناپایا p := 0
        n := یو دی پی.دریافت بایت(s، buf، 2048، h، p)
        اگر n کوچکتر 0: بشکن پایان
        یو دی پی.ارسال بایت(s، h، p، buf، n)
    پایان
پایان

تابع ping(host: رشته، port: صحیح، msg: رشته): رشته:
    c := تی سی پی.شماره گیری(host، port)
    اگر وارونه تی سی پی.اتصال معتبر(c): برگشت "refused" پایان
    تی سی پی.نوشتن(c، msg)
    got := تی سی پی.خواندن(c، 100)
    تی سی پی.بستن(c)
    برگشت got
پایان

تابع shout(s: یو دی پی.سوکت یو دی پی، host: رشته، port: صحیح، msg: رشته): رشته:
    یو دی پی.تنظیم زمان انتظار(s، 1500)
    یو دی پی.ارسال به(s، host، port، msg)
    p := یو دی پی.دریافت(s، 100)
    اگر p.داده.طول() برابر 0: برگشت "timeout" پایان
    برگشت p.داده + " from " + p.میزبان فرستنده
پایان

تابع ریشه:
    probe := تی سی پی.پیوند روی("::1"، 0)
    اگر وارونه تی سی پی.معتبر(probe):
        سرچاپ "ipv6 unavailable"
        برگشت
    پایان
    تی سی پی.بستن سرور(probe)

    سرچاپ سوکت خام.نشانی استاندارد("[2001:0DB8:0:0:0:0:0:1]")
    سرچاپ سوکت خام.نشانی استاندارد("::ffff:1.2.3.4")
    سرچاپ سوکت خام.نشانی استاندارد("0:0:0:0:0:0:0:0")
    سرچاپ سوکت خام.نشانی استاندارد("1:0:0:2:0:0:0:3")
    سرچاپ سوکت خام.نشانی استاندارد("fe80::1%2")
    سرچاپ سوکت خام.آی‌پی۶ است("2606:4700:4700::1111")، سوکت خام.آی‌پی۶ است("1:2:3")، سوکت خام.آی‌پی۶ است(":::")، سوکت خام.آی‌پی۶ است("1.2.3.4")
    سرچاپ سوکت خام.نشانی میزبان درگاه("::1"، 80)، سوکت خام.نشانی میزبان درگاه("1.2.3.4"، 80)، سوکت خام.نشانی میزبان درگاه("example.com"، 80)
    سرچاپ سوکت خام.پیشوند آی‌پی۶("2001:db8:1:2:3:4:5:6"، 64)، سوکت خام.پیشوند آی‌پی۶("2001:db8:ffff::1"، 36)
    سرچاپ سوکت خام.هگزا آی‌پی۶("::1")
    سرچاپ سوکت خام.تفکیک نشانی همه خانواده("::1")، سوکت خام.تفکیک نشانی همه خانواده("[2001:db8::7]")، سوکت خام.تفکیک نشانی همه خانواده("127.0.0.1")

    six := تی سی پی.پیوند روی("::1"، 0)
    سرچاپ "listen ::1"، تی سی پی.معتبر(six)، تی سی پی.نشانی سرور(six)
    ساکس.برو(acceptor، six.توصیفگر برگردان تهی*)
    p6 := تی سی پی.درگاه(six)
    سرچاپ ping("::1"، p6، "hello six")
    سرچاپ last_peer
    سرچاپ ping("[::1]"، p6، "bracketed")
    سرچاپ ping("127.0.0.1"، p6، "v4 to v6 only")

    dual := تی سی پی.پیوند دوگانه(0)
    سرچاپ "dual"، تی سی پی.معتبر(dual)، تی سی پی.نشانی سرور(dual)
    ساکس.برو(acceptor، dual.توصیفگر برگردان تهی*)
    pd := تی سی پی.درگاه(dual)
    سرچاپ ping("127.0.0.1"، pd، "dual v4")
    سرچاپ last_peer
    سرچاپ ping("::1"، pd، "dual v6")
    سرچاپ last_peer
    سرچاپ ping("localhost"، pd، "dual name") نابرابر "refused"

    only := تی سی پی.پیوند آی‌پی۶("::"، 0، درست)
    سرچاپ "v6only"، تی سی پی.معتبر(only)، ping("127.0.0.1"، تی سی پی.درگاه(only)، "x")
    تی سی پی.بستن سرور(only)

    ناپایا fam := وکتور {} برگردان وکتور<رشته>
    fam.بیفزا("::1")
    fam.بیفزا("127.0.0.1")
    c := تی سی پی.شماره گیری چند نشانی با مهلت(fam، p6، 2000)
    سرچاپ "race"، تی سی پی.اتصال معتبر(c)
    سرچاپ تی سی پی.نشانی همتای اتصال(c)، تی سی پی.درگاه همتای اتصال(c) برابر p6، تی سی پی.نشانی محلی اتصال(c)
    تی سی پی.بستن(c)
    four := تی سی پی.پیوند روی("127.0.0.1"، 0)
    ساکس.برو(acceptor، four.توصیفگر برگردان تهی*)
    ناپایا fb := وکتور {} برگردان وکتور<رشته>
    fb.بیفزا("::1")
    fb.بیفزا("127.0.0.1")
    cf := تی سی پی.شماره گیری چند نشانی با مهلت(fb، تی سی پی.درگاه(four)، 2000)
    سرچاپ "fallback"، تی سی پی.اتصال معتبر(cf)، تی سی پی.نشانی همتای اتصال(cf)
    تی سی پی.بستن(cf)
    ناپایا dead := وکتور {} برگردان وکتور<رشته>
    dead.بیفزا("::1")
    dead.بیفزا("127.0.0.1")
    dd := تی سی پی.شماره گیری چند نشانی با مهلت(dead، تی سی پی.درگاه(six) + 1، 500)
    سرچاپ "race refused"، تی سی پی.اتصال معتبر(dd)

    us := یو دی پی.پیوند روی("::1"، 0)
    سرچاپ "udp bind"، یو دی پی.معتبر(us)، یو دی پی.نشانی محلی(us)
    ساکس.برو(udp_echo، us.توصیفگر برگردان تهی*)
    uc := یو دی پی.باز کردن همه خانواده()
    سرچاپ "udp ::1"، shout(uc، "::1"، یو دی پی.درگاه(us)، "ping6")
    سرچاپ "udp [::1]"، shout(uc، "[::1]"، یو دی پی.درگاه(us)، "ping6b")
    ud := یو دی پی.پیوند دوگانه(0)
    ساکس.برو(udp_echo، ud.توصیفگر برگردان تهی*)
    سرچاپ "udp dual v4"، shout(uc، "127.0.0.1"، یو دی پی.درگاه(ud)، "ping4")
    سرچاپ "udp dual v6"، shout(uc، "::1"، یو دی پی.درگاه(ud)، "ping6c")
    uf := یو دی پی.باز کردن برای میزبان("::1")
    سرچاپ "udp openfor"، shout(uf، "::1"، یو دی پی.درگاه(ud)، "ping6d")
    dl := یو دی پی.شماره گیری("::1"، یو دی پی.درگاه(us))
    یو دی پی.تنظیم زمان انتظار(dl، 1500)
    یو دی پی.نوشتن(dl، "connected")
    سرچاپ "udp dial"، یو دی پی.خواندن(dl، 100)، یو دی پی.معتبر(dl)
    یو دی پی.بستن(dl)
    یو دی پی.بستن(uf)
    یو دی پی.بستن(uc)
پایان
