واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی لس
واردسازی شبکه.وی مس

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا port := 0
ناپایا kind := 0
ناپایا seen := وکتور {} برگردان وکتور<رشته>
ناپایا seen_lock := همگام سازی.قفل جدید()

تابع echo_session(p: انتقال شبکه.نشست پذیرفته*):
    inc := p[0]
    همگام سازی.قفل کردن(seen_lock)
    ناپایا tag := "tcp"
    اگر inc.یو دی پی:
        tag = "udp"
    پایان
    seen.بیفزا(tag + " " + inc.نشانی.میزبان + ":" + str_of(inc.نشانی.درگاه))
    همگام سازی.باز کردن قفل(seen_lock)
    buf := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
    تا درست:
        n := inc.جریان.خواندن بایت(buf، 65536)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        اگر inc.جریان.نوشتن بایت(buf، n) نابرابر n:
            بشکن
        پایان
    پایان
    حافظه.آزادسازی(buf)
    inc.جریان.بستن()
    حافظه.آزادسازی(p برگردان تهی*)
پایان

تابع str_of(n: صحیح): رشته:
    برگشت "" + n
پایان

تابع serve():
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    t := انتقال شبکه.پذیرش(l)
    ناپایا m := انتقال شبکه.چندگانه ساز {}
    ناپایا users := وکتور {} برگردان وکتور<وی لس.کاربر>
    users.بیفزا(وی لس.کاربر جدید(UUID1، ""))
    ناپایا vusers := وکتور {} برگردان وکتور<وی مس.کاربر>
    vusers.بیفزا(وی مس.کاربر جدید(UUID1))
    ناپایا rf := وی مس.فیلتر بازپخش جدید()
    اگر kind برابر 0:
        c := وی لس.پذیرش(t، users)
        m = وی لس.چندگانه ساز کارساز(c)
    وگرنه:
        c := وی مس.پذیرش(t، vusers، rf)
        m = وی مس.چندگانه ساز کارساز(c)
    پایان
    ناپایا inc := انتقال شبکه.نشست پذیرفته {}
    تا انتقال شبکه.پذیرش نشست(m، inc):
        p := حافظه.تخصیص صفرشده(اندازه‌گونه(انتقال شبکه.نشست پذیرفته) برگردان طبیعی۶۴) برگردان انتقال شبکه.نشست پذیرفته*
        p[0] = inc
        _h := نخ‌ساز(echo_session، p)
    پایان
    انتقال شبکه.بستن شنونده(l)
پایان

تابع exchange(s: پویا تونل.جریان، seed: صحیح، n: صحیح): منطقی:
    ناپایا out := انتقال شبکه.بایت‌های جدید(n + 1)
    تکرار n در i:
        انتقال شبکه.نوشتن بایت(out، (i * 3 + seed) & 255)
    پایان
    اگر s.نوشتن بایت(out.نشانگر، n) نابرابر n:
        برگشت نادرست
    پایان
    back := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    ناپایا got := 0
    تا got کوچکتر n:
        r := s.خواندن بایت(((back برگردان صحیح۶۴) + (got برگردان صحیح۶۴)) برگردان تهی*، n - got)
        اگر r کوچکتربرابر 0:
            بشکن
        پایان
        got += r
    پایان
    bp := back برگردان طبیعی۸*
    ناپایا good := got برابر n
    تکرار got در i:
        اگر (bp[i] برگردان صحیح) نابرابر ((i * 3 + seed) & 255):
            good = نادرست
            بشکن
        پایان
    پایان
    حافظه.آزادسازی(back)
    انتقال شبکه.آزادسازی بایت‌ها(out)
    برگشت good
پایان

تابع run(label: رشته، k: صحیح):
    kind = k
    seen = وکتور {} برگردان وکتور<رشته>
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve)
    همگام سازی.انتظار(ready)
    plain := انتقال شبکه.تنظیمات {}
    tc := انتقال شبکه.شماره گیری("127.0.0.1"، port، plain)
    ناپایا m := انتقال شبکه.چندگانه ساز {}
    اگر k برابر 0:
        c := وی لس.کارخواه(tc، UUID1، ""، وی لس.فرمان مالتی پلکس، انتقال شبکه.نشانی {})
        m = وی لس.چندگانه ساز کارخواه(c)
    وگرنه:
        c := وی مس.کارخواه(tc، UUID1، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، وی مس.گزینه پیش فرض(وی مس.امنیت ای ای اس۱۲۸ جی سی ام)، وی مس.فرمان مالتی پلکس، انتقال شبکه.نشانی {})
        m = وی مس.چندگانه ساز کارخواه(c)
    پایان
    a := انتقال شبکه.باز کردن نشست(m، انتقال شبکه.نشانی جدید("one.example.com"، 443)، نادرست)
    b := انتقال شبکه.باز کردن نشست(m، انتقال شبکه.نشانی جدید("10.0.0.2"، 80)، نادرست)
    d := انتقال شبکه.باز کردن نشست(m، انتقال شبکه.نشانی جدید("8.8.8.8"، 53)، درست)
    r1 := exchange(a، 1، 40000)
    r2 := exchange(b، 2، 100)
    r3 := exchange(d، 3، 700)
    r4 := exchange(a، 4، 3000)
    سرچاپ label، "three sessions over one connection:"، r1، r2، r3، r4
    a.بستن()
    r5 := exchange(b، 5، 20000)
    سرچاپ label، "other session survives a close:"، r5، "closed one is not ok:"، وارونه a.معتبر()
    b.بستن()
    d.بستن()
    همگام سازی.خواب میلی ثانیه(100)
    همگام سازی.قفل کردن(seen_lock)
    ناپایا tcp_one := نادرست
    ناپایا tcp_two := نادرست
    ناپایا udp_one := نادرست
    تکرار seen.طول() در i:
        v := seen.بگیر(i)
        اگر v برابر "tcp one.example.com:443":
            tcp_one = درست
        پایان
        اگر v برابر "tcp 10.0.0.2:80":
            tcp_two = درست
        پایان
        اگر v برابر "udp 8.8.8.8:53":
            udp_one = درست
        پایان
    پایان
    همگام سازی.باز کردن قفل(seen_lock)
    سرچاپ label، "server saw targets:"، tcp_one، tcp_two، udp_one
    انتقال شبکه.بستن چندگانه ساز(m)
    نخ‌پیوند(t)
پایان

تابع ریشه:
    run("vless"، 0)
    run("vmess"، 1)
پایان
