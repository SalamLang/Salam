بسته ریشه

واردسازی شبکه.پراکسی
واردسازی شبکه.تی سی پی
واردسازی حافظه
واردسازی آزمایش

ناپایا خادم وب := تی سی پی.سرور {}
ناپایا خادم ساکس := تی سی پی.سرور {}
ناپایا نخستین دیده := ""
ناپایا دومین دیده := ""
ناپایا سلام ساکس := 0
ناپایا طول نام ساکس := 0
ناپایا طول رمز ساکس := 0

تابع پراکسی زنجیره():
    c := تی سی پی.پذیرش(خادم وب)
    نخستین دیده = تی سی پی.خواندن(c، 4096)
    تی سی پی.نوشتن(c، "HTTP/1.1 200 Connection established\r\n\r\n")
    دومین دیده = تی سی پی.خواندن(c، 4096)
    تی سی پی.نوشتن(c، "HTTP/1.1 200 Connection established\r\n\r\n")
    پژواک := تی سی پی.خواندن(c، 128)
    تی سی پی.نوشتن(c، "tunnel:" + پژواک)
    تی سی پی.بستن(c)
پایان

تابع پراکسی وب احرازی():
    c := تی سی پی.پذیرش(خادم وب)
    نخستین دیده = تی سی پی.خواندن(c، 4096)
    تی سی پی.نوشتن(c، "HTTP/1.1 200 Connection established\r\n\r\n")
    پژواک := تی سی پی.خواندن(c، 128)
    تی سی پی.نوشتن(c، "tunnel:" + پژواک)
    تی سی پی.بستن(c)
پایان

تابع پراکسی ساکس احرازی():
    c := تی سی پی.پذیرش(خادم ساکس)
    سلام := حافظه.تخصیص(16 برگردان طبیعی۶۴)
    n := تی سی پی.خواندن بایت(c، سلام، 16)
    سلام ساکس = n
    پاسخ := حافظه.تخصیص(2 برگردان طبیعی۶۴)
    نشانگر پاسخ := پاسخ برگردان صحیح۸*
    نشانگر پاسخ[0] = 5 برگردان صحیح۸
    نشانگر پاسخ[1] = 2 برگردان صحیح۸
    تی سی پی.نوشتن بایت(c، پاسخ، 2)

    احراز := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    نشانگر احراز := احراز برگردان صحیح۸*
    تی سی پی.خواندن بایت(c، احراز، 64)
    طول نام ساکس = نشانگر احراز[1] برگردان صحیح
    طول رمز ساکس = نشانگر احراز[2 + طول نام ساکس] برگردان صحیح
    نشانگر پاسخ[0] = 1 برگردان صحیح۸
    نشانگر پاسخ[1] = 0 برگردان صحیح۸
    تی سی پی.نوشتن بایت(c، پاسخ، 2)

    درخواست := حافظه.تخصیص(300 برگردان طبیعی۶۴)
    تی سی پی.خواندن بایت(c، درخواست، 300)
    پاسخ نهایی := حافظه.تخصیص(10 برگردان طبیعی۶۴)
    نشانگر نهایی := پاسخ نهایی برگردان صحیح۸*
    نشانگر نهایی[0] = 5 برگردان صحیح۸
    نشانگر نهایی[1] = 0 برگردان صحیح۸
    نشانگر نهایی[2] = 0 برگردان صحیح۸
    نشانگر نهایی[3] = 1 برگردان صحیح۸
    نشانگر نهایی[4] = 0 برگردان صحیح۸
    نشانگر نهایی[5] = 0 برگردان صحیح۸
    نشانگر نهایی[6] = 0 برگردان صحیح۸
    نشانگر نهایی[7] = 0 برگردان صحیح۸
    نشانگر نهایی[8] = 0 برگردان صحیح۸
    نشانگر نهایی[9] = 0 برگردان صحیح۸
    تی سی پی.نوشتن بایت(c، پاسخ نهایی، 10)
    پژواک := تی سی پی.خواندن(c، 128)
    تی سی پی.نوشتن(c، "tunnel:" + پژواک)
    تی سی پی.بستن(c)
    حافظه.آزادسازی(سلام)
    حافظه.آزادسازی(پاسخ)
    حافظه.آزادسازی(احراز)
    حافظه.آزادسازی(درخواست)
    حافظه.آزادسازی(پاسخ نهایی)
پایان

تابع بررسی احراز وب():
    خادم وب = تی سی پی.پیوند(0)
    t := نخ‌ساز(پراکسی وب احرازی)
    p := پراکسی.پراکسی اچ‌تی‌تی‌پی با احراز هویت("127.0.0.1:" + تی سی پی.درگاه(خادم وب)، "user"، "pass")
    اتصال := پراکسی.شماره‌گیری(p، "target.example.com"، 443)
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(اتصال))
    تی سی پی.نوشتن(اتصال، "hi")
    آزمایش.ادعای برابری رشته(تی سی پی.خواندن(اتصال، 128)، "tunnel:hi")
    تی سی پی.بستن(اتصال)
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(خادم وب)
    آزمایش.ادعای شامل بودن(نخستین دیده، "CONNECT target.example.com:443 HTTP/1.1")
    آزمایش.ادعای شامل بودن(نخستین دیده، "Proxy-Authorization: Basic dXNlcjpwYXNz")
پایان

تابع بررسی احراز ساکس():
    خادم ساکس = تی سی پی.پیوند(0)
    t := نخ‌ساز(پراکسی ساکس احرازی)
    p := پراکسی.پراکسی ساکس۵ با احراز هویت("127.0.0.1:" + تی سی پی.درگاه(خادم ساکس)، "user"، "secret")
    اتصال := پراکسی.شماره‌گیری(p، "target.example.com"، 443)
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(اتصال))
    تی سی پی.نوشتن(اتصال، "yo")
    آزمایش.ادعای برابری رشته(تی سی پی.خواندن(اتصال، 128)، "tunnel:yo")
    تی سی پی.بستن(اتصال)
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(خادم ساکس)
    آزمایش.ادعای برابری عدد(سلام ساکس، 4)
    آزمایش.ادعای برابری عدد(طول نام ساکس، 4)
    آزمایش.ادعای برابری عدد(طول رمز ساکس، 6)
پایان

تابع بررسی زنجیره():
    خادم وب = تی سی پی.پیوند(0)
    t := نخ‌ساز(پراکسی زنجیره)
    ناپایا c := پراکسی.زنجیره جدید()
    پراکسی.افزودن(c، پراکسی.پراکسی اچ‌تی‌تی‌پی جدید("127.0.0.1:" + تی سی پی.درگاه(خادم وب)))
    پراکسی.افزودن(c، پراکسی.پراکسی اچ‌تی‌تی‌پی جدید("second.example.com:8080"))
    اتصال := پراکسی.شماره‌گیری زنجیره‌ای(c، "target.example.com"، 443)
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(اتصال))
    تی سی پی.نوشتن(اتصال، "ab")
    آزمایش.ادعای برابری رشته(تی سی پی.خواندن(اتصال، 128)، "tunnel:ab")
    تی سی پی.بستن(اتصال)
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(خادم وب)
    آزمایش.ادعای شامل بودن(نخستین دیده، "CONNECT second.example.com:8080 HTTP/1.1")
    آزمایش.ادعای شامل بودن(دومین دیده، "CONNECT target.example.com:443 HTTP/1.1")

    خالی := پراکسی.زنجیره جدید()
    مرده := پراکسی.شماره‌گیری زنجیره‌ای(خالی، "127.0.0.1"، 1)
    آزمایش.ادعای نادرستی(تی سی پی.اتصال معتبر(مرده))
پایان

تابع ریشه:
    بررسی احراز وب()
    بررسی احراز ساکس()
    بررسی زنجیره()
    برگشت آزمایش.خلاصه()
پایان
