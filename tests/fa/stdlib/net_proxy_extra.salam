بسته ریشه

واردسازی شبکه.پراکسی
واردسازی شبکه.تی سی پی
واردسازی حافظه
واردسازی آزمایش

ناپایا http server := تی سی پی.سرور {}
ناپایا socks server := تی سی پی.سرور {}
ناپایا seen first := ""
ناپایا seen second := ""
ناپایا socks greeting := 0
ناپایا socks auth user := 0
ناپایا socks auth pass := 0

تابع chain proxy():
    c := تی سی پی.پذیرش(http server)
    seen first = تی سی پی.خواندن(c، 4096)
    تی سی پی.نوشتن(c، "HTTP/1.1 200 Connection established\r\n\r\n")
    seen second = تی سی پی.خواندن(c، 4096)
    تی سی پی.نوشتن(c، "HTTP/1.1 200 Connection established\r\n\r\n")
    echo := تی سی پی.خواندن(c، 128)
    تی سی پی.نوشتن(c، "tunnel:" + echo)
    تی سی پی.بستن(c)
پایان

تابع auth http proxy():
    c := تی سی پی.پذیرش(http server)
    seen first = تی سی پی.خواندن(c، 4096)
    تی سی پی.نوشتن(c، "HTTP/1.1 200 Connection established\r\n\r\n")
    echo := تی سی پی.خواندن(c، 128)
    تی سی پی.نوشتن(c، "tunnel:" + echo)
    تی سی پی.بستن(c)
پایان

تابع auth socks proxy():
    c := تی سی پی.پذیرش(socks server)
    greet := حافظه.تخصیص(16 برگردان طبیعی۶۴)
    n := تی سی پی.خواندن بایت(c، greet، 16)
    socks greeting = n
    reply := حافظه.تخصیص(2 برگردان طبیعی۶۴)
    rp := reply برگردان صحیح۸*
    rp[0] = 5 برگردان صحیح۸
    rp[1] = 2 برگردان صحیح۸
    تی سی پی.نوشتن بایت(c، reply، 2)

    auth := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    ap := auth برگردان صحیح۸*
    تی سی پی.خواندن بایت(c، auth، 64)
    socks auth user = ap[1] برگردان صحیح
    socks auth pass = ap[2 + socks auth user] برگردان صحیح
    rp[0] = 1 برگردان صحیح۸
    rp[1] = 0 برگردان صحیح۸
    تی سی پی.نوشتن بایت(c، reply، 2)

    req := حافظه.تخصیص(300 برگردان طبیعی۶۴)
    تی سی پی.خواندن بایت(c، req، 300)
    done := حافظه.تخصیص(10 برگردان طبیعی۶۴)
    dp := done برگردان صحیح۸*
    dp[0] = 5 برگردان صحیح۸
    dp[1] = 0 برگردان صحیح۸
    dp[2] = 0 برگردان صحیح۸
    dp[3] = 1 برگردان صحیح۸
    dp[4] = 0 برگردان صحیح۸
    dp[5] = 0 برگردان صحیح۸
    dp[6] = 0 برگردان صحیح۸
    dp[7] = 0 برگردان صحیح۸
    dp[8] = 0 برگردان صحیح۸
    dp[9] = 0 برگردان صحیح۸
    تی سی پی.نوشتن بایت(c، done، 10)
    echo := تی سی پی.خواندن(c، 128)
    تی سی پی.نوشتن(c، "tunnel:" + echo)
    تی سی پی.بستن(c)
    حافظه.آزادسازی(greet)
    حافظه.آزادسازی(reply)
    حافظه.آزادسازی(auth)
    حافظه.آزادسازی(req)
    حافظه.آزادسازی(done)
پایان

تابع check http auth():
    http server = تی سی پی.پیوند(0)
    t := نخ‌ساز(auth http proxy)
    p := پراکسی.پراکسی اچ‌تی‌تی‌پی با احراز هویت("127.0.0.1:" + تی سی پی.درگاه(http server)، "user"، "pass")
    conn := پراکسی.شماره‌گیری(p، "target.example.com"، 443)
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(conn))
    تی سی پی.نوشتن(conn، "hi")
    آزمایش.ادعای برابری رشته(تی سی پی.خواندن(conn، 128)، "tunnel:hi")
    تی سی پی.بستن(conn)
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(http server)
    آزمایش.ادعای شامل بودن(seen first، "CONNECT target.example.com:443 HTTP/1.1")
    آزمایش.ادعای شامل بودن(seen first، "Proxy-Authorization: Basic dXNlcjpwYXNz")
پایان

تابع check socks auth():
    socks server = تی سی پی.پیوند(0)
    t := نخ‌ساز(auth socks proxy)
    p := پراکسی.پراکسی ساکس۵ با احراز هویت("127.0.0.1:" + تی سی پی.درگاه(socks server)، "user"، "secret")
    conn := پراکسی.شماره‌گیری(p، "target.example.com"، 443)
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(conn))
    تی سی پی.نوشتن(conn، "yo")
    آزمایش.ادعای برابری رشته(تی سی پی.خواندن(conn، 128)، "tunnel:yo")
    تی سی پی.بستن(conn)
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(socks server)
    آزمایش.ادعای برابری عدد(socks greeting، 4)
    آزمایش.ادعای برابری عدد(socks auth user، 4)
    آزمایش.ادعای برابری عدد(socks auth pass، 6)
پایان

تابع check chain():
    http server = تی سی پی.پیوند(0)
    t := نخ‌ساز(chain proxy)
    ناپایا c := پراکسی.زنجیره جدید()
    پراکسی.افزودن(c، پراکسی.پراکسی اچ‌تی‌تی‌پی جدید("127.0.0.1:" + تی سی پی.درگاه(http server)))
    پراکسی.افزودن(c، پراکسی.پراکسی اچ‌تی‌تی‌پی جدید("second.example.com:8080"))
    conn := پراکسی.شماره‌گیری زنجیره‌ای(c، "target.example.com"، 443)
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(conn))
    تی سی پی.نوشتن(conn، "ab")
    آزمایش.ادعای برابری رشته(تی سی پی.خواندن(conn، 128)، "tunnel:ab")
    تی سی پی.بستن(conn)
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(http server)
    آزمایش.ادعای شامل بودن(seen first، "CONNECT second.example.com:8080 HTTP/1.1")
    آزمایش.ادعای شامل بودن(seen second، "CONNECT target.example.com:443 HTTP/1.1")

    empty := پراکسی.زنجیره جدید()
    dead := پراکسی.شماره‌گیری زنجیره‌ای(empty، "127.0.0.1"، 1)
    آزمایش.ادعای نادرستی(تی سی پی.اتصال معتبر(dead))
پایان

تابع ریشه:
    check http auth()
    check socks auth()
    check chain()
    برگشت آزمایش.خلاصه()
پایان
