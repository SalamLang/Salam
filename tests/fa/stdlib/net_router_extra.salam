بسته ریشه

واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی آزمایش

تابع user(ctx: صحیح۶۴):
    اچ تی تی پی.متن(ctx، "user " + اچ تی تی پی.پارامتر(ctx، "id"))
پایان

تابع nothing here(ctx: صحیح۶۴):
    اچ تی تی پی.تنظیم وضعیت(ctx، 404)
    اچ تی تی پی.متن(ctx، "nothing at " + اچ تی تی پی.مسیر(ctx))
پایان

تابع check dispatch params():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/users/:id/:tab"، user)
    ناپایا m := مسیریاب.اعزام(r، "GET"، "/users/7/posts")
    آزمایش.ادعای درستی(m.پیدا شد)
    آزمایش.ادعای برابری رشته(مسیریاب.دریافت پارامتر(m، "id")، "7")
    آزمایش.ادعای برابری رشته(مسیریاب.دریافت پارامتر(m، "tab")، "posts")
    مسیریاب.آزادسازی تطابق(m)
    آزمایش.ادعای درستی(m.پیدا شد)
    ناپایا miss := مسیریاب.اعزام(r، "GET"، "/nowhere")
    آزمایش.ادعای نادرستی(miss.پیدا شد)
    مسیریاب.آزادسازی تطابق(miss)
پایان

تابع check unmatched route():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/users/:id"، user)
    مسیریاب.تنظیم مدیر پیش‌فرض(r، nothing here)
    ناپایا s := اچ تی تی پی.سرور جدید(23831)
    اچ تی تی پی.استفاده(s، r)
    آزمایش.ادعای درستی(اچ تی تی پی.اجرا در پس زمینه(s))

    hit := اچ تی تی پی.دریافت("http://127.0.0.1:23831/users/5")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(hit)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(hit)، "user 5")
    miss := اچ تی تی پی.دریافت("http://127.0.0.1:23831/elsewhere/x")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(miss)، 404)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(miss)، "nothing at /elsewhere/x")
پایان

تابع ریشه:
    check dispatch params()
    check unmatched route()
    برگشت آزمایش.خلاصه()
پایان
