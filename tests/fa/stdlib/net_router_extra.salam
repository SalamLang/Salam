بسته ریشه

واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی آزمایش

تابع نمایش کاربر(زمینه: صحیح۶۴):
    اچ تی تی پی.متن(زمینه، "user " + اچ تی تی پی.پارامتر(زمینه، "id"))
پایان

تابع پیش فرض ناپیدا(زمینه: صحیح۶۴):
    اچ تی تی پی.تنظیم وضعیت(زمینه، 404)
    اچ تی تی پی.متن(زمینه، "nothing at " + اچ تی تی پی.مسیر(زمینه))
پایان

تابع بررسی پارامترهای اعزام():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/users/:id/:tab"، نمایش کاربر)
    ناپایا m := مسیریاب.اعزام(r، "GET"، "/users/7/posts")
    آزمایش.ادعای درستی(m.پیدا شد)
    آزمایش.ادعای برابری رشته(مسیریاب.دریافت پارامتر(m، "id")، "7")
    آزمایش.ادعای برابری رشته(مسیریاب.دریافت پارامتر(m، "tab")، "posts")
    مسیریاب.آزادسازی تطابق(m)
    آزمایش.ادعای درستی(m.پیدا شد)
    ناپایا نیافته := مسیریاب.اعزام(r، "GET"، "/nowhere")
    آزمایش.ادعای نادرستی(نیافته.پیدا شد)
    مسیریاب.آزادسازی تطابق(نیافته)
پایان

تابع بررسی مسیر نامنطبق():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/users/:id"، نمایش کاربر)
    مسیریاب.تنظیم مدیر پیش‌فرض(r، پیش فرض ناپیدا)
    ناپایا s := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.استفاده(s، r)
    درگاه := اچ تی تی پی.اجرا در پس زمینه با درگاه(s)
    آزمایش.ادعای درستی(درگاه بزرگتر 0)

    یافته := اچ تی تی پی.دریافت("http://127.0.0.1:" + درگاه + "/users/5")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(یافته)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(یافته)، "user 5")
    نیافته := اچ تی تی پی.دریافت("http://127.0.0.1:" + درگاه + "/elsewhere/x")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(نیافته)، 404)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(نیافته)، "nothing at /elsewhere/x")
پایان

تابع ریشه:
    بررسی پارامترهای اعزام()
    بررسی مسیر نامنطبق()
    برگشت آزمایش.خلاصه()
پایان
