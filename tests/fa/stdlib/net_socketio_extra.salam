بسته ریشه

واردسازی شبکه.سوکت‌آیاو
واردسازی شبکه.وب‌سوکت
واردسازی کدگذاری.مقدار
واردسازی رشته
واردسازی آزمایش

ناپایا خادم := وب‌سوکت.سرور {}
ناپایا سیم := ""
ناپایا ردپا := ""

تابع ثبت(برچسب: رشته):
    ردپا += برچسب
پایان

تابع خادم ساختگی():
    ناپایا اتصال := وب‌سوکت.پذیرش(خادم)
    _ := وب‌سوکت.ارسال متن(اتصال، `0{"sid":"s1","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    ناپایا ادامه := درست
    تا ادامه:
        m := وب‌سوکت.دریافت با مهلت(اتصال، 3000)
        اگر m.نوع برابر وب‌سوکت.دودویی:
            سیم += "<binary>|"
            گذر
        پایان
        اگر m.نوع نابرابر وب‌سوکت.متن:
            بشکن
        پایان
        قاب := m.متن.زیررشته(1، m.متن.طول() - 1)
        اگر قاب برابر "0":
            _ := وب‌سوکت.ارسال متن(اتصال، `40{"sid":"a1"}`)
            _ := وب‌سوکت.ارسال متن(اتصال، `42["vals",7,2.5,true,"x",{"k":1}]`)
            _ := وب‌سوکت.ارسال متن(اتصال، `4215["need",1]`)
            _ := وب‌سوکت.ارسال متن(اتصال، `4216["need",2]`)
        وگرنه رشته.شامل است(قاب، `"add"`):
            شناسه := قاب.زیررشته(1، رشته.یافتن(قاب، "[") - 1)
            _ := وب‌سوکت.ارسال متن(اتصال، "43" + شناسه + `[5,2.5,true,{"z":1}]`)
        وگرنه رشته.شروع با(قاب، `2["go"`):
            سیم += قاب + "|"
            _ := وب‌سوکت.ارسال متن(اتصال، `42["tick"]`)
        وگرنه قاب برابر "1":
            سیم += "disconnect|"
            ادامه = نادرست
        وگرنه:
            سیم += قاب + "|"
        پایان
    پایان
    وب‌سوکت.بستن(اتصال)
پایان

تابع بررسی خواندن نوع دار(c: سوکت‌آیاو.کارخواه):
    ناپایا e := سوکت‌آیاو.رویداد بعدی(c، 2000)
    آزمایش.ادعای برابری عدد(e.نوع، سوکت‌آیاو.رویداد پیام)
    آزمایش.ادعای برابری رشته(e.نام، "vals")
    آزمایش.ادعای برابری عدد۶۴(سوکت‌آیاو.آرگومان عددی(e، 0)، 7)
    آزمایش.ادعای برابری رشته(سوکت‌آیاو.آرگومان رشته(e، 2)، "true")
    آزمایش.ادعای درستی(سوکت‌آیاو.آرگومان اعشاری(e، 1) بزرگتر 2.49 و سوکت‌آیاو.آرگومان اعشاری(e، 1) کوچکتر 2.51)
    آزمایش.ادعای درستی(سوکت‌آیاو.آرگومان بولی(e، 2))
    ناپایا v := سوکت‌آیاو.مقدار آرگومان(e، 4)
    آزمایش.ادعای درستی(مقدار.شیء است(v))
    آزمایش.ادعای برابری عدد۶۴(مقدار.به صحیح(مقدار.مقدار کلید(v، "k"))، 1)
    مقدار.آزادسازی مقدار(v)
    سوکت‌آیاو.آزادسازی رویداد(e)
پایان

تابع بررسی پاسخ ها(c: سوکت‌آیاو.کارخواه):
    ناپایا نخستین := سوکت‌آیاو.رویداد بعدی(c، 2000)
    آزمایش.ادعای برابری رشته(نخستین.نام، "need")
    آزمایش.ادعای برابری عدد(نخستین.شماره تایید، 15)
    ناپایا آرگومان ها := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن عدد(آرگومان ها، 1)
    سوکت‌آیاو.افزودن مقدار(آرگومان ها، مقدار.مقدار رشته("fine"))
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.شمار آرگومان(آرگومان ها)، 2)
    آزمایش.ادعای درستی(سوکت‌آیاو.پاسخ(نخستین، آرگومان ها))
    سوکت‌آیاو.آزادسازی آرگومان(آرگومان ها)
    سوکت‌آیاو.آزادسازی رویداد(نخستین)

    ناپایا دومین := سوکت‌آیاو.رویداد بعدی(c، 2000)
    آزمایش.ادعای برابری عدد(دومین.شماره تایید، 16)
    آزمایش.ادعای درستی(سوکت‌آیاو.پاسخ جیسون(دومین، `{"ok":true}`))
    سوکت‌آیاو.آزادسازی رویداد(دومین)

    رویداد ساده := سوکت‌آیاو.رویداد { شماره تایید = 0 - 1 }
    آزمایش.ادعای نادرستی(سوکت‌آیاو.پاسخ جیسون(رویداد ساده، "1"))
پایان

تابع بررسی خواندن تایید(c: سوکت‌آیاو.کارخواه):
    ناپایا a := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن عدد(a، 2)
    سوکت‌آیاو.افزودن عدد(a، 3)
    ناپایا k := سوکت‌آیاو.ارسال منتظر تایید(c، "add"، a، 2000)
    آزمایش.ادعای درستی(k.رسیده)
    آزمایش.ادعای برابری عدد۶۴(سوکت‌آیاو.عدد تایید(k، 0)، 5)
    آزمایش.ادعای درستی(سوکت‌آیاو.اعشار تایید(k، 1) بزرگتر 2.49 و سوکت‌آیاو.اعشار تایید(k، 1) کوچکتر 2.51)
    آزمایش.ادعای درستی(سوکت‌آیاو.بولی تایید(k، 2))
    ناپایا v := سوکت‌آیاو.مقدار تایید(k، 3)
    آزمایش.ادعای برابری عدد۶۴(مقدار.به صحیح(مقدار.مقدار کلید(v، "z"))، 1)
    مقدار.آزادسازی مقدار(v)
    سوکت‌آیاو.آزادسازی تایید(k)
    سوکت‌آیاو.آزادسازی آرگومان(a)
پایان

تابع بررسی ارسال ها(c: سوکت‌آیاو.کارخواه):
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال عدد(c، "score"، 12))
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال اعشاری(c، "temp"، 21.5))
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال بولی(c، "ready"، درست))
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال جیسون(c، "user"، `{"name":"Ali"}`))
    ناپایا a := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن رشته(a، "room-1")
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال با آرگومان(c، "join"، a))
    سوکت‌آیاو.آزادسازی آرگومان(a)
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال بایت(c، "file"، "abc" برگردان تهی*، 3))
    آزمایش.ادعای نادرستی(سوکت‌آیاو.ارسال با آرگومان(c، "connect"، سوکت‌آیاو.آرگومان جدید()))
    بایت های ارسالی := سوکت‌آیاو.بایت از رشته("xyz")
    آزمایش.ادعای برابری عدد(بایت های ارسالی.طول، 3)
    آزمایش.ادعای برابری رشته(سوکت‌آیاو.بایت به رشته(بایت های ارسالی)، "xyz")
پایان

تابع بررسی ترتیب مدیرها(c: سوکت‌آیاو.کارخواه):
    سوکت‌آیاو.روی دلخواه(c، (_e: سوکت‌آیاو.رویداد): ثبت("a") پایان)
    سوکت‌آیاو.پیش‌افزودن دلخواه(c، (_e: سوکت‌آیاو.رویداد): ثبت("p") پایان)
    سوکت‌آیاو.روی دلخواه خروجی(c، (_e: سوکت‌آیاو.رویداد): ثبت("o") پایان)
    سوکت‌آیاو.پیش‌افزودن دلخواه خروجی(c، (_e: سوکت‌آیاو.رویداد): ثبت("q") پایان)
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.شمار شنونده دلخواه(c)، 4)
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال رشته(c، "go"، "now"))
    آزمایش.ادعای برابری رشته(ردپا، "qo")
    _ := سوکت‌آیاو.پمپ(c، 2000)
    آزمایش.ادعای برابری رشته(ردپا، "qopa")

    سوکت‌آیاو.خاموش دلخواه خروجی(c)
    سوکت‌آیاو.خاموش دلخواه(c)
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.شمار شنونده دلخواه(c)، 0)
    سوکت‌آیاو.روی(c، "one"، (_e: سوکت‌آیاو.رویداد): ثبت("1") پایان)
    سوکت‌آیاو.روی(c، "two"، (_e: سوکت‌آیاو.رویداد): ثبت("2") پایان)
    آزمایش.ادعای درستی(سوکت‌آیاو.شنونده دارد(c، "one"))
    سوکت‌آیاو.خاموش همه(c)
    آزمایش.ادعای نادرستی(سوکت‌آیاو.شنونده دارد(c، "one"))
    آزمایش.ادعای نادرستی(سوکت‌آیاو.شنونده دارد(c، "two"))
پایان

تابع ریشه:
    خادم = وب‌سوکت.شنود(0)
    t := نخ‌ساز(خادم ساختگی)
    ناپایا o := سوکت‌آیاو.گزینه‌های جدید()
    o.حمل‌ونقل = سوکت‌آیاو.حمل‌ونقل وب‌سوکت
    o.اتصال دوباره = نادرست
    c := سوکت‌آیاو.اتصال با("http://127.0.0.1:" + وب‌سوکت.درگاه(خادم)، o)
    آزمایش.ادعای درستی(سوکت‌آیاو.متصل است(c))
    آزمایش.ادعای نادرستی(سوکت‌آیاو.بازیابی شده(c))
    آزمایش.ادعای نادرستی(سوکت‌آیاو.بازیابی شده(سوکت‌آیاو.کارخواه {}))

    بررسی خواندن نوع دار(c)
    بررسی پاسخ ها(c)
    بررسی خواندن تایید(c)
    بررسی ارسال ها(c)
    بررسی ترتیب مدیرها(c)

    m := سوکت‌آیاو.مدیر کلاینت(c)
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.پمپ مدیر(m، 50)، سوکت‌آیاو.پمپ مهلت)
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.پمپ مدیر(سوکت‌آیاو.مدیر {}، 50)، سوکت‌آیاو.پمپ بسته)

    سوکت‌آیاو.قطع اتصال(c)
    آزمایش.ادعای نادرستی(سوکت‌آیاو.متصل است(c))
    سوکت‌آیاو.قطع اتصال(سوکت‌آیاو.کارخواه {})
    سوکت‌آیاو.بستن(c)
    نخ‌پیوند(t)
    وب‌سوکت.بستن سرور(خادم)

    آزمایش.ادعای شامل بودن(سیم، `2["score",12]|`)
    آزمایش.ادعای شامل بودن(سیم، `2["temp",21.5]|`)
    آزمایش.ادعای شامل بودن(سیم، `2["ready",true]|`)
    آزمایش.ادعای شامل بودن(سیم، `2["user",{"name":"Ali"}]|`)
    آزمایش.ادعای شامل بودن(سیم، `2["join","room-1"]|`)
    آزمایش.ادعای شامل بودن(سیم، `51-["file",{"_placeholder":true,"num":0}]|<binary>|`)
    آزمایش.ادعای شامل بودن(سیم، `315[1,"fine"]|`)
    آزمایش.ادعای شامل بودن(سیم، `316[{"ok":true}]|`)
    آزمایش.ادعای شامل بودن(سیم، "disconnect|")
    برگشت آزمایش.خلاصه()
پایان
