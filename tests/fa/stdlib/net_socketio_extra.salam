بسته ریشه

واردسازی شبکه.سوکت‌آیاو
واردسازی شبکه.وب‌سوکت
واردسازی کدگذاری.مقدار
واردسازی رشته
واردسازی آزمایش

ناپایا server := وب‌سوکت.سرور {}
ناپایا wire := ""
ناپایا trace := ""

تابع note(tag: رشته):
    trace += tag
پایان

تابع fake server():
    ناپایا conn := وب‌سوکت.پذیرش(server)
    _ := وب‌سوکت.ارسال متن(conn، `0{"sid":"s1","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    ناپایا going := درست
    تا going:
        m := وب‌سوکت.دریافت با مهلت(conn، 3000)
        اگر m.نوع برابر وب‌سوکت.دودویی:
            wire += "<binary>|"
            گذر
        پایان
        اگر m.نوع نابرابر وب‌سوکت.متن:
            بشکن
        پایان
        packet := m.متن.زیررشته(1، m.متن.طول() - 1)
        اگر packet برابر "0":
            _ := وب‌سوکت.ارسال متن(conn، `40{"sid":"a1"}`)
            _ := وب‌سوکت.ارسال متن(conn، `42["vals",7,2.5,true,"x",{"k":1}]`)
            _ := وب‌سوکت.ارسال متن(conn، `4215["need",1]`)
            _ := وب‌سوکت.ارسال متن(conn، `4216["need",2]`)
        وگرنه رشته.شامل است(packet، `"add"`):
            id := packet.زیررشته(1، رشته.یافتن(packet، "[") - 1)
            _ := وب‌سوکت.ارسال متن(conn، "43" + id + `[5,2.5,true,{"z":1}]`)
        وگرنه رشته.شروع با(packet، `2["go"`):
            wire += packet + "|"
            _ := وب‌سوکت.ارسال متن(conn، `42["tick"]`)
        وگرنه packet برابر "1":
            wire += "disconnect|"
            going = نادرست
        وگرنه:
            wire += packet + "|"
        پایان
    پایان
    وب‌سوکت.بستن(conn)
پایان

تابع check typed reads(c: سوکت‌آیاو.کارخواه):
    ناپایا e := سوکت‌آیاو.رویداد بعدی(c، 2000)
    آزمایش.ادعای برابری عدد(e.نوع، سوکت‌آیاو.رویداد پیام)
    آزمایش.ادعای برابری رشته(e.نام، "vals")
    آزمایش.ادعای برابری عدد۶۴(سوکت‌آیاو.آرگومان عددی(e، 0)، 7)
    آزمایش.ادعای برابری رشته(سوکت‌آیاو.آرگومان رشته(e، 2)، "true")
    آزمایش.ادعای درستی(سوکت‌آیاو.آرگومان اعشاری(e، 1) بزرگتر 2.49 و سوکت‌آیاو.آرگومان اعشاری(e، 1) کوچکتر 2.51)
    آزمایش.ادعای درستی(سوکت‌آیاو.آرگومان بولی(e، 2))
    ناپایا v := سوکت‌آیاو.مقدار آرگومان(e، 4)
    آزمایش.ادعای درستی(مقدار.شیء است(v))
    آزمایش.ادعای برابری عدد۶۴(مقدار.به صحیح(مقدار.مقدار کلید(v، "k"))، 1)
    مقدار.آزادسازی مقدار(v)
    سوکت‌آیاو.آزادسازی رویداد(e)
پایان

تابع check replies(c: سوکت‌آیاو.کارخواه):
    ناپایا first := سوکت‌آیاو.رویداد بعدی(c، 2000)
    آزمایش.ادعای برابری رشته(first.نام، "need")
    آزمایش.ادعای برابری عدد(first.شماره تایید، 15)
    ناپایا args := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن عدد(args، 1)
    سوکت‌آیاو.افزودن مقدار(args، مقدار.مقدار رشته("fine"))
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.شمار آرگومان(args)، 2)
    آزمایش.ادعای درستی(سوکت‌آیاو.پاسخ(first، args))
    سوکت‌آیاو.آزادسازی آرگومان(args)
    سوکت‌آیاو.آزادسازی رویداد(first)

    ناپایا second := سوکت‌آیاو.رویداد بعدی(c، 2000)
    آزمایش.ادعای برابری عدد(second.شماره تایید، 16)
    آزمایش.ادعای درستی(سوکت‌آیاو.پاسخ جیسون(second، `{"ok":true}`))
    سوکت‌آیاو.آزادسازی رویداد(second)

    plain := سوکت‌آیاو.رویداد { شماره تایید = 0 - 1 }
    آزمایش.ادعای نادرستی(سوکت‌آیاو.پاسخ جیسون(plain، "1"))
پایان

تابع check ack reads(c: سوکت‌آیاو.کارخواه):
    ناپایا a := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن عدد(a، 2)
    سوکت‌آیاو.افزودن عدد(a، 3)
    ناپایا k := سوکت‌آیاو.ارسال منتظر تایید(c، "add"، a، 2000)
    آزمایش.ادعای درستی(k.رسیده)
    آزمایش.ادعای برابری عدد۶۴(سوکت‌آیاو.عدد تایید(k، 0)، 5)
    آزمایش.ادعای درستی(سوکت‌آیاو.اعشار تایید(k، 1) بزرگتر 2.49 و سوکت‌آیاو.اعشار تایید(k، 1) کوچکتر 2.51)
    آزمایش.ادعای درستی(سوکت‌آیاو.بولی تایید(k، 2))
    ناپایا v := سوکت‌آیاو.مقدار تایید(k، 3)
    آزمایش.ادعای برابری عدد۶۴(مقدار.به صحیح(مقدار.مقدار کلید(v، "z"))، 1)
    مقدار.آزادسازی مقدار(v)
    سوکت‌آیاو.آزادسازی تایید(k)
    سوکت‌آیاو.آزادسازی آرگومان(a)
پایان

تابع check emits(c: سوکت‌آیاو.کارخواه):
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال عدد(c، "score"، 12))
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال اعشاری(c، "temp"، 21.5))
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال بولی(c، "ready"، درست))
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال جیسون(c، "user"، `{"name":"Ali"}`))
    ناپایا a := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن رشته(a، "room-1")
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال با آرگومان(c، "join"، a))
    سوکت‌آیاو.آزادسازی آرگومان(a)
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال بایت(c، "file"، "abc" برگردان تهی*، 3))
    آزمایش.ادعای نادرستی(سوکت‌آیاو.ارسال با آرگومان(c، "connect"، سوکت‌آیاو.آرگومان جدید()))
    pending := سوکت‌آیاو.بایت از رشته("xyz")
    آزمایش.ادعای برابری عدد(pending.طول، 3)
    آزمایش.ادعای برابری رشته(سوکت‌آیاو.بایت به رشته(pending)، "xyz")
پایان

تابع check handler order(c: سوکت‌آیاو.کارخواه):
    سوکت‌آیاو.روی دلخواه(c، (_e: سوکت‌آیاو.رویداد): note("a") پایان)
    سوکت‌آیاو.پیش‌افزودن دلخواه(c، (_e: سوکت‌آیاو.رویداد): note("p") پایان)
    سوکت‌آیاو.روی دلخواه خروجی(c، (_e: سوکت‌آیاو.رویداد): note("o") پایان)
    سوکت‌آیاو.پیش‌افزودن دلخواه خروجی(c، (_e: سوکت‌آیاو.رویداد): note("q") پایان)
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.شمار شنونده دلخواه(c)، 4)
    آزمایش.ادعای درستی(سوکت‌آیاو.ارسال رشته(c، "go"، "now"))
    آزمایش.ادعای برابری رشته(trace، "qo")
    _ := سوکت‌آیاو.پمپ(c، 2000)
    آزمایش.ادعای برابری رشته(trace، "qopa")

    سوکت‌آیاو.خاموش دلخواه خروجی(c)
    سوکت‌آیاو.خاموش دلخواه(c)
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.شمار شنونده دلخواه(c)، 0)
    سوکت‌آیاو.روی(c، "one"، (_e: سوکت‌آیاو.رویداد): note("1") پایان)
    سوکت‌آیاو.روی(c، "two"، (_e: سوکت‌آیاو.رویداد): note("2") پایان)
    آزمایش.ادعای درستی(سوکت‌آیاو.شنونده دارد(c، "one"))
    سوکت‌آیاو.خاموش همه(c)
    آزمایش.ادعای نادرستی(سوکت‌آیاو.شنونده دارد(c، "one"))
    آزمایش.ادعای نادرستی(سوکت‌آیاو.شنونده دارد(c، "two"))
پایان

تابع ریشه:
    server = وب‌سوکت.شنود(0)
    t := نخ‌ساز(fake server)
    ناپایا o := سوکت‌آیاو.گزینه‌های جدید()
    o.حمل‌ونقل = سوکت‌آیاو.حمل‌ونقل وب‌سوکت
    o.اتصال دوباره = نادرست
    c := سوکت‌آیاو.اتصال با("http://127.0.0.1:" + وب‌سوکت.درگاه(server)، o)
    آزمایش.ادعای درستی(سوکت‌آیاو.متصل است(c))
    آزمایش.ادعای نادرستی(سوکت‌آیاو.بازیابی شده(c))
    آزمایش.ادعای نادرستی(سوکت‌آیاو.بازیابی شده(سوکت‌آیاو.کارخواه {}))

    check typed reads(c)
    check replies(c)
    check ack reads(c)
    check emits(c)
    check handler order(c)

    m := سوکت‌آیاو.مدیر کلاینت(c)
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.پمپ مدیر(m، 50)، سوکت‌آیاو.پمپ مهلت)
    آزمایش.ادعای برابری عدد(سوکت‌آیاو.پمپ مدیر(سوکت‌آیاو.مدیر {}، 50)، سوکت‌آیاو.پمپ بسته)

    سوکت‌آیاو.قطع اتصال(c)
    آزمایش.ادعای نادرستی(سوکت‌آیاو.متصل است(c))
    سوکت‌آیاو.قطع اتصال(سوکت‌آیاو.کارخواه {})
    سوکت‌آیاو.بستن(c)
    نخ‌پیوند(t)
    وب‌سوکت.بستن سرور(server)

    آزمایش.ادعای شامل بودن(wire، `2["score",12]|`)
    آزمایش.ادعای شامل بودن(wire، `2["temp",21.5]|`)
    آزمایش.ادعای شامل بودن(wire، `2["ready",true]|`)
    آزمایش.ادعای شامل بودن(wire، `2["user",{"name":"Ali"}]|`)
    آزمایش.ادعای شامل بودن(wire، `2["join","room-1"]|`)
    آزمایش.ادعای شامل بودن(wire، `51-["file",{"_placeholder":true,"num":0}]|<binary>|`)
    آزمایش.ادعای شامل بودن(wire، `315[1,"fine"]|`)
    آزمایش.ادعای شامل بودن(wire، `316[{"ok":true}]|`)
    آزمایش.ادعای شامل بودن(wire، "disconnect|")
    برگشت آزمایش.خلاصه()
پایان
