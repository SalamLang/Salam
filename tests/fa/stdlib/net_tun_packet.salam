// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تون

تابع هیکس4(و_: صحیح): رشته:
    دیگیتس := "0123456789abcdef"
    ناپایا ووت := ""
    تکرار 4 در ی:
        د := (و_ >> ((3 - ی) * 4)) & 15
        ووت += دیگیتس.زیررشته(د، 1)
    پایان
    برگشت ووت
پایان

تابع ریشه():
    هدر := حافظه.تخصیص صفرشده(20 برگردان طبیعی۶۴) برگردان طبیعی۸*
    بیتیس := [69، 0، 0، 115، 0، 0، 64، 0، 64، 17، 0، 0، 192، 168، 0، 1، 192، 168، 0، 199]
    تکرار 20 در ی:
        هدر[ی] = بیتیس[ی] برگردان طبیعی۸
    پایان
    مجموع := تون.جمع آزما(هدر برگردان تهی*، 20)
    سرچاپ "ipv4 header checksum"، هیکس4(مجموع)
    هدر[10] = ((مجموع >> 8) & 255) برگردان طبیعی۸
    هدر[11] = (مجموع & 255) برگردان طبیعی۸
    سرچاپ "verifies"، تون.جمع آزما(هدر برگردان تهی*، 20) برابر 0
    حافظه.آزادسازی(هدر برگردان تهی*)

    سرچاپ "adjust"، هیکس4(تون.به‌روزرسانی جمع آزما(0xdd2f، 0x5555، 0x3285))

    پایلواد := "hello"
    پک := تون.ساخت بسته‌ی تی سی پی(
        "172.19.0.1"،
        40000،
        "93.184.216.34"،
        443،
        1000 برگردان صحیح۶۴،
        0 برگردان صحیح۶۴،
        تون.پرچم همگام‌سازی،
        پایلواد برگردان تهی*،
        5
    )
    سرچاپ "tcp packet"، پک.طول، تون.درستی جمع آزماها(پک.داده، پک.طول)
    اطلاعات := تون.تجزیه‌بسته(پک.داده، پک.طول)
    سرچاپ "parsed"،
        اطلاعات.معتبر،
        اطلاعات.نسخه،
        اطلاعات.پروتکل،
        اطلاعات.مبدا،
        اطلاعات.درگاه مبدا،
        اطلاعات.مقصد،
        اطلاعات.درگاه مقصد،
        اطلاعات.پرچم‌ها،
        اطلاعات.طول داده

    نات := تون.ترجمه نشانی تازه("172.19.0.1"، "172.19.0.2"، 7000، 0)
    اکت := نات.بازنویسی(پک.داده، پک.طول، 1000 برگردان صحیح۶۴)
    ووت := تون.تجزیه‌بسته(پک.داده، پک.طول)
    سرچاپ "forward"،
        اکت برابر تون.کنش بازفرستادن،
        ووت.مبدا،
        ووت.درگاه مبدا،
        ووت.مقصد،
        ووت.درگاه مقصد،
        تون.درستی جمع آزماها(پک.داده، پک.طول)
    ینتری := نات.جستجو(ووت.درگاه مبدا)
    سرچاپ "lookup"، ینتری.درست، ینتری.مبدا، ینتری.درگاه مبدا، ینتری.مقصد، ینتری.درگاه مقصد
    اگاین := تون.ساخت بسته‌ی تی سی پی(
        "172.19.0.1"،
        40000،
        "93.184.216.34"،
        443،
        1001 برگردان صحیح۶۴،
        0 برگردان صحیح۶۴،
        تون.پرچم تایید،
        پایلواد برگردان تهی*،
        5
    )
    _ا := نات.بازنویسی(اگاین.داده، اگاین.طول، 1001 برگردان صحیح۶۴)
    سامی := تون.تجزیه‌بسته(اگاین.داده، اگاین.طول)
    سرچاپ "same port"، سامی.درگاه مبدا برابر ووت.درگاه مبدا، نات.فعال‌ها()

    ریپلی := تون.ساخت بسته‌ی تی سی پی(
        "172.19.0.1"،
        7000،
        "172.19.0.2"،
        ووت.درگاه مبدا،
        5000 برگردان صحیح۶۴،
        1001 برگردان صحیح۶۴،
        تون.پرچم همگام‌سازی | تون.پرچم تایید،
        پوچ،
        0
    )
    عقب := نات.بازنویسی(ریپلی.داده، ریپلی.طول، 1002 برگردان صحیح۶۴)
    رب := تون.تجزیه‌بسته(ریپلی.داده، ریپلی.طول)
    سرچاپ "reply"،
        عقب برابر تون.کنش بازفرستادن،
        رب.مبدا،
        رب.درگاه مبدا،
        رب.مقصد،
        رب.درگاه مقصد،
        رب.پرچم‌ها،
        تون.درستی جمع آزماها(ریپلی.داده، ریپلی.طول)

    سترای := تون.ساخت بسته‌ی تی سی پی(
        "172.19.0.1"،
        7000،
        "172.19.0.2"،
        12345،
        1 برگردان صحیح۶۴،
        1 برگردان صحیح۶۴،
        تون.پرچم تایید،
        پوچ،
        0
    )
    سرچاپ "unknown reply dropped"،
        نات.بازنویسی(سترای.داده، سترای.طول، 1003 برگردان صحیح۶۴) برابر تون.کنش دورریختن

    دنس := تون.ساخت بسته‌ی یو دی پی("172.19.0.1"، 5353، "172.19.0.2"، 53، پایلواد برگردان تهی*، 5)
    سرچاپ "dns"،
        نات.بازنویسی(دنس.داده، دنس.طول، 1004 برگردان صحیح۶۴) برابر تون.کنش نام‌یابی،
        تون.درستی جمع آزماها(دنس.داده، دنس.طول)
    وتهیر := تون.ساخت بسته‌ی یو دی پی("172.19.0.1"، 5353، "8.8.8.8"، 443، پایلواد برگردان تهی*، 5)
    سرچاپ "other udp dropped"،
        نات.بازنویسی(وتهیر.داده، وتهیر.طول، 1005 برگردان صحیح۶۴) برابر تون.کنش دورریختن
    لووپ := تون.ساخت بسته‌ی تی سی پی(
        "172.19.0.1"،
        40001،
        "127.0.0.1"،
        80،
        1 برگردان صحیح۶۴،
        0 برگردان صحیح۶۴،
        تون.پرچم همگام‌سازی،
        پوچ،
        0
    )
    سرچاپ "loopback dropped"،
        نات.بازنویسی(لووپ.داده، لووپ.طول، 1006 برگردان صحیح۶۴) برابر تون.کنش دورریختن

    رست := تون.ساخت بسته‌ی تی سی پی(
        "172.19.0.1"،
        40000،
        "93.184.216.34"،
        443،
        1002 برگردان صحیح۶۴،
        0 برگردان صحیح۶۴،
        تون.پرچم بازنشانی،
        پوچ،
        0
    )
    _ر := نات.بازنویسی(رست.داده، رست.طول، 2000 برگردان صحیح۶۴)
    سرچاپ "swept early"، نات.پاکسازی(5000 برگردان صحیح۶۴)
    سرچاپ "swept closed"، نات.پاکسازی(20000 برگردان صحیح۶۴)، نات.فعال‌ها()

    تون.آزادسازی‌بسته(پک)
    تون.آزادسازی‌بسته(اگاین)
    تون.آزادسازی‌بسته(ریپلی)
    تون.آزادسازی‌بسته(سترای)
    تون.آزادسازی‌بسته(دنس)
    تون.آزادسازی‌بسته(وتهیر)
    تون.آزادسازی‌بسته(لووپ)
    تون.آزادسازی‌بسته(رست)
    تون.آزادسازی ترجمه(نات)
پایان
