linux gateway true 10.0.0.1 eth0
point to point true 0 ppp0
no default false
mac gateway true 192.168.1.1 en0
resolvers 1 192.168.1.1
scutil 2 10.0.0.53 1.1.1.1
names true true false false false
next 172.19.0.2 10.0.1.0
== linux
up   ip addr add 172.19.0.1/30 dev salamtun
up   ip link set dev salamtun mtu 1500 up
up   ip route replace 203.0.113.7/32 via 192.168.1.1 dev wlan0 onlink
up   -ip route replace 192.168.1.1/32 dev salamtun
up   -ip route replace 10.0.0.53/32 dev salamtun
up   ip route replace 0.0.0.0/1 dev salamtun
up   ip route replace 128.0.0.0/1 dev salamtun
up   -ip -6 route replace unreachable ::/1
up   -ip -6 route replace unreachable 8000::/1
up   -resolvectl dns salamtun 172.19.0.2
up   -resolvectl domain salamtun ~.
up   -resolvectl default-route salamtun true
down -ip route del 203.0.113.7/32
down -ip -6 route del unreachable ::/1
down -ip -6 route del unreachable 8000::/1
down -resolvectl revert salamtun
== macos
up   ifconfig utun7 inet 172.19.0.1 172.19.0.1 netmask 255.255.255.252 mtu 1500 up
up   -route -q -n add -net 172.19.0.0/30 -interface utun7
up   route -q -n add -host 203.0.113.7 192.168.1.1
up   -route -q -n add -host 10.0.0.53 -interface utun7
up   route -q -n add -net 0.0.0.0/1 -interface utun7
up   route -q -n add -net 128.0.0.0/1 -interface utun7
up   -ifconfig utun7 inet6 fdfe:dcba:9876::1 prefixlen 126
up   -route -q -n add -inet6 -net ::/1 -interface utun7
up   -route -q -n add -inet6 -net 8000::/1 -interface utun7
down -route -q -n delete -host 203.0.113.7
down -route -q -n delete -host 10.0.0.53
== windows
up   netsh interface ipv4 set address name=salamtun source=static address=172.19.0.1 mask=255.255.255.252
up   -netsh interface ipv4 set subinterface salamtun mtu=1500 store=active
up   -netsh interface ipv4 set interface salamtun metric=1
up   -netsh advfirewall firewall add rule name=salam-tun-salamtun dir=in action=allow protocol=TCP enable=yes profile=any program="C:\Program Files\App\app.exe"
up   route add 203.0.113.7 mask 255.255.255.255 192.168.1.1 metric 1 if 12
up   -netsh interface ipv4 set dnsservers name=salamtun source=static address=172.19.0.2 register=none validate=no
up   -powershell -NoProfile -NonInteractive -Command "Add-DnsClientNrptRule -Namespace '.' -NameServers '172.19.0.2' -Comment 'salam-tun-salamtun'"
up   -netsh interface ipv4 add route prefix=10.0.0.53/32 interface=salamtun store=active
up   netsh interface ipv4 add route prefix=0.0.0.0/1 interface=salamtun store=active
up   netsh interface ipv4 add route prefix=128.0.0.0/1 interface=salamtun store=active
up   -netsh interface ipv6 add address interface=salamtun address=fdfe:dcba:9876::1/126 store=active
up   -netsh interface ipv6 add route prefix=::/1 interface=salamtun store=active
up   -netsh interface ipv6 add route prefix=8000::/1 interface=salamtun store=active
down -netsh advfirewall firewall delete rule name=salam-tun-salamtun
down -route delete 203.0.113.7 mask 255.255.255.255
down -powershell -NoProfile -NonInteractive -Command "Get-DnsClientNrptRule | Where-Object Comment -eq 'salam-tun-salamtun' | Remove-DnsClientNrptRule -Force"
== linux no routes
up   ip addr add 172.19.0.1/30 dev t0
up   ip link set dev t0 mtu 1500 up
== unknown
split 7 program=C:\Program Files\App\app.exe
