// زبان: فارسی
واردسازی شبکه.تون

تابع نمایش(عنوان: رشته، پل: تون.نقشه):
    سرچاپ "=="، عنوان
    هر خط در پل.برپایی:
        سرچاپ "up  "، خط
    پایان
    هر خط در پل.برچیدن:
        سرچاپ "down"، خط
    پایان
پایان

تابع ریشه():
    رووتیس := "Iface\tDestination\tGateway \tFlags\tRefCnt\tUse\tMetric\tMask\t\tMTU\tWindow\tIRTT\n" +
        "wlan0\t00000000\t0101A8C0\t0003\t0\t0\t600\t00000000\t0\t0\t0\n" +
        "eth0\t00000000\t0100000A\t0003\t0\t0\t100\t00000000\t0\t0\t0\n" +
        "eth0\t0000000A\t00000000\t0001\t0\t0\t100\t00FFFFFF\t0\t0\t0\n"
    گو := تون.تجزیه مسیرهای لینوکس(رووتیس)
    سرچاپ "linux gateway"، گو.درست، گو.نشانی دروازه، گو.رابط
    پپپ := تون.تجزیه مسیرهای لینوکس("Iface\tDestination\tGateway\tFlags\tRefCnt\tUse\tMetric\tMask\nppp0\t00000000\t00000000\t0001\t0\t0\t0\t00000000\n")
    سرچاپ "point to point"، پپپ.درست، پپپ.نشانی دروازه.طول()، پپپ.رابط
    سرچاپ "no default"، تون.تجزیه مسیرهای لینوکس("Iface\tDestination\n").درست

    ماک := تون.تجزیه مسیر مک("   route to: default\ndestination: default\n       mask: default\n    gateway: 192.168.1.1\n  interface: en0\n      flags: <UP,GATEWAY,DONE,STATIC,PRCLONING>\n")
    سرچاپ "mac gateway"، ماک.درست، ماک.نشانی دروازه، ماک.رابط

    ریسولو := تون.تجزیه نام‌یاب‌ها("# generated\nnameserver 192.168.1.1\nnameserver 192.168.1.1\nnameserver fe80::1\nsearch lan\n")
    سرچاپ "resolvers"، ریسولو.طول()، ریسولو[0]
    سکوتیل := تون.تجزیه نام‌یاب‌ها("resolver #1\n  nameserver[0] : 10.0.0.53\n  nameserver[1] : 1.1.1.1\n")
    سرچاپ "scutil"، سکوتیل.طول()، سکوتیل[0]، سکوتیل[1]

    سرچاپ "names"، تون.نام معتبر("salamtun")، تون.نام معتبر("utun9")، تون.نام معتبر("bad name")، تون.نام معتبر("")، تون.نام معتبر("waytoolonginterface")
    سرچاپ "next"، تون.نشانی بعدی("172.19.0.1")، تون.نشانی بعدی("10.0.0.255")

    ناپایا هوستس := وکتور {} برگردان وکتور<رشته>
    هوستس.افزودن("203.0.113.7")
    ناپایا دنس := وکتور {} برگردان وکتور<رشته>
    دنس.افزودن("192.168.1.1")
    دنس.افزودن("8.8.8.8")
    دنس.افزودن("10.0.0.53")
    وپتس := تون.گزینه‌ها { نام = "salamtun" }
    لگو := تون.دروازه { درست = درست، نشانی دروازه = "192.168.1.1"، رابط = "wlan0" }
    نمایش("linux"، تون.ساخت نقشه("linux"، "salamtun"، وپتس، لگو، هوستس، دنس، ""))
    مگو := تون.دروازه { درست = درست، نشانی دروازه = "192.168.1.1"، رابط = "en0" }
    نمایش("macos"، تون.ساخت نقشه("macos"، "utun7"، وپتس، مگو، هوستس، دنس، ""))
    وگو := تون.دروازه { درست = درست، نشانی دروازه = "192.168.1.1"، رابط = "Wi-Fi"، شماره رابط = 12 }
    نمایش("windows"، تون.ساخت نقشه("windows"، "salamtun"، وپتس، وگو، هوستس، دنس، "C:\\Program Files\\App\\app.exe"))
    باری := تون.گزینه‌ها { نام = "t0"، مسیریابی خودکار = نادرست }
    نمایش("linux no routes"، تون.ساخت نقشه("linux"، "t0"، باری، لگو، هوستس، دنس، ""))
    نمایش("unknown"، تون.ساخت نقشه("plan9"، "t0"، وپتس، لگو، هوستس، دنس، ""))

    پارتس := تون.شکستن فرمان("netsh advfirewall firewall add rule name=x program=\"C:\\Program Files\\App\\app.exe\"")
    سرچاپ "split"، پارتس.طول()، پارتس[پارتس.طول() - 1]
پایان
