// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تون
واردسازی شبکه.تونل

تابع ریشه():
    او := تون.در‌دسترس بودن()
    سرچاپ "availability explained"، او.درست یا او.دلیل.طول() بزرگتر 0
    سرچاپ "platform known"، تون.سکو().طول() بزرگتر 0
    گو := تون.دروازه پیش‌فرض()
    سرچاپ "gateway call"، گو.درست یا وارونه گو.درست
    دنس := تون.نام‌یاب‌های سامانه()
    سرچاپ "resolvers call"، دنس.طول() بزرگتربرابر 0
    دنس.آزادکن()
    سرچاپ "running before"، تون.در‌حال اجرا()

    س := تون.آغاز(تون.گزینه‌ها { نشانی = "999.1.1.1"، شماره‌گیر = تونل.مسدود() })
    سرچاپ "bad start refused"، س.درست، تون.آخرین خطا().طول() بزرگتر 0، س.خطا برابر تون.آخرین خطا()
    ست := تون.آمار نشست(س)
    سرچاپ "no stats"، ست.بسته‌های‌ورودی، ست.اتصال‌ها
    تون.توقف(س)
    سرچاپ "running after"، تون.در‌حال اجرا()

    دیو := تون.باز کردن دستگاه("bad name!"، 1500)
    سرچاپ "bad device refused"، دیو.درست، دیو.خطا.طول() بزرگتر 0
    بوف := حافظه.تخصیص صفرشده(64 برگردان طبیعی۶۴)
    سرچاپ "closed device io"، دیو.خواندن(بوف، 64، 10)، دیو.نوشتن(بوف، 20)
    دیو.بستن()
    حافظه.آزادسازی(بوف)

    بد := تون.شماره‌گیر دورزن تازه()
    سرچاپ "bypass name"، بد.نام()، بد.مهلت اتصال
    نووهیری := تونل.نشانی {}
    ک := بد.اتصال(نووهیری)
    سرچاپ "invalid target"، ک.معتبر()
    د := تون.دورزن()
    سرچاپ "dyn bypass"، د.نام()

    نات := تون.ترجمه نشانی تازه("172.19.0.1"، "172.19.0.2"، 7000، 0)
    سرچاپ "nat port"، نات.درگاه شنونده()
    پک := تون.ساخت بسته‌ی یو دی پی("10.0.0.2"، 1، "10.0.0.1"، 2، پوچ، 0)
    پ := پک.داده برگردان طبیعی۸*
    پ[8] = 1 برگردان طبیعی۸
    سرچاپ "ttl edit breaks"، تون.درستی جمع آزماها(پک.داده، پک.طول)
    تون.تکمیل جمع آزماها(پک.داده، پک.طول)
    سرچاپ "finish fixes"، تون.درستی جمع آزماها(پک.داده، پک.طول)
    تون.آزادسازی‌بسته(پک)
    تون.آزادسازی ترجمه(نات)
    سرچاپ "bad nat"، تون.ترجمه نشانی تازه("x"، "y"، 1، 0).درگاه شنونده()
پایان
