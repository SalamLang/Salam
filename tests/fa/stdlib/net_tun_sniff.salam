// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تون

تابع گذاشتن(پ: طبیعی۸*، در_: صحیح، بیتیس: صحیح[]): صحیح:
    تکرار بیتیس.طول() در ی:
        پ[در_ + ی] = بیتیس[ی] برگردان طبیعی۸
    پایان
    برگشت در_ + بیتیس.طول()
پایان

تابع گذاشتن ستر(پ: طبیعی۸*، در_: صحیح، س: رشته): صحیح:
    ق := س برگردان طبیعی۸*
    تکرار س.طول() در ی:
        پ[در_ + ی] = ق[ی]
    پایان
    برگشت در_ + س.طول()
پایان

تابع کارخواه هیللو(هوست: رشته، با پاددینگ: منطقی): تون.بسته‌خام:
    بوف := حافظه.تخصیص صفرشده(1024 برگردان طبیعی۶۴) برگردان طبیعی۸*
    هل := هوست.طول()
    یکست := حافظه.تخصیص صفرشده(512 برگردان طبیعی۶۴) برگردان طبیعی۸*
    ناپایا یکست طول := 0
    اگر با پاددینگ:
        یکست طول = گذاشتن(یکست، یکست طول، [0، 21، 0، 4، 0، 0، 0، 0])
    پایان
    یکست طول = گذاشتن(یکست، یکست طول، [0، 0، 0، هل + 5، 0، هل + 3، 0، 0، هل])
    یکست طول = گذاشتن ستر(یکست، یکست طول، هوست)
    یکست طول = گذاشتن(یکست، یکست طول، [0، 43، 0، 3، 2، 3، 4])
    ناپایا بودی := 0
    بودی شروع := 9
    ناپایا ی := بودی شروع
    ی = گذاشتن(بوف، ی، [3، 3])
    تکرار 32 در ک:
        بوف[ی + ک] = ک برگردان طبیعی۸
    پایان
    ی += 32
    ی = گذاشتن(بوف، ی، [0])
    ی = گذاشتن(بوف، ی، [0، 2، 19، 1])
    ی = گذاشتن(بوف، ی، [1، 0])
    ی = گذاشتن(بوف، ی، [(یکست طول >> 8) & 255، یکست طول & 255])
    تکرار یکست طول در ک:
        بوف[ی + ک] = یکست[ک]
    پایان
    ی += یکست طول
    بودی = ی - بودی شروع
    هس := بودی + 4
    _ا := گذاشتن(بوف، 0، [22، 3، 1، (هس >> 8) & 255، هس & 255، 1، 0، (بودی >> 8) & 255، بودی & 255])
    حافظه.آزادسازی(یکست برگردان تهی*)
    برگشت تون.بسته‌خام { داده = بوف برگردان تهی*، طول = ی }
پایان

تابع ریشه():
    ا := کارخواه هیللو("Example.COM"، نادرست)
    سرچاپ "sni"، تون.شناسایی میزبان(ا.داده، ا.طول)
    ب := کارخواه هیللو("cdn.example.org"، درست)
    سرچاپ "sni after padding"، تون.شناسایی میزبان(ب.داده، ب.طول)
    سرچاپ "sni truncated"، تون.شناسایی میزبان(ب.داده، 40).طول()
    یپ := کارخواه هیللو("1.2.3.4"، نادرست)
    سرچاپ "sni ip ignored"، تون.شناسایی میزبان(یپ.داده، یپ.طول).طول()
    تون.آزادسازی‌بسته(ا)
    تون.آزادسازی‌بسته(ب)
    تون.آزادسازی‌بسته(یپ)

    ریق := "GET /index.html HTTP/1.1\r\nUser-Agent: x\r\nhOsT:  www.Example.net:8080\r\nAccept: */*\r\n\r\n"
    سرچاپ "http host"، تون.شناسایی میزبان(ریق برگردان تهی*، ریق.طول())
    نونی := "GET / HTTP/1.1\r\nAccept: */*\r\n\r\nHost: late.example\r\n"
    سرچاپ "host after headers"، تون.شناسایی میزبان(نونی برگردان تهی*، نونی.طول()).طول()
    سسه := "SSH-2.0-OpenSSH_9.6\r\n"
    سرچاپ "ssh"، تون.شناسایی میزبان(سسه برگردان تهی*، سسه.طول()).طول()

    ق := تون.ساخت پرسش نام‌یابی(4660، "www.example.com"، 1)
    سرچاپ "dns query bytes"، ق.طول
    پارسید := تون.تجزیه پرسش نام‌یابی(ق.داده، ق.طول)
    سرچاپ "dns parsed"، پارسید.درست، پارسید.شناسه، پارسید.نام، پارسید.نوع‌پرسش
    پ := ق.داده برگردان طبیعی۸*
    پ[2] = 129 برگردان طبیعی۸
    سرچاپ "dns response rejected"، تون.تجزیه پرسش نام‌یابی(ق.داده، ق.طول).درست
    سرچاپ "dns short rejected"، تون.تجزیه پرسش نام‌یابی(ق.داده، 14).درست
    تون.آزادسازی‌بسته(ق)
    اااا := تون.ساخت پرسش نام‌یابی(1، "ipv6.example."، 28)
    سرچاپ "aaaa"،
        تون.تجزیه پرسش نام‌یابی(اااا.داده، اااا.طول).نام،
        تون.تجزیه پرسش نام‌یابی(اااا.داده، اااا.طول).نوع‌پرسش
    تون.آزادسازی‌بسته(اااا)
پایان
