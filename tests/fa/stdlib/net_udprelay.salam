// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.یو دی پی
واردسازی شبکه.رله یو دی پی
واردسازی شبکه.تی سی پی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.داخلی.ورودی خروجی توصیف‌گر

ساختار پژواک:
    همگانی گوش: یو دی پی.سوکت یو دی پی = یو دی پی.سوکت یو دی پی {}
پایان

ساختار گذرها:
    همگانی ورودی: صحیح۶۴ = -1
    همگانی خروجی: صحیح۶۴ = -1
پایان

ساختار شنونده:
    همگانی مهار: صحیح۶۴ = -1
    همگانی درگاه رله: صحیح = 0
پایان

تابع بازتاب(ی: پژواک*):
    انباره := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    تا درست:
        ناپایا میزبان := ""
        ناپایا شماره درگاه := 0
        ن := یو دی پی.دریافت بایت(ی[0].گوش، انباره، 4096، میزبان، شماره درگاه)
        اگر ن بزرگتر 0:
            _س := یو دی پی.ارسال بایت(ی[0].گوش، میزبان، شماره درگاه، انباره، ن)
        پایان
    پایان
پایان

تابع کارساز(پ: گذرها*):
    ناپایا گزینه := رله یو دی پی.گزینه های کارساز {}
    گزینه.اجازه لوپ بک = درست
    _شد := رله یو دی پی.خدمت دادن(پ[0].ورودی، پ[0].خروجی، گزینه)
پایان

تابع گوش کردن(ش: شنونده*):
    _شد := رله یو دی پی.گوش دادن(
        ش[0].درگاه رله،
        "0123456789abcdef0123456789abcdef",
        ش[0].مهار،
        رله یو دی پی.گزینه های کارساز { اجازه لوپ بک = درست }
    )
پایان

تابع از راه سوکت(رله: صحیح، مقصد: صحیح، رمز: رشته):
    ک := رله یو دی پی.کارخواه سوکتی((): برگشت تی سی پی.شماره گیری با مهلت("127.0.0.1"، رله، 2000).توصیفگر پایان، رمز)
    انباره := حافظه.تخصیص صفرشده(4096 برگردان طبیعی۶۴)
    ناپایا هیچ := رله یو دی پی.داده‌گرام {}
    تکرار 40:
        اگر ک.آماده() برابر نادرست:
            _ن := ک.دریافت(انباره، 4000، هیچ، 50)
        پایان
    پایان
    سرچاپ "socket ready"، ک.آماده()
    اگر ک.آماده():
        پرسیدن(ک، 41000، مقصد، "over a socket")
    پایان
    ک.بستن()
    حافظه.آزادسازی(انباره)
پایان

تابع پرسیدن(ک: رله یو دی پی.کارخواه رله، شماره: صحیح، مقصد: صحیح، متن: رشته):
    نشانی محلی := رله یو دی پی.خواندن نشانی("127.0.0.1")
    _س := ک.فرستادن(شماره، نشانی محلی، مقصد، متن برگردان تهی*، متن.طول())
    انباره := حافظه.تخصیص صفرشده(4096 برگردان طبیعی۶۴)
    ناپایا مبدا := رله یو دی پی.داده‌گرام {}
    ناپایا رسیده := 0
    تکرار 100:
        اگر رسیده برابر 0:
            رسیده = ک.دریافت(انباره، 4000، مبدا، 50)
        پایان
    پایان
    سرچاپ "flow"،
        مبدا.جریان،
        "from"،
        رله یو دی پی.نوشتن نشانی(مبدا.نشانی)،
        مبدا.درگاه برابر مقصد،
        "bytes"،
        رسیده،
        رسیده برابر متن.طول()
    حافظه.آزادسازی(انباره)
پایان

تابع ریشه:
    سر := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴) برگردان طبیعی۸*
    رله یو دی پی.ساخت سرآیند(
        سر برگردان تهی*،
        رله یو دی پی.داده‌گرام {
            جریان = 51000،
            نشانی = رله یو دی پی.خواندن نشانی("203.0.113.9")،
            درگاه = 443،
            طول = 1200
        }
    )
    ناپایا پس := رله یو دی پی.داده‌گرام {}
    رله یو دی پی.خواندن سرآیند(سر برگردان تهی*، پس)
    سرچاپ "back"، پس.جریان، رله یو دی پی.نوشتن نشانی(پس.نشانی)، پس.درگاه، پس.طول
    سرچاپ "bad"، رله یو دی پی.خواندن نشانی("1.2.3")
    تهی رله := رله یو دی پی.بدون رله {}
    ناپایا هیچ := رله یو دی پی.داده‌گرام {}
    سرچاپ "none"،
        تهی رله.فرستادن(1، 0 برگردان صحیح۶۴، 1، سر برگردان تهی*، 1)،
        تهی رله.دریافت(سر برگردان تهی*، 1، هیچ، 1)
    تهی رله.بستن()

    ی := حافظه.تخصیص صفرشده(اندازه(پژواک) برگردان طبیعی۶۴) برگردان پژواک*
    ی[0].گوش = یو دی پی.پیوند روی("127.0.0.1"، 0)
    مقصد := یو دی پی.درگاه(ی[0].گوش)
    _پ := نخ‌ساز(بازتاب، ی)
    به کارساز := ورودی خروجی توصیف‌گر.ساخت لوله()
    به کارخواه := ورودی خروجی توصیف‌گر.ساخت لوله()
    پ := حافظه.تخصیص صفرشده(اندازه(گذرها) برگردان طبیعی۶۴) برگردان گذرها*
    پ[0] = گذرها { ورودی = به کارساز.خواندن، خروجی = به کارخواه.نوشتن }
    _ک := نخ‌ساز(کارساز، پ)
    ک := رله یو دی پی.کارخواه لوله ای(به کارخواه.خواندن، به کارساز.نوشتن)
    انباره := حافظه.تخصیص صفرشده(64 برگردان طبیعی۶۴)
    تکرار 100:
        اگر ک.آماده() برابر نادرست:
            _ن := ک.دریافت(انباره، 64، هیچ، 50)
        پایان
    پایان
    سرچاپ "ready"، ک.آماده()
    پرسیدن(ک، 40000، مقصد، "hello")
    پرسیدن(ک، 40001، مقصد، "second flow")
    ک.بستن()
    سرچاپ "closed"، ک.آماده() برابر نادرست
    بیکار := رله یو دی پی.کارخواه تازه(فرآیند.فرمان تازه("/nonexistent/salam-udprelay"))
    سرچاپ "send before ready"، بیکار.فرستادن(1، 1 برگردان صحیح۶۴، 1، انباره، 1)، بیکار.دورریخته ها()
    بیکار.بستن()
    آزاد := تی سی پی.پیوند روی("127.0.0.1"، 0)
    درگاه رله := تی سی پی.درگاه(آزاد)
    تی سی پی.بستن سرور(آزاد)
    مهار := ورودی خروجی توصیف‌گر.ساخت لوله()
    ش := حافظه.تخصیص صفرشده(اندازه(شنونده) برگردان طبیعی۶۴) برگردان شنونده*
    ش[0] = شنونده { مهار = مهار.خواندن، درگاه رله = درگاه رله }
    _گ := نخ‌ساز(گوش کردن، ش)
    همگام سازی.خواب میلی ثانیه(300)
    از راه سوکت(درگاه رله، مقصد، "wrong-token-wrong-token-wrong-to")
    از راه سوکت(درگاه رله، مقصد، "0123456789abcdef0123456789abcdef")
    ورودی خروجی توصیف‌گر.بستن(مهار.نوشتن)
پایان
