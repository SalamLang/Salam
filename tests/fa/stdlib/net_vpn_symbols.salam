واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس
واردسازی شبکه.وی مس

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا port := 0
ناپایا mode := 0
ناپایا seen := ""

تابع handler():
    ناپایا ss := انتقال شبکه.تنظیمات {}
    اگر mode برابر 1:
        ss.شبکه = "ws"
        ss.مسیر = "/raw"
    پایان
    l := انتقال شبکه.شنود(0، ss)
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    اگر mode برابر 1:
        ناپایا c := انتقال شبکه.پذیرش خام(l)
        اگر انتقال شبکه.ارتقا(c، ss):
            buf := حافظه.تخصیص(64 برگردان طبیعی۶۴)
            n := انتقال شبکه.خواندن(c، buf، 64)
            انتقال شبکه.نوشتن(c، buf، n)
            حافظه.آزادسازی(buf)
            انتقال شبکه.بستن(c)
        پایان
    وگرنه mode برابر 2:
        ناپایا t := انتقال شبکه.پذیرش(l)
        ناپایا r := وی لس.درخواست {}
        اگر وی لس.خواندن درخواست(t، r):
            seen = r.نشانی.میزبان + ":" + r.نشانی.درگاه
        پایان
        ناپایا v := وی لس.ویژن جدید(r.شناسه)
        buf := حافظه.تخصیص(64 برگردان طبیعی۶۴)
        n := وی لس.خواندن ویژن(t، v، buf، 64)
        وی لس.نوشتن ویژن(t، v، buf، n)
        حافظه.آزادسازی(buf)
        وی لس.آزادسازی ویژن(v)
        انتقال شبکه.بستن(t)
    وگرنه mode برابر 3:
        t := انتقال شبکه.پذیرش(l)
        ناپایا users := وکتور {} برگردان وکتور<وی مس.کاربر>
        users.بیفزا(وی مس.کاربر جدید(UUID1))
        ناپایا rf := وی مس.فیلتر بازپخش جدید()
        ناپایا c := وی مس.پذیرش(t، users، rf)
        buf := حافظه.تخصیص(64 برگردان طبیعی۶۴)
        n := وی مس.خواندن(c، buf، 64)
        وی مس.نوشتن(c، buf، n)
        وی مس.نوشتن(c، "packet" برگردان تهی*، 6)
        حافظه.آزادسازی(buf)
        وی مس.بستن(c)
    وگرنه:
        t := انتقال شبکه.پذیرش(l)
        s := انتقال شبکه.به عنوان جریان(t)
        m := انتقال شبکه.چندگانه ساز کارساز جدید(s)
        seen = "mux server " + انتقال شبکه.چندگانه ساز معتبر(m)
        همگام سازی.خواب میلی ثانیه(200)
        انتقال شبکه.بستن چندگانه ساز(m)
    پایان
    انتقال شبکه.بستن شنونده(l)
پایان

تابع start(m: صحیح):
    mode = m
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(handler)
    همگام سازی.انتظار(ready)
    برگشت
پایان

تابع bytes_checks():
    ناپایا b := انتقال شبکه.بایت‌های جدید(4)
    انتقال شبکه.رزرو(b، 100)
    انتقال شبکه.نوشتن شانزده بیت(b، 0x1234)
    انتقال شبکه.نوشتن سی‌ودو بیت(b، 0xdeadbeef برگردان صحیح۶۴)
    انتقال شبکه.نوشتن شصت‌وچهار بیت(b، 0x0102030405060708 برگردان طبیعی۶۴)
    انتقال شبکه.نوشتن صفرها(b، 3)
    سرچاپ "bytes:"، b.طول، b.ظرفیت بزرگتربرابر 100، انتقال شبکه.خواندن سی‌ودو بیت(b، 2) برابر (0xdeadbeef برگردان صحیح۶۴)، انتقال شبکه.به هگزا(b)
    انتقال شبکه.مصرف(b، 2)
    سرچاپ "consumed:"، b.طول، انتقال شبکه.بایت در(b، 0)
    انتقال شبکه.آزادسازی بایت‌ها(b)
    سرچاپ "kinds:"، انتقال شبکه.تشخیص نوع نشانی("1.2.3.4")، انتقال شبکه.تشخیص نوع نشانی("::1")، انتقال شبکه.تشخیص نوع نشانی("a.example.com")
    ناپایا a := انتقال شبکه.بایت‌های جدید(8)
    انتقال شبکه.نوشتن نشانی(a، انتقال شبکه.نشانی جدید("2001:db8::7"، 53))
    ناپایا back := انتقال شبکه.نشانی {}
    stop := انتقال شبکه.خواندن نشانی(a، 0، back)
    سرچاپ "addr roundtrip:"، stop برابر a.طول، back.میزبان، back.درگاه
    سرچاپ "ipv6 text:"، انتقال شبکه.قالب آی پی شش(انتقال شبکه.نشانگر بایت‌ها(a، 3) برگردان طبیعی۸*)
    انتقال شبکه.آزادسازی بایت‌ها(a)
پایان

تابع raw_ws():
    start(1)
    ناپایا cs := انتقال شبکه.تنظیمات {}
    cs.شبکه = "ws"
    cs.مسیر = "/raw"
    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، port، cs)
    انتقال شبکه.نوشتن(c، "hello" برگردان تهی*، 5)
    back := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    ok := انتقال شبکه.خواندن کامل(c، back، 5)
    انتقال شبکه.مهلت خواندن(c، 150)
    n := انتقال شبکه.خواندن(c، back، 16)
    سرچاپ "accept raw then upgrade:"، ok، "read timeout:"، n کوچکتربرابر 0
    انتقال شبکه.بستن(c)
    حافظه.آزادسازی(back)
پایان

تابع vless_checks():
    start(2)
    tc := انتقال شبکه.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {})
    c := وی لس.کارخواه(tc، UUID1، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("example.com"، 443))
    ناپایا v := وی لس.ویژن جدید(c.درخواست.شناسه)
    ناپایا t := c.انتقال
    وی لس.نوشتن ویژن(t، v، "vision payload" برگردان تهی*، 14)
    back := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    n := وی لس.خواندن ویژن(t، v، back، 32)
    سرچاپ "read request and vision:"، seen، n
    حافظه.آزادسازی(back)
    وی لس.آزادسازی ویژن(v)
    انتقال شبکه.بستن(t)
پایان

تابع vmess_checks():
    start(3)
    l := وی مس.تجزیه پیوند("vmess://" + "eyJhZGQiOiIxMjcuMC4wLjEiLCJwb3J0Ijo5LCJpZCI6ImI4MzEzODFkLTYzMjQtNGQ1My1hZDRmLThjZGE0OGIzMDgxMSIsIm5ldCI6InRjcCJ9")
    ناپایا l2 := l
    l2.درگاه = port
    ناپایا c := وی مس.شماره گیری پیوند(l2، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("example.com"، 80))
    وی مس.نوشتن(c، "dial link" برگردان تهی*، 9)
    back := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    ناپایا got := 0
    تا got کوچکتر 9:
        r := وی مس.خواندن(c، ((back برگردان صحیح۶۴) + (got برگردان صحیح۶۴)) برگردان تهی*، 9 - got)
        اگر r کوچکتربرابر 0:
            بشکن
        پایان
        got += r
    پایان
    ناپایا pk := انتقال شبکه.بایت‌های جدید(16)
    ok := وی مس.خواندن بسته(c، pk)
    سرچاپ "dial link echo:"، got، "packet:"، ok، pk.طول
    انتقال شبکه.آزادسازی بایت‌ها(pk)
    حافظه.آزادسازی(back)
    وی مس.بستن(c)
    empty := انتقال شبکه.بایت‌ها {}
    key := انتقال شبکه.از هگزا("000102030405060708090a0b0c0d0e0f")
    iv := انتقال شبکه.از هگزا("101112131415161718191a1b1c1d1e1f")
    k16 := وی مس.تابع اشتقاق کلید۱۶(key، "label"، empty، empty)
    k12 := وی مس.تابع اشتقاق کلید۱۲(key، "label"، empty، empty)
    سرچاپ "kdf lengths:"، k16.طول، k12.طول
    h := انتقال شبکه.از رشته("abcd")
    sealed := وی مس.مهر سرآیند پاسخ(key، iv، h)
    ناپایا lenpart := انتقال شبکه.بایت‌های جدید(18)
    انتقال شبکه.نوشتن خام(lenpart، sealed.نشانگر، 18)
    ناپایا bodypart := انتقال شبکه.بایت‌های جدید(sealed.طول)
    انتقال شبکه.نوشتن خام(bodypart، انتقال شبکه.نشانگر بایت‌ها(sealed، 18)، sealed.طول - 18)
    n := وی مس.گشودن طول پاسخ(key، iv، lenpart)
    opened := وی مس.گشودن سرآیند پاسخ(key، iv، bodypart)
    سرچاپ "response header:"، n، انتقال شبکه.برابر(opened، h)
    سرچاپ "sha256:"، انتقال شبکه.به هگزا(وی مس.شا۲۵۶(انتقال شبکه.از رشته("abc")))
    ck := وی مس.کلید فرمان(انتقال شبکه.تجزیه یو یو آی دی(UUID1))
    sh := وی مس.مهر سرآیند اکنون(ck، h)
    سرچاپ "sealed header now:"، sh.طول بزرگتر 40
پایان

تابع mux_checks():
    start(4)
    tc := انتقال شبکه.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {})
    s := انتقال شبکه.به عنوان جریان(tc)
    wrapped := انتقال شبکه.از جریان(s، درست)
    m := انتقال شبکه.چندگانه ساز کارخواه جدید(انتقال شبکه.به عنوان جریان(wrapped))
    سرچاپ "mux client:"، انتقال شبکه.چندگانه ساز معتبر(m)، wrapped.باز
    همگام سازی.خواب میلی ثانیه(300)
    انتقال شبکه.بستن چندگانه ساز(m)
    سرچاپ "mux server:"، seen
پایان

تابع ریشه:
    bytes_checks()
    raw_ws()
    vless_checks()
    vmess_checks()
    mux_checks()
پایان
