بسته ریشه

واردسازی شبکه.وب‌سوکت
واردسازی شبکه.تی سی پی
واردسازی آزمایش

ناپایا خادم هاب := وب‌سوکت.سرور {}
ناپایا خادم ساده := تی سی پی.سرور {}

تابع سمت هاب():
    ناپایا هاب := وب‌سوکت.هاب جدید()
    ناپایا a := وب‌سوکت.پذیرش(خادم هاب)
    ناپایا b := وب‌سوکت.پذیرش(خادم هاب)
    وب‌سوکت.ثبت(هاب، "room"، a)
    وب‌سوکت.ثبت(هاب، "room"، b)
    آزمایش.ادعای برابری عدد(وب‌سوکت.پخش دودویی(هاب، "room"، "bin\nary")، 2)
    آزمایش.ادعای برابری عدد(وب‌سوکت.پخش دودویی(هاب، "empty"، "x")، 0)
    آزمایش.ادعای برابری عدد(وب‌سوکت.ارسال دودویی(a، "solo")، 0)
    وب‌سوکت.بستن(a)
    وب‌سوکت.بستن(b)
پایان

تابع سمت ساده():
    c := تی سی پی.پذیرش(خادم ساده)
    تی سی پی.بستن(c)
پایان

تابع بررسی دودویی هاب():
    خادم هاب = وب‌سوکت.شنود(0)
    t := نخ‌ساز(سمت هاب)
    درگاه := وب‌سوکت.درگاه(خادم هاب)
    ناپایا x := وب‌سوکت.شماره گیری("127.0.0.1"، درگاه، "/")
    ناپایا y := وب‌سوکت.شماره گیری("127.0.0.1"، درگاه، "/")
    آزمایش.ادعای درستی(وب‌سوکت.باز است(x))
    آزمایش.ادعای درستی(وب‌سوکت.باز است(y))
    پیام اول := وب‌سوکت.دریافت با مهلت(x، 3000)
    آزمایش.ادعای درستی(وب‌سوکت.دودویی است(پیام اول))
    آزمایش.ادعای برابری عدد(پیام اول.طول، 7)
    پیام دوم := وب‌سوکت.دریافت با مهلت(y، 3000)
    آزمایش.ادعای درستی(وب‌سوکت.دودویی است(پیام دوم))
    آزمایش.ادعای نادرستی(وب‌سوکت.بسته است(پیام دوم))
    پیام تکی := وب‌سوکت.دریافت با مهلت(x، 3000)
    آزمایش.ادعای درستی(وب‌سوکت.دودویی است(پیام تکی))
    آزمایش.ادعای برابری عدد(پیام تکی.طول، 4)
    نخ‌پیوند(t)
    وب‌سوکت.بستن(x)
    وب‌سوکت.بستن(y)
    وب‌سوکت.بستن سرور(خادم هاب)
پایان

تابع بررسی متن دست دادن():
    درخواست ساده := وب‌سوکت.درخواست دست دادن با سربرگ("example.com"، "/chat"، "dGhlIHNhbXBsZSBub25jZQ=="، "")
    آزمایش.ادعای شامل بودن(درخواست ساده، "GET /chat HTTP/1.1\r\n")
    آزمایش.ادعای شامل بودن(درخواست ساده، "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n")
    آزمایش.ادعای درستی(درخواست ساده.طول() بزرگتر 0)
    درخواست اضافه := وب‌سوکت.درخواست دست دادن با سربرگ("example.com"، "/chat"، "k"، "X-Token: t1")
    آزمایش.ادعای شامل بودن(درخواست اضافه، "X-Token: t1\r\n\r\n")
    درخواست آماده := وب‌سوکت.درخواست دست دادن با سربرگ("example.com"، "/chat"، "k"، "X-Token: t1\r\n")
    آزمایش.ادعای برابری رشته(درخواست آماده، درخواست اضافه)
پایان

تابع بررسی شکست شماره گیری امن():
    ناپایا رد شده := وب‌سوکت.شماره گیری امن("127.0.0.1"، 1، "/")
    آزمایش.ادعای نادرستی(وب‌سوکت.باز است(رد شده))
    ناپایا رد شده با سربرگ := وب‌سوکت.شماره گیری امن با سربرگ("127.0.0.1"، 1، "/"، "X-Token: t1")
    آزمایش.ادعای نادرستی(وب‌سوکت.باز است(رد شده با سربرگ))

    خادم ساده = تی سی پی.پیوند(0)
    t := نخ‌ساز(سمت ساده)
    ناپایا بدون تی ال اس := وب‌سوکت.شماره گیری امن("127.0.0.1"، تی سی پی.درگاه(خادم ساده)، "/")
    آزمایش.ادعای نادرستی(وب‌سوکت.باز است(بدون تی ال اس))
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(خادم ساده)
پایان

تابع ریشه:
    بررسی دودویی هاب()
    بررسی متن دست دادن()
    بررسی شکست شماره گیری امن()
    برگشت آزمایش.خلاصه()
پایان
