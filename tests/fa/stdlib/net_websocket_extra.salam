بسته ریشه

واردسازی شبکه.وب‌سوکت
واردسازی شبکه.تی سی پی
واردسازی آزمایش

ناپایا hub server := وب‌سوکت.سرور {}
ناپایا plain server := تی سی پی.سرور {}

تابع hub side():
    ناپایا hub := وب‌سوکت.هاب جدید()
    a := وب‌سوکت.پذیرش(hub server)
    b := وب‌سوکت.پذیرش(hub server)
    وب‌سوکت.ثبت(hub، "room"، a)
    وب‌سوکت.ثبت(hub، "room"، b)
    آزمایش.ادعای برابری عدد(وب‌سوکت.پخش دودویی(hub، "room"، "bin\nary")، 2)
    آزمایش.ادعای برابری عدد(وب‌سوکت.پخش دودویی(hub، "empty"، "x")، 0)
    آزمایش.ادعای برابری عدد(وب‌سوکت.ارسال دودویی(a، "solo")، 0)
    وب‌سوکت.بستن(a)
    وب‌سوکت.بستن(b)
پایان

تابع plain side():
    c := تی سی پی.پذیرش(plain server)
    تی سی پی.بستن(c)
پایان

تابع check hub binary():
    hub server = وب‌سوکت.شنود(0)
    t := نخ‌ساز(hub side)
    port := وب‌سوکت.درگاه(hub server)
    ناپایا x := وب‌سوکت.شماره گیری("127.0.0.1"، port، "/")
    ناپایا y := وب‌سوکت.شماره گیری("127.0.0.1"، port، "/")
    آزمایش.ادعای درستی(وب‌سوکت.باز است(x))
    آزمایش.ادعای درستی(وب‌سوکت.باز است(y))
    mx := وب‌سوکت.دریافت با مهلت(x، 3000)
    آزمایش.ادعای درستی(وب‌سوکت.دودویی است(mx))
    آزمایش.ادعای برابری عدد(mx.طول، 7)
    my := وب‌سوکت.دریافت با مهلت(y، 3000)
    آزمایش.ادعای درستی(وب‌سوکت.دودویی است(my))
    آزمایش.ادعای نادرستی(وب‌سوکت.بسته است(my))
    solo := وب‌سوکت.دریافت با مهلت(x، 3000)
    آزمایش.ادعای درستی(وب‌سوکت.دودویی است(solo))
    آزمایش.ادعای برابری عدد(solo.طول، 4)
    نخ‌پیوند(t)
    وب‌سوکت.بستن(x)
    وب‌سوکت.بستن(y)
    وب‌سوکت.بستن سرور(hub server)
پایان

تابع check handshake text():
    plain := وب‌سوکت.درخواست دست دادن با سربرگ("example.com"، "/chat"، "dGhlIHNhbXBsZSBub25jZQ=="، "")
    آزمایش.ادعای شامل بودن(plain، "GET /chat HTTP/1.1\r\n")
    آزمایش.ادعای شامل بودن(plain، "Sec-WebSocket-Key: dGhlIHNhbXBsZSBub25jZQ==\r\n")
    آزمایش.ادعای درستی(plain.طول() بزرگتر 0)
    extra := وب‌سوکت.درخواست دست دادن با سربرگ("example.com"، "/chat"، "k"، "X-Token: t1")
    آزمایش.ادعای شامل بودن(extra، "X-Token: t1\r\n\r\n")
    ready := وب‌سوکت.درخواست دست دادن با سربرگ("example.com"، "/chat"، "k"، "X-Token: t1\r\n")
    آزمایش.ادعای برابری رشته(ready، extra)
پایان

تابع check secure dial failures():
    refused := وب‌سوکت.شماره گیری امن("127.0.0.1"، 1، "/")
    آزمایش.ادعای نادرستی(وب‌سوکت.باز است(refused))
    refused_extra := وب‌سوکت.شماره گیری امن با سربرگ("127.0.0.1"، 1، "/"، "X-Token: t1")
    آزمایش.ادعای نادرستی(وب‌سوکت.باز است(refused_extra))

    plain server = تی سی پی.پیوند(0)
    t := نخ‌ساز(plain side)
    notls := وب‌سوکت.شماره گیری امن("127.0.0.1"، تی سی پی.درگاه(plain server)، "/")
    آزمایش.ادعای نادرستی(وب‌سوکت.باز است(notls))
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(plain server)
پایان

تابع ریشه:
    check hub binary()
    check handshake text()
    check secure dial failures()
    برگشت آزمایش.خلاصه()
پایان
