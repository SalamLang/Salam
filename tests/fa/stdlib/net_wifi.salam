بسته ریشه

واردسازی حافظه
واردسازی شبکه.وای‌فای

تابع سیک(س: وای‌فای.امنیت شبکه): رشته:
    برگشت وای‌فای.نام امنیت(س)
پایان

تابع نمایش(لابیل: رشته، س: وای‌فای.وضعیت):
    سرچاپ لابیل،
        وای‌فای.نام وضعیت(س.حالت)،
        س.رابط،
        س.نام شبکه،
        س.نام شبکه معلوم،
        س.نشانی نقطه دسترسی،
        سیک(س.امنیت)،
        س.قدرت سیگنال،
        س.پشتوانه
پایان

تابع پوت32(پ: تهی*، جا: صحیح، مقدار: صحیح):
    ((پ برگردان صحیح۶۴ + جا برگردان صحیح۶۴) برگردان طبیعی۳۲*)[0] = مقدار برگردان طبیعی۳۲
پایان

تابع پوت8(پ: تهی*، جا: صحیح، مقدار: صحیح):
    ((پ برگردان صحیح۶۴ + جا برگردان صحیح۶۴) برگردان طبیعی۸*)[0] = مقدار برگردان طبیعی۸
پایان

تابع ریشه:
    سرچاپ "nm open"، سیک(وای‌فای.امنیت از نتورک منیجر(0، 0، 0))
    سرچاپ "nm wep"، سیک(وای‌فای.امنیت از نتورک منیجر(1، 0، 0))
    سرچاپ "nm wpa"، سیک(وای‌فای.امنیت از نتورک منیجر(1، 0x144، 0))
    سرچاپ "nm wpa2"، سیک(وای‌فای.امنیت از نتورک منیجر(1، 0، 0x188))
    سرچاپ "nm wpa3"، سیک(وای‌فای.امنیت از نتورک منیجر(1، 0، 0x488))
    سرچاپ "nm wpa2/3 mixed"، سیک(وای‌فای.امنیت از نتورک منیجر(1، 0، 0x588))
    سرچاپ "nm enterprise"، سیک(وای‌فای.امنیت از نتورک منیجر(1، 0، 0x288))
    سرچاپ "nm suite-b"، سیک(وای‌فای.امنیت از نتورک منیجر(1، 0، 0x2000))
    سرچاپ "nm owe"، سیک(وای‌فای.امنیت از نتورک منیجر(1، 0، 0x888))
    سرچاپ "nm odd"، سیک(وای‌فای.امنیت از نتورک منیجر(1، 0، 0x8))

    سرچاپ "win open"، سیک(وای‌فای.امنیت از ویندوز(1، 0، نادرست))
    سرچاپ "win wep"، سیک(وای‌فای.امنیت از ویندوز(1، 0x101، نادرست))
    سرچاپ "win wpa"، سیک(وای‌فای.امنیت از ویندوز(4، 2، نادرست))
    سرچاپ "win wpa2"، سیک(وای‌فای.امنیت از ویندوز(7، 4، نادرست))
    سرچاپ "win wpa3"، سیک(وای‌فای.امنیت از ویندوز(9، 4، نادرست))
    سرچاپ "win owe"، سیک(وای‌فای.امنیت از ویندوز(10، 4، نادرست))
    سرچاپ "win ent"، سیک(وای‌فای.امنیت از ویندوز(6، 4، نادرست))
    سرچاپ "win onex"، سیک(وای‌فای.امنیت از ویندوز(7، 4، درست))
    سرچاپ "win ihv"، سیک(وای‌فای.امنیت از ویندوز(200، 4، نادرست))

    تکرار 17 در کودی:
        چاپ سیک(وای‌فای.امنیت از مک(کودی))، ""
    پایان
    سرچاپ ""

    سرچاپ "dbm"،
        وای‌فای.سیگنال از دسی بل(-30)،
        وای‌فای.سیگنال از دسی بل(-52)،
        وای‌فای.سیگنال از دسی بل(-100)،
        وای‌فای.سیگنال از دسی بل(-120)،
        وای‌فای.سیگنال از دسی بل(0)
    سرچاپ "ssid"،
        وای‌فای.رمزگشایی نام شبکه("Sal\\xc3\\xa1m \\x41")،
        وای‌فای.رمزگشایی نام شبکه("plain\\x4")،
        وای‌فای.رمزگشایی نام شبکه("")

    دیو := "phy#0\n\tInterface wlp2s0\n\t\tifindex 3\n\t\taddr 3c:22:fb:00:00:01\n\t\tssid Home\n\t\ttype managed\nphy#1\n\tInterface wlan1\n\t\ttype managed\n"
    نامیس := وای‌فای.تجزیه فهرست آی دبلیو(دیو)
    سرچاپ "iw dev"، نامیس.طول()، نامیس[0]، نامیس[1]
    نامیس.آزاد()

    لینک := "Connected to AA:BB:CC:00:11:22 (on wlp2s0)\n\tSSID: Sal\\xc3\\xa1m Net\n\tfreq: 5180\n\tRX: 1234 bytes (10 packets)\n\tsignal: -61 dBm\n\ttx bitrate: 866.7 MBit/s\n"
    وپ := وای‌فای.تجزیه پیوند آی دبلیو(لینک، "wlp2s0")
    نمایش("iw link"، وپ)
    نمایش("iw down"، وای‌فای.تجزیه پیوند آی دبلیو("Not connected.\n"، "wlan1"))
    نول لینک := وای‌فای.تجزیه پیوند آی دبلیو(
        "Connected to aa:bb:cc:00:11:22 (on wlan0)\n\tSSID: Home\\x00-Guest\n"، "wlan0"
    )
    نمایش("iw nul"، نول لینک)
    سرچاپ "iw nul reason"، نول لینک.دلیل
    وای‌فای.آزادسازی وضعیت(نول لینک)
    پنهان لینک := وای‌فای.تجزیه پیوند آی دبلیو(
        "Connected to aa:bb:cc:00:11:22 (on wlan0)\n\tSSID: \n"، "wlan0"
    )
    نمایش("iw hidden"، پنهان لینک)
    سرچاپ "iw hidden reason"، پنهان لینک.دلیل
    وای‌فای.آزادسازی وضعیت(پنهان لینک)
    سرچاپ "ssid nul"، وای‌فای.رمزگشایی نام شبکه("Home\\x00-Guest").طول()

    سکان := "BSS 11:11:11:11:11:11(on wlp2s0)\n\tcapability: ESS (0x0001)\n\tSSID: Free\nBSS aa:bb:cc:00:11:22(on wlp2s0) -- associated\n\tcapability: ESS Privacy ShortSlotTime (0x0411)\n\tSSID: Sal\\xc3\\xa1m Net\n\tRSN:\t * Version: 1\n\t\t * Group cipher: CCMP\n\t\t * Pairwise ciphers: CCMP\n\t\t * Authentication suites: PSK SAE\n\t\t * Capabilities: 16-PTKSA-RC 1-GTKSA-RC (0x000c)\nBSS 22:22:22:22:22:22(on wlp2s0)\n\tcapability: ESS Privacy (0x0011)\n\tWPA:\t * Version: 1\n\t\t * Authentication suites: PSK\n"
    سرچاپ "scan assoc"، سیک(وای‌فای.تجزیه پویش آی دبلیو(سکان، "AA:BB:CC:00:11:22"))
    سرچاپ "scan open"، سیک(وای‌فای.تجزیه پویش آی دبلیو(سکان، "11:11:11:11:11:11"))
    سرچاپ "scan wpa"، سیک(وای‌فای.تجزیه پویش آی دبلیو(سکان، "22:22:22:22:22:22"))
    سرچاپ "scan missing"، سیک(وای‌فای.تجزیه پویش آی دبلیو(سکان، "33:33:33:33:33:33"))
    ویپ := "BSS 44:44:44:44:44:44(on wlan0)\n\tcapability: ESS Privacy (0x0011)\n"
    سرچاپ "scan wep"، سیک(وای‌فای.تجزیه پویش آی دبلیو(ویپ، "44:44:44:44:44:44"))
    ینت := "BSS 55:55:55:55:55:55(on wlan0)\n\tRSN:\t * Version: 1\n\t\t * Authentication suites: IEEE 802.1X\n"
    سرچاپ "scan ent"، سیک(وای‌فای.تجزیه پویش آی دبلیو(ینت، "55:55:55:55:55:55"))

    بوف := حافظه.تخصیص صفرشده(604 برگردان طبیعی۶۴)
    پوت32(بوف، 0، 1)
    پوت32(بوف، 520، 4)
    پوت8(بوف، 524، 72)
    پوت8(بوف، 525، 111)
    پوت8(بوف، 526، 109)
    پوت8(بوف، 527، 101)
    تکرار 6 در ی:
        پوت8(بوف، 560 + ی، 0xa0 + ی)
    پایان
    پوت32(بوف، 576، 77)
    پوت32(بوف، 588، 1)
    پوت32(بوف، 596، 7)
    پوت32(بوف، 600، 4)
    نمایش("wlan"، وای‌فای.تجزیه اتصال ویندوز(بوف، 604))
    پوت32(بوف، 520، 0)
    پنهان := وای‌فای.تجزیه اتصال ویندوز(بوف، 604)
    نمایش("wlan no ssid"، پنهان)
    سرچاپ "wlan reason"، پنهان.دلیل
    نمایش("wlan short"، وای‌فای.تجزیه اتصال ویندوز(بوف، 100))
    پوت32(بوف، 520، 6)
    پوت8(بوف، 524، 72)
    پوت8(بوف، 525، 111)
    پوت8(بوف، 526، 0)
    پوت8(بوف، 527، 101)
    پوت8(بوف، 528، 45)
    پوت8(بوف، 529، 71)
    نول ولان := وای‌فای.تجزیه اتصال ویندوز(بوف، 604)
    نمایش("wlan nul"، نول ولان)
    سرچاپ "wlan nul reason"، نول ولان.دلیل
    وای‌فای.آزادسازی وضعیت(نول ولان)
    حافظه.آزادسازی(بوف)

    ناپایا تروستید := وکتور {} برگردان وکتور<رشته>
    تروستید.افزودن("Home")
    تروستید.افزودن("de:ad:be:ef:00:01")
    هومی := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "Home"،
        نام شبکه معلوم = درست،
        امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو
    }
    کافی := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "Cafe"،
        نام شبکه معلوم = درست،
        امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو
    }
    هومی لوویر := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "home"،
        نام شبکه معلوم = درست،
        امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو
    }
    بلیند := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل، امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو
    }
    بلیند بازکردن := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل، امنیت = وای‌فای.امنیت شبکه.باز
    }
    بلیند کنوون اپ := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نشانی نقطه دسترسی = "DE:AD:BE:EF:00:01"،
        امنیت = وای‌فای.امنیت شبکه.باز
    }
    ویرید := وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.قطع }
    نونی := وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.بدون وای فای }
    ونکنوون := وای‌فای.وضعیت {}
    سرچاپ "trust home"،
        وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(هومی، تروستید))،
        وای‌فای.نامطمئن است(هومی، تروستید)
    سرچاپ "trust cafe"،
        وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(کافی، تروستید))،
        وای‌فای.نامطمئن است(کافی، تروستید)
    سرچاپ "trust case"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(هومی لوویر، تروستید))
    سرچاپ "trust blind"،
        وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(بلیند، تروستید))،
        وای‌فای.نامطمئن است(بلیند، تروستید)
    سرچاپ "trust blind open"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(بلیند بازکردن، تروستید))
    سرچاپ "trust blind known ap"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(بلیند کنوون اپ، تروستید))
    سرچاپ "trust wired"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(ویرید، تروستید))
    سرچاپ "trust none"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(نونی، تروستید))
    سرچاپ "trust unknown"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(ونکنوون، تروستید))
    سسید لیکی ماک := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "de:ad:be:ef:00:01"،
        نام شبکه معلوم = درست،
        نشانی نقطه دسترسی = "11:22:33:44:55:66"،
        امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو
    }
    هومی وتهیر اپ := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "Home"،
        نام شبکه معلوم = درست،
        نشانی نقطه دسترسی = "11:22:33:44:55:66"،
        امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو
    }
    بسسید نامید هومی := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "Cafe"،
        نام شبکه معلوم = درست،
        نشانی نقطه دسترسی = "Home"،
        امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو
    }
    هومی بازکردن := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "Home"،
        نام شبکه معلوم = درست،
        امنیت = وای‌فای.امنیت شبکه.باز
    }
    کافی بازکردن := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "Cafe"،
        نام شبکه معلوم = درست،
        امنیت = وای‌فای.امنیت شبکه.باز
    }
    سرچاپ "trust ssid shaped like mac"،
        وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(سسید لیکی ماک، تروستید))
    سرچاپ "trust name on other ap"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(هومی وتهیر اپ، تروستید))
    سرچاپ "trust bssid text not mac"،
        وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(بسسید نامید هومی، تروستید))
    سرچاپ "trust open but listed"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(هومی بازکردن، تروستید))
    سرچاپ "trust open unlisted"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(کافی بازکردن، تروستید))
    تروستید.آزاد()

    سرچاپ "insecure"، بلیند بازکردن.ناامن است()، بلیند.ناامن است()، هومی.وصل است()، ویرید.وصل است()
    سرچاپ "changed"،
        وای‌فای.تغییر کرده(هومی، هومی)،
        وای‌فای.تغییر کرده(هومی، کافی)،
        وای‌فای.تغییر کرده(هومی، وای‌فای.وضعیت {
            حالت = وای‌فای.وضعیت اتصال.وصل،
            نام شبکه = "Home"،
            نام شبکه معلوم = درست،
            امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو،
            قدرت سیگنال = 10
        })

    کور := وای‌فای.وضعیت کنونی()
    سرچاپ "supported"، وای‌فای.پشتیبانی می شود()
    سرچاپ "current is a state"، وای‌فای.نام وضعیت(کور.حالت).طول() بزرگتر 0
    وای‌فای.آزادسازی وضعیت(کور)
    ناپایا گزینه ها := وکتور {} برگردان وکتور<وای‌فای.وضعیت>
    سرچاپ "best of none"، وای‌فای.شماره بهترین رابط(
        گزینه ها
    )
    گزینه ها.افزودن(وای‌فای.وضعیت {})
    گزینه ها.افزودن(وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.قطع })
    سرچاپ "best unknown or disconnected"، وای‌فای.شماره بهترین رابط(گزینه ها)
    گزینه ها.افزودن(
        وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.وصل، نام شبکه = "Home"، نام شبکه معلوم = درست }
    )
    گزینه ها.افزودن(
        وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.وصل، نام شبکه = "Cafe"، نام شبکه معلوم = درست }
    )
    سرچاپ "best connected"،
        وای‌فای.شماره بهترین رابط(گزینه ها)،
        گزینه ها[وای‌فای.شماره بهترین رابط(گزینه ها)].نام شبکه
    گزینه ها.آزاد()
    همه := وای‌فای.رابط ها()
    سرچاپ "interfaces are listed"، همه.طول() بزرگتربرابر 0
    وای‌فای.آزادسازی وضعیت ها(همه)
پایان
