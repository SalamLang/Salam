بسته ریشه

واردسازی ریاضی
واردسازی هوش مصنوعی.شبکه عصبی
واردسازی هوش مصنوعی.تانسور

تابع گرد(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 100.0) / 100.0
پایان

تابع پراکندگی(t &: تانسور.تانسور): اعشار۶۴:
    میانگین := تانسور.میانگین همه(t)
    ناپایا مربع := تانسور.مربع(t)
    v := تانسور.میانگین همه(مربع) - میانگین * میانگین
    تانسور.آزادسازی(مربع)
    برگشت ریاضی.جذر(v)
پایان

تابع ریشه:
    ناپایا g := تانسور.مولد تصادفی جدید(7)
    حد := ریاضی.جذر(6.0 / 32.0)

    ناپایا یکنواخت ژاویر := تانسور.صفرها دو(64، 64)
    شبکه عصبی.ژاویر یکنواخت(یکنواخت ژاویر، 16، 16، g)
    سرچاپ "xavier uniform bounded: "، تانسور.بیشینه همه(یکنواخت ژاویر) کوچکتربرابر حد و تانسور.کمینه همه(یکنواخت ژاویر) بزرگتربرابر 0.0 - حد
    سرچاپ "xavier uniform spread: "، تانسور.بیشینه همه(یکنواخت ژاویر) - تانسور.کمینه همه(یکنواخت ژاویر) بزرگتر حد
    سرچاپ "xavier uniform centered: "، ریاضی.قدرمطلق(تانسور.میانگین همه(یکنواخت ژاویر)) کوچکتر 0.05

    ناپایا نرمال ژاویر := تانسور.صفرها دو(64، 64)
    شبکه عصبی.ژاویر نرمال(نرمال ژاویر، 16، 16، g)
    سرچاپ "xavier normal std: "، گرد(پراکندگی(نرمال ژاویر))، گرد(ریاضی.جذر(2.0 / 32.0))
    سرچاپ "xavier normal centered: "، ریاضی.قدرمطلق(تانسور.میانگین همه(نرمال ژاویر)) کوچکتر 0.05

    حد کایمینگ := ریاضی.جذر(6.0 / 16.0)
    ناپایا یکنواخت کایمینگ := تانسور.صفرها دو(64، 64)
    شبکه عصبی.کایمینگ یکنواخت(یکنواخت کایمینگ، 16، g)
    سرچاپ "kaiming uniform bounded: "، تانسور.بیشینه همه(یکنواخت کایمینگ) کوچکتربرابر حد کایمینگ و تانسور.کمینه همه(یکنواخت کایمینگ) بزرگتربرابر 0.0 - حد کایمینگ
    سرچاپ "kaiming uniform spread: "، تانسور.بیشینه همه(یکنواخت کایمینگ) - تانسور.کمینه همه(یکنواخت کایمینگ) بزرگتر حد کایمینگ
    سرچاپ "kaiming uniform centered: "، ریاضی.قدرمطلق(تانسور.میانگین همه(یکنواخت کایمینگ)) کوچکتر 0.05

    ناپایا نرمال کایمینگ := تانسور.صفرها دو(64، 64)
    شبکه عصبی.کایمینگ نرمال(نرمال کایمینگ، 16، g)
    سرچاپ "kaiming normal std: "، گرد(پراکندگی(نرمال کایمینگ))، گرد(ریاضی.جذر(2.0 / 16.0))
    سرچاپ "kaiming normal centered: "، ریاضی.قدرمطلق(تانسور.میانگین همه(نرمال کایمینگ)) کوچکتر 0.05

    ناپایا مولد دوباره := تانسور.مولد تصادفی جدید(7)
    ناپایا یکنواخت ژاویر دوم := تانسور.صفرها دو(64، 64)
    شبکه عصبی.ژاویر یکنواخت(یکنواخت ژاویر دوم، 16، 16، مولد دوباره)
    سرچاپ "same seed same values: "، تانسور.مجموع همه(یکنواخت ژاویر) برابر تانسور.مجموع همه(یکنواخت ژاویر دوم)

    تانسور.آزادسازی(یکنواخت ژاویر دوم)
    تانسور.آزادسازی(نرمال کایمینگ)
    تانسور.آزادسازی(یکنواخت کایمینگ)
    تانسور.آزادسازی(نرمال ژاویر)
    تانسور.آزادسازی(یکنواخت ژاویر)
پایان
