بسته ریشه

واردسازی ریاضی
واردسازی شبکه عصبی
واردسازی تانسور

تابع rnd(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 100.0) / 100.0
پایان

تابع spread(t: تانسور.تانسور): اعشار۶۴:
    mean := تانسور.میانگین همه(t)
    ناپایا sq := تانسور.مربع(t)
    v := تانسور.میانگین همه(sq) - mean * mean
    تانسور.آزادسازی(sq)
    برگشت ریاضی.جذر(v)
پایان

تابع ریشه:
    ناپایا g := تانسور.مولد تصادفی جدید(7)
    limit := ریاضی.جذر(6.0 / 32.0)

    ناپایا xu := تانسور.صفرها دو(64، 64)
    شبکه عصبی.ژاویر یکنواخت(xu، 16، 16، g)
    سرچاپ "xavier uniform bounded: "، تانسور.بیشینه همه(xu) کوچکتربرابر limit و تانسور.کمینه همه(xu) بزرگتربرابر 0.0 - limit
    سرچاپ "xavier uniform spread: "، تانسور.بیشینه همه(xu) - تانسور.کمینه همه(xu) بزرگتر limit
    سرچاپ "xavier uniform centered: "، ریاضی.قدرمطلق(تانسور.میانگین همه(xu)) کوچکتر 0.05

    ناپایا xn := تانسور.صفرها دو(64، 64)
    شبکه عصبی.ژاویر نرمال(xn، 16، 16، g)
    سرچاپ "xavier normal std: "، rnd(spread(xn))، rnd(ریاضی.جذر(2.0 / 32.0))
    سرچاپ "xavier normal centered: "، ریاضی.قدرمطلق(تانسور.میانگین همه(xn)) کوچکتر 0.05

    kb := ریاضی.جذر(6.0 / 16.0)
    ناپایا ku := تانسور.صفرها دو(64، 64)
    شبکه عصبی.کایمینگ یکنواخت(ku، 16، g)
    سرچاپ "kaiming uniform bounded: "، تانسور.بیشینه همه(ku) کوچکتربرابر kb و تانسور.کمینه همه(ku) بزرگتربرابر 0.0 - kb
    سرچاپ "kaiming uniform spread: "، تانسور.بیشینه همه(ku) - تانسور.کمینه همه(ku) بزرگتر kb
    سرچاپ "kaiming uniform centered: "، ریاضی.قدرمطلق(تانسور.میانگین همه(ku)) کوچکتر 0.05

    ناپایا kn := تانسور.صفرها دو(64، 64)
    شبکه عصبی.کایمینگ نرمال(kn، 16، g)
    سرچاپ "kaiming normal std: "، rnd(spread(kn))، rnd(ریاضی.جذر(2.0 / 16.0))
    سرچاپ "kaiming normal centered: "، ریاضی.قدرمطلق(تانسور.میانگین همه(kn)) کوچکتر 0.05

    ناپایا again := تانسور.مولد تصادفی جدید(7)
    ناپایا xu2 := تانسور.صفرها دو(64، 64)
    شبکه عصبی.ژاویر یکنواخت(xu2، 16، 16، again)
    سرچاپ "same seed same values: "، تانسور.مجموع همه(xu) برابر تانسور.مجموع همه(xu2)

    تانسور.آزادسازی(xu2)
    تانسور.آزادسازی(kn)
    تانسور.آزادسازی(ku)
    تانسور.آزادسازی(xn)
    تانسور.آزادسازی(xu)
پایان
