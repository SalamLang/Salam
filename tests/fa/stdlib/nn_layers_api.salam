// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی مشتق‌گیری خودکار
واردسازی ریاضی
واردسازی شبکه عصبی
واردسازی تانسور

تابع گرد(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 1000.0) / 1000.0
پایان

تابع ریشه:
    ناپایا پارامترها := شبکه عصبی.مخزن پارامتر {}
    ناپایا g := تانسور.مولد تصادفی جدید(11)

    لایه کامل := شبکه عصبی.لایه خطی جدید(پارامترها، "full"، 3، 2، g)
    سرچاپ "linear params: "، پارامترها.شمار()، لایه کامل.سوگیری دارد
    لایه ساده := شبکه عصبی.لایه خطی بی‌بایاس(پارامترها، "plain"، 3، 2، g)
    سرچاپ "no bias params: "، پارامترها.شمار()، لایه ساده.سوگیری دارد
    سرچاپ "no bias sizes: "، لایه ساده.اندازه‌ورودی، لایه ساده.اندازه خروجی
    سرچاپ "no bias weight: "، پارامترها.عنصر(لایه ساده.شماره وزن).نام
    سرچاپ "no bias slot: "، لایه ساده.شماره سوگیری

    ناپایا x := تانسور.صفرها دو(2، 3)
    x.تنظیم در دو(0، 0، 1.0)
    x.تنظیم در دو(0، 1، 2.0)
    x.تنظیم در دو(0، 2، 3.0)
    x.تنظیم در دو(1، 0، 0.0 - 1.0)
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(1)
    y := مشتق‌گیری خودکار.مقدار(نوار، لایه ساده.پیشرو(نوار، پارامترها، مشتق‌گیری خودکار.ورودی(نوار، x)))
    ناپایا وزن ساده := پارامترها.عنصر(لایه ساده.شماره وزن).مقدار
    ناپایا مورد انتظار := تانسور.ضرب ماتریسی(x، وزن ساده)
    ناپایا بدترین := 0.0
    تکرار 2 در r:
        تکرار 2 در c:
            d := ریاضی.قدرمطلق(y.در دو(r، c) - مورد انتظار.در دو(r، c))
            اگر d بزرگتر بدترین: بدترین = d پایان
        پایان
    پایان
    سرچاپ "output shape: "، y.شکل.بگیر(0)، y.شکل.بگیر(1)
    سرچاپ "matches matmul: "، بدترین کوچکتر 0.000001
    سرچاپ "second row linear: "، گرد(y.در دو(1، 0))، گرد(0.0 - پارامترها.عنصر(لایه ساده.شماره وزن).مقدار.در دو(0، 0))

    نرمال گروهی := شبکه عصبی.نرمال‌سازی گروهی جدید(پارامترها، "gn"، 4، 2)
    سرچاپ "group norm params: "، پارامترها.شمار()، نرمال گروهی.گروه‌ها
    سرچاپ "gamma name: "، پارامترها.عنصر(نرمال گروهی.شماره گاما).نام
    سرچاپ "beta name: "، پارامترها.عنصر(نرمال گروهی.شماره بتا).نام
    ناپایا تصویر := تانسور.صفرها چهار(1، 4، 1، 3)
    تکرار 4 در کانال:
        تکرار 3 در k:
            تصویر.درایه‌ها.داده[کانال * 3 + k] = ((کانال + 1) * (k + 1)) برگردان اعشار۳۲
        پایان
    پایان
    ناپایا نوار دوم := مشتق‌گیری خودکار.نوار جدید(1)
    z := مشتق‌گیری خودکار.مقدار(نوار دوم، نرمال گروهی.پیشرو(نوار دوم، پارامترها، مشتق‌گیری خودکار.ورودی(نوار دوم، تصویر)))
    ناپایا جمع صفر := 0.0
    ناپایا جمع یک := 0.0
    تکرار 6 در k:
        جمع صفر += z.درایه‌ها.داده[k] برگردان اعشار۶۴
        جمع یک += z.درایه‌ها.داده[6 + k] برگردان اعشار۶۴
    پایان
    سرچاپ "group means zero: "، ریاضی.قدرمطلق(جمع صفر / 6.0) کوچکتر 0.001، ریاضی.قدرمطلق(جمع یک / 6.0) کوچکتر 0.001
    ناپایا مربع صفر := 0.0
    تکرار 6 در k:
        v := z.درایه‌ها.داده[k] برگردان اعشار۶۴
        مربع صفر += v * v
    پایان
    سرچاپ "group variance: "، گرد(مربع صفر / 6.0)

    ناپایا توجه := شبکه عصبی.توجه چندسر جدید(پارامترها، "attn"، 8، 2، 0.0، g)
    سرچاپ "attention params: "، پارامترها.شمار()
    سرچاپ "attention shape: "، توجه.اندازه، توجه.سرها، توجه.علی
    سرچاپ "projection name: "، پارامترها.عنصر(توجه.وزن پرسش.شماره وزن).نام، پارامترها.عنصر(توجه.وزن خروجی.شماره وزن).نام
    ناپایا s := تانسور.شکل دو(6، 8)
    ناپایا ورودی الف := تانسور.تصادفی یکنواخت(s، 0.0 - 1.0، 1.0، 5)
    s.آزادسازی()
    ناپایا نوار سوم := مشتق‌گیری خودکار.نوار جدید(1)
    خروجی := مشتق‌گیری خودکار.مقدار(نوار سوم، توجه.پیشرو(نوار سوم، پارامترها، مشتق‌گیری خودکار.ورودی(نوار سوم، ورودی الف)، 2، 3))
    سرچاپ "attention output: "، خروجی.شکل.بگیر(0)، خروجی.شکل.بگیر(1)

    توجه.علی = درست
    ناپایا ورودی ب := تانسور.همانند(ورودی الف)
    ورودی ب.تنظیم در دو(2، 0، 9.0)
    ناپایا نوار چهارم := مشتق‌گیری خودکار.نوار جدید(1)
    خروجی الف := مشتق‌گیری خودکار.مقدار(نوار چهارم، توجه.پیشرو(نوار چهارم، پارامترها، مشتق‌گیری خودکار.ورودی(نوار چهارم، ورودی الف)، 2، 3))
    خروجی ب := مشتق‌گیری خودکار.مقدار(نوار چهارم، توجه.پیشرو(نوار چهارم، پارامترها، مشتق‌گیری خودکار.ورودی(نوار چهارم، ورودی ب)، 2، 3))
    ناپایا آینده نادیده := درست
    تکرار 2 در t:
        تکرار 8 در k:
            اگر خروجی الف.در دو(t، k) نابرابر خروجی ب.در دو(t، k): آینده نادیده = نادرست پایان
        پایان
    پایان
    ناپایا حال دیده := نادرست
    تکرار 8 در k:
        اگر خروجی الف.در دو(2، k) نابرابر خروجی ب.در دو(2، k): حال دیده = درست پایان
    پایان
    سرچاپ "causal ignores future: "، آینده نادیده
    سرچاپ "causal sees present: "، حال دیده

    نوار چهارم.آزادسازی()
    نوار سوم.آزادسازی()
    نوار دوم.آزادسازی()
    نوار.آزادسازی()
    تانسور.آزادسازی(ورودی ب)
    تانسور.آزادسازی(ورودی الف)
    تانسور.آزادسازی(تصویر)
    تانسور.آزادسازی(مورد انتظار)
    تانسور.آزادسازی(x)
    پارامترها.آزادسازی()
پایان
