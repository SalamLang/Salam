// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی مشتق‌گیری خودکار
واردسازی ریاضی
واردسازی شبکه عصبی
واردسازی تانسور

تابع rnd(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 1000.0) / 1000.0
پایان

تابع ریشه:
    ناپایا ps := شبکه عصبی.مخزن پارامتر {}
    ناپایا g := تانسور.مولد تصادفی جدید(11)

    full := شبکه عصبی.لایه خطی جدید(ps، "full"، 3، 2، g)
    سرچاپ "linear params: "، ps.شمار()، full.سوگیری دارد
    plain := شبکه عصبی.لایه خطی بی‌بایاس(ps، "plain"، 3، 2، g)
    سرچاپ "no bias params: "، ps.شمار()، plain.سوگیری دارد
    سرچاپ "no bias sizes: "، plain.اندازه‌ورودی، plain.اندازه خروجی
    سرچاپ "no bias weight: "، ps.عنصر(plain.شماره وزن).نام
    سرچاپ "no bias slot: "، plain.شماره سوگیری

    ناپایا x := تانسور.صفرها دو(2، 3)
    x.تنظیم در دو(0، 0، 1.0)
    x.تنظیم در دو(0، 1، 2.0)
    x.تنظیم در دو(0، 2، 3.0)
    x.تنظیم در دو(1، 0، 0.0 - 1.0)
    ناپایا tp := مشتق‌گیری خودکار.نوار جدید(1)
    y := مشتق‌گیری خودکار.مقدار(tp، plain.پیشرو(tp، ps، مشتق‌گیری خودکار.ورودی(tp، x)))
    ناپایا want := تانسور.ضرب ماتریسی(x، ps.عنصر(plain.شماره وزن).مقدار)
    ناپایا worst := 0.0
    تکرار 2 در r:
        تکرار 2 در c:
            d := ریاضی.قدرمطلق(y.در دو(r، c) - want.در دو(r، c))
            اگر d بزرگتر worst: worst = d پایان
        پایان
    پایان
    سرچاپ "output shape: "، y.شکل.بگیر(0)، y.شکل.بگیر(1)
    سرچاپ "matches matmul: "، worst کوچکتر 0.000001
    سرچاپ "second row linear: "، rnd(y.در دو(1، 0))، rnd(0.0 - ps.عنصر(plain.شماره وزن).مقدار.در دو(0، 0))

    gn := شبکه عصبی.نرمال‌سازی گروهی جدید(ps، "gn"، 4، 2)
    سرچاپ "group norm params: "، ps.شمار()، gn.گروه‌ها
    سرچاپ "gamma name: "، ps.عنصر(gn.شماره گاما).نام
    سرچاپ "beta name: "، ps.عنصر(gn.شماره بتا).نام
    ناپایا img := تانسور.صفرها چهار(1، 4، 1، 3)
    تکرار 4 در ch:
        تکرار 3 در k:
            img.درایه‌ها.داده[ch * 3 + k] = ((ch + 1) * (k + 1)) برگردان اعشار۳۲
        پایان
    پایان
    ناپایا tp2 := مشتق‌گیری خودکار.نوار جدید(1)
    z := مشتق‌گیری خودکار.مقدار(tp2، gn.پیشرو(tp2، ps، مشتق‌گیری خودکار.ورودی(tp2، img)))
    ناپایا sum0 := 0.0
    ناپایا sum1 := 0.0
    تکرار 6 در k:
        sum0 += z.درایه‌ها.داده[k] برگردان اعشار۶۴
        sum1 += z.درایه‌ها.داده[6 + k] برگردان اعشار۶۴
    پایان
    سرچاپ "group means zero: "، ریاضی.قدرمطلق(sum0 / 6.0) کوچکتر 0.001، ریاضی.قدرمطلق(sum1 / 6.0) کوچکتر 0.001
    ناپایا sq0 := 0.0
    تکرار 6 در k:
        v := z.درایه‌ها.داده[k] برگردان اعشار۶۴
        sq0 += v * v
    پایان
    سرچاپ "group variance: "، rnd(sq0 / 6.0)

    ناپایا attn := شبکه عصبی.توجه چندسر جدید(ps، "attn"، 8، 2، 0.0، g)
    سرچاپ "attention params: "، ps.شمار()
    سرچاپ "attention shape: "، attn.اندازه، attn.سرها، attn.علی
    سرچاپ "projection name: "، ps.عنصر(attn.وزن پرسش.شماره وزن).نام، ps.عنصر(attn.وزن خروجی.شماره وزن).نام
    ناپایا s := تانسور.شکل دو(6، 8)
    ناپایا xa := تانسور.تصادفی یکنواخت(s، 0.0 - 1.0، 1.0، 5)
    s.آزادسازی()
    ناپایا tp3 := مشتق‌گیری خودکار.نوار جدید(1)
    out := مشتق‌گیری خودکار.مقدار(tp3، attn.پیشرو(tp3، ps، مشتق‌گیری خودکار.ورودی(tp3، xa)، 2، 3))
    سرچاپ "attention output: "، out.شکل.بگیر(0)، out.شکل.بگیر(1)

    attn.علی = درست
    ناپایا xb := تانسور.همانند(xa)
    xb.تنظیم در دو(2، 0، 9.0)
    ناپایا tp4 := مشتق‌گیری خودکار.نوار جدید(1)
    ya := مشتق‌گیری خودکار.مقدار(tp4، attn.پیشرو(tp4، ps، مشتق‌گیری خودکار.ورودی(tp4، xa)، 2، 3))
    yb := مشتق‌گیری خودکار.مقدار(tp4، attn.پیشرو(tp4، ps، مشتق‌گیری خودکار.ورودی(tp4، xb)، 2، 3))
    ناپایا early := درست
    تکرار 2 در t:
        تکرار 8 در k:
            اگر ya.در دو(t، k) نابرابر yb.در دو(t، k): early = نادرست پایان
        پایان
    پایان
    ناپایا late := نادرست
    تکرار 8 در k:
        اگر ya.در دو(2، k) نابرابر yb.در دو(2، k): late = درست پایان
    پایان
    سرچاپ "causal ignores future: "، early
    سرچاپ "causal sees present: "، late

    tp4.آزادسازی()
    tp3.آزادسازی()
    tp2.آزادسازی()
    tp.آزادسازی()
    تانسور.آزادسازی(xb)
    تانسور.آزادسازی(xa)
    تانسور.آزادسازی(img)
    تانسور.آزادسازی(want)
    تانسور.آزادسازی(x)
    ps.آزادسازی()
پایان
