بسته جعلی

واردسازی رشته
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا کلیدها := وکتور {} برگردان وکتور<رشته>
ناپایا کدها := وکتور {} برگردان وکتور<صحیح>
ناپایا بدنه‌ها := وکتور {} برگردان وکتور<رشته>
ناپایا مصرف‌شده‌ها := وکتور {} برگردان وکتور<منطقی>
ناپایا آخرین := ""
ناپایا سرآیندهای آخر := ""
ناپایا شمار := 0

تابع رسیدگی(ه: صحیح۶۴):
    زمینه := اچ تی تی پی.زمینه جدید(ه)
    روش درخواست := اچ تی تی پی.روش(زمینه)
    مسیر درخواست := اچ تی تی پی.مسیر(زمینه)
    پرس := اچ تی تی پی.پرسمان خام(زمینه)
    ناپایا مقصد := مسیر درخواست
    اگر پرس.طول() > 0: مقصد = مسیر درخواست + "?" + پرس پایان
    شمار += 1
    آخرین = روش درخواست + " " + مقصد
    نوع محتوا := اچ تی تی پی.سرصفحه(زمینه، "Content-Type")
    اگر نوع محتوا.طول() > 0 و نوع محتوا != "application/json": آخرین = آخرین + "\n  type: " + نوع محتوا پایان
    بدنه := اچ تی تی پی.بدنه(زمینه)
    اگر بدنه.طول() > 0: آخرین = آخرین + "\n  body: " + رشته.پیرایش راست(بدنه) پایان
    سرآیندهای آخر = ""
    هر نام در ["Authorization"، "X-Amz-Date"، "X-Amz-Content-Sha256"، "X-Amz-Security-Token"، "X-Opaque-Id"، "User-Agent"]:
        ز := اچ تی تی پی.سرصفحه(زمینه، نام)
        اگر ز.طول() > 0: سرآیندهای آخر = سرآیندهای آخر + نام + ": " + ز + "\n" پایان
    پایان
    کلید درخواست := روش درخواست + " " + مسیر درخواست
    ناپایا انتخاب := -1
    تکرار کلیدها.طول() در ش:
        اگر انتخاب < 0 و کلیدها.بگیر(ش) == کلید درخواست و وارونه مصرف‌شده‌ها.بگیر(ش): انتخاب = ش پایان
    پایان
    اگر انتخاب < 0:
        تکرار کلیدها.طول() در ش:
            اگر کلیدها.بگیر(ش) == کلید درخواست: انتخاب = ش پایان
        پایان
    وگرنه:
        مصرف‌شده‌ها.بنشان(انتخاب، درست)
    پایان
    اگر انتخاب < 0:
        اچ تی تی پی.تنظیم وضعیت(زمینه، 404)
        اچ تی تی پی.جیسون(زمینه، `{"error":{"root_cause":[{"type":"resource_not_found_exception","reason":"no route for ` + کلید درخواست + `"}],"type":"resource_not_found_exception","reason":"no route for ` + کلید درخواست + `"},"status":404}`)
        برگشت
    پایان
    اچ تی تی پی.تنظیم وضعیت(زمینه، کدها.بگیر(انتخاب))
    اچ تی تی پی.جیسون(زمینه، بدنه‌ها.بگیر(انتخاب))
پایان

همگانی تابع ثبت پاسخ(روش درخواست: رشته، مسیر درخواست: رشته، کد: صحیح، بدنه: رشته):
    کلیدها.بیفزا(روش درخواست + " " + مسیر درخواست)
    کدها.بیفزا(کد)
    بدنه‌ها.بیفزا(بدنه)
    مصرف‌شده‌ها.بیفزا(نادرست)
پایان

همگانی تابع آخرین درخواست(): رشته:
    برگشت آخرین
پایان

همگانی تابع سرآیندها(): رشته:
    برگشت سرآیندهای آخر
پایان

همگانی تابع شمار درخواست(): صحیح:
    برگشت شمار
پایان

همگانی تابع آغاز(شماره درگاه: صحیح): منطقی:
    ناپایا ر := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(ر، "/*"، رسیدگی)
    مسیریاب.ارسال(ر، "/*"، رسیدگی)
    مسیریاب.قراردادن(ر، "/*"، رسیدگی)
    مسیریاب.وصله(ر، "/*"، رسیدگی)
    مسیریاب.حذف(ر، "/*"، رسیدگی)
    مسیریاب.سر(ر، "/*"، رسیدگی)
    س := اچ تی تی پی.سرور جدید(شماره درگاه)
    اچ تی تی پی.استفاده(س، ر)
    برگشت اچ تی تی پی.اجرا در پس زمینه(س)
پایان
