واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19924

تابع ریشه:
    جعلی.ثبت پاسخ("POST"، "/sales/_search"، 200، `{"took":9,"timed_out":false,"hits":{"total":{"value":1200,"relation":"eq"},"max_score":null,"hits":[]},"aggregations":{"by_city":{"doc_count_error_upper_bound":0,"sum_other_doc_count":310,"buckets":[{"key":"Tehran","doc_count":540,"revenue":{"value":81234.5}},{"key":"Shiraz","doc_count":210,"revenue":{"value":30120.0}},{"key":"Tabriz","doc_count":140,"revenue":{"value":19870.25}}]},"avg_price":{"value":24.75},"total":{"value":129224.75},"cheapest":{"value":2.5},"dearest":{"value":180.0},"priced":{"value":1188},"customers":{"value":893},"price_stats":{"count":1188,"min":2.5,"max":180.0,"avg":24.75,"sum":29403.0},"price_ext":{"count":1188,"min":2.5,"max":180.0,"avg":24.75,"sum":29403.0,"variance":310.2,"std_deviation":17.61},"latency":{"values":{"50.0":120.0,"99.0":870.5}},"price_hist":{"buckets":[{"key":0.0,"doc_count":400},{"key":50.0,"doc_count":700},{"key":100.0,"doc_count":100}]},"monthly":{"buckets":[{"key_as_string":"2026-08-01","key":1785542400000,"doc_count":380,"sales":{"value":40100.0}},{"key_as_string":"2026-09-01","key":1788220800000,"doc_count":820,"sales":{"value":89124.75}}]},"price_bands":{"buckets":[{"key":"*-10.0","to":10.0,"doc_count":200},{"key":"10.0-50.0","from":10.0,"to":50.0,"doc_count":800},{"key":"50.0-*","from":50.0,"doc_count":200}]},"keyed_bands":{"buckets":{"cheap":{"to":10.0,"doc_count":200},"normal":{"from":10.0,"doc_count":1000}}},"refunds":{"doc_count":12},"items":{"doc_count":3400,"top_skus":{"buckets":[{"key":"B-1","doc_count":90}]}},"no_price":{"doc_count":12},"top":{"hits":{"total":{"value":540,"relation":"eq"},"hits":[{"_index":"sales","_id":"s1","_score":1.0,"_source":{"sku":"B-1"}}]}},"pairs":{"after_key":{"city":"Yazd","channel":"web"},"buckets":[{"key":{"city":"Tehran","channel":"shop"},"doc_count":300},{"key":{"city":"Tehran","channel":"web"},"doc_count":240}]}}}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19924")

    ناپایا صدک‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    صدک‌ها.بیفزا(50.0)
    صدک‌ها.بیفزا(99.0)
    ناپایا کران‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    کران‌ها.بیفزا(10.0)
    کران‌ها.بیفزا(50.0)
    ناپایا جفت := وکتور {} برگردان وکتور<رشته>
    جفت.بیفزا("city")
    جفت.بیفزا("channel")
    شهرها := اپن سرچ.زیرتجمیع‌ها(اپن سرچ.تجمیع واژه‌ها("city"، 3)، اپن سرچ.افزودن تجمیع("{}"، "revenue"، اپن سرچ.تجمیع جمع("price")))
    ناپایا تجمیع‌ها := اپن سرچ.افزودن تجمیع("{}"، "by_city"، شهرها)
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "avg_price"، اپن سرچ.تجمیع میانگین("price"))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "total"، اپن سرچ.تجمیع جمع("price"))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "cheapest"، اپن سرچ.تجمیع کمینه("price"))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "dearest"، اپن سرچ.تجمیع بیشینه("price"))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "priced"، اپن سرچ.تجمیع شمار مقدار("price"))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "customers"، اپن سرچ.تجمیع یکتاها("customer_id"))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "price_stats"، اپن سرچ.تجمیع آمار("price"))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "price_ext"، اپن سرچ.تجمیع آمار گسترده("price"))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "latency"، اپن سرچ.تجمیع صدک‌ها("latency_ms"، صدک‌ها))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "price_hist"، اپن سرچ.تجمیع هیستوگرام("price"، 50.0))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "monthly"، اپن سرچ.زیرتجمیع‌ها(اپن سرچ.تجمیع هیستوگرام تاریخ("sold_at"، "month")، اپن سرچ.افزودن تجمیع("{}"، "sales"، اپن سرچ.تجمیع جمع("price"))))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "price_bands"، اپن سرچ.تجمیع بازه("price"، کران‌ها))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "refunds"، اپن سرچ.تجمیع پالایه(اپن سرچ.واژه منطقی("refunded"، درست)))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "items"، اپن سرچ.زیرتجمیع‌ها(اپن سرچ.تجمیع تودرتو("items")، اپن سرچ.افزودن تجمیع("{}"، "top_skus"، اپن سرچ.تجمیع واژه‌ها("items.sku"، 5))))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "no_price"، اپن سرچ.تجمیع گمشده‌ها("price"))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "top"، اپن سرچ.تجمیع برترین یافته‌ها(1))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "pairs"، اپن سرچ.تجمیع ترکیبی(جفت، 2))
    سرچاپ "aggs body:"، تجمیع‌ها

    ر := اپن سرچ.جستجو با درخواست(ک، "sales"، اپن سرچ.درخواست جستجو { size = 0، aggs = تجمیع‌ها، track_total_hits = "true" })
    سرچاپ "search:"، ر.ok، ر.total، ر.hits.طول()
    هر ب در اپن سرچ.سطل‌ها(ر.aggregations، "by_city"):
        سرچاپ "  city:"، ب.key، ب.doc_count، اپن سرچ.مقدار تجمیع(ب.raw، "revenue")
    پایان
    سرچاپ "metrics:"، اپن سرچ.مقدار تجمیع(ر.aggregations، "avg_price")، اپن سرچ.مقدار تجمیع(ر.aggregations، "total")، اپن سرچ.مقدار تجمیع(ر.aggregations، "cheapest")، اپن سرچ.مقدار تجمیع(ر.aggregations، "dearest")
    سرچاپ "counts:"، اپن سرچ.مقدار تجمیع(ر.aggregations، "priced")، اپن سرچ.مقدار تجمیع(ر.aggregations، "customers")
    سرچاپ "stats:"، اپن سرچ.فیلد تجمیع(ر.aggregations، "price_stats"، "min")، اپن سرچ.فیلد تجمیع(ر.aggregations، "price_stats"، "max")، اپن سرچ.فیلد تجمیع(ر.aggregations، "price_stats"، "sum")
    سرچاپ "spread:"، اپن سرچ.فیلد تجمیع(ر.aggregations، "price_ext"، "std_deviation")
    سرچاپ "percentiles:"، اپن سرچ.صدک تجمیع(ر.aggregations، "latency"، 50.0)، اپن سرچ.صدک تجمیع(ر.aggregations، "latency"، 99.0)
    هر ب در اپن سرچ.سطل‌ها(ر.aggregations، "price_hist"):
        سرچاپ "  bucket of 50 from"، ب.key + ":"، ب.doc_count
    پایان
    هر ب در اپن سرچ.سطل‌ها(ر.aggregations، "monthly"):
        سرچاپ "  month:"، ب.key_as_string، ب.key، ب.doc_count، اپن سرچ.مقدار تجمیع(ب.raw، "sales")
    پایان
    هر ب در اپن سرچ.سطل‌ها(ر.aggregations، "price_bands"):
        سرچاپ "  band:"، ب.key، ب.doc_count
    پایان
    هر ب در اپن سرچ.سطل‌ها(ر.aggregations، "keyed_bands"):
        سرچاپ "  keyed band:"، ب.key، ب.doc_count
    پایان
    سرچاپ "refunds:"، اپن سرچ.فیلد تجمیع(ر.aggregations، "refunds"، "doc_count")
    هر ب در اپن سرچ.سطل‌ها(اپن سرچ.تجمیع خام(ر.aggregations، "items")، "top_skus"):
        سرچاپ "  nested sku:"، ب.key، ب.doc_count
    پایان
    سرچاپ "missing price:"، اپن سرچ.فیلد تجمیع(ر.aggregations، "no_price"، "doc_count")
    برترین := اپن سرچ.تجزیه جستجو(اپن سرچ.تجمیع خام(ر.aggregations، "top"))
    سرچاپ "top hit:"، برترین.total، برترین.hits.بگیر(0).id، برترین.hits.بگیر(0).source
    جفت‌ها := اپن سرچ.تجمیع خام(ر.aggregations، "pairs")
    سرچاپ "composite next page after:"، اپن سرچ.مسیر خام جیسون(جفت‌ها، "after_key")
    هر ب در اپن سرچ.سطل‌ها(ر.aggregations، "pairs"):
        سرچاپ "  pair:"، ب.key، ب.doc_count
    پایان
    برگشت 0
پایان
