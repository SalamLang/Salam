واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19932

تابع ریشه:
    جعلی.ثبت پاسخ("POST"، "/_plugins/_alerting/monitors"، 201، `{"_id":"mon-7","_version":1,"_seq_no":0,"_primary_term":1,"monitor":{"type":"monitor","name":"error spike","enabled":true}}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_alerting/monitors/mon-7"، 200، `{"_id":"mon-7","_version":1,"monitor":{"type":"monitor","name":"error spike","enabled":true,"schedule":{"period":{"interval":5,"unit":"MINUTES"}}}}`)
    جعلی.ثبت پاسخ("PUT"، "/_plugins/_alerting/monitors/mon-7"، 200، `{"_id":"mon-7","_version":2}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_alerting/monitors/mon-7/_execute"، 200، `{"monitor_name":"error spike","period_start":1760000000000,"period_end":1760000300000,"input_results":{"results":[{"hits":{"total":{"value":17,"relation":"eq"}}}]},"trigger_results":{"t1":{"name":"too many","triggered":true}}}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_alerting/monitors/_search"، 200، `{"took":1,"timed_out":false,"hits":{"total":{"value":1,"relation":"eq"},"max_score":1.0,"hits":[{"_index":".opendistro-alerting-config","_id":"mon-7","_score":1.0,"_source":{"monitor":{"name":"error spike"}}}]}}`)
    جعلی.ثبت پاسخ("DELETE"، "/_plugins/_alerting/monitors/mon-7"، 200، `{"_index":".opendistro-alerting-config","_id":"mon-7","result":"deleted"}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19932")

    پرس := اپن سرچ.افزودن عضو(`{"size":0}`، "query"، اپن سرچ.تطبیق("level"، "error"))
    پایشگر := `{"type":"monitor","name":"error spike","enabled":true,"schedule":{"period":{"interval":5,"unit":"MINUTES"}},"inputs":[{"search":{"indices":["logs-*"],"query":` + پرس + `}}],"triggers":[{"name":"too many","severity":"1","condition":{"script":{"source":"ctx.results[0].hits.total.value > 10"}},"actions":[]}]}`
    شناسه := اپن سرچ.ایجاد پایشگر(ک، پایشگر)
    سرچاپ "monitor id:"، شناسه
    سرچاپ "  sent:"، جعلی.آخرین درخواست().بشکاف("\n").بگیر(0)
    دریافتی := اپن سرچ.دریافت پایشگر(ک، شناسه)
    سرچاپ "stored:"، اپن سرچ.مسیر جیسون(دریافتی، "name")، اپن سرچ.مسیر جیسون(دریافتی، "schedule.period.interval")
    سرچاپ "update:"، اپن سرچ.به‌روزرسانی پایشگر(ک، شناسه، پایشگر)
    نتیجه اجرا := اپن سرچ.اجرای پایشگر(ک، شناسه، درست)
    سرچاپ "dry run:"، اپن سرچ.مسیر جیسون(نتیجه اجرا، "input_results.results.0.hits.total.value")، اپن سرچ.مسیر جیسون(نتیجه اجرا، "trigger_results.t1.triggered")
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    یافته‌ها := اپن سرچ.جستجوی پایشگرها(ک، اپن سرچ.تطبیق("monitor.name"، "error"))
    سرچاپ "search:"، یافته‌ها.total، یافته‌ها.hits.بگیر(0).id
    سرچاپ "delete:"، اپن سرچ.حذف پایشگر(ک، شناسه)
    برگشت 0
پایان
