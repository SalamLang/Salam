واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19923

تابع ریشه:
    جعلی.ثبت پاسخ("POST"، "/_bulk"، 200، `{"took":30,"errors":true,"items":[{"index":{"_index":"books","_id":"10","_version":1,"result":"created","status":201}},{"index":{"_index":"books","_id":"11","_version":1,"result":"created","status":201}},{"create":{"_index":"books","_id":"1","status":409,"error":{"type":"version_conflict_engine_exception","reason":"[1]: version conflict, document already exists (current version [3])"}}},{"update":{"_index":"books","_id":"10","_version":2,"result":"updated","status":200}},{"update":{"_index":"books","_id":"12","_version":1,"result":"created","status":201}},{"delete":{"_index":"books","_id":"404","_version":1,"result":"not_found","status":404}},{"update":{"_index":"books","_id":"777","status":404,"error":{"type":"document_missing_exception","reason":"[777]: document missing"}}}]}`)
    جعلی.ثبت پاسخ("POST"، "/_bulk"، 200، `{"took":2,"errors":false,"items":[{"index":{"_index":"books","_id":"13","_version":1,"result":"created","status":201}}]}`)
    جعلی.ثبت پاسخ("POST"، "/_bulk"، 413، `{"error":{"type":"illegal_argument_exception","reason":"request too large"},"status":413}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19923")

    ناپایا ب := اپن سرچ.دسته‌ای تازه()
    اپن سرچ.نمایه‌سازی دسته‌ای(ب، "books"، "10"، "{\n  \"title\": \"Divan\",\n  \"author\": \"Hafez\"\n}")
    اپن سرچ.نمایه‌سازی دسته‌ای مسیردار(ب، "books"، "11"، "poetry"، `{"title":"Rubaiyat","author":"Khayyam"}`)
    اپن سرچ.ایجاد دسته‌ای(ب، "books"، "1"، `{"title":"Shahnameh"}`)
    اپن سرچ.به‌روزرسانی دسته‌ای(ب، "books"، "10"، `{"stock":4}`)
    اپن سرچ.به‌روزرسانی درجی دسته‌ای(ب، "books"، "12"، `{"title":"Bustan","author":"Saadi"}`)
    اپن سرچ.حذف دسته‌ای(ب، "books"، "404")
    اپن سرچ.به‌روزرسانی دسته‌ای(ب، "books"، "777"، `{"stock":1}`)
    سرچاپ "actions:"، اپن سرچ.اندازه دسته‌ای(ب)، ب.count، "lines:"، ب.lines.طول()
    سرچاپ "body:"
    چاپ اپن سرچ.بدنه دسته‌ای(ب)

    پاسخ := اپن سرچ.ارسال دسته‌ای با تازه‌سازی(ک، ب، اپن سرچ.تازه‌سازی با انتظار)
    سرچاپ "sent:"، جعلی.آخرین درخواست().بشکاف("\n").بگیر(0)
    سرچاپ "result:"، پاسخ.ok، پاسخ.status، پاسخ.took، پاسخ.errors، پاسخ.succeeded، پاسخ.failed
    سرچاپ "error:"، پاسخ.error
    هر قلم در پاسخ.items:
        سرچاپ "  item:"، قلم.action، قلم.index، قلم.id، قلم.status، قلم.ok، قلم.result، قلم.version، قلم.error_type، قلم.error_reason
    پایان

    اپن سرچ.بازنشانی دسته‌ای(ب)
    سرچاپ "after reset:"، اپن سرچ.اندازه دسته‌ای(ب)، اپن سرچ.بدنه دسته‌ای(ب).طول()
    اپن سرچ.ایجاد دسته‌ای(ب، "books"، ""، `{"title":"Makhzan al-Asrar"}`)
    دوباره := اپن سرچ.ارسال دسته‌ای(ک، ب)
    سرچاپ "second batch:"، دوباره.ok، دوباره.succeeded، دوباره.items.بگیر(0).id
    سرچاپ "sent:"، جعلی.آخرین درخواست()
    بزرگ := اپن سرچ.ارسال دسته‌ای(ک، ب)
    سرچاپ "rejected:"، بزرگ.ok، بزرگ.status، بزرگ.error
    اپن سرچ.آزادسازی دسته‌ای(ب)
    سرچاپ "empty batch:"، اپن سرچ.ارسال دسته‌ای(ک، اپن سرچ.دسته‌ای تازه()).ok

    تجزیه‌شده := اپن سرچ.تجزیه دسته‌ای(`{"took":1,"errors":false,"items":[{"delete":{"_index":"a","_id":"x","result":"deleted","status":200,"_version":4}}]}`)
    سرچاپ "parsed:"، تجزیه‌شده.ok، تجزیه‌شده.took، تجزیه‌شده.items.بگیر(0).action، تجزیه‌شده.items.بگیر(0).version
    برگشت 0
پایان
