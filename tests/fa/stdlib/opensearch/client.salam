واردسازی رشته
واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19920
پایا مرده := 19921

تابع نشانی(شماره درگاه: صحیح): رشته:
    برگشت "http://127.0.0.1:" + رشته.از عدد(شماره درگاه برگردان صحیح۶۴)
پایان

تابع ریشه:
    جعلی.ثبت پاسخ("HEAD"، "/"، 200، "")
    جعلی.ثبت پاسخ("GET"، "/"، 200، `{"name":"node-1","cluster_name":"shop","cluster_uuid":"Q1w2E3","version":{"distribution":"opensearch","number":"2.17.1","build_type":"tar","lucene_version":"9.11.1","minimum_wire_compatibility_version":"7.10.0"},"tagline":"The OpenSearch Project: https://opensearch.org/"}`)
    جعلی.ثبت پاسخ("GET"، "/_cluster/health"، 503، `{"error":{"type":"cluster_block_exception","reason":"cluster is starting"},"status":503}`)
    جعلی.ثبت پاسخ("GET"، "/_cluster/health"، 200، `{"cluster_name":"shop","status":"green","timed_out":false,"number_of_nodes":3,"number_of_data_nodes":2,"active_primary_shards":4,"active_shards":8,"relocating_shards":0,"initializing_shards":0,"unassigned_shards":0,"number_of_pending_tasks":0,"active_shards_percent_as_number":100.0}`)
    جعلی.ثبت پاسخ("GET"، "/books/_doc/missing"، 404، `{"_index":"books","_id":"missing","found":false}`)
    جعلی.ثبت پاسخ("GET"، "/plain"، 500، `{"error":"something broke","status":500}`)
    جعلی.ثبت پاسخ("GET"، "/denied"، 403، `{"error":{"root_cause":[{"type":"security_exception","reason":"no permissions for [indices:data/read/get]"}],"type":"security_exception","reason":"no permissions for [indices:data/read/get]"},"status":403}`)
    جعلی.ثبت پاسخ("POST"، "/_bulk"، 200، `{"took":1,"errors":false,"items":[]}`)
    جعلی.ثبت پاسخ("GET"، "/_count"، 200، `{"count":7}`)
    جعلی.ثبت پاسخ("GET"، "/proxy/_count"، 200، `{"count":7}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان

    ناپایا تنظیم := اپن سرچ.پیکربندی پیش‌فرض()
    سرچاپ "default nodes:"، تنظیم.nodes
    تنظیم.nodes = وکتور {} برگردان وکتور<رشته>
    تنظیم.nodes.بیفزا(نشانی(مرده) + ", " + نشانی(درگاه))
    تنظیم.username = "admin"
    تنظیم.password = "pa:ss"
    تنظیم.max_retries = 2
    تنظیم.timeout_ms = 5000
    تنظیم.headers.درج("X-Opaque-Id"، "shop-api")
    ناپایا ک := اپن سرچ.کارخواه تازه(تنظیم)
    سرچاپ "ok:"، اپن سرچ.معتبر(ک)، اپن سرچ.گره‌ها(ک)
    سرچاپ "auth header:"، اپن سرچ.سرآیند احراز(ک)، اپن سرچ.کدگذاری پایه("admin"، "pa:ss")

    سرچاپ "ping:"، اپن سرچ.پینگ(ک)
    سرچاپ "sent:"، جعلی.آخرین درخواست()
    چاپ جعلی.سرآیندها()

    آگاهی := اپن سرچ.دریافت اطلاعات(ک)
    سرچاپ "info:"، آگاهی.ok، آگاهی.name، آگاهی.cluster_name، آگاهی.cluster_uuid، آگاهی.version، آگاهی.distribution
    سرچاپ "      "، آگاهی.build_type، آگاهی.lucene_version، آگاهی.minimum_wire_compatibility_version، آگاهی.tagline

    پیشین := جعلی.شمار درخواست()
    ه := اپن سرچ.سلامت خوشه(ک)
    سرچاپ "health:"، ه.ok، ه.status، ه.nodes، ه.data_nodes، ه.active_shards، ه.active_shards_percent
    سرچاپ "requests for health (503 retried):"، جعلی.شمار درخواست() - پیشین

    د := اپن سرچ.دریافت(ک، "books"، "missing")
    سرچاپ "missing doc:"، د.found، د.error.طول()، اپن سرچ.وضعیت(ک)

    ر := اپن سرچ.انجام(ک، "GET"، "/plain"، "")
    سرچاپ "plain error:"، ر.ok، ر.status، ر.error
    ر۲ := اپن سرچ.انجام(ک، "GET"، "/denied"، "")
    سرچاپ "typed error:"، ر۲.status، ر۲.error_type
    سرچاپ "client error:"، اپن سرچ.خطا(ک)
    سرچاپ "error type:"، اپن سرچ.نوع خطا(ک)
    سرچاپ "error reason:"، اپن سرچ.علت خطا(ک)

    چندخطی := اپن سرچ.انجام چندخطی(ک، "POST"، "/_bulk"، "{\"delete\":{\"_index\":\"books\",\"_id\":\"9\"}}\n")
    سرچاپ "ndjson:"، چندخطی.ok، چندخطی.body
    سرچاپ "sent:"، جعلی.آخرین درخواست()
    تراکنش := اپن سرچ.انجام متنی(ک، "GET"، "/_count"، ""، "text/plain")
    سرچاپ "text:"، تراکنش.body
    اپن سرچ.بستن(ک)
    سرچاپ "closed:"، اپن سرچ.معتبر(ک)، اپن سرچ.خطا(ک)

    ناپایا توکن := اپن سرچ.کارخواه تازه(اپن سرچ.پیکربندی { bearer = "tok-123" })
    سرچاپ "bearer:"، اپن سرچ.سرآیند احراز(توکن)، اپن سرچ.گره‌ها(توکن)
    اپن سرچ.بستن(توکن)
    ناپایا اعتبارنامه := اپن سرچ.اتصال("http://reader:secret@127.0.0.1:" + رشته.از عدد(درگاه برگردان صحیح۶۴))
    سرچاپ "url credentials:"، اپن سرچ.سرآیند احراز(اعتبارنامه)
    اپن سرچ.بستن(اعتبارنامه)
    ناپایا احراز := اپن سرچ.اتصال با رمز(نشانی(درگاه)، "writer"، "pw")
    سرچاپ "connect auth:"، اپن سرچ.پینگ(احراز)
    چاپ جعلی.سرآیندها()
    اپن سرچ.بستن(احراز)
    ناپایا نمایشی := اپن سرچ.اتصال بدون وارسی گواهی("https://localhost:9200"، "admin"، "admin")
    سرچاپ "insecure:"، اپن سرچ.معتبر(نمایشی)، اپن سرچ.گره‌ها(نمایشی)
    اپن سرچ.بستن(نمایشی)
    ناپایا خراب := اپن سرچ.اتصال("ftp://example.com")
    سرچاپ "bad url:"، اپن سرچ.معتبر(خراب)، اپن سرچ.خطا(خراب)
    اپن سرچ.بستن(خراب)

    ناپایا آمازون := اپن سرچ.اتصال آمازون(نشانی(درگاه) + "/proxy"، "eu-west-1"، اپن سرچ.سرویس بی‌سرور، "AKIDEXAMPLE"، "EXAMPLEKEY"، "SESSIONTOKEN")
    اپن سرچ.تنظیم زمان امضا(آمازون، 1700000000 برگردان صحیح۶۴)
    سرچاپ "aws count:"، اپن سرچ.شمارش(آمازون، ""، "")
    سرچاپ "sent:"، جعلی.آخرین درخواست()
    سرآیندهای امضا := جعلی.سرآیندها()
    سرچاپ "signed:"، رشته.شامل است(سرآیندهای امضا، "AWS4-HMAC-SHA256 Credential=AKIDEXAMPLE/20231114/eu-west-1/aoss/aws4_request")
    سرچاپ "has date:"، رشته.شامل است(سرآیندهای امضا، "X-Amz-Date: 20231114T221320Z")، "has token:"، رشته.شامل است(سرآیندهای امضا، "X-Amz-Security-Token: SESSIONTOKEN")
    اپن سرچ.بستن(آمازون)
    سرچاپ "constants:"، اپن سرچ.نسخه کارخواه، اپن سرچ.نشانی پیش‌فرض، اپن سرچ.درگاه پیش‌فرض، اپن سرچ.مهلت گره از کار افتاده، اپن سرچ.سرویس دامنه
    برگشت 0
پایان
