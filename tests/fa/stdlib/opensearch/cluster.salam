واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19927
پایا تایید := `{"acknowledged":true}`

تابع ریشه:
    سلامتی := `{"cluster_name":"shop","status":"yellow","timed_out":false,"number_of_nodes":1,"number_of_data_nodes":1,"active_primary_shards":7,"active_shards":7,"relocating_shards":0,"initializing_shards":0,"unassigned_shards":5,"number_of_pending_tasks":0,"active_shards_percent_as_number":58.333333333333336}`
    جعلی.ثبت پاسخ("GET"، "/_cluster/health"، 200، سلامتی)
    جعلی.ثبت پاسخ("GET"، "/_cluster/health/books"، 200، سلامتی)
    جعلی.ثبت پاسخ("GET"، "/_cluster/stats"، 200، `{"cluster_name":"shop","indices":{"count":7,"docs":{"count":1042}},"nodes":{"count":{"total":1}}}`)
    جعلی.ثبت پاسخ("GET"، "/_cluster/state/metadata"، 200، `{"cluster_name":"shop","metadata":{"cluster_uuid":"Q1w2E3"}}`)
    جعلی.ثبت پاسخ("GET"، "/_cluster/settings"، 200، `{"persistent":{"cluster.routing.allocation.enable":"all"},"transient":{}}`)
    جعلی.ثبت پاسخ("PUT"، "/_cluster/settings"، 200، `{"acknowledged":true,"persistent":{"cluster.routing.allocation.enable":"all"},"transient":{}}`)
    جعلی.ثبت پاسخ("POST"، "/_cluster/allocation/explain"، 200، `{"index":"books","shard":0,"primary":false,"current_state":"unassigned","can_allocate":"no"}`)
    جعلی.ثبت پاسخ("GET"، "/_nodes/os"، 200، `{"_nodes":{"total":1},"cluster_name":"shop","nodes":{"n1":{"name":"node-1","os":{"name":"Linux","available_processors":6}}}}`)
    جعلی.ثبت پاسخ("GET"، "/_nodes/stats/jvm"، 200، `{"_nodes":{"total":1},"nodes":{"n1":{"jvm":{"mem":{"heap_used_percent":41}}}}}`)
    جعلی.ثبت پاسخ("GET"، "/_nodes/hot_threads"، 200، "::: {node-1}\n   Hot threads at 2026-10-16T12:00:00Z, interval=500ms")
    جعلی.ثبت پاسخ("GET"، "/_cat/shards"، 200، `[{"index":"books","shard":"0","prirep":"p","state":"STARTED"},{"index":"books","shard":"0","prirep":"r","state":"UNASSIGNED"}]`)
    جعلی.ثبت پاسخ("GET"، "/_cat/nodes"، 200، "ip        heap.percent name\n127.0.0.1           41 node-1\n")
    جعلی.ثبت پاسخ("GET"، "/_cat/plugins"، 200، `[{"name":"node-1","component":"opensearch-knn","version":"2.17.1.0"},{"name":"node-1","component":"opensearch-sql","version":"2.17.1.0"},{"name":"node-2","component":"opensearch-knn","version":"2.17.1.0"}]`)
    جعلی.ثبت پاسخ("GET"، "/_tasks/n1:12345"، 200، `{"completed":false,"task":{"node":"n1","id":12345,"type":"transport","action":"indices:data/write/reindex","description":"reindex from [books] to [books_v2]","status":{"total":1000,"created":250}}}`)
    جعلی.ثبت پاسخ("GET"، "/_tasks/n1:12345"، 200، `{"completed":true,"task":{"node":"n1","id":12345,"action":"indices:data/write/reindex","description":"reindex from [books] to [books_v2]","status":{"total":1000,"created":1000}},"response":{"took":5000,"created":1000,"failures":[]}}`)
    جعلی.ثبت پاسخ("GET"، "/_tasks/n1:999"، 200، `{"completed":true,"task":{"node":"n1","id":999,"action":"indices:data/write/update/byquery"},"error":{"type":"script_exception","reason":"runtime error"}}`)
    جعلی.ثبت پاسخ("POST"، "/_tasks/n1:12345/_cancel"، 200، `{"nodes":{}}`)
    جعلی.ثبت پاسخ("GET"، "/_tasks"، 200، `{"nodes":{"n1":{"tasks":{"n1:12345":{"action":"indices:data/write/reindex"}}}}}`)
    جعلی.ثبت پاسخ("PUT"، "/_snapshot/backups"، 200، تایید)
    جعلی.ثبت پاسخ("GET"، "/_snapshot/backups"، 200، `{"backups":{"type":"fs","settings":{"location":"/mnt/backups"}}}`)
    جعلی.ثبت پاسخ("POST"، "/_snapshot/backups/_verify"، 200، `{"nodes":{"n1":{"name":"node-1"}}}`)
    جعلی.ثبت پاسخ("PUT"، "/_snapshot/backups/nightly-1"، 200، `{"snapshot":{"snapshot":"nightly-1","uuid":"s1","indices":["books"],"state":"SUCCESS","shards":{"total":1,"failed":0,"successful":1}}}`)
    جعلی.ثبت پاسخ("PUT"، "/_snapshot/backups/nightly-2"، 202، `{"accepted":true}`)
    جعلی.ثبت پاسخ("GET"، "/_snapshot/backups/nightly-1"، 200، `{"snapshots":[{"snapshot":"nightly-1","state":"SUCCESS"}]}`)
    جعلی.ثبت پاسخ("GET"، "/_snapshot/backups/_all"، 200، `{"snapshots":[{"snapshot":"nightly-1","state":"SUCCESS"},{"snapshot":"nightly-2","state":"IN_PROGRESS"}]}`)
    جعلی.ثبت پاسخ("GET"، "/_snapshot/backups/nightly-2/_status"، 200، `{"snapshots":[{"snapshot":"nightly-2","state":"STARTED","stats":{"incremental":{"file_count":3}}}]}`)
    جعلی.ثبت پاسخ("POST"، "/_snapshot/backups/nightly-1/_restore"، 200، `{"snapshot":{"snapshot":"nightly-1","indices":["restored_books"],"shards":{"total":1,"failed":0,"successful":1}}}`)
    جعلی.ثبت پاسخ("DELETE"، "/_snapshot/backups/nightly-1"، 200، تایید)
    جعلی.ثبت پاسخ("DELETE"، "/_snapshot/backups"، 200، تایید)
    جعلی.ثبت پاسخ("PUT"، "/_ingest/pipeline/clean"، 200، تایید)
    جعلی.ثبت پاسخ("GET"، "/_ingest/pipeline/clean"، 200، `{"clean":{"description":"tidy incoming books","processors":[{"lowercase":{"field":"genre"}}]}}`)
    جعلی.ثبت پاسخ("POST"، "/_ingest/pipeline/clean/_simulate"، 200، `{"docs":[{"doc":{"_index":"_index","_id":"_id","_source":{"genre":"poetry","seen":true},"_ingest":{"timestamp":"2026-10-16T12:00:00Z"}}},{"doc":{"_index":"_index","_id":"_id","_source":{"genre":"epic","seen":true}}}]}`)
    جعلی.ثبت پاسخ("DELETE"، "/_ingest/pipeline/clean"، 200، تایید)
    جعلی.ثبت پاسخ("PUT"، "/_scripts/double"، 200، تایید)
    جعلی.ثبت پاسخ("GET"، "/_scripts/double"، 200، `{"_id":"double","found":true,"script":{"lang":"painless","source":"doc['stock'].value * 2"}}`)
    جعلی.ثبت پاسخ("PUT"، "/_scripts/by_genre"، 200، تایید)
    جعلی.ثبت پاسخ("GET"، "/_scripts/by_genre"، 200، `{"_id":"by_genre","found":true,"script":{"lang":"mustache","source":{"query":{"term":{"genre":"{{genre}}"}}}}}`)
    جعلی.ثبت پاسخ("DELETE"، "/_scripts/double"، 200، تایید)
    جعلی.ثبت پاسخ("DELETE"، "/_scripts/by_genre"، 200، تایید)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19927")

    ه := اپن سرچ.سلامت خوشه(ک)
    سرچاپ "health:"، ه.ok، ه.cluster_name، ه.status، ه.timed_out، ه.nodes، ه.data_nodes، ه.active_primary_shards
    سرچاپ "  shards:"، ه.active_shards، ه.relocating_shards، ه.initializing_shards، ه.unassigned_shards، ه.pending_tasks، ه.active_shards_percent
    ن := اپن سرچ.انتظار وضعیت(ک، "books"، "yellow"، "30s")
    سرچاپ "wait for yellow:"، ن.status، "sent:"، جعلی.آخرین درخواست()
    سرچاپ "stats:"، اپن سرچ.مسیر جیسون(اپن سرچ.آمار خوشه(ک)، "indices.docs.count")
    سرچاپ "state:"، اپن سرچ.مسیر جیسون(اپن سرچ.حالت خوشه(ک، "metadata")، "metadata.cluster_uuid")
    سرچاپ "put settings:"، اپن سرچ.تنظیم تنظیمات خوشه(ک، `{"cluster.routing.allocation.enable":"all"}`، "")
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "settings:"، اپن سرچ.دریافت تنظیمات خوشه(ک)
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "allocation:"، اپن سرچ.مسیر جیسون(اپن سرچ.توضیح تخصیص(ک، `{"index":"books","shard":0,"primary":false}`)، "can_allocate")
    سرچاپ "nodes info:"، اپن سرچ.مسیر جیسون(اپن سرچ.اطلاعات گره‌ها(ک، "os")، "nodes.n1.os.available_processors")
    سرچاپ "nodes stats:"، اپن سرچ.مسیر جیسون(اپن سرچ.آمار گره‌ها(ک، "jvm")، "nodes.n1.jvm.mem.heap_used_percent")
    سرچاپ "hot threads:"، اپن سرچ.نخ‌های پرکار(ک).بشکاف("\n").بگیر(0)
    هر ردیف در اپن سرچ.فهرست(ک، "shards?h=index,shard,prirep,state"):
        سرچاپ "cat row:"، اپن سرچ.مسیر جیسون(ردیف، "index")، اپن سرچ.مسیر جیسون(ردیف، "prirep")، اپن سرچ.مسیر جیسون(ردیف، "state")
    پایان
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    چاپ اپن سرچ.فهرست متنی(ک، "nodes")
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "plugins:"، اپن سرچ.افزونه‌ها(ک)
    سرچاپ "has knn:"، اپن سرچ.دارای افزونه(ک، "opensearch-knn")، "has ltr:"، اپن سرچ.دارای افزونه(ک، "opensearch-ltr")

    ت := اپن سرچ.دریافت کار(ک، "n1:12345")
    سرچاپ "task:"، ت.ok، ت.id، ت.completed، ت.action، ت.description
    سرچاپ "  progress:"، ت.status
    تمام‌شده := اپن سرچ.انتظار کار(ک، "n1:12345"، "60s")
    سرچاپ "waited:"، تمام‌شده.completed، تمام‌شده.response، "sent:"، جعلی.آخرین درخواست()
    ناموفق := اپن سرچ.دریافت کار(ک، "n1:999")
    سرچاپ "failed task:"، ناموفق.ok، ناموفق.error
    سرچاپ "cancel:"، اپن سرچ.لغو کار(ک، "n1:12345")، جعلی.آخرین درخواست()
    سرچاپ "running:"، اپن سرچ.فهرست کارها(ک، "*reindex").طول() > 0، جعلی.آخرین درخواست()

    سرچاپ "repository:"، اپن سرچ.تنظیم مخزن(ک، "backups"، "fs"، `{"location":"/mnt/backups","compress":true}`)
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "  get:"، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت مخزن(ک، "backups")، "backups.type")، "verify:"، اپن سرچ.وارسی مخزن(ک، "backups")
    سرچاپ "snapshot (waited):"، اپن سرچ.ایجاد تصویر لحظه‌ای(ک، "backups"، "nightly-1"، "books"، درست)
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "snapshot (background):"، اپن سرچ.ایجاد تصویر لحظه‌ای(ک، "backups"، "nightly-2"، ""، نادرست)
    سرچاپ "  snapshots:"، اپن سرچ.تصویرهای لحظه‌ای(ک، "backups")، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت تصویر لحظه‌ای(ک، "backups"، "nightly-1")، "snapshots.0.state")
    سرچاپ "  status:"، اپن سرچ.مسیر جیسون(اپن سرچ.وضعیت تصویر لحظه‌ای(ک، "backups"، "nightly-2")، "snapshots.0.state")
    سرچاپ "restore:"، اپن سرچ.بازیابی تصویر لحظه‌ای(ک، "backups"، "nightly-1"، `{"indices":"books","rename_pattern":"(.+)","rename_replacement":"restored_$1"}`، درست)
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "cleanup:"، اپن سرچ.حذف تصویر لحظه‌ای(ک، "backups"، "nightly-1")، اپن سرچ.حذف مخزن(ک، "backups")

    ناپایا پردازنده‌ها := وکتور {} برگردان وکتور<رشته>
    پردازنده‌ها.بیفزا(اپن سرچ.پردازنده("lowercase"، `{"field":"genre"}`))
    پردازنده‌ها.بیفزا(اپن سرچ.پردازنده("set"، `{"field":"seen","value":true}`))
    پردازنده‌ها.بیفزا(اپن سرچ.پردازنده("trim"، ""))
    بدنه := اپن سرچ.خط لوله("tidy incoming books"، پردازنده‌ها)
    سرچاپ "pipeline body:"، بدنه
    سرچاپ "pipeline:"، اپن سرچ.تنظیم خط لوله(ک، "clean"، بدنه)، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت خط لوله(ک، "clean")، "clean.description")
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"genre":"POETRY"}`)
    سندها.بیفزا(`{"genre":"Epic"}`)
    هر خروجی در اپن سرچ.شبیه‌سازی خط لوله(ک، "clean"، سندها):
        سرچاپ "  simulated:"، خروجی
    پایان
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "drop pipeline:"، اپن سرچ.حذف خط لوله(ک، "clean")

    سرچاپ "script:"، اپن سرچ.تنظیم اسکریپت(ک، "double"، "doc['stock'].value * 2")، اپن سرچ.دریافت اسکریپت(ک، "double")
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "template:"، اپن سرچ.تنظیم الگوی جستجو(ک، "by_genre"، `{"query":{"term":{"genre":"{{genre}}"}}}`)، اپن سرچ.دریافت اسکریپت(ک، "by_genre")
    سرچاپ "cleanup:"، اپن سرچ.حذف اسکریپت(ک، "double")، اپن سرچ.حذف اسکریپت(ک، "by_genre")
    برگشت 0
پایان
