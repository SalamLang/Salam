واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19922

تابع نوشته‌شد(برچسب: رشته، ن: اپن سرچ.نتیجه نوشتن):
    سرچاپ برچسب + ":"، ن.ok، ن.status، ن.index، ن.id، ن.result، ن.version، ن.seq_no، ن.primary_term، ن.shards_total، ن.shards_successful
    اگر وارونه ن.ok: سرچاپ "  error:"، ن.error پایان
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
پایان

تابع ریشه:
    ساخته‌شده := `{"_index":"books","_id":"1","_version":1,"result":"created","_shards":{"total":2,"successful":1,"failed":0},"_seq_no":0,"_primary_term":1}`
    جعلی.ثبت پاسخ("PUT"، "/books/_doc/1"، 201، ساخته‌شده)
    جعلی.ثبت پاسخ("POST"، "/books/_doc"، 201، `{"_index":"books","_id":"Zx81kpQB","_version":1,"result":"created","_shards":{"total":2,"successful":1,"failed":0},"_seq_no":1,"_primary_term":1}`)
    جعلی.ثبت پاسخ("PUT"، "/books/_create/1"، 409، `{"error":{"root_cause":[{"type":"version_conflict_engine_exception","reason":"[1]: version conflict, document already exists (current version [1])"}],"type":"version_conflict_engine_exception","reason":"[1]: version conflict, document already exists (current version [1])"},"status":409}`)
    جعلی.ثبت پاسخ("PUT"، "/books/_create/2"، 201، `{"_index":"books","_id":"2","_version":1,"result":"created","_seq_no":2,"_primary_term":1}`)
    جعلی.ثبت پاسخ("GET"، "/books/_doc/1"، 200، `{"_index":"books","_id":"1","_version":1,"_seq_no":0,"_primary_term":1,"_routing":"poetry","found":true,"_source":{"title":"Shahnameh","author":"Ferdowsi","year":1010,"stock":3}}`)
    جعلی.ثبت پاسخ("GET"، "/books/_doc/404"، 404، `{"_index":"books","_id":"404","found":false}`)
    جعلی.ثبت پاسخ("GET"، "/books/_source/1"، 200، `{"title":"Shahnameh","author":"Ferdowsi","year":1010,"stock":3}`)
    جعلی.ثبت پاسخ("HEAD"، "/books/_doc/1"، 200، "")
    جعلی.ثبت پاسخ("HEAD"، "/books/_doc/404"، 404، "")
    جعلی.ثبت پاسخ("POST"، "/books/_update/1"، 200، `{"_index":"books","_id":"1","_version":2,"result":"updated","_shards":{"total":2,"successful":1,"failed":0},"_seq_no":3,"_primary_term":1}`)
    جعلی.ثبت پاسخ("POST"، "/books/_update/1"، 409، `{"error":{"type":"version_conflict_engine_exception","reason":"[1]: version conflict, required seqNo [0], primary term [1]. current document has seqNo [3] and primary term [1]"},"status":409}`)
    جعلی.ثبت پاسخ("POST"، "/books/_update/1"، 200، `{"_index":"books","_id":"1","_version":3,"result":"updated","_seq_no":4,"_primary_term":1}`)
    جعلی.ثبت پاسخ("POST"، "/books/_update/9"، 201، `{"_index":"books","_id":"9","_version":1,"result":"created","_seq_no":5,"_primary_term":1}`)
    جعلی.ثبت پاسخ("DELETE"، "/books/_doc/9"، 200، `{"_index":"books","_id":"9","_version":2,"result":"deleted","_seq_no":6,"_primary_term":1}`)
    جعلی.ثبت پاسخ("DELETE"، "/books/_doc/9"، 404، `{"_index":"books","_id":"9","_version":3,"result":"not_found","_seq_no":7,"_primary_term":1}`)
    جعلی.ثبت پاسخ("POST"، "/books/_mget"، 200، `{"docs":[{"_index":"books","_id":"1","_version":3,"_seq_no":4,"_primary_term":1,"found":true,"_source":{"title":"Shahnameh"}},{"_index":"books","_id":"404","found":false}]}`)
    جعلی.ثبت پاسخ("GET"، "/books/_count"، 200، `{"count":42,"_shards":{"total":1,"successful":1,"skipped":0,"failed":0}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_count"، 200، `{"count":7,"_shards":{"total":1,"successful":1,"skipped":0,"failed":0}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_delete_by_query"، 200، `{"took":14,"timed_out":false,"total":5,"deleted":5,"batches":1,"version_conflicts":0,"noops":0,"retries":{"bulk":0,"search":0},"failures":[]}`)
    جعلی.ثبت پاسخ("POST"، "/books/_update_by_query"، 200، `{"took":20,"timed_out":false,"total":12,"updated":12,"deleted":0,"batches":1,"version_conflicts":0,"noops":0,"retries":{"bulk":0,"search":0},"failures":[]}`)
    جعلی.ثبت پاسخ("POST"، "/_reindex"، 200، `{"took":31,"timed_out":false,"total":42,"created":42,"updated":0,"deleted":0,"batches":1,"version_conflicts":0,"noops":0,"failures":[]}`)
    جعلی.ثبت پاسخ("POST"، "/_reindex"، 200، `{"task":"oTUltX4IQMOUUVeiohTt8A:12345"}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19922")

    نوشته‌شد("index"، اپن سرچ.نمایه‌سازی(ک، "books"، "1"، `{"title":"Shahnameh","author":"Ferdowsi","year":1010,"stock":3}`))
    نوشته‌شد("index with options"، اپن سرچ.نمایه‌سازی با گزینه(ک، "books"، "1"، `{"title":"Shahnameh"}`، اپن سرچ.گزینه‌ها {
        refresh = اپن سرچ.تازه‌سازی با انتظار، routing = "poetry"، pipeline = "clean"، timeout = "5s"،
        wait_for_active_shards = "1"، if_seq_no = 0، if_primary_term = 1
    }))
    نوشته‌شد("index without id"، اپن سرچ.نمایه‌سازی(ک، "books"، ""، `{"title":"Masnavi"}`))
    نوشته‌شد("create existing"، اپن سرچ.ایجاد سند(ک، "books"، "1"، `{"title":"again"}`))
    نوشته‌شد("create with options"، اپن سرچ.ایجاد سند با گزینه(ک، "books"، "2"، `{"title":"Golestan"}`، اپن سرچ.گزینه‌ها { refresh = اپن سرچ.تازه‌سازی فوری، version = 5، version_type = "external" }))

    د := اپن سرچ.دریافت(ک، "books"، "1")
    سرچاپ "get:"، د.found، د.index، د.id، د.version، د.seq_no، د.primary_term، د.routing
    سرچاپ "  source:"، د.source
    ناپایا فقط := وکتور {} برگردان وکتور<رشته>
    فقط.بیفزا("title")
    فقط.بیفزا("year")
    ف := اپن سرچ.دریافت فیلدها(ک، "books"، "1"، فقط، "poetry")
    سرچاپ "get fields sent:"، جعلی.آخرین درخواست()
    سرچاپ "  found:"، ف.found
    گمشده := اپن سرچ.دریافت(ک، "books"، "404")
    سرچاپ "missing:"، گمشده.found، گمشده.error.طول()، اپن سرچ.وضعیت(ک)
    سرچاپ "source only:"، اپن سرچ.دریافت منبع(ک، "books"، "1")
    سرچاپ "exists:"، اپن سرچ.وجود سند(ک، "books"، "1")، اپن سرچ.وجود سند(ک، "books"، "404")

    نوشته‌شد("update"، اپن سرچ.به‌روزرسانی(ک، "books"، "1"، `{"stock":2}`))
    نوشته‌شد("conditional update"، اپن سرچ.به‌روزرسانی با گزینه(ک، "books"، "1"، `{"doc":{"stock":1}}`، اپن سرچ.گزینه‌ها { if_seq_no = د.seq_no، if_primary_term = د.primary_term، retry_on_conflict = -1 }))
    نوشته‌شد("script update"، اپن سرچ.به‌روزرسانی اسکریپتی(ک، "books"، "1"، اپن سرچ.اسکریپت("ctx._source.stock += params.n"، `{"n":5}`)، `{"stock":5}`))
    نوشته‌شد("upsert"، اپن سرچ.به‌روزرسانی درجی(ک، "books"، "9"، `{"title":"Kalila and Dimna","stock":1}`))
    نوشته‌شد("delete"، اپن سرچ.حذف سند با گزینه(ک، "books"، "9"، اپن سرچ.گزینه‌ها { refresh = اپن سرچ.تازه‌سازی فوری }))
    نوشته‌شد("delete again"، اپن سرچ.حذف سند(ک، "books"، "9"))

    ناپایا شناسه‌ها := وکتور {} برگردان وکتور<رشته>
    شناسه‌ها.بیفزا("1")
    شناسه‌ها.بیفزا("404")
    سندها := اپن سرچ.دریافت چندگانه(ک، "books"، شناسه‌ها)
    سرچاپ "mget sent:"، جعلی.آخرین درخواست()
    هر سند در سندها:
        سرچاپ "  doc:"، سند.id، سند.found، سند.version، سند.source
    پایان

    سرچاپ "count all:"، اپن سرچ.شمارش(ک، "books"، "")
    سرچاپ "count query:"، اپن سرچ.شمارش(ک، "books"، اپن سرچ.بازه("year"، "1000"، "1300"))
    سرچاپ "  sent:"، جعلی.آخرین درخواست()

    حذف‌شده‌ها := اپن سرچ.حذف پرسمانی با گزینه(ک، "books"، اپن سرچ.واژه("stock"، "0")، اپن سرچ.گزینه‌ها { refresh = "true"، conflicts = "proceed" })
    سرچاپ "delete by query:"، حذف‌شده‌ها.ok، حذف‌شده‌ها.took، حذف‌شده‌ها.total، حذف‌شده‌ها.deleted، حذف‌شده‌ها.batches، حذف‌شده‌ها.version_conflicts
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    به‌روزشده‌ها := اپن سرچ.به‌روزرسانی پرسمانی(ک، "books"، اپن سرچ.تطبیق همه()، اپن سرچ.اسکریپت("ctx._source.seen = true"، ""))
    سرچاپ "update by query:"، به‌روزشده‌ها.ok، به‌روزشده‌ها.total، به‌روزشده‌ها.updated، به‌روزشده‌ها.noops، به‌روزشده‌ها.failures.طول()
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    بازنمایه := اپن سرچ.نمایه‌سازی دوباره(ک، "books"، "books_v2")
    سرچاپ "reindex:"، بازنمایه.ok، بازنمایه.created، بازنمایه.timed_out
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    پس‌زمینه := اپن سرچ.نمایه‌سازی دوباره با بدنه(ک، `{"source":{"index":"books","query":{"term":{"author":"Ferdowsi"}}},"dest":{"index":"ferdowsi"}}`، نادرست)
    سرچاپ "background reindex:"، پس‌زمینه.ok، پس‌زمینه.task
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    برگشت 0
پایان
