واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19926
پایا تایید := `{"acknowledged":true}`

تابع فهرست(الف: رشته، ب: رشته): وکتور<رشته>:
    ناپایا ز := وکتور {} برگردان وکتور<رشته>
    ز.بیفزا(الف)
    اگر ب.طول() > 0: ز.بیفزا(ب) پایان
    برگشت ز
پایان

تابع نمایش(برچسب: رشته، مقدار داده: منطقی):
    سرچاپ برچسب + ":"، مقدار داده
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
پایان

تابع ریشه:
    جعلی.ثبت پاسخ("PUT"، "/books"، 200، `{"acknowledged":true,"shards_acknowledged":true,"index":"books"}`)
    جعلی.ثبت پاسخ("PUT"، "/books"، 400، `{"error":{"root_cause":[{"type":"resource_already_exists_exception","reason":"index [books/x1] already exists"}],"type":"resource_already_exists_exception","reason":"index [books/x1] already exists"},"status":400}`)
    جعلی.ثبت پاسخ("PUT"، "/logs-000001"، 200، `{"acknowledged":true,"shards_acknowledged":true,"index":"logs-000001"}`)
    جعلی.ثبت پاسخ("HEAD"، "/books"، 200، "")
    جعلی.ثبت پاسخ("HEAD"، "/nope"، 404، "")
    جعلی.ثبت پاسخ("GET"، "/books"، 200، `{"books":{"aliases":{},"mappings":{"properties":{"title":{"type":"text"}}},"settings":{"index":{"number_of_shards":"1"}}}}`)
    جعلی.ثبت پاسخ("PUT"، "/books/_mapping"، 200، تایید)
    جعلی.ثبت پاسخ("GET"، "/books/_mapping"، 200، `{"books":{"mappings":{"dynamic":"strict","properties":{"isbn":{"type":"keyword"},"title":{"type":"text"}}}}}`)
    جعلی.ثبت پاسخ("PUT"، "/books/_settings"، 200، تایید)
    جعلی.ثبت پاسخ("GET"، "/books/_settings"، 200، `{"books":{"settings":{"index":{"refresh_interval":"5s","number_of_shards":"1"}}}}`)
    جعلی.ثبت پاسخ("GET"، "/books/_settings/index.refresh_interval"، 200، `{"books":{"settings":{"index.refresh_interval":"5s"}}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_refresh"، 200، `{"_shards":{"total":2,"successful":1,"failed":0}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_flush"، 200، `{"_shards":{"total":2,"successful":1,"failed":0}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_forcemerge"، 200، `{"_shards":{"total":2,"successful":1,"failed":0}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_cache/clear"، 200، `{"_shards":{"total":2,"successful":1,"failed":0}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_close"، 200، `{"acknowledged":true,"shards_acknowledged":true,"indices":{"books":{"closed":true}}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_open"، 200، `{"acknowledged":true,"shards_acknowledged":true}`)
    جعلی.ثبت پاسخ("PUT"، "/books/_clone/books_copy"، 200، `{"acknowledged":true,"shards_acknowledged":true,"index":"books_copy"}`)
    جعلی.ثبت پاسخ("PUT"، "/books/_shrink/books_small"، 200، `{"acknowledged":true,"shards_acknowledged":true,"index":"books_small"}`)
    جعلی.ثبت پاسخ("PUT"، "/books/_split/books_big"، 200، `{"acknowledged":true,"shards_acknowledged":true,"index":"books_big"}`)
    جعلی.ثبت پاسخ("GET"، "/books/_stats"، 200، `{"_all":{"primaries":{"docs":{"count":42,"deleted":0}}}}`)
    جعلی.ثبت پاسخ("PUT"، "/books/_alias/library"، 200، تایید)
    جعلی.ثبت پاسخ("PUT"، "/books/_alias/poetry"، 200، تایید)
    جعلی.ثبت پاسخ("HEAD"، "/_alias/library"، 200، "")
    جعلی.ثبت پاسخ("GET"، "/books/_alias"، 200، `{"books":{"aliases":{"library":{},"poetry":{"filter":{"term":{"genre":"poetry"}}}}}}`)
    جعلی.ثبت پاسخ("GET"، "/_alias/library"، 200، `{"books":{"aliases":{"library":{}}},"books_copy":{"aliases":{"library":{}}}}`)
    جعلی.ثبت پاسخ("DELETE"، "/books/_alias/poetry"، 200، تایید)
    جعلی.ثبت پاسخ("POST"، "/_aliases"، 200، تایید)
    جعلی.ثبت پاسخ("POST"، "/_aliases"، 200، تایید)
    جعلی.ثبت پاسخ("PUT"، "/_index_template/logs"، 200، تایید)
    جعلی.ثبت پاسخ("HEAD"، "/_index_template/logs"، 200، "")
    جعلی.ثبت پاسخ("GET"، "/_index_template/logs"، 200، `{"index_templates":[{"name":"logs","index_template":{"index_patterns":["logs-*"],"priority":10}}]}`)
    جعلی.ثبت پاسخ("DELETE"، "/_index_template/logs"، 200، تایید)
    جعلی.ثبت پاسخ("PUT"، "/_component_template/base"، 200، تایید)
    جعلی.ثبت پاسخ("GET"، "/_component_template/base"، 200، `{"component_templates":[{"name":"base","component_template":{"template":{"settings":{"number_of_shards":"1"}}}}]}`)
    جعلی.ثبت پاسخ("DELETE"، "/_component_template/base"، 200، تایید)
    جعلی.ثبت پاسخ("PUT"، "/_data_stream/events-web"، 200، تایید)
    جعلی.ثبت پاسخ("GET"، "/_data_stream"، 200، `{"data_streams":[{"name":"events-web","timestamp_field":{"name":"@timestamp"},"indices":[{"index_name":".ds-events-web-000001"}],"generation":1,"status":"GREEN","template":"events"}]}`)
    جعلی.ثبت پاسخ("DELETE"، "/_data_stream/events-web"، 200، تایید)
    جعلی.ثبت پاسخ("POST"، "/logs/_rollover"، 200، `{"acknowledged":true,"shards_acknowledged":true,"old_index":"logs-000001","new_index":"logs-000002","rolled_over":true,"dry_run":false,"conditions":{"[max_docs: 1000000]":true}}`)
    جعلی.ثبت پاسخ("POST"، "/_analyze"، 200، `{"tokens":[{"token":"salam","start_offset":0,"end_offset":5,"type":"<ALPHANUM>","position":0},{"token":"opensearch","start_offset":9,"end_offset":19,"type":"<ALPHANUM>","position":2}]}`)
    جعلی.ثبت پاسخ("POST"، "/books/_analyze"، 200، `{"tokens":[{"token":"کتاب","start_offset":0,"end_offset":4,"type":"<ALPHANUM>","position":0}]}`)
    جعلی.ثبت پاسخ("GET"، "/_cat/indices/books*"، 200، `[{"health":"green","status":"open","index":"books","uuid":"x1","pri":"1","rep":"1","docs.count":"42","docs.deleted":"3","store.size":"52301"},{"health":"yellow","status":"open","index":"books_copy","uuid":"x2","pri":"1","rep":"1","docs.count":"42","docs.deleted":"0","store.size":"50112"}]`)
    جعلی.ثبت پاسخ("DELETE"، "/books_copy,books_small"، 200، تایید)
    جعلی.ثبت پاسخ("DELETE"، "/never-made"، 404، `{"error":{"type":"index_not_found_exception","reason":"no such index [never-made]"},"status":404}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19926")

    ناپایا ویژگی‌ها := وکتور {} برگردان وکتور<رشته>
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی("title"، "text"))
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی با گزینه("title_fa"، "text"، `{"analyzer":"persian"}`))
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی("genre"، "keyword"))
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی با گزینه("year"، "integer"، `{"index":true}`))
    سرچاپ "properties:"، اپن سرچ.ویژگی‌ها(ویژگی‌ها)
    نمایش("create with settings"، اپن سرچ.ایجاد نمایه با تنظیمات(ک، "books"، 1، 1، اپن سرچ.ویژگی‌ها(ویژگی‌ها)))
    نمایش("create again"، اپن سرچ.ایجاد نمایه(ک، "books"، ""))
    سرچاپ "  error:"، اپن سرچ.نوع خطا(ک)
    نمایش("create with body"، اپن سرچ.ایجاد نمایه(ک، "logs-000001"، `{"aliases":{"logs":{"is_write_index":true}}}`))
    سرچاپ "exists:"، اپن سرچ.وجود نمایه(ک، "books")، اپن سرچ.وجود نمایه(ک، "nope")
    سرچاپ "get index:"، اپن سرچ.دریافت نمایه(ک، "books")

    نمایش("put mapping"، اپن سرچ.تنظیم نگاشت(ک، "books"، "{" + اپن سرچ.ویژگی("isbn"، "keyword") + "}"))
    نمایش("put mapping body"، اپن سرچ.تنظیم نگاشت با بدنه(ک، "books"، `{"dynamic":"strict"}`))
    نگاشت := اپن سرچ.دریافت نگاشت(ک، "books")
    سرچاپ "mapping:"، اپن سرچ.مسیر جیسون(نگاشت، "books.mappings.dynamic")، اپن سرچ.مسیر جیسون(نگاشت، "books.mappings.properties.isbn.type")
    نمایش("put settings"، اپن سرچ.تنظیم تنظیمات(ک، "books"، `{"index":{"refresh_interval":"5s"}}`))
    سرچاپ "settings:"، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت تنظیمات(ک، "books")، "books.settings.index.number_of_shards")
    سرچاپ "one setting:"، اپن سرچ.دریافت یک تنظیم(ک، "books"، "index.refresh_interval")
    سرچاپ "maintenance:"، اپن سرچ.تازه‌سازی(ک، "books")، اپن سرچ.تخلیه(ک، "books")، اپن سرچ.ادغام اجباری(ک، "books"، 1)، اپن سرچ.پاک‌سازی حافظه نهان(ک، "books")
    سرچاپ "  last:"، جعلی.آخرین درخواست()
    نمایش("close"، اپن سرچ.بستن نمایه(ک، "books"))
    نمایش("open"، اپن سرچ.گشودن نمایه(ک، "books"))
    نمایش("clone"، اپن سرچ.همسان‌سازی نمایه(ک، "books"، "books_copy"، ""))
    نمایش("shrink"، اپن سرچ.کوچک‌سازی نمایه(ک، "books"، "books_small"، `{"settings":{"index.number_of_shards":1}}`))
    نمایش("split"، اپن سرچ.شکافتن نمایه(ک، "books"، "books_big"، `{"settings":{"index.number_of_shards":2}}`))
    سرچاپ "stats docs:"، اپن سرچ.مسیر جیسون(اپن سرچ.آمار نمایه(ک، "books")، "_all.primaries.docs.count")

    نمایش("alias"، اپن سرچ.افزودن نام مستعار(ک، "books"، "library"))
    نمایش("filtered alias"، اپن سرچ.افزودن نام مستعار پالایش شده(ک، "books"، "poetry"، اپن سرچ.واژه("genre"، "poetry")، درست))
    سرچاپ "alias exists:"، اپن سرچ.وجود نام مستعار(ک، "library")
    سرچاپ "aliases:"، اپن سرچ.دریافت نام‌های مستعار(ک، "books")
    سرچاپ "alias points at:"، اپن سرچ.نمایه‌های نام مستعار(ک، "library")
    نمایش("drop alias"، اپن سرچ.حذف نام مستعار(ک، "books"، "poetry"))
    نمایش("update aliases"، اپن سرچ.به‌روزرسانی نام‌های مستعار(ک، فهرست(اپن سرچ.کنش نام مستعار("add"، "books_copy"، "library")، اپن سرچ.کنش نام مستعار("remove"، "books"، "library"))))
    نمایش("swap alias"، اپن سرچ.جابجایی نام مستعار(ک، "library"، "books_copy"، "books"))

    الگو := اپن سرچ.الگوی نمایه(فهرست("logs-*"، "")، `{"number_of_replicas":0}`، "{" + اپن سرچ.ویژگی("message"، "text") + "}"، 10)
    سرچاپ "template body:"، الگو
    نمایش("index template"، اپن سرچ.تنظیم الگوی نمایه(ک، "logs"، الگو))
    سرچاپ "template exists:"، اپن سرچ.وجود الگوی نمایه(ک، "logs")، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت الگوی نمایه(ک، "logs")، "index_templates.0.index_template.priority")
    نمایش("component template"، اپن سرچ.تنظیم الگوی جزء(ک، "base"، `{"template":{"settings":{"number_of_shards":1}}}`))
    سرچاپ "component:"، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت الگوی جزء(ک، "base")، "component_templates.0.name")
    نمایش("data stream"، اپن سرچ.ایجاد جریان داده(ک، "events-web"))
    سرچاپ "data streams:"، اپن سرچ.جریان‌های داده(ک)
    سرچاپ "rollover:"، اپن سرچ.چرخش نمایه(ک، "logs"، `{"max_docs":1000000,"max_age":"7d"}`)
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "analyze:"، اپن سرچ.تحلیل متن(ک، ""، "standard"، "Salam to OpenSearch")
    سرچاپ "analyze persian:"، اپن سرچ.تحلیل متن(ک، "books"، "persian"، "کتاب‌ها")
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    هر نمایه در اپن سرچ.فهرست نمایه‌ها(ک، "books*"):
        سرچاپ "cat:"، نمایه.health، نمایه.status، نمایه.index، نمایه.uuid، نمایه.primaries، نمایه.replicas، نمایه.docs_count، نمایه.docs_deleted، نمایه.store_size
    پایان
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "cleanup:"، اپن سرچ.حذف الگوی نمایه(ک، "logs")، اپن سرچ.حذف الگوی جزء(ک، "base")، اپن سرچ.حذف جریان داده(ک، "events-web")
    نمایش("delete two"، اپن سرچ.حذف نمایه(ک، "books_copy,books_small"))
    نمایش("delete if exists"، اپن سرچ.حذف نمایه موجود(ک، "never-made"))
    برگشت 0
پایان
