واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19930

تابع ریشه:
    ذخیره‌شده := `{"_id":"logs-30d","_version":1,"_seq_no":0,"_primary_term":1,"policy":{"policy_id":"logs-30d","description":"drop old logs","default_state":"hot","states":[{"name":"hot"},{"name":"delete"}]}}`
    جعلی.ثبت پاسخ("PUT"، "/_plugins/_ism/policies/logs-30d"، 201، ذخیره‌شده)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_ism/policies/logs-30d"، 200، ذخیره‌شده)
    جعلی.ثبت پاسخ("PUT"، "/_plugins/_ism/policies/logs-30d"، 200، `{"_id":"logs-30d","_version":2,"_seq_no":1,"_primary_term":1}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ism/add/logs-*"، 200، `{"updated_indices":3,"failures":false,"failed_indices":[]}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ism/add/nope"، 200، `{"updated_indices":0,"failures":true,"failed_indices":[{"index_name":"nope","reason":"no such index"}]}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ism/change_policy/logs-*"، 200، `{"updated_indices":3,"failures":false,"failed_indices":[]}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ism/retry/logs-000001"، 200، `{"updated_indices":1,"failures":false,"failed_indices":[]}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_ism/explain/logs-000001"، 200، `{"logs-000001":{"index.plugins.index_state_management.policy_id":"logs-30d","index.opendistro.index_state_management.policy_id":"logs-30d","index":"logs-000001","policy_id":"logs-30d","state":{"name":"hot"},"enabled":true},"total_managed_indices":1}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ism/remove/logs-*"، 200، `{"updated_indices":3,"failures":false,"failed_indices":[]}`)
    جعلی.ثبت پاسخ("DELETE"، "/_plugins/_ism/policies/logs-30d"، 200، `{"_index":".opendistro-ism-config","_id":"logs-30d","result":"deleted"}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19930")

    ناپایا الگوها := وکتور {} برگردان وکتور<رشته>
    الگوها.بیفزا("logs-*")
    سیاست := اپن سرچ.سیاست حذف پس از("drop old logs"، "30d"، الگوها)
    سرچاپ "policy:"، سیاست
    سرچاپ "create:"، اپن سرچ.تنظیم سیاست(ک، "logs-30d"، سیاست)
    سرچاپ "  sent:"، جعلی.آخرین درخواست().بشکاف("\n").بگیر(0)
    دریافتی := اپن سرچ.دریافت سیاست(ک، "logs-30d")
    سرچاپ "stored:"، اپن سرچ.مسیر جیسون(دریافتی، "policy.default_state")، اپن سرچ.مسیر جیسون(دریافتی، "policy.states.1.name")
    ترتیب := اپن سرچ.مسیر جیسون(دریافتی، "_seq_no").به صحیح() برگردان صحیح۶۴
    دوره := اپن سرچ.مسیر جیسون(دریافتی، "_primary_term").به صحیح() برگردان صحیح۶۴
    سرچاپ "update:"، اپن سرچ.به‌روزرسانی سیاست(ک، "logs-30d"، اپن سرچ.سیاست حذف پس از("drop old logs"، "60d"، الگوها)، ترتیب، دوره)
    سرچاپ "  sent:"، جعلی.آخرین درخواست().بشکاف("\n").بگیر(0)
    سرچاپ "attach:"، اپن سرچ.افزودن سیاست(ک، "logs-*"، "logs-30d")
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "attach to a missing index:"، اپن سرچ.افزودن سیاست(ک، "nope"، "logs-30d")
    سرچاپ "change:"، اپن سرچ.تغییر سیاست(ک، "logs-*"، "logs-30d"، "hot")
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "retry:"، اپن سرچ.تلاش دوباره سیاست(ک، "logs-000001")
    سرچاپ "policy of index:"، اپن سرچ.شناسه سیاست نمایه(ک، "logs-000001")
    سرچاپ "explain:"، اپن سرچ.مسیر جیسون(اپن سرچ.توضیح سیاست(ک، "logs-000001")، "total_managed_indices")
    سرچاپ "detach:"، اپن سرچ.برداشتن سیاست(ک، "logs-*")
    سرچاپ "delete:"، اپن سرچ.حذف سیاست(ک، "logs-30d")
    برگشت 0
پایان
