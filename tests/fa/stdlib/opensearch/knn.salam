واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19929

تابع اعشارها(الف: اعشار۶۴، ب: اعشار۶۴، ک: اعشار۶۴): وکتور<اعشار۶۴>:
    ناپایا ز := وکتور {} برگردان وکتور<اعشار۶۴>
    ز.بیفزا(الف)
    ز.بیفزا(ب)
    ز.بیفزا(ک)
    برگشت ز
پایان

تابع ریشه:
    جعلی.ثبت پاسخ("PUT"، "/places"، 200، `{"acknowledged":true,"shards_acknowledged":true,"index":"places"}`)
    جعلی.ثبت پاسخ("POST"، "/places/_search"، 200، `{"took":4,"timed_out":false,"hits":{"total":{"value":2,"relation":"eq"},"max_score":0.97,"hits":[{"_index":"places","_id":"cafe-1","_score":0.97,"_source":{"name":"Naderi Cafe"}},{"_index":"places","_id":"cafe-2","_score":0.81,"_source":{"name":"Lamiz"}}]}}`)
    جعلی.ثبت پاسخ("POST"، "/places/_search"، 200، `{"took":9,"timed_out":false,"hits":{"total":{"value":1,"relation":"eq"},"max_score":1.0,"hits":[{"_index":"places","_id":"cafe-1","_score":1.0,"_source":{"name":"Naderi Cafe"}}]}}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_knn/warmup/places"، 200، `{"_shards":{"total":1,"successful":1,"failed":0}}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_knn/clear_cache/places"، 200، `{"_shards":{"total":1,"successful":1,"failed":0}}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_knn/stats"، 200، `{"_nodes":{"total":1},"circuit_breaker_triggered":false,"nodes":{"n1":{"graph_memory_usage":12}}}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_knn/models/pq-1/_train"، 200، `{"model_id":"pq-1"}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_knn/models/pq-1"، 200، `{"model_id":"pq-1","state":"created","dimension":3,"engine":"faiss"}`)
    جعلی.ثبت پاسخ("DELETE"، "/_plugins/_knn/models/pq-1"، 200، `{"model_id":"pq-1","result":"deleted"}`)
    جعلی.ثبت پاسخ("PUT"، "/_search/pipeline/hybrid"، 200، `{"acknowledged":true}`)
    جعلی.ثبت پاسخ("GET"، "/_search/pipeline/hybrid"، 200، `{"hybrid":{"phase_results_processors":[{"normalization-processor":{"normalization":{"technique":"min_max"}}}]}}`)
    جعلی.ثبت پاسخ("DELETE"، "/_search/pipeline/hybrid"، 200، `{"acknowledged":true}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ml/models/_register"، 200، `{"task_id":"t-11","status":"CREATED"}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_ml/tasks/t-11"، 200، `{"model_id":"m-31","task_type":"REGISTER_MODEL","state":"COMPLETED"}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ml/models/m-31/_deploy"، 200، `{"task_id":"t-12","task_type":"DEPLOY_MODEL","status":"CREATED"}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_ml/models/m-31"، 200، `{"name":"all-MiniLM-L6-v2","model_state":"DEPLOYED","algorithm":"TEXT_EMBEDDING"}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ml/_predict/text_embedding/m-31"، 200، `{"inference_results":[{"output":[{"name":"sentence_embedding","shape":[3],"data":[0.1,0.8,0.3]}]}]}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ml/models/m-31/_undeploy"، 200، `{"n1":{"stats":{"m-31":"undeployed"}}}`)
    جعلی.ثبت پاسخ("DELETE"، "/_plugins/_ml/models/m-31"، 200، `{"_index":".plugins-ml-model","_id":"m-31","result":"deleted"}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19929")

    روش درخواست := اپن سرچ.روش همسایه‌یابی { name = "hnsw"، engine = "lucene"، space_type = "cosinesimil"، m = 16، ef_construction = 128 }
    سرچاپ "default method:"، اپن سرچ.فیلد بردار همسایه‌یابی(384، اپن سرچ.روش همسایه‌یابی {})
    سرچاپ "settings:"، اپن سرچ.تنظیمات نمایه همسایه‌یابی(1، 0)
    ناپایا افزوده := وکتور {} برگردان وکتور<رشته>
    افزوده.بیفزا(اپن سرچ.ویژگی("name"، "text"))
    افزوده.بیفزا(اپن سرچ.ویژگی("city"، "keyword"))
    سرچاپ "create:"، اپن سرچ.ایجاد نمایه(ک، "places"، اپن سرچ.بدنه نمایه همسایه‌یابی("embedding"، 3، روش درخواست، افزوده))
    سرچاپ "  sent:"، جعلی.آخرین درخواست()

    پرس := اعشارها(0.1، 0.8، 0.3)
    سرچاپ "vector:"، اپن سرچ.بردار همسایه‌یابی(پرس)
    نزدیک‌ها := اپن سرچ.جستجو(ک، "places"، اپن سرچ.نزدیک‌ترین همسایه‌ها("embedding"، پرس، 2))
    سرچاپ "nearest:"، نزدیک‌ها.total
    هر ه در نزدیک‌ها.hits:
        سرچاپ "  "، ه.id، ه.score، ه.source
    پایان
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    پالایش‌شده := اپن سرچ.جستجو(ک، "places"، اپن سرچ.نزدیک‌ترین همسایه‌های پالایش شده("embedding"، پرس، 5، اپن سرچ.واژه("city"، "Tehran")))
    سرچاپ "filtered:"، پالایش‌شده.total، پالایش‌شده.hits.بگیر(0).id
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "radial:"، اپن سرچ.همسایه‌های شعاعی("embedding"، پرس، 0.3)
    سرچاپ "min score:"، اپن سرچ.همسایه‌ها با کمینه امتیاز("embedding"، پرس، 0.9)

    سرچاپ "warmup:"، اپن سرچ.گرم‌کردن همسایه‌یابی(ک، "places")، "clear:"، اپن سرچ.پاک‌سازی حافظه همسایه‌یابی(ک، "places")
    سرچاپ "stats:"، اپن سرچ.مسیر جیسون(اپن سرچ.آمار همسایه‌یابی(ک)، "circuit_breaker_triggered")
    سرچاپ "train:"، اپن سرچ.آموزش مدل همسایه‌یابی(ک، "pq-1"، `{"training_index":"train","training_field":"embedding","dimension":3,"method":{"name":"ivf","engine":"faiss","parameters":{"nlist":4}}}`)
    سرچاپ "  model:"، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت مدل همسایه‌یابی(ک، "pq-1")، "state")، "deleted:"، اپن سرچ.حذف مدل همسایه‌یابی(ک، "pq-1")

    ناپایا وزن‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    وزن‌ها.بیفزا(0.3)
    وزن‌ها.بیفزا(0.7)
    لوله := اپن سرچ.خط لوله نرمال‌سازی("min_max"، "arithmetic_mean"، وزن‌ها)
    سرچاپ "hybrid pipeline:"، اپن سرچ.تنظیم خط لوله جستجو(ک، "hybrid"، لوله)
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "  stored:"، اپن سرچ.دریافت خط لوله جستجو(ک، "hybrid")

    کار := اپن سرچ.ثبت مدل یادگیری(ک، `{"name":"huggingface/sentence-transformers/all-MiniLM-L6-v2","version":"1.0.1","model_format":"TORCH_SCRIPT"}`)
    سرچاپ "register:"، کار، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت کار یادگیری(ک، کار)، "model_id")
    سرچاپ "deploy:"، اپن سرچ.استقرار مدل یادگیری(ک، "m-31")، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت مدل یادگیری(ک، "m-31")، "model_state")
    جاسازی := اپن سرچ.پیش‌بینی مدل(ک، "text_embedding"، "m-31"، `{"text_docs":["a quiet cafe"]}`)
    سرچاپ "embedding:"، اپن سرچ.مسیر خام جیسون(جاسازی، "inference_results.0.output.0.data")

    ناپایا دوتایی := وکتور {} برگردان وکتور<رشته>
    دوتایی.بیفزا(اپن سرچ.تطبیق("name"، "cafe"))
    دوتایی.بیفزا(اپن سرچ.عصبی("embedding"، "a quiet cafe"، "m-31"، 5))
    ترکیبی := اپن سرچ.جستجو با پارامتر(ک، "places"، اپن سرچ.افزودن عضو("{}"، "query"، اپن سرچ.ترکیبی(دوتایی))، اپن سرچ.پارامترهای جستجو { search_pipeline = "hybrid" })
    سرچاپ "hybrid search:"، ترکیبی.total، ترکیبی.hits.بگیر(0).id
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "sparse:"، اپن سرچ.عصبی پراکنده("tokens"، "a quiet cafe"، "m-40")
    سرچاپ "undeploy:"، اپن سرچ.برچیدن مدل یادگیری(ک، "m-31")، "delete:"، اپن سرچ.حذف مدل یادگیری(ک، "m-31")، "pipeline gone:"، اپن سرچ.حذف خط لوله جستجو(ک، "hybrid")
    برگشت 0
پایان
