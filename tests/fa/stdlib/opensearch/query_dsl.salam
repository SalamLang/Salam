واردسازی دیتابیس.اپن سرچ

تابع فهرست(الف: رشته، ب: رشته): وکتور<رشته>:
    ناپایا ز := وکتور {} برگردان وکتور<رشته>
    ز.بیفزا(الف)
    اگر ب.طول() > 0: ز.بیفزا(ب) پایان
    برگشت ز
پایان

تابع ریشه:
    سرچاپ "full text:"
    سرچاپ "  "، اپن سرچ.تطبیق همه()
    سرچاپ "  "، اپن سرچ.تطبیق هیچ()
    سرچاپ "  "، اپن سرچ.تطبیق("title"، "book of kings")
    سرچاپ "  "، اپن سرچ.تطبیق همه واژه‌ها("title"، "book of kings")
    سرچاپ "  "، اپن سرچ.تطبیق تقریبی("author"، "ferdousi")
    سرچاپ "  "، اپن سرچ.تطبیق عبارت("title"، "book of kings")
    سرچاپ "  "، اپن سرچ.تطبیق عبارت با فاصله("title"، "book kings"، 2)
    سرچاپ "  "، اپن سرچ.تطبیق پیشوند عبارت("title"، "book of ki")
    سرچاپ "  "، اپن سرچ.تطبیق پیشوند منطقی("title"، "kings bo")
    سرچاپ "  "، اپن سرچ.تطبیق چندگانه("ferdowsi"، فهرست("title^2"، "author"))
    سرچاپ "  "، اپن سرچ.تطبیق چندگانه نوع‌دار("persian epic"، فهرست("title"، "summary")، "most_fields")
    سرچاپ "  "، اپن سرچ.رشته پرسمان("author:ferdowsi AND year:[1000 TO 1100]")
    سرچاپ "  "، اپن سرچ.رشته پرسمان در فیلدها("epic poem"، فهرست("title"، "summary")، "AND")
    سرچاپ "  "، اپن سرچ.رشته پرسمان ساده("epic -modern"، فهرست("summary"، ""))
    سرچاپ "  "، اپن سرچ.مشابه(فهرست("summary"، "")، "a long poem about the kings of Iran")

    سرچاپ "exact values:"
    سرچاپ "  "، اپن سرچ.واژه("genre"، "epic")
    سرچاپ "  "، اپن سرچ.واژه عددی("year"، 1010)
    سرچاپ "  "، اپن سرچ.واژه منطقی("in_print"، درست)
    سرچاپ "  "، اپن سرچ.واژه بدون حساسیت حروف("genre"، "Epic")
    سرچاپ "  "، اپن سرچ.واژه‌ها("genre"، فهرست("epic"، "lyric"))
    ناپایا سال‌ها := وکتور {} برگردان وکتور<صحیح۶۴>
    سال‌ها.بیفزا(1010)
    سال‌ها.بیفزا(1258)
    سرچاپ "  "، اپن سرچ.واژه‌های عددی("year"، سال‌ها)
    سرچاپ "  "، اپن سرچ.واژه‌های ارجاعی("genre"، "readers"، "u7"، "likes")
    سرچاپ "  "، اپن سرچ.مجموعه واژه‌ها("tags"، فهرست("persian"، "classic")، "required_matches")
    سرچاپ "  "، اپن سرچ.وجود فیلد("isbn")
    سرچاپ "  "، اپن سرچ.پیشوند("isbn"، "978-964")
    سرچاپ "  "، اپن سرچ.نویسه عام("isbn"، "978-*-1")
    سرچاپ "  "، اپن سرچ.عبارت باقاعده("isbn"، "978-[0-9]+")
    سرچاپ "  "، اپن سرچ.تقریبی("author"، "sadi")
    سرچاپ "  "، اپن سرچ.شناسه‌ها(فهرست("1"، "2"))

    سرچاپ "ranges:"
    سرچاپ "  "، اپن سرچ.بازه("published"، "1000-01-01"، "")
    سرچاپ "  "، اپن سرچ.بازه باز("price"، "10"، "20")
    سرچاپ "  "، اپن سرچ.بازه عددی("price"، 9.5، 19.99)
    سرچاپ "  "، اپن سرچ.بازه صحیح("stock"، 1، 100)
    سرچاپ "  "، اپن سرچ.بازه با عملگر("price"، "lt"، "5")
    سرچاپ "  "، اپن سرچ.بازه تاریخ("published"، "now-30d/d"، "now"، "yyyy-MM-dd"، "+03:30")

    سرچاپ "compound:"
    ناپایا ب := اپن سرچ.پرسمان منطقی { minimum_should_match = "1"، boost = 1.5 }
    ب.must.بیفزا(اپن سرچ.تطبیق("summary"، "kings"))
    ب.filter.بیفزا(اپن سرچ.واژه("genre"، "epic"))
    ب.should.بیفزا(اپن سرچ.واژه("tags"، "classic"))
    ب.must_not.بیفزا(اپن سرچ.واژه("tags"، "abridged"))
    سرچاپ "  "، اپن سرچ.پرسمان منطقی ساخته(ب)
    سرچاپ "  "، اپن سرچ.منطقی(فهرست(اپن سرچ.تطبیق("t"، "x")، "")، فهرست(اپن سرچ.واژه("a"، "1")، "")، وکتور {} برگردان وکتور<رشته>، فهرست(اپن سرچ.واژه("b"، "2")، ""))
    سرچاپ "  "، اپن سرچ.همه شرط‌ها(فهرست(اپن سرچ.واژه("genre"، "epic")، اپن سرچ.واژه عددی("year"، 1010)))
    سرچاپ "  "، اپن سرچ.یکی از شرط‌ها(فهرست(اپن سرچ.واژه("genre"، "epic")، اپن سرچ.واژه("genre"، "lyric")))
    سرچاپ "  "، اپن سرچ.نقیض(اپن سرچ.واژه("genre"، "prose"))
    سرچاپ "  "، اپن سرچ.پالایش شده(اپن سرچ.تطبیق("summary"، "kings")، فهرست(اپن سرچ.بازه صحیح("year"، 900، 1100)، ""))
    سرچاپ "  "، اپن سرچ.امتیاز ثابت(اپن سرچ.واژه("genre"، "epic")، 2.0)
    سرچاپ "  "، اپن سرچ.بیشینه جداگانه(فهرست(اپن سرچ.تطبیق("title"، "kings")، اپن سرچ.تطبیق("summary"، "kings"))، 0.3)
    سرچاپ "  "، اپن سرچ.تقویت(اپن سرچ.تطبیق("summary"، "kings")، اپن سرچ.واژه("tags"، "abridged")، 0.2)
    سرچاپ "  "، اپن سرچ.تودرتو("reviews"، اپن سرچ.بازه صحیح("reviews.stars"، 4، 5))
    سرچاپ "  "، اپن سرچ.دارای فرزند("review"، اپن سرچ.واژه عددی("stars"، 5))
    سرچاپ "  "، اپن سرچ.دارای والد("book"، اپن سرچ.واژه("genre"، "epic"))

    سرچاپ "scripts and scoring:"
    سرچاپ "  "، اپن سرچ.اسکریپت("doc['stock'].value > params.min"، `{"min":2}`)
    سرچاپ "  "، اپن سرچ.پرسمان اسکریپت("doc['stock'].value > params.min"، `{"min":2}`)
    سرچاپ "  "، اپن سرچ.امتیاز اسکریپتی(اپن سرچ.تطبیق("summary"، "kings")، "_score * Math.log(2 + doc['sales'].value)"، "")
    سرچاپ "  "، اپن سرچ.امتیاز تابعی(اپن سرچ.تطبیق("summary"، "kings")، فهرست(اپن سرچ.ضریب مقدار فیلد("sales"، 1.2، "log1p")، "")، "sum"، "multiply")

    سرچاپ "geo:"
    سرچاپ "  "، اپن سرچ.فاصله جغرافیایی("shop"، 35.6892، 51.389، "10km")
    سرچاپ "  "، اپن سرچ.کادر جغرافیایی("shop"، 35.8، 51.2، 35.6، 51.6)

    سرچاپ "vectors:"
    ناپایا ز := وکتور {} برگردان وکتور<اعشار۶۴>
    ز.بیفزا(0.12)
    ز.بیفزا(-0.5)
    ز.بیفزا(0.9)
    سرچاپ "  "، اپن سرچ.بردار همسایه‌یابی(ز)
    سرچاپ "  "، اپن سرچ.نزدیک‌ترین همسایه‌ها("embedding"، ز، 10)
    سرچاپ "  "، اپن سرچ.نزدیک‌ترین همسایه‌های پالایش شده("embedding"، ز، 10، اپن سرچ.واژه("genre"، "epic"))
    سرچاپ "  "، اپن سرچ.همسایه‌های شعاعی("embedding"، ز، 0.4)
    سرچاپ "  "، اپن سرچ.همسایه‌ها با کمینه امتیاز("embedding"، ز، 0.75)
    سرچاپ "  "، اپن سرچ.عصبی("embedding"، "stories of ancient kings"، "m-31"، 5)
    سرچاپ "  "، اپن سرچ.عصبی پراکنده("sparse"، "stories of ancient kings"، "m-32")
    سرچاپ "  "، اپن سرچ.ترکیبی(فهرست(اپن سرچ.تطبیق("summary"، "kings")، اپن سرچ.عصبی("embedding"، "kings"، "m-31"، 5)))

    سرچاپ "sorting, highlighting, suggesters:"
    سرچاپ "  "، اپن سرچ.مرتب صعودی("year")، اپن سرچ.مرتب نزولی("sales")، اپن سرچ.مرتب‌سازی امتیازی()
    سرچاپ "  "، اپن سرچ.مرتب‌سازی مکانی("shop"، 35.6892، 51.389، "km")
    سرچاپ "  "، اپن سرچ.برجسته‌سازی(فهرست("title"، "summary"))
    سرچاپ "  "، اپن سرچ.برجسته‌سازی با برچسب(فهرست("summary"، "")، "<mark>"، "</mark>")
    سرچاپ "  "، اپن سرچ.ادغام فیلدی("author")
    سرچاپ "  "، اپن سرچ.پیشنهاد واژه("fix"، "shahname"، "title")
    سرچاپ "  "، اپن سرچ.پیشنهاد تکمیل("auto"، "shah"، "title.complete"، 5)

    سرچاپ "json helpers:"
    سرچاپ "  "، اپن سرچ.افزودن عضو(`{"size":0}`، "query"، اپن سرچ.تطبیق همه())
    سرچاپ "  "، اپن سرچ.افزودن عضو(""، "track_total_hits"، "true")
    سرچاپ "  "، اپن سرچ.مسیر جیسون(`{"a":{"b":[10,{"c":"deep"}]}}`، "a.b.1.c")، اپن سرچ.مسیر جیسون(`{"a":{"b":[10]}}`، "a.b.0")
    سرچاپ "  "، اپن سرچ.مسیر خام جیسون(`{"a":{"b":[10,{"c":"deep"}]}}`، "a.b")، اپن سرچ.مسیر جیسون(`{"a":1}`، "nope").طول()
    سرچاپ "  "، اپن سرچ.اقلام جیسون(`[1, "two", {"three": 3}, null]`).طول()

    سرچاپ "search bodies:"
    ناپایا درخواست := اپن سرچ.درخواست جستجو { query = اپن سرچ.پرسمان منطقی ساخته(ب)، from = 20، size = 10، track_total_hits = "true" }
    درخواست.sort.بیفزا(اپن سرچ.مرتب نزولی("sales"))
    درخواست.sort.بیفزا(اپن سرچ.مرتب‌سازی امتیازی())
    درخواست.source.بیفزا("title")
    درخواست.source.بیفزا("author")
    درخواست.source_excludes.بیفزا("summary")
    درخواست.fields.بیفزا("published")
    درخواست.docvalue_fields.بیفزا("year")
    درخواست.highlight = اپن سرچ.برجسته‌سازی(فهرست("summary"، ""))
    درخواست.post_filter = اپن سرچ.واژه("in_print"، "true")
    درخواست.collapse = اپن سرچ.ادغام فیلدی("author")
    درخواست.suggest = اپن سرچ.پیشنهاد واژه("fix"، "shahname"، "title")
    درخواست.rescore = `{"window_size":50,"query":{"rescore_query":{"match_phrase":{"summary":"kings"}}}}`
    درخواست.script_fields = `{"double_price":{"script":{"source":"doc['price'].value * 2"}}}`
    درخواست.min_score = "0.5"
    درخواست.timeout = "2s"
    درخواست.track_scores = درست
    درخواست.explain = درست
    درخواست.version = درست
    درخواست.seq_no_primary_term = درست
    درخواست.ext = `{"generative_qa_parameters":{"llm_question":"Who wrote it?"}}`
    درخواست.extra.بیفزا(`"profile":true`)
    سرچاپ اپن سرچ.بدنه جستجو(درخواست)
    پسین := اپن سرچ.درخواست جستجو { query = اپن سرچ.تطبیق همه()، size = 100، search_after = `[1700000000000,"b42"]`، pit_id = "46ToAwMDaWR4"، pit_keep_alive = "2m"، track_total_hits = "10000" }
    سرچاپ اپن سرچ.بدنه جستجو(پسین)
    سرچاپ اپن سرچ.بدنه جستجو(اپن سرچ.درخواست جستجو { no_source = درست، size = 0، track_total_hits = "false" })
    سرچاپ اپن سرچ.بدنه جستجو(اپن سرچ.درخواست جستجو {})
پایان
