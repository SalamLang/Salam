واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19925

تابع فهرست(الف: رشته، ب: رشته): وکتور<رشته>:
    ناپایا ز := وکتور {} برگردان وکتور<رشته>
    ز.بیفزا(الف)
    اگر ب.طول() > 0: ز.بیفزا(ب) پایان
    برگشت ز
پایان

تابع نمایش یافته‌ها(برچسب: رشته، ر: اپن سرچ.نتیجه جستجو):
    سرچاپ برچسب + ":"، ر.موفق، ر.وضعیت، ر.زمان اجرا، ر.مهلت تمام شد، ر.کل، ر.نسبت کل، ر.بیشترین امتیاز، ر.نتایج.طول()
    اگر وارونه ر.موفق: سرچاپ "  error:"، ر.خطا پایان
    هر ه در ر.نتایج:
        سرچاپ "  hit:"، ه.نمایه، ه.شناسه، ه.امتیاز، ه.منبع
        اگر ه.مرتب‌سازی.طول() > 0: سرچاپ "    sort:"، ه.مرتب‌سازی پایان
        اگر ه.برجسته‌سازی.طول() > 0: سرچاپ "    highlight:"، ه.برجسته‌سازی پایان
        اگر ه.فیلدها.طول() > 0: سرچاپ "    fields:"، ه.فیلدها پایان
        اگر ه.پرسمان‌های منطبق.طول() > 0: سرچاپ "    matched:"، ه.پرسمان‌های منطبق پایان
        اگر ه.نتایج درونی.طول() > 0: سرچاپ "    inner hits:"، ه.نتایج درونی پایان
    پایان
پایان

تابع ریشه:
    صفحه۱ := `{"_scroll_id":"DXF1ZXJ5QW5kRmV0Y2gBAA","took":3,"timed_out":false,"hits":{"total":{"value":3,"relation":"eq"},"max_score":1.0,"hits":[{"_index":"books","_id":"1","_score":1.0,"_source":{"title":"Shahnameh"},"sort":[1010]},{"_index":"books","_id":"2","_score":1.0,"_source":{"title":"Masnavi"},"sort":[1258]}]}}`
    صفحه۲ := `{"_scroll_id":"DXF1ZXJ5QW5kRmV0Y2gBAA","took":1,"timed_out":false,"hits":{"total":{"value":3,"relation":"eq"},"max_score":1.0,"hits":[{"_index":"books","_id":"3","_score":1.0,"_source":{"title":"Golestan"},"sort":[1259]}]}}`
    خالی := `{"_scroll_id":"DXF1ZXJ5QW5kRmV0Y2gBAA","took":1,"timed_out":false,"hits":{"total":{"value":3,"relation":"eq"},"max_score":null,"hits":[]}}`
    جعلی.ثبت پاسخ("POST"، "/books/_search"، 200، `{"took":5,"timed_out":false,"_shards":{"total":1,"successful":1,"skipped":0,"failed":0},"hits":{"total":{"value":2,"relation":"eq"},"max_score":2.31,"hits":[{"_index":"books","_id":"1","_score":2.31,"_source":{"title":"Shahnameh","author":"Ferdowsi"},"highlight":{"title":["<em>Shahnameh</em>"]},"fields":{"year":[1010]},"matched_queries":["by_title"]},{"_index":"books","_id":"7","_score":0.42,"_source":{"title":"Shahnameh for children"},"inner_hits":{"reviews":{"hits":{"total":{"value":0,"relation":"eq"},"hits":[]}}}}]},"suggest":{"fix":[{"text":"shahname","offset":0,"length":8,"options":[{"text":"shahnameh","score":0.875,"freq":12}]}]}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_search"، 200، صفحه۱)
    جعلی.ثبت پاسخ("POST"، "/books/_search"، 400، `{"error":{"root_cause":[{"type":"parsing_exception","reason":"unknown query [nope]"}],"type":"parsing_exception","reason":"unknown query [nope]"},"status":400}`)
    جعلی.ثبت پاسخ("POST"، "/books,articles/_search"، 200، `{"took":2,"timed_out":false,"hits":{"total":{"value":10000,"relation":"gte"},"max_score":1.0,"hits":[]}}`)
    جعلی.ثبت پاسخ("POST"، "/_search"، 200، `{"took":1,"timed_out":false,"hits":{"total":{"value":5,"relation":"eq"},"max_score":1.0,"hits":[]}}`)
    جعلی.ثبت پاسخ("POST"، "/_search/scroll"، 200، صفحه۲)
    جعلی.ثبت پاسخ("POST"، "/_search/scroll"، 200، خالی)
    جعلی.ثبت پاسخ("DELETE"، "/_search/scroll"، 200، `{"succeeded":true,"num_freed":1}`)
    جعلی.ثبت پاسخ("POST"، "/books/_search/point_in_time"، 200، `{"pit_id":"o463QQEKYm9va3MWX1BhQjQ","_shards":{"total":1,"successful":1,"skipped":0,"failed":0},"creation_time":1760000000000}`)
    جعلی.ثبت پاسخ("POST"، "/_search"، 200، `{"pit_id":"o463QQEKYm9va3MWX1BhQjQ","took":2,"timed_out":false,"hits":{"total":{"value":2,"relation":"eq"},"max_score":null,"hits":[{"_index":"books","_id":"1","_score":null,"_source":{"title":"Shahnameh"},"sort":[1010,0]},{"_index":"books","_id":"2","_score":null,"_source":{"title":"Masnavi"},"sort":[1258,1]}]}}`)
    جعلی.ثبت پاسخ("POST"، "/_search"، 200، `{"pit_id":"o463QQEKYm9va3MWX1BhQjQ","took":1,"timed_out":false,"hits":{"total":{"value":2,"relation":"eq"},"max_score":null,"hits":[]}}`)
    جعلی.ثبت پاسخ("GET"، "/_search/point_in_time/_all"، 200، `{"pits":[{"pit_id":"o463QQEKYm9va3MWX1BhQjQ","creation_time":1760000000000,"keep_alive":120000}]}`)
    جعلی.ثبت پاسخ("DELETE"، "/_search/point_in_time"، 200، `{"pits":[{"successful":true,"pit_id":"o463QQEKYm9va3MWX1BhQjQ"}]}`)
    جعلی.ثبت پاسخ("DELETE"، "/_search/point_in_time/_all"، 200، `{"pits":[]}`)
    جعلی.ثبت پاسخ("POST"، "/_msearch"، 200، `{"took":4,"responses":[{"took":2,"timed_out":false,"hits":{"total":{"value":12,"relation":"eq"},"max_score":null,"hits":[]},"status":200},{"error":{"root_cause":[{"type":"index_not_found_exception","reason":"no such index [nope]"}],"type":"index_not_found_exception","reason":"no such index [nope]"},"status":404}]}`)
    جعلی.ثبت پاسخ("POST"، "/books/_search/template"، 200، `{"took":1,"timed_out":false,"hits":{"total":{"value":4,"relation":"eq"},"max_score":1.0,"hits":[]}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_search/template"، 200، `{"took":1,"timed_out":false,"hits":{"total":{"value":9,"relation":"eq"},"max_score":1.0,"hits":[]}}`)
    جعلی.ثبت پاسخ("POST"، "/_render/template"، 200، `{"template_output":{"query":{"term":{"author":"Saadi"}}}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_explain/1"، 200، `{"_index":"books","_id":"1","matched":true,"explanation":{"value":2.31,"description":"weight(title:shahnameh in 0)","details":[]}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_validate/query"، 200، `{"_shards":{"total":1,"successful":1,"failed":0},"valid":true}`)
    جعلی.ثبت پاسخ("POST"، "/books/_validate/query"، 200، `{"_shards":{"total":1,"successful":1,"failed":0},"valid":false}`)
    جعلی.ثبت پاسخ("GET"، "/books/_field_caps"، 200، `{"indices":["books"],"fields":{"title":{"text":{"type":"text","searchable":true,"aggregatable":false}},"year":{"long":{"type":"long","searchable":true,"aggregatable":true}}}}`)
    جعلی.ثبت پاسخ("POST"، "/books/_search"، 200، `{"took":1,"timed_out":false,"hits":{"total":{"value":1,"relation":"eq"},"max_score":1.0,"hits":[]}}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19925")

    ناپایا درخواست := اپن سرچ.درخواست جستجو { پرسمان = `{"match":{"title":{"query":"shahname","_name":"by_title"}}}`، اندازه = 5 }
    درخواست.برجسته‌سازی = اپن سرچ.برجسته‌سازی(فهرست("title"، ""))
    درخواست.فیلدها.بیفزا("year")
    درخواست.پیشنهاد‌ها = اپن سرچ.پیشنهاد واژه("fix"، "shahname"، "title")
    ر := اپن سرچ.جستجو با درخواست(ک، "books"، درخواست)
    سرچاپ "sent:"، جعلی.آخرین درخواست()
    نمایش یافته‌ها("search"، ر)
    سرچاپ "did you mean:"، اپن سرچ.پیشنهادها(ر.پیشنهاد‌ها، "fix")
    سرچاپ "raw response bytes:"، ر.خام.طول() > 100

    ناپایا نخست := اپن سرچ.درخواست جستجو { پرسمان = اپن سرچ.تطبیق همه()، اندازه = 2 }
    نخست.مرتب‌سازی.بیفزا(اپن سرچ.مرتب صعودی("year"))
    ناپایا صفحه := اپن سرچ.جستجوی پیمایشی(ک، "books"، نخست، "1m")
    سرچاپ "scroll start sent:"، جعلی.آخرین درخواست()
    ناپایا دیده‌شده := 0
    تا صفحه.نتایج.طول() > 0:
        هر ه در صفحه.نتایج:
            سرچاپ "  scrolled:"، ه.شناسه، ه.منبع
        پایان
        دیده‌شده += صفحه.نتایج.طول()
        صفحه = اپن سرچ.پیمایش(ک، صفحه.شناسه پیمایش، "1m")
    پایان
    سرچاپ "scroll total:"، دیده‌شده، "last sent:"، جعلی.آخرین درخواست()
    سرچاپ "clear scroll:"، اپن سرچ.پاک‌سازی پیمایش(ک، صفحه.شناسه پیمایش)
    سرچاپ "  sent:"، جعلی.آخرین درخواست()

    خراب := اپن سرچ.جستجوی خام(ک، "books"، `{"query":{"nope":{}}}`)
    نمایش یافته‌ها("bad query"، خراب)
    سرچاپ "error type:"، اپن سرچ.نوع خطا(ک)
    نمایش یافته‌ها("two indices"، اپن سرچ.جستجو(ک، "books,articles"، اپن سرچ.تطبیق همه()))
    نمایش یافته‌ها("every index"، اپن سرچ.جستجو(ک، ""، اپن سرچ.تطبیق همه()))

    نقطه := اپن سرچ.ایجاد نقطه زمانی(ک، "books"، "2m")
    سرچاپ "pit:"، نقطه، "sent:"، جعلی.آخرین درخواست()
    ناپایا درخواست نقطه := اپن سرچ.درخواست جستجو { پرسمان = اپن سرچ.تطبیق همه()، اندازه = 2، شناسه نقطه زمانی = نقطه، زنده‌ماندن نقطه زمانی = "2m" }
    درخواست نقطه.مرتب‌سازی.بیفزا(اپن سرچ.مرتب صعودی("year"))
    ناپایا صفحه نقطه := اپن سرچ.جستجو با درخواست(ک، "books"، درخواست نقطه)
    سرچاپ "pit search sent:"، جعلی.آخرین درخواست()
    تا صفحه نقطه.نتایج.طول() > 0:
        هر ه در صفحه نقطه.نتایج:
            سرچاپ "  pit hit:"، ه.شناسه، ه.مرتب‌سازی
        پایان
        درخواست نقطه.ادامه پس از = صفحه نقطه.نتایج.بگیر(صفحه نقطه.نتایج.طول() - 1).مرتب‌سازی
        صفحه نقطه = اپن سرچ.جستجو با درخواست(ک، "books"، درخواست نقطه)
    پایان
    سرچاپ "next page asked with:"، جعلی.آخرین درخواست()
    سرچاپ "open pits:"، اپن سرچ.فهرست نقطه‌های زمانی(ک)
    سرچاپ "delete pit:"، اپن سرچ.حذف نقطه زمانی(ک، نقطه)، جعلی.آخرین درخواست()
    سرچاپ "delete all pits:"، اپن سرچ.حذف همه نقطه‌های زمانی(ک)

    ناپایا بدنه‌ها := وکتور {} برگردان وکتور<رشته>
    بدنه‌ها.بیفزا(`{"query":{"term":{"author":"Saadi"}},"size":0}`)
    بدنه‌ها.بیفزا("{\n  \"size\": 0\n}")
    هر م در اپن سرچ.جستجوی چندگانه(ک، "books"، بدنه‌ها):
        سرچاپ "msearch:"، م.موفق، م.وضعیت، م.کل، م.خطا
    پایان
    سرچاپ "  sent:"، جعلی.آخرین درخواست()

    نمایش یافته‌ها("stored template"، اپن سرچ.جستجوی الگو(ک، "books"، "by_author"، `{"author":"Saadi"}`))
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    نمایش یافته‌ها("inline template"، اپن سرچ.جستجوی الگوی درون‌خطی(ک، "books"، `{"query":{"term":{"author":"{{author}}"}}}`، `{"author":"Saadi"}`))
    سرچاپ "rendered:"، اپن سرچ.نمایش الگو(ک، `{"query":{"term":{"author":"{{author}}"}}}`، `{"author":"Saadi"}`)
    سرچاپ "explain:"، اپن سرچ.توضیح امتیاز(ک، "books"، "1"، اپن سرچ.تطبیق("title"، "shahnameh"))
    سرچاپ "valid:"، اپن سرچ.اعتبارسنجی پرسمان(ک، "books"، اپن سرچ.تطبیق همه())، اپن سرچ.اعتبارسنجی پرسمان(ک، "books"، `{"nope":{}}`)
    سرچاپ "field caps:"، اپن سرچ.توانایی فیلدها(ک، "books"، فهرست("title"، "year"))
    سرچاپ "  sent:"، جعلی.آخرین درخواست()

    پ := اپن سرچ.پارامترهای جستجو {
        مسیریابی = "poetry"، ترجیح = "_local"، خط لوله جستجو = "rerank"، نوع جستجو = "dfs_query_then_fetch"،
        حافظه نهان درخواست = "true"، اجازه نتیجه ناقص = "false"، نادیده گرفتن ناموجود = درست
    }
    نمایش یافته‌ها("with url settings"، اپن سرچ.جستجو با پارامتر(ک، "books"، `{"size":0}`، پ))
    سرچاپ "  sent:"، جعلی.آخرین درخواست()

    تجزیه‌شده := اپن سرچ.تجزیه جستجو(`{"took":7,"hits":{"total":42,"max_score":0.5,"hits":[{"_id":"old","_score":0.5,"_source":{}}]}}`)
    نمایش یافته‌ها("old style total"، تجزیه‌شده)
    برگشت 0
پایان
