واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19931

تابع ریشه:
    جعلی.ثبت پاسخ("GET"، "/_plugins/_security/authinfo"، 200، `{"user":"User [name=admin, backend_roles=[admin], requestedTenant=null]","user_name":"admin","backend_roles":["admin"],"roles":["own_index","all_access"],"tenants":{"global_tenant":true,"admin_tenant":true,"admin":true}}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_security/authinfo"، 401، "Unauthorized")
    جعلی.ثبت پاسخ("GET"، "/_plugins/_security/health"، 200، `{"message":null,"mode":"strict","status":"UP"}`)
    جعلی.ثبت پاسخ("PUT"، "/_plugins/_security/api/roles/books_reader"، 201، `{"status":"CREATED","message":"'books_reader' created."}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_security/api/roles/books_reader"، 200، `{"books_reader":{"reserved":false,"cluster_permissions":["cluster_composite_ops_ro"],"index_permissions":[{"index_patterns":["books*"],"allowed_actions":["read"]}]}}`)
    جعلی.ثبت پاسخ("PUT"، "/_plugins/_security/api/internalusers/maryam"، 201، `{"status":"CREATED","message":"'maryam' created."}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_security/api/internalusers/maryam"، 200، `{"maryam":{"hash":"","reserved":false,"backend_roles":["librarian"],"attributes":{"team":"catalog"}}}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_security/api/internalusers"، 200، `{"admin":{"reserved":true},"maryam":{"reserved":false},"reader":{"reserved":false}}`)
    جعلی.ثبت پاسخ("PUT"، "/_plugins/_security/api/rolesmapping/books_reader"، 201، `{"status":"CREATED","message":"'books_reader' created."}`)
    جعلی.ثبت پاسخ("GET"، "/_plugins/_security/api/rolesmapping/books_reader"، 200، `{"books_reader":{"users":["maryam"],"backend_roles":["librarian"]}}`)
    جعلی.ثبت پاسخ("PUT"، "/_plugins/_security/api/account"، 200، `{"status":"OK","message":"'maryam' updated."}`)
    جعلی.ثبت پاسخ("PUT"، "/_plugins/_security/api/account"، 403، `{"status":"FORBIDDEN","message":"Could not validate your current password."}`)
    جعلی.ثبت پاسخ("DELETE"، "/_plugins/_security/api/rolesmapping/books_reader"، 200، `{"status":"OK","message":"'books_reader' deleted."}`)
    جعلی.ثبت پاسخ("DELETE"، "/_plugins/_security/api/internalusers/maryam"، 200، `{"status":"OK","message":"'maryam' deleted."}`)
    جعلی.ثبت پاسخ("DELETE"، "/_plugins/_security/api/roles/books_reader"، 200، `{"status":"OK","message":"'books_reader' deleted."}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال با رمز("http://127.0.0.1:19931"، "admin"، "Admin-Pass-1!")

    من := اپن سرچ.من کیستم(ک)
    سرچاپ "who am i:"، من.ok، من.user، من.roles، من.backend_roles، من.tenants
    ناشناس := اپن سرچ.من کیستم(ک)
    سرچاپ "wrong password:"، ناشناس.ok، ناشناس.error
    سرچاپ "plugin status:"، اپن سرچ.سلامت امنیت(ک)

    ناپایا مجوزهای خوشه := وکتور {} برگردان وکتور<رشته>
    مجوزهای خوشه.بیفزا("cluster_composite_ops_ro")
    ناپایا نمایه‌ها := وکتور {} برگردان وکتور<رشته>
    نمایه‌ها.بیفزا("books*")
    ناپایا کنش‌ها := وکتور {} برگردان وکتور<رشته>
    کنش‌ها.بیفزا("read")
    نقش := اپن سرچ.بدنه نقش(مجوزهای خوشه، نمایه‌ها، کنش‌ها)
    سرچاپ "role body:"، نقش
    سرچاپ "role:"، اپن سرچ.تنظیم نقش(ک، "books_reader"، نقش)، اپن سرچ.مسیر جیسون(اپن سرچ.دریافت نقش(ک، "books_reader")، "index_permissions.0.index_patterns.0")

    ناپایا پشتیبان := وکتور {} برگردان وکتور<رشته>
    پشتیبان.بیفزا("librarian")
    سرچاپ "user:"، اپن سرچ.تنظیم کاربر(ک، "maryam"، "Strong-Pass-1!"، پشتیبان، `{"team":"catalog"}`)
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "  stored:"، اپن سرچ.دریافت کاربر(ک، "maryam")
    سرچاپ "users:"، اپن سرچ.کاربران(ک)
    ناپایا کاربران := وکتور {} برگردان وکتور<رشته>
    کاربران.بیفزا("maryam")
    سرچاپ "mapping:"، اپن سرچ.تنظیم نگاشت نقش(ک، "books_reader"، کاربران، پشتیبان)
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "  stored:"، اپن سرچ.دریافت نگاشت نقش(ک، "books_reader")
    سرچاپ "change password:"، اپن سرچ.تغییر گذرواژه(ک، "Strong-Pass-1!"، "Stronger-Pass-2!")
    سرچاپ "  sent:"، جعلی.آخرین درخواست()
    سرچاپ "wrong current password:"، اپن سرچ.تغییر گذرواژه(ک، "guess"، "x")، اپن سرچ.وضعیت(ک)، اپن سرچ.خطا(ک)
    سرچاپ "cleanup:"، اپن سرچ.حذف نگاشت نقش(ک، "books_reader")، اپن سرچ.حذف کاربر(ک، "maryam")، اپن سرچ.حذف نقش(ک، "books_reader")
    برگشت 0
پایان
