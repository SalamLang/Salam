واردسازی دیتابیس.اپن سرچ

تابع نمایش(سرآیندهای امضا: رشته):
    هر خط در سرآیندهای امضا.بشکاف("\r\n"):
        اگر خط.طول() > 0: سرچاپ "  " + خط پایان
    پایان
پایان

تابع ریشه:
    سرچاپ "AWS reference request (GET /, no body):"
    نمایش(اپن سرچ.امضای درخواست آمازون(
        "GET"، "example.amazonaws.com"، "/"، ""، "us-east-1"، "service"،
        "AKIDEXAMPLE"، "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"، ""، 1440938160 برگردان صحیح۶۴
    ))
    سرچاپ "search on a domain, with a query string, a body and a session token:"
    نمایش(اپن سرچ.امضای درخواست آمازون(
        "POST"، "search-books.eu-west-1.es.amazonaws.com"، "/books/_search?size=5&q=title:shah"، `{"query":{"match_all":{}}}`،
        "eu-west-1"، اپن سرچ.سرویس دامنه، "AKIDEXAMPLE"، "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"، "SESSIONTOKEN"، 1700000000 برگردان صحیح۶۴
    ))
    سرچاپ "serverless collection:"
    نمایش(اپن سرچ.امضای درخواست آمازون(
        "PUT"، "abc123.eu-west-1.aoss.amazonaws.com"، "/books/_doc/1"، `{"title":"Shahnameh"}`،
        "eu-west-1"، اپن سرچ.سرویس بی‌سرور، "AKIDEXAMPLE"، "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY"، ""، 1700000000 برگردان صحیح۶۴
    ))
پایان
