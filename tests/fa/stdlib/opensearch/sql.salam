واردسازی دیتابیس
واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

پایا درگاه := 19928

تابع شمار ردیف‌ها(ک: پویا دیتابیس.اتصال، پرس‌وجو: رشته): صحیح:
    برگشت دیتابیس.پرسمان عدد(ک، پرس‌وجو)
پایان

تابع ریشه:
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 200، `{"schema":[{"name":"COUNT(*)","type":"long"}],"datarows":[[42]],"total":1,"size":1,"status":200}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 200، `{"schema":[{"name":"title","type":"text"},{"name":"year","type":"integer"},{"name":"price","type":"double"},{"name":"in_print","type":"boolean"}],"datarows":[["Shahnameh",1010,24.5,true],["Masnavi",1258,null,false]],"total":2,"size":2,"status":200}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 200، `{"schema":[{"name":"author","type":"keyword"},{"name":"COUNT(*)","alias":"books","type":"long"}],"datarows":[["Ferdowsi",1],["Rumi",3]],"total":2,"size":2,"cursor":"d:CURSOR1","status":200}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 200، `{"datarows":[["Saadi",2]],"cursor":"d:CURSOR2","status":200}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 200، `{"datarows":[["Hafez",4]],"status":200}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 200، `{"schema":[{"name":"title","type":"text"}],"datarows":[["Golestan"]],"total":1,"size":1,"cursor":"d:CURSOR9","status":200}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql/close"، 200، `{"succeeded":true}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 404، `{"error":{"reason":"Error occurred in OpenSearch engine: no such index [nowhere]","details":"[nowhere] IndexNotFoundException","type":"IndexNotFoundException"},"status":404}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 200، `{"schema":[{"name":"deleted_rows","type":"long"}],"datarows":[[5]],"total":1,"size":1,"status":200}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql/_explain"، 200، `{"root":{"name":"ProjectOperator","children":[{"name":"OpenSearchIndexScan"}]}}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ppl"، 200، `{"schema":[{"name":"count()","type":"integer"},{"name":"genre","type":"string"}],"datarows":[[3,"epic"],[5,"lyric"]],"total":2,"size":2}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ppl/_explain"، 200، `{"root":{"name":"ProjectOperator"}}`)
    اگر وارونه جعلی.آغاز(درگاه):
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    ک := اپن سرچ.اتصال("http://127.0.0.1:19928")
    رابط := اپن سرچ.اتصال عمومی(ک)
    سرچاپ "kind:"، رابط.نوع()، رابط.نوع() == دیتابیس.اپن سرچ، رابط.معتبر()
    سرچاپ "count:"، شمار ردیف‌ها(رابط، "SELECT COUNT(*) FROM books")
    سرچاپ "  sent:"، جعلی.آخرین درخواست()

    ردیف‌ها := رابط.پرسمان("SELECT title, year, price, in_print FROM books ORDER BY year")
    سرچاپ "columns:"، ردیف‌ها.تعداد ستون()، ردیف‌ها.نام ستون(0)، ردیف‌ها.نام ستون(1)، ردیف‌ها.نام ستون(2)، ردیف‌ها.نام ستون(3)
    تا ردیف‌ها.بعدی():
        سرچاپ "  row:"، ردیف‌ها.متن(0)، ردیف‌ها.عدد صحیح(1)، ردیف‌ها.عدد صحیح۶۴(1)، ردیف‌ها.عدد اعشار(2)، ردیف‌ها.خالی است(2)، ردیف‌ها.عدد صحیح(3)
        سرچاپ "    types:"، ردیف‌ها.نوع ستون(0)، ردیف‌ها.نوع ستون(1)، ردیف‌ها.نوع ستون(2)، ردیف‌ها.نوع ستون(3)
    پایان
    ردیف‌ها.بستن()
    سرچاپ "type constants:"، دیتابیس.نوع خالی، دیتابیس.نوع صحیح، دیتابیس.نوع اعشاری، دیتابیس.نوع متن

    ناپایا صفحه‌بندی‌شده := اپن سرچ.اس کیو ال با پارامتر(ک، "SELECT author, COUNT(*) AS books FROM books GROUP BY author"، وکتور {} برگردان وکتور<رشته>، 2)
    سرچاپ "paged sent:"، جعلی.آخرین درخواست()
    سرچاپ "paged:"، صفحه‌بندی‌شده.معتبر()، صفحه‌بندی‌شده.مجموع()، صفحه‌بندی‌شده.نام ستون(1)، صفحه‌بندی‌شده.نام نوع ستون(1)
    تا صفحه‌بندی‌شده.بعدی():
        سرچاپ "  author:"، صفحه‌بندی‌شده.متن(0)، صفحه‌بندی‌شده.عدد صحیح(1)، صفحه‌بندی‌شده.خام(0)
    پایان
    سرچاپ "  next page asked with:"، جعلی.آخرین درخواست()
    صفحه‌بندی‌شده.بستن()

    ناپایا پارامترها := وکتور {} برگردان وکتور<رشته>
    پارامترها.بیفزا(اپن سرچ.پارامتر اس کیو ال("integer"، "1200"))
    پارامترها.بیفزا(اپن سرچ.پارامتر اس کیو ال("string"، "Saadi"))
    ناپایا زودهنگام := اپن سرچ.اس کیو ال با پارامتر(ک، "SELECT title FROM books WHERE year > ? AND author = ?"، پارامترها، 1)
    سرچاپ "parameters sent:"، جعلی.آخرین درخواست()
    زودهنگام.بعدی()
    سرچاپ "  first:"، زودهنگام.متن(0)
    زودهنگام.بستن()
    سرچاپ "  closed the cursor:"، جعلی.آخرین درخواست()

    خراب := رابط.پرسمان("SELECT nope FROM nowhere")
    سرچاپ "bad query:"، خراب.معتبر()، رابط.خطا()
    خراب.بستن()
    سرچاپ "delete:"، رابط.اجرا("DELETE FROM books WHERE stock = 0")، رابط.تعداد تغییرات()
    سرچاپ "update refused:"، رابط.اجرا("UPDATE books SET stock = 1")، رابط.خطا()
    تراکنش := رابط.شروع تراکنش()
    سرچاپ "transactions:"، تراکنش.معتبر()، تراکنش.اجرا("SELECT 1")، تراکنش.ثبت تراکنش()، تراکنش.بازگردانی()، تراکنش.پرسمان("SELECT 1").معتبر()، رابط.خطا()
    سرچاپ "quote:"، رابط.نقل قول("Kalila o Dimna's")، "last id:"، رابط.شناسه آخرین درج()
    سرچاپ "explain:"، اپن سرچ.توضیح اس کیو ال(ک، "SELECT title FROM books")

    پ := اپن سرچ.پی پی ال(ک، "source=books | where year > 1000 | stats count() by genre")
    سرچاپ "ppl sent:"، جعلی.آخرین درخواست()
    تا پ.بعدی():
        سرچاپ "  ppl:"، پ.عدد صحیح(0)، پ.متن(1)
    پایان
    پ.بستن()
    سرچاپ "ppl explain:"، اپن سرچ.توضیح پی پی ال(ک، "source=books | fields title")
    برگشت 0
پایان
