واردسازی دیتابیس.اپن سرچ

فراخوانی جعلی "_fake.salam"

ناپایا درگاه := 0

تابع ریشه:
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 200، `title,year\nShahnameh,1010\n`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_sql"، 500، `{"error":"boom"}`)
    جعلی.ثبت پاسخ("POST"، "/_plugins/_ppl"، 200، `{"schema":[{"name":"genre","type":"string"}],"datarows":[["epic"]]}`)
    درگاه = جعلی.آغاز آزاد()
    اگر درگاه برابر 0:
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    c := اپن سرچ.اتصال("http://127.0.0.1:" + درگاه)

    سرچاپ اپن سرچ.اس کیو ال با قالب(c، "SELECT title, year FROM books"، "csv")
    سرچاپ "sql sent:"، جعلی.آخرین درخواست()
    سرچاپ "failed:"، اپن سرچ.اس کیو ال با قالب(c، "SELECT 1"، "json").طول()

    سرچاپ اپن سرچ.پی پی ال با قالب(c، "source=books | fields genre"، "jdbc")
    سرچاپ "ppl sent:"، جعلی.آخرین درخواست()
    برگشت 0
پایان
