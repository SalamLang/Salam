بسته ریشه

واردسازی سیستم پرونده.مسیر
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    پوشه := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_os_api_test")
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه)
    پرونده := مسیر.پیوند(پوشه، "data.txt")
    ورودی خروجی.نوشتن پرونده(پرونده، "twelve bytes")
    سرچاپ "file size: "، سیستم عامل.اندازه پرونده(پرونده)
    سرچاپ "missing size: "، سیستم عامل.اندازه پرونده(مسیر.پیوند(پوشه، "absent.txt"))
    ورودی خروجی.نوشتن پرونده(پرونده، "")
    سرچاپ "empty size: "، سیستم عامل.اندازه پرونده(پرونده)
    ورودی خروجی.نوشتن پرونده(پرونده، "twelve bytes")

    پوشه آغازین := سیستم عامل.پوشه جاری()
    سرچاپ "chdir into dir: "، سیستم عامل.تغییر پوشه(پوشه)
    سرچاپ "relative file visible: "، سیستم عامل.وجود دارد("data.txt")
    سرچاپ "relative size: "، سیستم عامل.اندازه پرونده("data.txt")
    سرچاپ "cwd changed: "، سیستم عامل.پوشه جاری() نابرابر پوشه آغازین
    سرچاپ "chdir back: "، سیستم عامل.تغییر پوشه(پوشه آغازین)
    سرچاپ "cwd restored: "، سیستم عامل.پوشه جاری() برابر پوشه آغازین
    سرچاپ "relative file gone: "، سیستم عامل.وجود دارد("data.txt")
    سرچاپ "chdir missing: "، سیستم عامل.تغییر پوشه(مسیر.پیوند(پوشه، "absent")) نابرابر 0
    سرچاپ "cwd unchanged after failure: "، سیستم عامل.پوشه جاری() برابر پوشه آغازین

    شناسه فرآیند := فرآیند.انشعاب()
    اگر شناسه فرآیند برابر 0:
        سیستم عامل.توقف ناگهانی()
    پایان
    اگر شناسه فرآیند کوچکتر 0:
        سرچاپ "fork unavailable"
    وگرنه:
        سرچاپ "abort status: "، فرآیند.انتظار شناسه(شناسه فرآیند)
    پایان
    سیستم عامل.حذف همه(پوشه)
    برگشت 0
پایان
