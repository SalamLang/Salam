بسته ریشه

واردسازی سیستم پرونده.مسیر
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    dir := مسیر.پیوند(سیستم عامل.پوشه موقت()، "salam_os_api_test")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    file := مسیر.پیوند(dir، "data.txt")
    ورودی خروجی.نوشتن پرونده(file، "twelve bytes")
    سرچاپ "file size: "، سیستم عامل.اندازه پرونده(file)
    سرچاپ "missing size: "، سیستم عامل.اندازه پرونده(مسیر.پیوند(dir، "absent.txt"))
    ورودی خروجی.نوشتن پرونده(file، "")
    سرچاپ "empty size: "، سیستم عامل.اندازه پرونده(file)
    ورودی خروجی.نوشتن پرونده(file، "twelve bytes")

    start := سیستم عامل.پوشه جاری()
    سرچاپ "chdir into dir: "، سیستم عامل.تغییر پوشه(dir)
    سرچاپ "relative file visible: "، سیستم عامل.وجود دارد("data.txt")
    سرچاپ "relative size: "، سیستم عامل.اندازه پرونده("data.txt")
    سرچاپ "cwd changed: "، سیستم عامل.پوشه جاری() نابرابر start
    سرچاپ "chdir back: "، سیستم عامل.تغییر پوشه(start)
    سرچاپ "cwd restored: "، سیستم عامل.پوشه جاری() برابر start
    سرچاپ "relative file gone: "، سیستم عامل.وجود دارد("data.txt")
    سرچاپ "chdir missing: "، سیستم عامل.تغییر پوشه(مسیر.پیوند(dir، "absent")) نابرابر 0
    سرچاپ "cwd unchanged after failure: "، سیستم عامل.پوشه جاری() برابر start

    pid := فرآیند.انشعاب()
    اگر pid برابر 0:
        سیستم عامل.توقف ناگهانی()
    پایان
    اگر pid کوچکتر 0:
        سرچاپ "fork unavailable"
    وگرنه:
        سرچاپ "abort status: "، فرآیند.انتظار شناسه(pid)
    پایان
    سیستم عامل.حذف همه(dir)
    برگشت 0
پایان
