// lang: fa
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

اگر SALAM_OS_WINDOWS:
    پایا PATH_SEP := "\\"
    پایا NULL_DEV := "NUL"
    پایا SO_EXT := ".dll"
وگرنه SALAM_OS_MAC:
    پایا PATH_SEP := "/"
    پایا NULL_DEV := "/dev/null"
    پایا SO_EXT := ".dylib"
وگرنه SALAM_OS_UNIX:
    پایا PATH_SEP := "/"
    پایا NULL_DEV := "/dev/null"
    پایا SO_EXT := ".so"
وگرنه:
    پایا PATH_SEP := "/"
    پایا NULL_DEV := "/dev/null"
    پایا SO_EXT := ".so"
پایان

روال ریشه:
    ترابرد SALAM_OS:
        "windows":
            سرچاپ "Running on Windows"
            بشکن
        پایان
        "mac":
            سرچاپ "Running on macOS"
            بشکن
        پایان
        "linux":
            سرچاپ "Running on Linux"
            بشکن
        پایان
        "freebsd":
            سرچاپ "Running on FreeBSD"
            بشکن
        پایان
        "android":
            سرچاپ "Running on Android"
            بشکن
        پایان
        "wasm":
            سرچاپ "Running on WebAssembly"
            بشکن
        پایان
        وگرنه:
            سرچاپ "Running on an unknown OS"
        پایان
    پایان
    ترابرد SALAM_OS:
        "windows"، "mac"، "linux":
            سرچاپ "OS string: " + SALAM_OS
            بشکن
        پایان
    پایان
    ترابرد SALAM_ARCH:
        "x64":
            سرچاپ "Architecture: x86-64"
            بشکن
        پایان
        "arm64":
            سرچاپ "Architecture: AArch64"
            بشکن
        پایان
        "x86":
            سرچاپ "Architecture: x86 (32-bit)"
            بشکن
        پایان
        "arm":
            سرچاپ "Architecture: ARM (32-bit)"
            بشکن
        پایان
        "wasm":
            سرچاپ "Architecture: WebAssembly"
            بشکن
        پایان
    پایان
    اگر SALAM_ARCH == "x64":
        سرچاپ "64-bit x86 confirmed"
    پایان
    اگر SALAM_OS_UNIX:
        سرچاپ "POSIX-compatible system"
    پایان
    اگر وارونه SALAM_OS_WINDOWS:
        سرچاپ "not Windows"
    پایان
    سرچاپ "Path separator:"، PATH_SEP
    سرچاپ "Shared-library extension:"، SO_EXT
پایان
