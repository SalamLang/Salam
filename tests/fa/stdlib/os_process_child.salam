بسته ریشه

واردسازی سیستم عامل.فرآیند

تابع sh(script: رشته): فرآیند.فرمان:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان(script)
    برگشت cmd
پایان

تابع show(label: رشته، st: فرآیند.وضعیت):
    سرچاپ label، "exited"، st.خارج شد، "code"، st.کد، "signaled"، st.سیگنال خورد، "signal"، st.سیگنال، "timed_out"، st.مهلت تمام شد
پایان

تابع echo_round_trip():
    ناپایا cmd := فرآیند.فرمان تازه("cat")
    cmd.همه لوله()
    ناپایا ch := فرآیند.اجرای فرزند(cmd)
    سرچاپ "started"، ch.راه افتاد، ch.شناسه بزرگتر 0
    سرچاپ "write"، ch.نوشتن("alpha\nbeta\n")
    a := ch.خواندن خط(5000)
    سرچاپ "line"، a.داده، a.طول، a.پایان، a.مهلت تمام شد
    b := ch.خواندن خط(5000)
    سرچاپ "line"، b.داده، b.طول
    c := ch.خواندن خط(100)
    سرچاپ "idle"، c.مهلت تمام شد، c.پایان
    سرچاپ "running"، ch.در حال اجرا()
    ch.بستن ورودی()
    d := ch.خواندن خط(5000)
    سرچاپ "eof"، d.پایان، d.طول
    st := ch.انتظار(5000)
    show("cat"، st)
    سرچاپ "poll after"، ch.در حال اجرا()، ch.تمام شده
    a.آزادسازی()
    b.آزادسازی()
    c.آزادسازی()
    d.آزادسازی()
    ch.بستن()
    cmd.آزادسازی()
پایان

تابع two_streams():
    ناپایا cmd := sh("echo to-out; echo to-err 1>&2; exit 0")
    cmd.حالت خروجی = فرآیند.لوله
    cmd.حالت خطا = فرآیند.لوله
    ناپایا ch := فرآیند.اجرای فرزند(cmd)
    o := ch.خواندن خط(5000)
    e := ch.خواندن خط خطا(5000)
    سرچاپ "out:"، o.داده، "err:"، e.داده
    show("two"، ch.انتظار(5000))
    o.آزادسازی()
    e.آزادسازی()
    ch.بستن()
    cmd.آزادسازی()

    ناپایا mc := sh("echo one; echo two 1>&2")
    mc.حالت خروجی = فرآیند.لوله
    mc.حالت خطا = فرآیند.ادغام
    ناپایا mh := فرآیند.اجرای فرزند(mc)
    all := mh.خواندن به مدت(3000)
    سرچاپ "merged bytes"، all.طول
    show("merge"، mh.انتظار(5000))
    all.آزادسازی()
    mh.بستن()
    mc.آزادسازی()
پایان

تابع exit_and_signals():
    ناپایا c3 := sh("exit 3")
    ناپایا h3 := فرآیند.اجرای فرزند(c3)
    s3 := h3.انتظار(5000)
    show("exit3"، s3)
    سرچاپ "success"، s3.موفق()، "return code"، s3.کد بازگشت()
    h3.بستن()
    c3.آزادسازی()

    ناپایا ck := sh("exec sleep 30")
    ناپایا hk := فرآیند.اجرای فرزند(ck)
    سرچاپ "kill sent"، hk.کشتن()
    sk := hk.انتظار(5000)
    show("kill"، sk)
    سرچاپ "return code"، sk.کد بازگشت()
    hk.بستن()
    ck.آزادسازی()

    ناپایا ct := sh("exec sleep 30")
    ناپایا ht := فرآیند.اجرای فرزند(ct)
    سرچاپ "term sent"، ht.پایان دادن()
    show("term"، ht.انتظار(5000))
    ht.بستن()
    ct.آزادسازی()

    ناپایا cs := sh("exec sleep 30")
    ناپایا hs := فرآیند.اجرای فرزند(cs)
    سرچاپ "signal sent"، hs.فرستادن سیگنال(فرآیند.سیگنال وقفه)
    show("int"، hs.انتظار(5000))
    hs.بستن()
    cs.آزادسازی()
پایان

تابع wait_timeout():
    ناپایا cmd := sh("exec sleep 30")
    ناپایا ch := فرآیند.اجرای فرزند(cmd)
    st := ch.انتظار(150)
    show("waiting"، st)
    سرچاپ "still running"، ch.در حال اجرا()، ch.تمام شده
    _k := ch.کشتن()
    show("after kill"، ch.انتظار(5000))
    again := ch.انتظار(0)
    سرچاپ "second wait"، again.سیگنال خورد، again.سیگنال
    ch.بستن()
    cmd.آزادسازی()
پایان

تابع env_and_cwd():
    ناپایا cmd := sh("echo $GREETING; echo ${DROPPED-unset}; pwd")
    cmd.تنظیم محیط("GREETING"، "salam")
    cmd.حذف محیط("DROPPED")
    cmd.پوشه کاری = "/"
    cmd.حالت خروجی = فرآیند.لوله
    ناپایا ch := فرآیند.اجرای فرزند(cmd)
    a := ch.خواندن خط(5000)
    b := ch.خواندن خط(5000)
    c := ch.خواندن خط(5000)
    سرچاپ a.داده، b.داده، c.داده
    show("env"، ch.انتظار(5000))
    a.آزادسازی()
    b.آزادسازی()
    c.آزادسازی()
    ch.بستن()
    cmd.آزادسازی()

    ناپایا empty := sh("echo ${GREETING-gone}:${HOME-nohome}")
    empty.محیط خالی = درست
    empty.تنظیم محیط("PATH"، "/usr/bin:/bin")
    empty.حالت خروجی = فرآیند.لوله
    ناپایا eh := فرآیند.اجرای فرزند(empty)
    r := eh.خواندن خط(5000)
    سرچاپ r.داده
    r.آزادسازی()
    _es := eh.انتظار(5000)
    eh.بستن()
    empty.آزادسازی()
پایان

تابع null_and_missing():
    ناپایا cmd := sh("echo hidden; echo hidden 1>&2; cat")
    cmd.حالت ورودی = فرآیند.تهی
    cmd.حالت خروجی = فرآیند.تهی
    cmd.حالت خطا = فرآیند.تهی
    ناپایا ch := فرآیند.اجرای فرزند(cmd)
    show("null"، ch.انتظار(5000))
    سرچاپ "write to none"، ch.نوشتن("x")
    ch.بستن()
    cmd.آزادسازی()

    ناپایا bad := فرآیند.فرمان تازه("definitely-not-a-program-here")
    bh := فرآیند.اجرای فرزند(bad)
    سرچاپ "missing"، bh.راه افتاد، bh.خطا
    bad.آزادسازی()

    ناپایا cd := sh("true")
    cd.پوشه کاری = "/definitely/not/a/folder"
    dh := فرآیند.اجرای فرزند(cd)
    سرچاپ "bad cwd"، dh.راه افتاد، dh.خطا
    cd.آزادسازی()
پایان

تابع reads():
    ناپایا cmd := sh("printf 'abcdefghij'; sleep 0.3; printf 'KLM:rest\\n'")
    cmd.حالت خروجی = فرآیند.لوله
    ناپایا ch := فرآیند.اجرای فرزند(cmd)
    a := ch.خواندن تعداد(4، 5000)
    سرچاپ "read4"، a.داده، a.طول
    b := ch.خواندن برای متن(":"، 5000)
    سرچاپ "until"، b.داده، b.طول
    c := ch.خواندن موجود(5000)
    سرچاپ "rest"، c.طول، c.پایان
    d := ch.خواندن موجود(5000)
    سرچاپ "end"، d.پایان، d.طول
    a.آزادسازی()
    b.آزادسازی()
    c.آزادسازی()
    d.آزادسازی()
    show("reads"، ch.انتظار(5000))
    ch.بستن()
    cmd.آزادسازی()
پایان

تابع group_kill():
    ناپایا cmd := sh("sleep 30 & sleep 30 & wait")
    cmd.گروه تازه = درست
    cmd.حالت خروجی = فرآیند.لوله
    ناپایا ch := فرآیند.اجرای فرزند(cmd)
    سرچاپ "group killed"، ch.کشتن گروه()
    show("group"، ch.انتظار(5000))
    tail := ch.خواندن موجود(5000)
    سرچاپ "pipe closed"، tail.پایان
    tail.آزادسازی()
    ch.بستن()
    cmd.آزادسازی()
پایان

تابع ریشه:
    اگر سلام سیستم ویندوز:
        سرچاپ "skipped on Windows"
        برگشت 0
    پایان
    echo_round_trip()
    two_streams()
    exit_and_signals()
    wait_timeout()
    env_and_cwd()
    null_and_missing()
    reads()
    group_kill()
    برگشت 0
پایان
