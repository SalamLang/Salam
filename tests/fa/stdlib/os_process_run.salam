بسته ریشه

واردسازی حافظه
واردسازی رشته
واردسازی سیستم عامل.فرآیند

تابع args2(a: رشته، b: رشته): وکتور<رشته>:
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.بیفزا(a)
    v.بیفزا(b)
    برگشت v
پایان

تابع show(label: رشته، r: فرآیند.نتیجه اجرا):
    سرچاپ label، "started"، r.راه افتاد، "exited"، r.وضعیت.خارج شد، "code"، r.وضعیت.کد، "signaled"، r.وضعیت.سیگنال خورد، "signal"، r.وضعیت.سیگنال، "timed_out"، r.مهلت تمام شد
پایان

تابع ریشه:
    اگر سلام سیستم ویندوز:
        سرچاپ "skipped on Windows"
        برگشت 0
    پایان

    a1 := args2("-c"، "echo out; echo err 1>&2; exit 3")
    ناپایا r1 := فرآیند.اجرا با مهلت("sh"، a1، ""، 5000)
    show("basic"، r1)
    سرچاپ "stdout"، r1.خروجی.طول()، "stderr"، r1.خروجی خطا.طول()
    r1.آزادسازی()
    a1.آزادکن()

    a2 := args2("-c"، "tr a-z A-Z")
    ناپایا r2 := فرآیند.اجرا با مهلت("sh"، a2، "shout this\n"، 5000)
    show("filter"، r2)
    سرچاپ "reply"، r2.خروجی
    r2.آزادسازی()
    a2.آزادکن()

    a3 := args2("-c"، "head -c 1048576 /dev/zero | tr '\\0' 'x'; head -c 1048576 /dev/zero | tr '\\0' 'y' 1>&2")
    ناپایا r3 := فرآیند.اجرا با مهلت("sh"، a3، ""، 20000)
    show("big"، r3)
    سرچاپ "stdout bytes"، r3.خروجی.طول()، "stderr bytes"، r3.خروجی خطا.طول()
    r3.آزادسازی()
    a3.آزادکن()

    ناپایا big := فرآیند.فرمان تازه("cat")
    ناپایا sb := رشته.سازنده()
    تکرار 2000:
        رشته.افزودن به بافر(sb، "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef\n")
    پایان
    text := رشته.رشته بافر(sb)
    رشته.آزادسازی بافر(sb)
    ناپایا r4 := فرآیند.اجرای فرمان با مهلت(big، text، 20000)
    show("echo"، r4)
    سرچاپ "round trip bytes"، r4.خروجی.طول()، r4.خروجی برابر text
    r4.آزادسازی()
    big.آزادسازی()
    حافظه.آزادسازی(text برگردان تهی*)

    a5 := args2("-c"، "echo before; sleep 30; echo after")
    ناپایا r5 := فرآیند.اجرا با مهلت("sh"، a5، ""، 400)
    show("timeout"، r5)
    سرچاپ "partial"، r5.خروجی
    سرچاپ "return code"، r5.وضعیت.کد بازگشت()
    r5.آزادسازی()
    a5.آزادکن()

    ناپایا r6 := فرآیند.اجرا با مهلت("definitely-not-a-program-here"، وکتور {} برگردان وکتور<رشته>، ""، 1000)
    show("missing"، r6)
    r6.آزادسازی()

    a7 := args2("-c"، "echo $MARK")
    ناپایا c7 := فرآیند.فرمان تازه("sh")
    c7.آرگومان ها = a7
    c7.تنظیم محیط("MARK"، "set")
    ناپایا r7 := فرآیند.اجرای فرمان با مهلت(c7، ""، 5000)
    show("command"، r7)
    سرچاپ "text"، r7.خروجی
    r7.آزادسازی()
    c7.آزادسازی()
    برگشت 0
پایان
