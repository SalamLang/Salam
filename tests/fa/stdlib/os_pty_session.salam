بسته ریشه

واردسازی حافظه
واردسازی رشته
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع shell(script: رشته): فرآیند.فرمان:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان(script)
    cmd.تنظیم محیط("TERM"، "xterm")
    برگشت cmd
پایان

تابع visible(text: رشته): رشته:
    first := رشته.جایگزینی(text، "\r"، "\\r")
    out := رشته.جایگزینی(first، "\n"، "\\n")
    حافظه.آزادسازی(first برگردان تهی*)
    برگشت out
پایان

تابع window_size():
    ناپایا cmd := shell("stty size; echo $TERM")
    ناپایا ch := پایانه مجازی.باز کردن(cmd، 30، 100)
    سرچاپ "opened"، ch.راه افتاد
    r := ch.خواندن به مدت(1500)
    v := visible(r.داده)
    سرچاپ v
    حافظه.آزادسازی(v برگردان تهی*)
    r.آزادسازی()
    سرچاپ "exit"، ch.انتظار(5000).کد
    ch.بستن()
    cmd.آزادسازی()
پایان

تابع echo_and_enter():
    ناپایا cmd := shell("cat")
    ناپایا ch := پایانه مجازی.باز کردن(cmd، 24، 80)
    سرچاپ "write"، ch.نوشتن("typed text\r")
    r := ch.خواندن برای متن("typed text\r\n"، 5000)
    v := visible(r.داده)
    سرچاپ "echoed"، v، r.مهلت تمام شد
    حافظه.آزادسازی(v برگردان تهی*)
    r.آزادسازی()
    r2 := ch.خواندن برای متن("typed text\r\n"، 5000)
    v2 := visible(r2.داده)
    سرچاپ "answer"، v2، r2.مهلت تمام شد
    حافظه.آزادسازی(v2 برگردان تهی*)
    r2.آزادسازی()
    ch.بستن ورودی()
    st := ch.انتظار(5000)
    سرچاپ "ended"، st.خارج شد، st.کد
    ch.بستن()
    cmd.آزادسازی()
پایان

تابع raw_mode():
    ناپایا cmd := shell("stty raw -echo; printf 'ready\\n'; dd bs=1 count=2 2>/dev/null | od -An -c")
    ناپایا ch := پایانه مجازی.باز کردن(cmd، 24، 80)
    w := ch.خواندن برای متن("ready"، 5000)
    سرچاپ "prompt"، w.مهلت تمام شد
    w.آزادسازی()
    سرچاپ "typed"، ch.نوشتن("a\r")
    r := ch.خواندن برای متن("\\r"، 5000)
    v := visible(r.داده)
    سرچاپ "seen"، v، r.مهلت تمام شد
    حافظه.آزادسازی(v برگردان تهی*)
    r.آزادسازی()
    سرچاپ "exit"، ch.انتظار(5000).کد
    ch.بستن()
    cmd.آزادسازی()
پایان

تابع resizing():
    ناپایا cmd := shell("read line; stty size")
    ناپایا ch := پایانه مجازی.باز کردن(cmd، 10، 20)
    before := پایانه مجازی.گرفتن اندازه(ch)
    سرچاپ "before"، before.سطرها، before.ستون ها
    سرچاپ "resize"، پایانه مجازی.تغییر اندازه(ch، 33، 120)
    after := پایانه مجازی.گرفتن اندازه(ch)
    سرچاپ "after"، after.سطرها، after.ستون ها
    ch.نوشتن("go\r")
    r := ch.خواندن برای متن("33 120"، 5000)
    سرچاپ "child sees"، r.مهلت تمام شد
    r.آزادسازی()
    سرچاپ "exit"، ch.انتظار(5000).کد
    ch.بستن()
    cmd.آزادسازی()
پایان

تابع hangup_and_missing():
    ناپایا cmd := shell("exec sleep 30")
    ناپایا ch := پایانه مجازی.باز کردن(cmd، 24، 80)
    سرچاپ "kill"، ch.کشتن()
    st := ch.انتظار(5000)
    سرچاپ "signaled"، st.سیگنال خورد، st.سیگنال
    gone := ch.خواندن موجود(2000)
    سرچاپ "eof"، gone.پایان
    gone.آزادسازی()
    ch.بستن()
    cmd.آزادسازی()

    ناپایا bad := فرآیند.فرمان تازه("definitely-not-a-program-here")
    bh := پایانه مجازی.باز کردن(bad، 24، 80)
    سرچاپ "missing"، bh.راه افتاد، bh.خطا
    bad.آزادسازی()
پایان

تابع ریشه:
    اگر سلام سیستم ویندوز:
        سرچاپ "pty supported"، پایانه مجازی.پشتیبانی می شود()
    وگرنه:
        سرچاپ "pty supported"، پایانه مجازی.پشتیبانی می شود()
        window_size()
        echo_and_enter()
        raw_mode()
        resizing()
        hangup_and_missing()
        برگشت 0
    پایان
پایان
