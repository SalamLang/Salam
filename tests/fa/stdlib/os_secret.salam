// زبان: فارسی
واردسازی رشته
واردسازی سیستم عامل
واردسازی سیستم عامل.راز

تابع ریشه:
    ناپایا نتیجه := درست
    کلید := "probe-" + رشته.از عدد(سیستم عامل.شناسه فرآیند() برگردان صحیح۶۴) + "-fa"
    اگر راز.در دسترس() و راز.گذاشتن("salam.test.secret"، کلید، "first value"):
        نتیجه = راز.گرفتن("salam.test.secret"، کلید) برابر "first value"
        نتیجه = نتیجه و راز.پاک کردن("salam.test.secret"، کلید)
    پایان
    سرچاپ "round trip"، نتیجه
    سرچاپ "missing"، راز.گرفتن("salam.test.secret"، کلید + "-missing").طول()
    سرچاپ "delete missing"، راز.پاک کردن("salam.test.secret"، کلید + "-missing")
پایان
