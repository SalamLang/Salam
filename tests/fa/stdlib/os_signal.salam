واردسازی آزمایش
واردسازی حافظه
واردسازی سیستم عامل.سیگنال

درون‌داد:
    تابع sigaction(sig: صحیح، act: تهی*، old: تهی*): صحیح
پایان

ناپایا _thread_hits := 0

تابع watcher(set: تهی*):
    اگر سیگنال.انتظار تغییر اندازه(set) برابر سیگنال.سیگنال تغییر اندازه:
        _thread_hits++
    پایان
پایان

تابع noop_one(_sig: صحیح):
    _ := _sig
پایان

تابع noop_two(_sig: صحیح):
    _ := _sig
پایان

تابع live_handler(sig: صحیح): طبیعی۶۴:
    buf := حافظه.تخصیص صفرشده(256 برگردان طبیعی۶۴)
    اگر buf برابر پوچ: برگشت 0 پایان
    _ := sigaction(sig، پوچ، buf)
    handler := (buf برگردان طبیعی۶۴*)[0]
    حافظه.آزادسازی(buf)
    برگشت handler
پایان

تابع test_supported():
    آزمایش.ادعای درستی(سیگنال.تغییر اندازه پشتیبانی می شود())
پایان

تابع test_install_restore():
    before := سیگنال.ماسک فعلی()
    آزمایش.ادعای خالی نبودن(before)
    prev1 := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_one)
    آزمایش.ادعای خالی نبودن(prev1)
    prev2 := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_two)
    آزمایش.ادعای درستی(prev2 برابر پوچ)
    آزمایش.ادعای درستی(live_handler(سیگنال.سیگنال تغییر اندازه) برابر (&noop_one) برگردان طبیعی۶۴)
    prev3 := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_one)
    آزمایش.ادعای خالی نبودن(prev3)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، prev3))
    held := سیگنال.ماسک فعلی()
    آزمایش.ادعای درستی(سیگنال.عضو مجموعه است(held، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای درستی(live_handler(سیگنال.سیگنال تغییر اندازه) برابر (&noop_one) برگردان طبیعی۶۴)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، prev1))
    after := سیگنال.ماسک فعلی()
    آزمایش.ادعای برابری منطقی(سیگنال.عضو مجموعه است(after، سیگنال.سیگنال تغییر اندازه)، سیگنال.عضو مجموعه است(before، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای برابری عدد۶۴(live_handler(سیگنال.سیگنال تغییر اندازه) برگردان صحیح۶۴، 0)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، prev1))
    حافظه.آزادسازی(held)
    حافظه.آزادسازی(after)
    حافظه.آزادسازی(prev3)
    حافظه.آزادسازی(prev1)
    حافظه.آزادسازی(before)
پایان

تابع test_blocked_self_signal_is_consumed():
    سیگنال.نصب گرداننده تغییر اندازه()
    set := سیگنال.مجموعه تغییر اندازه جدید()
    آزمایش.ادعای درستی(set نابرابر پوچ)
    سیگنال.مسدود کردن تغییر اندازه()
    سیگنال.بیدار کردن تغییر اندازه()
    آزمایش.ادعای برابری عدد(سیگنال.انتظار تغییر اندازه(set)، سیگنال.سیگنال تغییر اندازه)
    آزمایش.ادعای برابری عدد(سیگنال.انتظار تغییر اندازه(پوچ)، سیگنال.نتیجه نامعتبر)
    حافظه.آزادسازی(set)
پایان

تابع test_thread_inherits_mask():
    سیگنال.نصب گرداننده تغییر اندازه()
    سیگنال.مسدود کردن تغییر اندازه()
    set := سیگنال.مجموعه تغییر اندازه جدید()
    h := نخ‌ساز(watcher، set)
    سیگنال.بیدار کردن تغییر اندازه()
    نخ‌پیوند(h)
    آزمایش.ادعای برابری عدد(_thread_hits، 1)
    حافظه.آزادسازی(set)
پایان

تابع test_set_membership():
    set := سیگنال.مجموعه جدید()
    آزمایش.ادعای درستی(set نابرابر پوچ)
    آزمایش.ادعای درستی(وارونه سیگنال.افزودن سیگنال(set، 0))
    _ := سیگنال.افزودن سیگنال(set، سیگنال.سیگنال تغییر اندازه)
    _ := سیگنال.افزودن سیگنال(set، 15)
    آزمایش.ادعای درستی(سیگنال.عضو مجموعه است(set، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای درستی(سیگنال.عضو مجموعه است(set، 15))
    آزمایش.ادعای درستی(وارونه سیگنال.عضو مجموعه است(set، 1))
    آزمایش.ادعای درستی(سیگنال.حذف سیگنال(set، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای درستی(وارونه سیگنال.عضو مجموعه است(set، سیگنال.سیگنال تغییر اندازه))
    حافظه.آزادسازی(set)
پایان

تابع test_windows_stubs():
    آزمایش.ادعای نادرستی(سیگنال.تغییر اندازه پشتیبانی می شود())
    آزمایش.ادعای خالی بودن(سیگنال.مجموعه جدید())
    آزمایش.ادعای خالی بودن(سیگنال.مجموعه تغییر اندازه جدید())
    آزمایش.ادعای خالی بودن(سیگنال.نصب گرداننده تغییر اندازه())
    آزمایش.ادعای برابری عدد(سیگنال.انتظار تغییر اندازه(پوچ)، 0)
    آزمایش.ادعای نادرستی(سیگنال.مسدود کردن تغییر اندازه())
    آزمایش.ادعای نادرستی(سیگنال.بیدار کردن تغییر اندازه())
پایان

تابع ریشه:
    اگر سلام سیستم ویندوز:
        test_windows_stubs()
        برگشت آزمایش.خلاصه()
    وگرنه:
        test_supported()
        test_install_restore()
        test_blocked_self_signal_is_consumed()
        test_thread_inherits_mask()
        test_set_membership()
        برگشت آزمایش.خلاصه()
    پایان
پایان
