واردسازی آزمایش
واردسازی حافظه
واردسازی همگام سازی
واردسازی سیستم عامل.سیگنال

تابع test_numbers():
    آزمایش.ادعای برابری عدد(سیگنال.سیگنال وقفه، 2)
    آزمایش.ادعای برابری عدد(سیگنال.سیگنال خاتمه، 15)
    آزمایش.ادعای برابری عدد(سیگنال.سیگنال کشتن، 9)
    آزمایش.ادعای برابری عدد(سیگنال.سیگنال اندازه پنجره، سیگنال.سیگنال تغییر اندازه)
    آزمایش.ادعای درستی(سیگنال.سیگنال کاربر۱ نابرابر سیگنال.سیگنال کاربر۲)
پایان

تابع test_raise_and_wait():
    set := سیگنال.مجموعه جدید()
    دیرکن حافظه.آزادسازی(set)
    آزمایش.ادعای درستی(سیگنال.افزودن سیگنال(set، سیگنال.سیگنال کاربر۱))
    آزمایش.ادعای درستی(سیگنال.افزودن سیگنال(set، سیگنال.سیگنال خاتمه))
    آزمایش.ادعای درستی(سیگنال.مسدود کردن(set))
    آزمایش.ادعای درستی(سیگنال.فرستادن به خود(سیگنال.سیگنال کاربر۱))
    آزمایش.ادعای برابری عدد(سیگنال.انتظار سیگنال(set)، سیگنال.سیگنال کاربر۱)
    آزمایش.ادعای درستی(سیگنال.فرستادن به خود(سیگنال.سیگنال خاتمه))
    آزمایش.ادعای برابری عدد(سیگنال.انتظار سیگنال(set)، سیگنال.سیگنال خاتمه)
    آزمایش.ادعای درستی(سیگنال.رفع انسداد(set))
پایان

تابع test_invalid():
    آزمایش.ادعای برابری عدد(سیگنال.انتظار سیگنال(پوچ)، سیگنال.نتیجه نامعتبر)
    آزمایش.ادعای نادرستی(سیگنال.فرستادن به خود(0))
    آزمایش.ادعای نادرستی(سیگنال.فرستادن به خود(-1))
پایان

تابع test_fill_and_set_mask():
    all := سیگنال.مجموعه جدید()
    سیگنال.پر کردن مجموعه(all)
    آزمایش.ادعای درستی(سیگنال.عضو مجموعه است(all، سیگنال.سیگنال خاتمه))
    saved := سیگنال.ماسک فعلی()
    آزمایش.ادعای درستی(سیگنال.تنظیم ماسک(saved))
    حافظه.آزادسازی(saved)
    حافظه.آزادسازی(all)
پایان

تابع noop(_s: صحیح):
    _ := _s
پایان

تابع test_timed_wait_lasts():
    prev := سیگنال.نصب(سیگنال.سیگنال کاربر۲، &noop)
    آزمایش.ادعای خالی نبودن(prev)
    set := سیگنال.مجموعه جدید()
    آزمایش.ادعای درستی(سیگنال.افزودن سیگنال(set، سیگنال.سیگنال کاربر۲))
    out := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    t0 := همگام سازی.اکنون میلی ثانیه()
    آزمایش.ادعای برابری عدد(سیگنال.انتظار با مهلت(set، out، 300)، سیگنال.نتیجه اتمام مهلت)
    آزمایش.ادعای درستی(همگام سازی.اکنون میلی ثانیه() - t0 بزرگتربرابر 250)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(set)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال کاربر۲، prev))
    حافظه.آزادسازی(prev)
پایان

تابع test_windows_stubs():
    آزمایش.ادعای برابری عدد(سیگنال.انتظار سیگنال(پوچ)، سیگنال.نتیجه نامعتبر)
    آزمایش.ادعای نادرستی(سیگنال.فرستادن به خود(سیگنال.سیگنال وقفه))
پایان

تابع ریشه:
    اگر سلام سیستم ویندوز:
        test_windows_stubs()
        برگشت آزمایش.خلاصه()
    وگرنه:
        test_numbers()
        test_raise_and_wait()
        test_invalid()
        test_timed_wait_lasts()
        test_fill_and_set_mask()
        برگشت آزمایش.خلاصه()
    پایان
پایان
