واردسازی آزمایش
واردسازی حافظه
واردسازی سیستم عامل.سیگنال

ناپایا _child_blocked := نادرست

تابع blocker():
    set := سیگنال.مجموعه تغییر اندازه جدید()
    اگر set برابر پوچ: برگشت پایان
    _ := سیگنال.مسدود کردن(set)
    حافظه.آزادسازی(set)
    mask := سیگنال.ماسک فعلی()
    _child_blocked = سیگنال.عضو مجموعه است(mask، سیگنال.سیگنال تغییر اندازه)
    حافظه.آزادسازی(mask)
پایان

تابع test_mask_is_per_thread():
    before := سیگنال.ماسک فعلی()
    آزمایش.ادعای خالی نبودن(before)
    نخ‌پیوند(نخ‌ساز(blocker))
    آزمایش.ادعای درستی(_child_blocked)
    after := سیگنال.ماسک فعلی()
    آزمایش.ادعای خالی نبودن(after)
    آزمایش.ادعای درستی(وارونه سیگنال.عضو مجموعه است(after، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای برابری منطقی(سیگنال.عضو مجموعه است(after، سیگنال.سیگنال تغییر اندازه)، سیگنال.عضو مجموعه است(before، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای برابری منطقی(سیگنال.عضو مجموعه است(after، 15)، سیگنال.عضو مجموعه است(before، 15))
    حافظه.آزادسازی(after)
    حافظه.آزادسازی(before)
پایان

تابع ریشه:
    اگر سلام سیستم ویندوز:
        سرچاپ "signals are POSIX only"
        برگشت 0
    وگرنه:
        test_mask_is_per_thread()
        برگشت آزمایش.خلاصه()
    پایان
پایان
