واردسازی آزمایش
واردسازی حافظه
واردسازی سیستم عامل.سیگنال

درون‌داد:
    تابع sigaction(sig: صحیح، act: تهی*، old: تهی*): صحیح
پایان

تابع noop_a(_sig: صحیح):
    _ := _sig
پایان

تابع noop_b(_sig: صحیح):
    _ := _sig
پایان

تابع live_handler(sig: صحیح): طبیعی۶۴:
    buf := حافظه.تخصیص صفرشده(256 برگردان طبیعی۶۴)
    اگر buf برابر پوچ: برگشت 0 پایان
    _ := sigaction(sig، پوچ، buf)
    handler := (buf برگردان طبیعی۶۴*)[0]
    حافظه.آزادسازی(buf)
    برگشت handler
پایان

تابع test_refcount_round_trip():
    before := سیگنال.ماسک فعلی()
    آزمایش.ادعای خالی نبودن(before)
    first := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_a)
    آزمایش.ادعای خالی نبودن(first)
    second := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_a)
    آزمایش.ادعای خالی نبودن(second)
    آزمایش.ادعای درستی(first نابرابر second)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، second))
    held := سیگنال.ماسک فعلی()
    آزمایش.ادعای درستی(سیگنال.عضو مجموعه است(held، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای درستی(live_handler(سیگنال.سیگنال تغییر اندازه) برابر (&noop_a) برگردان طبیعی۶۴)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، first))
    after := سیگنال.ماسک فعلی()
    آزمایش.ادعای برابری منطقی(
        سیگنال.عضو مجموعه است(after، سیگنال.سیگنال تغییر اندازه)، سیگنال.عضو مجموعه است(before، سیگنال.سیگنال تغییر اندازه)
    )
    آزمایش.ادعای برابری عدد۶۴(live_handler(سیگنال.سیگنال تغییر اندازه) برگردان صحیح۶۴، 0)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، first))
    حافظه.آزادسازی(held)
    حافظه.آزادسازی(after)
    حافظه.آزادسازی(second)
    حافظه.آزادسازی(first)
    حافظه.آزادسازی(before)
پایان

تابع test_restore_order_is_free():
    first := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_a)
    آزمایش.ادعای خالی نبودن(first)
    second := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_a)
    آزمایش.ادعای خالی نبودن(second)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، first))
    mid := سیگنال.ماسک فعلی()
    آزمایش.ادعای درستی(سیگنال.عضو مجموعه است(mid، سیگنال.سیگنال تغییر اندازه))
    حافظه.آزادسازی(mid)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، second))
    after := سیگنال.ماسک فعلی()
    آزمایش.ادعای درستی(وارونه سیگنال.عضو مجموعه است(after، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای برابری عدد۶۴(live_handler(سیگنال.سیگنال تغییر اندازه) برگردان صحیح۶۴، 0)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، second))
    again := سیگنال.ماسک فعلی()
    آزمایش.ادعای درستی(وارونه سیگنال.عضو مجموعه است(again، سیگنال.سیگنال تغییر اندازه))
    حافظه.آزادسازی(again)
    حافظه.آزادسازی(after)
    حافظه.آزادسازی(second)
    حافظه.آزادسازی(first)
پایان

تابع test_different_handler_refused():
    first := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_a)
    آزمایش.ادعای خالی نبودن(first)
    second := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_b)
    آزمایش.ادعای درستی(second برابر پوچ)
    آزمایش.ادعای درستی(live_handler(سیگنال.سیگنال تغییر اندازه) برابر (&noop_a) برگردان طبیعی۶۴)
    held := سیگنال.ماسک فعلی()
    آزمایش.ادعای درستی(سیگنال.عضو مجموعه است(held، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، first))
    after := سیگنال.ماسک فعلی()
    آزمایش.ادعای درستی(وارونه سیگنال.عضو مجموعه است(after، سیگنال.سیگنال تغییر اندازه))
    آزمایش.ادعای برابری عدد۶۴(live_handler(سیگنال.سیگنال تغییر اندازه) برگردان صحیح۶۴، 0)
    حافظه.آزادسازی(held)
    حافظه.آزادسازی(after)
    حافظه.آزادسازی(first)
پایان

تابع test_rebuild_after_zero():
    prev := سیگنال.نصب(سیگنال.سیگنال تغییر اندازه، &noop_a)
    آزمایش.ادعای خالی نبودن(prev)
    اگر prev برابر پوچ:
        برگشت
    پایان
    آزمایش.ادعای برابری عدد۶۴((prev برگردان طبیعی۶۴*)[0] برگردان صحیح۶۴، 0)
    آزمایش.ادعای درستی(سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، prev))
    mask := سیگنال.ماسک فعلی()
    آزمایش.ادعای درستی(وارونه سیگنال.عضو مجموعه است(mask، سیگنال.سیگنال تغییر اندازه))
    حافظه.آزادسازی(mask)
    حافظه.آزادسازی(prev)
پایان

تابع ریشه:
    اگر سلام سیستم ویندوز:
        سرچاپ "signals are POSIX only"
        برگشت 0
    وگرنه:
        test_refcount_round_trip()
        test_restore_order_is_free()
        test_different_handler_refused()
        test_rebuild_after_zero()
        برگشت آزمایش.خلاصه()
    پایان
پایان
