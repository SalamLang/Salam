واردسازی آزمایش
واردسازی حافظه
واردسازی زمان
واردسازی سیستم عامل.سیگنال

تابع raiser():
    start := زمان.نانوثانیه یکنواخت()
    ناپایا spin := 0
    تا زمان.نانوثانیه یکنواخت() - start کوچکتر (20000000 برگردان صحیح۶۴):
        spin++
    پایان
    _ := spin
    _ := سیگنال.بیدار کردن تغییر اندازه()
پایان

تابع test_timeout_expires():
    set := سیگنال.مجموعه تغییر اندازه جدید()
    آزمایش.ادعای خالی نبودن(set)
    out := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    آزمایش.ادعای خالی نبودن(out)
    start := زمان.نانوثانیه یکنواخت()
    status := سیگنال.انتظار با مهلت(set، out، 100)
    elapsed := زمان.از میلی ثانیه(start)
    آزمایش.ادعای برابری عدد(status، سیگنال.نتیجه اتمام مهلت)
    آزمایش.ادعای درستی(elapsed بزرگتربرابر 80.0)
    آزمایش.ادعای درستی(elapsed کوچکتر 5000.0)
    آزمایش.ادعای برابری عدد((out برگردان صحیح۳۲*)[0]، 0)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(set)
پایان

تابع test_arrival_inside_bound():
    set := سیگنال.مجموعه تغییر اندازه جدید()
    آزمایش.ادعای خالی نبودن(set)
    out := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    آزمایش.ادعای خالی نبودن(out)
    a := نخ‌ساز(raiser)
    start := زمان.نانوثانیه یکنواخت()
    status := سیگنال.انتظار با مهلت(set، out، 5000)
    elapsed := زمان.از میلی ثانیه(start)
    نخ‌پیوند(a)
    آزمایش.ادعای برابری عدد(status، سیگنال.نتیجه رسیدن)
    آزمایش.ادعای برابری عدد((out برگردان صحیح۳۲*)[0]، سیگنال.سیگنال تغییر اندازه)
    آزمایش.ادعای درستی(elapsed کوچکتر 4000.0)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(set)
پایان

تابع test_zero_is_a_probe():
    set := سیگنال.مجموعه تغییر اندازه جدید()
    آزمایش.ادعای خالی نبودن(set)
    out := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    آزمایش.ادعای خالی نبودن(out)
    (out برگردان صحیح۳۲*)[0] = 99
    آزمایش.ادعای برابری عدد(سیگنال.انتظار با مهلت(set، out، 0)، سیگنال.نتیجه اتمام مهلت)
    آزمایش.ادعای برابری عدد((out برگردان صحیح۳۲*)[0]، 99)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(set)
پایان

تابع test_negative_bound_is_invalid():
    set := سیگنال.مجموعه تغییر اندازه جدید()
    آزمایش.ادعای خالی نبودن(set)
    out := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    آزمایش.ادعای خالی نبودن(out)
    آزمایش.ادعای برابری عدد(سیگنال.انتظار با مهلت(set، out، -1)، سیگنال.نتیجه نامعتبر)
    آزمایش.ادعای برابری عدد((out برگردان صحیح۳۲*)[0]، 0)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(set)
پایان

تابع ریشه:
    اگر سلام سیستم ویندوز:
        سرچاپ "signals are POSIX only"
        برگشت 0
    وگرنه:
        سیگنال.نصب گرداننده تغییر اندازه()
        سیگنال.مسدود کردن تغییر اندازه()
        test_timeout_expires()
        test_arrival_inside_bound()
        test_zero_is_a_probe()
        test_negative_bound_is_invalid()
        برگشت آزمایش.خلاصه()
    پایان
پایان
