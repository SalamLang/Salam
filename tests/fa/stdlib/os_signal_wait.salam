واردسازی آزمایش
واردسازی حافظه
واردسازی سیستم عامل.سیگنال

ناپایا _busy_status := 99
ناپایا _arrived_status := 99

ناپایا _out_a := پوچ برگردان تهی*
ناپایا _out_b := پوچ برگردان تهی*

تابع raiser():
    _ := سیگنال.بیدار کردن تغییر اندازه()
پایان

تابع waiter(set: تهی*، out: تهی*):
    status := سیگنال.انتظار(set، out)
    اگر status برابر سیگنال.نتیجه مشغول:
        _busy_status = status
        _ := سیگنال.بیدار کردن تغییر اندازه()
    وگرنه:
        _arrived_status = status
    پایان
پایان

تابع waiter_a(set: تهی*):
    waiter(set، _out_a)
پایان

تابع waiter_b(set: تهی*):
    waiter(set، _out_b)
پایان

تابع test_three_raises_three_arrivals():
    سیگنال.نصب گرداننده تغییر اندازه()
    سیگنال.مسدود کردن تغییر اندازه()
    set := سیگنال.مجموعه تغییر اندازه جدید()
    آزمایش.ادعای خالی نبودن(set)
    out := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    آزمایش.ادعای خالی نبودن(out)
    ناپایا arrivals := 0
    ناپایا numbers_ok := درست
    ناپایا i := 0
    تا i کوچکتر 3:
        نخ‌پیوند(نخ‌ساز(raiser))
        اگر سیگنال.انتظار(set، out) برابر سیگنال.نتیجه رسیدن:
            arrivals++
            اگر (out برگردان صحیح۳۲*)[0] نابرابر سیگنال.سیگنال تغییر اندازه: numbers_ok = نادرست پایان
        پایان
        i++
    پایان
    آزمایش.ادعای برابری عدد(arrivals، 3)
    آزمایش.ادعای درستی(numbers_ok)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(set)
پایان

تابع test_invalid_arguments():
    set := سیگنال.مجموعه تغییر اندازه جدید()
    آزمایش.ادعای خالی نبودن(set)
    out := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    آزمایش.ادعای خالی نبودن(out)
    آزمایش.ادعای برابری عدد(سیگنال.انتظار(پوچ، out)، سیگنال.نتیجه نامعتبر)
    آزمایش.ادعای برابری عدد(سیگنال.انتظار(set، پوچ)، سیگنال.نتیجه نامعتبر)
    آزمایش.ادعای برابری عدد((out برگردان صحیح۳۲*)[0]، 0)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(set)
پایان

تابع test_second_waiter_is_busy():
    سیگنال.نصب گرداننده تغییر اندازه()
    سیگنال.مسدود کردن تغییر اندازه()
    set := سیگنال.مجموعه تغییر اندازه جدید()
    آزمایش.ادعای خالی نبودن(set)
    out_a := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    out_b := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    آزمایش.ادعای خالی نبودن(out_a)
    آزمایش.ادعای خالی نبودن(out_b)
    _out_a = out_a
    _out_b = out_b
    a := نخ‌ساز(waiter_a، set)
    b := نخ‌ساز(waiter_b، set)
    نخ‌پیوند(a)
    نخ‌پیوند(b)
    آزمایش.ادعای برابری عدد(_busy_status، سیگنال.نتیجه مشغول)
    آزمایش.ادعای برابری عدد(_arrived_status، سیگنال.نتیجه رسیدن)
    ناپایا numbers_ok := نادرست
    اگر (out_a برگردان صحیح۳۲*)[0] برابر سیگنال.سیگنال تغییر اندازه و (out_b برگردان صحیح۳۲*)[0] برابر 0:
        numbers_ok = درست
    پایان
    اگر (out_b برگردان صحیح۳۲*)[0] برابر سیگنال.سیگنال تغییر اندازه و (out_a برگردان صحیح۳۲*)[0] برابر 0:
        numbers_ok = درست
    پایان
    آزمایش.ادعای درستی(numbers_ok)
    حافظه.آزادسازی(out_a)
    حافظه.آزادسازی(out_b)
    حافظه.آزادسازی(set)
پایان

تابع ریشه:
    اگر سلام سیستم ویندوز:
        سرچاپ "signals are POSIX only"
        برگشت 0
    وگرنه:
        test_three_raises_three_arrivals()
        test_invalid_arguments()
        test_second_waiter_is_busy()
        برگشت آزمایش.خلاصه()
    پایان
پایان
