بسته ریشه

واردسازی محیط
واردسازی سیستم عامل
واردسازی آزمایش

تابع check(want: رشته):
    got := سیستم عامل.پوشه موقت()
    آزمایش.ادعای برابری رشته(got، want)
پایان

تابع ریشه:
    محیط.تنظیم("TEMP"، "")
    محیط.تنظیم("TMP"، "")
    محیط.تنظیم("TMPDIR"، "")
    check("/tmp")
    محیط.تنظیم("TMPDIR"، "/from/tmpdir")
    check("/from/tmpdir")
    محیط.تنظیم("TMP"، "/from/tmp")
    check("/from/tmp")
    محیط.تنظیم("TEMP"، "/from/temp")
    check("/from/temp")
    آزمایش.خلاصه()
پایان
