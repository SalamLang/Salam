واردسازی رشته
واردسازی تبدیل
واردسازی حافظه
واردسازی آزمایش

تابع برچسب(n: صحیح): رشته:
    x := رشته.از عدد(n برگردان صحیح۶۴)
    برگشت "n=" + x
پایان

تابع ریشه:
    a := رشته.از عدد(0 - 1234)
    b := رشته.از اعشار(3.25)
    c := تبدیل.قالب شانزده(255 برگردان طبیعی۶۴)
    d := تبدیل.قالب عدد بی علامت(18446744073709551615 برگردان طبیعی۶۴)
    آزمایش.ادعای برابری رشته(a، "-1234")
    آزمایش.ادعای برابری رشته(b، "3.25")
    آزمایش.ادعای برابری رشته(c، "ff")
    آزمایش.ادعای برابری رشته(d، "18446744073709551615")
    حافظه.آزادسازی(a برگردان تهی*)
    حافظه.آزادسازی(b برگردان تهی*)
    حافظه.آزادسازی(c برگردان تهی*)
    حافظه.آزادسازی(d برگردان تهی*)
    ناپایا t := 0
    تکرار 100 در i:
        t += رشته.طول("v" + رشته.از عدد(i برگردان صحیح۶۴) + ":" + رشته.از اعشار(i برگردان اعشار۶۴ + 0.5))
        l := برچسب(i)
        t += رشته.طول(l)
        حافظه.آزادسازی(l برگردان تهی*)
    پایان
    آزمایش.ادعای برابری عدد(t، 1170)
    آزمایش.ادعای برابری عدد(حافظه.بایت های زنده() برگردان صحیح، 0)
    برگشت آزمایش.خلاصه()
پایان
