واردسازی رشته
واردسازی آزمایش

تابع همسان(a: رشته، b: رشته): منطقی:
    برگشت رشته.یکسان است(a، b)
پایان

تابع پهنا(s: رشته): صحیح:
    برگشت رشته.طول(s)
پایان

تابع پیشوند دارد(ts: رشته، pn: رشته): منطقی:
    اگر رشته.شروع با(ts، pn + "_"):
        برگشت درست
    پایان
    برگشت نادرست
پایان

تابع جمع حلقه(n: صحیح): صحیح:
    ناپایا t := 0
    تکرار n در i:
        k := i % 2 == 0 ? "even" : "odd"
        اگر همسان("k" + k، "keven"):
            t++
        پایان
        t += پهنا("ab" + k)
        t += پهنا(k + k + "!")
        x := پهنا("p" + k + "q")
        t += x
    پایان
    برگشت t
پایان

تابع پهنای پایانی(a: رشته، b: رشته): صحیح:
    برگشت پهنا(a + b)
پایان

تابع شرط اول(a: رشته، b: رشته): صحیح:
    اگر رشته.طول(a + b) بزرگتر 4:
        برگشت 1
    پایان
    برگشت 0
پایان

تابع ریشه:
    آزمایش.ادعای درستی(پیشوند دارد("ab_cd"، "ab"))
    آزمایش.ادعای نادرستی(پیشوند دارد("ab_cd"، "cd"))
    آزمایش.ادعای برابری عدد(جمع حلقه(10)، 195)
    آزمایش.ادعای برابری عدد(پهنای پایانی("abc"، "de")، 5)
    آزمایش.ادعای برابری عدد(شرط اول("abc"، "de")، 1)
    آزمایش.ادعای برابری عدد(شرط اول("a"، "b")، 0)
    برگشت آزمایش.خلاصه()
پایان
