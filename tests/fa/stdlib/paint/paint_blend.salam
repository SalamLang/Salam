// زبان: فارسی
واردسازی رابط گرافیکی.نقاشی

تابع لاییر(حالت: نقاشی.حالت‌آمیختن): طبیعی۳۲:
    ناپایا کانواس := نقاشی.بوم تازه(8، 8)
    کانواس.پاک کردن(نقاشی.رنگ از سه مولفه(200، 100، 50))
    کانواس.آغاز لایه(نقاشی.مستطیل از(0.0، 0.0، 8.0، 8.0))
    کانواس.پرکردن مستطیل(نقاشی.مستطیل از(0.0، 0.0، 8.0، 8.0)، نقاشی.رنگ از سه مولفه(100، 200، 150))
    کهاین := نقاشی.زنجیره‌پالایه {}
    کانواس.ادغام لایه با آمیختن(کهاین، 1.0، حالت)
    پیکسیل := کانواس.پیکسل خام(4، 4)
    کانواس.رهاسازی()
    برگشت پیکسیل
پایان

تابع ریشه:
    سرچاپ "normal"، لاییر(نقاشی.حالت‌آمیختن.عادی)
    سرچاپ "multiply"، لاییر(نقاشی.حالت‌آمیختن.ضرب)
    سرچاپ "screen"، لاییر(نقاشی.حالت‌آمیختن.صفحه)
    سرچاپ "darken"، لاییر(نقاشی.حالت‌آمیختن.تیره تر)
    سرچاپ "lighten"، لاییر(نقاشی.حالت‌آمیختن.روشن تر)
    سرچاپ "difference"، لاییر(نقاشی.حالت‌آمیختن.تفاضل)
    سرچاپ "exclusion"، لاییر(نقاشی.حالت‌آمیختن.حذف)
    سرچاپ "overlay"، لاییر(نقاشی.حالت‌آمیختن.رویه)
    سرچاپ "hard light"، لاییر(نقاشی.حالت‌آمیختن.نور سخت)
    سرچاپ "luminosity"، لاییر(نقاشی.حالت‌آمیختن.درخشندگی)
پایان
