بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    ناپایا b := نقاشی.کادر توپر(4.0، نقاشی.رنگ از سه مولفه(0، 0، 200))
    b.رنگ چپ = نقاشی.رنگ از سه مولفه(200، 0، 0)
    b.پهنای چپ = 8.0
    b.پهنای پایین = 2.0
    cv.رسم کادر(نقاشی.مستطیل از(2.0، 2.0، 28.0، 20.0)، نقاشی.شعاع یکسان(0.0)، b)
    probe(cv، 4، 10)
    probe(cv، 16، 3)
    probe(cv، 16، 20)
    probe(cv، 28، 10)
    probe(cv، 16، 10)
    probe(cv، 3، 3)
    probe(cv، 9، 3)
    cv.رسم کادر(نقاشی.مستطیل از(34.0، 2.0، 28.0، 20.0)، نقاشی.شعاع یکسان(8.0)، نقاشی.کادر توپر(3.0، نقاشی.رنگ از چهار مولفه(0، 120، 0، 200)))
    probe(cv، 34، 2)
    probe(cv، 35، 4)
    probe(cv، 48، 3)
    probe(cv، 48، 12)
    probe(cv، 38، 6)
    ناپایا d := نقاشی.کادر توپر(2.0، نقاشی.رنگ از سه مولفه(0، 0، 0))
    d.سبک بالا = نقاشی.سبک‌کادر.خط‌چین
    d.سبک پایین = نقاشی.سبک‌کادر.نقطه‌چین
    d.سبک چپ = نقاشی.سبک‌کادر.هیچ
    cv.رسم کادر(نقاشی.مستطیل از(2.0، 26.0، 40.0، 20.0)، نقاشی.شعاع یکسان(0.0)، d)
    ناپایا top := ""
    تکرار 40 در i:
        top += cv.پیکسل(2 + i، 26).قرمز کوچکتر 128 ? "#" : "."
    پایان
    سرچاپ "dashed"، top
    ناپایا bottom := ""
    تکرار 40 در i:
        bottom += cv.پیکسل(2 + i، 45).قرمز کوچکتر 128 ? "#" : "."
    پایان
    سرچاپ "dotted"، bottom
    probe(cv، 2، 36)
    cv.رسم دورخط(نقاشی.مستطیل از(48.0، 30.0، 10.0، 10.0)، نقاشی.شعاع یکسان(2.0)، 2.0، 1.0، نقاشی.رنگ از سه مولفه(255، 100، 0))
    probe(cv، 46، 35)
    probe(cv، 45، 35)
    probe(cv، 47، 35)
    probe(cv، 48، 35)
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
پایان
