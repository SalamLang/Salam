بسته ریشه

واردسازی رابط گرافیکی.نقاشی
واردسازی حافظه

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    سرچاپ "size"، cv.پهنا، cv.بلندی، cv.گام ردیف، cv.مالک است
    سرچاپ "empty hash"، cv.چکیده()
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    probe(cv، 0، 0)
    cv.پرکردن مستطیل(نقاشی.مستطیل از(4.0، 4.0، 20.0، 10.0)، نقاشی.رنگ از سه مولفه(200، 30، 10))
    probe(cv، 10، 8)
    probe(cv، 3، 8)
    cv.پرکردن مستطیل(نقاشی.مستطیل از(10.0، 6.0، 20.0، 10.0)، نقاشی.رنگ از چهار مولفه(0، 0، 255، 128))
    probe(cv، 12، 8)
    probe(cv، 26، 8)
    cv.پرکردن مستطیل(نقاشی.مستطیل از(30.25، 20.5، 10.5، 6.75)، نقاشی.رنگ از سه مولفه(0، 0، 0))
    probe(cv، 30، 22)
    probe(cv، 31، 20)
    probe(cv، 40، 22)
    probe(cv، 35، 27)
    سرچاپ "premultiply"، نقاشی.پیش ضرب(نقاشی.رنگ از چهار مولفه(255، 128، 0، 128))
    u := نقاشی.حذف پیش ضرب(نقاشی.پیش ضرب(نقاشی.رنگ از چهار مولفه(200، 100، 50، 77)))
    سرچاپ "unpremultiply"، u.قرمز، u.سبز، u.آبی، u.آلفا
    سرچاپ "raw"، cv.پیکسل خام(12، 8)، cv.پیکسل خام(-1، 0)، cv.پیکسل خام(64، 0)
    ناپایا sub := cv.زیربوم(نقاشی.مستطیل پیکسلی از(40، 30، 30، 30))
    سرچاپ "sub"، sub.پهنا، sub.بلندی، sub.مالک است
    sub.پرکردن مستطیل(نقاشی.مستطیل از(0.0، 0.0، 4.0، 4.0)، نقاشی.رنگ از سه مولفه(0، 200، 0))
    probe(cv، 41، 31)
    sub.رهاسازی()
    سرچاپ "hash"، cv.چکیده()
    mem_buf := حافظه.تخصیص صفرشده((16 * 8 * 4) برگردان طبیعی۶۴)
    ناپایا w := نقاشی.بوم روی حافظه(mem_buf، 16، 8، 64)
    w.پرکردن مستطیل گرد(نقاشی.مستطیل از(0.0، 0.0، 16.0، 8.0)، نقاشی.شعاع یکسان(4.0)، نقاشی.رنگ از سه مولفه(10، 20، 30))
    سرچاپ "wrapped"، w.مالک است، (mem_buf برگردان طبیعی۳۲*)[7 * 16 + 8]، w.چکیده()
    w.رهاسازی()
    حافظه.آزادسازی(mem_buf)
    bad := نقاشی.بوم روی حافظه(پوچ، 4، 4، 16)
    سرچاپ "bad wrap"، bad.پهنا
    cv.رهاسازی()
    سرچاپ "freed"، cv.پهنا
پایان
