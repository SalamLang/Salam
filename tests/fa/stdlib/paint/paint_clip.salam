بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    b0 := cv.کرانه برش()
    سرچاپ "clip"، b0.ایکس، b0.ایگرگ، b0.پهنا، b0.بلندی
    cv.افزودن برش(نقاشی.مستطیل از(8.0، 8.0، 20.0، 20.0))
    cv.افزودن برش(نقاشی.مستطیل از(16.0، 0.0، 40.0، 40.0))
    b1 := cv.کرانه برش()
    سرچاپ "nested"، b1.ایکس، b1.ایگرگ، b1.پهنا، b1.بلندی
    cv.پرکردن مستطیل(نقاشی.مستطیل از(0.0، 0.0، 64.0، 48.0)، نقاشی.رنگ از سه مولفه(255، 0، 0))
    cv.برداشتن برش()
    probe(cv، 10، 10)
    probe(cv، 16، 10)
    probe(cv، 27، 27)
    probe(cv، 28، 27)
    cv.برداشتن برش()
    cv.برداشتن برش()
    cv.افزودن برش گرد(نقاشی.مستطیل از(32.0، 4.0، 28.0، 28.0)، نقاشی.شعاع یکسان(14.0))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(0.0، 0.0، 64.0، 48.0)، نقاشی.رنگ از سه مولفه(0، 0، 255))
    ناپایا g := نقاشی.گرادیان خطی(90.0)
    g.افزودن ایست(0.0، نقاشی.رنگ از سه مولفه(0، 0، 0))
    g.افزودن ایست(1.0، نقاشی.رنگ از سه مولفه(255، 255، 255))
    cv.پرکردن گرادیان(نقاشی.مستطیل از(40.0، 0.0، 30.0، 48.0)، نقاشی.شعاع یکسان(0.0)، g)
    g.رهاسازی()
    cv.برداشتن برش()
    probe(cv، 32، 4)
    probe(cv، 34، 8)
    probe(cv، 36، 7)
    probe(cv، 46، 18)
    probe(cv، 38، 18)
    probe(cv، 59، 31)
    cv.افزودن برش گرد(نقاشی.مستطیل از(4.0، 30.0، 24.0، 16.0)، نقاشی.شعاع یکسان(6.0))
    cv.افزودن برش گرد(نقاشی.مستطیل از(12.0، 30.0، 24.0، 16.0)، نقاشی.شعاع یکسان(6.0))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(0.0، 0.0، 64.0، 48.0)، نقاشی.رنگ از سه مولفه(0، 150، 0))
    cv.برداشتن برش()
    cv.برداشتن برش()
    probe(cv، 12، 30)
    probe(cv، 20، 38)
    probe(cv، 27، 45)
    probe(cv، 5، 38)
    cv.افزودن برش(نقاشی.مستطیل از(0.0، 0.0، 0.0، 0.0))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(0.0، 0.0، 64.0، 48.0)، نقاشی.رنگ از سه مولفه(0، 0، 0))
    cv.برداشتن برش()
    probe(cv، 0، 0)
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
پایان
