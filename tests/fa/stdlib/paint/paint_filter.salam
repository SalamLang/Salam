بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع square(cv &: نقاشی.بوم، x: اعشار۶۴، y: اعشار۶۴، chain: نقاشی.زنجیره‌پالایه):
    cv.آغاز لایه پالایه(نقاشی.مستطیل از(x، y، 16.0، 16.0)، chain)
    cv.پرکردن مستطیل(نقاشی.مستطیل از(x، y، 16.0، 16.0)، نقاشی.رنگ از سه مولفه(200، 60، 20))
    cv.ادغام لایه با پالایه(chain، 1.0)
پایان

تابع one(kind: نقاشی.نوع‌پالایه، amount: اعشار۶۴): نقاشی.زنجیره‌پالایه:
    ناپایا c := نقاشی.زنجیره‌پالایه {}
    c.افزودن پالایه(نقاشی.پالایه تازه(kind، amount))
    برگشت c
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(200، 80)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    kinds := [نقاشی.نوع‌پالایه.روشنایی، نقاشی.نوع‌پالایه.تضاد، نقاشی.نوع‌پالایه.خاکستری، نقاشی.نوع‌پالایه.قهوه ای کهنه، نقاشی.نوع‌پالایه.اشباع، نقاشی.نوع‌پالایه.چرخش فام، نقاشی.نوع‌پالایه.وارون رنگ، نقاشی.نوع‌پالایه.ماتی]
    amounts := [1.5، 0.5، 1.0، 1.0، 2.0، 90.0، 1.0، 0.5]
    تکرار 8 در i:
        ناپایا c := one(kinds[i]، amounts[i])
        square(cv، 4.0 + (i برگردان اعشار۶۴) * 22.0، 4.0، c)
        probe(cv، 12 + i * 22، 12)
        c.رهاسازی()
    پایان
    ناپایا blur := one(نقاشی.نوع‌پالایه.تار کردن، 3.0)
    سرچاپ "blur extent"، blur.گستره پالایه()، "empty"، blur.خالی است()، نقاشی.زنجیره‌پالایه {}.خالی است()
    square(cv، 10.0، 40.0، blur)
    probe(cv، 18، 48)
    probe(cv، 10، 48)
    probe(cv، 6، 48)
    blur.رهاسازی()
    ناپایا ds := نقاشی.زنجیره‌پالایه {}
    ds.افزودن پالایه(نقاشی.پالایه سایه افتاده(4.0، 4.0، 2.0، نقاشی.رنگ از چهار مولفه(0، 0، 0، 200)))
    سرچاپ "shadow extent"، ds.گستره پالایه()
    square(cv، 50.0، 40.0، ds)
    probe(cv، 58، 48)
    probe(cv، 68، 60)
    ds.رهاسازی()
    cv.پرکردن مستطیل(نقاشی.مستطیل از(100.0، 40.0، 4.0، 30.0)، نقاشی.رنگ از سه مولفه(0، 0، 0))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(112.0، 40.0، 4.0، 30.0)، نقاشی.رنگ از سه مولفه(0، 0، 0))
    ناپایا bd := one(نقاشی.نوع‌پالایه.تار کردن، 2.0)
    bd.افزودن پالایه(نقاشی.پالایه تازه(نقاشی.نوع‌پالایه.روشنایی، 1.2))
    cv.پالایه پس زمینه(نقاشی.مستطیل از(96.0، 44.0، 24.0، 20.0)، نقاشی.شعاع یکسان(6.0)، bd)
    bd.رهاسازی()
    probe(cv، 102، 54)
    probe(cv، 108، 54)
    probe(cv، 102، 42)
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
پایان
