بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    ناپایا g := نقاشی.گرادیان خطی(90.0)
    g.افزودن ایست(0.0، نقاشی.رنگ از سه مولفه(255، 0، 0))
    g.افزودن ایست(-1.0، نقاشی.رنگ از سه مولفه(0، 255، 0))
    g.افزودن ایست(1.0، نقاشی.رنگ از سه مولفه(0، 0، 255))
    cv.پرکردن گرادیان(نقاشی.مستطیل از(0.0، 0.0، 32.0، 8.0)، نقاشی.شعاع یکسان(0.0)، g)
    probe(cv، 0، 4)
    probe(cv، 8، 4)
    probe(cv، 16، 4)
    probe(cv، 31، 4)
    g.رهاسازی()
    ناپایا h := نقاشی.گرادیان خطی(180.0)
    h.افزودن ایست(0.5، نقاشی.رنگ از سه مولفه(0، 0، 0))
    h.افزودن ایست(0.5، نقاشی.رنگ از سه مولفه(255، 255، 0))
    cv.پرکردن گرادیان(نقاشی.مستطیل از(34.0، 0.0، 28.0، 20.0)، نقاشی.شعاع یکسان(6.0)، h)
    probe(cv، 48، 9)
    probe(cv، 48، 10)
    probe(cv، 34، 0)
    h.رهاسازی()
    ناپایا rg := نقاشی.گرادیان شعاعی(16.0، 14.0، 16.0، 14.0)
    rg.افزودن ایست(0.0، نقاشی.رنگ از سه مولفه(255، 255، 255))
    rg.افزودن ایست(1.0، نقاشی.رنگ از چهار مولفه(0، 0، 0، 255))
    cv.پرکردن گرادیان(نقاشی.مستطیل از(0.0، 10.0، 32.0، 28.0)، نقاشی.شعاع یکسان(0.0)، rg)
    probe(cv، 16، 24)
    probe(cv، 24، 24)
    probe(cv، 0، 10)
    rg.رهاسازی()
    sz := نقاشی.شعاع گرادیان شعاعی(40.0، 20.0، 10.0، 5.0، درست، نقاشی.گستره‌شعاعی.دورترین گوشه)
    سرچاپ "farthest corner"، sz.ایکس، sz.ایگرگ
    sz2 := نقاشی.شعاع گرادیان شعاعی(40.0، 20.0، 10.0، 5.0، نادرست، نقاشی.گستره‌شعاعی.نزدیکترین ضلع)
    سرچاپ "closest side"، sz2.ایکس، sz2.ایگرگ
    sz3 := نقاشی.شعاع گرادیان شعاعی(40.0، 20.0، 10.0، 5.0، درست، نقاشی.گستره‌شعاعی.دورترین ضلع)
    سرچاپ "farthest side"، sz3.ایکس، sz3.ایگرگ
    sz4 := نقاشی.شعاع گرادیان شعاعی(40.0، 20.0، 10.0، 5.0، درست، نقاشی.گستره‌شعاعی.نزدیکترین گوشه)
    سرچاپ "closest corner"، sz4.ایکس، sz4.ایگرگ
    ناپایا cg := نقاشی.گرادیان مخروطی(12.0، 12.0، 0.0)
    cg.افزودن ایست(0.0، نقاشی.رنگ از سه مولفه(255، 0، 0))
    cg.افزودن ایست(0.5، نقاشی.رنگ از سه مولفه(0، 0، 255))
    cg.افزودن ایست(1.0، نقاشی.رنگ از سه مولفه(255، 0، 0))
    cv.پرکردن گرادیان(نقاشی.مستطیل از(36.0، 22.0، 24.0، 24.0)، نقاشی.شعاع یکسان(12.0)، cg)
    probe(cv، 48، 24)
    probe(cv، 58، 34)
    probe(cv، 48، 44)
    cg.رهاسازی()
    ناپایا rep := نقاشی.گرادیان خطی(90.0)
    rep.پیاپی = درست
    rep.افزودن ایست(0.0، نقاشی.رنگ از سه مولفه(0، 0، 0))
    rep.افزودن ایست(0.25، نقاشی.رنگ از سه مولفه(255، 255، 255))
    cv.پرکردن گرادیان(نقاشی.مستطیل از(0.0، 40.0، 32.0، 8.0)، نقاشی.شعاع یکسان(0.0)، rep)
    probe(cv، 1، 44)
    probe(cv، 9، 44)
    probe(cv، 7، 44)
    rep.رهاسازی()
    ناپایا empty := نقاشی.گرادیان خطی(0.0)
    cv.پرکردن گرادیان(نقاشی.مستطیل از(0.0، 0.0، 64.0، 48.0)، نقاشی.شعاع یکسان(0.0)، empty)
    empty.رهاسازی()
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
پایان
