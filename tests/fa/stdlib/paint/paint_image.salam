بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع checker(): نقاشی.بوم:
    ناپایا src := نقاشی.بوم تازه(4، 4)
    تکرار 4 در y:
        تکرار 4 در x:
            اگر (x + y) % 2 برابر 0:
                src.پرکردن مستطیل(نقاشی.مستطیل از(x برگردان اعشار۶۴، y برگردان اعشار۶۴، 1.0، 1.0)، نقاشی.رنگ از سه مولفه(255، 0، 0))
            وگرنه:
                src.پرکردن مستطیل(نقاشی.مستطیل از(x برگردان اعشار۶۴، y برگردان اعشار۶۴، 1.0، 1.0)، نقاشی.رنگ از چهار مولفه(0، 0، 255، 128))
            پایان
        پایان
    پایان
    برگشت src
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    ناپایا src := checker()
    cv.رسم تصویر(src، نقاشی.مستطیل از(0.0، 0.0، 4.0، 4.0)، 1.0)
    probe(cv، 0، 0)
    probe(cv، 1، 0)
    cv.رسم تصویر(src، نقاشی.مستطیل از(8.0، 0.0، 16.0، 16.0)، 1.0)
    probe(cv، 8، 0)
    probe(cv، 11، 2)
    probe(cv، 13، 2)
    cv.رسم تصویر(src، نقاشی.مستطیل از(28.0، 0.0، 2.0، 2.0)، 1.0)
    probe(cv، 28، 0)
    probe(cv، 29، 1)
    cv.رسم تصویر(src، نقاشی.مستطیل از(32.0، 0.0، 8.0، 8.0)، 0.5)
    probe(cv، 32، 0)
    cv.رسم تکه تصویر(src، نقاشی.مستطیل پیکسلی از(1، 0، 1، 1)، نقاشی.مستطیل از(42.0، 0.0، 6.0، 6.0)، 1.0)
    probe(cv، 44، 3)
    cv.رسم تصویر کاشی(src، نقاشی.مستطیل از(0.0، 20.0، 30.0، 10.0)، نقاشی.مستطیل از(1.0، 20.0، 2.0، 2.0)، 1.0)
    probe(cv، 0، 20)
    probe(cv، 1، 20)
    probe(cv، 2، 20)
    probe(cv، 29، 29)
    ناپایا half := نقاشی.مقیاس تصویر(src، 2، 2)
    سرچاپ "scaled"، half.پهنا، half.بلندی
    c0 := half.پیکسل(0، 0)
    سرچاپ "scaled pixel"، c0.قرمز، c0.سبز، c0.آبی، c0.آلفا
    half.رهاسازی()
    f1 := نقاشی.برازش تصویر(نقاشی.برازش.جاگیری کامل، 200، 100، نقاشی.مستطیل از(0.0، 0.0، 50.0، 50.0)، 0.5، 0.5)
    سرچاپ "contain"، f1.ایکس، f1.ایگرگ، f1.پهنا، f1.بلندی
    f2 := نقاشی.برازش تصویر(نقاشی.برازش.پوشش، 200، 100، نقاشی.مستطیل از(0.0، 0.0، 50.0، 50.0)، 0.5، 0.5)
    سرچاپ "cover"، f2.ایکس، f2.ایگرگ، f2.پهنا، f2.بلندی
    f3 := نقاشی.برازش تصویر(نقاشی.برازش.هیچ، 20، 10، نقاشی.مستطیل از(0.0، 0.0، 50.0، 50.0)، 0.0، 1.0)
    سرچاپ "none"، f3.ایکس، f3.ایگرگ، f3.پهنا، f3.بلندی
    f4 := نقاشی.برازش تصویر(نقاشی.برازش.کوچک سازی، 20، 10، نقاشی.مستطیل از(0.0، 0.0، 50.0، 50.0)، 0.5، 0.5)
    سرچاپ "scale down"، f4.ایکس، f4.ایگرگ، f4.پهنا، f4.بلندی
    f5 := نقاشی.برازش تصویر(نقاشی.برازش.پرکردن، 20، 10، نقاشی.مستطیل از(1.0، 2.0، 50.0، 40.0)، 0.5، 0.5)
    سرچاپ "fill"، f5.ایکس، f5.ایگرگ، f5.پهنا، f5.بلندی
    cv.افزودن برش گرد(نقاشی.مستطیل از(34.0، 30.0، 16.0، 16.0)، نقاشی.شعاع یکسان(8.0))
    cv.رسم تصویر(src، f5، 1.0)
    cv.برداشتن برش()
    probe(cv، 34، 30)
    probe(cv، 42، 38)
    سرچاپ "hash"، cv.چکیده()
    src.رهاسازی()
    cv.رهاسازی()
پایان
