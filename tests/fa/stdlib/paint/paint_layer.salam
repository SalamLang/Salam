بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    cv.آغاز لایه(نقاشی.مستطیل از(0.0، 0.0، 30.0، 30.0))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(2.0، 2.0، 16.0، 16.0)، نقاشی.رنگ از سه مولفه(255، 0، 0))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(10.0، 10.0، 16.0، 16.0)، نقاشی.رنگ از سه مولفه(0، 0، 255))
    cv.ادغام لایه(0.5)
    probe(cv، 5، 5)
    probe(cv، 14، 14)
    probe(cv، 22، 22)
    cv.جابجا کردن(32.0، 0.0)
    cv.پرکردن مستطیل گرد(نقاشی.مستطیل از(2.0، 2.0، 12.0، 12.0)، نقاشی.شعاع یکسان(3.0)، نقاشی.رنگ از سه مولفه(0، 150، 0))
    cv.برداشتن تبدیل()
    probe(cv، 40، 8)
    probe(cv، 8، 40)
    t := نقاشی.تبدیل جابجایی(48.0، 8.0).سپس(نقاشی.تبدیل همانی())
    cv.افزودن تبدیل(نقاشی.تبدیل چرخش(45.0).سپس(t))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(-5.0، -5.0، 10.0، 10.0)، نقاشی.رنگ از سه مولفه(0، 0، 0))
    cv.برداشتن تبدیل()
    probe(cv، 48، 8)
    probe(cv، 48، 1)
    probe(cv، 54، 2)
    cv.افزودن تبدیل(نقاشی.تبدیل مقیاس(2.0، 2.0))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(1.0، 16.0، 4.0، 4.0)، نقاشی.رنگ از سه مولفه(200، 200، 0))
    cv.برداشتن تبدیل()
    probe(cv، 2، 32)
    probe(cv، 9، 39)
    probe(cv، 10، 40)
    ناپایا src := نقاشی.بوم تازه(2، 2)
    src.پاک کردن(نقاشی.رنگ از سه مولفه(0، 200، 200))
    cv.افزودن تبدیل(نقاشی.تبدیل چرخش(30.0).سپس(نقاشی.تبدیل جابجایی(30.0، 34.0)))
    cv.رسم تصویر(src، نقاشی.مستطیل از(0.0، 0.0، 10.0، 10.0)، 1.0)
    cv.برداشتن تبدیل()
    probe(cv، 28، 40)
    src.رهاسازی()
    p := نقاشی.تبدیل چرخش(90.0).اعمال روی نقطه(نقاشی.نقطه { ایکس = 1.0، ایگرگ = 0.0 })
    سرچاپ "rotated"، p.ایکس، p.ایگرگ
    s := نقاشی.تبدیل مقیاس(2.0، 3.0).سپس(نقاشی.تبدیل جابجایی(1.0، 1.0)).اعمال روی نقطه(نقاشی.نقطه { ایکس = 1.0، ایگرگ = 1.0 })
    سرچاپ "scaled"، s.ایکس، s.ایگرگ
    cv.آغاز لایه(نقاشی.مستطیل از(40.0، 30.0، 20.0، 16.0))
    cv.آغاز لایه(نقاشی.مستطیل از(40.0، 30.0، 10.0، 16.0))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(40.0، 30.0، 20.0، 16.0)، نقاشی.رنگ از سه مولفه(0، 0، 0))
    cv.ادغام لایه(1.0)
    cv.ادغام لایه(0.25)
    probe(cv، 45، 35)
    probe(cv، 55، 35)
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
پایان
