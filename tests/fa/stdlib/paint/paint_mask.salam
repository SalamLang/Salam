بسته ریشه

واردسازی رابط گرافیکی.نقاشی
واردسازی حافظه

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    data := حافظه.تخصیص صفرشده((8 * 6) برگردان طبیعی۶۴)
    bytes := data برگردان طبیعی۸*
    تکرار 6 در y:
        تکرار 8 در x:
            bytes[y * 8 + x] = ((x * 36) % 256) برگردان طبیعی۸
        پایان
    پایان
    m := نقاشی.ماسک { داده = data، پهنا = 8، بلندی = 6، گام ردیف = 8، فاصله چپ = 1، فاصله بالا = 5 }
    cv.رسم ماسک(m، 2، 2، نقاشی.رنگ از سه مولفه(0، 0، 0))
    probe(cv، 2، 2)
    probe(cv، 6، 3)
    probe(cv، 9، 7)
    cv.رسم گلیف(m، 20، 10، نقاشی.رنگ از سه مولفه(200، 0، 0))
    probe(cv، 21، 5)
    probe(cv، 28، 7)
    cv.افزودن برش(نقاشی.مستطیل از(40.0، 0.0، 4.0، 48.0))
    cv.رسم ماسک(m، 38، 20، نقاشی.رنگ از چهار مولفه(0، 0، 255، 255))
    cv.برداشتن برش()
    probe(cv، 39، 22)
    probe(cv، 41، 22)
    probe(cv، 45، 22)
    cv.رسم ماسک(m، 60، 44، نقاشی.رنگ از سه مولفه(0، 0، 0))
    cv.رسم ماسک(m، -100، -100، نقاشی.رنگ از سه مولفه(0، 0، 0))
    سرچاپ "hash"، cv.چکیده()
    حافظه.آزادسازی(data)
    cv.رهاسازی()
پایان
