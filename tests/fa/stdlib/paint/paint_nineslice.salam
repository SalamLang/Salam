بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع source(): نقاشی.بوم:
    ناپایا s := نقاشی.بوم تازه(30، 30)
    s.پاک کردن(نقاشی.رنگ از سه مولفه(0، 0، 255))
    s.پرکردن مستطیل(نقاشی.مستطیل از(0.0، 0.0، 10.0، 10.0)، نقاشی.رنگ از سه مولفه(255، 0، 0))
    s.پرکردن مستطیل(نقاشی.مستطیل از(20.0، 0.0، 10.0، 10.0)، نقاشی.رنگ از سه مولفه(0، 160، 0))
    s.پرکردن مستطیل(نقاشی.مستطیل از(0.0، 20.0، 10.0، 10.0)، نقاشی.رنگ از سه مولفه(255، 200، 0))
    s.پرکردن مستطیل(نقاشی.مستطیل از(20.0، 20.0، 10.0، 10.0)، نقاشی.رنگ از سه مولفه(0، 0، 0))
    s.پرکردن مستطیل(نقاشی.مستطیل از(10.0، 0.0، 5.0، 10.0)، نقاشی.رنگ از سه مولفه(255، 0، 255))
    s.پرکردن مستطیل(نقاشی.مستطیل از(0.0، 10.0، 10.0، 5.0)، نقاشی.رنگ از سه مولفه(0، 200، 200))
    s.پرکردن مستطیل(نقاشی.مستطیل از(10.0، 10.0، 10.0، 10.0)، نقاشی.رنگ از سه مولفه(128، 128، 128))
    برگشت s
پایان

تابع frame(cv &: نقاشی.بوم، src: نقاشی.بوم، x: اعشار۶۴، mode: نقاشی.تکرارتصویر، fill: منطقی):
    ناپایا ns := نقاشی.نه‌برش { برش بالایی = 10.0، برش راستی = 10.0، برش پایینی = 10.0، برش چپی = 10.0 }
    ns.پهنای بالایی = 8.0
    ns.پهنای راستی = 8.0
    ns.پهنای پایینی = 8.0
    ns.پهنای چپی = 8.0
    ns.تکرار افقی = mode
    ns.تکرار عمودی = mode
    ns.پرکردن وسط = fill
    cv.رسم نه برش(src، نقاشی.مستطیل از(x، 4.0، 50.0، 42.0)، ns، 1.0)
پایان

تابع ریشه:
    src := source()
    ناپایا cv := نقاشی.بوم تازه(240، 60)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    frame(cv، src، 4.0، نقاشی.تکرارتصویر.Stretch، درست)
    frame(cv، src، 62.0، نقاشی.تکرارتصویر.Repeat، نادرست)
    frame(cv، src، 120.0، نقاشی.تکرارتصویر.Round، نادرست)
    frame(cv، src، 178.0، نقاشی.تکرارتصویر.Space، نادرست)
    probe(cv، 6، 6)
    probe(cv، 50، 6)
    probe(cv، 6، 42)
    probe(cv، 50، 42)
    probe(cv، 14، 6)
    probe(cv، 6، 16)
    probe(cv، 28، 24)
    probe(cv، 87، 6)
    probe(cv، 72، 6)
    probe(cv، 64، 24)
    probe(cv، 87، 24)
    probe(cv، 132، 6)
    probe(cv، 140، 6)
    probe(cv، 190، 6)
    probe(cv، 205، 24)
    over := نقاشی.نه‌برش { برش بالایی = 10.0، برش راستی = 10.0، برش پایینی = 10.0، برش چپی = 10.0، پهنای بالایی = 30.0، پهنای راستی = 30.0، پهنای پایینی = 30.0، پهنای چپی = 30.0 }
    ناپایا small := نقاشی.بوم تازه(40، 40)
    small.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    small.رسم نه برش(src، نقاشی.مستطیل از(0.0، 0.0، 40.0، 40.0)، over، 0.5)
    probe(small، 5، 5)
    probe(small، 35، 35)
    probe(small، 20، 20)
    سرچاپ "hash"، cv.چکیده()، small.چکیده()
    small.رهاسازی()
    cv.رهاسازی()
پایان
