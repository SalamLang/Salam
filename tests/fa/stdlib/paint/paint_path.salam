بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    ناپایا tri := نقاشی.مسیر تازه()
    tri.حرکت به(2.0، 2.0)
    tri.خط به(22.0، 2.0)
    tri.خط به(2.0، 22.0)
    tri.بستن مسیر()
    cv.پرکردن مسیر(tri، نقاشی.قانون‌پرکردن.ناصفر، نقاشی.رنگ از سه مولفه(0، 0، 0))
    probe(cv، 4، 4)
    probe(cv، 11، 11)
    probe(cv، 12، 12)
    probe(cv، 20، 20)
    tri.رهاسازی()
    ناپایا star := نقاشی.مسیر تازه()
    star.حرکت به(36.0، 2.0)
    star.خط به(42.0، 22.0)
    star.خط به(26.0، 9.0)
    star.خط به(46.0، 9.0)
    star.خط به(30.0، 22.0)
    star.بستن مسیر()
    ناپایا odd := نقاشی.بوم تازه(64، 48)
    odd.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    cv.پرکردن مسیر(star، نقاشی.قانون‌پرکردن.ناصفر، نقاشی.رنگ از سه مولفه(0، 0، 200))
    odd.پرکردن مسیر(star، نقاشی.قانون‌پرکردن.زوج فرد، نقاشی.رنگ از سه مولفه(0، 0، 200))
    probe(cv، 36، 13)
    probe(odd، 36، 13)
    probe(odd، 36، 6)
    سرچاپ "even odd hash"، odd.چکیده()
    odd.رهاسازی()
    star.رهاسازی()
    ناپایا curve := نقاشی.مسیر تازه()
    curve.حرکت به(48.0، 2.0)
    curve.منحنی درجه دو به(62.0، 2.0، 62.0، 16.0)
    curve.منحنی درجه سه به(56.0، 16.0، 50.0، 22.0، 48.0، 16.0)
    curve.بستن مسیر()
    cv.پرکردن مسیر(curve، نقاشی.قانون‌پرکردن.ناصفر، نقاشی.رنگ از سه مولفه(0، 140، 0))
    probe(cv، 55، 8)
    probe(cv، 61، 3)
    curve.پاک کردن()
    curve.افزودن بیضی(12.0، 36.0، 10.0، 8.0)
    cv.پرکردن مسیر(curve، نقاشی.قانون‌پرکردن.ناصفر، نقاشی.رنگ از چهار مولفه(200، 0، 0، 255))
    probe(cv، 12، 36)
    probe(cv، 2، 36)
    probe(cv، 3، 29)
    curve.پاک کردن()
    curve.افزودن مستطیل(نقاشی.مستطیل از(26.0، 28.0، 10.0، 10.0))
    curve.افزودن مستطیل گرد(نقاشی.مستطیل از(28.0، 30.0، 6.0، 6.0)، نقاشی.شعاع یکسان(2.0))
    cv.پرکردن مسیر(curve، نقاشی.قانون‌پرکردن.زوج فرد، نقاشی.رنگ از سه مولفه(120، 0، 120))
    probe(cv، 27، 29)
    probe(cv، 31، 33)
    curve.رهاسازی()
    ناپایا line := نقاشی.مسیر تازه()
    line.حرکت به(40.0، 30.0)
    line.خط به(60.0، 30.0)
    line.خط به(60.0، 44.0)
    cv.خط کشی مسیر(line، نقاشی.قلم { پهنا = 4.0 }، نقاشی.رنگ از سه مولفه(0، 0، 0))
    probe(cv، 50، 28)
    probe(cv، 50، 32)
    probe(cv، 61، 29)
    probe(cv، 38، 30)
    line.رهاسازی()
    ناپایا caps := نقاشی.مسیر تازه()
    caps.حرکت به(42.0، 38.0)
    caps.خط به(52.0، 38.0)
    cv.خط کشی مسیر(caps، نقاشی.قلم { پهنا = 4.0، سرخط = نقاشی.سرخط.گرد، اتصال = نقاشی.اتصال‌خط.گرد }، نقاشی.رنگ از سه مولفه(0، 100، 200))
    probe(cv، 40، 38)
    caps.پاک کردن()
    caps.حرکت به(42.0، 44.0)
    caps.خط به(52.0، 44.0)
    cv.خط کشی مسیر(caps، نقاشی.قلم { پهنا = 2.0، سرخط = نقاشی.سرخط.مربعی، اتصال = نقاشی.اتصال‌خط.پخ }، نقاشی.رنگ از سه مولفه(200، 100، 0))
    probe(cv، 41، 44)
    caps.پاک کردن()
    caps.حرکت به(2.0، 46.0)
    caps.خط به(62.0، 46.0)
    cv.خط کشی مسیر(caps، نقاشی.قلم { پهنا = 2.0، خط چین = 4.0، فاصله خط چین = 2.0، آغاز خط چین = 1.0 }، نقاشی.رنگ از سه مولفه(0، 0، 0))
    ناپایا dashes := ""
    تکرار 20 در i:
        dashes += cv.پیکسل(2 + i، 46).قرمز کوچکتر 128 ? "#" : "."
    پایان
    سرچاپ "dashes"، dashes
    caps.رهاسازی()
    ناپایا arc := نقاشی.مسیر تازه()
    arc.کمان(50.0، 22.0، 6.0، 6.0، 0.0، 180.0)
    cv.خط کشی مسیر(arc، نقاشی.قلم { پهنا = 1.0، حد تیزی = 2.0 }، نقاشی.رنگ از سه مولفه(255، 0، 0))
    probe(cv، 50، 27)
    arc.رهاسازی()
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
پایان
