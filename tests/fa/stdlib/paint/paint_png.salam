بسته ریشه

واردسازی رابط گرافیکی.نقاشی
واردسازی هوش مصنوعی.تصویر
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    cv.رسم سایه(نقاشی.مستطیل از(8.0، 8.0، 40.0، 24.0)، نقاشی.شعاع یکسان(8.0)، نقاشی.سایه { جابجایی ایگرگ = 3.0، تاری = 6.0، رنگ = نقاشی.رنگ از چهار مولفه(0، 0، 0، 100) })
    cv.پرکردن مستطیل گرد(نقاشی.مستطیل از(8.0، 8.0، 40.0، 24.0)، نقاشی.شعاع یکسان(8.0)، نقاشی.رنگ از سه مولفه(30، 110، 220))
    cv.رسم کادر(نقاشی.مستطیل از(8.0، 8.0، 40.0، 24.0)، نقاشی.شعاع یکسان(8.0)، نقاشی.کادر توپر(2.0، نقاشی.رنگ از سه مولفه(10، 40، 90)))
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_paint_png_demo_fa")
    سیستم عامل.ساخت پوشه ها(dir)
    path := مسیر پرونده.پیوند(dir، "box.png")
    سرچاپ "saved"، نقاشی.ذخیره پی ان جی(cv، path)
    ناپایا ok := نادرست
    ناپایا back := نقاشی.خواندن پی ان جی(path، ok)
    سرچاپ "loaded"، ok، back.پهنا، back.بلندی
    سرچاپ "same pixels"، back.چکیده() برابر cv.چکیده()
    img := نقاشی.تصویر از بوم(cv)
    سرچاپ "image"، img.عرض، img.ارتفاع
    c := تصویر.دریافت پیکسل(img، 20، 20)
    سرچاپ "image pixel"، c.قرمز، c.سبز، c.آبی، c.آلفا
    ناپایا again := نقاشی.بوم از تصویر(img)
    سرچاپ "round trip"، again.چکیده() برابر cv.چکیده()
    ناپایا bad := نادرست
    ناپایا missing := نقاشی.خواندن پی ان جی(مسیر پرونده.پیوند(dir، "missing.png")، bad)
    سرچاپ "missing"، bad، missing.پهنا
    ناپایا copy := img
    تصویر.آزادسازی(copy)
    again.رهاسازی()
    back.رهاسازی()
    missing.رهاسازی()
    cv.رهاسازی()
    سیستم عامل.حذف همه(dir)
پایان
