بسته ریشه

واردسازی رابط گرافیکی.نقاشی
واردسازی حافظه

تابع show(r: نقاشی.ناحیه):
    ناپایا line := "count " + r.شمار()
    تکرار r.شمار() در i:
        q := r.مستطیل شماره(i)
        line += " [" + q.ایکس + " " + q.ایگرگ + " " + q.پهنا + " " + q.بلندی + "]"
    پایان
    سرچاپ line
پایان

تابع scene(cv &: نقاشی.بوم، img: نقاشی.بوم، m: نقاشی.ماسک):
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(250، 250، 250))
    r := نقاشی.مستطیل از(6.5، 5.25، 30.0، 20.0)
    cv.رسم سایه(r، نقاشی.شعاع یکسان(6.0)، نقاشی.سایه { جابجایی ایگرگ = 2.0، تاری = 5.0، رنگ = نقاشی.رنگ از چهار مولفه(0، 0، 0، 120) })
    ناپایا g := نقاشی.گرادیان خطی(120.0)
    g.افزودن ایست(0.0، نقاشی.رنگ از سه مولفه(255، 160، 0))
    g.افزودن ایست(1.0، نقاشی.رنگ از سه مولفه(80، 0، 200))
    cv.پرکردن گرادیان(r، نقاشی.شعاع یکسان(6.0)، g)
    g.رهاسازی()
    ناپایا b := نقاشی.کادر توپر(2.0، نقاشی.رنگ از سه مولفه(20، 20، 80))
    b.رنگ بالا = نقاشی.رنگ از سه مولفه(200، 0، 0)
    cv.رسم کادر(r، نقاشی.شعاع یکسان(6.0)، b)
    cv.افزودن برش گرد(نقاشی.مستطیل از(30.0، 14.0، 30.0، 30.0)، نقاشی.شعاع یکسان(12.0))
    cv.رسم تصویر(img، نقاشی.مستطیل از(28.0، 12.0، 34.0، 34.0)، 0.9)
    cv.برداشتن برش()
    cv.آغاز لایه(نقاشی.مستطیل از(0.0، 26.0، 40.0، 22.0))
    ناپایا p := نقاشی.مسیر تازه()
    p.افزودن بیضی(14.0، 36.0، 12.0، 8.0)
    cv.پرکردن مسیر(p، نقاشی.قانون‌پرکردن.ناصفر، نقاشی.رنگ از سه مولفه(0، 140، 60))
    cv.خط کشی مسیر(p، نقاشی.قلم { پهنا = 1.5 }، نقاشی.رنگ از سه مولفه(0، 0، 0))
    p.رهاسازی()
    cv.رسم ماسک(m، 18، 32، نقاشی.رنگ از سه مولفه(255، 255، 255))
    cv.ادغام لایه(0.7)
    cv.رسم سایه(نقاشی.مستطیل از(42.0، 2.0، 18.0، 10.0)، نقاشی.شعاع یکسان(3.0)، نقاشی.سایه { تاری = 3.0، رنگ = نقاشی.رنگ از چهار مولفه(0، 0، 200، 255)، درونی = درست })
پایان

تابع ریشه:
    ناپایا reg := نقاشی.ناحیه {}
    سرچاپ "empty"، reg.خالی است()
    reg.افزودن(نقاشی.مستطیل پیکسلی از(0، 0، 10، 10))
    reg.افزودن(نقاشی.مستطیل پیکسلی از(2، 2، 4، 4))
    reg.افزودن(نقاشی.مستطیل پیکسلی از(20، 0، 10، 10))
    reg.افزودن(نقاشی.مستطیل پیکسلی از(0، 30، 10، 10))
    show(reg)
    reg.افزودن(نقاشی.مستطیل پیکسلی از(22، 2، 10، 10))
    show(reg)
    reg.افزودن(نقاشی.مستطیل پیکسلی از(-5، -5، 50، 50))
    show(reg)
    reg.پاک کردن()
    reg.افزودن(نقاشی.مستطیل پیکسلی از(5، 5، 5، 5))
    ناپایا other := نقاشی.ناحیه {}
    other.افزودن(نقاشی.مستطیل پیکسلی از(50، 50، 2، 2))
    other.افزودن(نقاشی.مستطیل پیکسلی از(0، 0، 0، 5))
    reg.اجتماع(other)
    show(reg)
    bb := reg.کرانه()
    سرچاپ "bounds"، bb.ایکس، bb.ایگرگ، bb.پهنا، bb.بلندی
    q := reg.مستطیل شماره(7)
    سرچاپ "out of range"، q.پهنا

    ناپایا img := نقاشی.بوم تازه(8، 8)
    تکرار 8 در y:
        تکرار 8 در x:
            img.پرکردن مستطیل(نقاشی.مستطیل از(x برگردان اعشار۶۴، y برگردان اعشار۶۴، 1.0، 1.0)، نقاشی.رنگ از سه مولفه(x * 32، y * 32، 128))
        پایان
    پایان
    data := حافظه.تخصیص صفرشده((6 * 6) برگردان طبیعی۶۴)
    تکرار 36 در i:
        (data برگردان طبیعی۸*)[i] = ((i * 7) % 256) برگردان طبیعی۸
    پایان
    m := نقاشی.ماسک { داده = data، پهنا = 6، بلندی = 6، گام ردیف = 6 }

    ناپایا full := نقاشی.بوم تازه(64، 48)
    scene(full، img، m)
    سرچاپ "full"، full.چکیده()

    ناپایا part := نقاشی.بوم تازه(64، 48)
    ناپایا damage := نقاشی.ناحیه {}
    damage.افزودن(نقاشی.مستطیل پیکسلی از(10، 8، 30، 20))
    damage.افزودن(نقاشی.مستطیل پیکسلی از(25، 18، 30، 22))
    part.تنظیم ناحیه(damage)
    scene(part، img، m)
    ناپایا r1 := نقاشی.ناحیه {}
    r1.افزودن(نقاشی.مستطیل پیکسلی از(0، 0، 64، 8))
    r1.افزودن(نقاشی.مستطیل پیکسلی از(0، 8، 10، 10))
    r1.افزودن(نقاشی.مستطیل پیکسلی از(40، 8، 24، 10))
    part.تنظیم ناحیه(r1)
    scene(part، img، m)
    ناپایا r2 := نقاشی.ناحیه {}
    r2.افزودن(نقاشی.مستطیل پیکسلی از(0، 18، 10، 10))
    r2.افزودن(نقاشی.مستطیل پیکسلی از(55، 18، 9، 10))
    r2.افزودن(نقاشی.مستطیل پیکسلی از(0، 28، 25، 12))
    part.تنظیم ناحیه(r2)
    scene(part، img، m)
    ناپایا r3 := نقاشی.ناحیه {}
    r3.افزودن(نقاشی.مستطیل پیکسلی از(55، 28، 9، 12))
    r3.افزودن(نقاشی.مستطیل پیکسلی از(0، 40، 64، 8))
    part.تنظیم ناحیه(r3)
    scene(part، img، m)
    part.حذف ناحیه()
    سرچاپ "partial"، part.چکیده()
    سرچاپ "partial equals full"، part.چکیده() برابر full.چکیده()

    ناپایا only := نقاشی.بوم تازه(64، 48)
    only.تنظیم ناحیه(damage)
    scene(only، img، m)
    سرچاپ "outside damage untouched"، only.پیکسل خام(2، 2)، only.پیکسل خام(60، 46)
    سرچاپ "inside damage drawn"، only.پیکسل خام(30، 20) برابر full.پیکسل خام(30، 20)

    only.رهاسازی()
    part.رهاسازی()
    full.رهاسازی()
    img.رهاسازی()
    حافظه.آزادسازی(data)
پایان
