بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    cv.پرکردن مستطیل گرد(نقاشی.مستطیل از(2.0، 2.0، 28.0، 20.0)، نقاشی.شعاع یکسان(8.0)، نقاشی.رنگ از سه مولفه(0، 0، 0))
    probe(cv، 2، 2)
    probe(cv، 3، 4)
    probe(cv، 4، 3)
    probe(cv، 5، 5)
    probe(cv، 16، 2)
    probe(cv، 16، 12)
    probe(cv، 29، 21)
    cv.پرکردن مستطیل گرد(نقاشی.مستطیل از(34.5، 2.5، 26.0، 20.0)، نقاشی.شعاع گوشه ها(0.0، 12.0، 4.0، 20.0)، نقاشی.رنگ از سه مولفه(0، 90، 200))
    probe(cv، 34، 2)
    probe(cv، 35، 3)
    probe(cv، 59، 3)
    probe(cv، 36، 21)
    big := نقاشی.شعاع‌ها { افقی بالا چپ = 40.0، عمودی بالا چپ = 10.0، افقی بالا راست = 40.0، عمودی بالا راست = 10.0، افقی پایین راست = 10.0، عمودی پایین راست = 30.0، افقی پایین چپ = 10.0، عمودی پایین چپ = 30.0 }
    r := نقاشی.مستطیل از(4.0، 26.0، 40.0، 20.0)
    f := نقاشی.برازش شعاع ها(r، big)
    سرچاپ "fit"، f.افقی بالا چپ، f.عمودی بالا چپ، f.افقی پایین راست، f.عمودی پایین راست
    cv.پرکردن مستطیل گرد(r، big، نقاشی.رنگ از چهار مولفه(200، 0، 0، 200))
    probe(cv، 4، 26)
    probe(cv، 24، 26)
    probe(cv، 24، 36)
    probe(cv، 5، 45)
    pill := نقاشی.برازش شعاع ها(نقاشی.مستطیل از(0.0، 0.0، 10.0، 4.0)، نقاشی.شعاع یکسان(100.0))
    سرچاپ "pill"، pill.افقی بالا چپ، pill.عمودی بالا چپ
    cv.پرکردن مستطیل گرد(نقاشی.مستطیل از(48.0، 30.0، 12.0، 12.0)، نقاشی.شعاع یکسان(6.0)، نقاشی.رنگ از سه مولفه(0، 160، 0))
    probe(cv، 54، 30)
    probe(cv، 54، 36)
    probe(cv، 49، 31)
    cv.پرکردن مستطیل گرد(نقاشی.مستطیل از(0.0، 0.0، 0.0، 10.0)، نقاشی.شعاع یکسان(2.0)، نقاشی.رنگ از سه مولفه(0، 0، 0))
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
پایان
