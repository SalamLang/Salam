بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(64، 48)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    r := نقاشی.مستطیل از(8.0، 8.0، 20.0، 14.0)
    cv.رسم سایه(r، نقاشی.شعاع یکسان(4.0)، نقاشی.سایه { جابجایی ایکس = 2.0، جابجایی ایگرگ = 3.0، تاری = 6.0، رنگ = نقاشی.رنگ از چهار مولفه(0، 0، 0، 200) })
    probe(cv، 18، 15)
    probe(cv، 18، 23)
    probe(cv، 18، 26)
    probe(cv، 18، 30)
    probe(cv، 30، 15)
    probe(cv، 4، 15)
    cv.رسم سایه(نقاشی.مستطیل از(36.0، 4.0، 20.0، 12.0)، نقاشی.شعاع یکسان(0.0)، نقاشی.سایه { گسترش = 2.0، رنگ = نقاشی.رنگ از سه مولفه(0، 0، 200) })
    probe(cv، 35، 10)
    probe(cv، 34، 10)
    probe(cv، 33، 10)
    probe(cv، 40، 10)
    cv.پرکردن مستطیل(نقاشی.مستطیل از(4.0، 30.0، 26.0، 14.0)، نقاشی.رنگ از سه مولفه(240، 240، 240))
    cv.رسم سایه(نقاشی.مستطیل از(4.0، 30.0، 26.0، 14.0)، نقاشی.شعاع یکسان(5.0)، نقاشی.سایه { تاری = 4.0، گسترش = 1.0، رنگ = نقاشی.رنگ از چهار مولفه(200، 0، 0، 255)، درونی = درست })
    probe(cv، 4، 37)
    probe(cv، 6، 37)
    probe(cv، 17، 37)
    probe(cv، 3، 37)
    cv.رسم سایه(نقاشی.مستطیل از(36.0، 30.0، 24.0، 14.0)، نقاشی.شعاع یکسان(3.0)، نقاشی.سایه { جابجایی ایکس = 3.0، رنگ = نقاشی.رنگ از چهار مولفه(0، 120، 0، 255)، درونی = درست })
    probe(cv، 37، 37)
    probe(cv، 40، 37)
    probe(cv، 48، 37)
    cv.رسم سایه(r، نقاشی.شعاع یکسان(0.0)، نقاشی.سایه { رنگ = نقاشی.رنگ از چهار مولفه(0، 0، 0، 0) })
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
پایان
