بسته ریشه

واردسازی رابط گرافیکی.نقاشی

تابع probe(cv: نقاشی.بوم، x: صحیح، y: صحیح):
    c := cv.پیکسل(x، y)
    سرچاپ "(" + x + "," + y + ")"، c.قرمز، c.سبز، c.آبی، c.آلفا
پایان

تابع ریشه:
    ناپایا cv := نقاشی.بوم تازه(120، 90)
    cv.پاک کردن(نقاشی.رنگ از سه مولفه(255، 255، 255))
    t := نقاشی.تبدیل جابجایی(-20.0، -15.0).سپس(نقاشی.تبدیل چرخش(30.0)).سپس(نقاشی.تبدیل کجی(10.0، 0.0)).سپس(نقاشی.تبدیل جابجایی(40.0، 40.0))
    سرچاپ "identity"، نقاشی.تبدیل همانی().همانی است()، t.همانی است()
    back := t.وارون تبدیل().اعمال روی نقطه(t.اعمال روی نقطه(نقاشی.نقطه { ایکس = 7.0، ایگرگ = 3.0 }))
    سرچاپ "round trip"، back.ایکس بزرگتر 6.999 و back.ایکس کوچکتر 7.001، back.ایگرگ بزرگتر 2.999 و back.ایگرگ کوچکتر 3.001
    box := نقاشی.تبدیل چرخش(90.0).نگاشت مستطیل(نقاشی.مستطیل از(0.0، 0.0، 10.0، 4.0))
    سرچاپ "mapped"، box.ایکس، box.ایگرگ، box.پهنا، box.بلندی
    sk := نقاشی.تبدیل کجی(45.0، 0.0).اعمال روی نقطه(نقاشی.نقطه { ایکس = 0.0، ایگرگ = 10.0 })
    سرچاپ "skewed"، sk.ایکس، sk.ایگرگ
    cv.افزودن تبدیل(t)
    cv.رسم سایه(نقاشی.مستطیل از(0.0، 0.0، 40.0، 30.0)، نقاشی.شعاع یکسان(6.0)، نقاشی.سایه { جابجایی ایکس = 3.0، جابجایی ایگرگ = 3.0، تاری = 6.0، رنگ = نقاشی.رنگ از چهار مولفه(0، 0، 0، 120) })
    ناپایا g := نقاشی.گرادیان خطی(90.0)
    g.افزودن ایست(0.0، نقاشی.رنگ از سه مولفه(255، 200، 0))
    g.افزودن ایست(1.0، نقاشی.رنگ از سه مولفه(0، 120، 255))
    cv.پرکردن گرادیان(نقاشی.مستطیل از(0.0، 0.0، 40.0، 30.0)، نقاشی.شعاع یکسان(6.0)، g)
    g.رهاسازی()
    ناپایا b := نقاشی.کادر توپر(3.0، نقاشی.رنگ از سه مولفه(200، 0، 0))
    b.رنگ چپ = نقاشی.رنگ از سه مولفه(0، 150، 0)
    cv.رسم کادر(نقاشی.مستطیل از(0.0، 0.0، 40.0، 30.0)، نقاشی.شعاع یکسان(6.0)، b)
    cv.افزودن برش گرد(نقاشی.مستطیل از(8.0، 8.0، 24.0، 14.0)، نقاشی.شعاع یکسان(4.0))
    cv.پرکردن مستطیل(نقاشی.مستطیل از(-20.0، -20.0، 100.0، 100.0)، نقاشی.رنگ از چهار مولفه(0، 0، 255، 128))
    cv.برداشتن برش()
    m := نقاشی.ماسک { داده = "\xff\xff\xff\xff\xff\xff\xff\xff\xff" برگردان تهی*، پهنا = 3، بلندی = 3، گام ردیف = 3 }
    cv.رسم ماسک(m، 2، 2، نقاشی.رنگ از سه مولفه(0، 0، 0))
    cv.برداشتن تبدیل()
    probe(cv، 40، 40)
    probe(cv، 22، 40)
    probe(cv، 5، 5)
    probe(cv، 62، 60)
    ناپایا d := نقاشی.کادر توپر(4.0، نقاشی.رنگ از سه مولفه(0، 0، 200))
    d.سبک بالا = نقاشی.سبک‌کادر.خط‌چین
    d.سبک راست = نقاشی.سبک‌کادر.خط‌چین
    d.سبک پایین = نقاشی.سبک‌کادر.نقطه‌چین
    d.سبک چپ = نقاشی.سبک‌کادر.نقطه‌چین
    cv.رسم کادر(نقاشی.مستطیل از(70.0، 4.0، 46.0، 40.0)، نقاشی.شعاع یکسان(14.0)، d)
    cv.رسم دورخط با سبک(نقاشی.مستطیل از(76.0، 56.0، 30.0، 20.0)، نقاشی.شعاع یکسان(4.0)، 2.0، 3.0، نقاشی.رنگ از سه مولفه(0، 0، 0)، نقاشی.سبک‌کادر.خط‌چین)
    probe(cv، 73، 8)
    probe(cv، 93، 6)
    probe(cv، 72، 26)
    probe(cv، 72، 52)
    سرچاپ "hash"، cv.چکیده()
    cv.رهاسازی()
پایان
