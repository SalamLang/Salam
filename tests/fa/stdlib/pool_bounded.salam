بسته ریشه

واردسازی حافظه
واردسازی استخر
واردسازی همگام سازی

ناپایا cur := پوچ برگردان صحیح۶۴*
ناپایا top := پوچ برگردان صحیح۶۴*
ناپایا fin := پوچ برگردان صحیح۶۴*

ناپایا gate := پوچ برگردان صحیح۶۴*

تابع work():
    now := اتمی‌بیفزا(cur، 1 برگردان صحیح۶۴)
    ناپایا peak := اتمی‌بخوان(top)
    تا now بزرگتر peak:
        اگر اتمی‌مقایسه(top، peak، now): بشکن پایان
        peak = اتمی‌بخوان(top)
    پایان
    همگام سازی.خواب میلی ثانیه(2)
    اتمی‌بیفزا(cur، 0 برگردان صحیح۶۴ - 1)
    اتمی‌بیفزا(fin، 1 برگردان صحیح۶۴)
پایان

تابع blocker():
    تا اتمی‌بخوان(gate) نابرابر 0:
        همگام سازی.خواب میلی ثانیه(1)
    پایان
پایان

تابع ریشه:
    cur = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    top = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    fin = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    p := استخر.جدید(4 برگردان صحیح۶۴، 8 برگردان صحیح۶۴)
    سرچاپ "workers: "، استخر.کارگرها(p)
    تکرار 200:
        استخر.ارسال(p، (): work() پایان)
    پایان
    استخر.انتظار(p)
    سرچاپ "done: "، اتمی‌بخوان(fin)
    سرچاپ "peak within limit: "، اتمی‌بخوان(top) کوچکتربرابر (4 برگردان صحیح۶۴)
    سرچاپ "idle: "، استخر.در حال اجرا(p)، استخر.در صف(p)

    تکرار 20:
        استخر.ارسال(p، (): work() پایان)
    پایان
    استخر.توقف(p)
    gate = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    اتمی‌بنویس(gate، 1 برگردان صحیح۶۴)
    q := استخر.جدید(1 برگردان صحیح۶۴، 1 برگردان صحیح۶۴)
    استخر.ارسال(q، (): blocker() پایان)
    تا استخر.در حال اجرا(q) برابر 0:
        همگام سازی.خواب میلی ثانیه(1)
    پایان
    سرچاپ "queued while full: "، استخر.تلاش برای ارسال(q، (): work() پایان)
    سرچاپ "rejected when full: "، استخر.تلاش برای ارسال(q، (): work() پایان)
    سرچاپ "pending: "، استخر.در صف(q)
    اتمی‌بنویس(gate، 0 برگردان صحیح۶۴)
    استخر.انتظار(q)
    سرچاپ "pending after wait: "، استخر.در صف(q)
    استخر.توقف(q)
    حافظه.آزادسازی(gate برگردان تهی*)
    سرچاپ "after stop: "، اتمی‌بخوان(fin)
    حافظه.آزادسازی(cur برگردان تهی*)
    حافظه.آزادسازی(top برگردان تهی*)
    حافظه.آزادسازی(fin برگردان تهی*)
پایان
