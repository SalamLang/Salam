بسته ریشه

واردسازی کانال
واردسازی حافظه
واردسازی استخر

ناپایا box := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
ناپایا got := پوچ برگردان صحیح۶۴*

تابع waiter():
    ناپایا ok := نادرست
    v := box.دریافت(ok)
    اتمی‌بنویس(got، v)
پایان

تابع sender():
    box.فرستادن(7 برگردان صحیح۶۴)
پایان

تابع ریشه:
    box.مقداردهی(1 برگردان صحیح۶۴)
    got = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    p := استخر.جدید کشسان(1 برگردان صحیح۶۴، 4 برگردان صحیح۶۴، 8 برگردان صحیح۶۴)
    سرچاپ "start: "، استخر.کارگرها(p)
    استخر.ارسال(p، (): waiter() پایان)
    استخر.ارسال(p، (): sender() پایان)
    استخر.انتظار(p)
    سرچاپ "received: "، اتمی‌بخوان(got)
    سرچاپ "grew: "، استخر.کارگرها(p) بزرگتر 1
    سرچاپ "capped: "، استخر.کارگرها(p) کوچکتربرابر 4
    استخر.توقف(p)
    box.آزادسازی()
    حافظه.آزادسازی(got برگردان تهی*)
پایان
