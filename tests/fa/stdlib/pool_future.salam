بسته ریشه

واردسازی استخر

تابع fib(n: صحیح۶۴): صحیح۶۴:
    اگر n کوچکتر 2:
        برگشت n
    پایان
    برگشت fib(n - 1) + fib(n - 2)
پایان

تابع greet(): رشته:
    برگشت "hello"
پایان

تابع ریشه:
    p := استخر.جدید(4 برگردان صحیح۶۴، 16 برگردان صحیح۶۴)
    a := استخر.ناهمزمان(p، (): برگشت fib(25 برگردان صحیح۶۴) پایان)
    b := استخر.ناهمزمان(p، (): برگشت fib(20 برگردان صحیح۶۴) پایان)
    c := استخر.ناهمزمان متن(p، (): برگشت greet() پایان)
    سرچاپ "fib25: "، استخر.منتظر ماندن(a)
    سرچاپ "fib20: "، استخر.منتظر ماندن(b)
    سرچاپ "str: "، استخر.منتظر ماندن متن(c)
    سرچاپ "ready: "، استخر.آماده(a)
    استخر.رها کردن(a)
    استخر.رها کردن(b)
    استخر.رها کردن(c)
    استخر.توقف(p)
پایان
