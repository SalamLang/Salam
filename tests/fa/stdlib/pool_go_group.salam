بسته ریشه

واردسازی حافظه
واردسازی استخر

ناپایا hits := پوچ برگردان صحیح۶۴*

تابع job(i: صحیح): رشته:
    اگر i برابر 7:
        برگشت "boom"
    پایان
    برگشت ""
پایان

تابع ریشه:
    hits = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    تکرار 50:
        استخر.برو((): اتمی‌بیفزا(hits، 1 برگردان صحیح۶۴) پایان)
    پایان
    استخر.انتظار برو()
    سرچاپ "go: "، اتمی‌بخوان(hits)

    g := استخر.گروه کار جدید(3 برگردان صحیح۶۴)
    تکرار 20 در i:
        استخر.گروه برو(g، (): برگشت job(i) پایان)
    پایان
    سرچاپ "err: "، استخر.گروه انتظار(g)
    سرچاپ "failed: "، استخر.گروه شکست خورده(g)
    استخر.گروه توقف(g)
پایان
