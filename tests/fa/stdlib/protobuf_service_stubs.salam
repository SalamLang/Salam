بسته ریشه

واردسازی کدگذاری.پروتوباف

تابع ریشه:
    src := `syntax = "proto3";
message Ping { string text = 1; }
message Pong { string text = 1; }
service Echo {
    rpc Once(Ping) returns (Pong);
    rpc Upload(stream Ping) returns (Pong);
    rpc Watch(Ping) returns (stream Pong);
    rpc Chat(stream Ping) returns (stream Pong);
}
`
    ناپایا ok := نادرست
    f := پروتوباف.تجزیه پرونده(src، ok)
    سرچاپ ok، پروتوباف.تعداد سرویس‌ها(f)، پروتوباف.نام سرویس(f، 0)، پروتوباف.تعداد متدهای سرویس(f، 0)
    سرچاپ پروتوباف.امضای متد(f، 0، 0)
    سرچاپ پروتوباف.امضای متد(f، 0، 1)
    سرچاپ پروتوباف.امضای متد(f، 0، 2)
    سرچاپ پروتوباف.امضای متد(f، 0، 3)
    سرچاپ پروتوباف.امضای متد(f، 0، 4) برابر ""، پروتوباف.امضای متد(f، 1، 0) برابر ""
    stubs := پروتوباف.تولید سرویس‌ها(f)
    سرچاپ stubs.طول() بزرگتر 0، stubs.دربردارد("Echo")، stubs.دربردارد("Upload")، stubs.دربردارد("Chat")
    plain := پروتوباف.تجزیه پرونده("message Solo { int32 id = 1; }"، ok)
    سرچاپ پروتوباف.تولید سرویس‌ها(plain) برابر ""
پایان
