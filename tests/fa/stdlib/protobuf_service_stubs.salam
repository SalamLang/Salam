بسته ریشه

واردسازی کدگذاری.پروتوباف

تابع ریشه:
    متن پروتو := `syntax = "proto3";
message Ping { string text = 1; }
message Pong { string text = 1; }
service Echo {
    rpc Once(Ping) returns (Pong);
    rpc Upload(stream Ping) returns (Pong);
    rpc Watch(Ping) returns (stream Pong);
    rpc Chat(stream Ping) returns (stream Pong);
}
`
    تلاش:
        f := پروتوباف.تجزیه پرونده(متن پروتو)
        سرچاپ پروتوباف.تعداد سرویس‌ها(f)، پروتوباف.نام سرویس(f، 0)، پروتوباف.تعداد متدهای سرویس(f، 0)
        سرچاپ پروتوباف.امضای متد(f، 0، 0)
        سرچاپ پروتوباف.امضای متد(f، 0، 1)
        سرچاپ پروتوباف.امضای متد(f، 0، 2)
        سرچاپ پروتوباف.امضای متد(f، 0، 3)
        سرچاپ پروتوباف.امضای متد(f، 0، 4) برابر ""، پروتوباف.امضای متد(f، 1، 0) برابر ""
        کد تولیدی := پروتوباف.تولید سرویس‌ها(f)
        سرچاپ کد تولیدی.طول() بزرگتر 0، کد تولیدی.دربردارد("Echo")، کد تولیدی.دربردارد("Upload")، کد تولیدی.دربردارد("Chat")
        پرونده ساده := پروتوباف.تجزیه پرونده("message Solo { int32 id = 1; }")
        سرچاپ پروتوباف.تولید سرویس‌ها(پرونده ساده) برابر ""
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    تلاش:
        _ := پروتوباف.تجزیه پرونده("service Broken { rpc Go(Ping) returns Pong; }")
        سرچاپ "parsed"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.نحو)، e.خط، e.کد
    پایان
پایان
