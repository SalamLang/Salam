بسته ریشه

واردسازی فشرده سازی
واردسازی کدگذاری.پروتوباف

تابع ریشه:
    سرچاپ پروتوباف.ساخت برچسب(1، پروتوباف.نوع سیم متغیر) برگردان صحیح، پروتوباف.ساخت برچسب(2، پروتوباف.نوع سیم طول‌دار) برگردان صحیح، پروتوباف.ساخت برچسب(15، پروتوباف.نوع سیم ثابت۳۲) برگردان صحیح

    سرچاپ پروتوباف.نام نوع فیلد(پروتوباف.نوع فیلد اعشار۶۴)، پروتوباف.نام نوع فیلد(پروتوباف.نوع فیلد صحیح۶۴ زیگزاگ)، پروتوباف.نام نوع فیلد(پروتوباف.نوع فیلد رشته)، پروتوباف.نام نوع فیلد(پروتوباف.نوع فیلد نگاشت)، پروتوباف.نام نوع فیلد(999)
    سرچاپ پروتوباف.نوع ساده از نام("double") برابر پروتوباف.نوع فیلد اعشار۶۴، پروتوباف.نوع ساده از نام("bytes") برابر پروتوباف.نوع فیلد بایت‌ها، پروتوباف.نوع ساده از نام("Widget")، پروتوباف.نوع ساده از نام(پروتوباف.نام نوع فیلد(پروتوباف.نوع فیلد ثابت علامت‌دار۳۲)) برابر پروتوباف.نوع فیلد ثابت علامت‌دار۳۲

    ناپایا بافر := فشرده سازی.بافر بایت جدید()
    پروتوباف.نوشتن رشته طول‌دار(بافر، "hello")
    پروتوباف.نوشتن رشته طول‌دار(بافر، "")
    ناپایا r := فشرده سازی.خواننده از بافر(بافر)
    تلاش:
        نخستین := پروتوباف.خواندن بافر طول‌دار(r)
        سرچاپ فشرده سازی.طول بافر(نخستین)، فشرده سازی.بافر به رشته(نخستین)
        دومین := پروتوباف.خواندن بافر طول‌دار(r)
        سرچاپ فشرده سازی.طول بافر(دومین)
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    تلاش:
        _ := پروتوباف.خواندن بافر طول‌دار(r)
        سرچاپ "read"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.اتمام ناگهانی)، e.کد، e.جایگاه
    پایان

    ناپایا بافر ناقص := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(بافر ناقص، 9)
    فشرده سازی.افزودن بایت(بافر ناقص، 97)
    ناپایا خواننده ناقص := فشرده سازی.خواننده از بافر(بافر ناقص)
    تلاش:
        _ := پروتوباف.خواندن بافر طول‌دار(خواننده ناقص)
        سرچاپ "read"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.اتمام ناگهانی)، e.کد، e.جایگاه
        سرچاپ e.به رشته()
    پایان
پایان
