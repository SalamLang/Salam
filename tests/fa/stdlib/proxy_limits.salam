واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تروجان

تابع closed_by_peer(c: تی سی پی.اتصال شبکه، wait_ms: صحیح): منطقی:
    تی سی پی.تنظیم مهلت خواندن(c، wait_ms)
    buf := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    n := تی سی پی.خواندن بایت(c، buf، 64)
    حافظه.آزادسازی(buf)
    برگشت n کوچکتربرابر 0
پایان

تابع first_line(c: تی سی پی.اتصال شبکه، wait_ms: صحیح): رشته:
    تی سی پی.تنظیم مهلت خواندن(c، wait_ms)
    text := تی سی پی.خواندن(c، 200)
    nl := text.بیاب("\r\n")
    اگر nl کوچکتر 0: برگشت "(" + text.طول() + " bytes)" پایان
    برگشت text.زیررشته(0، nl)
پایان

تابع drip_until_cut(port: صحیح، payload: رشته): منطقی:
    c := تی سی پی.شماره گیری("127.0.0.1"، port)
    started := همگام سازی.اکنون میلی ثانیه()
    ناپایا i := 0
    ناپایا alive := درست
    تا i کوچکتر payload.طول() و alive:
        اگر تی سی پی.نوشتن(c، payload.زیررشته(i، 1)) کوچکتربرابر 0: alive = نادرست پایان
        i++
        همگام سازی.خواب میلی ثانیه(250)
        اگر همگام سازی.اکنون میلی ثانیه() - started بزرگتر 4000: alive = نادرست پایان
    پایان
    waited := همگام سازی.اکنون میلی ثانیه() - started
    تی سی پی.بستن(c)
    برگشت waited کوچکتر 3500
پایان

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        تی سی پی.نوشتن(c، d)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع ریشه:
    es := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، es.توصیفگر برگردان تهی*)
    eport := تی سی پی.درگاه(es)

    ناپایا scfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(scfg، درست)
    scfg.بیشینه اتصال همزمان = 2
    scfg.بیشینه دست دادن مبدا = 0
    scfg.مهلت کل دست‌دهی = 900
    scfg.مهلت دست‌دهی میلی‌ثانیه = 6000
    ssv := ساکس.شروع(scfg)
    a1 := تی سی پی.شماره گیری("127.0.0.1"، ssv.درگاه)
    a2 := تی سی پی.شماره گیری("127.0.0.1"، ssv.درگاه)
    همگام سازی.خواب میلی ثانیه(150)
    a3 := تی سی پی.شماره گیری("127.0.0.1"، ssv.درگاه)
    سرچاپ "socks: third connection over the cap is closed at once:"، closed_by_peer(a3، 400)
    سرچاپ "socks: the two silent ones are cut at the total deadline:"، closed_by_peer(a1، 2500)، closed_by_peer(a2، 500)
    تی سی پی.بستن(a1)
    تی سی پی.بستن(a2)
    تی سی پی.بستن(a3)
    سرچاپ "socks: a one byte every 250 ms sender is cut:"، drip_until_cut(ssv.درگاه، "\x05\x01\x00\x05\x01\x00\x01\x7f\x00\x00\x01\x00\x50")
    r := ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، ssv.درگاه)، "127.0.0.1"، eport)
    سرچاپ "socks: the slot is free again and a normal client works:"، r.موفق
    اگر r.موفق: r.جریان.بستن() پایان
    ساکس.توقف(ssv)

    ناپایا hcfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(hcfg، درست)
    hcfg.بیشینه اتصال همزمان = 2
    hcfg.بیشینه دست دادن مبدا = 0
    hcfg.مهلت کل دست‌دهی = 900
    hcfg.مهلت دست‌دهی میلی‌ثانیه = 6000
    hsv := پراکسی اچ‌تی‌تی‌پی.شروع(hcfg)
    b1 := تی سی پی.شماره گیری("127.0.0.1"، hsv.درگاه)
    b2 := تی سی پی.شماره گیری("127.0.0.1"، hsv.درگاه)
    همگام سازی.خواب میلی ثانیه(150)
    b3 := تی سی پی.شماره گیری("127.0.0.1"، hsv.درگاه)
    سرچاپ "http: third connection over the cap gets:"، first_line(b3، 1000)
    سرچاپ "http: the two silent ones are cut at the total deadline:"، closed_by_peer(b1، 2500)، closed_by_peer(b2، 500)
    تی سی پی.بستن(b1)
    تی سی پی.بستن(b2)
    تی سی پی.بستن(b3)
    سرچاپ "http: a slow sender is cut:"، drip_until_cut(hsv.درگاه، "GET http://127.0.0.1/ HTTP/1.1\r\nHost: x\r\n\r\n")
    پراکسی اچ‌تی‌تی‌پی.توقف(hsv)

    ناپایا pcfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    pcfg.بیشینه دست دادن مبدا = 2
    pcfg.مهلت کل دست‌دهی = 5000
    psv := پراکسی اچ‌تی‌تی‌پی.شروع(pcfg)
    p1 := تی سی پی.شماره گیری("127.0.0.1"، psv.درگاه)
    p2 := تی سی پی.شماره گیری("127.0.0.1"، psv.درگاه)
    همگام سازی.خواب میلی ثانیه(150)
    p3 := تی سی پی.شماره گیری("127.0.0.1"، psv.درگاه)
    سرچاپ "http: a third pending handshake from one source gets:"، first_line(p3، 1000)
    تی سی پی.بستن(p1)
    تی سی پی.بستن(p2)
    تی سی پی.بستن(p3)
    پراکسی اچ‌تی‌تی‌پی.توقف(psv)

    ناپایا tcfg := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.افزودن گذرواژه(tcfg، "secret")
    tcfg.بیشینه اتصال همزمان = 2
    tcfg.بیشینه دست دادن مبدا = 0
    tcfg.مهلت کل دست‌دهی = 900
    tcfg.مهلت دست‌دهی = 6000
    tsv := تروجان.سرویس‌دهی بدون رمز(tcfg، 0)
    t1 := تی سی پی.شماره گیری("127.0.0.1"، tsv.درگاه)
    t2 := تی سی پی.شماره گیری("127.0.0.1"، tsv.درگاه)
    همگام سازی.خواب میلی ثانیه(150)
    t3 := تی سی پی.شماره گیری("127.0.0.1"، tsv.درگاه)
    سرچاپ "trojan: third connection over the cap is closed at once:"، closed_by_peer(t3، 400)
    سرچاپ "trojan: the two silent ones are cut at the total deadline:"، closed_by_peer(t1، 2500)، closed_by_peer(t2، 500)
    تی سی پی.بستن(t1)
    تی سی پی.بستن(t2)
    تی سی پی.بستن(t3)
    سرچاپ "trojan: a slow sender is cut:"، drip_until_cut(tsv.درگاه، "0123456789012345678901234567890123456789012345678901234567890123456789")
    تروجان.توقف(tsv)
پایان
