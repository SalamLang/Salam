واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.ساکس
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تروجان
واردسازی همگام سازی

ناپایا sink_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع sink():
    srv := تی سی پی.پیوند(0)
    sink_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    buf := حافظه.تخصیص(262144 برگردان طبیعی۶۴)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        ناپایا total := 0
        ناپایا bad := 0
        ناپایا tag := 0 - 1
        تا درست:
            n := تی سی پی.خواندن بایت(c، buf، 262144)
            اگر n کوچکتربرابر 0:
                بشکن
            پایان
            total += n
            اگر tag کوچکتر 0:
                tag = (buf برگردان طبیعی۸*)[0] برگردان صحیح
            پایان
            اگر (buf برگردان طبیعی۸*)[0] برگردان صحیح نابرابر tag یا (buf برگردان طبیعی۸*)[n - 1] برگردان صحیح نابرابر tag:
                bad++
            پایان
            اگر total بزرگتربرابر 16777216:
                _k := تی سی پی.نوشتن(c، "got " + total + " bad " + bad)
                بشکن
            پایان
        پایان
        تی سی پی.بستن(c)
    پایان
پایان

تابع fill(chunk: تهی*، tag: صحیح):
    حافظه.تنظیم(chunk، tag، 65536 برگردان طبیعی۶۴)
پایان

تابع send_tcp(c: تی سی پی.اتصال شبکه، tag: صحیح): رشته:
    chunk := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
    fill(chunk، tag)
    تکرار 256:
        _w := تی سی پی.نوشتن بایت(c، chunk، 65536)
    پایان
    حافظه.آزادسازی(chunk)
    got := تی سی پی.خواندن(c، 64)
    تی سی پی.بستن(c)
    برگشت got
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(sink)
    همگام سازی.انتظار(ready)

    ناپایا scfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(scfg، درست)
    sv := ساکس.شروع(scfg)
    cl := ساکس.کلاینت جدید("127.0.0.1"، sv.درگاه)
    سرچاپ "socks"، send_tcp(ساکس.شماره‌گیری اتصال(cl، "127.0.0.1"، sink_port)، 97)
    ساکس.توقف(sv)

    ناپایا hcfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(hcfg، درست)
    hs := پراکسی اچ‌تی‌تی‌پی.شروع(hcfg)
    hc := تی سی پی.شماره گیری("127.0.0.1"، hs.درگاه)
    _h := تی سی پی.نوشتن(hc، "CONNECT 127.0.0.1:" + sink_port + " HTTP/1.1\r\nHost: x\r\n\r\n")
    سرچاپ تی سی پی.خواندن(hc، 200).شروع با("HTTP/1.1 200")
    سرچاپ "httpproxy"، send_tcp(hc، 98)
    پراکسی اچ‌تی‌تی‌پی.توقف(hs)

    ناپایا cfg := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(cfg، درست)
    تروجان.افزودن گذرواژه(cfg، "p")
    srv := تروجان.سرویس‌دهی بدون رمز(cfg، 0)
    ناپایا cc := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، srv.درگاه، "p")
    cc.با تی ال اس = نادرست
    ناپایا link := تروجان.شماره گیری(cc، "127.0.0.1"، sink_port)
    chunk := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
    fill(chunk، 99)
    تکرار 256:
        _w := تروجان.نوشتن پیوند(link، chunk، 65536)
    پایان
    ab := حافظه.تخصیص(64 برگردان طبیعی۶۴)
    n := تروجان.خواندن پیوند(link، ab، 64)
    (ab برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    سرچاپ "trojan"، ab برگردان رشته
    تروجان.بستن پیوند(link)
    تروجان.توقف(srv)
پایان
