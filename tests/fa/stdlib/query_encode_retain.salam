بسته ریشه

واردسازی کدگذاری.پرس‌وجو

تابع ریشه:
    ناپایا vals := پرس‌وجو.نگاشت پرس‌وجو جدید()
    پرس‌وجو.تنظیم(vals، "q"، "a b")
    پرس‌وجو.افزودن(vals، "tag"، "x y")
    پرس‌وجو.افزودن(vals، "tag"، "z")
    سرچاپ پرس‌وجو.کدگذاری سفارشی(vals، پرس‌وجو.گزینه‌های پرس‌وجو { فاصله پلاس = درست })
    سرچاپ پرس‌وجو.کدگذاری سفارشی(vals، پرس‌وجو.گزینه‌های پرس‌وجو { فاصله پلاس = نادرست })
    سرچاپ پرس‌وجو.کدگذاری(vals) برابر پرس‌وجو.کدگذاری سفارشی(vals، پرس‌وجو.گزینه‌های پرس‌وجو {})

    تلاش:
        ناپایا m := پرس‌وجو.کدگشایی("a=1&b=2&c=3&c=4&d=5")
        سرچاپ پرس‌وجو.اندازه(m)
        ناپایا keep := وکتور {} برگردان وکتور<رشته>
        keep.بیفزا("b")
        keep.بیفزا("c")
        keep.بیفزا("missing")
        پرس‌وجو.نگه داشتن(m، keep)
        سرچاپ پرس‌وجو.اندازه(m)، پرس‌وجو.کدگذاری(m)
        سرچاپ پرس‌وجو.کلیدها(m).طول()، پرس‌وجو.حذف(m، "a")، پرس‌وجو.حذف(m، "b")
        none := وکتور {} برگردان وکتور<رشته>
        پرس‌وجو.نگه داشتن(m، none)
        سرچاپ پرس‌وجو.اندازه(m)، پرس‌وجو.کدگذاری(m) برابر ""
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    تلاش:
        _ := پرس‌وجو.کدگشایی("a=%G1")
        سرچاپ "decoded"
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.نحو)، e.جایگاه، e.به رشته()
    پایان
پایان
