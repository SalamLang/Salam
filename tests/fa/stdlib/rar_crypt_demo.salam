تابع رقم هگز(ک: صحیح): صحیح:
    اگر ک >= 48 و ک <= 57:
        برگشت ک - 48
    پایان
    اگر ک >= 97 و ک <= 102:
        برگشت ک - 87
    پایان
    برگشت -1
پایان

تابع ساخت از هگز(متن: رشته): فشرده سازی.بافر بایت:
    ناپایا خروجی := فشرده سازی.بافر بایت جدید()
    ب := متن برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار متن.طول() در ای:
        م := رقم هگز(ب[ای] برگردان صحیح)
        اگر م < 0:
            گذر
        پایان
        اگر بالا < 0:
            بالا = م
        وگرنه:
            فشرده سازی.افزودن بایت(خروجی، بالا * 16 + م)
            بالا = -1
        پایان
    پایان
    برگشت خروجی
پایان

تابع بررسی(برچسب: رشته، آرشیو: فشرده سازی.بافر بایت، گذرواژه: رشته):
    ناپایا گشوده := بایگانی.بازکردن آر ای آر(آرشیو.داده، آرشیو.طول، گذرواژه)
    ناپایا فهرست := بایگانی.مدخل‌های آر ای آر(گشوده)
    سرچاپ برچسب، فهرست.طول()، بایگانی.متن وضعیت آر ای آر(گشوده.وضعیت)
    تکرار فهرست.طول() در ای:
        م := فهرست.بگیر(ای)
        ناپایا خروجی := بایگانی.خواندن از آر ای آر(گشوده، م.نام، 0)
        سرچاپ " "، م.نام، خروجی.طول، فشرده سازی.چک جمع سی آر سی بافر(خروجی)، بایگانی.متن وضعیت آر ای آر(گشوده.وضعیت)
        فشرده سازی.آزادسازی بافر(خروجی)
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
پایان

تابع ریشه:
    ن۵ := ساخت از هگز(رمز۵)
    ن۴ := ساخت از هگز(رمز۴)
    بررسی("rar5"، ن۵، "")
    بررسی("rar5"، ن۵، "nope")
    بررسی("rar5"، ن۵، "secret")
    بررسی("rar4"، ن۴، "nope")
    بررسی("rar4"، ن۴، "password")
    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_rar_crypt_fa")
    سیستم عامل.حذف همه(پوشه)
    ناپایا گشوده۲ := بایگانی.بازکردن آر ای آر(ن۵.داده، ن۵.طول، "secret")
    سرچاپ بایگانی.خواندن همه از آر ای آر(گشوده۲، پوشه)
    سیستم عامل.حذف همه(پوشه)
پایان
