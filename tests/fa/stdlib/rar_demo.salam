بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی حافظه

پایا آرشیوآزمایشی := """
526172211a07010009efc86f0b0105070406010180808000f59006092302030bc300049c04a48302dcdfaa7280050105
612e7478740a031341fff06a00f2f92ec4de405543522f75043ded152822995a044050507ca7cbf17ff3c348ad0d2727
655f99a332a4c1ac1c51cad46312e761917434a437902ab22276d9e9f3b0b2cd03eb58c5ad77d22302030b9c0004b104
a4830220abc84ec0050105622e7478740a031341fff06ae4e7fa2e440719f5c9e63f0caebd274804c54d756dc27b960e
6971f66c94d170988ae3092702030b8000048000a4830200000000c0050109656d7074792e7478740a031341fff06ae4
e7fa2e1d77565103050400
"""

تابع رقم هگز(ک: صحیح): صحیح:
    اگر ک >= 48 و ک <= 57:
        برگشت ک - 48
    پایان
    اگر ک >= 97 و ک <= 102:
        برگشت ک - 87
    پایان
    برگشت -1
پایان

تابع ساخت از هگز(متن: رشته): فشرده سازی.بافر بایت:
    ناپایا خروجی := فشرده سازی.بافر بایت جدید()
    ب := متن برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار متن.طول() در ای:
        م := رقم هگز(ب[ای] برگردان صحیح)
        اگر م < 0:
            گذر
        پایان
        اگر بالا < 0:
            بالا = م
        وگرنه:
            فشرده سازی.افزودن بایت(خروجی، بالا * 16 + م)
            بالا = -1
        پایان
    پایان
    برگشت خروجی
پایان

تابع نمایش وضعیت(آرشیو: فشرده سازی.بافر بایت، نام: رشته):
    ناپایا وضعیت := 0
    ناپایا خروجی := بایگانی.استخراج آر ای آر(آرشیو.داده، آرشیو.طول، نام، 0، وضعیت)
    سرچاپ نام، خروجی.طول، فشرده سازی.چک جمع سی آر سی بافر(خروجی)، بایگانی.متن وضعیت آر ای آر(وضعیت)
    فشرده سازی.آزادسازی بافر(خروجی)
پایان

تابع ریشه:
    آرشیو := ساخت از هگز(آرشیوآزمایشی)
    سرچاپ بایگانی.آر ای آر است(آرشیو.داده، آرشیو.طول)
    ناپایا فهرست := بایگانی.فهرست آر ای آر(آرشیو.داده، آرشیو.طول)
    تکرار فهرست.طول() در ای:
        م := فهرست.بگیر(ای)
        سرچاپ م.نام، م.اندازه، م.اندازه فشرده، م.روش
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    نمایش وضعیت(آرشیو، "a.txt")
    نمایش وضعیت(آرشیو، "b.txt")
    نمایش وضعیت(آرشیو، "none.txt")

    متن اول := "hello rar world"
    متن دوم := "second file"
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده آر ای آر>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر("docs/"، پوچ، 0، درست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر("docs/hello.txt"، متن اول برگردان تهی*، متن اول.طول()، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر("docs/second.txt"، متن دوم برگردان تهی*، متن دوم.طول()، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر("../escape.txt"، متن دوم برگردان تهی*، متن دوم.طول()، نادرست))
    ساخته := بایگانی.ساخت آر ای آر(پرونده‌ها)
    سرچاپ بایگانی.آر ای آر است(ساخته.داده، ساخته.طول)، بایگانی.فهرست آر ای آر(ساخته.داده، ساخته.طول).طول()
    نمایش وضعیت(ساخته، "docs/hello.txt")
    ناپایا خوب := نادرست
    کوچک := بایگانی.استخراج با نام از آر ای آر با سقف(ساخته.داده، ساخته.طول، "docs/hello.txt"، 5، خوب)
    سرچاپ خوب، کوچک.طول
    دیسک := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_rar_demo_fa.rar")
    سرچاپ بایگانی.ساخت پرونده آر ای آر(پرونده‌ها، دیسک)
    پشت := بایگانی.خواندن پرونده دودویی(دیسک، خوب)
    سرچاپ خوب، پشت.طول == ساخته.طول
    سیستم عامل.حذف(دیسک)

    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_rar_demo_fa")
    سیستم عامل.حذف همه(پوشه)
    ناپایا وضعیت := 0
    تعداد := بایگانی.استخراج همه از آر ای آر با وضعیت(ساخته.داده، ساخته.طول، پوشه، وضعیت)
    سرچاپ تعداد، بایگانی.متن وضعیت آر ای آر(وضعیت)
    ناپایا موفق := نادرست
    محتوا := بایگانی.خواندن پرونده دودویی(مسیر پرونده.پیوند(پوشه، "docs/second.txt")، موفق)
    سرچاپ موفق، فشرده سازی.بافر به رشته(محتوا)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(پوشه، "../escape.txt"))
    سیستم عامل.حذف همه(پوشه)
    حافظه.آزادسازی(پوشه برگردان تهی*)
پایان
