تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع cat(a: رشته، b: رشته): رشته:
    برگشت مسیر پرونده.پیوند(a، b)
پایان

تابع check(label: رشته، hex: رشته، dir: رشته):
    ناپایا packed := unhex(hex)
    path := cat(dir، "a.rar")
    بایگانی.نوشتن پرونده دودویی از بافر(path، packed)
    ناپایا rf := بایگانی.بازکردن پرونده آر ای آر(path)
    سرچاپ label، "open"، rf.وضعیت، rf.جریانی
    ناپایا es := بایگانی.مدخل های پرونده آر ای آر(rf)
    ناپایا mem_list := بایگانی.فهرست آر ای آر(packed.داده، packed.طول)
    سرچاپ " entries"، es.طول()، mem_list.طول()
    out := cat(dir، "one.out")
    تکرار es.طول() در i:
        e := es.بگیر(i)
        اگر e.پوشه:
            گذر
        پایان
        st := بایگانی.استخراج از پرونده آر ای آر به پرونده(rf، e.نام، out، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)
        ناپایا mst := 0
        ناپایا ok := نادرست
        ناپایا disk := بایگانی.خواندن پرونده دودویی(out، ok)
        ناپایا want := بایگانی.استخراج آر ای آر(packed.داده، packed.طول، e.نام، 0، mst)
        سرچاپ " "، e.نام، st، disk.طول، فشرده سازی.چک جمع سی آر سی بافر(disk) برابر فشرده سازی.چک جمع سی آر سی بافر(want)
        فشرده سازی.آزادسازی بافر(disk)
        فشرده سازی.آزادسازی بافر(want)
    پایان
    سرچاپ " cap"، بایگانی.استخراج از پرونده آر ای آر به پرونده(rf، es.بگیر(0).نام، out، 1 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)، بایگانی.استخراج از پرونده آر ای آر به پرونده(rf، "none"، out، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)
    all := cat(dir، "all")
    سیستم عامل.حذف همه(all)
    سرچاپ " all"، بایگانی.استخراج همه از پرونده آر ای آر(rf، all، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)
    بایگانی.آزادسازی فهرست(es)
    بایگانی.آزادسازی فهرست(mem_list)
    بایگانی.بستن پرونده آر ای آر(rf)
    فشرده سازی.آزادسازی بافر(packed)
    حافظه.آزادسازی(path برگردان تهی*)
    حافظه.آزادسازی(out برگردان تهی*)
    حافظه.آزادسازی(all برگردان تهی*)
پایان

تابع ریشه:
    dir := cat(سیستم عامل.پوشه موقت()، "salam_rar_file_demo")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    check("solid"، SOLID، dir)
    check("filters"، FILT، dir)
    check("rar4"، LOWDIST، dir)
    path := cat(dir، "none.rar")
    ناپایا missing := بایگانی.بازکردن پرونده آر ای آر(path)
    سرچاپ "missing"، missing.وضعیت، بایگانی.متن وضعیت آر ای آر(missing.وضعیت)
    بایگانی.بستن پرونده آر ای آر(missing)
    ناپایا junk := فشرده سازی.بافر از رشته("not a rar file at all")
    path2 := cat(dir، "junk.rar")
    بایگانی.نوشتن پرونده دودویی از بافر(path2، junk)
    ناپایا bad := بایگانی.بازکردن پرونده آر ای آر(path2)
    سرچاپ "junk"، bad.وضعیت
    بایگانی.بستن پرونده آر ای آر(bad)
    فشرده سازی.آزادسازی بافر(junk)
    سیستم عامل.حذف همه(dir)
    حافظه.آزادسازی(dir برگردان تهی*)
    حافظه.آزادسازی(path برگردان تهی*)
    حافظه.آزادسازی(path2 برگردان تهی*)
    برگشت 0
پایان
