بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

پایا TINY := """
526172211a0701003392b5e50a010506000501018080007acabd512302030b980004bc00a4830232846b8280030105662e7478740a0313db8cf16a0f9a5303c28d152442fc32dd8533941c3c1bfc4d87761d6cb033ef401d77565103050400
"""

پایا BIG := """
526172211a0701003392b5e50a01050600050101808000d22a2f602602030b98000480bcc1960ba4830232846b82807b0105662e7478740a0313db8cf16a0f9a5303c28d152442fc32dd8533941c3c1bfc4d87761d6cb033ef401d77565103050400
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    ناپایا i := 0
    تا i کوچکتر s.طول():
        v := nib(bp[i] برگردان صحیح)
        i++
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع attempt(label: رشته، hex: رشته، memcap: صحیح۶۴):
    ناپایا b := unhex(hex)
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_rar_window.rar")
    dest := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_rar_window.out")
    _ := بایگانی.نوشتن پرونده دودویی از بافر(path، b)
    فشرده سازی.آزادسازی بافر(b)
    ناپایا rf := بایگانی.بازکردن پرونده آر ای آر(path)
    st := بایگانی.استخراج از پرونده آر ای آر به پرونده(rf، "f.txt"، dest، 0 برگردان صحیح۶۴، memcap)
    سرچاپ label، st، بایگانی.متن وضعیت آر ای آر(st)، st برابر بایگانی.آر ای آر پنجره بیش از حد بزرگ، سیستم عامل.وجود دارد(dest)
    بایگانی.بستن پرونده آر ای آر(rf)
    سیستم عامل.حذف(path)
    سیستم عامل.حذف(dest)
    حافظه.آزادسازی(path برگردان تهی*)
    حافظه.آزادسازی(dest برگردان تهی*)
پایان

تابع ریشه:
    attempt("normal"، TINY، 0 برگردان صحیح۶۴)
    attempt("small memcap"، TINY، 1000 برگردان صحیح۶۴)
    attempt("4 GiB dictionary claim"، BIG، 0 برگردان صحیح۶۴)
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.بایگانی پنجره بیش از حد بزرگ)
پایان
