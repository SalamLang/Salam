تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع extract(label: رشته، hex: رشته): رشته:
    ناپایا a := unhex(hex)
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_rar_links_" + label)
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا arc := بایگانی.بازکردن آر ای آر(a.داده، a.طول، "")
    n := بایگانی.خواندن همه از آر ای آر(arc، dir)
    سرچاپ label، n، بایگانی.متن وضعیت آر ای آر(arc.وضعیت)
    بایگانی.بستن آر ای آر(arc)
    فشرده سازی.آزادسازی بافر(a)
    برگشت dir
پایان

تابع read_size(path: رشته): صحیح:
    ناپایا ok := نادرست
    ناپایا b := بایگانی.خواندن پرونده دودویی(path، ok)
    اگر وارونه ok:
        برگشت -1
    پایان
    n := b.طول
    فشرده سازی.آزادسازی بافر(b)
    برگشت n
پایان

تابع ریشه:
    d := extract("sym5"، SYM5)
    سرچاپ "link size"، read_size(مسیر پرونده.پیوند(d، "data_link"))
    سرچاپ "target outside kept out"، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(d، "random_link"))
    data := مسیر پرونده.پیوند(d، "data.txt")
    سرچاپ "mode"، سیستم پرونده.مجوزها(data)، "mtime"، سیستم پرونده.زمان تغییر(data)
    e := extract("evil"، EVIL)
    سرچاپ "dir made"، سیستم عامل.پوشه است(مسیر پرونده.پیوند(e، "up"))، read_size(مسیر پرونده.پیوند(مسیر پرونده.پیوند(e، "up")، "pwned.txt"))
    سرچاپ "escaped"، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(مسیر پرونده.پیوند(e، "..")، "pwned.txt"))
    c := extract("dups"، DUPS)
    سرچاپ "copies"، read_size(مسیر پرونده.پیوند(c، "stest1.txt"))، read_size(مسیر پرونده.پیوند(c، "stest5.txt"))، read_size(مسیر پرونده.پیوند(c، "stest9.txt"))
    s := extract("sym4"، SYM4)
    سرچاپ "link size"، read_size(مسیر پرونده.پیوند(s، "data_link"))
    سرچاپ "unsafe link made"، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(s، "random_link"))
    برگشت 0
پایان
