بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

ساختار Bits:
    همگانی acc: صحیح
    همگانی n: صحیح
پایان

تابع put(out &: فشرده سازی.بافر بایت، b &: Bits، value: صحیح، count: صحیح):
    ناپایا i := count - 1
    تا i بزرگتربرابر 0:
        b.acc = (b.acc << 1) | ((value >> i) & 1)
        b.n++
        اگر b.n برابر 8:
            فشرده سازی.افزودن بایت(out، b.acc)
            b.acc = 0
            b.n = 0
        پایان
        i--
    پایان
پایان

تابع flush(out &: فشرده سازی.بافر بایت، b &: Bits):
    اگر b.n بزرگتر 0:
        فشرده سازی.افزودن بایت(out، b.acc << (8 - b.n))
        b.acc = 0
        b.n = 0
    پایان
پایان

تابع next(s: صحیح۶۴): صحیح۶۴:
    برگشت (s * 1103515245 + 12345) & 0x7fffffff
پایان

تابع data_bytes(count: صحیح): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید با ظرفیت(count + 16)
    ناپایا s := 99 برگردان صحیح۶۴
    تکرار count:
        s = next(s)
        فشرده سازی.افزودن بایت(out، ((s >> 16) & 255) برگردان صحیح)
    پایان
    برگشت out
پایان

تابع lz29_head(out &: فشرده سازی.بافر بایت، b &: Bits):
    put(out، b، 0، 2)
    تکرار 20 در i:
        put(out، b، (i برابر 8 یا i برابر 17 یا i برابر 18 یا i برابر 19) ? 2 : 0، 4)
    پایان
    put(out، b، 0، 2)
    put(out، b، 1، 2)
    put(out، b، 127، 7)
    put(out، b، 1، 2)
    put(out، b، 106، 7)
    put(out، b، 3، 2)
    put(out، b، 58، 7)
    put(out، b، 3، 2)
    put(out، b، 68، 7)
پایان

تابع lz20_head(out &: فشرده سازی.بافر بایت، b &: Bits):
    put(out، b، 0، 2)
    تکرار 19 در i:
        put(out، b، (i برابر 8 یا i بزرگتربرابر 16) ? 2 : 0، 4)
    پایان
    put(out، b، 0، 2)
    تکرار 42:
        put(out، b، 1، 2)
        put(out، b، 3، 2)
    پایان
    put(out، b، 1، 2)
    put(out، b، 0، 2)
    put(out، b، 3، 2)
    put(out، b، 107، 7)
پایان

تابع u16(b &: فشرده سازی.بافر بایت، v: صحیح):
    فشرده سازی.افزودن بایت(b، v & 255)
    فشرده سازی.افزودن بایت(b، (v >> 8) & 255)
پایان

تابع u32(b &: فشرده سازی.بافر بایت، v: صحیح۶۴):
    فشرده سازی.افزودن بایت(b، (v & 255) برگردان صحیح)
    فشرده سازی.افزودن بایت(b، ((v >> 8) & 255) برگردان صحیح)
    فشرده سازی.افزودن بایت(b، ((v >> 16) & 255) برگردان صحیح)
    فشرده سازی.افزودن بایت(b، ((v >> 24) & 255) برگردان صحیح)
پایان

تابع with_crc16(body: فشرده سازی.بافر بایت): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید با ظرفیت(body.طول + 4)
    u16(out، (فشرده سازی.چک جمع سی آر سی بافر(body) برگردان صحیح) & 0xffff)
    فشرده سازی.افزودن بافر(out، body)
    برگشت out
پایان

تابع build(ver: صحیح، high: منطقی، packed: فشرده سازی.بافر بایت، unp: صحیح، crc: طبیعی۳۲): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید با ظرفیت(packed.طول + 128)
    هر c در [0x52، 0x61، 0x72، 0x21، 0x1a، 0x07، 0x00]:
        فشرده سازی.افزودن بایت(out، c)
    پایان
    ناپایا mh := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(mh، 0x73)
    u16(mh، 0)
    u16(mh، 13)
    تکرار 6:
        فشرده سازی.افزودن بایت(mh، 0)
    پایان
    ناپایا mc := with_crc16(mh)
    فشرده سازی.افزودن بافر(out، mc)
    فشرده سازی.آزادسازی بافر(mh)
    فشرده سازی.آزادسازی بافر(mc)
    name := "big.bin"
    ناپایا fh := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(fh، 0x74)
    u16(fh، high ? 0x8100 : 0x8000)
    u16(fh، 32 + name.طول() + (high ? 8 : 0))
    u32(fh، packed.طول برگردان صحیح۶۴)
    u32(fh، unp برگردان صحیح۶۴)
    فشرده سازی.افزودن بایت(fh، 2)
    u32(fh، crc برگردان صحیح۶۴)
    u32(fh، 0x5a000000 برگردان صحیح۶۴)
    فشرده سازی.افزودن بایت(fh، ver)
    فشرده سازی.افزودن بایت(fh، 0x33)
    u16(fh، name.طول())
    u32(fh، 0x20 برگردان صحیح۶۴)
    اگر high:
        u32(fh، 0 برگردان صحیح۶۴)
        u32(fh، 0 برگردان صحیح۶۴)
    پایان
    فشرده سازی.افزودن بایت‌ها(fh، name برگردان تهی*، name.طول())
    ناپایا fc := with_crc16(fh)
    فشرده سازی.افزودن بافر(out، fc)
    فشرده سازی.آزادسازی بافر(fh)
    فشرده سازی.آزادسازی بافر(fc)
    فشرده سازی.افزودن بافر(out، packed)
    ناپایا eh := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(eh، 0x7b)
    u16(eh، 0x4000)
    u16(eh، 7)
    ناپایا ec := with_crc16(eh)
    فشرده سازی.افزودن بافر(out، ec)
    فشرده سازی.آزادسازی بافر(eh)
    فشرده سازی.آزادسازی بافر(ec)
    برگشت out
پایان

تابع check(label: رشته، ver: صحیح، high: منطقی، count: صحیح):
    ناپایا raw := data_bytes(count)
    want := فشرده سازی.چک جمع سی آر سی بافر(raw)
    ناپایا packed := فشرده سازی.بافر بایت جدید با ظرفیت(count + 64)
    ناپایا bits := Bits { acc = 0، n = 0 }
    اگر ver برابر 29:
        lz29_head(packed، bits)
        flush(packed، bits)
        فشرده سازی.افزودن بافر(packed، raw)
    وگرنه:
        lz20_head(packed، bits)
        تکرار raw.طول در i:
            put(packed، bits، فشرده سازی.دریافت بایت(raw، i)، 8)
        پایان
        flush(packed، bits)
    پایان
    ناپایا arc := build(ver، high، packed، count، want)
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_rar_stream_big.rar")
    dest := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_rar_stream_big.out")
    _ := بایگانی.نوشتن پرونده دودویی از بافر(path، arc)
    ناپایا rf := بایگانی.بازکردن پرونده آر ای آر(path)
    ناپایا es := بایگانی.مدخل های پرونده آر ای آر(rf)
    st := بایگانی.استخراج از پرونده آر ای آر به پرونده(rf، "big.bin"، dest، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)
    ناپایا ok := نادرست
    ناپایا got := بایگانی.خواندن پرونده دودویی(dest، ok)
    سرچاپ label، es.طول()، es.بگیر(0).اندازه، rf.جریانی، بایگانی.متن وضعیت آر ای آر(st)، got.طول برابر count، فشرده سازی.چک جمع سی آر سی بافر(got) برابر want
    فشرده سازی.آزادسازی بافر(got)
    بایگانی.آزادسازی فهرست(es)
    بایگانی.بستن پرونده آر ای آر(rf)
    سیستم عامل.حذف(path)
    سیستم عامل.حذف(dest)
    حافظه.آزادسازی(path برگردان تهی*)
    حافظه.آزادسازی(dest برگردان تهی*)
    فشرده سازی.آزادسازی بافر(raw)
    فشرده سازی.آزادسازی بافر(packed)
    فشرده سازی.آزادسازی بافر(arc)
پایان

تابع ریشه:
    check("rar 2.9 literals"، 29، نادرست، 6291456 + 777)
    check("rar 2.9 literals, 64 bit fields"، 29، درست، 100000)
    check("rar 2.0 literals"، 20، نادرست، 6291456 + 333)
پایان
