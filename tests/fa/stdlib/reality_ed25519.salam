واردسازی تی ال اس

تابع check(name: رشته، seed: رشته، pubhex: رشته، msg: رشته، sighex: رشته):
    ناپایا seedb := تی ال اس.کدگشایی شانزدهی(seed)
    ناپایا pubb := تی ال اس.بافر صفر جدید(32)
    تی ال اس.کلید عمومی ایدی۲۵۵۱۹(seedb.p، pubb.p)
    سرچاپ name، "pub"، تی ال اس.کدگذاری شانزدهی(pubb) برابر pubhex
    ناپایا m := تی ال اس.کدگشایی شانزدهی(msg)
    ناپایا sig := تی ال اس.بافر صفر جدید(64)
    تی ال اس.امضای ایدی۲۵۵۱۹(seedb.p، m.p، m.len، sig.p)
    سرچاپ name، "sig"، تی ال اس.کدگذاری شانزدهی(sig) برابر sighex
    سرچاپ name، "verify"، تی ال اس.بررسی امضای ایدی۲۵۵۱۹(pubb.p، m.p، m.len، sig.p)
    ناپایا bad := تی ال اس.کدگشایی شانزدهی(msg + "00")
    سرچاپ name، "tampered"، تی ال اس.بررسی امضای ایدی۲۵۵۱۹(pubb.p، bad.p، bad.len، sig.p)
    تی ال اس.آزادسازی بافر(bad)
    تی ال اس.آزادسازی بافر(seedb)
    تی ال اس.آزادسازی بافر(pubb)
    تی ال اس.آزادسازی بافر(m)
    تی ال اس.آزادسازی بافر(sig)
پایان

تابع ریشه:
    check("rfc1"، "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60"، "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"، ""، "e5564300c360ac729086e2cc806e828a84877f1eb8e5d974d873e065224901555fb8821590a33bacc61e39701cf9b46bd25bf5f0595bbe24655141438e7a100b")
    check("rfc2"، "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb"، "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"، "72"، "92a009a9f0d4cab8720e820b5f642540a2b27b5416503f8fb3762223ebdb69da085ac1e43e15996e458f3613d0f11d8c387b2eaeb4302aeeb00d291612bb0c00")
    check("openssl"، "dd8d8fbe2648ab0a93f168bba5c2056ea4e432251f455724bb3368c09e027ede"، "b22e2a3ea2ed8c2e8cf763ccc01e8a56bb3c85d9c709d72258d9443ffa04df22"، "68656c6c6f207265616c697479"، "68d3cb0c39ad1e6608aa9d9f8d11ad85659518188e8cea4f89aa360d756586c61094644249c5839a6d6232972adea5983c8b2dc0df4fb4ee6b2b053112217507")
پایان
