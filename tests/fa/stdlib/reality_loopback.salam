واردسازی شبکه.ریالیتی
واردسازی شبکه.تی سی پی
واردسازی تی ال اس

پایا PUB := "IH8tyHx_SyHSCyaQgNTOvHYefAehmhpbMgkwFeAPnXY"

ناپایا g_tls := تی ال اس.پیکربندی کارساز {}
ناپایا g_ss := ریالیتی.تنظیمات سرور {}

تابع dest_one(arg: تهی*):
    srv := تی سی پی.سرور { توصیفگر = arg برگردان صحیح۶۴ }
    c := تی سی پی.پذیرش(srv)
    اگر وارونه تی سی پی.اتصال معتبر(c):
        برگشت
    پایان
    ناپایا t := تی ال اس.پوشش کارساز(c.توصیفگر، g_tls)
    اگر تی ال اس.اتصال معتبر(t):
        تی ال اس.نوشتن(t، "this is the real site")
        تی ال اس.بستن اتصال(t)
    وگرنه:
        تی سی پی.بستن(c)
    پایان
پایان

تابع reality_one(arg: تهی*):
    srv := تی سی پی.سرور { توصیفگر = arg برگردان صحیح۶۴ }
    c := تی سی پی.پذیرش(srv)
    اگر وارونه تی سی پی.اتصال معتبر(c):
        برگشت
    پایان
    r := ریالیتی.پذیرش(c.توصیفگر، g_ss)
    اگر r.معتبر:
        ناپایا t := r.اتصال
        d := تی ال اس.خواندن(t، 4096)
        تی ال اس.نوشتن(t، "echo:" + r.شناسه کوتاه + ":" + d)
        تی ال اس.بستن اتصال(t)
    پایان
پایان

تابع run_client(good_key: منطقی، short_id: رشته): رشته:
    dest := تی سی پی.پیوند(0)
    dth := نخ‌ساز(dest_one، dest.توصیفگر برگردان تهی*)
    g_ss.مقصد = "127.0.0.1:" + تی سی پی.درگاه(dest)
    srv := تی سی پی.پیوند(0)
    sth := نخ‌ساز(reality_one، srv.توصیفگر برگردان تهی*)
    c := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(srv))
    ناپایا s := ریالیتی.تنظیمات {}
    s.نام سرور = "localhost"
    s.کلید عمومی = good_key ? PUB : ریالیتی.ساخت کلید().کلید عمومی
    s.شناسه کوتاه = short_id
    ناپایا t := ریالیتی.اتصال روی(c.توصیفگر، s)
    ناپایا out := ""
    اگر تی ال اس.اتصال معتبر(t):
        تی ال اس.نوشتن(t، "ping")
        out = تی ال اس.خواندن(t، 4096)
        تی ال اس.بستن اتصال(t)
    وگرنه:
        out = "error: " + تی ال اس.خطای اتصال(t)
        تی سی پی.بستن(c)
    پایان
    نخ‌پیوند(sth)
    تی سی پی.بستن(تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(dest)))
    نخ‌پیوند(dth)
    تی سی پی.بستن سرور(srv)
    تی سی پی.بستن سرور(dest)
    برگشت out
پایان

تابع probe(): رشته:
    dest := تی سی پی.پیوند(0)
    dth := نخ‌ساز(dest_one، dest.توصیفگر برگردان تهی*)
    g_ss.مقصد = "127.0.0.1:" + تی سی پی.درگاه(dest)
    srv := تی سی پی.پیوند(0)
    sth := نخ‌ساز(reality_one، srv.توصیفگر برگردان تهی*)
    c := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(srv))
    ناپایا cfg := تی ال اس.پیکربندی جدید("localhost")
    cfg.بدون بررسی گواهی = درست
    ناپایا t := تی ال اس.پوشش کارخواه(c.توصیفگر، cfg)
    ناپایا out := ""
    اگر تی ال اس.اتصال معتبر(t):
        out = تی ال اس.خواندن(t، 4096)
        تی ال اس.بستن اتصال(t)
    وگرنه:
        out = "error: " + تی ال اس.خطای اتصال(t)
        تی سی پی.بستن(c)
    پایان
    نخ‌پیوند(sth)
    تی سی پی.بستن(تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(dest)))
    نخ‌پیوند(dth)
    تی سی پی.بستن سرور(srv)
    تی سی پی.بستن سرور(dest)
    برگشت out
پایان

تابع ریشه:
    g_tls = تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    g_ss.کلید خصوصی = "QI3DpbA326sqI7QAAz13iSj6Jk9Q8UUvgkjlKZu2u2I"
    g_ss.نام های سرور = "localhost"
    g_ss.شناسه های کوتاه = "abcd1234,0a"

    سرچاپ "authenticated:"، run_client(درست، "abcd1234")
    سرچاپ "short empty rejected:"، run_client(درست، "")
    سرچاپ "second short id:"، run_client(درست، "0a")
    سرچاپ "unknown short id:"، run_client(درست، "ffff")
    سرچاپ "wrong server key:"، run_client(نادرست، "abcd1234")
    سرچاپ "probe sees the real site:"، probe()

    سرچاپ "public key of private:"، ریالیتی.کلید عمومی از خصوصی(g_ss.کلید خصوصی) برابر PUB
    kp := ریالیتی.ساخت کلید()
    سرچاپ "generated key:"، kp.کلید خصوصی.طول()، kp.کلید عمومی.طول()، ریالیتی.کلید عمومی از خصوصی(kp.کلید خصوصی) برابر kp.کلید عمومی
    سرچاپ "short id:"، ریالیتی.شناسه کوتاه جدید(8).طول()، ریالیتی.شناسه کوتاه معتبر("abcd1234")، ریالیتی.شناسه کوتاه معتبر("xyz")، ریالیتی.شناسه کوتاه معتبر("abc")
    سرچاپ "public key valid:"، ریالیتی.کلید عمومی معتبر(PUB)، ریالیتی.کلید عمومی معتبر("short")
    p := ریالیتی.خواندن پارامترها("security=reality&pbk=" + PUB + "&sid=ab12&spx=/x&sni=example.com&fp=firefox&flow=xtls-rprx-vision")
    سرچاپ p.کلید عمومی برابر PUB، p.شناسه کوتاه، p.مسیر عنکبوتی، p.نام سرور، p.اثر انگشت، p.جریان
    سرچاپ ریالیتی.نوشتن پارامترها(p)
پایان
