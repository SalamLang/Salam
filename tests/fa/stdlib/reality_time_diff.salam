واردسازی شبکه.ریالیتی
واردسازی شبکه.تی سی پی
واردسازی تی ال اس

ناپایا g_tls := تی ال اس.پیکربندی کارساز {}
ناپایا g_ss := ریالیتی.تنظیمات سرور {}

تابع dest_one(arg: تهی*):
    srv := تی سی پی.سرور { توصیفگر = arg برگردان صحیح۶۴ }
    c := تی سی پی.پذیرش(srv)
    اگر وارونه تی سی پی.اتصال معتبر(c):
        برگشت
    پایان
    ناپایا t := تی ال اس.پوشش کارساز(c.توصیفگر، g_tls)
    اگر تی ال اس.اتصال معتبر(t):
        تی ال اس.نوشتن(t، "this is the real site")
        تی ال اس.بستن اتصال(t)
    وگرنه:
        تی سی پی.بستن(c)
    پایان
پایان

تابع reality_one(arg: تهی*):
    srv := تی سی پی.سرور { توصیفگر = arg برگردان صحیح۶۴ }
    c := تی سی پی.پذیرش(srv)
    اگر وارونه تی سی پی.اتصال معتبر(c):
        برگشت
    پایان
    r := ریالیتی.پذیرش(c.توصیفگر، g_ss)
    اگر r.معتبر:
        ناپایا t := r.اتصال
        d := تی ال اس.خواندن(t، 4096)
        تی ال اس.نوشتن(t، "echo:" + d)
        تی ال اس.بستن اتصال(t)
    پایان
پایان

تابع run_client(skew_seconds: صحیح): رشته:
    dest := تی سی پی.پیوند(0)
    dth := نخ‌ساز(dest_one، dest.توصیفگر برگردان تهی*)
    g_ss.مقصد = "127.0.0.1:" + تی سی پی.درگاه(dest)
    srv := تی سی پی.پیوند(0)
    sth := نخ‌ساز(reality_one، srv.توصیفگر برگردان تهی*)
    c := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(srv))
    ناپایا s := ریالیتی.تنظیمات {}
    s.نام سرور = "localhost"
    s.کلید عمومی = ریالیتی.کلید عمومی از خصوصی(g_ss.کلید خصوصی)
    s.شناسه کوتاه = "abcd1234"
    s.جابجایی ساعت = skew_seconds
    ناپایا t := ریالیتی.اتصال روی(c.توصیفگر، s)
    ناپایا out := ""
    اگر تی ال اس.اتصال معتبر(t):
        تی ال اس.نوشتن(t، "ping")
        out = تی ال اس.خواندن(t، 4096)
        تی ال اس.بستن اتصال(t)
    وگرنه:
        out = "error: " + تی ال اس.خطای اتصال(t)
        تی سی پی.بستن(c)
    پایان
    نخ‌پیوند(sth)
    تی سی پی.بستن(تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(dest)))
    نخ‌پیوند(dth)
    تی سی پی.بستن سرور(srv)
    تی سی پی.بستن سرور(dest)
    برگشت out
پایان

تابع ریشه:
    g_tls = تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    g_ss.کلید خصوصی = "QI3DpbA326sqI7QAAz13iSj6Jk9Q8UUvgkjlKZu2u2I"
    g_ss.نام های سرور = "localhost"
    g_ss.شناسه های کوتاه = "abcd1234"

    سرچاپ "default max_time_diff:"، g_ss.بیشینه اختلاف زمان
    سرچاپ "clock right:"، run_client(0)
    سرچاپ "clock 30 s fast:"، run_client(30)
    سرچاپ "clock 30 s slow:"، run_client(0 - 30)
    سرچاپ "clock 5 minutes fast:"، run_client(300)
    سرچاپ "clock 5 minutes slow:"، run_client(0 - 300)
    g_ss.بیشینه اختلاف زمان = 0
    سرچاپ "check switched off, 5 minutes fast:"، run_client(300)
    g_ss.بیشینه اختلاف زمان = 400000
    سرچاپ "wider window, 5 minutes slow:"، run_client(0 - 300)
پایان
