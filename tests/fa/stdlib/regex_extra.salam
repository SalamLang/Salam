بسته ریشه

واردسازی عبارت باقاعده
واردسازی رشته

تابع show(v: وکتور<رشته>):
    ناپایا out := وکتور {} برگردان وکتور<رشته>
    دیرکن out.آزادکن()
    هر s در v:
        out.بیفزا("[" + s + "]")
    پایان
    سرچاپ v.طول()، رشته.بپیوند(out، "")
پایان

تابع ریشه:
    سرچاپ "first match"
    pair := عبارت باقاعده.کامپایل("([a-z]+)@([a-z]+)")
    text := "ali@home, sara@work"
    m := عبارت باقاعده.یافتن تطبیق(pair، text)
    سرچاپ m.موفق، m.آغاز، m.پایان، m.تعداد گروه‌ها
    سرچاپ عبارت باقاعده.گروه(m، 0)، عبارت باقاعده.گروه(m، 1)، عبارت باقاعده.گروه(m، 2)
    none := عبارت باقاعده.یافتن تطبیق(pair، "nothing here")
    سرچاپ none.موفق، none.آغاز، none.تعداد گروه‌ها

    سرچاپ "searching from an offset"
    second := عبارت باقاعده.یافتن تطبیق از(pair، text، m.پایان)
    سرچاپ second.موفق، second.آغاز، second.پایان
    سرچاپ عبارت باقاعده.گروه(second، 1)، عبارت باقاعده.گروه(second، 2)
    سرچاپ عبارت باقاعده.یافتن تطبیق از(pair، text، second.پایان).موفق
    سرچاپ عبارت باقاعده.یافتن تطبیق از(pair، text، 0).آغاز
    سرچاپ عبارت باقاعده.یافتن تطبیق از(pair، text، 100).موفق

    سرچاپ "groups as a list"
    parts := عبارت باقاعده.یافتن زیرتطبیق(pair، text)
    show(parts)
    parts.آزادکن()
    gone := عبارت باقاعده.یافتن زیرتطبیق(pair، "nothing here")
    show(gone)
    gone.آزادکن()
    dated := عبارت باقاعده.کامپایل("(\\d+)-(\\d+)-(\\d+)")
    ymd := عبارت باقاعده.یافتن زیرتطبیق(dated، "released 2026-11-02 today")
    show(ymd)
    ymd.آزادکن()

    سرچاپ "every match"
    words := عبارت باقاعده.یافتن همه(عبارت باقاعده.کامپایل("[a-z]+")، "one, two; three")
    show(words)
    words.آزادکن()
    digits := عبارت باقاعده.یافتن همه(عبارت باقاعده.کامپایل("\\d")، "a1b22c333")
    show(digits)
    digits.آزادکن()
    miss := عبارت باقاعده.یافتن همه(عبارت باقاعده.کامپایل("\\d")، "letters only")
    show(miss)
    miss.آزادکن()

    سرچاپ "templates"
    سرچاپ عبارت باقاعده.جایگزینی با بسط(pair، text، "$2:$1")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(pair، text، "$2:$1")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(pair، text، "<${1}>")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(pair، text، "$$1")
    سرچاپ عبارت باقاعده.جایگزینی با بسط(pair، "nothing here"، "$2:$1")
    named := عبارت باقاعده.کامپایل("(?P<user>[a-z]+)@(?P<host>[a-z]+)")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(named، text، "${host}/${user}")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(عبارت باقاعده.کامپایل("x*")، "abc"، "-")
پایان
