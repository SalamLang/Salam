بسته ریشه

واردسازی عبارت باقاعده
واردسازی رشته

تابع نمایش(v: وکتور<رشته>):
    ناپایا خروجی := وکتور {} برگردان وکتور<رشته>
    دیرکن خروجی.آزادکن()
    هر s در v:
        خروجی.بیفزا("[" + s + "]")
    پایان
    سرچاپ v.طول()، رشته.بپیوند(خروجی، "")
پایان

تابع اجرا() خطادار:
    سرچاپ "first match"
    الگو := تلاش عبارت باقاعده.کامپایل("([a-z]+)@([a-z]+)")
    متن := "ali@home, sara@work"
    m := عبارت باقاعده.یافتن تطبیق(الگو، متن)
    سرچاپ m.موفق، m.آغاز، m.پایان، m.تعداد گروه‌ها
    سرچاپ عبارت باقاعده.گروه(m، 0)، عبارت باقاعده.گروه(m، 1)، عبارت باقاعده.گروه(m، 2)
    تطبیق ناموفق := عبارت باقاعده.یافتن تطبیق(الگو، "nothing here")
    سرچاپ تطبیق ناموفق.موفق، تطبیق ناموفق.آغاز، تطبیق ناموفق.تعداد گروه‌ها

    سرچاپ "searching from an offset"
    تطبیق دوم := عبارت باقاعده.یافتن تطبیق از(الگو، متن، m.پایان)
    سرچاپ تطبیق دوم.موفق، تطبیق دوم.آغاز، تطبیق دوم.پایان
    سرچاپ عبارت باقاعده.گروه(تطبیق دوم، 1)، عبارت باقاعده.گروه(تطبیق دوم، 2)
    سرچاپ عبارت باقاعده.یافتن تطبیق از(الگو، متن، تطبیق دوم.پایان).موفق
    سرچاپ عبارت باقاعده.یافتن تطبیق از(الگو، متن، 0).آغاز
    سرچاپ عبارت باقاعده.یافتن تطبیق از(الگو، متن، 100).موفق

    سرچاپ "groups as a list"
    قطعه ها := عبارت باقاعده.یافتن زیرتطبیق(الگو، متن)
    نمایش(قطعه ها)
    قطعه ها.آزادکن()
    نتیجه خالی := عبارت باقاعده.یافتن زیرتطبیق(الگو، "nothing here")
    نمایش(نتیجه خالی)
    نتیجه خالی.آزادکن()
    الگوی تاریخ := تلاش عبارت باقاعده.کامپایل("(\\d+)-(\\d+)-(\\d+)")
    تاریخ := عبارت باقاعده.یافتن زیرتطبیق(الگوی تاریخ، "released 2026-11-02 today")
    نمایش(تاریخ)
    تاریخ.آزادکن()

    سرچاپ "every match"
    واژه ها := عبارت باقاعده.یافتن همه(تلاش عبارت باقاعده.کامپایل("[a-z]+")، "one, two; three")
    نمایش(واژه ها)
    واژه ها.آزادکن()
    ارقام := عبارت باقاعده.یافتن همه(تلاش عبارت باقاعده.کامپایل("\\d")، "a1b22c333")
    نمایش(ارقام)
    ارقام.آزادکن()
    بدون رقم := عبارت باقاعده.یافتن همه(تلاش عبارت باقاعده.کامپایل("\\d")، "letters only")
    نمایش(بدون رقم)
    بدون رقم.آزادکن()

    سرچاپ "templates"
    سرچاپ عبارت باقاعده.جایگزینی با بسط(الگو، متن، "$2:$1")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(الگو، متن، "$2:$1")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(الگو، متن، "<${1}>")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(الگو، متن، "$$1")
    سرچاپ عبارت باقاعده.جایگزینی با بسط(الگو، "nothing here"، "$2:$1")
    الگوی نام دار := تلاش عبارت باقاعده.کامپایل("(?P<user>[a-z]+)@(?P<host>[a-z]+)")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(الگوی نام دار، متن، "${host}/${user}")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(تلاش عبارت باقاعده.کامپایل("x*")، "abc"، "-")
پایان

تابع ریشه:
    تلاش:
        اجرا()
    گرفتن خطا خ:
        سرچاپ "unexpected error: " + خ.به رشته()
    پایان
پایان
