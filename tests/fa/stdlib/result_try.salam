واردسازی نتیجه

روال عدد(م: رشته): نتیجه.نتیجه<صحیح، رشته>:
    اگر م == "۷":
        برگشت نتیجه.نتیجه.Ok(۷)
    پایان
    برگشت نتیجه.نتیجه.Err("نامعتبر: " + م)
پایان

روال جمع(الف: رشته، ب: رشته): نتیجه.نتیجه<صحیح، رشته>:
    ا := عدد(الف)?
    ب۲ := عدد(ب)?
    برگشت نتیجه.نتیجه.Ok(ا + ب۲)
پایان

روال شرح(ن: نتیجه.نتیجه<صحیح، رشته>): رشته:
    برگشت همخوان ن:
        Ok(م): "درست: " + م پایان
        Err(خ): "خطا: " + خ پایان
    پایان
پایان

روال ریشه:
    سرچاپ شرح(جمع("۷"، "۷"))
    سرچاپ شرح(جمع("۷"، "x"))
    سرچاپ عدد("۷")
پایان
