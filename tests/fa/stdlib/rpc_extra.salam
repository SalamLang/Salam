تابع خدمت خطی():
    c := تی سی پی.پذیرش(خادم خطی)
    آزمایش.ادعای برابری عدد(فراخوان دور.خدمت به اتصال(c.توصیفگر، فراخوان دور.کدک جیسون، فراخوان دور.قاب خطی)، 2)
    تی سی پی.بستن(c)
پایان

تابع بررسی سازنده ها():
    ناپایا آرگومان ها := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(آرگومان ها، مقدار.مقدار صحیح(7 برگردان صحیح۶۴))
    مقدار.افزودن به آرایه(آرگومان ها، مقدار.مقدار رشته("txt"))
    مقدار.افزودن به آرایه(آرگومان ها، مقدار.مقدار منطقی(درست))
    مقدار.افزودن به آرایه(آرگومان ها، مقدار.مقدار اعشاری(1.5))
    درخواست := فراخوان دور.درخواست با شناسه متنی("m"، آرگومان ها، "abc")
    آزمایش.ادعای درستی(درخواست.شناسه دارد)
    آزمایش.ادعای برابری رشته(مقدار.به رشته(درخواست.شناسه)، "abc")
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری درخواست جیسون(درخواست)، `{"jsonrpc": "2.0", "method": "m", "params": [7, "txt", true, 1.5], "id": "abc"}`)
    آزمایش.ادعای برابری عدد۶۴(مقدار.به صحیح(فراخوان دور.پارامتر در جایگاه(درخواست، 0))، 7)
    آزمایش.ادعای درستی(مقدار.تهی است(فراخوان دور.پارامتر در جایگاه(درخواست، 9)))
    آزمایش.ادعای برابری رشته(فراخوان دور.پارامتر متنی(درخواست، ""، 1)، "txt")
    آزمایش.ادعای درستی(فراخوان دور.پارامتر بولی(درخواست، ""، 2))
    آزمایش.ادعای درستی(فراخوان دور.پارامتر اعشاری(درخواست، ""، 3) بزرگتر 1.49 و فراخوان دور.پارامتر اعشاری(درخواست، ""، 3) کوچکتر 1.51)
    آزمایش.ادعای درستی(فراخوان دور.پارامتر دارد(درخواست، ""، 0))
    آزمایش.ادعای نادرستی(فراخوان دور.پارامتر دارد(درخواست، ""، 8))

    ناپایا پارامتر نام دار := مقدار.شیء جدید()
    مقدار.تنظیم کلید(پارامتر نام دار، "who"، مقدار.مقدار رشته("ali"))
    اعلان := فراخوان دور.اعلان جدید("hello"، پارامتر نام دار)
    آزمایش.ادعای درستی(فراخوان دور.اعلان است(اعلان))
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری درخواست جیسون(اعلان)، `{"jsonrpc": "2.0", "method": "hello", "params": {"who": "ali"}}`)
    آزمایش.ادعای برابری رشته(مقدار.به رشته(فراخوان دور.پارامتر نام‌دار(اعلان، "who"))، "ali")
    آزمایش.ادعای درستی(مقدار.تهی است(فراخوان دور.پارامتر نام‌دار(اعلان، "nobody")))
    آزمایش.ادعای درستی(فراخوان دور.پارامتر دارد(اعلان، "who"، 0))
    آزمایش.ادعای نادرستی(فراخوان دور.پارامتر دارد(اعلان، "nobody"، 0))

    پاسخ خوب := فراخوان دور.پاسخ جدید(مقدار.مقدار صحیح(3 برگردان صحیح۶۴)، مقدار.مقدار اعشاری(2.5))
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(پاسخ خوب) بزرگتر 2.49 و فراخوان دور.نتیجه اعشاری(پاسخ خوب) کوچکتر 2.51)
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری پاسخ جیسون(پاسخ خوب)، `{"jsonrpc": "2.0", "result": 2.5, "id": 3}`)
    آزمایش.ادعای برابری رشته(فراخوان دور.پیام خطا(پاسخ خوب)، "")

    خطای نمونه := فراخوان دور.خطا با داده(0 - 5، "boom"، مقدار.مقدار رشته("d"))
    آزمایش.ادعای درستی(خطای نمونه.داده دارد)
    پاسخ بد := فراخوان دور.پاسخ خطا(مقدار.مقدار صحیح(4 برگردان صحیح۶۴)، خطای نمونه)
    آزمایش.ادعای برابری رشته(فراخوان دور.پیام خطا(پاسخ بد)، "boom")
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(پاسخ بد) برابر 0.0)
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری پاسخ جیسون(پاسخ بد)، `{"jsonrpc": "2.0", "error": {"code": -5, "message": "boom", "data": "d"}, "id": 4}`)

    خطای پیش فرض := فراخوان دور.خطای استاندارد(فراخوان دور.کد روش یافت نشد)
    آزمایش.ادعای برابری رشته(خطای پیش فرض.پیام، "Method not found")
    آزمایش.ادعای نادرستی(خطای پیش فرض.داده دارد)
    آزمایش.ادعای برابری رشته(فراخوان دور.خطای سطح بالای جیسون(فراخوان دور.خطای استاندارد(فراخوان دور.کد خطای تجزیه))، `{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}`)

    ناپایا مجموعه پاسخ ها := فراخوان دور.پاسخ‌ها {}
    مجموعه پاسخ ها.به شکل آرایه = درست
    مجموعه پاسخ ها.پاسخ‌ها.بیفزا(پاسخ خوب)
    مجموعه پاسخ ها.پاسخ‌ها.بیفزا(پاسخ بد)
    آزمایش.ادعای درستی(فراخوان دور.کدگذاری پاسخ‌های جیسون(مجموعه پاسخ ها).طول() بزرگتر 0)
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری پاسخ‌های جیسون(مجموعه پاسخ ها).زیررشته(0، 1)، "[")
پایان

تابع بررسی کدک ها():
    ناپایا آرگومان ها := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(آرگومان ها، مقدار.مقدار صحیح(8 برگردان صحیح۶۴))
    درخواست := فراخوان دور.درخواست جدید("half"، آرگومان ها، 21 برگردان صحیح۶۴)

    ناپایا بافر سیم := فراخوان دور.کدگذاری درخواست(فراخوان دور.کدک مسگ‌پک، درخواست)
    آزمایش.ادعای درستی(فشرده سازی.طول بافر(بافر سیم) بزرگتر 0)
    دسته := فراخوان دور.کدگشایی دسته(فراخوان دور.کدک مسگ‌پک، بافر سیم)
    آزمایش.ادعای درستی(دسته.خوانده‌شده)
    آزمایش.ادعای برابری رشته(دسته.درخواست‌ها.بگیر(0).متد، "half")
    دسته دوم := فراخوان دور.کدگشایی دسته مسگ‌پک(بافر سیم)
    آزمایش.ادعای برابری عدد(دسته دوم.درخواست‌ها.طول()، 1)
    آزمایش.ادعای برابری عدد۶۴(دسته دوم.درخواست‌ها.بگیر(0).شناسه عددی، 21)

    خروجی := فراخوان دور.اجرای دسته(دسته)
    آزمایش.ادعای برابری عدد(خروجی.پاسخ‌ها.طول()، 1)
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(خروجی.پاسخ‌ها.بگیر(0)) بزرگتر 3.99 و فراخوان دور.نتیجه اعشاری(خروجی.پاسخ‌ها.بگیر(0)) کوچکتر 4.01)

    ناپایا فشرده شده := فراخوان دور.کدگذاری پاسخ‌ها(فراخوان دور.کدک مسگ‌پک، خروجی)
    ناپایا موفق := نادرست
    رمزگشایی شده := فراخوان دور.کدگشایی پاسخ(فراخوان دور.کدک مسگ‌پک، فشرده شده، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(رمزگشایی شده) بزرگتر 3.99 و فراخوان دور.نتیجه اعشاری(رمزگشایی شده) کوچکتر 4.01)

    ناپایا پاسخ تکی := فراخوان دور.کدگذاری پاسخ مسگ‌پک(خروجی.پاسخ‌ها.بگیر(0))
    آزمایش.ادعای درستی(فشرده سازی.طول بافر(پاسخ تکی) بزرگتر 0)
    ناپایا موفق دوم := نادرست
    دوباره := فراخوان دور.کدگشایی پاسخ مسگ‌پک(پاسخ تکی، موفق دوم)
    آزمایش.ادعای درستی(موفق دوم)
    آزمایش.ادعای برابری عدد۶۴(دوباره.شناسه عددی، 21)

    ناپایا خطای بالا := فراخوان دور.کدگذاری خطای سطح بالا(فراخوان دور.کدک مسگ‌پک، فراخوان دور.خطای استاندارد(فراخوان دور.کد خطای تجزیه))
    آزمایش.ادعای درستی(فشرده سازی.طول بافر(خطای بالا) بزرگتر 0)
    ناپایا خطای بالا جیسون := فراخوان دور.کدگذاری خطای سطح بالا(فراخوان دور.کدک جیسون، فراخوان دور.خطای استاندارد(فراخوان دور.کد خطای تجزیه))
    آزمایش.ادعای شامل بودن(فشرده سازی.بافر به رشته(خطای بالا جیسون)، "Parse error")
    فشرده سازی.آزادسازی بافر(خطای بالا جیسون)
    فشرده سازی.آزادسازی بافر(خطای بالا)
    فشرده سازی.آزادسازی بافر(پاسخ تکی)
    فشرده سازی.آزادسازی بافر(فشرده شده)
    فشرده سازی.آزادسازی بافر(بافر سیم)
پایان

تابع بررسی مدیرها():
    ناپایا r := فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"info","params":[1,2,3],"id":1}`)
    آزمایش.ادعای شامل بودن(r، `"result": "info:3:false:true"`)
    r = فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"half","params":{"x":5},"id":2}`)
    آزمایش.ادعای شامل بودن(r، `"result": 2.5`)
    r = فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"flag","params":{"on":true},"id":3}`)
    آزمایش.ادعای شامل بودن(r، `"result": true`)
    r = فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"nothing","id":4}`)
    آزمایش.ادعای شامل بودن(r، `"result": null`)
    r = فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"deny","id":5}`)
    آزمایش.ادعای شامل بودن(r، `"code": -32001`)
    آزمایش.ادعای شامل بودن(r، `"data": "why"`)
پایان

تابع بررسی یاری جریان():
    ناپایا s := فراخوان دور.جریان حافظه()
    آزمایش.ادعای برابری عدد(فراخوان دور.باقی‌مانده جریان(s)، 0)
    فراخوان دور.تغذیه متن(s، "abc\nde")
    آزمایش.ادعای برابری عدد(فراخوان دور.باقی‌مانده جریان(s)، 6)
    ناپایا موفق := نادرست
    آزمایش.ادعای برابری رشته(فراخوان دور.خواندن قاب متنی(s، فراخوان دور.قاب خطی، موفق)، "abc")
    آزمایش.ادعای برابری عدد(فراخوان دور.باقی‌مانده جریان(s)، 2)
    آزمایش.ادعای نادرستی(فراخوان دور.جریان بسته(s))
    فراخوان دور.آزادسازی جریان(s)

    ناپایا قاب بندی شده := فراخوان دور.قاب‌بندی متن(فراخوان دور.قاب سرآیندی، "hello")
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(قاب بندی شده)، "Content-Length: 5\r\n\r\nhello")
    ناپایا خط := فراخوان دور.قاب‌بندی متن(فراخوان دور.قاب خطی، "hello")
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(خط)، 6)
    فشرده سازی.آزادسازی بافر(خط)
    فشرده سازی.آزادسازی بافر(قاب بندی شده)
پایان

تابع بررسی فراخوان زنده():
    همگام سازی.افزودن(گروه انتظار خادم، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(خدمت حلقه محلی)
    همگام سازی.انتظار(گروه انتظار خادم)
    آزمایش.ادعای درستی(درگاه متصل بزرگتر 0)

    اتصال := تی سی پی.شماره گیری("127.0.0.1"، درگاه متصل)
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(اتصال))
    ناپایا c := فراخوان دور.کارخواه از توصیف‌گر(اتصال.توصیفگر، فراخوان دور.کدک جیسون)
    فراخوان دور.تنظیم قاب‌بندی کارخواه(c، فراخوان دور.قاب سرآیندی)
    آزمایش.ادعای درستی(فراخوان دور.کارخواه معتبر(c))
    آزمایش.ادعای برابری رشته(فراخوان دور.خطای کارخواه(c)، "")

    ناپایا آرگومان ها := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(آرگومان ها، مقدار.مقدار اعشاری(9.0))
    نتیجه نیم := فراخوان دور.فراخوان(c، "half"، آرگومان ها)
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(نتیجه نیم) بزرگتر 4.49 و فراخوان دور.نتیجه اعشاری(نتیجه نیم) کوچکتر 4.51)

    ناپایا درخواست ها := وکتور {} برگردان وکتور<فراخوان دور.درخواست>
    درخواست ها.بیفزا(فراخوان دور.درخواست جدید("half"، آرگومان ها، 0 برگردان صحیح۶۴))
    درخواست ها.بیفزا(فراخوان دور.اعلان جدید("nothing"، مقدار.آرایه جدید()))
    درخواست ها.بیفزا(فراخوان دور.درخواست جدید("deny"، مقدار.آرایه جدید()، 0 برگردان صحیح۶۴))
    پاسخ های دسته := فراخوان دور.فراخوان دسته‌ای(c، درخواست ها)
    آزمایش.ادعای برابری عدد(پاسخ های دسته.پاسخ‌ها.طول()، 2)
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(پاسخ های دسته.پاسخ‌ها.بگیر(0)) بزرگتر 4.49)
    آزمایش.ادعای برابری رشته(فراخوان دور.پیام خطا(پاسخ های دسته.پاسخ‌ها.بگیر(1))، "denied")

    فراخوان دور.بستن کارخواه(c)
    پس از بستن := فراخوان دور.فراخوان(c، "half"، آرگومان ها)
    آزمایش.ادعای درستی(فراخوان دور.پاسخ خطاست(پس از بستن))
    آزمایش.ادعای برابری رشته(فراخوان دور.خطای کارخواه(c)، "client is not connected")

    نخ‌پیوند(t)

    خادم خطی = تی سی پی.پیوند(0)
    نخ دوم := نخ‌ساز(خدمت خطی)
    اتصال خام := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(خادم خطی))
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(اتصال خام))
    آزمایش.ادعای درستی(فراخوان دور.نوشتن قاب متنی(اتصال خام.توصیفگر، فراخوان دور.قاب خطی، `{"jsonrpc":"2.0","method":"half","params":[3],"id":1}`))
    ناپایا بدنه := فشرده سازی.بافر از رشته(`{"jsonrpc":"2.0","method":"flag","params":[true],"id":2}`)
    آزمایش.ادعای درستی(فراخوان دور.نوشتن قاب(اتصال خام.توصیفگر، فراخوان دور.قاب خطی، بدنه))
    ناپایا جریان := فراخوان دور.جریان جدید(اتصال خام.توصیفگر)
    ناپایا موفق := نادرست
    نخستین := فراخوان دور.خواندن قاب متنی(جریان، فراخوان دور.قاب خطی، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای شامل بودن(نخستین، `"result": 1.5`)
    دومین := فراخوان دور.خواندن قاب متنی(جریان، فراخوان دور.قاب خطی، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای شامل بودن(دومین، `"result": true`)
    فراخوان دور.آزادسازی جریان(جریان)
    فشرده سازی.آزادسازی بافر(بدنه)
    تی سی پی.بستن(اتصال خام)
    نخ‌پیوند(نخ دوم)
    تی سی پی.بستن سرور(خادم خطی)
