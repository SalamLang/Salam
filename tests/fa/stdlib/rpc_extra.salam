بسته ریشه

واردسازی فراخوان دور
واردسازی کدگذاری.مقدار
واردسازی فشرده سازی
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.تی سی پی
واردسازی آزمایش
واردسازی همگام سازی

ناپایا srv wg := همگام سازی.گروه انتظار جدید()
ناپایا bound port := 0
ناپایا server := فراخوان دور.سرور جدید(0، فراخوان دور.کدک جیسون)
ناپایا line server := تی سی پی.سرور {}

تابع half(slot: صحیح۶۴):
    فراخوان دور.پاسخ اعشاری(slot، فراخوان دور.پارامتر اعشاری فراخوان(slot، "x"، 0) / 2.0)
پایان

تابع flag(slot: صحیح۶۴):
    فراخوان دور.پاسخ بولی(slot، فراخوان دور.پارامتر بولی فراخوان(slot، "on"، 0))
پایان

تابع info(slot: صحیح۶۴):
    req := فراخوان دور.درخواست فراخوان(slot)
    params := فراخوان دور.پارامترهای فراخوان(slot)
    فراخوان دور.پاسخ متنی(slot، req.متد + ":" + فراخوان دور.تعداد پارامتر فراخوان(slot) + ":" + فراخوان دور.فراخوان اعلان است(slot) + ":" + مقدار.آرایه است(params))
پایان

تابع nothing(slot: صحیح۶۴):
    فراخوان دور.پاسخ تهی(slot)
پایان

تابع deny(slot: صحیح۶۴):
    فراخوان دور.شکست با داده(slot، 0 - 32001، "denied"، مقدار.مقدار رشته("why"))
پایان

تابع web entry(ctx: صحیح۶۴):
    اچ تی تی پی.جیسون(ctx، فراخوان دور.پردازش متن(اچ تی تی پی.بدنه(ctx)))
پایان

تابع serve loopback():
    فراخوان دور.تنظیم قاب‌بندی(server، فراخوان دور.قاب سرآیندی)
    فراخوان دور.گوش دادن(server)
    bound port = فراخوان دور.درگاه سرور(server)
    همگام سازی.اتمام(srv wg)
    فراخوان دور.خدمت به تعداد(server، 1)
    فراخوان دور.توقف سرور(server)
پایان

تابع serve line():
    c := تی سی پی.پذیرش(line server)
    آزمایش.ادعای برابری عدد(فراخوان دور.خدمت به اتصال(c.توصیفگر، فراخوان دور.کدک جیسون، فراخوان دور.قاب خطی)، 2)
    تی سی پی.بستن(c)
پایان

تابع check constructors():
    ناپایا args := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(args، مقدار.مقدار صحیح(7 برگردان صحیح۶۴))
    مقدار.افزودن به آرایه(args، مقدار.مقدار رشته("txt"))
    مقدار.افزودن به آرایه(args، مقدار.مقدار منطقی(درست))
    مقدار.افزودن به آرایه(args، مقدار.مقدار اعشاری(1.5))
    req := فراخوان دور.درخواست با شناسه متنی("m"، args، "abc")
    آزمایش.ادعای درستی(req.شناسه دارد)
    آزمایش.ادعای برابری رشته(مقدار.به رشته(req.شناسه)، "abc")
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری درخواست جیسون(req)، `{"jsonrpc": "2.0", "method": "m", "params": [7, "txt", true, 1.5], "id": "abc"}`)
    آزمایش.ادعای برابری عدد۶۴(مقدار.به صحیح(فراخوان دور.پارامتر در جایگاه(req، 0))، 7)
    آزمایش.ادعای درستی(مقدار.تهی است(فراخوان دور.پارامتر در جایگاه(req، 9)))
    آزمایش.ادعای برابری رشته(فراخوان دور.پارامتر متنی(req، ""، 1)، "txt")
    آزمایش.ادعای درستی(فراخوان دور.پارامتر بولی(req، ""، 2))
    آزمایش.ادعای درستی(فراخوان دور.پارامتر اعشاری(req، ""، 3) بزرگتر 1.49 و فراخوان دور.پارامتر اعشاری(req، ""، 3) کوچکتر 1.51)
    آزمایش.ادعای درستی(فراخوان دور.پارامتر دارد(req، ""، 0))
    آزمایش.ادعای نادرستی(فراخوان دور.پارامتر دارد(req، ""، 8))

    ناپایا named := مقدار.شیء جدید()
    مقدار.تنظیم کلید(named، "who"، مقدار.مقدار رشته("ali"))
    note := فراخوان دور.اعلان جدید("hello"، named)
    آزمایش.ادعای درستی(فراخوان دور.اعلان است(note))
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری درخواست جیسون(note)، `{"jsonrpc": "2.0", "method": "hello", "params": {"who": "ali"}}`)
    آزمایش.ادعای برابری رشته(مقدار.به رشته(فراخوان دور.پارامتر نام‌دار(note، "who"))، "ali")
    آزمایش.ادعای درستی(مقدار.تهی است(فراخوان دور.پارامتر نام‌دار(note، "nobody")))
    آزمایش.ادعای درستی(فراخوان دور.پارامتر دارد(note، "who"، 0))
    آزمایش.ادعای نادرستی(فراخوان دور.پارامتر دارد(note، "nobody"، 0))

    good := فراخوان دور.پاسخ جدید(مقدار.مقدار صحیح(3 برگردان صحیح۶۴)، مقدار.مقدار اعشاری(2.5))
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(good) بزرگتر 2.49 و فراخوان دور.نتیجه اعشاری(good) کوچکتر 2.51)
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری پاسخ جیسون(good)، `{"jsonrpc": "2.0", "result": 2.5, "id": 3}`)
    آزمایش.ادعای برابری رشته(فراخوان دور.پیام خطا(good)، "")

    err := فراخوان دور.خطا با داده(0 - 5، "boom"، مقدار.مقدار رشته("d"))
    آزمایش.ادعای درستی(err.داده دارد)
    bad := فراخوان دور.پاسخ خطا(مقدار.مقدار صحیح(4 برگردان صحیح۶۴)، err)
    آزمایش.ادعای برابری رشته(فراخوان دور.پیام خطا(bad)، "boom")
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(bad) برابر 0.0)
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری پاسخ جیسون(bad)، `{"jsonrpc": "2.0", "error": {"code": -5, "message": "boom", "data": "d"}, "id": 4}`)

    std := فراخوان دور.خطای استاندارد(فراخوان دور.کد روش یافت نشد)
    آزمایش.ادعای برابری رشته(std.پیام، "Method not found")
    آزمایش.ادعای نادرستی(std.داده دارد)
    آزمایش.ادعای برابری رشته(فراخوان دور.خطای سطح بالای جیسون(فراخوان دور.خطای استاندارد(فراخوان دور.کد خطای تجزیه))، `{"jsonrpc": "2.0", "error": {"code": -32700, "message": "Parse error"}, "id": null}`)

    ناپایا rs := فراخوان دور.پاسخ‌ها {}
    rs.به شکل آرایه = درست
    rs.پاسخ‌ها.بیفزا(good)
    rs.پاسخ‌ها.بیفزا(bad)
    آزمایش.ادعای درستی(فراخوان دور.کدگذاری پاسخ‌های جیسون(rs).طول() بزرگتر 0)
    آزمایش.ادعای برابری رشته(فراخوان دور.کدگذاری پاسخ‌های جیسون(rs).زیررشته(0، 1)، "[")
پایان

تابع check codecs():
    ناپایا args := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(args، مقدار.مقدار صحیح(8 برگردان صحیح۶۴))
    req := فراخوان دور.درخواست جدید("half"، args، 21 برگردان صحیح۶۴)

    ناپایا wire := فراخوان دور.کدگذاری درخواست(فراخوان دور.کدک مسگ‌پک، req)
    آزمایش.ادعای درستی(فشرده سازی.طول بافر(wire) بزرگتر 0)
    batch := فراخوان دور.کدگشایی دسته(فراخوان دور.کدک مسگ‌پک، wire)
    آزمایش.ادعای درستی(batch.خوانده‌شده)
    آزمایش.ادعای برابری رشته(batch.درخواست‌ها.بگیر(0).متد، "half")
    batch2 := فراخوان دور.کدگشایی دسته مسگ‌پک(wire)
    آزمایش.ادعای برابری عدد(batch2.درخواست‌ها.طول()، 1)
    آزمایش.ادعای برابری عدد۶۴(batch2.درخواست‌ها.بگیر(0).شناسه عددی، 21)

    out := فراخوان دور.اجرای دسته(batch)
    آزمایش.ادعای برابری عدد(out.پاسخ‌ها.طول()، 1)
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(out.پاسخ‌ها.بگیر(0)) بزرگتر 3.99 و فراخوان دور.نتیجه اعشاری(out.پاسخ‌ها.بگیر(0)) کوچکتر 4.01)

    ناپایا packed := فراخوان دور.کدگذاری پاسخ‌ها(فراخوان دور.کدک مسگ‌پک، out)
    ناپایا ok := نادرست
    decoded := فراخوان دور.کدگشایی پاسخ(فراخوان دور.کدک مسگ‌پک، packed، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(decoded) بزرگتر 3.99 و فراخوان دور.نتیجه اعشاری(decoded) کوچکتر 4.01)

    ناپایا one := فراخوان دور.کدگذاری پاسخ مسگ‌پک(out.پاسخ‌ها.بگیر(0))
    آزمایش.ادعای درستی(فشرده سازی.طول بافر(one) بزرگتر 0)
    ناپایا ok2 := نادرست
    again := فراخوان دور.کدگشایی پاسخ مسگ‌پک(one، ok2)
    آزمایش.ادعای درستی(ok2)
    آزمایش.ادعای برابری عدد۶۴(again.شناسه عددی، 21)

    ناپایا top := فراخوان دور.کدگذاری خطای سطح بالا(فراخوان دور.کدک مسگ‌پک، فراخوان دور.خطای استاندارد(فراخوان دور.کد خطای تجزیه))
    آزمایش.ادعای درستی(فشرده سازی.طول بافر(top) بزرگتر 0)
    ناپایا top json := فراخوان دور.کدگذاری خطای سطح بالا(فراخوان دور.کدک جیسون، فراخوان دور.خطای استاندارد(فراخوان دور.کد خطای تجزیه))
    آزمایش.ادعای شامل بودن(فشرده سازی.بافر به رشته(top json)، "Parse error")
    فشرده سازی.آزادسازی بافر(top json)
    فشرده سازی.آزادسازی بافر(top)
    فشرده سازی.آزادسازی بافر(one)
    فشرده سازی.آزادسازی بافر(packed)
    فشرده سازی.آزادسازی بافر(wire)
پایان

تابع check handlers():
    ناپایا r := فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"info","params":[1,2,3],"id":1}`)
    آزمایش.ادعای شامل بودن(r، `"result": "info:3:false:true"`)
    r = فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"half","params":{"x":5},"id":2}`)
    آزمایش.ادعای شامل بودن(r، `"result": 2.5`)
    r = فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"flag","params":{"on":true},"id":3}`)
    آزمایش.ادعای شامل بودن(r، `"result": true`)
    r = فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"nothing","id":4}`)
    آزمایش.ادعای شامل بودن(r، `"result": null`)
    r = فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"deny","id":5}`)
    آزمایش.ادعای شامل بودن(r، `"code": -32001`)
    آزمایش.ادعای شامل بودن(r، `"data": "why"`)
پایان

تابع check stream helpers():
    ناپایا s := فراخوان دور.جریان حافظه()
    آزمایش.ادعای برابری عدد(فراخوان دور.باقی‌مانده جریان(s)، 0)
    فراخوان دور.تغذیه متن(s، "abc\nde")
    آزمایش.ادعای برابری عدد(فراخوان دور.باقی‌مانده جریان(s)، 6)
    ناپایا ok := نادرست
    آزمایش.ادعای برابری رشته(فراخوان دور.خواندن قاب متنی(s، فراخوان دور.قاب خطی، ok)، "abc")
    آزمایش.ادعای برابری عدد(فراخوان دور.باقی‌مانده جریان(s)، 2)
    آزمایش.ادعای نادرستی(فراخوان دور.جریان بسته(s))
    فراخوان دور.آزادسازی جریان(s)

    ناپایا framed := فراخوان دور.قاب‌بندی متن(فراخوان دور.قاب سرآیندی، "hello")
    آزمایش.ادعای برابری رشته(فشرده سازی.بافر به رشته(framed)، "Content-Length: 5\r\n\r\nhello")
    ناپایا line := فراخوان دور.قاب‌بندی متن(فراخوان دور.قاب خطی، "hello")
    آزمایش.ادعای برابری عدد(فشرده سازی.طول بافر(line)، 6)
    فشرده سازی.آزادسازی بافر(line)
    فشرده سازی.آزادسازی بافر(framed)
پایان

تابع check live calls():
    همگام سازی.افزودن(srv wg، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve loopback)
    همگام سازی.انتظار(srv wg)
    آزمایش.ادعای درستی(bound port بزرگتر 0)

    conn := تی سی پی.شماره گیری("127.0.0.1"، bound port)
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(conn))
    ناپایا c := فراخوان دور.کارخواه از توصیف‌گر(conn.توصیفگر، فراخوان دور.کدک جیسون)
    فراخوان دور.تنظیم قاب‌بندی کارخواه(c، فراخوان دور.قاب سرآیندی)
    آزمایش.ادعای درستی(فراخوان دور.کارخواه معتبر(c))
    آزمایش.ادعای برابری رشته(فراخوان دور.خطای کارخواه(c)، "")

    ناپایا args := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(args، مقدار.مقدار اعشاری(9.0))
    r1 := فراخوان دور.فراخوان(c، "half"، args)
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(r1) بزرگتر 4.49 و فراخوان دور.نتیجه اعشاری(r1) کوچکتر 4.51)

    ناپایا reqs := وکتور {} برگردان وکتور<فراخوان دور.درخواست>
    reqs.بیفزا(فراخوان دور.درخواست جدید("half"، args، 0 برگردان صحیح۶۴))
    reqs.بیفزا(فراخوان دور.اعلان جدید("nothing"، مقدار.آرایه جدید()))
    reqs.بیفزا(فراخوان دور.درخواست جدید("deny"، مقدار.آرایه جدید()، 0 برگردان صحیح۶۴))
    answers := فراخوان دور.فراخوان دسته‌ای(c، reqs)
    آزمایش.ادعای برابری عدد(answers.پاسخ‌ها.طول()، 2)
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(answers.پاسخ‌ها.بگیر(0)) بزرگتر 4.49)
    آزمایش.ادعای برابری رشته(فراخوان دور.پیام خطا(answers.پاسخ‌ها.بگیر(1))، "denied")

    فراخوان دور.بستن کارخواه(c)
    after := فراخوان دور.فراخوان(c، "half"، args)
    آزمایش.ادعای درستی(فراخوان دور.پاسخ خطاست(after))
    آزمایش.ادعای برابری رشته(فراخوان دور.خطای کارخواه(c)، "client is not connected")

    نخ‌پیوند(t)

    line server = تی سی پی.پیوند(0)
    t2 := نخ‌ساز(serve line)
    raw := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(line server))
    آزمایش.ادعای درستی(تی سی پی.اتصال معتبر(raw))
    آزمایش.ادعای درستی(فراخوان دور.نوشتن قاب متنی(raw.توصیفگر، فراخوان دور.قاب خطی، `{"jsonrpc":"2.0","method":"half","params":[3],"id":1}`))
    ناپایا body := فشرده سازی.بافر از رشته(`{"jsonrpc":"2.0","method":"flag","params":[true],"id":2}`)
    آزمایش.ادعای درستی(فراخوان دور.نوشتن قاب(raw.توصیفگر، فراخوان دور.قاب خطی، body))
    ناپایا st := فراخوان دور.جریان جدید(raw.توصیفگر)
    ناپایا ok := نادرست
    first := فراخوان دور.خواندن قاب متنی(st، فراخوان دور.قاب خطی، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای شامل بودن(first، `"result": 1.5`)
    second := فراخوان دور.خواندن قاب متنی(st، فراخوان دور.قاب خطی، ok)
    آزمایش.ادعای درستی(ok)
    آزمایش.ادعای شامل بودن(second، `"result": true`)
    فراخوان دور.آزادسازی جریان(st)
    فشرده سازی.آزادسازی بافر(body)
    تی سی پی.بستن(raw)
    نخ‌پیوند(t2)
    تی سی پی.بستن سرور(line server)
پایان

تابع check web call():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(r، "/rpc"، web entry)
    ناپایا s := اچ تی تی پی.سرور جدید(23841)
    اچ تی تی پی.استفاده(s، r)
    آزمایش.ادعای درستی(اچ تی تی پی.اجرا در پس زمینه(s))
    ناپایا args := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(args، مقدار.مقدار اعشاری(7.0))
    resp := فراخوان دور.فراخوان اچ تی تی پی("http://127.0.0.1:23841/rpc"، "half"، args، 9 برگردان صحیح۶۴)
