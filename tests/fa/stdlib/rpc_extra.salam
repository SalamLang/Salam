تابع بررسی فراخوان وب():
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(r، "/rpc"، ورودی وب)
    ناپایا s := اچ تی تی پی.سرور جدید(23841)
    اچ تی تی پی.استفاده(s، r)
    آزمایش.ادعای درستی(اچ تی تی پی.اجرا در پس زمینه(s))
    ناپایا آرگومان ها := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(آرگومان ها، مقدار.مقدار اعشاری(7.0))
    پاسخ وب := فراخوان دور.فراخوان اچ تی تی پی("http://127.0.0.1:23841/rpc"، "half"، آرگومان ها، 9 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(فراخوان دور.نتیجه اعشاری(پاسخ وب) بزرگتر 3.49 و فراخوان دور.نتیجه اعشاری(پاسخ وب) کوچکتر 3.51)
    روش ناموجود := فراخوان دور.فراخوان اچ تی تی پی("http://127.0.0.1:23841/rpc"، "nope"، آرگومان ها، 10 برگردان صحیح۶۴)
    آزمایش.ادعای برابری عدد(فراخوان دور.کد خطا(روش ناموجود)، فراخوان دور.کد روش یافت نشد)
    خادم خاموش := فراخوان دور.فراخوان اچ تی تی پی("http://127.0.0.1:1/rpc"، "half"، آرگومان ها، 11 برگردان صحیح۶۴)
    آزمایش.ادعای برابری رشته(فراخوان دور.پیام خطا(خادم خاموش)، "HTTP request failed")
