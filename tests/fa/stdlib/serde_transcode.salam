بسته ریشه

واردسازی کدگذاری.تبدیل قالب

تابع ریشه:
    سرچاپ تبدیل قالب.تبدیل قالب("{\"name\":\"salam\",\"year\":2024}"، "json"، "toml")
    سرچاپ تبدیل قالب.تبدیل قالب("name = \"salam\"\nyear = 2024\n"، "toml"، "json")
    سرچاپ تبدیل قالب.تبدیل قالب("name: salam\nyear: 2024\n"، "yaml"، "json")
    سرچاپ تبدیل قالب.تبدیل قالب("{\"a\":1}"، "json"، "yaml")
    سرچاپ تبدیل قالب.تبدیل قالب("{broken"، "json"، "yaml") برابر ""
    سرچاپ تبدیل قالب.تبدیل قالب("{\"a\":1}"، "nonsense"، "json") برابر ""
    سرچاپ تبدیل قالب.تبدیل قالب("{\"a\":1}"، "json"، "nonsense") برابر ""
پایان
