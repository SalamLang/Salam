بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم پرونده
واردسازی سیستم عامل

تابع at(d: رشته، rel: رشته): رشته:
    برگشت مسیر پرونده.پیوند(d، rel)
پایان

تابع size_of(path: رشته): صحیح:
    ناپایا ok := نادرست
    ناپایا b := بایگانی.خواندن پرونده دودویی(path، ok)
    اگر وارونه ok:
        برگشت -1
    پایان
    n := b.طول
    فشرده سازی.آزادسازی بافر(b)
    برگشت n
پایان

تابع ریشه:
    note := "salam 7z writer\n"
    ناپایا blob := فشرده سازی.بافر بایت جدید()
    تکرار 3000 در i:
        فشرده سازی.افزودن بایت(blob، (i * 7 + i / 13) & 255)
    پایان
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("docs/"، پوچ، 0، درست))
    ناپایا f1 := بایگانی.ساخت ورودی پرونده هفت زد("docs/note.txt"، note برگردان تهی*، note.طول()، نادرست)
    f1.زمان تغییر = 1600000000 برگردان صحیح۶۴
    f1.دسترسی = 420
    files.بیفزا(f1)
    ناپایا f2 := بایگانی.ساخت ورودی پرونده هفت زد("data.bin"، blob.داده، blob.طول، نادرست)
    f2.دسترسی = 493
    files.بیفزا(f2)
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("empty.txt"، پوچ، 0، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("docs/empty dir"، پوچ، 0، درست))
    ناپایا f3 := بایگانی.ساخت ورودی پرونده هفت زد("docs/note.link"، پوچ، 0، نادرست)
    f3.پیوند = "note.txt"
    files.بیفزا(f3)
    pers := "\u0633\u0644\u0627\u0645"
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد(pers + ".txt"، note برگردان تهی*، note.طول()، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("emoji \U0001F600.txt"، note برگردان تهی*، 5، نادرست))

    packed := بایگانی.ساخت هفت زد(files)
    سرچاپ "archive bytes"، packed.طول، "crc"، فشرده سازی.چک جمع سی آر سی(packed.داده، packed.طول)، "is 7z"، بایگانی.هفت زد است(packed.داده، packed.طول)

    ناپایا st := 0
    es := بایگانی.فهرست هفت زد با وضعیت(packed.داده، packed.طول، st)
    سرچاپ "status"، st، "entries"، es.طول()
    هر e در es:
        سرچاپ e.نام، e.اندازه، e.پوشه، e.نوع، e.دسترسی، e.زمان تغییر، e.پیوند
    پایان

    ناپایا ok := نادرست
    got := بایگانی.استخراج با نام از هفت زد(packed.داده، packed.طول، "data.bin"، ok)
    سرچاپ "data.bin"، ok، فشرده سازی.برابری بافر(got، blob)
    note2 := بایگانی.استخراج با نام از هفت زد(packed.داده، packed.طول، "docs/note.txt"، ok)
    سرچاپ "note"، ok، فشرده سازی.بافر به رشته(note2) برابر note

    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sz_create")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    سرچاپ "extract"، بایگانی.استخراج همه از هفت زد(packed.داده، packed.طول، dir)
    سرچاپ "sizes"، size_of(at(dir، "data.bin"))، size_of(at(dir، "docs/note.link"))، size_of(at(dir، "empty.txt"))، سیستم عامل.پوشه است(at(dir، "docs/empty dir"))
    سرچاپ "mode"، سیستم پرونده.مجوزها(at(dir، "data.bin"))، سیستم پرونده.مجوزها(at(dir، "docs/note.txt"))، "mtime"، سیستم پرونده.زمان تغییر(at(dir، "docs/note.txt"))
    سیستم عامل.حذف همه(dir)

    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sz_made.7z")
    سرچاپ "file"، بایگانی.ساخت پرونده هفت زد(files، path)، size_of(path) برابر packed.طول
    سیستم عامل.حذف(path)

    none := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    empty := بایگانی.ساخت هفت زد(none)
    سرچاپ "empty archive"، empty.طول، بایگانی.فهرست هفت زد(empty.داده، empty.طول).طول()
    ناپایا bad := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    bad.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد(""، پوچ، 0، نادرست))
    سرچاپ "bad input"، بایگانی.ساخت هفت زد(bad).طول
پایان
