تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع size_of(path: رشته): صحیح:
    ناپایا ok := نادرست
    ناپایا b := بایگانی.خواندن پرونده دودویی(path، ok)
    اگر وارونه ok:
        برگشت -1
    پایان
    n := b.طول
    فشرده سازی.آزادسازی بافر(b)
    برگشت n
پایان

تابع at(d: رشته، rel: رشته): رشته:
    برگشت مسیر پرونده.پیوند(d، rel)
پایان

تابع extract_links():
    ناپایا a := unhex(LINKS)
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sz_links")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا arc := بایگانی.بازکردن هفت زد(a.داده، a.طول، "")
    n := بایگانی.خواندن همه از هفت زد(arc، dir)
    سرچاپ "extracted"، n، بایگانی.متن وضعیت هفت زد(arc.وضعیت)
    سرچاپ "link_a size"، size_of(at(dir، "tree/link_a"))
    سرچاپ "dirlink to sub"، size_of(at(dir، "tree/dirlink/d.txt"))
    سرچاپ "a.txt mode"، سیستم پرونده.مجوزها(at(dir، "tree/a.txt"))، "mtime"، سیستم پرونده.زمان تغییر(at(dir، "tree/a.txt"))
    سرچاپ "run.sh mode"، سیستم پرونده.مجوزها(at(dir، "tree/run.sh"))، "d.txt mtime"، سیستم پرونده.زمان تغییر(at(dir، "tree/sub/d.txt"))
    سرچاپ "empty file"، size_of(at(dir، "tree/empty.txt"))، "empty dir"، سیستم عامل.پوشه است(at(dir، "tree/emptydir"))
    سرچاپ "escaping links made"، سیستم عامل.وجود دارد(at(dir، "tree/evil1"))، سیستم عامل.وجود دارد(at(dir، "tree/evil2"))
    سیستم عامل.حذف همه(dir)
    فشرده سازی.آزادسازی بافر(a)
پایان

تابع list_links():
    ناپایا a := unhex(LINKS)
    es := بایگانی.فهرست هفت زد(a.داده، a.طول)
    هر e در es:
        اگر e.نوع نابرابر 0:
            سرچاپ e.نام، "kind"، e.نوع، "link"، e.پیوند، "mode"، e.دسترسی
        پایان
    پایان
    فشرده سازی.آزادسازی بافر(a)
پایان

تابع sfx():
    ناپایا a := unhex(LINKS)
    ناپایا stub := فشرده سازی.بافر بایت جدید()
    تکرار 300 در i:
        فشرده سازی.افزودن بایت(stub، 77 + (i % 5))
    پایان
    decoy := unhex("377abcaf271c0004deadbeef00000000000000000000000000000000")
    فشرده سازی.افزودن بایت‌ها(stub، decoy.داده، decoy.طول)
    تکرار 100:
        فشرده سازی.افزودن بایت(stub، 0)
    پایان
    فشرده سازی.افزودن بایت‌ها(stub، a.داده، a.طول)
    es := بایگانی.فهرست هفت زد(stub.داده، stub.طول)
    ناپایا ok := نادرست
    got := بایگانی.استخراج با نام از هفت زد(stub.داده، stub.طول، "tree/sub/d.txt"، ok)
    سرچاپ "sfx entries"، es.طول()، "read"، ok، got.طول، "is 7z at start"، بایگانی.هفت زد است(stub.داده، stub.طول)
    فشرده سازی.آزادسازی بافر(stub)
    فشرده سازی.آزادسازی بافر(a)
پایان

تابع volumes():
    ناپایا a := unhex(LINKS)
    ناپایا vols := وکتور {} برگردان وکتور<فشرده سازی.بافر بایت>
    cuts := [0، 100، 250، a.طول]
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sz_vols")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    تکرار 3 در k:
        ناپایا part := فشرده سازی.بافر بایت جدید()
        فشرده سازی.افزودن بایت‌ها(part، ((a.داده برگردان صحیح۶۴) + (cuts[k] برگردان صحیح۶۴)) برگردان تهی*، cuts[k + 1] - cuts[k])
        vols.بیفزا(part)
        _w := بایگانی.نوشتن پرونده دودویی از بافر(at(dir، "pack.7z.00" + (k + 1))، part)
    پایان
    ناپایا arc := بایگانی.بازکردن بخش‌های هفت زد(vols، "")
    es := بایگانی.مدخل‌های هفت زد(arc)
    سرچاپ "volumes"، vols.طول()، "entries"، es.طول()، "status"، arc.وضعیت
    بایگانی.بستن هفت زد(arc)
    بایگانی.آزادسازی بخش‌های هفت زد(vols)
    ناپایا ok := نادرست
    ناپایا found := بایگانی.خواندن بخش‌های هفت زد(at(dir، "pack.7z.001")، ok)
    ناپایا arc2 := بایگانی.بازکردن بخش‌های هفت زد(found، "")
    got := بایگانی.خواندن از هفت زد(arc2، "tree/a.txt"، 0)
    سرچاپ "from files"، ok، found.طول()، "read"، got.طول، arc2.وضعیت
    بایگانی.بستن هفت زد(arc2)
    بایگانی.آزادسازی بخش‌های هفت زد(found)
    سیستم عامل.حذف همه(dir)
    فشرده سازی.آزادسازی بافر(a)
پایان

تابع pw(label: رشته، hex: رشته):
    ناپایا a := unhex(hex)
    ناپایا line := label
    هر p در ["secret"، "wrong"، ""]:
        ناپایا arc := بایگانی.بازکردن هفت زد(a.داده، a.طول، p)
        got := بایگانی.خواندن از هفت زد(arc، "tree/a.txt"، 0)
        line = line + " " + str_of(arc.وضعیت) + "/" + str_of(got.طول)
    پایان
    سرچاپ line
    فشرده سازی.آزادسازی بافر(a)
پایان

تابع str_of(n: صحیح): رشته:
    برگشت "" + n
پایان

تابع ریشه:
    extract_links()
    list_links()
    sfx()
    volumes()
    pw("copy+aes"، PWCOPY)
    pw("lzma+aes"، PWLZMA)
پایان
