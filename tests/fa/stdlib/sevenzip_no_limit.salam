بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع file_size(path: رشته): صحیح۶۴:
    ناپایا ok := نادرست
    ناپایا b := بایگانی.خواندن پرونده دودویی(path، ok)
    اگر وارونه ok:
        برگشت -1
    پایان
    n := b.طول برگردان صحیح۶۴
    فشرده سازی.آزادسازی بافر(b)
    برگشت n
پایان

تابع ریشه:
    note := "caps and big entries"
    ناپایا small := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    small.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("a.txt"، note برگردان تهی*، note.طول()، نادرست))
    small.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("dir/"، پوچ، 0، درست))
    packed := بایگانی.ساخت هفت زد(small)

    ناپایا arc := بایگانی.بازکردن هفت زد(packed.داده، packed.طول، "")
    got := بایگانی.خواندن از هفت زد با سقف(arc، "a.txt"، 0 برگردان صحیح۶۴)
    سرچاپ "read"، arc.وضعیت، فشرده سازی.بافر به رشته(got) برابر note
    over := بایگانی.خواندن از هفت زد با سقف(arc، "a.txt"، 5 برگردان صحیح۶۴)
    سرچاپ "cap"، arc.وضعیت، over.طول
    fits := بایگانی.خواندن از هفت زد با سقف(arc، "a.txt"، note.طول() برگردان صحیح۶۴)
    سرچاپ "exact"، arc.وضعیت، fits.طول
    old := بایگانی.خواندن از هفت زد(arc، "a.txt"، 5)
    سرچاپ "old max"، arc.وضعیت، old.طول
    gone := بایگانی.خواندن از هفت زد با سقف(arc، "nope"، 0 برگردان صحیح۶۴)
    سرچاپ "missing"، arc.وضعیت، gone.طول

    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sz_nolimit_fa_a")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    n := بایگانی.خواندن همه از هفت زد با سقف(arc، dir، 5 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)
    سرچاپ "all capped"، n، arc.وضعیت، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "a.txt"))
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    n2 := بایگانی.خواندن همه از هفت زد با سقف(arc، dir، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)
    سرچاپ "all"، n2، arc.وضعیت، file_size(مسیر پرونده.پیوند(dir، "a.txt"))، سیستم عامل.پوشه است(مسیر پرونده.پیوند(dir، "dir"))
    سیستم عامل.حذف همه(dir)
    n3 := بایگانی.خواندن همه از هفت زد(arc، dir)
    سرچاپ "old all"، n3، arc.وضعیت
    سیستم عامل.حذف همه(dir)
    es := بایگانی.مدخل‌های هفت زد در حافظه(arc)
    سرچاپ "entries"، es.طول()، arc.وضعیت

    size := 1100000000
    big := حافظه.تخصیص صفرشده(size برگردان طبیعی۶۴)
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("big.bin"، big، size، نادرست))
    ناپایا bigpacked := بایگانی.ساخت هفت زد با سطح(files، 0)
    حافظه.آزادسازی(big)
    سرچاپ "big archive"، bigpacked.طول بزرگتر size
    ناپایا barc := بایگانی.بازکردن هفت زد(bigpacked.داده، bigpacked.طول، "")
    refused := بایگانی.خواندن از هفت زد با سقف(barc، "big.bin"، 1000000 برگردان صحیح۶۴)
    سرچاپ "big cap"، barc.وضعیت، refused.طول
    bdir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sz_nolimit_fa_b")
    سیستم عامل.حذف همه(bdir)
    سیستم عامل.ساخت پوشه ها(bdir)
    bn := بایگانی.خواندن همه از هفت زد(barc، bdir)
    سرچاپ "big all"، bn، barc.وضعیت، file_size(مسیر پرونده.پیوند(bdir، "big.bin")) برابر (size برگردان صحیح۶۴)
    سیستم عامل.حذف همه(bdir)
    فشرده سازی.آزادسازی بافر(bigpacked)
پایان
