پایا WORDS := ["salam"، "compress"، "xz"، "lzma"، "archive"، "the"، "quick"، "brown"، "fox"، "jumps"، "over"، "lazy"، "dog"، "stream"، "block"، "index"]
پایا NAMES := ["a.txt"، "docs/b.bin"، "docs/note.txt"، "empty.txt"، "فارسی.txt"]

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع lcg(x: صحیح۶۴): صحیح۶۴:
    برگشت (x * 1103515245 + 12345) & 0x7fffffff
پایان

تابع gen_text(n: صحیح، seed: صحیح۶۴): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = lcg(x)
        w := WORDS[((x >> 8) % 16) برگردان صحیح]
        فشرده سازی.افزودن بایت‌ها(out، w برگردان تهی*، w.طول())
        اگر ((x >> 4) & 7) برابر 0:
            فشرده سازی.افزودن بایت(out، 10)
        وگرنه:
            فشرده سازی.افزودن بایت(out، 32)
        پایان
    پایان
    برگشت out
پایان

تابع push32(b &: فشرده سازی.بافر بایت، v: صحیح۶۴):
    فشرده سازی.افزودن بایت(b، (v & 255) برگردان صحیح)
    فشرده سازی.افزودن بایت(b، ((v >> 8) & 255) برگردان صحیح)
    فشرده سازی.افزودن بایت(b، ((v >> 16) & 255) برگردان صحیح)
    فشرده سازی.افزودن بایت(b، ((v >> 24) & 255) برگردان صحیح)
پایان

تابع gen_x86(n: صحیح، seed: صحیح۶۴): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = lcg(x)
        k := (x >> 8) % 4
        اگر k کوچکتر 2:
            rel := ((x >> 10) % 2000) - 1000
            اگر k برابر 0:
                فشرده سازی.افزودن بایت(out، 232)
            وگرنه:
                فشرده سازی.افزودن بایت(out، 233)
            پایان
            push32(out، rel & 0xffffffff)
        وگرنه:
            c := 1 + ((x >> 10) % 4)
            تکرار c:
                x = lcg(x)
                فشرده سازی.افزودن بایت(out، ((x >> 12) & 255) برگردان صحیح)
            پایان
        پایان
    پایان
    برگشت out
پایان

تابع expected(name: رشته): فشرده سازی.بافر بایت:
    اگر name برابر "a.txt":
        برگشت gen_text(30، 1)
    پایان
    اگر name برابر "docs/b.bin":
        برگشت gen_x86(120، 3)
    پایان
    اگر name برابر "docs/note.txt":
        ناپایا b := فشرده سازی.بافر بایت جدید()
        تکرار 3:
            فشرده سازی.افزودن بایت‌ها(b، "Salam 7z\n" برگردان تهی*، 9)
        پایان
        برگشت b
    پایان
    اگر name برابر "فارسی.txt":
        برگشت فشرده سازی.بافر از رشته("سلام")
    پایان
    برگشت فشرده سازی.بافر بایت جدید()
پایان

تابع check(label: رشته، hex: رشته، password: رشته):
    packed := unhex(hex)
    ناپایا arc := بایگانی.بازکردن هفت زد(packed.داده، packed.طول، password)
    entries := بایگانی.مدخل‌های هفت زد(arc)
    listed := arc.وضعیت
    ناپایا same := 0
    ناپایا method := -1
    تکرار NAMES.طول() در i:
        name := NAMES[i]
        data := بایگانی.خواندن از هفت زد(arc، name، 0)
        اگر arc.وضعیت برابر بایگانی.هفت زد موفق و فشرده سازی.برابری بافر(data، expected(name)):
            same++
        پایان
        تکرار entries.طول() در k:
            اگر entries.بگیر(k).نام برابر name و entries.بگیر(k).اندازه بزرگتر 0:
                method = entries.بگیر(k).روش
            پایان
        پایان
    پایان
    سرچاپ label، "list"، listed، "entries"، entries.طول()، "files equal"، same، "method"، method
پایان

تابع status_of(hex: رشته، password: رشته، name: رشته): صحیح:
    packed := unhex(hex)
    ناپایا arc := بایگانی.بازکردن هفت زد(packed.داده، packed.طول، password)
    data := بایگانی.خواندن از هفت زد(arc، name، 0)
    اگر data.طول کوچکتر 0:
        برگشت -1
    پایان
    برگشت arc.وضعیت
پایان

تابع status_of_buf(b: فشرده سازی.بافر بایت، name: رشته): صحیح:
    ناپایا arc := بایگانی.بازکردن هفت زد(b.داده، b.طول، "")
    data := بایگانی.خواندن از هفت زد(arc، name، 0)
    اگر data.طول کوچکتر 0:
        برگشت -1
    پایان
    برگشت arc.وضعیت
پایان

تابع read_text(path: رشته): رشته:
    ناپایا ok := نادرست
    buf := بایگانی.خواندن پرونده دودویی(path، ok)
    اگر وارونه ok:
        برگشت "missing"
    پایان
    برگشت فشرده سازی.بافر به رشته(buf)
پایان

تابع ریشه:
    سرچاپ "== methods =="
    check("lzma2"، LZMA2، "")
    check("lzma"، LZMA، "")
    check("copy"، COPY، "")
    check("ppmd"، PPMD، "")
    check("bzip2"، BZIP2، "")
    check("deflate"، DEFLATE، "")
    check("not solid"، NONSOLID، "")
    check("x86 filter + lzma2"، BCJ، "")
    check("delta + lzma"، DELTA، "")
    check("plain header"، PLAINHDR، "")

    سرچاپ "== listing =="
    lz := unhex(LZMA2)
    سرچاپ بایگانی.هفت زد است(lz.داده، lz.طول)، بایگانی.هفت زد است(lz.داده، 3)، بایگانی.هفت زد است("Rar!" برگردان تهی*، 4)
    ناپایا st := 0
    ناپایا list := بایگانی.فهرست هفت زد با وضعیت(lz.داده، lz.طول، st)
    سرچاپ "status"، st، "entries"، list.طول()
    تکرار list.طول() در i:
        e := list.بگیر(i)
        سرچاپ e.نام، e.اندازه، e.پوشه، e.نوع، e.روش، e.چک‌جمع، e.زمان تغییر، e.دسترسی
    پایان
    بایگانی.آزادسازی فهرست(list)
    list2 := بایگانی.فهرست هفت زد(lz.داده، lz.طول)
    سرچاپ list2.طول()

    سرچاپ "== passwords =="
    check("encrypted data and names"، ENC، "secret")
    check("encrypted data"، ENCDATA، "secret")
    سرچاپ "no password"، status_of(ENC، ""، "a.txt")، "wrong password"، status_of(ENC، "nope"، "a.txt")
    سرچاپ "data only: no password"، status_of(ENCDATA، ""، "a.txt")، "wrong password"، status_of(ENCDATA، "nope"، "a.txt")
    enc := unhex(ENCDATA)
    ناپایا arc_enc := بایگانی.بازکردن هفت زد(enc.داده، enc.طول، "")
    سرچاپ "names without password"، بایگانی.مدخل‌های هفت زد(arc_enc).طول()، arc_enc.وضعیت

    سرچاپ "== extract one =="
    ناپایا ok := نادرست
    one := بایگانی.استخراج با نام از هفت زد(lz.داده، lz.طول، "docs/note.txt"، ok)
    سرچاپ ok، فشرده سازی.بافر به رشته(one)
    big := بایگانی.استخراج با نام از هفت زد با سقف(lz.داده، lz.طول، "a.txt"، 10، ok)
    سرچاپ "max 10"، ok، big.طول
    fit := بایگانی.استخراج با نام از هفت زد با سقف(lz.داده، lz.طول، "a.txt"، 176، ok)
    سرچاپ "max 176"، ok، fit.طول
    ناپایا code := 0
    nope := بایگانی.استخراج هفت زد(lz.داده، lz.طول، "missing.txt"، 0، code)
    سرچاپ "missing"، nope.طول، code، بایگانی.متن وضعیت هفت زد(code)
    dirent := بایگانی.استخراج هفت زد(lz.داده، lz.طول، "docs"، 0، code)
    سرچاپ "folder"، code، dirent.طول
    zero := بایگانی.استخراج هفت زد(lz.داده، lz.طول، "empty.txt"، 0، code)
    سرچاپ "empty file"، code، zero.طول

    سرچاپ "== extract all =="
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sevenzip_read")
    سیستم عامل.حذف همه(dir)
    سرچاپ بایگانی.استخراج همه از هفت زد(lz.داده، lz.طول، dir)
    سرچاپ read_text(مسیر پرونده.پیوند(dir، "docs/note.txt")) برابر فشرده سازی.بافر به رشته(expected("docs/note.txt"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "empty_dir"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "empty.txt"))
