تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع put(p: طبیعی۸*، n: صحیح، i: صحیح، a: صحیح، b: صحیح، c: صحیح، d: صحیح):
    اگر i کوچکتر n:
        p[i] = (a & 255) برگردان طبیعی۸
    پایان
    اگر i + 1 کوچکتر n:
        p[i + 1] = (b & 255) برگردان طبیعی۸
    پایان
    اگر i + 2 کوچکتر n:
        p[i + 2] = (c & 255) برگردان طبیعی۸
    پایان
    اگر i + 3 کوچکتر n:
        p[i + 3] = (d & 255) برگردان طبیعی۸
    پایان
پایان

تابع content(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    تکرار n در i:
        فشرده سازی.افزودن بایت(b، (i * 131 + (i >> 5) * 7 + (i >> 11)) & 255)
    پایان
    p := b.داده برگردان طبیعی۸*
    تکرار n در i:
        اگر i % 41 برابر 0:
            put(p، n، i، 0xE8، i * 3، i >> 3، 0)
            اگر i + 4 کوچکتر n:
                p[i + 4] = 0 برگردان طبیعی۸
            پایان
        پایان
        اگر i % 64 برابر 8:
            put(p، n، i، i >> 6، 0، 0، 0x94)
        پایان
        اگر i % 64 برابر 16:
            put(p، n، i، i >> 2، i >> 5، i >> 9، 0xEB)
        پایان
        اگر i % 64 برابر 24:
            put(p، n، i، 0x48، i >> 4، i >> 7، ((i >> 2) & 0xFC) | 1)
        پایان
        اگر i % 64 برابر 32:
            put(p، n، i، i >> 3، 0xF0 | ((i >> 6) & 7)، i >> 1، 0xF8 | ((i >> 8) & 7))
        پایان
        اگر i % 64 برابر 36:
            put(p، n، i، 0x40، (i >> 4) & 0x3F، i >> 2، i)
        پایان
        اگر i % 64 برابر 44:
            put(p، n، i، 0xEF، (i >> 1) & 0xF0، i >> 3، i >> 5)
        پایان
    پایان
    برگشت b
پایان

تابع check(label: رشته، hex: رشته، password: رشته، dir: رشته):
    ناپایا packed := unhex(hex)
    zname := label + ".7z"
    path := مسیر پرونده.پیوند(dir، zname)
    بایگانی.نوشتن پرونده دودویی از بافر(path، packed)
    فشرده سازی.آزادسازی بافر(packed)
    ناپایا sf := بایگانی.بازکردن پرونده هفت زد(path، password)
    سرچاپ label، "open"، sf.وضعیت
    اگر sf.وضعیت برابر 0:
        out := مسیر پرونده.پیوند(dir، label + ".bin")
        st := بایگانی.استخراج از پرونده هفت زد به پرونده(sf، "d.bin"، out، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)
        ناپایا ok := نادرست
        ناپایا got := بایگانی.خواندن پرونده دودویی(out، ok)
        ناپایا want := content(5000)
        سرچاپ "  extract"، st، "match"، ok و فشرده سازی.برابری بافر(got، want)
        فشرده سازی.آزادسازی بافر(got)
        فشرده سازی.آزادسازی بافر(want)
        st2 := بایگانی.استخراج از پرونده هفت زد به پرونده(sf، "d.bin"، out، 0 برگردان صحیح۶۴، 1000 برگردان صحیح۶۴)
        سرچاپ "  memcap"، st2
        سیستم عامل.حذف(out)
        حافظه.آزادسازی(out برگردان تهی*)
    پایان
    بایگانی.بستن پرونده هفت زد(sf)
    حافظه.آزادسازی(zname برگردان تهی*)
    حافظه.آزادسازی(path برگردان تهی*)
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sevenzip_stream_bzppmd_fa")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    check("bzip2"، F_BZIP2، ""، dir)
    check("bzip2_bcj"، F_BZIP2_BCJ، ""، dir)
    check("ppmd"، F_PPMD، ""، dir)
    check("ppmd_deep"، F_PPMD_DEEP، ""، dir)
    check("ppmd_aes"، F_PPMD_AES، "Secret1"، dir)
    check("bzip2_aes"، F_BZIP2_AES، "Secret1"، dir)
    سیستم عامل.حذف همه(dir)
    حافظه.آزادسازی(dir برگردان تهی*)
پایان
