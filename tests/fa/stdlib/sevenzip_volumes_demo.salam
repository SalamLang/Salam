تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع text(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    تکرار n در i:
        line := "line " + رشته.از عدد(i برگردان صحیح۶۴) + " of the salam archive test\n"
        فشرده سازی.افزودن بایت‌ها(b، line برگردان تهی*، line.طول())
    پایان
    برگشت b
پایان

تابع noise(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    ناپایا x := 12345 برگردان صحیح۶۴
    تکرار n:
        x = (x * (1103515245 برگردان صحیح۶۴) + (12345 برگردان صحیح۶۴)) & (0x7fffffff برگردان صحیح۶۴)
        فشرده سازی.افزودن بایت(b، ((x >> 16) & (255 برگردان صحیح۶۴)) برگردان صحیح)
    پایان
    برگشت b
پایان

تابع split(label: رشته، hex: رشته، dir: رشته، chunk: صحیح): صحیح:
    packed := unhex(hex)
    ناپایا parts := 0
    ناپایا off := 0
    تا off کوچکتر packed.طول:
        take := packed.طول - off کوچکتر chunk ? packed.طول - off : chunk
        parts++
        name := مسیر پرونده.پیوند(dir، label + ".7z.00" + رشته.از عدد(parts برگردان صحیح۶۴))
        ناپایا piece := فشرده سازی.بافر بایت جدید با ظرفیت(take)
        فشرده سازی.افزودن بایت‌ها(piece، ((packed.داده برگردان صحیح۶۴) + (off برگردان صحیح۶۴)) برگردان تهی*، take)
        بایگانی.نوشتن پرونده دودویی از بافر(name، piece)
        فشرده سازی.آزادسازی بافر(piece)
        off += take
    پایان
    برگشت parts
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sevenzip_volumes_demo")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا names := وکتور {} برگردان وکتور<رشته>
    names.بیفزا("lz2")
    names.بیفزا("dfl")
    names.بیفزا("copy")
    ناپایا hexes := وکتور {} برگردان وکتور<رشته>
    hexes.بیفزا(F_LZ2)
    hexes.بیفزا(F_DFL)
    hexes.بیفزا(F_COPY)
    تکرار names.طول() در n:
        label := names.بگیر(n)
        parts := split(label، hexes.بگیر(n)، dir، 700)
        ناپایا sf := بایگانی.بازکردن پرونده هفت زد(مسیر پرونده.پیوند(dir، label + ".7z.001")، "")
        سرچاپ label، "volumes"، parts، sf.بخش ها.طول()، "status"، sf.وضعیت
        out := مسیر پرونده.پیوند(dir، "out_" + label)
        سرچاپ "  extract"، بایگانی.استخراج همه از پرونده هفت زد(sf، out، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)
        ناپایا ok := نادرست
        got := بایگانی.خواندن پرونده دودویی(مسیر پرونده.پیوند(out، "sub/deep/r.bin")، ok)
        سرچاپ "  noise"، ok و فشرده سازی.برابری بافر(got، noise(2000))
        ناپایا ok2 := نادرست
        got2 := بایگانی.خواندن پرونده دودویی(مسیر پرونده.پیوند(out، "sub/b.txt")، ok2)
        سرچاپ "  text"، ok2 و فشرده سازی.برابری بافر(got2، text(700))
        one := مسیر پرونده.پیوند(dir، label + "_b.txt")
        سرچاپ "  one"، بایگانی.استخراج از پرونده هفت زد به پرونده(sf، "sub/deep/r.bin"، one، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)
        بایگانی.بستن پرونده هفت زد(sf)
    پایان
    ناپایا vols := وکتور {} برگردان وکتور<رشته>
    تکرار 5 در v:
        vols.بیفزا(مسیر پرونده.پیوند(dir، "lz2.7z.00" + رشته.از عدد((v + 1) برگردان صحیح۶۴)))
    پایان
    whole := unhex(F_LZ2)
    mp := فشرده سازی.بازکردن چند پرونده برای خواندن(vols)
    window := حافظه.تخصیص صفرشده(40 برگردان طبیعی۶۴)
    got := فشرده سازی.خواندن از جایگاه پرونده(mp، 680 برگردان صحیح۶۴، window، 40)
    سرچاپ "joined"، فشرده سازی.اندازه پرونده(mp) برابر (whole.طول برگردان صحیح۶۴)، got، فشرده سازی.چک جمع سی آر سی(window، 40) برابر فشرده سازی.چک جمع سی آر سی(((whole.داده برگردان صحیح۶۴) + (680 برگردان صحیح۶۴)) برگردان تهی*، 40)
    حافظه.آزادسازی(window)
    فشرده سازی.بستن پرونده(mp)
    vols.آزادکن()
    ناپایا first := بایگانی.بازکردن پرونده هفت زد(مسیر پرونده.پیوند(dir، "lz2.7z.002")، "")
    سرچاپ "second volume only"، first.وضعیت
    بایگانی.بستن پرونده هفت زد(first)
    سیستم عامل.حذف همه(dir)
پایان
