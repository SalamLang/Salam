بسته ریشه

واردسازی شبکه.شدوساکس
واردسازی حافظه

ناپایا failures := 0

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures += 1
    پایان
پایان

تابع pattern(n: صحیح): تهی*:
    d := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    bp := d برگردان طبیعی۸*
    تکرار n در i:
        bp[i] = (i % 251) برگردان طبیعی۸
    پایان
    برگشت d
پایان

تابع seq(start: صحیح، n: صحیح): تهی*:
    d := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    bp := d برگردان طبیعی۸*
    تکرار n در i:
        bp[i] = (start + i) برگردان طبیعی۸
    پایان
    برگشت d
پایان

تابع hash_case(n: صحیح، want: رشته):
    d := pattern(n)
    out := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    شدوساکس.هش بلیک۳(d، n، out، 32)
    check("hash len " + n، شدوساکس.هگز از(out، 32) برابر want)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(d)
پایان

تابع keyed_case(n: صحیح، want: رشته):
    d := pattern(n)
    out := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    key := "whats the Elvish name for friend"
    شدوساکس.هش کلیددار بلیک۳(key برگردان تهی*، d، n، out، 32)
    check("keyed len " + n، شدوساکس.هگز از(out، 32) برابر want)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(d)
پایان

تابع derive_case(n: صحیح، want: رشته):
    d := pattern(n)
    out := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    شدوساکس.اشتقاق کلید بلیک۳("BLAKE3 2019-12-27 16:29:52 test vectors context"، d، n، out، 32)
    check("derive len " + n، شدوساکس.هگز از(out، 32) برابر want)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(d)
پایان

تابع session_case(k: صحیح، want: رشته):
    psk := seq(0، k)
    salt := seq(32، k)
    out := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    شدوساکس.کلید نشست بلیک۳(psk، k، salt، k، out)
    check("ss2022 session key " + k، شدوساکس.هگز از(out، k) برابر want)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(psk)
    حافظه.آزادسازی(salt)
پایان

