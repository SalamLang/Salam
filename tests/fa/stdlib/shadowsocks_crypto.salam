بسته ریشه

واردسازی شبکه.شدوساکس
واردسازی رمزنگاری
واردسازی حافظه

ناپایا failures := 0

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures += 1
    پایان
پایان

تابع pattern(n: صحیح): تهی*:
    d := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    bp := d برگردان طبیعی۸*
    تکرار n در i:
        bp[i] = ((i * 7 + 3) % 251) برگردان طبیعی۸
    پایان
    برگشت d
پایان

تابع sha_hex(p: تهی*، n: صحیح): رشته:
    out := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    رمزنگاری.شا۲۵۶ بایت(p، n، out)
    r := شدوساکس.هگز از(out، 32)
    حافظه.آزادسازی(out)
    برگشت r
پایان

تابع fixed_salt(n: صحیح): تهی*:
    s := حافظه.تخصیص صفرشده(n برگردان طبیعی۶۴)
    تکرار n در i:
        bp := s برگردان طبیعی۸*
        bp[i] = i برگردان طبیعی۸
    پایان
    برگشت s
پایان

تابع key_vectors():
    m128 := شدوساکس.یافتن روش("aes-128-gcm")
    m256 := شدوساکس.یافتن روش("aes-256-gcm")
    k128 := شدوساکس.کلید گذرواژه(m128، "barfoo!")
    k256 := شدوساکس.کلید گذرواژه(m256، "barfoo!")
    check("evp key 16"، شدوساکس.بافر به هگز(k128) برابر "b3adc47839e047eb228870526dc8fc30")
    check("evp key 32"، شدوساکس.بافر به هگز(k256) برابر "b3adc47839e047eb228870526dc8fc30b347287ffca3045dcea06b3fdf090acb")
    salt := fixed_salt(32)
    sub := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    شدوساکس.زیرکلید نشست(m256، k256.اشاره گر، salt، sub)
    check("hkdf sha1 subkey 32"، شدوساکس.هگز از(sub، 32) برابر "6e62f41174d7879ffea269ebf7805b730f62002e2b461f4dcb2a21dfb6f6423e")
    شدوساکس.زیرکلید نشست(m128، k128.اشاره گر، salt، sub)
    check("hkdf sha1 subkey 16"، شدوساکس.هگز از(sub، 16) برابر "9cd21fb890a57fbe98653cbadd4d047c")
    حافظه.آزادسازی(sub)
    حافظه.آزادسازی(salt)
    check("method chacha"، شدوساکس.یافتن روش("chacha20-ietf-poly1305").طول کلید برابر 32)
    check("method alias"، شدوساکس.یافتن روش("chacha20-poly1305").نام برابر "chacha20-ietf-poly1305")
    check("method unknown"، وارونه شدوساکس.یافتن روش("rc4-md5").معتبر)
    check("method 2022"، شدوساکس.یافتن روش("2022-blake3-aes-256-gcm").نسخه۲۰۲۲)
پایان

تابع frame_vectors(name: رشته، klen: صحیح، w1: رشته، w2: رشته):
    m := شدوساکس.یافتن روش(name)
    key := شدوساکس.کلید گذرواژه(m، "barfoo!")
    salt := fixed_salt(klen)
    ناپایا e := شدوساکس.رمزگذار جدید(m، key.اشاره گر، salt)
    ناپایا wire := شدوساکس.بافر جدید(100)
    شدوساکس.رمزگذاری جریان(e، "hello world" برگردان تهی*، 11، wire)
    check(name + " chunk vector"، شدوساکس.بافر به هگز(wire) برابر w1)
    ناپایا d := شدوساکس.رمزگشا جدید(m، key.اشاره گر)
    ناپایا pt := شدوساکس.بافر جدید(100)
    check(name + " decode"، شدوساکس.رمزگشایی همه(d، wire.اشاره گر، wire.طول، pt) و شدوساکس.بافر به رشته(pt) برابر "hello world")
    check(name + " salt seen"، d.نمک دریافت شد و شدوساکس.هگز از(d.نمک.اشاره گر، klen) برابر شدوساکس.هگز از(salt، klen))
    ناپایا e2 := شدوساکس.رمزگذار جدید(m، key.اشاره گر، salt)
    ناپایا wire2 := شدوساکس.بافر جدید(100)
    big := pattern(20000)
    شدوساکس.رمزگذاری جریان(e2، big، 20000، wire2)
    check(name + " big vector"، sha_hex(wire2.اشاره گر، wire2.طول) برابر w2)
    ناپایا d2 := شدوساکس.رمزگشا جدید(m، key.اشاره گر)
    ناپایا out2 := شدوساکس.بافر جدید(100)
    ناپایا bytewise := درست
    ناپایا i := 0
    تا i کوچکتر wire2.طول:
        اگر وارونه شدوساکس.رمزگشایی همه(d2، شدوساکس.بافر در(wire2، i)، 1، out2):
            bytewise = نادرست
        پایان
        i += 1
    پایان
    ناپایا same := out2.طول برابر 20000
    اگر same:
        same = sha_hex(out2.اشاره گر، 20000) برابر sha_hex(big، 20000)
    پایان
    check(name + " bytewise decode"، bytewise و same)
    ناپایا d3 := شدوساکس.رمزگشا جدید(m، key.اشاره گر)
    ناپایا out3 := شدوساکس.بافر جدید(100)
    half := wire.طول - 5
    check(name + " truncated needs more"، شدوساکس.رمزگشایی همه(d3، wire.اشاره گر، half، out3) و out3.طول برابر 0)
    ناپایا tampered := شدوساکس.بافر جدید(100)
    شدوساکس.افزودن به بافر(tampered، wire.اشاره گر، wire.طول)
    last := tampered.طول - 3
    bp := tampered.اشاره گر برگردان طبیعی۸*
    bp[last] = bp[last] ^ (1 برگردان طبیعی۸)
    ناپایا d4 := شدوساکس.رمزگشا جدید(m، key.اشاره گر)
    ناپایا out4 := شدوساکس.بافر جدید(100)
    check(name + " tamper payload"، وارونه شدوساکس.رمزگشایی همه(d4، tampered.اشاره گر، tampered.طول، out4))
    ناپایا t2 := شدوساکس.بافر جدید(100)
    شدوساکس.افزودن به بافر(t2، wire.اشاره گر، wire.طول)
    tp := t2.اشاره گر برگردان طبیعی۸*
    tp[klen + 1] = tp[klen + 1] ^ (128 برگردان طبیعی۸)
    ناپایا d5 := شدوساکس.رمزگشا جدید(m، key.اشاره گر)
    ناپایا out5 := شدوساکس.بافر جدید(100)
    check(name + " tamper length"، وارونه شدوساکس.رمزگشایی همه(d5، t2.اشاره گر، t2.طول، out5))
    wrong := شدوساکس.کلید گذرواژه(m، "other")
    ناپایا d6 := شدوساکس.رمزگشا جدید(m، wrong.اشاره گر)
    ناپایا out6 := شدوساکس.بافر جدید(100)
    check(name + " wrong key"، وارونه شدوساکس.رمزگشایی همه(d6، wire.اشاره گر، wire.طول، out6))
    ناپایا e3 := شدوساکس.رمزگذار جدید(m، key.اشاره گر، salt)
    ناپایا wire3 := شدوساکس.بافر جدید(100)
    شدوساکس.ارسال نمک(e3، wire3)
    hdr := حافظه.تخصیص صفرشده(2 برگردان طبیعی۶۴)
    hdr_b := hdr برگردان طبیعی۸*
    hdr_b[0] = 0x40 برگردان طبیعی۸
    شدوساکس.مهر قاب(e3، hdr، 2، wire3)
    ناپایا d7 := شدوساکس.رمزگشا جدید(m، key.اشاره گر)
    ناپایا out7 := شدوساکس.بافر جدید(100)
    check(name + " oversize length"، وارونه شدوساکس.رمزگشایی همه(d7، wire3.اشاره گر، wire3.طول، out7))
    حافظه.آزادسازی(hdr)
    حافظه.آزادسازی(big)
    حافظه.آزادسازی(salt)
پایان

تابع filter_tests():
    ناپایا f := شدوساکس.فیلتر نمک جدید(16)
    a := fixed_salt(16)
    b := fixed_salt(32)
    check("filter fresh"، شدوساکس.بررسی فیلتر(f، a، 16))
    check("filter replay"، وارونه شدوساکس.بررسی فیلتر(f، a، 16))
    check("filter other salt"، شدوساکس.بررسی فیلتر(f، b، 32))
    ناپایا all := درست
    تکرار 20 در i:
        s := fixed_salt(16)
        bp := s برگردان طبیعی۸*
        bp[0] = (100 + i) برگردان طبیعی۸
        اگر وارونه شدوساکس.بررسی فیلتر(f، s، 16):
            all = نادرست
        پایان
        حافظه.آزادسازی(s)
    پایان
    check("filter many fresh"، all)
    last := fixed_salt(16)
    lp := last برگردان طبیعی۸*
    lp[0] = 119 برگردان طبیعی۸
    check("filter rejects recent after rotation"، وارونه شدوساکس.بررسی فیلتر(f، last، 16))
    حافظه.آزادسازی(last)
    شدوساکس.آزادسازی فیلتر(f)
    حافظه.آزادسازی(a)
    حافظه.آزادسازی(b)
پایان

تابع ریشه:
    key_vectors()
    frame_vectors("aes-128-gcm"، 16، "000102030405060708090a0b0c0d0e0f6f5f882a74d5fab07da555f2c0f6825fadffe8a53f65d1433236ed8e6726f1e88216543573cb06960b526b1be1"، "0e4657146aecf803e655669bc66517d02814fe9a9969e93eef7412ebd3f26623")
    frame_vectors("aes-256-gcm"، 32، "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1ffe3c9ab4e40590a09e40d3c5f32b6a366172b6f5cc0f03c784b126233a90eb3b7921cf5c112b80a9fc0078ba04"، "3fbfd47b577199b9aa0ff0bd877e8afd25fc926450aac52fd2b8e47f44bd3988")
    frame_vectors("chacha20-ietf-poly1305"، 32، "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1fa024c071c593ddcea95345ad949e51ef08fa26d76ee13abf1c55ed31a27a0033053b6cf1398be6148ef5c2ff5d"، "74f5aae0c62be5711dd727d8fd6c41413ad06dcd1171374285228d132b4e22e4")
    filter_tests()
    سرچاپ "failures"، failures
    برگشت failures
پایان
