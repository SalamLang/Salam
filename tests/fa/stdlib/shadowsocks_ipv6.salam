واردسازی شبکه.شدوساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.یو دی پی
واردسازی حافظه
واردسازی رشته

پایا K16 := "AAECAwQFBgcICQoLDA0ODw=="

ناپایا failures := 0
ناپایا echo_srv := تی سی پی.سرور {}
ناپایا echo_sock := یو دی پی.سوکت یو دی پی {}
ناپایا echo_stop := نادرست
ناپایا relay := شدوساکس.سرور یو دی پی {}

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures++
    پایان
پایان

تابع echo_conn(c: تی سی پی.اتصال شبکه):
    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    ناپایا go := درست
    تا go:
        n := تی سی پی.خواندن بایت(c، buf، 8192)
        اگر n کوچکتربرابر 0:
            go = نادرست
        وگرنه:
            _w := تی سی پی.نوشتن بایت(c، buf، n)
        پایان
    پایان
    حافظه.آزادسازی(buf)
    تی سی پی.بستن(c)
پایان

تابع echo_main():
    ناپایا go := درست
    تا go:
        c := تی سی پی.پذیرش(echo_srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            go = نادرست
        وگرنه:
            echo_conn(c)
        پایان
    پایان
پایان

تابع udp_echo_main():
    buf := حافظه.تخصیص(4000 برگردان طبیعی۶۴)
    تا وارونه echo_stop:
        ناپایا h := ""
        ناپایا p := 0
        n := یو دی پی.دریافت بایت(echo_sock، buf، 4000، h، p)
        اگر n بزرگتر 0:
            _w := یو دی پی.ارسال بایت(echo_sock، h، p، buf، n)
        پایان
    پایان
    حافظه.آزادسازی(buf)
پایان

تابع serve_thread(ss: شدوساکس.وضعیت سرور*):
    شدوساکس.خدمت رله(شدوساکس.سرور { وضعیت = ss })
پایان

تابع relay_main():
    شدوساکس.خدمت یو دی پی(relay)
پایان

تابع tcp_through(host: رشته، port: صحیح، method: رشته، password: رشته، text: رشته): رشته:
    c := شدوساکس.برقراری اتصال(شدوساکس.پیکربندی { میزبان = host، درگاه = port، روش = method، گذرواژه = password }، "::1"، تی سی پی.درگاه(echo_srv))
    اگر وارونه شدوساکس.معتبر(c):
        برگشت "dial failed"
    پایان
    تی سی پی.تنظیم مهلت(c.وضعیت.سوکت، 5000)
    _w := شدوساکس.نوشتن(c، text برگردان تهی*، text.طول())
    got := حافظه.تخصیص صفرشده(256 برگردان طبیعی۶۴)
    ناپایا have := 0
    تا have کوچکتر text.طول():
        n := شدوساکس.خواندن(c، شدوساکس.اشاره گر در(got، have)، text.طول() - have)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        have += n
    پایان
    res := رشته.زیررشته(got برگردان رشته، 0، have)
    حافظه.آزادسازی(got)
    شدوساکس.بستن(c)
    برگشت res
پایان

تابع exchange(c: شدوساکس.کلاینت یو دی پی، text: رشته): رشته:
    اگر وارونه شدوساکس.ارسال یو دی پی(c، "::1"، یو دی پی.درگاه(echo_sock)، text برگردان تهی*، text.طول()):
        برگشت "send failed"
    پایان
    buf := حافظه.تخصیص صفرشده(2000 برگردان طبیعی۶۴)
    ناپایا from := شدوساکس.مقصد {}
    got := شدوساکس.دریافت یو دی پی(c، buf، 1999، from)
    ناپایا res := ""
    اگر got بزرگتر 0 و from.میزبان برابر "::1" و from.درگاه برابر یو دی پی.درگاه(echo_sock):
        res = رشته.زیررشته(buf برگردان رشته، 0، got)
    پایان
    حافظه.آزادسازی(buf)
    برگشت res
پایان

تابع tcp_case(label: رشته، listen_host: رشته، method: رشته، password: رشته):
    srv := شدوساکس.گوش دادن روی نشانی(listen_host، 0، method، password، "")
    check(label + " listen"، شدوساکس.سرور معتبر(srv))
    th := نخ‌ساز(serve_thread، srv.وضعیت)
    port := شدوساکس.درگاه سرور(srv)
    check(label + " via v6"، tcp_through("::1"، port، method، password، "hello over six") برابر "hello over six")
    اگر listen_host برابر "::":
        check(label + " via v4"، tcp_through("127.0.0.1"، port، method، password، "hello over four") برابر "hello over four")
    پایان
    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(th)
    شدوساکس.نابودی سرور(srv)
پایان

تابع udp_case(label: رشته، listen_host: رشته، client_host: رشته، method: رشته، server_pw: رشته):
    echo_stop = نادرست
    relay = شدوساکس.گوش دادن یو دی پی روی نشانی(listen_host، 0، method، server_pw)
    check(label + " server up"، relay.معتبر و شدوساکس.درگاه سرور یو دی پی(relay) بزرگتر 0)
    th := نخ‌ساز(relay_main)
    te := نخ‌ساز(udp_echo_main)
    c := شدوساکس.اتصال یو دی پی(شدوساکس.پیکربندی { میزبان = client_host، درگاه = شدوساکس.درگاه سرور یو دی پی(relay)، روش = method، گذرواژه = server_pw })
    شدوساکس.مهلت یو دی پی(c، 3000)
    check(label + " echo"، exchange(c، "ping-one") برابر "ping-one")
    check(label + " echo again"، exchange(c، "ping-two-longer") برابر "ping-two-longer")
    check(label + " big datagram"، exchange(c، رشته.تکرار("0123456789"، 100)) برابر رشته.تکرار("0123456789"، 100))
    شدوساکس.توقف یو دی پی(relay)
    نخ‌پیوند(th)
    echo_stop = درست
    شدوساکس.بستن یو دی پی(c)
    یو دی پی.ارسال به(یو دی پی.باز کردن همه خانواده()، "::1"، یو دی پی.درگاه(echo_sock)، "x")
    نخ‌پیوند(te)
    شدوساکس.نابودی یو دی پی(relay)
پایان

تابع ریشه:
    m := شدوساکس.یافتن روش("aes-256-gcm")
    key := شدوساکس.کلید گذرواژه(m، "wire-pw")
    ناپایا packed := شدوساکس.بافر جدید(128)
    check("pack v6 target"، شدوساکس.بسته بندی یو دی پی(m، key.اشاره‌گر، "2001:db8::53"، 53، "abc" برگردان تهی*، 3، packed) و packed.طول برابر m.طول نمک + 1 + 16 + 2 + 3 + 16)
    ناپایا t := شدوساکس.مقصد {}
    ناپایا out := شدوساکس.بافر جدید(64)
    check("unpack v6 target"، شدوساکس.بازکردن یو دی پی(m، key.اشاره‌گر، packed.اشاره‌گر، packed.طول، t، out) و t.میزبان برابر "2001:db8::53" و t.درگاه برابر 53 و شدوساکس.بافر به رشته(out) برابر "abc")

    probe := تی سی پی.پیوند روی("::1"، 0)
    اگر وارونه تی سی پی.معتبر(probe):
        سرچاپ "ipv6 unavailable"
        برگشت 0
    پایان
    تی سی پی.بستن سرور(probe)

    echo_srv = تی سی پی.پیوند روی("::1"، 0)
    echo_sock = یو دی پی.پیوند روی("::1"، 0)
    _te := نخ‌ساز(echo_main)

    tcp_case("tcp aes-256-gcm on ::1"، "::1"، "aes-256-gcm"، "tcp-pw")
    tcp_case("tcp chacha20 dual"، "::"، "chacha20-ietf-poly1305"، "tcp-pw")
    tcp_case("tcp 2022 on ::1"، "::1"، "2022-blake3-aes-128-gcm"، K16)

    udp_case("udp aes-256-gcm on ::1"، "::1"، "::1"، "aes-256-gcm"، "relay-pw")
    udp_case("udp dual relay, v4 client"، "::"، "127.0.0.1"، "aes-256-gcm"، "relay-pw")
    udp_case("udp dual relay, v6 client"، "::"، "::1"، "chacha20-ietf-poly1305"، "relay-pw")
    udp_case("udp 2022 on ::1"، "::1"، "::1"، "2022-blake3-aes-128-gcm"، K16)

    یو دی پی.بستن(echo_sock)
    سرچاپ "failures"، failures
    برگشت failures
پایان
