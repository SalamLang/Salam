واردسازی حافظه
واردسازی شبکه.شدوساکس

تابع salt(seed: صحیح): تهی*:
    p := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴) برگردان طبیعی۸*
    تکرار 32 در i:
        p[i] = ((seed * 31 + i) & 255) برگردان طبیعی۸
    پایان
    برگشت p برگردان تهی*
پایان

تابع ریشه():
    ناپایا f := شدوساکس.فیلتر نمک جدید(16)
    a := salt(1)
    b := salt(2)
    سرچاپ "fresh salt not seen"، شدوساکس.نمک دیده شده(f، a، 32)
    سرچاپ "looking does not record"، شدوساکس.نمک دیده شده(f، a، 32)
    سرچاپ "first use accepted"، شدوساکس.بررسی فیلتر(f، a، 32)
    سرچاپ "now seen"، شدوساکس.نمک دیده شده(f، a، 32)
    سرچاپ "replay refused"، شدوساکس.بررسی فیلتر(f، a، 32)
    سرچاپ "other salt unaffected"، شدوساکس.نمک دیده شده(f، b، 32)
    سرچاپ "other salt accepted"، شدوساکس.بررسی فیلتر(f، b، 32)
    حافظه.آزادسازی(a)
    حافظه.آزادسازی(b)
پایان
