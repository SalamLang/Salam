بسته ریشه

واردسازی شبکه.شدوساکس
واردسازی شبکه.یو دی پی
واردسازی تی ال اس
واردسازی حافظه
واردسازی رشته

پایا IP16 := "AQQHCg0QExYZHB8iJSgrLg=="
پایا UP16 := "MjU4Oz5BREdKTVBTVllcXw=="
پایا K16 := "AAECAwQFBgcICQoLDA0ODw=="
پایا K32 := "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="
پایا U32 := "MjM0NTY3ODk6Ozw9Pj9AQUJDREVGR0hJSktMTU4="
پایا CAP_UDP := "665f3cda97d39bdf53960eed002d1194fdd126cee8285bf4831cae22f3600300ab5d05e2be76afd1eca62764399a59289b98114ba3c2db794a4f0492e10c43a1e1e7c480dc9880"
پایا CAP_SALT := "3d99fecd443635d8c8409f16b74fa034"

ناپایا failures := 0
ناپایا echo_sock := یو دی پی.سوکت یو دی پی {}
ناپایا echo_stop := نادرست
ناپایا relay := شدوساکس.سرور یو دی پی {}

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures++
    پایان
پایان

تابع echo_main():
    buf := حافظه.تخصیص(4000 برگردان طبیعی۶۴)
    تا وارونه echo_stop:
        ناپایا h := ""
        ناپایا p := 0
        n := یو دی پی.دریافت بایت(echo_sock، buf، 4000، h، p)
        اگر n بزرگتر 0:
            _w := یو دی پی.ارسال بایت(echo_sock، h، p، buf، n)
        پایان
    پایان
    حافظه.آزادسازی(buf)
پایان

تابع relay_main():
    شدوساکس.خدمت یو دی پی(relay)
پایان

تابع exchange(c: شدوساکس.کلاینت یو دی پی، text: رشته): رشته:
    n := text.طول()
    اگر وارونه شدوساکس.ارسال یو دی پی(c، "127.0.0.1"، یو دی پی.درگاه(echo_sock)، text برگردان تهی*، n):
        برگشت "send failed"
    پایان
    buf := حافظه.تخصیص صفرشده(2000 برگردان طبیعی۶۴)
    ناپایا from := شدوساکس.مقصد {}
    got := شدوساکس.دریافت یو دی پی(c، buf، 1999، from)
    ناپایا res := ""
    اگر got بزرگتر 0 و from.میزبان برابر "127.0.0.1" و from.درگاه برابر یو دی پی.درگاه(echo_sock):
        res = رشته.زیررشته(buf برگردان رشته، 0، got)
    پایان
    حافظه.آزادسازی(buf)
    برگشت res
پایان

تابع raw_twice(pkt: شدوساکس.بافر، port: صحیح): صحیح:
    raw := یو دی پی.باز کردن()
    یو دی پی.تنظیم زمان انتظار(raw، 700)
    ناپایا answers := 0
    تکرار 2:
        یو دی پی.ارسال بایت(raw، "127.0.0.1"، port، pkt.اشاره گر، pkt.طول)
        buf := حافظه.تخصیص(2000 برگردان طبیعی۶۴)
        ناپایا h := ""
        ناپایا p := 0
        n := یو دی پی.دریافت بایت(raw، buf، 2000، h، p)
        اگر n بزرگتر 0:
            answers++
        پایان
        حافظه.آزادسازی(buf)
    پایان
    یو دی پی.بستن(raw)
    برگشت answers
پایان

تابع replay_probe(m: شدوساکس.روش، password: رشته): صحیح:
    اگر وارونه m.نسخه۲۰۲۲:
        key := شدوساکس.کلید گذرواژه(m، password)
        ناپایا lp := شدوساکس.بافر جدید(128)
        شدوساکس.بسته بندی یو دی پی(m، key.اشاره گر، "127.0.0.1"، یو دی پی.درگاه(echo_sock)، "replayed" برگردان تهی*، 8، lp)
        برگشت raw_twice(lp، شدوساکس.درگاه سرور یو دی پی(relay))
    پایان
    ناپایا chain := شدوساکس.زنجیره از(m، password)
    last := شدوساکس.کلید زنجیره(chain، chain.تعداد - 1)
    ناپایا eih := شدوساکس.بافر جدید(64)
    شدوساکس.افزودن به بافر(eih، chain.کلیدها.اشاره گر، (chain.تعداد - 1) * m.طول کلید)
    ناپایا hk := last
    اگر chain.تعداد بزرگتر 1:
        hk = eih.اشاره گر
    پایان
    ناپایا s := شدوساکس.نشست یو دی پی جدید()
    ناپایا pkt := شدوساکس.بافر جدید(128)
    ok := شدوساکس.بسته بندی یو دی پی نسخه جدید(m، last، hk، eih، chain.تعداد - 1، s، درست، "127.0.0.1"، یو دی پی.درگاه(echo_sock)، "replayed" برگردان تهی*، 8، pkt)
    ناپایا answers := 0
    اگر ok:
        answers = raw_twice(pkt، شدوساکس.درگاه سرور یو دی پی(relay))
    پایان
    شدوساکس.آزادسازی زنجیره(chain)
    برگشت answers
پایان

تابع e2e(label: رشته، method: رشته، server_pw: رشته، user_pw: رشته، client_pw: رشته):
    m := شدوساکس.یافتن روش(method)
    echo_stop = نادرست
    relay = شدوساکس.گوش دادن یو دی پی روی نشانی("127.0.0.1"، 0، method، server_pw)
    check(label + " server up"، relay.معتبر و شدوساکس.درگاه سرور یو دی پی(relay) بزرگتر 0)
    اگر user_pw نابرابر "":
        check(label + " add user"، شدوساکس.افزودن کاربر یو دی پی(relay، user_pw))
    پایان
    th := نخ‌ساز(relay_main)
    te := نخ‌ساز(echo_main)
    c := شدوساکس.اتصال یو دی پی(شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور یو دی پی(relay)، روش = method، گذرواژه = client_pw })
    شدوساکس.مهلت یو دی پی(c، 3000)
    check(label + " echo"، exchange(c، "ping-one") برابر "ping-one")
    check(label + " echo again"، exchange(c، "ping-two-longer") برابر "ping-two-longer")
    check(label + " big datagram"، exchange(c، رشته.تکرار("0123456789"، 100)) برابر رشته.تکرار("0123456789"، 100))
    c2 := شدوساکس.اتصال یو دی پی(شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور یو دی پی(relay)، روش = method، گذرواژه = client_pw })
    شدوساکس.مهلت یو دی پی(c2، 3000)
    check(label + " second client"، exchange(c2، "from-second") برابر "from-second")
    check(label + " replayed datagram answered once"، replay_probe(m، client_pw) برابر 1)
    شدوساکس.توقف یو دی پی(relay)
    نخ‌پیوند(th)
    echo_stop = درست
    نخ‌پیوند(te)
    شدوساکس.بستن یو دی پی(c)
    شدوساکس.بستن یو دی پی(c2)
    شدوساکس.نابودی یو دی پی(relay)
پایان

تابع chain_and_identity():
    m := شدوساکس.یافتن روش("2022-blake3-aes-128-gcm")
    ناپایا ch := شدوساکس.زنجیره از(m، IP16 + ":" + UP16)
    check("chain two keys"، ch.معتبر و ch.تعداد برابر 2 و ch.طول کلید برابر 16)
    check("chain key bytes"، شدوساکس.هگز از(شدوساکس.کلید زنجیره(ch، 0)، 16) برابر "0104070a0d101316191c1f2225282b2e")
    check("chain rejects bad key"، وارونه شدوساکس.زنجیره از(m، IP16 + ":AAAA").معتبر)
    check("chain needs 2022 method"، وارونه شدوساکس.زنجیره از(شدوساکس.یافتن روش("aes-128-gcm")، IP16).معتبر)
    check("eih length"، شدوساکس.طول سرآیند هویت برابر 16)
    check("identity context"، شدوساکس.زمینه هویت برابر "shadowsocks 2022 identity subkey")
    h := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    شدوساکس.هش هویت(شدوساکس.کلید زنجیره(ch، 1)، 16، h)
    check("identity hash is blake3 prefix"، شدوساکس.هگز از(h، 16) برابر "dea34a240a441fa8f7f6a2739353728e")
    salt := شدوساکس.بافر از هگز(CAP_SALT)
    blk := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    check("eih seal"، شدوساکس.مهر سرآیند هویت(شدوساکس.کلید زنجیره(ch، 0)، 16، salt.اشاره گر، 16، شدوساکس.کلید زنجیره(ch، 1)، blk))
    check("eih matches a reference server capture"، شدوساکس.هگز از(blk، 16) برابر "591b7073746e4cec45794be2cda49c13")
    out := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    check("eih open"، شدوساکس.گشودن سرآیند هویت(شدوساکس.کلید زنجیره(ch، 0)، 16، salt.اشاره گر، 16، blk، out))
    check("eih open recovers the hash"، شدوساکس.هگز از(out، 16) برابر شدوساکس.هگز از(h، 16))
    ik := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    شدوساکس.کلید هویت(شدوساکس.کلید زنجیره(ch، 0)، 16، salt.اشاره گر، 16، ik)
    check("identity key is 16 bytes of derived material"، شدوساکس.هگز از(ik، 16) نابرابر شدوساکس.هگز از(شدوساکس.کلید زنجیره(ch، 0)، 16))
    شدوساکس.آزادسازی زنجیره(ch)
    check("chain freed"، وارونه ch.معتبر و ch.تعداد برابر 0)
پایان

تابع window_and_capture():
    ناپایا w := شدوساکس.نشست یو دی پی {}
    check("window first"، شدوساکس.پذیرش شناسه بسته(w، 5 برگردان صحیح۶۴))
    check("window duplicate"، وارونه شدوساکس.پذیرش شناسه بسته(w، 5 برگردان صحیح۶۴))
    check("window older once"، شدوساکس.پذیرش شناسه بسته(w، 3 برگردان صحیح۶۴))
    check("window older twice"، وارونه شدوساکس.پذیرش شناسه بسته(w، 3 برگردان صحیح۶۴))
    check("window jump"، شدوساکس.پذیرش شناسه بسته(w، 100 برگردان صحیح۶۴))
    check("window too old"، وارونه شدوساکس.پذیرش شناسه بسته(w، 30 برگردان صحیح۶۴))
    check("window next"، شدوساکس.پذیرش شناسه بسته(w، 101 برگردان صحیح۶۴))
    s1 := شدوساکس.نشست یو دی پی جدید()
    s2 := شدوساکس.نشست یو دی پی جدید()
    check("sessions differ"، s1.شناسه نشست نابرابر s2.شناسه نشست و s1.شناسه بسته برابر 0)
    m := شدوساکس.یافتن روش("2022-blake3-aes-128-gcm")
    ناپایا ch := شدوساکس.زنجیره از(m، IP16 + ":" + UP16)
    cap := شدوساکس.بافر از هگز(CAP_UDP)
    ناپایا sid := 0 برگردان صحیح۶۴
    check("peek"، شدوساکس.نگاه به یو دی پی نسخه جدید(m، شدوساکس.کلید زنجیره(ch، 0)، cap.اشاره گر، cap.طول، sid))
    want := (0xea33ae80 برگردان صحیح۶۴) << (32 برگردان صحیح۶۴) | (0x25a6743e برگردان صحیح۶۴)
    check("peek reads the session id"، sid برابر want)
    h := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    check("identity from a reference client capture"، شدوساکس.هویت یو دی پی نسخه جدید(m، شدوساکس.کلید زنجیره(ch، 0)، cap.اشاره گر، cap.طول، h) و شدوساکس.هگز از(h، 16) برابر "dea34a240a441fa8f7f6a2739353728e")
    ناپایا sess := شدوساکس.نشست یو دی پی {}
    ناپایا t := شدوساکس.مقصد {}
    ناپایا body := شدوساکس.بافر جدید(64)
    check("old capture is refused for its timestamp"، وارونه شدوساکس.بازکردن یو دی پی نسخه جدید(m، شدوساکس.کلید زنجیره(ch، 1)، شدوساکس.کلید زنجیره(ch، 0)، 16، نادرست، cap.اشاره گر، cap.طول، sess، t، body))
    شدوساکس.آزادسازی زنجیره(ch)
پایان

تابع block_ciphers():
    key := شدوساکس.بافر از هگز("000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f")
    pt := شدوساکس.بافر از هگز("00112233445566778899aabbccddeeff")
    o := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    o2 := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    check("aes-128 ecb fips-197"، تی ال اس.بلوک ای ای اس ای سی بی(key.اشاره گر، 16، pt.اشاره گر، o، نادرست) و شدوساکس.هگز از(o، 16) برابر "69c4e0d86a7b0430d8cdb78070b4c55a")
    check("aes-128 ecb decrypt"، تی ال اس.بلوک ای ای اس ای سی بی(key.اشاره گر، 16، o، o2، درست) و شدوساکس.هگز از(o2، 16) برابر "00112233445566778899aabbccddeeff")
    check("aes-256 ecb fips-197"، تی ال اس.بلوک ای ای اس ای سی بی(key.اشاره گر، 32، pt.اشاره گر، o، نادرست) و شدوساکس.هگز از(o، 16) برابر "8ea2b7ca516745bfeafc49904b496089")
    check("aes-256 ecb decrypt"، تی ال اس.بلوک ای ای اس ای سی بی(key.اشاره گر، 32، o، o2، درست) و شدوساکس.هگز از(o2، 16) برابر "00112233445566778899aabbccddeeff")
    check("ecb refuses odd key length"، وارونه تی ال اس.بلوک ای ای اس ای سی بی(key.اشاره گر، 24، pt.اشاره گر، o، نادرست))
    xk := شدوساکس.بافر از هگز("808182838485868788898a8b8c8d8e8f909192939495969798999a9b9c9d9e9f")
    xn := شدوساکس.بافر از هگز("404142434445464748494a4b4c4d4e4f5051525354555657")
    msg := شدوساکس.بافر از هگز("0102030405060708090a0b0c0d0e0f1011121314")
    aad := شدوساکس.بافر از هگز("0001020304")
    out := حافظه.تخصیص صفرشده(40 برگردان طبیعی۶۴)
    check("xchacha20-poly1305 seal"، تی ال اس.مهر خام ایکس چاچا۲۰ پلی۱۳۰۵(xk.اشاره گر، xn.اشاره گر، aad.اشاره گر، 5، msg.اشاره گر، 20، out))
    check("xchacha20-poly1305 bytes"، شدوساکس.هگز از(out، 36) برابر "f00e70f05ef6f352f2187cdffba092452355617a340b75ecc59c00f027078d3044de2531")
    back := حافظه.تخصیص صفرشده(40 برگردان طبیعی۶۴)
    check("xchacha20-poly1305 open"، تی ال اس.گشودن خام ایکس چاچا۲۰ پلی۱۳۰۵(xk.اشاره گر، xn.اشاره گر، aad.اشاره گر، 5، out، 36، back) و شدوساکس.هگز از(back، 20) برابر "0102030405060708090a0b0c0d0e0f1011121314")
    bp := out برگردان طبیعی۸*
    bp[2] ^= (1 برگردان طبیعی۸)
    check("xchacha20-poly1305 tamper"، وارونه تی ال اس.گشودن خام ایکس چاچا۲۰ پلی۱۳۰۵(xk.اشاره گر، xn.اشاره گر، aad.اشاره گر، 5، out، 36، back))
    check("xchacha20-poly1305 short"، وارونه تی ال اس.گشودن خام ایکس چاچا۲۰ پلی۱۳۰۵(xk.اشاره گر، xn.اشاره گر، aad.اشاره گر، 5، out، 8، back))
پایان

تابع ریشه:
    block_ciphers()
    chain_and_identity()
    window_and_capture()
    echo_sock = یو دی پی.پیوند(0)
    یو دی پی.تنظیم زمان انتظار(echo_sock، 100)
    e2e("2022 aes-128"، "2022-blake3-aes-128-gcm"، K16، ""، K16)
    e2e("2022 aes-256"، "2022-blake3-aes-256-gcm"، K32، ""، K32)
    e2e("2022 chacha20"، "2022-blake3-chacha20-poly1305"، K32، ""، K32)
    e2e("2022 aes-128 multi user"، "2022-blake3-aes-128-gcm"، IP16، UP16، IP16 + ":" + UP16)
    e2e("legacy aes-256"، "aes-256-gcm"، "legacy-pw"، ""، "legacy-pw")
    یو دی پی.بستن(echo_sock)
    سرچاپ "failures"، failures
    برگشت failures
پایان
