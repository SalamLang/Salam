بسته ریشه

واردسازی شبکه.شدوساکس
واردسازی شبکه.تی سی پی
واردسازی حافظه
واردسازی زمان

ناپایا failures := 0
ناپایا echo_srv := تی سی پی.سرور {}

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures += 1
    پایان
پایان

تابع echo_conn(c: تی سی پی.اتصال شبکه):
    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    ناپایا go := درست
    تا go:
        n := تی سی پی.خواندن بایت(c، buf، 8192)
        اگر n کوچکتربرابر 0:
            go = نادرست
        وگرنه:
            _w := تی سی پی.نوشتن بایت(c، buf، n)
        پایان
    پایان
    حافظه.آزادسازی(buf)
    تی سی پی.بستن(c)
پایان

تابع echo_main():
    ناپایا go := درست
    تا go:
        c := تی سی پی.پذیرش(echo_srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            go = نادرست
        وگرنه:
            echo_conn(c)
        پایان
    پایان
پایان

تابع serve_thread(ss: شدوساکس.وضعیت سرور*):
    شدوساکس.خدمت رله(شدوساکس.سرور { وضعیت = ss })
پایان

تابع pattern(n: صحیح): تهی*:
    d := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    bp := d برگردان طبیعی۸*
    تکرار n در i:
        bp[i] = ((i * 7 + 3) % 251) برگردان طبیعی۸
    پایان
    برگشت d
پایان

تابع echo_through(port: صحیح، cfg: شدوساکس.پیکربندی، total: صحیح): صحیح:
    c := شدوساکس.برقراری اتصال(شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = port، روش = cfg.روش، گذرواژه = cfg.گذرواژه، پوشش = cfg.پوشش، میزبان پوشش = cfg.میزبان پوشش }، "127.0.0.1"، تی سی پی.درگاه(echo_srv))
    اگر وارونه شدوساکس.معتبر(c):
        برگشت 0 - 1
    پایان
    تی سی پی.تنظیم مهلت(c.وضعیت.سوکت، 5000)
    data := pattern(total)
    got := حافظه.تخصیص صفرشده((total + 1) برگردان طبیعی۶۴)
    _w := شدوساکس.نوشتن(c، data، total)
    ناپایا have := 0
    تا have کوچکتر total:
        n := شدوساکس.خواندن(c، شدوساکس.اشاره گر در(got، have)، total - have)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        have += n
    پایان
    ناپایا same := درست
    تکرار have در i:
        bp := data برگردان طبیعی۸*
        gp := got برگردان طبیعی۸*
        اگر bp[i] نابرابر gp[i]:
            same = نادرست
        پایان
    پایان
    حافظه.آزادسازی(data)
    حافظه.آزادسازی(got)
    شدوساکس.بستن(c)
    اگر وارونه same:
        برگشت 0 - 2
    پایان
    برگشت have
پایان

تابع run_case(label: رشته، method: رشته، password: رشته، obfs: رشته، total: صحیح):
    srv := شدوساکس.گوش دادن با پوشش(تی سی پی.درگاه آزاد()، method، password، obfs)
    اگر وارونه شدوساکس.سرور معتبر(srv):
        check(label + " listen"، نادرست)
        برگشت
    پایان
    th := نخ‌ساز(serve_thread، srv.وضعیت)
    cfg := شدوساکس.پیکربندی { روش = method، گذرواژه = password، پوشش = obfs، میزبان پوشش = "cdn.example.com" }
    check(label + " small"، echo_through(شدوساکس.درگاه سرور(srv)، cfg، 11) برابر 11)
    check(label + " large"، echo_through(شدوساکس.درگاه سرور(srv)، cfg، total) برابر total)
    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(th)
    شدوساکس.نابودی سرور(srv)
پایان

تابع bad_password_case(label: رشته، method: رشته، good: رشته، bad: رشته):
    srv := شدوساکس.گوش دادن(تی سی پی.درگاه آزاد()، method، good)
    th := نخ‌ساز(serve_thread، srv.وضعیت)
    cfg := شدوساکس.پیکربندی { روش = method، گذرواژه = bad }
    check(label + " wrong password gets nothing"، echo_through(شدوساکس.درگاه سرور(srv)، cfg، 11) برابر 0)
    cfg2 := شدوساکس.پیکربندی { روش = method، گذرواژه = good }
    check(label + " server survives bad client"، echo_through(شدوساکس.درگاه سرور(srv)، cfg2، 11) برابر 11)
    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(th)
    شدوساکس.نابودی سرور(srv)
پایان

تابع replay_case():
    method := "aes-256-gcm"
    m := شدوساکس.یافتن روش(method)
    srv := شدوساکس.گوش دادن(تی سی پی.درگاه آزاد()، method، "replay-pw")
    th := نخ‌ساز(serve_thread، srv.وضعیت)
    key := شدوساکس.کلید گذرواژه(m، "replay-pw")
    salt := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    sp := salt برگردان طبیعی۸*
    تکرار 32 در i:
        sp[i] = (200 - i) برگردان طبیعی۸
    پایان
    ناپایا e := شدوساکس.رمزگذار جدید(m، key.اشاره گر، salt)
    ناپایا plain := شدوساکس.بافر جدید(64)
    شدوساکس.رمزگذاری مقصد("127.0.0.1"، تی سی پی.درگاه(echo_srv)، plain)
    شدوساکس.افزودن رشته به بافر(plain، "replay!")
    ناپایا wire := شدوساکس.بافر جدید(64)
    شدوساکس.رمزگذاری جریان(e، plain.اشاره گر، plain.طول، wire)
    port := شدوساکس.درگاه سرور(srv)
    ناپایا answers := 0
    تکرار 2 در attempt:
        raw := تی سی پی.شماره گیری("127.0.0.1"، port)
        تی سی پی.تنظیم مهلت(raw، 3000)
        _w := تی سی پی.نوشتن بایت(raw، wire.اشاره گر، wire.طول)
        ناپایا d := شدوساکس.رمزگشا جدید(m، key.اشاره گر)
        ناپایا out := شدوساکس.بافر جدید(64)
        buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
        ناپایا go := درست
        تا go:
            n := تی سی پی.خواندن بایت(raw، buf، 4096)
            اگر n کوچکتربرابر 0:
                go = نادرست
            وگرنه:
                _ok := شدوساکس.رمزگشایی همه(d، buf، n، out)
                اگر out.طول بزرگتربرابر 7:
                    go = نادرست
                پایان
            پایان
        پایان
        اگر شدوساکس.بافر به رشته(out) برابر "replay!":
            answers += 1
        پایان
        حافظه.آزادسازی(buf)
        تی سی پی.بستن(raw)
        اگر attempt برابر 0:
            check("replay first flight answered"، answers برابر 1)
        پایان
    پایان
    check("replayed salt is dropped"، answers برابر 1)
    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(th)
    شدوساکس.نابودی سرور(srv)
پایان

تابع put_be64(b &: شدوساکس.بافر، v: صحیح۶۴):
    تکرار 8 در i:
        شدوساکس.افزودن بایت به بافر(b، ((v >> (((7 - i) * 8) برگردان صحیح۶۴)) & (255 برگردان صحیح۶۴)) برگردان صحیح)
    پایان
پایان

تابع flight_2022(m: شدوساکس.روش، key: شدوساکس.بافر، ts_offset: صحیح۶۴): شدوساکس.بافر:
    ناپایا e := شدوساکس.رمزگذار جدید تصادفی(m، key.اشاره گر)
    ناپایا v := شدوساکس.بافر جدید(64)
    شدوساکس.رمزگذاری مقصد("127.0.0.1"، تی سی پی.درگاه(echo_srv)، v)
    شدوساکس.افزودن بایت به بافر(v، 0)
    شدوساکس.افزودن بایت به بافر(v، 0)
    شدوساکس.افزودن رشته به بافر(v، "stale?")
    ناپایا fixed := شدوساکس.بافر جدید(16)
    شدوساکس.افزودن بایت به بافر(fixed، 0)
    put_be64(fixed، زمان.اکنون() + ts_offset)
    شدوساکس.افزودن بایت به بافر(fixed، v.طول >> 8)
    شدوساکس.افزودن بایت به بافر(fixed، v.طول)
    ناپایا wire := شدوساکس.بافر جدید(128)
    شدوساکس.ارسال نمک(e، wire)
    شدوساکس.مهر قاب(e، fixed.اشاره گر، fixed.طول، wire)
    شدوساکس.مهر قاب(e، v.اشاره گر، v.طول، wire)
    برگشت wire
پایان

تابع answered(port: صحیح، wire: شدوساکس.بافر، m: شدوساکس.روش): منطقی:
    raw := تی سی پی.شماره گیری("127.0.0.1"، port)
    تی سی پی.تنظیم مهلت(raw، 1500)
    _w := تی سی پی.نوشتن بایت(raw، wire.اشاره گر، wire.طول)
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    n := تی سی پی.خواندن بایت(raw، buf، 4096)
    حافظه.آزادسازی(buf)
    تی سی پی.بستن(raw)
    برگشت n بزرگتر m.طول نمک
پایان

تابع timestamp_case():
    m := شدوساکس.یافتن روش("2022-blake3-aes-128-gcm")
    psk := "AAECAwQFBgcICQoLDA0ODw=="
    srv := شدوساکس.گوش دادن(تی سی پی.درگاه آزاد()، "2022-blake3-aes-128-gcm"، psk)
    th := نخ‌ساز(serve_thread، srv.وضعیت)
    key := شدوساکس.ساخت کلید(m، psk)
    port := شدوساکس.درگاه سرور(srv)
    check("2022 fresh timestamp answered"، answered(port، flight_2022(m، key، 0 برگردان صحیح۶۴)، m))
    check("2022 old timestamp rejected"، وارونه answered(port، flight_2022(m، key، (0 - 120) برگردان صحیح۶۴)، m))
    check("2022 future timestamp rejected"، وارونه answered(port، flight_2022(m، key، 120 برگردان صحیح۶۴)، m))
    check("2022 edge timestamp accepted"، answered(port، flight_2022(m، key، (0 - 20) برگردان صحیح۶۴)، m))
    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(th)
    شدوساکس.نابودی سرور(srv)
پایان

تابع relay_through_stream_interface():
    srv := شدوساکس.گوش دادن(تی سی پی.درگاه آزاد()، "chacha20-ietf-poly1305"، "iface")
    th := نخ‌ساز(serve_thread، srv.وضعیت)
    c := شدوساکس.برقراری اتصال(شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور(srv)، روش = "chacha20-ietf-poly1305"، گذرواژه = "iface" }، "127.0.0.1"، تی سی پی.درگاه(echo_srv))
    s := شدوساکس.به عنوان جریان(c)
    check("stream ok"، s.معتبر())
    _w := s.نوشتن بایت("via stream interface" برگردان تهی*، 20)
    buf := حافظه.تخصیص صفرشده(64 برگردان طبیعی۶۴)
    ناپایا have := 0
    تا have کوچکتر 20:
        n := s.خواندن بایت(شدوساکس.اشاره گر در(buf، have)، 20 - have)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        have += n
    پایان
    check("stream interface echo"، have برابر 20 و (buf برگردان رشته) برابر "via stream interface")
    حافظه.آزادسازی(buf)
    s.بستن()
    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(th)
    شدوساکس.نابودی سرور(srv)
پایان

تابع ریشه:
    echo_srv = تی سی پی.پیوند(تی سی پی.درگاه آزاد())
    _th := نخ‌ساز(echo_main)
    run_case("aes-128-gcm"، "aes-128-gcm"، "pw-one"، ""، 100000)
    run_case("aes-256-gcm"، "aes-256-gcm"، "pw-two"، ""، 100000)
    run_case("chacha20"، "chacha20-ietf-poly1305"، "pw-three"، ""، 100000)
    run_case("http obfs"، "aes-256-gcm"، "pw-four"، "http"، 70000)
    run_case("tls obfs"، "chacha20-ietf-poly1305"، "pw-five"، "tls"، 70000)
    run_case("2022 aes-128"، "2022-blake3-aes-128-gcm"، "AAECAwQFBgcICQoLDA0ODw=="، ""، 200000)
    run_case("2022 aes-256"، "2022-blake3-aes-256-gcm"، "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="، ""، 200000)
    run_case("2022 chacha20"، "2022-blake3-chacha20-poly1305"، "AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8="، ""، 70000)
    bad_password_case("legacy"، "aes-256-gcm"، "good-pw"، "bad-pw")
    bad_password_case("2022"، "2022-blake3-aes-128-gcm"، "AAECAwQFBgcICQoLDA0ODw=="، "AAECAwQFBgcICQoLDA0ODg==")
    replay_case()
    timestamp_case()
    relay_through_stream_interface()
    تی سی پی.بستن سرور(echo_srv)
    سرچاپ "failures"، failures
    برگشت failures
پایان
