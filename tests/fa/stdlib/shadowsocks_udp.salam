بسته ریشه

واردسازی شبکه.شدوساکس
واردسازی شبکه.یو دی پی
واردسازی حافظه
واردسازی رشته

ناپایا failures := 0
ناپایا echo_sock := یو دی پی.سوکت یو دی پی {}
ناپایا relay := شدوساکس.سرور یو دی پی {}

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures++
    پایان
پایان

تابع echo_main():
    buf := حافظه.تخصیص(4000 برگردان طبیعی۶۴)
    ناپایا served := 0
    تا served کوچکتر 4:
        ناپایا h := ""
        ناپایا p := 0
        n := یو دی پی.دریافت بایت(echo_sock، buf، 4000، h، p)
        اگر n بزرگتر 0:
            _w := یو دی پی.ارسال بایت(echo_sock، h، p، buf، n)
            served++
        پایان
    پایان
    حافظه.آزادسازی(buf)
پایان

تابع relay_main():
    شدوساکس.خدمت یو دی پی(relay)
پایان

تابع vector_case(method: رشته، pw: رشته، hex: رشته):
    m := شدوساکس.یافتن روش(method)
    key := شدوساکس.کلید گذرواژه(m، pw)
    pkt := شدوساکس.بافر از هگز(hex)
    ناپایا t := شدوساکس.مقصد {}
    ناپایا out := شدوساکس.بافر جدید(64)
    ok := شدوساکس.بازکردن یو دی پی(m، key.اشاره گر، pkt.اشاره گر، pkt.طول، t، out)
    check(method + " udp vector"، ok و t.میزبان برابر "10.0.0.7" و t.درگاه برابر 5353 و شدوساکس.بافر به رشته(out) برابر "dns-query-bytes")
    tp := pkt.اشاره گر برگردان طبیعی۸*
    tp[pkt.طول - 1] ^= (1 برگردان طبیعی۸)
    ناپایا t2 := شدوساکس.مقصد {}
    ناپایا out2 := شدوساکس.بافر جدید(64)
    check(method + " udp tamper"، وارونه شدوساکس.بازکردن یو دی پی(m، key.اشاره گر، pkt.اشاره گر، pkt.طول، t2، out2))
    ناپایا packed := شدوساکس.بافر جدید(64)
    check(method + " udp pack"، شدوساکس.بسته بندی یو دی پی(m، key.اشاره گر، "example.org"، 53، "abc" برگردان تهی*، 3، packed) و packed.طول برابر m.طول نمک + 1 + 1 + 11 + 2 + 3 + 16)
    ناپایا t3 := شدوساکس.مقصد {}
    ناپایا out3 := شدوساکس.بافر جدید(64)
    check(method + " udp pack round trip"، شدوساکس.بازکردن یو دی پی(m، key.اشاره گر، packed.اشاره گر، packed.طول، t3، out3) و t3.میزبان برابر "example.org" و t3.درگاه برابر 53 و شدوساکس.بافر به رشته(out3) برابر "abc")
پایان

تابع exchange(c: شدوساکس.کلاینت یو دی پی، text: رشته): رشته:
    n := text.طول()
    اگر وارونه شدوساکس.ارسال یو دی پی(c، "127.0.0.1"، یو دی پی.درگاه(echo_sock)، text برگردان تهی*، n):
        برگشت "send failed"
    پایان
    buf := حافظه.تخصیص صفرشده(2000 برگردان طبیعی۶۴)
    ناپایا from := شدوساکس.مقصد {}
    got := شدوساکس.دریافت یو دی پی(c، buf، 1999، from)
    ناپایا res := ""
    اگر got بزرگتر 0 و from.میزبان برابر "127.0.0.1" و from.درگاه برابر یو دی پی.درگاه(echo_sock):
        res = رشته.زیررشته(buf برگردان رشته، 0، got)
    پایان
    حافظه.آزادسازی(buf)
    برگشت res
پایان

تابع ریشه:
    vector_case("aes-128-gcm"، "udp-pw"، "6465666768696a6b6c6d6e6f70717273987eaa8ddd99009cd4f1bd92c1e20894a4c0ac7c2b3cf835f1815f5339c735ca909536138f6f")
    vector_case("aes-256-gcm"، "udp-pw"، "6465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80818283c00c4075774e0388b4265fc06d6d7066874f8d5ce128ef2dd95e4927412577138639fbd90e4f")
    vector_case("chacha20-ietf-poly1305"، "udp-pw"، "6465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f808182838e333524ce186c650e6efda2e934806e65a69fc765eecf48250478e36d68d6bfed42a0a46e3a")
    echo_sock = یو دی پی.پیوند(0)
    relay = شدوساکس.گوش دادن یو دی پی(0، "aes-256-gcm"، "relay-pw")
    check("udp server up"، relay.معتبر و شدوساکس.درگاه سرور یو دی پی(relay) بزرگتر 0)
    th := نخ‌ساز(relay_main)
    te := نخ‌ساز(echo_main)
    c := شدوساکس.اتصال یو دی پی(شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور یو دی پی(relay)، روش = "aes-256-gcm"، گذرواژه = "relay-pw" })
    شدوساکس.مهلت یو دی پی(c، 3000)
    check("udp echo"، exchange(c، "ping-one") برابر "ping-one")
    check("udp echo again"، exchange(c، "ping-two-longer") برابر "ping-two-longer")
    c2 := شدوساکس.اتصال یو دی پی(شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور یو دی پی(relay)، روش = "aes-256-gcm"، گذرواژه = "relay-pw" })
    شدوساکس.مهلت یو دی پی(c2، 3000)
    check("udp second client"، exchange(c2، "from-second") برابر "from-second")
    bad := شدوساکس.اتصال یو دی پی(شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور یو دی پی(relay)، روش = "aes-256-gcm"، گذرواژه = "wrong" })
    شدوساکس.مهلت یو دی پی(bad، 400)
    check("udp wrong password is ignored"، exchange(bad، "nope") برابر "")
    check("udp server survives bad packet"، exchange(c، "still-alive") برابر "still-alive")
    شدوساکس.توقف یو دی پی(relay)
    نخ‌پیوند(th)
    نخ‌پیوند(te)
    شدوساکس.بستن یو دی پی(c)
    شدوساکس.بستن یو دی پی(c2)
    شدوساکس.بستن یو دی پی(bad)
    شدوساکس.نابودی یو دی پی(relay)
    یو دی پی.بستن(echo_sock)
    سرچاپ "failures"، failures
    برگشت failures
پایان
