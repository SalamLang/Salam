بسته ریشه

واردسازی شبکه.شدوساکس
واردسازی شبکه.تی سی پی
واردسازی حافظه

پایا IP16 := "AQQHCg0QExYZHB8iJSgrLg=="
پایا UP16 := "MjU4Oz5BREdKTVBTVllcXw=="
پایا UQ16 := "MjM0NTY3ODk6Ozw9Pj9AQQ=="
پایا K16 := "AAECAwQFBgcICQoLDA0ODw=="

ناپایا failures := 0
ناپایا echo_srv := تی سی پی.سرور {}

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures++
    پایان
پایان

تابع echo_conn(c: تی سی پی.اتصال شبکه):
    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    ناپایا go := درست
    تا go:
        n := تی سی پی.خواندن بایت(c، buf، 8192)
        اگر n کوچکتربرابر 0:
            go = نادرست
        وگرنه:
            _w := تی سی پی.نوشتن بایت(c، buf، n)
        پایان
    پایان
    حافظه.آزادسازی(buf)
    تی سی پی.بستن(c)
پایان

تابع echo_main():
    ناپایا go := درست
    تا go:
        c := تی سی پی.پذیرش(echo_srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            go = نادرست
        وگرنه:
            echo_conn(c)
        پایان
    پایان
پایان

تابع serve_thread(ss: شدوساکس.وضعیت سرور*):
    شدوساکس.خدمت رله(شدوساکس.سرور { وضعیت = ss })
پایان

تابع round_trip(port: صحیح، password: رشته): منطقی:
    c := شدوساکس.برقراری اتصال(شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = port، روش = "2022-blake3-aes-128-gcm"، گذرواژه = password }، "127.0.0.1"، تی سی پی.درگاه(echo_srv))
    اگر وارونه شدوساکس.معتبر(c):
        برگشت نادرست
    پایان
    تی سی پی.تنظیم مهلت(c.وضعیت.سوکت، 3000)
    _w := شدوساکس.نوشتن رشته(c، "hello users")
    got := شدوساکس.خواندن رشته(c، 64)
    شدوساکس.بستن(c)
    برگشت got برابر "hello users"
پایان

تابع ریشه:
    echo_srv = تی سی پی.پیوند(تی سی پی.درگاه آزاد())
    _te := نخ‌ساز(echo_main)
    srv := شدوساکس.گوش دادن روی نشانی("127.0.0.1"، تی سی پی.درگاه آزاد()، "2022-blake3-aes-128-gcm"، IP16، "")
    check("listen on loopback"، شدوساکس.سرور معتبر(srv))
    check("add first user"، شدوساکس.افزودن کاربر(srv، "alice"، UP16))
    check("add second user"، شدوساکس.افزودن کاربر(srv، "bob"، UQ16))
    th := نخ‌ساز(serve_thread، srv.وضعیت)
    port := شدوساکس.درگاه سرور(srv)
    check("first user connects"، round_trip(port، IP16 + ":" + UP16))
    check("second user connects"، round_trip(port، IP16 + ":" + UQ16))
    check("unknown user is refused"، وارونه round_trip(port، IP16 + ":" + K16))
    check("plain server key is refused when users exist"، وارونه round_trip(port، IP16))
    check("first user still connects"، round_trip(port، IP16 + ":" + UP16))
    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(th)
    شدوساکس.نابودی سرور(srv)
    plain := شدوساکس.گوش دادن روی نشانی("127.0.0.1"، تی سی پی.درگاه آزاد()، "aes-256-gcm"، "pw"، "")
    check("users need a 2022 method"، وارونه شدوساکس.افزودن کاربر(plain، "x"، UP16))
    شدوساکس.نابودی سرور(plain)
    تی سی پی.بستن سرور(echo_srv)
    سرچاپ "failures"، failures
    برگشت failures
پایان
