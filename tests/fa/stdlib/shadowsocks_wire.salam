بسته ریشه

واردسازی شبکه.شدوساکس
واردسازی حافظه

ناپایا failures := 0

تابع check(name: رشته، ok: منطقی):
    اگر ok:
        سرچاپ "PASS"، name
    وگرنه:
        سرچاپ "FAIL"، name
        failures += 1
    پایان
پایان

تابع addr_case(host: رشته، port: صحیح، want_hex: رشته، want_host: رشته):
    ناپایا b := شدوساکس.بافر جدید(64)
    ok := شدوساکس.رمزگذاری مقصد(host، port، b)
    ناپایا t := شدوساکس.مقصد {}
    n := شدوساکس.تجزیه مقصد(b.اشاره گر، b.طول، t)
    check("addr " + host، ok و شدوساکس.بافر به هگز(b) برابر want_hex و n برابر b.طول و t.میزبان برابر want_host و t.درگاه برابر port)
    ناپایا short := شدوساکس.مقصد {}
    check("addr partial " + host، شدوساکس.تجزیه مقصد(b.اشاره گر، b.طول - 1، short) برابر 0)
    شدوساکس.آزادسازی بافر(b)
پایان

تابع addr_tests():
    addr_case("example.com"، 443، "030b6578616d706c652e636f6d01bb"، "example.com")
    addr_case("1.2.3.4"، 80، "01010203040050"، "1.2.3.4")
    addr_case("::1"، 8080، "04" + "00000000000000000000000000000001" + "1f90"، "::1")
    addr_case("2001:db8::ff00:42:8329"، 1، "0420010db8000000000000ff00004283290001"، "2001:db8::ff00:42:8329")
    addr_case("[fe80::1]"، 2، "04fe8000000000000000000000000000010002"، "fe80::1")
    addr_case("1:2:3:4:5:6:7:8"، 3، "04000100020003000400050006000700080003"، "1:2:3:4:5:6:7:8")
    addr_case("256.1.1.1"، 5، "03093235362e312e312e310005"، "256.1.1.1")
    ناپایا b := شدوساکس.بافر جدید(8)
    check("addr bad port"، وارونه شدوساکس.رمزگذاری مقصد("a.b"، 70000، b))
    bad := شدوساکس.بافر از هگز("0900")
    ناپایا t := شدوساکس.مقصد {}
    check("addr bad type"، شدوساکس.تجزیه مقصد(bad.اشاره گر، bad.طول، t) کوچکتر 0)
پایان

تابع feed_slow(src: شدوساکس.بافر، o &: شدوساکس.پوشش، out &: شدوساکس.بافر، step: صحیح): منطقی:
    ناپایا i := 0
    تا i کوچکتر src.طول:
        ناپایا take := step
        اگر take بزرگتر src.طول - i:
            take = src.طول - i
        پایان
        اگر شدوساکس.برداشتن پوشش(o، شدوساکس.بافر در(src، i)، take، out) کوچکتر 0:
            برگشت نادرست
        پایان
        i += take
    پایان
    برگشت درست
پایان

تابع obfs_case(name: رشته، mode: صحیح، size: صحیح):
    ناپایا client := شدوساکس.آماده سازی پوشش(mode، نادرست، "cdn.example.com")
    ناپایا server := شدوساکس.آماده سازی پوشش(mode، درست، "")
    payload := حافظه.تخصیص صفرشده((size + 1) برگردان طبیعی۶۴)
    pp := payload برگردان طبیعی۸*
    تکرار size در i:
        pp[i] = ((i * 13 + 5) % 251) برگردان طبیعی۸
    پایان
    ناپایا wire := شدوساکس.بافر جدید(256)
    شدوساکس.پوشاندن داده(client، payload، size، wire)
    ناپایا got := شدوساکس.بافر جدید(256)
    ok1 := feed_slow(wire، server، got، 7)
    ناپایا same := got.طول برابر size
    اگر same:
        gp := got.اشاره گر برگردان طبیعی۸*
        تکرار size در j:
            اگر gp[j] نابرابر pp[j]:
                same = نادرست
            پایان
        پایان
    پایان
    check(name + " client to server"، ok1 و same)
    ناپایا wire2 := شدوساکس.بافر جدید(256)
    شدوساکس.پوشاندن داده(client، payload، size، wire2)
    ناپایا got2 := شدوساکس.بافر جدید(256)
    ok2 := feed_slow(wire2، server، got2، 1000)
    check(name + " second write"، ok2 و got2.طول برابر size)
    ناپایا wire3 := شدوساکس.بافر جدید(256)
    شدوساکس.پوشاندن داده(server، payload، size، wire3)
    ناپایا got3 := شدوساکس.بافر جدید(256)
    ok3 := feed_slow(wire3، client، got3، 5)
    check(name + " server to client"، ok3 و got3.طول برابر size)
    ناپایا wire4 := شدوساکس.بافر جدید(256)
    شدوساکس.پوشاندن داده(server، payload، size، wire4)
    ناپایا got4 := شدوساکس.بافر جدید(256)
    ok4 := feed_slow(wire4، client، got4، 4096)
    check(name + " server second write"، ok4 و got4.طول برابر size)
    حافظه.آزادسازی(payload)
پایان

تابع obfs_shape():
    ناپایا client := شدوساکس.آماده سازی پوشش(شدوساکس.پوشش اچ تی تی پی، نادرست، "cdn.example.com")
    ناپایا w := شدوساکس.بافر جدید(256)
    شدوساکس.پوشاندن داده(client، "abc" برگردان تهی*، 3، w)
    text := شدوساکس.بافر به رشته(w)
    check("http starts with GET"، text.شروع با("GET / HTTP/1.1\r\nHost: cdn.example.com\r\n"))
    check("http has upgrade"، text.دربردارد("Upgrade: websocket\r\n") و text.دربردارد("Content-Length: 3\r\n\r\nabc"))
    ناپایا c2 := شدوساکس.آماده سازی پوشش(شدوساکس.پوشش تی ال اس، نادرست، "cdn.example.com")
    ناپایا w2 := شدوساکس.بافر جدید(256)
    شدوساکس.پوشاندن داده(c2، "abc" برگردان تهی*، 3، w2)
    p := w2.اشاره گر برگردان طبیعی۸*
    check("tls hello record"، p[0] برابر (22 برگردان طبیعی۸) و p[1] برابر (3 برگردان طبیعی۸) و p[2] برابر (1 برگردان طبیعی۸) و p[5] برابر (1 برگردان طبیعی۸))
    check("tls hello length"، ((p[3] برگردان صحیح) * 256 + (p[4] برگردان صحیح)) برابر w2.طول - 5)
    check("tls hello carries sni"، شدوساکس.بافر به هگز(w2).دربردارد("63646e2e6578616d706c652e636f6d"))
    ناپایا w3 := شدوساکس.بافر جدید(256)
    شدوساکس.پوشاندن داده(c2، "abc" برگردان تهی*، 3، w3)
    q := w3.اشاره گر برگردان طبیعی۸*
    check("tls application record"، w3.طول برابر 8 و q[0] برابر (23 برگردان طبیعی۸) و q[1] برابر (3 برگردان طبیعی۸) و q[2] برابر (3 برگردان طبیعی۸) و q[4] برابر (3 برگردان طبیعی۸))
    ناپایا s2 := شدوساکس.آماده سازی پوشش(شدوساکس.پوشش تی ال اس، درست، "")
    ناپایا w4 := شدوساکس.بافر جدید(256)
    شدوساکس.پوشاندن داده(s2، "abc" برگردان تهی*، 3، w4)
    r := w4.اشاره گر برگردان طبیعی۸*
    check("tls server hello"، r[0] برابر (22 برگردان طبیعی۸) و r[5] برابر (2 برگردان طبیعی۸) و w4.طول برابر 5 + 91 + 6 + 5 + 3)
پایان

تابع obfs_garbage():
    ناپایا server := شدوساکس.آماده سازی پوشش(شدوساکس.پوشش تی ال اس، درست، "")
    ناپایا out := شدوساکس.بافر جدید(64)
    junk := "GET / HTTP/1.1\r\n\r\n"
    check("tls rejects non tls"، شدوساکس.برداشتن پوشش(server، junk برگردان تهی*، junk.طول()، out) کوچکتر 0)
    ناپایا hs := شدوساکس.آماده سازی پوشش(شدوساکس.پوشش اچ تی تی پی، درست، "")
    ناپایا out2 := شدوساکس.بافر جدید(64)
    partial := "GET / HTTP/1.1\r\nHost: x"
    check("http waits for end of header"، شدوساکس.برداشتن پوشش(hs، partial برگردان تهی*، partial.طول()، out2) برابر 1 و out2.طول برابر 0)
    check("obfs mode names"، شدوساکس.حالت پوشش("http") برابر شدوساکس.پوشش اچ تی تی پی و شدوساکس.حالت پوشش("tls") برابر شدوساکس.پوشش تی ال اس و شدوساکس.حالت پوشش("x") برابر شدوساکس.بدون پوشش)
پایان

تابع show_uri(name: رشته، u: شدوساکس.نشانی، method: رشته، password: رشته، host: رشته، port: صحیح، plugin: رشته، tag: رشته):
    check(name، u.معتبر و u.روش برابر method و u.گذرواژه برابر password و u.میزبان برابر host و u.درگاه برابر port و u.افزونه برابر plugin و u.برچسب برابر tag)
پایان

تابع uri_tests():
    show_uri("uri sip002"، شدوساکس.تجزیه نشانی("ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@example.com:8388#My%20Node")، "aes-256-gcm"، "password"، "example.com"، 8388، ""، "My Node")
    show_uri("uri ipv6 plugin"، شدوساکس.تجزیه نشانی("ss://Y2hhY2hhMjAtaWV0Zi1wb2x5MTMwNTpwYXNz@[2001:db8::1]:443/?plugin=obfs-local%3Bobfs%3Dhttp%3Bobfs-host%3Dexample.com#tag")، "chacha20-ietf-poly1305"، "pass"، "2001:db8::1"، 443، "obfs-local;obfs=http;obfs-host=example.com"، "tag")
    show_uri("uri legacy"، شدوساکس.تجزیه نشانی("ss://YWVzLTEyOC1nY206dGVzdEAxOTIuMTY4LjEuMTo4ODg4")، "aes-128-gcm"، "test"، "192.168.1.1"، 8888، ""، "")
    show_uri("uri 2022 plain"، شدوساکس.تجزیه نشانی("ss://2022-blake3-aes-128-gcm:AAECAwQFBgcICQoLDA0ODw%3D%3D@1.2.3.4:5000")، "2022-blake3-aes-128-gcm"، "AAECAwQFBgcICQoLDA0ODw=="، "1.2.3.4"، 5000، ""، "")
    check("uri wrong scheme"، وارونه شدوساکس.تجزیه نشانی("http://x").معتبر)
    check("uri unknown method"، وارونه شدوساکس.تجزیه نشانی("ss://cmM0LW1kNTpwdw@h.example:1").معتبر)
    check("uri no port"، وارونه شدوساکس.تجزیه نشانی("ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@example.com").معتبر)
    u := شدوساکس.تجزیه نشانی("ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@example.com:8388/?plugin=v2ray-plugin%3Bserver%3Btls%3Bhost%3Dcdn.example.com#My%20Node")
    f := شدوساکس.قالب بندی نشانی(u)
    check("uri format"، f برابر "ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@example.com:8388/?plugin=v2ray-plugin%3Bserver%3Btls%3Bhost%3Dcdn.example.com#My%20Node")
    again := شدوساکس.تجزیه نشانی(f)
    check("uri round trip"، again.معتبر و again.گذرواژه برابر u.گذرواژه و again.افزونه برابر u.افزونه و again.برچسب برابر u.برچسب)
    ناپایا v6 := شدوساکس.نشانی { روش = "aes-128-gcm"، گذرواژه = "p:w"، میزبان = "::1"، درگاه = 9 }
    v6.معتبر = درست
    v6r := شدوساکس.تجزیه نشانی(شدوساکس.قالب بندی نشانی(v6))
    check("uri ipv6 round trip"، v6r.معتبر و v6r.میزبان برابر "::1" و v6r.گذرواژه برابر "p:w" و v6r.درگاه برابر 9)
    ناپایا s22 := شدوساکس.نشانی { روش = "2022-blake3-aes-256-gcm"، گذرواژه = "a+b/c="، میزبان = "h.example"، درگاه = 1 }
    s22.معتبر = درست
    s22f := شدوساکس.قالب بندی نشانی(s22)
    check("uri 2022 format plain"، s22f.شروع با("ss://2022-blake3-aes-256-gcm:a%2Bb%2Fc%3D@h.example:1"))
    s22r := شدوساکس.تجزیه نشانی(s22f)
    check("uri 2022 round trip"، s22r.معتبر و s22r.گذرواژه برابر "a+b/c=")
    p := شدوساکس.تجزیه افزونه(u.افزونه)
    check("plugin name"، p.نام برابر "v2ray-plugin")
    check("plugin opts"، شدوساکس.گرفتن گزینه افزونه(p، "host"، "-") برابر "cdn.example.com" و شدوساکس.گزینه افزونه موجود است(p، "tls") و شدوساکس.گزینه افزونه موجود است(p، "server") و وارونه شدوساکس.گزینه افزونه موجود است(p، "mux"))
    check("plugin default"، شدوساکس.گرفتن گزینه افزونه(p، "path"، "/") برابر "/")
    شدوساکس.آزادسازی افزونه(p)
    esc := شدوساکس.تجزیه افزونه(`obfs-local;obfs-host=a\;b;obfs=tls`)
    check("plugin escapes"، شدوساکس.گرفتن گزینه افزونه(esc، "obfs-host"، "") برابر "a;b" و شدوساکس.گرفتن گزینه افزونه(esc، "obfs"، "") برابر "tls")
    شدوساکس.آزادسازی افزونه(esc)
    cfg := شدوساکس.تبدیل به پیکربندی(شدوساکس.تجزیه نشانی("ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@example.com:8388/?plugin=obfs-local%3Bobfs%3Dtls%3Bobfs-host%3Dwww.example.org"))
    check("config from uri"، cfg.پوشش برابر "tls" و cfg.میزبان پوشش برابر "www.example.org" و cfg.میزبان برابر "example.com" و cfg.درگاه برابر 8388 و cfg.روش برابر "aes-256-gcm")
    cfg2 := شدوساکس.تبدیل به پیکربندی(u)
    check("config ignores v2ray plugin"، cfg2.پوشش برابر "")
پایان

تابع ریشه:
    addr_tests()
    obfs_case("obfs http small"، شدوساکس.پوشش اچ تی تی پی، 40)
    obfs_case("obfs http large"، شدوساکس.پوشش اچ تی تی پی، 50000)
    obfs_case("obfs tls small"، شدوساکس.پوشش تی ال اس، 40)
    obfs_case("obfs tls large"، شدوساکس.پوشش تی ال اس، 50000)
    obfs_shape()
    obfs_garbage()
    uri_tests()
    سرچاپ "failures"، failures
    برگشت failures
پایان
