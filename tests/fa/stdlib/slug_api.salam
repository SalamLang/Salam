// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع تاکین(س: رشته): منطقی:
    برگشت س برابر "post" یا س برابر "post-2" یا س برابر "post-3" یا س برابر "post-5"
پایان

تابع ییس(س: رشته): منطقی:
    برگشت س.طول() بزرگتر 0
پایان

تابع ریشه:
    سرچاپ "transliterate"
    سرچاپ اسلاگ.نویسه گردانی("Привет, мир! Zürich 42"، "")
    سرچاپ اسلاگ.نویسه گردانی("Müller Größe Ärger"، "de")
    سرچاپ اسلاگ.نویسه گردانی("Müller Größe Ärger"، "")
    سرچاپ اسلاگ.نویسه گردانی("سلام، دنیا؟ «خوب» ۱۲۳"، "fa")
    سرچاپ اسلاگ.نویسه گردانی("مرحبا بكم في العالم"، "ar")
    سرچاپ اسلاگ.نویسه گردانی("ПРИВЕТ Щука"، "ru")
    سرچاپ اسلاگ.نویسه گردانی("ΕΛΛΑΔΑ Ελλάδα"، "el")
    سرچاپ اسلاگ.نویسه گردانی("Hello, World! (ok) 100%"، "en")
    سرچاپ اسلاگ.نویسه گردانی("日本 語 こんにちは 😀 end"، "ja")
    سرچاپ اسلاگ.نویسه گردانی(""، "")

    سرچاپ "scripts"
    سرچاپ اسلاگ.تشخیص خط("hello")
    سرچاپ اسلاگ.تشخیص خط("Привет")
    سرچاپ اسلاگ.تشخیص خط("Καλημέρα")
    سرچاپ اسلاگ.تشخیص خط("سلام")
    سرچاپ اسلاگ.تشخیص خط("שלום")
    سرچاپ اسلاگ.تشخیص خط("नमस्ते")
    سرچاپ اسلاگ.تشخیص خط("สวัสดี")
    سرچاپ اسلاگ.تشخیص خط("こんにちは")
    سرچاپ اسلاگ.تشخیص خط("カタカナ 日本語")
    سرچاپ اسلاگ.تشخیص خط("안녕하세요")
    سرچاپ اسلاگ.تشخیص خط("你好世界")
    سرچاپ اسلاگ.تشخیص خط("12345 !!!")
    سرچاپ اسلاگ.تشخیص خط("")
    سرچاپ اسلاگ.تشخیص خط("abc defgh ф")
    سرچاپ اسلاگ.تشخیص خط("a я я")

    سرچاپ "numbered and unique"
    سرچاپ اسلاگ.شماره دار("post"، 1، "-")
    سرچاپ اسلاگ.شماره دار("post"، 2، "-")
    سرچاپ اسلاگ.شماره دار("post"، 12، "_")
    سرچاپ اسلاگ.یکتا("fresh"، (س: رشته): برگشت تاکین(س) پایان)
    سرچاپ اسلاگ.یکتا("post"، (س: رشته): برگشت تاکین(س) پایان)
    سرچاپ اسلاگ.یکتا با جداکننده("post"، "_"، (س: رشته): برگشت تاکین(س) پایان)
    سرچاپ اسلاگ.یکتا با جداکننده("other"، "_"، (س: رشته): برگشت ییس(س) پایان)

    سرچاپ "validation"
    سرچاپ اسلاگ.اسلاگ است("hello-world")
    سرچاپ اسلاگ.اسلاگ است("hello")
    سرچاپ اسلاگ.اسلاگ است("a1-b2-c3")
    سرچاپ اسلاگ.اسلاگ است("")
    سرچاپ اسلاگ.اسلاگ است("-hello")
    سرچاپ اسلاگ.اسلاگ است("hello-")
    سرچاپ اسلاگ.اسلاگ است("hello--world")
    سرچاپ اسلاگ.اسلاگ است("Hello-World")
    سرچاپ اسلاگ.اسلاگ است("hello_world")
    سرچاپ اسلاگ.اسلاگ است("hello world")
    سرچاپ اسلاگ.اسلاگ است("héllo")
    سرچاپ اسلاگ.اسلاگ است(اسلاگ.ساخت("Any Title, here! ☺"))

    ناپایا وپت := اسلاگ.گزینه ها {}

    وپت = اسلاگ.اسنیک()
    سرچاپ اسلاگ.اسلاگ است با گزینه("hello_world"، وپت)
    سرچاپ اسلاگ.اسلاگ است با گزینه("hello-world"، وپت)
    وپت = اسلاگ.یونیکد()
    سرچاپ اسلاگ.اسلاگ است با گزینه("سلام-دنیا"، وپت)
    سرچاپ اسلاگ.اسلاگ است با گزینه("Привет-мир"، وپت)
    سرچاپ اسلاگ.اسلاگ است با گزینه("привет-мир"، وپت)
    سرچاپ اسلاگ.اسلاگ است با گزینه("hello!"، وپت)
    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.بیشینه طول = 5
    سرچاپ اسلاگ.اسلاگ است با گزینه("hello"، وپت)
    سرچاپ اسلاگ.اسلاگ است با گزینه("hello-w"، وپت)
    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.حروف کوچک = نادرست
    سرچاپ اسلاگ.اسلاگ است با گزینه("Hello-World"، وپت)
    وپت.یکی کردن جداکننده ها = نادرست
    سرچاپ اسلاگ.اسلاگ است با گزینه("a--b"، وپت)
    وپت.پیرایش = نادرست
    سرچاپ اسلاگ.اسلاگ است با گزینه("-a-"، وپت)
    وپت = اسلاگ.نام پرونده()
    سرچاپ اسلاگ.اسلاگ است با گزینه("Report_v1.2.pdf"، وپت)
    وپت = اسلاگ.شناسه()
    سرچاپ اسلاگ.اسلاگ است با گزینه("9lives"، وپت)
    سرچاپ اسلاگ.اسلاگ است با گزینه("snake_case_1"، وپت)

    سرچاپ "presets"
    متن := "My Report: Q3 2026 (final).PDF"
    سرچاپ اسلاگ.ساخت(متن)
    سرچاپ اسلاگ.ساخت با گزینه(متن، اسلاگ.آدرس وب())
    سرچاپ اسلاگ.ساخت با گزینه(متن، اسلاگ.نام پرونده())
    سرچاپ اسلاگ.ساخت با گزینه(متن، اسلاگ.اسنیک())
    سرچاپ اسلاگ.ساخت با گزینه(متن، اسلاگ.شناسه())
    سرچاپ اسلاگ.ساخت با گزینه("9 lives of a cat"، اسلاگ.شناسه())
    سرچاپ اسلاگ.ساخت با گزینه("%%%"، اسلاگ.شناسه())
    سرچاپ اسلاگ.ساخت با گزینه("../etc/passwd"، اسلاگ.نام پرونده())
    سرچاپ اسلاگ.ساخت با گزینه(".."، اسلاگ.نام پرونده())
    سرچاپ اسلاگ.ساخت با گزینه("Привет мир"، اسلاگ.یونیکد())

    سرچاپ "language hint"
    ناپایا لوپت := اسلاگ.گزینه ها {}
    لوپت = اسلاگ.گزینه های پیش فرض()
    لوپت.زبان متن = "bg"
    سرچاپ اسلاگ.ساخت با گزینه("България Щастие Дъжд"، لوپت)
    لوپت.زبان متن = "ru"
    سرچاپ اسلاگ.ساخت با گزینه("България Щастие Дъжд"، لوپت)
    لوپت.زبان متن = "uk"
    سرچاپ اسلاگ.ساخت با گزینه("Їжак Київ Юля Яблуко"، لوپت)
    لوپت.زبان متن = "pt-BR"
    سرچاپ اسلاگ.ساخت با گزینه("Ação e coração & mais"، لوپت)
    لوپت.زبان متن = "NB"
    سرچاپ اسلاگ.ساخت با گزینه("Åse og Øystein"، لوپت)
پایان
