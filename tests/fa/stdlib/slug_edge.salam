// زبان: فارسی
واردسازی کدگذاری.اسلاگ
واردسازی رشته

تابع نمایش(لابیل: رشته، س: رشته):
    سرچاپ لابیل + ":"، "[" + س + "]"
پایان

تابع ریشه:
    نمایش("empty"، اسلاگ.ساخت(""))
    نمایش("spaces"، اسلاگ.ساخت("     "))
    نمایش("symbols"، اسلاگ.ساخت("!@#$%^&*()_+-=[]{};':,./<>?"))
    نمایش("emoji only"، اسلاگ.ساخت("😀🎉❤️🚀"))
    نمایش("emoji mixed"، اسلاگ.ساخت("Launch 🚀 day 🎉 2026"))
    نمایش("apostrophes"، اسلاگ.ساخت("Don't Stop, it's Alice's \"Wonderland\" l’été"))
    نمایش("tabs and newlines"، اسلاگ.ساخت("one\ttwo\nthree\r\nfour"))
    نمایش("digits"، اسلاگ.ساخت("Route 66 -- 3.14 -- 1,000"))
    نمایش("combining"، اسلاگ.ساخت("Café naïve resumé"))
    نمایش("zero width"، اسلاگ.ساخت("zero​width‍join⁠er bom﻿mark"))
    نمایش("direction marks"، اسلاگ.ساخت("\u200fمرحبا\u200e hello \u202bworld\u202c"))
    نمایش("nbsp"، اسلاگ.ساخت("a b c　d"))
    نمایش("invalid utf8"، اسلاگ.ساخت("ok\xff\xfe bad\xc3 text \xe2\x82 end"))
    نمایش("mixed scripts"، اسلاگ.ساخت("Hello Привет مرحبا Γειά 你好 こんにちは"))
    نمایش("persian in english"، اسلاگ.ساخت("Salam سلام World"))
    نمایش("digits in scripts"، اسلاگ.ساخت("٣ ٤ ۵ ६ ๗ ３"))
    نمایش("superscripts"، اسلاگ.ساخت("x² y³ H₂O"))
    نمایش("ligatures"، اسلاگ.ساخت("ﬁnal ﬂow ﬃ"))
    نمایش("currency"، اسلاگ.ساخت("€5 £3 ¥100 ₹50 ₽20 ₺7"))

    لونگ := رشته.تکرار("lorem ipsum dolor sit amet "، 20000)
    ر := اسلاگ.ساخت(لونگ)
    سرچاپ "long input length"، لونگ.طول()، "slug length"، ر.طول()
    سرچاپ "long starts"، رشته.زیررشته(ر، 0، 40)

    ناپایا وپت := اسلاگ.گزینه ها {}

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.بیشینه طول = 60
    ر2 := اسلاگ.ساخت با گزینه(لونگ، وپت)
    سرچاپ "long cut"، ر2.طول()، "[" + ر2 + "]"

    وورد := رشته.تکرار("abcdefghij"، 5000)
    ر3 := اسلاگ.ساخت با گزینه(وورد، وپت)
    سرچاپ "one huge word"، ر3.طول()
    سرچاپ "one huge word full"، اسلاگ.ساخت(وورد).طول()

    ونی := رشته.تکرار("سلام "، 3000)
    ناپایا ووپت := اسلاگ.گزینه ها {}
    ووپت = اسلاگ.یونیکد()
    ووپت.بیشینه طول = 11
    نمایش("unicode cut by characters"، اسلاگ.ساخت با گزینه(ونی، ووپت))
    نمایش("unicode cut inside word"، اسلاگ.ساخت با گزینه("برنامه‌نویسی"، ووپت))
    ووپت.بیشینه طول = 4
    نمایش("unicode hard cut"، اسلاگ.ساخت با گزینه("برنامهنویسی"، ووپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.بیشینه طول = 10
    نمایش("exact fit"، اسلاگ.ساخت با گزینه("abcde fghij klm"، وپت))
    نمایش("exact fit plus"، اسلاگ.ساخت با گزینه("abcd fghij klm"، وپت))
    وپت.بیشینه طول = 5
    نمایش("first word too long"، اسلاگ.ساخت با گزینه("extraordinary thing"، وپت))
    وپت.بیشینه طول = 1
    نمایش("one char"، اسلاگ.ساخت با گزینه("zed alpha"، وپت))
پایان
