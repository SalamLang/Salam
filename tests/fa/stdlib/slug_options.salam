// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع نمایش(لابیل: رشته، س: رشته):
    سرچاپ لابیل + ":"، "[" + س + "]"
پایان

تابع ریشه:
    متن := "  The Quick, Brown Fox -- jumps over the lazy dog!  "
    نمایش("default"، اسلاگ.ساخت(متن))

    ناپایا وپت := اسلاگ.گزینه ها {}

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.جداکننده = "_"
    نمایش("underscore"، اسلاگ.ساخت با گزینه(متن، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.جداکننده = ""
    نمایش("no separator"، اسلاگ.ساخت با گزینه("a b c"، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.جداکننده = "--"
    نمایش("long separator"، اسلاگ.ساخت با گزینه("one two three"، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.حروف کوچک = نادرست
    نمایش("keep case"، اسلاگ.ساخت با گزینه("Hello World FooBar"، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.بیشینه طول = 20
    نمایش("max 20"، اسلاگ.ساخت با گزینه(متن، وپت))
    وپت.بیشینه طول = 9
    نمایش("max 9"، اسلاگ.ساخت با گزینه(متن، وپت))
    وپت.بیشینه طول = 3
    نمایش("max 3 cuts a word"، اسلاگ.ساخت با گزینه(متن، وپت))
    وپت.بیشینه طول = 1000
    نمایش("max large"، اسلاگ.ساخت با گزینه(متن، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.پیرایش = نادرست
    نمایش("no trim"، اسلاگ.ساخت با گزینه("--hello world--"، وپت))
    وپت.یکی کردن جداکننده ها = نادرست
    نمایش("no collapse"، اسلاگ.ساخت با گزینه("a  b -- c"، وپت))
    وپت.پیرایش = درست
    نمایش("trim only"، اسلاگ.ساخت با گزینه("--a  b--"، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.نویسه های مجاز = "._"
    نمایش("allow"، اسلاگ.ساخت با گزینه("my file_name v1.2.txt"، وپت))
    وپت.نویسه های مجاز = "."
    نمایش("allow trims ends"، اسلاگ.ساخت با گزینه("...hidden.file..."، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    اسلاگ.افزودن کلمه های توقف(وپت، "the a an of, over")
    نمایش("stop words"، اسلاگ.ساخت با گزینه(متن، وپت))
    نمایش("only stop words"، اسلاگ.ساخت با گزینه("The of A"، وپت))
    نمایش("stop case"، اسلاگ.ساخت با گزینه("An APPLE of Gold"، وپت))
    اسلاگ.آزادسازی گزینه ها(وپت)

    وپت = اسلاگ.گزینه های پیش فرض()
    اسلاگ.افزودن جایگزین(وپت، "C++"، "cpp")
    اسلاگ.افزودن جایگزین(وپت، "C#"، "csharp")
    اسلاگ.افزودن جایگزین(وپت، ".NET"، "dotnet")
    نمایش("replace"، اسلاگ.ساخت با گزینه("C++ vs C# vs .NET"، وپت))
    اسلاگ.آزادسازی گزینه ها(وپت)

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.نمادها = نادرست
    نمایش("symbols off"، اسلاگ.ساخت با گزینه("Tom & Jerry 50% @ home"، وپت))
    وپت.نمادها = درست
    نمایش("symbols on"، اسلاگ.ساخت با گزینه("Tom & Jerry 50% @ home + you"، وپت))
    وپت.زبان متن = "de"
    نمایش("german words"، اسلاگ.ساخت با گزینه("Tom & Jerry 50% Müller"، وپت))
    وپت.زبان متن = "fa"
    نمایش("persian words"، اسلاگ.ساخت با گزینه("Tom & Jerry 50%"، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.جایگزین خالی = "untitled"
    نمایش("fallback"، اسلاگ.ساخت با گزینه("!!! ???"، وپت))
    نمایش("fallback empty"، اسلاگ.ساخت با گزینه(""، وپت))

    وپت = اسلاگ.یونیکد()
    نمایش("unicode fa"، اسلاگ.ساخت با گزینه("سلام دنیا، ۱۲۳ ك ي"، وپت))
    نمایش("unicode ru"، اسلاگ.ساخت با گزینه("Привет Мир!"، وپت))
    نمایش("unicode latin"، اسلاگ.ساخت با گزینه("Crème Brûlée Ñandú"، وپت))
    نمایش("unicode han"، اسلاگ.ساخت با گزینه("你好 世界"، وپت))
    وپت.حروف کوچک = نادرست
    نمایش("unicode keep case"، اسلاگ.ساخت با گزینه("Привет Мир"، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.نگه داشتن هان = نادرست
    نمایش("han dropped"، اسلاگ.ساخت با گزینه("abc 你好 def"، وپت))

    وپت = اسلاگ.گزینه های پیش فرض()
    وپت.زبان متن = "de"
    نمایش("lang de"، اسلاگ.ساخت با گزینه("Über Straße Köln Märchen"، وپت))
    وپت.زبان متن = "da"
    نمایش("lang da"، اسلاگ.ساخت با گزینه("Århus Ærø Øl"، وپت))
    وپت.زبان متن = "sv"
    نمایش("lang sv"، اسلاگ.ساخت با گزینه("Åre Malmö Göteborg"، وپت))
    وپت.زبان متن = "ar"
    نمایش("lang ar"، اسلاگ.ساخت با گزینه("قطر ثلاثة"، وپت))
    وپت.زبان متن = "fa"
    نمایش("lang fa"، اسلاگ.ساخت با گزینه("قطر ثلاثة"، وپت))
پایان
