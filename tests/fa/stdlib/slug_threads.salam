// زبان: فارسی
واردسازی کدگذاری.اسلاگ
واردسازی همگام سازی

ناپایا لوکک := همگام سازی.قفل جدید()
ناپایا میسماتکهیس := 0
ناپایا فینیسهید := 0

تابع وورکیر():
    تیکستس := [
        "Hello, World! Ünïcödé"، "سلام دنیا، خوب است"، "Привет, мир! Щука"، "Ελληνικά Καλημέρα"،
        "こんにちは ラーメン 안녕하세요"
    ]
    وانت := [
        "hello-world-unicode"، "slam-dnya-khub-ast"، "privet-mir-shchuka"، "ellinika-kalimera"،
        "konnichiha-ramen-annyeonghaseyo"
    ]
    ناپایا باد := 0
    تکرار 300 در رووند:
        تکرار 5 در ک:
            گوت := اسلاگ.ساخت(تیکستس[ک])
            اگر گوت نابرابر وانت[ک]:
                باد++
            پایان
        پایان
        اگر رووند % 100 برابر 0:
            اگر اسلاگ.ساخت با گزینه("A B C"، اسلاگ.آدرس وب()) نابرابر "a-b-c":
                باد++
            پایان
        پایان
    پایان
    همگام سازی.قفل کردن(لوکک)
    میسماتکهیس += باد
    فینیسهید++
    همگام سازی.باز کردن قفل(لوکک)
پایان

تابع ریشه:
    ت1 := نخ‌ساز(وورکیر)
    ت2 := نخ‌ساز(وورکیر)
    ت3 := نخ‌ساز(وورکیر)
    ت4 := نخ‌ساز(وورکیر)
    ت5 := نخ‌ساز(وورکیر)
    ت6 := نخ‌ساز(وورکیر)
    نخ‌پیوند(ت1)
    نخ‌پیوند(ت2)
    نخ‌پیوند(ت3)
    نخ‌پیوند(ت4)
    نخ‌پیوند(ت5)
    نخ‌پیوند(ت6)
    سرچاپ "workers finished"، فینیسهید
    سرچاپ "mismatches"، میسماتکهیس
    همگام سازی.نابودسازی(لوکک)
پایان
