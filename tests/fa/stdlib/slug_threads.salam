// زبان: فارسی
واردسازی کدگذاری.اسلاگ
واردسازی اتمی

ناپایا باد := اتمی.پرچم جدید(نادرست)
ناپایا دونی := اتمی.صحیح۶۴ جدید(0 برگردان صحیح۶۴)

تابع وورکیر():
    تیکستس := ["Hello, World! Ünïcödé"، "سلام دنیا، خوب است"، "Привет, мир! Щука"، "Ελληνικά Καλημέρα"، "こんにちは ラーメン 안녕하세요"]
    وانت := ["hello-world-unicode"، "slam-dnya-khub-ast"، "privet-mir-shchuka"، "ellinika-kalimera"، "konnichiha-ramen-annyeonghaseyo"]
    تکرار 300 در رووند:
        تکرار 5 در ک:
            گوت := اسلاگ.ساخت(تیکستس[ک])
            اگر گوت نابرابر وانت[ک]:
                اتمی.تنظیم(باد، درست)
            پایان
        پایان
        اگر رووند % 100 برابر 0:
            وپت := اسلاگ.آدرس وب()
            اگر اسلاگ.ساخت با گزینه("A B C"، وپت) نابرابر "a-b-c":
                اتمی.تنظیم(باد، درست)
            پایان
        پایان
    پایان
    شمار := اتمی.افزودن(دونی، 1 برگردان صحیح۶۴)
    اگر شمار بزرگتر 6:
        اتمی.تنظیم(باد، درست)
    پایان
پایان

تابع ریشه:
    ت1 := نخ‌ساز(وورکیر)
    ت2 := نخ‌ساز(وورکیر)
    ت3 := نخ‌ساز(وورکیر)
    ت4 := نخ‌ساز(وورکیر)
    ت5 := نخ‌ساز(وورکیر)
    ت6 := نخ‌ساز(وورکیر)
    نخ‌پیوند(ت1)
    نخ‌پیوند(ت2)
    نخ‌پیوند(ت3)
    نخ‌پیوند(ت4)
    نخ‌پیوند(ت5)
    نخ‌پیوند(ت6)
    سرچاپ "workers finished"، اتمی.بارگذاری(دونی)
    سرچاپ "mismatch found"، اتمی.گرفتن(باد)
پایان
