واردسازی حافظه
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی شبکه.یو دی پی
واردسازی رشته

ساختار FakeResolver:
    همگانی unused: صحیح = 0

    همگانی تابع Lookup(host: رشته): تونل.نتیجه جستجو:
        ناپایا r := تونل.نتیجه جستجو {}
        اگر host برابر "six.internal":
            r.آی‌پی‌ها.بیفزا("::1")
        وگرنه host برابر "mixed.internal":
            r.آی‌پی‌ها.بیفزا("2001:db8::dead")
            r.آی‌پی‌ها.بیفزا("::1")
        پایان
        برگشت r
    پایان
پایان

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        تی سی پی.نوشتن(c، d)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع udp_echo(arg: صحیح۶۴):
    s := یو دی پی.سوکت یو دی پی { توصیفگر = arg }
    buf := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    تا درست:
        ناپایا h := ""
        ناپایا p := 0
        n := یو دی پی.دریافت بایت(s، buf، 2048، h، p)
        اگر n کوچکتر 0: بشکن پایان
        یو دی پی.ارسال بایت(s، h، p، buf، n)
    پایان
پایان

تابع connect_via_resolver(h: رشته، p: صحیح): ساکس.خروجی:
    d := تونل.شماره‌گیر مستقیم { حل‌کننده = FakeResolver {}، حل‌کننده دارد = درست، مهلت اتصال = 3000 }
    s := d.اتصال(تونل.نشانی جدید(h، p))
    اگر وارونه s.معتبر(): برگشت ساکس.خروجی { موفق = نادرست، کد = ساکس.کد میزبان در دسترس نیست، خطا = "no route" } پایان
    برگشت ساکس.خروجی { موفق = درست، کد = ساکس.کد موفق، جریان = s }
پایان

تابع say(label: رشته، r: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد
پایان

تابع roundtrip(r: ساکس.نتیجه اتصال، msg: رشته): رشته:
    اگر وارونه r.موفق: برگشت "no stream" پایان
    r.جریان.نوشتن(msg)
    got := r.جریان.خواندن(4096)
    r.جریان.بستن()
    برگشت got
پایان

تابع udp_probe(u: ساکس.نشست یو دی پی، host: رشته، port: صحیح، msg: رشته): رشته:
    ساکس.تنظیم مهلت یو دی پی(u، 2000)
    ساکس.ارسال یو دی پی(u، host، port، msg)
    buf := حافظه.تخصیص(1024 برگردان طبیعی۶۴)
    ناپایا from := ساکس.نشانی {}
    n := ساکس.دریافت بایت یو دی پی(u، buf، 1024، from)
    اگر n کوچکتر 0:
        حافظه.آزادسازی(buf)
        برگشت "timeout"
    پایان
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    out := رشته.رونوشت(buf برگردان رشته) + " from " + from.میزبان + " kind " + from.نوع
    حافظه.آزادسازی(buf)
    برگشت out
پایان

تابع ریشه:
    probe := تی سی پی.پیوند روی("::1"، 0)
    اگر وارونه تی سی پی.معتبر(probe):
        سرچاپ "ipv6 unavailable"
        برگشت
    پایان
    تی سی پی.بستن سرور(probe)

    es := تی سی پی.پیوند روی("::1"، 0)
    ساکس.برو(echo_accept، es.توصیفگر برگردان تهی*)
    eport := تی سی پی.درگاه(es)
    us := یو دی پی.پیوند روی("::1"، 0)
    ساکس.برو(udp_echo، us.توصیفگر برگردان تهی*)
    uport := یو دی پی.درگاه(us)

    cfg4 := ساکس.پیکربندی سرور جدید(0)
    sv4 := ساکس.شروع(cfg4)
    سرچاپ "v4 server up"، sv4.موفق، sv4.میزبان
    cl4 := ساکس.کلاینت جدید("127.0.0.1"، sv4.درگاه)
    say("v4 control, v6 literal target"، ساکس.اتصال(cl4، "::1"، eport))
    سرچاپ roundtrip(ساکس.اتصال(cl4، "::1"، eport)، "hello six")
    سرچاپ roundtrip(ساکس.اتصال(cl4، "[::1]"، eport)، "hello bracketed")
    say("v4 control, refused v6 target"، ساکس.اتصال(cl4، "::1"، تی سی پی.درگاه آزاد()))

    u4 := ساکس.ایجاد نشست یو دی پی(cl4)
    سرچاپ "v4 control udp associate"، u4.موفق، u4.میزبان رله
    سرچاپ udp_probe(u4، "::1"، uport، "udp to v6 target")
    ساکس.بستن نشست یو دی پی(u4)

    ناپایا cfg6 := ساکس.پیکربندی سرور جدید(0)
    cfg6.میزبان پیوند = "::1"
    cfg6.اجازه پیوند = درست
    sv6 := ساکس.شروع(cfg6)
    سرچاپ "v6 server up"، sv6.موفق، sv6.میزبان
    cl6 := ساکس.کلاینت جدید("::1"، sv6.درگاه)
    سرچاپ roundtrip(ساکس.اتصال(cl6، "::1"، eport)، "via v6 proxy")
    سرچاپ roundtrip(ساکس.اتصال(cl6، "[::1]"، eport)، "via v6 proxy bracketed")
    c6 := ساکس.شماره‌گیری اتصال(cl6، "::1"، eport)
    تی سی پی.نوشتن(c6، "plain conn")
    سرچاپ تی سی پی.خواندن(c6، 100)
    تی سی پی.بستن(c6)

    u6 := ساکس.ایجاد نشست یو دی پی(cl6)
    سرچاپ "v6 control udp associate"، u6.موفق، u6.میزبان رله
    سرچاپ udp_probe(u6، "::1"، uport، "udp over v6 relay")
    ساکس.بستن نشست یو دی پی(u6)

    br := ساکس.پیوند درخواست(cl6، "::1"، 0)
    سرچاپ "bind first reply"، br.موفق، br.نشانی محلی.میزبان، br.نشانی محلی.نوع برابر ساکس.نوع آی‌پی۶
    peer := تی سی پی.شماره گیری(br.نشانی محلی.میزبان، br.نشانی محلی.درگاه)
    acc := ساکس.پذیرش پیوند(br.جریان، cl6)
    سرچاپ "bind accepted"، acc.موفق، acc.نشانی محلی.میزبان، acc.نشانی محلی.نوع برابر ساکس.نوع آی‌پی۶
    تی سی پی.نوشتن(peer، "from the inbound v6 peer")
    سرچاپ br.جریان.خواندن(100)
    br.جریان.نوشتن("reply to v6 peer")
    سرچاپ تی سی پی.خواندن(peer، 100)
    تی سی پی.بستن(peer)
    br.جریان.بستن()

    ناپایا cfgd := ساکس.پیکربندی سرور جدید(0)
    cfgd.میزبان پیوند = "::"
    cfgd.اجازه پیوند = درست
    svd := ساکس.شروع(cfgd)
    سرچاپ "dual server up"، svd.موفق، svd.میزبان
    cld4 := ساکس.کلاینت جدید("127.0.0.1"، svd.درگاه)
    cld6 := ساکس.کلاینت جدید("::1"، svd.درگاه)
    سرچاپ roundtrip(ساکس.اتصال(cld4، "::1"، eport)، "dual via v4")
    سرچاپ roundtrip(ساکس.اتصال(cld6، "::1"، eport)، "dual via v6")
    ud := ساکس.ایجاد نشست یو دی پی(cld6)
    سرچاپ "dual udp associate"، ud.موفق
    سرچاپ udp_probe(ud، "::1"، uport، "udp over dual relay")
    ساکس.بستن نشست یو دی پی(ud)
    ساکس.توقف(svd)

    ناپایا cfgr := ساکس.پیکربندی سرور جدید(0)
    ساکس.تعیین اتصال به مقصد(cfgr، (h: رشته، p: صحیح): برگشت connect_via_resolver(h، p) پایان)
    svr := ساکس.شروع(cfgr)
    clr := ساکس.کلاینت جدید("127.0.0.1"، svr.درگاه)
    سرچاپ roundtrip(ساکس.اتصال(clr، "six.internal"، eport)، "AAAA only name")
    سرچاپ roundtrip(ساکس.اتصال(clr، "mixed.internal"، eport)، "dead first address, live second")
    say("unknown name"، ساکس.اتصال(clr، "none.internal"، eport))
    ساکس.توقف(svr)

    ساکس.توقف(sv4)
    ساکس.توقف(sv6)
پایان
