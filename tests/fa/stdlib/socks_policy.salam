واردسازی حافظه
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.یو دی پی
واردسازی شبکه.تونل

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        تی سی پی.نوشتن(c، d)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع udp_echo(arg: صحیح۶۴):
    s := یو دی پی.سوکت یو دی پی { توصیفگر = arg }
    buf := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    تا درست:
        ناپایا h := ""
        ناپایا p := 0
        n := یو دی پی.دریافت بایت(s، buf، 2048، h، p)
        اگر n کوچکتر 0: بشکن پایان
        یو دی پی.ارسال بایت(s، h، p، buf، n)
    پایان
پایان

تابع attempt(label: رشته، cl: ساکس.کلاینت، host: رشته، port: صحیح):
    r := ساکس.اتصال(cl، host، port)
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد
    اگر r.موفق:
        r.جریان.نوشتن("ping")
        سرچاپ "  reply: " + r.جریان.خواندن(100)
        r.جریان.بستن()
    پایان
پایان

تابع udp_try(label: رشته، cl: ساکس.کلاینت، port: صحیح):
    u := ساکس.ایجاد نشست یو دی پی(cl)
    اگر وارونه u.موفق:
        سرچاپ label + ": associate failed"
        برگشت
    پایان
    ساکس.تنظیم مهلت یو دی پی(u، 700)
    ساکس.ارسال یو دی پی(u، "127.0.0.1"، port، "dgram")
    buf := حافظه.تخصیص(1024 برگردان طبیعی۶۴)
    ناپایا from := ساکس.نشانی {}
    n := ساکس.دریافت بایت یو دی پی(u، buf، 1024، from)
    حافظه.آزادسازی(buf)
    سرچاپ label + ": reply bytes=" + n
    ساکس.بستن نشست یو دی پی(u)
پایان

تابع ریشه:
    esock := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، esock.توصیفگر برگردان تهی*)
    eport := تی سی پی.درگاه(esock)
    usock := یو دی پی.پیوند(0)
    uport := یو دی پی.درگاه(usock)
    ساکس.برو(udp_echo، usock.توصیفگر برگردان تهی*)

    dsv := ساکس.شروع(ساکس.پیکربندی سرور جدید(0))
    dcl := ساکس.کلاینت جدید("127.0.0.1"، dsv.درگاه)
    attempt("default, loopback address"، dcl، "127.0.0.1"، eport)
    attempt("default, loopback name"، dcl، "localhost"، eport)
    attempt("default, loopback ipv6"، dcl، "::1"، eport)
    attempt("default, mapped loopback"، dcl، "::ffff:127.0.0.1"، eport)
    attempt("default, private address"، dcl، "10.20.30.40"، 80)
    attempt("default, link local metadata address"، dcl، "169.254.169.254"، 80)
    attempt("default, carrier grade nat"، dcl، "100.64.1.1"، 80)
    attempt("default, unique local ipv6"، dcl، "fd00::1"، 80)
    attempt("default, any address"، dcl، "0.0.0.0"، 80)
    attempt("default, broadcast"، dcl، "255.255.255.255"، 80)
    udp_try("default, udp to loopback"، dcl، uport)
    ساکس.توقف(dsv)

    ناپایا apcfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(apcfg، درست)
    asv := ساکس.شروع(apcfg)
    acl_c := ساکس.کلاینت جدید("127.0.0.1"، asv.درگاه)
    attempt("allow_private on loopback, address"، acl_c، "127.0.0.1"، eport)
    attempt("allow_private on loopback, name"، acl_c، "localhost"، eport)
    udp_try("allow_private on loopback, udp"، acl_c، uport)
    ساکس.توقف(asv)

    ناپایا widecfg := ساکس.پیکربندی سرور جدید(0)
    widecfg.میزبان پیوند = "0.0.0.0"
    ساکس.اجازه آدرس‌های خصوصی(widecfg، درست)
    wsv := ساکس.شروع(widecfg)
    wcl := ساکس.کلاینت جدید("127.0.0.1"، wsv.درگاه)
    attempt("allow_private on a public bind is ignored"، wcl، "127.0.0.1"، eport)
    ساکس.توقف(wsv)

    ناپایا aclcfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(aclcfg، درست)
    تونل.افزودن بازه ممنوع(aclcfg.سیاست مقصد، "127.0.0.1/32")
    تونل.افزودن پسوند ممنوع(aclcfg.سیاست مقصد، "blocked.example")
    ssv := ساکس.شروع(aclcfg)
    scl := ساکس.کلاینت جدید("127.0.0.1"، ssv.درگاه)
    attempt("deny cidr beats allow_private"، scl، "127.0.0.1"، eport)
    attempt("deny domain suffix"، scl، "www.blocked.example"، 80)
    ساکس.توقف(ssv)

    ناپایا onlycfg := ساکس.پیکربندی سرور جدید(0)
    تونل.افزودن بازه مجاز(onlycfg.سیاست مقصد، "127.0.0.0/8")
    osv := ساکس.شروع(onlycfg)
    ocl := ساکس.کلاینت جدید("127.0.0.1"، osv.درگاه)
    attempt("allow cidr without allow_private"، ocl، "127.0.0.1"، eport)
    attempt("allow cidr leaves other private ranges closed"، ocl، "10.1.1.1"، 80)
    ساکس.توقف(osv)

    vsv := ساکس.شروع(ساکس.پیکربندی سرور جدید(0))
    ناپایا cl4 := ساکس.کلاینت جدید("127.0.0.1"، vsv.درگاه)
    cl4.نسخه = ساکس.ساکس۴
    سرچاپ "socks4 default: " + ساکس.اتصال(cl4، "127.0.0.1"، eport).موفق
    ساکس.توقف(vsv)
پایان
