واردسازی حافظه
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.یو دی پی
واردسازی رشته
واردسازی همگام سازی

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        تی سی پی.نوشتن(c، d)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع udp_echo(arg: صحیح۶۴):
    s := یو دی پی.سوکت یو دی پی { توصیفگر = arg }
    buf := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    تا درست:
        ناپایا h := ""
        ناپایا p := 0
        n := یو دی پی.دریافت بایت(s، buf، 2048، h، p)
        اگر n کوچکتر 0: بشکن پایان
        یو دی پی.ارسال بایت(s، h، p، buf، n)
    پایان
پایان

تابع start_echo(): صحیح:
    es := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، es.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(es)
پایان

تابع raw_send(c: تی سی پی.اتصال شبکه، bytes: وکتور<طبیعی۸>):
    n := bytes.طول()
    buf := حافظه.تخصیص(n برگردان طبیعی۶۴)
    p := buf برگردان طبیعی۸*
    تکرار n در i:
        p[i] = bytes.بگیر(i)
    پایان
    تی سی پی.نوشتن بایت(c، buf، n)
    حافظه.آزادسازی(buf)
پایان

تابع raw_read(c: تی سی پی.اتصال شبکه، max: صحیح): رشته:
    buf := حافظه.تخصیص(max برگردان طبیعی۶۴)
    n := تی سی پی.خواندن بایت(c، buf، max)
    ناپایا v := وکتور {} برگردان وکتور<طبیعی۸>
    p := buf برگردان طبیعی۸*
    اگر n بزرگتر 0:
        تکرار n در i:
            v.بیفزا(p[i])
        پایان
    پایان
    out := ساکس.به هگز(v)
    v.آزادکن()
    حافظه.آزادسازی(buf)
    برگشت out
پایان

تابع vec(items: صحیح[]): وکتور<طبیعی۸>:
    ناپایا v := وکتور {} برگردان وکتور<طبیعی۸>
    هر x در items:
        v.بیفزا(x برگردان طبیعی۸)
    پایان
    برگشت v
پایان

تابع say(label: رشته، r: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد + " " + r.خطا
پایان

تابع roundtrip(r: ساکس.نتیجه اتصال، msg: رشته): رشته:
    اگر وارونه r.موفق: برگشت "no stream" پایان
    r.جریان.نوشتن(msg)
    got := r.جریان.خواندن(4096)
    r.جریان.بستن()
    برگشت got
پایان

تابع ریشه:
    eport := start_echo()
    udps := یو دی پی.پیوند(0)
    uport := یو دی پی.درگاه(udps)
    ساکس.برو(udp_echo، udps.توصیفگر برگردان تهی*)

    ناپایا cfg := ساکس.پیکربندی سرور جدید(0)
    cfg.مهلت دست‌دهی میلی‌ثانیه = 600
    sv := ساکس.شروع(cfg)
    سرچاپ "server up: " + sv.موفق
    cl := ساکس.کلاینت جدید("127.0.0.1"، sv.درگاه)

    r1 := ساکس.اتصال(cl، "127.0.0.1"، eport)
    say("v5 ipv4"، r1)
    سرچاپ roundtrip(r1، "hello ipv4")
    r2 := ساکس.اتصال(cl، "localhost"، eport)
    say("v5 domain"، r2)
    سرچاپ roundtrip(r2، "hello domain")
    conn := ساکس.شماره‌گیری اتصال(cl، "127.0.0.1"، eport)
    تی سی پی.نوشتن(conn، "plain conn")
    سرچاپ "DialConn: " + تی سی پی.خواندن(conn، 100)
    تی سی پی.بستن(conn)

    ناپایا big := 0
    ناپایا bad := 0
    rb := ساکس.اتصال(cl، "127.0.0.1"، eport)
    chunk := "abcdefghijklmnopqrstuvwxyz0123456789".تکرار(400)
    تکرار 24:
        rb.جریان.نوشتن(chunk)
        ناپایا got := 0
        تا got کوچکتر chunk.طول():
            d := rb.جریان.خواندن(chunk.طول() - got)
            اگر d.طول() برابر 0: بشکن پایان
            got += d.طول()
        پایان
        big += got
        اگر got نابرابر chunk.طول(): bad++ پایان
    پایان
    rb.جریان.بستن()
    سرچاپ "bulk bytes echoed: " + big + " short reads: " + bad

    free := تی سی پی.درگاه آزاد()
    rr := ساکس.اتصال(cl، "127.0.0.1"، free)
    say("refused"، rr)
    ru := ساکس.اتصال(cl، "no-such-host.invalid"، 80)
    say("unresolvable"، ru)
    سرچاپ "empty target: " + ساکس.اتصال(cl، ""، 80).موفق

    ناپایا acfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.افزودن کاربر(acfg، "alice"، "s3cret")
    asv := ساکس.شروع(acfg)
    good := ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، asv.درگاه، "alice"، "s3cret")
    say("auth good"، ساکس.اتصال(good، "127.0.0.1"، eport))
    سرچاپ roundtrip(ساکس.اتصال(good، "127.0.0.1"، eport)، "authed")
    say("auth wrong password"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، asv.درگاه، "alice"، "nope")، "127.0.0.1"، eport))
    say("auth unknown user"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، asv.درگاه، "mallory"، "s3cret")، "127.0.0.1"، eport))
    say("auth missing"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، asv.درگاه)، "127.0.0.1"، eport))
    say("auth offered to open server"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، sv.درگاه، "x"، "y")، "127.0.0.1"، eport))
    ساکس.توقف(asv)

    ناپایا ccfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.تعیین احراز هویت(ccfg، (u: رشته، p: رشته): برگشت u برابر "bob" و p برابر "pw" پایان)
    csv := ساکس.شروع(ccfg)
    say("callback auth good"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، csv.درگاه، "bob"، "pw")، "127.0.0.1"، eport))
    say("callback auth bad"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، csv.درگاه، "bob"، "xx")، "127.0.0.1"، eport))
    ساکس.توقف(csv)

    ناپایا rcfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.تعیین اتصال به مقصد(rcfg، (h: رشته، _p: صحیح):
        اگر h برابر "echo.internal":
            برگشت ساکس.اتصال مستقیم("127.0.0.1"، eport، 2000)
        پایان
        برگشت ساکس.خروجی { موفق = نادرست، کد = ساکس.پاسخ شبکه در دسترس نیست، خطا = "no route" }
    پایان)
    rsv := ساکس.شروع(rcfg)
    rc := ساکس.کلاینت جدید("127.0.0.1"، rsv.درگاه)
    سرچاپ roundtrip(ساکس.اتصال(rc، "echo.internal"، 1)، "routed by callback")
    say("callback refuses"، ساکس.اتصال(rc، "other.internal"، 1))
    ساکس.توقف(rsv)

    ناپایا pcfg := ساکس.پیکربندی سرور جدید(0)
    pcfg.اجازه = (cmd: صحیح، _h: رشته، p: صحیح): برگشت وارونه (cmd برابر ساکس.فرمان اتصال و p برابر 25) پایان
    psv := ساکس.شروع(pcfg)
    pc := ساکس.کلاینت جدید("127.0.0.1"، psv.درگاه)
    say("acl allows"، ساکس.اتصال(pc، "127.0.0.1"، eport))
    say("acl denies port 25"، ساکس.اتصال(pc، "127.0.0.1"، 25))
    ساکس.توقف(psv)

    ناپایا c4 := ساکس.کلاینت جدید("127.0.0.1"، sv.درگاه)
    c4.نسخه = ساکس.ساکس۴
    say("socks4 ip"، ساکس.اتصال(c4، "127.0.0.1"، eport))
    سرچاپ roundtrip(ساکس.اتصال(c4، "127.0.0.1"، eport)، "four")
    سرچاپ roundtrip(ساکس.اتصال(c4، "localhost"، eport)، "four resolved by client")
    c4.نسخه = ساکس.ساکس۴ای
    c4.نام کاربری = "tester"
    سرچاپ roundtrip(ساکس.اتصال(c4، "localhost"، eport)، "four a")
    say("socks4 refused"، ساکس.اتصال(c4، "127.0.0.1"، free))

    ناپایا a4cfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.افزودن کاربر(a4cfg، "u"، "p")
    a4sv := ساکس.شروع(a4cfg)
    c4b := ساکس.کلاینت جدید("127.0.0.1"، a4sv.درگاه)
    c4b.نسخه = ساکس.ساکس۴
    say("socks4 vs auth server"، ساکس.اتصال(c4b، "127.0.0.1"، eport))
    ساکس.توقف(a4sv)

    ناپایا ncfg := ساکس.پیکربندی سرور جدید(0)
    ncfg.اجازه ساکس۴ = نادرست
    nsv := ساکس.شروع(ncfg)
    c4c := ساکس.کلاینت جدید("127.0.0.1"، nsv.درگاه)
    c4c.نسخه = ساکس.ساکس۴
    say("socks4 disabled"، ساکس.اتصال(c4c، "127.0.0.1"، eport))
    ساکس.توقف(nsv)

    u := ساکس.ایجاد نشست یو دی پی(cl)
    سرچاپ "udp associate: " + u.موفق
    ساکس.تنظیم مهلت یو دی پی(u، 2000)
    سرچاپ "udp send: " + ساکس.ارسال یو دی پی(u، "127.0.0.1"، uport، "datagram one")
    ubuf := حافظه.تخصیص(1024 برگردان طبیعی۶۴)
    ناپایا from := ساکس.نشانی {}
    n := ساکس.دریافت بایت یو دی پی(u، ubuf، 1024، from)
    سرچاپ "udp recv: " + n + " from " + from.میزبان + " same port: " + (from.درگاه برابر uport)
    ubuf2 := ubuf برگردان طبیعی۸*
    ubuf2[n] = 0 برگردان طبیعی۸
    سرچاپ رشته.رونوشت(ubuf برگردان رشته)
    حافظه.آزادسازی(ubuf)
    ساکس.بستن نشست یو دی پی(u)
    سرچاپ "udp over socks4 client: " + ساکس.ایجاد نشست یو دی پی(c4).موفق

    ناپایا bcfg := ساکس.پیکربندی سرور جدید(0)
    bcfg.اجازه پیوند = درست
    bsv := ساکس.شروع(bcfg)
    bc := ساکس.کلاینت جدید("127.0.0.1"، bsv.درگاه)
    br := ساکس.پیوند درخواست(bc، "127.0.0.1"، 0)
    say("bind first reply"، br)
    سرچاپ "bind port known: " + (br.نشانی محلی.درگاه بزرگتر 0)
    peer := تی سی پی.شماره گیری("127.0.0.1"، br.نشانی محلی.درگاه)
    acc := ساکس.پذیرش پیوند(br.جریان، bc)
    سرچاپ "bind accepted: " + acc.موفق
    تی سی پی.نوشتن(peer، "from the inbound peer")
    سرچاپ br.جریان.خواندن(100)
    br.جریان.نوشتن("reply to peer")
    سرچاپ تی سی پی.خواندن(peer، 100)
    تی سی پی.بستن(peer)
    br.جریان.بستن()
    say("bind not enabled"، ساکس.پیوند درخواست(ساکس.کلاینت جدید("127.0.0.1"، sv.درگاه)، "127.0.0.1"، 0))
    ساکس.توقف(bsv)

    sv2 := ساکس.شروع(ساکس.پیکربندی سرور جدید(0))
    hop := ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، sv.درگاه)، "127.0.0.1"، sv2.درگاه)
    say("chain hop one"، hop)
    h2 := ساکس.دست‌دهی کلاینت(hop.جریان، ساکس.کلاینت جدید(""، 0)، ساکس.فرمان اتصال، "127.0.0.1"، eport)
    سرچاپ "chain hop two: " + h2.موفق
    hop.جریان.نوشتن("through two proxies")
    سرچاپ hop.جریان.خواندن(100)
    hop.جریان.بستن()
    ساکس.توقف(sv2)

    ناپایا raw := تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    raw_send(raw، vec([71، 69، 84، 32]))
    سرچاپ "junk version: " + raw_read(raw، 16)
    تی سی پی.بستن(raw)

    raw = تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    raw_send(raw، vec([5، 0]))
    سرچاپ "zero methods: " + raw_read(raw، 16)
    تی سی پی.بستن(raw)

    raw = تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    raw_send(raw، vec([5، 1، 1]))
    سرچاپ "only gssapi: " + raw_read(raw، 16)
    تی سی پی.بستن(raw)

    raw = تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    raw_send(raw، vec([5، 1، 0]))
    سرچاپ "greeting: " + raw_read(raw، 2)
    raw_send(raw، vec([5، 1، 0، 9، 1، 2، 3، 4، 0، 80]))
    سرچاپ "bad atyp: " + raw_read(raw، 16)
    تی سی پی.بستن(raw)

    raw = تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    raw_send(raw، vec([5، 1، 0]))
    سرچاپ "greeting: " + raw_read(raw، 2)
    raw_send(raw، vec([5، 9، 0، 1، 127، 0، 0، 1، 0، 80]))
    سرچاپ "bad command: " + raw_read(raw، 16)
    تی سی پی.بستن(raw)

    raw = تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    raw_send(raw، vec([5، 1، 0]))
    سرچاپ "greeting: " + raw_read(raw، 2)
    raw_send(raw، vec([5، 1، 0، 3، 0، 0، 80]))
    سرچاپ "empty domain: " + raw_read(raw، 16)
    تی سی پی.بستن(raw)

    raw = تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    raw_send(raw، vec([5، 1، 0]))
    سرچاپ "greeting: " + raw_read(raw، 2)
    raw_send(raw، vec([5، 1، 0، 1، 127]))
    تی سی پی.بستن(raw)
    سرچاپ "truncated request closed"

    raw = تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    سرچاپ "idle client sees close: " + raw_read(raw، 16).طول()
    تی سی پی.بستن(raw)

    raw = تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه)
    raw_send(raw، vec([4، 1، 0، 80، 0، 0، 0، 1]))
    raw_send(raw، vec([97، 98، 99]))
    تی سی پی.بستن(raw)
    سرچاپ "socks4a with no terminator closed"

    say("still serving"، ساکس.اتصال(cl، "127.0.0.1"، eport))

    ساکس.توقف(sv)
    همگام سازی.خواب میلی ثانیه(50)
    سرچاپ "stopped: " + تی سی پی.اتصال معتبر(تی سی پی.شماره گیری("127.0.0.1"، sv.درگاه))
پایان
