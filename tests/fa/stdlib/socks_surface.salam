واردسازی حافظه
واردسازی شبکه.ساکس
واردسازی شبکه.تونل
واردسازی شبکه.تی سی پی
واردسازی شبکه.یو دی پی

ناپایا qport := 0

تابع send(s: پویا تونل.جریان، vals: صحیح[]):
    buf := حافظه.تخصیص(vals.طول() برگردان طبیعی۶۴)
    تکرار vals.طول() در i:
        (buf برگردان طبیعی۸*)[i] = vals[i] برگردان طبیعی۸
    پایان
    _n := s.نوشتن بایت(buf، vals.طول())
    حافظه.آزادسازی(buf)
پایان

تابع take(s: پویا تونل.جریان، n: صحیح): رشته:
    buf := حافظه.تخصیص(n برگردان طبیعی۶۴)
    got := s.خواندن بایت(buf، n)
    hexd := "0123456789abcdef"
    ناپایا out := ""
    تکرار got در i:
        b := (buf برگردان طبیعی۸*)[i] برگردان صحیح
        out = out + hexd.زیررشته(b / 16، 1) + hexd.زیررشته(b % 16، 1)
    پایان
    حافظه.آزادسازی(buf)
    برگشت out
پایان

تابع ریشه:
    p1 := تونل.لوله جدید()
    a1 := تونل.سر اول لوله(p1)
    b1 := تونل.سر دوم لوله(p1)
    send(a1، [5، 1، 0، 5، 1، 0، 1، 127، 0، 0، 1، 0، 80])
    ناپایا in5 := ساکس.ورودی ساکس۵ {}
    s5 := in5.دست‌دهی(b1)
    سرچاپ "socks5"، s5.موفق، s5.مقصد.میزبان، s5.مقصد.درگاه
    in5.پاسخ(b1، s5، درست)
    سرچاپ take(a1، 2)، take(a1، 10)

    p2 := تونل.لوله جدید()
    a2 := تونل.سر اول لوله(p2)
    b2 := تونل.سر دوم لوله(p2)
    send(a2، [4، 1، 0، 80، 10، 1، 2، 3، 0])
    ناپایا in4 := ساکس.ورودی ساکس۴ {}
    s4 := in4.دست‌دهی(b2)
    سرچاپ "socks4"، s4.موفق
    in4.پاسخ(b2، s4، نادرست)
    سرچاپ take(a2، 8)

    p3 := تونل.لوله جدید()
    a3 := تونل.سر اول لوله(p3)
    b3 := تونل.سر دوم لوله(p3)
    send(b3، [5، 0، 5، 0، 0، 1، 0، 0، 0، 0، 0، 0])
    conn := ساکس.رابط ساکس { کلاینت = ساکس.کلاینت جدید("10.0.0.1"، 1080) }
    سرچاپ conn.کارساز().میزبان، conn.کارساز().درگاه
    سرچاپ conn.دست‌دهی(a3، تونل.نشانی جدید("example.com"، 443))

    p4 := تونل.لوله جدید()
    a4 := تونل.سر اول لوله(p4)
    b4 := تونل.سر دوم لوله(p4)
    send(a4، [9، 9، 9])
    ساکس.رسیدگی(ساکس.پیکربندی سرور جدید(0)، b4)
    سرچاپ "handled"، b4.معتبر()

    p5 := تونل.لوله جدید()
    a5 := تونل.سر اول لوله(p5)
    b5 := تونل.سر دوم لوله(p5)
    p6 := تونل.لوله جدید()
    a6 := تونل.سر اول لوله(p6)
    b6 := تونل.سر دوم لوله(p6)
    a5.نوشتن("relayed bytes")
    b6.تنظیم مهلت(200)
    rs := ساکس.رله(b5، a6، 300)
    سرچاپ "relay"، rs.از اول به دوم، rs.از دوم به اول

    ناپایا bad := ساکس.پیکربندی سرور جدید(0)
    bad.میزبان پیوند = "203.0.113.1"
    سرچاپ "serve unbindable"، ساکس.خدمت‌رسانی(bad)

    ناپایا hv := وکتور {} برگردان وکتور<طبیعی۸>
    hv.بیفزا(192 برگردان طبیعی۸)
    hv.بیفزا(168 برگردان طبیعی۸)
    hv.بیفزا(1 برگردان طبیعی۸)
    hv.بیفزا(9 برگردان طبیعی۸)
    سرچاپ ساکس.قالب آی‌پی۴(hv، 0)

    srv := تی سی پی.پیوند(0)
    سرچاپ تی سی پی.معتبر(srv)
    تی سی پی.بستن سرور(srv)
    cl := ساکس.کلاینت جدید("127.0.0.1"، 1)
    u := ساکس.نشست یو دی پی { میزبان رله = "127.0.0.1"، درگاه رله = 9، سوکت = یو دی پی.باز کردن() }
    سرچاپ ساکس.ارسال بایت یو دی پی(u، "127.0.0.1"، 9، "x" برگردان تهی*، 1) بزرگتر 0
    یو دی پی.بستن(u.سوکت)
    سرچاپ cl.درگاه
پایان
