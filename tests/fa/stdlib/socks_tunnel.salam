واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        d := تی سی پی.خواندن(c، 4096)
        اگر d.طول() برابر 0: بشکن پایان
        تی سی پی.نوشتن(c، d)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع origin_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    d := تی سی پی.خواندن(c، 4096)
    اگر d.طول() بزرگتر 0:
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: 6\r\nConnection: close\r\n\r\norigin")
    پایان
    تی سی پی.بستن(c)
پایان

تابع origin_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ساکس.برو(origin_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع say(label: رشته، r: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد
پایان

تابع ریشه:
    es := تی سی پی.پیوند(0)
    eport := تی سی پی.درگاه(es)
    ساکس.برو(echo_accept، es.توصیفگر برگردان تهی*)
    os := تی سی پی.پیوند(0)
    oport := تی سی پی.درگاه(os)
    ساکس.برو(origin_accept، os.توصیفگر برگردان تهی*)

    ناپایا pcfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(pcfg، درست)
    ساکس.افزودن کاربر(pcfg، "u"، "p")
    ناپایا hcfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(hcfg، درست)
    پراکسی اچ‌تی‌تی‌پی.افزودن کاربر(hcfg، "u"، "p")

    ناپایا mixed := تونل.ترکیبی جدید()
    تونل.تنظیم ساکس۵ ترکیبی(mixed، ساکس.ورودی جدید(pcfg))
    تونل.تنظیم ساکس۴ ترکیبی(mixed، ساکس.ورودی جدید ساکس۴(ساکس.پیکربندی سرور جدید(0)))
    تونل.تنظیم اچ تی تی پی ترکیبی(mixed، پراکسی اچ‌تی‌تی‌پی.ورودی جدید(hcfg))
    fwd := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، mixed)
    inb := تونل.شنود تی سی پی(0)
    تونل.سرویس‌دهی پس‌زمینه(inb، mixed، fwd)
    سرچاپ "mixed inbound up: " + inb.معتبر()

    s5 := ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، inb.درگاه، "u"، "p")
    r5 := ساکس.اتصال(s5، "127.0.0.1"، eport)
    say("socks5 through mixed"، r5)
    r5.جریان.نوشتن("five")
    سرچاپ r5.جریان.خواندن(100)
    r5.جریان.بستن()
    say("socks5 wrong password"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، inb.درگاه، "u"، "x")، "127.0.0.1"، eport))
    say("socks5 no credentials"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، inb.درگاه)، "127.0.0.1"، eport))
    ناپایا s4 := ساکس.کلاینت جدید("127.0.0.1"، inb.درگاه)
    s4.نسخه = ساکس.ساکس۴
    r4 := ساکس.اتصال(s4، "127.0.0.1"، eport)
    say("socks4 through mixed"، r4)
    r4.جریان.نوشتن("four")
    سرچاپ r4.جریان.خواندن(100)
    r4.جریان.بستن()
    say("socks5 refused target"، ساکس.اتصال(s5، "127.0.0.1"، تی سی پی.درگاه آزاد()))

    hc := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، inb.درگاه، "u"، "p")
    rh := پراکسی اچ‌تی‌تی‌پی.اتصال(hc، "127.0.0.1"، eport)
    سرچاپ "http connect through mixed: " + rh.موفق + " " + rh.وضعیت
    rh.جریان.نوشتن("http tunnel")
    سرچاپ rh.جریان.خواندن(100)
    rh.جریان.بستن()
    g := پراکسی اچ‌تی‌تی‌پی.دریافت(hc، "http://127.0.0.1:" + oport + "/")
    سرچاپ "http get through mixed: " + g.وضعیت + " " + g.بدنه
    سرچاپ "http without credentials: " + پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، inb.درگاه)، "127.0.0.1"، eport).وضعیت
    سرچاپ "http refused target: " + پراکسی اچ‌تی‌تی‌پی.اتصال(hc، "127.0.0.1"، تی سی پی.درگاه آزاد()).وضعیت
    inb.توقف()

    ناپایا ds := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(ds، درست)
    ساکس.تعیین شماره‌گیر(ds، تونل.مستقیم())
    dsv := ساکس.شروع(ds)
    say("socks server with tunnel dialer"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، dsv.درگاه)، "127.0.0.1"، eport))
    ساکس.توقف(dsv)

    ناپایا bs := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(bs، درست)
    ساکس.تعیین شماره‌گیر(bs، تونل.مسدود())
    bsv := ساکس.شروع(bs)
    say("socks server with block dialer"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، bsv.درگاه)، "127.0.0.1"، eport))
    ساکس.توقف(bsv)

    ناپایا hs := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(hs، درست)
    پراکسی اچ‌تی‌تی‌پی.تعیین شماره‌گیر(hs، تونل.مسدود())
    hsv := پراکسی اچ‌تی‌تی‌پی.شروع(hs)
    سرچاپ "http server with block dialer: " + پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، hsv.درگاه)، "127.0.0.1"، eport).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(hsv)

    ناپایا sv1cfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(sv1cfg، درست)
    sv1 := ساکس.شروع(sv1cfg)
    ناپایا h2 := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(h2، درست)
    پراکسی اچ‌تی‌تی‌پی.تعیین شماره‌گیر(h2، تونل.از طریق(تونل.مستقیم()، ساکس.رابط جدید(ساکس.کلاینت جدید("127.0.0.1"، sv1.درگاه))))
    hsv2 := پراکسی اچ‌تی‌تی‌پی.شروع(h2)
    سرچاپ "http proxy that dials through a socks proxy: " + پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، hsv2.درگاه)، "127.0.0.1"، eport).وضعیت
    cr := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، hsv2.درگاه)، "127.0.0.1"، eport)
    cr.جریان.نوشتن("two hops")
    سرچاپ cr.جریان.خواندن(100)
    cr.جریان.بستن()
    پراکسی اچ‌تی‌تی‌پی.توقف(hsv2)
    ساکس.توقف(sv1)

    ناپایا sv2cfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(sv2cfg، درست)
    sv2 := ساکس.شروع(sv2cfg)
    ناپایا h3 := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(h3، درست)
    hsv3 := پراکسی اچ‌تی‌تی‌پی.شروع(h3)
    ناپایا chain := تونل.زنجیره جدید(تونل.مستقیم())
    تونل.افزودن گام(chain، پراکسی اچ‌تی‌تی‌پی.رابط جدید(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، hsv3.درگاه)))
    تونل.افزودن گام(chain، ساکس.رابط جدید(ساکس.کلاینت جدید("127.0.0.1"، sv2.درگاه)))
    سرچاپ chain.نام()
    cs := chain.اتصال(تونل.نشانی جدید("127.0.0.1"، eport))
    سرچاپ "chain http then socks: " + cs.معتبر()
    cs.نوشتن("chained")
    سرچاپ cs.خواندن(100)
    cs.بستن()
    پراکسی اچ‌تی‌تی‌پی.توقف(hsv3)
    ساکس.توقف(sv2)
پایان
