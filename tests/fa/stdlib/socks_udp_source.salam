واردسازی حافظه
واردسازی شبکه.ساکس
واردسازی شبکه.یو دی پی

تابع wrapped(port: صحیح، text: رشته): وکتور<طبیعی۸>:
    ناپایا hdr := ساکس.رمزگذاری سرآیند یو دی پی(ساکس.نشانی جدید("127.0.0.1"، port)، 0)
    p := text برگردان طبیعی۸*
    تکرار text.طول() در i:
        hdr.بیفزا(p[i])
    پایان
    برگشت hdr
پایان

تابع waits(sink: یو دی پی.سوکت یو دی پی، buf: تهی*): صحیح:
    ناپایا h := ""
    ناپایا p := 0
    برگشت یو دی پی.دریافت بایت(sink، buf، 256، h، p)
پایان

تابع ریشه():
    sink := یو دی پی.پیوند(0)
    یو دی پی.تنظیم زمان انتظار(sink، 700)
    sport := یو دی پی.درگاه(sink)
    buf := حافظه.تخصیص(256 برگردان طبیعی۶۴)
    cfg := ساکس.پیکربندی سرور جدید(0)
    sv := ساکس.شروع(cfg)
    cl := ساکس.کلاینت جدید("127.0.0.1"، sv.درگاه)
    u := ساکس.ایجاد نشست یو دی پی(cl)
    سرچاپ "associate"، u.موفق
    attacker := یو دی پی.پیوند روی("127.0.0.2"، 0)
    pkt := wrapped(sport، "stolen")
    pb := حافظه.تخصیص(pkt.طول() برگردان طبیعی۶۴) برگردان طبیعی۸*
    تکرار pkt.طول() در i:
        pb[i] = pkt.بگیر(i)
    پایان
    یو دی پی.ارسال بایت(attacker، u.میزبان رله، u.درگاه رله، pb برگردان تهی*، pkt.طول())
    سرچاپ "datagram from another address relayed"، waits(sink، buf) بزرگتر 0
    سرچاپ "legitimate datagram"، ساکس.ارسال یو دی پی(u، "127.0.0.1"، sport، "mine")
    سرچاپ "legitimate datagram relayed"، waits(sink، buf) بزرگتر 0
    ساکس.بستن نشست یو دی پی(u)
    ساکس.توقف(sv)
پایان
