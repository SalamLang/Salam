بسته ریشه

واردسازی مرتب سازی
واردسازی رشته

تابع show(label: رشته، idx &: وکتور<صحیح>):
    ناپایا line := ""
    تکرار idx.طول() در i:
        اگر i بزرگتر 0: line = line + " " پایان
        line = line + رشته.از عدد(idx.بگیر(i) برگردان صحیح۶۴)
    پایان
    سرچاپ label، line
پایان

تابع identity(n: صحیح): وکتور<صحیح>:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    تکرار n در i:
        v.بیفزا(i)
    پایان
    برگشت v
پایان

تابع ریشه:
    ناپایا keys := وکتور {} برگردان وکتور<اعشار۶۴>
    keys.بیفزا(2.5)
    keys.بیفزا(0.5)
    keys.بیفزا(9.0)
    keys.بیفزا(-1.0)
    keys.بیفزا(4.0)

    ناپایا idx := identity(5)
    مرتب سازی.مرتب‌سازی نمایه(idx، keys)
    show("ascending: "، idx)
    سرچاپ "keys untouched: "، keys.بگیر(0)، keys.بگیر(3)

    ناپایا desc := identity(5)
    مرتب سازی.مرتب‌سازی نمایه نزولی(desc، keys)
    show("descending: "، desc)

    ناپایا many := وکتور {} برگردان وکتور<اعشار۶۴>
    تکرار 40 در i:
        many.بیفزا(((i * 17) % 40) برگردان اعشار۶۴)
    پایان
    ناپایا big := identity(40)
    مرتب سازی.مرتب‌سازی نمایه(big، many)
    ناپایا ordered := درست
    تکرار 39 در i:
        اگر many.بگیر(big.بگیر(i)) بزرگتر many.بگیر(big.بگیر(i + 1)): ordered = نادرست پایان
    پایان
    سرچاپ "forty ascending: "، ordered، big.بگیر(0)، big.بگیر(39)

    ناپایا big_desc := identity(40)
    مرتب سازی.مرتب‌سازی نمایه نزولی(big_desc، many)
    ناپایا reversed := درست
    تکرار 39 در i:
        اگر many.بگیر(big_desc.بگیر(i)) کوچکتر many.بگیر(big_desc.بگیر(i + 1)): reversed = نادرست پایان
    پایان
    سرچاپ "forty descending: "، reversed، big_desc.بگیر(0)، big_desc.بگیر(39)

    ناپایا one := identity(1)
    مرتب سازی.مرتب‌سازی نمایه(one، keys)
    show("single: "، one)
    ناپایا none := وکتور {} برگردان وکتور<صحیح>
    مرتب سازی.مرتب‌سازی نمایه نزولی(none، keys)
    سرچاپ "empty: "، none.طول()

    ناپایا sub := وکتور {} برگردان وکتور<صحیح>
    sub.بیفزا(4)
    sub.بیفزا(1)
    sub.بیفزا(3)
    مرتب سازی.مرتب‌سازی نمایه(sub، keys)
    show("subset: "، sub)

    keys.آزادکن()
    many.آزادکن()
    idx.آزادکن()
    desc.آزادکن()
    big.آزادکن()
    big_desc.آزادکن()
    one.آزادکن()
    none.آزادکن()
    sub.آزادکن()
پایان
