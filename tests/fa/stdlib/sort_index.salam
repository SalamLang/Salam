بسته ریشه

واردسازی مرتب سازی
واردسازی رشته

تابع نمایش(برچسب: رشته، نمایه &: وکتور<صحیح>):
    ناپایا خط := ""
    تکرار نمایه.طول() در i:
        اگر i بزرگتر 0: خط = خط + " " پایان
        خط = خط + رشته.از عدد(نمایه.بگیر(i) برگردان صحیح۶۴)
    پایان
    سرچاپ برچسب، خط
پایان

تابع همانی(n: صحیح): وکتور<صحیح>:
    ناپایا v := وکتور {} برگردان وکتور<صحیح>
    تکرار n در i:
        v.بیفزا(i)
    پایان
    برگشت v
پایان

تابع ریشه:
    ناپایا کلیدها := وکتور {} برگردان وکتور<اعشار۶۴>
    کلیدها.بیفزا(2.5)
    کلیدها.بیفزا(0.5)
    کلیدها.بیفزا(9.0)
    کلیدها.بیفزا(-1.0)
    کلیدها.بیفزا(4.0)

    ناپایا نمایه := همانی(5)
    مرتب سازی.مرتب‌سازی نمایه(نمایه، کلیدها)
    نمایش("ascending: "، نمایه)
    سرچاپ "keys untouched: "، کلیدها.بگیر(0)، کلیدها.بگیر(3)

    ناپایا نمایه نزولی := همانی(5)
    مرتب سازی.مرتب‌سازی نمایه نزولی(نمایه نزولی، کلیدها)
    نمایش("descending: "، نمایه نزولی)

    ناپایا مقادیر زیاد := وکتور {} برگردان وکتور<اعشار۶۴>
    تکرار 40 در i:
        مقادیر زیاد.بیفزا(((i * 17) % 40) برگردان اعشار۶۴)
    پایان
    ناپایا نمایه بزرگ := همانی(40)
    مرتب سازی.مرتب‌سازی نمایه(نمایه بزرگ، مقادیر زیاد)
    ناپایا مرتب := درست
    تکرار 39 در i:
        اگر مقادیر زیاد.بگیر(نمایه بزرگ.بگیر(i)) بزرگتر مقادیر زیاد.بگیر(نمایه بزرگ.بگیر(i + 1)): مرتب = نادرست پایان
    پایان
    سرچاپ "forty ascending: "، مرتب، نمایه بزرگ.بگیر(0)، نمایه بزرگ.بگیر(39)

    ناپایا نمایه بزرگ نزولی := همانی(40)
    مرتب سازی.مرتب‌سازی نمایه نزولی(نمایه بزرگ نزولی، مقادیر زیاد)
    ناپایا معکوس := درست
    تکرار 39 در i:
        اگر مقادیر زیاد.بگیر(نمایه بزرگ نزولی.بگیر(i)) کوچکتر مقادیر زیاد.بگیر(نمایه بزرگ نزولی.بگیر(i + 1)): معکوس = نادرست پایان
    پایان
    سرچاپ "forty descending: "، معکوس، نمایه بزرگ نزولی.بگیر(0)، نمایه بزرگ نزولی.بگیر(39)

    ناپایا نمایه تک := همانی(1)
    مرتب سازی.مرتب‌سازی نمایه(نمایه تک، کلیدها)
    نمایش("single: "، نمایه تک)
    ناپایا نمایه خالی := وکتور {} برگردان وکتور<صحیح>
    مرتب سازی.مرتب‌سازی نمایه نزولی(نمایه خالی، کلیدها)
    سرچاپ "empty: "، نمایه خالی.طول()

    ناپایا زیرمجموعه := وکتور {} برگردان وکتور<صحیح>
    زیرمجموعه.بیفزا(4)
    زیرمجموعه.بیفزا(1)
    زیرمجموعه.بیفزا(3)
    مرتب سازی.مرتب‌سازی نمایه(زیرمجموعه، کلیدها)
    نمایش("subset: "، زیرمجموعه)

    کلیدها.آزادکن()
    مقادیر زیاد.آزادکن()
    نمایه.آزادکن()
    نمایه نزولی.آزادکن()
    نمایه بزرگ.آزادکن()
    نمایه بزرگ نزولی.آزادکن()
    نمایه تک.آزادکن()
    نمایه خالی.آزادکن()
    زیرمجموعه.آزادکن()
پایان
