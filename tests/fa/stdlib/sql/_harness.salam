بسته ابزار

واردسازی رشته
واردسازی دیتابیس.اس کیو ال

تابع یک خط(پ: رشته): رشته:
    تخت := رشته.جایگزینی(پ، "\n"، " ")
    ناپایا خروجی := رشته.جایگزینی(تخت، "    "، " ")
    تا رشته.شامل است(خروجی، "  "):
        کوتاه تر := رشته.جایگزینی(خروجی، "  "، " ")
        خروجی = کوتاه تر
    پایان
    برگشت رشته.پیرایش(خروجی)
پایان

تابع جایگاه(ع: اس کیو ال.عیب): رشته:
    برگشت رشته.از عدد(ع.خط برگردان صحیح۶۴) + ":" + رشته.از عدد(ع.ستون برگردان صحیح۶۴)
پایان

@en "Show"
@fa "نمایش"
همگانی تابع نمایش(پ: رشته، ن: اس کیو ال.گزارش):
    تخت := یک خط(پ)
    اگر ن.خطاها == ۰ و ن.هشدارها == ۰:
        سرچاپ "ok   " + تخت
        برگشت
    پایان
    سرچاپ "bad  " + تخت
    ناپایا ای := ۰
    تا ای < ن.موارد.طول():
        ع := ن.موارد.بگیر(ای)
        سرچاپ "     " + ع.کد + " " + جایگاه(ع) + " " + ع.پیام
        اگر وارونه رشته.خالی است(ع.راهنما):
            سرچاپ "       help: " + ع.راهنما
        پایان
        ای = ای + ۱
    پایان
پایان

@en "Lint"
@fa "بازبینی"
همگانی تابع بازبینی(پ: رشته، گ: اس کیو ال.گویش):
    ناپایا ن := اس کیو ال.بازبینی(پ، گ)
    نمایش(پ، ن)
    اس کیو ال.آزادسازی گزارش(ن)
پایان

@en "Check"
@fa "بررسی"
همگانی تابع بررسی(پ: رشته، ف: اس کیو ال.فهرست جداول):
    ناپایا ن := اس کیو ال.بررسی(پ، ف)
    نمایش(پ، ن)
    اس کیو ال.آزادسازی گزارش(ن)
پایان

@en "Describe"
@fa "شرح"
همگانی تابع شرح(پ: رشته، ف: اس کیو ال.فهرست جداول):
    ناپایا ت := اس کیو ال.تحلیل کن(پ، ف)
    سرچاپ "query " + یک خط(پ)
    سرچاپ "  " + اس کیو ال.نام دستور(ت.نوع) + " on " + (رشته.خالی است(ت.جدول) ? "-" : ت.جدول)
    ناپایا ای := ۰
    تا ای < ت.پارامترها.طول():
        پا := ت.پارامترها.بگیر(ای)
        کجا := رشته.خالی است(پا.ستون) ? "?" : پا.جدول + "." + پا.ستون
        سر := "  param " + رشته.از عدد(پا.شماره برگردان صحیح۶۴) + " " + پا.نشانه + " " + کجا
        سرچاپ سر + " " + اس کیو ال.گونه سلام(پا.نوع، پا.تهی‌ناپذیر)
        ای = ای + ۱
    پایان
    ناپایا جی := ۰
    تا جی < ت.نتیجه‌ها.طول():
        س := ت.نتیجه‌ها.بگیر(جی)
        نام := رشته.خالی است(س.نام) ? "(expr)" : س.نام
        سر۲ := "  out " + رشته.از عدد(جی برگردان صحیح۶۴) + " " + نام + " "
        سرچاپ سر۲ + اس کیو ال.گونه سلام(س.نوع، وارونه س.تهی‌پذیر)
        جی = جی + ۱
    پایان
    اگر وارونه ت.بدون خطا:
        ناپایا کا := ۰
        تا کا < ت.گزارش.موارد.طول():
            ع := ت.گزارش.موارد.بگیر(کا)
            سرچاپ "  " + ع.کد + " " + جایگاه(ع) + " " + ع.پیام
            کا = کا + ۱
        پایان
    پایان
    اس کیو ال.آزادسازی تحلیل(ت)
پایان

@en "FillOut"
@fa "نمایش پرشده"
همگانی تابع نمایش پرشده(پ: رشته، م: اس کیو ال.مقدارها، گ: اس کیو ال.گویش):
    ناپایا ن := اس کیو ال.گزارش {}
    خروجی := اس کیو ال.پرکردن(پ، م، گ، ن)
    اگر ن.خطاها == ۰:
        سرچاپ "=> " + خروجی
    وگرنه:
        نمایش(پ، ن)
    پایان
    اس کیو ال.آزادسازی گزارش(ن)
پایان

@en "Schema"
@fa "طرح"
همگانی تابع طرح(دستورها: رشته، گ: اس کیو ال.گویش): اس کیو ال.فهرست جداول:
    ناپایا ف := اس کیو ال.فهرست تازه(گ)
    ناپایا ن := اس کیو ال.اعمال(ف، دستورها)
    اگر وارونه ن.بدون خطا:
        سرچاپ "DDL PROBLEM"
        نمایش(دستورها، ن)
    پایان
    اس کیو ال.آزادسازی گزارش(ن)
    برگشت ف
پایان

@en "Tables"
@fa "جدول ها"
همگانی تابع جدول ها(ف: اس کیو ال.فهرست جداول):
    ناپایا ای := ۰
    تا ای < اس کیو ال.شمار جدول(ف):
        ج := اس کیو ال.نام جدول(ف، ای)
        چاپ "table " + ج + ":"
        ناپایا جی := ۰
        تا جی < اس کیو ال.شمار ستون(ف، ج):
            س := اس کیو ال.ستون شماره(ف، ج، جی)
            ناپایا نشان := ""
            اگر س.کلید اصلی:
                نشان = نشان + "k"
            پایان
            اگر س.تهی‌ناپذیر:
                نشان = نشان + "!"
            پایان
            اگر س.پیش‌فرض دارد:
                نشان = نشان + "d"
            پایان
            اگر س.خودکار:
                نشان = نشان + "a"
            پایان
            اگر س.محاسبه‌شده:
                نشان = نشان + "g"
            پایان
            چاپ " " + س.نام + ":" + اس کیو ال.نام نوع(س.نوع) + (رشته.خالی است(نشان) ? "" : "/" + نشان)
            جی = جی + ۱
        پایان
        سرچاپ ""
        ای = ای + ۱
    پایان
پایان
