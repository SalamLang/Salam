-- گونه ی مقدار در مقایسه
ok   SELECT id FROM users WHERE age = 30
ok   SELECT id FROM users WHERE age = '30'
bad  SELECT id FROM users WHERE age = 'thirty'
     SQL330 1:34 "age" is int and this compares it with text
       help: a number goes here without quotes
bad  SELECT id FROM orders WHERE total = 'free'
     SQL330 1:37 "total" is float and this compares it with text
       help: a number goes here without quotes
ok   SELECT id FROM users WHERE email = 'ann'
ok   SELECT id FROM users WHERE age = ?

-- گروه بندی
ok   SELECT age, COUNT(*) FROM users GROUP BY age
ok   SELECT email, COUNT(*) FROM users GROUP BY id
bad  SELECT email, COUNT(*) FROM users GROUP BY age
     SQL332 1:8 "email" is neither grouped nor aggregated
       help: add it to GROUP BY, or wrap it in an aggregate such as MAX()
ok   SELECT age FROM users GROUP BY age HAVING COUNT(*) > 1
bad  SELECT age FROM users WHERE COUNT(*) > 1
     SQL328 1:1 an aggregate cannot be used in WHERE
       help: move the condition to HAVING, which runs after the grouping

-- شمار ستون زیرپرسمان و شماره ی ستون
ok   SELECT id FROM users WHERE id IN (SELECT user_id FROM orders)
bad  SELECT id FROM users WHERE id IN (SELECT id, total FROM orders)
     SQL324 1:31 this subquery returns 2 columns but one value is expected
       help: select just the column the comparison needs
ok   SELECT id, email FROM users ORDER BY 2
bad  SELECT id, email FROM users ORDER BY 3
     SQL326 1:38 ORDER BY names column 3 but the statement returns 2 columns
       help: count the result columns from 1, or name the column instead
ok   SELECT id FROM users LIMIT ?
bad  SELECT id FROM users LIMIT 'ten'
     SQL327 1:28 LIMIT takes a number
       help: write the count without quotes, or bind it as a placeholder
bad  SELECT id AS x, email AS x FROM users
     SQL325 1:26 two result columns are both called "x"
       help: give one of them a different alias
bad  UPDATE users SET name = ?, name = ? WHERE id = ?
     SQL329 1:28 "name" is assigned twice in this SET
       help: keep one assignment per column

-- چه می گیرد و چه برمی گرداند
query SELECT id, email, name, age, paid FROM users WHERE email = ? AND age > ?
  select on users
  param 1 ? users.email str
  param 2 ? users.age option.Option<i64>
  out 0 id i64
  out 1 email str
  out 2 name option.Option<str>
  out 3 age option.Option<i64>
  out 4 paid bool
query SELECT COUNT(*) AS n, SUM(total) AS s, MIN(id) AS lo FROM orders
  select on orders
  out 0 n i64
  out 1 s option.Option<f64>
  out 2 lo option.Option<i64>
query SELECT u.id, o.total FROM users u LEFT JOIN orders o ON o.user_id = u.id
  select on u
  out 0 id i64
  out 1 total option.Option<f64>
query INSERT INTO users (email, name) VALUES (?, ?) RETURNING id
  insert on users
  param 1 ? users.email str
  param 2 ? users.name option.Option<str>
  out 0 id i64
query UPDATE users SET name = ? WHERE id = ?
  update on users
  param 1 ? users.name option.Option<str>
  param 2 ? users.id i64
query DELETE FROM users WHERE id = ?
  delete on users
  param 1 ? users.id i64

-- پر کردن جانگهدارها
شمار مقدار: 5
=> INSERT INTO t (a, b, c, d, e) VALUES (42, 2.5, 'O''Brien', 1, NULL)
=> INSERT INTO t (a, b, c, d, e) VALUES (42, 2.5, 'O''Brien', TRUE, NULL)
=> SELECT a FROM t WHERE name = 'x'' OR ''1''=''1'
=> SELECT a FROM t WHERE note = '?' AND id = 7
=> SELECT a FROM t WHERE x = 7 OR y = 7
bad  SELECT a FROM t WHERE x = ? AND y = ?
     SQL400 1:1 this query takes 2 values but got 1
       help: add or remove an argument so the two agree
bad  SELECT a FROM t
     SQL400 1:1 this query takes 0 values but got 1
       help: add or remove an argument so the two agree
bad  SELECT a FROM t WHERE x = :name
     SQL401 1:27 a named placeholder cannot be filled in
       help: bind by position with ? or $1
