واردسازی رشته
واردسازی دیتابیس.اس کیو ال

فراخوانی ا "_harness.salam"

پایا طرح_پایه := """
    CREATE TABLE users (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        email TEXT NOT NULL,
        name TEXT,
        age INTEGER,
        paid BOOLEAN NOT NULL DEFAULT 0
    );
    CREATE TABLE orders (id INTEGER PRIMARY KEY, user_id INTEGER NOT NULL, total REAL NOT NULL, note TEXT);
"""

تابع ریشه:
    لایت := اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت)
    پست := اس کیو ال.گویش شماره(اس کیو ال.پستگرس)
    ناپایا ف := ا.طرح(طرح_پایه، لایت)

    سرچاپ "-- گونه ی مقدار در مقایسه"
    ا.بررسی("SELECT id FROM users WHERE age = 30"، ف)
    ا.بررسی("SELECT id FROM users WHERE age = '30'"، ف)
    ا.بررسی("SELECT id FROM users WHERE age = 'thirty'"، ف)
    ا.بررسی("SELECT id FROM orders WHERE total = 'free'"، ف)
    ا.بررسی("SELECT id FROM users WHERE email = 'ann'"، ف)
    ا.بررسی("SELECT id FROM users WHERE age = ?"، ف)

    سرچاپ ""
    سرچاپ "-- گروه بندی"
    ا.بررسی("SELECT age, COUNT(*) FROM users GROUP BY age"، ف)
    ا.بررسی("SELECT email, COUNT(*) FROM users GROUP BY id"، ف)
    ا.بررسی("SELECT email, COUNT(*) FROM users GROUP BY age"، ف)
    ا.بررسی("SELECT age FROM users GROUP BY age HAVING COUNT(*) > 1"، ف)
    ا.بررسی("SELECT age FROM users WHERE COUNT(*) > 1"، ف)

    سرچاپ ""
    سرچاپ "-- شمار ستون زیرپرسمان و شماره ی ستون"
    ا.بررسی("SELECT id FROM users WHERE id IN (SELECT user_id FROM orders)"، ف)
    ا.بررسی("SELECT id FROM users WHERE id IN (SELECT id, total FROM orders)"، ف)
    ا.بررسی("SELECT id, email FROM users ORDER BY 2"، ف)
    ا.بررسی("SELECT id, email FROM users ORDER BY 3"، ف)
    ا.بررسی("SELECT id FROM users LIMIT ?"، ف)
    ا.بررسی("SELECT id FROM users LIMIT 'ten'"، ف)
    ا.بررسی("SELECT id AS x, email AS x FROM users"، ف)
    ا.بررسی("UPDATE users SET name = ?, name = ? WHERE id = ?"، ف)

    سرچاپ ""
    سرچاپ "-- چه می گیرد و چه برمی گرداند"
    ا.شرح("SELECT id, email, name, age, paid FROM users WHERE email = ? AND age > ?"، ف)
    ا.شرح("SELECT COUNT(*) AS n, SUM(total) AS s, MIN(id) AS lo FROM orders"، ف)
    ا.شرح("SELECT u.id, o.total FROM users u LEFT JOIN orders o ON o.user_id = u.id"، ف)
    ا.شرح("INSERT INTO users (email, name) VALUES (?, ?) RETURNING id"، ف)
    ا.شرح("UPDATE users SET name = ? WHERE id = ?"، ف)
    ا.شرح("DELETE FROM users WHERE id = ?"، ف)

    سرچاپ ""
    سرچاپ "-- پر کردن جانگهدارها"
    ناپایا همه := اس کیو ال.مقدارهای تازه()
    اس کیو ال.افزودن عدد(همه، ۴۲ برگردان صحیح۶۴)
    اس کیو ال.افزودن اعشار(همه، ۲.۵)
    اس کیو ال.افزودن متن(همه، "O'Brien")
    اس کیو ال.افزودن منطقی(همه، درست)
    اس کیو ال.افزودن خالی(همه)
    سرچاپ "شمار مقدار: " + رشته.از عدد(اس کیو ال.شمار مقدار(همه) برگردان صحیح۶۴)
    ا.نمایش پرشده("INSERT INTO t (a, b, c, d, e) VALUES (?, ?, ?, ?, ?)"، همه، لایت)
    ا.نمایش پرشده("INSERT INTO t (a, b, c, d, e) VALUES ($1, $2, $3, $4, $5)"، همه، پست)
    اس کیو ال.آزادسازی مقدارها(همه)

    ناپایا حمله := اس کیو ال.مقدارهای تازه()
    اس کیو ال.افزودن متن(حمله، "x' OR '1'='1")
    ا.نمایش پرشده("SELECT a FROM t WHERE name = ?"، حمله، لایت)
    اس کیو ال.آزادسازی مقدارها(حمله)

    ناپایا یکی := اس کیو ال.مقدارهای تازه()
    اس کیو ال.افزودن عدد(یکی، ۷ برگردان صحیح۶۴)
    ا.نمایش پرشده("SELECT a FROM t WHERE note = '?' AND id = ?"، یکی، لایت)
    ا.نمایش پرشده("SELECT a FROM t WHERE x = $1 OR y = $1"، یکی، پست)
    ا.نمایش پرشده("SELECT a FROM t WHERE x = ? AND y = ?"، یکی، لایت)
    ا.نمایش پرشده("SELECT a FROM t"، یکی، لایت)
    ا.نمایش پرشده("SELECT a FROM t WHERE x = :name"، یکی، لایت)
    اس کیو ال.آزادسازی مقدارها(یکی)

    اس کیو ال.آزادسازی فهرست(ف)
    برگشت ۰
پایان
