بسته ریشه

واردسازی دیتابیس.اس کیو ال

تابع ریشه:
    لایت := اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت)
    پست := اس کیو ال.گویش شماره(اس کیو ال.پستگرس)

    ناپایا گ۱ := اس کیو ال.بازبینی("SELECT id, name FROM users WHERE id = ?"، لایت)
    سرچاپ "درست:"، گ۱.بدون خطا
    اس کیو ال.آزادسازی گزارش(گ۱)

    ناپایا گ۲ := اس کیو ال.بازبینی("SELECT id FROM users WHERE id = ?"، پست)
    سرچاپ "پستگرس:"، گ۲.بدون خطا، گ۲.موارد.بگیر(۰).کد
    اس کیو ال.آزادسازی گزارش(گ۲)

    سرچاپ "شمار پارامتر:"، اس کیو ال.شمار پارامتر("SELECT a FROM t WHERE b = ? AND c = ?"، لایت)

    ناپایا فهرست := اس کیو ال.فهرست تازه(لایت)
    ناپایا طرح := اس کیو ال.اعمال(فهرست، """
        CREATE TABLE کاربران (
            شناسه INTEGER PRIMARY KEY AUTOINCREMENT,
            رایانامه TEXT NOT NULL,
            نام TEXT
        );
    """)
    سرچاپ "طرح:"، طرح.بدون خطا
    اس کیو ال.آزادسازی گزارش(طرح)

    سرچاپ "جدول ها:"، اس کیو ال.شمار جدول(فهرست)
    سرچاپ "ستون ها:"، اس کیو ال.شمار ستون(فهرست، "کاربران")
    سرچاپ "رایانامه هست:"، اس کیو ال.ستون دارد(فهرست، "کاربران"، "رایانامه")
    ستون یک := اس کیو ال.ستون شماره(فهرست، "کاربران"، ۰)
    سرچاپ "نوع شناسه:"، اس کیو ال.نام نوع(ستون یک.نوع)، اس کیو ال.گونه سلام(ستون یک.نوع، ستون یک.تهی‌ناپذیر)

    ناپایا ب۱ := اس کیو ال.بررسی("SELECT شناسه, رایانامه FROM کاربران WHERE شناسه = ?"، فهرست)
    سرچاپ "پرسمان درست:"، ب۱.بدون خطا
    اس کیو ال.آزادسازی گزارش(ب۱)

    ناپایا ب۲ := اس کیو ال.بررسی("SELECT شناسه, ایمیل FROM کاربران"، فهرست)
    سرچاپ "ستون ناشناخته:"، ب۲.موارد.بگیر(۰).کد
    اس کیو ال.آزادسازی گزارش(ب۲)

    ناپایا ت := اس کیو ال.تحلیل کن("SELECT شناسه, نام FROM کاربران WHERE رایانامه = ?"، فهرست)
    سرچاپ "گونه دستور:"، اس کیو ال.نام دستور(ت.نوع)، "جدول:"، ت.جدول
    سرچاپ "پارامتر:"، ت.پارامترها.بگیر(۰).ستون، اس کیو ال.گونه سلام(ت.پارامترها.بگیر(۰).نوع، ت.پارامترها.بگیر(۰).تهی‌ناپذیر)
    سرچاپ "ستون نتیجه:"، ت.نتیجه‌ها.طول()، ت.نتیجه‌ها.بگیر(۱).نام، ت.نتیجه‌ها.بگیر(۱).تهی‌پذیر
    اس کیو ال.آزادسازی تحلیل(ت)

    ناپایا ب۳ := اس کیو ال.بررسی("SELECT شناسه، نام FROM کاربران"، فهرست)
    سرچاپ "ویرگول فارسی:"، ب۳.موارد.بگیر(۰).کد
    سرچاپ اس کیو ال.متن عیب(ب۳.موارد.بگیر(۰))
    اس کیو ال.آزادسازی گزارش(ب۳)

    ناپایا ب۴ := اس کیو ال.بررسی("SELECT نام FROM کاربران WHERE شناسه = ۵"، فهرست)
    سرچاپ "رقم فارسی:"، ب۴.موارد.بگیر(۰).کد
    اس کیو ال.آزادسازی گزارش(ب۴)

    اس کیو ال.آزادسازی فهرست(فهرست)
پایان
