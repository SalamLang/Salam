واردسازی رشته
واردسازی دیتابیس.اس کیو ال

فراخوانی ا "_harness.salam"

تابع سرآیندها(منبع: رشته):
    ناپایا ن := اس کیو ال.گزارش {}
    ناپایا پرسمان ها := اس کیو ال.خواندن پرسمان ها(منبع، ن)
    سرچاپ "خوانده شد: " + رشته.از عدد(پرسمان ها.طول() برگردان صحیح۶۴)
    ناپایا ای := ۰
    تا ای < پرسمان ها.طول():
        پ := پرسمان ها.بگیر(ای)
        سرچاپ "  " + پ.نام + " kind=" + رشته.از عدد(پ.نوع برگردان صحیح۶۴) + " sql=" + پ.متن
        ای = ای + ۱
    پایان
    ا.نمایش("(headers)"، ن)
    اس کیو ال.آزادسازی پرسمان ها(پرسمان ها)
    اس کیو ال.آزادسازی گزارش(ن)
پایان

تابع تولید(منبع: رشته، ف: اس کیو ال.فهرست جداول):
    ناپایا ن := اس کیو ال.گزارش {}
    ناپایا پرسمان ها := اس کیو ال.خواندن پرسمان ها(منبع، ن)
    کد := اس کیو ال.تولید کد("store"، پرسمان ها، ف، ن)
    اگر ن.خطاها > ۰:
        ا.نمایش("(generate)"، ن)
    وگرنه:
        چاپ کد
    پایان
    اس کیو ال.آزادسازی پرسمان ها(پرسمان ها)
    اس کیو ال.آزادسازی گزارش(ن)
پایان

تابع ریشه:
    لایت := اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت)
    ناپایا ف := ا.طرح("""
        CREATE TABLE users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT NOT NULL,
            name TEXT,
            age INTEGER
        );
    """، لایت)

    سرچاپ "-- خواندن سرآیندها"
    سرآیندها("""
-- name: GetUser :one
SELECT id, email FROM users WHERE id = ?;

-- name: ListUsers :many
SELECT id FROM users;

-- name: AddUser :exec
INSERT INTO users (email) VALUES (?);

-- name: DropOld :execrows
DELETE FROM users WHERE age < ?;
""")

    سرچاپ ""
    سرچاپ "-- سرآیندهایی که پذیرفته نمی شوند"
    سرآیندها("-- name: GetUser\nSELECT 1;\n")
    سرآیندها("-- name: GetUser :maybe\nSELECT 1;\n")
    سرآیندها("-- name: switch :one\nSELECT 1;\n")
    سرآیندها("-- name: 9lives :one\nSELECT 1;\n")

    سرچاپ ""
    سرچاپ "-- کد تولیدشده"
    تولید("""
-- name: GetUser :one
SELECT id, email, name, age FROM users WHERE email = ?;

-- name: AddUser :exec
INSERT INTO users (email, name) VALUES (?, ?);

-- name: TouchUser :execrows
UPDATE users SET name = ? WHERE id = ?;
"""، ف)

    سرچاپ ""
    سرچاپ "-- پرسمانی که طرح نمی پذیرد"
    تولید("""
-- name: Broken :one
SELECT id, nope FROM users WHERE id = ?;
"""، ف)

    اس کیو ال.آزادسازی فهرست(ف)
    برگشت ۰
پایان
