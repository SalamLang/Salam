-- رشته ها و نام هایی که پذیرفته می شوند
ok   SELECT 'plain', 'it''s here' FROM t
ok   SELECT "quoted name" FROM "odd table"
ok   SELECT `back` FROM `ticked`
ok   SELECT [bracketed] FROM [t]
ok   SELECT $tag$ body with 'quotes' $tag$ FROM t
ok   SELECT x'4142' FROM t
ok   SELECT 1, 2.5, 0xFF, 1e9, .5 FROM t
ok   SELECT a /* inline */ , b -- tail FROM t
ok   SELECT a FROM t # mysql comment

-- جانگهدارها
شمار: 2
شمار با رشته: 0
نشانه ها: $1 $2
ok   SELECT a FROM t WHERE b = ? AND c = ?3
ok   SELECT a FROM t WHERE b = :name AND c = @other
ok   SELECT a FROM t WHERE b = $1

-- خطاهای واکافتی
bad  SELECT 'unterminated FROM t
     SQL001 1:8 unterminated string literal
       help: close it with a matching quote
bad  SELECT $tag$ never closed FROM t
     SQL001 1:8 unterminated dollar-quoted string
       help: close it with the same $tag$ it opened with
bad  SELECT /* never closed FROM t
     SQL002 1:8 unterminated block comment
       help: close the comment with */
     SQL105 1:30 expected a value, found the end of the statement
       help: a column name, a literal, a function call or a placeholder goes here
bad  SELECT "never closed FROM t
     SQL003 1:8 unterminated quoted name
       help: close the name with a matching quote
bad  SELECT a FROM t WHERE b = 1 \ 2
     SQL004 1:29 unexpected character in SQL
       help: remove it or quote it as part of a literal
     SQL115 1:31 unexpected '2' after the statement
       help: a statement ends at a ';'
bad  SELECT `back` FROM t
     SQL204 1:8 backtick names are not supported by postgres
       help: quote the name with " instead
     SQL204 1:13 backtick names are not supported by postgres
       help: quote the name with " instead

-- نقطه گذاری فارسی که در SQL جا ندارد
bad  SELECT a، b FROM t
     SQL005 1:9 an Arabic comma '،' is not SQL punctuation
       help: write ',' instead
bad  SELECT a FROM t WHERE b = ۵
     SQL007 1:27 numbers in SQL have to be written with ASCII digits
       help: write 0 to 9 instead of the Persian or Arabic digits
bad  SELECT a FROM t WHERE b = ‘x’
     SQL008 1:27 this text is quoted with typographic quotes
       help: SQL strings are quoted with ' ... '
bad  SELECT a FROM t WHERE b = «x»
     SQL008 1:27 this text is quoted with typographic quotes
       help: SQL strings are quoted with ' ... '
bad  SELECT a FROM t WHERE b ؛ 1
     SQL005 1:25 an Arabic semicolon '؛' is not SQL punctuation
       help: write ';' instead
bad  SELECT a FROM t WHERE b ؟ 1
     SQL005 1:25 an Arabic question mark '؟' is not SQL punctuation
       help: write '?' instead
     SQL214 1:25 this operator is postgres only
       help: sqlite and mysql have no operator spelled like this

-- جانگهدار در گویش نادرست
bad  SELECT a FROM t WHERE b = ?
     SQL201 1:27 '?' is not a placeholder in postgres
       help: postgres numbers its placeholders: $1, $2
bad  SELECT a FROM t WHERE b = $1
     SQL202 1:27 '$1' is not a placeholder in sqlite
       help: this driver binds by position with ?
bad  SELECT a FROM t WHERE b = :name
     SQL203 1:27 named placeholders are not supported by postgres
       help: bind by position instead

-- ویژه ی هر موتور
ok   CREATE TABLE t (id INTEGER PRIMARY KEY AUTOINCREMENT)
ok   CREATE TABLE t (id INT AUTO_INCREMENT PRIMARY KEY)
bad  CREATE TABLE t (id INT AUTO_INCREMENT)
     SQL211 1:24 AUTO_INCREMENT is a mysql keyword
       help: sqlite spells it AUTOINCREMENT
bad  CREATE TABLE t (id INT AUTOINCREMENT)
     SQL211 1:24 AUTOINCREMENT is sqlite only
       help: postgres has no auto-increment keyword: use GENERATED ALWAYS AS IDENTITY, or the SERIAL types
ok   INSERT INTO t (a) VALUES (1) ON DUPLICATE KEY UPDATE a = 1
bad  INSERT INTO t (a) VALUES (1) ON DUPLICATE KEY UPDATE a = 1
     SQL210 1:30 ON DUPLICATE KEY UPDATE is mysql only
       help: sqlite and postgres write ON CONFLICT (col) DO UPDATE SET ...
bad  INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING
     SQL209 1:30 ON CONFLICT is not supported by mysql
       help: mysql writes ON DUPLICATE KEY UPDATE
ok   SELECT a FROM t WHERE b ILIKE 'x'
bad  SELECT a FROM t WHERE b ILIKE 'x'
     SQL205 1:25 ILIKE is postgres only
       help: use LOWER(x) LIKE LOWER(y), or LIKE on a case-insensitive column
ok   SELECT a::text FROM t
bad  SELECT a::text FROM t
     SQL206 1:9 '::' casts are postgres only
       help: write CAST(x AS type) instead
ok   SELECT a FROM t LIMIT 5, 10
bad  SELECT a FROM t LIMIT 5, 10
     SQL207 1:23 LIMIT a, b is not supported by postgres
       help: write LIMIT count OFFSET start instead
bad  DELETE FROM t WHERE a = 1 RETURNING a
     SQL208 1:27 RETURNING is not supported by mysql
       help: read the row back with a second query, or use LAST_INSERT_ID()
bad  TRUNCATE TABLE t
     SQL212 1:1 sqlite has no TRUNCATE statement
       help: write DELETE FROM the_table instead
bad  PRAGMA foreign_keys = ON
     SQL213 1:1 PRAGMA is sqlite only
       help: postgres configures the session with SET
ok   SELECT data #> '{a}' FROM t
bad  SELECT data #> '{a}' FROM t
     SQL214 1:13 this json operator is postgres only
       help: sqlite and mysql reach into json with the json_extract family
