واردسازی رشته
واردسازی دیتابیس.اس کیو ال

فراخوانی ا "_harness.salam"

تابع ریشه:
    لایت := اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت)
    مای := اس کیو ال.گویش شماره(اس کیو ال.مای اس کیو ال)
    پست := اس کیو ال.گویش شماره(اس کیو ال.پستگرس)

    سرچاپ "-- رشته ها و نام هایی که پذیرفته می شوند"
    ا.بازبینی("SELECT 'plain', 'it''s here' FROM t"، لایت)
    ا.بازبینی("SELECT \"quoted name\" FROM \"odd table\""، لایت)
    ا.بازبینی("SELECT `back` FROM `ticked`"، مای)
    ا.بازبینی("SELECT [bracketed] FROM [t]"، لایت)
    ا.بازبینی("SELECT $tag$ body with 'quotes' $tag$ FROM t"، پست)
    ا.بازبینی("SELECT x'4142' FROM t"، لایت)
    ا.بازبینی("SELECT 1, 2.5, 0xFF, 1e9, .5 FROM t"، لایت)
    ا.بازبینی("SELECT a /* inline */ , b -- tail\n FROM t"، لایت)
    ا.بازبینی("SELECT a FROM t # mysql comment"، مای)

    سرچاپ ""
    سرچاپ "-- جانگهدارها"
    سرچاپ "شمار: " + رشته.از عدد(اس کیو ال.شمار پارامتر("SELECT a FROM t WHERE b = ? AND c = ?"، لایت) برگردان صحیح۶۴)
    سرچاپ "شمار با رشته: " + رشته.از عدد(اس کیو ال.شمار پارامتر("SELECT a FROM t WHERE b = '?'"، لایت) برگردان صحیح۶۴)
    ناپایا نشانه ها := اس کیو ال.جانگهدارها("SELECT a FROM t WHERE b = $1 AND c = $2"، پست)
    سرچاپ "نشانه ها: " + نشانه ها.بگیر(۰) + " " + نشانه ها.بگیر(۱)
    نشانه ها.آزادکن()
    ا.بازبینی("SELECT a FROM t WHERE b = ? AND c = ?3"، لایت)
    ا.بازبینی("SELECT a FROM t WHERE b = :name AND c = @other"، لایت)
    ا.بازبینی("SELECT a FROM t WHERE b = $1"، پست)

    سرچاپ ""
    سرچاپ "-- خطاهای واکافتی"
    ا.بازبینی("SELECT 'unterminated FROM t"، لایت)
    ا.بازبینی("SELECT $tag$ never closed FROM t"، پست)
    ا.بازبینی("SELECT /* never closed FROM t"، لایت)
    ا.بازبینی("SELECT \"never closed FROM t"، لایت)
    ا.بازبینی("SELECT a FROM t WHERE b = 1 \\ 2"، لایت)
    ا.بازبینی("SELECT `back` FROM t"، پست)

    سرچاپ ""
    سرچاپ "-- نقطه گذاری فارسی که در SQL جا ندارد"
    ا.بازبینی("SELECT a، b FROM t"، لایت)
    ا.بازبینی("SELECT a FROM t WHERE b = ۵"، لایت)
    ا.بازبینی("SELECT a FROM t WHERE b = ‘x’"، لایت)
    ا.بازبینی("SELECT a FROM t WHERE b = «x»"، لایت)
    ا.بازبینی("SELECT a FROM t WHERE b ؛ 1"، لایت)
    ا.بازبینی("SELECT a FROM t WHERE b ؟ 1"، لایت)

    سرچاپ ""
    سرچاپ "-- جانگهدار در گویش نادرست"
    ا.بازبینی("SELECT a FROM t WHERE b = ?"، پست)
    ا.بازبینی("SELECT a FROM t WHERE b = $1"، لایت)
    ا.بازبینی("SELECT a FROM t WHERE b = :name"، پست)

    سرچاپ ""
    سرچاپ "-- ویژه ی هر موتور"
    ا.بازبینی("CREATE TABLE t (id INTEGER PRIMARY KEY AUTOINCREMENT)"، لایت)
    ا.بازبینی("CREATE TABLE t (id INT AUTO_INCREMENT PRIMARY KEY)"، مای)
    ا.بازبینی("CREATE TABLE t (id INT AUTO_INCREMENT)"، لایت)
    ا.بازبینی("CREATE TABLE t (id INT AUTOINCREMENT)"، پست)
    ا.بازبینی("INSERT INTO t (a) VALUES (1) ON DUPLICATE KEY UPDATE a = 1"، مای)
    ا.بازبینی("INSERT INTO t (a) VALUES (1) ON DUPLICATE KEY UPDATE a = 1"، لایت)
    ا.بازبینی("INSERT INTO t (a) VALUES (1) ON CONFLICT (a) DO NOTHING"، مای)
    ا.بازبینی("SELECT a FROM t WHERE b ILIKE 'x'"، پست)
    ا.بازبینی("SELECT a FROM t WHERE b ILIKE 'x'"، لایت)
    ا.بازبینی("SELECT a::text FROM t"، پست)
    ا.بازبینی("SELECT a::text FROM t"، لایت)
    ا.بازبینی("SELECT a FROM t LIMIT 5, 10"، مای)
    ا.بازبینی("SELECT a FROM t LIMIT 5, 10"، پست)
    ا.بازبینی("DELETE FROM t WHERE a = 1 RETURNING a"، مای)
    ا.بازبینی("TRUNCATE TABLE t"، لایت)
    ا.بازبینی("PRAGMA foreign_keys = ON"، پست)
    ا.بازبینی("SELECT data #> '{a}' FROM t"، پست)
    ا.بازبینی("SELECT data #> '{a}' FROM t"، لایت)
    برگشت ۰
پایان
