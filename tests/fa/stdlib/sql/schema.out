-- طرح با نام های فارسی
table کاربران: شناسه:int/k!da رایانامه:text/! نام:text سن:int
table سفارشات: شناسه:int/k!da شناسه_کاربر:int/! جمع:float/! یادداشت:text
table پرداخت_کرده: شناسه:unknown رایانامه:unknown
table سفارش ها: شناسه:int/k!da مبلغ:float/!
شمار جدول: 4
جدول کاربران: هست
ستون رایانامه: هست
ستون ناموجود: نیست
نوع شناسه: int / i64

-- پرسمان هایی که می خوانند
ok   SELECT شناسه, رایانامه FROM کاربران WHERE شناسه = ?
ok   SELECT * FROM کاربران
ok   SELECT ک.رایانامه, س.جمع FROM کاربران ک JOIN سفارشات س ON س.شناسه_کاربر = ک.شناسه
ok   SELECT شناسه, رایانامه FROM پرداخت_کرده
ok   INSERT INTO کاربران (رایانامه, نام) VALUES (?, ?)
ok   UPDATE کاربران SET نام = ? WHERE شناسه = ?
ok   DELETE FROM سفارشات WHERE شناسه_کاربر = ?

-- پرسمان هایی که نمی خوانند
bad  SELECT شناسه FROM کاربر
     SQL317 1:24 no table named "کاربر"
bad  SELECT شناسه, رایانام FROM کاربران
     SQL311 1:20 no column named "رایانام" in this statement
       help: did you mean "رایانامه"?
bad  SELECT س.نبود FROM سفارشات س
     SQL311 1:11 "س" has no column "نبود"
bad  SELECT ب.شناسه FROM کاربران ک
     SQL310 1:8 no table or alias named "ب" in this statement
       help: did you mean "ک"?
bad  SELECT شناسه FROM کاربران ک JOIN سفارشات س ON س.شناسه_کاربر = ک.شناسه
     SQL312 1:8 column "شناسه" is in more than one table here
       help: qualify it, as in ک.شناسه
bad  INSERT INTO کاربران (رایانامه, نام) VALUES (?)
     SQL314 1:62 this row has 1 values but 2 columns are expected
       help: the column list names 2 columns
bad  INSERT INTO کاربران (نام) VALUES (?)
     SQL315 1:1 "رایانامه" is NOT NULL with no default and this INSERT leaves it out
       help: add it to the column list and to every row
bad  INSERT INTO کاربران (رایانامه, رایانامه) VALUES (?, ?)
     SQL316 1:47 column "رایانامه" is listed twice
bad  UPDATE کاربران SET نبود = ? WHERE شناسه = ?
     SQL311 1:27 "کاربران" has no column "نبود"
bad  DELETE FROM کاربران
     SQL320 1:1 this DELETE has no WHERE clause and removes every row
       help: add a WHERE clause, or use TRUNCATE when that is what you mean
bad  UPDATE کاربران SET نام = ?
     SQL320 1:1 this UPDATE has no WHERE clause and changes every row
       help: add a WHERE clause, or say so in a comment
bad  SELECT شناسه FROM کاربران UNION SELECT شناسه, جمع FROM سفارشات
     SQL323 1:39 the two sides of this set operation return 1 and 2 columns
       help: both sides have to return the same number of columns
bad  DROP TABLE نبود
     SQL317 1:12 no table named "نبود"
bad  CREATE INDEX فهرست یک ON کاربران (رایانام)
     SQL101 1:25 expected ON after the index name, found 'یک'

-- نام چندواژه ای در SQL: بدون گیومه به ستون و نام جایگزین می شکند
ok   SELECT شناسه FROM "سفارش ها"
bad  SELECT شناسه FROM سفارش ها
     SQL317 1:24 no table named "سفارش"
bad  SELECT "نام خانوادگی" FROM کاربران
     SQL311 1:8 no column named "نام خانوادگی" in this statement
ok   SELECT نام خانوادگی FROM کاربران
query SELECT نام خانوادگی FROM کاربران
  select on کاربران
  out 0 خانوادگی option.Option<str>

-- ویرگول فارسی داخل SQL
bad  SELECT شناسه، رایانامه FROM کاربران
     SQL005 1:18 an Arabic comma '،' is not SQL punctuation
       help: write ',' instead
bad  SELECT نام FROM کاربران WHERE شناسه = ۵
     SQL007 1:54 numbers in SQL have to be written with ASCII digits
       help: write 0 to 9 instead of the Persian or Arabic digits

-- کلیدهایی که خودشان پر می شوند
table یک: شناسه:int/k!da مقدار:text/!
table دو: شناسه:int/k! مقدار:text/!
table سه: نشانه:text/k! مقدار:text/!
ok   INSERT INTO یک (مقدار) VALUES (?)
bad  INSERT INTO دو (مقدار) VALUES (?)
     SQL335 1:1 "شناسه" is the primary key and this INSERT leaves it out
       help: sqlite stores NULL there unless the column is declared INTEGER PRIMARY KEY
bad  INSERT INTO سه (مقدار) VALUES (?)
     SQL335 1:1 "نشانه" is the primary key and this INSERT leaves it out
       help: sqlite stores NULL there unless the column is declared INTEGER PRIMARY KEY
DDL PROBLEM
bad  CREATE TABLE یادداشت ها (شناسه BIGSERIAL PRIMARY KEY, متن TEXT NOT NULL)
     SQL101 1:29 expected '(' before the column definitions, found 'ها'
bad  INSERT INTO یادداشت ها (متن) VALUES ($1)
     SQL109 1:28 expected VALUES, SELECT or DEFAULT VALUES, found 'ها'

-- تغییر ساختار، به ترتیب
table ج۲: پ:text ت:int ث:int
ok   SELECT پ, ت, ث FROM ج۲
bad  SELECT الف FROM ج۲
     SQL311 1:8 no column named "الف" in this statement

-- ساختارهایی که فهرست نمی پذیرد
bad  ALTER TABLE نبود ADD COLUMN ایکس INT
     SQL303 1:13 no table named "نبود"
       help: the schema has no such table
bad  ALTER TABLE ج۲ DROP COLUMN نبود
     SQL304 1:30 no column named "نبود"
bad  ALTER TABLE ج۲ ADD COLUMN پ TEXT
     SQL302 1:29 column "پ" is declared twice
bad  CREATE TABLE ج۲ (الف INT)
     SQL301 1:14 table "ج۲" is declared twice
       help: drop the earlier declaration, or add IF NOT EXISTS
ok   CREATE TABLE IF NOT EXISTS ج۲ (الف INT)
bad  DROP TABLE نبود
     SQL303 1:12 no table named "نبود"
       help: add IF EXISTS when the table may not be there
ok   DROP TABLE IF EXISTS نبود
bad  CREATE TABLE تکراری (الف INT, الف TEXT)
     SQL302 1:40 column "الف" is declared twice
