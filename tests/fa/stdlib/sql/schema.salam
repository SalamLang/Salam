واردسازی رشته
واردسازی دیتابیس.اس کیو ال

فراخوانی ا "_harness.salam"

پایا طرح_پایه := """
    CREATE TABLE کاربران (
        شناسه INTEGER PRIMARY KEY AUTOINCREMENT,
        رایانامه TEXT NOT NULL,
        نام TEXT,
        سن INTEGER
    );
    CREATE TABLE سفارشات (
        شناسه INTEGER PRIMARY KEY,
        شناسه_کاربر INTEGER NOT NULL,
        جمع REAL NOT NULL,
        یادداشت TEXT
    );
    CREATE VIEW پرداخت_کرده AS SELECT شناسه, رایانامه FROM کاربران;
    CREATE TABLE "سفارش ها" (شناسه INTEGER PRIMARY KEY, مبلغ REAL NOT NULL);
"""

تابع گزارش طرح(ف &: اس کیو ال.فهرست جداول، دستور: رشته):
    ناپایا ن := اس کیو ال.اعمال(ف، دستور)
    ا.نمایش(دستور، ن)
    اس کیو ال.آزادسازی گزارش(ن)
پایان

تابع ریشه:
    لایت := اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت)
    مای := اس کیو ال.گویش شماره(اس کیو ال.مای اس کیو ال)
    پست := اس کیو ال.گویش شماره(اس کیو ال.پستگرس)

    سرچاپ "-- طرح با نام های فارسی"
    ناپایا ف := ا.طرح(طرح_پایه، لایت)
    ا.جدول ها(ف)
    سرچاپ "شمار جدول: " + رشته.از عدد(اس کیو ال.شمار جدول(ف) برگردان صحیح۶۴)
    سرچاپ "جدول کاربران: " + (اس کیو ال.جدول دارد(ف، "کاربران") ? "هست" : "نیست")
    سرچاپ "ستون رایانامه: " + (اس کیو ال.ستون دارد(ف، "کاربران"، "رایانامه") ? "هست" : "نیست")
    سرچاپ "ستون ناموجود: " + (اس کیو ال.ستون دارد(ف، "کاربران"، "نبود") ? "هست" : "نیست")
    ستون یک := اس کیو ال.ستون شماره(ف، "کاربران"، ۰)
    سرچاپ "نوع شناسه: " + اس کیو ال.نام نوع(ستون یک.نوع) + " / " + اس کیو ال.گونه سلام(ستون یک.نوع، ستون یک.تهی‌ناپذیر)

    سرچاپ ""
    سرچاپ "-- پرسمان هایی که می خوانند"
    ا.بررسی("SELECT شناسه, رایانامه FROM کاربران WHERE شناسه = ?"، ف)
    ا.بررسی("SELECT * FROM کاربران"، ف)
    ا.بررسی("SELECT ک.رایانامه, س.جمع FROM کاربران ک JOIN سفارشات س ON س.شناسه_کاربر = ک.شناسه"، ف)
    ا.بررسی("SELECT شناسه, رایانامه FROM پرداخت_کرده"، ف)
    ا.بررسی("INSERT INTO کاربران (رایانامه, نام) VALUES (?, ?)"، ف)
    ا.بررسی("UPDATE کاربران SET نام = ? WHERE شناسه = ?"، ف)
    ا.بررسی("DELETE FROM سفارشات WHERE شناسه_کاربر = ?"، ف)

    سرچاپ ""
    سرچاپ "-- پرسمان هایی که نمی خوانند"
    ا.بررسی("SELECT شناسه FROM کاربر"، ف)
    ا.بررسی("SELECT شناسه, رایانام FROM کاربران"، ف)
    ا.بررسی("SELECT س.نبود FROM سفارشات س"، ف)
    ا.بررسی("SELECT ب.شناسه FROM کاربران ک"، ف)
    ا.بررسی("SELECT شناسه FROM کاربران ک JOIN سفارشات س ON س.شناسه_کاربر = ک.شناسه"، ف)
    ا.بررسی("INSERT INTO کاربران (رایانامه, نام) VALUES (?)"، ف)
    ا.بررسی("INSERT INTO کاربران (نام) VALUES (?)"، ف)
    ا.بررسی("INSERT INTO کاربران (رایانامه, رایانامه) VALUES (?, ?)"، ف)
    ا.بررسی("UPDATE کاربران SET نبود = ? WHERE شناسه = ?"، ف)
    ا.بررسی("DELETE FROM کاربران"، ف)
    ا.بررسی("UPDATE کاربران SET نام = ?"، ف)
    ا.بررسی("SELECT شناسه FROM کاربران UNION SELECT شناسه, جمع FROM سفارشات"، ف)
    ا.بررسی("DROP TABLE نبود"، ف)
    ا.بررسی("CREATE INDEX فهرست یک ON کاربران (رایانام)"، ف)

    سرچاپ ""
    سرچاپ "-- نام چندواژه ای در SQL: بدون گیومه به ستون و نام جایگزین می شکند"
    ا.بررسی("SELECT شناسه FROM \"سفارش ها\""، ف)
    ا.بررسی("SELECT شناسه FROM سفارش ها"، ف)
    ا.بررسی("SELECT \"نام خانوادگی\" FROM کاربران"، ف)
    ا.بررسی("SELECT نام خانوادگی FROM کاربران"، ف)
    ا.شرح("SELECT نام خانوادگی FROM کاربران"، ف)

    سرچاپ ""
    سرچاپ "-- ویرگول فارسی داخل SQL"
    ا.بررسی("SELECT شناسه، رایانامه FROM کاربران"، ف)
    ا.بررسی("SELECT نام FROM کاربران WHERE شناسه = ۵"، ف)
    اس کیو ال.آزادسازی فهرست(ف)

    سرچاپ ""
    سرچاپ "-- کلیدهایی که خودشان پر می شوند"
    ناپایا ف۲ := ا.طرح("""
        CREATE TABLE یک (شناسه INTEGER PRIMARY KEY, مقدار TEXT NOT NULL);
        CREATE TABLE دو (شناسه INT PRIMARY KEY, مقدار TEXT NOT NULL);
        CREATE TABLE سه (نشانه TEXT PRIMARY KEY, مقدار TEXT NOT NULL);
    """، لایت)
    ا.جدول ها(ف۲)
    ا.بررسی("INSERT INTO یک (مقدار) VALUES (?)"، ف۲)
    ا.بررسی("INSERT INTO دو (مقدار) VALUES (?)"، ف۲)
    ا.بررسی("INSERT INTO سه (مقدار) VALUES (?)"، ف۲)
    اس کیو ال.آزادسازی فهرست(ف۲)

    ناپایا ف۳ := ا.طرح("CREATE TABLE یادداشت ها (شناسه BIGSERIAL PRIMARY KEY, متن TEXT NOT NULL)"، پست)
    ا.جدول ها(ف۳)
    ا.بررسی("INSERT INTO یادداشت ها (متن) VALUES ($1)"، ف۳)
    اس کیو ال.آزادسازی فهرست(ف۳)

    سرچاپ ""
    سرچاپ "-- تغییر ساختار، به ترتیب"
    ناپایا ف۴ := ا.طرح("""
        CREATE TABLE ج (الف INT NOT NULL, ب VARCHAR(10)) ENGINE=InnoDB;
        ALTER TABLE ج MODIFY COLUMN ب VARCHAR(50) NOT NULL;
        ALTER TABLE ج CHANGE ب پ TEXT;
        ALTER TABLE ج ADD COLUMN IF NOT EXISTS ت INT;
        ALTER TABLE ج DROP COLUMN الف, ADD COLUMN ث INT;
        ALTER TABLE ج RENAME TO ج۲;
    """، مای)
    ا.جدول ها(ف۴)
    ا.بررسی("SELECT پ, ت, ث FROM ج۲"، ف۴)
    ا.بررسی("SELECT الف FROM ج۲"، ف۴)

    سرچاپ ""
    سرچاپ "-- ساختارهایی که فهرست نمی پذیرد"
    گزارش طرح(ف۴، "ALTER TABLE نبود ADD COLUMN ایکس INT")
    گزارش طرح(ف۴، "ALTER TABLE ج۲ DROP COLUMN نبود")
    گزارش طرح(ف۴، "ALTER TABLE ج۲ ADD COLUMN پ TEXT")
    گزارش طرح(ف۴، "CREATE TABLE ج۲ (الف INT)")
    گزارش طرح(ف۴، "CREATE TABLE IF NOT EXISTS ج۲ (الف INT)")
    گزارش طرح(ف۴، "DROP TABLE نبود")
    گزارش طرح(ف۴، "DROP TABLE IF EXISTS نبود")
    گزارش طرح(ف۴، "CREATE TABLE تکراری (الف INT, الف TEXT)")
    اس کیو ال.آزادسازی فهرست(ف۴)
    برگشت ۰
پایان
