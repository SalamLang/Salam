بسته ریشه

واردسازی اس اس اچ
واردسازی حافظه
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی سیستم پرونده.پوشه
واردسازی آزمایش

تابع بایت موقعیت(p: تهی*، i: صحیح): صحیح:
    نشانگر بایت := p برگردان طبیعی۸*
    برگشت نشانگر بایت[i] برگردان صحیح
پایان

تابع بایت شانزدهی(v: صحیح): رشته:
    ارقام := "0123456789abcdef"
    برگشت ارقام.زیررشته(v / 16، 1) + ارقام.زیررشته(v % 16، 1)
پایان

تابع رشته شانزدهی(p: تهی*، n: صحیح): رشته:
    ناپایا خروجی := ""
    تکرار n در i:
        خروجی += بایت شانزدهی(بایت موقعیت(p، i))
    پایان
    برگشت خروجی
پایان

تابع test_writers():
    ناپایا b := اس اس اچ.بافر جدید(8)
    آزمایش.ادعای برابری عدد(b.len، 0)
    اس اس اچ.افزودن بایت(b، 0xab)
    اس اس اچ.افزودن بولی(b، درست)
    اس اس اچ.افزودن بولی(b، نادرست)
    اس اس اچ.افزودن یو۳۲(b، 0x01020304 برگردان طبیعی۳۲)
    اس اس اچ.افزودن یو۶۴(b، 0x0102030405060708 برگردان طبیعی۶۴)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(b.p، b.len)، "ab" + "01" + "00" + "01020304" + "0102030405060708")
    اس اس اچ.افزودن صفرها(b، 3)
    آزمایش.ادعای برابری عدد(b.len، 18)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(b.p، b.len).زیررشته(30، 6)، "000000")
    اس اس اچ.پاک سازی بافر(b)
    آزمایش.ادعای برابری عدد(b.len، 0)
    آزمایش.ادعای درستی(b.p برابر پوچ)

    ناپایا بافر خام := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بایت ها(بافر خام، "xyz" برگردان تهی*، 3)
    ناپایا بافر کپی := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بافر(بافر کپی، بافر خام)
    اس اس اچ.افزودن بافر(بافر کپی، بافر خام)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(بافر کپی.p، بافر کپی.len)، "78797a78797a")
    اس اس اچ.آزادسازی بافر(بافر کپی)
    آزمایش.ادعای برابری عدد(بافر کپی.len، 0)

    ناپایا s := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن رشته(s، "hi" برگردان تهی*، 2)
    اس اس اچ.افزودن رشته بافر(s، بافر خام)
    اس اس اچ.افزودن رشته متن(s، "ssh")
    آزمایش.ادعای برابری رشته(رشته شانزدهی(s.p، s.len)، "000000026869" + "00000003" + "78797a" + "00000003" + "737368")
    اس اس اچ.آزادسازی بافر(s)
    اس اس اچ.آزادسازی بافر(بافر خام)
پایان

تابع test_mpint():
    ناپایا m := اس اس اچ.بافر جدید(8)
    حافظه ساده := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(حافظه ساده)
    نشانگر ساده := حافظه ساده برگردان طبیعی۸*
    نشانگر ساده[0] = 0 برگردان طبیعی۸
    نشانگر ساده[1] = 0 برگردان طبیعی۸
    نشانگر ساده[2] = 0x7f برگردان طبیعی۸
    نشانگر ساده[3] = 0x01 برگردان طبیعی۸
    اس اس اچ.افزودن ام پی اینت(m، حافظه ساده، 4)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(m.p، m.len)، "000000027f01")
    نشانگر ساده[2] = 0x80 برگردان طبیعی۸
    اس اس اچ.افزودن ام پی اینت(m، حافظه ساده، 4)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(m.p، m.len)، "000000027f01" + "00000003" + "008001")
    ناپایا بافر صفر := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن ام پی اینت(بافر صفر، حافظه ساده، 0)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(بافر صفر.p، بافر صفر.len)، "00000000")
    ناپایا بافر مبدا := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بایت ها(بافر مبدا، حافظه ساده، 4)
    ناپایا بافر میانی := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن ام پی اینت بافر(بافر میانی، بافر مبدا)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(بافر میانی.p، بافر میانی.len)، "00000003" + "008001")

    ناپایا r := اس اس اچ.خواننده جدید(بافر میانی.p، بافر میانی.len)
    نما := اس اس اچ.خواندن ام پی اینت(r)
    آزمایش.ادعای برابری عدد(نما.len، 2)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(نما.p، نما.len)، "8001")
    ناپایا r2 := اس اس اچ.خواننده جدید(m.p، m.len)
    نخستین := اس اس اچ.کپی ام پی اینت(r2)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(نخستین.p، نخستین.len)، "7f01")
    دومین := اس اس اچ.کپی ام پی اینت(r2)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(دومین.p، دومین.len)، "8001")
    آزمایش.ادعای برابری عدد(اس اس اچ.باقی مانده(r2)، 0)
    اس اس اچ.آزادسازی بافر(m)
    اس اس اچ.آزادسازی بافر(بافر صفر)
    اس اس اچ.آزادسازی بافر(بافر مبدا)
    اس اس اچ.آزادسازی بافر(بافر میانی)
پایان

تابع test_readers():
    ناپایا w := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بایت(w، 9)
    اس اس اچ.افزودن بولی(w، درست)
    اس اس اچ.افزودن یو۳۲(w، 4000000000 برگردان طبیعی۳۲)
    اس اس اچ.افزودن یو۶۴(w، 5000000000 برگردان طبیعی۶۴)
    اس اس اچ.افزودن رشته متن(w، "alpha")
    اس اس اچ.افزودن رشته متن(w، "beta")
    اس اس اچ.افزودن رشته متن(w، "aes256-ctr,aes128-ctr")
    اس اس اچ.افزودن صفرها(w، 5)
    اس اس اچ.افزودن بایت(w، 1)
    ناپایا r := اس اس اچ.خواننده جدید(w.p، w.len)
    آزمایش.ادعای برابری عدد(اس اس اچ.باقی مانده(r)، w.len)
    آزمایش.ادعای برابری عدد(اس اس اچ.دریافت بایت(r)، 9)
    آزمایش.ادعای درستی(اس اس اچ.دریافت بولی(r))
    آزمایش.ادعای درستی(اس اس اچ.دریافت یو۳۲(r) برابر 4000000000 برگردان طبیعی۳۲)
    آزمایش.ادعای درستی(اس اس اچ.دریافت یو۶۴(r) برابر 5000000000 برگردان طبیعی۶۴)
    نما := اس اس اچ.دریافت نمای رشته(r)
    آزمایش.ادعای برابری عدد(نما.len، 5)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(نما.p، نما.len)، "616c706861")
    ناپایا بافر کپی := اس اس اچ.کپی رشته(r)
    آزمایش.ادعای برابری رشته(رشته شانزدهی(بافر کپی.p، بافر کپی.len)، "62657461")
    آزمایش.ادعای برابری رشته(اس اس اچ.دریافت لیست نام(r)، "aes256-ctr,aes128-ctr")
    اس اس اچ.رد شدن(r، 5)
    آزمایش.ادعای برابری عدد(اس اس اچ.باقی مانده(r)، 1)
    آزمایش.ادعای برابری عدد(اس اس اچ.دریافت بایت(r)، 1)
    آزمایش.ادعای برابری عدد(اس اس اچ.باقی مانده(r)، 0)
    آزمایش.ادعای نادرستی(r.bad)
    آزمایش.ادعای برابری عدد(اس اس اچ.دریافت بایت(r)، 0)
    آزمایش.ادعای درستی(r.bad)

    ناپایا خواننده دوباره := اس اس اچ.خواننده جدید(w.p، w.len)
    اس اس اچ.رد شدن(خواننده دوباره، 14)
    آزمایش.ادعای برابری رشته(اس اس اچ.دریافت رشته متن(خواننده دوباره)، "alpha")
    اس اس اچ.رد شدن(خواننده دوباره، 100000)
    آزمایش.ادعای درستی(خواننده دوباره.bad)
    اس اس اچ.آزادسازی بافر(بافر کپی)
    اس اس اچ.آزادسازی بافر(w)
پایان

تابع test_lists():
    آزمایش.ادعای درستی(اس اس اچ.شامل لیست نام("a,b,c"، "b"))
    آزمایش.ادعای نادرستی(اس اس اچ.شامل لیست نام("a,b,c"، "d"))
    آزمایش.ادعای نادرستی(اس اس اچ.شامل لیست نام(""، "a"))
    آزمایش.ادعای برابری رشته(اس اس اچ.توافق اولین تطابق("x,b,a"، "a,b")، "b")
    آزمایش.ادعای برابری رشته(اس اس اچ.توافق اولین تطابق("x"، "a,b")، "")
    حافظه یک := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(حافظه یک)
    حافظه دو := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(حافظه دو)
    حافظه.کپی(حافظه یک، "abcd" برگردان تهی*، 4 برگردان طبیعی۶۴)
    حافظه.کپی(حافظه دو، "abcd" برگردان تهی*، 4 برگردان طبیعی۶۴)
    آزمایش.ادعای درستی(اس اس اچ.برابری زمان ثابت(حافظه یک، حافظه دو، 4))
    حافظه.کپی(حافظه دو، "abce" برگردان تهی*، 4 برگردان طبیعی۶۴)
    آزمایش.ادعای نادرستی(اس اس اچ.برابری زمان ثابت(حافظه یک، حافظه دو، 4))
    آزمایش.ادعای درستی(اس اس اچ.برابری زمان ثابت(حافظه یک، حافظه دو، 3))
پایان

تابع test_stderr():
    ناپایا نشست := اس اس اچ.نشست {}
    نشست.کانال.stderr = اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بایت ها(نشست.کانال.stderr، "warn: one\n" برگردان تهی*، 10)
    آزمایش.ادعای برابری رشته(اس اس اچ.خروجی خطا(نشست)، "warn: one\n")
    آزمایش.ادعای برابری رشته(اس اس اچ.خروجی خطا(نشست)، "warn: one\n")
    آزمایش.ادعای برابری رشته(اس اس اچ.تخلیه خروجی خطا(نشست)، "warn: one\n")
    آزمایش.ادعای برابری رشته(اس اس اچ.خروجی خطا(نشست)، "")
    اس اس اچ.افزودن بایت ها(نشست.کانال.stderr، "warn: two\n" برگردان تهی*، 10)
    آزمایش.ادعای برابری رشته(اس اس اچ.تخلیه خروجی خطا(نشست)، "warn: two\n")
    آزمایش.ادعای برابری رشته(اس اس اچ.تخلیه خروجی خطا(نشست)، "")
    اس اس اچ.آزادسازی بافر(نشست.کانال.stderr)
پایان

تابع test_key_pem():
    ناپایا پیکربندی := اس اس اچ.پیکربندی جدید("host.example"، 22، "ali")
    آزمایش.ادعای نادرستی(پیکربندی.ورود با کلید)
    اس اس اچ.با متن کلید(پیکربندی، "-----BEGIN OPENSSH PRIVATE KEY-----\nabc\n-----END OPENSSH PRIVATE KEY-----\n")
    آزمایش.ادعای درستی(پیکربندی.ورود با کلید)
    آزمایش.ادعای نادرستی(پیکربندی.ورود با گذرواژه)
    آزمایش.ادعای درستی(پیکربندی.کلید خصوصی.بیاب("OPENSSH PRIVATE KEY") بزرگتر 0)
پایان

تابع test_unconnected_sftp():
    ناپایا مشتری := اس اس اچ.کارخواه {}
    ناپایا نشست اس اف تی پی := اس اس اچ.اس اف تی پی {}
    آزمایش.ادعای برابری رشته(اس اس اچ.وضعیت پیوند(مشتری، نشست اس اف تی پی، "/etc/passwd").نام، "")
    آزمایش.ادعای نادرستی(اس اس اچ.پیوند است(مشتری، نشست اس اف تی پی، "/etc/passwd"))
    مسیر محلی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_ssh_coverage_none")
    پوشه.حذف همه(مسیر محلی)
    آزمایش.ادعای نادرستی(اس اس اچ.دریافت پوشه(مشتری، نشست اس اف تی پی، "/remote"، مسیر محلی))
    آزمایش.ادعای نادرستی(سیستم عامل.پوشه است(مسیر محلی))
    آزمایش.ادعای نادرستی(اس اس اچ.ارسال پوشه(مشتری، نشست اس اف تی پی، مسیر محلی، "/remote"))
    پوشه.ساخت پوشه ها(مسیر محلی)
    آزمایش.ادعای نادرستی(اس اس اچ.ارسال پوشه(مشتری، نشست اس اف تی پی، مسیر محلی، "/remote"))
    پوشه.حذف همه(مسیر محلی)
پایان

تابع ریشه:
    test_writers()
    test_mpint()
    test_readers()
    test_lists()
    test_stderr()
    test_key_pem()
    test_unconnected_sftp()
    آزمایش.خلاصه()
    برگشت 0
پایان
