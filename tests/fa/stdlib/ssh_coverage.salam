بسته ریشه

واردسازی اس اس اچ
واردسازی حافظه
واردسازی سیستم عامل
واردسازی مسیر پرونده
واردسازی سیستم پرونده.پوشه
واردسازی آزمایش

تابع byte_at(p: تهی*، i: صحیح): صحیح:
    bp := p برگردان طبیعی۸*
    برگشت bp[i] برگردان صحیح
پایان

تابع hex_byte(v: صحیح): رشته:
    digits := "0123456789abcdef"
    برگشت digits.زیررشته(v / 16، 1) + digits.زیررشته(v % 16، 1)
پایان

تابع hex_of(p: تهی*، n: صحیح): رشته:
    ناپایا out := ""
    تکرار n در i:
        out += hex_byte(byte_at(p، i))
    پایان
    برگشت out
پایان

تابع test_writers():
    ناپایا b := اس اس اچ.بافر جدید(8)
    آزمایش.ادعای برابری عدد(b.len، 0)
    اس اس اچ.افزودن بایت(b، 0xab)
    اس اس اچ.افزودن بولی(b، درست)
    اس اس اچ.افزودن بولی(b، نادرست)
    اس اس اچ.افزودن یو۳۲(b، 0x01020304 برگردان طبیعی۳۲)
    اس اس اچ.افزودن یو۶۴(b، 0x0102030405060708 برگردان طبیعی۶۴)
    آزمایش.ادعای برابری رشته(hex_of(b.p، b.len)، "ab" + "01" + "00" + "01020304" + "0102030405060708")
    اس اس اچ.افزودن صفرها(b، 3)
    آزمایش.ادعای برابری عدد(b.len، 18)
    آزمایش.ادعای برابری رشته(hex_of(b.p، b.len).زیررشته(30، 6)، "000000")
    اس اس اچ.پاک سازی بافر(b)
    آزمایش.ادعای برابری عدد(b.len، 0)
    آزمایش.ادعای درستی(b.p برابر پوچ)

    ناپایا raw := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بایت ها(raw، "xyz" برگردان تهی*، 3)
    ناپایا copy := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بافر(copy، raw)
    اس اس اچ.افزودن بافر(copy، raw)
    آزمایش.ادعای برابری رشته(hex_of(copy.p، copy.len)، "78797a78797a")
    اس اس اچ.آزادسازی بافر(copy)
    آزمایش.ادعای برابری عدد(copy.len، 0)

    ناپایا s := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن رشته(s، "hi" برگردان تهی*، 2)
    اس اس اچ.افزودن رشته بافر(s، raw)
    اس اس اچ.افزودن رشته متن(s، "ssh")
    آزمایش.ادعای برابری رشته(hex_of(s.p، s.len)، "000000026869" + "00000003" + "78797a" + "00000003" + "737368")
    اس اس اچ.آزادسازی بافر(s)
    اس اس اچ.آزادسازی بافر(raw)
پایان

تابع test_mpint():
    ناپایا m := اس اس اچ.بافر جدید(8)
    plain := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(plain)
    pp := plain برگردان طبیعی۸*
    pp[0] = 0 برگردان طبیعی۸
    pp[1] = 0 برگردان طبیعی۸
    pp[2] = 0x7f برگردان طبیعی۸
    pp[3] = 0x01 برگردان طبیعی۸
    اس اس اچ.افزودن ام پی اینت(m، plain، 4)
    آزمایش.ادعای برابری رشته(hex_of(m.p، m.len)، "000000027f01")
    pp[2] = 0x80 برگردان طبیعی۸
    اس اس اچ.افزودن ام پی اینت(m، plain، 4)
    آزمایش.ادعای برابری رشته(hex_of(m.p، m.len)، "000000027f01" + "00000003" + "008001")
    ناپایا zero := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن ام پی اینت(zero، plain، 0)
    آزمایش.ادعای برابری رشته(hex_of(zero.p، zero.len)، "00000000")
    ناپایا src := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بایت ها(src، plain، 4)
    ناپایا viabuf := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن ام پی اینت بافر(viabuf، src)
    آزمایش.ادعای برابری رشته(hex_of(viabuf.p، viabuf.len)، "00000003" + "008001")

    ناپایا r := اس اس اچ.خواننده جدید(viabuf.p، viabuf.len)
    view := اس اس اچ.خواندن ام پی اینت(r)
    آزمایش.ادعای برابری عدد(view.len، 2)
    آزمایش.ادعای برابری رشته(hex_of(view.p، view.len)، "8001")
    ناپایا r2 := اس اس اچ.خواننده جدید(m.p، m.len)
    first := اس اس اچ.کپی ام پی اینت(r2)
    آزمایش.ادعای برابری رشته(hex_of(first.p، first.len)، "7f01")
    second := اس اس اچ.کپی ام پی اینت(r2)
    آزمایش.ادعای برابری رشته(hex_of(second.p، second.len)، "8001")
    آزمایش.ادعای برابری عدد(اس اس اچ.باقی مانده(r2)، 0)
    اس اس اچ.آزادسازی بافر(m)
    اس اس اچ.آزادسازی بافر(zero)
    اس اس اچ.آزادسازی بافر(src)
    اس اس اچ.آزادسازی بافر(viabuf)
پایان

تابع test_readers():
    ناپایا w := اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بایت(w، 9)
    اس اس اچ.افزودن بولی(w، درست)
    اس اس اچ.افزودن یو۳۲(w، 4000000000 برگردان طبیعی۳۲)
    اس اس اچ.افزودن یو۶۴(w، 5000000000 برگردان طبیعی۶۴)
    اس اس اچ.افزودن رشته متن(w، "alpha")
    اس اس اچ.افزودن رشته متن(w، "beta")
    اس اس اچ.افزودن رشته متن(w، "aes256-ctr,aes128-ctr")
    اس اس اچ.افزودن صفرها(w، 5)
    اس اس اچ.افزودن بایت(w، 1)
    ناپایا r := اس اس اچ.خواننده جدید(w.p، w.len)
    آزمایش.ادعای برابری عدد(اس اس اچ.باقی مانده(r)، w.len)
    آزمایش.ادعای برابری عدد(اس اس اچ.دریافت بایت(r)، 9)
    آزمایش.ادعای درستی(اس اس اچ.دریافت بولی(r))
    آزمایش.ادعای درستی(اس اس اچ.دریافت یو۳۲(r) برابر 4000000000 برگردان طبیعی۳۲)
    آزمایش.ادعای درستی(اس اس اچ.دریافت یو۶۴(r) برابر 5000000000 برگردان طبیعی۶۴)
    view := اس اس اچ.دریافت نمای رشته(r)
    آزمایش.ادعای برابری عدد(view.len، 5)
    آزمایش.ادعای برابری رشته(hex_of(view.p، view.len)، "616c706861")
    copy := اس اس اچ.کپی رشته(r)
    آزمایش.ادعای برابری رشته(hex_of(copy.p، copy.len)، "62657461")
    آزمایش.ادعای برابری رشته(اس اس اچ.دریافت لیست نام(r)، "aes256-ctr,aes128-ctr")
    اس اس اچ.رد شدن(r، 5)
    آزمایش.ادعای برابری عدد(اس اس اچ.باقی مانده(r)، 1)
    آزمایش.ادعای برابری عدد(اس اس اچ.دریافت بایت(r)، 1)
    آزمایش.ادعای برابری عدد(اس اس اچ.باقی مانده(r)، 0)
    آزمایش.ادعای نادرستی(r.bad)
    آزمایش.ادعای برابری عدد(اس اس اچ.دریافت بایت(r)، 0)
    آزمایش.ادعای درستی(r.bad)

    ناپایا again := اس اس اچ.خواننده جدید(w.p، w.len)
    اس اس اچ.رد شدن(again، 14)
    آزمایش.ادعای برابری رشته(اس اس اچ.دریافت رشته متن(again)، "alpha")
    اس اس اچ.رد شدن(again، 100000)
    آزمایش.ادعای درستی(again.bad)
    اس اس اچ.آزادسازی بافر(copy)
    اس اس اچ.آزادسازی بافر(w)
پایان

تابع test_lists():
    آزمایش.ادعای درستی(اس اس اچ.شامل لیست نام("a,b,c"، "b"))
    آزمایش.ادعای نادرستی(اس اس اچ.شامل لیست نام("a,b,c"، "d"))
    آزمایش.ادعای نادرستی(اس اس اچ.شامل لیست نام(""، "a"))
    آزمایش.ادعای برابری رشته(اس اس اچ.توافق اولین تطابق("x,b,a"، "a,b")، "b")
    آزمایش.ادعای برابری رشته(اس اس اچ.توافق اولین تطابق("x"، "a,b")، "")
    one := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(one)
    two := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(two)
    حافظه.کپی(one، "abcd" برگردان تهی*، 4 برگردان طبیعی۶۴)
    حافظه.کپی(two، "abcd" برگردان تهی*، 4 برگردان طبیعی۶۴)
    آزمایش.ادعای درستی(اس اس اچ.برابری زمان ثابت(one، two، 4))
    حافظه.کپی(two، "abce" برگردان تهی*، 4 برگردان طبیعی۶۴)
    آزمایش.ادعای نادرستی(اس اس اچ.برابری زمان ثابت(one، two، 4))
    آزمایش.ادعای درستی(اس اس اچ.برابری زمان ثابت(one، two، 3))
پایان

تابع test_stderr():
    ناپایا session := اس اس اچ.نشست {}
    session.کانال.stderr = اس اس اچ.بافر جدید(8)
    اس اس اچ.افزودن بایت ها(session.کانال.stderr، "warn: one\n" برگردان تهی*، 10)
    آزمایش.ادعای برابری رشته(اس اس اچ.خروجی خطا(session)، "warn: one\n")
    آزمایش.ادعای برابری رشته(اس اس اچ.خروجی خطا(session)، "warn: one\n")
    آزمایش.ادعای برابری رشته(اس اس اچ.تخلیه خروجی خطا(session)، "warn: one\n")
    آزمایش.ادعای برابری رشته(اس اس اچ.خروجی خطا(session)، "")
    اس اس اچ.افزودن بایت ها(session.کانال.stderr، "warn: two\n" برگردان تهی*، 10)
    آزمایش.ادعای برابری رشته(اس اس اچ.تخلیه خروجی خطا(session)، "warn: two\n")
    آزمایش.ادعای برابری رشته(اس اس اچ.تخلیه خروجی خطا(session)، "")
    اس اس اچ.آزادسازی بافر(session.کانال.stderr)
پایان

تابع test_key_pem():
    ناپایا cfg := اس اس اچ.پیکربندی جدید("host.example"، 22، "ali")
    آزمایش.ادعای نادرستی(cfg.ورود با کلید)
    اس اس اچ.با متن کلید(cfg، "-----BEGIN OPENSSH PRIVATE KEY-----\nabc\n-----END OPENSSH PRIVATE KEY-----\n")
    آزمایش.ادعای درستی(cfg.ورود با کلید)
    آزمایش.ادعای نادرستی(cfg.ورود با گذرواژه)
    آزمایش.ادعای درستی(cfg.کلید خصوصی.بیاب("OPENSSH PRIVATE KEY") بزرگتر 0)
پایان

تابع test_unconnected_sftp():
    ناپایا client := اس اس اچ.کارخواه {}
    ناپایا sftp := اس اس اچ.اس اف تی پی {}
    آزمایش.ادعای برابری رشته(اس اس اچ.وضعیت پیوند(client، sftp، "/etc/passwd").نام، "")
    آزمایش.ادعای نادرستی(اس اس اچ.پیوند است(client، sftp، "/etc/passwd"))
    local := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_ssh_coverage_none")
    پوشه.حذف همه(local)
    _ := اس اس اچ.دریافت پوشه(client، sftp، "/remote"، local)
    آزمایش.ادعای درستی(سیستم عامل.پوشه است(local))
    آزمایش.ادعای برابری عدد(سیستم عامل.فهرست پوشه(local).طول()، 0)
    _ := اس اس اچ.ارسال پوشه(client، sftp، local، "/remote")
    پوشه.حذف همه(local)
پایان

تابع ریشه:
    test_writers()
    test_mpint()
    test_readers()
    test_lists()
    test_stderr()
    test_key_pem()
    test_unconnected_sftp()
    آزمایش.خلاصه()
    برگشت 0
پایان
