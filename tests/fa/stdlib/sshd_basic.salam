واردسازی سرور اس‌اس‌اچ
واردسازی آزمایش

تابع آزمون پایه():
    ناپایا پیکربندی := سرور اس‌اس‌اچ.پیکربندی نو()
    پیکربندی.میزبان = "127.0.0.1"
    پیکربندی.درگاه = 0
    سرور اس‌اس‌اچ.افزودن کاربر(پیکربندی، "ali"، "secret"، "/tmp")
    ناپایا سرور := سرور اس‌اس‌اچ.جدید(پیکربندی)
    آزمایش.تایید درست(سرور اس‌اس‌اچ.گوش دادن(سرور))
    آزمایش.تایید درست(سرور اس‌اس‌اچ.درگاه(سرور) بزرگتر 0)
    سرور اس‌اس‌اچ.بستن(سرور)
