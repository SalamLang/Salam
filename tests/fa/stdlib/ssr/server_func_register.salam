بسته ریشه

واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.رندر‌سرور
واردسازی کدگذاری.جیسون
واردسازی آزمایش

ناپایا پینگس := 0

ساختار یتیم:
    همگانی id: صحیح = 0
    همگانی name: رشته = ""
    همگانی tags: وکتور<رشته> = وکتور {}
پایان

جداشمار سطح:
    Low
    High
پایان

@en "Add"
سرور تابع افزودن(a: صحیح، b: صحیح): صحیح: برگشت a + b
پایان

@en "Find"
سرور تابع یافتن(id: صحیح، label: رشته?): یتیم: ناپایا یت := یتیم { id = id، name = "item" }
یت.tags.افزودن("t" + id)
اگر label.دارد():
    یت.name = label.یابرگردان("")
پایان
برگشت یت
پایان

@en "Describe"
سرور تابع دیسکریبی(level: سطح، loud: منطقی، ratio: اعشار): رشته: برگشت (loud ? "LOUD " : "quiet ") + (level برابر سطح.High ? "High" : "Low") + " " + ratio
پایان

@en "Boom"
سرور تابع بووم(): صحیح پرتاب خطا:
    پرتاب خطا "database password is hunter2"
پایان

@en "Count"
سرور تابع شمار(items: وکتور<صحیح>): صحیح: ناپایا ن := 0
هر و_ در items:
    ن += و_
پایان
برگشت ن
پایان

@en "Echo"
سرور تابع بازتاب(text: رشته): رشته: برگشت "got [" + text + "]"
پایان

@en "Maybe"
سرور تابع شاید(label: رشته?): رشته: برگشت label.دارد() ? "some [" + label.یابرگردان("") + "]" : "none"
پایان

@en "Ping"
سرور تابع پینگ(): پینگس++
پایان

تابع deny(ک: صحیح۶۴):
    رندر‌سرور.رد درخواست(ک، 418، "teapot")
پایان

تابع پوست(ورل: رشته، بودی: رشته، توکین: رشته): اچ تی تی پی.پاسخ:
    ناپایا ه := اچ تی تی پی.سرصفحه جدید()
    ه.درج("Content-Type"، "application/json")
    ه.درج("X-Salam-Token"، توکین)
    برگشت اچ تی تی پی.ارسال با(ورل، بودی، ه)
پایان

تابع ریشه:
    __salam_register_server_funcs()
    آزمایش.ادعای درستی(رندر‌سرور.ثبت شده("Add"))
    آزمایش.ادعای درستی(رندر‌سرور.ثبت شده("Boom"))
    آزمایش.ادعای نادرستی(رندر‌سرور.ثبت شده("Nope"))
    آزمایش.ادعای برابری عدد(افزودن(2، 3)، 5)
    آزمایش.ادعای برابری عدد(یافتن(1، پوچ).id، 1)
    آزمایش.ادعای برابری رشته(دیسکریبی(سطح.Low، نادرست، 2.0 برگردان اعشار)، "quiet Low 2")
    ناپایا نومس := وکتور {} برگردان وکتور<صحیح>
    نومس.افزودن(1)
    نومس.افزودن(2)
    آزمایش.ادعای برابری عدد(شمار(نومس)، 3)

    رندر‌سرور.ثبت کارکرد("Deny"، deny)
    رندر‌سرور.تنظیم راز("test-secret-0123456789")
    ناپایا ر := مسیریاب.مسیریاب جدید()
    رندر‌سرور.نصب(ر)
    ناپایا س := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.استفاده(س، ر)
    پورت := اچ تی تی پی.اجرا در پس زمینه با درگاه(س)
    آزمایش.ادعای درستی(پورت بزرگتر 0)
    باسی := "http://127.0.0.1:" + پورت
    توکین := جیسون.دریافت(اچ تی تی پی.بدنه(اچ تی تی پی.دریافت(باسی + "/_salam/session"))، "token")

    افزودن_2 := پوست(باسی + "/_salam/fn/Add"، "{\"args\":{\"a\":40,\"b\":2}}"، توکین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(افزودن_2)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(افزودن_2)، "{\"ok\":true,\"value\":42}")

    میسس := پوست(باسی + "/_salam/fn/Add"، "{\"args\":{\"a\":40}}"، توکین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(میسس)، 400)
    ورونگ := پوست(باسی + "/_salam/fn/Add"، "{\"args\":{\"a\":\"x\",\"b\":2}}"، توکین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(ورونگ)، 400)

    یافتن_2 := پوست(باسی + "/_salam/fn/Find"، "{\"args\":{\"id\":7}}"، توکین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(یافتن_2)، 200)
    آزمایش.ادعای برابری رشته(جیسون.دریافت(اچ تی تی پی.بدنه(یافتن_2)، "ok")، "true")
    آزمایش.ادعای برابری رشته(جیسون.دریافت مسیر(اچ تی تی پی.بدنه(یافتن_2)، "value.name")، "item")
    labelled := پوست(باسی + "/_salam/fn/Find"، "{\"args\":{\"id\":7,\"label\":\"shoe\"}}"، توکین)
    آزمایش.ادعای برابری رشته(جیسون.دریافت مسیر(اچ تی تی پی.بدنه(labelled)، "value.name")، "shoe")
    آزمایش.ادعای شامل بودن(اچ تی تی پی.بدنه(labelled)، "\"tags\":[\"t7\"]")

    دیسک := پوست(
        باسی + "/_salam/fn/Describe"،
        "{\"args\":{\"level\":\"High\",\"loud\":true,\"ratio\":1.5}}"،
        توکین
    )
    آزمایش.ادعای برابری رشته(جیسون.دریافت(اچ تی تی پی.بدنه(دیسک)، "ok")، "true")
    آزمایش.ادعای شامل بودن(اچ تی تی پی.بدنه(دیسک)، "LOUD")
    آزمایش.ادعای شامل بودن(اچ تی تی پی.بدنه(دیسک)، "1.5")

    شمار_2 := پوست(باسی + "/_salam/fn/Count"، "{\"args\":{\"items\":[1,2,3,4]}}"، توکین)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(شمار_2)، "{\"ok\":true,\"value\":10}")

    تهی_متن := پوست(باسی + "/_salam/fn/Echo"، "{\"args\":{\"text\":\"\"}}"، توکین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(تهی_متن)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(تهی_متن)، "{\"ok\":true,\"value\":\"got []\"}")
    نال_متن := پوست(باسی + "/_salam/fn/Echo"، "{\"args\":{\"text\":null}}"، توکین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(نال_متن)، 400)
    بی_متن := پوست(باسی + "/_salam/fn/Echo"، "{\"args\":{}}"، توکین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(بی_متن)، 400)
    آزمایش.ادعای شامل بودن(اچ تی تی پی.بدنه(بی_متن)، "missing argument")
    خالی_برچسب := پوست(باسی + "/_salam/fn/Maybe"، "{\"args\":{\"label\":\"\"}}"، توکین)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(خالی_برچسب)، "{\"ok\":true,\"value\":\"some []\"}")
    نبود_برچسب := پوست(باسی + "/_salam/fn/Maybe"، "{\"args\":{\"label\":null}}"، توکین)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(نبود_برچسب)، "{\"ok\":true,\"value\":\"none\"}")

    بووم_2 := پوست(باسی + "/_salam/fn/Boom"، "{\"args\":{}}"، توکین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(بووم_2)، 200)
    آزمایش.ادعای شامل بودن(اچ تی تی پی.بدنه(بووم_2)، "\"ok\":false")
    آزمایش.ادعای نادرستی(اچ تی تی پی.بدنه(بووم_2).دربردارد("hunter2"))

    پینگ_2 := پوست(باسی + "/_salam/fn/Ping"، "{\"args\":{}}"، توکین)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(پینگ_2)، "{\"ok\":true,\"value\":null}")
    آزمایش.ادعای برابری عدد(پینگس، 1)

    قوری := پوست(باسی + "/_salam/fn/Deny"، "{\"args\":{}}"، توکین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(قوری)، 418)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(قوری)، "{\"ok\":false,\"error\":\"teapot\"}")

    برگشت آزمایش.خلاصه()
پایان
