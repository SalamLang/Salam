بسته ریشه

واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.رندر‌سرور
واردسازی کدگذاری.جیسون
واردسازی سیستم عامل
واردسازی رشته
واردسازی آزمایش
واردسازی سیستم پرونده

ناپایا سیین روش := ""
ناپایا سیین مسیر := ""
ناپایا سیین کووکیی := ""
ناپایا سیین اددر := ""
ناپایا سیین معتبر := نادرست

تابع افزودن(ک: صحیح۶۴):
    ارگس := رندر‌سرور.پارامترها(ک)
    ا := جیسون.دریافت عدد(ارگس، "a")
    ب := جیسون.دریافت عدد(ارگس، "b")
    ریق := رندر‌سرور.درخواست جاری()
    سیین معتبر = رندر‌سرور.معتبر(ریق)
    سیین روش = رشته.رونوشت(رندر‌سرور.روش(ریق))
    سیین مسیر = رشته.رونوشت(رندر‌سرور.مسیر(ریق))
    سیین کووکیی = رشته.رونوشت(رندر‌سرور.کوکی(ریق، "sid"))
    سیین اددر = رشته.رونوشت(رندر‌سرور.نشانی کارخواه(ریق))
    رندر‌سرور.پاسخ موفق(ک، "{\"sum\":" + (ا + ب) + "}")
پایان

تابع ریفوسی(ک: صحیح۶۴):
    رندر‌سرور.پاسخ خطا(ک، "no stock")
پایان

تابع سیلینت(ک: صحیح۶۴):
    اچ تی تی پی.تنظیم وضعیت(ک، 200)
پایان

تابع صفحه(ک: صحیح۶۴):
    مسیر := رندر‌سرور.مسیر صفحه(ک)
    اگر مسیر برابر "/go":
        رندر‌سرور.پاسخ صفحه(ک، 302، ""، "/target")
    وگرنه مسیر برابر "/missing":
        رندر‌سرور.پاسخ صفحه(ک، 404، "<p>nothing</p>"، "")
    وگرنه:
        ریق := رندر‌سرور.درخواست جاری()
        رندر‌سرور.پاسخ صفحه(ک، 200، "<p>page " + مسیر + " " + رندر‌سرور.روش(ریق) + "</p>"، "")
    پایان
پایان

تابع پوست(ورل: رشته، بودی: رشته، ه: نگاشت<رشته، رشته>): اچ تی تی پی.پاسخ:
    برگشت اچ تی تی پی.ارسال با(ورل، بودی، ه)
پایان

تابع جسون هیادیرس(توکین: رشته): نگاشت<رشته، رشته>:
    ناپایا ه := اچ تی تی پی.سرصفحه جدید()
    ه.درج("Content-Type"، "application/json")
    اگر توکین.طول() بزرگتر 0: ه.درج("X-Salam-Token"، توکین) پایان
    برگشت ه
پایان

تابع ریشه:
    پوشه := "ssr_static_" + سیستم عامل.شناسه فرآیند()
    سیستم عامل.ساخت پوشه(پوشه)
    سیستم پرونده.نوشتن متن(پوشه + "/app.js"، "console.log(1)")
    سیستم پرونده.نوشتن متن(پوشه + "/index.html"، "<p>prerendered</p>")
    سیستم پرونده.نوشتن متن(پوشه + "/.secret"، "hidden")

    رندر‌سرور.ثبت کارکرد("Add"، افزودن)
    رندر‌سرور.ثبت کارکرد("Refuse"، ریفوسی)
    رندر‌سرور.ثبت کارکرد("Silent"، سیلینت)
    رندر‌سرور.تنظیم رندر(صفحه)
    رندر‌سرور.تنظیم پوشه ایستا(پوشه)
    رندر‌سرور.تنظیم حداکثر بدنه(200)
    ناپایا ر := مسیریاب.مسیریاب جدید()
    رندر‌سرور.نصب(ر)
    ناپایا س := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.استفاده(س، ر)
    پورت := اچ تی تی پی.اجرا در پس زمینه با درگاه(س)
    آزمایش.ادعای درستی(پورت بزرگتر 0)
    باسی := "http://127.0.0.1:" + پورت

    سیسس := اچ تی تی پی.دریافت(باسی + "/_salam/session")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(سیسس)، 200)
    توکین := جیسون.دریافت(اچ تی تی پی.بدنه(سیسس)، "token")
    آزمایش.ادعای درستی(رندر‌سرور.بررسی توکن(توکین))
    آزمایش.ادعای نادرستی(رندر‌سرور.بررسی توکن(توکین + "0"))
    آزمایش.ادعای نادرستی(رندر‌سرور.بررسی توکن("1.2.3"))
    آزمایش.ادعای نادرستی(رندر‌سرور.بررسی توکن(""))

    گوود := پوست(باسی + "/_salam/fn/Add"، "{\"args\":{\"a\":2,\"b\":40}}"، جسون هیادیرس(توکین))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(گوود)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(گوود)، "{\"ok\":true,\"value\":{\"sum\":42}}")
    آزمایش.ادعای درستی(سیین معتبر)
    آزمایش.ادعای برابری رشته(سیین روش، "POST")
    آزمایش.ادعای برابری رشته(سیین مسیر، "/_salam/fn/Add")
    آزمایش.ادعای برابری رشته(سیین اددر، "127.0.0.1")
    آزمایش.ادعای نادرستی(رندر‌سرور.معتبر(رندر‌سرور.درخواست جاری()))

    ناپایا سامی := جسون هیادیرس(توکین)
    سامی.درج("Origin"، باسی)
    سامی.درج("Sec-Fetch-Site"، "same-origin")
    سامی.درج("Cookie"، "sid=abc")
    وک2 := پوست(باسی + "/_salam/fn/Add"، "{\"args\":{\"a\":1,\"b\":1}}"، سامی)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(وک2)، 200)
    آزمایش.ادعای برابری رشته(سیین کووکیی، "abc")

    ریفوسید := پوست(باسی + "/_salam/fn/Refuse"، "{\"args\":{}}"، جسون هیادیرس(توکین))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(ریفوسید)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(ریفوسید)، "{\"ok\":false,\"error\":\"no stock\"}")

    قوییت := پوست(باسی + "/_salam/fn/Silent"، "{}"، جسون هیادیرس(توکین))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(قوییت)، 500)
    آزمایش.ادعای شامل بودن(اچ تی تی پی.بدنه(قوییت)، "\"ok\":false")

    باد := پوست(باسی + "/_salam/fn/Add"، "{not json"، جسون هیادیرس(توکین))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(باد)، 400)
    ارر := پوست(باسی + "/_salam/fn/Add"، "[1,2]"، جسون هیادیرس(توکین))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(ارر)، 400)
    بادارگس := پوست(باسی + "/_salam/fn/Add"، "{\"args\":[1]}"، جسون هیادیرس(توکین))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(بادارگس)، 400)

    ناپایا پلاین := اچ تی تی پی.سرصفحه جدید()
    پلاین.درج("Content-Type"، "text/plain")
    پلاین.درج("X-Salam-Token"، توکین)
    ورونگتیپی := پوست(باسی + "/_salam/fn/Add"، "{\"args\":{}}"، پلاین)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(ورونگتیپی)، 400)

    ونکنوون := پوست(باسی + "/_salam/fn/Nope"، "{\"args\":{}}"، جسون هیادیرس(توکین))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(ونکنوون)، 404)

    نوتوکین := پوست(باسی + "/_salam/fn/Add"، "{\"args\":{}}"، جسون هیادیرس(""))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(نوتوکین)، 403)
    بادتوکین := پوست(باسی + "/_salam/fn/Add"، "{\"args\":{}}"، جسون هیادیرس("1.2.3"))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(بادتوکین)، 403)
    ونکنوون نو توکین := پوست(باسی + "/_salam/fn/Nope"، "{}"، جسون هیادیرس(""))
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(ونکنوون نو توکین)، 403)

    ناپایا کروسس := جسون هیادیرس(توکین)
    کروسس.درج("Origin"، "http://evil.example")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(پوست(باسی + "/_salam/fn/Add"، "{\"args\":{}}"، کروسس))، 403)
    ناپایا سیتی := جسون هیادیرس(توکین)
    سیتی.درج("Sec-Fetch-Site"، "cross-site")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(پوست(باسی + "/_salam/fn/Add"، "{\"args\":{}}"، سیتی))، 403)
    ناپایا نول := جسون هیادیرس(توکین)
    نول.درج("Origin"، "null")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(پوست(باسی + "/_salam/fn/Add"، "{\"args\":{}}"، نول))، 403)
    ناپایا کروسس سیسسیون := اچ تی تی پی.سرصفحه جدید()
    کروسس سیسسیون.درج("Origin"، "http://evil.example")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت با(باسی + "/_salam/session"، کروسس سیسسیون))، 403)

    ناپایا بیگ := "{\"args\":{\"a\":1,\"pad\":\""
    ناپایا ی := 0
    تا ی کوچکتر 300:
        بیگ += "x"
        ی++
    پایان
    بیگ += "\"}}"
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(پوست(باسی + "/_salam/fn/Add"، بیگ، جسون هیادیرس(توکین)))، 400)

    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت(باسی + "/_salam/other"))، 404)

    هومی := اچ تی تی پی.دریافت(باسی + "/")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(هومی)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(هومی)، "<p>prerendered</p>")
    جس := اچ تی تی پی.دریافت(باسی + "/app.js")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(جس)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(جس)، "console.log(1)")
    یتاگ := اچ تی تی پی.دریافت سرصفحه(جس، "etag")
    آزمایش.ادعای درستی(یتاگ.طول() بزرگتر 0)
    ناپایا کوند := اچ تی تی پی.سرصفحه جدید()
    کوند.درج("If-None-Match"، یتاگ)
    کاکهید := اچ تی تی پی.دریافت با(باسی + "/app.js"، کوند)
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(کاکهید)، 304)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(کاکهید)، "")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت(باسی + "/.secret"))، 200)
    آزمایش.ادعای نابرابری رشته(اچ تی تی پی.بدنه(اچ تی تی پی.دریافت(باسی + "/.secret"))، "hidden")
    آزمایش.ادعای نابرابری رشته(اچ تی تی پی.بدنه(اچ تی تی پی.دریافت(باسی + "/../etc/passwd"))، "root")

    رین := اچ تی تی پی.دریافت(باسی + "/about/us")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(رین)، 200)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(رین)، "<p>page /about/us GET</p>")
    گونی := اچ تی تی پی.دریافت(باسی + "/missing")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(گونی)، 404)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.بدنه(گونی)، "<p>nothing</p>")
    رید := اچ تی تی پی.دریافت(باسی + "/go")
    آزمایش.ادعای برابری عدد(اچ تی تی پی.وضعیت(رید)، 302)
    آزمایش.ادعای برابری رشته(اچ تی تی پی.دریافت سرصفحه(رید، "location")، "/target")

    وپتس := رندر‌سرور.گزینه های بیرونی()
    آزمایش.ادعای برابری عدد(وپتس.میلی‌ثانیه‌زمان‌انتظار، 10000)
    آزمایش.ادعای برابری عدد(وپتس.حداکثر‌بدنه، 8388608)
    آزمایش.ادعای برابری عدد(وپتس.حداکثر‌تغییرمسیر، 5)
    آزمایش.ادعای درستی(رندر‌سرور.ثبت شده("Add"))
    آزمایش.ادعای نادرستی(رندر‌سرور.ثبت شده("Nope"))

    سیستم پرونده.حذف(پوشه + "/app.js")
    سیستم پرونده.حذف(پوشه + "/index.html")
    سیستم پرونده.حذف(پوشه + "/.secret")
    سیستم عامل.حذف پوشه(پوشه)
    برگشت آزمایش.خلاصه()
پایان
