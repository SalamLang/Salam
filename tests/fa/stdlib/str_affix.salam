 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی رشته

تابع show(label: رشته، v: منطقی):
    سرچاپ label، v
پایان

تابع ریشه:
    سرچاپ "methods"
    s := "salam donya"
    show("starts"، s.شروع با("salam"))
    show("starts not"، s.شروع با("donya"))
    show("starts empty"، s.شروع با(""))
    show("starts equal"، s.شروع با(s))
    show("starts longer"، s.شروع با("salam donya!"))
    show("ends"، s.ختم با("donya"))
    show("ends not"، s.ختم با("salam"))
    show("ends empty"، s.ختم با(""))
    show("ends equal"، s.ختم با(s))
    show("ends longer"، s.ختم با("!salam donya"))
    show("includes"، s.دربردارد("am do"))
    show("includes empty"، s.دربردارد(""))
    show("includes longer"، s.دربردارد("salam donya!"))
    show("empty starts empty"، "".شروع با(""))
    show("empty ends empty"، "".ختم با(""))
    show("empty includes empty"، "".دربردارد(""))
    show("empty starts a"، "".شروع با("a"))
    show("empty ends a"، "".ختم با("a"))
    show("empty includes a"، "".دربردارد("a"))
    show("fa starts"، "سلام دنیا".شروع با("سلام"))
    show("fa ends"، "سلام دنیا".ختم با("دنیا"))
    show("fa inner"، "سلام دنیا".دربردارد("م د"))
    show("fa half char"، "سلام".شروع با("\xd8"))
    show("fa mismatch"، "سلام".ختم با("دنیا"))
    show("case"، "Salam".شروع با("salam"))
    show("repeat"، "aaa".ختم با("aa"))
    show("overlap"، "abab".دربردارد("bab"))

    سرچاپ "std funcs"
    show("StartsWith"، رشته.شروع با(s، "sal"))
    show("EndsWith"، رشته.پایان با(s، "nya"))
    show("StartsWith long"، رشته.شروع با("ab"، "abc"))
    show("EndsWith long"، رشته.پایان با("ab"، "abc"))
    show("StartsWith empty"، رشته.شروع با(""، ""))

    سرچاپ "fold"
    show("fold start"، رشته.شروع با بدون حساسیت("Salam Donya"، "SALAM"))
    show("fold start no"، رشته.شروع با بدون حساسیت("Salam Donya"، "DONYA"))
    show("fold start empty"، رشته.شروع با بدون حساسیت("Salam"، ""))
    show("fold start long"، رشته.شروع با بدون حساسیت("Sa"، "SALAM"))
    show("fold end"، رشته.پایان با بدون حساسیت("Salam Donya"، "DONYA"))
    show("fold end no"، رشته.پایان با بدون حساسیت("Salam Donya"، "SALAM"))
    show("fold end empty"، رشته.پایان با بدون حساسیت("Salam"، ""))
    show("fold end long"، رشته.پایان با بدون حساسیت("ya"، "DONYA"))
    show("fold sharp s"، رشته.شروع با بدون حساسیت("Stra\xc3\x9fe"، "STRASS"))
    show("fold sharp s end"، رشته.پایان با بدون حساسیت("Stra\xc3\x9f"، "ASS"))
    show("fold greek"، رشته.شروع با بدون حساسیت("\xce\x91\xce\xb2"، "\xce\xb1"))
    show("fold fa"، رشته.شروع با بدون حساسیت("سلام دنیا"، "سلام"))
    show("fold fa end"، رشته.پایان با بدون حساسیت("سلام دنیا"، "دنیا"))

    سرچاپ "any"
    ناپایا ps := وکتور {} برگردان وکتور<رشته>
    ps.بیفزا("http://")
    ps.بیفزا("https://")
    show("any start"، رشته.شروع با یکی از("https://x.org"، ps))
    show("any start no"، رشته.شروع با یکی از("ftp://x.org"، ps))
    show("any start empty"، رشته.شروع با یکی از("x"، وکتور {} برگردان وکتور<رشته>))
    ناپایا ss := وکتور {} برگردان وکتور<رشته>
    ss.بیفزا(".png")
    ss.بیفزا(".jpg")
    show("any end"، رشته.پایان با یکی از("a.jpg"، ss))
    show("any end no"، رشته.پایان با یکی از("a.gif"، ss))
    ss.بیفزا("")
    show("any end empty member"، رشته.پایان با یکی از("a.gif"، ss))

    سرچاپ "cut"
    ناپایا ok := نادرست
    r := رشته.برش پیشوند("--name=x"، "--"، ok)
    سرچاپ r، ok
    r2 := رشته.برش پیشوند("name=x"، "--"، ok)
    سرچاپ r2، ok
    r3 := رشته.برش پسوند("file.txt"، ".txt"، ok)
    سرچاپ r3، ok
    r4 := رشته.برش پسوند("file.txt"، ".md"، ok)
    سرچاپ r4، ok
    r5 := رشته.برش پیشوند("abc"، "abc"، ok)
    سرچاپ "[" + r5 + "]"، ok
    r6 := رشته.برش پسوند("abc"، ""، ok)
    سرچاپ r6، ok
    r7 := رشته.برش پیشوند("سلام دنیا"، "سلام "، ok)
    سرچاپ r7، ok
پایان
