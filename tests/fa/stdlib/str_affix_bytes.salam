بسته ریشه

واردسازی رشته
واردسازی حافظه

تابع show(label: رشته، v: منطقی):
    سرچاپ label، v
پایان

تابع ریشه:
    a := حافظه.تخصیص صفرشده حتمی(8 برگردان طبیعی۶۴) برگردان صحیح۸*
    b := حافظه.تخصیص صفرشده حتمی(8 برگردان طبیعی۶۴) برگردان صحیح۸*
    a[0] = 1 برگردان صحیح۸
    a[1] = 0 برگردان صحیح۸
    a[2] = 2 برگردان صحیح۸
    a[3] = 0 برگردان صحیح۸
    a[4] = 255 برگردان صحیح۸
    b[0] = 1 برگردان صحیح۸
    b[1] = 0 برگردان صحیح۸
    b[2] = 2 برگردان صحیح۸
    show("bytes start nul"، رشته.شروع بایتی(a برگردان تهی*، 5، b برگردان تهی*، 3))
    show("bytes start whole"، رشته.شروع بایتی(a برگردان تهی*، 3، b برگردان تهی*، 3))
    show("bytes start empty"، رشته.شروع بایتی(a برگردان تهی*، 5، b برگردان تهی*، 0))
    show("bytes start empty data"، رشته.شروع بایتی(a برگردان تهی*، 0، b برگردان تهی*، 0))
    show("bytes start long"، رشته.شروع بایتی(a برگردان تهی*، 2، b برگردان تهی*، 3))
    b[2] = 3 برگردان صحیح۸
    show("bytes start differ after nul"، رشته.شروع بایتی(a برگردان تهی*، 5، b برگردان تهی*، 3))
    b[0] = 2 برگردان صحیح۸
    b[1] = 0 برگردان صحیح۸
    b[2] = 255 برگردان صحیح۸
    show("bytes end"، رشته.پایان بایتی(a برگردان تهی*، 5، (((b برگردان تهی*) برگردان صحیح۶۴ + 2) برگردان تهی*)، 1))
    b[0] = 0 برگردان صحیح۸
    b[1] = 255 برگردان صحیح۸
    show("bytes end nul"، رشته.پایان بایتی(a برگردان تهی*، 5، b برگردان تهی*، 2))
    show("bytes end empty"، رشته.پایان بایتی(a برگردان تهی*، 5، b برگردان تهی*، 0))
    show("bytes end long"، رشته.پایان بایتی(a برگردان تهی*، 1، b برگردان تهی*، 2))
    show("bytes negative"، رشته.پایان بایتی(a برگردان تهی*، 5، b برگردان تهی*، 0 - 1))
    حافظه.آزادسازی(a برگردان تهی*)
    حافظه.آزادسازی(b برگردان تهی*)
پایان
