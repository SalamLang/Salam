بسته ریشه

واردسازی رشته

تابع ریشه:
    سرچاپ "byte ranges"
    سرچاپ رشته.زیررشته درون("hello world"، 6، 5)، رشته.زیررشته درون("hello world"، 0، 5)، رشته.زیررشته درون("hello"، 2، 0)
    سرچاپ رشته.زیررشته درون("hello"، 1، 0 - 3) برابر ""، رشته.زیررشته درون("abc"، 0، 3)
    سرچاپ رشته.زیررشته درون("سلام"، 0، 2) برابر "س"

    سرچاپ "substr bounds outside the string"
    سرچاپ رشته.زیررشته درون("hello"، 0 - 3، 3) برابر "hel"، رشته.زیررشته درون("hello"، 10، 5) برابر ""
    سرچاپ رشته.زیررشته درون("hello"، 2، 100) برابر "llo"، رشته.زیررشته درون("hello"، 0 - 3، 100) برابر "hello"
    سرچاپ رشته.زیررشته("hello"، 0 - 3، 3) برابر "hel"، رشته.زیررشته("hello"، 10، 5) برابر ""
    سرچاپ رشته.زیررشته("hello"، 2، 100) برابر "llo"، رشته.زیررشته("hello"، 0 - 3، 100) برابر "hello"

    سرچاپ "ascii classes"
    سرچاپ رشته.کوچک اسکی است(97)، رشته.کوچک اسکی است(122)، رشته.کوچک اسکی است(65)، رشته.کوچک اسکی است(48)
    سرچاپ رشته.بزرگ اسکی است(65)، رشته.بزرگ اسکی است(90)، رشته.بزرگ اسکی است(97)، رشته.بزرگ اسکی است(64)
    سرچاپ رشته.الفبایی عددی اسکی است(97)، رشته.الفبایی عددی اسکی است(65)، رشته.الفبایی عددی اسکی است(55)، رشته.الفبایی عددی اسکی است(45)، رشته.الفبایی عددی اسکی است(1587)
    سرچاپ رشته.فاصله اسکی است(32)، رشته.فاصله اسکی است(9)، رشته.فاصله اسکی است(10)، رشته.فاصله اسکی است(13)، رشته.فاصله اسکی است(14)، رشته.فاصله اسکی است(160)

    سرچاپ "control characters"
    سرچاپ رشته.کنترلی است(0)، رشته.کنترلی است(10)، رشته.کنترلی است(31)، رشته.کنترلی است(127)، رشته.کنترلی است(133)
    سرچاپ رشته.کنترلی است(32)، رشته.کنترلی است(65)، رشته.کنترلی است(1587)

    سرچاپ "utf8 lengths from the lead byte"
    سرچاپ رشته.طول نویسه(65)، رشته.طول نویسه(127)، رشته.طول نویسه(192)، رشته.طول نویسه(216)، رشته.طول نویسه(224)، رشته.طول نویسه(226)، رشته.طول نویسه(240)، رشته.طول نویسه(244)

    سرچاپ "compatibility decomposition"
    سرچاپ رشته.تجزیه سازگاری("abc") برابر "abc"
    سرچاپ رشته.تجزیه سازگاری("ﬁ") برابر "fi"
    سرچاپ رشته.تجزیه سازگاری("①") برابر "1"
    سرچاپ رشته.تجزیه سازگاری("Ａ") برابر "A"
    سرچاپ رشته.تجزیه سازگاری("é") برابر "é"
    سرچاپ رشته.تجزیه سازگاری("x²") برابر "x2"
    سرچاپ رشته.تجزیه سازگاری("") برابر ""
