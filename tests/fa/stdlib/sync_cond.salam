بسته ریشه

واردسازی همگام سازی
واردسازی نخ

ناپایا mu := همگام سازی.قفل {}
ناپایا cv := همگام سازی.متغیر شرط {}
ناپایا ready := نادرست
ناپایا seen := نادرست

تابع waiter():
    همگام سازی.قفل کردن(mu)
    تا وارونه ready:
        همگام سازی.انتظار شرط(cv، mu)
    پایان
    seen = درست
    همگام سازی.باز کردن قفل(mu)
پایان

تابع ریشه:
    sem := همگام سازی.نشانگر جدید(2 برگردان صحیح۶۴)
    سرچاپ "first: "، همگام سازی.کوشش برای گرفتن(sem)
    سرچاپ "second: "، همگام سازی.کوشش برای گرفتن(sem)
    سرچاپ "empty: "، همگام سازی.کوشش برای گرفتن(sem)
    همگام سازی.رها کردن(sem)
    سرچاپ "after release: "، همگام سازی.کوشش برای گرفتن(sem)
    سرچاپ "drained again: "، همگام سازی.کوشش برای گرفتن(sem)
    همگام سازی.نابودسازی نشانگر(sem)

    mu = همگام سازی.قفل جدید()
    cv = همگام سازی.متغیر شرط جدید()

    همگام سازی.قفل کردن(mu)
    timed_out := همگام سازی.انتظار شرط با مهلت(cv، mu، 20 برگردان صحیح۶۴)
    همگام سازی.باز کردن قفل(mu)
    سرچاپ "timeout wake: "، timed_out

    t := نخ.جدید(نخ‌ساز(waiter))
    همگام سازی.قفل کردن(mu)
    ready = درست
    همگام سازی.اعلام(cv)
    همگام سازی.باز کردن قفل(mu)
    نخ.پیوستن(t)
    سرچاپ "waiter saw signal: "، seen

    همگام سازی.نابودسازی متغیر شرط(cv)
    همگام سازی.نابودسازی(mu)
پایان
