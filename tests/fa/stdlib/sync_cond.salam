بسته ریشه

واردسازی همگام سازی
واردسازی نخ

ناپایا قفل اصلی := همگام سازی.قفل {}
ناپایا متغیر شرطی := همگام سازی.متغیر شرط {}
ناپایا آماده := نادرست
ناپایا دیده شد := نادرست

تابع منتظر():
    همگام سازی.قفل کردن(قفل اصلی)
    تا وارونه آماده:
        همگام سازی.انتظار شرط(متغیر شرطی، قفل اصلی)
    پایان
    دیده شد = درست
    همگام سازی.باز کردن قفل(قفل اصلی)
پایان

تابع ریشه:
    سمافور := همگام سازی.نشانگر جدید(2 برگردان صحیح۶۴)
    سرچاپ "first: "، همگام سازی.کوشش برای گرفتن(سمافور)
    سرچاپ "second: "، همگام سازی.کوشش برای گرفتن(سمافور)
    سرچاپ "empty: "، همگام سازی.کوشش برای گرفتن(سمافور)
    همگام سازی.رها کردن(سمافور)
    سرچاپ "after release: "، همگام سازی.کوشش برای گرفتن(سمافور)
    سرچاپ "drained again: "، همگام سازی.کوشش برای گرفتن(سمافور)
    همگام سازی.نابودسازی نشانگر(سمافور)

    قفل اصلی = همگام سازی.قفل جدید()
    متغیر شرطی = همگام سازی.متغیر شرط جدید()

    همگام سازی.قفل کردن(قفل اصلی)
    مهلت گذشت := همگام سازی.انتظار شرط با مهلت(متغیر شرطی، قفل اصلی، 20 برگردان صحیح۶۴)
    همگام سازی.باز کردن قفل(قفل اصلی)
    سرچاپ "timeout wake: "، مهلت گذشت

    t := نخ.جدید(نخ‌ساز(منتظر))
    همگام سازی.قفل کردن(قفل اصلی)
    آماده = درست
    همگام سازی.اعلام(متغیر شرطی)
    همگام سازی.باز کردن قفل(قفل اصلی)
    نخ.پیوستن(t)
    سرچاپ "waiter saw signal: "، دیده شد

    همگام سازی.نابودسازی متغیر شرط(متغیر شرطی)
    همگام سازی.نابودسازی(قفل اصلی)
پایان
