بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع cat(a: رشته، b: رشته): رشته:
    برگشت مسیر پرونده.پیوند(a، b)
پایان

تابع fill(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید با ظرفیت(n)
    تکرار n در i:
        فشرده سازی.افزودن بایت(b، (i * 11 + i / 7) & 255)
    پایان
    برگشت b
پایان

تابع size_of(dir: رشته، name: رشته): صحیح۶۴:
    path := cat(dir، name)
    n := سیستم عامل.اندازه پرونده(path)
    حافظه.آزادسازی(path برگردان تهی*)
    برگشت n
پایان

تابع exists_in(dir: رشته، name: رشته): منطقی:
    path := cat(dir، name)
    found := سیستم عامل.وجود دارد(path)
    حافظه.آزادسازی(path برگردان تهی*)
    برگشت found
پایان

تابع ریشه:
    dir := cat(سیستم عامل.پوشه موقت()، "salam_tar_file_demo")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا data := fill(70000)
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("docs"، پوچ، 0، درست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("docs/a.bin"، data.داده، data.طول، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("docs/b.txt"، data.داده، 1000، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("docs/link"، "b.txt"))
    files.بیفزا(بایگانی.ساخت ورودی پیوند سخت تار("docs/hard"، "docs/b.txt"))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("../escape.txt"، data.داده، 10، نادرست))
    ناپایا long_name := فشرده سازی.بافر بایت جدید()
    تکرار 130:
        فشرده سازی.افزودن بایت(long_name، 108)
    پایان
    فشرده سازی.افزودن بایت(long_name، 0)
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار(long_name.داده برگردان رشته، data.داده، 5، نادرست))
    ناپایا tar := بایگانی.ساخت تار(files)
    path1 := cat(dir، "a.tar")
    path2 := cat(dir، "a.tar.gz")
    path3 := cat(dir، "a.gz")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(path1، tar)، بایگانی.ساخت پرونده تار جی زیپ(files، path2)

    ناپایا tf := بایگانی.بازکردن پرونده تار(path1)
    سرچاپ "open"، tf.وضعیت، tf.اندازه برابر tar.طول برگردان صحیح۶۴
    ناپایا e := بایگانی.مدخل {}
    تا بایگانی.مدخل بعدی پرونده تار(tf، e):
        سرچاپ e.نوع، e.نام.طول()، e.اندازه، e.پیوند.طول()، tf.جایگاه داده
        بایگانی.آزادسازی مدخل(e)
    پایان
    بایگانی.بازگشت به آغاز پرونده تار(tf)
    ناپایا es := بایگانی.مدخل های پرونده تار(tf)
    سرچاپ "entries"، es.طول()
    ناپایا bin := بایگانی.مدخل {}
    سرچاپ بایگانی.مدخل بعدی پرونده تار(tf، bin)
    بایگانی.آزادسازی مدخل(bin)
    سرچاپ بایگانی.مدخل بعدی پرونده تار(tf، bin)، bin.نام
    out1 := cat(dir، "a.out")
    سرچاپ "extract"، بایگانی.استخراج از پرونده تار به پرونده(tf، bin، out1، 0 برگردان صحیح۶۴)، سیستم عامل.اندازه پرونده(out1)
    سرچاپ "cap"، بایگانی.استخراج از پرونده تار به پرونده(tf، bin، out1، 100 برگردان صحیح۶۴)، سیستم عامل.وجود دارد(out1)
    سرچاپ "dir entry"، بایگانی.استخراج از پرونده تار به پرونده(tf، es.بگیر(0)، out1، 0 برگردان صحیح۶۴)
    بایگانی.آزادسازی مدخل(bin)
    بایگانی.آزادسازی فهرست(es)
    بایگانی.بستن پرونده تار(tf)

    out2 := cat(dir، "all")
    سرچاپ "all"، بایگانی.استخراج همه از پرونده تار(path1، out2، 0 برگردان صحیح۶۴)، بایگانی.متن وضعیت تار(بایگانی.تار مسیر ناامن)
    سرچاپ size_of(out2، "docs/a.bin")، size_of(out2، "docs/b.txt")، size_of(out2، "docs/link")، size_of(out2، "docs/hard")، exists_in(dir، "escape.txt")
    out3 := cat(dir، "capped")
    سرچاپ "capped"، بایگانی.استخراج همه از پرونده تار(path1، out3، 5000 برگردان صحیح۶۴) برابر بایگانی.تار بیش از حد بزرگ، size_of(out3، "docs/b.txt")، exists_in(out3، "docs/a.bin")
    out4 := cat(dir، "viagz")
    سرچاپ "tar.gz"، بایگانی.استخراج همه از پرونده تار جی زیپ(path2، out4، 0 برگردان صحیح۶۴)، size_of(out4، "docs/a.bin")

    ناپایا gz := فشرده سازی.فشرده سازی جی زیپ(data.داده، data.طول)
    سرچاپ "gz"، بایگانی.نوشتن پرونده دودویی از بافر(path3، gz)
    فشرده سازی.آزادسازی بافر(gz)
    out5 := cat(dir، "a.raw")
    سرچاپ بایگانی.کدگشایی پرونده جی زیپ با سقف(path3، out5، 0 برگردان صحیح۶۴) برابر بایگانی.بایگانی موفق، سیستم عامل.اندازه پرونده(out5)
    سرچاپ بایگانی.کدگشایی پرونده جی زیپ با سقف(path3، out5، 100 برگردان صحیح۶۴) برابر بایگانی.بایگانی بیش از حد بزرگ، سیستم عامل.وجود دارد(out5)
    سرچاپ بایگانی.کدگشایی پرونده جی زیپ(path3، out5)، بایگانی.کدگشایی پرونده جی زیپ(path1، out5)

    ناپایا cut := فشرده سازی.کپی بافر(tar)
    cut.طول = 4000
    path4 := cat(dir، "cut.tar")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(path4، cut)
    out6 := cat(dir، "cutout")
    سرچاپ "cut"، بایگانی.استخراج همه از پرونده تار(path4، out6، 0 برگردان صحیح۶۴) نابرابر بایگانی.تار موفق
    path5 := cat(dir، "none.tar")
    سرچاپ "missing"، بایگانی.استخراج همه از پرونده تار(path5، out6، 0 برگردان صحیح۶۴)

    سیستم عامل.حذف همه(dir)
    files.آزادکن()
    فشرده سازی.آزادسازی بافر(data)
    فشرده سازی.آزادسازی بافر(long_name)
    فشرده سازی.آزادسازی بافر(tar)
    فشرده سازی.آزادسازی بافر(cut)
    حافظه.آزادسازی(dir برگردان تهی*)
    حافظه.آزادسازی(path1 برگردان تهی*)
    حافظه.آزادسازی(path2 برگردان تهی*)
    حافظه.آزادسازی(path3 برگردان تهی*)
    حافظه.آزادسازی(path4 برگردان تهی*)
    حافظه.آزادسازی(path5 برگردان تهی*)
    حافظه.آزادسازی(out1 برگردان تهی*)
    حافظه.آزادسازی(out2 برگردان تهی*)
    حافظه.آزادسازی(out3 برگردان تهی*)
    حافظه.آزادسازی(out4 برگردان تهی*)
    حافظه.آزادسازی(out5 برگردان تهی*)
    حافظه.آزادسازی(out6 برگردان تهی*)
    برگشت 0
پایان
