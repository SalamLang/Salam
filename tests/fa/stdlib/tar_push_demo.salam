بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع cat(a: رشته، b: رشته): رشته:
    برگشت مسیر پرونده.پیوند(a، b)
پایان

تابع fill(n: صحیح، seed: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید با ظرفیت(n)
    ناپایا x := seed برگردان صحیح۶۴
    تکرار n در i:
        x = (x * (1103515245 برگردان صحیح۶۴) + (12345 برگردان صحیح۶۴)) & (0x7fffffff برگردان صحیح۶۴)
        فشرده سازی.افزودن بایت(b، i % 3 برابر 0 ? ((x >> (16 برگردان صحیح۶۴)) & (255 برگردان صحیح۶۴)) برگردان صحیح : 65 + (i % 5))
    پایان
    برگشت b
پایان

تابع crc_of(path: رشته): طبیعی۳۲:
    ناپایا ok := نادرست
    ناپایا b := بایگانی.خواندن پرونده دودویی(path، ok)
    c := فشرده سازی.چک جمع سی آر سی(b.داده، b.طول)
    فشرده سازی.آزادسازی بافر(b)
    برگشت c
پایان

تابع report(tag: رشته، st: صحیح، dir: رشته، want_big: طبیعی۳۲):
    p1 := cat(dir، "a.txt")
    p2 := cat(dir، "d/e/big.bin")
    p3 := cat(dir، "link")
    سرچاپ tag، st، سیستم عامل.اندازه پرونده(p1)، سیستم عامل.اندازه پرونده(p2)، crc_of(p2) برابر want_big، سیستم عامل.وجود دارد(p3)
    حافظه.آزادسازی(p1 برگردان تهی*)
    حافظه.آزادسازی(p2 برگردان تهی*)
    حافظه.آزادسازی(p3 برگردان تهی*)
پایان

تابع size_in(dir: رشته، name: رشته): صحیح۶۴:
    p := cat(dir، name)
    n := سیستم عامل.اندازه پرونده(p)
    حافظه.آزادسازی(p برگردان تهی*)
    برگشت n
پایان

تابع exists_in(dir: رشته، name: رشته): منطقی:
    p := cat(dir، name)
    ok := سیستم عامل.وجود دارد(p)
    حافظه.آزادسازی(p برگردان تهی*)
    برگشت ok
پایان

تابع ریشه:
    root := cat(سیستم عامل.پوشه موقت()، "salam_tar_push_demo_fa")
    سیستم عامل.حذف همه(root)
    سیستم عامل.ساخت پوشه ها(root)
    ناپایا big := fill(1500000، 7)
    want := فشرده سازی.چک جمع سی آر سی(big.داده، big.طول)
    note := "hello tar"
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("a.txt"، note برگردان تهی*، note.طول()، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("d/"، پوچ، 0، درست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("d/e/big.bin"، big.داده، big.طول، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("link"، "a.txt"))
    tar := cat(root، "t.tar")
    tgz := cat(root، "t.tar.gz")
    tbz := cat(root، "t.tar.bz2")
    سرچاپ بایگانی.ساخت پرونده تار(files، tar)، بایگانی.ساخت پرونده تار جی زیپ(files، tgz)، بایگانی.فشرده سازی پرونده بی زیپ دو(tar، tbz)

    gzdir := cat(root، "gz")
    bzdir := cat(root، "bz")
    capdir := cat(root، "cap")
    cutdir := cat(root، "cut")
    st1 := بایگانی.استخراج همه از پرونده تار جی زیپ(tgz، gzdir، 0 برگردان صحیح۶۴)
    report("gz"، st1، gzdir، want)
    st2 := بایگانی.استخراج همه از پرونده تار بی زیپ دو(tbz، bzdir، 0 برگردان صحیح۶۴)
    report("bz2"، st2، bzdir، want)

    ناپایا lst := 0
    ناپایا es := بایگانی.مدخل های پرونده تار فشرده(tgz، بایگانی.قالب تار جی زیپ، lst)
    سرچاپ "list gz"، lst، es.طول()
    بایگانی.آزادسازی فهرست(es)
    ناپایا lst2 := 0
    ناپایا fb := بایگانی.مدخل های پرونده تار فشرده(tbz، بایگانی.قالب تار بی زیپ دو، lst2)
    سرچاپ "list bz2"، lst2، fb.طول()
    بایگانی.آزادسازی فهرست(fb)

    سرچاپ "cap"، بایگانی.استخراج همه از پرونده تار فشرده(tgz، بایگانی.قالب تار جی زیپ، capdir، 1000 برگردان صحیح۶۴)، size_in(capdir، "a.txt")، exists_in(capdir، "d/e/big.bin")

    ناپایا rok := نادرست
    ناپایا raw := بایگانی.خواندن پرونده دودویی(tgz، rok)
    cut := cat(root، "cut.tar.gz")
    سرچاپ بایگانی.نوشتن پرونده دودویی(cut، raw.داده، raw.طول / 2)
    سرچاپ "truncated gz"، بایگانی.استخراج همه از پرونده تار جی زیپ(cut، cutdir، 0 برگردان صحیح۶۴)
    none := cat(root، "none.gz")
    سرچاپ "missing"، بایگانی.استخراج همه از پرونده تار جی زیپ(none، cutdir، 0 برگردان صحیح۶۴)
    فشرده سازی.آزادسازی بافر(raw)

    ناپایا zin := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    zin.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("big.bin"، big.داده، big.طول، 12))
    zip := cat(root، "bz.zip")
    سرچاپ "zip"، بایگانی.ساخت پرونده زیپ(zin، zip)
    ناپایا zf := بایگانی.بازکردن پرونده زیپ(zip)
    out := cat(root، "bz.out")
    سرچاپ "zip bzip2"، zf.وضعیت، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "big.bin"، out، 0 برگردان صحیح۶۴)، crc_of(out) برابر want
    سرچاپ "zip cap"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "big.bin"، out، 1000 برگردان صحیح۶۴)، سیستم عامل.وجود دارد(out)
    بایگانی.بستن پرونده زیپ(zf)
    fpb := فشرده سازی.بازکردن پرونده برای خواندن(tbz)
    plain := cat(root، "plain.tar")
    ناپایا sk := فشرده سازی.بازکردن مقصد(plain، 0 برگردان صحیح۶۴)
    سرچاپ "bzip2 sink"، فشرده سازی.کدگشایی بی زیپ دو از پرونده به مقصد(fpb، 0 برگردان صحیح۶۴، فشرده سازی.اندازه پرونده(fpb)، sk) برابر فشرده سازی.کدگشایی موفق، sk.written برابر سیستم عامل.اندازه پرونده(tar)، فشرده سازی.خطای ورودی خروجی کدگشایی
    _ := فشرده سازی.بستن مقصد(sk)
    فشرده سازی.بستن پرونده(fpb)
    zin.آزادکن()
    files.آزادکن()
    فشرده سازی.آزادسازی بافر(big)
    سیستم عامل.حذف همه(root)
    حافظه.آزادسازی(root برگردان تهی*)
    حافظه.آزادسازی(tar برگردان تهی*)
    حافظه.آزادسازی(tgz برگردان تهی*)
    حافظه.آزادسازی(tbz برگردان تهی*)
    حافظه.آزادسازی(gzdir برگردان تهی*)
    حافظه.آزادسازی(bzdir برگردان تهی*)
    حافظه.آزادسازی(capdir برگردان تهی*)
    حافظه.آزادسازی(cutdir برگردان تهی*)
    حافظه.آزادسازی(cut برگردان تهی*)
    حافظه.آزادسازی(none برگردان تهی*)
    حافظه.آزادسازی(zip برگردان تهی*)
    حافظه.آزادسازی(out برگردان تهی*)
    حافظه.آزادسازی(plain برگردان تهی*)
    برگشت 0
پایان
