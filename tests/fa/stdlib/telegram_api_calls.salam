بسته ریشه

واردسازی تلگرام.بات
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی کدگذاری.جیسون

پایا PORT := 19933

ناپایا آخرین مسیر := ""
ناپایا آخرین پرسمان := ""
ناپایا شمارنده درخواست := 0

تابع مدیر(h: صحیح۶۴):
    زمینه := اچ تی تی پی.زمینه جدید(h)
    مسیر درخواست := اچ تی تی پی.مسیر(زمینه)
    رشته پرسمان := اچ تی تی پی.پرسمان خام(زمینه)
    آخرین مسیر = مسیر درخواست.زیررشته(0، مسیر درخواست.طول())
    آخرین پرسمان = رشته پرسمان.زیررشته(0، رشته پرسمان.طول())
    شمارنده درخواست += 1
    ناپایا بدنه := `{"ok":true,"result":"done"}`
    اگر آخرین مسیر.ختم با("/getUpdates"):
        بدنه = `{"ok":true,"result":[{"update_id":5,"message":{"message_id":1,"text":"hi","chat":{"id":9,"type":"private"}}},{"update_id":6}]}`
    وگرنه آخرین مسیر.ختم با("/getFile"):
        بدنه = `{"ok":true,"result":{"file_id":"F1","file_path":"photos/a.jpg"}}`
    وگرنه آخرین مسیر.ختم با("/getChat"):
        بدنه = `{"ok":true,"result":{"id":-100,"type":"supergroup","title":"Dev"}}`
    وگرنه آخرین مسیر.ختم با("/getChatMember"):
        بدنه = `{"ok":true,"result":{"status":"member","user":{"id":7}}}`
    پایان
    اچ تی تی پی.جیسون(زمینه، بدنه)
پایان

تابع q(کلید: رشته): رشته:
    ناپایا یافته := ""
    قطعه ها := آخرین پرسمان.بشکاف("&")
    تکرار قطعه ها.طول() در i:
        جفت := قطعه ها.بگیر(i)
        اگر جفت.شروع با(کلید + "="): یافته = جفت.زیررشته(کلید.طول() + 1، جفت.طول() - کلید.طول() - 1) پایان
    پایان
    برگشت یافته
پایان

تابع نمایش(نام: رشته، r: بات.پاسخ ای پی آی):
    سرچاپ نام، بات.موفق(r)، r.وضعیت اچ تی تی پی، r.نتیجه.طول() بزرگتر 0
    سرچاپ "  path"، آخرین مسیر
پایان

تابع ریشه:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/*"، مدیر)
    ناپایا s := اچ تی تی پی.سرور جدید(PORT)
    اچ تی تی پی.استفاده(s، r)
    اچ تی تی پی.اجرا در پس زمینه(s)

    ربات := بات.بات جدید("123:ABC")
    بات.تنظیم نشانی رابط("http://127.0.0.1:" + PORT + "/")
    شناسه گفتگو := 42 برگردان صحیح۶۴

    ناپایا x := بات.دریافت بروزرسانی ها(ربات، 10، 5، 3)
    نمایش("GetUpdates"، x)
    سرچاپ q("offset")، q("limit")، q("timeout")
    بروزرسانی ها := بات.تجزیه بروزرسانی ها(x.نتیجه)
    سرچاپ بروزرسانی ها.طول()، بروزرسانی ها.بگیر(0).شناسه، بروزرسانی ها.بگیر(0).پیام.متن، بروزرسانی ها.بگیر(1).شناسه

    x = بات.دریافت گفتگو(ربات، شناسه گفتگو)
    نمایش("GetChat"، x)
    سرچاپ q("chat_id")، جیسون.دریافت(x.نتیجه، "title")

    x = بات.عضو گفتگو(ربات، شناسه گفتگو، 7)
    نمایش("GetChatMember"، x)
    سرچاپ q("chat_id")، q("user_id")، جیسون.دریافت(x.نتیجه، "status")

    x = بات.دریافت فایل(ربات، "AgAC")
    نمایش("GetFile"، x)
    سرچاپ q("file_id")
    مسیر فایل := جیسون.دریافت(x.نتیجه، "file_path")
    سرچاپ مسیر فایل
    سرچاپ بات.پیوند فایل(ربات، مسیر فایل)

    x = بات.ترک گفتگو(ربات، -100)
    نمایش("LeaveChat"، x)
    سرچاپ q("chat_id")

    x = بات.تنظیم وب هوک(ربات، "https://example.com/hook")
    نمایش("SetWebhook"، x)
    سرچاپ q("url").طول() بزرگتر 0، آخرین پرسمان.دربردارد("example.com")

    x = بات.حذف پیام(ربات، شناسه گفتگو، 10)
    نمایش("DeleteMessage"، x)
    سرچاپ q("chat_id")، q("message_id")

    x = بات.ارسال دوباره پیام(ربات، شناسه گفتگو، 43، 11)
    نمایش("ForwardMessage"، x)
    سرچاپ q("chat_id")، q("from_chat_id")، q("message_id")

    x = بات.برداشتن سنجاق پیام(ربات، شناسه گفتگو، 10)
    نمایش("UnpinChatMessage"، x)
    سرچاپ q("chat_id")، q("message_id")

    x = بات.پاسخ به پرسمان درون خطی(ربات، "iq1"، "[]")
    نمایش("AnswerInlineQuery"، x)
    سرچاپ q("inline_query_id")، آخرین پرسمان.دربردارد("results=")

    x = بات.ارسال عکس(ربات، شناسه گفتگو، "FILE1"، "cap")
    نمایش("SendPhoto"، x)
    سرچاپ q("chat_id")، q("photo")، q("caption")

    x = بات.ارسال سند(ربات، شناسه گفتگو، "FILE2"، "")
    نمایش("SendDocument"، x)
    سرچاپ q("document")، q("caption").طول()

    x = بات.ارسال ویدیو(ربات، شناسه گفتگو، "FILE3"، "")
    نمایش("SendVideo"، x)
    سرچاپ q("video")

    x = بات.ارسال صدا(ربات، شناسه گفتگو، "FILE4"، "")
    نمایش("SendAudio"، x)
    سرچاپ q("audio")

    x = بات.ارسال پیام صوتی(ربات، شناسه گفتگو، "FILE5"، "")
    نمایش("SendVoice"، x)
    سرچاپ q("voice")

    x = بات.ارسال استیکر(ربات، شناسه گفتگو، "FILE6")
    نمایش("SendSticker"، x)
    سرچاپ q("chat_id")، q("sticker")

    x = بات.ارسال موقعیت(ربات، شناسه گفتگو، 35.5، 51.25)
    نمایش("SendLocation"، x)
    سرچاپ q("latitude")، q("longitude")

    x = بات.ارسال مخاطب(ربات، شناسه گفتگو، "+98912"، "Ali")
    نمایش("SendContact"، x)
    سرچاپ q("first_name")، آخرین پرسمان.دربردارد("phone_number=")

    سرچاپ شمارنده درخواست
پایان
