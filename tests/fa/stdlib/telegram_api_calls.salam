بسته ریشه

واردسازی تلگرام.بات
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی کدگذاری.جیسون

پایا PORT := 19933

ناپایا last_path := ""
ناپایا last_query := ""
ناپایا hits := 0

تابع handle(h: صحیح۶۴):
    ctx := اچ تی تی پی.زمینه جدید(h)
    path := اچ تی تی پی.مسیر(ctx)
    query := اچ تی تی پی.پرسمان خام(ctx)
    last_path = path.زیررشته(0، path.طول())
    last_query = query.زیررشته(0، query.طول())
    hits += 1
    ناپایا body := `{"ok":true,"result":"done"}`
    اگر last_path.ختم با("/getUpdates"):
        body = `{"ok":true,"result":[{"update_id":5,"message":{"message_id":1,"text":"hi","chat":{"id":9,"type":"private"}}},{"update_id":6}]}`
    وگرنه last_path.ختم با("/getFile"):
        body = `{"ok":true,"result":{"file_id":"F1","file_path":"photos/a.jpg"}}`
    وگرنه last_path.ختم با("/getChat"):
        body = `{"ok":true,"result":{"id":-100,"type":"supergroup","title":"Dev"}}`
    وگرنه last_path.ختم با("/getChatMember"):
        body = `{"ok":true,"result":{"status":"member","user":{"id":7}}}`
    پایان
    اچ تی تی پی.جیسون(ctx، body)
پایان

تابع q(key: رشته): رشته:
    ناپایا found := ""
    parts := last_query.بشکاف("&")
    تکرار parts.طول() در i:
        kv := parts.بگیر(i)
        اگر kv.شروع با(key + "="): found = kv.زیررشته(key.طول() + 1، kv.طول() - key.طول() - 1) پایان
    پایان
    برگشت found
پایان

تابع show(name: رشته، r: بات.پاسخ ای پی آی):
    سرچاپ name، بات.موفق(r)، r.وضعیت اچ تی تی پی، r.نتیجه.طول() بزرگتر 0
    سرچاپ "  path"، last_path
پایان

تابع ریشه:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/*"، handle)
    ناپایا s := اچ تی تی پی.سرور جدید(PORT)
    اچ تی تی پی.استفاده(s، r)
    اچ تی تی پی.اجرا در پس زمینه(s)

    robot := بات.بات جدید("123:ABC")
    بات.تنظیم نشانی رابط("http://127.0.0.1:" + PORT + "/")
    chat := 42 برگردان صحیح۶۴

    ناپایا x := بات.دریافت بروزرسانی ها(robot، 10، 5، 3)
    show("GetUpdates"، x)
    سرچاپ q("offset")، q("limit")، q("timeout")
    ups := بات.تجزیه بروزرسانی ها(x.نتیجه)
    سرچاپ ups.طول()، ups.بگیر(0).شناسه، ups.بگیر(0).پیام.متن، ups.بگیر(1).شناسه

    x = بات.دریافت گفتگو(robot، chat)
    show("GetChat"، x)
    سرچاپ q("chat_id")، جیسون.دریافت(x.نتیجه، "title")

    x = بات.عضو گفتگو(robot، chat، 7)
    show("GetChatMember"، x)
    سرچاپ q("chat_id")، q("user_id")، جیسون.دریافت(x.نتیجه، "status")

    x = بات.دریافت فایل(robot، "AgAC")
    show("GetFile"، x)
    سرچاپ q("file_id")
    fp := جیسون.دریافت(x.نتیجه، "file_path")
    سرچاپ fp
    سرچاپ بات.پیوند فایل(robot، fp)

    x = بات.ترک گفتگو(robot، -100)
    show("LeaveChat"، x)
    سرچاپ q("chat_id")

    x = بات.تنظیم وب هوک(robot، "https://example.com/hook")
    show("SetWebhook"، x)
    سرچاپ q("url").طول() بزرگتر 0، last_query.دربردارد("example.com")

    x = بات.حذف پیام(robot، chat، 10)
    show("DeleteMessage"، x)
    سرچاپ q("chat_id")، q("message_id")

    x = بات.ارسال دوباره پیام(robot، chat، 43، 11)
    show("ForwardMessage"، x)
    سرچاپ q("chat_id")، q("from_chat_id")، q("message_id")

    x = بات.برداشتن سنجاق پیام(robot، chat، 10)
    show("UnpinChatMessage"، x)
    سرچاپ q("chat_id")، q("message_id")

    x = بات.پاسخ به پرسمان درون خطی(robot، "iq1"، "[]")
    show("AnswerInlineQuery"، x)
    سرچاپ q("inline_query_id")، last_query.دربردارد("results=")

    x = بات.ارسال عکس(robot، chat، "FILE1"، "cap")
    show("SendPhoto"، x)
    سرچاپ q("chat_id")، q("photo")، q("caption")

    x = بات.ارسال سند(robot، chat، "FILE2"، "")
    show("SendDocument"، x)
    سرچاپ q("document")، q("caption").طول()

    x = بات.ارسال ویدیو(robot، chat، "FILE3"، "")
    show("SendVideo"، x)
    سرچاپ q("video")

    x = بات.ارسال صدا(robot، chat، "FILE4"، "")
    show("SendAudio"، x)
    سرچاپ q("audio")

    x = بات.ارسال پیام صوتی(robot، chat، "FILE5"، "")
    show("SendVoice"، x)
    سرچاپ q("voice")

    x = بات.ارسال استیکر(robot، chat، "FILE6")
    show("SendSticker"، x)
    سرچاپ q("chat_id")، q("sticker")

    x = بات.ارسال موقعیت(robot، chat، 35.5، 51.25)
    show("SendLocation"، x)
    سرچاپ q("latitude")، q("longitude")

    x = بات.ارسال مخاطب(robot، chat، "+98912"، "Ali")
    show("SendContact"، x)
    سرچاپ q("first_name")، last_query.دربردارد("phone_number=")

    سرچاپ hits
پایان
