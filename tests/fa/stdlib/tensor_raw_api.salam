بسته ریشه

واردسازی ریاضی
واردسازی رشته
واردسازی تانسور

تابع ساخت ماتریس(a: اعشار۶۴، b: اعشار۶۴، c: اعشار۶۴، d: اعشار۶۴): تانسور.تانسور:
    ناپایا t := تانسور.صفرها دو(2، 2)
    t.تنظیم در دو(0، 0، a)
    t.تنظیم در دو(0، 1، b)
    t.تنظیم در دو(1، 0، c)
    t.تنظیم در دو(1، 1، d)
    برگشت t
پایان

تابع ردیف(t: تانسور.تانسور، r: صحیح): رشته:
    برگشت رشته.از اعشار(t.در دو(r، 0)) + " " + رشته.از اعشار(t.در دو(r، 1))
پایان

تابع ریشه:
    ناپایا x := ساخت ماتریس(8.0، 6.0، 4.0، 2.0)
    ناپایا y := ساخت ماتریس(2.0، 3.0، 4.0، 1.0)
    ناپایا خروجی := تانسور.صفرها دو(2، 2)
    سرچاپ "sub into: "، تانسور.تفریق در(x، y، خروجی)
    سرچاپ "sub row 0: "، ردیف(خروجی، 0)
    سرچاپ "sub row 1: "، ردیف(خروجی، 1)
    سرچاپ "div into: "، تانسور.تقسیم در(x، y، خروجی)
    سرچاپ "div row 0: "، ردیف(خروجی، 0)
    سرچاپ "div row 1: "، ردیف(خروجی، 1)
    ناپایا پهن := تانسور.صفرها دو(2، 3)
    سرچاپ "sub shape mismatch: "، تانسور.تفریق در(x، پهن، خروجی)
    سرچاپ "div shape mismatch: "، تانسور.تقسیم در(x، y، پهن)
    سرچاپ "out untouched on mismatch: "، خروجی.در دو(0، 0)

    ناپایا a := تانسور.صفرها دو(2، 3)
    ناپایا b := تانسور.صفرها دو(3، 2)
    تکرار 6 در k:
        a.درایه‌ها.داده[k] = (k + 1) برگردان اعشار۳۲
        b.درایه‌ها.داده[k] = (6 - k) برگردان اعشار۳۲
    پایان
    ناپایا c := تانسور.صفرها دو(2، 2)
    تانسور.ضرب انباشته خام(a.درایه‌ها.داده، b.درایه‌ها.داده، c.درایه‌ها.داده، 2، 3، 2)
    سرچاپ "gemm row 0: "، ردیف(c، 0)
    سرچاپ "gemm row 1: "، ردیف(c، 1)
    تانسور.ضرب انباشته خام(a.درایه‌ها.داده، b.درایه‌ها.داده، c.درایه‌ها.داده، 2، 3، 2)
    سرچاپ "gemm accumulated: "، ردیف(c، 0)، ردیف(c، 1)
    ناپایا مورد انتظار := تانسور.ضرب ماتریسی(a، b)
    سرچاپ "gemm matches matmul: "، مورد انتظار.در دو(0، 0) * 2.0 برابر c.در دو(0، 0) و مورد انتظار.در دو(1، 1) * 2.0 برابر c.در دو(1، 1)

    ناپایا t := تانسور.ترانهاده خام(a.درایه‌ها.داده، 2، 3)
    سرچاپ "transpose shape: "، t.شکل.بگیر(0)، t.شکل.بگیر(1)
    سرچاپ "transpose values: "، t.در دو(0، 0)، t.در دو(0، 1)، t.در دو(2، 0)، t.در دو(2، 1)

    ناپایا g := تانسور.مولد تصادفی جدید(3)
    ناپایا u := تانسور.صفرها دو(30، 30)
    تانسور.پر کردن یکنواخت(u، 2.0، 5.0، g)
    سرچاپ "uniform range: "، تانسور.کمینه همه(u) بزرگتربرابر 2.0 و تانسور.بیشینه همه(u) کوچکتر 5.0
    سرچاپ "uniform spread: "، تانسور.بیشینه همه(u) - تانسور.کمینه همه(u) بزرگتر 2.5
    سرچاپ "uniform mean: "، ریاضی.قدرمطلق(تانسور.میانگین همه(u) - 3.5) کوچکتر 0.2
    ناپایا مولد دوم := تانسور.مولد تصادفی جدید(3)
    ناپایا آرایه دوم := تانسور.صفرها دو(30، 30)
    تانسور.پر کردن یکنواخت(آرایه دوم، 2.0، 5.0، مولد دوم)
    سرچاپ "reproducible: "، تانسور.مجموع همه(u) برابر تانسور.مجموع همه(آرایه دوم)
    ناپایا نقطه := تانسور.صفرها دو(3، 3)
    تانسور.پر کردن یکنواخت(نقطه، 1.5، 1.5، g)
    سرچاپ "degenerate range: "، تانسور.کمینه همه(نقطه)، تانسور.بیشینه همه(نقطه)

    تانسور.آزادسازی(نقطه)
    تانسور.آزادسازی(آرایه دوم)
    تانسور.آزادسازی(u)
    تانسور.آزادسازی(t)
    تانسور.آزادسازی(مورد انتظار)
    تانسور.آزادسازی(c)
    تانسور.آزادسازی(b)
    تانسور.آزادسازی(a)
    تانسور.آزادسازی(پهن)
    تانسور.آزادسازی(خروجی)
    تانسور.آزادسازی(y)
    تانسور.آزادسازی(x)
پایان
