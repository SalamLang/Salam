بسته ریشه

واردسازی آزمایش

تابع ریشه:
    آزمایش.بازنشانی()
    سرچاپ "no filter selects all: "، آزمایش.انتخاب شده("test_anything")

    آزمایش.پالایه آزمون("add")
    سرچاپ "contains: "، آزمایش.انتخاب شده("test_add_zero")، آزمایش.انتخاب شده("test_sub")
    آزمایش.پالایه آزمون("^test_")
    سرچاپ "prefix: "، آزمایش.انتخاب شده("test_add")، آزمایش.انتخاب شده("my_test_add")
    آزمایش.پالایه آزمون("zero$")
    سرچاپ "suffix: "، آزمایش.انتخاب شده("test_add_zero")، آزمایش.انتخاب شده("test_zero_add")
    آزمایش.پالایه آزمون("^test_add$")
    سرچاپ "exact: "، آزمایش.انتخاب شده("test_add")، آزمایش.انتخاب شده("test_add_zero")
    آزمایش.پالایه آزمون("")
    سرچاپ "cleared: "، آزمایش.انتخاب شده("whatever")

    آزمایش.قالب گزارش("human")
    آزمایش.شروع مجموعه("runner.salam")
    آزمایش.شروع آزمون("test_pass"، 1)
    آزمایش.ادعای برابری عدد(1 + 1، 2)
    آزمایش.اتمام آزمون()
    سرچاپ "failed after pass: "، آزمایش.ناموفق()

    آزمایش.شروع آزمون("test_fail"، 2)
    آزمایش.ادعای برابری عدد(1 + 1، 3)
    آزمایش.اتمام آزمون()
    سرچاپ "passed: "، آزمایش.موفق()
    سرچاپ "failed: "، آزمایش.ناموفق()

    آزمایش.قالب گزارش("teamcity")
    آزمایش.شروع مجموعه("tc.salam")
    آزمایش.شروع آزمون("test_tc"، 3)
    آزمایش.ادعای درستی(درست)
    آزمایش.اتمام آزمون()
    آزمایش.قالب گزارش("human")

    آزمایش.بازنشانی()
    سرچاپ "after reset: "، آزمایش.موفق()، آزمایش.ناموفق()
پایان
