بسته ریشه

واردسازی حافظه
واردسازی نخ

ناپایا stop := پوچ برگردان صحیح۶۴*

تابع hold():
    تا اتمی‌بخوان(stop) نابرابر 0:
        گذر
    پایان
پایان

تابع ریشه:
    stop = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    اتمی‌بنویس(stop، 1 برگردان صحیح۶۴)
    نخ.تعیین سقف(2 برگردان صحیح۶۴)
    a := نخ‌ساز(hold)
    b := نخ‌ساز(hold)
    c := نخ‌ساز(hold)
    سرچاپ "live: "، نخ.نخ‌های زنده()
    سرچاپ "third refused: "، c برابر 0
    اتمی‌بنویس(stop، 0 برگردان صحیح۶۴)
    نخ‌پیوند(a)
    نخ‌پیوند(b)
    نخ‌پیوند(c)
    سرچاپ "after join: "، نخ.نخ‌های زنده()
    d := نخ‌ساز(hold)
    سرچاپ "slot free again: "، d نابرابر 0
    نخ‌پیوند(d)
    نخ.تعیین سقف(0 برگردان صحیح۶۴)
    حافظه.آزادسازی(stop برگردان تهی*)
پایان
