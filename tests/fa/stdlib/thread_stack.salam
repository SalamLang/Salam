بسته ریشه

واردسازی نخ

ناپایا مجموع := 0 برگردان صحیح۶۴

تابع شمارش(n: صحیح۶۴): صحیح۶۴:
    اگر n کوچکتربرابر 0:
        برگشت 0
    پایان
    برگشت 1 + شمارش(n - 1)
پایان

تابع کار(_arg: تهی*):
    مجموع = شمارش(100000)
پایان

تابع ریشه:
    t := نخ.اجرا با پشته(کار، پوچ، (64 * 1024 * 1024) برگردان طبیعی۶۴)
    سرچاپ "valid: "، نخ.معتبر(t)
    سرچاپ "handle set: "، نخ.دسته(t) نابرابر 0 برگردان صحیح۶۴
    نخ.پیوستن(t)
    سرچاپ "deep recursion: "، مجموع

    مجموع = 0 برگردان صحیح۶۴
    d := نخ.اجرا با پشته(کار، پوچ، 0 برگردان طبیعی۶۴)
    سرچاپ "default stack valid: "، نخ.معتبر(d)
    نخ.پیوستن(d)
    سرچاپ "default stack ran: "، مجموع بزرگتر 0 برگردان صحیح۶۴
پایان
