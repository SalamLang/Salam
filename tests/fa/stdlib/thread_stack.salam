بسته ریشه

واردسازی نخ

ناپایا total := 0 برگردان صحیح۶۴

تابع count(n: صحیح۶۴): صحیح۶۴:
    اگر n کوچکتربرابر 0:
        برگشت 0
    پایان
    برگشت 1 + count(n - 1)
پایان

تابع work(_arg: تهی*):
    total = count(100000)
پایان

تابع ریشه:
    t := نخ.اجرا با پشته(work، پوچ، (64 * 1024 * 1024) برگردان طبیعی۶۴)
    سرچاپ "valid: "، نخ.معتبر(t)
    سرچاپ "handle set: "، نخ.دسته(t) نابرابر 0 برگردان صحیح۶۴
    نخ.پیوستن(t)
    سرچاپ "deep recursion: "، total

    total = 0 برگردان صحیح۶۴
    d := نخ.اجرا با پشته(work، پوچ، 0 برگردان طبیعی۶۴)
    سرچاپ "default stack valid: "، نخ.معتبر(d)
    نخ.پیوستن(d)
    سرچاپ "default stack ran: "، total بزرگتر 0 برگردان صحیح۶۴
پایان
