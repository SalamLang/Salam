بسته ریشه

واردسازی محیط
واردسازی زمان
واردسازی آزمایش

تابع ریشه:
    محیط.تنظیم("TZ"، "UTC")

    سرچاپ "fields in utc"
    e := 1710513045 برگردان صحیح۶۴
    سرچاپ زمان.سال جهانی(e)، زمان.ماه جهانی(e)، زمان.روز جهانی(e)
    سرچاپ زمان.ساعت جهانی(e)، زمان.دقیقه جهانی(e)، زمان.ثانیه جهانی(e)
    کبیسه := 1709208000 برگردان صحیح۶۴
    سرچاپ زمان.سال جهانی(کبیسه)، زمان.ماه جهانی(کبیسه)، زمان.روز جهانی(کبیسه)، زمان.ساعت جهانی(کبیسه)
    سرچاپ زمان.سال جهانی(0 برگردان صحیح۶۴)، زمان.ماه جهانی(0 برگردان صحیح۶۴)، زمان.روز جهانی(0 برگردان صحیح۶۴)، زمان.ساعت جهانی(0 برگردان صحیح۶۴)
    سرچاپ زمان.دقیقه جهانی(0 برگردان صحیح۶۴)، زمان.ثانیه جهانی(0 برگردان صحیح۶۴)
    قدیمی := 0 - 86401 برگردان صحیح۶۴
    سرچاپ زمان.سال جهانی(قدیمی)، زمان.ماه جهانی(قدیمی)، زمان.روز جهانی(قدیمی)، زمان.ساعت جهانی(قدیمی)، زمان.دقیقه جهانی(قدیمی)، زمان.ثانیه جهانی(قدیمی)

    سرچاپ "day of the year"
    سرچاپ زمان.روز سال(e)، زمان.روز سال(کبیسه)
    سرچاپ زمان.روز سال(1704110400 برگردان صحیح۶۴)، زمان.روز سال(1735646400 برگردان صحیح۶۴)
    سرچاپ زمان.روز سال(1735689599 برگردان صحیح۶۴ - 43200 برگردان صحیح۶۴)

    سرچاپ "clock text"
    سرچاپ زمان.قالب ساعت(e)، زمان.قالب ساعت(0 برگردان صحیح۶۴)، زمان.قالب ساعت(86399 برگردان صحیح۶۴)
    سرچاپ زمان.قالب ساعت(e + 3600 برگردان صحیح۶۴)

    سرچاپ "date time values"
    نمونه تاریخ := زمان.از مبدا(e)
    سرچاپ زمان.مبدا(نمونه تاریخ)، زمان.مبدا(زمان.از مبدا(0 برگردان صحیح۶۴))، زمان.مبدا(زمان.از مبدا(0 - 5 برگردان صحیح۶۴))
    اکنون := زمان.تاریخ زمان اکنون()
    مهر زمانی := زمان.مبدا(اکنون)
    آزمایش.ادعای درستی(مهر زمانی بزرگتر 1700000000 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(زمان.اختلاف ثانیه(زمان.مبدا(زمان.تاریخ زمان اکنون())، مهر زمانی) بزرگتربرابر 0 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(زمان.اختلاف ثانیه(زمان.مبدا(زمان.تاریخ زمان اکنون())، مهر زمانی) کوچکتر 5 برگردان صحیح۶۴)

    سرچاپ "differences"
    سرچاپ زمان.اختلاف ثانیه(e + 90 برگردان صحیح۶۴، e)، زمان.اختلاف ثانیه(e، e + 90 برگردان صحیح۶۴)، زمان.اختلاف ثانیه(e، e)
    جلوتر := زمان.تا زمان(زمان.مبدا(زمان.تاریخ زمان اکنون()) + 3600 برگردان صحیح۶۴)
    سرچاپ جلوتر بزرگتر 3590 برگردان صحیح۶۴، جلوتر کوچکتربرابر 3600 برگردان صحیح۶۴
    عقب تر := زمان.تا زمان(زمان.مبدا(زمان.تاریخ زمان اکنون()) - 60 برگردان صحیح۶۴)
    سرچاپ عقب تر کوچکتر 0 برگردان صحیح۶۴، عقب تر بزرگتربرابر 0 - 65 برگردان صحیح۶۴
    مدت گذشته := زمان.از زمان(زمان.مبدا(زمان.تاریخ زمان اکنون()) - 60 برگردان صحیح۶۴)
    سرچاپ مدت گذشته بزرگتربرابر 60 برگردان صحیح۶۴، مدت گذشته کوچکتر 65 برگردان صحیح۶۴

    سرچاپ "fractional seconds"
    d := زمان.ثانیه اعشاری(1.5)
    سرچاپ d.نانوثانیه خام، زمان.ثانیه اعشاری(0.0).نانوثانیه خام، زمان.ثانیه اعشاری(0.000000001).نانوثانیه خام
    سرچاپ زمان.ثانیه اعشاری(0.0 - 2.25).نانوثانیه خام، زمان.ثانیه اعشاری(86400.0).نانوثانیه خام
    سرچاپ زمان.قالب مدت(زمان.ثانیه اعشاری(90.5))
    برگشت آزمایش.خلاصه()
پایان
