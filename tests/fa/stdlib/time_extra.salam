بسته ریشه

واردسازی محیط
واردسازی زمان
واردسازی آزمایش

تابع ریشه:
    محیط.تنظیم("TZ"، "UTC")

    سرچاپ "fields in utc"
    e := 1710513045 برگردان صحیح۶۴
    سرچاپ زمان.سال جهانی(e)، زمان.ماه جهانی(e)، زمان.روز جهانی(e)
    سرچاپ زمان.ساعت جهانی(e)، زمان.دقیقه جهانی(e)، زمان.ثانیه جهانی(e)
    leap := 1709208000 برگردان صحیح۶۴
    سرچاپ زمان.سال جهانی(leap)، زمان.ماه جهانی(leap)، زمان.روز جهانی(leap)، زمان.ساعت جهانی(leap)
    سرچاپ زمان.سال جهانی(0 برگردان صحیح۶۴)، زمان.ماه جهانی(0 برگردان صحیح۶۴)، زمان.روز جهانی(0 برگردان صحیح۶۴)، زمان.ساعت جهانی(0 برگردان صحیح۶۴)
    سرچاپ زمان.دقیقه جهانی(0 برگردان صحیح۶۴)، زمان.ثانیه جهانی(0 برگردان صحیح۶۴)
    old := 0 - 86401 برگردان صحیح۶۴
    سرچاپ زمان.سال جهانی(old)، زمان.ماه جهانی(old)، زمان.روز جهانی(old)، زمان.ساعت جهانی(old)، زمان.دقیقه جهانی(old)، زمان.ثانیه جهانی(old)

    سرچاپ "day of the year"
    سرچاپ زمان.روز سال(e)، زمان.روز سال(leap)
    سرچاپ زمان.روز سال(1704110400 برگردان صحیح۶۴)، زمان.روز سال(1735646400 برگردان صحیح۶۴)
    سرچاپ زمان.روز سال(1735689599 برگردان صحیح۶۴ - 43200 برگردان صحیح۶۴)

    سرچاپ "clock text"
    سرچاپ زمان.قالب ساعت(e)، زمان.قالب ساعت(0 برگردان صحیح۶۴)، زمان.قالب ساعت(86399 برگردان صحیح۶۴)
    سرچاپ زمان.قالب ساعت(e + 3600 برگردان صحیح۶۴)

    سرچاپ "date time values"
    dt := زمان.از مبدا(e)
    سرچاپ زمان.مبدا(dt)، زمان.مبدا(زمان.از مبدا(0 برگردان صحیح۶۴))، زمان.مبدا(زمان.از مبدا(0 - 5 برگردان صحیح۶۴))
    now := زمان.تاریخ زمان اکنون()
    stamp := زمان.مبدا(now)
    آزمایش.ادعای درستی(stamp بزرگتر 1700000000 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(زمان.اختلاف ثانیه(زمان.مبدا(زمان.تاریخ زمان اکنون())، stamp) بزرگتربرابر 0 برگردان صحیح۶۴)
    آزمایش.ادعای درستی(زمان.اختلاف ثانیه(زمان.مبدا(زمان.تاریخ زمان اکنون())، stamp) کوچکتر 5 برگردان صحیح۶۴)

    سرچاپ "differences"
    سرچاپ زمان.اختلاف ثانیه(e + 90 برگردان صحیح۶۴، e)، زمان.اختلاف ثانیه(e، e + 90 برگردان صحیح۶۴)، زمان.اختلاف ثانیه(e، e)
    ahead := زمان.تا زمان(زمان.مبدا(زمان.تاریخ زمان اکنون()) + 3600 برگردان صحیح۶۴)
    سرچاپ ahead بزرگتر 3590 برگردان صحیح۶۴، ahead کوچکتربرابر 3600 برگردان صحیح۶۴
    behind := زمان.تا زمان(زمان.مبدا(زمان.تاریخ زمان اکنون()) - 60 برگردان صحیح۶۴)
    سرچاپ behind کوچکتر 0 برگردان صحیح۶۴، behind بزرگتربرابر 0 - 65 برگردان صحیح۶۴
    since := زمان.از زمان(زمان.مبدا(زمان.تاریخ زمان اکنون()) - 60 برگردان صحیح۶۴)
    سرچاپ since بزرگتربرابر 60 برگردان صحیح۶۴، since کوچکتر 65 برگردان صحیح۶۴

    سرچاپ "fractional seconds"
    d := زمان.ثانیه اعشاری(1.5)
    سرچاپ d.نانوثانیه خام، زمان.ثانیه اعشاری(0.0).نانوثانیه خام، زمان.ثانیه اعشاری(0.000000001).نانوثانیه خام
    سرچاپ زمان.ثانیه اعشاری(0.0 - 2.25).نانوثانیه خام، زمان.ثانیه اعشاری(86400.0).نانوثانیه خام
    سرچاپ زمان.قالب مدت(زمان.ثانیه اعشاری(90.5))
    برگشت آزمایش.خلاصه()
پایان
