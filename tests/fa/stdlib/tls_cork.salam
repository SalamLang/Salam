واردسازی شبکه.تی سی پی
واردسازی همگام سازی
واردسازی تی ال اس

ناپایا port := 0
ناپایا server_flushed := نادرست
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع serve():
    srv := تی سی پی.پیوند(0)
    port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    c := تی سی پی.پذیرش(srv)
    cfg := تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    ناپایا conn := تی ال اس.پوشش کارساز(c.توصیفگر، cfg)
    ناپایا got := ""
    تا got.طول() کوچکتر 10:
        part := تی ال اس.خواندن(conn، 64)
        اگر part.طول() برابر 0:
            بشکن
        پایان
        got = got + part
    پایان
    تی ال اس.نگه داشتن نوشتن(conn)
    تی ال اس.نوشتن(conn، "pong")
    تی ال اس.نوشتن(conn، ":" + got)
    server_flushed = تی ال اس.فرستادن نوشته ها(conn)
    تی ال اس.بستن اتصال(conn)
    تی سی پی.بستن سرور(srv)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve)
    همگام سازی.انتظار(ready)
    ناپایا cfg := تی ال اس.پیکربندی جدید("localhost")
    cfg.بدون بررسی گواهی = درست
    ناپایا c := تی ال اس.اتصال امن("127.0.0.1"، port، cfg)
    تی ال اس.نگه داشتن نوشتن(c)
    تی ال اس.نوشتن(c، "hello")
    تی ال اس.نوشتن(c، "world")
    سرچاپ تی ال اس.فرستادن نوشته ها(c)
    ناپایا got := ""
    تا got.طول() کوچکتر 15:
        part := تی ال اس.خواندن(c، 64)
        اگر part.طول() برابر 0:
            بشکن
        پایان
        got = got + part
    پایان
    سرچاپ got
    تی ال اس.بستن اتصال(c)
    سرچاپ تی ال اس.فرستادن نوشته ها(c)
    نخ‌پیوند(t)
    سرچاپ server_flushed
پایان
