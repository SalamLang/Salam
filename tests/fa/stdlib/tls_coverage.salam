تابع test_aead():
    ناپایا priv1 := ""
    ناپایا pub1 := ""
    ناپایا priv2 := ""
    ناپایا pub2 := ""
    آزمایش.ادعای درستی(تی ال اس.تولید کلید ای سی دی اچ(priv1، pub1))
    آزمایش.ادعای درستی(تی ال اس.تولید کلید ای سی دی اچ(priv2، pub2))
    ناپایا good := نادرست
    point1 := تی ال اس.نقطه عمومی ای سی دی اچ(priv1)
    point2 := تی ال اس.نقطه عمومی ای سی دی اچ(priv2)
    آزمایش.ادعای درستی(point1.طول() بزرگتر 0)
    آزمایش.ادعای نابرابری رشته(point1، point2)
    shared1 := تی ال اس.نقطه مشترک ای سی دی اچ(priv1، point2، good)
    آزمایش.ادعای درستی(good)
    shared2 := تی ال اس.نقطه مشترک ای سی دی اچ(priv2، point1، good)
    آزمایش.ادعای درستی(good)
    آزمایش.ادعای برابری رشته(shared1، shared2)
    _ := تی ال اس.نقطه مشترک ای سی دی اچ(priv1، "AAAA"، good)
    آزمایش.ادعای نادرستی(good)
    آزمایش.ادعای برابری رشته(تی ال اس.نقطه عمومی ای سی دی اچ("AAAA")، "")

    salt := کدگذاری.کدگذاری پایه۶۴("0123456789abcdef")
    info := کدگذاری.کدگذاری پایه۶۴("chat v1")
    key := تی ال اس.اچ کی دی اف شا۲۵۶ خام(shared1، salt، info، 32، good)
    آزمایش.ادعای درستی(good)
    آزمایش.ادعای برابری رشته(key، تی ال اس.اچ کی دی اف شا۲۵۶ خام(shared2، salt، info، 32، good))
    آزمایش.ادعای برابری رشته(key، تی ال اس.اچ کی دی اف شا۲۵۶(shared1، salt، "chat v1"، 32، good))
    آزمایش.ادعای نابرابری رشته(key، تی ال اس.اچ کی دی اف شا۲۵۶ خام(shared1، salt، کدگذاری.کدگذاری پایه۶۴("chat v2")، 32، good))

    nonce := تی ال اس.نانس جی سی ام(7 برگردان صحیح۶۴)
    plain := کدگذاری.کدگذاری پایه۶۴("abc")
    sealed := تی ال اس.مهر بایت ای ای اس جی سی ام(key، nonce، plain، good)
    آزمایش.ادعای درستی(good)
    آزمایش.ادعای برابری رشته(کدگذاری.کدگشایی پایه۶۴(تی ال اس.گشودن بایت ای ای اس جی سی ام(key، nonce، sealed، good))، "abc")
    آزمایش.ادعای درستی(good)
    _ := تی ال اس.گشودن بایت ای ای اس جی سی ام(key، تی ال اس.نانس جی سی ام(8 برگردان صحیح۶۴)، sealed، good)
    آزمایش.ادعای نادرستی(good)
    _ := تی ال اس.مهر بایت ای ای اس جی سی ام("AAAA"، nonce، plain، good)
    آزمایش.ادعای نادرستی(good)

    digest := کدگذاری.کدگذاری پایه۶۴("0123456789abcdef0123456789abcdef")
    sig := تی ال اس.امضای پی۲۵۶(priv1، digest، good)
    آزمایش.ادعای درستی(good)
    آزمایش.ادعای درستی(تی ال اس.تایید امضای پی۲۵۶(point1، digest، sig))
    آزمایش.ادعای نادرستی(تی ال اس.تایید امضای پی۲۵۶(point2، digest، sig))
    آزمایش.ادعای نادرستی(تی ال اس.تایید امضای پی۲۵۶(point1، کدگذاری.کدگذاری پایه۶۴("fedcba9876543210fedcba9876543210")، sig))
    _ := تی ال اس.امضای پی۲۵۶("AAAA"، digest، good)
    آزمایش.ادعای نادرستی(good)
پایان

تابع test_rsa():
    pem := ورودی خروجی.خواندن پرونده(KEY)
    آزمایش.ادعای برابری عدد(تی ال اس.طول کلید آر اس ای(pem)، 2048)
    آزمایش.ادعای برابری عدد(تی ال اس.طول کلید آر اس ای("not a key")، 0)
    ناپایا key := تی ال اس.تجزیه کلید خصوصی پم(pem)
    آزمایش.ادعای درستی(key.ok)
    ناپایا file_key := تی ال اس.بارگذاری فایل کلید خصوصی(KEY)
    آزمایش.ادعای درستی(file_key.ok)
    missing := تی ال اس.بارگذاری فایل کلید خصوصی("tests/fixtures/ssl/missing.key")
    آزمایش.ادعای نادرستی(missing.ok)
    junk := تی ال اس.تجزیه کلید خصوصی پم("-----BEGIN PRIVATE KEY-----\nAAAA\n-----END PRIVATE KEY-----\n")
    آزمایش.ادعای نادرستی(junk.ok)

    ناپایا digest := تی ال اس.درهم ساز(نادرست، "message")
    ناپایا sig := تی ال اس.بافر صفر جدید(256)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی کی سی اس یک(key، نادرست، digest، sig))
    ناپایا again := تی ال اس.بافر صفر جدید(256)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی کی سی اس یک(file_key، نادرست، digest، again))
    آزمایش.ادعای برابری رشته(تی ال اس.کدگذاری شانزدهی(sig)، تی ال اس.کدگذاری شانزدهی(again))
    ناپایا pss := تی ال اس.بافر صفر جدید(256)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی اس اس(key، نادرست، digest، pss))
    آزمایش.ادعای درستی(تی ال اس.تایید آر اس ای پی اس اس با کلید(key، نادرست، digest، pss))
    ناپایا sized := تی ال اس.بافر جدید(512)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی اس اس(key، نادرست، digest، sized))
    آزمایش.ادعای برابری عدد(تی ال اس.طول بافر(sized)، 256)
    آزمایش.ادعای درستی(تی ال اس.تایید آر اس ای پی اس اس با کلید(key، نادرست، digest، sized))
    ناپایا tiny := تی ال اس.بافر جدید(32)
    آزمایش.ادعای نادرستی(تی ال اس.امضای آر اس ای پی اس اس(key، نادرست، digest، tiny))
    ناپایا other := تی ال اس.درهم ساز(نادرست، "another")
    آزمایش.ادعای نادرستی(تی ال اس.تایید آر اس ای پی اس اس با کلید(key، نادرست، other، pss))
    ناپایا wide := تی ال اس.درهم ساز(درست، "message")
    ناپایا pss384 := تی ال اس.بافر صفر جدید(256)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی اس اس(key، درست، wide، pss384))
    آزمایش.ادعای درستی(تی ال اس.تایید آر اس ای پی اس اس با کلید(key، درست، wide، pss384))

    ناپایا good := نادرست
    raw := تی ال اس.امضای آر اس ای شا۲۵۶(pem، کدگذاری.کدگذاری پایه۶۴("0123456789abcdef0123456789abcdef")، good)
    آزمایش.ادعای درستی(good)
    آزمایش.ادعای درستی(raw.طول() بزرگتر 300)
    _ := تی ال اس.امضای آر اس ای شا۲۵۶("not a key"، کدگذاری.کدگذاری پایه۶۴("x")، good)
    آزمایش.ادعای نادرستی(good)

    cipher := تی ال اس.رمزگذاری آر اس ای اوئپ(RSA_PUBLIC، کدگذاری.کدگذاری پایه۶۴("hello")، good)
    آزمایش.ادعای درستی(good)
    آزمایش.ادعای برابری عدد(cipher.طول()، 344)
    _ := تی ال اس.رمزگذاری آر اس ای اوئپ("not a key"، کدگذاری.کدگذاری پایه۶۴("hello")، good)
    آزمایش.ادعای نادرستی(good)

    تی ال اس.آزادسازی بافر(digest)
    تی ال اس.آزادسازی بافر(sig)
    تی ال اس.آزادسازی بافر(again)
    تی ال اس.آزادسازی بافر(pss)
    تی ال اس.آزادسازی بافر(other)
    تی ال اس.آزادسازی بافر(wide)
    تی ال اس.آزادسازی بافر(pss384)
    تی ال اس.آزادسازی کلید خصوصی(key)
    تی ال اس.آزادسازی کلید خصوصی(file_key)
پایان

تابع test_ecdsa():
    ناپایا key := تی ال اس.تجزیه کلید خصوصی پم(EC_KEY)
    آزمایش.ادعای درستی(key.ok)
    ناپایا digest := تی ال اس.درهم ساز(نادرست، "message")
    ناپایا r := تی ال اس.بافر صفر جدید(32)
    ناپایا s := تی ال اس.بافر صفر جدید(32)
    آزمایش.ادعای درستی(تی ال اس.امضای بیضوی(key، digest، r، s))
    ناپایا der := تی ال اس.کدگذاری دی ای آر بیضوی(r، s، 32)
    آزمایش.ادعای درستی(تی ال اس.طول بافر(der) بزرگتربرابر 8)
    آزمایش.ادعای درستی(تی ال اس.تایید دی ای آر بیضوی با کلید(key، digest، der))
    ناپایا other := تی ال اس.درهم ساز(نادرست، "another")
    آزمایش.ادعای نادرستی(تی ال اس.تایید دی ای آر بیضوی با کلید(key، other، der))
    تی ال اس.آزادسازی بافر(digest)
    تی ال اس.آزادسازی بافر(r)
    تی ال اس.آزادسازی بافر(s)
    تی ال اس.آزادسازی بافر(der)
    تی ال اس.آزادسازی بافر(other)
    تی ال اس.آزادسازی کلید خصوصی(key)
پایان

تابع test_certs():
    text := ورودی خروجی.خواندن پرونده(CERT)
    begin := "-----BEGIN CERTIFICATE-----"
    start := text.بیاب(begin) + begin.طول()
    stop := text.بیاب("-----END CERTIFICATE-----")
    pem_body := text.زیررشته(start، stop - start)
    room := pem_body.طول()
    ناپایا der := تی ال اس.بافر جدید(room)
    ناپایا decoded := نادرست
    der.len = کدگذاری.کدگشایی پایه۶۴ به بایت(pem_body، der.p، room، decoded)
    آزمایش.ادعای درستی(decoded)
    آزمایش.ادعای درستی(تی ال اس.طول بافر(der) بزرگتر 400)
    آزمایش.ادعای درستی(تی ال اس.گواهی معتبر است(der))
    آزمایش.ادعای برابری رشته(تی ال اس.نام مشترک گواهی(der)، "localhost")
    ناپایا junk := تی ال اس.کدگشایی شانزدهی("3082")
    آزمایش.ادعای نادرستی(تی ال اس.گواهی معتبر است(junk))
    آزمایش.ادعای برابری رشته(تی ال اس.نام مشترک گواهی(junk)، "")

    ناپایا roots := تی ال اس.بارگذاری ریشه ها(CERT)
    آزمایش.ادعای برابری عدد(تی ال اس.تعداد ریشه ها(roots)، 1)
    آزمایش.ادعای برابری عدد(تی ال اس.تایید گواهی(der، roots، "localhost")، 0)
    wrong := تی ال اس.تایید گواهی(der، roots، "other.example")
    آزمایش.ادعای درستی(wrong نابرابر 0)
    آزمایش.ادعای برابری رشته(تی ال اس.خطای تایید(wrong)، "hostname does not match certificate")
    آزمایش.ادعای برابری رشته(تی ال اس.خطای تایید(0)، "ok")
    ناپایا empty := تی ال اس.بارگذاری ریشه ها("tests/fixtures/ssl/missing.crt")
    آزمایش.ادعای برابری عدد(تی ال اس.تعداد ریشه ها(empty)، 0)
    untrusted := تی ال اس.تایید گواهی(der، empty، "localhost")
    آزمایش.ادعای برابری رشته(تی ال اس.خطای تایید(untrusted)، "no trusted issuer found")
    ناپایا chain := تی ال اس.بارگذاری فایل زنجیره گواهی(CERT)
    آزمایش.ادعای برابری عدد(تی ال اس.تعداد ریشه ها(chain)، 1)
    تی ال اس.آزادسازی ریشه ها(roots)
    تی ال اس.آزادسازی ریشه ها(empty)
    تی ال اس.آزادسازی ریشه ها(chain)
    تی ال اس.آزادسازی بافر(der)
    تی ال اس.آزادسازی بافر(junk)
پایان

تابع serve():
    srv := تی سی پی.پیوند(PORT)
    همگام سازی.اتمام(wg)
    cfg := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    c := تی سی پی.پذیرش(srv)
    ناپایا conn := تی ال اس.پوشش کارساز(c.توصیفگر، cfg)
    اگر تی ال اس.اتصال معتبر(conn):
        msg := تی ال اس.خواندن(conn، 1024)
        _ := تی ال اس.نوشتن(conn، "echo:" + msg)
    پایان
    تی ال اس.بستن اتصال(conn)
    c2 := تی سی پی.پذیرش(srv)
    ناپایا bad := تی ال اس.پوشش کارساز(c2.توصیفگر، تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/missing.crt"، KEY))
    تی ال اس.بستن اتصال(bad)
    تی سی پی.بستن سرور(srv)
پایان

تابع test_loopback():
    همگام سازی.افزودن(wg، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve)
    همگام سازی.انتظار(wg)
    cfg := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    آزمایش.ادعای درستی(cfg.سالم)
    آزمایش.ادعای نادرستی(تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/missing.crt"، KEY).سالم)
    آزمایش.ادعای نادرستی(تی ال اس.پیکربندی کارساز جدید(CERT، "tests/fixtures/ssl/missing.key").سالم)

    sock := تی سی پی.شماره گیری("127.0.0.1"، PORT)
    ناپایا client_cfg := تی ال اس.پیکربندی جدید("localhost")
    client_cfg.پرونده گواهی ریشه = CERT
    ناپایا conn := تی ال اس.پوشش کارخواه(sock.توصیفگر، client_cfg)
    آزمایش.ادعای درستی(تی ال اس.اتصال معتبر(conn))
    آزمایش.ادعای برابری عدد۶۴(تی ال اس.توصیفگر(conn)، sock.توصیفگر)
    آزمایش.ادعای برابری رشته(تی ال اس.نسخه(conn)، "TLS1.3")
    _ := تی ال اس.نوشتن(conn، "ping")
    آزمایش.ادعای برابری رشته(تی ال اس.خواندن(conn، 1024)، "echo:ping")
    تی ال اس.جداسازی اتصال(conn)
    آزمایش.ادعای نادرستی(تی ال اس.اتصال معتبر(conn))
    تی سی پی.بستن(sock)

    sock2 := تی سی پی.شماره گیری("127.0.0.1"، PORT)
    ناپایا refused := تی ال اس.پوشش کارخواه(sock2.توصیفگر، تی ال اس.پیکربندی جدید("localhost"))
    آزمایش.ادعای نادرستی(تی ال اس.اتصال معتبر(refused))
    تی ال اس.جداسازی اتصال(refused)
    تی سی پی.بستن(sock2)
    نخ‌پیوند(t)
پایان

تابع ریشه:
    test_buffers()
    test_aead()
    test_rsa()
    test_ecdsa()
    test_certs()
    test_loopback()
    آزمایش.خلاصه()
