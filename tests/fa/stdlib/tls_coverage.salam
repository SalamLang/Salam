تابع test_rsa():
    پم := ورودی خروجی.خواندن پرونده(KEY)
    آزمایش.ادعای برابری عدد(تی ال اس.طول کلید آر اس ای(پم)، 2048)
    آزمایش.ادعای برابری عدد(تی ال اس.طول کلید آر اس ای("not a key")، 0)
    ناپایا کلید := تی ال اس.تجزیه کلید خصوصی پم(پم)
    آزمایش.ادعای درستی(کلید.ok)
    ناپایا کلید پرونده := تی ال اس.بارگذاری فایل کلید خصوصی(KEY)
    آزمایش.ادعای درستی(کلید پرونده.ok)
    ناموجود := تی ال اس.بارگذاری فایل کلید خصوصی("tests/fixtures/ssl/missing.key")
    آزمایش.ادعای نادرستی(ناموجود.ok)
    ناسالم := تی ال اس.تجزیه کلید خصوصی پم("-----BEGIN PRIVATE KEY-----\nAAAA\n-----END PRIVATE KEY-----\n")
    آزمایش.ادعای نادرستی(ناسالم.ok)

    ناپایا چکیده := تی ال اس.درهم ساز(نادرست، "message")
    ناپایا امضا := تی ال اس.بافر صفر جدید(256)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی کی سی اس یک(کلید، نادرست، چکیده، امضا))
    ناپایا دوباره := تی ال اس.بافر صفر جدید(256)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی کی سی اس یک(کلید پرونده، نادرست، چکیده، دوباره))
    آزمایش.ادعای برابری رشته(تی ال اس.کدگذاری شانزدهی(امضا)، تی ال اس.کدگذاری شانزدهی(دوباره))
    ناپایا امضا پی اس اس := تی ال اس.بافر صفر جدید(256)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی اس اس(کلید، نادرست، چکیده، امضا پی اس اس))
    آزمایش.ادعای درستی(تی ال اس.تایید آر اس ای پی اس اس با کلید(کلید، نادرست، چکیده، امضا پی اس اس))
    ناپایا امضا بزرگ := تی ال اس.بافر جدید(512)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی اس اس(کلید، نادرست، چکیده، امضا بزرگ))
    آزمایش.ادعای برابری عدد(تی ال اس.طول بافر(امضا بزرگ)، 256)
    آزمایش.ادعای درستی(تی ال اس.تایید آر اس ای پی اس اس با کلید(کلید، نادرست، چکیده، امضا بزرگ))
    ناپایا بافر کوچک := تی ال اس.بافر جدید(32)
    آزمایش.ادعای نادرستی(تی ال اس.امضای آر اس ای پی اس اس(کلید، نادرست، چکیده، بافر کوچک))
    ناپایا چکیده دیگر := تی ال اس.درهم ساز(نادرست، "another")
    آزمایش.ادعای نادرستی(تی ال اس.تایید آر اس ای پی اس اس با کلید(کلید، نادرست، چکیده دیگر، امضا پی اس اس))
    ناپایا درهم گسترده := تی ال اس.درهم ساز(درست، "message")
    ناپایا امضا پی اس اس بلند := تی ال اس.بافر صفر جدید(256)
    آزمایش.ادعای درستی(تی ال اس.امضای آر اس ای پی اس اس(کلید، درست، درهم گسترده، امضا پی اس اس بلند))
    آزمایش.ادعای درستی(تی ال اس.تایید آر اس ای پی اس اس با کلید(کلید، درست، درهم گسترده، امضا پی اس اس بلند))

    ناپایا موفق := نادرست
    امضای خام := تی ال اس.امضای آر اس ای شا۲۵۶(پم، کدگذاری.کدگذاری پایه۶۴("0123456789abcdef0123456789abcdef")، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای درستی(امضای خام.طول() بزرگتر 300)
    _ := تی ال اس.امضای آر اس ای شا۲۵۶("not a key"، کدگذاری.کدگذاری پایه۶۴("x")، موفق)
    آزمایش.ادعای نادرستی(موفق)

    رمز := تی ال اس.رمزگذاری آر اس ای اوئپ(RSA_PUBLIC، کدگذاری.کدگذاری پایه۶۴("hello")، موفق)
    آزمایش.ادعای درستی(موفق)
    آزمایش.ادعای برابری عدد(رمز.طول()، 344)
    _ := تی ال اس.رمزگذاری آر اس ای اوئپ("not a key"، کدگذاری.کدگذاری پایه۶۴("hello")، موفق)
    آزمایش.ادعای نادرستی(موفق)

