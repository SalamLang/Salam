تابع خدمت():
    خادم := تی سی پی.پیوند(PORT)
    همگام سازی.اتمام(گروه انتظار)
    پیکربندی := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    c := تی سی پی.پذیرش(خادم)
    ناپایا اتصال := تی ال اس.پوشش کارساز(c.توصیفگر، پیکربندی)
    اگر تی ال اس.اتصال معتبر(اتصال):
        پیام := تی ال اس.خواندن(اتصال، 1024)
        _ := تی ال اس.نوشتن(اتصال، "echo:" + پیام)
    پایان
    تی ال اس.بستن اتصال(اتصال)
    c2 := تی سی پی.پذیرش(خادم)
    ناپایا اتصال بد := تی ال اس.پوشش کارساز(c2.توصیفگر، تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/missing.crt"، KEY))
    تی ال اس.بستن اتصال(اتصال بد)
    تی سی پی.بستن سرور(خادم)
پایان

تابع test_loopback():
    همگام سازی.افزودن(گروه انتظار، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(خدمت)
    همگام سازی.انتظار(گروه انتظار)
    پیکربندی := تی ال اس.پیکربندی کارساز جدید(CERT، KEY)
    آزمایش.ادعای درستی(پیکربندی.سالم)
    آزمایش.ادعای نادرستی(تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/missing.crt"، KEY).سالم)
    آزمایش.ادعای نادرستی(تی ال اس.پیکربندی کارساز جدید(CERT، "tests/fixtures/ssl/missing.key").سالم)

    سوکت := تی سی پی.شماره گیری("127.0.0.1"، PORT)
    ناپایا پیکربندی مشتری := تی ال اس.پیکربندی جدید("localhost")
    پیکربندی مشتری.پرونده گواهی ریشه = CERT
    ناپایا اتصال := تی ال اس.پوشش کارخواه(سوکت.توصیفگر، پیکربندی مشتری)
    آزمایش.ادعای درستی(تی ال اس.اتصال معتبر(اتصال))
    آزمایش.ادعای برابری عدد۶۴(تی ال اس.توصیفگر(اتصال)، سوکت.توصیفگر)
    آزمایش.ادعای برابری رشته(تی ال اس.نسخه(اتصال)، "TLS1.3")
    _ := تی ال اس.نوشتن(اتصال، "ping")
    آزمایش.ادعای برابری رشته(تی ال اس.خواندن(اتصال، 1024)، "echo:ping")
    تی ال اس.جداسازی اتصال(اتصال)
    آزمایش.ادعای نادرستی(تی ال اس.اتصال معتبر(اتصال))
    تی سی پی.بستن(سوکت)

    سوکت دوم := تی سی پی.شماره گیری("127.0.0.1"، PORT)
    ناپایا رد شده := تی ال اس.پوشش کارخواه(سوکت دوم.توصیفگر، تی ال اس.پیکربندی جدید("localhost"))
    آزمایش.ادعای نادرستی(تی ال اس.اتصال معتبر(رد شده))
    تی ال اس.جداسازی اتصال(رد شده)
    تی سی پی.بستن(سوکت دوم)
    نخ‌پیوند(t)
پایان

