تابع test_certs() خطادار:
    متن := ورودی خروجی.خواندن پرونده(CERT)
    آغاز := "-----BEGIN CERTIFICATE-----"
    شروع := متن.بیاب(آغاز) + آغاز.طول()
    انتها := متن.بیاب("-----END CERTIFICATE-----")
    بدنه پم := متن.زیررشته(شروع، انتها - شروع)
    ظرفیت := بدنه پم.طول()
    ناپایا دی ای آر := تی ال اس.بافر جدید(ظرفیت)
    دی ای آر.len = تلاش کدگذاری.کدگشایی پایه۶۴ به بایت(بدنه پم، دی ای آر.p، ظرفیت)
    آزمایش.ادعای درستی(دی ای آر.len بزرگتر 0)
    ناپایا بافر کوچک := تی ال اس.بافر جدید(8)
    ناپایا سرریز := نادرست
    تلاش:
        بافر کوچک.len = کدگذاری.کدگشایی پایه۶۴ به بایت(بدنه پم، بافر کوچک.p، 8)
    گرفتن خطا e:
        سرریز = e.است(نوع خطا.خارج از بازه)
    پایان
    آزمایش.ادعای درستی(سرریز)
    آزمایش.ادعای درستی(تی ال اس.طول بافر(دی ای آر) بزرگتر 400)
    آزمایش.ادعای درستی(تی ال اس.گواهی معتبر است(دی ای آر))
    آزمایش.ادعای برابری رشته(تی ال اس.نام مشترک گواهی(دی ای آر)، "localhost")
    ناپایا ناسالم := تی ال اس.کدگشایی شانزدهی("3082")
    آزمایش.ادعای نادرستی(تی ال اس.گواهی معتبر است(ناسالم))
    آزمایش.ادعای برابری رشته(تی ال اس.نام مشترک گواهی(ناسالم)، "")

    ناپایا ریشه ها := تی ال اس.بارگذاری ریشه ها(CERT)
    آزمایش.ادعای برابری عدد(تی ال اس.تعداد ریشه ها(ریشه ها)، 1)
    آزمایش.ادعای برابری عدد(تی ال اس.تایید گواهی(دی ای آر، ریشه ها، "localhost")، 0)
    اشتباه := تی ال اس.تایید گواهی(دی ای آر، ریشه ها، "other.example")
    آزمایش.ادعای درستی(اشتباه نابرابر 0)
    آزمایش.ادعای برابری رشته(تی ال اس.خطای تایید(اشتباه)، "hostname does not match certificate")
    آزمایش.ادعای برابری رشته(تی ال اس.خطای تایید(0)، "ok")
    ناپایا خالی := تی ال اس.بارگذاری ریشه ها("tests/fixtures/ssl/missing.crt")
    آزمایش.ادعای برابری عدد(تی ال اس.تعداد ریشه ها(خالی)، 0)
    نامعتبر := تی ال اس.تایید گواهی(دی ای آر، خالی، "localhost")
    آزمایش.ادعای برابری رشته(تی ال اس.خطای تایید(نامعتبر)، "no trusted issuer found")
    ناپایا زنجیره := تی ال اس.بارگذاری فایل زنجیره گواهی(CERT)
    آزمایش.ادعای برابری عدد(تی ال اس.تعداد ریشه ها(زنجیره)، 1)
    تی ال اس.آزادسازی ریشه ها(ریشه ها)
    تی ال اس.آزادسازی ریشه ها(خالی)
