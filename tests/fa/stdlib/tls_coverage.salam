تابع test_buffers():
    ناپایا b := تی ال اس.درهم ساز(نادرست، "abc")
    آزمایش.ادعای برابری عدد(تی ال اس.طول بافر(b)، 32)
    آزمایش.ادعای برابری رشته(تی ال اس.کدگذاری شانزدهی(b)، "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    ناپایا wide := تی ال اس.درهم ساز(درست، "abc")
    آزمایش.ادعای برابری عدد(تی ال اس.طول بافر(wide)، 48)
    ناپایا hex := تی ال اس.کدگشایی شانزدهی("cafe")
    تی ال اس.افزودن رشته به بافر(hex، "!")
    آزمایش.ادعای برابری عدد(تی ال اس.طول بافر(hex)، 3)
    آزمایش.ادعای برابری رشته(تی ال اس.کدگذاری شانزدهی(hex)، "cafe21")
    ناپایا zeros := تی ال اس.بافر صفر جدید(4)
    آزمایش.ادعای برابری رشته(تی ال اس.کدگذاری شانزدهی(zeros)، "00000000")
    ناپایا empty := تی ال اس.بافر جدید(64)
    آزمایش.ادعای برابری عدد(تی ال اس.طول بافر(empty)، 0)
    تی ال اس.پاک سازی بافر(hex)
    آزمایش.ادعای برابری عدد(تی ال اس.طول بافر(hex)، 0)
    تی ال اس.آزادسازی بافر(b)
    تی ال اس.آزادسازی بافر(wide)
    تی ال اس.آزادسازی بافر(zeros)
    تی ال اس.آزادسازی بافر(empty)
