تابع test_ecdsa():
    ناپایا کلید := تی ال اس.تجزیه کلید خصوصی پم(EC_KEY)
    آزمایش.ادعای درستی(کلید.ok)
    ناپایا چکیده := تی ال اس.درهم ساز(نادرست، "message")
    ناپایا r := تی ال اس.بافر صفر جدید(32)
    ناپایا s := تی ال اس.بافر صفر جدید(32)
    آزمایش.ادعای درستی(تی ال اس.امضای بیضوی(کلید، چکیده، r، s))
    ناپایا دی ای آر := تی ال اس.کدگذاری دی ای آر بیضوی(r، s، 32)
    آزمایش.ادعای درستی(تی ال اس.طول بافر(دی ای آر) بزرگتربرابر 8)
    آزمایش.ادعای درستی(تی ال اس.تایید دی ای آر بیضوی با کلید(کلید، چکیده، دی ای آر))
    ناپایا چکیده دیگر := تی ال اس.درهم ساز(نادرست، "another")
    آزمایش.ادعای نادرستی(تی ال اس.تایید دی ای آر بیضوی با کلید(کلید، چکیده دیگر، دی ای آر))
    تی ال اس.آزادسازی بافر(چکیده)
    تی ال اس.آزادسازی بافر(r)
    تی ال اس.آزادسازی بافر(s)
    تی ال اس.آزادسازی بافر(دی ای آر)
    تی ال اس.آزادسازی بافر(چکیده دیگر)
    تی ال اس.آزادسازی کلید خصوصی(کلید)
