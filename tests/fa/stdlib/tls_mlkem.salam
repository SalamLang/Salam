واردسازی حافظه
واردسازی تی ال اس

تابع unhex(h: رشته): تهی*:
    n := h.طول() / 2
    p := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
    bp := p برگردان طبیعی۸*
    digits := "0123456789abcdef"
    تکرار n در i:
        a := digits.بیاب(h.زیررشته(2 * i، 1))
        b := digits.بیاب(h.زیررشته(2 * i + 1، 1))
        bp[i] = (a * 16 + b) برگردان طبیعی۸
    پایان
    برگشت p
پایان

تابع hex(p: تهی*، n: صحیح): رشته:
    bp := p برگردان طبیعی۸*
    digits := "0123456789abcdef"
    ناپایا s := ""
    تکرار n در i:
        v := bp[i] برگردان صحیح
        s += digits.زیررشته(v >> 4، 1) + digits.زیررشته(v & 15، 1)
    پایان
    برگشت s
پایان

تابع ریشه:
    seed := unhex("0104070a0d101316191c1f2225282b2e3134373a3d404346494c4f5255585b5e6164676a6d707376797c7f8285888b8e9194979a9da0a3a6a9acafb2b5b8bbbe")
    ek := حافظه.تخصیص صفرشده(1184 برگردان طبیعی۶۴)
    تی ال اس.کلید عمومی ام ال کم۷۶۸(seed، ek)
    سرچاپ "ml-kem-768 public key from the seed:"، hex(ek، 1184) برابر ""
    ct := unhex("")
    ss := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    تی ال اس.بازگشایی ام ال کم۷۶۸(seed، ct، ss)
    سرچاپ "decapsulation of a ciphertext made by another implementation:"، hex(ss، 32) برابر "9383b70278abc5bf9c4e0ba1dc763dac6bf1df300c5c0ae3dc91b19a58659b09"
    m := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    تکرار 32 در i:
        (m برگردان طبیعی۸*)[i] = (i * 5 + 9) برگردان طبیعی۸
    پایان
    ct2 := حافظه.تخصیص صفرشده(1088 برگردان طبیعی۶۴)
    ss2 := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    ok := تی ال اس.کپسوله سازی ام ال کم۷۶۸(ek، m، ct2، ss2)
    سرچاپ "encapsulation:"، ok، hex(ss2، 32) برابر "1815dfe162eed8db9482cd93071e953bf4a6d8e56077c1e884b1127e4b7d2420"
    back := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    تی ال اس.بازگشایی ام ال کم۷۶۸(seed، ct2، back)
    سرچاپ "round trip:"، hex(back، 32) برابر hex(ss2، 32)
    bad := unhex("")
    (bad برگردان طبیعی۸*)[100] = (((bad برگردان طبیعی۸*)[100] برگردان صحیح) ^ 1) برگردان طبیعی۸
    rej := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    تی ال اس.بازگشایی ام ال کم۷۶۸(seed، bad، rej)
    سرچاپ "a damaged ciphertext gives the implicit rejection key:"، hex(rej، 32) برابر "143215aa8f8cf340579aece8de259f642715a0d630654ffc671dc7f9c6ce9f28"، hex(rej، 32) نابرابر hex(ss، 32)
پایان
