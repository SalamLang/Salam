بسته ریشه

واردسازی کدگذاری.تامل
واردسازی کدگذاری.مقدار

تابع نمایش شکست(v: مقدار.مقدار):
    تلاش:
        متن := تامل.کدگذاری(v)
        سرچاپ "encoded"، متن
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.پشتیبانی نشده)، e.کد
        سرچاپ e.به رشته()
    پایان
پایان

تابع ریشه:
    تلاش:
        سند := تامل.کدگشایی("title = \"demo\"\nport = 8080\n[db]\nhost = \"local\"\n")
        متن := تامل.کدگذاری(سند)
        سرچاپ متن
        سرچاپ تامل.معتبر(متن)
        سرچاپ تامل.کدگذاری(مقدار.شیء جدید()) برابر ""
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    نمایش شکست(مقدار.مقدار صحیح(5 برگردان صحیح۶۴))
    نمایش شکست(مقدار.مقدار رشته("loose"))
    نمایش شکست(مقدار.آرایه جدید())
پایان
