بسته ریشه

واردسازی کدگذاری.تامل
واردسازی کدگذاری.مقدار

تابع ریشه:
    ناپایا ok := نادرست
    obj := تامل.کدگشایی سخت گیرانه("title = \"demo\"\nport = 8080\n[db]\nhost = \"local\"\n"، ok)
    سرچاپ ok
    text := تامل.کدگذاری سخت گیرانه(obj، ok)
    سرچاپ ok
    سرچاپ text
    سرچاپ تامل.معتبر(text)
    _ := تامل.کدگذاری سخت گیرانه(مقدار.مقدار صحیح(5 برگردان صحیح۶۴)، ok)
    سرچاپ ok
    s := تامل.کدگذاری سخت گیرانه(مقدار.مقدار رشته("loose")، ok)
    سرچاپ ok، s برابر ""
    _ := تامل.کدگذاری سخت گیرانه(مقدار.آرایه جدید()، ok)
    سرچاپ ok
    سرچاپ تامل.کدگذاری سخت گیرانه(مقدار.شیء جدید()، ok) برابر ""، ok
پایان
