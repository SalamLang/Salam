بسته ریشه

واردسازی کدگذاری.تامل
واردسازی کدگذاری.مقدار

تابع show_failure(v: مقدار.مقدار):
    تلاش:
        text := تامل.کدگذاری(v)
        سرچاپ "encoded"، text
    گرفتن خطا e:
        سرچاپ e.است(نوع خطا.پشتیبانی نشده)، e.کد
        سرچاپ e.به رشته()
    پایان
پایان

تابع ریشه:
    تلاش:
        obj := تامل.کدگشایی("title = \"demo\"\nport = 8080\n[db]\nhost = \"local\"\n")
        text := تامل.کدگذاری(obj)
        سرچاپ text
        سرچاپ تامل.معتبر(text)
        سرچاپ تامل.کدگذاری(مقدار.شیء جدید()) برابر ""
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    show_failure(مقدار.مقدار صحیح(5 برگردان صحیح۶۴))
    show_failure(مقدار.مقدار رشته("loose"))
    show_failure(مقدار.آرایه جدید())
پایان
