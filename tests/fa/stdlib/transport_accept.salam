واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.تی سی پی
واردسازی شبکه.انتقال شبکه

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا port := 0
ناپایا want_n := 0
ناپایا shared_l := انتقال شبکه.شنونده {}
ناپایا idle_result := 0
ناپایا served := وکتور {} برگردان وکتور<رشته>


تابع collect_server():
    تکرار want_n:
        ناپایا c := انتقال شبکه.پذیرش(shared_l)
        اگر انتقال شبکه.معتبر(c):
            buf := حافظه.تخصیص(64 برگردان طبیعی۶۴)
            n := انتقال شبکه.خواندن(c، buf، 64)
            انتقال شبکه.نوشتن(c، buf، n)
            انتقال شبکه.بستن(c)
            حافظه.آزادسازی(buf)
            served.بیفزا("served")
        وگرنه:
            served.بیفزا(c.خطا)
        پایان
    پایان
پایان

تابع slowloris_check():
    ناپایا ss := انتقال شبکه.تنظیمات {}
    ss.شبکه = "ws"
    ss.مسیر = "/slow"
    ss.مهلت دست دادن = 1500
    l := انتقال شبکه.شنود(0، ss)
    p := انتقال شبکه.درگاه شنونده(l)
    slow := تی سی پی.شماره گیری("127.0.0.1"، p)
    تی سی پی.نوشتن(slow، "GET /slow HTTP/1.1\r\nHost: x\r\n")
    shared_l = l
    want_n = 2
    t := نخ‌ساز(collect_server)
    ناپایا cs := انتقال شبکه.تنظیمات {}
    cs.شبکه = "ws"
    cs.مسیر = "/slow"
    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، p، cs)
    ناپایا good := انتقال شبکه.معتبر(c)
    اگر good:
        انتقال شبکه.نوشتن(c، "ping" برگردان تهی*، 4)
        back := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
        good = انتقال شبکه.خواندن کامل(c، back، 4)
        حافظه.آزادسازی(back)
        انتقال شبکه.بستن(c)
    پایان
    first := served.طول()
    نخ‌پیوند(t)
    سرچاپ "slow client did not block a good one:"، good، "served before the slow timeout:"، first بزرگتربرابر 1
    سرچاپ "results:"، served.بگیر(0)، "/"، served.بگیر(1)
    تی سی پی.بستن(slow)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع flood_check():
    ناپایا ss := انتقال شبکه.تنظیمات {}
    ss.شبکه = "ws"
    ss.مهلت دست دادن = 1500
    ss.بیشینه دست دادن همزمان = 2
    l := انتقال شبکه.شنود(0، ss)
    p := انتقال شبکه.درگاه شنونده(l)
    shared_l = l
    want_n = 1
    t := نخ‌ساز(collect_server)
    ناپایا ready_c := انتقال شبکه.شماره گیری("127.0.0.1"، p، انتقال شبکه.تنظیمات {})
    ناپایا conns := وکتور {} برگردان وکتور<تی سی پی.اتصال شبکه>
    تکرار 5:
        conns.بیفزا(تی سی پی.شماره گیری("127.0.0.1"، p))
    پایان
    همگام سازی.خواب میلی ثانیه(300)
    ناپایا dropped := 0
    تکرار 5 در i:
        c := conns.بگیر(i)
        تی سی پی.تنظیم مهلت خواندن(c، 100)
        buf := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
        n := تی سی پی.خواندن بایت(c، buf، 16)
        اگر n برابر 0:
            dropped++
        پایان
        حافظه.آزادسازی(buf)
        تی سی پی.بستن(c)
    پایان
    سرچاپ "connections dropped over the handshake limit:"، dropped بزرگتربرابر 2
    اگر انتقال شبکه.معتبر(ready_c):
        انتقال شبکه.بستن(ready_c)
    پایان
    نخ‌پیوند(t)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع idle_server():
    ناپایا c := انتقال شبکه.پذیرش(shared_l)
    اگر انتقال شبکه.معتبر(c):
        buf := حافظه.تخصیص(16 برگردان طبیعی۶۴)
        n := انتقال شبکه.خواندن(c، buf، 16)
        idle_result = n
        حافظه.آزادسازی(buf)
        انتقال شبکه.بستن(c)
    پایان
پایان

تابع idle_check():
    ناپایا ss := انتقال شبکه.تنظیمات {}
    ss.مهلت بی کاری خواندن = 300
    ss.مهلت بی کاری نوشتن = 300
    idle_result = 99
    l := انتقال شبکه.شنود(0، ss)
    p := انتقال شبکه.درگاه شنونده(l)
    shared_l = l
    t := نخ‌ساز(idle_server)
    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، p، انتقال شبکه.تنظیمات {})
    نخ‌پیوند(t)
    سرچاپ "idle read ended without data:"، idle_result کوچکتربرابر 0
    انتقال شبکه.بستن(c)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع bind_check():
    plain := انتقال شبکه.تنظیمات {}
    l := انتقال شبکه.شنود(0، plain)
    p := انتقال شبکه.درگاه شنونده(l)
    ok_lo := تی سی پی.اتصال معتبر(تی سی پی.شماره گیری("127.0.0.1"، p))
    ناپایا refused := درست
    اگر سلام سیستم لینوکس:
        refused = وارونه تی سی پی.اتصال معتبر(تی سی پی.شماره گیری("127.0.0.2"، p))
    پایان
    سرچاپ "default listener is loopback only:"، ok_lo، refused
    انتقال شبکه.بستن شنونده(l)
    a := انتقال شبکه.شنود همه(0، plain)
    pa := انتقال شبکه.درگاه شنونده(a)
    ناپایا open_all := درست
    اگر سلام سیستم لینوکس:
        open_all = تی سی پی.اتصال معتبر(تی سی پی.شماره گیری("127.0.0.2"، pa))
    پایان
    سرچاپ "listen all accepts other addresses:"، open_all
    انتقال شبکه.بستن شنونده(a)
    b := انتقال شبکه.شنود در نشانی("127.0.0.1"، 0، plain)
    سرچاپ "listen at works:"، انتقال شبکه.شنونده معتبر(b)، انتقال شبکه.درگاه شنونده(b) بزرگتر 0
    انتقال شبکه.بستن شنونده(b)
پایان

تابع ریشه:
    bind_check()
    slowloris_check()
    flood_check()
    idle_check()
پایان
