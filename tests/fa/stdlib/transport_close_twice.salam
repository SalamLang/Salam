واردسازی حافظه
واردسازی شبکه.انتقال شبکه

تابع ریشه:
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port := انتقال شبکه.درگاه شنونده(l)
    first := انتقال شبکه.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {})
    ناپایا second := انتقال شبکه.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {})
    ناپایا third := انتقال شبکه.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {})
    ناپایا a := انتقال شبکه.پذیرش خام(l)
    ناپایا b := انتقال شبکه.پذیرش خام(l)
    ناپایا c := انتقال شبکه.پذیرش خام(l)
    stream := انتقال شبکه.به عنوان جریان(first)
    stream.بستن()
    stream.بستن()
    سرچاپ "first connection closed:"، stream.معتبر()
    ناپایا reuse := انتقال شبکه.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {})
    ناپایا d := انتقال شبکه.پذیرش خام(l)
    stream.بستن()
    stream.بستن()
    msg := "still here"
    سرچاپ "a closed stream closed again does not touch a newer connection:"، انتقال شبکه.نوشتن(reuse، msg برگردان تهی*، msg.طول())
    buf := حافظه.تخصیص(32 برگردان طبیعی۶۴)
    n := انتقال شبکه.خواندن(d، buf، 32)
    سرچاپ "the newer connection delivered"، n، "bytes"
    حافظه.آزادسازی(buf)
    انتقال شبکه.بستن(second)
    انتقال شبکه.بستن(second)
    انتقال شبکه.بستن(third)
    انتقال شبکه.بستن(a)
    انتقال شبکه.بستن(b)
    انتقال شبکه.بستن(c)
    انتقال شبکه.بستن(d)
    انتقال شبکه.بستن(reuse)
    انتقال شبکه.بستن شنونده(l)
پایان
