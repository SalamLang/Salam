واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.تی سی پی
واردسازی شبکه.انتقال شبکه

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا sink_port := 0
ناپایا got := انتقال شبکه.بایت‌های جدید(4096)
ناپایا chunks := وکتور {} برگردان وکتور<صحیح>
ناپایا srv_ok := نادرست
ناپایا srv_settings := انتقال شبکه.تنظیمات {}
ناپایا echo_port := 0

تابع sink():
    srv := تی سی پی.پیوند(0)
    sink_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    c := تی سی پی.پذیرش(srv)
    buf := حافظه.تخصیص صفرشده(4096 برگردان طبیعی۶۴)
    تی سی پی.تنظیم مهلت خواندن(c، 700)
    انتقال شبکه.بازنشانی بایت‌ها(got)
    chunks = وکتور {} برگردان وکتور<صحیح>
    تا درست:
        n := تی سی پی.خواندن بایت(c، buf، 4096)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        chunks.بیفزا(n)
        انتقال شبکه.نوشتن خام(got، buf، n)
    پایان
    حافظه.آزادسازی(buf)
    تی سی پی.بستن(c)
    تی سی پی.بستن سرور(srv)
پایان

تابع contains(b: انتقال شبکه.بایت‌ها، lo: صحیح، hi: صحیح، needle: رشته): منطقی:
    nb := needle برگردان طبیعی۸*
    ناپایا i := lo
    تا i + needle.طول() کوچکتربرابر hi:
        ناپایا same := درست
        تکرار needle.طول() در k:
            اگر انتقال شبکه.بایت در(b، i + k) نابرابر (nb[k] برگردان صحیح):
                same = نادرست
                بشکن
            پایان
        پایان
        اگر same:
            برگشت درست
        پایان
        i++
    پایان
    برگشت نادرست
پایان

تابع run_case(label: رشته، s: انتقال شبکه.تنظیمات، sni_case: منطقی):
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(sink)
    همگام سازی.انتظار(ready)
    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، sink_port، s)
    نخ‌پیوند(t)
    ناپایا records := 0
    ناپایا payload := 0
    ناپایا whole := درست
    ناپایا off := 0
    ناپایا hs_len := 0
    ناپایا first_rec_has_name := نادرست
    ناپایا ws := انتقال شبکه.بایت‌ها {}
    ws = انتقال شبکه.بایت‌های جدید(got.طول + 1)
    تا off + 5 کوچکتربرابر got.طول:
        rl := انتقال شبکه.خواندن شانزده بیت(got، off + 3)
        اگر off + 5 + rl بزرگتر got.طول:
            whole = نادرست
            بشکن
        پایان
        اگر انتقال شبکه.بایت در(got، off) نابرابر 22:
            whole = نادرست
        پایان
        انتقال شبکه.نوشتن خام(ws، انتقال شبکه.نشانگر بایت‌ها(got، off + 5)، rl)
        اگر records برابر 0:
            first_rec_has_name = contains(got، off + 5، off + 5 + rl، "www.example.org")
        پایان
        records++
        payload += rl
        off += 5 + rl
    پایان
    اگر ws.طول بزرگتربرابر 4:
        hs_len = (انتقال شبکه.بایت در(ws، 1) << 16) | (انتقال شبکه.بایت در(ws، 2) << 8) | انتقال شبکه.بایت در(ws، 3)
    پایان
    ناپایا name_in_one_read := نادرست
    ناپایا pos := 0
    تکرار chunks.طول() در i:
        n := chunks.بگیر(i)
        اگر contains(got، pos، pos + n، "www.example.org"):
            name_in_one_read = درست
        پایان
        pos += n
    پایان
    سرچاپ label، "records split:"، records بزرگتر 1، "complete:"، whole و off برابر got.طول
    اگر s.تاخیر تکه میلی ثانیه بزرگتر 0:
        سرچاپ label، "reads split:"، chunks.طول() بزرگتر 1
    پایان
    سرچاپ label، "handshake length matches:"، hs_len + 4 برابر payload، "name present after reassembly:"، contains(ws، 0، ws.طول، "www.example.org")
    اگر sni_case:
        سرچاپ label، "name cut by a record boundary:"، وارونه first_rec_has_name و records بزرگتر 1، "name cut by a read boundary:"، وارونه name_in_one_read
    پایان
    انتقال شبکه.آزادسازی بایت‌ها(ws)
    اگر انتقال شبکه.معتبر(c):
        انتقال شبکه.بستن(c)
    پایان
پایان

تابع echo_server():
    l := انتقال شبکه.شنود(0، srv_settings)
    echo_port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا c := انتقال شبکه.پذیرش(l)
    اگر انتقال شبکه.معتبر(c):
        buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
        n := انتقال شبکه.خواندن(c، buf، 4096)
        انتقال شبکه.نوشتن(c، buf، n)
        srv_ok = درست
        انتقال شبکه.بستن(c)
        حافظه.آزادسازی(buf)
    پایان
    انتقال شبکه.بستن شنونده(l)
پایان

تابع real_server(label: رشته، cs: انتقال شبکه.تنظیمات):
    srv_ok = نادرست
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(echo_server)
    همگام سازی.انتظار(ready)
    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، echo_port، cs)
    ناپایا good := انتقال شبکه.معتبر(c)
    اگر good:
        انتقال شبکه.نوشتن(c، "abcdefgh" برگردان تهی*، 8)
        back := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
        good = انتقال شبکه.خواندن کامل(c، back، 8)
        حافظه.آزادسازی(back)
        انتقال شبکه.بستن(c)
    پایان
    نخ‌پیوند(t)
    سرچاپ label، "handshake and echo with a fragmented hello:"، good، srv_ok
پایان

تابع base(): انتقال شبکه.تنظیمات:
    ناپایا s := انتقال شبکه.تنظیمات {}
    s.تی ال اس = درست
    s.اجازه ناامن = درست
    s.نام سرور = "www.example.org"
    s.تکه تکه کردن = درست
    s.تاخیر تکه میلی ثانیه = 20
    برگشت s
پایان

تابع ریشه:
    ناپایا a := base()
    a.حالت تکه تکه کردن = "tls"
    a.کمینه تکه = 5
    a.بیشینه تکه = 20
    a.تاخیر تکه میلی ثانیه = 0
    run_case("tls records"، a، نادرست)

    ناپایا b := base()
    b.حالت تکه تکه کردن = "both"
    b.کمینه تکه = 10
    b.بیشینه تکه = 30
    b.تاخیر تکه میلی ثانیه = 5
    run_case("both"، b، نادرست)

    ناپایا c := base()
    c.حالت تکه تکه کردن = "tcp"
    c.کمینه تکه = 0
    c.بیشینه تکه = 0
    c.برش نام سرور = درست
    run_case("tcp at sni"، c، درست)

    ناپایا d := base()
    d.حالت تکه تکه کردن = "tls"
    d.کمینه تکه = 0
    d.بیشینه تکه = 0
    d.برش نام سرور = درست
    d.تاخیر تکه میلی ثانیه = 20
    run_case("tls at sni"، d، درست)

    srv_settings.تی ال اس = درست
    srv_settings.پرونده گواهی = "tests/fixtures/ssl/server.crt"
    srv_settings.پرونده کلید = "tests/fixtures/ssl/server.key"
    real_server("tls records"، a)
    real_server("both"، b)
    ناپایا e := b
    e.شمار نوشتن های تکه شده = 3
    real_server("three writes"، e)
پایان
