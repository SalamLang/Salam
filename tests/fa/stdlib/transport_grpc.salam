واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا port := 0
ناپایا srv_settings := انتقال شبکه.تنظیمات {}
ناپایا srv_conns := 2
ناپایا srv_path := ""

تابع echo_conn():
    l := انتقال شبکه.شنود(0، srv_settings)
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا handled := 0
    تا handled کوچکتر srv_conns:
        ناپایا c := انتقال شبکه.پذیرش(l)
        اگر انتقال شبکه.معتبر(c):
            srv_path = c.مسیر درخواست
            buf := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
            تا درست:
                n := انتقال شبکه.خواندن(c، buf، 65536)
                اگر n کوچکتربرابر 0:
                    بشکن
                پایان
                اگر وارونه انتقال شبکه.نوشتن(c، buf، n):
                    بشکن
                پایان
            پایان
            حافظه.آزادسازی(buf)
            انتقال شبکه.بستن(c)
        پایان
        handled++
    پایان
    انتقال شبکه.بستن شنونده(l)
پایان

تابع pattern(n: صحیح، seed: صحیح): انتقال شبکه.بایت‌ها:
    ناپایا b := انتقال شبکه.بایت‌های جدید(n + 1)
    تکرار n در i:
        انتقال شبکه.نوشتن بایت(b، (i * 7 + seed) & 255)
    پایان
    برگشت b
پایان

تابع scenario(label: رشته، cs: انتقال شبکه.تنظیمات، ss: انتقال شبکه.تنظیمات، conns: صحیح):
    srv_settings = ss
    srv_conns = conns
    srv_path = ""
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(echo_conn)
    همگام سازی.انتظار(ready)
    ناپایا total := 0
    ناپایا good := درست
    تکرار conns:
        ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، port، cs)
        اگر وارونه انتقال شبکه.معتبر(c):
            سرچاپ label، "dial failed:"، c.خطا
            good = نادرست
            بشکن
        پایان
        ناپایا sizes := وکتور {} برگردان وکتور<صحیح>
        sizes.بیفزا(11)
        sizes.بیفزا(300)
        sizes.بیفزا(70000)
        sizes.بیفزا(200000)
        تکرار sizes.طول() در i:
            n := sizes.بگیر(i)
            ناپایا out := pattern(n، i + 5)
            back := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
            اگر وارونه انتقال شبکه.نوشتن(c، out.نشانگر، n):
                good = نادرست
            پایان
            اگر وارونه انتقال شبکه.خواندن کامل(c، back، n):
                good = نادرست
            وگرنه:
                bp := back برگردان طبیعی۸*
                تکرار n در k:
                    اگر (bp[k] برگردان صحیح) نابرابر ((k * 7 + i + 5) & 255):
                        good = نادرست
                        بشکن
                    پایان
                پایان
            پایان
            total += n
            حافظه.آزادسازی(back)
            انتقال شبکه.آزادسازی بایت‌ها(out)
        پایان
        sizes.آزادکن()
        انتقال شبکه.بستن(c)
    پایان
    نخ‌پیوند(t)
    سرچاپ label، "echo ok:"، good، "bytes:"، total، "path:"، srv_path
پایان

تابع refused():
    ناپایا ss := انتقال شبکه.تنظیمات {}
    ss.شبکه = "grpc"
    ss.نام سرویس = "RealService"
    ss.تی ال اس = درست
    ss.پرونده گواهی = "tests/fixtures/ssl/server.crt"
    ss.پرونده کلید = "tests/fixtures/ssl/server.key"
    srv_settings = ss
    srv_conns = 1
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(echo_conn)
    همگام سازی.انتظار(ready)
    ناپایا cs := ss
    cs.اجازه ناامن = درست
    cs.نام سرور = "www.example.org"
    cs.نام سرویس = "OtherService"
    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، port، cs)
    ناپایا n := 0 - 1
    اگر انتقال شبکه.معتبر(c):
        buf := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
        n = انتقال شبکه.خواندن(c، buf، 16)
        حافظه.آزادسازی(buf)
        انتقال شبکه.بستن(c)
    پایان
    سرچاپ "wrong service name is refused:"، n کوچکتربرابر 0
    ناپایا good := cs
    good.نام سرویس = "RealService"
    ناپایا g := انتقال شبکه.شماره گیری("127.0.0.1"، port، good)
    ناپایا ok := انتقال شبکه.معتبر(g)
    اگر ok:
        انتقال شبکه.نوشتن(g، "ping" برگردان تهی*، 4)
        back := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
        ok = انتقال شبکه.خواندن کامل(g، back، 4)
        حافظه.آزادسازی(back)
        انتقال شبکه.بستن(g)
    پایان
    سرچاپ "right service name still works after a refusal:"، ok
    نخ‌پیوند(t)
پایان

تابع ریشه:
    ناپایا gun := انتقال شبکه.تنظیمات {}
    gun.شبکه = "grpc"
    gun.نام سرویس = "GunService"
    gun.تی ال اس = درست
    gun.اجازه ناامن = درست
    gun.نام سرور = "www.example.org"
    ناپایا gun_srv := gun
    gun_srv.اجازه ناامن = نادرست
    gun_srv.پرونده گواهی = "tests/fixtures/ssl/server.crt"
    gun_srv.پرونده کلید = "tests/fixtures/ssl/server.key"
    scenario("gun"، gun، gun_srv، 2)

    ناپایا multi := gun
    multi.حالت جی آر پی سی = "multi"
    multi.نام سرویس = "my/svc"
    ناپایا multi_srv := gun_srv
    multi_srv.نام سرویس = "my/svc"
    scenario("multi"، multi، multi_srv، 1)

    ناپایا plain := gun
    plain.تی ال اس = نادرست
    ناپایا plain_srv := gun_srv
    plain_srv.تی ال اس = نادرست
    scenario("h2c gun"، plain، plain_srv، 1)

    refused()
پایان
