واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.تی سی پی
واردسازی شبکه.انتقال شبکه

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا srv_settings := انتقال شبکه.تنظیمات {}
ناپایا srv_err := ""
ناپایا srv_path := ""
ناپایا srv_early := 0
ناپایا hello_reads := 0
ناپایا hello_total := 0
ناپایا hello_ok := نادرست
ناپایا hello_sni := نادرست
ناپایا hello_port := 0

تابع echo_server():
    l := انتقال شبکه.شنود(0، srv_settings)
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    اگر وارونه انتقال شبکه.شنونده معتبر(l):
        srv_err = "listener failed"
        برگشت
    پایان
    ناپایا c := انتقال شبکه.پذیرش(l)
    اگر انتقال شبکه.معتبر(c):
        srv_path = c.مسیر درخواست
        srv_early = c.پیش خوانده.طول
        buf := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
        تا درست:
            n := انتقال شبکه.خواندن(c، buf، 65536)
            اگر n کوچکتربرابر 0:
                بشکن
            پایان
            انتقال شبکه.نوشتن(c، buf، n)
        پایان
        حافظه.آزادسازی(buf)
        انتقال شبکه.بستن(c)
    وگرنه:
        srv_err = c.خطا
    پایان
    انتقال شبکه.بستن شنونده(l)
پایان

تابع hello_sink():
    srv := تی سی پی.پیوند(0)
    hello_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    c := تی سی پی.پذیرش(srv)
    buf := حافظه.تخصیص صفرشده(4096 برگردان طبیعی۶۴)
    bp := buf برگردان طبیعی۸*
    ناپایا got := 0
    ناپایا want := 5
    تی سی پی.تنظیم مهلت خواندن(c، 3000)
    تا got کوچکتر want:
        n := تی سی پی.خواندن بایت(c، ((buf برگردان صحیح۶۴) + (got برگردان صحیح۶۴)) برگردان تهی*، want - got)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        hello_reads++
        got += n
        اگر got بزرگتربرابر 5 و want برابر 5:
            want = 5 + (bp[3] برگردان صحیح) * 256 + (bp[4] برگردان صحیح)
        پایان
    پایان
    hello_total = got
    hello_ok = got برابر want و (bp[0] برگردان صحیح) برابر 22 و (bp[1] برگردان صحیح) برابر 3
    ناپایا found := نادرست
    needle := "www.example.org"
    nb := needle برگردان طبیعی۸*
    تکرار got - 15 در i:
        ناپایا same := درست
        تکرار 15 در k:
            اگر bp[i + k] نابرابر nb[k]:
                same = نادرست
                بشکن
            پایان
        پایان
        اگر same:
            found = درست
            بشکن
        پایان
    پایان
    hello_sni = found
    حافظه.آزادسازی(buf)
    تی سی پی.بستن(c)
    تی سی پی.بستن سرور(srv)
پایان

تابع hello_check():
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(hello_sink)
    همگام سازی.انتظار(ready)
    ناپایا s := انتقال شبکه.تنظیمات {}
    s.تی ال اس = درست
    s.اجازه ناامن = درست
    s.نام سرور = "www.example.org"
    s.تکه تکه کردن = درست
    s.کمینه تکه = 4
    s.بیشینه تکه = 8
    s.تاخیر تکه میلی ثانیه = 1
    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، hello_port، s)
    نخ‌پیوند(t)
    سرچاپ "hello reassembled:"، hello_ok، "sni intact:"، hello_sni، "split into many reads:"، hello_reads بزرگتر 20، "record bytes:"، hello_total بزرگتر 100
    اگر انتقال شبکه.معتبر(c):
        انتقال شبکه.بستن(c)
    پایان
پایان

تابع pattern(n: صحیح، seed: صحیح): انتقال شبکه.بایت‌ها:
    ناپایا b := انتقال شبکه.بایت‌های جدید(n + 1)
    تکرار n در i:
        انتقال شبکه.نوشتن بایت(b، (i * 7 + seed) & 255)
    پایان
    برگشت b
پایان

تابع scenario(label: رشته، cs: انتقال شبکه.تنظیمات، ss: انتقال شبکه.تنظیمات، early: صحیح):
    srv_settings = ss
    srv_err = ""
    srv_path = ""
    srv_early = 0
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(echo_server)
    همگام سازی.انتظار(ready)
    ناپایا e := انتقال شبکه.بایت‌ها {}
    اگر early بزرگتر 0:
        e = pattern(early، 1)
    پایان
    ناپایا c := انتقال شبکه.شماره گیری با داده زودهنگام("127.0.0.1"، port، cs، e)
    اگر وارونه انتقال شبکه.معتبر(c):
        سرچاپ label، "dial failed:"، c.خطا
        نخ‌پیوند(t)
        برگشت
    پایان
    ناپایا good := درست
    ناپایا total := 0
    اگر early بزرگتر 0:
        eb := حافظه.تخصیص صفرشده((early + 1) برگردان طبیعی۶۴)
        اگر وارونه انتقال شبکه.خواندن کامل(c، eb، early):
            good = نادرست
        وگرنه:
            ep := eb برگردان طبیعی۸*
            تکرار early در k:
                اگر (ep[k] برگردان صحیح) نابرابر ((k * 7 + 1) & 255):
                    good = نادرست
                پایان
            پایان
        پایان
        حافظه.آزادسازی(eb)
    پایان
    ناپایا sizes := وکتور {} برگردان وکتور<صحیح>
    sizes.بیفزا(11)
    sizes.بیفزا(300)
    sizes.بیفزا(70000)
    تکرار sizes.طول() در i:
        n := sizes.بگیر(i)
        ناپایا out := pattern(n، i + 5)
        back := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
        اگر وارونه انتقال شبکه.نوشتن(c، out.نشانگر، n):
            good = نادرست
        پایان
        اگر وارونه انتقال شبکه.خواندن کامل(c، back، n):
            good = نادرست
        وگرنه:
            bp := back برگردان طبیعی۸*
            تکرار n در k:
                اگر (bp[k] برگردان صحیح) نابرابر ((k * 7 + i + 5) & 255):
                    good = نادرست
                    بشکن
                پایان
            پایان
        پایان
        total += n
        حافظه.آزادسازی(back)
        انتقال شبکه.آزادسازی بایت‌ها(out)
    پایان
    sizes.آزادکن()
    انتقال شبکه.بستن(c)
    نخ‌پیوند(t)
    سرچاپ label، "echo ok:"، good، "bytes:"، total، "path:"، srv_path، "early:"، srv_early، srv_err
پایان

تابع check_fragments():
    sizes := انتقال شبکه.اندازه تکه ها(100، 3، 9)
    ناپایا sum := 0
    ناپایا ok := درست
    تکرار sizes.طول() در i:
        n := sizes.بگیر(i)
        sum += n
        اگر n بزرگتر 9 یا (n کوچکتر 3 و i نابرابر sizes.طول() - 1):
            ok = نادرست
        پایان
    پایان
    سرچاپ "fragment sizes sum:"، sum، "within bounds:"، ok، "pieces:"، sizes.طول() بزرگتربرابر 12
    sizes.آزادکن()
پایان

تابع ریشه:
    check_fragments()
    hello_check()
    plain := انتقال شبکه.تنظیمات {}
    scenario("tcp"، plain، plain، 0)

    ناپایا ws := انتقال شبکه.تنظیمات {}
    ws.شبکه = "ws"
    ws.مسیر = "/vless-ws"
    ws.سربرگ میزبان = "cdn.example.com"
    ws.سربرگ ها = "X-Test: 1"
    scenario("ws"، ws، ws، 0)

    ناپایا wse := ws
    wse.داده زودهنگام = 2048
    scenario("ws early data"، wse، wse، 100)

    ناپایا hu := انتقال شبکه.تنظیمات {}
    hu.شبکه = "httpupgrade"
    hu.مسیر = "/up"
    scenario("httpupgrade"، hu، hu، 0)

    ناپایا tl := انتقال شبکه.تنظیمات {}
    tl.تی ال اس = درست
    tl.اجازه ناامن = درست
    tl.نام سرور = "www.example.org"
    ناپایا tls_srv := انتقال شبکه.تنظیمات {}
    tls_srv.تی ال اس = درست
    tls_srv.پرونده گواهی = "tests/fixtures/ssl/server.crt"
    tls_srv.پرونده کلید = "tests/fixtures/ssl/server.key"
    scenario("tls"، tl، tls_srv، 0)

    ناپایا wss := ws
    wss.تی ال اس = درست
    wss.اجازه ناامن = درست
    wss.نام سرور = "www.example.org"
    ناپایا wss_srv := ws
    wss_srv.تی ال اس = درست
    wss_srv.پرونده گواهی = "tests/fixtures/ssl/server.crt"
    wss_srv.پرونده کلید = "tests/fixtures/ssl/server.key"
    scenario("wss"، wss، wss_srv، 0)

    ناپایا frag := tl
    frag.تکه تکه کردن = درست
    frag.کمینه تکه = 3
    frag.بیشینه تکه = 9
    frag.تاخیر تکه میلی ثانیه = 1
    scenario("tls fragmented hello"، frag، tls_srv، 0)

    ناپایا bad := ws
    bad.مسیر = "/elsewhere"
    scenario("wrong path"، bad، ws، 0)
پایان
