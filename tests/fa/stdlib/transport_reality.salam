واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا PUB := "IH8tyHx_SyHSCyaQgNTOvHYefAehmhpbMgkwFeAPnXY"
پایا PRIV := "QI3DpbA326sqI7QAAz13iSj6Jk9Q8UUvgkjlKZu2u2I"

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا port := 0
ناپایا srv_settings := انتقال شبکه.تنظیمات {}

تابع server():
    l := انتقال شبکه.شنود(0، srv_settings)
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا c := انتقال شبکه.پذیرش(l)
    اگر انتقال شبکه.معتبر(c):
        buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
        n := انتقال شبکه.خواندن(c، buf، 4096)
        انتقال شبکه.نوشتن(c، buf، n)
        انتقال شبکه.بستن(c)
        حافظه.آزادسازی(buf)
    پایان
    انتقال شبکه.بستن شنونده(l)
پایان

تابع ریشه:
    srv_settings.امنیت = "reality"
    srv_settings.ریلیتی کارساز.کلید خصوصی = PRIV
    srv_settings.ریلیتی کارساز.نام های سرور = "front.example.com"
    srv_settings.ریلیتی کارساز.شناسه های کوتاه = "abcd1234"
    srv_settings.ریلیتی کارساز.مقصد = "127.0.0.1:1"
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
    ناپایا cs := انتقال شبکه.تنظیمات {}
    cs.امنیت = "reality"
    cs.نام سرور = "front.example.com"
    cs.ریلیتی.کلید عمومی = PUB
    cs.ریلیتی.شناسه کوتاه = "abcd1234"
    cs.ریلیتی.اثر انگشت = "chrome"
    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، port، cs)
    ناپایا good := انتقال شبکه.معتبر(c)
    اگر good:
        انتقال شبکه.نوشتن(c، "through reality" برگردان تهی*، 15)
        back := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
        good = انتقال شبکه.خواندن کامل(c، back، 15)
        انتقال شبکه.بستن(c)
        حافظه.آزادسازی(back)
    پایان
    نخ‌پیوند(t)
    سرچاپ "reality transport echo:"، good

    l := وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h.example.com:443?encryption=none&security=reality&pbk=IH8tyHx_SyHSCyaQgNTOvHYefAehmhpbMgkwFeAPnXY&sid=abcd1234&spx=%2F&sni=front.example.com&fp=chrome&flow=xtls-rprx-vision&type=tcp#r")
    سرچاپ "reality link:"، l.معتبر، l.خطا، l.امنیت، l.ریلیتی.کلید عمومی برابر PUB، l.ریلیتی.شناسه کوتاه، l.ریلیتی.اثر انگشت، l.جریان
    s := وی لس.تنظیمات پیوند(l)
    سرچاپ "reality settings:"، s.امنیت، s.ریلیتی.نام سرور، s.ریلیتی.شناسه کوتاه، s.تی ال اس
    again := وی لس.تجزیه پیوند(وی لس.قالب پیوند(l))
    سرچاپ "reality round trip:"، again.معتبر، again.ریلیتی.کلید عمومی برابر PUB، again.ریلیتی.شناسه کوتاه، again.نام سرور، again.جریان
    bad := وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h.example.com:443?security=reality&pbk=short&sid=ab")
    سرچاپ "bad key refused:"، bad.معتبر، bad.خطا
پایان
