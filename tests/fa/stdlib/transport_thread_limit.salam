واردسازی حافظه
واردسازی همگام سازی
واردسازی سیستم عامل
واردسازی تبدیل
واردسازی شبکه.تی سی پی
واردسازی شبکه.انتقال شبکه

اگر سلام سیستم لینوکس:
    درون‌داد:
        تابع setrlimit(res: صحیح، lim: تهی*): صحیح
        تابع getrlimit(res: صحیح، lim: تهی*): صحیح
    پایان
پایان

ناپایا shared_l := انتقال شبکه.شنونده {}

تابع open_fds(): صحیح:
    برگشت سیستم عامل.فهرست پوشه("/proc/self/fd").طول()
پایان

تابع vm_pages(): صحیح۶۴:
    text := سیستم عامل.خواندن پرونده("/proc/self/statm")
    ناپایا n := 0
    تا n کوچکتر text.طول() و text.زیررشته(n، 1) نابرابر " ":
        n++
    پایان
    برگشت تبدیل.تجزیه عدد با پیش فرض(text.زیررشته(0، n)، 0 برگردان صحیح۶۴)
پایان

تابع settle(want: صحیح): صحیح:
    ناپایا left := 150
    تا left بزرگتر 0 و open_fds() بزرگتر want:
        همگام سازی.خواب میلی ثانیه(100)
        left--
    پایان
    برگشت open_fds()
پایان

تابع drain():
    تا درست:
        ناپایا c := انتقال شبکه.پذیرش(shared_l)
        اگر وارونه انتقال شبکه.معتبر(c):
            بشکن
        پایان
        انتقال شبکه.بستن(c)
    پایان
پایان

تابع ریشه:
    ناپایا ss := انتقال شبکه.تنظیمات {}
    ss.شبکه = "ws"
    ss.مهلت دست دادن = 3000
    l := انتقال شبکه.شنود(0، ss)
    p := انتقال شبکه.درگاه شنونده(l)
    shared_l = l
    t := نخ‌ساز(drain)
    همگام سازی.خواب میلی ثانیه(300)
    base := open_fds()
    ناپایا cap := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴) برگردان طبیعی۶۴*
    ناپایا tight := نادرست
    اگر سلام سیستم لینوکس:
        اگر getrlimit(9، cap برگردان تهی*) برابر 0:
            old_cur := cap[0]
            old_max := cap[1]
            cap[0] = (vm_pages() * 4096 + 40000000) برگردان طبیعی۶۴
            tight = setrlimit(9، cap برگردان تهی*) برابر 0
            ناپایا conns := وکتور {} برگردان وکتور<تی سی پی.اتصال شبکه>
            تکرار 100:
                conns.بیفزا(تی سی پی.شماره گیری("127.0.0.1"، p))
            پایان
            همگام سازی.خواب میلی ثانیه(500)
            cap[0] = old_cur
            cap[1] = old_max
            setrlimit(9، cap برگردان تهی*)
            تکرار 100 در i:
                تی سی پی.بستن(conns.بگیر(i))
            پایان
            conns.آزادکن()
            after := settle(base)
            سرچاپ "address space was capped:"، tight
            سرچاپ "descriptors back to the baseline:"، after کوچکتربرابر base
        پایان
    وگرنه:
        سرچاپ "address space was capped: true"
        سرچاپ "descriptors back to the baseline: true"
    پایان
    حافظه.آزادسازی(cap برگردان تهی*)
    انتقال شبکه.بستن شنونده(l)
    نخ‌پیوند(t)
پایان
