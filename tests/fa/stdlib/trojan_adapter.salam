واردسازی حافظه
واردسازی شبکه.تروجان
واردسازی شبکه.تونل
واردسازی فشرده سازی

تابع text_of(p: تهی*، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، p، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع ریشه:
    conn := تروجان.اتصال‌دهنده جدید("vpn.example.com"، 443، "password")
    سرچاپ conn.نام()، conn.کارساز().میزبان، conn.کارساز().درگاه

    pair := تونل.لوله جدید()
    a := تونل.سر اول لوله(pair)
    b := تونل.سر دوم لوله(pair)
    سرچاپ conn.دست‌دهی(a، تونل.نشانی جدید("example.com"، 443))
    ناپایا want := تروجان.کدگذاری درخواست("password"، تروجان.فرمان اتصال، "example.com"، 443)
    buf := حافظه.تخصیص(256 برگردان طبیعی۶۴)
    n := b.خواندن بایت(buf، 256)
    سرچاپ n، n برابر want.طول، text_of(buf، n) برابر text_of(want.داده، want.طول)

    ناپایا inb := تروجان.پذیرنده جدید()
    تروجان.افزودن گذرواژه به پذیرنده(inb، "password")
    تروجان.افزودن گذرواژه به پذیرنده(inb، "other")
    سرچاپ inb.نام()
    pair2 := تونل.لوله جدید()
    c := تونل.سر اول لوله(pair2)
    d := تونل.سر دوم لوله(pair2)
    _w := d.نوشتن(text_of(want.داده، want.طول) + "payload")
    sess := inb.دست‌دهی(c)
    سرچاپ sess.موفق، sess.مقصد.میزبان، sess.مقصد.درگاه، sess.پروتکل، sess.فرمان، text_of(sess.بایت های آغازین، sess.اندازه بایت های آغازین)، sess.کاربر.طول()

    pair5 := تونل.لوله جدید()
    i5 := تونل.سر اول لوله(pair5)
    j5 := تونل.سر دوم لوله(pair5)
    raw := حافظه.تخصیص صفرشده((want.طول + 5) برگردان طبیعی۶۴)
    حافظه.کپی(raw، want.داده، want.طول برگردان طبیعی۶۴)
    (raw برگردان طبیعی۸*)[want.طول + 1] = 7 برگردان طبیعی۸
    (raw برگردان طبیعی۸*)[want.طول + 4] = 9 برگردان طبیعی۸
    _w4 := j5.نوشتن بایت(raw، want.طول + 5)
    bin := inb.دست‌دهی(i5)
    bp := bin.بایت های آغازین برگردان طبیعی۸*
    سرچاپ "first payload with zeros:"، bin.موفق، bin.اندازه بایت های آغازین، bp[0]، bp[1]، bp[2]، bp[3]، bp[4]

    pair3 := تونل.لوله جدید()
    e := تونل.سر اول لوله(pair3)
    f := تونل.سر دوم لوله(pair3)
    _w2 := f.نوشتن("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    bad := inb.دست‌دهی(e)
    سرچاپ bad.موفق، bad.خطا، bad.داده آغازین.طول()

    pair4 := تونل.لوله جدید()
    g := تونل.سر اول لوله(pair4)
    h := تونل.سر دوم لوله(pair4)
    wrong := تروجان.کدگذاری درخواست("nope"، تروجان.فرمان اتصال، "example.com"، 443)
    _w3 := h.نوشتن(text_of(wrong.داده، wrong.طول))
    bad2 := inb.دست‌دهی(g)
    سرچاپ bad2.موفق، bad2.داده آغازین.طول() برابر wrong.طول
    فشرده سازی.آزادسازی بافر(want)
پایان
