واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.تروجان
واردسازی شبکه.یو دی پی
واردسازی فشرده سازی
واردسازی همگام سازی

ناپایا echo_port := 0
ناپایا udp_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع text_of(p: تهی*، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، p، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع echo_server():
    srv := تی سی پی.پیوند روی("::1"، 0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تا درست:
            s := تی سی پی.خواندن(c، 4096)
            اگر s.طول() برابر 0:
                بشکن
            پایان
            _n := تی سی پی.نوشتن(c، s)
        پایان
        تی سی پی.بستن(c)
    پایان
پایان

تابع udp_server():
    s := یو دی پی.پیوند روی("::1"، 0)
    udp_port = یو دی پی.درگاه(s)
    همگام سازی.اتمام(ready)
    تا درست:
        p := یو دی پی.دریافت(s، 2048)
        اگر p.داده.طول() بزرگتر 0:
            _n := یو دی پی.ارسال(s، p.میزبان فرستنده، p.درگاه فرستنده، "echo:" + p.داده)
        پایان
    پایان
پایان

تابع read_all_text(l &: تروجان.پیوند، want: صحیح): رشته:
    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(buf)
    ناپایا out := ""
    تا out.طول() کوچکتر want:
        n := تروجان.خواندن پیوند(l، buf، 8192)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        out += text_of(buf، n)
    پایان
    برگشت out
پایان

تابع udp_round(cfg: تروجان.پیکربندی کارخواه، host: رشته، label: رشته):
    ناپایا ulink := تروجان.شماره گیری یو دی پی(cfg)
    سرچاپ label، تروجان.ارسال یو دی پی(ulink، host، udp_port، "ping" برگردان تهی*، 4)
    ناپایا pkt := تروجان.بسته یو دی پی جدید()
    ناپایا payload := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.خواندن بسته یو دی پی(ulink، pkt، payload)
    سرچاپ pkt.میزبان، pkt.درگاه برابر udp_port، text_of(payload.داده، payload.طول)
    تروجان.بستن پیوند(ulink)
پایان

تابع ریشه:
    probe := تی سی پی.پیوند روی("::1"، 0)
    اگر وارونه تی سی پی.معتبر(probe):
        سرچاپ "ipv6 unavailable"
        برگشت
    پایان
    تی سی پی.بستن سرور(probe)

    req6 := تروجان.کدگذاری درخواست("password"، تروجان.فرمان اتصال، "2001:db8::1"، 443)
    p6 := تروجان.تجزیه درخواست(req6.داده، req6.طول)
    سرچاپ p6.وضعیت، p6.فرمان، p6.نوع نشانی برابر تروجان.نوع نشانی آی‌پی۶، p6.میزبان، p6.درگاه
    pk := تروجان.کدگذاری بسته یو دی پی("2606:4700:4700::1111"، 53، "hi" برگردان تهی*، 2)
    up := تروجان.تجزیه بسته یو دی پی(pk.داده، pk.طول)
    سرچاپ up.وضعیت، up.میزبان، up.درگاه، up.طول داده

    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _t1 := نخ‌ساز(echo_server)
    _t2 := نخ‌ساز(udp_server)
    همگام سازی.انتظار(ready)

    ناپایا scfg := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(scfg، درست)
    تروجان.افزودن گذرواژه(scfg، "secret")
    تروجان.تعیین میزبان شنود(scfg، "::1")
    srv := تروجان.سرویس‌دهی بدون رمز(scfg، 0)
    سرچاپ "server ok on ::1"، srv.معتبر

    ناپایا ccfg := تروجان.پیکربندی کارخواه جدید("::1"، srv.درگاه، "secret")
    ccfg.با تی ال اس = نادرست
    ناپایا link := تروجان.شماره گیری(ccfg، "::1"، echo_port)
    سرچاپ "dial ok"، تروجان.پیوند معتبر(link)
    سرچاپ تروجان.نوشتن متن پیوند(link، "hello six")
    سرچاپ read_all_text(link، 9)
    تروجان.بستن پیوند(link)
    ناپایا link2 := تروجان.شماره گیری(ccfg، "[::1]"، echo_port)
    سرچاپ تروجان.نوشتن متن پیوند(link2، "bracketed")
    سرچاپ read_all_text(link2، 9)
    تروجان.بستن پیوند(link2)

    udp_round(ccfg، "::1"، "udp send")
    تروجان.توقف(srv)

    ناپایا dcfg := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(dcfg، درست)
    تروجان.افزودن گذرواژه(dcfg، "secret")
    تروجان.تعیین میزبان شنود(dcfg، "::")
    dsrv := تروجان.سرویس‌دهی بدون رمز(dcfg، 0)
    سرچاپ "dual server ok"، dsrv.معتبر
    ناپایا d4 := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، dsrv.درگاه، "secret")
    d4.با تی ال اس = نادرست
    ناپایا l4 := تروجان.شماره گیری(d4، "::1"، echo_port)
    سرچاپ تروجان.نوشتن متن پیوند(l4، "dual via v4")
    سرچاپ read_all_text(l4، 11)
    تروجان.بستن پیوند(l4)
    ناپایا d6 := تروجان.پیکربندی کارخواه جدید("::1"، dsrv.درگاه، "secret")
    d6.با تی ال اس = نادرست
    ناپایا l6 := تروجان.شماره گیری(d6، "::1"، echo_port)
    سرچاپ تروجان.نوشتن متن پیوند(l6، "dual via v6")
    سرچاپ read_all_text(l6، 11)
    تروجان.بستن پیوند(l6)
    udp_round(d4، "::1"، "dual udp")
    تروجان.توقف(dsrv)

    ناپایا wcfg := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(wcfg، درست)
    تروجان.افزودن گذرواژه(wcfg، "wspass")
    تروجان.تعیین میزبان شنود(wcfg، "::1")
    wsrv := تروجان.سرویس‌دهی وب‌سوکت(wcfg، 0)
    سرچاپ "ws server ok"، wsrv.معتبر
    ناپایا wc := تروجان.پیکربندی کارخواه جدید("::1"، wsrv.درگاه، "wspass")
    wc.با تی ال اس = نادرست
    wc.با وب‌سوکت = درست
    wc.مسیر وب‌سوکت = "/trojan"
    ناپایا wlink := تروجان.شماره گیری(wc، "::1"، echo_port)
    سرچاپ "ws dial ok"، تروجان.پیوند معتبر(wlink)
    سرچاپ تروجان.نوشتن متن پیوند(wlink، "over websocket")
    سرچاپ read_all_text(wlink، 14)
    تروجان.بستن پیوند(wlink)
    تروجان.توقف(wsrv)
پایان
