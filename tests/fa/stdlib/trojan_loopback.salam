واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.یو دی پی
واردسازی شبکه.تروجان
واردسازی فشرده سازی
واردسازی همگام سازی
واردسازی تی ال اس

ناپایا echo_port := 0
ناپایا web_port := 0
ناپایا udp_port := 0
ناپایا web_seen := ""
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع text_of(p: تهی*، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، p، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع echo_server():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تا درست:
            s := تی سی پی.خواندن(c، 4096)
            اگر s.طول() برابر 0:
                بشکن
            پایان
            _n := تی سی پی.نوشتن(c، s)
        پایان
        تی سی پی.بستن(c)
    پایان
پایان

تابع web_server():
    srv := تی سی پی.پیوند(0)
    web_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        web_seen = تی سی پی.خواندن(c، 4096)
        _n := تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: 12\r\nConnection: close\r\n\r\nhello probes")
        تی سی پی.بستن(c)
    پایان
پایان

تابع udp_server():
    s := یو دی پی.پیوند(0)
    udp_port = یو دی پی.درگاه(s)
    همگام سازی.اتمام(ready)
    تا درست:
        p := یو دی پی.دریافت(s، 2048)
        اگر p.داده.طول() بزرگتر 0:
            _n := یو دی پی.ارسال(s، p.میزبان فرستنده، p.درگاه فرستنده، "echo:" + p.داده)
        پایان
    پایان
پایان

تابع read_all_text(l &: تروجان.پیوند، want: صحیح): رشته:
    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(buf)
    ناپایا out := ""
    تا out.طول() کوچکتر want:
        n := تروجان.خواندن پیوند(l، buf، 8192)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        out = out + text_of(buf، n)
    پایان
    برگشت out
پایان

تابع ریشه:
    سرچاپ تروجان.اس‌اچ‌ای۲۲۴ هگز("")
    سرچاپ تروجان.اس‌اچ‌ای۲۲۴ هگز("abc")
    سرچاپ تروجان.اس‌اچ‌ای۲۲۴ هگز("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq")
    سرچاپ تروجان.درهم گذرواژه("password")

    req := تروجان.کدگذاری درخواست("password"، تروجان.فرمان اتصال، "example.com"، 443)
    سرچاپ تروجان.هگز(req)
    pr := تروجان.تجزیه درخواست(req.داده، req.طول)
    سرچاپ pr.وضعیت، pr.فرمان، pr.نوع نشانی، pr.میزبان، pr.درگاه، pr.بایت‌های مصرف‌شده
    short := تروجان.تجزیه درخواست(req.داده، req.طول - 3)
    سرچاپ "short"، short.وضعیت
    req6 := تروجان.کدگذاری درخواست("password"، تروجان.فرمان یو دی پی، "2001:db8::1"، 53)
    p6 := تروجان.تجزیه درخواست(req6.داده، req6.طول)
    سرچاپ p6.وضعیت، p6.فرمان، p6.نوع نشانی، p6.میزبان، p6.درگاه
    junk := تروجان.تجزیه درخواست("GET / HTTP/1.1\r\nHost: a\r\n\r\n" برگردان تهی*، 28)
    سرچاپ "junk"، junk.وضعیت
    pk := تروجان.کدگذاری بسته یو دی پی("8.8.8.8"، 53، "hi" برگردان تهی*، 2)
    سرچاپ تروجان.هگز(pk)
    up := تروجان.تجزیه بسته یو دی پی(pk.داده، pk.طول)
    سرچاپ up.وضعیت، up.میزبان، up.درگاه، up.آغاز داده، up.طول داده، up.بایت‌های مصرف‌شده

    همگام سازی.افزودن(ready، 3 برگردان صحیح۶۴)
    _t1 := نخ‌ساز(echo_server)
    _t2 := نخ‌ساز(web_server)
    _t3 := نخ‌ساز(udp_server)
    همگام سازی.انتظار(ready)

    ناپایا scfg := تروجان.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    تروجان.تعیین جایگزین(scfg، "127.0.0.1"، web_port)
    تروجان.افزودن گذرواژه(scfg، "secret")
    تروجان.افزودن گذرواژه(scfg، "second")
    srv := تروجان.سرویس‌دهی(scfg، 0)
    سرچاپ "server ok"، srv.معتبر

    ناپایا ccfg := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، srv.درگاه، "secret")
    ccfg.نام سرور = "example.com"
    ccfg.ناامن = درست
    ناپایا link := تروجان.شماره گیری(ccfg، "127.0.0.1"، echo_port)
    سرچاپ "dial ok"، تروجان.پیوند معتبر(link)
    سرچاپ تروجان.نوشتن متن پیوند(link، "hello trojan")
    سرچاپ read_all_text(link، 12)
    big := حافظه.تخصیص(50000 برگردان طبیعی۶۴)
    حافظه.تنظیم(big، 97، 50000 برگردان طبیعی۶۴)
    سرچاپ تروجان.نوشتن پیوند(link، big، 50000)
    ناپایا total := 0
    تا total کوچکتر 50000:
        rb := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
        n := تروجان.خواندن پیوند(link، rb، 8192)
        حافظه.آزادسازی(rb)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        total += n
    پایان
    سرچاپ "echoed"، total
    تروجان.بستن پیوند(link)

    ccfg2 := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، srv.درگاه، "second")
    ناپایا c2 := ccfg2
    c2.ناامن = درست
    c2.سرآیند همراه نخستین داده = درست
    ناپایا link2 := تروجان.شماره گیری(c2، "127.0.0.1"، echo_port)
    سرچاپ تروجان.نوشتن متن پیوند(link2، "lazy header")
    سرچاپ read_all_text(link2، 11)
    تروجان.بستن پیوند(link2)

    ناپایا bad := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، srv.درگاه، "wrong")
    bad.ناامن = درست
    ناپایا link3 := تروجان.شماره گیری(bad، "127.0.0.1"، echo_port)
    سرچاپ read_all_text(link3، 1).طول() بزرگتر 40
    badreq := تروجان.کدگذاری درخواست("wrong"، تروجان.فرمان اتصال، "127.0.0.1"، echo_port)
    سرچاپ "forwarded exact"، web_seen برابر text_of(badreq.داده، badreq.طول)
    تروجان.بستن پیوند(link3)

    ناپایا tc := تی ال اس.پیکربندی جدید("example.com")
    tc.بدون بررسی گواهی = درست
    ناپایا probe := تروجان.پیوند تی ال اس جدید(تی ال اس.اتصال امن("127.0.0.1"، srv.درگاه، tc))
    سرچاپ تروجان.نوشتن متن پیوند(probe، "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
    answer := read_all_text(probe، 60)
    سرچاپ answer.بیاب("200 OK") بزرگتربرابر 0، answer.بیاب("hello probes") بزرگتربرابر 0
    سرچاپ web_seen.زیررشته(0، 14)
    تروجان.بستن پیوند(probe)

    ناپایا ulink := تروجان.شماره گیری یو دی پی(c2)
    سرچاپ تروجان.ارسال یو دی پی(ulink، "127.0.0.1"، udp_port، "ping" برگردان تهی*، 4)
    ناپایا pkt := تروجان.بسته یو دی پی جدید()
    ناپایا payload := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.خواندن بسته یو دی پی(ulink، pkt، payload)
    سرچاپ pkt.میزبان، pkt.درگاه برابر udp_port، text_of(payload.داده، payload.طول)
    تروجان.بستن پیوند(ulink)

    همگام سازی.خواب میلی ثانیه(400)
    st := تروجان.آمار(srv)
    سرچاپ "stats"، st.پذیرفته‌شده، st.احراز‌شده، st.جایگزین‌شده
    تروجان.توقف(srv)

    ناپایا wcfg := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.افزودن گذرواژه(wcfg، "wspass")
    wsrv := تروجان.سرویس‌دهی وب‌سوکت(wcfg، 0)
    سرچاپ "ws server ok"، wsrv.معتبر
    ناپایا wc := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، wsrv.درگاه، "wspass")
    wc.با تی ال اس = نادرست
    wc.با وب‌سوکت = درست
    wc.مسیر وب‌سوکت = "/trojan"
    ناپایا wlink := تروجان.شماره گیری(wc، "127.0.0.1"، echo_port)
    سرچاپ "ws dial ok"، تروجان.پیوند معتبر(wlink)
    سرچاپ تروجان.نوشتن متن پیوند(wlink، "over websocket")
    سرچاپ read_all_text(wlink، 14)
    تروجان.بستن پیوند(wlink)
    تروجان.توقف(wsrv)
پایان
