واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.یو دی پی
واردسازی شبکه.تروجان
واردسازی شبکه.تونل
واردسازی فشرده سازی
واردسازی همگام سازی

ناپایا echo_port := 0
ناپایا udp_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع text_of(p: تهی*، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، p، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع echo_server():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تا درست:
            s := تی سی پی.خواندن(c، 4096)
            اگر s.طول() برابر 0:
                بشکن
            پایان
            _n := تی سی پی.نوشتن(c، s)
        پایان
        تی سی پی.بستن(c)
    پایان
پایان

تابع udp_server():
    s := یو دی پی.پیوند(0)
    udp_port = یو دی پی.درگاه(s)
    همگام سازی.اتمام(ready)
    تا درست:
        p := یو دی پی.دریافت(s، 2048)
        اگر p.داده.طول() بزرگتر 0:
            _n := یو دی پی.ارسال(s، p.میزبان فرستنده، p.درگاه فرستنده، "echo:" + p.داده)
        پایان
    پایان
پایان

تابع read_all_text(l &: تروجان.پیوند، want: صحیح): رشته:
    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(buf)
    ناپایا out := ""
    تا out.طول() کوچکتر want:
        n := تروجان.خواندن پیوند(l، buf، 8192)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        out += text_of(buf، n)
    پایان
    برگشت out
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _t1 := نخ‌ساز(echo_server)
    _t2 := نخ‌ساز(udp_server)
    همگام سازی.انتظار(ready)

    ناپایا cfg := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.افزودن گذرواژه(cfg، "secret")
    تروجان.تعیین حالت(cfg، تروجان.حالت ساده)
    stats := تونل.آمار جدید()
    تروجان.تعیین آمار ترافیک(cfg، stats)
    srv := تروجان.شنود(cfg، 0)
    سرچاپ "listen ok"، srv.معتبر، srv.میزبان

    ناپایا ccfg := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، srv.درگاه، "secret")
    ccfg.با تی ال اس = نادرست

    ناپایا ulink := تروجان.شماره گیری یو دی پی(ccfg)
    سرچاپ تروجان.ارسال یو دی پی(ulink، "127.0.0.1"، udp_port، "one" برگردان تهی*، 3)
    سرچاپ تروجان.ارسال یو دی پی(ulink، "127.0.0.1"، udp_port، "two" برگردان تهی*، 3)
    ناپایا pkt := تروجان.بسته یو دی پی جدید()
    ناپایا payload := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.خواندن بسته یو دی پی(ulink، pkt، payload)، text_of(payload.داده، payload.طول)
    سرچاپ تروجان.خواندن بسته یو دی پی(ulink، pkt، payload)، text_of(payload.داده، payload.طول)
    تروجان.بستن پیوند(ulink)

    ناپایا link := تروجان.شماره گیری(ccfg، "127.0.0.1"، echo_port)
    سرچاپ تروجان.نوشتن متن پیوند(link، "hello stats")
    سرچاپ read_all_text(link، 11)
    تروجان.بستن پیوند(link)
    همگام سازی.خواب میلی ثانیه(300)
    سرچاپ "up"، stats.بایت بارگذاری() بزرگتربرابر 17، "down"، stats.بایت دریافت() بزرگتربرابر 17، "total"، stats.شمار کل()
    تروجان.توقف(srv)

    ناپایا rt := تونل.مسیریاب جدید("direct")
    ناپایا rule := تونل.قاعده جدید("block")
    سرچاپ تونل.قاعده درگاه(rule، "" + echo_port)
    تونل.افزودن قاعده(rt، rule)
    ناپایا rd := تونل.شماره‌گیر مسیریاب جدید(rt)
    تونل.افزودن به شماره‌گیر مسیریاب(rd، "block"، تونل.مسدود())
    ناپایا cfg2 := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.افزودن گذرواژه(cfg2، "secret")
    تروجان.تعیین مسیریاب(cfg2، rd)
    تروجان.تعیین میزبان شنود(cfg2، "127.0.0.1")
    تروجان.تعیین حالت(cfg2، تروجان.حالت ساده)
    srv2 := تروجان.شنود(cfg2، 0)
    ناپایا c2 := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، srv2.درگاه، "secret")
    c2.با تی ال اس = نادرست
    ناپایا blocked := تروجان.شماره گیری(c2، "127.0.0.1"، echo_port)
    سرچاپ تروجان.نوشتن متن پیوند(blocked، "x")
    سرچاپ "blocked read"، read_all_text(blocked، 1).طول()
    تروجان.بستن پیوند(blocked)

    ناپایا v6 := تروجان.شماره گیری(c2، "::1"، echo_port)
    سرچاپ تروجان.نوشتن متن پیوند(v6، "x")
    سرچاپ "v6 read"، read_all_text(v6، 1).طول()
    تروجان.بستن پیوند(v6)
    تروجان.توقف(srv2)

    ناپایا tls_cfg := تروجان.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    تروجان.افزودن گذرواژه(tls_cfg، "secret")
    srv3 := تروجان.شنود(tls_cfg، 0)
    سرچاپ "tls mode host"، srv3.معتبر، srv3.میزبان
    تروجان.توقف(srv3)

    ls := تی سی پی.پیوند روی("127.0.0.1"، 0)
    سرچاپ "bindon"، تی سی پی.معتبر(ls)، تی سی پی.درگاه(ls) بزرگتر 0
    تی سی پی.بستن سرور(ls)
پایان
