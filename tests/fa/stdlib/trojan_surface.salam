واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.تروجان
واردسازی شبکه.تونل
واردسازی شبکه.وب‌سوکت
واردسازی فشرده سازی
واردسازی همگام سازی

ناپایا echo_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا held := پوچ برگردان تروجان.پیوند*

ساختار Job:
    همگانی lp: تروجان.پیوند* = پوچ
    همگانی cfg: تروجان.پیکربندی کارساز = تروجان.پیکربندی کارساز {}
    همگانی result: صحیح = 0
پایان

ساختار RelayJob:
    همگانی a: تروجان.پیوند* = پوچ
    همگانی b: تروجان.پیوند* = پوچ
پایان

تابع text_of(p: تهی*، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، p، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع echo_server():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تا درست:
            s := تی سی پی.خواندن(c، 4096)
            اگر s.طول() برابر 0:
                بشکن
            پایان
            _n := تی سی پی.نوشتن(c، s)
        پایان
        تی سی پی.بستن(c)
    پایان
پایان

تابع serve_one(j: Job*):
    j[0].result = تروجان.پاسخ به پیوند(j[0].lp، j[0].cfg)
پایان

تابع relay_one(j: RelayJob*):
    _n := تروجان.رله(j[0].a، j[0].b)
پایان

تابع pair(): تروجان.پیوند:
    ls := تی سی پی.پیوند(0)
    c := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(ls))
    s := تی سی پی.پذیرش(ls)
    تی سی پی.بستن سرور(ls)
    sl := حافظه.تخصیص صفرشده(اندازه‌گونه(تروجان.پیوند) برگردان طبیعی۶۴) برگردان تروجان.پیوند*
    sl[0] = تروجان.پیوند تی سی پی جدید(s)
    held = sl
    برگشت تروجان.پیوند تی سی پی جدید(c)
پایان

تابع read_text(l &: تروجان.پیوند، want: صحیح): رشته:
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(buf)
    ناپایا out := ""
    تا out.طول() کوچکتر want:
        n := تروجان.خواندن پیوند(l، buf، 4096)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        out += text_of(buf، n)
    پایان
    برگشت out
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(echo_server)
    همگام سازی.انتظار(ready)

    ناپایا cl := pair()
    sl := held
    سرچاپ تروجان.توصیفگر پیوند(cl) بزرگتربرابر 0، تروجان.توصیفگر پیوند(sl[0]) بزرگتربرابر 0
    تروجان.تنظیم مهلت پیوند(cl، 2000)
    ناپایا wb := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(wb، "buffered" برگردان تهی*، 8)
    سرچاپ تروجان.نوشتن بافر پیوند(cl، wb)
    فشرده سازی.آزادسازی بافر(wb)
    سرچاپ read_text(sl[0]، 8)
    تروجان.خاموش کردن پیوند(cl)
    سرچاپ تروجان.خواندن پیوند(sl[0]، حافظه.تخصیص(16 برگردان طبیعی۶۴)، 16)
    تروجان.بستن پیوند(cl)
    تروجان.بستن پیوند(sl[0])

    ناپایا ua := pair()
    ua_peer := held
    سرچاپ تروجان.نوشتن بسته یو دی پی(ua، "10.1.2.3"، 5353، "dgram" برگردان تهی*، 5)
    ناپایا pkt := تروجان.بسته یو دی پی جدید()
    ناپایا payload := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.خواندن بسته یو دی پی(ua_peer[0]، pkt، payload)، pkt.میزبان، pkt.درگاه، text_of(payload.داده، payload.طول)
    تروجان.بستن پیوند(ua)
    تروجان.بستن پیوند(ua_peer[0])

    ناپایا ra := pair()
    ra_in := held
    ناپایا rb := pair()
    rb_in := held
    rj := حافظه.تخصیص صفرشده(اندازه‌گونه(RelayJob) برگردان طبیعی۶۴) برگردان RelayJob*
    rj[0] = RelayJob { a = ra_in، b = rb_in }
    th := نخ‌ساز(relay_one، rj)
    سرچاپ تروجان.نوشتن متن پیوند(ra، "through relay")
    سرچاپ read_text(rb، 13)
    تروجان.بستن پیوند(ra)
    تروجان.بستن پیوند(rb)
    نخ‌پیوند(th)
    حافظه.آزادسازی(rj برگردان تهی*)

    ناپایا cfg := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.افزودن درهم گذرواژه(cfg، تروجان.درهم گذرواژه("pw"))
    تروجان.تعیین شماره‌گیر(cfg، تونل.مستقیم())
    ناپایا scl := pair()
    sv := held
    jb := حافظه.تخصیص صفرشده(اندازه‌گونه(Job) برگردان طبیعی۶۴) برگردان Job*
    jb[0] = Job { lp = sv، cfg = cfg }
    th2 := نخ‌ساز(serve_one، jb)
    req := تروجان.کدگذاری درخواست با درهم(تروجان.درهم گذرواژه("pw")، تروجان.فرمان اتصال، "127.0.0.1"، echo_port)
    سرچاپ تروجان.نوشتن پیوند(scl، req.داده، req.طول)
    سرچاپ تروجان.نوشتن متن پیوند(scl، "via serve link")
    سرچاپ read_text(scl، 14)
    تروجان.بستن پیوند(scl)
    نخ‌پیوند(th2)
    سرچاپ "serve result"، jb[0].result
    حافظه.آزادسازی(jb برگردان تهی*)
    تروجان.بستن پیوند(sv[0])

    st := تروجان.به صورت جریان(sv)
    سرچاپ "stream ok"، st.معتبر()
    st.تنظیم مهلت(500)
    st.خاموش کردن()

    ناپایا fl := pair()
    fp := held
    ناپایا seen := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.جایگزین(fp، cfg، seen)
    فشرده سازی.آزادسازی بافر(seen)
    cfg.مهلت دست‌دهی = 200
    ناپایا hs := تروجان.دست‌دهی(fl، cfg)
    سرچاپ hs.معتبر
    تروجان.آزاد کردن نشست(hs)
    تروجان.بستن پیوند(fl)
    تروجان.بستن پیوند(fp[0])

    wl := تروجان.پیوند وب‌سوکت جدید(وب‌سوکت.اتصال وب {})
    سرچاپ تروجان.پیوند معتبر(wl)

    srv := تروجان.سرویس‌دهی بدون رمز(تروجان.پیکربندی کارساز جدید(""، "")، 0)
    سرچاپ تروجان.درگاه کارساز(srv) برابر srv.درگاه، srv.درگاه بزرگتر 0
    تروجان.توقف(srv)

    ناپایا d := تروجان.اس‌اچ‌ای۲۲۴("abc" برگردان تهی*، 3)
    سرچاپ تروجان.هگز(d)
    فشرده سازی.آزادسازی بافر(d)
    ناپایا ip4 := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.تجزیه آی‌پی۴("10.20.30.40"، ip4)، تروجان.قالب‌دهی آی‌پی۴(ip4.داده، 0)
    ناپایا ip6 := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.تجزیه آی‌پی۶("2001:db8::7"، ip6)، تروجان.قالب‌دهی آی‌پی۶(ip6.داده، 0)
    ea := تروجان.کدگذاری نشانی("example.com"، 443)
    ناپایا atyp := 0
    ناپایا host := ""
    ناپایا port := 0
    n := تروجان.تجزیه نشانی(ea.داده، ea.طول، 0، atyp، host، port)
    سرچاپ n برابر ea.طول، atyp، host، port
پایان
