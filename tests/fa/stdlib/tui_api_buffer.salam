واردسازی رابط‌پایانه

تابع ریشه:
    ناپایا بافر := رابط‌پایانه.بافر جدید(16، 5)
    بافر.نویسه‌ها = رابط‌پایانه.سیاست‌نویسه‌ها.یونیکد
    ناحیه := بافر.محدوده()
    سرچاپ "ناحیه"، ناحیه.عرض، "x"، ناحیه.ارتفاع
    رابط‌پایانه.ترسیم کادر(بافر، ناحیه، رابط‌پایانه.سبک‌کادر.دو خط، رابط‌پایانه.ظاهر پیش‌فرض، "قاب")
    بافر.نوشتن متن(2، 1، "hi 中文"، رابط‌پایانه.ظاهر { پررنگ = درست })
    بافر.پرکردن(رابط‌پایانه.مستطیل { ایکس = 2، ایگرگ = 2، عرض = 5، ارتفاع = 1 }، "."، رابط‌پایانه.ظاهر پیش‌فرض)
    بافر.تنظیم(9، 2، رابط‌پایانه.سلول { نویسه = "*"، ظاهر = رابط‌پایانه.ظاهر پیش‌فرض })
    رابط‌پایانه.ترسیم کادر با نویسه‌ها(بافر، رابط‌پایانه.مستطیل { ایکس = 10، ایگرگ = 2، عرض = 5، ارتفاع = 3 }، رابط‌پایانه.نویسه‌های گرد()، رابط‌پایانه.ظاهر پیش‌فرض، "")
    تکرار بافر.ارتفاع در سطر:
        سرچاپ بافر.متن ردیف(سطر)
    پایان
    سرچاپ "خانه 2,1:"، بافر.دریافت(2، 1).نویسه، "سر نویسه پهن:"، بافر.دریافت(5، 1).نویسه
    سرچاپ "بایت‌های قاب:"، بافر.خروجی کامل انسی().طول() بزرگتر 0، "تغییرها:"، بافر.اختلاف().طول() بزرگتر 0
    بافر.ثبت قاب()
    سرچاپ "پس از ثبت:"، بافر.اختلاف().طول()
    بافر.پاک‌سازی()
    بافر.تغییر اندازه(4، 1)
    سرچاپ "اندازه تازه"، بافر.عرض، بافر.ارتفاع، "بازترسیم کامل:"، بافر.اجبار بازترسیم کامل
    سرچاپ "مجموعه نویسه‌ها:"، رابط‌پایانه.نویسه‌های تک خط().افقی، رابط‌پایانه.نویسه‌های دو خط().افقی، رابط‌پایانه.نویسه‌های سنگین().افقی، رابط‌پایانه.نویسه‌های اسکی().افقی، رابط‌پایانه.نویسه‌های ترکیبی().گوشه بالا چپ
    سرچاپ "جایگزین اسکی:"، رابط‌پایانه.نویسه‌ها برای(رابط‌پایانه.سبک‌کادر.گوشه‌گرد، رابط‌پایانه.سیاست‌نویسه‌ها.اسکی).گوشه بالا چپ
    سرچاپ "سیاست از محیط:"، رابط‌پایانه.تشخیص سیاست نویسه‌ها() برابر رابط‌پایانه.تشخیص سیاست نویسه‌ها()
    _ := بافر.در تمرکز
    _ := بافر.محدوده برش
    بافر.آزادسازی()
پایان
