واردسازی رابط‌پایانه

ناپایا calls := 0

تابع ریشه:
    ناپایا t := رابط‌پایانه.متن جدید("first")
    t.تنظیم متن("second")
    سرچاپ t.محتوا
    t.تنظیم منبع(():
        calls++
        برگشت "count " + calls
    پایان)
    ناپایا buf := رابط‌پایانه.بافر جدید(10، 1)
    t.تنظیم محدوده(رابط‌پایانه.مستطیل { عرض = 10، ارتفاع = 1 })
    t.ترسیم(buf، t.محدوده())
    سرچاپ buf.متن ردیف(0)
    t.پاک‌سازی منبع()
    buf.پاک‌سازی()
    t.ترسیم(buf، t.محدوده())
    سرچاپ buf.متن ردیف(0)
    buf.ثبت قاب()
    buf.ارسال به ترمینال()
    buf.آزادسازی()

    ناپایا g := رابط‌پایانه.شبکه جدید(2، 2)
    i := g.افزودن(رابط‌پایانه.ویجت‌پایه {} برگردان پویا رابط‌پایانه.ویجت)
    g.تنظیم گستره(i، 2، 1)
    سرچاپ "span"، g.جایگاه‌ها.بگیر(i).گستره ردیف، g.جایگاه‌ها.بگیر(i).گستره ستون

    ناپایا s := رابط‌پایانه.صفحه ترمینال جدید(رابط‌پایانه.ویجت‌پایه {})
    سرچاپ "screen fits buffer:"، s.ریشه.محدوده().عرض برابر s.بافر.عرض
    s.بستن()
پایان
