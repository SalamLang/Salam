واردسازی رابط‌پایانه

ساختار جعبه:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی نشان: رشته = "#"

    همگانی تابع ترسیم(بافر: رابط‌پایانه.بافر، مرز: رابط‌پایانه.مستطیل):
        بافر.پرکردن(مرز، این.نشان، رابط‌پایانه.ظاهر پیش‌فرض)
    پایان
پایان

تابع ساخت جعبه(نشان: رشته): پویا رابط‌پایانه.ویجت:
    برگشت جعبه { نشان = نشان } برگردان پویا رابط‌پایانه.ویجت
پایان

تابع قاعده(شیوه: رابط‌پایانه.نوع‌اندازه‌گذاری، سلول‌ها: صحیح، وزن: صحیح): رابط‌پایانه.قاعده‌اندازه‌گذاری:
    برگشت رابط‌پایانه.قاعده‌اندازه‌گذاری { نوع = شیوه، تعداد سلول = سلول‌ها، وزن = وزن }
پایان

تابع ریشه:
    الف := ساخت جعبه("a")
    ب := ساخت جعبه("b")
    پ := ساخت جعبه("c")
    ت := ساخت جعبه("d")
    ث := ساخت جعبه("e")
    ج := ساخت جعبه("f")

    ناپایا بالا := رابط‌پایانه.ردیف جدید()
    بالا.تنظیم فاصله(1)
    جای الف := بالا.افزودن(الف)
    جای ب := بالا.افزودن(ب)
    بالا.تنظیم عرض(جای الف، قاعده(رابط‌پایانه.نوع‌اندازه‌گذاری.ثابت، 4، 0))
    بالا.تنظیم عرض(جای ب، قاعده(رابط‌پایانه.نوع‌اندازه‌گذاری.پرکردن فضا، 0، 1))
    ردیف بالا := بالا برگردان پویا رابط‌پایانه.ویجت

    ناپایا شبکه := رابط‌پایانه.شبکه جدید(1، 2)
    جای پ := شبکه.افزودن(پ)
    جای ت := شبکه.افزودن(ت)
    شبکه.تنظیم خانه(جای پ، 0، 0)
    شبکه.تنظیم خانه(جای ت، 0، 1)
    ویجت شبکه := شبکه برگردان پویا رابط‌پایانه.ویجت

    ناپایا پشته := رابط‌پایانه.پشته جدید()
    جای ث := پشته.افزودن(ث)
    جای ج := پشته.افزودن(ج)
    پشته.تنظیم حاشیه بیرونی(جای ج، رابط‌پایانه.فاصله‌های چهارگانه جدید(0، 2، 0، 2))
    پشته.تنظیم تراز(جای ث، رابط‌پایانه.تراز‌عرضی.کشیده، رابط‌پایانه.تراز‌عرضی.کشیده)
    ویجت پشته := پشته برگردان پویا رابط‌پایانه.ویجت

    ناپایا ستون := رابط‌پایانه.ستون جدید()
    ستون.تنظیم فاصله درونی(رابط‌پایانه.فاصله‌های چهارگانه یکسان(1))
    جای ردیف := ستون.افزودن(ردیف بالا)
    جای شبکه := ستون.افزودن(ویجت شبکه)
    جای پشته := ستون.افزودن(ویجت پشته)
    ستون.تنظیم ارتفاع(جای ردیف، قاعده(رابط‌پایانه.نوع‌اندازه‌گذاری.ثابت، 1، 0))
    ستون.تنظیم ارتفاع(جای شبکه، قاعده(رابط‌پایانه.نوع‌اندازه‌گذاری.ثابت، 2، 0))
    ستون.تنظیم ارتفاع(جای پشته، قاعده(رابط‌پایانه.نوع‌اندازه‌گذاری.پرکردن فضا، 0، 1))

    ناپایا ص := رابط‌پایانه.صفحه جدید(ستون برگردان پویا رابط‌پایانه.ویجت، 20، 8)
    دیرکن ص.بستن()
    هر ویجت در [ردیف بالا، الف، ب، ویجت شبکه، پ، ت، ویجت پشته، ث، ج]:
        _ := ص.افزودن(رابط‌پایانه.شناسه ریشه، ویجت)
    پایان
    ص.بازترسیم()
    تکرار ص.بافر.ارتفاع در سطر:
        سرچاپ "|" + ص.بافر.متن ردیف(سطر) + "|"
    پایان

    ناپایا اندازه‌ها := وکتور {} برگردان وکتور<رابط‌پایانه.قاعده‌اندازه‌گذاری>
    اندازه‌ها.بیفزا(قاعده(رابط‌پایانه.نوع‌اندازه‌گذاری.ثابت، 3، 0))
    اندازه‌ها.بیفزا(قاعده(رابط‌پایانه.نوع‌اندازه‌گذاری.پرکردن فضا، 0، 2))
    اندازه‌ها.بیفزا(قاعده(رابط‌پایانه.نوع‌اندازه‌گذاری.ترجیحی، 0، 1))
    تقسیم := رابط‌پایانه.تقسیم محور اصلی(12، اندازه‌ها، 0)
    سرچاپ "تقسیم 12:"، تقسیم.دریافت(0)، تقسیم.دریافت(1)، تقسیم.دریافت(2)
    بخش‌ها := رابط‌پایانه.اندازه‌های بخش‌های شبکه(10، 3)
    سرچاپ "بخش‌های 10/3:"، بخش‌ها.دریافت(0)، بخش‌ها.دریافت(1)، بخش‌ها.دریافت(2)
    درون := رابط‌پایانه.کاستن از لبه‌های مستطیل(رابط‌پایانه.مستطیل { عرض = 10، ارتفاع = 4 }، رابط‌پایانه.فاصله‌های چهارگانه جدید(1، 2، 1، 2))
    سرچاپ "تورفتگی:"، درون.ایکس، درون.ایگرگ، درون.عرض، درون.ارتفاع
    جاگرفته := رابط‌پایانه.جاسازی مستطیل(رابط‌پایانه.مستطیل { ایکس = 8، ایگرگ = 0، عرض = 6، ارتفاع = 2 }، رابط‌پایانه.مستطیل { عرض = 10، ارتفاع = 4 })
    سرچاپ "جاسازی:"، جاگرفته.ایکس، جاگرفته.عرض
    سرچاپ "جایابی:"، رابط‌پایانه.اندازه در محور(10، رابط‌پایانه.تراز‌عرضی.مرکز، 4)، رابط‌پایانه.جابه‌جایی در محور(10، رابط‌پایانه.تراز‌عرضی.انتها، 4)
    سنجش := رابط‌پایانه.اندازه { معتبر = درست، گستره = 3 }
    سرچاپ "اندازه:"، سنجش.معتبر، سنجش.گستره، رابط‌پایانه.محور.محور افقی نابرابر رابط‌پایانه.محور.محور عمودی
    جایگاه := ستون.جایگاه‌ها.بگیر(1)
    سرچاپ "گستره جایگاه:"، جایگاه.گستره ردیف، جایگاه.گستره ستون، "ردیف/ستون:"، شبکه.ردیف‌ها، شبکه.ستون‌ها، "فاصله:"، بالا.فاصله، "فاصله درونی:"، ستون.فاصله درونی.بالا
پایان
