واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا شمار بستن := 0

تابع نمایش(ص: رابط‌پایانه.صفحه):
    ص.بازترسیم()
    تکرار ص.بافر.ارتفاع در سطر:
        سرچاپ "|" + ص.بافر.متن ردیف(سطر) + "|"
    پایان
پایان

تابع ریشه:
    ناپایا ص := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 24، 6)
    دیرکن ص.بستن()
    ناحیه := رابط‌پایانه.مستطیل { عرض = 24، ارتفاع = 6 }

    بدنه := رابط‌پایانه.متن جدید("درون این قاب") برگردان پویا رابط‌پایانه.ویجت
    ناپایا قاب := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.تک خط، عنوان = "پنجره"، تمرکز می‌گیرد = درست، ظاهر تمرکز = رابط‌پایانه.ظاهر { پررنگ = درست } }
    قاب.ظاهر کادر = رابط‌پایانه.ظاهر پیش‌فرض
    قاب.افزودن(بدنه)
    شناسه قاب := ص.افزودن(رابط‌پایانه.شناسه ریشه، قاب برگردان پویا رابط‌پایانه.ویجت)
    _ := ص.افزودن(شناسه قاب، بدنه)
    ص.ویجت(شناسه قاب).تنظیم محدوده(ناحیه)
    سرچاپ "پنل تمرکزپذیر:"، ص.ویجت(شناسه قاب).تمرکز‌پذیر است()، "جایگاه فرزند:"، قاب.جایگاه.طول()

    ناپایا گفتگو := رابط‌پایانه.مودال جدید()
    گفتگو.تنظیم عنوان("خروج؟")
    گفتگو.تنظیم اندازه(رابط‌پایانه.اندازه‌مودال.ثابت(14، 3))
    گفتگو.تنظیم امکان بستن(درست)
    گفتگو.ظاهر کادر = رابط‌پایانه.ظاهر پیش‌فرض
    گفتگو.هنگام بستن = (): شمار بستن++ پایان
    پاسخ := رابط‌پایانه.متن جدید("ب / خ") برگردان پویا رابط‌پایانه.ویجت
    گفتگو.افزودن(پاسخ)
    گفتگو.تنظیم محدوده(ناحیه)
    شناسه گفتگو := ص.افزودن(رابط‌پایانه.شناسه ریشه، گفتگو برگردان پویا رابط‌پایانه.ویجت)
    _ := ص.افزودن(شناسه گفتگو، پاسخ)
    گفتگو.باز کردن()
    _ := ص.تمرکز با ذخیره قبلی(شناسه گفتگو)
    ص.آوردن زیردرخت به رو(شناسه گفتگو)
    نمایش(ص)

    _ := ص.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = پایانه.کلید گریز } })
    ص.بازگرداندن ترتیب زیردرخت(شناسه گفتگو)
    _ := ص.بازیابی تمرکز()
    سرچاپ "بسته شد:"، شمار بستن، "تمرکز به پنل برگشت:"، ص.شناسه متمرکز() برابر شناسه قاب
    نمایش(ص)
    _ := گفتگو.تمرکز می‌گیرد
    _ := گفتگو.وضعیت
    گفتگو.بستن()
    _ := رابط‌پایانه.اندازه‌مودال.درصدی(50، 50)
    _ := رابط‌پایانه.ضخامت.سنگین
پایان
