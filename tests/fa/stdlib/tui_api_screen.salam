واردسازی پایانه
واردسازی رابط‌پایانه

تابع جا(ایکس: صحیح، ایگرگ: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = ایکس، ایگرگ = ایگرگ، عرض = 8، ارتفاع = 1 }
پایان

تابع کلید(کد: صحیح): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = کد } }
پایان

تابع ریشه:
    ناپایا ص := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 20، 3)
    دیرکن ص.بستن()
    الف := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.دکمه جدید("ا") برگردان پویا رابط‌پایانه.ویجت)
    ب := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.دکمه جدید("ب") برگردان پویا رابط‌پایانه.ویجت)
    پ := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.دکمه جدید("پ") برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(الف).تنظیم محدوده(جا(0، 0))
    ص.ویجت(ب).تنظیم محدوده(جا(10، 0))
    ص.ویجت(پ).تنظیم محدوده(جا(0، 2))
    سرچاپ "هنوز چیزی متمرکز نیست:"، ص.شناسه متمرکز() برابر رابط‌پایانه.بدون ویجت
    _ := ص.تمرکز(الف)
    سرچاپ "تمرکز روی الف:"، ص.شناسه متمرکز() برابر الف، "ب تمرکزپذیر است:"، ص.تمرکز‌پذیر است(ب)
    _ := ص.تمرکز راست()
    سرچاپ "راست:"، ص.شناسه متمرکز() برابر ب
    _ := ص.تمرکز چپ()
    _ := ص.تمرکز پایین()
    سرچاپ "پایین:"، ص.شناسه متمرکز() برابر پ
    _ := ص.تمرکز بالا()
    _ := ص.تمرکز بعدی()
    _ := ص.تمرکز قبلی()
    سرچاپ "پس از بعدی و قبلی:"، ص.شناسه متمرکز() برابر الف
    _ := ص.تمرکز با ذخیره قبلی(پ)
    _ := ص.بازیابی تمرکز()
    سرچاپ "بازیابی برمی‌گرداند:"، ص.شناسه متمرکز() برابر الف، "پشته:"، ص.پشته تمرکز.طول()
    سرچاپ "برخورد در 11,0:"، ص.آزمون برخورد(11، 0) برابر ب، "هیچ چیز در 19,2:"، ص.آزمون برخورد(19، 2) برابر رابط‌پایانه.شناسه ریشه

    ناپایا لایه := وکتور {} برگردان وکتور<صحیح>
    لایه.بیفزا(پ)
    ص.آوردن به رو(لایه)
    سرچاپ "رو آمده تمرکز می‌گیرد:"، ص.شناسه متمرکز() برابر پ
    ص.بازگرداندن ترتیب(لایه)
    ص.آوردن زیردرخت به رو(ب)
    ص.بازگرداندن ترتیب زیردرخت(ب)

    ص.تنظیم نگاشت کلید(رابط‌پایانه.نگاشت کلید پیش‌فرض())
    سرچاپ "در صف رفت:"، ص.صف‌گذاری رویداد(کلید(پایانه.کلید تب))
    ناپایا رخداد := رابط‌پایانه.رویداد {}
    اگر ص.رویداد بعدی(رخداد):
        سرچاپ "مصرف شد:"، ص.هدایت رویداد(رخداد)
    پایان
    ص.علامت‌گذاری برای بازترسیم(الف)
    ص.علامت‌گذاری زیردرخت برای بازترسیم(رابط‌پایانه.شناسه ریشه)
    ص.تغییر اندازه(22، 3)
    ص.جاسازی ریشه()
    ص.بازترسیم()
    ص.نمایش تغییرات()
    سرچاپ "|" + ص.بافر.متن ردیف(0) + "|"
    سرچاپ "|" + ص.بافر.متن ردیف(2) + "|"
    سرچاپ "ویجت‌ها:"، ص.درخت.تعداد()، "نیاز به بازترسیم:"، ص.نیازمند بازترسیم، "عرض محدوده متمرکز:"، ص.ویجت متمرکز.محدوده().عرض
    سرچاپ "ریشه می‌پوشاند"، ص.ریشه.محدوده().عرض، "x"، ص.ریشه.محدوده().ارتفاع، "نویسه‌ها یونیکد:"، ص.نویسه‌ها برابر رابط‌پایانه.سیاست‌نویسه‌ها.یونیکد
    _ := ص.رویدادها
    _ := ص.نگاشت کلید
    ص.توقف()
پایان
