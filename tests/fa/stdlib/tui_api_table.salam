واردسازی پایانه
واردسازی رابط‌پایانه

تابع ردیف(اولی: رشته، دومی: رشته): وکتور<رشته>:
    ناپایا خانه‌ها := وکتور {} برگردان وکتور<رشته>
    خانه‌ها.بیفزا(اولی)
    خانه‌ها.بیفزا(دومی)
    برگشت خانه‌ها
پایان

تابع ریشه:
    ناپایا جدول := رابط‌پایانه.جدول جدید()
    _ := جدول.افزودن ستون(رابط‌پایانه.ستون‌جدول {})
    _ := جدول.افزودن ستون(رابط‌پایانه.ستون‌جدول {})
    جدول.تنظیم عرض ستون(0، رابط‌پایانه.قاعده‌اندازه‌گذاری { نوع = رابط‌پایانه.نوع‌اندازه‌گذاری.ثابت، تعداد سلول = 9 })
    جدول.تنظیم تراز ستون(1، رابط‌پایانه.تراز.راست)
    جدول.تنظیم سرریز ستون(0، رابط‌پایانه.سرریز‌سلول.سه‌نقطه)
    جدول.تنظیم فاصله درونی افقی(1)
    جدول.سرآیند = درست
    جدول.خط‌کشی = درست
    جدول.ظاهر سرآیند = رابط‌پایانه.ظاهر { پررنگ = درست }
    _ := جدول.افزودن ردیف(ردیف("بسته"، "حجم"))
    _ := جدول.افزودن ردیف(ردیف("tui"، "8956"))
    _ := جدول.افزودن ردیف(ردیف("os.signal"، "976"))
    _ := جدول.افزودن ردیف(ردیف("encoding.json"، "3100"))
    جدول.تنظیم تراز سلول(3، 1، رابط‌پایانه.تراز.چپ)
    ترجیحی := جدول.اندازه ترجیحی(40)
    سرچاپ "ارتفاع ترجیحی"، ترجیحی.ارتفاع
    ناپایا بافر := رابط‌پایانه.بافر جدید(20، ترجیحی.ارتفاع)
    جدول.تنظیم محدوده(بافر.محدوده())
    جدول.ترسیم(بافر، بافر.محدوده())
    تکرار بافر.ارتفاع در سطر:
        سرچاپ "|" + بافر.متن ردیف(سطر) + "|"
    پایان
    سرچاپ "ستون‌ها"، جدول.ستون‌ها.طول()، "ردیف‌ها"، جدول.ردیف‌ها.طول()، "تمرکزپذیر"، جدول.تمرکز‌پذیر است()
    بافر.آزادسازی()

    ناپایا نما := رابط‌پایانه.نمای جدول جدید()
    _ := نما.افزودن ستون(رابط‌پایانه.ستون‌جدول { عرض = رابط‌پایانه.قاعده‌اندازه‌گذاری { نوع = رابط‌پایانه.نوع‌اندازه‌گذاری.پرکردن فضا، وزن = 1 }، سرریز = رابط‌پایانه.سرریز‌سلول.برش })
    تکرار 10 در شماره:
        ناپایا تک := وکتور {} برگردان وکتور<رشته>
        تک.بیفزا("خط " + شماره)
        _ := نما.افزودن ردیف(تک)
    پایان
    نما.تنظیم محدوده(رابط‌پایانه.مستطیل { عرض = 12، ارتفاع = 3 })
    پایین := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = پایانه.کلید پایین } }
    تکرار 4:
        _ := نما.پردازش رویداد(پایین)
    پایان
    سرچاپ "انتخاب‌شده"، نما.انتخاب‌شده، "نخستین ردیف نمایان"، نما.جابه‌جایی
پایان
