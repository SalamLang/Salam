واردسازی رابط‌پایانه

تابع ریشه:
    خطوط := رابط‌پایانه.شکستن خطوط متن("رابط کاربر متنی برای پایانه در سلام"، 12)
    هر خط در خطوط:
        سرچاپ "[" + خط + "]"
    پایان
    اندازه := رابط‌پایانه.اندازه‌گیری متن("خط یک\nخط دو"، 20)
    سرچاپ "اندازه"، اندازه.عرض، "x"، اندازه.ارتفاع

    ناپایا بافر := رابط‌پایانه.بافر جدید(20، 4)
    ناپایا عنوان := رابط‌پایانه.متن جدید("در میانه")
    عنوان.تنظیم تراز(رابط‌پایانه.تراز.مرکز)
    عنوان.تنظیم ظاهر(رابط‌پایانه.ظاهر { پررنگ = درست })
    عنوان.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 20، ارتفاع = 1 })
    عنوان.ترسیم(بافر، عنوان.محدوده())
    ناپایا خط جدا := رابط‌پایانه.جداکننده جدید()
    خط جدا.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 1، عرض = 20، ارتفاع = 1 })
    خط جدا.ترسیم(بافر، خط جدا.محدوده())
    ناپایا نوار := رابط‌پایانه.نوار پیشرفت جدید()
    نوار.تنظیم بیشینه(200)
    نوار.تنظیم پیشرفت(50)
    نوار.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 2، عرض = 20، ارتفاع = 1 })
    نوار.ترسیم(بافر، نوار.محدوده())
    ناپایا بلند := رابط‌پایانه.متن جدید("این خط هرگز شکسته نمی‌شود")
    بلند.تنظیم شکست خط(رابط‌پایانه.حالت‌شکست‌خط.بدون شکست)
    بلند.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 3، عرض = 10، ارتفاع = 1 })
    بافر.محدوده برش = بلند.محدوده()
    بلند.ترسیم(بافر، بلند.محدوده())
    بافر.محدوده برش = بافر.محدوده()
    تکرار بافر.ارتفاع در سطر:
        سرچاپ "|" + بافر.متن ردیف(سطر) + "|"
    پایان
    سرچاپ "پیشرفت"، نوار.مقدار پیشرفت()، "عرض ترجیحی"، عنوان.عرض ترجیحی()
    بافر.آزادسازی()
پایان
