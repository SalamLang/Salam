واردسازی رشته
واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع test_new_is_blank():
    ناپایا b := رابط‌پایانه.بافر جدید(3، 2)
    آزمایش.ادعای برابری عدد(b.سلول‌ها.طول()، 6)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "   ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "   ")
    آزمایش.ادعای برابری عدد(b.محدوده برش.عرض، 3)
    آزمایش.ادعای برابری عدد(b.محدوده برش.ارتفاع، 2)
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
    b.آزادسازی()
    neg := رابط‌پایانه.بافر جدید(-4، 2)
    آزمایش.ادعای برابری عدد(neg.عرض، 0)
    آزمایش.ادعای برابری عدد(neg.سلول‌ها.طول()، 0)
پایان

تابع test_set_get():
    ناپایا b := رابط‌پایانه.بافر جدید(3، 2)
    bold := رابط‌پایانه.ظاهر { پررنگ = درست }
    b.تنظیم(2، 1، رابط‌پایانه.سلول { نویسه = "x"، ظاهر = bold })
    آزمایش.ادعای برابری رشته(b.دریافت(2، 1).نویسه، "x")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(2، 1).ظاهر، bold))
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "  x")
    b.آزادسازی()
پایان

تابع test_out_of_range_is_noop():
    ناپایا b := رابط‌پایانه.بافر جدید(2، 2)
    b.تنظیم(-1، 0، رابط‌پایانه.سلول { نویسه = "a" })
    b.تنظیم(2، 0، رابط‌پایانه.سلول { نویسه = "b" })
    b.تنظیم(0، 2، رابط‌پایانه.سلول { نویسه = "c" })
    b.تنظیم(0، -1، رابط‌پایانه.سلول { نویسه = "d" })
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "  ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "  ")
    آزمایش.ادعای برابری رشته(b.دریافت(5، 5).نویسه، " ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(9)، "")
    b.آزادسازی()
پایان

تابع test_clip():
    ناپایا b := رابط‌پایانه.بافر جدید(6، 1)
    ناپایا view := b
    view.محدوده برش = rect(1، 0، 3، 1)
    view.نوشتن متن(0، 0، "abcdef"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، " bcd  ")
    آزمایش.ادعای برابری عدد(b.محدوده برش.عرض، 6)
    b.آزادسازی()
پایان

تابع test_put_str_codepoints():
    ناپایا b := رابط‌پایانه.بافر جدید(6، 1)
    b.نوشتن متن(1، 0، "سلام"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.دریافت(1، 0).نویسه، "س")
    آزمایش.ادعای برابری رشته(b.دریافت(4، 0).نویسه، "م")
    آزمایش.ادعای برابری رشته(b.دریافت(5، 0).نویسه، " ")
    b.نوشتن متن(4، 0، "xyz"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.دریافت(5، 0).نویسه، "y")
    b.آزادسازی()
پایان

تابع test_display_cells():
    ناپایا b := رابط‌پایانه.بافر جدید(4، 1)
    b.نوشتن متن(0، 0، "中a"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، "中")
    آزمایش.ادعای برابری رشته(b.دریافت(1، 0).نویسه، "")
    آزمایش.ادعای برابری رشته(b.دریافت(2، 0).نویسه، "a")
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "中a ")
    b.آزادسازی()

    ناپایا exact := رابط‌پایانه.بافر جدید(2، 1)
    exact.نوشتن متن(0، 0، "中"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(exact.دریافت(0، 0).نویسه، "中")
    آزمایش.ادعای برابری رشته(exact.دریافت(1، 0).نویسه، "")
    exact.آزادسازی()

    ناپایا edge := رابط‌پایانه.بافر جدید(3، 1)
    edge.نوشتن متن(2، 0، "中"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(edge.دریافت(2، 0).نویسه، " ")
    edge.آزادسازی()

    ناپایا left_edge := رابط‌پایانه.بافر جدید(2، 1)
    left_edge.نوشتن متن(-1، 0، "中"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(left_edge.متن ردیف(0)، "  ")
    left_edge.آزادسازی()

    ناپایا clipped := رابط‌پایانه.بافر جدید(4، 1)
    clipped.محدوده برش = rect(0، 0، 3، 1)
    clipped.نوشتن متن(2، 0، "中"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(clipped.دریافت(2، 0).نویسه، " ")
    آزمایش.ادعای برابری رشته(clipped.دریافت(3، 0).نویسه، " ")
    clipped.آزادسازی()

    ناپایا zero := رابط‌پایانه.بافر جدید(4، 1)
    zero.نوشتن متن(0، 0، "e\u0301b"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(zero.متن ردیف(0)، "e\u0301b  ")
    zero.آزادسازی()

    ناپایا normalized := رابط‌پایانه.بافر جدید(1، 1)
    normalized.تنظیم(0، 0، رابط‌پایانه.سلول { نویسه = "中" })
    آزمایش.ادعای برابری رشته(normalized.دریافت(0، 0).نویسه، " ")
    normalized.تنظیم(0، 0، رابط‌پایانه.سلول { نویسه = "\u200B" })
    آزمایش.ادعای برابری رشته(normalized.دریافت(0، 0).نویسه، " ")
    normalized.تنظیم(0، 0، رابط‌پایانه.سلول { نویسه = "" })
    آزمایش.ادعای برابری رشته(normalized.دریافت(0، 0).نویسه، " ")
    normalized.آزادسازی()

    ناپایا overwrite := رابط‌پایانه.بافر جدید(3، 1)
    overwrite.نوشتن متن(0، 0، "中a"، رابط‌پایانه.ظاهر پیش‌فرض)
    overwrite.تنظیم(1، 0، رابط‌پایانه.سلول { نویسه = "x" })
    آزمایش.ادعای برابری رشته(overwrite.متن ردیف(0)، " xa")
    آزمایش.ادعای برابری عدد(رابط‌پایانه.اندازه‌گیری متن(overwrite.متن ردیف(0)، 0).عرض، overwrite.عرض)
    overwrite.پاک‌سازی()
    overwrite.نوشتن متن(0، 0، "中a"، رابط‌پایانه.ظاهر پیش‌فرض)
    overwrite.تنظیم(0، 0، رابط‌پایانه.سلول { نویسه = "y" })
    آزمایش.ادعای برابری رشته(overwrite.متن ردیف(0)، "y a")
    آزمایش.ادعای برابری عدد(رابط‌پایانه.اندازه‌گیری متن(overwrite.متن ردیف(0)، 0).عرض، overwrite.عرض)
    overwrite.پاک‌سازی()
    overwrite.نوشتن متن(0، 0، "中a"، رابط‌پایانه.ظاهر پیش‌فرض)
    overwrite.پرکردن(rect(1، 0، 1، 1)، " "، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(overwrite.متن ردیف(0)، "  a")
    آزمایش.ادعای برابری عدد(رابط‌پایانه.اندازه‌گیری متن(overwrite.متن ردیف(0)، 0).عرض، overwrite.عرض)
    overwrite.آزادسازی()

    ناپایا filled := رابط‌پایانه.بافر جدید(3، 1)
    filled.پرکردن(rect(0، 0، 3، 1)، "中"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(filled.متن ردیف(0)، "   ")
    filled.آزادسازی()

    ناپایا invariant := رابط‌پایانه.بافر جدید(5، 1)
    invariant.نوشتن متن(0، 0، "中a"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری عدد(رشته.شمارنویسه(invariant.متن ردیف(0))، 4)
    آزمایش.ادعای برابری رشته(invariant.متن ردیف(0)، "中a  ")
    invariant.پاک‌سازی()
    invariant.نوشتن متن(0، 0، "abcde"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری عدد(رشته.شمارنویسه(invariant.متن ردیف(0))، invariant.عرض)
    invariant.آزادسازی()

    ناپایا changed := رابط‌پایانه.بافر جدید(3، 1)
    changed.ثبت قاب()
    changed.نوشتن متن(0، 0، "中b"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(changed.اختلاف()، پایانه.دنباله رفتن به(1، 1) + "中b")
    changed.آزادسازی()
پایان

تابع test_fill_and_clear():
    ناپایا b := رابط‌پایانه.بافر جدید(4، 3)
    b.پرکردن(rect(1، 1، 5، 5)، "#"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "    ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، " ###")
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، " ###")
    b.پاک‌سازی()
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "    ")
    b.آزادسازی()
پایان

تابع test_resize():
    ناپایا b := رابط‌پایانه.بافر جدید(2، 2)
    b.تنظیم(0، 0، رابط‌پایانه.سلول { نویسه = "x"، ظاهر = رابط‌پایانه.ظاهر { پررنگ = درست } })
    b.تغییر اندازه(4، 3)
    آزمایش.ادعای برابری عدد(b.عرض، 4)
    آزمایش.ادعای برابری عدد(b.ارتفاع، 3)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "    ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، "    ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(3)، "")
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، " ")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
    b.تنظیم(3، 2، رابط‌پایانه.سلول { نویسه = "z" })
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، "   z")
    b.تنظیم(4، 2، رابط‌پایانه.سلول { نویسه = "!" })
    آزمایش.ادعای برابری رشته(b.دریافت(4، 2).نویسه، " ")
    آزمایش.ادعای برابری رشته(b.دریافت(3، 2).نویسه، "z")
    آزمایش.ادعای برابری عدد(b.محدوده برش.عرض، 4)
    آزمایش.ادعای برابری عدد(b.محدوده برش.ارتفاع، 3)
    b.تغییر اندازه(-2، 1)
    آزمایش.ادعای برابری عدد(b.عرض، 0)
    آزمایش.ادعای برابری عدد(b.ارتفاع، 1)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "")
    b.تغییر اندازه(0، 0)
    آزمایش.ادعای برابری عدد(b.عرض، 0)
    آزمایش.ادعای برابری عدد(b.ارتفاع، 0)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "")
    b.آزادسازی()
پایان

تابع test_resize_preserves_tier():
    ناپایا b := رابط‌پایانه.بافر جدید(2، 2)
    آزمایش.ادعای درستی(b.سطح رنگ برابر رابط‌پایانه.سطح‌رنگ.TrueColor)
    b.سطح رنگ = رابط‌پایانه.سطح‌رنگ.Ansi16
    b.تغییر اندازه(4، 3)
    آزمایش.ادعای درستی(b.سطح رنگ برابر رابط‌پایانه.سطح‌رنگ.Ansi16)
    b.تغییر اندازه(0، 0)
    آزمایش.ادعای درستی(b.سطح رنگ برابر رابط‌پایانه.سطح‌رنگ.Ansi16)
    b.آزادسازی()
پایان

تابع test_ansi_serialization():
    ناپایا b := رابط‌پایانه.بافر جدید(2، 2)
    bold := رابط‌پایانه.ظاهر { پررنگ = درست }
    b.تنظیم(0، 0، رابط‌پایانه.سلول { نویسه = "a" })
    b.تنظیم(1، 0، رابط‌پایانه.سلول { نویسه = "b"، ظاهر = bold })
    b.تنظیم(0، 1، رابط‌پایانه.سلول { نویسه = "c"، ظاهر = bold })
    b.تنظیم(1، 1، رابط‌پایانه.سلول { نویسه = "d" })
    seq_on := رابط‌پایانه.دنباله فعال‌سازی ظاهر(bold، رابط‌پایانه.سطح‌رنگ.TrueColor)
    seq_off := رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(bold، رابط‌پایانه.سطح‌رنگ.TrueColor)
    want := پایانه.دنباله رفتن به(1، 1) + "a" + seq_on + "b" + پایانه.دنباله رفتن به(2، 1) + "c" + seq_off + "d"
    آزمایش.ادعای برابری رشته(b.خروجی کامل انسی()، want)
    آزمایش.ادعای نادرستی(رشته.شامل است(b.خروجی کامل انسی()، پایانه.بازنشانی))
    b.آزادسازی()
پایان

تابع test_put_str_style():
    ناپایا b := رابط‌پایانه.بافر جدید(3، 1)
    bold := رابط‌پایانه.ظاهر { پررنگ = درست }
    b.نوشتن متن(0، 0، "abc"، bold)
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، bold))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(2، 0).ظاهر، bold))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "abc")
    b.آزادسازی()
پایان

تابع test_off_grid_starts():
    ناپایا b := رابط‌پایانه.بافر جدید(3، 2)
    b.نوشتن متن(-1، 0، "ab"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "b  ")
    b.پاک‌سازی()
    b.نوشتن متن(0، -1، "xy"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "   ")
    b.نوشتن متن(3، 0، "z"، رابط‌پایانه.ظاهر پیش‌فرض)
    b.نوشتن متن(0، 2، "z"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "   ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "   ")
    b.آزادسازی()
پایان

تابع test_fill_edges():
    ناپایا b := رابط‌پایانه.بافر جدید(2، 2)
    b.پرکردن(rect(-1، -1، 3، 3)، "#"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "##")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "##")
    b.پاک‌سازی()
    b.پرکردن(rect(2، 0، 1، 1)، "#"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "  ")
    b.آزادسازی()

    ناپایا c := رابط‌پایانه.بافر جدید(3، 3)
    ناپایا view := c
    view.محدوده برش = rect(1، 1، 1، 1)
    view.پرکردن(rect(0، 0، 3، 3)، "#"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(c.متن ردیف(0)، "   ")
    آزمایش.ادعای برابری رشته(c.متن ردیف(1)، " # ")
    آزمایش.ادعای برابری رشته(c.متن ردیف(2)، "   ")
    c.آزادسازی()
پایان

تابع test_clip_vs_grid():
    ناپایا b := رابط‌پایانه.بافر جدید(3، 2)
    ناپایا view := b
    view.محدوده برش = rect(1، 0، 1، 1)
    view.تنظیم(0، 1، رابط‌پایانه.سلول { نویسه = "x" })
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "   ")
    view.تنظیم(1، 0، رابط‌پایانه.سلول { نویسه = "y" })
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، " y ")
    آزمایش.ادعای برابری رشته(view.دریافت(0، 0).نویسه، " ")
    آزمایش.ادعای برابری رشته(view.دریافت(1، 0).نویسه، "y")
    آزمایش.ادعای برابری رشته(view.متن ردیف(0)، " y ")
    view.پاک‌سازی()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "   ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "   ")
    b.آزادسازی()
