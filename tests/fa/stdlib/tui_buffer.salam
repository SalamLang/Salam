    آزمایش.ادعای برابری رشته(b.اختلاف()، "")
    b.تغییر اندازه(3، 1)
    آزمایش.ادعای درستی(b.اجبار بازترسیم کامل)
    آزمایش.ادعای برابری عدد(b.عرض، 3)
    آزمایش.ادعای برابری عدد(b.ارتفاع، 1)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "   ")
    آزمایش.ادعای برابری رشته(b.اختلاف()، b.خروجی کامل انسی())
    b.آزادسازی()
