تابع test_put_str_reuses_glyph_strings():
    ناپایا b := رابط‌پایانه.بافر جدید(4، 2)
    b.نوشتن متن(0، 0، "a中"، رابط‌پایانه.ظاهر پیش‌فرض)
    b.نوشتن متن(0، 1، "a中"، رابط‌پایانه.ظاهر پیش‌فرض)
    first := b.دریافت(0، 0).نویسه
    wide := b.دریافت(1، 0).نویسه
    b.نوشتن متن(0، 0، "a中"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای درستی(b.دریافت(0، 0).نویسه برگردان تهی* برابر first برگردان تهی*)
    آزمایش.ادعای درستی(b.دریافت(0، 1).نویسه برگردان تهی* برابر first برگردان تهی*)
    آزمایش.ادعای درستی(b.دریافت(1، 1).نویسه برگردان تهی* برابر wide برگردان تهی*)
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "a中 ")
    b.آزادسازی()
پایان

تابع test_put_str_keeps_zero_width_marks():
    ناپایا b := رابط‌پایانه.بافر جدید(6، 1)
    b.نوشتن متن(0، 0، "e\u0301b\u200Cc"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، "e\u0301")
    آزمایش.ادعای برابری رشته(b.دریافت(1، 0).نویسه، "b\u200C")
    آزمایش.ادعای برابری رشته(b.دریافت(2، 0).نویسه، "c")
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "e\u0301b\u200Cc   ")
    آزمایش.ادعای برابری عدد(رابط‌پایانه.اندازه‌گیری متن(b.متن ردیف(0)، 0).عرض، 6)
    آزمایش.ادعای برابری رشته(b.اختلاف()، پایانه.دنباله رفتن به(1، 1) + "e\u0301b\u200Cc   ")
    b.ثبت قاب()
    b.نوشتن متن(0، 0، "\u0301x\tz"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "xzc   ")
    b.آزادسازی()

    ناپایا clipped := رابط‌پایانه.بافر جدید(3، 1)
    clipped.محدوده برش = rect(0، 0، 1، 1)
    clipped.نوشتن متن(0، 0، "ab\u0301"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(clipped.متن ردیف(0)، "a  ")
    clipped.آزادسازی()
پایان

تابع test_emoji_presentation_is_wide():
    هر s در ["\U0001F680"، "\U00002705"، "\U0000274C"، "\U00002B50"، "\U000026A1"، "\U0001F7E2"، "\U0001FAE0"، "\U0000231A"]:
        آزمایش.ادعای برابری عدد(رابط‌پایانه.اندازه‌گیری متن(s، 0).عرض، 2)
    پایان
    هر s در ["\U00002764"، "\U00002122"، "a"، "\U00000645"]:
        آزمایش.ادعای برابری عدد(رابط‌پایانه.اندازه‌گیری متن(s، 0).عرض، 1)
    پایان
    ناپایا b := رابط‌پایانه.بافر جدید(5، 1)
    b.نوشتن متن(0، 0، "\U0001F680ab"، رابط‌پایانه.ظاهر پیش‌فرض)
    آزمایش.ادعای برابری رشته(b.دریافت(1، 0).نویسه، "")
    آزمایش.ادعای برابری رشته(b.دریافت(2، 0).نویسه، "a")
    b.آزادسازی()
پایان

