تابع test_commit_front_matches_cells():
    ناپایا b := رابط‌پایانه.بافر جدید(3، 2)
    bold := رابط‌پایانه.ظاهر { پررنگ = درست }
    b.تنظیم(0، 0، رابط‌پایانه.سلول { نویسه = "a" })
    b.تنظیم(2، 0، رابط‌پایانه.سلول { نویسه = "b"، ظاهر = bold })
    b.تنظیم(1، 1، رابط‌پایانه.سلول { نویسه = "c" })
    b.ثبت قاب()
    تکرار b.سلول‌ها.طول() در i:
        آزمایش.ادعای برابری رشته(b.بافر پیشین.بگیر(i).نویسه، b.سلول‌ها.بگیر(i).نویسه)
        آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.بافر پیشین.بگیر(i).ظاهر، b.سلول‌ها.بگیر(i).ظاهر))
    پایان
    b.آزادسازی()
پایان

