تابع test_screen_focus_waits_for_bounds():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 24، 3)
    دیرکن s.بستن()
    sink := s.افزودن(رابط‌پایانه.شناسه ریشه، Sink {})
    s.ویجت(sink).تنظیم محدوده(rect(0، 0، 24، 1))
    btn := s.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.دکمه جدید("OK") برگردان پویا رابط‌پایانه.ویجت)
    آزمایش.ادعای نادرستی(s.تمرکز‌پذیر است(btn))
    s.تمرکز بعدی()
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، sink)
    s.ویجت(btn).تنظیم محدوده(rect(0، 1، 10، 1))
    آزمایش.ادعای درستی(s.تمرکز‌پذیر است(btn))
    s.تمرکز بعدی()
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، btn)
