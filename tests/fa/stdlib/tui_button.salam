تابع test_screen_keys_follow_focus():
    taps = 0
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 24، 3)
    دیرکن s.بستن()
    sink := s.افزودن(رابط‌پایانه.شناسه ریشه، Sink {})
    s.ویجت(sink).تنظیم محدوده(rect(0، 0، 24، 1))
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    b.هنگام کلیک = (): tap() پایان
    btn := s.افزودن(رابط‌پایانه.شناسه ریشه، b برگردان پویا رابط‌پایانه.ویجت)
    s.ویجت(btn).تنظیم محدوده(rect(0، 1، 10، 1))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، sink)
    آزمایش.ادعای نادرستی(s.هدایت رویداد(special(پایانه.کلید ورود)))
    آزمایش.ادعای برابری عدد(taps، 0)
    آزمایش.ادعای درستی(s.تمرکز(btn))
    آزمایش.ادعای درستی(s.هدایت رویداد(special(پایانه.کلید ورود)))
    آزمایش.ادعای برابری عدد(taps، 1)
پایان

