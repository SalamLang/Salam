تابع test_render_disabled_drops_caller_bold():
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    b.ظاهر = رابط‌پایانه.ظاهر { پررنگ = درست }
    bold := رابط‌پایانه.ظاهر { پررنگ = درست }
    dim := رابط‌پایانه.ظاهر { کم‌رنگ = درست }
    b.غیرفعال = درست
    ناپایا buf := paint(b، 10، 1، نادرست)
    آزمایش.ادعای برابری رشته(buf.خروجی کامل انسی()، row_bytes(dim، "[   OK   ]"))
    آزمایش.ادعای درستی(رشته.شامل است(buf.خروجی کامل انسی()، پایانه.دنباله نمایش(پایانه.سبک کم‌رنگ)))
    آزمایش.ادعای نادرستی(رشته.شامل است(buf.خروجی کامل انسی()، پایانه.دنباله نمایش(پایانه.سبک ضخیم)))
    buf.آزادکن()
    b.غیرفعال = نادرست
    buf = paint(b، 10، 1، درست)
    آزمایش.ادعای برابری رشته(buf.خروجی کامل انسی()، row_bytes(bold، "[   OK   ]"))
    آزمایش.ادعای درستی(رشته.شامل است(buf.خروجی کامل انسی()، پایانه.دنباله نمایش(پایانه.سبک ضخیم)))
    آزمایش.ادعای نادرستی(رشته.شامل است(buf.خروجی کامل انسی()، پایانه.دنباله نمایش(پایانه.سبک کم‌رنگ)))
    buf.آزادکن()
پایان

تابع test_focus_style():
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    b.ظاهر = رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.آبی }
    b.ظاهر تمرکز = رابط‌پایانه.ظاهر { رنگ پس‌زمینه = رابط‌پایانه.سفید }
    check_row(b، 10، درست، "[   OK   ]"، رابط‌پایانه.ظاهر { رنگ پس‌زمینه = رابط‌پایانه.سفید })
    check_row(b، 10، نادرست، "[   OK   ]"، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.آبی })
    b.غیرفعال = درست
    dim := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.آبی، کم‌رنگ = درست }
    check_row(b، 10، درست، "[   OK   ]"، dim)
پایان

تابع test_sgr_memo_probe():
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    buf := رابط‌پایانه.بافر جدید(10، 1)
    before := رابط‌پایانه.شمار ساخت اس‌جی‌آر()
    b.ترسیم(buf، rect(0، 0، 10، 1))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    _ := buf.خروجی کامل انسی()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    b.ظاهر = رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.آبی }
    b.ترسیم(buf، rect(0، 0، 10، 1))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    _ := buf.خروجی کامل انسی()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 2)
    buf.آزادسازی()

    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 10، 1)
    دیرکن s.بستن()
    id := s.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.دکمه جدید("OK") برگردان پویا رابط‌پایانه.ویجت)
    s.ویجت(id).تنظیم محدوده(rect(0، 0، 10، 1))
    s.نمایش تغییرات()
    built := رابط‌پایانه.شمار ساخت اس‌جی‌آر()
    s.علامت‌گذاری برای بازترسیم(id)
    s.نمایش تغییرات()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر()، built)
پایان

