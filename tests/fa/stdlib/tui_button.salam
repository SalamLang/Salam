واردسازی آزمایش
واردسازی پایانه
واردسازی رشته
واردسازی رابط‌پایانه

ناپایا taps := 0

ساختار Sink:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع focusable(): منطقی:
        برگشت درست
    پایان
پایان

تابع tap():
    taps++
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع special(code: صحیح): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = code } }
پایان

تابع mouse(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.کلید { خام = seq }، ماوس = پایانه.رمزگشایی موشواره(seq) }
پایان

تابع click(x: صحیح، y: صحیح): رابط‌پایانه.رویداد:
    برگشت mouse("\x1b[<0;" + (x + 1) + ";" + (y + 1) + "M")
پایان

تابع paint(b: رابط‌پایانه.دکمه، w: صحیح، h: صحیح، focused: منطقی): رابط‌پایانه.بافر:
    ناپایا buf := رابط‌پایانه.بافر جدید(w، h)
    buf.در تمرکز = focused
    ناپایا bb := b
    bb.ترسیم(buf، rect(0، 0، w، h))
    برگشت buf
پایان

تابع row_bytes(style: رابط‌پایانه.ظاهر، text: رشته): رشته:
    برگشت پایانه.دنباله رفتن به(1، 1) + رابط‌پایانه.دنباله فعال‌سازی ظاهر(style، رابط‌پایانه.سطح‌رنگ.TrueColor) + text + رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(style، رابط‌پایانه.سطح‌رنگ.TrueColor)
پایان

تابع check_row(b: رابط‌پایانه.دکمه، w: صحیح، focused: منطقی، text: رشته، style: رابط‌پایانه.ظاهر):
    buf := paint(b، w، 1، focused)
    آزمایش.ادعای برابری رشته(buf.خروجی کامل انسی()، row_bytes(style، text))
    buf.آزادکن()
پایان

تابع test_defaults():
    b := رابط‌پایانه.دکمه جدید("OK")
    آزمایش.ادعای برابری رشته(b.برچسب، "OK")
    آزمایش.ادعای نادرستی(b.غیرفعال)
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.ظاهر تمرکز، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای درستی(b.اصابت‌پذیر است())
    آزمایش.ادعای نادرستی(b.تمرکز‌پذیر است())
پایان

تابع test_predicates():
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    b.تنظیم محدوده(rect(0، 0، 10، 1))
    آزمایش.ادعای درستی(b.تمرکز‌پذیر است())
    آزمایش.ادعای درستی(b.اصابت‌پذیر است())
    b.غیرفعال = درست
    آزمایش.ادعای نادرستی(b.تمرکز‌پذیر است())
    آزمایش.ادعای نادرستی(b.اصابت‌پذیر است())
    b.غیرفعال = نادرست
    b.تنظیم محدوده(rect(0، 0، 0، 1))
    آزمایش.ادعای نادرستی(b.تمرکز‌پذیر است())
پایان

تابع test_keys():
    taps = 0
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    b.هنگام کلیک = (): tap() پایان
    b.تنظیم محدوده(rect(0، 0، 10، 1))
    آزمایش.ادعای درستی(b.پردازش رویداد(special(پایانه.کلید ورود)))
    آزمایش.ادعای برابری عدد(taps، 1)
    آزمایش.ادعای درستی(b.پردازش رویداد(key(" ")))
    آزمایش.ادعای برابری عدد(taps، 2)
    آزمایش.ادعای نادرستی(b.پردازش رویداد(key("a")))
    آزمایش.ادعای برابری عدد(taps، 2)
    b.غیرفعال = درست
    آزمایش.ادعای نادرستی(b.پردازش رویداد(special(پایانه.کلید ورود)))
    آزمایش.ادعای نادرستی(b.پردازش رویداد(key(" ")))
    آزمایش.ادعای برابری عدد(taps، 2)
پایان

تابع test_clicks():
    taps = 0
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    b.هنگام کلیک = (): tap() پایان
    b.تنظیم محدوده(rect(0، 0، 10، 1))
    آزمایش.ادعای درستی(b.پردازش رویداد(click(3، 0)))
    آزمایش.ادعای برابری عدد(taps، 1)
    آزمایش.ادعای نادرستی(b.پردازش رویداد(click(10، 0)))
    آزمایش.ادعای نادرستی(b.پردازش رویداد(click(0، 1)))
    آزمایش.ادعای برابری عدد(taps، 1)
    b.غیرفعال = درست
    آزمایش.ادعای نادرستی(b.پردازش رویداد(click(3، 0)))
    آزمایش.ادعای برابری عدد(taps، 1)
پایان

تابع test_mouse_gates():
    taps = 0
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    b.هنگام کلیک = (): tap() پایان
    b.تنظیم محدوده(rect(0، 0، 10، 1))
    آزمایش.ادعای نادرستی(b.پردازش رویداد(mouse("\x1b[<0;4;1m")))
    آزمایش.ادعای نادرستی(b.پردازش رویداد(mouse("\x1b[<32;4;1M")))
    آزمایش.ادعای نادرستی(b.پردازش رویداد(mouse("\x1b[<2;4;1M")))
    آزمایش.ادعای برابری عدد(taps، 0)
پایان

تابع test_render_label_and_brackets():
    ok := رابط‌پایانه.دکمه جدید("OK")
    bold := رابط‌پایانه.ظاهر { پررنگ = درست }
    dim := رابط‌پایانه.ظاهر { کم‌رنگ = درست }
    check_row(ok، 10، نادرست، "[   OK   ]"، رابط‌پایانه.ظاهر پیش‌فرض)
    check_row(ok، 9، نادرست، "[  OK   ]"، رابط‌پایانه.ظاهر پیش‌فرض)
    check_row(ok، 10، درست، "[   OK   ]"، bold)
    ناپایا dis := ok
    dis.غیرفعال = درست
    check_row(dis، 10، نادرست، "[   OK   ]"، dim)
    check_row(رابط‌پایانه.دکمه جدید("Save and continue")، 10، نادرست، "[Save and]"، رابط‌پایانه.ظاهر پیش‌فرض)
    check_row(ok، 4، درست، "[OK]"، bold)
    check_row(ok، 3، نادرست، "[O]"، رابط‌پایانه.ظاهر پیش‌فرض)
    check_row(ok، 2، نادرست، "[]"، رابط‌پایانه.ظاهر پیش‌فرض)
    check_row(ok، 1، نادرست، "["، رابط‌پایانه.ظاهر پیش‌فرض)
پایان

تابع test_render_wide_label():
    ناپایا buf := paint(رابط‌پایانه.دکمه جدید("中文")، 6، 1، نادرست)
    دیرکن buf.آزادکن()
    آزمایش.ادعای برابری رشته(buf.متن ردیف(0)، "[中文]")
    آزمایش.ادعای برابری عدد(buf.عرض، 6)
    آزمایش.ادعای برابری رشته(buf.بگیر(1، 0).نویسه، "中")
    آزمایش.ادعای برابری رشته(buf.بگیر(2، 0).نویسه، "")
    آزمایش.ادعای برابری رشته(buf.بگیر(3، 0).نویسه، "文")
پایان

تابع test_render_zero_width():
    ناپایا buf := رابط‌پایانه.بافر جدید(10، 1)
    buf.در تمرکز = درست
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    b.ترسیم(buf، rect(0، 0، 0، 1))
    آزمایش.ادعای برابری رشته(buf.خروجی کامل انسی()، row_bytes(رابط‌پایانه.ظاهر پیش‌فرض، "          "))
    buf.آزادسازی()
پایان

تابع test_render_keeps_colours():
    ناپایا b := رابط‌پایانه.دکمه جدید("OK")
    b.ظاهر = رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.آبی، رنگ پس‌زمینه = رابط‌پایانه.سفید }
    want := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.آبی، رنگ پس‌زمینه = رابط‌پایانه.سفید، پررنگ = درست }
    check_row(b، 10، درست، "[   OK   ]"، want)
