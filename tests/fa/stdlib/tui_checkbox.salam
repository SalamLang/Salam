تابع test_render_wide_label():
    ناپایا e := رابط‌پایانه.کادر انتخاب جدید("中文字"، درست)
    ناپایا b := رابط‌پایانه.بافر جدید(6، 1)
    دیرکن b.آزادسازی()
    e.ترسیم(b، rect(0، 0، 6، 1))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "[x] 中")
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، "[")
    آزمایش.ادعای برابری رشته(b.دریافت(4، 0).نویسه، "中")
    آزمایش.ادعای برابری رشته(b.دریافت(5، 0).نویسه، "")
