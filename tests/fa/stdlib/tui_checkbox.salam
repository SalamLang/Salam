    want := پایانه.دنباله رفتن به(1، 1) + sgr(رابط‌پایانه.ظاهر { پررنگ = درست }) + "[x] Notify me " + sgr_off(رابط‌پایانه.ظاهر { پررنگ = درست })
    آزمایش.ادعای برابری رشته(ansi_of(e، 14، 14، درست)، want)
