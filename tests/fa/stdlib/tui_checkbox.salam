    آزمایش.ادعای درستی(e.پردازش رویداد(key(" ")))
    آزمایش.ادعای نادرستی(e.انتخاب شده است())
    آزمایش.ادعای برابری عدد(toggles.طول()، base + 1)
    آزمایش.ادعای نادرستی(toggles.دریافت(base))
پایان

