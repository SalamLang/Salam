تابع test_render_styled_label_frame():
    ناپایا e := رابط‌پایانه.کادر انتخاب جدید("Notify me"، نادرست)
    e.ظاهر برچسب = رابط‌پایانه.ظاهر { زیرخط = درست }
    ناپایا b := رابط‌پایانه.بافر جدید(14، 1)
    دیرکن b.آزادسازی()
    e.ترسیم(b، rect(0، 0، 14، 1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(4، 0).ظاهر، رابط‌پایانه.ظاهر { زیرخط = درست }))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(13، 0).ظاهر، رابط‌پایانه.ظاهر { زیرخط = درست }))
    want := پایانه.دنباله رفتن به(1، 1) + "[ ]" + sgr(رابط‌پایانه.ظاهر { زیرخط = درست }) + " Notify me " + sgr_off(رابط‌پایانه.ظاهر { زیرخط = درست })
    آزمایش.ادعای برابری رشته(b.خروجی کامل انسی()، want)
پایان

تابع test_sgr_memo_probe():
    ناپایا e := رابط‌پایانه.کادر انتخاب جدید("Notify me"، درست)
    buf := رابط‌پایانه.بافر جدید(14، 1)
    دیرکن buf.آزادسازی()
    before := رابط‌پایانه.شمار ساخت اس‌جی‌آر()
    e.ترسیم(buf، rect(0، 0، 14، 1))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    e.ترسیم(buf، rect(0، 0، 14، 1))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    _ := buf.خروجی کامل انسی()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    e.ظاهر کادر = رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }
    e.ترسیم(buf، rect(0، 0، 14، 1))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    _ := buf.خروجی کامل انسی()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 2)
پایان

تابع test_preferred_size():
    e := رابط‌پایانه.کادر انتخاب جدید("Notify me"، نادرست)
    ps := e.اندازه ترجیحی(0)
    آزمایش.ادعای برابری عدد(ps.عرض، 13)
    آزمایش.ادعای برابری عدد(ps.ارتفاع، 1)
    آزمایش.ادعای برابری عدد(e.اندازه ترجیحی(10).عرض، 10)
    آزمایش.ادعای برابری عدد(رابط‌پایانه.کادر انتخاب جدید(""، نادرست).اندازه ترجیحی(0).عرض، 4)
پایان

تابع test_ck01_space_checks():
    ناپایا e := رابط‌پایانه.کادر انتخاب جدید("Notify me"، نادرست)
    e.هنگام تغییر انتخاب = (v: منطقی): toggles.افزودن(v) پایان
    e.تنظیم محدوده(rect(0، 0، 14، 1))
    base := toggles.طول()
    آزمایش.ادعای درستی(e.پردازش رویداد(key(" ")))
    آزمایش.ادعای درستی(e.انتخاب شده است())
    آزمایش.ادعای برابری عدد(toggles.طول()، base + 1)
    آزمایش.ادعای درستی(toggles.دریافت(base))
پایان

تابع test_ck02_space_unchecks():
