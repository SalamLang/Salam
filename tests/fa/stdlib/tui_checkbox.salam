تابع test_ck04_space_needs_focus():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 24، 3)
    دیرکن s.بستن()
    ناپایا box := رابط‌پایانه.کادر انتخاب جدید("Notify me"، نادرست)
    box.هنگام تغییر انتخاب = (v: منطقی): toggles.افزودن(v) پایان
    w := box برگردان پویا رابط‌پایانه.ویجت
    id := s.افزودن(رابط‌پایانه.شناسه ریشه، w)
    s.ویجت(id).تنظیم محدوده(rect(0، 0، 14، 1))
    other := s.افزودن(رابط‌پایانه.شناسه ریشه، Sink {})
    s.ویجت(other).تنظیم محدوده(rect(0، 1، 14، 1))
    آزمایش.ادعای درستی(s.تمرکز(other))
    base := toggles.طول()
    آزمایش.ادعای نادرستی(s.هدایت رویداد(key(" ")))
    آزمایش.ادعای برابری عدد(toggles.طول()، base)
    آزمایش.ادعای درستی(s.تمرکز(id))
    آزمایش.ادعای درستی(s.هدایت رویداد(key(" ")))
    آزمایش.ادعای برابری عدد(toggles.طول()، base + 1)
    ناپایا probe := رابط‌پایانه.بافر جدید(14، 1)
    دیرکن probe.آزادسازی()
    w.ترسیم(probe، rect(0، 0، 14، 1))
    آزمایش.ادعای برابری رشته(probe.متن ردیف(0)، "[x] Notify me ")
