تابع test_render_disabled_drops_caller_bold():
    ناپایا e := رابط‌پایانه.کادر انتخاب جدید("Notify me"، نادرست)
    e.ظاهر کادر = رابط‌پایانه.ظاهر { پررنگ = درست }
    e.ظاهر برچسب = رابط‌پایانه.ظاهر { پررنگ = درست }
    e.غیرفعال = درست
    dim := sgr(رابط‌پایانه.ظاهر { کم‌رنگ = درست })
    ناپایا dimbuf := رابط‌پایانه.بافر جدید(14، 1)
    dimbuf.در تمرکز = درست
    e.ترسیم(dimbuf، rect(0، 0، 14، 1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(dimbuf.دریافت(2، 0).ظاهر، رابط‌پایانه.ظاهر { کم‌رنگ = درست }))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(dimbuf.دریافت(4، 0).ظاهر، رابط‌پایانه.ظاهر { کم‌رنگ = درست }))
    آزمایش.ادعای برابری رشته(dimbuf.خروجی کامل انسی()، پایانه.دنباله رفتن به(1، 1) + dim + "[ ] Notify me " + sgr_off(رابط‌پایانه.ظاهر { کم‌رنگ = درست }))
    dimbuf.آزادسازی()
    e.غیرفعال = نادرست
    bold := sgr(رابط‌پایانه.ظاهر { پررنگ = درست })
    ناپایا boldbuf := رابط‌پایانه.بافر جدید(14، 1)
    boldbuf.در تمرکز = درست
    e.ترسیم(boldbuf، rect(0، 0، 14، 1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(boldbuf.دریافت(2، 0).ظاهر، رابط‌پایانه.ظاهر { پررنگ = درست }))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(boldbuf.دریافت(4، 0).ظاهر، رابط‌پایانه.ظاهر { پررنگ = درست }))
    آزمایش.ادعای برابری رشته(boldbuf.خروجی کامل انسی()، پایانه.دنباله رفتن به(1، 1) + bold + "[ ] Notify me " + sgr_off(رابط‌پایانه.ظاهر { پررنگ = درست }))
    boldbuf.آزادسازی()
پایان

تابع test_overlay_keeps_reverse():
