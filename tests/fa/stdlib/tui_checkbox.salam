واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا toggles := وکتور {} برگردان وکتور<منطقی>

ساختار Sink:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع focusable(): منطقی:
        برگشت درست
    پایان
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع click(x: صحیح، y: صحیح): رابط‌پایانه.رویداد:
    seq := "\x1b[<0;" + (x + 1) + ";" + (y + 1) + "M"
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.کلید { خام = seq }، ماوس = پایانه.رمزگشایی موشواره(seq) }
پایان

تابع sgr(s: رابط‌پایانه.ظاهر): رشته:
    برگشت رابط‌پایانه.دنباله فعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.TrueColor)
پایان

تابع sgr_off(s: رابط‌پایانه.ظاهر): رشته:
    برگشت رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.TrueColor)
پایان

تابع row_of(c: رابط‌پایانه.کادر‌انتخاب، bufw: صحیح، bw: صحیح، focused: منطقی): رشته:
    ناپایا b := رابط‌پایانه.بافر جدید(bufw، 1)
    دیرکن b.آزادسازی()
    b.در تمرکز = focused
    c.ترسیم(b، rect(0، 0، bw، 1))
    برگشت b.متن ردیف(0)
پایان

تابع ansi_of(c: رابط‌پایانه.کادر‌انتخاب، bufw: صحیح، bw: صحیح، focused: منطقی): رشته:
    ناپایا b := رابط‌پایانه.بافر جدید(bufw، 1)
    دیرکن b.آزادسازی()
    b.در تمرکز = focused
    c.ترسیم(b، rect(0، 0، bw، 1))
    برگشت b.خروجی کامل انسی()
پایان

تابع test_defaults():
    ناپایا e := رابط‌پایانه.کادر انتخاب جدید("Notify me"، نادرست)
    آزمایش.ادعای نادرستی(e.انتخاب شده است())
    آزمایش.ادعای برابری رشته(e.برچسب، "Notify me")
    آزمایش.ادعای نادرستی(e.غیرفعال)
    آزمایش.ادعای نادرستی(e.تمرکز‌پذیر است())
    آزمایش.ادعای درستی(e.اصابت‌پذیر است())
    e.تنظیم محدوده(rect(0، 0، 14، 1))
    آزمایش.ادعای درستی(e.تمرکز‌پذیر است())
    e.غیرفعال = درست
    آزمایش.ادعای نادرستی(e.تمرکز‌پذیر است())
    آزمایش.ادعای نادرستی(e.اصابت‌پذیر است())
    آزمایش.ادعای درستی(رابط‌پایانه.کادر انتخاب جدید(""، درست).انتخاب شده است())
پایان

تابع test_getter_and_setter():
    ناپایا e := رابط‌پایانه.کادر انتخاب جدید("Notify me"، نادرست)
    e.تنظیم انتخاب(درست)
    آزمایش.ادعای درستی(e.انتخاب شده است())
    آزمایش.ادعای برابری رشته(row_of(e، 14، 14، نادرست)، "[x] Notify me ")
    آزمایش.ادعای درستی(e.انتخاب شده است())
    e.تنظیم انتخاب(نادرست)
    آزمایش.ادعای نادرستی(e.انتخاب شده است())
پایان

