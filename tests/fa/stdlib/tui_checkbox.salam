    e.ظاهر کادر = رابط‌پایانه.ظاهر { معکوس = درست }
    e.ظاهر برچسب = رابط‌پایانه.ظاهر { معکوس = درست }
    e.غیرفعال = درست
    ناپایا buf := رابط‌پایانه.بافر جدید(9، 1)
    e.ترسیم(buf، rect(0، 0، 9، 1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(buf.دریافت(2، 0).ظاهر، رابط‌پایانه.ظاهر { معکوس = درست، کم‌رنگ = درست }))
    buf.آزادسازی()
پایان

