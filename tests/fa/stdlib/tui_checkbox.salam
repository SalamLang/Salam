تابع test_ck05_disabled_ignores_space_and_click():
    ناپایا e := رابط‌پایانه.کادر انتخاب جدید("Notify me"، نادرست)
    e.تنظیم محدوده(rect(0، 0، 14، 1))
    e.غیرفعال = درست
    base := toggles.طول()
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key(" ")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(click(5، 0)))
    آزمایش.ادعای نادرستی(e.انتخاب شده است())
    آزمایش.ادعای برابری عدد(toggles.طول()، base)
