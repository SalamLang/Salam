تابع test_equality_equal():
    آزمایش.ادعای درستی(رابط‌پایانه.رنگ.Default برابر رابط‌پایانه.رنگ.Default)
    آزمایش.ادعای درستی(رابط‌پایانه.رنگ.Ansi(1) برابر رابط‌پایانه.رنگ.Ansi(1))
    آزمایش.ادعای درستی(رابط‌پایانه.رنگ.Indexed(196) برابر رابط‌پایانه.رنگ.Indexed(196))
    آزمایش.ادعای درستی(رابط‌پایانه.رنگ.Rgb(255، 0، 0) برابر رابط‌پایانه.رنگ.Rgb(255، 0، 0))
    آزمایش.ادعای درستی(رابط‌پایانه.مشکی برابر رابط‌پایانه.رنگ.Ansi(0))
پایان

تابع test_equality_unequal():
    آزمایش.ادعای نادرستی(رابط‌پایانه.رنگ.Ansi(1) برابر رابط‌پایانه.رنگ.Ansi(9))
    آزمایش.ادعای نادرستی(رابط‌پایانه.رنگ.Default برابر رابط‌پایانه.رنگ.Ansi(7))
    آزمایش.ادعای نادرستی(رابط‌پایانه.رنگ.Ansi(1) برابر رابط‌پایانه.رنگ.Indexed(1))
    آزمایش.ادعای نادرستی(رابط‌پایانه.رنگ.Indexed(1) برابر رابط‌پایانه.رنگ.Rgb(205، 0، 0))
    آزمایش.ادعای نادرستی(رابط‌پایانه.رنگ.Indexed(196) برابر رابط‌پایانه.رنگ.Rgb(255، 0، 0))
    آزمایش.ادعای نادرستی(رابط‌پایانه.رنگ.Rgb(255، 0، 0) برابر رابط‌پایانه.رنگ.Rgb(255، 0، 1))
پایان

