تابع test_fg_seq_ansi_range():
    ناپایا n := 0
    تا n کوچکتر 8:
        آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله رنگ پیش‌زمینه(رابط‌پایانه.رنگ.Ansi(n))، پایانه.دنباله نمایش(30 + n))
        n++
    پایان
    تا n کوچکتر 16:
        آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله رنگ پیش‌زمینه(رابط‌پایانه.رنگ.Ansi(n))، پایانه.دنباله نمایش(90 + (n - 8)))
        n++
    پایان
پایان

