واردسازی محیط
واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

تابع kind(c: رابط‌پایانه.رنگ): صحیح:
    برگشت همخوان c:
        Default: 0 پایان
        Ansi(_): 1 پایان
        Indexed(_): 2 پایان
        Rgb(_، _، _): 3 پایان
    پایان
پایان

تابع ansi_n(c: رابط‌پایانه.رنگ): صحیح:
    برگشت همخوان c:
        Ansi(n): n پایان
        وگرنه: -1 پایان
    پایان
پایان

تابع indexed_n(c: رابط‌پایانه.رنگ): صحیح:
    برگشت همخوان c:
        Indexed(n): n پایان
        وگرنه: -1 پایان
    پایان
پایان

تابع rgb_r(c: رابط‌پایانه.رنگ): صحیح:
    برگشت همخوان c:
        Rgb(r، _، _): r پایان
        وگرنه: -1 پایان
    پایان
پایان

تابع rgb_g(c: رابط‌پایانه.رنگ): صحیح:
    برگشت همخوان c:
        Rgb(_، g، _): g پایان
        وگرنه: -1 پایان
    پایان
پایان

تابع rgb_b(c: رابط‌پایانه.رنگ): صحیح:
    برگشت همخوان c:
        Rgb(_، _، b): b پایان
        وگرنه: -1 پایان
    پایان
پایان

تابع test_construct_kind():
    آزمایش.ادعای برابری عدد(kind(رابط‌پایانه.رنگ.Default)، 0)
    آزمایش.ادعای برابری عدد(kind(رابط‌پایانه.رنگ.Ansi(3))، 1)
    آزمایش.ادعای برابری عدد(kind(رابط‌پایانه.رنگ.Indexed(196))، 2)
    آزمایش.ادعای برابری عدد(kind(رابط‌پایانه.رنگ.Rgb(255، 135، 0))، 3)
پایان

تابع test_payload_round_trip():
    آزمایش.ادعای برابری عدد(ansi_n(رابط‌پایانه.رنگ.Ansi(3))، 3)
    آزمایش.ادعای برابری عدد(ansi_n(رابط‌پایانه.رنگ.Ansi(15))، 15)
    آزمایش.ادعای برابری عدد(indexed_n(رابط‌پایانه.رنگ.Indexed(196))، 196)
    آزمایش.ادعای برابری عدد(indexed_n(رابط‌پایانه.رنگ.Indexed(0))، 0)
    آزمایش.ادعای برابری عدد(rgb_r(رابط‌پایانه.رنگ.Rgb(255، 135، 0))، 255)
    آزمایش.ادعای برابری عدد(rgb_g(رابط‌پایانه.رنگ.Rgb(255، 135، 0))، 135)
    آزمایش.ادعای برابری عدد(rgb_b(رابط‌پایانه.رنگ.Rgb(255، 135، 0))، 0)
پایان

