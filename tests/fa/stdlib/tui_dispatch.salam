واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا visits := وکتور {} برگردان وکتور<رشته>

ساختار Recorder:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی name: رشته = ""
    همگانی takes: رشته = ""

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        visits.افزودن(این.name)
        برگشت event.نوع برابر رابط‌پایانه.رویداد کیبورد و str_contains(این.takes، event.کلید.نویسه)
    پایان
پایان

تابع str_contains(hay: رشته، needle: رشته): منطقی:
    اگر needle برابر "":
        برگشت نادرست
    پایان
    برگشت hay.بیاب(needle) بزرگتربرابر 0
پایان

تابع key(ch: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(ch) }
پایان

تابع trail(): رشته:
    ناپایا out := ""
    هر i، v در visits:
        اگر i بزرگتر 0:
            out += ">"
        پایان
        out += v
    پایان
    visits.پاک‌سازی()
    برگشت out
پایان

تابع build(): رابط‌پایانه.درخت:
    ناپایا t := رابط‌پایانه.درخت جدید(Recorder { name = "root"، takes = "r" })
    panel := t.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "panel"، takes = "p" })
    _left := t.افزودن(panel، Recorder { name = "left"، takes = "l" })
    _right := t.افزودن(panel، Recorder { name = "right"، takes = "x" })
    _footer := t.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "footer"، takes = "f" })
    برگشت t
پایان

تابع test_structure():
    ناپایا t := build()
    آزمایش.ادعای برابری عدد(t.تعداد()، 5)
    آزمایش.ادعای برابری عدد(t.والد(0)، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای برابری عدد(t.والد(1)، 0)
    آزمایش.ادعای برابری عدد(t.والد(2)، 1)
    آزمایش.ادعای برابری عدد(t.والد(3)، 1)
    آزمایش.ادعای برابری عدد(t.والد(4)، 0)
    آزمایش.ادعای برابری عدد(t.والد(99)، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای درستی(t.معتبر است(4))
    آزمایش.ادعای نادرستی(t.معتبر است(5))
    آزمایش.ادعای نادرستی(t.معتبر است(-1))
    t.آزادکن()
پایان

تابع test_consumed_by_start():
    ناپایا t := build()
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(2، key("l"))، 2)
    آزمایش.ادعای برابری رشته(trail()، "left")
    t.آزادکن()
پایان

تابع test_bubbles_to_parent():
    ناپایا t := build()
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(2، key("p"))، 1)
    آزمایش.ادعای برابری رشته(trail()، "left>panel")
    t.آزادکن()
پایان

تابع test_bubbles_to_root():
    ناپایا t := build()
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(3، key("r"))، 0)
    آزمایش.ادعای برابری رشته(trail()، "right>panel>root")
    t.آزادکن()
پایان

تابع test_unconsumed():
    ناپایا t := build()
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(2، key("z"))، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای برابری رشته(trail()، "left>panel>root")
    t.آزادکن()
پایان

تابع test_siblings_never_see_it():
    ناپایا t := build()
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(2، key("x"))، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای برابری رشته(trail()، "left>panel>root")
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(4، key("p"))، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای برابری رشته(trail()، "footer>root")
    t.آزادکن()
پایان

تابع test_non_key_events_bubble_too():
    ناپایا t := build()
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(2، رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تیک })، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای برابری رشته(trail()، "left>panel>root")
    t.آزادکن()
پایان

تابع test_invalid_start_is_root():
    ناپایا t := build()
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(رابط‌پایانه.بدون ویجت، key("r"))، 0)
    آزمایش.ادعای برابری رشته(trail()، "root")
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(42، key("z"))، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای برابری رشته(trail()، "root")
    t.آزادکن()
پایان

تابع test_unfocusable_start_is_visited_and_bubbles():
    ناپایا t := build()
    آزمایش.ادعای نادرستی(t.بگیر(2).تمرکز‌پذیر است())
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(2، key("l"))، 2)
    آزمایش.ادعای برابری رشته(trail()، "left")
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(2، key("r"))، 0)
    آزمایش.ادعای برابری رشته(trail()، "left>panel>root")
    t.آزادکن()
پایان

تابع test_invalid_parent_attaches_to_root():
    ناپایا t := build()
    id := t.افزودن(77، Recorder { name = "stray" })
    آزمایش.ادعای برابری عدد(t.والد(id)، رابط‌پایانه.شناسه ریشه)
    آزمایش.ادعای برابری عدد(t.هدایت رویداد(id، key("z"))، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای برابری رشته(trail()، "stray>root")
    t.آزادکن()
پایان

تابع test_get_shares_widget():
    ناپایا t := build()
    t.بگیر(3).تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 7، عرض = 2، ارتفاع = 1 })
    آزمایش.ادعای برابری عدد(t.بگیر(3).محدوده().ایکس، 7)
    t.بگیر(0).تنظیم محدوده(رابط‌پایانه.مستطیل { عرض = 80، ارتفاع = 24 })
    آزمایش.ادعای برابری عدد(t.بگیر(-5).محدوده().عرض، 80)
    t.آزادکن()
پایان

تابع ریشه:
    test_structure()
    test_consumed_by_start()
    test_bubbles_to_parent()
    test_bubbles_to_root()
    test_unconsumed()
    test_siblings_never_see_it()
    test_non_key_events_bubble_too()
    test_invalid_start_is_root()
    test_unfocusable_start_is_visited_and_bubbles()
    test_invalid_parent_attaches_to_root()
    test_get_shares_widget()
    visits.آزادسازی()
    برگشت آزمایش.خلاصه()
پایان
