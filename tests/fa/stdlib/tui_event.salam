واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع test_kinds_are_distinct():
    ناپایا kinds := وکتور {} برگردان وکتور<صحیح>
    دیرکن kinds.آزادسازی()
    kinds.افزودن(رابط‌پایانه.بدون رویداد)
    kinds.افزودن(رابط‌پایانه.رویداد کیبورد)
    kinds.افزودن(رابط‌پایانه.رویداد ماوس)
    kinds.افزودن(رابط‌پایانه.رویداد تغییر اندازه)
    kinds.افزودن(رابط‌پایانه.رویداد تیک)
    تکرار kinds.طول() در i:
        تکرار kinds.طول() در j:
            اگر i نابرابر j:
                آزمایش.ادعای نابرابری عدد(kinds.دریافت(i)، kinds.دریافت(j))
            پایان
        پایان
    پایان
پایان

تابع test_zero_event():
    e := رابط‌پایانه.رویداد {}
    آزمایش.ادعای برابری عدد(e.نوع، رابط‌پایانه.بدون رویداد)
    آزمایش.ادعای نادرستی(e.کلید است(پایانه.کلید ناشناخته))
    آزمایش.ادعای نادرستی(e.نویسه است(""))
پایان

تابع test_is_key():
    آزمایش.ادعای درستی(key("\x1b[A").کلید است(پایانه.کلید بالا))
    آزمایش.ادعای درستی(key("\r").کلید است(پایانه.کلید ورود))
    آزمایش.ادعای درستی(key("\t").کلید است(پایانه.کلید تب))
    آزمایش.ادعای نادرستی(key("\x1b[A").کلید است(پایانه.کلید پایین))
    ناپایا r := key("\x1b[A")
    r.نوع = رابط‌پایانه.رویداد تغییر اندازه
    آزمایش.ادعای نادرستی(r.کلید است(پایانه.کلید بالا))
پایان

تابع test_is_char():
    آزمایش.ادعای درستی(key("q").نویسه است("q"))
    آزمایش.ادعای نادرستی(key("q").نویسه است("Q"))
    آزمایش.ادعای نادرستی(key("\x11").نویسه است("q"))
    آزمایش.ادعای نادرستی(key("\x1bq").نویسه است("q"))
    آزمایش.ادعای درستی(key("س").نویسه است("س"))
پایان

تابع test_is_ctrl():
    ctrl_c := key("\x03")
    آزمایش.ادعای درستی(ctrl_c.ترکیب کنترل است("c"))
    آزمایش.ادعای نادرستی(ctrl_c.نویسه است("c"))
    آزمایش.ادعای نادرستی(key("c").ترکیب کنترل است("c"))
پایان

تابع test_resize_and_tick_payloads():
    r := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تغییر اندازه، عرض = 120، ارتفاع = 40 }
    آزمایش.ادعای برابری عدد(r.عرض، 120)
    آزمایش.ادعای برابری عدد(r.ارتفاع، 40)
    آزمایش.ادعای نادرستی(r.کلید است(پایانه.کلید ناشناخته))
    t := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تیک }
    آزمایش.ادعای برابری رشته(t.کلید.نویسه، "")
پایان

تابع test_mouse_payload():
    seq := "\x1b[<0;10;5M"
    m := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.رمزگشایی(seq)، ماوس = پایانه.رمزگشایی موشواره(seq) }
    آزمایش.ادعای درستی(m.ماوس.موفق)
    آزمایش.ادعای برابری عدد(m.ماوس.ستون، 10)
    آزمایش.ادعای برابری عدد(m.ماوس.سطر، 5)
    آزمایش.ادعای درستی(m.ماوس.فشرده)
    آزمایش.ادعای برابری عدد(m.کلید.کد، پایانه.کلید موشواره)
پایان

تابع ریشه:
    test_kinds_are_distinct()
    test_zero_event()
    test_is_key()
    test_is_char()
    test_is_ctrl()
    test_resize_and_tick_payloads()
    test_mouse_payload()
    برگشت آزمایش.خلاصه()
پایان
