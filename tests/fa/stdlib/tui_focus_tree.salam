واردسازی آزمایش
واردسازی رشته
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا visits := وکتور {} برگردان وکتور<رشته>

ساختار Group:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی name: رشته = ""
    همگانی seen: صحیح = 0
    همگانی consume: منطقی = نادرست

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        visits.افزودن(این.name)
        این.seen++
        برگشت این.consume و event.نویسه است("x")
    پایان
پایان

ساختار Tile:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی name: رشته = ""

    همگانی تابع focusable(): منطقی:
        برگشت درست
    پایان

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        _ := event
        visits.افزودن(این.name)
        برگشت نادرست
    پایان

    همگانی تابع render(buf: رابط‌پایانه.بافر، bounds: رابط‌پایانه.مستطیل):
        buf.نوشتن متن(bounds.ایکس، bounds.ایگرگ، رشته.زیررشته نویسه(این.name، 0، 1)، رابط‌پایانه.ظاهر پیش‌فرض)
    پایان
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع trail(): رشته:
    ناپایا out := ""
    هر i، v در visits:
        اگر i بزرگتر 0:
            out += ">"
        پایان
        out += v
    پایان
    visits.پاک‌سازی()
    برگشت out
پایان

تابع tree_screen(m: رابط‌پایانه.مودال): رابط‌پایانه.صفحه:
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 20، 8)
    outer := s.افزودن(رابط‌پایانه.شناسه ریشه، Group { name = "outer" })
    inner := s.افزودن(outer، Group { name = "inner"، consume = درست })
    a := s.افزودن(inner، Tile { name = "a" })
    b := s.افزودن(inner، Tile { name = "b" })
    c := s.افزودن(outer، Tile { name = "c" })
    mid := s.افزودن(رابط‌پایانه.شناسه ریشه، m)
    m.افزودن(Tile { name = "m" })
    tm := s.افزودن(mid، Tile { name = "m" })
    s.ویجت(a).تنظیم محدوده(rect(2، 2، 4، 1))
    s.ویجت(b).تنظیم محدوده(rect(8، 2، 4، 1))
    s.ویجت(c).تنظیم محدوده(rect(2، 5، 4، 1))
    s.ویجت(tm).تنظیم محدوده(rect(14، 2، 4، 1))
    برگشت s
پایان

تابع test_nested_tree_shape():
    ناپایا s := tree_screen(رابط‌پایانه.مودال جدید())
    دیرکن s.ببند()
    آزمایش.ادعای برابری عدد(s.درخت.تعداد()، 8)
    آزمایش.ادعای برابری عدد(s.درخت.والد(3)، 2)
    آزمایش.ادعای برابری عدد(s.درخت.والد(2)، 1)
    آزمایش.ادعای برابری عدد(s.درخت.والد(1)، رابط‌پایانه.شناسه ریشه)
    آزمایش.ادعای برابری عدد(s.درخت.والد(0)، رابط‌پایانه.بدون ویجت)
پایان

تابع test_auto_focus_reaches_depth_three():
    ناپایا s := tree_screen(رابط‌پایانه.مودال جدید())
    دیرکن s.ببند()
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 3)
    آزمایش.ادعای نادرستی(s.تمرکز‌پذیر است(1))
    آزمایش.ادعای نادرستی(s.تمرکز‌پذیر است(2))
    آزمایش.ادعای نادرستی(s.تمرکز‌پذیر است(7))
پایان

تابع test_auto_focus_skips_hidden_subtree():
    ناپایا m := رابط‌پایانه.مودال جدید()
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 20، 8)
    دیرکن s.بستن()
    mid := s.افزودن(رابط‌پایانه.شناسه ریشه، m)
    tile := s.افزودن(mid، Tile { name = "t" })
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای نادرستی(s.تمرکز‌پذیر است(tile))
    m.باز کردن()
    آزمایش.ادعای درستی(s.تمرکز‌پذیر است(tile))
    آزمایش.ادعای درستی(s.تمرکز(tile))
پایان

تابع test_focus_next_crosses_container_boundaries():
    ناپایا s := tree_screen(رابط‌پایانه.مودال جدید())
    دیرکن s.ببند()
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 3)
    آزمایش.ادعای درستی(s.تمرکز بعدی())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 4)
    آزمایش.ادعای درستی(s.تمرکز بعدی())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 5)
    آزمایش.ادعای درستی(s.تمرکز بعدی())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 3)
    آزمایش.ادعای درستی(s.تمرکز قبلی())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 5)
    آزمایش.ادعای درستی(s.تمرکز قبلی())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 4)
    آزمایش.ادعای درستی(s.تمرکز قبلی())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 3)
پایان

تابع test_focus_rejects_containers():
    ناپایا s := tree_screen(رابط‌پایانه.مودال جدید())
    دیرکن s.ببند()
    آزمایش.ادعای نادرستی(s.تمرکز(1))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 3)
    آزمایش.ادعای نادرستی(s.تمرکز(2))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 3)
    آزمایش.ادعای نادرستی(s.تمرکز‌پذیر است(1))
پایان

تابع test_spatial_focus_across_depth():
    ناپایا s := tree_screen(رابط‌پایانه.مودال جدید())
    دیرکن s.ببند()
    آزمایش.ادعای درستی(s.تمرکز(3))
    آزمایش.ادعای درستی(s.تمرکز راست())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 4)
    آزمایش.ادعای نادرستی(s.تمرکز راست())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 4)
    آزمایش.ادعای درستی(s.تمرکز(3))
    آزمایش.ادعای درستی(s.تمرکز پایین())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 5)
پایان

تابع test_push_pop_across_depth():
    ناپایا s := tree_screen(رابط‌پایانه.مودال جدید())
    دیرکن s.ببند()
    آزمایش.ادعای برابری عدد(s.پشته تمرکز.طول()، 1)
    آزمایش.ادعای درستی(s.تمرکز با ذخیره قبلی(5))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 5)
    آزمایش.ادعای برابری عدد(s.پشته تمرکز.طول()، 2)
    آزمایش.ادعای درستی(s.تمرکز با ذخیره قبلی(4))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 4)
    آزمایش.ادعای برابری عدد(s.پشته تمرکز.طول()، 3)
    آزمایش.ادعای درستی(s.بازیابی تمرکز())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 5)
    آزمایش.ادعای درستی(s.بازیابی تمرکز())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 3)
    آزمایش.ادعای برابری عدد(s.پشته تمرکز.طول()، 1)
پایان

تابع test_nested_dispatch_bubbles_depth_first():
    ناپایا s := tree_screen(رابط‌پایانه.مودال جدید())
    دیرکن s.ببند()
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 3)
    visits.پاک‌سازی()
    آزمایش.ادعای درستی(s.هدایت رویداد(key("x")))
    آزمایش.ادعای برابری رشته(trail()، "a>inner")
پایان

تابع test_raised_modal_layer_stays_focused_and_ordered():
    ناپایا m := رابط‌پایانه.مودال جدید()
    m.تمرکز می‌گیرد = نادرست
    ناپایا s := tree_screen(m)
    دیرکن s.ببند()
    m.باز کردن()
    آزمایش.ادعای درستی(s.تمرکز با ذخیره قبلی(7))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 7)
    s.آوردن زیردرخت به رو(6)
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 7)
    آزمایش.ادعای نادرستی(s.تمرکز بعدی())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 7)
    s.بازگرداندن ترتیب زیردرخت(6)
    آزمایش.ادعای درستی(s.بازیابی تمرکز())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 3)
    آزمایش.ادعای درستی(s.تمرکز بعدی())
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 4)
پایان

تابع ریشه:
    test_nested_tree_shape()
    test_auto_focus_reaches_depth_three()
    test_auto_focus_skips_hidden_subtree()
    test_focus_next_crosses_container_boundaries()
    test_focus_rejects_containers()
    test_spatial_focus_across_depth()
    test_push_pop_across_depth()
    test_nested_dispatch_bubbles_depth_first()
    test_raised_modal_layer_stays_focused_and_ordered()
    visits.آزادسازی()
    برگشت آزمایش.خلاصه()
پایان
