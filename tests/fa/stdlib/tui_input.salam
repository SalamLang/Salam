تابع test_caret_home_end_bounds():
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    ناپایا b := رابط‌پایانه.بافر جدید(8، 1)
    دیرکن b.آزادسازی()
    b.در تمرکز = درست
    e.تنظیم مقدار("abc")
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[C")))
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 8)، 3)
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[H")))
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 8)، 0)
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[D")))
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 8)، 0)
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[F")))
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 8)، 3)
پایان

تابع test_caret_edit_trace():
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    ناپایا b := رابط‌پایانه.بافر جدید(16، 1)
    دیرکن b.آزادسازی()
    b.در تمرکز = درست
    e.تنظیم مقدار("salam")
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[D")))
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[D")))
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[D")))
    آزمایش.ادعای درستی(e.پردازش رویداد(key("x")))
    آزمایش.ادعای برابری رشته(e.مقدار()، "saxlam")
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 16)، 3)
    آزمایش.ادعای درستی(e.پردازش رویداد(special(پایانه.کلید حذف عقب)))
    آزمایش.ادعای برابری رشته(e.مقدار()، "salam")
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 16)، 2)
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[3~")))
    آزمایش.ادعای برابری رشته(e.مقدار()، "saam")
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 16)، 2)
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[F")))
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 16)، 4)
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[H")))
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 16)، 0)
پایان

تابع test_caret_over_glyph_and_trailing_blank():
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    ناپایا b := رابط‌پایانه.بافر جدید(8، 1)
    دیرکن b.آزادسازی()
    b.در تمرکز = درست
    e.تنظیم مقدار("abc")
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری رشته(b.دریافت(3، 0).نویسه، " ")
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[D")))
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 8)، 2)
    آزمایش.ادعای برابری رشته(b.دریافت(2، 0).نویسه، "c")
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "abc     ")
    b.در تمرکز = نادرست
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری عدد(cursor_col(b، 8)، -1)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "abc     ")
