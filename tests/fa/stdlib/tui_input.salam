تابع test_mask_frame_and_caret():
    reverse := رابط‌پایانه.ظاهر { معکوس = درست }
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    e.پوشانده = درست
    e.تنظیم مقدار("1234")
    ناپایا b := رابط‌پایانه.بافر جدید(8، 1)
    دیرکن b.آزادسازی()
    b.در تمرکز = درست
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "****    ")
    آزمایش.ادعای برابری رشته(e.مقدار()، "1234")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(4، 0).ظاهر، reverse))
    _ := e.پردازش رویداد(special(پایانه.کلید خانه))
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، "*")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، reverse))
    _ := e.پردازش رویداد(special(پایانه.کلید انتهای خط))
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(4، 0).ظاهر، reverse))
