تابع step(e &: رابط‌پایانه.کادر‌متن، b: رابط‌پایانه.بافر، seq: رشته):
    آزمایش.ادعای درستی(e.پردازش رویداد(key(seq)))
    e.ترسیم(b، rect(0، 0، 5، 1))
    c := cursor_col(b، 5)
    آزمایش.ادعای درستی(c بزرگتربرابر 0 و c کوچکتربرابر 4)
پایان

تابع test_caret_window_invariant():
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    ناپایا b := رابط‌پایانه.بافر جدید(5، 1)
    دیرکن b.آزادسازی()
    b.در تمرکز = درست
    step(e، b، "a")
    step(e، b، "b")
    step(e، b، "c")
    step(e، b، "d")
    step(e، b، "e")
    step(e، b، "f")
    step(e، b، "g")
    step(e، b، "\x1b[D")
    step(e، b، "\x1b[D")
    step(e، b، "x")
    step(e، b، "\x1b[H")
    step(e، b، "\x1b[3~")
    step(e، b، "\x1b[F")
    step(e، b، "y")
    step(e، b، "\x7f")
    step(e، b، "\x1b[D")
    step(e، b، "\x1b[D")
    step(e، b، "\x1b[D")
    step(e، b، "\x1b[D")
    step(e، b، "\x1b[D")
    step(e، b، "\x1b[C")
    step(e، b، "\x1b[3~")
    step(e، b، "z")
    step(e، b، "\x1b[F")
    آزمایش.ادعای برابری رشته(e.مقدار()، "bcdzxfg")
پایان

