    آزمایش.ادعای درستی(e.پردازش رویداد(key("a")))
    آزمایش.ادعای برابری رشته(e.مقدار()، "a")
    آزمایش.ادعای درستی(e.پردازش رویداد(key("b")))
    آزمایش.ادعای برابری رشته(e.مقدار()، "ab")
