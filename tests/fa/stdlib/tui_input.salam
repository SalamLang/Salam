تابع test_editing_unhandled_keys_bubble():
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\t")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1b")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1b[A")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1b[B")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1b[5~")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1b[6~")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1b[2~")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1bOP")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x01")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1b[1;5D")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1b[3;5~")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(key("\x1b[3;3~")))
    آزمایش.ادعای نادرستی(e.پردازش رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس }))
    آزمایش.ادعای برابری رشته(e.مقدار()، "")
