تابع test_screen_dispatch_reaches_focused_input():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 24، 3)
    دیرکن s.بستن()
    w := رابط‌پایانه.کادر متن جدید() برگردان پویا رابط‌پایانه.ویجت
    id := s.افزودن(رابط‌پایانه.شناسه ریشه، w)
    s.ویجت(id).تنظیم محدوده(rect(0، 0، 24، 1))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، id)
    آزمایش.ادعای درستی(s.هدایت رویداد(key("a")))
    ناپایا probe := رابط‌پایانه.بافر جدید(24، 1)
    دیرکن probe.آزادسازی()
    w.ترسیم(probe، rect(0، 0، 24، 1))
    آزمایش.ادعای برابری رشته(probe.دریافت(0، 0).نویسه، "a")
    آزمایش.ادعای برابری رشته(probe.دریافت(1، 0).نویسه، " ")
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(0، 0).نویسه، "a")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(s.بافر.بگیر(1، 0).ظاهر، رابط‌پایانه.ظاهر { معکوس = درست }))
پایان

تابع test_screen_unfocused_input_does_not_consume():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 24، 3)
    دیرکن s.بستن()
    w := رابط‌پایانه.کادر متن جدید() برگردان پویا رابط‌پایانه.ویجت
    inlet := s.افزودن(رابط‌پایانه.شناسه ریشه، w)
    s.ویجت(inlet).تنظیم محدوده(rect(0، 0، 24، 1))
    other := s.افزودن(رابط‌پایانه.شناسه ریشه، Sink {})
    s.ویجت(other).تنظیم محدوده(rect(0، 1، 24، 1))
    آزمایش.ادعای درستی(s.تمرکز(other))
    آزمایش.ادعای نادرستی(s.هدایت رویداد(key("a")))
    ناپایا probe := رابط‌پایانه.بافر جدید(24، 1)
    دیرکن probe.آزادسازی()
    w.ترسیم(probe، rect(0، 0، 24، 1))
    آزمایش.ادعای برابری رشته(probe.متن ردیف(0)، "                        ")
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(0، 0).نویسه، " ")
    cursor := رابط‌پایانه.ظاهر { معکوس = درست }
    ناپایا reversed := نادرست
    تکرار 24 در x:
        اگر رابط‌پایانه.برابری ظاهر(s.بافر.بگیر(x، 0).ظاهر، cursor):
            reversed = درست
        پایان
    پایان
    آزمایش.ادعای نادرستی(reversed)
پایان

تابع test_unicode_codepoint_editing():
