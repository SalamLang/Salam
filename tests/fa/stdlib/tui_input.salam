    آزمایش.ادعای برابری عدد(cursor_col(b، 4)، 2)
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[D")))
    آزمایش.ادعای درستی(e.پردازش رویداد(key("\x1b[D")))
    e.ترسیم(b، rect(0، 0، 4، 1))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "fgh ")
