تابع rec_true(v: رشته): منطقی:
    submit_calls++
    submit_arg = v
    برگشت درست
پایان

تابع rec_false(v: رشته): منطقی:
    submit_calls++
    submit_arg = v
    برگشت نادرست
پایان

تابع clear_shared(): منطقی:
    submit_calls++
    shared.تنظیم مقدار("")
    برگشت نادرست
پایان

تابع test_submit_true():
    submit_calls = 0
    ناپایا e := رابط‌پایانه.کادر متن جدید()
