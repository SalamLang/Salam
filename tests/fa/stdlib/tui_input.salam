تابع test_editing_backspace_sequence():
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    e.تنظیم مقدار("ab")
    آزمایش.ادعای درستی(e.پردازش رویداد(special(پایانه.کلید حذف عقب)))
    آزمایش.ادعای برابری رشته(e.مقدار()، "a")
    آزمایش.ادعای درستی(e.پردازش رویداد(special(پایانه.کلید حذف عقب)))
    آزمایش.ادعای برابری رشته(e.مقدار()، "")
    آزمایش.ادعای درستی(e.پردازش رویداد(special(پایانه.کلید حذف عقب)))
    آزمایش.ادعای برابری رشته(e.مقدار()، "")
