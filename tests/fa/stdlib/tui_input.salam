تابع test_masked_caret_counts_one_cell_per_glyph():
    ناپایا wide := رابط‌پایانه.کادر متن جدید()
    wide.پوشانده = درست
    wide.تنظیم مقدار("\u4e2d\u6587")
    ناپایا b := رابط‌پایانه.بافر جدید(8، 1)
    b.در تمرکز = درست
    wide.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "**      ")
    آزمایش.ادعای برابری رشته(cursor_cols(b، 8)، "2")
    b.آزادسازی()

    ناپایا zwnj := رابط‌پایانه.کادر متن جدید()
    zwnj.پوشانده = درست
    zwnj.تنظیم مقدار("ab\u200Ccd")
    ناپایا b2 := رابط‌پایانه.بافر جدید(8، 1)
    b2.در تمرکز = درست
    zwnj.ترسیم(b2، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری رشته(b2.متن ردیف(0)، "*****   ")
    آزمایش.ادعای برابری رشته(cursor_cols(b2، 8)، "5")
    b2.آزادسازی()

    ناپایا long := رابط‌پایانه.کادر متن جدید()
    long.پوشانده = درست
    long.تنظیم مقدار("\u4e2d\u6587\u4e2d\u6587\u4e2d")
    ناپایا b3 := رابط‌پایانه.بافر جدید(4، 1)
    b3.در تمرکز = درست
    long.ترسیم(b3، rect(0، 0، 4، 1))
    آزمایش.ادعای برابری رشته(b3.متن ردیف(0)، "*** ")
    آزمایش.ادعای برابری رشته(cursor_cols(b3، 4)، "3")
    b3.آزادسازی()
