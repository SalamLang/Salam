تابع test_render_value_unfocused():
    ناپایا b := رابط‌پایانه.بافر جدید(16، 1)
    دیرکن b.آزادسازی()
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    e.تنظیم مقدار("hello")
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، "h")
    آزمایش.ادعای برابری رشته(b.دریافت(4، 0).نویسه، "o")
    آزمایش.ادعای برابری رشته(b.دریافت(5، 0).نویسه، " ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "hello           ")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(15، 0).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
    cursor := رابط‌پایانه.ظاهر { معکوس = درست }
    ناپایا reversed := نادرست
    تکرار 16 در x:
        اگر رابط‌پایانه.برابری ظاهر(b.دریافت(x، 0).ظاهر، cursor):
            reversed = درست
        پایان
    پایان
    آزمایش.ادعای نادرستی(reversed)
پایان

تابع test_render_cursor_default():
    reverse := رابط‌پایانه.ظاهر { معکوس = درست }
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    e.تنظیم مقدار("hello")
    ناپایا b := رابط‌پایانه.بافر جدید(16، 1)
    دیرکن b.آزادسازی()
    b.در تمرکز = درست
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری رشته(b.دریافت(5، 0).نویسه، " ")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(5، 0).ظاهر، reverse))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "hello           ")

    ناپایا empty := رابط‌پایانه.کادر متن جدید()
    ناپایا b2 := رابط‌پایانه.بافر جدید(16، 1)
    دیرکن b2.آزادسازی()
    b2.در تمرکز = درست
    empty.ترسیم(b2، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری رشته(b2.دریافت(0، 0).نویسه، " ")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b2.دریافت(0، 0).ظاهر، reverse))
پایان

تابع test_render_placeholder_default():
    gray := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.مشکی روشن }
    reverse := رابط‌پایانه.ظاهر { معکوس = درست }
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    e.تنظیم متن راهنما("Name")
    آزمایش.ادعای برابری رشته(e.مقدار()، "")

    ناپایا b := رابط‌پایانه.بافر جدید(16، 1)
    دیرکن b.آزادسازی()
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "Name            ")
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، "N")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، gray))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(3، 0).ظاهر، gray))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(4، 0).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))

    ناپایا b2 := رابط‌پایانه.بافر جدید(16، 1)
    دیرکن b2.آزادسازی()
    b2.در تمرکز = درست
    e.ترسیم(b2، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری رشته(b2.دریافت(0، 0).نویسه، "N")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b2.دریافت(0، 0).ظاهر، reverse))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b2.دریافت(1، 0).ظاهر، gray))
    آزمایش.ادعای برابری رشته(e.مقدار()، "")
پایان

تابع test_render_default_fallbacks_from_fields():
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    e.تنظیم متن راهنما("Name")
    ناپایا b := رابط‌پایانه.بافر جدید(8، 1)
    دیرکن b.آزادسازی()
    b.در تمرکز = درست
    before := رابط‌پایانه.شمار ساخت اس‌جی‌آر()
    e.ترسیم(b، rect(0، 0، 8، 1))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، "N")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، رابط‌پایانه.ظاهر { معکوس = درست }))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(1، 0).ظاهر، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.مشکی روشن }))

    bold := رابط‌پایانه.ظاهر { پررنگ = درست }
    italic := رابط‌پایانه.ظاهر { کج = درست }
    ناپایا c := رابط‌پایانه.کادر متن جدید()
    c.تنظیم متن راهنما("Name")
    c.ظاهر مکان‌نما = italic
    c.ظاهر متن راهنما = bold
    ناپایا b3 := رابط‌پایانه.بافر جدید(8، 1)
    دیرکن b3.آزادسازی()
    b3.در تمرکز = درست
    c.ترسیم(b3، rect(0، 0، 8، 1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b3.دریافت(0، 0).ظاهر، italic))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b3.دریافت(1، 0).ظاهر، bold))
    c.ظاهر مکان‌نما = رابط‌پایانه.ظاهر پیش‌فرض
    c.ترسیم(b3، rect(0، 0، 8، 1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b3.دریافت(0، 0).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
پایان

تابع test_render_themed_styles():
    base := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.مشکی، رنگ پس‌زمینه = رابط‌پایانه.سفید }
    gray := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.مشکی روشن، رنگ پس‌زمینه = رابط‌پایانه.سفید }
    reverse := رابط‌پایانه.ظاهر { معکوس = درست }
    ناپایا b := رابط‌پایانه.بافر جدید(16، 1)
    دیرکن b.آزادسازی()
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    e.ظاهر = base
    e.تنظیم مقدار("hi")
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، base))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(15، 0).ظاهر، base))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(b.دریافت(2، 0).ظاهر، reverse))
    b.در تمرکز = درست
    e.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، base))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(2، 0).ظاهر، رابط‌پایانه.ادغام ظاهر(base، reverse)))

    ناپایا p := رابط‌پایانه.کادر متن جدید()
    p.ظاهر = base
    p.تنظیم متن راهنما("Name")
    p.ترسیم(b، rect(0، 0، 16، 1))
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، "N")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، رابط‌پایانه.ادغام ظاهر(base، reverse)))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(1، 0).ظاهر، رابط‌پایانه.ادغام ظاهر(base، gray)))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(4، 0).ظاهر، base))
پایان

