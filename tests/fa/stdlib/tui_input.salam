تابع cursor_col(b: رابط‌پایانه.بافر، w: صحیح): صحیح:
    reverse := رابط‌پایانه.ظاهر { معکوس = درست }
    ناپایا found := -1
    تکرار w در x:
        اگر رابط‌پایانه.برابری ظاهر(b.دریافت(x، 0).ظاهر، reverse):
            found = x
        پایان
    پایان
    برگشت found
پایان

