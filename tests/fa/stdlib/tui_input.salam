واردسازی آزمایش
واردسازی رشته
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا filter_calls := 0

ناپایا submit_calls := 0
ناپایا submit_arg := "unset"
ناپایا shared := رابط‌پایانه.کادر متن جدید()

ساختار Sink:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع focusable(): منطقی:
        برگشت درست
    پایان
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع special(code: صحیح): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = code } }
پایان

تابع test_defaults():
    ناپایا e := رابط‌پایانه.کادر متن جدید()
    آزمایش.ادعای درستی(e.تمرکز‌پذیر است())
    آزمایش.ادعای برابری رشته(e.مقدار()، "")
    آزمایش.ادعای برابری رشته(e.متن راهنما، "")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(e.ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(e.ظاهر مکان‌نما، رابط‌پایانه.ظاهر { معکوس = درست }))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(e.ظاهر متن راهنما، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.مشکی روشن }))
پایان

تابع test_editing_append_printable():
