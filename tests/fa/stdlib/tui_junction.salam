واردسازی آزمایش
واردسازی رابط‌پایانه

ساختار Ring:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی x: صحیح = 0
    همگانی y: صحیح = 0
    همگانی w: صحیح = 0
    همگانی h: صحیح = 0
    همگانی glyphs: رابط‌پایانه.نویسه‌های‌کادر = رابط‌پایانه.نویسه‌های‌کادر {}
    همگانی تابع render(buf: رابط‌پایانه.بافر، _bounds: رابط‌پایانه.مستطیل):
        رابط‌پایانه.ترسیم کادر با نویسه‌ها(buf، rect(این.x، این.y، این.w، این.h)، این.glyphs، رابط‌پایانه.ظاهر {}، "")
    پایان
پایان

ساختار Rules:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی x: صحیح = 0
    همگانی vertical: رشته = "│"

    همگانی تابع render(buf: رابط‌پایانه.بافر، bounds: رابط‌پایانه.مستطیل):
        ناپایا vertical := این.vertical
        اگر buf.نویسه‌ها برابر رابط‌پایانه.سیاست‌نویسه‌ها.ASCII:
            vertical = "|"
        پایان
        buf.تنظیم(bounds.ایکس، bounds.ایگرگ، رابط‌پایانه.سلول { نویسه = vertical })
        buf.تنظیم(bounds.ایکس، bounds.ایگرگ + 8، رابط‌پایانه.سلول { نویسه = vertical })
        buf.تنظیم(bounds.ایکس، bounds.ایگرگ + 3، رابط‌پایانه.سلول { نویسه = vertical })
        buf.تنظیم(bounds.ایکس، bounds.ایگرگ + 5، رابط‌پایانه.سلول { نویسه = vertical })
    پایان
پایان

ساختار CrossRule:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی horizontal: رشته = "─"

    همگانی تابع render(buf: رابط‌پایانه.بافر، _bounds: رابط‌پایانه.مستطیل):
        ناپایا horizontal := این.horizontal
        اگر buf.نویسه‌ها برابر رابط‌پایانه.سیاست‌نویسه‌ها.ASCII:
            horizontal = "-"
        پایان
        تکرار 7 در i:
            buf.تنظیم(2 + i، 4، رابط‌پایانه.سلول { نویسه = horizontal })
        پایان
    پایان
پایان

ساختار InnerRule:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع render(buf: رابط‌پایانه.بافر، bounds: رابط‌پایانه.مستطیل):
        تکرار bounds.ارتفاع در i:
            buf.تنظیم(bounds.ایکس، bounds.ایگرگ + i، رابط‌پایانه.سلول { نویسه = "│" })
        پایان
    پایان
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع frame(s: رابط‌پایانه.صفحه): رشته:
    ناپایا out := ""
    تکرار s.بافر.ارتفاع در y:
        اگر y بزرگتر 0: out += "|" پایان
        out += s.بافر.متن ردیف(y)
    پایان
    برگشت out
پایان

تابع scene(ring_glyphs: رابط‌پایانه.نویسه‌های‌کادر، vertical: رشته، horizontal: رشته): رابط‌پایانه.صفحه:
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 12، 9)
    rules := s.افزودن(رابط‌پایانه.شناسه ریشه، Rules { vertical = vertical } برگردان پویا رابط‌پایانه.ویجت)
    s.ویجت(rules).تنظیم محدوده(rect(5، 0، 1، 9))
    cross := s.افزودن(رابط‌پایانه.شناسه ریشه، CrossRule { horizontal = horizontal } برگردان پویا رابط‌پایانه.ویجت)
    s.ویجت(cross).تنظیم محدوده(rect(0، 0، 12، 9))
    id := s.افزودن(رابط‌پایانه.شناسه ریشه، Ring { x = 1، y = 1، w = 9، h = 7، glyphs = ring_glyphs } برگردان پویا رابط‌پایانه.ویجت)
    s.ویجت(id).تنظیم محدوده(rect(0، 0، 12، 9))
    برگشت s
پایان

تابع test_weight(glyphs: رابط‌پایانه.نویسه‌های‌کادر، vertical: رشته، horizontal: رشته، top: رشته، bottom: رشته، cross: رشته):
    ناپایا s := scene(glyphs، vertical، horizontal)
    دیرکن s.ببند()
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(5، 1).نویسه، top)
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(5، 7).نویسه، bottom)
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(5، 4).نویسه، cross)
    before := frame(s)
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(frame(s)، before)
    s.نیازمند بازترسیم = درست
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(frame(s)، before)
پایان

تابع test_partial_repaint():
    ناپایا s := scene(رابط‌پایانه.نویسه‌های تک خط()، "│"، "─")
    دیرکن s.ببند()
    rules := 1
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(5، 1).نویسه، "┴")
    s.علامت‌گذاری برای بازترسیم(rules)
    s.ویجت(rules).تنظیم محدوده(rect(2، 0، 1، 9))
    s.علامت‌گذاری برای بازترسیم(rules)
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(5، 1).نویسه، "─")
پایان

تابع test_partial_repaint_inner_rule():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 12، 9)
    دیرکن s.بستن()
    rules := s.افزودن(رابط‌پایانه.شناسه ریشه، InnerRule {} برگردان پویا رابط‌پایانه.ویجت)
    s.ویجت(rules).تنظیم محدوده(rect(5، 2، 1، 5))
    ring := s.افزودن(رابط‌پایانه.شناسه ریشه، Ring { x = 1، y = 1، w = 9، h = 7، glyphs = رابط‌پایانه.نویسه‌های تک خط() } برگردان پویا رابط‌پایانه.ویجت)
    s.ویجت(ring).تنظیم محدوده(rect(0، 0، 12، 9))
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(5، 1).نویسه، "┬")

    s.علامت‌گذاری برای بازترسیم(rules)
    s.ویجت(rules).تنظیم محدوده(rect(2، 2، 1، 5))
    s.علامت‌گذاری برای بازترسیم(rules)
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(5، 1).نویسه، "─")
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(2، 1).نویسه، "┬")
پایان

تابع test_heavy_rule_light_ring():
    ناپایا s := scene(رابط‌پایانه.نویسه‌های تک خط()، "┃"، "━")
    دیرکن s.ببند()
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(5، 1).نویسه، "┸")
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(5، 0).نویسه، "┃")
پایان

تابع test_mixed_families():
    test_weight(رابط‌پایانه.نویسه‌های ترکیبی()، "│"، "━"، "┷"، "┯"، "┿")
    test_weight(رابط‌پایانه.نویسه‌های تک خط()، "┃"، "─"، "┸"، "┰"، "╂")
    test_weight(رابط‌پایانه.نویسه‌های دو خط()، "│"، "═"، "╧"، "╤"، "╪")
    test_weight(رابط‌پایانه.نویسه‌های تک خط()، "║"، "─"، "╨"، "╥"، "╫")
پایان

تابع test_no_mixed_glyph():
    ناپایا heavy_double := scene(رابط‌پایانه.نویسه‌های دو خط()، "┃"، "━")
    دیرکن heavy_double.ببند()
    heavy_double.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(heavy_double.بافر.بگیر(5، 1).نویسه، "═")
    آزمایش.ادعای برابری رشته(heavy_double.بافر.بگیر(5، 0).نویسه، "┃")

    ناپایا double_heavy := scene(رابط‌پایانه.نویسه‌های سنگین()، "║"، "═")
    دیرکن double_heavy.ببند()
    double_heavy.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(double_heavy.بافر.بگیر(5، 1).نویسه، "━")
    آزمایش.ادعای برابری رشته(double_heavy.بافر.بگیر(5، 0).نویسه، "║")
پایان

تابع test_standalone_and_ascii():
    ناپایا standalone := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 12، 9)
    دیرکن standalone.بستن()
    id := standalone.افزودن(رابط‌پایانه.شناسه ریشه، Ring { x = 1، y = 1، w = 9، h = 7، glyphs = رابط‌پایانه.نویسه‌های تک خط() } برگردان پویا رابط‌پایانه.ویجت)
    standalone.ویجت(id).تنظیم محدوده(rect(0، 0، 12، 9))
    standalone.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(frame(standalone)، "            | ┌───────┐  | │       │  | │       │  | │       │  | │       │  | │       │  | └───────┘  |            ")

    ناپایا ascii := scene(رابط‌پایانه.نویسه‌های تک خط()، "│"، "─")
    دیرکن ascii.ببند()
    ascii.تنظیم نویسه‌ها(رابط‌پایانه.سیاست‌نویسه‌ها.ASCII)
    ascii.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(frame(ascii)، "     |      | +-------+  | |       |  | |   |   |  | |-------|  | |   |   |  | |       |  | +-------+  |     |      ")
پایان

تابع ریشه():
    test_weight(رابط‌پایانه.نویسه‌های تک خط()، "│"، "─"، "┴"، "┬"، "┼")
    test_weight(رابط‌پایانه.نویسه‌های سنگین()، "┃"، "━"، "┻"، "┳"، "╋")
    test_weight(رابط‌پایانه.نویسه‌های دو خط()، "║"، "═"، "╩"، "╦"، "╬")
    test_partial_repaint()
    test_partial_repaint_inner_rule()
    test_heavy_rule_light_ring()
    test_mixed_families()
    test_no_mixed_glyph()
    test_standalone_and_ascii()
    برگشت آزمایش.خلاصه()
پایان
