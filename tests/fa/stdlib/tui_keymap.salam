تابع test_sequence_timeout_ignores_non_key_events():
    ناپایا r := Rig {}
    دیرکن r.release()
    r.open(20، 5)
    r.Add(رابط‌پایانه.شناسه ریشه، درست)
    ناپایا km := رابط‌پایانه.نگاشت کلید جدید()
    دیرکن km.آزادسازی()
    km.مهلت توالی به میلی‌ثانیه = 50
    km.پیوند توالی("gg"، count_action())
    seq_hits = 0

    آزمایش.ادعای نادرستی(km.پردازش کلید(r.ptr()، key("g")))
    km.آغاز انتظار توالی به میلی‌ثانیه = (همگام سازی.اکنون میلی ثانیه() - 5000) برگردان صحیح
    آزمایش.ادعای نادرستی(km.پردازش کلید(r.ptr()، رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تیک }))
    آزمایش.ادعای نادرستی(km.پردازش کلید(r.ptr()، رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تغییر اندازه، عرض = 21، ارتفاع = 6 }))
    آزمایش.ادعای نادرستی(km.پردازش کلید(r.ptr()، رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس }))
    km.آغاز انتظار توالی به میلی‌ثانیه = همگام سازی.اکنون میلی ثانیه() برگردان صحیح
    آزمایش.ادعای درستی(km.پردازش کلید(r.ptr()، key("g")))
    آزمایش.ادعای برابری عدد(seq_hits، 1)
