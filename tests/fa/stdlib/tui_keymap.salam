تابع test_widget_consumed_key_clears_pending_sequence():
    ناپایا s := رابط‌پایانه.صفحه جدید(Root {}، 20، 5)
    دیرکن s.بستن()
    _ := s.افزودن(رابط‌پایانه.شناسه ریشه، Activate {})
    s.نگاشت کلید.پیوند توالی("gg"، count_action())
    seq_hits = 0
    activate_hits = 0
    آزمایش.ادعای نادرستی(s.هدایت رویداد(key("g")))
    آزمایش.ادعای درستی(s.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = پایانه.کلید ورود } }))
    آزمایش.ادعای برابری عدد(activate_hits، 1)
    آزمایش.ادعای نادرستی(s.هدایت رویداد(key("g")))
    آزمایش.ادعای برابری عدد(seq_hits، 0)
    آزمایش.ادعای درستی(s.هدایت رویداد(key("g")))
    آزمایش.ادعای برابری عدد(seq_hits، 1)
