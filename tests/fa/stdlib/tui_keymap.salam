تابع test_default_keymap_fresh_per_call():
    ناپایا r := Rig {}
    دیرکن r.release()
    r.open(20، 5)
    w1 := r.Add(رابط‌پایانه.شناسه ریشه، درست)
    w2 := r.Add(رابط‌پایانه.شناسه ریشه، درست)
    w3 := r.Add(رابط‌پایانه.شناسه ریشه، درست)
    ناپایا a := رابط‌پایانه.نگاشت کلید پیش‌فرض()
    دیرکن a.آزادسازی()
    ناپایا b := رابط‌پایانه.نگاشت کلید پیش‌فرض()
    دیرکن b.آزادسازی()
    a.پیوند کلید(پایانه.رمزگشایی("\t")، action_focus(w3))

    آزمایش.ادعای برابری عدد(r.focused()، w1)
    آزمایش.ادعای درستی(b.پردازش کلید(r.ptr()، key("\t")))
    آزمایش.ادعای برابری عدد(r.focused()، w2)
    آزمایش.ادعای درستی(r.focus(w1))
    آزمایش.ادعای درستی(a.پردازش کلید(r.ptr()، key("\t")))
    آزمایش.ادعای برابری عدد(r.focused()، w3)
