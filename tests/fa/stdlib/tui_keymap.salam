واردسازی همگام سازی
واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا seq_hits := 0

ناپایا activate_hits := 0

ساختار Root:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
پایان

ساختار Field:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی focus: منطقی = درست

    همگانی تابع focusable(): منطقی:
        برگشت این.focus
    پایان
پایان

ساختار Grab:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        برگشت event.نویسه است("r")
    پایان
پایان

ساختار TabGrab:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        برگشت event.کلید است(پایانه.کلید تب)
    پایان
پایان

ساختار Activate:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع focusable(): منطقی:
        برگشت درست
    پایان

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        اگر event.کلید است(پایانه.کلید ورود) یا event.کلید است(پایانه.کلید فاصله):
            activate_hits++
            برگشت درست
        پایان
        برگشت نادرست
    پایان
پایان

ساختار Rig:
    همگانی screens: وکتور<رابط‌پایانه.صفحه> = وکتور {}

    همگانی تابع open(w: صحیح، h: صحیح):
        این.screens.افزودن(رابط‌پایانه.صفحه جدید(Root {}، w، h))
    پایان

    همگانی تابع ptr(): رابط‌پایانه.صفحه*:
        برگشت این.screens.ارجاع(0)
    پایان

    همگانی تابع add(parent: صحیح، focus: منطقی): صحیح:
        برگشت این.ptr()[0].افزودن(parent، Field { focus = focus })
    پایان

    همگانی تابع focus(id: صحیح): منطقی:
        برگشت این.ptr()[0].تمرکز(id)
    پایان

    همگانی تابع focused(): صحیح:
        برگشت این.ptr()[0].شناسه متمرکز()
    پایان

    همگانی تابع release():
        این.ptr()[0].ببند()
        این.screens.آزادسازی()
    پایان
پایان

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع action_focus(id: صحیح): تابع (رابط‌پایانه.صفحه*، رابط‌پایانه.رویداد) منطقی:
    برگشت (screen: رابط‌پایانه.صفحه*، _event: رابط‌پایانه.رویداد): برگشت screen[0].تمرکز(id) پایان
پایان

تابع focus_next_decline(screen: رابط‌پایانه.صفحه*): منطقی:
    _ := screen[0].تمرکز بعدی()
    برگشت نادرست
پایان

تابع act_next_decline(): تابع (رابط‌پایانه.صفحه*، رابط‌پایانه.رویداد) منطقی:
    برگشت (screen: رابط‌پایانه.صفحه*، _event: رابط‌پایانه.رویداد): برگشت focus_next_decline(screen) پایان
پایان

تابع act_next_consume(): تابع (رابط‌پایانه.صفحه*، رابط‌پایانه.رویداد) منطقی:
    برگشت (screen: رابط‌پایانه.صفحه*، _event: رابط‌پایانه.رویداد): برگشت screen[0].تمرکز بعدی() پایان
پایان

تابع bump_seq(_screen: رابط‌پایانه.صفحه*، _event: رابط‌پایانه.رویداد): منطقی:
    seq_hits++
    برگشت درست
پایان

تابع count_action(): تابع (رابط‌پایانه.صفحه*، رابط‌پایانه.رویداد) منطقی:
    برگشت (screen: رابط‌پایانه.صفحه*، event: رابط‌پایانه.رویداد): برگشت bump_seq(screen، event) پایان
پایان

تابع vim_search_count(): تابع (رابط‌پایانه.صفحه*، رابط‌پایانه.رویداد) منطقی:
    برگشت (screen: رابط‌پایانه.صفحه*، event: رابط‌پایانه.رویداد): برگشت bump_seq(screen، event) پایان
پایان

تابع vim_search_decline(): تابع (رابط‌پایانه.صفحه*، رابط‌پایانه.رویداد) منطقی:
    برگشت (_screen: رابط‌پایانه.صفحه*، _event: رابط‌پایانه.رویداد): برگشت نادرست پایان
پایان

تابع new_focus_map(id: صحیح): رابط‌پایانه.نگاشت‌کلید:
    ناپایا km := رابط‌پایانه.نگاشت کلید جدید()
    km.پیوند کلید(پایانه.رمزگشایی("b")، action_focus(id))
    برگشت km
پایان

تابع swap_consume(screen: رابط‌پایانه.صفحه*، id: صحیح): منطقی:
    screen[0].تنظیم نگاشت کلید(new_focus_map(id))
    برگشت درست
پایان

تابع swap_decline(screen: رابط‌پایانه.صفحه*، id: صحیح): منطقی:
    screen[0].تنظیم نگاشت کلید(new_focus_map(id))
    برگشت نادرست
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع grid(): رابط‌پایانه.صفحه:
    ناپایا s := رابط‌پایانه.صفحه جدید(Root {}، 8، 3)
    a := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    b := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    c := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    d := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    s.ویجت(a).تنظیم محدوده(rect(0، 0، 4، 1))
    s.ویجت(b).تنظیم محدوده(rect(4، 0، 4، 1))
    s.ویجت(c).تنظیم محدوده(rect(0، 1، 4، 1))
    s.ویجت(d).تنظیم محدوده(rect(4، 1، 4، 1))
    برگشت s
پایان

تابع test_single_hit_and_miss():
    ناپایا r := Rig {}
    دیرکن r.release()
    r.open(20، 5)
    w1 := r.Add(رابط‌پایانه.شناسه ریشه، درست)
    w2 := r.Add(رابط‌پایانه.شناسه ریشه، درست)
    ناپایا km := رابط‌پایانه.نگاشت کلید جدید()
    دیرکن km.آزادسازی()
    km.پیوند کلید(پایانه.رمزگشایی("a")، action_focus(w2))

    آزمایش.ادعای برابری عدد(r.focused()، w1)
    آزمایش.ادعای درستی(km.پردازش کلید(r.ptr()، key("a")))
    آزمایش.ادعای برابری عدد(r.focused()، w2)
    آزمایش.ادعای نادرستی(km.پردازش کلید(r.ptr()، key("b")))
    آزمایش.ادعای برابری عدد(r.focused()، w2)
پایان

تابع test_rebind_last_write_wins():
    ناپایا r := Rig {}
    دیرکن r.release()
    r.open(20، 5)
    r.Add(رابط‌پایانه.شناسه ریشه، درست)
    w2 := r.Add(رابط‌پایانه.شناسه ریشه، درست)
    w3 := r.Add(رابط‌پایانه.شناسه ریشه، درست)
    ناپایا km := رابط‌پایانه.نگاشت کلید جدید()
    دیرکن km.آزادسازی()
    km.پیوند کلید(پایانه.رمزگشایی("a")، action_focus(w2))
    km.پیوند کلید(پایانه.رمزگشایی("a")، action_focus(w3))

    آزمایش.ادعای درستی(km.پردازش کلید(r.ptr()، key("a")))
    آزمایش.ادعای برابری عدد(r.focused()، w3)
پایان

تابع test_unbind():
    ناپایا r := Rig {}
    دیرکن r.release()
    r.open(20، 5)
    w1 := r.Add(رابط‌پایانه.شناسه ریشه، درست)
    w2 := r.Add(رابط‌پایانه.شناسه ریشه، درست)
    ناپایا km := رابط‌پایانه.نگاشت کلید جدید()
    دیرکن km.آزادسازی()
    km.پیوند کلید(پایانه.رمزگشایی("a")، action_focus(w2))
    km.لغو پیوند کلید(پایانه.رمزگشایی("a"))

    آزمایش.ادعای نادرستی(km.پردازش کلید(r.ptr()، key("a")))
    آزمایش.ادعای برابری عدد(r.focused()، w1)
پایان

تابع test_unbind_for_drops_only_the_target_override():
    ناپایا s := رابط‌پایانه.صفحه جدید(Root {}، 20، 5)
    دیرکن s.بستن()
    w1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    w2 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t_global := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t_w1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t_w2 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    ناپایا km := رابط‌پایانه.نگاشت کلید جدید()
    km.پیوند کلید(پایانه.رمزگشایی("x")، action_focus(t_global))
    km.پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("x")، action_focus(t_w1))
    km.پیوند کلید برای ویجت(w2، پایانه.رمزگشایی("x")، action_focus(t_w2))
    s.تنظیم نگاشت کلید(km)

    آزمایش.ادعای درستی(s.تمرکز(w1))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("x")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t_w1)
    s.نگاشت کلید.لغو پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("x"))
    آزمایش.ادعای درستی(s.تمرکز(w1))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("x")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t_global)
    آزمایش.ادعای درستی(s.تمرکز(w2))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("x")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t_w2)
پایان

تابع test_unbind_for_keeps_sibling_overrides():
    ناپایا s := رابط‌پایانه.صفحه جدید(Root {}، 20، 5)
    دیرکن s.بستن()
    w1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    w2 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t_w1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t_w2 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    ناپایا km := رابط‌پایانه.نگاشت کلید جدید()
    km.پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("y")، action_focus(t_w1))
    km.پیوند کلید برای ویجت(w2، پایانه.رمزگشایی("y")، action_focus(t_w2))
    s.تنظیم نگاشت کلید(km)

    s.نگاشت کلید.لغو پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("y"))
    آزمایش.ادعای درستی(s.تمرکز(w2))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("y")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t_w2)
پایان

تابع test_unbind_for_missing_key_or_widget_is_inert():
    ناپایا s := رابط‌پایانه.صفحه جدید(Root {}، 20، 5)
    دیرکن s.بستن()
    w1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    s.نگاشت کلید.لغو پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("z"))
    آزمایش.ادعای نادرستی(s.هدایت رویداد(key("z")))

    s.نگاشت کلید.پیوند کلید(پایانه.رمزگشایی("x")، action_focus(t1))
    s.نگاشت کلید.لغو پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("z"))
    s.نگاشت کلید.لغو پیوند کلید برای ویجت(99، پایانه.رمزگشایی("x"))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، w1)
    آزمایش.ادعای درستی(s.هدایت رویداد(key("x")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t1)
پایان

تابع test_unbind_for_clears_pending_sequence():
    ناپایا s := رابط‌پایانه.صفحه جدید(Root {}، 20، 5)
    دیرکن s.بستن()
    w1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    s.نگاشت کلید.پیوند توالی("gg"، count_action())
    seq_hits = 0

    آزمایش.ادعای نادرستی(s.هدایت رویداد(key("g")))
    آزمایش.ادعای برابری عدد(seq_hits، 0)
    s.نگاشت کلید.لغو پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("h"))
    آزمایش.ادعای نادرستی(s.هدایت رویداد(key("g")))
    آزمایش.ادعای برابری عدد(seq_hits، 0)
پایان

تابع test_unbind_for_then_rebind():
    ناپایا s := رابط‌پایانه.صفحه جدید(Root {}، 20، 5)
    دیرکن s.بستن()
    w1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t2 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    ناپایا km := رابط‌پایانه.نگاشت کلید جدید()
    km.پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("x")، action_focus(t1))
    s.تنظیم نگاشت کلید(km)

    s.نگاشت کلید.لغو پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("x"))
    s.نگاشت کلید.پیوند کلید برای ویجت(w1، پایانه.رمزگشایی("x")، action_focus(t2))
    آزمایش.ادعای درستی(s.تمرکز(w1))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("x")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t2)
پایان

