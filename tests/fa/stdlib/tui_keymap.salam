    آزمایش.ادعای نادرستی(s.هدایت رویداد(key("j")))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("j")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t_global)
    آزمایش.ادعای درستی(s.تمرکز(w2))
    آزمایش.ادعای نادرستی(s.هدایت رویداد(key("j")))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("j")))
