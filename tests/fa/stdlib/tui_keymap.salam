تابع test_unbind_for_seq_clears_pending_sequence():
    ناپایا s := رابط‌پایانه.صفحه جدید(Root {}، 20، 5)
    دیرکن s.بستن()
    w1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    s.نگاشت کلید.پیوند توالی("gg"، count_action())
