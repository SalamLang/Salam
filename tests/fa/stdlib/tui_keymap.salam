تابع test_scoped_binding_through_dispatch():
    ناپایا s := رابط‌پایانه.صفحه جدید(Root {}، 40، 10)
    دیرکن s.بستن()
    outer := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    inner := s.افزودن(outer، Field {})
    other := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t_inner := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t_outer := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    t_global := s.افزودن(رابط‌پایانه.شناسه ریشه، Field {})
    ناپایا km := رابط‌پایانه.نگاشت کلید جدید()
    km.پیوند کلید(پایانه.رمزگشایی("a")، action_focus(t_global))
    km.پیوند کلید برای ویجت(outer، پایانه.رمزگشایی("a")، action_focus(t_outer))
    km.پیوند کلید برای ویجت(inner، پایانه.رمزگشایی("a")، action_focus(t_inner))
    s.تنظیم نگاشت کلید(km)

    آزمایش.ادعای درستی(s.تمرکز(inner))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("a")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t_inner)
    آزمایش.ادعای درستی(s.تمرکز(outer))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("a")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t_outer)
    آزمایش.ادعای درستی(s.تمرکز(other))
    آزمایش.ادعای درستی(s.هدایت رویداد(key("a")))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، t_global)
پایان

