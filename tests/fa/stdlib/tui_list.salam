تابع test_unicode_codepoint_clip():
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.افزودن("éééx")
    v.افزودن("asdf")
    l := رابط‌پایانه.فهرست جدید(v)
    آزمایش.ادعای درستی(l.تمرکز‌پذیر است())
    ناپایا b3 := frame(l، 3، 1، درست)
    دیرکن b3.آزادکن()
    آزمایش.ادعای برابری رشته(b3.متن ردیف(0)، "ééé")
    آزمایش.ادعای برابری رشته(b3.بگیر(0، 0).نویسه، "é")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b3.بگیر(0، 0).ظاهر، رابط‌پایانه.ظاهر { معکوس = درست }))
    ناپایا b2 := frame(l، 2، 1، درست)
    دیرکن b2.آزادکن()
    آزمایش.ادعای برابری رشته(b2.متن ردیف(0)، "éé")
پایان

تابع test_unicode_cell_clip():
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.افزودن("中文字")
    l := رابط‌پایانه.فهرست جدید(v)
    ناپایا b := frame(l، 4، 1، درست)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "中文")
    آزمایش.ادعای برابری رشته(b.بگیر(0، 0).نویسه، "中")
    آزمایش.ادعای برابری رشته(b.بگیر(1، 0).نویسه، "")
    آزمایش.ادعای برابری رشته(b.بگیر(2، 0).نویسه، "文")
    آزمایش.ادعای برابری رشته(b.بگیر(3، 0).نویسه، "")
