تابع test_seq_s05_n4():
    picks.پاک‌سازی()
    ناپایا l := رابط‌پایانه.فهرست جدید(items4())
    l.تنظیم محدوده(rect(0، 0، 10، 3))
    l.هنگام انتخاب = (i: صحیح): picks.افزودن(i) پایان
    _ := l.پردازش رویداد(key("j"))
    _ := l.پردازش رویداد(key("j"))
    آزمایش.ادعای درستی(l.پردازش رویداد(key("\r")))
