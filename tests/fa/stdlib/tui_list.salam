تابع test_scroll_starts_and_invariant():
    ناپایا l := رابط‌پایانه.فهرست جدید(items10())
    l.تنظیم محدوده(rect(0، 0، 10، 3))
    ناپایا b := رابط‌پایانه.بافر جدید(10، 3)
    دیرکن b.آزادسازی()
    b.در تمرکز = درست
    refresh(l، b)
    آزمایش.ادعای برابری عدد(start_from(items10()، b)، 0)
    تکرار 9 در step:
        _ := l.پردازش رویداد(key("j"))
        refresh(l، b)
        sel := l.نمایه انتخاب()
        st := start_from(items10()، b)
        آزمایش.ادعای درستی(st بزرگتربرابر 0)
        آزمایش.ادعای درستی(sel بزرگتربرابر st)
        آزمایش.ادعای درستی(sel کوچکتر st + 3)
        اگر step برابر 2:
            آزمایش.ادعای برابری عدد(sel، 3)
            آزمایش.ادعای برابری عدد(st، 1)
        پایان
        اگر step برابر 4:
            آزمایش.ادعای برابری عدد(sel، 5)
            آزمایش.ادعای برابری عدد(st، 3)
        پایان
        اگر step برابر 8:
            آزمایش.ادعای برابری عدد(sel، 9)
            آزمایش.ادعای برابری عدد(st، 7)
        پایان
    پایان
    تکرار 3:
        _ := l.پردازش رویداد(key("k"))
    پایان
    refresh(l، b)
    آزمایش.ادعای برابری عدد(l.نمایه انتخاب()، 6)
    آزمایش.ادعای برابری عدد(start_from(items10()، b)، 6)
پایان

