تابع test_screen_unfocused_list_does_not_consume():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 16، 2)
    دیرکن s.بستن()
    w := رابط‌پایانه.فهرست جدید(items10()) برگردان پویا رابط‌پایانه.ویجت
    id := s.افزودن(رابط‌پایانه.شناسه ریشه، w)
    s.ویجت(id).تنظیم محدوده(rect(0، 0، 16، 2))
    other := s.افزودن(رابط‌پایانه.شناسه ریشه، Sink {})
    s.ویجت(other).تنظیم محدوده(rect(0، 1، 16، 1))
    آزمایش.ادعای درستی(s.تمرکز(other))
    s.نمایش تغییرات()
    آزمایش.ادعای نادرستی(s.نیازمند بازترسیم)
    آزمایش.ادعای نادرستی(s.هدایت رویداد(key("j")))
    آزمایش.ادعای نادرستی(s.نیازمند بازترسیم)
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.متن ردیف(0)، "inbox           ")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(s.بافر.بگیر(0، 0).ظاهر، رابط‌پایانه.ظاهر { رنگ پس‌زمینه = رابط‌پایانه.مشکی روشن }))
