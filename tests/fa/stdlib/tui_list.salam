    ev := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.کلید { خام = seq }، ماوس = پایانه.رمزگشایی موشواره(seq) }
    picks.پاک‌سازی()
    ناپایا l := رابط‌پایانه.فهرست جدید(items10())
    l.تنظیم محدوده(rect(0، 0، 10، 3))
    l.هنگام انتخاب = (i: صحیح): picks.افزودن(i) پایان
    آزمایش.ادعای نادرستی(l.پردازش رویداد(ev))
    آزمایش.ادعای برابری عدد(l.نمایه انتخاب()، 0)
    آزمایش.ادعای برابری عدد(picks.طول()، 0)
پایان

