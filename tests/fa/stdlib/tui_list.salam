    آزمایش.ادعای برابری عدد(l.نمایه انتخاب()، 4)
    آزمایش.ادعای برابری رشته(l.گزینه انتخاب‌شده()، "trash")
    آزمایش.ادعای برابری عدد(picks.طول()، 1)
    آزمایش.ادعای برابری عدد(picks.دریافت(0)، 4)
پایان

