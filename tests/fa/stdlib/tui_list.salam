    l.تنظیم محدوده(rect(0، 0، 10، 3))
    آزمایش.ادعای درستی(l.پردازش رویداد(key("j")))
    آزمایش.ادعای برابری عدد(l.نمایه انتخاب()، 1)
    آزمایش.ادعای برابری رشته(l.گزینه انتخاب‌شده()، "drafts")
    ناپایا b := frame(l، 10، 3، درست)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "inbox     ")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.بگیر(0، 1).ظاهر، رابط‌پایانه.ظاهر { معکوس = درست }))
