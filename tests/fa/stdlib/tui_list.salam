    _ := l.پردازش رویداد(key("k"))
    آزمایش.ادعای برابری عدد(l.نمایه انتخاب()، 3)
    آزمایش.ادعای درستی(l.پردازش رویداد(key("k")))
    آزمایش.ادعای برابری عدد(l.نمایه انتخاب()، 2)
