تابع list_at(sel: صحیح، h: صحیح): رابط‌پایانه.فهرست:
    ناپایا l := رابط‌پایانه.فهرست جدید(items10())
    l.تنظیم محدوده(rect(0، 0، 10، h))
    تکرار sel:
        _ := l.پردازش رویداد(key("j"))
    پایان
    برگشت l
پایان

تابع frame(l: رابط‌پایانه.فهرست، w: صحیح، h: صحیح، focused: منطقی): رابط‌پایانه.بافر:
    ناپایا b := رابط‌پایانه.بافر جدید(w، h)
    b.در تمرکز = focused
    ناپایا ll := l
    ll.ترسیم(b، rect(0، 0، w، h))
    برگشت b
پایان

تابع refresh(l: رابط‌پایانه.فهرست، b: رابط‌پایانه.بافر):
    ناپایا ll := l
    ll.ترسیم(b، rect(0، 0، b.عرض، b.ارتفاع))
پایان

تابع start_from(items: وکتور<رشته>، b: رابط‌پایانه.بافر): صحیح:
    row := b.متن ردیف(0)
    هر i، it در items:
        اگر it نابرابر "" و row.بیاب(it) برابر 0:
            برگشت i
        پایان
    پایان
    برگشت -1
پایان

تابع test_defaults_selection():
    ناپایا l := رابط‌پایانه.فهرست جدید(items3())
    آزمایش.ادعای درستی(l.تمرکز‌پذیر است())
    آزمایش.ادعای برابری عدد(l.نمایه انتخاب()، 0)
    آزمایش.ادعای برابری رشته(l.گزینه انتخاب‌شده()، "inbox")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(l.ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(l.ظاهر انتخاب، رابط‌پایانه.ظاهر { معکوس = درست }))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(l.ظاهر انتخاب بی‌تمرکز، رابط‌پایانه.ظاهر { رنگ پس‌زمینه = رابط‌پایانه.مشکی روشن }))
    آزمایش.ادعای برابری عدد(l.اندازه ترجیحی(80).عرض، -1)
    آزمایش.ادعای برابری عدد(l.اندازه ترجیحی(80).ارتفاع، -1)
پایان

تابع test_defaults_empty():
    ناپایا e := رابط‌پایانه.فهرست جدید(وکتور {} برگردان وکتور<رشته>)
    آزمایش.ادعای درستی(e.تمرکز‌پذیر است())
    آزمایش.ادعای برابری عدد(e.نمایه انتخاب()، -1)
    آزمایش.ادعای برابری رشته(e.گزینه انتخاب‌شده()، "")
پایان

تابع test_selection_replaces_base_style():
    ناپایا l := رابط‌پایانه.فهرست جدید(items3())
    l.تنظیم محدوده(rect(0، 0، 10، 3))
    l.ظاهر = رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }
    l.ظاهر انتخاب = رابط‌پایانه.ظاهر { معکوس = درست }
    ناپایا b := frame(l، 10، 3، درست)
    دیرکن b.آزادکن()
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.بگیر(0، 0).ظاهر، رابط‌پایانه.ظاهر { معکوس = درست }))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.بگیر(0، 1).ظاهر، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }))
پایان

تابع test_nav_k01_j_inside_window():
