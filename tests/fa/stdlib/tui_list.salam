تابع test_sgr_defaults_probe():
    ناپایا lf := رابط‌پایانه.فهرست جدید(items3())
    lf.تنظیم محدوده(rect(0، 0، 10، 3))
    ناپایا bf := رابط‌پایانه.بافر جدید(10، 3)
    دیرکن bf.آزادسازی()
    bf.در تمرکز = درست
    before := رابط‌پایانه.شمار ساخت اس‌جی‌آر()
    lf.ترسیم(bf، rect(0، 0، 10، 3))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    _ := bf.خروجی کامل انسی()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 2)

    ناپایا lc := رابط‌پایانه.فهرست جدید(items3())
    lc.تنظیم محدوده(rect(0، 0، 10، 3))
    lc.ظاهر انتخاب = رابط‌پایانه.ظاهر { پررنگ = درست }
    ناپایا bc := رابط‌پایانه.بافر جدید(10، 3)
    دیرکن bc.آزادسازی()
    bc.در تمرکز = درست
    lc.ترسیم(bc، rect(0، 0، 10، 3))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(bc.دریافت(0، 0).ظاهر، رابط‌پایانه.ظاهر { پررنگ = درست }))

    ناپایا lp := رابط‌پایانه.فهرست جدید(items3())
    lp.تنظیم محدوده(rect(0، 0، 10، 3))
    lp.ظاهر انتخاب = رابط‌پایانه.ظاهر پیش‌فرض
    ناپایا bp := رابط‌پایانه.بافر جدید(10، 3)
    دیرکن bp.آزادسازی()
    bp.در تمرکز = درست
    lp.ترسیم(bp، rect(0، 0، 10، 3))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(bp.دریافت(0، 0).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
پایان

