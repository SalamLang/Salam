تابع test_screen_focused_list_receives_j():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 12، 3)
    دیرکن s.بستن()
    w := رابط‌پایانه.فهرست جدید(items10()) برگردان پویا رابط‌پایانه.ویجت
    id := s.افزودن(رابط‌پایانه.شناسه ریشه، w)
    s.ویجت(id).تنظیم محدوده(rect(0، 0، 12، 3))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، id)
    s.نمایش تغییرات()
    آزمایش.ادعای نادرستی(s.نیازمند بازترسیم)
    آزمایش.ادعای درستی(s.هدایت رویداد(key("j")))
    آزمایش.ادعای نادرستی(s.نیازمند بازترسیم)
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.متن ردیف(1)، "drafts      ")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(s.بافر.بگیر(0، 1).ظاهر، رابط‌پایانه.ظاهر { معکوس = درست }))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(s.بافر.بگیر(0، 0).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
