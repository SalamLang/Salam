تابع test_nav_k22_k23_single_item():
    picks.پاک‌سازی()
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.افزودن("only")
    l := رابط‌پایانه.فهرست جدید(v)
    l.تنظیم محدوده(rect(0، 0، 10، 3))
    l.هنگام انتخاب = (i: صحیح): picks.افزودن(i) پایان
    آزمایش.ادعای درستی(l.پردازش رویداد(key("j")))
    آزمایش.ادعای برابری عدد(l.نمایه انتخاب()، 0)
    آزمایش.ادعای برابری رشته(l.گزینه انتخاب‌شده()، "only")
    آزمایش.ادعای درستی(l.پردازش رویداد(key("k")))
    آزمایش.ادعای برابری عدد(l.نمایه انتخاب()، 0)
    آزمایش.ادعای برابری رشته(l.گزینه انتخاب‌شده()، "only")
    آزمایش.ادعای برابری عدد(picks.طول()، 0)
    ناپایا b := frame(l، 10، 3، درست)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "only      ")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.بگیر(0، 0).ظاهر، رابط‌پایانه.ظاهر { معکوس = درست }))
پایان

