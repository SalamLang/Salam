واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا picks := وکتور {} برگردان وکتور<صحیح>

ساختار Sink:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع focusable(): منطقی:
        برگشت درست
    پایان
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع items10(): وکتور<رشته>:
    ناپایا v := وکتور {} برگردان وکتور<رشته>
    v.افزودن("inbox")
    v.افزودن("drafts")
    v.افزودن("sent")
    v.افزودن("archive")
    v.افزودن("trash")
    v.افزودن("spam")
    v.افزودن("stars")
    v.افزودن("notes")
    v.افزودن("tasks")
    v.افزودن("done")
    برگشت v
