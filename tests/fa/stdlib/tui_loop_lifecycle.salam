واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا renders := 0

ناپایا clicks := 0

ساختار App:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع render(buf: رابط‌پایانه.بافر، bounds: رابط‌پایانه.مستطیل):
        renders++
        buf.نوشتن متن(bounds.ایکس، bounds.ایگرگ، "app"، رابط‌پایانه.ظاهر پیش‌فرض)
    پایان
پایان

ساختار Spot:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی mark: رشته = "a"

    همگانی تابع focusable(): منطقی:
        برگشت درست
    پایان

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        اگر وارونه event.نویسه است("r"):
            برگشت نادرست
        پایان
        اگر این.mark برابر "a":
            این.mark = "b"
        وگرنه:
            این.mark = "a"
        پایان
        برگشت درست
    پایان

    همگانی تابع render(buf: رابط‌پایانه.بافر، bounds: رابط‌پایانه.مستطیل):
        buf.نوشتن متن(bounds.ایکس، bounds.ایگرگ، این.mark، رابط‌پایانه.ظاهر پیش‌فرض)
    پایان
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع special(code: صحیح): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = code } }
پایان

تابع click(x: صحیح، y: صحیح): رابط‌پایانه.رویداد:
    seq := "\x1b[<0;" + (x + 1) + ";" + (y + 1) + "M"
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.کلید { خام = seq }، ماوس = پایانه.رمزگشایی موشواره(seq) }
پایان

تابع pump(s &: رابط‌پایانه.صفحه، ev: رابط‌پایانه.رویداد): منطقی:
    _ := s.صف‌گذاری رویداد(ev)
    ناپایا got := رابط‌پایانه.رویداد {}
    _ := s.رویداد بعدی(got)
    برگشت s.هدایت رویداد(got)
پایان

تابع frame(s &: رابط‌پایانه.صفحه): رشته:
    ناپایا out := ""
    تکرار s.بافر.ارتفاع در y:
        اگر y بزرگتر 0:
            out += "|"
        پایان
        out += s.بافر.متن ردیف(y)
    پایان
    برگشت out
پایان

تابع test_new_screen_state():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 20، 8)
    دیرکن s.بستن()
    آزمایش.ادعای نادرستی(s.در حال اجرا)
    آزمایش.ادعای برابری عدد(s.بافر.عرض، 20)
    آزمایش.ادعای برابری عدد(s.بافر.ارتفاع، 8)
    آزمایش.ادعای برابری عدد(s.درخت.تعداد()، 1)
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، رابط‌پایانه.بدون ویجت)
    b := s.ریشه.محدوده()
    آزمایش.ادعای برابری عدد(b.ایکس، 0)
    آزمایش.ادعای برابری عدد(b.ایگرگ، 0)
    آزمایش.ادعای برابری عدد(b.عرض، 20)
    آزمایش.ادعای برابری عدد(b.ارتفاع، 8)
    آزمایش.ادعای درستی(s.نیازمند بازترسیم)
    آزمایش.ادعای نادرستی(s.گزارش حرکت ماوس)
پایان

تابع test_run_exits_on_unconsumed_ctrl_c():
    ناپایا s := رابط‌پایانه.صفحه جدید(App {}، 20، 8)
    دیرکن s.بستن()
    renders = 0
    آزمایش.ادعای درستی(s.صف‌گذاری رویداد(key("\x03")))
    s.اجرا()
    آزمایش.ادعای نادرستی(s.در حال اجرا)
    آزمایش.ادعای برابری عدد(renders، 1)
پایان

تابع test_run_consumed_key_changes_state():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 20، 8)
    دیرکن s.بستن()
    spot := Spot {} برگردان پویا رابط‌پایانه.ویجت
    id := s.افزودن(رابط‌پایانه.شناسه ریشه، spot)
    s.ویجت(id).تنظیم محدوده(rect(0، 0، 1، 1))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، id)
    آزمایش.ادعای درستی(s.صف‌گذاری رویداد(key("r")))
    آزمایش.ادعای درستی(s.صف‌گذاری رویداد(key("\x03")))
    s.اجرا()
    آزمایش.ادعای نادرستی(s.در حال اجرا)
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(0، 0).نویسه، "b")
پایان

تابع test_close_without_stop():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 4، 1)
    s.بستن()
    آزمایش.ادعای نادرستی(s.در حال اجرا)
پایان

تابع test_start_after_close_is_a_noop():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 4، 1)
    s.بستن()
    s.آغاز()
    آزمایش.ادعای نادرستی(s.در حال اجرا)
پایان

تابع test_scripted_event_loop():
    ناپایا s := رابط‌پایانه.صفحه جدید(App {}، 20، 8)
    دیرکن s.بستن()
    s.تنظیم نگاشت کلید(رابط‌پایانه.نگاشت کلید پیش‌فرض())
    clicks = 0

    inp := رابط‌پایانه.کادر متن جدید() برگردان پویا رابط‌پایانه.ویجت
    inbox := s.افزودن(رابط‌پایانه.شناسه ریشه، inp)
    s.ویجت(inbox).تنظیم محدوده(rect(1، 1، 12، 1))

    box := رابط‌پایانه.کادر انتخاب جدید("Wrap"، نادرست) برگردان پویا رابط‌پایانه.ویجت
    wrapped := s.افزودن(رابط‌پایانه.شناسه ریشه، box)
    s.ویجت(wrapped).تنظیم محدوده(rect(1، 3، 12، 1))

    ناپایا btn := رابط‌پایانه.دکمه جدید("Run")
    btn.هنگام کلیک = (): clicks++ پایان
    launch := s.افزودن(رابط‌پایانه.شناسه ریشه، btn برگردان پویا رابط‌پایانه.ویجت)
    s.ویجت(launch).تنظیم محدوده(rect(1، 4، 12، 1))

    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، inbox)

    آزمایش.ادعای درستی(pump(s، key("h")))
    آزمایش.ادعای درستی(pump(s، key("i")))
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(1، 1).نویسه، "h")
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(2، 1).نویسه، "i")

    آزمایش.ادعای درستی(pump(s، special(پایانه.کلید تب)))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، wrapped)

    آزمایش.ادعای درستی(pump(s، key(" ")))
    s.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(s.بافر.بگیر(2، 3).نویسه، "x")

    آزمایش.ادعای درستی(pump(s، special(پایانه.کلید تب)))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، launch)

    آزمایش.ادعای درستی(pump(s، special(پایانه.کلید ورود)))
    آزمایش.ادعای برابری عدد(clicks، 1)

    آزمایش.ادعای درستی(pump(s، special(پایانه.کلید تب)))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، inbox)

    آزمایش.ادعای درستی(pump(s، click(7، 4)))
    آزمایش.ادعای برابری عدد(clicks، 2)
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، inbox)

    آزمایش.ادعای نادرستی(pump(s، رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تغییر اندازه، عرض = 24، ارتفاع = 10 }))
    آزمایش.ادعای برابری عدد(s.بافر.عرض، 24)
    آزمایش.ادعای برابری عدد(s.بافر.ارتفاع، 10)
    b := s.ریشه.محدوده()
    آزمایش.ادعای برابری عدد(b.ایکس، 0)
    آزمایش.ادعای برابری عدد(b.ایگرگ، 0)
    آزمایش.ادعای برابری عدد(b.عرض، 24)
    آزمایش.ادعای برابری عدد(b.ارتفاع، 10)
    آزمایش.ادعای برابری رشته(s.بافر.اختلاف()، s.بافر.خروجی کامل انسی())
    s.نمایش تغییرات()
    s.بافر.ثبت قاب()

    آزمایش.ادعای نادرستی(pump(s، رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تیک }))
    آزمایش.ادعای نادرستی(s.در حال اجرا)

    ev := key("\x03")
    consumed := pump(s، ev)
    آزمایش.ادعای نادرستی(consumed)
    اگر وارونه consumed و ev.ترکیب کنترل است("c"):
        s.توقف()
    پایان
    ناپایا last := رابط‌پایانه.رویداد {}
    آزمایش.ادعای نادرستی(s.رویداد بعدی(last))
    آزمایش.ادعای نادرستی(s.در حال اجرا)

    آزمایش.ادعای برابری رشته(frame(s)، "app                     | hi                     |                        | [x] Wrap               | [   Run    ]           |                        |                        |                        |                        |                        ")
پایان

تابع test_post_stop_next_event_after_close_are_inert():
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 4، 1)
    s.بستن()
    آزمایش.ادعای نادرستی(s.صف‌گذاری رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تیک }))
    s.توقف()
    ناپایا ev := رابط‌پایانه.رویداد {}
    آزمایش.ادعای نادرستی(s.رویداد بعدی(ev))
    آزمایش.ادعای نادرستی(s.در حال اجرا)
پایان

تابع ریشه:
    test_new_screen_state()
    test_run_exits_on_unconsumed_ctrl_c()
    test_run_consumed_key_changes_state()
    test_close_without_stop()
    test_start_after_close_is_a_noop()
    test_scripted_event_loop()
    test_post_stop_next_event_after_close_are_inert()
    برگشت آزمایش.خلاصه()
پایان
