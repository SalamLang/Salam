واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا visits := وکتور {} برگردان وکتور<رشته>

ساختار Recorder:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی name: رشته = ""
    همگانی takes_mouse: منطقی = نادرست
    همگانی takes_keys: منطقی = نادرست
    همگانی can_focus: منطقی = نادرست
    همگانی allow_hits: منطقی = درست

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        visits.افزودن(این.name)
        اگر event.نوع برابر رابط‌پایانه.رویداد ماوس:
            برگشت این.takes_mouse
        پایان
        برگشت event.نوع برابر رابط‌پایانه.رویداد کیبورد و این.takes_keys
    پایان

    همگانی تابع focusable(): منطقی:
        برگشت این.can_focus
    پایان

    همگانی تابع hits(): منطقی:
        برگشت این.allow_hits
    پایان
پایان

ساختار Shutter:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی shown: منطقی = درست

    همگانی تابع visible(): منطقی:
        برگشت این.shown
    پایان
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع click(x: صحیح، y: صحیح): رابط‌پایانه.رویداد:
    seq := "\x1b[<0;" + (x + 1) + ";" + (y + 1) + "M"
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.کلید { خام = seq }، ماوس = پایانه.رمزگشایی موشواره(seq) }
پایان

تابع key(ch: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(ch) }
پایان

تابع trail(): رشته:
    ناپایا out := ""
    هر i، v در visits:
        اگر i بزرگتر 0:
            out += ">"
        پایان
        out += v
    پایان
    visits.پاک‌سازی()
    برگشت out
پایان

تابع build(): رابط‌پایانه.صفحه:
    ناپایا s := رابط‌پایانه.صفحه جدید(Recorder { name = "root" }، 20، 10)
    panel := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "panel"، can_focus = درست، takes_keys = درست })
    child := s.افزودن(panel، Recorder { name = "child" })
    overlay := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "overlay" })
    s.ویجت(panel).تنظیم محدوده(rect(0، 0، 10، 5))
    s.ویجت(child).تنظیم محدوده(rect(2، 1، 4، 2))
    s.ویجت(overlay).تنظیم محدوده(rect(4، 1، 4، 3))
    برگشت s
پایان

تابع test_mouse_point_is_zero_based():
    آزمایش.ادعای برابری عدد(click(0، 0).مختصات ماوس().ایکس، 0)
    آزمایش.ادعای برابری عدد(click(0، 0).مختصات ماوس().ایگرگ، 0)
    آزمایش.ادعای برابری عدد(click(7، 3).مختصات ماوس().ایکس، 7)
    آزمایش.ادعای برابری عدد(click(7، 3).مختصات ماوس().ایگرگ، 3)
پایان

تابع test_hit_test_picks_topmost():
    ناپایا s := build()
    دیرکن s.ببند()
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(2، 1)، 2)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(0، 0)، 1)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(15، 8)، رابط‌پایانه.شناسه ریشه)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(4، 1)، 3)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(5، 2)، 3)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(6، 1)، 3)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(8، 1)، 1)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(4، 3)، 3)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(4، 4)، 1)
پایان

تابع test_hit_test_outside_screen():
    ناپایا s := build()
    دیرکن s.ببند()
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(20، 0)، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(0، 10)، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(-1، -1)، رابط‌پایانه.بدون ویجت)
پایان

تابع test_hit_test_skips_empty_bounds():
    ناپایا s := build()
    دیرکن s.ببند()
    ghost := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "ghost" })
    s.ویجت(ghost).تنظیم محدوده(rect(12، 5، 0، 3))
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(12، 5)، رابط‌پایانه.شناسه ریشه)
پایان

تابع test_hit_test_skips_hidden_subtree():
    ناپایا s := رابط‌پایانه.صفحه جدید(Recorder { name = "root" }، 20، 10)
    دیرکن s.بستن()
    top := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "top" })
    sh := s.افزودن(رابط‌پایانه.شناسه ریشه، Shutter { shown = نادرست })
    kid := s.افزودن(sh، Recorder { name = "kid" })
    below := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "below" })
    s.ویجت(top).تنظیم محدوده(rect(0، 0، 10، 5))
    s.ویجت(sh).تنظیم محدوده(rect(0، 0، 10، 5))
    s.ویجت(kid).تنظیم محدوده(rect(0، 0، 10، 5))
    s.ویجت(below).تنظیم محدوده(rect(12، 0، 4، 1))
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(1، 1)، top)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(12، 0)، below)

    ناپایا shown := رابط‌پایانه.صفحه جدید(Recorder { name = "root" }، 20، 10)
    دیرکن shown.بستن()
    top2 := shown.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "top" })
    sh2 := shown.افزودن(رابط‌پایانه.شناسه ریشه، Shutter { shown = درست })
    kid2 := shown.افزودن(sh2، Recorder { name = "kid" })
    shown.ویجت(top2).تنظیم محدوده(rect(0، 0، 10، 5))
    shown.ویجت(sh2).تنظیم محدوده(rect(0، 0، 10، 5))
    shown.ویجت(kid2).تنظیم محدوده(rect(0، 0، 10، 5))
    آزمایش.ادعای برابری عدد(shown.آزمون برخورد(1، 1)، kid2)
پایان

تابع test_click_on_child_reaches_child_first():
    ناپایا s := build()
    دیرکن s.ببند()
    آزمایش.ادعای نادرستی(s.هدایت رویداد(click(2، 1)))
    آزمایش.ادعای برابری رشته(trail()، "child>panel>root")
پایان

تابع test_child_consumes_and_parent_never_sees():
    ناپایا s := رابط‌پایانه.صفحه جدید(Recorder { name = "root" }، 20، 10)
    دیرکن s.بستن()
    panel := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "panel"، can_focus = درست })
    child := s.افزودن(panel، Recorder { name = "child"، takes_mouse = درست })
    s.ویجت(panel).تنظیم محدوده(rect(0، 0، 10، 5))
    s.ویجت(child).تنظیم محدوده(rect(2، 1، 4، 2))
    آزمایش.ادعای درستی(s.هدایت رویداد(click(3، 2)))
    آزمایش.ادعای برابری رشته(trail()، "child")
    آزمایش.ادعای درستی(s.نیازمند بازترسیم)
پایان

تابع test_click_never_moves_focus():
    ناپایا s := رابط‌پایانه.صفحه جدید(Recorder { name = "root" }، 20، 10)
    دیرکن s.بستن()
    one := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "one"، can_focus = درست })
    two := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "two"، can_focus = درست })
    s.ویجت(one).تنظیم محدوده(rect(0، 0، 10، 5))
    s.ویجت(two).تنظیم محدوده(rect(10، 0، 10، 5))
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، one)
    آزمایش.ادعای نادرستی(s.هدایت رویداد(click(12، 2)))
    آزمایش.ادعای برابری رشته(trail()، "two>root")
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، one)
پایان

تابع test_click_outside_children_goes_to_root():
    ناپایا s := رابط‌پایانه.صفحه جدید(Recorder { name = "root"، takes_mouse = درست }، 20، 10)
    دیرکن s.بستن()
    panel := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "panel"، can_focus = درست })
    s.ویجت(panel).تنظیم محدوده(rect(0، 0، 10، 5))
    آزمایش.ادعای درستی(s.هدایت رویداد(click(15، 8)))
    آزمایش.ادعای برابری رشته(trail()، "root")
پایان

تابع test_click_with_nothing_under_cursor_falls_back_to_focus():
    ناپایا s := build()
    دیرکن s.ببند()
    آزمایش.ادعای نادرستی(s.هدایت رویداد(click(30، 3)))
    آزمایش.ادعای برابری رشته(trail()، "panel>root")
پایان

تابع test_overlapping_siblings_later_wins():
    ناپایا s := build()
    دیرکن s.ببند()
    آزمایش.ادعای نادرستی(s.هدایت رویداد(click(4، 1)))
    آزمایش.ادعای برابری رشته(trail()، "overlay>root")
پایان

تابع test_undecoded_mouse_report_falls_back_to_focus():
    ناپایا s := build()
    دیرکن s.ببند()
    ev := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس }
    آزمایش.ادعای نادرستی(s.هدایت رویداد(ev))
    آزمایش.ادعای برابری رشته(trail()، "panel>root")
پایان

تابع test_raised_widget_beats_later_sibling():
    ناپایا s := build()
    دیرکن s.ببند()
    ناپایا ids := وکتور {} برگردان وکتور<صحیح>
    دیرکن ids.آزادسازی()
    ids.افزودن(1)
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 1)
    s.آوردن به رو(ids)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(4، 1)، 1)
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 1)
    آزمایش.ادعای نادرستی(s.هدایت رویداد(click(4، 1)))
    آزمایش.ادعای برابری رشته(trail()، "panel>root")
پایان

تابع test_one_raise_shares_one_stamp():
    ناپایا s := build()
    دیرکن s.ببند()
    ناپایا ids := وکتور {} برگردان وکتور<صحیح>
    دیرکن ids.آزادسازی()
    ids.افزودن(2)
    ids.افزودن(1)
    s.آوردن به رو(ids)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(4، 1)، 2)
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 1)
پایان

تابع test_hits_false_is_skipped():
    ناپایا s := رابط‌پایانه.صفحه جدید(Recorder { name = "w0"، can_focus = درست }، 10، 4)
    دیرکن s.بستن()
    w1 := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "w1"، can_focus = درست })
    w2 := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "w2"، can_focus = درست })
    w3 := s.افزودن(رابط‌پایانه.شناسه ریشه، Recorder { name = "w3"، allow_hits = نادرست })
    s.ویجت(w1).تنظیم محدوده(rect(2، 1، 4، 2))
    s.ویجت(w2).تنظیم محدوده(rect(0، 0، 10، 4))
    s.ویجت(w3).تنظیم محدوده(rect(6، 1، 4، 2))
    آزمایش.ادعای درستی(s.تمرکز(w2))
    ناپایا ids := وکتور {} برگردان وکتور<صحیح>
    دیرکن ids.آزادسازی()
    ids.افزودن(w1)
    s.آوردن به رو(ids)
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، w1)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(3، 2)، w1)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(7، 2)، w2)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(0، 0)، w2)
    آزمایش.ادعای برابری عدد(s.آزمون برخورد(9، 9)، رابط‌پایانه.بدون ویجت)
    آزمایش.ادعای نادرستی(s.هدایت رویداد(click(7، 2)))
    آزمایش.ادعای برابری رشته(trail()، "w2>w0")
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، w1)
پایان

تابع test_keyboard_still_goes_to_focused_widget():
    ناپایا s := build()
    دیرکن s.ببند()
    آزمایش.ادعای درستی(s.هدایت رویداد(key("a")))
    آزمایش.ادعای برابری رشته(trail()، "panel")
    آزمایش.ادعای برابری عدد(s.شناسه متمرکز()، 1)
پایان

تابع test_tick_and_resize_stay_on_focus_path():
    ناپایا s := build()
    دیرکن s.ببند()
    آزمایش.ادعای نادرستی(s.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تیک }))
    آزمایش.ادعای برابری رشته(trail()، "panel>root")
    آزمایش.ادعای نادرستی(s.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تغییر اندازه، عرض = 30، ارتفاع = 12 }))
    آزمایش.ادعای برابری رشته(trail()، "panel>root")
    آزمایش.ادعای برابری عدد(s.بافر.عرض، 30)
پایان

تابع test_release_report_decodes_and_routes():
    ناپایا s := build()
    دیرکن s.ببند()
    seq := "\x1b[<0;3;2m"
    mouse := پایانه.رمزگشایی موشواره(seq)
    آزمایش.ادعای درستی(mouse.موفق)
    آزمایش.ادعای نادرستی(mouse.فشرده)
    ev := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.کلید { خام = seq }، ماوس = mouse }
    آزمایش.ادعای نادرستی(s.هدایت رویداد(ev))
    آزمایش.ادعای برابری رشته(trail()، "child>panel>root")
پایان

تابع test_motion_report_decodes_and_routes():
    ناپایا s := build()
    دیرکن s.ببند()
    seq := "\x1b[<35;3;2M"
    mouse := پایانه.رمزگشایی موشواره(seq)
    آزمایش.ادعای درستی(mouse.موفق)
    آزمایش.ادعای درستی(mouse.حرکت)
    آزمایش.ادعای درستی(mouse.فشرده)
    آزمایش.ادعای برابری عدد(mouse.دکمه، 3)
    ev := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.کلید { خام = seq }، ماوس = mouse }
    آزمایش.ادعای نادرستی(s.هدایت رویداد(ev))
    آزمایش.ادعای برابری رشته(trail()، "child>panel>root")
پایان

تابع ریشه:
    test_mouse_point_is_zero_based()
    test_hit_test_picks_topmost()
    test_hit_test_outside_screen()
    test_hit_test_skips_empty_bounds()
    test_hit_test_skips_hidden_subtree()
    test_click_on_child_reaches_child_first()
    test_child_consumes_and_parent_never_sees()
    test_click_never_moves_focus()
    test_click_outside_children_goes_to_root()
    test_click_with_nothing_under_cursor_falls_back_to_focus()
    test_overlapping_siblings_later_wins()
    test_raised_widget_beats_later_sibling()
    test_one_raise_shares_one_stamp()
    test_hits_false_is_skipped()
    test_undecoded_mouse_report_falls_back_to_focus()
    test_keyboard_still_goes_to_focused_widget()
    test_tick_and_resize_stay_on_focus_path()
    test_release_report_decodes_and_routes()
    test_motion_report_decodes_and_routes()
    visits.آزادسازی()
    برگشت آزمایش.خلاصه()
پایان
