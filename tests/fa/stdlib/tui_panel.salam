تابع test_none_pass_through():
    ناپایا b := رابط‌پایانه.بافر جدید(8، 3)
    b.پرکردن(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 8، ارتفاع = 3 }، "x"، رابط‌پایانه.ظاهر پیش‌فرض)
    ناپایا p := رابط‌پایانه.پنل { عنوان = "Files" }
    p.افزودن(Probe {})
    r := رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 8، ارتفاع = 3 }
    p.تنظیم محدوده(r)
    p.ترسیم(b، r)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "xxxxxxxx")
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، "xxxxxxxx")
    child := p.جایگاه.بگیر(0).فرزند.محدوده()
    آزمایش.ادعای برابری عدد(child.ایکس، 0)
    آزمایش.ادعای برابری عدد(child.ایگرگ، 0)
    آزمایش.ادعای برابری عدد(child.عرض، 8)
    آزمایش.ادعای برابری عدد(child.ارتفاع، 3)
    b.آزادسازی()
پایان

تابع test_child_inset_by_single():
    ناپایا p := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Single }
    p.افزودن(Probe {})
    p.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 2، ایگرگ = 1، عرض = 10، ارتفاع = 6 })
    child := p.جایگاه.بگیر(0).فرزند.محدوده()
    آزمایش.ادعای برابری عدد(child.ایکس، 3)
    آزمایش.ادعای برابری عدد(child.ایگرگ، 2)
    آزمایش.ادعای برابری عدد(child.عرض، 8)
    آزمایش.ادعای برابری عدد(child.ارتفاع، 4)
