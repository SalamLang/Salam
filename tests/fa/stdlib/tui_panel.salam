واردسازی حافظه
واردسازی پایانه
واردسازی آزمایش
واردسازی رابط‌پایانه

ساختار Probe:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
پایان

ساختار Keyed:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        برگشت event.نویسه است("k")
    پایان
پایان

ساختار FixedSizer:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی w: صحیح = 0
    همگانی h: صحیح = 0
    همگانی expect: صحیح = -1

    همگانی تابع preferred_size(max_width: صحیح): رابط‌پایانه.مستطیل:
        اگر این.expect بزرگتربرابر 0:
            آزمایش.ادعای برابری عدد(max_width، این.expect)
        پایان
        برگشت رابط‌پایانه.مستطیل { عرض = این.w، ارتفاع = این.h }
    پایان
پایان

ساختار CountingField:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی seen: صحیح* = پوچ

    همگانی تابع focusable(): منطقی:
        برگشت درست
    پایان

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        _ := event
        این.seen[0]++
        برگشت نادرست
    پایان
پایان

تابع test_single_frame_painted():
    ناپایا b := رابط‌پایانه.بافر جدید(8، 3)
    ناپایا p := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Single }
    p.افزودن(Probe {})
    r := رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 8، ارتفاع = 3 }
    p.تنظیم محدوده(r)
    p.ترسیم(b، r)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "┌──────┐")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "│      │")
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، "└──────┘")
    b.آزادسازی()
پایان

تابع test_double_and_rounded_glyphs():
    ناپایا d := رابط‌پایانه.بافر جدید(4، 3)
    ناپایا dp := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Double }
    dp.افزودن(Probe {})
    dr := رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 4، ارتفاع = 3 }
    dp.تنظیم محدوده(dr)
    dp.ترسیم(d، dr)
    آزمایش.ادعای برابری رشته(d.متن ردیف(0)، "╔══╗")
    آزمایش.ادعای برابری رشته(d.متن ردیف(2)، "╚══╝")
    d.آزادسازی()

    ناپایا rb := رابط‌پایانه.بافر جدید(4، 3)
    ناپایا rp := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Rounded }
    rp.افزودن(Probe {})
    rp.تنظیم محدوده(dr)
    rp.ترسیم(rb، dr)
    آزمایش.ادعای برابری رشته(rb.متن ردیف(0)، "╭──╮")
    آزمایش.ادعای برابری رشته(rb.متن ردیف(2)، "╰──╯")
    rb.آزادسازی()
پایان

