    p.افزودن(FixedSizer { w = 4، h = 2 })
    r := p.اندازه ترجیحی(80)
    آزمایش.ادعای برابری عدد(r.ایکس، 0)
    آزمایش.ادعای برابری عدد(r.ایگرگ، 0)
    آزمایش.ادعای برابری عدد(r.عرض، 6)
    آزمایش.ادعای برابری عدد(r.ارتفاع، 4)
