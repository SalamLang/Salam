تابع test_border_style_fg_only():
    ناپایا b := رابط‌پایانه.بافر جدید(8، 3)
    style := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(2)، پررنگ = درست، زیرخط = درست }
    ناپایا p := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Single، ظاهر کادر = style، عنوان = "Files" }
    p.افزودن(Probe {})
    r := رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 8، ارتفاع = 3 }
    p.تنظیم محدوده(r)
    p.ترسیم(b، r)
    want := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(2) }
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، want))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(3، 0).ظاهر، want))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(7، 2).ظاهر، want))
    b.آزادسازی()
پایان

