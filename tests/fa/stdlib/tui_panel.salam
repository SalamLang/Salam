تابع test_nested_rings_are_adjacent():
    ناپایا b := رابط‌پایانه.بافر جدید(8، 5)
    ناپایا outer := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Single }
    ناپایا inner := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Double }
    inner.افزودن(Probe {})
    outer.افزودن(inner)
    r := رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 8، ارتفاع = 5 }
    outer.تنظیم محدوده(r)
    outer.ترسیم(b، r)
    inner.ترسیم(b، رابط‌پایانه.مستطیل { ایکس = 1، ایگرگ = 1، عرض = 6، ارتفاع = 3 })
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "┌──────┐")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "│╔════╗│")
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، "│║    ║│")
    آزمایش.ادعای برابری رشته(b.متن ردیف(3)، "│╚════╝│")
    آزمایش.ادعای برابری رشته(b.متن ردیف(4)، "└──────┘")
    b.آزادسازی()
پایان

تابع test_ascii_policy_frames_panel():
    ناپایا b := رابط‌پایانه.بافر جدید(4، 3)
    b.نویسه‌ها = رابط‌پایانه.سیاست‌نویسه‌ها.ASCII
    ناپایا p := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Rounded }
    p.افزودن(Probe {})
    r := رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 4، ارتفاع = 3 }
    p.تنظیم محدوده(r)
    p.ترسیم(b، r)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "+--+")
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، "+--+")
    b.آزادسازی()
پایان

تابع test_bubbled_event_is_not_forwarded_again():
    seen := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح*
    دیرکن حافظه.آزادسازی(seen برگردان تهی*)
    ناپایا s := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 20، 5)
    دیرکن s.بستن()
    ناپایا p := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Single، تمرکز می‌گیرد = درست }
    c := CountingField { seen = seen } برگردان پویا رابط‌پایانه.ویجت
    p.افزودن(c)
    pid := s.افزودن(رابط‌پایانه.شناسه ریشه، p)
    cid := s.افزودن(pid، c)
    s.ویجت(pid).تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 10، ارتفاع = 4 })
    آزمایش.ادعای درستی(s.تمرکز(cid))
    آزمایش.ادعای نادرستی(s.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی("z") }))
    آزمایش.ادعای برابری عدد(seen[0]، 1)
    آزمایش.ادعای درستی(s.تمرکز(pid))
    آزمایش.ادعای نادرستی(s.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی("z") }))
    آزمایش.ادعای برابری عدد(seen[0]، 2)
پایان

