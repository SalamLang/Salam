تابع test_resize_reinsets():
    ناپایا p := رابط‌پایانه.پنل { کادر = رابط‌پایانه.سبک‌کادر.Double }
    p.افزودن(Probe {})
    p.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 10، ارتفاع = 6 })
    p.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 20، ارتفاع = 10 })
    child := p.جایگاه.بگیر(0).فرزند.محدوده()
    آزمایش.ادعای برابری عدد(child.عرض، 18)
    آزمایش.ادعای برابری عدد(child.ارتفاع، 8)
پایان

