واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع press_origin(): رابط‌پایانه.رویداد:
    seq := "\x1b[<0;1;1M"
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.کلید { خام = seq }، ماوس = پایانه.رمزگشایی موشواره(seq) }
پایان

تابع draw(p: رابط‌پایانه.نوار‌پیشرفت، w: صحیح، h: صحیح): رابط‌پایانه.بافر:
    b := رابط‌پایانه.بافر جدید(w، h)
    p.ترسیم(b، rect(0، 0، w، h))
    برگشت b
پایان

تابع test_defaults():
    p := رابط‌پایانه.نوار پیشرفت جدید()
    آزمایش.ادعای برابری عدد(p.مقدار پیشرفت()، 0)
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(p.ظاهر بخش پر، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(p.ظاهر بخش خالی، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(p.ظاهر متن، رابط‌پایانه.ظاهر پیش‌فرض))
پایان

تابع test_predicates():
    ناپایا p := رابط‌پایانه.نوار پیشرفت جدید()
    p.تنظیم محدوده(rect(0، 0، 10، 1))
    آزمایش.ادعای نادرستی(p.تمرکز‌پذیر است())
    آزمایش.ادعای نادرستی(p.اصابت‌پذیر است())
    آزمایش.ادعای نادرستی(p.پردازش رویداد(key("a")))
    آزمایش.ادعای نادرستی(p.پردازش رویداد(press_origin()))
    آزمایش.ادعای برابری عدد(p.مقدار پیشرفت()، 0)
پایان

تابع test_preferred_size():
    p := رابط‌پایانه.نوار پیشرفت جدید()
    آزمایش.ادعای برابری عدد(p.اندازه ترجیحی(0).عرض، -1)
    آزمایش.ادعای برابری عدد(p.اندازه ترجیحی(0).ارتفاع، 1)
پایان

تابع test_setters_clamp():
    ناپایا p := رابط‌پایانه.نوار پیشرفت جدید()
    p.تنظیم پیشرفت(-20)
    آزمایش.ادعای برابری عدد(p.مقدار پیشرفت()، 0)
    p.تنظیم پیشرفت(250)
    آزمایش.ادعای برابری عدد(p.مقدار پیشرفت()، 100)
    p.تنظیم پیشرفت(42)
    آزمایش.ادعای برابری عدد(p.مقدار پیشرفت()، 42)
    p.تنظیم بیشینه(3)
    آزمایش.ادعای برابری عدد(p.مقدار پیشرفت()، 3)
    p.تنظیم پیشرفت(9)
    آزمایش.ادعای برابری عدد(p.مقدار پیشرفت()، 3)
    p.تنظیم بیشینه(0)
    آزمایش.ادعای برابری عدد(p.مقدار پیشرفت()، 0)
    p.تنظیم پیشرفت(5)
    آزمایش.ادعای برابری عدد(p.مقدار پیشرفت()، 0)
پایان

تابع test_render_vectors_bar_and_tail():
    ناپایا p := رابط‌پایانه.نوار پیشرفت جدید()

    b := draw(p، 20، 2)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "---------------   0%")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "                    ")

    p.تنظیم پیشرفت(42)
    c := draw(p، 20، 1)
    دیرکن c.آزادکن()
    آزمایش.ادعای برابری رشته(c.متن ردیف(0)، "######---------  42%")
    آزمایش.ادعای برابری رشته(c.بگیر(5، 0).نویسه، "#")
    آزمایش.ادعای برابری رشته(c.بگیر(6، 0).نویسه، "-")

    p.تنظیم پیشرفت(100)
    d := draw(p، 20، 1)
    دیرکن d.آزادکن()
    آزمایش.ادعای برابری رشته(d.متن ردیف(0)، "############### 100%")

    ناپایا q := رابط‌پایانه.نوار پیشرفت جدید()
    q.تنظیم بیشینه(3)
    q.تنظیم پیشرفت(1)
    e := draw(q، 20، 1)
    دیرکن e.آزادکن()
    آزمایش.ادعای برابری رشته(e.متن ردیف(0)، "#####----------  33%")
    آزمایش.ادعای برابری رشته(e.بگیر(4، 0).نویسه، "#")
    آزمایش.ادعای برابری رشته(e.بگیر(5، 0).نویسه، "-")

    ناپایا r := رابط‌پایانه.نوار پیشرفت جدید()
    r.تنظیم پیشرفت(-20)
    f := draw(r، 20، 1)
    دیرکن f.آزادکن()
    آزمایش.ادعای برابری رشته(f.متن ردیف(0)، "---------------   0%")

    ناپایا s := رابط‌پایانه.نوار پیشرفت جدید()
    s.تنظیم پیشرفت(250)
    g := draw(s، 20، 1)
    دیرکن g.آزادکن()
    آزمایش.ادعای برابری رشته(g.متن ردیف(0)، "############### 100%")

    ناپایا t := رابط‌پایانه.نوار پیشرفت جدید()
    t.تنظیم بیشینه(0)
    t.تنظیم پیشرفت(5)
    h := draw(t، 20، 1)
    دیرکن h.آزادکن()
    آزمایش.ادعای برابری رشته(h.متن ردیف(0)، "---------------   0%")
پایان

تابع test_render_vectors_narrow():
    ناپایا p := رابط‌پایانه.نوار پیشرفت جدید()

    p.تنظیم پیشرفت(50)
    a := draw(p، 8، 1)
    دیرکن a.آزادکن()
    آزمایش.ادعای برابری رشته(a.متن ردیف(0)، "#--  50%")

    b := draw(p، 5، 1)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "##---")

    c := draw(p، 6، 1)
    دیرکن c.آزادکن()
    آزمایش.ادعای برابری رشته(c.متن ردیف(0)، "-  50%")

    ناپایا full := رابط‌پایانه.نوار پیشرفت جدید()
    full.تنظیم پیشرفت(100)
    d := draw(full، 6، 1)
    دیرکن d.آزادکن()
    آزمایش.ادعای برابری رشته(d.متن ردیف(0)، "# 100%")

    e := draw(full، 2، 1)
    دیرکن e.آزادکن()
    آزمایش.ادعای برابری رشته(e.متن ردیف(0)، "##")

    ناپایا almost := رابط‌پایانه.نوار پیشرفت جدید()
    almost.تنظیم پیشرفت(99)
    f := draw(almost، 1، 1)
    دیرکن f.آزادکن()
    آزمایش.ادعای برابری رشته(f.متن ردیف(0)، "-")

    g := draw(p، 0، 1)
    دیرکن g.آزادکن()
    آزمایش.ادعای برابری رشته(g.متن ردیف(0)، "")
پایان

تابع test_render_offset_bounds():
    ناپایا p := رابط‌پایانه.نوار پیشرفت جدید()
    p.تنظیم پیشرفت(50)
    b := رابط‌پایانه.بافر جدید(11، 3)
    دیرکن b.آزادسازی()
    p.ترسیم(b، rect(3، 1، 8، 1))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "           ")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "   #--  50%")
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، "           ")
پایان

تابع test_render_colours():
    ناپایا p := رابط‌پایانه.نوار پیشرفت جدید()
    p.ظاهر بخش پر = رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }
    p.ظاهر بخش خالی = رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.مشکی روشن }
    p.تنظیم پیشرفت(42)
    b := draw(p، 20، 1)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "######---------  42%")
    green := رابط‌پایانه.دنباله فعال‌سازی ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }، رابط‌پایانه.سطح‌رنگ.TrueColor)
    green_off := رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }، رابط‌پایانه.سطح‌رنگ.TrueColor)
    bright := رابط‌پایانه.دنباله فعال‌سازی ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.مشکی روشن }، رابط‌پایانه.سطح‌رنگ.TrueColor)
    bright_off := رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.مشکی روشن }، رابط‌پایانه.سطح‌رنگ.TrueColor)
    want := پایانه.دنباله رفتن به(1، 1) + green + "######" + green_off + bright + "---------" + bright_off + "  42%"
    آزمایش.ادعای برابری رشته(b.خروجی کامل انسی()، want)

    ناپایا t := رابط‌پایانه.نوار پیشرفت جدید()
    t.ظاهر متن = رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }
    t.تنظیم پیشرفت(42)
    c := draw(t، 20، 1)
    دیرکن c.آزادکن()
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(c.بگیر(18، 0).ظاهر، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }))
پایان

تابع test_sgr_memo_probe():
    ناپایا p := رابط‌پایانه.نوار پیشرفت جدید()
    p.تنظیم پیشرفت(42)
    buf := رابط‌پایانه.بافر جدید(20، 1)
    دیرکن buf.آزادسازی()
    before := رابط‌پایانه.شمار ساخت اس‌جی‌آر()
    p.ترسیم(buf، rect(0، 0، 20، 1))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    _ := buf.خروجی کامل انسی()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    p.ظاهر بخش پر = رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }
    p.ترسیم(buf، rect(0، 0، 20، 1))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    _ := buf.خروجی کامل انسی()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 2)
پایان

تابع ریشه:
    test_defaults()
    test_predicates()
    test_preferred_size()
    test_setters_clamp()
    test_render_vectors_bar_and_tail()
    test_render_vectors_narrow()
    test_render_offset_bounds()
    test_render_colours()
    test_sgr_memo_probe()
    برگشت آزمایش.خلاصه()
پایان
