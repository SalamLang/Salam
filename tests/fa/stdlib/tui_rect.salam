واردسازی آزمایش
واردسازی رابط‌پایانه

تابع مستطیل(ایکس: صحیح، ایگرگ: صحیح، پهنا: صحیح، بلندا: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = ایکس، ایگرگ = ایگرگ، عرض = پهنا، ارتفاع = بلندا }
پایان

تابع نقطه(ایکس: صحیح، ایگرگ: صحیح): رابط‌پایانه.نقطه:
    برگشت رابط‌پایانه.نقطه { ایکس = ایکس، ایگرگ = ایگرگ }
پایان

تابع test_contains():
    کادر := مستطیل(2، 3، 4، 2)
    آزمایش.ادعای درستی(کادر.دربرمی‌گیرد(نقطه(2، 3)))
    آزمایش.ادعای درستی(کادر.دربرمی‌گیرد(نقطه(5، 4)))
    آزمایش.ادعای نادرستی(کادر.دربرمی‌گیرد(نقطه(6، 3)))
    آزمایش.ادعای نادرستی(کادر.دربرمی‌گیرد(نقطه(2، 5)))
    آزمایش.ادعای نادرستی(کادر.دربرمی‌گیرد(نقطه(1، 3)))
    آزمایش.ادعای نادرستی(کادر.دربرمی‌گیرد(نقطه(2، 2)))
پایان

تابع test_contains_empty():
    آزمایش.ادعای نادرستی(مستطیل(0، 0، 0، 0).دربرمی‌گیرد(نقطه(0، 0)))
    آزمایش.ادعای نادرستی(مستطیل(0، 0، 0، 5).دربرمی‌گیرد(نقطه(0، 1)))
    آزمایش.ادعای نادرستی(مستطیل(0، 0، 5، 0).دربرمی‌گیرد(نقطه(1، 0)))
    آزمایش.ادعای نادرستی(مستطیل(0، 0، -3، 4).دربرمی‌گیرد(نقطه(-1، 1)))
    آزمایش.ادعای درستی(مستطیل(0، 0، 0، 0).خالی است())
    آزمایش.ادعای درستی(مستطیل(0، 0، -1، 1).خالی است())
    آزمایش.ادعای نادرستی(مستطیل(0، 0، 1، 1).خالی است())
پایان

تابع test_contains_negative():
    کادر := مستطیل(-5، -2، 3، 3)
    آزمایش.ادعای درستی(کادر.دربرمی‌گیرد(نقطه(-5، -2)))
    آزمایش.ادعای درستی(کادر.دربرمی‌گیرد(نقطه(-3، 0)))
    آزمایش.ادعای نادرستی(کادر.دربرمی‌گیرد(نقطه(-2، 0)))
    آزمایش.ادعای نادرستی(کادر.دربرمی‌گیرد(نقطه(-3، 1)))
پایان

تابع test_intersects():
    اولی := مستطیل(0، 0، 4، 4)
    آزمایش.ادعای درستی(اولی.هم‌پوشانی دارد(مستطیل(3، 3، 4، 4)))
    آزمایش.ادعای درستی(اولی.هم‌پوشانی دارد(مستطیل(1، 1، 1، 1)))
    آزمایش.ادعای درستی(مستطیل(1، 1، 1، 1).هم‌پوشانی دارد(اولی))
    آزمایش.ادعای درستی(اولی.هم‌پوشانی دارد(اولی))
    آزمایش.ادعای نادرستی(اولی.هم‌پوشانی دارد(مستطیل(10، 10، 2، 2)))
پایان

تابع test_intersects_touching():
    اولی := مستطیل(0، 0، 4، 4)
    آزمایش.ادعای نادرستی(اولی.هم‌پوشانی دارد(مستطیل(4، 0، 2، 4)))
    آزمایش.ادعای نادرستی(اولی.هم‌پوشانی دارد(مستطیل(0، 4، 4، 2)))
    آزمایش.ادعای نادرستی(اولی.هم‌پوشانی دارد(مستطیل(4، 4، 1، 1)))
    آزمایش.ادعای نادرستی(مستطیل(-2، 0، 2، 4).هم‌پوشانی دارد(اولی))
پایان

تابع test_intersects_empty():
    اولی := مستطیل(0، 0، 4، 4)
    آزمایش.ادعای نادرستی(اولی.هم‌پوشانی دارد(مستطیل(1، 1، 0، 0)))
    آزمایش.ادعای نادرستی(مستطیل(1، 1، 0، 2).هم‌پوشانی دارد(اولی))
    آزمایش.ادعای نادرستی(مستطیل(1، 1، 0، 0).هم‌پوشانی دارد(مستطیل(1، 1، 0، 0)))
پایان

تابع test_intersects_negative():
    اولی := مستطیل(-4، -4، 5، 5)
    آزمایش.ادعای درستی(اولی.هم‌پوشانی دارد(مستطیل(0، 0، 3، 3)))
    آزمایش.ادعای نادرستی(اولی.هم‌پوشانی دارد(مستطیل(1، 0، 3، 3)))
پایان

تابع test_intersection():
    اشتراک := مستطیل(0، 0، 4، 4).اشتراک(مستطیل(2، 1، 5، 2))
    آزمایش.ادعای برابری عدد(اشتراک.ایکس، 2)
    آزمایش.ادعای برابری عدد(اشتراک.ایگرگ، 1)
    آزمایش.ادعای برابری عدد(اشتراک.عرض، 2)
    آزمایش.ادعای برابری عدد(اشتراک.ارتفاع، 2)
    بی‌اشتراک := مستطیل(0، 0، 4، 4).اشتراک(مستطیل(4، 0، 2، 2))
    آزمایش.ادعای درستی(بی‌اشتراک.خالی است())
پایان

تابع test_center():
    وسط := مستطیل(0، 0، 3، 3).مرکز()
    آزمایش.ادعای برابری عدد(وسط.ایکس، 1)
    آزمایش.ادعای برابری عدد(وسط.ایگرگ، 1)
    زوج := مستطیل(0، 0، 4، 4).مرکز()
    آزمایش.ادعای برابری عدد(زوج.ایکس، 2)
    آزمایش.ادعای برابری عدد(زوج.ایگرگ، 2)
    منفی := مستطیل(-6، -4، 4، 2).مرکز()
    آزمایش.ادعای برابری عدد(منفی.ایکس، -4)
    آزمایش.ادعای برابری عدد(منفی.ایگرگ، -3)
    تکی := مستطیل(7، 9، 1، 1).مرکز()
    آزمایش.ادعای برابری عدد(تکی.ایکس، 7)
    آزمایش.ادعای برابری عدد(تکی.ایگرگ، 9)
پایان

تابع test_edges():
    کادر := مستطیل(2، 3، 4، 5)
    آزمایش.ادعای برابری عدد(کادر.راست()، 6)
    آزمایش.ادعای برابری عدد(کادر.پایین()، 8)
پایان

تابع test_intersection_contained():
    درونی := مستطیل(2، 3، 4، 2)
    اشتراک := مستطیل(0، 0، 10، 10).اشتراک(درونی)
    آزمایش.ادعای برابری عدد(اشتراک.ایکس، 2)
    آزمایش.ادعای برابری عدد(اشتراک.ایگرگ، 3)
    آزمایش.ادعای برابری عدد(اشتراک.عرض، 4)
    آزمایش.ادعای برابری عدد(اشتراک.ارتفاع، 2)
پایان

تابع test_intersection_symmetry():
    اولی := مستطیل(0، 0، 4، 4)
    دومی := مستطیل(2، 1، 5، 2)
    اشتراک اول := اولی.اشتراک(دومی)
    اشتراک دوم := دومی.اشتراک(اولی)
    آزمایش.ادعای برابری عدد(اشتراک اول.ایکس، 2)
    آزمایش.ادعای برابری عدد(اشتراک اول.ایگرگ، 1)
    آزمایش.ادعای برابری عدد(اشتراک اول.عرض، 2)
    آزمایش.ادعای برابری عدد(اشتراک اول.ارتفاع، 2)
    آزمایش.ادعای برابری عدد(اشتراک اول.ایکس، اشتراک دوم.ایکس)
    آزمایش.ادعای برابری عدد(اشتراک اول.ایگرگ، اشتراک دوم.ایگرگ)
    آزمایش.ادعای برابری عدد(اشتراک اول.عرض، اشتراک دوم.عرض)
    آزمایش.ادعای برابری عدد(اشتراک اول.ارتفاع، اشتراک دوم.ارتفاع)
پایان

تابع test_intersection_negative():
    اشتراک := مستطیل(-5، -3، 4، 5).اشتراک(مستطیل(-3، -1، 4، 4))
    آزمایش.ادعای برابری عدد(اشتراک.ایکس، -3)
    آزمایش.ادعای برابری عدد(اشتراک.ایگرگ، -1)
    آزمایش.ادعای برابری عدد(اشتراک.عرض، 2)
    آزمایش.ادعای برابری عدد(اشتراک.ارتفاع، 3)
پایان

تابع test_intersection_no_overlap():
    بی‌اشتراک := مستطیل(0، 0، 4، 4).اشتراک(مستطیل(4، 0، 2، 2))
    آزمایش.ادعای برابری عدد(بی‌اشتراک.ایکس، 0)
    آزمایش.ادعای برابری عدد(بی‌اشتراک.ایگرگ، 0)
    آزمایش.ادعای برابری عدد(بی‌اشتراک.عرض، 0)
    آزمایش.ادعای برابری عدد(بی‌اشتراک.ارتفاع، 0)
    آزمایش.ادعای درستی(بی‌اشتراک.خالی است())
پایان

تابع test_edges_edge_inputs():
    منفی := مستطیل(-3، -4، 5، 2)
    آزمایش.ادعای برابری عدد(منفی.راست()، 2)
    آزمایش.ادعای برابری عدد(منفی.پایین()، -2)
    صفر := مستطیل(0، 0، 0، 0)
    آزمایش.ادعای برابری عدد(صفر.راست()، 0)
    آزمایش.ادعای برابری عدد(صفر.پایین()، 0)
    معکوس := مستطیل(2، 3، -1، -2)
    آزمایش.ادعای برابری عدد(معکوس.راست()، 1)
    آزمایش.ادعای برابری عدد(معکوس.پایین()، 1)
    پهنا := مستطیل(-5، -6، 0، 3)
    آزمایش.ادعای برابری عدد(پهنا.راست()، -5)
    آزمایش.ادعای برابری عدد(پهنا.پایین()، -3)
پایان

تابع test_is_empty():
    آزمایش.ادعای درستی(مستطیل(0، 0، 0، 5).خالی است())
    آزمایش.ادعای درستی(مستطیل(0، 0، -1، 5).خالی است())
    آزمایش.ادعای درستی(مستطیل(0، 0، 5، 0).خالی است())
    آزمایش.ادعای درستی(مستطیل(0، 0، 5، -1).خالی است())
    آزمایش.ادعای درستی(مستطیل(0، 0، -2، -2).خالی است())
    آزمایش.ادعای نادرستی(مستطیل(0، 0، 1، 1).خالی است())
پایان

تابع test_boundary_negative():
    کادر := مستطیل(-5، -2، 3، 3)
    آزمایش.ادعای درستی(کادر.دربرمی‌گیرد(نقطه(-3، -2)))
    آزمایش.ادعای نادرستی(کادر.دربرمی‌گیرد(نقطه(-2، -2)))
    آزمایش.ادعای درستی(کادر.دربرمی‌گیرد(نقطه(-5، 0)))
    آزمایش.ادعای نادرستی(کادر.دربرمی‌گیرد(نقطه(-5، 1)))
    آزمایش.ادعای درستی(کادر.هم‌پوشانی دارد(مستطیل(-3، 0، 1، 1)))
    آزمایش.ادعای نادرستی(کادر.هم‌پوشانی دارد(مستطیل(-2، 0، 1، 1)))
    آزمایش.ادعای درستی(کادر.هم‌پوشانی دارد(مستطیل(-5، 0، 1، 1)))
    آزمایش.ادعای نادرستی(کادر.هم‌پوشانی دارد(مستطیل(-5، 1، 1، 1)))
پایان

تابع ریشه:
    test_contains()
    test_contains_empty()
    test_contains_negative()
    test_intersects()
    test_intersects_touching()
    test_intersects_empty()
    test_intersects_negative()
    test_intersection()
    test_center()
    test_edges()
    test_intersection_contained()
    test_intersection_symmetry()
    test_intersection_negative()
    test_intersection_no_overlap()
    test_edges_edge_inputs()
    test_is_empty()
    test_boundary_negative()
    برگشت آزمایش.خلاصه()
پایان
