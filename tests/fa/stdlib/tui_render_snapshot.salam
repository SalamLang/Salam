واردسازی رشته
واردسازی آزمایش
واردسازی رابط‌پایانه

شناسه ذخیره := 3
شناسه شکستن := 4

ساختار متن‌وارون:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی متن: رشته = ""

    همگانی تابع ترسیم(بافر: رابط‌پایانه.بافر، مرز: رابط‌پایانه.مستطیل):
        ناپایا ظاهر := رابط‌پایانه.ظاهر {}
        ظاهر.معکوس = درست
        بافر.نوشتن متن(مرز.ایکس، مرز.ایگرگ، این.متن، ظاهر)
    پایان
پایان

تابع مستطیل(ایکس: صحیح، ایگرگ: صحیح، پهنا: صحیح، بلندا: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = ایکس، ایگرگ = ایگرگ، عرض = پهنا، ارتفاع = بلندا }
پایان

تابع قاب(ص: رابط‌پایانه.صفحه): رشته:
    ناپایا خروجی := ""
    تکرار ص.بافر.ارتفاع در ایگرگ:
        اگر ایگرگ بزرگتر 0:
            خروجی += "|"
        پایان
        خروجی += ص.بافر.متن ردیف(ایگرگ)
    پایان
    برگشت خروجی
پایان

تابع صحنه(): رابط‌پایانه.صفحه:
    ناپایا ص := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 24، 6)
    عنوان := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.متن جدید("باسلام") برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(عنوان).تنظیم محدوده(مستطیل(1، 0، 10، 1))
    خط جدا := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.جداکننده جدید() برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(خط جدا).تنظیم محدوده(مستطیل(1، 1، 20، 1))
    ذخیره := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.دکمه جدید("ثبت") برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(ذخیره).تنظیم محدوده(مستطیل(1، 2، 10، 1))
    شکستن := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.کادر انتخاب جدید("شکستن"، درست) برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(شکستن).تنظیم محدوده(مستطیل(12، 2، 10، 1))
    ناپایا نوار := رابط‌پایانه.نوار پیشرفت جدید()
    نوار.تنظیم پیشرفت(40)
    بارگذاری := ص.افزودن(رابط‌پایانه.شناسه ریشه، نوار برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(بارگذاری).تنظیم محدوده(مستطیل(1، 3، 20، 1))
    وضعیت := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.متن جدید("آماده") برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(وضعیت).تنظیم محدوده(مستطیل(1، 4، 20، 1))
    برگشت ص
پایان

تابع test_scene_frame_is_a_snapshot():
    ناپایا ص := صحنه()
    دیرکن ص.بستن()
    آزمایش.ادعای درستی(ص.تمرکز(شناسه ذخیره))
    آزمایش.ادعای برابری عدد(ص.شناسه متمرکز()، شناسه ذخیره)
    ص.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(قاب(ص)، " باسلام                 | ────────────────────   | [  ثبت   ] [x] شکستن   | ######---------  40%   | آماده                  |                        ")
پایان

تابع test_focus_changes_only_styles():
    ناپایا ص := صحنه()
    دیرکن ص.بستن()
    آزمایش.ادعای درستی(ص.تمرکز(شناسه ذخیره))
    ص.نمایش تغییرات()
    پیشین := قاب(ص)
    ظاهر ذخیره := ص.بافر.بگیر(1، 2).ظاهر
    ظاهر شکستن := ص.بافر.بگیر(12، 2).ظاهر
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(ظاهر ذخیره، رابط‌پایانه.ظاهر پیش‌فرض))

    آزمایش.ادعای درستی(ص.تمرکز بعدی())
    آزمایش.ادعای برابری عدد(ص.شناسه متمرکز()، شناسه شکستن)
    ص.نمایش تغییرات()
    آزمایش.ادعای برابری رشته(قاب(ص)، پیشین)
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(ص.بافر.بگیر(1، 2).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(ص.بافر.بگیر(12، 2).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(ظاهر ذخیره، ص.بافر.بگیر(1، 2).ظاهر))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(ظاهر شکستن، ص.بافر.بگیر(12، 2).ظاهر))
پایان

تابع test_clipped_widget_frame():
    ناپایا ص := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 12، 2)
    دیرکن ص.بستن()
    شناسه := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.متن جدید("ابپتثجچحخدذرزژسش") برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(شناسه).تنظیم محدوده(مستطیل(0، 0، 30، 1))
    ص.نمایش تغییرات()

    آزمایش.ادعای برابری عدد(رشته.شمارنویسه(ص.بافر.متن ردیف(0))، ص.بافر.عرض)
    آزمایش.ادعای برابری عدد(رشته.شمارنویسه(ص.بافر.متن ردیف(1))، ص.بافر.عرض)
    آزمایش.ادعای برابری رشته(قاب(ص)، "ابپتثجچحخدذر|            ")
پایان

تابع test_ansi_frame_snapshot():
    ناپایا ص := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 8، 2)
    دیرکن ص.بستن()
    ناپایا خب := رابط‌پایانه.متن جدید("خب")
    خب.تنظیم ظاهر(رابط‌پایانه.ظاهر { پررنگ = درست })
    شناسه خب := ص.افزودن(رابط‌پایانه.شناسه ریشه، خب برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(شناسه خب).تنظیم محدوده(مستطیل(0، 0، 2، 1))
    شناسه نه := ص.افزودن(رابط‌پایانه.شناسه ریشه، متن‌وارون { متن = "نه" } برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(شناسه نه).تنظیم محدوده(مستطیل(4، 0، 2، 1))
    ص.نمایش تغییرات()

    آزمایش.ادعای برابری رشته(ص.بافر.خروجی کامل انسی()، "\x1b[1;1H\x1b[1mخب\x1b[22m  \x1b[7mنه\x1b[27m  \x1b[2;1H        ")
پایان

تابع ریشه:
    test_scene_frame_is_a_snapshot()
    test_focus_changes_only_styles()
    test_clipped_widget_frame()
    test_ansi_frame_snapshot()
    برگشت آزمایش.خلاصه()
پایان
