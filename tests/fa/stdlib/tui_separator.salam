واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع key(seq: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(seq) }
پایان

تابع draw(s: رابط‌پایانه.جداکننده، w: صحیح، h: صحیح): رابط‌پایانه.بافر:
    b := رابط‌پایانه.بافر جدید(w، h)
    b.پرکردن(rect(0، 0، w، h)، "x"، رابط‌پایانه.ظاهر پیش‌فرض)
    s.ترسیم(b، rect(0، 0، w، h))
    برگشت b
پایان

تابع test_horizontal_paint():
    s := رابط‌پایانه.جداکننده جدید()

    a := draw(s، 8، 1)
    دیرکن a.آزادکن()
    آزمایش.ادعای برابری رشته(a.متن ردیف(0)، "────────")

    b := draw(s، 8، 3)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "────────")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "xxxxxxxx")
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، "xxxxxxxx")
پایان

تابع test_vertical_paint():
    ناپایا s := رابط‌پایانه.جداکننده جدید()
    s.تنظیم جهت‌گیری(رابط‌پایانه.جهت‌گیری.Vertical)

    a := draw(s، 1، 4)
    دیرکن a.آزادکن()
    آزمایش.ادعای برابری رشته(a.بگیر(0، 0).نویسه، "│")
    آزمایش.ادعای برابری رشته(a.بگیر(0، 1).نویسه، "│")
    آزمایش.ادعای برابری رشته(a.بگیر(0، 2).نویسه، "│")
    آزمایش.ادعای برابری رشته(a.بگیر(0، 3).نویسه، "│")

    b := draw(s، 3، 3)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "│xx")
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "│xx")
    آزمایش.ادعای برابری رشته(b.متن ردیف(2)، "│xx")
پایان

تابع test_single_cell():
    h := رابط‌پایانه.جداکننده جدید()
    a := draw(h، 1، 1)
    دیرکن a.آزادکن()
    آزمایش.ادعای برابری رشته(a.متن ردیف(0)، "─")

    ناپایا v := رابط‌پایانه.جداکننده جدید()
    v.تنظیم جهت‌گیری(رابط‌پایانه.جهت‌گیری.Vertical)
    b := draw(v، 1، 1)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "│")
پایان

تابع test_custom_rune():
    ناپایا s := رابط‌پایانه.جداکننده جدید()
    آزمایش.ادعای درستی(s.تنظیم نویسه("="))
    a := draw(s، 5، 1)
    دیرکن a.آزادکن()
    آزمایش.ادعای برابری رشته(a.متن ردیف(0)، "=====")
پایان

تابع test_set_ch_rejects_wide():
    ناپایا s := رابط‌پایانه.جداکننده جدید()
    آزمایش.ادعای نادرستی(s.تنظیم نویسه("中"))
    a := draw(s، 4، 1)
    دیرکن a.آزادکن()
    آزمایش.ادعای برابری رشته(a.متن ردیف(0)، "────")

    آزمایش.ادعای درستی(s.تنظیم نویسه("-"))
    b := draw(s، 4، 1)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "----")
پایان

تابع test_set_ch_rejects_zero_width_keeps_previous():
    ناپایا s := رابط‌پایانه.جداکننده جدید()
    آزمایش.ادعای درستی(s.تنظیم نویسه("="))
    آزمایش.ادعای نادرستی(s.تنظیم نویسه("​"))
    a := draw(s، 3، 1)
    دیرکن a.آزادکن()
    آزمایش.ادعای برابری رشته(a.متن ردیف(0)، "===")

    آزمایش.ادعای درستی(s.تنظیم نویسه(""))
    b := draw(s، 3، 1)
    دیرکن b.آزادکن()
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "───")
پایان

تابع test_zero_length_paints_nothing():
    s := رابط‌پایانه.جداکننده جدید()
    b := رابط‌پایانه.بافر جدید(4، 1)
    دیرکن b.آزادسازی()
    b.پرکردن(rect(0، 0، 4، 1)، "x"، رابط‌پایانه.ظاهر پیش‌فرض)
    before := b.متن ردیف(0)
    s.ترسیم(b، rect(0، 0، 0، 1))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، before)
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "xxxx")
پایان

تابع test_style_fg_and_bg():
    ناپایا s := رابط‌پایانه.جداکننده جدید()
    st := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز، رنگ پس‌زمینه = رابط‌پایانه.رنگ.Ansi(4) }
    s.تنظیم ظاهر(st)

    b := رابط‌پایانه.بافر جدید(6، 3)
    دیرکن b.آزادسازی()
    b.پرکردن(rect(0، 0، 6، 3)، "x"، رابط‌پایانه.ظاهر پیش‌فرض)
    s.ترسیم(b، rect(0، 0، 3، 3))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، st))
    آزمایش.ادعای برابری رشته(b.دریافت(0، 0).نویسه، "─")

    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(1، 1).ظاهر، رابط‌پایانه.ظاهر { رنگ پس‌زمینه = رابط‌پایانه.رنگ.Ansi(4) }))
    آزمایش.ادعای برابری رشته(b.دریافت(1، 1).نویسه، " ")

    آزمایش.ادعای برابری رشته(b.دریافت(4، 0).نویسه، "x")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(4، 0).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
پایان

تابع test_style_fg_without_bg_leaves_off_line_cells():
    ناپایا s := رابط‌پایانه.جداکننده جدید()
    s.تنظیم ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز })
    b := رابط‌پایانه.بافر جدید(4، 3)
    دیرکن b.آزادسازی()
    b.پرکردن(rect(0، 0، 4، 3)، "x"، رابط‌پایانه.ظاهر پیش‌فرض)
    s.ترسیم(b، rect(0، 0، 4، 3))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 0).ظاهر، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز }))
    آزمایش.ادعای برابری رشته(b.متن ردیف(1)، "xxxx")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(b.دریافت(0، 1).ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
پایان

تابع test_style_bytes_at_emission():
    ناپایا s := رابط‌پایانه.جداکننده جدید()
    s.تنظیم ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز، رنگ پس‌زمینه = رابط‌پایانه.رنگ.Ansi(4) })
    b := رابط‌پایانه.بافر جدید(6، 3)
    دیرکن b.آزادسازی()

    before := رابط‌پایانه.شمار ساخت اس‌جی‌آر()
    s.ترسیم(b، rect(0، 0، 6، 3))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 0)
    _ := b.خروجی کامل انسی()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - before، 4)

    ناپایا u := رابط‌پایانه.جداکننده جدید()
    u.تنظیم ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.قرمز })
    ub := رابط‌پایانه.بافر جدید(4، 3)
    دیرکن ub.آزادسازی()
    first := رابط‌پایانه.شمار ساخت اس‌جی‌آر()
    u.ترسیم(ub، rect(0، 0، 4، 3))
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - first، 0)
    _ := ub.خروجی کامل انسی()
    آزمایش.ادعای برابری عدد(رابط‌پایانه.شمار ساخت اس‌جی‌آر() - first، 2)
پایان

تابع test_predicates():
    ناپایا s := رابط‌پایانه.جداکننده جدید()
    آزمایش.ادعای نادرستی(s.تمرکز‌پذیر است())
    آزمایش.ادعای نادرستی(s.اصابت‌پذیر است())
    آزمایش.ادعای نادرستی(s.پردازش رویداد(key("q")))
    s.تنظیم جهت‌گیری(رابط‌پایانه.جهت‌گیری.Vertical)
    آزمایش.ادعای نادرستی(s.تمرکز‌پذیر است())
    آزمایش.ادعای نادرستی(s.اصابت‌پذیر است())
    آزمایش.ادعای نادرستی(s.پردازش رویداد(key("q")))
پایان

تابع test_defaults():
    s := رابط‌پایانه.جداکننده جدید()
    آزمایش.ادعای درستی(s.جهت‌گیری برابر رابط‌پایانه.جهت‌گیری.Horizontal)
    آزمایش.ادعای برابری رشته(s.نویسه، "")
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(s.ظاهر، رابط‌پایانه.ظاهر پیش‌فرض))
پایان

تابع test_preferred_size_and_measure():
    h := رابط‌پایانه.جداکننده جدید()
    hp := h.اندازه ترجیحی(10)
    آزمایش.ادعای برابری عدد(hp.عرض، -1)
    آزمایش.ادعای برابری عدد(hp.ارتفاع، 1)

    ناپایا v := رابط‌پایانه.جداکننده جدید()
    v.تنظیم جهت‌گیری(رابط‌پایانه.جهت‌گیری.Vertical)
    vp := v.اندازه ترجیحی(10)
    آزمایش.ادعای برابری عدد(vp.عرض، 1)
    آزمایش.ادعای برابری عدد(vp.ارتفاع، -1)

    hx := h.اندازه‌گیری(رابط‌پایانه.محور.X، 10)
    آزمایش.ادعای درستی(hx.معتبر)
    آزمایش.ادعای برابری عدد(hx.گستره، 10)
    hy := h.اندازه‌گیری(رابط‌پایانه.محور.Y، 10)
    آزمایش.ادعای درستی(hy.معتبر)
    آزمایش.ادعای برابری عدد(hy.گستره، 1)

    vx := v.اندازه‌گیری(رابط‌پایانه.محور.X، 10)
    آزمایش.ادعای درستی(vx.معتبر)
    آزمایش.ادعای برابری عدد(vx.گستره، 1)
    vy := v.اندازه‌گیری(رابط‌پایانه.محور.Y، 10)
    آزمایش.ادعای درستی(vy.معتبر)
    آزمایش.ادعای برابری عدد(vy.گستره، 10)
پایان

تابع test_ascii_policy_rune():
    ناپایا b := رابط‌پایانه.بافر جدید(3، 1)
    b.نویسه‌ها = رابط‌پایانه.سیاست‌نویسه‌ها.ASCII
    رابط‌پایانه.جداکننده جدید().ترسیم(b، rect(0، 0، 3، 1))
    آزمایش.ادعای برابری رشته(b.متن ردیف(0)، "---")
    b.آزادسازی()
    ناپایا v := رابط‌پایانه.جداکننده جدید()
    v.تنظیم جهت‌گیری(رابط‌پایانه.جهت‌گیری.Vertical)
    ناپایا bv := رابط‌پایانه.بافر جدید(1، 2)
    bv.نویسه‌ها = رابط‌پایانه.سیاست‌نویسه‌ها.ASCII
    v.ترسیم(bv، rect(0، 0، 1، 2))
    آزمایش.ادعای برابری رشته(bv.متن ردیف(0) + bv.متن ردیف(1)، "||")
    bv.آزادسازی()
    ناپایا c := رابط‌پایانه.جداکننده جدید()
    آزمایش.ادعای درستی(c.تنظیم نویسه("="))
    ناپایا bc := رابط‌پایانه.بافر جدید(2، 1)
    bc.نویسه‌ها = رابط‌پایانه.سیاست‌نویسه‌ها.ASCII
    c.ترسیم(bc، rect(0، 0، 2، 1))
    آزمایش.ادعای برابری رشته(bc.متن ردیف(0)، "==")
    bc.آزادسازی()
    آزمایش.ادعای درستی(c.تنظیم نویسه("\u2550"))
    ناپایا bd := رابط‌پایانه.بافر جدید(2، 1)
    bd.نویسه‌ها = رابط‌پایانه.سیاست‌نویسه‌ها.ASCII
    c.ترسیم(bd، rect(0، 0، 2، 1))
    آزمایش.ادعای برابری رشته(bd.متن ردیف(0)، "--")
    bd.آزادسازی()
پایان

تابع ریشه:
    test_horizontal_paint()
    test_vertical_paint()
    test_single_cell()
    test_custom_rune()
    test_set_ch_rejects_wide()
    test_set_ch_rejects_zero_width_keeps_previous()
    test_zero_length_paints_nothing()
    test_style_fg_and_bg()
    test_style_fg_without_bg_leaves_off_line_cells()
    test_style_bytes_at_emission()
    test_predicates()
    test_defaults()
    test_preferred_size_and_measure()
    test_ascii_policy_rune()
    برگشت آزمایش.خلاصه()
پایان
