    attrs := پایانه.دنباله نمایش(پایانه.سبک زیرخط) + پایانه.دنباله پیش‌زمینه۲۵۶(208) + پایانه.دنباله پس‌زمینه۲۵۶(237)
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.Indexed256)، attrs)
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.Indexed256)، پایانه.دنباله نمایش(24) + پایانه.دنباله نمایش(پایانه.پیش‌زمینه پیش‌فرض) + پایانه.دنباله نمایش(پایانه.پس‌زمینه پیش‌فرض))
پایان

تابع test_sgr_colors_ansi16():
    s := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Rgb(255، 135، 0)، رنگ پس‌زمینه = رابط‌پایانه.رنگ.Indexed(237)، زیرخط = درست }
    attrs := پایانه.دنباله نمایش(پایانه.سبک زیرخط) + پایانه.دنباله نمایش(پایانه.پیش‌زمینه زرد) + پایانه.دنباله نمایش(پایانه.پس‌زمینه سیاه)
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.Ansi16)، attrs)
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.Ansi16)، پایانه.دنباله نمایش(24) + پایانه.دنباله نمایش(پایانه.پیش‌زمینه پیش‌فرض) + پایانه.دنباله نمایش(پایانه.پس‌زمینه پیش‌فرض))
