تابع test_sgr_fg_bold_truecolor():
    s := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(2)، پررنگ = درست }
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.TrueColor)، پایانه.دنباله نمایش(پایانه.سبک ضخیم) + پایانه.دنباله نمایش(پایانه.پیش‌زمینه سبز))
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.TrueColor)، پایانه.دنباله نمایش(22) + پایانه.دنباله نمایش(پایانه.پیش‌زمینه پیش‌فرض))
پایان

تابع test_sgr_all_attrs():
    s := رابط‌پایانه.ظاهر { پررنگ = درست، کم‌رنگ = درست، کج = درست، زیرخط = درست، معکوس = درست }
    attrs := پایانه.دنباله نمایش(پایانه.سبک ضخیم) + پایانه.دنباله نمایش(پایانه.سبک کم‌رنگ) + پایانه.دنباله نمایش(پایانه.سبک کج) + پایانه.دنباله نمایش(پایانه.سبک زیرخط) + پایانه.دنباله نمایش(پایانه.سبک برعکس)
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.Off)، attrs)
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.TrueColor)، attrs)
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.TrueColor)، پایانه.دنباله نمایش(22) + پایانه.دنباله نمایش(23) + پایانه.دنباله نمایش(24) + پایانه.دنباله نمایش(27))
پایان

تابع test_sgr_colors_truecolor():
    s := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Rgb(255، 135، 0)، رنگ پس‌زمینه = رابط‌پایانه.رنگ.Indexed(237)، زیرخط = درست }
    attrs := پایانه.دنباله نمایش(پایانه.سبک زیرخط) + پایانه.دنباله پیش‌زمینه آراگابی(255، 135، 0) + پایانه.دنباله پس‌زمینه۲۵۶(237)
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.TrueColor)، attrs)
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(s، رابط‌پایانه.سطح‌رنگ.TrueColor)، پایانه.دنباله نمایش(24) + پایانه.دنباله نمایش(پایانه.پیش‌زمینه پیش‌فرض) + پایانه.دنباله نمایش(پایانه.پس‌زمینه پیش‌فرض))
پایان

تابع test_sgr_colors_indexed256():
