تابع test_eq_false():
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر { پررنگ = درست }، رابط‌پایانه.ظاهر {}))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر { کم‌رنگ = درست }، رابط‌پایانه.ظاهر { پررنگ = درست }))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(1) }، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Indexed(1) }))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Rgb(255، 0، 0) }، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Indexed(196) }))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(1) }، رابط‌پایانه.ظاهر {}))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر { معکوس = درست }، رابط‌پایانه.ظاهر پیش‌فرض))
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر { پررنگ = درست، معکوس = درست }، رابط‌پایانه.ظاهر { پررنگ = درست }))
پایان

تابع test_eq_merge_results():
    m1 := رابط‌پایانه.ادغام ظاهر(رابط‌پایانه.ظاهر { پررنگ = درست }، رابط‌پایانه.ظاهر {})
    m2 := رابط‌پایانه.ادغام ظاهر(رابط‌پایانه.ظاهر {}، رابط‌پایانه.ظاهر { پررنگ = درست })
    آزمایش.ادعای نادرستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر {}، m1))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(m1، m2))
