تابع test_merge_m8():
    child := رابط‌پایانه.ظاهر { رنگ پس‌زمینه = رابط‌پایانه.رنگ.Ansi(4)، زیرخط = درست }
    got := رابط‌پایانه.ادغام ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، child)
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(got، child))
پایان

تابع test_merge_m9_not_commutative():
    parent := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(1) }
    child := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(2) }
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ادغام ظاهر(parent، child)، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(2) }))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ادغام ظاهر(child، parent)، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(1) }))
پایان

تابع test_merge_reverse():
    got := رابط‌پایانه.ادغام ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.ظاهر { معکوس = درست })
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(got، رابط‌پایانه.ظاهر { معکوس = درست }))
    mixed := رابط‌پایانه.ادغام ظاهر(رابط‌پایانه.ظاهر { معکوس = درست }، رابط‌پایانه.ظاهر { پررنگ = درست })
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(mixed، رابط‌پایانه.ظاهر { پررنگ = درست، معکوس = درست }))
پایان

تابع test_merge_identity():
    s := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(2)، رنگ پس‌زمینه = رابط‌پایانه.رنگ.Indexed(237)، پررنگ = درست }
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ادغام ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، s)، s))
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ادغام ظاهر(s، رابط‌پایانه.ظاهر پیش‌فرض)، s))
پایان

تابع test_merge_m7_emits_bold_then_dim():
    got := رابط‌پایانه.ادغام ظاهر(رابط‌پایانه.ظاهر { کم‌رنگ = درست }، رابط‌پایانه.ظاهر { پررنگ = درست })
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(got، رابط‌پایانه.سطح‌رنگ.TrueColor)، پایانه.دنباله نمایش(پایانه.سبک ضخیم) + پایانه.دنباله نمایش(پایانه.سبک کم‌رنگ))
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(got، رابط‌پایانه.سطح‌رنگ.TrueColor)، پایانه.دنباله نمایش(22))
پایان

تابع test_default_emits_nothing_at_every_tier():
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.سطح‌رنگ.Off)، "")
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.سطح‌رنگ.Ansi16)، "")
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.سطح‌رنگ.Indexed256)، "")
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله فعال‌سازی ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.سطح‌رنگ.TrueColor)، "")
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.سطح‌رنگ.Off)، "")
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.سطح‌رنگ.Ansi16)، "")
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.سطح‌رنگ.Indexed256)، "")
    آزمایش.ادعای برابری رشته(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.سطح‌رنگ.TrueColor)، "")
