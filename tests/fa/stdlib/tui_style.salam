تابع test_default_fields():
    s := رابط‌پایانه.ظاهر {}
    آزمایش.ادعای درستی(s.رنگ پیش‌زمینه برابر رابط‌پایانه.رنگ.Default)
    آزمایش.ادعای درستی(s.رنگ پس‌زمینه برابر رابط‌پایانه.رنگ.Default)
    آزمایش.ادعای نادرستی(s.پررنگ)
    آزمایش.ادعای نادرستی(s.کم‌رنگ)
    آزمایش.ادعای نادرستی(s.کج)
    آزمایش.ادعای نادرستی(s.زیرخط)
    آزمایش.ادعای نادرستی(s.معکوس)
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(s، رابط‌پایانه.ظاهر پیش‌فرض))
پایان

تابع test_partial_literal():
