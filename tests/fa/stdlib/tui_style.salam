تابع test_eq_true():
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر {}، رابط‌پایانه.ظاهر پیش‌فرض))
    a := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(1)، پررنگ = درست }
    b := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(1)، پررنگ = درست }
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(a، b))
