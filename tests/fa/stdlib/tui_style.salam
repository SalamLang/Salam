تابع test_merge_m1():
    got := رابط‌پایانه.ادغام ظاهر(رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(2) }، رابط‌پایانه.ظاهر {})
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(got، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(2) }))
پایان

تابع test_merge_m2():
