تابع test_merge_m3():
    parent := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Ansi(2)، رنگ پس‌زمینه = رابط‌پایانه.رنگ.Indexed(237) }
    got := رابط‌پایانه.ادغام ظاهر(parent، رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Rgb(255، 135، 0) })
    want := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.رنگ.Rgb(255، 135، 0)، رنگ پس‌زمینه = رابط‌پایانه.رنگ.Indexed(237) }
    آزمایش.ادعای درستی(رابط‌پایانه.برابری ظاهر(got، want))
پایان

