واردسازی آزمایش
واردسازی پایانه
واردسازی رابط‌پایانه

ساختار Button:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی label: رشته = ""
    همگانی presses: صحیح = 0

    همگانی تابع focusable(): منطقی:
        برگشت درست
    پایان

    همگانی تابع handle_event(event: رابط‌پایانه.رویداد): منطقی:
        اگر event.نوع برابر رابط‌پایانه.رویداد کیبورد و event.کلید.کد برابر پایانه.کلید ورود:
            این.presses++
            برگشت درست
        پایان
        برگشت نادرست
    پایان

    همگانی تابع render(buf: رابط‌پایانه.بافر، bounds: رابط‌پایانه.مستطیل):
        buf.نوشتن متن(bounds.ایکس، bounds.ایگرگ، "[" + این.label + "]"، رابط‌پایانه.ظاهر پیش‌فرض)
    پایان
پایان

ساختار List:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی items: وکتور<رشته> = وکتور {}

    همگانی تابع render(buf: رابط‌پایانه.بافر، bounds: رابط‌پایانه.مستطیل):
        تکرار این.items.طول() در i:
            buf.نوشتن متن(bounds.ایکس، bounds.ایگرگ + i، این.items.دریافت(i)، رابط‌پایانه.ظاهر پیش‌فرض)
        پایان
    پایان
پایان

تابع rect(x: صحیح، y: صحیح، w: صحیح، h: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = x، ایگرگ = y، عرض = w، ارتفاع = h }
پایان

تابع enter(): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = پایانه.کلید ورود } }
پایان

تابع test_base_defaults():
    ناپایا b := رابط‌پایانه.ویجت‌پایه {}
    آزمایش.ادعای نادرستی(b.تمرکز‌پذیر است())
    آزمایش.ادعای نادرستی(b.پردازش رویداد(enter()))
    آزمایش.ادعای درستی(b.محدوده().خالی است())
    b.تنظیم محدوده(rect(1، 2، 3، 4))
    آزمایش.ادعای برابری عدد(b.محدوده().ایکس، 1)
    آزمایش.ادعای برابری عدد(b.محدوده().ارتفاع، 4)
    ناپایا buf := رابط‌پایانه.بافر جدید(4، 1)
    b.ترسیم(buf، b.محدوده())
    آزمایش.ادعای برابری رشته(buf.متن ردیف(0)، "    ")
    buf.آزادسازی()
پایان

تابع test_override_through_embedding():
    ناپایا btn := Button { label = "ok" }
    آزمایش.ادعای درستی(btn.focusable())
    btn.تنظیم محدوده(rect(0، 0، 4، 1))
    آزمایش.ادعای برابری عدد(btn.محدوده().عرض، 4)
    آزمایش.ادعای درستی(btn.handle_event(enter()))
    آزمایش.ادعای نادرستی(btn.handle_event(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تیک }))
    آزمایش.ادعای برابری عدد(btn.presses، 1)
پایان

تابع test_polymorphism():
    ناپایا items := وکتور {} برگردان وکتور<رشته>
    items.افزودن("one")
    items.افزودن("two")
    ناپایا ws := وکتور {} برگردان وکتور<پویا رابط‌پایانه.ویجت>
    ws.افزودن(Button { label = "go" })
    ws.افزودن(List { items = items })
    ws.افزودن(رابط‌پایانه.ویجت‌پایه {})

    ws.دریافت(0).تنظیم محدوده(rect(0، 0، 4، 1))
    ws.دریافت(1).تنظیم محدوده(rect(5، 0، 3، 2))
    ws.دریافت(2).تنظیم محدوده(rect(0، 1، 2، 1))

    آزمایش.ادعای برابری عدد(ws.دریافت(1).محدوده().ایکس، 5)

    آزمایش.ادعای درستی(ws.دریافت(0).تمرکز‌پذیر است())
    آزمایش.ادعای نادرستی(ws.دریافت(1).تمرکز‌پذیر است())
    آزمایش.ادعای نادرستی(ws.دریافت(2).تمرکز‌پذیر است())

    ناپایا buf := رابط‌پایانه.بافر جدید(8، 2)
    هر w در ws:
        w.ترسیم(buf، w.محدوده())
    پایان
    آزمایش.ادعای برابری رشته(buf.متن ردیف(0)، "[go] one")
    آزمایش.ادعای برابری رشته(buf.متن ردیف(1)، "     two")
    buf.آزادسازی()
    items.آزادسازی()
    ws.آزادسازی()
پایان

تابع test_state_persists_through_interface():
    w := Button { label = "x" } برگردان پویا رابط‌پایانه.ویجت
    آزمایش.ادعای درستی(w.پردازش رویداد(enter()))
    آزمایش.ادعای درستی(w.پردازش رویداد(enter()))
    copy := w
    آزمایش.ادعای درستی(copy.پردازش رویداد(enter()))
    ناپایا buf := رابط‌پایانه.بافر جدید(3، 1)
    w.ترسیم(buf، rect(0، 0، 3، 1))
    آزمایش.ادعای برابری رشته(buf.متن ردیف(0)، "[x]")
    buf.آزادسازی()
پایان

تابع ریشه:
    test_base_defaults()
    test_override_through_embedding()
    test_polymorphism()
    test_state_persists_through_interface()
    برگشت آزمایش.خلاصه()
پایان
