بسته ریشه

واردسازی شبکه.تونل
واردسازی شبکه.تی سی پی
واردسازی کدگذاری.جیسون

ناپایا failures := 0
ناپایا echo_server := تی سی پی.سرور {}

ساختار TaggedMaker:
    همگانی unused: صحیح = 0

    همگانی تابع Protocol(): رشته:
        برگشت "tagged"
    پایان

    همگانی تابع Make(_cfg: تونل.پیکربندی خروجی): پویا تونل.شماره‌گیر:
        برگشت تونل.مسدود()
    پایان
پایان

ساختار LoopbackMaker:
    همگانی unused: صحیح = 0

    همگانی تابع Protocol(): رشته:
        برگشت "loopback"
    پایان

    همگانی تابع Make(_cfg: تونل.پیکربندی خروجی): پویا تونل.شماره‌گیر:
        برگشت تونل.مستقیم()
    پایان
پایان

ساختار SilentInbound:
    همگانی unused: صحیح = 0

    همگانی تابع Protocol(): رشته:
        برگشت "silent"
    پایان

    همگانی تابع Make(_cfg: تونل.پیکربندی درون‌سو): پویا تونل.پذیرنده:
        برگشت تونل.پروتکل خالی {}
    پایان
پایان

تابع expect(label: رشته، ok: منطقی):
    اگر وارونه ok:
        سرچاپ "FAIL"، label
        failures++
    پایان
پایان

تابع echo_once():
    c := تی سی پی.پذیرش(echo_server)
    data := تی سی پی.خواندن(c، 64)
    تی سی پی.نوشتن(c، "echo:" + data)
    تی سی پی.بستن(c)
پایان

تابع ریشه:
    sample := `{
  "log": {"loglevel": "info"},
  "inbounds": [
    {"tag": "mixed-in", "listen": "127.0.0.1", "port": 10808, "protocol": "mixed", "settings": {"udp": true}},
    {"tag": "http-in", "port": "10809", "protocol": "http"}
  ],
  "outbounds": [
    {"tag": "proxy", "protocol": "vless", "settings": {"vnext": [{"address": "v.example.com", "port": 443, "users": [{"id": "b831381d-6324-4d53-ad4f-8cda48b30811", "encryption": "none", "flow": "xtls-rprx-vision"}]}]}, "streamSettings": {"network": "tcp", "security": "reality", "realitySettings": {"serverName": "www.microsoft.com", "fingerprint": "chrome", "publicKey": "AbCdEf-xyz_123", "shortId": "6ba85179e30d4fc2", "spiderX": "/"}}},
    {"tag": "direct", "protocol": "freedom"},
    {"tag": "block", "protocol": "blackhole"}
  ],
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {"type": "field", "domain": ["domain:ir", "full:exact.example.com", "keyword:bank"], "outboundTag": "direct"},
      {"type": "field", "ip": ["geoip:private", "203.0.113.0/24"], "outboundTag": "direct"},
      {"type": "field", "port": "25,465", "outboundTag": "block"}
    ]
  }
}`
    c := تونل.تجزیه پیکربندی(sample)
    سرچاپ c.خطاها.طول()، c.سطح گزارش، c.درون‌سوها.طول()، c.خروجی‌ها.طول()، c.قاعده‌ها.طول()، c.خروجی پیش‌فرض
    سرچاپ c.درون‌سوها[0].برچسب، c.درون‌سوها[0].درگاه، c.درون‌سوها[0].تنظیمات، c.درون‌سوها[1].درگاه، c.درون‌سوها[1].نشانی شنود
    سرچاپ c.خروجی‌ها[1].پروتکل، c.قاعده‌ها[0].دامنه‌ها.طول()، c.قاعده‌ها[1].آی‌پی‌ها[1]، c.قاعده‌ها[2].درگاه، c.قاعده‌ها[2].برچسب خروجی
    errs := تونل.اعتبارسنجی پیکربندی(c)
    سرچاپ "validate"، errs.طول()

    text := تونل.پیکربندی به جیسون(c)
    سرچاپ جیسون.معتبر(text)
    c2 := تونل.تجزیه پیکربندی(text)
    سرچاپ "round trip"، تونل.پیکربندی به جیسون(c2) برابر text، تونل.اعتبارسنجی پیکربندی(c2).طول()

    rt := تونل.ساخت مسیریاب(c)
    سرچاپ rt.تطبیق میزبان("divar.ir"، 443)، rt.تطبیق میزبان("my-bank.example.com"، 443)، rt.تطبیق میزبان("exact.example.com"، 443)، rt.تطبیق میزبان("sub.exact.example.com"، 443)، rt.تطبیق میزبان("10.1.1.1"، 80)، rt.تطبیق میزبان("203.0.113.5"، 80)، rt.تطبیق میزبان("mail.example.com"، 25)، rt.تطبیق میزبان("mail.example.com"، 587)

    n := تونل.گره از خروجی(c.خروجی‌ها[0])
    سرچاپ n.معتبر، n.پروتکل، n.میزبان، n.درگاه، n.شناسه، n.جریان، n.امنیت، n.نام سرور، n.کلید عمومی، n.شناسه کوتاه، n.مسیر عنکبوتی، n.شبکه
    سرچاپ تونل.گره به لینک(n)
    back := تونل.خروجی از گره(n، "proxy")
    سرچاپ جیسون.فشرده سازی(back.تنظیمات) برابر جیسون.فشرده سازی(c.خروجی‌ها[0].تنظیمات)، جیسون.فشرده سازی(back.تنظیمات جریان) برابر جیسون.فشرده سازی(c.خروجی‌ها[0].تنظیمات جریان)

    links := ["vmess://" + "eyJ2IjoiMiIsInBzIjoidm0iLCJhZGQiOiJ2bS5leGFtcGxlLmNvbSIsInBvcnQiOiI0NDMiLCJpZCI6IjExMTExMTExLTIyMjItMzMzMy00NDQ0LTU1NTU1NTU1NTU1NSIsImFpZCI6IjAiLCJzY3kiOiJhdXRvIiwibmV0Ijoid3MiLCJob3N0IjoiYS5jb20iLCJwYXRoIjoiL3AiLCJ0bHMiOiJ0bHMiLCJzbmkiOiJhLmNvbSJ9"، "trojan://pw%21@t.example.com:443?security=tls&sni=t.example.com&type=grpc&serviceName=svc#t"، "ss://YWVzLTI1Ni1nY206cGFzcw@s.example.com:8388#s"، "vless://11111111-2222-3333-4444-555555555555@w.example.com:443?security=tls&type=ws&host=w.example.com&path=%2Fw&sni=w.example.com&allowInsecure=1&alpn=h2#w"]
    هر l در links:
        a := تونل.تجزیه لینک(l)
        o := تونل.خروجی از گره(a، a.توضیح)
        b := تونل.گره از خروجی(o)
        same := تونل.گره به لینک(a) برابر تونل.گره به لینک(b)
        سرچاپ a.پروتکل، same، جیسون.معتبر(o.تنظیمات)، جیسون.معتبر(o.تنظیمات جریان)
        اگر وارونه same:
            سرچاپ تونل.گره به لینک(a)
            سرچاپ تونل.گره به لینک(b)
            failures++
        پایان
    پایان

    ناپایا nodes := وکتور {} برگردان وکتور<تونل.گره>
    nodes.بیفزا(تونل.تجزیه لینک(links[1]))
    nodes.بیفزا(تونل.تجزیه لینک(links[2]))
    gen := تونل.پیکربندی از گره‌ها(nodes، 7890)
    سرچاپ gen.خروجی‌ها.طول()، gen.خروجی‌ها[0].برچسب، gen.خروجی پیش‌فرض، gen.درون‌سوها[0].درگاه، تونل.اعتبارسنجی پیکربندی(gen).طول()
    gen2 := تونل.تجزیه پیکربندی(تونل.پیکربندی به جیسون(gen))
    سرچاپ تونل.پیکربندی به جیسون(gen2) برابر تونل.پیکربندی به جیسون(gen)
    سرچاپ تونل.پیکربندی از گره‌ها(وکتور {} برگردان وکتور<تونل.گره>، 1).خروجی پیش‌فرض

    bad := تونل.تجزیه پیکربندی(`{"inbounds":[{"protocol":"socks","port":0},{"tag":"x","protocol":"","port":70000},{"tag":"x","protocol":"http","port":80}],"outbounds":[{"tag":"a","protocol":"freedom"},{"tag":"a","protocol":"x"},{"protocol":"y"}],"routing":{"defaultOutbound":"nope","rules":[{"outboundTag":"zzz","port":"99999"},{"domain":["regexp:("],"ip":["1.2.3.4/40"],"port":"x","outboundTag":"a"},{"outboundTag":"a"}]}}`)
    هر e در تونل.اعتبارسنجی پیکربندی(bad):
        سرچاپ e
    پایان
    سرچاپ تونل.اعتبارسنجی پیکربندی(تونل.تجزیه پیکربندی("not json")).طول()، تونل.اعتبارسنجی پیکربندی(تونل.تجزیه پیکربندی("{}")).طول()
    سرچاپ تونل.بارگذاری پیکربندی("/nonexistent/path.json").خطاها.طول()

    سرچاپ تونل.خروجی ثبت شده("tagged")، تونل.خروجی ثبت شده("freedom")، تونل.خروجی ثبت شده("blackhole")، تونل.درون‌سو ثبت شده("silent")
    تونل.ثبت خروجی(TaggedMaker {})
    تونل.ثبت خروجی(LoopbackMaker {})
    تونل.ثبت خروجی(TaggedMaker {})
    تونل.ثبت درون‌سو(SilentInbound {})
    سرچاپ تونل.خروجی ثبت شده("tagged")، تونل.خروجی ثبت شده("loopback")، تونل.درون‌سو ثبت شده("silent")، تونل.درون‌سو ثبت شده("tagged")
    سرچاپ تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = "tagged" }).نام()، تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = "loopback" }).نام()، تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = "freedom" }).نام()، تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = "unknown" }).نام()
    سرچاپ تونل.ساخت درون‌سو(تونل.پیکربندی درون‌سو { پروتکل = "silent" }).نام()، تونل.ساخت درون‌سو(تونل.پیکربندی درون‌سو { پروتکل = "zzz" }).نام()

    routed := تونل.تجزیه پیکربندی(`{"outbounds":[{"tag":"lo","protocol":"loopback"},{"tag":"deny","protocol":"blackhole"},{"tag":"fail","protocol":"tagged"}],"routing":{"defaultOutbound":"lo","rules":[{"domain":["full:blocked.test"],"outboundTag":"deny"},{"domain":["full:broken.test"],"outboundTag":"fail"}]}}`)
    سرچاپ تونل.اعتبارسنجی پیکربندی(routed).طول()
    rd := تونل.ساخت شماره‌گیر(routed)
    echo_server = تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(echo_server)
    t := نخ‌ساز(echo_once)
    s := rd.اتصال(تونل.نشانی جدید("127.0.0.1"، port))
    سرچاپ rd.آخرین برچسب، s.معتبر()
    s.نوشتن("ping")
    سرچاپ s.خواندن(64)
    s.بستن()
    نخ‌پیوند(t)
    تی سی پی.بستن سرور(echo_server)
    سرچاپ rd.اتصال(تونل.نشانی جدید("blocked.test"، 80)).معتبر()، rd.آخرین برچسب
    سرچاپ rd.اتصال(تونل.نشانی جدید("broken.test"، 80)).معتبر()، rd.آخرین برچسب
    expect("pick unknown"، rd.گزینش("nope").نام() برابر "block")
    expect("pick direct"، rd.گزینش("direct").نام() برابر "direct")
    سرچاپ "failures"، failures
    برگشت failures
پایان
