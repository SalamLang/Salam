واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

ناپایا fired := 0

تابع hold(p: تی سی پی.سرور*):
    srv := p[0]
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c): بشکن پایان
        ticket := تونل.پایش دست‌دهی(c.توصیفگر، 900)
        تی سی پی.تنظیم مهلت خواندن(c، 2000)
        buf := حافظه.تخصیص(16 برگردان طبیعی۶۴)
        ناپایا got := 0
        تا درست:
            n := تی سی پی.خواندن بایت(c، buf، 16)
            اگر n کوچکتربرابر 0: بشکن پایان
            got += n
        پایان
        حافظه.آزادسازی(buf)
        اگر وارونه تونل.پایان پایش دست‌دهی(ticket) و got کوچکتربرابر 4: fired++ پایان
        تی سی پی.بستن(c)
    پایان
پایان

تابع ریشه:
    srv := تی سی پی.پیوند(0)
    keep := حافظه.تخصیص صفرشده(اندازه‌گونه(تی سی پی.سرور) برگردان طبیعی۶۴) برگردان تی سی پی.سرور*
    keep[0] = srv
    _t := نخ‌ساز(hold، keep)
    port := تی سی پی.درگاه(srv)

    ناپایا started := همگام سازی.اکنون میلی ثانیه()
    quiet := تی سی پی.شماره گیری("127.0.0.1"، port)
    تی سی پی.تنظیم مهلت خواندن(quiet، 5000)
    b := تی سی پی.خواندن(quiet، 4)
    ناپایا waited := همگام سازی.اکنون میلی ثانیه() - started
    سرچاپ "quiet client: closed by the server"، b.طول() برابر 0، "in under 2 s"، waited کوچکتر 2000، "not before the deadline"، waited بزرگتربرابر 800
    تی سی پی.بستن(quiet)
    همگام سازی.خواب میلی ثانیه(200)

    started = همگام سازی.اکنون میلی ثانیه()
    slow := تی سی پی.شماره گیری("127.0.0.1"، port)
    ناپایا sent := 0
    ناپایا alive := درست
    تا sent کوچکتر 20 و alive:
        اگر تی سی پی.نوشتن(slow، "x") بزرگتر 0:
            sent++
        وگرنه:
            alive = نادرست
        پایان
        همگام سازی.خواب میلی ثانیه(300)
    پایان
    waited = همگام سازی.اکنون میلی ثانیه() - started
    سرچاپ "one byte every 300 ms: cut off before 20 bytes"، sent کوچکتر 20، "within 3 s"، waited کوچکتر 3000
    تی سی پی.بستن(slow)
    همگام سازی.خواب میلی ثانیه(200)
    همگام سازی.خواب میلی ثانیه(200)
    سرچاپ "expired so far:"، تونل.تعداد پایش‌های منقضی()، "seen by the server:"، fired
    fine := تی سی پی.شماره گیری("127.0.0.1"، port)
    تی سی پی.نوشتن(fine، "hi")
    همگام سازی.خواب میلی ثانیه(100)
    تی سی پی.بستن(fine)
    همگام سازی.خواب میلی ثانیه(300)
    سرچاپ "a bad descriptor gets no ticket:"، تونل.پایش دست‌دهی(0 - 1، 500) برابر 0، "and a zero deadline none either:"، تونل.پایش دست‌دهی(5، 0) برابر 0
    سرچاپ "an unknown ticket is reported as not found:"، تونل.پایان پایش دست‌دهی(987654321 برگردان صحیح۶۴)
پایان
