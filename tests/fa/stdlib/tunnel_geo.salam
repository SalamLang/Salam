بسته ریشه

واردسازی شبکه.تونل
واردسازی شبکه.تی سی پی
واردسازی حافظه
واردسازی استخر

ناپایا failures := 0
ناپایا v6_srv := تی سی پی.سرور {}

ساختار MockResolver:
    همگانی calls: صحیح = 0
    همگانی answer: رشته = ""

    همگانی تابع Lookup(host: رشته): تونل.نتیجه جستجو:
        این.calls += 1
        ناپایا out := تونل.نتیجه جستجو {}
        اگر host برابر "bank.test": out.ips.بیفزا("5.22.7.7") پایان
        اگر host برابر "dual.test":
            out.ips.بیفزا("::1")
            out.ips.بیفزا(این.answer)
        پایان
        برگشت out
    پایان
پایان

تابع expect(label: رشته، ok: منطقی):
    اگر وارونه ok:
        سرچاپ "FAIL"، label
        failures++
    پایان
پایان

تابع accept_once():
    c := تی سی پی.پذیرش(v6_srv)
    s := تونل.پوشاندن تی سی پی(c)
    s.نوشتن("hi from v4")
    s.بستن()
پایان

تابع put_varint(p: طبیعی۸*، pos &: صحیح، v: صحیح):
    ناپایا x := v
    تا x بزرگتربرابر 128:
        p[pos] = ((x & 127) | 128) برگردان طبیعی۸
        pos += 1
        x = x >> 7
    پایان
    p[pos] = x برگردان طبیعی۸
    pos += 1
پایان

تابع put_bytes(p: طبیعی۸*، pos &: صحیح، field: صحیح، data: رشته، n: صحیح):
    put_varint(p، pos، field * 8 + 2)
    put_varint(p، pos، n)
    حافظه.کپی((p برگردان صحیح۶۴ + pos) برگردان تهی*، data برگردان تهی*، n برگردان طبیعی۶۴)
    pos += n
پایان

تابع lists():
    set := تونل.جستجوی جی‌او‌سایت("ir")
    سرچاپ "bundled:"، set.count بزرگتر 0، تونل.مجموعه دامنه شامل(set، "shop.digikala.com")، تونل.مجموعه دامنه شامل(set، "x.ir")، تونل.مجموعه دامنه شامل(set، "google.com")
    d := تونل.تجزیه فهرست دامنه("domain:a.test\nfull:b.test\nkeyword:zzz\nregexp:^r[0-9]\\.test$\nplain.test @cn\n"، "")
    سرچاپ "domain set:"، تونل.مجموعه دامنه شامل(d، "a.test")، تونل.مجموعه دامنه شامل(d، "x.a.test")، تونل.مجموعه دامنه شامل(d، "xa.test")
    سرچاپ "full:"، تونل.مجموعه دامنه شامل(d، "b.test")، تونل.مجموعه دامنه شامل(d، "x.b.test")
    سرچاپ "keyword:"، تونل.مجموعه دامنه شامل(d، "my-zzz-site.org")، "regex:"، تونل.مجموعه دامنه شامل(d، "r7.test")، تونل.مجموعه دامنه شامل(d، "rr.test")
    cn := تونل.تجزیه فهرست دامنه("plain.test @cn\nother.test @us\n"، "cn")
    سرچاپ "attr:"، تونل.مجموعه دامنه شامل(cn، "plain.test")، تونل.مجموعه دامنه شامل(cn، "other.test")
    ips := تونل.تجزیه فهرست آی‌پی("5.22.0.0/16\n185.55.224.0/22\n2a01:5ec0::/32\n91.99.1.2\n")
    سرچاپ "ip count:"، ips.count
    سرچاپ "v4:"، تونل.مجموعه آی‌پی شامل(ips، تونل.تجزیه آی‌پی("5.22.9.9"))، تونل.مجموعه آی‌پی شامل(ips، تونل.تجزیه آی‌پی("5.23.0.1"))، تونل.مجموعه آی‌پی شامل(ips، تونل.تجزیه آی‌پی("185.55.227.255"))، تونل.مجموعه آی‌پی شامل(ips، تونل.تجزیه آی‌پی("185.55.228.0"))
    سرچاپ "v6:"، تونل.مجموعه آی‌پی شامل(ips، تونل.تجزیه آی‌پی("2a01:5ec0:1::1"))، تونل.مجموعه آی‌پی شامل(ips، تونل.تجزیه آی‌پی("2a01:5ec1::1"))
    سرچاپ "single:"، تونل.مجموعه آی‌پی شامل(ips، تونل.تجزیه آی‌پی("91.99.1.2"))، تونل.مجموعه آی‌پی شامل(ips، تونل.تجزیه آی‌پی("91.99.1.3"))
پایان

تابع directory():
    تونل.پاک کردن داده جغرافیایی()
    تونل.تنظیم پوشه داده جغرافیایی("tests/fixtures/geo")
    سرچاپ "has site:"، تونل.جی‌او‌سایت وجود دارد("test-ir")، تونل.جی‌او‌سایت وجود دارد("nothing-here")
    s := تونل.جستجوی جی‌او‌سایت("test-ir")
    سرچاپ "dir list:"، تونل.مجموعه دامنه شامل(s، "shop.example.ir")، تونل.مجموعه دامنه شامل(s، "example.ir")، تونل.مجموعه دامنه شامل(s، "www.exact.test")، تونل.مجموعه دامنه شامل(s، "extra.test")، تونل.مجموعه دامنه شامل(s، "img3.cdn.test")
    ads := تونل.جستجوی جی‌او‌سایت("test-ir@ads")
    سرچاپ "ads only:"، تونل.مجموعه دامنه شامل(ads، "shop.test")، تونل.مجموعه دامنه شامل(ads، "news.test")، تونل.مجموعه دامنه شامل(ads، "ads.extra.test")، تونل.مجموعه دامنه شامل(ads، "extra.test")
    سرچاپ "has ip:"، تونل.جی‌او‌آی‌پی وجود دارد("test-ir")
    ناپایا rt := تونل.مسیریاب جدید("proxy")
    ناپایا r := تونل.قاعده جدید("direct")
    expect("geosite spec"، تونل.قاعده دامنه با پیشوند(r، "geosite:test-ir"))
    expect("geoip spec"، تونل.قاعده آی‌پی با پیشوند(r، "geoip:test-ir"))
    expect("unknown spec"، وارونه تونل.قاعده دامنه با پیشوند(r، "geosite:no-such-list"))
    تونل.افزودن قاعده(rt، r)
    سرچاپ "route:"، rt.تطبیق میزبان("x.example.ir"، 443)، rt.تطبیق میزبان("185.55.225.1"، 443)، rt.تطبیق میزبان("8.8.8.8"، 443)، rt.تطبیق میزبان("google.com"، 443)
پایان

تابع resolved():
    ناپایا rt := تونل.مسیریاب جدید("proxy")
    ناپایا r := تونل.قاعده جدید("direct")
    تونل.قاعده سی‌آی‌دی‌آر(r، "5.22.0.0/16")
    تونل.افزودن قاعده(rt، r)
    سرچاپ "no resolver:"، rt.تطبیق میزبان("bank.test"، 443)
    m := MockResolver {}
    تونل.تنظیم حل‌کننده(rt، m، 60000 برگردان صحیح۶۴)
    سرچاپ "with resolver:"، rt.تطبیق میزبان("bank.test"، 443)، rt.تطبیق میزبان("bank.test"، 80)، rt.تطبیق میزبان("other.test"، 80)
    سرچاپ "lookups cached:"، rt.cache.lookups
پایان

تابع dat_files():
    تونل.پاک کردن داده جغرافیایی()
    dom := حافظه.تخصیص صفرشده(64 برگردان طبیعی۶۴) برگردان طبیعی۸*
    ناپایا dp := 0
    put_varint(dom، dp، 8)
    put_varint(dom، dp، 2)
    put_bytes(dom، dp، 2، "dat.test"، 8)
    site := حافظه.تخصیص صفرشده(128 برگردان طبیعی۶۴) برگردان طبیعی۸*
    ناپایا sp := 0
    put_bytes(site، sp، 1، "IR"، 2)
    put_bytes(site، sp، 2، dom برگردان رشته، dp)
    buf := حافظه.تخصیص صفرشده(256 برگردان طبیعی۶۴) برگردان طبیعی۸*
    ناپایا pos := 0
    put_bytes(buf، pos، 1، site برگردان رشته، sp)
    n := تونل.بارگذاری جی‌او‌سایت دی‌ای‌تی(buf برگردان تهی*، pos، وکتور {} برگردان وکتور<رشته>)
    سرچاپ "site entries:"، n، تونل.مجموعه دامنه شامل(تونل.جستجوی جی‌او‌سایت("ir")، "www.dat.test")
    cidr := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴) برگردان طبیعی۸*
    ناپایا cp := 0
    put_varint(cidr، cp، 10)
    put_varint(cidr، cp، 4)
    cidr[cp] = 10 برگردان طبیعی۸
    cidr[cp + 1] = 4 برگردان طبیعی۸
    cidr[cp + 2] = 0 برگردان طبیعی۸
    cidr[cp + 3] = 0 برگردان طبیعی۸
    cp += 4
    put_varint(cidr، cp، 16)
    put_varint(cidr، cp، 16)
    ipe := حافظه.تخصیص صفرشده(64 برگردان طبیعی۶۴) برگردان طبیعی۸*
    ناپایا ip := 0
    put_bytes(ipe، ip، 1، "IR"، 2)
    put_bytes(ipe، ip، 2، cidr برگردان رشته، cp)
    ibuf := حافظه.تخصیص صفرشده(128 برگردان طبیعی۶۴) برگردان طبیعی۸*
    ناپایا ipos := 0
    put_bytes(ibuf، ipos، 1، ipe برگردان رشته، ip)
    سرچاپ "ip entries:"، تونل.بارگذاری جی‌او‌آی‌پی دی‌ای‌تی(ibuf برگردان تهی*، ipos، وکتور {} برگردان وکتور<رشته>)
    gi := تونل.جستجوی جی‌او‌آی‌پی("ir")
    سرچاپ "dat ip:"، تونل.مجموعه آی‌پی شامل(gi، تونل.تجزیه آی‌پی("10.4.77.1"))، تونل.مجموعه آی‌پی شامل(gi، تونل.تجزیه آی‌پی("10.5.0.1"))
    سرچاپ "truncated:"، تونل.بارگذاری جی‌او‌سایت دی‌ای‌تی(buf برگردان تهی*، pos - 3، وکتور {} برگردان وکتور<رشته>)
    حافظه.آزادسازی(dom برگردان تهی*)
    حافظه.آزادسازی(site برگردان تهی*)
    حافظه.آزادسازی(buf برگردان تهی*)
    حافظه.آزادسازی(cidr برگردان تهی*)
    حافظه.آزادسازی(ipe برگردان تهی*)
    حافظه.آزادسازی(ibuf برگردان تهی*)
پایان

تابع dialer():
    v6_srv = تی سی پی.پیوند(0)
    wp := استخر.جدید کشسان(1 برگردان صحیح۶۴، 2 برگردان صحیح۶۴، 2 برگردان صحیح۶۴)
    استخر.ارسال(wp، (): accept_once() پایان)
    ناپایا m := MockResolver {}
    m.answer = "127.0.0.1"
    ناپایا d := تونل.شماره‌گیر مستقیم {}
    d.timeout_ms = 3000
    d.resolver = m
    d.has_resolver = درست
    d.prefer_v6 = درست
    s := d.اتصال(تونل.نشانی جدید("dual.test"، تی سی پی.درگاه(v6_srv)))
    سرچاپ "dialed:"، s.معتبر()
    سرچاپ s.خواندن(100)
    s.بستن()
    استخر.انتظار(wp)
    استخر.توقف(wp)
    ipv6 := تونل.نشانی جدید("[::1]"، 5)
    سرچاپ "v6 literal:"، ipv6.kind، ipv6.valid، تونل.نشانی جدید("::1"، 80).متن()
    تی سی پی.بستن سرور(v6_srv)
پایان

تابع ریشه:
    lists()
    directory()
    resolved()
    dat_files()
    dialer()
    سرچاپ "failures:"، failures
پایان
