واردسازی حافظه
واردسازی شبکه.تونل

تابع load(bytes: وکتور<صحیح>): صحیح:
    p := حافظه.تخصیص((bytes.طول() + 1) برگردان طبیعی۶۴) برگردان طبیعی۸*
    تکرار bytes.طول() در i:
        p[i] = bytes.بگیر(i) برگردان طبیعی۸
    پایان
    names := وکتور {} برگردان وکتور<رشته>
    n := تونل.بارگذاری جی‌او‌سایت دی‌ای‌تی(p برگردان تهی*، bytes.طول()، names)
    حافظه.آزادسازی(p برگردان تهی*)
    برگشت n
پایان

تابع ریشه():
    تونل.پاک کردن داده جغرافیایی()
    wrap := وکتور {} برگردان وکتور<صحیح>
    تکرار 8:
        wrap.بیفزا(255)
    پایان
    wrap.بیفزا(127)
    ناپایا a := وکتور {} برگردان وکتور<صحیح>
    a.بیفزا(10)
    تکرار wrap.طول() در i:
        a.بیفزا(wrap.بگیر(i))
    پایان
    a.بیفزا(1)
    سرچاپ "huge length"، load(a)
    ناپایا b := وکتور {} برگردان وکتور<صحیح>
    b.بیفزا(10)
    b.بیفزا(200)
    b.بیفزا(1)
    سرچاپ "length past the end"، load(b)
    ناپایا c := وکتور {} برگردان وکتور<صحیح>
    c.بیفزا(10)
    سرچاپ "length missing"، load(c)
    ناپایا d := وکتور {} برگردان وکتور<صحیح>
    d.بیفزا(10)
    d.بیفزا(6)
    d.بیفزا(10)
    d.بیفزا(2)
    d.بیفزا(105)
    d.بیفزا(114)
    d.بیفزا(18)
    d.بیفزا(0)
    سرچاپ "valid entry"، load(d)
    odd := تونل.تجزیه فهرست دامنه("\u000b\nexample.com\n\u000c\n"، "")
    سرچاپ "list with a line of only a vertical tab"، odd.شمار
پایان
