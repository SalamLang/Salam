بسته ریشه

واردسازی شبکه.تونل
واردسازی شبکه.تی سی پی
واردسازی استخر

ناپایا failures := 0
ناپایا req_srv := تی سی پی.سرور {}
ناپایا banner_srv := تی سی پی.سرور {}
ناپایا seen_request := ""
ناپایا seen_later := ""
ناپایا relay_up := 0 برگردان صحیح۶۴
ناپایا relay_down := 0 برگردان صحیح۶۴

تابع expect(label: رشته، ok: منطقی):
    اگر وارونه ok:
        سرچاپ "FAIL"، label
        failures++
    پایان
پایان

تابع read_all(s: پویا تونل.جریان): رشته:
    ناپایا out := ""
    تا درست:
        piece := s.خواندن(4096)
        اگر piece.طول() برابر 0: بشکن پایان
        out += piece
    پایان
    برگشت out
پایان

تابع request_response_server():
    c := تی سی پی.پذیرش(req_srv)
    s := تونل.پوشاندن تی سی پی(c)
    seen_request = read_all(s)
    s.نوشتن("response:" + seen_request)
    s.بستن()
پایان

تابع banner_server():
    c := تی سی پی.پذیرش(banner_srv)
    s := تونل.پوشاندن تی سی پی(c)
    s.نوشتن("banner")
    s.بستن نوشتن()
    seen_later = read_all(s)
    s.بستن()
پایان

تابع run_relay(a: پویا تونل.جریان، b: پویا تونل.جریان):
    r := تونل.رله(a، b)
    relay_up = r.up
    relay_down = r.down
پایان

تابع request_then_shutdown():
    p := تونل.لوله جدید()
    out := تونل.اتصال تی سی پی("127.0.0.1"، تی سی پی.درگاه(req_srv)، 3000)
    wp := استخر.جدید کشسان(2 برگردان صحیح۶۴، 4 برگردان صحیح۶۴، 4 برگردان صحیح۶۴)
    استخر.ارسال(wp، (): request_response_server() پایان)
    استخر.ارسال(wp، (): run_relay(تونل.سر دوم لوله(p)، out) پایان)
    client := تونل.سر اول لوله(p)
    client.نوشتن("hello over half close")
    client.بستن نوشتن()
    reply := read_all(client)
    سرچاپ "reply:"، reply
    expect("reply"، reply برابر "response:hello over half close")
    client.بستن()
    استخر.انتظار(wp)
    استخر.توقف(wp)
    سرچاپ "server saw:"، seen_request
    سرچاپ "bytes:"، relay_up، relay_down
پایان

تابع late_write_after_server_eof():
    p := تونل.لوله جدید()
    out := تونل.اتصال تی سی پی("127.0.0.1"، تی سی پی.درگاه(banner_srv)، 3000)
    wp := استخر.جدید کشسان(2 برگردان صحیح۶۴، 4 برگردان صحیح۶۴، 4 برگردان صحیح۶۴)
    استخر.ارسال(wp، (): banner_server() پایان)
    استخر.ارسال(wp، (): run_relay(تونل.سر دوم لوله(p)، out) پایان)
    client := تونل.سر اول لوله(p)
    banner := read_all(client)
    سرچاپ "banner:"، banner
    expect("banner"، banner برابر "banner")
    client.نوشتن("sent after the server closed its write side")
    client.بستن نوشتن()
    استخر.انتظار(wp)
    استخر.توقف(wp)
    سرچاپ "server later:"، seen_later
    client.بستن()
پایان

تابع pipe_to_pipe():
    p1 := تونل.لوله جدید()
    p2 := تونل.لوله جدید()
    wp := استخر.جدید کشسان(2 برگردان صحیح۶۴، 4 برگردان صحیح۶۴، 4 برگردان صحیح۶۴)
    استخر.ارسال(wp، (): run_relay(تونل.سر دوم لوله(p1)، تونل.سر اول لوله(p2)) پایان)
    left := تونل.سر اول لوله(p1)
    right := تونل.سر دوم لوله(p2)
    left.نوشتن("ping")
    left.بستن نوشتن()
    got := read_all(right)
    سرچاپ "right got:"، got
    right.نوشتن("pong")
    right.بستن نوشتن()
    back := read_all(left)
    سرچاپ "left got:"، back
    left.بستن()
    right.بستن()
    استخر.انتظار(wp)
    استخر.توقف(wp)
    سرچاپ "relayed:"، relay_up، relay_down
پایان

تابع ریشه:
    req_srv = تی سی پی.پیوند(0)
    banner_srv = تی سی پی.پیوند(0)
    request_then_shutdown()
    late_write_after_server_eof()
    pipe_to_pipe()
    تی سی پی.بستن سرور(req_srv)
    تی سی پی.بستن سرور(banner_srv)
    سرچاپ "failures:"، failures
پایان
