واردسازی حافظه
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

تابع closed_by_peer(c: تی سی پی.اتصال شبکه، wait_ms: صحیح): منطقی:
    تی سی پی.تنظیم مهلت خواندن(c، wait_ms)
    buf := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    n := تی سی پی.خواندن بایت(c، buf، 8)
    حافظه.آزادسازی(buf)
    برگشت n برابر 0
پایان

تابع keys():
    سرچاپ تونل.کلید مبدا("203.0.113.9")
    سرچاپ تونل.کلید مبدا("::ffff:203.0.113.9")
    سرچاپ تونل.کلید مبدا("[::ffff:203.0.113.9]")
    سرچاپ تونل.کلید مبدا("2001:0db8:0001:0002:aaaa:bbbb:cccc:dddd")
    سرچاپ تونل.کلید مبدا("2001:db8:1:2::1")
    سرچاپ تونل.کلید مبدا("2001:db8:1:3::1")
    سرچاپ تونل.کلید مبدا("fe80::1%2")
    سرچاپ تونل.کلید مبدا("::1")
پایان

تابع limits():
    t := تونل.جدول مبداها جدید()
    سرچاپ "v4 then mapped share one slot pool:"، تونل.ورود مبدا(t، "198.51.100.4"، 2)، تونل.ورود مبدا(t، "::ffff:198.51.100.4"، 2)، تونل.ورود مبدا(t، "198.51.100.4"، 2)
    تونل.خروج مبدا(t، "::ffff:198.51.100.4")
    سرچاپ "mapped leave frees a v4 slot:"، تونل.ورود مبدا(t، "198.51.100.4"، 2)
    سرچاپ "one v6 prefix shares a limit:"، تونل.ورود مبدا(t، "2001:db8:5:6::1"، 1)، تونل.ورود مبدا(t، "2001:db8:5:6:ffff::2"، 1)، تونل.ورود مبدا(t، "2001:db8:5:7::1"، 1)
    سرچاپ "textual forms of one address are equal:"، تونل.ورود مبدا(t، "2001:db8:9::1"، 1)، تونل.ورود مبدا(t، "2001:0db8:0009:0000:0000:0000:0000:0001"، 1)
پایان

تابع ranges():
    ناپایا set := تونل.مجموعه آی‌پی جدید()
    سرچاپ تونل.افزودن به مجموعه آی‌پی(set، "2606:4700::/32")، تونل.افزودن به مجموعه آی‌پی(set، "2001:4860::/32")، تونل.افزودن به مجموعه آی‌پی(set، "2620:fe::/48")، تونل.افزودن به مجموعه آی‌پی(set، "1.1.1.0/24")
    سرچاپ تونل.مجموعه آی‌پی شامل(set، تونل.تجزیه آی‌پی("2606:4700:4700::1111"))، تونل.مجموعه آی‌پی شامل(set، تونل.تجزیه آی‌پی("2001:4860:4860::8888"))، تونل.مجموعه آی‌پی شامل(set، تونل.تجزیه آی‌پی("2620:fe::9"))
    سرچاپ تونل.مجموعه آی‌پی شامل(set، تونل.تجزیه آی‌پی("2606:4701::1"))، تونل.مجموعه آی‌پی شامل(set، تونل.تجزیه آی‌پی("2620:ff::1"))، تونل.مجموعه آی‌پی شامل(set، تونل.تجزیه آی‌پی("1.1.1.1"))، تونل.مجموعه آی‌پی شامل(set، تونل.تجزیه آی‌پی("1.1.2.1"))
    ناپایا rule := تونل.قاعده جدید("direct")
    سرچاپ تونل.قاعده سی‌آی‌دی‌آر(rule، "2001:db8::/32")، تونل.قاعده سی‌آی‌دی‌آر(rule، "fe80::/10")
    سرچاپ تونل.قاعده مطابقت دارد(rule، تونل.نشانی جدید("2001:db8:1::5"، 443))، تونل.قاعده مطابقت دارد(rule، تونل.نشانی جدید("fe80::abcd"، 443))، تونل.قاعده مطابقت دارد(rule، تونل.نشانی جدید("2001:db9::1"، 443))، تونل.قاعده مطابقت دارد(rule، تونل.نشانی جدید("[2001:db8::1]"، 443))
پایان

تابع ریشه:
    keys()
    limits()
    ranges()

    probe := تی سی پی.پیوند روی("::1"، 0)
    اگر وارونه تی سی پی.معتبر(probe):
        سرچاپ "ipv6 unavailable"
        برگشت
    پایان
    تی سی پی.بستن سرور(probe)

    srv := تونل.شنود تی سی پی روی نشانی("::"، 0)
    srv.سقف مبدا = 1
    srv.مهلت دست‌دهی = 1500
    fwd := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، ساکس.ورودی جدید(ساکس.پیکربندی سرور جدید(0)))
    سرچاپ "dual acceptor up:"، srv.معتبر()، srv.میزبان
    تونل.شروع پذیرش(srv، ساکس.ورودی جدید(ساکس.پیکربندی سرور جدید(0))، fwd)
    a := تی سی پی.شماره گیری("::1"، srv.درگاه())
    همگام سازی.خواب میلی ثانیه(200)
    b := تی سی پی.شماره گیری("::1"، srv.درگاه())
    c := تی سی پی.شماره گیری("127.0.0.1"، srv.درگاه())
    همگام سازی.خواب میلی ثانیه(300)
    سرچاپ "second silent client from the same v6 source is refused:"، closed_by_peer(b، 400)
    سرچاپ "first v6 client still waiting:"، وارونه closed_by_peer(a، 100)
    سرچاپ "a v4 client is another source and waits:"، وارونه closed_by_peer(c، 100)
    سرچاپ "the handshake deadline closes them:"، closed_by_peer(a، 3000)، closed_by_peer(c، 500)
    srv.توقف()
    سرچاپ "stopped"

    six := تونل.شنود محلی آی‌پی۶(0)
    سرچاپ "listen local6:"، six.معتبر()، six.میزبان
    تونل.شروع پذیرش(six، ساکس.ورودی جدید(ساکس.پیکربندی سرور جدید(0))، fwd)
    refused := تی سی پی.شماره گیری("127.0.0.1"، six.درگاه())
    سرچاپ "v4 cannot reach a ::1 listener:"، وارونه تی سی پی.اتصال معتبر(refused)
    d := تی سی پی.شماره گیری("::1"، six.درگاه())
    سرچاپ "v6 reaches it:"، تی سی پی.اتصال معتبر(d)، وارونه closed_by_peer(d، 100)
    تی سی پی.بستن(d)
    six.توقف()
    سرچاپ "stopped local6"

    ناپایا inb := تونل.شنود تی سی پی در نشانی("::1"، 0)
    سرچاپ "tcp inbound at ::1:"، inb.معتبر()، inb.درگاه بزرگتر 0
    inb.سقف مبدا = 1
    inb.مهلت دست‌دهی = 1500
    تونل.سرویس‌دهی پس‌زمینه(inb، ساکس.ورودی جدید(ساکس.پیکربندی سرور جدید(0))، fwd)
    e := تی سی پی.شماره گیری("::1"، inb.درگاه)
    f := تی سی پی.شماره گیری("::1"، inb.درگاه)
    همگام سازی.خواب میلی ثانیه(300)
    سرچاپ "inbound refuses a second client from the same source:"، closed_by_peer(f، 400)، وارونه closed_by_peer(e، 100)
    تی سی پی.بستن(e)
    inb.توقف()
    سرچاپ "stopped inbound"

    dual := تونل.شنود تی سی پی دوگانه(0)
    سرچاپ "dual acceptor helper:"، dual.معتبر()، dual.میزبان
    dual.توقف()
    dinb := تونل.شنود تی سی پی دوگانه درون‌سو(0)
    سرچاپ "dual inbound helper:"، dinb.معتبر()، dinb.میزبان
    dinb.توقف()
    سرچاپ "stopped helpers"
پایان
