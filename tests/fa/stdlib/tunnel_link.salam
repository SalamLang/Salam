بسته ریشه

واردسازی شبکه.تونل
واردسازی کدگذاری

ناپایا failures := 0

تابع same(a: تونل.گره، b: تونل.گره): منطقی:
    ok := a.پروتکل برابر b.پروتکل و a.میزبان برابر b.میزبان و a.درگاه برابر b.درگاه و a.شناسه برابر b.شناسه و a.گذرواژه برابر b.گذرواژه و a.روش برابر b.روش و a.شبکه برابر b.شبکه و a.تی ال اس برابر b.تی ال اس و a.امنیت برابر b.امنیت و a.نام سرور برابر b.نام سرور و a.پروتکل برنامه برابر b.پروتکل برنامه و a.اثر انگشت برابر b.اثر انگشت و a.مسیر برابر b.مسیر و a.سرآیند میزبان برابر b.سرآیند میزبان و a.توضیح برابر b.توضیح و a.جریان برابر b.جریان و a.نام سرویس برابر b.نام سرویس و a.کلید عمومی برابر b.کلید عمومی و a.شناسه کوتاه برابر b.شناسه کوتاه و a.شناسه جایگزین برابر b.شناسه جایگزین و a.افزونه برابر b.افزونه
    برگشت ok
پایان

تابع roundtrip(name: رشته، link: رشته):
    n := تونل.تجزیه لینک(link)
    اگر وارونه n.معتبر:
        سرچاپ name، "parse failed:"، n.خطا
        failures++
        برگشت
    پایان
    out := تونل.گره به لینک(n)
    m := تونل.تجزیه لینک(out)
    اگر وارونه m.معتبر یا وارونه same(n، m):
        سرچاپ name، "round trip differs"
        سرچاپ link
        سرچاپ out
        failures++
        برگشت
    پایان
    out2 := تونل.گره به لینک(m)
    اگر out نابرابر out2:
        سرچاپ name، "writer not stable"
        failures++
        برگشت
    پایان
    سرچاپ name، "ok"، n.پروتکل، تونل.نشانی گره(n).متن()، n.شبکه، n.امنیت، n.توضیح
پایان

تابع ریشه:
    vmess_json := `{"v":"2","ps":"سرور آلمان ۱","add":"de.example.com","port":"443","id":"b831381d-6324-4d53-ad4f-8cda48b30811","aid":"0","scy":"auto","net":"ws","type":"none","host":"cdn.example.com","path":"/ws?ed=2048","tls":"tls","sni":"cdn.example.com","alpn":"h2,http/1.1","fp":"chrome"}`
    vm := "vmess://" + کدگذاری.کدگذاری پایه۶۴(vmess_json)
    roundtrip("vmess-ws"، vm)
    n := تونل.تجزیه لینک(vm)
    سرچاپ n.شناسه، n.شناسه جایگزین، n.روش، n.مسیر، n.سرآیند میزبان، n.نام سرور، n.پروتکل برنامه، n.اثر انگشت، n.تی ال اس

    roundtrip("vmess-tcp-num"، "vmess://" + کدگذاری.کدگذاری پایه۶۴(`{"v":2,"ps":"plain","add":"1.2.3.4","port":8080,"id":"11111111-2222-3333-4444-555555555555","aid":64,"net":"tcp","type":"http","host":"a.com","path":"/","tls":""}`))
    roundtrip("vmess-grpc"، "vmess://" + کدگذاری.کدگذاری پایه۶۴(`{"v":"2","ps":"g","add":"g.example.com","port":"443","id":"11111111-2222-3333-4444-555555555555","aid":"0","scy":"aes-128-gcm","net":"grpc","path":"svc","tls":"tls","sni":"g.example.com"}`))

    reality := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@203.0.113.9:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.microsoft.com&fp=chrome&pbk=AbCdEf-xyz_123&sid=6ba85179e30d4fc2&spx=%2F&type=tcp#Reality%20%D8%A2%D9%84%D9%85%D8%A7%D9%86"
    roundtrip("vless-reality"، reality)
    r := تونل.تجزیه لینک(reality)
    سرچاپ r.جریان، r.کلید عمومی، r.شناسه کوتاه، r.مسیر عنکبوتی، r.توضیح، r.تی ال اس
    سرچاپ تونل.گره به لینک(r) برابر "vless://b831381d-6324-4d53-ad4f-8cda48b30811@203.0.113.9:443?encryption=none&security=reality&sni=www.microsoft.com&fp=chrome&type=tcp&flow=xtls-rprx-vision&pbk=AbCdEf-xyz_123&sid=6ba85179e30d4fc2&spx=%2F#Reality%20%D8%A2%D9%84%D9%85%D8%A7%D9%86"
    roundtrip("vless-ws-tls-v6"، "vless://b831381d-6324-4d53-ad4f-8cda48b30811@[2001:db8::7]:8443?encryption=none&security=tls&sni=v.example.com&type=ws&host=v.example.com&path=%2Fvless%3Fed%3D2048&alpn=h2%2Chttp%2F1.1&fp=firefox#v6")
    roundtrip("vless-grpc"، "vless://b831381d-6324-4d53-ad4f-8cda48b30811@grpc.example.com:443?security=tls&type=grpc&serviceName=my%20svc&sni=grpc.example.com#grpc")
    roundtrip("vless-plain"، "vless://b831381d-6324-4d53-ad4f-8cda48b30811@plain.example.com:80?type=tcp&security=none")

    roundtrip("trojan-ws"، "trojan://p%40ss%3Aword@trj.example.org:443?security=tls&sni=trj.example.org&type=ws&host=trj.example.org&path=%2Ftrojan&alpn=h2#Trojan-WS")
    roundtrip("trojan-bare"، "trojan://secret@trj2.example.org:2053#%D8%AA%D8%B1%D9%88%D8%AC%D8%A7%D9%86")
    t := تونل.تجزیه لینک("trojan://secret@trj2.example.org:2053")
    سرچاپ t.امنیت، t.تی ال اس، t.شبکه، t.گذرواژه

    sip := "ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@192.0.2.1:8388#Plain%20SS"
    roundtrip("ss-sip002"، sip)
    s := تونل.تجزیه لینک(sip)
    سرچاپ s.روش، s.گذرواژه، s.میزبان، s.درگاه
    سرچاپ تونل.گره به لینک(s) برابر sip
    legacy := "ss://" + کدگذاری.کدگذاری پایه۶۴("chacha20-ietf-poly1305:pw:123@ss.example.org:1080") + "#legacy"
    roundtrip("ss-legacy"، legacy)
    l := تونل.تجزیه لینک(legacy)
    سرچاپ l.روش، l.گذرواژه، l.میزبان، l.درگاه
    roundtrip("ss-plugin"، "ss://Y2hhY2hhMjAtaWV0Zi1wb2x5MTMwNTpwdzEyMw@ss.example.org:1080/?plugin=v2ray-plugin%3Bmode%3Dwebsocket%3Btls%3Bhost%3Dx.com#p")
    plain := تونل.تجزیه لینک("ss://aes-128-gcm:my%2Fpass@10.0.0.1:443#x")
    سرچاپ plain.معتبر، plain.روش، plain.گذرواژه
    roundtrip("ss-v6"، "ss://YWVzLTEyOC1nY206eA@[::1]:8388#loop")

    هر bad در [""، "vmess://"، "vmess://%%%"، "vmess://" + کدگذاری.کدگذاری پایه۶۴("not json")، "vless://@host:1"، "vless://id@host"، "vless://id@host:99999"، "trojan://pw@:443"، "ss://"، "ss://abc"، "http://x"، "ss://YWVzLTEyOC1nY206eA@host:abc"]:
        b := تونل.تجزیه لینک(bad)
        اگر b.معتبر:
            سرچاپ "accepted"، bad
            failures++
        پایان
    پایان

    one := "vless://11111111-2222-3333-4444-555555555555@a.com:443?security=tls#A"
    two := "trojan://pw@b.com:443#B"
    three := "ss://YWVzLTEyOC1nY206eA@c.com:1#C"
    sub1 := تونل.تجزیه اشتراک(کدگذاری.کدگذاری پایه۶۴(one + "\r\n" + two + "\n\nbogus line\n" + three + "\n"))
    سرچاپ "sub base64"، sub1.گره‌ها.طول()، sub1.ردشده، تونل.برچسب گره(sub1.گره‌ها[0])، تونل.برچسب گره(sub1.گره‌ها[2])
    sub2 := تونل.تجزیه اشتراک(one + "\n# note\n" + two + "\nxx\n" + three)
    سرچاپ "sub plain"، sub2.گره‌ها.طول()، sub2.ردشده، sub2.گره‌ها[1].پروتکل
    sub3 := تونل.تجزیه اشتراک("")
    سرچاپ "sub empty"، sub3.گره‌ها.طول()، sub3.ردشده
    سرچاپ تونل.رمزگشایی درصدی("%D8%B3%D9%84%D8%A7%D9%85+x%2")، تونل.رمزگذاری درصدی("سلام a/b")، تونل.رمزگشایی درصدی(تونل.رمزگذاری درصدی("a b&c=d/é"))
    سرچاپ تونل.رمزگشایی پایه۶۴("c2FsYW0")، تونل.رمزگشایی پایه۶۴("c2FsYW0=")، تونل.رمزگشایی پایه۶۴("c2Fs\nYW0=")، تونل.رمزگذاری پایه۶۴ نشانی("subjects?_d>>")، تونل.رمزگشایی پایه۶۴("c3ViamVjdHM_X2Q-Pg")
    سرچاپ "failures"، failures
    برگشت failures
پایان
