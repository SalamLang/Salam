واردسازی کدگذاری
واردسازی شبکه.تونل
واردسازی شبکه.وی لس
واردسازی شبکه.وی مس
واردسازی شبکه.وی‌پی‌ان

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"
پایا PBK := "Ah1AwxBG8mOMQ5zgUCSyb2TYOmrBfV8yi7cYOQm-1xQ"

تابع ریشه:
    vl := "vless://" + UUID1 + "@[2001:db8::1]:8443?encryption=none&security=tls&sni=h.example.com&alpn=h2%2Chttp%2F1.1&type=grpc&serviceName=gsvc&mode=multi#v6grpc"
    n := تونل.تجزیه لینک(vl)
    سرچاپ "vless:"، n.معتبر، n.میزبان، n.درگاه، n.شبکه، n.نام سرویس، n.حالت جی آر پی سی، n.پروتکل برنامه
    back := تونل.تجزیه لینک(تونل.گره به لینک(n))
    سرچاپ "link round trip:"، back.معتبر، back.حالت جی آر پی سی، back.نام سرویس
    o := تونل.خروجی از گره(n، "p")
    سرچاپ "outbound has multiMode:"، o.تنظیمات جریان.دربردارد("multiMode")
    again := تونل.گره از خروجی(o)
    سرچاپ "outbound round trip:"، again.حالت جی آر پی سی، again.نام سرویس
    s := وی‌پی‌ان.تنظیمات گره(n)
    سرچاپ "settings:"، s.شبکه، s.نام سرویس، s.حالت جی آر پی سی
    gun := تونل.تجزیه لینک("vless://" + UUID1 + "@h.example.com:443?encryption=none&security=tls&type=grpc&serviceName=gsvc&mode=gun")
    سرچاپ "gun stays empty:"، gun.حالت جی آر پی سی.طول() برابر 0، وی‌پی‌ان.تنظیمات گره(gun).حالت جی آر پی سی
    vm := "vmess://" + کدگذاری.کدگذاری پایه۶۴(`{"v":"2","ps":"g","add":"vm.example.com","port":443,"id":"` + UUID1 + `","aid":0,"net":"grpc","type":"multi","path":"vmsvc","tls":"tls"}`)
    m := تونل.تجزیه لینک(vm)
    سرچاپ "vmess:"، m.معتبر، m.نام سرویس، m.حالت جی آر پی سی
    k := وی مس.تجزیه پیوند(vm)
    سرچاپ "vmess settings:"، k.معتبر، وی مس.تنظیمات پیوند(k).نام سرویس، وی مس.تنظیمات پیوند(k).حالت جی آر پی سی
    سرچاپ "vmess round trip:"، تونل.تجزیه لینک(تونل.گره به لینک(m)).حالت جی آر پی سی
    re := وی لس.تجزیه پیوند("vless://" + UUID1 + "@203.0.113.7:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.microsoft.com&fp=chrome&pbk=" + PBK + "&sid=6ba85179e30d4fc2&spx=%2Fa%2Fb&alpn=h2%2Chttp%2F1.1&type=tcp")
    سرچاپ "reality:"، re.معتبر، re.ریلیتی.مسیر عنکبوتی، re.ریلیتی.پروتکل برنامه
پایان
