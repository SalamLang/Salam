بسته ریشه

واردسازی کدگذاری
واردسازی شبکه.تونل
واردسازی شبکه.شدوساکس

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"
پایا PBK := "Ah1AwxBG8mOMQ5zgUCSyb2TYOmrBfV8yi7cYOQm-1xQ"

تابع show(tag: رشته، n: تونل.گره):
    سرچاپ tag، n.معتبر، n.پروتکل، n.میزبان، n.درگاه، n.شبکه، n.امنیت، n.تی ال اس
    سرچاپ "  "، n.شناسه، n.گذرواژه، n.روش، n.شناسه جایگزین، n.جریان
    سرچاپ "  "، n.نام سرور، n.پروتکل برنامه، n.اثر انگشت، n.مسیر، n.سرآیند میزبان، n.نام سرویس، n.حالت جی آر پی سی
    سرچاپ "  "، n.کلید عمومی، n.شناسه کوتاه، n.مسیر عنکبوتی، n.اجازه ناامن، n.افزونه، n.توضیح
پایان

تابع ریشه:
    show("reality-persian"، تونل.تجزیه لینک("vless://" + UUID1 + "@203.0.113.9:443?encryption=none&flow=xtls-rprx-vision&security=reality&sni=www.microsoft.com&fp=chrome&pbk=" + PBK + "&sid=6ba85179e30d4fc2&spx=%2F&type=tcp#%D8%B3%D8%B1%D9%88%D8%B1%20%D8%A2%D9%84%D9%85%D8%A7%D9%86%20%DB%B1"))
    show("ipv6-host"، تونل.تجزیه لینک("vless://" + UUID1 + "@[2001:db8::1]:8443?encryption=none&security=tls&sni=h.example.com&type=tcp#v6"))
    show("grpc-multi"، تونل.تجزیه لینک("vless://" + UUID1 + "@g.example.com:443?encryption=none&security=tls&sni=g.example.com&type=grpc&serviceName=gsvc&mode=multi&authority=auth.example.com#g"))
    show("ws-insecure"، تونل.تجزیه لینک("vless://" + UUID1 + "@w.example.com:443?encryption=none&security=tls&sni=w.example.com&type=ws&host=w.example.com&path=%2Fws%3Fed%3D2048&allowInsecure=1&alpn=http%2F1.1#ws"))
    show("httpupgrade"، تونل.تجزیه لینک("vless://" + UUID1 + "@h.example.com:80?encryption=none&security=none&type=httpupgrade&host=h.example.com&path=%2Fup#hu"))
    show("trojan-pw"، تونل.تجزیه لینک("trojan://p%40ss%3Aw%2Fd@t.example.com:443?security=tls&sni=t.example.com&type=ws&host=t.example.com&path=%2Ft#t"))
    show("trojan-grpc"، تونل.تجزیه لینک("trojan://pw@t.example.com:443?security=tls&type=grpc&serviceName=tsvc&mode=multi#tg"))

    base := `"add":"vm.example.com","id":"` + UUID1 + `","net":"ws","host":"cdn.example.com","path":"/p","tls":"tls","ps":"vm"`
    show("vmess-num-port"، تونل.تجزیه لینک("vmess://" + کدگذاری.کدگذاری پایه۶۴(`{"v":"2","port":443,"aid":0,` + base + `}`)))
    show("vmess-str-port"، تونل.تجزیه لینک("vmess://" + کدگذاری.کدگذاری پایه۶۴(`{"v":"2","port":"8443","aid":"2",` + base + `}`)))
    raw := `{"v":"2","port":"443","aid":"0",` + base + `}`
    enc := کدگذاری.کدگذاری پایه۶۴(raw)
    show("vmess-padded"، تونل.تجزیه لینک("vmess://" + enc))
    ناپایا unpadded := enc
    تا unpadded.طول() بزرگتر 0 و unpadded.زیررشته(unpadded.طول() - 1، 1) برابر "=":
        unpadded = unpadded.زیررشته(0، unpadded.طول() - 1)
    پایان
    show("vmess-unpadded"، تونل.تجزیه لینک("vmess://" + unpadded))
    show("vmess-grpc-multi"، تونل.تجزیه لینک("vmess://" + کدگذاری.کدگذاری پایه۶۴(`{"v":"2","ps":"g","add":"g.example.com","port":"443","id":"` + UUID1 + `","aid":"0","net":"grpc","type":"multi","path":"vsvc","tls":"tls","sni":"g.example.com"}`)))

    show("ss-sip002"، تونل.تجزیه لینک("ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@192.0.2.1:8388#Plain%20SS"))
    show("ss-sip002-plugin"، تونل.تجزیه لینک("ss://Y2hhY2hhMjAtaWV0Zi1wb2x5MTMwNTpwdzEyMw@ss.example.org:1080/?plugin=obfs-local%3Bobfs%3Dhttp%3Bobfs-host%3Dwww.bing.com#p"))
    show("ss-legacy-v6"، تونل.تجزیه لینک("ss://" + کدگذاری.کدگذاری پایه۶۴("aes-128-gcm:pw:123@[2001:db8::5]:1080") + "#legacy"))
    key := "AAECAwQFBgcICQoLDA0ODw=="
    link22 := "ss://2022-blake3-aes-128-gcm:" + تونل.رمزگذاری درصدی(key) + "@198.51.100.4:8388#s22"
    show("ss-2022"، تونل.تجزیه لینک(link22))
    show("ss-2022-multi"، تونل.تجزیه لینک("ss://2022-blake3-aes-256-gcm:" + تونل.رمزگذاری درصدی("AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=") + ":" + تونل.رمزگذاری درصدی(key) + "@198.51.100.4:8388#m"))
    u := شدوساکس.تجزیه نشانی(link22)
    سرچاپ "uri:"، u.معتبر، u.روش، u.گذرواژه، u.میزبان، u.درگاه، u.برچسب
پایان
