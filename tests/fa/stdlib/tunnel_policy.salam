واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

ساختار Rebind:
    همگانی calls: صحیح* = پوچ

    همگانی تابع Lookup(_host: رشته): تونل.نتیجه جستجو:
        ناپایا r := تونل.نتیجه جستجو {}
        این.calls[0]++
        اگر این.calls[0] برابر 1:
            r.آی‌پی‌ها.بیفزا("127.0.0.1")
        وگرنه:
            r.آی‌پی‌ها.بیفزا("8.8.8.8")
        پایان
        برگشت r
    پایان
پایان

ساختار Mixed:
    همگانی unused: صحیح = 0

    همگانی تابع Lookup(_host: رشته): تونل.نتیجه جستجو:
        ناپایا r := تونل.نتیجه جستجو {}
        r.آی‌پی‌ها.بیفزا("93.184.216.34")
        r.آی‌پی‌ها.بیفزا("10.1.2.3")
        برگشت r
    پایان
پایان

تابع echo_once(p: تی سی پی.سرور*):
    c := تی سی پی.پذیرش(p[0])
    s := تی سی پی.خواندن(c، 100)
    _n := تی سی پی.نوشتن(c، "echo:" + s)
    تی سی پی.بستن(c)
پایان

تابع keep(s: تی سی پی.سرور): تی سی پی.سرور*:
    p := حافظه.تخصیص صفرشده(اندازه‌گونه(تی سی پی.سرور) برگردان طبیعی۶۴) برگردان تی سی پی.سرور*
    p[0] = s
    برگشت p
پایان

تابع show(label: رشته، ip: رشته):
    سرچاپ label، ip، تونل.نشانی خصوصی است(ip)
پایان

تابع ریشه:
    هر ip در ["127.0.0.1"، "127.255.255.254"، "10.0.0.1"، "172.16.0.1"، "172.31.255.255"، "172.32.0.1"، "192.168.1.1"، "100.64.0.1"، "100.127.255.255"، "100.128.0.1"، "169.254.169.254"، "0.0.0.0"، "0.1.2.3"، "224.0.0.1"، "239.255.255.250"، "255.255.255.255"، "8.8.8.8"، "93.184.216.34"، "1.1.1.1"]:
        show("v4"، ip)
    پایان
    هر ip در ["::1"، "::"، "fe80::1"، "fc00::1"، "fd12:3456::1"، "ff02::1"، "::ffff:127.0.0.1"، "::ffff:10.0.0.1"، "::ffff:8.8.8.8"، "::ffff:169.254.169.254"، "64:ff9b::7f00:1"، "2002:7f00:1::1"، "2001:db8::1"، "2606:4700:4700::1111"، "2001:4860:4860::8888"]:
        show("v6"، ip)
    پایان

    ناپایا p := تونل.سیاست مقصد جدید()
    سرچاپ "default 127.0.0.1:"، تونل.بررسی آی‌پی در سیاست(p، "127.0.0.1")
    سرچاپ "default public:"، تونل.بررسی آی‌پی در سیاست(p، "8.8.8.8")
    سرچاپ "localhost name:"، تونل.بررسی نام در سیاست(p، "localhost")، تونل.بررسی نام در سیاست(p، "a.localhost")، تونل.بررسی نام در سیاست(p، "example.com")
    تونل.اجازه آدرس‌های خصوصی در سیاست(p، درست)
    سرچاپ "allow_private on a public bind:"، تونل.بررسی آی‌پی در سیاست(تونل.سیاست برای نشانی شنود(p، "0.0.0.0")، "127.0.0.1")
    سرچاپ "allow_private on loopback bind:"، تونل.بررسی آی‌پی در سیاست(تونل.سیاست برای نشانی شنود(p، "127.0.0.1")، "127.0.0.1")
    سرچاپ "allow_private on ::1 bind:"، تونل.بررسی آی‌پی در سیاست(تونل.سیاست برای نشانی شنود(p، "::1")، "10.0.0.1")
    سرچاپ "loopback hosts:"، تونل.میزبان حلقه محلی است("127.0.0.1")، تونل.میزبان حلقه محلی است("::1")، تونل.میزبان حلقه محلی است("0.0.0.0")، تونل.میزبان حلقه محلی است("::")، تونل.میزبان حلقه محلی است("192.168.0.2")

    ناپایا q := تونل.سیاست مقصد جدید()
    سرچاپ "bad cidr:"، تونل.افزودن بازه مجاز(q، "10.0.0.0/33")، تونل.افزودن بازه ممنوع(q، "nonsense")
    سرچاپ "allow cidr:"، تونل.افزودن بازه مجاز(q، "10.9.0.0/16")
    سرچاپ "inside the exception:"، تونل.بررسی آی‌پی در سیاست(q، "10.9.4.4")، "outside:"، تونل.بررسی آی‌پی در سیاست(q، "10.8.4.4")
    سرچاپ "mapped form of the exception:"، تونل.بررسی آی‌پی در سیاست(q، "::ffff:10.9.4.4")
    سرچاپ "deny cidr:"، تونل.افزودن بازه ممنوع(q، "8.8.8.0/24")
    سرچاپ "denied public:"، تونل.بررسی آی‌پی در سیاست(q، "8.8.8.8")، "other public:"، تونل.بررسی آی‌پی در سیاست(q، "8.8.4.4")
    سرچاپ "deny wins over allow:"، تونل.افزودن بازه ممنوع(q، "10.9.4.0/24")، تونل.بررسی آی‌پی در سیاست(q، "10.9.4.4")، تونل.بررسی آی‌پی در سیاست(q، "10.9.5.4")
    تونل.افزودن پسوند ممنوع(q، "*.Blocked.Example.")
    تونل.افزودن پسوند مجاز(q، ".internal.example")
    سرچاپ "suffix:"، تونل.بررسی نام در سیاست(q، "blocked.example")، تونل.بررسی نام در سیاست(q، "a.b.BLOCKED.example.")، تونل.بررسی نام در سیاست(q، "notblocked.example")، تونل.بررسی نام در سیاست(q، "x.internal.example")

    ناپایا r := تونل.سیاست مقصد جدید()
    سرچاپ "literal plan:"، تونل.طرح سیاست(r، تونل.نشانی جدید("10.0.0.1"، 80)، درست).مجاز، تونل.طرح سیاست(r، تونل.نشانی جدید("8.8.8.8"، 80)، درست).مجاز
    سرچاپ "localhost resolves to a forbidden address:"، تونل.طرح سیاست(r، تونل.نشانی جدید("localhost"، 80)، درست).مجاز
    سرچاپ "short loopback name 127.1:"، تونل.طرح سیاست(r، تونل.نشانی جدید("127.1"، 80)، درست).مجاز
    سرچاپ "decimal loopback name:"، تونل.طرح سیاست(r، تونل.نشانی جدید("2130706433"، 80)، درست).مجاز
    سرچاپ "name without local resolution:"، تونل.طرح سیاست(r، تونل.نشانی جدید("example.com"، 80)، نادرست).مجاز
    تونل.تعیین حل‌کننده سیاست(r، Mixed {})
    pm := تونل.طرح سیاست(r، تونل.نشانی جدید("mixed.test"، 80)، درست)
    سرچاپ "one forbidden answer rejects the name:"، pm.مجاز، pm.آی‌پی‌ها.طول()

    srv := تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(srv)
    t1 := نخ‌ساز(echo_once، keep(srv))
    ناپایا open := تونل.سیاست مقصد جدید()
    سرچاپ "guard refuses loopback:"، تونل.نگهبان(تونل.مستقیم()، open).اتصال بررسی‌شده(تونل.نشانی جدید("127.0.0.1"، port)).ردشده
    تونل.اجازه آدرس‌های خصوصی در سیاست(open، درست)
    سرچاپ "guard refuses with allow_private but no loopback bind:"، تونل.نگهبان(تونل.مستقیم()، open).اتصال بررسی‌شده(تونل.نشانی جدید("127.0.0.1"، port)).ردشده
    ok := تونل.نگهبان(تونل.مستقیم()، تونل.سیاست برای نشانی شنود(open، "127.0.0.1"))
    s := ok.اتصال(تونل.نشانی جدید("127.0.0.1"، port))
    سرچاپ "guard allows it on a loopback bind:"، s.معتبر()
    _w := s.نوشتن("ping")
    سرچاپ s.خواندن(100)
    s.بستن()
    نخ‌پیوند(t1)

    calls := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح*
    srv2 := تی سی پی.پیوند(0)
    port2 := تی سی پی.درگاه(srv2)
    t2 := نخ‌ساز(echo_once، keep(srv2))
    ناپایا rb := تونل.سیاست مقصد جدید()
    تونل.افزودن بازه مجاز(rb، "127.0.0.0/8")
    تونل.تعیین حل‌کننده سیاست(rb، Rebind { calls = calls })
    g := تونل.نگهبان(تونل.مستقیم()، rb)
    s2 := g.اتصال(تونل.نشانی جدید("rebind.test"، port2))
    سرچاپ "dialed the address that was checked:"، s2.معتبر()، "lookups"، calls[0]
    _w2 := s2.نوشتن("again")
    سرچاپ s2.خواندن(100)
    s2.بستن()
    نخ‌پیوند(t2)
    denied := g.اتصال بررسی‌شده(تونل.نشانی جدید("deny.test"، port2))
    سرچاپ "a later lookup is a separate resolution:"، denied.ردشده، calls[0]
پایان
