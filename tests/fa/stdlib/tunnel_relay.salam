بسته ریشه

واردسازی شبکه.تونل
واردسازی شبکه.تی سی پی
واردسازی شبکه.وب‌سوکت
واردسازی تی ال اس
واردسازی همگام سازی
واردسازی حافظه
واردسازی استخر
واردسازی رشته

ناپایا failures := 0
ناپایا echo_server := تی سی پی.سرور {}
ناپایا hop_server := تی سی پی.سرور {}
ناپایا hop_log := ""
ناپایا ws_server := وب‌سوکت.سرور {}
ناپایا ws_seen := ""

ساختار LineProtocol:
    همگانی unused: صحیح = 0

    همگانی تابع Name(): رشته:
        برگشت "line"
    پایان

    همگانی تابع Handshake(s: پویا تونل.جریان): تونل.نشست:
        line := تونل.خواندن با جداکننده(s، "\n"، 200)
        اگر وارونه line.شروع با("CONNECT "):
            برگشت تونل.نشست { خطا = "bad request" }
        پایان
        a := تونل.تجزیه نشانی(line.زیررشته(8، line.طول() - 9))
        اگر وارونه a.معتبر:
            برگشت تونل.نشست { خطا = "bad address" }
        پایان
        برگشت تونل.نشست { موفق = درست، مقصد = a، پروتکل = "line" }
    پایان

    همگانی تابع Reply(s: پویا تونل.جریان، _sess: تونل.نشست، ok: منطقی):
        اگر ok:
            s.نوشتن("OK\n")
        وگرنه:
            s.نوشتن("ERR\n")
        پایان
    پایان
پایان

ساختار Tagger:
    همگانی nick: رشته = ""

    همگانی تابع Name(): رشته:
        برگشت این.nick
    پایان

    همگانی تابع Handshake(s: پویا تونل.جریان): تونل.نشست:
        c := تونل.خواندن یک بایت(s)
        برگشت تونل.نشست { موفق = درست، مقصد = تونل.نشانی جدید("x.test"، c)، پروتکل = این.nick }
    پایان

    همگانی تابع Reply(s: پویا تونل.جریان، sess: تونل.نشست، ok: منطقی):
        اگر ok:
            s.نوشتن("reply:" + sess.پروتکل)
        پایان
    پایان
پایان

ساختار HopConnector:
    همگانی hname: رشته = ""
    همگانی hport: صحیح = 0
    همگانی hlabel: رشته = ""

    همگانی تابع Server(): تونل.نشانی:
        برگشت تونل.نشانی جدید(این.hname، این.hport)
    پایان

    همگانی تابع Handshake(s: پویا تونل.جریان، target: تونل.نشانی): منطقی:
        s.نوشتن("HOP " + این.hlabel + " " + target.متن() + "\n")
        reply := تونل.خواندن با جداکننده(s، "\n"، 50)
        برگشت reply برابر "OK\n"
    پایان

    همگانی تابع Name(): رشته:
        برگشت این.hlabel
    پایان
پایان

تابع expect(label: رشته، ok: منطقی):
    اگر وارونه ok:
        سرچاپ "FAIL"، label
        failures++
    پایان
پایان

تابع echo_once():
    c := تی سی پی.پذیرش(echo_server)
    s := تونل.پوشاندن تی سی پی(c)
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    تا درست:
        n := s.خواندن بایت(buf، 4096)
        اگر n کوچکتربرابر 0: بشکن پایان
        s.نوشتن بایت(buf، n)
    پایان
    حافظه.آزادسازی(buf)
    s.بستن()
پایان

تابع hop_once():
    c := تی سی پی.پذیرش(hop_server)
    s := تونل.پوشاندن تی سی پی(c)
    تکرار 2:
        line := تونل.خواندن با جداکننده(s، "\n"، 200)
        hop_log += line
        s.نوشتن("OK\n")
    پایان
    data := s.خواندن(100)
    s.نوشتن("end:" + data)
    s.بستن()
پایان

تابع ws_once():
    c := وب‌سوکت.پذیرش(ws_server)
    s := تونل.پوشاندن وب‌سوکت(c)
    first := s.خواندن(5)
    rest := s.خواندن(100)
    ws_seen = first + "|" + rest
    s.نوشتن("pong:" + first + rest)
    s.بستن()
پایان

تابع run_relay(a: پویا تونل.جریان، b: پویا تونل.جریان، st: تونل.آمار، idle: صحیح):
    r := تونل.رله با آمار(a، b، st، idle)
    سرچاپ "relay"، r.بارگذاری، r.دریافت
پایان

تابع pipe_relay():
    p1 := تونل.لوله جدید()
    p2 := تونل.لوله جدید()
    client := تونل.سر اول لوله(p1)
    left := تونل.سر دوم لوله(p1)
    right := تونل.سر اول لوله(p2)
    server := تونل.سر دوم لوله(p2)
    st := تونل.آمار جدید()
    wp := استخر.جدید کشسان(2 برگردان صحیح۶۴، 8 برگردان صحیح۶۴، 8 برگردان صحیح۶۴)
    total := 200000
    data := حافظه.تخصیص(total برگردان طبیعی۶۴)
    تکرار total در i:
        (data برگردان طبیعی۸*)[i] = ((i * 7 + 3) % 251) برگردان طبیعی۸
    پایان
    استخر.ارسال(wp، (): run_relay(left، right، st، 5000) پایان)
    استخر.ارسال(wp، (): push(client، data، total) پایان)
    got := حافظه.تخصیص(total برگردان طبیعی۶۴)
    ok := تونل.خواندن کامل(server، got، total)
    ناپایا same := ok
    تکرار total در i:
        اگر (got برگردان طبیعی۸*)[i] نابرابر (data برگردان طبیعی۸*)[i]: same = نادرست پایان
    پایان
    سرچاپ "forward"، ok، same
    expect("forward data"، same)
    server.نوشتن("reply-from-server")
    سرچاپ client.خواندن(100)
    client.بستن()
    استخر.انتظار(wp)
    استخر.توقف(wp)
    سرچاپ st.خلاصه()
    حافظه.آزادسازی(got)
    حافظه.آزادسازی(data)
پایان

تابع push(s: پویا تونل.جریان، data: تهی*، n: صحیح):
    تونل.نوشتن همه بایت‌ها(s، data، n)
پایان

تابع idle_relay():
    p1 := تونل.لوله جدید()
    p2 := تونل.لوله جدید()
    st := تونل.آمار جدید()
    start := همگام سازی.اکنون میلی ثانیه()
    r := تونل.رله با آمار(تونل.سر دوم لوله(p1)، تونل.سر اول لوله(p2)، st، 300)
    took := همگام سازی.اکنون میلی ثانیه() - start
    سرچاپ "idle"، r.بارگذاری، r.دریافت، took بزرگتربرابر 250، took کوچکتر 3000
    tm := تونل.زمان‌سنج بیکاری جدید(100 برگردان صحیح۶۴)
    سرچاپ tm.منقضی شده()
    همگام سازی.خواب میلی ثانیه(160)
    سرچاپ tm.منقضی شده()، tm.میلی‌ثانیه بیکاری() بزرگتربرابر 150
    tm.ثبت فعالیت()
    سرچاپ tm.منقضی شده()
    tm.آزادسازی()
    سرچاپ تونل.زمان‌سنج بیکاری جدید(0 برگردان صحیح۶۴).منقضی شده()
    expect("pipe deadline"، deadline_ok())
پایان

تابع deadline_ok(): منطقی:
    p := تونل.لوله جدید()
    a := تونل.سر اول لوله(p)
    a.تنظیم مهلت(100)
    start := همگام سازی.اکنون میلی ثانیه()
    buf := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    n := a.خواندن بایت(buf، 8)
    حافظه.آزادسازی(buf)
    برگشت n کوچکتر 0 و همگام سازی.اکنون میلی ثانیه() - start بزرگتربرابر 80
پایان

تابع tcp_inbound():
    echo_server = تی سی پی.پیوند(0)
    echo_port := تی سی پی.درگاه(echo_server)
    et := نخ‌ساز(echo_once)
    inb := تونل.شنود تی سی پی(0)
    سرچاپ "listening"، inb.معتبر()، inb.درگاه بزرگتر 0
    fwd := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، LineProtocol {})
    تونل.سرویس‌دهی پس‌زمینه(inb، LineProtocol {}، fwd)

    bad := تونل.اتصال تی سی پی("127.0.0.1"، inb.درگاه، 2000)
    bad.نوشتن("CONNECT 127.0.0.1:1\n")
    سرچاپ "refused:"، تونل.خواندن با جداکننده(bad، "\n"، 10) برابر "ERR\n"
    bad.بستن()
    junk := تونل.اتصال تی سی پی("127.0.0.1"، inb.درگاه، 2000)
    junk.نوشتن("HELLO\n")
    سرچاپ "junk closed:"، junk.خواندن(10) برابر ""
    junk.بستن()

    c := تونل.اتصال تی سی پی("127.0.0.1"، inb.درگاه، 2000)
    c.نوشتن("CONNECT 127.0.0.1:" + echo_port + "\n")
    سرچاپ "reply:"، تونل.خواندن با جداکننده(c، "\n"، 10) برابر "OK\n"
    c.نوشتن("through the tunnel")
    سرچاپ c.خواندن(100)
    c.بستن()
    نخ‌پیوند(et)
    ناپایا waited := 0
    تا waited کوچکتر 3000 و (fwd.آمار.شمار فعال() بزرگتر 0 یا fwd.آمار.بایت دریافت() کوچکتر 18 برگردان صحیح۶۴):
        همگام سازی.خواب میلی ثانیه(10)
        waited += 10
    پایان
    سرچاپ "stats"، fwd.آمار.شمار کل()، fwd.آمار.شمار ناموفق()، fwd.آمار.شمار فعال()، fwd.آمار.بایت بارگذاری()، fwd.آمار.بایت دریافت()
    inb.توقف()
    تی سی پی.بستن سرور(echo_server)
پایان

تابع mixed():
    سرچاپ تونل.تشخیص ترکیبی(5)، تونل.تشخیص ترکیبی(4)، تونل.تشخیص ترکیبی(71)، تونل.تشخیص ترکیبی(67)، تونل.تشخیص ترکیبی(112)، تونل.تشخیص ترکیبی(0)، تونل.تشخیص ترکیبی(22)، تونل.تشخیص ترکیبی(255)
    ناپایا m := تونل.ترکیبی جدید()
    تونل.تنظیم ساکس۵ ترکیبی(m، Tagger { nick = "s5" })
    تونل.تنظیم ساکس۴ ترکیبی(m، Tagger { nick = "s4" })
    تونل.تنظیم اچ تی تی پی ترکیبی(m، Tagger { nick = "http" })
    هر first در [5، 4، 71، 67، 80، 22]:
        p := تونل.لوله جدید()
        a := تونل.سر اول لوله(p)
        b := تونل.سر دوم لوله(p)
        a.نوشتن(تونل.متن بایت(first) + "\x37")
        sess := m.دست‌دهی(b)
        سرچاپ first، sess.موفق، sess.پروتکل، sess.مقصد.درگاه
        اگر sess.موفق:
            m.پاسخ(b، sess، درست)
            سرچاپ a.خواندن(20)
        پایان
    پایان
    ناپایا only5 := تونل.ترکیبی جدید()
    تونل.تنظیم ساکس۵ ترکیبی(only5، Tagger { nick = "s5" })
    p := تونل.لوله جدید()
    تونل.سر اول لوله(p).نوشتن("GET / HTTP/1.1\r\n")
    سرچاپ only5.دست‌دهی(تونل.سر دوم لوله(p)).موفق
    q := تونل.لوله جدید()
    تونل.سر اول لوله(q).بستن()
    سرچاپ only5.دست‌دهی(تونل.سر دوم لوله(q)).خطا
    سرچاپ m.نام()
پایان

تابع chain():
    hop_server = تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(hop_server)
    ht := نخ‌ساز(hop_once)
    ناپایا ch := تونل.زنجیره جدید(تونل.مستقیم())
    تونل.افزودن گام(ch، HopConnector { hname = "127.0.0.1"، hport = port، hlabel = "h1" })
    تونل.افزودن گام(ch، HopConnector { hname = "next-hop.test"، hport = 8443، hlabel = "h2" })
    سرچاپ ch.نام()
    s := ch.اتصال(تونل.نشانی جدید("final.test"، 443))
    سرچاپ "chain ok"، s.معتبر()
    s.نوشتن("payload")
    سرچاپ s.خواندن(100)
    s.بستن()
    نخ‌پیوند(ht)
    تی سی پی.بستن سرور(hop_server)
    سرچاپ رشته.جایگزینی(hop_log، "\n"، "|")
    سرچاپ تونل.زنجیره جدید(تونل.مسدود()).اتصال(تونل.نشانی جدید("a.test"، 1)).معتبر()
    dead := تونل.زنجیره جدید(تونل.مستقیم())
    سرچاپ dead.نام()، تونل.از طریق(تونل.مستقیم()، HopConnector { hname = "127.0.0.1"، hport = 1، hlabel = "x" }).اتصال(تونل.نشانی جدید("a.test"، 1)).معتبر()
پایان

تابع dialers():
    blk := تونل.شماره‌گیر مسدودکننده {}
    سرچاپ blk.اتصال(تونل.نشانی جدید("a.test"، 1)).معتبر()، blk.اتصال(تونل.نشانی جدید("a.test"، 1)).معتبر()، blk.ردشده، blk.نام()
    d := تونل.شماره‌گیر مستقیم { مهلت اتصال = 500 }
    سرچاپ d.اتصال(تونل.نشانی {}).معتبر()، d.نام()
    srv := تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(srv)
    ناپایا fb := تونل.جایگزین جدید()
    تونل.افزودن جایگزین(fb، تونل.مسدود())
    تونل.افزودن جایگزین(fb، تونل.مستقیم())
    s := fb.اتصال(تونل.نشانی جدید("127.0.0.1"، port))
    سرچاپ "fallback"، s.معتبر()، fb.نام()
    s.بستن()
    تی سی پی.بستن سرور(srv)
    c := تونل.جریان مسدود {}
    سرچاپ c.معتبر()، c.خواندن(5) برابر ""، c.نوشتن("x")
پایان

تابع websocket_stream():
    ws_server = وب‌سوکت.شنود(0)
    port := وب‌سوکت.درگاه(ws_server)
    wt := نخ‌ساز(ws_once)
    c := وب‌سوکت.شماره گیری("127.0.0.1"، port، "/t")
    s := تونل.پوشاندن وب‌سوکت(c)
    سرچاپ s.معتبر()
    s.نوشتن("hello world, this is long")
    سرچاپ s.خواندن(4)، s.خواندن(4)، s.خواندن(100)
    نخ‌پیوند(wt)
    سرچاپ ws_seen
    s.بستن()
    وب‌سوکت.بستن سرور(ws_server)
    t := تونل.پوشاندن تی ال اس(تی ال اس.اتصال {})
    سرچاپ t.معتبر()
پایان

تابع ریشه:
    pipe_relay()
    idle_relay()
    tcp_inbound()
    mixed()
    chain()
    dialers()
    websocket_stream()
    سرچاپ "failures"، failures
    برگشت failures
پایان
