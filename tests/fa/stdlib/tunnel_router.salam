بسته ریشه

واردسازی شبکه.تونل

ناپایا failures := 0

تابع check(rt: تونل.مسیریاب، host: رشته، port: صحیح، want: رشته):
    got := rt.تطبیق میزبان(host، port)
    اگر got نابرابر want:
        سرچاپ "MISMATCH"، host، port، "got"، got، "want"، want
        failures++
    پایان
پایان

تابع iran():
    rt := تونل.مسیریاب ایران("direct"، "proxy")
    check(rt، "divar.ir"، 443، "direct")
    check(rt، "www.digikala.ir"، 443، "direct")
    check(rt، "WWW.SNAPP.IR"، 443، "direct")
    check(rt، "ایران.ir"، 80، "direct")
    check(rt، "aparat.com"، 443، "direct")
    check(rt، "cdn.aparat.com"، 443، "direct")
    check(rt، "notaparat.com"، 443، "proxy")
    check(rt، "evilir"، 443، "proxy")
    check(rt، "ir.example.com"، 443، "proxy")
    check(rt، "google.com"، 443، "proxy")
    check(rt، "10.1.2.3"، 80، "direct")
    check(rt، "172.16.0.1"، 80، "direct")
    check(rt، "172.32.0.1"، 80، "proxy")
    check(rt، "192.168.100.100"، 80، "direct")
    check(rt، "192.169.0.1"، 80، "proxy")
    check(rt، "127.0.0.1"، 1080، "direct")
    check(rt، "169.254.1.1"، 80، "direct")
    check(rt، "100.64.0.1"، 80، "direct")
    check(rt، "100.128.0.1"، 80، "proxy")
    check(rt، "8.8.8.8"، 53، "proxy")
    check(rt، "::1"، 80، "direct")
    check(rt، "[fe80::abcd]"، 80، "direct")
    check(rt، "fd12:3456::1"، 80، "direct")
    check(rt، "2001:4860:4860::8888"، 53، "proxy")
    check(rt، "localhost"، 3000، "direct")
    سرچاپ "iran ok"
پایان

تابع rules():
    text := "# comment line\n\nDOMAIN,Exact.Example.com,exact\nDOMAIN-SUFFIX,.example.org,suffix\nDOMAIN-KEYWORD,tracker,block\nDOMAIN-REGEX,^img[0-9]{2}\\.cdn\\.شبکه$,cdn\nIP-CIDR,203.0.113.0/24,doc4\nIP-CIDR6,2001:db8::/32,doc6\nGEOIP,PRIVATE,lan\nDST-PORT,22,ssh\nDST-PORT,8000-8100,dev\nPORT,25;1,x\nbroken line\nFINAL,fallback\n"
    set := تونل.تجزیه قاعده‌ها(text، "none")
    سرچاپ "errors"، set.خطاها.طول()، "rules"، set.مسیریاب.قاعده‌ها.طول()، "default"، set.مسیریاب.برچسب پیش‌فرض
    هر e در set.خطاها:
        سرچاپ e
    پایان
    rt := set.مسیریاب
    check(rt، "exact.example.com"، 443، "exact")
    check(rt، "EXACT.example.com."، 443، "exact")
    check(rt، "sub.exact.example.com"، 443، "fallback")
    check(rt، "example.org"، 443، "suffix")
    check(rt، "a.سر دوم.example.org"، 443، "suffix")
    check(rt، "myexample.org"، 443، "fallback")
    check(rt، "ad-tracker.شبکه"، 443، "block")
    check(rt، "img12.cdn.شبکه"، 443، "cdn")
    check(rt، "img1.cdn.شبکه"، 443، "fallback")
    check(rt، "img123.cdn.شبکه"، 443، "fallback")
    check(rt، "203.0.113.77"، 443، "doc4")
    check(rt، "203.0.114.1"، 443، "fallback")
    check(rt، "2001:db8:abcd::1"، 443، "doc6")
    check(rt، "2001:db9::1"، 443، "fallback")
    check(rt، "10.9.9.9"، 443، "lan")
    check(rt، "unknown.test"، 22، "ssh")
    check(rt، "unknown.test"، 8050، "dev")
    check(rt، "unknown.test"، 8101، "fallback")
    check(rt، "10.9.9.9"، 22، "lan")
    سرچاپ "rules ok"
پایان

تابع combined():
    ناپایا rt := تونل.مسیریاب جدید("proxy")
    ناپایا r := تونل.قاعده جدید("direct")
    تونل.قاعده پسوند(r، "*.corp.test")
    تونل.قاعده درگاه(r، "443,8443")
    تونل.افزودن قاعده(rt، r)
    ناپایا p := تونل.قاعده جدید("block")
    تونل.قاعده درگاه(p، "25")
    تونل.افزودن قاعده(rt، p)
    ناپایا k := تونل.قاعده جدید("direct")
    سرچاپ تونل.قاعده سی‌آی‌دی‌آر(k، "10.0.0.0/33")، تونل.قاعده سی‌آی‌دی‌آر(k، "nonsense")، تونل.قاعده سی‌آی‌دی‌آر(k، "10.0.0.0/8")، تونل.قاعده سی‌آی‌دی‌آر(k، "10.1.2.3")، تونل.قاعده سی‌آی‌دی‌آر(k، "::/0")
    سرچاپ تونل.قاعده عبارت باقاعده(k، "(unclosed")، تونل.قاعده درگاه(k، "70000")، تونل.قاعده درگاه(k، "9-3")، تونل.قاعده درگاه(k، "x")
    check(rt، "git.corp.test"، 443، "direct")
    check(rt، "git.corp.test"، 8443، "direct")
    check(rt، "git.corp.test"، 80، "proxy")
    check(rt، "other.test"، 443، "proxy")
    check(rt، "other.test"، 25، "block")
    empty := تونل.قاعده جدید("x")
    سرچاپ تونل.قاعده مطابقت دارد(empty، تونل.نشانی جدید("a.com"، 80))
    سرچاپ تونل.مسیریاب ایران("d"، "p").قاعده‌ها.طول()
    سرچاپ "combined ok"
پایان

تابع v2ray():
    ناپایا r := تونل.قاعده جدید("direct")
    سرچاپ تونل.قاعده دامنه با پیشوند(r، "domain:example.شبکه")، تونل.قاعده دامنه با پیشوند(r، "full:www.سر اول.test")، تونل.قاعده دامنه با پیشوند(r، "keyword:cdn")، تونل.قاعده دامنه با پیشوند(r، "regexp:^x[0-9]+\\.t$")، تونل.قاعده دامنه با پیشوند(r، "plainword")، تونل.قاعده دامنه با پیشوند(r، "regexp:(")
    سرچاپ تونل.قاعده آی‌پی با پیشوند(r، "geoip:private")، تونل.قاعده آی‌پی با پیشوند(r، "198.51.100.0/24")، تونل.قاعده آی‌پی با پیشوند(r، "bad")
    ناپایا rt := تونل.مسیریاب جدید("proxy")
    تونل.افزودن قاعده(rt، r)
    check(rt، "a.example.شبکه"، 80، "direct")
    check(rt، "www.سر اول.test"، 80، "direct")
    check(rt، "sub.www.سر اول.test"، 80، "proxy")
    check(rt، "mycdn.org"، 80، "direct")
    check(rt، "x77.t"، 80، "direct")
    check(rt، "198.51.100.9"، 80، "direct")
    check(rt، "198.51.101.9"، 80، "proxy")
    سرچاپ "v2ray ok"
پایان

تابع ریشه:
    iran()
    rules()
    combined()
    v2ray()
    سرچاپ "failures"، failures
    برگشت failures
پایان
