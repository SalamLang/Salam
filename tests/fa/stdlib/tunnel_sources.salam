واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

ناپایا table := تونل.جدول مبداها جدید()
ناپایا done := همگام سازی.گروه انتظار جدید()

تابع churn(p: صحیح*):
    تکرار p[0]:
        اگر تونل.ورود مبدا(table، "198.51.100.7"، 1000):
            تونل.خروج مبدا(table، "198.51.100.7")
        پایان
    پایان
    همگام سازی.اتمام(done)
پایان

تابع closed_by_peer(c: تی سی پی.اتصال شبکه، wait_ms: صحیح): منطقی:
    تی سی پی.تنظیم مهلت خواندن(c، wait_ms)
    buf := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    n := تی سی پی.خواندن بایت(c، buf، 8)
    حافظه.آزادسازی(buf)
    برگشت n برابر 0
پایان

تابع ریشه:
    سرچاپ "first two in:"، تونل.ورود مبدا(table، "203.0.113.1"، 2)، تونل.ورود مبدا(table، "203.0.113.1"، 2)
    سرچاپ "third refused:"، تونل.ورود مبدا(table، "203.0.113.1"، 2)
    سرچاپ "another source is separate:"، تونل.ورود مبدا(table، "203.0.113.2"، 2)
    تونل.خروج مبدا(table، "203.0.113.1")
    سرچاپ "a slot freed by Leave:"، تونل.ورود مبدا(table، "203.0.113.1"، 2)
    سرچاپ "no limit:"، تونل.ورود مبدا(table، "203.0.113.3"، 0)، تونل.ورود مبدا(table، "203.0.113.3"، 0)، تونل.ورود مبدا(table، ""، 1)، تونل.ورود مبدا(table، ""، 1)
    همگام سازی.افزودن(done، 4 برگردان صحیح۶۴)
    n := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح*
    n[0] = 500
    تکرار 4:
        _h := نخ‌ساز(churn، n)
    پایان
    همگام سازی.انتظار(done)
    سرچاپ "threads leave no count behind:"، تونل.ورود مبدا(table، "198.51.100.7"، 1)، تونل.ورود مبدا(table، "198.51.100.7"، 1)

    ناپایا inb := تونل.شنود تی سی پی(0)
    inb.سقف مبدا = 2
    inb.مهلت دست‌دهی = 1500
    fwd := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، ساکس.ورودی جدید(ساکس.پیکربندی سرور جدید(0)))
    تونل.سرویس‌دهی پس‌زمینه(inb، ساکس.ورودی جدید(ساکس.پیکربندی سرور جدید(0))، fwd)
    a := تی سی پی.شماره گیری("127.0.0.1"، inb.درگاه)
    b := تی سی پی.شماره گیری("127.0.0.1"، inb.درگاه)
    c := تی سی پی.شماره گیری("127.0.0.1"، inb.درگاه)
    همگام سازی.خواب میلی ثانیه(300)
    سرچاپ "the third silent connection is refused at once:"، closed_by_peer(c، 400)
    سرچاپ "the first two are still waiting:"، وارونه closed_by_peer(a، 100)، وارونه closed_by_peer(b، 100)
    سرچاپ "the handshake deadline closes them:"، closed_by_peer(a، 3000)، closed_by_peer(b، 500)
    d := تی سی پی.شماره گیری("127.0.0.1"، inb.درگاه)
    سرچاپ "a new connection is accepted again:"، وارونه closed_by_peer(d، 300)
    تی سی پی.بستن(d)
    inb.توقف()
پایان
