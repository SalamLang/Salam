بسته ریشه

واردسازی شبکه.تونل
واردسازی شبکه.تی سی پی
واردسازی تی ال اس
واردسازی استخر
واردسازی حافظه

پایا TOTAL := 600000

ناپایا failures := 0
ناپایا echo_srv := تی سی پی.سرور {}
ناپایا tls_srv := تی سی پی.سرور {}
ناپایا srv_cfg := تی ال اس.پیکربندی کارساز {}
ناپایا sent_sum := 0 برگردان صحیح۶۴
ناپایا relayed_up := 0 برگردان صحیح۶۴
ناپایا relayed_down := 0 برگردان صحیح۶۴

تابع expect(label: رشته، ok: منطقی):
    اگر وارونه ok:
        سرچاپ "FAIL"، label
        failures++
    پایان
پایان

تابع echo_once():
    c := تی سی پی.پذیرش(echo_srv)
    s := تونل.پوشاندن تی سی پی(c)
    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    تا درست:
        n := s.خواندن بایت(buf، 8192)
        اگر n کوچکتربرابر 0: بشکن پایان
        اگر s.نوشتن بایت(buf، n) نابرابر n: بشکن پایان
    پایان
    حافظه.آزادسازی(buf)
    s.بستن نوشتن()
    s.بستن()
پایان

تابع run_relay(a: پویا تونل.جریان، b: پویا تونل.جریان، up: منطقی):
    r := تونل.رله(a، b)
    اگر up:
        relayed_up = r.up + r.down
    وگرنه:
        relayed_down = r.up + r.down
    پایان
پایان

تابع tls_server_side():
    c := تی سی پی.پذیرش(tls_srv)
    conn := تی ال اس.پوشش کارساز(c.fd، srv_cfg)
    اگر وارونه تی ال اس.اتصال معتبر(conn):
        سرچاپ "server handshake failed"، تی ال اس.خطای اتصال(conn)
        failures++
        تی سی پی.بستن(c)
        برگشت
    پایان
    front := تونل.پوشاندن تی ال اس(conn)
    back := تونل.اتصال تی سی پی("127.0.0.1"، تی سی پی.درگاه(echo_srv)، 3000)
    run_relay(front، back، نادرست)
پایان

تابع pump_pattern(s: پویا تونل.جریان):
    chunk := 4096
    buf := حافظه.تخصیص(chunk برگردان طبیعی۶۴)
    ناپایا sent := 0
    ناپایا sum := 0 برگردان صحیح۶۴
    تا sent کوچکتر TOTAL:
        ناپایا n := TOTAL - sent
        اگر n بزرگتر chunk: n = chunk پایان
        تکرار n در i:
            b := ((sent + i) * 31 + 7) % 251
            (buf برگردان طبیعی۸*)[i] = b برگردان طبیعی۸
            sum += b برگردان صحیح۶۴
        پایان
        اگر وارونه تونل.نوشتن همه بایت‌ها(s، buf، n): بشکن پایان
        sent += n
    پایان
    sent_sum = sum
    s.بستن نوشتن()
    حافظه.آزادسازی(buf)
پایان

تابع ریشه:
    echo_srv = تی سی پی.پیوند(0)
    tls_srv = تی سی پی.پیوند(0)
    srv_cfg = تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    سرچاپ "server config ok:"، srv_cfg.ok
    wp := استخر.جدید کشسان(2 برگردان صحیح۶۴، 8 برگردان صحیح۶۴، 8 برگردان صحیح۶۴)
    استخر.ارسال(wp، (): echo_once() پایان)
    استخر.ارسال(wp، (): tls_server_side() پایان)

    ناپایا cfg := تی ال اس.پیکربندی جدید("localhost")
    cfg.insecure_skip_verify = درست
    conn := تی ال اس.اتصال امن("127.0.0.1"، تی سی پی.درگاه(tls_srv)، cfg)
    سرچاپ "client handshake:"، تی ال اس.اتصال معتبر(conn)
    expect("handshake"، تی ال اس.اتصال معتبر(conn))
    p := تونل.لوله جدید()
    uplink := تونل.پوشاندن تی ال اس(conn)
    استخر.ارسال(wp، (): run_relay(تونل.سر دوم لوله(p)، uplink، درست) پایان)
    app := تونل.سر اول لوله(p)
    استخر.ارسال(wp، (): pump_pattern(app) پایان)

    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    ناپایا got := 0
    ناپایا sum := 0 برگردان صحیح۶۴
    تا درست:
        n := app.خواندن بایت(buf، 8192)
        اگر n کوچکتربرابر 0: بشکن پایان
        تکرار n در i:
            sum += (buf برگردان طبیعی۸*)[i] برگردان صحیح۶۴
        پایان
        got += n
    پایان
    حافظه.آزادسازی(buf)
    سرچاپ "echoed bytes:"، got
    استخر.انتظار(wp)
    استخر.توقف(wp)
    سرچاپ "all bytes back:"، got برابر TOTAL
    سرچاپ "checksum equal:"، sum برابر sent_sum
    سرچاپ "relay counts:"، relayed_up برابر (2 * TOTAL) برگردان صحیح۶۴، relayed_down برابر (2 * TOTAL) برگردان صحیح۶۴
    expect("all bytes"، got برابر TOTAL)
    expect("checksum"، sum برابر sent_sum)
    app.بستن()
    تی سی پی.بستن سرور(echo_srv)
    تی سی پی.بستن سرور(tls_srv)
    سرچاپ "failures:"، failures
پایان
