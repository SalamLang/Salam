بسته fake

واردسازی زمان
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا _keys := وکتور {} برگردان وکتور<رشته>
ناپایا _codes := وکتور {} برگردان وکتور<صحیح>
ناپایا _bodies := وکتور {} برگردان وکتور<رشته>
ناپایا _used := وکتور {} برگردان وکتور<منطقی>
ناپایا _log := وکتور {} برگردان وکتور<رشته>

تابع _handle(h: صحیح۶۴):
    ctx := اچ تی تی پی.زمینه جدید(h)
    method := اچ تی تی پی.روش(ctx)
    path := اچ تی تی پی.مسیر(ctx)
    query := اچ تی تی پی.پرسمان خام(ctx)
    ناپایا target := path
    اگر query.طول() بزرگتر 0: target = path + "?" + query پایان
    ناپایا line := method + " " + target
    key := اچ تی تی پی.سرصفحه(ctx، "X-TYPESENSE-API-KEY")
    اگر key.طول() بزرگتر 0: line = line + "\n  key: " + key پایان
    ctype := اچ تی تی پی.سرصفحه(ctx، "Content-Type")
    اگر ctype.طول() بزرگتر 0: line = line + "\n  type: " + ctype پایان
    extra := اچ تی تی پی.سرصفحه(ctx، "X-Tenant")
    اگر extra.طول() بزرگتر 0: line = line + "\n  tenant: " + extra پایان
    body := اچ تی تی پی.بدنه(ctx)
    اگر body.طول() بزرگتر 0: line = line + "\n  body: " + body پایان
    _log.بیفزا(line)
    اگر path برابر "/slow":
        زمان.خواب(1500)
    پایان
    route := method + " " + path
    ناپایا pick := -1
    تکرار _keys.طول() در i:
        اگر pick کوچکتر 0 و _keys.بگیر(i) برابر route و وارونه _used.بگیر(i):
            pick = i
        پایان
    پایان
    اگر pick کوچکتر 0:
        تکرار _keys.طول() در i:
            اگر _keys.بگیر(i) برابر route: pick = i پایان
        پایان
    وگرنه:
        _used.بنشان(pick، درست)
    پایان
    اگر pick کوچکتر 0:
        اچ تی تی پی.تنظیم وضعیت(ctx، 404)
        اچ تی تی پی.جیسون(ctx، `{ "message": "Not Found"}`)
        برگشت
    پایان
    اچ تی تی پی.تنظیم وضعیت(ctx، _codes.بگیر(pick))
    اچ تی تی پی.جیسون(ctx، _bodies.بگیر(pick))
پایان

همگانی تابع On(method: رشته، path: رشته، code: صحیح، body: رشته):
    _keys.بیفزا(method + " " + path)
    _codes.بیفزا(code)
    _bodies.بیفزا(body)
    _used.بیفزا(نادرست)
پایان

همگانی تابع Last(): رشته:
    اگر _log.طول() برابر 0: برگشت "" پایان
    برگشت _log.بگیر(_log.طول() - 1)
پایان

همگانی تابع Count(): صحیح:
    برگشت _log.طول()
پایان

همگانی تابع Start(port: صحیح): منطقی:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/*"، _handle)
    مسیریاب.ارسال(r، "/*"، _handle)
    مسیریاب.قراردادن(r، "/*"، _handle)
    مسیریاب.وصله(r، "/*"، _handle)
    مسیریاب.حذف(r، "/*"، _handle)
    s := اچ تی تی پی.سرور جدید(port)
    اچ تی تی پی.استفاده(s، r)
    برگشت اچ تی تی پی.اجرا در پس زمینه(s)
پایان
