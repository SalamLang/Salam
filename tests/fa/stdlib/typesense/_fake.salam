بسته جعلی

واردسازی زمان
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا _keys := وکتور {} برگردان وکتور<رشته>
ناپایا _codes := وکتور {} برگردان وکتور<صحیح>
ناپایا _bodies := وکتور {} برگردان وکتور<رشته>
ناپایا _used := وکتور {} برگردان وکتور<منطقی>
ناپایا _log := وکتور {} برگردان وکتور<رشته>

تابع _handle(h: صحیح۶۴):
    بافت := اچ تی تی پی.زمینه جدید(h)
    روش درخواست := اچ تی تی پی.روش(بافت)
    مسیر درخواست := اچ تی تی پی.مسیر(بافت)
    پرسمان := اچ تی تی پی.پرسمان خام(بافت)
    ناپایا مقصد := مسیر درخواست
    اگر پرسمان.طول() بزرگتر 0: مقصد = مسیر درخواست + "?" + پرسمان پایان
    ناپایا سطر := روش درخواست + " " + مقصد
    کلید := اچ تی تی پی.سرصفحه(بافت، "X-TYPESENSE-API-KEY")
    اگر کلید.طول() بزرگتر 0: سطر = سطر + "\n  key: " + کلید پایان
    نوع محتوا := اچ تی تی پی.سرصفحه(بافت، "Content-Type")
    اگر نوع محتوا.طول() بزرگتر 0: سطر = سطر + "\n  type: " + نوع محتوا پایان
    سرصفحه اضافه := اچ تی تی پی.سرصفحه(بافت، "X-Tenant")
    اگر سرصفحه اضافه.طول() بزرگتر 0: سطر = سطر + "\n  tenant: " + سرصفحه اضافه پایان
    بدنه := اچ تی تی پی.بدنه(بافت)
    اگر بدنه.طول() بزرگتر 0: سطر = سطر + "\n  body: " + بدنه پایان
    _log.بیفزا(سطر)
    اگر مسیر درخواست برابر "/slow":
        زمان.خواب(1500)
    پایان
    راه := روش درخواست + " " + مسیر درخواست
    ناپایا گزینش := -1
    تکرار _keys.طول() در i:
        اگر گزینش کوچکتر 0 و _keys.بگیر(i) برابر راه و وارونه _used.بگیر(i):
            گزینش = i
        پایان
    پایان
    اگر گزینش کوچکتر 0:
        تکرار _keys.طول() در i:
            اگر _keys.بگیر(i) برابر راه: گزینش = i پایان
        پایان
    وگرنه:
        _used.بنشان(گزینش، درست)
    پایان
    اگر گزینش کوچکتر 0:
        اچ تی تی پی.تنظیم وضعیت(بافت، 404)
        اچ تی تی پی.جیسون(بافت، `{ "message": "Not Found"}`)
        برگشت
    پایان
    اچ تی تی پی.تنظیم وضعیت(بافت، _codes.بگیر(گزینش))
    اچ تی تی پی.جیسون(بافت، _bodies.بگیر(گزینش))
پایان

همگانی تابع ثبت پاسخ(روش درخواست: رشته، مسیر درخواست: رشته، کد: صحیح، بدنه: رشته):
    _keys.بیفزا(روش درخواست + " " + مسیر درخواست)
    _codes.بیفزا(کد)
    _bodies.بیفزا(بدنه)
    _used.بیفزا(نادرست)
پایان

همگانی تابع آخرین(): رشته:
    اگر _log.طول() برابر 0: برگشت "" پایان
    برگشت _log.بگیر(_log.طول() - 1)
پایان

همگانی تابع شمار(): صحیح:
    برگشت _log.طول()
پایان

همگانی تابع آغاز آزاد(): صحیح:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/*"، _handle)
    مسیریاب.ارسال(r، "/*"، _handle)
    مسیریاب.قراردادن(r، "/*"، _handle)
    مسیریاب.وصله(r، "/*"، _handle)
    مسیریاب.حذف(r، "/*"، _handle)
    ناپایا s := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.استفاده(s، r)
    برگشت اچ تی تی پی.اجرا در پس زمینه با درگاه(s)
پایان
