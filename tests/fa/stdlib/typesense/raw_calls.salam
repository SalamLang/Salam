واردسازی دیتابیس.تایپسنس

فراخوانی جعلی "_fake.salam"

ناپایا PORT := 0

تابع نمایش(برچسب: رشته، وضعیت خطا: تایپسنس.خطا):
    سرچاپ برچسب + ": " + جعلی.آخرین()
    اگر وارونه تایپسنس.موفق(وضعیت خطا):
        سرچاپ "  error: " + تایپسنس.متن خطا(وضعیت خطا)
    پایان
پایان

تابع ریشه:
    جعلی.ثبت پاسخ("POST"، "/analytics/rules"، 200، `{"name":"pq","type":"popular_queries"}`)
    جعلی.ثبت پاسخ("POST"، "/stemming/dictionaries/import"، 200، `{"ok":true}`)
    جعلی.ثبت پاسخ("POST"، "/multi_search"، 200، `{"results":[{"found":1,"hits":[]},{"found":0,"hits":[]}]}`)
    PORT = جعلی.آغاز آزاد()
    اگر PORT برابر 0:
        سرچاپ "fake server failed to start"
        برگشت 1
    پایان
    c := تایپسنس.جدید("http://127.0.0.1:" + PORT، "xyz")
    ناپایا وضعیت خطا := تایپسنس.خطا {}

    سرچاپ تایپسنس.ساخت قاعده تحلیل از جیسون(c، `{"name":"pq","type":"popular_queries","params":{"limit":10}}`، وضعیت خطا)
    نمایش("rule"، وضعیت خطا)

    سرچاپ تایپسنس.درون ریزی ریشه یابی جیسون خطی(c، "plurals"، `{"word":"people","root":"person"}` + "\n" + `{"word":"children","root":"child"}`، وضعیت خطا)
    نمایش("stemming"، وضعیت خطا)

    ناپایا فهرست درخواست := وکتور {} برگردان وکتور<تایپسنس.درخواست جستجو>
    فهرست درخواست.بیفزا(تایپسنس.درخواست جستجو { مجموعه = "lib"، پارامترها = تایپسنس.جستجوی جدید("dune"، "title") })
    فهرست درخواست.بیفزا(تایپسنس.درخواست جستجو { مجموعه = "lib"، پارامترها = تایپسنس.جستجوی جدید("emma"، "title") })
    سرچاپ تایپسنس.جستجوی چندگانه خام(c، فهرست درخواست، تایپسنس.جستجوی جدید(""، "title")، وضعیت خطا)
    نمایش("multi"، وضعیت خطا)
    برگشت 0
پایان
