بسته ریشه

واردسازی کدگذاری.یولید
واردسازی رشته

تابع نمایش(لابیل: رشته، ر: یولید.نتیجه):
    اگر ر.موفق:
        سرچاپ لابیل، "ok"، یولید.رشته(ر.شناسه)
    وگرنه:
        سرچاپ لابیل، "error"، ر.خطا، یولید.متن خطا(ر.خطا)
    پایان
پایان

تابع هیکس(ب: وکتور<طبیعی۸>): رشته:
    دیگیتس := "0123456789abcdef"
    ناپایا ووت := ""
    تکرار ب.طول() در ی:
        کودی := ب.دریافت(ی) برگردان صحیح
        ووت = ووت + رشته.زیررشته(دیگیتس، کودی / 16، 1) + رشته.زیررشته(دیگیتس، کودی % 16، 1)
    پایان
    برگشت ووت
پایان

تابع ریشه:
    سپیک := یولید.تجزیه("01ARYZ6S41TSV4RRFFQ69G5FAV")
    سرچاپ سپیک.موفق، یولید.زمان شناسه(سپیک.شناسه)، یولید.رشته(سپیک.شناسه)
    سب := یولید.بایت ها(سپیک.شناسه)
    دیرکن سب.آزادکن()
    سرچاپ هیکس(سب)
    سرچاپ یولید.بیشینه زمان

    مکس := یولید.تجزیه("7ZZZZZZZZZZZZZZZZZZZZZZZZZ")
    سرچاپ مکس.موفق، یولید.زمان شناسه(مکس.شناسه)، یولید.رشته(مکس.شناسه)
    مب := یولید.بایت ها(مکس.شناسه)
    دیرکن مب.آزادکن()
    سرچاپ هیکس(مب)

    زیرو := یولید.تجزیه("00000000000000000000000000")
    سرچاپ زیرو.موفق، یولید.صفر است(زیرو.شناسه)، یولید.صفر است(سپیک.شناسه)

    نمایش("overflow"، یولید.تجزیه("80000000000000000000000000"))
    نمایش("overflow2"، یولید.تجزیه("ZZZZZZZZZZZZZZZZZZZZZZZZZZ"))
    نمایش("short"، یولید.تجزیه("01ARYZ6S41TSV4RRFFQ69G5FA"))
    نمایش("long"، یولید.تجزیه("01ARYZ6S41TSV4RRFFQ69G5FAVV"))
    نمایش("empty"، یولید.تجزیه(""))
    نمایش("u"، یولید.تجزیه("01ARYZ6S41TSV4RRFFQ69G5FAU"))
    نمایش("dash"، یولید.تجزیه("01ARYZ6S41-SV4RRFFQ69G5FAV"))
    نمایش("space"، یولید.تجزیه("01ARYZ6S41 SV4RRFFQ69G5FAV"))
    نمایش("utf8"، یولید.تجزیه("01ARYZ6S41TSV4RRFFQ69G5Fé"))

    لوویر := یولید.تجزیه("01aryz6s41tsv4rrffq69g5fav")
    سرچاپ لوویر.موفق، یولید.برابر است(لوویر.شناسه، سپیک.شناسه)
    الیاس := یولید.تجزیه("0OIL0000000000000000000000")
    پلاین := یولید.تجزیه("00110000000000000000000000")
    سرچاپ الیاس.موفق، یولید.برابر است(الیاس.شناسه، پلاین.شناسه)، یولید.رشته(الیاس.شناسه)
    نمایش("strict lower"، یولید.تجزیه سخت گیرانه("01aryz6s41tsv4rrffq69g5fav"))
    نمایش("strict alias"، یولید.تجزیه سخت گیرانه("0OIL0000000000000000000000"))
    نمایش("strict ok"، یولید.تجزیه سخت گیرانه("01ARYZ6S41TSV4RRFFQ69G5FAV"))
    سرچاپ یولید.معتبر است("01ARYZ6S41TSV4RRFFQ69G5FAV")، یولید.معتبر است("nope")
    سرچاپ یولید.رشته(یولید.تجزیه با پیش فرض("nope"، سپیک.شناسه))

    ناپایا سیید := وکتور {} برگردان وکتور<طبیعی۸>
    دیرکن سیید.آزادسازی()
    تکرار 10 در ی:
        سیید.افزودن((ی + 1) برگردان طبیعی۸)
    پایان
    پ := یولید.از اجزا(1469918176385، سیید)
    سرچاپ پ.موفق، یولید.رشته(پ.شناسه)
    پب := یولید.بایت ها(پ.شناسه)
    دیرکن پب.آزادکن()
    سرچاپ هیکس(پب)
    پی := یولید.بخش تصادفی(پ.شناسه)
    دیرکن پی.آزادکن()
    سرچاپ هیکس(پی)
    نمایش("time neg"، یولید.از اجزا(-1، سیید))
    نمایش("time big"، یولید.از اجزا(281474976710656، سیید))
    ناپایا سهورت := وکتور {} برگردان وکتور<طبیعی۸>
    دیرکن سهورت.آزادسازی()
    سهورت.افزودن(1 برگردان طبیعی۸)
    نمایش("entropy len"، یولید.از اجزا(5، سهورت))

    عقب := یولید.از بایت ها(پب)
    سرچاپ عقب.موفق، یولید.برابر است(عقب.شناسه، پ.شناسه)
    نمایش("bytes len"، یولید.از بایت ها(سهورت))
    وو := یولید.به بایت های یو یو آی دی(پ.شناسه)
    دیرکن وو.آزادکن()
    وباکک := یولید.از بایت های یو یو آی دی(وو)
    سرچاپ وو.طول()، وباکک.موفق، یولید.برابر است(وباکک.شناسه، پ.شناسه)

    ناپایا تیمیس := وکتور {} برگردان وکتور<صحیح۶۴>
    دیرکن تیمیس.آزادسازی()
    تیمیس.افزودن(0 برگردان صحیح۶۴)
    تیمیس.افزودن(1 برگردان صحیح۶۴)
    تیمیس.افزودن(31 برگردان صحیح۶۴)
    تیمیس.افزودن(32 برگردان صحیح۶۴)
    تیمیس.افزودن(1000 برگردان صحیح۶۴)
    تیمیس.افزودن(1469918176385 برگردان صحیح۶۴)
    تیمیس.افزودن(یولید.بیشینه زمان)
    ناپایا سورتید := درست
    ناپایا قبلی := ""
    تکرار تیمیس.طول() در ی:
        شناسه := یولید.کمینه برای(تیمیس.دریافت(ی))
        کور := یولید.رشته(شناسه)
        رووند := یولید.تجزیه(کور)
        اگر وارونه رووند.موفق یا وارونه یولید.برابر است(رووند.شناسه، شناسه) یا یولید.زمان شناسه(رووند.شناسه) نابرابر تیمیس.دریافت(ی):
            سورتید = نادرست
        پایان
        اگر ی بزرگتر 0 و رشته.مقایسه(قبلی، کور) بزرگتربرابر 0:
            سورتید = نادرست
        پایان
        قبلی = کور
    پایان
    سرچاپ "chronological order matches text order:"، سورتید
پایان
