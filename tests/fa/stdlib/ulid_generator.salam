بسته ریشه

واردسازی کدگذاری.یولید

ناپایا گ اکنون := 0 برگردان صحیح۶۴
ناپایا گ ینتروپی := 0 برگردان صحیح۶۴

تابع فاکی کلوکک(): صحیح۶۴:
    برگشت گ اکنون
پایان

تابع فاکی ینتروپی(): صحیح۶۴:
    برگشت گ ینتروپی
پایان

تابع خط(لابیل: رشته، ر: یولید.نتیجه):
    اگر ر.موفق:
        سرچاپ لابیل، یولید.زمان شناسه(ر.شناسه)، یولید.رشته(ر.شناسه)
    وگرنه:
        سرچاپ لابیل، "error"، یولید.متن خطا(ر.خطا)
    پایان
پایان

تابع ریشه:
    گ اکنون = 1000
    گ ینتروپی = 5
    گ := یولید.تولیدکننده جدید با((): برگشت فاکی کلوکک() پایان، (): برگشت فاکی ینتروپی() پایان)
    دیرکن یولید.آزادکن(گ)

    خط("first"، یولید.بعدی(گ))
    خط("same ms"، یولید.بعدی(گ))
    خط("same ms"، یولید.بعدی(گ))
    گ اکنون = 1001
    گ ینتروپی = 9
    خط("next ms"، یولید.بعدی(گ))
    گ اکنون = 900
    خط("clock back"، یولید.بعدی(گ))
    خط("clock back"، یولید.بعدی(گ))
    آخر := یولید.آخرین(گ)
    خط("last"، آخر)

    خط("explicit"، یولید.بعدی برای(گ، 2000))
    خط("explicit past"، یولید.بعدی برای(گ، 5))
    خط("bad time"، یولید.بعدی برای(گ، -1))
    خط("bad time"، یولید.بعدی برای(گ، یولید.بیشینه زمان + 1))

    گ ینتروپی = 1099511627775
    گ اکنون = 5000
    خط("max entropy"، یولید.بعدی(گ))
    خط("rolled"، یولید.بعدی(گ))
    خط("rolled"، یولید.بعدی(گ))

    لو := یولید.از اجزا(7، وکتور {} برگردان وکتور<طبیعی۸>)
    سرچاپ لو.موفق

    ناپایا سیید := وکتور {} برگردان وکتور<طبیعی۸>
    دیرکن سیید.آزادسازی()
    تکرار 10:
        سیید.افزودن(255 برگردان طبیعی۸)
    پایان
    بالا := یولید.از اجزا(100، سیید)
    ینک := یولید.افزایش(بالا.شناسه)
    سرچاپ ینک.موفق، یولید.متن خطا(ینک.خطا)
    ناپایا سیید2 := وکتور {} برگردان وکتور<طبیعی۸>
    دیرکن سیید2.آزادسازی()
    تکرار 5:
        سیید2.افزودن(0 برگردان طبیعی۸)
    پایان
    تکرار 4:
        سیید2.افزودن(255 برگردان طبیعی۸)
    پایان
    سیید2.افزودن(254 برگردان طبیعی۸)
    کارری := یولید.افزایش(یولید.از اجزا(100، سیید2).شناسه)
    سرچاپ کارری.موفق، یولید.رشته(کارری.شناسه)
    ناپایا سیید3 := وکتور {} برگردان وکتور<طبیعی۸>
    دیرکن سیید3.آزادسازی()
    تکرار 4:
        سیید3.افزودن(0 برگردان طبیعی۸)
    پایان
    سیید3.افزودن(255 برگردان طبیعی۸)
    تکرار 5:
        سیید3.افزودن(255 برگردان طبیعی۸)
    پایان
    کارری2 := یولید.افزایش(یولید.از اجزا(100، سیید3).شناسه)
    سرچاپ کارری2.موفق، یولید.رشته(کارری2.شناسه)

    گ اکنون = یولید.بیشینه زمان
    توپ2 := یولید.تولیدکننده جدید با((): برگشت فاکی کلوکک() پایان، (): برگشت فاکی ینتروپی() پایان)
    دیرکن یولید.آزادکن(توپ2)
    خط("at max"، یولید.بعدی(توپ2))
    خط("max overflow"، یولید.بعدی(توپ2))

    گ ینتروپی = -1
    بروکین := یولید.تولیدکننده جدید با((): برگشت فاکی کلوکک() پایان، (): برگشت فاکی ینتروپی() پایان)
    دیرکن یولید.آزادکن(بروکین)
    خط("no entropy"، یولید.بعدی(بروکین))
    سرچاپ یولید.آخرین(بروکین).موفق
    گ ینتروپی = 7
    گ اکنون = 3
    خط("recovered"، یولید.بعدی(بروکین))

    گ اکنون = 77
    گ ینتروپی = 0
    ب := یولید.تولیدکننده جدید با((): برگشت فاکی کلوکک() پایان، (): برگشت فاکی ینتروپی() پایان)
    دیرکن یولید.آزادکن(ب)
    باتکه := یولید.دسته(ب، 4)
    دیرکن باتکه.آزادکن()
    تکرار باتکه.طول() در ی:
        سرچاپ یولید.رشته(باتکه.بگیر(ی))
    پایان

    من := یولید.کمینه برای(1469918176385)
    مکسکس := یولید.بیشینه برای(1469918176385)
    سرچاپ یولید.رشته(من)، یولید.رشته(مکسکس)
    سرچاپ یولید.مقایسه(من، مکسکس)، یولید.مقایسه(مکسکس، من)، یولید.مقایسه(من، من)
    سرچاپ یولید.رشته(یولید.کمینه برای(-5))، یولید.رشته(یولید.بیشینه برای(یولید.بیشینه زمان + 10))

    اکنون := یولید.جدید()
    نوو2 := یولید.جدید()
    سرچاپ یولید.کوچکتر است(اکنون، نوو2)، یولید.رشته(اکنون).طول()، یولید.رشته جدید().طول()
    ستامپ := یولید.جدید برای(1469918176385)
    سرچاپ ستامپ.موفق، یولید.زمان شناسه(ستامپ.شناسه)، یولید.رشته(ستامپ.شناسه).طول()
    سرچاپ یولید.جدید برای(-1).موفق
    نب := یولید.دسته جدید(50)
    دیرکن نب.آزادکن()
    ناپایا وردیرید := نب.طول() برابر 50
    تکرار نب.طول() - 1 در ی:
        اگر وارونه یولید.کوچکتر است(نب.بگیر(ی)، نب.بگیر(ی + 1)):
            وردیرید = نادرست
        پایان
    پایان
    سرچاپ "default batch strictly increasing:"، وردیرید
    دریفت := یولید.زمان شناسه(اکنون) - یولید.اکنون()
    سرچاپ دریفت بزرگتر -5000 و دریفت کوچکتر 5000
پایان
