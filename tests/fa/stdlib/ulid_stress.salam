بسته ریشه

واردسازی کدگذاری.یولید
واردسازی استخر
واردسازی حافظه

پایا تاسکس := 16
پایا پیر := 4000

ناپایا گ فروزین := 424242 برگردان صحیح۶۴

تابع فروزین کلوکک(): صحیح۶۴:
    برگشت گ فروزین
پایان

تابع زیرو ینتروپی(): صحیح۶۴:
    برگشت 1099511627775
پایان

تابع کوللیکت(گ: یولید.تولیدکننده، ووت: صحیح۶۴*، تاسک: صحیح۶۴):
    باسی := تاسک * پیر * 3
    تکرار پیر در ک:
        ر := یولید.بعدی(گ)
        ووت[باسی + ک * 3] = ر.شناسه.زمان
        ووت[باسی + ک * 3 + 1] = ر.شناسه.بالا
        ووت[باسی + ک * 3 + 2] = ر.شناسه.پایین
    پایان
پایان

تابع ینتری(ووت: صحیح۶۴*، تاسک: صحیح، ک: صحیح): یولید.شناسه یولید:
    باسی := (تاسک * پیر + ک) * 3
    برگشت یولید.شناسه یولید { زمان = ووت[باسی]، بالا = ووت[باسی + 1]، پایین = ووت[باسی + 2] }
پایان

تابع بررسی(لابیل: رشته، ووت: صحیح۶۴*):
    ناپایا وردیرید := درست
    تکرار تاسکس در ت:
        تکرار پیر - 1 در ک:
            اگر یولید.مقایسه(ینتری(ووت، ت، ک)، ینتری(ووت، ت، ک + 1)) بزرگتربرابر 0:
                وردیرید = نادرست
            پایان
        پایان
    پایان
    ناپایا سیین := نگاشت {} برگردان نگاشت<رشته، منطقی>
    دیرکن سیین.آزادسازی()
    ناپایا ونیقوی := درست
    تکرار تاسکس در ت:
        تکرار پیر در ک:
            س := یولید.رشته(ینتری(ووت، ت، ک))
            اگر سیین.دارد(س):
                ونیقوی = نادرست
            پایان
            سیین.قراردادن(س، درست)
        پایان
    پایان
    سرچاپ لابیل، "per thread strictly increasing:"، وردیرید
    سرچاپ لابیل، "all unique:"، ونیقوی، سیین.اندازه() برابر تاسکس * پیر
پایان

تابع اجرا(لابیل: رشته، گ: یولید.تولیدکننده):
    ووت := حافظه.تخصیص صفرشده((تاسکس * پیر * 3 * 8) برگردان طبیعی۶۴) برگردان صحیح۶۴*
    استخر.برای موازی(تاسکس برگردان صحیح۶۴، 8 برگردان صحیح۶۴، (تاسک: صحیح۶۴): کوللیکت(گ، ووت، تاسک) پایان)
    بررسی(لابیل، ووت)
    حافظه.آزادسازی(ووت برگردان تهی*)
پایان

تابع ریشه:
    ریال := یولید.تولیدکننده جدید()
    دیرکن یولید.آزادکن(ریال)
    اجرا("system clock:"، ریال)

    فروزین := یولید.تولیدکننده جدید با((): برگشت فروزین کلوکک() پایان، (): برگشت زیرو ینتروپی() پایان)
    دیرکن یولید.آزادکن(فروزین)
    اجرا("frozen clock, worst entropy:"، فروزین)
    آخر := یولید.آخرین(فروزین)
    سرچاپ "clock moved ahead only by overflow:"، آخر.شناسه.زمان بزرگتربرابر گ فروزین

    سهارید := یولید.پیش فرض()
    اجرا("default generator:"، سهارید)
پایان
