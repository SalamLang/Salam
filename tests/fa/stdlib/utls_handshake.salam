واردسازی شبکه.اثر انگشت تی ال اس
واردسازی شبکه.سانسورشکن
واردسازی شبکه.تی سی پی
واردسازی تی ال اس

ناپایا g_cfg := تی ال اس.پیکربندی کارساز {}

تابع serve_one(arg: تهی*):
    srv := تی سی پی.سرور { توصیفگر = arg برگردان صحیح۶۴ }
    c := تی سی پی.پذیرش(srv)
    اگر وارونه تی سی پی.اتصال معتبر(c):
        برگشت
    پایان
    ناپایا t := تی ال اس.پوشش کارساز(c.توصیفگر، g_cfg)
    اگر تی ال اس.اتصال معتبر(t):
        d := تی ال اس.خواندن(t، 4096)
        اگر d.طول() بزرگتر 0:
            تی ال اس.نوشتن(t، "echo:" + d)
        پایان
        تی ال اس.بستن اتصال(t)
    وگرنه:
        سرچاپ "server failed:"، تی ال اس.خطای اتصال(t)
        تی سی پی.بستن(c)
    پایان
پایان

تابع try_profile(name: رشته، shuffle: منطقی): منطقی:
    srv := تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(srv)
    th := نخ‌ساز(serve_one، srv.توصیفگر برگردان تهی*)
    sp := اثر انگشت تی ال اس.نمایه(name)
    ناپایا o := اثر انگشت تی ال اس.گزینه‌ها {}
    o.نام کارساز = "localhost"
    o.پروتکل برنامه = "http/1.1"
    o.بر زدن افزونه‌ها = shuffle
    c := تی سی پی.شماره گیری("127.0.0.1"، port)
    ناپایا cfg := تی ال اس.پیکربندی جدید("localhost")
    cfg.بدون بررسی گواهی = درست
    ناپایا t := اثر انگشت تی ال اس.پوشش کارخواه(c.توصیفگر، sp، o، cfg)
    ناپایا ok := تی ال اس.اتصال معتبر(t)
    اگر ok:
        تی ال اس.نوشتن(t، "hi " + name)
        ok = تی ال اس.خواندن(t، 4096) برابر "echo:hi " + name
        تی ال اس.بستن اتصال(t)
    وگرنه:
        سرچاپ "client failed:"، تی ال اس.خطای اتصال(t)
    پایان
    نخ‌پیوند(th)
    تی سی پی.بستن سرور(srv)
    برگشت ok
پایان

تابع ریشه:
    g_cfg = تی ال اس.پیکربندی کارساز جدید("tests/fixtures/ssl/server.crt"، "tests/fixtures/ssl/server.key")
    سرچاپ "server config"، g_cfg.سالم
    names := ["chrome"، "chrome_120"، "edge"، "firefox"، "safari"، "ios"، "randomized"]
    هر n در names:
        سرچاپ n، try_profile(n، نادرست)
    پایان
    سرچاپ "chrome shuffled"، try_profile("chrome"، درست)
    سرچاپ "unknown profile"، اثر انگشت تی ال اس.نمایه("nope").معتبر
    سرچاپ "profile names"، اثر انگشت تی ال اس.نام نمایه‌ها()
    سرچاپ "legacy profile names"، اثر انگشت تی ال اس.نام نمایه‌های قدیمی()

    ناپایا o := اثر انگشت تی ال اس.گزینه‌ها {}
    o.نام کارساز = "example.com"
    هر n در ["chrome"، "firefox"، "safari"، "chrome_120"]:
        ناپایا h := اثر انگشت تی ال اس.ساخت(اثر انگشت تی ال اس.نمایه(n)، o)
        ناپایا rec := اثر انگشت تی ال اس.رکورد(h)
        ch := سانسورشکن.تجزیه پیام آغازین(rec.نشانگر، rec.طول)
        سرچاپ n، "parse"، ch.معتبر، ch.نام سرور، ch.دارای تی ال اس سیزده، ch.دارای ای سی اچ، ch.طول شناسه نشست
        سرچاپ n، "ja3"، اثر انگشت تی ال اس.جی ای سه(h.خام)
        اثر انگشت تی ال اس.آزادسازی بایت‌ها(rec)
        اثر انگشت تی ال اس.آزادسازی سلام(h)
    پایان
پایان
