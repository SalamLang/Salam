    سرچاپ یو یو آی دی.به متن(یو یو آی دی.تجزیه با پیش فرض("nope"، مکس))

    ا := یو یو آی دی.تجزیه الزامی("00000000-0000-0000-0000-000000000001")
    ب := یو یو آی دی.تجزیه الزامی("00000000-0000-0000-0000-000000000002")
    ک := یو یو آی دی.تجزیه الزامی("00000000-0000-0001-0000-000000000000")
