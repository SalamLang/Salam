// زبان: فارسی
واردسازی کدگذاری.یو یو آی دی
واردسازی زمان

پایا شمار := 5000

تابع شمار یکتا(شناسه ها: وکتور<یو یو آی دی.شناسه>): صحیح:
    ناپایا دیده شده := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن دیده شده.آزادسازی()
    تکرار شناسه ها.طول() در ی:
        دیده شده.قراردادن(یو یو آی دی.به متن فشرده(شناسه ها.دریافت(ی))، 1)
    پایان
    برگشت دیده شده.اندازه()
پایان

تابع همه مرتب است(شناسه ها: وکتور<یو یو آی دی.شناسه>): منطقی:
    تکرار شناسه ها.طول() - 1 در ی:
        اگر یو یو آی دی.مقایسه(شناسه ها.دریافت(ی)، شناسه ها.دریافت(ی + 1)) بزرگتربرابر 0: برگشت نادرست پایان
    پایان
    برگشت درست
پایان

تابع ریشه:
    ناپایا و4 := یو یو آی دی.دسته(شمار)
    دیرکن و4.آزادکن()
    ناپایا گوود4 := درست
    تکرار و4.طول() در ی:
        یتیم := و4.بگیر(ی)
        اگر یو یو آی دی.نسخه(یتیم) نابرابر 4 یا یو یو آی دی.رده(یتیم) نابرابر یو یو آی دی.گونه استاندارد: گوود4 = نادرست پایان
        اگر یو یو آی دی.به متن(یتیم).طول() نابرابر 36: گوود4 = نادرست پایان
    پایان
    سرچاپ "v4 count"، و4.طول()، "valid"، گوود4، "unique"، شمار یکتا(و4) برابر شمار
    سرچاپ "new"، یو یو آی دی.نسخه(یو یو آی دی.جدید())، یو یو آی دی.متن جدید().طول()، یو یو آی دی.معتبر است(یو یو آی دی.متن جدید())

    بیفوری := زمان.اکنون میلی ثانیه()
    ناپایا و7 := یو یو آی دی.دسته نسخه۷(شمار)
    دیرکن و7.آزادکن()
    افتیر := زمان.اکنون میلی ثانیه()
    ناپایا گوود7 := درست
    تکرار و7.طول() در ی:
        یتیم := و7.بگیر(ی)
        اگر یو یو آی دی.نسخه(یتیم) نابرابر 7 یا یو یو آی دی.رده(یتیم) نابرابر یو یو آی دی.گونه استاندارد: گوود7 = نادرست پایان
    پایان
    اول := یو یو آی دی.میلی ثانیه یونیکس(و7.بگیر(0))
    سرچاپ "v7 valid"، گوود7، "unique"، شمار یکتا(و7) برابر شمار، "sorted"، همه مرتب است(و7)
    سرچاپ "v7 time"، اول بزرگتربرابر بیفوری، یو یو آی دی.میلی ثانیه یونیکس(و7.بگیر(شمار - 1)) کوچکتربرابر افتیر + 100
    سرچاپ "v7 text sorted"، یو یو آی دی.به متن(و7.بگیر(0)) کوچکتر یو یو آی دی.به متن(و7.بگیر(شمار - 1))

    ناپایا و1 := وکتور {} برگردان وکتور<یو یو آی دی.شناسه>
    دیرکن و1.آزادسازی()
    ناپایا و6 := وکتور {} برگردان وکتور<یو یو آی دی.شناسه>
    دیرکن و6.آزادسازی()
    تکرار شمار:
        و1.افزودن(یو یو آی دی.ساخت نسخه۱())
        و6.افزودن(یو یو آی دی.ساخت نسخه۶())
    پایان
    سرچاپ "v1 unique"، شمار یکتا(و1) برابر شمار، "version"، یو یو آی دی.نسخه(و1.دریافت(0))، "variant"، یو یو آی دی.رده(و1.دریافت(0)) برابر یو یو آی دی.گونه استاندارد
    سرچاپ "v6 unique"، شمار یکتا(و6) برابر شمار، "version"، یو یو آی دی.نسخه(و6.دریافت(0))، "sorted"، همه مرتب است(و6)
    اکنون نس := زمان.اکنون نانوثانیه()
    دریفت := اکنون نس - یو یو آی دی.نانو ثانیه یونیکس(و1.دریافت(0))
    سرچاپ "v1 near now"، دریفت بزرگتربرابر 0 - 1000000000 و دریفت کوچکتر 60000000000
    ناپایا مونو1 := درست
    تکرار شمار - 1 در ی:
        اگر یو یو آی دی.برچسب زمانی(و1.دریافت(ی)) بزرگتربرابر یو یو آی دی.برچسب زمانی(و1.دریافت(ی + 1)): مونو1 = نادرست پایان
    پایان
    سرچاپ "v1 timestamps increase"، مونو1
    سرچاپ "v1 node"، یو یو آی دی.گره(و1.دریافت(0)) برابر یو یو آی دی.گره(و1.دریافت(شمار - 1))، یو یو آی دی.گره(و1.دریافت(0)) برابر یو یو آی دی.شناسه گره()
    سرچاپ "v1 multicast bit"، (یو یو آی دی.شناسه گره() >> 40) & 1
    سرچاپ "v1 and v6 share node"، یو یو آی دی.گره(و1.دریافت(0)) برابر یو یو آی دی.گره(و6.دریافت(0))
    وون := یو یو آی دی.ساخت نسخه۱ با گره(0x0123456789AB)
    سرچاپ "v1 own node"، یو یو آی دی.گره(وون) برابر 0x0123456789AB، یو یو آی دی.نسخه(وون)

    ا := یو یو آی دی.ساخت نسخه۴()
    ب := یو یو آی دی.ساخت نسخه۴()
    سرچاپ "v4 differ"، یو یو آی دی.یکسان است(ا، ب)، یو یو آی دی.شناسه تهی است(ا)
    م8 := یو یو آی دی.ساخت نسخه۸(1 برگردان طبیعی۶۴، 2 برگردان طبیعی۶۴)
    سرچاپ "v8"، یو یو آی دی.نسخه(م8)، یو یو آی دی.رده(م8) برابر یو یو آی دی.گونه استاندارد
پایان
