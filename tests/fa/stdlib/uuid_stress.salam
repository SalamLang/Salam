// زبان: فارسی
واردسازی کدگذاری.یو یو آی دی
واردسازی حافظه
واردسازی استخر

پایا تعداد_نخ := 8
پایا سهم_نخ := 3000

ناپایا شناسه ها := پوچ برگردان طبیعی۶۴*
ناپایا خرابی := پوچ برگردان صحیح۶۴*

تابع تولید(ت: صحیح، نوع: صحیح):
    ناپایا قبلی := یو یو آی دی.شناسه تهی()
    تکرار سهم_نخ در ی:
        ناپایا یتیم := یو یو آی دی.شناسه تهی()
        اگر نوع برابر 1:
            یتیم = یو یو آی دی.ساخت نسخه۱()
        وگرنه نوع برابر 4:
            یتیم = یو یو آی دی.ساخت نسخه۴()
        وگرنه نوع برابر 6:
            یتیم = یو یو آی دی.ساخت نسخه۶()
        وگرنه:
            یتیم = یو یو آی دی.ساخت نسخه۷()
        پایان
        سلوت := (ت * سهم_نخ + ی) * 2
        شناسه ها[سلوت] = یتیم.نیمه بالا
        شناسه ها[سلوت + 1] = یتیم.نیمه پایین
        اگر یو یو آی دی.نسخه(یتیم) نابرابر نوع یا
            یو یو آی دی.رده(یتیم) نابرابر یو یو آی دی.گونه استاندارد:
            اتمی‌بیفزا(خرابی، 1 برگردان صحیح۶۴)
        پایان
        اگر ی بزرگتر 0 و نوع نابرابر 4:
            اگر نوع برابر 1:
                اگر یو یو آی دی.برچسب زمانی(یتیم) کوچکتربرابر یو یو آی دی.برچسب زمانی(قبلی): اتمی‌بیفزا(خرابی، 1 برگردان صحیح۶۴) پایان
            وگرنه:
                اگر یو یو آی دی.مقایسه(قبلی، یتیم) بزرگتربرابر 0: اتمی‌بیفزا(خرابی، 1 برگردان صحیح۶۴) پایان
            پایان
        پایان
        قبلی = یتیم
    پایان
پایان

تابع اجرای نوع(نوع: صحیح، برچسب: رشته):
    تکرار تعداد_نخ در ت:
        برو تولید(ت، نوع)
    پایان
    استخر.انتظار برو()
    ناپایا دیده شده := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن دیده شده.آزادسازی()
    تکرار تعداد_نخ * سهم_نخ در ی:
        یتیم := یو یو آی دی.شناسه { نیمه بالا = شناسه ها[ی * 2]، نیمه پایین = شناسه ها[ی * 2 + 1] }
        دیده شده.قراردادن(یو یو آی دی.به متن فشرده(یتیم)، 1)
    پایان
    سرچاپ برچسب،
        "total"،
        تعداد_نخ * سهم_نخ،
        "unique"،
        دیده شده.اندازه()،
        "violations"،
        اتمی‌بخوان(خرابی)
    اتمی‌بنویس(خرابی، 0 برگردان صحیح۶۴)
پایان

تابع ریشه:
    شناسه ها = حافظه.تخصیص((تعداد_نخ * سهم_نخ * 16) برگردان طبیعی۶۴) برگردان طبیعی۶۴*
    خرابی = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    اجرای نوع(4، "v4")
    اجرای نوع(7، "v7")
    اجرای نوع(1، "v1")
    اجرای نوع(6، "v6")
    حافظه.آزادسازی(شناسه ها برگردان تهی*)
    حافظه.آزادسازی(خرابی برگردان تهی*)
پایان
