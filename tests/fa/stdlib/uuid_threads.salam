// زبان: فارسی
واردسازی کدگذاری.یو یو آی دی
واردسازی حافظه

پایا تعداد_نخ := 8
پایا سهم_نخ := 3000

ناپایا شناسه ها := پوچ برگردان طبیعی۶۴*
ناپایا خرابی := پوچ برگردان صحیح۶۴*

تابع وورکیر(ارگ: صحیح۶۴*):
    ت := ارگ[0] برگردان صحیح
    ناپایا قبلی := یو یو آی دی.شناسه تهی()
    تکرار سهم_نخ در ی:
        یتیم := یو یو آی دی.ساخت نسخه۷()
        سلوت := (ت * سهم_نخ + ی) * 2
        شناسه ها[سلوت] = یتیم.نیمه بالا
        شناسه ها[سلوت + 1] = یتیم.نیمه پایین
        اگر ی بزرگتر 0 و یو یو آی دی.مقایسه(قبلی، یتیم) بزرگتربرابر 0: اتمی‌بیفزا(خرابی، 1 برگردان صحیح۶۴) پایان
        قبلی = یتیم
    پایان
پایان

تابع ریشه:
    شناسه ها = حافظه.تخصیص((تعداد_نخ * سهم_نخ * 16) برگردان طبیعی۶۴) برگردان طبیعی۶۴*
    خرابی = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    ارگس := حافظه.تخصیص((تعداد_نخ * 8) برگردان طبیعی۶۴) برگردان صحیح۶۴*
    ناپایا دستگیره ها := وکتور {} برگردان وکتور<صحیح۶۴>
    دیرکن دستگیره ها.آزادسازی()
    تکرار تعداد_نخ در ت:
        ارگس[ت] = ت برگردان صحیح۶۴
        دستگیره ها.افزودن(نخ‌ساز(وورکیر، ((ارگس برگردان صحیح۶۴) + (ت * 8) برگردان صحیح۶۴) برگردان صحیح۶۴*))
    پایان
    تکرار تعداد_نخ در ت:
        نخ‌پیوند(دستگیره ها.دریافت(ت))
    پایان
    ناپایا دیده شده := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن دیده شده.آزادسازی()
    تکرار تعداد_نخ * سهم_نخ در ی:
        یتیم := یو یو آی دی.شناسه { نیمه بالا = شناسه ها[ی * 2]، نیمه پایین = شناسه ها[ی * 2 + 1] }
        دیده شده.قراردادن(یو یو آی دی.به متن فشرده(یتیم)، 1)
    پایان
    سرچاپ "v7 total"، تعداد_نخ * سهم_نخ، "unique"، دیده شده.اندازه()، "violations"، اتمی‌بخوان(خرابی)
    حافظه.آزادسازی(شناسه ها برگردان تهی*)
    حافظه.آزادسازی(خرابی برگردان تهی*)
    حافظه.آزادسازی(ارگس برگردان تهی*)
پایان
