// زبان: فارسی
واردسازی کدگذاری.یو یو آی دی

تابع بررسی(برچسب: رشته، نتیجه: یو یو آی دی.شناسه، انتظار: رشته):
    سرچاپ برچسب، یو یو آی دی.به متن(نتیجه)، یو یو آی دی.به متن(نتیجه) برابر انتظار
پایان

تابع ریشه:
    دنس := یو یو آی دی.فضای نام دی ان اس()
    ورل := یو یو آی دی.فضای نام یو آر ال()
    وید := یو یو آی دی.فضای نام او آی دی()
    کس500 := یو یو آی دی.فضای نام ایکس۵۰۰()
    سرچاپ دنس
    سرچاپ ورل
    سرچاپ وید
    سرچاپ کس500

    بررسی("v3 dns www.example.com"، یو یو آی دی.ساخت نسخه۳(دنس، "www.example.com")، "5df41881-3aed-3515-88a7-2f4a814cf09e")
    بررسی("v5 dns www.example.com"، یو یو آی دی.ساخت نسخه۵(دنس، "www.example.com")، "2ed6657d-e927-568b-95e1-2665a8aea6a2")
    بررسی("v3 dns python.org"، یو یو آی دی.ساخت نسخه۳(دنس، "python.org")، "6fa459ea-ee8a-3ca4-894e-db77e160355e")
    بررسی("v5 dns python.org"، یو یو آی دی.ساخت نسخه۵(دنس، "python.org")، "886313e1-3b8a-5372-9b90-0c9aee199e5d")
    بررسی("v3 url"، یو یو آی دی.ساخت نسخه۳(ورل، "http://python.org/")، "9fe8e8c4-aaa8-32a9-a55c-4535a88b748d")
    بررسی("v5 url"، یو یو آی دی.ساخت نسخه۵(ورل، "http://python.org/")، "4c565f0d-3f5a-5890-b41b-20cf47701c5e")

    ا := یو یو آی دی.ساخت نسخه۵(دنس، "salam")
    ب := یو یو آی دی.ساخت نسخه۵(دنس، "salam")
    ک := یو یو آی دی.ساخت نسخه۵(ورل، "salam")
    د := یو یو آی دی.ساخت نسخه۳(دنس، "salam")
    سرچاپ یو یو آی دی.یکسان است(ا، ب)، یو یو آی دی.یکسان است(ا، ک)، یو یو آی دی.یکسان است(ا، د)
    سرچاپ یو یو آی دی.نسخه(ا)، یو یو آی دی.نسخه(د)، یو یو آی دی.رده(ا) برابر یو یو آی دی.گونه استاندارد
    خالی := یو یو آی دی.ساخت نسخه۵(دنس، "")
    سرچاپ خالی
    سرچاپ یو یو آی دی.ساخت نسخه۵(وید، "1.3.6.1.4.1")، یو یو آی دی.ساخت نسخه۳(کس500، "cn=salam")

    و1 := یو یو آی دی.نسخه۱ از اجزا(0x1EC9414C232AB00، 0x33C8، 0x9F6BDECED846)
    بررسی("v1"، و1، "c232ab00-9414-11ec-b3c8-9f6bdeced846")
    و6 := یو یو آی دی.نسخه۶ از اجزا(0x1EC9414C232AB00، 0x33C8، 0x9F6BDECED846)
    بررسی("v6"، و6، "1ec9414c-232a-6b00-b3c8-9f6bdeced846")
    و7 := یو یو آی دی.نسخه۷ از اجزا(0x17F22E279B0، 0xCC3، 0x18C4DC0C0C07398F)
    بررسی("v7"، و7، "017f22e2-79b0-7cc3-98c4-dc0c0c07398f")
    و8 := یو یو آی دی.نسخه۸ از اجزا(0x2489E9AD2EE2، 0xE00، 0xEC932D5F69181C0)
    بررسی("v8"، و8، "2489e9ad-2ee2-8e00-8ec9-32d5f69181c0")
    سرچاپ یو یو آی دی.نسخه(و1)، یو یو آی دی.نسخه(و6)، یو یو آی دی.نسخه(و7)، یو یو آی دی.نسخه(و8)

    سرچاپ یو یو آی دی.برچسب زمانی(و1)، یو یو آی دی.برچسب زمانی(و6)، یو یو آی دی.برچسب زمانی(و1) برابر یو یو آی دی.برچسب زمانی(و6)
    سرچاپ یو یو آی دی.نانو ثانیه یونیکس(و1)، یو یو آی دی.نانو ثانیه یونیکس(و6)
    سرچاپ یو یو آی دی.میلی ثانیه یونیکس(و1)، یو یو آی دی.میلی ثانیه یونیکس(و6)، یو یو آی دی.میلی ثانیه یونیکس(و7)
    سرچاپ یو یو آی دی.دنباله ساعت(و1)، یو یو آی دی.دنباله ساعت(و6)، یو یو آی دی.گره(و1) برابر یو یو آی دی.گره(و6)
    سرچاپ یو یو آی دی.زمان دارد(و1)، یو یو آی دی.زمان دارد(و6)، یو یو آی دی.زمان دارد(و7)، یو یو آی دی.زمان دارد(و8)، یو یو آی دی.زمان دارد(ا)
    سرچاپ یو یو آی دی.میلی ثانیه یونیکس(و8)، یو یو آی دی.میلی ثانیه یونیکس(ا)، یو یو آی دی.دنباله ساعت(و7)، یو یو آی دی.گره(و7)

    سرچاپ یو یو آی دی.نسخه۴ از اجزا(0x919108F752D13320 برگردان طبیعی۶۴، 0x5BACF847DB4148A8 برگردان طبیعی۶۴)
    سرچاپ یو یو آی دی.ساخت نسخه۸(0x0123456789ABCDEF برگردان طبیعی۶۴، 0xFEDCBA9876543210 برگردان طبیعی۶۴)
    سرچاپ یو یو آی دی.مهر نسخه(0 برگردان طبیعی۶۴، 0 برگردان طبیعی۶۴، 9)
پایان
