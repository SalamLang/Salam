بسته ریشه

واردسازی شبکه.اچ تی تی پی.اعتبارسنجی
واردسازی آزمایش

تابع کد الگو(الگو: رشته): رشته:
    تلاش:
        _ := اعتبارسنجی.تطابق دارد("ab"، الگو)
        برگشت ""
    گرفتن خطا خ:
        برگشت خ.کد
    پایان
پایان

تابع ریشه:
    تلاش:
        آزمایش.ادعای درستی(اعتبارسنجی.تطابق دارد("ab-123"، "^[a-z]+-[0-9]+$"))
        آزمایش.ادعای نادرستی(اعتبارسنجی.تطابق دارد("ab_123"، "^[a-z]+-[0-9]+$"))
        آزمایش.ادعای درستی(اعتبارسنجی.تطابق دارد("2026-11-02"، "^\\d{4}-\\d{2}-\\d{2}$"))
        آزمایش.ادعای نادرستی(اعتبارسنجی.تطابق دارد(""، "^.+$"))
    گرفتن خطا خ:
        آزمایش.ادعا با پیام(نادرست، "خطای پیش‌بینی‌نشده: " + خ.به رشته())
    پایان
    آزمایش.ادعای برابری رشته(کد الگو("[a-")، "regex.invalid")
    آزمایش.ادعای برابری رشته(کد الگو("^ab$")، "")
    برگشت آزمایش.خلاصه()
پایان
