بسته ریشه

واردسازی کدگذاری.مقدار

تابع ریشه:
    ناپایا فهرست := وکتور {} برگردان وکتور<مقدار.مقدار>
    فهرست.بیفزا(مقدار.مقدار صحیح(7 برگردان صحیح۶۴))
    فهرست.بیفزا(مقدار.مقدار رشته("x"))
    فهرست.بیفزا(مقدار.مقدار منطقی(درست))
    آرایه := مقدار.مقدار آرایه(فهرست)
    سرچاپ مقدار.آرایه است(آرایه)، مقدار.طول آرایه(آرایه)، مقدار.به صحیح(مقدار.عضو آرایه(آرایه، 0))، مقدار.به رشته(مقدار.عضو آرایه(آرایه، 1))، مقدار.به منطقی(مقدار.عضو آرایه(آرایه، 2))
    ناپایا فیلدها := نگاشت {} برگردان نگاشت<رشته، مقدار.مقدار>
    فیلدها.درج("name"، مقدار.مقدار رشته("salam"))
    فیلدها.درج("year"، مقدار.مقدار صحیح(2024 برگردان صحیح۶۴))
    شیء := مقدار.مقدار شیء(فیلدها)
    سرچاپ مقدار.شیء است(شیء)، مقدار.طول شیء(شیء)، مقدار.شیء دارد(شیء، "name")، مقدار.شیء دارد(شیء، "none")
    سرچاپ مقدار.به رشته(مقدار.مقدار کلید(شیء، "name"))، مقدار.به صحیح(مقدار.مقدار کلید(شیء، "year"))
    کلیدها := مقدار.کلیدهای شیء(شیء)
    سرچاپ کلیدها.طول()
    تهی := مقدار.مقدار آرایه(وکتور {} برگردان وکتور<مقدار.مقدار>)
    سرچاپ مقدار.طول آرایه(تهی)، مقدار.طول شیء(مقدار.مقدار شیء(نگاشت {} برگردان نگاشت<رشته، مقدار.مقدار>))
پایان
