بسته ریشه

واردسازی کدگذاری.مقدار

تابع ریشه:
    ناپایا items := وکتور {} برگردان وکتور<مقدار.مقدار>
    items.بیفزا(مقدار.مقدار صحیح(7 برگردان صحیح۶۴))
    items.بیفزا(مقدار.مقدار رشته("x"))
    items.بیفزا(مقدار.مقدار منطقی(درست))
    arr := مقدار.مقدار آرایه(items)
    سرچاپ مقدار.آرایه است(arr)، مقدار.طول آرایه(arr)، مقدار.به صحیح(مقدار.عضو آرایه(arr، 0))، مقدار.به رشته(مقدار.عضو آرایه(arr، 1))، مقدار.به منطقی(مقدار.عضو آرایه(arr، 2))
    ناپایا fields := نگاشت {} برگردان نگاشت<رشته، مقدار.مقدار>
    fields.درج("name"، مقدار.مقدار رشته("salam"))
    fields.درج("year"، مقدار.مقدار صحیح(2024 برگردان صحیح۶۴))
    obj := مقدار.مقدار شیء(fields)
    سرچاپ مقدار.شیء است(obj)، مقدار.طول شیء(obj)، مقدار.شیء دارد(obj، "name")، مقدار.شیء دارد(obj، "none")
    سرچاپ مقدار.به رشته(مقدار.مقدار کلید(obj، "name"))، مقدار.به صحیح(مقدار.مقدار کلید(obj، "year"))
    keys := مقدار.کلیدهای شیء(obj)
    سرچاپ keys.طول()
    empty := مقدار.مقدار آرایه(وکتور {} برگردان وکتور<مقدار.مقدار>)
    سرچاپ مقدار.طول آرایه(empty)، مقدار.طول شیء(مقدار.مقدار شیء(نگاشت {} برگردان نگاشت<رشته، مقدار.مقدار>))
پایان
