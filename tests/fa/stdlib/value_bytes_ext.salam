بسته ریشه

واردسازی کدگذاری.مقدار
واردسازی فشرده سازی

تابع ریشه:
    خام := "abc"
    ناپایا ب := مقدار.مقدار دودویی(خام برگردان تهی*، خام.طول())
    سرچاپ مقدار.بایتی است(ب)، مقدار.طول بایت‌ها(ب)، مقدار.بایت(ب، 0)
    سرچاپ مقدار.بایت‌ها به رشته(ب)
    ناپایا بافر := مقدار.بایت‌ها به بافر(ب)
    سرچاپ بافر.طول
    فشرده سازی.آزادسازی بافر(بافر)

    ناپایا ب۲ := مقدار.مقدار دودویی رشته("pq")
    سرچاپ مقدار.بایتی است(ب۲)، مقدار.طول بایت‌ها(ب۲)

    ناپایا افزونه := مقدار.مقدار افزونه(0 - 5، "xy" برگردان تهی*، 2)
    ناپایا افزونه۲ := مقدار.مقدار افزونه رشته(7، "zw")
    سرچاپ مقدار.افزونه است(افزونه)، مقدار.نوع افزونه(افزونه)
    سرچاپ مقدار.طول داده افزونه(افزونه۲)، مقدار.داده افزونه(افزونه۲، 0)
    سرچاپ مقدار.داده افزونه به رشته(افزونه۲)
    ناپایا بافر۲ := مقدار.داده افزونه به بافر(افزونه۲)
    سرچاپ بافر۲.طول
    فشرده سازی.آزادسازی بافر(بافر۲)

    مقدار.آزادسازی مقدار(ب)
    مقدار.آزادسازی مقدار(ب۲)
    مقدار.آزادسازی مقدار(افزونه)
    مقدار.آزادسازی مقدار(افزونه۲)
    برگشت 0
پایان
