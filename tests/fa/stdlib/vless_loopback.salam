واردسازی حافظه
واردسازی رشته
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"
پایا UUID2 := "5783a3e7-e373-51cd-8642-c83782b807c5"
پایا CERT := "tests/fixtures/ssl/server.crt"
پایا KEY := "tests/fixtures/ssl/server.key"

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا finished := همگام سازی.گروه انتظار جدید()
ناپایا srv_settings := انتقال شبکه.تنظیمات {}
ناپایا srv_count := 1
ناپایا srv_log := ""

تابع hex_of(r: وی لس.درخواست): رشته:
    برگشت انتقال شبکه.به هگزا(وی لس.کدگذاری درخواست(r))
پایان

تابع headers():
    ناپایا r := وی لس.درخواست {}
    r.شناسه = انتقال شبکه.تجزیه یو یو آی دی(UUID1)
    r.فرمان = وی لس.فرمان تی سی پی
    r.نشانی = انتقال شبکه.نشانی جدید("example.com"، 443)
    سرچاپ "tcp domain"، hex_of(r) برابر "00b831381d63244d53ad4f8cda48b3081100" + "0101bb020b6578616d706c652e636f6d"
    r.نشانی = انتقال شبکه.نشانی جدید("1.2.3.4"، 80)
    سرچاپ "tcp ipv4"، hex_of(r) برابر "00b831381d63244d53ad4f8cda48b3081100" + "01" + "0050" + "01" + "01020304"
    r.نشانی = انتقال شبکه.نشانی جدید("2001:db8::1"، 8080)
    سرچاپ "udp ipv6"، hex_of(r) برابر "00b831381d63244d53ad4f8cda48b3081100" + "01" + "1f90" + "03" + "20010db8000000000000000000000001"
    r.فرمان = وی لس.فرمان یو دی پی
    r.نشانی = انتقال شبکه.نشانی جدید("8.8.8.8"، 53)
    سرچاپ "udp ipv4"، hex_of(r) برابر "00b831381d63244d53ad4f8cda48b3081100" + "02" + "0035" + "01" + "08080808"
    r.فرمان = وی لس.فرمان مالتی پلکس
    سرچاپ "mux has no address"، hex_of(r) برابر "00b831381d63244d53ad4f8cda48b3081100" + "03"
    r.فرمان = وی لس.فرمان تی سی پی
    r.جریان = "xtls-rprx-vision"
    r.نشانی = انتقال شبکه.نشانی جدید("example.com"، 443)
    سرچاپ "flow addon"، hex_of(r) برابر "00b831381d63244d53ad4f8cda48b30811" + "12" + "0a10" + "78746c732d727072782d766973696f6e" + "0101bb020b6578616d706c652e636f6d"
    ناپایا back := وی لس.درخواست {}
    consumed := وی لس.کدگشایی درخواست(وی لس.کدگذاری درخواست(r)، back)
    سرچاپ "flow roundtrip"، consumed، back.جریان، back.نشانی.میزبان، back.نشانی.درگاه، انتقال شبکه.قالب یو یو آی دی(back.شناسه) برابر UUID1
    ناپایا bad := وی لس.درخواست {}
    plain := انتقال شبکه.از هگزا("01b831381d63244d53ad4f8cda48b3081100" + "0101bb020b6578616d706c652e636f6d")
    سرچاپ "wrong version rejected"، وی لس.کدگشایی درخواست(plain، bad)
    cut := انتقال شبکه.از هگزا("00b831381d63244d53ad4f8cda48b3081100" + "0101bb020b6578616d")
    سرچاپ "truncated rejected"، وی لس.کدگشایی درخواست(cut، bad)
    odd := انتقال شبکه.از هگزا("00b831381d63244d53ad4f8cda48b3081100" + "09")
    سرچاپ "unknown command rejected"، وی لس.کدگشایی درخواست(odd، bad)
پایان

تابع links():
    l := وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@cdn.example.com:443?encryption=none&security=tls&sni=front.example.net&alpn=h2%2Chttp%2F1.1&fp=chrome&type=ws&host=real.example.org&path=%2Fvless%3Fed%3D2048&allowInsecure=1#My%20Server")
    سرچاپ "link ok"، l.معتبر، l.میزبان، l.درگاه، l.امنیت، l.شبکه
    سرچاپ "link fields"، l.نام سرور، l.الپن، l.اثر انگشت، l.سربرگ میزبان، l.مسیر، l.اجازه ناامن، l.برچسب
    s := وی لس.تنظیمات پیوند(l)
    سرچاپ "link to transport"، s.شبکه، s.تی ال اس، s.نام سرور، s.سربرگ میزبان، s.مسیر، s.داده زودهنگام، s.اجازه ناامن
    again := وی لس.تجزیه پیوند(وی لس.قالب پیوند(l))
    سرچاپ "format roundtrip"، again.معتبر، again.مسیر برابر l.مسیر، again.الپن برابر l.الپن، again.برچسب برابر l.برچسب
    v6 := وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@[2001:db8::5]:8443?type=tcp&flow=xtls-rprx-vision")
    سرچاپ "ipv6 link"، v6.معتبر، v6.میزبان، v6.درگاه، v6.جریان
    سرچاپ "reality refused"، وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h:443?security=reality").خطا
    سرچاپ "kcp refused"، وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h:443?type=kcp").خطا
    سرچاپ "bad uuid refused"، وی لس.تجزیه پیوند("vless://nope@h:443").خطا
    سرچاپ "other scheme refused"، وی لس.تجزیه پیوند("vmess://abc").خطا
پایان

تابع server():
    l := انتقال شبکه.شنود(0، srv_settings)
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا users := وکتور {} برگردان وکتور<وی لس.کاربر>
    users.بیفزا(وی لس.کاربر جدید(UUID1، ""))
    users.بیفزا(وی لس.کاربر جدید(UUID2، ""))
    buf := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
    تکرار srv_count:
        t := انتقال شبکه.پذیرش(l)
        اگر وارونه انتقال شبکه.معتبر(t):
            srv_log += "transport(" + t.خطا + ");"
            گذر
        پایان
        ناپایا c := وی لس.پذیرش(t، users)
        اگر وارونه c.معتبر:
            srv_log += "fail(" + c.خطا + ");"
            گذر
        پایان
        srv_log += "ok(" + c.کاربر.زیررشته(0، 8) + " " + رشته.از عدد(c.درخواست.فرمان برگردان صحیح۶۴) + " " + c.درخواست.نشانی.میزبان + ");"
        اگر c.درخواست.فرمان برابر وی لس.فرمان یو دی پی:
            تا درست:
                ناپایا p := انتقال شبکه.بایت‌های جدید(64)
                اگر وارونه وی لس.خواندن بسته(c، p):
                    انتقال شبکه.آزادسازی بایت‌ها(p)
                    بشکن
                پایان
                وی لس.نوشتن بسته(c، p.نشانگر، p.طول)
                انتقال شبکه.آزادسازی بایت‌ها(p)
            پایان
        وگرنه:
            تا درست:
                n := وی لس.خواندن(c، buf، 65536)
                اگر n کوچکتربرابر 0:
                    بشکن
                پایان
                وی لس.نوشتن(c، buf، n)
            پایان
        پایان
        وی لس.بستن(c)
    پایان
    حافظه.آزادسازی(buf)
    انتقال شبکه.بستن شنونده(l)
    همگام سازی.اتمام(finished)
پایان

تابع start(ss: انتقال شبکه.تنظیمات، count: صحیح):
    srv_settings = ss
    srv_count = count
    srv_log = ""
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    همگام سازی.افزودن(finished، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
پایان

تابع pattern(n: صحیح، seed: صحیح): انتقال شبکه.بایت‌ها:
    ناپایا b := انتقال شبکه.بایت‌های جدید(n + 1)
    تکرار n در i:
        انتقال شبکه.نوشتن بایت(b، (i * 13 + seed) & 255)
    پایان
    برگشت b
پایان

تابع stream_echo(label: رشته، c &: وی لس.اتصال):
    ناپایا good := c.معتبر
    ناپایا sent := 0
    ناپایا sizes := وکتور {} برگردان وکتور<صحیح>
    sizes.بیفزا(9)
    sizes.بیفزا(2000)
    sizes.بیفزا(50000)
    تکرار sizes.طول() در i:
        n := sizes.بگیر(i)
        ناپایا out := pattern(n، i)
        back := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
        ناپایا got := 0
        اگر وارونه وی لس.نوشتن(c، out.نشانگر، n):
            good = نادرست
        پایان
        تا got کوچکتر n:
            r := وی لس.خواندن(c، ((back برگردان صحیح۶۴) + (got برگردان صحیح۶۴)) برگردان تهی*، n - got)
            اگر r کوچکتربرابر 0:
                good = نادرست
                بشکن
            پایان
            got += r
        پایان
        اگر got برابر n:
            bp := back برگردان طبیعی۸*
            تکرار n در k:
                اگر (bp[k] برگردان صحیح) نابرابر ((k * 13 + i) & 255):
                    good = نادرست
                    بشکن
                پایان
            پایان
        پایان
        sent += n
        حافظه.آزادسازی(back)
        انتقال شبکه.آزادسازی بایت‌ها(out)
    پایان
    sizes.آزادکن()
    وی لس.بستن(c)
    سرچاپ label، "echo ok:"، good، "bytes:"، sent
پایان

تابع over(label: رشته، cs: انتقال شبکه.تنظیمات، ss: انتقال شبکه.تنظیمات):
    start(ss، 1)
    ناپایا c := وی لس.شماره گیری("127.0.0.1"، port، cs، UUID1، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("target.example.com"، 443))
    اگر وارونه c.معتبر:
        سرچاپ label، "dial failed"، c.خطا
    وگرنه:
        stream_echo(label، c)
    پایان
    همگام سازی.انتظار(finished)
پایان

تابع udp_echo(label: رشته، cs: انتقال شبکه.تنظیمات، ss: انتقال شبکه.تنظیمات):
    start(ss، 1)
    ناپایا c := وی لس.شماره گیری("127.0.0.1"، port، cs، UUID2، ""، وی لس.فرمان یو دی پی، انتقال شبکه.نشانی جدید("8.8.4.4"، 53))
    ناپایا good := c.معتبر
    ناپایا sizes := وکتور {} برگردان وکتور<صحیح>
    sizes.بیفزا(1)
    sizes.بیفزا(512)
    sizes.بیفزا(1400)
    تکرار sizes.طول() در i:
        n := sizes.بگیر(i)
        ناپایا out := pattern(n، 40 + i)
        ناپایا back := انتقال شبکه.بایت‌های جدید(64)
        اگر وارونه وی لس.نوشتن بسته(c، out.نشانگر، n) یا وارونه وی لس.خواندن بسته(c، back):
            good = نادرست
        وگرنه:
            good = good و back.طول برابر n و انتقال شبکه.به هگزا(back) برابر انتقال شبکه.به هگزا(out)
        پایان
        انتقال شبکه.آزادسازی بایت‌ها(out)
        انتقال شبکه.آزادسازی بایت‌ها(back)
    پایان
    sizes.آزادکن()
    وی لس.بستن(c)
    همگام سازی.انتظار(finished)
    سرچاپ label، "datagrams echoed:"، good، srv_log
پایان

تابع rejects():
    plain := انتقال شبکه.تنظیمات {}
    start(plain، 2)
    c1 := وی لس.شماره گیری("127.0.0.1"، port، plain، "00000000-0000-4000-8000-000000000001"، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("a.example"، 1))
    b := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    ناپایا c1m := c1
    r1 := وی لس.خواندن(c1m، b، 8)
    c2 := وی لس.شماره گیری("127.0.0.1"، port، plain، UUID1، "xtls-rprx-vision"، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("a.example"، 1))
    ناپایا c2m := c2
    r2 := وی لس.خواندن(c2m، b، 8)
    همگام سازی.انتظار(finished)
    حافظه.آزادسازی(b)
    سرچاپ "unknown user gets nothing"، r1 کوچکتربرابر 0
    سرچاپ "unsupported flow gets nothing"، r2 کوچکتربرابر 0
    سرچاپ "server saw"، srv_log
پایان

تابع ریشه:
    headers()
    links()

    plain := انتقال شبکه.تنظیمات {}
    over("tcp"، plain، plain)

    ناپایا tls_srv := انتقال شبکه.تنظیمات {}
    tls_srv.تی ال اس = درست
    tls_srv.پرونده گواهی = CERT
    tls_srv.پرونده کلید = KEY
    ناپایا tls_cli := انتقال شبکه.تنظیمات {}
    tls_cli.تی ال اس = درست
    tls_cli.اجازه ناامن = درست
    tls_cli.نام سرور = "front.example.net"
    tls_cli.الپن = "http/1.1"
    tls_cli.اثر انگشت = "chrome"
    over("tls"، tls_cli، tls_srv)

    ناپایا ws := انتقال شبکه.تنظیمات {}
    ws.شبکه = "ws"
    ws.مسیر = "/vless"
    ws.سربرگ میزبان = "cdn.example.com"
    over("ws"، ws، ws)

    ناپایا hu := انتقال شبکه.تنظیمات {}
    hu.شبکه = "httpupgrade"
    hu.مسیر = "/hu"
    over("httpupgrade"، hu، hu)

    ناپایا wss_srv := ws
    wss_srv.تی ال اس = درست
    wss_srv.پرونده گواهی = CERT
    wss_srv.پرونده کلید = KEY
    ناپایا wss_cli := ws
    wss_cli.تی ال اس = درست
    wss_cli.اجازه ناامن = درست
    wss_cli.نام سرور = "www.example.org"
    over("ws+tls"، wss_cli، wss_srv)

    ناپایا frag := wss_cli
    frag.تکه تکه کردن = درست
    frag.کمینه تکه = 4
    frag.بیشینه تکه = 12
    frag.تاخیر تکه میلی ثانیه = 1
    over("ws+tls, fragmented hello"، frag، wss_srv)

    start(wss_srv، 1)
    link := "vless://" + UUID1 + "@127.0.0.1:" + رشته.از عدد(port برگردان صحیح۶۴) + "?encryption=none&security=tls&sni=www.example.org&type=ws&host=cdn.example.com&path=%2Fvless&allowInsecure=1#iran"
    parsed := وی لس.تجزیه پیوند(link)
    ناپایا lc := وی لس.شماره گیری پیوند(parsed، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("target.example.com"، 443))
    اگر lc.معتبر:
        stream_echo("dial from link"، lc)
    وگرنه:
        سرچاپ "dial from link failed"، lc.خطا
    پایان
    همگام سازی.انتظار(finished)

    udp_echo("udp over tcp"، plain، plain)
    udp_echo("udp over ws"، ws، ws)
    rejects()
پایان
