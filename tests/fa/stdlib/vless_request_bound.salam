واردسازی حافظه
واردسازی شبکه.تونل
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

تابع request(domain_len: صحیح): وکتور<طبیعی۸>:
    ناپایا hdr := وکتور {} برگردان وکتور<طبیعی۸>
    hdr.بیفزا(0 برگردان طبیعی۸)
    تکرار 16:
        hdr.بیفزا(7 برگردان طبیعی۸)
    پایان
    hdr.بیفزا(255 برگردان طبیعی۸)
    hdr.بیفزا(10 برگردان طبیعی۸)
    hdr.بیفزا(253 برگردان طبیعی۸)
    تکرار 253:
        hdr.بیفزا(0 برگردان طبیعی۸)
    پایان
    hdr.بیفزا(1 برگردان طبیعی۸)
    hdr.بیفزا(1 برگردان طبیعی۸)
    hdr.بیفزا(187 برگردان طبیعی۸)
    hdr.بیفزا(2 برگردان طبیعی۸)
    hdr.بیفزا(domain_len برگردان طبیعی۸)
    تکرار domain_len:
        hdr.بیفزا(65 برگردان طبیعی۸)
    پایان
    برگشت hdr
پایان

تابع feed(hdr: وکتور<طبیعی۸>): منطقی:
    p := تونل.لوله جدید()
    a := تونل.سر اول لوله(p)
    b := تونل.سر دوم لوله(p)
    buf := حافظه.تخصیص(hdr.طول() برگردان طبیعی۶۴) برگردان طبیعی۸*
    تکرار hdr.طول() در i:
        buf[i] = hdr.بگیر(i)
    پایان
    a.نوشتن بایت(buf برگردان تهی*، hdr.طول())
    حافظه.آزادسازی(buf برگردان تهی*)
    ناپایا t := انتقال شبکه.از جریان(b، نادرست)
    ناپایا r := وی لس.درخواست {}
    ok := وی لس.خواندن درخواست(t، r)
    سرچاپ "domain"، r.نشانی.میزبان.طول()، r.نشانی.درگاه
    برگشت ok
پایان

تابع ریشه():
    سرچاپ "longest header with a 255 byte domain"، feed(request(255))
    سرچاپ "short domain"، feed(request(11))
پایان
