واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا port := 0

تابع pattern(n: صحیح، seed: صحیح): انتقال شبکه.بایت‌ها:
    ناپایا b := انتقال شبکه.بایت‌های جدید(n + 1)
    تکرار n در i:
        انتقال شبکه.نوشتن بایت(b، (i * 7 + seed) & 255)
    پایان
    برگشت b
پایان

تابع same(a: انتقال شبکه.بایت‌ها، b: انتقال شبکه.بایت‌ها): منطقی:
    برگشت انتقال شبکه.برابر(a، b)
پایان

تابع unit():
    id := انتقال شبکه.تجزیه یو یو آی دی(UUID1)
    ناپایا tx := وی لس.ویژن جدید(id)
    ناپایا rx := وی لس.ویژن جدید(id)
    ناپایا sent := انتقال شبکه.بایت‌های جدید(64)
    ناپایا all := انتقال شبکه.بایت‌های جدید(64)
    ناپایا wire := انتقال شبکه.بایت‌های جدید(64)
    ناپایا first_len := 0
    تکرار 10 در i:
        ناپایا part := pattern(10 + i * 37، i)
        cmd := وی لس.فرمان ادامه ویژن
        ناپایا f := وی لس.لایه گذاری ویژن(tx، part.نشانگر، part.طول، cmd، i برابر 0)
        اگر i برابر 0:
            first_len = f.طول
        پایان
        انتقال شبکه.نوشتن بایت‌ها(wire، f)
        انتقال شبکه.نوشتن بایت‌ها(sent، part)
        انتقال شبکه.آزادسازی بایت‌ها(f)
        انتقال شبکه.آزادسازی بایت‌ها(part)
    پایان
    ناپایا end_part := pattern(5، 99)
    ناپایا endf := وی لس.لایه گذاری ویژن(tx، end_part.نشانگر، end_part.طول، وی لس.فرمان خاتمه ویژن، نادرست)
    انتقال شبکه.نوشتن بایت‌ها(wire، endf)
    انتقال شبکه.نوشتن بایت‌ها(sent، end_part)
    انتقال شبکه.آزادسازی بایت‌ها(endf)
    انتقال شبکه.آزادسازی بایت‌ها(end_part)
    انتقال شبکه.نوشتن رشته(wire، "raw tail")
    انتقال شبکه.نوشتن رشته(sent، "raw tail")
    سرچاپ "first frame is padded to the long size:"، first_len بزرگتربرابر 16 + 5 + 10 + 900 - 10
    سرچاپ "first frame starts with the uuid:"، انتقال شبکه.بایت در(wire، 0) برابر 0xb8 و انتقال شبکه.بایت در(wire، 15) برابر 0x11
    ناپایا off := 0
    ناپایا ok := درست
    تا off کوچکتر wire.طول:
        ناپایا step := 3
        اگر off + step بزرگتر wire.طول:
            step = wire.طول - off
        پایان
        ok = وی لس.برداشتن لایه ویژن(rx، انتقال شبکه.نشانگر بایت‌ها(wire، off)، step، all) و ok
        off += step
    پایان
    سرچاپ "unpadded in 3 byte pieces equals the input:"، ok، same(all، sent)، all.طول برابر sent.طول
    سرچاپ "padding ended:"، rx.خواندن تمام، "continue is 0:"، وی لس.فرمان ادامه ویژن، "end is 1:"، وی لس.فرمان خاتمه ویژن، "direct is 2:"، وی لس.فرمان مستقیم ویژن
    ناپایا other := وی لس.ویژن جدید(انتقال شبکه.تجزیه یو یو آی دی("5783a3e7-e373-51cd-8642-c83782b807c5"))
    ناپایا got := انتقال شبکه.بایت‌های جدید(64)
    وی لس.برداشتن لایه ویژن(other، wire.نشانگر، wire.طول، got)
    سرچاپ "a different user id turns the stream raw:"، other.خواندن خام، got.طول برابر wire.طول
    وی لس.آزادسازی ویژن(tx)
    وی لس.آزادسازی ویژن(rx)
    وی لس.آزادسازی ویژن(other)
    انتقال شبکه.آزادسازی بایت‌ها(sent)
    انتقال شبکه.آزادسازی بایت‌ها(all)
    انتقال شبکه.آزادسازی بایت‌ها(wire)
    انتقال شبکه.آزادسازی بایت‌ها(got)
پایان

تابع server():
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    t := انتقال شبکه.پذیرش(l)
    ناپایا users := وکتور {} برگردان وکتور<وی لس.کاربر>
    users.بیفزا(وی لس.کاربر جدید(UUID1، وی لس.جریان ویژن))
    ناپایا c := وی لس.پذیرش(t، users)
    buf := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
    تا درست:
        n := وی لس.خواندن(c، buf، 65536)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        اگر وارونه وی لس.نوشتن(c، buf، n):
            بشکن
        پایان
    پایان
    حافظه.آزادسازی(buf)
    وی لس.بستن(c)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع echo_check():
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
    tc := انتقال شبکه.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {})
    ناپایا c := وی لس.کارخواه(tc، UUID1، وی لس.جریان ویژن، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("example.com"، 443))
    ناپایا good := c.معتبر
    ناپایا total := 0
    ناپایا sizes := وکتور {} برگردان وکتور<صحیح>
    تکرار 12 در i:
        sizes.بیفزا(1 + i * 211)
    پایان
    sizes.بیفزا(20000)
    sizes.بیفزا(65000)
    sizes.بیفزا(1)
    تکرار sizes.طول() در i:
        n := sizes.بگیر(i)
        ناپایا out := pattern(n، i)
        back := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
        اگر وارونه وی لس.نوشتن(c، out.نشانگر، n):
            good = نادرست
        پایان
        ناپایا got := 0
        تا got کوچکتر n:
            r := وی لس.خواندن(c، ((back برگردان صحیح۶۴) + (got برگردان صحیح۶۴)) برگردان تهی*، n - got)
            اگر r کوچکتربرابر 0:
                good = نادرست
                بشکن
            پایان
            got += r
        پایان
        bp := back برگردان طبیعی۸*
        تکرار got در k:
            اگر (bp[k] برگردان صحیح) نابرابر ((k * 7 + i) & 255):
                good = نادرست
                بشکن
            پایان
        پایان
        total += n
        حافظه.آزادسازی(back)
        انتقال شبکه.آزادسازی بایت‌ها(out)
    پایان
    وی لس.بستن(c)
    نخ‌پیوند(t)
    سرچاپ "vision echo over a real connection:"، good، total
پایان

تابع link_check():
    l := وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h.example.com:443?encryption=none&security=tls&type=grpc&serviceName=my%2Fsvc&mode=multi&sni=h.example.com&flow=xtls-rprx-vision#node")
    سرچاپ "grpc link:"، l.معتبر، l.خطا، l.شبکه، l.نام سرویس، l.حالت جی آر پی سی، l.جریان
    s := وی لس.تنظیمات پیوند(l)
    سرچاپ "grpc settings:"، s.شبکه، s.نام سرویس، s.حالت جی آر پی سی، s.تی ال اس
    again := وی لس.تجزیه پیوند(وی لس.قالب پیوند(l))
    سرچاپ "grpc round trip:"، again.معتبر، again.نام سرویس برابر l.نام سرویس، again.حالت جی آر پی سی، again.شبکه
    g := وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h.example.com:443?type=grpc&serviceName=gun")
    سرچاپ "gun is the default mode:"، g.معتبر، g.حالت جی آر پی سی
پایان

تابع ریشه:
    unit()
    echo_check()
    link_check()
پایان
