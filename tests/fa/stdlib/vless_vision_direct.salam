واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"

تابع frame(v &: وی لس.ویژن، text: رشته، cmd: صحیح): انتقال شبکه.بایت‌ها:
    ناپایا p := انتقال شبکه.از رشته(text)
    f := وی لس.لایه گذاری ویژن(v، p.نشانگر، p.طول، cmd، نادرست)
    انتقال شبکه.آزادسازی بایت‌ها(p)
    برگشت f
پایان

تابع ریشه:
    id := انتقال شبکه.تجزیه یو یو آی دی(UUID1)
    ناپایا tx := وی لس.ویژن جدید(id)
    ناپایا rx := وی لس.ویژن جدید(id)
    ناپایا out := انتقال شبکه.بایت‌های جدید(64)
    f1 := frame(tx، "hello"، وی لس.فرمان ادامه ویژن)
    f2 := frame(tx، "world"، وی لس.فرمان مستقیم ویژن)
    ناپایا wire := انتقال شبکه.بایت‌های جدید(64)
    انتقال شبکه.نوشتن بایت‌ها(wire، f1)
    انتقال شبکه.نوشتن بایت‌ها(wire، f2)
    ok := وی لس.برداشتن لایه ویژن(rx، wire.نشانگر، wire.طول، out)
    سرچاپ "unpadded:"، ok، out.طول، انتقال شبکه.به هگزا(out)
    سرچاپ "frame ends exactly at the end of the data:"، rx.خواندن تمام، rx.فرمان برابر وی لس.فرمان مستقیم ویژن
    سرچاپ "no switch before the reader runs:"، rx.تغییر کرد
    ناپایا rx2 := وی لس.ویژن جدید(id)
    ناپایا out2 := انتقال شبکه.بایت‌های جدید(64)
    ok2 := وی لس.برداشتن لایه ویژن(rx2، f1.نشانگر، f1.طول، out2)
    سرچاپ "a continue frame leaves the reader open:"، ok2، rx2.خواندن تمام، out2.طول
پایان
