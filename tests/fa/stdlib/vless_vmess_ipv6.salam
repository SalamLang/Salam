واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس
واردسازی شبکه.وی مس
واردسازی رشته
واردسازی همگام سازی

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا finished := همگام سازی.گروه انتظار جدید()
ناپایا srv_settings := انتقال شبکه.تنظیمات {}
ناپایا srv_log := ""
ناپایا use_vmess := نادرست

تابع server():
    l := انتقال شبکه.شنود(0، srv_settings)
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا users := وکتور {} برگردان وکتور<وی لس.کاربر>
    users.بیفزا(وی لس.کاربر جدید(UUID1، ""))
    ناپایا mu := وکتور {} برگردان وکتور<وی مس.کاربر>
    mu.بیفزا(وی مس.کاربر جدید(UUID1))
    ناپایا rf := وی مس.فیلتر بازپخش جدید()
    buf := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
    t := انتقال شبکه.پذیرش(l)
    اگر وارونه انتقال شبکه.معتبر(t):
        srv_log += "transport(" + t.خطا + ");"
    وگرنه use_vmess:
        ناپایا c := وی مس.پذیرش(t، mu، rf)
        اگر c.معتبر:
            srv_log += "ok(" + c.درخواست.نشانی.میزبان + ":" + رشته.از عدد(c.درخواست.نشانی.درگاه برگردان صحیح۶۴) + ");"
            تا درست:
                n := وی مس.خواندن(c، buf، 65536)
                اگر n کوچکتربرابر 0: بشکن پایان
                وی مس.نوشتن(c، buf، n)
            پایان
            وی مس.بستن(c)
        وگرنه:
            srv_log += "fail(" + c.خطا + ");"
        پایان
    وگرنه:
        ناپایا c := وی لس.پذیرش(t، users)
        اگر c.معتبر:
            srv_log += "ok(" + رشته.از عدد(c.درخواست.فرمان برگردان صحیح۶۴) + " " + c.درخواست.نشانی.میزبان + ":" + رشته.از عدد(c.درخواست.نشانی.درگاه برگردان صحیح۶۴) + ");"
            اگر c.درخواست.فرمان برابر وی لس.فرمان یو دی پی:
                تا درست:
                    ناپایا p := انتقال شبکه.بایت‌های جدید(64)
                    اگر وارونه وی لس.خواندن بسته(c، p):
                        انتقال شبکه.آزادسازی بایت‌ها(p)
                        بشکن
                    پایان
                    وی لس.نوشتن بسته(c، p.نشانگر، p.طول)
                    انتقال شبکه.آزادسازی بایت‌ها(p)
                پایان
            وگرنه:
                تا درست:
                    n := وی لس.خواندن(c، buf، 65536)
                    اگر n کوچکتربرابر 0: بشکن پایان
                    وی لس.نوشتن(c، buf، n)
                پایان
            پایان
            وی لس.بستن(c)
        وگرنه:
            srv_log += "fail(" + c.خطا + ");"
        پایان
    پایان
    حافظه.آزادسازی(buf)
    انتقال شبکه.بستن شنونده(l)
    همگام سازی.اتمام(finished)
پایان

تابع start(ss: انتقال شبکه.تنظیمات):
    srv_settings = ss
    srv_log = ""
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    همگام سازی.افزودن(finished، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
پایان

تابع headers():
    ناپایا r := وی لس.درخواست {}
    r.شناسه = انتقال شبکه.تجزیه یو یو آی دی(UUID1)
    r.فرمان = وی لس.فرمان یو دی پی
    r.نشانی = انتقال شبکه.نشانی جدید("2606:4700:4700::1111"، 53)
    ناپایا back := وی لس.درخواست {}
    ناپایا consumed := وی لس.کدگشایی درخواست(وی لس.کدگذاری درخواست(r)، back)
    سرچاپ "vless udp v6 header"، consumed، back.فرمان برابر وی لس.فرمان یو دی پی، back.نشانی.میزبان، back.نشانی.درگاه، back.نشانی.نوع برابر انتقال شبکه.نشانی آی پی شش
    r.نشانی = انتقال شبکه.نشانی جدید("[2001:4860:4860::8888]"، 443)
    consumed = وی لس.کدگشایی درخواست(وی لس.کدگذاری درخواست(r)، back)
    سرچاپ "vless bracketed host"، consumed، back.نشانی.میزبان، back.نشانی.نوع برابر انتقال شبکه.نشانی آی پی شش
پایان

تابع ریشه:
    headers()
    probe := تی سی پی.پیوند روی("::1"، 0)
    اگر وارونه تی سی پی.معتبر(probe):
        سرچاپ "ipv6 unavailable"
        برگشت
    پایان
    تی سی پی.بستن سرور(probe)

    ناپایا ss := انتقال شبکه.تنظیمات {}
    ss.نشانی شنود = "::1"
    cs := انتقال شبکه.تنظیمات {}

    use_vmess = نادرست
    start(ss)
    ناپایا c := وی لس.شماره گیری("::1"، port، cs، UUID1، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("2001:db8::7"، 443))
    سرچاپ "vless tcp over ::1"، c.معتبر
    وی لس.نوشتن(c، "hello vless six" برگردان تهی*، 15)
    b := حافظه.تخصیص صفرشده(64 برگردان طبیعی۶۴)
    n := وی لس.خواندن(c، b، 64)
    سرچاپ n، رشته.زیررشته(b برگردان رشته، 0، n)
    وی لس.بستن(c)
    همگام سازی.انتظار(finished)
    سرچاپ srv_log

    start(ss)
    ناپایا u := وی لس.شماره گیری("[::1]"، port، cs، UUID1، ""، وی لس.فرمان یو دی پی، انتقال شبکه.نشانی جدید("2001:4860:4860::8844"، 53))
    سرچاپ "vless udp over ::1"، u.معتبر
    ناپایا out := انتقال شبکه.بایت‌های جدید(16)
    انتقال شبکه.نوشتن رشته(out، "datagram six")
    ناپایا back := انتقال شبکه.بایت‌های جدید(16)
    سرچاپ وی لس.نوشتن بسته(u، out.نشانگر، out.طول)، وی لس.خواندن بسته(u، back)، back.طول
    وی لس.بستن(u)
    همگام سازی.انتظار(finished)
    سرچاپ srv_log

    use_vmess = درست
    start(ss)
    ناپایا vc := وی مس.شماره گیری("::1"، port، cs، UUID1، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("2001:db8::9"، 8443))
    سرچاپ "vmess tcp over ::1"، vc.معتبر
    وی مس.نوشتن(vc، "hello vmess six" برگردان تهی*، 15)
    m := وی مس.خواندن(vc، b، 64)
    سرچاپ m، رشته.زیررشته(b برگردان رشته، 0، m)
    وی مس.بستن(vc)
    همگام سازی.انتظار(finished)
    سرچاپ srv_log
پایان
