واردسازی حافظه
واردسازی رشته
واردسازی همگام سازی
واردسازی زمان
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی مس

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"
پایا UUID2 := "5783a3e7-e373-51cd-8642-c83782b807c5"

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا srv_settings := انتقال شبکه.تنظیمات {}
ناپایا srv_count := 1
ناپایا srv_log := ""
ناپایا finished := همگام سازی.گروه انتظار جدید()

تابع check(label: رشته، got: انتقال شبکه.بایت‌ها، want: رشته):
    سرچاپ label، انتقال شبکه.به هگزا(got) برابر want
پایان

تابع vectors():
    k := انتقال شبکه.از هگزا("000102030405060708090a0b0c0d0e0f")
    pt := انتقال شبکه.از هگزا("00112233445566778899aabbccddeeff")
    c := وی مس.بلوک ای ای اس۱۲۸(k، pt، نادرست)
    check("aes-128 fips-197 encrypt"، c، "69c4e0d86a7b0430d8cdb78070b4c55a")
    check("aes-128 fips-197 decrypt"، وی مس.بلوک ای ای اس۱۲۸(k، c، درست)، "00112233445566778899aabbccddeeff")
    e := انتقال شبکه.بایت‌های جدید(1)
    check("shake128 empty, 32 bytes"، وی مس.شیک۱۲۸(e، 32)، "7f9c2ba4e88f827d616045507605853ed73b8093f6efbc88eb1a6eacfa66ef26")
    abc := انتقال شبکه.از رشته("abc")
    long := انتقال شبکه.به هگزا(وی مس.شیک۱۲۸(abc، 400))
    سرچاپ "shake128 abc, start"، long.زیررشته(0، 64) برابر "5881092dd818bf5cf8a3ddb793fbcba74097d5c526a6d35f97b83351940f2cc8"
    سرچاپ "shake128 abc, past one rate block"، long.زیررشته(700، 100) برابر "526b31002afbd1b4ebea69c8400c3deb4c1c35d6dbb75651b284076f5fde47b4a0586ee173e30bd4d08f2bc59c6114bdd745"
    سرچاپ "crc32 check value"، وی مس.سی آر سی۳۲(انتقال شبکه.از رشته("123456789")) برابر 3421780262
    سرچاپ "fnv1a check value"، وی مس.اف ان وی یک ای(انتقال شبکه.از رشته("a")) برابر 3826002220
    uuid := انتقال شبکه.تجزیه یو یو آی دی(UUID1)
    ck := وی مس.کلید فرمان(uuid)
    check("cmd key"، ck، "b50d916ac0cec067981af8e5f38a758f")
    none := انتقال شبکه.بایت‌ها {}
    check("kdf one label"، وی مس.تابع اشتقاق کلید(ck، "AES Auth ID Encryption"، none، none)، "1415ba74ca8b3d041a8f583fb4116315c589ae7b6e81765b601aa166c62871f7")
    a := انتقال شبکه.از هگزا("0102030405060708090a0b0c0d0e0f10")
    b := انتقال شبکه.از هگزا("1112131415161718")
    check("kdf three parts"، وی مس.تابع اشتقاق کلید(ck، "VMess Header AEAD Key_Length"، a، b)، "870bcc37181146a588556ec38da75b67617a2654f1e844e903d1ac1e74ab1955")
    check("kdf label over one block"، وی مس.تابع اشتقاق کلید(ck، "this label is deliberately longer than sixty four bytes so that the key hashing path runs"، a، b)، "307d54f82284a0f3a864e57f9f47122f68fb3317d510c51ad5560ea215c2332d")
    r4 := انتقال شبکه.از هگزا("a1b2c3d4")
    aid := وی مس.ساخت شناسه احراز(ck، 1700000000، r4)
    check("auth id"، aid، "afabbebf298c2611f08228d760111288")
    ناپایا ts := 0 برگردان صحیح۶۴
    سرچاپ "auth id opens"، وی مس.گشودن شناسه احراز(ck، aid، ts)، ts برابر 1700000000
    other := وی مس.کلید فرمان(انتقال شبکه.تجزیه یو یو آی دی(UUID2))
    سرچاپ "auth id rejects another user"، وارونه وی مس.گشودن شناسه احراز(other، aid، ts)
    ناپایا bent := انتقال شبکه.از هگزا(انتقال شبکه.به هگزا(aid))
    انتقال شبکه.تنظیم بایت(bent، 3، انتقال شبکه.بایت در(bent، 3) ^ 1)
    سرچاپ "auth id rejects a flipped bit"، وارونه وی مس.گشودن شناسه احراز(ck، bent، ts)
    data := انتقال شبکه.از رشته("hello vmess header payload")
    sealed := وی مس.مهر سرآیند(ck، data، 1700000000، r4، b)
    check("sealed header"، sealed، "afabbebf298c2611f08228d7601112882879fbb74df2607ca6f7ced17d02b025c9af1112131415161718d6567a4475d5a6abbab6b2e77e020f182bd034fe14487022fd8ab25a67ce927cd6e84b757d00f152eef5")
    ناپایا enc_len := انتقال شبکه.بایت‌های جدید(18)
    انتقال شبکه.نوشتن خام(enc_len، انتقال شبکه.نشانگر بایت‌ها(sealed، 16)، 18)
    ناپایا enc_hdr := انتقال شبکه.بایت‌های جدید(64)
    انتقال شبکه.نوشتن خام(enc_hdr، انتقال شبکه.نشانگر بایت‌ها(sealed، 42)، sealed.طول - 42)
    سرچاپ "header length opens"، وی مس.گشودن طول سرآیند(ck، aid، enc_len، b)
    opened := وی مس.گشودن سرآیند(ck، aid، enc_hdr، b)
    سرچاپ "header opens"، opened.خراب، انتقال شبکه.به هگزا(opened) برابر انتقال شبکه.به هگزا(data)
    انتقال شبکه.تنظیم بایت(enc_hdr، 5، انتقال شبکه.بایت در(enc_hdr، 5) ^ 0x80)
    سرچاپ "tampered header rejected"، وی مس.گشودن سرآیند(ck، aid، enc_hdr، b).خراب
    انتقال شبکه.تنظیم بایت(enc_len، 0، انتقال شبکه.بایت در(enc_len، 0) ^ 1)
    سرچاپ "tampered length rejected"، وی مس.گشودن طول سرآیند(ck، aid، enc_len، b)
پایان

تابع request_vectors():
    key := انتقال شبکه.از هگزا("101112131415161718191a1b1c1d1e1f")
    iv := انتقال شبکه.از هگزا("a0a1a2a3a4a5a6a7a8a9aaabacadaeaf")
    ناپایا r := وی مس.درخواست {}
    r.بردار آغازین = iv
    r.کلید = key
    r.بایت پاسخ = 0x7b
    r.گزینه ها = 5
    r.امنیت = وی مس.امنیت ای ای اس۱۲۸ جی سی ام
    r.فرمان = وی مس.فرمان تی سی پی
    r.نشانی = انتقال شبکه.نشانی جدید("example.com"، 443)
    plain := وی مس.کدگذاری درخواست(r)
    check("request header bytes"، plain، "01a0a1a2a3a4a5a6a7a8a9aaabacadaeaf101112131415161718191a1b1c1d1e1f7b0503000101bb020b6578616d706c652e636f6dec702322")
    ناپایا back := وی مس.درخواست {}
    سرچاپ "request decodes"، وی مس.کدگشایی درخواست(plain، back)، back.نشانی.میزبان، back.نشانی.درگاه، back.فرمان، back.امنیت، back.گزینه ها
    ناپایا bad := انتقال شبکه.از هگزا(انتقال شبکه.به هگزا(plain))
    انتقال شبکه.تنظیم بایت(bad، 40، انتقال شبکه.بایت در(bad، 40) ^ 1)
    ناپایا again := وی مس.درخواست {}
    سرچاپ "request checksum catches a flip"، وارونه وی مس.کدگشایی درخواست(bad، again)
    r.نشانی = انتقال شبکه.نشانی جدید("2001:db8::7"، 53)
    r.فرمان = وی مس.فرمان یو دی پی
    ناپایا v6 := وی مس.درخواست {}
    سرچاپ "ipv6 udp request roundtrip"، وی مس.کدگشایی درخواست(وی مس.کدگذاری درخواست(r)، v6)، v6.نشانی.میزبان، v6.نشانی.نوع، v6.فرمان
    r.طول لایه گذاری = 9
    ناپایا padded := وی مس.درخواست {}
    سرچاپ "padded request roundtrip"، وی مس.کدگشایی درخواست(وی مس.کدگذاری درخواست(r)، padded)، padded.طول لایه گذاری
پایان

تابع chunk_vectors():
    key := انتقال شبکه.از هگزا("101112131415161718191a1b1c1d1e1f")
    iv := انتقال شبکه.از هگزا("a0a1a2a3a4a5a6a7a8a9aaabacadaeaf")
    ناپایا parts := وکتور {} برگردان وکتور<انتقال شبکه.بایت‌ها>
    parts.بیفزا(انتقال شبکه.از رشته("hello vmess body"))
    parts.بیفزا(انتقال شبکه.از رشته("second chunk of data"))
    check("aes-gcm chunks, masked lengths"، وی مس.کدگذاری قطعه ها(وی مس.امنیت ای ای اس۱۲۸ جی سی ام، 5، key، iv، parts، درست)، "4edd9483a48e14b9324f9956d75dd9bcfba59ec2760ad4edb6119ab00f419d71a6a039ff2b5015a054be7a4ad392b1352683ee7874717b2563149574c763381edec1cf2d947a0f7734bf992677b4723edcc5838b0e65e593550b")
    check("chacha20-poly1305 chunks"، وی مس.کدگذاری قطعه ها(وی مس.امنیت چاچا۲۰ پلی۱۳۰۵، 5، key، iv، parts، درست)، "4eddf25651e2e7bd5b735604cef2691376286a7e0bf0267aa682224fe5ad005062ef39ff591e1cd235bb543d5c5a70ad10fcf1ab6195fdd636a34b792a35fa44151d1262527aaca534bff3db191df96fa8d8f2d4b1865da92258")
    check("none chunks"، وی مس.کدگذاری قطعه ها(وی مس.امنیت هیچ، 5، key، iv، parts، درست)، "4eed68656c6c6f20766d65737320626f647939cf7365636f6e64206368756e6b206f66206461746134af")
    check("aes-gcm chunks, authenticated lengths"، وی مس.کدگذاری قطعه ها(وی مس.امنیت ای ای اس۱۲۸ جی سی ام، 21، key، iv، parts، درست)، "41738983cfe7033fe27d7c77f3df8866aaa29483a48e14b9324f9956d75dd9bcfba59ec2760ad4edb6119ab00f419d71a6a0d67b5972e62ec3b41a9999895d3b11b062a82b5015a054be7a4ad392b1352683ee7874717b2563149574c763381edec1cf2d947a0f7773d271614077d313fc9d122c61cbf9c43f9d992677b4723edcc5838b0e65e593550b")
    check("aes-gcm chunks, plain lengths"، وی مس.کدگذاری قطعه ها(وی مس.امنیت ای ای اس۱۲۸ جی سی ام، 1، key، iv، parts، درست)، "00209483a48e14b9324f9956d75dd9bcfba59ec2760ad4edb6119ab00f419d71a6a000242b5015a054be7a4ad392b1352683ee7874717b2563149574c763381edec1cf2d947a0f770010992677b4723edcc5838b0e65e593550b")
    parts.آزادکن()
پایان

تابع server():
    l := انتقال شبکه.شنود(0، srv_settings)
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا rf := وی مس.فیلتر بازپخش جدید()
    ناپایا users := وکتور {} برگردان وکتور<وی مس.کاربر>
    users.بیفزا(وی مس.کاربر جدید(UUID1))
    users.بیفزا(وی مس.کاربر جدید(UUID2))
    buf := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
    تکرار srv_count:
        t := انتقال شبکه.پذیرش(l)
        اگر وارونه انتقال شبکه.معتبر(t):
            srv_log += "transport(" + t.خطا + ");"
            گذر
        پایان
        ناپایا c := وی مس.پذیرش(t، users، rf)
        اگر c.معتبر:
            srv_log += "ok(" + c.کاربر.زیررشته(0، 8) + " " + c.درخواست.نشانی.میزبان + ":" + رشته.از عدد(c.درخواست.نشانی.درگاه برگردان صحیح۶۴) + ");"
            تا درست:
                n := وی مس.خواندن(c، buf، 65536)
                اگر n کوچکتربرابر 0:
                    بشکن
                پایان
                وی مس.نوشتن(c، buf، n)
            پایان
            وی مس.بستن(c)
        وگرنه:
            srv_log += "fail(" + c.خطا + ");"
        پایان
    پایان
    حافظه.آزادسازی(buf)
    انتقال شبکه.بستن شنونده(l)
    همگام سازی.اتمام(finished)
پایان

تابع start(ss: انتقال شبکه.تنظیمات، count: صحیح):
    srv_settings = ss
    srv_count = count
    srv_log = ""
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    همگام سازی.افزودن(finished، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
پایان

تابع pattern(n: صحیح، seed: صحیح): انتقال شبکه.بایت‌ها:
    ناپایا b := انتقال شبکه.بایت‌های جدید(n + 1)
    تکرار n در i:
        انتقال شبکه.نوشتن بایت(b، (i * 11 + seed) & 255)
    پایان
    برگشت b
پایان

تابع echo(label: رشته، cs: انتقال شبکه.تنظیمات، uuid: رشته، sec: صحیح، opt: صحیح، host: رشته):
    t := انتقال شبکه.شماره گیری("127.0.0.1"، port، cs)
    اگر وارونه انتقال شبکه.معتبر(t):
        سرچاپ label، "transport failed"، t.خطا
        برگشت
    پایان
    ناپایا c := وی مس.کارخواه(t، uuid، sec، opt، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید(host، 8443))
    ناپایا good := c.معتبر
    ناپایا sent := 0
    ناپایا sizes := وکتور {} برگردان وکتور<صحیح>
    sizes.بیفزا(5)
    sizes.بیفزا(1000)
    sizes.بیفزا(40000)
    تکرار sizes.طول() در i:
        n := sizes.بگیر(i)
        ناپایا out := pattern(n، i)
        back := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)
        ناپایا got := 0
        اگر وارونه وی مس.نوشتن(c، out.نشانگر، n):
            good = نادرست
        پایان
        تا got کوچکتر n:
            r := وی مس.خواندن(c، ((back برگردان صحیح۶۴) + (got برگردان صحیح۶۴)) برگردان تهی*، n - got)
            اگر r کوچکتربرابر 0:
                good = نادرست
                بشکن
            پایان
            got += r
        پایان
        اگر got برابر n:
            bp := back برگردان طبیعی۸*
            تکرار n در k:
                اگر (bp[k] برگردان صحیح) نابرابر ((k * 11 + i) & 255):
                    good = نادرست
                    بشکن
                پایان
            پایان
        پایان
        sent += n
        حافظه.آزادسازی(back)
        انتقال شبکه.آزادسازی بایت‌ها(out)
    پایان
    sizes.آزادکن()
    وی مس.بستن(c)
    سرچاپ label، "echo ok:"، good، "bytes:"، sent
پایان

تابع raw_header(cs: انتقال شبکه.تنظیمات، uuid: رشته، ts: صحیح۶۴):
    ناپایا t := انتقال شبکه.شماره گیری("127.0.0.1"، port، cs)
    ناپایا r := وی مس.درخواست {}
    r.بردار آغازین = انتقال شبکه.از هگزا("a0a1a2a3a4a5a6a7a8a9aaabacadaeaf")
    r.کلید = انتقال شبکه.از هگزا("101112131415161718191a1b1c1d1e1f")
    r.بایت پاسخ = 9
    r.گزینه ها = 5
    r.نشانی = انتقال شبکه.نشانی جدید("example.com"، 443)
    plain := وی مس.کدگذاری درخواست(r)
    ck := وی مس.کلید فرمان(انتقال شبکه.تجزیه یو یو آی دی(uuid))
    sealed := وی مس.مهر سرآیند(ck، plain، ts، انتقال شبکه.از هگزا("01020304")، انتقال شبکه.از هگزا("0a0b0c0d0e0f1011"))
    انتقال شبکه.ارسال بایت ها(t، sealed)
    همگام سازی.خواب میلی ثانیه(100)
    انتقال شبکه.بستن(t)
پایان

تابع ریشه:
    vectors()
    request_vectors()
    chunk_vectors()

    plain := انتقال شبکه.تنظیمات {}
    start(plain، 7)
    echo("aes-128-gcm"، plain، UUID1، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، وی مس.گزینه پیش فرض(وی مس.امنیت ای ای اس۱۲۸ جی سی ام)، "example.com")
    echo("chacha20-poly1305"، plain، UUID2، وی مس.امنیت چاچا۲۰ پلی۱۳۰۵، وی مس.گزینه پیش فرض(وی مس.امنیت چاچا۲۰ پلی۱۳۰۵)، "10.1.2.3")
    echo("none"، plain، UUID1، وی مس.امنیت هیچ، وی مس.گزینه پیش فرض(وی مس.امنیت هیچ)، "2001:db8::1")
    echo("zero"، plain، UUID1، وی مس.امنیت صفر، 0، "example.org")
    echo("aes-128-gcm padded"، plain، UUID1، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، 1 | 4 | 8، "padded.test")
    echo("aes-128-gcm authenticated length"، plain، UUID2، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، 1 | 4 | 16، "authlen.test")
    echo("chacha20 authenticated length and padding"، plain، UUID1، وی مس.امنیت چاچا۲۰ پلی۱۳۰۵، 1 | 4 | 8 | 16، "both.test")
    همگام سازی.انتظار(finished)
    سرچاپ "server saw"، srv_log

    start(plain، 5)
    now := زمان.اکنون()
    echo("wrong user"، plain، "00000000-0000-4000-8000-000000000001"، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، 5، "example.com")
    raw_header(plain، UUID1، now)
    raw_header(plain، UUID1، now)
    raw_header(plain، UUID1، now - (300 برگردان صحیح۶۴))
    raw_header(plain، UUID2، now + (500 برگردان صحیح۶۴))
    همگام سازی.انتظار(finished)
    سرچاپ "server saw"، srv_log

    ناپایا ws := انتقال شبکه.تنظیمات {}
    ws.شبکه = "ws"
    ws.مسیر = "/vmess"
    start(ws، 1)
    echo("over websocket"، ws، UUID1، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، 5، "example.com")
    همگام سازی.انتظار(finished)
    سرچاپ "server saw"، srv_log
پایان
