واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی مس

پایا UUID1 := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا finished := همگام سازی.گروه انتظار جدید()
ناپایا srv_count := 1

تابع server():
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا rf := وی مس.فیلتر بازپخش جدید()
    ناپایا users := وکتور {} برگردان وکتور<وی مس.کاربر>
    users.بیفزا(وی مس.کاربر جدید(UUID1))
    buf := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
    تکرار srv_count:
        t := انتقال شبکه.پذیرش(l)
        اگر وارونه انتقال شبکه.معتبر(t): گذر پایان
        ناپایا c := وی مس.پذیرش(t، users، rf)
        اگر c.معتبر:
            تا درست:
                n := وی مس.خواندن(c، buf، 65536)
                اگر n کوچکتربرابر 0: بشکن پایان
                وی مس.نوشتن(c، buf، n)
            پایان
            وی مس.بستن(c)
        پایان
    پایان
    حافظه.آزادسازی(buf)
    انتقال شبکه.بستن شنونده(l)
    همگام سازی.اتمام(finished)
پایان

تابع stream(label: رشته، sec: صحیح، messages: صحیح):
    t := انتقال شبکه.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {})
    ناپایا c := وی مس.کارخواه(t، UUID1، sec، وی مس.گزینه پیش فرض(sec)، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("example.com"، 80))
    out := حافظه.تخصیص(16 برگردان طبیعی۶۴)
    back := حافظه.تخصیص(16 برگردان طبیعی۶۴)
    ناپایا good := c.معتبر
    ناپایا done := 0
    تا done کوچکتر messages و good:
        batch := 64
        تکرار batch در b:
            ob := out برگردان طبیعی۸*
            تکرار 16 در k:
                ob[k] = ((done + b + k) & 255) برگردان طبیعی۸
            پایان
            اگر وارونه وی مس.نوشتن(c، out، 16): good = نادرست پایان
        پایان
        تکرار batch در b:
            ناپایا got := 0
            تا got کوچکتر 16 و good:
                r := وی مس.خواندن(c، ((back برگردان صحیح۶۴) + (got برگردان صحیح۶۴)) برگردان تهی*، 16 - got)
                اگر r کوچکتربرابر 0:
                    good = نادرست
                وگرنه:
                    got += r
                پایان
            پایان
            bp := back برگردان طبیعی۸*
            تکرار 16 در k:
                اگر (bp[k] برگردان صحیح) نابرابر ((done + b + k) & 255): good = نادرست پایان
            پایان
        پایان
        done += batch
    پایان
    وی مس.بستن(c)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(back)
    سرچاپ label، "echoed"، done، "chunks each way past the 16 bit counter:"، good
پایان

تابع ریشه:
    srv_count = 2
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    همگام سازی.افزودن(finished، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
    stream("aes-128-gcm"، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، 70016)
    stream("chacha20-poly1305"، وی مس.امنیت چاچا۲۰ پلی۱۳۰۵، 70016)
    همگام سازی.انتظار(finished)
پایان
