واردسازی کدگذاری
واردسازی شبکه.وی مس
واردسازی شبکه.تونل

تابع ریشه:
    js := "{\"v\":\"2\",\"ps\":\"my node\",\"add\":\"example.com\",\"port\":\"443\",\"id\":\"b831381d-6324-4d53-ad4f-8cda48b30811\",\"aid\":\"0\",\"scy\":\"chacha20-poly1305\",\"net\":\"ws\",\"type\":\"none\",\"host\":\"cdn.example.com\",\"path\":\"/ray?ed=2048\",\"tls\":\"tls\",\"sni\":\"front.example.com\",\"alpn\":\"h2,http/1.1\",\"fp\":\"chrome\"}"
    link := "vmess://" + کدگذاری.کدگذاری پایه۶۴(js)
    l := وی مس.تجزیه پیوند(link)
    سرچاپ "ok:"، l.معتبر، l.خطا
    سرچاپ l.برچسب، l.میزبان، l.درگاه، l.شناسه، l.امنیت، l.شبکه، l.سربرگ میزبان، l.مسیر، l.تی ال اس، l.نام سرور، l.الپن، l.اثر انگشت
    s := وی مس.تنظیمات پیوند(l)
    سرچاپ "settings:"، s.شبکه، s.مسیر، s.داده زودهنگام، s.تی ال اس، s.نام سرور، s.سربرگ میزبان
    سرچاپ "security:"، وی مس.امنیت از نام(l.امنیت)، وی مس.امنیت از نام("auto")، وی مس.امنیت از نام("zero")، وی مس.امنیت از نام("rc4")، وی مس.نام امنیت(وی مس.امنیت هیچ)
    out := وی مس.قالب پیوند(l)
    again := وی مس.تجزیه پیوند(out)
    سرچاپ "round trip:"، again.معتبر، again.میزبان برابر l.میزبان، again.شناسه برابر l.شناسه، again.مسیر برابر l.مسیر، again.نام سرور برابر l.نام سرور، again.برچسب برابر l.برچسب
    n := تونل.تجزیه لینک(out)
    سرچاپ "tunnel agrees:"، n.معتبر، n.میزبان برابر l.میزبان، n.درگاه برابر l.درگاه، n.شناسه برابر l.شناسه، n.شبکه برابر l.شبکه
    g := وی مس.تجزیه پیوند("vmess://" + کدگذاری.کدگذاری پایه۶۴("{\"add\":\"h.example.com\",\"port\":8443,\"id\":\"b831381d-6324-4d53-ad4f-8cda48b30811\",\"net\":\"grpc\",\"path\":\"svc\",\"tls\":\"tls\"}"))
    gs := وی مس.تنظیمات پیوند(g)
    سرچاپ "grpc:"، g.معتبر، g.درگاه، gs.شبکه، gs.نام سرویس
    bad := وی مس.تجزیه پیوند("vmess://" + کدگذاری.کدگذاری پایه۶۴("{\"add\":\"\",\"port\":0,\"id\":\"x\"}"))
    سرچاپ "bad:"، bad.معتبر، bad.خطا
    junk := وی مس.تجزیه پیوند("vmess://!!!")
    سرچاپ "junk:"، junk.معتبر، junk.خطا
    other := وی مس.تجزیه پیوند("vless://x")
    سرچاپ "other:"، other.معتبر، other.خطا
    ناپایا dflt := وی مس.پیوند {}
    dflt.میزبان = "a.example.com"
    dflt.شناسه = "b831381d-6324-4d53-ad4f-8cda48b30811"
    d := وی مس.تجزیه پیوند(وی مس.قالب پیوند(dflt))
    سرچاپ "defaults:"، d.معتبر، d.درگاه، d.امنیت، d.شبکه
پایان
