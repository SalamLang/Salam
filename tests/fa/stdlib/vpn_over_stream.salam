واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی لس
واردسازی شبکه.وی مس

پایا UUID := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا mode := 0
ناپایا pipe := تونل.لوله جدید()
ناپایا done := همگام سازی.گروه انتظار جدید()
ناپایا seen := ""

تابع echo_loop(s: پویا تونل.جریان):
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    تا درست:
        n := s.خواندن بایت(buf، 4096)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        s.نوشتن بایت(buf، n)
    پایان
    حافظه.آزادسازی(buf)
    s.بستن()
پایان

تابع server():
    srv_end := تونل.سر دوم لوله(pipe)
    ناپایا rf := وی مس.فیلتر بازپخش جدید()
    ناپایا vl := وکتور {} برگردان وکتور<وی لس.کاربر>
    vl.بیفزا(وی لس.کاربر جدید(UUID، ""))
    ناپایا vm := وکتور {} برگردان وکتور<وی مس.کاربر>
    vm.بیفزا(وی مس.کاربر جدید(UUID))
    اگر mode برابر 0:
        c := وی لس.پذیرش روی جریان(srv_end، vl)
        seen = "vless " + c.درخواست.نشانی.میزبان
        echo_loop(وی لس.به عنوان جریان(c))
    وگرنه mode برابر 1:
        c := وی مس.پذیرش روی جریان(srv_end، vm، rf)
        seen = "vmess " + c.درخواست.نشانی.میزبان
        echo_loop(وی مس.به عنوان جریان(c))
    وگرنه:
        outer := وی لس.پذیرش روی جریان(srv_end، vl)
        inner := وی مس.پذیرش روی جریان(وی لس.به عنوان جریان(outer)، vm، rf)
        seen = "vless then vmess " + outer.درخواست.نشانی.میزبان + " " + inner.درخواست.نشانی.میزبان
        echo_loop(وی مس.به عنوان جریان(inner))
    پایان
    همگام سازی.اتمام(done)
پایان

تابع talk(s: پویا تونل.جریان، label: رشته):
    ok := s.نوشتن("ping through the " + label + " tunnel") بزرگتر 0
    buf := حافظه.تخصیص صفرشده(256 برگردان طبیعی۶۴)
    n := s.خواندن بایت(buf، 256)
    ناپایا got := ""
    اگر n بزرگتر 0:
        bp := buf برگردان طبیعی۸*
        bp[n] = 0 برگردان طبیعی۸
        got = buf برگردان رشته
    پایان
    سرچاپ label، ok، got
    حافظه.آزادسازی(buf)
    s.بستن()
پایان

تابع run(m: صحیح):
    mode = m
    pipe = تونل.لوله جدید()
    همگام سازی.افزودن(done، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(server)
    cli := تونل.سر اول لوله(pipe)
    اگر m برابر 0:
        c := وی لس.اتصال روی جریان(cli، UUID، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("one.example"، 443))
        talk(وی لس.به عنوان جریان(c)، "vless")
    وگرنه m برابر 1:
        c := وی مس.اتصال روی جریان(cli، UUID، وی مس.امنیت چاچا۲۰ پلی۱۳۰۵، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("two.example"، 443))
        talk(وی مس.به عنوان جریان(c)، "vmess")
    وگرنه:
        outer := وی لس.اتصال روی جریان(cli، UUID، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("hop.example"، 443))
        inner := وی مس.اتصال روی جریان(وی لس.به عنوان جریان(outer)، UUID، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("final.example"، 443))
        talk(وی مس.به عنوان جریان(inner)، "vless+vmess")
    پایان
    همگام سازی.انتظار(done)
    سرچاپ "server saw"، seen
پایان

تابع ریشه:
    run(0)
    run(1)
    run(2)
پایان
