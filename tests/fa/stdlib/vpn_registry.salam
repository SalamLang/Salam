بسته ریشه

واردسازی شبکه.تی سی پی
واردسازی شبکه.transport
واردسازی شبکه.tunnel
واردسازی شبکه.vpn

ناپایا failures := 0

ساختار EchoProto:
    همگانی unused: صحیح = 0

    همگانی تابع Name(): رشته:
        برگشت "hello"
    پایان

    همگانی تابع Handshake(s: پویا tunnel.Stream): tunnel.Session:
        line := tunnel.ReadUntil(s، "\n"، 100)
        اگر line نابرابر "HELLO\n": برگشت tunnel.Session { error = "bad hello" } پایان
        برگشت tunnel.Session { ok = درست، target = tunnel.NewAddr("127.0.0.1"، 9)، protocol = "hello" }
    پایان

    همگانی تابع Reply(s: پویا tunnel.Stream، _sess: tunnel.Session، ok: منطقی):
        اگر ok: s.Write("WELCOME\n") وگرنه:
            s.Write("NO\n") پایان
    پایان
پایان

ساختار HoldHandler:
    همگانی unused: صحیح = 0

    همگانی تابع Handle(s: پویا tunnel.Stream، _sess: tunnel.Session):
        s.Write("WELCOME\n")
        s.Close()
    پایان
پایان

تابع expect(label: رشته، ok: منطقی):
    اگر وارونه ok:
        سرچاپ "FAIL"، label
        failures++
    پایان
پایان

تابع registry():
    vpn.Register()
    هر p در ["vless"، "vmess"، "trojan"، "shadowsocks"، "ss"، "socks"، "http"، "freedom"، "block"]:
        expect("outbound " + p، tunnel.HasOutbound(p))
    پایان
    هر p در ["mixed"، "socks"، "http"، "trojan"، "vless"، "vmess"، "shadowsocks"]:
        expect("inbound " + p، tunnel.HasInbound(p))
    پایان
    سرچاپ "outbound names:"، tunnel.CreateOutbound(tunnel.OutboundConfig { protocol = "freedom" }).Name()، tunnel.CreateOutbound(tunnel.OutboundConfig { protocol = "nonsense" }).Name()
    node := tunnel.Node { protocol = "trojan"، host = "example.org"، port = 443، password = "pw"، network = "tcp"، tls = درست، valid = درست }
    سرچاپ "dialer:"، vpn.DialerFromNode(node).Name()، vpn.DialerFromNode(tunnel.Node { protocol = "nope" }).Name()
    سرچاپ "vless dialer:"، vpn.DialerFromNode(tunnel.Node { protocol = "vless" }).Name()، vpn.DialerFromNode(tunnel.Node { protocol = "ss" }).Name()
پایان

تابع settings():
    s := vpn.StreamSettings(`{"network":"ws","security":"tls","tlsSettings":{"serverName":"a.test","allowInsecure":true},"wsSettings":{"path":"/x","headers":{"Host":"h.test"}}}`)
    سرچاپ "ws:"، s.network، s.tls، s.sni، s.allow_insecure، s.path، s.host
    h := vpn.StreamSettings(`{"network":"httpupgrade","httpupgradeSettings":{"path":"/up"}}`)
    سرچاپ "httpupgrade:"، h.network، h.tls، h.path
    f := vpn.StreamSettings(`{"security":"tls","fragment":{"packets":"tlshello"}}`)
    سرچاپ "fragment:"، f.fragment، f.fragment_min بزرگتر 0
    n := vpn.NodeSettings(tunnel.Node { network = "ws"، tls = درست، sni = "n.test"، path = "/n" })
    سرچاپ "node:"، n.network، n.sni، n.path، n.fragment
    vpn.RegisterWith(vpn.Options { fragment = درست })
    nf := vpn.NodeSettings(tunnel.Node { network = "tcp"، tls = درست، sni = "n.test" })
    سرچاپ "node fragment:"، nf.fragment
    vpn.Register()
پایان

تابع addrs():
    t := vpn.ToTunnelAddr(transport.NewAddr("example.org"، 443))
    سرچاپ "to tunnel:"، t.String()، t.kind
    b := vpn.ToTransportAddr(tunnel.NewAddr("::1"، 53))
    سرچاپ "to transport:"، b.host، b.port
پایان

تابع acceptor():
    srv := tunnel.ListenLocal(0)
    سرچاپ "listening:"، srv.Ok()، srv.Port() بزرگتر 0
    tunnel.StartAccepting(srv، EchoProto {}، HoldHandler {})
    c := tunnel.DialTcp("127.0.0.1"، srv.Port()، 3000)
    tunnel.WriteAll(c، "HELLO\n")
    سرچاپ "reply:"، tunnel.ReadUntil(c، "\n"، 100)
    c.Close()
    bad := tunnel.DialTcp("127.0.0.1"، srv.Port()، 3000)
    tunnel.WriteAll(bad، "BYE\n")
    سرچاپ "rejected:"، bad.Read(10).طول() برابر 0
    bad.Close()
    srv.Stop()
    again := تی سی پی.شماره گیری("127.0.0.1"، srv.Port())
    سرچاپ "after stop:"، تی سی پی.اتصال معتبر(again)
    all := tunnel.ListenTcpOn("0.0.0.0"، 0)
    سرچاپ "explicit all-interfaces bind:"، all.Ok()
    all.Stop()
پایان

تابع runner():
    cfg := tunnel.ParseConfig(`{"inbounds":[{"tag":"in","port":0,"protocol":"mixed"}],"outbounds":[{"tag":"direct","protocol":"freedom"}]}`)
    stats := tunnel.NewStats()
    ls := vpn.StartAll(cfg، stats)
    سرچاپ "runner inbounds:"، ls.طول()، vpn.Ok(ls[0])، ls[0].port بزرگتر 0، ls[0].tag
    سرچاپ "summary:"، vpn.Summary(stats)
    vpn.Stop(ls[0])
    bad := tunnel.ParseConfig(`{"inbounds":[{"tag":"x","port":0,"protocol":"vless","settings":{"clients":[]},"streamSettings":{"security":"tls","tlsSettings":{"certificates":[{"certificateFile":"nope.pem","keyFile":"nope.key"}]}}}],"outbounds":[]}`)
    lb := vpn.StartAll(bad، stats)
    سرچاپ "bad certificate listens:"، vpn.Ok(lb[0])
پایان

تابع ریشه:
    registry()
    settings()
    addrs()
    acceptor()
    runner()
    سرچاپ "failures:"، failures
پایان
