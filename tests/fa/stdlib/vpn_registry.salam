بسته ریشه

واردسازی شبکه.تی سی پی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

ناپایا failures := 0

ساختار EchoProto:
    همگانی unused: صحیح = 0

    همگانی تابع Name(): رشته:
        برگشت "hello"
    پایان

    همگانی تابع Handshake(s: پویا تونل.جریان): تونل.نشست:
        line := تونل.خواندن با جداکننده(s، "\n"، 100)
        اگر line نابرابر "HELLO\n": برگشت تونل.نشست { خطا = "bad hello" } پایان
        برگشت تونل.نشست { موفق = درست، مقصد = تونل.نشانی جدید("127.0.0.1"، 9)، پروتکل = "hello" }
    پایان

    همگانی تابع Reply(s: پویا تونل.جریان، _sess: تونل.نشست، ok: منطقی):
        اگر ok: s.نوشتن("WELCOME\n") وگرنه:
            s.نوشتن("NO\n") پایان
    پایان
پایان

ساختار HoldHandler:
    همگانی unused: صحیح = 0

    همگانی تابع Handle(s: پویا تونل.جریان، _sess: تونل.نشست):
        s.نوشتن("WELCOME\n")
        s.بستن()
    پایان
پایان

تابع expect(label: رشته، ok: منطقی):
    اگر وارونه ok:
        سرچاپ "FAIL"، label
        failures++
    پایان
پایان

تابع registry():
    وی‌پی‌ان.ثبت()
    هر p در ["vless"، "vmess"، "trojan"، "shadowsocks"، "ss"، "socks"، "http"، "freedom"، "block"]:
        expect("outbound " + p، تونل.خروجی ثبت شده(p))
    پایان
    هر p در ["mixed"، "socks"، "http"، "trojan"، "vless"، "vmess"، "shadowsocks"]:
        expect("inbound " + p، تونل.درون‌سو ثبت شده(p))
    پایان
    سرچاپ "outbound names:"، تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = "freedom" }).نام()، تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = "nonsense" }).نام()
    node := تونل.گره { پروتکل = "trojan"، میزبان = "example.org"، درگاه = 443، گذرواژه = "pw"، شبکه = "tcp"، تی ال اس = درست، معتبر = درست }
    سرچاپ "dialer:"، وی‌پی‌ان.شماره‌گیر از گره(node).نام()، وی‌پی‌ان.شماره‌گیر از گره(تونل.گره { پروتکل = "nope" }).نام()
    سرچاپ "vless dialer:"، وی‌پی‌ان.شماره‌گیر از گره(تونل.گره { پروتکل = "vless" }).نام()، وی‌پی‌ان.شماره‌گیر از گره(تونل.گره { پروتکل = "ss" }).نام()
پایان

تابع settings():
    s := وی‌پی‌ان.تنظیمات جریان(`{"network":"ws","security":"tls","tlsSettings":{"serverName":"a.test","allowInsecure":true},"wsSettings":{"path":"/x","headers":{"Host":"h.test"}}}`)
    سرچاپ "ws:"، s.شبکه، s.تی ال اس، s.نام سرور، s.اجازه ناامن، s.مسیر، s.سربرگ میزبان
    h := وی‌پی‌ان.تنظیمات جریان(`{"network":"httpupgrade","httpupgradeSettings":{"path":"/up"}}`)
    سرچاپ "httpupgrade:"، h.شبکه، h.تی ال اس، h.مسیر
    f := وی‌پی‌ان.تنظیمات جریان(`{"security":"tls","fragment":{"packets":"tlshello"}}`)
    سرچاپ "fragment:"، f.تکه تکه کردن، f.کمینه تکه بزرگتر 0
    n := وی‌پی‌ان.تنظیمات گره(تونل.گره { شبکه = "ws"، تی ال اس = درست، نام سرور = "n.test"، مسیر = "/n" })
    سرچاپ "node:"، n.شبکه، n.نام سرور، n.مسیر، n.تکه تکه کردن
    وی‌پی‌ان.ثبت با گزینه‌ها(وی‌پی‌ان.گزینه‌ها { تکه‌تکه کردن = درست })
    nf := وی‌پی‌ان.تنظیمات گره(تونل.گره { شبکه = "tcp"، تی ال اس = درست، نام سرور = "n.test" })
    سرچاپ "node fragment:"، nf.تکه تکه کردن
    وی‌پی‌ان.ثبت()
پایان

تابع addrs():
    t := وی‌پی‌ان.نشانی تونل از انتقال(انتقال شبکه.نشانی جدید("example.org"، 443))
    سرچاپ "to tunnel:"، t.متن()، t.نوع
    b := وی‌پی‌ان.نشانی انتقال از تونل(تونل.نشانی جدید("::1"، 53))
    سرچاپ "to transport:"، b.میزبان، b.درگاه
پایان

تابع acceptor():
    srv := تونل.شنود محلی(0)
    سرچاپ "listening:"، srv.معتبر()، srv.درگاه() بزرگتر 0
    تونل.شروع پذیرش(srv، EchoProto {}، HoldHandler {})
    c := تونل.اتصال تی سی پی("127.0.0.1"، srv.درگاه()، 3000)
    تونل.نوشتن همه(c، "HELLO\n")
    سرچاپ "reply:"، تونل.خواندن با جداکننده(c، "\n"، 100)
    c.بستن()
    bad := تونل.اتصال تی سی پی("127.0.0.1"، srv.درگاه()، 3000)
    تونل.نوشتن همه(bad، "BYE\n")
    سرچاپ "rejected:"، bad.خواندن(10).طول() برابر 0
    bad.بستن()
    srv.توقف()
    again := تی سی پی.شماره گیری("127.0.0.1"، srv.درگاه())
    سرچاپ "after stop:"، تی سی پی.اتصال معتبر(again)
    all := تونل.شنود تی سی پی روی نشانی("0.0.0.0"، 0)
    سرچاپ "explicit all-interfaces bind:"، all.معتبر()
    all.توقف()
پایان

تابع runner():
    cfg := تونل.تجزیه پیکربندی(`{"inbounds":[{"tag":"in","port":0,"protocol":"mixed"}],"outbounds":[{"tag":"direct","protocol":"freedom"}]}`)
    stats := تونل.آمار جدید()
    ls := وی‌پی‌ان.شروع همه(cfg، stats)
    سرچاپ "runner inbounds:"، ls.طول()، وی‌پی‌ان.معتبر(ls[0])، ls[0].درگاه بزرگتر 0، ls[0].برچسب
    سرچاپ "summary:"، وی‌پی‌ان.خلاصه(stats)
    وی‌پی‌ان.توقف(ls[0])
    bad := تونل.تجزیه پیکربندی(`{"inbounds":[{"tag":"x","port":0,"protocol":"vless","settings":{"clients":[]},"streamSettings":{"security":"tls","tlsSettings":{"certificates":[{"certificateFile":"nope.pem","keyFile":"nope.key"}]}}}],"outbounds":[]}`)
    lb := وی‌پی‌ان.شروع همه(bad، stats)
    سرچاپ "bad certificate listens:"، وی‌پی‌ان.معتبر(lb[0])
پایان

تابع ریشه:
    registry()
    settings()
    addrs()
    acceptor()
    runner()
    سرچاپ "failures:"، failures
پایان
