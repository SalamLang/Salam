واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.تی سی پی
واردسازی شبکه.داخلی.سوکت خام
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

پایا PUB := "IH8tyHx_SyHSCyaQgNTOvHYefAehmhpbMgkwFeAPnXY"
پایا PRIV := "QI3DpbA326sqI7QAAz13iSj6Jk9Q8UUvgkjlKZu2u2I"

ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا port := 0
ناپایا srv_settings := انتقال شبکه.تنظیمات {}

تابع settings_checks():
    g := وی‌پی‌ان.تنظیمات جریان(`{"network":"grpc","security":"tls","tlsSettings":{"serverName":"g.test"},"grpcSettings":{"serviceName":"svc/x","multiMode":true}}`)
    سرچاپ "grpc:"، g.شبکه، g.نام سرویس، g.حالت جی آر پی سی، g.تی ال اس، g.نام سرور
    r := وی‌پی‌ان.تنظیمات جریان(`{"network":"tcp","security":"reality","realitySettings":{"serverName":"front.test","publicKey":"pk","shortId":"ab12","spiderX":"/","fingerprint":"firefox","privateKey":"priv","dest":"dest.test:443","serverNames":["front.test","b.test"],"shortIds":["ab12","cd"]}}`)
    سرچاپ "reality client:"، r.امنیت، r.تی ال اس، r.ریلیتی.نام سرور، r.ریلیتی.کلید عمومی، r.ریلیتی.شناسه کوتاه، r.ریلیتی.مسیر عنکبوتی، r.ریلیتی.اثر انگشت
    سرچاپ "reality server:"، r.ریلیتی کارساز.کلید خصوصی، r.ریلیتی کارساز.مقصد، r.ریلیتی کارساز.نام های سرور، r.ریلیتی کارساز.شناسه های کوتاه
    f := وی‌پی‌ان.تنظیمات جریان(`{"security":"tls","fragment":{"mode":"tls","sni":"true","writes":2,"min":3,"max":9,"delay":7},"timeouts":{"read":1500,"write":2500}}`)
    سرچاپ "fragment:"، f.تکه تکه کردن، f.حالت تکه تکه کردن، f.برش نام سرور، f.شمار نوشتن های تکه شده، f.کمینه تکه، f.بیشینه تکه، f.تاخیر تکه میلی ثانیه، f.مهلت بی کاری خواندن، f.مهلت بی کاری نوشتن
    وی‌پی‌ان.ثبت با گزینه‌ها(وی‌پی‌ان.گزینه‌ها { تکه‌تکه کردن = درست، حالت تکه تکه کردن = "both"، برش نام سرور = درست، شمار نوشتن های تکه شده = 3، مهلت بی کاری خواندن = 900، مهلت بی کاری نوشتن = 800 })
    n := وی‌پی‌ان.تنظیمات گره(تونل.گره { شبکه = "tcp"، امنیت = "reality"، تی ال اس = درست، نام سرور = "n.test"، کلید عمومی = PUB، شناسه کوتاه = "abcd"، مسیر عنکبوتی = "/s"، اثر انگشت = "chrome" })
    سرچاپ "node reality:"، n.امنیت، n.تی ال اس، n.ریلیتی.نام سرور، n.ریلیتی.شناسه کوتاه، n.ریلیتی.مسیر عنکبوتی، n.تکه تکه کردن، n.حالت تکه تکه کردن، n.برش نام سرور، n.شمار نوشتن های تکه شده، n.مهلت بی کاری خواندن، n.مهلت بی کاری نوشتن
    ng := وی‌پی‌ان.تنظیمات گره(تونل.گره { شبکه = "grpc"، نام سرویس = "gs"، تی ال اس = درست، نام سرور = "g.test" })
    سرچاپ "node grpc:"، ng.شبکه، ng.نام سرویس، ng.حالت تکه تکه کردن
    وی‌پی‌ان.ثبت()
پایان

تابع serve_one():
    sock := سوکت خام.شنود روی("127.0.0.1"، 0، سوکت خام.سوکت جریانی)
    ناپایا bound := تی سی پی.سرور { توصیفگر = sock.fd }
    bound.درگاه = سوکت خام.درگاه محلی(sock)
    l := انتقال شبکه.شنونده از سرور(bound، srv_settings)
    port = انتقال شبکه.درگاه شنونده(l)
    acc := وی‌پی‌ان.پذیرنده انتقال { شنونده = l، تنظیمات = srv_settings }
    همگام سازی.اتمام(ready)
    p := acc.پذیرش()
    اگر p.معتبر():
        s := p.گشودن()
        buf := حافظه.تخصیص(64 برگردان طبیعی۶۴)
        n := s.خواندن بایت(buf، 64)
        s.نوشتن بایت(buf، n)
        حافظه.آزادسازی(buf)
        s.بستن()
    پایان
    acc.بستن()
پایان

تابع through_acceptor(label: رشته، cs: انتقال شبکه.تنظیمات، ss: انتقال شبکه.تنظیمات):
    srv_settings = ss
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(serve_one)
    همگام سازی.انتظار(ready)
    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، port، cs)
    ناپایا good := انتقال شبکه.معتبر(c)
    اگر good:
        انتقال شبکه.نوشتن(c، "via acceptor" برگردان تهی*، 12)
        back := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
        good = انتقال شبکه.خواندن کامل(c، back، 12)
        حافظه.آزادسازی(back)
        انتقال شبکه.بستن(c)
    پایان
    نخ‌پیوند(t)
    سرچاپ label، "through the vpn acceptor:"، good
پایان

تابع ریشه:
    settings_checks()
    ناپایا gs := انتقال شبکه.تنظیمات {}
    gs.شبکه = "grpc"
    gs.نام سرویس = "acc"
    through_acceptor("grpc"، gs، gs)
    ناپایا rs := انتقال شبکه.تنظیمات {}
    rs.امنیت = "reality"
    rs.ریلیتی کارساز.کلید خصوصی = PRIV
    rs.ریلیتی کارساز.نام های سرور = "front.example.com"
    rs.ریلیتی کارساز.شناسه های کوتاه = "abcd1234"
    rs.ریلیتی کارساز.مقصد = "127.0.0.1:1"
    ناپایا rc := انتقال شبکه.تنظیمات {}
    rc.امنیت = "reality"
    rc.نام سرور = "front.example.com"
    rc.ریلیتی.کلید عمومی = PUB
    rc.ریلیتی.شناسه کوتاه = "abcd1234"
    through_acceptor("reality"، rc، rs)
پایان
