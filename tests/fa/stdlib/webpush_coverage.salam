بسته ریشه

واردسازی اعلان وب

تابع check(label: رشته، ok: منطقی):
    چاپ label
    چاپ ": "
    اگر ok:
        سرچاپ "ok"
    وگرنه:
        سرچاپ "FAIL"
    پایان
پایان

تابع rebuilt_keys():
    keys := اعلان وب.ساخت کلیدها()
    again := اعلان وب.کلیدها از(keys.کلید عمومی، keys.کلید خصوصی)
    check("generated keys"، keys.معتبر)
    check("keys rebuilt from strings"، again.معتبر)
    check("public key kept"، again.کلید عمومی برابر keys.کلید عمومی)
    check("private key kept"، again.کلید خصوصی برابر keys.کلید خصوصی)
    check("empty public key rejected"، وارونه اعلان وب.کلیدها از(""، keys.کلید خصوصی).معتبر)
    check("empty private key rejected"، وارونه اعلان وب.کلیدها از(keys.کلید عمومی، "").معتبر)
    check("rejected keys sign nothing"، اعلان وب.سرصفحه واپید(اعلان وب.کلیدها از(""، "")، "https://push.example.net"، "mailto:ops@example.com") برابر "")
پایان

تابع vapid_now():
    keys := اعلان وب.کلیدها از("BNp3Ldtz9dZ2TVhsqzzVV0Gv8bP1YZ6u9G0cNVmE0n1AgM2d5B5pE6mB7l2cJ0p1m1v3b3cqf6HvQZ4q1y0QxXQ"، "")
    check("a missing private key has no header"، اعلان وب.سرصفحه واپید(keys، "https://push.example.net"، "mailto:ops@example.com") برابر "")
    real := اعلان وب.ساخت کلیدها()
    mine := اعلان وب.کلیدها از(real.کلید عمومی، real.کلید خصوصی)
    header := اعلان وب.سرصفحه واپید(mine، "https://push.example.net"، "mailto:ops@example.com")
    check("header starts with vapid"، header.بیاب("vapid t=") برابر 0)
    check("header carries the public key"، header.بیاب(", k=" + real.کلید عمومی) بزرگتر 0)
    check("header has a three part token"، header.بیاب(".") بزرگتر 0)
    check("no audience gives no header"، اعلان وب.سرصفحه واپید(mine، ""، "mailto:ops@example.com") برابر "")
    check("no subject gives no header"، اعلان وب.سرصفحه واپید(mine، "https://push.example.net"، "") برابر "")
پایان

تابع ریشه:
    rebuilt_keys()
    vapid_now()
پایان
