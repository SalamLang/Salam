بسته ریشه

واردسازی اعلان وب

تابع بررسی(برچسب: رشته، سالم: منطقی):
    چاپ برچسب
    چاپ ": "
    اگر سالم:
        سرچاپ "ok"
    وگرنه:
        سرچاپ "FAIL"
    پایان
پایان

تابع بازسازی کلیدها():
    کلیدها := اعلان وب.ساخت کلیدها()
    دوباره := اعلان وب.کلیدها از(کلیدها.کلید عمومی، کلیدها.کلید خصوصی)
    بررسی("generated keys"، کلیدها.معتبر)
    بررسی("keys rebuilt from strings"، دوباره.معتبر)
    بررسی("public key kept"، دوباره.کلید عمومی برابر کلیدها.کلید عمومی)
    بررسی("private key kept"، دوباره.کلید خصوصی برابر کلیدها.کلید خصوصی)
    بررسی("empty public key rejected"، وارونه اعلان وب.کلیدها از(""، کلیدها.کلید خصوصی).معتبر)
    بررسی("empty private key rejected"، وارونه اعلان وب.کلیدها از(کلیدها.کلید عمومی، "").معتبر)
    بررسی("rejected keys sign nothing"، اعلان وب.سرصفحه واپید(اعلان وب.کلیدها از(""، "")، "https://push.example.net"، "mailto:ops@example.com") برابر "")
پایان

تابع سرصفحه واپید فوری():
    کلیدها := اعلان وب.کلیدها از("BNp3Ldtz9dZ2TVhsqzzVV0Gv8bP1YZ6u9G0cNVmE0n1AgM2d5B5pE6mB7l2cJ0p1m1v3b3cqf6HvQZ4q1y0QxXQ"، "")
    بررسی("a missing private key has no header"، اعلان وب.سرصفحه واپید(کلیدها، "https://push.example.net"، "mailto:ops@example.com") برابر "")
    اصلی := اعلان وب.ساخت کلیدها()
    من := اعلان وب.کلیدها از(اصلی.کلید عمومی، اصلی.کلید خصوصی)
    سرصفحه := اعلان وب.سرصفحه واپید(من، "https://push.example.net"، "mailto:ops@example.com")
    بررسی("header starts with vapid"، سرصفحه.بیاب("vapid t=") برابر 0)
    بررسی("header carries the public key"، سرصفحه.بیاب(", k=" + اصلی.کلید عمومی) بزرگتر 0)
    بررسی("header has a three part token"، سرصفحه.بیاب(".") بزرگتر 0)
    بررسی("no audience gives no header"، اعلان وب.سرصفحه واپید(من، ""، "mailto:ops@example.com") برابر "")
    بررسی("no subject gives no header"، اعلان وب.سرصفحه واپید(من، "https://push.example.net"، "") برابر "")
پایان

تابع ریشه:
    بازسازی کلیدها()
    سرصفحه واپید فوری()
پایان
