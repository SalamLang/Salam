// زبان: فارسی
واردسازی تزریق
واردسازی رشته

ساختار Cfg:
    همگانی dsn: رشته = ""
    همگانی n: صحیح = 0
پایان

تابع level_name(i: صحیح): رشته:
    برگشت "L" + رشته.از عدد(i)
پایان

تابع ریشه:
    c := تزریق.ساخت()
    تزریق.مقدار(c، "Cfg"، Cfg { dsn = "db://x"، n = 5 })
    ناپایا cfg := Cfg {}
    سرچاپ تزریق.گرفتن(c، "Cfg"، cfg)، cfg.dsn، cfg.n
    سرچاپ تزریق.گرفتن(c، "Nope"، cfg)، تزریق.خطا(c)
    سرچاپ تزریق.تعداد(c)
    تزریق.بستن(c)

    deep := تزریق.ساخت()
    تزریق.مقدار(deep، "L0"، 1)
    تکرار 1 تا 200 در i:
        prev := level_name(i - 1)
        تزریق.فراهم کردن(deep، level_name(i)، prev، 0، (cx: تزریق.ظرف):
            ناپایا v := 0
            _ok := تزریق.گرفتن(cx، prev، v)
            برگشت v + 1
        پایان)
    پایان
    سرچاپ تزریق.ساختن گراف(deep) برابر "" ? "sound" : "broken"
    ناپایا top := 0
    سرچاپ تزریق.گرفتن(deep، "L200"، top)، top
    built := تزریق.ساخته شده(deep)
    سرچاپ built.طول()، built.بگیر(0)، built.بگیر(200)
    built.آزادکن()
    تزریق.بستن(deep)

    loop := تزریق.ساخت()
    تزریق.فراهم کردن(loop، "X"، ""، 0، (cx: تزریق.ظرف):
        ناپایا v := 0
        _ok := تزریق.گرفتن(cx، "X"، v)
        برگشت v
    پایان)
    ناپایا x := 0
    سرچاپ تزریق.گرفتن(loop، "X"، x)، تزریق.خطا(loop)
    تزریق.بستن(loop)

    self := تزریق.ساخت()
    تزریق.فراهم کردن(self، "S"، "S"، 0، (_c: تزریق.ظرف): برگشت 1 پایان)
    سرچاپ تزریق.ساختن گراف(self)
    تزریق.بستن(self)
پایان
