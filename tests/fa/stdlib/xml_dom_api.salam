بسته ریشه

واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه:
    src := "<lib id=\"1\" kind=\"a\"><book n=\"x\">Salam<i>bold</i> tail</book><book n=\"y\"/><!--c--></lib>"
    ناپایا opts := اکس‌ام‌ال.گزینه‌های پیش فرض()
    opts.نگه‌داشتن توضیح‌ها = نادرست
    ناپایا err := اکس‌ام‌ال.بدون خطا()
    ناپایا d := اکس‌ام‌ال.تجزیه سفارشی(src، opts، err)
    سرچاپ err.موفق، اکس‌ام‌ال.شمار گره‌ها(d)
    root := اکس‌ام‌ال.عنصر ریشه(d)
    سرچاپ اکس‌ام‌ال.عنصر است(d، root)، اکس‌ام‌ال.عنصر است(d، اکس‌ام‌ال.گره سند(d))
    ناپایا kids := اکس‌ام‌ال.گره‌های فرزند(d، root)
    سرچاپ kids.شناسه‌ها.طول()
    اکس‌ام‌ال.آزادسازی فهرست(kids)
    ناپایا els := اکس‌ام‌ال.عنصرها(d، root)
    سرچاپ els.شناسه‌ها.طول()
    first := els.شناسه‌ها.بگیر(0)
    سرچاپ اکس‌ام‌ال.عنصر است(d، first)، اکس‌ام‌ال.نام گره(d، first)، اکس‌ام‌ال.نام گره(d، root)
    سرچاپ اکس‌ام‌ال.متن مستقیم(d، first)
    سرچاپ اکس‌ام‌ال.شمار ویژگی‌ها(d، root)، اکس‌ام‌ال.شمار ویژگی‌ها(d، first)
    a := اکس‌ام‌ال.ویژگی شماره(d، root، 1)
    سرچاپ a.نام، a.مقدار
    ناپایا up := اکس‌ام‌ال.نیاکان(d، اکس‌ام‌ال.نخستین عنصر با نام(d، first، "i"))
    سرچاپ up.شناسه‌ها.طول()
    اکس‌ام‌ال.آزادسازی فهرست(up)
    اکس‌ام‌ال.آزادسازی فهرست(els)

    ناپایا keepc := اکس‌ام‌ال.تجزیه سفارشی(src، اکس‌ام‌ال.گزینه‌های پیش فرض()، err)
    سرچاپ اکس‌ام‌ال.شمار گره‌ها(keepc) - اکس‌ام‌ال.شمار گره‌ها(d)
    اکس‌ام‌ال.آزادسازی(keepc)

    ناپایا bad := اکس‌ام‌ال.تجزیه سفارشی("<a><b></a>"، opts، err)
    سرچاپ err.موفق
    اکس‌ام‌ال.آزادسازی(bad)

    ناپایا nest := اکس‌ام‌ال.تجزیه("<r><a><b>t</b></a></r>"، err)
    سرچاپ اکس‌ام‌ال.نوشتن گره با تورفتگی(nest، اکس‌ام‌ال.نخستین عنصر با نام(nest، اکس‌ام‌ال.عنصر ریشه(nest)، "a")، "  ")
    ناپایا wopts := اکس‌ام‌ال.گزینه‌های نوشتن پیش فرض()
    wopts.تورفتگی = "\t"
    wopts.اعلان = درست
    سرچاپ اکس‌ام‌ال.نوشتن سفارشی(nest، wopts)

    اکس‌ام‌ال.آزادسازی(nest)
    سرچاپ اکس‌ام‌ال.شکل استاندارد گره(d، اکس‌ام‌ال.عنصرهای با نام(d، root، "book").شناسه‌ها.بگیر(1))
    سرچاپ اکس‌ام‌ال.نوشتن سفارشی(d، اکس‌ام‌ال.گزینه‌های نوشتن پیش فرض()) برابر اکس‌ام‌ال.نوشتن(d)
    ناپایا made := اکس‌ام‌ال.سند جدید()
    r := اکس‌ام‌ال.ساخت عنصر(made، "msg")
    اکس‌ام‌ال.افزودن فرزند(made، اکس‌ام‌ال.گره سند(made)، r)
    اکس‌ام‌ال.افزودن فرزند(made، r، اکس‌ام‌ال.ساخت متن(made، "a < b"))
    اکس‌ام‌ال.افزودن فرزند(made، r، اکس‌ام‌ال.ساخت سی‌دیتا(made، "<raw>"))
    اکس‌ام‌ال.افزودن فرزند(made، r، اکس‌ام‌ال.ساخت دستور پردازش(made، "go"، "now"))
    سرچاپ اکس‌ام‌ال.نوشتن(made)
    اکس‌ام‌ال.آزادسازی(made)

    ناپایا ev := اکس‌ام‌ال.ارزیابی(d، root، "count(book)"، err)
    سرچاپ err.موفق، ev.نوع برابر اکس‌ام‌ال.مقدار عدد، ev.عدد
    اکس‌ام‌ال.آزادسازی مقدار(ev)
    ناپایا attrs := اکس‌ام‌ال.ارزیابی(d، root، "book/@n"، err)
    سرچاپ attrs.گره‌ها.شناسه‌ها.طول()
    id := attrs.گره‌ها.شناسه‌ها.بگیر(1)
    سرچاپ اکس‌ام‌ال.ارجاع ویژگی است(id)، اکس‌ام‌ال.ارجاع ویژگی است(first)
    ref := اکس‌ام‌ال.ویژگی ارجاع‌شده(d، id)
    سرچاپ ref.نام، ref.مقدار
    سرچاپ اکس‌ام‌ال.ارجاع ویژگی(0) نابرابر 0 - 1، اکس‌ام‌ال.ارجاع ویژگی است(اکس‌ام‌ال.ارجاع ویژگی(0))
    اکس‌ام‌ال.آزادسازی مقدار(attrs)
    سرچاپ اکس‌ام‌ال.نام گره(d، id)
    اکس‌ام‌ال.آزادسازی(d)

    ناپایا dtd := اکس‌ام‌ال.تجزیه دی‌تی‌دی("<!ELEMENT r (a)><!ELEMENT a EMPTY><!ATTLIST a id CDATA #IMPLIED><!ATTLIST a x CDATA \"1\">")
    سرچاپ dtd.موفق، اکس‌ام‌ال.شمار عنصرهای اعلام‌شده(dtd)، اکس‌ام‌ال.شمار ویژگی‌های اعلام‌شده(dtd)
    اکس‌ام‌ال.آزادسازی دی‌تی‌دی(dtd)
پایان
