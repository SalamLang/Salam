// زبان: فارسی
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

بسته ریشه

واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه:
    منبع := "<lib id=\"1\" kind=\"a\"><book n=\"x\">Salam<i>bold</i> tail</book><book n=\"y\"/><!--c--></lib>"
    تلاش:
        ناپایا گزینه‌ها := اکس‌ام‌ال.گزینه‌های پیش فرض()
        گزینه‌ها.نگه‌داشتن توضیح‌ها = نادرست
        ناپایا d := اکس‌ام‌ال.تجزیه سفارشی(منبع، گزینه‌ها)
        سرچاپ اکس‌ام‌ال.شمار گره‌ها(d)
        ریشه عنصر := اکس‌ام‌ال.عنصر ریشه(d)
        سرچاپ اکس‌ام‌ال.عنصر است(d، ریشه عنصر)، اکس‌ام‌ال.عنصر است(d، اکس‌ام‌ال.گره سند(d))
        ناپایا فرزندان := اکس‌ام‌ال.گره‌های فرزند(d، ریشه عنصر)
        سرچاپ فرزندان.شناسه‌ها.طول()
        اکس‌ام‌ال.آزادسازی فهرست(فرزندان)
        ناپایا عنصرها := اکس‌ام‌ال.عنصرها(d، ریشه عنصر)
        سرچاپ عنصرها.شناسه‌ها.طول()
        نخست := عنصرها.شناسه‌ها.بگیر(0)
        سرچاپ اکس‌ام‌ال.عنصر است(d، نخست)، اکس‌ام‌ال.نام گره(d، نخست)، اکس‌ام‌ال.نام گره(d، ریشه عنصر)
        سرچاپ اکس‌ام‌ال.متن مستقیم(d، نخست)
        سرچاپ اکس‌ام‌ال.شمار ویژگی‌ها(d، ریشه عنصر)، اکس‌ام‌ال.شمار ویژگی‌ها(d، نخست)
        a := اکس‌ام‌ال.ویژگی شماره(d، ریشه عنصر، 1)
        سرچاپ a.نام، a.مقدار
        ناپایا نیاکان := اکس‌ام‌ال.نیاکان(d، اکس‌ام‌ال.نخستین عنصر با نام(d، نخست، "i"))
        سرچاپ نیاکان.شناسه‌ها.طول()
        اکس‌ام‌ال.آزادسازی فهرست(نیاکان)
        اکس‌ام‌ال.آزادسازی فهرست(عنصرها)

        ناپایا با توضیح := اکس‌ام‌ال.تجزیه سفارشی(منبع، اکس‌ام‌ال.گزینه‌های پیش فرض())
        سرچاپ اکس‌ام‌ال.شمار گره‌ها(با توضیح) - اکس‌ام‌ال.شمار گره‌ها(d)
        اکس‌ام‌ال.آزادسازی(با توضیح)

        تلاش:
            ناپایا خراب := اکس‌ام‌ال.تجزیه سفارشی("<a><b></a>"، گزینه‌ها)
            سرچاپ اکس‌ام‌ال.شمار گره‌ها(خراب)
            اکس‌ام‌ال.آزادسازی(خراب)
        گرفتن خطا e:
            سرچاپ e.است(نوع خطا.نحو)، e.خط، e.ستون
            سرچاپ e.به رشته()
        پایان

        ناپایا لانه‌ای := اکس‌ام‌ال.تجزیه("<r><a><b>t</b></a></r>")
        سرچاپ اکس‌ام‌ال.نوشتن گره با تورفتگی(لانه‌ای، اکس‌ام‌ال.نخستین عنصر با نام(لانه‌ای، اکس‌ام‌ال.عنصر ریشه(لانه‌ای)، "a")، "  ")
        ناپایا گزینه نوشتن := اکس‌ام‌ال.گزینه‌های نوشتن پیش فرض()
        گزینه نوشتن.تورفتگی = "\t"
        گزینه نوشتن.اعلان = درست
        سرچاپ اکس‌ام‌ال.نوشتن سفارشی(لانه‌ای، گزینه نوشتن)

        اکس‌ام‌ال.آزادسازی(لانه‌ای)
        سرچاپ اکس‌ام‌ال.شکل استاندارد گره(d، اکس‌ام‌ال.عنصرهای با نام(d، ریشه عنصر، "book").شناسه‌ها.بگیر(1))
        سرچاپ اکس‌ام‌ال.نوشتن سفارشی(d، اکس‌ام‌ال.گزینه‌های نوشتن پیش فرض()) برابر اکس‌ام‌ال.نوشتن(d)
        ناپایا ساخته := اکس‌ام‌ال.سند جدید()
        r := اکس‌ام‌ال.ساخت عنصر(ساخته، "msg")
        اکس‌ام‌ال.افزودن فرزند(ساخته، اکس‌ام‌ال.گره سند(ساخته)، r)
        اکس‌ام‌ال.افزودن فرزند(ساخته، r، اکس‌ام‌ال.ساخت متن(ساخته، "a < b"))
        اکس‌ام‌ال.افزودن فرزند(ساخته، r، اکس‌ام‌ال.ساخت سی‌دیتا(ساخته، "<raw>"))
        اکس‌ام‌ال.افزودن فرزند(ساخته، r، اکس‌ام‌ال.ساخت دستور پردازش(ساخته، "go"، "now"))
        سرچاپ اکس‌ام‌ال.نوشتن(ساخته)
        اکس‌ام‌ال.آزادسازی(ساخته)

        ناپایا ارزش := اکس‌ام‌ال.ارزیابی(d، ریشه عنصر، "count(book)")
        سرچاپ ارزش.نوع برابر اکس‌ام‌ال.مقدار عدد، ارزش.عدد
        اکس‌ام‌ال.آزادسازی مقدار(ارزش)
        ناپایا ویژگی‌ها := اکس‌ام‌ال.ارزیابی(d، ریشه عنصر، "book/@n")
        سرچاپ ویژگی‌ها.گره‌ها.شناسه‌ها.طول()
        شناسه := ویژگی‌ها.گره‌ها.شناسه‌ها.بگیر(1)
        سرچاپ اکس‌ام‌ال.ارجاع ویژگی است(شناسه)، اکس‌ام‌ال.ارجاع ویژگی است(نخست)
        مرجع := اکس‌ام‌ال.ویژگی ارجاع‌شده(d، شناسه)
        سرچاپ مرجع.نام، مرجع.مقدار
        سرچاپ اکس‌ام‌ال.ارجاع ویژگی(0) نابرابر 0 - 1، اکس‌ام‌ال.ارجاع ویژگی است(اکس‌ام‌ال.ارجاع ویژگی(0))
        اکس‌ام‌ال.آزادسازی مقدار(ویژگی‌ها)
        سرچاپ اکس‌ام‌ال.نام گره(d، شناسه)
        اکس‌ام‌ال.آزادسازی(d)
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان
    تلاش:
        ناپایا سند := اکس‌ام‌ال.تجزیه("<a/>")
        تلاش:
            _ := اکس‌ام‌ال.ارزیابی(سند، اکس‌ام‌ال.عنصر ریشه(سند)، "count(")
            سرچاپ "evaluated"
        گرفتن خطا e:
            سرچاپ e.نام نوع()، e.پیام
        پایان
        اکس‌ام‌ال.آزادسازی(سند)
    گرفتن خطا e:
        سرچاپ e.به رشته()
    پایان

    ناپایا تعریف := اکس‌ام‌ال.تجزیه دی‌تی‌دی("<!ELEMENT r (a)><!ELEMENT a EMPTY><!ATTLIST a id CDATA #IMPLIED><!ATTLIST a x CDATA \"1\">")
    سرچاپ تعریف.موفق، اکس‌ام‌ال.شمار عنصرهای اعلام‌شده(تعریف)، اکس‌ام‌ال.شمار ویژگی‌های اعلام‌شده(تعریف)
    اکس‌ام‌ال.آزادسازی دی‌تی‌دی(تعریف)
پایان
