بسته ریشه

واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه خطادار:
    متن := "<library><book lang=\"fa\"><price>12</price></book><book lang=\"en\"><price>8</price></book></library>"
    ناپایا d := تلاش اکس‌ام‌ال.تجزیه(متن)
    ناپایا متغیرها := اکس‌ام‌ال.متغیرهای اکس‌پث {}
    متغیرها.تنظیم رشته("lang"، "en")
    متغیرها.تنظیم عدد("min"، 5.0)
    متغیرها.تنظیم منطقی("wanted"، درست)
    سرچاپ متغیرها.اندیس("lang")

    سرچاپ تلاش اکس‌ام‌ال.انتخاب عدد با متغیرها(d، 0 - 1، "count(//book[@lang=$lang])"، متغیرها)
    سرچاپ تلاش اکس‌ام‌ال.انتخاب رشته با متغیرها(d، 0 - 1، "string(//book[@lang=$lang]/price)"، متغیرها)
    سرچاپ تلاش اکس‌ام‌ال.انتخاب منطقی با متغیرها(d، 0 - 1، "$wanted"، متغیرها)
    سرچاپ تلاش اکس‌ام‌ال.انتخاب نخستین با متغیرها(d، 0 - 1، "//book[@lang=$lang]"، متغیرها)

    فهرست := تلاش اکس‌ام‌ال.انتخاب با متغیرها(d، 0 - 1، "//book"، متغیرها)
    متغیرها.تنظیم گره‌ها("books"، فهرست)
    سرچاپ تلاش اکس‌ام‌ال.انتخاب عدد با متغیرها(d، 0 - 1، "count($books)"، متغیرها)

    ناپایا مقدار := تلاش اکس‌ام‌ال.ارزیابی با متغیرها(d، 0 - 1، "$min + 1"، متغیرها)
    سرچاپ مقدار.عدد
    اکس‌ام‌ال.آزادسازی مقدار(مقدار)
    یک := تلاش اکس‌ام‌ال.ارزیابی با متغیرها(d، 0 - 1، "1"، متغیرها)
    متغیرها.تنظیم("one"، یک)

    متغیرها.آزادسازی()
    اکس‌ام‌ال.آزادسازی(d)
پایان
