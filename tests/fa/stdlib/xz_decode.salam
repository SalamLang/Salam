b1187dc8977ffe779171
"""

پایا WORDS := ["salam"، "compress"، "xz"، "lzma"، "archive"، "the"، "quick"، "brown"، "fox"، "jumps"، "over"، "lazy"، "dog"، "stream"، "block"، "index"]

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع lcg(x: صحیح۶۴): صحیح۶۴:
    برگشت (x * 1103515245 + 12345) & 0x7fffffff
پایان

تابع gen_text(n: صحیح، seed: صحیح۶۴): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = lcg(x)
        w := WORDS[((x >> 8) % 16) برگردان صحیح]
        فشرده سازی.افزودن بایت‌ها(out، w برگردان تهی*، w.طول())
        اگر ((x >> 4) & 7) برابر 0:
            فشرده سازی.افزودن بایت(out، 10)
        وگرنه:
            فشرده سازی.افزودن بایت(out، 32)
        پایان
    پایان
    برگشت out
پایان

تابع push32(b &: فشرده سازی.بافر بایت، v: صحیح۶۴):
    فشرده سازی.افزودن بایت(b، (v & 255) برگردان صحیح)
    فشرده سازی.افزودن بایت(b، ((v >> 8) & 255) برگردان صحیح)
    فشرده سازی.افزودن بایت(b، ((v >> 16) & 255) برگردان صحیح)
    فشرده سازی.افزودن بایت(b، ((v >> 24) & 255) برگردان صحیح)
پایان

تابع gen_x86(n: صحیح، seed: صحیح۶۴): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = lcg(x)
        k := (x >> 8) % 4
        اگر k کوچکتر 2:
            rel := ((x >> 10) % 2000) - 1000
            اگر k برابر 0:
                فشرده سازی.افزودن بایت(out، 232)
            وگرنه:
                فشرده سازی.افزودن بایت(out، 233)
            پایان
            push32(out، rel & 0xffffffff)
        وگرنه:
            c := 1 + ((x >> 10) % 4)
            تکرار c:
                x = lcg(x)
                فشرده سازی.افزودن بایت(out، ((x >> 12) & 255) برگردان صحیح)
            پایان
        پایان
    پایان
    برگشت out
پایان

تابع gen_delta(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    تکرار n در i:
        push32(out، ((i * 5 + (i % 3)) برگردان صحیح۶۴) & 0xffffffff)
    پایان
    برگشت out
پایان

تابع gen_big(): فشرده سازی.بافر بایت:
    ناپایا out := gen_text(800، 7)
    تکرار 5000:
        فشرده سازی.افزودن بایت‌ها(out، "abcdefgh12345678" برگردان تهی*، 16)
    پایان
    تکرار 30000:
        فشرده سازی.افزودن بایت(out، 0)
    پایان
    برگشت out
پایان

تابع same(label: رشته، ok: منطقی، got: فشرده سازی.بافر بایت، want: فشرده سازی.بافر بایت):
    سرچاپ label، ok و فشرده سازی.برابری بافر(got، want)، got.طول
پایان

تابع xz_case(label: رشته، hex: رشته، want: فشرده سازی.بافر بایت):
    packed := unhex(hex)
    ناپایا ok := نادرست
    got := فشرده سازی.کدگشایی ایکس زد(packed.داده، packed.طول، ok)
    same(label، ok، got، want)
پایان

تابع lzma_case(label: رشته، hex: رشته، want: فشرده سازی.بافر بایت):
    packed := unhex(hex)
    ناپایا ok := نادرست
    got := فشرده سازی.کدگشایی الزد ام ای(packed.داده، packed.طول، ok)
    same(label، ok، got، want)
پایان

تابع xz_bad(label: رشته، packed: فشرده سازی.بافر بایت):
    ناپایا ok := درست
    got := فشرده سازی.کدگشایی ایکس زد بافر(packed، ok)
    سرچاپ label، ok، got.طول
پایان

تابع read_same(path: رشته، want: فشرده سازی.بافر بایت): منطقی:
    ناپایا ok := نادرست
    got := بایگانی.خواندن پرونده دودویی(path، ok)
    برگشت ok و فشرده سازی.برابری بافر(got، want)
پایان

تابع ریشه:
    text := gen_text(40، 1)
    x86 := gen_x86(300، 3)
    delta := gen_delta(400)
    big := gen_big()

    سرچاپ "== xz =="
    xz_case("crc64 -6"، XZ_CRC64، text)
    xz_case("crc32"، XZ_CRC32، text)
    xz_case("sha256 -1"، XZ_SHA256، text)
    xz_case("no check -0"، XZ_NONE، text)
    xz_case("extreme -9e"، XZ_EXTREME، text)
    xz_case("several blocks"، XZ_BLOCKS، text)
    xz_case("python sha256"، XZ_PY، text)
    xz_case("7z -txz"، XZ_7Z، text)

    سرچاپ "== filters =="
    xz_case("x86 branch filter"، XZ_X86، x86)
    xz_case("delta distance 4"، XZ_DELTA، delta)
    xz_case("python x86 + lc1 lp2 pb0"، XZ_PY_FILTERS، x86)

    سرچاپ "== lzma =="
    ناپایا ok := نادرست
    packed := unhex(LZMA_XZ)
    got := فشرده سازی.کدگشایی الزد ام ای بافر(packed، ok)
    same("xz --format=lzma"، ok، got، text)
    lzma_case("python alone"، LZMA_PY، text)
    lzma_case("python alone lc0 lp3 pb1"، LZMA_PY_LC، text)

    ناپایا known := فشرده سازی.کپی بافر(packed)
    تکرار 8 در i:
        فشرده سازی.تنظیم بایت(known، 5 + i، 0)
    پایان
    فشرده سازی.تنظیم بایت(known، 5، text.طول & 255)
    فشرده سازی.تنظیم بایت(known، 6، (text.طول >> 8) & 255)
    got2 := فشرده سازی.کدگشایی الزد ام ای بافر(known، ok)
    same("known size in header"، ok، got2، text)
    فشرده سازی.تنظیم بایت(known، 5، (text.طول + 1) & 255)
    got3 := فشرده سازی.کدگشایی الزد ام ای بافر(known، ok)
    سرچاپ "size larger than the data"، ok، got3.طول

    سرچاپ "== raw =="
    raw1 := unhex(RAW_LZMA)
    props := unhex("5d00000100")
    got4 := فشرده سازی.کدگشایی الزد ام ای خام(props.داده، 5، raw1.داده، raw1.طول، text.طول، 0، ok)
    same("raw lzma"، ok، got4، text)
    raw2 := unhex(RAW_LZMA2)
    got5 := فشرده سازی.کدگشایی الزد ام ای۲ خام(16، raw2.داده، raw2.طول، text.طول، 0، ok)
    same("raw lzma2"، ok، got5، text)
    got6 := فشرده سازی.کدگشایی الزد ام ای۲ خام(16، raw2.داده، raw2.طول، -1، 0، ok)
    same("raw lzma2 unknown size"، ok، got6، text)
    got7 := فشرده سازی.کدگشایی الزد ام ای۲ خام(16، raw2.داده، raw2.طول، text.طول + 5، 0، ok)
    سرچاپ "raw lzma2 wrong size"، ok، got7.طول
    got8 := فشرده سازی.کدگشایی الزد ام ای۲ خام(41، raw2.داده، raw2.طول، -1، 0، ok)
    سرچاپ "raw lzma2 bad dictionary"، ok، got8.طول

    سرچاپ "== bigger =="
    xz_case("xz 70 KB"، XZ_BIG، big)
    bpk := unhex(LZMA_BIG)
    got9 := فشرده سازی.کدگشایی الزد ام ای بافر(bpk، ok)
    same("lzma 70 KB"، ok، got9، big)
    سرچاپ "packed"، unhex(XZ_BIG).طول، "to"، big.طول

    سرچاپ "== limits =="
    bx := unhex(XZ_BIG)
    lim1 := فشرده سازی.کدگشایی ایکس زد با سقف(bx.داده، bx.طول، big.طول، ok)
    سرچاپ "xz max exact"، ok، lim1.طول
    lim2 := فشرده سازی.کدگشایی ایکس زد با سقف(bx.داده، bx.طول، big.طول - 1، ok)
    سرچاپ "xz max one less"، ok، lim2.طول
    lim3 := فشرده سازی.کدگشایی ایکس زد با سقف(bx.داده، bx.طول، 100، ok)
    سرچاپ "xz max 100"، ok، lim3.طول
    lim4 := فشرده سازی.کدگشایی الزد ام ای با سقف(bpk.داده، bpk.طول، big.طول، ok)
    سرچاپ "lzma max exact"، ok، lim4.طول
    lim5 := فشرده سازی.کدگشایی الزد ام ای با سقف(bpk.داده، bpk.طول، 100، ok)
    سرچاپ "lzma max 100"، ok، lim5.طول

    سرچاپ "== streams =="
    ناپایا two := unhex(XZ_CRC32)
    فشرده سازی.افزودن بافر(two، unhex(XZ_SHA256))
    ناپایا twice := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بافر(twice، text)
    فشرده سازی.افزودن بافر(twice، text)
    got10 := فشرده سازی.کدگشایی ایکس زد بافر(two، ok)
    same("two streams"، ok، got10، twice)
    ناپایا padded := unhex(XZ_CRC32)
    تکرار 8:
        فشرده سازی.افزودن بایت(padded، 0)
    پایان
    فشرده سازی.افزودن بافر(padded، unhex(XZ_NONE))
    got11 := فشرده سازی.کدگشایی ایکس زد بافر(padded، ok)
    same("stream padding"، ok، got11، twice)
    ناپایا tail := unhex(XZ_CRC32)
    تکرار 3:
        فشرده سازی.افزودن بایت(tail، 0)
    پایان
    xz_bad("padding not a multiple of 4"، tail)

    سرچاپ "== damaged =="
    xz_bad("empty"، فشرده سازی.بافر بایت جدید())
    ناپایا cut := unhex(XZ_SHA256)
    cut.طول -= 1
    xz_bad("truncated"، cut)
    cut.طول = 20
    xz_bad("cut inside block"، cut)
    ناپایا magic := unhex(XZ_CRC64)
    فشرده سازی.تنظیم بایت(magic، 0، 0)
    xz_bad("bad magic"، magic)
    ناپایا flags := unhex(XZ_CRC64)
    فشرده سازی.تنظیم بایت(flags، 7، 3)
    xz_bad("bad stream flags"، flags)
    ناپایا chk := unhex(XZ_SHA256)
    فشرده سازی.تنظیم بایت(chk، 160، فشرده سازی.دریافت بایت(chk، 160) ^ 1)
    xz_bad("sha256 mismatch"، chk)
    ناپایا c32 := unhex(XZ_CRC32)
    فشرده سازی.تنظیم بایت(c32، 156، فشرده سازی.دریافت بایت(c32، 156) ^ 128)
    xz_bad("crc32 mismatch"، c32)
    ناپایا body := unhex(XZ_CRC64)
    فشرده سازی.تنظیم بایت(body، 30، فشرده سازی.دریافت بایت(body، 30) ^ 4)
    xz_bad("flipped data bit"، body)
    ناپایا hdr := unhex(XZ_CRC64)
    فشرده سازی.تنظیم بایت(hdr، 13، فشرده سازی.دریافت بایت(hdr، 13) ^ 1)
    xz_bad("block header crc"، hdr)
    ناپایا foot := unhex(XZ_CRC64)
    فشرده سازی.تنظیم بایت(foot، foot.طول - 1، 0)
    xz_bad("bad footer magic"، foot)
    ناپایا alone := unhex(LZMA_XZ)
    alone.طول -= 5
    got12 := فشرده سازی.کدگشایی الزد ام ای بافر(alone، ok)
    سرچاپ "truncated lzma"، ok، got12.طول
    ناپایا hbad := unhex(LZMA_XZ)
    فشرده سازی.تنظیم بایت(hbad، 0، 225)
    got13 := فشرده سازی.کدگشایی الزد ام ای بافر(hbad، ok)
    سرچاپ "bad lzma properties"، ok، got13.طول
    فشرده سازی.تنظیم بایت(hbad، 0، 93)
    فشرده سازی.تنظیم بایت(hbad، 4، 255)
    got14 := فشرده سازی.کدگشایی الزد ام ای بافر(hbad، ok)
    سرچاپ "lzma dictionary over the limit"، ok، got14.طول

    سرچاپ "== files =="
    xz_path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_xz_decode.xz")
    lzma_path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_xz_decode.lzma")
    out_path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_xz_decode.out")
    بایگانی.نوشتن پرونده دودویی از بافر(xz_path، unhex(XZ_BLOCKS))
    بایگانی.نوشتن پرونده دودویی از بافر(lzma_path، unhex(LZMA_XZ))
    سرچاپ "xz file"، بایگانی.کدگشایی پرونده ایکس زد(xz_path، out_path)، read_same(out_path، text)
    سرچاپ "lzma file"، بایگانی.کدگشایی پرونده الزد ام ای(lzma_path، out_path)، read_same(out_path، text)
    سرچاپ "xz file read as lzma"، بایگانی.کدگشایی پرونده الزد ام ای(xz_path، out_path)
    سرچاپ "missing file"، بایگانی.کدگشایی پرونده ایکس زد(out_path + ".missing"، out_path)
    سیستم عامل.حذف(xz_path)
    سیستم عامل.حذف(lzma_path)
    سیستم عامل.حذف(out_path)

    سرچاپ "== filters directly =="
    d := unhex("01010101")
    سرچاپ فشرده سازی.کدگشایی فیلتر دلتا(d.داده، d.طول، 1)، فشرده سازی.دریافت بایت(d، 0)، فشرده سازی.دریافت بایت(d، 1)، فشرده سازی.دریافت بایت(d، 2)، فشرده سازی.دریافت بایت(d، 3)
    سرچاپ فشرده سازی.کدگشایی فیلتر دلتا(d.داده، d.طول، 0)، فشرده سازی.کدگشایی فیلتر شاخه(99، d.داده، d.طول، 0)، فشرده سازی.کدگشایی فیلتر شاخه(فشرده سازی.فیلتر آرم، d.داده، d.طول، 0)
پایان
