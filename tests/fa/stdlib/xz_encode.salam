بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

پایا WORDS := ["salam"، "compress"، "xz"، "lzma"، "archive"، "the"، "quick"، "brown"، "fox"، "jumps"، "over"، "lazy"، "dog"، "stream"، "block"، "index"]

تابع lcg(x: صحیح۶۴): صحیح۶۴:
    برگشت (x * 1103515245 + 12345) & 0x7fffffff
پایان

تابع gen_text(n: صحیح، seed: صحیح۶۴): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = lcg(x)
        w := WORDS[((x >> 8) % 16) برگردان صحیح]
        فشرده سازی.افزودن بایت‌ها(out، w برگردان تهی*، w.طول())
        اگر ((x >> 4) & 7) برابر 0:
            فشرده سازی.افزودن بایت(out، 10)
        وگرنه:
            فشرده سازی.افزودن بایت(out، 32)
        پایان
    پایان
    برگشت out
پایان

تابع gen_noise(n: صحیح، seed: صحیح۶۴): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = lcg(x)
        فشرده سازی.افزودن بایت(out، ((x >> 10) & 255) برگردان صحیح)
    پایان
    برگشت out
پایان

تابع gen_mixed(): فشرده سازی.بافر بایت:
    ناپایا out := gen_text(6000، 5 برگردان صحیح۶۴)
    فشرده سازی.افزودن بافر(out، gen_noise(70000، 9 برگردان صحیح۶۴))
    فشرده سازی.افزودن بافر(out، gen_text(6000، 5 برگردان صحیح۶۴))
    تکرار 40000:
        فشرده سازی.افزودن بایت(out، 0)
    پایان
    فشرده سازی.افزودن بافر(out، gen_noise(300، 3 برگردان صحیح۶۴))
    برگشت out
پایان

تابع hex(b: فشرده سازی.بافر بایت): رشته:
    digits := "0123456789abcdef"
    ناپایا s := ""
    تکرار b.طول در i:
        v := فشرده سازی.دریافت بایت(b، i)
        s = s + digits.زیررشته(v >> 4، 1) + digits.زیررشته(v & 15، 1)
    پایان
    برگشت s
پایان

تابع xz_case(label: رشته، src: فشرده سازی.بافر بایت، level: صحیح، check: صحیح):
    packed := فشرده سازی.فشرده سازی ایکس زد با بررسی(src.داده، src.طول، level، check)
    ناپایا ok := نادرست
    back := فشرده سازی.کدگشایی ایکس زد بافر(packed، ok)
    سرچاپ label، ok، فشرده سازی.برابری بافر(back، src)، packed.طول کوچکتر src.طول + 80
پایان

تابع lzma_case(label: رشته، src: فشرده سازی.بافر بایت، level: صحیح):
    packed := فشرده سازی.فشرده سازی الزد ام ای با سطح(src.داده، src.طول، level)
    ناپایا ok := نادرست
    back := فشرده سازی.کدگشایی الزد ام ای بافر(packed، ok)
    سرچاپ label، ok، فشرده سازی.برابری بافر(back، src)، packed.طول کوچکتر src.طول + src.طول / 20 + 40
پایان

تابع ریشه:
    text := gen_text(4000، 1 برگردان صحیح۶۴)
    noise := gen_noise(20000، 2 برگردان صحیح۶۴)
    mixed := gen_mixed()
    one := فشرده سازی.بافر از رشته("a")
    empty := فشرده سازی.بافر بایت جدید()
    سرچاپ "== xz =="
    xz_case("empty"، empty، 6، 4)
    xz_case("one byte"، one، 6، 4)
    xz_case("text"، text، 6، 4)
    xz_case("noise"، noise، 6، 4)
    xz_case("mixed"، mixed، 6، 4)
    سرچاپ "== checks =="
    xz_case("none"، text، 6، فشرده سازی.بررسی ایکس زد هیچ)
    xz_case("crc32"، text، 6، فشرده سازی.بررسی ایکس زد سی آر سی۳۲)
    xz_case("crc64"، text، 6، فشرده سازی.بررسی ایکس زد سی آر سی۶۴)
    xz_case("sha256"، text، 6، فشرده سازی.بررسی ایکس زد شا۲۵۶)
    xz_case("unknown check becomes crc64"، text، 6، 3)
    سرچاپ "== levels =="
    for_each_level(text، mixed)
    سرچاپ "== lzma =="
    lzma_case("empty"، empty، 6)
    lzma_case("one byte"، one، 6)
    lzma_case("text"، text، 6)
    lzma_case("noise"، noise، 6)
    lzma_case("mixed"، mixed، 9)

    سرچاپ "== sizes =="
    px := فشرده سازی.فشرده سازی ایکس زد(text.داده، text.طول)
    pl := فشرده سازی.فشرده سازی الزد ام ای(text.داده، text.طول)
    سرچاپ "text"، text.طول، px.طول کوچکتر text.طول / 3، pl.طول کوچکتر text.طول / 3
    pn := فشرده سازی.فشرده سازی ایکس زد(noise.داده، noise.طول)
    سرچاپ "noise stays stored"، pn.طول کوچکتر noise.طول + 80
    pe := فشرده سازی.فشرده سازی ایکس زد بافر(empty)
    سرچاپ "empty stream"، pe.طول
    ps := فشرده سازی.فشرده سازی ایکس زد رشته("salam salam salam salam")
    سرچاپ "str"، فشرده سازی.دریافت بایت(ps، 0)، فشرده سازی.دریافت بایت(ps، 1)، فشرده سازی.دریافت بایت(ps، 5)
    pb := فشرده سازی.فشرده سازی ایکس زد بافر(text)
    سرچاپ "buf equals"، فشرده سازی.برابری بافر(pb، px)
    lb := فشرده سازی.فشرده سازی الزد ام ای بافر(text)
    سرچاپ "lzma buf equals"، فشرده سازی.برابری بافر(lb، pl)
    ls := فشرده سازی.فشرده سازی الزد ام ای رشته("salam")
    سرچاپ "lzma header"، فشرده سازی.دریافت بایت(ls، 0)، فشرده سازی.دریافت بایت(ls، 5)، ls.طول

    سرچاپ "== bytes =="
    سرچاپ "xz"، hex(فشرده سازی.فشرده سازی ایکس زد با بررسی("salam salam salam salam" برگردان تهی*، 23، 6، 1))
    سرچاپ "lzma"، hex(فشرده سازی.فشرده سازی الزد ام ای با سطح("salam salam salam salam" برگردان تهی*، 23، 6))

    سرچاپ "== files =="
    src_path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_xz_encode.src")
    xz_path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_xz_encode.xz")
    lzma_path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_xz_encode.lzma")
    back_path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_xz_encode.back")
    بایگانی.نوشتن پرونده دودویی از بافر(src_path، mixed)
    سرچاپ "xz file"، بایگانی.فشرده سازی پرونده ایکس زد(src_path، xz_path)، بایگانی.کدگشایی پرونده ایکس زد(xz_path، back_path)، read_same(back_path، mixed)
    سرچاپ "lzma file"، بایگانی.فشرده سازی پرونده الزد ام ای(src_path، lzma_path)، بایگانی.کدگشایی پرونده الزد ام ای(lzma_path، back_path)، read_same(back_path، mixed)
    سرچاپ "missing file"، بایگانی.فشرده سازی پرونده ایکس زد(src_path + ".missing"، xz_path)
    سیستم عامل.حذف(src_path)
    سیستم عامل.حذف(xz_path)
    سیستم عامل.حذف(lzma_path)
    سیستم عامل.حذف(back_path)
پایان

تابع read_same(path: رشته، want: فشرده سازی.بافر بایت): منطقی:
    ناپایا ok := نادرست
    got := بایگانی.خواندن پرونده دودویی(path، ok)
    برگشت ok و فشرده سازی.برابری بافر(got، want)
پایان

تابع for_each_level(a: فشرده سازی.بافر بایت، b: فشرده سازی.بافر بایت):
    ناپایا lv := 0
    تا lv کوچکتربرابر 9:
        ناپایا ok := نادرست
        pa := فشرده سازی.فشرده سازی ایکس زد با سطح(a.داده، a.طول، lv)
        ba := فشرده سازی.کدگشایی ایکس زد بافر(pa، ok)
        oka := ok و فشرده سازی.برابری بافر(ba، a)
        pb := فشرده سازی.فشرده سازی ایکس زد با سطح(b.داده، b.طول، lv)
        bb := فشرده سازی.کدگشایی ایکس زد بافر(pb، ok)
        سرچاپ "level"، lv، oka، ok و فشرده سازی.برابری بافر(bb، b)
        lv++
    پایان
پایان
