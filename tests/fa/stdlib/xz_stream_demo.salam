بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

پایا SHA_XZ := "fd377a585a00000ae1fb0ca104c02df6012101160000000000000000644ebc90e000f500255d00399849da93e1a08327c57b49fecb1d2aba563d317e320cddb11c02036cbb12d618aee9200000000000f51d5a279901398c0ac2aafca6d72e61e6a11d65b31e2d850fc82eab385cce7f000161f601000000baca357fb6e9df1c02000000000a595a"
پایا DELTA_XZ := "fd377a585a000004e6d6b44604c131f6010301002101100000000000c75e57f4e000f500295d0039bb7d6f55efb6a1dd5db3c01adea843e18efdb4d462530e6cb20b072ad7117d6454628495320f200000000000e05d27053bcf197d00014df601000000f70f5b0fb1c467fb020000000004595a"

تابع cat(a: رشته، b: رشته): رشته:
    برگشت مسیر پرونده.پیوند(a، b)
پایان

تابع hexval(c: صحیح): صحیح:
    اگر c بزرگتربرابر 97:
        برگشت c - 87
    پایان
    برگشت c - 48
پایان

تابع from_hex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید با ظرفیت(s.طول() / 2)
    p := s برگردان طبیعی۸*
    ناپایا i := 0
    تا i + 1 کوچکتر s.طول():
        فشرده سازی.افزودن بایت(b، hexval(p[i] برگردان صحیح) * 16 + hexval(p[i + 1] برگردان صحیح))
        i += 2
    پایان
    برگشت b
پایان

تابع collect(p: تهی*، n: صحیح، c: تهی*): منطقی:
    فشرده سازی.افزودن بایت‌ها((c برگردان فشرده سازی.بافر بایت*)[0]، p، n)
    برگشت درست
پایان

تابع run_sink(path: رشته، cap: صحیح۶۴، label: رشته):
    fp := فشرده سازی.بازکردن پرونده برای خواندن(path)
    got := حافظه.تخصیص صفرشده(اندازه‌گونه(فشرده سازی.بافر بایت)) برگردان فشرده سازی.بافر بایت*
    got[0] = فشرده سازی.بافر بایت جدید()
    ناپایا sink := فشرده سازی.مقصد تابعی(cap، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، got برگردان تهی*)
    st := فشرده سازی.کدگشایی ایکس زد از پرونده به مقصد(fp، 0 برگردان صحیح۶۴، فشرده سازی.اندازه پرونده(fp)، sink، 0 برگردان صحیح۶۴)
    سرچاپ label، st، sink.نوشته شده، got[0].طول
    فشرده سازی.آزادسازی بافر(got[0])
    حافظه.آزادسازی(got برگردان تهی*)
    فشرده سازی.بستن پرونده(fp)
پایان

تابع ریشه:
    root := cat(سیستم عامل.پوشه موقت()، "salam_xz_stream_demo_fa")
    سیستم عامل.حذف همه(root)
    سیستم عامل.ساخت پوشه ها(root)
    ناپایا sha := from_hex(SHA_XZ)
    ناپایا delta := from_hex(DELTA_XZ)
    f1 := cat(root، "sha.xz")
    f2 := cat(root، "delta.xz")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(f1، sha)، بایگانی.نوشتن پرونده دودویی از بافر(f2، delta)
    run_sink(f1، 0 برگردان صحیح۶۴، "sha256")
    run_sink(f2، 0 برگردان صحیح۶۴، "delta")
    run_sink(f1، 100 برگردان صحیح۶۴، "cap")
    (sha.داده برگردان طبیعی۸*)[sha.طول / 2] = 7 برگردان طبیعی۸
    f3 := cat(root، "bad.xz")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(f3، sha)
    run_sink(f3، 0 برگردان صحیح۶۴، "damaged")
    out := cat(root، "out.txt")
    سرچاپ "file"، بایگانی.کدگشایی پرونده ایکس زد با سقف(f1، out، 0 برگردان صحیح۶۴)، سیستم عامل.اندازه پرونده(out)
    سرچاپ "file cap"، بایگانی.کدگشایی پرونده ایکس زد با سقف(f1، out، 100 برگردان صحیح۶۴)، سیستم عامل.وجود دارد(out)

    note := "hello xz tar"
    ناپایا big := فشرده سازی.بافر بایت جدید با ظرفیت(2000000)
    تکرار 2000000 در i:
        فشرده سازی.افزودن بایت(big، 65 + ((i % 1000) * (i % 977)) % 23)
    پایان
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("a.txt"، note برگردان تهی*، note.طول()، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("sub/big.bin"، big.داده، big.طول، نادرست))
    tar := cat(root، "t.tar")
    txz := cat(root، "t.tar.xz")
    سرچاپ بایگانی.ساخت پرونده تار(files، tar)، بایگانی.فشرده سازی پرونده ایکس زد(tar، txz)
    dir := cat(root، "x")
    سرچاپ "tar.xz"، بایگانی.استخراج همه از پرونده تار ایکس زد(txz، dir، 0 برگردان صحیح۶۴)
    p1 := cat(dir، "a.txt")
    p2 := cat(dir، "sub/big.bin")
    سرچاپ سیستم عامل.اندازه پرونده(p1)، سیستم عامل.اندازه پرونده(p2)
    ناپایا lst := 0
    ناپایا es := بایگانی.مدخل های پرونده تار فشرده(txz، بایگانی.قالب تار ایکس زد، lst)
    سرچاپ "list"، lst، es.طول()
    بایگانی.آزادسازی فهرست(es)
    dir2 := cat(root، "y")
    سرچاپ "capped"، بایگانی.استخراج همه از پرونده تار فشرده(txz، بایگانی.قالب تار ایکس زد، dir2، 100 برگردان صحیح۶۴)
    files.آزادکن()
    فشرده سازی.آزادسازی بافر(big)
    فشرده سازی.آزادسازی بافر(sha)
    فشرده سازی.آزادسازی بافر(delta)
    سیستم عامل.حذف همه(root)
    free_all(root، f1، f2، f3، out، tar، txz، dir، dir2، p1، p2)
    برگشت 0
پایان

تابع free_all(a: رشته، b: رشته، c: رشته، d: رشته، e: رشته، f: رشته، g: رشته، h: رشته، i: رشته، j: رشته، k: رشته):
    حافظه.آزادسازی(a برگردان تهی*)
    حافظه.آزادسازی(b برگردان تهی*)
    حافظه.آزادسازی(c برگردان تهی*)
    حافظه.آزادسازی(d برگردان تهی*)
    حافظه.آزادسازی(e برگردان تهی*)
    حافظه.آزادسازی(f برگردان تهی*)
    حافظه.آزادسازی(g برگردان تهی*)
    حافظه.آزادسازی(h برگردان تهی*)
    حافظه.آزادسازی(i برگردان تهی*)
    حافظه.آزادسازی(j برگردان تهی*)
    حافظه.آزادسازی(k برگردان تهی*)
