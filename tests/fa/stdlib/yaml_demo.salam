واردسازی کدگذاری.یامل

روال ریشه:
    پیکربندی := "app:\n  name: Salam\n  version: 3\n  debug: false\nservers:\n  - host: alpha.example.com\n    port: 8080\n  - host: beta.example.com\n    port: 8081\n"

    سرچاپ "معتبر:", یامل.معتبر(پیکربندی)
    سرچاپ "نام برنامه:", یامل.دریافت(پیکربندی, "app.name")
    سرچاپ "نسخه برنامه:", یامل.دریافت عدد(پیکربندی, "app.version")
    سرچاپ "حالت اشکال‌زدایی:", یامل.دریافت منطقی(پیکربندی, "app.debug")
    سرچاپ "تعداد سرورها:", یامل.طول(پیکربندی, "servers")
    سرچاپ "میزبان سرور اول:", یامل.دریافت(پیکربندی, "servers[0].host")
    سرچاپ "درگاه سرور دوم:", یامل.دریافت عدد(پیکربندی, "servers[1].port")

    سرچاپ "--- به صورت جیسون ---"
    سرچاپ یامل.به جیسون(پیکربندی)

    سرچاپ "--- یامل بازقالب‌بندی‌شده ---"
    سرچاپ یامل.برونریزی(پیکربندی)
پایان
