بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع make(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید با ظرفیت(n + 16)
    ناپایا s := 4242 برگردان صحیح۶۴
    ناپایا i := 0
    تا i کوچکتر n:
        s = (s * 1103515245 + 12345) & 0x7fffffff
        v := ((s >> 16) & 255) برگردان صحیح
        اگر (i / 4096) % 3 برابر 0:
            فشرده سازی.افزودن بایت(out، v)
            i++
        وگرنه:
            run := 1 + (v & 15)
            تکرار run:
                اگر i کوچکتر n:
                    فشرده سازی.افزودن بایت(out، 97 + (v & 7))
                    i++
                پایان
            پایان
        پایان
    پایان
    برگشت out
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_zip_create_mem")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا b := make(700000)
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("store.bin"، b.داده، 5000، بایگانی.روش زیپ ذخیره))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ با سطح("bz.bin"، b.داده، b.طول، بایگانی.روش زیپ بی زیپ دو، 9))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ با سطح("zs.bin"، b.داده، b.طول، بایگانی.روش زیپ زد استاندارد، 5))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ با سطح("lz.bin"، b.داده، b.طول، بایگانی.روش زیپ الزد ام ای، 6))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("empty.bin"، پوچ، 0، بایگانی.روش زیپ ذخیره))
    ناپایا deflated := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    deflated.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("deflate.bin"، b.داده، b.طول، بایگانی.روش زیپ دیفلیت))
    deflated.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("empty.bin"، پوچ، 0، بایگانی.روش زیپ دیفلیت))
    deflated.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("small.bin"، b.داده، 3000، بایگانی.روش زیپ دیفلیت))

    هر wide در [نادرست، درست]:
        ناپایا mem_zip := wide ? بایگانی.ساخت زیپ بزرگ(files) : بایگانی.ساخت زیپ(files)
        disk := مسیر پرونده.پیوند(dir، "disk.zip")
        made := wide ? بایگانی.ساخت پرونده زیپ بزرگ(files، disk) : بایگانی.ساخت پرونده زیپ(files، disk)
        ناپایا ok := نادرست
        ناپایا on_disk := بایگانی.خواندن پرونده دودویی(disk، ok)
        سرچاپ "wide"، wide، "file"، made، "same bytes"، فشرده سازی.برابری بافر(mem_zip، on_disk)
        فشرده سازی.آزادسازی بافر(on_disk)
        ناپایا es := بایگانی.فهرست زیپ(mem_zip.داده، mem_zip.طول)
        سرچاپ "entries"، es.طول()
        بایگانی.آزادسازی فهرست(es)
        فشرده سازی.آزادسازی بافر(mem_zip)
    پایان

    ناپایا checked := 0
    ناپایا fz := بایگانی.ساخت زیپ(deflated)
    سرچاپ "deflate"، بایگانی.بررسی زیپ(fz.داده، fz.طول، checked)، checked
    ناپایا fes := بایگانی.فهرست زیپ(fz.داده، fz.طول)
    سرچاپ "deflate entries"، fes.طول()
    بایگانی.آزادسازی فهرست(fes)
    فشرده سازی.آزادسازی بافر(fz)
    deflated.آزادکن()

    ناپایا locked := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    locked.بیفزا(بایگانی.ساخت ورودی پرونده زیپ رمزدار("aes.bin"، b.داده، b.طول، بایگانی.روش زیپ دیفلیت، 6، "pw"، بایگانی.رمزگذاری زیپ ای ای اس۲۵۶))
    locked.بیفزا(بایگانی.ساخت ورودی پرونده زیپ رمزدار("zc.bin"، b.داده، 100000، بایگانی.روش زیپ زد استاندارد، 3، "pw"، بایگانی.رمزگذاری زیپ کریپتو))
    ناپایا lz := بایگانی.ساخت زیپ(locked)
    سرچاپ "encrypted"، lz.طول بزرگتر 0
    lpath := مسیر پرونده.پیوند(dir، "locked.zip")
    بایگانی.نوشتن پرونده دودویی از بافر(lpath، lz)
    فشرده سازی.آزادسازی بافر(lz)
    ناپایا zf := بایگانی.بازکردن پرونده زیپ(lpath)
    بایگانی.تنظیم گذرواژه پرونده زیپ(zf، "pw")
    ناپایا les := بایگانی.مدخل های پرونده زیپ(zf)
    هر e در les:
        dest := مسیر پرونده.پیوند(dir، "x_" + e.نام)
        st := بایگانی.استخراج از پرونده زیپ به پرونده(zf، e.نام، dest، 0 برگردان صحیح۶۴)
        سرچاپ e.نام، e.اندازه، st، سیستم عامل.اندازه پرونده(dest) برابر e.اندازه
        سیستم عامل.حذف(dest)
        حافظه.آزادسازی(dest برگردان تهی*)
    پایان
    بایگانی.آزادسازی فهرست(les)
    بایگانی.بستن پرونده زیپ(zf)

    ناپایا bad := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    bad.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("missing.bin"، پوچ، 5، بایگانی.روش زیپ ذخیره))
    سرچاپ "bad input"، بایگانی.ساخت زیپ(bad).طول
    files.آزادکن()
    locked.آزادکن()
    bad.آزادکن()
    سیستم عامل.حذف همه(dir)
    فشرده سازی.آزادسازی بافر(b)
پایان
