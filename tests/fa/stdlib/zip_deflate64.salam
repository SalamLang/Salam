بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع hex_val(c: صحیح): صحیح:
    اگر c بزرگتربرابر 97: برگشت c - 87 پایان
    برگشت c - 48
پایان

تابع unhex(h: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := h برگردان طبیعی۸*
    ناپایا i := 0
    تا i + 1 کوچکتر h.طول():
        فشرده سازی.افزودن بایت(b، hex_val(bp[i] برگردان صحیح) * 16 + hex_val(bp[i + 1] برگردان صحیح))
        i += 2
    پایان
    برگشت b
پایان

تابع ریشه:
    z := unhex("")
    ناپایا es := بایگانی.فهرست زیپ(z.داده، z.طول)
    هر e در es:
        سرچاپ e.نام، e.اندازه، e.اندازه فشرده، e.روش
    پایان
    بایگانی.آزادسازی فهرست(es)

    ناپایا status := 0
    big := بایگانی.استخراج تایید شده از زیپ(z.داده، z.طول، "big.bin"، 0، status)
    سرچاپ "big"، status، big.طول، فشرده سازی.چک جمع سی آر سی بافر(big) برابر (3088058596 برگردان طبیعی۳۲)
    small := بایگانی.استخراج تایید شده از زیپ(z.داده، z.طول، "small.txt"، 0، status)
    سرچاپ "small"، status، فشرده سازی.بافر به رشته(small) برابر "hello deflate64\n" * 3
    ناپایا checked := 0
    سرچاپ "verify"، بایگانی.بررسی زیپ(z.داده، z.طول، checked)، checked
    capped := بایگانی.استخراج تایید شده از زیپ(z.داده، z.طول، "big.bin"، 1000، status)
    سرچاپ "capped"، status، capped.طول

    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_zip_deflate64")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    path := مسیر پرونده.پیوند(dir، "d64.zip")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(path، z)
    ناپایا zf := بایگانی.بازکردن پرونده زیپ(path)
    سرچاپ "open"، zf.وضعیت، zf.شمار
    out := مسیر پرونده.پیوند(dir، "big.out")
    سرچاپ "file"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "big.bin"، out، 0 برگردان صحیح۶۴)، سیستم عامل.اندازه پرونده(out)
    سرچاپ "file cap"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "big.bin"، out، 1000 برگردان صحیح۶۴)، سیستم عامل.وجود دارد(out)
    all := مسیر پرونده.پیوند(dir، "all")
    سرچاپ "all"، بایگانی.استخراج همه از پرونده زیپ(zf، all، 0 برگردان صحیح۶۴)
    p := مسیر پرونده.پیوند(all، "small.txt")
    سرچاپ سیستم عامل.اندازه پرونده(p)
    بایگانی.بستن پرونده زیپ(zf)

    bp := z.داده برگردان طبیعی۸*
    bp[60] = ((bp[60] برگردان صحیح) ^ 0x55) برگردان طبیعی۸
    broken := بایگانی.استخراج تایید شده از زیپ(z.داده، z.طول، "big.bin"، 0، status)
    سرچاپ "broken"، status نابرابر بایگانی.زیپ موفق، broken.طول
    سرچاپ بایگانی.روش زیپ دیفلیت۶۴
    سیستم عامل.حذف همه(dir)
    حافظه.آزادسازی(out برگردان تهی*)
    حافظه.آزادسازی(all برگردان تهی*)
    حافظه.آزادسازی(p برگردان تهی*)
پایان
