بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع cat(a: رشته، b: رشته): رشته:
    برگشت مسیر پرونده.پیوند(a، b)
پایان

تابع fill(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید با ظرفیت(n)
    تکرار n در i:
        فشرده سازی.افزودن بایت(b، (i * 7 + i / 13) & 255)
    پایان
    برگشت b
پایان

تابع ریشه:
    dir := cat(سیستم عامل.پوشه موقت()، "salam_zip_file_demo")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا data := fill(300000)
    ناپایا flat := فشرده سازی.بافر بایت جدید()
    تکرار 200000:
        فشرده سازی.افزودن بایت(flat، 65)
    پایان
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("docs/"، پوچ، 0، 0))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("docs/mixed.bin"، data.داده، data.طول، 8))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("docs/flat.txt"، flat.داده، flat.طول، 8))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("stored.bin"، data.داده، 1000، 0))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("../escape.txt"، flat.داده، 10، 0))
    ناپایا small := بایگانی.ساخت زیپ(files)
    ناپایا wide := بایگانی.ساخت زیپ بزرگ(files)
    path1 := cat(dir، "small.zip")
    path2 := cat(dir، "wide.zip")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(path1، small)، بایگانی.نوشتن پرونده دودویی از بافر(path2، wide)

    ناپایا names := وکتور {} برگردان وکتور<رشته>
    names.بیفزا(path1)
    names.بیفزا(path2)
    تکرار names.طول() در n:
        ناپایا zf := بایگانی.بازکردن پرونده زیپ(names.بگیر(n))
        سرچاپ "open"، zf.وضعیت، zf.شمار، zf.اندازه برابر (names.بگیر(n) برابر path1 ? small.طول : wide.طول) برگردان صحیح۶۴
        ناپایا es := بایگانی.مدخل های پرونده زیپ(zf)
        هر e در es:
            سرچاپ " "، e.نام، e.اندازه، e.اندازه فشرده، e.روش، e.پوشه
        پایان
        بایگانی.آزادسازی فهرست(es)
        out1 := cat(dir، "mixed.out")
        سرچاپ "mixed"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "docs/mixed.bin"، out1، 0 برگردان صحیح۶۴)
        ناپایا ok := نادرست
        ناپایا back := بایگانی.خواندن پرونده دودویی(out1، ok)
        سرچاپ ok، back.طول، فشرده سازی.چک جمع سی آر سی بافر(back) برابر فشرده سازی.چک جمع سی آر سی بافر(data)
        فشرده سازی.آزادسازی بافر(back)
        سرچاپ "flat"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "docs/flat.txt"، out1، 0 برگردان صحیح۶۴)، سیستم عامل.اندازه پرونده(out1)
        سرچاپ "stored"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "stored.bin"، out1، 0 برگردان صحیح۶۴)، سیستم عامل.اندازه پرونده(out1)
        سرچاپ "cap too small"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "docs/mixed.bin"، out1، 1000 برگردان صحیح۶۴)، سیستم عامل.وجود دارد(out1)
        سرچاپ "cap exact"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "docs/flat.txt"، out1، 200000 برگردان صحیح۶۴)، سیستم عامل.اندازه پرونده(out1)
        سرچاپ "missing"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "nothing"، out1، 0 برگردان صحیح۶۴)
        out2 := cat(dir، "all")
        سیستم عامل.حذف همه(out2)
        سرچاپ "all"، بایگانی.استخراج همه از پرونده زیپ(zf، out2، 0 برگردان صحیح۶۴)، بایگانی.متن وضعیت زیپ(بایگانی.زیپ مسیر ناامن)
        p3 := cat(out2، "docs/flat.txt")
        p4 := cat(out2، "stored.bin")
        p5 := cat(dir، "escape.txt")
        سرچاپ سیستم عامل.اندازه پرونده(p3)، سیستم عامل.اندازه پرونده(p4)، سیستم عامل.وجود دارد(p5)
        بایگانی.بستن پرونده زیپ(zf)
        حافظه.آزادسازی(out1 برگردان تهی*)
        حافظه.آزادسازی(out2 برگردان تهی*)
        حافظه.آزادسازی(p3 برگردان تهی*)
        حافظه.آزادسازی(p4 برگردان تهی*)
        حافظه.آزادسازی(p5 برگردان تهی*)
    پایان

    ناپایا bad := فشرده سازی.کپی بافر(small)
    bp := bad.داده برگردان طبیعی۸*
    bp[200] = ((bp[200] برگردان صحیح) ^ 0x55) برگردان طبیعی۸
    path3 := cat(dir، "bad.zip")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(path3، bad)
    ناپایا zb := بایگانی.بازکردن پرونده زیپ(path3)
    out3 := cat(dir، "bad.out")
    سرچاپ "damaged"، بایگانی.استخراج از پرونده زیپ به پرونده(zb، "docs/mixed.bin"، out3، 0 برگردان صحیح۶۴) نابرابر بایگانی.زیپ موفق، سیستم عامل.وجود دارد(out3)
    بایگانی.بستن پرونده زیپ(zb)
    path4 := cat(dir، "none.zip")
    ناپایا zn := بایگانی.بازکردن پرونده زیپ(path4)
    سرچاپ "no file"، zn.وضعیت، بایگانی.متن وضعیت زیپ(zn.وضعیت)
    بایگانی.بستن پرونده زیپ(zn)

    سیستم عامل.حذف همه(dir)
    names.آزادکن()
    files.آزادکن()
    فشرده سازی.آزادسازی بافر(data)
    فشرده سازی.آزادسازی بافر(flat)
    فشرده سازی.آزادسازی بافر(small)
    فشرده سازی.آزادسازی بافر(wide)
    فشرده سازی.آزادسازی بافر(bad)
    حافظه.آزادسازی(dir برگردان تهی*)
    حافظه.آزادسازی(path1 برگردان تهی*)
    حافظه.آزادسازی(path2 برگردان تهی*)
    حافظه.آزادسازی(path3 برگردان تهی*)
    حافظه.آزادسازی(path4 برگردان تهی*)
    حافظه.آزادسازی(out3 برگردان تهی*)
    برگشت 0
پایان
