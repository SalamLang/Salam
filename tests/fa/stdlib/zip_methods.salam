پایا WORDS := ["salam"، "compress"، "zstd"، "lzma"، "archive"، "the"، "quick"، "brown"، "fox"، "jumps"، "over"، "lazy"، "dog"، "stream"، "block"، "index"]

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع lcg(x: صحیح۶۴): صحیح۶۴:
    برگشت (x * 1103515245 + 12345) & 0x7fffffff
پایان

تابع gen_text(n: صحیح، seed: صحیح۶۴): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید()
    ناپایا x := seed
    تکرار n:
        x = lcg(x)
        w := WORDS[((x >> 8) % 16) برگردان صحیح]
        فشرده سازی.افزودن بایت‌ها(out، w برگردان تهی*، w.طول())
        اگر ((x >> 4) & 7) برابر 0:
            فشرده سازی.افزودن بایت(out، 10)
        وگرنه:
            فشرده سازی.افزودن بایت(out، 32)
        پایان
    پایان
    برگشت out
پایان

تابع read_case(label: رشته، hex: رشته، dname: رشته، text: فشرده سازی.بافر بایت):
    z := unhex(hex)
    ناپایا checked := 0
    سرچاپ label، "verify"، بایگانی.بررسی زیپ(z.داده، z.طول، checked)، checked
    ناپایا es := بایگانی.فهرست زیپ(z.داده، z.طول)
    هر e در es:
        سرچاپ "  "، e.نام، e.روش، e.اندازه
    پایان
    بایگانی.آزادسازی فهرست(es)
    ناپایا st := 0
    d := بایگانی.استخراج تایید شده از زیپ(z.داده، z.طول، dname، 0، st)
    سرچاپ "  data"، st، فشرده سازی.برابری بافر(d، text)
    n := بایگانی.استخراج تایید شده از زیپ(z.داده، z.طول، "note.txt"، 0، st)
    سرچاپ "  note"، st، فشرده سازی.بافر به رشته(n).پیراست()
    ناپایا ok := نادرست
    u := بایگانی.استخراج با نام از زیپ(z.داده، z.طول، dname، ok)
    سرچاپ "  by name"، ok، فشرده سازی.برابری بافر(u، text)
پایان

تابع create_case(label: رشته، method: صحیح، level: صحیح، data: فشرده سازی.بافر بایت، hex: رشته):
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    ناپایا f1 := بایگانی.ساخت ورودی پرونده زیپ با سطح("a/data.bin"، data.داده، data.طول، method، level)
    f1.زمان تغییر = 1700000000 برگردان صحیح۶۴
    files.بیفزا(f1)
    note := فشرده سازی.بافر از رشته("hello zip methods\n")
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("note.txt"، note.داده، note.طول، method))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("empty.txt"، پوچ، 0، method))
    z := بایگانی.ساخت زیپ(files)
    ناپایا checked := 0
    ناپایا st := 0
    d := بایگانی.استخراج تایید شده از زیپ(z.داده، z.طول، "a/data.bin"، 0، st)
    ناپایا es := بایگانی.فهرست زیپ(z.داده، z.طول)
    سرچاپ label، level، بایگانی.بررسی زیپ(z.داده، z.طول، checked)، checked، st، فشرده سازی.برابری بافر(d، data)، es.بگیر(0).روش، es.بگیر(1).روش، es.بگیر(2).روش، z.طول کوچکتر data.طول
    بایگانی.آزادسازی فهرست(es)
    اگر hex.طول() بزرگتر 0:
        سرچاپ "  same bytes as the checked file"، فشرده سازی.برابری بافر(z، unhex(hex))
    پایان
پایان

تابع file_case(label: رشته، z: فشرده سازی.بافر بایت، dname: رشته، text: فشرده سازی.بافر بایت، root: رشته):
    path := مسیر پرونده.پیوند(root، label + ".zip")
    بایگانی.نوشتن پرونده دودویی از بافر(path، z)
    ناپایا zf := بایگانی.بازکردن پرونده زیپ(path)
    ناپایا es := بایگانی.مدخل های پرونده زیپ(zf)
    سرچاپ label، zf.وضعیت، zf.شمار، es.طول()
    بایگانی.آزادسازی فهرست(es)
    out := مسیر پرونده.پیوند(root، label + ".out")
    سرچاپ "  to file"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، dname، out، 0 برگردان صحیح۶۴)، read_same(out، text)
    سرچاپ "  capped"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، dname، out، 100 برگردان صحیح۶۴)
    dir := مسیر پرونده.پیوند(root، label)
    سرچاپ "  all"، بایگانی.استخراج همه از پرونده زیپ(zf، dir، 0 برگردان صحیح۶۴)، read_same(مسیر پرونده.پیوند(dir، dname)، text)
    بایگانی.بستن پرونده زیپ(zf)
پایان

تابع read_same(path: رشته، want: فشرده سازی.بافر بایت): منطقی:
    ناپایا ok := نادرست
    got := بایگانی.خواندن پرونده دودویی(path، ok)
    برگشت ok و فشرده سازی.برابری بافر(got، want)
پایان

تابع ریشه:
    text := gen_text(60، 3)

    سرچاپ "== zips made by other tools =="
    read_case("Info-ZIP bzip2"، Z_INFOZIP_BZ2، "a/data.txt"، text)
    read_case("7-Zip bzip2"، Z_7Z_BZ2، "a/data.txt"، text)
    read_case("7-Zip LZMA"، Z_7Z_LZMA، "a/data.txt"، text)
    read_case("Python bzip2"، Z_PY_BZ2، "a/data.txt"، text)
    read_case("Python LZMA"، Z_PY_LZMA، "a/data.txt"، text)
    read_case("Python zstd"، Z_PY_ZSTD، "a/data.txt"، text)

    سرچاپ "== zips made here =="
    create_case("stored"، 0، 0، text، "")
    create_case("deflate"، 8، 0، text، "")
    create_case("bzip2"، 12، 0، text، Z_OURS_12)
    create_case("lzma"، 14، 0، text، Z_OURS_14)
    create_case("zstd"، 93، 0، text، Z_OURS_93)
    create_case("bzip2"، 12، 1، text، "")
    create_case("lzma"، 14، 9، text، "")
    create_case("zstd"، 93، 19، text، "")
    create_case("zstd"، 93، 1، text، "")
    create_case("unknown method 99"، 99، 0، text، "")
    create_case("method 9 asked for"، 9، 0، text، "")
    big := gen_text(5000، 11)
    create_case("big bzip2"، 12، 0، big، "")
    create_case("big lzma"، 14، 0، big، "")
    create_case("big zstd"، 93، 0، big، "")
    سرچاپ "method codes"، بایگانی.روش زیپ ذخیره، بایگانی.روش زیپ دیفلیت، بایگانی.روش زیپ بی زیپ دو، بایگانی.روش زیپ الزد ام ای، بایگانی.روش زیپ زد استاندارد

    سرچاپ "== damage =="
    z := unhex(Z_OURS_14)
    ناپایا checked := 0
    ناپایا st := 0
    ناپایا k := 0
    ناپایا bad := 0
    تا k کوچکتر z.طول:
        ناپایا m := فشرده سازی.کپی بافر(z)
        فشرده سازی.تنظیم بایت(m، k، فشرده سازی.دریافت بایت(m، k) ^ 0x40)
        ناپایا es := بایگانی.فهرست زیپ(m.داده، m.طول)
        اگر es.طول() بزرگتر 0:
            r := بایگانی.بررسی زیپ(m.داده، m.طول، checked)
            اگر r نابرابر 0:
                bad++
            پایان
        پایان
        بایگانی.آزادسازی فهرست(es)
        k += 3
    پایان
    سرچاپ "lzma file, changed bytes caught:"، bad بزرگتر 20
    d := بایگانی.استخراج تایید شده از زیپ(unhex(Z_OURS_14).داده، 503، "a/data.bin"، 100، st)
    سرچاپ "limit 100"، st، d.طول
    d2 := بایگانی.استخراج تایید شده از زیپ(unhex(Z_OURS_93).داده، 536، "a/data.bin"، 100، st)
    سرچاپ "limit 100 zstd"، st، d2.طول
    d3 := بایگانی.استخراج تایید شده از زیپ(unhex(Z_OURS_12).داده، 541، "a/data.bin"، 100، st)
    سرچاپ "limit 100 bzip2"، st، d3.طول
    ناپایا zz := unhex(Z_OURS_93)
    فشرده سازی.تنظیم بایت(zz، 40، فشرده سازی.دریافت بایت(zz، 40) ^ 255)
    d4 := بایگانی.استخراج تایید شده از زیپ(zz.داده، zz.طول، "a/data.bin"، 0، st)
    سرچاپ "zstd data changed"، st، d4.طول
    ناپایا zb := unhex(Z_OURS_12)
    فشرده سازی.تنظیم بایت(zb، 60، فشرده سازی.دریافت بایت(zb، 60) ^ 255)
    d5 := بایگانی.استخراج تایید شده از زیپ(zb.داده، zb.طول، "a/data.bin"، 0، st)
    سرچاپ "bzip2 data changed"، st، d5.طول

    سرچاپ "== files on disk =="
    root := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_zip_methods_test")
    سیستم عامل.حذف همه(root)
    سیستم عامل.ساخت پوشه ها(root)
    file_case("bzip2"، unhex(Z_OURS_12)، "a/data.bin"، text، root)
    file_case("lzma"، unhex(Z_OURS_14)، "a/data.bin"، text، root)
    file_case("zstd"، unhex(Z_OURS_93)، "a/data.bin"، text، root)
    file_case("python lzma"، unhex(Z_PY_LZMA)، "a/data.txt"، text، root)
    سیستم عامل.حذف همه(root)
پایان
