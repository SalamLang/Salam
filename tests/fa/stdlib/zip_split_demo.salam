بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته

تابع cat(a: رشته، b: رشته): رشته:
    برگشت مسیر پرونده.پیوند(a، b)
پایان

تابع fill(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید با ظرفیت(n)
    ناپایا x := 12345 برگردان صحیح۶۴
    تکرار n در i:
        x = (x * (1103515245 برگردان صحیح۶۴) + (12345 برگردان صحیح۶۴)) & (0x7fffffff برگردان صحیح۶۴)
        فشرده سازی.افزودن بایت(b، i % 5 برابر 0 ? ((x >> (16 برگردان صحیح۶۴)) & (255 برگردان صحیح۶۴)) برگردان صحیح : 65 + (i % 7))
    پایان
    برگشت b
پایان

تابع count_parts(dir: رشته، prefix: رشته): صحیح:
    names := سیستم عامل.فهرست پوشه(dir)
    ناپایا n := 0
    هر nm در names:
        اگر رشته.شروع با(nm، prefix):
            n++
        پایان
        حافظه.آزادسازی(nm برگردان تهی*)
    پایان
    names.آزادکن()
    برگشت n
پایان

تابع check(first: رشته، dir: رشته، tag: رشته، data: فشرده سازی.بافر بایت):
    ناپایا zf := بایگانی.بازکردن پرونده زیپ(first)
    سرچاپ tag، "open"، zf.وضعیت، zf.شمار، zf.قطعه ها.طول()
    out := cat(dir، "two.out")
    سرچاپ tag، "two"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "two.bin"، out، 0 برگردان صحیح۶۴)، سیستم عامل.اندازه پرونده(out)
    ناپایا ok := نادرست
    ناپایا back := بایگانی.خواندن پرونده دودویی(out، ok)
    سرچاپ tag، ok، back.طول، فشرده سازی.چک جمع سی آر سی(back.داده، back.طول) برابر فشرده سازی.چک جمع سی آر سی(data.داده، 300000)
    فشرده سازی.آزادسازی بافر(back)
    all := cat(dir، "all")
    سیستم عامل.حذف همه(all)
    سرچاپ tag، "all"، بایگانی.استخراج همه از پرونده زیپ(zf، all، 0 برگردان صحیح۶۴)
    p := cat(all، "a/one.bin")
    سرچاپ tag، "one"، سیستم عامل.اندازه پرونده(p)
    حافظه.آزادسازی(p برگردان تهی*)
    حافظه.آزادسازی(all برگردان تهی*)
    حافظه.آزادسازی(out برگردان تهی*)
    بایگانی.بستن پرونده زیپ(zf)
پایان

تابع ریشه:
    dir := cat(سیستم عامل.پوشه موقت()، "salam_zip_split_demo_fa")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا data := fill(400000)
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("a/one.bin"، data.داده، data.طول، 8))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("two.bin"، data.داده، 300000، 0))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("three.bin"، data.داده، 200000، 8))
    d1 := cat(dir، "disk")
    d2 := cat(dir، "byte")
    سیستم عامل.ساخت پوشه ها(d1)
    سیستم عامل.ساخت پوشه ها(d2)
    p1 := cat(d1، "s.zip")
    p2 := cat(d2، "b.zip")
    سرچاپ "bad part size"، بایگانی.ساخت پرونده زیپ چندقطعه ای(files، p1، 1000 برگردان صحیح۶۴، بایگانی.زیپ قطعه دیسکی)
    سرچاپ "disk"، بایگانی.ساخت پرونده زیپ چندقطعه ای(files، p1، 100000 برگردان صحیح۶۴، بایگانی.زیپ قطعه دیسکی)
    سرچاپ "byte"، بایگانی.ساخت پرونده زیپ چندقطعه ای(files، p2، 100000 برگردان صحیح۶۴، بایگانی.زیپ قطعه بایتی)
    سرچاپ "parts"، count_parts(d1، "s.")، count_parts(d2، "b.")
    check(p1، dir، "disk"، data)
    p3 := cat(d1، "s.z02")
    check(p3، dir، "disk2"، data)
    p4 := cat(d2، "b.zip.001")
    check(p4، dir، "byte"، data)
    سیستم عامل.حذف(p3)
    ناپایا gone := بایگانی.بازکردن پرونده زیپ(p1)
    سرچاپ "missing part"، gone.وضعیت
    بایگانی.بستن پرونده زیپ(gone)
    سیستم عامل.حذف همه(dir)
    فشرده سازی.آزادسازی بافر(data)
    files.آزادکن()
    حافظه.آزادسازی(p1 برگردان تهی*)
    حافظه.آزادسازی(p2 برگردان تهی*)
    حافظه.آزادسازی(p3 برگردان تهی*)
    حافظه.آزادسازی(p4 برگردان تهی*)
    حافظه.آزادسازی(d1 برگردان تهی*)
    حافظه.آزادسازی(d2 برگردان تهی*)
    حافظه.آزادسازی(dir برگردان تهی*)
    برگشت 0
پایان
