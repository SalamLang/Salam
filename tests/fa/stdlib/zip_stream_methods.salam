بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع make(n: صحیح): فشرده سازی.بافر بایت:
    ناپایا out := فشرده سازی.بافر بایت جدید با ظرفیت(n + 16)
    ناپایا s := 777 برگردان صحیح۶۴
    ناپایا i := 0
    تا i کوچکتر n:
        s = (s * 1103515245 + 12345) & 0x7fffffff
        v := ((s >> 16) & 255) برگردان صحیح
        اگر (i / 4096) % 3 برابر 0:
            فشرده سازی.افزودن بایت(out، v)
            i++
        وگرنه:
            run := 1 + (v & 15)
            تکرار run:
                اگر i کوچکتر n:
                    فشرده سازی.افزودن بایت(out، 97 + (v & 7))
                    i++
                پایان
            پایان
        پایان
    پایان
    برگشت out
پایان

تابع same_file(a: رشته، b: رشته): منطقی:
    ناپایا ok1 := نادرست
    ناپایا ok2 := نادرست
    ناپایا x := بایگانی.خواندن پرونده دودویی(a، ok1)
    ناپایا y := بایگانی.خواندن پرونده دودویی(b، ok2)
    r := ok1 و ok2 و فشرده سازی.برابری بافر(x، y)
    فشرده سازی.آزادسازی بافر(x)
    فشرده سازی.آزادسازی بافر(y)
    برگشت r
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_zip_stream_methods_fa")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    ناپایا a := make(6000000)
    ناپایا b := make(300000)
    apath := مسیر پرونده.پیوند(dir، "a.bin")
    bpath := مسیر پرونده.پیوند(dir، "b.bin")
    بایگانی.نوشتن پرونده دودویی از بافر(apath، a)
    بایگانی.نوشتن پرونده دودویی از بافر(bpath، b)

    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ از مسیر("bz_disk.bin"، apath، بایگانی.روش زیپ بی زیپ دو، 1))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ از مسیر("zs_disk.bin"، apath، بایگانی.روش زیپ زد استاندارد، 3))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ از مسیر("lz_disk.bin"، apath، بایگانی.روش زیپ الزد ام ای، 1))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ با سطح("bz_mem.bin"، b.داده، b.طول، بایگانی.روش زیپ بی زیپ دو، 9))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ با سطح("zs_mem.bin"، b.داده، b.طول، بایگانی.روش زیپ زد استاندارد، 5))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ با سطح("lz_mem.bin"، b.داده، b.طول، بایگانی.روش زیپ الزد ام ای، 6))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ با سطح("empty.bin"، پوچ، 0، بایگانی.روش زیپ زد استاندارد، 3))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ رمزدار("bz_aes.bin"، b.داده، b.طول، بایگانی.روش زیپ بی زیپ دو، 9، "secret"، بایگانی.رمزگذاری زیپ ای ای اس۲۵۶))
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ رمزدار("zs_crypto.bin"، b.داده، b.طول، بایگانی.روش زیپ زد استاندارد، 3، "secret"، بایگانی.رمزگذاری زیپ کریپتو))
    zpath := مسیر پرونده.پیوند(dir، "out.zip")
    سرچاپ "create"، بایگانی.ساخت پرونده زیپ(files، zpath)
    سرچاپ "create64"، بایگانی.ساخت پرونده زیپ بزرگ(files، مسیر پرونده.پیوند(dir، "out64.zip"))
    files.آزادکن()

    هر variant در ["out.zip"، "out64.zip"]:
        ناپایا zf := بایگانی.بازکردن پرونده زیپ(مسیر پرونده.پیوند(dir، variant))
        بایگانی.تنظیم گذرواژه پرونده زیپ(zf، "secret")
        سرچاپ variant، "open"، zf.وضعیت
        ناپایا es := بایگانی.مدخل های پرونده زیپ(zf)
        هر e در es:
            dest := مسیر پرونده.پیوند(dir، "x_" + e.نام)
            st := بایگانی.استخراج از پرونده زیپ به پرونده(zf، e.نام، dest، 0 برگردان صحیح۶۴)
            ناپایا want := bpath
            اگر e.نام.زیررشته(3، 4) برابر "disk":
                want = apath
            پایان
            ok := e.نام برابر "empty.bin" ? سیستم عامل.اندازه پرونده(dest) برابر (0 برگردان صحیح۶۴) : same_file(dest، want)
            سرچاپ e.نام، e.روش، e.اندازه، st، ok
            سیستم عامل.حذف(dest)
            حافظه.آزادسازی(dest برگردان تهی*)
        پایان
        بایگانی.آزادسازی فهرست(es)
        بایگانی.بستن پرونده زیپ(zf)
    پایان
    سیستم عامل.حذف همه(dir)
    فشرده سازی.آزادسازی بافر(a)
    فشرده سازی.آزادسازی بافر(b)
پایان
