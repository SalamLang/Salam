بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

پایا FRAME := "28b52ffd640800ed0000b07a7374642073747265616d2074657374206c696e65200100de49cd265da8ba9c"

تابع cat(a: رشته، b: رشته): رشته:
    برگشت مسیر پرونده.پیوند(a، b)
پایان

تابع hexval(c: صحیح): صحیح:
    اگر c بزرگتربرابر 97:
        برگشت c - 87
    پایان
    برگشت c - 48
پایان

تابع from_hex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید با ظرفیت(s.طول() / 2)
    p := s برگردان طبیعی۸*
    ناپایا i := 0
    تا i + 1 کوچکتر s.طول():
        فشرده سازی.افزودن بایت(b، hexval(p[i] برگردان صحیح) * 16 + hexval(p[i + 1] برگردان صحیح))
        i += 2
    پایان
    برگشت b
پایان

تابع run_sink(path: رشته، cap: صحیح۶۴، label: رشته):
    fp := فشرده سازی.بازکردن پرونده برای خواندن(path)
    ناپایا sink := فشرده سازی.مقصد تابعی(cap، (_p: تهی*، _n: صحیح، _c: تهی*): برگشت درست پایان، پوچ)
    st := فشرده سازی.کدگشایی زستد از پرونده به مقصد(fp، 0 برگردان صحیح۶۴، فشرده سازی.اندازه پرونده(fp)، sink، 0 برگردان صحیح۶۴)
    سرچاپ label، st، sink.نوشته شده
    فشرده سازی.بستن پرونده(fp)
پایان

تابع crc_of(path: رشته): طبیعی۳۲:
    ناپایا ok := نادرست
    ناپایا b := بایگانی.خواندن پرونده دودویی(path، ok)
    c := فشرده سازی.چک جمع سی آر سی(b.داده، b.طول)
    فشرده سازی.آزادسازی بافر(b)
    برگشت c
پایان

تابع free_all(a: رشته، b: رشته، c: رشته، d: رشته، e: رشته، f: رشته، g: رشته، h: رشته، i: رشته، j: رشته، k: رشته):
    حافظه.آزادسازی(a برگردان تهی*)
    حافظه.آزادسازی(b برگردان تهی*)
    حافظه.آزادسازی(c برگردان تهی*)
    حافظه.آزادسازی(d برگردان تهی*)
    حافظه.آزادسازی(e برگردان تهی*)
    حافظه.آزادسازی(f برگردان تهی*)
    حافظه.آزادسازی(g برگردان تهی*)
    حافظه.آزادسازی(h برگردان تهی*)
    حافظه.آزادسازی(i برگردان تهی*)
    حافظه.آزادسازی(j برگردان تهی*)
    حافظه.آزادسازی(k برگردان تهی*)
پایان

تابع ریشه:
    root := cat(سیستم عامل.پوشه موقت()، "salam_zstd_stream_demo_fa")
    سیستم عامل.حذف همه(root)
    سیستم عامل.ساخت پوشه ها(root)
    ناپایا frame := from_hex(FRAME)
    f1 := cat(root، "frame.zst")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(f1، frame)
    run_sink(f1، 0 برگردان صحیح۶۴، "frame")
    run_sink(f1، 100 برگردان صحیح۶۴، "cap")
    (frame.داده برگردان طبیعی۸*)[frame.طول - 3] = 1 برگردان طبیعی۸
    f2 := cat(root، "bad.zst")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(f2، frame)
    run_sink(f2، 0 برگردان صحیح۶۴، "damaged")

    ناپایا big := فشرده سازی.بافر بایت جدید با ظرفیت(3000000)
    تکرار 3000000 در i:
        فشرده سازی.افزودن بایت(big، 65 + ((i % 4001) * (i % 977)) % 29)
    پایان
    raw := cat(root، "raw.bin")
    zst := cat(root، "raw.bin.zst")
    back := cat(root، "back.bin")
    سرچاپ بایگانی.نوشتن پرونده دودویی از بافر(raw، big)، بایگانی.فشرده سازی پرونده زستد(raw، zst)
    سرچاپ "file"، بایگانی.کدگشایی پرونده زستد با سقف(zst، back، 0 برگردان صحیح۶۴)، سیستم عامل.اندازه پرونده(back)، crc_of(back) برابر فشرده سازی.چک جمع سی آر سی(big.داده، big.طول)
    سرچاپ "file cap"، بایگانی.کدگشایی پرونده زستد با سقف(zst، back، 1000 برگردان صحیح۶۴)، سیستم عامل.وجود دارد(back)

    note := "hello zstd tar"
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("a.txt"، note برگردان تهی*، note.طول()، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("sub/big.bin"، big.داده، big.طول، نادرست))
    tzs := cat(root، "t.tar.zst")
    سرچاپ بایگانی.ساخت پرونده تار زستد(files، tzs)
    dir := cat(root، "x")
    سرچاپ "tar.zst"، بایگانی.استخراج همه از پرونده تار زستد(tzs، dir، 0 برگردان صحیح۶۴)
    p1 := cat(dir، "a.txt")
    p2 := cat(dir، "sub/big.bin")
    سرچاپ سیستم عامل.اندازه پرونده(p1)، سیستم عامل.اندازه پرونده(p2)، crc_of(p2) برابر فشرده سازی.چک جمع سی آر سی(big.داده، big.طول)
    ناپایا lst := 0
    ناپایا es := بایگانی.مدخل های پرونده تار فشرده(tzs، بایگانی.قالب تار زد استاندارد، lst)
    سرچاپ "list"، lst، es.طول()
    بایگانی.آزادسازی فهرست(es)

    ناپایا zin := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    zin.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("big.bin"، big.داده، big.طول، 93))
    zp := cat(root، "z.zip")
    سرچاپ "zip"، بایگانی.ساخت پرونده زیپ(zin، zp)
    ناپایا zf := بایگانی.بازکردن پرونده زیپ(zp)
    سرچاپ "zip zstd"، zf.وضعیت، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "big.bin"، back، 0 برگردان صحیح۶۴)، crc_of(back) برابر فشرده سازی.چک جمع سی آر سی(big.داده، big.طول)
    سرچاپ "zip cap"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "big.bin"، back، 1000 برگردان صحیح۶۴)
    بایگانی.بستن پرونده زیپ(zf)
    zin.آزادکن()
    files.آزادکن()
    فشرده سازی.آزادسازی بافر(big)
    فشرده سازی.آزادسازی بافر(frame)
    سیستم عامل.حذف همه(root)
    free_all(root، f1، f2، raw، zst، back، tzs، dir، p1، p2، zp)
    برگشت 0
پایان
