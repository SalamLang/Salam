تابع اولین منفی(اعداد: وکتور<صحیح>): صحیح:
    ناپایا یافته := 0 - 1
    تکرار اعداد.طول() در i:
        ترابرد اعداد.بگیر(i):
            0:
                گذر
            پایان
            < 0:
                یافته = i
                بشکن 2
            پایان
        پایان
    پایان
    برگشت یافته
پایان

تابع یافتن جفت(هدف: صحیح): رشته:
    ناپایا نتیجه := "none"
    تکرار 5 در i:
        تکرار 5 در j:
            اگر i * j == هدف:
                نتیجه = "" + i + "x" + j
                بشکن 2
            پایان
        پایان
    پایان
    برگشت نتیجه
پایان

تابع عمیق(): رشته:
    ناپایا رد := ""
    ناپایا k := 0
    تا k < 10:
        k++
        ترابرد k:
            3:
                ترابرد درست:
                    درست:
                        رد += "exit@3"
                        بشکن 3
                    پایان
                پایان
            پایان
            وگرنه:
                رد += "" + k + ","
            پایان
        پایان
    پایان
    برگشت رد
پایان

تابع اجرای تعویق‌ها(): رشته:
    تکرار 2 در i:
        دیرکن سرچاپ "outer defer"، i
        تکرار 3 در j:
            دیرکن سرچاپ "inner defer"، i، j
            اگر j == 1:
                بشکن 2
            پایان
        پایان
    پایان
    برگشت "done"
پایان

تابع ریشه:
    ناپایا اعداد := وکتور {} برگردان وکتور<صحیح>
    اعداد.بیفزا(3)
    اعداد.بیفزا(0)
    اعداد.بیفزا(-4)
    اعداد.بیفزا(-9)
    سرچاپ "first negative at"، اولین منفی(اعداد)
    سرچاپ "pair for 6:"، یافتن جفت(6)، "pair for 99:"، یافتن جفت(99)
    سرچاپ "deep:"، عمیق()
    سرچاپ اجرای تعویق‌ها()
    ناپایا n := 0
    تا درست:
        n++
        اگر n == 3:
            بشکن 1
        پایان
    پایان
    سرچاپ "break 1 stopped at"، n
پایان
