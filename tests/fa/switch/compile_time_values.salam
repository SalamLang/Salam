تابع خانواده معماری(): رشته:
    ترابرد سلام معماری:
        "x64"، "x86":
            برگشت "x86"
        پایان
        "arm64"، "arm":
            برگشت "arm"
        پایان
        "wasm":
            برگشت "wasm"
        پایان
        "riscv64":
            برگشت "riscv"
        پایان
    پایان
    برگشت "other"
پایان

تابع ریشه:
    سرچاپ "os known:"، سلام سیستم != ""
    سرچاپ "windows flag agrees:"، سلام سیستم ویندوز == (سلام سیستم == "windows")
    سرچاپ "mac flag agrees:"، سلام سیستم مک == (سلام سیستم == "mac")
    سرچاپ "linux flag agrees:"، سلام سیستم لینوکس == (سلام سیستم == "linux")
    خانواده := خانواده معماری()
    سرچاپ "arch family known:"، خانواده != "other"
    سیستم متداول := سلام سیستم یونیکس یا سلام سیستم ویندوز
    سرچاپ "unix or windows:"، سیستم متداول
    ناپایا شمار := 0
    تکرار 3 در i:
        اگر سلام سیستم ویندوز یا i >= 0:
            شمار++
        پایان
    پایان
    سرچاپ "runtime condition with a flag:"، شمار
پایان
