روال arch_family(): رشته:
    ترابرد SALAM_ARCH:
        "x64"، "x86":
            برگشت "x86"
        پایان
        "arm64"، "arm":
            برگشت "arm"
        پایان
        "wasm":
            برگشت "wasm"
        پایان
    پایان
    برگشت "other"
پایان

روال ریشه:
    سرچاپ "os known:"، SALAM_OS != ""
    سرچاپ "windows flag agrees:"، SALAM_OS_WINDOWS == (SALAM_OS == "windows")
    سرچاپ "mac flag agrees:"، SALAM_OS_MAC == (SALAM_OS == "mac")
    سرچاپ "linux flag agrees:"، SALAM_OS_LINUX == (SALAM_OS == "linux")
    family := arch_family()
    سرچاپ "arch family known:"، family != "other"
    unix_or_windows := SALAM_OS_UNIX یا SALAM_OS_WINDOWS
    سرچاپ "unix or windows:"، unix_or_windows
    ناپایا hits := 0
    تکرار 3 از i:
        اگر SALAM_OS_WINDOWS یا i >= 0:
            hits += 1
        پایان
    پایان
    سرچاپ "runtime condition with a flag:"، hits
پایان
