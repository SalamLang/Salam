تابع arch_family(): رشته:
    ترابرد سلام معماری:
        "x64"، "x86":
            برگشت "x86"
        پایان
        "arm64"، "arm":
            برگشت "arm"
        پایان
        "wasm":
            برگشت "wasm"
        پایان
    پایان
    برگشت "other"
پایان

تابع ریشه:
    سرچاپ "os known:"، سلام سیستم != ""
    سرچاپ "windows flag agrees:"، سلام سیستم ویندوز == (سلام سیستم == "windows")
    سرچاپ "mac flag agrees:"، سلام سیستم مک == (سلام سیستم == "mac")
    سرچاپ "linux flag agrees:"، سلام سیستم لینوکس == (سلام سیستم == "linux")
    family := arch_family()
    سرچاپ "arch family known:"، family != "other"
    unix_or_windows := سلام سیستم یونیکس یا سلام سیستم ویندوز
    سرچاپ "unix or windows:"، unix_or_windows
    ناپایا hits := 0
    تکرار 3 در i:
        اگر سلام سیستم ویندوز یا i >= 0:
            hits += 1
        پایان
    پایان
    سرچاپ "runtime condition with a flag:"، hits
پایان
