// lang: fa
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

پایا RED := 1
پایا GREEN := 2
پایا BLUE := 3
پایا BASE := 10
پایا NEXT := BASE + 1
پایا NEG := -1
پایا BIG := 5000000000 برگردان صحیح۶۴
پایا CMD_START := "start"
پایا CMD_HELP := "help"

جداشمار Shape:
    Circle، Square، Triangle
پایان

ساختار Config:
    همگانی admin: رشته = "ali"
پایان

روال color_name(c: صحیح): رشته:
    ترابرد c:
        RED:
            برگشت "red"
        پایان
        GREEN، BLUE:
            برگشت "green or blue"
        پایان
    پایان
    برگشت "unknown"
پایان

روال classify(x: صحیح): رشته:
    ترابرد x:
        NEG:
            برگشت "minus one"
        پایان
        BASE:
            برگشت "base"
        پایان
        NEXT:
            برگشت "next"
        پایان
        BASE + 2 تا BASE * 2:
            برگشت "teens"
        پایان
    پایان
    برگشت "other"
پایان

روال command(cmd: رشته): رشته:
    ترابرد cmd:
        CMD_START:
            برگشت "starting"
        پایان
        CMD_HELP:
            برگشت "helping"
        پایان
    پایان
    برگشت "unknown command"
پایان

روال sides(s: Shape): صحیح:
    ترابرد s:
        Shape.Circle:
            برگشت 0
        پایان
        Shape.Square:
            برگشت 4
        پایان
        Shape.Triangle:
            برگشت 3
        پایان
    پایان
    برگشت 0 - 1
پایان

روال describe(n: صحیح): رشته:
    ترابرد n:
        1:
            پایا LABEL := "one"
            برگشت LABEL
        پایان
        2:
            پایا LABEL := "two"
            برگشت LABEL
        پایان
    پایان
    برگشت "many"
پایان

روال ریشه:
    سرچاپ color_name(1)، color_name(3)، color_name(9)
    سرچاپ classify(-1)، classify(10)، classify(11)، classify(15)، classify(50)
    سرچاپ command("help")، command("start")، command("stop")
    big := 5000000000 برگردان صحیح۶۴
    ترابرد big:
        BIG:
            سرچاپ "big matched"
            بشکن
        پایان
    پایان
    سرچاپ sides(Shape.Circle)، sides(Shape.Square)، sides(Shape.Triangle)
    owner := "ali"
    limit := 3
    cfg := Config {}
    who := "ali"
    ترابرد who:
        owner:
            سرچاپ "matched a local"
            بشکن
        پایان
    پایان
    ترابرد limit:
        3:
            سرچاپ "matched a literal"
            بشکن
        پایان
    پایان
    ترابرد who:
        cfg.admin:
            سرچاپ "matched a field"
            بشکن
        پایان
    پایان
    سرچاپ describe(1)، describe(2)، describe(3)
پایان
