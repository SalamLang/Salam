 *
 */

جداشمار شکل:
    دایره، مربع، مثلث
پایان

گونه پیکره = شکل

تابع شمار ضلع(s: شکل): صحیح:
    ترابرد s:
        شکل.دایره:
            برگشت 0
        پایان
        شکل.مربع:
            برگشت 4
        پایان
        شکل.مثلث:
            برگشت 3
        پایان
    پایان
    برگشت 0 - 1
پایان

تابع گردی(f: پیکره): منطقی:
    ترابرد f:
        پیکره.دایره:
            برگشت درست
        پایان
        شکل.مربع، پیکره.مثلث:
            برگشت نادرست
        پایان
    پایان
    برگشت نادرست
پایان

تابع برچسب(s: شکل): رشته:
    ترابرد s:
        شکل.دایره:
            برگشت "circle"
        پایان
        وگرنه:
            برگشت "polygon"
        پایان
    پایان
    برگشت "?"
پایان

تابع ریشه:
    سرچاپ شمار ضلع(شکل.دایره)، شمار ضلع(شکل.مربع)، شمار ضلع(پیکره.مثلث)
    سرچاپ گردی(پیکره.دایره)، گردی(شکل.مربع)
    سرچاپ برچسب(شکل.دایره)، برچسب(پیکره.مثلث)
پایان
