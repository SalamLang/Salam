جداشمار Shape:
    Circle، Square، Triangle
پایان

گونه Figure = Shape

روال sides(s: Shape): صحیح:
    ترابرد s:
        Shape.Circle:
            برگشت 0
        پایان
        Shape.Square:
            برگشت 4
        پایان
        Shape.Triangle:
            برگشت 3
        پایان
    پایان
    برگشت 0 - 1
پایان

روال round(f: Figure): منطقی:
    ترابرد f:
        Figure.Circle:
            برگشت درست
        پایان
        Shape.Square، Figure.Triangle:
            برگشت نادرست
        پایان
    پایان
    برگشت نادرست
پایان

روال label(s: Shape): رشته:
    ترابرد s:
        Shape.Circle:
            برگشت "circle"
        پایان
        وگرنه:
            برگشت "polygon"
        پایان
    پایان
    برگشت "?"
پایان

روال ریشه:
    سرچاپ sides(Shape.Circle)، sides(Shape.Square)، sides(Figure.Triangle)
    سرچاپ round(Figure.Circle)، round(Shape.Square)
    سرچاپ label(Shape.Circle)، label(Figure.Triangle)
پایان
