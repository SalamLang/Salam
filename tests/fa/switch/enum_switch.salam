جداشمار رنگ:
    قرمز، سبز، آبی
پایان

تابع ریشه:
    c := رنگ.سبز
    ترابرد c:
        قرمز:
            سرچاپ "warm"
        پایان
        سبز، آبی:
            سرچاپ "cool"
            بشکن
        پایان
    پایان
پایان
