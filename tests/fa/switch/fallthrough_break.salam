روال ریشه:
    x := 2
    ترابرد x:
        1:
            سرچاپ "one"
        پایان
        2، 3:
            سرچاپ "two or three"
            بشکن
        پایان
        4:
            سرچاپ "four (unreachable: prior case broke)"
        پایان
        وگرنه:
            سرچاپ "other"
        پایان
    پایان

    // no break: execution falls through every case from the first match onward
    ترابرد 1:
        1:
            سرچاپ "fall-a"
        پایان
        2:
            سرچاپ "fall-b"
        پایان
        وگرنه:
            سرچاپ "fall-c"
        پایان
    پایان
پایان
