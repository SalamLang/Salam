تابع ریشه:
    ناپایا count := 0
    تا count کوچکتر 5:
        count++
        ترابرد count:
            2:
                گذر
            پایان
            4:
                بشکن
            پایان
            وگرنه:
                سرچاپ "count"، count
            پایان
        پایان
        سرچاپ "after-switch"، count
    پایان
    سرچاپ "final"، count
پایان
