روال ریشه:
    ناپایا count := 0
    تا count < 5:
        count += 1
        ترابرد count:
            2:
                گذر
            پایان
            4:
                بشکن
            پایان
            وگرنه:
                سرچاپ "count"، count
            پایان
        پایان
        سرچاپ "after-switch"، count
    پایان
    سرچاپ "final"، count
پایان
