روال ریشه:
    ناپایا i := 1
    تا i <= 7:
        ترابرد i:
            1، 2، 3، 4، 5:
                سرچاپ i، "weekday"
                بشکن
            پایان
            6، 7:
                سرچاپ i، "weekend"
            پایان
        پایان
        i += 1
    پایان
پایان
