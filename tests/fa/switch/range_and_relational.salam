تابع ریشه:
    ترابرد 5:
        1 تا 4:
            سرچاپ "low"
        پایان
        5 تا 9:
            سرچاپ "mid"
            بشکن
        پایان
        وگرنه:
            سرچاپ "high"
        پایان
    پایان

    ترابرد 20:
        بزرگتر 10:
            سرچاپ "big"
            بشکن
        پایان
        وگرنه:
            سرچاپ "small"
        پایان
    پایان

    ترابرد 3:
        کوچکتر 0:
            سرچاپ "negative"
        پایان
        نابرابر 3:
            سرچاپ "not three"
        پایان
        وگرنه:
            سرچاپ "exactly three"
        پایان
    پایان
پایان
