روال ریشه:
    name := "b"
    ترابرد name:
        "a":
            سرچاپ "letter a"
        پایان
        "b":
            سرچاپ "letter b"
            بشکن
        پایان
        "c":
            سرچاپ "letter c"
        پایان
    پایان

    ترابرد "zeta":
        "alpha" تا "mike":
            سرچاپ "early alphabet"
        پایان
        وگرنه:
            سرچاپ "late alphabet"
        پایان
    پایان
پایان
