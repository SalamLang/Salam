روال classify(n: اندازه): رشته:
    ترابرد n:
        0:
            برگشت "zero"
        پایان
        1، 2:
            برگشت "small"
        پایان
        3 تا 9:
            برگشت "digit"
        پایان
        >= 1000:
            برگشت "huge"
        پایان
        وگرنه:
            برگشت "other"
        پایان
    پایان
پایان

روال ریشه:
    سرچاپ classify(0 برگردان اندازه)
    سرچاپ classify(2 برگردان اندازه)
    سرچاپ classify(7 برگردان اندازه)
    سرچاپ classify(50 برگردان اندازه)
    سرچاپ classify((0 برگردان اندازه) - (1 برگردان اندازه))
    u := 200 برگردان طبیعی۸
    ترابرد u:
        200:
            سرچاپ "u8 ok"
            بشکن
        پایان
        وگرنه:
            سرچاپ "u8 bad"
        پایان
    پایان
    w := 5 برگردان طبیعی۶۴
    ترابرد w:
        5:
            سرچاپ "u64 ok"
        پایان
    پایان
پایان
