صفحه:
    عنوان = "سراسری"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, sans-serif" فضا = "1rem" پایان
    سراسری: گزینشگر = "button" فاصله = "4px 12px" گردی کادر = 6px پایان
    سراسری: گزینشگر = ".note" رنگ = "#555" پایان
    سراسری: گزینشگر = ".note span" رنگ = قرمز پایان
    جعبه:
        کلاس = "note"
        دکمه: محتوا = "الف" پایان
        دکمه: محتوا = "ب" پایان
