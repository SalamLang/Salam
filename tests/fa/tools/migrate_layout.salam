صفحه:
    عنوان = "چیدمان"
    سراسری: گزینشگر = ".card" نمایش = فلکس جهت فلکس = ستونی چینش = "فاصله میان" ترازعمودی = وسط شکاف = 12 پایان
    جعبه:
        کلاس = "card"
        نمایش = فلکس
        فضا = "8px 16px"
        گردی کادر = 8px
        سایه کادر = "0 4px 8px rgba(0, 0, 0, 0.25)"
        خانواده قلم = "Tahoma, sans-serif"
        محتوا = "سلام"
    پایان
پایان
