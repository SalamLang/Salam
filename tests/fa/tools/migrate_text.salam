page:
    title = "متن"
    box: position = relative z index = 3 text align = end white space = nowrap flex wrap = wrap flex = "1 1 auto" transition = "opacity 0.2s ease" end
    box: box sizing = "border-box" cursor = pointer color = "#333" font style = italic text decoration = line-through end
    box: background = "var(--bg)" font size = "clamp(1rem, 4vw, 2rem)" display = flex end
end
