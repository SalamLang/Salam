واردسازی حافظه

پیوند پویا "m"

درون‌داد:
    روال cos(x: اعشار۶۴): اعشار۶۴
پایان

ناپایا g_cell := پوچ برگردان صحیح۶۴*

روال work():
    اتمی‌بیفزا(g_cell، 1 برگردان صحیح۶۴)
پایان

روال ریشه:
    g_cell = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    xs := [1، 2، 3]
    سرچاپ طول(xs)، اندازه‌گونه(صحیح۶۴)، طول("ab")
    سرچاپ مقایسه‌رشته("a"، "a")، کدنویسه("A")، نویسه‌ازکد(66)
    سرچاپ زبان() نابرابر ""، متغیر‌محیطی("SALAM_NOPE") برابر ""، آرگومان‌ها().طول() بزرگتر 0
    اگر سلام سیستم ویندوز:
        سرچاپ "win"
    وگرنه:
        سرچاپ "other"
    پایان
    اگر تعریف‌شده(سلام سیستم لینوکس) یا وارونه تعریف‌شده(سلام سیستم لینوکس):
        سرچاپ "def"
    پایان
    سرچاپ سلام ایمن یا وارونه سلام ایمن
    سرچاپ سلام معماری ایکس۶۴ یا وارونه سلام معماری ایکس۶۴، طول(سلام نگارش) بزرگتر 0
    t := نخ‌ساز(work)
    نخ‌پیوند(t)
    سرچاپ اتمی‌بخوان(g_cell)، cos(0.0)، درهم("x") بزرگتر (0 برگردان طبیعی۶۴)
    حافظه.آزادسازی(g_cell برگردان تهی*)
پایان
