بسته ریشه

واردسازی ماتریس

ساختار شبکه:
    همگانی خانه‌ها: وکتور<صحیح>
    همگانی م: ماتریس.ماتریس

    همگانی تابع بستن کار():
        این.خانه‌ها.آزادسازی()
        این.م.آزادسازی()
    پایان
پایان

تابع رد(م: ماتریس.ماتریس): اعشار۶۴:
    برگشت م.عنصر(0، 0) + م.عنصر(1، 1)
پایان

تابع رها کن(م: ماتریس.ماتریس):
    ناپایا مال := م
    مال.آزادسازی()
پایان

تابع ریشه:
    ناپایا فهرست := وکتور {} برگردان وکتور<صحیح>
    فهرست.رزرو(8)
    فهرست.صفرها(3)
    فهرست.بنشان(1، 7)
    فهرست.افزودن(9)
    سرچاپ فهرست.دریافت(1)، فهرست.طول()، فهرست.خالی است()
    فهرست.پاک‌سازی()
    سرچاپ فهرست.طول()، فهرست.خالی است()
    فهرست.آزادکن()
    ناپایا ن := نگاشت {} برگردان نگاشت<رشته، صحیح>
    ن.درج("a"، 1)
    سرچاپ ن.دریافت با پیش فرض("a"، 0)، ن.دریافت با پیش فرض("b"، 5)، ن.اندازه()
    ن.آزادسازی()
    س := "Salam"
    سرچاپ س.کوچک()، س.بزرگ()، س.تکرار(2)
    ناپایا جمع := 0
    هر ب در س.بایت ها():
        جمع += ب برگردان صحیح
    پایان
    سرچاپ جمع
    ناپایا ما := ماتریس.صفرها(2، 2)
    ما.تنظیم(0، 0، 1.5)
    ما.تنظیم(1، 1، 2.5)
    سرچاپ رد(ما)
    ناپایا ش := شبکه { خانه‌ها = وکتور {} برگردان وکتور<صحیح>، م = ماتریس.صفرها(1، 1) }
    ش.خانه‌ها.بیفزا(4)
    سرچاپ ش.خانه‌ها.طول()، ش.م.عنصر(0، 0)
    ش.بستن کار()
    رها کن(ما)
پایان
