بسته ریشه

واردسازی ماتریس

ساختار کیسه:
    همگانی اقلام: صحیح = 0

    همگانی تابع پاک‌سازی(): صحیح:
        برگشت این.اقلام - این.اقلام
    پایان

    همگانی تابع عنصر(ی: صحیح): صحیح:
        برگشت این.اقلام + ی
    پایان
پایان

تابع کیسه خالی(و2: کیسه): صحیح:
    برگشت و2.پاک‌سازی() + و2.عنصر(1)
پایان

تابع عنصر کیسه(م: کیسه): صحیح:
    برگشت م.عنصر(2)
پایان

تابع ماتریس‌ها():
    ناپایا م := ماتریس.صفرها(2، 2)
    م.تنظیم(0، 0، 2.5)
    مال := م // همان ماتریس
    سرچاپ مال.عنصر(0، 0)
    مال.آزادسازی()
پایان

تابع بردارها():
    ناپایا و2 := وکتور {} برگردان وکتور<صحیح>
    و2.افزودن(1)
    و2.درج(0، 5)
    سرچاپ و2.دریافت(0)، و2.طول()
    ناپایا دیگری := و2
    دیگری.پاک‌سازی()
    سرچاپ دیگری.طول()
    دیگری.آزادسازی()
    ناپایا ن := نگاشت {} برگردان نگاشت<رشته، صحیح>
    ن.قراردادن("a"، 1)
    ن.درج("b"، 2)
    سرچاپ ن.دریافت("a")، ن.دریافت("b")، ن.اندازه()
    ن.آزادسازی()
پایان

تابع ریشه:
    سرچاپ کیسه خالی(کیسه { اقلام = 3 })، عنصر کیسه(کیسه { اقلام = 4 })
    ک := کیسه { اقلام = 7 }
    همزاد := ک.رونوشت()
    سرچاپ همزاد.عنصر(0)
    ماتریس‌ها()
    بردارها()
پایان
