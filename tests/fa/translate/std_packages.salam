واردسازی رشته
واردسازی تبدیل
واردسازی کدگذاری.جیسون
واردسازی شبکه.اچ تی تی پی ساده
واردسازی دیتابیس
واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    سرچاپ جیسون.معتبر(`{"a":[1,2]}`)، جیسون.دریافت مسیر(`{"a":[1,2]}`، "a.1")
    نقطه := اچ تی تی پی ساده.تجزیه نقطه پایانی("https://example.com:9243/x")
    سرچاپ نقطه.host، نقطه.port، نقطه.secure
    سرچاپ دیتابیس.الستیک سرچ، رشته.از عدد(طول("salam") برگردان صحیح۶۴)، تبدیل.قالب منطقی(درست)
    درخواست := الستیک سرچ.درخواست جستجو { size = 2، query = الستیک سرچ.تطبیق همه() }
    سرچاپ الستیک سرچ.بدنه جستجو(درخواست)
    تجمیع‌ها := `{"n":{"value":7.5}}`
    سرچاپ الستیک سرچ.مقدار تجمیع در(تجمیع‌ها، "n")
    نتیجه := الستیک سرچ.تجزیه نتیجه جستجو(`{"took":1,"hits":{"total":{"value":2,"relation":"eq"},"hits":[{"_id":"a"},{"_id":"b"}]}}`)
    سرچاپ نتیجه.total، نتیجه.hits.طول()، نتیجه.hits.بگیر(1).id
    سرچاپ الستیک سرچ.کدگشایی شناسه ابری("x:" + "aG9zdC5leGFtcGxlLmNvbTo5MjQzJGVzMSRraWI=")
    سرچاپ کدنویسه("A")
پایان
