اگر سلام سیستم ویندوز:
    درون‌داد:
        تابع GetModuleHandleA(name: رشته): تهی*
        تابع GetProcAddress(mod: تهی*، name: رشته): تهی*
    پایان

    تابع lookup(name: رشته): تهی*:
        برگشت GetProcAddress(GetModuleHandleA("kernel32.dll")، name)
    پایان
وگرنه:
    برون‌داد:
        تابع sfp_muldiv(a: صحیح، b: صحیح، c: صحیح): صحیح:
            برگشت a * b / c
        پایان

        تابع sfp_sleep(ms: صحیح):
            _ms := ms
        پایان
    پایان

    تابع lookup(name: رشته): تهی*:
        اگر name برابر "MulDiv":
            برگشت &sfp_muldiv
        پایان
        برگشت &sfp_sleep
    پایان
پایان

تابع work(n: صحیح، seed: صحیح، md: درون‌داد فراخوان استاندارد تابع (صحیح، صحیح، صحیح) صحیح، nap: درون‌داد فراخوان استاندارد تابع (صحیح)): صحیح:
    ناپایا a := seed
    ناپایا b := seed * 3 + 1
    ناپایا c := seed * 7 + 2
    تکرار n در i:
        nap(0)
        a = a + md(i، 6، 3)
        b = b ^ (a + i)
        c = c + b % 13
    پایان
    برگشت a + b + c
پایان

تابع ریشه:
    md := lookup("MulDiv") برگردان درون‌داد فراخوان استاندارد تابع (صحیح، صحیح، صحیح) صحیح
    nap := lookup("Sleep") برگردان درون‌داد فراخوان‌استاندارد تابع (صحیح)
    ناپایا total := 0
    ناپایا check := 0
    تکرار 20 در k:
        total = total + work(50، k، md، nap) % 1000
        check = check + md(k + 1، 10، 5)
    پایان
    سرچاپ "total"، total، "check"، check
    برگشت 0
پایان
