صفحه کارت(ن: صحیح):
    طراحی = "شد سی ان"
    جعبه:
        محتوا = «کارت » + ن
        سایه = [۰، ۴، ۸، سیاه]، [۰، ۱، ۲، قرمز]
        تاری پشت = ۴
        نشانگر = اشاره
        وزن قلم = بسیار پررنگ
        اشاره رنگ = آبی
    پایان
پایان

تابع ریشه:
    سرچاپ کارت(۱)
پایان
