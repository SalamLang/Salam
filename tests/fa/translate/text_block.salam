پایا اندازه := 64

تابع ریشه:
    درستی := درست
    عدد := 5
    م := ```
        // زبان: C
        int size = ${{ اندازه }};
        int twice = ${{ عدد * 2 }};
        int both = ${{ درستی و عدد > 3 }};
        ```
    سرچاپ م
پایان
