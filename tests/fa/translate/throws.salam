تابع parse port(text: رشته): صحیح خطادار:
    اگر text برابر "":
        پرتاب خطا خطا.جدید(نوع خطا.آرگومان نامعتبر، "empty port")
    پایان
    n := text.به صحیح()
    اگر n بزرگتر 65535:
        پرتاب خطا خطا.در جایگاه(نوع خطا.خارج از بازه، "port too large"، 0).با کد("port.range")
    پایان
    برگشت n
پایان

تابع ریشه:
    هر text در ["80"، ""، "70000"]:
        تلاش:
            سرچاپ parse port(text)
        گرفتن خطا e:
            سرچاپ e.پیام، e.کد، e.است(نوع خطا.خارج از بازه)
            سرچاپ e.بپیچ("reading the config").به رشته()
        پایان
    پایان
    made := خطا.جدید(نوع خطا.یافت نشد، "no such file")
    placed := made.با موقعیت(4، 2، 3)
    سرچاپ placed.خط، placed.ستون، placed.نام نوع()
    port := تلاش parse port("") گرفتن خطا 8080
    سرچاپ port
پایان
