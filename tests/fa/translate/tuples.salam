ساختار جعبه:
    همگانی جا: (صحیح، صحیح)
    همگانی برچسب: رشته
پایان

تابع تقسیم(الف: صحیح، ب: صحیح): (صحیح، صحیح):
    برگشت الف / ب، الف % ب
پایان

تابع جفت(): (صحیح، رشته):
    برگشت ۷، "هفت"
پایان

تابع تودرتو(): ((صحیح، صحیح)، رشته):
    برگشت (۱، ۲)، "ن"
پایان

تابع ریشه:
    خارج، باقی := تقسیم(۱۷، ۵)
    سرچاپ خارج، باقی
    عدد، نام := جفت()
    سرچاپ عدد، نام
    ت := تقسیم(۹، ۴)
    سرچاپ ت.۰، ت.۱
    ایکس، _ := تقسیم(۱۰۰، ۷)
    سرچاپ ایکس
    ناپایا پ، ناپایا ز := تقسیم(۳، ۲)
    پ += ۱۰
    ز += ۲۰
    سرچاپ پ، ز
    ناپایا الف := ۱
    ناپایا ب := ۲
    الف، ب = ب، الف
    سرچاپ الف، ب
    تو := تودرتو()
    سرچاپ تو.۰.۱، تو.۱
    ج := جعبه { جا = (۳، ۴)، برچسب = "جعبه" }
    سرچاپ ج.جا.۰، ج.برچسب
    ناپایا فهرست := وکتور {} برگردان وکتور<(صحیح، رشته)>
    فهرست.بیفزا((۱، "الف"))
    فهرست.بیفزا((۲، "ب"))
    هر ک، آیتم در فهرست:
        شماره، واژه := آیتم
        سرچاپ ک، شماره، واژه
    پایان
پایان
