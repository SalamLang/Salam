بسته ریشه

میانجی دارای‌مقدار:
    تابع مقدار(): صحیح
پایان

ساختار جعبه:
    همگانی v: صحیح = 0

    همگانی تابع مقدار(): صحیح:
        برگشت این.v
    پایان

    همگانی تابع طول(): صحیح:
        برگشت این.v + 1
    پایان

    همگانی تابع دو چندان(): صحیح:
        برگشت این.مقدار() * 2
    پایان
پایان

تابع نمایش(x: پویا دارای‌مقدار):
    سرچاپ x.مقدار()
پایان

همگانی تابع آزادکن(n: صحیح): صحیح:
    برگشت n + 1
پایان

تابع ریشه:
    b := جعبه { v = 3 }
    سرچاپ b.مقدار()
    سرچاپ b.طول()
    سرچاپ b.دو چندان()
    ناپایا items := وکتور {} برگردان وکتور<صحیح>
    items.بیفزا(1)
    سرچاپ items.طول()
    items.آزادکن()
    text := "abc"
    سرچاپ text.طول()
    سرچاپ آزادکن(1)
    نمایش(b برگردان پویا دارای‌مقدار)
پایان
