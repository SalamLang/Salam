صفحه برگه(نام: رشته):
    جعبه:
        فاصله = ۸، ۱۶
        کادر = ۲، یکپارچه، #3366aa
        عرض = ۵۰٪
        محتوا = "سلام " + نام
    پایان
پایان

تابع ریشه:
    سرچاپ برگه("سارا")
    سرچاپ ۲۵٪ + 0.5، #fff
پایان
