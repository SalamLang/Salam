ساختار نقطه:
    همگانی ایکس: صحیح = ۰
    همگانی ایگرگ: صحیح = ۰
پایان

تابع یکسان(الف: صحیح[۳]، ب: صحیح[۳]): منطقی:
    برگشت الف == ب
پایان

تابع ریشه:
    نمره‌ها := [۱۲، ۱۵، ۱۸، ۲۰]
    کپی := [۱۲، ۱۵، ۱۸، ۲۰]
    ناپایا تازه := [۱۲، ۱۵، ۱۸، ۲۰]
    تازه[۳] = ۹
    سرچاپ نمره‌ها == کپی، نمره‌ها != کپی، نمره‌ها برابر تازه، نمره‌ها نابرابر تازه
    جدول := [[۱، ۲]، [۳، ۴]]
    دیگر := [[۱، ۲]، [۳، ۵]]
    سرچاپ جدول == جدول، جدول == دیگر
    نقطه‌ها := [نقطه { ایکس = ۱ }، نقطه { ایگرگ = ۲ }]
    همان := [نقطه { ایکس = ۱ }، نقطه { ایگرگ = ۲ }]
    سرچاپ نقطه‌ها == همان
    نام‌ها := ["علی"، "سارا"]
    سرچاپ نام‌ها == ["علی"، "سارا"]، نام‌ها == ["علی"، "رضا"]
    سرچاپ یکسان([۱، ۲، ۳]، [۱، ۲، ۳])
پایان
