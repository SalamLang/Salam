ساختار حساب:
    همگانی موجودی: صحیح = 0
    همگانی کارکرد واریز(مبلغ: صحیح): این.موجودی = این.موجودی + مبلغ پایان
    همگانی کارکرد برداشت(مبلغ: صحیح):
        اگر مبلغ <= این.موجودی: این.موجودی = این.موجودی - مبلغ
        وگرنه:
            چاپ "موجودی کافی نیست"
        پایان
    پایان
پایان

کارکرد آغازین:
    گذرا ح := حساب { موجودی = 100 }
    ح.واریز(50)
    ح.برداشت(30)
    ح.برداشت(200)
    چاپ "موجودی =", ح.موجودی
پایان
