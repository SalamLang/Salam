میانجی شکل:
    تابع مساحت(): صحیح
    تابع نام(): رشته
پایان

ساختار مربع:
    همگانی ضلع: صحیح = ۰
    همگانی تابع مساحت(): صحیح: برگشت این.ضلع * این.ضلع پایان
    همگانی تابع نام(): رشته: برگشت "مربع" پایان
پایان

ساختار مستطیل:
    همگانی پهنا: صحیح = ۰
    همگانی بلندی: صحیح = ۰
    همگانی تابع مساحت(): صحیح: برگشت این.پهنا * این.بلندی پایان
    همگانی تابع نام(): رشته: برگشت "مستطیل" پایان
پایان

تابع توصیف(ش: پویا شکل):
    سرچاپ ش.نام()، ش.مساحت()
پایان

تابع بزرگ‌ترین(الف: پویا شکل، ب: پویا شکل): پویا شکل:
    اگر الف.مساحت() > ب.مساحت():
        برگشت الف
    پایان
    برگشت ب
پایان

تابع ریشه:
    شکل‌ها := [مربع { ضلع = ۳ }، مستطیل { پهنا = ۲، بلندی = ۵ }] برگردان پویا شکل[۲]
    هر ش در شکل‌ها:
        توصیف(ش)
    پایان
    ناپایا فهرست := وکتور {} برگردان وکتور<پویا شکل>
    دیرکن فهرست.آزادکن()
    فهرست.بیفزا(مربع { ضلع = ۴ })
    فهرست.بیفزا(مستطیل { پهنا = ۱، بلندی = ۷ })
    سرچاپ فهرست.طول()
    توصیف(بزرگ‌ترین(فهرست.بگیر(۰)، فهرست.بگیر(۱)))
پایان
