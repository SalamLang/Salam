واردسازی نتیجه

جداشمار رنگ:
    @en "Red"
    @fa "سرخ"
    قرمز
    سبز
پایان

تابع عدد(م: رشته): نتیجه.نتیجه<صحیح، رشته>:
    اگر م == "۷":
        برگشت نتیجه.نتیجه.موفق(۷)
    پایان
    برگشت نتیجه.نتیجه.خطا("نامعتبر: " + م)
پایان

تابع جمع(الف: رشته، ب: رشته): نتیجه.نتیجه<صحیح، رشته>:
    ا := عدد(الف)?
    ب۲ := عدد(ب)?
    برگشت نتیجه.نتیجه.موفق(ا + ب۲)
پایان

تابع شرح(ن: نتیجه.نتیجه<صحیح، رشته>): رشته:
    برگشت همخوان ن:
        موفق(م): "درست: " + م پایان
        خطا(خ): "خطا: " + خ پایان
    پایان
پایان

تابع ریشه:
    سرچاپ شرح(جمع("۷"، "۷"))
    سرچاپ شرح(جمع("۷"، "x"))
    سرچاپ نتیجه.موفق است(عدد("۷"))، نتیجه.با پیش فرض(عدد("x")، ۰)
    سرچاپ عدد("۷")
    ر := رنگ.سرخ
    سرچاپ ر برگردان صحیح، ر == رنگ.قرمز
    م := همخوان ر:
        سرخ: "س" پایان
        سبز: "ب" پایان
    پایان
    سرچاپ م
    ترابرد ر:
        سرخ:
            سرچاپ "سرخ است"
        پایان
        وگرنه:
            سرچاپ "?"
        پایان
    پایان
پایان
