جداشمار رنگ:
    @en "Red"
    @fa "سرخ"
    قرمز
    سبز
پایان

تابع ریشه:
    ر := رنگ.سرخ
    سرچاپ ر برگردان صحیح، ر برابر رنگ.قرمز
    م := همخوان ر:
        سرخ: "س" پایان
        سبز: "ب" پایان
    پایان
    سرچاپ م
    ترابرد ر:
        سرخ:
            سرچاپ "سرخ است"
        پایان
        وگرنه:
            سرچاپ "?"
        پایان
    پایان
پایان
