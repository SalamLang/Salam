میانجی شکل:
    روال مساحت(): صحیح
    روال نام(): رشته
پایان
ساختار مربع:
    ضلع: صحیح = 0
    همگانی روال مساحت(): صحیح: برگشت این.ضلع * این.ضلع پایان
    همگانی روال نام(): رشته: برگشت "مربع" پایان
پایان
ساختار مستطیل:
    طول: صحیح = 0
    عرض: صحیح = 0
    همگانی روال مساحت(): صحیح: برگشت این.طول * این.عرض پایان
    همگانی روال نام(): رشته: برگشت "مستطیل" پایان
پایان

روال توصیف(ش: dyn شکل):
    سرچاپ ش.نام(), "->", ش.مساحت()
پایان

روال ریشه:
    توصیف(مربع { ضلع = 5 })
    توصیف(مستطیل { طول = 4, عرض = 6 })
پایان
