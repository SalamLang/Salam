میانجی شکل:
    کارکرد مساحت(): صحیح
    کارکرد نام(): رشته
پایان
ساختار مربع:
    ضلع: صحیح = 0
    همگانی کارکرد مساحت(): صحیح: بازگشت این.ضلع * این.ضلع پایان
    همگانی کارکرد نام(): رشته: بازگشت "مربع" پایان
پایان
ساختار مستطیل:
    طول: صحیح = 0
    عرض: صحیح = 0
    همگانی کارکرد مساحت(): صحیح: بازگشت این.طول * این.عرض پایان
    همگانی کارکرد نام(): رشته: بازگشت "مستطیل" پایان
پایان

کارکرد توصیف(ش: dyn شکل):
    چاپ ش.نام(), "->", ش.مساحت()
پایان

کارکرد آغازین:
    توصیف(مربع { ضلع = 5 })
    توصیف(مستطیل { طول = 4, عرض = 6 })
پایان
