روال ریشه:
    سرچاپ "۱۲".به صحیح() + ۱
    سرچاپ "٣٤".به صحیح()
    سرچاپ "-۵".به صحیح()
    سرچاپ "12".به صحیح()
    سرچاپ " ۷ ".به صحیح()
    سرچاپ "1۲3".به صحیح()
    سرچاپ "abc".به صحیح()
    سرچاپ "".به صحیح()
    سرچاپ "۲٫۵".به اعشار() * ۲
    سرچاپ "۲.۵".به اعشار() * ۲
    سرچاپ "3.25".به اعشار()
    سرچاپ "۱۲abc".به صحیح()
پایان
