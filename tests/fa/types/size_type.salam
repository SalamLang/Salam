// lang: fa
/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

ساختار Buf:
    همگانی cap: اندازه = 0
    همگانی used: اندازه = 0
پایان

روال half(n: اندازه): اندازه:
    برگشت n / (2 برگردان اندازه)
پایان

روال to_i(n: اندازه): صحیح۶۴:
    برگشت n برگردان صحیح۶۴
پایان

روال ریشه:
    a := 10 برگردان اندازه
    b := 3 برگردان اندازه
    سرچاپ a
    سرچاپ a + b
    سرچاپ a - b
    سرچاپ a * b
    سرچاپ a / b
    سرچاپ a % b
    سرچاپ a > b
    سرچاپ a == (10 برگردان اندازه)
    z := 0 برگردان اندازه
    wrap := z - (1 برگردان اندازه)
    سرچاپ wrap
    سرچاپ wrap > a
    سرچاپ wrap / (2 برگردان اندازه)
    سرچاپ wrap >> (60 برگردان اندازه)
    سرچاپ (1 برگردان اندازه) << (40 برگردان اندازه)
    سرچاپ half(a)
    سرچاپ to_i(a)
    neg := -1
    سرچاپ neg برگردان اندازه
    سرچاپ wrap برگردان صحیح۶۴
    سرچاپ (a برگردان صحیح۳۲) + 1
    سرچاپ a برگردان طبیعی۶۴
    سرچاپ a برگردان اعشار۶۴
    سرچاپ sizeof(صحیح۶۴)
    سرچاپ sizeof(صحیح۶۴) * (2 برگردان اندازه)
    ناپایا c := 0 برگردان اندازه
    c += 5 برگردان اندازه
    c -= 2 برگردان اندازه
    c *= 4 برگردان اندازه
    سرچاپ c
    ناپایا bf := Buf {}
    bf.ظرفیت = 64 برگردان اندازه
    bf.used = bf.ظرفیت - (1 برگردان اندازه)
    سرچاپ bf.used
    ناپایا v := وکتور {} برگردان وکتور<اندازه>
    v.بیفزا(7 برگردان اندازه)
    v.بیفزا(wrap)
    سرچاپ v.بگیر(0)
    سرچاپ v.بگیر(1)
    ناپایا i := 0 برگردان اندازه
    ناپایا total := 0 برگردان اندازه
    تا i < (5 برگردان اندازه):
        total = total + i
        i = i + (1 برگردان اندازه)
    پایان
    سرچاپ total
    arr := [1، 2، 3، 4]
    سرچاپ arr[1 برگردان اندازه]
    ترابرد a:
        10 برگردان اندازه:
            سرچاپ "ten"
        پایان
        وگرنه:
            سرچاپ "other"
        پایان
    پایان
    ناپایا m := نگاشت {} برگردان نگاشت<اندازه، رشته>
    m.درج(wrap، "max")
    سرچاپ m.بگیر(wrap)
پایان
