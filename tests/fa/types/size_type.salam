ساختار میانگیر:
    همگانی حد: اندازه مثبت = 0
    همگانی مصرف شده: اندازه مثبت = 0
پایان

تابع نیمه(n: اندازه مثبت): اندازه مثبت:
    برگشت n / (2 برگردان اندازه مثبت)
پایان

تابع به صحیح(n: اندازه مثبت): صحیح۶۴:
    برگشت n برگردان صحیح۶۴
پایان

تابع اندازه علامت‌دار():
    علامت‌دار := (0 برگردان اندازه) - (5 برگردان اندازه)
    سرچاپ علامت‌دار
    سرچاپ علامت‌دار < (0 برگردان اندازه)
    سرچاپ علامت‌دار / (2 برگردان اندازه)
    سرچاپ علامت‌دار % (3 برگردان اندازه)
    سرچاپ علامت‌دار >> (1 برگردان اندازه)
    سرچاپ علامت‌دار * (4 برگردان اندازه)
    سرچاپ علامت‌دار برگردان صحیح۶۴
    سرچاپ علامت‌دار برگردان اندازه مثبت > (0 برگردان اندازه مثبت)
    سرچاپ (7 برگردان اندازه مثبت) برگردان اندازه
    سرچاپ اندازه‌گونه(اندازه) == اندازه‌گونه(اندازه مثبت)
    ناپایا d := 10 برگردان اندازه
    d -= 25
    سرچاپ d
    سرچاپ d == -15
    سرچاپ d + 1
    ناپایا انباشته := وکتور {} برگردان وکتور<اندازه>
    انباشته.بیفزا(d)
    انباشته.بیفزا(علامت‌دار)
    سرچاپ انباشته.بگیر(0) + انباشته.بگیر(1)
    ترابرد d:
        -15:
            سرچاپ "minus fifteen"
            بشکن
        پایان
        0 تا 9:
            سرچاپ "small"
        پایان
        وگرنه:
            سرچاپ "other"
        پایان
    پایان
پایان

تابع ریشه:
    a := 10 برگردان اندازه مثبت
    b := 3 برگردان اندازه مثبت
    سرچاپ a
    سرچاپ a + b
    سرچاپ a - b
    سرچاپ a * b
    سرچاپ a / b
    سرچاپ a % b
    سرچاپ a > b
    سرچاپ a == (10 برگردان اندازه مثبت)
    z := 0 برگردان اندازه مثبت
    دور زده := z - (1 برگردان اندازه مثبت)
    سرچاپ دور زده
    سرچاپ دور زده > a
    سرچاپ دور زده / (2 برگردان اندازه مثبت)
    سرچاپ دور زده >> (60 برگردان اندازه مثبت)
    سرچاپ (1 برگردان اندازه مثبت) << (40 برگردان اندازه مثبت)
    سرچاپ نیمه(a)
    سرچاپ به صحیح(a)
    منفی := -1
    سرچاپ منفی برگردان اندازه مثبت
    سرچاپ دور زده برگردان صحیح۶۴
    سرچاپ (a برگردان صحیح۳۲) + 1
    سرچاپ a برگردان طبیعی۶۴
    سرچاپ a برگردان اعشار۶۴
    سرچاپ اندازه‌گونه(صحیح۶۴)
    سرچاپ اندازه‌گونه(صحیح۶۴) * (2 برگردان اندازه مثبت)
    ناپایا c := 0 برگردان اندازه مثبت
    c += 5 برگردان اندازه مثبت
    c -= 2 برگردان اندازه مثبت
    c *= 4 برگردان اندازه مثبت
    سرچاپ c
    ناپایا میانگیر ما := میانگیر {}
    میانگیر ما.حد = 64 برگردان اندازه مثبت
    میانگیر ما.مصرف شده = میانگیر ما.حد - (1 برگردان اندازه مثبت)
    سرچاپ میانگیر ما.مصرف شده
    ناپایا v := وکتور {} برگردان وکتور<اندازه مثبت>
    v.بیفزا(7 برگردان اندازه مثبت)
    v.بیفزا(دور زده)
    سرچاپ v.بگیر(0)
    سرچاپ v.بگیر(1)
    ناپایا i := 0 برگردان اندازه مثبت
    ناپایا جمع := 0 برگردان اندازه مثبت
    تا i < (5 برگردان اندازه مثبت):
        جمع += i
        i += (1 برگردان اندازه مثبت)
    پایان
    سرچاپ جمع
    آرایه := [1، 2، 3، 4]
    سرچاپ آرایه[1 برگردان اندازه مثبت]
    ترابرد a:
        10 برگردان اندازه مثبت:
            سرچاپ "ten"
        پایان
        وگرنه:
            سرچاپ "other"
        پایان
    پایان
    ناپایا m := نگاشت {} برگردان نگاشت<اندازه مثبت، رشته>
    m.درج(دور زده، "max")
    سرچاپ m.بگیر(دور زده)
    اندازه علامت‌دار()
پایان
