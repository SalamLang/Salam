ساختار Buf:
    همگانی limit: اندازه مثبت = 0
    همگانی used: اندازه مثبت = 0
پایان

روال half(n: اندازه مثبت): اندازه مثبت:
    برگشت n / (2 برگردان اندازه مثبت)
پایان

روال to_i(n: اندازه مثبت): صحیح۶۴:
    برگشت n برگردان صحیح۶۴
پایان

روال signed_size():
    sn := (0 برگردان اندازه) - (5 برگردان اندازه)
    سرچاپ sn
    سرچاپ sn < (0 برگردان اندازه)
    سرچاپ sn / (2 برگردان اندازه)
    سرچاپ sn % (3 برگردان اندازه)
    سرچاپ sn >> (1 برگردان اندازه)
    سرچاپ sn * (4 برگردان اندازه)
    سرچاپ sn برگردان صحیح۶۴
    سرچاپ sn برگردان اندازه مثبت > (0 برگردان اندازه مثبت)
    سرچاپ (7 برگردان اندازه مثبت) برگردان اندازه
    سرچاپ sizeof(اندازه) == sizeof(اندازه مثبت)
    ناپایا d := 10 برگردان اندازه
    d -= 25
    سرچاپ d
    سرچاپ d == -15
    سرچاپ d + 1
    ناپایا acc := وکتور {} برگردان وکتور<اندازه>
    acc.بیفزا(d)
    acc.بیفزا(sn)
    سرچاپ acc.بگیر(0) + acc.بگیر(1)
    ترابرد d:
        -15:
            سرچاپ "minus fifteen"
            بشکن
        پایان
        0 تا 9:
            سرچاپ "small"
        پایان
        وگرنه:
            سرچاپ "other"
        پایان
    پایان
پایان

روال ریشه:
    a := 10 برگردان اندازه مثبت
    b := 3 برگردان اندازه مثبت
    سرچاپ a
    سرچاپ a + b
    سرچاپ a - b
    سرچاپ a * b
    سرچاپ a / b
    سرچاپ a % b
    سرچاپ a > b
    سرچاپ a == (10 برگردان اندازه مثبت)
    z := 0 برگردان اندازه مثبت
    wrap := z - (1 برگردان اندازه مثبت)
    سرچاپ wrap
    سرچاپ wrap > a
    سرچاپ wrap / (2 برگردان اندازه مثبت)
    سرچاپ wrap >> (60 برگردان اندازه مثبت)
    سرچاپ (1 برگردان اندازه مثبت) << (40 برگردان اندازه مثبت)
    سرچاپ half(a)
    سرچاپ to_i(a)
    neg := -1
    سرچاپ neg برگردان اندازه مثبت
    سرچاپ wrap برگردان صحیح۶۴
    سرچاپ (a برگردان صحیح۳۲) + 1
    سرچاپ a برگردان طبیعی۶۴
    سرچاپ a برگردان اعشار۶۴
    سرچاپ sizeof(صحیح۶۴)
    سرچاپ sizeof(صحیح۶۴) * (2 برگردان اندازه مثبت)
    ناپایا c := 0 برگردان اندازه مثبت
    c += 5 برگردان اندازه مثبت
    c -= 2 برگردان اندازه مثبت
    c *= 4 برگردان اندازه مثبت
    سرچاپ c
    ناپایا bf := Buf {}
    bf.limit = 64 برگردان اندازه مثبت
    bf.used = bf.limit - (1 برگردان اندازه مثبت)
    سرچاپ bf.used
    ناپایا v := وکتور {} برگردان وکتور<اندازه مثبت>
    v.بیفزا(7 برگردان اندازه مثبت)
    v.بیفزا(wrap)
    سرچاپ v.بگیر(0)
    سرچاپ v.بگیر(1)
    ناپایا i := 0 برگردان اندازه مثبت
    ناپایا total := 0 برگردان اندازه مثبت
    تا i < (5 برگردان اندازه مثبت):
        total = total + i
        i = i + (1 برگردان اندازه مثبت)
    پایان
    سرچاپ total
    arr := [1، 2، 3، 4]
    سرچاپ arr[1 برگردان اندازه مثبت]
    ترابرد a:
        10 برگردان اندازه مثبت:
            سرچاپ "ten"
        پایان
        وگرنه:
            سرچاپ "other"
        پایان
    پایان
    ناپایا m := نگاشت {} برگردان نگاشت<اندازه مثبت، رشته>
    m.درج(wrap، "max")
    سرچاپ m.بگیر(wrap)
    signed_size()
پایان
