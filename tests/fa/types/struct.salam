ساختار مستطیل:
    طول: اعشار۶۴ = 0.0
    عرض: اعشار۶۴ = 0.0
    همگانی تابع مساحت(): اعشار۶۴:
        برگشت این.طول * این.عرض
    پایان
    همگانی تابع محیط(): اعشار۶۴:
        برگشت 2.0 * (این.طول + این.عرض)
    پایان
پایان

تابع ریشه:
    ناپایا r := مستطیل { طول = 4.0, عرض = 3.0 }
    سرچاپ "مساحت:", r.مساحت()
    سرچاپ "محیط:", r.محیط()
پایان
