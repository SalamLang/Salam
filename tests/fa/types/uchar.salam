روال ریشه:
    حرف := u"A"
    فارسی := u"م"
    چینی := u"中"
    ایموجی := u"😀"
    یورو := u"€"

    سرچاپ "حرف:", حرف
    سرچاپ "فارسی:", فارسی
    سرچاپ "چینی:", چینی
    سرچاپ "ایموجی:", ایموجی
    سرچاپ "یورو:", یورو

    شکلک := u"\U0001F600"
    سرچاپ "شکلک:", شکلک

    کلمه := حرف + فارسی
    سرچاپ "پیوند:", کلمه

    متن := ایموجی
    سرچاپ "به رشته:", متن
پایان
