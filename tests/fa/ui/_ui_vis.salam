همگانی بخش نشان(نام: رشته, مقدار: صحیح):
    برچسب: برچ = نام متن = نام + " " + مقدار پایان
پایان

بخش برچسب(برچ: رشته, متن: رشته):
    سرتیتر: شناسه = برچ محتوا = متن پایان
پایان
