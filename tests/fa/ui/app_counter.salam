صفحه:
    عنوان = "Counter app"
    شمار := 0
    سرصفحه:
        پس‌زمینه = #2563eb
        رنگ = white
        فاصله = 24
        سرتیتر: اندازه = 1 محتوا = "Counter app" پایان
    پایان
    جعبه:
        فاصله = 20
        شکاف = 12
        پاراگراف: شناسه = "text" محتوا = "Count: " + شمار پایان
        دکمه:
            شناسه = "inc"
            پس‌زمینه = #2563eb
            رنگ = white
            فاصله = 10، 20
            اشاره پس‌زمینه = #1d4ed8
            اگر شمار بزرگتر 2:
                پس‌زمینه = #16a34a
            پایان
            کلیک = (): شمار++ سرچاپ "count " + شمار پایان
            محتوا = "Add one"
        پایان
    پایان
پایان
