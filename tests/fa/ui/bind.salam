واردسازی رابط گرافیکی.رابط کاربری

ناپایا نام := ""
ناپایا موافق := نادرست

تابع بررسی():
    سرچاپ "name " + نام + ", agree " + موافق + ", " + رابط کاربری.با شناسه("hello").متن عنصر()
پایان

صفحه:
    عنوان = "Bind"
    جعبه:
        ورودی: شناسه = "name" پیوند = نام پایان
        ورودی: شناسه = "agree" نوع = "checkbox" پیوند = موافق پایان
        پاراگراف: شناسه = "hello" محتوا = "Hello " + نام پایان
        دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
    پایان
پایان
