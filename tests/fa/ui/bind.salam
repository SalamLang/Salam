واردسازی رابط گرافیکی.رابط کاربری

ناپایا پیش نویس := ""
ناپایا موافق := نادرست
ناپایا برگه := فرم { ایمیل = "" }
ناپایا ردیف ها := [""]

ساختار فرم:
    همگانی ایمیل: رشته
پایان

تابع پاک():
    پیش نویس = ""
    برگه.ایمیل = ""
پایان

تابع بررسی():
    سرچاپ "name [" + پیش نویس + "], agree " + موافق + ", email [" + برگه.ایمیل + "], row " + ردیف ها[0] + ", " + رابط کاربری.با شناسه("hello").متن عنصر() + ", field [" + رابط کاربری.با شناسه("name").مقدار عنصر() + "]"
پایان

صفحه:
    عنوان = "Bind"
    جعبه:
        ورودی: شناسه = "name" پیوند = پیش نویس پایان
        ورودی: شناسه = "agree" نوع = تیک پیوند = موافق پایان
        ورودی: شناسه = "email" نوع = "ایمیل" پیوند = برگه.ایمیل پایان
        ورودی: شناسه = "row" پیوند = ردیف ها[0] پایان
        پاراگراف: شناسه = "hello" محتوا = "Hello " + پیش نویس پایان
        دکمه: شناسه = "clear" کلیک = پاک محتوا = "Clear" پایان
        دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
    پایان
پایان
