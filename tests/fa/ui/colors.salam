ناپایا شمار فشار := 0

صفحه:
    عنوان = "Colors"
    جعبه:
        شناسه = "a"
        پس‌زمینه = "light dark(#ffffff, #202020)"
        رنگ = "oklch(0.5, 0.15, 250)"
        رنگ کادر = "mix(red, blue, 50%)"
        محتوا = "A"
    پایان
    جعبه:
        شناسه = "b"
        پس‌زمینه = "light dark(white, #121212)"
        رنگ = "light dark(black, white)"
        محتوا = "B"
    پایان
    جعبه:
        شناسه = "c"
        رنگ = "hsl(120, 100%, 25%)"
        رنگ کادر = "lab(50, 20, -30)"
        محتوا = "C"
    پایان
    جعبه:
        شناسه = "d"
        پس‌زمینه = "color(display p3, 0.3, 0.6, 0.4)"
        رنگ = "rgb(51, 102, 170)"
        محتوا = "D"
    پایان
    دکمه:
        شناسه = "go"
        کلیک = (): شمار فشار++ سرچاپ "clicked " + شمار فشار پایان
        محتوا = "Go"
    پایان
پایان
