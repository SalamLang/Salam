ناپایا شمار فشار := 0

صفحه:
    عنوان = "Colors"
    سراسری: گزینشگر = ":root" طرح رنگ = "light dark" پایان
    جعبه:
        شناسه = "a"
        رنگ پس‌زمینه = "light-dark(#ffffff, #202020)"
        رنگ = "oklch(0.5 0.15 250)"
        کادر = "2px solid color-mix(in oklab, red, blue)"
        محتوا = "A"
    پایان
    جعبه: شناسه = "b" رنگ پس‌زمینه = "رنگ‌بوم" رنگ = "متن‌بوم" محتوا = "B" پایان
    جعبه: شناسه = "c" رنگ = "hsl(120 100% 25%)" رنگ کادر = "lab(50 20 -30)" رنگ دورخط = "رنگ‌کنونی" محتوا = "C" پایان
    جعبه: شناسه = "d" رنگ پس‌زمینه = "color(display-p3 0.3 0.6 0.4)" رنگ = "rgb(from #3366aa r g calc(b / 2))" محتوا = "D" پایان
    دکمه: شناسه = "go" کلیک = (): شمار فشار++ سرچاپ "clicked " + شمار فشار پایان محتوا = "Go" پایان
پایان
