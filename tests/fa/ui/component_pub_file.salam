واردسازی رابط گرافیکی.رابط کاربری

ناپایا شمار := ۰

تابع بررسی():
    سرچاپ رابط کاربری.با شناسه("hits").متن عنصر()
پایان

صفحه:
    بگنجان = "_ui_vis.salam"
    جعبه:
        نشان:
            نام = "hits"
            مقدار = شمار
        پایان
        دکمه:
            شناسه = "hit"
            کلیک = (): شمار++ پایان
            محتوا = "Hit"
        پایان
        دکمه:
            شناسه = "check"
            کلیک = بررسی
            محتوا = "Check"
        پایان
    پایان
پایان
