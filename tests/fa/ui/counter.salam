ناپایا شمار := 0

تابع بازنشانی():
    شمار = 0
    سرچاپ "reset to " + شمار
پایان

صفحه:
    عنوان = "Counter"
    جعبه:
        سرتیتر:
            شناسه = "label"
            محتوا = "Count: " + شمار
        پایان
        دکمه:
            شناسه = "inc"
            کلیک = (): شمار++ سرچاپ "count is " + شمار پایان
            محتوا = "+1"
        پایان
        دکمه:
            شناسه = "reset"
            کلیک = بازنشانی
            محتوا = "Reset"
        پایان
    پایان
پایان
