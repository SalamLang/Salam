ناپایا باز_است := نادرست

صفحه:
    عنوان = "Dialog"
    دکمه:
        شناسه = "outside"
        کلیک = (): سرچاپ "outside" پایان
        محتوا = "Outside"
    پایان
    پنجره گفتگو:
        شناسه = "a"
        باز = درست
        بسته شدن = (): سرچاپ "close a" پایان
        دکمه:
            شناسه = "inside"
            کلیک = (): سرچاپ "inside" پایان
            محتوا = "Inside"
        پایان
    پایان
    دکمه:
        شناسه = "show"
        کلیک = (): باز_است = درست سرچاپ "show" پایان
        محتوا = "Show"
    پایان
    پنجره گفتگو:
        شناسه = "c"
        باز = باز_است
        بسته شدن = (): سرچاپ "close c" باز_است = نادرست پایان
        پاراگراف:
            محتوا = "third"
        پایان
    پایان
    پنجره گفتگو:
        شناسه = "b"
        باز = درست
        بسته شدن = (): سرچاپ "close b" پایان
        پاراگراف:
            محتوا = "second"
        پایان
    پایان
پایان
