واردسازی رابط گرافیکی.رابط کاربری

تابع show(id: رشته):
    r := رابط کاربری.با شناسه(id).مستطیل()
    سرچاپ id، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع report():
    show("def")
    show("force_ltr")
    show("inner_in_ltr")
    show("force_rtl")
    show("auto_fa")
    show("auto_en")
    show("auto_fa_kid")
    show("auto_en_kid")
    show("style_dir")
    show("row1")
    show("row2")
پایان

صفحه:
    عنوان = "Dir"
    جعبه:
        جعبه:
            شناسه = "def"
            عرض = 100
            ارتفاع = 10
        پایان
        جعبه:
            جهت = "ltr"
            شناسه = "force_ltr"
            جعبه:
                شناسه = "inner_in_ltr"
                عرض = 100
                ارتفاع = 10
            پایان
        پایان
        جعبه:
            جهت = "rtl"
            شناسه = "force_rtl"
            عرض = 300
            جعبه:
                عرض = 100
                ارتفاع = 10
            پایان
        پایان
        جعبه:
            جهت = "auto"
            شناسه = "auto_fa"
            محتوا = "سلام"
            جعبه:
                شناسه = "auto_fa_kid"
                عرض = 100
                ارتفاع = 10
            پایان
        پایان
        جعبه:
            جهت = "auto"
            شناسه = "auto_en"
            محتوا = "hello"
            جعبه:
                شناسه = "auto_en_kid"
                عرض = 100
                ارتفاع = 10
            پایان
        پایان
        جعبه:
            شناسه = "style_dir"
            جهت متن = "ltr"
            جعبه:
                عرض = 100
                ارتفاع = 10
            پایان
        پایان
        جعبه:
            چیدمان = "ردیف"
            جعبه:
                شناسه = "row1"
                عرض = 60
                ارتفاع = 10
            پایان
            جعبه:
                شناسه = "row2"
                عرض = 40
                ارتفاع = 10
            پایان
        پایان
    پایان
    دکمه:
        شناسه = "report"
        کلیک = report
        محتوا = "Report"
    پایان
پایان
