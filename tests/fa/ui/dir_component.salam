واردسازی رابط گرافیکی.رابط کاربری

تابع show(id: رشته):
    r := رابط کاربری.با شناسه(id).مستطیل()
    سرچاپ id، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع report():
    show("plain")
    show("inside")
    show("ltr_in")
پایان

بخش جایگاه(نام: رشته):
    جعبه:
        جعبه:
            شناسه = نام
            عرض = 100
            ارتفاع = 10
        پایان
    پایان
پایان

صفحه:
    عنوان = "Dir component"
    جعبه:
        جایگاه:
            نام = "plain"
        پایان
        جعبه:
            جهت = "rtl"
            جایگاه:
                نام = "inside"
            پایان
        پایان
        جعبه:
            جهت = "ltr"
            جایگاه:
                نام = "ltr_in"
            پایان
        پایان
    پایان
    دکمه:
        شناسه = "report"
        کلیک = report
        محتوا = "Report"
    پایان
پایان
