واردسازی رابط گرافیکی.رابط کاربری

تابع report():
    t := رابط کاربری.با شناسه("t")
    k := رابط کاربری.با کلید("agree")
    go := رابط کاربری.با شناسه("go")
    سرچاپ "exists"، t.وجود دارد()، رابط کاربری.با شناسه("nope").وجود دارد()، k.وجود دارد()
    سرچاپ "tag"، t.برچسب()، k.برچسب()، go.برچسب()
    سرچاپ "text"، go.متن عنصر()
    go.تنظیم متن("Again")
    سرچاپ "text"، go.متن عنصر()
    سرچاپ "value"، t.مقدار عنصر()
    t.تنظیم مقدار("hello")
    سرچاپ "value"، t.مقدار عنصر()
    t.تنظیم مقدار(t.مقدار عنصر())
    سرچاپ "value"، t.مقدار عنصر()
    تکرار ۵ در ای:
        go.تنظیم متن("Again" + ای)
    پایان
    سرچاپ "text"، go.متن عنصر()
    سرچاپ "checked"، k.تیک خورده است()
    k.تنظیم تیک(درست)
    سرچاپ "checked"، k.تیک خورده است()
    سرچاپ "attr"، t.ویژگی("placeholder")
    t.تنظیم ویژگی("placeholder"، "name")
    سرچاپ "attr"، t.ویژگی("placeholder")
    t.تمرکز()
    سرچاپ "event"، رابط کاربری.رخداد کنونی().گونه رخداد، رابط کاربری.رخداد کنونی().هدف
    go.نمایان کردن()
    r := go.مستطیل()
    سرچاپ "rect"، r.پهنا بزرگتر 0.0، r.بلندی بزرگتر 0.0
    s := t.سبک محاسبه شده()
    سرچاپ "style"، s.نمایان
    t.کلیک()
پایان

تابع ریشه:
    رابط کاربری.تنظیم بازکننده نشانی((url: رشته): برگشت url.طول() بزرگتر 0 پایان)
    رابط کاربری.تنظیم راهبر((url: رشته): برگشت url.طول() بزرگتر 0 پایان)
    رابط کاربری.تنظیم عقب((): برگشت نادرست پایان)
    رابط کاربری.تنظیم جلو((): برگشت نادرست پایان)
    رابط کاربری.تنظیم پس از به روز رسانی((): برگشت نادرست پایان)
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده‌صفحه):
        b.گشودن عنصر("input")
        b.شناسه عنصر("t")
        b.ویژگی عنصر("type"، "text")
        b.رسیدگی رخداد("click"، (): سرچاپ "clicked t" پایان)
        b.بستن عنصر()
        b.گشودن عنصر("checkbox")
        b.کلید عنصر("agree")
        b.بستن عنصر()
        b.گشودن عنصر("button")
        b.شناسه عنصر("go")
        b.رسیدگی رخداد("click"، (): report() پایان)
        b.متن فرزند("Go")
        b.بستن عنصر()
    پایان)
    سرچاپ "open"، رابط کاربری.باز کردن نشانی("https://example.com")
    سرچاپ "opened"، رابط کاربری.نشانی های باز شده().طول()
    رابط کاربری.اجرای گام ها("quit")
    رابط کاربری.توقف()
پایان
