واردسازی رابط گرافیکی.رابط کاربری

ناپایا تیک ها := ۰
ناپایا متن := "old"
ناپایا موافق := نادرست
ناپایا ردیف ها := ["r1"]
ناپایا یادداشت := "old"

تابع تنظیم():
    رابط کاربری.با شناسه("line").تنظیم مقدار("mine")
    رابط کاربری.با شناسه("area").تنظیم مقدار("mine")
    رابط کاربری.با شناسه("plain").تنظیم تیک(درست)
    رابط کاربری.با شناسه("fixed").تنظیم تیک(نادرست)
    رابط کاربری.با شناسه("linked").تنظیم تیک(درست)
    رابط کاربری.با شناسه("second").تنظیم تیک(درست)
    رابط کاربری.با شناسه("pick").تنظیم مقدار("c")
پایان

تابع دگرگونی():
    متن = "new"
    موافق = درست
پایان

تابع بازگشت():
    موافق = نادرست
پایان

تابع نگهداشت():
    رابط کاربری.با شناسه("follow").تنظیم مقدار("x")
پایان

تابع نوشتن():
    رابط کاربری.با شناسه("note-r1").تنظیم مقدار("mine")
پایان

تابع بازنویسی():
    یادداشت = "newer"
پایان

تابع خواندن():
    سرچاپ "note " + رابط کاربری.با شناسه("note-r1").مقدار عنصر()
پایان

تابع نمایش():
    سرچاپ "ticks " + تیک ها + ", line " + رابط کاربری.با شناسه("line").مقدار عنصر() + ", area " +
        رابط کاربری.با شناسه("area").مقدار عنصر()
    سرچاپ "plain"،
        رابط کاربری.با شناسه("plain").تیک خورده است()،
        رابط کاربری.با شناسه("fixed").تیک خورده است()،
        رابط کاربری.با شناسه("linked").تیک خورده است()،
        رابط کاربری.با شناسه("first").تیک خورده است()،
        رابط کاربری.با شناسه("second").تیک خورده است()
    سرچاپ "pick " + رابط کاربری.با شناسه("pick").مقدار عنصر() + ", follow " +
        رابط کاربری.با شناسه("follow").مقدار عنصر()
پایان

صفحه:
    عنوان = "Keep"
    جعبه:
        ورودی:
            شناسه = "line"
            مقدار = متن
            عنوان = "t" + تیک ها
        پایان
        ورودی:
            شناسه = "area"
            نوع = "textarea"
            مقدار = متن
            عنوان = "t" + تیک ها
        پایان
        ورودی:
            شناسه = "plain"
            نوع = "checkbox"
            عنوان = "t" + تیک ها
        پایان
        ورودی:
            شناسه = "fixed"
            نوع = "checkbox"
            تیک خورده = درست
            عنوان = "t" + تیک ها
        پایان
        ورودی:
            شناسه = "linked"
            نوع = "checkbox"
            تیک خورده = موافق
            عنوان = "t" + تیک ها
        پایان
        ورودی:
            شناسه = "first"
            نوع = "radio"
            نام = "side"
            تیک خورده = درست
            عنوان = "t" + تیک ها
        پایان
        ورودی:
            شناسه = "second"
            نوع = "radio"
            نام = "side"
            عنوان = "t" + تیک ها
        پایان
        انتخاب:
            شناسه = "pick"
            عنوان = "t" + تیک ها
            گزینه:
                مقدار = "a"
                محتوا = "A"
            پایان
            گزینه:
                مقدار = "b"
                انتخاب شده = درست
                محتوا = "B"
            پایان
            گزینه:
                مقدار = "c"
                محتوا = "C"
            پایان
        پایان
        انتخاب:
            شناسه = "follow"
            عنوان = "t" + تیک ها
            گزینه:
                مقدار = "x"
                محتوا = "X"
            پایان
            گزینه:
                مقدار = "y"
                انتخاب شده = موافق
                محتوا = "Y"
            پایان
        پایان
        پاراگراف:
            محتوا = "ticks " + تیک ها
        پایان
    پایان
    فهرست:
        هر _، ی در ردیف ها:
            مورد:
                کلید = ی
                ورودی:
                    شناسه = "note-" + ی
                    نوع = "textarea"
                    مقدار = یادداشت
                پایان
            پایان
        پایان
    پایان
    دکمه:
        شناسه = "write"
        کلیک = نوشتن
        محتوا = "Write"
    پایان
    دکمه:
        شناسه = "rewrite"
        کلیک = بازنویسی
        محتوا = "Rewrite"
    پایان
    دکمه:
        شناسه = "read"
        کلیک = خواندن
        محتوا = "Read"
    پایان
    دکمه:
        شناسه = "show"
        کلیک = نمایش
        محتوا = "Show"
    پایان
    دکمه:
        شناسه = "set"
        کلیک = تنظیم
        محتوا = "Set"
    پایان
    دکمه:
        شناسه = "hold"
        کلیک = نگهداشت
        محتوا = "Hold"
    پایان
    دکمه:
        شناسه = "tick"
        کلیک = (): تیک ها++ پایان
        محتوا = "Tick"
    پایان
    دکمه:
        شناسه = "change"
        کلیک = دگرگونی
        محتوا = "Change"
    پایان
    دکمه:
        شناسه = "back"
        کلیک = بازگشت
        محتوا = "Back"
    پایان
پایان
