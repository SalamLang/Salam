واردسازی رابط گرافیکی.رابط کاربری

ناپایا دفعات := 0

تابع ثبت(کدام: رشته):
    دفعات++
    سرچاپ کدام + " " + دفعات
پایان

تابع open():
    ثبت("open")
    رابط کاربری.باز کردن نشانی("#low")
پایان

تابع name():
    ثبت("name")
پایان

تابع status():
    ثبت("status")
پایان

تابع location():
    ثبت("location")
پایان

تابع history():
    ثبت("history")
پایان

تابع top():
    ثبت("top")
پایان

تابع focus():
    ثبت("focus")
    سرچاپ "urls " + رابط کاربری.نشانی های باز شده().طول()
پایان

تابع قلاب ها():
    رابط کاربری.هنگام توقف((): ثبت("pause") پایان)
    رابط کاربری.بستن صفحه کلید(درست، نادرست)
    رابط کاربری.بی اعتبار سازی()
    سرچاپ "visible " + رابط کاربری.پنجره نمایان است() + " " +
        رابط کاربری.با شناسه("count").متن عنصر()
پایان

صفحه:
    عنوان = "Names"
    جعبه:
        پاراگراف:
            شناسه = "count"
            محتوا = "hits " + دفعات
        پایان
        دکمه:
            شناسه = "b1"
            کلیک = open
            محتوا = "1"
        پایان
        دکمه:
            شناسه = "b2"
            کلیک = name
            محتوا = "2"
        پایان
        دکمه:
            شناسه = "b3"
            کلیک = status
            محتوا = "3"
        پایان
        دکمه:
            شناسه = "b4"
            کلیک = location
            محتوا = "4"
        پایان
        دکمه:
            شناسه = "b5"
            کلیک = history
            محتوا = "5"
        پایان
        دکمه:
            شناسه = "b6"
            کلیک = top
            محتوا = "6"
        پایان
        دکمه:
            شناسه = "b7"
            کلیک = focus
            محتوا = "7"
        پایان
        دکمه:
            شناسه = "b8"
            کلیک = قلاب ها
            محتوا = "8"
        پایان
        پاراگراف:
            شناسه = "low"
            محتوا = "low"
        پایان
    پایان
پایان
