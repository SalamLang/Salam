واردسازی رابط گرافیکی.رابط کاربری

ناپایا دفعه := 0
ناپایا خواسته := نادرست

تابع حالت(شناسه: رشته): رشته:
    اگر رابط کاربری.با شناسه(شناسه).مستطیل().بلندی بزرگتر 150.0:
        برگشت "open"
    پایان
    برگشت "shut"
پایان

تابع گزارش():
    سرچاپ "ticks " + دفعه + ": user " + حالت("user_box") + ", declared " + حالت(
        "declared_box"
    ) + ", linked " + حالت("linked_box") + ", modal " + حالت("modal_box")
پایان

تابع آزاد():
    رابط کاربری.با شناسه("sel").تنظیم مقدار("zz")
پایان

تابع اجباری():
    رابط کاربری.با شناسه("modal_box").تنظیم ویژگی("open"، "true")
پایان

تابع گزیده():
    سرچاپ "ticks " + دفعه + ": sel [" + رابط کاربری.با شناسه("sel").مقدار عنصر() + "], listed [" +
        رابط کاربری.با شناسه("listed").مقدار عنصر() + "]"
پایان

صفحه:
    عنوان = "Open"
    جعبه:
        دکمه:
            شناسه = "report"
            کلیک = گزارش
            محتوا = "report"
        پایان
        دکمه:
            شناسه = "tick"
            کلیک = (): دفعه++ پایان
            محتوا = "tick " + دفعه
        پایان
        دکمه:
            شناسه = "flip"
            کلیک = (): خواسته = وارونه خواسته پایان
            محتوا = "flip"
        پایان
        جزئیات:
            شناسه = "user_box"
            خلاصه:
                شناسه = "user_sum"
                محتوا = "user"
            پایان
            پاراگراف:
                شناسه = "user"
                ارتفاع = 200
                محتوا = "user body " + دفعه
            پایان
        پایان
        جزئیات:
            شناسه = "declared_box"
            باز = درست
            خلاصه:
                شناسه = "declared_sum"
                محتوا = "declared"
            پایان
            پاراگراف:
                شناسه = "declared"
                ارتفاع = 200
                محتوا = "declared body " + دفعه
            پایان
        پایان
        جزئیات:
            شناسه = "linked_box"
            باز = خواسته
            خلاصه:
                شناسه = "linked_sum"
                محتوا = "linked"
            پایان
            پاراگراف:
                شناسه = "linked"
                ارتفاع = 200
                محتوا = "linked body " + دفعه
            پایان
        پایان
        دکمه:
            شناسه = "force"
            کلیک = اجباری
            محتوا = "force"
        پایان
        دکمه:
            شناسه = "loose"
            کلیک = آزاد
            محتوا = "loose"
        پایان
        دکمه:
            شناسه = "picked"
            کلیک = گزیده
            محتوا = "picked"
        پایان
        انتخاب:
            شناسه = "sel"
            گزینه:
                مقدار = "a"
                محتوا = "a"
            پایان
            گزینه:
                مقدار = "b"
                محتوا = "b " + دفعه
            پایان
        پایان
        انتخاب:
            شناسه = "listed"
            اندازه = 3
            گزینه:
                مقدار = "a"
                محتوا = "a"
            پایان
            گزینه:
                مقدار = "b"
                انتخاب شده = خواسته
                محتوا = "b " + دفعه
            پایان
            گزینه:
                مقدار = "c"
                محتوا = "c"
            پایان
        پایان
        پنجره گفتگو:
            شناسه = "modal_box"
            باز = خواسته
            جعبه:
                پاراگراف:
                    شناسه = "modal"
                    ارتفاع = 200
                    محتوا = "modal body " + دفعه
                پایان
                دکمه:
                    شناسه = "picked_inner"
                    کلیک = گزیده
                    محتوا = "picked"
                پایان
                دکمه:
                    شناسه = "inner_report"
                    کلیک = گزارش
                    محتوا = "report"
                پایان
                دکمه:
                    شناسه = "inner_flip"
                    کلیک = (): خواسته = وارونه خواسته پایان
                    محتوا = "flip"
                پایان
                دکمه:
                    شناسه = "inner_tick"
                    کلیک = (): دفعه++ پایان
                    محتوا = "tick"
                پایان
            پایان
        پایان
    پایان
پایان
