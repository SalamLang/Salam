واردسازی رابط گرافیکی.رابط کاربری

ناپایا فشارها := ۰
ناپایا موردها := ["a"، "b"]

تابع آزمودن():
    ثابت := رابط کاربری.با شناسه("fixed")
    نام := رابط کاربری.با شناسه("name")
    موافقت := رابط کاربری.با شناسه("agree")
    سرچاپ "exists"،
        ثابت.وجود دارد()،
        رابط کاربری.با شناسه("nope").وجود دارد()،
        رابط کاربری.با کلید("b").وجود دارد()،
        رابط کاربری.با کلید("zz").وجود دارد()
    سرچاپ "tag"،
        ثابت.برچسب()،
        رابط کاربری.با شناسه("wrap").برچسب()،
        رابط کاربری.با کلید("b").برچسب()،
        نام.برچسب()
    سرچاپ "text " + ثابت.متن عنصر() + ", " + رابط کاربری.با کلید("b").متن عنصر() + ", [" +
        رابط کاربری.با شناسه("nope").متن عنصر() + "]"
    ثابت.تنظیم متن("changed")
    سرچاپ "text " + ثابت.متن عنصر()
    نام.تنظیم مقدار("Sam")
    سرچاپ "value " + نام.مقدار عنصر()
    سرچاپ "checked"، موافقت.تیک خورده است()
    موافقت.تنظیم تیک(درست)
    سرچاپ "checked"، موافقت.تیک خورده است()
    سرچاپ "attr " + نام.ویژگی("placeholder")
    نام.تنظیم ویژگی("placeholder"، "name")
    سرچاپ "attr " + نام.ویژگی("placeholder")
    برو := رابط کاربری.با شناسه("go")
    برو.نمایان کردن()
    ک := برو.مستطیل()
    سرچاپ "rect"، ک.پهنا بزرگتر ۰.۰، ک.بلندی بزرگتر ۰.۰
    برو.کلیک()
    سرچاپ "open"، رابط کاربری.باز کردن نشانی("#go")، رابط کاربری.نشانی های باز شده().طول()
    نام.تمرکز()
پایان

تابع رفتن():
    سرچاپ "event " + رابط کاربری.رخداد کنونی().گونه رخداد + " " + رابط کاربری.رخداد کنونی().هدف
پایان

تابع remove():
    سرچاپ "value " + رابط کاربری.با شناسه("name").مقدار عنصر() + ", presses " + فشارها
پایان

تابع reset():
    فشارها = ۰
پایان

صفحه:
    عنوان = "Element"
    جعبه:
        شناسه = "wrap"
        پاراگراف:
            شناسه = "fixed"
            محتوا = "fixed"
        پایان
        ورودی:
            شناسه = "name"
            جانگهدار = "who"
        پایان
        ورودی:
            شناسه = "agree"
            نوع = "checkbox"
        پایان
        فهرست:
            هر _، م در موردها:
                مورد:
                    کلید = م
                    محتوا = "item " + م
                پایان
            پایان
        پایان
        پاراگراف:
            شناسه = "count"
            محتوا = "presses " + فشارها
        پایان
        دکمه:
            شناسه = "probe"
            کلیک = آزمودن
            محتوا = "Probe"
        پایان
        دکمه:
            شناسه = "go"
            کلیک = رفتن
            محتوا = "Go"
        پایان
        دکمه:
            شناسه = "press"
            کلیک = (): فشارها++ پایان
            محتوا = "Press"
        پایان
        دکمه:
            شناسه = "show"
            کلیک = remove
            محتوا = "Show"
        پایان
        دکمه:
            شناسه = "zero"
            کلیک = reset
            محتوا = "Zero"
        پایان
    پایان
پایان
