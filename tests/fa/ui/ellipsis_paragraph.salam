واردسازی رابط گرافیکی.رابط کاربری

تابع show(شناسه: رشته):
    r := رابط کاربری.با شناسه(شناسه).مستطیل()
    سرچاپ شناسه، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع report():
    show("cut")
    show("over")
پایان

صفحه:
    عنوان = "Ellipsis"
    جعبه:
        پاراگراف:
            شناسه = "cut"
            عرض = 120
            ارتفاع = 30
            سه‌نقطه = درست
            محتوا = "سلام دنیا سلام دنیا سلام دنیا سلام دنیا سلام دنیا سلام دنیا سلام دنیا سلام دنیا "
        پایان
        پاراگراف:
            شناسه = "over"
            عرض = 120
            ارتفاع = 30
            پیچش متن = نادرست
            محتوا = "سلام دنیا سلام دنیا سلام دنیا سلام دنیا سلام دنیا سلام دنیا سلام دنیا سلام دنیا "
        پایان
    پایان
    دکمه:
        شناسه = "report"
        کلیک = report
        محتوا = "Report"
    پایان
پایان
