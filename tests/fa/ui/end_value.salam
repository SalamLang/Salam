صفحه:
    عنوان = "End as a value"
    جعبه:
        شناسه = "a"
        تراز متن = انتها
        خود تراز = انتها
        محتوا = "A"
    پایان
    جعبه:
        شناسه = "b"
        چیدمان = ردیف
        چینش = پایان
        محتوا = "B"
    پایان
پایان
