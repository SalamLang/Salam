صفحه:
    عنوان = "Hello"
    سرصفحه:
        پس‌زمینه = #2563eb
        رنگ = "white"
        فاصله = 24px
        سرتیتر: اندازه = 1 محتوا = "Welcome" پایان
    پایان
    جعبه:
        فاصله = 20px
        پاراگراف: شناسه = "text" محتوا = "Plain page with no main" پایان
        دکمه: شناسه = "go" کلیک = (): سرچاپ "clicked" پایان محتوا = "Go" پایان
    پایان
پایان
