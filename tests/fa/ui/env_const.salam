پایا نشان := "#ff5c00"

صفحه:
    عنوان = "پایا و صفحه"
    جعبه:
        رنگ = نشان
        اگر فشرده:
            اندازه قلم = 12
        پایان
        سرتیتر:
            شناسه = "label"
            محتوا = "پایاها اول"
        پایان
        دکمه:
            شناسه = "say"
            کلیک = (): سرچاپ "ok" پایان
            محتوا = "بگو"
        پایان
    پایان
پایان
