واردسازی رابط گرافیکی.رابط کاربری

ناپایا انتخاب := ""
ناپایا نام ها := وکتور {} برگردان وکتور<رشته>

تابع پرسازی():
    نام ها.بیفزا("a")
    نام ها.بیفزا("b")
پایان

تابع بررسی():
    سرچاپ "picked " + انتخاب
پایان

بخش گزینه(نام: رشته):
    جعبه:
        دکمه: شناسه = "b-" + نام کلیک = (): انتخاب = نام پایان محتوا = نام پایان
    پایان
پایان

صفحه:
    عنوان = "Each parameter"
    جعبه:
        دکمه: شناسه = "fill" کلیک = پرسازی محتوا = "Fill" پایان
        دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
        فهرست:
            هر ن در نام ها:
                گزینه: نام = ن پایان
            پایان
        پایان
    پایان
پایان
