واردسازی رابط گرافیکی.رابط کاربری

ناپایا ذخیره ها := ۰
ناپایا دیده := ۰

تابع بررسی():
    ر := رابط کاربری.شمار اجرای دامنه()
    سرچاپ "runs " + (ر - دیده) + ", " + رابط کاربری.با شناسه("page").متن عنصر() + ", " + رابط کاربری.با شناسه("panel").متن عنصر() + ", " + رابط کاربری.با شناسه("bar").متن عنصر() + ", " + رابط کاربری.با شناسه("save").متن عنصر() + ", " + رابط کاربری.با شناسه("other").متن عنصر()
    دیده = ر
پایان

بخش کلید فشاری(نام: رشته):
    وضعیت فشارها := ۰
    دکمه: شناسه = نام کلیک = (): فشارها++ برانگیز("فشرده"، نام) پایان محتوا = نام + " " + فشارها پایان
پایان

بخش نوار ابزار:
    وضعیت انتخاب := "none"
    جعبه:
        پاراگراف: شناسه = "bar" محتوا = "bar " + انتخاب پایان
        کلید فشاری: نام = "save" هنگام فشرده = (ن: رشته): انتخاب = ن پایان پایان
        کلید فشاری:
            نام = "quit"
            هنگام فشرده = (ن: رشته):
                انتخاب = ن
                بایست()
            پایان
        پایان
        کلید فشاری: نام = "help" پایان
    پایان
پایان

بخش پنل:
    وضعیت شمار := ۰
    جعبه:
        پاراگراف: شناسه = "panel" محتوا = "panel " + شمار پایان
        نوار ابزار: هنگام فشرده = (ن: رشته): شمار++ سرچاپ "panel got " + ن پایان پایان
    پایان
پایان

بخش دیگر:
    وضعیت عدد := ۰
    پاراگراف: شناسه = "other" محتوا = "other " + عدد پایان
پایان

صفحه:
    عنوان = "Events"
    هنگام فشرده = (ن: رشته): ذخیره ها++ سرچاپ "page got " + ن پایان
    پاراگراف: شناسه = "page" محتوا = "page " + ذخیره ها پایان
    پنل: پایان
    دیگر: پایان
    دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
پایان
