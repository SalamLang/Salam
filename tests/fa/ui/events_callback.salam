واردسازی رابط گرافیکی.رابط کاربری

ناپایا کل := ۰
ناپایا دیده := ۰

تابع بررسی():
    ر := رابط کاربری.شمار اجرای دامنه()
    سرچاپ "runs " + (ر - دیده) + ", " + رابط کاربری.با شناسه("total").متن عنصر() + ", " + رابط کاربری.با شناسه("sum").متن عنصر() + ", " + رابط کاربری.با شناسه("a").متن عنصر() + ", " + رابط کاربری.با شناسه("b").متن عنصر() + ", " + رابط کاربری.با شناسه("solo").متن عنصر()
    دیده = ر
پایان

تابع ثبت(م: صحیح):
    سرچاپ "record " + م
پایان

بخش شمارنده(نام: رشته، تغییر):
    شمار := ۰
    دکمه: شناسه = نام کلیک = (): شمار++ تغییر(شمار) پایان محتوا = نام + " " + شمار پایان
پایان

بخش جفت(گزارش: تابع (صحیح)):
    جمع := ۰
    جعبه:
        پاراگراف: شناسه = "sum" محتوا = "sum " + جمع پایان
        شمارنده:
            نام = "a"
            تغییر = (م: صحیح):
                جمع += م
                گزارش(جمع)
            پایان
        پایان
        شمارنده: نام = "b" تغییر = ثبت پایان
    پایان
پایان

صفحه:
    عنوان = "Callbacks"
    پاراگراف: شناسه = "total" محتوا = "total " + کل پایان
    جفت: گزارش = (م: صحیح): کل = م پایان پایان
    شمارنده: نام = "solo" پایان
    دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
پایان
