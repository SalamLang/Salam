واردسازی رابط گرافیکی.رابط کاربری

ناپایا گروه ها := ["g1"، "g2"]
ناپایا ردیف ها := ["x"، "y"]
ناپایا انتخاب ها := ۰
ناپایا دیده := ۰

تابع بررسی():
    ر := رابط کاربری.شمار اجرای دامنه()
    سرچاپ "runs " + (ر - دیده) + ", picks " + انتخاب ها + ", " + رابط کاربری.با شناسه("g1").متن عنصر() + ", " + رابط کاربری.با شناسه("g2").متن عنصر()
    دیده = ر
پایان

بخش ردیف(گروه: رشته، نام: رشته):
    ضربه ها := ۰
    مورد: کلید = نام شناسه = گروه + "-" + نام کلیک = (): ضربه ها++ برانگیز("انتخاب شد"، نام + ضربه ها) پایان محتوا = نام + " " + ضربه ها پایان
پایان

بخش دسته(نام: رشته):
    انتخاب := "-"
    جعبه:
        شناسه = نام
        پاراگراف: محتوا = نام + " picked " + انتخاب پایان
        فهرست:
            هر ی در ردیف ها:
                ردیف: گروه = نام نام = ی هنگام انتخاب شد = (م: رشته): انتخاب = م پایان پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "Rows"
    هنگام انتخاب شد = (): انتخاب ها++ پایان
    هر گ در گروه ها:
        دسته: نام = گ پایان
    پایان
    دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
پایان
