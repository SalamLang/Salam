واردسازی رابط گرافیکی.رابط کاربری

ناپایا picked := "none"

تابع show(id: رشته):
    r := رابط کاربری.با شناسه(id).مستطیل()
    سرچاپ id، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع pick_g2():
    picked = "g2"
    سرچاپ "picked g2"
پایان

تابع pick_c3():
    picked = "c3"
    سرچاپ "picked c3"
پایان

تابع report():
    سرچاپ "last picked " + picked
    show("grid")
    show("g1")
    show("g2")
    show("g3")
    show("g4")
    show("tab")
    show("c1")
    show("c2")
    show("c3")
    show("c4")
پایان

صفحه:
    عنوان = "Grid and table"
    جعبه:
        شناسه = "grid"
        چیدمان = شبکه
        ستون‌ها = 60، 1fr، 2fr
        شکاف = 4، 6
        عرض = 300
        جعبه: شناسه = "g1" ارتفاع = 20 ستون = 1 گستره ستون = 2 پس‌زمینه = "teal" پایان
        جعبه: شناسه = "g2" ارتفاع = 30 گستره ردیف = 2 کلیک = pick_g2 پس‌زمینه = "olive" پایان
        جعبه: شناسه = "g3" ارتفاع = 10 پس‌زمینه = "navy" پایان
        جعبه: شناسه = "g4" ارتفاع = 10 پس‌زمینه = "maroon" پایان
    پایان
    جعبه:
        شناسه = "tab"
        چیدمان = شبکه
        ستون‌ها = خودکار، خودکار، خودکار
        شکاف = 2
        جعبه: شناسه = "c1" عرض = 40 ارتفاع = 12 پایان
        جعبه: شناسه = "c2" عرض = 70 ارتفاع = 20 گستره ستون = 2 پایان
        جعبه: شناسه = "c3" عرض = 10 ارتفاع = 10 کلیک = pick_c3 پایان
        جعبه: شناسه = "c4" عرض = 30 ارتفاع = 10 پایان
        جعبه: عرض = 30 ارتفاع = 10 پایان
    پایان
    دکمه: شناسه = "report" کلیک = report محتوا = "Report" پایان
پایان
