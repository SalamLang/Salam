واردسازی رابط گرافیکی.رابط کاربری

ناپایا picked := "none"

تابع show(id: رشته):
    r := رابط کاربری.با شناسه(id).مستطیل()
    سرچاپ id، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع pick_g2():
    picked = "g2"
    سرچاپ "picked g2"
پایان

تابع pick_c3():
    picked = "c3"
    سرچاپ "picked c3"
پایان

تابع report():
    سرچاپ "last picked " + picked
    show("grid")
    show("g1")
    show("g2")
    show("g3")
    show("g4")
    show("tab")
    show("c1")
    show("c2")
    show("c3")
    show("c4")
پایان

صفحه:
    عنوان = "Grid and table"
    جعبه:
        شناسه = "grid"
        نمایش = "grid"
        ستون های شبکه = "60px 1fr 2fr"
        شکاف = "4px 6px"
        عرض = 300px
        جعبه: شناسه = "g1" ارتفاع = 20px ستون شبکه = "1 / 3" پس زمینه = "teal" پایان
        جعبه: شناسه = "g2" ارتفاع = 30px ردیف شبکه = "span 2" کلیک = pick_g2 پس زمینه = "olive" پایان
        جعبه: شناسه = "g3" ارتفاع = 10px پس زمینه = "navy" پایان
        جعبه: شناسه = "g4" ارتفاع = 10px پس زمینه = "maroon" پایان
    پایان
    جدول:
        شناسه = "tab"
        فاصله کادرها = 2px
        اصلی:
            ردیف:
                ستون: شناسه = "c1" فاصله = 0 جعبه: عرض = 40px ارتفاع = 12px پایان پایان
                ستون: شناسه = "c2" فاصله = 0 پوشش ستون = 2 جعبه: عرض = 70px ارتفاع = 20px پایان پایان
            پایان
            ردیف:
                ستون: شناسه = "c3" فاصله = 0 کلیک = pick_c3 جعبه: عرض = 10px ارتفاع = 10px پایان پایان
                ستون: شناسه = "c4" فاصله = 0 جعبه: عرض = 30px ارتفاع = 10px پایان پایان
                ستون: فاصله = 0 جعبه: عرض = 30px ارتفاع = 10px پایان پایان
            پایان
        پایان
    پایان
    دکمه: شناسه = "report" کلیک = report محتوا = "Report" پایان
پایان
