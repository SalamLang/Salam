ناپایا برگزیده := نادرست
ناپایا بزرگ := نادرست

صفحه:
    عنوان = "If"
    دکمه:
        شناسه = "seg"
        پس‌زمینه = "blue"
        رنگ = "white"
        اشاره پس‌زمینه = "navy"
        اگر برگزیده:
            پس‌زمینه = "orange"
            رنگ = "black"
        پایان
        کلیک = (): برگزیده = وارونه برگزیده پایان
        محتوا = "Seg"
    پایان
    دکمه:
        شناسه = "size"
        فاصله = 8
        اگر بزرگ:
            فاصله = 24
        پایان
        اگر برگزیده و بزرگ:
            فاصله = 40
        پایان
        کلیک = (): بزرگ = وارونه بزرگ پایان
        محتوا = "Size"
    پایان
    دکمه:
        شناسه = "alt"
        اگر بزرگ:
            رنگ = "red"
        وگرنه اگر برگزیده:
            رنگ = "green"
        وگرنه:
            رنگ = "gray"
        پایان
        محتوا = "Alt"
    پایان
پایان
