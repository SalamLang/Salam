واردسازی رابط گرافیکی.رابط کاربری

تابع نشان(شناسه: رشته):
    مستطیل := رابط کاربری.با شناسه(شناسه).مستطیل()
    سرچاپ شناسه, مستطیل.پهنا, مستطیل.بلندی
پایان

تابع گزارش():
    نشان("natural")
    نشان("capped")
    نشان("tall")
    نشان("missing")
پایان

صفحه:
    عنوان = "Images"
    تصویر:
        شناسه = "natural"
        نشانی = "tests/en/ui/wide.png"
    پایان
    تصویر:
        شناسه = "capped"
        نشانی = "tests/en/ui/wide.png"
        بیشینه عرض = 30
    پایان
    تصویر:
        شناسه = "tall"
        نشانی = "tests/en/ui/wide.png"
        ارتفاع = 20
    پایان
    تصویر:
        شناسه = "missing"
        نشانی = "tests/en/ui/none.png"
    پایان
    دکمه:
        شناسه = "report"
        کلیک = گزارش
        محتوا = "Report"
    پایان
پایان
