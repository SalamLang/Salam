واردسازی رابط گرافیکی.رابط کاربری

ناپایا نوشته := ""

تابع خالی():
    نوشته = ""
پایان

تابع پرشدن():
    نوشته = "abc"
پایان

تابع نمایش():
    سرچاپ "field [" + رابط کاربری.با شناسه("name").مقدار عنصر() + "] draft [" + نوشته + "]"
پایان

صفحه:
    عنوان = "Clear"
    جعبه:
        ورودی: شناسه = "name" نوع = "متن" مقدار = نوشته ورودی = (مقدار تازه: رشته):
            نوشته = مقدار تازه
        پایان پایان
        دکمه: شناسه = "clear" کلیک = خالی محتوا = "Clear" پایان
        دکمه: شناسه = "fill" کلیک = پرشدن محتوا = "Fill" پایان
        دکمه: شناسه = "show" کلیک = نمایش محتوا = "Show" پایان
    پایان
پایان
