واردسازی رابط گرافیکی.رابط کاربری

ناپایا نوشته := ""
ناپایا موارد := وکتور {} برگردان وکتور<رشته>

تابع افزودن():
    موارد.بیفزا(نوشته)
    نوشته = ""
    سرچاپ "items " + موارد.طول()
پایان

تابع نمایش():
    سرچاپ "first " + موارد[0]
    سرچاپ "last " + موارد[موارد.طول() - 1]
پایان

صفحه:
    عنوان = "Push then reset"
    جعبه:
        ورودی:
            شناسه = "name"
            نوع = "متن"
            مقدار = نوشته
            ورودی = (مقدار تازه: رشته):
                نوشته = مقدار تازه
            پایان
        پایان
        دکمه:
            شناسه = "add"
            کلیک = افزودن
            محتوا = "Add"
        پایان
        دکمه:
            شناسه = "show"
            کلیک = نمایش
            محتوا = "Show"
        پایان
    پایان
پایان
