واردسازی رابط گرافیکی.رابط کاربری

ناپایا یادداشت := ""

تابع بررسی():
    ناحیه := رابط کاربری.با شناسه("note")
    ماه := رابط کاربری.با شناسه("month")
    سرچاپ "note [" + یادداشت + "|" + ناحیه.مقدار عنصر() + "] hint " + ناحیه.ویژگی("placeholder")
    سرچاپ "month [" + ماه.مقدار عنصر() + "] type " + ماه.ویژگی("type") + " tag " + ماه.برچسب()
پایان

صفحه:
    عنوان = "Input types"
    جعبه:
        ورودی:
            شناسه = "note"
            نوع = "ناحیه متن"
            ردیف‌ها = 3
            جانگهدار = "Write here"
            پیوند = یادداشت
        پایان
        ورودی:
            شناسه = "month"
            نوع = "month"
        پایان
        ورودی:
            شناسه = "widget"
            نوع = "my-widget"
        پایان
        دکمه:
            شناسه = "check"
            کلیک = بررسی
            محتوا = "Check"
        پایان
    پایان
پایان
