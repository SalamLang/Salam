واردسازی رابط گرافیکی.رابط کاربری

ناپایا متن ورودی := ""

تابع نمایش():
    سرچاپ "draft is " + متن ورودی
پایان

صفحه:
    عنوان = "Input"
    جعبه:
        ورودی: شناسه = "name" نوع = "متن" ورودی = (v: رشته): متن ورودی = v پایان پایان
        دکمه: شناسه = "show" کلیک = نمایش محتوا = "Show" پایان
    پایان
پایان
