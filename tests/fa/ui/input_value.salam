واردسازی رابط گرافیکی.رابط کاربری

ناپایا نوشته := ""

تابع نمایش():
    سرچاپ "draft is " + نوشته
پایان

صفحه:
    عنوان = "Input"
    جعبه:
        ورودی:
            شناسه = "name"
            نوع = "متن"
            ورودی = (v: رشته): نوشته = v پایان
        پایان
        دکمه:
            شناسه = "show"
            کلیک = نمایش
            محتوا = "Show"
        پایان
    پایان
پایان
