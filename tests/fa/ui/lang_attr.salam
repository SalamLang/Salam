واردسازی رابط گرافیکی.رابط کاربری

تابع show(شناسه: رشته):
    r := رابط کاربری.با شناسه(شناسه).مستطیل()
    سرچاپ شناسه، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع report():
    show("base")
    show("en_box")
    show("ar_box")
    show("nested")
    show("ltr_wins")
پایان

بخش سلوت(نام: رشته):
    جعبه:
        شناسه = نام
        عرض = 100
        ارتفاع = 10
    پایان
پایان

صفحه:
    عنوان = "Lang"
    زبان = "fa"
    جعبه:
        سلوت:
            نام = "base"
        پایان
        جعبه:
            زبان = "en"
            سلوت:
                نام = "en_box"
            پایان
        پایان
        جعبه:
            زبان = "ar"
            محتوا = "text"
            سلوت:
                نام = "ar_box"
            پایان
        پایان
        جعبه:
            زبان = "fa"
            جعبه:
                زبان = "en"
                سلوت:
                    نام = "nested"
                پایان
            پایان
        پایان
        جعبه:
            جهت = "ltr"
            زبان = "fa"
            سلوت:
                نام = "ltr_wins"
            پایان
        پایان
    پایان
    دکمه:
        شناسه = "report"
        کلیک = report
        محتوا = "Report"
    پایان
پایان
