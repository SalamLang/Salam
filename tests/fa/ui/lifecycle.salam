// زبان: فارسی
واردسازی رابط گرافیکی.رابط کاربری

ناپایا شمار := 0

تابع ریشه:
    رابط کاربری.هنگام توقف((): سرچاپ "pause" پایان)
    رابط کاربری.هنگام ادامه((): سرچاپ "resume" پایان)
    رابط کاربری.هنگام کمبود حافظه((): سرچاپ "low memory" پایان)
    رابط کاربری.هنگام ذخیره وضعیت((): سرچاپ "saving " + شمار برگشت "count=" + شمار پایان)
    رابط کاربری.اجرای صفحه(
        (): برگشت رابط کاربری.بی وصله() پایان،
        (ب: رابط کاربری.سازنده‌صفحه): ب.گشودن عنصر("button")
        ب.شناسه عنصر("inc")
        ب.رسیدگی رخداد("click"، (): شمار++ پایان)
        ب.متن فرزند("+1")
        ب.بستن عنصر() پایان
    )
پایان
