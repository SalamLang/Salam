واردسازی رابط گرافیکی.رابط کاربری

ناپایا موارد := وکتور {} برگردان وکتور<رشته>

تابع افزودن‌مورد():
    موارد.افزودن("task " + موارد.طول())
    سرچاپ "items " + موارد.طول()
پایان

تابع بررسی():
    اگر رابط کاربری.با شناسه("empty").وجود دارد():
        سرچاپ "empty shown: yes"
    وگرنه:
        سرچاپ "empty shown: no"
    پایان
    سرچاپ "row 2: " + رابط کاربری.با شناسه("row2").متن عنصر()
پایان

صفحه:
    عنوان = "List"
    جعبه:
        دکمه: شناسه = "add" کلیک = افزودن‌مورد محتوا = "Add" پایان
        دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
        اگر موارد.طول() == 0:
            پاراگراف: شناسه = "empty" محتوا = "Nothing yet" پایان
        پایان
        فهرست:
            هر i، it در موارد:
                مورد: شناسه = "row" + i محتوا = it رنگ = i % 2 == 0 ? "crimson" : "navy" پایان
            پایان
        پایان
    پایان
پایان
