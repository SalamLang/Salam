واردسازی رابط گرافیکی.رابط کاربری

ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>

تابع پرکردن():
    نام‌ها.افزودن("a")
    نام‌ها.افزودن("b")
پایان

تابع چرخاندن():
    اول := نام‌ها.دریافت(0)
    نام‌ها.حذف در(0)
    نام‌ها.افزودن(اول)
پایان

تابع نمایش():
    سرچاپ رابط کاربری.با شناسه("t-a").متن عنصر() + ", " + رابط کاربری.با شناسه("t-b").متن عنصر()
پایان

بخش شمارنده(نام: رشته):
    ضربه‌ها := 0
    مورد:
        شناسه = "t-" + نام
        محتوا = نام + " " + ضربه‌ها
        کلیک = (): ضربه‌ها++ پایان
    پایان
پایان

صفحه:
    جعبه:
        دکمه: شناسه = "fill" کلیک = پرکردن محتوا = "Fill" پایان
        دکمه: شناسه = "swap" کلیک = چرخاندن محتوا = "Swap" پایان
        دکمه: شناسه = "show" کلیک = نمایش محتوا = "Show" پایان
        فهرست:
            هر _، قلم در نام‌ها:
                شمارنده:
                    کلید = قلم
                    نام = قلم
                پایان
            پایان
        پایان
    پایان
پایان
