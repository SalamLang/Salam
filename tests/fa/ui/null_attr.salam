واردسازی رابط گرافیکی.رابط کاربری

ناپایا کار := اثر { عنوان = "T" }

ساختار اثر:
    همگانی یادداشت: رشته؟
    همگانی عنوان: رشته؟
پایان

تابع نشان():
    سرچاپ "note [" + رابط کاربری.با شناسه("a").ویژگی("title") + "], text [" +
        رابط کاربری.با شناسه("a").متن عنصر() + "]"
پایان

تابع بده():
    کار.یادداشت = "hello"
پایان

تابع پاک():
    کار.یادداشت = پوچ
    کار.عنوان = پوچ
پایان

صفحه:
    عنوان = "Null"
    جعبه:
        پیوند:
            شناسه = "a"
            نشانی = "/x"
            عنوان = کار.یادداشت
            محتوا = کار.عنوان
        پایان
        دکمه:
            شناسه = "show"
            کلیک = نشان
            محتوا = "show"
        پایان
        دکمه:
            شناسه = "give"
            کلیک = بده
            محتوا = "give"
        پایان
        دکمه:
            شناسه = "clear"
            کلیک = پاک
            محتوا = "clear"
        پایان
    پایان
پایان
