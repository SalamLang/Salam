صفحه:
    عنوان = "Page size"
    پس‌زمینه = "red"
    اگر صفحه.عرض بزرگتربرابر ۴۰۰ و صفحه.ارتفاع کوچکتر ۹۰۰:
        پس‌زمینه = "green"
    پایان
    جعبه:
        شناسه = "nav"
        چیدمان = ردیف
        شکاف = 8
        اگر صفحه.فشرده:
            چیدمان = ستون
            شکاف = 2
        پایان
        جعبه: شناسه = "a" عرض = 40 ارتفاع = 20 پایان
        جعبه: شناسه = "b" عرض = 40 ارتفاع = 20 پایان
    پایان
    اگر صفحه.عرض کوچکتر ۵۰۰:
        جعبه: شناسه = "small" عرض = 10 ارتفاع = 10 پایان
    پایان
    اگر صفحه.افقی:
        جعبه: شناسه = "wide" عرض = 30 ارتفاع = 10 پایان
    پایان
پایان
