واردسازی رابط گرافیکی.رابط کاربری

ناپایا پیشین := 0
ناپایا پیشین گره := 0

تابع بررسی():
    ر := رابط کاربری.شمار اجرای دامنه()
    گ := رابط کاربری.شمار گره های دامنه()
    سرچاپ "runs " + (ر - پیشین) + ", nodes " + (گ - پیشین گره) + ", " +
        رابط کاربری.با شناسه("price").متن عنصر() + ", " + رابط کاربری.با شناسه("par").متن عنصر() +
        ", " + رابط کاربری.با شناسه("lab").متن عنصر()
    پیشین = ر
    پیشین گره = گ
پایان

بخش قیمت(مبلغ: صحیح):
    پاراگراف:
        شناسه = "price"
        محتوا = "price " + مبلغ
    پایان
پایان

بخش فروشگاه:
    تعداد := 1
    یادداشت := ""
    فرد := تعداد % 2
    برچسب متن := "parity " + فرد
    جعبه:
        دکمه:
            شناسه = "more"
            کلیک = (): تعداد++ پایان
            محتوا = "more"
        پایان
        دکمه:
            شناسه = "two"
            کلیک = (): تعداد += 2 پایان
            محتوا = "two"
        پایان
        ورودی:
            شناسه = "note"
            نوع = «متن»
        پایان
        دکمه:
            شناسه = "tick"
            کلیک = (): یادداشت = یادداشت + "x" پایان
            محتوا = "tick"
        پایان
        قیمت:
            مبلغ = تعداد * 10
        پایان
        پاراگراف:
            شناسه = "par"
            محتوا = "n " + یادداشت
        پایان
        پاراگراف:
            شناسه = "lab"
            محتوا = برچسب متن
        پایان
    پایان
پایان

صفحه:
    عنوان = "Chain"
    جعبه:
        دکمه:
            شناسه = "check"
            کلیک = بررسی
            محتوا = "Check"
        پایان
        فروشگاه: پایان
    پایان
پایان
