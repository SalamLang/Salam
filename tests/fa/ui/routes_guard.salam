ناپایا وارد شده := نادرست

تابع نمایش():
    سرچاپ صفحه.مسیر.نشانی + " " + صفحه.مسیر.الگو
پایان

بخش خانه:
    سرتیتر: محتوا = "خانه" پایان
پایان

بخش مدیریت:
    دکمه:
        شناسه = "signout"
        کلیک = ():
            وارد شده = نادرست
        پایان
        محتوا = "خروج"
    پایان
پایان

بخش ورود:
    دکمه:
        شناسه = "login"
        کلیک = ():
            وارد شده = درست
            صفحه.هدایت("/admin")
        پایان
        محتوا = "ورود"
    پایان
پایان

مسیرها:
    "/" : خانه
    "/admin" : مدیریت نگهبان = وارد شده هدایت = "/login"
    "/login" : ورود
پایان

صفحه:
    عنوان = "نگهبان"
    جعبه:
        دکمه: شناسه = "show" کلیک = نمایش محتوا = "نمایش" پایان
        دکمه: شناسه = "admin" کلیک = (): صفحه.برو("/admin") پایان محتوا = "مدیریت" پایان
        نمای مسیر: پایان
    پایان
پایان
