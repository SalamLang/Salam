ناپایا وارد شده := نادرست

تابع نمایش():
    سرچاپ صفحه.مسیر.نشانی + " " + صفحه.مسیر.الگو
پایان

صفحه:
    عنوان = "نگهبان"
    جعبه:
        دکمه: شناسه = "show" کلیک = نمایش محتوا = "نمایش" پایان
        دکمه: شناسه = "admin" کلیک = (): صفحه.مسیر.برو("/admin") پایان محتوا = "مدیریت" پایان
        نمای مسیر: پایان
    پایان
پایان
