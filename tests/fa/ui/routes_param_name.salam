تابع نمایش():
    سرچاپ مسیر‌کنونی.نشانی + " " + پارامتر‌مسیر("کاربر شناسه") + " [" + پرسمان‌مسیر("tab") + "]"
پایان

بخش هومی:
    سرتیتر: محتوا = "Home" پایان
پایان

بخش پروفیلی:
    سرتیتر: محتوا = "Profile" پایان
پایان

بخش دینیید:
    سرتیتر: محتوا = "Denied" پایان
پایان

مسیرها:
    "/" : هومی
    "/users/:کاربر شناسه" : پروفیلی نگهبان = پرسمان‌مسیر("open") برابر "" هدایت = "/denied"
    "/denied" : دینیید
پایان

صفحه:
    عنوان = "Param"
    جعبه:
        پیوند: شناسه = "ok" مقصد = "/users/7?tab=posts" محتوا = "Open" پایان
        پیوند: شناسه = "no" مقصد = "/users/8?open=1" محتوا = "Closed" پایان
        دکمه: شناسه = "show" کلیک = نمایش محتوا = "Show" پایان
        نمای مسیر: پایان
    پایان
پایان
