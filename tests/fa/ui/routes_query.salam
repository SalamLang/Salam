تابع نمایش():
    سرچاپ صفحه.مسیر.نشانی + " [" + صفحه.مسیر.پارامتر("id") + "] [" + صفحه.مسیر.مقدار پرسمان("open") + "]"
پایان

بخش خانه:
    سرتیتر: محتوا = "خانه" پایان
پایان

بخش مورد(id: صحیح):
    سرتیتر: محتوا = "مورد " + id پایان
پایان

مسیرها:
    "/" : خانه
    "/item/:id" : مورد نگهبان = صفحه.مسیر.مقدار پرسمان("open") برابر "yes" هدایت = "/"
پایان

صفحه:
    عنوان = "پرسمان"
    جعبه:
        دکمه: شناسه = "show" کلیک = نمایش محتوا = "نمایش" پایان
        دکمه: شناسه = "open" کلیک = (): صفحه.برو("/item/7?open=yes") پایان محتوا = "باز" پایان
        دکمه: شناسه = "shut" کلیک = (): صفحه.برو("/item/8") پایان محتوا = "بسته" پایان
        نمای مسیر: پایان
    پایان
پایان
