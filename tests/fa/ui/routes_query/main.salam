تابع نمایش():
    سرچاپ صفحه.مسیر.نشانی + " [" + صفحه.مسیر.پارامتر("id") + "] [" +
        صفحه.مسیر.مقدار پرسمان("open") + "]"
پایان

صفحه:
    عنوان = "پرسمان"
    جعبه:
        دکمه:
            شناسه = "show"
            کلیک = نمایش
            محتوا = "نمایش"
        پایان
        دکمه:
            شناسه = "open"
            کلیک = (): صفحه.مسیر.برو("/item/7?open=yes") پایان
            محتوا = "باز"
        پایان
        دکمه:
            شناسه = "shut"
            کلیک = (): صفحه.مسیر.برو("/item/8") پایان
            محتوا = "بسته"
        پایان
        نمای مسیر: پایان
    پایان
پایان
