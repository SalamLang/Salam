واردسازی رابط گرافیکی.رابط کاربری

ناپایا شناسه‌ها := وکتور {} برگردان وکتور<صحیح>
ناپایا برچسب‌ها := وکتور {} برگردان وکتور<رشته>
ناپایا انتخاب‌شده := 0
ناپایا اجرای دیده := 0
ناپایا ردشده دیده := 0

تابع بررسی():
    ر := رابط کاربری.شمار اجرای دامنه()
    ک := رابط کاربری.دامنه های ردشده()
    ناپایا همه := ""
    هر _، شماره در شناسه‌ها:
        همه += رابط کاربری.با شناسه("r" + شماره).متن عنصر() + ";"
    پایان
    سرچاپ "runs " + (ر - اجرای دیده) + ", skips " + (ک - ردشده دیده) + ", " + همه
    اجرای دیده = ر
    ردشده دیده = ک
پایان

تابع پرکردن():
    هر ن در ["a"، "b"، "c"، "d"، "e"]:
        شناسه‌ها.افزودن(شناسه‌ها.طول() + 1)
        برچسب‌ها.افزودن(ن)
    پایان
پایان

تابع برچسب تازه():
    برچسب‌ها.تنظیم(2، "C")
پایان

تابع حذف ردیف(شماره: صحیح):
    تکرار شناسه‌ها.طول() در ی:
        اگر شناسه‌ها.دریافت(ی) برابر شماره:
            شناسه‌ها.حذف در(ی)
            برچسب‌ها.حذف در(ی)
            برگشت
        پایان
    پایان
پایان

بخش ردیف(شماره: صحیح، برچسب: رشته، گزیده: منطقی):
    مورد:
        کلید = شماره
        شناسه = "r" + شماره
        محتوا = برچسب + (گزیده ? "*" : "")
        دکمه:
            شناسه = "s" + شماره
            کلیک = (): انتخاب‌شده = شماره پایان
            محتوا = "pick"
        پایان
        دکمه:
            شناسه = "x" + شماره
            کلیک = (): حذف ردیف(شماره) پایان
            محتوا = "x"
        پایان
    پایان
پایان

صفحه:
    عنوان = "Row skip"
    دکمه:
        شناسه = "fill"
        کلیک = پرکردن
        محتوا = "Fill"
    پایان
    فهرست:
        هر ی، شماره در شناسه‌ها:
            ردیف:
                شماره = شماره
                برچسب = برچسب‌ها.دریافت(ی)
                گزیده = (شماره برابر انتخاب‌شده)
            پایان
        پایان
    پایان
    دکمه:
        شناسه = "relabel"
        کلیک = برچسب تازه
        محتوا = "Relabel"
    پایان
    دکمه:
        شناسه = "check"
        کلیک = بررسی
        محتوا = "Check"
    پایان
پایان
