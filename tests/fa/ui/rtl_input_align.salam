واردسازی رابط گرافیکی.رابط کاربری

تابع show(id: رشته):
    r := رابط کاربری.با شناسه(id).مستطیل()
    سرچاپ id، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع report():
    show("a")
    show("b")
پایان

صفحه:
    عنوان = "Input align"
    جعبه:
        ورودی:
            شناسه = "a"
            عرض = 200
            مقدار = "سلام"
        پایان
        ورودی:
            شناسه = "b"
            جهت = "ltr"
            عرض = 200
            مقدار = "abc"
        پایان
    پایان
    دکمه:
        شناسه = "report"
        کلیک = report
        محتوا = "Report"
    پایان
پایان
