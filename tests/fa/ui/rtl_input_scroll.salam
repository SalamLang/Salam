واردسازی رابط گرافیکی.رابط کاربری

تابع show(شناسه: رشته):
    r := رابط کاربری.با شناسه(شناسه).مستطیل()
    سرچاپ شناسه، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع report():
    show("a")
پایان

صفحه:
    عنوان = "Input scroll"
    جهت = "rtl"
    جعبه:
        ورودی:
            شناسه = "a"
            عرض = 100
            مقدار = "ا                                                  ا"
        پایان
    پایان
    دکمه:
        شناسه = "report"
        کلیک = report
        محتوا = "Report"
    پایان
پایان
