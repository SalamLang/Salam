واردسازی رابط گرافیکی.رابط کاربری

تابع show(شناسه: رشته):
    r := رابط کاربری.با شناسه(شناسه).مستطیل()
    سرچاپ شناسه، r.ایکس، r.ایگرگ، r.پهنا، r.بلندی
پایان

تابع report():
    show("s")
پایان

صفحه:
    عنوان = "Select popup"
    جهت = "rtl"
    جعبه:
        انتخاب:
            شناسه = "s"
            عرض = 200
            گزینه:
                مقدار = "a"
                محتوا = "l"
            پایان
            گزینه:
                مقدار = "b"
                محتوا = "l"
            پایان
        پایان
    پایان
    دکمه:
        شناسه = "report"
        کلیک = report
        محتوا = "Report"
    پایان
پایان
