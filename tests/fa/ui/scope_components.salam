واردسازی رابط گرافیکی.رابط کاربری

ناپایا چپ := ۰
ناپایا راست := ۰
ناپایا قبلی := ۰

تابع بررسی():
    ر := رابط کاربری.شمار اجرای دامنه()
    سرچاپ "runs " + (ر - قبلی) + ", " + رابط کاربری.با شناسه("left").متن عنصر() + ", " + رابط کاربری.با شناسه("right").متن عنصر()
    قبلی = ر
پایان

بخش پنل(نام: رشته، عدد: صحیح):
    جعبه:
        سرتیتر: شناسه = نام محتوا = نام + " " + عدد پایان
        پاراگراف: محتوا = "panel " + نام پایان
    پایان
پایان

صفحه:
    عنوان = "Components"
    جعبه:
        پنل: نام = "left" عدد = چپ پایان
        پنل: نام = "right" عدد = راست پایان
        دکمه: شناسه = "incl" کلیک = (): چپ++ پایان محتوا = "Left" پایان
        دکمه: شناسه = "incr" کلیک = (): راست += ۱۰ پایان محتوا = "Right" پایان
        دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
    پایان
پایان
