واردسازی رابط گرافیکی.رابط کاربری

ناپایا شمار := ۰
ناپایا کلیک‌ها := ۰
ناپایا قبلی := ۰

تابع بررسی():
    ر := رابط کاربری.شمار اجرای دامنه()
    سرچاپ "runs " + (ر - قبلی) + ", label " + رابط کاربری.با شناسه("label").متن عنصر()
    قبلی = ر
پایان

تابع بی‌اثر():
    سرچاپ "nothing changed"
پایان

صفحه:
    عنوان = "Scopes"
    جعبه:
        سرتیتر: شناسه = "label" محتوا = "Count: " + شمار پایان
        دکمه: شناسه = "inc" کلیک = (): شمار++ پایان محتوا = "+1" پایان
        دکمه: شناسه = "noop" کلیک = بی‌اثر محتوا = "Noop" پایان
        دکمه: شناسه = "tally" کلیک = (): کلیک‌ها++ پایان محتوا = "Tally" پایان
        دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
        پاراگراف: محتوا = "Only the heading reads count." پایان
        فهرست:
            مورد: محتوا = "one" پایان
            مورد: محتوا = "two" پایان
            مورد: محتوا = "three" پایان
        پایان
    پایان
پایان
