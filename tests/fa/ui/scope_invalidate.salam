واردسازی رابط گرافیکی.رابط کاربری

ناپایا شمار := ۰

تابع نمایش():
    سرچاپ رابط کاربری.با شناسه("runs").متن عنصر() + ", " + رابط کاربری.با شناسه("count").متن عنصر()
پایان

صفحه:
    عنوان = "Invalidate"
    جعبه:
        سرتیتر: شناسه = "runs" محتوا = "Runs: " + رابط کاربری.شمار اجرای دامنه() پایان
        پاراگراف: شناسه = "count" محتوا = "Count: " + شمار پایان
        دکمه: شناسه = "inc" کلیک = (): شمار++ پایان محتوا = "+1" پایان
        دکمه: شناسه = "refresh" کلیک = (): رابط کاربری.بی اعتبار سازی() پایان محتوا = "Refresh" پایان
        دکمه: شناسه = "show" کلیک = نمایش محتوا = "Show" پایان
    پایان
پایان
