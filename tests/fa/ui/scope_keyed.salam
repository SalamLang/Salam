واردسازی رابط گرافیکی.رابط کاربری

ناپایا ردیف ها := وکتور {} برگردان وکتور<رشته>

تابع بررسی():
    ناپایا خط := ""
    هر ر در ردیف ها:
        اگر خط.طول() > ۰:
            خط += ", "
        پایان
        خط += رابط کاربری.با شناسه("row-" + ر).متن عنصر()
    پایان
    سرچاپ خط
پایان

تابع برعکس کن():
    ناپایا تازه := وکتور {} برگردان وکتور<رشته>
    هر ر در ردیف ها:
        تازه.insert(۰، ر)
    پایان
    ردیف ها.clear()
    هر ر۲ در تازه:
        ردیف ها.بیفزا(ر۲)
    پایان
    تازه.آزادکن()
پایان

بخش ردیف(نام: رشته):
    وضعیت زدن ها := ۰
    مورد: کلید = نام شناسه = "row-" + نام محتوا = نام + " " + زدن ها کلیک = (): زدن ها++ پایان پایان
پایان

صفحه:
    عنوان = "Keyed rows"
    جعبه:
        دکمه: شناسه = "fill" کلیک = (): ردیف ها.بیفزا("a") ردیف ها.بیفزا("b") ردیف ها.بیفزا("c") پایان محتوا = "Fill" پایان
        دکمه: شناسه = "rev" کلیک = برعکس کن محتوا = "Reverse" پایان
        دکمه: شناسه = "front" کلیک = (): ردیف ها.insert(۰، "z") پایان محتوا = "Front" پایان
        دکمه: شناسه = "drop" کلیک = (): ردیف ها.remove_at(۰) پایان محتوا = "Drop" پایان
        دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
        فهرست:
            هر م در ردیف ها:
                ردیف: نام = م پایان
            پایان
        پایان
    پایان
پایان
