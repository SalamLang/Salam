واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سی اس اس

ناپایا names := وکتور {} برگردان وکتور<رشته>
ناپایا touched := 0 برگردان صحیح۶۴
ناپایا likes := وکتور {} برگردان وکتور<صحیح>

تابع take(w: صحیح): صحیح۶۴:
    ناپایا t := 0 برگردان صحیح۶۴
    اگر w برابر 0:
        t = touched
        touched = 0
    پایان
    برگشت t
پایان

تابع sites():
    رابط کاربری.جایگاه دامنه(1، -1، 0، 1)
    رابط کاربری.جایگاه دامنه(2، 0، 0، 0)
پایان

تابع check():
    ناپایا line := ""
    هر n در names:
        اگر line.طول() بزرگتر 0:
            line += ", "
        پایان
        line += رابط کاربری.با شناسه(n).متن عنصر()
    پایان
    سرچاپ line
پایان

تابع reverse_names():
    ناپایا out := وکتور {} برگردان وکتور<رشته>
    هر n در names:
        out.insert(0، n)
    پایان
    names.پاک سازی()
    هر n2 در out:
        names.بیفزا(n2)
    پایان
    out.آزادکن()
    touched |= 1
پایان

تابع row(b: رابط کاربری.سازنده‌صفحه، name: رشته):
    b.دامنه کلیددار(2، name، (b: رابط کاربری.سازنده‌صفحه):
        k := b.نمونه بخش(0)
        اگر b.نمونه تازه():
            اگر k کوچکتر likes.طول():
                likes[k] = 0
            وگرنه:
                likes.بیفزا(0)
            پایان
        پایان
        b.گشودن عنصر("li")
        b.کلید عنصر(name)
        b.شناسه عنصر(name)
        b.رسیدگی رخداد("click"، ():
            likes[k] += 1
            رابط کاربری.لمس نمونه(0، k)
        پایان)
        b.متن فرزند(name + " " + likes[k])
        b.بستن عنصر()
    پایان)
پایان

تابع page(b: رابط کاربری.سازنده‌صفحه):
    b.راه اندازی واکنش(1، (w: صحیح): برگشت take(w) پایان، (): sites() پایان)
    b.گشودن عنصر("div")
    b.گشودن عنصر("button")
    b.شناسه عنصر("rev")
    b.رسیدگی رخداد("click"، (): reverse_names() پایان)
    b.متن فرزند("Reverse")
    b.بستن عنصر()
    b.گشودن عنصر("button")
    b.شناسه عنصر("drop")
    b.رسیدگی رخداد("click"، ():
        names.remove_at(0)
        touched |= 1
    پایان)
    b.متن فرزند("Drop")
    b.بستن عنصر()
    b.گشودن عنصر("button")
    b.شناسه عنصر("check")
    b.رسیدگی رخداد("click"، (): check() پایان)
    b.متن فرزند("Check")
    b.بستن عنصر()
    b.گشودن عنصر("ul")
    b.دامنه واکنشی(1، (b: رابط کاربری.سازنده‌صفحه):
        هر n در names:
            row(b، n)
        پایان
    پایان)
    b.بستن عنصر()
    b.بستن عنصر()
پایان

تابع ریشه:
    names.بیفزا("tea")
    names.بیفزا("cake")
    names.بیفزا("milk")
    رابط کاربری.اجرای ترجمه شده((): برگشت سی اس اس.برنامه سبک تازه() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان)
پایان
