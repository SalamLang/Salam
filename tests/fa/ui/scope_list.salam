واردسازی رابط گرافیکی.رابط کاربری

ناپایا موارد := وکتور {} برگردان وکتور<رشته>
ناپایا گزیده := -۱
ناپایا قبلی := ۰

تابع بررسی():
    ر := رابط کاربری.شمار اجرای دامنه()
    سرچاپ "runs " + (ر - قبلی) + ", rows " + موارد.طول() + ", row 1: " + رابط کاربری.با شناسه("row1").متن عنصر()
    قبلی = ر
پایان

صفحه:
    عنوان = "List"
    جعبه:
        دکمه: شناسه = "add" کلیک = (): موارد.بیفزا("task " + موارد.طول()) پایان محتوا = "Add" پایان
        دکمه: شناسه = "pick" کلیک = (): گزیده = ۱ پایان محتوا = "Pick" پایان
        دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
        فهرست:
            هر i، it در موارد:
                مورد: شناسه = "row" + i محتوا = it رنگ = گزیده == i ? "crimson" : "navy" پایان
            پایان
        پایان
    پایان
پایان
