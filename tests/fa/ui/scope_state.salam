واردسازی رابط گرافیکی.رابط کاربری

ناپایا نسخه := ۰
ناپایا قبلی := ۰

تابع بررسی():
    ر := رابط کاربری.شمار اجرای دامنه()
    سرچاپ "runs " + (ر - قبلی) + ", " + رابط کاربری.با شناسه("a").متن عنصر() + ", " + رابط کاربری.با شناسه("b").متن عنصر()
    قبلی = ر
پایان

بخش شمارنده(نام: رشته، آغاز: صحیح):
    شمار := آغاز
    برچسب := "clicks"
    جعبه:
        دکمه: شناسه = نام کلیک = (): شمار++ پایان محتوا = نام + " " + شمار + " " + برچسب پایان
    پایان
پایان

صفحه:
    عنوان = "State"
    جعبه:
        جعبه:
            عنوان = "v" + نسخه
            شمارنده: نام = "a" آغاز = ۰ پایان
            شمارنده: نام = "b" آغاز = ۱۰ پایان
        پایان
        دکمه: شناسه = "bump" کلیک = (): نسخه++ پایان محتوا = "Bump" پایان
        دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
    پایان
پایان
