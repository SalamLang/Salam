واردسازی رابط گرافیکی.رابط کاربری

تابع بررسی():
    ناپایا خط := "body " + رابط کاربری.با شناسه("A-body").متن عنصر() + ", rows"
    تکرار ۴ در ای:
        ت := رابط کاربری.با شناسه("row" + ای).متن عنصر()
        اگر ت.طول() > ۰:
            خط += " " + ت
        پایان
    پایان
    سرچاپ خط
پایان

بخش تاشو(برچسب: رشته):
    وضعیت باز := نادرست
    جعبه:
        دکمه: شناسه = برچسب + "-btn" کلیک = (): باز = وارونه باز پایان محتوا = برچسب پایان
        اگر باز:
            پاراگراف: شناسه = برچسب + "-body" محتوا = "Body of " + برچسب پایان
        پایان
    پایان
پایان

بخش کارها:
    وضعیت موارد := وکتور {} برگردان وکتور<رشته>
    وضعیت بعدی := ۰ برگردان صحیح۶۴
    جعبه:
        دکمه: شناسه = "add" کلیک = (): موارد.بیفزا("t" + بعدی) بعدی += ۱ پایان محتوا = "Add" پایان
        دکمه: شناسه = "rot" کلیک = (): موارد.درج(۰، موارد.دربیاور()) پایان محتوا = "Rotate" پایان
        فهرست:
            هر ش، م در موارد:
                مورد: کلید = م شناسه = "row" + ش محتوا = م پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "State operations"
    دکمه: شناسه = "check" کلیک = بررسی محتوا = "Check" پایان
    تاشو: برچسب = "A" پایان
    کارها: پایان
پایان
