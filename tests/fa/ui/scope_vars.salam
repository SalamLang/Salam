واردسازی رابط گرافیکی.رابط کاربری

ناپایا touched := 0 برگردان صحیح۶۴
ناپایا hits := وکتور {} برگردان وکتور<صحیح>
ناپایا notes := وکتور {} برگردان وکتور<صحیح>

تابع take(w: صحیح): صحیح۶۴:
    ناپایا t := 0 برگردان صحیح۶۴
    اگر w برابر 0:
        t = touched
        touched = 0
    پایان
    برگشت t
پایان

تابع sites():
    رابط کاربری.جایگاه دامنه(1، 0، 0، 0)
    رابط کاربری.جایگاه دامنه(2، -1، 0، 0)
    رابط کاربری.متغیرهای دامنه(2، 0، 1)
    رابط کاربری.جایگاه دامنه(3، -1، 0، 0)
    رابط کاربری.متغیرهای دامنه(3، 0، 2)
    رابط کاربری.اشتقاق دامنه(0، (_k: صحیح، m: صحیح): برگشت m پایان)
پایان

تابع card(b: رابط کاربری.سازنده‌صفحه، name: رشته):
    b.دامنه واکنشی(1، (b: رابط کاربری.سازنده‌صفحه):
        k := b.نمونه بخش(0)
        اگر b.نمونه تازه():
            hits.بیفزا(0)
            notes.بیفزا(0)
        پایان
        b.گشودن عنصر("box")
        b.گشودن عنصر("button")
        b.شناسه عنصر("hit-" + name)
        b.رسیدگی رخداد("click"، ():
            hits[k] += 1
            رابط کاربری.لمس متغیرهای نمونه(0، k، 1)
        پایان)
        b.متن فرزند("hit")
        b.بستن عنصر()
        b.گشودن عنصر("button")
        b.شناسه عنصر("note-" + name)
        b.رسیدگی رخداد("click"، ():
            notes[k] += 1
            رابط کاربری.لمس متغیرهای نمونه(0، k، 2)
        پایان)
        b.متن فرزند("note")
        b.بستن عنصر()
        b.دامنه واکنشی(2، (b: رابط کاربری.سازنده‌صفحه):
            b.گشودن عنصر("paragraph")
            b.متن فرزند("hits " + hits[k])
            b.بستن عنصر()
        پایان)
        b.دامنه واکنشی(3، (b: رابط کاربری.سازنده‌صفحه):
            b.گشودن عنصر("paragraph")
            b.متن فرزند("notes " + notes[k])
            b.بستن عنصر()
        پایان)
        b.بستن عنصر()
    پایان)
پایان

تابع page(b: رابط کاربری.سازنده‌صفحه):
    b.راه اندازی واکنش(1، (w: صحیح): برگشت take(w) پایان، (): sites() پایان)
    b.گشودن عنصر("div")
    card(b، "a")
    card(b، "b")
    b.بستن عنصر()
پایان

تابع ریشه:
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان)
    سرچاپ "hits"، hits[0]، hits[1]، "notes"، notes[0]، notes[1]
    سرچاپ "scope runs"، رابط کاربری.شمار اجرای دامنه()، "nodes"، رابط کاربری.شمار گره های دامنه()
پایان
