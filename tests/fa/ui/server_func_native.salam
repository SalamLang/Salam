واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.رندر‌سرور
واردسازی شبکه.داخلی.کارخواه‌رندرسرور
واردسازی کدگذاری.جیسون

ناپایا کل := 0
ناپایا باککیند پورت := 0
ناپایا باککیند ریادی := شروع باککیند()

تابع انسویر افزودن(ک: صحیح۶۴):
    ارگس := رندر‌سرور.پارامترها(ک)
    رندر‌سرور.پاسخ موفق(
        ک، جیسون.سریال سازی(جیسون.دریافت عدد(ارگس، "a") + جیسون.دریافت عدد(ارگس، "b"))
    )
پایان

تابع انسویر نام(ک: صحیح۶۴):
    ارگس := رندر‌سرور.پارامترها(ک)
    رندر‌سرور.پاسخ موفق(ک، جیسون.رشته جیسون("hello " + جیسون.دریافت(ارگس، "name")))
پایان

تابع شروع باککیند(): منطقی:
    رندر‌سرور.ثبت کارکرد("Add"، انسویر افزودن)
    رندر‌سرور.ثبت کارکرد("Greet"، انسویر نام)
    ناپایا ر := مسیریاب.مسیریاب جدید()
    رندر‌سرور.نصب(ر)
    ناپایا س := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.استفاده(س، ر)
    باککیند پورت = اچ تی تی پی.اجرا در پس زمینه با درگاه(س)
    کارخواه‌رندرسرور.تنظیم سرور("http://127.0.0.1:" + باککیند پورت)
    برگشت باککیند پورت بزرگتر 0
پایان

@en "Add"
سرور تابع افزودن(a: صحیح، b: صحیح): صحیح: برگشت a + b + 1000
پایان

@en "Greet"
سرور تابع گرییت(name: رشته): رشته: برگشت "the real body is not in the app " + name
پایان

صفحه:
    عنوان = "Server func"
    جعبه:
        دکمه:
            شناسه = "add"
            کلیک = (): کل = افزودن(2، 40) سرچاپ "total " + کل پایان
            محتوا = "Add"
        پایان
        دکمه:
            شناسه = "greet"
            کلیک = (): سرچاپ گرییت("salam") پایان
            محتوا = "Greet"
        پایان
    پایان
پایان
