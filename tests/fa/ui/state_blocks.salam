صفحه:
    عنوان = "State blocks"
    جعبه:
        دکمه:
            شناسه = "a"
            پس‌زمینه = #2563eb
            اشاره:
                پس‌زمینه = #000080
            پایان
            محتوا = "A"
        پایان
        دکمه:
            شناسه = "b"
            پس‌زمینه = #2563eb
            اشاره پس‌زمینه = #000080
            محتوا = "B"
        پایان
    پایان
پایان
