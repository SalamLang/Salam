ناپایا بزرگ := نادرست

صفحه:
    عنوان = "Style if"
    جعبه:
        شناسه = "a"
        اگر بزرگ:
            پس‌زمینه = orange
            شفافیت = 0.5
            فاصله = 24
        پایان
        محتوا = "A"
    پایان
    دکمه: شناسه = "t" کلیک = (): بزرگ = وارونه بزرگ پایان محتوا = "T" پایان
پایان
