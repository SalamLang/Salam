پایا گام := ۸

صفحه:
    عنوان = "Style lists"
    جعبه:
        شناسه = "a"
        فاصله = گام، ۱۶
        قلم = «Times New Roman»، «serif»
        محتوا = "A"
    پایان
    دکمه: شناسه = "b1" از دست رفتن فوکوس = (): سرچاپ «blurred» پایان محتوا = "B1" پایان
    جعبه: شناسه = "c" تاری = 2 محتوا = "C" پایان
    دکمه: شناسه = "b2" محتوا = "B2" پایان
پایان
