صفحه:
    عنوان = "Values"
    جعبه: شناسه = "a" فاصله = 8، 16 کادر = 2، solid، #3366aa عرض = 50% محتوا = "A" پایان
    جعبه: شناسه = "b" فضا = 4، 8، 12، 16 پس‌زمینه = #fa0 محتوا = "B" پایان
    دکمه: شناسه = "go" کلیک = (): سرچاپ "ratio " + 25% پایان محتوا = "Go" پایان
پایان
