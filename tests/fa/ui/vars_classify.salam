واردسازی رابط گرافیکی.رابط کاربری

ناپایا دیده := ۰

تابع اجراها(): رشته:
    ر := رابط کاربری.شمار اجرای دامنه()
    ف := ر - دیده
    دیده = ر
    برگشت "runs " + ف
پایان

بخش نشان(مقدار: صحیح):
    نوشته := "badge " + مقدار
    پاراگراف: شناسه = "badge" محتوا = نوشته پایان
پایان

بخش گزینش(گزارش):
    دکمه: شناسه = "pick" کلیک = (): گزارش(۵) پایان محتوا = "pick" پایان
پایان

بخش تابلو(نام: رشته):
    شمار := ۰
    دفعه فشار := ۰
    سرنویس := نام + " panel"
    جعبه:
        پاراگراف: شناسه = "title" محتوا = سرنویس + " " + شمار پایان
        دکمه: شناسه = "inc" کلیک = (): شمار++ پایان محتوا = "+" پایان
        دکمه:
            شناسه = "quiet"
            کلیک = ():
                دفعه فشار++
                سرچاپ "presses " + دفعه فشار
            پایان
            محتوا = "quiet"
        پایان
        نشان: مقدار = شمار * ۱۰ پایان
        گزینش: گزارش = (شمار: صحیح): سرچاپ "picked " + شمار پایان پایان
    پایان
پایان

صفحه:
    کل := ۰
    برچسب := "total " + کل
    عنوان = "Variables"
    پاراگراف: شناسه = "total" محتوا = برچسب پایان
    دکمه: شناسه = "add" کلیک = (): کل += ۲ پایان محتوا = "add" پایان
    دکمه: شناسه = "check" کلیک = (): سرچاپ اجراها() + ", " + رابط کاربری.با شناسه("title").متن عنصر() + ", " + رابط کاربری.با شناسه("badge").متن عنصر() + ", " + رابط کاربری.با شناسه("total").متن عنصر() پایان محتوا = "check" پایان
    تابلو: نام = "main" پایان
پایان
