// انتظار: .a::before { content: "»";
// انتظار: <input class="b" type="text" autofocus>
چیدمان:
    دکمه:
        محتوا = "برو"
        اشاره رنگ = "قرمز"
        پیش‌از محتوا = "»"
    پایان
    ورودی:
        نوع = "متن"
        تمرکز خودکار = درست
        تمرکز رنگ = "آبی"
    پایان
پایان
