چیدمان:
    نقشه تصویر: نام = "m1"
        ناحیه:
            نشانی = "/a.html"
            جایگزین = "x1"
            مختصات = "x1"
            قالب ناحیه = "پیش‌فرض"
            هدف = "پنجره جدید"
            دانلود = "x1"
            رابطه = "t1"
            سیاست ارجاع = "no-referrer"
            پینگ = "/a.html"
        پایان
    پایان
پایان
