// انتظار: <form
// انتظار:  action="/a.html"
// انتظار:  method="get"
// انتظار:  enctype="application/x-www-form-urlencoded"
// انتظار:  autocomplete="x1"
// انتظار:  novalidate
// انتظار:  accept-charset="utf-8"
// انتظار:  target="_blank"
چیدمان:
    فرم:
        مقصد ارسال = "/a.html"
        روش = "دریافت"
        رمزگذاری = "application/x-www-form-urlencoded"
        تکمیل خودکار = "x1"
        بدون اعتبارسنجی = درست
        نویسه‌گان پذیرفته = "utf-8"
        هدف = "پنجره جدید"
        محتوا = "متن"
    پایان
پایان
