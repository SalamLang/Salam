// انتظار: <img
// انتظار:  src="/a.html"
// انتظار:  srcset="/a.png 1x, /b.png 2x"
// انتظار:  sizes="x1"
// انتظار:  loading="lazy"
// انتظار:  decoding="sync"
// انتظار:  crossorigin="anonymous"
// انتظار:  fetchpriority="high"
// انتظار:  usemap="x1"
چیدمان:
    تصویر:
        نشانی = "/a.html"
        مجموعه منبع = "/a.png 1x, /b.png 2x"
        اندازه‌ها = "x1"
        بارگذاری = "با تاخیر"
        رمزگشایی = "همگام"
        میان‌مبدا = "ناشناس"
        اولویت دریافت = "زیاد"
        نقشه = "x1"
    پایان
پایان
