// انتظار: <input
// انتظار:  accept="x1"
// انتظار:  autocomplete="x1"
// انتظار:  autofocus
// انتظار:  dirname="t1"
// انتظار:  form="target1"
// انتظار:  formaction="/a.html"
// انتظار:  formmethod="get"
// انتظار:  formenctype="application/x-www-form-urlencoded"
// انتظار:  formnovalidate
// انتظار:  formtarget="_blank"
// انتظار:  list="target1"
// انتظار:  max="x1"
// انتظار:  min="x1"
// انتظار:  maxlength="2"
// انتظار:  minlength="2"
// انتظار:  multiple
// انتظار:  pattern="x1"
// انتظار:  readonly
// انتظار:  size="2"
// انتظار:  step="x1"
// انتظار:  popovertarget="target1"
چیدمان:
    جعبه: شناسه = "target1" پایان
    ورودی:
        نوع = "متن"
        پذیرش = "x1"
        تکمیل خودکار = "x1"
        تمرکز خودکار = درست
        نام جهت = "t1"
        فرم = "target1"
        مقصد ارسال فرم = "/a.html"
        روش فرم = "دریافت"
        رمزگذاری فرم = "application/x-www-form-urlencoded"
        بدون اعتبارسنجی فرم = درست
        هدف فرم = "پنجره جدید"
        فهرست پیشنهادها = "target1"
        بیشینه = "x1"
        کمینه = "x1"
        بیشینه طول = "2"
        کمینه طول = "2"
        چندتایی = درست
        الگو = "x1"
        فقط خواندنی = درست
        اندازه = "2"
        گام = "x1"
        هدف واشو = "target1"
    پایان
پایان
