// انتظار: <a
// انتظار:  href="/a.html"
// انتظار:  download="x1"
// انتظار:  rel="t1"
// انتظار:  hreflang="en"
// انتظار:  referrerpolicy="no-referrer"
// انتظار:  ping="/a.html"
// انتظار:  type="text/plain"
چیدمان:
    پیوند:
        نشانی = "/a.html"
        دانلود = "x1"
        رابطه = "t1"
        زبان مقصد = "en"
        سیاست ارجاع = "no-referrer"
        پینگ = "/a.html"
        نوع = "text/plain"
        محتوا = "متن"
    پایان
پایان
