// انتظار: <object
// انتظار:  data="/a.html"
// انتظار:  type="text/plain"
// انتظار:  name="x1"
// انتظار:  form="target1"
چیدمان:
    جعبه: شناسه = "target1" پایان
    شیء:
        نشانی = "/a.html"
        نوع = "text/plain"
        نام = "x1"
        فرم = "target1"
        محتوا = "متن"
    پایان
پایان
