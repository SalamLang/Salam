// انتظار: <option
// انتظار:  value="x1"
// انتظار:  selected
// انتظار:  disabled
// انتظار:  label="x1"
چیدمان:
    انتخاب:
        گزینه:
            مقدار = "x1"
            انتخاب‌شده = درست
            غیرفعال = درست
            برچسب = "x1"
            محتوا = "متن"
        پایان
    پایان
پایان
