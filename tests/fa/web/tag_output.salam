// انتظار: <output
// انتظار:  for="target1"
// انتظار:  name="x1"
// انتظار:  form="target1"
چیدمان:
    جعبه: شناسه = "target1" پایان
    خروجی:
        برای = "target1"
        نام = "x1"
        فرم = "target1"
        محتوا = "متن"
    پایان
پایان
