// انتظار: <source
// انتظار:  src="/a.html"
// انتظار:  srcset="/a.png 1x, /b.png 2x"
// انتظار:  sizes="x1"
// انتظار:  type="text/plain"
// انتظار:  media="(min-width: 600px)"
// انتظار-نه: />
چیدمان:
    عکس:
        منبع:
            نشانی = "/a.html"
            مجموعه منبع = "/a.png 1x, /b.png 2x"
            اندازه‌ها = "x1"
            نوع = "text/plain"
            رسانه = "(min-width: 600px)"
        پایان
    پایان
پایان
