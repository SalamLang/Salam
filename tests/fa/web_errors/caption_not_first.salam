// انتظار: خطا۱۲۵
// انتظار-پیام: عنصر 'عنوان جدول' باید نخستین عنصر داخل 'جدول' باشد
چیدمان:
    جدول:
        ردیف: ستون: محتوا = "۱" پایان پایان
        عنوان جدول: محتوا = "دیر" پایان
    پایان
پایان
