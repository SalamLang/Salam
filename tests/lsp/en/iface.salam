interface Shape:
    func Area(): int
end

struct Sq:
    pub s: int = 1

    pub func Area(): int:
        ret this.s * this.s
    end
end

struct Rect:
    pub w: int = 1
    pub h: int = 1

    pub func Area(): int:
        ret this.w * this.h
    end
end

struct Dot:
    pub x: int = 0
end

func total(v: dyn Shape): int:
    ret v.Area()
end

func main:
    d := Dot {}
    println total(Sq { s = 3 }), total(Rect { w = 2, h = 5 }), d.x
end
