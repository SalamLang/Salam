import str

struct Point:
    pub x: int = 0
    pub y: int = 0

    pub func sum(): int:
        ret this.x + this.y
    end
end

func make(n: int): Point:
    p := Point { x = n, y = 2 }
    ret p
end

func label(p: Point, prefix: str): str:
    ret prefix + str.FromInt(p.sum() as i64)
end

func main:
    p := make(3)
    println label(p, "sum="), p.x
end
