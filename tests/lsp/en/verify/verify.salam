// Release signature check (API.md, GET /releases/latest):
// ECDSA P-256 over SHA-256("bsvpn-release|version|platform|arch|sha256|size"),
// signature base64 as produced by tls.P256Sign (64 byte r||s), checked with
// tls.P256Verify against a pinned public key.
//
// The pinned keys below are PLACEHOLDERS until BSafe Group publishes the
// production keys; with a placeholder every signature reports "unpinned"
// and the app never installs anything on its own (it only opens the
// download page).
// © 2026 BSafe Group BV. All rights reserved.

package verify

import mem
import str
import crypto
import encoding
import tls

pub const PLACEHOLDER := "PLACEHOLDER"
// Uncompressed P-256 point (65 bytes), base64.
pub const RELEASE_PUBLIC_KEY := "PLACEHOLDER"
pub const RULES_PUBLIC_KEY := "PLACEHOLDER"

// Message is the signed text of a release.
pub func Message(version: str, platform: str, arch: str, sha256: str, size: i64): str:
    ret "bsvpn-release|" + version + "|" + platform + "|" + arch + "|" + sha256 + "|" +
        str.FromInt(size)
end

// DigestB64 is base64(SHA-256(text)).
pub func DigestB64(text: str): str:
    out := mem.AllocateZeroed(32 as u64)
    defer mem.Free(out)
    crypto.Sha256Bytes(text as void*, str.ByteLen(text), out)
    ret encoding.Base64EncodeBytes(out, 32)
end

// Check verifies a signature with a given public key.
pub func Check(public_key_b64: str, message: str, signature_b64: str): bool:
    if signature_b64.Len() == 0 or public_key_b64.Len() == 0:
        ret false
    end
    ret tls.P256Verify(public_key_b64, DigestB64(message), signature_b64)
end

// Release returns "ok", "bad", "unsigned" or "unpinned".
pub func Release(
    version: str, platform: str, arch: str, sha256: str, size: i64, signature_b64: str
): str:
    if RELEASE_PUBLIC_KEY == PLACEHOLDER:
        ret "unpinned"
    end
    if signature_b64.Len() == 0:
        ret "unsigned"
    end
    if Check(RELEASE_PUBLIC_KEY, Message(version, platform, arch, sha256, size), signature_b64):
        ret "ok"
    end
    ret "bad"
end

// Sign is used by the self-test to round trip a signature.
pub func Sign(private_key_b64: str, message: str, ok &: bool): str:
    ret tls.P256Sign(private_key_b64, DigestB64(message), ok)
end

pub func PublicKey(private_key_b64: str): str:
    ret tls.EcdhP256PublicPoint(private_key_b64)
end
