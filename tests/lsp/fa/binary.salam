تابع دودویی(ن: صحیح, پهنا: صحیح): رشته:
    ناپایا س := ""
    ناپایا نمایه := پهنا - 1
    تا نمایه بزرگتربرابر 0:
        س += ((ن >> نمایه) & 1)
        نمایه--
    پایان
    برگشت س
پایان

تابع ریشه:
    عدد اول := 12
    سرچاپ "عدد =", عدد اول, دودویی(عدد اول, 8)
پایان
