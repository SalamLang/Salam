تابع دودویی(ن: صحیح, پهنا: صحیح): رشته:
    ناپایا س := ""
    ناپایا نمایه := پهنا - 1
    تا نمایه >= 0:
        س = س + ((ن >> نمایه) & 1)
        نمایه = نمایه - 1
    پایان
    برگشت س
پایان

تابع ریشه:
    عدد اول := 12
    سرچاپ "عدد =", عدد اول, دودویی(عدد اول, 8)
پایان
