include util "util.salam"
include geo "geo/geo.salam"

func run(n: int): int:
    ret util.Twice(n) + util.Twice(1)
end

func main:
    x := run(2)
    if x > 0:
        inner := x + 1
        println inner
    end
    println x, geo.Square(3), geo.Area(2, 5)
end
