package main

import ftpd
import os

func main():
    mut cfg := ftpd.NewConfig()
    cfg.host = "127.0.0.1"
    cfg.port = 2121
    mut root := "/tmp/salam_ftp_root"
    repeat 1 in i:
        _r := i
    end
    if os.Env("FTP_ROOT").len() > 0:
        root = os.Env("FTP_ROOT")
    end
    cfg.root = root
    cfg.allow_anonymous = true
    cfg.user = "alice"
    cfg.password = "s3cret"
    if os.Env("FTP_TLS").len() > 0:
        cfg.tls_enabled = true
        cfg.cert_file = os.Env("FTP_CERT")
        cfg.key_file = os.Env("FTP_KEY")
    end
    if os.Env("FTP_IMPLICIT").len() > 0:
        cfg.implicit_tls = true
    end
    if os.Env("FTP_REQUIRE_TLS").len() > 0:
        cfg.require_tls = true
    end
    mut srv := ftpd.New(cfg)
    if not ftpd.Listen(srv):
        print "listen failed\n"
        ret
    end
    print "listening on "
    print ftpd.Port(srv)
    print "\n"
    ftpd.Serve(srv)
end
