package main

import os.process
import net.internal.rawsock

func main():
    mut cmd := process.NewCommand("/bin/sh")
    cmd.Arg("-c")
    cmd.Arg("echo HELLO; echo ERRTEXT 1>&2; sleep 0.1; exit 3")
    cmd.stdin_mode = 1
    cmd.stdout_mode = 1
    cmd.stderr_mode = 1
    mut child := process.Launch(cmd)
    print "ok="
    print child.ok
    print " h_out="
    print child.h_out
    print " h_err="
    print child.h_err
    print "\n"
    if not child.ok:
        ret
    end
    mut rounds := 0
    until rounds < 40:
        rounds++
        sock_out := rawsock.FromFd(child.h_out)
        sock_err := rawsock.FromFd(child.h_err)
        mask := rawsock.WaitReadable2(sock_out, sock_err, 20)
        if (mask & 1) != 0:
            c := child.ReadAvailable(0)
            if c.len > 0:
                print "OUT:"
                print c.data
                print "\n"
                c.Free()
            end
        end
        if (mask & 2) != 0:
            e := child.ReadErrAvailable(0)
            if e.len > 0:
                print "ERR:"
                print e.data
                print "\n"
                e.Free()
            end
        end
        _s := child.Wait(0)
        if child.finished:
            print "finished code="
            print child.status.ReturnCode()
            print "\n"
            break
        end
    end
    child.Close()
    cmd.Free()
end
