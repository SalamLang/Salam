package main

import sshd

func main():
    mut cfg := sshd.NewConfig()
    cfg.host = "127.0.0.1"
    cfg.port = 2222
    cfg.root = "/tmp/salam_ssh_root"
    cfg.authorized_keys_file = "/tmp/salam_build/authorized_keys"
    cfg.host_key_file = "/tmp/salam_build/id_rsa"
    cfg.banner = "Authorized use only."
    sshd.AddUser(cfg, "test", "secret", "/")
    mut srv := sshd.New(cfg)
    if not sshd.Listen(srv):
        print "listen failed\n"
        ret
    end
    print "listening on "
    print sshd.Port(srv)
    print "\n"
    sshd.Serve(srv)
end
