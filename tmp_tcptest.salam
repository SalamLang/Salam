package main

import net.tcp

func main():
    s := tcp.BindOn("127.0.0.1", 2222)
    if not tcp.Ok(s):
        print "bind failed\n"
        ret
    end
    print "listening on port "
    print tcp.Port(s)
    print "\n"
    c := tcp.Accept(s)
    if tcp.ConnOk(c):
        print "accepted\n"
    else:
        print "accept failed\n"
    end
end
