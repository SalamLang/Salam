package main

import cpu
import mem
import os
import str
import sync
import tls

mut total := 64 * 1024 * 1024

func fillbuf(p: void*, n: int):
    b := p as u8*
    repeat n in i:
        b[i] = ((i * 31 + 7) & 255) as u8
    end
end

func run(kind: int, name: str, size: int):
    key := mem.AllocateZeroed(32 as u64)
    nonce := mem.AllocateZeroed(12 as u64)
    aad := mem.AllocateZeroed(16 as u64)
    pt := mem.AllocateZeroed(size as u64)
    out := mem.AllocateZeroed((size + 16) as u64)
    fillbuf(key, 32)
    fillbuf(nonce, 12)
    fillbuf(aad, 16)
    fillbuf(pt, size)
    ctx := tls.AeadNew(kind, key)
    reps := total / size
    start := sync.NowMs()
    repeat reps:
        tls.AeadSeal(ctx, nonce, aad, 16, pt, size, out)
    end
    ms := sync.NowMs() - start
    tag := out as u8*
    mut sum := 0
    repeat size + 16 in i:
        sum = (sum * 31 + (tag[i] as int)) & 0xffffff
    end
    mbps := ms > 0 ? (total as i64) * 1000 / ms / 1048576 : 0
    println name, size, "bytes", mbps, "MB/s", "check", sum
    tls.AeadFree(ctx)
    mem.Free(key)
    mem.Free(nonce)
    mem.Free(aad)
    mem.Free(pt)
    mem.Free(out)
end

func main():
    args := os.Args()
    if args.Len() > 1:
        total = str.ToInt(args.Get(1)) * 1024 * 1024
    end
    mut only := 0 - 1
    mut only_size := 0
    if args.Len() > 3:
        only = str.ToInt(args.Get(2))
        only_size = str.ToInt(args.Get(3))
    end
    println "hardware crypto", cpu.HasHardwareCrypto()
    each size in [1024, 16384, 1048576]:
        if only_size != 0 and size != only_size:
            continue
        end
        if only < 0 or only == 0:
            run(tls.AEAD_AES_128_GCM, "aes-128-gcm", size)
        end
        if only < 0 or only == 1:
            run(tls.AEAD_AES_256_GCM, "aes-256-gcm", size)
        end
        if only < 0 or only == 2:
            run(tls.AEAD_CHACHA20_POLY1305, "chacha20-poly1305", size)
        end
    end
end
