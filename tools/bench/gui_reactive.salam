import gui.reactive
import time

const PAIRS := 1000000
const CHAIN := 10000
const ROUNDS := 20

mut chain := Vector {} as Vector<reactive.IntProp>
mut cursor := 0

func link_next():
    prev := chain.get(cursor)
    mut p := reactive.NewInt(0)
    p.Bind((): ret prev.Get() + 1 end)
    chain.push(p)
    cursor++
end

func ns_per(total: i64, n: int): f64:
    ret (total as f64) / (n as f64)
end

func bench_get_set():
    p := reactive.NewInt(0)
    mut sum := 0 as i64
    t0 := time.NowNanos()
    repeat PAIRS in i:
        p.Set(i)
        sum += p.Get() as i64
    end
    dt := time.NowNanos() - t0
    println "get/set pairs:", PAIRS, "in", dt / 1000000, "ms,", ns_per(dt, PAIRS), "ns per pair (checksum", sum, ")"
    p.Free()
end

func bench_bound_get():
    a := reactive.NewInt(1)
    b := reactive.NewInt(0)
    b.Bind((): ret a.Get() * 2 end)
    mut sum := 0 as i64
    t0 := time.NowNanos()
    repeat PAIRS in i:
        a.Set(i)
        sum += b.Get() as i64
    end
    dt := time.NowNanos() - t0
    println "set source + read binding:", PAIRS, "in", dt / 1000000, "ms,", ns_per(dt, PAIRS), "ns per pair (checksum", sum, ")"
    a.Free()
    b.Free()
end

func bench_chain():
    root := reactive.NewInt(0)
    chain.push(root)
    t0 := time.NowNanos()
    repeat CHAIN - 1:
        link_next()
    end
    tail := chain.get(CHAIN - 1)
    first := tail.Get()
    build := time.NowNanos() - t0
    println "chain of", CHAIN, "nodes: build and first read", build / 1000000, "ms, tail =", first
    mut mark_total := 0 as i64
    mut eval_total := 0 as i64
    repeat ROUNDS in r:
        t1 := time.NowNanos()
        root.Set(r + 1)
        t2 := time.NowNanos()
        v := tail.Get()
        t3 := time.NowNanos()
        mark_total += t2 - t1
        eval_total += t3 - t2
        if v != r + CHAIN:
            println "wrong tail value", v
        end
    end
    println "chain update, mark dirty:", ns_per(mark_total, ROUNDS) / 1000.0, "us per update,", ns_per(mark_total, ROUNDS * CHAIN), "ns per node"
    println "chain update, re-evaluate:", ns_per(eval_total, ROUNDS) / 1000.0, "us per update,", ns_per(eval_total, ROUNDS * CHAIN), "ns per node"
    each p in chain:
        p.Free()
    end
    chain.Free()
end

func main:
    bench_get_set()
    bench_bound_get()
    bench_chain()
    println "live nodes", reactive.LiveNodes(), "evaluations", reactive.Evaluations()
    reactive.Reset()
end
