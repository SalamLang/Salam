import gui.ui
import gui.css
import str
import time
import sort

const GLOBAL_CSS := `*{box-sizing:border-box}.grid{display:flex;flex-wrap:wrap;gap:8px;padding:8px}.card{width:180px;padding:8px;border:1px solid #ccd;border-radius:8px;box-shadow:0 2px 4px rgba(0,0,0,.2);background:#fff}.card:hover{background:#eef4ff;border-color:#36c}h3{margin:0 0 4px;font-size:15px}p{margin:0;color:#444}button{margin-top:6px}`

mut clicks := 0
mut noops := 0
mut touched := 0 as i64

func compile(p &: css.Program):
    _n := css.CompileCss(p, GLOBAL_CSS)
end

func styles(): css.Program:
    mut p := css.NewProgram()
    p.AddSimple(3, "grid", "", 0, 0, 0, false)
    p.AddSimple(3, "card", "", 0, 0, 0, false)
    p.AddSimple(3, "card", "", 0, 0, 0, false)
    p.AddSimple(5, "", "", 0, 1, 0, false)
    p.AddSimple(1, "h3", "", 0, 0, 0, false)
    p.AddSimple(1, "p", "", 0, 0, 0, false)
    p.AddSimple(1, "button", "", 0, 0, 0, false)
    p.AddCompound(0, 0, 0)
    p.AddCompound(0, 1, 0)
    p.AddCompound(1, 1, 0)
    p.AddCompound(2, 2, 0)
    p.AddCompound(4, 1, 0)
    p.AddCompound(5, 1, 0)
    p.AddCompound(6, 1, 0)
    p.AddSelector(0, 1, 0, false, false)
    p.AddSelector(1, 1, 1000, false, false)
    p.AddSelector(2, 1, 1000, false, false)
    p.AddSelector(3, 1, 2000, false, false)
    p.AddSelector(4, 1, 1, false, false)
    p.AddSelector(5, 1, 1, false, false)
    p.AddSelector(6, 1, 1, false, false)
    p.AddDecl("box-sizing", false, [css.Kw("border-box")])
    p.EndList(1)
    p.AddDecl("display", false, [css.Kw("flex")])
    p.AddDecl("flex-wrap", false, [css.Kw("wrap")])
    p.AddDecl("row-gap", false, [css.Dim(8.0, "px")])
    p.AddDecl("column-gap", false, [css.Dim(8.0, "px")])
    p.AddDecl("padding-top", false, [css.Dim(8.0, "px")])
    p.AddDecl("padding-right", false, [css.Dim(8.0, "px")])
    p.AddDecl("padding-bottom", false, [css.Dim(8.0, "px")])
    p.AddDecl("padding-left", false, [css.Dim(8.0, "px")])
    p.EndList(8)
    p.AddDecl("width", false, [css.Dim(180.0, "px")])
    p.AddDecl("padding-top", false, [css.Dim(8.0, "px")])
    p.AddDecl("padding-right", false, [css.Dim(8.0, "px")])
    p.AddDecl("padding-bottom", false, [css.Dim(8.0, "px")])
    p.AddDecl("padding-left", false, [css.Dim(8.0, "px")])
    p.AddDecl("border-top-width", false, [css.Dim(1.0, "px")])
    p.AddDecl("border-right-width", false, [css.Dim(1.0, "px")])
    p.AddDecl("border-bottom-width", false, [css.Dim(1.0, "px")])
    p.AddDecl("border-left-width", false, [css.Dim(1.0, "px")])
    p.AddDecl("border-top-style", false, [css.Kw("solid")])
    p.AddDecl("border-right-style", false, [css.Kw("solid")])
    p.AddDecl("border-bottom-style", false, [css.Kw("solid")])
    p.AddDecl("border-left-style", false, [css.Kw("solid")])
    p.AddDecl("border-top-color", false, [css.Hash("ccd")])
    p.AddDecl("border-right-color", false, [css.Hash("ccd")])
    p.AddDecl("border-bottom-color", false, [css.Hash("ccd")])
    p.AddDecl("border-left-color", false, [css.Hash("ccd")])
    p.AddDecl("border-top-left-radius", false, [css.Dim(8.0, "px"), css.Dim(8.0, "px")])
    p.AddDecl("border-top-right-radius", false, [css.Dim(8.0, "px"), css.Dim(8.0, "px")])
    p.AddDecl("border-bottom-right-radius", false, [css.Dim(8.0, "px"), css.Dim(8.0, "px")])
    p.AddDecl("border-bottom-left-radius", false, [css.Dim(8.0, "px"), css.Dim(8.0, "px")])
    p.AddDecl("box-shadow", false, [css.Int(0.0), css.Dim(2.0, "px"), css.Dim(4.0, "px"), css.Fn("rgba"), css.Int(0.0), css.Comma(), css.Int(0.0), css.Comma(), css.Int(0.0), css.Comma(), css.Num(0.2), css.Close()])
    p.AddDecl("background-image", false, [css.Kw("none")])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Hash("fff")])
    p.EndList(31)
    p.AddDecl("background-image", false, [css.Kw("none")])
    p.AddDecl("background-position-x", false, [css.Pct(0.0)])
    p.AddDecl("background-position-y", false, [css.Pct(0.0)])
    p.AddDecl("background-size", false, [css.Kw("auto")])
    p.AddDecl("background-repeat", false, [css.Kw("repeat")])
    p.AddDecl("background-attachment", false, [css.Kw("scroll")])
    p.AddDecl("background-origin", false, [css.Kw("padding-box")])
    p.AddDecl("background-clip", false, [css.Kw("border-box")])
    p.AddDecl("background-color", false, [css.Hash("eef4ff")])
    p.AddDecl("border-top-color", false, [css.Hash("36c")])
    p.AddDecl("border-right-color", false, [css.Hash("36c")])
    p.AddDecl("border-bottom-color", false, [css.Hash("36c")])
    p.AddDecl("border-left-color", false, [css.Hash("36c")])
    p.EndList(13)
    p.AddDecl("margin-top", false, [css.Int(0.0)])
    p.AddDecl("margin-right", false, [css.Int(0.0)])
    p.AddDecl("margin-bottom", false, [css.Dim(4.0, "px")])
    p.AddDecl("margin-left", false, [css.Int(0.0)])
    p.AddDecl("font-size", false, [css.Dim(15.0, "px")])
    p.EndList(5)
    p.AddDecl("margin-top", false, [css.Int(0.0)])
    p.AddDecl("margin-right", false, [css.Int(0.0)])
    p.AddDecl("margin-bottom", false, [css.Int(0.0)])
    p.AddDecl("margin-left", false, [css.Int(0.0)])
    p.AddDecl("color", false, [css.Hash("444")])
    p.EndList(5)
    p.AddDecl("margin-top", false, [css.Dim(6.0, "px")])
    p.EndList(1)
    p.AddRule(0, 0, -1)
    p.AddRule(1, 1, -1)
    p.AddRule(2, 2, -1)
    p.AddRule(3, 3, -1)
    p.AddRule(4, 4, -1)
    p.AddRule(5, 5, -1)
    p.AddRule(6, 6, -1)
    ret p
end

func page(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `<!doctype html><html lang="en" dir="ltr"><head><title>Bench</title><style>` + GLOBAL_CSS + `</style></head><body><div class="grid">`)
    repeat 40 in i:
        str.BufAppend(b, `<div class="card" id="c` + i + `"><h3>Item ` + i + `</h3><p>Some <b>bold</b> text for card ` + i + `.</p><button id="b` + i + `" onclick="hit()">Open ` + (i == 0 ? clicks : 0) + `</button></div>`)
    end
    str.BufAppend(b, `</div></body></html>`)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func view(b: ui.Builder):
    b.Title("Bench")
    b.Lang("en")
    b.Dir("ltr")
    b.Open("div")
    b.Class("grid")
    repeat 40 in i:
        b.Open("div")
        b.Class("card")
        b.Id("c" + i)
        b.Open("h3")
        b.Text("Item " + i)
        b.Close()
        b.Open("p")
        b.Text("Some ")
        b.Open("b")
        b.Text("bold")
        b.Close()
        b.Text(" text for card " + i + ".")
        b.Close()
        b.Open("button")
        b.Id("b" + i)
        b.On("click", (): hit() end)
        b.Text("Open " + (i == 0 ? clicks : 0))
        b.Close()
        b.Close()
    end
    b.Close()
end

func hit():
    clicks++
    touched |= 1
end

func noop():
    noops++
end

func take(w: int): i64:
    mut t := 0 as i64
    if w == 0:
        t = touched
        touched = 0
    end
    ret t
end

func sites():
    ui.ScopeSite(1, -1, 0, 1)
end

func card(b: ui.Builder, i: int):
    b.Open("div")
    b.Class("card")
    b.Id("c" + i)
    b.Open("h3")
    b.Text("Item " + i)
    b.Close()
    b.Open("p")
    b.Text("Some ")
    b.Open("b")
    b.Text("bold")
    b.Close()
    b.Text(" text for card " + i + ".")
    b.Close()
    if i == 0:
        b.Scope(1, (b: ui.Builder):
            b.Open("button")
            b.Id("b0")
            b.On("click", (): hit() end)
            b.Text("Open " + clicks)
            b.Close()
        end)
    else:
        b.Open("button")
        b.Id("b" + i)
        b.On("click", (): noop() end)
        b.Text("Open 0")
        b.Close()
    end
    b.Close()
end

func view_whole(b: ui.Builder):
    b.Title("Bench")
    b.Lang("en")
    b.Dir("ltr")
    b.Open("div")
    b.Class("grid")
    repeat 40 in i:
        card(b, i)
    end
    b.Close()
end

func view_scoped(b: ui.Builder):
    b.Reactive(1, (w: int): ret take(w) end, (): sites() end)
    view_whole(b)
end

func median(v &: Vector<f64>): f64:
    sort.Sort(v)
    ret v[v.Len() / 2]
end

func ms(t0: i64): f64:
    ret ((time.MonoNanos() - t0) as f64) / 1000000.0
end

func scrolls(n: int): str:
    mut b := str.NewBuilder()
    repeat n in i:
        str.BufAppend(b, i % 2 == 0 ? "scroll #c20 40\n" : "scroll #c20 -40\n")
    end
    str.BufAppend(b, "quit\n")
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func steps(cmd: str, n: int): str:
    mut b := str.NewBuilder()
    repeat n in i:
        str.BufAppend(b, cmd + (i % 2 == 0 ? "0" : "1") + "\n")
    end
    str.BufAppend(b, "quit\n")
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func run_html(script: str): f64:
    o := ui.Options { width = 1024.0, height = 768.0, headless = true, script = script }
    t0 := time.MonoNanos()
    ui.RunWith((): ret page() end, o)
    ret ms(t0)
end

func run_compiled(script: str): f64:
    o := ui.Options { width = 1024.0, height = 768.0, headless = true, script = script }
    t0 := time.MonoNanos()
    ui.RunCompiledWith((): ret styles() end, (b: ui.Builder): view(b) end, o)
    ret ms(t0)
end

func run_page(script: str, scoped: bool): f64:
    o := ui.Options { width = 1024.0, height = 768.0, headless = true, script = script }
    t0 := time.MonoNanos()
    if scoped:
        ui.RunCompiledWith((): ret styles() end, (b: ui.Builder): view_scoped(b) end, o)
    else:
        ui.RunCompiledWith((): ret styles() end, (b: ui.Builder): view_whole(b) end, o)
    end
    ret ms(t0)
end

func same_steps(cmd: str, n: int): str:
    mut b := str.NewBuilder()
    repeat n:
        str.BufAppend(b, cmd + "\n")
    end
    str.BufAppend(b, "quit\n")
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func reactive_numbers(rounds: int, n: int):
    mut wc := Vector {} as Vector<f64>
    mut sc := Vector {} as Vector<f64>
    mut wn := Vector {} as Vector<f64>
    mut sn := Vector {} as Vector<f64>
    clicks_steps := same_steps("click #b0", n)
    noop_steps := same_steps("click #b5", n)
    repeat rounds:
        w0 := run_page("quit\n", false)
        s0 := run_page("quit\n", true)
        wc.push((run_page(clicks_steps, false) - w0) / (n as f64))
        sc.push((run_page(clicks_steps, true) - s0) / (n as f64))
        wn.push((run_page(noop_steps, false) - w0) / (n as f64))
        sn.push((run_page(noop_steps, true) - s0) / (n as f64))
    end
    println "counter click ms whole view", median(wc), "one scope", median(sc)
    println "nothing-changed click ms whole view", median(wn), "scoped", median(sn)
    println "scope runs in last scoped run", ui.ScopeRuns()
    wc.free()
    sc.free()
    wn.free()
    sn.free()
end

func main:
    mut cp := css.NewProgram()
    compile(cp)
    mut lp := styles()
    println "styles up to date", css.ProgramSource(cp, "styles", "css") == css.ProgramSource(lp, "styles", "css")
    cp.Free()
    lp.Free()
    doc := page()
    rounds := 9
    n := 20
    mut parse := Vector {} as Vector<f64>
    mut style := Vector {} as Vector<f64>
    mut lay := Vector {} as Vector<f64>
    mut paint := Vector {} as Vector<f64>
    mut elements := 0
    repeat rounds:
        p := ui.Measure(doc, 1024, 768)
        parse.push(p.parse_ms)
        style.push(p.style_ms)
        lay.push(p.layout_ms)
        paint.push(p.paint_ms)
        elements = p.elements
    end
    println "elements", elements
    println "html parse ms", median(parse)
    println "html style ms", median(style)
    println "html layout ms", median(lay)
    println "html paint ms", median(paint)
    mut hs := Vector {} as Vector<f64>
    mut cs := Vector {} as Vector<f64>
    mut hc := Vector {} as Vector<f64>
    mut cc := Vector {} as Vector<f64>
    mut hh := Vector {} as Vector<f64>
    mut ch := Vector {} as Vector<f64>
    mut hsc := Vector {} as Vector<f64>
    mut csc := Vector {} as Vector<f64>
    ui.Handle("hit", (): hit() end)
    repeat rounds:
        h0 := run_html("quit\n")
        c0 := run_compiled("quit\n")
        hs.push(h0)
        cs.push(c0)
        hc.push((run_html(steps("click #b", n)) - h0) / (n as f64))
        cc.push((run_compiled(steps("click #b", n)) - c0) / (n as f64))
        hh.push((run_html(steps("hover #c", n)) - h0) / (n as f64))
        ch.push((run_compiled(steps("hover #c", n)) - c0) / (n as f64))
        hsc.push((run_html(scrolls(n)) - h0) / (n as f64))
        csc.push((run_compiled(scrolls(n)) - c0) / (n as f64))
    end
    println "startup ms html", median(hs), "compiled", median(cs)
    println "click re-run ms html", median(hc), "compiled", median(cc)
    println "hover repaint ms html", median(hh), "compiled", median(ch)
    println "scroll frame ms html", median(hsc), "compiled", median(csc)
    reactive_numbers(rounds, n)
    println "clicks", clicks
    parse.free()
    style.free()
    lay.free()
    paint.free()
    hs.free()
    cs.free()
    hc.free()
    cc.free()
    hh.free()
    ch.free()
    hsc.free()
    csc.free()
end
