import gui.ui
import gui.style
import time
import sort

mut clicks := 0
mut touched := 0 as i64

func hit():
    clicks++
    touched |= 1
end

func take(w: int): i64:
    mut t := 0 as i64
    if w == 0:
        t = touched
        touched = 0
    end
    ret t
end

func sites():
    ui.ScopeSite(1, -1, 0, 1)
end

func patches(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func set(b: ui.Builder, name: str, text: str):
    b.SetText(ui.STATE_BASE, style.PropByName(name), text)
end

func set_hover(b: ui.Builder, name: str, text: str):
    b.SetText(ui.STATE_HOVER, style.PropByName(name), text)
end

func card(b: ui.Builder, i: int, scoped: bool):
    b.Open("box")
    b.Id("c" + i)
    set(b, "width", "180")
    set(b, "padding", "8")
    set(b, "border", "1, solid, #ccd")
    set(b, "radius", "8")
    set(b, "shadow", "0, 2, 4, rgba(0, 0, 0, 0.2)")
    set(b, "background", "#fff")
    set_hover(b, "background", "#eef4ff")
    set_hover(b, "border color", "#36c")
    b.Open("heading")
    set(b, "font size", "15")
    set(b, "margin", "0, 0, 4, 0")
    b.Text("Item " + i)
    b.Close()
    b.Open("paragraph")
    set(b, "color", "#444")
    set(b, "margin", "0")
    b.Text("Some bold text for card " + i + ".")
    b.Close()
    if scoped and i == 0:
        b.Scope(1, (b: ui.Builder): button(b, i) end)
    else:
        button(b, i)
    end
    b.Close()
end

func button(b: ui.Builder, i: int):
    b.Open("button")
    b.Id("b" + i)
    set(b, "margin", "6, 0, 0, 0")
    b.On("click", (): hit() end)
    b.Text("Open " + (i == 0 ? clicks : 0))
    b.Close()
end

func view_n(b: ui.Builder, n: int, scoped: bool):
    b.Title("Bench")
    b.Lang("en")
    b.Dir("ltr")
    if scoped:
        b.Reactive(1, (w: int): ret take(w) end, (): sites() end)
    end
    b.Open("box")
    set(b, "layout", "row")
    set(b, "wrap", "true")
    set(b, "gap", "8")
    set(b, "padding", "8")
    repeat n in i:
        card(b, i, scoped)
    end
    b.Close()
end

func median(v &: Vector<f64>): f64:
    sort.Sort(v)
    ret v[v.Len() / 2]
end

func ms(t0: i64): f64:
    ret ((time.MonoNanos() - t0) as f64) / 1000000.0
end

func render_ms(n: int, scoped: bool): f64:
    t0 := time.MonoNanos()
    mut c := ui.RenderPage((): ret patches() end, (b: ui.Builder): view_n(b, n, scoped) end, 1024, 768)
    r := ms(t0)
    c.Free()
    ret r
end

func dump_ms(n: int): f64:
    t0 := time.MonoNanos()
    d := ui.DumpPage((): ret patches() end, (b: ui.Builder): view_n(b, n, false) end, 1024, 768)
    r := ms(t0)
    if d.Len() == 0:
        println "empty dump"
    end
    ret r
end

func series(rounds: int, n: int, scoped: bool, dump: bool): f64:
    mut v := Vector {} as Vector<f64>
    repeat rounds:
        v.Push(dump ? dump_ms(n) : render_ms(n, scoped))
    end
    r := median(v)
    v.Free()
    ret r
end

func main:
    rounds := 9
    println "cards 40 render ms", series(rounds, 40, false, false)
    println "cards 40 render ms with reactive scope", series(rounds, 40, true, false)
    println "cards 40 dump ms", series(rounds, 40, false, true)
    println "cards 400 render ms", series(rounds, 400, false, false)
    println "cards 400 dump ms", series(rounds, 400, false, true)
    println "scope runs in last scoped render", ui.ScopeRuns()
end
