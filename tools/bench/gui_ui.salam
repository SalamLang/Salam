import gui.ui
import str
import time
import sort

func page(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, `<!doctype html><html lang="en" dir="ltr"><head><title>Bench</title><style>*{box-sizing:border-box}.grid{display:flex;flex-wrap:wrap;gap:8px;padding:8px}.card{width:180px;padding:8px;border:1px solid #ccd;border-radius:8px;box-shadow:0 2px 4px rgba(0,0,0,.2);background:#fff}.card:hover{background:#eef4ff;border-color:#36c}h3{margin:0 0 4px;font-size:15px}p{margin:0;color:#444}button{margin-top:6px}</style></head><body><div class="grid">`)
    repeat 40 in i:
        str.BufAppend(b, `<div class="card" id="c` + i + `"><h3>Item ` + i + `</h3><p>Some <b>bold</b> text for card ` + i + `.</p><button>Open</button></div>`)
    end
    str.BufAppend(b, `</div></body></html>`)
    r := str.BufStr(b)
    str.BufFree(b)
    ret r
end

func median(v &: Vector<f64>): f64:
    sort.Sort(v)
    ret v[v.len() / 2]
end

func main:
    doc := page()
    rounds := 9
    mut parse := Vector {} as Vector<f64>
    mut style := Vector {} as Vector<f64>
    mut lay := Vector {} as Vector<f64>
    mut paint := Vector {} as Vector<f64>
    mut elements := 0
    repeat rounds:
        p := ui.Measure(doc, 1024, 768)
        parse.push(p.parse_ms)
        style.push(p.style_ms)
        lay.push(p.layout_ms)
        paint.push(p.paint_ms)
        elements = p.elements
    end
    println "elements", elements
    println "parse ms", median(parse)
    println "style ms", median(style)
    println "layout ms", median(lay)
    println "paint ms", median(paint)
    _ok := ui.StartHtml(doc, ui.Options { width = 1024.0, height = 768.0, headless = true })
    _alive := ui.Step(0)
    mut hover := Vector {} as Vector<f64>
    repeat rounds in i:
        t0 := time.MonoNanos()
        ui.RunSteps("hover #c" + (i % 20))
        hover.push(((time.MonoNanos() - t0) as f64) / 1000000.0)
    end
    println "hover repaint ms", median(hover), "damage px", ui.LastDamageArea()
    ui.Stop()
    parse.free()
    style.free()
    lay.free()
    paint.free()
    hover.free()
end
