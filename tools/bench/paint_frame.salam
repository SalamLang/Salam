import gui.paint
import time
import sort
import os

mut seed := 12345

func rnd(n: int): int:
    seed = (seed * 1103515245 + 12345) & 2147483647
    ret (seed >> 8) % n
end

func frame(cv &: paint.Canvas, part: int):
    seed = 12345
    if part == 0 or part == 1:
        mut g := paint.LinearGradient(160.0)
        g.AddStop(0.0, paint.Rgb(236, 240, 248))
        g.AddStop(0.6, paint.Rgb(214, 222, 240))
        g.AddStop(1.0, paint.Rgb(190, 200, 230))
        cv.FillGradient(paint.RectOf(0.0, 0.0, 1920.0, 1080.0), paint.Uniform(0.0), g)
        g.Free()
    end
    repeat 200:
        x := (rnd(1760) + 10) as f64
        y := (rnd(960) + 10) as f64
        w := (rnd(160) + 60) as f64
        h := (rnd(90) + 40) as f64
        r := paint.RectOf(x + 0.5, y + 0.25, w, h)
        radii := paint.Uniform((rnd(16) + 4) as f64)
        if part == 0 or part == 2:
            cv.DrawShadow(r, radii, paint.Shadow { offset_y = 4.0, blur = 12.0, color = paint.Rgba(0, 0, 0, 70) })
        end
        if part == 0 or part == 3:
            cv.FillRoundedRect(r, radii, paint.Rgb(rnd(256), rnd(256), rnd(256)))
        end
        if part == 0 or part == 4:
            cv.DrawBorder(r, radii, paint.SolidBorder(2.0, paint.Rgba(20, 30, 60, 200)))
        end
    end
end

func ms2(v: f64): str:
    c := (v * 100.0 + 0.5) as int
    frac := c % 100
    ret "" + (c / 100) + "." + (frac < 10 ? "0" : "") + frac
end

func measure(cv &: paint.Canvas, part: int, frames: int): str:
    frame(cv, part)
    mut times := Vector {} as Vector<f64>
    defer times.free()
    repeat frames:
        t0 := time.NowNanos()
        frame(cv, part)
        t1 := time.NowNanos()
        times.push(((t1 - t0) as f64) / 1000000.0)
    end
    sort.Sort(times)
    ret "min " + ms2(times.get(0)) + " ms, median " + ms2(times.get(frames / 2)) + " ms"
end

func main:
    mut cv := paint.NewCanvas(1920, 1080)
    mut frames := 20
    args := os.Args()
    if args.len() > 1:
        frames = args.get(1).ToInt()
    end
    args.free()
    println "1920x1080, 200 rounded rects with shadow, fill and border over a gradient"
    println "frame:", measure(cv, 0, frames)
    println "  gradient background:", measure(cv, 1, frames)
    println "  200 shadows:", measure(cv, 2, frames)
    println "  200 rounded fills:", measure(cv, 3, frames)
    println "  200 borders:", measure(cv, 4, frames)
    println "hash:", cv.Hash()
    cv.Free()
end
