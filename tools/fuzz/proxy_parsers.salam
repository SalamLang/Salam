import mem
import os
import str
import compress
import net.dns
import net.socks
import net.trojan
import net.vless
import net.vmess
import net.shadowsocks
import net.censor
import net.httpproxy
import net.doh
import net.reality
import net.transport
import net.tunnel

mut state := 88172645463325252 as i64

func next(): int:
    state ^= state << 13
    state ^= (state >> 7) & 72057594037927935
    state ^= state << 17
    r := (state >> 11) & 2147483647
    ret r as int
end

func below(n: int): int:
    if n <= 1:
        ret 0
    end
    ret next() % n
end

func hexbytes(text: str): Vector<int>:
    mut out := Vector {} as Vector<int>
    digits := "0123456789abcdef"
    mut i := 0
    until i + 1 < text.len():
        hi := digits.find(text.substr(i, 1))
        lo := digits.find(text.substr(i + 1, 1))
        out.push(hi * 16 + lo)
        i += 2
    end
    ret out
end

func textbytes(text: str): Vector<int>:
    mut out := Vector {} as Vector<int>
    p := text as u8*
    repeat text.len() in i:
        out.push(p[i] as int)
    end
    ret out
end

func mutate(seed: Vector<int>, textual: bool): Vector<int>:
    mut v := Vector {} as Vector<int>
    repeat seed.len() in i:
        v.push(seed.get(i))
    end
    rounds := 1 + below(4)
    repeat rounds:
        kind := below(7)
        n := v.len()
        if kind == 0 and n > 0:
            v.set(below(n), below(256))
        else kind == 1 and n > 0:
            idx := below(n)
            v.set(idx, v.get(idx) ^ (1 << below(8)))
        else kind == 2 and n > 1:
            keep := below(n)
            mut cut := Vector {} as Vector<int>
            repeat keep in i:
                cut.push(v.get(i))
            end
            v.free()
            v = cut
        else kind == 3:
            at := below(n + 1)
            mut grown := Vector {} as Vector<int>
            repeat at in i:
                grown.push(v.get(i))
            end
            extra := 1 + below(8)
            repeat extra:
                grown.push(below(256))
            end
            repeat n - at in i:
                grown.push(v.get(at + i))
            end
            v.free()
            v = grown
        else kind == 4 and n > 0:
            idx := below(n)
            v.set(idx, 255)
        else kind == 5 and n > 0:
            idx := below(n)
            v.set(idx, 0)
        else n > 2:
            mut dup := Vector {} as Vector<int>
            a := below(n)
            b := a + below(n - a)
            repeat n in i:
                dup.push(v.get(i))
                if i == b:
                    repeat b - a + 1 in j:
                        dup.push(v.get(a + j))
                    end
                end
            end
            v.free()
            v = dup
        end
    end
    if textual:
        repeat v.len() in i:
            if v.get(i) == 0:
                v.set(i, 32)
            end
        end
    end
    ret v
end

func load(v: Vector<int>): void*:
    p := mem.AllocateZeroed((v.len() + 16) as u64) as u8*
    repeat v.len() in i:
        p[i] = v.get(i) as u8
    end
    ret p as void*
end

func as_text(v: Vector<int>): str:
    p := load(v)
    s := str.Clone(p as str)
    mem.Free(p)
    ret s
end

func as_bytes(v: Vector<int>): transport.Bytes:
    mut b := transport.NewBytes(v.len() + 1)
    repeat v.len() in i:
        transport.Put8(b, v.get(i))
    end
    ret b
end

func binary_seeds(): Vector<Vector<int>>:
    mut s := Vector {} as Vector<Vector<int>>
    s.push(hexbytes("050100010a0000010050"))
    s.push(hexbytes("0501000303676f6f676c6503636f6d01bb"))
    s.push(hexbytes("0501000420010db8000000000000000000000001001f"))
    s.push(hexbytes("000000010a000001005068656c6c6f"))
    s.push(hexbytes("0001bb5000000001000a00506c7573746564"))
    s.push(hexbytes("04010050c0a80101757365720000"))
    s.push(hexbytes("0401005000000001757365720065786d706c652e636f6d00"))
    s.push(hexbytes("005a0000000a000001"))
    s.push(hexbytes("03616263020b6578616d706c652e636f6d0050"))
    s.push(hexbytes("0103646f6d61696e00500d0a68656c6c6f"))
    s.push(hexbytes("00b831381d63244d53ad4f8cda48b3081100010050020b6578616d706c652e636f6d"))
    s.push(hexbytes("00b831381d63244d53ad4f8cda48b30811120a107874" + "6c732d727072782d766973696f6e0101bb0201010a000001"))
    s.push(hexbytes("1603010200010001fc0303000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f2000000200ff0100" + "0191000b00040300010200000014001200000f7777772e6578616d706c652e636f6d"))
    s.push(hexbytes("12340100000100000000000003777777076578616d706c6503636f6d0000010001c00c000100010000003c0004" + "5db8d822c00c001c00010000003c001020010db800000000000000000000000100"))
    ret s
end

func text_seeds(): Vector<Vector<int>>:
    mut s := Vector {} as Vector<Vector<int>>
    s.push(textbytes("vless://b831381d-6324-4d53-ad4f-8cda48b30811@example.com:443?encryption=none&security=tls&sni=a.example&type=ws&host=b.example&path=%2Fws&fp=chrome&alpn=h2%2Chttp%2F1.1#remark%20x"))
    s.push(textbytes("vless://b831381d-6324-4d53-ad4f-8cda48b30811@[2001:db8::1]:443?security=reality&pbk=abc&sid=01ab&sni=www.example.com&flow=xtls-rprx-vision&type=grpc&serviceName=svc#r"))
    s.push(textbytes("vmess://eyJ2IjoiMiIsInBzIjoieCIsImFkZCI6ImV4YW1wbGUuY29tIiwicG9ydCI6IjQ0MyIsImlkIjoiYjgzMTM4MWQtNjMyNC00ZDUzLWFkNGYtOGNkYTQ4YjMwODExIiwiYWlkIjoiMCIsIm5ldCI6IndzIiwidHlwZSI6Im5vbmUiLCJob3N0IjoiIiwicGF0aCI6Ii8iLCJ0bHMiOiJ0bHMifQ=="))
    s.push(textbytes("trojan://pass%20word@example.com:443?security=tls&sni=x.example&type=tcp#t"))
    s.push(textbytes("ss://YWVzLTI1Ni1nY206cGFzc3dvcmQ@example.com:8388/?plugin=obfs-local%3Bobfs%3Dhttp%3Bobfs-host%3Dx.example#ss"))
    s.push(textbytes("ss://2022-blake3-aes-256-gcm:MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTIzNDU2Nzg5MDE@example.com:8388"))
    s.push(textbytes("c3M6Ly9ZV1Z6TFRJMU5pMW5ZMjA2Y0dGemMzZHZjbVFAZXhhbXBsZS5jb206ODM4OA==\nvless://b831381d-6324-4d53-ad4f-8cda48b30811@h:1#a\n"))
    s.push(textbytes("{\"inbounds\":[{\"tag\":\"in\",\"port\":1080,\"protocol\":\"socks\",\"settings\":{\"auth\":\"noauth\"}}],\"outbounds\":[{\"tag\":\"direct\",\"protocol\":\"freedom\"}],\"routing\":{\"rules\":[{\"type\":\"field\",\"domain\":[\"geosite:ir\",\"suffix:ir\"],\"ip\":[\"geoip:private\",\"10.0.0.0/8\"],\"outboundTag\":\"direct\"}]}}"))
    s.push(textbytes("domain:example.com\nfull:www.example.org\nkeyword:ads\nregexp:^a.*\\.test$\n10.0.0.0/8\n2001:db8::/32\ngeoip:private\n"))
    s.push(textbytes("pbk=abcdefghijklmnopqrstuvwxyzabcdefghijklmnopq&sid=0123abcd&sni=www.example.com&fp=chrome&spx=%2F"))
    s.push(textbytes("GET http://user:pw@example.com:8080/a/b?c=d HTTP/1.1\r\nHost: example.com\r\nProxy-Authorization: Basic dXNlcjpwdw==\r\nContent-Length: 4\r\n\r\n"))
    s.push(textbytes("HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n"))
    s.push(textbytes("[2001:db8::1]:8443"))
    s.push(textbytes("https://dns.example/dns-query?x=1"))
    ret s
end

func run_binary(which: int, v: Vector<int>):
    p := load(v)
    n := v.len()
    if which == 0:
        mut u8v := Vector {} as Vector<u8>
        repeat n in i:
            u8v.push(v.get(i) as u8)
        end
        mut a := socks.Address {}
        socks.DecodeAddress(u8v, 0, a)
        mut rq := socks.Request {}
        socks.DecodeRequest(u8v, rq)
        mut rp := socks.Reply {}
        socks.DecodeReply(u8v, rp)
        mut uh := socks.UDPHeader {}
        socks.DecodeUDPHeader(u8v, uh)
        mut r4 := socks.Request {}
        socks.Decode4Request(u8v, r4)
        mut p4 := socks.Reply {}
        socks.Decode4Reply(u8v, p4)
        u8v.free()
    else which == 1:
        trojan.ParseRequest(p, n)
        trojan.ParseUDPPacket(p, n)
        mut atyp := 0
        mut host := ""
        mut port := 0
        trojan.ParseAddr(p, n, 0, atyp, host, port)
    else which == 2:
        tunnel.DecodeSocks(p, n)
        tunnel.DecodeVless(p, n)
        mut t := shadowsocks.Target {}
        shadowsocks.ParseTarget(p, n, t)
    else which == 3:
        mut b := as_bytes(v)
        mut r := vless.Request {}
        vless.DecodeRequest(b, r)
        mut vr := vmess.Request {}
        vmess.DecodeRequest(b, vr)
        mut a := transport.Addr {}
        transport.ReadAddr(b, 0, a)
        transport.FreeBytes(b)
    else which == 4:
        censor.Sniff(p, n)
        censor.ParseClientHello(p, n)
        censor.ExtractSNI(p, n)
    else which == 5:
        m := dns.Decode(p, n)
        doh.ParseIPv4(as_text(v), compress.NewByteBuf())
        if m.answers.items.len() > 100000:
            println "impossible"
        end
    else:
        names := Vector {} as Vector<str>
        tunnel.ClearGeo()
        tunnel.LoadGeoSiteDat(p, n, names)
        tunnel.LoadGeoIpDat(p, n, names)
    end
    mem.Free(p)
end

func run_text(which: int, v: Vector<int>):
    t := as_text(v)
    if which == 0:
        tunnel.ParseLink(t)
        vless.ParseLink(t)
        vmess.ParseLink(t)
    else which == 1:
        tunnel.ParseSubscription(t)
    else which == 2:
        shadowsocks.ParseUri(t)
        shadowsocks.ParsePlugin(t)
    else which == 3:
        tunnel.ParseConfig(t)
    else which == 4:
        tunnel.ParseRules(t, "direct")
        tunnel.ParseDomainList(t, "")
        tunnel.ParseIpList(t)
        tunnel.ParseCidr(t)
    else which == 5:
        tunnel.ParseAddr(t)
        tunnel.ParseIP(t)
        tunnel.PctDecode(t)
        transport.ParseUUID(t)
        reality.ParseParams(t)
        doh.ParseURL(t)
    else:
        httpproxy.ParseRequestHead(t)
        httpproxy.ParseResponseHead(t)
        httpproxy.ParseURL(t)
        httpproxy.SplitHostPort(t, 80)
        mut u := ""
        mut pw := ""
        httpproxy.BasicCredentials(t, u, pw)
    end
end

func main():
    args := os.Args()
    mut rounds := 3000
    if args.len() > 1:
        rounds = args.get(1).to_int()
    end
    if args.len() > 2:
        state = (args.get(2).to_int() as i64) * 2654435761 + 88172645463325252
    end
    bin := binary_seeds()
    txt := text_seeds()
    mut done := 0
    repeat 7 in which:
        repeat rounds:
            seed := bin.get(below(bin.len()))
            m := mutate(seed, false)
            run_binary(which, m)
            m.free()
            done++
        end
    end
    println "binary parsers", done
    done = 0
    repeat 7 in which:
        repeat rounds:
            seed := txt.get(below(txt.len()))
            m := mutate(seed, true)
            run_text(which, m)
            m.free()
            done++
        end
    end
    println "text parsers", done
end
