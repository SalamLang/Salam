package main

import net.doh

func probe(label: str, srv: doh.Server):
    mut v := Vector {} as Vector<doh.Server>
    v.push(srv)
    r := doh.NewResolver(v)
    doh.SetTimeout(r, 8000)
    a := doh.LookupA(r, "example.com")
    println label, "A", a.Len(), a
    aaaa := doh.LookupAAAA(r, "example.com")
    println label, "AAAA", aaaa.Len(), aaaa
    txt := doh.LookupTXT(r, "example.com")
    println label, "TXT", txt
    cn := doh.LookupCNAME(r, "www.github.com")
    println label, "CNAME", cn
    h := doh.LookupHost(r, "www.wikipedia.org")
    println label, "HOST", h.Len() > 0
    nx := doh.Resolve(r, "no-such-name-salam-interop-4711.example.com", 1)
    println label, "NX", nx.ok, nx.rcode, nx.negative
    again := doh.Resolve(r, "example.com", 1)
    println label, "cached", again.cached, again.ttl > 0
    s := doh.Stats(r)
    println label, "stats", s
end

func main:
    probe("cloudflare-doh", doh.Cloudflare())
    probe("google-doh", doh.Google())
    probe("quad9-doh", doh.Quad9())
    probe("cloudflare-dot", doh.CloudflareDoT())
    probe("google-dot", doh.GoogleDoT())
    probe("quad9-dot", doh.Quad9DoT())
end
