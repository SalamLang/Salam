package main

import os
import time
import net.tunnel

func main:
    a := os.Args()
    mut names := Vector {} as Vector<str>
    each i, x in a:
        if i > 3: names.Push(x) end
    end
    t0 := time.NowMillis()
    mut n := 0
    if a[1] == "site":
        n = tunnel.LoadGeoSiteFile(a[2], names)
    else:
        n = tunnel.LoadGeoIpFile(a[2], names)
    end
    println "loaded", n, "ms", (time.NowMillis() - t0)
    each x in names:
        if a[1] == "site":
            s := tunnel.LookupGeoSite(x)
            println x, "count", s.count, "full", s.full.Size(), "suffix", s.suffix.Size(), "keywords", s.keywords.Len(), "regexes", s.regexes.Len()
        else:
            s := tunnel.LookupGeoIp(x)
            println x, "count", s.count, "v4entries", s.v4.Size(), "v6entries", s.v6.Size()
        end
    end
end
