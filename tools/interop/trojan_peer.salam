package main

import mem
import os
import sync
import compress
import net.trojan

func udp_client(a: Vector<str>): int:
    mut cfg := trojan.NewClientConfig("127.0.0.1", a[2].ToInt(), a[3])
    cfg.insecure = true
    cfg.sni = "localhost"
    mut l := trojan.DialUDP(cfg)
    if not trojan.LinkOk(l):
        println "FAIL dial"
        ret 1
    end
    buf := mem.Allocate(4096 as u64)
    bp := buf as u8*
    mut good := 0
    repeat 5 in k:
        n := 100 + k * 300
        repeat n in i:
            bp[i] = ((i * 5 + k) & 255) as u8
        end
        if trojan.SendUDP(l, a[4], a[5].ToInt(), buf, n):
            mut pkt := trojan.NewUDPPacket()
            mut payload := compress.NewByteBuf()
            if trojan.ReadUDPPacket(l, pkt, payload) and payload.len == n:
                mut same := true
                pp := payload.data as u8*
                repeat n in i:
                    if pp[i] != bp[i]: same = false end
                end
                if same: good++ end
            end
            compress.BufFree(payload)
        end
    end
    mem.Free(buf)
    trojan.LinkClose(l)
    if good == 5:
        println "OK 5"
        ret 0
    end
    println "FAIL", good, "of 5"
    ret 1
end

func main:
    a := os.Args()
    if a.Len() < 5:
        println "usage: trojan_peer server PORT PASSWORD CERT KEY | client-udp PORT PASSWORD TARGET_HOST TARGET_PORT"
        ret 2
    end
    if a[1] == "server":
        mut cfg := trojan.NewServerConfig(a[4], a[5])
        trojan.AddPassword(cfg, a[3])
        s := trojan.Serve(cfg, a[2].ToInt())
        if not s.ok:
            println "FAIL listen"
            ret 1
        end
        until true:
            sync.SleepMs(1000)
        end
    end
    ret udp_client(a)
end
