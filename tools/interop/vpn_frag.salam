package main

import net.vpn
import flag
import os

func rest_args(): Vector<str>:
    mut out := Vector {} as Vector<str>
    each i, a in os.Args():
        if i > 0: out.push(a) end
    end
    ret out
end

func main:
    mut fs := flag.New("vpn_frag", "vpn run with the TLS hello fragmenting options")
    flag.AddStr(fs, "config", "c", "", "JSON config file")
    flag.AddStr(fs, "mode", "", "tcp", "tcp, tls or both")
    flag.AddInt(fs, "min", "", 4, "smallest piece")
    flag.AddInt(fs, "max", "", 12, "largest piece")
    flag.AddInt(fs, "delay", "", 5, "milliseconds between pieces")
    flag.AddInt(fs, "writes", "", 1, "how many writes are fragmented")
    flag.AddBool(fs, "sni", "", false, "also cut inside the server name")
    if not flag.Parse(fs, rest_args()) or flag.GetStr(fs, "config").Len() == 0:
        println flag.Error(fs)
        ret 2
    end
    mut o := vpn.Options { fragment = true }
    o.fragment_mode = flag.GetStr(fs, "mode")
    o.fragment_min = flag.GetInt(fs, "min") as int
    o.fragment_max = flag.GetInt(fs, "max") as int
    o.fragment_delay_ms = flag.GetInt(fs, "delay") as int
    o.fragment_writes = flag.GetInt(fs, "writes") as int
    o.fragment_sni = flag.GetBool(fs, "sni")
    vpn.RegisterWith(o)
    ret vpn.RunConfig(flag.GetStr(fs, "config"), 0, 0)
end
