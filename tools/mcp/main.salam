// salam-mcp - a Model Context Protocol server for the Salam programming
// language, written in Salam.
//
// It speaks MCP over stdio: one JSON-RPC message per line in, one per line
// out, nothing but MCP messages on stdout, and logging on stderr. It exits as
// soon as stdin reaches EOF, which is the portable shutdown signal a client
// uses.
//
// Configuration is by environment, because a stdio server has nowhere else to
// get it:
//
//   SALAM_MCP_BIN   compiler to drive          (default: "salam" on PATH)
//   SALAM_MCP_ROOT  workspace to resolve       (default: ".")
//   SALAM_STD       stdlib root                (default: <root>/std)
//
// Build:   salam build tools/mcp/main.salam --output=salam-mcp
// Wire up: {"mcpServers":{"salam":{"command":"salam-mcp"}}}

package main

import mcprpc "mcp_rpc.salam"
import mcpsrv "mcp_server.salam"

func main:
    mcprpc.Log("ready (stdio); waiting for MCP messages on stdin")
    mut running := true
    until running:
        line := mcprpc.ReadLine()
        if line.eof:
            running = false
            continue
        end
        // A blank line is not a valid MCP message; ignore it rather than
        // answering with a parse error the client never asked for.
        if line.text.trim().len() == 0: continue end
        reply := mcpsrv.Dispatch(mcprpc.Parse(line.text))
        if reply.len() > 0: mcprpc.WriteMessage(reply) end
    end
    mcprpc.Log("stdin closed; exiting")
    ret 0
end
