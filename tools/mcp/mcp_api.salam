@en "mcpapi"
@fa "رابط‌ام‌سی‌پی"
package mcpapi

import mem
import str
import sort
import fs.dir
import fs
import fs.path

include mcptxt "mcp_text.salam"
include mcpexec "mcp_exec.salam"
include mcpdecl "mcp_decl.salam"

mut g_ready := false
mut g_root := ""
mut g_pkgs := Vector {} as Vector<str>
mut g_decls := Vector {} as Vector<mcpdecl.Decl>

func _lead(ln: str): int:
    mut i := 0
    until i < ln.Len() and (ln[i] == ' ' or ln[i] == '\t'):
        i++
    end
    ret i
end

func _indent(ln: str): int:
    mut n := 0
    mut i := 0
    until i < ln.Len():
        c := ln[i]
        if c == ' ':
            n++
        else c == '\t':
            n += 4
        else:
            ret n
        end
        i++
    end
    ret n
end

func _strip_word(t: str, word: str, ok &: bool): str:
    ok = false
    w := word.Concat(" ")
    if str.StartsWith(t, w):
        ok = true
        ret t.Substr(w.Len(), t.Len() - w.Len()).Trim()
    end
    ret t
end

func _modifier(t: str, rest &: str): bool:
    mut ok := false
    mods := Vector {} as Vector<str>
    mods.Push("inline")
    mods.Push("pure")
    mods.Push("noinline")
    mods.Push("noret")
    mods.Push("deprecated")
    mut i := 0
    until i < mods.Len():
        r := _strip_word(t, mods.Get(i), ok)
        if ok:
            rest = r
            ret true
        end
        i++
    end
    ret false
end

func _decl_head(line: str, public_only: bool, kind &: str): str:
    kind = ""
    if public_only and str.IndexFrom(line, "pub ", 0) != _lead(line):
        ret ""
    end
    mut t := line.Trim()
    mut ok := false
    t = _strip_word(t, "pub", ok)
    if public_only and not ok: ret "" end
    mut rest := ""
    until _modifier(t, rest):
        t = rest
    end
    each k in ["func", "struct", "enum", "const", "interface", "type"]:
        r := _strip_word(t, k, ok)
        if ok:
            kind = k
            ret r
        end
    end
    ret ""
end

func _ident_end(s: str, from: int, stops: str): int:
    mut i := from
    until i < s.Len():
        if stops.Find(s.Substr(i, 1)) >= 0: ret i end
        i++
    end
    ret s.Len()
end

func _name_of(kind: str, rest: str): str:
    if kind == "func": ret rest.Substr(0, _ident_end(rest, 0, "(<: ")).Trim() end
    if kind == "const":
        walrus := rest.Find(":=")
        colon := rest.Find(":")
        mut stop := rest.Len()
        if colon >= 0: stop = colon end
        if walrus >= 0 and walrus <= stop: stop = walrus end
        assign := rest.Find("=")
        if assign >= 0 and assign < stop: stop = assign end
        ret rest.Substr(0, stop).Trim()
    end
    ret rest.Substr(0, _ident_end(rest, 0, "<:= ")).Trim()
end

func _paren_depth(s: str): int:
    mut d := 0
    mut in_str := false
    mut i := 0
    until i < s.Len():
        c := s[i]
        if in_str:
            if c == '\\':
                i++
            else c == '"':
                in_str = false
            end
        else c == '"':
            in_str = true
        else c == '(':
            d++
        else c == ')':
            d--
        end
        i++
    end
    ret d
end

func _join_header(lines: Vector<str>, at: int, used &: int): str:
    mut h := lines.Get(at).Trim()
    used = 1
    mut depth := _paren_depth(h)
    mut j := at + 1
    until depth > 0 and j < lines.Len() and used < 40:
        part := lines.Get(j).Trim()
        if str.EndsWith(h, "(") or str.StartsWith(part, ")"):
            h = h.Concat(part)
        else:
            h = h.Concat(" ").Concat(part)
        end
        depth += _paren_depth(part)
        used++
        j++
    end
    ret str.Replace(h, ",)", ")")
end

func _body_word(s: str): bool:
    words := Vector {} as Vector<str>
    words.Push("ret")
    words.Push("if")
    words.Push("until")
    words.Push("repeat")
    words.Push("each")
    words.Push("mut")
    words.Push("print")
    words.Push("println")
    words.Push("defer")
    words.Push("match")
    words.Push("switch")
    mut i := 0
    until i < words.Len():
        w := words.Get(i)
        if s == w or str.StartsWith(s, w.Concat(" ")) or str.StartsWith(s, w.Concat("(")): ret true end
        i++
    end
    ret false
end

func _top_colon(s: str): int:
    mut depth := 0
    mut in_str := false
    mut i := 0
    until i < s.Len():
        c := s[i]
        if in_str:
            if c == '\\':
                i++
            else c == '"':
                in_str = false
            end
        else c == '"':
            in_str = true
        else c == '(' or c == '[' or c == '<':
            depth++
        else c == ')' or c == ']' or c == '>':
            depth--
        else c == ':' and depth <= 0:
            ret i
        end
        i++
    end
    ret 0 - 1
end

func _func_signature(h: str): str:
    open_p := h.Find("(")
    if open_p < 0: ret h end
    mut depth := 0
    mut close_p := 0 - 1
    mut i := open_p
    until i < h.Len() and close_p < 0:
        c := h[i]
        if c == '(': depth++ end
        if c == ')':
            depth--
            if depth == 0: close_p = i end
        end
        i++
    end
    if close_p < 0: ret h end
    head := h.Substr(0, close_p + 1)
    mut rest := h.Substr(close_p + 1, h.Len() - close_p - 1).Trim()
    if not str.StartsWith(rest, ":"): ret head end
    rest = rest.Substr(1, rest.Len() - 1).Trim()
    p := _top_colon(rest)
    if p < 0: ret head end
    ret_type := rest.Substr(0, p).Trim()
    if ret_type.Len() == 0 or _body_word(ret_type): ret head end
    ret head.Concat(": ").Concat(ret_type)
end

func _signature(kind: str, h: str, at_kw: str): str:
    kw := h.Find(at_kw.Concat(" "))
    mut s := h
    if kw >= 0: s = h.Substr(kw, h.Len() - kw) end
    if kind == "func": ret _func_signature(s) end
    if kind == "const": ret s end
    p := _top_colon(s)
    if p > 0: ret s.Substr(0, p).Trim() end
    ret s
end

func _fa_alias(lines: Vector<str>, at: int): str:
    mut j := at - 1
    until j >= 0 and j >= at - 4:
        ln := lines.Get(j).Trim()
        if str.StartsWith(ln, "@fa \"") and str.EndsWith(ln, "\""):
            ret ln.Substr(5, ln.Len() - 6)
        end
        if not str.StartsWith(ln, "@"): ret "" end
        j--
    end
    ret ""
end

func _block_end(lines: Vector<str>, at: int, ind: int): int:
    mut j := at + 1
    until j < lines.Len():
        ln := lines.Get(j)
        if ln.Trim() == "end" and _indent(ln) == ind: ret j end
        if ln.Trim().Len() > 0 and _indent(ln) < ind: ret j end
        j++
    end
    ret lines.Len()
end

func _member_indent(lines: Vector<str>, from: int, stop: int): int:
    mut j := from
    until j < stop:
        if lines.Get(j).Trim().Len() > 0: ret _indent(lines.Get(j)) end
        j++
    end
    ret 0 - 1
end

func _field_text(t: str): str:
    mut ok := false
    f := _strip_word(t, "pub", ok)
    eq_at := f.Find(" = ")
    if eq_at > 0:
        dflt := f.Substr(eq_at + 3, f.Len() - eq_at - 3).Trim()
        if str.EndsWith(dflt, "[") or str.EndsWith(dflt, "{") or str.EndsWith(dflt, "(") or str.EndsWith(dflt, ","):
            ret f.Substr(0, eq_at).Trim()
        end
    end
    ret f
end

func _new_decl(kind: str, name: str, sig: str, pkg: str, rel: str, line: int, fa: str): mcpdecl.Decl:
    mut d := mcpdecl.Decl {}
    d.kind = kind
    d.name = name
    d.signature = sig
    d.pkg = pkg
    d.file = rel
    d.line = line
    d.fa = fa
    ret d
end

func _scan_members(out &: Vector<mcpdecl.Decl>, lines: Vector<str>, at: int, owner: str, kind: str, pkg: str, rel: str): str:
    ind := _indent(lines.Get(at))
    stop := _block_end(lines, at, ind)
    mind := _member_indent(lines, at + 1, stop)
    mut fields := Vector {} as Vector<str>
    mut j := at + 1
    until j < stop:
        ln := lines.Get(j)
        t := ln.Trim()
        if t.Len() > 0 and _indent(ln) == mind and t != "end" and not str.StartsWith(t, "@") and not str.StartsWith(t, "//"):
            mut mk := ""
            rest := _decl_head(t, kind == "struct", mk)
            if mk == "func":
                mut used := 0
                h := _join_header(lines, j, used)
                mut m := _new_decl("method", _name_of("func", rest), _signature("func", h, "func"), pkg, rel, j + 1, _fa_alias(lines, j))
                m.receiver = owner
                out.Push(m)
            else str.StartsWith(t, "pub ") and t.Find(":") > 0:
                fields.Push(_field_text(t))
            end
        end
        j++
    end
    ret mcptxt.Join(fields, "\n")
end

func _enum_members(lines: Vector<str>, at: int): str:
    h := lines.Get(at).Trim()
    colon := _top_colon(h)
    mut body := ""
    if colon >= 0: body = h.Substr(colon + 1, h.Len() - colon - 1).Trim() end
    if str.EndsWith(body, " end"): ret body.Substr(0, body.Len() - 4).Trim() end
    if body == "end": ret "" end
    ind := _indent(lines.Get(at))
    stop := _block_end(lines, at, ind)
    mut parts := Vector {} as Vector<str>
    if body.Len() > 0: parts.Push(body) end
    mut j := at + 1
    until j < stop:
        t := lines.Get(j).Trim()
        if t.Len() > 0 and not str.StartsWith(t, "@") and not str.StartsWith(t, "//"): parts.Push(t) end
        j++
    end
    ret str.Replace(mcptxt.Join(parts, " "), ", ", ", ")
end

func _one_line(t: str): bool:
    ret str.EndsWith(t, " end") or t.Find(": end") > 0
end

func _scan_file(out &: Vector<mcpdecl.Decl>, full: str, pkg: str, rel: str):
    text := fs.ReadText(full)
    mut lines := mcptxt.Lines(text)
    mem.Free(text as void*)
    defer mcptxt.FreeLines(lines)
    mut i := 0
    until i < lines.Len():
        ln := lines.Get(i)
        mut kind := ""
        rest := _decl_head(ln, true, kind)
        if kind.Len() > 0 and _indent(ln) <= 4:
            name := _name_of(kind, rest)
            mut used := 1
            mut h := ln.Trim()
            if kind == "func": h = _join_header(lines, i, used) end
            mut d := _new_decl(kind, name, _signature(kind, h, kind), pkg, rel, i + 1, _fa_alias(lines, i))
            if (kind == "struct" or kind == "interface") and not _one_line(ln.Trim()):
                d.members = _scan_members(out, lines, i, name, kind, pkg, rel)
            end
            if kind == "enum": d.members = _enum_members(lines, i) end
            out.Push(d)
            if (kind == "struct" or kind == "interface" or kind == "enum") and not _one_line(ln.Trim()):
                used = _block_end(lines, i, _indent(ln)) - i + 1
            end
            i += used
        else:
            i++
        end
    end
end

func _is_package(root: str, name: str): bool:
    ret fs.Exists(path.Join(path.Join(root, name), name.Concat(".salam")))
end

func _collect(pkgs &: Vector<str>, decls &: Vector<mcpdecl.Decl>, dir_path: str, prefix: str):
    names := mcptxt.Sorted(dir.ListDirs(dir_path))
    mut i := 0
    until i < names.Len():
        n := names.Get(i)
        if not str.StartsWith(n, ".") and _is_package(dir_path, n):
            mut full := n
            if prefix.Len() > 0: full = prefix.Concat(".").Concat(n) end
            pkgs.Push(full)
            sub := path.Join(dir_path, n)
            files := mcptxt.Sorted(dir.List(sub))
            mut j := 0
            until j < files.Len():
                f := files.Get(j)
                if str.EndsWith(f, ".salam"):
                    rel := "std/".Concat(str.Replace(full, ".", "/")).Concat("/").Concat(f)
                    _scan_file(decls, path.Join(sub, f), full, rel)
                end
                j++
            end
            _collect(pkgs, decls, sub, full)
        end
        i++
    end
end

func _ensure():
    root := mcpexec.StdRoot()
    if g_ready and g_root == root: ret end
    mut pkgs := Vector {} as Vector<str>
    mut decls := Vector {} as Vector<mcpdecl.Decl>
    if dir.Exists(root): _collect(pkgs, decls, root, "") end
    g_pkgs = pkgs
    g_decls = decls
    g_root = root
    g_ready = true
end

func _score(d: mcpdecl.Decl, terms: Vector<str>): int:
    mut total := 0
    mut in_name := 0
    lname := d.name.Lower()
    mut leaf := d.pkg.Lower()
    mut dot := leaf.Find(".")
    mut k := 0
    until k < 4 and dot >= 0:
        leaf = leaf.Substr(dot + 1, leaf.Len() - dot - 1)
        dot = leaf.Find(".")
        k++
    end
    mut i := 0
    until i < terms.Len():
        alts := mcptxt.Split(terms.Get(i), " ")
        mut s := 0
        mut a := 0
        until a < alts.Len():
            mut v := _term_score(d, lname, leaf, alts.Get(a))
            if a > 0: v = v * 9 / 10 end
            if v > s: s = v end
            a++
        end
        if s == 0: ret 0 end
        if s >= 40: in_name++ end
        total += s
        i++
    end
    if terms.Len() > 1 and in_name == terms.Len(): total += 60 end
    if d.kind == "const": total /= 2 end
    ret total
end

func _term_score(d: mcpdecl.Decl, lname: str, leaf: str, t: str): int:
    if t.Len() == 0: ret 0 end
    mut s := 0
    if lname == t:
        s = 100
    else str.StartsWith(lname, t):
        s = 60
    else lname.Find(t) >= 0:
        s = 40
    else leaf == t:
        s = 45
    else d.fa.Find(t) >= 0:
        s = 35
    else d.receiver.Lower().Find(t) >= 0:
        s = 25
    else d.pkg.Lower().Find(t) >= 0:
        s = 20
    else d.signature.Lower().Find(t) >= 0:
        s = 10
    else d.members.Lower().Find(t) >= 0:
        s = 5
    end
    ret s
end

func _synonyms(w: str): str:
    switch w:
        "random": ret "rand" end
        "regexp", "re", "pattern": ret "regex" end
        "string", "text": ret "str" end
        "folder", "directory", "mkdir": ret "dir" end
        "date", "datetime", "clock": ret "time calendar" end
        "wait", "delay": ret "sleep" end
        "hash", "digest": ret "sha md5 hash crypto" end
        "encrypt", "decrypt", "cipher": ret "aes crypto encrypt decrypt" end
        "environment", "getenv": ret "env" end
        "args", "argv", "arguments", "flags": ret "args flag cli" end
        "subprocess", "command", "exec", "spawn": ret "process shell run exec" end
        "socket": ret "tcp udp socket" end
        "mutex", "lock": ret "mutex sync lock" end
        "channel", "channels": ret "chan" end
        "database", "sql", "sqlite", "postgres", "mysql": ret "db sqlite postgres mysql" end
        "logging", "logger": ret "log" end
        "printf", "sprintf", "format": ret "fmt format sprintf" end
        "uppercase": ret "upper" end
        "lowercase": ret "lower" end
        "contains": ret "contains includes" end
        "length", "size", "count": ret "len size count" end
        "atoi", "parseint", "parse_int": ret "toint parseint to_int conv" end
        "dict", "dictionary", "hashmap": ret "map hashmap" end
        "list", "array": ret "vector array list" end
        "download", "fetch", "request": ret "get http fetch request" end
        "upload": ret "post put upload" end
    end
    ret ""
end

func _terms(query: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    words := mcptxt.Split(query.Lower().Trim(), " ")
    mut i := 0
    until i < words.Len():
        w := words.Get(i).Trim()
        if w.Len() > 0:
            syn := _synonyms(w)
            if syn.Len() > 0:
                out.Push(w.Concat(" ").Concat(syn))
            else:
                out.Push(w)
            end
        end
        i++
    end
    ret out
end

@en "Packages"
@fa "بسته‌ها"
pub func Packages(): Vector<str>:
    _ensure()
    ret g_pkgs
end

@en "HasPackage"
@fa "بسته دارد"
pub func HasPackage(name: str): bool:
    _ensure()
    mut i := 0
    until i < g_pkgs.Len():
        if g_pkgs.Get(i) == name: ret true end
        i++
    end
    ret false
end

@en "Of"
@fa "از بسته"
pub func Of(pkg: str): Vector<mcpdecl.Decl>:
    _ensure()
    mut out := Vector {} as Vector<mcpdecl.Decl>
    mut i := 0
    until i < g_decls.Len():
        d := g_decls.Get(i)
        if d.pkg == pkg: out.Push(d) end
        i++
    end
    ret out
end

@en "Search"
@fa "جستجو"
pub func Search(query: str, pkg: str, limit: int): Vector<mcpdecl.Decl>:
    _ensure()
    terms := _terms(query)
    mut picked := Vector {} as Vector<mcpdecl.Decl>
    mut keys := Vector {} as Vector<f64>
    mut i := 0
    until i < g_decls.Len():
        d := g_decls.Get(i)
        if pkg.Len() == 0 or d.pkg == pkg or str.StartsWith(d.pkg, pkg.Concat(".")):
            s := _score(d, terms)
            if s > 0:
                picked.Push(d)
                keys.Push((s * 1000 - d.name.Len() * 3 - d.pkg.Len()) as f64)
            end
        end
        i++
    end
    mut idx := Vector {} as Vector<int>
    mut k := 0
    until k < picked.Len():
        idx.Push(k)
        k++
    end
    sort.SortIndexDesc(idx, keys)
    mut out := Vector {} as Vector<mcpdecl.Decl>
    mut cap := limit
    if cap <= 0: cap = 25 end
    mut j := 0
    until j < idx.Len() and out.Len() < cap:
        out.Push(picked.Get(idx.Get(j)))
        j++
    end
    ret out
end

@en "Total"
@fa "شمار"
pub func Total(): int:
    _ensure()
    ret g_decls.Len()
end
