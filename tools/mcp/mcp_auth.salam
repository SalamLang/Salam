@en "mcpauth"
@fa "احراز‌ام‌سی‌پی"
package mcpauth

import str
import env
import sync
import chan
import time
import crypto
import encoding
import encoding.json
import net.http

include mcprpc "mcp_rpc.salam"

mut g_url := ""
mut g_secret := ""
mut g_service := ""
mut g_issuer := ""
mut g_resources := Vector {} as Vector<str>
mut g_lock := sync.Mutex {}
mut g_cache := HashMap {} as HashMap<str, str>
mut g_queue := chan.Chan {} as chan.Chan<str>
mut g_dropped := 0

@en "Principal"
pub struct Principal:
    pub ok: bool = false
    pub problem: str = ""
    pub grant: str = ""
    pub user: str = ""
    pub email: str = ""
    pub client: str = ""
    pub scope: str = ""
end

func _normal(r: str): str:
    mut v := r.Trim()
    if str.EndsWith(v, "/") and v.Len() > 8: v = v.Substr(0, v.Len() - 1) end
    slash := v.Find("://")
    if slash < 0: ret v end
    rest := v.Substr(slash + 3, v.Len() - slash - 3)
    cut := rest.Find("/")
    mut host := rest
    mut path := ""
    if cut >= 0:
        host = rest.Substr(0, cut)
        path = rest.Substr(cut, rest.Len() - cut)
    end
    ret v.Substr(0, slash).Lower().Concat("://").Concat(host.Lower()).Concat(path)
end

func _known(resource: str): bool:
    want := _normal(resource)
    mut i := 0
    until i < g_resources.Len():
        if g_resources.Get(i) == want: ret true end
        i++
    end
    ret false
end

func _basic(): str:
    ret "Basic ".Concat(encoding.Base64Encode("salam-mcp:".Concat(g_secret)))
end

func _field(cached: str, index: int): str:
    mut rest := cached
    mut i := 0
    until i < index:
        bar := rest.Find("|")
        if bar < 0: ret "" end
        rest = rest.Substr(bar + 1, rest.Len() - bar - 1)
        i++
    end
    bar := rest.Find("|")
    if bar < 0: ret rest end
    ret rest.Substr(0, bar)
end

func _from_cache(key: str, found &: bool): str:
    _l := sync.Lock(g_lock)
    mut out := ""
    found = false
    if g_cache.Has(key):
        v := g_cache.Get(key)
        if _field(v, 0).ToInt() as i64 > time.Now():
            out = v
            found = true
        end
    end
    _u := sync.Unlock(g_lock)
    ret out
end

func _to_cache(key: str, v: str):
    _l := sync.Lock(g_lock)
    if g_cache.Size() > 5000:
        g_cache.Free()
        g_cache = HashMap {} as HashMap<str, str>
    end
    g_cache.Put(key, v)
    _u := sync.Unlock(g_lock)
end

func _clean(s: str): str:
    ret str.Replace(s, "|", "")
end

func _introspect(token: str): str:
    mut headers := http.NewHeaders()
    headers.Put("Authorization", _basic())
    headers.Put("Content-Type", "application/x-www-form-urlencoded")
    headers.Put("Accept", "application/json")
    r := http.PostWith(g_url.Concat("/oauth/introspect"), "token=".Concat(encoding.URLEncode(token)), headers)
    if http.Status(r) != 200: ret "" end
    body := http.Body(r)
    now := time.Now()
    if json.Get(body, "active") != "true":
        ret str.FromInt(now + 10).Concat("|0")
    end
    exp := json.Get(body, "exp").ToInt() as i64
    if exp <= now: ret str.FromInt(now + 10).Concat("|0") end
    if not _known(json.Get(body, "aud")): ret str.FromInt(now + 10).Concat("|0") end
    mut until_t := now + 30
    if exp < until_t: until_t = exp end
    mut parts := Vector {} as Vector<str>
    parts.Push(str.FromInt(until_t))
    parts.Push("1")
    parts.Push(_clean(json.Get(body, "grant_id")))
    parts.Push(_clean(json.Get(body, "sub")))
    parts.Push(_clean(json.Get(body, "username")))
    parts.Push(_clean(json.Get(body, "client_name")))
    parts.Push(_clean(json.Get(body, "scope")))
    mut out := parts.Get(0)
    mut i := 1
    until i < parts.Len():
        out = out.Concat("|").Concat(parts.Get(i))
        i++
    end
    ret out
end

func _worker():
    mut open := true
    until open:
        payload := g_queue.recv(open)
        if not open: break end
        mut headers := http.NewHeaders()
        headers.Put("Authorization", _basic())
        headers.Put("Content-Type", "application/json")
        r := http.PostWith(g_url.Concat("/internal/mcp/events"), payload, headers)
        if http.Status(r) >= 300: mcprpc.Log("could not record an event: HTTP ".Concat(str.FromInt(http.Status(r)))) end
    end
end

@en "Configure"
@fa "پیکربندی"
pub func Configure():
    g_url = str.TrimSuffix(env.GetOr("SALAM_MCP_AUTH_URL", "").Trim(), "/")
    g_secret = env.GetOr("SALAM_MCP_AUTH_SECRET", "")
    g_service = env.GetOr("SALAM_MCP_SERVICE_TOKEN", "")
    if g_service.Len() < 32: g_service = "" end
    g_issuer = str.TrimSuffix(env.GetOr("SALAM_MCP_ISSUER", "https://ai-api.salamlang.ir"), "/")
    list := env.GetOr("SALAM_MCP_RESOURCES", "https://mcp.salamlang.ir/mcp")
    mut cur := ""
    mut i := 0
    until i <= list.Len():
        mut c := ","
        if i < list.Len(): c = list.Substr(i, 1) end
        if c == ",":
            if cur.Trim().Len() > 0: g_resources.Push(_normal(cur)) end
            cur = ""
        else:
            cur = cur.Concat(c)
        end
        i++
    end
    if g_url.Len() == 0: ret end
    g_lock = sync.NewMutex()
    g_queue.init(1024)
    _w := spawn(_worker)
    mcprpc.Log("sign-in required; tokens checked at ".Concat(g_url))
end

@en "Enabled"
@fa "فعال"
pub func Enabled(): bool:
    ret g_url.Len() > 0
end

@en "Resource"
@fa "منبع"
pub func Resource(scheme: str, host: str): str:
    if scheme.Len() > 0 and host.Len() > 0:
        guess := _normal(scheme.Concat("://").Concat(host).Concat("/mcp"))
        if _known(guess): ret guess end
    end
    if g_resources.Len() > 0: ret g_resources.Get(0) end
    ret ""
end

@en "MetadataUrl"
@fa "نشانی فراداده"
pub func MetadataUrl(resource: str): str:
    slash := resource.Find("://")
    if slash < 0: ret resource end
    rest := resource.Substr(slash + 3, resource.Len() - slash - 3)
    cut := rest.Find("/")
    if cut < 0: ret resource.Concat("/.well-known/oauth-protected-resource") end
    origin := resource.Substr(0, slash + 3 + cut)
    ret origin.Concat("/.well-known/oauth-protected-resource").Concat(rest.Substr(cut, rest.Len() - cut))
end

@en "Metadata"
@fa "فراداده"
pub func Metadata(resource: str): str:
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("resource", resource))
    m.Push(json.MemberRaw("authorization_servers", "[".Concat(json.Str(g_issuer)).Concat("]")))
    m.Push(json.MemberRaw("scopes_supported", `["mcp"]`))
    m.Push(json.MemberRaw("bearer_methods_supported", `["header"]`))
    m.Push(json.Member("resource_name", "Salam MCP"))
    m.Push(json.Member("resource_documentation", "https://mcp.salamlang.ir/"))
    ret json.Object(m)
end

@en "Challenge"
@fa "چالش"
pub func Challenge(resource: str, error: str, description: str): str:
    mut v := "Bearer resource_metadata=\"".Concat(MetadataUrl(resource)).Concat("\", scope=\"mcp\"")
    if error.Len() > 0:
        v = v.Concat(", error=\"").Concat(error).Concat("\", error_description=\"").Concat(description).Concat("\"")
    end
    ret v
end

@en "Check"
@fa "بررسی"
pub func Check(token: str): Principal:
    if token.Len() < 20 or token.Len() > 512:
        ret Principal { problem = "missing" }
    end
    if g_service.Len() > 0 and crypto.SecretEquals(token, g_service):
        ret Principal { ok = true, grant = "service", user = "", email = "", client = "salam-ai", scope = "mcp" }
    end
    key := crypto.Sha256Hex(token)
    mut found := false
    mut cached := _from_cache(key, found)
    if not found:
        cached = _introspect(token)
        if cached.Len() == 0: ret Principal { problem = "unavailable" } end
        _to_cache(key, cached)
    end
    if _field(cached, 1) != "1": ret Principal { problem = "invalid" } end
    scope := _field(cached, 6)
    if (" ".Concat(scope).Concat(" ")).Find(" mcp ") < 0:
        ret Principal { problem = "scope" }
    end
    ret Principal { ok = true, grant = _field(cached, 2), user = _field(cached, 3), email = _field(cached, 4), client = _field(cached, 5), scope = scope }
end

@en "Record"
@fa "ثبت"
pub func Record(p: Principal, method: str, tool: str, ok: bool, ms: i64, args: str, ip: str, agent: str):
    if not Enabled() or not p.ok: ret end
    mut m := Vector {} as Vector<str>
    m.Push(json.Member("grant_id", p.grant))
    m.Push(json.Member("method", method))
    m.Push(json.Member("tool", tool))
    m.Push(json.MemberBool("ok", ok))
    m.Push(json.MemberInt("ms", ms))
    m.Push(json.Member("args", args))
    m.Push(json.Member("ip", ip))
    m.Push(json.Member("agent", agent))
    if not g_queue.try_send(json.Object(m)):
        _l := sync.Lock(g_lock)
        g_dropped++
        total := g_dropped
        _u := sync.Unlock(g_lock)
        mcprpc.Log("activity queue full; dropped an event (".Concat(str.FromInt(total)).Concat(" so far)"))
    end
end

@en "Dropped"
@fa "دورریخته"
pub func Dropped(): int:
    if not Enabled(): ret 0 end
    _l := sync.Lock(g_lock)
    v := g_dropped
    _u := sync.Unlock(g_lock)
    ret v
end
