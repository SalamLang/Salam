@en "mcpdecl"
@fa "اعلان‌ام‌سی‌پی"
package mcpdecl

@en "Decl"
pub struct Decl:
    pub kind: str = ""
    pub name: str = ""
    pub signature: str = ""
    pub receiver: str = ""
    pub pkg: str = ""
    pub file: str = ""
    pub line: int = 0
    pub fa: str = ""
    pub members: str = ""
end

@en "Section"
pub struct Section:
    pub title: str = ""
    pub trail: str = ""
    pub source: str = ""
    pub level: int = 0
    pub start: int = 0
    pub own_end: int = 0
    pub tree_end: int = 0
end
