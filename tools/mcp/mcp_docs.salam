@en "mcpdoc"
@fa "مستندات‌ام‌سی‌پی"
@ar "وثائق‌ام‌سی‌بی"
package mcpdoc

import str
import env
import fs.dir
import fs.file
import fs.path
import encoding.value
import mcptxt "mcp_text.salam"
import mcpexec "mcp_exec.salam"
import mcpout "mcp_result.salam"

func _std_root(): str:
    pinned := env.GetOr("SALAM_STD", "")
    if pinned.len() > 0: ret pinned end
    ret path.Join(mcpexec.Root(), "std")
end

func _is_salam(p: str): bool:
    ret str.EndsWith(p, ".salam")
end

func _is_package(root: str, name: str): bool:
    ret file.Exists(path.Join(path.Join(root, name), name.concat(".salam")))
end

func _collect_pkgs(out &: Vector<str>, dir_path: str, prefix: str):
    names := mcptxt.Sorted(dir.ListDirs(dir_path))
    mut i := 0
    until i < names.len():
        n := names.get(i)
        if !str.StartsWith(n, ".") && _is_package(dir_path, n):
            mut full := n
            if prefix.len() > 0: full = prefix.concat(".").concat(n) end
            out.push(full)
            _collect_pkgs(out, path.Join(dir_path, n), full)
        end
        i += 1
    end
end

func _pkg_dir(root: str, pkg: str): str:
    parts := str.Split(pkg, ".")
    mut p := root
    mut i := 0
    until i < parts.len():
        p = path.Join(p, parts.get(i))
        i += 1
    end
    ret p
end

func _pkg_sources(pkg_dir: str): Vector<str>:
    out := Vector {} as Vector<str>
    if !dir.Exists(pkg_dir): ret out end
    names := mcptxt.Sorted(dir.List(pkg_dir))
    mut i := 0
    until i < names.len():
        n := names.get(i)
        if _is_salam(n): out.push(path.Join(pkg_dir, n)) end
        i += 1
    end
    ret out
end

func _sources(root: str): Vector<str>:
    out := Vector {} as Vector<str>
    if !dir.Exists(root): ret out end
    all := mcptxt.Sorted(dir.Walk(root))
    mut i := 0
    until i < all.len():
        p := all.get(i)
        if _is_salam(p): out.push(p) end
        i += 1
    end
    ret out
end

func _decl_kind(line: str): str:
    t := line.trim()
    if str.StartsWith(t, "pub func "): ret "func" end
    if str.StartsWith(t, "pub inline func "): ret "func" end
    if str.StartsWith(t, "pub pure func "): ret "func" end
    if str.StartsWith(t, "pub inline pure func "): ret "func" end
    if str.StartsWith(t, "pub struct "): ret "struct" end
    if str.StartsWith(t, "pub enum "): ret "enum" end
    if str.StartsWith(t, "pub const "): ret "const" end
    if str.StartsWith(t, "pub type "): ret "type" end
    ret ""
end

func _decls_in(file_path: str, query: str): Vector<str>:
    out := Vector {} as Vector<str>
    lines := mcptxt.Lines(file.ReadText(file_path))
    mut i := 0
    until i < lines.len():
        ln := lines.get(i)
        kind := _decl_kind(ln)
        if kind.len() > 0 && mcptxt.ContainsFold(ln, query):
            out.push(ln.trim())
        end
        i += 1
    end
    ret out
end

func _hits_in(file_path: str, query: str, cap: int): Vector<str>:
    out := Vector {} as Vector<str>
    lines := mcptxt.Lines(file.ReadText(file_path))
    mut i := 0
    until i < lines.len() && out.len() < cap:
        ln := lines.get(i)
        if mcptxt.ContainsFold(ln, query):
            out.push(str.FromInt(i + 1).concat(": ").concat(ln.trim()))
        end
        i += 1
    end
    ret out
end

func _kw_table(src: str, array_name: str): Vector<str>:
    out := Vector {} as Vector<str>
    start := src.find(array_name)
    if start < 0: ret out end
    rest := src.substr(start, src.len() - start)
    open_b := rest.find("[")
    if open_b < 0: ret out end
    stop := rest.find("]")
    if stop < 0: ret out end
    body := rest.substr(open_b + 1, stop - open_b - 1)
    mut i := 0
    mut cur := ""
    mut inside := false
    until i < body.len():
        c := body.substr(i, 1)
        if str.Equals(c, "\""):
            if inside:
                if cur.len() > 0: out.push(cur) end
                cur = ""
                inside = false
            else:
                inside = true
            end
        else inside:
            cur = cur.concat(c)
        end
        i += 1
    end
    ret out
end

func _kw_pair(ln: str): str:
    comma := ln.find(",")
    tok := ln.substr(1, comma - 1)
    q1 := ln.find("\"")
    rest := ln.substr(q1 + 1, ln.len() - q1 - 1)
    q2 := rest.find("\"")
    word := rest.substr(0, q2)
    ret str.TrimPrefix(tok, "TK_KW_").concat("\t").concat(word)
end

func _langpack_src(): str:
    p := path.Join(mcpexec.Root(), "compiler/langpack.salam")
    ret file.ReadText(p)
end

func _word(pair: str): str:
    tab := pair.find("\t")
    if tab < 0: ret pair end
    ret pair.substr(tab + 1, pair.len() - tab - 1)
end

func _row(en: Vector<str>, fa: Vector<str>, ar: Vector<str>, i: int): str:
    mut line := en.get(i)
    if i < fa.len(): line = line.concat("\t").concat(fa.get(i)) end
    if i < ar.len(): line = line.concat("\t").concat(ar.get(i)) end
    ret line
end

@en "Packages"
@fa "بسته‌ها"
@ar "الحزم"
pub func Packages(): mcpout.ToolResult:
    root := _std_root()
    if !dir.Exists(root):
        ret mcpout.Failure("stdlib not found at ".concat(root).concat(" - set SALAM_STD or SALAM_MCP_ROOT."))
    end
    mut items := Vector {} as Vector<str>
    _collect_pkgs(items, root, "")
    body := "Importable std packages (".concat(str.FromInt(items.len())).concat("):\n\n").concat(mcpout.Bullets(items))
    ret mcpout.Rich(body, mcpout.StrArray(items), false)
end

@en "Symbols"
@fa "نمادها"
@ar "الرموز"
pub func Symbols(pkg: str, query: str): mcpout.ToolResult:
    if !mcpexec.SafePath(pkg): ret mcpout.Failure("unsupported package name: ".concat(pkg)) end
    root := _pkg_dir(_std_root(), pkg)
    if !dir.Exists(root): ret mcpout.Failure("no such std package: ".concat(pkg)) end
    files := _pkg_sources(root)
    mut all := Vector {} as Vector<str>
    mut i := 0
    until i < files.len():
        decls := _decls_in(files.get(i), query)
        mut j := 0
        until j < decls.len():
            all.push(decls.get(j))
            j += 1
        end
        i += 1
    end
    if all.len() == 0:
        ret mcpout.Text("No public declarations matched in std/".concat(str.Replace(pkg, ".", "/")).concat("."))
    end
    body := "Public declarations in std/".concat(str.Replace(pkg, ".", "/")).concat(" (").concat(str.FromInt(all.len())).concat("):\n\n").concat(mcpout.Bullets(all))
    ret mcpout.Rich(body, mcpout.StrArray(all), false)
end

@en "FindExamples"
@fa "یافتن نمونه‌ها"
@ar "ابحث عن أمثلة"
pub func FindExamples(query: str, limit: int): mcpout.ToolResult:
    if query.trim().len() == 0: ret mcpout.Failure("query must not be empty") end
    root := path.Join(mcpexec.Root(), "tests")
    files := _sources(root)
    mut cap := limit
    if cap <= 0: cap = 20 end
    mut items := Vector {} as Vector<str>
    mut i := 0
    until i < files.len() && items.len() < cap:
        f := files.get(i)
        hits := _hits_in(f, query, 2)
        if hits.len() > 0:
            items.push(f.concat("\n    ").concat(mcptxt.Join(hits, "\n    ")))
        end
        i += 1
    end
    if items.len() == 0: ret mcpout.Text("No examples matched '".concat(query).concat("'.")) end
    body := "Examples matching '".concat(query).concat("':\n\n").concat(mcpout.Bullets(items))
    ret mcpout.Rich(body, mcpout.StrArray(items), false)
end

@en "ReadSource"
@fa "خواندن منبع"
@ar "قراءة المصدر"
pub func ReadSource(rel: str, start: int, count: int): mcpout.ToolResult:
    if !mcpexec.SafePath(rel): ret mcpout.Failure("unsupported path: ".concat(rel)) end
    full := path.Join(mcpexec.Root(), rel)
    if !file.Exists(full): ret mcpout.Failure("no such file: ".concat(rel)) end
    lines := mcptxt.Lines(file.ReadText(full))
    mut from := start
    if from < 1: from = 1 end
    mut n := count
    if n <= 0: n = 200 end
    mut picked := Vector {} as Vector<str>
    mut i := from - 1
    until i < lines.len() && picked.len() < n:
        picked.push(str.FromInt(i + 1).concat("\t").concat(lines.get(i)))
        i += 1
    end
    ret mcpout.Text(rel.concat("\n\n").concat(mcptxt.Join(picked, "\n")))
end

@en "Keywords"
@fa "کلیدواژه‌ها"
@ar "الکلمات المفتاحیة"
pub func Keywords(): mcpout.ToolResult:
    src := _langpack_src()
    if src.len() == 0:
        ret mcpout.Failure("langpack source not readable; set SALAM_MCP_ROOT to the Salam checkout.")
    end
    en := _kw_table(src, "k_kw_spell_en :=")
    fa := _kw_table(src, "k_kw_spell_fa :=")
    ar := _kw_table(src, "k_kw_spell_ar :=")
    mut rows := Vector {} as Vector<str>
    rows.push("english\tpersian\tarabic")
    mut i := 0
    until i < en.len():
        rows.push(_row(en, fa, ar, i))
        i += 1
    end
    body := "Salam is written in English, Persian or Arabic; these are the same keywords in each.\n\n".concat(mcptxt.Join(rows, "\n"))
    ret mcpout.Rich(body, mcpout.StrArray(rows), false)
end
