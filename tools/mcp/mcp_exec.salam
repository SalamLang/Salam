@en "mcpexec"
@fa "اجرای‌ام‌سی‌پی"
package mcpexec

import str
import os
import env
import fs.file
import fs.path
import os.temp
import mcptxt "mcp_text.salam"

@en "Outcome"
pub struct Outcome:
    pub code: int = 0
    pub out: str = ""
    pub err: str = ""
    pub launched: bool = false
    pub reason: str = ""
end

func _is_unsafe(a: str): bool:
    bad := "\"<>|&^%`$;\n\r"
    mut i := 0
    until i < bad.len():
        if a.find(bad.substr(i, 1)) >= 0: ret true end
        i += 1
    end
    ret false
end

func _quote(a: str): str:
    ret "\"".concat(a).concat("\"")
end

if SALAM_OS_WINDOWS:
    func _shell_wrap(line: str): str: ret "\"".concat(line).concat("\"") end
else:
    func _shell_wrap(line: str): str: ret line end
end

func _cmdline(exe: str, args: Vector<str>, out_path: str, err_path: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, _quote(exe))
    mut i := 0
    until i < args.len():
        str.BufAppend(sb, " ")
        str.BufAppend(sb, _quote(args.get(i)))
        i += 1
    end
    str.BufAppend(sb, " >")
    str.BufAppend(sb, _quote(out_path))
    str.BufAppend(sb, " 2>")
    str.BufAppend(sb, _quote(err_path))
    line := str.BufStr(sb)
    ret line
end

func _reject(reason: str): Outcome:
    ret Outcome { code = 0 - 1, launched = false, reason = reason }
end

@en "Binary"
@fa "برنامه"
pub func Binary(): str:
    pinned := env.GetOr("SALAM_MCP_BIN", "")
    if pinned.len() > 0: ret pinned end
    root := Root()
    win := path.Join(root, "salam.exe")
    if file.Exists(win): ret win end
    nix := path.Join(root, "salam")
    if file.Exists(nix): ret nix end
    ret "salam"
end

@en "Root"
@fa "ریشه"
pub func Root(): str:
    ret env.GetOr("SALAM_MCP_ROOT", ".")
end

@en "SafeArg"
@fa "آرگومان امن"
pub func SafeArg(a: str): bool:
    if a.len() == 0: ret false end
    ret !_is_unsafe(a)
end

@en "SafePath"
@fa "مسیر امن"
pub func SafePath(p: str): bool:
    if !SafeArg(p): ret false end
    if p.find("..") >= 0: ret false end
    ret true
end

@en "Run"
@fa "اجرا کن"
pub func Run(args: Vector<str>): Outcome:
    exe := Binary()
    if !SafeArg(exe): ret _reject("compiler path contains unsupported characters") end
    mut i := 0
    until i < args.len():
        if !SafeArg(args.get(i)):
            ret _reject("argument contains unsupported characters: ".concat(args.get(i)))
        end
        i += 1
    end

    out_path := temp.File()
    err_path := temp.File()
    code := os.Run(_shell_wrap(_cmdline(exe, args, out_path, err_path)))
    out := file.ReadText(out_path)
    err := file.ReadText(err_path)
    temp.Remove(out_path)
    temp.Remove(err_path)

    ret Outcome { code = code, out = out, err = err, launched = true }
end

@en "Diagnostics"
@fa "تشخیص‌ها"
pub func Diagnostics(err: str): Vector<str>:
    out := Vector {} as Vector<str>
    lines := mcptxt.Lines(err)
    mut i := 0
    until i < lines.len():
        ln := lines.get(i).trim()
        if str.StartsWith(ln, "{\"level\""): out.push(ln) end
        i += 1
    end
    ret out
end
