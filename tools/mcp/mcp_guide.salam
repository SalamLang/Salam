@en "mcpguide"
@fa "راهنمای‌ام‌سی‌پی"
package mcpguide

import str
import sort
import fs.dir
import fs
import fs.path

include mcptxt "mcp_text.salam"
include mcpexec "mcp_exec.salam"
include mcpdecl "mcp_decl.salam"

mut g_ready := false
mut g_sections := Vector {} as Vector<mcpdecl.Section>
mut g_texts := HashMap {} as HashMap<str, Vector<str>>
mut g_codes_ready := false
mut g_code_files := HashMap {} as HashMap<str, Vector<str>>

func _sources(): Vector<str>:
    out := Vector {} as Vector<str>
    out.push("SKILL.md")
    out.push("docs/ai/AGENTS.md")
    ret out
end

func _heading_level(ln: str): int:
    mut n := 0
    until n < ln.Len() and ln[n] == '#':
        n++
    end
    if n == 0 or n > 4 or n >= ln.Len(): ret 0 end
    if ln[n] != ' ': ret 0 end
    ret n
end

func _fence_run(t: str): int:
    mut n := 0
    until n < t.Len() and t[n] == '`':
        n++
    end
    if n < 3: ret 0 end
    ret n
end

func _trail(stack: Vector<str>, level: int): str:
    mut parts := Vector {} as Vector<str>
    mut i := 1
    until i < level and i < stack.Len():
        if stack.get(i).Len() > 0: parts.push(stack.get(i)) end
        i++
    end
    ret mcptxt.Join(parts, " > ")
end

func _index_file(rel: str):
    full := path.Join(mcpexec.Root(), rel)
    if not fs.Exists(full): ret end
    lines := mcptxt.Lines(fs.ReadText(full))
    g_texts.put(rel, lines)
    mut stack := Vector {} as Vector<str>
    repeat 6:
        stack.push("")
    end
    mut fence := 0
    first := g_sections.Len()
    mut i := 0
    until i < lines.Len():
        ln := lines.get(i)
        t := ln.trim()
        run := _fence_run(t)
        if fence == 0 and run > 0:
            fence = run
        else fence > 0 and run >= fence and t.Len() == run:
            fence = 0
        else fence == 0:
            lvl := _heading_level(ln)
            if lvl > 0:
                title := ln.substr(lvl + 1, ln.Len() - lvl - 1).trim()
                stack.set(lvl, title)
                mut k := lvl + 1
                until k < stack.Len():
                    stack.set(k, "")
                    k++
                end
                mut s := mcpdecl.Section {}
                s.title = title
                s.trail = _trail(stack, lvl)
                s.source = rel
                s.level = lvl
                s.start = i
                g_sections.push(s)
            end
        end
        i++
    end
    mut j := first
    until j < g_sections.Len():
        mut s := g_sections.get(j)
        s.own_end = lines.Len()
        s.tree_end = lines.Len()
        if j + 1 < g_sections.Len(): s.own_end = g_sections.get(j + 1).start end
        mut k := j + 1
        until k < g_sections.Len():
            if g_sections.get(k).level <= s.level:
                s.tree_end = g_sections.get(k).start
                break
            end
            k++
        end
        g_sections.set(j, s)
        j++
    end
end

func _ensure():
    if g_ready: ret end
    srcs := _sources()
    mut i := 0
    until i < srcs.Len():
        _index_file(srcs.get(i))
        i++
    end
    g_ready = true
end

func _lines_of(rel: str): Vector<str>:
    if g_texts.has(rel): ret g_texts.get(rel) end
    ret Vector {}
end

func _text(s: mcpdecl.Section, tree: bool, max_chars: int): str:
    lines := _lines_of(s.source)
    mut stop := s.own_end
    if tree: stop = s.tree_end end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := s.start
    mut cut := false
    until i < stop and i < lines.Len():
        ln := lines.get(i)
        if (str.BufLen(sb) as int) + ln.Len() > max_chars:
            cut = true
            break
        end
        str.BufAppend(sb, ln)
        str.BufAppend(sb, "\n")
        i++
    end
    if cut:
        str.BufAppend(sb, "\n[cut at ")
        str.BufAppend(sb, str.FromInt(max_chars))
        str.BufAppend(sb, " characters; ask salam_docs for one of the subsections below for the rest]\n")
    end
    out := str.BufStr(sb)
    ret out
end

func _plain(s: str): str:
    mut t := s.lower()
    t = str.Replace(t, "`", "")
    t = str.Replace(t, "*", "")
    t = str.Replace(t, "&", "and")
    ret t
end

func _bare_title(t: str): str:
    mut i := 0
    until i < t.Len() and (t[i] == '.' or t[i] == ' ' or (t[i] >= '0' and t[i] <= '9')):
        i++
    end
    ret _plain(t.substr(i, t.Len() - i).trim())
end

func _stopword(w: str): bool:
    stops := " the a an to of in on how do does i is are it with and or what which use using can my me write make get "
    ret stops.find(" ".concat(w).concat(" ")) >= 0
end

func _synonyms(w: str): str:
    switch w:
        "while", "loop", "loops": ret "until repeat each" end
        "for", "foreach", "iterate": ret "each repeat" end
        "lambda", "lambdas", "closure", "closures", "anonymous": ret "lambda closure" end
        "dict", "dictionary", "map", "maps", "object": ret "hashmap" end
        "list", "array", "arrays", "slice": ret "vector array" end
        "class", "classes", "record": ret "struct" end
        "trait", "traits", "protocol": ret "interface" end
        "exception", "exceptions", "throw", "throws", "try", "catch", "errors": ret "throws error result option" end
        "string", "strings", "text": ret "str string" end
        "return", "returns": ret "ret return" end
        "null", "nil", "none", "optional": ret "null option" end
        "elif", "elseif": ret "else" end
        "print", "printf", "output", "console": ret "println print" end
        "thread", "threads", "async", "goroutine", "concurrency": ret "spawn thread chan concurrency" end
        "import", "module", "modules", "package", "packages": ret "import include package" end
        "persian", "farsi": ret "persian" end
    end
    ret ""
end

func _terms(query: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    words := mcptxt.Split(str.Replace(_plain(query).trim(), "-", " "), " ")
    mut i := 0
    until i < words.Len():
        w := words.get(i).trim()
        if w.Len() > 1 and not _stopword(w):
            syn := _synonyms(w)
            if syn.Len() > 0:
                out.push(w.concat(" ").concat(syn))
            else:
                out.push(w)
            end
        end
        i++
    end
    ret out
end

func _alnum(c: char): bool:
    ret (c >= 'a' and c <= 'z') or (c >= '0' and c <= '9') or c == '_' or (c as int) >= 128
end

func _has_word(text: str, w: str): bool:
    whole := w.Len() <= 3
    mut from := 0
    until from < text.Len():
        rest := text.substr(from, text.Len() - from)
        at := rest.find(w)
        if at < 0: ret false end
        pos := from + at
        before_ok := pos == 0 or not _alnum(text[pos - 1])
        end_at := pos + w.Len()
        after_ok := not whole or end_at >= text.Len() or not _alnum(text[end_at])
        if before_ok and after_ok: ret true end
        from = pos + 1
    end
    ret false
end

func _group_hit(text: str, group: str): bool:
    alts := mcptxt.Split(group, " ")
    mut i := 0
    until i < alts.Len():
        if alts.get(i).Len() > 0 and _has_word(text, alts.get(i)): ret true end
        i++
    end
    ret false
end

func _section_score(s: mcpdecl.Section, q: str, terms: Vector<str>): int:
    title := _bare_title(s.title)
    mut score := 0
    if title == q: score += 5000 end
    if q.Len() > 2 and title.find(q) >= 0: score += 2000 end
    mut in_title := 0
    mut i := 0
    until i < terms.Len():
        if _group_hit(title, terms.get(i)): in_title++ end
        i++
    end
    if terms.Len() > 0 and in_title == terms.Len(): score += 1000 end
    score += in_title * 150
    lines := _lines_of(s.source)
    mut hits := 0
    mut seen := Vector {} as Vector<bool>
    repeat terms.Len():
        seen.push(false)
    end
    mut j := s.start + 1
    until j < s.own_end and j < lines.Len():
        ln := _plain(lines.get(j))
        mut m := 0
        mut k := 0
        until k < terms.Len():
            if _group_hit(ln, terms.get(k)):
                m++
                seen.set(k, true)
            end
            k++
        end
        hits += m * m
        j++
    end
    if hits > 60: hits = 60 end
    mut covered := 0
    mut c := 0
    until c < seen.Len():
        if seen.get(c) or _group_hit(title, terms.get(c)): covered++ end
        c++
    end
    if terms.Len() > 1 and covered < terms.Len(): hits /= 3 end
    score += hits * 12
    if score > 0 and s.source == "SKILL.md": score += 5 end
    ret score
end

func _children(s: mcpdecl.Section): Vector<str>:
    mut out := Vector {} as Vector<str>
    mut i := 0
    until i < g_sections.Len():
        c := g_sections.get(i)
        if c.source == s.source and c.start > s.start and c.start < s.tree_end and c.level == s.level + 1:
            out.push(c.title)
        end
        i++
    end
    ret out
end

func _where(s: mcpdecl.Section): str:
    mut w := s.source.concat(":").concat(str.FromInt(s.start + 1))
    if s.trail.Len() > 0: w = s.trail.concat(" (").concat(w).concat(")") end
    ret w
end

func _expect_code(lines: Vector<str>): str:
    mut i := 0
    until i < lines.Len() and i < 40:
        t := lines.get(i).trim()
        if str.StartsWith(t, "// EXPECT:"):
            ret t.substr(10, t.Len() - 10).trim()
        end
        i++
    end
    ret ""
end

func _ensure_codes():
    if g_codes_ready: ret end
    g_codes_ready = true
    root := path.Join(mcpexec.Root(), "tests/en/errors")
    if not dir.Exists(root): ret end
    names := mcptxt.Sorted(dir.List(root))
    mut i := 0
    until i < names.Len():
        n := names.get(i)
        if str.EndsWith(n, ".salam") and not str.StartsWith(n, "_"):
            rel := "tests/en/errors/".concat(n)
            code := _expect_code(mcptxt.Lines(fs.ReadText(path.Join(root, n))))
            if code.Len() == 4:
                mut list := Vector {} as Vector<str>
                if g_code_files.has(code): list = g_code_files.get(code) end
                list.push(rel)
                g_code_files.put(code, list)
            end
        end
        i++
    end
end

func _program_body(rel: str): str:
    lines := mcptxt.Lines(fs.ReadText(path.Join(mcpexec.Root(), rel)))
    mut keep := Vector {} as Vector<str>
    mut in_banner := false
    mut i := 0
    until i < lines.Len():
        t := lines.get(i).trim()
        if str.StartsWith(t, "/*") and keep.Len() == 0:
            in_banner = true
        end
        if not in_banner and not (keep.Len() == 0 and t.Len() == 0):
            keep.push(lines.get(i))
        end
        if in_banner and str.EndsWith(t, "*/"): in_banner = false end
        i++
    end
    ret mcptxt.Join(keep, "\n").trim()
end

@en "Topics"
@fa "سرفصل‌ها"
pub func Topics(): str:
    _ensure()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "Salam reference topics. Pass any title (or a few words from it) back to salam_docs as the query.\n")
    mut last := ""
    mut i := 0
    until i < g_sections.Len():
        s := g_sections.get(i)
        if s.source != last:
            str.BufAppend(sb, "\n## ")
            str.BufAppend(sb, s.source)
            str.BufAppend(sb, "\n")
            last = s.source
        end
        if s.level >= 2 and s.level <= 3:
            if s.level == 3: str.BufAppend(sb, "  ") end
            str.BufAppend(sb, "- ")
            str.BufAppend(sb, s.title)
            str.BufAppend(sb, "\n")
        end
        i++
    end
    out := str.BufStr(sb)
    ret out
end

@en "Lookup"
@fa "جستجوی راهنما"
pub func Lookup(query: str, max_chars: int): str:
    _ensure()
    if g_sections.Len() == 0:
        ret "The Salam reference (SKILL.md, docs/ai/AGENTS.md) is not available on this server; set SALAM_MCP_ROOT to a Salam checkout."
    end
    q := _plain(query).trim()
    terms := _terms(query)
    mut picked := Vector {} as Vector<int>
    mut keys := Vector {} as Vector<f64>
    mut i := 0
    until i < g_sections.Len():
        sc := _section_score(g_sections.get(i), q, terms)
        if sc > 0:
            picked.push(i)
            keys.push(sc as f64)
        end
        i++
    end
    if picked.Len() == 0:
        ret "Nothing in the Salam reference matched '".concat(query).concat("'. Try fewer or different words, salam_docs with no query for the topic list, salam_stdlib_search for library functions, or salam_find_examples for code.")
    end
    mut order := Vector {} as Vector<int>
    mut k := 0
    until k < picked.Len():
        order.push(k)
        k++
    end
    sort.SortIndexDesc(order, keys)
    best := g_sections.get(picked.get(order.get(0)))
    mut budget := max_chars
    if budget <= 0: budget = 16000 end
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "From ")
    str.BufAppend(sb, _where(best))
    str.BufAppend(sb, ":\n\n")
    str.BufAppend(sb, _text(best, true, budget))
    kids := _children(best)
    if kids.Len() > 0 and best.tree_end - best.start > 120:
        str.BufAppend(sb, "\nSubsections: ")
        str.BufAppend(sb, mcptxt.Join(kids, " | "))
        str.BufAppend(sb, "\n")
    end
    mut shown := 0
    mut j := 1
    until j < order.Len() and shown < 6:
        s := g_sections.get(picked.get(order.get(j)))
        if not (s.source == best.source and s.start > best.start and s.start < best.tree_end):
            if shown == 0: str.BufAppend(sb, "\nAlso relevant (query salam_docs with the title):\n") end
            str.BufAppend(sb, "- ")
            str.BufAppend(sb, s.title)
            str.BufAppend(sb, "  [")
            str.BufAppend(sb, _where(s))
            str.BufAppend(sb, "]\n")
            shown++
        end
        j++
    end
    out := str.BufStr(sb)
    ret out
end

@en "IsCode"
@fa "کد خطاست"
pub func IsCode(q: str): bool:
    t := q.trim().upper()
    if t.Len() != 4: ret false end
    if t[0] != 'E' and t[0] != 'W': ret false end
    mut i := 1
    until i < 4:
        if t[i] < '0' or t[i] > '9': ret false end
        i++
    end
    ret true
end

@en "ExampleFor"
@fa "نمونه برای کد"
pub func ExampleFor(code: str): str:
    _ensure_codes()
    c := code.trim().upper()
    if not g_code_files.has(c): ret "" end
    ret g_code_files.get(c).get(0)
end

@en "Explain"
@fa "توضیح کد"
pub func Explain(code: str): str:
    _ensure()
    _ensure_codes()
    c := code.trim().upper()
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "Salam diagnostic ")
    str.BufAppend(sb, c)
    str.BufAppend(sb, "\n")
    mut found := false
    mut i := 0
    until i < g_sections.Len():
        s := g_sections.get(i)
        lines := _lines_of(s.source)
        mut j := s.start + 1
        until j < s.own_end and j < lines.Len():
            if lines.get(j).find(c) >= 0:
                if not found: str.BufAppend(sb, "\nWhat the reference says:\n") end
                found = true
                str.BufAppend(sb, "- ")
                str.BufAppend(sb, lines.get(j).trim())
                str.BufAppend(sb, "  [")
                str.BufAppend(sb, _where(s))
                str.BufAppend(sb, "]\n")
            end
            j++
        end
        i++
    end
    if g_code_files.has(c):
        files := g_code_files.get(c)
        str.BufAppend(sb, "\nA minimal program the compiler rejects with ")
        str.BufAppend(sb, c)
        str.BufAppend(sb, " (")
        str.BufAppend(sb, files.get(0))
        str.BufAppend(sb, "):\n\n```salam\n")
        str.BufAppend(sb, mcptxt.Truncate(_program_body(files.get(0)), 3000))
        str.BufAppend(sb, "\n```\n")
        if files.Len() > 1:
            mut more := Vector {} as Vector<str>
            mut k := 1
            until k < files.Len() and k < 8:
                more.push(files.get(k))
                k++
            end
            str.BufAppend(sb, "\nMore programs that trigger it: ")
            str.BufAppend(sb, mcptxt.Join(more, ", "))
            str.BufAppend(sb, "\n")
        end
        found = true
    end
    if not found:
        str.BufAppend(sb, "\nNo notes or example program for this code in this checkout. The compiler's message and its help line are the best guide; salam_find_examples can search the corpus for working code.\n")
    end
    out := str.BufStr(sb)
    ret out
end
