@en "mcphint"
@fa "راهنمایی‌ام‌سی‌پی"
package mcphint

import str

func _starts(t: str, w: str): bool:
    ret str.StartsWith(t, w.concat(" ")) or t == w
end

func _has_ident(t: str, w: str): bool:
    mut from := 0
    until from < t.len():
        rest := t.substr(from, t.len() - from)
        at := rest.find(w)
        if at < 0: ret false end
        pos := from + at
        end_at := pos + w.len()
        before := pos == 0 or not _ident_char(t[pos - 1])
        after := end_at >= t.len() or not _ident_char(t[end_at])
        if before and after: ret true end
        from = pos + 1
    end
    ret false
end

func _ident_char(c: char): bool:
    ret (c >= 'a' and c <= 'z') or (c >= 'A' and c <= 'Z') or (c >= '0' and c <= '9') or c == '_' or c == '.'
end

func _loop_hint(t: str): str:
    if _starts(t, "for") and t.find(" in ") > 0:
        ret "Salam has no `for` loop. Iterate a collection with `each x in items:` (or `each i, x in items:` for index and value), count with `repeat n in i:` or `repeat 1 to 10 in i:`, and close the block with `end`."
    end
    if _starts(t, "for"):
        ret "Salam has no `for` loop. Count with `repeat n in i:` (i = 0..n-1) or `repeat a to b in i:`, iterate with `each x in items:`, or loop on a condition with `until cond:`."
    end
    if _starts(t, "while"):
        ret "`while` does not exist; `until cond:` is Salam's while loop and runs its body WHILE cond is true. Copy the condition as is (`while (i < n)` becomes `until i < n:`), never negate it."
    end
    if _starts(t, "loop") or t == "do:" or _starts(t, "do"):
        ret "An endless loop is `until true:` with a `break` inside."
    end
    ret ""
end

func _decl_hint(t: str): str:
    if _starts(t, "let") or _starts(t, "var") or _starts(t, "let mut"):
        ret "Bind with `x := value` (immutable) or `mut x := value` (reassignable). There is no `let`, `var` or typed local; cast with `as` when you need a type: `x := 0 as i64`."
    end
    if _starts(t, "def") or _starts(t, "fn") or _starts(t, "function") or _starts(t, "pub fn"):
        ret "Functions are declared `func name(a: int, b: str): RetType:` and closed with `end`; omit `: RetType` for no result. Use `pub func` to export."
    end
    if _starts(t, "class") or _starts(t, "pub class"):
        ret "Salam has no classes. Declare `struct Name:` with `pub field: Type = default` lines and methods as `func` inside the struct (they see `this`), then `end`."
    end
    if _starts(t, "return"):
        ret "Return with `ret value` (or a bare `ret` in a function without a result). In `main`, `ret N` sets the exit code."
    end
    if _starts(t, "elif"):
        ret "Else-if is spelled `else cond:` (also `else if cond:`). The whole chain ends with a single `end`."
    end
    if _starts(t, "try") or _starts(t, "catch") or _starts(t, "throw") or _starts(t, "except") or _starts(t, "raise"):
        ret "Declare a failing function `func f(): T throws:` and fail with `throw Error.New(ErrorKind.InvalidArgument, \"msg\")` (or `throw \"msg\"`). Mark each call `try f()` to pass the error on (only inside a `throws` function), or handle it with `try: ... catch e: ... end`; `try f() catch fallback` gives a default. Salam spells except as `catch`, raise as `throw`, and has no finally (use `defer`)."
    end
    if _starts(t, "case") or _starts(t, "default:"):
        ret "`switch` arms are bare labels with no `case`/`default`: `1, 2: ...`, `>= 10: ...`, `else: ...`, each closed by `end`. Use `match` for enums."
    end
    ret ""
end

func _expr_hint(t: str, msg: str): str:
    if t.find("func (") >= 0 and not _starts(t, "func") and not _starts(t, "pub"):
        ret "A lambda is written `(x: int): ret x * 2 end` (or a block lambda `(x: int): ... end`), with no `func` keyword and no return type. Its type is spelled `func (int) int` only where a parameter or field declares it."
    end
    if t.find("=>") >= 0:
        ret "Lambdas use `:` and `end`, not `=>`: `(x: int): ret x * 2 end`. `match` arms use `Pattern: value` too."
    end
    if t.find("lambda ") >= 0:
        ret "A lambda is written `(x: int): ret x * 2 end`; there is no `lambda` keyword."
    end
    if str.EndsWith(t, "{") or t == "}" or str.StartsWith(t, "} "):
        ret "Salam blocks open with `:` at the end of the header and close with `end`; braces are only for struct literals like `Point { x = 1, y = 2 }`."
    end
    if t.find(".length") >= 0 or t.find(".size()") >= 0 or t.find(".count()") >= 0:
        ret "Sizes are `.len()` on `str`, `Vector` and arrays (bytes for `str`; `.char_count()` counts characters). A `HashMap` has `.size()`."
    end
    if _has_ident(t, "self") and msg.find("self") >= 0:
        ret "Inside a struct method the receiver is `this`, not `self`."
    end
    if _has_ident(t, "True") or _has_ident(t, "False"):
        ret "Booleans are lowercase: `true` and `false`."
    end
    if _has_ident(t, "None") or _has_ident(t, "nil") or _has_ident(t, "nullptr") or _has_ident(t, "undefined"):
        ret "The null value is `null` (pointers, `dyn`, `void*`). For a value that may be missing, use `option.Option<T>` (`import option`: `option.Some(x)`, `option.None()`, `option.IsSome(o)`) or a `bool` out-flag."
    end
    if t.find("new ") >= 0 and msg.find("new") >= 0:
        ret "There is no `new`. Build a struct with a literal, `Point { x = 1, y = 2 }`, and an empty Vector with `Vector {} as Vector<int>`."
    end
    if (t.find("f\"") >= 0 or t.find("${") >= 0) and msg.find("unknown") >= 0:
        ret "There are no f-strings. Join with `.concat(...)` or `+`, use `fmt.Sprintf`, or a ``` text block with `${{ expr }}` holes."
    end
    if _starts(t, "import") and t.find("\"") > 0:
        ret "`import` takes a bare dotted std name (`import encoding.json`). Your own files come in with `include alias \"file.salam\"`."
    end
    if t.find("#include") >= 0 or _starts(t, "using") or _starts(t, "from"):
        ret "Imports are `import pkg` for std (dotted, unquoted) and `include alias \"file.salam\"` for your own files."
    end
    ret ""
end

func _type_hint(msg: str): str:
    if msg.find("unknown type 'string'") >= 0 or msg.find("unknown type 'String'") >= 0: ret "The string type is `str`." end
    if msg.find("unknown type 'boolean'") >= 0 or msg.find("unknown type 'Boolean'") >= 0: ret "The boolean type is `bool`." end
    if msg.find("unknown type 'int64'") >= 0 or msg.find("unknown type 'long'") >= 0: ret "64-bit integers are `i64` (`u64` unsigned); `int` is 32-bit." end
    if msg.find("unknown type 'float64'") >= 0 or msg.find("unknown type 'double'") >= 0: ret "Doubles are `f64`; `float` is `f32`." end
    if msg.find("unknown type 'List'") >= 0 or msg.find("unknown type 'list'") >= 0 or msg.find("unknown type 'Array'") >= 0: ret "A growable list is `Vector<T>`: `v := Vector {} as Vector<int>`, then `v.push(x)`, `v.get(i)`, `v.len()`." end
    if msg.find("unknown type 'Map'") >= 0 or msg.find("unknown type 'dict'") >= 0 or msg.find("unknown type 'Dict'") >= 0: ret "A map is `HashMap<K, V>`: `m := HashMap {} as HashMap<str, int>`, then `m.put(k, v)`, `m.get(k)`, `m.has(k)`." end
    ret ""
end

func _balance(s: str): int:
    mut d := 0
    mut in_str := false
    mut i := 0
    until i < s.len():
        c := s[i]
        if in_str:
            if c == '\\':
                i += 1
            else c == '"':
                in_str = false
            end
        else c == '"':
            in_str = true
        else c == '/' and i + 1 < s.len() and s[i + 1] == '/':
            ret d
        else c == '(' or c == '[' or c == '{':
            d += 1
        else c == ')' or c == ']' or c == '}':
            d -= 1
        end
        i += 1
    end
    if in_str: d += 1 end
    ret d
end

func _message_hint(msg: str, prev: str, col: int, ind: int): str:
    if msg.find("is a reserved word") >= 0 and col == ind + 1 and prev.trim().len() > 0 and _balance(prev) != 0:
        ret "The keyword here is fine: the line above is unfinished (an unclosed `(`, `[`, `{` or string), so the parser kept reading into this line. Close it on the previous line."
    end
    if msg.find("is a reserved word") >= 0 and col == ind + 1:
        ret "This keyword starts a statement, so the problem is probably just before it: check that the previous statement or block header is complete."
    end
    if msg.find("is a reserved word") >= 0:
        ret "Salam reserves more words than most languages, including `in`, `to`, `by`, `on`, `type`, `each`, `repeat`, `until`, `match`, `layout`, `component`, `impl`, `export`, `input`, `eq`, `neq`, `lt`, `gt`, `lte`, `gte`, `and`, `or`, `not`; `open` is a reserved built-in. Rename the variable; salam_keywords lists them all."
    end
    ret ""
end

func _lead(s: str): int:
    mut n := 0
    until n < s.len() and (s[n] == ' ' or s[n] == '\t'):
        n += 1
    end
    ret n
end

@en "Hint"
@fa "راهنمایی"
pub func Hint(line_text: str, message: str, prev_line: str, column: int): str:
    t := line_text.trim()
    mut h := _type_hint(message)
    if h.len() > 0: ret h end
    h = _loop_hint(t)
    if h.len() > 0: ret h end
    h = _decl_hint(t)
    if h.len() > 0: ret h end
    if message.find("is a reserved word") >= 0: ret _message_hint(message, prev_line, column, _lead(line_text)) end
    h = _expr_hint(t, message)
    if h.len() > 0: ret h end
    ret _message_hint(message, prev_line, column, _lead(line_text))
end
