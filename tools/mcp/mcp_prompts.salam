/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

@en "mcpprompt"
@fa "پیام‌ام‌سی‌پی"
package mcpprompt

import str
import encoding.value

include mcprpc "mcp_rpc.salam"
include mcpexec "mcp_exec.salam"

func _arg(list &: value.Value, name: str, desc: str, required: bool):
    mut a := value.NewValueObject()
    value.ObjectSet(a, "name", value.ValueString(name))
    value.ObjectSet(a, "description", value.ValueString(desc))
    value.ObjectSet(a, "required", value.ValueBool(required))
    value.ArrayPush(list, a)
end

func _prompt(list &: value.Value, name: str, title: str, desc: str, args: value.Value):
    mut p := value.NewValueObject()
    value.ObjectSet(p, "name", value.ValueString(name))
    value.ObjectSet(p, "title", value.ValueString(title))
    value.ObjectSet(p, "description", value.ValueString(desc))
    value.ObjectSet(p, "arguments", args)
    value.ArrayPush(list, p)
end

func _check_step(): str:
    if mcpexec.Hosted(): ret "pass the whole program as `source` to salam_check" end
    ret "save the file and run salam_check on it (or pass unsaved code as `source`)"
end

func _workflow(): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "Workflow:\n")
    str.BufAppend(sb, "1. For each construct you are unsure of, call salam_docs (e.g. 'loops', 'lambda', 'struct methods', 'error handling', 'generics').\n")
    str.BufAppend(sb, "2. For every std function or type you use, call salam_stdlib_search or salam_stdlib_symbols and copy the exact signature. Never invent stdlib names.\n")
    str.BufAppend(sb, "3. Use salam_find_examples to copy a real, compiling usage.\n")
    str.BufAppend(sb, "4. After every change, ")
    str.BufAppend(sb, _check_step())
    str.BufAppend(sb, ". Fix the FIRST error first; every diagnostic carries the source line, the compiler's help and often a hint. salam_docs with an error code (e.g. 'E085') explains it.\n")
    if not mcpexec.Hosted():
        str.BufAppend(sb, "5. Run it with salam_run (pass `stdin` if it reads input) and compare the output with what you expect.\n")
    end
    out := str.BufStr(sb)
    ret out
end

func _message(text: str): value.Value:
    mut c := value.NewValueObject()
    value.ObjectSet(c, "type", value.ValueString("text"))
    value.ObjectSet(c, "text", value.ValueString(text))
    mut m := value.NewValueObject()
    value.ObjectSet(m, "role", value.ValueString("user"))
    value.ObjectSet(m, "content", c)
    mut arr := value.NewValueArray()
    value.ArrayPush(arr, m)
    ret arr
end

func _write_text(args: value.Value): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "Write a complete Salam program for this task:\n\n")
    str.BufAppend(sb, mcprpc.ParamStr(args, "task", ""))
    str.BufAppend(sb, "\n\n")
    if mcprpc.ParamStr(args, "lang", "en") == "fa":
        str.BufAppend(sb, "Write it in Persian Salam (Persian keywords, `تابع ریشه:` as the entry, first line `// زبان: فارسی`). Get it compiling in English first if that is easier, then convert it with salam_translate and check the result. salam_docs 'persian' and salam_keywords give the spellings.\n\n")
    end
    str.BufAppend(sb, _workflow())
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, Crib())
    str.BufAppend(sb, "\nWhen it checks clean")
    if not mcpexec.Hosted(): str.BufAppend(sb, " and runs correctly") end
    str.BufAppend(sb, ", reply with the final program and a one-paragraph explanation.")
    out := str.BufStr(sb)
    ret out
end

func _port_text(args: value.Value): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    from_lang := mcprpc.ParamStr(args, "from", "")
    str.BufAppend(sb, "Port this ")
    if from_lang.len() > 0:
        str.BufAppend(sb, from_lang)
        str.BufAppend(sb, " ")
    end
    str.BufAppend(sb, "code to idiomatic Salam that keeps every behaviour:\n\n```\n")
    str.BufAppend(sb, mcprpc.ParamStr(args, "code", ""))
    str.BufAppend(sb, "\n```\n\nStart with salam_docs 'translating from other languages'")
    if from_lang.len() > 0:
        str.BufAppend(sb, " and salam_docs 'from ")
        str.BufAppend(sb, from_lang)
        str.BufAppend(sb, "'")
    end
    str.BufAppend(sb, ". Map each library call to a real std function with salam_stdlib_search. Copy loop conditions exactly: `while (c)` becomes `until c:`, never the negation.\n\n")
    str.BufAppend(sb, _workflow())
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, Crib())
    out := str.BufStr(sb)
    ret out
end

func _fix_text(args: value.Value): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "Fix this Salam program:\n\n```salam\n")
    str.BufAppend(sb, mcprpc.ParamStr(args, "code", ""))
    str.BufAppend(sb, "\n```\n\n")
    problem := mcprpc.ParamStr(args, "problem", "")
    if problem.len() > 0:
        str.BufAppend(sb, "Reported problem: ")
        str.BufAppend(sb, problem)
        str.BufAppend(sb, "\n\n")
    end
    str.BufAppend(sb, "Run salam_check on it first. Fix the first error, check again, and repeat; later errors are often knock-on effects of the first. For an error code, salam_docs with that code shows the rule and a minimal failing program. If it compiles but misbehaves, look first at `until` conditions (they mean while) and at values copied where a reference (`&:`) was needed.\n\n")
    str.BufAppend(sb, Crib())
    out := str.BufStr(sb)
    ret out
end

@en "Crib"
@fa "خلاصه"
pub func Crib(): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    str.BufAppend(sb, "Salam rules that differ from other languages (all verified against the compiler):\n")
    str.BufAppend(sb, "- Blocks are `header:` ... `end`; no braces, no semicolons. One-liners: `if x > 0: println x end`.\n")
    str.BufAppend(sb, "- Functions: `func add(a: int, b: int): int:` ... `ret a + b` ... `end`; no `: Type` means no result. `func main:` returns the exit code: `ret 0` (0 when omitted).\n")
    str.BufAppend(sb, "- Bindings: `x := 1` (immutable), `mut y := 0` (reassignable). No let/var, no `x: int = 1`; cast with `as`: `n := 0 as i64`.\n")
    str.BufAppend(sb, "- Loops: `until cond:` is WHILE (runs while cond is true). There is no `for` and no `while`: `each x in v:`, `each i, x in v:`, `repeat n in i:` (0..n-1), `repeat 1 to 10 in i:`.\n")
    str.BufAppend(sb, "- `switch` arms fall through like C: end each arm with `break` (or `ret`). `match` is an expression with no fallthrough; use it for enums.\n")
    str.BufAppend(sb, "- Else-if is `else cond:`. Lambdas: `(x: int): ret x * 2 end` (no `func`, no `=>`, no return type); their type is `func (int) int`.\n")
    str.BufAppend(sb, "- Printing: `println a, b` and `print x` take no parentheses. Strings are `str`: `s.len()`, `s.concat(t)`, `a + b`, `str.FromInt(n)`.\n")
    str.BufAppend(sb, "- Collections: `v := Vector {} as Vector<int>`, `v.push(x)`, `v.get(i)`, `v.len()`; `m := HashMap {} as HashMap<str, int>`, `m.put(k, v)`, `m.get(k)`, `m.has(k)`.\n")
    str.BufAppend(sb, "- Structs: `struct P:` with `pub x: int = 0` fields and `pub func` methods inside (receiver is `this`), closed by `end`; build with `P { x = 1 }`. Fields and methods need `pub` to be used outside the struct.\n")
    str.BufAppend(sb, "- Unused variables, imports, parameters and functions, and a `mut` that is never reassigned, are compile errors.\n")
    str.BufAppend(sb, "- File order is enforced: package, import, include, globals, types, private funcs, then pub funcs (no private func after the first pub func).\n")
    str.BufAppend(sb, "- `import encoding.json` uses the dotted std name and calls `json.Name(...)`; your own files: `include util \"util.salam\"`, then `util.Name(...)`.\n")
    str.BufAppend(sb, "- Reserved words cannot be names: in, to, by, on, type, each, repeat, until, match, switch, layout, component, impl, export, input, eq, neq, lt, gt, lte, gte, and, or, not, try, catch, throw, throws.\n")
    str.BufAppend(sb, "- Errors: declare `func f(): T throws:`, fail with `throw`, and mark each call `try f()` (only inside a `throws` function) or wrap it in `try: ... catch e: ... end`; the error is the prelude type `Error`.\n")
    out := str.BufStr(sb)
    ret out
end

@en "Instructions"
@fa "دستورها"
pub func Instructions(): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    if mcpexec.Hosted():
        str.BufAppend(sb, "Tools for the Salam programming language (hosted at mcp.salamlang.ir; pass programs as `source`, it cannot read your files or run code). ")
    else:
        str.BufAppend(sb, "Tools for the Salam programming language. ")
    end
    str.BufAppend(sb, "Salam's syntax differs from every mainstream language, so do not write it from memory of other languages.\n\n")
    str.BufAppend(sb, _workflow())
    str.BufAppend(sb, "\n")
    str.BufAppend(sb, Crib())
    str.BufAppend(sb, "\nThe full reference is the salam://guide/skill.md resource; salam_docs searches it.")
    out := str.BufStr(sb)
    ret out
end

@en "List"
@fa "فهرست"
pub func List(): value.Value:
    mut list := value.NewValueArray()
    mut w := value.NewValueArray()
    _arg(w, "task", "What the program should do.", true)
    _arg(w, "lang", "Source language of the keywords: en (default) or fa for Persian Salam.", false)
    _prompt(list, "salam-write", "Write a Salam program", "Write a new Salam program for a task, following the check-and-fix workflow.", w)
    mut p := value.NewValueArray()
    _arg(p, "code", "The code to port.", true)
    _arg(p, "from", "The language it is written in, e.g. Python, TypeScript, C, Go.", false)
    _prompt(list, "salam-port", "Port code to Salam", "Translate code from another language into idiomatic, compiling Salam.", p)
    mut f := value.NewValueArray()
    _arg(f, "code", "The Salam program that does not compile or misbehaves.", true)
    _arg(f, "problem", "The error message or the wrong behaviour, if known.", false)
    _prompt(list, "salam-fix", "Fix a Salam program", "Diagnose and fix a Salam program with salam_check and the language reference.", f)
    ret list
end

@en "Has"
@fa "دارد"
pub func Has(name: str): bool:
    ret name == "salam-write" or name == "salam-port" or name == "salam-fix"
end

@en "Get"
@fa "دریافت"
pub func Get(name: str, args: value.Value): value.Value:
    mut r := value.NewValueObject()
    mut text := ""
    mut desc := ""
    switch name:
        "salam-write":
            text = _write_text(args)
            desc = "Write a Salam program"
            break
        end
        "salam-port":
            text = _port_text(args)
            desc = "Port code to Salam"
            break
        end
        "salam-fix":
            text = _fix_text(args)
            desc = "Fix a Salam program"
        end
    end
    value.ObjectSet(r, "description", value.ValueString(desc))
    value.ObjectSet(r, "messages", _message(text))
    ret r
end

@en "MissingArg"
@fa "آرگومان ناموجود"
pub func MissingArg(name: str, args: value.Value): str:
    if name == "salam-write" and mcprpc.ParamStr(args, "task", "").trim().len() == 0: ret "task" end
    if (name == "salam-port" or name == "salam-fix") and mcprpc.ParamStr(args, "code", "").trim().len() == 0: ret "code" end
    ret ""
end
