@en "mcpreg"
@fa "فهرست‌ام‌سی‌پی"
package mcpreg

import str
import encoding.json
import encoding.value
import encoding.encerr

include mcprpc "mcp_rpc.salam"
include mcptool "mcp_tools.salam"
include mcpdoc "mcp_docs.salam"
include mcpout "mcp_result.salam"
include mcpexec "mcp_exec.salam"

mut g_tools := value.Value {}
mut g_tools_ready := false
mut g_tools_hosted := false

func _schema(raw: str): value.Value:
    mut e := encerr.EncodingError {}
    v := json.Decode(raw, e)
    if encerr.IsError(e): ret value.NewValueObject() end
    ret v
end

func _annotations(read_only: bool, open_world: bool): value.Value:
    mut a := value.NewValueObject()
    value.ObjectSet(a, "readOnlyHint", value.ValueBool(read_only))
    value.ObjectSet(a, "destructiveHint", value.ValueBool(false))
    value.ObjectSet(a, "idempotentHint", value.ValueBool(read_only))
    value.ObjectSet(a, "openWorldHint", value.ValueBool(open_world))
    ret a
end

func _tool_with(list &: value.Value, name: str, title: str, desc: str, schema: str, read_only: bool):
    mut t := value.NewValueObject()
    value.ObjectSet(t, "name", value.ValueString(name))
    value.ObjectSet(t, "title", value.ValueString(title))
    value.ObjectSet(t, "description", value.ValueString(desc))
    value.ObjectSet(t, "inputSchema", _schema(schema))
    mut ann := _annotations(read_only, not read_only)
    value.ObjectSet(ann, "title", value.ValueString(title))
    value.ObjectSet(t, "annotations", ann)
    value.ArrayPush(list, t)
end

func _tool(list &: value.Value, name: str, title: str, desc: str, schema: str):
    _tool_with(list, name, title, desc, schema, true)
end

func _program_props(): str:
    src := "\"source\":{\"type\":\"string\",\"description\":\"Full text of the Salam program (the entry file, compiled as main.salam). Use this for code you have not saved, or on the hosted server.\"},\"files\":{\"type\":\"object\",\"additionalProperties\":{\"type\":\"string\"},\"description\":\"Extra files of a multi-file program, as {relative name: text}, e.g. {\\\"util.salam\\\": \\\"...\\\"} for `include util \\\"util.salam\\\"`. Without source, the entry is main.salam if present.\"},\"entry\":{\"type\":\"string\",\"description\":\"Which of files is the entry program, when there is no source and no main.salam.\"}"
    if mcpexec.Hosted(): ret src end
    ret "\"path\":{\"type\":\"string\",\"description\":\"A .salam file or directory, relative to the workspace root or absolute inside it. Give either path or source.\"},".concat(src)
end

func _path_schema(extra: str): str:
    ret "{\"type\":\"object\",\"properties\":{".concat(_program_props()).concat(extra).concat("},\"additionalProperties\":false}")
end

func _no_args(): str:
    ret "{\"type\":\"object\",\"additionalProperties\":false}"
end

func _input_desc(): str:
    if mcpexec.Hosted(): ret "Pass the program as source (plus files for includes). " end
    ret "Pass a workspace path, or the program text as source. "
end

func _register_compiler(list &: value.Value):
    _tool(
        list, "salam_check", "Check Salam source",
        "The fast correctness loop: lexes, parses and type-checks a Salam program without codegen or linking. ".concat(_input_desc()).concat("Each diagnostic comes back with its code, line and column, the offending source line, the compiler's help, a hint when the code uses syntax from another language, and a pointer to a minimal failing example. Run it after every edit and fix the FIRST error first. It skips codegen and linking, so confirm with salam_build or salam_run before you finish."),
        _path_schema("")
    )
    if not mcpexec.Hosted():
        _tool(
            list, "salam_build", "Build Salam source",
            "Full compile to a native executable, including codegen and linking; the artifact goes to a temp path and is discarded. Use it when a check passes but you need to know the whole pipeline works, to test the c or llvm backend, or to cross-compile.",
            _path_schema(",\"backend\":{\"type\":\"string\",\"enum\":[\"llvm\",\"c\"],\"description\":\"Code generator. Defaults to the compiler's own default.\"},\"release\":{\"type\":\"boolean\",\"description\":\"Strip bounds and safety checks.\"},\"target\":{\"type\":\"string\",\"description\":\"Cross-compile target triple, e.g. x86_64-w64-windows-gnu.\"}")
        )
        _tool_with(
            list, "salam_run", "Build and run",
            "Compiles and executes a Salam program and returns its stdout, stderr and exit code, with compile errors reported like salam_check. stdin comes from the stdin argument (empty by default), and the run is killed after SALAM_MCP_RUN_TIMEOUT seconds (default 60). Use it to verify behaviour, not just compilation. The program runs with your permissions.",
            _path_schema(",\"stdin\":{\"type\":\"string\",\"description\":\"Text fed to the program's standard input.\"},\"backend\":{\"type\":\"string\",\"enum\":[\"llvm\",\"c\"],\"description\":\"Code generator. Defaults to the compiler's own default.\"}"),
            false
        )
        _tool_with(
            list, "salam_exec", "Interpret without a C toolchain",
            "Runs a program on the interpreter (bytecode VM), skipping the C toolchain; starts faster than salam_run. Same stdin and time limit as salam_run. Prefer salam_run for unsigned (u32/u64) arithmetic, bit manipulation and crypto.",
            _path_schema(",\"stdin\":{\"type\":\"string\",\"description\":\"Text fed to the program's standard input.\"}"),
            false
        )
    end
    _tool(
        list, "salam_format", "Format Salam source",
        "Returns the canonical formatting of one file as text (salam format applied to a private copy), or for a directory lists the files that need formatting. Never writes anything: replace the file with the returned text yourself.",
        _path_schema("")
    )
    _tool(
        list, "salam_translate", "Translate between English and Persian Salam",
        "Rewrites one Salam program between English and Persian keywords, type names, entry function and built-in method names, and returns the translated text without writing anything. Use it to read Persian code, or to produce a Persian version of working English code.",
        _path_schema(",\"to\":{\"type\":\"string\",\"enum\":[\"en\",\"fa\"],\"description\":\"Target language: en for English, fa for Persian.\"}")
    )
end

func _register_inspect(list &: value.Value):
    _tool(
        list, "salam_inspect", "Dump tokens, AST or symbols",
        "Dumps the compiler's own view of a program as XML: tokens, AST or the resolved symbol table. Use it to see how Salam actually parsed something, or to list what a file defines.",
        _path_schema(",\"emit\":{\"type\":\"string\",\"enum\":[\"tokens\",\"ast\",\"symbols\"],\"description\":\"Which stage to dump. Defaults to symbols.\"}")
    )
    _tool(
        list, "salam_llvm_ir", "Emit LLVM IR",
        "Emits textual LLVM IR for a program. Use it for codegen or optimisation questions, or to compare backends.",
        _path_schema(",\"target\":{\"type\":\"string\",\"description\":\"Optional cross-compile target triple.\"}")
    )
    _tool(
        list, "salam_js", "Compile to JavaScript",
        "Compiles a Salam program to browser-ready JavaScript and returns it. Use it for web or extension targets.",
        _path_schema("")
    )
    _tool(
        list, "salam_version", "Compiler version",
        "Reports the version, git commit and build date of the salam compiler this server drives.",
        _no_args()
    )
end

func _register_knowledge(list &: value.Value):
    _tool(
        list, "salam_docs", "Look up the Salam language reference",
        "Answers 'how do I write X in Salam' from the authoritative language reference (syntax, types, loops, lambdas, structs, generics, interfaces, error handling, concurrency, FFI, the layout DSL, Persian Salam, porting from other languages). Pass a topic or question such as 'lambda', 'loops', 'struct methods', 'error handling', 'http server', or an error code such as 'E085' to get the rules, a minimal failing program and the fix. With no query it lists every topic. Salam differs from other languages in ways you cannot guess (until is while, no for loop, ret, end-closed blocks, strict declaration order, unused names are errors), so read the relevant section BEFORE writing unfamiliar code.",
        "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Topic, question, section title or error code. Empty lists the topics.\"},\"max_chars\":{\"type\":\"integer\",\"description\":\"Longest answer to return (default 16000).\"}},\"additionalProperties\":false}"
    )
    _tool(
        list, "salam_stdlib_search", "Search the whole standard library",
        "Finds std functions, methods, types and constants by what they do or are called, across every package, best match first, with exact signatures, the package to import, file:line and the Persian name. Use it when you do not know which package has something: 'read file', 'sha256', 'http post', 'sort by', 'json', 'sleep', 'random'.",
        "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"One or more words; every word must match the name, package, signature or Persian name.\"},\"package\":{\"type\":\"string\",\"description\":\"Optional package to search inside, e.g. 'net.http'.\"},\"limit\":{\"type\":\"integer\",\"description\":\"Maximum results (default 25, at most 100).\"}},\"required\":[\"query\"],\"additionalProperties\":false}"
    )
    _tool(
        list, "salam_stdlib_packages", "List stdlib packages",
        "Lists every importable std package, nested ones under the dotted name an import line uses ('encoding.json', 'net.http'), with Persian names. Use it before writing imports.",
        _no_args()
    )
    _tool(
        list, "salam_stdlib_symbols", "Show a package's public API",
        "Shows one std package's real public API straight from its source: types with their fields, enum members and methods, functions and constants, each with its exact signature and file:line, plus the import line and call form. ALWAYS call it before using an unfamiliar std package; guessed stdlib names are the most common cause of invalid Salam. When you already know the name you want, pass it as 'query': you get that one signature instead of the whole package, and you will not need salam_read_source afterwards.",
        "{\"type\":\"object\",\"properties\":{\"package\":{\"type\":\"string\",\"description\":\"Package name as an import line spells it, e.g. 'str', 'encoding.json', 'os.shell', or its Persian name.\"},\"query\":{\"type\":\"string\",\"description\":\"Case-insensitive filter on names and signatures. Pass the function or type you are after, for example 'Unmarshal', to get just its signature instead of the whole package.\"}},\"required\":[\"package\"],\"additionalProperties\":false}"
    )
    _tool(
        list, "salam_find_examples", "Search working example code",
        "Searches known-good Salam (the test corpus, English tests first, then std) for lines containing a piece of code, and returns each hit with surrounding lines. Use it to copy a real, compiling usage of a function or construct before writing your own.",
        "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Case-insensitive code substring, e.g. 'json.Unmarshal', 'each ', 'match '.\"},\"limit\":{\"type\":\"integer\",\"description\":\"Maximum files to return (default 10, at most 50).\"},\"context\":{\"type\":\"integer\",\"description\":\"Lines of context around each hit (default 2, at most 12).\"},\"scope\":{\"type\":\"string\",\"enum\":[\"tests\",\"std\",\"all\"],\"description\":\"Where to search. Defaults to tests, falling back to std when nothing matches.\"}},\"required\":[\"query\"],\"additionalProperties\":false}"
    )
    _tool(
        list, "salam_read_source", "Read a Salam checkout file",
        "Reads a line-numbered slice of a file in the Salam checkout (std, tests, docs, compiler), for example the full body of a std function that salam_stdlib_symbols located. Reach for it only when a signature was not enough: a filtered salam_stdlib_symbols call answers most questions for a fraction of the reading.",
        "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Path relative to the checkout root, e.g. 'std/str/basic.salam'.\"},\"start\":{\"type\":\"integer\",\"description\":\"1-based first line (default 1).\"},\"count\":{\"type\":\"integer\",\"description\":\"How many lines (default 200).\"}},\"required\":[\"path\"],\"additionalProperties\":false}"
    )
    _tool(
        list, "salam_keywords", "English/Persian keyword table",
        "Returns every Salam keyword in English and Persian, parsed from the compiler's own language pack. None of them can be used as a name.",
        _no_args()
    )
end

func _string_map(v: value.Value, names &: Vector<str>, texts &: Vector<str>, problem &: str):
    if not value.IsObject(v): ret end
    keys := value.ObjectKeys(v)
    mut i := 0
    until i < keys.len():
        k := keys.get(i)
        item := value.ObjectGet(v, k)
        if not value.IsString(item):
            problem = "files[\"".concat(k).concat("\"] must be a string holding the file's text.")
            ret
        end
        names.push(k)
        texts.push(value.AsString(item))
        i += 1
    end
end

func _target(p: value.Value): mcptool.Target:
    path_arg := mcprpc.ParamStr(p, "path", "")
    source := mcprpc.ParamStr(p, "source", "")
    mut names := Vector {} as Vector<str>
    mut texts := Vector {} as Vector<str>
    mut problem := ""
    if value.IsObject(p) and value.ObjectHas(p, "files"):
        _string_map(value.ObjectGet(p, "files"), names, texts, problem)
    end
    if problem.len() > 0: ret mcptool.Target { problem = problem } end
    if mcpexec.Hosted():
        if path_arg.len() > 0 and source.len() == 0 and names.len() == 0:
            ret mcptool.Target { problem = "This hosted server cannot read files from your machine. Pass the program's text as source (and any included files in files) instead of path." }
        end
        ret mcptool.FromFiles(source, names, texts, mcprpc.ParamStr(p, "entry", ""))
    end
    if path_arg.len() > 0:
        if source.len() > 0 or names.len() > 0:
            ret mcptool.Target { problem = "Give either path or source/files, not both." }
        end
        ret mcptool.FromPath(path_arg)
    end
    ret mcptool.FromFiles(source, names, texts, mcprpc.ParamStr(p, "entry", ""))
end

func _on_target(name: str, t: mcptool.Target, p: value.Value): mcpout.ToolResult:
    switch name:
        "salam_check":
            ret mcptool.Check(t)
        end
        "salam_build":
            ret mcptool.Build(t, mcprpc.ParamStr(p, "backend", ""), mcprpc.ParamBool(p, "release", false), mcprpc.ParamStr(p, "target", ""))
        end
        "salam_run":
            ret mcptool.Run(t, mcprpc.ParamStr(p, "stdin", ""), mcprpc.ParamStr(p, "backend", ""))
        end
        "salam_exec":
            ret mcptool.Exec(t, mcprpc.ParamStr(p, "stdin", ""))
        end
        "salam_format":
            ret mcptool.Format(t)
        end
        "salam_translate":
            ret mcptool.Translate(t, mcprpc.ParamStr(p, "to", ""))
        end
        "salam_inspect":
            ret mcptool.Inspect(t, mcprpc.ParamStr(p, "emit", "symbols"))
        end
        "salam_llvm_ir":
            ret mcptool.LlvmIr(t, mcprpc.ParamStr(p, "target", ""))
        end
    end
    ret mcptool.Js(t)
end

func _takes_target(name: str): bool:
    switch name:
        "salam_check", "salam_build", "salam_run", "salam_exec", "salam_format", "salam_translate", "salam_inspect", "salam_llvm_ir", "salam_js":
            ret true
        end
    end
    ret false
end

func _call_compiler(name: str, p: value.Value, handled &: bool): mcpout.ToolResult:
    handled = true
    if name == "salam_version": ret mcptool.Version() end
    if not _takes_target(name):
        handled = false
        ret mcpout.Text("")
    end
    t := _target(p)
    r := _on_target(name, t, p)
    mcptool.Release(t)
    ret r
end

func _call_knowledge(name: str, p: value.Value, handled &: bool): mcpout.ToolResult:
    handled = true
    switch name:
        "salam_docs":
            ret mcpdoc.Docs(mcprpc.ParamStr(p, "query", ""), mcprpc.ParamInt(p, "max_chars", 16000))
        end
        "salam_stdlib_search":
            ret mcpdoc.Search(mcprpc.ParamStr(p, "query", ""), mcprpc.ParamStr(p, "package", ""), mcprpc.ParamInt(p, "limit", 25))
        end
        "salam_stdlib_packages":
            ret mcpdoc.Packages()
        end
        "salam_stdlib_symbols":
            ret mcpdoc.Symbols(mcprpc.ParamStr(p, "package", ""), mcprpc.ParamStr(p, "query", ""))
        end
        "salam_find_examples":
            ret mcpdoc.FindExamples(mcprpc.ParamStr(p, "query", ""), mcprpc.ParamInt(p, "limit", 10), mcprpc.ParamInt(p, "context", 2), mcprpc.ParamStr(p, "scope", ""))
        end
        "salam_read_source":
            ret mcpdoc.ReadSource(mcprpc.ParamStr(p, "path", ""), mcprpc.ParamInt(p, "start", 1), mcprpc.ParamInt(p, "count", 200))
        end
        "salam_keywords":
            ret mcpdoc.Keywords()
        end
    end
    handled = false
    ret mcpout.Text("")
end

@en "Tools"
@fa "ابزارها"
pub func Tools(): value.Value:
    if g_tools_ready and g_tools_hosted == mcpexec.Hosted(): ret g_tools end
    mut list := value.NewValueArray()
    _register_compiler(list)
    _register_inspect(list)
    _register_knowledge(list)
    g_tools = list
    g_tools_hosted = mcpexec.Hosted()
    g_tools_ready = true
    ret list
end

@en "Has"
@fa "دارد"
pub func Has(name: str): bool:
    all := Tools()
    mut i := 0
    until i < value.ArrayLen(all):
        t := value.ArrayGet(all, i)
        if value.AsString(value.ObjectGet(t, "name")) == name: ret true end
        i += 1
    end
    ret false
end

@en "Call"
@fa "فراخوان"
pub func Call(name: str, params: value.Value): mcpout.ToolResult:
    p := mcprpc.ParamObject(params, "arguments")
    mut handled := false
    r := _call_compiler(name, p, handled)
    if handled: ret r end
    k := _call_knowledge(name, p, handled)
    if handled: ret k end
    ret mcpout.Failure("unrouted tool: ".concat(name))
end
