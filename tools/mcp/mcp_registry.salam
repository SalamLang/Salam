// mcp_registry.salam - the tool catalog and the tools/call router.
//
// Input schemas are written as JSON text and decoded once at startup rather
// than assembled Value-by-Value. A JSON Schema is JSON; writing it as JSON
// keeps each tool definition readable at a glance and impossible to get
// structurally wrong.
//
// Descriptions say when to reach for a tool, not just what it does - that is
// what actually drives correct tool selection.

@en "mcpreg"
@fa "فهرست‌ام‌سی‌پی"
@ar "سجل‌ام‌سی‌بی"
package mcpreg

import str
import encoding.json
import encoding.value
import encoding.encerr
import mcprpc "mcp_rpc.salam"
import mcptool "mcp_tools.salam"
import mcpdoc "mcp_docs.salam"
import mcpout "mcp_result.salam"

// ---- private helpers -------------------------------------------------

func _schema(raw: str): value.Value:
    mut e := encerr.EncodingError {}
    v := json.Decode(raw, e)
    if encerr.IsError(e): ret value.NewValueObject() end
    ret v
end

func _tool(list &: value.Value, name: str, title: str, desc: str, schema: str):
    mut t := value.NewValueObject()
    value.ObjectSet(t, "name", value.ValueString(name))
    value.ObjectSet(t, "title", value.ValueString(title))
    value.ObjectSet(t, "description", value.ValueString(desc))
    value.ObjectSet(t, "inputSchema", _schema(schema))
    value.ArrayPush(list, t)
end

func _path_schema(extra: str): str:
    base := "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Workspace-relative path to a .salam file or directory.\"}"
    ret base.concat(extra).concat("},\"required\":[\"path\"],\"additionalProperties\":false}")
end

func _no_args(): str:
    ret "{\"type\":\"object\",\"additionalProperties\":false}"
end

func _register_compiler(list &: value.Value):
    _tool(
        list, "salam_check", "Check Salam source", "Fastest correctness check: lexes, parses and type-checks a .salam file without codegen or linking, and returns exact diagnostics (code, message, line, column). Call this after every edit to Salam source, before trying to build or run. It does not run the C backend, so a small class of errors (notably a bare 'ret' in main) passes here and still fails salam_build - if a check passes but a build fails, that is why.", _path_schema("")
    )
    _tool(
        list, "salam_build", "Build Salam source", "Full compile to a native executable, including codegen and linking. Use when a check passes but you need to confirm the whole pipeline works, or to test a specific backend or cross-compile target. The artifact is written to a temp path and discarded.", _path_schema(",\"backend\":{\"type\":\"string\",\"enum\":[\"llvm\",\"c\"],\"description\":\"Code generator. Defaults to the compiler's own default.\"},\"release\":{\"type\":\"boolean\",\"description\":\"Strip bounds and safety checks.\"},\"target\":{\"type\":\"string\",\"description\":\"Cross-compile target triple, e.g. x86_64-w64-windows-gnu.\"}")
    )
    _tool(
        list, "salam_run", "Build and run", "Compiles and executes a Salam program, returning its stdout, stderr and exit code. Use to verify behaviour, not just compilation.", _path_schema("")
    )
    _tool(
        list, "salam_exec", "Interpret without a C toolchain", "Runs a program through the tree-walking interpreter, skipping the C toolchain entirely. Faster to start than salam_run. Do NOT trust it for unsigned (u32/u64) arithmetic, bit manipulation or crypto - the interpreter is known to miscompute those; use salam_run for that code.", _path_schema("")
    )
    _tool(
        list, "salam_format", "Check formatting", "Reports whether a file or directory matches Salam's canonical formatting. Read-only: it never rewrites the user's files.", _path_schema("")
    )
end

func _register_inspect(list &: value.Value):
    _tool(
        list, "salam_inspect", "Dump tokens, AST or symbols", "Dumps the compiler's own view of a file as XML. Use when you need to understand how Salam actually parsed something, or to enumerate the symbols a file defines.", _path_schema(",\"emit\":{\"type\":\"string\",\"enum\":[\"tokens\",\"ast\",\"symbols\"],\"description\":\"Which stage to dump. Defaults to symbols.\"}")
    )
    _tool(
        list, "salam_llvm_ir", "Emit LLVM IR", "Emits textual LLVM IR for a file. Use for codegen or optimisation questions, or to compare backends.", _path_schema(",\"target\":{\"type\":\"string\",\"description\":\"Optional cross-compile target triple.\"}")
    )
    _tool(
        list, "salam_js", "Compile to JavaScript", "Compiles a Salam program to browser-ready JavaScript. Use for web or extension targets.", _path_schema("")
    )
    _tool(
        list, "salam_version", "Compiler version", "Reports the version, git commit and build date of the salam compiler this server drives. Call once when you need to know what you are targeting.", _no_args()
    )
end

func _register_knowledge(list &: value.Value):
    _tool(
        list, "salam_stdlib_packages", "List stdlib packages", "Lists every importable std package in this checkout, nested ones under the dotted name an import line uses - 'encoding.json', 'net.http'. Call this before writing imports so you use packages that actually exist.", _no_args()
    )
    _tool(
        list, "salam_stdlib_symbols", "List a package's public API", "Lists the public declarations (func, struct, enum, const, type) of one std package, straight from its source. ALWAYS call this before using an unfamiliar std package - guessing stdlib function names is the most common cause of invalid Salam.", "{\"type\":\"object\",\"properties\":{\"package\":{\"type\":\"string\",\"description\":\"Package name as an import line spells it, e.g. 'str', 'encoding.json', 'os.shell'.\"},\"query\":{\"type\":\"string\",\"description\":\"Optional case-insensitive filter on the declaration line.\"}},\"required\":[\"package\"],\"additionalProperties\":false}"
    )
    _tool(
        list, "salam_find_examples", "Search working example code", "Searches the shipped test corpus - the largest body of known-good Salam in the repo - for lines matching a query. Use to find a real, compiling usage of a feature before writing your own.", "{\"type\":\"object\",\"properties\":{\"query\":{\"type\":\"string\",\"description\":\"Case-insensitive substring, e.g. 'HashMap' or 'defer'.\"},\"limit\":{\"type\":\"integer\",\"description\":\"Maximum files to return (default 20).\"}},\"required\":[\"query\"],\"additionalProperties\":false}"
    )
    _tool(
        list, "salam_read_source", "Read a workspace file", "Reads a line-numbered slice of a file in the Salam checkout, for looking at real stdlib or test source.", "{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"Workspace-relative path.\"},\"start\":{\"type\":\"integer\",\"description\":\"1-based first line (default 1).\"},\"count\":{\"type\":\"integer\",\"description\":\"How many lines (default 200).\"}},\"required\":[\"path\"],\"additionalProperties\":false}"
    )
    _tool(
        list, "salam_keywords", "English/Persian/Arabic keyword table", "Returns Salam's keyword table in all three source languages, parsed from the compiler's own language pack. Use when reading or writing Salam written in Persian or Arabic.", _no_args()
    )
end

func _call_compiler(name: str, p: value.Value, handled &: bool): mcpout.ToolResult:
    handled = true
    path := mcprpc.ParamStr(p, "path", "")
    if name == "salam_check": ret mcptool.Check(path) end
    if name == "salam_build":
        ret mcptool.Build(path, mcprpc.ParamStr(p, "backend", ""), mcprpc.ParamBool(p, "release", false), mcprpc.ParamStr(p, "target", ""))
    end
    if name == "salam_run": ret mcptool.Run(path) end
    if name == "salam_exec": ret mcptool.Exec(path) end
    if name == "salam_format": ret mcptool.Format(path) end
    if name == "salam_inspect": ret mcptool.Inspect(path, mcprpc.ParamStr(p, "emit", "symbols")) end
    if name == "salam_llvm_ir": ret mcptool.LlvmIr(path, mcprpc.ParamStr(p, "target", "")) end
    if name == "salam_js": ret mcptool.Js(path) end
    if name == "salam_version": ret mcptool.Version() end
    handled = false
    ret mcpout.Text("")
end

func _call_knowledge(name: str, p: value.Value, handled &: bool): mcpout.ToolResult:
    handled = true
    if name == "salam_stdlib_packages": ret mcpdoc.Packages() end
    if name == "salam_stdlib_symbols":
        ret mcpdoc.Symbols(mcprpc.ParamStr(p, "package", ""), mcprpc.ParamStr(p, "query", ""))
    end
    if name == "salam_find_examples":
        ret mcpdoc.FindExamples(mcprpc.ParamStr(p, "query", ""), mcprpc.ParamInt(p, "limit", 20))
    end
    if name == "salam_read_source":
        ret mcpdoc.ReadSource(mcprpc.ParamStr(p, "path", ""), mcprpc.ParamInt(p, "start", 1), mcprpc.ParamInt(p, "count", 200))
    end
    if name == "salam_keywords": ret mcpdoc.Keywords() end
    handled = false
    ret mcpout.Text("")
end

// ---- public API ------------------------------------------------------

@en "Tools"
@fa "ابزارها"
@ar "الأدوات"
// The full catalog, in a stable order so clients can cache tools/list.
pub func Tools(): value.Value:
    mut list := value.NewValueArray()
    _register_compiler(list)
    _register_inspect(list)
    _register_knowledge(list)
    ret list
end

@en "Has"
@fa "دارد"
@ar "یملك"
pub func Has(name: str): bool:
    all := Tools()
    mut i := 0
    until i < value.ArrayLen(all):
        t := value.ArrayGet(all, i)
        if value.AsString(value.ObjectGet(t, "name")) == name: ret true end
        i += 1
    end
    ret false
end

@en "Call"
@fa "فراخوانی"
@ar "استدعاء"
// Routes one tools/call. Callers must check Has() first; an unknown name is
// a JSON-RPC protocol error, not a tool result.
pub func Call(name: str, params: value.Value): mcpout.ToolResult:
    p := mcprpc.ParamObject(params, "arguments")
    mut handled := false
    r := _call_compiler(name, p, handled)
    if handled: ret r end
    k := _call_knowledge(name, p, handled)
    if handled: ret k end
    ret mcpout.Failure("unrouted tool: ".concat(name))
end
