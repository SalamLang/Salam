@en "mcpsrc"
@fa "منابع‌ام‌سی‌پی"
package mcpsrc

import str
import fs.dir
import fs.file
import fs.path
import encoding.json
import encoding.value

include mcptxt "mcp_text.salam"
include mcpexec "mcp_exec.salam"
include mcpdoc "mcp_docs.salam"
include mcpguide "mcp_guide.salam"

func _guide_path(): str:
    ret path.Join(mcpexec.Root(), "docs/ai/AGENTS.md")
end

func _skill_path(): str:
    ret path.Join(mcpexec.Root(), "SKILL.md")
end

func _uri_text(s: str): str:
    mut t := str.Replace(s, "+", " ")
    t = str.Replace(t, "%20", " ")
    t = str.Replace(t, "%2F", "/")
    t = str.Replace(t, "%2f", "/")
    ret t
end

func _template(list &: value.Value, uri: str, name: str, title: str, desc: str, mime: str):
    mut r := value.NewValueObject()
    value.ObjectSet(r, "uriTemplate", value.ValueString(uri))
    value.ObjectSet(r, "name", value.ValueString(name))
    value.ObjectSet(r, "title", value.ValueString(title))
    value.ObjectSet(r, "description", value.ValueString(desc))
    value.ObjectSet(r, "mimeType", value.ValueString(mime))
    value.ArrayPush(list, r)
end

func _llms_path(): str:
    ret path.Join(mcpexec.Root(), "docs/ai/llms.txt")
end

func _std_root(): str:
    ret mcpexec.StdRoot()
end

func _entry(list &: value.Value, uri: str, name: str, title: str, desc: str, mime: str):
    mut r := value.NewValueObject()
    value.ObjectSet(r, "uri", value.ValueString(uri))
    value.ObjectSet(r, "name", value.ValueString(name))
    value.ObjectSet(r, "title", value.ValueString(title))
    value.ObjectSet(r, "description", value.ValueString(desc))
    value.ObjectSet(r, "mimeType", value.ValueString(mime))
    value.ArrayPush(list, r)
end

func _decl_line(line: str): bool:
    t := line.trim()
    if str.StartsWith(t, "pub func "): ret true end
    if str.StartsWith(t, "pub inline func "): ret true end
    if str.StartsWith(t, "pub pure func "): ret true end
    if str.StartsWith(t, "pub inline pure func "): ret true end
    if str.StartsWith(t, "pub struct "): ret true end
    if str.StartsWith(t, "pub enum "): ret true end
    if str.StartsWith(t, "pub const "): ret true end
    ret false
end

func _decls_of(pkg_dir: str): value.Value:
    mut arr := value.NewValueArray()
    if not dir.Exists(pkg_dir): ret arr end
    entries := dir.List(pkg_dir)
    mut found := Vector {} as Vector<str>
    mut i := 0
    until i < entries.len():
        e := entries.get(i)
        if str.EndsWith(e, ".salam"): _collect(found, path.Join(pkg_dir, e)) end
        i += 1
    end
    sorted := mcptxt.Sorted(found)
    mut j := 0
    until j < sorted.len():
        value.ArrayPush(arr, value.ValueString(sorted.get(j)))
        j += 1
    end
    ret arr
end

func _collect(out &: Vector<str>, f: str):
    lines := mcptxt.Lines(file.ReadText(f))
    mut i := 0
    until i < lines.len():
        ln := lines.get(i)
        if _decl_line(ln): out.push(ln.trim()) end
        i += 1
    end
end

func _walk_pkgs(pkgs &: value.Value, dir_path: str, prefix: str):
    names := dir.ListDirs(dir_path)
    mut i := 0
    until i < names.len():
        n := names.get(i)
        sub := path.Join(dir_path, n)
        if file.Exists(path.Join(sub, n.concat(".salam"))):
            mut full := n
            if prefix.len() > 0: full = prefix.concat(".").concat(n) end
            value.ObjectSet(pkgs, full, _decls_of(sub))
            _walk_pkgs(pkgs, sub, full)
        end
        i += 1
    end
end

func _index(): str:
    root := _std_root()
    mut out := value.NewValueObject()
    value.ObjectSet(out, "root", value.ValueString("std"))
    mut pkgs := value.NewValueObject()
    if dir.Exists(root): _walk_pkgs(pkgs, root, "") end
    value.ObjectSet(out, "packages", pkgs)
    ret json.Encode(out, json.JSONOptions { indent = "  ", sort_keys = true })
end

func _text_content(uri: str, mime: str, body: str): value.Value:
    mut c := value.NewValueObject()
    value.ObjectSet(c, "uri", value.ValueString(uri))
    value.ObjectSet(c, "mimeType", value.ValueString(mime))
    value.ObjectSet(c, "text", value.ValueString(body))
    mut wrap := value.NewValueArray()
    value.ArrayPush(wrap, c)
    ret wrap
end

@en "List"
@fa "فهرست"
pub func List(): value.Value:
    mut list := value.NewValueArray()
    _entry(
        list, "salam://guide/skill.md", "salam-reference", "Salam language reference",
        "The complete, authoritative reference: syntax, types, generics, the std catalog, compiler rules, porting from other languages, FFI, concurrency, the layout DSL and Persian Salam. salam_docs searches it section by section.",
        "text/markdown"
    )
    _entry(
        list, "salam://guide/agents.md", "salam-language-guide",
        "Salam language guide for AI agents",
        "How to write Salam correctly: syntax, declaration ordering rules, and the compiler pitfalls that most often produce invalid code. Attach this before writing Salam.",
        "text/markdown"
    )
    _entry(
        list, "salam://stdlib/index.json", "salam-stdlib-index",
        "Machine-readable standard library index",
        "Every std package mapped to its public declarations, generated from this checkout at read time.",
        "application/json"
    )
    _entry(
        list, "salam://guide/llms.txt", "salam-llms-txt", "llms.txt entry point",
        "Short orientation file pointing at the rest of Salam's machine-readable documentation.",
        "text/plain"
    )
    ret list
end

@en "Templates"
@fa "الگوها"
pub func Templates(): value.Value:
    mut list := value.NewValueArray()
    _template(list, "salam://stdlib/{package}", "salam-stdlib-package", "One std package's public API", "Types with fields and methods, functions and constants of one std package, e.g. salam://stdlib/encoding.json.", "text/plain")
    _template(list, "salam://docs/{topic}", "salam-docs-topic", "A section of the Salam reference", "The reference section that best answers a topic or error code, e.g. salam://docs/lambda or salam://docs/E085.", "text/markdown")
    ret list
end

@en "Read"
@fa "بخوان"
pub func Read(uri: str): value.Value:
    if str.StartsWith(uri, "salam://stdlib/") and uri != "salam://stdlib/index.json":
        pkg := _uri_text(uri.substr(15, uri.len() - 15))
        r := mcpdoc.Symbols(pkg, "")
        if r.is_error: ret value.NewValueArray() end
        ret _text_content(uri, "text/plain", r.text)
    end
    if str.StartsWith(uri, "salam://docs/"):
        q := _uri_text(uri.substr(13, uri.len() - 13))
        if mcpguide.IsCode(q): ret _text_content(uri, "text/markdown", mcpguide.Explain(q)) end
        ret _text_content(uri, "text/markdown", mcpguide.Lookup(q, 30000))
    end
    switch uri:
        "salam://guide/skill.md":
            ret _text_content(uri, "text/markdown", file.ReadText(_skill_path()))
        end
        "salam://stdlib/index.json":
            ret _text_content(uri, "application/json", _index())
        end
        "salam://guide/agents.md":
            ret _text_content(uri, "text/markdown", file.ReadText(_guide_path()))
        end
        "salam://guide/llms.txt":
            ret _text_content(uri, "text/plain", file.ReadText(_llms_path()))
        end
    end
    ret value.NewValueArray()
end
