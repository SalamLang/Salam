// mcp_result.salam - the shape every tool handler returns.
//
// MCP splits tool failures in two: a malformed or unknown call is a JSON-RPC
// protocol error, while a call that ran and failed (a compile error, a
// missing file) is a normal result carrying isError: true. Only the second
// kind is useful to a model, because it can read it and retry - so every
// handler in this server returns a ToolResult, and the protocol layer above
// reserves JSON-RPC errors for genuinely malformed requests.
//
// Handlers that have machine-readable output attach it as structuredContent
// as well as text; the spec asks servers to send both so clients that do not
// understand the schema still see something useful.

@en "mcpout"
@fa "خروجی‌ام‌سی‌پی"
@ar "مخرجات‌ام‌سی‌بی"
package mcpout

import str
import encoding.value

// ---- types -----------------------------------------------------------

@en "ToolResult"
pub struct ToolResult:
    pub text: str = ""
    pub is_error: bool = false
    pub has_structured: bool = false
    pub structured: value.Value = value.Value {}
end

// ---- public API ------------------------------------------------------

@en "Text"
@fa "متن"
@ar "نص"
pub func Text(body: str): ToolResult:
    ret ToolResult { text = body, is_error = false }
end

@en "Failure"
@fa "شکست"
@ar "فشل"
pub func Failure(body: str): ToolResult:
    ret ToolResult { text = body, is_error = true }
end

@en "Rich"
@fa "غنی"
@ar "غني"
pub func Rich(body: str, data: value.Value, failed: bool): ToolResult:
    mut r := ToolResult { text = body, is_error = failed }
    r.has_structured = true
    r.structured = data
    ret r
end

@en "Section"
@fa "بخش"
@ar "قسم"
// Renders a labelled block, skipping it entirely when the body is empty so a
// clean build does not spend context on three empty headings.
pub func Section(label: str, body: str): str:
    trimmed := body.trim()
    if trimmed.len() == 0: ret "" end
    ret "## ".concat(label).concat("\n").concat(trimmed).concat("\n")
end

@en "StrArray"
@fa "آرایه رشته"
@ar "مصفوفة نصیة"
pub func StrArray(items: Vector<str>): value.Value:
    mut arr := value.NewValueArray()
    mut i := 0
    until i < items.len():
        value.ArrayPush(arr, value.ValueString(items.get(i)[0]))
        i += 1
    end
    ret arr
end

@en "Bullets"
@fa "فهرست"
@ar "قائمة"
pub func Bullets(items: Vector<str>): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < items.len():
        str.BufAppend(sb, "- ")
        str.BufAppend(sb, items.get(i)[0])
        str.BufAppend(sb, "\n")
        i += 1
    end
    out := str.BufStr(sb)
    ret out
end
