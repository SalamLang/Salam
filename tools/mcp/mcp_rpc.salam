// mcp_rpc.salam - JSON-RPC 2.0 framing for the MCP stdio transport.
//
// Transport rules this file enforces (MCP 2026-07-28, basic/transports/stdio):
//   - one JSON-RPC message per line on stdout, never containing a raw newline
//   - nothing but MCP messages on stdout; all logging goes to stderr
//   - exit promptly when stdin reaches EOF
//
// The newline rule is why every outbound message goes through json.Encode
// with the default (non-indenting) JSONOptions: it escapes \n, \r and \t
// inside strings, so a multi-line compiler diagnostic still serialises to a
// single line. Verified against control characters, quotes, backslashes and
// UTF-8 before this server was written.
//
// Reading stdin cannot use the builtin input() / io.Input(): it returns ""
// both for a blank line and at end-of-stream, so a server built on it spins
// forever once the client closes the pipe. ReadLine below drives getchar()
// directly so EOF is distinguishable.

@en "mcprpc"
@fa "فراخوان‌ام‌سی‌پی"
@ar "استدعاء‌ام‌سی‌بی"
package mcprpc

import io
import str
import encoding.json
import encoding.value
import encoding.encerr

extern:
    func getchar(): int
end

// ---- protocol constants ---------------------------------------------
//
// Names are prefixed because a `pub const` shares one link-level namespace
// across packages in this compiler; unprefixed names like `PROTO` collide.

@en "McpProtoModern"
pub const McpProtoModern := "2026-07-28"

@en "McpMetaProto"
pub const McpMetaProto := "io.modelcontextprotocol/protocolVersion"

@en "McpMetaServerInfo"
pub const McpMetaServerInfo := "io.modelcontextprotocol/serverInfo"

@en "McpErrParse"
pub const McpErrParse := 0 - 32700

@en "McpErrInvalidRequest"
pub const McpErrInvalidRequest := 0 - 32600

@en "McpErrMethodNotFound"
pub const McpErrMethodNotFound := 0 - 32601

@en "McpErrInvalidParams"
pub const McpErrInvalidParams := 0 - 32602

@en "McpErrInternal"
pub const McpErrInternal := 0 - 32603

@en "McpErrUnsupportedVersion"
pub const McpErrUnsupportedVersion := 0 - 32022

// ---- types -----------------------------------------------------------

@en "Line"
pub struct Line:
    pub text: str = ""
    pub eof: bool = false
end

@en "Request"
pub struct Request:
    pub ok: bool = false
    pub bad_json: bool = false
    pub has_id: bool = false
    // The id is kept as raw JSON text so it can be echoed back byte-for-byte
    // whether the client sent a number, a string, or nothing at all.
    pub id_json: str = "null"
    pub method: str = ""
    pub proto: str = ""
    pub has_proto: bool = false
    pub params: value.Value = value.Value {}
end

// ---- private helpers -------------------------------------------------

func _compact(v: value.Value): str:
    ret json.Encode(v, json.JSONOptions {})
end

func _meta_proto(params: value.Value): str:
    if !value.IsObject(params): ret "" end
    if !value.ObjectHas(params, "_meta"): ret "" end
    meta := value.ObjectGet(params, "_meta")
    if !value.IsObject(meta): ret "" end
    if !value.ObjectHas(meta, McpMetaProto): ret "" end
    pv := value.ObjectGet(meta, McpMetaProto)
    if !value.IsString(pv): ret "" end
    ret value.AsString(pv)
end

func _envelope(id_json: str, key: str, body: str): str:
    parts := Vector {} as Vector<str>
    defer parts.free()
    parts.push(json.Member("jsonrpc", "2.0"))
    parts.push(json.MemberRaw("id", id_json))
    parts.push(json.MemberRaw(key, body))
    ret json.Object(parts)
end

// ---- public API ------------------------------------------------------

@en "Log"
@fa "گزارش"
@ar "سجل"
// Diagnostics go to stderr only. The spec lets clients ignore stderr and
// forbids anything but MCP messages on stdout.
pub func Log(msg: str):
    io.EPrintln("[salam-mcp] ".concat(msg))
end

@en "ReadLine"
@fa "خط بخوان"
@ar "اقرأ سطرا"
// Reads one newline-delimited line, reporting end-of-stream distinctly from
// an empty line so the caller can shut down instead of spinning.
pub func ReadLine(): Line:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut any := false
    mut c := getchar()
    until c != -1 && c != 10:
        str.BufAppendChar(sb, c)
        any = true
        c = getchar()
    end
    if c == -1 && !any:
        ret Line { text = "", eof = true }
    end
    out := str.BufStr(sb)
    ret Line { text = out, eof = false }
end

@en "WriteMessage"
@fa "پیام بنویس"
@ar "اکتب رسالة"
// Emits one already-serialised JSON-RPC message plus its delimiter.
pub func WriteMessage(msg: str):
    println msg
end

@en "Parse"
@fa "تجزیه"
@ar "حلل"
// Decodes one wire line into a Request. A line that is not a JSON object is
// reported via bad_json so the caller can answer with a parse error.
pub func Parse(line: str): Request:
    mut req := Request {}
    mut err := encerr.EncodingError {}
    root := json.Decode(line, err)
    if encerr.IsError(err) || !value.IsObject(root):
        req.bad_json = true
        ret req
    end
    if value.ObjectHas(root, "id"):
        idv := value.ObjectGet(root, "id")
        if !value.IsNull(idv):
            req.has_id = true
            req.id_json = _compact(idv)
        end
    end
    if value.ObjectHas(root, "method"):
        mv := value.ObjectGet(root, "method")
        if value.IsString(mv): req.method = value.AsString(mv) end
    end
    if value.ObjectHas(root, "params"):
        req.params = value.ObjectGet(root, "params")
    end
    req.proto = _meta_proto(req.params)
    req.has_proto = req.proto.len() > 0
    req.ok = req.method.len() > 0
    ret req
end

@en "ResultMessage"
@fa "پیام نتیجه"
@ar "رسالة نتیجة"
pub func ResultMessage(id_json: str, result: value.Value): str:
    ret _envelope(id_json, "result", _compact(result))
end

@en "ErrorMessage"
@fa "پیام خطا"
@ar "رسالة خطأ"
pub func ErrorMessage(id_json: str, code: int, message: str): str:
    body := Vector {} as Vector<str>
    defer body.free()
    body.push(json.MemberInt("code", code))
    body.push(json.Member("message", message))
    ret _envelope(id_json, "error", json.Object(body))
end

@en "ErrorMessageData"
@fa "پیام خطا با داده"
@ar "رسالة خطأ مع بیانات"
pub func ErrorMessageData(id_json: str, code: int, message: str, data: value.Value): str:
    body := Vector {} as Vector<str>
    defer body.free()
    body.push(json.MemberInt("code", code))
    body.push(json.Member("message", message))
    body.push(json.MemberRaw("data", _compact(data)))
    ret _envelope(id_json, "error", json.Object(body))
end

@en "ParamStr"
@fa "پارامتر رشته"
@ar "معامل نصي"
pub func ParamStr(params: value.Value, key: str, fallback: str): str:
    if !value.IsObject(params): ret fallback end
    if !value.ObjectHas(params, key): ret fallback end
    v := value.ObjectGet(params, key)
    if !value.IsString(v): ret fallback end
    ret value.AsString(v)
end

@en "ParamBool"
@fa "پارامتر بولی"
@ar "معامل منطقي"
pub func ParamBool(params: value.Value, key: str, fallback: bool): bool:
    if !value.IsObject(params): ret fallback end
    if !value.ObjectHas(params, key): ret fallback end
    v := value.ObjectGet(params, key)
    if !value.IsBool(v): ret fallback end
    ret value.AsBool(v)
end

@en "ParamInt"
@fa "پارامتر عددی"
@ar "معامل عددي"
pub func ParamInt(params: value.Value, key: str, fallback: int): int:
    if !value.IsObject(params): ret fallback end
    if !value.ObjectHas(params, key): ret fallback end
    v := value.ObjectGet(params, key)
    if !value.IsNumber(v): ret fallback end
    ret value.AsInt(v) as int
end

@en "ParamObject"
@fa "پارامتر شیء"
@ar "معامل کائن"
pub func ParamObject(params: value.Value, key: str): value.Value:
    if !value.IsObject(params): ret value.NewValueObject() end
    if !value.ObjectHas(params, key): ret value.NewValueObject() end
    v := value.ObjectGet(params, key)
    if !value.IsObject(v): ret value.NewValueObject() end
    ret v
end
