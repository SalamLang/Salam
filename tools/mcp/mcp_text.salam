@en "mcptxt"
@fa "متن‌ام‌سی‌پی"
@ar "نص‌ام‌سی‌بی"
package mcptxt

import str

func _clamp_low(v: int, lo: int): int:
    if v < lo: ret lo end
    ret v
end

@en "Split"
@fa "جدا کن"
@ar "قسم"
pub func Split(s: str, delim: str): Vector<str>:
    out := Vector {} as Vector<str>
    dn := delim.len()
    if dn == 0:
        out.push(s)
        ret out
    end
    mut rest := s
    mut cut := rest.find(delim)
    until cut >= 0:
        out.push(rest.substr(0, cut))
        rest = rest.substr(cut + dn, rest.len() - cut - dn)
        cut = rest.find(delim)
    end
    out.push(rest)
    ret out
end

@en "Lines"
@fa "خط‌ها"
@ar "أسطر"
pub func Lines(s: str): Vector<str>:
    raw := Split(s, "\n")
    out := Vector {} as Vector<str>
    mut i := 0
    until i < raw.len():
        ln := raw.get(i)
        out.push(str.TrimSuffix(ln, "\r"))
        i += 1
    end
    ret out
end

@en "Join"
@fa "بپیوند"
@ar "ادمج"
pub func Join(parts: Vector<str>, sep: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < parts.len():
        if i > 0: str.BufAppend(sb, sep) end
        str.BufAppend(sb, parts.get(i))
        i += 1
    end
    out := str.BufStr(sb)
    ret out
end

@en "Truncate"
@fa "کوتاه کن"
@ar "اقتطع"
pub func Truncate(s: str, max: int): str:
    lim := _clamp_low(max, 64)
    if s.len() <= lim: ret s end
    head := s.substr(0, lim)
    ret head.concat("\n... [truncated, ").concat(str.FromInt(s.len() - lim)).concat(" more bytes]")
end

@en "HeadLines"
@fa "سرخط‌ها"
@ar "أوائل الأسطر"
pub func HeadLines(s: str, max: int): str:
    all := Lines(s)
    n := all.len()
    if n <= max: ret s end
    kept := Vector {} as Vector<str>
    mut i := 0
    until i < max:
        kept.push(all.get(i))
        i += 1
    end
    kept.push("... [".concat(str.FromInt(n - max)).concat(" more lines]"))
    ret Join(kept, "\n")
end

@en "Sorted"
@fa "مرتب"
@ar "مرتب"
pub func Sorted(items: Vector<str>): Vector<str>:
    out := Vector {} as Vector<str>
    mut k := 0
    until k < items.len():
        out.push(items.get(k))
        k += 1
    end
    n := out.len()
    mut i := 1
    until i < n:
        mut j := i
        until j > 0:
            a := out.get(j - 1)
            b := out.get(j)
            if a <= b: break end
            out.set(j - 1, b)
            out.set(j, a)
            j -= 1
        end
        i += 1
    end
    ret out
end

@en "ContainsFold"
@fa "شامل بدون حساسیت"
@ar "یحتوي دون حساسیة"
pub func ContainsFold(hay: str, needle: str): bool:
    if needle.len() == 0: ret true end
    ret hay.lower().find(needle.lower()) >= 0
end
