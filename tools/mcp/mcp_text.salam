@en "mcptxt"
@fa "متن‌ام‌سی‌پی"
package mcptxt

import mem
import str
import sort

func _clamp_low(v: int, lo: int): int:
    if v < lo: ret lo end
    ret v
end

@en "Split"
@fa "جدا کن"
pub func Split(s: str, delim: str): Vector<str>:
    out := Vector {} as Vector<str>
    dn := delim.len()
    if dn == 0:
        out.push(str.Clone(s))
        ret out
    end
    mut start := 0
    mut cut := str.IndexFrom(s, delim, 0)
    until cut >= 0:
        out.push(s.substr(start, cut - start))
        start = cut + dn
        cut = str.IndexFrom(s, delim, start)
    end
    out.push(s.substr(start, s.len() - start))
    ret out
end

@en "Lines"
@fa "خط‌ها"
pub func Lines(s: str): Vector<str>:
    mut raw := Split(s, "\n")
    out := Vector {} as Vector<str>
    mut i := 0
    until i < raw.len():
        ln := raw.get(i)
        out.push(str.TrimSuffix(ln, "\r"))
        mem.Free(ln as void*)
        i += 1
    end
    raw.free()
    ret out
end

@en "FreeLines"
@fa "آزادسازی خط‌ها"
pub func FreeLines(lines &: Vector<str>):
    each ln in lines:
        mem.Free(ln as void*)
    end
    lines.free()
end

@en "Join"
@fa "بپیوند"
pub func Join(parts: Vector<str>, sep: str): str:
    mut sb := str.NewBuilder()
    defer str.BufFree(sb)
    mut i := 0
    until i < parts.len():
        if i > 0: str.BufAppend(sb, sep) end
        str.BufAppend(sb, parts.get(i))
        i += 1
    end
    out := str.BufStr(sb)
    ret out
end

@en "Truncate"
@fa "کوتاه کن"
pub func Truncate(s: str, max: int): str:
    lim := _clamp_low(max, 64)
    if s.len() <= lim: ret s end
    head := s.substr(0, lim)
    ret head.concat("\n... [truncated, ").concat(str.FromInt(s.len() - lim)).concat(" more bytes]")
end

@en "HeadLines"
@fa "سرخط‌ها"
pub func HeadLines(s: str, max: int): str:
    all := Lines(s)
    n := all.len()
    if n <= max: ret s end
    kept := Vector {} as Vector<str>
    mut i := 0
    until i < max:
        kept.push(all.get(i))
        i += 1
    end
    kept.push("... [".concat(str.FromInt(n - max)).concat(" more lines]"))
    ret Join(kept, "\n")
end

@en "Sorted"
@fa "مرتب"
pub func Sorted(items: Vector<str>): Vector<str>:
    ret sort.Sorted(items)
end

@en "ContainsFold"
@fa "شامل بدون حساسیت"
pub func ContainsFold(hay: str, needle: str): bool:
    if needle.len() == 0: ret true end
    ret hay.lower().find(needle.lower()) >= 0
end
