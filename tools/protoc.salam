// protoc.salam - CLI driver for encoding.protobuf's single-file .proto -> Salam
// code generator. Usage:
//
//   salam build tools/protoc.salam -o protoc.exe
//   ./protoc.exe path/to/message.proto output_pb.salam
//
// Both the input and output paths are required (no smart-default derivation
// of the output path from the input path): the return value of os.Args() has
// a broken generic-type registration in this compiler build - assigning any
// of its indexed/dereferenced string elements to a local via `:=` (directly
// or through a helper function) reliably corrupts the semantic analyzer,
// anywhere from bogus "unknown identifier" cascades up to an outright
// segfault the moment that value later reaches a `str` package pure func
// (confirmed via ~20 isolated repros). The only reliable pattern is to pass
// an argv-derived string DIRECTLY inline as a call argument, never bind it
// to a variable first - which is exactly what this file does throughout.
// This does not touch the salam compiler/CLI itself - it is a separate,
// ordinary Salam program built on top of encoding.protobuf.GenerateSingle.

package main

import os
import io
import fs.file
import encoding.protobuf

func main:
    argv := os.Args()
    if argv.len() < 3:
        io.EPrintln("usage: protoc <input.proto> <output.salam>")
        os.Exit(2)
    end

    mut ok := false
    generated := protobuf.GenerateSingle(file.ReadText(argv.get(1)[0]), ok)
    if !ok:
        io.EPrintln("protoc: failed to generate code from input file")
        os.Exit(1)
    end

    written := file.WriteText(argv.get(2)[0], generated)
    if written <= 0:
        io.EPrintln("protoc: failed to write output file")
        os.Exit(1)
    end

    println "protoc: wrote output file"
end
