package main

import os
import io
import fs
import encoding.protobuf

func main:
    argv := os.Args()
    if argv.Len() < 3:
        io.EPrintln("usage: protoc <input.proto> <output.salam>")
        ret 2
    end

    mut generated := ""
    try:
        generated = protobuf.GenerateSingle(fs.ReadText(argv.Get(1)))
    catch e:
        io.EPrintln("protoc: " + argv.Get(1) + ": " + e.ToStr())
        ret 1
    end

    written := fs.WriteText(argv.Get(2), generated)
    if written <= 0:
        io.EPrintln("protoc: failed to write output file")
        ret 1
    end

    println "protoc: wrote output file"
end
