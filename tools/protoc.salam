package main

import os
import io
import fs.file
import encoding.protobuf

func main:
    argv := os.Args()
    if argv.len() < 3:
        io.EPrintln("usage: protoc <input.proto> <output.salam>")
        os.Exit(2)
    end

    mut ok := false
    generated := protobuf.GenerateSingle(file.ReadText(argv.get(1)), ok)
    if !ok:
        io.EPrintln("protoc: failed to generate code from input file")
        os.Exit(1)
    end

    written := file.WriteText(argv.get(2), generated)
    if written <= 0:
        io.EPrintln("protoc: failed to write output file")
        os.Exit(1)
    end

    println "protoc: wrote output file"
end
