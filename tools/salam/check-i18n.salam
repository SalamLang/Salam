import str
include i18 "../../compiler/i18n.salam"

func main:
    problem := i18.CheckTranslations()
    if str.Len(problem) > 0:
        printerrln "check-i18n: " + problem
        ret 1
    end
    println "check-i18n: message tables are consistent"
    ret 0
end
