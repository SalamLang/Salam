import str
import fs
import fs.dir
include i18 "../../compiler/i18n.salam"

const SOURCES := "compiler"

const SQL_PARSER := "std/db/sql/sql_parse.salam"

func walk(path: str, out &: Vector<str>):
    each d in dir.ListDirs(path):
        if d != "tests_port":
            walk(path + "/" + d, out)
        end
    end
    each f in dir.ListFiles(path):
        if str.EndsWith(f, ".salam"):
            out.Push(path + "/" + f)
        end
    end
end

func unescape(raw: str): str:
    mut out := ""
    mut i := 0
    until i < raw.Len():
        c := raw.Substr(i, 1)
        if c == "\\" and i + 1 < raw.Len():
            e := raw.Substr(i + 1, 1)
            if e == "n":
                out += "\n"
            else e == "t":
                out += "\t"
            else:
                out += e
            end
            i += 2
            continue
        end
        out += c
        i++
    end
    ret out
end

func skip_blank(text: str, at: int): int:
    mut i := at
    until i < text.Len() and (text.Substr(i, 1) == " " or text.Substr(i, 1) == "\n"):
        i++
    end
    ret i
end

func one_literal(text: str, at: int, msg &: str): int:
    i := skip_blank(text, at)
    if i >= text.Len():
        ret 0 - 1
    end
    q := text.Substr(i, 1)
    if q == "`":
        e := str.IndexFrom(text, "`", i + 1)
        if e < 0:
            ret 0 - 1
        end
        msg = text.Substr(i + 1, e - i - 1)
        ret e + 1
    end
    if q != `"`:
        ret 0 - 1
    end
    mut j := i + 1
    until j < text.Len() and text.Substr(j, 1) != `"`:
        if text.Substr(j, 1) == "\\":
            j++
        end
        j++
    end
    msg = unescape(text.Substr(i + 1, j - i - 1))
    ret j + 1
end

func literal_at(text: str, at: int, msg &: str): bool:
    mut part := ""
    mut next := one_literal(text, at, part)
    if next < 0:
        ret false
    end
    msg = part
    mut plus := skip_blank(text, next)
    until plus < text.Len() and text.Substr(plus, 1) == "+":
        next = one_literal(text, plus + 1, part)
        if next < 0:
            ret false
        end
        msg += part
        plus = skip_blank(text, next)
    end
    ret true
end

func skip_args(text: str, at: int, n: int): int:
    mut i := at
    mut depth := 0
    mut left := n
    until left > 0 and i < text.Len():
        c := text.Substr(i, 1)
        if c == "(" or c == "[":
            depth++
        else c == ")" or c == "]":
            if depth == 0:
                ret 0 - 1
            end
            depth--
        else c == `"`:
            j := str.IndexFrom(text, `"`, i + 1)
            if j < 0:
                ret 0 - 1
            end
            i = j
        else c == "," and depth == 0:
            left--
        end
        i++
    end
    ret i
end

func line_of(text: str, at: int): int:
    mut n := 1
    repeat at in i:
        if text.Substr(i, 1) == "\n":
            n++
        end
    end
    ret n
end

func scan(path: str, text: str, call: str, skip: int, missing &: Vector<str>):
    mut at := str.IndexFrom(text, call, 0)
    until at >= 0:
        start := skip_args(text, at + call.Len(), skip)
        mut msg := ""
        if start >= 0 and literal_at(text, start, msg) and not i18.HasMessage(msg):
            missing.Push(path + ":" + line_of(text, at) + ": '" + msg + "' has no Persian text in compiler/i18n.salam")
        end
        at = str.IndexFrom(text, call, at + call.Len())
    end
end

func table_strings(text: str, name: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    head := str.IndexOf(text, name + " := [")
    if head < 0:
        ret out
    end
    stop := str.IndexFrom(text, "]", head)
    mut at := str.IndexFrom(text, `"`, head)
    until at >= 0 and at < stop:
        mut item := ""
        next := one_literal(text, at, item)
        if next < 0:
            break
        end
        out.Push(item)
        at = str.IndexFrom(text, `"`, next)
    end
    ret out
end

func has_text(list: Vector<str>, want: str): bool:
    each item in list:
        if item == want:
            ret true
        end
    end
    ret false
end

func scan_ctx(path: str, text: str, call: str, known: Vector<str>, missing &: Vector<str>):
    mut at := str.IndexFrom(text, call, 0)
    until at >= 0:
        start := skip_args(text, at + call.Len(), 1)
        mut ctx := ""
        if start >= 0 and literal_at(text, start, ctx) and not has_text(known, ctx):
            missing.Push(path + ":" + line_of(text, at) + ": '" + ctx + "' has no Persian text in k_ctx_fa")
        end
        at = str.IndexFrom(text, call, at + call.Len())
    end
end

func check_sql_contexts(missing &: Vector<str>):
    text := fs.ReadText(SQL_PARSER)
    en := table_strings(text, "k_ctx_en")
    fa := table_strings(text, "k_ctx_fa")
    if en.Len() == 0 or en.Len() != fa.Len():
        missing.Push(SQL_PARSER + ": k_ctx_en has " + en.Len() + " entries but k_ctx_fa has " + fa.Len())
    end
    scan_ctx(SQL_PARSER, text, "p_expect_sym(p,", en, missing)
    scan_ctx(SQL_PARSER, text, "p_expect_kw(p,", en, missing)
    scan_ctx(SQL_PARSER, text, "expected_msg(", en, missing)
end

func main:
    problem := i18.CheckTranslations()
    if str.Len(problem) > 0:
        printerrln "check-i18n: " + problem
        ret 1
    end
    mut files := Vector {} as Vector<str>
    walk(SOURCES, files)
    mut missing := Vector {} as Vector<str>
    each path in files:
        text := fs.ReadText(path)
        scan(path, text, "i18.Tr(", 0, missing)
        scan(path, text, "i18n.Tr(", 0, missing)
        scan(path, text, "p_error(p,", 0, missing)
        scan(path, text, "p_error_at(p,", 1, missing)
        scan(path, text, "p_expect(p,", 1, missing)
        scan(path, text, "p_close_angle(p,", 0, missing)
        scan(path, text, "p_foreign_error(p,", 0, missing)
        scan(path, text, "p_foreign_error(p,", 1, missing)
        scan(path, text, "error_at(L,", 1, missing)
    end
    check_sql_contexts(missing)
    each m in missing:
        printerrln "check-i18n: " + m
    end
    if missing.Len() > 0:
        ret 1
    end
    println "check-i18n: message tables are consistent and cover every literal message"
    ret 0
end
