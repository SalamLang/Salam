/*
 * Compile every code snippet marked class="snip" in the lessons.
 *
 * The reference tables of the web lessons carry hundreds of short examples.
 * Each one sits in an element with class "snip" (<code class="snip"> in a table
 * cell, <pre class="code snip"> for a block). A snippet is an element
 * expression: it is wrapped in a page: block (and gets an import for dom when
 * it calls dom) and built with `salam page build`. A snippet that already
 * starts a page: block is built as it is.
 *
 *     salam run tools/salam/check-snippets.salam [lesson.txt ...]
 *
 * Environment: SALAM (compiler to use, default "salam"), SALAM_STD (standard
 * library, default "std"), CHECK_JOBS (parallel builds, default: CPU count).
 */

import encoding.html
import env
import fs
import os
import os.process
import os.temp
import pool
import regex
import str
import sync

const SNIP_CODE := `<code[^>]*\sclass="([^"]*\s)?snip(\s[^"]*)?"[^>]*>([\s\S]*?)</code>`
const SNIP_PRE := `<pre[^>]*\sclass="([^"]*\s)?snip(\s[^"]*)?"[^>]*>([\s\S]*?)</pre>`
const TAGS := `<[^>]+>`
const BODY_OPEN := "lesson.body <<"
const BODY_CLOSE := ">>"
const SHOWN := 20

mut failed := Vector {} as Vector<str>

struct Snippet:
    pub path: str = ""
    pub lang: str = ""
    pub src: str = ""
end

struct Found:
    pub start: int = 0
    pub inner: str = ""
end

struct Run:
    pub code: int = 0
    pub out: str = ""
end

// ---------------------------------------------------------------- text helpers

func sorted_names(names: Vector<str>): Vector<str>:
    mut out := Vector {} as Vector<str>
    each name in names:
        mut at := 0
        until at < out.len():
            if out.get(at) > name:
                break
            end
            at++
        end
        out.insert(at, name)
    end
    ret out
end

func trim_newlines(text: str): str:
    mut out := text
    until out.len() == 0:
        if out.substr(0, 1) != "\n":
            break
        end
        out = out.substr(1, out.len() - 1)
    end
    until out.len() == 0:
        if out.substr(out.len() - 1, 1) != "\n":
            break
        end
        out = out.substr(0, out.len() - 1)
    end
    ret out
end

func quote_shell(text: str): str:
    ret "'" + str.Replace(text, "'", `'\''`) + "'"
end

// ---------------------------------------------------------------- lesson parsing

func body_lines(path: str): Vector<str>:
    lines := str.Split(fs.ReadText(path), "\n")
    mut start := -1
    mut i := 0
    until i < lines.len():
        if lines.get(i).trim() == BODY_OPEN:
            start = i
            break
        end
        i++
    end
    out := Vector {} as Vector<str>
    if start < 0:
        ret out
    end
    mut j := start + 1
    until j < lines.len():
        if lines.get(j).trim() == BODY_CLOSE:
            ret out
        end
        out.push(lines.get(j))
        j++
    end
    empty := Vector {} as Vector<str>
    ret empty
end

func found_in(pattern: str, text: str): Vector<Found> throws:
    out := Vector {} as Vector<Found>
    re := try regex.Compile(pattern)
    each m in regex.FindAllMatches(re, text, 1000000):
        out.push(Found { start = m.start, inner = regex.Group(m, 3) })
    end
    ret out
end

func snippets(path: str): Vector<str> throws:
    out := Vector {} as Vector<str>
    body := body_lines(path)
    if body.len() == 0:
        ret out
    end
    text := str.Join(body, "\n")
    spans := try found_in(SNIP_CODE, text)
    blocks := try found_in(SNIP_PRE, text)
    mut at_code := 0
    mut at_pre := 0
    until at_code < spans.len() or at_pre < blocks.len():
        mut inner := ""
        if at_pre >= blocks.len() or (at_code < spans.len() and spans.get(at_code).start < blocks.get(at_pre).start):
            inner = spans.get(at_code).inner
            at_code++
        else:
            inner = blocks.get(at_pre).inner
            at_pre++
        end
        plain := try regex.ReplaceAllStr(TAGS, inner, "")
        out.push(trim_newlines(html.Unescape(plain)))
    end
    ret out
end

func has_page_block(src: str): bool:
    each line in str.Split(src, "\n"):
        text := line.trim()
        if text == "page:" or text == "صفحه:":
            ret true
        end
    end
    ret false
end

func lasts_dom_import(src: str): bool:
    each line in str.Split(src, "\n"):
        text := line.trim()
        if text == "import dom" or text == "import دام":
            ret true
        end
        if text == "واردسازی دام":
            ret true
        end
    end
    ret false
end

func uses_dom(src: str): bool:
    ret src.includes("dom.") or src.includes("دام.")
end

func wrap(src: str, lang: str): str:
    mut page := "page:"
    mut finish := "end"
    mut import_line := "import dom"
    if lang == "fa":
        page = "صفحه:"
        finish = "پایان"
        import_line = "واردسازی دام"
    end
    mut prefix := ""
    if uses_dom(src) and lasts_dom_import(src) == false:
        prefix = import_line + "\n\n"
    end
    if has_page_block(src):
        ret prefix + src + "\n"
    end
    indented := Vector {} as Vector<str>
    each line in str.Split(src, "\n"):
        if line.trim() == "":
            indented.push(line)
        else:
            indented.push("    " + line)
        end
    end
    ret prefix + page + "\n" + str.Join(indented, "\n") + "\n" + finish + "\n"
end

// ---------------------------------------------------------------- building

func build(salam: str, dir: str): Run:
    args := Vector {} as Vector<str>
    args.push("-c")
    args.push(
        "cd " + quote_shell(dir) + " && " + quote_shell(salam)
            + " page build snip.salam --inline --no-color --log-level=warn"
    )
    mut child := process.StartCaptured("/bin/sh", args)
    code := process.Wait(child)
    out := (process.ReadStdout(child) + process.ReadStderr(child)).trim()
    process.Cleanup(child)
    ret Run { code = code, out = out }
end

func head(text: str, limit: int): str:
    if str.CharCount(text) <= limit:
        ret text
    end
    ret str.CharSubstr(text, 0, limit)
end

func problem(snippet: Snippet, salam: str): Run:
    dir := temp.Directory()
    defer temp.RemoveDir(dir)
    fs.WriteText(dir + "/snip.salam", wrap(snippet.src, snippet.lang))
    run := build(salam, dir)
    mut noise := str.Replace(run.out.lower(), "0 error", "")
    noise = str.Replace(noise, "0 warning", "")
    mut bad := run.code != 0 or fs.Exists(dir + "/snip.html") == false
    if noise.includes("error") or noise.includes("warning"):
        bad = true
    end
    if bad:
        ret Run { code = 1, out = head(run.out, 300) }
    end
    ret Run {}
end

// ---------------------------------------------------------------- entry point

func lesson_files(): Vector<str>:
    dirs := Vector {} as Vector<str>
    dirs.push("website/content/en/learn")
    dirs.push("website/content/fa/learn")
    out := Vector {} as Vector<str>
    each dir in dirs:
        each name in sorted_names(os.ListDir(dir)):
            if name.ends_with(".txt"):
                out.push(dir + "/" + name)
            end
        end
    end
    ret out
end

func argument_files(): Vector<str>:
    out := Vector {} as Vector<str>
    argv := os.Args()
    mut i := 1
    until i < argv.len():
        out.push(argv.get(i))
        i++
    end
    ret out
end

func collect(paths: Vector<str>): Vector<Snippet> throws:
    out := Vector {} as Vector<Snippet>
    each path in paths:
        mut lang := "en"
        if path.includes("/fa/"):
            lang = "fa"
        end
        if fs.Exists(path) == false:
            throw "cannot read " + path
        end
        found := try snippets(path)
        each src in found:
            out.push(Snippet { path = path, lang = lang, src = src })
        end
    end
    ret out
end

func main:
    salam := env.GetOr("SALAM", "salam")
    env.Set("SALAM_STD", env.GetOr("SALAM_STD", "std"))

    mut paths := argument_files()
    if paths.len() == 0:
        paths = lesson_files()
    end
    mut jobs := Vector {} as Vector<Snippet>
    try:
        jobs = collect(paths)
    catch e:
        println "check-snippets: " + e.ToStr()
        ret 1
    end

    mut workers := env.GetInt("CHECK_JOBS", 0)
    if workers <= 0:
        workers = pool.CPUCount()
    end

    mutex := sync.NewMutex()
    pool.ParallelFor(jobs.len() as i64, workers, (i: i64):
        snippet := jobs.get(i as int)
        verdict := problem(snippet, salam)
        if verdict.code != 0:
            sync.Lock(mutex)
            failed.push("FAIL " + snippet.path + "\n" + snippet.src + "\n--> " + verdict.out + "\n")
            sync.Unlock(mutex)
        end
    end)

    mut shown := 0
    each message in failed:
        if shown >= SHOWN:
            break
        end
        println message
        shown++
    end
    println "snippets: " + str.FromInt(jobs.len()) + " checked, " + str.FromInt(failed.len()) + " failed"
    if failed.len() > 0:
        ret 1
    end
    ret 0
end
