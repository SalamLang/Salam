package main

import io
import str
import gui.css

const OUT := "std/gui/css/ua_program.salam"

func main:
    mut p := css.NewProgram()
    _n := css.CompileCss(p, css.DefaultCss())
    if css.ProgramErrors(p) > 0:
        repeat css.ProgramErrors(p) in i:
            println "ua css:", css.ProgramError(p, i)
        end
        ret 1
    end
    header := io.ReadFile("std/gui/css/sheet.salam")
    cut := header.Find("*/")
    body := css.ProgramSource(p, "ua_program", "")
    io.WriteFile(OUT, header.Substr(0, cut + 2) + "\n\npackage css\n\n" + body)
    println "wrote", OUT, str.Len(body), "bytes"
    ret 0
end
