import os
import str

langpack_file := "c/src/langpack/langpack_data.c"
types_file := "c/src/semantic/types.c"
elements_dir := "std/layout/elements"
out_file := "editor/keywords.js"

func find_from(s: str, sub: str, start: int): int:
    if start >= s.Len(): ret 0 - 1 end
    rest := s.Substr(start, s.Len() - start)
    k := rest.Find(sub)
    if k < 0: ret 0 - 1 end
    ret start + k
end

func str_lit(text: str, q: int): str:
    mut out := ""
    n := text.Len()
    mut i := q + 1
    until i < n:
        c := text.Substr(i, 1)
        if c == "\\" and i + 1 < n:
            out = out.Concat(c).Concat(text.Substr(i + 1, 1))
            i += 2
            continue
        end
        if c == "\"": break end
        out = out.Concat(c)
        i++
    end
    ret out
end

func str_end(text: str, q: int): int:
    n := text.Len()
    mut i := q + 1
    until i < n:
        c := text.Substr(i, 1)
        if c == "\\" and i + 1 < n:
            i += 2
            continue
        end
        if c == "\"": ret i end
        i++
    end
    ret n
end

func contains(v: Vector<str>, s: str): bool:
    repeat v.Len() in i:
        if v.Get(i) == s: ret true end
    end
    ret false
end

func uniq(v: Vector<str>): Vector<str>:
    mut out := Vector {} as Vector<str> repeat v.Len() in i: s := v.Get(i)
    if contains(out, s) == false: out.Push(s) end
end
ret out
end

func json_escape(s: str): str:
    mut out := ""
    mut i := 0
    until i < s.Len():
        c := s.Substr(i, 1)
        switch c:
            "\\":
                out = out.Concat("\\\\")
                break
            end
            "\"":
                out = out.Concat("\\\"")
                break
            end
            "\n":
                out = out.Concat("\\n")
                break
            end
            "\t":
                out = out.Concat("\\t")
                break
            end
            "\r":
                out = out.Concat("")
                break
            end
            else:
                out = out.Concat(c)
            end
        end
        i++
    end
    ret out
end

func json_array(v: Vector<str>): str:
    mut out := "["
    repeat v.Len() in i:
        if i > 0: out = out.Concat(", ") end
        out = out.Concat("\"").Concat(json_escape(v.Get(i))).Concat("\"")
    end
    ret out.Concat("]")
end

func collect_keywords(text: str): Vector<str>:
    mut out := Vector {} as Vector<str> mut i := 0
    until i < text.Len():
        k := find_from(text, "TK_KW_", i)
        if k < 0: break end
        q := find_from(text, "\"", k)
        if q < 0: break end
        val := str_lit(text, q)
        e := str_end(text, q)
        if val.Len() > 0:
            out.Push(val)
        end
        i = e + 1
    end
    ret out
end

func type_follows(text: str, e: int): bool:
    n := text.Len()
    mut j := e + 1
    until j < n:
        c := text.Substr(j, 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r":
            j++
            continue
        end
        break
    end
    if j >= n: ret false end
    if text.Substr(j, 1) != ",": ret false end
    j++
    until j < n:
        c := text.Substr(j, 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r":
            j++
            continue
        end
        break
    end
    if j + 3 > n: ret false end
    ret text.Substr(j, 3) == "TY_"
end

func collect_types(text: str): Vector<str>:
    mut out := Vector {} as Vector<str> n := text.Len()
    mut i := 0
    until i < n:
        c := text.Substr(i, 1)
        if c == "\"":
            val := str_lit(text, i)
            e := str_end(text, i)
            if type_follows(text, e):
                out.Push(val)
            end
            i = e + 1
            continue
        end
        i++
    end
    ret out
end

func line_after(text: str, marker: str): str:
    m := text.Find(marker)
    if m < 0: ret "" end
    start := m + marker.Len()
    rest := text.Substr(start, text.Len() - start)
    nl := rest.Find("\n")
    if nl < 0: ret rest end
    ret rest.Substr(0, nl)
end

func first_string(region: str): str:
    q := region.Find("\"")
    if q < 0: ret "" end
    ret str_lit(region, q)
end

func collect_strings(region: str): Vector<str>:
    mut out := Vector {} as Vector<str> n := region.Len()
    mut i := 0
    until i < n:
        c := region.Substr(i, 1)
        if c == "\"":
            out.Push(str_lit(region, i))
            i = str_end(region, i) + 1
            continue
        end
        i++
    end
    ret out
end

func str_less(a: str, b: str): bool:
    la := a.Len()
    lb := b.Len()
    mut i := 0
    until i < la and i < lb:
        ca := char_code(a.Substr(i, 1))
        cb := char_code(b.Substr(i, 1))
        if ca != cb: ret ca < cb end
        i++
    end
    ret la < lb
end

func main:
    lang_src := os.ReadFile(langpack_file)
    mut kw := collect_keywords(lang_src)
    types_src := os.ReadFile(types_file)
    mut ty := collect_types(types_src)
    ty.Push("auto")
    ty.Push("خودکار")
    ty.Push("تلقائي")
    ty.Push("byte")
    ty.Push("HashMap")
    ty.Push("Vector")
    ty.Push("MapIter")

    mut entries := os.ListDir(elements_dir)
    mut files := Vector {} as Vector<str> repeat entries.Len() in i: name := entries.Get(i)
    if str.EndsWith(name, ".salam"): files.Push(name) end
end
n := files.Len()
repeat n - 1 in i:
    mut lo := i
    repeat i + 1 to n - 1 in j:
        if str_less(files.Get(j), files.Get(lo)): lo = j end
    end
    if lo != i:
        t := files.Get(i)
        files.Set(i, files.Get(lo))
        files.Set(lo, t)
    end
end

mut el := Vector {} as Vector<str> repeat n in i: name := files.Get(i)
text := os.ReadFile(elements_dir.Concat("/").Concat(name))
en := first_string(line_after(text, "@en"))
if en.Len() > 0:
    if en.Find(" ") < 0: el.Push(en) end
end
mut fa := collect_strings(line_after(text, "@fa"))
repeat fa.Len() in j:
    s := fa.Get(j)
    if s.Find(" ") < 0: el.Push(s) end
end
end
kw = uniq(kw)
ty = uniq(ty)
el = uniq(el)
mut out := "// AUTO-GENERATED by tools/salam/gen-editor-keywords.salam from the compiler sources.\n"
out = out.Concat("// Do NOT edit by hand, run `salam run tools/salam/gen-editor-keywords.salam`\n")
out = out.Concat("// (tools/bash/build-wasm.sh runs it automatically). Sources: c/src/langpack/langpack_data.c,\n")
out = out.Concat("// c/src/semantic/types.c, std/layout/elements/*.salam.\n")
out = out.Concat("window.SALAM_LEX = {\n")
out = out.Concat("  kw: ").Concat(json_array(kw)).Concat(",\n")
out = out.Concat("  ty: ").Concat(json_array(ty)).Concat(",\n")
out = out.Concat("  el: ").Concat(json_array(el)).Concat("\n")
out = out.Concat("};\n")
os.WriteFile(out_file, out)
println "wrote editor/keywords.js:", kw.Len(), "keywords,", ty.Len(), "types,", el.Len(), "elements"
end
