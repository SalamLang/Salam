/*
 * Salam Programming Language (2024-2026)
 *
 *   +-------------------+
 *   |     S A L A M     |
 *   +-------------------+
 *
 * Designed by Seyyed Ali Mohammadiyeh and the Salam Team
 * Born from a decade of language design experience (since 2018)
 *
 * Repository: https://github.com/SalamLang/Salam
 *
 */

import os
import conv

func json_escape(s: str): str:
    mut out := ""
    mut i := 0
    until i < s.Len():
        c := s.Substr(i, 1)
        switch c:
            "\\":
                out = out.Concat("\\\\")
                break
            end
            "\"":
                out = out.Concat("\\\"")
                break
            end
            "\n":
                out = out.Concat("\\n")
                break
            end
            "\t":
                out = out.Concat("\\t")
                break
            end
            "\r":
                out = out.Concat("")
                break
            end
            else:
                out = out.Concat(c)
            end
        end
        i++
    end
    ret out
end

func copyright_header(): str:
    mut h := "/*\n"
    h = h.Concat(" * Salam Programming Language (2024-2026)\n")
    h = h.Concat(" *\n")
    h = h.Concat(" *   +-------------------+\n")
    h = h.Concat(" *   |     S A L A M     |\n")
    h = h.Concat(" *   +-------------------+\n")
    h = h.Concat(" *\n")
    h = h.Concat(" * Designed by Seyyed Ali Mohammadiyeh and the Salam Team\n")
    h = h.Concat(" * Born from a decade of language design experience (since 2018)\n")
    h = h.Concat(" *\n")
    h = h.Concat(" * Repository: https://github.com/SalamLang/Salam\n")
    h = h.Concat(" *\n")
    h = h.Concat(" */\n\n")
    ret h
end

func find_from(s: str, sub: str, start: int): int:
    if start >= s.Len(): ret 0 - 1 end
    rest := s.Substr(start, s.Len() - start)
    k := rest.Find(sub)
    if k < 0: ret 0 - 1 end
    ret start + k
end

func head_offset(s: str): int:
    n := s.Len()
    mut i := 0
    until i < n:
        c := s.Substr(i, 1)
        if c == " " or c == "\t" or c == "\n" or c == "\r":
            i++
            continue
        end
        mut nxt := ""
        if i + 1 < n: nxt = s.Substr(i + 1, 1) end
        if c == "/" and nxt == "/":
            mut bang := ""
            if i + 2 < n: bang = s.Substr(i + 2, 1) end
            if bang == "!": ret i end
            j := find_from(s, "\n", i)
            if j < 0: ret n end
            i = j + 1
            continue
        end
        if c == "/" and nxt == "*":
            mut depth := 1
            i += 2
            until i < n and depth > 0:
                c2 := s.Substr(i, 1)
                mut n2 := ""
                if i + 1 < n: n2 = s.Substr(i + 1, 1) end
                if c2 == "/" and n2 == "*":
                    depth++
                    i += 2
                else c2 == "*" and n2 == "/":
                    depth--
                    i += 2
                else:
                    i++
                end
            end
            continue
        end
        ret i
    end
    ret n
end

func is_directive_at(s: str, off: int): bool:
    if off + 3 > s.Len(): ret false end
    ret s.Substr(off, 3) == "//!"
end

func first_line(s: str): str:
    off := head_offset(s)
    if is_directive_at(s, off) == false: ret "" end
    rest := s.Substr(off, s.Len() - off)
    nl := rest.Find("\n")
    if nl < 0: ret rest end
    ret rest.Substr(0, nl)
end

func strip_header(s: str): str:
    off := head_offset(s)
    rest := s.Substr(off, s.Len() - off)
    if is_directive_at(s, off) == false: ret rest end
    nl := rest.Find("\n")
    if nl < 0: ret "" end
    ret rest.Substr(nl + 1, rest.Len() - nl - 1)
end

func field_value(header: str, key_en: str, key_fa: str, key_ar: str): str:
    mut a := header.Find(key_ar)
    mut klen := key_ar.Len()
    if a < 0:
        a = header.Find(key_fa)
        klen = key_fa.Len()
    end
    if a < 0:
        a = header.Find(key_en)
        klen = key_en.Len()
    end
    if a < 0: ret "" end
    start := a + klen
    rest := header.Substr(start, header.Len() - start)
    bar := rest.Find(" |")
    if bar < 0: ret rest end
    ret rest.Substr(0, bar)
end

func parse_mode(header: str): str:
    v := field_value(header, "mode: ", "حالت: ", "وضع: ")
    switch v:
        "", "برنامه", "برنامج":
            ret "app"
        end
        "صفحه", "چیدمان", "تخطيط":
            ret "layout"
        end
    end
    ret v
end

func parse_title(header: str): str:
    ret field_value(header, "title: ", "عنوان: ", "عنوان: ")
end

func manifest_lines(): Vector<str>:
    text := os.ReadFile("tools/salam/editor-examples.tsv")
    ret text.Split("\n")
end

func manifest_field(lines: Vector<str>, id: str, col: int): str:
    repeat lines.Len() in i:
        parts := lines.Get(i).Split("\t")
        if parts.Len() >= 4 and parts.Get(0) == id:
            v := parts.Get(col)
            ret v
        end
    end
    ret ""
end

func infer_mode(code: str): str:
    if code.Find("layout:") == 0 or code.Find("\nlayout:") >= 0 or code.Find("صفحه:") == 0 or code.Find("\nصفحه:") >= 0 or code.Find("چیدمان:") == 0 or code.Find("\nچیدمان:") >= 0:
        ret "layout"
    end
    ret "app"
end

func id_from_name(name: str): str:
    mut s := name.Substr(3, name.Len() - 3)
    dot := s.Find(".salam")
    if dot < 0: ret s end
    ret s.Substr(0, dot)
end

func order_of(name: str): int:
    ret name.Substr(0, 2).ToInt()
end

func is_salam_file(name: str): bool:
    n := name.Len()
    if n < 6: ret false end
    ret name.Substr(n - 6, 6) == ".salam"
end

func main:
    en_dir := "tests/en/editor-selected"
    fa_dir := "tests/fa/editor-selected"
    mut entries := os.ListDir(en_dir)
    mut files := Vector {} as Vector<str>
    repeat entries.Len() in i:
        if is_salam_file(entries.Get(i)):
            files.Push(entries.Get(i))
        end
    end
    n := files.Len()
    if n == 0:
        println "error: no .salam examples found in", en_dir
        println "       run this from the repository root: salam run tools/salam/gen-examples.salam"
        ret 1
    end
    repeat n - 1 in i:
        mut lo := i
        repeat i + 1 to n - 1 in j:
            if order_of(files.Get(j)) < order_of(files.Get(lo)):
                lo = j
            end
        end
        if lo != i:
            t := files.Get(i)
            files.Set(i, files.Get(lo))
            files.Set(lo, t)
        end
    end
    manifest := manifest_lines()
    mut examples_lit := "pub const EXAMPLES := [\n"
    repeat n + 0 in i:
        name := files.Get(i)
        en := os.ReadFile(en_dir.Concat("/").Concat(name))
        fa := os.ReadFile(fa_dir.Concat("/").Concat(name))
        id := id_from_name(name)
        code_en := strip_header(en)
        code_fa := strip_header(fa)
        mut mode := parse_mode(first_line(en))
        mut title_en := parse_title(first_line(en))
        mut title_fa := parse_title(first_line(fa))
        if first_line(en).Len() == 0:
            mode = manifest_field(manifest, id, 1)
            if mode.Len() == 0:
                mode = infer_mode(code_en)
            end
        end
        if title_en.Len() == 0:
            title_en = manifest_field(manifest, id, 2)
        end
        if title_fa.Len() == 0:
            title_fa = manifest_field(manifest, id, 3)
        end
        if title_en.Len() == 0:
            title_en = id
        end
        if title_fa.Len() == 0:
            title_fa = title_en
        end
        examples_lit = examples_lit.Concat("    Example {\n")
        examples_lit = examples_lit.Concat("        id = \"").Concat(id).Concat("\"\n")
        examples_lit = examples_lit.Concat("        mode = \"").Concat(mode).Concat("\"\n")
        examples_lit = examples_lit.Concat("        title_en = \"").Concat(json_escape(title_en)).Concat("\"\n")
        examples_lit = examples_lit.Concat("        title_fa = \"").Concat(json_escape(title_fa)).Concat("\"\n")
        examples_lit = examples_lit.Concat("        code_en = \"").Concat(json_escape(code_en)).Concat("\"\n")
        examples_lit = examples_lit.Concat("        code_fa = \"").Concat(json_escape(code_fa)).Concat("\"\n")
        if i < n - 1: examples_lit = examples_lit.Concat("    },\n")
        else:
            examples_lit = examples_lit.Concat("    }\n")
        end
    end
    examples_lit = examples_lit.Concat("]\n\n")

    mut out := copyright_header()
    out = out.Concat("package examples_data\n\n")
    out = out.Concat("pub const EXAMPLE_COUNT := ").Concat(conv.FormatInt(n as i64)).Concat("\n\n")
    out = out.Concat(examples_lit)
    out = out.Concat("pub struct Example:\n")
    out = out.Concat("    pub id: str = \"\"\n")
    out = out.Concat("    pub mode: str = \"\"\n")
    out = out.Concat("    pub title_en: str = \"\"\n")
    out = out.Concat("    pub title_fa: str = \"\"\n")
    out = out.Concat("    pub code_en: str = \"\"\n")
    out = out.Concat("    pub code_fa: str = \"\"\n")
    out = out.Concat("end\n")
    os.WriteFile("editor/examples_data.salam", out)
    println "wrote editor/examples_data.salam with", n, "examples"
    ret 0
end
