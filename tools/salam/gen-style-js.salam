package main

import io
import os
import str
import gui.style

const KEYWORDS := "tools/salam/style-keywords.tsv"
const PROPERTIES := "tools/salam/style-properties.tsv"
const TEMPLATE := "tools/salam/style-runtime.js"
const COLORS := "std/gui/color/names.salam"
const OUT := "compiler/sal_layout/layout_style_js.salam"

func rows(path: str): Vector<Vector<str>>:
    mut out := Vector {} as Vector<Vector<str>>
    lines := str.Split(io.ReadFile(path), "\n")
    each i, line in lines:
        if i == 0 or str.Trim(line) == "":
            continue
        end
        out.Push(str.Split(line, "\t"))
    end
    ret out
end

func jq(s: str): str:
    mut t := str.Replace(s, "\\", "\\\\")
    t = str.Replace(t, "\"", "\\\"")
    t = str.Replace(t, "\n", "\\n")
    ret "\"" + t + "\""
end

func key(s: str): str:
    ret str.Lower(str.Replace(s, "‌", " "))
end

func probe(p: int, text: str): str:
    mut v := style.Value {}
    if not style.Parse(p, text, v):
        ret "\u0001"
    end
    ret style.Css(p, v)
end

func ok(s: str): bool:
    ret s != "\u0001"
end

func after_colon(decl: str): str:
    at := str.IndexOf(decl, ":")
    ret str.Substr(decl, at + 1, decl.Len() - at - 1)
end

func one_decl(decl: str): bool:
    ret str.IndexOf(decl, ";") < 0 and str.IndexOf(decl, ":") >= 0 and str.IndexOf(decl, "&") < 0
end

func sentinel(mask: int, k: int, small: bool): str:
    n := (k + 1) * 11
    if small and ((mask & 2) == 0 or (mask & 4) != 0) and (mask & 128) == 0 and (mask & 64) == 0 and (mask & 32) == 0:
        ret "0." + str.FromInt(n as i64)
    end
    if (mask & 2) != 0:
        ret str.FromInt(n as i64) + "px"
    end
    if (mask & 4) != 0 or (mask & 8) != 0:
        ret str.FromInt(n as i64)
    end
    if (mask & 64) != 0:
        ret str.FromInt(n as i64) + "deg"
    end
    if (mask & 32) != 0:
        ret str.FromInt(n as i64) + "ms"
    end
    ret ["#123456", "#234567", "#345678", "#456789"][k]
end

func item_css(mask: int, v: int): str:
    if (mask & 2) != 0:
        ret v == 0 ? "0" : "1px"
    end
    if (mask & 4) != 0 or (mask & 8) != 0:
        ret str.FromInt(v as i64)
    end
    if (mask & 64) != 0:
        ret str.FromInt(v as i64) + "deg"
    end
    ret ""
end

func fill(tpl: str, items: Vector<str>): str:
    mut s := tpl
    each i, it in items:
        s = str.Replace(s, "{" + i + "}", it)
    end
    ret s
end

func template_of(css: str, sents: Vector<str>): str:
    mut t := css
    each i, s in sents:
        t = str.Replace(t, s, "{" + i + "}")
    end
    ret t
end

func kind_of(k: str): str:
    if k == "WORD":
        ret "w"
    else k == "BOOL":
        ret "b"
    else k == "BORDER":
        ret "bd"
    else k == "SHADOW" or k == "TEXT_SHADOW":
        ret "sh"
    else k == "TRACKS":
        ret "tr"
    else k == "TRANSITION":
        ret "tn"
    else k == "PROPS":
        ret "pr"
    else k == "PAINT":
        ret "pt"
    else k == "FONTS":
        ret "ft"
    else k == "STRINGS":
        ret "st"
    end
    ret "i"
end

func mask_of(items: str, words: str): int:
    names := ["", "LEN", "NUM", "INT", "BOOL", "TIME", "ANGLE", "COLOR", "WORD", "STR", "PAINT", "EASE", "TRACK", "PROP"]
    mut m := 0
    each it in str.Split(items, " "):
        each i, n in names:
            if n == it and i > 0:
                m |= 1 << i
            end
        end
    end
    if words != "":
        m |= 1 << 8
    end
    ret m
end

func color_table(): str:
    text := io.ReadFile(COLORS)
    mut out := ""
    each line in str.Split(text, "\n"):
        at := str.IndexOf(line, "_gc_load_table(m, \"")
        if at < 0:
            continue
        end
        start := at + 19
        stop := str.IndexFrom(line, "\"", start)
        parts := str.Fields(str.Substr(line, start, stop - start))
        mut i := 0
        until i + 1 < parts.Len():
            if out != "":
                out += ","
            end
            out += jq(key(parts.Get(i))) + ":" + jq("#" + parts.Get(i + 1))
            i += 2
        end
    end
    ret "{" + out + "}"
end

func prop_entry(p: int, r: Vector<str>, cases &: str): str:
    kind := kind_of(r.Get(3))
    words := r.Get(9) == "-" ? "" : r.Get(9)
    mask := mask_of(r.Get(4) == "-" ? "" : r.Get(4), words)
    mn := r.Get(5)
    mx := r.Get(6)
    mut wlist := Vector {} as Vector<str>
    if words != "":
        each w in str.Split(words, "|"):
            wlist.Push(w)
        end
    end
    mut wd := ""
    mut wv := ""
    each w in wlist:
        d := probe(p, w)
        if not ok(d):
            continue
        end
        cases += str.FromInt(p as i64) + "\t" + w + "\t" + d + "\n"
        wd += (wd != "" ? "," : "") + jq(w) + ":" + jq(d)
        if one_decl(d) and kind != "bd":
            wv += (wv != "" ? "," : "") + jq(w) + ":" + jq(after_colon(d))
        end
    end
    mut extra := ""
    if (r.Get(3) == "INT" or r.Get(3) == "NUMBER") and r.Get(7) != r.Get(8):
        extra += ",lo:" + r.Get(7) + ",hi:" + r.Get(8)
    end
    mut tpls := Vector {} as Vector<str>
    mut sp := ""
    pc := r.Get(14) == "yes" ? "1" : "0"
    if kind == "b":
        bt := probe(p, "true")
        bf := probe(p, "false")
        extra += ",bt:" + jq(ok(bt) ? bt : "") + ",bf:" + jq(ok(bf) ? bf : "")
        cases += str.FromInt(p as i64) + "\ttrue\t" + bt + "\n" + str.FromInt(p as i64) + "\tfalse\t" + bf + "\n"
    else kind == "bd":
        mut sents := Vector {} as Vector<str>
        sents.Push("11px")
        sents.Push("solid")
        sents.Push("#123456")
        css := probe(p, "11px, solid, #123456")
        tpls.Push("")
        tpls.Push("")
        tpls.Push("")
        tpls.Push(template_of(css, sents))
        each w in wlist:
            d := probe(p, "11px, " + w + ", #123456")
            if ok(d):
                mut rest := str.Replace(str.Replace(d, "11px", ""), "#123456", "")
                rest = str.Trim(after_colon(rest))
                wv += (wv != "" ? "," : "") + jq(w) + ":" + jq(rest)
            end
        end
    else kind == "sh":
        nl := r.Get(3) == "TEXT_SHADOW" ? 3 : 4
        mut inner := "[11px, 22px, 33px, "
        if nl == 4:
            inner += "44px, "
        end
        inner += "#123456]"
        css := probe(p, inner)
        extra += ",nl:" + nl
        tpls.Push("")
        if ok(css):
            tpls.Push(str.Substr(css, 0, str.IndexOf(css, ":") + 1) + "{0}")
        end
    else kind == "tr":
        css := probe(p, "11px")
        tpls.Push("")
        tpls.Push(str.Substr(css, 0, str.IndexOf(css, ":") + 1) + "{0}")
    else kind == "st":
        css := probe(p, "\"a\"")
        tpls.Push("")
        tpls.Push(str.Substr(css, 0, str.IndexOf(css, ":") + 1) + "{0}")
    else kind == "i":
        mut top := mx.ToInt()
        if top > 4:
            top = 4
        end
        repeat top in k:
            n := k + 1
            mut css := "\u0001"
            mut sents := Vector {} as Vector<str>
            mut text := ""
            each small in [false, true]:
                if ok(css):
                    continue
                end
                sents.Clear()
                text = ""
                repeat n in j:
                    s := sentinel(mask, j, small)
                    sents.Push(s)
                    text += (j > 0 ? ", " : "") + s
                end
                css = probe(p, text)
            end
            if k == 0:
                tpls.Push("")
            end
            tpls.Push(ok(css) ? template_of(css, sents) : "")
            if ok(css):
                cases += str.FromInt(p as i64) + "\t" + text + "\t" + css + "\n"
            end
        end
        each pr in ["0", "1", "0, 0", "1, 1", "0, 1"]:
            texts := str.Split(pr, ", ")
            if texts.Len() > top:
                continue
            end
            mut its := Vector {} as Vector<str>
            each v in texts:
                its.Push(item_css(mask, v.ToInt()))
            end
            css := probe(p, pr)
            if not ok(css):
                continue
            end
            cases += str.FromInt(p as i64) + "\t" + pr + "\t" + css + "\n"
            exp := tpls.Get(texts.Len()) == "" ? "" : fill(tpls.Get(texts.Len()), its)
            if exp != css:
                sp += (sp != "" ? "," : "") + jq(str.Join(its, "|")) + ":" + jq(css)
            end
        end
    end
    mut tj := ""
    each i, t in tpls:
        tj += (i > 0 ? "," : "") + (t == "" ? "null" : jq(t))
    end
    mut wj := ""
    each i, w in wlist:
        wj += (i > 0 ? "," : "") + jq(w)
    end
    ex := r.Get(15)
    c := probe(p, ex)
    if ok(c):
        cases += str.FromInt(p as i64) + "\t" + ex + "\t" + c + "\n"
    end
    ret "{n:" + jq(r.Get(1)) + ",k:" + jq(kind) + ",m:" + mask + ",mn:" + mn + ",mx:" + mx + ",pc:" + pc + ",w:[" + wj + "],wd:{" + wd + "},wv:{" + wv + "},t:[" + tj + "],sp:{" + sp + "}" + extra + "}"
end

func main:
    kws := rows(KEYWORDS)
    props := rows(PROPERTIES)
    mut cases := ""
    mut kmap := ""
    each k in kws:
        en := k.Get(1)
        kmap += (kmap != "" ? "," : "") + jq(key(en)) + ":" + jq(en) + "," + jq(key(k.Get(2))) + ":" + jq(en)
    end
    mut pn := ""
    tp := style.PropByName("transition properties")
    each r in props:
        if r.Get(12) != "yes" or tp < 0:
            continue
        end
        d := probe(tp, r.Get(1))
        if not ok(d):
            continue
        end
        v := after_colon(d)
        pn += (pn != "" ? "," : "") + jq(key(r.Get(1))) + ":" + jq(v) + "," + jq(key(r.Get(2))) + ":" + jq(v)
    end
    extras := [
        "color|red", "color|#3366aa", "color|#fff", "color|#3366aa80", "color|rgb(51, 102, 170)", "color|hsl(210, 50%, 40%)",
        "color|oklch(0.5, 0.1, 200)", "color|mix(red, blue, 30%)", "color|light dark(white, black)", "color|current", "color|transparent",
        "color|قرمز", "color|\"red\"", "gap|8", "gap|8, 16", "gap|۸، ۱۶", "gap|100% - 20", "gap|50% + 1em", "gap|2rem", "padding|8, 16", "padding|1, 2, 3, 4",
        "width|fill", "width|50%", "width|px(12)", "width|۵۰٪", "width|عرض", "opacity|50%", "opacity|۰٫۵", "line height|1.5", "line height|20",
        "layout|row", "layout|ستون", "layout|stack", "layout|flow", "layout|grid", "layout|column", "align|center", "justify|between", "justify|وسط",
        "border|2, solid, #3366aa", "border|red, 1", "border|none", "shadow|[0, 4, 8, black], [0, 1, 2, red]", "shadow|[0, 4, 8, 2, #00000040, inset]",
        "shadow|none", "text shadow|[0, 1, 2, red]", "transition|200ms, ease out", "transition|[200ms, ease, 50ms], [1s, linear]", "transition|ease(0.2, 0, 0, 1), 1s",
        "transition|steps(4), 2s", "transition|none", "transition properties|opacity, background", "transition properties|all",
        "columns|200, 1fr", "columns|repeat(3, 1fr)", "columns|repeat(fill, minmax(100, 1fr))", "columns|fit(200), auto", "columns|none",
        "background|red", "background|linear(90, #3366aa, white)", "background|linear(to right, red, blue 50%)", "background|radial(circle, red, blue)",
        "background|conic(45, red, blue)", "background|image(\"a.png\"), red", "background|none", "font|\"Vazirmatn\", sans", "font|mono",
        "font weight|bold", "font weight|700", "font size|1.5em", "text align|start", "cursor|not allowed", "cursor|pointer", "translate|10, 20", "translate|0",
        "rotate|45deg", "rotate|0.5turn", "scale|1.5", "scale|1", "skew|10, 20", "origin|center", "blur|4", "blur|0", "brightness|1.2", "hover|1",
        "visible|true", "visible|false", "wrap|true", "italic|درست", "margin|auto", "margin|auto, 8", "aspect ratio|1.5", "max lines|3", "z|1",
        "font features|\"tnum\", \"ss01\"", "decoration|underline", "transform text|upper", "grow|2", "radius|8", "radius|1, 2, 3, 4", "inset|0",
        "background size|cover", "background position|center", "accent|red", "scrollbar color|red, blue", "direction|rtl", "white space|keep"
    ]
    each e in extras:
        parts := str.Split(e, "|")
        ep := style.PropByName(parts.Get(0))
        if ep < 0:
            continue
        end
        ec := probe(ep, parts.Get(1))
        if ok(ec):
            cases += str.FromInt(ep as i64) + "\t" + parts.Get(1) + "\t" + ec + "\n"
        else:
            printerrln "extra rejected: " + e
        end
    end
    mut tables := "var __stK = {" + kmap + "};\nvar __stCn = " + color_table() + ";\nvar __stPn = {" + pn + "};\nvar __stD = [\n"
    each i, r in props:
        id := style.PropByName(r.Get(1))
        if id != i:
            printerrln "gen-style-js: property order differs from gui.style at " + r.Get(1)
            ret 1
        end
        tables += prop_entry(i, r, cases) + (i + 1 < props.Len() ? ",\n" : "\n")
    end
    tables += "];\n"
    js := io.ReadFile(TEMPLATE)
    if str.IndexOf(js, "`") >= 0:
        printerrln "gen-style-js: the runtime template contains a backtick"
        ret 1
    end
    banner := io.ReadFile("std/gui/style/style.salam")
    head := banner.Substr(0, banner.Find("*/") + 2)
    out := head + "\n\npackage layout\n\npub func StyleRuntimeJs(): str:\n    ret `" + tables + js + "`\nend\n"
    io.WriteFile(OUT, out)
    cpath := os.Env("SALAM_STYLE_CASES")
    if cpath != "":
        io.WriteFile(cpath, cases)
    end
    println "wrote", OUT
    ret 0
end
