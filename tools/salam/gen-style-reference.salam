package main

import io
import str

const KEYWORDS := "tools/salam/style-keywords.tsv"
const PROPERTIES := "tools/salam/style-properties.tsv"
const OUT_EN := "website/content/en/learn/51-style-reference.txt"
const OUT_FA := "website/content/fa/learn/51-style-reference.txt"

func rows(path: str): Vector<Vector<str>>:
    mut out := Vector {} as Vector<Vector<str>>
    lines := str.Split(io.ReadFile(path), "\n")
    each i, line in lines:
        if i == 0 or str.Trim(line) == "":
            continue
        end
        out.Push(str.Split(line, "\t"))
    end
    ret out
end

func esc(s: str): str:
    ret str.Replace(str.Replace(str.Replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
end

func group_of(name: str): int:
    if name == "grow":
        ret 1
    end
    if name == "width":
        ret 2
    end
    if name == "background":
        ret 3
    end
    if name == "color":
        ret 4
    end
    if name == "transition":
        ret 5
    end
    ret 0
end

func yesno(v: str, fa: bool): str:
    if fa:
        ret v == "yes" ? "بله" : "خیر"
    end
    ret v == "yes" ? "yes" : "no"
end

func fa_digits(s: str): str:
    mut out := s
    digits := ["۰", "۱", "۲", "۳", "۴", "۵", "۶", "۷", "۸", "۹"]
    each i, d in digits:
        out = str.Replace(out, "" + i, d)
    end
    ret str.Replace(out, ", ", "، ")
end

func fa_words(text: str, kws: Vector<Vector<str>>): str:
    mut out := text
    each k in kws:
        if k.Get(1).Len() > 2 and str.Contains(out, k.Get(1)):
            out = str.Replace(out, k.Get(1), k.Get(2))
        end
    end
    ret out
end

func keyword_list(words: str, fa: bool, kws: Vector<Vector<str>>): str:
    if words == "-":
        ret "-"
    end
    mut parts := Vector {} as Vector<str>
    each w in str.Split(words, "|"):
        parts.Push("<code>" + esc(fa ? fa_words(w, kws) : w) + "</code>")
    end
    ret str.Join(parts, " ")
end

func kind_text(kind: str, fa: bool): str:
    names_en := ["LENGTH", "length", "NUMBER", "number", "INT", "integer", "BOOL", "true or false", "WORD", "keyword", "COLOR", "colour", "ANGLE", "angle", "PAINT", "paint", "BORDER", "width, style, colour", "SHADOW", "x, y, blur, spread, colour", "TEXT_SHADOW", "x, y, blur, colour", "TRACKS", "track list", "FONTS", "font family list", "STRINGS", "list of strings", "TRANSITION", "time, easing, delay", "PROPS", "property names"]
    names_fa := ["LENGTH", "طول", "NUMBER", "عدد", "INT", "عدد صحیح", "BOOL", "درست یا نادرست", "WORD", "واژه", "COLOR", "رنگ", "ANGLE", "زاویه", "PAINT", "رنگ یا تصویر", "BORDER", "ضخامت، سبک، رنگ", "SHADOW", "افقی، عمودی، تاری، گسترش، رنگ", "TEXT_SHADOW", "افقی، عمودی، تاری، رنگ", "TRACKS", "فهرست ردیف‌ها یا ستون‌ها", "FONTS", "فهرست خانواده قلم", "STRINGS", "فهرست رشته‌ها", "TRANSITION", "زمان، شتاب، تأخیر", "PROPS", "نام ویژگی‌ها"]
    mut i := 0
    until i < 32:
        if names_en[i] == kind:
            ret fa ? names_fa[i + 1] : names_en[i + 1]
        end
        i += 2
    end
    ret kind
end

func table(props: Vector<Vector<str>>, kws: Vector<Vector<str>>, lo: int, hi: int, fa: bool): str:
    mut b := "<table class=\"ref-table\">\n<thead><tr>"
    if fa:
        b += "<th>ویژگی</th><th>مقدارها</th><th>پیش‌فرض</th><th>انیمیشن</th><th>ارث‌بری</th><th>نمونه</th>"
    else:
        b += "<th>Property</th><th>Values</th><th>Default</th><th>Animates</th><th>Inherited</th><th>Example</th>"
    end
    b += "</tr></thead>\n<tbody>\n"
    mut i := lo
    until i < hi:
        p := props.Get(i)
        name := fa ? p.Get(2) : p.Get(1)
        alt := fa ? p.Get(1) : p.Get(2)
        kind := kind_text(p.Get(3), fa)
        mut values := kind
        if p.Get(9) != "-":
            values = keyword_list(p.Get(9), fa, kws) + " (" + kind + ")"
        end
        initial := fa ? fa_words(fa_digits(p.Get(10)), kws) : p.Get(10)
        example := fa ? fa_words(fa_digits(p.Get(15)), kws) : p.Get(15)
        b += "<tr id=\"p-" + str.Replace(p.Get(1), " ", "-") + "\"><td><code>" + esc(name) + "</code><br><span class=\"ref-alt\">" + esc(alt) + "</span></td><td>" + values + "</td><td><code>" + esc(initial) + "</code></td><td>" + yesno(p.Get(12), fa) + "</td><td>" + yesno(p.Get(11), fa) + "</td><td><code class=\"snip\" dir=\"" + (fa ? "rtl" : "ltr") + "\">" + esc(name) + " = " + esc(example) + "</code></td></tr>\n"
        i++
    end
    ret b + "</tbody>\n</table>\n"
end

func page(props: Vector<Vector<str>>, kws: Vector<Vector<str>>, fa: bool): str:
    mut starts := Vector {} as Vector<int>
    each i, p in props:
        if i == 0 or group_of(p.Get(1)) > 0:
            starts.Push(i)
        end
    end
    en_titles := ["Layout of children", "A child in its parent", "Box", "Look", "Text", "Motion"]
    fa_titles := ["چیدمان فرزندان", "فرزند در والد", "جعبه", "ظاهر", "متن", "حرکت"]
    en_ids := ["container", "child", "box", "look", "text", "motion"]
    en_intro := [
        "These properties go on the element that holds the children.",
        "These properties go on a child and say how it behaves inside its parent.",
        "Size, space, and what happens to content that does not fit.",
        "Backgrounds, borders, shadows, filters, transforms and the pointer.",
        "Text properties are inherited: set them on a box and every text inside takes them.",
        "A change of a property can take time instead of jumping."]
    fa_intro := [
        "این ویژگی‌ها روی عنصری می‌آیند که فرزندان را نگه می‌دارد.",
        "این ویژگی‌ها روی فرزند می‌آیند و رفتار آن را درون والد می‌گویند.",
        "اندازه، فاصله، و آنچه برای محتوای جانشده بیرون جعبه رخ می‌دهد.",
        "پس‌زمینه، کادر، سایه، فیلتر، تبدیل‌ها و نشانگر ماوس.",
        "ویژگی‌های متن ارث‌بری می‌شوند: روی یک جعبه بگذارید تا هر متن درونش آن را بگیرد.",
        "تغییر یک ویژگی می‌تواند به‌جای جهش، زمان ببرد."]
    mut body := ""
    each g, s in starts:
        hi := g + 1 < starts.Len() ? starts.Get(g + 1) : props.Len()
        body += "<h2 id=\"" + en_ids[g] + "\">" + (fa ? fa_titles[g] : en_titles[g]) + "</h2>\n<p>" + (fa ? fa_intro[g] : en_intro[g]) + "</p>\n"
        body += table(props, kws, s, hi, fa)
    end
    ret body
end

func head(fa: bool, count: int): str:
    if fa:
        ret "lesson.part = مرجع\nlesson.title = مرجع واژگان سبک\nlesson.summary = فهرست همه ویژگی‌های استاندارد زبان صفحه: مقدارها، پیش‌فرض‌ها، حالت‌ها و نمونه\nlesson.seo_title = مرجع ویژگی‌های سبک سلام: مقدار، پیش‌فرض و نمونه | آموزش سلام\nlesson.description = جدول همه " + fa_digits("" + count) + " ویژگی استاندارد زبان صفحه سلام برای وب و برنامه بومی، با مقدار مجاز، پیش‌فرض، انیمیشن‌پذیری، ارث‌بری و نمونه. این صفحه از جدول ویژگی‌های مخزن ساخته می‌شود.\nlesson.lead = هر ویژگی که در زبان صفحه می‌نویسید در این جدول است و روی هر دو هدف، وب و برنامه بومی، کار می‌کند. نام انگلیسی و فارسی هر ویژگی کنار هم آمده است.\nlesson.body <<\n"
    end
    ret "lesson.part = Reference\nlesson.title = Style vocabulary reference\nlesson.summary = Every property of the standard page language: values, defaults, states and examples\nlesson.seo_title = Salam style properties: values, defaults and examples | Salam course\nlesson.description = A table of all " + count + " standard properties of the Salam page language for web and native apps, with allowed values, defaults, animation, inheritance and an example. Generated from the property table in the repository.\nlesson.lead = Every property you can write in the page language is in this table, and every one works on both targets, web and native. Persian names are shown under the English ones.\nlesson.body <<\n"
end

func states(fa: bool): str:
    if fa:
        ret "<h2 id=\"states\">حالت‌ها</h2>\n<p>هر ویژگی سبک می‌تواند یک پیشوند حالت داشته باشد و فقط در آن حالت اعمال شود، مثلاً <code>hover پس‌زمینه = #ffeecc</code>. حالت‌ها: <code>hover</code> <code>focus</code> <code>focus within</code> <code>active</code> <code>disabled</code> <code>checked</code> <code>invalid</code> <code>placeholder</code> <code>selection</code>.</p>\n<h2 id=\"values\">شکل مقدارها</h2>\n<ul>\n<li>عدد ساده: واحد طبیعی ویژگی (پیکسل برای طول، میلی‌ثانیه برای زمان، درجه برای زاویه).</li>\n<li>درصد: <code>50%</code>. واحدها: <code>px</code> <code>em</code> <code>rem</code> <code>fr</code> <code>vw</code> <code>vh</code> <code>ms</code> <code>s</code> <code>deg</code> <code>turn</code>.</li>\n<li>فهرست با ویرگول: <code>فاصله = 8, 16</code>. گروه با کروشه: <code>سایه = [0, 4, 8, black], [0, 1, 2, red]</code>.</li>\n<li>رنگ: <code>red</code> <code>#3366aa</code> <code>rgb(51, 102, 170)</code> <code>hsl(210, 50%, 40%)</code> <code>mix(red, blue, 30%)</code> <code>light dark(white, black)</code>.</li>\n</ul>\n"
    end
    ret "<h2 id=\"states\">States</h2>\n<p>Any style property can carry one state prefix and then applies only in that state, for example <code>hover background = #ffeecc</code>. The states are <code>hover</code>, <code>focus</code>, <code>focus within</code>, <code>active</code>, <code>disabled</code>, <code>checked</code>, <code>invalid</code>, <code>placeholder</code> and <code>selection</code>.</p>\n<h2 id=\"values\">Value forms</h2>\n<ul>\n<li>A bare number uses the natural unit of the property: pixels for lengths, milliseconds for times, degrees for angles.</li>\n<li>Percent: <code>50%</code>. Units: <code>px</code> <code>em</code> <code>rem</code> <code>fr</code> <code>vw</code> <code>vh</code> <code>ms</code> <code>s</code> <code>deg</code> <code>turn</code>.</li>\n<li>A comma list continues one property: <code>padding = 8, 16</code>. Brackets group one item of a repeated property: <code>shadow = [0, 4, 8, black], [0, 1, 2, red]</code>.</li>\n<li>Colours: <code>red</code>, <code>#3366aa</code>, <code>rgb(51, 102, 170)</code>, <code>hsl(210, 50%, 40%)</code>, <code>mix(red, blue, 30%)</code>, <code>light dark(white, black)</code>.</li>\n</ul>\n"
end

func main:
    kws := rows(KEYWORDS)
    props := rows(PROPERTIES)
    each fa in [false, true]:
        text := head(fa, props.Len()) + states(fa) + page(props, kws, fa) + ">>\n"
        io.WriteFile(fa ? OUT_FA : OUT_EN, text)
    end
    println "wrote", OUT_EN, "and", OUT_FA + ":", props.Len(), "properties"
    ret 0
end
