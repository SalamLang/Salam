package main

import io
import str

const KEYWORDS := "tools/salam/style-keywords.tsv"
const PROPERTIES := "tools/salam/style-properties.tsv"
const NAMES_OUT := "std/gui/style/names.salam"
const TABLE_OUT := "std/gui/style/table.salam"

func rows(path: str): Vector<Vector<str>>:
    mut out := Vector {} as Vector<Vector<str>>
    lines := str.Split(io.ReadFile(path), "\n")
    each i, line in lines:
        if i == 0 or str.Trim(line) == "":
            continue
        end
        out.push(str.Split(line, "\t"))
    end
    ret out
end

func item_bit(name: str): int:
    names := ["", "LEN", "NUM", "INT", "BOOL", "TIME", "ANGLE", "COLOR", "WORD", "STR", "PAINT", "EASE", "TRACK", "PROP"]
    each i, n in names:
        if n == name and i > 0:
            ret 1 << i
        end
    end
    printerrln "gen-style-table: unknown item kind " + name
    ret 0
end

func cell(v: str): str:
    ret v == "-" ? "" : v
end

func flag(v: str): str:
    ret v == "yes" ? "true" : "false"
end

func quoted(v: str): str:
    ret str.Replace(v, "\"", "\\\"")
end

func banner(): str:
    text := io.ReadFile("std/gui/style/style.salam")
    cut := text.find("*/")
    ret text.substr(0, cut + 2) + "\n"
end

func main:
    kws := rows(KEYWORDS)
    props := rows(PROPERTIES)
    mut known := HashMap {} as HashMap<str, bool>
    each k in kws:
        known.put(k.get(1), true)
    end
    head := banner() + "\npackage style\n\n"
    mut names := head
    each i, k in kws:
        names += "@en \"KW_" + k.get(0) + "\"\n@fa \"" + k.get(3) + "\"\npub const KW_" + k.get(0) + " := " + (i + 1) + "\n\n"
    end
    names += "@en \"KEYWORD_COUNT\"\n@fa \"شمار\u200cواژه\u200cها\"\npub const KEYWORD_COUNT := " + (kws.len() + 1) + "\n\n"
    each i, p in props:
        names += "@en \"P_" + p.get(0) + "\"\n@fa \"ویژگی\u200c" + str.Replace(p.get(2), " ", "\u200c") + "\"\npub const P_" + p.get(0) + " := " + i + "\n\n"
    end
    names += "@en \"PROP_COUNT\"\n@fa \"شمار\u200cویژگی\u200cها\"\npub const PROP_COUNT := " + props.len() + "\n"
    mut table := head
    table += "func _kw_en(id: int): str:\n    switch id:\n"
    each i, k in kws:
        table += "        " + (i + 1) + ": ret \"" + k.get(1) + "\" end\n"
    end
    table += "    end\n    ret \"\"\nend\n\nfunc _kw_fa(id: int): str:\n    switch id:\n"
    each i, k in kws:
        table += "        " + (i + 1) + ": ret \"" + k.get(2) + "\" end\n"
    end
    table += "    end\n    ret \"\"\nend\n\nfunc _prop_info(id: int): PropInfo:\n    switch id:\n"
    mut bad := 0
    each i, p in props:
        words := cell(p.get(9))
        mut mask := 0
        each it in str.Split(cell(p.get(4)), " "):
            if it != "":
                mask |= item_bit(it)
            end
        end
        if words != "":
            mask |= item_bit("WORD")
            each w in str.Split(words, "|"):
                if not known.has(w):
                    printerrln "gen-style-table: " + p.get(1) + " uses the unknown keyword " + w
                    bad++
                end
            end
        end
        table += "        P_" + p.get(0) + ": ret PropInfo { id = " + i + ", name = \"" + p.get(1) + "\", fa = \"" + p.get(2) + "\", kind = KIND_" + p.get(3) + ", items = " + mask + ", min = " + p.get(5) + ", max = " + p.get(6) + ", low = " + p.get(7) + ", high = " + p.get(8) + ", words = \"" + words + "\", initial = \"" + quoted(p.get(10)) + "\", inherited = " + flag(p.get(11)) + ", animatable = " + flag(p.get(12)) + ", negative = " + flag(p.get(13)) + ", percent = " + flag(p.get(14)) + ", example = \"" + quoted(p.get(15)) + "\" } end\n"
    end
    table += "    end\n    ret PropInfo { id = -1 }\nend\n"
    if bad > 0:
        ret 1
    end
    io.WriteFile(NAMES_OUT, names)
    io.WriteFile(TABLE_OUT, table)
    println "wrote", NAMES_OUT, "and", TABLE_OUT + ":", kws.len(), "keywords,", props.len(), "properties"
    ret 0
end
