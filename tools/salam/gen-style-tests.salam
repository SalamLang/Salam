package main

import io
import str
import gui.style

const KEYWORDS := "tools/salam/style-keywords.tsv"
const PROPERTIES := "tools/salam/style-properties.tsv"

func rows(path: str): Vector<Vector<str>>:
    mut out := Vector {} as Vector<Vector<str>>
    lines := str.Split(io.ReadFile(path), "\n")
    each i, line in lines:
        if i == 0 or str.Trim(line) == "":
            continue
        end
        out.Push(str.Split(line, "\t"))
    end
    ret out
end

func banner(): str:
    text := io.ReadFile("std/gui/style/style.salam")
    ret text.Substr(0, text.Find("*/") + 2) + "\n\n"
end

func fa_digits(s: str): str:
    mut t := s
    each i, d in ["۰", "۱", "۲", "۳", "۴", "۵", "۶", "۷", "۸", "۹"]:
        t = str.Replace(t, "" + i, d)
    end
    t = str.Replace(t, ", ", "، ")
    t = str.Replace(t, "%", "٪")
    ret t
end

func en_value(ex: str): str:
    mut parts := Vector {} as Vector<str>
    each item in str.Split(ex, ", "):
        parts.Push(item == "end" ? "\"end\"" : item)
    end
    ret str.Join(parts, ", ")
end

func fa_color(item: str): str:
    names := ["red", "black", "white", "blue", "green", "yellow"]
    fas := ["قرمز", "سیاه", "سفید", "آبی", "سبز", "زرد"]
    each i, n in names:
        if item == n:
            ret fas[i]
        end
    end
    ret ""
end

func fa_hex_safe(item: str): str:
    mut out := ""
    mut in_hex := false
    mut in_quote := false
    each ch in item:
        if ch == "\"":
            in_quote = not in_quote
        end
        if ch == "#":
            in_hex = true
        else ch == " " or ch == "(" or ch == ")":
            in_hex = false
        end
        out += (in_hex or in_quote) ? ch : fa_digits(ch)
    end
    ret out
end

func fa_value(ex: str, kws: Vector<Vector<str>>): str:
    mut parts := Vector {} as Vector<str>
    each item in str.Split(ex, ", "):
        mut done := false
        each k in kws:
            if item == k.Get(1) and k.Get(2) != "":
                parts.Push(k.Get(2))
                done = true
                break
            end
        end
        if not done and fa_color(item) != "":
            parts.Push(fa_color(item))
            done = true
        end
        if not done:
            parts.Push(fa_hex_safe(item))
        end
    end
    ret str.Join(parts, "، ")
end

func main:
    kws := rows(KEYWORDS)
    props := rows(PROPERTIES)
    head := banner()
    mut made := 0
    each i, r in props:
        name := r.Get(1)
        fa := r.Get(2)
        ex := r.Get(15)
        konst := str.Lower(r.Get(0))
        if name == "end" or name == "blur" or name == "row span":
            continue
        end
        mut v := style.Value {}
        if not style.Parse(i, ex, v):
            printerrln "gen-style-tests: the example of " + name + " does not parse: " + ex
            ret 1
        end
        css := style.Css(i, v)
        mut en := head
        mut fat := head
        if css != "":
            en += "// EXPECT: " + css + ";\n// EXPECT: :hover { " + css + ";\n"
            fat += "// انتظار: " + css + ";\n// انتظار: :hover { " + css + ";\n"
        end
        en += "page:\n    box:\n        content = \"hi\"\n        " + name + " = " + en_value(ex) +
            "\n        hover " + name + " = " + en_value(ex) + "\n    end\nend\n"
        fav := fa_value(ex, kws)
        fat += "صفحه:\n    جعبه:\n        محتوا = \"سلام\"\n        " + fa + " = " + fav +
            "\n        اشاره " + fa + " = " + fav + "\n    پایان\nپایان\n"
        io.WriteFile("tests/en/page/style/std_" + konst + ".salam", en)
        io.WriteFile("tests/fa/page/style/std_" + konst + ".salam", fat)
        bad := "zzz(1)"
        eb := head + "// EXPECT: E018\n// EXPECT-MSG: invalid value for '" + name +
            "'\npage:\n    box: content = \"hi\" " + name + " = " + bad + " end\nend\n"
        fb := head +
            "// انتظار: خطا۰۱۸\n// انتظار پیام: مقدار نامعتبر برای\nصفحه:\n    جعبه: محتوا = \"سلام\" " +
            fa + " = " + bad + " پایان\nپایان\n"
        sb := head + "// EXPECT: E018\n// EXPECT-MSG: invalid value for 'hover_" + name +
            "'\npage:\n    box: content = \"hi\" hover " + name + " = " + bad + " end\nend\n"
        io.WriteFile("tests/en/page/errors/std_" + konst + "_bad.salam", eb)
        io.WriteFile("tests/fa/page/errors/std_" + konst + "_bad.salam", fb)
        io.WriteFile("tests/en/page/errors/std_hover_" + konst + "_bad.salam", sb)
        made++
    end
    println "wrote tests for", made, "properties"
    ret 0
end
