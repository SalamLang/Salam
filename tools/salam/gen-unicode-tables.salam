.Saurashtra=خط سوراشترا|Script.KayahLi=خط کایا لی|Script.Rejang=خط رجنگ|Script.Lycian=خط لیکیایی|Script.Carian=خط کاریایی|" + "Script.Lydian=خط لیدیایی|Script.Cham=خط چام|Script.TaiTham=خط تای تام|Script.TaiViet=خط تای ویت|Script.Avestan=خط اوستایی|Script.EgyptianHieroglyphs=خط هیروگلیف مصری|Script.Samaritan=خط سامری|Script.Lisu=خط لیسو|Script.Bamum=خط بامون|Script.Javanese=خط جاوه‌ای|Script.MeeteiMayek=خط میتی مایک|" + "Script.ImperialAramaic=خط آرامی شاهنشاهی|Script.OldSouthArabian=خط عربی جنوبی کهن|Script.InscriptionalParthian=خط پارتی کتیبه‌ای|Script.InscriptionalPahlavi=خط پهلوی کتیبه‌ای|Script.OldTurkic=خط ترکی کهن|Script.Kaithi=خط کیتی|Script.Batak=خط باتاک|Script.Brahmi=خط براهمی|Script.Mandaic=خط مندایی|" + "Script.Chakma=خط چاکما|Script.MeroiticCursive=خط مروئی شکسته|Script.MeroiticHieroglyphs=خط هیروگلیف مروئی|Script.Miao=خط میائو|Script.Sharada=خط شارادا|Script.SoraSompeng=خط سورا سومپنگ|Script.Takri=خط تاکری|Script.CaucasianAlbanian=خط آلبانی قفقاز|Script.BassaVah=خط باسا وا|" + "Script.Duployan=خط دوپلویه|Script.Elbasan=خط الباسان|Script.Grantha=خط گرانتا|Script.PahawhHmong=خط پاهاو همونگ|Script.Khojki=خط خوجکی|Script.LinearA=خط خطی الف|Script.Mahajani=خط مهاجنی|Script.Manichaean=خط مانوی|Script.MendeKikakui=خط منده کیکاکویی|Script.Modi=خط مودی|Script.Mro=خط مرو|" + "Script.OldNorthArabian=خط عربی شمالی کهن|Script.Nabataean=خط نبطی|Script.Palmyrene=خط پالمیری|Script.PauCinHau=خط پائو چین هائو|Script.OldPermic=خط پرمی کهن|Script.PsalterPahlavi=خط پهلوی زبوری|Script.Siddham=خط سیدهام|Script.Khudawadi=خط خداوادی|Script.Tirhuta=خط تیرهوتا|" + "Script.WarangCiti=خط وارنگ چیتی|Script.Ahom=خط آهوم|Script.AnatolianHieroglyphs=خط هیروگلیف آناتولی|Script.Hatran=خط حضری|Script.Multani=خط مولتانی|Script.OldHungarian=خط مجاری کهن|Script.SignWriting=خط نشانه‌نویسی|Script.Adlam=خط ادلم|Script.Bhaiksuki=خط بهایکسوکی|Script.Marchen=خط مارچن|" + "Script.Newa=خط نوا|Script.Osage=خط اوسیج|Script.Tangut=خط تانگوت|Script.MasaramGondi=خط ماسارام گوندی|Script.Nushu=خط نوشو|Script.Soyombo=خط سویومبو|Script.ZanabazarSquare=خط مربعی زنابازار|Script.Dogra=خط دوگرا|Script.GunjalaGondi=خط گونجالا گوندی|Script.Makasar=خط ماکاسار|" + "Script.Medefaidrin=خط مدفایدرین|Script.HanifiRohingya=خط حنیفی روهینگیا|Script.Sogdian=خط سغدی|Script.OldSogdian=خط سغدی کهن|Script.Elymaic=خط عیلامی|Script.Nandinagari=خط ناندیناگری|Script.NyiakengPuachueHmong=خط نیاکنگ پواچو همونگ|Script.Wancho=خط وانچو|Script.Chorasmian=خط خوارزمی|" + "Script.DivesAkuru=خط دیوس آکورو|Script.KhitanSmallScript=خط ختایی کوچک|Script.Yezidi=خط ایزدی|Script.CyproMinoan=خط قبرسی مینوسی|Script.OldUyghur=خط اویغوری کهن|Script.Tangsa=خط تانگسا|Script.Toto=خط توتو|Script.Vithkuqi=خط ویتکوچی|Script.Kawi=خط کاوی|Script.NagMundari=خط ناگ موندری|" + "Script.Garay=خط گارای|Script.GurungKhema=خط گورونگ خما|Script.KiratRai=خط کیرات رای|Script.OlOnal=خط اول اونال|Script.Sunuwar=خط سونوار|Script.Todhri=خط تودری|Script.TuluTigalari=خط تولو تیگالاری|"
    each pair in all.Split("|"):
        eqpos := pair.Find("=")
        if eqpos > 0:
            m.Put(pair.Substr(0, eqpos), pair.Substr(eqpos + 1, pair.Len() - eqpos - 1))
        end
    end
    ret m
end

func index_of_names(names: Vector<str>): HashMap<str, int>:
    mut m := HashMap {} as HashMap<str, int>
    mut i := 0
    each n in names:
        m.Put(n, i)
        i++
    end
    ret m
end

func bidi_long(): HashMap<str, str>:
    mut m := HashMap {} as HashMap<str, str>
    m.Put("Left_To_Right", "L")
    m.Put("Right_To_Left", "R")
    m.Put("Arabic_Letter", "AL")
    m.Put("European_Number", "EN")
    m.Put("European_Separator", "ES")
    m.Put("European_Terminator", "ET")
    m.Put("Arabic_Number", "AN")
    m.Put("Common_Separator", "CS")
    m.Put("Nonspacing_Mark", "NSM")
    m.Put("Boundary_Neutral", "BN")
    m.Put("Paragraph_Separator", "B")
    m.Put("Segment_Separator", "S")
    m.Put("White_Space", "WS")
    m.Put("Other_Neutral", "ON")
    ret m
end

func remote_files(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("UnicodeData.txt")
    v.Push("CaseFolding.txt")
    v.Push("PropList.txt")
    v.Push("DerivedCoreProperties.txt")
    v.Push("DerivedNormalizationProps.txt")
    v.Push("auxiliary/GraphemeBreakProperty.txt")
    v.Push("emoji/emoji-data.txt")
    v.Push("extracted/DerivedBidiClass.txt")
    v.Push("BidiBrackets.txt")
    v.Push("Scripts.txt")
    ret v
end

func local_name(remote: str): str:
    at := str.LastIndex(remote, "/")
    if at < 0: ret remote end
    ret remote.Substr(at + 1, remote.Len() - at - 1)
end

func ucd_path(name: str): str:
    ret CACHE + "/" + name
end

func fetch():
    _mk := os.MkdirAll(CACHE)
    each remote in remote_files():
        url := UCD_BASE + "/" + remote
        io.EPrintln("fetching " + url)
        r := http.Get(url)
        if r.err.Len() > 0:
            die("fetch failed for " + url + ": " + r.err)
        end
        if r.status != 200:
            die("fetch failed for " + url + ": HTTP " + si(r.status))
        end
        _n := os.WriteFile(ucd_path(local_name(remote)), r.body)
    end
end

func raw_lines(name: str): Vector<str>:
    path := ucd_path(name)
    if os.Exists(path) == false:
        io.EPrintln("missing " + path)
        die("Run with --fetch to download the UCD " + UCD_VERSION + " files.")
    end
    ret str.Split(os.ReadFile(path), "\n")
end

func read_lines(name: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    each line in raw_lines(name):
        mut t := line
        h := t.Find("#")
        if h >= 0:
            t = t.Substr(0, h)
        end
        t = str.Trim(t)
        if t.Len() > 0:
            out.Push(t)
        end
    end
    ret out
end

func fields(line: str, delim: str): Vector<str>:
    ret str.Split(line, delim)
end

func trimmed_fields(line: str, delim: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    each f in str.Split(line, delim):
        out.Push(str.Trim(f))
    end
    ret out
end

func hex_list(s: str): Vector<int>:
    mut out := Vector {} as Vector<int>
    each tok in str.Fields(s):
        out.Push(hex(tok))
    end
    ret out
end

func span_lo(spec: str): int:
    at := spec.Find("..")
    if at < 0: ret hex(spec) end
    ret hex(spec.Substr(0, at))
end

func span_hi(spec: str): int:
    at := spec.Find("..")
    if at < 0: ret hex(spec) end
    ret hex(spec.Substr(at + 2, spec.Len() - at - 2))
end

func merge_cat_ranges(ranges &: Vector<Rng>): Vector<Rng>:
    sort.SortBy(ranges, (a: Rng, b: Rng): ret less_rng(a, b) end)
    mut out := Vector {} as Vector<Rng>
    each r in ranges:
        if out.Len() > 0:
            last := out.Get(out.Len() - 1)
            if last.id == r.id and last.hi + 1 == r.lo:
                out.Set(out.Len() - 1, Rng { lo = last.lo, hi = r.hi, id = r.id })
                continue
            end
        end
        out.Push(r)
    end
    ret out
end

func parse_unicode_data(
    cat_id: HashMap<str, int>, cats &: Vector<Rng>, upper &: IntMap, lower &: IntMap, title &: IntMap, ccc &: IntMap, canon &: SeqMap, compat &: SeqMap
):
    mut ranges := Vector {} as Vector<Rng>
    mut pending_cp := -1
    mut pending_cat := ""

    each line in read_lines("UnicodeData.txt"):
        f := fields(line, ";")
        cp := hex(f.Get(0))
        name := f.Get(1)
        cat := f.Get(2)
        if cat_id.Has(cat) == false:
            die("unknown general category " + cat + " at U+" + hex4(cp))
        end
        cid := cat_id.Get(cat)

        if str.EndsWith(name, ", First>"):
            pending_cp = cp
            pending_cat = cat
            continue
        end
        if str.EndsWith(name, ", Last>"):
            if pending_cp < 0 or pending_cat != cat:
                die("unpaired range terminator at U+" + hex4(cp))
            end
            ranges.Push(Rng { lo = pending_cp, hi = cp, id = cid })
            pending_cp = -1
            pending_cat = ""
            continue
        end

        ranges.Push(Rng { lo = cp, hi = cp, id = cid })

        if f.Get(3) != "0":
            imap_put(ccc, cp, str.ToInt(f.Get(3)))
        end
        d := f.Get(5)
        if d.Len() > 0:
            if str.StartsWith(d, "<"):
                gt_at := d.Find(">")
                mut vals := hex_list(d.Substr(gt_at + 1, d.Len() - gt_at - 1))
                seq_put(compat, cp, vals)
            else:
                mut vals := hex_list(d)
                seq_put(canon, cp, vals)
            end
        end
        if f.Get(12).Len() > 0:
            imap_put(upper, cp, hex(f.Get(12)))
        end
        if f.Get(13).Len() > 0:
            imap_put(lower, cp, hex(f.Get(13)))
        end
        if f.Get(14).Len() > 0:
            imap_put(title, cp, hex(f.Get(14)))
        end
    end

    if pending_cp >= 0:
        die("unterminated range starting at U+" + hex4(pending_cp))
    end

    merged := merge_cat_ranges(ranges)
    each r in merged:
        cats.Push(r)
    end
end

func expand_cp(cp: int, t &: SeqMap, out &: Vector<int>, depth: int):
    if depth > 32:
        die("decomposition of U+" + hex4(cp) + " does not terminate")
    end
    if t.off.Has(cp) == false:
        out.Push(cp)
        ret
    end
    o := t.off.Get(cp)
    n := t.len.Get(cp)
    repeat n in i:
        expand_cp(t.seq.Get(o + i), t, out, depth + 1)
    end
end

func expand_table(src &: SeqMap, table &: SeqMap, dst &: SeqMap):
    ks := seq_sorted_keys(src)
    each cp in ks:
        mut out := Vector {} as Vector<int>
        expand_cp(cp, table, out, 0)
        seq_put(dst, cp, out)
    end
end

func composition_pairs(canon &: SeqMap, excluded &: Vector<bool>): Vector<Comp>:
    mut out := Vector {} as Vector<Comp>
    each cp in canon.keys:
        n := canon.len.Get(cp)
        if n != 2: continue end
        if excluded.Get(cp): continue end
        o := canon.off.Get(cp)
        out.Push(Comp { a = canon.seq.Get(o), b = canon.seq.Get(o + 1), cp = cp })
    end
    sort.SortBy(out, (x: Comp, y: Comp): ret less_comp(x, y) end)
    ret out
end

func merge_adjacent(ranges &: Vector<Rng>, gap_ok: bool): Vector<Rng>:
    sort.SortBy(ranges, (a: Rng, b: Rng): ret less_rng(a, b) end)
    mut out := Vector {} as Vector<Rng>
    each r in ranges:
        if out.Len() > 0:
            last := out.Get(out.Len() - 1)
            mut joins := false
            if last.id == r.id:
                if gap_ok:
                    joins = last.hi + 1 >= r.lo
                else:
                    joins = last.hi + 1 == r.lo
                end
            end
            if joins:
                mut hi := r.hi
                if gap_ok and last.hi > hi: hi = last.hi end
                out.Set(out.Len() - 1, Rng { lo = last.lo, hi = hi, id = r.id })
                continue
            end
        end
        out.Push(r)
    end
    ret out
end

func parse_scripts(names &: Vector<str>): Vector<Rng>:
    names.Push("Unknown")
    mut index := HashMap {} as HashMap<str, int>
    index.Put("Unknown", 0)
    mut ranges := Vector {} as Vector<Rng>
    each line in read_lines("Scripts.txt"):
        f := trimmed_fields(line, ";")
        if f.Len() < 2: continue end
        nm := f.Get(1)
        if index.Has(nm) == false:
            index.Put(nm, names.Len())
            names.Push(nm)
        end
        ranges.Push(Rng { lo = span_lo(f.Get(0)), hi = span_hi(f.Get(0)), id = index.Get(nm) })
    end
    ret merge_adjacent(ranges, true)
end

func parse_bidi_class(bidi_id: HashMap<str, int>): Vector<Rng>:
    longs := bidi_long()
    mut bc := Vector {} as Vector<int>
    repeat MAX_CP in _:
        bc.Push(-1)
    end

    mut defaults := 0
    each line in raw_lines("DerivedBidiClass.txt"):
        at := line.Find("@missing:")
        if at < 0: continue end
        spec := str.Trim(line.Substr(at + 9, line.Len() - at - 9))
        f := trimmed_fields(spec, ";")
        if f.Len() < 2: continue end
        nm := f.Get(1)
        if longs.Has(nm) == false:
            die("unknown Bidi_Class default '" + nm + "'")
        end
        id := bidi_id.Get(longs.Get(nm))
        lo := span_lo(f.Get(0))
        hi := span_hi(f.Get(0))
        mut cp := lo
        until cp <= hi:
            bc.Set(cp, id)
            cp++
        end
        defaults++
    end
    if defaults == 0:
        die("DerivedBidiClass.txt has no @missing defaults")
    end

    each line in read_lines("DerivedBidiClass.txt"):
        f := trimmed_fields(line, ";")
        if f.Len() < 2: continue end
        nm := f.Get(1)
        if bidi_id.Has(nm) == false:
            die("unknown Bidi_Class '" + nm + "'")
        end
        id := bidi_id.Get(nm)
        lo := span_lo(f.Get(0))
        hi := span_hi(f.Get(0))
        mut cp := lo
        until cp <= hi:
            bc.Set(cp, id)
            cp++
        end
    end

    l_id := bidi_id.Get("L")
    mut out := Vector {} as Vector<Rng>
    mut cp := 0
    until cp < MAX_CP:
        v := bc.Get(cp)
        if v < 0 or v == l_id:
            cp++
            continue
        end
        mut end_cp := cp
        until end_cp + 1 < MAX_CP and bc.Get(end_cp + 1) == v:
            end_cp++
        end
        out.Push(Rng { lo = cp, hi = end_cp, id = v })
        cp = end_cp + 1
    end
    ret out
end

func parse_brackets(pbt_id: HashMap<str, int>): Vector<Rng>:
    mut out := Vector {} as Vector<Rng>
    each line in read_lines("BidiBrackets.txt"):
        f := trimmed_fields(line, ";")
        if f.Len() < 3: continue end
        k := f.Get(2)
        mut kind := -1
        if k == "o": kind = pbt_id.Get("Open") end
        if k == "c": kind = pbt_id.Get("Close") end
        if kind < 0:
            die("unknown Bidi_Paired_Bracket_Type '" + k + "'")
        end
        out.Push(Rng { lo = hex(f.Get(0)), hi = hex(f.Get(1)), id = kind })
    end
    sort.SortBy(out, (a: Rng, b: Rng): ret less_rng(a, b) end)
    ret out
end

func parse_incb(incb_id: HashMap<str, int>): Vector<Rng>:
    mut ranges := Vector {} as Vector<Rng>
    each line in read_lines("DerivedCoreProperties.txt"):
        f := trimmed_fields(line, ";")
        if f.Len() < 3: continue end
        if f.Get(1) != "InCB": continue end
        nm := f.Get(2)
        if incb_id.Has(nm) == false:
            die("unknown Indic_Conjunct_Break value '" + nm + "'")
        end
        ranges.Push(Rng { lo = span_lo(f.Get(0)), hi = span_hi(f.Get(0)), id = incb_id.Get(nm) })
    end
    ret merge_adjacent(ranges, true)
end

func parse_prop(filename: str, wanted: str): Vector<Span>:
    mut out := Vector {} as Vector<Span>
    each line in read_lines(filename):
        f := trimmed_fields(line, ";")
        if f.Len() < 2: continue end
        if f.Get(1) != wanted: continue end
        out.Push(Span { lo = span_lo(f.Get(0)), hi = span_hi(f.Get(0)) })
    end
    sort.SortBy(out, (a: Span, b: Span): ret less_pair(a, b) end)
    mut merged := Vector {} as Vector<Span>
    each p in out:
        if merged.Len() > 0:
            last := merged.Get(merged.Len() - 1)
            if last.hi + 1 >= p.lo:
                mut hi := p.hi
                if last.hi > hi: hi = last.hi end
                merged.Set(merged.Len() - 1, Span { lo = last.lo, hi = hi })
                continue
            end
        end
        merged.Push(p)
    end
    ret merged
end

func parse_grapheme_break(gcb_id: HashMap<str, int>): Vector<Rng>:
    mut ranges := Vector {} as Vector<Rng>
    each line in read_lines("GraphemeBreakProperty.txt"):
        f := trimmed_fields(line, ";")
        if f.Len() < 2: continue end
        nm := f.Get(1)
        if nm == "LV" or nm == "LVT": continue end
        if gcb_id.Has(nm) == false:
            die("unknown Grapheme_Cluster_Break class '" + nm + "'")
        end
        ranges.Push(Rng { lo = span_lo(f.Get(0)), hi = span_hi(f.Get(0)), id = gcb_id.Get(nm) })
    end
    pict := gcb_id.Get("Extended_Pictographic")
    each p in parse_prop("emoji-data.txt", "Extended_Pictographic"):
        ranges.Push(Rng { lo = p.lo, hi = p.hi, id = pict })
    end

    sort.SortBy(ranges, (a: Rng, b: Rng): ret less_rng(a, b) end)
    mut i := 1
    until i < ranges.Len():
        if ranges.Get(i).lo <= ranges.Get(i - 1).hi:
            die("overlapping grapheme break ranges at U+" + hex4(ranges.Get(i).lo))
        end
        i++
    end
    ret merge_adjacent(ranges, false)
end

func parse_case_folding(simple &: IntMap, full &: SeqMap):
    each line in read_lines("CaseFolding.txt"):
        f := trimmed_fields(line, ";")
        cp := hex(f.Get(0))
        status := f.Get(1)
        mut cps := hex_list(f.Get(2))
        if status == "C" or status == "S":
            if cps.Len() != 1:
                die("non-simple mapping for status " + status + " at U+" + hex4(cp))
            end
            imap_put(simple, cp, cps.Get(0))
        end
        if status == "C" or status == "F":
            if cps.Len() > 1:
                seq_put(full, cp, cps)
            end
        end
    end
end

func value_ranges(t &: IntMap): Vector<Rng>:
    ks := sorted_keys(t)
    mut out := Vector {} as Vector<Rng>
    mut i := 0
    n := ks.Len()
    until i < n:
        cp := ks.Get(i)
        v := t.m.Get(cp)
        mut j := i
        until j + 1 < n and ks.Get(j + 1) == ks.Get(j) + 1 and t.m.Get(ks.Get(j + 1)) == v:
            j++
        end
        out.Push(Rng { lo = cp, hi = ks.Get(j), id = v })
        i = j + 1
    end
    ret out
end

func case_ranges(t &: IntMap): Vector<CaseRun>:
    ks := sorted_keys(t)
    mut out := Vector {} as Vector<CaseRun>
    mut i := 0
    n := ks.Len()
    until i < n:
        cp := ks.Get(i)
        delta := t.m.Get(cp) - cp
        mut best_end := i
        mut best_stride := 1
        mut stride := 1
        until stride <= 2:
            mut j := i
            until j + 1 < n and ks.Get(j + 1) == ks.Get(j) + stride and t.m.Get(ks.Get(j + 1)) - ks.Get(j + 1) == delta:
                j++
            end
            if j > best_end:
                best_end = j
                best_stride = stride
            end
            stride++
        end
        out.Push(CaseRun { lo = cp, hi = ks.Get(best_end), stride = best_stride, delta = delta })
        i = best_end + 1
    end
    ret out
end

func e_raw(e &: Emitter, text: str):
    e.parts.Push(text)
end

func e_blank(e &: Emitter):
    e.parts.Push("")
end

func e_const(e &: Emitter, fa: HashMap<str, str>, key: str, name: str, value: str):
    if not fa.Has(key):
        printerrln "gen-unicode-tables: no Persian name for " + key + "; add it to persian_names"
        os.Exit(1)
    end
    e_raw(e, "@en \"" + name + "\"")
    e_raw(e, "@fa \"" + fa.Get(key) + "\"")
    e_raw(e, "pub const " + name + " := " + value)
end

func e_comment(e &: Emitter, text: str):
    mut body := text
    until str.StartsWith(body, "\n"):
        body = body.Substr(1, body.Len() - 1)
    end
    until str.EndsWith(body, "\n"):
        body = body.Substr(0, body.Len() - 1)
    end
    each line in str.Split(body, "\n"):
        e.parts.Push(str.TrimRight("// " + line))
    end
end

func e_ints(e &: Emitter, name: str, values &: Vector<int>, per_line: int):
    if values.Len() == 0:
        die("refusing to emit empty table " + name)
    end
    e.parts.Push("const " + name + " := [")
    mut i := 0
    until i < values.Len():
        mut row := ""
        mut j := i
        until j < values.Len() and j < i + per_line:
            if j > i: row += ", " end
            row += si(values.Get(j))
            j++
        end
        e.parts.Push("    " + row)
        i += per_line
    end
    e.parts.Push("]")
end

func e_strings(e &: Emitter, name: str, values &: Vector<str>, per_line: int):
    if values.Len() == 0:
        die("refusing to emit empty table " + name)
    end
    e.parts.Push("const " + name + " := [")
    mut i := 0
    until i < values.Len():
        mut row := ""
        mut j := i
        until j < values.Len() and j < i + per_line:
            if j > i: row += ", " end
            row = row + "\"" + values.Get(j) + "\""
            j++
        end
        e.parts.Push("    " + row)
        i += per_line
    end
    e.parts.Push("]")
end

func e_text(e &: Emitter): str:
    ret str.TrimRight(str.Join(e.parts, "\n")) + "\n"
end

func banner(): str:
    mut b := str.NewBuilder()
    str.BufAppend(b, "/*\n")
    str.BufAppend(b, " * Salam Programming Language (2024-2026)\n")
    str.BufAppend(b, " *\n")
    str.BufAppend(b, " *   +-------------------+\n")
    str.BufAppend(b, " *   |     S A L A M     |\n")
    str.BufAppend(b, " *   +-------------------+\n")
    str.BufAppend(b, " *\n")
    str.BufAppend(b, " * Designed by Seyyed Ali Mohammadiyeh and the Salam Team\n")
    str.BufAppend(b, " * Born from a decade of language design experience (since 2018)\n")
    str.BufAppend(b, " *\n")
    str.BufAppend(b, " * Repository: https://github.com/SalamLang/Salam\n")
    str.BufAppend(b, " *\n")
    str.BufAppend(b, " */\n")
    ret str.BufStr(b)
end

func col_lo(rs &: Vector<Rng>): Vector<int>:
    mut v := Vector {} as Vector<int>
    each r in rs: v.Push(r.lo) end
    ret v
end

func col_hi(rs &: Vector<Rng>): Vector<int>:
    mut v := Vector {} as Vector<int>
    each r in rs: v.Push(r.hi) end
    ret v
end

func col_id(rs &: Vector<Rng>): Vector<int>:
    mut v := Vector {} as Vector<int>
    each r in rs: v.Push(r.id) end
    ret v
end

func pair_lo(ps &: Vector<Span>): Vector<int>:
    mut v := Vector {} as Vector<int>
    each p in ps: v.Push(p.lo) end
    ret v
end

func pair_hi(ps &: Vector<Span>): Vector<int>:
    mut v := Vector {} as Vector<int>
    each p in ps: v.Push(p.hi) end
    ret v
end

func emit_case_block(e &: Emitter, t &: IntMap, prefix: str, human: str):
    rs := case_ranges(t)
    e_comment(
        e, human + ": " + si(t.keys.Len()) + " mappings compressed into " + si(rs.Len()) + " (lo, hi, stride, delta) runs.\n" + "A code point cp in a run maps to cp + delta when\n" + "(cp - lo) is a multiple of stride."
    )
    mut lo := Vector {} as Vector<int>
    mut hi := Vector {} as Vector<int>
    mut sd := Vector {} as Vector<int>
    mut dl := Vector {} as Vector<int>
    each r in rs:
        lo.Push(r.lo) hi.Push(r.hi) sd.Push(r.stride) dl.Push(r.delta)
    end
    e_ints(e, prefix + "_LO", lo, 8)
    e_blank(e)
    e_ints(e, prefix + "_HI", hi, 8)
    e_blank(e)
    e_ints(e, prefix + "_STRIDE", sd, 8)
    e_blank(e)
    e_ints(e, prefix + "_DELTA", dl, 8)
    e_blank(e)
end

func emit_seq_block(e &: Emitter, t &: SeqMap, prefix: str, human: str, extra: str):
    ks := seq_sorted_keys(t)
    mut cps := Vector {} as Vector<int>
    mut offs := Vector {} as Vector<int>
    mut lens := Vector {} as Vector<int>
    mut seq := Vector {} as Vector<int>
    mut maxlen := 0
    each cp in ks:
        o := t.off.Get(cp)
        n := t.len.Get(cp)
        cps.Push(cp)
        offs.Push(seq.Len())
        lens.Push(n)
        if n > maxlen: maxlen = n end
        repeat n in i:
            seq.Push(t.seq.Get(o + i))
        end
    end
    e_comment(
        e, human + " decomposition: " + si(ks.Len()) + " code points expanding to " + si(seq.Len()) + " in total, at\n" + "most " + si(maxlen) + " each.\n" + "\n" + extra + "\n" + "\n" + "Hangul is not in this table. Its " + si(HANGUL_SCOUNT) + " syllables decompose by\n" + "arithmetic instead - see the Hangul constants in unicode.salam."
    )
    e_ints(e, prefix + "_CP", cps, 8)
    e_blank(e)
    e_ints(e, prefix + "_OFF", offs, 8)
    e_blank(e)
    e_ints(e, prefix + "_LEN", lens, 8)
    e_blank(e)
    e_ints(e, prefix + "_SEQ", seq, 8)
    e_blank(e)
end

func usage():
    println "usage: salam run tools/salam/gen-unicode-tables.salam [fetch] [out=PATH]"
    println ""
    println "  fetch      download the UCD", UCD_VERSION, "files into", CACHE, "first"
    println "  out=PATH   write somewhere other than", OUT
    println ""
    println "  The modes are bare words, not --flags: `salam run` reads anything"
    println "  starting with \"-\" as one of its own build options. A compiled"
    println "  binary accepts --fetch and --out=PATH as well."
end

func main:
    args := os.Args()
    defer args.Free()
    mut want_fetch := false
    mut out_path := OUT
    mut i := 1
    until i < args.Len():
        a := args.Get(i)
        if a == "fetch" or a == "--fetch":
            want_fetch = true
        else:
            if str.StartsWith(a, "out="):
                out_path = a.Substr(4, a.Len() - 4)
            else:
                if str.StartsWith(a, "--out="):
                    out_path = a.Substr(6, a.Len() - 6)
                else:
                    usage()
                    ret 1
                end
            end
        end
        i++
    end

    if want_fetch:
        fetch()
    end

    mut cat_names := categories()
    cat_id := index_of_names(cat_names)
    gcb_names := grapheme_classes()
    gcb_id := index_of_names(gcb_names)
    incb_names := incb_classes()
    incb_id := index_of_names(incb_names)
    bidi_names := bidi_classes()
    bidi_id := index_of_names(bidi_names)
    pbt_names := pbt_classes()
    pbt_id := index_of_names(pbt_names)

    mut cats := Vector {} as Vector<Rng>
    mut upper := IntMap {}
    mut lower := IntMap {}
    mut title := IntMap {}
    mut ccc := IntMap {}
    mut canon := SeqMap {}
    mut compat := SeqMap {}
    parse_unicode_data(cat_id, cats, upper, lower, title, ccc, canon, compat)

    mut fold_simple := IntMap {}
    mut fold_full := SeqMap {}
    parse_case_folding(fold_simple, fold_full)

    mut spaces := parse_prop("PropList.txt", "White_Space")
    mut alpha := parse_prop("DerivedCoreProperties.txt", "Alphabetic")

    mut excluded := Vector {} as Vector<bool>
    repeat MAX_CP in _:
        excluded.Push(false)
    end
    each p in parse_prop("DerivedNormalizationProps.txt", "Full_Composition_Exclusion"):
        mut cp := p.lo
        until cp <= p.hi:
            excluded.Set(cp, true)
            cp++
        end
    end

    mut both := SeqMap {}
    each cp in canon.keys:
        o := canon.off.Get(cp)
        n := canon.len.Get(cp)
        mut vals := Vector {} as Vector<int>
        repeat n in k:
            vals.Push(canon.seq.Get(o + k))
        end
        seq_put(both, cp, vals)
    end
    each cp in compat.keys:
        o := compat.off.Get(cp)
        n := compat.len.Get(cp)
        mut vals := Vector {} as Vector<int>
        repeat n in k:
            vals.Push(compat.seq.Get(o + k))
        end
        seq_put(both, cp, vals)
    end

    mut full_canon := SeqMap {}
    expand_table(canon, canon, full_canon)
    mut full_compat := SeqMap {}
    expand_table(both, both, full_compat)

    comp := composition_pairs(canon, excluded)
    mut gcb := parse_grapheme_break(gcb_id)
    mut incb := parse_incb(incb_id)
    mut bidi := parse_bidi_class(bidi_id)
    mut brackets := parse_brackets(pbt_id)
    mut script_names := Vector {} as Vector<str>
    mut scripts := parse_scripts(script_names)

    fa := persian_names()
    mut e := Emitter {}
    e_raw(e, banner())
    e_blank(e)
    e_comment(
        e, "GENERATED FILE - DO NOT EDIT.\n" + "\n" + "Produced by tools/salam/gen-unicode-tables.salam from the Unicode\n" + "Character Database version " + UCD_VERSION + ". To change anything here, edit that\n" + "script and re-run it; hand edits are lost on the next regeneration.\n" + "\n" + "The lookup functions that read these tables live in unicode.salam.\n" + "Every table is sorted by its first column so all of them can be\n" + "searched with the same binary search."
    )
    e_blank(e)
    e_raw(e, "package unicode")
    e_blank(e)

    e_comment(
        e, "The Unicode version these tables were generated from, as a string so\n" + "a program can report it without the compiler folding it into a number."
    )
    e_const(e, fa, "Version", "Version", "\"" + UCD_VERSION + "\"")
    e_blank(e)

    mut max_fold := 0
    each cp in fold_full.keys:
        n := fold_full.len.Get(cp)
        if n > max_fold: max_fold = n end
    end
    e_comment(
        e, "The longest full case fold in this version, in code points. A buffer\n" + "sized for this can hold the fold of any single code point."
    )
    e_const(e, fa, "MaxFoldLen", "MaxFoldLen", si(max_fold))
    e_blank(e)

    e_comment(
        e, "General category ids. Categories sharing a first letter are numbered\n" + "consecutively so that the group predicates in unicode.salam reduce to\n" + "a range check on the id. CatCn (unassigned) is last and is what\n" + "Category returns for any code point not covered by _CAT_LO/_CAT_HI."
    )
    each nm in cat_names:
        e_const(e, fa, "Cat." + nm, "Cat" + nm, si(cat_id.Get(nm)))
    end
    e_blank(e)

    e_comment(e, "Two-letter category names, indexed by the ids above.")
    e_strings(e, "_CAT_NAMES", cat_names, 6)
    e_blank(e)

    cn := cat_id.Get("Cn")
    mut assigned := Vector {} as Vector<Rng>
    each r in cats:
        if r.id != cn: assigned.Push(r) end
    end
    e_comment(
        e, "Assigned code point ranges and their general category, sorted and\n" + "non-overlapping. Unassigned code points are simply absent: " + si(assigned.Len()) + " ranges\n" + "cover the whole of Unicode " + UCD_VERSION + ", which is far smaller than storing a\n" + "category for each of the " + si(MAX_CP) + " code points in the space."
    )
    e_ints(e, "_CAT_LO", col_lo(assigned), 8)
    e_blank(e)
    e_ints(e, "_CAT_HI", col_hi(assigned), 8)
    e_blank(e)
    e_ints(e, "_CAT_ID", col_id(assigned), 8)
    e_blank(e)

    emit_case_block(e, upper, "_UP", "Simple uppercase")
    emit_case_block(e, lower, "_LOW", "Simple lowercase")
    emit_case_block(e, title, "_TITLE", "Simple titlecase")
    emit_case_block(e, fold_simple, "_FOLD", "Simple case folding")

    ff_keys := seq_sorted_keys(fold_full)
    mut ff_cp := Vector {} as Vector<int>
    mut ff_off := Vector {} as Vector<int>
    mut ff_len := Vector {} as Vector<int>
    mut ff_seq := Vector {} as Vector<int>
    each cp in ff_keys:
        o := fold_full.off.Get(cp)
        n := fold_full.len.Get(cp)
        ff_cp.Push(cp)
        ff_off.Push(ff_seq.Len())
        ff_len.Push(n)
        repeat n in k:
            ff_seq.Push(fold_full.seq.Get(o + k))
        end
    end
    e_comment(
        e, "Full case folding for the " + si(ff_keys.Len()) + " code points whose fold is longer than one\n" + "code point - German sharp s folds to \"ss\", the ligatures fold to their\n" + "component letters, and a handful of Greek and Armenian forms expand\n" + "similarly. These are why case-insensitive comparison cannot be done\n" + "byte for byte or even code point for code point: the two sides can\n" + "differ in length.\n" + "\n" + "The expansions are code points rather than strings so that this\n" + "package stays free of any string dependency - std/str imports\n" + "std/unicode, so the arrow cannot point back. _FOLDF_CP is the sorted\n" + "key column; _FOLDF_OFF and _FOLDF_LEN slice the expansion out of the\n" + "flattened _FOLDF_SEQ."
    )
    e_ints(e, "_FOLDF_CP", ff_cp, 8)
    e_blank(e)
    e_ints(e, "_FOLDF_OFF", ff_off, 8)
    e_blank(e)
    e_ints(e, "_FOLDF_LEN", ff_len, 8)
    e_blank(e)
    e_ints(e, "_FOLDF_SEQ", ff_seq, 8)
    e_blank(e)

    e_comment(
        e, "The White_Space property from PropList.txt (" + si(spaces.Len()) + " ranges). This is the\n" + "authoritative answer to \"is this a space\" and is deliberately not the\n" + "same as \"category Z\": it adds the ASCII controls tab through carriage\n" + "return and NEL, and it excludes ZERO WIDTH NON-JOINER and friends,\n" + "which are format characters rather than spaces."
    )
    e_ints(e, "_WS_LO", pair_lo(spaces), 8)
    e_blank(e)
    e_ints(e, "_WS_HI", pair_hi(spaces), 8)
    e_blank(e)

    e_comment(
        e, "The Alphabetic property from DerivedCoreProperties.txt (" + si(alpha.Len()) + " ranges).\n" + "Broader than category L: it also takes in letter numbers, the marks\n" + "that carry vowels in Indic and Arabic script, and other code points\n" + "with Other_Alphabetic. This, not L alone, is what a caller asking\n" + "\"is this a letter\" almost always means."
    )
    e_ints(e, "_ALPHA_LO", pair_lo(alpha), 8)
    e_blank(e)
    e_ints(e, "_ALPHA_HI", pair_hi(alpha), 8)
    e_blank(e)

    mut ccc_runs := value_ranges(ccc)
    e_comment(
        e, "Canonical combining class, as " + si(ccc_runs.Len()) + " (lo, hi, class) runs covering the " + si(ccc.keys.Len()) + "\n" + "code points whose class is not zero. Everything absent is class 0.\n" + "\n" + "This is the key to canonical ordering: when several marks follow one\n" + "base character, normalization sorts them by this number, so that a\n" + "Persian word written with its harakat in one order compares equal to\n" + "the same word with them typed in another. Marks of class 0, and any\n" + "two marks of equal class, are never reordered relative to each other."
    )
    e_ints(e, "_CCC_LO", col_lo(ccc_runs), 8)
    e_blank(e)
    e_ints(e, "_CCC_HI", col_hi(ccc_runs), 8)
    e_blank(e)
    e_ints(e, "_CCC_VAL", col_id(ccc_runs), 8)
    e_blank(e)

    emit_seq_block(
        e, full_canon, "_NFD", "Canonical", "These are the mappings NFD and NFC use. Each is stored fully\n" + "expanded, so no entry here decomposes any further."
    )
    emit_seq_block(
        e, full_compat, "_NFKD", "Compatibility", "These add the mappings NFKD and NFKC use on top of the canonical\n" + "ones. For Arabic and Persian this is the table that matters most:\n" + "the presentation forms in U+FB50..U+FDFF and U+FE70..U+FEFF - the\n" + "isolated, initial, medial and final shapes that some sources store\n" + "literally instead of letting the renderer choose - decompose back to\n" + "the plain letters here, and nowhere else."
    )

    e_comment(
        e, "Canonical composition: " + si(comp.Len()) + " (starter, combining) pairs that recombine\n" + "into a single code point. This is the decomposition table read\n" + "backwards, minus the composition exclusions - the pairs Unicode says\n" + "must stay apart even though they decomposed.\n" + "\n" + "Sorted by starter and then by the combining mark, so a lookup binary\n" + "searches _COMP_A for the starter and then scans that starter's short\n" + "run for the mark."
    )
    mut comp_a := Vector {} as Vector<int>
    mut comp_b := Vector {} as Vector<int>
    mut comp_cp := Vector {} as Vector<int>
    each c in comp:
        comp_a.Push(c.a) comp_b.Push(c.b) comp_cp.Push(c.cp)
    end
    e_ints(e, "_COMP_A", comp_a, 8)
    e_blank(e)
    e_ints(e, "_COMP_B", comp_b, 8)
    e_blank(e)
    e_ints(e, "_COMP_CP", comp_cp, 8)
    e_blank(e)

    e_comment(e, "Grapheme_Cluster_Break class ids, used by the segmenter in str.")
    each nm in gcb_names:
        e_const(e, fa, "Gcb." + nm, "Gcb" + str.Replace(nm, "_", ""), si(gcb_id.Get(nm)))
    end
    e_blank(e)

    e_comment(
        e, "Grapheme_Cluster_Break, as " + si(gcb.Len()) + " (lo, hi, class) ranges. Code points not\n" + "listed are GcbOther. The Hangul LV and LVT classes are absent and are\n" + "derived arithmetically, which is why this is ~800 ranges smaller than\n" + "GraphemeBreakProperty.txt.\n" + "\n" + "This is what lets text be counted and cut by what a reader sees as\n" + "one character rather than by code point: an Arabic letter followed by\n" + "two harakat is three code points and one grapheme cluster."
    )
    e_ints(e, "_GCB_LO", col_lo(gcb), 8)
    e_blank(e)
    e_ints(e, "_GCB_HI", col_hi(gcb), 8)
    e_blank(e)
    e_ints(e, "_GCB_ID", col_id(gcb), 8)
    e_blank(e)

    e_comment(e, "Indic_Conjunct_Break class ids, used by GB9c in the segmenter.")
    each nm in incb_names:
        e_const(e, fa, "Incb." + nm, "Incb" + nm, si(incb_id.Get(nm)))
    end
    e_blank(e)

    e_comment(
        e, "Indic_Conjunct_Break, as " + si(incb.Len()) + " (lo, hi, class) ranges; anything absent is\n" + "IncbNone. This drives one rule, GB9c, which keeps a consonant joined\n" + "to a following consonant by a virama in the same grapheme cluster -\n" + "so Devanagari क्त counts as one character rather than three."
    )
    e_ints(e, "_INCB_LO", col_lo(incb), 8)
    e_blank(e)
    e_ints(e, "_INCB_HI", col_hi(incb), 8)
    e_blank(e)
    e_ints(e, "_INCB_ID", col_id(incb), 8)
    e_blank(e)

    e_comment(
        e, "Bidi_Class ids. Grouped by kind so the bidirectional algorithm's\n" + "repeated \"is this an explicit formatting code\" tests are range\n" + "checks: the embedding and override codes are BcLRE..BcPDF and the\n" + "isolate codes are BcLRI..BcPDI."
    )
    each nm in bidi_names:
        e_const(e, fa, "Bc." + nm, "Bc" + nm, si(bidi_id.Get(nm)))
    end
    e_blank(e)

    e_comment(
        e, "Bidi_Class, as " + si(bidi.Len()) + " (lo, hi, class) ranges. Anything absent is BcL.\n" + "\n" + "The absent-means-L rule holds only because the block defaults are\n" + "baked in here: unassigned code points in the Hebrew and Arabic blocks\n" + "are R and AL respectively, and they appear as explicit ranges below\n" + "even though no character is assigned to them yet."
    )
    e_ints(e, "_BIDI_LO", col_lo(bidi), 8)
    e_blank(e)
    e_ints(e, "_BIDI_HI", col_hi(bidi), 8)
    e_blank(e)
    e_ints(e, "_BIDI_ID", col_id(bidi), 8)
    e_blank(e)

    e_comment(e, "Bidi_Paired_Bracket_Type ids, for rule N0.")
    each nm in pbt_names:
        e_const(e, fa, "Pbt." + nm, "Pbt" + nm, si(pbt_id.Get(nm)))
    end
    e_blank(e)

    e_comment(
        e, "Bidi_Paired_Bracket: the " + si(brackets.Len()) + " bracket code points, each with the code\n" + "point it pairs with and whether it opens or closes. Rule N0 uses this\n" + "to give both halves of a bracket pair the same direction, so that\n" + "\"(سلام)\" does not come out with its parentheses facing the wrong way."
    )
    e_ints(e, "_BRACKET_CP", col_lo(brackets), 8)
    e_blank(e)
    e_ints(e, "_BRACKET_PAIR", col_hi(brackets), 8)
    e_blank(e)
    e_ints(e, "_BRACKET_TYPE", col_id(brackets), 8)
    e_blank(e)

    e_comment(
        e, "Script ids. ScriptUnknown is 0 and is what an unassigned code point\n" + "answers. Only the scripts this version defines are listed."
    )
    mut sidx := 0
    each nm in script_names:
        e_const(e, fa, "Script." + str.Replace(nm, "_", ""), "Script" + str.Replace(nm, "_", ""), si(sidx))
        sidx++
    end
    e_blank(e)

    e_comment(e, "Script names, indexed by the ids above.")
    e_strings(e, "_SCRIPT_NAMES", script_names, 4)
    e_blank(e)

    e_comment(
        e, "The Script property, as " + si(scripts.Len()) + " (lo, hi, script) ranges. Anything absent is\n" + "ScriptUnknown."
    )
    e_ints(e, "_SCRIPT_LO", col_lo(scripts), 8)
    e_blank(e)
    e_ints(e, "_SCRIPT_HI", col_hi(scripts), 8)
    e_blank(e)
    e_ints(e, "_SCRIPT_ID", col_id(scripts), 8)

    _n := os.WriteFile(out_path, e_text(e))

    io.EPrintln("wrote " + out_path + " (UCD " + UCD_VERSION + "):")
    io.EPrintln(
        "  " + si(assigned.Len()) + " category ranges, " + si(case_ranges(upper).Len()) + "/" + si(case_ranges(lower).Len()) + "/" + si(case_ranges(title).Len()) + "/" + si(case_ranges(fold_simple).Len()) + " case runs, " + si(fold_full.keys.Len()) + " full folds"
    )
    io.EPrintln(
        "  " + si(spaces.Len()) + " space ranges, " + si(alpha.Len()) + " alphabetic ranges, " + si(ccc_runs.Len()) + " combining-class runs"
    )
    io.EPrintln(
        "  " + si(full_canon.keys.Len()) + " canonical and " + si(full_compat.keys.Len()) + " compatibility decompositions"
    )
    io.EPrintln(
        "  " + si(comp.Len()) + " composition pairs, " + si(gcb.Len()) + " grapheme-break and " + si(incb.Len()) + " conjunct-break ranges"
    )
    io.EPrintln(
        "  " + si(bidi.Len()) + " bidi-class ranges, " + si(brackets.Len()) + " bracket pairs, " + si(scripts.Len()) + " script ranges"
    )
    ret 0
end
