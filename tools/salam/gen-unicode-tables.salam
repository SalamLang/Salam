package main

import os
import io
import str
import conv
import sort
import net.http

const UCD_VERSION := "16.0.0"
const UCD_BASE := "https://www.unicode.org/Public/16.0.0/ucd"
const CACHE := "tools/salam/.ucd-cache"
const OUT := "std/unicode/tables.salam"

const MAX_CP := 1114112

const HANGUL_VCOUNT := 21
const HANGUL_TCOUNT := 28
const HANGUL_LCOUNT := 19
const HANGUL_SCOUNT := 11172

struct Rng:
    pub lo: int = 0
    pub hi: int = 0
    pub id: int = 0
end

struct Span:
    pub lo: int = 0
    pub hi: int = 0
end

struct CaseRun:
    pub lo: int = 0
    pub hi: int = 0
    pub stride: int = 0
    pub delta: int = 0
end

struct Comp:
    pub a: int = 0
    pub b: int = 0
    pub cp: int = 0
end

struct IntMap:
    pub keys: Vector<int> = Vector {}
    pub m: HashMap<int, int> = HashMap {}
end

struct SeqMap:
    pub keys: Vector<int> = Vector {}
    pub off: HashMap<int, int> = HashMap {}
    pub len: HashMap<int, int> = HashMap {}
    pub seq: Vector<int> = Vector {}
end

struct Emitter:
    pub parts: Vector<str> = Vector {}
end

func si(n: int): str:
    ret conv.FormatInt(n as i64)
end

func die(msg: str):
    io.EPrintln(msg)
    os.Exit(1)
end

func hex(s: str): int:
    try:
        ret conv.ParseHex(s) as int
    catch e:
        die("bad code point '" + s + "': " + e.ToStr())
    end
    ret 0
end

func hex4(cp: int): str:
    mut h := conv.FormatHex(cp as u64)
    h = str.Upper(h)
    until h.Len() < 4:
        h = "0" + h
    end
    ret h
end

func imap_put(t &: IntMap, k: int, v: int):
    if t.m.Has(k) == false:
        t.keys.Push(k)
    end
    t.m.Put(k, v)
end

func sorted_keys(t &: IntMap): Vector<int>:
    mut ks := Vector {} as Vector<int>
    each k in t.keys:
        ks.Push(k)
    end
    sort.Sort(ks)
    ret ks
end

func seq_put(t &: SeqMap, cp: int, vals &: Vector<int>):
    if t.off.Has(cp) == false:
        t.keys.Push(cp)
    end
    t.off.Put(cp, t.seq.Len())
    t.len.Put(cp, vals.Len())
    each v in vals:
        t.seq.Push(v)
    end
end

func seq_sorted_keys(t &: SeqMap): Vector<int>:
    mut ks := Vector {} as Vector<int>
    each k in t.keys:
        ks.Push(k)
    end
    sort.Sort(ks)
    ret ks
end

func less_rng(a: Rng, b: Rng): bool:
    if a.lo != b.lo: ret a.lo < b.lo end
    if a.hi != b.hi: ret a.hi < b.hi end
    ret a.id < b.id
end

func less_pair(a: Span, b: Span): bool:
    if a.lo != b.lo: ret a.lo < b.lo end
    ret a.hi < b.hi
end

func less_comp(a: Comp, b: Comp): bool:
    if a.a != b.a: ret a.a < b.a end
    if a.b != b.b: ret a.b < b.b end
    ret a.cp < b.cp
end

func categories(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("Lu") v.Push("Ll") v.Push("Lt") v.Push("Lm") v.Push("Lo")
    v.Push("Mn") v.Push("Mc") v.Push("Me")
    v.Push("Nd") v.Push("Nl") v.Push("No")
    v.Push("Pc") v.Push("Pd") v.Push("Ps") v.Push("Pe")
    v.Push("Pi") v.Push("Pf") v.Push("Po")
    v.Push("Sm") v.Push("Sc") v.Push("Sk") v.Push("So")
    v.Push("Zs") v.Push("Zl") v.Push("Zp")
    v.Push("Cc") v.Push("Cf") v.Push("Cs") v.Push("Co") v.Push("Cn")
    ret v
end

func grapheme_classes(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("Other") v.Push("CR") v.Push("LF") v.Push("Control")
    v.Push("Extend") v.Push("ZWJ") v.Push("Regional_Indicator")
    v.Push("Prepend") v.Push("SpacingMark")
    v.Push("L") v.Push("V") v.Push("T") v.Push("LV") v.Push("LVT")
    v.Push("Extended_Pictographic")
    ret v
end

func incb_classes(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("None") v.Push("Consonant") v.Push("Extend") v.Push("Linker")
    ret v
end

func bidi_classes(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("L") v.Push("R") v.Push("AL") v.Push("EN") v.Push("ES")
    v.Push("ET") v.Push("AN") v.Push("CS") v.Push("NSM") v.Push("BN")
    v.Push("B") v.Push("S") v.Push("WS") v.Push("ON")
    v.Push("LRE") v.Push("RLE") v.Push("LRO") v.Push("RLO") v.Push("PDF")
    v.Push("LRI") v.Push("RLI") v.Push("FSI") v.Push("PDI")
    ret v
end

func pbt_classes(): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push("None") v.Push("Open") v.Push("Close")
    ret v
end

