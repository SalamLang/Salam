import os
import str

regex_prev_punct := "(,=:[!&|?{};~+-*/%<>^"
func roots_list(): Vector<str>:
    mut v := Vector {} as Vector<str> v.Push("web")
    v.Push("extensions")
    ret v
end
func is_skip_name(name: str): bool:
    switch name:
        ".git", "node_modules", "dist", "build", ".venv", "vendor":
            ret true
        end
    end
    ret false
end
func find_from(s: str, sub: str, start: int): int:
    if start >= s.Len(): ret 0 - 1 end
    rest := s.Substr(start, s.Len() - start)
    k := rest.Find(sub)
    if k < 0: ret 0 - 1 end
    ret start + k
end
func is_word_byte(code: int): bool:
    if code >= 48 and code <= 57: ret true end
    if code >= 65 and code <= 90: ret true end
    if code >= 97 and code <= 122: ret true end
    if code == 95 or code == 36: ret true end
    ret false
end
func is_space_byte(code: int): bool:
    ret code == 32 or code == 9 or code == 10 or code == 13
end
func is_regex_keyword(w: str): bool:
    switch w:
        "return", "typeof", "instanceof", "in", "of", "new", "delete", "void", "do", "else", "case", "yield", "await", "throw":
            ret true
        end
    end
    ret false
end
func regex_allowed(prev: str): bool:
    if prev.Len() == 0: ret true end
    if is_regex_keyword(prev): ret true end
    last := prev.Substr(prev.Len() - 1, 1)
    ret regex_prev_punct.Find(last) >= 0
end
func strip_comments(text: str, line_comments: bool, templates: bool): str:
    mut sb := str.NewBuilder()
    mut cur_word := ""
    mut last_token := ""
    n := text.Len()
    mut i := 0
    until i < n:
        c := text.Substr(i, 1)
        mut nxt := ""
        if i + 1 < n: nxt = text.Substr(i + 1, 1) end
        if line_comments and c == "/" and nxt == "/":
            j := find_from(text, "\n", i)
            if j < 0: i = n else:
                i = j
            end
            continue
        end
        if c == "/" and nxt == "*":
            j := find_from(text, "*/", i + 2)
            if j < 0: i = n else:
                i = j + 2
            end
            continue
        end
        mut prev := cur_word
        if prev.Len() == 0: prev = last_token end
        if line_comments and c == "/" and regex_allowed(prev):
            str.BufAppend(sb, c)
            i++
            mut in_class := false
            until i < n:
                ch := text.Substr(i, 1)
                if ch == "\n": break end
                str.BufAppend(sb, ch)
                if ch == "\\" and i + 1 < n:
                    str.BufAppend(sb, text.Substr(i + 1, 1))
                    i += 2
                    continue
                end
                i++
                if ch == "[": in_class = true
                else ch == "]": in_class = false
                else ch == "/" and in_class == false: break
                end
            end
            cur_word = ""
            last_token = "/"
            continue
        end
        if c == "\"" or c == "'" or (templates and c == "`"):
            quote := c
            str.BufAppend(sb, c)
            i++
            until i < n:
                ch := text.Substr(i, 1)
                str.BufAppend(sb, ch)
                if ch == "\\" and i + 1 < n:
                    str.BufAppend(sb, text.Substr(i + 1, 1))
                    i += 2
                    continue
                end
                i++
                if ch == quote: break end
            end
            cur_word = ""
            last_token = quote
            continue
        end
        str.BufAppend(sb, c)
        code := char_code(c)
        if is_word_byte(code):
            cur_word = cur_word.Concat(c)
        else is_space_byte(code):
            if cur_word.Len() > 0:
                last_token = cur_word
                cur_word = ""
            end
        else:
            if cur_word.Len() > 0:
                last_token = cur_word
                cur_word = ""
            end
            last_token = c
        end
        i++
    end
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end
func in_skip_dir(path: str): bool:
    mut parts := path.Split("/")
    repeat parts.Len() in i:
        if is_skip_name(parts.Get(i)):
            parts.Free()
            ret true
        end
    end
    defer parts.Free()
    ret false
end
func main:
    mut changed := 0
    mut roots := roots_list()
    repeat roots.Len() in r:
        root := roots.Get(r)
        if os.IsDir(root) == false: continue end
        mut all := os.Walk(root)
        repeat all.Len() in i:
            path := all.Get(i)
            is_css := str.EndsWith(path, ".css")
            is_js := str.EndsWith(path, ".js")
            if is_css == false and is_js == false: continue end
            if in_skip_dir(path): continue end
            original := os.ReadFile(path)
            stripped := strip_comments(original, is_js, is_js)
            if stripped != original:
                os.WriteFile(path, stripped)
                changed++
                println "stripped:", path
            end
        end
        all.Free()
    end
    println ""
    println "Done. Modified", changed, "file(s)."
end
