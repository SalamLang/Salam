import os
import str

func roots_list(): Vector<str>:
    mut v := Vector {} as Vector<str> v.Push("books")
    v.Push("book")
    v.Push("doc")
    ret v
end
func strip_tex_line(line: str): str:
    n := line.Len()
    mut i := 0
    until i < n:
        c := line.Substr(i, 1)
        if c == "\\":
            i += 2
            continue
        end
        if c == "%":
            ret line.Substr(0, i)
        end
        i++
    end
    ret line
end
func strip_tex(text: str): str:
    mut parts := text.Split("\n")
    mut sb := str.NewBuilder()
    repeat parts.Len() in i:
        if i > 0: str.BufAppend(sb, "\n") end
        str.BufAppend(sb, strip_tex_line(parts.Get(i)))
    end
    defer parts.Free()
    out := str.BufStr(sb)
    str.BufFree(sb)
    ret out
end
func main:
    mut changed := 0
    mut roots := roots_list()
    repeat roots.Len() in r:
        root := roots.Get(r)
        if os.IsDir(root) == false: continue end
        mut all := os.Walk(root)
        repeat all.Len() in i:
            path := all.Get(i)
            if str.EndsWith(path, ".tex") == false: continue end
            original := os.ReadFile(path)
            stripped := strip_tex(original)
            if stripped != original:
                os.WriteFile(path, stripped)
                changed++
                println "stripped:", path
            end
        end
        all.Free()
    end
    println ""
    println "Done. Modified", changed, "file(s)."
end
