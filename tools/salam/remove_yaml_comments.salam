import os
import str

func roots_list(): Vector<str>:
    mut v := Vector {} as Vector<str> v.Push(".")
    ret v
end
func is_skip_name(name: str): bool:
    switch name:
        ".git", "node_modules", "dist", "build", ".venv", "vendor":
            ret true
        end
    end
    ret false
end
func is_ws(c: str): bool:
    ret c == " " or c == "\t"
end
func trim_right(s: str): str:
    mut e := s.Len()
    until e > 0:
        c := s.Substr(e - 1, 1)
        if c == " " or c == "\t": e-- else:
            break
        end
    end
    ret s.Substr(0, e)
end
func leading_indent(line: str): int:
    n := line.Len()
    mut i := 0
    until i < n:
        c := line.Substr(i, 1)
        if c == " " or c == "\t": i++ else:
            break
        end
    end
    ret i
end
func is_blank(line: str): bool:
    n := line.Len()
    mut i := 0
    until i < n:
        c := line.Substr(i, 1)
        if c == " " or c == "\t" or c == "\r": i++ else:
            ret false
        end
    end
    ret true
end
func strip_yaml_line(line: str): str:
    mut cr := ""
    mut work := line
    if work.Len() > 0 and work.Substr(work.Len() - 1, 1) == "\r":
        cr = "\r"
        work = work.Substr(0, work.Len() - 1)
    end
    n := work.Len()
    mut i := 0
    mut in_s := false
    mut in_d := false
    mut prev := " "
    until i < n:
        c := work.Substr(i, 1)
        if in_d:
            if c == "\\" and i + 1 < n:
                prev = ""
                i += 2
                continue
            end
            if c == "\"": in_d = false end
        else in_s:
            if c == "'":
                if i + 1 < n and work.Substr(i + 1, 1) == "'":
                    prev = "'"
                    i += 2
                    continue
                end
                in_s = false
            end
        else:
            switch c:
                "\"":
                    in_d = true
                    break
                end
                "'":
                    in_s = true
                    break
                end
                "#":
                    if is_ws(prev): ret trim_right(work.Substr(0, i)).Concat(cr) end
                    break
                end
            end
        end
        prev = c
        i++
    end
    ret work.Concat(cr)
end
func block_indicator(stripped: str): bool:
    t := trim_right(stripped)
    n := t.Len()
    if n == 0: ret false end
    mut start := 0
    repeat n in k:
        c := t.Substr(k, 1)
        if c == " " or c == "\t": start = k + 1 end
    end
    tok := t.Substr(start, n - start)
    first := tok.Substr(0, 1)
    if first != "|" and first != ">": ret false end
    repeat tok.Len() in j:
        if j == 0: continue end
        ch := tok.Substr(j, 1)
        if ch == "+" or ch == "-": continue end
        code := char_code(ch)
        if code >= 48 and code <= 57: continue end
        ret false
    end
    ret true
end
func strip_yaml(text: str): str:
    mut parts := text.Split("\n")
    mut sb := str.NewBuilder()
    mut in_block := false
    mut block_indent := 0
    repeat parts.Len() in i:
        if i > 0: str.BufAppend(sb, "\n") end
        line := parts.Get(i)
        if in_block:
            if is_blank(line):
                str.BufAppend(sb, line)
                continue
            end
            if leading_indent(line) > block_indent:
                str.BufAppend(sb, line)
                continue
            end
            in_block = false
        end
        out := strip_yaml_line(line)
        str.BufAppend(sb, out)
        if block_indicator(out):
            in_block = true
            block_indent = leading_indent(line)
        end
    end
    defer parts.Free()
    res := str.BufStr(sb)
    str.BufFree(sb)
    ret res
end
func in_skip_dir(path: str): bool:
    mut parts := path.Split("/")
    repeat parts.Len() in i:
        if is_skip_name(parts.Get(i)):
            parts.Free()
            ret true
        end
    end
    defer parts.Free()
    ret false
end
func main:
    mut changed := 0
    mut roots := roots_list()
    repeat roots.Len() in r:
        root := roots.Get(r)
        if os.IsDir(root) == false: continue end
        mut all := os.Walk(root)
        repeat all.Len() in i:
            path := all.Get(i)
            is_yml := str.EndsWith(path, ".yml")
            is_yaml := str.EndsWith(path, ".yaml")
            if is_yml == false and is_yaml == false: continue end
            if in_skip_dir(path): continue end
            original := os.ReadFile(path)
            stripped := strip_yaml(original)
            if stripped != original:
                os.WriteFile(path, stripped)
                changed++
                println "stripped:", path
            end
        end
        all.Free()
    end
    println ""
    println "Done. Modified", changed, "file(s)."
end
