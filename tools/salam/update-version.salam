package main

import os
import os.shell
import str

const VERSION_FILE := "VERSION"
const README_FILE := "README.md"
const RELEASES_REPO := "SalamLang/Salam"

struct Site:
    pub path: str = ""
    pub prefix: str = ""
    pub suffix: str = ""
end

func sites(): Vector<Site>:
    mut v := Vector {} as Vector<Site>
    v.Push(Site { path = "pyproject.toml", prefix = "version = \"", suffix = "\"" })
    v.Push(Site { path = "CITATION.cff", prefix = "\nversion: \"", suffix = "\"" })
    v.Push(Site { path = "extensions/vscode/package.json", prefix = "\"version\": \"", suffix = "\"" })
    v.Push(Site { path = "extensions/tree-sitter-salam/tree-sitter.json", prefix = "\"version\": \"", suffix = "\"" })
    v.Push(Site { path = "tools/mcp/claude-plugin/.claude-plugin/plugin.json", prefix = "\"version\": \"", suffix = "\"" })
    v.Push(Site { path = "extensions/emacs/salam-mode.el", prefix = ";; Version: ", suffix = "\n" })
    v.Push(Site { path = "books/en/intro-programming/chapters/01-getting-started.tex", prefix = "$ salam version\nsalam ", suffix = "\n" })
    v.Push(Site { path = "docs/PROFILING.md", prefix = "\"salam_version\": \"", suffix = "\"" })
    v.Push(Site { path = "myst.yml", prefix = "- title: v", suffix = " (Stable)" })
    v.Push(Site { path = "myst.yml", prefix = "readthedocs.io/v", suffix = "/" })
    v.Push(
        Site {
            path = "bun.lock", prefix = "\"name\": \"salam-programming-language\",\n      \"version\": \"", suffix = "\""
        }
    )
    v.Push(Site { path = "uv.lock", prefix = "name = \"salam\"\nversion = \"", suffix = "\"" })
    v.Push(Site { path = "editor/build_info.salam", prefix = "pub mut VERSION := \"", suffix = "\"" })
    v.Push(Site { path = "editor/sw.js", prefix = "const SW_VERSION = \"", suffix = "\"" })
    v.Push(Site { path = "agent/src-tauri/tauri.conf.json", prefix = "\"version\": \"", suffix = "\"" })
    v.Push(Site { path = "agent/src-tauri/Cargo.toml", prefix = "name = \"salam-agent\"\nversion = \"", suffix = "\"" })
    v.Push(Site { path = "agent/src-tauri/Cargo.lock", prefix = "name = \"salam-agent\"\nversion = \"", suffix = "\"" })
    ret v
end

func is_valid_version(v: str): bool:
    if v.Len() == 0: ret false end
    parts := str.Split(v, ".")
    defer parts.Free()
    if parts.Len() < 2: ret false end
    mut ok := true
    each part in parts:
        if part.Len() == 0:
            ok = false
        else:
            repeat part.Len() in i:
                c := part.Substr(i, 1)
                if c < "0" or c > "9": ok = false end
            end
        end
    end
    ret ok
end

func read_at(s: str, prefix: str, suffix: str): str:
    at := s.Find(prefix)
    if at < 0: ret "" end
    from := at + prefix.Len()
    rest := s.Substr(from, s.Len() - from)
    end_at := rest.Find(suffix)
    if end_at < 0: ret "" end
    ret rest.Substr(0, end_at)
end

func write_at(s: str, prefix: str, suffix: str, v: str): str:
    at := s.Find(prefix)
    if at < 0: ret s end
    from := at + prefix.Len()
    rest := s.Substr(from, s.Len() - from)
    end_at := rest.Find(suffix)
    if end_at < 0: ret s end
    tail_from := from + end_at
    ret s.Substr(0, from) + v + s.Substr(tail_from, s.Len() - tail_from)
end

func read_version_file(): str:
    if os.Exists(VERSION_FILE) == false:
        println "error:", VERSION_FILE, "not found - run this from the repository root"
        os.Exit(1)
    end
    ret str.Trim(os.ReadFile(VERSION_FILE))
end

func check_all(want: str): int:
    mut bad := 0
    all := sites()
    defer all.Free()
    each site in all:
        if os.Exists(site.path) == false:
            println "  MISSING FILE  ", site.path
            bad++
        else:
            body := os.ReadFile(site.path)
            got := read_at(body, site.prefix, site.suffix)
            if got.Len() == 0:
                println "  NO ANCHOR     ", site.path, "- expected", site.prefix, "(the file changed shape; fix the table in this script)"
                bad++
            else:
                if got == want:
                    println "  ok            ", site.path
                else:
                    println "  MISMATCH      ", site.path, "- has", got, "want", want
                    bad++
                end
            end
        end
    end
    ret bad
end

func myst_promote(want: str): bool:
    path := "myst.yml"
    if os.Exists(path) == false:
        ret false
    end
    body := os.ReadFile(path)
    old := read_at(body, "- title: v", " (Stable)")
    if old.Len() == 0 or old == want:
        ret false
    end
    mut out := write_at(body, "- title: v", " (Stable)", want)
    out = write_at(out, "readthedocs.io/v", "/", want)

    marker := "- title: v" + want + " (Stable)"
    at := out.Find(marker)
    if at < 0:
        ret false
    end
    from := at + marker.Len()
    rest := out.Substr(from, out.Len() - from)
    nl1 := rest.Find("\n")
    if nl1 < 0:
        ret false
    end
    tail_from := nl1 + 1
    after := rest.Substr(tail_from, rest.Len() - tail_from)
    nl2 := after.Find("\n")
    if nl2 < 0:
        ret false
    end
    cut := from + tail_from + nl2 + 1
    ins := "        - title: v" + old + "\n" + "          url: https://salamlang.readthedocs.io/v" + old + "/\n"
    out = out.Substr(0, cut) + ins + out.Substr(cut, out.Len() - cut)
    _n := os.WriteFile(path, out)
    println "  promoted      ", path, old, "->", want, "- and kept", old, "in the menu"
    ret true
end

func sync_all(want: str): int:
    _promoted := myst_promote(want)
    mut changed := 0
    all := sites()
    defer all.Free()
    each site in all:
        if os.Exists(site.path) == false:
            println "  MISSING FILE  ", site.path
        else:
            body := os.ReadFile(site.path)
            got := read_at(body, site.prefix, site.suffix)
            if got.Len() == 0:
                println "  NO ANCHOR     ", site.path, "- expected", site.prefix
            else:
                if got == want:
                    println "  ok            ", site.path
                else:
                    _n := os.WriteFile(site.path, write_at(body, site.prefix, site.suffix, want))
                    println "  updated       ", site.path, got, "->", want
                    changed++
                end
            end
        end
    end
    ret changed
end

func readme_sites(): Vector<Site>:
    mut v := Vector {} as Vector<Site>
    v.Push(Site { path = README_FILE, prefix = "--dir ./bin --version ", suffix = "`" })
    v.Push(Site { path = README_FILE, prefix = "`irm ... ", suffix = " | iex`" })
    v.Push(Site { path = README_FILE, prefix = "that \"", suffix = "\" is parsed" })
    v.Push(Site { path = README_FILE, prefix = "Tools\\Salam --version ", suffix = "\"" })
    v.Push(Site { path = README_FILE, prefix = "SALAM_VERSION = \"", suffix = "\"" })
    v.Push(Site { path = README_FILE, prefix = ".bat\" --version ", suffix = "\n" })
    v.Push(Site { path = README_FILE, prefix = "--build-arg SALAM_VERSION=", suffix = " docker" })
    ret v
end

func latest_release(): str:
    mut args := Vector {} as Vector<str>
    defer args.Free()
    args.Push("api")
    args.Push("repos/" + RELEASES_REPO + "/releases?per_page=50")
    args.Push("--jq")
    args.Push("[.[] | select(.prerelease == false and .draft == false and (.tag_name | test(\"^v[0-9]+[.][0-9]+[.][0-9]+$\")))][0].tag_name")
    r := shell.Run("gh", args)
    if r.code != 0:
        println "error: could not ask GitHub for the latest release:", str.Trim(r.err)
        ret ""
    end
    tag := str.Trim(r.out)
    if tag.Len() < 2 or tag.Substr(0, 1) != "v":
        println "error: no published release found"
        ret ""
    end
    ret tag.Substr(1, tag.Len() - 1)
end

func readme_check(): int:
    mut first := ""
    mut bad := 0
    all := readme_sites()
    defer all.Free()
    each site in all:
        body := os.ReadFile(site.path)
        got := read_at(body, site.prefix, site.suffix)
        if got.Len() == 0:
            println "  NO ANCHOR     ", site.path, "- expected", site.prefix
            bad++
        else:
            if first.Len() == 0: first = got end
            if got != first:
                println "  MISMATCH      ", site.path, "- has", got, "but the others have", first
                bad++
            end
        end
    end
    ret bad
end

func readme_sync(want: str): int:
    mut changed := 0
    all := readme_sites()
    defer all.Free()
    each site in all:
        body := os.ReadFile(site.path)
        got := read_at(body, site.prefix, site.suffix)
        if got.Len() == 0:
            println "  NO ANCHOR     ", site.path, "- expected", site.prefix
        else:
            if got != want:
                _n := os.WriteFile(site.path, write_at(body, site.prefix, site.suffix, want))
                println "  updated       ", site.path, got, "->", want
                changed++
            end
        end
    end
    ret changed
end

func usage():
    println "usage: salam run tools/salam/update-version.salam <new-version|sync|check>"
    println ""
    println "  <new-version>  write it to VERSION, then update every other site"
    println "  sync           leave VERSION alone, bring the other sites to it"
    println "  check          report disagreements and exit 1; changes nothing"
    println "  readme [x.y.z] write the latest released version into the README examples;"
    println "                 without a version it asks GitHub for the newest published release,"
    println "                 never the upcoming one in VERSION"
end

func main:
    args := os.Args()
    defer args.Free()
    if args.Len() < 2:
        usage()
        ret 1
    end

    mode := args.Get(1)

    if mode == "check" or mode == "--check":
        want := read_version_file()
        println "checking every version site against", VERSION_FILE, "=", want
        println ""
        mut bad := check_all(want)
        println "checking that the README examples agree with each other (they follow the last release, not VERSION)"
        bad += readme_check()
        println ""
        if bad == 0:
            println "all version sites agree on", want
            ret 0
        end
        println bad, "site(s) disagree with", VERSION_FILE
        println "run: salam run tools/salam/update-version.salam sync"
        ret 1
    end

    if mode == "readme":
        mut want := ""
        if args.Len() > 2:
            want = args.Get(2)
        else:
            want = latest_release()
        end
        if is_valid_version(want) == false:
            println "error: no usable release version for the README"
            ret 1
        end
        println "README examples -> latest released version", want
        println ""
        changed := readme_sync(want)
        println ""
        println changed, "place(s) updated"
        ret 0
    end

    if mode == "sync" or mode == "--sync":
        want := read_version_file()
        println "syncing every version site to", VERSION_FILE, "=", want
        println ""
        changed := sync_all(want)
        println ""
        println changed, "file(s) updated"
        ret 0
    end

    if is_valid_version(mode) == false:
        println "error: invalid version", mode, "- expected dotted digits, e.g. 0.3.2"
        println ""
        usage()
        ret 1
    end

    old := read_version_file()
    if old == mode:
        println "already at", mode, "- checking the other sites anyway"
        println ""
        bad := check_all(mode)
        if bad > 0: ret 1 end
        ret 0
    end

    println "bumping", old, "->", mode
    println ""
    _n := os.WriteFile(VERSION_FILE, mode + "\n")
    println "  updated       ", VERSION_FILE, old, "->", mode
    changed := sync_all(mode)
    println ""
    println changed + 1, "file(s) updated"
    ret 0
end
