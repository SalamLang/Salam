import os
import str

const PAGE := `<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8"><style>
@font-face{font-family:V;src:url("file://{{font}}");font-weight:100 900}
*{margin:0;box-sizing:border-box}
html,body{width:1200px;height:630px;overflow:hidden;background:#111214;font-family:V,sans-serif}
body{position:relative;background:radial-gradient(ellipse 700px 420px at 100% 0%,#4d2410 0%,#111214 70%)}
.logo{position:absolute;left:96px;top:155px;width:300px;height:300px}
.logo svg{width:100%;height:100%;fill:#ff5c00}
.t{position:absolute;right:90px;top:0;height:630px;width:760px;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;direction:rtl}
.badge{background:#3a2112;color:#ff7a2a;font-weight:600;font-size:28px;padding:14px 28px;border-radius:40px;margin-bottom:28px}
h1{color:#ff5c00;font-weight:800;font-size:128px;line-height:1.15}
.l1{color:#f5f5f5;font-weight:700;font-size:40px;line-height:1.5;white-space:nowrap;margin-top:14px}
.l2{color:#b8b4ae;font-size:30px;direction:ltr;margin-top:6px;font-weight:400;align-self:flex-start}
.d{color:#a09c96;font-size:32px;direction:ltr;margin-top:42px;font-weight:500;align-self:flex-start}
</style></head><body>
<div class="logo">{{logo}}</div>
<div class="t"><div class="badge">{{badge}}</div><h1>{{title}}</h1>
<div class="l1">{{line1}}</div><div class="l2">{{line2}}</div>
<div class="d">{{domain}}</div></div>
</body></html>`

struct Site:
    pub name: str = ""
    pub out: str = ""
    pub badge: str = ""
    pub line1: str = ""
    pub line2: str = ""
end

func sites(): Vector<Site>:
    mut v := Vector {} as Vector<Site>
    v.Push(Site { name = "ai", out = "ai/frontend/public", badge = "دستیار هوشمند", line1 = "دستیار هوشمند زبان سلام", line2 = "AI assistant for the Salam language" })
    v.Push(Site { name = "editor", out = "editor/assets", badge = "ویرایشگر آنلاین", line1 = "ویرایشگر و زمین بازی آنلاین سلام", line2 = "Online editor and playground" })
    v.Push(Site { name = "mcp", out = "tools/mcp/site", badge = "سرور MCP", line1 = "سرور MCP برای ابزارهای هوش مصنوعی", line2 = "MCP server for AI tools" })
    ret v
end

func chrome(): str:
    given := os.Env("CHROME")
    if given.Len() > 0:
        ret given
    end
    found := str.Trim(os.Output("command -v chromium chromium-browser google-chrome chrome 2>/dev/null | head -n 1"))
    if found.Len() > 0:
        ret found
    end
    ret str.Trim(os.Output("ls -d $HOME/.cache/ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | tail -n 1"))
end

func render(root: str, s: Site, tmp: str, bin: str): bool:
    mut logo := os.ReadFile(root + "/ai/frontend/public/logo.svg")
    at := str.IndexOf(logo, "?>")
    if at >= 0:
        logo = logo.Substr(at + 2, logo.Len() - at - 2)
    end
    mut html := str.Replace(PAGE, "{{font}}", root + "/editor/assets/fonts/Vazirmatn-Variable.woff2")
    html = str.Replace(html, "{{logo}}", logo)
    html = str.Replace(html, "{{badge}}", s.badge)
    html = str.Replace(html, "{{title}}", "سلام")
    html = str.Replace(html, "{{line1}}", s.line1)
    html = str.Replace(html, "{{line2}}", s.line2)
    html = str.Replace(html, "{{domain}}", s.name + ".salamlang.ir")
    page := tmp + "/" + s.name + ".html"
    raw := tmp + "/" + s.name + ".png"
    os.WriteFile(page, html)
    out := root + "/" + s.out
    os.MkdirAll(out)
    shot := bin + " --headless=new --no-sandbox --disable-gpu --hide-scrollbars --force-device-scale-factor=1 --window-size=1200,630 --virtual-time-budget=3000 --screenshot=" + raw + " file://" + page + " >/dev/null 2>&1"
    if os.Run(shot) != 0:
        ret false
    end
    big := out + "/og-" + s.name + ".png"
    small := out + "/og-" + s.name + "-small.png"
    if os.Run("convert " + raw + " -strip -colors 256 -define png:compression-level=9 " + big) != 0:
        ret false
    end
    if os.Run("convert " + raw + " -resize 600x315 -strip -colors 256 " + small) != 0:
        ret false
    end
    println big, os.FileSize(big), os.FileSize(small)
    ret true
end

func main:
    root := os.Cwd()
    if not os.IsDir(root + "/tools/seo"):
        println "run from the repository root: salam run tools/seo/covers.salam [ai] [editor] [mcp]"
        ret 1
    end
    bin := chrome()
    if bin.Len() == 0:
        println "no chromium found, set CHROME"
        ret 1
    end
    args := os.Args()
    defer args.Free()
    tmp := os.TempDir() + "/salam-seo-covers"
    os.RemoveAll(tmp)
    os.MkdirAll(tmp)
    mut ok := true
    each s in sites():
        mut want := args.Len() < 2
        repeat args.Len() - 1 in i:
            if args.Get(i + 1) == s.name:
                want = true
            end
        end
        if want and not render(root, s, tmp, bin):
            println "failed:", s.name
            ok = false
        end
    end
    os.RemoveAll(tmp)
    ret ok ? 0 : 1
end
