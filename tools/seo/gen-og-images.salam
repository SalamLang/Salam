import os
import str
import fs
import fs.dir

const HTML := `<!doctype html>
<html lang="{{lang}}" dir="{{dir}}"><head><meta charset="utf-8"><style>
@font-face{font-family:V;src:url(font.woff2);font-weight:100 900}
*{margin:0;box-sizing:border-box}
html,body{width:1200px;height:630px;overflow:hidden}
body{font-family:V,sans-serif;color:#fff;background:#111214;position:relative}
.glow{position:absolute;inset:0;background:radial-gradient(ellipse 70% 90% at 85% 0%,rgba(255,92,0,.32),rgba(255,92,0,0) 70%)}
.logo{position:absolute;left:92px;top:170px;width:300px;height:290px}
.col{position:absolute;left:470px;right:90px;top:96px;text-align:{{align}}}
.badge{display:inline-block;padding:14px 30px;border-radius:30px;background:rgba(255,92,0,.2);color:#ff8a3d;font-size:27px;font-weight:700}
h1{margin-top:26px;font-size:{{size}}px;line-height:1.25;font-weight:900;color:#ff5c00}
p{text-wrap:balance;margin-top:22px;font-size:40px;line-height:1.5;font-weight:700}
.url{position:absolute;left:470px;right:90px;bottom:70px;text-align:{{align}};font-size:30px;color:#a29d99;direction:ltr}
</style></head><body><div class="glow"></div>
<img class="logo" src="logo.svg" alt="">
<div class="col"><span class="badge">{{badge}}</span><h1>{{title}}</h1><p>{{sub}}</p></div>
<div class="url">{{url}}</div>
</body></html>
`

const TABLE := `home|fa|زبان برنامه‌نویسی متن‌باز|سلام|اولین زبان برنامه‌نویسی فارسی و بومی ایران|www.salamlang.ir
home|en|OPEN SOURCE PROGRAMMING LANGUAGE|Salam|Write in English or Persian. Compile to native code.|salamlang.github.io/Salam
learn|fa|آموزش گام به گام|آموزش سلام|از اولین برنامه تا پروژه‌ی واقعی، به فارسی|www.salamlang.ir/learn
learn|en|STEP BY STEP COURSE|Learn Salam|From your first program to a real project|salamlang.github.io/Salam/learn
std|fa|مرجع با مثال اجراشدنی|کتابخانه‌ی استاندارد|مرجع همه‌ی بسته‌ها با مثال‌هایی که اجرا می‌شوند|www.salamlang.ir/std
std|en|REFERENCE WITH RUNNABLE EXAMPLES|Standard library|Every package documented, every example run|salamlang.github.io/Salam/std
speed|fa|اندازه‌گیری با داده‌ی خام|سرعت سلام|مقایسه با C، Rust، PHP و پایتون روی برنامه‌های یکسان|www.salamlang.ir/speed
speed|en|MEASURED WITH RAW DATA|How fast is Salam|Compared with C, Rust, PHP and Python on the same programs|salamlang.github.io/Salam/speed
install|fa|ویندوز، لینوکس و مک|نصب سلام|با یک فرمان، بدون دسترسی مدیر|www.salamlang.ir/install
install|en|WINDOWS, LINUX AND MACOS|Install Salam|One command, no administrator access|salamlang.github.io/Salam/install
tools|fa|ویرایشگر و ابزارها|ابزارهای سلام|ویرایشگر آنلاین، افزونه‌ی VS Code و ترجمه‌گر کد|www.salamlang.ir/tools
tools|en|EDITOR AND TOOLING|Salam tooling|Online editor, VS Code plugin and code translator|salamlang.github.io/Salam/tools
packages|fa|مدیر بسته|بسته‌های سلام|استفاده، نوشتن و انتشار بسته|www.salamlang.ir/packages
packages|en|PACKAGE MANAGER|Salam packages|Use, write and publish packages|salamlang.github.io/Salam/packages
community|fa|گیت‌هاب، تلگرام و دیسکورد|جامعه‌ی سلام|بپیوندید و در ساختن زبان سهیم شوید|www.salamlang.ir/community
community|en|GITHUB, TELEGRAM AND DISCORD|The Salam community|Join in and help build the language|salamlang.github.io/Salam/community
ai|fa|دستیار هوشمند|هوش مصنوعی سلام|دستیاری که زبان سلام را می‌شناسد|ai.salamlang.ir
ai|en|AI ASSISTANT|Salam AI|An assistant that knows the Salam language|ai.salamlang.ir
agent|fa|برنامه‌ی رومیزی|دستیار زبان سلام|دستیار هوشمند روی رایانه‌ی خودتان|www.salamlang.ir/agent
agent|en|DESKTOP APP|Salam Agent|The assistant on your own computer|salamlang.github.io/Salam/agent
editor|fa|ویرایشگر آنلاین|زمین بازی سلام|بدون نصب، در مرورگر بنویسید و اجرا کنید|editor.salamlang.ir
editor|en|ONLINE EDITOR|Salam playground|Write and run Salam in your browser|editor.salamlang.ir
mcp|fa|سرور MCP|سلام برای عامل‌ها|کامپایلر و مرجع سلام برای دستیارهای کدنویسی|mcp.salamlang.ir
mcp|en|MCP SERVER|Salam for agents|The compiler and reference for coding assistants|mcp.salamlang.ir
blog|fa|مقاله‌های تخصصی|مجله‌ی سلام|طراحی زبان، کامپایلر، سرعت و مقایسه با زبان‌های دیگر|www.salamlang.ir/blog
blog|en|IN-DEPTH ARTICLES|Salam Magazine|Design, compiler and speed|salamlang.github.io/Salam/blog
`

func esc(s: str): str:
    ret str.Replace(str.Replace(s, "&", "&amp;"), "<", "&lt;")
end

func first_line(s: str): str:
    each line in s.Split("\n"):
        t := str.Trim(line)
        if t.Len() > 0:
            ret t
        end
    end
    ret ""
end

func find_chrome(): str:
    env := str.Trim(os.Env("CHROMIUM"))
    if env.Len() > 0:
        ret env
    end
    found := first_line(os.Output("command -v chromium chromium-browser google-chrome google-chrome-stable 2>/dev/null"))
    if found.Len() > 0:
        ret found
    end
    ret first_line(os.Output("ls -d \"$HOME\"/.cache/ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | tail -n 1"))
end

func fail(msg: str): int:
    printerrln "gen-og-images: " + msg
    ret 1
end

func main: int:
    chrome := find_chrome()
    if chrome.Len() == 0:
        ret fail("no Chromium found, set CHROMIUM")
    end
    magick := first_line(os.Output("command -v magick convert 2>/dev/null"))
    if magick.Len() == 0:
        ret fail("ImageMagick is required")
    end
    out := "website/assets/img"
    work := os.TempDir() + "/salam-og-" + os.Pid()
    _mk := dir.MkdirAll(work)
    _f := os.Run("cp website/assets/fonts/Vazirmatn.woff2 " + work + "/font.woff2")
    _l := os.Run("cp " + out + "/logo.svg " + work + "/logo.svg")
    mut failed := 0
    each line in TABLE.Split("\n"):
        c := line.Split("|")
        if c.Len() != 6:
            continue
        end
        name := c.Get(0)
        lang := c.Get(1)
        title := c.Get(3)
        mut file := "og-" + name + "-" + lang + ".png"
        if name == "home":
            file = "og-" + lang + ".png"
        end
        mut size := "96"
        if title.Len() > 24:
            size = "76"
        end
        if name == "home":
            size = "124"
        end
        mut html := str.Replace(HTML, "{{lang}}", lang)
        html = str.Replace(html, "{{dir}}", lang == "fa" ? "rtl" : "ltr")
        html = str.Replace(html, "{{align}}", lang == "fa" ? "right" : "left")
        html = str.Replace(html, "{{size}}", size)
        html = str.Replace(html, "{{badge}}", esc(c.Get(2)))
        html = str.Replace(html, "{{title}}", esc(title))
        html = str.Replace(html, "{{sub}}", esc(c.Get(4)))
        html = str.Replace(html, "{{url}}", esc(c.Get(5)))
        page := work + "/" + name + "-" + lang
        _w := fs.WriteText(page + ".html", html)
        shot := chrome + " --headless --no-sandbox --disable-gpu --hide-scrollbars --force-device-scale-factor=1 --window-size=1200,630 --virtual-time-budget=3000 --screenshot=" + page + ".png file://" + page + ".html >/dev/null 2>&1"
        _s := os.Run(shot)
        conv := magick + " " + page + ".png -strip PNG24:" + out + "/" + file
        if os.Run(conv) != 0 or not fs.Exists(out + "/" + file):
            printerrln "gen-og-images: cannot render " + file
            failed = 1
            continue
        end
        bytes := fs.Size(out + "/" + file)
        if bytes >= 307200:
            printerrln "gen-og-images: " + file + " is over 300 KB"
            failed = 1
        end
        println file, bytes
    end
    _i := os.Run(magick + " " + out + "/icon-512.png -define icon:auto-resize=48,32,16 website/assets/img/favicon.ico")
    _r := os.Run("rm -rf " + work)
    ret failed
end
