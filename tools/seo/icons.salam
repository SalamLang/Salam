import os
import fs

func main:
    root := os.Cwd()
    if not os.IsDir(root + "/tools/seo"):
        println "run from the repository root: salam run tools/seo/icons.salam"
        ret 1
    end
    src := root + "/ai/frontend/public"
    each dir in [root + "/editor/assets", root + "/tools/mcp/site"]:
        os.MkdirAll(dir)
        each f in ["icon-192.png", "icon-512.png", "apple-touch-icon.png"]:
            fs.Copy(src + "/" + f, dir + "/" + f)
        end
        fs.Copy(src + "/logo.svg", dir + "/icon.svg")
    end
    each dir in [src, root + "/editor", root + "/tools/mcp/site"]:
        if os.Run("convert " + src + "/icon-192.png -define icon:auto-resize=48,32,16 " + dir + "/favicon.ico") != 0:
            println "convert failed for", dir
            ret 1
        end
    end
    ret 0
end
