import os
import str

struct Target:
    pub name: str = ""
    pub url: str = ""
    pub out: str = ""
end

func targets(): Vector<Target>:
    mut v := Vector {} as Vector<Target>
    v.push(Target { name = "ai", url = "https://ai.salamlang.ir/?lang=fa", out = "ai/frontend/public" })
    v.push(Target { name = "editor", url = "https://editor.salamlang.ir/", out = "editor/assets" })
    v.push(Target { name = "mcp", url = "https://mcp.salamlang.ir/", out = "tools/mcp/site" })
    ret v
end

func chrome(): str:
    given := os.Env("CHROME")
    if given.Len() > 0:
        ret given
    end
    found := str.Trim(os.Output("command -v chromium chromium-browser google-chrome chrome 2>/dev/null | head -n 1"))
    if found.Len() > 0:
        ret found
    end
    ret str.Trim(os.Output("ls -d $HOME/.cache/ms-playwright/chromium-*/chrome-linux*/chrome 2>/dev/null | tail -n 1"))
end

func capture(root: str, t: Target, kind: str, w: int, h: int, tmp: str, bin: str): bool:
    raw := tmp + "/" + t.name + kind + ".png"
    shot := bin + " --headless=new --no-sandbox --disable-gpu --hide-scrollbars --force-device-scale-factor=1 --window-size=" + str.FromInt(w) + "," + str.FromInt(h) + " --virtual-time-budget=60000 --screenshot=" + raw + " " + t.url + " >/dev/null 2>&1"
    if os.Run(shot) != 0:
        ret false
    end
    dst := root + "/" + t.out + "/screenshot-" + t.name + "-" + kind + ".png"
    if os.Run("convert " + raw + " -strip -colors 256 " + dst) != 0:
        ret false
    end
    println dst, os.FileSize(dst)
    ret true
end

func main:
    root := os.Cwd()
    if not os.IsDir(root + "/tools/seo"):
        println "run from the repository root: salam run tools/seo/shots.salam [ai] [editor] [mcp]"
        ret 1
    end
    bin := chrome()
    if bin.Len() == 0:
        println "no chromium found, set CHROME"
        ret 1
    end
    args := os.Args()
    defer args.free()
    tmp := os.TempDir() + "/salam-seo-shots"
    os.RemoveAll(tmp)
    os.MkdirAll(tmp)
    mut ok := true
    each t in targets():
        mut want := args.Len() < 2
        repeat args.Len() - 1 in i:
            if args.get(i + 1) == t.name:
                want = true
            end
        end
        if want:
            if not capture(root, t, "wide", 1280, 720, tmp, bin) or not capture(root, t, "narrow", 390, 844, tmp, bin):
                println "failed:", t.name
                ok = false
            end
        end
    end
    os.RemoveAll(tmp)
    ret ok ? 0 : 1
end
