import os
import time

struct Map:
    pub dir: str = ""
    pub urls: Vector<str>
end

func maps(): Vector<Map>:
    mut v := Vector {} as Vector<Map>
    mut ai := Map { dir = "ai/frontend/public", urls = Vector {} as Vector<str> }
    ai.urls.push("https://ai.salamlang.ir/")
    ai.urls.push("https://ai.salamlang.ir/plans")
    v.push(ai)
    mut ed := Map { dir = "editor", urls = Vector {} as Vector<str> }
    ed.urls.push("https://editor.salamlang.ir/")
    v.push(ed)
    mut mcp := Map { dir = "tools/mcp/site", urls = Vector {} as Vector<str> }
    mcp.urls.push("https://mcp.salamlang.ir/")
    v.push(mcp)
    ret v
end

func main:
    root := os.Cwd()
    if not os.IsDir(root + "/tools/seo"):
        println "run from the repository root: salam run tools/seo/sitemap.salam"
        ret 1
    end
    today := time.FormatDate(time.Now())
    each m in maps():
        mut out := "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n"
        each u in m.urls:
            out += "  <url><loc>" + u + "</loc><lastmod>" + today + "</lastmod></url>\n"
        end
        out += "</urlset>\n"
        path := root + "/" + m.dir + "/sitemap.xml"
        os.WriteFile(path, out)
        println path
    end
    ret 0
end
