[Unit]
Description=Mirror Salam releases into /hosts/cdn.salamlang.ir
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=-/etc/salam-cdn-sync.env
ExecStart=/usr/bin/flock -n /run/salam-cdn-sync.lock /usr/local/sbin/salam-cdn-sync --quiet
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3h
