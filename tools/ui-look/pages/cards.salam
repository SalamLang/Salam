component Card(name):
    box:
        padding = 12
        border width = 2
        border style = solid
        border color = #3366aa
        radius = 10
        background = #ffffff
        width = 160
        heading: font size = 20 content = name end
        paragraph: content = "Fresh " + name end
    end
end

page:
    title = "Cards"
    box:
        layout = row
        gap = 12
        padding = 16
        background = #f4f6fa
        Card: name = "Tea" end
        Card: name = "Coffee" end
        Card: name = "Juice" end
    end
end
