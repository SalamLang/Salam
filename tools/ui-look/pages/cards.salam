component Card(name):
    box:
        padding = 12px
        border = "2px solid #3366aa"
        border radius = 10px
        background = "#ffffff"
        width = 160px
        heading: size = 3 content = name end
        paragraph: content = "Fresh " + name end
    end
end

page:
    title = "Cards"
    box:
        display = "flex"
        gap = 12px
        padding = 16px
        background = "#f4f6fa"
        Card: name = "Tea" end
        Card: name = "Coffee" end
        Card: name = "Juice" end
    end
end
