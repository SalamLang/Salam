page:
    title = "Form"
    box:
        padding = 20px
        background = "#ffffff"
        heading: size = 2 content = "Sign in" end
        paragraph: content = "Enter your details" end
        button:
            content = "Continue"
            padding = "8px 16px"
            background = "#3366aa"
            color = "#ffffff"
            border radius = 6px
        end
    end
end
