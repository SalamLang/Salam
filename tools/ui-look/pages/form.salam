page:
    title = "Form"
    box:
        padding = 20
        background = #ffffff
        gap = 8
        heading:
            font size = 28
            content = "Sign in"
        end
        paragraph:
            content = "Enter your details"
        end
        button:
            content = "Continue"
            padding = 10
            background = #3366aa
            color = #ffffff
            radius = 6
        end
    end
end
