page:
    title = "List"
    box:
        padding = 16
        gap = 6
        background = #fafafa
        heading: font size = 24 content = "Shopping" end
        box: padding = 8 background = #e8f0ff radius = 4 content = "Bread" end
        box: padding = 8 background = #ffffff radius = 4 content = "Milk" end
        box: padding = 8 background = #e8f0ff radius = 4 content = "Eggs" end
    end
end
