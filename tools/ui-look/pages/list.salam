page:
    title = "List"
    box:
        padding = 16px
        background = "#fafafa"
        heading: size = 2 content = "Shopping" end
        box: padding = 8px background = "#e8f0ff" border radius = 4px content = "Bread" end
        box: padding = 8px background = "#ffffff" border radius = 4px content = "Milk" end
        box: padding = 8px background = "#e8f0ff" border radius = 4px content = "Eggs" end
    end
end
