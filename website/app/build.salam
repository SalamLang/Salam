import os
import os.shell
import str
import io
import fs.dir

const SOURCES := "site,home,community,404,install,std,speed,brand,blog,tools,packages"

func put_file(words &: HashMap<str, str>, keys &: Vector<str>, path: str):
    lines := str.Split(io.ReadFile(path), "\n")
    mut i := 0
    until i < lines.Len():
        line := lines.Get(i)
        i++
        if str.StartsWith(line, "#"):
            continue
        end
        if str.EndsWith(line, " <<"):
            key := str.Trim(line.Substr(0, line.Len() - 3))
            mut body := ""
            until i < lines.Len() and lines.Get(i) != ">>":
                body = body.Len() == 0 ? lines.Get(i) : body + "\n" + lines.Get(i)
                i++
            end
            i++
            if not words.Has(key):
                keys.Push(key)
            end
            words.Put(key, body)
            continue
        end
        at := str.IndexOf(line, " = ")
        if at > 0:
            name := str.Trim(line.Substr(0, at))
            if not words.Has(name):
                keys.Push(name)
            end
            words.Put(name, line.Substr(at + 3, line.Len() - at - 3))
        end
    end
end

func plain(text: str): str:
    mut out := ""
    mut rest := text
    until rest.Find("<") >= 0:
        open_at := rest.Find("<")
        tail := rest.Substr(open_at, rest.Len() - open_at)
        close_at := tail.Find(">")
        if close_at < 0:
            break
        end
        out += rest.Substr(0, open_at)
        rest = tail.Substr(close_at + 1, tail.Len() - close_at - 1)
    end
    out = str.Trim(out + rest)
    out = str.Replace(str.Replace(out, "&lt;", "<"), "&gt;", ">")
    ret str.Replace(str.Replace(out, "&quot;", "\""), "&amp;", "&")
end

func literal(text: str): str:
    mut s := str.Replace(text, "\\", "\\\\")
    s = str.Replace(s, "\"", "\\\"")
    s = str.Replace(s, "\n", "\\n")
    s = str.Replace(s, "\t", "\\t")
    ret "\"" + str.Replace(s, "\r", "") + "\""
end

func words_source(words: HashMap<str, str>, keys: Vector<str>): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, "package words\n\npub func W(key: str): str:\n")
    each key in keys:
        str.BufAppend(
            b,
            "    if key == " + literal(key) + ":\n        ret " + literal(words.Get(key)) + "\n    end\n"
        )
    end
    str.BufAppend(b, "    ret key\nend\n")
    ret str.Clone(str.BufStr(b))
end

func load(root: str, lang: str, other: str, keys &: Vector<str>): HashMap<str, str>:
    mut words := HashMap {} as HashMap<str, str>
    content := root + "/content/" + lang
    each name in str.Split(SOURCES, ","):
        put_file(words, keys, content + "/" + name + ".txt")
    end
    each key in keys:
        if not str.EndsWith(key, "_cmd"):
            words.Put(key, plain(words.Get(key)))
        end
    end
    mut alt := HashMap {} as HashMap<str, str>
    mut alt_keys := Vector {} as Vector<str>
    put_file(alt, alt_keys, root + "/content/" + other + "/site.txt")
    words.Put("site.alt", alt.Get("site.url") + "/")
    words.Put("site.lang_name", alt.Get("site.lang_name"))
    words.Put("link.old", words.Get("site.url"))
    words.Put("link.install_cmd", words.Get("install.unix_cmd"))
    base := words.Has("site.base") ? words.Get("site.base") : ""
    words.Put("site.logo", base + "/logo.svg")
    digits := str.Split(lang == "fa" ? "۱,۲,۳" : "1,2,3", ",")
    repeat 3 in i:
        words.Put("home.n" + str.FromInt((i + 1) as i64), digits.Get(i))
    end
    words.Put("card.open", lang == "fa" ? "باز کردن" : "Open")
    examples := content + "/examples/"
    own := io.ReadFile(examples + "functions.salam")
    twin := io.ReadFile(examples + "twin_other.salam")
    words.Put("code.twin_en", str.Trim(lang == "en" ? own : twin))
    words.Put("code.twin_fa", str.Trim(lang == "fa" ? own : twin))
    words.Put("code.hero", str.Trim(io.ReadFile(examples + "hero.salam")))
    words.Put("code.hero_out", str.Trim(io.ReadFile(examples + "hero.out")))
    extra := [
        "site.alt", "site.lang_name", "link.old", "link.install_cmd", "site.logo", "home.n1",
        "home.n2", "home.n3", "card.open", "code.twin_en", "code.twin_fa", "code.hero",
        "code.hero_out"
    ]
    repeat extra.Len() in i:
        mut known := false
        each key in keys:
            if key == extra[i]:
                known = true
            end
        end
        if not known:
            keys.Push(extra[i])
        end
    end
    ret words
end

func fill(path: str, words: HashMap<str, str>):
    base := words.Has("site.base") ? words.Get("site.base") : ""
    mut s := io.ReadFile(path)
    pairs := [
        "SITE_TITLE", "index.title", "SITE_DESCRIPTION", "index.description",
        "SITE_COMMUNITY_TITLE", "community.title", "SITE_LANG", "site.lang", "SITE_DIR", "site.dir"
    ]
    repeat pairs.Len() / 2 in i:
        value := literal(words.Get(pairs[i * 2 + 1]))
        s = str.Replace(s, "\"" + pairs[i * 2] + "\"", value)
    end
    s = str.Replace(s, "\"SITE_BASE\"", literal(base.Len() == 0 ? "/" : base))
    s = str.Replace(s, "SITE_BASE", base)
    _w := io.WriteFile(path, s)
end

func copy_tree(from: str, dest: str, words: HashMap<str, str>):
    _m := dir.MkdirAll(dest)
    each name in dir.ListFiles(from):
        _w := io.WriteFile(dest + "/" + name, io.ReadFile(from + "/" + name))
        if str.EndsWith(name, ".salam"):
            fill(dest + "/" + name, words)
        end
    end
    each name in dir.ListDirs(from):
        copy_tree(from + "/" + name, dest + "/" + name, words)
    end
end

func paint_file(path: str, palette: HashMap<str, str>, names: Vector<str>):
    mut s := io.ReadFile(path)
    each name in names:
        s = str.Replace(s, "PAL_" + name + "\n", literal(palette.Get(name)) + "\n")
        s = str.Replace(s, "PAL_" + name + " ", literal(palette.Get(name)) + " ")
        s = str.Replace(s, "PAL_" + name + ")", literal(palette.Get(name)) + ")")
        s = str.Replace(s, "PAL_" + name + ",", literal(palette.Get(name)) + ",")
    end
    _w := io.WriteFile(path, s)
end

func paint_tree(path: str, palette: HashMap<str, str>, names: Vector<str>):
    each name in dir.ListFiles(path):
        if str.EndsWith(name, ".salam"):
            paint_file(path + "/" + name, palette, names)
        end
    end
    each name in dir.ListDirs(path):
        paint_tree(path + "/" + name, palette, names)
    end
end

func paint(src: str, file: str):
    mut palette := HashMap {} as HashMap<str, str>
    mut names := Vector {} as Vector<str>
    put_file(palette, names, file)
    paint_tree(src, palette, names)
end

func build(salam: str, root: str, lang: str, other: str): bool:
    mut keys := Vector {} as Vector<str>
    words := load(root, lang, other, keys)
    out := root + "/dist/app/" + lang
    src := out + "/src"
    if dir.Exists(out):
        _r := dir.RemoveAll(out)
    end
    app := root + "/app"
    copy_tree(app + "/components", src + "/components", words)
    copy_tree(app + "/pages", src + "/pages", words)
    _m := dir.MkdirAll(src + "/lib")
    _a := io.WriteFile(src + "/main.salam", io.ReadFile(app + "/main.salam"))
    fill(src + "/main.salam", words)
    _b := io.WriteFile(src + "/lib/site.salam", io.ReadFile(app + "/lib/site.salam"))
    _c := io.WriteFile(src + "/lib/words.salam", words_source(words, keys))
    paint(src, app + "/palette.txt")
    if dir.Copy(app + "/public", src + "/public") != 0:
        printerrln "website: cannot copy the public files"
        ret false
    end
    command := "cd " + src + " && " + salam + " build --platform=web --ssr=../site --no-color --log-level=error"
    if shell.System(command) != 0:
        printerrln "website: the " + lang + " site did not build"
        ret false
    end
    base := words.Has("site.base") ? words.Get("site.base") : ""
    if base.Len() > 1:
        nested := out + "/site/public" + base
        if dir.Exists(nested) and dir.Copy(nested, out + "/site/public") == 0:
            _n := dir.RemoveAll(nested)
        end
    end
    println "built", lang, "->", out + "/site/public"
    ret true
end

func main:
    salam := os.Env("SALAM")
    root := os.Env("SITE_ROOT")
    if salam.Len() == 0 or root.Len() == 0:
        printerrln "website: set SALAM to the compiler and SITE_ROOT to the website folder"
        ret 2
    end
    mut ok := build(salam, root, "fa", "en")
    ok = build(salam, root, "en", "fa") and ok
    ret ok ? 0 : 1
end
