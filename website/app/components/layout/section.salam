pub component SectionHeading(title: str, lead: str):
    box:
        gap = 4
        heading:
            size = 2
            margin = 0
            font size = 30
            line height = 1.4
            content = title
        end
        paragraph:
            margin = 0
            max width = 720
            color = PAL_MUTED
            content = lead
        end
    end
end

pub component Section(title: str, lead: str = ""):
    section:
        padding = 56, 0
        if compact:
            padding = 40, 0
        end
        background = PAL_BG
        Container:
            box:
                gap = 28
                SectionHeading: title = title lead = lead end
                content: end
            end
        end
    end
end

pub component TintedSection(title: str, lead: str = ""):
    section:
        padding = 56, 0
        if compact:
            padding = 40, 0
        end
        background = PAL_SOFT
        Container:
            box:
                gap = 28
                SectionHeading: title = title lead = lead end
                content: end
            end
        end
    end
end
