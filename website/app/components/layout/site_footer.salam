pub component SiteFooter:
    learn := site.LearnLinks()
    project := site.ProjectLinks()
    community := site.CommunityLinks()
    footer:
        background = PAL_SOFT
        border top = 1, "solid", PAL_LINE
        padding = 48, 0, 24
        Container:
            box:
                layout = "grid"
                columns = 2fr, 1fr, 1fr, 1fr
                gap = 32
                if screen width < 900:
                    columns = 1fr, 1fr
                end
                if compact:
                    columns = 1fr
                end
                box:
                    gap = 12
                    Brand: end
                    paragraph:
                        margin = 0
                        color = PAL_MUTED
                        content = site.T("footer.about")
                    end
                end
                FooterColumn: title = site.T("footer.learn") items = learn end
                FooterColumn: title = site.T("footer.project") items = project end
                FooterColumn: title = site.T("footer.community") items = community end
            end
            box:
                layout = "row"
                wrap = true
                justify = "between"
                gap = 12
                margin top = 32
                padding top = 20
                border top = 1, "solid", PAL_LINE
                color = PAL_MUTED
                font size = 14
                span: content = site.T("footer.copyright") end
                span: content = site.T("footer.license") end
            end
        end
    end
end

component FooterColumn(title: str, items: Vector<site.Item>):
    links := items
    box:
        gap = 6
        heading:
            size = 2
            margin = 0
            font size = 15
            content = title
        end
        each item in links:
            link:
                key = item.href
                url = item.href
                color = PAL_MUTED
                decoration = "none"
                font size = 15
                hover:
                    color = PAL_BRAND_TEXT
                end
                content = item.label
            end
        end
    end
end
