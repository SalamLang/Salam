pub component SiteHeader:
    menu := false
    links := site.Menu()
    header:
        position = "sticky"
        top = 0
        layer = 20
        background = PAL_SURFACE
        border bottom = 1, "solid", PAL_LINE
        Container:
            box:
                layout = "row"
                align = "center"
                gap = 16
                min height = 64
                Brand: end
                nav:
                    layout = "row"
                    gap = 4
                    grow = 1
                    if screen width < 900:
                        visible = false
                    end
                    each item in links:
                        NavLink: key = item.href href = item.href label = item.label end
                    end
                    CommunityLink: label = site.T("nav.community") end
                end
                box:
                    layout = "row"
                    align = "center"
                    gap = 8
                    if screen width < 900:
                        grow = 1
                        justify = "end"
                    end
                    NavLink: href = site.T("site.alt") label = site.T("site.lang_name") end
                    box:
                        if compact:
                            visible = false
                        end
                        ButtonLink: href = site.T("link.editor") label = site.T("nav.editor") end
                    end
                    theme toggle: end
                    button:
                        variant = "outline"
                        size = "icon"
                        aria label = site.T("a11y.menu")
                        if screen width >= 900:
                            visible = false
                        end
                        content = menu ? "✕" : "☰"
                        click = (): menu = not menu end
                    end
                end
            end
            if menu:
                nav:
                    gap = 2
                    padding = 8, 0, 16
                    each item in links:
                        NavLink: key = item.href href = item.href label = item.label end
                    end
                    CommunityLink: label = site.T("nav.community") end
                end
            end
        end
    end
end
