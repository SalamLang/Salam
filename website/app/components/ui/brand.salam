pub component Brand:
    name := site.T("site.brand")
    logo := site.T("site.logo")
    link:
        to = "/"
        layout = "row"
        align = "center"
        align self = "center"
        wrap text = false
        shrink = 0
        gap = 8
        decoration = "none"
        color = PAL_BRAND_TEXT
        font weight = 800
        font size = 19
        image:
            url = logo
            alt = ""
            width = 32
            height = 32
            max width = 32
            min width = 32
            shrink = 0
        end
        span: content = name end
    end
end
