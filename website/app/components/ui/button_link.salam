pub component ButtonLink(href: str, label: str):
    link:
        url = href == "" ? "#" : href
        layout = "row"
        align = "center"
        justify = "center"
        padding = 8, 18
        radius = 10
        decoration = "none"
        font weight = 700
        border = 1, "solid", PAL_BRAND
        background = PAL_BRAND
        color = PAL_BRAND_INK
        transition = 150ms
        hover:
            translate = 0, -1
        end
        content = label
    end
end

pub component QuietLink(href: str, label: str):
    link:
        url = href == "" ? "#" : href
        layout = "row"
        align = "center"
        justify = "center"
        padding = 8, 18
        radius = 10
        decoration = "none"
        font weight = 700
        border = 1, "solid", PAL_LINE
        background = PAL_SURFACE
        color = PAL_FG
        transition = 150ms
        hover:
            translate = 0, -1
        end
        content = label
    end
end
