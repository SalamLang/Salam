pub component CallToAction(title: str, text: str, href: str, label: str):
    section:
        padding = 56, 0
        Container:
            box:
                align = "center"
                gap = 12
                padding = 40, 24
                radius = 24
                text align = "center"
                background = PAL_BRAND_SOFT
                border = 1, "solid", PAL_BRAND
                heading:
                    size = 2
                    margin = 0
                    content = title
                end
                paragraph:
                    margin = 0
                    max width = 640
                    color = PAL_MUTED
                    content = text
                end
                ButtonLink: href = href label = label end
            end
        end
    end
end
