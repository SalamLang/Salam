pub component CardGrid:
    box:
        layout = "grid"
        columns = "repeat(3, 1fr)"
        gap = 16
        if screen width < 900:
            columns = "repeat(2, 1fr)"
        end
        if compact:
            columns = "1fr"
        end
        content: end
    end
end

pub component PairGrid:
    box:
        layout = "grid"
        columns = "repeat(2, 1fr)"
        gap = 16
        if screen width < 900:
            columns = "repeat(2, 1fr)"
        end
        if compact:
            columns = "1fr"
        end
        content: end
    end
end
