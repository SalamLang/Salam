pub component CodeWindow(name: str, code: str, side: str, output: str = ""):
    label := site.T("code.output")
    figure:
        margin = 0
        min width = 0
        radius = 16
        clip = true
        background = PAL_CODE_BG
        color = PAL_CODE_FG
        shadow = 0, 12, 40, rgba(0, 0, 0, 0.25)
        box:
            layout = "row"
            align = "center"
            gap = 8
            padding = 10, 16
            border bottom = 1, "solid", PAL_CODE_LINE
            direction = "ltr"
            span: width = 10 height = 10 radius = 5 background = "#3a3d45" end
            span: width = 10 height = 10 radius = 5 background = "#3a3d45" end
            span: width = 10 height = 10 radius = 5 background = "#3a3d45" end
            span: margin left = 8 font size = 13 color = PAL_CODE_MUTED content = name end
        end
        preformatted:
            margin = 0
            padding = 18
            overflow = "auto"
            font = "mono"
            font size = 14
            line height = 1.8
            dir = side
            code: content = code end
        end
        if output != "":
            box:
                padding = 14, 18
                gap = 4
                border top = 1, "dashed", PAL_CODE_LINE
                span: font size = 12 color = PAL_CODE_MUTED content = label end
                preformatted:
                    margin = 0
                    font = "mono"
                    font size = 14
                    color = PAL_CODE_STRING
                    dir = side
                    content = output
                end
            end
        end
    end
end
