pub component FaqItem(question: str, answer: str):
    details:
        padding = 14, 18
        radius = 12
        background = PAL_SURFACE
        border = 1, "solid", PAL_LINE
        summary:
            cursor = "pointer"
            font weight = 700
            content = question
        end
        paragraph:
            margin = 8, 0, 0
            color = PAL_MUTED
            content = answer
        end
    end
end
