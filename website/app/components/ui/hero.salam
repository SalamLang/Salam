pub component Hero:
    sample := site.T("code.hero")
    result := site.T("code.hero_out")
    section:
        padding = 72, 0
        if compact:
            padding = 40, 0
        end
        background = PAL_HERO
        Container:
            box:
                layout = "grid"
                columns = 1fr, 1fr
                gap = 48
                align = "center"
                if screen width < 900:
                    columns = 1fr
                    gap = 32
                end
                box:
                    gap = 20
                    min width = 0
                    span:
                        align self = "start"
                        padding = 2, 14
                        radius = 999
                        background = PAL_SURFACE
                        border = 1, "solid", PAL_LINE
                        color = PAL_BRAND_TEXT
                        font size = 14
                        font weight = 700
                        content = site.T("home.eyebrow")
                    end
                    heading:
                        size = 1
                        margin = 0
                        font size = 52
                        line height = 1.3
                        if compact:
                            font size = 36
                        end
                        content = site.T("home.title")
                    end
                    paragraph:
                        margin = 0
                        font size = 18
                        color = PAL_MUTED
                        content = site.T("home.lead")
                    end
                    box:
                        layout = "row"
                        wrap = true
                        gap = 12
                        ButtonLink: href = site.Old("/learn/") label = site.T("home.cta_learn") end
                        QuietLink: href = site.T("link.editor") label = site.T("home.cta_editor") end
                    end
                end
                CodeWindow: name = "hello.salam" code = sample output = result side = "SITE_DIR" end
            end
        end
    end
end
