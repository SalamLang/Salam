pub component InfoCard(title: str, text: str, icon: str = "", href: str = ""):
    action := site.T("card.open")
    article:
        gap = 8
        padding = 22
        radius = 16
        background = PAL_SURFACE
        border = 1, "solid", PAL_LINE
        transition = 150ms
        hover:
            border = 1, "solid", PAL_BRAND
            translate = 0, -2
        end
        if icon != "":
            span:
                width = 44
                height = 44
                radius = 12
                layout = "row"
                align = "center"
                justify = "center"
                font size = 20
                background = PAL_BRAND_SOFT
                color = PAL_BRAND_TEXT
                content = icon
            end
        end
        heading:
            size = 3
            margin = 0
            font size = 18
            content = title
        end
        paragraph:
            margin = 0
            color = PAL_MUTED
            font size = 15
            content = text
        end
        if href != "":
            link:
                url = href == "" ? "#" : href
                color = PAL_BRAND_TEXT
                decoration = "none"
                font weight = 700
                content = action
            end
        end
    end
end
