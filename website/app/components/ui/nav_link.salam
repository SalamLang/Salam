pub component NavLink(href: str, label: str):
    link:
        url = href == "" ? "#" : href
        padding = 6, 10
        radius = 8
        color = PAL_FG
        decoration = "none"
        font size = 15
        transition = 150ms
        hover:
            background = PAL_BRAND_SOFT
            color = PAL_BRAND_TEXT
        end
        content = label
    end
end

pub component CommunityLink(label: str):
    link:
        to = "/community"
        padding = 6, 10
        radius = 8
        color = PAL_FG
        decoration = "none"
        font size = 15
        transition = 150ms
        hover:
            background = PAL_BRAND_SOFT
            color = PAL_BRAND_TEXT
        end
        content = label
    end
end
