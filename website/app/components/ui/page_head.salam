pub component PageHead(title: str, lead: str):
    section:
        padding = 64, 0, 40
        background = PAL_BRAND_SOFT
        Container:
            heading:
                size = 1
                margin = 0
                font size = 40
                line height = 1.35
                if compact:
                    font size = 30
                end
                content = title
            end
            paragraph:
                margin = 8, 0, 0
                max width = 720
                font size = 18
                color = PAL_MUTED
                content = lead
            end
        end
    end
end
