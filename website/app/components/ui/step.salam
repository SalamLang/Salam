pub component Step(number: str, title: str, text: str, command: str):
    article:
        gap = 10
        min width = 0
        padding = 22
        radius = 16
        background = PAL_SURFACE
        border = 1, "solid", PAL_LINE
        span:
            width = 36
            height = 36
            radius = 18
            layout = "row"
            align = "center"
            justify = "center"
            background = PAL_BRAND
            color = PAL_BRAND_INK
            font weight = 800
            content = number
        end
        heading:
            size = 3
            margin = 0
            font size = 18
            content = title
        end
        paragraph:
            margin = 0
            grow = 1
            color = PAL_MUTED
            font size = 15
            content = text
        end
        preformatted:
            margin = 0
            padding = 12
            radius = 10
            overflow = "auto"
            direction = "ltr"
            font = "mono"
            font size = 13
            background = PAL_CODE_BG
            color = PAL_CODE_FG
            content = command
        end
    end
end
