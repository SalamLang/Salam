package site

import str

include words "words.salam"

pub struct Item:
    pub href: str = ""
    pub label: str = ""
    pub note: str = ""
    pub icon: str = ""
end

func item(href: str, label: str): Item:
    ret Item { href = href, label = label }
end

func card(icon: str, label: str, note: str): Item:
    ret Item { icon = icon, label = label, note = note }
end

func old_page(path: str): str:
    ret words.W("link.old") + path
end

pub func T(key: str): str:
    ret words.W(key)
end

pub func Old(path: str): str:
    ret old_page(path)
end

pub func Menu(): Vector<Item>:
    mut v := Vector {} as Vector<Item>
    v.Push(item(old_page("/learn/"), T("nav.learn")))
    v.Push(item(old_page("/std/"), T("nav.std")))
    v.Push(item(old_page("/speed/"), T("nav.speed")))
    v.Push(item(old_page("/install/"), T("nav.install")))
    v.Push(item(old_page("/tools/"), T("nav.tools")))
    ret v
end

pub func Features(): Vector<Item>:
    mut v := Vector {} as Vector<Item>
    repeat 1 to 6 in i:
        k := "home.f" + str.FromInt(i as i64)
        v.Push(card(T(k + "_icon"), T(k + "_title"), T(k + "_text")))
    end
    ret v
end

pub func Steps(): Vector<Item>:
    mut v := Vector {} as Vector<Item>
    repeat 1 to 3 in i:
        k := "home.s" + str.FromInt(i as i64)
        mut c := card(T("home.n" + str.FromInt(i as i64)), T(k + "_title"), T(k + "_text"))
        c.href = i > 1 ? T(k + "_cmd") : T("link.install_cmd")
        v.Push(c)
    end
    ret v
end

pub func Questions(): Vector<Item>:
    mut v := Vector {} as Vector<Item>
    repeat 1 to 7 in i:
        k := "faq." + str.FromInt(i as i64)
        v.Push(card("", T(k + ".q"), T(k + ".a")))
    end
    ret v
end

pub func LearnLinks(): Vector<Item>:
    mut v := Vector {} as Vector<Item>
    v.Push(item(old_page("/learn/"), T("nav.learn")))
    v.Push(item(old_page("/std/"), T("nav.std")))
    v.Push(item(old_page("/install/"), T("nav.install")))
    v.Push(item(old_page("/blog/"), T("nav.blog")))
    v.Push(item(T("link.editor"), T("nav.editor")))
    ret v
end

pub func ProjectLinks(): Vector<Item>:
    mut v := Vector {} as Vector<Item>
    v.Push(item(old_page("/packages/"), T("nav.packages")))
    v.Push(item(old_page("/brand/"), T("nav.brand")))
    v.Push(item(old_page("/ai/"), T("nav.ai")))
    v.Push(item(old_page("/agent/"), T("nav.agent")))
    v.Push(item(T("link.releases"), T("footer.releases")))
    v.Push(item(T("link.github"), T("footer.source")))
    ret v
end

pub func CommunityLinks(): Vector<Item>:
    mut v := Vector {} as Vector<Item>
    v.Push(item(old_page("/register/"), T("footer.register")))
    v.Push(item(T("link.telegram_channel"), T("footer.telegram_channel")))
    v.Push(item(T("link.telegram"), T("footer.telegram")))
    v.Push(item(T("link.discord"), T("footer.discord")))
    v.Push(item(T("link.eitaa"), T("footer.eitaa")))
    v.Push(item(T("link.bale"), T("footer.bale")))
    v.Push(item(T("link.issues"), T("footer.issues")))
    ret v
end

pub func Channels(): Vector<Item>:
    mut v := Vector {} as Vector<Item>
    each name in ["github", "telegram_channel", "telegram", "discord", "eitaa", "bale", "issues"]:
        mut c := card(
            "", T("community." + name + "_title"), T("community." + name + "_text")
        )
        c.href = T("link." + name)
        v.Push(c)
    end
    ret v
end

pub func Ways(): Vector<Item>:
    mut v := Vector {} as Vector<Item>
    repeat 1 to 4 in i:
        k := "community.c" + str.FromInt(i as i64)
        v.Push(card("", T(k + "_title"), T(k + "_text")))
    end
    ret v
end
