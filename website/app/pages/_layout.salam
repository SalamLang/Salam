pub component SiteLayout:
    box:
        min height = 100vh
        background = PAL_BG
        color = PAL_FG
        line height = 1.8
        SiteHeader: end
        box:
            id = "main"
            grow = 1
            Outlet: end
        end
        SiteFooter: end
    end
end
