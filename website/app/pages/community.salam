pub component Community:
    title = "SITE_COMMUNITY_TITLE"
    channels := site.Channels()
    ways := site.Ways()
    PageHead: title = site.T("community.heading") lead = site.T("community.lead") end
    Section:
        title = site.T("community.story_title")
        lead = site.T("community.story_text")
        CardGrid:
            each c in channels:
                InfoCard: key = c.href title = c.label text = c.note href = c.href end
            end
        end
    end
    TintedSection:
        title = site.T("community.contribute_title")
        lead = site.T("community.contribute_text")
        PairGrid:
            each w in ways:
                InfoCard: key = w.label title = w.label text = w.note end
            end
        end
    end
    CallToAction:
        title = site.T("community.cta_title")
        text = site.T("community.cta_text")
        href = site.T("link.contributing")
        label = site.T("community.cta_button")
    end
end
