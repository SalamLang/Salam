pub component Home:
    title = "SITE_TITLE"
    features := site.Features()
    steps := site.Steps()
    questions := site.Questions()
    Hero: end
    Section:
        title = site.T("home.features_title")
        lead = site.T("home.features_lead")
        CardGrid:
            each f in features:
                InfoCard: key = f.label title = f.label text = f.note icon = f.icon end
            end
        end
    end
    TintedSection:
        title = site.T("home.twin_title")
        lead = site.T("home.twin_lead")
        PairGrid:
            CodeWindow: name = "english.salam" code = site.T("code.twin_en") side = "ltr" end
            CodeWindow: name = "persian.salam" code = site.T("code.twin_fa") side = "rtl" end
        end
    end
    Section:
        title = site.T("home.start_title")
        lead = site.T("home.start_lead")
        CardGrid:
            each s in steps:
                Step: key = s.label number = s.icon title = s.label text = s.note command = s.href end
            end
        end
    end
    TintedSection:
        title = site.T("home.faq_title")
        box:
            gap = 10
            each q in questions:
                FaqItem: key = q.label question = q.label answer = q.note end
            end
        end
    end
    CallToAction:
        title = site.T("home.cta_title")
        text = site.T("home.cta_text")
        href = site.T("link.editor")
        label = site.T("home.cta_editor")
    end
end
