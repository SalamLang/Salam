    pub slug: str = ""
    pub url: str = ""
    pub title: str = ""
    pub category: str = ""
    pub summary: str = ""
    pub date: str = ""
    pub updated: str = ""
    pub image: str = ""
    pub image_alt: str = ""
end

struct ApiDecl:
    pub k: str = ""
    pub n: str = ""
    pub s: str = ""
    pub p: bool = false
    pub dep: bool = false
    pub f: int = 0
    pub l: int = 0
    pub par: int = 0
    pub a: Vector<Vector<str>> = Vector {}
