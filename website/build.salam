    pub group: str = ""
    pub summary: str = ""
    pub imp: str = ""
end

func report(errs &: Vector<str>, msg: str):
    errs.Push(msg)
end

func strip_cr(s: str): str:
    ret str.TrimSuffix(s, "\r")
end

func load_strings(path: str, ctx &: HashMap<str, str>, errs &: Vector<str>):
    lines := io.ReadFile(path).Split("\n")
    mut i := 0
    until i < lines.Len():
        line := strip_cr(lines.Get(i))
        t := str.Trim(line)
        i++
        if t.Len() == 0 or str.StartsWith(t, "#"):
            continue
        end
        mut key := ""
        mut value := ""
        if str.EndsWith(t, "<<"):
            key = str.Trim(str.TrimSuffix(t, "<<"))
            mut parts := Vector {} as Vector<str>
            mut closed := false
            until i < lines.Len():
                body := strip_cr(lines.Get(i))
                i++
                if str.Trim(body) == ">>":
                    closed = true
                    break
                end
                parts.Push(body)
            end
            if not closed:
                report(errs, path + ": block '" + key + "' has no closing >>")
            end
            value = str.Join(parts, "\n")
        else:
            pos := t.Find("=")
            if pos <= 0:
                report(errs, path + ": expected 'key = value', got: " + t)
                continue
            end
            key = str.Trim(t.Substr(0, pos))
            value = str.Trim(t.Substr(pos + 1, t.Len() - pos - 1))
        end
        if ctx.Has(key):
            report(errs, path + ": duplicate key '" + key + "'")
        end
        if str.EndsWith(key, "_cmd"):
            value = template.EscapeHTML(value)
        else str.Contains(key, "_code_"):
            cut := str.LastIndex(key, "_code_") + 6
            value = highlight_lang(value, str.Substr(key, cut, key.Len() - cut))
        end
        ctx.Put(key, value)
    end
end

func escape_cp(b &: str.StringBuilder, cp: int):
    if cp == 38:
        str.BufAppend(b, "&amp;")
    else cp == 60:
        str.BufAppend(b, "&lt;")
    else cp == 62:
        str.BufAppend(b, "&gt;")
    else cp == 34:
        str.BufAppend(b, "&quot;")
    else:
        str.BufAppendCp(b, cp)
    end
end

func escape_span(b &: str.StringBuilder, cps: Vector<int>, start: int, stop: int):
    mut k := start
    until k < stop:
        escape_cp(b, cps.Get(k))
        k++
    end
end

func text_of(cps: Vector<int>, start: int, stop: int): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut k := start
    until k < stop:
        str.BufAppendCp(b, cps.Get(k))
        k++
    end
    ret str.BufStr(b)
end

func wrap(b &: str.StringBuilder, class: str, cps: Vector<int>, start: int, stop: int):
    str.BufAppend(b, `<span class="tok-` + class + `">`)
    escape_span(b, cps, start, stop)
    str.BufAppend(b, "</span>")
end

func is_ident_cp(cp: int): bool:
    if cp == 95:
        ret true
    end
    if cp < 128:
        ret str.IsAsciiAlnum(cp)
    end
    ret cp != 1548 and cp != 1563 and cp != 1567 and cp != 171 and cp != 187 and cp != 160
end

func next_visible(cps: Vector<int>, start: int): int:
    mut k := start
    until k < cps.Len():
        cp := cps.Get(k)
        if cp != 32 and cp != 9:
            ret cp
        end
        k++
    end
    ret 0 - 1
end

func closes_triple(cps: Vector<int>, at: int, quote: int): bool:
    ret at + 2 < cps.Len() and cps.Get(at) == quote and cps.Get(at + 1) == quote and cps.Get(at + 2) == quote
end

func comment_starts_here(cps: Vector<int>, i: int): bool:
    if i == 0:
        ret true
    end
    prev := cps.Get(i - 1)
    ret prev == 32 or prev == 9 or prev == 10
end

func name_run_end(cps: Vector<int>, start: int): int:
    n := cps.Len()
    mut k := start
    until k < n:
        mut m := k
        until m < n and (cps.Get(m) == 32 or cps.Get(m) == 9):
            m++
        end
        if m == k or m >= n or not is_ident_cp(cps.Get(m)) or str.IsAnyDigit(cps.Get(m)):
            break
        end
        mut e := m + 1
        until e < n and is_ident_cp(cps.Get(e)):
            e++
        end
        k = e
    end
    if k == start:
        ret start
    end
    after := next_visible(cps, k)
    if after == 40 or after == 58 or after == 61 or after == 60 or after == 91:
        ret k
    end
    ret start
end

func highlight_with(code: str, classes: HashMap<str, str>, slash: bool, hash: bool, squote: bool): str:
    cps := str.CodePoints(code)
    n := cps.Len()
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut i := 0
    mut pending := ""
    until i < n:
        cp := cps.Get(i)
        nx := i + 1 < n ? cps.Get(i + 1) : 0 - 1
        mut j := i + 1
        if not is_ident_cp(cp) and cp != 32 and cp != 9:
            pending = ""
        end
        if slash and cp == 47 and nx == 47:
            until j < n and cps.Get(j) != 10:
                j++
            end
            wrap(b, "c", cps, i, j)
        else slash and cp == 47 and nx == 42:
            j = i + 2
            until j < n and not (cps.Get(j) == 42 and j + 1 < n and cps.Get(j + 1) == 47):
                j++
            end
            j = j + 2 > n ? n : j + 2
            wrap(b, "c", cps, i, j)
        else hash and cp == 35 and comment_starts_here(cps, i):
            until j < n and cps.Get(j) != 10:
                j++
            end
            wrap(b, "c", cps, i, j)
        else squote and (cp == 34 or cp == 39) and closes_triple(cps, i, cp):
            j = i + 3
            until j < n and not closes_triple(cps, j, cp):
                j++
            end
            j = j < n ? j + 3 : n
            wrap(b, "s", cps, i, j)
        else cp == 34 or (squote and cp == 39):
            until j < n and cps.Get(j) != cp and cps.Get(j) != 10:
                if cps.Get(j) == 92:
                    j++
                end
                j++
            end
            j = j < n ? j + 1 : n
            wrap(b, "s", cps, i, j)
        else cp == 96:
            until j < n and cps.Get(j) != 96:
                j++
            end
            j = j < n ? j + 1 : n
            wrap(b, "s", cps, i, j)
        else str.IsAnyDigit(cp):
            until j < n and (str.IsAnyDigit(cps.Get(j)) or cps.Get(j) == 46 or cps.Get(j) == 95):
                j++
            end
            wrap(b, "n", cps, i, j)
        else is_ident_cp(cp):
            until j < n and is_ident_cp(cps.Get(j)):
                j++
            end
            word := text_of(cps, i, j)
            if pending != "":
                j = name_run_end(cps, j)
                wrap(b, pending, cps, i, j)
                pending = ""
            else classes.Has(word):
                wrap(b, classes.Get(word), cps, i, j)
                pending = classes.Has("decl:" + word) ? classes.Get("decl:" + word) : ""
            else next_visible(cps, j) == 40:
                wrap(b, "f", cps, i, j)
            else:
                escape_span(b, cps, i, j)
            end
        else:
            escape_cp(b, cp)
        end
        i = j
    end
    ret str.BufStr(b)
end

func highlight(code: str, classes: HashMap<str, str>): str:
    ret highlight_with(code, classes, true, false, false)
end

func add_class_words(classes &: HashMap<str, str>, words: str, class: str):
    each w in str.Fields(words):
        classes.Put(w, class)
    end
end

func highlight_lang(code: str, lang: str): str:
    mut classes := HashMap {} as HashMap<str, str>
    mut slash := false
    mut hash := false
    mut squote := true
    mut known := false
    switch lang:
        "python", "py":
            known = true
            hash = true
            add_class_words(classes, "and as assert async await break class continue def del elif else except finally for from global if import in is lambda nonlocal not or pass raise return try while with yield True False None", "k")
            add_class_words(classes, "int str float bool list dict set tuple bytes object", "t")
            add_class_words(classes, "print len range open isinstance super self cls enumerate zip map filter sorted sum min max input", "b")
            break
        end
        "javascript", "js", "typescript", "ts", "jsx", "tsx":
            known = true
            slash = true
            add_class_words(classes, "const let var function return if else for while do switch case break continue new class extends import from export default async await try catch finally throw typeof instanceof in of null undefined true false this interface type enum implements public private readonly static yield void delete", "k")
            add_class_words(classes, "string number boolean any unknown never Promise Array Map Set Record", "t")
            add_class_words(classes, "console require JSON Math Object process document window fetch Error", "b")
            break
        end
        "bash", "sh", "shell", "zsh", "console":
            known = true
            hash = true
            add_class_words(classes, "if then else elif fi for while until do done case esac in function return exit export local set unset", "k")
            add_class_words(classes, "echo cd curl wget cat grep sed awk git docker claude npm npx pip python python3 sudo sh bash ls mkdir rm cp mv chmod tar kill source", "b")
            break
        end
        "json":
            known = true
            squote = false
            add_class_words(classes, "true false null", "k")
            break
        end
        "yaml", "yml", "toml", "ini":
            known = true
            hash = true
            add_class_words(classes, "true false null yes no on off", "k")
            break
        end
        "c", "cpp", "java", "go", "rust", "rs", "php", "zig", "cs", "csharp", "kotlin", "swift":
            known = true
            slash = true
            hash = lang == "php"
            add_class_words(classes, "if else for while do switch case break continue return struct enum union typedef static const extern class public private protected new delete this null true false func package import var type interface go defer range chan map fn let mut impl trait pub use mod match loop where self as in unsafe async await function echo foreach using namespace val fun override try catch throw comptime errdefer orelse", "k")
            add_class_words(classes, "int char void long short unsigned signed float double bool size_t uint8_t uint32_t uint64_t int32_t int64_t string byte rune i8 i16 i32 i64 u8 u16 u32 u64 usize isize f32 f64 str String Vec Option Result Box", "t")
            add_class_words(classes, "printf fprintf malloc free sizeof println fmt print Console std", "b")
            break
        end
        "julia", "jl":
            known = true
            hash = true
            add_class_words(classes, "function end if elseif else for while return using import module struct mutable begin let do in true false nothing", "k")
            add_class_words(classes, "Int Int64 Float64 String Bool Vector Array Matrix", "t")
            add_class_words(classes, "println print length zeros ones rand sum", "b")
            break
        end
    end
    if not known:
        ret template.EscapeHTML(code)
    end
    ret highlight_with(code, classes, slash, hash, squote)
end

func escape_text(s: str): str:
    ret template.EscapeHTML(s)
end

func has_rtl_script(s: str): bool:
    each cp in str.CodePoints(s):
        if cp >= 1424 and cp <= 2303:
            ret true
        end
    end
    ret false
end

func label(ctx: HashMap<str, str>, key: str, errs &: Vector<str>): str:
    if not ctx.Has(key):
        report(errs, "missing string '" + key + "'")
        ret ""
    end
    ret ctx.Get(key)
end

func is_page_source(src: str): bool:
    each line in str.Split(src, "\n"):
        if str.Equals(str.TrimRight(line), "page:") or str.Equals(str.TrimRight(line), "صفحه:"):
            ret true
        end
    end
    ret false
end

func shell_quote(s: str): str:
    ret "'" + str.Replace(s, "'", "'\\''") + "'"
end

func attr_escape(s: str): str:
    ret str.Replace(str.Replace(str.Replace(str.Replace(s, "&", "&amp;"), "\"", "&quot;"), "<", "&lt;"), ">", "&gt;")
end

func preview_cache_path(src_path: str): str:
    base := os.Env("SITE_PREVIEW_CACHE")
    if base.Len() == 0:
        ret ""
    end
    ret base + "/" + fs.Sha256Hex(src_path) + ".html"
end

func preview_batch(work: str, stems: Vector<str>):
    mut list := str.NewBuilder()
    defer str.BufFree(list)
    each stem in stems:
        str.BufAppend(list, stem + "\n")
    end
    _wl := os.WriteFile(work + "/list", str.BufStr(list))
    mut compiler := os.Env("SALAM")
    if compiler.Len() == 0:
        compiler = "salam"
    end
    run := "cd " + shell_quote(work) + " && SITE_PV_SALAM=" + shell_quote(compiler) + " SITE_PV_STD=" + shell_quote(os.Cwd() + "/std") + " xargs -n 1 -P \"$(nproc 2>/dev/null || echo 4)\" sh -c 'cd \"$1\" && SALAM_STD=\"$SITE_PV_STD\" \"$SITE_PV_SALAM\" page build \"$1.salam\" --inline --no-color --log-level=error > \"$1.log\" 2>&1; echo $? > \"$1.code\"' sh < list"
    _res := os.RunCapture(run)
end

func preview_collect(work: str, stem: str, _errs &: Vector<str>): str:
    dir_path := work + "/" + stem
    html_path := dir_path + "/" + stem + ".html"
    code_path := dir_path + "/" + stem + ".code"
    _log := fs.Exists(dir_path + "/" + stem + ".log") ? io.ReadFile(dir_path + "/" + stem + ".log") : ""
    if not fs.Exists(code_path) or not str.Equals(str.TrimRight(io.ReadFile(code_path)), "0") or not fs.Exists(html_path):
        println "website: preview of example '" + stem + "' failed (skipped)"
        ret ""
    end
    ret io.ReadFile(html_path)
end

func preview_finish(html: str): str:
    at := str.LastIndex(html, "</body>")
    if at >= 0:
        ret html.Substr(0, at) + PREVIEW_SCRIPT + html.Substr(at, html.Len() - at)
    end
    ret html
end

func example_block(name: str, src: str, code_html: str, out_html: str, page_html: str, ctx: HashMap<str, str>, errs &: Vector<str>): str:
    dir_attr := has_rtl_script(src) ? "rtl" : "ltr"
    id := "ex-" + name
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, `<div class="code-window">`)
    str.BufAppend(b, `<div class="code-bar"><span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>`)
    str.BufAppend(b, `<span class="file" dir="ltr">` + name + ".salam</span>")
    str.BufAppend(b, `<button type="button" class="copy-button" data-copy-target="` + id + `" data-copied="` + escape_text(label(ctx, "code.copied", errs)) + `">` + label(ctx, "code.copy", errs) + "</button></div>")
    str.BufAppend(b, `<pre class="code" dir="` + dir_attr + `"><code id="` + id + `">` + code_html + "</code></pre>")
    if page_html.Len() > 0:
        str.BufAppend(b, `<div class="code-preview" data-label="` + escape_text(label(ctx, "code.preview", errs)) + `"><iframe id="pv-` + name + `" name="` + name + `" class="preview-frame" sandbox="allow-scripts allow-modals allow-forms" loading="lazy" title="` + escape_text(label(ctx, "code.preview", errs)) + `" srcdoc="` + attr_escape(page_html) + `"></iframe></div>`)
    end
    if out_html.Len() > 0:
        str.BufAppend(b, `<div class="code-output" dir="` + dir_attr + `"><span class="label">` + label(ctx, "code.output", errs) + "</span>" + out_html + "</div>")
    end
    str.BufAppend(b, "</div>")
    ret str.BufStr(b)
end

func add_table_words(out &: Vector<str>, raw: str):
    each item in json.Items(raw):
        word := json.Unquote(item)
        if not str.Contains(word, " "):
            out.Push(word)
        end
    end
end

func load_code_words(ctx &: HashMap<str, str>, errs &: Vector<str>):
    if not fs.Exists(KEYWORD_TABLE):
        errs.Push(KEYWORD_TABLE + " is missing")
        ret
    end
    table := io.ReadFile(KEYWORD_TABLE)
    mut kw := Vector {} as Vector<str>
    mut ty := Vector {} as Vector<str>
    mut bi := Vector {} as Vector<str>
    mut df := Vector {} as Vector<str>
    mut dt := Vector {} as Vector<str>
    each key in json.Keys(table):
        raw := json.Get(table, key)
        if key == "func":
            add_table_words(df, raw)
        else key == "struct" or key == "enum" or key == "interface" or key == "type" or key == "package" or key == "component" or key == "impl":
            add_table_words(dt, raw)
        end
        if key == "types" or key == "intrinsic_types":
            add_table_words(ty, raw)
        else key == "print" or key == "println" or key == "printerr" or key == "printerrln" or key == "input":
            add_table_words(bi, raw)
        else key != "contextual":
            add_table_words(kw, raw)
        end
    end
    ctx.Put("code.keywords", str.Join(kw, " "))
    ctx.Put("code.types", str.Join(ty, " "))
    ctx.Put("code.builtins", str.Join(bi, " "))
    ctx.Put("code.decl_func", str.Join(df, " "))
    ctx.Put("code.decl_type", str.Join(dt, " "))
end

func code_classes(ctx: HashMap<str, str>): HashMap<str, str>:
    mut classes := HashMap {} as HashMap<str, str>
    add_class_words(classes, ctx.Has("code.keywords") ? ctx.Get("code.keywords") : "", "k")
    add_class_words(classes, ctx.Has("code.types") ? ctx.Get("code.types") : "", "t")
    add_class_words(classes, ctx.Has("code.builtins") ? ctx.Get("code.builtins") : "", "b")
    each w in str.Fields(ctx.Has("code.decl_func") ? ctx.Get("code.decl_func") : ""):
        classes.Put("decl:" + w, "f")
    end
    each w in str.Fields(ctx.Has("code.decl_type") ? ctx.Get("code.decl_type") : ""):
        classes.Put("decl:" + w, "t")
    end
    ret classes
end

func load_examples(lang_dir: str, ctx &: HashMap<str, str>, errs &: Vector<str>):
    classes := code_classes(ctx)
    ex_dir := lang_dir + "/examples"
    if not dir.Exists(ex_dir):
        ret
    end
    mut stems := Vector {} as Vector<str>
    mut srcs := Vector {} as Vector<str>
    mut outs := Vector {} as Vector<str>
    mut previews := HashMap {} as HashMap<str, str>
    mut missing := Vector {} as Vector<str>
    work := os.TempDir() + "/salam-site-preview-" + str.FromInt(os.Pid() as i64) + "-" + str.Replace(lang_dir, "/", "-")
    _rm := os.RemoveAll(work)
    _mk := os.MkdirAll(work)
    each name in dir.ListFiles(ex_dir):
        if not str.EndsWith(name, ".salam"):
            continue
        end
        stem := str.TrimSuffix(name, ".salam")
        src := str.TrimRight(io.ReadFile(ex_dir + "/" + name))
        out_path := ex_dir + "/" + stem + ".out"
        sample_path := ex_dir + "/" + stem + ".sample"
        mut out_html := ""
        if fs.Exists(out_path):
            out_html = escape_text(str.TrimRight(io.ReadFile(out_path)))
        else fs.Exists(sample_path):
            out_html = escape_text(str.TrimRight(io.ReadFile(sample_path)))
        end
        if out_html.Len() == 0 and not fs.Exists(ex_dir + "/" + stem + ".server") and is_page_source(src):
            cache_path := preview_cache_path(ex_dir + "/" + name)
            if cache_path.Len() > 0 and fs.Exists(cache_path):
                previews.Put(stem, preview_finish(io.ReadFile(cache_path)))
            else:
                _mkd := os.MkdirAll(work + "/" + stem)
                _wr := os.WriteFile(work + "/" + stem + "/" + stem + ".salam", src + "\n")
                missing.Push(stem)
            end
        end
        stems.Push(stem)
        srcs.Push(src)
        outs.Push(out_html)
    end
    if missing.Len() > 0:
        preview_batch(work, missing)
        each stem in missing:
            html := preview_collect(work, stem, errs)
            if html.Len() > 0:
                cache_path := preview_cache_path(ex_dir + "/" + stem + ".salam")
                if cache_path.Len() > 0:
                    _cm := os.MkdirAll(os.Env("SITE_PREVIEW_CACHE"))
                    _cw := fs.WriteText(cache_path, html)
                end
                previews.Put(stem, preview_finish(html))
            end
        end
    end
    _rm2 := os.RemoveAll(work)
    repeat stems.Len() in i:
        stem := stems.Get(i)
        page_html := previews.Has(stem) ? previews.Get(stem) : ""
        ctx.Put("example." + stem, example_block(ctx_or(ctx, "exname." + stem, stem), srcs.Get(i), highlight(srcs.Get(i), classes), outs.Get(i), page_html, ctx, errs))
    end
end

func check_tags(name: str, tmpl: str, ctx: HashMap<str, str>, errs &: Vector<str>):
    mut i := 0
    until true:
        lb := str.IndexFrom(tmpl, "{{", i)
        if lb < 0:
            break
        end
        rb := str.IndexFrom(tmpl, "}}", lb + 2)
        if rb < 0:
            report(errs, name + ": unclosed {{")
            break
        end
        mut tag := str.Trim(tmpl.Substr(lb + 2, rb - lb - 2))
        i = rb + 2
        if tag == "else" or tag == "/if" or str.StartsWith(tag, "!"):
            continue
        end
        if str.StartsWith(tag, "#if "):
            tag = str.Trim(str.TrimPrefix(tag, "#if "))
        end
        if not ctx.Has(tag):
            report(errs, name + ": no value for '" + tag + "'")
        end
    end
end

func render(name: str, tmpl: str, ctx: HashMap<str, str>, errs &: Vector<str>): str:
    check_tags(name, tmpl, ctx, errs)
    ret template.Render(tmpl, ctx)
end

func json_str(v: str): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppendChar(b, 34)
    each cp in str.CodePoints(v):
        if cp == 34:
            str.BufAppend(b, "\\\"")
        else cp == 92:
            str.BufAppend(b, "\\\\")
        else cp == 10:
            str.BufAppend(b, "\\n")
        else cp == 13:
            str.BufAppend(b, "\\r")
        else cp == 9:
            str.BufAppend(b, "\\t")
        else cp == 60:
            str.BufAppend(b, "\\u003c")
        else cp < 32:
            str.BufAppend(b, " ")
        else:
            str.BufAppendCp(b, cp)
        end
    end
    str.BufAppendChar(b, 34)
    ret str.BufStr(b)
end

func strip_tags(v: str): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut inside := false
    each cp in str.CodePoints(v):
        if cp == 60:
            inside = true
        else cp == 62:
            inside = false
        else not inside:
            str.BufAppendCp(b, cp)
        end
    end
    ret str.Trim(str.BufStr(b))
end

func ctx_or(ctx: HashMap<str, str>, key: str, fallback: str): str:
    if ctx.Has(key):
        ret ctx.Get(key)
    end
    ret fallback
end

func json_list(items: str): str:
    mut parts := Vector {} as Vector<str>
    each it in items.Split("|"):
        t := str.Trim(it)
        if t.Len() > 0:
            parts.Push(json_str(t))
        end
    end
    ret "[" + str.Join(parts, ",") + "]"
end

func faq_count(ctx: HashMap<str, str>): int:
    mut n := 0
    until ctx.Has("faq." + (n + 1) + ".q"):
        n++
    end
    ret n
end

func faq_html(ctx: HashMap<str, str>): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut i := 1
    until i <= faq_count(ctx):
        str.BufAppend(b, `<details class="faq-item"><summary><h3>` + ctx.Get("faq." + i + ".q") + "</h3></summary><div class=\"faq-answer\"><p>" + ctx.Get("faq." + i + ".a") + "</p></div></details>\n")
        i++
    end
    ret str.BufStr(b)
end

func faq_jsonld(ctx: HashMap<str, str>): str:
    mut items := Vector {} as Vector<str>
    mut i := 1
    until i <= faq_count(ctx):
        q := json_str(strip_tags(ctx.Get("faq." + i + ".q")))
        answer := json_str(strip_tags(ctx.Get("faq." + i + ".a")))
        items.Push(`{"@type":"Question","name":` + q + `,"acceptedAnswer":{"@type":"Answer","text":` + answer + "}}")
        i++
    end
    ret `{"@type":"FAQPage","mainEntity":[` + str.Join(items, ",") + "]}"
end

func modified_prop(ctx: HashMap<str, str>): str:
    m := ctx_or(ctx, "page.modified", "")
    ret m.Len() > 0 ? `,"dateModified":` + json_str(m) : ""
end

func site_nodes(ctx: HashMap<str, str>, version: str, graph &: Vector<str>):
    u := ctx_or(ctx, "site.url", "")
    tag := ctx_or(ctx, "site.lang_tag", ctx_or(ctx, "site.lang", ""))
    org := u + "/#organization"
    logo := u + ctx_or(ctx, "site.logo_png", "")
    graph.Push(`{"@type":"Organization","@id":` + json_str(org) + `,"name":` + json_str(ctx_or(ctx, "site.org_name", "")) + `,"url":` + json_str(u + "/") + `,"logo":{"@type":"ImageObject","url":` + json_str(logo) + `},"sameAs":` + json_list(ctx_or(ctx, "site.same_as", "")) + "}")
    graph.Push(`{"@type":"WebSite","@id":` + json_str(u + "/#website") + `,"name":` + json_str(ctx_or(ctx, "site.name", "")) + `,"alternateName":` + json_list(ctx_or(ctx, "site.alternate_names", "")) + `,"url":` + json_str(u + "/") + `,"inLanguage":` + json_str(tag) + `,"publisher":{"@id":` + json_str(org) + "}}")
    graph.Push(`{"@type":"ComputerLanguage","@id":` + json_str(u + "/#language") + `,"name":` + json_str(ctx_or(ctx, "site.short_name", "")) + `,"alternateName":` + json_list(ctx_or(ctx, "site.alternate_names", "")) + `,"description":` + json_str(ctx_or(ctx, "site.description", "")) + `,"url":` + json_str(u + "/") + `,"sameAs":` + json_list(ctx_or(ctx, "link.github", "")) + "}")
    graph.Push(`{"@type":"SoftwareSourceCode","@id":` + json_str(u + "/#source") + `,"name":` + json_str(ctx_or(ctx, "site.app_name", "")) + `,"codeRepository":` + json_str(ctx_or(ctx, "link.github", "")) + `,"programmingLanguage":{"@id":` + json_str(u + "/#language") + `},"license":` + json_str(ctx_or(ctx, "link.license", "")) + `,"author":{"@id":` + json_str(org) + "}}")
    graph.Push(`{"@type":"SoftwareApplication","@id":` + json_str(u + "/#compiler") + `,"name":` + json_str(ctx_or(ctx, "site.app_name", "")) + `,"applicationCategory":"DeveloperApplication","operatingSystem":"Linux, macOS, Windows","softwareVersion":` + json_str(version) + `,"license":` + json_str(ctx_or(ctx, "link.license", "")) + `,"downloadUrl":` + json_str(ctx_or(ctx, "link.releases", "")) + `,"inLanguage":` + json_str(tag) + `,"offers":{"@type":"Offer","price":"0","priceCurrency":"USD"},"publisher":{"@id":` + json_str(org) + "}}")
end

func webpage_node(ctx: HashMap<str, str>, page_url: str, title: str, desc: str, with_crumb: bool): str:
    u := ctx_or(ctx, "site.url", "")
    tag := ctx_or(ctx, "site.lang_tag", ctx_or(ctx, "site.lang", ""))
    image := u + ctx_or(ctx, "page.og_image", ctx_or(ctx, "site.og_image", ""))
    mut web := `{"@type":"WebPage","@id":` + json_str(page_url + "#webpage") + `,"url":` + json_str(page_url) + `,"name":` + json_str(title) + `,"description":` + json_str(desc) + `,"inLanguage":` + json_str(tag) + `,"isPartOf":{"@id":` + json_str(u + "/#website") + `},"about":{"@id":` + json_str(u + "/#language") + `},"primaryImageOfPage":{"@type":"ImageObject","url":` + json_str(image) + "}"
    if with_crumb:
        web += `,"breadcrumb":{"@id":` + json_str(page_url + "#breadcrumb") + "}"
    end
    ret web + "}"
end

func crumb_node(page_url: str, names: Vector<str>, urls: Vector<str>): str:
    mut items := Vector {} as Vector<str>
    repeat names.Len() in i:
        items.Push(`{"@type":"ListItem","position":` + (i + 1) + `,"name":` + json_str(names.Get(i)) + `,"item":` + json_str(urls.Get(i)) + "}")
    end
    ret `{"@type":"BreadcrumbList","@id":` + json_str(page_url + "#breadcrumb") + `,"itemListElement":[` + str.Join(items, ",") + "]}"
end

func wrap_graph(graph: Vector<str>): str:
    ret `<script type="application/ld+json">{"@context":"https://schema.org","@graph":[` + str.Join(graph, ",") + "]}</script>"
end

func page_jsonld(ctx: HashMap<str, str>, p: Page, version: str): str:
    u := ctx_or(ctx, "site.url", "")
    page_url := u + p.url
    mut graph := Vector {} as Vector<str>
    site_nodes(ctx, version, graph)
    graph.Push(webpage_node(ctx, page_url, ctx_or(ctx, p.slug + ".title", ""), ctx_or(ctx, p.slug + ".description", ""), p.slug != "index"))
    if p.slug != "index":
        mut names := Vector {} as Vector<str>
        mut urls := Vector {} as Vector<str>
        names.Push(ctx_or(ctx, "nav.home", ""))
        urls.Push(u + "/")
        names.Push(ctx_or(ctx, "nav." + p.slug, strip_tags(ctx_or(ctx, p.slug + ".title", ""))))
        urls.Push(page_url)
        graph.Push(crumb_node(page_url, names, urls))
    end
    if p.slug == "index" and faq_count(ctx) > 0:
        graph.Push(faq_jsonld(ctx))
    end
    if p.slug == "std" and ctx.Has("std.itemlist"):
        graph.Push(ctx.Get("std.itemlist"))
    end
    if p.slug == "learn" and ctx.Has("learn.itemlist"):
        graph.Push(ctx.Get("learn.itemlist"))
    end
    if p.slug == "blog" and ctx_or(ctx, "blog.nodes", "").Len() > 0:
        graph.Push(ctx.Get("blog.nodes"))
    end
    ret wrap_graph(graph)
end

func lesson_jsonld(ctx: HashMap<str, str>, l: Lesson, version: str): str:
    u := ctx_or(ctx, "site.url", "")
    tag := ctx_or(ctx, "site.lang_tag", ctx_or(ctx, "site.lang", ""))
    page_url := u + l.url
    title := ctx_or(ctx, "lesson.seo_title", l.title)
    desc := ctx_or(ctx, "lesson.description", "")
    mut graph := Vector {} as Vector<str>
    site_nodes(ctx, version, graph)
    graph.Push(webpage_node(ctx, page_url, title, desc, true))
    graph.Push(`{"@type":["TechArticle","LearningResource"],"@id":` + json_str(page_url + "#article") + `,"learningResourceType":"lesson","teaches":` + json_str(l.title) + modified_prop(ctx) + `,"headline":` + json_str(l.title) + `,"description":` + json_str(desc) + `,"url":` + json_str(page_url) + `,"inLanguage":` + json_str(tag) + `,"image":` + json_str(u + ctx_or(ctx, "page.og_image", ctx_or(ctx, "site.og_image", ""))) + `,"about":{"@id":` + json_str(u + "/#language") + `},"isPartOf":{"@id":` + json_str(u + "/learn/#webpage") + `},"author":{"@id":` + json_str(u + "/#organization") + `},"publisher":{"@id":` + json_str(u + "/#organization") + "}}")
    mut names := Vector {} as Vector<str>
    mut urls := Vector {} as Vector<str>
    names.Push(ctx_or(ctx, "nav.home", ""))
    urls.Push(u + "/")
    names.Push(ctx_or(ctx, "nav.learn", ""))
    urls.Push(u + "/learn/")
    names.Push(l.title)
    urls.Push(page_url)
    graph.Push(crumb_node(page_url, names, urls))
    ret wrap_graph(graph)
end

func digits(ctx: HashMap<str, str>, n: int): str:
    t := "" + n
    if ctx_or(ctx, "site.digits", "") == "fa":
        ret str.ToPersianDigits(t)
    end
    ret t
end

func lesson_slug(name: str): str:
    base := str.TrimSuffix(name, ".txt")
    dash := base.Find("-")
    mut slug := base
    if dash > 0:
        slug = base.Substr(dash + 1, base.Len() - dash - 1)
    end
    if str.StartsWith(slug, "layout-") or str.StartsWith(slug, "page-") or str.StartsWith(slug, "css-") or str.StartsWith(slug, "events-"):
        cut := slug.Find("-")
        if cut > 0:
            slug = slug.Substr(0, cut) + "/" + slug.Substr(cut + 1, slug.Len() - cut - 1)
        end
    end
    ret slug
end

func lesson_legacy_slug(name: str): str:
    base := str.TrimSuffix(name, ".txt")
    dash := base.Find("-")
    if dash > 0:
        ret base.Substr(dash + 1, base.Len() - dash - 1)
    end
    ret base
end

func path_name(path: str): str:
    slash := path.LastIndexOf("/")
    if slash < 0:
        ret path
    end
    ret path.Substr(slash + 1, path.Len() - slash - 1)
end

func redirect_html(to: str, title: str): str:
    safe := str.Replace(str.Replace(to, "\"", "%22"), "<", "%3C")
    ret "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><meta http-equiv=\"refresh\" content=\"0; url=" + safe + "\"><link rel=\"canonical\" href=\"" + safe + "\"><title>" + title + "</title></head><body><p><a href=\"" + safe + "\">" + safe + "</a></p></body></html>\n"
end

func lead_num(s: str): int:
    p := s as i8 *
    mut n := 0
    mut i := 0
    until i < s.Len() and p[i] >= 48 and p[i] <= 57:
        n = n * 10 + (p[i] - 48)
        i++
    end
    if i == 0: ret -1 end
    ret n
end

func compare_names(a: str, b: str): int:
    na := lead_num(a)
    nb := lead_num(b)
    if na >= 0 and nb >= 0 and na != nb:
        if na < nb: ret -1 end
        ret 1
    end
    ret str.Compare(a, b)
end

func sort_names(names &: Vector<str>):
    mut i := 1
    until i < names.Len():
        key := names.Get(i)
        mut j := i
        until j > 0 and compare_names(names.Get(j - 1), key) > 0:
            names.Set(j, names.Get(j - 1))
            j--
        end
        names.Set(j, key)
        i++
    end
end

func load_lessons(lang_dir: str, errs &: Vector<str>): Vector<Lesson>:
    mut out := Vector {} as Vector<Lesson>
    ldir := lang_dir + "/learn"
    if not dir.Exists(ldir):
        ret out
    end
    mut names := Vector {} as Vector<str>
    each name in dir.ListFiles(ldir):
        if str.EndsWith(name, ".txt"):
            names.Push(name)
        end
    end
    sort_names(names)
    each name in names:
        mut m := HashMap {} as HashMap<str, str>
        path := ldir + "/" + name
        load_strings(path, m, errs)
        each key in ["lesson.title", "lesson.part", "lesson.summary", "lesson.seo_title", "lesson.description", "lesson.body"]:
            if not m.Has(key):
                report(errs, path + ": missing '" + key + "'")
            end
        end
        slug := lesson_slug(name)
        out.Push(Lesson { path = path, slug = slug, url = "/learn/" + slug + "/", part = ctx_or(m, "lesson.part", ""), title = ctx_or(m, "lesson.title", ""), summary = ctx_or(m, "lesson.summary", "") })
    end
    ret out
end

func course_index_html(ctx: HashMap<str, str>, lessons: Vector<Lesson>): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut part := ""
    repeat lessons.Len() in i:
        l := lessons.Get(i)
        if l.part != part:
            if part != "":
                str.BufAppend(b, "</ol></section>\n")
            end
            part = l.part
            str.BufAppend(b, `<section class="course-part"><h2>` + part + `</h2><ol class="course-list">`)
        end
        str.BufAppend(b, `<li><a href="` + l.url + `"><span class="course-num">` + digits(ctx, i + 1) + `</span><span class="course-text"><strong>` + l.title + "</strong><small>" + l.summary + "</small></span></a></li>")
    end
    if part != "":
        str.BufAppend(b, "</ol></section>\n")
    end
    ret str.BufStr(b)
end

func course_itemlist(ctx: HashMap<str, str>, lessons: Vector<Lesson>): str:
    u := ctx_or(ctx, "site.url", "")
    mut items := Vector {} as Vector<str>
    repeat lessons.Len() in i:
        l := lessons.Get(i)
        items.Push(`{"@type":"ListItem","position":` + (i + 1) + `,"name":` + json_str(l.title) + `,"url":` + json_str(u + l.url) + "}")
    end
    ret `{"@type":"ItemList","@id":` + json_str(u + "/learn/#lessons") + `,"name":` + json_str(ctx_or(ctx, "learn.heading", "")) + `,"itemListElement":[` + str.Join(items, ",") + "]}"
end

func course_sidebar(ctx: HashMap<str, str>, lessons: Vector<Lesson>, current: int): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, `<nav class="course-nav" aria-label="` + ctx_or(ctx, "learn.course_nav", "") + `"><a class="course-nav-home" href="/learn/">` + ctx_or(ctx, "learn.course_nav", "") + "</a>")
    mut part := ""
    repeat lessons.Len() in i:
        l := lessons.Get(i)
        if l.part != part:
            if part != "":
                str.BufAppend(b, "</ol>")
            end
            part = l.part
            str.BufAppend(b, `<p class="course-nav-part">` + part + "</p><ol>")
        end
        cur := i == current ? ` aria-current="page"` : ""
        str.BufAppend(b, `<li><a href="` + l.url + `"` + cur + `><span class="course-num">` + digits(ctx, i + 1) + "</span>" + l.title + "</a></li>")
    end
    if part != "":
        str.BufAppend(b, "</ol>")
    end
    str.BufAppend(b, "</nav>")
    ret str.BufStr(b)
end

func body_toc(body: str): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut i := 0
    mut any := false
    until true:
        at_h := str.IndexFrom(body, `<h2 id="`, i)
        if at_h < 0:
            break
        end
        id_start := at_h + 8
        id_end := str.IndexFrom(body, `"`, id_start)
        close_tag := str.IndexFrom(body, ">", id_end)
        end_h := str.IndexFrom(body, "</h2>", close_tag)
        if id_end < 0 or close_tag < 0 or end_h < 0:
            break
        end
        str.BufAppend(b, `<li><a href="#` + body.Substr(id_start, id_end - id_start) + `">` + body.Substr(close_tag + 1, end_h - close_tag - 1) + "</a></li>")
        any = true
        i = end_h + 5
    end
    if not any:
        ret ""
    end
    ret "<ol>" + str.BufStr(b) + "</ol>"
end

func lesson_link(ctx: HashMap<str, str>, l: Lesson, key: str, class: str): str:
    ret `<a class="lesson-step ` + class + `" href="` + l.url + `"><small>` + ctx_or(ctx, key, "") + "</small><strong>" + l.title + "</strong></a>"
end

func copy_map(src: HashMap<str, str>): HashMap<str, str>:
    mut m := HashMap {} as HashMap<str, str>
    each k, v in src:
        m.Put(k, v)
    end
    ret m
end

func manifest_json(ctx: HashMap<str, str>): str:
    b := ctx_or(ctx, "site.base", "")
    ret `{"name":` + json_str(ctx_or(ctx, "site.name", "")) + `,"short_name":` + json_str(ctx_or(ctx, "site.short_name", "")) + `,"description":` + json_str(ctx_or(ctx, "site.description", "")) + `,"lang":` + json_str(ctx_or(ctx, "site.lang", "")) + `,"dir":` + json_str(ctx_or(ctx, "site.dir", "")) + `,"id":` + json_str(b + "/") + `,"categories":["developer tools","education"],"start_url":` + json_str(b + "/") + `,"scope":` + json_str(b + "/") + `,"display":"standalone","background_color":"#111214","theme_color":"#ff5c00","icons":[{"src":` + json_str(b + "/favicon.ico") + `,"sizes":"48x48","type":"image/x-icon"},{"src":` + json_str(b + "/assets/img/icon-192.png") + `,"sizes":"192x192","type":"image/png"},{"src":` + json_str(b + "/assets/img/icon-512.png") + `,"sizes":"512x512","type":"image/png"},{"src":` + json_str(b + "/assets/img/icon-512.png") + `,"sizes":"512x512","type":"image/png","purpose":"maskable"}]}` + "\n"
end

func load_lastmod(): HashMap<str, str>:
    mut out := HashMap {} as HashMap<str, str>
    if str.Trim(os.Output("git rev-parse --is-shallow-repository 2>/dev/null")) != "false":
        ret out
    end
    mut day := ""
    each line in os.Output("git log --format=%cs --name-only -- website/content website/templates 2>/dev/null").Split("\n"):
        t := str.Trim(line)
        if t.Len() == 10 and t.Substr(4, 1) == "-" and t.Substr(7, 1) == "-":
            day = t
        else t.Len() > 0 and not out.Has(t):
            out.Put(t, day)
        end
    end
    ret out
end

func newest(a: str, b: str): str:
    ret b > a ? b : a
end

func one_path(path: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.Push(path)
    ret v
end

func lastmod_of(lm: HashMap<str, str>, paths: Vector<str>): str:
    mut out := ""
    each path in paths:
        if lm.Has(path):
            out = newest(out, lm.Get(path))
        end
    end
    ret out
end

func set_cover(ctx &: HashMap<str, str>, section: str):
    lang := ctx_or(ctx, "site.lang", "")
    file := "/assets/img/og-" + section + "-" + lang + ".png"
    if section.Len() > 0 and fs.Exists(ROOT + file):
        ctx.Put("page.og_image", file)
    else:
        ctx.Put("page.og_image", ctx_or(ctx, "site.og_image", ""))
    end
    ctx.Put("page.og_image_alt", section.Len() > 0 ? strip_tags(ctx_or(ctx, "page.title", "")) : ctx_or(ctx, "site.og_image_alt", ""))
end

func sitemap_entry(ctx: HashMap<str, str>, loc: str, lastmod: str): str:
    mut e := "  <url><loc>" + loc + "</loc>"
    if lastmod.Len() > 0:
        e += "<lastmod>" + lastmod + "</lastmod>"
    end
    alt := ctx_or(ctx, "page.alt_url", "")
    if alt.Len() > 0:
        e += `<xhtml:link rel="alternate" hreflang="` + ctx_or(ctx, "site.lang_tag", "") + `" href="` + loc + `"/>`
        e += `<xhtml:link rel="alternate" hreflang="` + ctx_or(ctx, "alt.lang_tag", "") + `" href="` + alt + `"/>`
        e += `<xhtml:link rel="alternate" hreflang="x-default" href="` + ctx_or(ctx, "page.xdefault_url", "") + `"/>`
    end
    ret e + "</url>\n"
end

func rebase(html: str, base: str): str:
    if base.Len() == 0:
        ret html
    end
    mut out := str.Replace(html, `href="/`, `href="` + base + "/")
    out = str.Replace(out, `src="/`, `src="` + base + "/")
    ret out
end

func page_for(slug: str): Page:
    if slug == "index":
        ret Page { slug = slug, url = "/", out = "index.html" }
    end
    if slug == "404":
        ret Page { slug = slug, url = "/404.html", out = "404.html" }
    end
    ret Page { slug = slug, url = "/" + slug + "/", out = slug + "/index.html" }
end

func short_hash(path: str): str:
    ret fs.Sha256Hex(path).Substr(0, 10)
end

func write(path: str, data: str, errs &: Vector<str>):
    if fs.WriteText(path, data) < 0:
        report(errs, "cannot write " + path)
    end
end

func tag_name(t: str): str:
    mut stop := t.Len()
    mut k := 0
    until k < t.Len():
        c := t.Substr(k, 1)
        if c == " " or c == "\n" or c == "\t":
            stop = k
            break
        end
        k++
    end
    ret str.TrimSuffix(t.Substr(0, stop), "/")
end

func is_block_tag(name: str): bool:
    ret " p /p div /div br ul /ul ol /ol table /table /h2 /h3 /h4 /li dl /dl dt dd ".Find(" " + name + " ") >= 0
end

func decode_entities(s: str): str:
    mut r := str.Replace(s, "&lt;", "<")
    r = str.Replace(r, "&gt;", ">")
    r = str.Replace(r, "&quot;", "\"")
    r = str.Replace(r, "&#39;", "'")
    r = str.Replace(r, "&nbsp;", " ")
    r = str.Replace(r, "&#123;", "{")
    r = str.Replace(r, "&#125;", "}")
    ret str.Replace(r, "&amp;", "&")
end

func tidy_lines(s: str): str:
    mut out := Vector {} as Vector<str>
    mut in_code := false
    mut gap := false
    mut last := ""
    each raw in s.Split("\n"):
        line := str.TrimRight(raw)
        t := str.Trim(line)
        if in_code:
            out.Push(line)
            if t == "```":
                in_code = false
                last = t
            end
            continue
        end
        if t.Len() == 0:
            gap = out.Len() > 0
            continue
        end
        if gap and not (str.StartsWith(t, "|") and str.StartsWith(last, "|")):
            out.Push("")
        end
        gap = false
        out.Push(t)
        last = t
        if str.StartsWith(t, "```"):
            in_code = true
        end
    end
    ret str.Join(out, "\n")
end

func html_to_text(html: str): str:
    cps := str.CodePoints(html)
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut in_pre := false
    mut in_label := false
    mut in_out := false
    mut cells := 0
    mut head_row := false
    mut skip := 0
    mut k := 0
    until k < cps.Len():
        cp := cps.Get(k)
        if cp != 60:
            if skip == 0:
                str.BufAppendCp(b, cp)
            end
            k++
            continue
        end
        mut j := k + 1
        until j < cps.Len() and cps.Get(j) != 62:
            j++
        end
        raw := text_of(cps, k + 1, j)
        name := tag_name(raw)
        k = j + 1
        if name == "button" or name == "script" or name == "style":
            skip++
        else name == "/button" or name == "/script" or name == "/style":
            if skip > 0:
                skip--
            end
        else skip > 0:
            continue
        else name == "span" and raw.Find(`class="label"`) >= 0 and not in_pre:
            in_label = true
            str.BufAppend(b, "\n\n")
        else name == "/span" and in_label:
            in_label = false
            in_out = true
            in_pre = true
            str.BufAppend(b, ":\n\n```text\n")
        else name == "/div" and in_out:
            in_out = false
            in_pre = false
            str.BufAppend(b, "\n```\n\n")
        else name == "pre":
            in_pre = true
            str.BufAppend(b, "\n\n```salam\n")
        else name == "/pre":
            in_pre = false
            str.BufAppend(b, "\n```\n\n")
        else in_pre:
            continue
        else name == "code" or name == "/code":
            str.BufAppend(b, "`")
        else name == "h2":
            str.BufAppend(b, "\n\n## ")
        else name == "h3":
            str.BufAppend(b, "\n\n### ")
        else name == "h4":
            str.BufAppend(b, "\n\n#### ")
        else name == "li":
            str.BufAppend(b, "\n- ")
        else name == "tr":
            cells = 0
            head_row = false
            str.BufAppend(b, "\n")
        else name == "th" or name == "td":
            cells++
            if name == "th":
                head_row = true
            end
            str.BufAppend(b, "| ")
        else name == "/td" or name == "/th":
            str.BufAppend(b, " ")
        else name == "/tr":
            str.BufAppend(b, "|\n")
            if head_row:
                str.BufAppend(b, "|")
                repeat cells in _:
                    str.BufAppend(b, " --- |")
                end
                str.BufAppend(b, "\n")
            end
        else is_block_tag(name):
            str.BufAppend(b, "\n")
        end
    end
    ret tidy_lines(decode_entities(str.BufStr(b)))
end

func title_head(s: str): str:
    pos := s.Find(" | ")
    ret pos > 0 ? s.Substr(0, pos) : s
end

func llms_link(b &: str.StringBuilder, name: str, url: str, desc: str):
    str.BufAppend(b, "- [" + name + "](" + url + ")")
    if desc.Len() > 0:
        str.BufAppend(b, ": " + desc)
    end
    str.BufAppend(b, "\n")
end

func sitemap_item(href: str, text: str): str:
    ret `<li><a href="` + href + `">` + text + "</a></li>"
end

func sitemap_block(title: str, items: str): str:
    ret `<section class="card sitemap-block"><h2>` + title + `</h2><ul class="sitemap-list">` + items + "</ul></section>\n"
end

func sitemap_html(ctx: HashMap<str, str>, pages: Vector<Page>, lessons: Vector<Lesson>, pkgs: Vector<StdPkg>, posts: Vector<Post>): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut items := sitemap_item("/", ctx_or(ctx, "sitemap.home", "Home"))
    each p in pages:
        if p.slug != "index" and p.slug != "404" and p.slug != "sitemap":
            items += sitemap_item(p.url, ctx_or(ctx, "nav." + p.slug, title_head(ctx_or(ctx, p.slug + ".title", p.slug))))
        end
    end
    str.BufAppend(b, sitemap_block(ctx_or(ctx, "sitemap.pages", "Pages"), items))
    mut part := ""
    mut course := ""
    each l in lessons:
        if l.part != part:
            if part != "":
                course += "</ol>"
            end
            part = l.part
            course = course + "<h3>" + part + "</h3><ol>"
        end
        course += sitemap_item(l.url, l.title)
    end
    if part != "":
        course += "</ol>"
    end
    str.BufAppend(b, `<section class="card sitemap-block"><h2>` + ctx_or(ctx, "sitemap.course", "Course") + `</h2><div class="sitemap-course">` + course + "</div></section>\n")
    mut std := ""
    each p in pkgs:
        std += sitemap_item(p.url, pkg_label(p))
    end
    str.BufAppend(b, `<section class="card sitemap-block"><h2>` + ctx_or(ctx, "sitemap.std", "Standard library") + `</h2><ul class="sitemap-list sitemap-cols">` + std + "</ul></section>\n")
    if posts.Len() > 0:
        mut mag := ""
        each cat in str.Fields(ctx_or(ctx, "blog.categories", "")):
            mut items := ""
            each q in posts:
                if q.category == cat:
                    items += sitemap_item(q.url, q.title)
                end
            end
            if items.Len() > 0:
                mag = mag + "<h3>" + cat_label(ctx, cat) + "</h3><ul>" + items + "</ul>"
            end
        end
        str.BufAppend(b, `<section class="card sitemap-block"><h2>` + ctx_or(ctx, "nav.blog", "Magazine") + `</h2><div class="sitemap-course">` + mag + "</div></section>\n")
    end
    mut ext := sitemap_item(ctx_or(ctx, "link.editor", ""), ctx_or(ctx, "nav.editor", "Editor"))
    ext += sitemap_item(ctx_or(ctx, "link.ai", ""), ctx_or(ctx, "sitemap.ai", "Salam AI"))
    ext += sitemap_item(ctx_or(ctx, "link.telegram_bot", ""), ctx_or(ctx, "sitemap.bot", "Telegram bot"))
    ext += sitemap_item(ctx_or(ctx, "link.github", ""), ctx_or(ctx, "footer.source", "Source code"))
    ext += sitemap_item(ctx_or(ctx, "link.releases", ""), ctx_or(ctx, "footer.releases", "Releases"))
    ext += sitemap_item(ctx_or(ctx, "link.mcp", ""), ctx_or(ctx, "sitemap.mcp", "MCP server"))
    ext += sitemap_item(ctx_or(ctx, "link.telegram", ""), ctx_or(ctx, "footer.telegram", "Telegram group"))
    ext += sitemap_item(ctx_or(ctx, "link.discord", ""), ctx_or(ctx, "footer.discord", "Discord"))
    ext += sitemap_item(ctx_or(ctx, "link.eitaa", ""), ctx_or(ctx, "footer.eitaa", "Eitaa"))
    ext += sitemap_item(ctx_or(ctx, "link.bale", ""), ctx_or(ctx, "footer.bale", "Bale"))
    ext += sitemap_item(ctx_or(ctx, "link.issues", ""), ctx_or(ctx, "footer.issues", "Report a problem"))
    ext += sitemap_item("/sitemap.xml", ctx_or(ctx, "sitemap.xml", "sitemap.xml"))
    ext += sitemap_item("/llms.txt", "llms.txt")
    str.BufAppend(b, sitemap_block(ctx_or(ctx, "sitemap.external", "Elsewhere"), ext))
    ret str.BufStr(b)
end

func llms_index(ctx: HashMap<str, str>, pages: Vector<Page>, lessons: Vector<Lesson>, pkgs: Vector<StdPkg>, posts: Vector<Post>): str:
    site_url := ctx_or(ctx, "site.url", "")
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, "# " + ctx_or(ctx, "site.name", "Salam") + "\n\n")
    str.BufAppend(b, "> " + ctx_or(ctx, "site.description", "") + "\n\n")
    str.BufAppend(b, strip_tags(ctx_or(ctx, "llms.intro", "")) + "\n\n")
    str.BufAppend(b, "## " + ctx_or(ctx, "llms.pages", "Pages") + "\n\n")
    each p in pages:
        if p.slug != "index" and p.slug != "404":
            llms_link(b, title_head(ctx_or(ctx, p.slug + ".title", p.slug)), site_url + p.url, ctx_or(ctx, p.slug + ".description", ""))
        end
    end
    str.BufAppend(b, "\n## " + ctx_or(ctx, "llms.course", "Course") + "\n\n")
    each l in lessons:
        llms_link(b, l.title, site_url + l.url, l.summary)
    end
    str.BufAppend(b, "\n## " + ctx_or(ctx, "llms.std", "Standard library") + "\n\n")
    each p in pkgs:
        llms_link(b, pkg_label(p), site_url + p.url, p.summary)
    end
    if posts.Len() > 0:
        str.BufAppend(b, "\n## " + ctx_or(ctx, "nav.blog", "Magazine") + "\n\n")
        each q in posts:
            llms_link(b, decode_entities(q.title), site_url + q.url, decode_entities(q.summary))
        end
    end
    str.BufAppend(b, "\n## " + ctx_or(ctx, "llms.install", "Install") + "\n\n")
    str.BufAppend(b, ctx_or(ctx, "llms.install_text", "") + "\n\n")
    str.BufAppend(b, ctx_or(ctx, "llms.version_label", "Latest release") + ": v" + ctx_or(ctx, "site.version_raw", "") + "\n\n")
    str.BufAppend(b, "```\n# " + strip_tags(ctx_or(ctx, "install.unix_title", "")) + "\n" + strip_tags(ctx_or(ctx, "install.unix_cmd", "")) + "\n\n# " + strip_tags(ctx_or(ctx, "install.win_title", "")) + "\n" + strip_tags(ctx_or(ctx, "install.win_cmd", "")) + "\n```\n")
    str.BufAppend(b, "\n## " + ctx_or(ctx, "llms.agents", "For AI agents") + "\n\n")
    llms_link(b, ctx_or(ctx, "llms.full", "llms-full.txt"), site_url + "/llms-full.txt", ctx_or(ctx, "llms.full_desc", ""))
    llms_link(b, ctx_or(ctx, "llms.skill", "Salam skill"), ctx_or(ctx, "link.skill", ""), ctx_or(ctx, "llms.skill_desc", ""))
    llms_link(b, ctx_or(ctx, "llms.plugin", "Claude Code plugin"), ctx_or(ctx, "link.claude_plugin", ""), ctx_or(ctx, "llms.plugin_desc", ""))
    llms_link(b, ctx_or(ctx, "llms.mcp", "MCP server"), ctx_or(ctx, "link.mcp", ""), ctx_or(ctx, "llms.mcp_desc", ""))
    str.BufAppend(b, "\n## Optional\n\n")
    llms_link(b, ctx_or(ctx, "llms.github", "GitHub"), ctx_or(ctx, "link.github", ""), "")
    llms_link(b, ctx_or(ctx, "llms.releases", "Releases"), ctx_or(ctx, "link.releases", ""), "")
    llms_link(b, ctx_or(ctx, "llms.editor", "Online editor"), ctx_or(ctx, "link.editor", ""), "")
    ret str.BufStr(b)
end

func llms_section(b &: str.StringBuilder, title: str, url: str, lead: str, body_html: str):
    str.BufAppend(b, "\n\n---\n\n# " + title + "\n\n" + url + "\n\n")
    if lead.Len() > 0:
        str.BufAppend(b, html_to_text(lead) + "\n\n")
    end
    str.BufAppend(b, html_to_text(body_html) + "\n")
end

func alias_of(d: ApiDecl, lang: str): str:
    each pair in d.a:
        if pair.Len() >= 2 and pair.Get(0) == lang:
            ret pair.Get(1)
        end
    end
    ret ""
end

func is_ascii_ident(cp: int): bool:
    ret cp == 95 or (cp < 128 and str.IsAsciiAlnum(cp))
end

func alias_of_lang(ctx: HashMap<str, str>): str:
    ret ctx_or(ctx, "stdref.alias", "")
end

func sig_words(ctx: HashMap<str, str>, api: ApiDoc, gwords: HashMap<str, str>): HashMap<str, str>:
    mut words := HashMap {} as HashMap<str, str>
    alias := alias_of_lang(ctx)
    if alias.Len() == 0:
        ret words
    end
    each pair in str.Fields(ctx_or(ctx, "stdref.words", "")):
        eqpos := pair.Find("=")
        if eqpos > 0:
            words.Put(pair.Substr(0, eqpos), str.Replace(pair.Substr(eqpos + 1, pair.Len() - eqpos - 1), "_", " "))
        end
    end
    each d in api.decls:
        if d.par < 0 and (d.k == "struct" or d.k == "enum" or d.k == "type" or d.k == "interface"):
            fa := alias_of(d, alias)
            if fa.Len() > 0:
                words.Put(d.n, fa)
            end
        end
    end
    each key, fa in gwords:
        if not words.Has(key):
            words.Put(key, fa)
        end
    end
    ret words
end

func alias_sig(sig: str, own_en: str, own_fa: str, words: HashMap<str, str>, show: bool): str:
    if not show:
        ret sig
    end
    cps := str.CodePoints(sig)
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut named := false
    mut i := 0
    until i < cps.Len():
        cp := cps.Get(i)
        if is_ascii_ident(cp):
            mut j := i
            until j < cps.Len() and is_ascii_ident(cps.Get(j)):
                j++
            end
            mut k := j
            until k + 1 < cps.Len() and cps.Get(k) == 46 and is_ascii_ident(cps.Get(k + 1)):
                k++
                until k < cps.Len() and is_ascii_ident(cps.Get(k)):
                    k++
                end
            end
            chain := text_of(cps, i, k)
            w := text_of(cps, i, j)
            if k > j and words.Has(chain):
                str.BufAppend(b, words.Get(chain))
                i = k
            else:
                if not named and w == own_en and own_fa.Len() > 0:
                    str.BufAppend(b, own_fa)
                    named = true
                else words.Has(w):
                    str.BufAppend(b, words.Get(w))
                else:
                    str.BufAppend(b, w)
                end
                i = j
            end
        else cp == 44:
            str.BufAppend(b, "،")
            i++
        else:
            str.BufAppendCp(b, cp)
            i++
        end
    end
    ret str.BufStr(b)
end

func typarams_of(sig: str): str:
    lpos := sig.Find("<")
    if lpos < 0:
        ret ""
    end
    ret sig.Substr(lpos, sig.Len() - lpos)
end

func load_std(lang_dir: str, errs &: Vector<str>): Vector<StdPkg>:
    mut out := Vector {} as Vector<StdPkg>
    sdir := lang_dir + "/std"
    if not dir.Exists(sdir):
        ret out
    end
    mut names := Vector {} as Vector<str>
    each name in dir.ListFiles(sdir):
        if str.EndsWith(name, ".txt"):
            names.Push(name)
        end
    end
    sort_names(names)
    each name in names:
        mut m := HashMap {} as HashMap<str, str>
        path := sdir + "/" + name
        load_strings(path, m, errs)
        each key in ["pkg.en", "pkg.name", "pkg.group", "pkg.summary", "pkg.title", "pkg.description", "pkg.intro"]:
            if not m.Has(key):
                report(errs, path + ": missing '" + key + "'")
            end
        end
        en := ctx_or(m, "pkg.en", "")
        slug := str.Replace(en, "/", "-")
        disp := str.Replace(en, "/", ".")
        out.Push(StdPkg { path = path, slug = slug, url = "/std/" + en + "/", en = en, disp = disp, name = ctx_or(m, "pkg.name", ""), group = ctx_or(m, "pkg.group", ""), summary = ctx_or(m, "pkg.summary", ""), imp = ctx_or(m, "pkg.import", "") })
    end
    mut order := Vector {} as Vector<str>
    each p in out:
        mut seen := false
        each g in order:
            if g == p.group:
                seen = true
            end
        end
        if not seen:
            order.Push(p.group)
        end
    end
    mut grouped := Vector {} as Vector<StdPkg>
    each g in order:
        each p in out:
            if p.group == g:
                grouped.Push(p)
            end
        end
    end
    ret grouped
end

func load_std_examples(lang_dir: str, pkg: StdPkg, ctx: HashMap<str, str>, errs &: Vector<str>): HashMap<str, str>:
    mut out := HashMap {} as HashMap<str, str>
    ex_dir := lang_dir + "/std-examples/" + pkg.slug
    if not dir.Exists(ex_dir):
        ret out
    end
    classes := code_classes(ctx)
    each name in dir.ListFiles(ex_dir):
        if not str.EndsWith(name, ".salam"):
            continue
        end
        stem := str.TrimSuffix(name, ".salam")
        src := str.TrimRight(io.ReadFile(ex_dir + "/" + name))
        out_path := ex_dir + "/" + stem + ".out"
        mut out_html := ""
        if fs.Exists(out_path):
            out_html = escape_text(str.TrimRight(io.ReadFile(out_path)))
        end
        out.Put(stem, example_block(stem, src, highlight(src, classes), out_html, "", ctx, errs))
    end
    ret out
end

func std_example(ctx: HashMap<str, str>, pkg: StdPkg, key: str, anchor: str, examples: HashMap<str, str>, shown &: HashMap<str, str>, _errs &: Vector<str>): str:
    stem := ctx_or(ctx, "ex." + key, pkg.slug + "-" + key)
    if stem == "-":
        ret ""
    end
    if not examples.Has(stem):
        println "website: " + pkg.path + ": no example for '" + key + "' (skipped)"
        ret ""
    end
    if shown.Has(stem):
        ret `<p class="api-see">` + ctx_or(ctx, "stdref.see_example", "") + ` <a href="#` + shown.Get(stem) + `">` + stem + ".salam</a></p>"
    end
    shown.Put(stem, anchor)
    ret examples.Get(stem)
end

func std_doc(ctx: HashMap<str, str>, pkg: StdPkg, key: str, _errs &: Vector<str>): str:
    if not ctx.Has("doc." + key):
        println "website: " + pkg.path + ": missing 'doc." + key + "' (skipped)"
        ret ""
    end
    ret ctx.Get("doc." + key)
end

func std_heading(tag: str, anchor: str, fa: str, en: str): str:
    if fa.Len() == 0 or fa == en:
        ret "<" + tag + ` class="api-name" id="` + anchor + `"><code dir="ltr">` + en + "</code></" + tag + ">"
    end
    ret "<" + tag + ` class="api-name" id="` + anchor + `"><span>` + fa + `</span> <code dir="ltr">` + en + "</code></" + tag + ">"
end

func std_sig_block(sig: str, classes: HashMap<str, str>, cdir: str): str:
    ret `<pre class="code api-sig" dir="` + cdir + `"><code>` + highlight(sig, classes) + "</code></pre>"
end

func std_member_row(fa: str, en: str, kind: str, doc: str, cdir: str, show: bool): str:
    mut cell := "<tr>"
    if show:
        cell += "<td>" + fa + "</td>"
    end
    ret cell + `<td><code dir="ltr">` + en + `</code></td><td><code dir="` + cdir + `">` + kind + "</code></td><td>" + doc + "</td></tr>"
end

func std_member_table(ctx: HashMap<str, str>, rows: str, show: bool): str:
    if rows.Len() == 0:
        ret ""
    end
    mut head := ""
    if show:
        head += "<th>" + ctx_or(ctx, "stdref.col_name", "") + "</th>"
    end
    head += "<th>" + ctx_or(ctx, "stdref.col_en", "") + "</th><th>" + ctx_or(ctx, "stdref.col_type", "") + "</th><th>" + ctx_or(ctx, "stdref.col_doc", "") + "</th>"
    ret `<div class="table-wrap"><table class="api-members"><thead><tr>` + head + "</tr></thead><tbody>" + rows + "</tbody></table></div>"
end

func std_kind_group(d: ApiDecl): int:
    if d.k == "struct" or d.k == "enum" or d.k == "type" or d.k == "interface":
        ret 0
    end
    if d.k == "const" or d.k == "var":
        ret 1
    end
    if d.k == "func":
        ret 2
    end
    ret 0 - 1
end

func std_no_alias(ctx: HashMap<str, str>, key: str): bool:
    each name in str.Fields(ctx_or(ctx, "pkg.noalias", "")):
        if name == key:
            ret true
        end
    end
    ret false
end

func std_item(ctx: HashMap<str, str>, pkg: StdPkg, api: ApiDoc, idx: int, words: HashMap<str, str>, classes: HashMap<str, str>, examples: HashMap<str, str>, shown &: HashMap<str, str>, errs &: Vector<str>): str:
    d := api.decls.Get(idx)
    key := d.n
    alias := alias_of_lang(ctx)
    show := alias.Len() > 0
    cdir := ctx_or(ctx, "site.dir", "ltr")
    mut fa := show ? alias_of(d, alias) : ""
    no_alias := std_no_alias(ctx, key)
    if show and fa.Len() == 0:
        if not no_alias:
            println "website: " + pkg.path + ": '" + key + "' has no @" + alias + " name in std (skipped)"
        end
        fa = key
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, `<article class="api-item">`)
    str.BufAppend(b, std_heading("h3", key, fa, key))
    mut rows := ""
    mut methods := Vector {} as Vector<int>
    if d.k == "type" and str.Contains(d.s, "Variant<__"):
        prefix := "__" + key + "__"
        mut tp := ""
        mut lines := ""
        repeat api.decls.Len() in ci:
            c := api.decls.Get(ci)
            if c.par < 0 and c.k == "struct" and str.StartsWith(c.n, prefix):
                if tp.Len() == 0:
                    tp = typarams_of(c.s)
                end
                men := str.TrimPrefix(c.n, prefix)
                mut mfa := show ? alias_of(c, alias) : ""
                if show and mfa.Len() == 0:
                    println "website: " + pkg.path + ": enum member '" + key + "." + men + "' has no @" + alias + " name in std (skipped)"
                    mfa = men
                end
                mut fields := Vector {} as Vector<str>
                each fi in c.m:
                    f := api.decls.Get(fi)
                    if f.n != "_unit":
                        fields.Push(alias_sig(f.s, "", "", words, show))
                    end
                end
                payload := fields.Len() > 0 ? "(" + str.Join(fields, show ? "، " : ", ") + ")" : ""
                lines += "\n    " + (show ? mfa : men) + payload
                rows += std_member_row(mfa, men, payload, std_doc(ctx, pkg, key + "." + men, errs), cdir, show)
            end
        end
        str.BufAppend(b, std_sig_block(ctx_or(ctx, "stdref.kw_enum", "enum") + " " + (show ? fa : key) + alias_sig(tp, "", "", words, show) + ":" + lines + "\n" + ctx_or(ctx, "stdref.kw_end", "end"), classes, cdir))
    else:
        str.BufAppend(b, std_sig_block(alias_sig(d.s, key, fa, words, show), classes, cdir))
        each mi in d.m:
            md := api.decls.Get(mi)
            if not md.p or str.StartsWith(md.n, "_"):
                continue
            end
            if md.k == "func":
                methods.Push(mi)
                continue
            end
            mfa := show ? alias_of(md, alias) : ""
            if show and mfa.Len() == 0 and not no_alias:
                println "website: " + pkg.path + ": field '" + key + "." + md.n + "' has no @" + alias + " name in std (skipped)"
            end
            mut kind := ""
            colon := md.s.Find(":")
            if colon > 0:
                kind = alias_sig(str.Trim(md.s.Substr(colon + 1, md.s.Len() - colon - 1)), "", "", words, show)
            end
            rows += std_member_row(mfa.Len() > 0 ? mfa : md.n, md.n, kind, std_doc(ctx, pkg, key + "." + md.n, errs), cdir, show)
        end
    end
    str.BufAppend(b, `<div class="api-doc">` + std_doc(ctx, pkg, key, errs) + "</div>")
    str.BufAppend(b, std_member_table(ctx, rows, show))
    str.BufAppend(b, std_example(ctx, pkg, key, key, examples, shown, errs))
    each mi in methods:
        md := api.decls.Get(mi)
        mkey := key + "." + md.n
        mut mfa := show ? alias_of(md, alias) : ""
        if show and mfa.Len() == 0:
            println "website: " + pkg.path + ": method '" + mkey + "' has no @" + alias + " name in std (skipped)"
            mfa = md.n
        end
        str.BufAppend(b, `<section class="api-method">`)
        str.BufAppend(b, std_heading("h4", mkey, mfa, md.n))
        str.BufAppend(b, std_sig_block(alias_sig(md.s, md.n, mfa, words, show), classes, cdir))
        str.BufAppend(b, `<div class="api-doc">` + std_doc(ctx, pkg, mkey, errs) + "</div>")
        str.BufAppend(b, std_example(ctx, pkg, mkey, mkey, examples, shown, errs))
        str.BufAppend(b, "</section>")
    end
    str.BufAppend(b, "</article>")
    ret str.BufStr(b)
end

func std_groups(ctx: HashMap<str, str>): Vector<str>:
    mut out := Vector {} as Vector<str>
    each k, _ in ctx:
        if str.StartsWith(k, "group.") and not str.EndsWith(k, ".title"):
            out.Push(str.TrimPrefix(k, "group."))
        end
    end
    ret out
end

func std_group_of(groups: Vector<str>, d: ApiDecl): str:
    mut best := ""
    if d.k != "const":
        ret best
    end
    each g in groups:
        if str.StartsWith(d.n, g) and g.Len() > best.Len():
            best = g
        end
    end
    ret best
end

func std_group_card(ctx: HashMap<str, str>, pkg: StdPkg, api: ApiDoc, group: Vector<str>, prefix: str, examples: HashMap<str, str>, shown &: HashMap<str, str>, errs &: Vector<str>): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    key := "group." + prefix
    alias := alias_of_lang(ctx)
    show := alias.Len() > 0
    str.BufAppend(b, `<article class="api-item">`)
    str.BufAppend(b, std_heading("h3", prefix, ctx_or(ctx, key + ".title", prefix), prefix + "…"))
    str.BufAppend(b, `<div class="api-doc">` + ctx_or(ctx, key, "") + "</div>")
    mut rows := ""
    repeat api.decls.Len() in i:
        d := api.decls.Get(i)
        if d.par >= 0 or not d.p or d.k != "const" or std_group_of(group, d) != prefix:
            continue
        end
        mut fa := show ? alias_of(d, alias) : ""
        if show and fa.Len() == 0:
            println "website: " + pkg.path + ": '" + d.n + "' has no @" + alias + " name in std (skipped)"
            fa = d.n
        end
        eqpos := d.s.Find("=")
        value := eqpos > 0 ? str.Trim(d.s.Substr(eqpos + 1, d.s.Len() - eqpos - 1)) : ""
        mut cells := ""
        if show:
            cells += "<td>" + fa + "</td>"
        end
        rows += `<tr id="` + d.n + `">` + cells + `<td><code dir="ltr">` + d.n + `</code></td><td><code dir="ltr">` + escape_text(value) + "</code></td></tr>"
    end
    mut ghead := ""
    if show:
        ghead += "<th>" + ctx_or(ctx, "stdref.col_name", "") + "</th>"
    end
    ghead += "<th>" + ctx_or(ctx, "stdref.col_en", "") + "</th><th>" + ctx_or(ctx, "stdref.col_value", "") + "</th>"
    str.BufAppend(b, `<div class="table-wrap"><table class="api-members"><thead><tr>` + ghead + "</tr></thead><tbody>" + rows + "</tbody></table></div>")
    str.BufAppend(b, std_example(ctx, pkg, key, prefix, examples, shown, errs))
    str.BufAppend(b, "</article>")
    ret str.BufStr(b)
end

func std_api_html(ctx: HashMap<str, str>, pkg: StdPkg, api: ApiDoc, gwords: HashMap<str, str>, examples: HashMap<str, str>, errs &: Vector<str>): str:
    words := sig_words(ctx, api, gwords)
    classes := code_classes(ctx)
    groups := std_groups(ctx)
    mut done_groups := HashMap {} as HashMap<str, str>
    mut shown := HashMap {} as HashMap<str, str>
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    heads := ["stdref.h_types", "stdref.h_values", "stdref.h_funcs"]
    ids := ["types", "values", "funcs"]
    repeat 3 in g:
        mut any := false
        repeat api.decls.Len() in i:
            d := api.decls.Get(i)
            if d.par >= 0 or not d.p or str.StartsWith(d.n, "_") or std_kind_group(d) != g:
                continue
            end
            gp := std_group_of(groups, d)
            if gp.Len() > 0 and done_groups.Has(gp):
                continue
            end
            if not any:
                str.BufAppend(b, `<h2 id="` + ids[g] + `">` + ctx_or(ctx, heads[g], "") + "</h2>\n")
                any = true
            end
            if gp.Len() > 0:
                done_groups.Put(gp, "")
                str.BufAppend(b, std_group_card(ctx, pkg, api, groups, gp, examples, shown, errs) + "\n")
                continue
            end
            str.BufAppend(b, std_item(ctx, pkg, api, i, words, classes, examples, shown, errs) + "\n")
        end
    end
    each stem, _ in examples:
        if not shown.Has(stem):
            report(errs, pkg.path + ": example '" + stem + ".salam' is not used by any item")
        end
    end
    ret str.BufStr(b)
end

func pkg_label(p: StdPkg): str:
    if p.name == p.disp:
        ret p.name
    end
    ret p.name + " (" + p.disp + ")"
end

func std_index_html(pkgs: Vector<StdPkg>): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut group := ""
    each p in pkgs:
        if p.group != group:
            if group != "":
                str.BufAppend(b, "</ul></section>\n")
            end
            group = p.group
            str.BufAppend(b, `<section class="course-part"><h2>` + group + `</h2><ul class="course-list std-list">`)
        end
        title := p.name == p.disp ? `<code dir="ltr">` + p.disp + "</code>" : p.name + ` <code dir="ltr">` + p.disp + "</code>"
        str.BufAppend(b, `<li><a href="` + p.url + `"><span class="course-text"><strong>` + title + "</strong><small>" + p.summary + "</small></span></a></li>")
    end
    if group != "":
        str.BufAppend(b, "</ul></section>\n")
    end
    ret str.BufStr(b)
end

func std_itemlist(ctx: HashMap<str, str>, pkgs: Vector<StdPkg>): str:
    u := ctx_or(ctx, "site.url", "")
    mut items := Vector {} as Vector<str>
    repeat pkgs.Len() in i:
        p := pkgs.Get(i)
        items.Push(`{"@type":"ListItem","position":` + (i + 1) + `,"name":` + json_str(pkg_label(p)) + `,"url":` + json_str(u + p.url) + "}")
    end
    ret `{"@type":"ItemList","@id":` + json_str(u + "/std/#packages") + `,"name":` + json_str(ctx_or(ctx, "std.heading", "")) + `,"itemListElement":[` + str.Join(items, ",") + "]}"
end

func std_sidebar(ctx: HashMap<str, str>, pkgs: Vector<StdPkg>, current: int): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, `<nav class="course-nav" aria-label="` + ctx_or(ctx, "stdref.all", "") + `"><a class="course-nav-home" href="/std/">` + ctx_or(ctx, "stdref.all", "") + "</a>")
    mut group := ""
    repeat pkgs.Len() in i:
        p := pkgs.Get(i)
        if p.group != group:
            if group != "":
                str.BufAppend(b, "</ol>")
            end
            group = p.group
            str.BufAppend(b, `<p class="course-nav-part">` + group + "</p><ol>")
        end
        cur := i == current ? ` aria-current="page"` : ""
        str.BufAppend(b, `<li><a href="` + p.url + `"` + cur + ">" + p.name + "</a></li>")
    end
    if group != "":
        str.BufAppend(b, "</ol>")
    end
    str.BufAppend(b, "</nav>")
    ret str.BufStr(b)
end

func std_jsonld(ctx: HashMap<str, str>, p: StdPkg, version: str): str:
    u := ctx_or(ctx, "site.url", "")
    tag := ctx_or(ctx, "site.lang_tag", ctx_or(ctx, "site.lang", ""))
    page_url := u + p.url
    title := ctx_or(ctx, "pkg.title", p.name)
    desc := ctx_or(ctx, "pkg.description", "")
    mut graph := Vector {} as Vector<str>
    site_nodes(ctx, version, graph)
    graph.Push(webpage_node(ctx, page_url, title, desc, true))
    graph.Push(`{"@type":"TechArticle","@id":` + json_str(page_url + "#article") + modified_prop(ctx) + `,"headline":` + json_str(pkg_label(p)) + `,"description":` + json_str(desc) + `,"url":` + json_str(page_url) + `,"inLanguage":` + json_str(tag) + `,"image":` + json_str(u + ctx_or(ctx, "page.og_image", ctx_or(ctx, "site.og_image", ""))) + `,"about":{"@id":` + json_str(u + "/#language") + `},"isPartOf":{"@id":` + json_str(u + "/std/#webpage") + `},"author":{"@id":` + json_str(u + "/#organization") + `},"publisher":{"@id":` + json_str(u + "/#organization") + "}}")
    mut names := Vector {} as Vector<str>
    mut urls := Vector {} as Vector<str>
    names.Push(ctx_or(ctx, "nav.home", ""))
    urls.Push(u + "/")
    names.Push(ctx_or(ctx, "nav.std", ""))
    urls.Push(u + "/std/")
    names.Push(p.name)
    urls.Push(page_url)
    graph.Push(crumb_node(page_url, names, urls))
    ret wrap_graph(graph)
end

func load_api(p: StdPkg, errs &: Vector<str>): ApiDoc:
    mut api := ApiDoc {}
    path := ROOT + "/dist/api/" + p.slug + ".json"
    if not fs.Exists(path):
        println "website: " + path + ": missing API doc (skipped)"
        ret api
    end
    try:
        json.Unmarshal(io.ReadFile(path), api)
    catch err:
        report(errs, path + ": " + err.to_str())
    end
    ret api
end

func pkg_leaf(en: str): str:
    dotted := str.Replace(en, "/", ".")
    pos := str.LastIndex(dotted, ".")
    if pos < 0:
        ret dotted
    end
    ret dotted.Substr(pos + 1, dotted.Len() - pos - 1)
end

func std_gwords(pkgs: Vector<StdPkg>, alias: str): HashMap<str, str>:
    mut out := HashMap {} as HashMap<str, str>
    if alias.Len() == 0:
        ret out
    end
    mut ignored := Vector {} as Vector<str>
    defer ignored.Free()
    each p in pkgs:
        if p.name.Len() == 0:
            continue
        end
        api := load_api(p, ignored)
        leaf := pkg_leaf(p.en)
        full := str.Replace(p.en, "/", ".")
        each d in api.decls:
            if d.par >= 0 or (d.k != "struct" and d.k != "enum" and d.k != "type" and d.k != "interface"):
                continue
            end
            fa := alias_of(d, alias)
            if fa.Len() == 0:
                continue
            end
            out.Put(leaf + "." + d.n, p.name + "." + fa)
            if full != leaf and p.imp.Len() > 0:
                out.Put(full + "." + d.n, p.imp + "." + fa)
            end
        end
    end
    ret out
end

func md_sentinel(): str:
    mut v := Vector {} as Vector<int>
    v.Push(57344)
    ret str.FromCodePoints(v)
end

func md_mark(n: int): str:
    s := md_sentinel()
    ret s + n + s
end

func md_is_alpha(c: int): bool:
    ret (c >= 65 and c <= 90) or (c >= 97 and c <= 122)
end

func md_tag_end(s: str, at: int): int:
    p := s as i8 *
    n := s.Len()
    mut j := at + 1
    if j < n and p[j] == 47:
        j++
    end
    start := j
    until j < n and md_is_alpha(p[j] as int):
        j++
    end
    if j == start:
        ret -1
    end
    name := str.Lower(s.Substr(start, j - start))
    if " bdi kbd sub sup br abbr mark small span em strong b i a ".Find(" " + name + " ") < 0:
        ret -1
    end
    close := str.IndexFrom(s, ">", j)
    ret close < 0 ? -1 : close + 1
end

func md_entity_at(s: str, at: int): bool:
    p := s as i8 *
    n := s.Len()
    mut j := at + 1
    if j < n and p[j] == 35:
        j++
    end
    start := j
    until j < n and (md_is_alpha(p[j] as int) or (p[j] >= 48 and p[j] <= 57)):
        j++
    end
    ret j > start and j < n and p[j] == 59
end

func md_escape(s: str): str:
    p := s as i8 *
    n := s.Len()
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut run := 0
    mut i := 0
    until i < n:
        c := p[i]
        if c == 60 or c == 62 or c == 38:
            str.BufAppend(b, s.Substr(run, i - run))
            if c == 60:
                stop := md_tag_end(s, i)
                if stop > 0:
                    str.BufAppend(b, s.Substr(i, stop - i))
                    i = stop
                    run = i
                    continue
                end
                str.BufAppend(b, "&lt;")
            else c == 62:
                str.BufAppend(b, "&gt;")
            else:
                str.BufAppend(b, md_entity_at(s, i) ? "&" : "&amp;")
            end
            run = i + 1
        end
        i++
    end
    str.BufAppend(b, s.Substr(run, n - run))
    ret str.BufStr(b)
end

func md_pairs(s: str, mark: str, open: str, close: str): str:
    parts := str.Split(s, mark)
    if parts.Len() < 3:
        ret s
    end
    mut out := parts.Get(0)
    mut k := 1
    until k < parts.Len():
        if k + 1 < parts.Len():
            out = out + open + parts.Get(k) + close + parts.Get(k + 1)
            k += 2
        else:
            out = out + mark + parts.Get(k)
            k++
        end
    end
    ret out
end

func md_is_word_byte(c: int): bool:
    ret md_is_alpha(c) or (c >= 48 and c <= 57)
end

func md_underscores(s: str): str:
    p := s as i8 *
    n := s.Len()
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut run := 0
    mut i := 0
    until i < n:
        if p[i] == 95 and (i == 0 or not md_is_word_byte(p[i - 1] as int)) and i + 1 < n and p[i + 1] != 32 and p[i + 1] != 95:
            mut j := i + 2
            mut close := -1
            until j < n and close < 0:
                if p[j] == 95 and p[j - 1] != 32 and (j + 1 == n or not md_is_word_byte(p[j + 1] as int)):
                    close = j
                end
                j++
            end
            if close > 0:
                str.BufAppend(b, s.Substr(run, i - run))
                str.BufAppend(b, "<em>" + s.Substr(i + 1, close - i - 1) + "</em>")
                i = close + 1
                run = i
                continue
            end
        end
        i++
    end
    str.BufAppend(b, s.Substr(run, n - run))
    ret str.BufStr(b)
end

func md_links(s: str): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut i := 0
    until true:
        open := str.IndexFrom(s, "[", i)
        if open < 0:
            break
        end
        mid := str.IndexFrom(s, "](", open + 1)
        if mid < 0:
            break
        end
        close := str.IndexFrom(s, ")", mid + 2)
        if close < 0:
            break
        end
        inner_open := str.IndexFrom(s, "[", open + 1)
        if inner_open >= 0 and inner_open < mid:
            str.BufAppend(b, s.Substr(i, inner_open - i))
            i = inner_open
            continue
        end
        text := s.Substr(open + 1, mid - open - 1)
        href := str.Trim(s.Substr(mid + 2, close - mid - 2))
        str.BufAppend(b, s.Substr(i, open - i))
        if str.StartsWith(href, "http://") or str.StartsWith(href, "https://"):
            str.BufAppend(b, `<a href="` + href + `" rel="noopener">` + text + "</a>")
        else:
            str.BufAppend(b, `<a href="` + href + `">` + text + "</a>")
        end
        i = close + 1
    end
    str.BufAppend(b, s.Substr(i, s.Len() - i))
    ret str.BufStr(b)
end

func md_inline(s: str): str:
    mut codes := Vector {} as Vector<str>
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut i := 0
    until true:
        a := str.IndexFrom(s, "`", i)
        if a < 0:
            break
        end
        z := str.IndexFrom(s, "`", a + 1)
        if z < 0:
            break
        end
        str.BufAppend(b, s.Substr(i, a - i))
        code := s.Substr(a + 1, z - a - 1)
        codes.Push("<code>" + escape_text(code) + "</code>")
        str.BufAppend(b, md_mark(codes.Len() - 1))
        i = z + 1
    end
    str.BufAppend(b, s.Substr(i, s.Len() - i))
    mut out := md_escape(str.BufStr(b))
    out = md_links(out)
    out = md_pairs(out, "**", "<strong>", "</strong>")
    out = md_pairs(out, "*", "<em>", "</em>")
    out = md_underscores(out)
    repeat codes.Len() in k:
        out = str.Replace(out, md_mark(k), codes.Get(k))
    end
    ret out
end

func md_slug(text: str): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut dash := false
    each cp in str.CodePoints(str.Lower(strip_tags(text))):
        if (cp >= 97 and cp <= 122) or (cp >= 48 and cp <= 57):
            if dash and str.BufLen(b) > 0:
                str.BufAppendChar(b, 45)
            end
            str.BufAppendCp(b, cp)
            dash = false
        else cp != 39:
            dash = true
        end
    end
    ret str.BufStr(b)
end

func md_indent(line: str): int:
    p := line as i8 *
    mut i := 0
    until i < line.Len() and p[i] == 32:
        i++
    end
    ret i
end

func md_list_marker(t: str): int:
    if str.StartsWith(t, "- ") or str.StartsWith(t, "* "):
        ret 2
    end
    p := t as i8 *
    mut i := 0
    until i < t.Len() and p[i] >= 48 and p[i] <= 57:
        i++
    end
    if i > 0 and i + 1 < t.Len() and p[i] == 46 and p[i + 1] == 32:
        ret i + 2
    end
    ret 0
end

func md_is_block_start(t: str): bool:
    if str.StartsWith(t, "```") or str.StartsWith(t, "## ") or str.StartsWith(t, "### ") or str.StartsWith(t, "#### "):
        ret true
    end
    if str.StartsWith(t, ">") or str.StartsWith(t, "|") or t == "---" or md_list_marker(t) > 0:
        ret true
    end
    ret str.StartsWith(t, "{{") and str.EndsWith(t, "}}")
end

func md_is_html_block(t: str): bool:
    each tag in ["<div", "<details", "<figure", "<table", "<aside", "<section", "<p>", "<p ", "<iframe", "<!--", "<svg", "<dl"]:
        if str.StartsWith(t, tag):
            ret true
        end
    end
    ret false
end

func md_lang_label(ctx: HashMap<str, str>, lang: str): str:
    switch lang:
        "c": ret "C" end
        "cpp", "c++": ret "C++" end
        "rust", "rs": ret "Rust" end
        "go": ret "Go" end
        "python", "py": ret "Python" end
        "javascript", "js": ret "JavaScript" end
        "typescript", "ts": ret "TypeScript" end
        "java": ret "Java" end
        "php": ret "PHP" end
        "zig": ret "Zig" end
        "cs", "csharp": ret "C#" end
        "kotlin": ret "Kotlin" end
        "swift": ret "Swift" end
        "julia", "jl": ret "Julia" end
        "json": ret "JSON" end
        "yaml", "yml": ret "YAML" end
        "toml": ret "TOML" end
        "bash", "sh", "shell", "console", "zsh": ret ctx_or(ctx, "blog.code_terminal", "Terminal") end
    end
    ret lang
end

func md_code_block(info: str, src: str, out: str, has_out: bool, classes: HashMap<str, str>, ctx: HashMap<str, str>, slug: str, n: int, errs &: Vector<str>): str:
    fields := str.Fields(info)
    lang := fields.Len() > 0 ? str.Lower(fields.Get(0)) : ""
    id := "code-" + slug + "-" + n
    mut file_label := lang
    mut code_html := ""
    mut dir_attr := "ltr"
    if lang == "salam":
        code_html = highlight(src, classes)
        dir_attr = has_rtl_script(src) ? "rtl" : "ltr"
        file_label = ctx_or(ctx, "blog.code_salam", "Salam")
        each f in fields:
            if str.EndsWith(f, ".salam"):
                file_label = f
            end
        end
    else lang == "output":
        dir_attr = has_rtl_script(src) ? "rtl" : "ltr"
        ret `<div class="code-output code-output-alone" dir="` + dir_attr + `"><span class="label">` + label(ctx, "code.output", errs) + "</span>" + escape_text(src) + "</div>\n"
    else lang.Len() > 0 and lang != "text":
        code_html = highlight_lang(src, lang)
        file_label = md_lang_label(ctx, lang)
    else:
        code_html = escape_text(src)
        dir_attr = has_rtl_script(src) ? "rtl" : "ltr"
        file_label = ctx_or(ctx, "blog.code_text", "Text")
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, `<div class="code-window">`)
    str.BufAppend(b, `<div class="code-bar"><span class="dots" aria-hidden="true"><span></span><span></span><span></span></span>`)
    str.BufAppend(b, `<span class="file" dir="ltr">` + escape_text(file_label) + "</span>")
    str.BufAppend(b, `<button type="button" class="copy-button" data-copy-target="` + id + `" data-copied="` + escape_text(label(ctx, "code.copied", errs)) + `">` + label(ctx, "code.copy", errs) + "</button></div>")
    str.BufAppend(b, `<pre class="code" dir="` + dir_attr + `"><code id="` + id + `">` + code_html + "</code></pre>")
    if has_out:
        str.BufAppend(b, `<div class="code-output" dir="` + dir_attr + `"><span class="label">` + label(ctx, "code.output", errs) + "</span>" + escape_text(str.TrimRight(out)) + "</div>")
    end
    str.BufAppend(b, "</div>\n")
    ret str.BufStr(b)
end

func md_cells(row: str): Vector<str>:
    mut r := str.Trim(row)
    r = str.TrimPrefix(r, "|")
    r = str.TrimSuffix(r, "|")
    pipe := md_sentinel() + "p" + md_sentinel()
    r = str.Replace(r, "\\|", pipe)
    mut out := Vector {} as Vector<str>
    each c in str.Split(r, "|"):
        out.Push(str.Replace(str.Trim(c), pipe, "|"))
    end
    ret out
end

func md_is_rule_row(row: str): bool:
    each cp in str.CodePoints(row):
        if cp != 124 and cp != 45 and cp != 58 and cp != 32:
            ret false
        end
    end
    ret true
end

func md_table(rows: Vector<str>, where: str, errs &: Vector<str>): str:
    if rows.Len() < 2 or not md_is_rule_row(rows.Get(1)):
        report(errs, where + ": a table needs a header row and a |---| rule row")
        ret ""
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, `<div class="table-wrap"><table><thead><tr>`)
    head := md_cells(rows.Get(0))
    each c in head:
        str.BufAppend(b, "<th>" + md_inline(c) + "</th>")
    end
    str.BufAppend(b, "</tr></thead><tbody>")
    mut r := 2
    until r < rows.Len():
        cells := md_cells(rows.Get(r))
        if cells.Len() != head.Len():
            report(errs, where + ": table row has " + cells.Len() + " cells, the header has " + head.Len() + ": " + rows.Get(r))
        end
        str.BufAppend(b, "<tr>")
        each c in cells:
            str.BufAppend(b, "<td>" + md_inline(c) + "</td>")
        end
        str.BufAppend(b, "</tr>")
        r++
    end
    str.BufAppend(b, "</tbody></table></div>\n")
    ret str.BufStr(b)
end

func md_list_item(item: str, classes: HashMap<str, str>, ctx: HashMap<str, str>, slug: str, n &: int, ids &: HashMap<str, str>, errs &: Vector<str>): str:
    lines := item.Split("\n")
    mut head := Vector {} as Vector<str>
    mut k := 0
    until k < lines.Len():
        t := str.Trim(lines.Get(k))
        if t.Len() == 0 or (head.Len() > 0 and md_is_block_start(t)):
            break
        end
        head.Push(t)
        k++
    end
    mut rest := Vector {} as Vector<str>
    until k < lines.Len():
        rest.Push(lines.Get(k))
        k++
    end
    mut out := md_inline(str.Join(head, " "))
    if rest.Len() > 0:
        out += "\n" + md_render(str.Join(rest, "\n"), classes, ctx, slug, n, ids, errs)
    end
    ret out
end

func md_render(md: str, classes: HashMap<str, str>, ctx: HashMap<str, str>, slug: str, n &: int, ids &: HashMap<str, str>, errs &: Vector<str>): str:
    lines := md.Split("\n")
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    mut i := 0
    until i < lines.Len():
        line := strip_cr(lines.Get(i))
        t := str.Trim(line)
        if t.Len() == 0:
            i++
            continue
        end
        if str.StartsWith(t, "```"):
            info := str.Trim(str.TrimPrefix(t, "```"))
            fence_indent := md_indent(line)
            mut code := Vector {} as Vector<str>
            mut closed := false
            i++
            until i < lines.Len():
                l := strip_cr(lines.Get(i))
                i++
                if str.Trim(l) == "```":
                    closed = true
                    break
                end
                cut := md_indent(l) < fence_indent ? md_indent(l) : fence_indent
                code.Push(l.Substr(cut, l.Len() - cut))
            end
            if not closed:
                report(errs, slug + ": a code block has no closing ```")
            end
            mut out := ""
            mut has_out := false
            mut k := i
            until k < lines.Len() and str.Trim(strip_cr(lines.Get(k))).Len() == 0:
                k++
            end
            if not str.StartsWith(info, "output") and k < lines.Len() and str.Trim(strip_cr(lines.Get(k))) == "```output":
                mut ol := Vector {} as Vector<str>
                out_indent := md_indent(strip_cr(lines.Get(k)))
                k++
                until k < lines.Len():
                    l := strip_cr(lines.Get(k))
                    k++
                    if str.Trim(l) == "```":
                        break
                    end
                    cut := md_indent(l) < out_indent ? md_indent(l) : out_indent
                    ol.Push(l.Substr(cut, l.Len() - cut))
                end
                out = str.Join(ol, "\n")
                has_out = true
                i = k
            end
            n++
            str.BufAppend(b, md_code_block(info, str.TrimRight(str.Join(code, "\n")), out, has_out, classes, ctx, slug, n, errs))
            continue
        end
        if str.StartsWith(t, "#"):
            mut level := 0
            until level < t.Len() and t.Substr(level, 1) == "#":
                level++
            end
            if level >= 2 and level <= 4 and t.Substr(level, 1) == " ":
                mut text := str.Trim(t.Substr(level, t.Len() - level))
                mut id := ""
                brace := str.LastIndex(text, "{#")
                if brace >= 0 and str.EndsWith(text, "}"):
                    id = text.Substr(brace + 2, text.Len() - brace - 3)
                    text = str.Trim(text.Substr(0, brace))
                    if ids.Has(id):
                        report(errs, slug + ": two headings share the id '" + id + "'")
                    end
                end
                if id.Len() == 0:
                    base_id := md_slug(text).Len() > 0 ? md_slug(text) : "section"
                    id = base_id
                    mut k := 2
                    until ids.Has(id):
                        id = base_id + "-" + k
                        k++
                    end
                end
                ids.Put(id, "1")
                str.BufAppend(b, "<h" + level + ` id="` + id + `">` + md_inline(text) + "</h" + level + ">\n")
                i++
                continue
            end
            if level == 1:
                report(errs, slug + ": use the front matter title instead of a # heading")
            end
        end
        if t == "---" or t == "***":
            str.BufAppend(b, "<hr />\n")
            i++
            continue
        end
        if str.StartsWith(t, ">"):
            mut q := Vector {} as Vector<str>
            until i < lines.Len():
                l := str.Trim(strip_cr(lines.Get(i)))
                if not str.StartsWith(l, ">"):
                    break
                end
                q.Push(str.TrimPrefix(str.TrimPrefix(l, ">"), " "))
                i++
            end
            mut kind := ""
            if q.Len() > 0:
                first := str.Trim(q.Get(0))
                if first == "[!NOTE]" or first == "[!TIP]" or first == "[!WARNING]" or first == "[!IMPORTANT]":
                    kind = str.Lower(first.Substr(2, first.Len() - 3))
                    q.Set(0, "")
                end
            end
            inner := md_render(str.Join(q, "\n"), classes, ctx, slug, n, ids, errs)
            if kind.Len() > 0:
                str.BufAppend(b, `<div class="note note-` + kind + `">` + inner + "</div>\n")
            else:
                str.BufAppend(b, "<blockquote>" + inner + "</blockquote>\n")
            end
            continue
        end
        if str.StartsWith(t, "|"):
            mut rows := Vector {} as Vector<str>
            until i < lines.Len() and str.StartsWith(str.Trim(strip_cr(lines.Get(i))), "|"):
                rows.Push(str.Trim(strip_cr(lines.Get(i))))
                i++
            end
            str.BufAppend(b, md_table(rows, slug, errs))
            continue
        end
        if md_list_marker(t) > 0:
            base := md_indent(line)
            ordered := not (str.StartsWith(t, "- ") or str.StartsWith(t, "* "))
            mut items := Vector {} as Vector<str>
            mut cur := Vector {} as Vector<str>
            mut width := 0
            until i < lines.Len():
                l := strip_cr(lines.Get(i))
                lt2 := str.Trim(l)
                ind := md_indent(l)
                if lt2.Len() == 0:
                    mut k := i + 1
                    until k < lines.Len() and str.Trim(lines.Get(k)).Len() == 0:
                        k++
                    end
                    if k < lines.Len() and md_indent(lines.Get(k)) > base:
                        cur.Push("")
                        i++
                        continue
                    end
                    break
                end
                lm := md_list_marker(lt2)
                if ind <= base and lm > 0:
                    if cur.Len() > 0:
                        items.Push(str.Join(cur, "\n"))
                        cur = Vector {} as Vector<str>
                    end
                    width = lm
                    cur.Push(lt2.Substr(lm, lt2.Len() - lm))
                    i++
                    continue
                end
                if ind > base:
                    cut := ind < base + width ? ind : base + width
                    cur.Push(l.Substr(cut, l.Len() - cut))
                    i++
                    continue
                end
                if md_is_block_start(lt2) or md_is_html_block(lt2):
                    break
                end
                cur.Push(lt2)
                i++
            end
            if cur.Len() > 0:
                items.Push(str.Join(cur, "\n"))
            end
            tag := ordered ? "ol" : "ul"
            str.BufAppend(b, "<" + tag + ">\n")
            each it in items:
                str.BufAppend(b, "<li>" + md_list_item(it, classes, ctx, slug, n, ids, errs) + "</li>\n")
            end
            str.BufAppend(b, "</" + tag + ">\n")
            continue
        end
        if str.StartsWith(t, "{{") and str.EndsWith(t, "}}"):
            key := str.Trim(t.Substr(2, t.Len() - 4))
            if ctx.Has(key):
                str.BufAppend(b, ctx.Get(key) + "\n")
            else:
                report(errs, slug + ": no value for '" + key + "'")
            end
            i++
            continue
        end
        if md_is_html_block(t):
            until i < lines.Len() and str.Trim(strip_cr(lines.Get(i))).Len() > 0:
                str.BufAppend(b, strip_cr(lines.Get(i)) + "\n")
                i++
            end
            continue
        end
        mut para := Vector {} as Vector<str>
        until i < lines.Len():
            l := str.Trim(strip_cr(lines.Get(i)))
            if l.Len() == 0 or (para.Len() > 0 and md_is_block_start(l)):
                break
            end
            para.Push(l)
            i++
        end
        str.BufAppend(b, "<p>" + md_inline(str.Join(para, " ")) + "</p>\n")
    end
    ret str.BufStr(b)
end

func post_parse(path: str, m &: HashMap<str, str>, errs &: Vector<str>): str:
    lines := io.ReadFile(path).Split("\n")
    if lines.Len() == 0 or str.Trim(strip_cr(lines.Get(0))) != "---":
        report(errs, path + ": an article starts with a --- front matter block")
        ret ""
    end
    mut i := 1
    mut closed := false
    until i < lines.Len():
        t := str.Trim(strip_cr(lines.Get(i)))
        i++
        if t == "---":
            closed = true
            break
        end
        if t.Len() == 0 or str.StartsWith(t, "#"):
            continue
        end
        pos := t.Find(":")
        if pos <= 0:
            report(errs, path + ": expected 'key: value' in the front matter, got: " + t)
            continue
        end
        key := str.Trim(t.Substr(0, pos))
        mut value := str.Trim(t.Substr(pos + 1, t.Len() - pos - 1))
        if value.Len() >= 2 and str.StartsWith(value, "\"") and str.EndsWith(value, "\""):
            value = value.Substr(1, value.Len() - 2)
        end
        if m.Has("post." + key):
            report(errs, path + ": duplicate front matter key '" + key + "'")
        end
        m.Put("post." + key, value)
    end
    if not closed:
        report(errs, path + ": the front matter has no closing ---")
    end
    mut body := Vector {} as Vector<str>
    until i < lines.Len():
        body.Push(strip_cr(lines.Get(i)))
        i++
    end
    ret str.Join(body, "\n")
end

func is_iso_date(s: str): bool:
    if s.Len() != 10 or s.Substr(4, 1) != "-" or s.Substr(7, 1) != "-":
        ret false
    end
    ret lead_num(s) > 1999 and lead_num(s.Substr(5, 2)) >= 1 and lead_num(s.Substr(5, 2)) <= 12 and lead_num(s.Substr(8, 2)) >= 1 and lead_num(s.Substr(8, 2)) <= 31
end

func load_posts(lang_dir: str, ctx: HashMap<str, str>, errs &: Vector<str>): Vector<Post>:
    mut out := Vector {} as Vector<Post>
    bdir := lang_dir + "/blog"
    if not dir.Exists(bdir):
        ret out
    end
    mut names := Vector {} as Vector<str>
    each name in dir.ListFiles(bdir):
        if str.EndsWith(name, ".md"):
            names.Push(name)
        end
    end
    sort_names(names)
    cats := " " + ctx_or(ctx, "blog.categories", "") + " "
    mut seen := HashMap {} as HashMap<str, str>
    each name in names:
        path := bdir + "/" + name
        mut m := HashMap {} as HashMap<str, str>
        _body := post_parse(path, m, errs)
        each key in ["title", "seo_title", "description", "keywords", "category", "summary", "date"]:
            if not m.Has("post." + key) or str.Trim(m.Get("post." + key)).Len() == 0:
                report(errs, path + ": missing front matter '" + key + "'")
            end
        end
        cat := ctx_or(m, "post.category", "")
        if cats.Find(" " + cat + " ") < 0:
            report(errs, path + ": category '" + cat + "' is not in blog.categories")
        end
        date := ctx_or(m, "post.date", "")
        if not is_iso_date(date):
            report(errs, path + ": date must be YYYY-MM-DD, got '" + date + "'")
        end
        updated := ctx_or(m, "post.updated", "")
        if updated.Len() > 0 and not is_iso_date(updated):
            report(errs, path + ": updated must be YYYY-MM-DD, got '" + updated + "'")
        end
        image := ctx_or(m, "post.image", "")
        if image.Len() > 0 and not str.StartsWith(image, "/"):
            report(errs, path + ": image must be a site path starting with '/'")
        end
        slug := lesson_slug(str.TrimSuffix(name, ".md"))
        if seen.Has(slug):
            report(errs, path + ": another article already uses the slug '" + slug + "'")
        end
        seen.Put(slug, "1")
        out.Push(Post { path = path, slug = slug, url = "/blog/" + slug + "/", title = escape_text(ctx_or(m, "post.title", "")), category = cat, summary = escape_text(ctx_or(m, "post.summary", "")), date = date, updated = updated, image = image, image_alt = ctx_or(m, "post.image_alt", "") })
    end
    ret out
end

func post_modified(p: Post): str:
    ret p.updated.Len() > 0 ? newest(p.date, p.updated) : p.date
end

func post_date_text(ctx: HashMap<str, str>, iso: str): str:
    if not is_iso_date(iso):
        ret iso
    end
    g := calendar.GregorianDate { year = lead_num(iso), month = lead_num(iso.Substr(5, 2)), day = lead_num(iso.Substr(8, 2)) }
    if ctx_or(ctx, "site.lang", "") == "fa":
        ret str.ToPersianDigits(calendar.FormatJalaliLongFa(calendar.GregorianToJalali(g)))
    end
    ret calendar.FormatGregorianLongEn(g)
end

func post_minutes(html: str): int:
    words := str.Fields(strip_tags(html)).Len()
    mins := (words + 199) / 200
    ret mins < 1 ? 1 : mins
end

func cat_label(ctx: HashMap<str, str>, cat: str): str:
    ret ctx_or(ctx, "blog.cat." + cat, cat)
end

func blog_card(ctx: HashMap<str, str>, p: Post, heading: str): str:
    mut img := ""
    if p.image.Len() > 0:
        alt := p.image_alt.Len() > 0 ? p.image_alt : strip_tags(decode_entities(p.title))
        img = `<img class="blog-card-image" src="` + escape_text(p.image) + `" alt="` + escape_text(alt) + `" loading="lazy" decoding="async" />`
    end
    ret `<article class="blog-card"><a href="` + p.url + `">` + img + `<span class="blog-card-cat">` + cat_label(ctx, p.category) + "</span><" + heading + ">" + p.title + "</" + heading + "><p>" + p.summary + `</p><span class="blog-card-more">` + ctx_or(ctx, "blog.read_more", "") + "</span></a></article>"
end

func blog_index_html(ctx: HashMap<str, str>, posts: Vector<Post>): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    cats := str.Fields(ctx_or(ctx, "blog.categories", ""))
    str.BufAppend(b, `<nav class="blog-cats" aria-label="` + ctx_or(ctx, "blog.cats_label", "") + `">`)
    each cat in cats:
        mut count := 0
        each p in posts:
            if p.category == cat:
                count++
            end
        end
        if count > 0:
            str.BufAppend(b, `<a href="#` + cat + `">` + cat_label(ctx, cat) + ` <span class="blog-cat-count">` + digits(ctx, count) + "</span></a>")
        end
    end
    str.BufAppend(b, "</nav>\n")
    featured := str.Fields(ctx_or(ctx, "blog.featured", ""))
    mut feat := ""
    each slug in featured:
        each p in posts:
            if p.slug == slug:
                feat += blog_card(ctx, p, "h3")
            end
        end
    end
    if feat.Len() > 0:
        str.BufAppend(b, `<section class="blog-part blog-featured" id="start-here"><h2>` + ctx_or(ctx, "blog.featured_title", "") + `</h2><div class="blog-grid">` + feat + "</div></section>\n")
    end
    each cat in cats:
        mut cards := ""
        each p in posts:
            if p.category == cat:
                cards += blog_card(ctx, p, "h3")
            end
        end
        if cards.Len() > 0:
            str.BufAppend(b, `<section class="blog-part" id="` + cat + `"><h2>` + cat_label(ctx, cat) + "</h2>")
            lead := ctx_or(ctx, "blog.cat." + cat + "_lead", "")
            if lead.Len() > 0:
                str.BufAppend(b, `<p class="blog-part-lead">` + lead + "</p>")
            end
            str.BufAppend(b, `<div class="blog-grid">` + cards + "</div></section>\n")
        end
    end
    ret str.BufStr(b)
end

func blog_home_html(ctx: HashMap<str, str>, posts: Vector<Post>): str:
    mut cards := ""
    mut shown := 0
    each slug in str.Fields(ctx_or(ctx, "blog.home_posts", "")):
        each p in posts:
            if p.slug == slug and shown < 6:
                cards += blog_card(ctx, p, "h3")
                shown++
            end
        end
    end
    ret cards.Len() > 0 ? `<div class="blog-grid">` + cards + "</div>" : ""
end

func blog_nodes(ctx: HashMap<str, str>, posts: Vector<Post>): str:
    u := ctx_or(ctx, "site.url", "")
    tag := ctx_or(ctx, "site.lang_tag", ctx_or(ctx, "site.lang", ""))
    mut refs := Vector {} as Vector<str>
    mut items := Vector {} as Vector<str>
    repeat posts.Len() in i:
        p := posts.Get(i)
        refs.Push(`{"@id":` + json_str(u + p.url + "#article") + "}")
        items.Push(`{"@type":"ListItem","position":` + (i + 1) + `,"name":` + json_str(strip_tags(decode_entities(p.title))) + `,"url":` + json_str(u + p.url) + "}")
    end
    blog := `{"@type":"Blog","@id":` + json_str(u + "/blog/#blog") + `,"name":` + json_str(ctx_or(ctx, "blog.heading", "")) + `,"description":` + json_str(ctx_or(ctx, "blog.description", "")) + `,"url":` + json_str(u + "/blog/") + `,"inLanguage":` + json_str(tag) + `,"about":{"@id":` + json_str(u + "/#language") + `},"publisher":{"@id":` + json_str(u + "/#organization") + `},"blogPost":[` + str.Join(refs, ",") + "]}"
    list := `{"@type":"ItemList","@id":` + json_str(u + "/blog/#articles") + `,"name":` + json_str(ctx_or(ctx, "blog.heading", "")) + `,"itemListElement":[` + str.Join(items, ",") + "]}"
    ret blog + "," + list
end

func post_jsonld(ctx: HashMap<str, str>, p: Post, words: int, version: str): str:
    u := ctx_or(ctx, "site.url", "")
    tag := ctx_or(ctx, "site.lang_tag", ctx_or(ctx, "site.lang", ""))
    page_url := u + p.url
    title := strip_tags(decode_entities(p.title))
    desc := ctx_or(ctx, "page.description_raw", "")
    mut graph := Vector {} as Vector<str>
    site_nodes(ctx, version, graph)
    graph.Push(webpage_node(ctx, page_url, ctx_or(ctx, "page.title_raw", title), desc, true))
    org := `{"@id":` + json_str(u + "/#organization") + "}"
    graph.Push(`{"@type":["BlogPosting","TechArticle"],"@id":` + json_str(page_url + "#article") + `,"headline":` + json_str(title) + `,"description":` + json_str(desc) + `,"url":` + json_str(page_url) + `,"mainEntityOfPage":{"@id":` + json_str(page_url + "#webpage") + `},"datePublished":` + json_str(p.date) + `,"dateModified":` + json_str(post_modified(p)) + `,"inLanguage":` + json_str(tag) + `,"image":` + json_str(u + ctx_or(ctx, "page.og_image", ctx_or(ctx, "site.og_image", ""))) + `,"keywords":` + json_str(ctx_or(ctx, "page.keywords", "")) + `,"articleSection":` + json_str(strip_tags(cat_label(ctx, p.category))) + `,"wordCount":` + words + `,"about":{"@id":` + json_str(u + "/#language") + `},"isPartOf":{"@id":` + json_str(u + "/blog/#blog") + `},"author":` + org + `,"publisher":` + org + "}")
    mut names := Vector {} as Vector<str>
    mut urls := Vector {} as Vector<str>
    names.Push(ctx_or(ctx, "nav.home", ""))
    urls.Push(u + "/")
    names.Push(ctx_or(ctx, "nav.blog", ""))
    urls.Push(u + "/blog/")
    names.Push(title)
    urls.Push(page_url)
    graph.Push(crumb_node(page_url, names, urls))
    ret wrap_graph(graph)
end

func post_related(ctx: HashMap<str, str>, posts: Vector<Post>, current: int): str:
    p := posts.Get(current)
    mut cards := ""
    mut shown := 0
    mut k := 1
    until k < posts.Len() and shown < 3:
        q := posts.Get((current + k) % posts.Len())
        if q.category == p.category:
            cards += blog_card(ctx, q, "h3")
            shown++
        end
        k++
    end
    ret cards
end

func xml_escape(s: str): str:
    ret str.Replace(str.Replace(str.Replace(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;")
end

func blog_atom(ctx: HashMap<str, str>, posts: Vector<Post>): str:
    u := ctx_or(ctx, "site.url", "")
    mut latest := ""
    each p in posts:
        latest = newest(latest, post_modified(p))
    end
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, `<?xml version="1.0" encoding="utf-8"?>` + "\n" + `<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="` + ctx_or(ctx, "site.lang_tag", "") + `">` + "\n")
    str.BufAppend(b, "  <title>" + xml_escape(ctx_or(ctx, "blog.feed_title", "")) + "</title>\n")
    str.BufAppend(b, "  <subtitle>" + xml_escape(ctx_or(ctx, "blog.description", "")) + "</subtitle>\n")
    str.BufAppend(b, `  <link rel="self" href="` + u + `/blog/atom.xml"/>` + "\n")
    str.BufAppend(b, `  <link rel="alternate" type="text/html" href="` + u + `/blog/"/>` + "\n")
    str.BufAppend(b, "  <id>" + u + "/blog/</id>\n  <updated>" + latest + "T00:00:00Z</updated>\n")
    str.BufAppend(b, "  <author><name>" + xml_escape(ctx_or(ctx, "site.author", "")) + "</name><uri>" + u + "/</uri></author>\n")
    str.BufAppend(b, `  <icon>` + u + "/assets/img/icon-192.png</icon>\n")
    each p in posts:
        str.BufAppend(b, "  <entry>\n    <title>" + xml_escape(decode_entities(p.title)) + "</title>\n")
        str.BufAppend(b, `    <link rel="alternate" type="text/html" href="` + u + p.url + `"/>` + "\n")
        str.BufAppend(b, "    <id>" + u + p.url + "</id>\n    <published>" + p.date + "T00:00:00Z</published>\n    <updated>" + post_modified(p) + "T00:00:00Z</updated>\n")
        str.BufAppend(b, `    <category term="` + xml_escape(strip_tags(cat_label(ctx, p.category))) + `"/>` + "\n")
        str.BufAppend(b, "    <summary>" + xml_escape(decode_entities(p.summary)) + "</summary>\n  </entry>\n")
    end
    str.BufAppend(b, "</feed>\n")
    ret str.BufStr(b)
end

func alt_urls(alt_dir: str): HashMap<str, str>:
    mut ignored := Vector {} as Vector<str>
    mut out := HashMap {} as HashMap<str, str>
    each name in dir.ListFiles(ROOT + "/templates/pages"):
        if str.EndsWith(name, ".html") and name != "404.html":
            out.Put(page_for(str.TrimSuffix(name, ".html")).url, "1")
        end
    end
    each l in load_lessons(alt_dir, ignored):
        out.Put(l.url, "1")
    end
    each p in load_std(alt_dir, ignored):
        out.Put(p.url, "1")
    end
    no_ctx := HashMap {} as HashMap<str, str>
    each q in load_posts(alt_dir, no_ctx, ignored):
        out.Put(q.url, "1")
    end
    ret out
end

func set_alt(ctx &: HashMap<str, str>, urls: HashMap<str, str>, url: str):
    alt_site := ctx_or(ctx, "alt.url", "")
    mut alt_url := ""
    if alt_site.Len() > 0 and urls.Has(url):
        alt_url = alt_site + url
    end
    ctx.Put("page.alt_url", alt_url)
    ctx.Put("page.switch_url", alt_url.Len() > 0 ? alt_url : alt_site + "/")
    is_default := ctx_or(ctx, "site.lang", "") == ctx_or(ctx, "site.default_lang", "")
    if alt_url.Len() == 0:
        ctx.Put("page.xdefault_url", "")
    else:
        ctx.Put("page.xdefault_url", is_default ? ctx_or(ctx, "site.url", "") + url : alt_url)
    end
end


func search_text(html: str, limit: int): str:
    mut t := strip_tags(html)
    t = str.Replace(t, "\r", " ")
    t = str.Replace(t, "\n", " ")
    t = str.Replace(t, "\t", " ")
    until str.IndexOf(t, "  ") < 0:
        t = str.Replace(t, "  ", " ")
    end
    t = str.Trim(t)
    if limit > 0 and t.Len() > limit:
        t = t.Substr(0, limit)
    end
    ret t
end

func search_push(docs &: Vector<str>, u: str, t: str, sec: str, k: str, x: str):
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, `{"u":`)
    str.BufAppend(b, json_str(u))
    str.BufAppend(b, `,"t":`)
    str.BufAppend(b, json_str(t))
    str.BufAppend(b, `,"s":`)
    str.BufAppend(b, json_str(sec))
    str.BufAppend(b, `,"k":`)
    str.BufAppend(b, json_str(k))
    str.BufAppend(b, `,"x":`)
    str.BufAppend(b, json_str(x))
    str.BufAppend(b, "}")
    docs.Push(str.BufStr(b))
end

func search_json(docs: Vector<str>): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    str.BufAppend(b, "[")
    repeat docs.Len() in i:
        if i > 0:
            str.BufAppend(b, ",")
        end
        str.BufAppend(b, docs.Get(i))
    end
    str.BufAppend(b, "]")
    ret str.BufStr(b)
end

func build_lang(lang: str, errs &: Vector<str>): int:
    lang_dir := ROOT + "/content/" + lang
    out_dir := ROOT + "/dist/" + lang
    mut ctx := HashMap {} as HashMap<str, str>
    each name in dir.ListFiles(lang_dir):
        if str.EndsWith(name, ".txt"):
            load_strings(lang_dir + "/" + name, ctx, errs)
        end
    end
    load_code_words(ctx, errs)
    load_examples(lang_dir, ctx, errs)
    alt := ctx_or(ctx, "site.alt", "")
    mut alt_ctx := HashMap {} as HashMap<str, str>
    mut alt_pages := HashMap {} as HashMap<str, str>
    if alt.Len() > 0 and alt != lang and dir.Exists(ROOT + "/content/" + alt):
        load_strings(ROOT + "/content/" + alt + "/site.txt", alt_ctx, errs)
        alt_pages = alt_urls(ROOT + "/content/" + alt)
    end
    ctx.Put("alt.url", ctx_or(alt_ctx, "site.url", ""))
    ctx.Put("alt.lang", ctx_or(alt_ctx, "site.lang", ""))
    ctx.Put("alt.lang_tag", ctx_or(alt_ctx, "site.lang_tag", ""))
    ctx.Put("alt.name", ctx_or(alt_ctx, "site.lang_name", ""))
    ctx.Put("alt.locale", ctx_or(alt_ctx, "site.locale", ""))
    lm := load_lastmod()
    ctx.Put("page.prev_url", "")
    ctx.Put("page.next_url", "")
    ctx.Put("page.modified", "")
    ctx.Put("page.og_type", "website")
    ctx.Put("page.canonical", "1")
    ctx.Put("site.base", ctx_or(ctx, "site.base", ""))
    ctx.Put("site.moved_from", ctx_or(ctx, "site.moved_from", ""))
    released := str.TrimPrefix(str.Trim(os.Env("SITE_RELEASE_VERSION")), "v")
    raw_version := released.Len() > 0 ? released : str.Trim(io.ReadFile("VERSION"))
    mut version := raw_version
    if ctx.Has("site.digits") and ctx.Get("site.digits") == "fa":
        version = str.ToPersianDigits(version)
    end
    ctx.Put("site.version", version)
    ctx.Put("site.version_raw", raw_version)
    mut agent_version := str.Trim(os.Env("SITE_AGENT_VERSION"))
    mut agent_tag := str.Trim(os.Env("SITE_AGENT_TAG"))
    if agent_version.Len() == 0:
        agent_version = "0.6.3"
    end
    if agent_tag.Len() == 0:
        agent_tag = "agent-v" + agent_version
    end
    mut android_version := str.TrimPrefix(str.Trim(os.Env("SITE_ANDROID_VERSION")), "v")
    if android_version.Len() == 0:
        android_version = raw_version
    end
    ctx.Put("android.version", android_version)
    ctx.Put("agent.release", ctx_or(ctx, "link.github", "") + "/releases/tag/" + agent_tag)
    ctx.Put("agent.download", ctx_or(ctx, "link.github", "") + "/releases/download/" + agent_tag + "/salam-agent-" + agent_version + "-")
    ctx.Put("asset.css", "/assets/css/site.css?v=" + short_hash(ROOT + "/assets/css/site.css"))
    ctx.Put("asset.js", "/assets/js/site.js?v=" + short_hash(ROOT + "/assets/js/site.js"))
    ctx.Put("asset.logo", "/assets/img/logo.svg?v=" + short_hash(ROOT + "/assets/img/logo.svg"))
    ctx.Put("faq.html", faq_html(ctx))
    lessons := load_lessons(lang_dir, errs)
    ctx.Put("learn.cards", course_index_html(ctx, lessons))
    ctx.Put("learn.itemlist", course_itemlist(ctx, lessons))
    ctx.Put("learn.count", digits(ctx, lessons.Len()))
    pkgs := load_std(lang_dir, errs)
    gwords := std_gwords(pkgs, alias_of_lang(ctx))
    ctx.Put("std.cards", std_index_html(pkgs))
    ctx.Put("std.count", digits(ctx, pkgs.Len()))
    ctx.Put("std.itemlist", std_itemlist(ctx, pkgs))
    posts := load_posts(lang_dir, ctx, errs)
    ctx.Put("blog.cards", blog_index_html(ctx, posts))
    ctx.Put("blog.home", blog_home_html(ctx, posts))
    ctx.Put("blog.nodes", posts.Len() > 0 ? blog_nodes(ctx, posts) : "")
    ctx.Put("blog.count", digits(ctx, posts.Len()))
    ctx.Put("active.blog", "")

    mut pages := Vector {} as Vector<Page>
    each name in dir.ListFiles(ROOT + "/templates/pages"):
        if str.EndsWith(name, ".html"):
            pages.Push(page_for(str.TrimSuffix(name, ".html")))
        end
    end
    each p in pages:
        ctx.Put("active." + p.slug, "")
    end
    ctx.Put("sitemap.html", sitemap_html(ctx, pages, lessons, pkgs, posts))

    if dir.Exists(out_dir):
        _rm := dir.RemoveAll(out_dir)
    end
    _mk := dir.MkdirAll(out_dir)
    if dir.Copy(ROOT + "/assets", out_dir + "/assets") != 0:
        report(errs, "cannot copy assets into " + out_dir)
    end
    static_dir := lang_dir + "/static"
    if dir.Exists(static_dir):
        each name in dir.ListDirs(static_dir):
            if dir.Copy(static_dir + "/" + name, out_dir + "/" + name) != 0:
                report(errs, "cannot copy " + static_dir + "/" + name + " into " + out_dir)
            end
        end
    end

    base := io.ReadFile(ROOT + "/templates/base.html")
    site_url := ctx.Has("site.url") ? ctx.Get("site.url") : ""
    url_base := ctx_or(ctx, "site.base", "")
    mut search_docs := Vector {} as Vector<str>
    mut sitemap := str.NewBuilder()
    defer str.BufFree(sitemap)
    str.BufAppend(sitemap, "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\" xmlns:xhtml=\"http://www.w3.org/1999/xhtml\">\n")
    each p in pages:
        tpath := ROOT + "/templates/pages/" + p.slug + ".html"
        ctx.Put("active." + p.slug, "true")
        ctx.Put("page.slug", p.slug)
        ctx.Put("page.url", p.url)
        set_alt(ctx, alt_pages, p.url)
        ctx.Put("page.title", ctx.Has(p.slug + ".title") ? ctx.Get(p.slug + ".title") : "")
        ctx.Put("page.description", ctx.Has(p.slug + ".description") ? ctx.Get(p.slug + ".description") : "")
        ctx.Put("page.keywords", ctx_or(ctx, p.slug + ".keywords", ctx_or(ctx, "site.keywords", "")))
        ctx.Put("page.robots", p.slug == "404" ? "noindex, follow" : ctx_or(ctx, "site.robots", "index, follow"))
        ctx.Put("page.canonical", p.slug == "404" ? "" : "1")
        set_cover(ctx, p.slug == "index" ? "" : p.slug)
        mut page_files := Vector {} as Vector<str>
        page_files.Push(ROOT + "/templates/pages/" + p.slug + ".html")
        page_files.Push(lang_dir + "/" + p.slug + ".txt")
        if p.slug == "learn":
            each l in lessons:
                page_files.Push(l.path)
            end
        end
        if p.slug == "std":
            each q in pkgs:
                page_files.Push(q.path)
            end
        end
        if p.slug == "blog":
            each q in posts:
                page_files.Push(q.path)
            end
        end
        lastmod := lastmod_of(lm, page_files)
        ctx.Put("page.modified", "")
        ctx.Put("page.jsonld", p.slug == "404" ? "" : page_jsonld(ctx, p, raw_version))
        ctx.Put("page.body", render(tpath, io.ReadFile(tpath), ctx, errs))
        html := render(ROOT + "/templates/base.html", base, ctx, errs)
        ctx.Put("active." + p.slug, "")
        if p.slug != "404":
            mut page_title := title_head(ctx.Get("page.title"))
            if page_title.Len() == 0:
                page_title = ctx_or(ctx, "nav." + p.slug, ctx_or(ctx, "site.name", p.slug))
            end
            page_sec := ctx_or(ctx, "nav." + p.slug, ctx_or(ctx, "sitemap.pages", ""))
            page_body := search_text(ctx.Get("page.description") + " " + ctx.Get("page.body"), 3000)
            search_push(search_docs, p.url, page_title, page_sec, "page", page_body)
        end
        target := out_dir + "/" + p.out
        if p.slug != "index" and p.slug != "404":
            _md := dir.MkdirAll(out_dir + "/" + p.slug)
            str.BufAppend(sitemap, sitemap_entry(ctx, site_url + p.url, lastmod))
        else p.slug == "index":
            str.BufAppend(sitemap, sitemap_entry(ctx, site_url + "/", lastmod))
        end
        write(target, rebase(html, url_base), errs)
    end
    mut full := str.NewBuilder()
    defer str.BufFree(full)
    str.BufAppend(full, "# " + ctx_or(ctx, "site.name", "Salam") + "\n\n> " + ctx_or(ctx, "site.description", "") + "\n\n" + strip_tags(ctx_or(ctx, "llms.intro", "")) + "\n")
    lesson_tmpl := io.ReadFile(ROOT + "/templates/lesson.html")
    repeat lessons.Len() in li:
        l := lessons.Get(li)
        mut lc := copy_map(ctx)
        load_strings(l.path, lc, errs)
        lc.Put("active.learn", "true")
        lc.Put("lesson.number", digits(lc, li + 1))
        lc.Put("lesson.count", digits(lc, lessons.Len()))
        lc.Put("lesson.sidebar", course_sidebar(lc, lessons, li))
        body := render(l.path, lc.Get("lesson.body"), lc, errs)
        lc.Put("lesson.body_html", body)
        llms_section(full, l.title, site_url + l.url, ctx_or(lc, "lesson.lead", ""), body)
        learn_title := ctx_or(lc, "lesson.title", l.title)
        learn_sec := ctx_or(ctx, "nav.learn", "Learn")
        learn_body := search_text(l.part + " " + ctx_or(lc, "lesson.summary", "") + " " + ctx_or(lc, "lesson.lead", "") + " " + body, 5000)
        search_push(search_docs, l.url, learn_title, learn_sec, "learn", learn_body)
        lc.Put("lesson.toc", body_toc(body))
        lc.Put("lesson.prev", li > 0 ? lesson_link(lc, lessons.Get(li - 1), "learn.prev_label", "prev") : "")
        lc.Put("lesson.next", li + 1 < lessons.Len() ? lesson_link(lc, lessons.Get(li + 1), "learn.next_label", "next") : "")
        lc.Put("page.slug", "learn-" + l.slug)
        lc.Put("page.url", l.url)
        set_alt(lc, alt_pages, l.url)
        lc.Put("page.title", lc.Get("lesson.seo_title"))
        lc.Put("page.description", lc.Get("lesson.description"))
        lc.Put("page.keywords", ctx_or(lc, "lesson.keywords", ctx_or(lc, "site.keywords", "")))
        lc.Put("page.robots", ctx_or(lc, "site.robots", "index, follow"))
        lc.Put("page.canonical", "1")
        lc.Put("page.og_type", "article")
        set_cover(lc, "learn")
        lesson_mod := lastmod_of(lm, one_path(l.path))
        lc.Put("page.modified", lesson_mod)
        lc.Put("page.lastmod", lesson_mod)
        lc.Put("page.prev_url", li > 0 ? site_url + lessons.Get(li - 1).url : "")
        lc.Put("page.next_url", li + 1 < lessons.Len() ? site_url + lessons.Get(li + 1).url : "")
        lc.Put("page.jsonld", lesson_jsonld(lc, l, raw_version))
        lc.Put("page.body", render(ROOT + "/templates/lesson.html", lesson_tmpl, lc, errs))
        lhtml := render(ROOT + "/templates/base.html", base, lc, errs)
        _ld := dir.MkdirAll(out_dir + "/learn/" + l.slug)
        write(out_dir + "/learn/" + l.slug + "/index.html", rebase(lhtml, url_base), errs)
        str.BufAppend(sitemap, sitemap_entry(lc, site_url + l.url, lesson_mod))
        legacy := lesson_legacy_slug(path_name(l.path))
        if legacy != l.slug:
            _old := dir.MkdirAll(out_dir + "/learn/" + legacy)
            write(out_dir + "/learn/" + legacy + "/index.html", redirect_html(l.url, learn_title), errs)
        end
    end
    std_tmpl := io.ReadFile(ROOT + "/templates/std.html")
    repeat pkgs.Len() in pi:
        p := pkgs.Get(pi)
        mut pc := copy_map(ctx)
        load_strings(p.path, pc, errs)
        api := load_api(p, errs)
        examples := load_std_examples(lang_dir, p, pc, errs)
        intro := render(p.path, pc.Get("pkg.intro"), pc, errs)
        body := intro + "\n" + std_api_html(pc, p, api, gwords, examples, errs)
        pc.Put("active.std", "true")
        pc.Put("pkg.body_html", body)
        pc.Put("pkg.disp", p.disp)
        llms_section(full, pkg_label(p), site_url + p.url, p.summary, body)
        std_title := pkg_label(p)
        std_sec := ctx_or(ctx, "nav.std", "Standard library")
        std_body := search_text(p.en + " " + p.disp + " " + p.summary + " " + p.group + " " + body, 6000)
        search_push(search_docs, p.url, std_title, std_sec, "std", std_body)
        pc.Put("pkg.toc", body_toc(body))
        pc.Put("pkg.sidebar", std_sidebar(pc, pkgs, pi))
        pc.Put("pkg.import", highlight(ctx_or(pc, "stdref.kw_import", "import") + " " + ctx_or(pc, "pkg.import", p.name), code_classes(pc)))
        pc.Put("page.slug", "std-" + p.slug)
        pc.Put("page.url", p.url)
        set_alt(pc, alt_pages, p.url)
        pc.Put("page.title", pc.Get("pkg.title"))
        pc.Put("page.description", pc.Get("pkg.description"))
        pc.Put("page.keywords", ctx_or(pc, "pkg.keywords", ctx_or(pc, "std.keywords", ctx_or(pc, "site.keywords", ""))))
        pc.Put("page.robots", ctx_or(pc, "site.robots", "index, follow"))
        pc.Put("page.canonical", "1")
        pc.Put("page.og_type", "article")
        set_cover(pc, "std")
        pkg_mod := lastmod_of(lm, one_path(p.path))
        pc.Put("page.modified", pkg_mod)
        pc.Put("page.lastmod", pkg_mod)
        pc.Put("page.prev_url", pi > 0 ? site_url + pkgs.Get(pi - 1).url : "")
        pc.Put("page.next_url", pi + 1 < pkgs.Len() ? site_url + pkgs.Get(pi + 1).url : "")
        pc.Put("page.jsonld", std_jsonld(pc, p, raw_version))
        pc.Put("page.body", render(ROOT + "/templates/std.html", std_tmpl, pc, errs))
        phtml := render(ROOT + "/templates/base.html", base, pc, errs)
        _pd := dir.MkdirAll(out_dir + "/std/" + p.en)
        write(out_dir + "/std/" + p.en + "/index.html", rebase(phtml, url_base), errs)
        str.BufAppend(sitemap, sitemap_entry(pc, site_url + p.url, pkg_mod))
    end
    post_tmpl := io.ReadFile(ROOT + "/templates/post.html")
    classes := code_classes(ctx)
    repeat posts.Len() in bi:
        q := posts.Get(bi)
        mut bc := copy_map(ctx)
        mut meta := HashMap {} as HashMap<str, str>
        md := post_parse(q.path, meta, errs)
        mut code_n := 0
        mut ids := HashMap {} as HashMap<str, str>
        body := md_render(md, classes, bc, q.slug, code_n, ids, errs)
        words := str.Fields(strip_tags(body)).Len()
        bc.Put("active.blog", "true")
        bc.Put("post.title", q.title)
        bc.Put("post.summary", q.summary)
        bc.Put("post.category", cat_label(bc, q.category))
        bc.Put("post.category_url", "/blog/#" + q.category)
        bc.Put("post.date", q.date)
        bc.Put("post.date_text", post_date_text(bc, q.date))
        bc.Put("post.updated", q.updated.Len() > 0 and q.updated != q.date ? q.updated : "")
        bc.Put("post.updated_text", post_date_text(bc, q.updated))
        bc.Put("post.minutes", digits(bc, post_minutes(body)))
        bc.Put("post.image", q.image)
        post_image_alt := q.image_alt.Len() > 0 ? q.image_alt : decode_entities(q.title)
        bc.Put("post.image_alt", escape_text(post_image_alt))
        bc.Put("post.body_html", body)
        bc.Put("post.toc", body_toc(body))
        bc.Put("post.related", post_related(bc, posts, bi))
        bc.Put("post.prev", bi > 0 ? `<a class="lesson-step prev" href="` + posts.Get(bi - 1).url + `"><small>` + ctx_or(bc, "blog.prev_label", "") + "</small><strong>" + posts.Get(bi - 1).title + "</strong></a>" : "")
        bc.Put("post.next", bi + 1 < posts.Len() ? `<a class="lesson-step next" href="` + posts.Get(bi + 1).url + `"><small>` + ctx_or(bc, "blog.next_label", "") + "</small><strong>" + posts.Get(bi + 1).title + "</strong></a>" : "")
        bc.Put("page.slug", "blog-" + q.slug)
        bc.Put("page.url", q.url)
        set_alt(bc, alt_pages, q.url)
        seo_title := ctx_or(meta, "post.seo_title", "")
        desc := ctx_or(meta, "post.description", "")
        bc.Put("page.title", escape_text(seo_title))
        bc.Put("page.title_raw", seo_title)
        bc.Put("page.description", escape_text(desc))
        bc.Put("page.description_raw", desc)
        bc.Put("page.keywords", escape_text(ctx_or(meta, "post.keywords", "")))
        bc.Put("page.robots", ctx_or(bc, "site.robots", "index, follow"))
        bc.Put("page.canonical", "1")
        bc.Put("page.og_type", "article")
        set_cover(bc, "blog")
        bc.Put("page.og_image_alt", q.title)
        if q.image.Len() > 0:
            bc.Put("page.og_image", q.image)
            bc.Put("page.og_image_alt", post_image_alt)
        end
        post_mod := newest(post_modified(q), lastmod_of(lm, one_path(q.path)))
        bc.Put("page.modified", post_mod)
        bc.Put("page.lastmod", post_mod)
        bc.Put("page.prev_url", "")
        bc.Put("page.next_url", "")
        bc.Put("page.jsonld", post_jsonld(bc, q, words, raw_version))
        bc.Put("page.body", render(ROOT + "/templates/post.html", post_tmpl, bc, errs))
        blog_title := strip_tags(decode_entities(q.title))
        blog_sec := ctx_or(ctx, "nav.blog", "Blog")
        blog_body := search_text(q.summary + " " + desc + " " + cat_label(bc, q.category) + " " + body, 5000)
        search_push(search_docs, q.url, blog_title, blog_sec, "blog", blog_body)
        bhtml := render(ROOT + "/templates/base.html", base, bc, errs)
        _bd := dir.MkdirAll(out_dir + "/blog/" + q.slug)
        write(out_dir + "/blog/" + q.slug + "/index.html", rebase(bhtml, url_base), errs)
        str.BufAppend(sitemap, sitemap_entry(bc, site_url + q.url, post_mod))
    end
    if posts.Len() > 0:
        _ba := dir.MkdirAll(out_dir + "/blog")
        write(out_dir + "/blog/atom.xml", blog_atom(ctx, posts), errs)
    end
    str.BufAppend(sitemap, "</urlset>\n")
    write(out_dir + "/sitemap.xml", str.BufStr(sitemap), errs)
    write(out_dir + "/site.webmanifest", manifest_json(ctx), errs)
    write(out_dir + "/llms.txt", llms_index(ctx, pages, lessons, pkgs, posts), errs)
    write(out_dir + "/llms-full.txt", str.BufStr(full), errs)
    if fs.Copy(ROOT + "/assets/img/favicon.ico", out_dir + "/favicon.ico") != 0:
        report(errs, "cannot copy favicon.ico into " + out_dir)
    end
    write(out_dir + "/robots.txt", "User-agent: *\nAllow: /\n\nSitemap: " + site_url + "/sitemap.xml\n", errs)
    write(out_dir + "/search-index.json", search_json(search_docs), errs)
    ret pages.Len() + lessons.Len() + pkgs.Len() + posts.Len()
end

func main:
    args := os.Args()
    mut langs := Vector {} as Vector<str>
    mut ai := 1
    until ai < args.Len():
        langs.Push(args.Get(ai))
        ai++
    end
    if langs.Len() == 0:
        each d in dir.ListDirs(ROOT + "/content"):
            langs.Push(d)
        end
    end
    mut errs := Vector {} as Vector<str>
    each lang in langs:
        if not dir.Exists(ROOT + "/content/" + lang):
            report(errs, "no content for language '" + lang + "'")
            continue
        end
        count := build_lang(lang, errs)
        println "built", count, "pages for", lang, "->", ROOT + "/dist/" + lang
    end
    if errs.Len() > 0:
        each e in errs:
            printerrln "website: " + e
        end
        ret 1
    end
    ret 0
end
