const ROOT := "website"
const KEYWORD_TABLE := "extensions/tree-sitter-salam/keywords.json"
const PREVIEW_SCRIPT := `<script>(function(){function s(){parent.postMessage({salamPreview:1,n:window.name,h:document.documentElement.scrollHeight},"*")}addEventListener("load",s);addEventListener("resize",s);if(window.ResizeObserver){new ResizeObserver(s).observe(document.documentElement)}document.addEventListener("click",function(e){var a=e.target&&e.target.closest&&e.target.closest("a[href]");if(a&&a.getAttribute("href").charAt(0)!=="#"){e.preventDefault()}});document.addEventListener("submit",function(e){e.preventDefault()},true)})();</script>`

