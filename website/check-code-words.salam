import os
import io
import str
import filepath
import encoding.json

func quoted(source: str, name: str): Vector<str>:
    mut out := Vector {} as Vector<str>
    at := source.find(name + " := [")
    if at < 0:
        ret out
    end
    rest := str.Substr(source, at, source.Len() - at)
    stop := rest.find("]")
    body := str.Substr(rest, 0, stop)
    n := body.Len()
    mut i := 0
    until i < n:
        if body[i] != '"':
            i++
            continue
        end
        mut j := i + 1
        until j < n and body[j] != '"':
            j++
        end
        out.push(str.Substr(body, i + 1, j - i - 1))
        i = j + 1
    end
    ret out
end

func known_words(table: str): HashMap<str, bool>:
    mut seen := HashMap {} as HashMap<str, bool>
    each key in json.Keys(table):
        each item in json.Items(json.Get(table, key)):
            seen.put(json.Unquote(item), true)
        end
    end
    ret seen
end

func main:
    mut root := os.Cwd()
    if not os.IsDir(root + "/std") and os.IsDir(root + "/../std"):
        root = filepath.Clean(root + "/..")
    end
    source := io.ReadFile(root + "/compiler/langpack.salam")
    table := io.ReadFile(root + "/extensions/tree-sitter-salam/keywords.json")
    seen := known_words(table)
    mut missing := Vector {} as Vector<str>
    mut total := 0
    each name in ["k_kw_spell_en", "k_kw_spell_fa"]:
        words := quoted(source, name)
        if words.Len() == 0:
            printerrln "website: " + name + " not found in compiler/langpack.salam"
            ret 1
        end
        each w in words:
            total++
            if not seen.has(w):
                missing.push(w)
            end
        end
    end
    if missing.Len() > 0:
        printerrln "website: keywords the lexer knows but the code highlighter lacks:", str.Join(missing, " ")
        printerrln "website: run 'salam exec extensions/tools/gen_syntaxes.salam' and commit extensions/tree-sitter-salam/keywords.json"
        ret 1
    end
    println "code words: all " + str.FromInt(total as i64) + " lexer keywords are highlighted"
end
