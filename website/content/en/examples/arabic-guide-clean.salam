import arabic

func main:
    pasted := "ﻛﺘﺎﺏ مـــی‌خواهم، كيفيت ۱۰۰٪"
    display := arabic.NormalizePersian(pasted)
    println "display:", display
    username_flags := arabic.FoldLetters + arabic.StripTatweel + arabic.FoldDigits + arabic.FoldPresentation
    println "username:", arabic.Normalize("علي_۱۳۷۰ـ", username_flags)
    println "kept marks:", arabic.Normalize("آموزشِ زبان", arabic.FoldLetters)
    println "no marks:  ", arabic.Normalize("آموزشِ زبان", arabic.StripHarakat)
    println "loose equal:", arabic.EqualLoose(display, "کتاب میخواهم، کیفیت 100٪")
end
