import arabic

func main:
    typed := ["علی رضایی", "علي رضايي", "عـلی رضایی", "مریم احمدی", "مريم أحمدي", "سارا کریمی"]
    mut seen := HashMap {} as HashMap<str, str>
    defer seen.free()
    each name in typed:
        key := arabic.SearchKey(name)
        if seen.has(key):
            println "duplicate:", name, "is", seen.get(key)
        else:
            seen.put(key, name)
        end
    end
    println seen.size(), "different people"
end
