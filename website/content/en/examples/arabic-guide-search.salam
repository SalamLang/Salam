import arabic
import str

func main:
    titles := ["کتاب آموزش برنامه‌نویسی", "تاریخ ایران", "دستور زبان فارسی", "مدرسهٔ عشق"]
    mut keys := Vector {} as Vector<str>
    defer keys.free()
    each t in titles:
        keys.push(arabic.SearchKey(t))
    end
    each query in ["كتاب", "برنامه نویسی", "ايران", "مدرسة", "فارسي"]:
        q := arabic.SearchKey(query)
        mut hits := 0
        each i, k in keys:
            if str.Contains(k, q):
                println "[" + query + "]", "found", titles[i]
                hits += 1
            end
        end
        if hits == 0:
            println "[" + query + "]", "no match"
        end
    end
end
