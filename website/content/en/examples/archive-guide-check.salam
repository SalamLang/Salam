import archive
import compress

func main:
    a := compress.BufFromStr("first file, stored as it is\n")
    b := compress.BufFromStr("second file, a little longer than the first one\n")
    mut files := Vector {} as Vector<archive.ZipFileInput>
    files.push(archive.MakeZipFileInput("a.txt", a.data, a.len, 0))
    files.push(archive.MakeZipFileInput("b.txt", b.data, b.len, 0))
    z := archive.ZipCreate(files)

    p := z.data as u8*
    p[40] = ((p[40] as int) ^ 1) as u8

    mut entries := archive.ZipList(z.data, z.len)
    mut ok := false
    each e in entries:
        data := archive.ZipExtractByName(z.data, z.len, e.name, ok)
        good := compress.CRC32Buf(data) == e.crc32
        println e.name, "extracted:", ok, "checksum matches:", good
    end
    archive.FreeEntries(entries)

    mut rar_files := Vector {} as Vector<archive.RarFileInput>
    rar_files.push(archive.MakeRarFileInput("a.txt", a.data, a.len, false))
    r := archive.RarCreate(rar_files)
    q := r.data as u8*
    q[r.len - 12] = ((q[r.len - 12] as int) ^ 1) as u8
    mut status := 0
    _ := archive.RarExtract(r.data, r.len, "a.txt", 0, status)
    println "rar:", archive.RarStatusText(status)
end
