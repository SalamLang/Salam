package main

import archive
import filepath
import os

func main:
    mut files := Vector {} as Vector<archive.FileInput>
    files.push(archive.MakeFileInput("notes/", null, 0, true))
    files.push(archive.MakeFileInput("notes/a.txt", "alpha alpha alpha" as void*, 17, false))
    files.push(archive.MakeFileInput("b.txt", "bravo" as void*, 5, false))

    dir := filepath.Join(os.TempDir(), "salam-guide-open")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    path := filepath.Join(dir, "demo.tar.gz")
    println "create:", archive.ArchiveStatusText(archive.Create(path, files))
    files.free()

    mut status := 0
    mut entries := archive.ListFile(path, "", status)
    println "list:", archive.ArchiveStatusText(status)
    each e in entries:
        println " ", e.name, e.size
    end
    archive.FreeEntries(entries)

    out := filepath.Join(dir, "out")
    n := archive.ExtractFile(path, out, "", status)
    println "extract:", n, archive.ArchiveStatusText(status)

    mut arc := archive.OpenFile(path, "")
    println archive.FormatName(arc.format), arc.status
    mut limits := archive.DefaultLimits()
    limits.max_entries = 2
    archive.SetLimits(arc, limits)
    println "tight:", archive.ExtractAll(arc, filepath.Join(dir, "tight")), archive.ArchiveStatusText(arc.status)
    archive.Close(arc)

    missing := archive.ExtractFile(filepath.Join(dir, "none.zip"), out, "", status)
    println "missing:", missing, archive.ArchiveStatusText(status)

    mut code := 0
    until code <= 14:
        println code, archive.ArchiveStatusText(code)
        code++
    end
    os.RemoveAll(dir)
end
