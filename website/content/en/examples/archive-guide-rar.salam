import archive
import compress

const SAMPLE := """
526172211a07010009efc86f0b0105070406010180808000f59006092302030bc300049c04a48302dcdfaa7280050105
612e7478740a031341fff06a00f2f92ec4de405543522f75043ded152822995a044050507ca7cbf17ff3c348ad0d2727
655f99a332a4c1ac1c51cad46312e761917434a437902ab22276d9e9f3b0b2cd03eb58c5ad77d22302030b9c0004b104
a4830220abc84ec0050105622e7478740a031341fff06ae4e7fa2e440719f5c9e63f0caebd274804c54d756dc27b960e
6971f66c94d170988ae3092702030b8000048000a4830200000000c0050109656d7074792e7478740a031341fff06ae4
e7fa2e1d77565103050400
"""

func digit(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func from_hex(text: str): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    bytes := text as u8*
    mut high := -1
    repeat text.Len() in i:
        v := digit(bytes[i] as int)
        if v < 0:
            continue
        end
        if high < 0:
            high = v
        else:
            compress.BufPush(out, high * 16 + v)
            high = -1
        end
    end
    ret out
end

func main:
    rar := from_hex(SAMPLE)
    println archive.IsRar(rar.data, rar.len)
    mut entries := archive.RarList(rar.data, rar.len)
    each e in entries:
        println e.name, e.size, e.compressed_size
    end
    archive.FreeEntries(entries)

    mut status := 0
    b := archive.RarExtract(rar.data, rar.len, "b.txt", 0, status)
    println archive.RarStatusText(status), b.len
end
