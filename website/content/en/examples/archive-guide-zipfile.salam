import archive
import compress
import os

func main:
    body := "a large file would be unpacked straight to disk\n"
    mut files := Vector {} as Vector<archive.ZipFileInput>
    files.Push(archive.MakeZipFileInput("data/log.txt", body as void*, body.Len(), 8))
    mut made := archive.ZipCreate(files)
    files.Free()
    archive.WriteBinaryFileBuf("made.zip", made)
    compress.BufFree(made)

    mut zf := archive.ZipOpenFile("made.zip")
    mut entries := archive.ZipFileEntries(zf)
    each e in entries:
        println e.name, e.size
    end
    archive.FreeEntries(entries)

    println archive.ZipFileExtractTo(zf, "data/log.txt", "log.out", 0 as i64) == archive.ZIP_OK
    println archive.ZipFileExtractTo(zf, "data/log.txt", "log.out", 10 as i64) == archive.ZIP_TOO_BIG
    archive.ZipFileClose(zf)
    os.Remove("made.zip")
    os.Remove("log.out")
end
