import archive
import compress

func main:
    text := "salam, salam, salam"
    b := compress.BufFromStr(text)
    mut named := archive.MakeZipFileInput("سلام.txt", b.data, b.len, 8)
    named.mtime = 1700000000 as i64
    mut files := Vector {} as Vector<archive.ZipFileInput>
    files.push(named)
    files.push(archive.MakeZipFileInput("plain.txt", b.data, b.len, 8))
    z := archive.ZipCreate(files)
    mut entries := archive.ZipList(z.data, z.len)
    each e in entries:
        println e.name, e.mtime
    end
    archive.FreeEntries(entries)
    println "utf8 flag:", (archive.LEGet16(z.data, 6) & 0x800) != 0

    wide := archive.ZipCreate64(files)
    mut again := archive.ZipList(wide.data, wide.len)
    println again.Len(), wide.len > z.len, again.get(0).size
    archive.FreeEntries(again)
    mut checked := 0
    println archive.ZipVerify(wide.data, wide.len, checked), checked
end
