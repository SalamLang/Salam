import archive
import compress

func main:
    text := "hello archive, hello archive, hello archive"
    b := compress.BufFromStr(text)
    mut files := Vector {} as Vector<archive.ZipFileInput>
    files.Push(archive.MakeZipFileInput("a.txt", b.data, b.len, 0))
    files.Push(archive.MakeZipFileInput("b.txt", b.data, 5, 8))
    z := archive.ZipCreate(files)
    mut status := 0
    mut checked := 0
    good := archive.ZipExtractVerified(z.data, z.len, "a.txt", 0, status)
    println status == archive.ZIP_OK, good.len, archive.ZipVerify(z.data, z.len, checked), checked

    bp := z.data as u8*
    bp[35] = 0x58 as u8
    bad := archive.ZipExtractVerified(z.data, z.len, "a.txt", 0, status)
    println status == archive.ZIP_BAD_CRC, bad.len, archive.ZipStatusText(status)
    mut ok := false
    plain := archive.ZipExtractByName(z.data, z.len, "a.txt", ok)
    println ok, plain.len
    println archive.ZipVerify(z.data, z.len, checked), checked
    mut broken := archive.ZipBadEntries(z.data, z.len)
    each e in broken:
        println "damaged:", e.name
    end
    archive.FreeEntries(broken)
    _ := archive.ZipExtractVerified(z.data, z.len, "missing.txt", 0, status)
    println status == archive.ZIP_NOT_FOUND, archive.ZipStatusText(status)
end
