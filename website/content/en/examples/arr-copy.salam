func with bonus(scores: int[3]): int[3]:
    mut out := scores
    repeat len(out) in i:
        out[i] += 5
    end
    ret out
end

func main:
    original := [70, 85, 90]
    mut draft := original
    draft[0] = 0
    println original, draft
    curved := with bonus(original)
    println original, curved
end
