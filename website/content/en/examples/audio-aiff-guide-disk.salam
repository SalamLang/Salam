import audio
import audio.aiff
import filepath
import mem
import os

func main:
    mut c := audio.New(22050, 1, 100)
    audio.SetSample(c, 10, 0, -0.5)
    path := filepath.Join(os.TempDir(), "salam_guide.aiff")
    defer mem.Free(path as void*)
    println aiff.SaveAIFFBits(c, path, 16)

    mut ok := false
    mut back := aiff.OpenAIFF(path, ok)
    println ok, back.rate, back.frames, back.bits
    println audio.Sample(back, 10, 0)

    missing := filepath.Join(os.TempDir(), "salam_guide_missing.aiff")
    defer mem.Free(missing as void*)
    mut gone := false
    aiff.OpenAIFF(missing, gone)
    println gone
    audio.Free(c)
    audio.Free(back)
end
