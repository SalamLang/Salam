import audio
import audio.aiff
import compress

func main:
    mut c := audio.New(44100, 2, 64)
    audio.SetSample(c, 7, 1, 0.5)
    mut buf := aiff.EncodeAIFFBits(c, 24)
    println aiff.IsAIFF(buf.data, buf.len), compress.BufLen(buf)

    mut cm := aiff.Common {}
    println aiff.ReadCommon(buf.data, buf.len, cm)
    println cm.channels, cm.frames, cm.bits, cm.rate
    println cm.compression == aiff.CompNone, cm.data_size

    mut ok := false
    mut back := aiff.DecodeAIFF(buf.data, buf.len, ok)
    println ok, back.frames, back.bits, audio.Sample(back, 7, 1)
    compress.BufFree(buf)
    audio.Free(c)
    audio.Free(back)
end
