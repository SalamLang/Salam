import audio
import audio.au
import compress
import filepath
import mem
import os

func main:
    mut c := audio.New(22050, 1, 64)
    audio.SetSample(c, 3, 0, 0.5)
    path := filepath.Join(os.TempDir(), "salam_guide.au")
    defer mem.Free(path as void*)
    println au.SaveAU(c, path)

    mut buf := au.EncodeAU(c)
    mut ok := false
    info := au.ProbeAU(buf.data, buf.len, ok)
    println ok, info.rate, info.bits, info.frames

    mut open_ok := false
    mut back := au.OpenAU(path, open_ok)
    println open_ok, back.frames, back.rate, audio.Sample(back, 3, 0)
    compress.BufFree(buf)
    audio.Free(c)
    audio.Free(back)
end
