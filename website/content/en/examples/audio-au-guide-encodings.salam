import audio
import audio.au
import compress
import math

func main:
    mut c := audio.New(8000, 1, 64)
    audio.SetSample(c, 3, 0, 0.5)

    mut pcm := au.EncodeAUEncoding(c, au.EncPcm16)
    mut mu := au.EncodeAUEncoding(c, au.EncMuLaw)
    mut fl := au.EncodeAUEncoding(c, au.EncFloat32)
    println compress.BufLen(pcm), compress.BufLen(mu), compress.BufLen(fl)

    mut h := au.Header {}
    println au.ReadHeader(mu.data, mu.len, h)
    println h.encoding == au.EncMuLaw, h.rate, h.channels, h.data_size

    mut ok := false
    mut back := au.DecodeAU(mu.data, mu.len, ok)
    println ok, back.bits, math.Abs(audio.Sample(back, 3, 0) - 0.5) < 0.02
    compress.BufFree(pcm)
    compress.BufFree(mu)
    compress.BufFree(fl)
    audio.Free(c)
    audio.Free(back)
end
