import audio
import audio.codec
import compress

func main:
    mut c := audio.New(8000, 1, 32)
    audio.SetSample(c, 3, 0, 0.5)
    mut buf := codec.Encode(c, audio.FormatWAV)
    println compress.BufLen(buf)
    println audio.FormatName(audio.DetectFormat(buf.data, buf.len))

    mut ok := false
    mut back := codec.Decode(buf.data, buf.len, ok)
    println ok, back.frames, audio.Sample(back, 3, 0)

    mut junk := compress.NewByteBuf()
    mut i := 0
    until i < 16:
        compress.BufPush(junk, i)
        i++
    end
    mut bad := false
    codec.Decode(junk.data, junk.len, bad)
    println bad
    compress.BufFree(buf)
    compress.BufFree(junk)
    audio.Free(c)
    audio.Free(back)
end
