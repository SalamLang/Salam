import audio
import audio.codec
import filepath
import mem
import os

func main:
    mut c := audio.New(22050, 2, 64)
    audio.SetSample(c, 5, 0, 0.5)
    audio.SetSample(c, 5, 1, -0.25)

    path := filepath.Join(os.TempDir(), "salam_guide_codec.wav")
    defer mem.Free(path as void*)
    println codec.CanEncode(audio.FormatWAV), codec.Save(c, path)

    mut ok := false
    info := codec.ProbeFile(path, ok)
    println ok, audio.FormatName(info.format), info.frames, info.bits, info.lossless

    mut open_ok := false
    mut back := codec.Open(path, open_ok)
    println open_ok, back.rate, back.channels
    println audio.Sample(back, 5, 0), audio.Sample(back, 5, 1)
    audio.Free(c)
    audio.Free(back)
end
