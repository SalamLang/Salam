import audio
import audio.dsp
import math

func tone(rate: int, freq: f64, frames: int): audio.Clip:
    mut c := audio.New(rate, 1, frames)
    mut i := 0
    until i < frames:
        audio.SetSample(c, i, 0, math.Sin(2.0 * math.PI * freq * (i as f64) / (rate as f64)))
        i += 1
    end
    ret c
end

func main:
    lp := dsp.LowPass(1000.0, 0.707, 48000)
    println dsp.BiquadResponse(lp, 100.0, 48000) > 0.99
    println dsp.BiquadResponse(lp, 10000.0, 48000) < 0.02

    mut low := tone(48000, 100.0, 2048)
    mut high := tone(48000, 10000.0, 2048)
    low_before := audio.RMS(low)
    high_before := audio.RMS(high)
    dsp.BiquadProcessAll(lp, low)
    dsp.BiquadProcessAll(lp, high)
    low_db := audio.GainToDb(audio.RMS(low) / low_before)
    high_db := audio.GainToDb(audio.RMS(high) / high_before)
    println low_db > -1.0
    println high_db < -20.0
    audio.Free(low)
    audio.Free(high)
end
