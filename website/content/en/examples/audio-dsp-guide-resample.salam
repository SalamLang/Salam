import audio
import audio.dsp
import math

func main:
    mut c := audio.New(8000, 1, 800)
    mut i := 0
    until i < 800:
        audio.SetSample(c, i, 0, 0.5 * math.Sin(2.0 * math.PI * 300.0 * (i as f64) / 8000.0))
        i += 1
    end
    mut up := dsp.ResampleTo(c, 16000, dsp.QualitySinc)
    println up.rate, up.frames, audio.Duration(up)
    mut back := dsp.ResampleTo(up, 8000, dsp.QualitySinc)
    println back.rate, back.frames
    println dsp.Correlation(c, back) > 0.99
    audio.Free(c)
    audio.Free(up)
    audio.Free(back)
end
