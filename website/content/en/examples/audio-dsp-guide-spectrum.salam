import audio.dsp
import math

func main:
    n := 256
    rate := 8000
    mut re := Vector {} as Vector<f64>
    mut im := Vector {} as Vector<f64>
    defer re.Free()
    defer im.Free()
    mut i := 0
    until i < n:
        re.Push(math.Sin(2.0 * math.PI * 1000.0 * (i as f64) / (rate as f64)))
        im.Push(0.0)
        i++
    end
    dsp.ApplyWindow(re.Ref(0), n, dsp.WindowHann, 0.0)
    println dsp.FFTVec(re, im)
    mags := dsp.Magnitude(re.Ref(0), im.Ref(0), n)
    defer mags.Free()
    peak := dsp.PeakBin(mags)
    println peak, dsp.BinFrequency(peak, n, rate)
    println dsp.IsPow2(n), dsp.NextPow2(300)
end
