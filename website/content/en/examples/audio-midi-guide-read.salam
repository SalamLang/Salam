import audio
import audio.midi
import audio.music
import filepath
import mem
import os

func main:
    mut song := midi.NewSong(480)
    mut track := midi.NewTrack()
    midi.AddTempo(track, 0, 120.0)
    midi.AddNote(track, 0, 480, 60, 100, 0)
    midi.AddNote(track, 480, 480, 64, 100, 0)
    midi.AddNote(track, 960, 960, 67, 100, 0)
    midi.AddTrack(song, track)
    path := filepath.Join(os.TempDir(), "salam_midi_read_guide.mid")
    defer mem.Free(path as void*)
    midi.SaveMIDI(song, path)
    midi.FreeSong(song)

    mut ok := false
    mut back := midi.OpenMIDI(path, ok)
    println ok, back.tracks.Len(), midi.Bpm(back)
    println "seconds:", midi.TicksToSeconds(back, midi.TotalTicks(back))

    mut notes := midi.Notes(back)
    each n in notes:
        name := music.NoteName(n.note)
        println name, n.start, n.length
        mem.Free(name as void*)
    end
    notes.Free()

    clip := midi.Render(back, 22050, 1)
    println "rendered:", clip.frames > 0, audio.Peak(clip) > 0.05
    mut c := clip
    audio.Free(c)
    midi.FreeSong(back)
end
