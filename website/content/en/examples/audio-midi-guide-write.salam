import audio.midi
import audio.music
import compress
import filepath
import mem
import os

func main:
    mut song := midi.NewSong(480)
    mut track := midi.NewTrack()
    midi.AddTempo(track, 0, 100.0)
    midi.AddProgram(track, 0, 0, 0)
    mut scale := music.ScaleNotes(60, music.ScaleMajor, 5)
    defer scale.free()
    mut i := 0
    until i < scale.len():
        midi.AddNote(track, i * 480, 480, scale.get(i), 90, 0)
        i++
    end
    println "events:", track.events.len()
    midi.AddTrack(song, track)
    println "ticks:", midi.TotalTicks(song)

    mut enc := midi.EncodeMIDI(song)
    println "valid midi:", midi.IsMIDI(enc.data, enc.len)
    path := filepath.Join(os.TempDir(), "salam_midi_guide.mid")
    defer mem.Free(path as void*)
    println "saved:", midi.SaveMIDI(song, path)

    compress.BufFree(enc)
    midi.FreeSong(song)
end
