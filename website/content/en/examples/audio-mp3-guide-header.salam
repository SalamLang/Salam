import audio.mp3
import compress

func main:
    mut file := compress.NewByteBuf()
    mut f := 0
    until f < 4:
        compress.BufPush(file, 255)
        compress.BufPush(file, 0xFB)
        compress.BufPush(file, 0x90)
        compress.BufPush(file, 0xC0)
        mut i := 4
        until i < 417:
            compress.BufPush(file, 0)
            i++
        end
        f++
    end

    println "looks like mp3:", mp3.IsMP3(file.data, file.len)
    mut h := mp3.Header {}
    println "header:", mp3.ParseHeader(file.data, file.len, 0, h)
    println h.rate, "Hz,", h.bitrate, "kbit/s,", h.channels, "channel"
    println "layer 3:", h.layer == mp3.Layer3
    println "frame bytes:", h.frame_size, "samples:", h.samples
    println "frames:", mp3.CountFrames(file.data, file.len)

    compress.BufFree(file)
end
