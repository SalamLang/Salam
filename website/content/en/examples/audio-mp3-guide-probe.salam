import archive
import audio.mp3
import compress
import filepath
import mem
import os

func main:
    mut file := compress.NewByteBuf()
    mut f := 0
    until f < 40:
        compress.BufPush(file, 255)
        compress.BufPush(file, 0xFB)
        compress.BufPush(file, 0x90)
        compress.BufPush(file, 0xC0)
        mut i := 4
        until i < 417:
            compress.BufPush(file, 0)
            i += 1
        end
        f += 1
    end
    path := filepath.Join(os.TempDir(), "salam_mp3_guide.mp3")
    defer mem.Free(path as void*)
    println "written:", archive.WriteBinaryFileBuf(path, file)

    mut ok := false
    info := mp3.ProbeFileMP3(path, ok)
    println ok, info.rate, info.channels, info.lossless
    println "frames:", info.frames
    println "whole seconds:", info.frames / info.rate

    println "frame 1 at byte:", mp3.FrameAt(file.data, file.len, 1)
    println "past the end:", mp3.FrameAt(file.data, file.len, 99)
    println "at 0.5s:", mp3.SeekToSecond(file.data, file.len, 0.5)

    compress.BufFree(file)
end
