import audio.music
import math
import mem

func main:
    each n in [60, 64, 67, 69]:
        name := music.NoteName(n)
        println n, name, math.Round(music.NoteToFreq(n) * 10.0) / 10.0
        mem.Free(name as void*)
    end
    println music.ParseNote("A4"), music.ParseNote("C#5")
    println music.FreqToNote(261.63)
    println music.Transpose(60, 7), music.Interval(60, 67)
    println music.BeatSeconds(120.0)
end
