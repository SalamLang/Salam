import audio.music
import mem

func show(label: str, notes: Vector<int>):
    mut line := label
    each n in notes:
        name := music.NoteName(n)
        line = line + " " + name
        mem.Free(name as void*)
    end
    println line
end

func main:
    mut major := music.ScaleNotes(60, music.ScaleMajor, 7)
    show("C major:", major)
    major.Free()

    mut minor := music.ScaleNotes(57, music.ScaleMinor, 7)
    show("A minor:", minor)
    minor.Free()

    mut triad := music.ChordNotes(60, music.ChordMajor)
    show("C chord:", triad)
    triad.Free()

    mut seventh := music.ChordNotes(67, music.ChordDominant7)
    show("G7:", seventh)
    seventh.Free()
end
