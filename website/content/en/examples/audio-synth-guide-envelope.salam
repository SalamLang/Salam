import audio
import audio.synth

func main:
    e := synth.ADSR { attack = 0.05, decay = 0.1, sustain = 0.6, release = 0.2 }
    println "total:", synth.ADSRTotal(e, 0.5)
    each t in [0.0, 0.025, 0.05, 0.3, 0.5]:
        println t, synth.ADSRAt(e, t, 0.5)
    end

    flat := synth.Tone(440.0, 0.7, 22050, synth.WaveSaw)
    shaped := synth.ToneEnvelope(440.0, 0.5, 22050, synth.WaveSaw, e, 0.8)
    println "flat peak:", audio.Peak(flat) > 0.9
    println "shaped peak:", audio.Peak(shaped) <= 0.81
    println "starts silent:", audio.Sample(shaped, 0, 0) == 0.0

    mut a := flat
    audio.Free(a)
    mut b := shaped
    audio.Free(b)
end
