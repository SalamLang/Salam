import audio
import audio.music
import audio.synth

func main:
    e := synth.ADSR { attack = 0.01, decay = 0.05, sustain = 0.5, release = 0.1 }
    mut notes := Vector {} as Vector<synth.Note>
    defer notes.free()
    mut scale := music.ScaleNotes(60, music.ScaleMajor, 8)
    defer scale.free()
    mut i := 0
    until i < scale.len():
        start := (i as f64) * 0.25
        notes.push(synth.NoteAt(scale.get(i), start, 0.25, 0.5, synth.WaveTriangle))
        i++
    end
    println "notes:", notes.len()

    song := synth.RenderNotes(notes, 22050, 2, e)
    println song.channels, song.rate
    println "seconds:", audio.Duration(song) > 2.0
    println "clipped:", audio.IsClipped(song)

    mut s := song
    audio.Free(s)
end
