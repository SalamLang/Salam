import audio
import audio.synth
import audio.wav
import compress

func main:
    clip := synth.Tone(440.0, 1.0, 44100, synth.WaveSine)
    println clip.rate, clip.channels, clip.frames
    println "seconds:", audio.Duration(clip)
    println "loud enough:", audio.Peak(clip) > 0.9
    println "clipped:", audio.IsClipped(clip)

    mut enc := wav.EncodeWAV(clip)
    println "wav bytes:", compress.BufLen(enc)
    println "is wav:", wav.IsWAV(enc.data, enc.len)

    mut c := clip
    audio.Free(c)
    compress.BufFree(enc)
end
