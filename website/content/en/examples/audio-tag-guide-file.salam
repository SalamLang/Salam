import archive
import audio.tag
import compress
import filepath
import mem
import os
import str

func main:
    mut t := tag.NewTags()
    t.title = str.Clone("Evening Walk")
    t.artist = str.Clone("Darya")
    mut head := tag.WriteID3v2(t)
    mut file := compress.NewByteBuf()
    compress.BufPushBuf(file, head)
    mut i := 0
    until i < 100:
        compress.BufPush(file, 65)
        i++
    end

    path := filepath.Join(os.TempDir(), "salam_tag_guide.mp3")
    defer mem.Free(path as void*)
    println "written:", archive.WriteBinaryFileBuf(path, file)

    mut ok := false
    mut got := tag.ReadTagsFile(path, ok)
    println ok, got.title, "-", got.artist

    println "audio starts at:", tag.AudioStart(file.data, file.len)
    mut bare := tag.StripTags(file.data, file.len)
    println "audio only:", compress.BufLen(bare)

    tag.FreeTags(t)
    tag.FreeTags(got)
    compress.BufFree(head)
    compress.BufFree(file)
    compress.BufFree(bare)
end
