import audio.tag
import compress
import str

func main:
    mut t := tag.NewTags()
    t.title = str.Clone("Evening Walk")
    t.artist = str.Clone("Darya")
    t.album = str.Clone("Small Rooms")
    t.year = 2026
    t.track = 3
    t.tracks = 9

    mut block := tag.WriteID3v2(t)
    println "has tag:", tag.HasID3v2(block.data, block.len)
    println "version:", tag.ID3v2Version(block.data, block.len)

    mut got := tag.NewTags()
    ok := tag.ReadID3v2(block.data, block.len, got)
    println "read:", ok
    println got.title, "by", got.artist
    println got.album, got.year, got.track, "of", got.tracks

    tag.FreeTags(t)
    tag.FreeTags(got)
    compress.BufFree(block)
end
