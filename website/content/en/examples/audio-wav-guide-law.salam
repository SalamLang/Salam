import audio
import audio.wav
import compress
import math

func main:
    mut c := audio.New(8000, 1, 400)
    mut i := 0
    until i < 400:
        audio.SetSample(c, i, 0, 0.8 * math.Sin(2.0 * math.PI * 200.0 * (i as f64) / 8000.0))
        i++
    end
    mut pcm := wav.EncodeWAVBits(c, 16)
    mut mu := wav.EncodeMuLaw(c)
    mut al := wav.EncodeALaw(c)
    println compress.BufLen(pcm), compress.BufLen(mu), compress.BufLen(al)

    mut ok := false
    mut back := wav.DecodeWAV(mu.data, mu.len, ok)
    println ok, back.frames, back.bits
    mut worst := 0.0
    mut k := 0
    until k < 400:
        d := math.Abs(audio.Sample(back, k, 0) - audio.Sample(c, k, 0))
        if d > worst:
            worst = d
        end
        k++
    end
    println worst < 0.03
    compress.BufFree(pcm)
    compress.BufFree(mu)
    compress.BufFree(al)
    audio.Free(c)
    audio.Free(back)
end
