import audio
import audio.wav
import compress

func main:
    mut c := audio.New(22050, 2, 100)
    audio.SetSample(c, 7, 1, 0.5)
    mut buf := wav.EncodeWAVBits(c, 24)
    println wav.IsWAV(buf.data, buf.len), wav.IsWAV(buf.data, 4)

    mut f := wav.Format {}
    println wav.ReadFormat(buf.data, buf.len, f)
    println f.codec == wav.CodecPCM, f.channels, f.rate, f.bits
    println f.block_align, f.byte_rate

    mut fmt_chunk := wav.Chunk {}
    mut data_chunk := wav.Chunk {}
    println wav.FindChunk(buf.data, buf.len, wav.Tag("fmt "), fmt_chunk)
    println wav.FindChunk(buf.data, buf.len, wav.Tag("data"), data_chunk)
    println fmt_chunk.size, data_chunk.offset, data_chunk.size
    println data_chunk.size / f.block_align

    mut ok := false
    mut back := wav.DecodeWAV(buf.data, buf.len, ok)
    println ok, back.frames, audio.Sample(back, 7, 1)
    compress.BufFree(buf)
    audio.Free(c)
    audio.Free(back)
end
