import audio
import audio.wav
import filepath
import math
import mem
import os

func tone(rate: int, freq: f64, frames: int): audio.Clip:
    mut c := audio.New(rate, 1, frames)
    mut i := 0
    until i < frames:
        audio.SetSample(c, i, 0, 0.5 * math.Sin(2.0 * math.PI * freq * (i as f64) / (rate as f64)))
        i++
    end
    ret c
end

func main:
    mut c := tone(8000, 440.0, 800)
    path := filepath.Join(os.TempDir(), "salam_guide_tone.wav")
    defer mem.Free(path as void*)
    println wav.SaveWAVBits(c, path, 16)

    mut ok := false
    info := wav.ProbeFileWAV(path, ok)
    println ok, info.rate, info.channels, info.bits, info.frames

    mut back_ok := false
    mut back := wav.OpenWAV(path, back_ok)
    close := math.Abs(audio.Sample(back, 5, 0) - audio.Sample(c, 5, 0)) < 0.001
    println back_ok, back.frames, close
    audio.Free(c)
    audio.Free(back)
end
