import ai.autograd
import ai.tensor

func softplus_sum(t &: tensor.Tensor): f64:
    ret tensor.SumAll(tensor.Log(tensor.AddScalar(tensor.Exp(t), 1.0)))
end

func main:
    mut point := tensor.Arange(4)
    tensor.AddScalarInPlace(point, -1.5)
    mut tape := autograd.NewTape(1)
    x := autograd.Watch(tape, point)
    y := autograd.Log(tape, autograd.AddScalar(tape, autograd.Exp(tape, x), 1.0))
    autograd.Backward(tape, autograd.Sum(tape, y))
    mut from_tape := autograd.Grad(tape, x)
    println "tape gradient matches:", autograd.GradCheck((t_in: tensor.Tensor): mut t := t_in ret softplus_sum(t) end, point, from_tape, 0.001, 0.01)
    mut wrong := tensor.Scale(from_tape, 2.0)
    println "doubled gradient matches:", autograd.GradCheck((t_in: tensor.Tensor): mut t := t_in ret softplus_sum(t) end, point, wrong, 0.001, 0.01)
    tape.Free()
end
