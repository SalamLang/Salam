import autograd
import tensor

func main:
    mut tape := autograd.NewTape(1)
    mut points := Vector {} as Vector<f32>
    each v in [-2.0, -1.0, 0.0, 1.0, 2.0]:
        points.push(v as f32)
    end
    shape := tensor.Shape1(5)
    xs := tensor.FromArray(shape, points)
    x := autograd.Watch(tape, xs)
    cube := autograd.PowScalar(tape, x, 3.0)
    f := autograd.Sub(tape, cube, autograd.Scale(tape, x, 2.0))
    autograd.Backward(tape, autograd.Sum(tape, f))
    values := autograd.Value(tape, f)
    slopes := autograd.Grad(tape, x)
    repeat 5 in i:
        at := xs.at(i)
        println "x =", at, "f =", values.at(i), "slope =", slopes.at(i), "expected", 3.0 * at * at - 2.0
    end
    tape.free()
end
