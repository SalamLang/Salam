import autograd
import tensor
import conv

func column(values: f64[]): tensor.Tensor:
    mut data := Vector {} as Vector<f32>
    each v in values:
        data.push(v as f32)
    end
    shape := tensor.Shape2(values.len(), 1)
    ret tensor.FromArray(shape, data)
end

func main:
    xs := column([0.0, 1.0, 2.0, 3.0, 4.0])
    ys := column([1.1, 2.9, 5.2, 6.8, 9.1])
    mut w := tensor.Zeros2(1, 1)
    mut b := tensor.Zeros2(1, 1)
    mut w_grad := tensor.Zeros2(1, 1)
    mut b_grad := tensor.Zeros2(1, 1)
    mut tape := autograd.NewTape(1)
    repeat 201 in step:
        tape.reset()
        tensor.SetAll(w_grad, 0.0)
        tensor.SetAll(b_grad, 0.0)
        wn := autograd.Param(tape, w, w_grad)
        bn := autograd.Param(tape, b, b_grad)
        guess := autograd.Add(tape, autograd.MatMul(tape, autograd.Input(tape, xs), wn), bn)
        loss := autograd.MSELoss(tape, guess, autograd.Constant(tape, ys))
        autograd.Backward(tape, loss)
        tensor.AddScaled(w, w_grad, -0.02)
        tensor.AddScaled(b, b_grad, -0.02)
        if step % 50 == 0:
            println "step", step, "loss", conv.FormatFloatPrec(autograd.Value(tape, loss).at(0), 3)
        end
    end
    println "y =", conv.FormatFloatPrec(w.at(0), 2), "* x +", conv.FormatFloatPrec(b.at(0), 2)
    tape.free()
end
