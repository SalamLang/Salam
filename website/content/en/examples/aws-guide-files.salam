import aws

func main:
    mut cfg := aws.ForMinio("http://127.0.0.1:9000", "backups")
    cfg = aws.WithCredentials(cfg, "minioadmin", "minioadmin")
    opts := aws.PutOptions { content_type = "application/gzip", storage_class = "STANDARD_IA" }
    up := aws.S3UploadFile(cfg, "db/2026-10-17.sql.gz", "/var/backups/shop.sql.gz", opts)
    if not up.ok:
        println "upload failed:", up.code, up.error
        ret 1
    end
    println "uploaded", up.bytes, "bytes in", up.parts, "part(s)"
    down := aws.S3DownloadFile(cfg, "db/2026-10-17.sql.gz", "/tmp/restore.sql.gz")
    if not down.ok:
        println "download failed:", down.code, down.error
        ret 1
    end
    println "restored", down.bytes, "bytes to", down.path
    logo := aws.S3GetBytes(cfg, "site/logo.png")
    if logo.ok:
        println "logo.png is", logo.len, "bytes"
    end
    aws.FreeBytes(logo)
end
