import aws

func main:
    mut cfg := aws.ForMinio("http://127.0.0.1:9000", "backups")
    cfg = aws.WithCredentials(cfg, "minioadmin", "minioadmin")
    if not aws.S3BucketExists(cfg, "backups"):
        made := aws.S3CreateBucket(cfg, "backups")
        if not made.ok:
            println "could not create the bucket:", made.status, made.code, made.error
            ret 1
        end
    end
    _ := aws.S3Put(cfg, "2026/10/notes.txt", "first backup", "text/plain")
    _ := aws.S3Put(cfg, "2026/10/todo.txt", "buy milk", "text/plain")
    mut listing := aws.S3ListPrefix(cfg, "2026/10/")
    each item in listing.items:
        println item.key, item.size
    end
    aws.ListFree(listing)
    got := aws.S3Get(cfg, "2026/10/notes.txt")
    if got.ok:
        println "read back:", got.body
    else:
        println "read failed:", got.status, got.code
    end
end
