import aws

func main:
    mut cfg := aws.ForAws("eu-central-1", "user-uploads")
    cfg = aws.WithCredentials(cfg, "AKIAIOSFODNN7EXAMPLE", "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY")
    at := 1792224000 as i64
    upload := aws.PresignOptions { expires = 300, content_type = "image/jpeg" }
    put_url := aws.S3PresignWith(cfg, "PUT", "avatars/42.jpg", upload, at)
    println "upload:", put_url.Len() > 0
    println put_url.Substr(0, put_url.Find("?"))
    println "expires in 300s:", put_url.Find("X-Amz-Expires=300") >= 0
    println "content type is signed:", put_url.Find("content-type") >= 0
    download := aws.PresignOptions { expires = 3600, response_content_disposition = "attachment; filename=\"photo.jpg\"" }
    get_url := aws.S3PresignWith(cfg, "GET", "avatars/42.jpg", download, at)
    println "download asks to save:", get_url.Find("response-content-disposition=attachment") >= 0
    println "same signature twice:", get_url == aws.S3PresignWith(cfg, "GET", "avatars/42.jpg", download, at)
end
