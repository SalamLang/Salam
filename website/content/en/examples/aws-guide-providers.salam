import aws

func storage(provider: str, bucket: str): aws.Config:
    switch provider:
        "r2":
            ret aws.ForR2("0123456789abcdef", bucket)
        end
        "spaces":
            ret aws.ForSpaces("ams3", bucket)
        end
        "minio":
            ret aws.ForMinio("http://127.0.0.1:9000", bucket)
        end
    end
    ret aws.ForAws("eu-central-1", bucket)
end

func main:
    each provider in ["aws", "r2", "spaces", "minio"]:
        cfg := storage(provider, "media")
        println provider, cfg.endpoint, cfg.region, cfg.path_style
    end
end
