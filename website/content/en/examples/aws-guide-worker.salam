import aws

func handle(body: str): bool:
    println "resizing", body
    ret body.len() > 0
end

func main:
    cfg := aws.FromEnvironment("")
    if cfg.access_key.len() == 0 or cfg.secret_key.len() == 0:
        println "set AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY and AWS_REGION"
        ret 1
    end
    queue := aws.SqsQueueUrl(cfg, "image-jobs")
    if queue.len() == 0:
        println "the queue image-jobs does not exist"
        ret 1
    end
    _ := aws.SqsSend(cfg, queue, "photos/beach.jpg")
    opts := aws.ReceiveOptions { max_messages = 10, wait_seconds = 20 }
    batch := aws.SqsReceive(cfg, queue, opts)
    if not batch.ok:
        println "receive failed:", batch.code, batch.error
        ret 1
    end
    each m in batch.items:
        if handle(m.body):
            _ := aws.SqsDelete(cfg, queue, m.receipt)
        else:
            _ := aws.SqsRelease(cfg, queue, m.receipt)
        end
    end
    println "handled", batch.items.len(), "message(s)"
end
