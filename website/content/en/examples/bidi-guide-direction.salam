import bidi

func main:
    lines := ["Hello, world", "سلام دنیا", "2026 سال خوبی بود", "Salam یعنی سلام", "123 456"]
    each line in lines:
        mut align := "left"
        if bidi.ParagraphLevel(line, bidi.DirAuto) == 1:
            align = "right"
        end
        println align, "|", line
    end
end
