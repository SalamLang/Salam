import bidi
import str
import unicode

func draw(line: str): str:
    cps := str.CodePoints(line)
    defer cps.free()
    levels := bidi.Levels(line, bidi.DirAuto)
    defer levels.free()
    order := bidi.VisualOrder(line, bidi.DirAuto)
    defer order.free()
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    each i in order:
        mut cp := cps.get(i)
        if levels.get(i) % 2 == 1:
            cp = unicode.PairedBracket(cp)
        end
        str.BufAppendCp(b, cp)
    end
    ret str.BufStr(b)
end

func brackets(s: str): str:
    mut out := ""
    chars := str.Chars(s)
    defer chars.free()
    each ch in chars:
        if ch == "(" or ch == ")" or ch == "[" or ch == "]":
            out = out + ch
        end
    end
    ret out
end

func main:
    each line in ["قیمت (با مالیات)", "فصل [۲] و فصل [۳]"]:
        println "Reorder:", brackets(bidi.Reorder(line, bidi.DirAuto)), "mirrored:", brackets(draw(line))
    end
end
