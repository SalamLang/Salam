import bidi
import str

func main:
    text := "Salam به معنی peace است"
    chars := str.Chars(text)
    levels := bidi.Levels(text, bidi.DirRTL)
    mut run := ""
    mut level := levels.Get(0)
    repeat chars.Len() in i:
        if levels.Get(i) != level:
            println level, "[" + run + "]"
            run = ""
            level = levels.Get(i)
        end
        run += chars.Get(i)
    end
    println level, "[" + run + "]"
end
