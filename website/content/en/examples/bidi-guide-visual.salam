import bidi
import str

func main:
    text := "ab سلام"
    chars := str.Chars(text)
    order := bidi.VisualOrder(text, bidi.DirLTR)
    mut drawn := ""
    each column, index in order:
        println column, "<-", index, "[" + chars.get(index) + "]"
        drawn = drawn + chars.get(index)
    end
    println drawn == bidi.Reorder(text, bidi.DirLTR)
end
