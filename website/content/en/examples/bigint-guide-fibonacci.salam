import bigint
import str

func main:
    mut a := bigint.Zero()
    mut b := bigint.One()
    repeat 1 to 300 in n:
        next := bigint.Add(a, b)
        bigint.Free(a)
        a = b
        b = next
        if n == 92 or n == 93:
            mut fits := false
            v := bigint.ToInt(a, fits)
            println "F(" + str.FromInt(n) + ") =", bigint.ToStr(a), "fits in i64:", fits, v
        end
    end
    text := bigint.ToStr(a)
    println "F(300) has", text.len(), "digits"
    println text
    bigint.Free(a)
    bigint.Free(b)
end
