import calendar

func next birthday(born: calendar.JalaliDate, today: calendar.JalaliDate): calendar.JalaliDate:
    mut target year := today.year
    mut target day := born.day
    if born.month == 12 and target day == 30 and not calendar.IsLeapJalali(target year):
        target day = 29
    end
    mut next := calendar.JalaliDate { year = target year, month = born.month, day = target day }
    if calendar.CompareJalali(next, today) < 0:
        target year += 1
        target day = born.day
        if born.month == 12 and target day == 30 and not calendar.IsLeapJalali(target year):
            target day = 29
        end
        next = calendar.JalaliDate { year = target year, month = born.month, day = target day }
    end
    ret next
end

func main:
    today := calendar.JalaliDate { year = 1405, month = 7, day = 25 }
    born := calendar.JalaliDate { year = 1370, month = 9, day = 3 }
    mut age := today.year - born.year
    birthday now := calendar.JalaliDate { year = today.year, month = born.month, day = born.day }
    if calendar.CompareJalali(birthday now, today) > 0:
        age -= 1
    end
    next := next birthday(born, today)
    println "age:", age
    println "next birthday:", calendar.FormatJalali(next), "(" + calendar.JalaliMonthNameEn(next.month) + ")"
    println "days to go:", calendar.DaysBetweenJalali(today, next)
    println "in the Gregorian calendar:", calendar.FormatGregorian(calendar.JalaliToGregorian(next))
    leap := calendar.JalaliDate { year = 1403, month = 12, day = 30 }
    println "born on 30 Esfand 1403, celebrates in 1405 on:", calendar.FormatJalali(next birthday(leap, today))
end
