import calendar

func next_birthday(born: calendar.JalaliDate, today: calendar.JalaliDate): calendar.JalaliDate:
    mut target_year := today.year
    mut target_day := born.day
    if born.month == 12 and target_day == 30 and not calendar.IsLeapJalali(target_year):
        target_day = 29
    end
    mut next := calendar.JalaliDate { year = target_year, month = born.month, day = target_day }
    if calendar.CompareJalali(next, today) < 0:
        target_year++
        target_day = born.day
        if born.month == 12 and target_day == 30 and not calendar.IsLeapJalali(target_year):
            target_day = 29
        end
        next = calendar.JalaliDate { year = target_year, month = born.month, day = target_day }
    end
    ret next
end

func main:
    today := calendar.JalaliDate { year = 1405, month = 7, day = 25 }
    born := calendar.JalaliDate { year = 1370, month = 9, day = 3 }
    mut age := today.year - born.year
    birthday_now := calendar.JalaliDate { year = today.year, month = born.month, day = born.day }
    if calendar.CompareJalali(birthday_now, today) > 0:
        age--
    end
    next := next_birthday(born, today)
    println "age:", age
    println "next birthday:",
        calendar.FormatJalali(next),
        "(" + calendar.JalaliMonthNameEn(next.month) + ")"
    println "days to go:", calendar.DaysBetweenJalali(today, next)
    println "in the Gregorian calendar:", calendar.FormatGregorian(calendar.JalaliToGregorian(next))
    leap := calendar.JalaliDate { year = 1403, month = 12, day = 30 }
    println "born on 30 Esfand 1403, celebrates in 1405 on:",
        calendar.FormatJalali(next_birthday(leap, today))
end
