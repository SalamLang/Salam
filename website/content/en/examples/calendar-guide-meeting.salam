import calendar

func show(label: str, epoch: i64, zone name: str):
    mut z := calendar.LoadZone(zone name)
    tz := calendar.TimeZoneAt(z, epoch)
    d := calendar.WallClockGregorian(epoch, tz)
    t := calendar.WallClockTime(epoch, tz)
    println label, calendar.FormatGregorian(d), calendar.FormatClockTime(t), calendar.ZoneAbbrevAt(z, epoch)
    calendar.FreeZone(z)
end

func main:
    mut tehran := calendar.LoadZone("Asia/Tehran")
    meeting day := calendar.GregorianDate { year = 2026, month = 3, day = 25 }
    at := calendar.ClockTime { hour = 18, minute = 30 }
    meeting := calendar.ZonedToEpoch(meeting day, at, tehran)
    calendar.FreeZone(tehran)
    show("Tehran:  ", meeting, "Asia/Tehran")
    show("London:  ", meeting, "Europe/London")
    show("New York:", meeting, "America/New_York")
    show("Tokyo:   ", meeting, "Asia/Tokyo")
    show("one week later in London:", meeting + 7 * 86400, "Europe/London")
end
