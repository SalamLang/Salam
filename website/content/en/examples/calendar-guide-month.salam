import calendar
import str

func main:
    shown_year := 1405
    shown_month := 7
    first := calendar.JalaliDate { year = shown_year, month = shown_month, day = 1 }
    println calendar.JalaliMonthNameEn(shown_month), shown_year
    println "Sa Su Mo Tu We Th Fr"
    offset := calendar.JalaliWeekday(calendar.JalaliToJDN(first))
    mut line := ""
    repeat offset:
        line += "   "
    end
    days := calendar.DaysInJalaliMonth(shown_year, shown_month)
    repeat 1 to days in d:
        if d < 10:
            line += " "
        end
        line += str.FromInt(d)
        if (offset + d) % 7 == 0:
            println line
            line = ""
        else:
            line += " "
        end
    end
    if line != "":
        println line.Trim()
    end
    println "starts on", calendar.FormatGregorianLongEn(calendar.JalaliToGregorian(first))
end
