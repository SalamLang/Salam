import calendar
import str

func main:
    shown year := 1405
    shown month := 7
    first := calendar.JalaliDate { year = shown year, month = shown month, day = 1 }
    println calendar.JalaliMonthNameEn(shown month), shown year
    println "Sa Su Mo Tu We Th Fr"
    offset := calendar.JalaliWeekday(calendar.JalaliToJDN(first))
    mut line := ""
    repeat offset:
        line = line + "   "
    end
    days := calendar.DaysInJalaliMonth(shown year, shown month)
    repeat 1 to days in d:
        if d < 10:
            line = line + " "
        end
        line = line + str.FromInt(d)
        if (offset + d) % 7 == 0:
            println line
            line = ""
        else:
            line = line + " "
        end
    end
    if line != "":
        println line.trim()
    end
    println "starts on", calendar.FormatGregorianLongEn(calendar.JalaliToGregorian(first))
end
