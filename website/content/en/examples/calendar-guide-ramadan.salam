import calendar

func main:
    start := calendar.HijriDate { year = 1448, month = 9, day = 1 }
    days := calendar.DaysInHijriMonth(start.year, start.month)
    last := calendar.AddDaysHijri(start, days - 1)
    eid := calendar.AddDaysHijri(last, 1)
    println calendar.HijriMonthNameEn(start.month), start.year, "has", days, "days"
    println "first day:", calendar.FormatGregorian(calendar.HijriToGregorian(start)), "=", calendar.FormatJalali(calendar.HijriToJalali(start))
    println "last day: ", calendar.FormatGregorian(calendar.HijriToGregorian(last)), "=", calendar.FormatJalali(calendar.HijriToJalali(last))
    println "Eid:      ", calendar.FormatGregorian(calendar.HijriToGregorian(eid)), calendar.WeekdayNameEn(calendar.WeekdayHijri(eid))
    println "in Arabic:", calendar.FormatHijriLongAr(eid)
end
