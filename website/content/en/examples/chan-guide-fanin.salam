import chan
import sync

mut events := chan.Chan {} as chan.Chan<i64>
mut senders := sync.WaitGroup {}

func sensor(base: i64):
    repeat 5 in i:
        events.Send(base + i as i64)
    end
    sync.Done(senders)
end

func sensor_a(): sensor(100) end
func sensor_b(): sensor(200) end
func sensor_c(): sensor(300) end

func closer():
    sync.Wait(senders)
    events.Close()
end

func main:
    events.Init(4)
    senders = sync.NewWaitGroup()
    sync.Add(senders, 3)
    a := spawn(sensor_a)
    b := spawn(sensor_b)
    c := spawn(sensor_c)
    d := spawn(closer)
    mut per_sensor := [0, 0, 0]
    mut ok := true
    until true:
        v := events.Recv(ok)
        if not ok:
            break
        end
        per_sensor[v / 100 - 1]++
    end
    join(a)
    join(b)
    join(c)
    join(d)
    println "from sensor a:", per_sensor[0]
    println "from sensor b:", per_sensor[1]
    println "from sensor c:", per_sensor[2]
    sync.DestroyWaitGroup(senders)
    events.Free()
end
