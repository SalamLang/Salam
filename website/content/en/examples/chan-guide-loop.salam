import chan

mut orders := chan.Chan {} as chan.Chan<str>

func checkout():
    each id in ["A-1001", "A-1002", "A-1003"]:
        orders.Send(id)
    end
    orders.Close()
    println "after close, send works:", orders.Send("A-1004")
end

func main:
    orders.Init(8)
    t := spawn(checkout)
    join(t)
    println "waiting in the buffer:", orders.Len()
    mut ok := true
    until true:
        id := orders.Recv(ok)
        if not ok: break end
        println "packing", id
    end
    println "closed and empty:", orders.IsClosed(), orders.Len()
    orders.Free()
end
