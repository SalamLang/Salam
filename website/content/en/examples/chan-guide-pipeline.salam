import chan

mut numbers := chan.Chan {} as chan.Chan<i64>
mut squares := chan.Chan {} as chan.Chan<i64>

func generate():
    repeat 1 to 10 in n:
        numbers.Send(n as i64)
    end
    numbers.Close()
end

func square():
    mut ok := true
    until true:
        n := numbers.Recv(ok)
        if not ok:
            break
        end
        squares.Send(n * n)
    end
    squares.Close()
end

func main:
    numbers.Init(2)
    squares.Init(2)
    a := spawn(generate)
    b := spawn(square)
    mut total := 0 as i64
    mut count := 0
    mut ok := true
    until true:
        v := squares.Recv(ok)
        if not ok:
            break
        end
        total += v
        count++
    end
    join(a)
    join(b)
    println "values through the pipeline:", count
    println "sum of squares:", total
    numbers.Free()
    squares.Free()
end
