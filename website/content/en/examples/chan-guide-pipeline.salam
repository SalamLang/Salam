import chan

mut numbers := chan.Chan {} as chan.Chan<i64>
mut squares := chan.Chan {} as chan.Chan<i64>

func generate():
    repeat 1 to 10 in n:
        numbers.send(n as i64)
    end
    numbers.close()
end

func square():
    mut ok := true
    until true:
        n := numbers.recv(ok)
        if not ok:
            break
        end
        squares.send(n * n)
    end
    squares.close()
end

func main:
    numbers.init(2)
    squares.init(2)
    a := spawn(generate)
    b := spawn(square)
    mut total := 0 as i64
    mut count := 0
    mut ok := true
    until true:
        v := squares.recv(ok)
        if not ok:
            break
        end
        total += v
        count += 1
    end
    join(a)
    join(b)
    println "values through the pipeline:", count
    println "sum of squares:", total
    numbers.free()
    squares.free()
end
