import chan

mut requests := chan.Chan {} as chan.Chan<str>
mut replies := chan.Chan {} as chan.Chan<str>

func server():
    mut ok := true
    until true:
        name := requests.recv(ok)
        if not ok:
            break
        end
        replies.send("hello, " + name)
    end
end

func main:
    requests.init(0)
    replies.init(0)
    t := spawn(server)
    mut ok := true
    each name in ["Sara", "Reza", "Mina"]:
        requests.send(name)
        println replies.recv(ok)
    end
    requests.close()
    join(t)
    requests.free()
    replies.free()
end
