import chan

mut requests := chan.Chan {} as chan.Chan<str>
mut replies := chan.Chan {} as chan.Chan<str>

func server():
    mut ok := true
    until true:
        name := requests.Recv(ok)
        if not ok:
            break
        end
        replies.Send("hello, " + name)
    end
end

func main:
    requests.Init(0)
    replies.Init(0)
    t := spawn(server)
    mut ok := true
    each name in ["Sara", "Reza", "Mina"]:
        requests.Send(name)
        println replies.Recv(ok)
    end
    requests.Close()
    join(t)
    requests.Free()
    replies.Free()
end
