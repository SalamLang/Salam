import chan

func main:
    mut queue := chan.Chan {} as chan.Chan<int>
    queue.Init(3)
    mut accepted := 0
    mut dropped := 0
    repeat 1 to 8 in request:
        if queue.TrySend(request):
            accepted++
        else:
            dropped++
        end
    end
    println "accepted:", accepted, "dropped:", dropped, "waiting:", queue.Len()
    mut ok := true
    until true:
        r := queue.TryRecv(ok)
        if not ok:
            break
        end
        println "handling request", r
    end
    println "queue empty:", queue.Len() == 0
    queue.Free()
end
