$ todo add -p 1 buy milk
added [buy milk] with priority 1
exit 0
$ todo list --all
listing all tasks
exit 0
$ todo add --priority=high call mom
todo add: invalid int value for --priority: high
exit 2
$ todo add --help
Usage: todo add [options] [args]
  adds a task
Options:
  -p, --priority <int>  1 is the most urgent (default: 3)
  -h, --help  show this help
exit 0
$ todo --version
todo 0.3.0
exit 0
$ todo remove 3
todo: unknown command: remove
todo 0.3.0
a small task list

Usage: todo <command> [options]

Commands:
  add           add a task
  list          show the tasks

Run 'todo <command> --help' for help on a specific command.
exit 2
