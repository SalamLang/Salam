import collections
import str

func balanced(code: str): bool:
    mut open := collections.Stack {} as collections.Stack<str>
    defer open.free()
    chars := str.Chars(code)
    defer chars.free()
    each c in chars:
        if c == "(" or c == "[":
            open.push(c)
        else c == ")" or c == "]":
            if open.is_empty():
                ret false
            end
            top := open.pop()
            if (c == ")" and top != "(") or (c == "]" and top != "["):
                ret false
            end
        end
    end
    ret open.is_empty()
end

func main:
    println balanced("total(a[1], b[2])")
    println balanced("f(x]")
    println balanced("((x)")
end
