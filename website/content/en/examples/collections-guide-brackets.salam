import collections
import str

func opener(c: char): char:
    if c == ')': ret '(' end
    if c == ']': ret '[' end
    ret '{'
end

func check(s: str): str:
    mut open := collections.Stack {} as collections.Stack<char>
    defer open.Free()
    repeat str.Len(s) in i:
        c := s[i]
        if c == '(' or c == '[' or c == '{':
            open.push(c)
        else c == ')' or c == ']' or c == '}':
            if open.IsEmpty() or open.peek() != opener(c):
                ret "mismatch at " + str.FromInt(i)
            end
            open.pop()
        end
    end
    if not open.IsEmpty():
        ret str.FromInt(open.Size()) + " left open"
    end
    ret "balanced"
end

func main:
    each s in ["f(a[1], {b: 2})", "(1 + 2]", "{[()]}", "((x)", "x)"]:
        println s, "->", check(s)
    end
end
