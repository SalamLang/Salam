import collections

func main:
    maze := ["S.#.....", ".##.###.", "....#...", ".##...#E"]
    rows := maze.len()
    cols := 8
    dr := [-1, 1, 0, 0]
    dc := [0, 0, -1, 1]
    mut dist := Vector {} as Vector<int>
    defer dist.free()
    repeat rows * cols:
        dist.push(-1)
    end

    mut todo := collections.Queue {} as collections.Queue<int>
    defer todo.free()
    todo.enqueue(0)
    dist.set(0, 0)
    mut goal := -1
    until not todo.is_empty():
        cell := todo.dequeue()
        r := cell / cols
        c := cell % cols
        if maze[r][c] == 'E':
            goal = cell
            break
        end
        repeat 4 in k:
            nr := r + dr[k]
            nc := c + dc[k]
            if nr >= 0 and nr < rows and nc >= 0 and nc < cols:
                next := nr * cols + nc
                if maze[nr][nc] != '#' and dist.get(next) == -1:
                    dist.set(next, dist.get(cell) + 1)
                    todo.enqueue(next)
                end
            end
        end
    end
    println "shortest path to E:", dist.get(goal), "steps"
    mut seen := 0
    each d in dist:
        if d >= 0: seen += 1 end
    end
    println "cells reached:", seen, "of", rows * cols
end
