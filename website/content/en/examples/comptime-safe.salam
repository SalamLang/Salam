if SALAM_SAFE:
    const BUILD := "debug"
else:
    const BUILD := "release"
end

func find(xs: int[], want: int): int:
    if SALAM_SAFE:
        repeat len(xs) - 1 in i:
            if xs[i] > xs[i + 1]:
                printerrln "find: the input is not sorted"
                break
            end
        end
    end
    mut lo := 0
    mut hi := len(xs) - 1
    until lo <= hi:
        mid := (lo + hi) / 2
        if xs[mid] == want:
            ret mid
        else xs[mid] < want:
            lo = mid + 1
        else:
            hi = mid - 1
        end
    end
    ret -1
end

func main:
    println "build:", BUILD
    println find([2, 5, 8, 13, 21], 13)
    println find([9, 4, 7, 1], 9)
end
