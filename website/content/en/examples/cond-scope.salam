func main:
    weight := 3
    express := true
    mut cost := 0
    if weight <= 1:
        cost = 30
    else weight <= 5:
        cost = 55
    else:
        cost = 90
    end
    if express:
        cost += 25
    end
    println "shipping:", cost
    label := weight > 2 ? "heavy" : "light"
    println label
end
