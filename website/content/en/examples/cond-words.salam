func ticket(age: int): int:
    if age < 4:
        ret 0
    else age <= 12:
        ret 40
    else age >= 65:
        ret 50
    else:
        ret 90
    end
end

func main:
    println ticket(2), ticket(9), ticket(30), ticket(70)
    seats := 12
    sold := 12
    if sold == seats: println "sold out" end
    if sold != seats: println "seats left" end
end
