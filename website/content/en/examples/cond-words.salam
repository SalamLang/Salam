func ticket(age: int): int:
    if age_lt 4:
        ret 0
    else age_lte 12:
        ret 40
    else age_gte 65:
        ret 50
    else:
        ret 90
    end
end

func main:
    println ticket(2), ticket(9), ticket(30), ticket(70)
