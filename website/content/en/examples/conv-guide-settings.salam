import conv
import str

func main throws:
    raw := HashMap {} as HashMap<str, str>
    defer raw.Free()
    raw.Put("debug", " yes ")
    raw.Put("cache", "0")
    raw.Put("accent", "#1E90FF")
    raw.Put("limit", "۲۵۰")
    raw.Put("compress", "Yes")
    debug := try conv.ParseBool(raw.Get("debug"))
    cache := try conv.ParseBool(raw.Get("cache"))
    compress := conv.ParseBoolOr(raw.Get("compress"), false)
    color := try conv.ParseHex(str.TrimPrefix(raw.Get("accent"), "#"))
    limit := try conv.Atoi(raw.Get("limit"))
    println "debug:", conv.FormatBool(debug), "cache:", conv.FormatBool(cache), "compress:", conv.FormatBool(compress)
    println "red:", color >> 16, "green:", (color >> 8) & 255, "blue:", color & 255
    println "limit doubled:", limit * 2
    println "accent back to hex:", conv.FormatHex(color as u64)
end
