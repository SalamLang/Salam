import conv

func main:
    each typed in ["42", " ۱۴۰۳ ", "+7", "12abc", "", "-0015", "99999999999999999999"]:
        try:
            n := conv.ParseInt(typed)
            println "[" + typed + "]", "->", n
        catch e:
            println "[" + typed + "]", "rejected:", e.message, "at column", e.column
        end
    end
end
