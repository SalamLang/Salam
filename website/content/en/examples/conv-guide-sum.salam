import conv
import str

func main throws:
    line := "۱۲ 7 ٣٠ 4.5 ۰٫۵"
    parts := str.Fields(line)
    defer parts.Free()
    mut whole := 0 as i64
    mut exact := 0.0
    each p in parts:
        whole += conv.ParseIntOr(p, 0)
        exact += try conv.ParseFloat(p)
    end
    println "numbers:", parts.Len()
    println "sum of whole parts:", whole
    println "exact sum:", conv.FormatFloatShort(exact)
end
