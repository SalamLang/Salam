import core

func next_light(light: str): str:
    switch light:
        "red":
            ret "green"
        end
        "green":
            ret "yellow"
        end
        "yellow":
            ret "red"
        end
    end
    core.Panic("unknown light: " + light)
end

func main:
    mut light := "red"
    repeat 4:
        nxt := next_light(light)
        println light, "->", nxt
        light = nxt
    end
end
