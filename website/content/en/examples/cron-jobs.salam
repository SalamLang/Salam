import mem
import time
import cron

mut hits := null as i64*

func tick(_id: i64):
    atomic_add(hits, 1 as i64)
end

func wait():
    mut waited := 0
    until atomic_load(hits) == (0 as i64) and waited < 200:
        time.Sleep(10)
        waited++
    end
    repeat cron.Total() in i:
        until cron.IsBusy(i) and waited < 400:
            time.Sleep(10)
            waited++
        end
    end
end

func main:
    hits = mem.AllocateZeroed(8 as u64) as i64*
    cron.SetZone("Invalid/Nowhere", 0)

    daily := cron.DailyAt("report", "10:30", tick)
    weekly := cron.WeeklyAt("backup", "mon-fri", "02:00:15", tick)
    cron.SetTags(weekly, "ops,nightly")
    cron.Once("launch", 1792900000 as i64, tick)
    limited := cron.Add("limited", "*/5 * * * * *", tick)
    cron.Limit(limited, 1)

    println "next daily", cron.NextRun(daily, 1792800300 as i64)
    println "next weekly", cron.NextRun(weekly, 1792800300 as i64)
    println "next limited", cron.NextRun(limited, 1792800300 as i64)
    println "found", cron.Find("backup") == weekly, "tagged", cron.HasTag(weekly, "ops")

    println "launch", cron.RunDue(1792900000 as i64)
    wait()
    println "removed by tag", cron.RemoveByTag("ops"), "left", cron.Count()
end
