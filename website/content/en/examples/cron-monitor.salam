import mem
import time
import cron

mut zero := 0
mut heard := null as i64*

func steady(_id: i64):
    time.Sleep(5)
end

func crash(_id: i64):
    println 10 / zero
end

func spoke(id: i64):
    atomic_add(heard, 1 as i64)
    println "panic in job", cron.Name(id as int)
end

func main:
    heard = mem.AllocateZeroed(8 as u64) as i64*
    cron.SetZone("Invalid/Nowhere", 0)
    cron.OnPanic(spoke)

    ok := cron.Add("steady", "* * * * *", steady)
    bad := cron.Add("crash", "* * * * *", crash)
    cron.RunDue(1792900200 as i64)

    mut waited := 0
    until (cron.IsBusy(ok) or cron.IsBusy(bad)) and waited < 300:
        time.Sleep(10)
        waited += 1
    end

    println "still alive, panics", cron.Panics(bad), "heard", atomic_load(heard)
    println cron.LastPanic()
    println "runs", cron.Runs(ok), cron.Runs(bad), "running", cron.Running()
    println cron.Metrics().len() > 0
end
