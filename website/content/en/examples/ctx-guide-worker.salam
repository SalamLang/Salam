import ctx
import sync

mut root := ctx.Background()
mut job := ctx.WithCancel(root)
mut wg := sync.NewWaitGroup()
mut finished := false

func worker():
    until ctx.IsDone(job):
        _ := ctx.Wait(job, 100)
    end
    finished = true
    sync.Done(wg)
end

func main:
    sync.Add(wg, 1)
    t := spawn(worker)
    sync.SleepMs(50)
    println "asking the worker to stop"
    ctx.Cancel(job)
    sync.Wait(wg)
    join(t)
    println "worker finished:", finished, "reason:", ctx.Err(job)

    sync.DestroyWaitGroup(wg)
    ctx.Free(job)
    ctx.Free(root)
end
