import db.postgres
import os

func main:
    d := postgres.Open(os.Env("DATABASE_URL"))
    defer postgres.Close(d)
    if not postgres.Ok(d):
        print "database: " + postgres.Error(d)
        ret 1
    end
    println "database", postgres.DatabaseName(d), "on", postgres.HostName(d), "as", postgres.UserName(d)
    println postgres.QueryInt(d, "SELECT count(*) FROM books"), "books"
end
