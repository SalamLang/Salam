SELECT id, name FROM users WHERE email = ? AND age > ?
  statement: select on users
  param 1 is email of type str
  param 2 is age of type option.Option<i64>
  column id comes back as i64
  column name comes back as option.Option<str>
INSERT INTO users (email, name) VALUES (?, ?) RETURNING id
  statement: insert on users
  param 1 is email of type str
  param 2 is name of type option.Option<str>
  column id comes back as i64
