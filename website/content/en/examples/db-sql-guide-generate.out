queries: 2
package store

import db
import db.sql
import mem
import option

struct GetUserRow:
    pub id: i64 = 0 as i64
    pub email: str = ""
    pub name: option.Option<str> = option.None() as option.Option<str>
end

func fill_query(c: dyn db.Connection, raw: str, a: sql.Args): str:
    mut rep := sql.Report {}
    out := sql.Fill(raw, a, sql.DialectNamed(c.Kind()), rep)
    sql.FreeReport(rep)
    ret out
end

pub func GetUser(c: dyn db.Connection, email: str, ok &: bool): GetUserRow:
    mut a := sql.NewArgs()
    sql.AddText(a, email)
    q := fill_query(c, "SELECT id, email, name FROM users WHERE email = ?", a)
    sql.FreeArgs(a)
    mut out := GetUserRow {}
    ok = false
    r := c.Query(q)
    if r.Ok():
        if r.Next():
            out.id = r.Int64(0)
            out.email = r.Text(1)
            if r.IsNull(2):
                out.name = option.None() as option.Option<str>
            else:
                out.name = option.Some(r.Text(2))
            end
            ok = true
        end
        r.Close()
    end
    mem.Free(q as void*)
    ret out
end

pub func CreateUser(c: dyn db.Connection, email: str, name: str): bool:
    mut a := sql.NewArgs()
    sql.AddText(a, email)
    sql.AddText(a, name)
    q := fill_query(c, "INSERT INTO users (email, name) VALUES (?, ?)", a)
    sql.FreeArgs(a)
    done := c.Exec(q) == 0
    mem.Free(q as void*)
    ret done
end

