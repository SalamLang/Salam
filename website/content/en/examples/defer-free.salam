func average reading(raw: int[]): int:
    mut valid := Vector {} as Vector<int>
    defer valid.free()
    each r in raw:
        if r >= 0:
            valid.push(r)
        end
    end
    if valid.len() == 0:
        ret 0
    end
    mut sum := 0
    each v in valid:
        sum += v
    end
    ret sum / valid.len()
end

func main:
    println average reading([21, -1, 23, 25, -1])
    println average reading([-1, -1])
end
