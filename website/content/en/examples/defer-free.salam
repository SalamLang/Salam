func average_reading(raw: int[]): int:
    mut valid := Vector {} as Vector<int>
    defer valid.Free()
    each r in raw:
        if r >= 0:
            valid.Push(r)
        end
    end
    if valid.Len() == 0:
        ret 0
    end
    mut sum := 0
    each v in valid:
        sum += v
    end
    ret sum / valid.Len()
end

func main:
    println average_reading([21, -1, 23, 25, -1])
    println average_reading([-1, -1])
end
