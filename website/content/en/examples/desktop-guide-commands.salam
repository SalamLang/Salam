import gui.desktop
import encoding.json
import sync

func main:
    desktop.Init(desktop.Config { id = "com.example.notes", name = "Notes", assets_dir = "www" })
    desktop.Command("add", (c: desktop.Call):
        if not c.Has("a") or not c.Has("b"):
            c.Reject("a and b are required")
            ret
        end
        c.ResolveInt(c.Int("a") + c.Int("b"))
    end)
    desktop.CommandAsync("report", (c: desktop.Call):
        name := c.Str("name")
        sync.SleepMs(1500)
        c.Resolve(`{"name":` + `"` + json.Escape(name) + `"` + `,"pages":12}`)
    end)
    desktop.On("save", (data: str):
        desktop.Dispatch(():
            desktop.Emit("saved", data)
        end)
    end)
    win := desktop.Open(desktop.WindowOptions { title = "Notes", width = 900, height = 600 })
    if win.IsClosed():
        println desktop.LastError()
        ret 1
    end
    desktop.Run()
end
