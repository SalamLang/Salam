import gui.desktop

func main:
    desktop.Init(desktop.Config { id = "com.example.portal", name = "Portal" })
    mut allowed := Vector {} as Vector<str>
    allowed.push("pick_folder")
    desktop.Allow("https://app.example.com", allowed)
    desktop.Command("pick_folder", (c: desktop.Call):
        c.ResolveStr(desktop.PickFolder("Choose a folder"))
    end)
    win := desktop.Open(desktop.WindowOptions { title = "Portal", url = "https://app.example.com/" })
    win.OnCrash((): win.Navigate(desktop.AssetURL("/error.html")) end)
    desktop.Run()
end
