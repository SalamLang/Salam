import gui.desktop

func main:
    desktop.Init(desktop.Config { id = "com.example.notes", name = "Notes", assets_dir = "www" })
    win := desktop.Open(desktop.WindowOptions { title = "Notes" })
    keep := desktop.SingleInstance((args: Vector<str>):
        println "second start with", args.len(), "arguments"
        desktop.GetWindow("main").Focus()
    end)
    if not keep:
        ret 0
    end
    desktop.Command("choose_folder", (c: desktop.Call):
        c.ResolveStr(desktop.PickFolder("Choose a folder"))
    end)
    desktop.Command("sign_in", (c: desktop.Call):
        ok := desktop.SecretSet("token", c.Str("token"))
        c.ResolveBool(ok)
    end)
    desktop.Command("token", (c: desktop.Call):
        c.ResolveStr(desktop.SecretGet("token"))
    end)
    desktop.Command("done", (c: desktop.Call):
        desktop.Notify("Notes", "Your export is ready")
        desktop.RequestAttention(win)
        c.ResolveNull()
    end)
    desktop.OnTrayClick(():
        win.Show()
        win.Focus()
    end)
    mut tray := Vector {} as Vector<desktop.MenuItem>
    tray.push(desktop.Item("quit", "Quit"))
    desktop.SetTray("icon.png", "Notes", tray)
    desktop.Run()
end
