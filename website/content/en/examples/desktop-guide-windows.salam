import gui.desktop

func main:
    desktop.Init(desktop.Config { id = "com.example.notes", name = "Notes", assets_dir = "www" })
    main_win := desktop.Open(desktop.WindowOptions { label = "main", title = "Notes", width = 900, height = 600, min_width = 480, min_height = 320 })
    main_win.OnClose(():
        ret desktop.Confirm("Notes", "Close the notes window?")
    end)
    main_win.OnResize((w: int, h: int):
        println "size", w, h
    end)
    desktop.Command("open_help", (c: desktop.Call):
        help := desktop.Open(desktop.WindowOptions { label = "help", title = "Help", width = 520, height = 420, html = "<h1>Help</h1>" })
        help.Emit("hello", `{"from":"main"}`)
        c.ResolveNull()
    end)
    desktop.OnMenu((id: str):
        if id == "help":
            desktop.GetWindow("main").Emit("menu", `"help"`)
        end
        if id == "quit":
            desktop.Quit()
        end
    end)
    mut items := Vector {} as Vector<desktop.MenuItem>
    items.push(desktop.Item("help", "Help"))
    items.push(desktop.Separator())
    items.push(desktop.Item("quit", "Quit"))
    desktop.SetMenu(main_win, items)
    desktop.Run()
end
