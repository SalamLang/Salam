import dom

mut left := 10
mut timer := 0 as i64
mut label := 0 as i64

func main:
    label = dom.Create("h1")
    dom.Append(dom.Body(), label)
    dom.SetText(label, "" + left)
    timer = dom.SetInterval(():
        left -= 1
        dom.SetText(label, "" + left)
        if left == 0:
            dom.ClearInterval(timer)
            dom.SetText(label, "Time is up")
            dom.SetStyle(label, "color", "crimson")
            dom.Tone(660, 300)
        end
    end, 1000)
end
