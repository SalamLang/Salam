import dom
import str

func filter(rows: i64, word: str, counter: i64):
    mut shown := 0
    repeat dom.CountOf(rows) in i:
        row := dom.ItemAt(rows, i)
        name := str.Lower(dom.GetText(row))
        if word.len() == 0 or str.Contains(name, word):
            dom.SetStyle(row, "display", "")
            shown += 1
        else:
            dom.SetStyle(row, "display", "none")
        end
    end
    dom.SetText(counter, shown + " of " + dom.CountOf(rows) + " products")
end

func main:
    if not (dom.Exists("search") and dom.Exists("count")):
        println "this script needs #search and #count on the page"
        ret
    end
    search := dom.ById("search")
    counter := dom.ById("count")
    rows := dom.QueryAll("#products tr")
    if dom.CountOf(rows) == 0:
        dom.SetText(counter, "no products")
        ret
    end
    dom.SetStyle(dom.Query("#products"), "background-color", "#fafafa")
    dom.OnEvent(search, "input", ():
        filter(rows, str.Lower(str.Trim(dom.GetValue(search))), counter)
    end)
    filter(rows, "", counter)
end
