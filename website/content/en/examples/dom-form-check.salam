import dom
import str

mut email := 0 as i64
mut password := 0 as i64
mut submit := 0 as i64
mut note := 0 as i64

func check():
    e := dom.GetValue(email)
    p := dom.GetValue(password)
    mut problem := ""
    if not str.Contains(e, "@"):
        problem = "Enter an email address."
    else p.len() < 8:
        problem = "The password needs at least 8 characters."
    end
    dom.SetText(note, problem)
    dom.SetBool(submit, "disabled", problem.len() > 0)
    if problem.len() > 0:
        dom.AddClass(note, "error")
    else:
        dom.RemoveClass(note, "error")
    end
end

func main:
    email = dom.Create("input")
    dom.SetAttr(email, "type", "email")
    password = dom.Create("input")
    dom.SetAttr(password, "type", "password")
    submit = dom.Create("button")
    dom.SetText(submit, "Sign up")
    note = dom.Create("p")
    each el in [email, password, submit, note]:
        dom.Append(dom.Body(), el)
    end
    dom.OnEvent(email, "input", ():
        check()
    end)
    dom.OnEvent(password, "input", ():
        check()
    end)
    dom.OnEvent(submit, "click", ():
        dom.Alert("Welcome, " + dom.GetValue(email))
    end)
    check()
end
