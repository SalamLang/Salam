import dom

mut list := 0 as i64
mut entry := 0 as i64
mut added := 0

func add_item(text: str):
    item := dom.Create("li")
    dom.SetText(item, text)
    dom.OnEvent(item, "click", ():
        dom.ToggleClass(item, "done")
    end)
    dom.Append(list, item)
    added += 1
    dom.StoreSetInt("todo-added", added as i64)
end

func main:
    dom.SetTitle("To do")
    entry = dom.Create("input")
    dom.SetAttr(entry, "placeholder", "What needs doing?")
    button := dom.Create("button")
    dom.SetText(button, "Add")
    list = dom.Create("ul")
    dom.Append(dom.Body(), entry)
    dom.Append(dom.Body(), button)
    dom.Append(dom.Body(), list)

    dom.OnEvent(button, "click", ():
        text := dom.GetValue(entry)
        if text.len() > 0:
            add_item(text)
            dom.SetValue(entry, "")
        end
    end)
    dom.OnEventE(entry, "keydown", (e: i64):
        if dom.EventKey(e) == "Enter":
            dom.PreventDefault(e)
            text := dom.GetValue(entry)
            if text.len() > 0:
                add_item(text)
                dom.SetValue(entry, "")
            end
        end
    end)
    println "items added on this device so far:", dom.StoreGetInt("todo-added")
end
