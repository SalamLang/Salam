page:
    design = "shadcn"
    margin = 16
    box:
        gap = 12
        max width = 480
        alert:
            alert title:
                content = "Heads up"
            end
            alert description:
                content = "You can add components to your page with the alert element."
            end
        end
        alert:
            variant = "destructive"
            alert title:
                content = "Payment failed"
            end
            alert description:
                content = "Check your card details and try again."
            end
        end
    end
end
