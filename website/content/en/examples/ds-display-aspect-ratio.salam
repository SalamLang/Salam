page:
    design = "shadcn"
    margin = 16
    box:
        layout = "row"
        gap = 16
        align = "start"
        box:
            width = 240
            aspect ratio:
                ratio = "16/9"
                box:
                    height = 100%
                    background = "#93c5fd"
                    align = "center"
                    justify = "center"
                    span:
                        content = "16/9"
                    end
                end
            end
        end
        box:
            width = 120
            aspect ratio:
                ratio = "1/1"
                box:
                    height = 100%
                    background = "#86efac"
                    align = "center"
                    justify = "center"
                    span:
                        content = "1/1"
                    end
                end
            end
        end
    end
end
