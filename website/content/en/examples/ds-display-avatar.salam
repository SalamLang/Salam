page:
    design = "shadcn"
    margin = 16
    box:
        gap = 16
        box:
            layout = "row"
            gap = 12
            align = "center"
            avatar:
                size = "sm"
                avatar fallback:
                    content = "SM"
                end
            end
            avatar:
                avatar fallback:
                    content = "AB"
                end
            end
            avatar:
                size = "lg"
                avatar fallback:
                    content = "LG"
                end
            end
            avatar:
                avatar image:
                    url = "missing.png"
                    alt = "Missing"
                end
                avatar fallback:
                    content = "FB"
                end
                avatar badge:
                end
            end
        end
        avatar group:
            avatar:
                avatar fallback:
                    content = "AL"
                end
            end
            avatar:
                avatar fallback:
                    content = "BO"
                end
            end
            avatar:
                avatar fallback:
                    content = "CY"
                end
            end
            avatar group count:
                content = "+3"
            end
        end
    end
end
