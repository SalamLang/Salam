page:
    margin = 16
    box:
        layout = "row"
        wrap = true
        gap = 8
        badge:
            content = "Default"
        end
        badge:
            variant = "secondary"
            content = "Secondary"
        end
        badge:
            variant = "destructive"
            content = "Destructive"
        end
        badge:
            variant = "outline"
            content = "Outline"
        end
        badge:
            variant = "ghost"
            content = "Ghost"
        end
        badge:
            variant = "link"
            content = "Link"
        end
        badge:
            url = "#"
            variant = "outline"
            content = "As a link"
        end
    end
end
