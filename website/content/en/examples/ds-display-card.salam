page:
    design = "shadcn"
    margin = 16
    box:
        max width = 360
        card:
            card header:
                card title:
                    content = "Team plan"
                end
                card description:
                    content = "Billed monthly"
                end
                card action:
                    badge:
                        variant = "secondary"
                        content = "Popular"
                    end
                end
            end
            card content:
                paragraph:
                    content = "Ten seats, unlimited projects and priority support."
                end
            end
            card footer:
                button:
                    content = "Choose plan"
                end
            end
        end
    end
end
