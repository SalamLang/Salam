page:
    design = "shadcn"
    margin = 16
    box:
        max width = 420
        empty:
            empty header:
                empty media:
                    variant = "icon"
                    span:
                        content = "+"
                    end
                end
                empty title:
                    content = "No projects yet"
                end
                empty description:
                    content = "Create your first project to get started."
                end
            end
            empty content:
                button:
                    content = "New project"
                end
            end
        end
    end
end
