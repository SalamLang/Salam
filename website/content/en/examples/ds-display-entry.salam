page:
    design = "shadcn"
    margin = 16
    box:
        max width = 440
        entry group:
            entry:
                entry media:
                    variant = "icon"
                    span:
                        content = "A"
                    end
                end
                entry content:
                    entry title:
                        content = "Default entry"
                    end
                    entry description:
                        content = "The plain look, with an icon."
                    end
                end
                entry actions:
                    button:
                        size = "sm"
                        variant = "outline"
                        content = "Open"
                    end
                end
            end
            entry:
                variant = "outline"
                entry content:
                    entry title:
                        content = "Outline entry"
                    end
                    entry description:
                        content = "Has a border."
                    end
                end
            end
            entry:
                variant = "muted"
                size = "sm"
                entry content:
                    entry title:
                        content = "Muted and small"
                    end
                end
            end
            entry:
                url = "#"
                variant = "outline"
                entry content:
                    entry title:
                        content = "A whole entry as a link"
                    end
                end
            end
            entry:
                entry header:
                    entry title:
                        content = "Header, separator and footer"
                    end
                end
                entry separator:
                end
                entry content:
                    entry description:
                        content = "The body sits between them."
                    end
                end
                entry footer:
                    entry description:
                        content = "Footer note"
                    end
                end
            end
        end
    end
end
