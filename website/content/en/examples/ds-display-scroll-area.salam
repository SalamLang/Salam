page:
    design = "shadcn"
    margin = 16
    box:
        layout = "row"
        gap = 16
        scroll area:
            height = 120
            width = 220
            paragraph:
                content = "Line 1. Scroll down to read the rest."
            end
            paragraph:
                content = "Line 2"
            end
            paragraph:
                content = "Line 3"
            end
            paragraph:
                content = "Line 4"
            end
            paragraph:
                content = "Line 5"
            end
            paragraph:
                content = "Line 6"
            end
            paragraph:
                content = "Line 7"
            end
            paragraph:
                content = "Line 8"
            end
        end
        scroll area:
            orientation = "horizontal"
            width = 220
            box:
                width = 600
                height = 60
                background = "#93c5fd"
                paragraph:
                    content = "A wide strip: scroll sideways."
                end
            end
        end
    end
end
