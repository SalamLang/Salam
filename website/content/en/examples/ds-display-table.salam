page:
    design = "shadcn"
    margin = 16
    box:
        max width = 460
        table:
            caption:
                content = "Last orders"
            end
            header:
                row:
                    column:
                        content = "Order"
                    end
                    column:
                        content = "Status"
                    end
                    column:
                        content = "Total"
                    end
                end
            end
            main:
                row:
                    column:
                        content = "#1001"
                    end
                    column:
                        content = "Paid"
                    end
                    column:
                        content = "$25"
                    end
                end
                row:
                    selected = true
                    column:
                        content = "#1002"
                    end
                    column:
                        content = "Pending"
                    end
                    column:
                        content = "$40"
                    end
                end
                row:
                    column:
                        content = "#1003"
                    end
                    column:
                        content = "Paid"
                    end
                    column:
                        content = "$15"
                    end
                end
            end
            footer:
                row:
                    column:
                        content = "Total"
                    end
                    column:
                    end
                    column:
                        content = "$80"
                    end
                end
            end
        end
    end
end
