page:
    margin = 16
    box:
        max width = 520
        typography:
            heading:
                level = 1
                content = "The garden"
            end
            paragraph:
                class = "lead"
                content = "A short note about growing things."
            end
            heading:
                level = 2
                content = "Soil first"
            end
            paragraph:
                content = "Good soil holds water and lets roots breathe."
            end
            code:
                content = "compost.add(spring)"
            end
            block quote:
                content = "A garden is never finished."
            end
            list:
                item:
                    content = "Water early"
                end
                item:
                    content = "Mulch in summer"
                end
            end
            paragraph:
                class = "small"
                content = "Small print"
            end
            paragraph:
                class = "muted"
                content = "Muted text"
            end
        end
    end
end
