    box:
        layout = "row"
        gap = 16
        padding = 16
        wrap = true
        calendar:
            mode = "single"
            value = "2026-11-18"
        end
        calendar:
            mode = "range"
            value = "2026-11-10/2026-11-16"
        end
        calendar:
