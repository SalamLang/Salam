page:
    design = "shadcn"
    title = "Calendar, several dates"
    box:
        layout = "row"
        gap = 16
        padding = 16
        min height = 420
        wrap = true
        calendar:
            mode = "multiple"
            value = "2026-11-18,2026-11-20"
        end
        calendar:
            calendar = "jalali"
            mode = "multiple"
            value = "2026-03-21,2026-03-25"
        end
        date picker:
            name = "days"
            mode = "multiple"
            placeholder = "Pick some days"
        end
    end
end
