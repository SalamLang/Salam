page:
    design = "shadcn"
    title = "Vertical carousel"
    box:
        padding = 16
        max width = 300
        carousel:
            orientation = "vertical"
            autoplay = 3000
            carousel content:
                height = 130
                carousel item:
                    paragraph:
                        content = "First: the slides move up and down."
                    end
                end
                carousel item:
                    paragraph:
                        content = "Second: autoplay pauses on hover."
                    end
                end
                carousel item:
                    paragraph:
                        content = "Third: arrow keys also work."
                    end
                end
            end
            carousel previous:
            end
            carousel next:
            end
        end
    end
end
