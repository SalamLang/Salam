page:
    title = "Carousel"
    box:
        padding = 56
        max width = 420
        carousel:
            dots = true
            loop = true
            carousel content:
                carousel item:
                    box:
                        height = 140
                        border = 1, "solid", "#a1a1aa"
                        radius = 8
                        align = "center"
                        paragraph:
                            content = "Slide 1"
                        end
                    end
                end
                carousel item:
                    box:
                        height = 140
                        border = 1, "solid", "#a1a1aa"
                        radius = 8
                        align = "center"
                        paragraph:
                            content = "Slide 2"
                        end
                    end
                end
                carousel item:
                    box:
                        height = 140
                        border = 1, "solid", "#a1a1aa"
                        radius = 8
                        align = "center"
                        paragraph:
                            content = "Slide 3"
                        end
                    end
                end
            end
            carousel previous:
            end
            carousel next:
            end
        end
    end
end
