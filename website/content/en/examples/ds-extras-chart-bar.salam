page:
    design = "shadcn"
    title = "Bar chart"
    box:
        padding = 16
        max width = 560
        chart:
            type = "bar"
            label = "Visitors per month"
            legend = true
            chart series:
                label = "Desktop"
                chart point:
                    label = "Jan"
                    value = "186"
                end
                chart point:
                    label = "Feb"
                    value = "305"
                end
                chart point:
                    label = "Mar"
                    value = "237"
                end
                chart point:
                    label = "Apr"
                    value = "173"
                end
            end
            chart series:
                label = "Mobile"
                chart point:
                    label = "Jan"
                    value = "80"
                end
                chart point:
                    label = "Feb"
                    value = "200"
                end
                chart point:
                    label = "Mar"
                    value = "120"
                end
                chart point:
                    label = "Apr"
                    value = "190"
                end
            end
        end
    end
end
