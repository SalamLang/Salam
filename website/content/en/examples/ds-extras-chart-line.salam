page:
    design = "shadcn"
    title = "Line and area charts"
    box:
        layout = "row"
        gap = 16
        padding = 16
        wrap = true
        box:
            width = 320
            chart:
                type = "line"
                chart height = 200
                label = "Line chart"
                chart series:
                    label = "Revenue"
                    chart point:
                        label = "Jan"
                        value = "120"
                    end
                    chart point:
                        label = "Feb"
                        value = "180"
                    end
                    chart point:
                        label = "Mar"
                        value = "150"
                    end
                    chart point:
                        label = "Apr"
                        value = "260"
                    end
                end
            end
        end
        box:
            width = 320
            chart:
                type = "area"
                chart height = 200
                stacked = true
                legend = true
                grid = "false"
                label = "Stacked area chart"
                chart series:
                    label = "Web"
                    chart point:
                        label = "Jan"
                        value = "120"
                    end
                    chart point:
                        label = "Feb"
                        value = "180"
                    end
                    chart point:
                        label = "Mar"
                        value = "150"
                    end
                    chart point:
                        label = "Apr"
                        value = "260"
                    end
                end
                chart series:
                    label = "App"
                    tint = "var(--chart-3)"
                    chart point:
                        label = "Jan"
                        value = "60"
                    end
                    chart point:
                        label = "Feb"
                        value = "90"
                    end
                    chart point:
                        label = "Mar"
                        value = "110"
                    end
                    chart point:
                        label = "Apr"
                        value = "80"
                    end
                end
            end
        end
    end
end
