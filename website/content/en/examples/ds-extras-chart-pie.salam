page:
    design = "shadcn"
    title = "Pie and donut charts"
    box:
        layout = "row"
        gap = 16
        padding = 16
        wrap = true
        box:
            width = 260
            chart:
                type = "pie"
                chart height = 220
                legend = true
                label = "Browsers"
                chart series:
                    chart point:
                        label = "Chrome"
                        value = "275"
                    end
                    chart point:
                        label = "Safari"
                        value = "200"
                    end
                    chart point:
                        label = "Firefox"
                        value = "120"
                        tint = "#7c3aed"
                    end
                end
            end
        end
        box:
            width = 260
            chart:
                type = "donut"
                chart height = 220
                legend = true
                center = "Visitors"
                label = "Browsers"
                chart series:
                    chart point:
                        label = "Chrome"
                        value = "275"
                    end
                    chart point:
                        label = "Safari"
                        value = "200"
                    end
                    chart point:
                        label = "Firefox"
                        value = "120"
                        tint = "#7c3aed"
                    end
                end
            end
        end
    end
end
