page:
    title = "Combobox"
    box:
        layout = "row"
        gap = 12
        padding = 16
        min height = 280
        combobox:
            name = "framework"
            placeholder = "Select framework..."
            search placeholder = "Search framework..."
            empty text = "No framework found."
            combobox item:
                value = "next"
                content = "Next.js"
            end
            combobox item:
                value = "svelte"
                content = "SvelteKit"
            end
            combobox item:
                value = "nuxt"
                content = "Nuxt"
            end
            combobox item:
                value = "remix"
                disabled = true
                content = "Remix"
            end
        end
        combobox:
            name = "city"
            value = "oslo"
            clearable = true
            placeholder = "Pick a city"
            combobox item:
                value = "oslo"
                content = "Oslo"
            end
            combobox item:
                value = "lima"
                content = "Lima"
            end
            combobox item:
                value = "kyoto"
                content = "Kyoto"
            end
        end
    end
end
