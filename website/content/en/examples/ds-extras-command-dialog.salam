page:
    title = "Command dialog"
    box:
        padding = 16
        button:
            variant = "outline"
            opens = "palette"
            content = "Open the palette (Ctrl K)"
        end
    end
    command dialog:
        id = "palette"
        hotkey = "k"
        command:
            command input:
                placeholder = "Type a command..."
            end
            command list:
                command empty:
                    content = "No results found."
                end
                command group:
                    heading = "Go to"
                    command item:
                        value = "home"
                        content = "Home"
                    end
                    command item:
                        value = "docs"
                        content = "Documentation"
                    end
                    command item:
                        value = "settings"
                        content = "Settings"
                    end
                end
            end
        end
    end
end
