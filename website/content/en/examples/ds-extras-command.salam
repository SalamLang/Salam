page:
    title = "Command"
    box:
        padding = 16
        max width = 380
        command:
            command input:
                placeholder = "Type a command or search..."
            end
            command list:
                command empty:
                    content = "No results found."
                end
                command group:
                    heading = "Suggestions"
                    command item:
                        value = "calendar"
                        keywords = "date schedule"
                        content = "Calendar"
                    end
                    command item:
                        value = "search"
                        content = "Search emoji"
                    end
                    command item:
                        value = "calculator"
                        disabled = true
                        content = "Calculator"
                    end
                end
                command separator:
                end
                command group:
                    heading = "Settings"
                    command item:
                        value = "profile"
                        content = "Profile"
                        command shortcut:
                            content = "Ctrl P"
                        end
                    end
                    command item:
                        value = "billing"
                        content = "Billing"
                        command shortcut:
                            content = "Ctrl B"
                        end
                    end
                end
            end
        end
    end
end
