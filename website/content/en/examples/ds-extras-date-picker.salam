page:
    title = "Date picker"
    box:
        layout = "row"
        gap = 12
        padding = 16
        min height = 380
        date picker:
            name = "birthday"
            placeholder = "Pick a date"
        end
        date picker:
            name = "trip"
            mode = "range"
            placeholder = "Pick a range"
        end
        date picker:
            name = "when"
            calendar = "jalali"
            value = "2026-11-18"
        end
    end
end
