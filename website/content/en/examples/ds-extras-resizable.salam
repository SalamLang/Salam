page:
    design = "shadcn"
    title = "Resizable"
    box:
        padding = 16
        resizable:
            height = 260
            border = 1, "solid", "#a1a1aa"
            radius = 8
            resizable panel:
                size = 30
                min size = 15
                box:
                    padding = 16
                    paragraph:
                        content = "Sidebar"
                    end
                end
            end
            resizable handle:
                grip = true
            end
            resizable panel:
                resizable:
                    orientation = "vertical"
                    resizable panel:
                        size = 40
                        box:
                            padding = 16
                            paragraph:
                                content = "Top"
                            end
                        end
                    end
                    resizable handle:
                        grip = true
                    end
                    resizable panel:
                        max size = 80
                        box:
                            padding = 16
                            paragraph:
                                content = "Bottom"
                            end
                        end
                    end
                end
            end
        end
    end
end
