page:
    design = "shadcn"
    title = "Select box"
    box:
        layout = "row"
        gap = 12
        padding = 16
        min height = 300
        select box:
            name = "fruit"
            select trigger:
                content = "Select a fruit"
            end
            select content:
                select group:
                    heading = "Fruits"
                    select item:
                        value = "apple"
                        content = "Apple"
                    end
                    select item:
                        value = "banana"
                        content = "Banana"
                    end
                    select item:
                        value = "kiwi"
                        disabled = true
                        content = "Kiwi"
                    end
                end
                select separator:
                end
                select group:
                    heading = "Vegetables"
                    select item:
                        value = "carrot"
                        content = "Carrot"
                    end
                    select item:
                        value = "pea"
                        content = "Pea"
                    end
                end
            end
        end
        select box:
            name = "size"
            value = "m"
            select trigger:
                size = "sm"
                content = "Size"
            end
            select content:
                select item:
                    value = "s"
                    content = "Small"
                end
                select item:
                    value = "m"
                    content = "Medium"
                end
                select item:
                    value = "l"
                    content = "Large"
                end
            end
        end
        select box:
            disabled = true
            select trigger:
                content = "Disabled"
            end
            select content:
                select item:
                    value = "x"
                    content = "X"
                end
            end
        end
    end
end
