page:
    title = "Sidebar parts"
    sidebar provider:
        height = 260
        sidebar panel:
            collapsible = "icon"
            sidebar rail:
            end
            sidebar content:
                sidebar group:
                    sidebar group content:
                        sidebar menu:
                            sidebar menu item:
                                sidebar menu button:
                                    active = true
                                    tooltip = "Back to the start"
                                    svg:
                                        content = "<circle cx='8' cy='8' r='6' fill='currentColor'/>"
                                    end
                                    content = "Home"
                                end
                            end
                            sidebar menu item:
                                open = true
                                sidebar menu button:
                                    svg:
                                        content = "<rect x='2' y='2' width='12' height='12' rx='3' fill='currentColor'/>"
                                    end
                                    content = "Projects"
                                end
                                sidebar menu sub:
                                    sidebar menu sub item:
                                        sidebar menu sub button:
                                            active = true
                                            url = "#alpha"
                                            content = "Alpha"
                                        end
                                    end
                                    sidebar menu sub item:
                                        sidebar menu sub button:
                                            size = "sm"
                                            url = "#beta"
                                            content = "Beta"
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        sidebar inset:
            box:
                padding = 12
                sidebar trigger:
                end
                paragraph:
                    content = "Collapse the panel, then hover an icon for its tooltip. The thin strip on the panel edge toggles it too."
                end
            end
        end
    end
end
