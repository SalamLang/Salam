page:
    design = "shadcn"
    title = "Sidebar"
    sidebar provider:
        height = 340
        sidebar panel:
            collapsible = "icon"
            sidebar header:
                paragraph:
                    content = "Acme Inc"
                end
            end
            sidebar content:
                sidebar group:
                    sidebar group label:
                        content = "Application"
                    end
                    sidebar group content:
                        sidebar menu:
                            sidebar menu item:
                                sidebar menu button:
                                    active = true
                                    url = "#home"
                                    content = "Home"
                                end
                            end
                            sidebar menu item:
                                sidebar menu button:
                                    url = "#inbox"
                                    content = "Inbox"
                                end
                                sidebar menu badge:
                                    content = "12"
                                end
                            end
                            sidebar menu item:
                                sidebar menu button:
                                    variant = "outline"
                                    size = "sm"
                                    url = "#search"
                                    content = "Search"
                                end
                            end
                        end
                    end
                end
            end
            sidebar separator:
            end
            sidebar footer:
                paragraph:
                    content = "Ali Rezaei"
                end
            end
        end
        sidebar inset:
            box:
                padding = 12
                sidebar trigger:
                end
                paragraph:
                    content = "Press the button, or Ctrl B, to collapse the panel."
                end
            end
        end
    end
end
