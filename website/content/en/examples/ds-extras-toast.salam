page:
    design = "shadcn"
    title = "Toast"
    toaster:
        placement = "bottom right"
    end
    box:
        layout = "row"
        gap = 8
        padding = 16
        wrap = true
        button:
            variant = "outline"
            toast = "Event created"
            content = "Default"
        end
        button:
            variant = "outline"
            toast = "Saved"
            toast description = "Your changes are stored."
            toast variant = "success"
            content = "Success"
        end
        button:
            variant = "outline"
            toast = "Upload failed"
            toast description = "Check the connection and try again."
            toast variant = "error"
            content = "Error"
        end
        button:
            variant = "outline"
            toast = "Low disk space"
            toast variant = "warning"
            content = "Warning"
        end
        button:
            variant = "outline"
            toast = "A new version is out"
            toast variant = "info"
            content = "Info"
        end
    end
end
