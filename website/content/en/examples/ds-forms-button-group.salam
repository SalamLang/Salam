page:
    title = "Button group"
    margin = 1.5rem
    box:
        gap = 12
        button group:
            button:
                variant = "outline"
                content = "Day"
            end
            button:
                variant = "outline"
                content = "Week"
            end
            button:
                variant = "outline"
                content = "Month"
            end
        end
        button group:
            orientation = "vertical"
            button:
                variant = "outline"
                content = "Top"
            end
            button:
                variant = "outline"
                content = "Middle"
            end
            button:
                variant = "outline"
                content = "Bottom"
            end
        end
        button group:
            button group text:
                content = "https://"
            end
            input:
                placeholder = "domain"
            end
            button group separator:
            end
            button:
                variant = "outline"
                content = "Go"
            end
        end
    end
end
