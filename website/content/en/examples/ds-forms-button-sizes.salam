page:
    design = "shadcn"
    title = "Button sizes"
    margin = 1.5rem
    box:
        layout = "row"
        gap = 8
        wrap = true
        align = "center"
        button:
            size = "xs"
            content = "Extra small"
        end
        button:
            size = "sm"
            content = "Small"
        end
        button:
            content = "Default"
        end
        button:
            size = "lg"
            content = "Large"
        end
    end
    box:
        layout = "row"
        gap = 8
        wrap = true
        align = "center"
        margin top = 12
        button:
            variant = "outline"
            size = "icon xs"
            content = "+"
        end
        button:
            variant = "outline"
            size = "icon sm"
            content = "+"
        end
        button:
            variant = "outline"
            size = "icon"
            content = "+"
        end
        button:
            variant = "outline"
            size = "icon lg"
            content = "+"
        end
    end
end
