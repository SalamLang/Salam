page:
    design = "shadcn"
    title = "Button variants"
    margin = 1.5rem
    box:
        layout = "row"
        gap = 8
        wrap = true
        button:
            content = "Default"
        end
        button:
            variant = "destructive"
            content = "Destructive"
        end
        button:
            variant = "outline"
            content = "Outline"
        end
        button:
            variant = "secondary"
            content = "Secondary"
        end
        button:
            variant = "ghost"
            content = "Ghost"
        end
        button:
            variant = "link"
            content = "Link"
        end
        button:
            disabled = true
            content = "Disabled"
        end
    end
end
