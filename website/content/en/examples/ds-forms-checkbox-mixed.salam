page:
    design = "shadcn"
    title = "Indeterminate"
    margin = 1.5rem
    box:
        gap = 10
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                id = "all"
                type = "checkbox"
                indeterminate = true
            end
            label:
                for = "all"
                content = "Select all (some chosen)"
            end
        end
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                type = "checkbox"
                checked = true
            end
            label:
                content = "First"
            end
        end
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                type = "checkbox"
            end
            label:
                content = "Second"
            end
        end
    end
end
