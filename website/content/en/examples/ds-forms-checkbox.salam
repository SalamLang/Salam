page:
    title = "Checkbox"
    margin = 1.5rem
    box:
        gap = 12
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                id = "terms"
                type = "checkbox"
            end
            label:
                for = "terms"
                content = "Accept the terms"
            end
        end
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                id = "news"
                type = "checkbox"
                checked = true
            end
            label:
                for = "news"
                content = "Send me the newsletter"
            end
        end
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                id = "off"
                type = "checkbox"
                disabled = true
            end
            label:
                for = "off"
                content = "Disabled"
            end
        end
    end
end
