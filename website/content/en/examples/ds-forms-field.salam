page:
    title = "Field"
    margin = 1.5rem
    form:
        field set:
            legend:
                variant = "label"
                content = "Account"
            end
            field group:
                field:
                    field label:
                        for = "fname"
                        content = "Name"
                    end
                    input:
                        id = "fname"
                        type = "text"
                    end
                    field description:
                        content = "Shown on your profile."
                    end
                end
                field:
                    error = true
                    field label:
                        for = "fmail"
                        content = "Email"
                    end
                    input:
                        id = "fmail"
                        type = "email"
                    end
                    field error:
                        content = "Enter a valid address."
                    end
                end
                field:
                    orientation = "horizontal"
                    input:
                        id = "fnews"
                        type = "checkbox"
                    end
                    field label:
                        for = "fnews"
                        content = "Subscribe"
                    end
                end
                field separator:
                    content = "or"
                end
                field:
                    orientation = "horizontal"
                    field content:
                        field title:
                            content = "Two step sign in"
                        end
                        field description:
                            content = "Ask for a code at every sign in."
                        end
                    end
                    input:
                        id = "ftwo"
                        type = "checkbox"
                    end
                end
            end
        end
    end
end
