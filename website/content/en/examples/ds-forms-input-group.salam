page:
    design = "shadcn"
    title = "Input group"
    margin = 1.5rem
    box:
        gap = 12
        input group:
            input group addon:
                input group text:
                    content = "https://"
                end
            end
            input:
                type = "text"
                placeholder = "example.com"
            end
        end
        input group:
            input:
                type = "text"
                placeholder = "Amount"
            end
            input group addon:
                align = "inline-end"
                input group text:
                    content = "USD"
                end
            end
        end
        input group:
            input:
                type = "search"
                placeholder = "Search"
            end
            input group addon:
                align = "inline-end"
                button:
                    size = "xs"
                    content = "Go"
                end
            end
        end
    end
end
