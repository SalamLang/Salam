page:
    title = "Input types"
    margin = 1.5rem
    box:
        gap = 8
        input:
            type = "text"
            placeholder = "Text"
        end
        input:
            type = "email"
            placeholder = "name@example.com"
        end
        input:
            type = "password"
            placeholder = "Password"
        end
        input:
            type = "number"
            placeholder = "Number"
        end
        input:
            type = "search"
            placeholder = "Search"
        end
        input:
            type = "date"
        end
        input:
            type = "text"
            value = "Disabled"
            disabled = true
        end
    end
end
