page:
    design = "shadcn"
    title = "Invalid state"
    margin = 1.5rem
    box:
        gap = 12
        input:
            type = "email"
            value = "not an email"
            aria invalid = "true"
        end
        input:
            type = "textarea"
            rows = 2
            aria invalid = "true"
            placeholder = "A message is required"
        end
        select:
            aria invalid = "true"
            option:
                content = "Pick a plan"
            end
        end
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                id = "agree"
                type = "checkbox"
                aria invalid = "true"
            end
            label:
                for = "agree"
                content = "I accept the terms"
            end
        end
    end
end
