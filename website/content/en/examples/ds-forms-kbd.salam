page:
    title = "Keyboard"
    margin = 1.5rem
    box:
        layout = "row"
        gap = 12
        align = "center"
        wrap = true
        keyboard:
            content = "Esc"
        end
        keyboard group:
            keyboard:
                content = "Ctrl"
            end
            keyboard:
                content = "K"
            end
        end
        keyboard group:
            keyboard:
                content = "Shift"
            end
            keyboard:
                content = "Enter"
            end
        end
    end
end
