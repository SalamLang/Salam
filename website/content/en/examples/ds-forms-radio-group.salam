page:
    design = "shadcn"
    title = "Radio group"
    margin = 1.5rem
    radio group:
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                id = "r1"
                type = "radio"
                name = "plan"
                checked = true
            end
            label:
                for = "r1"
                content = "Free"
            end
        end
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                id = "r2"
                type = "radio"
                name = "plan"
            end
            label:
                for = "r2"
                content = "Pro"
            end
        end
        box:
            layout = "row"
            gap = 8
            align = "center"
            input:
                id = "r3"
                type = "radio"
                name = "plan"
            end
            label:
                for = "r3"
                content = "Team"
            end
        end
    end
end
