page:
    design = "shadcn"
    title = "Select sizes"
    margin = 1.5rem
    box:
        gap = 12
        select:
            name = "a"
            option:
                content = "Default size"
            end
            option:
                content = "Second"
            end
        end
        select:
            name = "b"
            control size = "sm"
            option:
                content = "Small size"
            end
            option:
                content = "Second"
            end
        end
    end
end
