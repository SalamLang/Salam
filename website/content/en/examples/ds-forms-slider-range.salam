page:
    design = "shadcn"
    title = "Range slider"
    margin = 1.5rem
    box:
        gap = 16
        range slider:
            id = "price"
            low = 20
            high = 70
        end
        paragraph:
            id = "shown"
            content = "20 to 70"
        end
        box:
            layout = "row"
            gap = 32
            input:
                type = "range"
                orientation = "vertical"
                value = "40"
            end
            range slider:
                orientation = "vertical"
                low = 10
                high = 60
            end
        end
    end
    script:
        content = "document.getElementById('price').addEventListener('ds-change', function (e) { document.getElementById('shown').textContent = e.detail.low + ' to ' + e.detail.high; });"
    end
end
