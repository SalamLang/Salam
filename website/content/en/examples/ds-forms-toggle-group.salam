page:
    title = "Toggle group"
    margin = 1.5rem
    box:
        gap = 12
        toggle group:
            type = "single"
            variant = "outline"
            toggle:
                pressed = true
                content = "Left"
            end
            toggle:
                content = "Center"
            end
            toggle:
                content = "Right"
            end
        end
        toggle group:
            type = "multiple"
            variant = "outline"
            toggle:
                pressed = true
                font weight = 700
                content = "Bold"
            end
            toggle:
                italic = true
                content = "Italic"
            end
            toggle:
                pressed = true
                decoration = "underline"
                content = "Underline"
            end
        end
    end
end
