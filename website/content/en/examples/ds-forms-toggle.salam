page:
    title = "Toggle"
    margin = 1.5rem
    box:
        layout = "row"
        gap = 8
        wrap = true
        align = "center"
        toggle:
            content = "Bold"
        end
        toggle:
            pressed = true
            content = "Italic"
        end
        toggle:
            variant = "outline"
            content = "Outline"
        end
        toggle:
            size = "sm"
            content = "Small"
        end
        toggle:
            size = "lg"
            content = "Large"
        end
        toggle:
            disabled = true
            content = "Disabled"
        end
    end
end
