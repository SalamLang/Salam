page:
    design = "shadcn"
    box:
        layout = "column"
        gap = 24
        width = 400
        accordion:
            type = "single"
            collapsible = true
            accordion item:
                value = "a"
                open = true
                accordion trigger:
                    content = "Is it accessible?"
                end
                accordion content:
                    content = "Yes. It follows the WAI-ARIA pattern and works with the keyboard."
                end
            end
            accordion item:
                value = "b"
                accordion trigger:
                    content = "Is it styled?"
                end
                accordion content:
                    content = "Yes. It comes with the design of the page."
                end
            end
            accordion item:
                value = "c"
                accordion trigger:
                    content = "Is it locked?"
                    disabled = true
                end
                accordion content:
                    content = "Not shown."
                end
            end
        end
        accordion:
            type = "multiple"
            accordion item:
                value = "x"
                accordion trigger:
                    content = "First"
                end
                accordion content:
                    content = "With multiple, several items can be open."
                end
            end
            accordion item:
                value = "y"
                accordion trigger:
                    content = "Second"
                end
                accordion content:
                    content = "Open this one too."
                end
            end
        end
    end
end
