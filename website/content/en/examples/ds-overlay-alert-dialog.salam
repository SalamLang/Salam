page:
    design = "shadcn"
    box:
        layout = "row"
        gap = 8
        button:
            variant = "destructive"
            opens = "del"
            content = "Delete account"
        end
        button:
            variant = "outline"
            opens = "small"
            content = "Small size"
        end
    end
    alert dialog:
        id = "del"
        alert dialog header:
            alert dialog title:
                content = "Are you sure?"
            end
            alert dialog description:
                content = "This cannot be undone. Clicking outside does not close it."
            end
        end
        alert dialog footer:
            alert dialog cancel:
                content = "Cancel"
            end
            alert dialog action:
                variant = "destructive"
                content = "Delete"
            end
        end
    end
    alert dialog:
        id = "small"
        size = "sm"
        alert dialog header:
            alert dialog media:
                span:
                    content = "!"
                end
            end
            alert dialog title:
                content = "Leave page?"
            end
            alert dialog description:
                content = "Unsaved changes are lost."
            end
        end
        alert dialog footer:
            alert dialog cancel:
                content = "Stay"
            end
            alert dialog action:
                content = "Leave"
            end
        end
    end
end
