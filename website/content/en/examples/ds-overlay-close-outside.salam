page:
    box:
        layout = "row"
        gap = 8
        button:
            opens = "auto"
            content = "Closes on outside click"
        end
        button:
            variant = "outline"
            opens = "locked"
            content = "Stays open"
        end
    end
    dialog:
        id = "auto"
        dialog title:
            content = "Click outside me"
        end
        dialog description:
            content = "A click on the dark area closes this window. This is the default."
        end
    end
    dialog:
        id = "locked"
        close outside = false
        dialog title:
            content = "Outside clicks are ignored"
        end
        dialog description:
            content = "Only the corner X, the button and Escape close this window."
        end
        dialog footer:
            dialog close:
                content = "Close"
            end
        end
    end
end
