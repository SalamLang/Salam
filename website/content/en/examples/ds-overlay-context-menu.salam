page:
    context menu:
        context menu trigger:
            box:
                width = 280
                height = 110
                padding = 16
                border = 1, "dashed", "#888888"
                radius = 8
                paragraph:
                    content = "Right click here"
                end
            end
        end
        context menu content:
            menu item:
                content = "Back"
            end
            menu item:
                content = "Reload"
                menu shortcut:
                    content = "Ctrl R"
                end
            end
            menu separator:
            end
            menu checkbox item:
                content = "Show bookmarks"
                checked = true
            end
            menu item:
                variant = "destructive"
                content = "Delete"
            end
        end
    end
    box:
        height = 120
    end
end
