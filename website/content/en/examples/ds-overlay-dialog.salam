page:
    dialog trigger:
        opens = "edit"
        content = "Edit profile"
    end
    dialog:
        id = "edit"
        dialog header:
            dialog title:
                content = "Edit profile"
            end
            dialog description:
                content = "Change your public name. Press Escape to close."
            end
        end
        dialog footer:
            dialog close:
                content = "Cancel"
            end
            button:
                closes = true
                content = "Save"
            end
        end
    end
    dialog:
        id = "plain"
        show close = false
        width = 280
        dialog title:
            content = "No corner X"
        end
        dialog footer:
            dialog close:
                content = "Got it"
            end
        end
    end
    button:
        variant = "secondary"
        opens = "plain"
        content = "Small, no X"
    end
end
