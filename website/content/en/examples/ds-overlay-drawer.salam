page:
    box:
        layout = "row"
        gap = 8
        button:
            variant = "outline"
            opens = "dr"
            content = "Open drawer"
        end
        button:
            variant = "outline"
            opens = "dr-right"
            content = "Side drawer"
        end
    end
    drawer:
        id = "dr"
        drawer header:
            drawer title:
                content = "Move goal"
            end
            drawer description:
                content = "Drag the handle down to dismiss."
            end
        end
        drawer footer:
            button:
                closes = true
                content = "Submit"
            end
            button:
                variant = "outline"
                closes = true
                content = "Cancel"
            end
        end
    end
    drawer:
        id = "dr-right"
        side = "right"
        drawer header:
            drawer title:
                content = "Side drawer"
            end
            drawer description:
                content = "The side attribute moves the drawer."
            end
        end
    end
end
