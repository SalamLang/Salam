page:
    dropdown menu:
        menu trigger:
            content = "Open menu"
        end
        menu content:
            menu label:
                content = "My account"
            end
            menu group:
                menu item:
                    content = "Profile"
                    menu shortcut:
                        content = "Ctrl P"
                    end
                end
                menu item:
                    content = "Settings"
                end
                menu item:
                    content = "Billing"
                    disabled = true
                end
            end
            menu separator:
            end
            menu checkbox item:
                checked = true
                content = "Show toolbar"
            end
            menu separator:
            end
            menu radio group:
                value = "light"
                menu radio item:
                    value = "light"
                    content = "Light"
                end
                menu radio item:
                    value = "dark"
                    content = "Dark"
                end
            end
            menu separator:
            end
            menu sub:
                menu sub trigger:
                    content = "More"
                end
                menu sub content:
                    menu item:
                        content = "Export"
                    end
                    menu item:
                        content = "Share"
                    end
                end
            end
            menu item:
                variant = "destructive"
                content = "Log out"
            end
        end
    end
    box:
        height = 300
    end
end
