page:
    design = "shadcn"
    hover card:
        hover card trigger:
            variant = "link"
            content = "@salamlang"
        end
        hover card content:
            width = 260
            paragraph:
                content = "Salam, a language for the web and for native apps."
            end
        end
    end
    box:
        height = 120
    end
end
