page:
    menubar:
        menubar menu:
            menubar trigger:
                content = "File"
            end
            menu content:
                menu item:
                    content = "New tab"
                    menu shortcut:
                        content = "Ctrl T"
                    end
                end
                menu item:
                    content = "Print"
                end
            end
        end
        menubar menu:
            menubar trigger:
                content = "Edit"
            end
            menu content:
                menu item:
                    content = "Undo"
                end
                menu item:
                    content = "Redo"
                end
            end
        end
        menubar menu:
            menubar trigger:
                content = "View"
            end
            menu content:
                menu checkbox item:
                    content = "Always show bookmarks"
                    checked = true
                end
            end
        end
    end
    box:
        height = 150
    end
end
