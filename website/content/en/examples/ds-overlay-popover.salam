page:
    design = "shadcn"
    box:
        layout = "row"
        gap = 12
        popover:
            popover trigger:
                content = "Open popover"
            end
            popover content:
                popover header:
                    popover title:
                        content = "Dimensions"
                    end
                    popover description:
                        content = "Set the size of the layer."
                    end
                end
            end
        end
        popover:
            popover trigger:
                variant = "secondary"
                content = "Bottom, aligned end"
            end
            popover content:
                side = "bottom"
                align = "end"
                side offset = 12
                popover title:
                    content = "Placement"
                end
            end
        end
    end
    box:
        height = 150
    end
end
