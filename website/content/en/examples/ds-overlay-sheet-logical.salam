page:
    box:
        layout = "row"
        gap = 8
        button:
            variant = "outline"
            opens = "s-start"
            content = "Start"
        end
        button:
            variant = "outline"
            opens = "s-end"
            content = "End"
        end
        button:
            variant = "outline"
            opens = "d-start"
            content = "Drawer at start"
        end
    end
    sheet:
        id = "s-start"
        side = "start"
        sheet header:
            sheet title:
                content = "Start sheet"
            end
            sheet description:
                content = "Left in a left to right page, right in a right to left page."
            end
        end
    end
    sheet:
        id = "s-end"
        side = "end"
        sheet header:
            sheet title:
                content = "End sheet"
            end
            sheet description:
                content = "The opposite edge, so it follows the reading direction too."
            end
        end
    end
    drawer:
        id = "d-start"
        side = "start"
        drawer header:
            drawer title:
                content = "Drawer"
            end
            drawer description:
                content = "Drag it toward its edge to dismiss it."
            end
        end
    end
end
