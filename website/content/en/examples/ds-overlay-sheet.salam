page:
    design = "shadcn"
    box:
        layout = "row"
        gap = 8
        button:
            variant = "outline"
            opens = "s-top"
            content = "Top"
        end
        button:
            variant = "outline"
            opens = "s-right"
            content = "Right"
        end
        button:
            variant = "outline"
            opens = "s-bottom"
            content = "Bottom"
        end
        button:
            variant = "outline"
            opens = "s-left"
            content = "Left"
        end
    end
    sheet:
        id = "s-top"
        side = "top"
        sheet header:
            sheet title:
                content = "Top sheet"
            end
            sheet description:
                content = "Slides down from the top edge."
            end
        end
    end
    sheet:
        id = "s-right"
        side = "right"
        sheet header:
            sheet title:
                content = "Right sheet"
            end
            sheet description:
                content = "The default side. Edit settings here."
            end
        end
        sheet footer:
            button:
                closes = true
                content = "Save"
            end
        end
    end
    sheet:
        id = "s-bottom"
        side = "bottom"
        sheet header:
            sheet title:
                content = "Bottom sheet"
            end
            sheet description:
                content = "Slides up from the bottom edge."
            end
        end
    end
    sheet:
        id = "s-left"
        side = "left"
        show close = false
        sheet header:
            sheet title:
                content = "Left sheet"
            end
            sheet description:
                content = "No corner X here; use Escape or the button."
            end
        end
        sheet footer:
            button:
                variant = "outline"
                closes = true
                content = "Close"
            end
        end
    end
end
