page:
    box:
        layout = "column"
        gap = 16
        width = 360
        tabs:
            default value = "account"
            tab list:
                tab trigger:
                    value = "account"
                    content = "Account"
                end
                tab trigger:
                    value = "password"
                    content = "Password"
                end
                tab trigger:
                    value = "off"
                    content = "Off"
                    disabled = true
                end
            end
            tab content:
                value = "account"
                paragraph:
                    content = "Change your name and email here."
                end
            end
            tab content:
                value = "password"
                paragraph:
                    content = "Pick a new password."
                end
            end
        end
        tabs:
            default value = "one"
            tab list:
                variant = "line"
                tab trigger:
                    value = "one"
                    content = "Overview"
                end
                tab trigger:
                    value = "two"
                    content = "Activity"
                end
            end
            tab content:
                value = "one"
                paragraph:
                    content = "The line variant draws an underline."
                end
            end
            tab content:
                value = "two"
                paragraph:
                    content = "Recent events show up here."
                end
            end
        end
        tabs:
            orientation = "vertical"
            default value = "a"
            tab list:
                tab trigger:
                    value = "a"
                    content = "General"
                end
                tab trigger:
                    value = "b"
                    content = "Billing"
                end
            end
            tab content:
                value = "a"
                paragraph:
                    content = "Vertical tabs sit side by side."
                end
            end
            tab content:
                value = "b"
                paragraph:
                    content = "Invoices and plans."
                end
            end
        end
    end
end
