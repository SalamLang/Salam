page:
    box:
        layout = "row"
        gap = 12
        padding = 40, 0
        tooltip:
            tooltip trigger:
                content = "Top"
            end
            tooltip content:
                content = "Shown above"
            end
        end
        tooltip:
            tooltip trigger:
                content = "Right"
            end
            tooltip content:
                side = "right"
                content = "Shown at the right"
            end
        end
        tooltip:
            tooltip trigger:
                content = "Bottom"
            end
            tooltip content:
                side = "bottom"
                content = "Shown below"
            end
        end
        tooltip:
            tooltip trigger:
                content = "Left"
            end
            tooltip content:
                side = "left"
                content = "Shown at the left"
            end
        end
        tooltip:
            delay = 500
            tooltip trigger:
                variant = "ghost"
                content = "Slow"
            end
            tooltip content:
                content = "Waits half a second"
            end
        end
    end
end
