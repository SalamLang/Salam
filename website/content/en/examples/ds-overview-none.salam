page:
    title = "No design"
    design = "none"
    padding = 16
    tabs:
        default value = "a"
        tab list:
            tab trigger:
                value = "a"
                content = "One"
            end
            tab trigger:
                value = "b"
                content = "Two"
            end
        end
        tab content:
            value = "a"
            paragraph:
                content = "Works without a design"
            end
        end
        tab content:
            value = "b"
            paragraph:
                content = "Second panel"
            end
        end
    end
end
