page:
    title = "Scope"
    theme = "light"
    padding = 16
    card:
        padding = 16
        paragraph:
            content = "This card follows the page: light."
        end
        box:
            theme = "dark"
            padding = 16
            radius = 8
            gap = 8
            paragraph:
                content = "This box is dark, and so is everything inside it."
            end
            button:
                content = "Dark button"
            end
        end
    end
end
