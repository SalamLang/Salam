page:
    title = "Borders"
    box:
        layout = row
        gap = 16
        padding = 16
        box:
            width = 100
            height = 80
            border = 2, solid, #3366aa
        end
        box:
            width = 100
            height = 80
            border = 2, dashed, #3366aa
            radius = 16
        end
        box:
            width = 100
            height = 80
            border bottom = 4, solid, #dc2626
        end
        box:
            width = 100
            height = 80
            radius = 40, 0, 40, 0
            background = #bbf7d0
        end
        box:
            width = 100
            height = 80
            outline = 3, solid, #f59e0b
            outline offset = 4
        end
    end
end
