component Card(name: str):
    box:
        padding = 16
        border = 2, "solid", "#0f766e"
        radius = 8
        heading:
            size = 3
            content = name
            color = "#0f766e"
        end
        content: end
    end
end

page:
    title = "Cards"
    box:
        padding = 32
        gap = 16
        Card:
            name = "Fast"
            paragraph:
                content = "Compiled to machine code."
            end
        end
        Card:
            name = "Checked"
            paragraph:
                content = "Styles are checked while building."
            end
        end
    end
end
