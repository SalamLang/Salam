component Tasks:
    items := Vector {} as Vector<str>
    next := 0
    box:
        padding = 16
        gap = 8
        max width = 360
        button:
            id = "add"
            click = (): items.Push("task " + next) next++ end
            content = "Add a task"
        end
        list:
            each it in items:
                item:
                    key = it
                    padding = 8
                    hover background = "#eef4ff"
                    content = it
                end
            end
        end
    end
end

page:
    title = "Tasks"
    Tasks: end
end
