component Todo:
    items := Vector {} as Vector<str>
    next := 0
    box:
        padding = 16
        gap = 8
        max width = 360
        button: id = "add" click = (): items.Push("task " + next) next++ end content = "Add a task" end
        if items.Len() == 0:
            paragraph: color = #6b7280 content = "Nothing to do." end
        end
        each i, it in items:
            box:
                layout = row
                align = center
                gap = 8
                padding = 8
                background = i % 2 == 0 ? #f3f4f6 : white
                paragraph: grow = 1 content = it end
                button: click = (): items.RemoveAt(i) end content = "Done" end
            end
        end
    end
end

page:
    title = "Tasks"
    Todo: end
end
