page:
    title = "Filters"
    box:
        layout = "row"
        gap = 12
        padding = 16
        box:
            width = 80
            height = 80
            background = "#3366aa"
        end
        box:
            width = 80
            height = 80
            background = "#3366aa"
            grayscale = 1
        end
        box:
            width = 80
            height = 80
            background = "#3366aa"
            saturate = 3
        end
        box:
            width = 80
            height = 80
            background = "#3366aa"
            hue rotate = 90
        end
        box:
            width = 80
            height = 80
            background = "#3366aa"
            translate = 10, -4
            skew = 10, 0
        end
    end
end
