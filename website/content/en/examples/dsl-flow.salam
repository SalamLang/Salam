page:
    title = "Flow and wrap"
    box:
        layout = row
        wrap = true
        gap = 8
        padding = 16
        width = 260
        box:
            width = 100
            height = 40
            background = #93c5fd
        end
        box:
            width = 100
            height = 40
            background = #86efac
        end
        box:
            width = 100
            height = 40
            background = #fca5a5
        end
        box:
            width = 100
            height = 40
            background = #fde68a
        end
    end
    paragraph:
        layout = flow
        content = "Flow places children like words in a paragraph."
    end
end
