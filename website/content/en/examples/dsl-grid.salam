page:
    title = "Grid"
    box:
        layout = grid
        columns = 100, 1fr, 1fr
        gap = 8, 16
        padding = 16
        box:
            background = #93c5fd
            height = 40
        end
        box:
            background = #86efac
        end
        box:
            background = #fca5a5
        end
        box:
            column span = 2
            background = #fde68a
            height = 40
        end
        box:
            background = #c4b5fd
        end
    end
end
