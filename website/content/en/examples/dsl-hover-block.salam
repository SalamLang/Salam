page:
    title = "State blocks"
    box:
        layout = "row"
        gap = 12
        padding = 16
        button:
            padding = 8, 16
            radius = 6
            background = "#2563eb"
            color = "white"
            transition = 200ms, "ease out"
            hover:
                background = "#1d4ed8"
                scale = 1.05
            end
            active:
                background = "#1e3a8a"
            end
            focus:
                outline = 2, "solid", "#f59e0b"
            end
            content = "Press me"
        end
    end
end
