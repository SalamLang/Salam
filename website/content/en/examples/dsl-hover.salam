page:
    title = "Hover"
    box:
        layout = row
        gap = 12
        padding = 16
        button:
            padding = 8, 16
            radius = 6
            border = 1, solid, #1d4ed8
            background = #2563eb
            color = white
            cursor = pointer
            hover background = #1d4ed8
            active background = #1e3a8a
            focus outline = 2, solid, #f59e0b
            disabled opacity = 0.5
            content = "Press me"
        end
        button:
            disabled = true
            padding = 8, 16
            content = "Off"
        end
    end
end
