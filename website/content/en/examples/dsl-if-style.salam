component Toggle:
    picked := false
    box:
        padding = 16
        button:
            id = "pick"
            padding = 8, 16
            radius = 6
            background = "#2563eb"
            color = "white"
            if picked:
                background = "#f59e0b"
                color = "#111827"
            end
            click = (): picked = not picked end
            content = "Pick me"
        end
    end
end

page:
    title = "Conditional style"
    Toggle: end
end
