component Greeter:
    name := ""
    box:
        padding = 16
        gap = 8
        input:
            id = "who"
            placeholder = "Your name"
            padding = 8, 12
            radius = 6
            border = 1, solid, #d1d5db
            bind = name
        end
        paragraph:
            id = "hello"
            content = "Hello, " + name
        end
    end
end

page:
    title = "Text input"
    Greeter: end
end
