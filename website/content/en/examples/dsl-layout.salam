page:
    title = "Rows and columns"
    box:
        layout = "row"
        gap = 12
        align = "center"
        justify = "between"
        padding = 16
        background = "#f3f4f6"
        box:
            width = 80
            height = 40
            background = "#93c5fd"
        end
        box:
            width = 80
            height = 80
            background = "#86efac"
        end
        box:
            width = 80
            height = 60
            background = "#fca5a5"
        end
    end
    box:
        layout = "column"
        gap = 8
        padding = 16
        box:
            height = 30
            background = "#93c5fd"
        end
        box:
            height = 30
            background = "#86efac"
        end
    end
end
