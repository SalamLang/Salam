page:
    title = "Overflow"
    box:
        layout = "row"
        gap = 16
        padding = 16
        box:
            width = 160
            height = 80
            overflow = "hidden"
            background = "#e0f2fe"
            paragraph:
                content = "This long text is cut at the bottom of the box because overflow is hidden. More words follow here."
            end
        end
        box:
            width = 160
            height = 80
            overflow = "scroll"
            background = "#fef9c3"
            paragraph:
                content = "This long text can be scrolled because overflow is scroll. More words follow here."
            end
        end
    end
end
