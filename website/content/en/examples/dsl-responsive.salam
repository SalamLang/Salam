page:
    title = "Cards that fit"
    box:
        layout = row
        wrap = true
        gap = 12
        padding = 16
        max width = 720
        margin = 0, auto
        box:
            grow = 1
            min width = 140
            height = 80
            background = #93c5fd
            radius = 8
        end
