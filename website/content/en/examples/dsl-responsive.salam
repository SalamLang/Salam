            grow = 1
            min width = 140
            height = 80
            background = #86efac
            radius = 8
        end
        box:
            grow = 1
            min width = 140
            height = 80
            background = #fca5a5
            radius = 8
        end
        box:
            grow = 1
            min width = 140
            height = 80
            background = #fde68a
            radius = 8
        end
        box:
            grow = 1
            min width = 140
            height = 80
            background = #c4b5fd
            radius = 8
        end
    end
end
