page:
    title = "Shadows"
    box:
        layout = row
        gap = 24
        padding = 24
        background = #f3f4f6
        box:
            width = 100
            height = 80
            background = white
            radius = 8
            shadow = 0, 4, 8, #00000040
        end
        box:
            width = 100
            height = 80
            background = white
            radius = 8
            shadow = [0, 4, 8, #00000040], [0, 1, 2, red]
        end
        box:
            width = 100
            height = 80
            background = white
            radius = 8
            shadow = inset, 0, 2, 6, #00000040
        end
    end
end
