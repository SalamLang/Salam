page:
    title = "Sizes"
    box:
        gap = 12
        padding = 16
        box:
            width = "fill"
            height = 40
            background = "#bbf7d0"
        end
        box:
            width = 50%
            height = 40
            background = "#fde68a"
        end
        box:
            width = 200
            min width = 120
            max width = 150
            height = 40
            background = "#fecaca"
        end
        box:
            width = 160
            aspect ratio = 1.5
            background = "#c7d2fe"
        end
        box:
            width = 75%
            height = 40
            background = "#e9d5ff"
        end
    end
end
