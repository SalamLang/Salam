page:
    title = "State blocks"
    box:
        layout = row
        gap = 12
        padding = 16
        button:
            padding = 8, 16
            radius = 6
            background = #2563eb
            color = white
            hover:
                background = #1d4ed8
                padding = 10, 20
            end
            active:
                background = #1e3a8a
            end
            content = "Press me"
        end
        box:
            padding = 8
            border = 1, solid, #cbd5e1
            focus within:
                border = 2, solid, #f59e0b
            end
            input: end
        end
    end
end
