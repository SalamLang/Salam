component Counter:
    count := 0
    box:
        padding = 16
        gap = 8
        heading:
            size = 2
            content = "Count: " + count
        end
        box:
            layout = row
            gap = 8
            button:
                id = "down"
                click = (): count-- end
                content = "-1"
            end
            button:
                id = "up"
                click = (): count++ end
                content = "+1"
            end
            button:
                id = "reset"
                click = (): count = 0 end
                content = "Reset"
            end
        end
    end
end

page:
    title = "Counter"
    Counter: end
end
