page:
    title = "Clipped text"
    box:
        padding = 16
        gap = 12
        width = 280
        paragraph:
            ellipsis = true
            content = "One line only, so a long sentence ends with three dots."
        end
        paragraph:
            max lines = 2
            content = "At most two lines. The rest of this long paragraph is cut off and replaced by an ellipsis, however long it is."
        end
        paragraph:
            white space = keep
            content = "spaces   are   kept"
        end
        paragraph:
            text shadow = 0, 1, 2, #00000080
            font size = 24
            content = "Shadow"
        end
    end
end
