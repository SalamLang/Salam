page:
    title = "Text"
    box:
        padding = 24
        max width = 480
        color = #1f2937
        font = "Vazirmatn", sans
        heading:
            size = 2
            font weight = black
            letter spacing = 1
            content = "A headline"
        end
        paragraph:
            font size = 18
            line height = 1.6
            text align = justify
            content = "Text properties are inherited. Set the colour and the font on the outer box and every paragraph inside uses them."
        end
        paragraph:
            italic = true
            content = "Italic text."
        end
        paragraph:
            transform text = upper
            content = "shouting"
        end
    end
end
