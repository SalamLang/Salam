page:
    title = "Transitions"
    box:
        padding = 24
        box:
            width = 120
            height = 80
            background = "#3366aa"
            radius = 8
            transition = 300ms, "ease"
            hover background = "#f59e0b"
            hover scale = 1.2
            hover rotate = 8
        end
    end
end
