page:
    title = "Values"
    box:
        width = 50%
        max width = 480
        padding = 8, 16
        margin = 16, auto
        background = #eef4ff
        color = #1e3a8a
        radius = 8
        paragraph:
            content = "50% of the parent, 8 above and below, 16 at the sides."
        end
        paragraph:
            font size = 1.25em
            content = "A size relative to the font."
        end
    end
end
