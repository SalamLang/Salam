import encoding.binary
import compress
import str

func write_file(scores: Vector<int>): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    compress.BufPushBytes(b, "SLM1" as void*, 4)
    binary.WriteU16LE(b, 2)
    binary.WriteU32LE(b, scores.len())
    each s in scores:
        binary.WriteI32LE(b, s)
    end
    ret b
end

func read_file(data: compress.ByteBuf, size: int): str throws:
    mut r := compress.NewByteReader(data.data, size)
    mut head := compress.RdBytes(r, 4)
    defer compress.BufFree(head)
    if compress.BufToStrUnsafe(head) != "SLM1":
        throw Error.At(ErrorKind.Syntax, "not our file", 0)
    end
    version := try binary.ReadU16LE(r)
    if version != 2:
        throw Error.At(ErrorKind.Unsupported, "unknown version " + str.FromInt(version), 4)
    end
    count := try binary.ReadU32LE(r)
    if count < 0 or count > 100000:
        throw Error.At(ErrorKind.OutOfRange, "implausible count", 6)
    end
    mut total := 0 as i64
    repeat count:
        total += (try binary.ReadI32LE(r)) as i64
    end
    ret str.FromInt(count) + " scores, total " + str.FromInt(total)
end

func show(label: str, data: compress.ByteBuf, size: int):
    try:
        println label, read_file(data, size)
    catch e:
        println label, e.ToStr()
    end
end

func main:
    mut scores := Vector {} as Vector<int>
    scores.push(120)
    scores.push(-15)
    scores.push(98000)
    mut data := write_file(scores)
    println "file is", compress.BufLen(data), "bytes"

    show("whole file:", data, compress.BufLen(data))
    show("first 18:  ", data, 18)
    compress.BufSet(data, 4, 9)
    show("edited:    ", data, compress.BufLen(data))
    compress.BufFree(data)
end
