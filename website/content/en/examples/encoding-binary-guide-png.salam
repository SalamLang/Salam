import encoding.binary
import compress

func fake_png(): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    sig := [137, 80, 78, 71, 13, 10, 26, 10]
    each x in sig:
        binary.WriteU8(b, x)
    end
    binary.WriteU32BE(b, 13)
    compress.BufPushBytes(b, "IHDR" as void*, 4)
    binary.WriteU32BE(b, 1280)
    binary.WriteU32BE(b, 720)
    binary.WriteU8(b, 8)
    binary.WriteU8(b, 6)
    ret b
end

func main throws:
    mut png := fake_png()
    defer compress.BufFree(png)
    mut r := compress.ReaderFromBuf(png)
    b0 := try binary.ReadU8(r)
    b1 := try binary.ReadU8(r)
    if b0 != 137 or b1 != 80:
        throw "not a PNG"
    end
    repeat 6:
        _ := try binary.ReadU8(r)
    end
    length := try binary.ReadU32BE(r)
    mut kind := compress.RdBytes(r, 4)
    println "first chunk:", compress.BufToStrUnsafe(kind), "of", length, "bytes"
    compress.BufFree(kind)
    width := try binary.ReadU32BE(r)
    height := try binary.ReadU32BE(r)
    println "size:", width, "x", height
    depth := try binary.ReadU8(r)
    color := try binary.ReadU8(r)
    println "bit depth:", depth, "color type:", color
    try:
        binary.ReadU8(r)
    catch e:
        println "the rest of IHDR is missing:", e.to_str()
    end
end
