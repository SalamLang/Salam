import encoding.csv

func show(line: str):
    f := csv.ReadLine(line)
    mut s := ""
    each x in f:
        s = s + "[" + x + "]"
    end
    println f.len(), "fields:", s
end

func main:
    show("a,b,c")
    show("a,,c")
    show(" a , b ")
    show(`"x,y",z`)
    show(`"she said ""hi""",ok`)
    show("trailing,")
    show(`"Pen" ,blue,3`)
    show("sku;title;stock")

    mut t := csv.ReadAll("id,name\r\n1,Ali\r\n2,Sara\r\n")
    println "rows with CRLF:", t.rows.len(), t.rows.get(2).fields.get(1)
    csv.FreeTable(t)
end
