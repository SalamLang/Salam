import encoding.msgpack
import encoding.json
import compress

struct Session:
    pub user: str = ""
    pub role: str = ""
    pub visits: int = 0
end

func save(cache &: HashMap<str, compress.ByteBuf>, key: str, s: Session) throws:
    v := try json.Decode(json.Marshal(s))
    cache.put(key, msgpack.Marshal(v))
end

func load(cache: HashMap<str, compress.ByteBuf>, key: str, out &: Session): bool:
    if not cache.has(key):
        ret false
    end
    try:
        v := msgpack.Unmarshal(cache.get(key))
        json.Unmarshal(json.EncodeDefault(v), out)
    catch:
        ret false
    end
    ret true
end

func main throws:
    mut cache := HashMap {} as HashMap<str, compress.ByteBuf>
    try save(cache, "session:9f2", Session { user = "sara", role = "admin", visits = 12 })

    mut s := Session {}
    if load(cache, "session:9f2", s):
        println "found", s.user, s.role, s.visits
    end
    println "missing key loads:", load(cache, "session:000", s)
end
