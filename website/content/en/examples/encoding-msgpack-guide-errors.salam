import encoding.msgpack
import encoding.value
import compress

func main throws:
    mut v := value.NewValueObject()
    value.ObjectSet(v, "name", value.ValueString("salam"))
    b := msgpack.Marshal(v)

    whole := try msgpack.UnmarshalBytes(b.data, b.len)
    println "whole buffer:", try whole.field("name").str()

    try:
        _ := msgpack.UnmarshalBytes(b.data, b.len - 3)
    catch e:
        println "cut short:", e.is(ErrorKind.UnexpectedEnd), e.to_str()
    end

    mut blob := compress.NewByteBuf()
    compress.BufPush(blob, 0xc1)
    try:
        _ := msgpack.Unmarshal(blob)
    catch e:
        println "unsupported tag:", e.kind_name(), "->", e.message
    end

    mut two := compress.BufClone(b)
    compress.BufPush(two, 0x2a)
    first := try msgpack.Unmarshal(two)
    println "extra byte after the value:", value.ObjectLen(first), "key read"
end
