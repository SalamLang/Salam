import encoding.protobuf

func main:
    proto := "syntax = \"proto3\";\nmessage Point {\n  sint32 x = 1;\n  sint32 y = 2;\n  string label = 3;\n}\n"
    mut code := ""
    try:
        code = protobuf.GenerateSingle(proto)
    catch e:
        println "the proto file did not parse:", e.ToStr()
        ret 1
    end
    lines := code.Split("\n")
    each line in lines:
        if line.StartsWith("pub ") or line.StartsWith("package "):
            println line
        end
    end
    ret 0
end
