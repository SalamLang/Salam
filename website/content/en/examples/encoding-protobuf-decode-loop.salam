import encoding.protobuf
import compress

struct User:
    pub id: int = 0
    pub name: str = ""
    pub admin: bool = false
end

func decodeUser(data: void*, n: int): User throws:
    mut u := User {}
    mut r := compress.NewByteReader(data, n)
    until compress.RdLeft(r) > 0:
        mut number := 0
        mut wire := 0
        try protobuf.ReadTag(r, number, wire)
        if number == 1:
            u.id = try protobuf.ReadVarint(r) as int
        else number == 2:
            u.name = try protobuf.ReadLenPrefixedStr(r)
        else number == 3:
            u.admin = try protobuf.ReadVarint(r) != (0 as u64)
        else:
            println "skipping unknown field", number
            try protobuf.SkipField(r, wire)
        end
    end
    ret u
end

func main throws:
    mut b := compress.NewByteBuf()
    protobuf.WriteTag(b, 1, protobuf.WT_VARINT)
    protobuf.WriteVarint(b, 42 as u64)
    protobuf.WriteTag(b, 9, protobuf.WT_LEN)
    protobuf.WriteLenPrefixedStr(b, "added in v2")
    protobuf.WriteTag(b, 2, protobuf.WT_LEN)
    protobuf.WriteLenPrefixedStr(b, "Sara")
    u := try decodeUser(b.data, b.len)
    println u.id, u.name, u.admin
    try:
        _ := decodeUser(b.data, b.len - 2)
    catch e:
        println "truncated:", e.kind_name(), "|", e.to_str()
    end
    compress.BufFree(b)
end
