import encoding.protobuf
import compress

func readScores(b: compress.ByteBuf): Vector<int> throws:
    mut out := Vector {} as Vector<int>
    mut r := compress.ReaderFromBuf(b)
    until compress.RdLeft(r) > 0:
        mut number := 0
        mut wire := 0
        try protobuf.ReadTag(r, number, wire)
        if number == 1 and wire == protobuf.WT_LEN:
            mut packed := try protobuf.ReadLenPrefixedBuf(r)
            mut pr := compress.ReaderFromBuf(packed)
            try:
                until compress.RdLeft(pr) > 0:
                    out.push(protobuf.ReadVarint(pr) as int)
                end
            catch e:
                compress.BufFree(packed)
                throw e
            end
            compress.BufFree(packed)
        else number == 1 and wire == protobuf.WT_VARINT:
            out.push(try protobuf.ReadVarint(r) as int)
        else:
            try protobuf.SkipField(r, wire)
        end
    end
    ret out
end

func main throws:
    scores := [7, 150, 3]

    mut body := compress.NewByteBuf()
    each s in scores:
        protobuf.WriteVarint(body, s as u64)
    end
    mut packed := compress.NewByteBuf()
    protobuf.WriteTag(packed, 1, protobuf.WT_LEN)
    protobuf.WriteLenPrefixedBytes(packed, body.data, body.len)

    mut unpacked := compress.NewByteBuf()
    each s in scores:
        protobuf.WriteTag(unpacked, 1, protobuf.WT_VARINT)
        protobuf.WriteVarint(unpacked, s as u64)
    end

    println "packed:  ", compress.BufLen(packed), "bytes ->", try readScores(packed)
    println "unpacked:", compress.BufLen(unpacked), "bytes ->", try readScores(unpacked)
    compress.BufFree(unpacked)
    compress.BufFree(packed)
    compress.BufFree(body)
end
