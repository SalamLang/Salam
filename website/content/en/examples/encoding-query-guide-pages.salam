import encoding.query
import str

func page_link(current: str, page: int): str:
    mut m := query.Decode(current)
    query.Set(m, "page", str.FromInt(page))
    ret "/products?" + query.Encode(m)
end

func main:
    current := "category=books&sort=price&tag=new&tag=sale&page=2"
    println "prev:", page_link(current, 1)
    println "next:", page_link(current, 3)
    println "first visit:", page_link("category=books", 2)
end
