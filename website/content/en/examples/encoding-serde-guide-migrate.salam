import encoding.serde
import encoding.json
import encoding.value

func main throws:
    old := `server:
  host: 0.0.0.0
  port: 8080
log:
  level: info
`
    as_toml := try serde.TranscodeStrict(old, "yaml", "toml")
    print as_toml

    before := try json.Decode(try serde.TranscodeStrict(old, "yaml", "json"))
    after := try json.Decode(try serde.TranscodeStrict(as_toml, "toml", "json"))
    println "same data:", value.Equal(before, after)
end
