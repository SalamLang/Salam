import encoding.serde

func main:
    old := `server:
  host: 0.0.0.0
  port: 8080
log:
  level: info
`
    mut ok := false
    as_toml := serde.TranscodeStrict(old, "yaml", "toml", ok)
    println "converted:", ok
    print as_toml

    back := serde.TranscodeStrict(as_toml, "toml", "json", ok)
    println "same data:", back == serde.Transcode(old, "yaml", "json")
end
