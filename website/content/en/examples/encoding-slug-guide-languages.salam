import encoding.slug

func show(title: str):
    println slug.DetectScript(title) + ":", slug.Make(title)
end

func main:
    show("Привет, мир! Щука и Ёж")
    show("Київ Їжак Ґанок")
    show("Ελληνικά: Καλημέρα κόσμε")
    show("Ağaç ışık İstanbul şeker")
    show("Zażółć gęślą jaźń Łódź")
    show("Nguyễn Thị Minh Khai Đà Nẵng")
    show("שלום עולם")
    show("हिन्दी भारत नमस्ते")
    show("สวัสดี ครับ")
    show("こんにちは ラーメン")
    show("안녕하세요 한국어")
    show("你好 世界")
end
