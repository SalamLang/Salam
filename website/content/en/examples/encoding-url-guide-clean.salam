import encoding.url

func clean(raw: str): str throws:
    mut u := try url.Parse(raw)
    names := try url.ParamNames(u)
    each n in names:
        if n.StartsWith("utm_") or n == "fbclid" or n == "gclid":
            _ := try url.RemoveParam(u, n)
        end
    end
    u.fragment = ""
    ret url.String(u)
end

func main:
    links := ["https://shop.example/item/42?color=red&utm_source=news&utm_medium=email#reviews", "https://blog.example/post?fbclid=IwAR0abc", "https://example.com/search?q=salam%20lang&utm_campaign=fall&page=2&debug", "https://example.com/sale?off=50%"]
    each link in links:
        try:
            println clean(link)
        catch e:
            println "skipped:", e.ToStr()
        end
    end
end
