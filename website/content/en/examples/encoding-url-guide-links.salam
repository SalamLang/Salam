import encoding.url

func main throws:
    page := try url.Parse("https://docs.example.com/guide/start/index.html?lang=en")
    hrefs := ["install.html", "./setup/linux.html", "../api/json.html", "/blog/", "https://other.example/x", "//cdn.example.com/app.js", "?lang=fa", "#install"]
    each h in hrefs:
        println h, "->", url.String(try url.Join(page, h))
    end
end
