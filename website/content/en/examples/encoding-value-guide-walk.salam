import encoding.value
import encoding.json
import encoding.encerr
import sort
import str

func walk(v: value.Value, path: str):
    if value.IsObject(v):
        keys := value.ObjectKeys(v)
        sort.QuickSort(keys)
        each k in keys:
            walk(value.ObjectGet(v, k), path + "." + k)
        end
    else value.IsArray(v):
        repeat value.ArrayLen(v) in i:
            walk(value.ArrayGet(v, i), path + "[" + str.FromInt(i) + "]")
        end
    else:
        println path, "=", value.ToDebugString(v)
    end
end

func main:
    mut e := encerr.NoError()
    doc := json.Decode(`{"order": 1042, "customer": {"name": "Sara", "vip": true}, "lines": [{"sku": "BK-01", "qty": 2}, {"sku": "PN-07", "qty": 1}], "note": null}`, e)
    walk(doc, "$")
end
