import encoding.xml

func main throws:
    text := `<app name="shop">
  <listen host="0.0.0.0" port="8080"/>
  <plugin name="auth" enabled="true"/>
  <plugin name="cache" enabled="false"/>
  <plugin name="search"/>
</app>`
    app := try xml.Decode(text)
    println "app:", xml.Attr(app, "name")
    listen := xml.Child(app, "listen")
    if xml.Found(listen):
        println "listen:", xml.Attr(listen, "host") + ":" + xml.Attr(listen, "port")
    end
    plugins := xml.Children(app, "plugin")
    each p in plugins.items:
        mut enabled := true
        if xml.HasAttr(p, "enabled"):
            enabled = xml.Attr(p, "enabled") == "true"
        end
        println "plugin", xml.Attr(p, "name"), "enabled:", enabled
    end
    println "has a cache element:", xml.Found(xml.Child(app, "cache"))
end
