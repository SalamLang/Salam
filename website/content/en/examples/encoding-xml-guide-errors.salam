import encoding.xml

func check(label: str, text: str):
    mut err := xml.NoError()
    mut d := xml.Parse(text, err)
    if err.ok:
        println label, "ok"
    else:
        println label, xml.ErrorText(err)
    end
    xml.Free(d)
end

func main:
    check("good:      ", "<a><b>1</b></a>")
    check("mismatch:  ", "<a>\n  <b>1</a>")
    check("two roots: ", "<a/><b/>")
    check("bad entity:", "<a>&nope;</a>")
    check("raw amp:   ", "<a>salt & pepper</a>")
    mut err := xml.NoError()
    println "quick check:", xml.WellFormed("<x/>", err), xml.WellFormed("<x>", err)
    println "escaped text:", xml.EscapeText("salt & pepper")
end
