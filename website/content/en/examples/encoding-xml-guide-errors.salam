import encoding.xml

func check(label: str, text: str):
    try:
        mut d := xml.Parse(text)
        println label, "ok"
        xml.Free(d)
    catch e:
        println label, "line " + e.line + ", column " + e.column + ":", e.message
    end
end

func main:
    check("good:      ", "<a><b>1</b></a>")
    check("mismatch:  ", "<a>\n  <b>1</a>")
    check("two roots: ", "<a/><b/>")
    check("bad entity:", "<a>&nope;</a>")
    check("raw amp:   ", "<a>salt & pepper</a>")
    println "quick check:", xml.WellFormed("<x/>"), xml.WellFormed("<x>")
    println "escaped text:", xml.EscapeText("salt & pepper")
end
