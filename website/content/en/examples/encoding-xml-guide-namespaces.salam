import encoding.xml

func main:
    feed := `<feed xmlns="http://www.w3.org/2005/Atom" xmlns:m="http://search.yahoo.com/mrss/">
  <title>Salam videos</title>
  <entry>
    <title>Install Salam</title>
    <m:thumbnail url="https://cdn.example/install.jpg"/>
  </entry>
  <entry>
    <title>Your first web server</title>
    <m:thumbnail url="https://cdn.example/server.jpg"/>
  </entry>
</feed>`
    mut err := xml.NoError()
    mut d := xml.Parse(feed, err)
    if not err.ok:
        println xml.ErrorText(err)
        ret 1
    end
    top := xml.DocumentNode(d)
    println "entries by name:  ", xml.SelectNumber(d, top, "count(//entry)", err)
    println "with prefix m:    ", xml.SelectNumber(d, top, "count(//m:thumbnail)", err)
    println "with prefix media:", xml.SelectNumber(d, top, "count(//media:thumbnail)", err)

    query := "//*[local-name() = 'thumbnail' and namespace-uri() = 'http://search.yahoo.com/mrss/']"
    mut thumbs := xml.Select(d, top, query, err)
    each t in thumbs.items:
        println xml.Name(d, t), "local:", xml.LocalName(d, t), "->", xml.AttributeValue(d, t, "url")
    end
    xml.FreeList(thumbs)

    root := xml.Root(d)
    println "root namespace:", xml.NamespaceURI(d, root)
    xml.Free(d)
end
