import encoding.xml

func main throws:
    feed := `<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>Salam blog</title>
    <item>
      <title>Salam 0.5.5 is out</title>
      <link>https://example.com/posts/055</link>
      <category>release</category>
    </item>
    <item>
      <title>Writing a JSON API</title>
      <link>https://example.com/posts/json-api</link>
      <category>tutorial</category>
    </item>
    <item>
      <title>The Persian keywords</title>
      <link>https://example.com/posts/persian</link>
      <category>tutorial</category>
    </item>
  </channel>
</rss>`
    mut d := try xml.Parse(feed)
    top := xml.DocumentNode(d)
    println "feed:", try xml.SelectString(d, top, "/rss/channel/title")
    println "posts:", try xml.SelectNumber(d, top, "count(//item)")

    mut items := try xml.Select(d, top, "//item[category = 'tutorial']")
    each it in items.items:
        println "-", try xml.SelectString(d, it, "title"), "<" + try xml.SelectString(d, it, "link") + ">"
    end
    xml.FreeList(items)
    xml.Free(d)
end
