import encoding.xml

func main:
    feed := `<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>Salam blog</title>
    <item>
      <title>Salam 0.5.5 is out</title>
      <link>https://example.com/posts/055</link>
      <category>release</category>
    </item>
    <item>
      <title>Writing a JSON API</title>
      <link>https://example.com/posts/json-api</link>
      <category>tutorial</category>
    </item>
    <item>
      <title>The Persian keywords</title>
      <link>https://example.com/posts/persian</link>
      <category>tutorial</category>
    </item>
  </channel>
</rss>`
    mut err := xml.NoError()
    mut d := xml.Parse(feed, err)
    if not err.ok:
        println "bad feed:", xml.ErrorText(err)
        ret 1
    end
    top := xml.DocumentNode(d)
    println "feed:", xml.SelectString(d, top, "/rss/channel/title", err)
    println "posts:", xml.SelectNumber(d, top, "count(//item)", err)

    mut items := xml.Select(d, top, "//item[category = 'tutorial']", err)
    each it in items.items:
        println "-", xml.SelectString(d, it, "title", err), "<" + xml.SelectString(d, it, "link", err) + ">"
    end
    xml.FreeList(items)
    xml.Free(d)
end
