import encoding.xml

func add_url(d &: xml.Document, parent: int, loc: str, changed: str):
    u := xml.CreateElement(d, "url")
    xml.Append(d, parent, u)
    l := xml.CreateElement(d, "loc")
    xml.Append(d, u, l)
    xml.Append(d, l, xml.CreateText(d, loc))
    m := xml.CreateElement(d, "lastmod")
    xml.Append(d, u, m)
    xml.Append(d, m, xml.CreateText(d, changed))
end

func main:
    mut d := xml.NewDocument()
    root := xml.CreateElement(d, "urlset")
    xml.Append(d, xml.DocumentNode(d), root)
    xml.SetAttribute(d, root, "xmlns", "http://www.sitemaps.org/schemas/sitemap/0.9")

    add_url(d, root, "https://example.com/", "2026-10-01")
    add_url(d, root, "https://example.com/search?q=tea&page=2", "2026-10-12")

    mut o := xml.DefaultWriteOptions()
    o.declaration = true
    o.indent = "  "
    print xml.WriteWith(d, o)
    xml.Free(d)
end
