import encoding.xml
import str

func main:
    feed := `<products>
  <product sku="TEA-01" stock="14"><name>Green tea</name><price>4.50</price></product>
  <product sku="CUP-02" stock="0"><name>Glass cup</name><price>7.25</price></product>
  <product sku="POT-03" stock="3"><name>Tea pot &amp; lid</name><price>21.00</price></product>
</products>`
    mut tz := xml.NewXMLTokenizer(feed)
    mut current := ""
    mut inName := false
    mut products := 0
    mut outOfStock := 0
    mut done := false
    until not done:
        tok := xml.NextToken(tz)
        if tok.kind == xml.XMLTokEOF:
            done = true
        else tok.kind == xml.XMLTokStartElement and tok.tag == "product":
            products += 1
            current = tok.attrs.get("sku")
            if tok.attrs.get("stock") == "0": outOfStock += 1 end
        else tok.kind == xml.XMLTokStartElement and tok.tag == "name":
            inName = true
        else tok.kind == xml.XMLTokEndElement and tok.tag == "name":
            inName = false
        else tok.kind == xml.XMLTokText and inName:
            println current, "is", str.Trim(tok.text)
        end
    end
    println products, "products,", outOfStock, "out of stock"
end
