import str

func setting(text: str): int or bool or str:
    if text == "true" or text == "false":
        ret text == "true"
    end
    n := text.to_int()
    if str.FromInt(n as i64) == text:
        ret n
    end
    ret text
end

func describe(v: int or bool or str): str:
    ret match v:
        int n: "number " + str.FromInt(n as i64) end
        bool b: "flag " + (b ? "on" : "off") end
        str s: "text " + s end
    end
end

func main:
    each text in ["8080", "true", "localhost"]:
        println describe(setting(text))
    end
end
