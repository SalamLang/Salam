import excel
import time

func show(label: str, epoch: i64):
    println label, time.YearUTC(epoch), time.MonthUTC(epoch), time.DayUTC(epoch)
end

func main:
    start := 1774008000 as i64
    finish := 1775131200 as i64
    mut book := excel.NewWorkbook()
    mut s := book.add_sheet("project")
    s.set_string(0, 0, "Start")
    s.set_date(0, 1, start)
    s.set_string(1, 0, "Finish")
    s.set_date(1, 1, finish)
    s.set_formula(2, 1, "B2-B1", excel.EpochToSerial(finish) - excel.EpochToSerial(start))
    book.save("plan.xlsx")
    mut ok := false
    mut err := ""
    mut back := excel.Open("plan.xlsx", ok, err)
    sheet := back.sheet("project")
    cell := sheet.get_cell(0, 1)
    println "kind is date:", cell.kind == excel.CellDate
    println "serial number:", cell.num
    show("start:", excel.SerialToEpoch(cell.num))
    show("finish:", excel.SerialToEpoch(sheet.get_number(1, 1)))
    println "days between:", sheet.get_number(2, 1)
    println "serial of 1970-01-01:", excel.EpochToSerial(0)
    back.free()
    book.free()
    ret 0
end
