import excel
import io

func export_sheets(path: str): int:
    mut ok := false
    mut err := ""
    mut book := excel.Open(path, ok, err)
    if ok == false:
        println "cannot open", path, ":", err
        ret 0
    end
    names := book.sheet_names()
    each i, name in names:
        out := name + ".csv"
        io.WriteFile(out, excel.SheetToCSV(book.sheets.get(i)))
        println "wrote", out
    end
    book.free()
    ret names.len()
end

func main:
    mut book := excel.NewWorkbook()
    mut users := book.add_sheet("users")
    users.set_string(0, 0, "name")
    users.set_string(0, 1, "note")
    users.set_string(1, 0, "Ali")
    users.set_string(1, 1, "likes tea, not coffee")
    mut stock := book.add_sheet("stock")
    stock.set_string(0, 0, "item")
    stock.set_string(0, 1, "count")
    stock.set_string(1, 0, "pen")
    stock.set_int(1, 1, 40)
    excel.WriteODS(book, "office.ods")
    println "format is ods:", excel.DetectFormat("office.ods") == excel.FormatODS
    println "sheets exported:", export_sheets("office.ods")
    println io.ReadFile("users.csv")
    println io.ReadFile("stock.csv")
    println "sheets exported:", export_sheets("nothing.xlsx")
    book.free()
    ret 0
end
