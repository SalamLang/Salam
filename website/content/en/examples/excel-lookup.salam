import excel

func value_at(sheet: excel.Sheet, ref: str): str:
    mut row := 0
    mut col := 0
    if excel.ParseCellRef(ref, row, col) == false: ret "bad reference" end
    if sheet.has_cell(row, col) == false: ret "empty" end
    ret sheet.get_string(row, col)
end

func main:
    mut s := excel.CSVToSheet("order,city,item\n101,Tehran,pen\n102,Tabriz,book\n103,Tehran,book\n104,Shiraz,pen\n", "orders")
    println "C3 =", value_at(s, "C3"), "| A9 =", value_at(s, "A9"), "| 3C =", value_at(s, "3C")
    rows := s.filter_rows_equals(1, "Tehran")
    each r in rows:
        println "Tehran order", s.get_string(r, 0), "is a", s.get_string(r, 2)
    end
    hits := s.find("book")
    println "book appears", hits.len(), "times"
    city := excel.ColumnIndex("B")
    println "column B holds", s.get_column(city).len(), "cells, the last column is", excel.ColumnLabel(s.col_count() - 1)
    s.free()
    ret 0
end
