import excel

func header_col(sheet: excel.Sheet*, name: str): int:
    repeat sheet.col_count() in c:
        if sheet.get_string(0, c) == name: ret c end
    end
    ret -1
end

func make_file():
    mut book := excel.NewWorkbook()
    s := book.add_sheet("grades")
    each c, title in ["Name", "City", "Score"]: s.set_string(0, c, title) end
    s.set_string(1, 0, "Ali")
    s.set_string(1, 1, "Tehran")
    s.set_number(1, 2, 17.5)
    s.set_string(2, 0, "Sara")
    s.set_string(2, 1, "Shiraz")
    s.set_number(2, 2, 19)
    s.set_string(4, 0, "Reza")
    s.set_string(4, 2, "absent")
    book.save("grades.xlsx")
    book.free()
end

func main:
    make_file()
    mut ok := false
    mut err := ""
    mut book := excel.Open("grades.xlsx", ok, err)
    if ok == false:
        println "cannot open:", err
        ret 1
    end
    sheet := book.sheet_at(0)
    name_col := header_col(sheet, "Name")
    score_col := header_col(sheet, "Score")
    mut total := 0.0
    mut counted := 0
    repeat sheet.row_count() - 1 in i:
        r := i + 1
        if sheet.has_cell(r, name_col) == false: continue end
        cell := sheet.get_cell(r, score_col)
        if cell.kind != excel.CellNumber:
            println sheet.get_string(r, name_col), "skipped:", sheet.get_string(r, score_col)
            continue
        end
        println sheet.get_string(r, name_col), cell.num
        total += cell.num
        counted += 1
    end
    println "average of", counted, "=", total / (counted as f64)
    book.free()
    ret 0
end
