import excel

func main:
    mut book := excel.NewWorkbook()
    mut sheet := book.add_sheet("March")
    title := book.styles.get_or_add(excel.Style { bold = true, font_size = 14, align_h = excel.AlignCenter })
    head := book.styles.get_or_add(excel.Style { bold = true, bg_color = "DDEBF7" })
    money := book.styles.get_or_add(excel.Style { num_format = "#,##0.00" })
    sheet.set_string(0, 0, "Sales, March 2026")
    sheet.merge_cells(0, 0, 0, 3)
    sheet.set_style(0, 0, title)
    each col, name in ["Item", "Qty", "Price", "Total"]:
        sheet.set_string(1, col, name)
        sheet.set_style(1, col, head)
    end
    items := ["Tea", "Sugar", "Rice"]
    qty := [12, 30, 5]
    price := [4.5, 1.25, 9.8]
    mut sum := 0.0
    repeat 3 in i:
        r := i + 2
        line := (qty[i] as f64) * price[i]
        sheet.set_string(r, 0, items[i])
        sheet.set_int(r, 1, qty[i] as i64)
        sheet.set_number(r, 2, price[i])
        sheet.set_formula(r, 3, excel.CellRef(r, 1) + "*" + excel.CellRef(r, 2), line)
        sheet.set_style(r, 3, money)
        sum += line
    end
    sheet.set_string(5, 2, "Sum")
    sheet.set_formula(5, 3, "SUM(D3:D5)", sum)
    sheet.set_style(5, 3, money)
    println "saved:", book.save("march.xlsx")
    mut ok := false
    mut err := ""
    mut back := excel.Open("march.xlsx", ok, err)
    s := back.sheet("March")
    println s.get_string(0, 0), "merged:", s.is_merged(0, 3)
    println s.get_formula(5, 3), "=", s.get_number(5, 3)
    println "D3 style:", back.styles.get(s.get_cell(2, 3).style_id).num_format
    back.free()
    book.free()
    ret 0
end
