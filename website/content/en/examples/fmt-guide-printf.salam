import fmt

func row(name: str, value: f64):
    println fmt.PadRight(name, 10),
        fmt.FormatFloat(value, "%10.3f"),
        fmt.FormatFloat(value, "%12.4e"),
        fmt.FormatFloat(value, "%g")
end

func main:
    row("pi", 3.14159265358979)
    row("light", 299792458.0)
    row("electron", 0.000000000000000000160218)
    row("change", -0.0425)
    println fmt.FormatFloat(0.125, "%.2f"),
        fmt.FormatFloat(0.135, "%.2f"),
        fmt.FormatFloat(2.5, "%.0f")
    println "#" + fmt.FormatInt(255, "%02x") + fmt.FormatInt(165, "%02x") + fmt.FormatInt(0, "%02x")
    println fmt.FormatInt(42, "%+06d"), fmt.FormatInt(5, "%#b"), fmt.FormatInt(8, "%#o")
end
