func line total(price: int, quantity: int): int:
    ret price * quantity
end

func show line(name: str, amount: int):
    println name + ":", amount
end

func main:
    tea := line total(45, 2)
    cake := line total(120, 1)
    show line("tea", tea)
    show line("cake", cake)
    show line("total", tea + cake)
end
