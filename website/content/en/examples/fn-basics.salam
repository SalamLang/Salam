func line_total(price: int, quantity: int): int:
    ret price * quantity
end

func show_line(name: str, amount: int):
    println name + ":", amount
end

func main:
    tea := line_total(45, 2)
    cake := line_total(120, 1)
    show_line("tea", tea)
    show_line("cake", cake)
    show_line("total", tea + cake)
end
