func check username(name: str): str:
    if len(name) < 3:
        ret "too short"
    end
    if len(name) > 12:
        ret "too long"
    end
    if name == "admin":
        ret "reserved"
    end
    ret "ok"
end

func greet(name: str):
    if check username(name) != "ok":
        println "cannot greet", name
        ret
    end
    println "welcome,", name
end

func main:
    println check username("al")
    println check username("administrator")
    println check username("admin")
    greet("mina")
    greet("x")
end
