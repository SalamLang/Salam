func enough stock(stock: int, ordered: int): bool:
    if ordered > stock:
        printerrln "not enough stock:", ordered, "ordered,", stock, "left"
        ret false
    end
    ret true
end

func main:
    defer println "order log closed"
    if not enough stock(12, 5):
        ret 1
    end
    println "order accepted"
end
