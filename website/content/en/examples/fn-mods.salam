pure func net_price(price: int, discount: int): int:
    ret price - price * discount / 100
end

inline func square(n: int): int:
    ret n * n
end

noinline func receipt_line(name: str, amount: int): str:
    ret name + ": " + amount
end

func main:
    println net_price(200, 15), square(9)
    println receipt_line("tea", net_price(90, 10))
end
