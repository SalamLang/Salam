import os

noret func fail(message: str):
    printerrln "error:", message
    os.Exit(2)
end

func check_age(age: int): int:
    if age < 0 or age > 150:
        fail("impossible age " + age)
    end
    ret age
end

func main:
    println check_age(34)
end

pub deprecated func old_total(a: int, b: int): int:
    ret a + b
end
