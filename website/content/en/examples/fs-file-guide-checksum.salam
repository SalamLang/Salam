import fs

func verify(p: str): bool:
    want := fs.ReadText(p.concat(".sha256")).trim()
    ret fs.Sha256Hex(p) == want
end

func main:
    fs.WriteBytes("release.tar", "pretend this is a release archive")
    fs.WriteText("release.tar.sha256", fs.Sha256Hex("release.tar").concat("\n"))
    println "intact:", verify("release.tar")
    fs.Append("release.tar", "!")
    println "after a change:", verify("release.tar")
    fs.Delete("release.tar")
    fs.Delete("release.tar.sha256")
end
