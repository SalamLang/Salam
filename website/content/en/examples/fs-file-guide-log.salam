import fs.file

func log(line: str):
    file.Append("app.log", line.concat("\n"))
end

func main:
    log("started")
    log("loaded 3 orders")
    log("sent invoice 1042")
    log("stopped")
    lines := file.ReadLines("app.log")
    println "log has", lines.len(), "lines,", file.Size("app.log"), "bytes"
    println "last two:"
    mut i := lines.len() - 2
    until i < lines.len():
        println " ", lines.get(i)
        i += 1
    end
    file.Delete("app.log")
end
