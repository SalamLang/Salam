import fs

func log(line: str):
    fs.Append("app.log", line.concat("\n"))
end

func main:
    log("started")
    log("loaded 3 orders")
    log("sent invoice 1042")
    log("stopped")
    lines := fs.ReadLines("app.log")
    println "log has", lines.len(), "lines,", fs.Size("app.log"), "bytes"
    println "last two:"
    mut i := lines.len() - 2
    until i < lines.len():
        println " ", lines.get(i)
        i++
    end
    fs.Delete("app.log")
end
