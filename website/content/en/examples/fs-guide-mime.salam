import fs

func main:
    each name in ["index.html", "app.js", "logo.SVG", "photo.jpeg", "data.json", "notes", "backup.7z"]:
        ext := fs.Extension(name)
        if ext == "": println name, "(no extension)", fs.MimeType(name)
        else: println name, ext, fs.MimeType(name)
        end
    end
end
