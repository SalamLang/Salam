import fs

func octal(p: int): str:
    ret "0o" + ((p >> 6) & 7) + ((p >> 3) & 7) + (p & 7)
end

func main:
    fs.WriteText("token.txt", "s3cr3t")
    fs.Chmod("token.txt", 0o644)
    println "before:", octal(fs.Permissions("token.txt"))
    fs.Chmod("token.txt", 0o600)
    p := fs.Permissions("token.txt")
    println "after: ", octal(p)
    if (p & 0o077) == 0:
        println "only the owner can read it"
    end
    fs.Delete("token.txt")
end
