import fs

func letters(digit: int): str:
    mut out := ""
    if digit >= 4: out += "r" else: out += "-" end
    if digit % 4 >= 2: out += "w" else: out += "-" end
    if digit % 2 == 1: out += "x" else: out += "-" end
    ret out
end

func show(p: int): str:
    ret letters(p / 100) + letters(p / 10 % 10) + letters(p % 10)
end

func main:
    fs.WriteText("deploy.sh", "echo deploying\n")
    each mode in [0o755, 0o750, 0o644, 0o600]:
        fs.Chmod("deploy.sh", mode)
        p := fs.Permissions("deploy.sh")
        println p, show(p)
    end
    fs.Delete("deploy.sh")
end
