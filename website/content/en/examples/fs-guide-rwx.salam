import fs

func letters(digit: int): str:
    mut out := ""
    if (digit & 4) != 0: out += "r" else:
        out += "-"
    end
    if (digit & 2) != 0: out += "w" else:
        out += "-"
    end
    if (digit & 1) != 0: out += "x" else:
        out += "-"
    end
    ret out
end

func show(p: int): str:
    ret letters((p >> 6) & 7) + letters((p >> 3) & 7) + letters(p & 7)
end

func octal(p: int): str:
    ret "0o" + ((p >> 6) & 7) + ((p >> 3) & 7) + (p & 7)
end

func main:
    fs.WriteText("deploy.sh", "echo deploying\n")
    each mode in [0o755, 0o750, 0o644, 0o600]:
        fs.Chmod("deploy.sh", mode)
        p := fs.Permissions("deploy.sh")
        println octal(p), show(p)
    end
    fs.Delete("deploy.sh")
end
