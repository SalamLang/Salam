import fs
import os.error

func save(p: str, data: str): bool:
    if fs.Exists(p): fs.Copy(p, p.concat(".bak")) end
    if fs.AtomicWrite(p, data) != 0:
        println "save failed:", error.LastMessage()
        ret false
    end
    ret true
end

func main:
    save("profile.json", "{\"name\": \"Sara\"}")
    save("profile.json", "{\"name\": \"Sara\", \"city\": \"Tabriz\"}")
    println "current:", fs.ReadText("profile.json")
    println "backup: ", fs.ReadText("profile.json.bak")
    println "temp file left:", fs.Exists("profile.json.tmp")
    save("no-such-dir/profile.json", "{}")
    fs.Delete("profile.json")
    fs.Delete("profile.json.bak")
end
