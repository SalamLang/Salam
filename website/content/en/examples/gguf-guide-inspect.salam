import ai.gguf
import os
import str

func main:
    args := os.Args()
    if args.Len() < 2:
        println "usage: gguf-guide-inspect model.gguf"
        ret 1
    end
    mut g := gguf.Gguf {}
    try:
        g = gguf.LoadGguf(args.Get(1))
    catch e:
        println "not a GGUF model:", e.ToStr()
        ret 1
    end
    arch := g.MetaStr("general.architecture")
    println "name", g.MetaStr("general.name")
    println "architecture", arch
    println "layers", g.MetaInt(arch + ".block_count", 0)
    println "context", g.MetaInt(arch + ".context_length", 0)
    println "embedding", g.MetaInt(arch + ".embedding_length", 0)
    vocab := g.MetaIndex("tokenizer.ggml.tokens")
    if vocab >= 0:
        println "vocabulary", g.values.Get(vocab).strs.Len()
    end
    mut weights := 0 as i64
    mut bytes := 0 as i64
    mut kinds := HashMap {} as HashMap<int, int>
    repeat g.tensors.Len() in i:
        info := g.tensors.Get(i)
        weights += info.Count() as i64
        bytes += gguf.TensorBytes(g, i) as i64
        if kinds.Has(info.ggml_type):
            kinds.Put(info.ggml_type, kinds.Get(info.ggml_type) + 1)
        else:
            kinds.Put(info.ggml_type, 1)
        end
    end
    println g.tensors.Len(),
        "tensors,",
        weights / 1000000,
        "million weights,",
        bytes / 1048576,
        "MiB"
    println "tensors stored as Q8_0:",
        kinds.Has(gguf.GGML_Q8_0),
        "Q4_0:",
        kinds.Has(gguf.GGML_Q4_0),
        "F16:",
        kinds.Has(gguf.GGML_F16)
    println "uses a chat template:", str.Contains(g.MetaStr("tokenizer.chat_template"), "{%")
    g.Free()
end
