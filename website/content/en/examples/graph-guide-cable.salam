import graph

func main:
    offices := ["HQ", "North", "South", "East", "West"]
    mut sites := graph.NewUndirected(5)
    defer sites.free()
    each i, name in offices:
        sites.set_name(i, name)
    end
    sites.add_weighted(0, 1, 4.0)
    sites.add_weighted(0, 2, 3.0)
    sites.add_weighted(0, 3, 6.0)
    sites.add_weighted(0, 4, 5.0)
    sites.add_weighted(1, 3, 2.0)
    sites.add_weighted(2, 4, 2.5)
    sites.add_weighted(3, 4, 7.0)
    sites.build()

    mut chosen := Vector {} as Vector<int>
    defer chosen.free()
    total := graph.Kruskal(sites, chosen)
    println "lay", chosen.len(), "cables,", total, "km in all:"
    each e in chosen:
        println "  " + sites.name(sites.edge_from(e)), "-", sites.name(sites.edge_to(e)), sites.edge_weight(e), "km"
    end
    println "every candidate together:", graph.TotalWeight(sites), "km"

    mut tree := graph.MinimumSpanningTree(sites)
    defer tree.free()
    print graph.ToMermaid(tree)
end
