import graph

func main:
    mut net := graph.FromEdgeList("0 1\n1 2\n2 0\n2 3\n3 4\n4 5\n5 3\n6 7", 8, false)
    defer net.free()
    println net.order(), "machines,", net.size(), "links"
    println "connected:", graph.IsConnected(net), "parts:", graph.ComponentCount(net)
    sizes := graph.ComponentSizes(net)
    println "part sizes:", sizes

    mut comp := Vector {} as Vector<int>
    defer comp.free()
    _ := graph.Components(net, comp)
    println "machine 7 is in part", comp.get(7), "with machine 6:", comp.get(6) == comp.get(7)

    cut := graph.ArticulationPoints(net)
    println "machines that split the network if they fail:", cut
    bridges := graph.Bridges(net)
    each e in bridges:
        println "single link:", net.edge_from(e), "-", net.edge_to(e)
    end
end
