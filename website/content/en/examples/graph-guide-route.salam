import graph

func route_text(g &: graph.Graph, path: Vector<int>): str:
    mut text := ""
    each i, node in path:
        if i > 0: text = text + " -> " end
        text = text + g.name(node)
    end
    ret text
end

func main:
    mut roads := graph.NewUndirected(6)
    defer roads.free()
    each i, city in ["Tehran", "Qom", "Kashan", "Isfahan", "Arak", "Yazd"]:
        roads.set_name(i, city)
    end
    roads.add_weighted(0, 1, 140.0)
    roads.add_weighted(1, 2, 105.0)
    roads.add_weighted(2, 3, 210.0)
    roads.add_weighted(1, 4, 135.0)
    roads.add_weighted(4, 3, 280.0)
    roads.add_weighted(3, 5, 320.0)
    roads.add_weighted(2, 5, 560.0)
    roads.build()

    trip := graph.ShortestPath(roads, 0, 5)
    println route_text(roads, trip), "|", graph.ShortestPathLength(roads, 0, 5), "km"
    hops := graph.HopPath(roads, 0, 5)
    println "fewest stops:", route_text(roads, hops)
    dist := graph.DijkstraDist(roads, 0)
    each i, d in dist:
        println "  Tehran to", roads.name(i), d, "km"
    end
end
