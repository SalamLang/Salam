import graph

func main:
    tasks := ["design", "database", "backend", "frontend", "tests", "release"]
    days := [3.0, 2.0, 5.0, 4.0, 2.0, 1.0]
    mut plan := graph.NewDirected(6)
    defer plan.free()
    each i, name in tasks:
        plan.set_name(i, name)
    end
    each pair in ["0 1", "0 3", "1 2", "2 4", "3 4", "4 5"]:
        parts := pair.split(" ")
        from := parts.get(0).to_int()
        plan.add_weighted(from, parts.get(1).to_int(), days[from])
    end
    plan.build()

    mut order := Vector {} as Vector<int>
    defer order.free()
    if graph.TopologicalSort(plan, order) == false:
        println "the plan has a cycle"
        ret 1
    end
    mut line := "order:"
    each t in order:
        line = line + " " + plan.name(t)
    end
    println line

    mut layer := Vector {} as Vector<int>
    defer layer.free()
    stages := graph.TopologicalLayers(plan, layer)
    println "stages:", stages
    each i, name in tasks:
        println "  stage", layer.get(i), name
    end

    critical := graph.CriticalPath(plan)
    mut path := "critical path:"
    each t in critical:
        path = path + " " + plan.name(t)
    end
    println path
end
