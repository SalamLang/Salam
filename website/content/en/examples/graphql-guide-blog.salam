import graphql
import encoding.value

mut authors := value.NewValueArray()
mut posts := value.NewValueArray()

func person(id: i64, name: str): value.Value:
    mut a := value.NewValueObject()
    value.ObjectSet(a, "id", value.ValueInt(id))
    value.ObjectSet(a, "name", value.ValueString(name))
    ret a
end

func post(id: i64, title: str, author_id: i64): value.Value:
    mut p := value.NewValueObject()
    value.ObjectSet(p, "id", value.ValueInt(id))
    value.ObjectSet(p, "title", value.ValueString(title))
    value.ObjectSet(p, "authorId", value.ValueInt(author_id))
    ret p
end

func all_posts(slot: i64):
    graphql.Resolve(slot, posts)
end

func post_author(slot: i64):
    wanted := value.AsInt(graphql.ParentField(slot, "authorId"))
    repeat value.ArrayLen(authors) in i:
        a := value.ArrayGet(authors, i)
        if value.AsInt(value.ObjectGet(a, "id")) == wanted:
            graphql.Resolve(slot, a)
            ret
        end
    end
    graphql.ResolveNull(slot)
end

func main:
    value.ArrayPush(authors, person(1, "Sara"))
    value.ArrayPush(authors, person(2, "Omid"))
    value.ArrayPush(posts, post(10, "Hello GraphQL", 1))
    value.ArrayPush(posts, post(11, "Salam and SQL", 2))
    value.ArrayPush(posts, post(12, "Resolvers explained", 1))
    mut err := graphql.NewError(graphql.ERR_SYNTAX, "")
    mut s := graphql.ParseSchema(`
type Author { id: Int! name: String! }
type Post { id: Int! title: String! author: Author }
type Query { posts: [Post!]! }`, err)
    _ := graphql.SetResolver(s, "Query", "posts", all_posts)
    _ := graphql.SetResolver(s, "Post", "author", post_author)
    mut r := graphql.Run(s, `{ posts { title author { name } } }`)
    println graphql.ResultToJSONStable(r)
    graphql.FreeResult(r)
    mut r2 := graphql.Run(s, `{ posts { id } }`)
    println graphql.ResultToJSONStable(r2)
    graphql.FreeResult(r2)
    graphql.FreeSchema(s)
end
