import graphql
import encoding.value

func user_of(slot: i64): str:
    ctx := graphql.Context(slot)
    if value.IsObject(ctx) and value.ObjectHas(ctx, "user"):
        ret value.AsString(value.ObjectGet(ctx, "user"))
    end
    ret ""
end

func me(slot: i64):
    name := user_of(slot)
    if name == "":
        graphql.ResolveNull(slot)
        ret
    end
    graphql.ResolveStr(slot, name)
end

func payroll(slot: i64):
    if user_of(slot) != "admin":
        graphql.Fail(slot, "only admin may read the payroll")
        ret
    end
    graphql.ResolveInt(slot, 182000)
end

func ask(s: graphql.Schema, user: str):
    mut ctx := value.NewValueObject()
    if user != "":
        value.ObjectSet(ctx, "user", value.ValueString(user))
    end
    mut r := graphql.ExecuteSource(s, `{ me payroll }`, "", value.ValueNull(), value.ValueNull(), ctx)
    println "[" + user + "]", graphql.ResultToJSONStable(r)
    graphql.FreeResult(r)
end

func main:
    mut err := graphql.NewError(graphql.ERR_SYNTAX, "")
    mut s := graphql.ParseSchema(`type Query { me: String payroll: Int }`, err)
    _ := graphql.SetResolver(s, "Query", "me", me)
    _ := graphql.SetResolver(s, "Query", "payroll", payroll)
    ask(s, "")
    ask(s, "sara")
    ask(s, "admin")
    graphql.FreeSchema(s)
end
