import gui.css

func main:
    mut sheet := css.NewSheet()
    defer sheet.Free()
    _r := sheet.AddRule("nav a:hover", "text-decoration: none")
    mut els := Vector {} as Vector<css.Element>
    els.Push(css.NewElement("page", -1))
    mut nav := css.NewElement("nav", 0)
    nav.base = "display: flex; gap: 8px; padding: 16px"
    nav.AddMedia("(max-width: 600px)", "flex-direction: column; padding: 8px")
    els.Push(nav)
    mut button := css.NewElement("button", 1)
    button.base = "background: #2563eb; color: white; border: none; transition: background 200ms ease-in-out"
    button.hover = "background: #1d4ed8"
    button.active = "transform: scale(0.98)"
    els.Push(button)
    mut link := css.NewElement("link", 1)
    link.AddAttr("href", "/help")
    els.Push(link)
    _n := sheet.Compute(els, css.Env { width = 900.0, height = 700.0 })
    println "wide", css.ValueText(sheet.Style(1), "flex-direction"), css.ValueText(sheet.Style(1), "padding-top")
    println "button", css.ValueText(sheet.Style(2), "background-color"), css.ValueText(sheet.Style(2), "transition-duration")
    top := css.HoverChain(els, 2)
    println "hover touches", sheet.Restyle(els, top), "elements:", css.ValueText(sheet.Style(2), "background-color")
    mut b := els.Ref(2)
    b.pressed = true
    _p := sheet.Restyle(els, 2)
    println "pressed", css.ValueText(sheet.Style(2), "transform")
    top2 := css.HoverChain(els, 3)
    _q := sheet.Restyle(els, top2)
    println "link", css.ValueText(sheet.Style(3), "text-decoration-line"), css.ValueText(sheet.Style(3), "cursor")
    _m := sheet.Compute(els, css.Env { width = 500.0, height = 700.0, dark = true })
    println "narrow", css.ValueText(sheet.Style(1), "flex-direction"), css.ValueText(sheet.Style(1), "padding-top")
    repeat els.Len() in i:
        mut x := els.Ref(i)
        x.Free()
    end
    els.Free()
end
