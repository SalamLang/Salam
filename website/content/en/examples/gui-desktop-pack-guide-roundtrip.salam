import gui.desktop.pack
import os
import io

func main:
    os.MkdirAll("www")
    io.WriteFile("www/index.html", "<h1>Hello</h1>")
    io.WriteFile("www/style.css", "body { margin: 0 }")
    println "packed", pack.PackDir("www", "app.pack", "com.example.app"), "files"
    mut opened := pack.Pack {}
    if not pack.Open("app.pack", "com.example.app", opened):
        println "could not open"
        ret 1
    end
    println "holds", opened.Count()
    page := opened.Read("index.html")
    println "index.html is", page.size, "bytes"
    missing := opened.Read("nothing.txt")
    println "missing found:", missing.data != null
end
