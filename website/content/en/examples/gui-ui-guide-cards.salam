import gui.ui
import gui.style
import gui.paint

func none(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func block(b: ui.Builder, name: str, color: str):
    b.Open("box")
    b.Id(name)
    b.SetText(ui.STATE_BASE, style.P_WIDTH, "90")
    b.SetText(ui.STATE_BASE, style.P_HEIGHT, "50")
    b.SetText(ui.STATE_BASE, style.P_BACKGROUND, color)
    b.SetText(ui.STATE_BASE, style.P_RADIUS, "8")
    b.Close()
end

func view(b: ui.Builder):
    b.Open("box")
    b.SetText(ui.STATE_BASE, style.P_LAYOUT, "row")
    b.SetText(ui.STATE_BASE, style.P_GAP, "12")
    b.SetText(ui.STATE_BASE, style.P_PADDING, "16")
    b.SetText(ui.STATE_BASE, style.P_BACKGROUND, "#f4f6fa")
    block(b, "tea", "#cc3333")
    block(b, "coffee", "#3366aa")
    block(b, "juice", "#33aa55")
    b.Close()
end

func probe(c: paint.Canvas, name: str, x: int, y: int):
    p := c.Pixel(x, y)
    println name, p.r, p.g, p.b
end

func main:
    mut c := ui.RenderPage((): ret none() end, (b: ui.Builder): view(b) end, 400, 120)
    println ui.DumpPage((): ret none() end, (b: ui.Builder): view(b) end, 400, 120)
    probe(c, "tea", 40, 40)
    probe(c, "coffee", 150, 40)
    probe(c, "juice", 260, 40)
    probe(c, "gap", 113, 40)
    c.Free()
end
