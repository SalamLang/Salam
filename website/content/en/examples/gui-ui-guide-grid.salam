import gui.ui
import gui.style

func none(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func cell(b: ui.Builder, name: str, span: str):
    b.Open("box")
    b.Id(name)
    b.SetText(ui.STATE_BASE, style.P_HEIGHT, "40")
    b.SetText(ui.STATE_BASE, style.P_COLUMN_SPAN, span)
    b.Close()
end

func view(b: ui.Builder):
    b.Open("box")
    b.Id("grid")
    b.SetText(ui.STATE_BASE, style.P_LAYOUT, "grid")
    b.SetText(ui.STATE_BASE, style.P_COLUMNS, "1fr, 2fr, 100")
    b.SetText(ui.STATE_BASE, style.P_GAP, "10")
    b.SetText(ui.STATE_BASE, style.P_PADDING, "10")
    cell(b, "a", "1")
    cell(b, "b", "1")
    cell(b, "c", "1")
    cell(b, "wide", "2")
    cell(b, "last", "1")
    b.Close()
end

func main:
    println ui.DumpPage((): ret none() end, (b: ui.Builder): view(b) end, 400, 200)
end
