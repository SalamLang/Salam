import gui.webview
import os

func main:
    args := os.Args()
    mut url := "https://salamlang.github.io/Salam/"
    if args.Len() > 1:
        url = args.Get(1)
    end
    mut win := webview.Create()
    win.SetTitle(url)
    win.SetSize(1280, 800, webview.HINT_NONE)
    win.Navigate(url)
    win.Run()
    if win.IsClosed():
        println "window closed"
    end
    win.Destroy()
end
