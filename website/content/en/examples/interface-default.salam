interface Shape:
    func area(): f64
    func describe(): str:
        ret "area " + this.area()
    end
end

struct Circle:
    pub radius: f64 = 1.0
    pub func area(): f64:
        ret 3.14 * this.radius * this.radius
    end
end

struct Square:
    pub side: f64 = 1.0
    pub func area(): f64:
        ret this.side * this.side
    end
    pub func describe(): str:
        ret "a square with side " + this.side
    end
end

func main:
    println Circle { radius = 2.0 }.describe()
    println Square { side = 3.0 }.describe()
end
