import io
import os
import str

func main:
    io.WriteFile("sales.csv", "item,qty,price\npen,3,12\nnotebook,2,45\nbag,1,180\n")
    f := os.Open("sales.csv", "rb")
    defer io.Close(f)
    header := io.Readline(f)
    println "columns:", header
    mut total := 0
    mut line := io.Readline(f)
    until line != "":
        cols := str.Split(line, ",")
        cost := cols.Get(1).ToInt() * cols.Get(2).ToInt()
        println cols.Get(0), cost
        total += cost
        cols.Free()
        line = io.Readline(f)
    end
    println "total:", total
end
