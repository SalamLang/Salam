import jwt
import str

func report(label: str, token: str, secret: str, o: jwt.Options):
    mut err := 0
    _ := jwt.Verify(token, secret, o, err)
    if err == jwt.JWT_OK:
        println label + ": ok"
    else:
        println label + ": " + jwt.ErrorText(err)
    end
end

func main:
    secret := "a-long-random-secret-for-this-demo"
    mut c := jwt.NewClaims()
    c.sub = "7"
    c.iss = "auth.example.com"
    c.iat = 1790000000
    c.nbf = 1790000000
    c.exp = 1790000900
    mut err := 0
    token := jwt.SignHS256(c, secret, err)

    mut o := jwt.DefaultOptions()
    o.issuer = "auth.example.com"
    o.now = 1790000300
    report("fresh token", token, secret, o)
    report("wrong secret", token, "guess", o)

    parts := str.Split(token, ".")
    forged := parts.get(0) + "." + jwt.B64UrlEncode("{\"sub\":\"1\",\"iss\":\"auth.example.com\"}") + "." + parts.get(2)
    report("edited payload", forged, secret, o)

    o.now = 1790001000
    report("100 s after exp", token, secret, o)
    o.leeway = 120
    report("same, 120 s leeway", token, secret, o)

    o.leeway = 0
    o.now = 1789999000
    report("before nbf", token, secret, o)

    o.now = 1790000300
    o.issuer = "evil.example.com"
    report("other issuer", token, secret, o)

    strong := jwt.SignHS512(c, secret, err)
    mut only256 := jwt.OptionsFor(jwt.JWT_HS256)
    only256.now = 1790000300
    report("HS512 token, HS256 expected", strong, secret, only256)
end
