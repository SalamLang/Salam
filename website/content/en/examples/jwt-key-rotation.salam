import jwt

func secret_for(kid: str): str:
    keys := HashMap {} as HashMap<str, str>
    keys.put("2026-09", "old-secret-kept-for-one-more-week")
    keys.put("2026-10", "current-secret-used-for-new-tokens")
    if keys.has(kid):
        ret keys.get(kid)
    end
    ret ""
end

func check(token: str):
    mut err := 0
    header := jwt.Decode(token, err)
    secret := secret_for(header.kid)
    if secret.len() == 0:
        println "kid", header.kid, "rejected: unknown key"
        ret
    end
    mut o := jwt.DefaultOptions()
    o.now = 1790000100
    t := jwt.Verify(token, secret, o, err)
    println "kid", header.kid, "valid:", t.valid, "user:", t.claims.sub
end

func main:
    mut c := jwt.NewClaims()
    c.sub = "user-17"
    c.iat = 1790000000
    c.exp = 1790003600
    mut err := 0
    old := jwt.SignWithKid(c, jwt.JWT_HS256, "2026-09", "old-secret-kept-for-one-more-week", err)
    fresh := jwt.SignWithKid(c, jwt.JWT_HS256, "2026-10", "current-secret-used-for-new-tokens", err)
    stray := jwt.SignWithKid(c, jwt.JWT_HS256, "2025-01", "a-secret-nobody-has-anymore", err)
    check(old)
    check(fresh)
    check(stray)
end
