import jwt

func secret_for(kid: str): str:
    keys := HashMap {} as HashMap<str, str>
    keys.put("2026-09", "old-secret-kept-for-one-more-week")
    keys.put("2026-10", "current-secret-used-for-new-tokens")
    if keys.has(kid):
        ret keys.get(kid)
    end
    ret ""
end

func check(token: str) throws:
    header := try jwt.Decode(token)
    secret := secret_for(header.kid)
    if secret.Len() == 0:
        println "kid", header.kid, "rejected: unknown key"
        ret
    end
    mut o := jwt.DefaultOptions()
    o.now = 1790000100
    t := try jwt.Verify(token, secret, o)
    println "kid", header.kid, "valid:", t.valid, "user:", t.claims.sub
end

func main throws:
    mut c := jwt.NewClaims()
    c.sub = "user-17"
    c.iat = 1790000000
    c.exp = 1790003600
    old := try jwt.SignWithKid(c, jwt.JWT_HS256, "2026-09", "old-secret-kept-for-one-more-week")
    fresh := try jwt.SignWithKid(c, jwt.JWT_HS256, "2026-10", "current-secret-used-for-new-tokens")
    stray := try jwt.SignWithKid(c, jwt.JWT_HS256, "2025-01", "a-secret-nobody-has-anymore")
    try check(old)
    try check(fresh)
    try check(stray)
end
