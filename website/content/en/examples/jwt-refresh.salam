import jwt

func issue(subject: str, use: str, iat: i64, ttl: i64, secret: str): str throws:
    mut c := jwt.NewClaims()
    c.sub = subject
    c.iat = iat
    c.exp = iat + ttl
    jwt.SetStr(c, "use", use)
    ret try jwt.SignHS256(c, secret)
end

func accept(token: str, want: str, now: i64, secret: str): bool:
    mut o := jwt.DefaultOptions()
    o.now = now
    o.require_exp = true
    mut t := jwt.Token {}
    try:
        t = jwt.Verify(token, secret, o)
    catch e:
        println "  rejected:", e.message
        ret false
    end
    if jwt.Str(t, "use") != want:
        println "  rejected: wanted", want, "but got", jwt.Str(t, "use")
        ret false
    end
    ret true
end

func main throws:
    secret := "server-side-secret-of-at-least-32-bytes"
    login := 1790000000 as i64
    access := try issue("42", "access", login, 900, secret)
    refresh := try issue("42", "refresh", login, 30 * 86400, secret)

    println "request after 5 minutes:", accept(access, "access", login + 300, secret)
    println "request after 20 minutes:", accept(access, "access", login + 1200, secret)
    println "refresh after 20 minutes:", accept(refresh, "refresh", login + 1200, secret)
    new_access := try issue("42", "access", login + 1200, 900, secret)
    println "request with the new token:", accept(new_access, "access", login + 1300, secret)
    println "refresh token used as access:", accept(refresh, "access", login + 1300, secret)
end
