func main:
    word := "salam"
    println lang(), len(word), sizeof(i64)
    println char_code("A"), char_from_code(66), "ab" < "ac"

    mut names := Vector {} as Vector<str>
    defer names.Free()
    names.Push("sara")
    names.Push("reza")
    println names.Len(), names.Get(1), names.Pop()

    mut ages := HashMap {} as HashMap<str, int>
    defer ages.Free()
    ages.Put("sara", 31)
    println ages.Has("sara"), ages.Get("sara"), ages.Size()

    text := "  hello world  ".Trim()
    println text.StartsWith("hello"), text.Find("world"), text.Substr(0, 5)
    println "سلام".Len(), "سلام".CharCount()
end
