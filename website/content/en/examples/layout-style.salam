const ACCENT := "#0f766e"
const GAP := 16

page:
    title = "Pricing"
    global: selector = "body" margin = 0 font = sans end
    section:
        layout = row
        gap = GAP, +, "px"
        padding = GAP, *, 2, +, "px"
        box:
            border = 1px, solid, #ddd
            radius = 12px
            padding = GAP, +, "px"
            heading: size = 2 content = "Free" end
            paragraph: content = "For trying things out" end
        end
        box:
            border = 2px, solid + ACCENT
            radius = 12px
            padding = GAP, +, "px"
            heading: size = 2 content = "Pro" color = ACCENT end
            button:
                content = "Upgrade"
                background = ACCENT
                color = white
                hover background = #115e59
                cursor = "pointer"
            end
        end
    end
end
