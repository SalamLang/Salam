page:
    title = "Pricing"
    section:
        layout = row
        gap = 16
        padding = 32
        box:
            border = 1, solid, #dddddd
            radius = 12
            padding = 16
            heading:
                size = 2
                content = "Free"
            end
            paragraph:
                content = "For trying things out"
            end
        end
        box:
            border = 2, solid, #0f766e
            radius = 12
            padding = 16
            heading:
                size = 2
                content = "Pro"
                color = #0f766e
            end
            button:
                content = "Upgrade"
                background = #0f766e
                color = white
                padding = 8, 16
                radius = 6
                hover background = #115e59
                cursor = pointer
            end
        end
    end
end
