import ai.llm

func show(tok &: llm.Tokenizer, text: str):
    ids := tok.Encode(text)
    mut parts := ""
    each id in ids:
        parts = parts + "[" + tok.TokenText(id) + "]"
    end
    println text, "->", ids.Len(), "tokens", parts
end

func main:
    mut tok := llm.NewTokenizer(llm.TOK_BPE)
    each piece in ["l", "o", "w", "e", "r", "n", "s", "t", "Ġ", "lo", "low", "er", "lower"]:
        _ := tok.AddToken(piece, 0.0)
    end
    tok.AddMerge("l", "o")
    tok.AddMerge("lo", "w")
    tok.AddMerge("e", "r")
    tok.AddMerge("low", "er")
    tok.Finish()
    tok.add_bos = false
    show(tok, "low")
    show(tok, "lower")
    show(tok, "slower")
    show(tok, "newest")
    show(tok, "lower tower")
    println "round trip:", tok.Decode(tok.Encode("lower tower")) == "lower tower"
    tok.Free()
end
