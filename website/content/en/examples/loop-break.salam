func main:
    repeat 1 to 10 in i:
        if i % 2 == 0:
            continue
        end
        if i > 7:
            break
        end
        print i, ""
    end
    println ""
    repeat 3 in a:
        repeat 3 in b:
            if a + b == 3:
                break 2
            end
            println a, b
        end
    end
end
