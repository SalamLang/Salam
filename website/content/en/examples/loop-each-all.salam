func main:
    names := ["Sara", "Reza"]
    each i, name in names:
        println i, name
    end
    mut scores := Vector {} as Vector<int>
    scores.push(18)
    scores.push(20)
    mut total := 0
    each s in scores:
        total += s
    end
    println "total:", total
    mut ages := HashMap {} as HashMap<str, int>
    ages.put("Sara", 30)
    each name, age in ages:
        println name, age
    end
    each i, ch in "سلام":
        println i, ch
    end
    mut line := ""
    each b in "Hi!".bytes():
        line = line + (b as int) + " "
    end
    println line
end
