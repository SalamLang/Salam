func main:
    total_items := 23
    page_size := 10
    mut page := 1
    until true:
        first := (page - 1) * page_size + 1
        mut last := page * page_size
        if last > total_items:
            last = total_items
        end
        println "page", page, "shows items", first, "to", last
        if last == total_items:
            break
        end
        page += 1
    end
end
