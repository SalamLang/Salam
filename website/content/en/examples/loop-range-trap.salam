func countdown(from: int):
    repeat from to 1 in i:
        print i, ""
    end
    println "go"
end

func safe_countdown(from: int):
    if from >= 1:
        repeat from to 1 in i:
            print i, ""
        end
    end
    println "go"
end

func main:
    countdown(3)
    countdown(0)
    safe_countdown(0)
end
