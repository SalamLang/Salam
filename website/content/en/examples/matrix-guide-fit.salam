import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func r(value: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, value), 2)
end

func main:
    mut area := build(5, 1, "50 70 90 110 130")
    mut rent := build(5, 1, "520 690 910 1080 1300")
    mut line := matrix.LinearRegression(area, rent)
    println "rent =", r(line.at(0, 0)), "+", r(line.at(1, 0)), "* area"
    mut design := matrix.Vandermonde(area, 2)
    mut fitted := matrix.MatMul(design, line)
    println "R squared", matrix.ToStringPrec(matrix.Full(1, 1, matrix.RSquared(rent, fitted)), 4)
    println "100 square meters:", r(line.at(0, 0) + line.at(1, 0) * 100.0)

    mut speed := build(6, 1, "40 60 80 100 120 140")
    mut fuel := build(6, 1, "7.1 6.0 5.8 6.4 7.5 9.1")
    mut curve := matrix.LeastSquares(matrix.Vandermonde(speed, 3), fuel)
    a := curve.at(0, 0)
    b := curve.at(1, 0)
    c := curve.at(2, 0)
    best := 0.0 - b / (2.0 * c)
    println "most economical speed", r(best), "uses", r(a + b * best + c * best * best)
    line.free()
    design.free()
    fitted.free()
    curve.free()
end
