import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.ToFloat())
    end
    ret matrix.FromArray(rows, cols, data)
end

func main:
    mut springs := build(3, 3, "20 -10 0 -10 20 -10 0 -10 10")
    mut lu := matrix.Decompose(springs)
    if lu.singular:
        println "the system has no unique solution"
        ret 1
    end
    loads := ["0 0 5", "5 0 0", "1 1 1"]
    each load in loads:
        mut force := build(3, 1, load)
        mut shift := matrix.LUSolve(lu, force)
        println "load", load, "->", matrix.ToStringPrec(matrix.Transpose(shift), 2)
        force.Free()
        shift.Free()
    end
    println "determinant", matrix.ToStringPrec(matrix.Full(1, 1, matrix.Det(springs)), 1)
    lu.Free()
    springs.Free()
end
