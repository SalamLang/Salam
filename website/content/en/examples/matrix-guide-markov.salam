import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func main:
    mut weather := build(3, 3, "0.7 0.2 0.1 0.3 0.4 0.3 0.2 0.3 0.5")
    println "rows sum to one:", matrix.IsRowStochastic(weather, 0.000001)
    mut today := build(1, 3, "1 0 0")
    each days in [1, 2, 7, 30]:
        mut ahead := matrix.MatMul(today, matrix.MatPow(weather, days))
        println "after", days, "days", matrix.ToStringPrec(ahead, 3)
        ahead.free()
    end
    mut rainy := build(1, 3, "0 0 1")
    mut later := matrix.MatMul(rainy, matrix.MatPow(weather, 30))
    println "from a rainy day", matrix.ToStringPrec(later, 3)
    weather.free()
    today.free()
    rainy.free()
    later.free()
end
