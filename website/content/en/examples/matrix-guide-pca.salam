import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func main:
    mut scores := build(6, 4, "18 17 12 11 15 16 10 9 9 10 18 17 12 11 15 16 19 18 9 10 8 9 19 18")
    mut fit := matrix.PCAFit(scores)
    mut share := matrix.ExplainedVariance(fit)
    println "variance explained", matrix.ToStringPrec(share, 3)
    mut first := matrix.SubMatrix(fit.components, 0, 0, 4, 1)
    println "first direction", matrix.ToStringPrec(matrix.Transpose(first), 2)
    mut flat := matrix.PCATransform(fit, scores, 1)
    println "students on it", matrix.ToStringPrec(matrix.Transpose(flat), 1)
end
