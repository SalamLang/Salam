import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func main:
    mut twice := build(2, 2, "1 2 2 4")
    mut b := build(2, 1, "3 6")
    println "singular", matrix.IsSingular(twice), "rank", matrix.RankExact(twice)
    println "Solve gives", matrix.ShapeString(matrix.Solve(twice, b))
    println "consistent", matrix.IsConsistent(twice, b)
    println "one solution", matrix.ToStringPrec(matrix.Transpose(matrix.SolveGeneral(twice, b)), 2)

    mut h := matrix.Hilbert(8)
    println "Hilbert(8) is badly conditioned:", matrix.Cond2(h) > 1000000000.0
    mut x := matrix.Ones(8, 1)
    mut hb := matrix.MatMul(h, x)
    mut back := matrix.Solve(h, hb)
    println "exact match", matrix.AllClose(back, x, 0.0), "close", matrix.AllClose(back, x, 0.0001)

    mut tenth := build(1, 2, "0.1 0.2")
    mut three := matrix.Scale(tenth, 3.0)
    mut expected := build(1, 2, "0.3 0.6")
    println "0.1 * 3 == 0.3 exactly:", matrix.AllClose(three, expected, 0.0), "within MAT_TOL:", matrix.AllClose(three, expected, matrix.MAT_TOL)
end
