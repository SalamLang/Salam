import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func main:
    mut baskets := build(3, 3, "2 1 1 1 3 2 1 0 4")
    mut totals := build(3, 1, "9.5 17 17.5")
    mut prices := matrix.Solve(baskets, totals)
    if prices.is_empty():
        println "the baskets do not pin down the prices"
        ret 1
    end
    names := ["apple", "bread", "cheese"]
    each i, name in names:
        println name, matrix.ToStringPrec(matrix.Row(prices, i), 2)
    end
    mut check := matrix.Residual(baskets, prices, totals)
    println "largest error is tiny:", matrix.MaxAbs(check) < 0.000001
    mut order := build(1, 3, "4 2 1")
    println "4 apples, 2 bread, 1 cheese:", matrix.ToStringPrec(matrix.MatMul(order, prices), 2)
    prices.free()
    check.free()
end
