func zero_first(scores: int[3]):
    scores[0] = 0
end

func zero_first_in_place(scores: int[]):
    scores[0] = 0
end

func main:
    week := [7, 5, 9]
    mut plan := week
    plan[1] = 100
    println week, plan
    zero_first(week)
    println week
    mut live := [7, 5, 9]
    zero_first_in_place(live)
    println live
end
