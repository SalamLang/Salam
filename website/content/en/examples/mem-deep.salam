func free_grid(g: Vector<Vector<int>>):
    each row in g:
        row.Free()
    end
    g.Free()
end

func main:
    seats := Vector {} as Vector<Vector<int>>
    repeat 2 in r:
        row := Vector {} as Vector<int>
        repeat 3 in c:
            row.Push(r * 3 + c + 1)
        end
        seats.Push(row)
    end
    shallow := seats.Copy()
    deep := seats.DeepCopy()
    seats.Get(0).Set(0, 0)
    println seats
    println shallow
    println deep
    shallow.Free()
    free_grid(deep)
    free_grid(seats)
end
