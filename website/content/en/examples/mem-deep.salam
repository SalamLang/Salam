func free_grid(g: Vector<Vector<int>>):
    each row in g:
        row.free()
    end
    g.free()
end

func main:
    seats := Vector {} as Vector<Vector<int>>
    repeat 2 in r:
        row := Vector {} as Vector<int>
        repeat 3 in c:
            row.push(r * 3 + c + 1)
        end
        seats.push(row)
    end
    shallow := seats.copy()
    deep := seats.deep_copy()
    seats.get(0).set(0, 0)
    println seats
    println shallow
    println deep
    shallow.free()
    free_grid(deep)
    free_grid(seats)
end
