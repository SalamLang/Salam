import mem

func make_copy(text: str): u8*:
    n := text.Len() as u64
    p := mem.Allocate(n + (1 as u64)) as u8*
    repeat text.Len() in i:
        p[i] = text[i] as u8
    end
    p[text.Len()] = 0 as u8
    ret p
end

func main:
    a := make_copy("first")
    b := make_copy("second")
    mem.Free(a as void*)
    if mem.IsMemDebug():
        println "allocations:", mem.AllocCount(), "frees:", mem.FreeCount()
        println "bytes still allocated:", mem.LiveBytes()
    else:
        println "build with -DSALAM_MEM_DEBUG to count allocations"
    end
    mem.CheckLeaks()
    mem.Free(b as void*)
end
