func main:
    cart := Vector {} as Vector<str>
    cart.Push("bread")
    cart.Push("milk")
    view := cart
    defer view.Free()
    view.Set(0, "rice")
    view.Push("tea")
    println view

    saved := view.Copy()
    defer saved.Free()
    view.Set(1, "eggs")
    saved.Push("salt")
    println view, saved
end
