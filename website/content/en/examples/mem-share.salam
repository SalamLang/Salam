func main:
    cart := Vector {} as Vector<str>
    defer cart.Free()
    cart.Push("bread")
    cart.Push("milk")
    view := cart
    cart.Set(0, "rice")
    cart.Push("tea")
    println cart, view

    saved := cart.Copy()
    defer saved.Free()
    cart.Set(1, "eggs")
    saved.Push("salt")
    println cart, saved
end
