func main:
    cart := Vector {} as Vector<str>
    defer cart.free()
    cart.push("bread")
    cart.push("milk")
    view := cart
    cart.set(0, "rice")
    cart.push("tea")
    println cart, view

    saved := cart.copy()
    defer saved.free()
    cart.set(1, "eggs")
    saved.push("salt")
    println cart, saved
end
