import ml
import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func f1(number: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, number), 1)
end

func main:
    mut homes := build(8, 3, "50 1 20 65 2 15 80 2 10 90 3 30 100 3 5 120 4 12 140 4 3 160 5 8")
    mut price := build(8, 1, "105 140 178 172 228 260 312 344")

    mut model := ml.LinearReg {}
    defer model.free()
    println "fitted", model.fit(homes, price)
    println "per m2", f1(model.coef.at(0, 0)), "per room", f1(model.coef.at(1, 0)), "per year of age", f1(model.coef.at(2, 0))
    println "base", f1(model.intercept)

    mut pred := model.predict(homes)
    println "R2", matrix.ToStringPrec(matrix.Full(1, 1, ml.R2Score(price, pred)), 3), "RMSE", f1(ml.RMSE(price, pred))

    mut offer := model.predict(build(2, 3, "110 3 10 70 2 25"))
    println "110 m2, 3 rooms, 10 years:", f1(offer.at(0, 0))
    println "70 m2, 2 rooms, 25 years:", f1(offer.at(1, 0))
end
