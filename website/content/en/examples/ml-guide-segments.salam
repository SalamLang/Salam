import ml
import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func main:
    mut customers := build(10, 2, "2 15 3 20 1 10 2 12 12 30 14 35 11 28 4 210 5 250 3 190")

    mut scaler := ml.StandardScaler {}
    defer scaler.free()
    mut scaled := scaler.fit_transform(customers)

    mut km := ml.KMeans { k = 3, seed = 5 }
    defer km.free()
    mut labels := km.fit_predict(scaled)
    println "silhouette", matrix.ToStringPrec(matrix.Full(1, 1, ml.SilhouetteScore(scaled, labels)), 2)

    mut centers := scaler.inverse_transform(km.centers)
    repeat 3 in c:
        mut members := 0
        repeat labels.rows in i:
            if labels.at(i, 0) as int == c: members += 1 end
        end
        println "segment", c, "customers", members, "visits", matrix.ToStringPrec(matrix.Full(1, 1, centers.at(c, 0)), 1), "spend", matrix.ToStringPrec(matrix.Full(1, 1, centers.at(c, 1)), 1)
    end

    mut fresh := scaler.transform(build(1, 2, "13 32"))
    println "new customer joins segment", km.predict(fresh).at(0, 0) as int
end
