import ml
import matrix

func counts(messages: Vector<str>, vocab: Vector<str>): matrix.Matrix:
    mut m := matrix.Zeros(messages.len(), vocab.len())
    each i, text in messages:
        each word in text.split(" "):
            each j, known in vocab:
                if word == known: m.set(i, j, m.at(i, j) + 1.0) end
            end
        end
    end
    ret m
end

func main:
    mut vocab := Vector {} as Vector<str>
    defer vocab.free()
    each w in ["free", "win", "prize", "now", "meeting", "lunch", "report", "tomorrow"]: vocab.push(w) end

    mut train := Vector {} as Vector<str>
    defer train.free()
    each t in ["win a free prize now", "free prize now", "win now win", "meeting tomorrow", "lunch tomorrow", "report for the meeting"]: train.push(t) end
    mut flags := Vector {} as Vector<f64>
    each f in [1.0, 1.0, 1.0, 0.0, 0.0, 0.0]: flags.push(f) end
    mut labels := matrix.FromArray(6, 1, flags)

    mut model := ml.MultinomialNB { alpha = 1.0 }
    defer model.free()
    mut x := counts(train, vocab)
    println "trained", model.fit(x, labels)

    mut inbox := Vector {} as Vector<str>
    defer inbox.free()
    each t in ["free lunch tomorrow", "you win a prize", "send the report tomorrow"]: inbox.push(t) end
    mut pred := model.predict(counts(inbox, vocab))
    each i, text in inbox:
        mut verdict := "inbox"
        if pred.at(i, 0) == 1.0: verdict = "spam" end
        println verdict, "<-", text
    end
end
