import ai.ml
import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.ToFloat())
    end
    ret matrix.FromArray(rows, cols, data)
end

func main:
    mut hours := build(12, 2, "1 4 2 5 2 8 3 6 3 9 4 5 5 7 6 8 7 6 8 7 9 8 10 7")
    mut passed := build(12, 1, "0 0 0 0 1 0 1 1 1 1 1 1")

    mut split := ml.TrainTestSplit(hours, passed, 0.25, 2)
    defer split.Free()
    println "train", matrix.ShapeString(split.x_train), "test", matrix.ShapeString(split.x_test)

    mut scaler := ml.StandardScaler {}
    defer scaler.Free()
    mut train := scaler.FitTransform(split.x_train)
    mut test := scaler.Transform(split.x_test)

    mut model := ml.LogisticRegression { max_iter = 2000 }
    defer model.Free()
    println "trained", model.Fit(train, split.y_train)
    mut pred := model.Predict(test)
    println "accuracy", ml.Accuracy(split.y_test, pred)
    println "confusion", matrix.ToRepr(ml.ConfusionMatrix(split.y_test, pred, 2), 0)

    mut student := scaler.Transform(build(1, 2, "6 6"))
    proba := model.PredictProba(student)
    println "chance to pass", matrix.ToStringPrec(matrix.Full(1, 1, proba.at(0, 1)), 2)
end
