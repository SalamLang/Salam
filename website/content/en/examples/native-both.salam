page:
    title = "One page, two targets"
    if SALAM_UI_WEB:
        meta:
            name = "description"
            content = "A page for the browser."
        end
    end
    box:
        padding = 24
        heading:
            size = 2
            content = "Same page"
        end
        paragraph:
            content = "The meta tag above exists only in the web build."
        end
    end
end
