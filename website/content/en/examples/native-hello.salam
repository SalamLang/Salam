page:
    title = "Hello"
    box:
        align = "center"
        justify = "center"
        gap = 12
        padding = 32
        heading:
            size = 1
            content = "Hello, window"
        end
        paragraph:
            color = "#4b5563"
            content = "This is drawn by Salam, not by a browser."
        end
        button:
            padding = 8, 20
            radius = 6
            background = "#2563eb"
            color = "white"
            hover background = "#1d4ed8"
            content = "Close"
        end
    end
end
