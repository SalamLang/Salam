import net.devreload
import net.http
import net.router

func main:
    if not devreload.InitFromEnv():
        println "set SALAM_DEV_HMR=1 to turn dev reload on"
        ret 0
    end
    mut r := router.NewRouter()
    router.Get(r, "/__salam_hmr", devreload.Handler)
    mut s := http.NewServer(8080)
    http.Use(s, r)
    http.Run(s)
end
