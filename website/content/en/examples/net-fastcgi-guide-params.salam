import net.fastcgi

func main:
    mut p := fastcgi.NewParams()
    defer fastcgi.Free(p)
    fastcgi.Add(p, "GATEWAY_INTERFACE", "CGI/1.1")
    fastcgi.Add(p, "REQUEST_METHOD", "POST")
    fastcgi.Add(p, "SCRIPT_FILENAME", "/srv/app/index.php")
    fastcgi.Add(p, "SCRIPT_NAME", "/index.php")
    fastcgi.Add(p, "QUERY_STRING", "page=2")
    fastcgi.Add(p, "CONTENT_TYPE", "application/json")
    fastcgi.Add(p, "CONTENT_LENGTH", "13")
    each item in p.items:
        println item.name + "=" + item.value
    end
end
