import net.fastcgi
import net.tcp

func main:
    mut p := fastcgi.NewParams()
    defer fastcgi.Free(p)
    fastcgi.Add(p, "GATEWAY_INTERFACE", "CGI/1.1")
    fastcgi.Add(p, "REQUEST_METHOD", "GET")
    fastcgi.Add(p, "SCRIPT_NAME", "/index.php")
    fastcgi.Add(p, "SCRIPT_FILENAME", "/srv/app/index.php")
    fastcgi.Add(p, "QUERY_STRING", "a=1")

    c := fastcgi.Connect("127.0.0.1", 9000, 3000)
    if not tcp.ConnOk(c):
        println "php-fpm is not listening on 127.0.0.1:9000"
        ret 1
    end
    defer tcp.Close(c)

    mut r := fastcgi.Execute(c, p, null, 0, 5000)
    if not r.ok:
        println "failed:", r.error
        ret 1
    end
    println r.status, r.len, "bytes"
    each h in r.headers:
        println h.name + ": " + h.value
    end
    fastcgi.FreeResponse(r)
end
