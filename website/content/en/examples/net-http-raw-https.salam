import net.http
import encoding.json

func main:
    ep := http.ParseEndpoint("https://api.github.com")
    println ep.host, ep.port, ep.secure
    mut head := "GET /repos/SalamLang/Salam HTTP/1.1\r\n"
    head += "Host: api.github.com\r\n"
    head += "User-Agent: salam-example\r\n"
    head += "Accept: application/vnd.github+json\r\n"
    head += "Connection: close\r\n\r\n"
    mut r := http.SendRawTimeout(ep, head, null, 0, 10000)
    defer http.FreeRaw(r)
    body := http.RawText(r)
    if r.status == 0:
        println "request failed:", r.error
        ret 1
    end
    println "status:", r.status
    println "rate limit left:", http.HeaderValue(r.head, "x-ratelimit-remaining")
    if r.ok:
        println json.Get(body, "full_name"), "is written in", json.Get(body, "language")
    end
    ret 0
end
