import net.http2

func request_headers(path: str): http2.HeaderList:
    mut h := http2.HeaderList {}
    http2.HeadersAdd(h, ":method", "GET")
    http2.HeadersAdd(h, ":scheme", "https")
    http2.HeadersAdd(h, ":authority", "shop.example.com")
    http2.HeadersAdd(h, ":path", path)
    http2.HeadersAdd(h, "user-agent", "salam-client/1.0")
    http2.HeadersAdd(h, "accept", "application/json")
    http2.HeadersAddSensitive(h, "authorization", "Bearer eyJhbGciOiJIUzI1NiJ9.e30.x")
    ret h
end

func plain_size(h: http2.HeaderList): int:
    mut n := 0
    each item in h.items:
        n += item.name.len() + item.value.len() + 4
    end
    ret n
end

func main:
    mut table := http2.NewDynTable(4096)
    each path in ["/cart", "/cart/items", "/checkout"]:
        h := request_headers(path)
        block := http2.EncodeHeaderList(table, h, true)
        println path, "as HTTP/1.1 text:", plain_size(h), "bytes, HPACK:", block.len, "bytes, table entries:", http2.DynCount(table)
    end
    println "huffman alone, user-agent value:", "salam-client/1.0".len(), "->", http2.HuffmanEncodedLenStr("salam-client/1.0")
end
