import net.httpd.conf

func check(text: str):
    mut d := conf.Parse(text)
    defer conf.Free(d)
    if d.ok:
        println "ok"
    else:
        println conf.ErrorText(d, "app.salam")
    end
end

func main:
    check("listen = 80\n")
    check("server:\n    site:\n")
    check("names = \"open\n")
    check("listen 80\n")
end
