import net.httpd

func main:
    text := `
server:
    site:
        listen = 70000
        names = "a.test"
        location "/x": hedaer = "A" "b" end
    end
end
`
    if not httpd.LoadText(text, "web.salam"):
        println httpd.ProblemCount(), "problem(s)"
        repeat httpd.ProblemCount() in i:
            println httpd.ProblemAt(i)
        end
    end
end
