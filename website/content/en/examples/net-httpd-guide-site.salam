import os
import io
import str
import net.httpd

func main:
    root := os.TempDir() + "/salam_guide_site"
    os.RemoveAll(root)
    os.MkdirAll(root + "/shop")
    os.MkdirAll(root + "/blog")
    io.WriteFile(root + "/shop/index.html", "shop")
    text := `
server:
    site:
        listen = 8080
        names = "shop.test www.shop.test"
        root = "@ROOT@/shop"
        location "/assets/": cache = 30d end
        location "= /health": return = 200 "ok" end
    end
    site:
        listen = 8080
        names = "*.blog.test"
        root = "@ROOT@/blog"
        default = true
    end
end
`
    ok := httpd.LoadText(str.Replace(text, "@ROOT@", root), "web.salam")
    println ok, httpd.SiteCount()
    println httpd.SiteFor("www.shop.test", 8080), httpd.SiteFor("a.blog.test", 8080), httpd.SiteFor("other.test", 8080)
    println httpd.LocationPattern(httpd.LocationFor(0, "/health"))
    println httpd.LocationFor(0, "/about")
    os.RemoveAll(root)
end
