import net.shadowsocks

func show(name: str):
    m := shadowsocks.LookupMethod(name)
    println m.name, m.ok, m.key_len, m.salt_len, m.v2022
end

func main:
    show("aes-128-gcm")
    show("aes-256-gcm")
    show("chacha20-ietf-poly1305")
    show("2022-blake3-aes-128-gcm")
    show("2022-blake3-aes-256-gcm")
    show("2022-blake3-chacha20-poly1305")
    show("rc4-md5")
end
