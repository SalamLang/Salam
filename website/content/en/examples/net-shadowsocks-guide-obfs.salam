import mem
import net.shadowsocks

mut srv := shadowsocks.Server {}

func answer(c: shadowsocks.Conn):
    buf := mem.Allocate(4096 as u64)
    n := shadowsocks.Read(c, buf, 4096)
    shadowsocks.Write(c, buf, n)
    mem.Free(buf)
    shadowsocks.Close(c)
end

func serve():
    shadowsocks.Serve(srv, (c: shadowsocks.Conn): answer(c) end)
end

func main:
    srv = shadowsocks.ListenObfs(0, "chacha20-ietf-poly1305", "pw", "http")
    t := spawn(serve)

    cfg := shadowsocks.Config { host = "127.0.0.1", port = shadowsocks.ServerPort(srv), method = "chacha20-ietf-poly1305", password = "pw", obfs = "http", obfs_host = "cdn.example.com" }
    c := shadowsocks.Dial(cfg, "example.com", 80)
    shadowsocks.WriteStr(c, "inside an http disguise")
    println shadowsocks.ReadStr(c, 4096)
    shadowsocks.Close(c)

    shadowsocks.Stop(srv)
    join(t)
    shadowsocks.Destroy(srv)
end
