import net.socketio

func main:
    mut o := socketio.NewOptions()
    o.auth = `{"token":"eyJhbGciOiJIUzI1NiJ9.e30.x"}`
    o.reconnection = false
    c := socketio.DialWith("https://chat.example.com", o)
    if socketio.Refused(c):
        println "the server refused us:", socketio.RefusalReason(c)
        ret 1
    end
    if not socketio.IsConnected(c):
        println "could not connect:", socketio.LastError(c)
        ret 1
    end
    println "connected as", socketio.Id(c), "over", socketio.TransportName(c)
    socketio.Close(c)
    ret 0
end
