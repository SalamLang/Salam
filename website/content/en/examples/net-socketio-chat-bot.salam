import net.socketio
import str

mut client := socketio.Client {}

func main:
    mut o := socketio.NewOptions()
    o.reconnection_attempts = 10
    o.reconnection_delay = 2000
    client = socketio.DialWith("http://localhost:3000", o)
    if not socketio.IsConnected(client):
        println "cannot reach the chat:", socketio.LastError(client)
        ret 1
    end

    mut a := socketio.NewArgs()
    socketio.AddStr(a, "support")
    mut k := socketio.EmitAck(client, "join", a, 5000)
    socketio.ArgsFree(a)
    if not k.ok:
        println "joining the room timed out"
        ret 1
    end
    println "joined support, members:", socketio.AckInt(k, 0)
    socketio.AckFree(k)

    socketio.On(client, "message", (e: socketio.Event):
        text := socketio.ArgStr(e, 1)
        if str.StartsWith(text, "!time"):
            _ := socketio.EmitStr(client, "message", "office hours are 9 to 17")
        end
    end)
    socketio.On(client, "disconnect", (e: socketio.Event):
        println "lost the connection:", e.message
    end)
    socketio.On(client, "reconnect", (e: socketio.Event):
        _ := e
        println "back after", socketio.Attempts(client), "attempts"
    end)
    socketio.Run(client)
    ret 0
end
