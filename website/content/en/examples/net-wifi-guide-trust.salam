import net.wifi

func decide(s: wifi.Status, trusted: Vector<str>): str:
    ret match wifi.Classify(s, trusted):
        wifi.Trust.Untrusted: "connect the VPN" end
        wifi.Trust.Trusted: "stay as you are" end
        wifi.Trust.Unknown: "ask the user" end
        wifi.Trust.NotWifi: "not on Wi-Fi" end
    end
end

func main:
    mut trusted := Vector {} as Vector<str>
    defer trusted.Free()
    trusted.Push("Home")
    println decide(wifi.Status { state = wifi.State.Connected, ssid = "Home", ssid_known = true, security = wifi.Security.Wpa2 }, trusted)
    println decide(wifi.Status { state = wifi.State.Connected, ssid = "Airport", ssid_known = true, security = wifi.Security.Open }, trusted)
    println decide(wifi.Status { state = wifi.State.Connected, security = wifi.Security.Wpa2 }, trusted)
    println decide(wifi.Status { state = wifi.State.Connected, security = wifi.Security.Open }, trusted)
    println decide(wifi.Status { state = wifi.State.NoWifi }, trusted)
end
