import ai.nn
import ai.autograd
import ai.tensor
import compress

func build(store &: nn.ParamStore, seed: i64): nn.Sequential:
    mut rng := tensor.NewRng(seed)
    mut model := nn.Sequential {}
    model.add(nn.NewLinear(store, "fc1", 3, 4, rng))
    model.add(nn.GeluLayer {})
    model.add(nn.NewLinear(store, "fc2", 4, 2, rng))
    ret model
end

func run(model &: nn.Sequential, store &: nn.ParamStore, x &: tensor.Tensor): tensor.Tensor:
    mut tape := autograd.NewTape(1)
    out := tensor.Clone(autograd.Value(tape, model.Forward(tape, store, autograd.Input(tape, x))))
    tape.Free()
    ret out
end

func main throws:
    mut x := tensor.Ones(tensor.Shape2(1, 3))
    mut trained := nn.ParamStore {}
    mut first := build(trained, 1)
    mut saved := nn.SaveCheckpointBuf(trained)

    mut fresh := nn.ParamStore {}
    mut second := build(fresh, 99)
    println "before loading, same output:", tensor.AllClose(run(first, trained, x), run(second, fresh, x), 0.000001)
    try nn.LoadCheckpointBuf(saved, fresh)
    mut other := nn.ParamStore {}
    _ := build(other, 5)
    _ := build(other, 6)
    try:
        nn.LoadCheckpointBuf(saved, other)
    catch e:
        println "a different model:", e.ToStr()
    end
    other.Free()
    println "after loading, same output:", tensor.AllClose(run(first, trained, x), run(second, fresh, x), 0.000001)
    println "parameters:", fresh.count()
    compress.BufFree(saved)
    trained.Free()
    fresh.Free()
end
