import nn
import autograd
import optim
import tensor

func main:
    mut rng := tensor.NewRng(5)
    mut points := tensor.Zeros2(60, 2)
    mut labels := Vector {} as Vector<int>
    repeat 60 in i:
        group := i % 3
        labels.push(group)
        cx := (group as f64) * 2.0
        cy := ((group % 2) as f64) * 2.0
        points.set_at2(i, 0, cx + rng.next_normal() * 0.3)
        points.set_at2(i, 1, cy + rng.next_normal() * 0.3)
    end
    mut store := nn.ParamStore {}
    mut model := nn.Sequential {}
    model.add(nn.NewLinear(store, "fc1", 2, 16, rng))
    model.add(nn.ReluLayer {})
    model.add(nn.NewLinear(store, "fc2", 16, 3, rng))
    mut adam := optim.Adam { lr = 0.05 }
    mut tape := autograd.NewTape(1)
    repeat 200:
        tape.reset()
        store.zero_grad()
        logits := model.forward(tape, store, autograd.Input(tape, points))
        loss := autograd.CrossEntropyLogits(tape, logits, labels)
        autograd.Backward(tape, loss)
        adam.step(store)
    end
    tape.reset()
    guesses := tensor.ArgMaxAxis(autograd.Value(tape, model.forward(tape, store, autograd.Input(tape, points))), 1, false)
    mut right := 0
    repeat 60 in i:
        if guesses.at(i) as int == labels.get(i):
            right += 1
        end
    end
    println "correct:", right, "of 60"
    tape.free()
    adam.free()
    store.free()
end
