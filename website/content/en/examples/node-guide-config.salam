import node

func main:
    text := `{"name": "shop", "port": 8080, "debug": true, "db": {"host": "127.0.0.1"}}`
    config := node.CallS1(node.Global("JSON"), "parse", text)
    println "name:", node.GetStr(config, "name")
    println "port:", node.GetNum(config, "port")
    println "debug:", node.GetBool(config, "debug")
    db := node.GetProp(config, "db")
    println "db host:", node.GetStr(db, "host")
    mut workers := 4.0
    if not node.IsNullish(node.GetProp(config, "workers")):
        workers = node.GetNum(config, "workers")
    end
    println "workers:", workers
    node.SetNum(config, "workers", workers)
    println node.ToStr(node.CallV1(node.Global("JSON"), "stringify", config))
end
