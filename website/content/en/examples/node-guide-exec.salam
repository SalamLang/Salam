import node
import str

func main:
    events := node.New0(node.GetProp(node.Require("events"), "EventEmitter"))
    _ := node.CallSFn0(events, "on", "finished", ():
        println "all jobs finished"
    end)
    args := node.NewArray()
    node.PushStr(args, "-e")
    node.PushStr(args, "console.log(6 * 7)")
    node.ExecFile("node", args, node.TmpDir(), (failed: bool, out: str, err: str):
        if failed:
            println "the child failed:", err
            ret
        end
        println "child printed", str.Trim(out)
        _ := node.CallS1(events, "emit", "finished")
    end)
    println "started the child"
end
