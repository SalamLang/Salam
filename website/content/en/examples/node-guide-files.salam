import node
import str

func main:
    folder := node.MkdtempSync(node.PathJoin2(node.TmpDir(), "salam-notes-"))
    node.WriteFileSync(node.PathJoin2(folder, "a.txt"), "one\ntwo\nthree\n")
    node.WriteFileSync(node.PathJoin2(folder, "b.txt"), "only line\n")
    node.WriteFileSync(node.PathJoin2(folder, "c.md"), "# title\n")
    fs := node.Require("fs")
    names := node.CallS1(fs, "readdirSync", folder)
    _ := node.Call0(names, "sort")
    mut total := 0
    repeat node.GetNum(names, "length") as int in i:
        name := node.GetStr(names, str.FromInt(i))
        if not str.EndsWith(name, ".txt"):
            continue
        end
        text := node.ReadFileSync(node.PathJoin2(folder, name))
        lines := str.Count(text, "\n")
        total += lines
        println name, lines
    end
    println "total", total
    node.RmSyncRecursiveForce(folder)
end
