import node
import str

func js_str(s: str): i64:
    box := node.NewArray()
    node.PushStr(box, s)
    ret node.GetProp(box, "0")
end

func slug(text: str): str:
    ret str.Replace(str.Lower(str.Trim(text)), " ", "-")
end

func main:
    exports := node.Exports()
    node.SetStr(exports, "name", "salam-slug")
    node.SetPropFn1R(exports, "slug", (x: i64): ret js_str(slug(node.ToStr(x))) end)
    node.SetPropFn0(exports, "hello", ():
        println "hello from Salam"
    end)
    _ := node.Call0(exports, "hello")
    println node.ToStr(node.Invoke1(node.GetProp(exports, "slug"), js_str("  Hello Salam World ")))
end
