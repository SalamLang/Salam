import node
import str

func main:
    folder := node.MkdtempSync(node.PathJoin2(node.TmpDir(), "salam-orders-"))
    node.WriteFileSync(node.PathJoin2(folder, "orders.csv"), "id,total\n1,40\n2,25\n")
    fsp := node.GetProp(node.Require("fs"), "promises")
    orders := node.CallS2(fsp, "readFile", node.PathJoin2(folder, "orders.csv"), "utf8")
    _ := node.CallFn1(orders, "then", (text: i64):
        println "orders.csv has", str.Count(node.ToStr(text), "\n") - 1, "orders"
        refunds := node.CallS2(fsp, "readFile", node.PathJoin2(folder, "refunds.csv"), "utf8")
        caught := node.CallFn1(refunds, "catch", (err: i64):
            println "refunds.csv failed with", node.GetStr(err, "code")
        end)
        _ := node.CallFn0(caught, "finally", ():
            node.RmSyncRecursiveForce(folder)
            println "temp folder removed"
        end)
    end)
    println "reading started"
end
