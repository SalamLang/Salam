import npy
import matrix

func row(a: f64, b: f64): matrix.Matrix:
    mut m := matrix.Zeros(1, 2)
    m.set(0, 0, a)
    m.set(0, 1, b)
    ret m
end

func load(path: str, key: str, ok &: bool): matrix.Matrix:
    mut arr := npy.NpzRead(path, key, ok)
    mut m := matrix.Matrix {}
    if ok: m = npy.ToMatrix(arr, ok) end
    arr.free()
    ret m
end

func main:
    mut w := matrix.Zeros(2, 2)
    w.set(0, 0, 0.5)
    w.set(0, 1, -1.0)
    w.set(1, 0, 2.0)
    w.set(1, 1, 0.25)
    mut b := row(1.0, 0.0)
    mut keys := Vector {} as Vector<str>
    keys.push("W")
    keys.push("b")
    mut arrays := Vector {} as Vector<npy.NpyArray>
    arrays.push(npy.FromMatrix(w))
    arrays.push(npy.FromMatrix(b))
    println "saved:", npy.NpzWrite("model.npz", keys, arrays)
    mut ok := false
    println "arrays in file:", npy.NpzList("model.npz", ok)
    mut lw := load("model.npz", "W", ok)
    mut lb := load("model.npz", "b", ok)
    mut x := row(3.0, 4.0)
    mut xw := matrix.MatMul(x, lw)
    mut y := matrix.AddRowVector(xw, lb)
    println "prediction:", y.at(0, 0), y.at(0, 1)
    _ := load("model.npz", "gamma", ok)
    println "gamma found:", ok
    repeat arrays.len() in i:
        mut a := arrays.get(i)
        a.free()
    end
    matrix.Free(w)
    matrix.Free(b)
    matrix.Free(lw)
    matrix.Free(lb)
    matrix.Free(x)
    matrix.Free(xw)
    matrix.Free(y)
    ret 0
end
