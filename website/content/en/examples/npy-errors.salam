import npy
import compress
import io

func try_read(path: str):
    mut ok := false
    mut a := npy.ReadNpyFile(path, ok)
    if ok:
        println path, "->", a.shape
    else:
        println path, "-> not a usable .npy file"
    end
    a.free()
end

func main:
    mut good := npy.NpyArray {}
    good.shape.push(2)
    good.shape.push(2)
    repeat 4 in i: good.data.push(i as f64) end
    npy.WriteNpyFile(good, "good.npy")
    io.WriteFile("notes.npy", "this is plain text")
    mut buf := npy.WriteNpy(good)
    mut half := compress.NewByteBuf()
    compress.BufPushBytes(half, buf.data, compress.BufLen(buf) - 8)
    mut ok := true
    _ := npy.ReadNpy(half.data, compress.BufLen(half), ok)
    println "cut short ->", ok
    try_read("good.npy")
    try_read("notes.npy")
    try_read("missing.npy")
    mut list := npy.NpzList("missing.npz", ok)
    println "missing.npz ->", ok, list.len()
    list.free()
    compress.BufFree(half)
    compress.BufFree(buf)
    good.free()
    ret 0
end
