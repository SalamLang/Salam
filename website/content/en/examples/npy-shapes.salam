import npy
import matrix

func at3(a: npy.NpyArray, i: int, j: int, k: int): f64:
    rows := a.shape.get(1)
    cols := a.shape.get(2)
    ret a.data.get((i * rows + j) * cols + k)
end

func main:
    mut cube := npy.NpyArray {}
    cube.shape.push(2)
    cube.shape.push(3)
    cube.shape.push(4)
    repeat 24 in n: cube.data.push(n as f64) end
    println "ndim:", cube.ndim(), "count:", cube.count()
    println "cube[1][2][3] =", at3(cube, 1, 2, 3)
    mut ok := true
    _ := npy.ToMatrix(cube, ok)
    println "3-D to matrix:", ok
    npy.WriteNpyFile(cube, "cube.npy")
    mut back := npy.ReadNpyFile("cube.npy", ok)
    println "read back:", ok, back.shape, at3(back, 1, 2, 3)
    mut line := npy.NpyArray {}
    line.shape.push(4)
    repeat 4 in n: line.data.push((n * n) as f64) end
    mut m := npy.ToMatrix(line, ok)
    println "1-D to matrix:", ok, m.rows, "x", m.cols, m.at(0, 3)
    matrix.Free(m)
    line.free()
    back.free()
    cube.free()
    ret 0
end
