import npy
import matrix

func main:
    mut w := matrix.Zeros(2, 3)
    repeat 2 in i:
        repeat 3 in j:
            w.set(i, j, (i * 10 + j) as f64 / 4.0)
        end
    end
    mut arr := npy.FromMatrix(w)
    if npy.WriteNpyFile(arr, "weights.npy") == false:
        println "could not write weights.npy"
        ret 1
    end
    mut ok := false
    mut back := npy.ReadNpyFile("weights.npy", ok)
    if ok == false:
        println "could not read weights.npy"
        ret 1
    end
    println "shape:", back.shape, "elements:", back.count()
    mut m := npy.ToMatrix(back, ok)
    repeat m.rows in i:
        println m.at(i, 0), m.at(i, 1), m.at(i, 2)
    end
    println "same values:", matrix.Sum(m) == matrix.Sum(w)
    matrix.Free(m)
    matrix.Free(w)
    back.free()
    arr.free()
    ret 0
end
