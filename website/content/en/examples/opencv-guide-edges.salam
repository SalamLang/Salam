import opencv

func white_pixels(m: opencv.Mat): int:
    hist := m.histogram_gray()
    ret hist.get(255)
end

func main:
    if not opencv.Available():
        println "OpenCV is not available:", opencv.LastError()
        ret 1
    end
    mut photo := opencv.Read("photo.jpg")
    if not photo.ok() or photo.empty():
        println "photo.jpg not found, using a drawn test image"
        photo = opencv.NewBlank(320, 240, 3, opencv.RGB(200, 200, 200))
        photo.circle(160, 120, 70, opencv.RGB(40, 40, 40), -1)
    end
    defer photo.free()
    println "size:", photo.width(), "x", photo.height(), "channels:", photo.channels()

    mut gray := photo.to_gray()
    mut smooth := gray.gaussian_blur(5, 1.4)
    mut edges := smooth.canny(50.0, 150.0)
    mut thick := edges.dilate(3, 1)
    defer gray.free()
    defer smooth.free()
    defer edges.free()
    defer thick.free()
    println "edge pixels:", white_pixels(edges), "after dilate:", white_pixels(thick)
    println "saved:", opencv.Write("edges.png", thick)
end
