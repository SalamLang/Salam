import opencv

func main:
    if not opencv.Available():
        println "OpenCV is not available:", opencv.LastError()
        ret 1
    end
    mut board := opencv.NewBlank(400, 300, 3, opencv.White())
    defer board.free()
    board.rectangle(40, 40, 120, 80, opencv.Black(), -1)
    board.circle(280, 90, 50, opencv.Black(), -1)
    board.rectangle(150, 190, 200, 70, opencv.Black(), -1)

    mut gray := board.to_gray()
    mut mask := gray.threshold(128.0, 255.0, opencv.THRESH_BINARY_INV)
    mut found := mask.find_contours()
    defer gray.free()
    defer mask.free()
    defer found.free()
    println "shapes found:", found.count()
    repeat found.count() in i:
        box := found.bounding_rect(i)
        println "  shape at", box.x, box.y, "size", box.width, "x", box.height, "area", found.area(i) as int
        board.rectangle(box.x - 3, box.y - 3, box.width + 6, box.height + 6, opencv.Red(), 2)
    end
    println "saved:", board.save("shapes.png")
end
