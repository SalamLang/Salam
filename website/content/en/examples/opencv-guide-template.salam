import opencv

func main:
    if not opencv.Available():
        println "OpenCV is not available:", opencv.LastError()
        ret 1
    end
    mut screen := opencv.NewBlank(640, 480, 3, opencv.RGB(230, 230, 230))
    defer screen.free()
    screen.rectangle(420, 300, 90, 40, opencv.RGB(30, 120, 220), -1)
    screen.put_text("OK", 445, 330, 0.9, opencv.White(), 2)
    screen.rectangle(100, 100, 200, 60, opencv.RGB(120, 120, 120), -1)

    mut button := screen.crop(420, 300, 90, 40)
    defer button.free()
    hit := screen.find_template(button)
    if hit.found:
        println "button at", hit.x, hit.y, "score above 0.99:", hit.score > 0.99
        screen.rectangle(hit.x, hit.y, 90, 40, opencv.Red(), 2)
    else:
        println "button not on screen"
    end
    println "saved:", screen.save("found.png")
end
