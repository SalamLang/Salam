import opencv

func main:
    if not opencv.Available():
        println "OpenCV is not available:", opencv.LastError()
        ret 1
    end
    mut writer := opencv.NewVideoWriter("ball.avi", "MJPG", 10.0, 160, 120)
    if not writer.ok():
        println "this OpenCV build cannot write MJPG video"
        ret 1
    end
    repeat 20 in i:
        mut frame := opencv.NewBlank(160, 120, 3, opencv.Black())
        frame.circle(10 + i * 7, 60, 8, opencv.Green(), -1)
        writer.write(frame)
        frame.free()
    end
    writer.close()

    mut video := opencv.OpenVideo("ball.avi")
    if not video.ok():
        println "could not open ball.avi"
        ret 1
    end
    println "frames:", video.frame_count(), "fps:", video.fps()
    mut read := 0
    mut last := opencv.Mat {}
    until true:
        frame := video.read()
        if frame.empty(): break end
        read += 1
        last.free()
        last = frame
    end
    println "read", read, "frames, last frame", last.width(), "x", last.height()
    last.free()
    video.close()
end
