func main:
    mut balance := 100
    balance += 50
    balance -= 30
    balance *= 2
    balance /= 3
    balance %= 50
    println "balance:", balance
    mut log := "start"
    log += ", saved"
    log += ", files: " + 3
    println log
    mut i := 5
    i++
    i--
    i++
    j := i++
    println "j:", j, "i:", i
end
