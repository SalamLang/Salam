import option

struct Task:
    pub name: str = ""
    pub done: bool = false
end

func first_open(tasks: Vector<Task>): option.Option<str>:
    each t in tasks:
        if not t.done:
            ret option.Some(t.name)
        end
    end
    ret option.None()
end

func main:
    mut tasks := Vector {} as Vector<Task>
    defer tasks.free()
    tasks.push(Task { name = "write tests", done = true })
    tasks.push(Task { name = "fix login bug" })
    tasks.push(Task { name = "update docs" })
    next := first_open(tasks)
    println "next up:", option.Expect(next, "there is always an open task here")
    each i, t in tasks:
        tasks.set(i, Task { name = t.name, done = true })
    end
    println "anything left?", option.IsSome(first_open(tasks))
end
