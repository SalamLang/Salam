import option

func phone_of(book: HashMap<str, str>, name: str): option.Option<str>:
    if book.has(name):
        ret option.Some(book.get(name))
    end
    ret option.None()
end

func main:
    mut book := HashMap {} as HashMap<str, str>
    defer book.free()
    book.put("Sara", "0912 111 2233")
    book.put("Omid", "0935 444 5566")
    each name in ["Omid", "Neda"]:
        p := phone_of(book, name)
        if option.IsSome(p):
            println name + ":", p.value
        else:
            println name + ": no number on file"
        end
    end
    println "call", option.UnwrapOr(phone_of(book, "Neda"), "the front desk")
end
