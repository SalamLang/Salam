import option

struct Settings:
    pub width: option.Option<int> = option.None() as option.Option<int>
    pub title: option.Option<str> = option.None() as option.Option<str>
end

func describe(s: Settings): str:
    w := option.UnwrapOr(s.width, 80)
    t := option.UnwrapOr(s.title, "untitled")
    ret t + " (" + w + " columns)"
end

func main:
    println describe(Settings {})
    println describe(Settings { width = option.Some(120) })
    println describe(Settings { width = option.Some(0), title = option.Some("report") })
end
