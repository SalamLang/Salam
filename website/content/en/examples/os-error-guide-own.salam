import os.error
import fs

func load_port(path: str): int:
    error.Clear()
    if not fs.Exists(path):
        error.Set(error.FileNotFound, "config file is missing", "load_port", path, 0)
        ret 0
    end
    text := fs.ReadText(path).Trim()
    port := text.ToInt()
    if port <= 0 or port > 65535:
        error.Set(error.InvalidPath, "not a port number: " + text, "load_port", path, 0)
        ret 0
    end
    ret port
end

func show(path: str):
    port := load_port(path)
    if error.HasError():
        e := error.Last()
        println e.operation + "(" + e.path + "):", e.message
        ret
    end
    println path, "says port", port
end

func main:
    fs.WriteText("good.conf", "8080\n")
    fs.WriteText("bad.conf", "eighty\n")
    show("good.conf")
    show("bad.conf")
    show("none.conf")
    fs.Delete("good.conf")
    fs.Delete("bad.conf")
end
