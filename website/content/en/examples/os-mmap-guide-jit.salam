import os.dl
import os.mmap

func main:
    if not SALAM_ARCH_X64 or not mmap.Supported():
        println "this example needs 64 bit x86 and mmap"
        ret
    end
    page := mmap.PageSize()
    code := mmap.Alloc(page, mmap.PROT_READ | mmap.PROT_WRITE)
    bytes := code as u8*
    program := [0x48, 0x89, 0xf8, 0x48, 0x01, 0xf0, 0xc3]
    repeat 7 in i:
        bytes[i] = program[i] as u8
    end
    mmap.Protect(code, page, mmap.PROT_READ | mmap.PROT_EXEC)
    println "40 + 2 =", dl.Call(code, [40 as size, 2])
    mmap.Free(code, page)
end
