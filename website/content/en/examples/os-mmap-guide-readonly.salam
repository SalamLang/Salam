import os.mmap

func main:
    if not mmap.Supported():
        println "memory mapping is not available here"
        ret
    end
    page := mmap.PageSize()
    table := mmap.Alloc(page, mmap.PROT_READ | mmap.PROT_WRITE)
    defer _freed := mmap.Free(table, page)
    cells := table as i32*
    repeat 16 in i:
        cells[i] = i * i
    end
    println "filled:", cells[3], cells[15]
    println "read-only:", mmap.Protect(table, page, mmap.PROT_READ)
    println "still readable:", cells[4]
    println "writable again:", mmap.Protect(table, page, mmap.PROT_READ | mmap.PROT_WRITE)
    cells[4] = 99
    println "after the change:", cells[4]
end
