import os.platform

func linux_when_compiled(): bool:
    if SALAM_OS_LINUX:
        ret true
    else:
        ret false
    end
end

func main:
    println "compile time and run time agree:", linux_when_compiled() == platform.IsLinux()
    if SALAM_OS_WINDOWS:
        println "this line is only compiled on Windows"
    else:
        println "this line is compiled everywhere else"
    end
end
