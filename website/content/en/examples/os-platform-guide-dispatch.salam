import os.platform

func executable(name: str): str:
    if platform.IsWindows():
        ret name + ".exe"
    end
    ret name
end

func open_command(): str:
    if platform.IsWindows(): ret "start" end
    if platform.IsMac(): ret "open" end
    ret "xdg-open"
end

func main:
    mut matched := 0
    if platform.IsLinux(): matched++ end
    if platform.IsWindows(): matched++ end
    if platform.IsMac(): matched++ end
    if platform.IsFreeBSD(): matched++ end
    if platform.IsWasm(): matched++ end
    println "at most one system matched:", matched <= 1
    println "binary name built:", executable("salam").StartsWith("salam")
    println "open command chosen:", open_command().Len() > 0
end
