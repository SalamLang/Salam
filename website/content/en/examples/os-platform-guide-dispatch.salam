import os.platform

func executable(name: str): str:
    if platform.IsWindows():
        ret name + ".exe"
    end
    ret name
end

func open_command(): str:
    if platform.IsWindows(): ret "start" end
    if platform.IsMac(): ret "open" end
    ret "xdg-open"
end

func main:
    mut matched := 0
    if platform.IsLinux(): matched += 1 end
    if platform.IsWindows(): matched += 1 end
    if platform.IsMac(): matched += 1 end
    if platform.IsFreeBSD(): matched += 1 end
    if platform.IsWasm(): matched += 1 end
    println "at most one system matched:", matched <= 1
    println "binary name built:", executable("salam").starts_with("salam")
    println "open command chosen:", open_command().len() > 0
end
