import os.platform

const MB := 1048576 as i64

func cache_bytes(): i64:
    mut size := platform.TotalMemory() / 16
    if size < 64 * MB:
        size = 64 * MB
    end
    if size > 1024 * MB:
        size = 1024 * MB
    end
    free := platform.AvailableMemory()
    if free > 0 and size > free / 2:
        size = free / 2
    end
    ret size
end

func main:
    size := cache_bytes()
    println "cache is at most 1 GB:", size <= 1024 * MB
    println "cache is positive:", size > 0
    free := platform.AvailableMemory()
    println "cache fits in free memory:", free < 0 or size <= free
end
