import os.platform

func worker_count(limit: int): int:
    cores := platform.CpuCount()
    if cores < 1:
        ret 1
    end
    if cores > limit:
        ret limit
    end
    ret cores
end

func main:
    workers := worker_count(8)
    println "workers between 1 and 8:", workers >= 1 and workers <= 8
    println "never more than the cores:", workers <= platform.CpuCount()
    one := worker_count(1)
    println "with a limit of one:", one
end
