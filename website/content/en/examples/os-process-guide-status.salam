import os.process

func describe(script: str):
    mut cmd := process.NewCommand("sh")
    cmd.Arg("-c")
    cmd.Arg(script)
    mut child := process.Launch(cmd)
    st := child.Wait(2000)
    if st.exited:
        println "exited with code", st.code
    else st.signaled:
        println "killed by signal", st.signal
    end
    child.Close()
    cmd.Free()
end

func main:
    describe("exit 3")
    describe("kill -TERM $$")
    describe("kill -KILL $$")
end
