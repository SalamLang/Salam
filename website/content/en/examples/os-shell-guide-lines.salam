import os
import os.shell

func main:
    os.WriteFile("a.csv", "1,2\n")
    os.WriteFile("b.csv", "3,4\n")
    os.WriteFile("notes.txt", "hi\n")
    r := shell.Exec("ls")
    mut csv := 0
    each name in r.out.Trim().Split("\n"):
        if name.EndsWith(".csv"):
            println "found", name
            csv++
        end
    end
    println csv, "csv files"
    os.Remove("a.csv")
    os.Remove("b.csv")
    os.Remove("notes.txt")
end
