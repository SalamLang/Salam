import fs.dir
import fs
import fs.path
import os.temp

func main:
    work := temp.Directory()
    if work == "":
        println "could not make a work directory"
        ret 1
    end
    defer temp.RemoveDir(work)
    fs.WriteText(path.Join(work, "part-1.txt"), "Salam ")
    fs.WriteText(path.Join(work, "part-2.txt"), "world\n")
    mut joined := ""
    each name in ["part-1.txt", "part-2.txt"]:
        joined += fs.ReadText(path.Join(work, name))
    end
    print joined
    println dir.ListFiles(work).len(), "parts,", dir.Size(work), "bytes"
    ret 0
end
