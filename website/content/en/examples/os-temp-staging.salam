import fs
import os.temp

func main:
    staging := temp.File()
    fs.Append(staging, "id,name\n")
    fs.Append(staging, "1,Sara\n")
    fs.Append(staging, "2,Reza\n")
    rows := fs.ReadLines(staging)
    println "staged", rows.Len(), "lines"
    if fs.Copy(staging, "people.csv") == 0:
        println "published people.csv,", fs.Size("people.csv"), "bytes"
    end
    temp.Remove(staging)
    println "staging left behind:", fs.Exists(staging)
    print fs.ReadText("people.csv")
    fs.Delete("people.csv")
end
