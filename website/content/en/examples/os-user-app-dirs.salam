import env
import fs.dir
import fs
import fs.path
import os
import os.user

func main:
    env.Set("HOME", path.Join(os.Cwd(), "demo-home"))
    env.Unset("XDG_CONFIG_HOME")
    env.Unset("XDG_CACHE_HOME")
    config := path.Join(user.ConfigDir(), "notes")
    cache := path.Join(user.CacheDir(), "notes")
    dir.MkdirAll(config)
    dir.MkdirAll(cache)
    settings := path.Join(config, "settings.ini")
    repeat 2 in run:
        if fs.Exists(settings):
            println "run", run + 1, "found", fs.ReadText(settings).Trim()
        else:
            fs.WriteText(settings, "theme=dark\n")
            println "run", run + 1, "wrote the default settings"
        end
    end
    fs.WriteText(path.Join(cache, "index.bin"), "0123456789")
    println "settings at ~/" + path.Rel(user.HomeDir(), settings)
    println "cache holds", dir.Size(cache), "bytes"
    dir.RemoveAll(user.HomeDir())
end
