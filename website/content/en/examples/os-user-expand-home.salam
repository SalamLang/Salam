import env
import fs.path
import os.user
import str

func expand(p: str): str:
    if p == "~": ret user.HomeDir() end
    if str.StartsWith(p, "~/"):
        ret path.Join(user.HomeDir(), p.substr(2, p.len() - 2))
    end
    ret p
end

func main:
    env.Set("HOME", "/home/sara")
    each p in ["~", "~/notes/today.md", "/etc/hosts", "reports/may.csv"]:
        println p, "->", expand(p)
    end
end
