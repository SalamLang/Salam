import env
import os.user

func main:
    env.Set("HOME", "/home/sara")
    env.Unset("XDG_CONFIG_HOME")
    env.Unset("XDG_CACHE_HOME")
    println "home:  ", user.HomeDir()
    println "config:", user.ConfigDir()
    println "cache: ", user.CacheDir()
    env.Set("XDG_CONFIG_HOME", "/data/sara/config")
    env.Set("XDG_CACHE_HOME", "/fast-disk/cache")
    println "config:", user.ConfigDir()
    println "cache: ", user.CacheDir()
end
