import testing

include slug "package-slug.salam"

func test_make():
    testing.AssertEqStr(slug.Make("Hello, World!"), "hello-world")
    testing.AssertEqStr(slug.Make("  Salam   Lang  "), "salam-lang")
    testing.AssertEqStr(slug.Make(""), "")
end

func test_make_max():
    testing.AssertEqStr(slug.MakeMax("Packages in Salam are simple", 14), "packages-in-sa")
end
