package slug

import str

const ALLOWED := "abcdefghijklmnopqrstuvwxyz0123456789"

func is_word(piece: str): bool:
    ret str.Contains(ALLOWED, piece)
end

@en "Make"
@fa "بساز"
pub func Make(text: str): str:
    lower := str.Lower(text)
    mut out := ""
    mut dash := false
    repeat str.Len(lower) in i:
        piece := str.Substr(lower, i, 1)
        if is_word(piece):
            out += piece
            dash = false
        else if not dash and str.Len(out) > 0:
            out += "-"
            dash = true
        end
    end
    ret str.TrimSuffix(out, "-")
end

@en "MakeMax"
@fa "بساز با سقف"
pub func MakeMax(text: str, limit: int): str:
    full := Make(text)
    if str.Len(full) <= limit:
        ret full
    end
    ret str.TrimSuffix(str.Substr(full, 0, limit), "-")
end
