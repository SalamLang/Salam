import regex
import str

func show(label: str, found: Vector<str>):
    println label, found.Len(), "|", str.Join(found, ", ")
end

func main throws:
    post := "سفر به #تهران و #اصفهان با #قطار_شبانه"
    show("#\\w+ finds", try regex.FindAllStr("#\\w+", post))
    show("#[^ ]+ finds", try regex.FindAllStr("#[^ ]+", post))
    show("هه+ finds", try regex.FindAllStr("هه+", "عالیههههه"))
    show("ه(ه)+ finds", try regex.FindAllStr("ه(ه)+", "عالیههههه"))
    city := try regex.FindMatchStr("(تهران|اصفهان|شیراز)", post)
    println "first city:", regex.Group(city, 0), "at byte", city.start
end
