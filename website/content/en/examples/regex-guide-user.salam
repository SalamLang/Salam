import regex

func search(pattern: str, text: str):
    try:
        re := regex.Compile(pattern)
        found := regex.FindAllMatches(re, text, -1)
        println pattern, "->", found.Len(), "match(es)"
        each m in found:
            println "  at", m.start, regex.Group(m, 0)
        end
    catch e:
        println "bad pattern:", pattern, "->", e.message, "at byte", e.offset
    end
end

func main:
    text := "cat catalog concat dog"
    search("cat", text)
    search("\\w*cat\\w*", text)
    search("[a-z]+og", text)
    search("cat(", text)
    search("[a-z", text)
end
