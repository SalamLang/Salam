import rpc
import net.http
import net.router

mut visits := 0

func hit(c: i64):
    visits += 1
    rpc.ReplyInt(c, visits)
end

func greet(c: i64):
    rpc.ReplyStr(c, "salam, " + rpc.CallParamStr(c, "name", 0))
end

func endpoint(ctx: i64):
    http.Json(ctx, rpc.HandleText(http.Body(ctx)))
end

func main:
    rpc.Register("hit", hit)
    rpc.Register("greet", greet)
    mut r := router.NewRouter()
    router.Post(r, "/rpc", endpoint)
    mut s := http.NewServer(8090)
    http.Use(s, r)
    println "JSON-RPC on http://127.0.0.1:8090/rpc"
    http.Run(s)
end
