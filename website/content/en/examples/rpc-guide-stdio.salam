import rpc
import str
import io

func word_count(c: i64):
    words := str.Fields(rpc.CallParamStr(c, "text", 0))
    rpc.ReplyInt(c, words.len())
    words.free()
end

func shout(c: i64):
    rpc.ReplyStr(c, str.Upper(rpc.CallParamStr(c, "text", 0)))
end

func main:
    rpc.Register("words", word_count)
    rpc.Register("shout", shout)
    served := rpc.ServeStdio(rpc.RPC_FRAME_LINE)
    io.EPrintln("answered " + served + " requests")
end
