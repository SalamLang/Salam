import rpc
import encoding.value

mut todos := Vector {} as Vector<str>

func add_todo(c: i64):
    title := rpc.CallParamStr(c, "title", 0)
    if title == "":
        rpc.FailInvalidParams(c, "title is required")
        ret
    end
    todos.push(title)
    rpc.ReplyInt(c, todos.len())
end

func list_todos(c: i64):
    mut items := value.NewValueArray()
    each t in todos:
        value.ArrayPush(items, value.ValueString(t))
    end
    rpc.Reply(c, items)
end

func count_todos(c: i64):
    rpc.ReplyInt(c, todos.len())
end

func main:
    rpc.RegisterDoc("todo.add", add_todo, "adds a todo and returns how many there are")
    rpc.RegisterDoc("todo.list", list_todos, "returns every todo")
    rpc.Register("todo.count", count_todos)
    println rpc.HandleText(`{"jsonrpc":"2.0","method":"todo.add","params":{"title":"buy bread"},"id":1}`)
    println rpc.HandleText(`{"jsonrpc":"2.0","method":"todo.add","params":["call Sara"],"id":2}`)
    println rpc.HandleText(`{"jsonrpc":"2.0","method":"todo.add","params":{},"id":3}`)
    println rpc.HandleText(`{"jsonrpc":"2.0","method":"todo.list","id":4}`)
    println rpc.HandleText(`[{"jsonrpc":"2.0","method":"todo.count","id":5},{"jsonrpc":"2.0","method":"todo.delete","id":6}]`)
    println rpc.MethodDoc("todo.add")
    todos.free()
end
