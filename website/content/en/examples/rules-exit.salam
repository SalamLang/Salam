func parse age(text: str): int throws:
    n := text.to_int()
    if n <= 0 or n > 150:
        throw Error.New(ErrorKind.OutOfRange, "'" + text + "' is not an age")
    end
    ret n
end

func oldest(texts: Vector<str>): int throws:
    mut best := 0
    each text in texts:
        age := try parse age(text)
        if age > best:
            best = age
        end
    end
    ret best
end

func main:
    each text in ["42", "abc"]:
        try:
            println text, "is a valid age:", parse age(text)
        catch e:
            println e.message
        end
    end
    fallback := try parse age("900") catch 18
    println "with a fallback:", fallback
    mut texts := Vector {} as Vector<str>
    texts.push("30")
    texts.push("45")
    try:
        println "oldest:", oldest(texts)
    catch e:
        printerrln "no oldest age:", e.message
        ret 1
    end
end
