const LIMIT := 3

func main:
    names := Vector {} as Vector<str>
    defer names.Free()
    names.Push("Sara")
    names.Push("Reza")
    names.Push("Mina")
    names.Push("Ali")
    mut shown := 0
    each n in names:
        if shown == LIMIT:
            break
        end
        println n
        shown++
    end
    println shown, "of", names.Len(), "shown"
end
