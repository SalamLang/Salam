const LIMIT := 3

func main:
    names := Vector {} as Vector<str>
    defer names.free()
    names.push("Sara")
    names.push("Reza")
    names.push("Mina")
    names.push("Ali")
    mut shown := 0
    each n in names:
        if shown == LIMIT:
            break
        end
        println n
        shown += 1
    end
    println shown, "of", names.len(), "shown"
end
