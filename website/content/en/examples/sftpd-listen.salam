import sftpd
import sshd

func main:
    mut cfg := sftpd.NewConfig()
    println cfg.port, cfg.root
    cfg.host = "127.0.0.1"
    cfg.port = 0
    cfg.root = "/srv/drop"
    cfg.users.Push(sshd.User { name = "partner", password = "s3cret", home = "/" })
    println cfg.users.Len()
    mut srv := sftpd.New(cfg)
    println sftpd.Listen(srv)
    println sftpd.Port(srv) > 0
    sftpd.Close(srv)
    println srv.running
end
