import sftpd
import sshd
import env

func main:
    mut cfg := sftpd.NewConfig()
    cfg.port = 2222
    cfg.root = "/srv/drop"
    cfg.host_key_file = "/etc/deploy/host_key"
    cfg.users.Push(sshd.User { name = "partner", password = env.Get("SFTP_PASSWORD"), home = "/" })
    if env.Get("SFTP_PASSWORD").len() == 0:
        println "set SFTP_PASSWORD first"
        ret 1
    end
    mut srv := sftpd.New(cfg)
    if not sftpd.Listen(srv):
        println "cannot listen on port", cfg.port
        ret 1
    end
    println "sftp server on port", sftpd.Port(srv)
    sftpd.Serve(srv)
    ret 0
end
