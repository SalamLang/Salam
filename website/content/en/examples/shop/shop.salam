package shop

import str

func price_label(cents: int): str:
    mut rest := str.FromInt((cents % 100) as i64)
    if cents % 100 < 10:
        rest = "0" + rest
    end
    ret str.FromInt((cents / 100) as i64) + "." + rest
end

pub func Welcome(name: str): str:
    ret "Welcome back, " + name
end
