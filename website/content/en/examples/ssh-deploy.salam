import ssh
import str

func run_steps(client &: ssh.Client, steps: Vector<str>): bool:
    each step in steps:
        r := ssh.Exec(client, step)
        if not r.ok or r.exit_code != 0:
            println "FAILED:", step
            println str.Trim(r.stderr)
            ret false
        end
        println "ok:", step
    end
    ret true
end

func main:
    mut cfg := ssh.NewConfig("app1.example.com", ssh.DefaultPort, "deploy")
    if not ssh.WithKeyFile(cfg, "/home/deploy/.ssh/id_rsa"):
        println "cannot read the key file"
        ret 1
    end
    ssh.WithHostKeyMode(cfg, ssh.HOSTKEY_MODE_STRICT)
    mut client := ssh.Connect(cfg)
    if not ssh.Ok(client):
        println "connect failed:", ssh.Error(client)
        ret 1
    end

    mut steps := Vector {} as Vector<str>
    steps.push("cd /srv/app && git fetch --quiet && git checkout --quiet v2.4.0")
    steps.push("cd /srv/app && ./salam build --release")
    steps.push("sudo systemctl restart app")
    steps.push("systemctl is-active app")
    done := run_steps(client, steps)
    ssh.Close(client)
    if not done:
        ret 1
    end
    ret 0
end
