import ssh

func attempt(mode: int, label: str):
    mut cfg := ssh.NewConfig("new-server.example.com", 22, "admin")
    ssh.WithPassword(cfg, "first-login-password")
    ssh.WithKnownHostsPath(cfg, "known_hosts")
    ssh.WithHostKeyMode(cfg, mode)
    mut client := ssh.Connect(cfg)
    if ssh.Ok(client):
        println label, "connected, host key", ssh.HostKeyFingerprint(client)
        ssh.Close(client)
    else:
        println label, "refused:", ssh.Error(client)
    end
end

func main:
    attempt(ssh.HOSTKEY_MODE_STRICT, "strict, empty known_hosts:")
    attempt(ssh.HOSTKEY_MODE_ACCEPT_NEW, "accept-new, first time:")
    attempt(ssh.HOSTKEY_MODE_STRICT, "strict, key now recorded:")
end
