import ssh
import str
import conv

func parse(line: str): ssh.Config:
    fields := str.Split(line, " ")
    mut port := ssh.DefaultPort
    mut host := fields.get(0)
    if str.Contains(host, ":"):
        parts := str.Split(host, ":")
        host = parts.get(0)
        port = conv.Atoi(parts.get(1))
    end
    mut cfg := ssh.NewConfig(host, port, fields.get(1))
    ssh.WithHostKeyMode(cfg, ssh.HOSTKEY_MODE_STRICT)
    ssh.WithKnownHostsPath(cfg, "/etc/deploy/known_hosts")
    ret cfg
end

func main:
    inventory := "web1.example.com deploy\nweb2.example.com deploy\nbastion.example.com:2222 ops"
    each line in str.Split(inventory, "\n"):
        cfg := parse(line)
        println cfg.user + "@" + cfg.host, "port", cfg.port, "strict:", cfg.hostkey_mode == ssh.HOSTKEY_MODE_STRICT
    end
end
