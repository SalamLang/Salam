func preview(title: str, limit: int): str:
    if title.CharCount() <= limit:
        ret title
    end
    ret title.CharSubstr(0, limit) + "..."
end

func main:
    word := "café"
    println word.Len(), word.CharCount()
    greeting := "سلام"
    println greeting.Len(), greeting.CharCount()
    println greeting.CharAt(0), greeting.CharFind("م"), greeting.Find("م")
    println word[0], word[0] as int
    println preview("Short title", 24)
    println preview("A long headline about the weather in Tabriz", 24)
end
