func main:
    word := "سلام"
    each ch in word:
        print ch + " "
    end
    println ""
    each i, ch in "café":
        println i, ch
    end
    mut vowels := 0
    each ch in "Tabriz تبریز":
        if ch == "a" or ch == "i" or ch == "ی": vowels++ end
    end
    println "vowels:", vowels
    each i, b in "Hi".Bytes():
        println i, b as int
    end
end
