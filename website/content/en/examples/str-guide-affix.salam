import str

func describe(url: str): str:
    mut schemes := Vector {} as Vector<str>
    schemes.push("http://")
    schemes.push("https://")
    if not str.StartsWithAny(url, schemes):
        ret url + ": not a web address"
    end
    mut ok := false
    rest := str.CutPrefix(url, "https://", ok)
    secure := ok
    host := str.CutPrefix(rest, "http://", ok)
    mut kind := "page"
    if host.ends_with(".png") or host.ends_with(".jpg"):
        kind = "image"
    end
    if host.includes("?"):
        kind += " with a query"
    end
    mut label := "plain"
    if secure:
        label = "secure"
    end
    ret label + " " + kind + " at " + host
end

func main:
    each url in ["https://salamlang.ir/logo.png", "http://example.org/a?x=1", "ftp://example.org/file", "HTTPS://Example.org"]:
        println describe(url)
    end
    println str.StartsWithFold("HTTPS://Example.org", "https://")
    println str.EndsWithFold("Photo.JPG", ".jpg")
end
