struct Point:
    pub x: int = 0
    pub y: int = 0
end

func reset_copy(p: Point):
    p.x = 0
end

func reset(p &: Point):
    p.x = 0
end

func main:
    start := Point { x = 3, y = 4 }
    mut goal := start
    goal.y = 10
    println start, goal
    println start == Point { x = 3, y = 4 }, start == goal

    reset_copy(goal)
    println goal.x
    reset(goal)
    println goal.x
end
