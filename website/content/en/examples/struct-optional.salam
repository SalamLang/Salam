struct Client:
    pub host: str
    pub port: int = 443
    pub timeout: int?
end

func main:
    a := Client { host = "a.test" }
    println a.port, a.timeout.is_none()
    mut b := Client { host = "b.test", timeout = 30 }
    println b.timeout.value, b.timeout.unwrap_or(5)
    b.timeout = null
    println b.timeout.unwrap_or(5)
end
