struct Client:
    pub host: str
    pub user: str = ""
    pub pass: str = ""
    pub token: str = ""
    rule user needs pass
    rule oneof(user, token)
end

func main:
    a := Client { host = "db", user = "ali", pass = "secret" }
    println a.host, a.user
    b := Client { host = "api", token = "abc" }
    println b.host, b.token
end
