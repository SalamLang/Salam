struct Money:
    pub cents: int = 0
    pub func to_str(): str:
        rest := this.cents % 100
        pad := rest < 10 ? "0" : ""
        ret "$" + (this.cents / 100) + "." + pad + rest
    end
end

struct Item:
    pub name: str = ""
    pub price: Money = Money {}
end

func main:
    pen := Item { name = "pen", price = Money { cents = 250 } }
    println pen.price
    println pen
    println "total: " + Money { cents = 1205 }.to_str()
end
