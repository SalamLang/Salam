func main:
    repeat 3 in i:
        temperature := i * 15
        switch true:
            temperature < 10:
                println temperature, "cold"
                break
            end
            temperature < 25:
                println temperature, "mild"
                break
            end
            else:
                println temperature, "hot"
            end
        end
    end
    score := 75
    switch score:
        >= 90:
            println "excellent"
            break
        end
        >= 60:
            println "pass"
            break
        end
        else:
            println "fail"
        end
    end
end
