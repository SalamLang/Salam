import sync

mut slots := sync.Semaphore {}
mut lock := sync.Mutex {}
mut running := 0
mut busiest := 0
mut finished := 0

func download():
    sync.Acquire(slots)
    sync.Lock(lock)
    running += 1
    if running > busiest:
        busiest = running
    end
    sync.Unlock(lock)
    sync.SleepMs(20)
    sync.Lock(lock)
    running -= 1
    finished += 1
    sync.Unlock(lock)
    sync.Release(slots)
end

func main:
    slots = sync.NewSemaphore(2)
    lock = sync.NewMutex()
    mut jobs := Vector {} as Vector<i64>
    defer jobs.free()
    repeat 6:
        jobs.push(spawn(download))
    end
    each t in jobs:
        join(t)
    end
    println "downloads finished:", finished
    println "never more than two at once:", busiest <= 2
    sync.Destroy(lock)
    sync.DestroySemaphore(slots)
end
