import sync

mut setup := sync.Once {}
mut table := Vector {} as Vector<int>
mut builds := 0

func build table():
    builds += 1
    repeat 10 in i:
        table.push(i * i)
    end
end

func square(n: int): int:
    sync.Do(setup, (): build table() end)
    ret table.get(n)
end

func worker():
    _ := square(3)
end

func main:
    setup = sync.NewOnce()
    a := spawn(worker)
    b := spawn(worker)
    c := spawn(worker)
    join(a)
    join(b)
    join(c)
    println "square of 7:", square(7)
    println "table built", builds, "time"
    table.free()
    sync.DestroyOnce(setup)
end
