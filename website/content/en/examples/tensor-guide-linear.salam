import tensor

func matrix(rows: int, cols: int, values: f64[]): tensor.Tensor:
    mut data := Vector {} as Vector<f32>
    each v in values:
        data.push(v as f32)
    end
    mut shape := tensor.Shape2(rows, cols)
    ret tensor.FromArray(shape, data)
end

func main:
    mut x := matrix(3, 2, [1.0, 2.0, 0.0, 1.0, 3.0, 0.0])
    mut w := matrix(2, 3, [1.0, 0.0, -1.0, 0.5, 1.0, 2.0])
    b := matrix(1, 3, [0.0, -1.0, 0.5])
    mut scores := tensor.MatMul(x, w) + b
    println "scores", tensor.ShapeString(scores), tensor.ToString(scores)
    mut hidden := tensor.Relu(scores)
    println "relu", tensor.ToString(hidden)
    mut best := tensor.ArgMaxAxis(scores, 1, false)
    println "best class per row", tensor.ToString(best)
end
