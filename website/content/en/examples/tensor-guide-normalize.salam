import tensor

func main:
    mut data := Vector {} as Vector<f32>
    each v in [2.0, 20.0, 4.0, 40.0, 4.0, 40.0, 4.0, 40.0, 5.0, 50.0, 5.0, 50.0, 7.0, 70.0, 9.0, 90.0]:
        data.push(v as f32)
    end
    shape := tensor.Shape2(8, 2)
    samples := tensor.FromArray(shape, data)
    mean := tensor.MeanAxis(samples, 0, true)
    println "mean", tensor.ShapeString(mean), tensor.ToString(mean)
    centered := samples - mean
    spread := tensor.Sqrt(tensor.MeanAxis(tensor.Square(centered), 0, true))
    println "spread", tensor.ToString(spread)
    scaled := centered / spread
    println "first column", tensor.ToString(tensor.Narrow(scaled, 1, 0, 1))
    println "columns now match:", tensor.AllClose(tensor.Narrow(scaled, 1, 0, 1), tensor.Narrow(scaled, 1, 1, 1), 0.0001)
    println "new mean", tensor.ToString(tensor.MeanAxis(scaled, 0, false))
end
