import tensor

func main:
    names := ["cat", "dog", "car", "bus"]
    mut data := Vector {} as Vector<f32>
    each v in [0.9, 0.1, 0.0, 0.8, 0.2, 0.0, 0.0, 0.1, 0.9, 0.1, 0.0, 0.8]:
        data.push(v as f32)
    end
    shape := tensor.Shape2(4, 3)
    vectors := tensor.FromArray(shape, data)
    mut query_data := Vector {} as Vector<f32>
    each v in [0.7, 0.3, 0.0]:
        query_data.push(v as f32)
    end
    qshape := tensor.Shape1(3)
    query := tensor.FromArray(qshape, query_data)
    scores := tensor.MatVec(vectors, query)
    mut order := tensor.Empty()
    top := tensor.TopK(scores, 2, true, order)
    repeat 2 in i:
        index := order.at(i) as int
        println names[index], (top.at(i) * 100.0 + 0.5) as int
    end
end
