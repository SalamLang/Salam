import tensor

func main:
    mut readings := Vector {} as Vector<f32>
    each kwh in [1.5, 3.5, 4.25, 2.0, 1.0, 2.75, 5.5, 2.25, 0.75, 3.0, 3.25, 1.75]:
        readings.push(kwh as f32)
    end
    flat := tensor.FromArray(tensor.Shape1(12), readings)
    mut days_shape := tensor.Shape2(3, 4)
    days := tensor.Reshape(flat, days_shape)
    println "days x periods", tensor.ShapeString(days)
    println "per day", tensor.ToString(tensor.SumAxis(days, 1, false))
    println "per period", tensor.ToString(tensor.SumAxis(days, 0, false))
    println "running total of day 2", tensor.ToString(tensor.Cumsum(tensor.SliceAxis0(days, 1, 1), 1))
    peaks := tensor.GreaterScalar(days, 4.0)
    println "peak readings", tensor.ToString(tensor.MaskedFill(days, tensor.LessScalar(days, 4.0), 0.0))
    println "how many peaks", tensor.SumAll(peaks)
    println "periods as rows", tensor.ShapeString(tensor.Transpose2D(days))
    mut wrong_shape := tensor.Shape2(5, 2)
    println "reshape 12 into 5x2:", tensor.ShapeString(tensor.Reshape(flat, wrong_shape))
end
