import term

func status_line(tag: str, message: str): str:
    mut label := "[" + tag + "]"
    if tag == "ok":
        label = term.Green(label)
    else tag == "warn":
        label = term.Yellow(label)
    else tag == "fail":
        label = term.Bold(term.Red(label))
    end
    ret term.PadRight(label, 7) + message
end

func main:
    term.SetColorMode(term.ColorAlways)
    line := status_line("warn", "cache is 91% full")
    println "bytes:", line.Len(), "| columns on screen:", term.Width(line)
    mut log_file := Vector {} as Vector<str>
    defer log_file.Free()
    log_file.Push(term.Strip(status_line("ok", "config loaded")))
    log_file.Push(term.Strip(line))
    log_file.Push(term.Strip(status_line("fail", "could not reach the mail server")))
    println "--- the log file ---"
    each entry in log_file:
        println entry
    end
end
