import term

func status line(tag: str, message: str): str:
    mut label := "[" + tag + "]"
    if tag == "ok":
        label = term.Green(label)
    else tag == "warn":
        label = term.Yellow(label)
    else tag == "fail":
        label = term.Bold(term.Red(label))
    end
    ret term.PadRight(label, 7) + message
end

func main:
    term.SetColorMode(term.ColorAlways)
    line := status line("warn", "cache is 91% full")
    println "bytes:", line.len(), "| columns on screen:", term.Width(line)
    mut log file := Vector {} as Vector<str>
    defer log file.free()
    log file.push(term.Strip(status line("ok", "config loaded")))
    log file.push(term.Strip(line))
    log file.push(term.Strip(status line("fail", "could not reach the mail server")))
    println "--- the log file ---"
    each entry in log file:
        println entry
    end
end
