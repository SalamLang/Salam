import term

func draw(items: Vector<str>, chosen: int):
    term.Write(term.SeqClearScreen())
    term.Write(term.Bold("Pick a language (arrows, Enter, q)") + "\r\n\r\n")
    each i, item in items:
        if i == chosen:
            term.Write(term.Inverse(" > " + item + " ") + "\r\n")
        else:
            term.Write("   " + item + "\r\n")
        end
    end
    term.Flush()
end

func main:
    if not term.IsTTY(term.StdinFd):
        printerrln "run this program in a terminal"
        ret 1
    end
    mut items := Vector {} as Vector<str>
    defer items.free()
    items.push("Salam")
    items.push("C")
    items.push("Go")
    items.push("Rust")
    mut state := term.MakeRaw(term.StdinFd)
    term.EnterAltScreen()
    term.HideCursor()
    mut chosen := 0
    mut picked := -1
    until picked < 0:
        draw(items, chosen)
        k := term.ReadKey()
        if k.code == term.KeyUp and chosen > 0:
            chosen -= 1
        else k.code == term.KeyDown and chosen < items.len() - 1:
            chosen += 1
        else k.code == term.KeyEnter:
            picked = chosen
        else k.code == term.KeyEOF or (k.code == term.KeyChar and k.ch == "q"):
            break
        end
    end
    term.ShowCursor()
    term.ExitAltScreen()
    term.Restore(state)
    if picked >= 0:
        println "you picked", items.get(picked)
    end
    ret 0
end
