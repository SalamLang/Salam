import term

func main:
    sizes := [120, 480, 64, 900, 236]
    mut total := 0
    each size in sizes: total += size end
    mut bar := term.NewBar(total, "backup")
    bar.width = 20
    bar.fill = "#"
    bar.empty = "."
    bar.show_count = true
    each i, size in sizes:
        term.BarAdd(bar, size)
        if i == 1: println "halfway:", term.BarRender(bar) end
    end
    term.BarFinish(bar)
    println "copied", term.FormatBytes((total as i64) * 1024), "in", term.FormatDuration(7400)
end
