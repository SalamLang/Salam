import term

struct Service:
    pub name: str = ""
    pub status: str = ""
    pub memory: i64 = 0
    pub uptime ms: i64 = 0
end

func colored status(s: str): str:
    if s == "running":
        ret term.Green(s)
    else s == "degraded":
        ret term.Yellow(s)
    end
    ret term.Red(s)
end

func main:
    services := [
        Service { name = "api", status = "running", memory = 157286400, uptime ms = 93784000 },
        Service { name = "search-indexer", status = "degraded", memory = 1073741824, uptime ms = 4500000 },
        Service { name = "mail", status = "stopped", memory = 0, uptime ms = 0 }
    ]
    println term.Bold(term.PadRight("SERVICE", 14) + " " + term.PadRight("STATUS", 9) + " " + term.PadLeft("MEMORY", 9) + "  UPTIME")
    each s in services:
        name := term.PadRight(term.Truncate(s.name, 14), 14)
        status := term.PadRight(colored status(s.status), 9)
        mut up := "-"
        if s.uptime ms > 0:
            up = term.FormatDuration(s.uptime ms)
        end
        println name, status, term.PadLeft(term.FormatBytes(s.memory), 9), "", up
    end
end
