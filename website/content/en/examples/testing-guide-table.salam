import testing
import str

struct Case:
    pub n: int = 0
    pub want: str = ""
end

func fizzbuzz(n: int): str:
    if n % 15 == 0:
        ret "FizzBuzz"
    else n % 3 == 0:
        ret "Fizz"
    else n % 5 == 0:
        ret "Buzz"
    end
    ret str.FromInt(n)
end

func main:
    cases := [
        Case { n = 1, want = "1" },
        Case { n = 3, want = "Fizz" },
        Case { n = 5, want = "Buzz" },
        Case { n = 9, want = "Fizz" },
        Case { n = 10, want = "Buzz" },
        Case { n = 15, want = "FizzBuzz" },
        Case { n = 98, want = "98" }
    ]
    each c in cases:
        testing.AssertEqStr(fizzbuzz(c.n), c.want)
    end
    ret testing.Summary()
end
