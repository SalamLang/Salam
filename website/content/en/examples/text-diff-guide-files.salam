import text.diff
import fs
import fs.path
import os.temp

func main:
    work := temp.Directory()
    defer temp.RemoveDir(work)
    left := path.Join(work, "config.old")
    right := path.Join(work, "config.new")
    fs.WriteText(left, "port=80\nhost=a\nmode=safe\n")
    fs.WriteText(right, "port=8080\nhost=a\nmode=safe\ndebug=1\n")
    patch := diff.UnifiedText(fs.ReadText(left), fs.ReadText(right), "config.old", "config.new", 1)
    if patch.len() == 0:
        println "the files are the same"
    else:
        print patch
    end
    println "same file:", diff.UnifiedText("x\n", "x\n", "a", "b", 3).len() == 0
end
