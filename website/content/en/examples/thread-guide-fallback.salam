import thread

mut depth := 0 as i64

func walk(n: i64): i64:
    if n == 0:
        ret 0
    end
    ret 1 + walk(n - 1)
end

func deep work(_arg: void*):
    depth = walk(300000)
end

func main:
    t := thread.SpawnStack(deep work, null, (128 * 1024 * 1024) as u64)
    if thread.Valid(t):
        thread.Join(t)
    else:
        println "no big stack, running on this thread"
        deep work(null)
    end
    println "depth reached:", depth
end
