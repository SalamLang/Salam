import thread
import mem

struct Part:
    pub first: i64 = 0
    pub last: i64 = 0
    pub sum: i64 = 0
end

func add range(p: Part*):
    mut total := 0 as i64
    mut i := p[0].first
    until i <= p[0].last:
        total += i
        i += 1
    end
    p[0].sum = total
end

func new part(first: i64, last: i64): Part*:
    p := mem.Allocate(sizeof(Part)) as Part*
    p[0] = Part { first = first, last = last }
    ret p
end

func main:
    size := 250 as i64
    mut parts := Vector {} as Vector<Part*>
    defer parts.free()
    mut group := Vector {} as Vector<thread.Thread>
    defer group.free()
    repeat 4 in w:
        p := new part((w as i64) * size + 1, (w as i64 + 1) * size)
        parts.push(p)
        group = thread.Collect(group, spawn(add range, p))
    end
    thread.JoinAll(group)
    mut total := 0 as i64
    each p in parts:
        println p[0].first, "to", p[0].last, "=", p[0].sum
        total += p[0].sum
        mem.Free(p as void*)
    end
    println "total:", total
end
