import mem

struct Job:
    pub from: int = 0
    pub to: int = 0
    pub sum: i64 = 0
end

func work(j: Job*):
    mut total := 0 as i64
    repeat j[0].from to j[0].to in i:
        total += i as i64
    end
    j[0].sum = total
end

func new job(first: int, last: int): Job*:
    j := mem.Allocate(sizeof(Job)) as Job*
    j[0] = Job { from = first, to = last }
    ret j
end

func main:
    a := new job(1, 500)
    b := new job(501, 1000)
    t1 := spawn(work, a)
    t2 := spawn(work, b)
    join(t1)
    join(t2)
    println a[0].sum, b[0].sum
    println "total:", a[0].sum + b[0].sum
    mem.Free(a as void*)
    mem.Free(b as void*)
end
