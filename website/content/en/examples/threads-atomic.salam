import atomic

mut hits := atomic.NewI64(0)

func visit():
    repeat 100000:
        atomic.Add(hits, 1)
    end
end

func main:
    t1 := spawn(visit)
    t2 := spawn(visit)
    t3 := spawn(visit)
    join(t1)
    join(t2)
    join(t3)
    println atomic.Load(hits)
    atomic.DestroyI64(hits)
end
