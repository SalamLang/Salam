import chan

mut jobs := chan.Chan {} as chan.Chan<i64>
mut results := chan.Chan {} as chan.Chan<i64>

func worker():
    mut ok := true
    until true:
        n := jobs.Recv(ok)
        if not ok:
            break
        end
        results.Send(n * n)
    end
end

func main:
    jobs.Init(4)
    results.Init(16)
    a := spawn(worker)
    b := spawn(worker)
    repeat 1 to 10 in i:
        jobs.Send(i as i64)
    end
    jobs.Close()
    join(a)
    join(b)
    results.Close()
    mut sum := 0 as i64
    mut ok := true
    until true:
        v := results.Recv(ok)
        if not ok:
            break
        end
        sum += v
    end
    println "sum of squares:", sum
    jobs.Free()
    results.Free()
end
