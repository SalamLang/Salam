import sync

mut done := 0
mut lock := sync.NewMutex()
mut group := sync.NewWaitGroup()

func job():
    sync.Lock(lock)
    done += 1
    sync.Unlock(lock)
    sync.Done(group)
end

func main:
    mut threads := Vector {} as Vector<i64>
    defer threads.free()
    sync.Add(group, 5)
    repeat 5:
        threads.push(spawn(job))
    end
    sync.Wait(group)
    println "finished:", done
    each t in threads:
        join(t)
    end
    sync.DestroyWaitGroup(group)
    sync.Destroy(lock)
end
