import time
import str

func days left(expires: i64, today: i64): i64:
    ret time.DiffSeconds(expires, today) / time.SecondsPerDay
end

func main:
    today := time.FromUTCParts(2026, 3, 10, 9, 0, 0)
    signups := ["2026-01-15T08:30:00Z", "2026-02-20T18:45:00Z", "2026-03-09T23:10:00Z", "not a date"]
    each s in signups:
        mut p := 0 as i64
        try:
            p = time.ParseISO(s)
        catch e:
            println "skipping \"" + s + "\":", e.message
            continue
        end
        expires := time.AddDuration(p, time.Days(30))
        left := days left(expires, today)
        if left < 0:
            println time.FormatISOUTC(p), "expired", -left, "days ago"
        else:
            println time.FormatISOUTC(p), "ends on", time.FormatISOUTC(expires), "(" + str.FromInt(left) + " days left)"
        end
    end
end
