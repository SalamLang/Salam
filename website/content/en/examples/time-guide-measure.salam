import time

func fib(n: int): i64:
    if n < 2:
        ret n
    end
    ret fib(n - 1) + fib(n - 2)
end

func main:
    start := time.MonoNanos()
    result := fib(27)
    took := time.SinceDuration(start)
    println "fib(27) =", result
    println "measured something:", not took.is_negative()
    println "under ten seconds:", took.less(time.Seconds(10))
    budget := time.Seconds(5)
    if budget.less(took):
        println "slower than the budget of", budget.to_str()
    else:
        println "within the budget of", budget.to_str()
    end
end
