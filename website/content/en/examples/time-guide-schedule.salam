import time

func weekday name(epoch: i64): str:
    names := ["Thursday", "Friday", "Saturday", "Sunday", "Monday", "Tuesday", "Wednesday"]
    ret names[(epoch / time.SecondsPerDay) % 7]
end

func next run(after: i64, hour: int, minute: int): i64:
    day start := after - after % time.SecondsPerDay
    mut run := day start + (hour as i64) * time.SecondsPerHour + (minute as i64) * time.SecondsPerMinute
    if run <= after:
        run += time.SecondsPerDay
    end
    ret run
end

func main:
    mut t := time.FromUTCParts(2026, 10, 16, 14, 20, 0)
    println "now:", weekday name(t), time.FormatISOUTC(t)
    repeat 3:
        t = next run(t, 2, 30)
        println "backup:", weekday name(t), time.FormatISOUTC(t)
    end
    println "HTTP form:", time.FormatHTTPDate(t)
end
