import time

func main:
    mut ticker := time.NewTicker(time.Milliseconds(20))
    mut deadline := time.NewTimer(time.Milliseconds(500))
    mut beats := 0
    until beats < 5 and not deadline.expired():
        ticker.wait()
        beats += 1
        println "heartbeat", beats
    end
    ticker.stop()
    println "deadline passed:", deadline.expired()
    started := time.MonoNanos()
    ready := time.WaitUntil(():
        ret time.SinceDuration(started).millis() >= 30
    end, time.Milliseconds(5), time.Seconds(1))
    println "cache warm:", ready
    gave_up := time.WaitUntil((): ret false end, time.Milliseconds(5), time.Milliseconds(20))
    println "server came up:", gave_up
end
