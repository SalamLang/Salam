import time

func read timeout(name: str, text: str, fallback: time.Duration): time.Duration:
    mut d := fallback
    try:
        d = time.ParseDuration(text)
    catch e:
        println name + ": cannot read", "\"" + text + "\" (" + e.message + "), using", fallback.ToStr()
        ret fallback
    end
    if d.less(time.Milliseconds(100)) or time.Minutes(10).less(d):
        println name + ":", d.ToStr(), "is out of range, using", fallback.ToStr()
        ret fallback
    end
    println name + ":", d.ToStr()
    ret d
end

func main:
    connect := read timeout("connect", "2.5s", time.Seconds(5))
    request := read timeout("request", "1m30s", time.Seconds(30))
    retry := read timeout("retry", "soon", time.Seconds(1))
    idle := read timeout("idle", "2h", time.Minutes(5))
    worst := connect.add(request.mul(3)).add(retry.mul(2))
    println "worst case for three tries:", worst.ToStr()
    println "idle in milliseconds:", idle.millis()
end
