import time

func read timeout(name: str, text: str, fallback: time.Duration): time.Duration:
    p := time.ParseDuration(text)
    if not p.ok:
        println name + ": cannot read", "\"" + text + "\", using", fallback.to_str()
        ret fallback
    end
    if p.value.less(time.Milliseconds(100)) or time.Minutes(10).less(p.value):
        println name + ":", p.value.to_str(), "is out of range, using", fallback.to_str()
        ret fallback
    end
    println name + ":", p.value.to_str()
    ret p.value
end

func main:
    connect := read timeout("connect", "2.5s", time.Seconds(5))
    request := read timeout("request", "1m30s", time.Seconds(30))
    retry := read timeout("retry", "soon", time.Seconds(1))
    idle := read timeout("idle", "2h", time.Minutes(5))
    worst := connect.add(request.mul(3)).add(retry.mul(2))
    println "worst case for three tries:", worst.to_str()
    println "idle in milliseconds:", idle.millis()
end
