import term
import tui

struct Hello:
    pub use tui.BaseWidget
    pub presses: int = 0

    pub func Render(buf: tui.Buffer, bounds: tui.Rect):
        buf.PutStr(
            bounds.x + 2, bounds.y + 1, "Hello from tui!", tui.Style { bold = true, fg = tui.Cyan }
        )
        buf.PutStr(
            bounds.x + 2, bounds.y + 3, "Enter pressed " + this.presses + " times", tui.StyleDefault
        )
        buf.PutStr(bounds.x + 2, bounds.Bottom() - 1, "q quits", tui.Style { dim = true })
    end

    pub func HandleEvent(event: tui.Event): bool:
        if event.IsKey(term.KeyEnter):
            this.presses++
            ret true
        end
        ret false
    end
end

func main:
    if not term.IsTerminal():
        printerrln "run me in a terminal"
        ret 1
    end
    mut screen := tui.NewTerminalScreen(Hello {})
    screen.Start()
    defer screen.Close()
    screen.Present()
    mut ev := tui.Event {}
    until screen.NextEvent(ev):
        consumed := screen.Dispatch(ev)
        if not consumed and (ev.IsChar("q") or ev.IsCtrl("c")):
            screen.Stop()
        end
        screen.Present()
    end
    ret 0
end
