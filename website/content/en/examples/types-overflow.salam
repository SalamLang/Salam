func add_views(views: int, more: int): int:
    ret views + more
end

func main:
    println "views as int:", add_views(2147483000, 1000)
    mut total := 2147483000 as i64
    total += 1000
    println "views as i64:", total
    stock := 3 as uint
    sold := 5 as uint
    println "stock left:", stock - sold
end
