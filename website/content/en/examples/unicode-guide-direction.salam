import unicode
import str

func direction(text: str): str:
    cps := str.CodePoints(text)
    defer cps.free()
    each cp in cps:
        bc := unicode.BidiClass(cp)
        if bc == unicode.BcL:
            ret "ltr"
        end
        if bc == unicode.BcR or bc == unicode.BcAL:
            ret "rtl"
        end
    end
    ret "neutral"
end

func main:
    each line in ["Hello", "سلام دنیا", "2026: سال نو", "(42) Answer", "!!! 123", "שלום"]:
        println direction(line), "|", line
    end
end
