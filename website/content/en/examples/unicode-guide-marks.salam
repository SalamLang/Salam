import unicode
import str

func strip_marks(text: str): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    cps := str.CodePoints(text)
    defer cps.free()
    each cp in cps:
        n := unicode.DecompLen(cp)
        if n == 0:
            if not unicode.IsMark(cp):
                str.BufAppendCp(b, cp)
            end
            continue
        end
        repeat n in k:
            part := unicode.DecompAt(cp, k)
            if not unicode.IsMark(part):
                str.BufAppendCp(b, part)
            end
        end
    end
    ret str.BufStr(b)
end

func main:
    println strip_marks("café crème brûlée")
    println strip_marks("Ångström, naïve, São Paulo")
    println strip_marks("کِتابُ الْعَرَبِیَّة")
    println strip_marks("آموزشِ زبانِ برنامه‌نویسیِ سلام")
end
