import unicode
import str

func scripts_in(name: str): Vector<str>:
    mut found := Vector {} as Vector<str>
    cps := str.CodePoints(name)
    defer cps.free()
    each cp in cps:
        sc := unicode.Script(cp)
        if sc == unicode.ScriptCommon or sc == unicode.ScriptInherited:
            continue
        end
        script := unicode.ScriptName(cp)
        mut seen := false
        each s in found:
            if s == script:
                seen = true
            end
        end
        if not seen:
            found.push(script)
        end
    end
    ret found
end

func main:
    each name in ["paypal", "pаypal", "علی_2000", "Reza۱۳۷۰"]:
        s := scripts_in(name)
        verdict := s.len() > 1 ? "mixed, check it" : "ok"
        println name, s, verdict
        s.free()
    end
end
