import unicode
import str

func main:
    text := "Salam 2026! سلامِ ۱۴۰۵، café (ok)"
    cps := str.CodePoints(text)
    defer cps.free()
    mut letters := 0
    mut digits := 0
    mut spaces := 0
    mut punct := 0
    mut marks := 0
    each cp in cps:
        if unicode.IsLetter(cp):
            letters += 1
        else unicode.IsDigit(cp):
            digits += 1
        else unicode.IsSpace(cp):
            spaces += 1
        else unicode.IsPunct(cp):
            punct += 1
        else unicode.IsMark(cp):
            marks += 1
        end
    end
    println "code points:", cps.len()
    println "letters:", letters, "digits:", digits, "spaces:", spaces
    println "punctuation:", punct, "marks:", marks
end
