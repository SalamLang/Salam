import unicode
import str

func upper_all(text: str): str:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    cps := str.CodePoints(text)
    defer cps.free()
    each cp in cps:
        str.BufAppendCp(b, unicode.ToUpper(cp))
    end
    ret str.BufStr(b)
end

func main:
    each city in ["Zürich", "São Paulo", "Москва", "Αθήνα", "Straße"]:
        println str.Upper(city), "|", upper_all(city)
    end
end
