func add_fee(prices &: Vector<int>, fee: int):
    prices.Push(fee)
end

func main:
    mut prices := Vector {} as Vector<int>
    defer prices.Free()
    prices.Push(100)
    prices.Push(250)

    same := prices
    saved := prices.Copy()
    defer saved.Free()

    prices.Set(0, 90)
    println same.Get(0), saved.Get(0)

    add_fee(prices, 5)
    println prices
    println saved
end
