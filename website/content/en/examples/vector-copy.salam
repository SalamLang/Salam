func add_fee(prices &: Vector<int>, fee: int):
    prices.push(fee)
end

func main:
    mut prices := Vector {} as Vector<int>
    defer prices.free()
    prices.push(100)
    prices.push(250)

    same := prices
    saved := prices.copy()
    defer saved.free()

    prices.set(0, 90)
    println same.get(0), saved.get(0)

    add_fee(prices, 5)
    println prices
    println saved
end
