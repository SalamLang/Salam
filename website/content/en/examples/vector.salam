func main:
    mut numbers := Vector {} as Vector<int>
    defer numbers.Free()
    numbers.Push(10)
    numbers.Push(20)
    numbers.Push(30)
    numbers.Set(1, 25)
    println numbers.Len(), numbers.Get(1)
    last := numbers.Pop()
    println last, numbers.Len()
    each n in numbers:
        println n
    end
end
