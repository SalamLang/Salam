func main:
    mut numbers := Vector {} as Vector<int>
    defer numbers.free()
    numbers.push(10)
    numbers.push(20)
    numbers.push(30)
    numbers.set(1, 25)
    println numbers.len(), numbers.get(1)
    last := numbers.pop()
    println last, numbers.len()
    each n in numbers:
        println n
    end
end
