page:
    title = "Clip path"
    global: selector = "body" font = system, sans margin = 1.5rem end
    box:
        layout = row gap = 14 wrap = true
        box: width = 100 height = 100 background = linear(135, #f97316, #db2777) clip path = "circle(50%)" end
        box: width = 100 height = 100 background = linear(135, #0ea5e9, #6366f1) clip path = "polygon(50% 0, 100% 100%, 0 100%)" end
        box: width = 100 height = 100 background = linear(135, #eab308, #f97316) clip path = "polygon(50% 0, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%)" end
        box: width = 100 height = 100 background = linear(135, #10b981, #0f766e) clip path = "inset(10% 0 10% 0 round 20px)" end
        box: width = 140 height = 100 background = linear(135, #a855f7, #ec4899) clip path = "ellipse(50% 40% at 50% 50%)" end
    end
end
