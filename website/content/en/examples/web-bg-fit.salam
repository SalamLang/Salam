const PHOTO := "data:image/png;base64,"

page:
    title = "Fitting an image"
    global: selector = "body" font family = "system-ui, sans-serif" margin = "1.5rem" end
    box:
        display = flex gap = 12 flex wrap = wrap text align = center
        box:
            image: source = PHOTO alt = "fill" width = 130 height = 130 object fit = fill border = "1px solid #94a3b8" end
            paragraph: content = "fill" end
        end
        box:
            image: source = PHOTO alt = "contain" width = 130 height = 130 object fit = contain border = "1px solid #94a3b8" end
            paragraph: content = "contain" end
        end
        box:
            image: source = PHOTO alt = "cover" width = 130 height = 130 object fit = cover border = "1px solid #94a3b8" end
            paragraph: content = "cover" end
        end
        box:
            image: source = PHOTO alt = "cover right" width = 130 height = 130 object fit = cover object position = "right center" border = "1px solid #94a3b8" end
            paragraph: content = "cover, right" end
        end
    end
end
