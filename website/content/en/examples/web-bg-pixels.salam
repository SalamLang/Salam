const ICON := "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAQAAAAECAYAAACp8Z5+AAAAH0lEQVR4nGP4DwS31cvBGAQYQIzf51+AMYiNKYCuBQCwzDJ17qOzggAAAABJRU5ErkJggg=="

page:
    title = "Image rendering"
    global: selector = "body" font family = "system-ui, sans-serif" margin = "1.5rem" end
    box:
        display = flex gap = 24 text align = center
        box:
            image: source = ICON alt = "smooth" width = 128 height = 128 image rendering = auto end
            paragraph: content = "auto" end
        end
        box:
            image: source = ICON alt = "pixelated" width = 128 height = 128 image rendering = pixelated end
            paragraph: content = "pixelated" end
        end
    end
    paragraph: content = "The picture is only 4 by 4 pixels. Pixelated keeps its square edges when it is enlarged." end
end
