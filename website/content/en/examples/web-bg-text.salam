page:
    title = "Gradient text"
    global: selector = "body" font = system, sans margin = 1.5rem end
    heading:
        size = 1
        font size = 56
        margin = 0
        background = linear(90, #f97316, #db2777, #7c3aed)
        background clip = "text"
        color = transparent
        content = "Salam"
    end
    paragraph: content = "The gradient is the background of the box, cut to the shape of the letters, and the text color is made transparent so it shows through." end
end
