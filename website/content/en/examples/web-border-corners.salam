component Tile(label, shape):
    box:
        width = 100
        height = 80
        background = #7c3aed
        color = white
        layout = row
        align = center
        justify = center
        radius = 28
        font size = 13
        corner shape = shape
        content = label
    end
end

page:
    title = "Corner shapes"
    global: selector = "body" font = system, sans margin = 1.5rem end
    box:
        layout = row gap = 16 wrap = true
        Tile: label = "round" shape = "round" end
        Tile: label = "squircle" shape = "squircle" end
        Tile: label = "bevel" shape = "bevel" end
        Tile: label = "scoop" shape = "scoop" end
        Tile: label = "notch" shape = "notch" end
        Tile: label = "scoop bevel" shape = "scoop bevel" end
    end
end
