import dom

func update():
    x := dom.GetValue(dom.ById("x"))
    y := dom.GetValue(dom.ById("y"))
    blur := dom.GetValue(dom.ById("blur"))
    radius := dom.GetValue(dom.ById("radius"))
    shadow := x + "px " + y + "px " + blur + "px rgb(0 0 0 / 35%)"
    dom.SetStyle(dom.ById("card"), "box-shadow", shadow)
    dom.SetStyle(dom.ById("card"), "border-radius", radius + "px")
    dom.SetText(dom.ById("css"), "box-shadow: " + shadow + "; border-radius: " + radius + "px")
end

page:
    title = "Shadow lab"
    global: selector = "body" font family = "system-ui, sans-serif" margin = "1.5rem" end
    box: id = "card" width = 180 height = 90 margin = "10px 0 20px" background = "white" border = "1px solid #cbd5e1" box shadow = "0px 4px 12px rgb(0 0 0 / 35%)" border radius = 12 end
    box: label: content = "x" width = 60 display = "inline-block" end input: type = "range" id = "x" min = "-20" max = "20" value = "0" input = update end end
    box: label: content = "y" width = 60 display = "inline-block" end input: type = "range" id = "y" min = "-20" max = "20" value = "4" input = update end end
    box: label: content = "blur" width = 60 display = "inline-block" end input: type = "range" id = "blur" min = "0" max = "40" value = "12" input = update end end
    box: label: content = "radius" width = 60 display = "inline-block" end input: type = "range" id = "radius" min = "0" max = "45" value = "12" input = update end end
    paragraph: id = "css" content = "box-shadow: 0px 4px 12px rgb(0 0 0 / 35%); border-radius: 12px" end
end
