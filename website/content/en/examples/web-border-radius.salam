component Tile(label, corners):
    box:
        width = 100
        height = 70
        background = #f59e0b
        layout = row
        align = center
        justify = center
        font size = 13
        radius = corners
        content = label
    end
end

page:
    title = "Rounded corners"
    global: selector = "body" font = system, sans margin = 1.5rem end
    box:
        layout = row gap = 14 wrap = true
        Tile: label = "12" corners = 12 end
        Tile: label = "30px 0" corners = "30px 0" end
        Tile: label = "pill" corners = "999px" end
        Tile: label = "50% / 30%" corners = "50% / 30%" end
        Tile: label = "4 values" corners = "40px 4px 40px 4px" end
        box: width = 70 height = 70 radius = 50% background = #f59e0b end
        box: width = 100 height = 70 border top left radius = 40 background = #f59e0b layout = row align = center justify = center font size = 13 content = "top left" end
        box: width = 100 height = 70 border start end radius = 35 background = #f59e0b layout = row align = center justify = center font size = 13 content = "start end" end
    end
end
