import dom
import web.canvas

mut x := 60.0
mut y := 60.0
mut dx := 3.0
mut dy := 2.0
mut c := 0 as i64

func main:
    el := dom.Create("canvas")
    dom.SetAttr(el, "id", "box")
    dom.SetAttr(el, "width", "360")
    dom.SetAttr(el, "height", "220")
    dom.Append(dom.Body(), el)
    c = canvas.Get("box")
    r := 14.0

    dom.EveryFrame((ms: f64):
        _ := ms
        w := canvas.Width(c)
        h := canvas.Height(c)
        x += dx
        y += dy
        if x < r or x > w - r:
            dx = 0.0 - dx
        end
        if y < r or y > h - r:
            dy = 0.0 - dy
        end
        canvas.FillStyle(c, "#10131a")
        canvas.FillRect(c, 0, 0, w, h)
        canvas.BeginPath(c)
        canvas.Arc(c, x, y, r, 0, 6.2832)
        canvas.FillStyle(c, "#f59e0b")
        canvas.Fill(c)
    end)
end
