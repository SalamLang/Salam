component Fold(name: str, title: str):
    open := false
    box:
        border = 1, solid, #e2e8f0
        radius = 10
        overflow = hidden
        margin = 0, 0, 8, 0
        button:
            id = "h-" + name
            width = fill
            text align = start
            padding = 12, 14
            font size = 16
            font weight = 400
            border = 0
            background = #f1f5f9
            cursor = pointer
            hover:
                background = #e0e7ff
            end
            if open:
                font weight = 700
            end
            aria expanded = open ? "true" : "false"
            click = (): open = not open end
            content = title
        end
        if open:
            box:
                padding = 0, 14, 12, 14
                content: end
            end
        end
    end
end

page:
    title = "Accordion"
    box:
        font = system, sans
        margin = 24
        max width = 480
        Fold: name = "ship" title = "How long does delivery take?"
            paragraph: content = "Two to four working days inside the country." end
        end
        Fold: name = "back" title = "Can I return an item?"
            paragraph: content = "Yes, within thirty days, if it is unused." end
        end
        Fold: name = "pay" title = "Which payment methods do you accept?"
            paragraph: content = "Cards and bank transfer." end
        end
    end
end
