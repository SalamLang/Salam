import dom

const LIMIT := 80

func measure:
    used := dom.GetNum(dom.ById("note"), "textLength") as i64
    dom.SetText(dom.ById("used"), "" + used + " / " + LIMIT)
    if used > LIMIT:
        dom.SetStyle(dom.ById("used"), "color", "#dc2626")
        dom.SetStyle(dom.ById("bar"), "width", "100%")
        dom.SetStyle(dom.ById("bar"), "background", "#dc2626")
    else:
        dom.SetStyle(dom.ById("used"), "color", "#475569")
        dom.SetStyle(dom.ById("bar"), "width", "" + used * 100 / LIMIT + "%")
        dom.SetStyle(dom.ById("bar"), "background", "#4f46e5")
    end
    dom.SetBool(dom.ById("post"), "disabled", used == 0 or used > LIMIT)
end

page:
    title = "Character counter"
    font = system, sans
    margin = 1.5rem
    max width = 28rem
    text area:
        id = "note"
        input = measure
        rows = 3
        placeholder = "Write a short note"
        width = 100%
        padding = 10
        font size = 1rem
        font = inherit
        radius = 8
        border = 1px, solid, #cbd5e1
    end
    box:
        height = 6
        background = #e2e8f0
        radius = 3
        margin = 6px, 0
        box:
            id = "bar"
            height = 100%
            width = 0%
            background = #4f46e5
            radius = 3
            transition = 0.15s
        end
    end
    box:
        layout = row
        justify = between
        align = center
        span:
            id = "used"
            content = "0 / 80"
            color = #475569
        end
        button:
            id = "post"
            disabled = true
            content = "Post"
            padding = 6px, 16px
        end
    end
end
