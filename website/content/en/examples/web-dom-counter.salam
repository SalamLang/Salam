import dom

mut count := 0

func draw:
    shown := dom.ById("value")
    dom.SetText(shown, "" + count)
    if count < 0:
        dom.SetStyle(shown, "color", "#dc2626")
    else:
        dom.SetStyle(shown, "color", "#0f172a")
    end
end

func more:
    count++
    draw()
end

func fewer:
    count--
    draw()
end

func start_over:
    count = 0
    draw()
end

page:
    title = "Counter"
    font = system, sans
    margin = 1.5rem
    box:
        max width = 16rem
        margin = 0, auto
        padding = 20
        text align = center
        border = 1px, solid, #e2e8f0
        radius = 14
        heading:
            id = "value"
            size = 1
            content = "0"
            font size = 4rem
            margin = 0, 0, 12px, 0
        end
        button:
            padding = 8px, 18px
            hover background = #e0e7ff
            font size = 1.1rem
            border = 1px, solid, #cbd5e1
            radius = 8
            background = #f8fafc
            cursor = pointer
            id = "minus"
            click = fewer
            content = "-1"
        end
        button:
            padding = 8px, 18px
            hover background = #e0e7ff
            font size = 1.1rem
            border = 1px, solid, #cbd5e1
            radius = 8
            background = #f8fafc
            cursor = pointer
            id = "plus"
            click = more
            content = "+1"
            margin = 0, 8px
        end
        button:
            padding = 8px, 18px
            hover background = #e0e7ff
            font size = 1.1rem
            border = 1px, solid, #cbd5e1
            radius = 8
            background = #f8fafc
            cursor = pointer
            id = "zero"
            click = start_over
            content = "Reset"
        end
    end
end
