import dom

func vote(name: str):
    total := dom.ById("votes-" + name)
    dom.SetText(total, "" + (dom.GetText(total).ToInt() + 1))
end

component Choice(name):
    box:
        class = "choice" layout = row justify = between align = center padding = 8px, 12px margin = 0, 0, 8px, 0 background = #f1f5f9 radius = 10
        button: padding = 6px, 14px border = 1px, solid, #6366f1 radius = 8 background = white color = #4338ca cursor = pointer click = (): vote(name) end content = "Vote for " + name end
        span: font size = 1.4rem font weight = bold color = #0f172a id = "votes-" + name content = "0" end
    end
end

page:
    title = "Poll"
    font = system, sans margin = 1.5rem max width = 26rem
    heading: size = 2 content = "Your favourite drink?" margin = 0, 0, 12px, 0 end
    Choice: name = "Tea" end
    Choice: name = "Coffee" end
    Choice: name = "Juice" end
end
