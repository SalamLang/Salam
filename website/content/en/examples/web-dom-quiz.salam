func question(n: int): str:
    switch n:
        0: ret "Which element is the largest heading?|h1|h6|header|0" end
        1: ret "Which attribute gives an image its text alternative?|alt|src|title|0" end
        else: ret "Which event fires when a field changes as you type?|click|input|load|1" end
    end
    ret ""
end

func part(n: int, k: int): str:
    ret question(n).Split("|").Get(k)
end

func right_answer(n: int): int:
    ret part(n, 4).ToInt()
end

func mark(n: int, picked: int, k: int): int:
    if picked < 0:
        ret 0
    end
    if k == right_answer(n):
        ret 1
    end
    if k == picked:
        ret 2
    end
    ret 0
end

component Choice(label: str, mark: int, pick):
    button:
        width = "fill"
        margin = 6, 0
        padding = 10, 14
        text align = "start"
        font size = 16
        border = 1, "solid", "#cbd5e1"
        radius = 8
        background = "white"
        cursor = "pointer"
        hover:
            background = "#eef2ff"
        end
        if mark == 1:
            background = "#dcfce7"
            border = 1, "solid", "#16a34a"
        end
        if mark == 2:
            background = "#fee2e2"
            border = 1, "solid", "#dc2626"
        end
        click = pick
        content = label
    end
end

component Quiz:
    asked := 0
    score := 0
    picked := -1
    box:
        font = "system", "sans"
        margin = 24
        max width = 448
        if asked < 3:
            heading:
                id = "ask"
                size = 3
                content = part(asked, 0)
            end
            Choice:
                label = part(asked, 1)
                mark = mark(asked, picked, 0)
                pick = ():
                    if picked < 0:
                        picked = 0
                        if right_answer(asked) == 0:
                            score++
                        end
                    end
                end
            end
            Choice:
                label = part(asked, 2)
                mark = mark(asked, picked, 1)
                pick = ():
                    if picked < 0:
                        picked = 1
                        if right_answer(asked) == 1:
                            score++
                        end
                    end
                end
            end
            Choice:
                label = part(asked, 3)
                mark = mark(asked, picked, 2)
                pick = ():
                    if picked < 0:
                        picked = 2
                        if right_answer(asked) == 2:
                            score++
                        end
                    end
                end
            end
            paragraph:
                id = "verdict"
                color = "#475569"
                content = picked < 0 ? "Pick an answer." : (picked == right_answer(asked) ? "Correct." : "Not this time.")
            end
        else:
            heading:
                size = 3
                content = "You scored " + score + " of 3."
            end
        end
        button:
            id = "next"
            padding = 8, 18
            border = 0
            background = "#4f46e5"
            color = "white"
            radius = 8
            cursor = "pointer"
            click = ():
                if asked == 3:
                    asked = 0
                    score = 0
                    picked = -1
                else picked >= 0:
                    asked++
                    picked = -1
                end
            end
            content = asked == 3 ? "Play again" : "Next"
        end
    end
end

page:
    title = "Quiz"
    Quiz: end
end
