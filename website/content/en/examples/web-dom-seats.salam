component Seat(change):
    taken := false
    button:
        width = 44
        height = 44
        border = 2, solid, #94a3b8
        radius = 8, 8, 14, 14
        background = white
        cursor = pointer
        hover:
            border = 2, solid, #4f46e5
        end
        if taken:
            background = #4f46e5
            border = 2, solid, #4f46e5
        end
        aria label = "Seat"
        click = ():
            taken = not taken
            change(taken ? 1 : -1)
        end
    end
end

component Seats:
    chosen := 0
    box:
        font = system, sans
        margin = 24
        box:
            layout = grid
            columns = 44, 44, 44, 44
            gap = 10
            Seat:
                change = (d: int): chosen += d end
            end
            Seat:
                change = (d: int): chosen += d end
            end
            Seat:
                change = (d: int): chosen += d end
            end
            Seat:
                change = (d: int): chosen += d end
            end
            Seat:
                change = (d: int): chosen += d end
            end
            Seat:
                change = (d: int): chosen += d end
            end
            Seat:
                change = (d: int): chosen += d end
            end
            Seat:
                change = (d: int): chosen += d end
            end
        end
        paragraph:
            id = "summary"
            color = #475569
            content = chosen + " of 8 seats chosen"
        end
    end
end

page:
    title = "Seats"
    Seats: end
end
