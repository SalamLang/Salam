component Choice(name: str):
    votes := 0
    box:
        class = "choice"
        layout = row
        gap = 12px
        align = center
        padding = 8px, 12px
        margin = 0, 0, 8px, 0
        background = #f1f5f9
        radius = 10
        button:
            padding = 6px, 14px
            border = 1px, solid, #6366f1
            radius = 8
            background = white
            color = #4338ca
            cursor = pointer
            click = (): votes++ end
            content = "Vote for " + name
        end
        span:
            font size = 1.4rem
            font weight = bold
            color = #0f172a
            content = "" + votes
        end
        if votes >= 3:
            span:
                class = "hot"
                font size = 0.9rem
                color = #b45309
                content = "popular"
            end
        end
    end
end

page:
    title = "Poll with variables"
    font = system, sans
    margin = 1.5rem
    max width = 26rem
    heading:
        size = 2
        content = "Your favourite drink?"
        margin = 0, 0, 12px, 0
    end
    Choice:
        name = "Tea"
    end
    Choice:
        name = "Coffee"
    end
    Choice:
        name = "Juice"
    end
end
