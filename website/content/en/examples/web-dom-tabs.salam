component Tab(label: str, active: bool, pick):
    button:
        padding = 10, 18
        border bottom = 3, "solid", "transparent"
        background = "white"
        font size = 16
        font weight = 400
        cursor = "pointer"
        hover:
            background = "#f1f5f9"
        end
        if active:
            border bottom = 3, "solid", "#4f46e5"
            font weight = 700
        end
        aria selected = active ? "true" : "false"
        click = pick
        content = label
    end
end

component Tabs:
    sel := 0
    box:
        font = "system", "sans"
        margin = 24
        max width = 512
        box:
            layout = "row"
            role = "tablist"
            border bottom = 1, "solid", "#e2e8f0"
            Tab:
                label = "Overview"
                active = sel == 0
                pick = (): sel = 0 end
            end
            Tab:
                label = "Recipe"
                active = sel == 1
                pick = (): sel = 1 end
            end
            Tab:
                label = "Reviews"
                active = sel == 2
                pick = (): sel = 2 end
            end
        end
        if sel == 0:
            box:
                padding = 14, 4
                content = "A flat bread baked on a hot stone in about four minutes."
            end
        else if sel == 1:
            box:
                padding = 14, 4
                content = "Flour, water, salt and a spoon of yeast. Rest the dough for an hour."
            end
        else:
            box:
                padding = 14, 4
                content = "Four and a half stars from 212 readers."
            end
        end
    end
end

page:
    title = "Tabs"
    Tabs: end
end
