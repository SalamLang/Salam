component Theme:
    night := false
    box:
        font = system, sans
        padding = 24
        min height = 192
        background = #f8fafc
        color = #0f172a
        transition = 300ms
        if night:
            background = #0f172a
            color = #e2e8f0
        end
        box:
            max width = 416
            padding = 20
            background = white
            border = 1, solid, #e2e8f0
            radius = 14
            if night:
                background = #1e293b
                border = 1, solid, #334155
            end
            heading: size = 2 content = "Good evening" margin = 0, 0, 8, 0 end
            paragraph: content = "One state variable changes every colour on the page." end
            button:
                id = "flip"
                padding = 8, 16
                radius = 8
                border = 1, solid, #6366f1
                background = #6366f1
                color = white
                cursor = pointer
                click = (): night = not night end
                content = night ? "Use the day theme" : "Use the night theme"
            end
        end
    end
end

page:
    title = "Theme"
    Theme: end
end
