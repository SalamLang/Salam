import dom

mut waiting := 0 as i64

component Toast:
    shown := false
    box:
        font = system, sans
        margin = 24
        button:
            id = "copy"
            padding = 10, 20
            font size = 16
            radius = 8
            border = 1, solid, #4f46e5
            background = #4f46e5
            color = white
            cursor = pointer
            click = ():
                dom.ClearTimeout(waiting)
                shown = true
                waiting = dom.SetTimeout((): shown = false end, 2000)
            end
            content = "Copy the link"
        end
        box:
            id = "toast"
            role = status
            margin = 14, 0, 0, 0
            padding = 10, 14
            background = #0f172a
            color = white
            radius = 8
            max width = 320
            opacity = 0
            translate = 0, 8
            interactive = false
            transition = 250ms
            if shown:
                opacity = 1
                translate = 0, 0
            end
            content = "Link copied. This message goes away in two seconds."
        end
    end
end

page:
    title = "Toast"
    Toast: end
end
