import dom

func total(items: Vector<str>): int:
    ret items.Len()
end

component Task(label: str, finish):
    held := label
    box:
        layout = row
        justify = between
        align = center
        padding = 8, 12
        margin = 6, 0
        background = #f1f5f9
        radius = 8
        paragraph: margin = 0 content = label end
        button:
            border = 0
            background = #e0e7ff
            radius = 6
            padding = 4, 10
            cursor = pointer
            click = (): finish(held) end
            content = "Done"
        end
    end
end

component Tasks:
    items := Vector {} as Vector<str>
    draft := ""
    box:
        font = system, sans
        margin = 24
        max width = 416
        form:
            id = "new"
            layout = row
            gap = 8
            submit = (e: i64):
                dom.PreventDefault(e)
                if draft.Len() > 0:
                    items.Push("" + draft)
                    draft = ""
                end
            end
            input:
                id = "name"
                grow = 1
                padding = 8
                font size = 16
                value = draft
                placeholder = "What needs doing?"
                input = (v: str): draft = v end
            end
            button: id = "add" type = submit padding = 8, 16 border = 0 background = #4f46e5 color = white radius = 8 cursor = pointer content = "Add" end
        end
        list:
            padding = 0
            each task in items:
                item:
                    key = task
                    Task: label = task
                        finish = (who: str):
                            repeat items.Len() in i:
                                if items.Get(i) == who:
                                    items.RemoveAt(i)
                                    break
                                end
                            end
                        end
                    end
                end
            end
        end
        paragraph: id = "left" color = #475569 content = total(items) + " to do" end
    end
end

page:
    title = "To do"
    Tasks: end
end
