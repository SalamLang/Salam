import dom

func lift(e: i64):
    dt := dom.GetProp(e, "dataTransfer")
    _ := dom.CallS2(dt, "setData", "text/plain", "parcel")
end

func allow(e: i64):
    dom.PreventDefault(e)
end

func land(e: i64):
    dom.PreventDefault(e)
    dt := dom.GetProp(e, "dataTransfer")
    id := dom.CallS1(dt, "getData", "text/plain")
    dom.Append(dom.ById("zone"), dom.ById("" + id))
    dom.SetText(dom.ById("status"), "Dropped: " + id)
end

page:
    title = "Drag and drop"
    font = system, sans
    margin = 24
    box:
        id = "parcel"
        draggable = true
        drag start = lift
        content = "Parcel"
        padding = 10px, 20px
        cursor = grab
        background = #fde68a
        radius = 6
    end
    box:
        id = "zone"
        drag over = allow
        drop = land
        margin top = 20
        padding = 30
        min height = 40
        border = 2px, dashed, #94a3b8
        radius = 8
        content = "Drop zone"
    end
    paragraph:
        id = "status"
        content = "Drag the parcel onto the zone."
    end
end
