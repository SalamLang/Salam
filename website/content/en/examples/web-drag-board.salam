import dom

func lift(e: i64):
    dt := dom.GetProp(e, "dataTransfer")
    _ := dom.CallS2(dt, "setData", "text/plain", dom.GetStr(dom.EventTarget(e), "id"))
end

component Task(key, label):
    box:
        id = key
        draggable = true
        drag start = lift
        padding = 8, 12
        margin bottom = 8
        background = white
        radius = 6
        cursor = grab
        content = label
    end
end

component Column(key, label):
    hot := false
    box:
        id = key
        background = #e2e8f0
        radius = 8
        padding = 12
        min height = 140
        width = 150
        outline = 2, solid, transparent
        if hot:
            outline = 2, solid, #2563eb
        end
        drag over = (e: i64): dom.PreventDefault(e) hot = true end
        drag leave = (): hot = false end
        drop = (e: i64):
            dom.PreventDefault(e)
            hot = false
            id := dom.CallS1(dom.GetProp(e, "dataTransfer"), "getData", "text/plain")
            dom.Append(dom.GetProp(e, "currentTarget"), dom.ById("" + id))
        end
        heading: size = 3 content = label margin = 0, 0, 10 end
        content: end
    end
end

page:
    title = "Board"
    box:
        font = system, sans
        margin = 24
        layout = row
        gap = 16
        Column: key = "todo" label = "To do"
            Task: key = "t1" label = "Write" end
            Task: key = "t2" label = "Test" end
        end
        Column: key = "doing" label = "Doing"
            Task: key = "t3" label = "Review" end
        end
        Column: key = "done" label = "Done" end
    end
end
