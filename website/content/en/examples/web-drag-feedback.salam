import dom

component Feedback:
    ticks := 0
    hot := false
    status := "Nothing yet."
    box:
        font = system, sans
        margin = 24
        box:
            id = "note"
            draggable = true
            padding = 10, 20
            background = #fde68a
            drag start = (e: i64):
                dt := dom.GetProp(e, "dataTransfer")
                _ := dom.CallS2(dt, "setData", "text/plain", "note")
                ticks = 0
                status = "drag start"
            end
            drag = (): ticks++ status = "drag fired " + ticks + " times" end
            drag end = (e: i64):
                status = "drag end, dropEffect = " + dom.GetStr(
                    dom.GetProp(e, "dataTransfer"), "dropEffect"
                )
            end
            content = "Sticky note"
        end
        box:
            id = "zone"
            margin top = 20
            padding = 30
            border = 2, dashed, #94a3b8
            radius = 8
            if hot:
                background = #dcfce7
                border = 2, dashed, #16a34a
            end
            drag over = (e: i64): dom.PreventDefault(e) end
            drag enter = (): hot = true end
            drag leave = (): hot = false end
            drop = (e: i64):
                dom.PreventDefault(e)
                hot = false
            end
            content = "Drop here"
        end
        paragraph:
            id = "log"
            content = status
        end
    end
end

page:
    title = "Drag feedback"
    Feedback: end
end
