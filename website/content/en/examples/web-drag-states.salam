import dom

mut trail := ""

func note(what: str):
    if trail.Len() > 110: trail = "" end
    trail = trail + what + "  "
    dom.SetText(dom.ById("trail"), trail)
end

func sees(e: i64):
    note("over:" + dom.GetStr(dom.EventTarget(e), "id"))
end

func leaves(e: i64):
    note("out:" + dom.GetStr(dom.EventTarget(e), "id"))
end

page:
    font = system, sans margin = 24
    box: id = "outer" width = 280 padding = 24 background = #ede9fe radius = 10
        content = "outer"
        pointer enter = (): note("enter") end pointer leave = (): note("leave") end
        pointer over = sees pointer out = leaves
        pointer cancel = (): note("cancel") end
        box: id = "inner" margin top = 12 padding = 20 background = #c4b5fd radius = 8 content = "inner" end
    end
    paragraph: id = "trail" white space = keep content = "Move a mouse, pen or finger over the boxes." end
end
