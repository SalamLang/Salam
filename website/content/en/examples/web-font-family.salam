page:
    title = "Font stacks"
    global: selector = "body" margin = 1.5rem line height = 1.6 end
    paragraph: font = "Georgia", "'Times New Roman'", serif content = "Serif: Georgia, then Times New Roman, then any serif font." end
    paragraph: font = system, sans content = "Sans serif: the interface font of the system." end
    paragraph: font = "ui-monospace", "Consolas", mono content = "Monospace: every letter is equally wide." end
    paragraph: font = "cursive" content = "Cursive: the look of handwriting." end
    paragraph: font = "NoSuchFont", serif content = "The first name does not exist, so the browser takes the next." end
end
