import dom

func Pressed(e: i64):
    dom.PreventDefault(e)
    dom.SetText(dom.ById("out"), "Pressed: " + dom.GetStr(dom.EventTarget(e), "value"))
end

page:
    title = "Buttons"
    font = "system", "sans"
    margin = 1.5rem
    form:
        id = "note"
        input:
            id = "t"
            name = "title"
            placeholder = "Title"
        end
        button:
            padding = 6px, 12px
            margin = 0.4rem, 0.4rem, 0, 0
            type = "submit"
            name = "do"
            value = "save"
            click = Pressed
            content = "Save"
        end
        button:
            padding = 6px, 12px
            margin = 0.4rem, 0.4rem, 0, 0
            type = "submit"
            name = "do"
            value = "draft"
            click = Pressed
            content = "Save draft"
        end
        button:
            padding = 6px, 12px
            margin = 0.4rem, 0.4rem, 0, 0
            type = "reset"
            content = "Clear"
        end
        button:
            padding = 6px, 12px
            margin = 0.4rem, 0.4rem, 0, 0
            type = "button"
            value = "help"
            click = Pressed
            content = "Help"
        end
    end
    button:
        padding = 6px, 12px
        margin = 0.4rem, 0.4rem, 0, 0
        type = "reset"
        form = "note"
        content = "Clear from outside"
    end
    paragraph:
        id = "out"
        content = "Nothing pressed yet."
    end
end
