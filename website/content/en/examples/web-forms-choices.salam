import dom

func Show:
    mut size := "small"
    if dom.GetBool(dom.ById("s-large"), "checked"): size = "large" end
    mut extras := ""
    if dom.GetBool(dom.ById("x-cheese"), "checked"): extras += " cheese" end
    if dom.GetBool(dom.ById("x-olives"), "checked"): extras += " olives" end
    dom.SetText(dom.ById("out"), "Size: " + size + ". Extras:" + extras)
end

page:
    title = "Pizza order"
    font = system, sans
    margin = 1.5rem
    form:
        change = Show
        field set:
            legend:
                content = "Size"
            end
            label:
                margin = 0.3rem, 0
                input:
                    id = "s-small"
                    type = radio
                    name = "size"
                    value = "small"
                    checked = true
                end
                span:
                    content = " Small"
                end
            end
            label:
                margin = 0.3rem, 0
                input:
                    id = "s-large"
                    type = radio
                    name = "size"
                    value = "large"
                end
                span:
                    content = " Large"
                end
            end
        end
        field set:
            legend:
                content = "Extras"
            end
            label:
                margin = 0.3rem, 0
                input:
                    id = "x-cheese"
                    type = checkbox
                    name = "extra"
                    value = "cheese"
                end
                span:
                    content = " Cheese"
                end
            end
            label:
                margin = 0.3rem, 0
                input:
                    id = "x-olives"
                    type = checkbox
                    name = "extra"
                    value = "olives"
                end
                span:
                    content = " Olives"
                end
            end
        end
    end
    paragraph:
        id = "out"
        content = "Size: small. Extras:"
    end
end
