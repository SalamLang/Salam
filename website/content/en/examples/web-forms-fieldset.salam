import dom

func Toggle:
    same := dom.GetBool(dom.ById("same"), "checked")
    dom.SetBool(dom.ById("ship"), "disabled", same)
end

page:
    title = "Grouped fields"
    font = system, sans
    margin = 1.5rem
    max width = 26rem
    form:
        field set:
            legend:
                content = "Billing address"
            end
            input:
                margin = 0.4rem, 0
                padding = 5
                name = "street"
                placeholder = "Street"
            end
            input:
                margin = 0.4rem, 0
                padding = 5
                name = "town"
                placeholder = "Town"
            end
        end
        label:
            input:
                id = "same"
                type = checkbox
                change = Toggle
            end
            span:
                content = " Ship to the same address"
            end
        end
        field set:
            id = "ship"
            legend:
                content = "Shipping address"
            end
            input:
                margin = 0.4rem, 0
                padding = 5
                name = "street2"
                placeholder = "Street"
            end
            input:
                margin = 0.4rem, 0
                padding = 5
                name = "town2"
                placeholder = "Town"
            end
        end
    end
end
