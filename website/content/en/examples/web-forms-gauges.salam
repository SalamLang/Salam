import dom

func Move:
    level := dom.GetValue(dom.ById("level"))
    dom.SetText(dom.ById("shown"), level + " %")
    dom.SetStr(dom.ById("bar"), "value", level)
    dom.SetStr(dom.ById("gauge"), "value", level)
end

page:
    title = "Output, progress, meter"
    font = "system", "sans"
    margin = 1.5rem
    form:
        label:
            for = "level"
            content = "Battery level "
        end
        input:
            id = "level"
            type = "range"
            min = 0
            max = 100
            value = 40
            input = Move
        end
        output:
            id = "shown"
            for = "level"
            content = "40 %"
        end
    end
    progress:
        width = 16rem
        margin = 0.6rem, 0
        id = "bar"
        value = 40
        max = 100
    end
    meter:
        width = 16rem
        margin = 0.6rem, 0
        id = "gauge"
        value = 40
        min = 0
        max = 100
        low = 25
        high = 75
        optimum = 100
    end
end
