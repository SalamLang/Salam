import dom

func Join(e: i64):
    dom.PreventDefault(e)
    if dom.Call0(dom.ById("sign"), "reportValidity") as bool:
        name := dom.GetValue(dom.ById("name"))
        mail := dom.GetValue(dom.ById("mail"))
        dom.SetText(dom.ById("out"), "Welcome, " + name + ". We will write to " + mail + ".")
    end
end

page:
    title = "Sign up"
    font = "system", "sans"
    margin = 1.5rem
    max width = 24rem
    form:
        id = "sign"
        label:
            margin = 0.8rem, 0, 0.2rem
            for = "name"
            content = "Your name"
        end
        input:
            padding = 6
            width = 100%
            id = "name"
            name = "name"
            required = true
            placeholder = "Ada Lovelace"
        end
        label:
            margin = 0.8rem, 0, 0.2rem
            for = "mail"
            content = "Email"
        end
        input:
            padding = 6
            width = 100%
            id = "mail"
            name = "mail"
            type = "email"
            required = true
            placeholder = "ada@example.com"
        end
        button:
            type = "submit"
            click = Join
            content = "Join"
            margin = 1rem, 0
            padding = 6px, 18px
        end
    end
    paragraph:
        id = "out"
        color = "#0f766e"
    end
end
