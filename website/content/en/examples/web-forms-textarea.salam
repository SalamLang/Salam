import dom

const LIMIT := 80

func Count:
    used := dom.GetNum(dom.ById("bio"), "textLength") as i64
    dom.SetText(dom.ById("left"), "" + (LIMIT - used) + " characters left")
end

page:
    title = "Long text"
    font = system, sans
    margin = 1.5rem
    label:
        for = "bio"
        content = "About you"
    end
    input:
        type = "textarea"
        id = "bio"
        name = "bio"
        rows = 4
        cols = 40
        maxlength = LIMIT
        placeholder = "A few words about yourself"
        input = Count

        margin = 0.4rem, 0
    end
    small:
        id = "left"
        content = "80 characters left"
    end
end
