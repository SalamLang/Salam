page:
    title = "Input types"
    global: selector = "body" font family = "system-ui, sans-serif" margin = "1.5rem" end
    form:
        display = grid
        grid template columns = "7rem 12rem"
        gap = "0.6rem 1rem"
        label: for = "n" content = "Number" end
        input: id = "n" type = number end
        label: for = "p" content = "Phone" end
        input: id = "p" type = tel end
        label: for = "u" content = "Web page" end
        input: id = "u" type = url end
        label: for = "q" content = "Search" end
        input: id = "q" type = search end
        label: for = "d" content = "Date" end
        input: id = "d" type = date end
        label: for = "t" content = "Time" end
        input: id = "t" type = time end
        label: for = "c" content = "Colour" end
        input: id = "c" type = color end
        label: for = "v" content = "Volume" end
        input: id = "v" type = range end
    end
end
