import dom

func mirror:
    dom.SetText(dom.ById("status"), "The note says: " + dom.GetText(dom.ById("note")))
end

page:
    font = system, sans
    margin = 1.5rem
    paragraph:
        content = "Click the box and type. It is a normal element that you can edit."
    end
    box:
        id = "note"
        contenteditable = true
        spellcheck = true
        tabindex = 0
        padding = 12
        border = 2px, dashed, #64748b
        radius = 8
        content = "A short note"
        input = mirror
    end
    paragraph:
        id = "status"
        content = "The note says: A short note"
    end
end
