page:
    font = "system", "sans"
    margin = 1.5rem
    button:
        popover target = "tip"
        content = "What is a popover?"
    end
    box:
        id = "tip"
        popover = "auto"
        padding = 14
        border = 1px, "solid", "#94a3b8"
        radius = 8
        content = "A box that opens on top of the page. Click outside it or press Escape to close."
    end
end
