page:
    font = system, sans
    margin = 1.5rem
    script:
        type = "module"
        content = "document.getElementById('log').textContent += ' module(waits for the page)'"
    end
    paragraph:
        content = "Order of events:"
    end
    paragraph:
        id = "log"
        content = ""
    end
    script:
        content = "document.getElementById('log').textContent += ' classic(runs at once)'"
    end
    noscript:
        content = "This page needs JavaScript to show the order."
    end
end
