import dom

mut x := 120
mut y := 60

func steer(e: i64):
    key := dom.EventKey(e)
    if key == "ArrowLeft":
        x -= 12
    else key == "ArrowRight":
        x += 12
    else key == "ArrowUp":
        y -= 12
    else key == "ArrowDown":
        y += 12
    else:
        ret
    end
    dom.PreventDefault(e)
    x = x < 0 ? 0 : (x > 270 ? 270 : x)
    y = y < 0 ? 0 : (y > 120 ? 120 : y)
    dom.SetStyle(dom.ById("ball"), "left", x + "px")
    dom.SetStyle(dom.ById("ball"), "top", y + "px")
end

page:
    title = "Arrow keys"
    font = "system", "sans"
    margin = 1.5rem
    box:
        id = "arena"
        tab index = 0
        key down = steer

        width = 300
        height = 150
        background = "#ecfeff"
        border = 2px, "solid", "#67e8f9"
        radius = 10
        box:
            id = "ball"
            position = "absolute"
            left = 120
            top = 60
            width = 30
            height = 30
            radius = 50%
            background = "#0891b2"
        end
    end
    paragraph:
        content = "Click the box, then use the arrow keys."
    end
end
