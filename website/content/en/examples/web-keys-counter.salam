import dom

func count:
    n := dom.GetValue(dom.ById("msg")).Len()
    left := dom.ById("left")
    dom.SetText(left, n + " / 80")
    if n >= 70:
        dom.SetStyle(left, "color", "#b91c1c")
    else:
        dom.SetStyle(left, "color", "#475569")
    end
end

page:
    title = "Character counter"
    font = system, sans
    margin = 1.5rem
    input:
        type = "textarea"
        id = "msg"
        input = count
        maxlength = 80
        rows = 3
        placeholder = "A short message"
        width = 100%
        padding = 10
        font size = 1rem
    end
    paragraph:
        id = "left"
        content = "0 / 80"
        text align = right
        margin = 4px, 0
    end
end
