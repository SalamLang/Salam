import dom

func typing(e: i64):
    field := dom.ById("task")
    key := dom.EventKey(e)
    if key == "Enter" and dom.GetValue(field).Len() > 0:
        item := dom.Create("li")
        dom.SetText(item, dom.GetValue(field))
        dom.Append(dom.ById("list"), item)
        dom.SetValue(field, "")
    else key == "Escape":
        dom.SetValue(field, "")
    end
end

page:
    title = "Task list"
    font = "system", "sans"
    margin = 1.5rem
    max width = 28rem
    input:
        id = "task"
        key down = typing
        placeholder = "New task, then Enter"
        width = 100%
        padding = 10
        font size = 1rem
    end
    paragraph:
        content = "Enter adds the task. Escape clears the box."
        color = "#64748b"
        font size = 0.9rem
    end
    list:
        id = "list"
    end
end
