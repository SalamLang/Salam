component Group:
    active := false
    box:
        font = system, sans
        margin = 24
        padding = 14
        border = 2, solid, #cbd5e1
        radius = 10
        transition = 200ms
        if active:
            border = 2, solid, #2563eb
            background = #eff6ff
        end
        focus in = (): active = true end
        focus out = (): active = false end
        paragraph: content = "Delivery address" font weight = bold margin = 0 end
        input: id = "street" width = 100% padding = 8 margin = 6, 0 font size = 16 placeholder = "Street" end
        input: id = "city" width = 100% padding = 8 margin = 6, 0 font size = 16 placeholder = "City" end
    end
end

page:
    title = "A group that follows focus"
    Group: end
end
