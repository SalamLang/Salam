import dom

func send(e: i64):
    dom.PreventDefault(e)
    who := dom.GetValue(dom.ById("who"))
    mail := dom.GetValue(dom.ById("mail"))
    dom.SetText(dom.ById("result"), "Thank you, " + who + ". We will write to " + mail + ".")
end

func cleared:
    dom.SetText(dom.ById("result"), "The form was cleared.")
end

page:
    title = "Sign up"
    font = "system", "sans"
    margin = 1.5rem
    form:
        id = "signup"
        submit = send
        reset = cleared
        input:
            width = 100%
            padding = 10
            margin = 0, 0, 10px, 0
            font size = 1rem
            id = "who"
            placeholder = "Your name"
        end
        input:
            width = 100%
            padding = 10
            margin = 0, 0, 10px, 0
            font size = 1rem
            id = "mail"
            type = "email"
            placeholder = "Your email"
        end
        button:
            padding = 8px, 16px
            margin = 0, 8px, 0, 0
            font size = 1rem
            id = "go"
            type = "submit"
            content = "Sign up"
        end
        button:
            padding = 8px, 16px
            margin = 0, 8px, 0, 0
            font size = 1rem
            id = "clear"
            type = "reset"
            content = "Clear"
        end
    end
    paragraph:
        id = "result"
        content = ""
        color = "#047857"
    end
end
