page:
    title = "Responsive card grid"
    global: selector = "body" font = system, sans margin = 20 end
    box:
        layout = grid grid template columns = "repeat(auto-fit, minmax(140px, 1fr))" gap = 12
        box: background = #fecaca padding = 24 radius = 8 content = "One" end
        box: background = #fed7aa padding = 24 radius = 8 content = "Two" end
        box: background = #fde68a padding = 24 radius = 8 content = "Three" end
        box: background = #bbf7d0 padding = 24 radius = 8 content = "Four" end
        box: background = #bae6fd padding = 24 radius = 8 content = "Five" end
        box: background = #ddd6fe padding = 24 radius = 8 content = "Six" end
    end
end
