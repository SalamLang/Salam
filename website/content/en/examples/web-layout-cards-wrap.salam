page:
    title = "Cards that wrap"
    global: selector = "body" font = system, sans margin = 20 end
    box:
        layout = row wrap = true gap = 12
        box: grow = 1 shrink = 1 basis = 160px background = #fecaca padding = 16 radius = 8 content = "Card one" end
        box: grow = 1 shrink = 1 basis = 160px background = #fed7aa padding = 16 radius = 8 content = "Card two" end
        box: grow = 1 shrink = 1 basis = 160px background = #fde68a padding = 16 radius = 8 content = "Card three" end
        box: grow = 1 shrink = 1 basis = 160px background = #bbf7d0 padding = 16 radius = 8 content = "Card four" end
        box: grow = 1 shrink = 1 basis = 160px background = #bae6fd padding = 16 radius = 8 content = "Card five" end
    end
end
