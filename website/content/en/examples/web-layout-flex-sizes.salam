page:
    title = "Grow, shrink and basis"
    global: selector = "body" font = system, sans margin = 20 end
    paragraph: margin = 0, 0, 6 content = "flex grow 1, 2 and 1" end
    box:
        layout = row gap = 8 margin bottom = 16
        box: grow = 1 background = #fca5a5 padding = 10 content = "1" end
        box: grow = 2 background = #93c5fd padding = 10 content = "2" end
        box: grow = 1 background = #86efac padding = 10 content = "1" end
    end
    paragraph: margin = 0, 0, 6 content = "fixed 120 pixel box, then flex = 1" end
    box:
        layout = row gap = 8
        box: grow = 0 shrink = 0 basis = 120px background = #fcd34d padding = 10 content = "fixed" end
        box: grow = 1 background = #c4b5fd padding = 10 content = "takes the rest" end
    end
end
