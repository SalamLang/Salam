page:
    title = "Sticky footer"
    global: selector = "body" font = system, sans margin = 0 end
    box:
        layout = column min height = 100vh
        header: background = #0f766e color = white padding = 14 content = "Header" end
        main: grow = 1 padding = 16 content = "The page is short, yet the footer stays at the bottom." end
        footer: background = #134e4a color = white padding = 14 content = "Footer" end
    end
end
