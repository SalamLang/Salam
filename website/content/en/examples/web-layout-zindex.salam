page:
    title = "Stacking order"
    global: selector = "body" font = system, sans margin = 20 end
    box:
        height = 180
        box: position = absolute top = 60 left = 120 width = 150 height = 110 background = #86efac layer = 3 padding = 8 font size = 28 content = "3" end
        box: position = absolute top = 0 left = 0 width = 150 height = 110 background = #fca5a5 layer = 1 padding = 8 font size = 28 content = "1" end
        box: position = absolute top = 30 left = 60 width = 150 height = 110 background = #93c5fd layer = 2 padding = 8 font size = 28 content = "2" end
    end
    paragraph: content = "The box with the biggest z index is painted on top, whatever the order in the code." end
end
