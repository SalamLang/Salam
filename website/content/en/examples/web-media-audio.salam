page:
    title = "Audio"
    global: selector = "body" font family = "system-ui, sans-serif" margin = "1.5rem" end
    paragraph: content = "A short beep. Press play:" end
    audio:
        controls = true
        preload = "auto"
        content = "Your browser cannot play audio."
        source: url = "data:audio/wav;base64," type = "audio/wav" end
        source: url = "beep.mp3" type = "audio/mpeg" end
    end
    paragraph: content = "The browser plays the first source it understands." end
end
