page:
    title = "Video"
    global: selector = "body" font family = "system-ui, sans-serif" margin = "1.5rem" end
    video:
        width = 288
        controls = true
        autoplay = true
        muted = true
        loop = true
        plays inline = true
        preload = "auto"
        poster = "data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%2096%2054%27%3E%3Crect%20width=%2796%27%20height=%2754%27%20fill=%27%23134e4a%27/%3E%3Cpath%20d=%27M40%2018%20L40%2036%20L56%2027Z%27%20fill=%27%23ccfbf1%27/%3E%3C/svg%3E"
        content = "Your browser cannot play video."
        source: url = "data:video/webm;base64," type = "video/webm" end
        track: url = "captions/en.vtt" kind = "subtitles" srclang = "en" label = "English" default = true end
    end
end
