import dom

mut lines := ""

func say(what: str):
    lines = lines + what + "\n"
    dom.SetText(dom.ById("log"), lines)
end

func again():
    lines = ""
    say("ready")
end

page:
    title = "Transition events"
    box:
        width = 260
        padding = 10, 0
        box:
            id = "ball"
            width = 40
            height = 40
            radius = 50%
            background = "#e11d48"
            transition = 600ms, "ease out"
            hover width = 200
            transition start = (): say("transition start") end
            transition end = (): say("transition end") end
            transition cancel = (): say("transition cancel") end
        end
        button:
            id = "again"
            click = again
            content = "Reset"
        end
        paragraph:
            id = "log"
            white space = "keep"
            content = "ready"
        end
    end
end
