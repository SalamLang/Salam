import dom

mut lines := ""
mut wired := false

func record(kind: str, e: i64):
    lines = lines + kind + ": " + dom.GetStr(e, "propertyName") + "\n"
    dom.SetText(dom.ById("log"), lines)
end

func wire_events():
    if not wired:
        wired = true
        chip := dom.ById("chip")
        dom.OnEventE(chip, "transitionrun", (e: i64): record("run", e) end)
        dom.OnEventE(chip, "transitionstart", (e: i64): record("start", e) end)
        dom.OnEventE(chip, "transitioncancel", (e: i64): record("cancel", e) end)
    end
end

component Mover:
    moved := false
    box:
        font = system, sans
        margin = 24
        box:
            width = 240
            padding = 10, 0
            box:
                id = "chip"
                width = 50
                height = 40
                radius = 8
                background = #2563eb
                translate = 0, 0
                transition = 400ms
                if moved:
                    translate = 180, 0
                end
                transition end = (e: i64): record("end", e) end
            end
        end
        box:
            layout = row
            gap = 8
            button:
                click = (): wire_events() lines = "" moved = not moved end
                content = "Move it"
            end
            button:
                click = ():
                    wire_events()
                    lines = ""
                    moved = not moved
                    dom.SetTimeout((): moved = not moved end, 150)
                end
                content = "Move and undo"
            end
        end
        paragraph:
            id = "log"
            white space = keep
            content = ""
        end
    end
end

page:
    title = "Transition events"
    Mover: end
end
