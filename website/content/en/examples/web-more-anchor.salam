import dom

page:
    title = "Anchored tooltip"
    global: selector = "body" font = system, sans margin = 1.5rem line height = 1.6 end
    box: layout = row gap = 8 margin = 0, 0, 1rem
        button: click = (): dom.SetStyle(dom.ById("tip"), "position-area", "top") end content = "Top" end
        button: click = (): dom.SetStyle(dom.ById("tip"), "position-area", "right") end content = "Right" end
        button: click = (): dom.SetStyle(dom.ById("tip"), "position-area", "bottom") end content = "Bottom" end
        button: click = (): dom.SetStyle(dom.ById("tip"), "position-area", "left") end content = "Left" end
    end
    box: height = 220 border = 1px, dashed, #94a3b8 radius = 8
        box: id = "target" anchor name = "--target" margin = 80, auto, 0 width = 120 padding = 12 text align = center background = #0f766e color = white radius = 6 content = "Anchor" end
        box: id = "tip" position = absolute position anchor = "--target" position area = top position try fallbacks = flip-block position visible = true margin = 6 padding = 4, 10 background = #0f172a color = white radius = 6 content = "Tooltip" end
    end
end
