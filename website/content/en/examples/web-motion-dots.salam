component Dot(wait):
    box:
        width = 16
        height = 16
        border radius = "50%"
        background = "#1d4ed8"
        animation name = bounce
        animation duration = "0.5s"
        animation timing function = "ease-in-out"
        animation iteration count = infinite
        animation direction = alternate
        animation delay = wait
    end
end

page:
    title = "Bouncing dots"
    style: content = "@keyframes bounce { from { transform: translateY(0) } to { transform: translateY(-28px) } }" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 30 end
    box:
        display = flex
        gap = 10
        align items = "flex-end"
        height = 50
        Dot: wait = "0s" end
        Dot: wait = "0.15s" end
        Dot: wait = "0.3s" end
    end
end
