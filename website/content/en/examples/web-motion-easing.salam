import dom

func run():
    dom.ToggleClass(dom.ById("lanes"), "go")
end

component Lane(timing):
    box:
        class = "track"
        position = relative
        height = 28
        margin = "6 0"
        background = "#e2e8f0"
        border radius = 14
        box: width = 28 height = 28 border radius = 14 background = "#0f766e" transition = "transform 1.5s " + timing end
        paragraph: position = absolute top = 4 left = 40 margin = 0 font size = 13 content = timing end
    end
end

page:
    title = "Timing functions"
    style: content = ".go .track > div { transform: translateX(260px) }" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 20 end
    box:
        id = "lanes"
        max width = 340
        Lane: timing = "linear" end
        Lane: timing = "ease-in" end
        Lane: timing = "ease-out" end
        Lane: timing = "steps(5)" end
        Lane: timing = "cubic-bezier(0.3, 1.6, 0.6, 1)" end
    end
    button: margin top = 10 click = run content = "Run" end
end
