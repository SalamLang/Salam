import dom

func replay():
    dom.AddClass(dom.ById("list"), "off")
    dom.SetTimeout((): dom.RemoveClass(dom.ById("list"), "off") end, 60)
end

component Row(text, wait):
    box:
        padding = 12
        margin = "0 0 8"
        background = "#e0f2fe"
        border radius = 8
        animation name = rise
        animation duration = "0.5s"
        animation fill mode = both
        animation delay = wait
        content = text
    end
end

page:
    title = "Entering one by one"
    style: content = "@keyframes rise { from { opacity: 0; transform: translateY(16px) } to { opacity: 1; transform: none } } .off > div { animation: none }" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 24 end
    box:
        id = "list"
        max width = 320
        Row: text = "First" wait = "0s" end
        Row: text = "Second" wait = "0.2s" end
        Row: text = "Third" wait = "0.4s" end
    end
    button: click = replay content = "Replay" end
end
