import dom

mut open := false

func toggle():
    open = not open
    if open:
        dom.SetStyle(dom.ById("panel"), "height", "auto")
    else:
        dom.SetStyle(dom.ById("panel"), "height", "0")
    end
end

page:
    title = "Animating to auto"
    global: selector = ":root" interpolate size = "allow-keywords" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 24 end
    button: click = toggle content = "Show details" end
    box:
        id = "panel"
        height = 0
        overflow = hidden
        transition = "height 400ms ease"
        paragraph: margin = "12 0" content = "The panel is as tall as its text. Its height goes from 0 to auto, which CSS could not animate before." end
    end
end
