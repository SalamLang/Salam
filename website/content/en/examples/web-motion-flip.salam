import dom

mut flipped := false

func flip():
    flipped = not flipped
    if flipped:
        dom.SetStyle(dom.ById("card"), "transform", "rotateY(180deg)")
    else:
        dom.SetStyle(dom.ById("card"), "transform", "rotateY(0deg)")
    end
end

page:
    title = "A flipping card"
    global: selector = "body" font = system, sans margin = 30 end
    box:
        width = 200
        height = 120
        perspective = 800
        button:
            id = "card"
            click = flip
            
            width = 100%
            height = 100%
            padding = 0
            border = none
            background = none
            font size = 18
            transform style = "preserve-3d"
            transition = 600ms
            span: position = absolute top = 0 left = 0 width = 100% height = 100% line height = 120px radius = 12 background = #0f766e color = white backface visible = false content = "Front" end
            span: position = absolute top = 0 left = 0 width = 100% height = 100% line height = 120px radius = 12 background = #f59e0b transform = "rotateY(180deg)" backface visibility = hidden content = "Back" end
        end
    end
end
