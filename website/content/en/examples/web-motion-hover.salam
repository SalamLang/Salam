page:
    title = "A hover transition"
    global: selector = "body" font = system, sans margin = 30 background = #f1f5f9 end
    box:
        width = 240
        padding = 20
        background = white
        radius = 12
        shadow = [0, 1px, 3px, rgba(0, 0, 0, 0.25)]
        transition = 200ms, ease out
        hover transform = "translateY(-6px)"
        hover shadow = [0, 14px, 24px, rgba(0, 0, 0, 0.25)]
        heading: size = 3 margin = 0, 0, 8 content = "Hover over me" end
        paragraph: margin = 0 content = "The card lifts and its shadow grows over 200 milliseconds." end
    end
end
