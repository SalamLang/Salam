page:
    title = "Motion along a path"
    style: content = "@keyframes drive { to { offset-distance: 100% } }" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 30 end
    box:
        height = 130
        width = 260
        padding = "40 0 0 20"
        box sizing = "border-box"
        border = "1px dashed #94a3b8"
        box:
            width = 28
            height = 20
            background = "#f59e0b"
            clip path = "polygon(0 0, 100% 50%, 0 100%)"
            offset path = "path('M 0 40 C 60 -40, 120 120, 200 40')"
            offset rotate = auto
            animation = "drive 3s ease-in-out infinite alternate"
        end
    end
end
