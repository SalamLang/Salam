import dom

mut running := true

func toggle():
    running = not running
    if running:
        dom.SetStyle(dom.ById("ring"), "animation-play-state", "running")
        dom.SetText(dom.ById("btn"), "Pause")
    else:
        dom.SetStyle(dom.ById("ring"), "animation-play-state", "paused")
        dom.SetText(dom.ById("btn"), "Play")
    end
end

page:
    title = "Pause an animation"
    style: content = "@keyframes spin { to { transform: rotate(1turn) } }" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 30 end
    box:
        id = "ring"
        width = 48
        height = 48
        border = "6px solid #e2e8f0"
        border top color = "#be123c"
        border radius = "50%"
        animation = "spin 1.2s linear infinite"
    end
    button: id = "btn" margin top = 16 click = toggle content = "Pause" end
end
