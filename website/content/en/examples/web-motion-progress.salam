page:
    title = "A reading progress bar"
    style: content = "@keyframes fill { from { transform: scaleX(0) } to { transform: scaleX(1) } }" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 0 line height = 1.7 end
    box:
        position = fixed
        top = 0
        left = 0
        width = "100%"
        height = 6
        background = "#0f766e"
        transform origin = "0 50%"
        animation name = fill
        animation timing function = linear
        animation timeline = "scroll()"
    end
    box:
        padding = 24
        heading: size = 2 content = "Scroll down" end
        paragraph: repeat = 14 content = "The bar at the top grows with the scroll position. No script reads the scroll, the browser connects the animation to it." end
    end
end
