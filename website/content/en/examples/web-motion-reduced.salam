page:
    title = "Respecting reduced motion"
    style: content = "@keyframes pulse { 50% { transform: scale(1.25); opacity: 0.6 } } @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important } }" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 30 end
    box:
        width = 40
        height = 40
        border radius = "50%"
        background = "#be123c"
        animation = "pulse 1.2s ease-in-out infinite"
    end
    paragraph: content = "This dot pulses, unless your system asks for reduced motion." end
end
