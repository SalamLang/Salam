page:
    title = "Reveal on scroll"
    style: content = "@keyframes show { from { opacity: 0; transform: translateY(30px) } to { opacity: 1; transform: none } }" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 24 end
    heading: size = 2 content = "Scroll down" end
    box:
        height = 160
        margin = "0 0 40"
        padding = 16
        background = "#e0f2fe"
        border radius = 10
        animation name = show
        animation timing function = linear
        animation fill mode = both
        animation timeline = "view()"
        animation range = "entry 0% entry 100%"
        repeat = 6
        content = "I fade in while I enter the screen"
    end
end
