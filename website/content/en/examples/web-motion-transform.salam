component Tile(label, move, from):
    box:
        width = 90
        height = 60
        display = grid
        place items = center
        background = "#bfdbfe"
        border = "2px solid #1d4ed8"
        transform = move
        transform origin = from
        content = label
    end
end

page:
    title = "Transform functions"
    global: selector = "body" font family = "system-ui, sans-serif" margin = 30 end
    box:
        display = flex
        flex wrap = wrap
        gap = 36
        Tile: label = "translate" move = "translate(20px, 10px)" from = "center" end
        Tile: label = "rotate" move = "rotate(-12deg)" from = "center" end
        Tile: label = "scale" move = "scale(1.25)" from = "center" end
        Tile: label = "skew" move = "skew(-15deg, 0)" from = "center" end
        Tile: label = "origin" move = "rotate(25deg)" from = "top left" end
        box:
            width = 90
            height = 60
            display = grid
            place items = center
            background = "#fde68a"
            border = "2px solid #b45309"
            rotate = "8deg"
            scale = 1.1
            translate = "0 12px"
            content = "separate"
        end
    end
end
