page:
    title = "A view transition"
    style: content = ".wide { width: 240px !important; height: 100px !important; background: #f59e0b !important } ::view-transition-group(tile) { animation-duration: 500ms }" end
    global: selector = "body" font family = "system-ui, sans-serif" margin = 30 end
    box:
        id = "tile"
        width = 80
        height = 80
        background = "#0f766e"
        border radius = 12
        view transition name = tile
    end
    button: margin top = 16 click = "var f = function () { document.getElementById('tile').classList.toggle('wide') }; if (document.startViewTransition) { document.startViewTransition(f) } else { f() }" content = "Morph" end
end
