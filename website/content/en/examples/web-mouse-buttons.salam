import dom

mut history := ""
mut lines := 0

func note(text: str):
    lines++
    if lines > 7:
        history = ""
        lines = 1
    end
    history = history + text + "\n"
    dom.SetText(dom.ById("log"), history)
end

func aux(e: i64):
    note("aux click, button " + (dom.GetNum(e, "button") as i64))
end

func menu(e: i64):
    dom.PreventDefault(e)
    note("context menu (the browser menu is blocked)")
end

page:
    title = "Kinds of clicks"
    font = system, sans
    margin = 1.5rem
    box:
        id = "pad"
        click = (): note("click") end
        double click = (): note("double click") end
        aux click = aux
        context menu = menu
        content = "Click, double click, middle click or right click here"
        padding = 28
        background = #e0f2fe
        radius = 10
        selectable = false
    end
    paragraph:
        id = "log"
        content = "Nothing yet."
        white space = keep
        min height = 10em
    end
end
