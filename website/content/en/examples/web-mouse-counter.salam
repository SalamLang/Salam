import dom

mut count := 0

func show:
    dom.SetText(dom.ById("n"), "" + count)
end

page:
    title = "Click counter"
    font = system, sans
    margin = 1.5rem
    text align = center
    heading:
        id = "n"
        size = 1
        content = "0"
        font size = 4rem
        margin = 0, 0, 12px, 0
    end
    button:
        id = "plus"
        click = (): count++ show() end
        content = "+1"
        padding = 8px, 18px
        font size = 1.1rem
    end
    button:
        id = "reset"
        click = (): count = 0 show() end
        content = "Reset"
        padding = 8px, 18px
        font size = 1.1rem
        margin = 0, 0, 0, 8px
    end
end
