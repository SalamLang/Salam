import dom

component Board:
    drawing := false
    xs := Vector {} as Vector<int>
    ys := Vector {} as Vector<int>
    box:
        font = system, sans
        margin = 24
        box:
            id = "board"
            height = 200
            background = "#faf5ff"
            border = 2, dashed, #c4b5fd
            radius = 10
            cursor = "crosshair"
            overflow = "hidden"
            selectable = false
            mouse down = (e: i64):
                drawing = true
                r := dom.Call0(dom.ById("board"), "getBoundingClientRect")
                xs.Push((dom.EventX(e) - dom.GetNum(r, "left")) as int)
                ys.Push((dom.EventY(e) - dom.GetNum(r, "top")) as int)
            end
            mouse move = (e: i64):
                if drawing:
                    r := dom.Call0(dom.ById("board"), "getBoundingClientRect")
                    xs.Push((dom.EventX(e) - dom.GetNum(r, "left")) as int)
                    ys.Push((dom.EventY(e) - dom.GetNum(r, "top")) as int)
                end
            end
            mouse up = (): drawing = false end
            mouse leave = (): drawing = false end
            each i, x in xs:
                box:
                    key = i
                    position = "absolute"
                    left = x - 5
                    top = ys.Get(i) - 5
                    width = 10
                    height = 10
                    radius = 5
                    background = "#7c3aed"
                    interactive = false
                end
            end
        end
        button:
            id = "clear"
            margin = 10, 0, 0, 0
            padding = 6, 14
            click = (): xs = Vector {} as Vector<int> ys = Vector {} as Vector<int> end
            content = "Clear"
        end
    end
end

page:
    title = "Drawing"
    Board: end
end
