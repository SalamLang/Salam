import dom

mut enters := 0
mut leaves := 0
mut overs := 0
mut outs := 0

func show_a:
    dom.SetText(dom.ById("count-a"), "enter " + enters + ", leave " + leaves)
end

func show_b:
    dom.SetText(dom.ById("count-b"), "over " + overs + ", out " + outs)
end

page:
    title = "Enter and leave"
    font = "system", "sans"
    margin = 1.5rem
    box:
        layout = "row"
        gap = 24
        wrap = true
        box:
            heading:
                size = 3
                content = "enter and leave"
                margin = 0, 0, 8px, 0
            end
            box:
                id = "a"
                class = "zone"
                height = 90
                width = 220
                background = "#dbeafe"
                radius = 10
                padding = 10
                content = "outer"
                mouse enter = (): enters++ show_a() end
                mouse leave = (): leaves++ show_a() end
                box:
                    id = "a-inner"
                    class = "inner"
                    position = "absolute"
                    right = 10
                    top = 10
                    width = 70
                    height = 70
                    background = "#2563eb"
                    color = "white"
                    radius = 8
                    text align = "center"
                    content = "inner"
                end
            end
            paragraph:
                id = "count-a"
                content = "enter 0, leave 0"
            end
        end
        box:
            heading:
                size = 3
                content = "over and out"
                margin = 0, 0, 8px, 0
            end
            box:
                id = "b"
                class = "zone"
                height = 90
                width = 220
                background = "#dbeafe"
                radius = 10
                padding = 10
                content = "outer"
                mouse over = (): overs++ show_b() end
                mouse out = (): outs++ show_b() end
                box:
                    id = "b-inner"
                    class = "inner"
                    position = "absolute"
                    right = 10
                    top = 10
                    width = 70
                    height = 70
                    background = "#2563eb"
                    color = "white"
                    radius = 8
                    text align = "center"
                    content = "inner"
                end
            end
            paragraph:
                id = "count-b"
                content = "over 0, out 0"
            end
        end
    end
end
