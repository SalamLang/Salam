import dom

mut named_clicks := 0

func named():
    named_clicks++
    dom.SetText(dom.ById("out"), "named function, click " + named_clicks)
end

func with_event(e: i64):
    dom.SetText(dom.ById("out"), "named function with the event, pointer at x " + dom.EventX(e))
end

page:
    title = "Four ways to handle a click"
    font = "system", "sans"
    margin = 1.5rem
    paragraph:
        id = "out"
        content = "Press a button."
    end
    button:
        padding = 8px, 14px
        margin = 0, 8px, 8px, 0
        font size = 1rem
        click = named
        content = "Named function"
    end
    button:
        padding = 8px, 14px
        margin = 0, 8px, 8px, 0
        font size = 1rem
        click = with_event
        content = "With the event"
    end
    button:
        padding = 8px, 14px
        margin = 0, 8px, 8px, 0
        font size = 1rem
        click = (): dom.SetText(dom.ById("out"), "lambda") end
        content = "Lambda"
    end
    button:
        padding = 8px, 14px
        margin = 0, 8px, 8px, 0
        font size = 1rem
        click = "this.textContent = 'JS string was here'"
        content = "JS string"
    end
end
