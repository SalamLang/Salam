import dom

page:
    title = "Hover"
    font = "system", "sans"
    margin = 1.5rem
    button:
        padding = 10px, 18px
        margin = 0, 12px, 0, 0
        font size = 1rem
        border = "none"
        radius = 8
        color = "white"
        id = "css"
        content = "Hover in CSS"
        background = "#0f766e"
        transition = 0.2s
        hover background = "#115e59"
    end
    button:
        padding = 10px, 18px
        margin = 0, 12px, 0, 0
        font size = 1rem
        border = "none"
        radius = 8
        color = "white"
        id = "js"
        content = "Hover in JS"
        background = "#0f766e"
        mouse over = (): dom.SetStyle(dom.ById("js"), "background", "#115e59") end
        mouse out = (): dom.SetStyle(dom.ById("js"), "background", "#0f766e") end
    end
    paragraph:
        content = "Both look the same. Only the first one needs no script."
    end
end
