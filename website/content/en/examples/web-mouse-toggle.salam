import dom

page:
    title = "Lamp"
    style: content = "#room.on { background: #fde68a; color: #422006 } #room.on .bulb { background: #f59e0b }" end
    font = system, sans margin = 1.5rem
    box:
        id = "room"
        background = #1e293b
        color = #e2e8f0
        padding = 24
        radius = 12
        text align = center
        transition = 0.3s
        box: class = "bulb" width = 60 height = 60 margin = 0, auto, 12px background = #475569 radius = 50% end
        button: id = "switch" click = (): dom.ToggleClass(dom.ById("room"), "on") end content = "Switch" padding = 6px, 16px end
    end
end
