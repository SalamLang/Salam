component Lamp:
    lit := false
    box:
        font = system, sans
        margin = 24
        background = #1e293b
        color = #e2e8f0
        padding = 24
        radius = 12
        text align = center
        transition = 300ms
        if lit:
            background = #fde68a
            color = #422006
        end
        box:
            width = 60
            height = 60
            margin = 0, auto, 12, auto
            background = #475569
            radius = 30
            if lit:
                background = #f59e0b
            end
        end
        button:
            id = "switch"
            padding = 6, 16
            click = (): lit = not lit end
            content = "Switch"
        end
    end
end

page:
    title = "Lamp"
    Lamp: end
end
