import dom

mut zoom := 1.0

func scroll_zoom(e: i64):
    dom.PreventDefault(e)
    if dom.GetNum(e, "deltaY") < 0.0:
        zoom *= 1.1
    else:
        zoom /= 1.1
    end
    if zoom > 3.0:
        zoom = 3.0
    end
    if zoom < 0.5:
        zoom = 0.5
    end
    percent := (zoom * 100.0) as i64
    dom.SetStyle(dom.ById("card"), "transform", "scale(" + zoom + ")")
    dom.SetText(dom.ById("level"), "Zoom " + percent + "%")
end

page:
    title = "Wheel zoom"
    font = system, sans
    margin = 1.5rem
    box:
        id = "stage"
        wheel = scroll_zoom
        height = 200
        overflow = hidden
        background = #f1f5f9
        radius = 10
        layout = row
        align = center
        justify = center
        box:
            id = "card"
            content = "Scroll the wheel over me"
            padding = 24
            background = #0f766e
            color = white
            radius = 10
        end
    end
    paragraph:
        id = "level"
        content = "Zoom 100%"
    end
end
