component Tag(name):
    link: url = "#" content = name display = inline-block padding = "3px 12px" margin = "0 6px 6px 0" border radius = 999 background = "#e0f2f1" color = "#115e59" text decoration = none font size = "0.9rem" hover background = "#99f6e4" end
end

page:
    title = "Garden Notes: why mulch matters"
    global: selector = "nav a" text decoration = none end
    global: selector = "body" font family = "Georgia, serif" margin = 0 color = "#1c1917" background = "#fffdf8" line height = 1.75 end
    header:
        padding = "18px 5vw" border bottom = "1px solid #e7e5e4" display = flex justify content = space-between align items = baseline flex wrap = wrap gap = 8
        strong: content = "Garden Notes" font size = "1.5rem" color = "#0f766e" end
        nav: display = flex gap = 18 font family = "system-ui, sans-serif" font size = "0.95rem"
            link: url = "#" content = "Home" color = "#44403c" end
            link: url = "#" content = "Archive" color = "#44403c" end
            link: url = "#" content = "About" color = "#44403c" end
        end
    end
    box:
        display = grid grid template columns = "minmax(0, 1fr) 17rem" gap = 40 padding = "36px 5vw" max width = "70rem" margin = "0 auto"
        media: condition = "(max-width: 760px)" grid template columns = "1fr" gap = 24 end
        main:
            article:
                header:
                    heading: size = 1 content = "Why mulch matters" font size = "2.4rem" line height = 1.2 margin = "0 0 8px 0" end
                    paragraph: color = "#78716c" margin = "0 0 24px 0" font family = "system-ui, sans-serif" font size = "0.9rem"
                        content = "By Sara Nikoo, "
                        time: datetime = "2026-10-26" content = "26 October 2026" end
                        span: content = ", 4 minute read" end
                    end
                end
                figure:
                    margin = "0 0 24px 0"
                    box: height = 220 border radius = 14 background = "linear-gradient(160deg, #86efac, #166534)" end
                    figure caption: content = "A thick straw layer, one week after planting." color = "#78716c" font size = "0.85rem" margin top = 8 end
                end
                paragraph: content = "Bare soil loses water fast. A layer of straw or leaves keeps the sun off it, and the beds stay damp for days after rain." end
                heading: size = 2 content = "Fewer weeds" margin = "28px 0 8px 0" end
                paragraph: content = "Seeds in the dark do not sprout. Spread the mulch five centimetres deep and most weeds never start." end
                block quote: margin = "24px 0" padding = "4px 20px" border inline start = "4px solid #14b8a6" color = "#134e4a" font style = italic content = "The best tool in my garden is a wheelbarrow of old straw." end
                paragraph: content = "Keep it a hand away from the stems, so they can breathe." end
            end
        end
        aside:
            font family = "system-ui, sans-serif"
            heading: size = 2 content = "About the author" font size = "1.1rem" margin = "0 0 6px 0" end
            paragraph: content = "Sara grows vegetables on a small balcony and writes about what works." font size = "0.95rem" color = "#57534e" end
            heading: size = 2 content = "Topics" font size = "1.1rem" margin = "22px 0 8px 0" end
            box: Tag: name = "Soil" end Tag: name = "Water" end Tag: name = "Weeds" end Tag: name = "Compost" end end
        end
    end
    footer: padding = "24px 5vw" border top = "1px solid #e7e5e4" color = "#78716c" font family = "system-ui, sans-serif" font size = "0.9rem" content = "Garden Notes. Written slowly." end
end
