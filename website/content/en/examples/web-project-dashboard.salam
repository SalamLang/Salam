component Stat(label, value, change, tone):
    box:
        background = white padding = 18 radius = 14 shadow = [0, 1px, 3px, rgb(15 23 42 / 10%)]
        paragraph: content = label margin = 0 color = #64748b font size = 0.85rem end
        paragraph: content = value margin = 4px, 0 font size = 1.9rem font weight = bold end
        small: content = change color = tone font weight = 600 end
    end
end

component Bar(day, value):
    box:
        grow = 1 text align = center
        box: layout = row align = "end" justify = center height = 150
            box: width = 70% height = value + "%" content = value padding top = 4 color = white font size = 0.8rem background = #6366f1 radius = 8px, 8px, 0, 0 transition = 0.2s hover background = #4338ca end
        end
        small: content = day color = #475569 end
    end
end

component Pill(text, back, front):
    span: content = text padding = 2px, 10px radius = 999 font size = 0.8rem background = back color = front end
end

page:
    title = "Shop dashboard"
    font = system, sans margin = 0 background = #f1f5f9 color = #0f172a
    header: layout = row justify = between align = center padding = 16px, 5vw background = #0f172a color = white
        strong: content = "Hazel and Co" end
        small: content = "Week 43" color = #94a3b8 end
    end
    main: padding = 24px, 5vw layout = grid gap = 20
        box: layout = grid columns = repeat(fit, minmax(180px, 1fr)) gap = 16
            Stat: label = "Revenue" value = "$8,420" change = "+12% this week" tone = #15803d end
            Stat: label = "Orders" value = "312" change = "+5%" tone = #15803d end
            Stat: label = "Returns" value = "9" change = "-2 since Monday" tone = #15803d end
            Stat: label = "Open tickets" value = "14" change = "+6 since Monday" tone = #b91c1c end
        end
        box: layout = grid columns = repeat(fit, minmax(300px, 1fr)) gap = 16
            section: background = white padding = 18 radius = 14
                heading: size = 2 content = "Orders per day" font size = 1.1rem margin = 0, 0, 12px, 0 end
                box: layout = row gap = 8
                    Bar: day = "Mon" value = 45 end
                    Bar: day = "Tue" value = 62 end
                    Bar: day = "Wed" value = 38 end
                    Bar: day = "Thu" value = 80 end
                    Bar: day = "Fri" value = 95 end
                    Bar: day = "Sat" value = 70 end
                    Bar: day = "Sun" value = 30 end
                end
            end
            section: background = white padding = 18 radius = 14 overflow = auto
                heading: size = 2 content = "Latest orders" font size = 1.1rem margin = 0, 0, 12px, 0 end
                table: width = 100% 
                    header: row: header column: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 content = "Order" end header column: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 content = "Customer" end header column: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 content = "Status" end end end
                    main:
                        row: cell: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 content = #2041 end cell: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 content = "Mina Rahimi" end cell: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 Pill: text = "Shipped" back = #dcfce7 front = #166534 end end end
                        row: cell: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 content = #2040 end cell: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 content = "Tom Becker" end cell: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 Pill: text = "Packing" back = #fef3c7 front = #92400e end end end
                        row: cell: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 content = #2039 end cell: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 content = "Lena Novak" end cell: padding = 10px, 8px text align = left border bottom = 1px, solid, #e2e8f0 Pill: text = "Refunded" back = #fee2e2 front = #991b1b end end end
                    end
                end
            end
        end
    end
end
