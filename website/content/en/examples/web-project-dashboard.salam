component Stat(label, value, change, tone):
    box:
        background = white padding = 18 border radius = 14 box shadow = "0 1px 3px rgba(15,23,42,0.1)"
        paragraph: content = label margin = 0 color = "#64748b" font size = "0.85rem" end
        paragraph: content = value margin = "4px 0" font size = "1.9rem" font weight = bold end
        small: content = change color = tone font weight = 600 end
    end
end

component Bar(day, value):
    box:
        flex = 1 text align = center
        box: display = flex align items = flex-end justify content = center height = 150
            box: width = "70%" height = value + "%" content = value padding top = 4 color = white font size = "0.8rem" background = "#6366f1" border radius = "8px 8px 0 0" transition = "background 0.2s" hover background = "#4338ca" end
        end
        small: content = day color = "#475569" end
    end
end

component Pill(text, back, front):
    span: content = text padding = "2px 10px" border radius = 999 font size = "0.8rem" background = back color = front end
end

page:
    title = "Shop dashboard"
    global: selector = "body" font family = "system-ui, sans-serif" margin = 0 background = "#f1f5f9" color = "#0f172a" end
    global: selector = "td, th" padding = "10px 8px" text align = left border bottom = "1px solid #e2e8f0" end
    header: display = flex justify content = space-between align items = center padding = "16px 5vw" background = "#0f172a" color = white
        strong: content = "Hazel and Co" end
        small: content = "Week 43" color = "#94a3b8" end
    end
    main: padding = "24px 5vw" display = grid gap = 20
        box: display = grid grid template columns = "repeat(auto-fit, minmax(180px, 1fr))" gap = 16
            Stat: label = "Revenue" value = "$8,420" change = "+12% this week" tone = "#15803d" end
            Stat: label = "Orders" value = "312" change = "+5%" tone = "#15803d" end
            Stat: label = "Returns" value = "9" change = "-2 since Monday" tone = "#15803d" end
            Stat: label = "Open tickets" value = "14" change = "+6 since Monday" tone = "#b91c1c" end
        end
        box: display = grid grid template columns = "repeat(auto-fit, minmax(300px, 1fr))" gap = 16
            section: background = white padding = 18 border radius = 14
                heading: size = 2 content = "Orders per day" font size = "1.1rem" margin = "0 0 12px 0" end
                box: display = flex gap = 8
                    Bar: day = "Mon" value = 45 end
                    Bar: day = "Tue" value = 62 end
                    Bar: day = "Wed" value = 38 end
                    Bar: day = "Thu" value = 80 end
                    Bar: day = "Fri" value = 95 end
                    Bar: day = "Sat" value = 70 end
                    Bar: day = "Sun" value = 30 end
                end
            end
            section: background = white padding = 18 border radius = 14 overflow = auto
                heading: size = 2 content = "Latest orders" font size = "1.1rem" margin = "0 0 12px 0" end
                table: width = "100%" border collapse = collapse
                    header: row: header column: content = "Order" end header column: content = "Customer" end header column: content = "Status" end end end
                    main:
                        row: cell: content = "#2041" end cell: content = "Mina Rahimi" end cell: Pill: text = "Shipped" back = "#dcfce7" front = "#166534" end end end
                        row: cell: content = "#2040" end cell: content = "Tom Becker" end cell: Pill: text = "Packing" back = "#fef3c7" front = "#92400e" end end end
                        row: cell: content = "#2039" end cell: content = "Lena Novak" end cell: Pill: text = "Refunded" back = "#fee2e2" front = "#991b1b" end end end
                    end
                end
            end
        end
    end
end
