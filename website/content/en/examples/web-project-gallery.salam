import dom

func title_of(n: int): str:
    switch n:
        0: ret "Sunrise" end
        1: ret "Camp" end
        2: ret "Dunes" end
        3: ret "Oasis" end
        4: ret "Stars" end
        else: ret "Road home" end
    end
    ret ""
end

func light_of(n: int): str:
    switch n:
        0: ret "#f97316" end
        1: ret "#7c3aed" end
        2: ret "#d97706" end
        3: ret "#059669" end
        4: ret "#1e1b4b" end
        else: ret "#475569" end
    end
    ret ""
end

func deep_of(n: int): str:
    switch n:
        0: ret "#facc15" end
        1: ret "#ec4899" end
        2: ret "#fde68a" end
        3: ret "#67e8f9" end
        4: ret "#6366f1" end
        else: ret "#cbd5e1" end
    end
    ret ""
end

func shade(n: int): str:
    ret "linear(135, " + light_of(n) + ", " + deep_of(n) + ")"
end

component Shot(title: str, shade: str, pick):
    button:
        background = shade
        aspect ratio = 1.3333
        border = 0
        radius = 12
        color = "white"
        font size = 16
        font weight = 600
        text align = "start"
        padding = 12
        cursor = "pointer"
        transition = 150ms
        hover:
            scale = 1.04
        end
        click = pick
        content = title
    end
end

component Gallery:
    current := -1
    box:
        font = system, sans
        padding = 24, 40
        background = "#0f172a"
        color = "white"
        min height = 640
        heading:
            size = 1
            content = "Trip to the dunes"
            font size = 29
            margin = 0, 0, 16, 0
        end
        box:
            layout = "grid"
            columns = repeat (fill, minmax(150, 1fr))
            gap = 12
            Shot:
                title = title_of(0)
                shade = shade(0)
                pick = (): current = 0 end
            end
            Shot:
                title = title_of(1)
                shade = shade(1)
                pick = (): current = 1 end
            end
            Shot:
                title = title_of(2)
                shade = shade(2)
                pick = (): current = 2 end
            end
            Shot:
                title = title_of(3)
                shade = shade(3)
                pick = (): current = 3 end
            end
            Shot:
                title = title_of(4)
                shade = shade(4)
                pick = (): current = 4 end
            end
            Shot:
                title = title_of(5)
                shade = shade(5)
                pick = (): current = 5 end
            end
        end
        if current >= 0:
            box:
                id = "lightbox"
                position = "fixed"
                inset = 0
                layout = "stack"
                align = "center"
                justify = "center"
                key down = (e: i64):
                    if dom.EventKey(e) == "ArrowRight":
                        current = (current + 1) % 6
                    else dom.EventKey(e) == "ArrowLeft":
                        current = (current + 5) % 6
                    end
                end
                box:
                    id = "backdrop"
                    width = "fill"
                    height = "fill"
                    background = "#0f172ab3"
                    click = (): current = -1 end
                end
                box:
                    width = 92%
                    max width = 544
                    padding = 16
                    radius = 16
                    background = "white"
                    color = "#0f172a"
                    box:
                        id = "big"
                        height = 260
                        radius = 12
                        background = shade(current)
                    end
                    paragraph:
                        id = "cap"
                        margin = 12, 0
                        font weight = 600
                        content = title_of(current) + " (" + (current + 1) + " of 6)"
                    end
                    box:
                        layout = "row"
                        gap = 8
                        button:
                            id = "back"
                            padding = 8, 16
                            border = 0
                            radius = 8
                            background = "#e2e8f0"
                            cursor = "pointer"
                            click = (): current = (current + 5) % 6 end
                            content = "Previous"
                        end
                        button:
                            id = "forth"
                            padding = 8, 16
                            border = 0
                            radius = 8
                            background = "#e2e8f0"
                            cursor = "pointer"
                            click = (): current = (current + 1) % 6 end
                            content = "Next"
                        end
                        button:
                            id = "shut"
                            autofocus = true
                            padding = 8, 16
                            border = 0
                            radius = 8
                            background = "#e2e8f0"
                            cursor = "pointer"
                            margin start = "auto"
                            click = (): current = -1 end
                            content = "Close"
                        end
                    end
                end
            end
        end
    end
end

page:
    title = "Photo gallery"
    Gallery: end
end
