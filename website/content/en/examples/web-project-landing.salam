const BRAND := "Kettle"
const ACCENT := "#b45309"

component Plan(name, price, note):
    section:
        class = "plan" background = white border = "1px solid #e7e5e4" border radius = 16 padding = 24 text align = center
        transition = "transform 0.2s, box-shadow 0.2s"
        hover transform = "translateY(-4px)"
        hover box shadow = "0 12px 28px rgba(0,0,0,0.12)"
        heading: size = 3 content = name margin = "0 0 6px 0" end
        paragraph: content = price font size = "2.2rem" font weight = bold color = ACCENT margin = 0 end
        paragraph: content = note color = "#78716c" margin = "4px 0 16px 0" end
        content: end
        button: content = "Choose " + name padding = "10px 22px" border = 0 border radius = 999 background = "#292524" color = white cursor = pointer hover background = ACCENT end
    end
end

page:
    title = BRAND + " coffee club"
    global: selector = "body" font family = "system-ui, sans-serif" margin = 0 color = "#292524" background = "#fafaf9" line height = 1.6 end
    header:
        display = flex justify content = space-between align items = center padding = "16px 6vw"
        strong: content = BRAND font size = "1.4rem" color = ACCENT end
        nav: display = flex gap = 22
            link: url = "#features" content = "Why us" color = "#44403c" text decoration = none hover color = ACCENT end
            link: url = "#plans" content = "Plans" color = "#44403c" text decoration = none hover color = ACCENT end
        end
    end
    main:
        section:
            padding = "72px 6vw" text align = center background = "linear-gradient(135deg, #fef3c7, #fed7aa)"
            heading: size = 1 content = "Fresh coffee, every Monday" font size = "clamp(2rem, 6vw, 3.4rem)" margin = "0 0 12px 0" end
            paragraph: content = "Beans roasted this week, ground the way you like, at your door before breakfast." max width = "34rem" margin = "0 auto 24px auto" font size = "1.15rem" end
            button: content = "Start my first box" padding = "14px 30px" border = 0 border radius = 999 background = ACCENT color = white font size = "1.05rem" cursor = pointer hover background = "#92400e" end
        end
        section:
            id = "features" padding = "56px 6vw"
            heading: size = 2 content = "Why people stay" text align = center margin = "0 0 28px 0" end
            box: display = grid grid template columns = "repeat(auto-fit, minmax(200px, 1fr))" gap = 24
                box: heading: size = 3 content = "Roasted to order" end paragraph: content = "Nothing sits on a shelf. Every bag is roasted after you order it." end end
                box: heading: size = 3 content = "Skip or pause" end paragraph: content = "Going away? Pause in two clicks. No fees, no calls." end end
                box: heading: size = 3 content = "Fair prices" end paragraph: content = "We buy from farms we know and tell you what each one earned." end end
            end
        end
        section:
            id = "plans" padding = "56px 6vw" background = "#f5f5f4"
            heading: size = 2 content = "Pick a plan" text align = center margin = "0 0 28px 0" end
            box: display = grid grid template columns = "repeat(auto-fit, minmax(220px, 1fr))" gap = 24
                Plan: name = "Solo" price = "$12" note = "one bag a month" paragraph: content = "250 g, any roast" end end
                Plan: name = "Duo" price = "$21" note = "two bags a month" paragraph: content = "2 x 250 g, mixed" end end
                Plan: name = "Office" price = "$58" note = "six bags a month" paragraph: content = "6 x 250 g, grinder tips" end end
            end
        end
    end
    footer: padding = "28px 6vw" text align = center color = "#78716c" content = "Kettle coffee club. Made with care in a small kitchen." end
end
