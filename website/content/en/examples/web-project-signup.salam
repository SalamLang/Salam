import dom

func strength(word: str): int:
    mut score := 0
    if word.Len() >= 8:
        score++
    end
    if word.Lower() != word:
        score++
    end
    repeat 10 in d:
        if word.Includes("" + d):
            score++
            break
        end
    end
    ret score
end

func good_name(name: str): bool:
    ret name.Len() >= 2
end

func good_mail(mail: str): bool:
    ret mail.Includes("@") and mail.Includes(".") and mail.Len() >= 6
end

func good_again(word: str, again: str): bool:
    ret word.Len() > 0 and again == word
end

component Signup:
    name := ""
    mail := ""
    word := ""
    again := ""
    shown := false
    greeting := ""
    form:
        id = "signup"
        font = system, sans
        max width = 384
        margin = 28, auto
        padding = 28
        background = white
        radius = 16
        shadow = 0, 10, 30, #4f46e526
        submit = (e: i64):
            dom.PreventDefault(e)
            greeting = "Welcome, " + name + ". Check your inbox."
        end
        heading:
            size = 2
            content = "Create an account"
            margin = 0, 0, 4, 0
        end
        label:
            for = "name"
            font weight = 600
            margin = 14, 0, 4, 0
            content = "Name"
        end
        input:
            id = "name"
            autocomplete = name
            width = fill
            padding = 10, 12
            radius = 8
            font size = 16
            border = 2, solid, #cbd5e1
            focus:
                border = 2, solid, #6366f1
            end
            if name.Len() > 0 and good_name(name):
                border = 2, solid, #22c55e
            end
            if name.Len() > 0 and not good_name(name):
                border = 2, solid, #ef4444
            end
            input = (v: str): name = v end
        end
        paragraph:
            id = "name-note"
            color = #dc2626
            font size = 14
            min height = 20
            margin = 4, 0, 0, 0
            content = good_name(name) ? "" : "Please tell us your name."
        end
        label:
            for = "mail"
            font weight = 600
            margin = 14, 0, 4, 0
            content = "Email"
        end
        input:
            id = "mail"
            type = email
            autocomplete = email
            width = fill
            padding = 10, 12
            radius = 8
            font size = 16
            border = 2, solid, #cbd5e1
            focus:
                border = 2, solid, #6366f1
            end
            if mail.Len() > 0 and good_mail(mail):
                border = 2, solid, #22c55e
            end
            if mail.Len() > 0 and not good_mail(mail):
                border = 2, solid, #ef4444
            end
            input = (v: str): mail = v end
        end
        paragraph:
            id = "mail-note"
            color = #dc2626
            font size = 14
            min height = 20
            margin = 4, 0, 0, 0
            content = good_mail(mail) ? "" : "That does not look like an email address."
        end
        label:
            for = "pw"
            font weight = 600
            margin = 14, 0, 4, 0
            content = "Password"
        end
        input:
            id = "pw"
            type = shown ? "text" : "password"
            autocomplete = "new-password"
            width = fill
            padding = 10, 12
            radius = 8
            font size = 16
            border = 2, solid, #cbd5e1
            focus:
                border = 2, solid, #6366f1
            end
            if word.Len() > 0 and strength(word) == 3:
                border = 2, solid, #22c55e
            end
            if word.Len() > 0 and strength(word) != 3:
                border = 2, solid, #ef4444
            end
            input = (v: str): word = v end
        end
        box:
            height = 6
            background = #e2e8f0
            radius = 3
            margin = 6, 0
            box:
                id = "meter"
                height = fill
                width = strength(word) * 33 + "%"
                background = #6366f1
                radius = 3
                transition = 200ms
            end
        end
        paragraph:
            id = "pw-note"
            color = #dc2626
            font size = 14
            min height = 20
            margin = 4, 0, 0, 0
            content = strength(word) == 3 ? "" : "Use 8 characters, a capital letter and a digit."
        end
        button:
            id = "peek"
            type = button
            background = transparent
            border = 0
            color = #4f46e5
            cursor = pointer
            padding = 0
            click = (): shown = not shown end
            content = "Show or hide password"
        end
        label:
            for = "again"
            font weight = 600
            margin = 14, 0, 4, 0
            content = "Repeat the password"
        end
        input:
            id = "again"
            type = password
            width = fill
            padding = 10, 12
            radius = 8
            font size = 16
            border = 2, solid, #cbd5e1
            focus:
                border = 2, solid, #6366f1
            end
            if again.Len() > 0 and good_again(word, again):
                border = 2, solid, #22c55e
            end
            if again.Len() > 0 and not good_again(word, again):
                border = 2, solid, #ef4444
            end
            input = (v: str): again = v end
        end
        paragraph:
            id = "again-note"
            color = #dc2626
            font size = 14
            min height = 20
            margin = 4, 0, 0, 0
            content = good_again(word, again) ? "" : "The two passwords differ."
        end
        button:
            id = "join"
            type = submit
            disabled = not (good_name(name) and good_mail(mail) and strength(word) == 3 and good_again(word, again))
            width = fill
            padding = 12
            margin = 10, 0, 0, 0
            border = 0
            radius = 10
            background = #4f46e5
            color = white
            font size = 16
            cursor = pointer
            disabled:
                opacity = 0.5
                cursor = not allowed
            end
            content = "Join"
        end
        paragraph:
            id = "done"
            color = #15803d
            font weight = 600
            content = greeting
        end
    end
end

page:
    title = "Create an account"
    box:
        background = #eef2ff
        min height = 640
        Signup: end
    end
end
