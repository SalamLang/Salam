import dom

func load(): Vector<str>:
    mut found := Vector {} as Vector<str>
    lines := dom.StoreGetStr("todos").Split("\n")
    repeat lines.Len() - 1 in i:
        found.Push(lines.Get(i))
    end
    ret found
end

func joined(items: Vector<str>): str:
    mut text := ""
    repeat items.Len() in i:
        text += items.Get(i) + "\n"
    end
    ret text
end

func is_done(entry: str): bool:
    ret entry.Substr(0, 1) == "1"
end

func words(entry: str): str:
    ret entry.Substr(1, entry.Len())
end

func shows(mode: int, entry: str): bool:
    ret mode == 0 or (mode == 1 and not is_done(entry)) or (mode == 2 and is_done(entry))
end

func open_count(items: Vector<str>): int:
    mut open := 0
    repeat items.Len() in i:
        if not is_done(items.Get(i)):
            open++
        end
    end
    ret open
end

component Pick(label: str, active: bool, choose):
    button:
        border = 0
        background = transparent
        padding = 4, 10
        radius = 6
        cursor = pointer
        if active:
            background = #e0e7ff
            color = #3730a3
        end
        click = choose
        content = label
    end
end

component Row(entry: str, flip, remove):
    held := entry
    box:
        layout = row
        align = center
        padding = 10, 4
        border bottom = 1, solid, #e2e8f0
        input: type = checkbox checked = is_done(entry) change = (): flip(held) end end
        span: grow = 1 padding = 0, 10 color = is_done(entry) ? "#94a3b8" : "#0f172a" decoration = is_done(entry) ? "strike" : "none" content = words(entry) end
        button:
            border = 0
            background = transparent
            color = #94a3b8
            cursor = pointer
            hover:
                color = #dc2626
            end
            click = (): remove(held) end
            content = "x"
        end
    end
end

component Tasks:
    items := load() as Vector<str>
    mode := 0
    draft := ""
    main:
        font = system, sans
        max width = 448
        margin = 28, auto
        padding = 24
        background = white
        radius = 16
        shadow = 0, 8, 24, #0f172a14
        heading: size = 1 content = "Tasks" font size = 29 margin = 0, 0, 14, 0 end
        form:
            layout = row
            gap = 8
            submit = (e: i64):
                dom.PreventDefault(e)
                if draft.Len() > 0:
                    items.Push("0" + draft)
                    draft = ""
                    dom.StoreSetStr("todos", joined(items))
                end
            end
            input:
                id = "new"
                grow = 1
                padding = 10
                border = 2, solid, #e2e8f0
                radius = 8
                font size = 16
                value = draft
                placeholder = "Add a task"
                input = (v: str): draft = v end
            end
            button: type = submit padding = 0, 18 border = 0 radius = 8 background = #4f46e5 color = white cursor = pointer content = "Add" end
        end
        list:
            padding = 0
            margin = 12, 0
            each entry in items:
                if shows(mode, entry):
                    item:
                        key = entry
                        Row: entry = entry
                            flip = (who: str):
                                repeat items.Len() in i:
                                    if items.Get(i) == who:
                                        items.Set(i, (is_done(who) ? "0" : "1") + words(who))
                                        break
                                    end
                                end
                                dom.StoreSetStr("todos", joined(items))
                            end
                            remove = (who: str):
                                repeat items.Len() in i:
                                    if items.Get(i) == who:
                                        items.RemoveAt(i)
                                        break
                                    end
                                end
                                dom.StoreSetStr("todos", joined(items))
                            end
                        end
                    end
                end
            end
        end
        box:
            layout = row
            justify = between
            align = center
            color = #64748b
            font size = 14
            span: id = "left" content = open_count(items) + " left" end
            box:
                layout = row
                Pick: label = "All" active = mode == 0 choose = (): mode = 0 end end
                Pick: label = "Active" active = mode == 1 choose = (): mode = 1 end end
                Pick: label = "Done" active = mode == 2 choose = (): mode = 2 end end
            end
        end
    end
end

page:
    title = "Tasks"
    box:
        background = #f8fafc
        min height = 640
        Tasks: end
    end
end
