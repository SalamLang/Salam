page:
    title = "Visible focus"
    global: selector = "body" font = system, sans margin = 24 end
    global: selector = "a:focus-visible, button:focus-visible" outline = 3px, solid, #7c3aed outline offset = 3 end
    box:
        
        layout = column
        gap = 12
        max width = 320
        label:
            content = "Your name"
            input:
                id = "name"
                
                width = 100%
                
                margin top = 4
                padding = 8
                border = 2px, solid, #94a3b8
                radius = 6
                outline = none
                focus border color = #1d4ed8
                focus shadow = 0, 0, 0, 4px, #bfdbfe
            end
        end
        button: padding = 8, 16 content = "Send" end
        link: url = "#top" align self = start content = "A link to tab to" end
    end
end
