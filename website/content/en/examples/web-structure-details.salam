page:
    title = "Questions"
    font = system, sans margin = 1.5rem max width = 30rem
    details: border = 1px, solid, #cbd5e1 radius = 8 padding = 8px, 12px margin bottom = 8 name = "faq" open = true
        summary: cursor = pointer font weight = bold content = "What is a page block?" end
        paragraph: content = "It holds everything on the page." end
    end
    details: border = 1px, solid, #cbd5e1 radius = 8 padding = 8px, 12px margin bottom = 8 name = "faq"
        summary: cursor = pointer font weight = bold content = "Can two be open at once?" end
        paragraph: content = "Not here. They share the name faq, so opening one closes the other." end
    end
    details: border = 1px, solid, #cbd5e1 radius = 8 padding = 8px, 12px margin bottom = 8
        summary: cursor = pointer font weight = bold content = "And this one?" end
        paragraph: content = "It has no name, so it opens and closes on its own." end
    end
end
