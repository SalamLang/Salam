page:
    title = "Price list"
    font = system, sans margin = 1.5rem
    table: border collapse = collapse
        caption: content = "Fruit prices this week" end
        header:
            row:
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "Fruit" end
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "Kilos" end
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "Price" end
            end
        end
        main:
            row:
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "Apples" end
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "3" end
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "4.50" end
            end
            row:
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "Pears" end
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "2" end
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "3.20" end
            end
        end
        footer:
            row:
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "Total" end
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "5" end
                column: padding = 8px, 14px border bottom = 1px, solid, #cbd5e1 text align = left content = "7.70" end
            end
        end
    end
end
