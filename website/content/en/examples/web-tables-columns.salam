page:
    title = "Styling columns"
    font = system, sans
    margin = 1.5rem
    table:
        column group:
            column definition:
                background = #e2e8f0
            end
            column definition:
                span = 2
                background = #ecfccb
            end
            column definition:
                background = #fee2e2
            end
        end
        header:
            row:
                column:
                    padding = 8px, 16px
                    content = "City"
                end
                column:
                    padding = 8px, 16px
                    content = "Mon"
                end
                column:
                    padding = 8px, 16px
                    content = "Tue"
                end
                column:
                    padding = 8px, 16px
                    content = "Wed"
                end
            end
        end
        main:
            row:
                column:
                    padding = 8px, 16px
                    heading = true
                    content = "Oslo"
                end
                column:
                    padding = 8px, 16px
                    content = "4"
                end
                column:
                    padding = 8px, 16px
                    content = "6"
                end
                column:
                    padding = 8px, 16px
                    content = "3"
                end
            end
            row:
                column:
                    padding = 8px, 16px
                    heading = true
                    content = "Rome"
                end
                column:
                    padding = 8px, 16px
                    content = "18"
                end
                column:
                    padding = 8px, 16px
                    content = "21"
                end
                column:
                    padding = 8px, 16px
                    content = "19"
                end
            end
        end
    end
end
