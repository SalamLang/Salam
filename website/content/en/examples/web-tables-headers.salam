page:
    title = "Opening hours"
    font = system, sans margin = 1.5rem
    table: 
        caption: content = "Opening hours of two shops" end
        row:
            column: padding = 8px, 16px border = 1px, solid, #cbd5e1 heading = true id = "shop" content = "Shop" end
            column: padding = 8px, 16px border = 1px, solid, #cbd5e1 heading = true id = "wk" content = "Weekdays" end
            column: padding = 8px, 16px border = 1px, solid, #cbd5e1 heading = true id = "we" content = "Weekend" end
        end
        row:
            column: padding = 8px, 16px border = 1px, solid, #cbd5e1 heading = true id = "bk" content = "Books" end
            column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "9-18" headers = "bk wk" end
            column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "10-14" headers = "bk we" end
        end
        row:
            column: padding = 8px, 16px border = 1px, solid, #cbd5e1 heading = true id = "cf" content = "Coffee" end
            column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "7-20" headers = "cf wk" end
            column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "8-22" headers = "cf we" end
        end
    end
end
