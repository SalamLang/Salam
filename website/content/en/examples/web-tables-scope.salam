page:
    title = "Row and column headers"
    font = system, sans margin = 1.5rem
    table: border collapse = collapse
        caption: content = "Quiz scores" end
        header:
            row:
                column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "Student" scope = col end
                column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "Quiz 1" scope = col abbr = "Q1" end
                column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "Quiz 2" scope = col abbr = "Q2" end
            end
        end
        main:
            row:
                column: padding = 8px, 16px border = 1px, solid, #cbd5e1 heading = true scope = row content = "Sara" end
                column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "17" end
                column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "19" end
            end
            row:
                column: padding = 8px, 16px border = 1px, solid, #cbd5e1 heading = true scope = row content = "Omid" end
                column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "14" end
                column: padding = 8px, 16px border = 1px, solid, #cbd5e1 content = "18" end
            end
        end
    end
end
