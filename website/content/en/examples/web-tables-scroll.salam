page:
    title = "Scrolling table"
    font = system, sans margin = 1rem
    box:
        max width = 26rem
        max height = 11rem
        overflow = auto
        border = 1px, solid, #cbd5e1
        table:
            border collapse = collapse
            width = 40rem
            header:
                row:
                    column: position = sticky top = 0 background = #1e293b color = white padding = 8 text align = left content = "Day" end
                    column: position = sticky top = 0 background = #1e293b color = white padding = 8 text align = left content = "Steps" end
                    column: position = sticky top = 0 background = #1e293b color = white padding = 8 text align = left content = "Distance" end
                    column: position = sticky top = 0 background = #1e293b color = white padding = 8 text align = left content = "Sleep" end
                end
            end
            main:
                row: column: padding = 8 text align = left content = "Monday" end column: padding = 8 text align = left content = "8200" end column: padding = 8 text align = left content = "6.1 km" end column: padding = 8 text align = left content = "7 h" end end
                row: column: padding = 8 text align = left content = "Tuesday" end column: padding = 8 text align = left content = "10400" end column: padding = 8 text align = left content = "7.8 km" end column: padding = 8 text align = left content = "6 h" end end
                row: column: padding = 8 text align = left content = "Wednesday" end column: padding = 8 text align = left content = "5900" end column: padding = 8 text align = left content = "4.4 km" end column: padding = 8 text align = left content = "8 h" end end
                row: column: padding = 8 text align = left content = "Thursday" end column: padding = 8 text align = left content = "9100" end column: padding = 8 text align = left content = "6.8 km" end column: padding = 8 text align = left content = "7 h" end end
                row: column: padding = 8 text align = left content = "Friday" end column: padding = 8 text align = left content = "12000" end column: padding = 8 text align = left content = "9.0 km" end column: padding = 8 text align = left content = "6 h" end end
            end
        end
    end
end
