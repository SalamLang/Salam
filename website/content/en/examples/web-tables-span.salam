page:
    title = "Timetable"
    font = system, sans margin = 1.5rem
    table: 
        caption: content = "Tuesday" end
        header:
            row:
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center content = "Time" end
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center content = "Room A" end
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center content = "Room B" end
            end
        end
        main:
            row:
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center heading = true content = "09:00" end
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center content = "Maths" rowspan = 2 background = #dbeafe end
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center content = "Art" end
            end
            row:
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center heading = true content = "10:00" end
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center content = "Music" end
            end
            row:
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center heading = true content = "12:00" end
                column: padding = 10px, 18px border = 1px, solid, #94a3b8 text align = center content = "Lunch for everyone" colspan = 2 background = #fef3c7 end
            end
        end
    end
end
