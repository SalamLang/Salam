page:
    title = "A styled table"
    font = system, sans margin = 1.5rem
    style: content = "tbody tr:nth-child(even) { background: #f1f5f9 }" end
    table:
        border collapse = collapse
        width = 100%
        max width = 28rem
        caption: content = "Team members" caption side = bottom color = #64748b padding = 8 end
        header:
            row:
                column: background = #0f766e color = white padding = 10 text align = left content = "Name" end
                column: background = #0f766e color = white padding = 10 text align = left content = "Role" end
                column: background = #0f766e color = white padding = 10 text align = left content = "Age" end
            end
        end
        main:
            row: hover background = #ccfbf1
                column: padding = 10 text align = left content = "Sara" end
                column: padding = 10 text align = left content = "Designer" end
                column: padding = 10 text align = left content = "31" end
            end
            row: hover background = #ccfbf1
                column: padding = 10 text align = left content = "Omid" end
                column: padding = 10 text align = left content = "Engineer" end
                column: padding = 10 text align = left content = "28" end
            end
            row: hover background = #ccfbf1
                column: padding = 10 text align = left content = "Lina" end
                column: padding = 10 text align = left content = "Writer" end
                column: padding = 10 text align = left content = "35" end
            end
        end
    end
end
