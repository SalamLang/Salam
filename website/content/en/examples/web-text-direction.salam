page:
    title = "Mixed directions"
    font = "system", "sans"
    margin = 1.5rem
    line height = 1.8
    paragraph:
        content = "Comment from "
        isolate:
            content = "محمد"
        end
        span:
            content = " and from "
        end
        isolate:
            content = "Sara"
        end
        span:
            content = "."
        end
    end
    paragraph:
        content = "Forced: "
        direction override:
            dir = "rtl"
            content = "abc 123"
        end
    end
    paragraph:
        ruby:
            content = "東京"
            ruby text:
                content = "Tōkyō"
            end
        end
    end
end
