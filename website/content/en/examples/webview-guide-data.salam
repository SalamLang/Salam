import webview
import encoding.json

struct Task:
    pub title: str = ""
    pub done: bool = false
end

func main:
    mut tasks := Vector {} as Vector<Task>
    tasks.push(Task { title = "Write the report", done = true })
    tasks.push(Task { title = "Send it to Sara" })
    mut win := webview.Create(true)
    win.SetTitle("Tasks")
    win.SetSize(400, 300, webview.HINT_NONE)
    win.Init("window.tasks = " + json.Marshal(tasks) + ";")
    win.SetHTML(`<ul id="list"></ul>
<script>
for (const t of window.tasks) {
  const li = document.createElement("li");
  li.textContent = (t.done ? "[x] " : "[ ] ") + t.title;
  document.getElementById("list").appendChild(li);
}
</script>`)
    win.Eval("document.title = window.tasks.length + ' tasks'")
    win.Run()
    win.Destroy()
end
