import wire

func report(label: str, c: wire.Container):
    msg := wire.Build(c)
    println label + ":", msg == "" ? "sound" : msg
    wire.Close(c)
end

func main:
    ok := wire.New()
    wire.Provide(ok, "Repo", "", 0, (_c: wire.Container): ret 1 end)
    report("fine", ok)

    missing := wire.New()
    wire.Provide(missing, "Service", "Repo", 0, (_c: wire.Container): ret 1 end)
    report("missing", missing)

    twice := wire.New()
    wire.Provide(twice, "Repo", "", 0, (_c: wire.Container): ret 1 end)
    wire.Provide(twice, "Repo", "", 0, (_c: wire.Container): ret 2 end)
    report("duplicate", twice)

    loop := wire.New()
    wire.Provide(loop, "A", "B", 0, (_c: wire.Container): ret 1 end)
    wire.Provide(loop, "B", "C", 0, (_c: wire.Container): ret 2 end)
    wire.Provide(loop, "C", "A", 0, (_c: wire.Container): ret 3 end)
    report("cycle", loop)

    empty := wire.New()
    mut n := 0
    println "get:", wire.Get(empty, "Nope", n), wire.Error(empty)
    wire.Close(empty)
end
