import wire

mut made := 0

struct Db:
    pub id: int = 0
end

struct Cache:
    pub db: Db = Db {}
end

func main:
    c := wire.New()
    wire.Provide(c, "Db", "", Db {}, (_c: wire.Container):
        made += 1
        ret Db { id = 7 }
    end)
    wire.Provide(c, "Cache", "Db", Cache {}, (cx: wire.Container):
        mut d := Db {}
        _ok := wire.Get(cx, "Db", d)
        ret Cache { db = d }
    end)
    wire.OnClose(c, "Db", Db {}, (d: Db): println "closing db", d.id end)
    wire.OnClose(c, "Cache", Cache {}, (k: Cache): println "closing cache over", k.db.id end)

    before := wire.Built(c)
    println "before", before.len()
    before.free()
    mut a := Cache {}
    mut b := Cache {}
    _x := wire.Get(c, "Cache", a)
    _y := wire.Get(c, "Cache", b)
    println "factory runs", made
    built := wire.Built(c)
    println "order", built.get(0), built.get(1)
    built.free()
    wire.Close(c)
    wire.Close(c)
    println "done"
end
