import wire

struct Config:
    pub env: str = ""
end

struct Store:
    pub kind: str = ""
end

func build(env: str): wire.Container:
    c := wire.New()
    wire.Value(c, "Config", Config { env = env })
    wire.Provide(c, "Mem", "", Store {}, (_c: wire.Container): ret Store { kind = "memory" } end)
    wire.Provide(c, "Disk", "Config", Store {}, (cx: wire.Container):
        mut cfg := Config {}
        _ok := wire.Get(cx, "Config", cfg)
        ret Store { kind = "disk for " + cfg.env }
    end)
    if env == "test":
        wire.Bind(c, "Store", "Mem")
    else:
        wire.Bind(c, "Store", "Disk")
    end
    ret c
end

func main:
    for_env := ["test", "prod"]
    each env in for_env:
        c := build(env)
        println env + ":", wire.Build(c) == "" ? "sound" : "broken"
        mut s := Store {}
        _ok := wire.Get(c, "Store", s)
        println "  store is", s.kind
        built := wire.Built(c)
        println "  built", built.len(), "of", wire.Count(c)
        built.free()
        wire.Close(c)
    end
end
