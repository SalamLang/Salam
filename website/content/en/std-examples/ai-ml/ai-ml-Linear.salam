import ai.ml
import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.Split(" "):
        data.Push(number.ToFloat())
    end
    ret matrix.FromArray(rows, cols, data)
end

func show(name: str, m &: matrix.Matrix):
    println name, matrix.ToRepr(matrix.Chop(m, 0.000001), 3)
end

func f3(number: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, number), 3)
end

func main:
    mut x := build(5, 2, "1 0 2 1 3 0 4 1 5 0")
    mut y := build(5, 1, "3 6 7 10 11")
    mut linear := ml.LinearReg {}
    println linear.Fit(x, y), linear.ok, linear.fit_intercept, f3(linear.intercept)
    show("coefficients", linear.coef)
    mut pred := linear.Predict(x)
    show("prediction", pred)
    println f3(linear.Score(x, y)), f3(ml.R2Score(y, pred))
    mut guess := build(5, 1, "3.5 5.5 7 10 12")
    println f3(ml.MSE(y, guess)), f3(ml.MAE(y, guess)), f3(ml.RMSE(y, guess))
    println f3(ml.MedianAbsoluteError(y, guess)), f3(ml.MAPE(y, guess)), f3(ml.ExplainedVariance(y, guess))

    mut ridge := ml.Ridge { alpha = 1.0 }
    println ridge.Fit(x, y), ridge.ok, ridge.alpha, ridge.fit_intercept, f3(ridge.intercept)
    show("ridge", ridge.coef)
    println ridge.Score(x, y) > 0.9, matrix.ShapeString(ridge.Predict(x))
    mut lasso := ml.Lasso { alpha = 0.1 }
    println lasso.Fit(x, y), lasso.ok, lasso.alpha, lasso.l1_ratio, lasso.fit_intercept, lasso.max_iter, lasso.tol > 0.0, lasso.n_iter > 0, lasso.intercept > 0.0
    show("lasso", lasso.coef)
    println lasso.Score(x, y) > 0.9, matrix.ShapeString(lasso.Predict(x))
    mut elastic := ml.NewElasticNet(0.1, 0.5)
    println elastic.Fit(x, y), elastic.l1_ratio

    mut hours := build(6, 1, "1 2 3 4 5 6")
    mut passed := build(6, 1, "0 0 0 1 1 1")
    mut logistic := ml.LogisticRegression { alpha = 0.01, max_iter = 2000 }
    println logistic.Fit(hours, passed), logistic.ok, logistic.n_classes, logistic.fit_intercept, logistic.n_iter > 0, logistic.tol > 0.0
    println matrix.ShapeString(logistic.coef), matrix.ShapeString(logistic.intercept)
    show("prediction", logistic.Predict(hours))
    mut proba := logistic.PredictProba(build(2, 1, "1 6"))
    println proba.at(0, 1) < 0.5, proba.at(1, 1) > 0.5, f3(logistic.Score(hours, passed))
    linear.Free()
    ridge.Free()
    lasso.Free()
    elastic.Free()
    logistic.Free()
end
