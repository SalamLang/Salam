import ai.ml
import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.Split(" "):
        data.Push(number.ToFloat())
    end
    ret matrix.FromArray(rows, cols, data)
end

func show(name: str, m &: matrix.Matrix):
    println name, matrix.ToRepr(matrix.Chop(m, 0.000001), 3)
end

func ints(v: Vector<int>): str:
    mut text := "["
    repeat v.Len() in i:
        if i > 0:
            text += " "
        end
        text += "" + v.Get(i)
    end
    ret text + "]"
end

func main:
    mut data := build(4, 2, "1 10 2 20 3 30 4 40")
    mut standard := ml.StandardScaler {}
    mut scaled := standard.FitTransform(data)
    show("standard", scaled)
    show("mean", standard.mean)
    println standard.ok, standard.with_mean, standard.with_std, matrix.ShapeString(standard.std)
    show("back", standard.InverseTransform(scaled))
    mut minmax := ml.MinMaxScaler { lo = 0.0, hi = 1.0 }
    println minmax.Fit(data)
    show("minmax", minmax.Transform(data))
    show("back", minmax.InverseTransform(minmax.FitTransform(data)))
    println minmax.ok, matrix.ShapeString(minmax.data_min), matrix.ShapeString(minmax.data_range)
    println standard.Fit(data), matrix.ShapeString(standard.Transform(data))

    mut labels := Vector {} as Vector<str>
    each label in ["cat", "dog", "cat", "fish"]:
        labels.Push(label)
    end
    mut encoder := ml.LabelEncoder {}
    mut codes := encoder.FitTransform(labels)
    show("label", codes)
    println encoder.ok, encoder.classes.Len(), encoder.IndexOf("dog"), encoder.InverseTransform(codes).Get(3), encoder.Fit(labels), matrix.ShapeString(encoder.Transform(labels))
    mut onehot := ml.OneHotEncoder {}
    mut hot := onehot.FitTransform(codes)
    show("onehot", hot)
    show("back", onehot.InverseTransform(hot))
    println onehot.ok, onehot.n_classes, onehot.Fit(codes), matrix.ShapeString(onehot.Transform(codes))
    println ints(ml.LabelsToInts(codes)), ml.CountClasses(codes)

    mut missing := build(3, 2, "1 4 nan 6 3 nan")
    mut imputer := ml.SimpleImputer { strategy = ml.IMPUTE_MEAN }
    show("mean", imputer.FitTransform(missing))
    mut imputer2 := ml.SimpleImputer { strategy = ml.IMPUTE_CONSTANT, fill = -1.0 }
    println imputer2.Fit(missing), imputer2.ok, matrix.ShapeString(imputer2.stats)
    show("constant", imputer2.Transform(missing))
    println ml.IMPUTE_MEDIAN
    mut poly := ml.PolynomialFeatures { degree = 2, include_bias = true }
    show("polynomial", poly.Transform(build(1, 2, "2 3")))

    mut linear := build(4, 2, "1 2 2 4 3 6 4 8")
    mut pca := ml.PCA { n_components = 1 }
    println pca.Fit(linear), pca.ok, matrix.ShapeString(pca.components), matrix.ShapeString(pca.mean)
    show("variance", pca.explained_ratio)
    println matrix.ShapeString(pca.explained_variance), matrix.ShapeString(pca.Transform(linear)), matrix.ShapeString(pca.FitTransform(linear))
    show("back", pca.InverseTransform(pca.Transform(linear)))
    mut svd := ml.TruncatedSVD { n_components = 1 }
    println svd.Fit(linear), svd.ok, matrix.ShapeString(svd.components), matrix.ShapeString(svd.singular_values), matrix.ShapeString(svd.explained_variance), matrix.ShapeString(svd.explained_ratio)
    println matrix.ShapeString(svd.Transform(linear)), matrix.ShapeString(svd.FitTransform(linear))

    mut x := build(6, 1, "1 2 3 4 5 6")
    mut y := build(6, 1, "0 0 0 1 1 1")
    mut split := ml.TrainTestSplit(x, y, 0.5, 7)
    println matrix.ShapeString(split.x_train), matrix.ShapeString(split.x_test), matrix.ShapeString(split.y_train), matrix.ShapeString(split.y_test)
    mut folds := ml.KFold(6, 3, false, 0)
    println folds.count(), ints(folds.test.Get(0)), ints(folds.train.Get(0))
    mut stratified := ml.StratifiedKFold(y, 3, 1)
    println stratified.count(), stratified.test.Get(0).Len()
    println ml.ML_TOL > 0.0
    standard.Free()
    minmax.Free()
    encoder.Free()
    imputer.Free()
    pca.Free()
    svd.Free()
end
