import ai.ml
import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.ToFloat())
    end
    ret matrix.FromArray(rows, cols, data)
end

func show(name: str, m &: matrix.Matrix):
    println name, matrix.ToRepr(matrix.Chop(m, 0.000001), 3)
end

func f3(number: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, number), 3)
end

func ints(v: Vector<int>): str:
    mut text := "["
    repeat v.Len() in i:
        if i > 0:
            text += " "
        end
        text += "" + v.get(i)
    end
    ret text + "]"
end

func main:
    mut x := build(8, 2, "1 1 1 2 2 1 2 2 6 6 6 7 7 6 7 7")
    mut y := build(8, 1, "0 0 0 0 1 1 1 1")
    mut test := build(2, 2, "1.5 1.5 6.5 6.5")

    mut tree := ml.DecisionTree { criterion = ml.TREE_GINI, max_depth = 3 }
    println tree.fit(x, y), tree.ok, tree.n_classes, tree.is_regression(), tree.node_count(), tree.apply_row(test, 0) >= 0
    println tree.min_samples_split, tree.min_samples_leaf, tree.max_features, tree.seed, tree.n_classes_hint, tree.feature.Len(), tree.threshold.Len(), tree.left.Len(), tree.right.Len(), matrix.ShapeString(tree.value)
    show("tree", tree.predict(test))
    println matrix.ShapeString(tree.predict_proba(test)), f3(tree.score(x, y))
    mut regression := ml.DecisionTree { criterion = ml.TREE_MSE }
    println regression.fit(x, build(8, 1, "1 1 1 1 5 5 5 5")), regression.is_regression(), ml.TREE_ENTROPY

    mut forest := ml.RandomForest { n_trees = 20, max_depth = 4, seed = 3 }
    println forest.fit(x, y), forest.ok, forest.n_classes, forest.trees.Len(), forest.is_regression(), forest.criterion, forest.min_samples_leaf, forest.max_features, forest.bootstrap, forest.workers
    show("forest", forest.predict(test))
    println matrix.ShapeString(forest.predict_proba(test)), f3(forest.score(x, y))
    forest.free_trees()

    mut ada := ml.AdaBoost { n_estimators = 10 }
    println ada.fit(x, y), ada.ok, ada.n_classes, ada.trees.Len() > 0, ada.alphas.Len() > 0, ada.max_depth, ada.learning_rate, ada.seed
    show("adaboost", ada.predict(test))
    println f3(ada.score(x, y))
    ada.free_all()

    mut boost := ml.GradientBoosting { n_estimators = 20, learning_rate = 0.3, max_depth = 2 }
    println boost.fit(x, y), boost.ok, boost.n_classes, boost.trees.Len(), boost.min_samples_leaf, boost.regression, matrix.ShapeString(boost.base)
    show("gradient boosting", boost.predict(test))
    println matrix.ShapeString(boost.decision(test)), matrix.ShapeString(boost.predict_proba(test)), f3(boost.score(x, y))
    boost.free_all()

    mut hist := ml.HistGradientBoosting { n_estimators = 20, min_samples_leaf = 1, max_bins = 16 }
    println hist.fit(x, y), hist.ok, hist.n_classes, hist.trees.Len() > 0, hist.max_depth, hist.l2, hist.learning_rate, hist.regression, hist.edges.Len() > 0, hist.edges_start.Len(), hist.base.Len()
    show("histogram", hist.predict(test))
    println matrix.ShapeString(hist.decision(test)), matrix.ShapeString(hist.predict_proba(test)), f3(hist.score(x, y))
    mut first := hist.trees.get(0)
    println first.feature.Len() > 0, first.threshold.Len() > 0, first.left.Len() > 0, first.right.Len() > 0, first.value.Len() > 0
    hist.free_all()

    mut kd := ml.NewKDTree(x, 2)
    mut dists := Vector {} as Vector<f64>
    println kd.ok, kd.leaf_size, kd.node_count() > 0, ints(kd.query(test, 1, 2, dists)), f3(dists.get(0))
    println matrix.ShapeString(kd.x), kd.idx.Len(), kd.node_lo.Len() > 0, kd.node_hi.Len() > 0, kd.node_dim.Len() > 0, kd.node_split.Len() > 0, kd.node_left.Len() > 0, kd.node_right.Len() > 0
    mut empty := ml.KDTree {}
    println empty.build(x), empty.node_count() > 0
    kd.free()
    empty.free()
    tree.free()
    regression.free()
end
