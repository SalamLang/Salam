import archive
import compress

func main:
    text := compress.BufFromStr("bzip2 file helpers: one file in, one file out.\n")
    println archive.WriteBinaryFileBuf("note.txt", text)
    println archive.Bzip2CompressFile("note.txt", "note.txt.bz2")
    println archive.Bzip2DecompressFile("note.txt.bz2", "back.txt")
    mut ok := false
    back := archive.ReadBinaryFile("back.txt", ok)
    println ok, compress.BufEquals(back, text)
    println archive.Bzip2DecompressFile("note.txt", "bad.txt")
    println archive.Bzip2CompressFile("missing.txt", "missing.txt.bz2")
end
