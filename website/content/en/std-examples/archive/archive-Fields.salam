import archive
import compress

func main:
    text := "fields of an entry, fields of an entry"
    b := compress.BufFromStr(text)

    mut zin := Vector {} as Vector<archive.ZipFileInput>
    zin.push(archive.ZipFileInput { name = "docs/", data_ptr = null, data_len = 0, method = 0 })
    zin.push(archive.ZipFileInput { name = "docs/a.txt", data_ptr = b.data, data_len = b.len, method = 8 })
    z := archive.ZipCreate(zin)
    mut zentries := archive.ZipList(z.data, z.len)
    each e in zentries:
        println e.name, e.size, e.compressed_size <= e.size, e.is_dir, e.method, e.crc32 == compress.CRC32Buf(b) or e.is_dir, e.mtime >= 0
    end
    archive.FreeEntries(zentries)

    mut tin := Vector {} as Vector<archive.TarFileInput>
    tin.push(archive.TarFileInput { name = "notes/", data_ptr = null, data_len = 0, is_dir = true })
    tin.push(archive.TarFileInput { name = "notes/a.txt", data_ptr = b.data, data_len = b.len, is_dir = false })
    t := archive.TarCreate(tin)
    mut tentries := archive.TarList(t.data, t.len)
    each e in tentries:
        println e.name, e.size, e.is_dir
    end
    archive.FreeEntries(tentries)
end
