import archive
import compress
import filepath
import os

func main:
    dir := filepath.Join(os.TempDir(), "salam_filecap_example")
    os.MkdirAll(dir)
    src := filepath.Join(dir, "plain.bin")
    packed := filepath.Join(dir, "plain.xz")
    back := filepath.Join(dir, "back.bin")
    mut raw := compress.NewByteBuf()
    repeat 20000 in i:
        compress.BufPush(raw, 97 + (i % 5))
    end
    _ := archive.WriteBinaryFileBuf(src, raw)
    _ := archive.XzCompressFile(src, packed)
    println archive.ArchiveStatusText(archive.XzDecompressFileCap(packed, back, 1000 as i64))
    println archive.ArchiveStatusText(archive.XzDecompressFileCap(packed, back, 0 as i64))
    _ := archive.Bzip2CompressFile(src, packed)
    println archive.ArchiveStatusText(archive.Bzip2DecompressFileCap(packed, back, 1000 as i64))
    println archive.ArchiveStatusText(archive.Bzip2DecompressFileCap(packed, back, 0 as i64))
    println archive.ArchiveStatusText(archive.LzmaDecompressFileCap(src, back, 0 as i64))
    os.RemoveAll(dir)
end
