package main

import archive
import compress
import filepath
import os

func main:
    mut files := Vector {} as Vector<archive.FileInput>
    files.push(archive.MakeFileInput("docs/", null, 0, true))
    files.push(archive.MakeFileInput("docs/a.txt", "hello hello hello hello" as void*, 23, false))
    files.push(archive.MakeFileInput("b.txt", "bee" as void*, 3, false))

    mut status := 0
    mut built := archive.CreateBuf(archive.FormatTarGz, files, status)
    println status, archive.FormatName(archive.Detect(built.data, built.len))

    mut arc := archive.Open(built.data, built.len, "")
    println archive.FormatName(arc.format), arc.status
    mut entries := archive.List(arc)
    each e in entries:
        println e.name, e.size, e.is_dir
    end
    archive.FreeEntries(entries)

    mut data := archive.Read(arc, "docs/a.txt")
    println arc.status, compress.BufToStrUnsafe(data)
    compress.BufFree(data)
    mut missing := archive.Read(arc, "nope.txt")
    println arc.status, archive.ArchiveStatusText(arc.status)
    compress.BufFree(missing)

    dest := filepath.Join(os.TempDir(), "salam-open-demo")
    n := archive.ExtractAll(arc, dest)
    println n, archive.ArchiveStatusText(arc.status), os.Exists(filepath.Join(dest, "docs/a.txt"))
    os.RemoveAll(dest)

    mut tight := archive.DefaultLimits()
    tight.max_entries = 2
    mut small := archive.OpenWith(built.data, built.len, "", tight)
    println archive.ExtractAll(small, dest), archive.ArchiveStatusText(small.status)
    archive.Close(small)
    archive.Close(arc)

    println archive.DetectName("backup.tgz") == archive.FormatTarGz, archive.DetectName("notes.txt") == archive.FormatUnknown
    compress.BufFree(built)
    files.free()
end
