import archive
import compress

func main:
    a := compress.BufFromStr("first file\n")
    b := compress.BufFromStr("second file, a little longer\n")
    mut files := Vector {} as Vector<archive.RarFileInput>
    files.Push(archive.MakeRarFileInput("docs/", null, 0, true))
    files.Push(archive.MakeRarFileInput("docs/a.txt", a.data, a.len, false))
    mut second := archive.MakeRarFileInput("docs/b.txt", b.data, b.len, false)
    second.mtime = 1700000000 as i64
    files.Push(second)
    r := archive.RarCreate(files)
    println archive.IsRar(r.data, r.len), archive.RarCreateFile(files, "made.rar")

    mut entries := archive.RarList(r.data, r.len)
    each e in entries:
        println e.name, e.size, e.is_dir, e.mtime
    end
    archive.FreeEntries(entries)

    mut status := 0
    got := archive.RarExtract(r.data, r.len, "docs/b.txt", 0, status)
    println status == archive.RAR_OK, compress.BufToStrUnsafe(got) == "second file, a little longer\n"
    _ := archive.RarExtract(r.data, r.len, "docs/none.txt", 0, status)
    println status == archive.RAR_NOT_FOUND, archive.RarStatusText(status)

    mut ok := false
    small := archive.RarExtractByNameMax(r.data, r.len, "docs/b.txt", 5, ok)
    println ok, small.len
    println archive.RarStatusText(archive.RAR_TOO_BIG)

    n := archive.RarExtractAllStatus(r.data, r.len, "rar-out", status)
    println n, archive.RarStatusText(status)

    bad := compress.BufClone(r)
    p := bad.data as u8*
    p[bad.len - 15] = ((p[bad.len - 15] as int) ^ 1) as u8
    _ := archive.RarExtract(bad.data, bad.len, "docs/b.txt", 0, status)
    println status == archive.RAR_BAD_CRC, archive.RarStatusText(status)
end
