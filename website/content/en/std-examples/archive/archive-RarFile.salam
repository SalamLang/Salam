import archive
import os

func main:
    body := "read from a RAR on disk, entry by entry\n"
    mut files := Vector {} as Vector<archive.RarFileInput>
    files.Push(archive.MakeRarFileInput("notes/a.txt", body as void*, body.Len(), false))
    archive.RarCreateFile(files, "made.rar")
    files.Free()

    mut rf := archive.RarFileOpen("made.rar")
    println rf.status == archive.RAR_OK, rf.streaming
    mut entries := archive.RarFileEntries(rf)
    each e in entries:
        println e.name, e.size
    end
    archive.FreeEntries(entries)

    println archive.RarFileExtractTo(rf, "notes/a.txt", "a.out", 0 as i64, 0 as i64) == archive.RAR_OK
    println archive.RarFileExtractTo(rf, "notes/a.txt", "a.out", 5 as i64, 0 as i64) == archive.RAR_TOO_BIG
    archive.RarFileClose(rf)
    os.Remove("made.rar")
    os.Remove("a.out")
end
