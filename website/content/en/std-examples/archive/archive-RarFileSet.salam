func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func save(dir: str, name: str, hex: str): str:
    mut b := compress.NewByteBuf()
    bp := hex as u8*
    mut hi := -1
    repeat hex.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    path := filepath.Join(dir, name)
    _ := archive.WriteBinaryFileBuf(path, b)
    compress.BufFree(b)
    ret path
end

func main:
    dir := filepath.Join(os.TempDir(), "salam_rarfile_set")
    os.MkdirAll(dir)
    first := save(dir, "set.part1.rar", PART1)
    second := save(dir, "set.part2.rar", PART2)
    locked := save(dir, "locked.rar", LOCKED)

    mut rf := archive.RarFileOpenVolumes(first, "")
    println "volumes", rf.vols.paths.Len(), archive.RarStatusText(rf.status)
    out := filepath.Join(dir, "out")
    println archive.RarStatusText(archive.RarFileExtractAll(rf, out, 0 as i64, 0 as i64))
    archive.RarFileClose(rf)

    mut bad := archive.RarFileOpenWith(locked, "wrong")
    println "wrong password", archive.RarStatusText(bad.status)
    archive.RarFileClose(bad)
    mut good := archive.RarFileOpenWith(locked, "secret")
    mut es := archive.RarFileEntries(good)
    println "right password", es.Len(), es.Get(0).name, es.Get(0).size
    archive.FreeEntries(es)
    archive.RarFileClose(good)

    mem.Free(out as void*)
    mem.Free(first as void*)
    mem.Free(second as void*)
    mem.Free(locked as void*)
    os.RemoveAll(dir)
    mem.Free(dir as void*)
end
