import archive
import compress

const SAMPLE := """
526172211a07010038d1db9021040000010fe945634161dc2d7b3e8b87f362874d32048313f00358e483efb2886b026e
590dc3a9e23be3b7cfa25ea1dd6a6c4c4af8702cb2d51eb2f7798221661b321c792f762b84ffbf221b7100d324e8f848
ca96b61074ef27c65ba5a760024e3e27ccd59be9d8047bce7da160956a1dd1ca59d5970613a92c4582b076eb3398a1b7
8ef8151f33cf3665dea91210eaede8f1c08f503c488358eb375bf44e0a7a90b81067d6a6637ae589c00f19b387d3d769
f8cfa327f9b218211f11fe63a7a1783e45656fcc9573869eaf359485c0e2d4d5066ddc9981c7b13390c6d78d0ea24a04
386db10eb6d52567002ad55ebee7f1a172080c6a7bd1c72ac29e74d0480d38934012ee49a5fcd5111ad5899223384b67
b8491eed31431d7295083a332114430d96e4004c3426c450dbd1985644df90632ebb89c94cb9f9000fe8b54e0335aa44
fe401e45aad3727aee1392db44b09094b58754bc5ae4fd2186aeb6790bbf2dc3a4225dd37203f3eeecf02fcfb2f150a1
4293fbab1e38425c7bdd1909e3b24e6882fb38344a28184e8d993d93616aeb3eb57e60b5681280a7d138329a4cda
"""

func digit(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func from_hex(text: str): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    bytes := text as u8*
    mut high := -1
    repeat text.Len() in i:
        v := digit(bytes[i] as int)
        if v < 0:
            continue
        end
        if high < 0:
            high = v
        else:
            compress.BufPush(out, high * 16 + v)
            high = -1
        end
    end
    ret out
end

func main:
    rar := from_hex(SAMPLE)
    mut locked := archive.RarOpen(rar.data, rar.len, "")
    mut names := archive.RarEntries(locked)
    println names.Len(), archive.RarStatusText(locked.status)
    archive.FreeEntries(names)

    mut wrong := archive.RarOpen(rar.data, rar.len, "guess")
    names = archive.RarEntries(wrong)
    println names.Len(), wrong.status == archive.RAR_BAD_PASSWORD
    archive.FreeEntries(names)

    mut arc := archive.RarOpen(rar.data, rar.len, "secret")
    names = archive.RarEntries(arc)
    each e in names:
        data := archive.RarRead(arc, e.name, 0)
        println e.name, e.size, data.len, archive.RarStatusText(arc.status)
    end
    archive.FreeEntries(names)
    println archive.RarReadAll(arc, "unlocked"), archive.RarStatusText(arc.status)
end
