func digit(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func from_hex(text: str): compress.ByteBuf:
    mut out := compress.NewByteBuf()
    bytes := text as u8*
    mut high := -1
    repeat text.len() in i:
        v := digit(bytes[i] as int)
        if v < 0:
            continue
        end
        if high < 0:
            high = v
        else:
            compress.BufPush(out, high * 16 + v)
            high = -1
        end
    end
    ret out
end

func main:
    mut volumes := Vector {} as Vector<compress.ByteBuf>
    volumes.push(from_hex(VOL1))
    volumes.push(from_hex(VOL2))
    volumes.push(from_hex(VOL3))

    mut arc := archive.RarOpenVolumes(volumes, "")
    mut names := archive.RarEntries(arc)
    each e in names:
        data := archive.RarRead(arc, e.name, 0)
        println e.name, e.size, data.len, archive.RarStatusText(arc.status)
    end
    archive.FreeEntries(names)
    archive.RarClose(arc)

    mut partial := Vector {} as Vector<compress.ByteBuf>
    partial.push(volumes.get(0))
    partial.push(volumes.get(1))
    mut broken := archive.RarOpenVolumes(partial, "")
    gone := archive.RarRead(broken, "v.txt", 0)
    println gone.len, broken.status == archive.RAR_MULTIVOLUME
    archive.RarClose(broken)

    archive.WriteBinaryFileBuf("set.part01.rar", volumes.get(0))
    archive.WriteBinaryFileBuf("set.part02.rar", volumes.get(1))
    archive.WriteBinaryFileBuf("set.part03.rar", volumes.get(2))
    mut ok := false
    mut found := archive.RarReadVolumes("set.part01.rar", ok)
    println ok, found.len()
    archive.RarFreeVolumes(found)
end
