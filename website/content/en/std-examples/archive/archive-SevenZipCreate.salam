import archive
import compress

func main:
    a := compress.BufFromStr("first file\n")
    b := compress.BufFromStr("second file, a little longer\n")
    mut files := Vector {} as Vector<archive.SevenZipFileInput>
    files.push(archive.MakeSevenZipFileInput("docs/", null, 0, true))
    files.push(archive.MakeSevenZipFileInput("docs/a.txt", a.data, a.len, false))
    mut second := archive.MakeSevenZipFileInput("docs/b.txt", b.data, b.len, false)
    second.mtime = 1700000000 as i64
    second.mode = 420
    files.push(second)
    mut link := archive.MakeSevenZipFileInput("docs/latest", null, 0, false)
    link.link = "b.txt"
    files.push(link)
    packed := archive.SevenZipCreate(files)
    println archive.IsSevenZip(packed.data, packed.len), archive.SevenZipCreateFile(files, "made.7z")

    mut entries := archive.SevenZipList(packed.data, packed.len)
    each e in entries:
        println e.name, e.size, e.is_dir, e.kind, e.mtime
    end
    archive.FreeEntries(entries)

    mut ok := false
    got := archive.SevenZipExtractByName(packed.data, packed.len, "docs/b.txt", ok)
    println ok, compress.BufToStrUnsafe(got) == "second file, a little longer\n"
end
