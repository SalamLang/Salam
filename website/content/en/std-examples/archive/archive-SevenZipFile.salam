import archive
import os

func main:
    body := "a large file would be unpacked straight to disk\n"
    mut files := Vector {} as Vector<archive.SevenZipFileInput>
    files.push(archive.MakeSevenZipFileInput("data/log.txt", body as void*, body.Len(), false))
    archive.SevenZipCreateFile(files, "made.7z")
    files.free()

    mut sf := archive.SevenZipOpenFile("made.7z", "")
    mut entries := archive.SevenZipFileEntries(sf)
    each e in entries:
        println e.name, e.size
    end
    archive.FreeEntries(entries)

    println archive.SevenZipFileExtractTo(sf, "data/log.txt", "log.out", 0 as i64, 0 as i64) == archive.SEVENZIP_OK
    println archive.SevenZipFileExtractTo(sf, "data/log.txt", "log.out", 10 as i64, 0 as i64) == archive.SEVENZIP_TOO_BIG
    archive.SevenZipFileClose(sf)
    os.Remove("made.7z")
    os.Remove("log.out")
end
