import archive
import compress

const PART1 := """
377abcaf271c000457983ded16000000000000004a00000000000000429e4011766f6c756d65206f6e650a766f6c756d6520
74776f0a0104060001091600070b
"""

const PART2 := """
01000101000c1600080a014e6ded24000005011113006e006f00740065002e0074007800740000001900140a0100d9199ec4
1c70dd01150601002080a4810000
"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func main:
    mut volumes := Vector {} as Vector<compress.ByteBuf>
    volumes.Push(unhex(PART1))
    volumes.Push(unhex(PART2))
    mut arc := archive.SevenZipOpenVolumes(volumes, "")
    names := archive.SevenZipEntries(arc)
    println "entries:", names.Len(), arc.status
    data := archive.SevenZipRead(arc, "note.txt", 0)
    print compress.BufToStrUnsafe(data)
    archive.SevenZipClose(arc)
    archive.SevenZipFreeVolumes(volumes)
end
