import archive
import compress
import filepath
import os

func main:
    mut files := Vector {} as Vector<archive.TarFileInput>
    hello := compress.BufFromStr("hello\n")
    files.push(archive.MakeTarFileInput("hello.txt", hello.data, hello.len, false))
    files.push(archive.MakeTarFileInput("notes", null, 0, true))
    notes := compress.BufFromStr("note\n".repeat(200))
    files.push(archive.MakeTarFileInput("notes/list.txt", notes.data, notes.len, false))

    dir := filepath.Join(os.TempDir(), "salam_tarbz2_example")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    path := filepath.Join(dir, "all.tar.bz2")
    println "file:", archive.TarBz2CreateFile(files, path)
    println "level 1:", archive.TarBz2CreateFileLevel(files, filepath.Join(dir, "fast.tar.bz2"), 1)

    mut ok := false
    packed := archive.ReadBinaryFile(path, ok)
    plain := archive.TarCreate(files)
    one := compress.Bzip2CompressLevel(plain.data, plain.len, 9)
    println "one bzip2 stream:", compress.BufEquals(packed, one)

    dest := filepath.Join(dir, "out")
    println "extract:", archive.TarBz2FileExtractAll(path, dest, 0 as i64)
    println os.Exists(filepath.Join(dest, "notes/list.txt"))
    os.RemoveAll(dir)
end
