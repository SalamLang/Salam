import archive
import compress
import os

func main:
    body := "streamed straight from the archive\n"
    mut files := Vector {} as Vector<archive.TarFileInput>
    files.push(archive.MakeTarFileInput("logs/a.txt", body as void*, body.len(), false))
    files.push(archive.MakeTarFileInput("logs/b.txt", body as void*, 10, false))
    mut made := archive.TarCreate(files)
    files.free()
    archive.WriteBinaryFileBuf("made.tar", made)
    compress.BufFree(made)

    mut tf := archive.TarFileOpen("made.tar")
    mut e := archive.Entry {}
    until archive.TarFileNext(tf, e):
        println e.name, e.size
        if e.name == "logs/a.txt":
            println archive.TarFileExtractTo(tf, e, "a.out", 0 as i64) == archive.TAR_OK
            println archive.TarFileExtractTo(tf, e, "a.out", 5 as i64) == archive.TAR_TOO_BIG
        end
        archive.FreeEntry(e)
    end
    archive.TarFileClose(tf)

    println archive.TarFileExtractAll("made.tar", "out", 0 as i64) == archive.TAR_OK
    os.RemoveAll("out")
    os.Remove("made.tar")
    os.Remove("a.out")
end
