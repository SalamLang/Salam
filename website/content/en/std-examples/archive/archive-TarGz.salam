import archive
import compress

func main:
    text := "log line\n".repeat(500)
    d := compress.BufFromStr(text)
    mut files := Vector {} as Vector<archive.TarFileInput>
    files.push(archive.MakeTarFileInput("app.log", d.data, d.len, false))
    files.push(archive.MakeTarFileInput("empty", null, 0, true))
    z := archive.TarGzCreate(files)
    println z.len < d.len
    mut ok := false
    mut es := archive.TarGzList(z.data, z.len, ok)
    println ok, es.Len()
    archive.FreeEntries(es)
    one := archive.TarGzExtractByName(z.data, z.len, "app.log", ok)
    println ok, one.len == d.len
    small := archive.TarGzListMax(z.data, z.len, 1000, ok)
    println ok, small.Len()
    _ := archive.TarGzExtractByNameMax(z.data, z.len, "app.log", 100000, ok)
    println ok
    println archive.TarGzExtractAllMax(z.data, z.len, "tooSmall", 1000)
    println archive.TarGzExtractAll(z.data, z.len, "unpacked")
    println archive.TarGzCreateFile(files, "logs.tar.gz")
end
