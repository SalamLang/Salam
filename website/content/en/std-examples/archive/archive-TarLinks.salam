import archive
import compress

func main:
    d := compress.BufFromStr("hello\n")
    mut files := Vector {} as Vector<archive.TarFileInput>
    mut a := archive.MakeTarFileInput("a.txt", d.data, d.len, false)
    a.mtime = 1700000000 as i64
    a.mode = 0o640
    files.push(a)
    files.push(archive.MakeTarSymlink("current", "a.txt"))
    files.push(archive.MakeTarHardlink("copy.txt", "a.txt"))
    deep := "reports/".repeat(20) + "summary.txt"
    files.push(archive.MakeTarFileInput(deep, d.data, d.len, false))
    t := archive.TarCreate(files)
    mut es := archive.TarList(t.data, t.len)
    each e in es:
        println e.kind, e.name.len(), e.link, e.size, e.mtime, e.mode
    end
    archive.FreeEntries(es)
    println archive.TarExtractAll(t.data, t.len, "linked")
    mut bad := Vector {} as Vector<archive.TarFileInput>
    bad.push(archive.MakeTarFileInput("fine.txt", d.data, d.len, false))
    bad.push(archive.MakeTarSymlink("escape", "../outside"))
    b := archive.TarCreate(bad)
    println archive.TarExtractAll(b.data, b.len, "guarded")
end
