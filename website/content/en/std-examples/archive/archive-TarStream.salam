import archive
import os

func main:
    body := "streamed straight from the compressed file\n"
    mut files := Vector {} as Vector<archive.TarFileInput>
    files.Push(archive.MakeTarFileInput("notes/a.txt", body as void*, body.Len(), false))
    files.Push(archive.MakeTarFileInput("notes/b.txt", body as void*, 10, false))
    println archive.TarGzCreateFile(files, "pack.tar.gz")
    files.Free()

    mut st := 0
    mut entries := archive.TarCompressedFileEntries("pack.tar.gz", archive.FormatTarGz, st)
    each e in entries:
        println e.name, e.size
    end
    println st
    archive.FreeEntries(entries)

    println archive.TarGzFileExtractAll("pack.tar.gz", "unpacked", 0 as i64)
    println os.FileSize("unpacked/notes/a.txt"), os.FileSize("unpacked/notes/b.txt")
    println archive.TarCompressedFileExtractAll("pack.tar.gz", archive.FormatTarGz, "capped", 20 as i64)
    println os.Exists("capped/notes/a.txt"), os.Exists("capped/notes/b.txt")
    os.RemoveAll("unpacked")
    os.RemoveAll("capped")
    os.Remove("pack.tar.gz")
end
