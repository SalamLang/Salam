import archive
import compress
import filepath
import os

func main:
    mut files := Vector {} as Vector<archive.TarFileInput>
    hello := compress.BufFromStr("hello\n")
    files.push(archive.MakeTarFileInput("hello.txt", hello.data, hello.len, false))
    files.push(archive.MakeTarFileInput("notes", null, 0, true))
    notes := compress.BufFromStr("note\n".repeat(200))
    files.push(archive.MakeTarFileInput("notes/list.txt", notes.data, notes.len, false))

    tz := archive.TarZstdCreate(files)
    println "tar.zst:", tz.len, "bytes,", compress.IsZstdBuf(tz)
    mut ok := false
    mut entries := archive.TarZstdList(tz.data, tz.len, ok)
    println "entries:", ok, entries.len()
    each e in entries:
        println e.name, e.size
    end
    archive.FreeEntries(entries)
    one := archive.TarZstdExtractByName(tz.data, tz.len, "hello.txt", ok)
    println ok, compress.BufToStrUnsafe(one)
    small := archive.TarZstdListMax(tz.data, tz.len, 1000, ok)
    println "capped at 1000 bytes:", ok, small.len()

    dir := filepath.Join(os.TempDir(), "salam_tarzstd_example")
    os.RemoveAll(dir)
    println "extract:", archive.TarZstdExtractAll(tz.data, tz.len, dir)
    println os.Exists(filepath.Join(dir, "notes/list.txt"))
    path := filepath.Join(dir, "all.tar.zst")
    println "file:", archive.TarZstdCreateFile(files, path)
    os.RemoveAll(dir)
end
