import archive
import compress
import filepath
import os

const XZ := """
fd377a585a000004e6d6b44604c05fcf022101160000000000000000bb0ccf6ce0014e00575d0029984986240afb8a34e4
81db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eba071037cdd425338444ede
4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602aacf40a000005b35fff6fd65c4e300017bcf020000005e9efc
63b1c467fb020000000004595a
"""

const LZMA := """
5d00008000ffffffffffffffff0029984986240afb8a34e481db780958f3d0144436dd3bb4ca45234051fa042e5be57640
2f66b72801fb0f3b421e32e3eba071037cdd425338444ede4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602ad
8d68e0bcfed44dc0
"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func main:
    dir := filepath.Join(os.TempDir(), "salam_xz_example")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    xz_path := filepath.Join(dir, "notes.txt.xz")
    lzma_path := filepath.Join(dir, "notes.txt.lzma")
    out_path := filepath.Join(dir, "notes.txt")
    archive.WriteBinaryFileBuf(xz_path, unhex(XZ))
    archive.WriteBinaryFileBuf(lzma_path, unhex(LZMA))

    println "xz:", archive.XzDecompressFile(xz_path, out_path)
    mut ok := false
    text := archive.ReadBinaryFile(out_path, ok)
    println ok, text.len, "bytes"
    println "lzma:", archive.LzmaDecompressFile(lzma_path, out_path)
    println "wrong format:", archive.XzDecompressFile(lzma_path, out_path)
    println "missing:", archive.XzDecompressFile(filepath.Join(dir, "none.xz"), out_path)

    plain := filepath.Join(dir, "plain.txt")
    archive.WriteBinaryFileBuf(plain, text)
    packed := filepath.Join(dir, "plain.txt.xz")
    println "pack xz:", archive.XzCompressFile(plain, packed), archive.XzDecompressFile(packed, out_path)
    println "pack lzma:", archive.LzmaCompressFile(plain, lzma_path), archive.LzmaDecompressFile(lzma_path, out_path)
    println "pack missing:", archive.XzCompressFile(filepath.Join(dir, "none.txt"), packed)
    os.RemoveAll(dir)
end
