import archive
import compress

func hex_val(c: int): int:
    if c >= 97: ret c - 87 end
    ret c - 48
end

func unhex(h: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := h as u8*
    mut i := 0
    until i + 1 < h.Len():
        compress.BufPush(b, hex_val(bp[i] as int) * 16 + hex_val(bp[i + 1] as int))
        i += 2
    end
    ret b
end

func main:
    z := unhex("")
    mut entries := archive.ZipList(z.data, z.len)
    each e in entries:
        println e.name, e.size, e.compressed_size, e.method == archive.ZipMethodDeflate64
    end
    archive.FreeEntries(entries)
    mut status := 0
    text := archive.ZipExtractVerified(z.data, z.len, "t.txt", 0, status)
    println status == archive.ZIP_OK, compress.BufToStrUnsafe(text)
    mut files := Vector {} as Vector<archive.ZipFileInput>
    files.push(archive.MakeZipFileInput("t.txt", text.data, text.len, archive.ZipMethodDeflate64))
    written := archive.ZipCreate(files)
    mut back := archive.ZipList(written.data, written.len)
    println "written with method", back.get(0).method
    archive.FreeEntries(back)
end
