import archive
import compress
import str

func main:
    mut text := compress.NewByteBuf()
    repeat 80 in i:
        line := "line " + str.FromInt(i * 7 % 23) + ": zip entries can use several methods\n"
        compress.BufPushBytes(text, line as void*, line.Len())
    end
    println "text:", text.len, "bytes"
    names := ["store", "deflate", "bzip2", "lzma", "zstd"]
    methods := [archive.ZipMethodStore, archive.ZipMethodDeflate, archive.ZipMethodBzip2, archive.ZipMethodLzma, archive.ZipMethodZstd]
    repeat 5 in i:
        mut files := Vector {} as Vector<archive.ZipFileInput>
        files.push(archive.MakeZipFileInput("notes.txt", text.data, text.len, methods[i]))
        z := archive.ZipCreate(files)
        mut checked := 0
        mut status := 0
        back := archive.ZipExtractVerified(z.data, z.len, "notes.txt", 0, status)
        println names[i], "method", methods[i], "zip", z.len, "bytes, verify", archive.ZipVerify(z.data, z.len, checked), "same text", status == 0 and compress.BufEquals(back, text)
    end

    mut files := Vector {} as Vector<archive.ZipFileInput>
    files.push(archive.MakeZipFileInputLevel("fast.txt", text.data, text.len, archive.ZipMethodZstd, 1))
    mut best := archive.MakeZipFileInput("best.txt", text.data, text.len, archive.ZipMethodZstd)
    best.level = 19
    files.push(best)
    files.push(archive.MakeZipFileInput("empty.txt", null, 0, archive.ZipMethodBzip2))
    z := archive.ZipCreate(files)
    mut entries := archive.ZipList(z.data, z.len)
    each e in entries:
        println e.name, "method", e.method, e.size, "->", e.compressed_size
    end
    archive.FreeEntries(entries)
end
