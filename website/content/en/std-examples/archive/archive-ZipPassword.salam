func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        c := bp[i] as int
        mut v := -1
        if c >= 48 and c <= 57:
            v = c - 48
        else c >= 97 and c <= 102:
            v = c - 87
        end
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func main:
    archive.WriteBinaryFileBuf("secret.zip", unhex(HEX))
    mut zf := archive.ZipOpenFile("secret.zip")
    println archive.ZipFileExtractTo(zf, "t.txt", "t.out", 0 as i64) == archive.ZIP_ENCRYPTED
    archive.ZipFileSetPassword(zf, "nope")
    println archive.ZipFileExtractTo(zf, "t.txt", "t.out", 0 as i64) == archive.ZIP_BAD_PASSWORD
    archive.ZipFileSetPassword(zf, "pw123")
    println archive.ZipFileExtractTo(zf, "t.txt", "t.out", 0 as i64) == archive.ZIP_OK
    archive.ZipFileClose(zf)
    os.Remove("secret.zip")
    os.Remove("t.out")
end
