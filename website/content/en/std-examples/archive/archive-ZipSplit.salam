import archive
import compress
import os

func main:
    mut data := compress.NewByteBufCap(150000)
    repeat 150000 in i:
        compress.BufPush(data, 65 + i % 23)
    end
    mut files := Vector {} as Vector<archive.ZipFileInput>
    files.push(archive.MakeZipFileInput("big.bin", data.data, data.len, 0))
    println archive.ZipCreateFileSplit(files, "split.zip", 65536 as i64, archive.ZipSplitDisk)
    files.free()
    compress.BufFree(data)

    mut zf := archive.ZipOpenFile("split.zip")
    println zf.status == archive.ZIP_OK, zf.count, zf.volumes.len()
    println archive.ZipFileExtractTo(zf, "big.bin", "big.out", 0 as i64) == archive.ZIP_OK, os.FileSize("big.out")
    archive.ZipFileClose(zf)
    os.Remove("big.out")
    os.Remove("split.z01")
    os.Remove("split.z02")
    os.Remove("split.zip")
end
