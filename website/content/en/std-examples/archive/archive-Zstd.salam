import archive
import compress
import filepath
import os

func main:
    dir := filepath.Join(os.TempDir(), "salam_zstd_example")
    os.RemoveAll(dir)
    os.MkdirAll(dir)
    plain := filepath.Join(dir, "notes.txt")
    packed := filepath.Join(dir, "notes.txt.zst")
    back := filepath.Join(dir, "notes.back")
    text := compress.BufFromStr("Salam keeps notes in plain files. ".repeat(50))
    archive.WriteBinaryFileBuf(plain, text)

    println "pack:", archive.ZstdCompressFile(plain, packed)
    mut ok := false
    z := archive.ReadBinaryFile(packed, ok)
    println ok, z.len, "bytes,", compress.IsZstdBuf(z)
    println "unpack:", archive.ZstdDecompressFile(packed, back)
    again := archive.ReadBinaryFile(back, ok)
    println compress.BufEquals(again, text)
    println "level 19:", archive.ZstdCompressFileLevel(plain, packed, 19)
    println "wrong format:", archive.ZstdDecompressFile(plain, back)
    println "missing:", archive.ZstdDecompressFile(filepath.Join(dir, "none.zst"), back)
    os.RemoveAll(dir)
end
