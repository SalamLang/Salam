import audio
import audio.au
import compress
import filepath
import math
import mem
import os

func main:
    mut c := audio.New(22050, 1, 64)
    audio.SetSample(c, 3, 0, 0.5)
    buf := au.EncodeAUEncoding(c, au.EncPcm16)
    println au.IsAU(buf.data, buf.len), au.IsAU(buf.data, 8)
    println audio.FormatName(audio.DetectFormat(buf.data, buf.len))

    mut h := au.Header {}
    println au.ReadHeader(buf.data, buf.len, h)
    println h.data_offset == au.HeaderSize, h.encoding == au.EncPcm16
    println h.rate, h.channels, h.data_size

    mut ok := false
    info := au.ProbeAU(buf.data, buf.len, ok)
    println ok, info.rate, info.channels, info.bits, info.frames, info.lossless

    mut dok := false
    back := au.DecodeAU(buf.data, buf.len, dok)
    println dok, back.frames, back.bits, audio.Sample(back, 3, 0)

    fbuf := au.EncodeAUEncoding(c, au.EncFloat32)
    mut fok := false
    fback := au.DecodeAU(fbuf.data, fbuf.len, fok)
    println fok, fback.bits, audio.Sample(fback, 3, 0) == audio.Sample(c, 3, 0)

    mbuf := au.EncodeAUEncoding(c, au.EncMuLaw)
    mut mok := false
    mback := au.DecodeAU(mbuf.data, mbuf.len, mok)
    println mok, mback.bits, math.Abs(audio.Sample(mback, 3, 0) - 0.5) < 0.02
    mut minfo := false
    println au.ProbeAU(mbuf.data, mbuf.len, minfo).lossless
    println compress.BufLen(mbuf) == au.HeaderSize + 64

    println compress.BufLen(au.EncodeAUEncoding(c, 99))

    path := filepath.Join(os.TempDir(), "salam_au_example.au")
    defer mem.Free(path as void*)
    println au.SaveAU(c, path)
    mut diskok := false
    disk := au.OpenAU(path, diskok)
    println diskok, disk.frames, disk.rate
    mut gone := false
    missing := filepath.Join(os.TempDir(), "salam_au_none.au")
    defer mem.Free(missing as void*)
    au.OpenAU(missing, gone)
    println gone

    compress.BufFree(buf)
    compress.BufFree(fbuf)
    compress.BufFree(mbuf)
    audio.Free(c)
    audio.Free(back)
    audio.Free(fback)
    audio.Free(mback)
    audio.Free(disk)
end
