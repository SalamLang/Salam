import audio.dsp
import math

func main:
    println dsp.BesselI0(0.0)
    hann := dsp.MakeWindow(dsp.WindowHann, 9, 0.0)
    println hann.len(), hann.get(0) < 0.000000001, math.Abs(hann.get(4) - 1.0) < 0.000000001
    println hann.get(8) < 0.000000001
    println dsp.WindowValue(dsp.WindowRectangular, 0, 9, 0.0)
    println math.Abs(dsp.WindowValue(dsp.WindowHamming, 0, 9, 0.0) - 0.08) < 0.000000001
    println math.Abs(dsp.MakeWindow(dsp.WindowBlackman, 9, 0.0).get(4) - 1.0) < 0.000000001
    println math.Abs(dsp.MakeWindow(dsp.WindowBlackmanHarris, 9, 0.0).get(4) - 1.0) < 0.000000001
    println math.Abs(dsp.MakeWindow(dsp.WindowSine, 9, 0.0).get(4) - 1.0) < 0.000000001
    println dsp.MakeWindow(dsp.WindowVorbis, 9, 0.0).get(0) < 0.000000001
    println math.Abs(dsp.MakeWindow(dsp.WindowKaiser, 9, 8.6).get(4) - 1.0) < 0.000000001
    println dsp.WindowName(dsp.WindowHann), dsp.WindowName(dsp.WindowKaiser), dsp.WindowName(99)
    println dsp.WindowSum(dsp.WindowRectangular, 8, 0.0)
    mut buf := Vector {} as Vector<f64>
    mut i := 0
    until i < 8:
        buf.push(1.0)
        i += 1
    end
    dsp.ApplyWindow(buf.ref(0), 8, dsp.WindowHann, 0.0)
    println buf.get(0) < 0.000000001, buf.get(4) > 0.9
end
