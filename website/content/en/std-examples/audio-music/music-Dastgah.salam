import audio.music

func main:
    mut shur := music.Dastgah(music.DastgahShur)
    println shur.Len(), shur.Get(0), shur.Get(2), shur.Get(6)
    shur.Free()
    mut mahur := music.Dastgah(music.DastgahMahur)
    println mahur.Get(2)
    mahur.Free()
    mut homayoun := music.Dastgah(music.DastgahHomayoun)
    println homayoun.Get(1)
    homayoun.Free()
    mut segah := music.Dastgah(music.DastgahSegah)
    println segah.Get(2)
    segah.Free()

    println music.KoronCents, music.SoriCents

    mut freqs := music.DastgahFreqs(60, music.DastgahShur)
    println freqs.Len()
    println freqs.Get(0) == music.NoteToFreq(60)
    println freqs.Get(2) > music.NoteToFreq(63), freqs.Get(2) < music.NoteToFreq(64)
    freqs.Free()

    println music.JustRatio(0), music.JustRatio(7), music.JustRatio(4)
    println music.PythagoreanRatio(0), music.PythagoreanRatio(7), music.PythagoreanRatio(2)
    println music.JustFreq(69, 7)
end
