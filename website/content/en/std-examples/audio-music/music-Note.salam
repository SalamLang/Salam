import audio.music
import math
import mem

func main:
    println music.A4Note, music.A4Freq
    println music.NoteToFreq(69), music.NoteToFreq(81), music.NoteToFreq(57)
    println math.Abs(music.NoteToFreq(60) - 261.6255653005986) < 0.0001
    println music.FreqToNote(440.0), music.FreqToNote(261.63), music.FreqToNote(0.0)
    println music.Octave(60), music.PitchClass(61), music.PitchClass(-1)
    println music.Transpose(60, 7), music.Interval(60, 67)
    println music.Cents(440.0, 880.0), music.FreqToCents(440.0, 69)
    println music.NoteToFreqCents(69, 1200.0)

    each n in [60, 61, 69, 127]:
        name := music.NoteName(n)
        println name, music.ParseNote(name) == n
        mem.Free(name as void*)
    end
    println music.ParseNote("c4"), music.ParseNote("Db4")
    println music.ParseNote("x9"), music.ParseNote(""), music.ParseNote("C")
    println music.BeatSeconds(120.0), music.BeatSeconds(0.0)
end
