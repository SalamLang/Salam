import audio.music

func main:
    mut maj := music.Scale(music.ScaleMajor)
    println maj.len(), maj.get(0), maj.get(6)
    maj.free()
    mut minor := music.Scale(music.ScaleMinor)
    println minor.get(2), minor.get(5)
    minor.free()
    mut chrom := music.Scale(music.ScaleChromatic)
    println chrom.len()
    chrom.free()
    mut pent := music.Scale(music.ScalePentatonic)
    println pent.len()
    pent.free()
    mut blues := music.Scale(music.ScaleBlues)
    println blues.len(), blues.get(3)
    blues.free()
    mut dor := music.Scale(music.ScaleDorian)
    println dor.get(2), dor.get(6)
    dor.free()

    mut run := music.ScaleNotes(60, music.ScaleMajor, 8)
    println run.len(), run.get(0), run.get(7)
    run.free()

    mut tri := music.ChordNotes(60, music.ChordMajor)
    println tri.len(), tri.get(1), tri.get(2)
    tri.free()
    mut m7 := music.ChordNotes(60, music.ChordMinor7)
    println m7.len(), m7.get(3)
    m7.free()
    mut dim := music.Chord(music.ChordDiminished)
    println dim.get(2)
    dim.free()
    mut sus := music.Chord(music.ChordSus4)
    println sus.get(1)
    sus.free()
    mut aug := music.Chord(music.ChordAugmented)
    println aug.get(2)
    aug.free()
    mut dom := music.Chord(music.ChordDominant7)
    println dom.get(3)
    dom.free()
end
