import audio
import audio.wav
import compress
import math

func main:
    println wav.EncodeMuLawByte(0), wav.DecodeMuLawByte(wav.EncodeMuLawByte(0))
    println wav.EncodeMuLawByte(16000), wav.DecodeMuLawByte(144)
    println wav.EncodeALawByte(16000), wav.DecodeALawByte(186)
    println wav.EncodeALawByte(0), wav.DecodeALawByte(213)

    mut near := 0
    mut far := 0
    mut v := -32768
    until v < 32768:
        d := math.AbsI(wav.DecodeMuLawByte(wav.EncodeMuLawByte(v)) - v)
        if math.AbsI(v) <= 256:
            if d > near:
                near = d
            end
        end
        if d > far:
            far = d
        end
        v += 7
    end
    println near, far

    mut c := audio.New(8000, 2, 50)
    audio.SetSample(c, 10, 0, 0.5)
    mu := wav.EncodeMuLaw(c)
    al := wav.EncodeALaw(c)
    println compress.BufLen(mu), compress.BufLen(al), compress.BufLen(wav.EncodeWAVBits(c, 16))
    mut ok := false
    back := wav.DecodeWAV(mu.data, mu.len, ok)
    println ok, back.frames, back.channels, back.bits
    println math.Abs(audio.Sample(back, 10, 0) - 0.5) < 0.01
    compress.BufFree(mu)
    compress.BufFree(al)
    audio.Free(c)
end
