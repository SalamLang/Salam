import aws

func main:
    cfg := aws.FromEnvironment("")
    if not aws.Configured(cfg):
        println "AWS credentials are not set"
        ret
    end

    bucket := "salam-demo-2026"
    _ := aws.S3CreateBucket(cfg, bucket)
    _ := aws.S3CreateBucketAcl(cfg, bucket + "-logs", "private")
    println aws.S3BucketExists(cfg, bucket), aws.S3HeadBucket(cfg, bucket).status, aws.S3BucketRegion(cfg, bucket)

    mut list := aws.S3ListBuckets(cfg)
    println list.ok, list.owner, aws.BucketCount(list)
    repeat aws.BucketCount(list) in i:
        b := aws.BucketAt(list, i)
        println b.name, b.created, b.region
    end
    aws.BucketListFree(list)

    _ := aws.S3SetVersioning(cfg, bucket, true)
    println aws.S3Versioning(cfg, bucket)
    mut tags := aws.NewTags()
    aws.TagSet(tags, "project", "salam")
    _ := aws.S3SetBucketTags(cfg, bucket, tags)
    aws.HeaderFree(tags)
    mut current := aws.S3BucketTags(cfg, bucket)
    println aws.HeaderGet(current, "project")
    aws.HeaderFree(current)
    _ := aws.S3DeleteBucketTags(cfg, bucket)

    policy := `{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":"*","Action":"s3:GetObject","Resource":"arn:aws:s3:::salam-demo-2026/public/*"}]}`
    _ := aws.S3SetBucketPolicy(cfg, bucket, policy)
    println aws.S3BucketPolicy(cfg, bucket).len() > 0
    _ := aws.S3DeleteBucketPolicy(cfg, bucket)
    _ := aws.S3SetBucketCors(cfg, bucket, "https://salamlang.ir", "GET,PUT", 3600)
    println aws.S3BucketCors(cfg, bucket).len() > 0
    _ := aws.S3DeleteBucketCors(cfg, bucket)
    _ := aws.S3SetLifecycle(cfg, bucket, aws.S3ExpiryRule("tmp/", 7, 1))
    println aws.S3Lifecycle(cfg, bucket).len() > 0
    _ := aws.S3DeleteLifecycle(cfg, bucket)

    _ := aws.S3DeleteBucket(cfg, bucket + "-logs")
    println aws.S3DeleteBucket(cfg, bucket).ok
end
