import aws

func main:
    println aws.AwsEndpoint("eu-central-1"), aws.StsEndpoint("eu-central-1"), aws.ServiceEndpoint("sqs", "eu-west-1")
    println aws.ForAws("eu-central-1", "photos").endpoint, aws.ForMinio("http://127.0.0.1:9000/", "photos").endpoint
    println aws.ForR2("acct", "photos").endpoint, aws.ForSpaces("ams3", "photos").endpoint
    println aws.ForWasabi("eu-central-1", "photos").endpoint, aws.ForBackblaze("us-west-004", "photos").endpoint
    println aws.ForEndpoint("https://s3.example.ir", "ir-tehran", "photos").region

    mut cfg := aws.NewConfig("http://127.0.0.1:9000", "photos")
    println aws.Configured(cfg)
    cfg = aws.WithCredentials(cfg, "AKIDEXAMPLE", "secret")
    cfg = aws.WithBucket(cfg, "backup")
    cfg = aws.WithSessionToken(cfg, "token")
    cfg = aws.WithRetry(cfg, 5, 200)
    println aws.Configured(cfg), cfg.bucket, cfg.retry, cfg.retry_base_ms, cfg.path_style, cfg.service
    println aws.Describe(cfg)

    text := "[default]\nregion = eu-west-1\n\n[profile work]\nregion = me-central-1\n"
    println aws.ParseIni(text, "default", "region"), aws.ParseIni(text, "profile work", "region")
    println aws.CredentialsPath().len() > 0, aws.ConfigPath().len() > 0
    println aws.FromEnvironment("photos").bucket

    creds := aws.StaticCredentials("AKIDEXAMPLE", "secret")
    println creds.ok, creds.source, aws.ExpiredNow(creds), aws.SOURCE_CONTAINER
    applied := aws.Apply(aws.ForAws("", "photos"), creds)
    println applied.access_key

    body := `<AssumeRoleResponse><AssumeRoleResult><Credentials><AccessKeyId>ASIAEXAMPLE</AccessKeyId><SecretAccessKey>s</SecretAccessKey><SessionToken>t</SessionToken><Expiration>2030-01-01T00:00:00Z</Expiration></Credentials></AssumeRoleResult></AssumeRoleResponse>`
    temp := aws.ParseCredentials(body, 200, "sts")
    println temp.ok, temp.access_key, temp.session_token, temp.expires, temp.source
    now := 1893455000 as i64
    println aws.Expired(temp, now, aws.STS_DEFAULT_SKEW), aws.SecondsRemaining(temp, now)
    println aws.DescribeCredentials(temp)
    println aws.SOURCE_ENV, aws.SOURCE_PROFILE, aws.SOURCE_WEB_IDENTITY, aws.SOURCE_INSTANCE
    println aws.STS_VERSION, aws.STS_MIN_DURATION, aws.STS_MAX_DURATION

    chain := aws.DefaultChain()
    println chain.use_env, chain.use_profile, chain.use_instance, aws.ContainerChain().use_instance

    failed := aws.Failure("no network")
    println failed.ok, failed.error
end
