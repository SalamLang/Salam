import aws

func main:
    cfg := aws.FromEnvironment("photos")
    if not aws.Configured(cfg):
        println "set AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY"
        ret
    end

    put := aws.S3Put(cfg, "notes/hello.txt", "hello world", "text/plain; charset=utf-8")
    println put.ok, put.status, put.etag, put.request_id
    o := aws.PutOptions { content_type = "text/html", cache_control = "max-age=3600", storage_class = "STANDARD_IA", acl = "public-read" }
    aws.HeaderSet(o.meta, "owner", "ali")
    _ := aws.S3PutWith(cfg, "site/index.html", "<h1>hello</h1>", o)
    data := "salam"
    _ := aws.S3PutBytes(cfg, "raw.bin", data as void*, data.len(), "application/octet-stream")
    _ := aws.S3PutBytesWith(cfg, "raw2.bin", data as void*, data.len(), o)

    got := aws.S3Get(cfg, "notes/hello.txt")
    if got.ok:
        println got.body, got.length, aws.ResultHeader(got, "Content-Type")
    else:
        println got.status, got.code, got.error
    end
    _ := aws.S3GetWith(cfg, "notes/hello.txt", aws.GetOptions { if_none_match = got.etag })
    mut b := aws.S3GetBytes(cfg, "raw.bin")
    println b.ok, b.len, aws.BytesHeader(b, "ETag")
    aws.FreeBytes(b)
    mut b2 := aws.S3GetRange(cfg, "raw.bin", 0, 1)
    aws.FreeBytes(b2)
    mut b3 := aws.S3GetBytesWith(cfg, "raw.bin", aws.GetOptions { range_start = 2, range_end = 4 })
    aws.FreeBytes(b3)

    info := aws.S3Stat(cfg, "site/index.html")
    println info.ok, info.size, info.content_type, info.last_modified, info.storage_class
    _ := aws.S3StatVersion(cfg, "site/index.html", info.version_id)
    println aws.S3Head(cfg, "raw.bin").status, aws.S3Exists(cfg, "raw.bin"), aws.S3Size(cfg, "raw.bin")
    println aws.S3ObjectChecksum(cfg, "raw.bin")

    _ := aws.S3Copy(cfg, "notes/hello.txt", "notes/copy.txt")
    _ := aws.S3CopyWith(cfg, "notes/hello.txt", "archive/hello.txt", aws.CopyOptions { storage_class = "GLACIER" })
    _ := aws.S3Move(cfg, "notes/copy.txt", "notes/moved.txt")
    _ := aws.S3Touch(cfg, "notes/moved.txt", aws.CopyOptions {})
    _ := aws.S3Restore(cfg, "archive/hello.txt", 2, "Standard")

    _ := aws.S3SetObjectTags(cfg, "raw.bin", aws.NewTags())
    _ := aws.S3AddObjectTag(cfg, "raw.bin", "team", "web")
    mut t := aws.S3ObjectTags(cfg, "raw.bin")
    println aws.TagString(t)
    aws.HeaderFree(t)
    mut t2 := aws.S3ObjectTagsVersion(cfg, "raw.bin", "")
    aws.HeaderFree(t2)
    _ := aws.S3DeleteObjectTags(cfg, "raw.bin")
    _ := aws.S3MakePublic(cfg, "raw.bin")
    _ := aws.S3MakePrivate(cfg, "raw.bin")
    _ := aws.S3SetObjectAcl(cfg, "raw.bin", "private")
    println aws.S3ObjectAcl(cfg, "raw.bin").len() > 0
    _ := aws.S3SetLegalHold(cfg, "raw.bin", true)
    println aws.S3LegalHold(cfg, "raw.bin")
    _ := aws.S3SetRetention(cfg, "raw.bin", "GOVERNANCE", 1893456000 as i64)

    mut l := aws.S3List(cfg, aws.ListOptions { prefix = "notes/", max_keys = 100 })
    each e in l.items:
        println e.key, e.size
    end
    aws.ListFree(l)
    mut l2 := aws.S3ListPrefix(cfg, "site/")
    aws.ListFree(l2)
    mut l3 := aws.S3ListFolder(cfg, "")
    println aws.ListPrefixCount(l3)
    aws.ListFree(l3)
    mut l4 := aws.S3ListAll(cfg, "")
    println aws.ListCount(l4), aws.ListTotalSize(l4)
    aws.ListFree(l4)
    mut l5 := aws.S3ListAllWith(cfg, aws.ListOptions { prefix = "site/" })
    aws.ListFree(l5)
    mut l6 := aws.S3ListV1(cfg, aws.ListOptions {}, "")
    aws.ListFree(l6)
    mut l7 := aws.S3ListVersions(cfg, aws.ListOptions { prefix = "raw" }, "", "")
    aws.ListFree(l7)
    mut keys := aws.S3Keys(cfg, "notes/")
    _ := aws.S3DeleteMany(cfg, keys)
    aws.KeyFree(keys)
    _ := aws.S3DeletePrefix(cfg, "site/")
    _ := aws.S3DeleteVersion(cfg, "raw2.bin", "")
    println aws.S3Delete(cfg, "raw.bin").ok
end
