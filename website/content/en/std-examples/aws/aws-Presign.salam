import aws

func main:
    mut cfg := aws.ForAws("", "examplebucket")
    cfg = aws.WithCredentials(cfg, "AKIAIOSFODNN7EXAMPLE", "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY")
    at := 1369353600 as i64
    println aws.S3Url(cfg, "cdn/42.png")
    println aws.S3PresignAt(cfg, "GET", "test.txt", 86400, at)

    o := aws.PresignOptions { expires = 600, content_type = "image/png" }
    url := aws.S3PresignWith(cfg, "PUT", "up.png", o, at)
    println url.find("X-Amz-SignedHeaders=content-type%3Bhost") >= 0, url.find("X-Amz-Expires=600") >= 0

    println aws.S3Presign(cfg, "DELETE", "old.txt", 60).find("X-Amz-Expires=60&") >= 0
    println aws.S3PresignGet(cfg, "report.pdf", 3600).find("https://examplebucket.s3.amazonaws.com/report.pdf?") == 0
    println aws.S3PresignPut(cfg, "avatar.png", "image/png", 300).find("content-type") >= 0
    println aws.S3PresignDownload(cfg, "r/123.pdf", "report.pdf", 300).find("response-content-disposition") >= 0

    po := aws.PostOptions {
        expires = 3600, key_is_prefix = true, content_type = "image/", content_type_is_prefix = true, max_bytes = 1048576 as i64, acl = "private"
    }
    form := aws.S3PresignPostAt(cfg, "incoming/", po, at)
    println form.ok, form.url
    println form.policy
    println aws.HeaderGet(form.fields, "x-amz-signature")
    println aws.PostFormHtml(form, "file").find("<form") >= 0
    println aws.S3PresignPost(cfg, "a.png", aws.PostOptions {}).ok
end
