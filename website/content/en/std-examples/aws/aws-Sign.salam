import aws

func example(): aws.Config:
    ret aws.Config {
        endpoint = "https://s3.amazonaws.com", bucket = "examplebucket", access_key = "AKIAIOSFODNN7EXAMPLE", secret_key = "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY", path_style = false
    }
end

func main:
    at := 1369353600 as i64
    date := aws.AmzDate(at)
    println date, aws.DateStamp(date), aws.Scope(aws.DateStamp(date), "us-east-1", aws.SERVICE_S3)
    println aws.EncodeKey("photos/a b+c.png"), aws.UriEncode("a b/c", true), aws.UriEncode("a b/c", false)
    println aws.ALGORITHM, aws.UNSIGNED_PAYLOAD
    println aws.EMPTY_SHA256 == aws.Sha256Bytes(null, 0)

    headers := "host:examplebucket.s3.amazonaws.com\nrange:bytes=0-9\nx-amz-content-sha256:" + aws.EMPTY_SHA256 + "\nx-amz-date:" + date + "\n"
    signed := aws.SignRequest(example(), "GET", "/test.txt", "", headers, "host;range;x-amz-content-sha256;x-amz-date", aws.EMPTY_SHA256, at)
    println signed.ok, signed.amz_date
    println signed.authorization
    println aws.SignString(example(), aws.DateStamp(date), "text").len()
    println aws.SignQuery(example(), "GET", "/test.txt", "", "examplebucket.s3.amazonaws.com", at).len() > 0
    println aws.SignQueryHeaders(example(), "GET", "/test.txt", "", "host:examplebucket.s3.amazonaws.com\n", "host", at).len() > 0

    mut req := aws.NewRequest("GET", "test.txt")
    aws.SetHeader(req, "Range", "bytes=0-9")
    aws.SetQuery(req, "versionId", "v1")
    aws.SetQueryInt(req, "partNumber", 2)
    aws.SetFlag(req, "acl")
    print aws.CanonicalRequest(example(), req, at)
    println ""
    mut put := aws.NewRequest("PUT", "notes/a.txt")
    aws.SetText(put, "hello")
    head := aws.PreparedHead(example(), put, at)
    println head.find("PUT /notes/a.txt HTTP/1.1") == 0, head.find("Content-Length: 5") >= 0
    mut big := aws.NewRequest("PUT", "big.bin")
    aws.SetUnsignedPayload(big)
    println big.body_hash
    other := aws.NewBucketRequest("GET", "other", "")
    println other.bucket, aws.NewServiceRequest("GET").service_level

    text := "salam"
    aws.SetBody(big, text as void*, text.len())
    println big.body_len
    println aws.S3ContentHash(text as void*, text.len())
    println aws.S3ContentMd5(text as void*, text.len()), aws.S3ChecksumSha256(text as void*, text.len())
    println aws.S3ContentHashMd5(text as void*, text.len()), aws.S3MultipartEtag(text as void*, text.len(), 4)

    mut h := aws.NewHeaders()
    aws.HeaderSet(h, "Content-Type", "text/plain")
    aws.HeaderSet(h, "content-type", "text/html")
    aws.HeaderAdd(h, "x-amz-meta-tag", "a")
    aws.HeaderAdd(h, "x-amz-meta-tag", "b")
    println aws.HeaderCount(h), aws.HeaderGet(h, "CONTENT-TYPE"), aws.HeaderHas(h, "range")
    println aws.HeaderNameAt(h, 2), aws.HeaderValueAt(h, 2)
    aws.HeaderFree(h)

    mut tags := aws.NewTags()
    aws.TagSet(tags, "team", "web")
    aws.TagSet(tags, "env", "prod test")
    println aws.TagString(tags)

    println aws.Unquote("\"9b2cf5\"")
    err := "<Error><Code>NoSuchKey</Code><Message>The key does not exist</Message></Error>"
    println aws.ResultErrorCode(err), aws.ResultTag(err, "Message")
    println aws.ResultErrorMessage(err, 404)
    println aws.ResultErrorMessage("", 503)
end
