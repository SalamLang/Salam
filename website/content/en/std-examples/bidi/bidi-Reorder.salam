import bidi

func main:
    s := "abc سلام"
    println bidi.ParagraphLevel(s, bidi.DirAuto), bidi.ParagraphLevel("سلام abc", bidi.DirAuto)
    println bidi.ParagraphLevel(s, bidi.DirRTL), bidi.ParagraphLevel("سلام", bidi.DirLTR)
    println bidi.Levels(s, bidi.DirLTR)
    println bidi.VisualOrder(s, bidi.DirLTR)
    println bidi.Reorder(s, bidi.DirLTR)
end
