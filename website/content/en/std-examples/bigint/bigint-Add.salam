import bigint

func main:
    a := bigint.FromInt(9000000000000000000)
    b := bigint.FromUint(18000000000000000000 as u64)
    println bigint.ToStr(bigint.Add(a, b))
    println bigint.ToStr(bigint.Sub(a, b))
    println bigint.ToStr(bigint.Mul(a, b))
    println bigint.ToStr(bigint.Sqr(a))
    println bigint.ToStr(bigint.AddInt(a, 1)), bigint.ToStr(bigint.SubInt(a, 1)), bigint.ToStr(bigint.MulInt(a, 2))
    println bigint.ToStr(bigint.Neg(a)), bigint.ToStr(bigint.Abs(bigint.Neg(a)))
    println bigint.ToStr(bigint.Shl(bigint.One(), 70)), bigint.ToStr(bigint.Shr(a, 60))
    println bigint.ToStr(bigint.Zero()), bigint.ToStr(bigint.Pow10(20))
end
