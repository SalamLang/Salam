import bigint

func main:
    a := bigint.FromInt(12)
    b := bigint.FromInt(10)
    println bigint.ToStr(bigint.And(a, b)), bigint.ToStr(bigint.Or(a, b)), bigint.ToStr(bigint.Xor(a, b))
    println bigint.ToStr(bigint.AndNot(a, b)), bigint.ToStr(bigint.Not(a))
    println bigint.PopCount(a), bigint.TrailingZeros(a)
end
