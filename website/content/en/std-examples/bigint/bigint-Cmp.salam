import bigint

func main:
    a := bigint.FromInt(5)
    b := bigint.FromInt(-9)
    println bigint.Cmp(a, b), bigint.CmpAbs(a, b)
    println bigint.Equals(a, a), bigint.Less(a, b), bigint.Greater(a, b)
    println bigint.ToStr(bigint.Min(a, b)), bigint.ToStr(bigint.Max(a, b))
    println bigint.EqualsInt(a, 5), bigint.IsZero(a), bigint.Sign(b)
    println bigint.IsOdd(a), bigint.IsEven(a), bigint.BitLen(a), bigint.Bit(a, 1)
    c := bigint.Clone(b)
    println bigint.ToStr(c)
end
