import bigint

func main:
    mut a := bigint.FromInt(123456789)
    mut b := bigint.Pow(bigint.FromInt(2), 100)
    defer a.Free()
    defer b.Free()
    println b.ToStr()
    println a.IsZero(), a.Sign(), a.IsOdd(), a.IsEven()
    println b.BitLen(), b.LimbCount()
    c := a.Clone()
    println c.ToStr()
end
