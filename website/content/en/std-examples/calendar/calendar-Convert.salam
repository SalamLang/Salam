import calendar

func main:
    g := calendar.GregorianDate { year = 2024, month = 3, day = 20 }
    j := calendar.GregorianToJalali(g)
    h := calendar.GregorianToHijri(g)
    println calendar.FormatGregorian(g), calendar.FormatJalali(j), calendar.FormatHijri(h)
    println calendar.FormatJalaliLongFa(j)
    println calendar.FormatHijriLongFa(h)
    println calendar.FormatHijriLongAr(h)
    println calendar.FormatGregorianLongEn(g)
    println calendar.FormatGregorian(calendar.JalaliToGregorian(calendar.JalaliDate { year = 1403, month = 1, day = 1 }))
    println calendar.FormatGregorian(calendar.HijriToGregorian(calendar.HijriDate { year = 1445, month = 9, day = 1 }))
    println calendar.FormatHijri(calendar.JalaliToHijri(j)), calendar.FormatJalali(calendar.HijriToJalali(h))
    d := calendar.GregorianToJDN(g)
    println d, calendar.JalaliToJDN(j), calendar.HijriToJDN(h)
    println calendar.FormatGregorian(calendar.JDNToGregorian(d + 1)), calendar.FormatJalali(calendar.JDNToJalali(d + 1)), calendar.FormatHijri(calendar.JDNToHijri(d + 1))
end
