import chan
import sync

mut jobs := chan.Chan {} as chan.Chan<i64>
mut results := chan.Chan {} as chan.Chan<i64>
mut group := sync.WaitGroup {}

func worker():
    mut open := true
    until true:
        n := jobs.Recv(open)
        if not open:
            break
        end
        results.Send(n * n)
    end
    sync.Done(group)
end

func main:
    jobs.Init(4)
    results.Init(16)
    group = sync.NewWaitGroup()
    sync.Add(group, 2)
    a := spawn(worker)
    b := spawn(worker)
    repeat 1 to 11 in n:
        jobs.Send(n)
    end
    jobs.Close()
    sync.Wait(group)
    join(a)
    join(b)
    results.Close()
    mut total := 0 as i64
    mut open := true
    until true:
        v := results.Recv(open)
        if not open:
            break
        end
        total += v
    end
    println "sum of the squares:", total
    println jobs.IsClosed(), jobs.Len(), jobs.Capacity(), jobs.Send(1)
    sync.DestroyWaitGroup(group)
    jobs.Free()
    results.Free()
end
