import chan
import sync

mut jobs := chan.Chan {} as chan.Chan<i64>
mut results := chan.Chan {} as chan.Chan<i64>
mut group := sync.WaitGroup {}

func worker():
    mut open := true
    until true:
        n := jobs.recv(open)
        if not open:
            break
        end
        results.send(n * n)
    end
    sync.Done(group)
end

func main:
    jobs.init(4)
    results.init(16)
    group = sync.NewWaitGroup()
    sync.Add(group, 2)
    a := spawn(worker)
    b := spawn(worker)
    repeat 1 to 11 in n:
        jobs.send(n)
    end
    jobs.close()
    sync.Wait(group)
    join(a)
    join(b)
    results.close()
    mut total := 0 as i64
    mut open := true
    until true:
        v := results.recv(open)
        if not open:
            break
        end
        total += v
    end
    println "sum of the squares:", total
    println jobs.is_closed(), jobs.len(), jobs.capacity(), jobs.send(1)
    sync.DestroyWaitGroup(group)
    jobs.free()
    results.free()
end
