import chan
import pool

func main:
    mut a := chan.Chan {} as chan.Chan<i64>
    mut b := chan.Chan {} as chan.Chan<i64>
    a.init(2 as i64)
    b.init(2 as i64)
    mut all := Vector {} as Vector<chan.Chan<i64>>
    all.push(a)
    all.push(b)
    p := pool.New(1 as i64, 2 as i64)
    pool.Submit(p, (): b.send(42 as i64) end)
    mut v := 0 as i64
    println chan.Select(all, v, 1000 as i64)
    println v
    println chan.Select(all, v, 10 as i64)
    a.close()
    b.close()
    println chan.Select(all, v, 10 as i64)
    pool.Stop(p)
    a.free()
    b.free()
end
