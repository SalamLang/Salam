import chan

func main:
    mut c := chan.Chan {} as chan.Chan<str>
    c.init(1)
    println c.try_send("hello"), c.try_send("again")
    println c.send_timeout("late", 20)
    mut open := true
    println c.try_recv(open), open
    _ := c.recv_timeout(open, 20)
    println "after 20 milliseconds:", open
    println c.send_deadline("a", 0, false)
    println c.recv_deadline(open, 20, true), open
    c.free()
end
