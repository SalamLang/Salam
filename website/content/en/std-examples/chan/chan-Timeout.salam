import chan

func main:
    mut c := chan.Chan {} as chan.Chan<str>
    c.Init(1)
    println c.TrySend("hello"), c.TrySend("again")
    println c.SendTimeout("late", 20)
    mut open := true
    println c.TryRecv(open), open
    _ := c.RecvTimeout(open, 20)
    println "after 20 milliseconds:", open
    println c.SendDeadline("a", 0, false)
    println c.RecvDeadline(open, 20, true), open
    c.Free()
end
