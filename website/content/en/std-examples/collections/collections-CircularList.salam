import collections

func main:
    mut c := collections.CircularList {} as collections.CircularList<str>
    defer c.Free()
    each name in ["Ali", "Sara", "Reza"]:
        c.add(name)
    end
    repeat 4:
        print c.current(), ""
        c.advance()
    end
    println ""
    c.rotate(1)
    println c.ToVector(), c.Get(0), c.Size(), c.IsEmpty()
end
