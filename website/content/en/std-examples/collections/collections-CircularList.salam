import collections

func main:
    mut c := collections.CircularList {} as collections.CircularList<str>
    defer c.free()
    each name in ["Ali", "Sara", "Reza"]:
        c.add(name)
    end
    repeat 4:
        print c.current(), ""
        c.advance()
    end
    println ""
    c.rotate(1)
    println c.to_vector(), c.get(0), c.size(), c.is_empty()
end
