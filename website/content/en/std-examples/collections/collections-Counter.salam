import collections
import str

func main:
    mut c := collections.Counter {} as collections.Counter<str>
    defer c.free()
    each word in str.Fields("in the name of the friend"):
        c.add(word)
    end
    c.add_n("friend", 2)
    println c.count("the"), c.count("friend"), c.count("missing"), c.distinct()
end
