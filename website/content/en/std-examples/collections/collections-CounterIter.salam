import collections
import str

func main:
    mut c := collections.Counter {} as collections.Counter<str>
    defer c.free()
    each word in str.Fields("in the name of the friend the"):
        c.add(word)
    end
    mut total := 0
    mut it := c.iter()
    until it.has_next():
        if it.key() == "the":
            println it.key(), it.value()
        end
        total += it.value()
        it.next()
    end
    println total, c.distinct()
end
