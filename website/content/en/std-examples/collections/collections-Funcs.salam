import collections

func main:
    mut a := Vector {} as Vector<int>
    defer a.Free()
    each n in [1, 2, 3, 2, 5]:
        a.Push(n)
    end
    println collections.Contains(a, 3), collections.IndexOf(a, 2), collections.LastIndexOf(a, 2), collections.CountOf(a, 2)
    println collections.Reverse(a), collections.Slice(a, 1, 3)
    b := collections.Clone(a)
    collections.Swap(a, 0, 4)
    println a, b
    mut c := Vector {} as Vector<int>
    defer c.Free()
    collections.Extend(c, b)
    collections.Extend(c, b)
    println c.Len()
end
