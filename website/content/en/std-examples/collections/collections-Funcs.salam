import collections

func main:
    mut a := Vector {} as Vector<int>
    defer a.Free()
    each n in [1, 2, 3, 2, 5]:
        a.push(n)
    end
    println collections.contains(a, 3), collections.IndexOf(a, 2), collections.last_index_of(a, 2), collections.count_of(a, 2)
    println collections.reverse(a), collections.slice(a, 1, 3)
    b := collections.clone(a)
    collections.swap(a, 0, 4)
    println a, b
    mut c := Vector {} as Vector<int>
    defer c.Free()
    collections.extend(c, b)
    collections.extend(c, b)
    println c.Len()
end
