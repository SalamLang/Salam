func main:
    mut m := HashMap {} as HashMap<str, int>
    defer m.free()
    println m.is_empty()
    m.put("apple", 3)
    m.insert("pear", 5)
    m.put("apple", 4)
    println m.size(), m.has("apple"), m.get("apple"), m.get_or("banana", 0)
    println m.remove("pear"), m.remove("pear"), m.size()
    mut it := m.iter()
    until it.has_next():
        println it.key(), it.value()
        it.next()
    end
end
