func main:
    mut m := HashMap {} as HashMap<str, int>
    defer m.Free()
    println m.IsEmpty()
    m.Put("apple", 3)
    m.Insert("pear", 5)
    m.Put("apple", 4)
    println m.Size(), m.Has("apple"), m.Get("apple"), m.GetOr("banana", 0)
    println m.Remove("pear"), m.Remove("pear"), m.Size()
    mut it := m.Iter()
    until it.HasNext():
        println it.Key(), it.Value()
        it.Next()
    end
end
