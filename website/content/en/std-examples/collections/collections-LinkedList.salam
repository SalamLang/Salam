import collections

func main:
    mut l := collections.LinkedList {} as collections.LinkedList<str>
    defer l.Free()
    l.push_back("b")
    l.push_back("c")
    l.push_front("a")
    println l.to_vector(), l.Size()
    println l.front_val(), l.back_val(), l.Get(1)
    println l.pop_front(), l.pop_back(), l.Size(), l.IsEmpty()
end
