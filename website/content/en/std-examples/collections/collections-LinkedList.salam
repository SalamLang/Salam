import collections

func main:
    mut l := collections.LinkedList {} as collections.LinkedList<str>
    defer l.free()
    l.push_back("b")
    l.push_back("c")
    l.push_front("a")
    println l.to_vector(), l.size()
    println l.front_val(), l.back_val(), l.get(1)
    println l.pop_front(), l.pop_back(), l.size(), l.is_empty()
end
