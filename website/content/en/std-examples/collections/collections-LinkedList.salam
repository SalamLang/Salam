import collections

func main:
    mut l := collections.LinkedList {} as collections.LinkedList<str>
    defer l.Free()
    l.PushBack("b")
    l.PushBack("c")
    l.PushFront("a")
    println l.ToVector(), l.Size()
    println l.FrontVal(), l.BackVal(), l.Get(1)
    println l.PopFront(), l.PopBack(), l.Size(), l.IsEmpty()
end
