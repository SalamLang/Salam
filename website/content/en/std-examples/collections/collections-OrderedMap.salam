import collections

func main:
    mut m := collections.OrderedMap {}
    defer m.Free()
    m.Set("name", "Salam")
    m.Set("version", "0.5.0")
    m.Set("language", "english")
    println m.Len(), m.Has("version"), m.Get("name"), m.GetOr("licence", "-")
    println m.IndexOf("language"), m.KeyAt(0), m.ValAt(0)
    m.set_at(0, "Salam")
    println m.Remove("version"), m.Len()
    keys := m.clone_keys()
    println keys
end
