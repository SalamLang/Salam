import collections

func main:
    mut m := collections.OrderedMap {}
    defer m.free()
    m.set("name", "Salam")
    m.set("version", "0.5.0")
    m.set("language", "english")
    println m.len(), m.has("version"), m.get("name"), m.get_or("licence", "-")
    println m.index_of("language"), m.key_at(0), m.val_at(0)
    m.set_at(0, "Salam")
    println m.remove("version"), m.len()
    keys := m.clone_keys()
    println keys
end
