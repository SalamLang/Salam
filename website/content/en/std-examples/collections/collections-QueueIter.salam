import collections

func main:
    mut q := collections.Queue {} as collections.Queue<str>
    defer q.free()
    q.enqueue("customer 1")
    q.enqueue("customer 2")
    q.enqueue("customer 3")
    println q.dequeue()
    q.enqueue("customer 4")
    mut it := q.iter()
    until it.has_next():
        println it.value()
        it.next()
    end
end
