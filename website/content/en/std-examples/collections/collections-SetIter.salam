import collections

func main:
    mut s := collections.Set {} as collections.Set<str>
    defer s.Free()
    each word in ["hello", "world", "hello"]:
        s.add(word)
    end
    mut seen := 0
    mut it := s.Iter()
    until it.HasNext():
        if s.Has(it.value()):
            seen++
        end
        it.next()
    end
    println seen, s.Size()
end
