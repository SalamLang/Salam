import collections

func main:
    mut s := collections.Set {} as collections.Set<str>
    defer s.free()
    each word in ["hello", "world", "hello"]:
        s.add(word)
    end
    mut seen := 0
    mut it := s.iter()
    until it.has_next():
        if s.has(it.value()):
            seen += 1
        end
        it.next()
    end
    println seen, s.size()
end
