func main:
    mut v := Vector {} as Vector<int>
    defer v.free()
    v.reserve(8)
    println v.len(), v.cap() >= 8, v.is_empty()
    v.push(10)
    v.push(20)
    v.push(30)
    println v, v.first(), v.last(), v.get(1), v[2]
    v.set(0, 11)
    v[1] = 22
    v.insert(1, 15)
    println v
    println v.remove_at(1), v.pop(), v
    r := v.ref(0)
    r[0] = 99
    println v
    v.resize_set(v.len(), 7)
    println v
    v.clear()
    println v.len()
    mut z := Vector {} as Vector<int>
    defer z.free()
    z.zeros(3)
    println z
    mut a := Vector {} as Vector<int>
    defer a.free()
    a.alloc(4)
    println a.len()
end
