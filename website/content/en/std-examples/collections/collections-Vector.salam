func main:
    mut v := Vector {} as Vector<int>
    defer v.Free()
    v.Reserve(8)
    println v.Len(), v.Cap() >= 8, v.IsEmpty()
    v.Push(10)
    v.Push(20)
    v.Push(30)
    println v, v.First(), v.Last(), v.Get(1), v[2]
    v.Set(0, 11)
    v[1] = 22
    v.Insert(1, 15)
    println v
    println v.RemoveAt(1), v.Pop(), v
    r := v.Ref(0)
    r[0] = 99
    println v
    v.resize_set(v.Len(), 7)
    println v
    v.Clear()
    println v.Len()
    mut z := Vector {} as Vector<int>
    defer z.Free()
    z.zeros(3)
    println z
    mut a := Vector {} as Vector<int>
    defer a.Free()
    a.Alloc(4)
    println a.Len()
end
