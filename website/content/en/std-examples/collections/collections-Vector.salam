func main:
    mut v := Vector {} as Vector<int>
    defer v.Free()
    v.reserve(8)
    println v.Len(), v.cap() >= 8, v.IsEmpty()
    v.push(10)
    v.push(20)
    v.push(30)
    println v, v.first(), v.last(), v.Get(1), v[2]
    v.Set(0, 11)
    v[1] = 22
    v.Insert(1, 15)
    println v
    println v.remove_at(1), v.pop(), v
    r := v.ref(0)
    r[0] = 99
    println v
    v.resize_set(v.Len(), 7)
    println v
    v.clear()
    println v.Len()
    mut z := Vector {} as Vector<int>
    defer z.Free()
    z.zeros(3)
    println z
    mut a := Vector {} as Vector<int>
    defer a.Free()
    a.alloc(4)
    println a.Len()
end
