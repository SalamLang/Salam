import color
import math

func r2(v: f64): f64:
    ret math.Round(v * 100.0) / 100.0
end

func main:
    white := color.Hex(0xffffff)
    each hex in [0x777777, 0x3366aa, 0x1a1a1a]:
        c := color.Hex(hex)
        println color.Css(c), "luminance", r2(color.Luminance(c)), "contrast on white", r2(color.Contrast(c, white))
    end
    base := color.Hex(0x3366aa)
    println "lighter", color.Css(color.Lighten(base, 0.1)), "darker", color.Css(color.Darken(base, 0.1))
end
