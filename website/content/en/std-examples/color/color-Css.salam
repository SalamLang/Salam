import color

func show(text: str):
    mut c := color.Color {}
    if color.Parse(text, c):
        println text
        println "  css   ", color.Css(c)
        println "  source", color.Source(c)
        println "  in sRGB", color.InGamut(c), "same as #f00", color.Equal(c, color.Hex(0xff0000))
    end
end

func main:
    show("red")
    show("rgba(0, 0, 0, 0.25)")
    show("color(display p3, 1, 0, 0)")
    show("color(rec2020, 1, 0, 0)")
    show("current")
end
