import color

func main:
    c := color.Rgba(51, 102, 170, 0.5)
    println "r", c.r, "g", c.g, "b", c.b, "a", c.a, "current", c.current
    wide := color.New(1.093, -0.227, -0.15, 1.0)
    println "wide gamut red keeps channels outside 0 to 1:", wide.r, wide.g
    println "argb", color.Argb(c), "back", color.Css(color.FromArgb(color.Argb(c)))
    println "argb clamps", color.Argb(wide)
end
