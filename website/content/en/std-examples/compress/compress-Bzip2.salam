import compress

func main:
    text := "hello bzip2! hello bzip2! hello bzip2! hello bzip2!"
    z := compress.Bzip2CompressStr(text)
    println compress.BufGet(z, 0), compress.BufGet(z, 1), compress.BufGet(z, 2), compress.BufGet(z, 3)
    mut ok := false
    b := compress.Bzip2DecompressBuf(z, ok)
    println ok, compress.BufToStrUnsafe(b) == text
    src := compress.BufFromStr(text)
    z2 := compress.Bzip2CompressBuf(src)
    z3 := compress.Bzip2Compress(src.data, src.len)
    println compress.BufEquals(z2, z3)
    z4 := compress.Bzip2CompressLevel(src.data, src.len, 1)
    println compress.BufGet(z4, 3)
    back := compress.Bzip2Decompress(z4.data, z4.len, ok)
    println ok, compress.BufEquals(back, src)
    _ := compress.Bzip2Decompress(src.data, src.len, ok)
    println ok
    _ := compress.Bzip2DecompressMax(z.data, z.len, 10, ok)
    println ok
    whole := compress.Bzip2DecompressMax(z.data, z.len, 1000, ok)
    println ok, compress.BufToStrUnsafe(whole) == text
end
