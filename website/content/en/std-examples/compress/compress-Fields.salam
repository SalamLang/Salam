import compress

func main:
    mut b := compress.NewByteBuf()
    compress.BufPushBytes(b, "abc" as void*, 3)
    println b.len, b.cap >= b.len, b.data != null
    mut r := compress.ReaderFromBuf(b)
    println r.len, r.pos, r.bad, r.data == b.data
    _ := compress.RdByte(r)
    println r.pos
    _ := compress.RdBytes(r, 5)
    println r.bad

    mut w := compress.NewBitWriter()
    compress.BitWriteBits(w, 5, 3)
    println w.nbits, w.acc, w.buf.len
    compress.BitFlush(w)
    println w.nbits, w.buf.len
    mut br := compress.BitReaderFromBuf(w.buf)
    println br.len, br.pos, br.nbits, br.acc, br.bad, br.data == w.buf.data
    println compress.BitReadBits(br, 3), br.nbits, br.pos
    _ := compress.BitReadBits(br, 16)
    println br.bad
    compress.BitWriterFree(w)
    compress.BufFree(b)

    methods := [compress.MethodNone, compress.MethodRLE, compress.MethodHuffman, compress.MethodLZ77, compress.MethodLZW, compress.MethodDeflate, compress.MethodBWT]
    each m in methods:
        out := compress.CompressStr(m, "aaaaabbbbbaaaaabbbbb")
        println m, compress.BufToStrUnsafe(compress.Decompress(m, out.data, out.len))
    end
end
