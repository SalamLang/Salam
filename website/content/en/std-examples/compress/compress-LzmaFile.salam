import archive
import compress
import mem
import str

func collect(p: void*, n: int, c: void*): bool:
    compress.BufPushBytes((c as compress.ByteBuf*)[0], p, n)
    ret true
end

func main:
    mut text := compress.NewByteBuf()
    repeat 2000 in i:
        line := "row " + str.FromInt((i * 3) as i64) + "\n"
        compress.BufPushBytes(text, line as void*, line.len())
    end
    packed := compress.LzmaCompress(text.data, text.len)
    archive.WriteBinaryFileBuf("lz.tmp", packed)

    fp := compress.FileOpenRead("lz.tmp")
    got := mem.AllocateZeroed(sizeof(compress.ByteBuf)) as compress.ByteBuf*
    got[0] = compress.NewByteBuf()
    mut sink := compress.SinkCallback(0 as i64, (p: void*, n: int, c: void*): ret collect(p, n, c) end, got as void*)
    st := compress.LzmaFileToSink(packed.data, 5, fp, 13 as i64, (packed.len - 13) as i64, text.len as i64, sink, 0 as i64)
    compress.FileClose(fp)
    println st, sink.written, compress.BufEquals(got[0], text)

    fp2 := compress.FileOpenRead("lz.tmp")
    mut small := compress.SinkCallback(0 as i64, (p: void*, n: int, c: void*): ret collect(p, n, c) end, got as void*)
    println compress.LzmaFileToSink(packed.data, 5, fp2, 13 as i64, (packed.len - 13) as i64, text.len as i64, small, 100 as i64)
    compress.FileClose(fp2)
    compress.BufFree(got[0])
    mem.Free(got as void*)
end
