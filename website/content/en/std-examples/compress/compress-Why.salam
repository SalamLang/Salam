import compress

func name(why: int): str:
    if why == compress.DecodeOk: ret "ok" end
    if why == compress.DecodeTooBig: ret "too big" end
    ret "corrupt"
end

func main:
    raw := compress.BufFromStr("abcabcabcabcabcabcabcabcabcabcabcabc")
    gz := compress.GzipCompress(raw.data, raw.len)
    xz := compress.XzCompress(raw.data, raw.len)
    bz := compress.Bzip2Compress(raw.data, raw.len)
    lz := compress.LzmaCompress(raw.data, raw.len)
    mut why := 0
    _ := compress.GzipDecompressWhy(gz.data, gz.len, 10, why)
    println "gzip", name(why)
    _ := compress.XzDecompressWhy(xz.data, xz.len, 10, why)
    println "xz", name(why)
    _ := compress.Bzip2DecompressWhy(bz.data, bz.len, 10, why)
    println "bzip2", name(why)
    _ := compress.LzmaDecompressWhy(lz.data, lz.len, 10, why)
    println "lzma", name(why)
    back := compress.GzipDecompressWhy(gz.data, gz.len, 0, why)
    println "no limit", name(why), back.len
    _ := compress.GzipDecompressWhy(gz.data, gz.len - 6, 0, why)
    println "cut", name(why)
end
