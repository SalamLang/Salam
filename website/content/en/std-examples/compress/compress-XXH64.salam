import compress
import conv

func main:
    println conv.FormatHex(compress.XXH64Str(""))
    println conv.FormatHex(compress.XXH64Str("abc"))
    text := compress.BufFromStr("Salam")
    println conv.FormatHex(compress.XXH64Buf(text))
    println conv.FormatHex(compress.XXH64(text.data, text.len, 0 as u64))
    println conv.FormatHex(compress.XXH64(text.data, text.len, 1 as u64))
end
