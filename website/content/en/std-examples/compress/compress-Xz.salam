import compress

const XZ := """
fd377a585a000004e6d6b44604c05fcf022101160000000000000000bb0ccf6ce0014e00575d0029984986240afb8a34e4
81db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eba071037cdd425338444ede
4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602aacf40a000005b35fff6fd65c4e300017bcf020000005e9efc
63b1c467fb020000000004595a
"""

const LZMA := """
5d00008000ffffffffffffffff0029984986240afb8a34e481db780958f3d0144436dd3bb4ca45234051fa042e5be57640
2f66b72801fb0f3b421e32e3eba071037cdd425338444ede4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602ad
8d68e0bcfed44dc0
"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func main:
    xz := unhex(XZ)
    lz := unhex(LZMA)
    mut ok := false
    a := compress.XzDecompress(xz.data, xz.len, ok)
    println ".xz:", ok, a.len
    b := compress.XzDecompressBuf(xz, ok)
    println ".xz buffer:", ok, compress.BufEquals(a, b)
    c := compress.XzDecompressMax(xz.data, xz.len, a.len, ok)
    println ".xz with max:", ok, c.len
    d := compress.XzDecompressMax(xz.data, xz.len, a.len - 1, ok)
    println ".xz one byte over max:", ok, d.len
    e := compress.LzmaDecompress(lz.data, lz.len, ok)
    println ".lzma:", ok, compress.BufEquals(a, e)
    f := compress.LzmaDecompressBuf(lz, ok)
    println ".lzma buffer:", ok, f.len
    g := compress.LzmaDecompressMax(lz.data, lz.len, 50, ok)
    println ".lzma with max 50:", ok, g.len
end
