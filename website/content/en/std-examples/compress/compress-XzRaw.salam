import compress
import str

const RAW_LZMA := """
0029984986240afb8a34e481db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eb
a071037cdd425338444ede4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602ad8d68e0bcfed44dc0
"""

const RAW_LZMA2 := """
e0014e00595d0029984986240afb8a34e481db780958f3d0144436994e538c60ac746c02dc278329cadecbb68a986c0818
f3d60fca80edf59196fa1d512909ac7b63cbe3650a7fe9860c6f9bfc85ae148860e1e0b15ff7ea8080b5235108050000
"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.Len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func show(label: str, b: compress.ByteBuf):
    mut line := label
    repeat b.len in i:
        v := compress.BufGet(b, i)
        line += " "
        line += str.FromInt(v as i64)
    end
    println line
end

func main:
    println "dictionary limit:", compress.LzmaMaxDictSize
    props := unhex("5d00000100")
    raw1 := unhex(RAW_LZMA)
    mut ok := false
    a := compress.LzmaRawDecompress(props.data, props.len, raw1.data, raw1.len, 335, 0, ok)
    println "lzma raw:", ok, a.len
    raw2 := unhex(RAW_LZMA2)
    b := compress.Lzma2RawDecompress(16, raw2.data, raw2.len, 335, 0, ok)
    println "lzma2 raw:", ok, compress.BufEquals(a, b)
    c := compress.Lzma2RawDecompress(16, raw2.data, raw2.len, 100, 0, ok)
    println "lzma2 raw, wrong size:", ok, c.len

    call := unhex("e810000000909090")
    show("before", call)
    println compress.BcjDecode(compress.BcjX86, call.data, call.len, 0)
    show("x86   ", call)

    steps := unhex("01010101")
    println compress.DeltaDecode(steps.data, steps.len, 1)
    show("delta ", steps)
    println compress.BcjDecode(99, steps.data, steps.len, 0), compress.DeltaDecode(steps.data, steps.len, 0)
end
