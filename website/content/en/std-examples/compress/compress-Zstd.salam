import compress
import str

func main:
    mut text := compress.NewByteBuf()
    repeat 60 in i:
        line := "entry " + str.FromInt(i * 37 % 101) + ": Salam writes zstd frames\n"
        compress.BufPushBytes(text, line as void*, line.Len())
    end
    packed := compress.ZstdCompress(text.data, text.len)
    println "default level:", packed.len, "bytes from", text.len
    println "is zstd:", compress.IsZstd(packed.data, packed.len), compress.IsZstdBuf(packed), compress.IsZstd(text.data, text.len)
    println "size in the header:", compress.ZstdContentSize(packed.data, packed.len)

    mut ok := false
    back := compress.ZstdDecompress(packed.data, packed.len, ok)
    println "decoded:", ok, compress.BufEquals(back, text)
    back2 := compress.ZstdDecompressBuf(packed, ok)
    println "buffer form:", ok, back2.len

    fast := compress.ZstdCompressLevel(text.data, text.len, 1)
    best := compress.ZstdCompressLevel(text.data, text.len, 19)
    stored := compress.ZstdCompressLevel(text.data, text.len, 0)
    println "levels 1 and 19 smaller than stored:", fast.len < stored.len, best.len < stored.len
    println "stored adds", stored.len - text.len, "bytes of framing"
    plain := compress.ZstdCompressOpts(text.data, text.len, 3, false)
    println "no checksum saves", packed.len - plain.len, "bytes"
    fromstr := compress.ZstdCompressStr("hello hello hello hello")
    fromstr_buf := compress.ZstdCompressBuf(text)
    println "string and buffer forms:", fromstr.len, fromstr_buf.len

    mut status := 0
    capped := compress.ZstdDecompressEx(packed.data, packed.len, 100, null, 0, status)
    println "capped at 100:", status, compress.ZstdStatusText(status), capped.len
    limit := compress.ZstdDecompressMax(packed.data, packed.len, text.len, ok)
    println "capped at the exact size:", ok, limit.len
    bad := compress.BufFromStr("not a zstd stream")
    nope := compress.ZstdDecompressEx(bad.data, bad.len, 0, null, 0, status)
    println "garbage:", status, compress.ZstdStatusText(status), nope.len
    println "codes:", compress.ZstdOk, compress.ZstdErrFormat, compress.ZstdErrTruncated, compress.ZstdErrCorrupt, compress.ZstdErrChecksum, compress.ZstdErrTooBig, compress.ZstdErrDict
end
