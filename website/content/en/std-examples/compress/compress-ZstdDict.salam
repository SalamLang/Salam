import compress

const FRAME := """
28b52ffd645900ed010092430c11a0ed7425bfff01a825dda80e11a94a1c014020bd51a7cf6fcc41d92e1f9a01043a9c
4edf68a4ea1867b8bed41b6e2a240200f7874039c1d515ee20b3a1
"""

func nib(c: int): int:
    if c >= 48 and c <= 57:
        ret c - 48
    end
    if c >= 97 and c <= 102:
        ret c - 87
    end
    ret -1
end

func unhex(s: str): compress.ByteBuf:
    mut b := compress.NewByteBuf()
    bp := s as u8*
    mut hi := -1
    repeat s.len() in i:
        v := nib(bp[i] as int)
        if v < 0:
            continue
        end
        if hi < 0:
            hi = v
        else:
            compress.BufPush(b, hi * 16 + v)
            hi = -1
        end
    end
    ret b
end

func main:
    frame := unhex(FRAME)
    dict := compress.BufFromStr("Salam is a programming language. ")
    mut status := 0
    without := compress.ZstdDecompressEx(frame.data, frame.len, 0, null, 0, status)
    println "without the dictionary:", status, compress.ZstdStatusText(status), without.len
    mut ok := false
    text := compress.ZstdDecompressDict(frame.data, frame.len, dict.data, dict.len, ok)
    println "with the dictionary:", ok, text.len, "bytes from", frame.len
    println compress.BufToStrUnsafe(text)
    other := compress.BufFromStr("some other bytes")
    wrong := compress.ZstdDecompressEx(frame.data, frame.len, 0, other.data, other.len, status)
    println "with a different dictionary:", status, wrong.len
end
