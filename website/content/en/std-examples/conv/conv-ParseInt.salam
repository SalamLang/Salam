import conv

func main throws:
    println try conv.ParseInt("  -۲۷ "), try conv.ParseInt("-27")
    println try conv.Atoi("+15")
    println try conv.ParseHex("0xff"), try conv.ParseHex("1A")
    println try conv.ParseBool("yes"), try conv.ParseBool(" off ")
    try:
        _ := conv.ParseInt("12abc")
    catch e:
        println e.kind_name(), e.code, e.column, e.ToStr()
    end
    try:
        _ := conv.Atoi("3000000000")
    catch e:
        println e.is(ErrorKind.OutOfRange), e.message
    end
end
