import conv

func main:
    println conv.ParseIntOr("12abc", 0), conv.ParseIntOr(" ۴۲ ", 0)
    println conv.AtoiOr("", 8080), conv.AtoiOr("443", 8080)
    println conv.ParseFloatOr("n/a", 0.5), conv.ParseFloatOr("۱٫۲۵", 0.5)
    println conv.ParseBoolOr("True", false), conv.ParseBoolOr("on", false)
    println conv.ParseHexOr("#fff", 0 - 1), conv.ParseHexOr("ff", 0 - 1)
end
