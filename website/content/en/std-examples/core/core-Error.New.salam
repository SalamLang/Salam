func find user(id: int): str throws:
    if id != 1:
        throw Error.New(ErrorKind.NotFound, "no user with id " + id)
    end
    ret "Sara"
end

func main:
    each id in [1, 7]:
        try:
            println "found", find user(id)
        catch e:
            println e.kind_name() + ":", e.message
        end
    end
end
