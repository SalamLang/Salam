func main:
    plain := Error.New(ErrorKind.Timeout, "the server did not answer")
    println plain.ToStr()
    bare := Error.New(ErrorKind.NotFound, "")
    println bare.ToStr()
    located := Error.New(
        ErrorKind.Syntax, "a comma is missing"
    ).WithPath("$.items[2]").WithPosition(40, 3, 9)
    println located.ToStr()
    wrapped := located.Wrap("reading the order").Wrap("handling the request")
    println wrapped.ToStr()
end
