func parse_age(text: str): int throw:
    if text == "":
        throw Error.New(ErrorKind.MissingKey, "the age is missing")
    end
    n := text.ToInt()
    if n < 0 or n > 150:
        throw Error.New(ErrorKind.OutOfRange, "the age " + n + " is out of range").WithCode("age.range")
    end
    ret n
end

func main:
    each text in ["42", "", "200"]:
        try:
            println "age", parse_age(text)
        catch e:
            println e.KindName() + ":", e.message
            println "  code:", e.code, "| out of range:", e.Is(ErrorKind.OutOfRange)
        end
    end
    e := Error.At(ErrorKind.Syntax, "expected a digit", 4).WithPath("$.age")
    println e.ToStr()
    placed := e.WithPosition(4, 2, 3).Wrap("reading the form")
    println placed.ToStr()
    println placed.offset, placed.line, placed.column, placed.context
end
