func main:
    plain := Error.New(ErrorKind.Timeout, "the server did not answer")
    println plain.to_str()
    bare := Error.New(ErrorKind.NotFound, "")
    println bare.to_str()
    located := Error.New(ErrorKind.Syntax, "a comma is missing").with_path("$.items[2]").with_position(40, 3, 9)
    println located.to_str()
    wrapped := located.wrap("reading the order").wrap("handling the request")
    println wrapped.to_str()
end
