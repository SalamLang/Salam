func parse age(text: str): int throws:
    n := text.to_int()
    if n < 0 or n > 150:
        throw Error.New(ErrorKind.OutOfRange, "the age " + n + " is out of range").with_code("age.range")
    end
    ret n
end

func main:
    each text in ["30", "200"]:
        try:
            println "age", parse age(text)
        catch e:
            if e.code == "age.range":
                println "ask again:", e.message
            end
            println "code:", e.code
        end
    end
end
