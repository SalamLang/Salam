func check(user: str, age: int): int throws:
    if age < 18:
        throw Error.New(ErrorKind.OutOfRange, "must be at least 18").with_path("$.users[" + user + "].age")
    end
    ret age
end

func main:
    try:
        println check("sara", 31)
        println check("omid", 12)
    catch e:
        println e.to_str()
        println "where:", e.path
    end
end
