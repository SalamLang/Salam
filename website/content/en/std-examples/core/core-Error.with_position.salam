func main:
    text := "name = Sara\nage = ?\n"
    offset := text.find("?")
    line start := text.find("age")
    column := offset - line start + 1
    e := Error.New(ErrorKind.Syntax, "a number was expected").with_position(offset, 2, column)
    println e.to_str()
    println e.offset, e.line, e.column
end
