func read_port(text: str): int throw:
    n := text.ToInt()
    if n < 1 or n > 65535:
        throw Error.New(ErrorKind.OutOfRange, "port " + n + " is not valid")
    end
    ret n
end

func load_config(text: str): int throw:
    try:
        ret read_port(text)
    catch e:
        throw e.Wrap("reading the port")
    end
end

func main:
    try:
        println load_config("80")
        println load_config("70000")
    catch e:
        println e.ToStr()
        println "context:", e.context
        println "kind:", e.KindName()
    end
end
