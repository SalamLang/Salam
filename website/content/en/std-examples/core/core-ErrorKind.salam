func retryable(e: Error): bool:
    ret e.Is(ErrorKind.Io) or e.Is(ErrorKind.Timeout) or e.Is(ErrorKind.Unavailable)
end

func main:
    kinds := [
        ErrorKind.Io, ErrorKind.Timeout, ErrorKind.Unavailable, ErrorKind.NotFound, ErrorKind.PermissionDenied,
        ErrorKind.Internal
    ]
    each kind in kinds:
        e := Error.New(kind, "failed")
        if retryable(e):
            println e.KindName() + ": try again"
        else:
            println e.KindName() + ": give up"
        end
    end
end
