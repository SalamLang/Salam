import data
import matrix

func main throws:
    text := "age,city,score,ok\n30,tehran,1.5,1\n25,shiraz,2.5,0\n41,tehran,3.0,1\n"
    mut t := try data.LoadCsv(text, true)
    println t.rows(), t.cols(), t.names, t.ColIndex("score"), t.ColIndex("x")
    println t.kinds[0] == data.COL_INT, t.kinds[1] == data.COL_CAT, t.kinds[2] == data.COL_FLOAT, data.COL_STR
    println t.CatLevels("city")
    mut m := t.ToMatrix()
    println m.rows, m.cols, m.at(2, 1)
    mut x := matrix.Matrix {}
    mut y := matrix.Matrix {}
    println t.SplitXy("ok", x, y), x.cols, y.at(1, 0)
    try:
        data.LoadCsvFile("missing.csv", true)
    catch e:
        println e.kind_name(), e.path
    end
    matrix.Free(m)
    matrix.Free(x)
    matrix.Free(y)
    t.Free()
end
