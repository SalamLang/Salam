import db.clickhouse

func main:
    mut args := Vector {} as Vector<str>
    args.Push(clickhouse.IntArg(7 as i64))
    args.Push(clickhouse.StrArg("it's"))
    println clickhouse.Bind("SELECT ? AS id, ? AS name", args)

    t := "LowCardinality(Nullable(String))"
    println clickhouse.BaseType(t), clickhouse.IsNullableType(t)
    println clickhouse.TypeKind("Array(Int32)") == clickhouse.KIND_ARRAY
    println clickhouse.ElementType("Array(Nullable(Int32))")
    println clickhouse.KIND_OTHER, clickhouse.KIND_INT, clickhouse.KIND_UINT, clickhouse.KIND_FLOAT, clickhouse.KIND_DECIMAL, clickhouse.KIND_STRING
    println clickhouse.KIND_BOOL, clickhouse.KIND_DATE, clickhouse.KIND_DATETIME, clickhouse.KIND_MAP, clickhouse.KIND_TUPLE
end
