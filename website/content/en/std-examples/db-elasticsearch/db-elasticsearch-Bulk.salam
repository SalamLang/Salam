import str
import db.elasticsearch

func main:
    c := elasticsearch.Connect("http://localhost:9200")
    mut b := elasticsearch.NewBulk()
    repeat 1000 in i:
        id := str.FromInt(i as i64)
        elasticsearch.BulkIndex(b, "logs", id, `{"line":` + id + `,"level":"info"}`)
    end
    elasticsearch.BulkUpdate(b, "logs", "7", `{"level":"warn"}`)
    elasticsearch.BulkUpsert(b, "logs", "new", `{"line":-1}`)
    elasticsearch.BulkDelete(b, "logs", "8")
    println elasticsearch.BulkLen(b)
    res := elasticsearch.RunBulkWith(c, "", b, elasticsearch.Options { refresh = elasticsearch.REFRESH_TRUE })
    println res.ok, res.succeeded, res.failed, res.took
    if res.errors:
        each it in res.items:
            if not it.ok: println it.action, it.id, it.status, it.error_type, it.error_reason end
        end
    end
    elasticsearch.BulkReset(b)
end
