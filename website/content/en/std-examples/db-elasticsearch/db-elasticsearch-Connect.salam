import db.elasticsearch

func main:
    println elasticsearch.EncodeBasic("elastic", "s3cret")
    println elasticsearch.DecodeCloudId("prod:ZXVyb3BlLmNsb3VkLmVzLmlvJGFiYyRkZWY=")

    basic := elasticsearch.ConnectAuth("https://localhost:9200", "elastic", "s3cret")
    println elasticsearch.AuthHeader(basic)
    keyed := elasticsearch.ConnectApiKey("https://localhost:9200", "VnVhQ2ZHY0JDZGJrUW0tZTVhT3g6dWkybHAyYXhUTm1zeWFrdzl0dk5ndw==")
    println elasticsearch.AuthHeader(keyed)
    cloud := elasticsearch.ConnectCloud("prod:ZXVyb3BlLmNsb3VkLmVzLmlvJGFiYyRkZWY=", "key")
    println elasticsearch.Ok(cloud)

    c := elasticsearch.Connect("http://localhost:9200")
    if not elasticsearch.Ok(c):
        println elasticsearch.Status(c), elasticsearch.ErrorReason(c)
    end
    println elasticsearch.Distribution(c)
    println elasticsearch.Nodes(c)
    println elasticsearch.NodesInfo(c)
    println elasticsearch.ClusterStats(c)
    println elasticsearch.WaitForStatus(c, "yellow", "30s").status

    r := elasticsearch.PerformNdjson(c, "POST", "/_bulk", `{"delete":{"_index":"books","_id":"1"}}` + "\n")
    println r.status
end
