import db.elasticsearch

func main:
    c := elasticsearch.Connect("http://localhost:9200")
    opts := elasticsearch.Options { refresh = elasticsearch.REFRESH_TRUE }

    println elasticsearch.Index(c, "books", "1", `{"title":"Shahnameh","year":1010}`).result
    println elasticsearch.CreateWith(c, "books", "2", `{"title":"Masnavi","year":1258}`, opts).result
    println elasticsearch.Upsert(c, "books", "3", `{"title":"Divan","year":1368}`).result
    println elasticsearch.Update(c, "books", "3", `{"year":1369}`).result

    println elasticsearch.GetSource(c, "books", "1")
    d := elasticsearch.GetWith(c, "books", "2", elasticsearch.Options { routing = "poetry" })
    println d.found, d.id
    mut ids := Vector {} as Vector<str>
    ids.push("1")
    ids.push("2")
    ids.push("3")
    each doc in elasticsearch.MGet(c, "books", ids):
        println doc.id, doc.found
    end

    updated := elasticsearch.UpdateByQuery(c, "books", elasticsearch.Term("year", "1010"), elasticsearch.Script("ctx._source.year += 1", ""))
    println updated
    also := elasticsearch.UpdateByQueryWith(c, "books", elasticsearch.MatchAll(), elasticsearch.Script("ctx._source.seen = true", ""), opts)
    println also

    println elasticsearch.Reindex(c, "books", "books_v2")

    println elasticsearch.DeleteWith(c, "books", "1", opts).result
    println elasticsearch.DeleteByQueryWith(c, "books", elasticsearch.Term("year", "1369"), opts)
end
