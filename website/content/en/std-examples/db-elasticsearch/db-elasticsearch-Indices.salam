import db.elasticsearch

func main:
    c := elasticsearch.Connect("http://localhost:9200")

    elasticsearch.CreateIndex(c, "books_v1", `{"settings":{"number_of_shards":1}}`)
    println elasticsearch.GetIndex(c, "books_v1")
    println elasticsearch.GetMapping(c, "books_v1")
    elasticsearch.PutMapping(c, "books_v1", `{"properties":{"author":{"type":"keyword"}}}`)
    println elasticsearch.GetSettings(c, "books_v1")
    elasticsearch.PutSettings(c, "books_v1", `{"index":{"refresh_interval":"5s"}}`)

    each info in elasticsearch.CatIndices(c, "books*"):
        println info.index, info.docs_count, info.health
    end

    elasticsearch.PutAlias(c, "books_v1", "books")
    println elasticsearch.AliasExists(c, "books"), elasticsearch.GetAlias(c, "books")
    elasticsearch.CreateIndex(c, "books_v2", "")
    elasticsearch.SwapAlias(c, "books", "books_v1", "books_v2")
    elasticsearch.UpdateAliases(c, `{"actions":[{"add":{"index":"books_v2","alias":"latest"}}]}`)
    elasticsearch.DeleteAlias(c, "books_v2", "latest")

    elasticsearch.PutIndexTemplate(c, "books_tpl", `{"index_patterns":["books-*"],"priority":100}`)
    println elasticsearch.IndexTemplateExists(c, "books_tpl")
    elasticsearch.DeleteIndexTemplate(c, "books_tpl")

    elasticsearch.Refresh(c, "books_v2")
    elasticsearch.Flush(c, "books_v2")
    elasticsearch.ForceMerge(c, "books_v2", 1)
    elasticsearch.CloseIndex(c, "books_v2")
    elasticsearch.OpenIndex(c, "books_v2")
    println elasticsearch.Analyze(c, "books_v2", "standard", "The Book of Kings")
    println elasticsearch.IndexStats(c, "books_v2")

    elasticsearch.DeleteIndex(c, "books_v1")
    elasticsearch.DeleteIndex(c, "books_v2")
end
