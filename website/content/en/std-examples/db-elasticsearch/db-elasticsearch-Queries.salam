import db.elasticsearch

func main:
    c := elasticsearch.Connect("http://localhost:9200")

    mut words := Vector {} as Vector<str>
    words.Push("poetry")
    words.Push("history")
    mut fields := Vector {} as Vector<str>
    fields.Push("title")
    fields.Push("summary")
    mut ids := Vector {} as Vector<str>
    ids.Push("1")
    ids.Push("2")

    mut must := Vector {} as Vector<str>
    must.Push(elasticsearch.MatchAnd("title", "persian poetry"))
    must.Push(elasticsearch.MatchFuzzy("title", "shahnama"))
    must.Push(elasticsearch.MatchPhrase("summary", "book of kings"))
    must.Push(elasticsearch.MatchPhrasePrefix("summary", "book of"))
    must.Push(elasticsearch.MultiMatch("kings", fields))
    mut filter := Vector {} as Vector<str>
    filter.Push(elasticsearch.TermInt("year", 1010 as i64))
    filter.Push(elasticsearch.TermBool("published", true))
    filter.Push(elasticsearch.Terms("tag", words))
    filter.Push(elasticsearch.RangeExclusive("year", "900", "1500"))
    filter.Push(elasticsearch.FieldExists("author"))
    filter.Push(elasticsearch.Ids(ids))
    filter.Push(elasticsearch.Nested("reviews", elasticsearch.Term("reviews.stars", "5")))
    filter.Push(elasticsearch.GeoDistance("place", 36.2, 59.6, "50km"))
    mut should := Vector {} as Vector<str>
    should.Push(elasticsearch.Prefix("author", "fer"))
    should.Push(elasticsearch.Wildcard("author", "f*si"))
    should.Push(elasticsearch.Regexp("author", "fer.*"))
    should.Push(elasticsearch.Fuzzy("author", "ferdowsy"))
    should.Push(elasticsearch.QueryString("title:shah* AND year:[900 TO 1500]"))
    should.Push(elasticsearch.SimpleQueryString("epic | lyric", fields))
    mut none := Vector {} as Vector<str>
    none.Push(elasticsearch.MatchNone())

    query := elasticsearch.Bool(must, filter, should, none)
    println elasticsearch.Or(should)
    println elasticsearch.ConstantScore(elasticsearch.FieldExists("author"))

    mut vector := Vector {} as Vector<f64>
    vector.Push(0.1)
    vector.Push(0.9)
    println elasticsearch.Knn("embedding", vector, 5, 50)

    mut aggs := elasticsearch.AddAgg("", "authors", elasticsearch.CardinalityAgg("author"))
    aggs = elasticsearch.AddAgg(aggs, "first", elasticsearch.MinAgg("year"))
    aggs = elasticsearch.AddAgg(aggs, "total", elasticsearch.SumAgg("pages"))
    aggs = elasticsearch.AddAgg(aggs, "pages", elasticsearch.StatsAgg("pages"))
    aggs = elasticsearch.AddAgg(aggs, "values", elasticsearch.ValueCountAgg("year"))
    aggs = elasticsearch.AddAgg(aggs, "by_century", elasticsearch.HistogramAgg("year", 100.0))
    aggs = elasticsearch.AddAgg(aggs, "by_month", elasticsearch.DateHistogramAgg("added", "month"))
    aggs = elasticsearch.AddAgg(aggs, "drafts", elasticsearch.FilterAgg(elasticsearch.Term("status", "draft")))
    aggs = elasticsearch.AddAgg(aggs, "latest", elasticsearch.TopHitsAgg(3))

    mut sort := Vector {} as Vector<str>
    sort.Push(elasticsearch.SortAsc("year"))
    req := elasticsearch.SearchRequest { query = query, size = 20, sort = sort, aggs = aggs }
    body := elasticsearch.SearchBody(req)
    println body
    println elasticsearch.AddMember(body, "track_total_hits", "true")

    res := elasticsearch.SearchRaw(c, "books", body)
    if not res.ok:
        println elasticsearch.Error(c)
        ret
    end
    println res.total, elasticsearch.AggRaw(res, "pages")
    each b in elasticsearch.AggBucketsIn(elasticsearch.AggRaw(res, "by_century"), "buckets"):
        println b.key, b.doc_count
    end

    quick := elasticsearch.SearchQuery(c, "books", elasticsearch.MatchAll(), 5)
    println quick.total

    mut bodies := Vector {} as Vector<str>
    bodies.Push(`{"query":` + elasticsearch.Match("title", "shahnameh") + `}`)
    bodies.Push(`{"query":` + elasticsearch.Prefix("author", "fer") + `}`)
    each r in elasticsearch.MSearch(c, "books", bodies):
        println r.ok, r.total
    end

    parsed := elasticsearch.ParseSearchResult(`{"took":1,"hits":{"total":{"value":0,"relation":"eq"},"hits":[]}}`)
    println parsed.total
end
