import db
import db.elasticsearch

func report(conn: dyn db.Connection):
    rows := conn.Query("SELECT level, COUNT(*) AS n FROM logs GROUP BY level")
    until rows.Next():
        println rows.Text(0), rows.Int(1)
    end
    rows.Close()
end

func main:
    c := elasticsearch.Connect("http://localhost:9200")
    mut params := Vector {} as Vector<str>
    params.push("100")
    mut rows := elasticsearch.SqlWith(c, "SELECT line, level FROM logs WHERE line < ? ORDER BY line", params, 50)
    println rows.ColumnCount(), rows.ColumnName(0), rows.ColumnTypeName(0), rows.ColumnType(0) == db.TYPE_INT
    until rows.Next():
        println rows.Int64(0), rows.Text(1), rows.IsNull(1)
    end
    rows.Close()
    print elasticsearch.SqlText(c, "SELECT level FROM logs LIMIT 3")
    println elasticsearch.SqlTranslate(c, "SELECT line FROM logs WHERE level = 'warn'")
    report(elasticsearch.Conn(c))
end
