import db.meilisearch

func main:
    c := meilisearch.New("http://127.0.0.1:7700", "masterKey")
    mut err := meilisearch.Error {}
    meilisearch.UpdateExperimentalFeatures(c, `{"chatCompletions": true}`, err)

    settings := `{"source": "openAi", "apiKey": "sk-your-key", "prompts": {"system": "You answer questions about our movie catalog."}}`
    println meilisearch.UpdateChatSettings(c, "support", settings, err)
    println meilisearch.GetChatSettings(c, "support", err)
    ws := meilisearch.ListChatWorkspaces(c, 0, 20, err)
    println ws.total, ws.offset, ws.limit
    each name in ws.results:
        println name, meilisearch.GetChatWorkspace(c, name, err)
    end

    request := `{"model": "gpt-4o-mini", "stream": true, "messages": [{"role": "user", "content": "Which space movies do you have?"}]}`
    println meilisearch.ChatCompletion(c, "support", request, err)
    if not meilisearch.Ok(err):
        println meilisearch.ErrorString(err)
    end
    println meilisearch.ResetChatSettings(c, "support", err)
    println meilisearch.DeleteChatWorkspace(c, "support", err)
end
