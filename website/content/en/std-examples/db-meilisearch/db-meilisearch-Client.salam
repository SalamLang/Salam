import db.meilisearch

func main:
    c := meilisearch.WithAgent(meilisearch.New("http://127.0.0.1:7700", "masterKey"), "my-app/1.0")
    mut err := meilisearch.Error {}
    if not meilisearch.IsHealthy(c):
        println "Meilisearch is not reachable at " + c.host
        ret
    end
    println meilisearch.Health(c, err), meilisearch.VERSION

    v := meilisearch.GetVersion(c, err)
    println v.pkg_version, v.commit_sha, v.commit_date
    st := meilisearch.GetStats(c, err)
    println st.database_size, st.used_database_size, st.last_update, st.indexes

    dump := meilisearch.CreateDump(c, err)
    println dump.task_uid, meilisearch.CreateSnapshot(c, err).status
    println meilisearch.GetExperimentalFeatures(c, err)
    println meilisearch.UpdateExperimentalFeatures(c, `{"metrics": true}`, err)
    println meilisearch.GetMetrics(c, err).len()
    println meilisearch.GetNetwork(c, err)
    println meilisearch.UpdateNetwork(c, `{"self": "ms-0"}`, err)
    println meilisearch.Export(c, `{"url": "http://backup:7700", "apiKey": "key"}`, err).kind

    body := meilisearch.Request(c, "GET", "/indexes?limit=1", "", err)
    if not meilisearch.Ok(err):
        println meilisearch.ErrorString(err)
        println err.status, err.code, err.kind, err.message, err.link
        ret
    end
    println body
    println meilisearch.RequestAs(c, "POST", "/indexes/movies/documents", "application/x-ndjson", "{\"id\": 1}\n", err)
    p := meilisearch.Page {}
    println p.results.len(), p.offset, p.limit, p.total, p.from, p.next, c.api_key.len() > 0, c.agent

    quick := meilisearch.WithTimeout(c, 2000)
    println quick.timeout_ms, meilisearch.IsHealthy(quick)
    tagged := meilisearch.WithMetadata(c, "nightly-import")
    println tagged.metadata
    println meilisearch.SetStderrLogs(c, "info", err)
    println meilisearch.RenderTemplate(c, `{"template": {"kind": "inlineDocumentTemplate", "inline": "{{doc.title}}"}, "input": {"kind": "inlineDocument", "inline": {"title": "Up"}}}`, err)
    println meilisearch.NetworkControl(c, `{"origin": {"remoteName": "ms-0", "taskUid": 1}, "message": {"type": "exportNoIndexForRemote", "remote": "ms-1"}}`, err)
end
