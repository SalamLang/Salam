import db.meilisearch
import time

func main:
    admin := meilisearch.New("http://127.0.0.1:7700", "masterKey")
    mut err := meilisearch.Error {}

    mut r := meilisearch.KeyRequest { name = "Front end search", description = "Used by the web app", expires_at = "2030-01-01T00:00:00Z", uid = "" }
    r.actions.push("search")
    r.indexes.push("movies")
    k := meilisearch.CreateKey(admin, r, err)
    if not meilisearch.Ok(err):
        println meilisearch.ErrorString(err)
        ret
    end
    println k.uid, k.key, k.name, k.description, k.expires_at, k.created_at, k.updated_at
    println k.actions.len(), k.indexes.len()

    println meilisearch.GetKey(admin, k.uid, err).name
    page := meilisearch.GetKeys(admin, 0, 20, err)
    println page.total, page.offset, page.limit
    each one in page.results:
        println one.name
    end
    println meilisearch.UpdateKey(admin, k.uid, "Web search", "Search only, movies only", err).name

    rules := `{"movies": {"filter": "user_id = 42"}}`
    token := meilisearch.TenantToken(k.uid, k.key, rules, time.Now() + 3600, err)
    user := meilisearch.New("http://127.0.0.1:7700", token)
    println meilisearch.Query(user, "movies", "", err).hits.len()

    println meilisearch.DeleteKey(admin, k.uid, err)
end
