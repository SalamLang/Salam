import db.meilisearch

func main:
    c := meilisearch.New("http://127.0.0.1:7700", "masterKey")
    mut err := meilisearch.Error {}

    hook := meilisearch.CreateWebhook(c, "https://example.com/meilisearch-hook", `{"Authorization": "Bearer hook-secret"}`, err)
    if not meilisearch.Ok(err):
        println meilisearch.ErrorString(err)
        ret
    end
    println hook.uuid, hook.url, hook.headers, hook.is_editable
    println meilisearch.GetWebhook(c, hook.uuid, err).url
    println meilisearch.UpdateWebhook(c, hook.uuid, "https://example.com/v2/hook", "", err).url
    each w in meilisearch.ListWebhooks(c, err):
        println w.uuid, w.url
    end
    println meilisearch.DeleteWebhook(c, hook.uuid, err)
end
