import db.meilisearch

func main:
    c := meilisearch.New("http://127.0.0.1:7700", "masterKey")
    mut err := meilisearch.Error {}

    info := meilisearch.DeleteIndex(c, "old_movies", err)
    t := meilisearch.WaitForTask(c, info.task_uid, 30000, 100, err)
    println t.uid, t.batch_uid, t.index_uid, t.status, t.kind, t.canceled_by, t.details, t.duration
    println t.enqueued_at, t.started_at, t.finished_at
    if t.status == meilisearch.STATUS_FAILED:
        println t.error.code, t.error.message
    end
    println meilisearch.GetTask(c, info.task_uid, err).status

    mut q := meilisearch.TaskQuery { limit = 20, from = -1, reverse = true, after_enqueued_at = "2025-01-01T00:00:00Z" }
    q.statuses.push(meilisearch.STATUS_SUCCEEDED)
    q.statuses.push(meilisearch.STATUS_FAILED)
    q.index_uids.push("movies")
    q.types.push("documentAdditionOrUpdate")
    q.uids.push(1)
    q.batch_uids.push(1)
    q.canceled_by.push(2)
    q.before_enqueued_at = "2030-01-01T00:00:00Z"
    q.before_started_at = "2030-01-01T00:00:00Z"
    q.after_started_at = "2025-01-01T00:00:00Z"
    q.before_finished_at = "2030-01-01T00:00:00Z"
    q.after_finished_at = "2025-01-01T00:00:00Z"
    page := meilisearch.GetTasks(c, q, err)
    println page.total, page.limit, page.from, page.next
    each task in page.results:
        println task.uid, task.kind, task.status
    end

    mut pending := meilisearch.TaskQuery {}
    pending.statuses.push(meilisearch.STATUS_ENQUEUED)
    pending.statuses.push(meilisearch.STATUS_PROCESSING)
    println meilisearch.CancelTasks(c, pending, err).task_uid
    mut finished := meilisearch.TaskQuery {}
    finished.statuses.push(meilisearch.STATUS_CANCELED)
    println meilisearch.DeleteTasks(c, finished, err).task_uid

    batches := meilisearch.GetBatches(c, meilisearch.TaskQuery { limit = 5 }, err)
    println batches.total, batches.limit, batches.from, batches.next
    each b in batches.results:
        one := meilisearch.GetBatch(c, b.uid, err)
        println one.uid, one.batch_strategy, one.details, one.stats, one.progress, one.duration, one.started_at, one.finished_at
    end

    println t.custom_metadata, t.network, info.custom_metadata
    println meilisearch.GetTaskDocuments(c, info.task_uid, err)
    comp := meilisearch.CompactTasks(c, err)
    println comp.status, comp.pre_size, comp.post_size, comp.action_required, comp.error_message
end
