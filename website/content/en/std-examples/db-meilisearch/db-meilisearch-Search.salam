import db.meilisearch

struct Movie:
    pub id: int = 0
    pub title: str = ""
end

func main:
    c := meilisearch.New("http://127.0.0.1:7700", "searchKey")
    mut err := meilisearch.Error {}

    quick := meilisearch.Query(c, "movies", "botman", err)
    println quick.query, quick.estimated_total_hits, quick.processing_time_ms

    mut r := meilisearch.SearchRequest { query = "space", limit = 10, offset = 0, filter = "year > 2000 AND genre = Drama" }
    r.facets.push("genre")
    r.sort.push("year:desc")
    r.attributes_to_retrieve.push("id")
    r.attributes_to_retrieve.push("title")
    r.attributes_to_highlight.push("title")
    r.highlight_pre_tag = "<mark>"
    r.highlight_post_tag = "</mark>"
    r.attributes_to_crop.push("overview")
    r.crop_length = 20
    r.crop_marker = "..."
    r.matching_strategy = meilisearch.MATCH_ALL
    r.show_ranking_score = true
    r.show_ranking_score_details = false
    r.show_matches_position = false
    r.ranking_score_threshold = 0.2
    r.attributes_to_search_on.push("title")
    r.locales.push("eng")
    r.distinct = "studio"
    res := meilisearch.Search(c, "movies", r, err)
    if not meilisearch.Ok(err):
        println meilisearch.ErrorString(err)
        ret
    end
    println res.index_uid, res.offset, res.limit, res.facet_distribution, res.facet_stats, res.raw.len()
    each hit in res.hits:
        println hit
    end
    mut movies := Vector {} as Vector<Movie>
    if meilisearch.HitsAs(res, movies, err):
        println movies.len()
    end

    pages := meilisearch.Search(c, "movies", meilisearch.SearchRequest { query = "space", page = 2, hits_per_page = 20 }, err)
    println pages.page, pages.hits_per_page, pages.total_hits, pages.total_pages

    mut hybrid := meilisearch.SearchRequest { query = "a sad robot", hybrid_embedder = "default", hybrid_semantic_ratio = 0.7, retrieve_vectors = false, matching_strategy = meilisearch.MATCH_LAST }
    hybrid.vector.push(0.1)
    hybrid.media = `{"image": "https://example.com/robot.png"}`
    hybrid.extra = `{"showPerformanceDetails": true}`
    println meilisearch.Search(c, "movies", hybrid, err).semantic_hit_count, meilisearch.MATCH_FREQUENCY

    mut queries := Vector {} as Vector<meilisearch.MultiQuery>
    queries.push(meilisearch.MultiQuery { index_uid = "movies", request = meilisearch.SearchRequest { query = "moana" } })
    queries.push(meilisearch.MultiQuery { index_uid = "books", request = meilisearch.SearchRequest { query = "moana" }, weight = 0.5, remote = "" })
    each one in meilisearch.MultiSearch(c, queries, err):
        println one.index_uid, one.hits.len()
    end
    fed := meilisearch.FederatedSearch(c, queries, meilisearch.Federation { offset = 0, limit = 20, page = -1, hits_per_page = -1, facets_by_index = `{"movies": ["genre"]}`, merge_facets = `{}` }, err)
    println fed.hits.len()

    mut fr := meilisearch.FacetSearchRequest { facet_name = "genre", facet_query = "dra", query = "space", filter = "year > 2000", matching_strategy = meilisearch.MATCH_ALL, exhaustive_facet_count = true }
    fr.attributes_to_search_on.push("title")
    fs := meilisearch.FacetSearch(c, "movies", fr, err)
    println fs.facet_query, fs.processing_time_ms
    each h in fs.hits:
        println h.value, h.count
    end

    mut sr := meilisearch.SimilarRequest { id = "143", embedder = "default", limit = 5, offset = 0, filter = "year > 2000", show_ranking_score = true, show_ranking_score_details = false, ranking_score_threshold = 0.5, retrieve_vectors = false }
    sr.attributes_to_retrieve.push("title")
    println meilisearch.SimilarDocuments(c, "movies", sr, err).hits.len()

    mut more := meilisearch.SearchRequest { query = "space", show_performance_details = true, use_network = false, personalize = `{"userContext": "likes old films"}`, inline_rule = `{"actions": {"pin": [{"id": "1", "position": 0}]}}` }
    more.locales.push("eng")
    detailed := meilisearch.Search(c, "movies", more, err)
    println detailed.request_uid, detailed.performance_details, detailed.query_vector, detailed.remote_errors, detailed.metadata, detailed.facets_by_index
    mut fq := meilisearch.FacetSearchRequest { facet_name = "genre", ranking_score_threshold = 0.1, hybrid_embedder = "default", hybrid_semantic_ratio = 0.5, media = "", use_network = false }
    fq.locales.push("eng")
    fq.vector.push(0.2)
    println meilisearch.FacetSearch(c, "movies", fq, err).remote_errors
    mut posq := Vector {} as Vector<meilisearch.MultiQuery>
    posq.push(meilisearch.MultiQuery { index_uid = "movies", request = meilisearch.SearchRequest { query = "up" }, query_position = 0 })
    println meilisearch.FederatedSearch(c, posq, meilisearch.Federation { distinct = "studio", personalize = "", show_performance_details = true }, err).hits.len()
    println meilisearch.SimilarDocuments(c, "movies", meilisearch.SimilarRequest { id = "1", embedder = "default", show_performance_details = true }, err).hits.len()
end
