import db.meilisearch

func main:
    c := meilisearch.New("http://127.0.0.1:7700", "masterKey")
    mut err := meilisearch.Error {}
    meilisearch.UpdateExperimentalFeatures(c, `{"dynamicSearchRules": true}`, err)

    rule := `{"active": true, "precedence": 1, "conditions": {"query": {"words": "sale"}}, "actions": {"pin": [{"id": "42", "position": 0}]}}`
    meilisearch.Wait(c, meilisearch.UpdateSearchRule(c, "black-friday", rule, err), err)
    r := meilisearch.GetSearchRule(c, "black-friday", err)
    println r.uid, r.active, r.precedence, r.last_updated_at, r.conditions, r.actions, r.raw.len()

    page := meilisearch.ListSearchRules(c, meilisearch.SearchRuleQuery { offset = 0, limit = 20, query = "sale", active = 1 }, err)
    println page.total, page.offset, page.limit
    each one in page.results:
        println one.uid
    end
    meilisearch.Wait(c, meilisearch.DeleteSearchRule(c, "black-friday", err), err)
    meilisearch.Wait(c, meilisearch.DeleteAllSearchRules(c, err), err)
end
