import db.meilisearch

func show(items: Vector<str>):
    each s in items:
        print s + " "
    end
    println ""
end

func main:
    c := meilisearch.New("http://127.0.0.1:7700", "masterKey")
    mut err := meilisearch.Error {}
    println meilisearch.GetSettings(c, "movies", err)
    meilisearch.Wait(c, meilisearch.UpdateSettings(c, "movies", `{"rankingRules": ["words", "typo"], "stopWords": ["the"]}`, err), err)
    println meilisearch.GetSetting(c, "movies", "ranking-rules", err)
    meilisearch.Wait(c, meilisearch.UpdateSetting(c, "movies", "pagination", `{"maxTotalHits": 5000}`, err), err)
    meilisearch.Wait(c, meilisearch.ResetSetting(c, "movies", "pagination", err), err)

    mut rankingRules := Vector {} as Vector<str>
    rankingRules.push("words")
    rankingRules.push("typo")
    rankingRules.push("proximity")
    rankingRules.push("attribute")
    rankingRules.push("sort")
    rankingRules.push("exactness")
    meilisearch.Wait(c, meilisearch.UpdateRankingRules(c, "movies", rankingRules, err), err)
    show(meilisearch.GetRankingRules(c, "movies", err))
    meilisearch.Wait(c, meilisearch.ResetRankingRules(c, "movies", err), err)

    mut searchableAttributes := Vector {} as Vector<str>
    searchableAttributes.push("title")
    searchableAttributes.push("overview")
    meilisearch.Wait(c, meilisearch.UpdateSearchableAttributes(c, "movies", searchableAttributes, err), err)
    show(meilisearch.GetSearchableAttributes(c, "movies", err))
    meilisearch.Wait(c, meilisearch.ResetSearchableAttributes(c, "movies", err), err)

    mut displayedAttributes := Vector {} as Vector<str>
    displayedAttributes.push("*")
    meilisearch.Wait(c, meilisearch.UpdateDisplayedAttributes(c, "movies", displayedAttributes, err), err)
    show(meilisearch.GetDisplayedAttributes(c, "movies", err))
    meilisearch.Wait(c, meilisearch.ResetDisplayedAttributes(c, "movies", err), err)

    mut filterableAttributes := Vector {} as Vector<str>
    filterableAttributes.push("genre")
    filterableAttributes.push("year")
    meilisearch.Wait(c, meilisearch.UpdateFilterableAttributes(c, "movies", filterableAttributes, err), err)
    show(meilisearch.GetFilterableAttributes(c, "movies", err))
    meilisearch.Wait(c, meilisearch.ResetFilterableAttributes(c, "movies", err), err)

    mut sortableAttributes := Vector {} as Vector<str>
    sortableAttributes.push("year")
    meilisearch.Wait(c, meilisearch.UpdateSortableAttributes(c, "movies", sortableAttributes, err), err)
    show(meilisearch.GetSortableAttributes(c, "movies", err))
    meilisearch.Wait(c, meilisearch.ResetSortableAttributes(c, "movies", err), err)

    mut stopWords := Vector {} as Vector<str>
    stopWords.push("the")
    stopWords.push("a")
    meilisearch.Wait(c, meilisearch.UpdateStopWords(c, "movies", stopWords, err), err)
    show(meilisearch.GetStopWords(c, "movies", err))
    meilisearch.Wait(c, meilisearch.ResetStopWords(c, "movies", err), err)

    mut dictionary := Vector {} as Vector<str>
    dictionary.push("J. R. R.")
    meilisearch.Wait(c, meilisearch.UpdateDictionary(c, "movies", dictionary, err), err)
    show(meilisearch.GetDictionary(c, "movies", err))
    meilisearch.Wait(c, meilisearch.ResetDictionary(c, "movies", err), err)

    mut separatorTokens := Vector {} as Vector<str>
    separatorTokens.push("|")
    meilisearch.Wait(c, meilisearch.UpdateSeparatorTokens(c, "movies", separatorTokens, err), err)
    show(meilisearch.GetSeparatorTokens(c, "movies", err))
    meilisearch.Wait(c, meilisearch.ResetSeparatorTokens(c, "movies", err), err)

    mut nonSeparatorTokens := Vector {} as Vector<str>
    nonSeparatorTokens.push("@")
    meilisearch.Wait(c, meilisearch.UpdateNonSeparatorTokens(c, "movies", nonSeparatorTokens, err), err)
    show(meilisearch.GetNonSeparatorTokens(c, "movies", err))
    meilisearch.Wait(c, meilisearch.ResetNonSeparatorTokens(c, "movies", err), err)

    meilisearch.Wait(c, meilisearch.UpdateDistinctAttribute(c, "movies", "sku", err), err)
    println meilisearch.GetDistinctAttribute(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetDistinctAttribute(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdateProximityPrecision(c, "movies", "byAttribute", err), err)
    println meilisearch.GetProximityPrecision(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetProximityPrecision(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdatePrefixSearch(c, "movies", "indexingTime", err), err)
    println meilisearch.GetPrefixSearch(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetPrefixSearch(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdateSearchCutoffMs(c, "movies", 150, err), err)
    println meilisearch.GetSearchCutoffMs(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetSearchCutoffMs(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdateFacetSearch(c, "movies", true, err), err)
    println meilisearch.GetFacetSearch(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetFacetSearch(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdateSynonyms(c, "movies", `{"logan": ["wolverine"], "wolverine": ["logan"]}`, err), err)
    println meilisearch.GetSynonyms(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetSynonyms(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdateTypoTolerance(c, "movies", `{"minWordSizeForTypos": {"oneTypo": 4, "twoTypos": 10}}`, err), err)
    println meilisearch.GetTypoTolerance(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetTypoTolerance(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdatePagination(c, "movies", `{"maxTotalHits": 5000}`, err), err)
    println meilisearch.GetPagination(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetPagination(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdateFaceting(c, "movies", `{"maxValuesPerFacet": 200}`, err), err)
    println meilisearch.GetFaceting(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetFaceting(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdateEmbedders(c, "movies", `{"default": {"source": "userProvided", "dimensions": 3}}`, err), err)
    println meilisearch.GetEmbedders(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetEmbedders(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdateLocalizedAttributes(c, "movies", `[{"attributePatterns": ["*_fa"], "locales": ["fas"]}]`, err), err)
    println meilisearch.GetLocalizedAttributes(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetLocalizedAttributes(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.UpdateChat(c, "movies", `{"description": "A movie catalog"}`, err), err)
    println meilisearch.GetChat(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetChat(c, "movies", err), err)
    meilisearch.Wait(c, meilisearch.ResetSettings(c, "movies", err), err)
    println meilisearch.ErrorString(err)

    meilisearch.Wait(c, meilisearch.UpdateForeignKeys(c, "movies", `[{"foreignIndexUid": "actors", "fieldName": "actor_ids"}]`, err), err)
    println meilisearch.GetForeignKeys(c, "movies", err)
    meilisearch.Wait(c, meilisearch.ResetForeignKeys(c, "movies", err), err)
end
