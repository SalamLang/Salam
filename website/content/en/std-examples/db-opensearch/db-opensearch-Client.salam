import db.opensearch

func main:
    mut cfg := opensearch.DefaultConfig()
    cfg.nodes.push("https://node2.example.com:9200, https://node3.example.com:9200")
    cfg.username = "admin"
    cfg.password = "S3cret-pass!"
    cfg.ca_file = "/etc/ssl/certs/opensearch-ca.pem"
    cfg.timeout_ms = 10000
    cfg.max_retries = 2
    cfg.headers.put("X-Opaque-Id", "shop-api")
    mut c := opensearch.NewClient(cfg)
    if not opensearch.Ok(c):
        println opensearch.Error(c)
        ret 1
    end
    println opensearch.Nodes(c), opensearch.AuthHeader(c).len() > 0, opensearch.VERSION
    println opensearch.Ping(c)

    info := opensearch.GetInfo(c)
    println info.ok, info.name, info.cluster_name, info.cluster_uuid, info.version, info.distribution
    println info.build_type, info.lucene_version, info.minimum_wire_compatibility_version, info.tagline

    r := opensearch.Perform(c, "GET", "/_cat/health?format=json", "")
    println r.ok, r.status, r.body
    if not r.ok:
        println r.error, r.error_type, r.error_reason
    end
    nd := opensearch.PerformNdjson(c, "POST", "/_bulk", "{\"delete\":{\"_index\":\"shop\",\"_id\":\"1\"}}\n")
    println nd.status, opensearch.Status(c), opensearch.ErrorType(c), opensearch.ErrorReason(c)
    txt := opensearch.PerformText(c, "POST", "/_plugins/_sql?format=csv", `{"query":"SELECT 1"}`, "application/json")
    println txt.body
    opensearch.Close(c)

    mut local := opensearch.Connect(opensearch.DEFAULT_URL)
    println opensearch.Ok(local), opensearch.DEFAULT_PORT, opensearch.DEAD_NODE_MS
    opensearch.Close(local)
    mut demo := opensearch.ConnectInsecure("https://localhost:9200", "admin", "S3cret-pass!")
    opensearch.Close(demo)
    mut auth := opensearch.ConnectAuth("https://search.example.com", "reader", "pass")
    println opensearch.EncodeBasic("reader", "pass")
    opensearch.Close(auth)

    mut aws := opensearch.ConnectAWS(
        "https://search-shop.eu-west-1.es.amazonaws.com", "eu-west-1", opensearch.SERVICE_ES,
        "AKIAEXAMPLE", "secret-key", ""
    )
    opensearch.SetSigningTime(aws, 1700000000 as i64)
    println opensearch.ClusterHealth(aws).status
    opensearch.Close(aws)
    mut serverless := opensearch.ConnectAWS(
        "https://abc123.eu-west-1.aoss.amazonaws.com", "eu-west-1", opensearch.SERVICE_AOSS,
        "AKIAEXAMPLE", "secret-key", "session-token"
    )
    opensearch.Close(serverless)
    ret 0
end
