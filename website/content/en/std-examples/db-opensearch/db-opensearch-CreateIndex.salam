import db.opensearch

func main:
    c := opensearch.Connect("http://localhost:9200")
    mut props := Vector {} as Vector<str>
    props.push(opensearch.Property("title", "text"))
    props.push(opensearch.PropertyWith("title_fa", "text", `{"analyzer":"persian"}`))
    props.push(opensearch.Property("tag", "keyword"))
    props.push(opensearch.Property("year", "integer"))
    println opensearch.CreateIndexWith(c, "books", 1, 0, opensearch.Properties(props))
    println opensearch.CreateIndex(c, "logs-000001", `{"aliases":{"logs":{"is_write_index":true}}}`)
    println opensearch.IndexExists(c, "books"), opensearch.GetIndex(c, "books").len() > 0
    println opensearch.PutMapping(c, "books", "{" + opensearch.Property("isbn", "keyword") + "}")
    println opensearch.PutMappingBody(c, "books", `{"dynamic":"strict"}`), opensearch.GetMapping(c, "books")
    println opensearch.PutSettings(c, "books", `{"index":{"refresh_interval":"5s"}}`)
    println opensearch.GetSettings(c, "books").len() > 0, opensearch.GetSetting(c, "books", "index.refresh_interval")
    println opensearch.Refresh(c, "books"), opensearch.Flush(c, "books"), opensearch.ForceMerge(c, "books", 1), opensearch.ClearCache(c, "books")
    println opensearch.CloseIndex(c, "books"), opensearch.OpenIndex(c, "books")
    println opensearch.PutSettings(c, "books", `{"index.blocks.write":true}`)
    println opensearch.CloneIndex(c, "books", "books_clone", ""), opensearch.ShrinkIndex(c, "books", "books_small", ""), opensearch.SplitIndex(c, "books", "books_big", `{"settings":{"index.number_of_shards":2}}`)
    println opensearch.IndexStats(c, "books").len() > 0

    println opensearch.PutAlias(c, "books", "library"), opensearch.AliasExists(c, "library"), opensearch.AliasIndices(c, "library")
    println opensearch.PutAliasFiltered(c, "books", "poetry", opensearch.Term("tag", "poetry"), false)
    println opensearch.GetAliases(c, "books"), opensearch.DeleteAlias(c, "books", "poetry")
    mut acts := Vector {} as Vector<str>
    acts.push(opensearch.AliasAction("add", "books_clone", "library"))
    acts.push(opensearch.AliasAction("remove", "books", "library"))
    println opensearch.UpdateAliases(c, acts), opensearch.SwapAlias(c, "library", "books_clone", "books")

    mut patterns := Vector {} as Vector<str>
    patterns.push("logs-*")
    tpl := opensearch.IndexTemplate(patterns, `{"number_of_replicas":0}`, "{" + opensearch.Property("msg", "text") + "}", 10)
    println opensearch.PutIndexTemplate(c, "logs", tpl), opensearch.IndexTemplateExists(c, "logs"), opensearch.GetIndexTemplate(c, "logs").len() > 0
    println opensearch.PutComponentTemplate(c, "base", `{"template":{"settings":{"number_of_shards":1}}}`), opensearch.GetComponentTemplate(c, "base").len() > 0
    println opensearch.Rollover(c, "logs", `{"max_docs":1000000,"max_age":"7d"}`)
    println opensearch.PutIndexTemplate(c, "events", `{"index_patterns":["events-*"],"data_stream":{}}`)
    println opensearch.CreateDataStream(c, "events-web"), opensearch.DataStreams(c), opensearch.DeleteDataStream(c, "events-web")
    println opensearch.Analyze(c, "", "standard", "Salam to OpenSearch")
    each ix in opensearch.CatIndices(c, "books*"):
        println ix.health, ix.status, ix.index, ix.uuid, ix.primaries, ix.replicas, ix.docs_count, ix.docs_deleted, ix.store_size
    end
    println opensearch.DeleteIndexTemplate(c, "logs"), opensearch.DeleteIndexTemplate(c, "events"), opensearch.DeleteComponentTemplate(c, "base")
    println opensearch.DeleteIndex(c, "books_clone,books_small,books_big"), opensearch.DeleteIndexIfExists(c, "never-made")
end
