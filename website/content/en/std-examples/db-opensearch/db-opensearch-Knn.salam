import db.opensearch

func main:
    c := opensearch.Connect("http://localhost:9200")
    method := opensearch.KnnMethod { name = "hnsw", engine = "lucene", space_type = "cosinesimil", m = 16, ef_construction = 128 }
    mut extra := Vector {} as Vector<str>
    extra.push(opensearch.Property("text", "text"))
    println opensearch.KnnIndexSettings(1, 0), opensearch.KnnVectorField(3, method)
    println opensearch.CreateIndex(c, "places", opensearch.KnnIndexBody("embedding", 3, method, extra))
    opensearch.Index(c, "places", "1", `{"text":"a cafe","embedding":[0.1,0.9,0.2]}`)
    opensearch.Refresh(c, "places")
    mut v := Vector {} as Vector<f64>
    v.push(0.1)
    v.push(0.8)
    v.push(0.3)
    r := opensearch.Search(c, "places", opensearch.Knn("embedding", v, 5))
    println r.total
    println opensearch.KnnWarmup(c, "places"), opensearch.KnnClearCache(c, "places"), opensearch.KnnStats(c).len() > 0
    println opensearch.KnnTrainModel(c, "pq-model", `{"training_index":"train","training_field":"v","dimension":3,"method":{"name":"ivf","engine":"faiss"}}`)
    println opensearch.KnnGetModel(c, "pq-model"), opensearch.KnnDeleteModel(c, "pq-model")

    mut w := Vector {} as Vector<f64>
    w.push(0.3)
    w.push(0.7)
    println opensearch.PutSearchPipeline(c, "hybrid", opensearch.NormalizationPipeline("min_max", "arithmetic_mean", w))
    println opensearch.GetSearchPipeline(c, "hybrid"), opensearch.DeleteSearchPipeline(c, "hybrid")

    task := opensearch.MlRegisterModel(c, `{"name":"huggingface/sentence-transformers/all-MiniLM-L6-v2","version":"1.0.1","model_format":"TORCH_SCRIPT"}`)
    println opensearch.MlGetTask(c, task)
    println opensearch.MlDeployModel(c, "model-1"), opensearch.MlGetModel(c, "model-1").len() > 0
    println opensearch.MlPredict(c, "text_embedding", "model-1", `{"text_docs":["salam"]}`)
    println opensearch.MlUndeployModel(c, "model-1"), opensearch.MlDeleteModel(c, "model-1")
end
