import db.opensearch

func main:
    c := opensearch.ConnectInsecure("https://localhost:9200", "admin", "S3cret-pass!")
    mut patterns := Vector {} as Vector<str>
    patterns.push("logs-*")
    println opensearch.PutPolicy(c, "logs-30d", opensearch.DeleteAfterPolicy("drop old logs", "30d", patterns))
    println opensearch.GetPolicy(c, "logs-30d").len() > 0
    println opensearch.UpdatePolicy(c, "logs-30d", opensearch.DeleteAfterPolicy("drop old logs", "60d", patterns), 0 as i64, 1 as i64)
    println opensearch.AddPolicy(c, "logs-000001", "logs-30d"), opensearch.PolicyIdOf(c, "logs-000001")
    println opensearch.ChangePolicy(c, "logs-000001", "logs-30d", "hot"), opensearch.RetryPolicy(c, "logs-000001")
    println opensearch.ExplainPolicy(c, "logs-000001"), opensearch.RemovePolicy(c, "logs-000001"), opensearch.DeletePolicy(c, "logs-30d")

    me := opensearch.WhoAmI(c)
    println me.ok, me.user, me.roles, me.backend_roles, me.tenants, me.error
    println opensearch.SecurityHealth(c)
    mut perms := Vector {} as Vector<str>
    perms.push("cluster_monitor")
    mut actions := Vector {} as Vector<str>
    actions.push("read")
    println opensearch.PutRole(c, "logs_reader", opensearch.RoleBody(perms, patterns, actions)), opensearch.GetRole(c, "logs_reader")
    println opensearch.PutUser(c, "maryam", "Strong-Pass-1!", Vector {} as Vector<str>, `{"team":"ops"}`), opensearch.GetUser(c, "maryam")
    mut users := Vector {} as Vector<str>
    users.push("maryam")
    println opensearch.PutRoleMapping(c, "logs_reader", users, Vector {} as Vector<str>), opensearch.GetRoleMapping(c, "logs_reader")
    println opensearch.Users(c), opensearch.ChangePassword(c, "S3cret-pass!", "N3w-secret-pass!")
    println opensearch.DeleteRoleMapping(c, "logs_reader"), opensearch.DeleteUser(c, "maryam"), opensearch.DeleteRole(c, "logs_reader")

    monitor := `{"type":"monitor","name":"errors","enabled":true,"schedule":{"period":{"interval":5,"unit":"MINUTES"}},"inputs":[{"search":{"indices":["logs-*"],"query":{"size":0,"query":{"match":{"level":"error"}}}}}],"triggers":[]}`
    id := opensearch.CreateMonitor(c, monitor)
    println id, opensearch.GetMonitor(c, id).len() > 0, opensearch.UpdateMonitor(c, id, monitor)
    println opensearch.ExecuteMonitor(c, id, true).len() > 0, opensearch.SearchMonitors(c, opensearch.MatchAll()).total
    println opensearch.DeleteMonitor(c, id)
end
