import db.opensearch

func list(a: str, b: str): Vector<str>:
    mut v := Vector {} as Vector<str>
    v.push(a)
    if b.len() > 0: v.push(b) end
    ret v
end

func main:
    println opensearch.MatchAll(), opensearch.MatchNone()
    println opensearch.Match("title", "salam"), opensearch.MatchAnd("title", "salam world")
    println opensearch.MatchFuzzy("title", "slam"), opensearch.MatchPhrase("title", "hello world")
    println opensearch.MatchPhraseSlop("title", "hello world", 2), opensearch.MatchPhrasePrefix("title", "sal")
    println opensearch.MatchBoolPrefix("title", "quick bro")
    println opensearch.MultiMatch("salam", list("title^2", "body")), opensearch.MultiMatchType("salam", list("title", "body"), "phrase")
    println opensearch.Term("tag", "news"), opensearch.TermInt("year", 1403), opensearch.TermBool("published", true)
    println opensearch.TermCaseInsensitive("tag", "News"), opensearch.Terms("tag", list("news", "sport"))
    mut years := Vector {} as Vector<i64>
    years.push(1402)
    years.push(1403)
    println opensearch.TermsInt("year", years), opensearch.TermsLookup("tag", "users", "7", "follows")
    println opensearch.TermsSet("skills", list("go", "salam"), "required")
    println opensearch.Range("date", "2026-01-01", "2026-12-31"), opensearch.RangeExclusive("price", "10", "20")
    println opensearch.RangeNum("price", 9.5, 20.0), opensearch.RangeInt("stock", 1, 100), opensearch.RangeOp("price", "lt", "5")
    println opensearch.DateRange("at", "now-7d/d", "now", "", "+03:30")
    println opensearch.FieldExists("email"), opensearch.Prefix("sku", "AB-"), opensearch.Wildcard("sku", "AB-*-9")
    println opensearch.Regexp("sku", "AB-[0-9]+"), opensearch.Fuzzy("name", "maryem"), opensearch.Ids(list("1", "2"))
    println opensearch.QueryString("title:salam AND year:1403")
    println opensearch.QueryStringFields("salam world", list("title", "body"), "AND")
    println opensearch.SimpleQueryString("salam -draft", list("title", ""))

    mut b := opensearch.BoolQuery { minimum_should_match = "1", boost = 1.5 }
    b.must.push(opensearch.Match("title", "salam"))
    b.filter.push(opensearch.Term("status", "published"))
    b.should.push(opensearch.Term("tag", "featured"))
    b.must_not.push(opensearch.Term("tag", "spam"))
    println opensearch.BoolOf(b)
    println opensearch.Bool(list(opensearch.Match("t", "x"), ""), list(opensearch.Term("a", "1"), ""), Vector {} as Vector<str>, Vector {} as Vector<str>)
    println opensearch.And(list(opensearch.Term("a", "1"), opensearch.Term("b", "2")))
    println opensearch.Or(list(opensearch.Term("a", "1"), opensearch.Term("b", "2"))), opensearch.Not(opensearch.Term("a", "1"))
    println opensearch.Filtered(opensearch.Match("t", "x"), list(opensearch.Term("a", "1"), ""))
    println opensearch.ConstantScore(opensearch.Term("tag", "news"), 1.2)
    println opensearch.DisMax(list(opensearch.Match("title", "x"), opensearch.Match("body", "x")), 0.3)
    println opensearch.Boosting(opensearch.Match("t", "apple"), opensearch.Match("t", "pie"), 0.5)
    println opensearch.Nested("comments", opensearch.Match("comments.text", "great"))
    println opensearch.HasChild("answer", opensearch.MatchAll()), opensearch.HasParent("question", opensearch.MatchAll())
    println opensearch.MoreLikeThis(list("title", "body"), "search engines in Salam")
    println opensearch.ScriptQuery("doc['stock'].value > params.min", `{"min":5}`)
    println opensearch.ScriptScore(opensearch.MatchAll(), "_score * doc['rank'].value", "")
    println opensearch.FunctionScore(opensearch.Match("t", "x"), list(opensearch.FieldValueFactor("likes", 1.2, "log1p"), ""), "sum", "multiply")
    println opensearch.GeoDistance("location", 35.69, 51.39, "5km")
    println opensearch.GeoBoundingBox("location", 36.0, 51.0, 35.5, 51.8)

    mut v := Vector {} as Vector<f64>
    v.push(0.12)
    v.push(-0.5)
    v.push(0.9)
    println opensearch.Knn("embedding", v, 10), opensearch.KnnVector(v)
    println opensearch.KnnFiltered("embedding", v, 10, opensearch.Term("lang", "fa"))
    println opensearch.KnnRadial("embedding", v, 0.5), opensearch.KnnMinScore("embedding", v, 0.8)
    println opensearch.Neural("embedding", "a cosy cafe", "model-1", 5), opensearch.NeuralSparse("tokens", "a cosy cafe", "model-2")
    println opensearch.Hybrid(list(opensearch.Match("text", "cafe"), opensearch.Neural("embedding", "cafe", "model-1", 5)))

    println opensearch.SortAsc("price"), opensearch.SortDesc("date"), opensearch.SortScore()
    println opensearch.SortGeo("location", 35.69, 51.39, "km")
    println opensearch.Highlight(list("title", "body")), opensearch.HighlightTags(list("title", ""), "<mark>", "</mark>")
    println opensearch.Collapse("author"), opensearch.TermSuggest("fix", "salm", "title")
    println opensearch.CompletionSuggest("auto", "sal", "title.suggest", 5)

    mut aggs := opensearch.AddAgg("{}", "tags", opensearch.TermsAgg("tag", 10))
    aggs = opensearch.AddAgg(aggs, "avg_price", opensearch.AvgAgg("price"))
    aggs = opensearch.AddAgg(aggs, "total", opensearch.SumAgg("price"))
    aggs = opensearch.AddAgg(aggs, "cheapest", opensearch.MinAgg("price"))
    aggs = opensearch.AddAgg(aggs, "dearest", opensearch.MaxAgg("price"))
    aggs = opensearch.AddAgg(aggs, "priced", opensearch.ValueCountAgg("price"))
    aggs = opensearch.AddAgg(aggs, "authors", opensearch.CardinalityAgg("author"))
    println aggs
    mut pcts := Vector {} as Vector<f64>
    pcts.push(50.0)
    pcts.push(99.0)
    println opensearch.StatsAgg("price"), opensearch.ExtendedStatsAgg("price"), opensearch.PercentilesAgg("ms", pcts)
    println opensearch.HistogramAgg("price", 10.0), opensearch.RangeAgg("price", pcts)
    monthly := opensearch.SubAggs(opensearch.DateHistogramAgg("date", "month"), opensearch.AddAgg("{}", "sales", opensearch.SumAgg("price")))
    println monthly
    println opensearch.FilterAgg(opensearch.Term("tag", "news")), opensearch.NestedAgg("comments"), opensearch.MissingAgg("price")
    println opensearch.TopHitsAgg(3), opensearch.CompositeAgg(list("tag", "author"), 100)
    println opensearch.AddMember(`{"size":0}`, "aggs", aggs)

    mut req := opensearch.SearchRequest { query = opensearch.BoolOf(b), from = 0, size = 20, track_total_hits = "true" }
    req.sort.push(opensearch.SortDesc("date"))
    req.source.push("title")
    req.source_excludes.push("body")
    req.fields.push("date")
    req.docvalue_fields.push("price")
    req.aggs = aggs
    req.highlight = opensearch.Highlight(list("title", ""))
    req.post_filter = opensearch.Term("color", "red")
    req.collapse = opensearch.Collapse("author")
    req.suggest = opensearch.TermSuggest("fix", "salm", "title")
    req.rescore = `{"window_size":50,"query":{"rescore_query":{"match_phrase":{"title":"salam"}}}}`
    req.script_fields = `{"double":{"script":{"source":"doc['price'].value * 2"}}}`
    req.search_after = `[1700000000000]`
    req.track_scores = true
    req.min_score = "0.1"
    req.timeout = "2s"
    req.explain = false
    req.version = true
    req.seq_no_primary_term = true
    req.ext = `{"rag":{"llm_question":"why"}}`
    req.extra.push(`"profile":false`)
    println opensearch.SearchBody(req)
    println opensearch.SearchBody(opensearch.SearchRequest { query = opensearch.MatchAll(), pit_id = "PIT", pit_keep_alive = "1m", no_source = true })
end
