import db.opensearch

func main:
    headers := opensearch.SignRequest(
        "GET", "example.amazonaws.com", "/", "", "us-east-1", "service", "AKIDEXAMPLE",
        "wJalrXUtnFEMI/K7MDENG+bPxRfiCYEXAMPLEKEY", "", 1440938160 as i64
    )
    each line in headers.split("\r\n"):
        if line.len() > 0: println line end
    end
end
