import db
import db.opensearch

func main:
    c := opensearch.Connect("http://localhost:9200")
    conn := opensearch.Conn(c)
    println conn.Kind(), conn.Ok(), conn.Ping(), db.QueryInt(conn, "SELECT COUNT(*) FROM books")
    rows := conn.Query("SELECT title, year, price FROM books WHERE year > 1000 ORDER BY year")
    println rows.Ok(), rows.ColumnCount(), rows.ColumnName(0), rows.ColumnType(1)
    until rows.Next():
        println rows.Text(0), rows.Int(1), rows.Int64(1), rows.Float(2), rows.IsNull(2)
    end
    rows.Close()
    println conn.Exec("DELETE FROM books WHERE year < 0"), conn.Changes(), conn.LastInsertId(), conn.Error(), conn.Quote("it's")
    tx := conn.Begin()
    println tx.Ok(), tx.Exec("SELECT 1"), tx.Query("SELECT 1").Ok(), tx.Commit(), tx.Rollback()

    mut params := Vector {} as Vector<str>
    params.push(opensearch.SqlParam("integer", "1000"))
    mut paged := opensearch.SqlWith(c, "SELECT title FROM books WHERE year > ?", params, 100)
    println paged.Total(), paged.ColumnTypeName(0), paged.Error()
    until paged.Next():
        println paged.Raw(0)
    end
    paged.Close()
    rs := opensearch.Sql(c, "SHOW TABLES LIKE books%")
    rs.Close()
    println opensearch.SqlFormat(c, "SELECT title FROM books", "csv")
    println opensearch.SqlExplain(c, "SELECT title FROM books").len() > 0

    p := opensearch.Ppl(c, "source=books | where year > 1000 | stats count() by tag")
    until p.Next():
        println p.Int(0), p.Text(1)
    end
    p.Close()
    println opensearch.PplFormat(c, "source=books | fields title", "raw"), opensearch.PplExplain(c, "source=books").len() > 0
    d := opensearch.Database { handle = c.handle }
    t := opensearch.Txn {}
    println d.Kind(), t.Ok(), conn.Close()
end
