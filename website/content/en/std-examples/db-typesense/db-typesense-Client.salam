import db.typesense

func main:
    mut nodes := Vector {} as Vector<str>
    nodes.push("http://ts-1:8108")
    nodes.push("http://ts-2:8108")
    nodes.push("http://ts-3:8108")
    mut c := typesense.NewCluster(nodes, "admin-key")
    defer typesense.Free(c)
    typesense.SetNearestNode(c, "http://ts-local:8108")
    typesense.AddNode(c, "http://ts-4:8108")
    typesense.AddHeader(c, "X-Request-Source", "salam")
    c.timeout_ms = 5000
    c.retries = 2
    c.retry_interval_ms = 200
    c.healthcheck_ms = 30000

    mut err := typesense.Error {}
    if not typesense.Health(c, err):
        println "not ready: " + typesense.ErrorString(err)
        ret 1
    end
    println typesense.IsHealthy(c), typesense.NodeHealthy(c, 0), typesense.NodeHealthy(c, -1)
    println "server", typesense.ServerVersion(c, err), typesense.Debug(c, err)
    st := typesense.Status(c, err)
    println st.state, st.committed_index, st.queued_writes
    println typesense.Stats(c, err)
    println typesense.Metrics(c, err)
    println typesense.CreateSnapshot(c, "/data/snapshots/today", err)
    println typesense.Vote(c, err), typesense.ClearCache(c, err), typesense.CompactDB(c, err), typesense.ResetPeers(c, err)
    println typesense.SchemaChanges(c, err).len()
    println typesense.SetSlowRequestLog(c, 1000, err), typesense.UpdateConfig(c, `{"healthy-read-lag": 1000}`, err)

    body := typesense.Request(c, "GET", "/collections?limit=1", "", err)
    if not typesense.Ok(err):
        println err.status, err.kind, err.message
        println err.kind == typesense.KIND_HTTP, err.kind == typesense.KIND_NETWORK, err.kind == typesense.KIND_INVALID, err.kind == typesense.KIND_DECODE
        println typesense.IsNotFound(err), typesense.IsConflict(err)
        ret 1
    end
    println body
    println typesense.RequestAs(c, "POST", "/stemming/dictionaries/import?id=plurals", "text/plain", `{"word":"mice","root":"mouse"}`, err)
    println typesense.VERSION, c.nodes.len(), c.nearest, c.api_key.len(), c.headers.len(), c.state.len()
    single := typesense.New("localhost:8108", "admin-key")
    println single.nodes.get(0)
end
