import db.typesense

func main:
    c := typesense.New("http://localhost:8108", "admin-key")
    mut err := typesense.Error {}

    popular := typesense.AnalyticsRule {
        name = "popular-searches", kind = typesense.RULE_POPULAR_QUERIES, collection = "books", event_type = typesense.EVENT_SEARCH,
        params = `{"destination_collection": "popular_queries", "limit": 1000}`
    }
    println typesense.AnalyticsRuleJSON(popular)
    made := typesense.CreateAnalyticsRule(c, popular, err)
    println made.name, made.kind, made.collection, made.event_type, made.params

    clicks := typesense.AnalyticsRule {
        name = "book-clicks", kind = typesense.RULE_COUNTER, collection = "books", event_type = typesense.EVENT_CLICK,
        rule_tag = "homepage", params = `{"destination_collection": "books", "counter_field": "popularity", "weight": 1}`
    }
    println typesense.UpsertAnalyticsRule(c, clicks, err).rule_tag
    println typesense.CreateAnalyticsRuleJSON(c, `{"name": "no-results", "type": "nohits_queries", "collection": "books", "event_type": "search", "params": {"destination_collection": "nohits", "limit": 100}}`, err)
    println typesense.UpsertAnalyticsRuleJSON(c, "old-style", `{"type": "popular_queries", "params": {"source": {"collections": ["books"]}, "destination": {"collection": "pq"}}}`, err)
    println typesense.GetAnalyticsRule(c, "book-clicks", err).raw
    each r in typesense.ListAnalyticsRules(c, "homepage", err):
        println r.name, r.kind
    end

    println typesense.SendEvent(c, "book-clicks", typesense.EVENT_CLICK, `{"doc_id": "42", "user_id": "u-7"}`, err)
    println typesense.SendEventJSON(c, `{"name": "book-clicks", "event_type": "click", "data": {"doc_id": "43", "user_id": "u-7"}}`, err)
    each e in typesense.GetEvents(c, "u-7", "book-clicks", 20, err):
        println e
    end
    println typesense.FlushAnalytics(c, err), typesense.AnalyticsStatus(c, err)
    println typesense.DeleteAnalyticsRule(c, "no-results", err)
    println typesense.RULE_LOG, typesense.EVENT_CONVERSION, typesense.EVENT_VISIT, typesense.EVENT_CUSTOM

    m := typesense.ConversationModel {
        id = "books-assistant", model_name = "openai/gpt-4o-mini", api_key = "sk-...", history_collection = "conversations",
        system_prompt = "You recommend books from our catalog.", max_bytes = 16384, ttl = 86400, account_id = "", vllm_url = "", extra = ""
    }
    println typesense.ConversationModelJSON(m)
    println typesense.CreateConversationModel(c, m, err)
    println typesense.GetConversationModel(c, "books-assistant", err)
    println typesense.ListConversationModels(c, err).len()
    println typesense.UpdateConversationModel(c, "books-assistant", typesense.ConversationModel { system_prompt = "Answer in one sentence." }, err)
    println typesense.DeleteConversationModel(c, "books-assistant", err)

    println typesense.CreateNLSearchModel(c, `{"id": "gpt-4o-nl", "model_name": "openai/gpt-4o-mini", "api_key": "sk-...", "max_bytes": 16000}`, err)
    println typesense.GetNLSearchModel(c, "gpt-4o-nl", err)
    println typesense.ListNLSearchModels(c, err).len()
    println typesense.UpdateNLSearchModel(c, "gpt-4o-nl", `{"temperature": 0.0}`, err)
    println typesense.DeleteNLSearchModel(c, "gpt-4o-nl", err)
end
