import db.typesense

func main:
    c := typesense.New("http://localhost:8108", "admin-key")
    mut err := typesense.Error {}

    mut s := typesense.Schema { name = "books_v2", default_sorting_field = "year", enable_nested_fields = true }
    s.fields.push(typesense.NewField("title", typesense.TYPE_STRING))
    s.fields.push(typesense.Field { name = "title_fa", kind = typesense.TYPE_STRING, locale = "fa", stem = true, optional = true })
    s.fields.push(typesense.FacetField("year", typesense.TYPE_INT32))
    s.fields.push(typesense.FacetField("genres", typesense.TYPE_STRING_ARRAY))
    s.fields.push(typesense.Field { name = "price", kind = typesense.TYPE_FLOAT, range_index = true })
    s.fields.push(typesense.Field { name = "isbn", kind = typesense.TYPE_STRING, index = false, optional = true })
    s.fields.push(typesense.Field { name = "author_id", kind = typesense.TYPE_STRING, reference = "authors.id" })
    s.fields.push(typesense.Field { name = "location", kind = typesense.TYPE_GEOPOINT, optional = true })
    s.fields.push(typesense.VectorField("embedding", 384))
    mut from := Vector {} as Vector<str>
    from.push("title")
    s.fields.push(typesense.EmbeddingField("title_vector", from, "ts/all-MiniLM-L12-v2"))
    s.fields.push(typesense.Field { name = "meta.*", kind = typesense.TYPE_AUTO, optional = true })
    s.symbols_to_index.push("+")
    s.token_separators.push("-")
    s.metadata = `{"owner": "catalog"}`
    println typesense.SchemaJSON(s)

    col := typesense.CreateCollection(c, s, err)
    if typesense.IsConflict(err):
        println "books_v2 already exists"
    end
    println col.name, col.num_documents, col.created_at, col.fields.len()
    each f in col.fields:
        println f.name, f.kind, f.facet, f.optional, f.sort, f.index, f.store
    end

    if typesense.CollectionExists(c, "books_v2", err):
        println typesense.GetCollection(c, "books_v2", err).default_sorting_field
    end
    each x in typesense.ListCollections(c, err):
        println x.name, x.num_documents
    end
    mut skip := Vector {} as Vector<str>
    skip.push("fields")
    println typesense.ListCollectionsPage(c, 0, 20, skip, err).len()

    mut add := Vector {} as Vector<typesense.Field>
    add.push(typesense.FacetField("publisher", typesense.TYPE_STRING))
    println typesense.AddFields(c, "books_v2", add, err)
    mut drop := Vector {} as Vector<str>
    drop.push("isbn")
    println typesense.DropFields(c, "books_v2", drop, err)
    println typesense.SetCollectionMetadata(c, "books_v2", `{"owner": "search team"}`, err)
    println typesense.UpdateCollection(c, "books_v2", `{"synonym_sets": ["book-words"]}`, err)

    a := typesense.UpsertAlias(c, "books", "books_v2", err)
    println a.name, a.collection_name
    println typesense.GetAlias(c, "books", err).collection_name
    each al in typesense.ListAliases(c, err):
        println al.name, "->", al.collection_name
    end
    println typesense.CloneCollection(c, "books_v2", "books_v3", err).name
    println typesense.TruncateCollection(c, "books_v3", err)
    println typesense.DeleteCollection(c, "books_v3", err).name
    println typesense.DeleteAlias(c, "old_books", err).name
    println typesense.CreateCollectionJSON(c, `{"name": "authors", "fields": [{"name": "name", "type": "string"}]}`, err).name
    println typesense.FieldJSON(typesense.NewField("pages", typesense.TYPE_INT32))
    println typesense.TYPE_STRING_ANY, typesense.TYPE_INT32_ARRAY, typesense.TYPE_INT64, typesense.TYPE_INT64_ARRAY, typesense.TYPE_FLOAT_ARRAY
    println typesense.TYPE_BOOL, typesense.TYPE_BOOL_ARRAY, typesense.TYPE_GEOPOINT_ARRAY, typesense.TYPE_GEOPOLYGON
    println typesense.TYPE_OBJECT, typesense.TYPE_OBJECT_ARRAY, typesense.TYPE_IMAGE
end
