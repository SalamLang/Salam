import db.typesense

func main:
    c := typesense.New("http://localhost:8108", "admin-key")
    mut err := typesense.Error {}

    mut books := Vector {} as Vector<str>
    books.push("books")
    search := typesense.SearchOnlyKey(c, "website search", books, err)
    println search.id, search.value, search.actions.len(), search.collections.get(0)

    mut actions := Vector {} as Vector<str>
    actions.push("documents:*")
    actions.push("collections:get")
    mut orgs := Vector {} as Vector<str>
    orgs.push("org_.*")
    spec := typesense.KeySpec { description = "tenant writer", actions = actions, collections = orgs, expires_at = 1924992000, autodelete = true }
    println typesense.KeySpecJSON(spec)
    k := typesense.CreateKey(c, spec, err)
    println k.value, k.expires_at, k.autodelete

    mut all := Vector {} as Vector<str>
    all.push(typesense.KEY_ACTION_ALL)
    admin := typesense.CreateKey(c, typesense.KeySpec { description = "admin", actions = all, collections = all, value = "my-chosen-admin-key" }, err)
    println admin.id

    g := typesense.GetKey(c, k.id, err)
    println g.value_prefix, g.description
    each key in typesense.ListKeys(c, err):
        println key.id, key.value_prefix, key.description, key.actions.len(), key.collections.len(), key.expires_at
    end
    println typesense.DeleteKey(c, k.id, err)

    scope := typesense.SearchParams { filter_by = "company_id:=124", exclude_fields = "salary" }
    scoped := typesense.ScopedSearchKey(search.value, scope, 1924992000)
    println scoped
    println typesense.GenerateScopedSearchKey(search.value, `{"filter_by":"user_id:=42"}`)
    mut browser := typesense.New("https://search.example.com", scoped)
    defer typesense.Free(browser)
    println typesense.Search(browser, "books", typesense.NewSearch("dune", "title"), err).found
    println typesense.KEY_ACTION_SEARCH
end
