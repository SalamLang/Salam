import db.typesense

struct Book:
    pub id: str = ""
    pub title: str = ""
    pub year: int = 0
end

func main:
    c := typesense.New("http://localhost:8108", "admin-key")
    mut err := typesense.Error {}

    println typesense.CreateDocument(c, "books", `{"id": "1", "title": "Dune", "year": 1965}`, err)
    println typesense.UpsertDocument(c, "books", `{"id": "1", "title": "Dune", "year": 1965}`, err)
    println typesense.EmplaceDocument(c, "books", `{"id": "2", "title": "Emma"}`, err)
    println typesense.UpdateDocument(c, "books", "2", `{"year": 1815}`, err)
    println typesense.UpdateDocumentWith(c, "books", "2", `{"year": "1815"}`, typesense.DIRTY_COERCE_OR_REJECT, err)
    println typesense.IndexDocument(c, "books", `{"id": "3", "title": "Ulysses", "year": "1922"}`, typesense.WriteOptions { action = typesense.ACTION_UPSERT, dirty_values = typesense.DIRTY_COERCE_OR_DROP }, err)
    println typesense.GetDocument(c, "books", "1", err)
    println typesense.DocumentExists(c, "books", "42", err)

    mut b := Book {}
    if typesense.GetDocumentAs(c, "books", "1", b, err):
        println b.title, b.year
    end
    println typesense.CreateDocumentOf(c, "books", Book { id = "4", title = "Beloved", year = 1987 }, err)
    println typesense.UpsertDocumentOf(c, "books", Book { id = "4", title = "Beloved", year = 1987 }, err)

    mut books := Vector {} as Vector<Book>
    books.push(Book { id = "5", title = "Hamlet", year = 1603 })
    books.push(Book { id = "6", title = "Middlemarch", year = 1871 })
    r := typesense.ImportOf(c, "books", books, typesense.WriteOptions { action = typesense.ACTION_UPSERT, batch_size = 100, return_id = true }, err)
    println r.success, r.failed, r.ids.len(), r.documents.len(), r.lines.len()
    each e in r.errors:
        println e.line, e.id, e.code, e.error, e.document
    end

    mut docs := Vector {} as Vector<str>
    docs.push(`{"id": "7", "title": "Persuasion", "year": 1817}`)
    docs.push(`{"id": "8", "title": "Walden", "year": "1854"}`)
    r2 := typesense.ImportDocuments(c, "books", docs, typesense.WriteOptions { action = typesense.ACTION_CREATE, dirty_values = typesense.DIRTY_REJECT, return_doc = true }, err)
    println r2.success, r2.failed
    r3 := typesense.ImportJSONL(c, "books", "{\"id\": \"9\", \"title\": \"Emma\"}\n", typesense.WriteOptions { action = typesense.ACTION_UPDATE, remote_embedding_batch_size = 50 }, err)
    println r3.success, typesense.ACTION_EMPLACE, typesense.DIRTY_DROP

    println typesense.UpdateByFilter(c, "books", "year:<1900", `{"classic": true}`, err)
    println typesense.DeleteByFilter(c, "books", "year:<1700", 500, err)
    println typesense.DeleteDocument(c, "books", "9", err)

    lines := typesense.ExportDocuments(c, "books", typesense.ExportOptions { filter_by = "year:>1800", include_fields = "id,title,year", exclude_fields = "" }, err)
    mut back := Vector {} as Vector<Book>
    if typesense.DecodeDocuments(lines, back, err):
        println back.len()
    end
    mut one := Book {}
    println typesense.DecodeDocument(`{"id": "1", "title": "Dune", "year": 1965}`, one, err), one.title
    println typesense.ExportJSONL(c, "books", typesense.ExportOptions {}, err).len()
end
