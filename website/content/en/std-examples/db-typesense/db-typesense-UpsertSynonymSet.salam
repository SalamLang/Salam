import db.typesense

func main:
    c := typesense.New("http://localhost:8108", "admin-key")
    mut err := typesense.Error {}

    mut words := Vector {} as Vector<str>
    words.push("book")
    words.push("novel")
    words.push("کتاب")
    mut items := Vector {} as Vector<typesense.Synonym>
    items.push(typesense.Synonym { id = "books", synonyms = words })
    set := typesense.UpsertSynonymSet(c, "book-words", items, err)
    println set.name, set.items.Len()
    mut one := Vector {} as Vector<str>
    one.push("paperback")
    s := typesense.Synonym { id = "paper", root = "book", synonyms = one, locale = "en", symbols_to_index = Vector {} as Vector<str> }
    println typesense.SynonymJSON(s)
    println typesense.UpsertSynonymItem(c, "book-words", s, err).root
    println typesense.GetSynonymItem(c, "book-words", "paper", err).synonyms.Len()
    println typesense.ListSynonymItems(c, "book-words", err).Len(), typesense.GetSynonymSet(c, "book-words", err).items.Len(), typesense.ListSynonymSets(c, err).Len()
    println typesense.DeleteSynonymItem(c, "book-words", "paper", err)

    println typesense.UpsertSynonym(c, "books", s, err).id
    println typesense.GetSynonym(c, "books", "paper", err).root, typesense.ListSynonyms(c, "books", err).Len()
    println typesense.DeleteSynonym(c, "books", "paper", err)

    mut pins := Vector {} as Vector<typesense.Pin>
    pins.push(typesense.Pin { id = "42", position = 1 })
    mut hide := Vector {} as Vector<str>
    hide.push("13")
    mut tags := Vector {} as Vector<str>
    tags.push("summer-sale")
    rule := typesense.CurationRule {
        id = "promote-dune", query = "dune", match_type = typesense.MATCH_EXACT, includes = pins, excludes = hide,
        filter_curated_hits = true, effective_from_ts = 1924992000, metadata = `{"campaign": "summer"}`
    }
    println typesense.CurationJSON(rule)
    mut rules := Vector {} as Vector<typesense.CurationRule>
    rules.push(rule)
    rules.push(typesense.CurationRule {
        id = "sale", tags = tags, rule_filter_by = "on_sale:=true", filter_by = "stock:>0", sort_by = "price:asc",
        match_type = typesense.MATCH_CONTAINS, replace_query = "", remove_matched_tokens = true, stop_processing = false,
        effective_to_ts = 1956528000, extra = ""
    })
    cs := typesense.UpsertCurationSet(c, "promotions", rules, err)
    println cs.name, cs.items.Len()
    println typesense.UpsertCurationItem(c, "promotions", rule, err).id
    println typesense.GetCurationItem(c, "promotions", "sale", err).sort_by, typesense.ListCurationItems(c, "promotions", err).Len()
    println typesense.GetCurationSet(c, "promotions", err).items.Len(), typesense.ListCurationSets(c, err).Len()
    println typesense.DeleteCurationItem(c, "promotions", "sale", err)
    println typesense.UpdateCollection(c, "books", `{"synonym_sets": ["book-words"], "curation_sets": ["promotions"]}`, err)

    println typesense.UpsertOverride(c, "books", rule, err).id
    println typesense.GetOverride(c, "books", "promote-dune", err).query, typesense.ListOverrides(c, "books", err).Len()
    println typesense.DeleteOverride(c, "books", "promote-dune", err)

    mut listing := typesense.NewSearch("", "title,description")
    listing.per_page = 24
    listing.sort_by = "popularity:desc"
    pr := typesense.UpsertSearchPreset(c, "listing", listing, err)
    println pr.name, pr.value
    println typesense.UpsertPreset(c, "listing-raw", `{"query_by": "title"}`, err).value
    println typesense.GetPreset(c, "listing", err).value
    each x in typesense.ListPresets(c, err):
        println x.name
    end
    println typesense.DeletePreset(c, "listing-raw", err)

    mut sw := Vector {} as Vector<str>
    sw.push("the")
    sw.push("a")
    st := typesense.UpsertStopwords(c, "english", sw, "en", err)
    println st.id, st.locale, st.stopwords.Len()
    println typesense.GetStopwords(c, "english", err).stopwords.Len(), typesense.ListStopwords(c, err).Len()
    println typesense.DeleteStopwords(c, "english", err)

    mut stem := Vector {} as Vector<typesense.StemWord>
    stem.push(typesense.StemWord { word = "mice", root = "mouse" })
    stem.push(typesense.StemWord { word = "geese", root = "goose" })
    println typesense.ImportStemmingDictionary(c, "irregular", stem, err)
    println typesense.ImportStemmingJSONL(c, "irregular", `{"word": "teeth", "root": "tooth"}`, err)
    d := typesense.GetStemmingDictionary(c, "irregular", err)
    println d.id, d.words.Len()
    println typesense.ListStemmingDictionaries(c, err).Len()
    println typesense.DeleteStemmingDictionary(c, "irregular", err)
    println typesense.DeleteCurationSet(c, "promotions", err), typesense.DeleteSynonymSet(c, "book-words", err)
end
