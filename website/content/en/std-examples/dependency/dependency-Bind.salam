import dependency

interface Greeter:
    func Hello(): str
end

struct English:
    pub func Hello(): str:
        ret "hello"
    end
end

func main:
    c := dependency.New()
    dependency.Provide(c, "English", "", English {}, (_c: dependency.Container): ret English {} end)
    dependency.Bind(c, "Greeter", "English")
    mut g := English {}
    if dependency.Get(c, "Greeter", g):
        println g.Hello()
    end
    dependency.Close(c)
end
