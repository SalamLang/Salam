import dependency

func main:
    c := dependency.New()
    dependency.Provide(c, "Service", "Repo", 0, (_c: dependency.Container): ret 1 end)
    println dependency.Build(c)
    dependency.Provide(c, "Repo", "Service", 0, (_c: dependency.Container): ret 2 end)
    println dependency.Build(c)
    dependency.Close(c)
end
