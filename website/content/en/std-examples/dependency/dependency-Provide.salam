import dependency

func main:
    c := dependency.New()
    dependency.Provide(c, "Base", "", 0, (_c: dependency.Container): ret 10 end)
    dependency.Provide(c, "Double", "Base", 0, (cx: dependency.Container):
        mut b := 0
        _ok := dependency.Get(cx, "Base", b)
        ret b * 2
    end)
    mut d := 0
    if dependency.Get(c, "Double", d):
        println d
    end
    dependency.Close(c)
end
