import encoding.binary
import mem

func main:
    raw := mem.AllocateZeroed(32 as u64)
    defer mem.Free(raw)
    v := binary.NewView(raw, 32)
    binary.PutU32LE(v, 0, 0xFEEDFACF as i64)
    binary.PutU16BE(v, 4, 0x0102 as i64)
    binary.PutU8(v, 8, 65 as i64)
    binary.PutU8(v, 9, 66 as i64)
    println binary.GetU32LE(v, 0), binary.GetU16BE(v, 4), binary.GetU16LE(v, 4)
    println binary.CStringAt(v, 8), binary.FixedStringAt(v, 8, 1)
    println binary.Has(v, 30, 2), binary.Has(v, 31, 2), binary.GetU32LE(v, 31)
end
