import encoding.json

struct User:
    @json "name"
    pub name: str = ""
    @json "age"
    pub age: int = 0
    @json "tags"
    pub tags: Vector<str> = Vector {}
    @json "-"
    pub password: str = ""
end

func main:
    mut u := User { name = "Maryam", age = 28, password = "secret" }
    u.tags.push("admin")
    println json.Marshal(u)
    println json.MarshalIndent(u, "  ")
    mut loaded := User {}
    try:
        json.Unmarshal(`{"name": "Reza", "age": 41, "tags": ["a", "b"]}`, loaded)
        println loaded.name, loaded.age, loaded.tags.Len()
        json.Unmarshal(`{"name": "Reza", "age": "forty"}`, loaded)
    catch e:
        println e.kind_name(), e.ToStr()
    end
    mut lenient := User {}
    try:
        json.UnmarshalLenient(`{"name": "Sara", "extra": 1}`, lenient)
        println lenient.name
    catch e:
        println e.ToStr()
    end
    println json.Schema(u)
    envelope := json.SchemaEnvelope(u)
    println json.SchemaMerge(envelope) == json.Schema(u)
end
