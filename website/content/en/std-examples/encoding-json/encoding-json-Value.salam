import encoding.json
import encoding.value
import fs

func main throws:
    v := try json.Decode(`{"city": "Tehran", "zones": [1, 2, 22]}`)
    println try v.field("city").str()
    println json.EncodeDefault(v)
    opts := json.JSONOptions { indent = "  ", sort_keys = true }
    println json.Encode(v, opts)
    try:
        _ := json.Decode("[1, 2")
    catch e:
        println e.kind_name(), e.offset, e.to_str()
    end
    mut enc := json.NewBufEncoder()
    enc.Encode(value.ValueInt(1))
    enc.Encode(value.ValueString("two"))
    println enc.String()
    enc.Close()
    mut pretty := json.NewBufEncoderIndent("  ")
    pretty.Encode(v)
    println pretty.String()
    pretty.Close()
    out := fs.Open("lines.ndjson", "wb")
    mut lines := json.NewEncoder(out)
    lines.Encode(value.ValueInt(10))
    lines.Encode(value.ValueInt(20))
    lines.Close()
    mut tabbed := json.NewEncoderIndent(fs.Open("pretty.json", "wb"), "\t")
    tabbed.Encode(v)
    tabbed.Close()
    mut reader := json.NewDecoder(fs.Open("lines.ndjson", "rb"))
    mut total := 0 as i64
    until reader.More():
        total += try reader.Decode().int()
    end
    println total
    mut two := json.NewBufDecoder("{\"a\": 1}\n{\"a\": 2}\n")
    until two.More():
        println json.EncodeDefault(try two.Decode())
    end
end
