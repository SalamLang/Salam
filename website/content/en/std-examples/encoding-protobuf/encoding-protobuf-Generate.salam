import encoding.protobuf
import str

func main throws:
    src := "syntax = \"proto3\";\nmessage Ping { string text = 1; }\nservice Echo {\n  rpc Say (Ping) returns (Ping);\n  rpc Stream (stream Ping) returns (stream Ping);\n}\n"
    code := try protobuf.GenerateSingle(src)
    println str.Contains(code, "struct Ping"), str.Contains(code, "UnmarshalPing(data: void*, n: int): Ping throws")
    p := try protobuf.ParseFile(src)
    println protobuf.ServiceCount(p), protobuf.ServiceNameAt(p, 0), protobuf.ServiceMethodCount(p, 0)
    println protobuf.ServiceMethodSignature(p, 0, 0)
    println protobuf.ServiceMethodSignature(p, 0, 1)
    println str.Contains(protobuf.GenerateServices(p), "Echo")
    all := try protobuf.GenerateWithServices(src)
    println str.Len(all) > str.Len(code), str.Contains(all, "EchoStreamRecv(ch &: grpc.Channel, sid: int, got &: bool): Ping throws")
    println try protobuf.ServiceSummary(src)
    try:
        _ := protobuf.GenerateSingle("message Ping { string text = 1 }")
    catch e:
        println e.to_str()
    end
end
