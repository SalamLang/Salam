import encoding.slug

func main:
    println slug.Make("Hello, World! Ünïcödé & Co.")
    println slug.MakeWith("Hello, World!", slug.Snake())
    println slug.Transliterate("Привет, мир! Zürich", "")
    println slug.Transliterate("Müller Größe", "de")
    println slug.DetectScript("こんにちは")
    println slug.DetectScript("Καλημέρα")
end
