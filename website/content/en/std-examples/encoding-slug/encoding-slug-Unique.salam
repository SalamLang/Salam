import encoding.slug

func used(s: str): bool:
    ret s == "post" or s == "post-2"
end

func main:
    println slug.Unique("post", (s: str): ret used(s) end)
    println slug.UniqueWith("post", "_", (s: str): ret used(s) end)
    println slug.Numbered("post", 5, "-")
    println slug.IsSlug("post-3")
    println slug.IsSlugWith("Post_3", slug.Snake())
end
