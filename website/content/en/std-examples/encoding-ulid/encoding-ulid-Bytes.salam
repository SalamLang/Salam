import encoding.ulid

func main:
    id := ulid.Parse("01ARYZ6S41TSV4RRFFQ69G5FAV").id
    raw := ulid.Bytes(id)
    defer raw.free()
    uuid := ulid.ToUUIDBytes(id)
    defer uuid.free()
    tail := ulid.Entropy(id)
    defer tail.free()
    println raw.Len(), uuid.Len(), tail.Len()
    println ulid.String(ulid.FromBytes(raw).id)
    println ulid.String(ulid.FromUUIDBytes(uuid).id)
    println ulid.FromBytes(tail).err == ulid.ERR_BYTES
end
