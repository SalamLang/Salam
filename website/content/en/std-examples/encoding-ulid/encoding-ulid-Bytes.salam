import encoding.ulid

func main:
    r := ulid.Parse("01ARYZ6S41TSV4RRFFQ69G5FAV")
    mut raw := ulid.Bytes(r.id)
    defer raw.free()
    println raw.Len(), raw.get(0), raw.get(15)
    back := ulid.FromBytes(raw)
    println back.ok, ulid.Equal(back.id, r.id)
    mut wire := ulid.ToUUIDBytes(r.id)
    defer wire.free()
    println wire.Len(), ulid.Equal(ulid.FromUUIDBytes(wire).id, r.id)
    mut tail := ulid.Entropy(r.id)
    defer tail.free()
    println tail.Len(), r.id.hi, r.id.lo
    mut short := Vector {} as Vector<u8>
    defer short.free()
    short.push(1 as u8)
    println ulid.FromBytes(short).err == ulid.ERR_BYTES
end
