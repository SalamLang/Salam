import encoding.ulid

func main:
    early := ulid.MinAt(1000)
    late := ulid.MaxAt(1000)
    println ulid.Compare(early, late), ulid.Compare(late, early), ulid.Compare(early, early)
    println ulid.String(early)
    println ulid.String(late)
    println ulid.IsZero(ulid.MinAt(0)), ulid.IsZero(early)
    step := ulid.Increment(early)
    println ulid.String(step.id)
    println ulid.Increment(late).ok
end
