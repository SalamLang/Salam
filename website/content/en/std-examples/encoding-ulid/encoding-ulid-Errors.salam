import encoding.ulid

func main:
    each code in [ulid.OK, ulid.ERR_LENGTH, ulid.ERR_CHAR, ulid.ERR_OVERFLOW, ulid.ERR_TIME, ulid.ERR_ENTROPY, ulid.ERR_BYTES, 99]:
        println code, ulid.ErrorText(code)
    end
    r := ulid.Parse("short")
    println r.ok, r.err, ulid.IsZero(r.id)
    println ulid.MAX_TIME
    top := ulid.MaxAt(ulid.MAX_TIME)
    println top.time, top.hi, top.lo
end
