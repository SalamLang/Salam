import encoding.ulid

func main:
    mut seed := Vector {} as Vector<u8>
    defer seed.free()
    repeat 10 in i:
        seed.push((i + 1) as u8)
    end
    r := ulid.FromParts(1469918176385, seed)
    println r.ok, ulid.String(r.id)
    println ulid.FromParts(-1, seed).ok, ulid.FromParts(ulid.MAX_TIME + 1, seed).ok
    println ulid.String(ulid.FromParts(ulid.MAX_TIME, seed).id)
end
