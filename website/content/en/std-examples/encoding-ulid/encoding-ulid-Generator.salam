import encoding.ulid

mut tick := 2000 as i64

func clock(): i64:
    ret tick
end

func source(): i64:
    ret 3
end

func main:
    own := ulid.NewGenerator()
    println ulid.Last(own).ok
    ulid.Free(own)
    g := ulid.NewGeneratorWith((): ret clock() end, (): ret source() end)
    r := ulid.Next(g)
    println r.ok, r.err, ulid.String(r.id)
    println ulid.Last(g).ok, ulid.Equal(ulid.Last(g).id, r.id)
    println g.state != null
    ulid.Free(g)
end
