import encoding.ulid

func main:
    id := ulid.New()
    text := ulid.String(id)
    println text.Len(), ulid.NewString().Len()
    println ulid.Time(id) - ulid.Now() < 5000
    println ulid.Equal(id, ulid.Parse(text).id)
    println ulid.Less(id, ulid.New())
    stamp := ulid.NewAt(1469918176385)
    println stamp.ok, stamp.err == ulid.OK, ulid.Time(stamp.id)
    println ulid.Last(ulid.Default()).ok
    println id.time > 0, id.hi >= 0, id.lo >= 0
end
