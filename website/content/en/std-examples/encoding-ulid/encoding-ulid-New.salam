import encoding.ulid

func main:
    a := ulid.New()
    b := ulid.NewString()
    println ulid.String(a).len(), b.len()
    println ulid.Less(a, ulid.Parse(b).id)
    at := ulid.NewAt(1469918176385)
    println at.ok, ulid.Time(at.id), at.id.time
    println ulid.NewAt(ulid.MAX_TIME + 1).err == ulid.ERR_TIME
    println ulid.Now() > 1700000000000
    last := ulid.Last(ulid.Default())
    println last.ok, ulid.Less(a, last.id)
    fresh := ulid.NewGenerator()
    defer ulid.Free(fresh)
    println ulid.Last(fresh).err == ulid.ERR_TIME
end
