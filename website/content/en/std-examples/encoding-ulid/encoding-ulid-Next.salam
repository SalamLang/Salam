import encoding.ulid

mut tick := 100 as i64

func clock(): i64:
    ret tick
end

func source(): i64:
    ret 1
end

func main:
    g := ulid.NewGeneratorWith((): ret clock() end, (): ret source() end)
    defer ulid.Free(g)
    first := ulid.Next(g)
    second := ulid.Next(g)
    println ulid.String(first.id)
    println ulid.String(second.id)
    println ulid.Less(first.id, second.id)
    forced := ulid.NextAt(g, 50)
    println ulid.Time(forced.id), ulid.Less(second.id, forced.id)
end
