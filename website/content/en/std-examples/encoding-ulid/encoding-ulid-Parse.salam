import encoding.ulid

func main:
    r := ulid.Parse("01arYz6s41TsV4RrffQ69g5fav")
    println r.ok, ulid.Time(r.id), ulid.String(r.id)
    bad := ulid.Parse("01ARYZ6S41TSV4RRFFQ69G5FAU")
    println bad.ok, bad.err == ulid.ERR_CHAR
    println ulid.ParseStrict("01arYz6s41TsV4RrffQ69g5fav").ok
    println ulid.IsValid("7ZZZZZZZZZZZZZZZZZZZZZZZZZ"), ulid.IsValid("8ZZZZZZZZZZZZZZZZZZZZZZZZZ")
end
