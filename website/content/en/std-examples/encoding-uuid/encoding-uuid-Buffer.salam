import encoding.uuid
import mem

func main:
    id := uuid.MustParse("f81d4fae-7dec-11d0-a765-00a0c91e6bf6")
    buf := mem.Allocate(16 as u64)
    defer mem.Free(buf)
    uuid.ToBuffer(id, buf)
    p := buf as u8*
    println p[0], p[15]
    back := uuid.FromBuffer(buf)
    println back.to_str()
    println back.hi == id.hi, back.lo == id.lo
    println uuid.Equal(back, id)
end
