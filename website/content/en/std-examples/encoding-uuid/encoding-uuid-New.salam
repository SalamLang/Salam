import encoding.uuid

func main:
    id := uuid.New()
    println uuid.String(id).len(), uuid.Version(id), uuid.Variant(id) == uuid.VARIANT_RFC
    println uuid.IsValid(uuid.NewString())
    println uuid.Nil(), uuid.IsNil(uuid.Nil()), uuid.IsNil(id)
    println uuid.Max(), uuid.IsMax(uuid.Max())
    ids := uuid.Batch(3)
    println ids.len()
    ids.free()
end
