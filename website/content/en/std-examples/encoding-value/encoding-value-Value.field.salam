import encoding.json

func main throws:
    doc := try json.Decode(`{"name": "Lamp", "price": 19.5, "stock": 12, "sale": true, "tags": ["home", "light"]}`)
    println try doc.field("name").str()
    println try doc.field("price").float()
    println try doc.field("stock").int()
    println try doc.field("sale").bool()
    println try doc.field("tags").at(1).str()
    try:
        println doc.field("color").str()
    catch e:
        println e.kind_name(), "->", e.message
    end
    try:
        println doc.field("tags").at(5).str()
    catch e:
        println e.kind_name(), "->", e.message
    end
    try:
        println doc.field("name").int()
    catch e:
        println e.kind_name(), "->", e.message
    end
    count := try doc.field("count").int() catch 0
    println "count or default:", count
end
