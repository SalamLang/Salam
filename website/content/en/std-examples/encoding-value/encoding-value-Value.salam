import encoding.value

func main:
    mut user := value.NewValueObject()
    value.ObjectSet(user, "name", value.ValueString("Narges"))
    value.ObjectSet(user, "age", value.ValueInt(34))
    value.ObjectSet(user, "height", value.ValueFloat(1.68))
    value.ObjectSet(user, "admin", value.ValueBool(false))
    value.ObjectSet(user, "phone", value.ValueNull())
    mut languages := value.NewValueArray()
    value.ArrayPush(languages, value.ValueString("fa"))
    value.ArrayPush(languages, value.ValueString("en"))
    value.ArraySet(languages, 1, value.ValueString("ar"))
    value.ObjectSet(user, "langs", languages)
    println value.ToDebugString(user)
    println value.ObjectLen(user), value.ObjectHas(user, "age"), value.ObjectKeys(user)
    println value.AsString(value.ObjectGet(user, "name")), value.AsInt(value.ObjectGet(user, "age")), value.AsFloat(value.ObjectGet(user, "height")), value.AsBool(value.ObjectGet(user, "admin"))
    langs := value.ObjectGet(user, "langs")
    println value.IsArray(langs), value.ArrayLen(langs), value.AsString(value.ArrayGet(langs, 1))
    mut present := false
    _ := value.ObjectGetOk(user, "email", present)
    println present
    phone := value.ObjectGet(user, "phone")
    println value.IsNull(phone), value.IsBool(phone), value.IsInt(value.ValueInt(1)), value.IsFloat(value.ValueFloat(1.0)), value.IsNumber(value.ValueInt(1))
    println value.IsString(value.ValueString("")), value.IsObject(user), phone.kind == value.KindNull, value.KindObject
    mut copy := value.ValueClone(user)
    println value.Equal(copy, user)
    removed := value.ObjectDelete(copy, "phone")
    println removed, value.Equal(copy, user)
    mut numbers := Vector {} as Vector<value.Value>
    numbers.push(value.ValueInt(1))
    mut fields := HashMap {} as HashMap<str, value.Value>
    fields.put("x", value.ValueArray(numbers))
    println value.ToDebugString(value.ValueObject(fields))
    value.ValueFree(copy)
end
