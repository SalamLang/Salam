import encoding.xml

func main throws:
    mut d := try xml.Parse("<shop><item price=\"120\">tea</item><item price=\"80\">sugar</item><item price=\"45\">bread</item></shop>")
    r := xml.DocumentNode(d)
    mut cheap := try xml.Select(d, r, "//item[@price < 100]")
    println cheap.items.Len()
    each n in cheap.items:
        println xml.Text(d, n)
    end
    xml.FreeList(cheap)
    println try xml.SelectString(d, r, "/shop/item[1]"), try xml.SelectNumber(d, r, "sum(//item/@price)"), try xml.SelectBoolean(d, r, "count(//item) = 3")
    last := try xml.SelectFirst(d, r, "//item[last()]")
    println xml.NodeName(d, last), xml.StringValue(d, last)
    mut v := try xml.Evaluate(d, r, "//item/@price")
    println v.kind == xml.ValueNodeSet, v.nodes.items.Len()
    first := v.nodes.items[0]
    println xml.IsAttributeRef(first), xml.ReferencedAttribute(d, first).value, xml.IsAttributeRef(xml.AttributeRef(0))
    xml.FreeValue(v)
    num := try xml.Evaluate(d, r, "string-length('hello')")
    println num.kind == xml.ValueNumber, num.number, xml.ValueString, xml.ValueBoolean
    try:
        xml.Select(d, r, "//item[@")
    catch e:
        println e.kind_name(), e.column, e.message
    end
    xml.Free(d)
end
