import excel

func main:
    mut sheet := excel.CSVToSheet("name,score\nAli,17\n\"Sara, A\",19.5\n", "scores")
    println sheet.name, sheet.row_count(), sheet.get_string(2, 0), sheet.get_number(2, 1)
    println excel.SheetToCSV(sheet)
    println excel.SheetToJSON(sheet)
    mut from_json := excel.JSONToSheet(`[["a", "b"], ["1", "x"], ["2", "y"]]`, "data")
    println from_json.row_count(), from_json.col_count(), from_json.get_string(0, 1), from_json.get_string(2, 0)
    xml := "<row r=\"2\"><c r=\"A2\" t=\"s\"><v>0</v></c><br/></row>"
    start := excel.XmlFind(xml, "c", 0)
    println start, excel.XmlAttr(xml, start, "r"), excel.XmlTagEnd(xml, start)
    println excel.XmlInner(xml, "v", 0), excel.XmlSelfClosing(xml, excel.XmlFind(xml, "br", 0))
    println excel.XmlFindClose(xml, "row", 10)
    println excel.XmlEscape("a<b&c"), excel.XmlUnescape("a&lt;b&amp;c")
    sheet.free()
    from_json.free()
end
