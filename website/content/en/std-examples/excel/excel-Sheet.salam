import excel

func main:
    mut sheet := excel.NewSheet("sales")
    sheet.set_string(0, 0, "item")
    sheet.set_string(0, 1, "count")
    sheet.set_cell(1, 0, "tea")
    sheet.set_int(1, 1, 12)
    sheet.set_cell(2, 0, "sugar")
    sheet.set_number(2, 1, 4.5)
    sheet.set_bool(3, 0, true)
    sheet.set_date(3, 1, 1710943509)
    sheet.set_formula(4, 1, "SUM(B2:B3)", 16.5)
    sheet.set_error(5, 0, "#DIV/0!")
    println sheet.name, sheet.row_count(), sheet.col_count()
    println sheet.get_string(1, 0), sheet.get_number(1, 1), sheet.get_number(2, 1), sheet.get_bool(3, 0), sheet.get_formula(4, 1)
    cell := sheet.get_cell(5, 0)
    println cell.kind == excel.CellError, cell.text, sheet.get_cell(3, 1).kind == excel.CellDate
    println sheet.has_cell(1, 1), sheet.has_cell(9, 9)
    sheet.clear_cell(5, 0)
    println sheet.has_cell(5, 0)
    mut row := Vector {} as Vector<str>
    row.push("bread")
    row.push("7")
    sheet.set_row(6, row)
    sheet.set_column(3, row)
    mut table := Vector {} as Vector<str>
    each value in ["a", "b", "c", "d"]:
        table.push(value)
    end
    sheet.set_table(8, 0, table, 2)
    println sheet.get_row(6).len(), sheet.get_column(3).len(), sheet.get_all().len()
    println sheet.get_string(9, 1)
    found := sheet.find("bread")
    println found.len(), found[0].row, found[0].col
    println sheet.filter_rows_equals(0, "tea")
    sheet.merge_cells(0, 0, 0, 1)
    mut hit := false
    range := sheet.merged_range(0, 1, hit)
    println sheet.is_merged(0, 1), hit, range.row1, range.col2, sheet.merges.len()
    sheet.set_style(1, 1, 2)
    println sheet.get_cell(1, 1).style_id, sheet.max_row, sheet.max_col, sheet.cells.size() > 0
    sheet.free()
end
