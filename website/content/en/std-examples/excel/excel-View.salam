import excel

func main:
    mut book := excel.NewWorkbook()
    mut sheet := book.add_sheet("prices")
    sheet.set_string(0, 0, "item")
    sheet.set_string(0, 1, "price")
    sheet.set_string(1, 0, "green tea, 500 g")
    sheet.set_number(1, 1, 4.5)
    sheet.set_string(2, 0, "sugar")
    sheet.set_number(2, 1, 1.25)
    sheet.rtl = true
    sheet.freeze(1, 1)
    sheet.set_auto_filter(0, 0, 2, 1)
    println sheet.rtl, sheet.freeze_rows, sheet.freeze_cols, sheet.auto_filter
    sheet.auto_fit()
    println sheet.col_widths
    sheet.set_column_width(3, 30.0)
    println sheet.col_widths.len(), sheet.col_widths[2], sheet.col_widths[3]
    framed := excel.Style { border = true, wrap = true }
    id := book.styles.get_or_add(framed)
    sheet.set_style(0, 0, id)
    println excel.WriteXLSX(book, "prices.xlsx")
    mut ok := false
    mut err := ""
    mut read := excel.Open("prices.xlsx", ok, err)
    back := read.sheet("prices")
    println ok, back.auto_filter, read.styles.get(back.get_cell(0, 0).style_id).wrap
    read.free()
    book.free()
end
