import excel

func main:
    mut book := excel.NewWorkbook()
    mut a := book.add_sheet("A")
    a.set_string(0, 0, "hello")
    a.set_number(0, 1, 2.5)
    mut b := book.add_sheet("B")
    b.set_int(0, 0, 42)
    println book.sheet_count(), book.sheet_names(), book.sheet_index("B"), book.sheet_at(0).name
    println book.rename_sheet(1, "second"), book.sheet("second").get_number(0, 0)
    println book.set_active(1), book.active().name, book.active_sheet
    println excel.WriteXLSX(book, "book.xlsx"), excel.WriteODS(book, "book.ods"), book.save("copy.xlsx"), excel.Save(book, "book.csv")
    println excel.DetectFormat("book.xlsx") == excel.FormatXLSX, excel.DetectFormat("book.ods") == excel.FormatODS, excel.DetectFormat("a.txt"), excel.FormatXLS, excel.FormatCSV, excel.FormatUnknown
    mut ok := false
    mut err := ""
    mut read := excel.Open("book.xlsx", ok, err)
    println ok, read.sheet_names(), read.sheet("A").get_string(0, 0), read.format == excel.FormatXLSX
    mut copy := excel.ReadXLSX("copy.xlsx", ok, err)
    mut ods := excel.ReadODS("book.ods", ok, err)
    println ok, ods.sheet("second").get_number(0, 0), copy.sheet_count()
    mut meta := excel.Inspect("book.xlsx", ok, err)
    println ok, meta.exists, meta.size > 0, meta.sheet_names, meta.sheet_rows, meta.sheet_cols
    meta.free()
    mut csv := excel.ReadCSVWorkbook("book.csv", ok, err)
    println ok, csv.sheet_at(0).get_string(0, 0), excel.WriteCSVWorkbook(csv, "again.csv")
    _ := excel.Open("missing.xlsx", ok, err)
    println ok, err != ""
    _ := excel.ReadXLS("missing.xls", ok, err)
    println ok, excel.IsXLS(null, 0)
    println book.remove_sheet_named("A"), book.remove_sheet(5), book.remove_sheet(0), book.sheet_count()
    mut fresh := excel.New()
    println fresh.sheet_count()
    fresh.free()
    read.free()
    copy.free()
    ods.free()
    csv.free()
    book.free()
end
