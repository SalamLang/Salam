import fmt

func main:
    println "[" + fmt.FormatFloat(3.14159, "%.2f") + "]"
    println "[" + fmt.FormatFloat(0.125, "%.2f") + "]"
    println "[" + fmt.FormatFloat(-2.5, "%8.1f") + "]"
    println "[" + fmt.FormatFloat(42.0, "%+08.2f") + "]"
    println "[" + fmt.FormatFloat(1234567.0, "%e") + "]"
    println "[" + fmt.FormatFloat(0.0001, "%g") + "]"
    println "[" + fmt.FormatInt(255, "%#x") + "]"
    println "[" + fmt.FormatInt(42, "%-6d") + "]"
    println "[" + fmt.FormatInt(7, "%05d") + "]"
    println "[" + fmt.FormatInt(5, "%b") + "]"
end
