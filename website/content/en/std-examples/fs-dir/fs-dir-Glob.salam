import fs.dir
import fs.file
import os
import os.temp

func show(title: str, items: Vector<str>, root: str):
    println title
    each item in items:
        println "  " + item.substr(root.len() + 1, item.len() - root.len() - 1)
    end
    items.free()
end

func main:
    root := temp.Directory()
    defer temp.RemoveDir(root)
    os.MkdirAll(root + "/src/deep")
    each name in ["src/a.c", "src/b.h", "src/deep/c.c", "top.c"]:
        file.WriteText(root + "/" + name, "x")
    end
    show("src/*.c", dir.Glob(root + "/src/*.c"), root)
    show("**/*.c", dir.Glob(root + "/**/*.c"), root)
    show("walk *.h", dir.WalkMatch(root, "*.h"), root)
    show("walk src/**/*.c", dir.WalkMatch(root, "src/**/*.c"), root)
end
