import fs

func main:
    fs.WriteText("picture.png", "PNG")
    info := fs.Stat("picture.png")
    println info.exists, info.size, info.mod_time > 0, info.permissions > 0
    println fs.Size("picture.png"), fs.Exists("picture.png")
    println fs.ModTime("picture.png") > 0, fs.AccessedTime("picture.png") > 0, fs.CreatedTime("picture.png") >= 0
    fs.Chmod("picture.png", 0o600)
    println fs.Permissions("picture.png")
    println fs.Extension("picture.png"), fs.MimeType("picture.png"), fs.MimeType("letter.pdf")
    println fs.Stat("missing.txt").exists
end
