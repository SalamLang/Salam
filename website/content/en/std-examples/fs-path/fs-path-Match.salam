import fs.path

func check(pattern: str, name: str):
    println pattern, name, path.Match(pattern, name)
end

func main:
    check("*.salam", "main.salam")
    check("*.salam", "std/main.salam")
    check("**/*.salam", "std/os/main.salam")
    check("**/*.salam", "main.salam")
    check("v?.[0-9]", "v1.5")
    check("[!a-c]*", "dog")
    check("cache/**", "cache/a/b")
    println path.HasMeta("src/main.salam"), path.HasMeta("src/*.salam")
end
