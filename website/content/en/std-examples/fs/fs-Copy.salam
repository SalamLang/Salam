import fs

func main:
    fs.WriteText("original.txt", "hello")
    fs.Copy("original.txt", "copy.txt")
    fs.Move("copy.txt", "moved.txt")
    fs.Rename("moved.txt", "final.txt")
    println fs.Exists("copy.txt"), fs.Exists("final.txt"), fs.ReadText("final.txt")
    fs.Delete("final.txt")
    println fs.Exists("final.txt")
end
