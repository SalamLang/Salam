import fs

func main:
    mut png := Vector {} as Vector<u8>
    defer png.Free()
    each b in [137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13]:
        png.Push(b as u8)
    end
    println fs.WriteAllBytes("header.bin", png)
    back := fs.ReadAllBytes("header.bin")
    defer back.Free()
    println back.Len(), back.Get(1), back.Get(11)
    println fs.Size("header.bin")
    println fs.Sha256Hex("header.bin")
    fs.Delete("header.bin")
end
