import fs

func main:
    fs.WriteText("poem.txt", "The children of Adam are limbs of one body\n")
    fs.Append("poem.txt", "having been created of one essence\n")
    print fs.ReadText("poem.txt")
    println fs.ReadAll("poem.txt") == fs.ReadText("poem.txt")
    lines := fs.ReadLines("poem.txt")
    println lines.Len(), lines.get(1)
    fs.WriteBytes("data.bin", "ABCDEF")
    println fs.ReadBytes("data.bin", 3)
    fs.AtomicWrite("settings.txt", "language=english")
    println fs.ReadText("settings.txt")
    f := fs.Open("poem.txt", "rb")
    println f.readline()
    fs.Close(f)
end
