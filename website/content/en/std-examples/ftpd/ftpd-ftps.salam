import ftpd

func main():
    mut cfg := ftpd.NewConfig()
    cfg.port = 21
    cfg.root = "/srv/ftp"
    cfg.tls_enabled = true
    cfg.cert_file = "/etc/ssl/certs/ftp.crt"
    cfg.key_file = "/etc/ssl/private/ftp.key"
    cfg.require_tls = true
    srv := ftpd.New(cfg)
    ftpd.Listen(srv)
    ftpd.Serve(srv)
end
