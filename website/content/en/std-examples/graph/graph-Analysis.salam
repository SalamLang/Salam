import graph

func list(text: str): Vector<int>:
    mut out := Vector {} as Vector<int>
    each num in text.split(" "):
        out.push(num.to_int())
    end
    ret out
end


func ints(v: Vector<int>): str:
    mut text := "["
    repeat v.len() in i:
        if i > 0:
            text += " "
        end
        text += "" + v.get(i)
    end
    ret text + "]"
end


func floats(v: Vector<f64>): str:
    mut text := "["
    repeat v.len() in i:
        if i > 0:
            text += " "
        end
        text += "" + ((v.get(i) * 100.0 + 100000.5) as int - 100000)
    end
    ret text + "]/100"
end

func round(x: f64): int:
    ret (x * 100.0 + 100000.5) as int - 100000
end

func main:
    mut g := graph.FromEdgeList("0 1\n0 2\n1 2\n2 3\n3 4", 5, false)
    println round(graph.Density(g)), round(graph.AverageDegree(g)), graph.MaxDegree(g), graph.MinDegree(g), ints(graph.DegreeSequence(g)), ints(graph.DegreeHistogram(g))
    println graph.IsRegular(graph.CycleGraph(5)), graph.IsComplete(graph.CompleteGraph(3)), graph.Eccentricity(g, 4), ints(graph.EccentricityAll(g))
    println graph.Diameter(g), graph.Radius(g), ints(graph.Center(g)), ints(graph.Periphery(g)), round(graph.AveragePathLength(g)), graph.WienerIndex(g), graph.Girth(g)
    println round(graph.LocalClustering(g, 2)), round(graph.AverageClustering(g)), round(graph.Transitivity(g)), graph.TriangleCount(g), round(graph.Assortativity(g)), graph.CircuitRank(g), graph.WeightedDiameter(g)

    println floats(graph.DegreeCentrality(g))
    println floats(graph.ClosenessCentrality(g))
    println floats(graph.HarmonicCentrality(g))
    println floats(graph.BetweennessCentrality(g))
    println floats(graph.EdgeBetweenness(g))
    println floats(graph.EigenvectorCentrality(g, 200, 0.000001))
    println floats(graph.KatzCentrality(g, 0.1, 1.0, 200, 0.000001))
    mut web := graph.FromEdgeList("0 1\n1 2\n2 0\n3 2", 4, true)
    rank := graph.PageRank(web, 0.85, 100, 0.000001)
    println floats(rank), graph.TopNode(rank)
    println floats(graph.InDegreeCentrality(web)), floats(graph.OutDegreeCentrality(web))
    mut hubs := Vector {} as Vector<f64>
    mut auth := Vector {} as Vector<f64>
    graph.HITS(web, 100, 0.000001, hubs, auth)
    println graph.TopNode(auth)
    mut score := Vector {} as Vector<f64>
    graph.FillFloat(score, 4, 2.0)
    graph.ScaleToSum(score)
    println floats(score)

    mut path := graph.PathGraph(3)
    adj := graph.AdjacencyMatrix(path)
    println adj.rows, adj.at(0, 1), adj.trace(), adj.row_sum(1)
    println graph.WeightMatrix(path).at(1, 2), graph.DegreeMatrix(path).at(1, 1), graph.LaplacianMatrix(path).at(1, 1), round(graph.NormalizedLaplacian(path).at(0, 1)), graph.IncidenceMatrix(path).cols
    mut m := graph.NewMatrix(2, 2)
    m.set(0, 0, 2.0)
    m.add_at(1, 1, 3.0)
    println graph.Determinant(m), graph.MatrixMultiply(m, graph.MatrixIdentity(2)).at(1, 1), graph.MatrixPower(m, 2).at(0, 0)
    println floats(graph.SymmetricEigenvalues(m)), floats(graph.AdjacencySpectrum(path)), floats(graph.LaplacianSpectrum(path))
    println round(graph.SpectralRadius(path)), round(graph.AlgebraicConnectivity(path))
    mut im := graph.NewIntMatrix(2, 2, 7)
    im.set(0, 1, 3)
    println im.at(0, 1), im.at(1, 1), im.rows
    m.free()
    im.free()

    mut a := graph.CycleGraph(5)
    mut b := graph.PetersenGraph()
    mut mapping := Vector {} as Vector<int>
    println graph.Isomorphic(a, graph.CycleGraph(5)), graph.IsomorphismMap(a, graph.CycleGraph(5), mapping), graph.AutomorphismCount(a), graph.SameDegreeSequence(a, b)
    println graph.IsGraphical(list("2 2 2")), graph.IsGraphical(list("3 1")), graph.HavelHakimi(list("2 2 2")).size()

    mut heap := graph.MinHeap {}
    heap.push(3.0, 30)
    heap.push(1.0, 10)
    heap.push(2.0, 20)
    println heap.size(), heap.top_key(), heap.top_value(), heap.pop(), heap.pop(), heap.is_empty()
    heap.clear()
    println heap.is_empty()
    heap.free()
    mut sets := graph.NewDisjointSet(5)
    println sets.union(0, 1), sets.union(1, 2), sets.union(0, 2), sets.connected(0, 2), sets.set_size(0), sets.count(), sets.find(2) == sets.find(0)
    sets.reset(3)
    println sets.count()
    sets.free()
    mut nums := Vector {} as Vector<int>
    graph.Iota(nums, 4)
    graph.ReverseInt(nums)
    println ints(nums), graph.MaxInt(nums), graph.SumInt(nums)
    graph.FillInt(nums, 3, 7)
    mut fl := Vector {} as Vector<f64>
    graph.FillFloat(fl, 2, 1.5)
    println ints(nums), graph.SumFloat(fl)
end
