import graph

func list(text: str): Vector<int>:
    mut out := Vector {} as Vector<int>
    each num in text.split(" "):
        out.push(num.to_int())
    end
    ret out
end


func ints(v: Vector<int>): str:
    mut text := "["
    repeat v.len() in i:
        if i > 0:
            text += " "
        end
        text += "" + v.get(i)
    end
    ret text + "]"
end


func main:
    mut g := graph.NewUndirected(4)
    _ := g.add_edge(0, 1)
    _ := g.add_weighted(1, 2, 2.5)
    e := g.add_edge(2, 3)
    r := g.add_node()
    g.add_nodes(1)
    _ := g.add_edge(3, r)
    g.set_weight(e, 4.0)
    g.set_name(0, "Tehran")
    g.build()
    println g.order(), g.size(), g.name(0), g.directed, g.built
    println g.edge_from(e), g.edge_to(e), g.edge_weight(e), g.weight_between(1, 2), g.has_edge(2, 1), g.find_edge(0, 3)
    println g.degree(2), g.out_degree(2), g.in_degree(2), ints(g.neighbors(2))
    repeat g.adj_start(1) to g.adj_stop(1) in k:
        println g.adj_node(k), g.adj_edge(k), g.adj_weight(k)
    end

    mut d := graph.NewDirected(3)
    _ := d.add_edge(0, 1)
    _ := d.add_edge(1, 2)
    _ := d.add_edge(2, 2)
    _ := d.add_edge(0, 1)
    d.build()
    repeat d.in_start(1) to d.in_stop(1) in k:
        println "in", d.in_node(k), d.in_edge(k)
    end
    println graph.SelfLoopCount(d), graph.HasSelfLoop(d), graph.ParallelEdgeCount(d), graph.IsSimple(d)
    mut simple := graph.Simplify(d)
    mut noloops := graph.RemoveSelfLoops(d)
    println simple.size(), noloops.size(), graph.TotalWeight(g)
    println graph.Transpose(d).has_edge(1, 0), graph.Reverse(d).has_edge(2, 1), graph.ToUndirected(d).directed, graph.ToDirected(g).size()
    general := graph.New(2, true)
    println general.directed, graph.Clone(g).size()
    mut keep := Vector {} as Vector<bool>
    graph.FillBool(keep, g.order(), true)
    keep.set(0, false)
    mut mapping := Vector {} as Vector<int>
    println graph.Subgraph(g, keep).order(), graph.SubgraphMap(g, keep, mapping).size(), ints(mapping)
    mut edges := Vector {} as Vector<bool>
    graph.FillBool(edges, g.size(), false)
    edges.set(0, true)
    println graph.EdgeSubgraph(g, edges).size(), graph.Complement(graph.PathGraph(4)).size()
    mut a := graph.PathGraph(3)
    mut b := graph.CycleGraph(3)
    println graph.Union(a, b).size(), graph.DisjointUnion(a, b).order(), graph.Intersection(a, b).size(), graph.LineGraph(b).size()

    sources := list("0 1 2")
    targets := list("1 2 0")
    mut fromedges := graph.FromEdges(3, sources, targets, true)
    println fromedges.size()
    mut text := graph.FromEdgeList("0 1 2.5\n1 2", 3, false)
    println text.weight_between(0, 1)
    println graph.ToEdgeList(text)
    println graph.ToAdjacencyList(text)
    println graph.ToMatrixText(text)
    println graph.ToDot(text)
    println graph.ToMermaid(text)
    println graph.ToJSON(text)
    println graph.Describe(text)
    println graph.IsClose(0.1 + 0.2, 0.3), graph.GRAPH_INF > 1000.0, graph.GRAPH_NONE

    println graph.EmptyGraph(3).size(), graph.CompleteGraph(4).size(), graph.CompleteBipartite(2, 3).size(), graph.StarGraph(4).size(), graph.WheelGraph(5).size()
    println graph.GridGraph(2, 3).size(), graph.HypercubeGraph(3).size(), graph.PetersenGraph().size(), graph.CirculantGraph(6, list("1 2")).size(), graph.BalancedTree(2, 2).order()
    println graph.ErdosRenyi(10, 0.5).order(), graph.RandomGraph(10, 15).size(), graph.RandomTree(8).size(), graph.BarabasiAlbert(20, 2).order(), graph.WattsStrogatz(20, 4, 0.1).order()
    g.free()
end
