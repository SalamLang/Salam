import graph

func list(text: str): Vector<int>:
    mut out := Vector {} as Vector<int>
    each num in text.split(" "):
        out.push(num.to_int())
    end
    ret out
end


func ints(v: Vector<int>): str:
    mut text := "["
    repeat v.len() in i:
        if i > 0:
            text += " "
        end
        text += "" + v.get(i)
    end
    ret text + "]"
end


func main:
    mut net := graph.NewFlowNet(4)
    e := net.add_arc(0, 1, 3.0)
    _ := net.add_arc(0, 2, 2.0)
    _ := net.add_arc(1, 3, 2.0)
    _ := net.add_arc(2, 3, 3.0)
    _ := net.add_edge(1, 2, 1.0)
    println net.arc_count(), graph.MaxFlow(net, 0, 3), net.flow_on(e)
    net.reset()
    println graph.MaxFlowEdmondsKarp(net, 0, 3)
    net.reset()
    mut side := Vector {} as Vector<bool>
    println graph.MinCut(net, 0, 3, side), side.get(0), side.get(3)
    mut costly := graph.NewFlowNet(3)
    _ := costly.add_cost_arc(0, 1, 2.0, 1.0)
    _ := costly.add_cost_arc(0, 2, 2.0, 5.0)
    _ := costly.add_cost_arc(1, 2, 1.0, 1.0)
    mut sent := 0.0
    println graph.MinCostFlow(costly, 0, 2, 2.0, sent), sent
    net.free()
    mut roads := graph.FromEdgeList("0 1 3\n0 2 2\n1 3 2\n2 3 3\n1 2 1", 4, true)
    mut cut := Vector {} as Vector<int>
    println graph.MaxFlowValue(roads, 0, 3), graph.MinCutEdges(roads, 0, 3, cut), ints(cut), graph.FlowFromGraph(roads).n
    mut ring := graph.CycleGraph(5)
    println graph.GlobalMinCut(ring), graph.EdgeConnectivity(ring), graph.VertexConnectivity(graph.CompleteGraph(4))

    mut bip := graph.FromEdgeList("0 3\n0 4\n1 3\n2 5", 6, false)
    mut mate := Vector {} as Vector<int>
    println graph.BipartiteMatching(bip, mate), ints(mate), graph.MaximalMatching(ring, mate)
    mut cover := Vector {} as Vector<bool>
    println graph.MinimumVertexCover(bip, cover), graph.MaximumIndependentSetBipartite(bip, cover), graph.GreedyVertexCover(ring, cover)
    println ints(graph.MaxClique(graph.CompleteGraph(4))), graph.CliqueNumber(ring), ints(graph.MaximumIndependentSet(ring)), graph.IndependenceNumber(ring), graph.VertexCoverNumber(ring)

    color := graph.GreedyColoringNatural(ring)
    println ints(color), graph.ColorCount(color), graph.IsProperColoring(ring, color), graph.ChromaticNumber(ring), graph.ChromaticNumber(graph.PetersenGraph())
    println ints(graph.GreedyColoring(ring, list("4 3 2 1 0"))), ints(graph.WelshPowell(ring)), ints(graph.DSatur(ring))
    println ints(graph.EdgeColoringGreedy(graph.StarGraph(4))), graph.CountColorings(graph.PathGraph(3), 3)

    mut social := graph.FromEdgeList("0 1\n1 2\n2 0\n3 4\n4 5\n5 3\n2 3", 6, false)
    mut alive := Vector {} as Vector<bool>
    println graph.KCore(social, 2, alive), ints(graph.CoreNumbers(social)), graph.Degeneracy(social)
    mut group := Vector {} as Vector<int>
    println graph.Louvain(social, group), ints(group)
    println (graph.Modularity(social, group) * 100.0 + 0.5) as int
    println graph.LabelPropagation(social, group) >= 1, graph.GirvanNewman(social, 2, group), ints(group)
end
