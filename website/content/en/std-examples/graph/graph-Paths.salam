import graph

func list(text: str): Vector<int>:
    mut out := Vector {} as Vector<int>
    each num in text.split(" "):
        out.push(num.to_int())
    end
    ret out
end


func ints(v: Vector<int>): str:
    mut text := "["
    repeat v.len() in i:
        if i > 0:
            text += " "
        end
        text += "" + v.get(i)
    end
    ret text + "]"
end


func floats(v: Vector<f64>): str:
    mut text := "["
    repeat v.len() in i:
        if i > 0:
            text += " "
        end
        text += "" + ((v.get(i) * 100.0 + 100000.5) as int - 100000)
    end
    ret text + "]/100"
end

func main:
    mut cities := graph.FromEdgeList("0 1 4\n0 2 1\n2 1 2\n1 3 1\n2 3 5", 4, false)
    mut dist := Vector {} as Vector<f64>
    mut parent := Vector {} as Vector<int>
    println graph.Dijkstra(cities, 0, dist, parent), floats(dist), ints(parent)
    println floats(graph.DijkstraDist(cities, 0)), ints(graph.ShortestPath(cities, 0, 3)), graph.ShortestPathLength(cities, 0, 3)
    mut guess := Vector {} as Vector<f64>
    graph.FillFloat(guess, 4, 0.0)
    println ints(graph.AStar(cities, 0, 3, guess)), floats(graph.KShortestLengths(cities, 0, 3, 3))
    floyd := graph.FloydWarshall(cities)
    mut next := graph.NewIntMatrix(0, 0, 0)
    floyd2 := graph.FloydWarshallPaths(cities, next)
    println floyd.at(0, 3), floyd2.at(3, 0), ints(graph.FloydPath(next, 0, 3)), graph.Johnson(cities).at(0, 1)
    mut zeroone := graph.FromEdgeList("0 1 0\n1 2 1\n0 2 1", 3, true)
    println graph.ZeroOneBFS(zeroone, 0, dist, parent), floats(dist)

    mut negative := graph.FromEdgeList("0 1 1\n1 2 -2\n2 0 0.5", 3, true)
    println graph.BellmanFord(negative, 0, dist, parent), graph.HasNegativeCycle(negative), ints(graph.FindNegativeCycle(negative))

    mut project := graph.FromEdgeList("0 1 3\n0 2 2\n1 3 4\n2 3 1", 4, true)
    println graph.DAGShortestPath(project, 0, dist, parent), floats(dist)
    println graph.DAGLongestPath(project, 0, dist, parent), floats(dist), ints(graph.CriticalPath(project))
    println graph.CountPaths(project, 0, 3), floats(graph.PathCounts(project, 0))
    closure := graph.TransitiveClosure(project)
    println closure.at(0, 3), closure.at(3, 0), graph.TransitiveReduction(graph.FromEdgeList("0 1\n1 2\n0 2", 3, true)).size()
    mut layer := Vector {} as Vector<int>
    println graph.TopologicalLayers(project, layer), ints(layer), graph.IsTotalOrder(graph.FromEdgeList("0 1\n1 2", 3, true))
    println graph.WalkCount(graph.CycleGraph(4), 2, 0, 0)

    mut ring := graph.CycleGraph(4)
    println graph.HasEulerianCircuit(ring), ints(graph.EulerianCircuit(ring)), graph.HasEulerianPath(graph.PathGraph(3)), ints(graph.EulerianPath(graph.PathGraph(3)))
    println graph.HasHamiltonianCycle(ring), ints(graph.HamiltonianCycle(ring)), ints(graph.HamiltonianPath(graph.PathGraph(3)))
    mut full := graph.NewUndirected(4)
    each edge in ["0 1 1", "0 2 4", "0 3 3", "1 2 2", "1 3 5", "2 3 1"]:
        mut parts := list(edge)
        _ := full.add_weighted(parts.get(0), parts.get(1), parts.get(2) as f64)
    end
    full.build()
    mut tour := graph.TSPNearestNeighbor(full, 0)
    println ints(tour), graph.TourLength(full, tour), graph.TSPTwoOpt(full, tour), graph.TourLength(full, graph.TSPHeuristic(full, 0))
end
