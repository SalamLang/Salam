import graph

func ints(v: Vector<int>): str:
    mut text := "["
    repeat v.len() in i:
        if i > 0:
            text += " "
        end
        text += "" + v.get(i)
    end
    ret text + "]"
end


func main:
    mut g := graph.FromEdgeList("0 1\n1 2\n2 0\n2 3\n4 5", 6, false)
    println ints(graph.BFS(g, 0)), ints(graph.BFSOrder(g, 0)), ints(graph.DFSOrder(g, 0)), ints(graph.DFSPostOrder(g, 0))
    mut dist := Vector {} as Vector<int>
    mut parent := Vector {} as Vector<int>
    graph.BFSFrom(g, 0, dist, parent)
    println ints(dist), ints(graph.PathFromParents(parent, 0, 3)), ints(graph.DFSForest(g))
    println graph.ReachableCount(g, 0), graph.Reachable(g, 4).get(5), graph.HopDistance(g, 0, 3), graph.HopDistance(g, 0, 4), ints(graph.HopPath(g, 1, 3))
    mut comp := Vector {} as Vector<int>
    println graph.Components(g, comp), ints(comp), graph.ComponentCount(g), ints(graph.ComponentSizes(g)), graph.IsConnected(g)
    mut color := Vector {} as Vector<int>
    println graph.IsBipartite(graph.CycleGraph(4), color), ints(color), graph.Bipartite(g)
    println ints(graph.FindCycle(g)), graph.HasCycle(g)
    println ints(graph.Bridges(g)), ints(graph.ArticulationPoints(g))
    mut bicomp := Vector {} as Vector<int>
    println graph.BiconnectedComponents(g, bicomp), ints(bicomp), graph.IsBiconnected(graph.CycleGraph(5)), graph.IsTwoEdgeConnected(graph.CycleGraph(5))
    mut twoedge := Vector {} as Vector<int>
    println graph.TwoEdgeComponents(g, twoedge), ints(twoedge)
    hops := graph.AllPairsHops(graph.PathGraph(3))
    println hops.at(0, 2), hops.rows

    mut tasks := graph.FromEdgeList("0 1\n0 2\n1 3\n2 3\n3 4", 5, true)
    mut order := Vector {} as Vector<int>
    println graph.TopologicalSort(tasks, order), ints(order)
    println graph.TopologicalSortLex(tasks, order), ints(order), graph.IsDAG(tasks)
    mut cyclic := graph.FromEdgeList("0 1\n1 2\n2 0\n2 3\n3 4\n4 3", 5, true)
    mut strong := Vector {} as Vector<int>
    println graph.StronglyConnected(cyclic, strong), ints(strong), graph.SCCCount(cyclic), graph.IsStronglyConnected(cyclic)
    mut kosa := Vector {} as Vector<int>
    println graph.Kosaraju(cyclic, kosa)
    dag := graph.Condensation(cyclic, strong)
    println dag.order(), dag.size()
end
