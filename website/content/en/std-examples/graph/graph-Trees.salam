import graph

func ints(v: Vector<int>): str:
    mut text := "["
    repeat v.len() in i:
        if i > 0:
            text += " "
        end
        text += "" + v.get(i)
    end
    ret text + "]"
end


func main:
    mut net := graph.FromEdgeList("0 1 4\n0 2 1\n1 2 2\n1 3 5\n2 3 8\n3 4 3", 5, false)
    mut chosen := Vector {} as Vector<int>
    println graph.Kruskal(net, chosen), ints(chosen)
    println graph.MaximumSpanningTree(net, chosen), ints(chosen)
    mut parent := Vector {} as Vector<int>
    println graph.Prim(net, 0, parent), ints(parent), graph.Boruvka(net, chosen), graph.MSTWeight(net)
    mut tree := graph.MinimumSpanningTree(net)
    println tree.size(), graph.IsTree(tree), graph.IsForest(tree), graph.IsTree(net), graph.SpanningAgreement(net), graph.SpanningTreeCount(graph.CompleteGraph(4))

    mut order := Vector {} as Vector<int>
    graph.RootTree(tree, 0, parent, order)
    println ints(parent), ints(order), ints(graph.SubtreeSizes(tree, 0))
    mut ends := Vector {} as Vector<int>
    println graph.TreeDiameter(tree, ends), ints(ends), ints(graph.TreeCenter(tree)), ints(graph.TreeCentroid(tree))
    mut lca := graph.BuildLCA(tree, 0)
    println graph.LCA(lca, 3, 4), graph.LCA(lca, 4, 2), graph.TreeDistance(lca, 4, 2), lca.ancestor(0, 4), lca.n, lca.levels > 0
    lca.free()

    code := graph.PruferEncode(tree)
    println ints(code), graph.PruferDecode(code).size(), graph.LabeledTreeCount(5)
    println graph.TreeIsomorphic(graph.PathGraph(4), graph.StarGraph(4)), graph.TreeIsomorphic(tree, graph.PruferDecode(code))
    println graph.TreeCanonicalForm(graph.StarGraph(3)), graph.TreeToString(tree, 0)
end
