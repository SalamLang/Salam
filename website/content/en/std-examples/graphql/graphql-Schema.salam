import graphql

func main:
    mut s := graphql.NewSchema()
    graphql.AddScalarType(s, "Date", "A date as YYYY-MM-DD")
    graphql.AddInterfaceType(s, "Node", "")
    _ := graphql.AddField(s, "Node", "id", "ID!")
    graphql.AddObjectType(s, "Author", "An author")
    graphql.AddInterfaceTo(s, "Author", "Node")
    _ := graphql.AddField(s, "Author", "id", "ID!")
    _ := graphql.AddField(s, "Author", "name", "String!")
    _ := graphql.AddField(s, "Author", "born", "Date")
    mut genres := Vector {} as Vector<str>
    genres.push("NOVEL")
    genres.push("POETRY")
    graphql.AddEnumType(s, "Genre", genres)
    mut members := Vector {} as Vector<str>
    members.push("Author")
    graphql.AddUnionType(s, "SearchResult", members)
    graphql.AddInputObjectType(s, "AuthorInput", "")
    _ := graphql.AddInputField(s, "AuthorInput", "name", "String!")
    graphql.AddObjectType(s, "Query", "")
    _ := graphql.AddField(s, "Query", "authors", "[Author!]!")
    _ := graphql.AddField(s, "Query", "search", "[SearchResult!]!")
    _ := graphql.AddFieldArg(s, "Query", "search", "text", "String!")
    _ := graphql.AddFieldArg(s, "Query", "search", "genre", "Genre")
    graphql.AddObjectType(s, "Mutation", "")
    _ := graphql.AddField(s, "Mutation", "addAuthor", "Author!")
    _ := graphql.AddFieldArg(s, "Mutation", "addAuthor", "input", "AuthorInput!")
    graphql.SetRootTypes(s, "Query", "Mutation", "")
    print graphql.PrintSchema(s)
    println "---"
    println graphql.PrintType(s, "Genre")

    println graphql.HasType(s, "Author"), graphql.TypeIndex(s, "Author") >= 0, graphql.TypeCount(s) > 5
    t := graphql.FindType(s, "Author")
    println t.name, t.kind == graphql.TYPE_OBJECT, t.description, graphql.HasField(t, "born")
    f := graphql.FindField(graphql.FindType(s, "Query"), "search")
    println f.name, graphql.FindArg(f, "genre").name, graphql.FindArg(f, "genre").hasDefault
    println graphql.FindInputField(graphql.FindType(s, "AuthorInput"), "name").name
    println graphql.HasEnumValue(graphql.FindType(s, "Genre"), "POETRY")
    println graphql.IsInputType(s, "AuthorInput"), graphql.IsOutputType(s, "AuthorInput"), graphql.IsLeafType(s, "Genre")
    println graphql.IsAbstractType(s, "SearchResult"), graphql.IsPossibleType(s, "Node", "Author"), graphql.PossibleTypes(s, "Node").len()
    println graphql.RootTypeName(s, graphql.OP_MUTATION), graphql.RootTypeName(s, graphql.OP_SUBSCRIPTION).len()
    println graphql.FindDirectiveDef(s, "deprecated").name
    println graphql.TypeAt(s, 0).name.len() > 0
    println graphql.IsIntrospectionType("__Schema"), graphql.IsIntrospectionType("Author")
    graphql.AddIntrospectionTypes(s)
    println graphql.HasType(s, "__Type"), graphql.PrintSchemaFull(s).len() > graphql.PrintSchema(s).len()
    println graphql.TypeRefText(s, "[Int!]") >= 0

    println graphql.ParseSchemaOk("type Query { a: Int }"), graphql.ParseSchemaOk("type {")
    mut err := graphql.NewError(graphql.ERR_SYNTAX, "")
    graphql.ParseSchemaInto(s, "extend type Author { alias: String }", err)
    println graphql.HasField(graphql.FindType(s, "Author"), "alias"), err.message.len()
    println graphql.TYPE_SCALAR, graphql.TYPE_INTERFACE, graphql.TYPE_UNION, graphql.TYPE_ENUM, graphql.TYPE_INPUT_OBJECT
    graphql.FreeSchema(s)
end
