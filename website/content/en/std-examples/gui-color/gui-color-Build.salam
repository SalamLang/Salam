import gui.color

func main:
    println color.Css(color.Rgb(51, 102, 170))
    println color.Css(color.Rgba(51, 102, 170, 0.5))
    println color.Css(color.Hex(0x3366aa))
    println color.Css(color.New(0.2, 0.4, 0.6, 1.0))
    println color.Css(color.Hsl(210.0, 0.5, 0.4))
    println color.Css(color.Hwb(194.0, 0.0, 0.0))
    println color.Css(color.Lab(29.2345, 39.3825, 20.0664))
    println color.Css(color.Lch(52.2345, 72.2, 56.2))
    println color.Css(color.Oklab(0.40101, 0.1147, 0.0453))
    println color.Css(color.Oklch(0.7, 0.25, 30.0))
    println color.Css(color.Cmyk(0.0, 0.4, 0.6, 0.1))
    println color.Css(color.WithAlpha(color.Hex(0x3366aa), 0.25))
    println color.Css(color.Current())
end
