import gui.color

func main:
    c := color.LightDark(color.Hex(0x3366aa), color.Rgb(200, 220, 255))
    println color.Css(c), color.HasDark(c), color.HasDark(color.Hex(0x3366aa))
    println "light", color.Css(color.Light(c)), "dark", color.Css(color.Dark(c))
    println "fields", c.has_dark, c.dark_r, c.dark_g, c.dark_b, c.dark_a, c.dark_current
    mut t := color.Color {}
    if color.Parse("light dark(current, white)", t):
        println color.Css(t), t.current, t.dark_current
    end
    println "mix keeps both", color.Css(color.Mix(c, color.Hex(0xffffff), 0.5))
end
