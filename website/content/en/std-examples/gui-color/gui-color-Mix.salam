import gui.color

func main:
    red := color.Hex(0xff0000)
    blue := color.Hex(0x0000ff)
    println "Mix 30%", color.Css(color.Mix(red, blue, 0.3))
    each space in ["oklab", "oklch", "srgb", "hsl"]:
        println "MixIn", space, color.Css(color.MixIn(red, blue, 0.5, space))
    end
    clear := color.Rgba(255, 0, 0, 0.0)
    repeat 5 in i:
        t := i as f64 / 4.0
        println "Lerp", t, color.Css(color.Lerp(clear, blue, t))
    end
end
