import gui.color

func main:
    each text in ["#3366aa", "rgb(51, 102, 170)", "hsl(210, 50%, 40%)", "oklch(0.7 0.25 30)", "light dark(white, #222)", "قرمز", "rgb(51, 102)", "redd"]:
        mut c := color.Color {}
        if color.Parse(text, c):
            println text, "=>", color.Css(c)
        else:
            println text, "=>", color.Error(text)
        end
    end
end
