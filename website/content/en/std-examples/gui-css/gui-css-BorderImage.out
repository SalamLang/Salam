source: linear-gradient(45deg, rgb(255, 0, 0), rgb(0, 0, 255))
slice: 30% 30% 30% 30% fill true
width: true 2 2 2 2
outset: 4px 4px 4px 4px
repeat: true true true
gradient space: 11 hue: 0 written: true
stops at paint time: 81 rgb(237, 118, 101) at 0 to rgb(66, 132, 197) at 200
legacy: false transition midpoint: rgb(163, 132, 154)
