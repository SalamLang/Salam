import gui.css

func main:
    mut sheet := css.NewSheet()
    defer sheet.Free()
    mut els := Vector {} as Vector<css.Element>
    mut card := css.NewElement("box", -1)
    card.base = "border: 8px solid; border-image: linear-gradient(45deg, red, blue) 30% fill / 2 / 4px round stretch; background: linear-gradient(90deg in oklch, oklch(70% 0.15 30), 25%, oklch(60% 0.12 250))"
    els.push(card)
    _n := sheet.Compute(els, css.Env {})
    cs := sheet.Style(0)
    bi := cs.border_image
    println "source:", css.ValueText(cs, "border-image-source")
    println "slice:", css.LenText(bi.slice_top), css.LenText(bi.slice_right), css.LenText(bi.slice_bottom), css.LenText(bi.slice_left), "fill", bi.fill
    println "width:", bi.width_top.kind == css.LenKind.Number, bi.width_top.px, bi.width_right.px, bi.width_bottom.px, bi.width_left.px
    println "outset:", css.LenText(bi.outset_top), css.LenText(bi.outset_right), css.LenText(bi.outset_bottom), css.LenText(bi.outset_left)
    println "repeat:", bi.repeat_x == css.Repeat.Round, bi.repeat_y == css.Repeat.Stretch, bi.source.image == css.ImageKind.Linear
    bg := cs.backgrounds[0]
    println "gradient space:", bg.interpolation, "hue:", bg.hue_interpolation, "written:", bg.interpolation_set
    mut stops := css.GradientStops(bg, 200.0)
    first := stops[0]
    last := stops[stops.len() - 1]
    println "stops at paint time:", stops.len(), css.ColorText(first.color), "at", first.pos.px, "to", css.ColorText(last.color), "at", last.pos.px
    stops.free()
    mut a := css.Color {}
    mut b := css.Color {}
    _x := css.ParseColor("oklch(70% 0.15 30)", a)
    _y := css.ParseColor("oklch(60% 0.12 250)", b)
    m := css.MixColors(a, b, 0.5)
    println "legacy:", a.legacy, "transition midpoint:", css.ColorText(m)
    els[0].Free()
    els.free()
end
