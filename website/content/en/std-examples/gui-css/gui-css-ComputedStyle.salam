import gui.css

func main:
    mut sheet := css.NewSheet()
    defer sheet.Free()
    mut els := Vector {} as Vector<css.Element>
    mut root := css.NewElement("page", -1)
    root.base = "color: #222; font: 16px/1.5 Vazirmatn, sans-serif"
    els.push(root)
    mut card := css.NewElement("box", 0)
    card.base = `display: flex; position: relative; top: 4px; flex-flow: row wrap; gap: 8px 2%; padding: 12px 16px; margin: 0 auto; border: 2px solid #ccc; border-radius: 12px; background: linear-gradient(to right, #fff 0%, #eee 100%), url(bg.png) center / cover no-repeat, #fafafa; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2); outline: 1px dashed red; outline-offset: 2px; opacity: 0.9; transform: rotate(5deg) scale(1.1); transform-origin: left top; translate: 4px 2px; rotate: 10deg; scale: 2; transition: opacity 300ms ease-out 100ms; cursor: pointer; z-index: 3; text-align: center; text-shadow: 1px 1px 2px black; letter-spacing: 1px; word-spacing: 2px; text-decoration: underline overline line-through wavy red 2px; list-style: square inside; caret-color: blue; accent-color: green; color-scheme: light dark; aspect-ratio: 4 / 3; overflow: hidden auto; white-space: nowrap; text-overflow: ellipsis; word-break: break-all; overflow-wrap: anywhere; tab-size: 4; vertical-align: middle; float: left; clear: both; user-select: none; pointer-events: none; visibility: visible; object-fit: cover; object-position: right bottom; border-collapse: collapse; border-spacing: 2px 4px; table-layout: fixed; appearance: none; font-style: italic; font-variant-caps: small-caps; font-stretch: condensed; text-transform: uppercase; text-indent: 1em; order: 2; flex-grow: 1; flex-shrink: 0; flex-basis: 50%; justify-content: center; align-items: stretch; align-self: flex-start; align-content: space-around; justify-items: start; justify-self: end; box-sizing: border-box; direction: ltr; min-width: 100px; max-width: 800px; min-height: 2em; max-height: none; width: 50%; height: auto; right: auto; bottom: auto; left: 0`
    els.push(card)
    _n := sheet.Compute(els, css.Env {})
    cs := sheet.Style(1)
    println cs.display, cs.position, css.LenText(cs.top), css.LenText(cs.right), css.LenText(cs.bottom), css.LenText(cs.left)
    println cs.box_sizing, css.LenText(cs.width), css.LenText(cs.height), css.LenText(cs.min_width), css.LenText(cs.min_height), css.LenText(cs.max_width)
    println css.LenText(cs.max_height), cs.aspect_ratio, css.LenText(cs.margin_top), css.LenText(cs.margin_right), css.LenText(cs.margin_bottom), css.LenText(cs.margin_left)
    println css.LenText(cs.padding_top), css.LenText(cs.padding_right), css.LenText(cs.padding_bottom), css.LenText(cs.padding_left), cs.border_top.width, cs.border_top.style
    println css.ColorText(cs.border_top.color), cs.border_right.width, cs.border_right.style, css.ColorText(cs.border_right.color), cs.border_bottom.width, cs.border_bottom.style
    println css.ColorText(cs.border_bottom.color), cs.border_left.width, cs.border_left.style, css.ColorText(cs.border_left.color), css.LenText(cs.radius_top_left.h), css.LenText(cs.radius_top_left.v)
    println css.LenText(cs.radius_top_right.h), css.LenText(cs.radius_top_right.v), css.LenText(cs.radius_bottom_right.h), css.LenText(cs.radius_bottom_right.v), css.LenText(cs.radius_bottom_left.h), css.LenText(cs.radius_bottom_left.v)
    println cs.overflow_x, cs.overflow_y, cs.direction, cs.flex_direction, cs.flex_wrap, cs.flex_grow
    println cs.flex_shrink, css.LenText(cs.flex_basis), cs.justify_content, cs.align_items, cs.align_self, cs.align_content
    println cs.justify_items, cs.justify_self, css.LenText(cs.row_gap), css.LenText(cs.column_gap), cs.order, cs.z_index
    println cs.z_auto, cs.float_mode, cs.clear, cs.vertical_align, css.LenText(cs.vertical_align_len), css.ColorText(cs.color)
    println css.ColorText(cs.background_color), cs.backgrounds.len(), cs.box_shadows.len(), cs.outline.width, cs.outline.style, css.ColorText(cs.outline.color)
    println cs.outline_offset, cs.opacity, cs.transforms.len(), css.LenText(cs.transform_origin_x), css.LenText(cs.transform_origin_y), css.LenText(cs.translate_x)
    println css.LenText(cs.translate_y), cs.rotate, cs.scale_x, cs.scale_y, cs.visibility, "[" + cs.cursor + "]"
    println cs.pointer_events, cs.user_select, "[" + cs.font_family + "]", cs.font_size, cs.font_size_keyword, cs.font_weight
    println cs.font_style, cs.small_caps, cs.font_stretch, cs.line_height, cs.line_height_factor, cs.line_height_normal
    println cs.letter_spacing, cs.word_spacing, cs.text_align, css.LenText(cs.text_indent), cs.text_transform, cs.white_space
    println cs.underline, cs.overline, cs.line_through, cs.decoration_style, css.ColorText(cs.decoration_color), css.LenText(cs.decoration_thickness)
    println cs.text_shadows.len(), cs.text_overflow, cs.word_break, cs.overflow_wrap, cs.tab_size, cs.tab_size_px
    println "[" + cs.list_style_type + "]", cs.list_style_position, "[" + cs.list_style_image + "]", cs.border_collapse, cs.border_spacing_x, cs.border_spacing_y
    println cs.table_layout, cs.transitions.len(), css.ColorText(cs.caret_color), css.ColorText(cs.accent_color), cs.accent_auto, "[" + cs.appearance + "]"
    println cs.color_scheme, cs.used_dark, cs.object_fit, css.LenText(cs.object_position_x), css.LenText(cs.object_position_y)
    l := cs.backgrounds[0]
    println l.image, l.url.len(), l.repeating, l.angle, l.to_x, l.to_y, l.shape, l.extent, css.LenText(l.radius_x), css.LenText(l.radius_y), css.LenText(l.center_x), css.LenText(l.center_y)
    println l.stops.len(), css.LenText(l.position_x), css.LenText(l.position_y), l.size_kind, css.LenText(l.size_w), css.LenText(l.size_h), l.repeat_x, l.repeat_y, l.clip, l.origin, l.fixed
    st := l.stops[1]
    println css.ColorText(st.color), css.LenText(st.pos), st.has_pos, st.hint
    u := cs.backgrounds[1]
    println u.image, u.url, u.size_kind, u.repeat_x
    s := cs.box_shadows[0]
    println s.x, s.y, s.blur, s.spread, css.ColorText(s.color), s.inset
    f := cs.transforms[1]
    println f.kind, css.LenText(f.x), css.LenText(f.y), f.a, f.b, f.c, f.d, f.e, f.f
    t := cs.transitions[0]
    println t.property, t.duration, t.delay, t.timing.kind
    repeat els.len() in i:
        mut x := els.ref(i)
        x.Free()
    end
    els.free()
end
