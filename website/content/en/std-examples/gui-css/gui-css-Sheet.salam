import gui.css
import mem

func main:
    mut sheet := css.NewSheet()
    defer sheet.Free()
    println "rules", sheet.RuleCount() > 100
    _a := sheet.AddRule(".card > p:first-child", "color: #334155; margin: 0 0 8px")
    _b := sheet.AddMediaRule("(max-width: 600px)", ".card", "padding: 8px")
    println "css rules", sheet.AddCss("@media (prefers-color-scheme: dark) { body { background: #111 } } a:hover { color: red }")
    mut els := Vector {} as Vector<css.Element>
    mut body := css.NewElement("page", -1)
    body.base = "font-family: Vazirmatn, sans-serif; --gap: 12px"
    els.push(body)
    mut card := css.NewElement("box", 0)
    card.id = "main"
    card.classes = "card"
    card.base = "display: flex; gap: var(--gap); padding: 16px"
    card.AddMedia("(min-width: 1200px)", "padding: 32px")
    els.push(card)
    mut p := css.NewElement("paragraph", 1)
    p.AddAttr("lang", "en")
    els.push(p)
    mut link := css.NewElement("link", 1)
    link.AddAttr("href", "/next")
    link.hover = "text-decoration: none"
    link.focus = "outline: 2px solid blue"
    link.active = "color: purple"
    els.push(link)
    println "tag", link.tag, link.kind, link.parent, link.HasAttr("href")
    env := css.Env { width = 800.0, height = 600.0, dark = false, reduced_motion = false, hover = true, fine_pointer = true, dir = "ltr", lang = "en" }
    println "distinct", sheet.Compute(els, env), "elements", sheet.Count()
    cs := sheet.Style(2)
    println "p", css.ValueText(cs, "color"), css.ValueText(cs, "margin-top"), css.ValueText(cs, "margin-bottom")
    println "card", css.ValueText(sheet.Style(1), "column-gap"), css.ValueText(sheet.Style(1), "padding-top")
    println "root", css.ValueText(sheet.RootStyle(), "display"), "same style", sheet.StyleId(2) == sheet.StyleId(2)
    g := sheet.Var(2, "--gap")
    println "var", g
    mem.Free(g as void*)
    println "matches", sheet.Matches("#main > a[href]", els, 3)
    top := css.HoverChain(els, 3)
    println "hovered", els[3].hovered, els[1].hovered, "restyled", sheet.Restyle(els, top)
    println "after hover", css.ValueText(sheet.Style(3), "text-decoration-line"), "cascades", sheet.CascadeCount(), "distinct", sheet.DistinctStyles()
    mut l2 := els.ref(3)
    l2.focused = true
    l2.focus_visible = true
    l2.pressed = true
    _r := sheet.Restyle(els, 3)
    println "focus", css.ValueText(sheet.Style(3), "outline-style"), css.ValueText(sheet.Style(3), "color")
    mut bare := css.EmptySheet()
    defer bare.Free()
    println "empty", bare.RuleCount(), "defaults added", bare.AddDefaults() > 0
    ua := css.DefaultCss()
    println "default css bytes", ua.len() > 1000, css.TagOf("ordered list")
    mem.Free(ua as void*)
    println "media", env.width, env.height, env.dark, env.reduced_motion, env.hover, env.fine_pointer, env.dir, env.lang, "[" + link.id + "]", "[" + link.classes + "]", "[" + link.base + "]"
    repeat els.len() in i:
        mut x := els.ref(i)
        println i, x.attr_names.len(), x.attr_values.len(), x.media_conditions.len(), x.media_declarations.len()
        x.Free()
    end
    els.free()
end
