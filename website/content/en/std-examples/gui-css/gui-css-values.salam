import gui.css
import mem

func main:
    mut c := css.Color {}
    ok := css.ParseColor("hsl(210 80% 50% / 0.5)", c)
    t := css.ColorText(c)
    println ok, c.r, c.g, c.b, c.a, t
    mem.Free(t as void*)
    mut ds := css.ParseDeclarations("margin: 4px 8px; color: red !important; --x: 1")
    repeat ds.Len() in i:
        d := ds[i]
        println d.name, d.value, d.important
    end
    css.FreeDeclarations(ds)
    sp := css.SelectorSpecificity("#nav .item:hover > a")
    println "specificity", sp.ids, sp.classes, sp.types
    env := css.Env { width = 500.0, height = 800.0 }
    println "media", css.MediaMatches("(max-width: 600px) and (orientation: portrait)", env)
    ease := css.Timing {}
    println "ease", ease.kind, ease.x1, ease.y1, ease.x2, ease.y2, ease.steps, ease.step_position, css.EasingAt(ease, 0.5) > 0.8
    steps := css.Timing { kind = css.TimingKind.Steps, steps = 4, step_position = css.StepPosition.JumpEnd }
    println "steps", css.EasingAt(steps, 0.6)
    mut sheet := css.NewSheet()
    defer sheet.Free()
    mut els := Vector {} as Vector<css.Element>
    els.push(css.NewElement("page", -1))
    mut box := css.NewElement("box", 0)
    box.base = "width: calc(100% - 2em); height: min(50vh, 300px); border-radius: 20px / 10px; transform: translate(10px, 0) rotate(90deg); font-family: Vazirmatn, Tahoma, sans-serif; display: flex; padding: 1em"
    els.push(box)
    _n := sheet.Compute(els, env)
    cs := sheet.Style(1)
    w := cs.width
    wtext := css.LenText(w)
    println "width", wtext, w.kind, w.px, w.pct, w.has_pct, w.calc.Len() == 0, css.Resolve(w, 300.0)
    mem.Free(wtext as void*)
    println "needs basis", css.NeedsBasis(cs)
    b := css.ToBox(cs)
    bi := css.ToBoxIn(cs, 300.0, 200.0)
    println "box", b.display, b.width.kind, bi.width.value, bi.height.value
    m := css.TransformMatrix(cs, 100.0, 40.0)
    println "matrix", m.a, m.b, m.c, m.d, m.e, m.f
    r := css.UsedRadii(cs, 30.0, 40.0)
    println "radii", r.top_left_x, r.top_left_y, r.top_right_x, r.top_right_y, r.bottom_right_x, r.bottom_right_y, r.bottom_left_x, r.bottom_left_y
    mut fams := css.FontFamilies(cs)
    println "families", fams.Len(), fams[0], fams[2]
    fams.free()
    v := css.ValueText(cs, "border-top-left-radius")
    println "value text", v
    mem.Free(v as void*)
    repeat els.Len() in i:
        mut x := els.ref(i)
        x.Free()
    end
    els.free()
end
