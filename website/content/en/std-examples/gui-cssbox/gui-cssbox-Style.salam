import gui.cssbox

func main:
    mut st := cssbox.Style {}
    println st.display == cssbox.Display.Block, st.position == cssbox.Position.Static, st.flex_shrink, st.width.kind == cssbox.LengthKind.Auto
    st.width = cssbox.Percent(50.0)
    st.max_width = cssbox.Px(300.0)
    st.min_height = cssbox.MinContent()
    st.height = cssbox.FitContent()
    st.margin = cssbox.AllSides(cssbox.Auto())
    st.padding = cssbox.SidesOf(cssbox.Px(1.0), cssbox.Px(2.0), cssbox.Px(3.0), cssbox.Px(4.0))
    println st.width.value, st.padding.left.value, st.margin.top.kind == cssbox.LengthKind.Auto
    m := cssbox.MaxContent()
    s := cssbox.Stretch()
    println m.kind == cssbox.LengthKind.MaxContent, s.kind == cssbox.LengthKind.Stretch
    sp := cssbox.Definite(120.0)
    println sp.kind == cssbox.SpaceKind.Definite, sp.value, cssbox.MinContentSpace().kind == cssbox.SpaceKind.MinContent
    mut t := cssbox.Tree {}
    defer t.Free()
    root := t.AddNode(cssbox.Style { width = cssbox.Px(200.0), overflow_y = cssbox.Overflow.Scroll, scrollbar_width = 12.0, height = cssbox.Px(50.0), border = cssbox.AllSides(cssbox.Px(3.0)), padding = cssbox.AllSides(cssbox.Px(5.0)) })
    child := t.AddNode(cssbox.Style { height = cssbox.Px(90.0) })
    t.SetMeasure(child, (mi: cssbox.MeasureInput): ret cssbox.MeasuredWithBaseline(mi.known_width, 90.0, 14.0) end)
    t.AddChild(root, child)
    t.Compute(root, cssbox.MaxContentSpace(), cssbox.MaxContentSpace())
    l := t.Layout(root)
    println l.x, l.y, l.abs_x, l.abs_y, l.width, l.height
    println l.content_x, l.content_y, l.content_width, l.content_height
    println l.padding.top, l.padding.right, l.padding.bottom, l.padding.left
    println l.border.top, l.border.right, l.border.bottom, l.border.left, l.margin.top
    println l.scrollbar_width, l.scrollbar_height, l.scroll_width, l.scroll_height, l.has_baseline, l.baseline
end
