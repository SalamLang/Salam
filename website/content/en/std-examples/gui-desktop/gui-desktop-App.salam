import gui.desktop

func main:
    desktop.Init(desktop.Config {
        id = "com.example.app", name = "App", version = "1.0", scheme = "app", assets_dir = "www", pack_path = "", csp = "default-src 'self'", spa = false, debug = false, external_links = true
    })
    if not desktop.SingleInstance((args: Vector<str>): println args.len() end):
        ret
    end
    mut allowed := Vector {} as Vector<str>
    allowed.push("greet")
    desktop.Allow("https://example.com", allowed)
    println desktop.Allowed("https://example.com", "greet"), desktop.OriginOf("https://example.com/a")
    println desktop.SafeAssetPath("/a/"), desktop.DataDir(), desktop.AssetURL("/index.html"), desktop.CurrentConfig().name
    println desktop.PackDir("www", "app.pack", "com.example.app")
    desktop.Command("greet", (c: desktop.Call):
        println c.command, c.args, c.origin, c.window, c.Str("name"), c.Int("n"), c.Bool("b"), c.Has("x")
        c.ResolveStr("hello")
    end)
    desktop.CommandAsync("slow", (c: desktop.Call):
        c.Resolve(`{"ok":true}`)
        c.ResolveInt(1 as i64)
        c.ResolveBool(true)
        c.ResolveNull()
        c.Reject("no")
    end)
    desktop.On("ready", (data: str): desktop.Emit("hello", data) end)
    mut scripts := Vector {} as Vector<str>
    scripts.push("window.started = true")
    mut others := Vector {} as Vector<str>
    others.push("https://example.org")
    w := desktop.Open(desktop.WindowOptions {
        label = "main", title = "App", width = 800, height = 600, min_width = 400, min_height = 300, url = "", html = "", icon = "", resizable = true, center = true, visible = true, context_menu = true, scripts = scripts, allow_navigation = others
    })
    w.OnClose((): ret desktop.Confirm("Close", "Close the window?") end)
    w.OnLoad((url: str, done: bool): println url, done end)
    w.OnCrash((): w.Navigate(desktop.AssetURL("/error.html")) end)
    w.OnResize((x: int, y: int): println x, y end)
    w.SetTitle("App")
    w.SetSize(900, 700)
    w.Show()
    w.Focus()
    w.Hide()
    w.Minimize()
    w.Maximize()
    w.Eval("document.title")
    w.Emit("hello", "1")
    w.SetHTML("<h1>hello</h1>")
    w.OpenDevTools()
    println w.index, w.URL(), w.IsActive(), w.IsClosed(), w.Native() != null, desktop.GetWindow("main").index
    desktop.Dispatch((): println "ui thread" end)
    mut items := Vector {} as Vector<desktop.MenuItem>
    items.push(desktop.Item("open", "Open"))
    items.push(desktop.Separator())
    items.push(desktop.MenuItem { id = "quit", label = "Quit", separator = false })
    mut bar := Vector {} as Vector<desktop.MenuItem>
    bar.push(desktop.Submenu("File", items))
    desktop.SetMenu(w, bar)
    desktop.OnMenu((id: str): println id end)
    println desktop.SetTray("icon.png", "App", items)
    desktop.OnTrayClick((): w.Focus() end)
    desktop.RemoveTray()
    println desktop.PickFolder("Folder"), desktop.PickFile("File", "Text", "*.txt"), desktop.SaveFile("Save", "a.txt")
    desktop.Message("Title", "Text")
    println desktop.Notify("Title", "Text"), desktop.OpenURL("https://example.com")
    desktop.OnNotifyClick((): w.Focus() end)
    desktop.RequestAttention(w)
    println desktop.SecretSet("key", "value"), desktop.SecretGet("key")
    desktop.SecretDelete("key")
    println desktop.LastError()
    desktop.Run()
    desktop.Quit()
    w.Close()
end
