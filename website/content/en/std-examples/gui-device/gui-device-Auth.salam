import gui.device
import gui.ui

func label(): str:
    state := device.AuthStatus()
    if state == device.AuthState.Success:
        ret "unlocked"
    end
    if state == device.AuthState.Pending:
        ret "waiting"
    end
    if state == device.AuthState.Failed:
        ret "not recognised"
    end
    ret "locked"
end

func main:
    if not device.CanAuthenticate():
        println "no biometrics here"
        ret
    end
    device.OnChange((): ui.Invalidate() end)
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder):
        b.Open("button")
        b.On("click", (): _ok := device.Authenticate("Unlock the notes") end)
        b.Text(label())
        b.Close()
    end)
end
