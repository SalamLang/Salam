import gui.device

func main:
    if not device.CanVibrate():
        println "no vibration here"
        ret
    end
    _ok := device.Haptic(device.HapticKind.Tap)
    _ok2 := device.Haptic(device.HapticKind.Success)
    _ok3 := device.Vibrate(200)
end
