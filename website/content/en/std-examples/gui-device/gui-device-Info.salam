import gui.device
import gui.ui

func network_name(): str:
    kind := device.Network()
    if kind == device.NetworkKind.Wifi:
        ret "wifi"
    end
    if kind == device.NetworkKind.Cellular:
        ret "mobile data"
    end
    if kind == device.NetworkKind.Offline:
        ret "offline"
    end
    ret "connected"
end

func main:
    if device.OSName().Len() == 0:
        println "no device info here"
        ret
    end
    device.OnChange((): ui.Invalidate() end)
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder):
        b.Open("button")
        b.Text(device.Model() + ", " + device.OSName() + " " + device.OSVersion())
        b.Close()
        b.Open("button")
        b.Text("battery " + device.BatteryLevel() + "%, " + network_name())
        b.Close()
        b.Open("button")
        b.Text(device.Language() + ", " + device.TimeZone() + ", v" + device.AppVersion())
        b.Close()
    end)
end
