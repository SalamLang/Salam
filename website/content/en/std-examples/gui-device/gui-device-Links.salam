import gui.device
import gui.ui

mut last := ""

func main:
    last = device.LaunchURL()
    if last.Len() == 0 and device.Platform() == "none":
        println "no links here"
        ret
    end
    device.OnOpenURL((url: str): ui.Invalidate() last = url end)
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder):
        b.Open("button")
        b.Text("opened with " + last)
        b.Close()
        b.Open("button")
        b.On("click", (): _ok := device.OpenSettings() end)
        b.Text("app settings")
        b.Close()
    end)
end
