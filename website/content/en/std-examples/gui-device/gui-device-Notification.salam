import gui.device

func main:
    if device.CheckPermission(device.Permission.Notifications) != device.PermissionState.Granted:
        println "notifications are not allowed"
        ret
    end
    _ok := device.ShowNotification(1, "Download finished", "report.pdf is ready")
    _ok2 := device.ScheduleNotification(2, "Stand up", "Time for a break", 1800)
    _ok3 := device.CancelNotification(2)
end
