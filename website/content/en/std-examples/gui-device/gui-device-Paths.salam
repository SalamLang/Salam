import gui.device
import io

func main:
    dir := device.DataDir()
    if dir.Len() == 0:
        println "no app folders here"
        ret
    end
    println "data", dir
    println "cache", device.CacheDir()
    println "documents", device.DocumentsDir()
    println "temp", device.TempDir()
    _ok := io.WriteFile(dir + "/notes.txt", "saved")
end
