import gui.device
import gui.ui

func label(): str:
    s := device.CheckPermission(device.Permission.Camera)
    if s == device.PermissionState.Granted:
        ret "Camera allowed"
    end
    if s == device.PermissionState.Denied:
        ret "Camera denied"
    end
    ret "Ask for the camera"
end

func main:
    println label()
    device.OnChange((): ui.Invalidate() end)
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder):
        b.Open("button")
        b.On("click", (): _ok := device.RequestPermission(device.Permission.Camera) end)
        b.Text(label())
        b.Close()
    end)
end
