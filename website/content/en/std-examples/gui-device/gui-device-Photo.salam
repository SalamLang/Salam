import gui.device
import gui.ui

func label(): str:
    state := device.PhotoStatus()
    if state == device.PhotoState.Ready:
        ret "saved to " + device.LastPhoto()
    end
    if state == device.PhotoState.Pending:
        ret "waiting for the photo"
    end
    if state == device.PhotoState.Failed:
        ret "no photo"
    end
    ret "choose a photo"
end

func main:
    println label()
    device.OnChange((): ui.Invalidate() end)
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder):
        b.Open("button")
        b.On("click", (): _ok := device.PickPhoto() end)
        b.Text(label())
        b.Close()
        b.Open("button")
        b.On("click", (): _ok2 := device.TakePhoto() end)
        b.Text("take a photo")
        b.Close()
    end)
end
