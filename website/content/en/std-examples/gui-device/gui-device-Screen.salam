import gui.device
import gui.ui

mut full := false

func main:
    if not device.KeepAwake(true):
        println "no screen control here"
        ret
    end
    _lock := device.LockOrientation(device.Orientation.Portrait)
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder):
        b.Open("button")
        b.On("click", (): full = not full _ok := device.Immersive(full) end)
        b.Text("full screen")
        b.Close()
        b.Open("button")
        b.On("click", (): _ok2 := device.SetBrightness(1.0) end)
        b.Text("full brightness")
        b.Close()
    end)
end
