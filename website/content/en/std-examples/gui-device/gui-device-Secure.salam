import gui.device

func main:
    if not device.SecureSet("token", "s3cret"):
        println "no secure storage here"
        ret
    end
    println "token", device.SecureGet("token")
    _gone := device.SecureDelete("token")
    println "after delete", device.SecureGet("token").Len()
end
