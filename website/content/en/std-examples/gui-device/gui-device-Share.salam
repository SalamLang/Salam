import gui.device

func main:
    println "running on", device.Platform()
    if not device.CanShare():
        println "no share sheet here"
        ret
    end
    if device.Share("Salam is a programming language", "https://salamlang.ir"):
        println "share sheet opened"
    else:
        println "could not share"
    end
end
