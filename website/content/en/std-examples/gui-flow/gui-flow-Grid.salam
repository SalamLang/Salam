import gui.flow

func show(t &: flow.Tree, name: str, id: int):
    println name, t.X(id), t.Y(id), t.W(id), t.H(id)
end

func main:
    mut cols := Vector {} as Vector<flow.Track>
    cols.Push(flow.TrackLen(flow.Px(80.0)))
    cols.Push(flow.TrackMinMax(flow.TrackLen(flow.Px(60.0)), flow.TrackFr(1.0)))
    cols.Push(flow.TrackFit(flow.Px(100.0)))
    mut rows := Vector {} as Vector<flow.Track>
    rows.Push(flow.TrackLen(flow.Px(30.0)))
    rows.Push(flow.TrackAuto())
    tr := cols.Get(1)
    println "minmax track", tr.min.px, tr.max.kind, tr.fr, tr.fit, tr.count, tr.tracks.Len()
    mut t := flow.NewTree()
    grid := t.Add(-1, flow.FlowStyle {
        layout = flow.LAYOUT_GRID,
        columns = cols,
        rows = rows,
        auto_rows = flow.TrackLen(flow.Px(20.0)),
        auto_columns = flow.TrackLen(flow.Px(40.0)),
        auto_flow = flow.AUTO_FLOW_ROW,
        column_gap = flow.Px(10.0),
        row_gap = flow.Px(5.0)
    })
    header := t.Add(grid, flow.FlowStyle { column = 1, column_span = 3 })
    side := t.Add(grid, flow.FlowStyle { row = 2, row_span = 2, column = 1 })
    body := t.Add(grid, flow.FlowStyle { height = flow.Px(50.0) })
    note := t.Add(grid, flow.FlowStyle { width = flow.Px(30.0), height = flow.Px(10.0), justify_self = flow.ALIGN_END, align_self = flow.ALIGN_CENTER })
    last := t.Add(grid, flow.FlowStyle { column = -1 })
    t.Layout(360.0, 400.0)
    show(t, "grid", grid)
    show(t, "header", header)
    show(t, "side", side)
    show(t, "body", body)
    show(t, "note", note)
    show(t, "last", last)

    mut cards := Vector {} as Vector<flow.Track>
    mut inner := Vector {} as Vector<flow.Track>
    inner.Push(flow.TrackMinMax(flow.TrackLen(flow.Px(100.0)), flow.TrackFr(1.0)))
    cards.Push(flow.Repeat(flow.REPEAT_FIT, inner))
    mut g := flow.NewTree()
    gallery := g.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_GRID, columns = cards, auto_rows = flow.TrackLen(flow.Px(60.0)), column_gap = flow.Px(10.0) })
    a := g.Add(gallery, flow.FlowStyle {})
    b := g.Add(gallery, flow.FlowStyle {})
    g.Layout(450.0, 300.0)
    show(g, "card a", a)
    show(g, "card b", b)
    println "repeat counts", flow.REPEAT_FILL, flow.REPEAT_FIT
    println "auto flow", flow.AUTO_FLOW_ROW, flow.AUTO_FLOW_COLUMN, flow.AUTO_FLOW_ROW_DENSE, flow.AUTO_FLOW_COLUMN_DENSE
end
