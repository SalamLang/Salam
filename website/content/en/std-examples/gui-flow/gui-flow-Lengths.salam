import gui.flow

func show(name: str, l: flow.Len):
    println name, "px", l.px, "pct", l.pct, "kind", l.kind
end

func main:
    show("Px(12)", flow.Px(12.0))
    show("Pct(0.5)", flow.Pct(0.5))
    show("PxPct(-20, 1)", flow.PxPct(-20.0, 1.0))
    show("Auto", flow.Auto())
    show("Fill", flow.Fill())
    show("Fit", flow.Fit())
    show("MinContent", flow.MinContent())
    show("MaxContent", flow.MaxContent())
    show("NoLimit", flow.NoLimit())
    println "kinds", flow.LEN_FIXED, flow.LEN_AUTO, flow.LEN_FILL, flow.LEN_FIT, flow.LEN_MIN_CONTENT, flow.LEN_MAX_CONTENT, flow.LEN_NONE
    pad := flow.Sides(flow.Px(4.0), flow.Px(8.0), flow.Px(4.0), flow.Px(16.0))
    println "sides top", pad.top.px, "end", pad.end.px, "bottom", pad.bottom.px, "start", pad.start.px
    mut m := flow.All(flow.Px(10.0))
    m.left = flow.Px(2.0)
    m.right = flow.Auto()
    println "all with physical overrides", m.top.px, m.left.px, m.right.kind
    s := flow.Size { w = 120.0, h = 16.0, baseline = 12.0 }
    println "size", s.w, s.h, s.baseline

    mut t := flow.NewTree()
    root := t.Add(-1, flow.FlowStyle { padding = flow.All(flow.Pct(0.05)), align = flow.ALIGN_START })
    a := t.Add(root, flow.FlowStyle { width = flow.PxPct(-20.0, 1.0), height = flow.Px(10.0) })
    b := t.Add(root, flow.FlowStyle { width = flow.Fill(), height = flow.Px(10.0), margin = m })
    t.Layout(200.0, 100.0)
    println "a", t.X(a), t.Y(a), t.W(a), t.H(a)
    println "b", t.X(b), t.Y(b), t.W(b), t.H(b)
end
