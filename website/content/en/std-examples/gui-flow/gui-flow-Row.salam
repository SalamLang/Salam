import gui.flow

func show(t &: flow.Tree, name: str, id: int):
    println name, t.X(id), t.Y(id), t.W(id), t.H(id)
end

func main:
    mut t := flow.NewTree()
    bar := t.Add(-1, flow.FlowStyle {
        layout = flow.LAYOUT_ROW,
        column_gap = flow.Px(8.0),
        row_gap = flow.Px(4.0),
        align = flow.ALIGN_CENTER,
        justify = flow.ALIGN_START,
        align_content = flow.ALIGN_START,
        wrap = false,
        reverse = false,
        padding = flow.All(flow.Px(6.0)),
        border = flow.All(flow.Px(1.0)),
        height = flow.Px(48.0),
        direction = flow.DIR_LTR
    })
    logo := t.Add(bar, flow.FlowStyle { width = flow.Px(32.0), aspect_ratio = 1.0 })
    title := t.Add(bar, flow.FlowStyle { grow = 1.0, shrink = 1.0, basis = flow.Px(100.0), height = flow.Px(20.0), min_width = flow.Px(60.0), max_width = flow.Px(400.0) })
    search := t.Add(bar, flow.FlowStyle { width = flow.Px(120.0), min_height = flow.Px(24.0), max_height = flow.NoLimit(), align_self = flow.ALIGN_STRETCH })
    menu := t.Add(bar, flow.FlowStyle { width = flow.Px(24.0), height = flow.Px(24.0), order = -1 })
    hidden := t.Add(bar, flow.FlowStyle { width = flow.Px(50.0), visible = false })
    t.Layout(400.0, 300.0)
    show(t, "bar", bar)
    show(t, "logo", logo)
    show(t, "title", title)
    show(t, "search", search)
    show(t, "menu", menu)
    show(t, "hidden", hidden)

    println "layouts", flow.LAYOUT_COLUMN, flow.LAYOUT_ROW, flow.LAYOUT_GRID, flow.LAYOUT_STACK, flow.LAYOUT_FLOW
    println "aligns", flow.ALIGN_AUTO, flow.ALIGN_START, flow.ALIGN_CENTER, flow.ALIGN_END, flow.ALIGN_STRETCH, flow.ALIGN_BASELINE, flow.ALIGN_BETWEEN, flow.ALIGN_AROUND, flow.ALIGN_EVENLY
    println "directions", flow.DIR_INHERIT, flow.DIR_LTR, flow.DIR_RTL

    mut w := flow.NewTree()
    list := w.Add(-1, flow.FlowStyle { layout = flow.LAYOUT_ROW, wrap = true, column_gap = flow.Px(10.0), row_gap = flow.Px(10.0), justify = flow.ALIGN_BETWEEN, align_content = flow.ALIGN_END, height = flow.Px(150.0), direction = flow.DIR_RTL })
    mut cards := Vector {} as Vector<int>
    repeat 5:
        cards.push(w.Add(list, flow.FlowStyle { width = flow.Px(70.0), height = flow.Px(40.0) }))
    end
    w.Layout(250.0, 300.0)
    each i, c in cards:
        show(w, "card" + i, c)
    end
end
