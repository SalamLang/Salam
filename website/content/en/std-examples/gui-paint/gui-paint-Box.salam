import gui.paint

func main:
    mut cv := paint.NewCanvas(120, 80)
    cv.Clear(paint.Rgb(245, 246, 250))
    card := paint.RectOf(20.0, 15.0, 80.0, 50.0)
    radii := paint.Uniform(10.0)
    cv.DrawShadow(card, radii, paint.Shadow { offset_y = 3.0, blur = 8.0, color = paint.Rgba(0, 0, 0, 90) })
    cv.FillRoundedRect(card, radii, paint.Rgb(255, 255, 255))
    mut border := paint.SolidBorder(2.0, paint.Rgb(60, 110, 220))
    border.left_width = 6.0
    border.left_color = paint.Rgb(230, 80, 40)
    cv.DrawBorder(card, radii, border)
    cv.DrawOutline(card, radii, 1.0, 3.0, paint.Rgba(60, 110, 220, 120))
    c := cv.Pixel(60, 40)
    println "inside:", c.r, c.g, c.b
    e := cv.Pixel(22, 40)
    println "left border:", e.r, e.g, e.b
    println "hash:", cv.Hash()
    cv.Free()
end
