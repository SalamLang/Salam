import gui.paint

func main:
    mut cv := paint.NewCanvas(120, 40)
    mut sky := paint.LinearGradient(90.0)
    sky.AddStop(0.0, paint.Rgb(255, 120, 0))
    sky.AddStop(-1.0, paint.Rgb(255, 0, 120))
    sky.AddStop(1.0, paint.Rgb(60, 0, 200))
    cv.FillGradient(paint.RectOf(0.0, 0.0, 60.0, 40.0), paint.Corners(12.0, 0.0, 0.0, 12.0), sky)
    sky.Free()
    size := paint.RadialSize(60.0, 40.0, 30.0, 20.0, true, paint.RadialExtent.ClosestSide)
    mut glow := paint.RadialGradient(30.0, 20.0, size.x, size.y)
    glow.AddStop(0.0, paint.Rgb(255, 255, 255))
    glow.AddStop(1.0, paint.Rgba(0, 160, 120, 255))
    cv.FillGradient(paint.RectOf(60.0, 0.0, 60.0, 40.0), paint.Uniform(0.0), glow)
    glow.Free()
    println "radius:", size.x
    left := cv.Pixel(2, 20)
    right := cv.Pixel(57, 20)
    println "left:", left.r, left.g, left.b
    println "right:", right.r, right.g, right.b
    println "centre:", cv.Pixel(90, 20).r
    cv.Free()
end
