import gui.raylib

func main:
    raylib.InitWindow(400, 300, "Collision")
    a := raylib.Rect(50.0, 50.0, 100.0, 100.0)
    until not raylib.WindowShouldClose():
        mouse := raylib.GetMousePosition()
        b := raylib.Rect(mouse.x as f64, mouse.y as f64, 60.0, 60.0)
        hit := raylib.CheckCollisionRecs(a, b)
        raylib.BeginDrawing()
        raylib.ClearBackground(raylib.RayWhite())
        raylib.DrawRectangleRec(a, hit ? raylib.Red() : raylib.Green())
        raylib.DrawRectangleRec(b, raylib.Fade(raylib.Blue(), 0.5))
        raylib.EndDrawing()
    end
    raylib.CloseWindow()
end
