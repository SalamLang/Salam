import gui.raylib

func main:
    raylib.InitWindow(400, 300, "Circles")
    until not raylib.WindowShouldClose():
        raylib.BeginDrawing()
        raylib.ClearBackground(raylib.RayWhite())
        raylib.DrawCircle(200, 150, 80.0, raylib.SkyBlue())
        raylib.DrawCircleLines(200, 150, 80.0, raylib.DarkBlue())
        raylib.EndDrawing()
    end
    raylib.CloseWindow()
end
