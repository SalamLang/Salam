import gui.raylib

func main:
    raylib.InitWindow(640, 360, "Hello Salam")
    raylib.SetTargetFPS(60)
    until not raylib.WindowShouldClose():
        raylib.BeginDrawing()
        raylib.ClearBackground(raylib.RayWhite())
        raylib.DrawText("Hello from Salam", 190, 170, 30, raylib.DarkGray())
        raylib.EndDrawing()
    end
    raylib.CloseWindow()
end
