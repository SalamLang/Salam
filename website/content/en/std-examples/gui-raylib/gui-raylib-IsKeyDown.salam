import gui.raylib

func main:
    raylib.InitWindow(400, 300, "Keys")
    mut x := 200
    until not raylib.WindowShouldClose():
        if raylib.IsKeyDown(raylib.KEY_RIGHT): x += 3 end
        if raylib.IsKeyDown(raylib.KEY_LEFT): x -= 3 end
        raylib.BeginDrawing()
        raylib.ClearBackground(raylib.RayWhite())
        raylib.DrawCircle(x, 150, 20.0, raylib.Maroon())
        raylib.EndDrawing()
    end
    raylib.CloseWindow()
end
