import gui.raylib

func main:
    raylib.InitWindow(400, 300, "Texture")
    tex := raylib.LoadTexture("logo.png")
    until not raylib.WindowShouldClose():
        raylib.BeginDrawing()
        raylib.ClearBackground(raylib.RayWhite())
        raylib.DrawTexture(tex, 100, 50, raylib.White())
        raylib.EndDrawing()
    end
    raylib.UnloadTexture(tex)
    raylib.CloseWindow()
end
