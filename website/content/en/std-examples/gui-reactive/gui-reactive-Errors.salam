import gui.reactive

func main:
    reactive.SetErrorPrinting(false)
    a := reactive.NewInt(0).Name("min width")
    b := reactive.NewInt(0).Name("preferred width")
    a.Bind((): ret b.Get() + 1 end)
    b.Bind((): ret a.Get() + 1 end)
    println "value with the loop cut", a.Get()
    println "errors", reactive.ErrorCount()
    println reactive.LastError()
end
