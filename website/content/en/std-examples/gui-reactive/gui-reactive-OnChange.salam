import gui.reactive

func main:
    count := reactive.NewInt(0)
    title := reactive.NewStr("")
    title.Bind((): ret "Count: " + count.Get() end)
    h := reactive.OnChange(title, (): println "  title changed to", title.Get() end)
    count.Set(1)
    count.Set(2)
    count.Set(3)
    println "pending", reactive.PendingHandlers()
    println "handlers run", reactive.RunPendingHandlers()
    count.Set(3)
    println "same value", reactive.RunPendingHandlers()
    h.Free()
    count.Set(4)
    println "after Free", reactive.RunPendingHandlers()
end
