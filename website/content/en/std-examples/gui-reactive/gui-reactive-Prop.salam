import gui.reactive

struct Size:
    pub w: int = 0
    pub h: int = 0
end

func main:
    window := reactive.NewProp(Size { w = 800, h = 600 }).Name("window size")
    pad := reactive.NewInt(16)
    content := reactive.NewProp(Size {})
    content.Bind(():
        s := window.Get()
        ret Size { w = s.w - 2 * pad.Get(), h = s.h - 2 * pad.Get() }
    end)
    println content.Get(), content.HasBinding()
    h := content.OnChange((): println "  content is now", content.Peek() end)
    window.Set(Size { w = 1024, h = 768 })
    println "handlers", reactive.RunPendingHandlers()
    h.Free()
    window.Free()
    content.Free()
end
