layout = row
    display:var(--salam-o,block) flex;flex-direction:var(--salam-dir,row);--salam-rev:row-reverse
layout = stack
    display:var(--salam-o,block) grid;grid-template:minmax(0,1fr)/minmax(0,1fr);justify-items:var(--salam-j,stretch);&>*{grid-area:1/1}
width = 100% - 20
    width:calc(100% - 20px)
padding = 8, 16, 4, 2
    padding-top:8px;padding-inline-end:16px;padding-bottom:4px;padding-inline-start:2px
visible = false
    display:none!important
blur = 4
    --salam-f-blur:blur(4px);filter:var(--salam-f-blur,) var(--salam-f-brightness,) var(--salam-f-contrast,) var(--salam-f-grayscale,) var(--salam-f-saturate,) var(--salam-f-sepia,) var(--salam-f-invert,) var(--salam-f-hue-rotate,)
transition = 200ms, ease out
    transition-duration:200ms;transition-timing-function:ease-out;transition-delay:0ms
base sheet: true *,::before,::after{box-sizing:border-box
