import gui.style

func show(prop: int, text: str):
    mut v := style.Value {}
    style.Parse(prop, text, v)
    println style.PropName(prop), "=", text
    println "   ", style.Css(prop, v)
end

func main:
    show(style.P_LAYOUT, "row")
    show(style.P_LAYOUT, "stack")
    show(style.P_WIDTH, "100% - 20")
    show(style.P_PADDING, "8, 16, 4, 2")
    show(style.P_VISIBLE, "false")
    show(style.P_BLUR, "4")
    show(style.P_TRANSITION, "200ms, ease out")
    base := style.BaseCss()
    println "base sheet:", base.Len() > 1000, base.substr(0, 40)
end
