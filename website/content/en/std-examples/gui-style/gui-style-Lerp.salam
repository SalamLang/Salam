import gui.style

func main:
    mut a := style.Value {}
    mut b := style.Value {}
    style.Parse(style.P_WIDTH, "100%", a)
    style.Parse(style.P_WIDTH, "100% - 40", b)
    each t in [0.0, 0.5, 1.0]:
        println "width at", t, "=", style.Format(style.P_WIDTH, style.Lerp(style.P_WIDTH, a, b, t))
    end
    mut c := style.Value {}
    mut d := style.Value {}
    style.Parse(style.P_SHADOW, "none", c)
    style.Parse(style.P_SHADOW, "0, 4, 8, black", d)
    println "shadow half way:", style.Format(style.P_SHADOW, style.Lerp(style.P_SHADOW, c, d, 0.5))
    ease := style.Easing { kind = style.EASE_SPRING, stiffness = 170.0, damping = 26.0 }
    println "spring at 0.5:", (style.EaseAt(ease, 0.5) * 1000.0) as int
end
