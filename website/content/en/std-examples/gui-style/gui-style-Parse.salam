import gui.style

func main:
    each text in ["8, 16", "100% - 20", "۸، ۱۶٪", "8 16", "-4"]:
        mut v := style.Value {}
        if style.Parse(style.P_PADDING, text, v):
            println "padding =", text, "->", style.Format(style.P_PADDING, v), "/", v.items.Len(), "items"
        else:
            println style.Error(style.P_PADDING, text)
        end
    end
    mut b := style.Value {}
    style.Parse(style.P_BORDER, "#3366aa, 2", b)
    println "border:", style.Format(style.P_BORDER, b)
    mut sh := style.Value {}
    style.Parse(style.P_SHADOW, "[0, 4, 8, black], [0, 1, 2, red]", sh)
    println "shadow groups:", sh.starts.Len(), "first item kind is a length:", sh.items.get(0).kind == style.ITEM_LEN
end
