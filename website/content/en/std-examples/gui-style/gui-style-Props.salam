import gui.style

func main:
    println style.PROP_COUNT, "properties,", style.KEYWORD_COUNT - 1, "keywords"
    p := style.PropByName("فاصله")
    info := style.Info(p)
    println p == style.P_PADDING, style.PropName(p), style.PropFaName(p), info.kind == style.KIND_LENGTH, info.min, info.max, info.initial
    println "inherited:", style.Inherited(style.P_COLOR), style.Inherited(style.P_PADDING), "animatable:", style.Animatable(style.P_OPACITY), style.Animatable(style.P_LAYOUT)
    each w in style.PropKeywords(style.P_LAYOUT):
        println "  ", style.KeywordName(w), "=", style.KeywordFaName(w)
    end
    println style.KeywordByName("ردیف") == style.KW_ROW
end
