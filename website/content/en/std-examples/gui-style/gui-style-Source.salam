import gui.style

func main:
    mut v := style.Value {}
    style.Parse(style.P_PADDING, "8, 1em", v)
    println style.Source(style.P_PADDING, v)
    built := style.One(style.OfLen(style.Px(8.0))).And(style.OfLen(style.Em(1.0)))
    println style.Format(style.P_PADDING, built)
    w := style.One(style.OfLen(style.Len { pct = 100.0, px = -20.0 }))
    println style.Format(style.P_WIDTH, w), style.Format(style.P_GAP, style.One(style.OfLen(style.Rem(1.0))).And(style.OfLen(style.Pct(5.0))))
    println style.Format(style.P_HEIGHT, style.One(style.OfLen(style.Vh(50.0)))), style.Format(style.P_WIDTH, style.One(style.OfLen(style.Vw(80.0)))), style.Format(style.P_WIDTH, style.One(style.OfLen(style.Vmin(10.0)))), style.Format(style.P_WIDTH, style.One(style.OfLen(style.Vmax(10.0))))
    println style.Format(style.P_COLUMNS, style.One(style.OfTrack(style.Track { kind = style.TRACK_MINMAX, len = style.Px(100.0), max = style.Fr(1.0) })))
    paint := style.Gradient(style.PAINT_LINEAR, 90.0, 0, false, style.Pct(50.0), style.Pct(50.0), false).AddStop(style.ColorOf(1.0, 0.0, 0.0, 1.0), style.Len {}, false).AddStop(style.CurrentColor(), style.Pct(80.0), true)
    println style.Format(style.P_BACKGROUND, style.One(style.OfPaint(paint)).And(style.OfPaint(style.Image("a.png"))))
    pair := style.LightDark(style.ColorOf(1.0, 1.0, 1.0, 1.0), style.ColorOf(0.0, 0.0, 0.0, 1.0))
    println style.Format(style.P_COLOR, style.One(style.OfColor(pair)))
    t := style.One(style.OfTime(200.0)).And(style.OfEase(style.Easing { kind = style.EASE_OUT })).And(style.OfTime(0.0)).Then(style.OfTime(100.0)).And(style.OfEase(style.Easing { kind = style.EASE_LINEAR })).And(style.OfTime(0.0))
    println style.Format(style.P_TRANSITION, t)
    println style.Format(style.P_ORDER, style.One(style.OfInt(2))), style.Format(style.P_WRAP, style.One(style.OfBool(true))), style.Format(style.P_OPACITY, style.One(style.OfNum(0.5))), style.Format(style.P_ROTATE, style.One(style.OfAngle(45.0)))
    println style.Format(style.P_LAYOUT, style.One(style.OfWord(style.KW_ROW))), style.Format(style.P_FONT, style.One(style.OfStr("Vazirmatn"))), style.Format(style.P_TRANSITION_PROPERTIES, style.One(style.OfProp(style.P_OPACITY)))
end
