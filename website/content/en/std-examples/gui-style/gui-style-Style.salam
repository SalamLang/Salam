import gui.style

func main:
    page := style.Default("page")
    mut h := style.Default("h1")
    style.Inherit(page, h)
    mut v := style.Value {}
    style.Parse(style.P_COLOR, "#3366aa", v)
    style.Set(h, style.P_COLOR, v)
    style.Parse(style.P_PADDING, "8, 16", v)
    style.Set(h, style.P_PADDING, v)
    println "layout flow:", h.layout_kind == style.KW_FLOW, "font size:", h.font_size.em, "em, weight", h.font_weight
    println "padding:", h.padding_top.px, h.padding_end.px, h.padding_bottom.px, h.padding_start.px
    println "color:", style.Format(style.P_COLOR, style.Get(h, style.P_COLOR))
    println "margin:", style.Format(style.P_MARGIN, style.Get(h, style.P_MARGIN))
    button := style.Default("button")
    println "button:", button.layout_kind == style.KW_ROW, button.cursor == style.KW_POINTER, button.border_top_width.px
end
