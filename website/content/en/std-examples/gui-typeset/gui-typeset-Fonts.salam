import gui.typeset
import os
import filepath
import archive
import compress

func font_path(name: str): str:
    ret filepath.Join(filepath.Dir(os.Env("SALAM_STD")), "books/fonts/" + name)
end

func main:
    mut ok := false
    mut f := typeset.LoadFont(font_path("XB Zar.ttf"), ok)
    m := typeset.Metrics(f)
    println typeset.FamilyName(f), typeset.StyleName(f), typeset.FullName(f), typeset.NameString(f, 1)
    println typeset.Weight(f), typeset.IsItalic(f), typeset.UnitsPerEm(f), typeset.NumGlyphs(f), typeset.FontValid(f)
    println m.ascent, m.descent, m.line_gap, m.x_height, m.cap_height, m.underline_position, m.underline_thickness, m.units_per_em
    println typeset.ScaleFactor(f, 20.48), typeset.AscentPixels(f, 20.48), typeset.DescentPixels(f, 20.48), typeset.LineHeightPixels(f, 20.48)
    beh := typeset.GlyphIndex(f, 0x0628)
    mut x0 := 0
    mut y0 := 0
    mut x1 := 0
    mut y1 := 0
    println beh, typeset.GlyphAdvance(f, beh), typeset.GlyphBox(f, beh, x0, y0, x1, y1), x0, y0, x1, y1, typeset.GlyphHasOutline(f, beh)
    println typeset.KernAdvance(f, beh, beh)
    typeset.FreeFont(f)
    mut bok := false
    mut buf := archive.ReadBinaryFile(font_path("XB Zar Bd.ttf"), bok)
    println typeset.FaceCount(buf.data, buf.len), typeset.IsCFFFont(buf.data, buf.len)
    mut pok := false
    bold := typeset.ParseFontIndex(buf.data, buf.len, 0, pok)
    mut fc := typeset.NewFontCollection()
    typeset.AddFont(fc, bold)
    typeset.AddFontBytes(fc, buf.data, buf.len)
    compress.BufFree(buf)
    typeset.AddFontFile(fc, font_path("XB Zar.ttf"))
    typeset.AddFontFile(fc, font_path("DejaVuSansMono.ttf"))
    println typeset.FaceCountIn(fc), typeset.FindFace(fc, "XB Zar", 400, false), typeset.FindFace(fc, "xb zar", 700, false)
    println typeset.FaceForCodepoint(fc, "DejaVu Sans Mono, XB Zar", 400, false, 0x41), typeset.FaceForCodepoint(fc, "monospace", 400, false, 0x06F4)
    face := fc.faces.get(2)
    println face.family, face.style, face.weight, face.italic, typeset.Weight(typeset.FaceFont(fc, 0))
    typeset.FreeFontCollection(fc)
    mut lf := typeset.LoadFontIndex(font_path("XB Zar It.ttf"), 0, ok)
    println typeset.IsItalic(lf)
    typeset.FreeFont(lf)
    mut more := typeset.NewFontCollection()
    println typeset.AddFontDir(more, filepath.Dir(font_path("x"))) > 90
    dirs := typeset.SystemFontDirs()
    println dirs.len() > 0, typeset.AddSystemFonts(more) >= 0
    dirs.free()
    typeset.FreeFontCollection(more)
    mut pf := typeset.ParseFont(null, 0, ok)
    println ok
    typeset.FreeFont(pf)
end
