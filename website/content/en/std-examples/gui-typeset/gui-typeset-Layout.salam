import gui.typeset
import os
import filepath

func main:
    fonts := filepath.Join(filepath.Dir(os.Env("SALAM_STD")), "books/fonts/")
    mut fc := typeset.NewFontCollection()
    typeset.AddFontFile(fc, fonts + "XB Zar.ttf")
    typeset.AddFontFile(fc, fonts + "DejaVuSansMono.ttf")
    mut spans := Vector {} as Vector<typeset.TextSpan>
    spans.push(typeset.TextSpan { text = "قیمت این کتاب ", families = "XB Zar", size = 18.0, tag = 1, lang = "fa" })
    spans.push(typeset.TextSpan { text = "12 USD", families = "DejaVu Sans Mono", size = 14.0, tag = 2, letter_spacing = 0.5 })
    spans.push(typeset.TextSpan { text = " است.", families = "XB Zar", size = 18.0, tag = 3, word_spacing = 2.0, line_height = 30.0, line_height_scale = 0.0 })
    mut st := typeset.ParagraphStyle {}
    st.align = typeset.TextAlign.Justify
    st.direction = typeset.TextDirAuto
    st.white_space = typeset.WhiteSpace.Normal
    st.overflow_wrap = typeset.OverflowWrap.BreakWord
    st.max_lines = 3
    st.ellipsis = true
    st.lang = "fa"
    mut p := typeset.NewParagraph(fc, spans, st)
    println typeset.MinContentWidth(p), typeset.MaxContentWidth(p), p.min_content, p.max_content
    println p.text, p.style.max_lines, p.spans.Len(), p.span_starts.get(1), typeset.SpanAt(p, 30)
    c := p.chars.get(0)
    println c.offset, c.cp, c.span, c.level, c.base, c.flags, c.advance, c.brk, c.face
    r := p.runs.get(0)
    println r.cp_start, r.cp_end, r.glyph_start, r.glyph_end, r.level, r.face, r.span, r.size64
    g := p.glyphs.get(0)
    println g.id, g.cp, g.advance, g.x_offset, g.y_offset
    mut l := typeset.LayoutParagraph(p, fc, 110.0)
    println l.width, l.height, l.max_width, l.truncated, l.lines.Len()
    each lb in l.lines:
        println lb.start, lb.end, lb.cp_start, lb.cp_end, lb.trailing_cp, lb.top, lb.baseline, lb.height, lb.ascent, lb.descent, lb.x, lb.width, lb.run_start, lb.run_count, lb.hard_break, lb.rtl, lb.space_extra
    end
    each run in l.runs:
        println run.face, run.size, run.x, run.width, run.start, run.end, run.cp_start, run.cp_end, run.rtl, run.level, run.tag, run.span, run.glyph_start, run.glyph_count, run.ellipsis
    end
    pg := l.glyphs.get(0)
    println pg.id, pg.x, pg.y, pg.cluster, pg.advance
    typeset.FreeLayout(l)
    typeset.FreeParagraph(p)
    spans.free()
    typeset.FreeFontCollection(fc)
end
