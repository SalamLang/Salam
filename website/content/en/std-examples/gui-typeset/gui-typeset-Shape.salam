import gui.typeset
import os
import filepath

func main:
    mut ok := false
    mut f := typeset.LoadFont(filepath.Join(filepath.Dir(os.Env("SALAM_STD")), "books/fonts/XB Zar.ttf"), ok)
    glyphs := typeset.ShapeText(f, "می‌خواهم", true, "", "fa")
    each g in glyphs:
        println g.id, g.cluster, g.x_advance, g.x_offset, g.y_offset
    end
    glyphs.Free()
    println typeset.ShapeArabic("سلام")
    println typeset.IsRTLText("سلام"), typeset.BaseDirection("Salam سلام") == typeset.TextDirLTR
    println typeset.ToVisualOrder("abc سلام", typeset.TextDirAuto)
    cps := typeset.VisualCodepoints("لا", typeset.TextDirRTL, true)
    println cps.Len(), cps.Get(0)
    cps.Free()
    typeset.FreeFont(f)
end
