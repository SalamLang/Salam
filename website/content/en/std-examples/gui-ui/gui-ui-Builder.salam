import gui.ui
import gui.style

func none(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func size(b: ui.Builder, w: str, h: str):
    b.SetText(ui.STATE_BASE, style.P_WIDTH, w)
    b.SetText(ui.STATE_BASE, style.P_HEIGHT, h)
end

func view(b: ui.Builder):
    b.Title("Menu")
    b.Lang("en")
    b.Dir("ltr")
    b.Open("box")
    b.Id("menu")
    b.SetText(ui.STATE_BASE, style.P_LAYOUT, "row")
    b.SetText(ui.STATE_BASE, style.P_GAP, "8")
    b.Open("box")
    b.Id("open")
    b.Key("k1")
    b.Attr("title", "Open the file")
    b.BoolAttr("disabled", false)
    size(b, "80", "30")
    b.Close()
    b.Open("box")
    b.Id("save")
    b.Key("k2")
    b.BoolAttr("disabled", true)
    size(b, "80", "30")
    b.Close()
    b.Close()
end

func main:
    println ui.DumpPage((): ret none() end, (b: ui.Builder): view(b) end, 300, 100)
end
