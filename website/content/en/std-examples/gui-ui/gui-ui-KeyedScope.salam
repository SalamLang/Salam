import gui.ui
import gui.css

mut names := Vector {} as Vector<str>
mut touched := 0 as i64
mut likes := Vector {} as Vector<int>

func take(w: int): i64:
    mut t := 0 as i64
    if w == 0:
        t = touched
        touched = 0
    end
    ret t
end

func sites():
    ui.ScopeSite(1, -1, 0, 1)
    ui.ScopeSite(2, 0, 0, 0)
end

func check():
    mut line := ""
    each n in names:
        if line.Len() > 0:
            line += ", "
        end
        line += ui.ById(n).Text()
    end
    println line
end

func reverse_names():
    mut out := Vector {} as Vector<str>
    each n in names:
        out.Insert(0, n)
    end
    names.Clear()
    each n2 in out:
        names.Push(n2)
    end
    out.Free()
    touched |= 1
end

func row(b: ui.Builder, name: str):
    b.KeyedScope(2, name, (b: ui.Builder):
        k := b.Instance(0)
        if b.Fresh():
            if k < likes.Len():
                likes[k] = 0
            else:
                likes.Push(0)
            end
        end
        b.Open("li")
        b.Key(name)
        b.Id(name)
        b.On("click", ():
            likes[k] += 1
            ui.TouchInstance(0, k)
        end)
        b.Text(name + " " + likes[k])
        b.Close()
    end)
end

func page(b: ui.Builder):
    b.Reactive(1, (w: int): ret take(w) end, (): sites() end)
    b.Open("div")
    b.Open("button")
    b.Id("rev")
    b.On("click", (): reverse_names() end)
    b.Text("Reverse")
    b.Close()
    b.Open("button")
    b.Id("drop")
    b.On("click", ():
        names.RemoveAt(0)
        touched |= 1
    end)
    b.Text("Drop")
    b.Close()
    b.Open("button")
    b.Id("check")
    b.On("click", (): check() end)
    b.Text("Check")
    b.Close()
    b.Open("ul")
    b.Scope(1, (b: ui.Builder):
        each n in names:
            row(b, n)
        end
    end)
    b.Close()
    b.Close()
end

func main:
    names.Push("tea")
    names.Push("cake")
    names.Push("milk")
    script := "click #tea\nclick #cake\nclick #cake\nclick #check\nclick #rev\nclick #check\nclick #drop\nclick #check\nquit"
    ui.RunCompiledWith((): ret css.NewProgram() end, (b: ui.Builder): page(b) end, ui.Options { width = 320.0, height = 200.0, headless = true, script = script })
end
