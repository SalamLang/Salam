import gui.ui
import gui.style

mut moved := false

func none(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func view(b: ui.Builder):
    b.Open("box")
    b.SetText(ui.STATE_BASE, style.P_BACKGROUND, "#ffffff")
    b.Open("box")
    b.SetText(ui.STATE_BASE, style.P_WIDTH, "40")
    b.SetText(ui.STATE_BASE, style.P_HEIGHT, "40")
    b.SetText(ui.STATE_BASE, style.P_MARGIN, moved ? "40" : "0")
    b.SetText(ui.STATE_BASE, style.P_BACKGROUND, "#3366aa")
    b.Close()
    b.Close()
end

func main:
    ui.AddFontDir("fonts-that-do-not-exist")
    ui.OffscreenOpen((): ret none() end, (b: ui.Builder): view(b) end, 120, 100, 1.0)
    moved = true
    area := ui.OffscreenUpdate(false)
    println "damaged", area > 0
    partial := ui.OffscreenCanvas().Hash()
    ui.OffscreenRepaintAll()
    println "same as full", partial == ui.OffscreenCanvas().Hash()
    ui.OffscreenClose()
end
