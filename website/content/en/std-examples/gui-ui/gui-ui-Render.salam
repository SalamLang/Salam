import gui.ui
import gui.style

func none(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func view(b: ui.Builder):
    b.Open("box")
    b.SetText(ui.STATE_BASE, style.P_PADDING, "10")
    b.SetText(ui.STATE_BASE, style.P_BACKGROUND, "#ffffff")
    b.Open("box")
    b.Id("card")
    b.SetText(ui.STATE_BASE, style.P_WIDTH, "50")
    b.SetText(ui.STATE_BASE, style.P_HEIGHT, "30")
    b.SetText(ui.STATE_BASE, style.P_BACKGROUND, "#3366aa")
    b.Close()
    b.Close()
end

func main:
    mut one := ui.RenderPage((): ret none() end, (b: ui.Builder): view(b) end, 200, 100)
    mut two := ui.RenderPageScaled((): ret none() end, (b: ui.Builder): view(b) end, 200, 100, 2.0)
    println "scale 1", one.width, one.height
    println "scale 2", two.width, two.height
    p := one.Pixel(30, 20)
    q := two.Pixel(60, 40)
    println "card", p.r, p.g, p.b, q.r, q.g, q.b
    println ui.DumpPage((): ret none() end, (b: ui.Builder): view(b) end, 200, 100)
    one.Free()
    two.Free()
end
