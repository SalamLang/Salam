import gui.ui
import gui.style

mut clicks := 0

func none(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func view(b: ui.Builder):
    b.Title("Counter")
    b.Open("box")
    b.SetText(ui.STATE_BASE, style.P_PADDING, "16")
    b.Open("button")
    b.Id("go")
    b.On("click", (): clicks++ end)
    b.Text("Clicked " + clicks + " times")
    b.Close()
    b.Close()
end

func main:
    o := ui.Options {
        width = 480.0,
        height = 320.0,
        title = "Counter",
        resizable = true
    }
    ui.RunPageWith((): ret none() end, (b: ui.Builder): view(b) end, o)
    println "clicks", clicks
    println ui.Dump()
    ui.RunPage((): ret none() end, (b: ui.Builder): view(b) end)
end
