import gui.ui

mut total := 0
mut touched := 0 as i64
mut likes := Vector {} as Vector<int>

func take(w: int): i64:
    mut t := 0 as i64
    if w == 0:
        t = touched
        touched = 0
    end
    ret t
end

func sites():
    ui.ScopeSite(1, -1, 0, 1)
    ui.ScopeSite(2, 0, 0, 0)
end

func none(): Vector<ui.Patch>:
    ret ui.NoPatches()
end

func item(b: ui.Builder, name: str):
    b.KeyedScope(2, name, (b: ui.Builder): k := b.Instance(0) if b.Fresh(): if k < likes.Len(): likes[k] = 0 else: likes.Push(0) end end b.Open("button") b.Id(name) b.On("click", (): likes[k] += 1 ui.TouchInstance(0, k) end) b.Close() end)
end

func view(b: ui.Builder):
    b.Reactive(1, (w: int): ret take(w) end, (): sites() end)
    b.Open("box")
    b.Scope(1, (b: ui.Builder): if b.Memo("" + total): ret end b.Open("box") b.Id("total") b.Attr("data-total", "" + total) b.Close() end)
    b.Open("button")
    b.Id("add")
    b.On("click", (): total++ touched |= 1 end)
    b.Close()
    b.Open("button")
    b.Id("redraw")
    b.On("click", (): ui.Invalidate() end)
    b.Close()
    item(b, "tea")
    item(b, "cake")
    b.Close()
end

func main:
    mut c := ui.RenderPage((): ret none() end, (b: ui.Builder): view(b) end, 200, 100)
    println "scope runs", ui.ScopeRuns()
    println "scope skips", ui.ScopeSkips()
    c.Free()
end
