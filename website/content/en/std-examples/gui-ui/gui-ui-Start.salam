import gui.ui

mut clicks := 0

func view(): str:
    ret `<!doctype html><html><head><title>Start</title><style>.on{color:red}</style></head><body><p id="msg" class="on">Clicked ` + clicks + `</p><button id="btn" onclick="hit()">Hit</button><input id="field" value="abc"><input id="box" type="checkbox"></body></html>`
end

func main:
    ui.Handle("hit", (): clicks++ end)
    ok := ui.Start((): ret view() end, ui.Options { width = 320.0, height = 200.0, headless = true })
    println "started", ok, ui.CurrentWindow().Title(), ui.Step(0)
    ui.RunSteps("click #btn\nclick #field\ntype !")
    msg := ui.ById("msg")
    println "text", msg.Text(), "tag", msg.Tag(), "exists", msg.Exists()
    field := ui.ById("field")
    println "value", field.Value()
    field.SetValue("set")
    box := ui.ById("box")
    box.SetChecked(true)
    println "checked", box.Checked(), "value", field.Value()
    msg.AddClass("big")
    msg.RemoveClass("on")
    msg.SetAttr("title", "note")
    println "class", msg.HasClass("big"), msg.HasClass("on"), "attr", msg.Attr("title")
    msg.SetText("replaced until the next view")
    ui.ById("btn").Focus()
    ui.ById("btn").ScrollIntoView()
    ui.ById("btn").Click()
    _alive := ui.Step(0)
    println "clicks", clicks, msg.Text(), "red", msg.Style().color.r
    r := msg.Rect()
    println "has box", r.width > 0.0, r.height > 0.0, r.x >= 0.0, r.y >= 0.0
    println "frames", ui.FrameCount() > 0, "dump lines", ui.Dump().len() > 0
    ui.RunSteps("hover #btn")
    println "damage", ui.LastDamageCount() >= 0, ui.LastDamageArea() >= 0
    partial := ui.Frame().Hash()
    ui.RepaintAll()
    println "partial equals full", partial == ui.Frame().Hash()
    ui.Stop()
    _ok := ui.StartHtml(`<p>fixed</p>`, ui.Options { headless = true })
    ui.Stop()
end
