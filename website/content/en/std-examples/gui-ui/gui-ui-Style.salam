import gui.ui
import gui.style

func patches(): Vector<ui.Patch>:
    mut all := ui.NoPatches()
    mut red := ui.NewPatch()
    mut v := style.Value {}
    if style.Parse(style.P_BACKGROUND, "#cc0000", v):
        red.Add(style.P_BACKGROUND, v)
    end
    if style.Parse(style.P_RADIUS, "6", v):
        red.Add(style.P_RADIUS, v)
    end
    println "patch length", red.Len()
    all.Push(red)
    ret all
end

func view(b: ui.Builder):
    b.Open("box")
    b.Id("a")
    b.SetText(ui.STATE_BASE, style.P_WIDTH, "60")
    b.SetText(ui.STATE_BASE, style.P_HEIGHT, "40")
    b.Patch(ui.STATE_BASE, 0)
    b.SetText(ui.STATE_HOVER, style.P_BACKGROUND, "#0000cc")
    b.Close()
    b.Open("box")
    b.Id("b")
    mut v := style.Value {}
    if style.Parse(style.P_BACKGROUND, "#00aa00", v):
        b.Set(ui.STATE_BASE, style.P_BACKGROUND, v)
    end
    b.SetText(ui.STATE_BASE, style.P_WIDTH, "60")
    b.SetText(ui.STATE_BASE, style.P_HEIGHT, "40")
    b.Close()
end

func main:
    mut c := ui.RenderPage((): ret patches() end, (b: ui.Builder): view(b) end, 100, 100)
    a := c.Pixel(30, 20)
    b := c.Pixel(30, 60)
    println "a", a.r, a.g, a.b
    println "b", b.r, b.g, b.b
    println "states",
        ui.STATE_BASE,
        ui.STATE_HOVER,
        ui.STATE_FOCUS,
        ui.STATE_FOCUS_WITHIN,
        ui.STATE_ACTIVE,
        ui.STATE_DISABLED,
        ui.STATE_CHECKED,
        ui.STATE_INVALID,
        ui.STATE_PLACEHOLDER,
        ui.STATE_SELECTION
    c.Free()
end
