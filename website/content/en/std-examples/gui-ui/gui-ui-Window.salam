import gui.ui

func main:
    ui.OnCloseRequest(():
        ui.HideWindow()
        ret false
    end)
    ui.RunPage((): ret ui.NoPatches() end, (b: ui.Builder):
        b.Open("button")
        b.On("click", (): ui.Stop() end)
        b.Text("Quit")
        b.Close()
        b.Open("button")
        b.On("click", ():
            if ui.WindowVisible():
                ui.HideWindow()
            end
            ui.ShowWindow()
        end)
        b.Text("Hide and show")
        b.Close()
    end)
end
