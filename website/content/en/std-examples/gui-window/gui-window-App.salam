import gui.window
import mem

func main:
    first := window.Open(window.Options { headless = true, visible = false })
    second := window.Open(window.Options { headless = true, visible = false })
    println window.OpenWindows(), first.id, second.id
    println window.SetClipboardText("hello")
    text := window.ClipboardText()
    println text
    mem.Free(text as void*)
    println window.CurrentColorScheme() == window.ColorScheme.Light
    window.Inject(window.Event { kind = window.EventKind.ColorSchemeChanged, scheme = window.ColorScheme.Dark })
    e := window.Poll()
    println e.scheme == window.ColorScheme.Dark, window.CurrentColorScheme() == window.ColorScheme.Dark
    println window.LastError() == ""
    second.Close()
    println window.OpenWindows()
end
