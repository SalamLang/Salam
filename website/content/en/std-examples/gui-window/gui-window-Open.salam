import gui.window

func main:
    options := window.Options {
        title = "Notes", width = 400.0, height = 300.0, min_width = 200.0, min_height = 150.0,
        max_width = 800.0, max_height = 600.0, resizable = true, decorated = true, centered = true,
        x = 0.0, y = 0.0, background = 0xF5F5F5FF as u32, visible = true, headless = true, scale = 2.0
    }
    w := window.Open(options)
    println w.id, w.IsOpen(), w.IsHeadless(), w.IsFocused(), w.Title()
    size := w.Size()
    println size.width, size.height, size.physical_width, size.physical_height, w.ScaleFactor()
    w.SetTitle("Notes (2)")
    w.SetSize(1000.0, 100.0)
    println w.Title(), w.Size()
    w.SetMinSize(100.0, 100.0)
    w.SetMaxSize(0.0, 0.0)
    w.SetSize(1000.0, 100.0)
    println w.Size()
    w.SetCursor(window.Cursor.Pointer)
    w.SetImeRect(20.0, 40.0, 2.0, 16.0)
    println w.CurrentCursor() == window.Cursor.Pointer, w.ImeRect()
    w.SetFullscreen(true)
    println w.IsFullscreen()
    w.SetFullscreen(false)
    w.Minimize()
    w.Maximize()
    w.Restore()
    w.Focus()
    w.RequestRedraw()
    println w.Handle() == null
    w.Close()
    println w.IsOpen()
end
