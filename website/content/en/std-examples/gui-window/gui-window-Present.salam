import gui.window
import mem

func main:
    w := window.Open(window.Options { width = 4.0, height = 3.0, headless = true })
    pixels := mem.AllocateZeroed((4 * 3 * 4) as u64) as u32*
    defer mem.Free(pixels as void*)
    repeat 12 in i:
        pixels[i] = 0xFF336699 as u32
    end
    println w.PresentAll(pixels as void*, 4, 3, 16), w.PresentCount(), w.LastDamage()
    pixels[5] = 0xFFFF0000 as u32
    mut damage := Vector {} as Vector<window.Rect>
    defer damage.Free()
    damage.Push(window.Rect { x = 1, y = 1, width = 1, height = 1 })
    println w.Present(pixels as void*, 4, 3, 16, damage), w.LastDamage(), w.LastDamageCount()
    println w.PixelAt(1, 1) == (0xFFFF0000 as u32), w.ShownPixel(0, 0) == (0xFF336699 as u32)
    println w.SetIcon(pixels as void*, 2, 2, 16)
    w.Close()
end
