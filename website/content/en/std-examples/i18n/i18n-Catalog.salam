import i18n

func main:
    mut c := i18n.New("en")
    defer i18n.Free(c)
    i18n.Set(c, "en", "hello", "Hello")
    i18n.Set(c, "fa", "hello", "سلام")
    i18n.Set(c, "en", "bye", "Goodbye")
    println i18n.T(c, "fa", "hello"), i18n.T(c, "fa", "bye"), i18n.T(c, "fa", "missing")
    println i18n.Has(c, "fa", "bye"), i18n.RawGet(c, "fa", "bye") == ""
    println c.fallback
end
