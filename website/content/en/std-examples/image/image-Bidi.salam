import image

func main:
    println image.IsRTLText("سلام"), image.IsRTLText("hello")
    println image.BaseDirection("سلام hello") == image.TextDirRTL, image.BaseDirection("hello سلام") == image.TextDirLTR
    println image.TextDirAuto
    visual := image.ToVisualOrder("abc", image.TextDirLTR)
    println visual
    shaped := image.ShapeArabic("سلام")
    println shaped.len() > 0, shaped != "سلام"
    println image.ToVisualOrder("سلام", image.TextDirRTL) != "سلام"
end
