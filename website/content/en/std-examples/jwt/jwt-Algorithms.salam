import jwt

func code_of(token: str, o: jwt.Options): str:
    try:
        _ := jwt.Verify(token, "k", o)
        ret "ok"
    catch e:
        ret e.code
    end
end

func main throws:
    println jwt.JWT_HS256, jwt.JWT_HS384, jwt.JWT_HS512
    println jwt.IsSupportedAlg("HS512"), jwt.IsSupportedAlg("none"), jwt.DigestSize("HS384")

    mut c := jwt.NewClaims()
    c.sub = "7"
    c.jti = "t-1"
    jwt.ExpiresIn(c, 3600)
    jwt.NotBeforeIn(c, 0)
    one := try jwt.SignHS384(c, "k")
    two := try jwt.SignHS512(c, "k")
    three := try jwt.Sign(c, jwt.JWT_HS256, "k")
    four := try jwt.SignWithKid(c, "HS256", "key-2026", "k")
    d1 := try jwt.Decode(one)
    d2 := try jwt.Decode(two)
    d4 := try jwt.Decode(four)
    println d1.alg, d2.alg, d4.kid

    t := try jwt.VerifyHS256(three, "k")
    println t.valid, jwt.SecondsRemaining(t) > 3500
    b := try jwt.Verify(one, "k", jwt.OptionsFor("HS384"))
    println b.valid
    println code_of(one, jwt.DefaultOptions())

    raw := try jwt.SignJSON(`{"sub":"1"}`, "HS256", "", "k")
    println raw
    d := try jwt.Decode(raw)
    println d.header_json, d.payload_json
    println jwt.SignatureOf(d.signing_input, "HS256", "k") == d.signature

    encoded := jwt.B64UrlEncode("hello?")
    println encoded.Len()
    println try jwt.B64UrlDecode(encoded)
    println jwt.B64UrlEncodeBytes("hi?" as void*, 3)
    try:
        _ := jwt.B64UrlDecode("aGk/")
    catch e:
        println e.code, e.offset, e.message
    end
    try:
        _ := jwt.SignHS256(c, "")
    catch e:
        println e.code, e.is(ErrorKind.InvalidArgument), e.message
    end
    mut strict := jwt.OptionsFor("HS384")
    strict.issuer = "salamlang.ir"
    println code_of(one, strict), code_of("a.b", strict), code_of("e30.e30.x", strict)
end
