import jwt
import net.http
import net.router

mut guard := jwt.NewGuard("a-server-secret-only-the-server-knows")

func login(ctx: i64):
    mut c := jwt.NewClaims()
    c.sub = "42"
    jwt.SetStr(c, "scope", "read")
    jwt.SetRaw(c, "roles", `["editor"]`)
    try:
        token := jwt.Issue(guard, c, 3600)
        jwt.SetSessionCookieInsecure(ctx, guard, token, 3600)
        http.Text(ctx, token)
    catch e:
        http.SetStatus(ctx, 500)
        http.Text(ctx, e.message)
    end
end

func me(ctx: i64):
    mut t := jwt.Token {}
    if jwt.Require(ctx, guard, t):
        http.Text(ctx, "hello user " + t.claims.sub)
    end
end

func admin(ctx: i64):
    mut t := jwt.Token {}
    if jwt.RequireScope(ctx, guard, "admin", t):
        http.Text(ctx, "admin panel")
    end
end

func edit(ctx: i64):
    mut t := jwt.Token {}
    if jwt.RequireClaim(ctx, guard, "roles", "editor", t):
        http.Text(ctx, "editor")
    end
end

func profile(ctx: i64):
    mut t := jwt.Token {}
    if jwt.RequireSubject(ctx, guard, http.Param(ctx, "id"), t):
        http.Text(ctx, "your own profile")
    end
end

func manual(ctx: i64):
    try:
        t := jwt.Check(ctx, guard)
        if t.claims.sub == "0":
            jwt.Forbidden(ctx, "the user is blocked")
        else:
            http.Text(ctx, "valid")
        end
    catch e:
        if e.code == "jwt.missing_token":
            jwt.MissingCredential(ctx, guard)
        else:
            jwt.Unauthorized(ctx, guard, e.message)
        end
    end
end

func login_secure(ctx: i64):
    try:
        token := jwt.IssueFor(guard, "42", 3600)
        jwt.SetSessionCookie(ctx, guard, token, 3600)
        http.Text(ctx, "signed in")
    catch e:
        http.SetStatus(ctx, 500)
        http.Text(ctx, e.message)
    end
end

func logout(ctx: i64):
    jwt.ClearSessionCookie(ctx, guard)
    http.Text(ctx, "you are logged out")
end

func main throws:
    guard.cookie = "session"
    mut r := router.NewRouter()
    router.Post(r, "/login", login)
    router.Get(r, "/me", me)
    router.Get(r, "/admin", admin)
    router.Get(r, "/edit", edit)
    router.Get(r, "/users/:id", profile)
    router.Get(r, "/check", manual)
    router.Post(r, "/login/secure", login_secure)
    router.Post(r, "/logout", logout)
    mut s := http.NewServer(19630)
    http.Use(s, r)
    _ := http.RunBackground(s)
    base := "http://127.0.0.1:19630"

    login_response := http.Post(base + "/login", "")
    token := http.Body(login_response)
    println http.CookieMap(login_response).Get("session") == token
    secure_response := http.Post(base + "/login/secure", "")
    println http.Body(secure_response), http.CookieMap(secure_response).Get("session").Len() > 0
    mut headers := http.NewHeaders()
    headers.Insert("Authorization", "Bearer " + token)
    println jwt.ParseBearer("Bearer " + token) == token
    ask(base, "/me", headers)
    ask(base, "/admin", headers)
    ask(base, "/edit", headers)
    ask(base, "/users/42", headers)
    ask(base, "/users/7", headers)
    ask(base, "/check", headers)
    ask(base, "/me", http.NewHeaders())
    mut bad := http.NewHeaders()
    bad.Insert("Authorization", "Bearer x.y.z")
    ask(base, "/check", bad)
    mut cookie := http.NewHeaders()
    cookie.Insert("Cookie", "session=" + token)
    ask(base, "/me", cookie)

    mut access := ""
    mut refresh := ""
    try jwt.IssuePair(guard, "42", 900, 86400, access, refresh)
    println access.Len() > 0, access != refresh
    one := try jwt.IssueFor(guard, "42", 60)
    checked := try jwt.Verify(one, guard.secret, guard.opts)
    println checked.claims.sub, guard.realm
end

func ask(base: str, path: str, headers: HashMap<str, str>):
    response := http.GetWith(base + path, headers)
    println path, http.Status(response), http.Body(response)
end
