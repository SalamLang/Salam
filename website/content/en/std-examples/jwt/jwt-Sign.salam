import jwt

func reason(token: str, secret: str, o: jwt.Options): str:
    try:
        _ := jwt.Verify(token, secret, o)
        ret "ok"
    catch e:
        ret e.code + " " + e.message
    end
end

func main throws:
    mut c := jwt.NewClaims()
    c.iss = "salamlang.ir"
    c.sub = "42"
    c.aud = "api"
    c.iat = 1700000000
    c.exp = 1700003600
    jwt.SetStr(c, "name", "Maryam")
    jwt.SetInt(c, "level", 3)
    jwt.SetBool(c, "admin", false)
    jwt.SetRaw(c, "scope", `"read write"`)
    jwt.SetRaw(c, "roles", `["editor","viewer"]`)
    println jwt.ClaimsJSON(c)

    token := try jwt.SignHS256(c, "a-long-random-secret")
    println token.Len() > 0
    println token

    mut o := jwt.DefaultOptions()
    o.now = 1700001000
    o.issuer = "salamlang.ir"
    o.audience = "api"
    t := try jwt.Verify(token, "a-long-random-secret", o)
    println t.valid, t.alg, t.typ, t.claims.sub
    println jwt.Str(t, "name"), jwt.Int(t, "level"), jwt.Bool(t, "admin"), jwt.Has(t, "email")
    println jwt.Raw(t, "level"), jwt.HasScope(t, "write"), jwt.HasAudience(t, "api"), jwt.ListHas(t, "roles", "editor")

    println reason(token, "another-secret", o)
    o.now = 1800000000
    println reason(token, "a-long-random-secret", o)
    o.now = 1700001000
    o.issuer = "example.com"
    println jwt.IsValid(token, "a-long-random-secret", o)
    try:
        _ := jwt.Decode("abc")
    catch e:
        println e.code, e.is(ErrorKind.Syntax)
    end
end
