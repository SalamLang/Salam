import llvm.triple

func main:
    each target in ["x86_64-unknown-linux-gnu", "aarch64-unknown-linux-musl", "aarch64-apple-darwin", "x86_64-pc-windows-msvc", "i686-w64-windows-gnu", "wasm32-unknown-wasi"]:
        println target, triple.PointerBits(target), triple.IsWindows(target), triple.IsGlibc(target)
        dl := triple.Datalayout(target)
        if dl.len() > 0:
            println "  ", dl
        else:
            println "  unknown; LLVM works it out itself"
        end
    end
    println triple.HostDatalayout().len() > 0
end
