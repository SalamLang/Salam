import math

func main:
    x := 2.0 as f32
    println math.SqrtF32(x), math.Sqrt(2.0)
    println math.PowF32(x, 10.0 as f32), math.HypotF32(3.0 as f32, 4.0 as f32)
    println math.FloorF32(-2.5 as f32), math.RoundF32(2.5 as f32), math.TruncF32(-2.75 as f32)
    println math.MinF32(x, 0.5 as f32), math.MaxF32(x, 0.5 as f32), math.ModF32(7.5 as f32, x)
    println math.SinF32(0.5 as f32), math.ExpF32(1.0 as f32), math.LogF32(10.0 as f32)
end
