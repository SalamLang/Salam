import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func main:
    mut a := build(2, 3, "1 2 3 4 5 6")
    matrix.Print(a)
    println matrix.ShapeString(a), a.rows, a.cols, a.a.len(), a.count(), a.min_dim(), a.is_square(), a.is_empty()
    println a.at(1, 2), a.flat(4)
    a.set(0, 0, 10.0)
    a.add_at(0, 1, 0.5)
    a.mul_at(0, 2, 2.0)
    a.set_flat(5, -1.0)
    matrix.PrintPrec(a, 1)
    matrix.PrintLabeled("a", a)

    println matrix.ToString(matrix.Zeros(1, 2)), matrix.ToString(matrix.Ones(1, 2)), matrix.ToString(matrix.Full(1, 2, 7.0))
    println matrix.ToString(matrix.Eye(2))
    println matrix.ToString(matrix.EyeOffset(2, 3, 1))
    mut data := Vector {} as Vector<f64>
    data.push(1.0)
    data.push(2.0)
    println matrix.ShapeString(matrix.RowVector(data)), matrix.ShapeString(matrix.ColVector(data)), matrix.ToString(matrix.Diag(data))
    mut b := matrix.Clone(a)
    matrix.SetAll(b, 0.0)
    matrix.CopyInto(b, a)
    println b.same_shape(a), b.at(0, 0)
    println matrix.ToStringPrec(matrix.Arange(0.0, 1.0, 0.25), 2)
    println matrix.ToStringPrec(matrix.Linspace(0.0, 1.0, 5), 2)
    println matrix.ToStringPrec(matrix.Logspace(0.0, 2.0, 3, 10.0), 1)
    println matrix.ToCSV(a, 1)
    println matrix.ToRepr(a, 1)
    println matrix.MAT_EPS > 0.0, matrix.MAT_TOL > 0.0, matrix.MAT_INF > 1000.0
    matrix.Free(b)
    a.free()
end
