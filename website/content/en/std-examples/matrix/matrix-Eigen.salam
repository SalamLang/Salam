import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func show(name: str, m &: matrix.Matrix):
    println name, matrix.ToRepr(matrix.Chop(m, 0.000001), 3)
end

func r(value: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, value), 3)
end

func main:
    mut symmetric := build(2, 2, "2 1 1 2")
    mut decomposition := matrix.EigSym(symmetric)
    println decomposition.ok, decomposition.n, decomposition.sweeps >= 0
    show("values", decomposition.values)
    show("EigReconstruct", matrix.EigReconstruct(decomposition))
    decomposition.free()
    show("EigValsSym", matrix.EigValsSym(symmetric))
    println r(matrix.SpectralRadiusSym(symmetric))
    show("PowSym", matrix.PowSym(symmetric, 2.0))
    show("SqrtSym squared", matrix.MatMul(matrix.SqrtSym(symmetric), matrix.SqrtSym(symmetric)))

    mut general := build(2, 2, "0 1 -2 -3")
    mut eigen := matrix.EigVals(general)
    println eigen.ok, eigen.n, matrix.ToRepr(eigen.re, 3), matrix.ToRepr(eigen.im, 3), eigen.iterations >= 0
    eigen.free()
    mut rotation := build(2, 2, "0 -1 1 0")
    mut complex := matrix.EigValsAuto(rotation)
    show("imaginary", complex.im)
    println r(matrix.SpectralRadius(general))
    show("Hessenberg", matrix.Hessenberg(build(3, 3, "1 2 3 4 5 6 7 8 10")))
    show("CharPoly", matrix.CharPoly(general))
    mut vector := matrix.EigVecFor(symmetric, 3.0, 50)
    show("EigVecFor", matrix.Abs(vector))
    mut power := matrix.PowerIteration(symmetric, 100)
    mut dominant := matrix.SubMatrix(power, 0, 0, 2, 1)
    println r(power.at(2, 0)), r(matrix.Rayleigh(symmetric, dominant)), r(matrix.ShiftedInverseIteration(symmetric, 0.9, 50))

    mut m := build(3, 2, "3 0 0 4 0 0")
    mut svd := matrix.SVDecompose(m)
    println svd.ok, matrix.ShapeString(svd.u), matrix.ShapeString(svd.v)
    show("singular values", svd.s)
    svd.free()
    show("SingularValues", matrix.SingularValues(m))
    println matrix.MatrixRank(m, 0.000001)
    show("PseudoInverse", matrix.PseudoInverse(m, 0.000001))
    show("NullSpace", matrix.NullSpace(build(2, 2, "1 1 1 1"), 0.000001))
    show("ColumnSpace", matrix.Abs(matrix.ColumnSpace(build(2, 2, "1 1 1 1"), 0.000001)))
    show("LowRankApprox", matrix.LowRankApprox(build(2, 2, "3 0 0 1"), 1))

    tol := 0.000001
    identity := matrix.Eye(3)
    println matrix.IsSquare(identity), matrix.AllClose(identity, identity, tol), matrix.IsZero(matrix.Zeros(2, 2), tol), matrix.IsIdentity(identity, tol)
    println matrix.IsSymmetric(symmetric, tol), matrix.IsSkewSymmetric(rotation, tol), matrix.IsDiagonal(identity, tol)
    println matrix.IsUpperTriangular(build(2, 2, "1 2 0 3"), tol), matrix.IsLowerTriangular(build(2, 2, "1 0 2 3"), tol)
    tridiagonal := build(3, 3, "2 1 0 1 2 1 0 1 2")
    println matrix.IsBanded(tridiagonal, 1, 1, tol), matrix.LowerBandwidth(tridiagonal, tol), matrix.UpperBandwidth(tridiagonal, tol)
    println matrix.IsOrthogonal(rotation, tol), matrix.IsNormal(symmetric, tol), matrix.IsIdempotent(build(2, 2, "1 0 0 0"), tol)
    println matrix.IsInvolutory(build(2, 2, "0 1 1 0"), tol), matrix.IsNilpotent(build(2, 2, "0 1 0 0"), tol)
    println matrix.IsPositiveDefinite(symmetric, tol), matrix.IsPositiveSemiDefinite(build(2, 2, "1 1 1 1"), tol)
    println matrix.IsSingular(build(2, 2, "1 2 2 4")), matrix.IsInvertible(symmetric)
    probability := build(2, 2, "0.5 0.5 0.5 0.5")
    println matrix.IsRowStochastic(probability, tol), matrix.IsColStochastic(probability, tol), matrix.IsDoublyStochastic(probability, tol)
    println matrix.IsPermutation(build(2, 2, "0 1 1 0"), tol), matrix.IsToeplitz(tridiagonal, tol), matrix.IsHankel(build(2, 2, "1 2 2 3"), tol)
    println r(matrix.Density(tridiagonal))
end
