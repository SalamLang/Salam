import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func show(name: str, m &: matrix.Matrix):
    println name, matrix.ToRepr(m, 1)
end

func r(value: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, value), 3)
end

func main:
    mut a := build(2, 2, "1 2 3 4")
    mut b := build(2, 2, "0 1 1 0")
    mut row := build(1, 2, "10 20")
    mut col := build(2, 1, "1 -1")
    show("Transpose", matrix.Transpose(a))
    show("MatMul", matrix.MatMul(a, b))
    mut out := matrix.Zeros(2, 2)
    println matrix.TransposeInto(a, out), matrix.MatMulInto(a, b, out)
    show("into", out)
    show("TransposeMul", matrix.TransposeMul(a, b))
    show("MulTranspose", matrix.MulTranspose(a, b))
    show("Gram", matrix.Gram(a))
    show("MatVec", matrix.MatVec(a, col))
    show("VecMat", matrix.VecMat(row, a))
    println matrix.Dot(col, col), matrix.Trace(a)
    show("Outer", matrix.Outer(col, col))
    show("Kron", matrix.Kron(matrix.Eye(2), matrix.Full(1, 2, 3.0)))
    show("MatPow", matrix.MatPow(a, 2))
    show("Cross3", matrix.Cross3(build(3, 1, "1 0 0"), build(3, 1, "0 1 0")))

    show("Add", matrix.Add(a, b))
    show("Sub", matrix.Sub(a, b))
    show("MulElem", matrix.MulElem(a, b))
    show("DivElem", matrix.DivElem(a, a))
    show("Neg", matrix.Neg(a))
    show("with scalars", matrix.AddScalar(matrix.SubScalar(matrix.Scale(matrix.DivScalar(a, 2.0), 4.0), 1.0), 1.0))
    mut c := matrix.Clone(a)
    matrix.AddInPlace(c, b)
    matrix.SubInPlace(c, b)
    matrix.MulElemInPlace(c, a)
    matrix.ScaleInPlace(c, 0.5)
    matrix.AddScalarInPlace(c, 1.0)
    matrix.NegInPlace(c)
    matrix.AddScaled(c, a, 2.0)
    show("in place", c)
    show("Combine", matrix.Combine(a, 2.0, b, -1.0))
    show("MaxElem", matrix.MaxElem(a, matrix.Full(2, 2, 2.5)))
    show("MinElem", matrix.MinElem(a, matrix.Full(2, 2, 2.5)))
    show("AddRowVector", matrix.AddRowVector(a, row))
    show("AddColVector", matrix.AddColVector(a, col))
    show("MulRowVector", matrix.MulRowVector(a, row))
    show("MulColVector", matrix.MulColVector(a, col))

    mut m := build(1, 4, "-2.25 0 0.5 9")
    show("Abs", matrix.Abs(m))
    show("Sqrt", matrix.Sqrt(matrix.Abs(m)))
    show("Cbrt", matrix.Cbrt(build(1, 2, "8 -27")))
    show("Floor and Ceil", matrix.HStack(matrix.Floor(m), matrix.Ceil(m)))
    show("Round and Trunc", matrix.HStack(matrix.Round(m), matrix.Trunc(m)))
    show("Sign", matrix.Sign(m))
    show("Square", matrix.Square(m))
    show("Reciprocal", matrix.Reciprocal(build(1, 2, "2 4")))
    show("PowElem", matrix.PowElem(build(1, 2, "2 3"), 3.0))
    show("Clip", matrix.Clip(m, 0.0, 1.0))
    show("MaxScalar and MinScalar", matrix.HStack(matrix.MaxScalar(m, 0.0), matrix.MinScalar(m, 0.0)))
    show("Chop", matrix.Chop(build(1, 2, "0.0000001 1"), 0.0001))
    mut zero := matrix.Zeros(1, 1)
    println matrix.ToStringPrec(matrix.HStack(matrix.Exp(zero), matrix.Log(matrix.Ones(1, 1))), 3), matrix.ToStringPrec(matrix.Log10(matrix.Full(1, 1, 100.0)), 3), matrix.ToStringPrec(matrix.Log2(matrix.Full(1, 1, 8.0)), 3)
    println matrix.ToStringPrec(matrix.HStack(matrix.Sin(zero), matrix.Cos(zero)), 3), matrix.ToStringPrec(matrix.Tan(zero), 3)
    println matrix.ToStringPrec(matrix.HStack(matrix.Asin(zero), matrix.Acos(matrix.Ones(1, 1))), 3), matrix.ToStringPrec(matrix.Atan(zero), 3)
    println matrix.ToStringPrec(matrix.HStack(matrix.Sinh(zero), matrix.Cosh(zero)), 3), matrix.ToStringPrec(matrix.Tanh(zero), 3)

    println matrix.Sum(a), matrix.Prod(a), matrix.Mean(a), matrix.Min(a), matrix.Max(a), matrix.Range(a)
    k := matrix.ArgMax(a)
    println matrix.ArgMin(a), k, matrix.IndexRow(a, k), matrix.IndexCol(a, k), matrix.MaxAbs(m)
    println r(matrix.Var(a, true)), r(matrix.Std(a, false)), matrix.Median(a)
    show("RowSums", matrix.RowSums(a))
    show("ColSums", matrix.ColSums(a))
    show("RowMeans", matrix.RowMeans(a))
    show("ColMeans", matrix.ColMeans(a))
    show("RowMins and RowMaxs", matrix.HStack(matrix.RowMins(a), matrix.RowMaxs(a)))
    show("ColMins and ColMaxs", matrix.VStack(matrix.ColMins(a), matrix.ColMaxs(a)))
    show("cumulative", matrix.HStack(matrix.CumSumRows(a), matrix.CumSumCols(a)))
    show("CumProdRows", matrix.CumProdRows(a))
    println matrix.CountNonZero(b), matrix.Any(b), matrix.All(b), matrix.AllFinite(b)

    println r(matrix.NormFrobenius(a)), matrix.Norm1(a), matrix.NormInf(a), matrix.NormMax(a)
    println r(matrix.Norm2(a)), r(matrix.NormNuclear(a)), matrix.VecNorm(col, 1.0), r(matrix.Distance(col, matrix.Zeros(2, 1)))
    show("Normalize", matrix.Normalize(build(1, 2, "3 4")))
    println matrix.ToStringPrec(matrix.NormalizeRows(a), 2)
    println matrix.ToStringPrec(matrix.NormalizeCols(a), 2)
    println r(matrix.Cond1(a)), r(matrix.CondInf(a)), r(matrix.Cond2(a))
end
