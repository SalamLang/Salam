import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func show(name: str, m &: matrix.Matrix):
    println name, matrix.ToRepr(matrix.Chop(m, 0.000001), 3)
end

func r(value: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, value), 3)
end

func main:
    mut a := build(3, 3, "4 1 0 1 3 1 0 1 2")
    mut b := build(3, 1, "1 2 3")
    println r(matrix.Det(a)), r(matrix.LogAbsDet(a))
    show("Solve", matrix.Solve(a, b))
    show("SolveVec", matrix.SolveVec(a, b))
    mut lu := matrix.Decompose(a)
    println lu.n, lu.piv.len(), lu.sign, lu.singular, matrix.ShapeString(lu.lu)
    show("LUSolve", matrix.LUSolve(lu, b))
    lu.free()
    mut inverse := matrix.Inverse(a)
    show("a times its inverse", matrix.MatMul(a, inverse))
    show("Adjugate", matrix.Adjugate(build(2, 2, "1 2 3 4")))
    show("Residual", matrix.Residual(a, matrix.Solve(a, b), b))

    mut qr := matrix.QRDecompose(a)
    println qr.m, qr.n, qr.full_rank, matrix.ShapeString(qr.qr), matrix.ShapeString(qr.rdiag)
    show("Q times R", matrix.MatMul(matrix.QRGetQ(qr), matrix.QRGetR(qr)))
    show("QRSolve", matrix.QRSolve(qr, b))
    qr.free()
    mut points := build(4, 2, "1 0 1 1 1 2 1 3")
    mut values := build(4, 1, "1 3 5 7")
    show("LeastSquares", matrix.LeastSquares(points, values))
    show("Orthonormalize", matrix.Gram(matrix.Orthonormalize(points)))

    show("Cholesky", matrix.Cholesky(a))
    show("SolveSPD", matrix.SolveSPD(a, b))
    show("CholeskySolve", matrix.CholeskySolve(matrix.Cholesky(a), b))
    show("InverseSPD", matrix.MatMul(a, matrix.InverseSPD(a)))
    println r(matrix.DetSPD(a)), r(matrix.LogDetSPD(a))
    mut ldl := matrix.LDLDecompose(a)
    println ldl.ok, ldl.n, matrix.ShapeString(ldl.l), matrix.ShapeString(ldl.d)
    show("LDLSolve", matrix.LDLSolve(ldl, b))
    ldl.free()
    show("Inertia", matrix.Inertia(build(2, 2, "1 0 0 -1")))

    mut singular := build(3, 3, "1 2 3 2 4 6 1 1 1")
    show("RowEchelon", matrix.RowEchelon(singular))
    show("RREF", matrix.RREF(singular))
    show("PivotColumns", matrix.PivotColumns(singular))
    println matrix.RankExact(singular), matrix.Nullity(singular)
    show("NullSpaceExact", matrix.NullSpaceExact(singular))
    show("ColumnSpaceExact", matrix.ColumnSpaceExact(singular))
    mut right := build(3, 1, "6 12 3")
    println matrix.IsConsistent(singular, right), matrix.IsConsistent(singular, build(3, 1, "1 3 3"))
    show("SolveGeneral", matrix.SolveGeneral(singular, right))

    println matrix.IsDiagonallyDominant(a)
    mut jacobi := matrix.SolveJacobi(a, b, 200, 0.00000001)
    println jacobi.converged, jacobi.iterations > 0, jacobi.residual < 0.0001
    show("Jacobi", jacobi.x)
    jacobi.free()
    each method in [1, 2, 3]:
        mut result := matrix.SolveGaussSeidel(a, b, 200, 0.00000001)
        if method == 2:
            result = matrix.SolveSOR(a, b, 1.2, 200, 0.00000001)
        else method == 3:
            result = matrix.SolveCG(a, b, 200, 0.00000001)
        end
        show("iterative", result.x)
        result.free()
    end

    mut d := build(2, 2, "1 0 0 2")
    show("Expm", matrix.Expm(matrix.Zeros(2, 2)))
    show("Sqrtm", matrix.Sqrtm(build(2, 2, "4 0 0 9")))
    show("MatrixSign", matrix.MatrixSign(build(2, 2, "2 0 0 -3")))
    show("PolyEval", matrix.PolyEval(d, build(1, 3, "1 0 1")))
    show("CayleyHamilton", matrix.CayleyHamilton(d))
    show("LogmSym", matrix.LogmSym(matrix.Eye(2)))
end
