import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func show(name: str, m &: matrix.Matrix):
    println name, matrix.ToRepr(matrix.Chop(m, 0.000001), 3)
end

func r(value: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, value), 3)
end

func main:
    show("Hilbert", matrix.Hilbert(2))
    show("Hilbert times its inverse", matrix.MatMul(matrix.Hilbert(3), matrix.HilbertInverse(3)))
    show("Vandermonde", matrix.Vandermonde(build(3, 1, "1 2 3"), 3))
    show("Toeplitz", matrix.Toeplitz(build(3, 1, "1 2 3"), build(1, 3, "1 4 5")))
    show("Hankel", matrix.Hankel(build(3, 1, "1 2 3"), build(1, 3, "3 4 5")))
    show("Circulant", matrix.Circulant(build(1, 3, "1 2 3")))
    show("Companion", matrix.Companion(build(1, 3, "1 -3 2")))
    show("Pascal", matrix.Pascal(3))
    show("Rotation2D", matrix.Rotation2D(0.0))
    show("Rotation3D", matrix.Rotation3D(2, 0.0))
    show("Householder", matrix.Householder(build(2, 1, "1 0")))
    show("Givens", matrix.Givens(2, 0, 1, 0.0))
    show("Permutation", matrix.Permutation(build(1, 3, "2 0 1")))

    mut rng := matrix.NewRng(7)
    println rng.next_bits() > 0, rng.next_float() < 1.0, rng.next_normal() < 10.0
    mut random := matrix.Random(2, 3, -1.0, 1.0, 5)
    println matrix.ShapeString(random), matrix.Min(random) >= -1.0, matrix.Max(random) < 1.0, matrix.AllClose(random, matrix.Random(2, 3, -1.0, 1.0, 5), 0.0)
    println matrix.ShapeString(matrix.RandomNormal(2, 2, 1))
    println matrix.IsSymmetric(matrix.RandomSymmetric(3, 1), 0.000001), matrix.IsPositiveDefinite(matrix.RandomSPD(3, 1), 0.000001), matrix.IsOrthogonal(matrix.RandomOrthogonal(3, 1), 0.00001)

    mut data := build(4, 2, "1 2 2 4 3 6 4 8")
    show("CenterColumns", matrix.CenterColumns(data))
    show("ColumnMeans", matrix.ColumnMeans(data))
    show("ColumnStds", matrix.ColumnStds(data, false))
    show("Standardize", matrix.Standardize(data, false))
    show("Covariance", matrix.Covariance(data, true))
    show("Correlation", matrix.Correlation(data))
    mut pca := matrix.PCAFit(data)
    println matrix.ShapeString(pca.components), matrix.ShapeString(pca.variances), matrix.ShapeString(pca.center)
    show("ExplainedVariance", matrix.ExplainedVariance(pca))
    show("PCATransform", matrix.Abs(matrix.PCATransform(pca, data, 1)))
    pca.free()
    mut pca2 := matrix.PCAFromSVD(data)
    show("from the SVD", matrix.ExplainedVariance(pca2))
    pca2.free()

    mut x := build(4, 1, "1 2 3 4")
    mut y := build(4, 1, "3 5 7 9")
    coefficients := matrix.LinearRegression(x, y)
    show("LinearRegression", coefficients)
    println r(matrix.RSquared(y, y))
end
