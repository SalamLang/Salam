import mem

func main:
    a := mem.MustAllocate(8 as u64) as i64*
    a[0] = 7
    println a[0]
    b := mem.MustAllocateZeroed(8 as u64) as i64*
    println b[0]
    grown := mem.MustReallocate(a as void*, 64 as u64)
    held := mem.Allocate(16 as u64)
    if held == null:
        mem.OutOfMemory()
    end
    mem.Free(held)
    mem.Free(grown)
    mem.Free(b as void*)
end
