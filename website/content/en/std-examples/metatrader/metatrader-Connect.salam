import metatrader

func main:
    metatrader.SetBridgeUrl("http://127.0.0.1:18812")
    println metatrader.BridgeUrl()

    if not metatrader.Initialize("", 12345678 as i64, "secret", "Broker-Demo", 60000, false):
        e := metatrader.LastError()
        printerrln "initialize failed:", e.code, e.description
        ret 1
    end
    if not metatrader.Login(12345678 as i64, "secret", "Broker-Demo", 60000):
        e := metatrader.LastError()
        printerrln "login failed:", e.code, e.description
        ret 1
    end

    v := metatrader.Version()
    println "connected:", metatrader.IsConnected()
    println "terminal:", v.terminal_version, "build", v.build, v.build_release_date
    if not metatrader.Ok():
        e := metatrader.LastError()
        printerrln e.code, e.description
    end

    metatrader.Shutdown()
    ret 0
end
