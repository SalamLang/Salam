import metatrader

func main:
    metatrader.SetBridgeUrl("http://127.0.0.1:18812")

    println "orders:", metatrader.OrdersTotal()
    each o in metatrader.OrdersGet():
        println o.ticket, o.symbol, o.order_type, o.state, o.volume_current, o.price_open
    end
    println "EURUSD orders:", metatrader.OrdersGetSymbol("EURUSD").Len()
    println "USD orders:", metatrader.OrdersGetGroup("*USD*").Len()
    pending := metatrader.OrdersGetTicket(1001 as i64)
    if pending.Len() > 0:
        println "order 1001:", pending.get(0).symbol, pending.get(0).price_open
    end

    println "positions:", metatrader.PositionsTotal()
    each p in metatrader.PositionsGet():
        println p.ticket, p.symbol, p.position_type, p.volume, p.price_open, p.profit
    end
    println "EURUSD positions:", metatrader.PositionsGetSymbol("EURUSD").Len()
    println "USD positions:", metatrader.PositionsGetGroup("*USD*").Len()
    open := metatrader.PositionsGetTicket(2001 as i64)
    if open.Len() > 0:
        println "position 2001:", open.get(0).symbol, open.get(0).profit
    end
    ret 0
end
