import ml
import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func show(name: str, m &: matrix.Matrix):
    println name, matrix.ToRepr(matrix.Chop(m, 0.000001), 3)
end

func f3(number: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, number), 3)
end

func main:
    mut x := build(8, 2, "1 1 1 2 2 1 2 2 6 6 6 7 7 6 7 7")
    mut y := build(8, 1, "0 0 0 0 1 1 1 1")
    mut test := build(2, 2, "1.5 1.5 6.5 6.5")

    mut knn := ml.KNNClassifier { k = 3, weighted = true, algorithm = ml.KNN_KDTREE }
    println knn.fit(x, y), knn.ok, knn.n_classes, knn.leaf_size, knn.workers, matrix.ShapeString(knn.xtrain), matrix.ShapeString(knn.ytrain), knn.tree.ok
    show("neighbors", knn.predict(test))
    println matrix.ShapeString(knn.predict_proba(test)), f3(knn.score(x, y)), ml.KNN_BRUTE
    mut regressor := ml.KNNRegressor { k = 2 }
    println regressor.fit(x, y), regressor.ok, regressor.weighted, regressor.algorithm, regressor.leaf_size, regressor.workers, matrix.ShapeString(regressor.xtrain), matrix.ShapeString(regressor.ytrain), regressor.tree.ok
    show("regressor", regressor.predict(test))
    println f3(regressor.score(x, y))

    mut gaussian := ml.GaussianNB {}
    println gaussian.fit(x, y), gaussian.ok, gaussian.n_classes, gaussian.var_smoothing > 0.0, matrix.ShapeString(gaussian.means), matrix.ShapeString(gaussian.vars), matrix.ShapeString(gaussian.log_priors)
    show("gaussian", gaussian.predict(test))
    println matrix.ShapeString(gaussian.predict_proba(test)), f3(gaussian.score(x, y))
    mut counts := build(4, 3, "3 0 1 2 0 0 0 3 1 0 2 2")
    mut topic := build(4, 1, "0 0 1 1")
    mut multinomial := ml.MultinomialNB { alpha = 1.0 }
    println multinomial.fit(counts, topic), multinomial.ok, multinomial.fit_prior, multinomial.n_classes, matrix.ShapeString(multinomial.log_prob), matrix.ShapeString(multinomial.log_priors)
    show("multinomial", multinomial.predict(counts))
    println matrix.ShapeString(multinomial.decision(counts)), matrix.ShapeString(multinomial.predict_proba(counts)), f3(multinomial.score(counts, topic))

    mut lda := ml.LDA {}
    println lda.fit(x, y), lda.ok, lda.n_classes, lda.ridge > 0.0, matrix.ShapeString(lda.means), matrix.ShapeString(lda.cov), matrix.ShapeString(lda.log_priors)
    show("linear", lda.predict(test))
    println matrix.ShapeString(lda.predict_proba(test)), f3(lda.score(x, y))
    mut qda := ml.QDA {}
    println qda.fit(x, y), qda.ok, qda.n_classes, qda.ridge > 0.0, matrix.ShapeString(qda.means), qda.covs.len(), matrix.ShapeString(qda.log_priors)
    show("quadratic", qda.predict(test))
    println matrix.ShapeString(qda.predict_proba(test)), f3(qda.score(x, y))

    mut svm := ml.LinearSVM { c = 1.0 }
    println svm.fit(x, y), svm.ok, svm.n_classes, svm.max_iter, svm.tol > 0.0, svm.seed, matrix.ShapeString(svm.coef), matrix.ShapeString(svm.intercept)
    show("linear svm", svm.predict(test))
    println matrix.ShapeString(svm.decision(test)), f3(svm.score(x, y))
    mut rbf := ml.SVC { kernel = ml.KERNEL_RBF, c = 10.0, gamma = 0.5 }
    println rbf.fit(x, y), rbf.ok, rbf.n_classes, rbf.n_support() > 0, rbf.degree, rbf.coef0, rbf.max_passes, rbf.tol > 0.0, rbf.seed
    println matrix.ShapeString(rbf.support), matrix.ShapeString(rbf.dual), matrix.ShapeString(rbf.bias)
    show("rbf kernel", rbf.predict(test))
    println matrix.ShapeString(rbf.decision(test)), f3(rbf.score(x, y)), ml.KERNEL_LINEAR, ml.KERNEL_POLY

    mut truth := build(6, 1, "0 0 1 1 1 0")
    mut pred := build(6, 1, "0 1 1 1 0 0")
    mut score := build(6, 1, "0.1 0.6 0.8 0.9 0.4 0.2")
    println f3(ml.Accuracy(truth, pred)), f3(ml.Precision(truth, pred, 1.0)), f3(ml.Recall(truth, pred, 1.0)), f3(ml.F1(truth, pred, 1.0)), f3(ml.MacroF1(truth, pred, 2))
    show("confusion", ml.ConfusionMatrix(truth, pred, 2))
    println f3(ml.RocAuc(truth, score)), f3(ml.AveragePrecision(truth, score)), f3(ml.BalancedAccuracy(truth, pred)), f3(ml.MatthewsCorrCoef(truth, pred)), f3(ml.CohenKappa(truth, pred))
    println matrix.ShapeString(ml.RocCurve(truth, score)), matrix.ShapeString(ml.PrecisionRecallCurve(truth, score))
    mut proba := build(6, 2, "0.9 0.1 0.4 0.6 0.2 0.8 0.1 0.9 0.6 0.4 0.8 0.2")
    println f3(ml.LogLoss(truth, proba))
    knn.free()
    regressor.free()
    gaussian.free()
    multinomial.free()
    lda.free()
    qda.free()
    svm.free()
    rbf.free()
end
