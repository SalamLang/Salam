import ml
import matrix

func build(rows: int, cols: int, numbers: str): matrix.Matrix:
    mut data := Vector {} as Vector<f64>
    each number in numbers.split(" "):
        data.push(number.to_float())
    end
    ret matrix.FromArray(rows, cols, data)
end

func f3(number: f64): str:
    ret matrix.ToStringPrec(matrix.Full(1, 1, number), 3)
end

func main:
    mut x := build(8, 2, "1 1 1 2 2 1 2 2 8 8 8 9 9 8 9 9")
    mut truth := build(8, 1, "0 0 0 0 1 1 1 1")

    mut km := ml.KMeans { k = 2, seed = 1 }
    mut labels := km.fit_predict(x)
    println km.ok, km.n_iter > 0, f3(km.inertia), matrix.ShapeString(km.centers), km.max_iter, km.tol > 0.0, km.n_init, km.workers
    println labels.at(0, 0) != labels.at(4, 0), f3(ml.AdjustedRandIndex(labels, truth)), f3(ml.SilhouetteScore(x, labels))
    println km.fit(x), matrix.ShapeString(km.predict(x))
    mut mini := ml.MiniBatchKMeans { k = 2, batch_size = 4, max_iter = 50, seed = 2 }
    println mini.fit(x), mini.ok, matrix.ShapeString(mini.centers), f3(ml.AdjustedRandIndex(mini.fit_predict(x), truth)), matrix.ShapeString(mini.predict(x))

    mut density := ml.DBSCAN { eps = 1.5, min_samples = 3 }
    mut clusters := density.fit_predict(x)
    println density.ok, density.n_clusters, matrix.ShapeString(density.labels), f3(ml.AdjustedRandIndex(clusters, truth)), density.fit(x)

    mut agg := ml.Agglomerative { n_clusters = 2, linkage = ml.LINK_AVERAGE }
    println f3(ml.AdjustedRandIndex(agg.fit_predict(x), truth)), agg.ok, matrix.ShapeString(agg.labels), agg.fit(x)
    println ml.LINK_SINGLE, ml.LINK_COMPLETE

    mut mixture := ml.GaussianMixture { k = 2, seed = 3 }
    println f3(ml.AdjustedRandIndex(mixture.fit_predict(x), truth)), mixture.ok, mixture.n_iter > 0, mixture.log_likelihood != 0.0, mixture.max_iter, mixture.tol > 0.0, mixture.var_floor > 0.0
    println matrix.ShapeString(mixture.means), matrix.ShapeString(mixture.vars), matrix.ShapeString(mixture.weights), mixture.fit(x)
    println matrix.ShapeString(mixture.predict(x)), matrix.ShapeString(mixture.predict_proba(x))

    mut tsne := ml.TSNE { n_components = 2, perplexity = 2.0, n_iter = 250, seed = 4 }
    mut embedded := tsne.fit_transform(x)
    println tsne.ok, matrix.ShapeString(embedded), matrix.ShapeString(tsne.embedding), tsne.kl >= 0.0, tsne.learning_rate, tsne.early_exaggeration
    km.free()
    mini.free()
    density.free()
    agg.free()
    mixture.free()
    tsne.free()
end
