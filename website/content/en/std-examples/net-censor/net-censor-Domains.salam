import net.censor

func main:
    mut set := censor.NewDomainSet()
    println censor.AddRule(set, "example.com"), censor.AddRule(set, "full:only.test.org"), censor.AddRule(set, "keyword:torrent")
    println censor.AddRule(set, "domain:*.cdn.net"), censor.AddRule(set, "regexp:a.*"), censor.AddRule(set, "  ")
    println censor.AddRules(set, "# a comment\nblocked.io # trailing\n\nfoo.bar\n"), set.count
    println censor.MatchDomain(set, "example.com"), censor.MatchDomain(set, "WWW.Example.COM."), censor.MatchDomain(set, "badexample.com")
    println censor.MatchDomain(set, "only.test.org"), censor.MatchDomain(set, "x.only.test.org"), censor.MatchDomain(set, "my-torrent-site.xyz")
    println censor.MatchDomain(set, "a.b.cdn.net"), censor.MatchDomain(set, "x.blocked.io"), censor.MatchDomain(set, "net")
    println set.suffixes.Size(), set.fulls.Size(), set.keywords.Len()
    censor.FreeDomainSet(set)

    println censor.IsPrivateHost("192.168.1.5"), censor.IsPrivateHost("172.20.0.1"), censor.IsPrivateHost("172.40.0.1"), censor.IsPrivateHost("localhost"), censor.IsPrivateHost("::1"), censor.IsPrivateHost("example.com")

    mut classifier := censor.NewClassifier(censor.DecisionProxy)
    classifier.direct = censor.IranDirectSet()
    classifier.block = censor.NewDomainSet()
    censor.AddRule(classifier.block, "ads.example.org")
    each host in ["www.digikala.com", "mail.sharif.ir", "youtube.com", "ads.example.org", "192.168.1.5", "172.40.0.1"]:
        println host, censor.Classify(classifier, host)
    end
    println censor.DecisionProxy, censor.DecisionDirect, censor.DecisionBlock

    filtered := censor.FilteredSet()
    println censor.MatchDomain(filtered, "m.youtube.com"), censor.MatchDomain(filtered, "digikala.com")
    println censor.IranDirectList().StartsWith("#"), censor.FilteredList().Includes("youtube.com")
end
