import net.censor

func main:
    mut guard := censor.NewProbeGuard(3, 1000 as i64, 5000 as i64)
    println guard.max_fails, guard.window_ms, guard.ban_ms
    println censor.GuardAllowed(guard, "1.2.3.4", 0 as i64)
    println censor.GuardRecordFail(guard, "1.2.3.4", 100 as i64), censor.GuardRecordFail(guard, "1.2.3.4", 200 as i64), censor.GuardRecordFail(guard, "1.2.3.4", 300 as i64)
    println censor.GuardAllowed(guard, "1.2.3.4", 400 as i64), censor.GuardAllowed(guard, "5.6.7.8", 400 as i64), censor.GuardAllowed(guard, "1.2.3.4", 5400 as i64)
    println censor.GuardRecordFail(guard, "9.9.9.9", 0 as i64), censor.GuardRecordFail(guard, "9.9.9.9", 2000 as i64), censor.GuardRecordFail(guard, "9.9.9.9", 2100 as i64)
    censor.GuardRecordFail(guard, "7.7.7.7", 0 as i64)
    censor.GuardRecordFail(guard, "7.7.7.7", 10 as i64)
    censor.GuardRecordOK(guard, "7.7.7.7")
    println censor.GuardRecordFail(guard, "7.7.7.7", 20 as i64), guard.fails.Get("7.7.7.7")
    censor.FreeProbeGuard(guard)

    mut cache := censor.NewReplayCache(1000 as i64, 4)
    println cache.ttl_ms, cache.max_entries
    println censor.ReplaySeen(cache, "a", 0 as i64), censor.ReplaySeen(cache, "a", 500 as i64), censor.ReplaySeen(cache, "a", 1600 as i64)
    println cache.seen.Size()
    censor.FreeReplayCache(cache)

    println censor.ShouldFallback(false), censor.ShouldFallback(true)
    wait := censor.DelayMs(5, 20)
    println wait >= 5, wait <= 20
    println censor.DecoyResponse().Substr(0, 22)
    println censor.DecoyResponse().Includes("nginx")
end
