import net.censor

const HELLO := "160301008c010000880303000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f206465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80818283000613011302c02b0100003900000014001200000f7777772e6578616d706c652e636f6d000a00040002001d0010000e000c02683208687474702f312e31002b0003020304"

func main:
    hello := censor.FromHex(HELLO)
    println "hello bytes:", hello.len, censor.ToHex(hello).len()
    println censor.KindName(censor.Sniff(hello.data, hello.len))
    println censor.KindName(censor.Sniff("GET / HTTP/1.1" as void*, 14))
    println censor.KindName(censor.Sniff("SSH-2.0-OpenSSH_9.6" as void*, 19))
    println censor.KindName(censor.Sniff(censor.FromHex("050100").data, 3))
    println censor.KindName(censor.Sniff(censor.FromHex("0401005000000001").data, 8))
    println censor.KindName(censor.Sniff("GE" as void*, 2))
    println censor.KindName(censor.Sniff("zzzz" as void*, 4))
    println censor.Sniff(hello.data, hello.len) == censor.KindTLS, censor.KindUnknown, censor.KindHTTP, censor.KindSSH, censor.KindSOCKS5, censor.KindSOCKS4, censor.KindTooShort

    ch := censor.ParseClientHello(hello.data, hello.len)
    println ch.ok, ch.truncated, ch.record_len
    println ch.sni, ch.sni_offset, ch.sni_len
    println ch.record_version, ch.hello_version, ch.session_id_len, ch.cipher_count, ch.ext_count
    println ch.has_tls13, ch.has_ech, ch.alpn.len(), ch.alpn.get(0), ch.alpn.get(1)
    println censor.ExtractSNI(hello.data, hello.len)

    cut := censor.ParseClientHello(hello.data, 60)
    println "cut short:", cut.ok, cut.truncated, cut.sni.len()
    println "not tls:", censor.ParseClientHello("GET / HTTP/1.1" as void*, 14).ok
end
