import net.devreload

func main:
    println devreload.Enabled()
    devreload.InitLocal("run1", "")
    println devreload.Enabled()
    devreload.Bump(1)
    page := devreload.Inject("<html><head></head><body><h1>Hi</h1></body></html>")
    println page.Len() > 1000
    println devreload.Script().Len() > 500
    devreload.SetLang("fa")
    println devreload.Lang()
end
