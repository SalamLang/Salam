import net.doh

func main:
    mut servers := Vector {} as Vector<doh.Server>
    servers.push(doh.Cloudflare())
    servers.push(doh.GoogleDoT())
    servers.push(doh.Quad9())
    resolver := doh.NewResolver(servers)
    doh.SetTimeout(resolver, 3000)

    answer := doh.Resolve(resolver, "example.com", 1)
    println answer.ok, answer.cached, answer.server, answer.ttl
    each ip in doh.LookupHost(resolver, "example.com"):
        println ip
    end

    stub := doh.StartStub(resolver, "127.0.0.1", 5353)
    println "local resolver on port", stub.port
    doh.StopStub(stub)
end
