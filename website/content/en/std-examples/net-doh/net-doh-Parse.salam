import compress
import net.dns
import net.doh

func main:
    println doh.IsIP("1.2.3.4"), doh.IsIP("2001:db8::1"), doh.IsIP("dns.google"), doh.IsIP("1.2.3")
    url := doh.ParseURL("https://dns.example.net/dns-query")
    println url.ok, url.use_tls, url.host, url.port, url.path
    plain := doh.ParseURL("http://127.0.0.1:8053")
    println plain.ok, plain.use_tls, plain.port, plain.path
    println doh.ParseURL("ftp://x").ok

    mut v4 := compress.NewByteBuf()
    println doh.ParseIPv4("10.0.0.7", v4), v4.len
    mut v6 := compress.NewByteBuf()
    println doh.ParseIPv6("2001:db8::7", v6), v6.len
    println doh.ParseIPv4("10.0.0", compress.NewByteBuf())

    mut records := Vector {} as Vector<dns.Record>
    records.Push(dns.Record { name = "example.test", rtype = dns.TypeA, rclass = 1, ttl = 300, data = "192.0.2.7" })
    wire := doh.EncodeResponse(4242, "example.test", dns.TypeA, 0, records)
    message := dns.Decode(wire.data, wire.len)
    println message.id, message.qr, message.rcode, message.questions.items.Len(), message.answers.items.Len()
    answer := message.answers.items.Get(0)
    println answer.name, answer.ttl, answer.data
    nx := doh.EncodeResponse(7, "nothing.test", dns.TypeA, 3, Vector {} as Vector<dns.Record>)
    println dns.Decode(nx.data, nx.len).rcode
end
