import net.doh

func main:
    cloudflare := doh.Cloudflare()
    println cloudflare.name, cloudflare.kind == doh.KindDoH, cloudflare.url, cloudflare.host, cloudflare.port, cloudflare.path, cloudflare.use_tls
    println cloudflare.addrs.Get(0), cloudflare.addrs.Get(1)
    println doh.Google().host, doh.Google().addrs.Get(0), doh.Quad9().host, doh.Quad9().addrs.Get(0)
    dot := doh.CloudflareDoT()
    println dot.kind == doh.KindDoT, dot.host, dot.port, dot.addrs.Get(0)
    println doh.GoogleDoT().addrs.Get(0), doh.Quad9DoT().host

    custom := doh.NewServer("mine", doh.KindDoHGet, "https://dns.example.net/resolve")
    println custom.kind == doh.KindDoHGet, custom.host, custom.path, custom.addrs.Len()
    pinned := doh.WithBootstrap(custom, "203.0.113.53")
    println pinned.addrs.Len(), custom.addrs.Len(), pinned.addrs.Get(0)

    mine := doh.NewDoT("dot", "dns.example.net", "203.0.113.54")
    plain := doh.NewPlain("plain", "203.0.113.55")
    println mine.port, mine.use_tls, plain.port, plain.kind == doh.KindUDP, plain.use_tls
    println doh.KindDoH, doh.KindDoHGet, doh.KindDoT, doh.KindUDP

    mut servers := doh.DefaultServers()
    println servers.Len(), servers.Get(0).name, servers.Get(2).name
    iran := doh.IranPlainServers()
    println iran.Len(), iran.Get(0).name, iran.Get(0).port, iran.Get(0).addrs.Get(0)
    println doh.Shecan().Len(), doh.Electro().Get(0).name, doh.Radar().Get(1).name, doh.Begzar().Get(0).addrs.Get(0)
    doh.FreeServers(servers)
end
