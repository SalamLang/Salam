import net.http
import net.router
import time

func show(ctx: i64):
    http.AddHeader(ctx, "X-Test", "one")
    http.AddHeader(ctx, "X-Test", "two")
    http.AddHeader(ctx, "Set-Cookie", "a=1; Path=/")
    http.AddHeader(ctx, "Set-Cookie", "b=2; Path=/")
    http.Text(ctx, "ok")
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/", show)
    mut s := http.NewServer(19521)
    http.SetHost(s, "127.0.0.1")
    http.Use(s, r)
    if not http.RunBackground(s):
        println "cannot listen"
        ret 1
    end
    time.Sleep(300)
    resp := http.Get("http://127.0.0.1:19521/")
    println resp.status
    each v in http.HeaderValues(resp, "X-Test"):
        println v
    end
    each c in http.HeaderValues(resp, "Set-Cookie"):
        println c
    end
    ret 0
end
