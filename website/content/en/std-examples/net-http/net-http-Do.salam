import net.http
import net.tcp
import sync

mut server := tcp.Server {}

func backend():
    repeat 6:
        conn := tcp.Accept(server)
        request := tcp.Read(conn, 4096)
        if request.find("GET /old ") == 0:
            _ := tcp.Write(conn, "HTTP/1.1 302 Found\r\nLocation: /new\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        else request.find("GET /silent ") == 0:
            sync.SleepMs(700)
        else request.find("GET /big ") == 0:
            tcp.WriteHTTP(conn, "200 OK", "text/plain", "0123456789")
        else:
            tcp.WriteHTTP(conn, "200 OK", "text/plain", "landed")
        end
        tcp.Close(conn)
    end
end

func main:
    server = tcp.Bind(0)
    t := spawn(backend)
    base := "http://127.0.0.1:" + tcp.Port(server)
    mut c := http.NewClient()
    c.SetMaxRedirects(3)
    c.SetTimeout(5000)
    c.SetIdleTimeout(2000)
    c.SetMaxBody(1000)
    r := c.Get(base + "/old")
    println r.status, http.Body(r), r.url.find("/new") > 0
    mut tight := http.RequestOptions {}
    tight.max_body = 5
    big := http.Do("GET", base + "/big", http.NewHeaders(), "", tight)
    println big.status, big.err
    mut quick := http.RequestOptions {}
    quick.timeout_ms = 200
    silent := http.Do("GET", base + "/silent", http.NewHeaders(), "", quick)
    println silent.status, silent.err
    raw := c.RequestBytes("GET", base + "/big", "", "")
    println raw.status, raw.body.len
    println c.RequestRaw("GET", base + "/new", "X-Id: 1\r\n", "").status
    c.Free()
    join(t)
    tcp.CloseServer(server)
end
