import net.http

func main:
    e := http.ParseEndpoint("https://api.example.com:8443/v1/users")
    println http.EndpointOk(e), http.Host(e), http.Port(e), http.Secure(e)
    plain := http.ParseEndpoint("http://example.com")
    println http.EndpointOk(plain), http.Host(plain), http.Port(plain), http.Secure(plain)
    println http.EndpointOk(http.ParseEndpoint("ftp://example.com"))
end
