import io
import os
import net.http
import net.router

func page(ctx: i64):
    path := os.TempDir() + "/salam_filebody.txt"
    if http.File(ctx, path, "text/plain"):
        http.SetHeader(ctx, "X-Port", http.Own(ctx, "" + http.LocalPort(ctx)))
        http.SetHeader(ctx, "X-Status", http.Own(ctx, "" + http.Status(ctx)))
    else:
        http.SetStatus(ctx, 404)
        http.Text(ctx, "no file")
    end
end

func main:
    path := os.TempDir() + "/salam_filebody.txt"
    io.WriteFile(path, "hello from a file")
    mut r := router.NewRouter()
    router.Get(r, "/file", page)
    mut s := http.NewServer(19622)
    http.Use(s, r)
    println http.RunBackground(s)
    a := http.Get("http://127.0.0.1:19622/file")
    println http.Status(a), http.Body(a)
    println http.GetHeader(a, "x-port"), http.GetHeader(a, "x-status"), http.GetHeader(a, "content-type")
    os.Remove(path)
end
