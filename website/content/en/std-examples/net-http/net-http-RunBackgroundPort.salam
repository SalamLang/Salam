import net.http
import net.router

func hello(ctx: i64):
    http.Text(ctx, "hi")
end

func main:
    mut r := router.NewRouter()
    router.Get(r, "/", hello)
    mut s := http.NewServer(0)
    http.Use(s, r)
    port := http.RunBackgroundPort(s)
    println port > 0
    println http.Body(http.Get("http://127.0.0.1:" + port + "/"))
end
