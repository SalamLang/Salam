import net.httpd.conf

func show(text: str):
    d := conf.Parse(text)
    println d.ok, conf.ErrorText(d, "web.salam"), d.error, d.line, d.col
    conf.Free(d)
end

func main:
    show("server:\n    site:\n")
    show("server:\nend\nend\n")
    show("listen = \n")
    show("names = \"open\n")
    show("listen 80\n")
    show("a = 1 # no\n")
    show("ok = 1\n")
end
