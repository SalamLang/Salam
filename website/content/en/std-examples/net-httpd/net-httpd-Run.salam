import os
import net.httpd

func main:
    mut path := "web.salam"
    args := os.Args()
    if args.len() > 1:
        path = args[1]
    end
    if httpd.Check(path) != 0:
        ret 1
    end
    if not httpd.LoadFile(path):
        ret 2
    end
    code := httpd.Run()
    httpd.Stop()
    ret code
end
