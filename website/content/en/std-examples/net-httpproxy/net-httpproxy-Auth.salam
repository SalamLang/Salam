import net.httpproxy
import net.tcp
import sync

mut origin_port := 0
mut echo_port := 0
mut ready := sync.NewWaitGroup()

func origin():
    srv := tcp.Bind(0)
    origin_port = tcp.Port(srv)
    sync.Done(ready)
    until true:
        c := tcp.Accept(srv)
        request := tcp.Read(c, 4096)
        first := request.substr(0, request.find("\r\n"))
        body := "origin saw: " + first
        tcp.Write(c, "HTTP/1.1 200 OK\r\nContent-Length: " + body.len() + "\r\nConnection: close\r\n\r\n" + body)
        tcp.Close(c)
    end
end

func echo():
    srv := tcp.Bind(0)
    echo_port = tcp.Port(srv)
    sync.Done(ready)
    until true:
        c := tcp.Accept(srv)
        tcp.Write(c, "echo:" + tcp.Read(c, 100))
        tcp.Close(c)
    end
end

func start_backends():
    sync.Add(ready, 2 as i64)
    _a := spawn(origin)
    _b := spawn(echo)
    sync.Wait(ready)
end

func main:
    start_backends()
    mut config := httpproxy.NewServerConfig(0)
    httpproxy.AllowPrivate(config, true)
    config.realm = "demo"
    httpproxy.AddUser(config, "alice", "s3cret")
    println config.require_auth, config.realm
    server := httpproxy.Start(config)
    url := "http://127.0.0.1:" + origin_port + "/"

    anonymous := httpproxy.Get(httpproxy.NewClient("127.0.0.1", server.port), url)
    println "no login:", anonymous.status, httpproxy.HeaderGet(anonymous.head, "proxy-authenticate")
    wrong := httpproxy.Get(httpproxy.NewClientAuth("127.0.0.1", server.port, "alice", "nope"), url)
    println "wrong password:", wrong.status
    right := httpproxy.Get(httpproxy.NewClientAuth("127.0.0.1", server.port, "alice", "s3cret"), url)
    println "right password:", right.status, right.body
    println "connect without login:", httpproxy.Connect(httpproxy.NewClient("127.0.0.1", server.port), "127.0.0.1", echo_port).status
    httpproxy.Stop(server)

    mut custom := httpproxy.NewServerConfig(0)
    httpproxy.AllowPrivate(custom, true)
    httpproxy.SetAuth(custom, (user: str, password: str): ret user == "bob" and password == "pw" end)
    println custom.has_auth
    second := httpproxy.Start(custom)
    println "callback good:", httpproxy.Get(httpproxy.NewClientAuth("127.0.0.1", second.port, "bob", "pw"), url).status
    println "callback bad:", httpproxy.Get(httpproxy.NewClientAuth("127.0.0.1", second.port, "bob", "x"), url).status
    httpproxy.Stop(second)
end
