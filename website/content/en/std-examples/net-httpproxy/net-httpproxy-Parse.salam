import net.httpproxy
import str

func main:
    request := "GET http://example.com:8080/a/b?x=1 HTTP/1.1\r\nHost: example.com:8080\r\nProxy-Authorization: Basic dXNlcjpwYXNz\r\nConnection: keep-alive, X-Drop\r\nX-Drop: 1\r\n\r\n"
    head := httpproxy.ParseRequestHead(request)
    println head.ok, head.method, head.target, head.version, head.names.len()
    println httpproxy.HeaderGet(head, "HOST"), httpproxy.HeaderHas(head, "x-drop"), httpproxy.HeaderCount(head, "host")
    println httpproxy.HeaderHasToken(head, "connection", "KEEP-ALIVE"), httpproxy.HeaderHasToken(head, "connection", "close")
    println head.names.get(0), head.values.get(0)

    each text in ["G@T / HTTP/1.1\r\n\r\n", "GET /\r\n\r\n", "GET / HTTP/1.1\r\nBroken header\r\n\r\n", "GET / HTTP/1.1\r\nA: b\r\n c\r\n\r\n"]:
        bad := httpproxy.ParseRequestHead(text)
        println bad.ok, bad.err
    end
    println httpproxy.MaxHeadBytes, httpproxy.MaxHeaders

    response := httpproxy.ParseResponseHead("HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm=\"x\"\r\n\r\n")
    println response.ok, response.status, response.reason, httpproxy.HeaderGet(response, "proxy-authenticate")

    each u in ["http://example.com", "HTTP://Example.COM:81/p?q=1#frag", "http://[::1]:8080/x", "https://secure.example/a", "ftp://example.com/", "/relative"]:
        x := httpproxy.ParseURL(u)
        if x.ok:
            println u, "->", x.scheme, x.host, x.port, x.path
        else:
            println u, "-> invalid"
        end
    end
    each t in ["example.com:443", "example.com", "[::1]:8443", "::1", "host:0"]:
        hp := httpproxy.SplitHostPort(t, 80)
        println t, "->", hp.ok, hp.host, hp.port, hp.has_port
    end

    header := httpproxy.BasicHeader("user", "pass")
    println header
    mut user := ""
    mut password := ""
    println httpproxy.BasicCredentials(header, user, password), user, password
    println httpproxy.BasicCredentials("Bearer abc", user, password)

    each name in ["Connection", "Transfer-Encoding", "Upgrade", "Host", "Content-Length"]:
        println name, httpproxy.IsHopByHop(name)
    end
    println str.Replace(httpproxy.ResponseText(407, "Proxy-Authenticate: Basic realm=\"r\"\r\n", "", false), "\r\n", "|")
    println httpproxy.StatusReason(403), "|", httpproxy.StatusReason(502), "|", httpproxy.StatusReason(999)
end
