import net.httpproxy

func main:
    mut config := httpproxy.NewServerConfig(8443)
    httpproxy.AddUser(config, "alice", "a long random password")
    if not httpproxy.SetTLS(config, "proxy.crt", "proxy.key"):
        println "certificate or key could not be loaded"
        ret
    end
    println config.use_tls
    server := httpproxy.Start(config)
    println "https proxy up:", server.ok

    mut client := httpproxy.NewClientAuth("proxy.example.com", 8443, "alice", "a long random password")
    client.tls = true
    client.server_name = "proxy.example.com"
    client.insecure = false
    tunnel := httpproxy.Connect(client, "example.com", 443)
    println tunnel.ok, tunnel.status
    httpproxy.Stop(server)
end
