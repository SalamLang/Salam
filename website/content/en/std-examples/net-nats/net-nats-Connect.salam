import net.nats

func main(): int:
    mut opts := nats.DefaultOptions()
    opts.name = "billing"
    opts.timeout_ms = 3000
    mut nc := nats.ConnectWith("nats://127.0.0.1:4222", opts)
    if not nats.IsConnected(nc):
        println "cannot connect:", nats.LastError(nc)
        ret 1
    end
    println "connected, largest payload", nats.MaxPayload(nc)
    nats.Close(nc)
    println nats.IsClosed(nc)
    ret 0
end
