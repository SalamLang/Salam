import net.nats
import str

func main:
    mut h := nats.NewHeader()
    nats.HeaderAdd(h, "Trace-Id", "abc")
    nats.HeaderAdd(h, "Tag", "one")
    nats.HeaderAdd(h, "Tag", "two")
    println nats.HeaderGet(h, "trace-id"), nats.HeaderValues(h, "TAG").len(), nats.HeaderHas(h, "nope")
    nats.HeaderSet(h, "Tag", "only")
    nats.HeaderDel(h, "Trace-Id")
    println nats.HeaderCount(h)
    println str.Replace(nats.HeaderEncode(h), "\r\n", "|")

    mut code := 0
    mut text := ""
    back := nats.HeaderParse("NATS/1.0 503 No Responders\r\nA: 1\r\n\r\n", code, text)
    println code, text, nats.HeaderGet(back, "a")
end
