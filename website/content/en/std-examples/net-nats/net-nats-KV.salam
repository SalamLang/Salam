import net.nats

func main(): int:
    mut nc := nats.Connect("nats://127.0.0.1:4222")
    if not nats.IsConnected(nc):
        println "cannot connect:", nats.LastError(nc)
        ret 1
    end
    made := nats.KVCreate(nc, "config", 5, 2000)
    println "bucket:", made.ok
    put := nats.KVPut(nc, "config", "theme", "dark", 2000)
    println "revision", put.seq
    got := nats.KVGet(nc, "config", "theme", 2000)
    if got.found:
        println got.key, got.value, got.revision
    end
    nats.KVDelete(nc, "config", "theme", 2000)
    gone := nats.KVGet(nc, "config", "theme", 2000)
    println gone.found, gone.deleted
    nats.KVDeleteBucket(nc, "config", 2000)
    nats.Close(nc)
    ret 0
end
