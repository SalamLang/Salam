import net.nats

func main(): int:
    mut nc := nats.Connect("nats://127.0.0.1:4222")
    if not nats.IsConnected(nc):
        println "cannot connect:", nats.LastError(nc)
        ret 1
    end
    sub := nats.Subscribe(nc, "deliver.orders")
    made := nats.AddPushConsumer(nc, "ORDERS", "pusher", "orders.*", "deliver.orders", "", 2000)
    if not made.ok:
        println "consumer:", made.err
        ret 1
    end
    until true:
        m := nats.NextPush(nc, sub, 2000)
        if not m.ok:
            break
        end
        println m.data, nats.MsgSequence(m)
        nats.Ack(nc, m)
    end
    nats.Close(nc)
    ret 0
end
