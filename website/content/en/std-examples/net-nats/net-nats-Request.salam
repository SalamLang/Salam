import net.nats

func main(): int:
    mut nc := nats.Connect("nats://127.0.0.1:4222")
    if not nats.IsConnected(nc):
        println "cannot connect:", nats.LastError(nc)
        ret 1
    end
    r := nats.Request(nc, "time.now", "", 1000)
    if r.ok:
        println "answer:", r.data
    else:
        println "no answer:", r.err
    end

    mut h := nats.NewHeader()
    nats.HeaderAdd(h, "Trace-Id", "abc-123")
    r2 := nats.RequestMsg(nc, "svc.echo", h, "ping", 1000)
    println r2.ok, r2.data

    inbox := nats.NewInbox(nc)
    nats.PublishRequest(nc, "svc.echo", inbox, "fire")
    reply := nats.Subscribe(nc, inbox)
    println nats.NextMsg(nc, reply, 500).ok

    println "drained:", nats.Drain(nc, 1000)
    ret 0
end
