import net.http
import net.router

func home(ctx: i64):
    http.Text(ctx, "home")
end

func anything_else(ctx: i64):
    http.SetStatus(ctx, 202)
    http.Text(ctx, "fallback got " + http.Method(ctx) + " " + http.Path(ctx))
end

func main:
    mut r := router.NewRouter()
    println r.fallback
    router.Get(r, "/", home)
    router.SetFallback(r, anything_else)
    println r.fallback == anything_else
    mut s := http.NewServer(19623)
    http.Use(s, r)
    println http.RunBackground(s)
    a := http.Get("http://127.0.0.1:19623/")
    println http.Status(a), http.Body(a)
    b := http.Get("http://127.0.0.1:19623/unknown/page")
    println http.Status(b), http.Body(b)
end
