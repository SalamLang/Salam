import net.shadowsocks

func main:
    m := shadowsocks.LookupMethod("chacha20-ietf-poly1305")
    mut key := shadowsocks.MakeKey(m, "codec password")

    mut enc := shadowsocks.NewEncoderRandom(m, key.p)
    mut wire := shadowsocks.NewBuf(256)
    shadowsocks.EmitSalt(enc, wire)
    shadowsocks.EncodeStream(enc, "hello codec" as void*, 11, wire)
    println "wire bytes", wire.len, "salt", m.salt_len, "overhead", wire.len - 11 - m.salt_len

    mut dec := shadowsocks.NewDecoder(m, key.p)
    mut plain := shadowsocks.NewBuf(64)
    println shadowsocks.DecodeAll(dec, wire.p, wire.len, plain), shadowsocks.BufToStr(plain)

    mut head := shadowsocks.NewBuf(64)
    println shadowsocks.EncodeTarget("example.com", 8443, head), head.len, shadowsocks.BufToHex(head)
    mut t := shadowsocks.Target {}
    used := shadowsocks.ParseTarget(head.p, head.len, t)
    println used, t.host, t.port

    mut packet := shadowsocks.NewBuf(128)
    println shadowsocks.PackUdp(m, key.p, "10.0.0.7", 53, "query" as void*, 5, packet), packet.len
    mut got := shadowsocks.Target {}
    mut body := shadowsocks.NewBuf(64)
    println shadowsocks.UnpackUdp(m, key.p, packet.p, packet.len, got, body), got.host, got.port, shadowsocks.BufToStr(body)

    shadowsocks.EncoderFree(enc)
    shadowsocks.DecoderFree(dec)
    shadowsocks.BufFree(wire)
    shadowsocks.BufFree(plain)
    shadowsocks.BufFree(head)
    shadowsocks.BufFree(packet)
    shadowsocks.BufFree(body)
    shadowsocks.BufWipe(key)
    shadowsocks.BufFree(key)
end
