import mem
import net.shadowsocks

func main:
    println shadowsocks.EIH_LEN, shadowsocks.IDENTITY_CONTEXT

    m := shadowsocks.LookupMethod("2022-blake3-aes-128-gcm")
    mut chain := shadowsocks.ChainOf(m, "AAECAwQFBgcICQoLDA0ODw==:EBESExQVFhcYGRobHB0eHw==")
    println chain.ok, chain.count, chain.key_len, chain.keys.len
    println shadowsocks.BufToHex(shadowsocks.Buf { p = shadowsocks.ChainKey(chain, 1), len = 16, cap = 16 })
    bad := shadowsocks.ChainOf(m, "not a key")
    println bad.ok, bad.count

    ipsk := shadowsocks.ChainKey(chain, 0)
    upsk := shadowsocks.ChainKey(chain, 1)
    h := mem.AllocateZeroed(16 as u64)
    shadowsocks.IdentityHash(upsk, m.key_len, h)
    println shadowsocks.HexOf(h, 16)

    salt := mem.AllocateZeroed(16 as u64)
    ik := mem.AllocateZeroed(16 as u64)
    shadowsocks.IdentityKey(ipsk, m.key_len, salt, m.salt_len, ik)
    println shadowsocks.HexOf(ik, 16)

    block := mem.AllocateZeroed(16 as u64)
    println shadowsocks.EihSeal(ipsk, m.key_len, salt, m.salt_len, upsk, block)
    println shadowsocks.HexOf(block, 16)
    opened := mem.AllocateZeroed(16 as u64)
    println shadowsocks.EihOpen(ipsk, m.key_len, salt, m.salt_len, block, opened)
    println shadowsocks.HexOf(opened, 16) == shadowsocks.HexOf(h, 16)

    shadowsocks.ChainFree(chain)
    println chain.ok, chain.count
    mem.Free(h)
    mem.Free(salt)
    mem.Free(ik)
    mem.Free(block)
    mem.Free(opened)
end
