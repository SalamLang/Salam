import net.shadowsocks

func main:
    method := "2022-blake3-aes-128-gcm"
    ipsk := "AAECAwQFBgcICQoLDA0ODw=="
    server := shadowsocks.ListenOn("127.0.0.1", 0, method, ipsk, "")
    println shadowsocks.ServerOk(server), shadowsocks.ServerPort(server) > 0
    println shadowsocks.AddUser(server, "alice", "EBESExQVFhcYGRobHB0eHw==")
    println shadowsocks.AddUser(server, "bob", "ICEiIyQlJicoKSorLC0uLw==")
    println shadowsocks.AddUser(server, "bad", "short")
    println server.st.user_n, server.st.users.Has("x"), server.st.user_names.Size()
    shadowsocks.Destroy(server)

    classic := shadowsocks.ListenOn("127.0.0.1", 0, "chacha20-ietf-poly1305", "password", "")
    println shadowsocks.AddUser(classic, "carol", "password")
    shadowsocks.Destroy(classic)

    mut relay := shadowsocks.UdpListenOn("127.0.0.1", 0, method, ipsk)
    println relay.ok, shadowsocks.UdpServerPort(relay) > 0
    println shadowsocks.UdpAddUser(relay, "EBESExQVFhcYGRobHB0eHw==")
    println shadowsocks.UdpAddUser(relay, "short")
    println relay.user_n, relay.users.Size(), relay.sess.Size()
    shadowsocks.UdpDestroy(relay)
end
