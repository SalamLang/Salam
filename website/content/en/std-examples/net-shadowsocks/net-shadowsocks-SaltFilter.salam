import net.shadowsocks

func main:
    mut f := shadowsocks.NewSaltFilter(1000)
    a := "salt number one, 32 bytes long.."
    b := "salt number two, 32 bytes long.."
    println f.cap, shadowsocks.FilterSeen(f, a as void*, 32)
    println shadowsocks.FilterCheck(f, a as void*, 32), shadowsocks.FilterSeen(f, a as void*, 32)
    println shadowsocks.FilterCheck(f, a as void*, 32), shadowsocks.FilterCheck(f, b as void*, 32)
    println f.cur.Size(), f.old.Size()
    shadowsocks.FilterFree(f)
end
