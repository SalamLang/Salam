import net.socketio
import encoding.value

func main:
    mut a := socketio.NewArgs()
    socketio.AddStr(a, "hello \"world\"")
    socketio.AddInt(a, 42)
    socketio.AddFloat(a, 2.5)
    socketio.AddBool(a, true)
    socketio.AddNull(a)
    socketio.AddJSON(a, `{"x":1}`)
    println socketio.ArgsCount(a)
    text := socketio.ArgsJSON(a, "message")
    println text
    println socketio.ItemCount(text)
    println socketio.ItemStr(text, 1)
    println socketio.ItemInt(text, 2)
    println socketio.ItemFloat(text, 3)
    println socketio.ItemBool(text, 4)
    println socketio.Item(text, 6)
    println socketio.Item(text, 9).len()
    socketio.ArgsFree(a)

    mut v := socketio.ItemValue(text, 2)
    println value.IsNumber(v), value.AsInt(v)
    mut a2 := socketio.NewArgs()
    socketio.AddValue(a2, v)
    socketio.AddBytes(a2, "xyz" as void*, 3)
    println socketio.ArgsJSON(a2, "")
    socketio.ArgsFree(a2)
    value.ValueFree(v)
end
