import net.socketio

func main:
    mut b := socketio.BytesFromStr("Salam")
    println b.len, socketio.BytesAt(b, 0)
    println socketio.BytesToStr(b)
    println socketio.BytesToBase64(b)
    socketio.BytesFree(b)
    mut c := socketio.NewBytes("hello" as void*, 4)
    println socketio.BytesToStr(c)
    socketio.BytesFree(c)

    mut a := socketio.NewArgs()
    socketio.AddStr(a, "file.txt")
    socketio.AddBinaryStr(a, "abc")
    println socketio.ArgsJSON(a, "upload")
    println a.bins.len()
    socketio.ArgsFree(a)
end
