import net.socketio

func main:
    mut o := socketio.NewOptions()
    println o.path, o.reconnection, o.reconnection_delay, o.timeout
    println o.transports == socketio.TRANSPORT_AUTO
    o.transports = socketio.TRANSPORT_WEBSOCKET
    o.auth = `{"token":"abc"}`
    o.auto_connect = false
    println o.transports, o.auth, o.auto_connect
    println socketio.TRANSPORT_POLLING, socketio.REASON_SERVER_DISCONNECT, socketio.REASON_PING_TIMEOUT
    println socketio.PUMP_OK, socketio.PUMP_TIMEOUT, socketio.PUMP_CLOSED
end
