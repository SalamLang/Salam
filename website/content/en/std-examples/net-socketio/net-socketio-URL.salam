import net.socketio

func show(url: str):
    e := socketio.ParseURL(url)
    if not e.ok:
        println url, "invalid"
        ret
    end
    println e.host, e.port, e.secure, e.namespace, "query=" + e.query
    println socketio.Origin(e)
end

func main:
    show("http://localhost:3000")
    show("https://example.com/admin/?token=abc")
    show("ws://[::1]:8080/chat")
    show("ftp://example.com")
end
