import net.socks
import net.tcp

func main:
    mut config := socks.NewServerConfig(0)
    config.allow_bind = true
    server := socks.Start(config)
    client := socks.NewClient("127.0.0.1", server.port)

    first := socks.Bind(client, "127.0.0.1", 0)
    println "bind accepted:", first.ok, first.code, first.bound.port > 0
    peer := tcp.Dial("127.0.0.1", first.bound.port)
    second := socks.BindAccept(first.stream, client)
    println "peer connected:", second.ok
    tcp.Write(peer, "from the inbound peer")
    println first.stream.Read(100)
    first.stream.Write("reply to the peer")
    println tcp.Read(peer, 100)
    tcp.Close(peer)
    first.stream.Close()
    socks.Stop(server)

    plain := socks.Start(socks.NewServerConfig(0))
    off := socks.Bind(socks.NewClient("127.0.0.1", plain.port), "127.0.0.1", 0)
    println "bind not enabled:", off.ok, off.code, off.err
    socks.Stop(plain)
end
