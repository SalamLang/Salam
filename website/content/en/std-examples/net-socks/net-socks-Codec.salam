import net.socks

func main:
    methods := Vector {} as Vector<u8>
    methods.push(0 as u8)
    methods.push(2 as u8)
    println "greeting   ", socks.ToHex(socks.EncodeGreeting(methods))
    println "choice     ", socks.ToHex(socks.EncodeMethodChoice(socks.AuthUserPass))
    println "auth       ", socks.ToHex(socks.EncodeAuthRequest("alice", "pw"))
    println "auth ok    ", socks.ToHex(socks.EncodeAuthReply(true))

    target := socks.NewAddress("example.com", 443)
    println target.kind == socks.AtypDomain, socks.ClassifyHost("10.1.2.3") == socks.AtypIPv4, socks.ClassifyHost("::1") == socks.AtypIPv6
    request := socks.EncodeRequest(socks.CmdConnect, target)
    println "request    ", socks.ToHex(request)
    mut parsed := socks.Request {}
    println socks.DecodeRequest(request, parsed), parsed.cmd == socks.CmdConnect, parsed.addr.host, parsed.addr.port
    mut partial := Vector {} as Vector<u8>
    repeat 5 in i:
        partial.push(request[i])
    end
    println "short      ", socks.DecodeRequest(partial, parsed)

    reply := socks.EncodeReply(socks.RepSucceeded, socks.NewAddress("10.0.0.1", 1080))
    println "reply      ", socks.ToHex(reply)
    mut answer := socks.Reply {}
    println socks.DecodeReply(reply, answer), answer.code, answer.addr.host, socks.ReplyText(answer.code)
    println socks.ReplyText(socks.RepConnRefused), "|", socks.ReplyText(socks.Rep4Rejected)

    mut ip := Vector {} as Vector<u8>
    println socks.ParseIPv4("192.168.1.20", ip), socks.FormatIPv4(ip, 0)
    mut ip6 := Vector {} as Vector<u8>
    println socks.ParseIPv6("2001:db8::1", ip6), socks.FormatIPv6(ip6, 0)
    encoded := socks.EncodeAddress(target)
    mut back := socks.Address {}
    println socks.DecodeAddress(encoded, 0, back), back.host

    udp := socks.EncodeUDPHeader(target, 0)
    println "udp header ", socks.ToHex(udp)
    mut header := socks.UDPHeader {}
    println socks.DecodeUDPHeader(udp, header), header.frag, header.addr.host, header.length

    four := socks.Encode4Request(socks.CmdConnect, "127.0.0.1", 80, "bob")
    println "socks4 req ", socks.ToHex(four)
    mut four_req := socks.Request {}
    println socks.Decode4Request(four, four_req), four_req.user, four_req.addr.port
    four_reply := socks.Encode4Reply(socks.Rep4Granted, "127.0.0.1", 80)
    println "socks4 rep ", socks.ToHex(four_reply)
    mut four_ans := socks.Reply {}
    println socks.Decode4Reply(four_reply, four_ans), four_ans.code
    println socks.VerSocks5, socks.VerSocks4, socks.AuthNone, socks.AuthNoAcceptable, socks.CmdBind, socks.CmdUDPAssociate, socks.AtypIPv4
    println socks.RepGeneralFailure, socks.RepNotAllowed, socks.Socks4a
end
