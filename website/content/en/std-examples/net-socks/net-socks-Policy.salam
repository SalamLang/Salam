import net.socks
import net.tcp
import net.tunnel

func echo_conn(arg: i64):
    c := tcp.ConnFromFd(arg)
    until true:
        data := tcp.Read(c, 4096)
        if data.Len() == 0:
            break
        end
        tcp.Write(c, data)
    end
    tcp.Close(c)
end

func echo_accept(arg: i64):
    srv := tcp.Server { fd = arg }
    until true:
        c := tcp.Accept(srv)
        if not tcp.ConnOk(c):
            break
        end
        socks.Go(echo_conn, c.fd as void*)
    end
end

func start_echo(): int:
    listener := tcp.Bind(0)
    socks.Go(echo_accept, listener.fd as void*)
    ret tcp.Port(listener)
end

func say(label: str, r: socks.ConnectResult):
    println label + ": ok=" + r.ok + " code=" + r.code + " " + r.err
end

func main:
    echo := start_echo()

    mut routed := socks.NewServerConfig(0)
    socks.AllowPrivate(routed, true)
    socks.SetConnector(routed, (host: str, _port: int): if host == "echo.internal": ret socks.DirectConnect("127.0.0.1", echo, 2000) end ret socks.Outbound { ok = false, code = socks.RepNetUnreachable, err = "no route" } end)
    routed_server := socks.Start(routed)
    client := socks.NewClient("127.0.0.1", routed_server.port)
    say("known name", socks.Connect(client, "echo.internal", 1))
    say("unknown name", socks.Connect(client, "other.internal", 1))
    socks.Stop(routed_server)

    mut acl := socks.NewServerConfig(0)
    socks.AllowPrivate(acl, true)
    acl.allow = (cmd: int, _host: str, port: int): ret not (cmd == socks.CmdConnect and port == 25) end
    acl_server := socks.Start(acl)
    acl_client := socks.NewClient("127.0.0.1", acl_server.port)
    say("allowed", socks.Connect(acl_client, "127.0.0.1", echo))
    say("port 25", socks.Connect(acl_client, "127.0.0.1", 25))
    socks.Stop(acl_server)

    mut blocked := socks.NewServerConfig(0)
    socks.AllowPrivate(blocked, true)
    socks.SetDialer(blocked, tunnel.Block())
    blocked_server := socks.Start(blocked)
    say("block dialer", socks.Connect(socks.NewClient("127.0.0.1", blocked_server.port), "127.0.0.1", echo))
    socks.Stop(blocked_server)

    mut direct := socks.NewServerConfig(0)
    socks.AllowPrivate(direct, true)
    socks.SetDialer(direct, tunnel.Direct())
    direct_server := socks.Start(direct)
    say("direct dialer", socks.Connect(socks.NewClient("127.0.0.1", direct_server.port), "127.0.0.1", echo))
    socks.Stop(direct_server)
end
