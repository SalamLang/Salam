import net.socks
import net.tunnel
import pool

func job(a: dyn tunnel.Stream, b: dyn tunnel.Stream):
    stats := socks.Relay(a, b, 2000)
    println "relayed", stats.a_to_b, stats.b_to_a
end

func main:
    near := tunnel.NewPipe()
    far := tunnel.NewPipe()
    client := tunnel.PipeA(near)
    left := tunnel.PipeB(near)
    right := tunnel.PipeA(far)
    server := tunnel.PipeB(far)

    workers := pool.NewElastic(1 as i64, 2 as i64, 2 as i64)
    pool.Submit(workers, (): job(left, right) end)
    client.Write("hello")
    println server.Read(100)
    server.Write("world!")
    println client.Read(100)
    client.Close()
    pool.Wait(workers)
    pool.Stop(workers)
end
