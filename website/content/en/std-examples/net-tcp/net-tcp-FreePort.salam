import net.tcp

mut server := tcp.Server {}

func serve():
    conn := tcp.Accept(server)
    tcp.Close(conn)
end

func main:
    port := tcp.FreePort()
    println port > 0
    println tcp.WaitListening("127.0.0.1", port, 200)
    server = tcp.Bind(port)
    println tcp.Ok(server)
    t := spawn(serve)
    println tcp.WaitListening("127.0.0.1", port, 2000)
    join(t)
    tcp.CloseServer(server)
end
