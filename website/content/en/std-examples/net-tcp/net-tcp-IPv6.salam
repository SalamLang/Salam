import net.tcp

func main:
    server := tcp.BindDual(0)
    println tcp.Ok(server), tcp.LocalAddr(server)
    port := tcp.Port(server)
    six := tcp.BindV6("::1", 0, true)
    println tcp.Ok(six)
    client := tcp.Dial("::1", port)
    println tcp.ConnOk(client)
    println tcp.PeerAddr(client), tcp.PeerPort(client) == port
    println tcp.ConnLocalAddr(client)
    println tcp.JoinHostPort("::1", port) == "[::1]:" + port
    mut hosts := Vector {} as Vector<str>
    hosts.Push("::1")
    hosts.Push("127.0.0.1")
    racing := tcp.DialAnyTimeout(hosts, port, 2000)
    println tcp.ConnOk(racing)
    tcp.Close(racing)
    tcp.Close(client)
    tcp.WakeServer("::", port)
    tcp.CloseServer(six)
    tcp.CloseServer(server)
end
