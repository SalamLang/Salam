import net.trojan

func main:
    mut config := trojan.NewServerConfig("fullchain.pem", "privkey.pem")
    trojan.AddPassword(config, "a long random password")
    trojan.SetFallback(config, "127.0.0.1", 8080)
    server := trojan.Serve(config, 443)
    println "trojan up:", server.ok

    mut client := trojan.NewClientConfig("proxy.example.com", 443, "a long random password")
    client.sni = "proxy.example.com"
    client.alpn = "h2"
    client.lazy_header = true
    mut link := trojan.Dial(client, "example.com", 443)
    println trojan.LinkOk(link), link.kind == trojan.LinkTLS
    trojan.LinkClose(link)
    trojan.Stop(server)
end
