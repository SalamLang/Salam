import net.tun

func main():
    nat := tun.NewNat("172.19.0.1", "172.19.0.2", 7000, 0)
    out := tun.BuildTcp4("172.19.0.1", 51000, "1.1.1.1", 443, 1 as i64, 0 as i64, tun.TcpSyn, null, 0)
    println "forward", nat.Rewrite(out.data, out.len, 0 as i64) == tun.ActionReply
    seen := tun.Parse(out.data, out.len)
    println "kernel sees", seen.src, seen.sport, seen.dst, seen.dport
    e := nat.Lookup(seen.sport)
    println "original", e.ok, e.src, e.sport, e.dst, e.dport
    back := tun.BuildTcp4("172.19.0.1", nat.Port(), "172.19.0.2", seen.sport, 9 as i64, 2 as i64, tun.TcpSyn | tun.TcpAck, null, 0)
    _r := nat.Rewrite(back.data, back.len, 1 as i64)
    app := tun.Parse(back.data, back.len)
    println "app sees", app.src, app.sport, app.dst, app.dport
    dns := tun.BuildUdp4("172.19.0.1", 5353, "172.19.0.2", 53, null, 0)
    println "dns", nat.Rewrite(dns.data, dns.len, 2 as i64) == tun.ActionDns
    println "drop", tun.ActionDrop, "ipv6", tun.ActionIpv6
    println "active", nat.Active(), "expired", nat.Sweep(3600000 as i64), "active", nat.Active()
    tun.FreePacket(out)
    tun.FreePacket(back)
    tun.FreePacket(dns)
    tun.FreeNat(nat)
end
