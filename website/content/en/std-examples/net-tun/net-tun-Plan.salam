import net.tun

func main():
    gw := tun.ParseLinuxRoutes("Iface\tDestination\tGateway\tFlags\tRefCnt\tUse\tMetric\tMask\neth0\t00000000\t0101A8C0\t0003\t0\t0\t100\t00000000\n")
    println "linux", gw.ok, gw.ip, gw.iface, gw.index
    mac := tun.ParseMacRoute("    gateway: 10.0.0.1\n  interface: en0\n")
    println "macos", mac.ip, mac.iface
    dns := tun.ParseResolvers("nameserver 192.168.1.1\n")
    println "resolvers", dns.Len(), dns[0]
    println "name ok", tun.ValidName("salamtun"), "next", tun.NextAddress(tun.DEFAULT_ADDRESS)
    println "defaults", tun.DEFAULT_ADDRESS6, tun.DEFAULT_UPSTREAM
    mut hosts := Vector {} as Vector<str>
    hosts.Push("203.0.113.7")
    opts := tun.Options { name = "salamtun", set_system_dns = false }
    pl := tun.BuildPlan("linux", "salamtun", opts, gw, hosts, dns, "")
    each line in pl.up:
        println "up  ", line
    end
    each line in pl.down:
        println "down", line
    end
    parts := tun.SplitCommand(pl.up[0])
    println "argv", parts.Len(), parts[0]
end
