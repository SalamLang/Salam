import mem
import net.tun
import net.tunnel

func main():
    av := tun.Available()
    if not av.ok:
        println "full device mode is off:", av.reason
        ret
    end
    println "platform", tun.Platform()
    gw := tun.DefaultGateway()
    println "gateway", gw.ip, gw.iface
    println "resolvers", tun.SystemResolvers().Len()
    mut servers := Vector {} as Vector<str>
    servers.Push("vpn.example.com")
    s := tun.Start(tun.Options { dialer = tunnel.Direct(), exclude = servers })
    if not s.ok:
        println "start failed:", s.error, tun.LastError()
        ret
    end
    println "up", s.name, s.address, "dns", s.dns, tun.Running()
    direct := tun.NewBypassDialer()
    c := direct.Dial(tunnel.NewAddr("example.com", 80))
    println direct.Name(), c.Ok()
    c.Close()
    _d := tun.Bypass()
    st := tun.SessionStats(s)
    println st.packets_in, st.packets_out, st.connections, st.active, st.dns_queries, st.sniffed, st.failed, st.dropped, st.bytes_up, st.bytes_down
    tun.Stop(s)
    dev := tun.OpenDevice("salamtest", 1500)
    if dev.ok:
        buf := mem.Allocate(65536 as u64)
        n := dev.Read(buf, 65536, 100)
        if n > 0:
            _w := dev.Write(buf, n)
        end
        mem.Free(buf)
        dev.Close()
    end
end
