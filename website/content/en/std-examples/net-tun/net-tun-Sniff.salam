import net.tun

func main():
    req := "GET / HTTP/1.1\r\nHost: Example.com:8080\r\n\r\n"
    println "host", tun.SniffHost(req as void*, req.Len())
    q := tun.BuildDnsQuery(42, "salamlang.ir", 1)
    d := tun.ParseDnsQuery(q.data, q.len)
    println "question", d.ok, d.id, d.name, d.qtype
    tun.FreePacket(q)
end
