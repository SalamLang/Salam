import net.tunnel

func main:
    a := tunnel.ParseAddr("example.com:443")
    println a.valid, a.kind == tunnel.ADDR_DOMAIN, a.host, a.port, a.String()
    b := tunnel.ParseAddr("[2001:db8::5]:8080")
    println b.valid, b.kind == tunnel.ADDR_IPV6, b.String()
    println tunnel.ParseAddr("example.com").valid, tunnel.ParseAddr("a:99999").valid
    println tunnel.IsIP("10.1.1.1"), tunnel.IsIP("example.com")
    ip := tunnel.ParseIPv4("192.168.1.20")
    println ip.Len(), tunnel.FormatIP(ip)
    println tunnel.FormatIP(tunnel.ParseIPv6("2001:0db8:0000:0000:0000:0000:0000:0001"))
    println tunnel.FormatIP(tunnel.ParseIP("::ffff:1.2.3.4"))
    n := tunnel.NewAddr("1.2.3.4", 80)
    println n.kind == tunnel.ADDR_IPV4, n.String()
end
