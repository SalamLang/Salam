import net.tunnel

func main:
    text := `{
  "inbounds": [{"tag": "in", "listen": "127.0.0.1", "port": 10808, "protocol": "mixed"}],
  "outbounds": [
    {"tag": "proxy", "protocol": "trojan", "settings": {"servers": [{"address": "t.example.org", "port": 443, "password": "pw"}]}},
    {"tag": "direct", "protocol": "freedom"},
    {"tag": "block", "protocol": "blackhole"}
  ],
  "routing": {"defaultOutbound": "proxy", "rules": [
    {"type": "field", "domain": ["domain:ir"], "outboundTag": "direct"},
    {"type": "field", "ip": ["geoip:private"], "outboundTag": "direct"},
    {"type": "field", "port": "25", "outboundTag": "block"}
  ]}
}`
    c := tunnel.ParseConfig(text)
    println c.errors.len(), c.inbounds.len(), c.outbounds.len(), c.rules.len(), c.default_outbound
    println c.inbounds[0].port, c.outbounds[0].protocol, c.rules[2].port
    println "problems:", tunnel.ValidateConfig(c).len()

    rt := tunnel.BuildRouter(c)
    println rt.MatchHost("divar.ir", 443), rt.MatchHost("192.168.1.1", 80), rt.MatchHost("mail.example.com", 25), rt.MatchHost("example.com", 443)
    println tunnel.ParseConfig(tunnel.ConfigToJson(c)).outbounds.len()

    bad := tunnel.ParseConfig(`{"outbounds":[{"tag":"a","protocol":"freedom"},{"tag":"a","protocol":"freedom"}],"routing":{"rules":[{"outboundTag":"zzz","domain":["domain:x"]}]}}`)
    each e in tunnel.ValidateConfig(bad):
        println e
    end
    println tunnel.LoadConfig("/nonexistent/config.json").errors.len()

    node := tunnel.ParseLink("trojan://pw@t.example.org:443?security=tls&sni=t.example.org#T")
    out := tunnel.OutboundFromNode(node, "proxy")
    println out.tag, out.protocol, tunnel.NodeToLink(tunnel.NodeFromOutbound(out)) == tunnel.NodeToLink(node)
    mut nodes := Vector {} as Vector<tunnel.Node>
    nodes.push(node)
    gen := tunnel.ConfigFromNodes(nodes, 7890)
    println gen.inbounds[0].port, gen.outbounds.len(), gen.default_outbound, gen.rules.len()
end
