import net.tcp
import net.tunnel
import sync

mut port := 0
mut ready := sync.NewWaitGroup()

func echo_once():
    srv := tcp.Bind(0)
    port = tcp.Port(srv)
    sync.Done(ready)
    c := tcp.Accept(srv)
    data := tcp.Read(c, 64)
    tcp.Write(c, "echo:" + data)
    tcp.Close(c)
end

func main:
    sync.Add(ready, 1 as i64)
    t := spawn(echo_once)
    sync.Wait(ready)
    target := tunnel.NewAddr("127.0.0.1", port)

    blocked := tunnel.Block()
    println blocked.Name(), blocked.Dial(target).Ok()

    mut backup := tunnel.NewFallback()
    tunnel.FallbackAdd(backup, tunnel.Block())
    tunnel.FallbackAdd(backup, tunnel.Direct())
    println backup.Name()
    s := backup.Dial(target)
    println s.Ok()
    s.Write("hello")
    println s.Read(100)
    s.Close()
    join(t)

    direct := tunnel.DirectDialer { timeout_ms = 500 }
    println direct.Name(), direct.Dial(tunnel.NewAddr("127.0.0.1", tcp.FreePort())).Ok()
    stream := tunnel.DialTcp("127.0.0.1", tcp.FreePort(), 500)
    println stream.Ok()
end
