import net.tunnel

func main:
    println tunnel.SourceKey("::ffff:203.0.113.9"), tunnel.SourceKey("2001:db8:1:2::7")
    local := tunnel.ListenLocal6(0)
    println local.Ok()
    local.Stop()
    dual := tunnel.ListenTcpDual(0)
    println dual.Ok()
    dual.Stop()
    at := tunnel.ListenTcpAt("::1", 0)
    println at.Ok(), at.host
    at.Stop()
    inbound := tunnel.ListenTcpDualInbound(0)
    println inbound.Ok()
    inbound.Stop()
end
