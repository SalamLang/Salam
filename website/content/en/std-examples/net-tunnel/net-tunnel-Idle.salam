import net.tunnel
import sync

func main:
    timer := tunnel.NewIdleTimer(100 as i64)
    println timer.Expired()
    sync.SleepMs(160)
    println timer.Expired(), timer.IdleMs() >= 150
    timer.Touch()
    println timer.Expired()
    timer.Free()

    plain := tunnel.NewIdleTimer(0 as i64)
    sync.SleepMs(30)
    println "no limit:", plain.Expired()
    plain.Free()
end
