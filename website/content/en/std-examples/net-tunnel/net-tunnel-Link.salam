import net.tunnel

func main:
    link := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@203.0.113.9:443?encryption=none&security=tls&sni=cdn.example.com&type=ws&host=cdn.example.com&path=%2Fws#Berlin%201"
    n := tunnel.ParseLink(link)
    println n.valid, n.protocol, tunnel.NodeAddr(n).String(), n.network, n.security, n.sni, n.path
    println tunnel.NodeLabel(n)
    println tunnel.NodeToLink(n) == link

    println tunnel.ParseLink("vless://@host:1").valid, tunnel.ParseLink("http://x").valid
    println tunnel.ParseLink("ss://aes-128-gcm:secret@10.0.0.1:8388#ss").method

    text := link + "\n# a comment\ntrojan://pw@t.example.org:443#T\nnot a link\n"
    sub := tunnel.ParseSubscription(text)
    println sub.nodes.len(), sub.skipped, tunnel.NodeLabel(sub.nodes[1])

    println tunnel.PctEncode("a b/c"), tunnel.PctDecode("%D8%B3%D9%84%D8%A7%D9%85")
    println tunnel.B64EncodeUrl("subjects?_d>>"), tunnel.B64Decode("c2FsYW0")
end
