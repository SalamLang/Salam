import net.tunnel

func main:
    println tunnel.DetectMixed(5) == tunnel.MIXED_SOCKS5, tunnel.DetectMixed(4) == tunnel.MIXED_SOCKS4
    println tunnel.DetectMixed(71) == tunnel.MIXED_HTTP, tunnel.DetectMixed(22) == tunnel.MIXED_UNKNOWN
    println tunnel.ByteString(65), tunnel.ByteString(65).len()

    mut mixed := tunnel.NewMixed()
    println mixed.Name(), mixed.has_socks5, mixed.has_http
    tunnel.MixedSetSocks5(mixed, tunnel.NullProtocol {})
    tunnel.MixedSetSocks4(mixed, tunnel.NullProtocol {})
    tunnel.MixedSetHttp(mixed, tunnel.NullProtocol {})
    println mixed.has_socks5, mixed.has_socks4, mixed.has_http

    pair := tunnel.NewPipe()
    pair.a.Write("\x05\x01\x00")
    sess := mixed.Handshake(tunnel.PipeB(pair))
    println sess.ok, sess.protocol, sess.error
    println tunnel.CMD_CONNECT, tunnel.CMD_UDP
end
