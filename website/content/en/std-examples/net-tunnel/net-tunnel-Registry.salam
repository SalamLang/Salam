import net.tunnel

struct LoopbackMaker:
    pub unused: int = 0

    pub func Protocol(): str:
        ret "loopback"
    end

    pub func Make(_cfg: tunnel.OutboundConfig): dyn tunnel.Dialer:
        ret tunnel.Direct()
    end
end

struct SilentInbound:
    pub unused: int = 0

    pub func Protocol(): str:
        ret "silent"
    end

    pub func Make(_cfg: tunnel.InboundConfig): dyn tunnel.InboundProtocol:
        ret tunnel.NullProtocol {}
    end
end

func main:
    println tunnel.HasOutbound("freedom"), tunnel.HasOutbound("loopback")
    tunnel.RegisterOutbound(LoopbackMaker {})
    tunnel.RegisterInbound(SilentInbound {})
    println tunnel.HasOutbound("loopback"), tunnel.HasInbound("silent")
    println tunnel.CreateOutbound(tunnel.OutboundConfig { protocol = "loopback" }).Name()
    println tunnel.CreateOutbound(tunnel.OutboundConfig { protocol = "freedom" }).Name()
    println tunnel.CreateOutbound(tunnel.OutboundConfig { protocol = "nobody-registered-this" }).Name()
    println tunnel.CreateInbound(tunnel.InboundConfig { protocol = "silent" }).Name()
    c := tunnel.ParseConfig(`{"outbounds":[{"tag":"lo","protocol":"loopback"},{"tag":"deny","protocol":"blackhole"}],"routing":{"defaultOutbound":"lo","rules":[{"domain":["full:blocked.test"],"outboundTag":"deny"}]}}`)
    rd := tunnel.BuildDialer(c)
    println rd.Pick("lo").Name(), rd.Pick("deny").Name(), rd.Pick("missing").Name()
    println rd.Dial(tunnel.NewAddr("blocked.test", 80)).Ok(), rd.last_tag
end
