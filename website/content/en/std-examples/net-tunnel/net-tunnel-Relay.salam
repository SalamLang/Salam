import net.tunnel
import pool

func relay_job(a: dyn tunnel.Stream, b: dyn tunnel.Stream, st: tunnel.Stats):
    r := tunnel.RelayWith(a, b, st, 5000)
    println "relayed", r.up, r.down
end

func main:
    near := tunnel.NewPipe()
    far := tunnel.NewPipe()
    client := tunnel.PipeA(near)
    left := tunnel.PipeB(near)
    right := tunnel.PipeA(far)
    server := tunnel.PipeB(far)
    stats := tunnel.NewStats()

    workers := pool.NewElastic(1 as i64, 2 as i64, 2 as i64)
    pool.Submit(workers, (): relay_job(left, right, stats) end)

    client.Write("ping from the client")
    println server.Read(100)
    server.Write("pong from the server")
    println client.Read(100)
    client.Close()
    pool.Wait(workers)
    pool.Stop(workers)
    println stats.Summary()
    println stats.Up(), stats.Down()
    tunnel.FreeStats(stats)
end
