import net.tunnel

func main:
    rt := tunnel.IranRouter("direct", "proxy")
    each host in ["divar.ir", "WWW.Digikala.com", "ایران.ir", "notaparat.com", "evilir", "google.com", "192.168.1.9", "localhost"]:
        println host, rt.MatchHost(host, 443)
    end

    mut custom := tunnel.NewRouter("proxy")
    mut mail := tunnel.NewRule("block")
    tunnel.RulePort(mail, "25,465,587")
    tunnel.RouterAdd(custom, mail)
    mut ads := tunnel.NewRule("block")
    tunnel.RuleKeyword(ads, "tracker")
    tunnel.RuleRegex(ads, "^ads[0-9]+\\.example\\.com$")
    tunnel.RouterAdd(custom, ads)
    mut home := tunnel.NewRule("direct")
    tunnel.RuleSuffix(home, "example.org")
    tunnel.RuleDomain(home, "printer.lan")
    tunnel.RuleCidr(home, "203.0.113.0/24")
    tunnel.RouterAdd(custom, home)
    mut lan := tunnel.NewRule("direct")
    tunnel.RulePrivate(lan)
    tunnel.RouterAdd(custom, lan)

    println custom.MatchHost("smtp.example.com", 25)
    println custom.MatchHost("my-tracker.net", 443), custom.MatchHost("ads42.example.com", 443)
    println custom.MatchHost("a.b.example.org", 443), custom.MatchHost("printer.lan", 80)
    println custom.MatchHost("203.0.113.77", 80), custom.MatchHost("10.0.0.5", 22), custom.MatchHost("8.8.8.8", 53)
    println custom.Match(tunnel.ParseAddr("203.0.113.1:8080"))

    println tunnel.ParseCidr("10.0.0.0/8").prefix, tunnel.ParseCidr("nonsense").kind
    mut r := tunnel.NewRule("x")
    println tunnel.RuleDomainSpec(r, "full:a.example.com"), tunnel.RuleIpSpec(r, "geoip:private"), tunnel.RuleCidr(r, "1.2.3.4/40")
    println tunnel.RuleMatches(r, tunnel.ParseAddr("a.example.com:80")), tunnel.RuleMatches(r, tunnel.ParseAddr("b.example.com:80"))
end
