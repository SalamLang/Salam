import net.tunnel

func main:
    text := "# send Iranian sites direct\nDOMAIN-SUFFIX,ir,direct\nDOMAIN-KEYWORD,tracker,block\nIP-CIDR,203.0.113.0/24,direct\nGEOIP,PRIVATE,direct\nDST-PORT,25,block\nthis line is broken\nFINAL,proxy\n"
    set := tunnel.ParseRules(text, "proxy")
    println "errors:", set.errors.Len()
    each e in set.errors:
        println e
    end
    each host in ["shop.ir", "my-tracker.net", "203.0.113.5", "127.0.0.1", "example.com"]:
        println host, set.router.MatchHost(host, 443)
    end
    println set.router.MatchHost("example.com", 25)
    missing := tunnel.LoadRules("/nonexistent/rules.txt", "direct")
    println missing.errors.get(0)
end
