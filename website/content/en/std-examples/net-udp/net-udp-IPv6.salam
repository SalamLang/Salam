import net.udp

func main:
    server := udp.BindDual(0)
    println udp.Ok(server), udp.LocalAddr(server)
    port := udp.Port(server)
    six := udp.BindV6("::1", 0, true)
    println udp.Ok(six), udp.SetV6Only(six, true)
    client := udp.OpenAny()
    udp.SetTimeout(server, 1000)
    udp.SendTo(client, "::1", port, "hello six")
    packet := udp.Receive(server, 100)
    println packet.data, packet.from_host
    wide := udp.OpenFor("::1")
    println udp.Ok(wide)
    linked := udp.Dial("::1", port)
    udp.Write(linked, "connected")
    println udp.Read(server, 100)
    udp.Close(linked)
    udp.Close(wide)
    udp.Close(client)
    udp.Close(six)
    udp.Close(server)
end
