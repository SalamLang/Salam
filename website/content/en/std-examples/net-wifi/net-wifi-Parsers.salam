import net.wifi

func main:
    names := wifi.ParseIwDev("phy#0\n\tInterface wlan0\n\t\ttype managed\n")
    println names.Len(), names[0]
    names.Free()
    link := wifi.ParseIwLink("Connected to aa:bb:cc:dd:ee:ff (on wlan0)\n\tSSID: Sal\\xc3\\xa1m\n\tsignal: -58 dBm\n", "wlan0")
    println wifi.StateName(link.state), link.ssid, link.bssid, link.signal
    scan := "BSS aa:bb:cc:dd:ee:ff(on wlan0) -- associated\n\tcapability: ESS Privacy (0x0411)\n\tRSN:\t * Version: 1\n\t\t * Authentication suites: PSK\n"
    println wifi.SecurityName(wifi.ParseIwScan(scan, link.bssid))
    println wifi.DecodeSsid("Office\\x20Guest")
end
