import net.wifi
import sync

func main:
    mut trusted := Vector {} as Vector<str>
    defer trusted.Free()
    trusted.Push("Home")
    mut last := wifi.Current()
    repeat 3:
        now := wifi.Current()
        if wifi.Changed(last, now):
            println "network changed to", now.ssid
            if wifi.IsUntrusted(now, trusted):
                println "untrusted Wi-Fi: connect the VPN"
            end
            wifi.FreeStatus(last)
            last = now
        else:
            wifi.FreeStatus(now)
        end
        sync.SleepMs(1000)
    end
    wifi.FreeStatus(last)
end
