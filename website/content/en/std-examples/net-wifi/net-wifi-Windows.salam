import mem
import net.wifi

func put32(p: void*, off: int, v: int):
    ((p as i64 + off as i64) as u32*)[0] = v as u32
end

func main:
    buf := mem.AllocateZeroed(604 as u64)
    defer mem.Free(buf)
    put32(buf, 0, 1)
    put32(buf, 520, 2)
    ((buf as i64 + 524 as i64) as u8*)[0] = 72 as u8
    ((buf as i64 + 525 as i64) as u8*)[0] = 105 as u8
    put32(buf, 576, 80)
    put32(buf, 588, 1)
    put32(buf, 596, 7)
    put32(buf, 600, 4)
    s := wifi.ParseWlanConnection(buf, 604)
    println wifi.StateName(s.state), s.ssid, s.ssid_known, wifi.SecurityName(s.security), s.signal, s.backend
end
