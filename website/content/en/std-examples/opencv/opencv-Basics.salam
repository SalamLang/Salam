import opencv

func main:
    if not opencv.Available():
        println "OpenCV is not available:", opencv.LastError()
        ret
    end
    println opencv.Version()
    mut photo := opencv.Read("photo_en.jpg")
    if not photo.Ok() or photo.Empty():
        photo = opencv.NewBlank(320, 240, 3, opencv.White())
    end
    dims := photo.Size()
    println photo.Width(),
        photo.Height(),
        photo.Channels(),
        dims.width,
        dims.height,
        photo.Step(),
        photo.Total(),
        photo.Data() != null
    color := photo.At(10, 10)
    println color.r, color.g, color.b
    photo.SetPixel(0, 0, opencv.RGB(255, 128, 0))
    black := opencv.Zeros(10, 10, 1)
    println black.Channels(), opencv.Black().r, opencv.Red().r, opencv.Green().g, opencv.Blue().b

    gray := photo.ToGray()
    _ := photo.ToRgb()
    hsv := photo.ToHsv()
    _ := hsv.HsvToRgb()
    _ := photo.ConvertColor(opencv.COLOR_BGR2GRAY)
    _ := gray.ConvertColor(opencv.COLOR_GRAY2BGR)
    println opencv.COLOR_RGB2GRAY,
        opencv.COLOR_GRAY2RGB,
        opencv.COLOR_BGR2RGB,
        opencv.COLOR_RGB2BGR,
        opencv.COLOR_BGR2HSV,
        opencv.COLOR_HSV2BGR,
        opencv.COLOR_RGB2HSV,
        opencv.COLOR_HSV2RGB

    small := photo.Resize(160, 120, opencv.INTERP_AREA)
    _ := photo.ResizeScale(2.0, 2.0)
    _ := photo.Crop(10, 10, 100, 80)
    _ := photo.Rotate90(opencv.ROTATE_90_CW)
    _ := photo.Rotate(45.0, 1.0)
    _ := photo.Flip(opencv.FLIP_BOTH)
    _ := photo.FlipHorizontal()
    _ := photo.FlipVertical()
    println opencv.INTERP_NEAREST,
        opencv.INTERP_LINEAR,
        opencv.INTERP_CUBIC,
        opencv.INTERP_LANCZOS4,
        opencv.ROTATE_180,
        opencv.ROTATE_90_CCW,
        opencv.FLIP_VERTICAL,
        opencv.FLIP_HORIZONTAL
    copied := small.Clone()
    println copied.Save("small_en.png"), opencv.Write("gray_en.png", gray)
    copied.Free()
    photo.Free()
end
