import opencv

func main:
    mut photo := opencv.Read("photo_en.jpg")
    gray := photo.to_gray()
    _ := photo.blur(5)
    _ := photo.gaussian_blur(5, 1.5)
    _ := photo.median_blur(5)
    edges := gray.canny(50.0, 150.0)
    _ := gray.threshold(128.0, 255.0, opencv.THRESH_BINARY)
    _ := gray.threshold_otsu(255.0)
    _ := gray.adaptive_threshold(255.0, opencv.ADAPTIVE_GAUSSIAN, opencv.THRESH_BINARY, 11, 2.0)
    println opencv.THRESH_BINARY_INV, opencv.THRESH_TRUNC, opencv.THRESH_TOZERO, opencv.THRESH_TOZERO_INV, opencv.THRESH_OTSU, opencv.ADAPTIVE_MEAN
    println gray.histogram_gray().len()
    _ := edges.erode(3, 1)
    _ := edges.dilate(3, 2)
    _ := edges.morphology(opencv.MORPH_CLOSE, 5)
    println opencv.MORPH_OPEN, opencv.MORPH_GRADIENT, opencv.MORPH_TOPHAT, opencv.MORPH_BLACKHAT
    white := opencv.NewBlank(photo.width(), photo.height(), 3, opencv.White())
    _ := photo.blend(white, 0.7, 0.3, 0.0)
    _ := photo.bitwise(white, opencv.BITWISE_AND)
    _ := photo.bitwise(white, opencv.BITWISE_OR)
    _ := photo.bitwise(white, opencv.BITWISE_XOR)
    _ := photo.bitwise_not()
    _ := photo.abs_diff(white)
    photo.line(0, 0, 100, 100, opencv.Red(), 2)
    photo.rectangle(10, 10, 50, 30, opencv.Green(), 1)
    photo.circle(80, 80, 20, opencv.Blue(), -1)
    photo.ellipse(100, 50, 40, 20, 30.0, opencv.Black(), 2)
    photo.put_text("Salam", 10, 200, 1.0, opencv.White(), 2)
    mut points := Vector {} as Vector<opencv.Point>
    points.push(opencv.Point { x = 0, y = 0 })
    points.push(opencv.Point { x = 50, y = 0 })
    points.push(opencv.Point { x = 25, y = 40 })
    photo.polylines(points, true, opencv.Red(), 2)
    photo.fill_poly(points, opencv.Green())
    _ := opencv.Write("filtered_en.png", photo)
end
