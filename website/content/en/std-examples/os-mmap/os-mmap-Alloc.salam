import os.mmap

func main:
    page := mmap.PageSize()
    block := mmap.Alloc(page, mmap.PROT_READ | mmap.PROT_WRITE)
    if block == null:
        println "mapping failed"
        ret
    end
    bytes := block as u8*
    bytes[0] = 7 as u8
    bytes[page - 1] = 9 as u8
    println bytes[0], bytes[1], bytes[page - 1]
    println mmap.Protect(block, page, mmap.PROT_READ)
    println bytes[0]
    println mmap.Free(block, page)
end
