import os.process

func main:
    mut cmd := process.NewCommand("cat")
    cmd.Piped()
    mut child := process.Launch(cmd)
    child.Write("hello child\n")
    line := child.ReadLine(2000)
    println "got:", line.data
    line.Free()
    child.CloseStdin()
    status := child.Wait(2000)
    println "exit code:", status.code
    child.Close()
    cmd.Free()
end
