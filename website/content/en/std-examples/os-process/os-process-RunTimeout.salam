import os.process

func main:
    mut args := Vector {} as Vector<str>
    defer args.free()
    args.push("-c")
    args.push("echo fast output; echo warning 1>&2; exit 2")
    mut quick := process.RunTimeout("sh", args, "", 2000)
    println "code:", quick.status.code
    print "stdout:", quick.stdout
    print "stderr:", quick.stderr
    quick.Free()

    mut slow_args := Vector {} as Vector<str>
    defer slow_args.free()
    slow_args.push("-c")
    slow_args.push("echo started; sleep 30")
    mut slow := process.RunTimeout("sh", slow_args, "", 300)
    println "timed out:", slow.timed_out, "signal:", slow.status.signal
    print "partial:", slow.stdout
    slow.Free()
end
