import os.process

func main:
    mut cmd := process.NewCommand("sleep")
    cmd.Arg("30")
    mut child := process.Launch(cmd)
    println "running:", child.Poll()
    println "sent:", child.Terminate()
    status := child.Wait(2000)
    println "signaled:", status.signaled, "signal:", status.signal
    println "return code:", status.ReturnCode()
    println "running:", child.Poll()
    child.Close()
    cmd.Free()
end
