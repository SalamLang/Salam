import os.process
import os.pty

func main:
    mut cmd := process.NewCommand("sh")
    cmd.Arg("-c")
    cmd.Arg("stty size")
    mut term := pty.Open(cmd, 30, 100)
    out := term.ReadFor(1000)
    println out.data.trim()
    out.Free()
    println "exit:", term.Wait(2000).code
    term.Close()
    cmd.Free()
end
