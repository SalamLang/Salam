import os

func fail(message: str):
    printerrln message
    os.Exit(2)
end

func give_up():
    os.Abort()
end

func main:
    args := os.Args()
    println "argument count:", args.len()
    home := os.Env("HOME")
    println home.len() > 0 or os.Env("USERPROFILE").len() > 0
    if args.len() > 10:
        fail("too many arguments")
    end
    if args.len() > 100:
        give_up()
    end
end
