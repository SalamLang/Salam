import os

func fail(message: str):
    printerrln message
    os.Exit(2)
end

func give_up():
    os.Abort()
end

func main:
    args := os.Args()
    println "argument count:", args.Len()
    home := os.Env("HOME")
    println home.Len() > 0 or os.Env("USERPROFILE").Len() > 0
    if args.Len() > 10:
        fail("too many arguments")
    end
    if args.Len() > 100:
        give_up()
    end
end
