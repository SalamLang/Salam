import chan
import mem
import pool

mut box := chan.Chan {} as chan.Chan<i64>
mut got := null as i64*

func waiter():
    mut ok := false
    v := box.recv(ok)
    atomic_store(got, v)
end

func sender():
    box.send(7 as i64)
end

func main:
    box.init(1 as i64)
    got = mem.AllocateZeroed(8 as u64) as i64*
    p := pool.NewElastic(1 as i64, 4 as i64, 8 as i64)
    println "start: ", pool.Workers(p)
    pool.Submit(p, (): waiter() end)
    pool.Submit(p, (): sender() end)
    pool.Wait(p)
    println "received: ", atomic_load(got)
    println "grew: ", pool.Workers(p) > 1
    println "capped: ", pool.Workers(p) <= 4
    pool.Stop(p)
    box.Free()
    mem.Free(got as void*)
end
