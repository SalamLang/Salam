import pool

func fib(n: i64): i64:
    if n < 2:
        ret n
    end
    ret fib(n - 1) + fib(n - 2)
end

func main:
    p := pool.New(2 as i64, 4 as i64)
    a := pool.Async(p, (): ret fib(25 as i64) end)
    b := pool.AsyncStr(p, (): ret "done" end)
    println pool.Await(a)
    println pool.AwaitStr(b)
    println pool.Ready(a)
    pool.Release(a)
    pool.Release(b)
    pool.Stop(p)
end
