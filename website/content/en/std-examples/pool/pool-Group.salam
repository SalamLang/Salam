import pool

func check(n: int): str:
    if n == 7:
        ret "item 7 is bad"
    end
    ret ""
end

func main:
    g := pool.NewGroup(3 as i64)
    repeat 20 in i:
        pool.GroupGo(g, (): ret check(i) end)
    end
    println pool.GroupWait(g)
    println pool.GroupFailed(g)
    pool.GroupStop(g)
end
