import mem
import pool
import sync

mut done := null as i64*
mut gate := null as i64*

func work:
    sync.SleepMs(2)
    atomic_add(done, 1 as i64)
end

func hold:
    until atomic_load(gate) != 0:
        sync.SleepMs(1)
    end
end

func main:
    done = mem.AllocateZeroed(8 as u64) as i64*
    gate = mem.AllocateZeroed(8 as u64) as i64*

    p := pool.New(4 as i64, 8 as i64)
    println "workers: ", pool.Workers(p)
    repeat 100:
        pool.Submit(p, (): work() end)
    end
    pool.Wait(p)
    println "finished: ", atomic_load(done)
    pool.Stop(p)

    q := pool.New(1 as i64, 1 as i64)
    atomic_store(gate, 1 as i64)
    pool.Submit(q, (): hold() end)
    until pool.Running(q) == 0:
        sync.SleepMs(1)
    end
    println "queued: ", pool.TrySubmit(q, (): work() end)
    println "full: ", pool.TrySubmit(q, (): work() end)
    println "pending: ", pool.Pending(q)
    atomic_store(gate, 0 as i64)
    pool.Stop(q)
    println "drained: ", atomic_load(done)

    mem.Free(done as void*)
    mem.Free(gate as void*)
end
