import regex

func main throws:
    r := try regex.Compile("[0-9]+")
    println r.pattern, regex.IsValid("[0-9]+"), regex.IsValid("[0-9")
    println regex.Match(r, "abc123"), regex.Find(r, "abc123")
    println regex.Replace(r, "a1 b22 c333", "#")
    println regex.ReplaceAll(r, "a1 b22 c333", "#")
    println try regex.MatchStr("^[a-z]+$", "salam"), try regex.FindStr("o", "salam donya")
    println try regex.ReplaceStr("a", "banana", "o"), try regex.ReplaceAllStr("a", "banana", "o")
    try:
        bad := regex.Compile("[0-9")
        println bad.pattern
    catch e:
        println e.kind_name(), e.code, e.offset, e.message
    end
end
