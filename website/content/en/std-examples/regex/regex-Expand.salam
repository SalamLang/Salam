import regex

func main throws:
    r := try regex.Compile("([a-z]+)@([a-z]+)")
    text := "ali@home, sara@work"
    m := regex.FindMatch(r, text)
    println regex.Expand(m, "$2 <- $1")
    println regex.ReplaceExpand(r, text, "$2:$1")
    println regex.ReplaceAllExpand(r, text, "$2:$1")
    println try regex.ReplaceExpandStr("(\\w+) (\\w+)", "hello world", "$2 $1")
    println try regex.ReplaceAllExpandStr("(a)(b)", "abab", "$2$1")
end
