import regex

func main throws:
    r := try regex.Compile("[0-9]+")
    text := "year 1403, month 7, day 12"
    println regex.FindAll(r, text)
    println regex.FindAllN(r, text, 2)
    println try regex.FindAllStr("[a-z]+", "one two three")
    println regex.Split(try regex.Compile(" *, *"), "a , b,c ,  d")
    println regex.SplitN(try regex.Compile(","), "a,b,c,d", 2)
    println try regex.SplitStr("-+", "2025--09---29")
    all := regex.FindAllMatches(r, text, -1)
    each m in all:
        println regex.Group(m, 0), m.start, m.stop
    end
end
