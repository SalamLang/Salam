import rpc
import encoding.value
import compress

func main:
    mut params := value.NewValueArray()
    value.ArrayPush(params, value.ValueInt(2))
    value.ArrayPush(params, value.ValueString("hello"))
    value.ArrayPush(params, value.ValueFloat(1.5))
    value.ArrayPush(params, value.ValueBool(true))
    req := rpc.NewRequest("calc", params, 1)
    println rpc.JsonEncodeRequest(req)
    println rpc.ParamCount(req), rpc.ParamInt(req, "a", 0), rpc.ParamStr(req, "b", 1)
    println rpc.ParamFloat(req, "c", 2), rpc.ParamBool(req, "d", 3), rpc.HasParam(req, "e", 4)
    println value.AsInt(rpc.ParamAt(req, 0)), value.AsInt(rpc.Param(req, "a", 0))
    mut obj := value.NewValueObject()
    value.ObjectSet(obj, "name", value.ValueString("Ali"))
    req2 := rpc.NewRequestStrId("greet", obj, "req-1")
    println rpc.JsonEncodeRequest(req2)
    println value.AsString(rpc.ParamNamed(req2, "name"))
    note := rpc.NewNotification("tick", value.NewValueArray())
    println rpc.IsNotification(note), rpc.JsonEncodeRequest(note)

    mut ok := false
    read := rpc.JsonDecodeRequest(`{"jsonrpc":"2.0","method":"add","params":{"a":1,"b":2},"id":9}`, ok)
    println ok, read.method, read.msgid, rpc.ParamInt(read, "b", 1)

    answer := rpc.NewResponse(value.ValueInt(1), value.ValueString("ok"))
    println rpc.JsonEncodeResponse(answer)
    err := rpc.StdError(rpc.RPC_METHOD_NOT_FOUND)
    println err.code, err.message
    println rpc.JsonEncodeResponse(rpc.NewErrorResponse(value.ValueInt(2), rpc.NewError(-32000, "the server is busy")))
    with_data := rpc.ErrorWithData(rpc.RPC_INVALID_PARAMS, "bad", value.ValueString("x"))
    println with_data.has_data, rpc.JsonTopLevelError(rpc.StdError(rpc.RPC_PARSE_ERROR))

    one := rpc.JsonDecodeResponse(`{"jsonrpc":"2.0","result":3.5,"id":1}`, ok)
    println ok, rpc.ResultFloat(one), rpc.IsErrorResponse(one)
    two := rpc.JsonDecodeResponse(`{"jsonrpc":"2.0","error":{"code":-32601,"message":"nope"},"id":2}`, ok)
    println rpc.IsErrorResponse(two), rpc.ErrorCode(two), rpc.ErrorMessage(two)
    all := rpc.JsonDecodeResponses(`[{"jsonrpc":"2.0","result":true,"id":1},{"jsonrpc":"2.0","result":"x","id":2}]`, ok)
    println all.is_batch, all.items.len(), rpc.ResultBool(all.items[0]), rpc.ResultStr(all.items[1])
    println rpc.JsonEncodeResponses(all)

    println rpc.CodecName(rpc.RPC_CODEC_JSON), rpc.CodecName(rpc.RPC_CODEC_MSGPACK)
    println rpc.CodecDefaultFraming(rpc.RPC_CODEC_JSON) == rpc.RPC_FRAME_LINE, rpc.CodecDefaultFraming(rpc.RPC_CODEC_MSGPACK) == rpc.RPC_FRAME_LENGTH
    packed := rpc.EncodeRequest(rpc.RPC_CODEC_MSGPACK, req)
    println packed.len, compress.BufGet(packed, 0)
    batch := rpc.DecodeBatch(rpc.RPC_CODEC_MSGPACK, packed)
    println batch.ok, batch.items[0].method, batch.items[0].msgid
    println rpc.MsgpackDecodeBatch(rpc.MsgpackEncodeRequest(req)).items[0].method
    mp := rpc.MsgpackEncodeResponse(rpc.NewResponse(value.ValueInt(1), value.ValueInt(42)))
    println rpc.ResultInt(rpc.MsgpackDecodeResponse(mp, ok)), ok
    js := rpc.EncodeRequest(rpc.RPC_CODEC_JSON, req)
    println rpc.ResultInt(rpc.DecodeResponse(rpc.RPC_CODEC_MSGPACK, mp, ok)), js.len > 0
    println compress.BufToStrUnsafe(rpc.EncodeResponses(rpc.RPC_CODEC_JSON, all)).len() > 0
    println compress.BufToStrUnsafe(rpc.EncodeTopLevelError(rpc.RPC_CODEC_JSON, err))
    println rpc.RPC_MP_REQUEST, rpc.RPC_MP_RESPONSE, rpc.RPC_MP_NOTIFY
    println rpc.RPC_INVALID_REQUEST, rpc.RPC_INTERNAL_ERROR, rpc.RPC_SERVER_ERROR
    println rpc.RPC_KIND_REQUEST, rpc.RPC_KIND_NOTIFICATION, rpc.RPC_KIND_RESPONSE
    println compress.BufToStrUnsafe(compress.BufFromStr(rpc.JsonEncodeRequest(req))).len() > 0
end
