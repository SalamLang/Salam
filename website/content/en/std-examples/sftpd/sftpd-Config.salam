import sftpd
import sshd

func main:
    mut cfg := sftpd.NewConfig()
    println cfg.host, cfg.port, cfg.root
    println cfg.host_key_file == "", cfg.users.len()
    cfg.root = "/srv/drop"
    cfg.users.push(sshd.User { name = "partner", password = "s3cret", home = "/" })
    println cfg.root, cfg.users.len(), cfg.users.get(0).name
end
