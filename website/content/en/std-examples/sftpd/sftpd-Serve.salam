import sftpd

func main:
    mut cfg := sftpd.NewConfig()
    cfg.port = 2222
    cfg.root = "/srv/drop"
    mut srv := sftpd.New(cfg)
    if not sftpd.Listen(srv):
        ret 1
    end
    handled := sftpd.ServeOnce(srv)
    println "one connection served:", handled
    sftpd.Serve(srv)
    sftpd.Close(srv)
    ret 0
end
