import sort

func main:
    repeat 3 in round:
        mut v := Vector {} as Vector<int>
        defer v.free()
        each n in [170, 45, 75, 90, 802, 24, 2, 66]:
            v.push(n)
        end
        if round == 0:
            sort.RadixSort(v)
        else round == 1:
            sort.CountingSort(v)
        else:
            sort.BucketSort(v)
        end
        println v
    end
end
