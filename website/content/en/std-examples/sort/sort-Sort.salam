import sort

func main:
    mut numbers := Vector {} as Vector<int>
    defer numbers.free()
    each n in [5, 3, 9, 1, 7]:
        numbers.push(n)
    end
    println sort.IsSorted(numbers)
    ordered := sort.Sorted(numbers)
    println ordered, numbers
    sort.Sort(numbers)
    println numbers, sort.IsSorted(numbers)
    sort.SortDesc(numbers)
    println numbers
    sort.Reverse(numbers)
    println numbers, sort.Min(numbers), sort.Max(numbers)
    sort.Swap(numbers, 0, 4)
    println numbers
end
