import sshd

func main:
    mut cfg := sshd.NewConfig()
    println cfg.host, cfg.port, cfg.server_version == sshd.DefaultVersion
    println cfg.allow_password, cfg.allow_publickey
    println cfg.allow_exec, cfg.allow_shell, cfg.allow_sftp
    println cfg.root, cfg.banner == "", cfg.users.len()
    sshd.AddUser(cfg, "alice", "s3cret", "/home/alice")
    sshd.AddUser(cfg, "bob", "hunter2")
    each u in cfg.users:
        println u.name, u.password.len(), u.home
    end
end
