import stats

func main:
    mut scores := Vector {} as Vector<f64>
    defer scores.free()
    each s in [12.0, 18.0, 15.0, 19.0, 11.0]:
        scores.push(s)
    end
    println stats.Sum(scores), stats.Mean(scores), stats.Median(scores)
    println stats.Min(scores), stats.Max(scores)
    println stats.Variance(scores), stats.PopVariance(scores)
    println stats.Stdev(scores), stats.PopStdev(scores)
    println stats.Geomean(scores), stats.Percentile(scores, 90.0)
end
