import str

func main:
    name := "Report-2026.TXT"
    println name.StartsWith("Report"), name.EndsWith(".txt"), name.Includes("2026")
    println str.StartsWithFold(name, "report"), str.EndsWithFold(name, ".txt")
    mut exts := Vector {} as Vector<str>
    exts.Push(".csv")
    exts.Push(".TXT")
    println str.EndsWithAny(name, exts), str.StartsWithAny(name, exts)
    mut ok := false
    println str.CutPrefix(name, "Report-", ok), ok
    println str.CutSuffix(name, ".md", ok), ok
end
