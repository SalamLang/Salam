import str
import mem

func main:
    data := mem.MustAllocateZeroed(6 as u64) as i8*
    mark := mem.MustAllocateZeroed(3 as u64) as i8*
    data[0] = 80 as i8
    data[1] = 75 as i8
    data[2] = 0 as i8
    data[3] = 1 as i8
    data[4] = 2 as i8
    mark[0] = 0 as i8
    mark[1] = 1 as i8
    mark[2] = 2 as i8
    println str.StartsWithBytes(data as void*, 5, data as void*, 2)
    println str.StartsWithBytes(data as void*, 1, data as void*, 2)
    println str.EndsWithBytes(data as void*, 5, mark as void*, 3)
    println str.EndsWithBytes(data as void*, 2, mark as void*, 3)
    mem.Free(data as void*)
    mem.Free(mark as void*)
end
