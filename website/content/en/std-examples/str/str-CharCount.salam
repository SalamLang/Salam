import str

func main:
    s := "سلام"
    println str.Len(s), str.CharCount(s)
    println str.CharAtIndex(s, 1), str.CharSubstr(s, 1, 2)
    println str.CharFind(s, "ام"), str.Reverse(s)
    println str.CharAt(s, 2)
    mut code := 0
    width := str.CodePointAt(s, 0, code)
    println code, width, str.CharLen(216)
    points := str.CodePoints(s)
    println points
    println str.FromCodePoints(points)
    println str.Chars("ab۱")
    println str.AllAscii("salam"), str.AllAscii("سلام")
end
