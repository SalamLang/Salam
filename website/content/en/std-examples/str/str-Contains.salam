import str

func main:
    s := "salam, salam world"
    println str.Contains(s, "world"), str.StartsWith(s, "salam"), str.EndsWith(s, "world")
    println str.IndexOf(s, "salam"), str.LastIndex(s, "salam"), str.Search(s, "missing")
    println str.IndexFrom(s, "salam", 1), str.Count(s, "salam")
end
