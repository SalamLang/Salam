import str

func main:
    println str.ToPersianDigits("order 1403")
    println str.ToEnglishDigits("code ۱۲۳ and ٤٥٦")
    println str.ToArabicDigits("2025")
    println str.HasPersianDigits("۱۲"), str.HasArabicDigits("۱۲"), str.HasEnglishDigits("12")
    d := str.CodePoints("۷").get(0)
    println str.IsPersianDigit(d), str.IsArabicDigit(d), str.IsAnyDigit(d)
    println str.DigitValue(d), str.DigitValue(65)
end
