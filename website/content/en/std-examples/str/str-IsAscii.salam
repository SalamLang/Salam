import str

func main:
    each s in ["A", "z", "7", " ", "!", "ب", "۷", "\t"]:
        c := str.CodePoints(s).get(0)
        println "[" + s + "]", str.IsAscii(c), str.IsAlpha(c), str.IsDigit(c), str.IsSpace(c), str.IsPunct(c)
    end
    println str.IsAsciiUpper(65), str.IsAsciiLower(65), str.IsUpper(1040), str.IsLower(1072)
    println str.IsAsciiDigit(50), str.IsAsciiAlpha(50), str.IsAsciiAlnum(50), str.IsAsciiSpace(32)
    println str.IsAlnum(1776), str.IsMark(1614), str.IsControl(10)
end
