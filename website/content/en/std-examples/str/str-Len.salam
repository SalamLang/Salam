import str

func main:
    a := "apple"
    b := "pear"
    println str.Len(a), str.IsEmpty(""), str.IsEmpty(a)
    println str.Concat(a, b)
    println str.Compare(a, b), str.Compare(b, a), str.Compare(a, "apple")
    println str.Equals(a, "apple")
    println str.Substr("salam donya", 6, 5), str.SubstrIn("salam", 3, 10)
    println str.Find("salam donya", "donya")
    c := str.Clone(a)
    println c
end
