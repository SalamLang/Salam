import str

func main:
    composed := "آ"
    decomposed := str.NFD(composed)
    println composed.len(), decomposed.len(), composed == decomposed
    println str.NFC(decomposed) == composed
    println str.IsNFC(composed), str.IsNFC(decomposed)
    presentation := "ﻼ"
    println str.NFKD(presentation), str.NFKC(presentation)
end
