import str

func main:
    mut b := str.NewBuilder()
    defer str.BufFree(b)
    println str.BufIsEmpty(b)
    repeat 1 to 3 in i:
        str.BufAppend(b, "part ")
        str.BufAppendInt(b, i)
        str.BufAppendChar(b, 44)
    end
    str.BufAppendCp(b, 1776)
    println str.BufStr(b)
    println str.BufLen(b), str.BufIsEmpty(b)
    str.BufReset(b)
    println str.BufLen(b)
end
