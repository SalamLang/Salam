import telegram.bot
import env

func handle(update: bot.Update):
    if not update.has_message:
        ret
    end
    println update.message.from_user.first_name, update.message.text
end

func main:
    robot := bot.NewBot(env.Get("TELEGRAM_TOKEN"))
    me := bot.GetMe(robot)
    if not bot.Ok(me):
        println me.error_code, me.description, me.http_status, me.http_err
        ret
    end
    println me.ok, me.result
    chat := 42 as i64
    _ := bot.SendMessage(robot, chat, "hello")
    _ := bot.SendMessage(robot, "@my_channel", "fresh news")
    mut options := bot.SendOptions {}
    options.parse_mode = "Markdown"
    options.reply_markup = bot.RemoveKeyboard()
    _ := bot.SendMessageOptions(robot, chat, "*important*", options)
    _ := bot.SendPhoto(robot, chat, "https://example.com/a.jpg", "a photo")
    _ := bot.SendDocument(robot, chat, "BQACAgQAAx", "")
    _ := bot.SendVideo(robot, chat, "https://example.com/v.mp4", "")
    _ := bot.SendAudio(robot, chat, "https://example.com/a.mp3", "")
    _ := bot.SendVoice(robot, chat, "AwACAgQ", "")
    _ := bot.SendSticker(robot, chat, "CAACAgI")
    _ := bot.SendLocation(robot, chat, 35.6997, 51.338)
    _ := bot.SendContact(robot, chat, "+989120000000", "Ali")
    _ := bot.SendChatAction(robot, chat, "typing")
    _ := bot.EditMessageText(robot, chat, 10, "edited")
    _ := bot.ForwardMessage(robot, chat, 43, 11)
    _ := bot.PinChatMessage(robot, chat, 10)
    _ := bot.UnpinChatMessage(robot, chat, 10)
    _ := bot.DeleteMessage(robot, chat, 10)
    _ := bot.AnswerCallbackQuery(robot, "cq1", "noted")
    _ := bot.AnswerInlineQuery(robot, "iq1", "[]")
    file := bot.GetFile(robot, "AgACAgQ")
    println file.result.len() > 0
    _ := bot.GetChat(robot, chat)
    _ := bot.GetChatMemberCount(robot, chat)
    _ := bot.GetChatMember(robot, chat, 7)
    _ := bot.BanChatMember(robot, chat, 7)
    _ := bot.UnbanChatMember(robot, chat, 7)
    _ := bot.LeaveChat(robot, -100)
    mut commands := Vector {} as Vector<str>
    commands.push(bot.BotCommand("start", "start it"))
    _ := bot.SetMyCommands(robot, commands)
    _ := bot.SetWebhook(robot, "https://example.com/hook")
    _ := bot.SetWebhookSecret(robot, "https://example.com/hook", "my-secret")
    _ := bot.GetWebhookInfo(robot)
    _ := bot.DeleteWebhook(robot)
    mut params := HashMap {} as HashMap<str, str>
    params.insert("chat_id", "42")
    _ := bot.Call(robot, "getChatAdministrators", params)
    updates := bot.GetUpdates(robot, 0, 10, 30)
    println bot.ParseUpdates(updates.result).len(), robot.token.len() > 0
    bot.Poll(robot, 30, (update: bot.Update):
        handle(update)
    end)
end
