import term

func main:
    term.SetColorMode(term.ColorNever)
    mut b := term.NewBar(200, "download")
    b.width = 20
    b.fill = "█"
    b.empty = "░"
    term.BarSet(b, 50)
    println term.BarRender(b)
    term.BarAdd(b, 100)
    b.show_count = true
    println term.BarRender(b)
    mut s := term.NewSpinner("working")
    defer term.SpinnerFree(s)
    println s.label, s.frames.Len() > 0
    mut frames := Vector {} as Vector<str>
    frames.Push("◐")
    frames.Push("◓")
    mut s2 := term.NewSpinnerFrames("loading", frames)
    defer term.SpinnerFree(s2)
    repeat 3:
        println term.SpinnerFrame(s2)
        s2.idx = (s2.idx + 1) % frames.Len()
    end
end
