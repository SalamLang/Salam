import term
import time

func main:
    mut b := term.NewBar(50, "processing")
    repeat 50:
        term.BarAdd(b, 1)
        term.BarDraw(b)
        time.Sleep(20)
    end
    term.BarFinish(b)
    mut s := term.NewSpinner("connecting to the server")
    repeat 20:
        term.SpinnerTick(s)
        time.Sleep(50)
    end
    term.SpinnerStop(s, "connected")
    term.SpinnerFree(s)
end
