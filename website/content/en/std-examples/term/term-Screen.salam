import term

func main:
    term.EnableAnsi()
    term.SetTitle("dashboard")
    term.EnterAltScreen()
    term.HideCursor()
    term.ClearScreen()
    term.Home()
    term.MoveTo(2, 4)
    term.Write(term.Bold("hello from the dashboard"))
    term.SaveCursor()
    term.Down(2)
    term.Right(4)
    term.Emit("status: good")
    term.RestoreCursor()
    term.Up(1)
    term.Left(1)
    term.NextLine(1)
    term.PrevLine(1)
    term.Column(1)
    term.ClearLine()
    term.ClearToLineEnd()
    term.ClearBelow()
    term.ResetLine()
    term.SetScrollRegion(3, term.Rows() - 1)
    term.ScrollUp(1)
    term.ScrollDown(1)
    term.InsertLines(1)
    term.DeleteLines(1)
    term.ResetScrollRegion()
    term.EnableMouse()
    term.DisableMouse()
    term.Bell()
    term.Flush()
    term.ClearScrollback()
    term.ShowCursor()
    term.ExitAltScreen()
    term.WriteErr("done\n")
    w := term.Size()
    println w.cols, w.rows, term.Cols()
end
