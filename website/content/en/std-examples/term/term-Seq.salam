import term
import str

func show(s: str): str:
    ret str.Replace(str.Replace(s, term.Esc, "\\e"), "\u0007", "\\a")
end

func main:
    println show(term.SeqUp(2)), show(term.SeqDown(1)), show(term.SeqRight(3)), show(term.SeqLeft(3))
    println show(term.SeqNextLine(1)), show(term.SeqPrevLine(1)), show(term.SeqColumn(10)), show(term.SeqMoveTo(5, 20)), show(term.SeqHome())
    println show(term.SeqSaveCursor()), show(term.SeqRestoreCursor()), show(term.SeqHideCursor()), show(term.SeqShowCursor())
    println show(term.SeqClearScreen()), show(term.SeqClearScrollback()), show(term.SeqClearLine())
    println show(term.SeqClearToLineEnd()), show(term.SeqClearToLineStart()), show(term.SeqClearBelow()), show(term.SeqClearAbove()), show(term.SeqResetLine())
    println show(term.SeqScrollUp(2)), show(term.SeqScrollDown(2)), show(term.SeqInsertLines(1)), show(term.SeqDeleteLines(1))
    println show(term.SeqScrollRegion(2, 20)), show(term.SeqResetScrollRegion())
    println show(term.SeqEnterAltScreen()), show(term.SeqExitAltScreen())
    println show(term.SeqEnableMouse()), show(term.SeqEnableMouseMotion()), show(term.SeqDisableMouse())
    println show(term.SeqTitle("my program"))
end
