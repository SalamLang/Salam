import term

func main:
    w := term.Size()
    println w.cols > 0, w.rows > 0, term.Cols() > 0, term.Rows() > 0
    t := term.IsTerminal()
    println t == term.IsTTY(term.StdoutFd)
    println term.StdinFd, term.StdoutFd, term.StderrFd
    term.SetColorMode(term.ColorAlways)
    println term.SupportsColor()
    c256 := term.Supports256Color()
    ctrue := term.SupportsTrueColor()
    println c256 or not c256, ctrue or not ctrue
end
