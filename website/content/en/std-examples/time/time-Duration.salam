import time

func main throws:
    d := time.Hours(1).Add(time.Minutes(30))
    println d.ToStr(), d.minutes(), d.secs()
    println time.FormatDuration(time.Milliseconds(1500)), time.FormatDuration(time.Microseconds(250)), time.FormatDuration(time.Nanoseconds(42))
    println time.Seconds(90).ToStr(), time.Days(2).hours(), time.SecondsF(0.25).millis()
    p := try time.ParseDuration("1h15m30.5s")
    println p.ToStr(), p.seconds()
    try:
        println time.ParseDuration("ten minutes").ToStr()
    catch e:
        println e.kind_name(), e.code, e.offset
    end
    println time.ParseDurationOr("?", time.Seconds(5)).ToStr()
    k := time.Minutes(7)
    println k.sub(time.Minutes(10)).ToStr(), k.neg().abs().ToStr(), k.neg().is_negative()
    println k.mul(3).ToStr(), k.div(2).ToStr(), time.Hours(1).ratio(k)
    println k.cmp(time.Seconds(420)), k.less(time.Hours(1)), k.equals(time.Seconds(420))
    t := time.Milliseconds(1750)
    println t.truncate(time.Seconds(1)).ToStr(), t.round(time.Seconds(1)).ToStr()
    println t.nanos(), t.micros(), t.millis(), time.ZeroDuration().is_zero(), t.days() < 0.001
end
