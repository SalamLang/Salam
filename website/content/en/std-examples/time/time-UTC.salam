import time

func main throws:
    t := time.FromUTCParts(2024, 3, 20, 14, 5, 9)
    println t, time.FormatISOUTC(t)
    println time.YearUTC(t), time.MonthUTC(t), time.DayUTC(t), time.HourUTC(t), time.MinuteUTC(t), time.SecondUTC(t)
    println time.FormatHTTPDate(t)
    println try time.ParseHTTPDate("Wed, 20 Mar 2024 14:05:09 GMT") == t
    println try time.ParseISO("2024-03-20T17:35:09+03:30") == t
    println try time.ParseISOIn("2024-03-20 17:35:09.25", 210) == t, try time.ParseISONanos("2024-03-20T14:05:09.25Z")
    f := try time.ParseFormat("%d/%m/%Y %H:%M %z", "20/03/2024 14:05 +0000")
    println time.FormatISOUTC(f)
    try:
        println time.ParseISO("2024-02-30")
    catch e:
        println e.kind_name(), e.code, e.column, e.message
    end
    println time.ParseISOOr("tomorrow", 0)
    later := time.AddDuration(t, time.Days(10))
    println time.FormatISOUTC(later), time.DiffSeconds(later, t), time.DurationBetween(later, t).ToStr()
    println time.SecondsPerMinute, time.SecondsPerHour, time.SecondsPerDay
end
