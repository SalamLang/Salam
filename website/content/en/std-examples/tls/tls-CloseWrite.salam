import tls
import net.tcp

func main:
    cfg := tls.NewServerConfig("cert.pem", "key.pem")
    if not cfg.ok:
        println "the certificate or key could not be read"
        ret
    end
    server := tcp.Bind(8443)
    sock := tcp.Accept(server)
    mut conn := tls.WrapServer(sock.fd, cfg)
    if tls.ConnOk(conn):
        mut request := ""
        until true:
            part := tls.Read(conn, 1024)
            if part.len() == 0:
                break
            end
            request += part
        end
        println request.len(), conn.rdone
        _ := tls.Write(conn, "received " + request.len() + " bytes")
        tls.CloseWrite(conn)
    end
    tls.Close(conn)
    tcp.CloseServer(server)
end
