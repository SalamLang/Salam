import tls
import net.tcp

func main:
    sock := tcp.Dial("example.com", 443)
    if not tcp.ConnOk(sock):
        println "the connection was not made"
        ret
    end
    mut conn := tls.WrapClient(sock.fd, tls.NewConfig("example.com"))
    println tls.ConnOk(conn)
    tls.Detach(conn)
    tcp.Close(sock)
end
