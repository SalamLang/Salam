import tls
import encoding
import io

func main:
    key := io.ReadFile("public.pem")
    mut ok := false
    cipher := tls.RsaEncryptOaepSha1(key, encoding.Base64Encode("hello"), ok)
    if not ok:
        println "the RSA public key could not be read"
        ret
    end
    println cipher.len() > 0
end
