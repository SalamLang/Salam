import tui

func main:
    r := tui.Rect { x = 2, y = 1, width = 10, height = 4 }
    println "right", r.right(), "bottom", r.bottom(), "empty", r.IsEmpty()
    println "contains 5,2:", r.contains(tui.Point { x = 5, y = 2 })
    other := tui.Rect { x = 8, y = 3, width = 6, height = 6 }
    println "intersects:", r.intersects(other)
    both := r.intersection(other)
    println "overlap", both.x, both.y, both.width, both.height
    mid := r.center()
    println "center", mid.x, mid.y

    mut boxes := Vector {} as Vector<tui.Rect>
    boxes.push(tui.Rect { x = 0, y = 10, width = 4, height = 1 })
    boxes.push(tui.Rect { x = 20, y = 1, width = 4, height = 1 })
    println "right:", tui.Nearest(r, boxes, tui.DirRight), "down:", tui.Nearest(r, boxes, tui.DirDown)
    println "up:", tui.Nearest(r, boxes, tui.DirUp), "left:", tui.Nearest(r, boxes, tui.DirLeft)
end
