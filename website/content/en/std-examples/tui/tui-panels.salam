import term
import tui

mut closed := 0

func show(s: tui.Screen):
    s.draw()
    repeat s.buffer.height in y:
        println "|" + s.buffer.row_text(y) + "|"
    end
end

func main:
    mut s := tui.NewScreen(tui.BaseWidget {}, 24, 6)
    defer s.close()
    area := tui.Rect { width = 24, height = 6 }

    body := tui.NewText("inside the frame") as dyn tui.Widget
    mut frame := tui.Panel { border = tui.BorderStyle.Single, title = "Panel", takes_focus = true, focus_style = tui.Style { bold = true } }
    frame.border_style = tui.StyleDefault
    frame.add(body)
    pid := s.add(tui.RootId, frame as dyn tui.Widget)
    _ := s.add(pid, body)
    s.widget(pid).set_bounds(area)
    println "panel focusable:", s.widget(pid).focusable(), "child slot:", frame.slot.len()

    mut dialog := tui.NewModal()
    dialog.set_title("Quit?")
    dialog.set_size(tui.ModalSize.Fixed(14, 3))
    dialog.set_closable(true)
    dialog.border_style = tui.StyleDefault
    dialog.on_close = (): closed++ end
    answer := tui.NewText("y / n") as dyn tui.Widget
    dialog.add(answer)
    dialog.set_bounds(area)
    mid := s.add(tui.RootId, dialog as dyn tui.Widget)
    _ := s.add(mid, answer)
    dialog.open()
    _ := s.push_focus(mid)
    s.raise_subtree(mid)
    show(s)

    _ := s.dispatch(tui.Event { kind = tui.KeyEvent, key = term.Key { code = term.KeyEscape } })
    s.unraise_subtree(mid)
    _ := s.pop_focus()
    println "closed:", closed, "focus back on panel:", s.focused_id() == pid
    show(s)
    _ := dialog.takes_focus
    _ := dialog.state
    dialog.close()
    _ := tui.ModalSize.Percent(50, 50)
    _ := tui.Weight.Heavy
end
