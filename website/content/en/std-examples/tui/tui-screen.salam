import term
import tui

func at(x: int, y: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = 8, height = 1 }
end

func key(code: int): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Key { code = code } }
end

func main:
    mut s := tui.NewScreen(tui.BaseWidget {}, 20, 3)
    defer s.close()
    a := s.add(tui.RootId, tui.NewButton("A") as dyn tui.Widget)
    b := s.add(tui.RootId, tui.NewButton("B") as dyn tui.Widget)
    c := s.add(tui.RootId, tui.NewButton("C") as dyn tui.Widget)
    s.widget(a).set_bounds(at(0, 0))
    s.widget(b).set_bounds(at(10, 0))
    s.widget(c).set_bounds(at(0, 2))
    println "nothing focused yet:", s.focused_id() == tui.NoWidget
    _ := s.focus(a)
    println "focused a:", s.focused_id() == a, "can focus b:", s.can_focus(b)
    _ := s.focus_right()
    println "right:", s.focused_id() == b
    _ := s.focus_left()
    _ := s.focus_down()
    println "down:", s.focused_id() == c
    _ := s.focus_up()
    _ := s.focus_next()
    _ := s.focus_prev()
    println "after next and prev:", s.focused_id() == a
    _ := s.push_focus(c)
    _ := s.pop_focus()
    println "pop goes back:", s.focused_id() == a, "stack:", s.focus_stack.Len()
    println "hit at 11,0:", s.hit_test(11, 0) == b, "nothing at 19,2:", s.hit_test(19, 2) == tui.RootId

    mut layer := Vector {} as Vector<int>
    layer.push(c)
    s.raise(layer)
    println "raised takes focus:", s.focused_id() == c
    s.unraise(layer)
    s.raise_subtree(b)
    s.unraise_subtree(b)

    s.set_keymap(tui.NewDefaultKeymap())
    println "posted:", s.post(key(term.KeyTab))
    mut ev := tui.Event {}
    if s.next_event(ev):
        println "consumed:", s.dispatch(ev)
    end
    s.invalidate(a)
    s.invalidate_subtree(tui.RootId)
    s.resize(22, 3)
    s.fit_root()
    s.draw()
    s.present()
    println "|" + s.buffer.row_text(0) + "|"
    println "|" + s.buffer.row_text(2) + "|"
    println "widgets:", s.tree.count(), "dirty:", s.dirty, "focused bounds width:", s.focused.bounds().width
    println "root covers", s.root.bounds().width, "x", s.root.bounds().height, "glyphs unicode:", s.glyphs == tui.GlyphPolicy.Unicode
    _ := s.events
    _ := s.keymap
    s.stop()
end
