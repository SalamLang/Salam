import term
import tui

func at(x: int, y: int): tui.Rect:
    ret tui.Rect { x = x, y = y, width = 8, height = 1 }
end

func key(code: int): tui.Event:
    ret tui.Event { kind = tui.KeyEvent, key = term.Key { code = code } }
end

func main:
    mut s := tui.NewScreen(tui.BaseWidget {}, 20, 3)
    defer s.Close()
    a := s.Add(tui.RootId, tui.NewButton("A") as dyn tui.Widget)
    b := s.Add(tui.RootId, tui.NewButton("B") as dyn tui.Widget)
    c := s.Add(tui.RootId, tui.NewButton("C") as dyn tui.Widget)
    s.Widget(a).SetBounds(at(0, 0))
    s.Widget(b).SetBounds(at(10, 0))
    s.Widget(c).SetBounds(at(0, 2))
    println "nothing focused yet:", s.FocusedId() == tui.NoWidget
    _ := s.Focus(a)
    println "focused a:", s.FocusedId() == a, "can focus b:", s.CanFocus(b)
    _ := s.FocusRight()
    println "right:", s.FocusedId() == b
    _ := s.FocusLeft()
    _ := s.FocusDown()
    println "down:", s.FocusedId() == c
    _ := s.FocusUp()
    _ := s.FocusNext()
    _ := s.FocusPrev()
    println "after next and prev:", s.FocusedId() == a
    _ := s.PushFocus(c)
    _ := s.PopFocus()
    println "pop goes back:", s.FocusedId() == a, "stack:", s.focus_stack.Len()
    println "hit at 11,0:", s.HitTest(11, 0) == b, "nothing at 19,2:", s.HitTest(19, 2) == tui.RootId

    mut layer := Vector {} as Vector<int>
    layer.Push(c)
    s.Raise(layer)
    println "raised takes focus:", s.FocusedId() == c
    s.Unraise(layer)
    s.RaiseSubtree(b)
    s.UnraiseSubtree(b)

    s.SetKeymap(tui.NewDefaultKeymap())
    println "posted:", s.Post(key(term.KeyTab))
    mut ev := tui.Event {}
    if s.NextEvent(ev):
        println "consumed:", s.Dispatch(ev)
    end
    s.Invalidate(a)
    s.InvalidateSubtree(tui.RootId)
    s.Resize(22, 3)
    s.FitRoot()
    s.Draw()
    s.Present()
    println "|" + s.buffer.RowText(0) + "|"
    println "|" + s.buffer.RowText(2) + "|"
    println "widgets:", s.tree.Count(), "dirty:", s.dirty, "focused bounds width:", s.focused.Bounds().width
    println "root covers", s.root.Bounds().width, "x", s.root.Bounds().height, "glyphs unicode:", s.glyphs == tui.GlyphPolicy.Unicode
    _ := s.events
    _ := s.keymap
    s.Stop()
end
