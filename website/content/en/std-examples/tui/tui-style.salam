import str
import tui

func show(seq: str): str:
    ret str.Replace(seq, "\x1b", "ESC")
end

func main:
    println show(tui.FgSeq(tui.Red)), show(tui.BgSeq(tui.Blue))
    orange := tui.Color.Rgb(255, 128, 0)
    println "truecolor:", show(tui.FgSeqAt(orange, tui.ColorTier.TrueColor))
    println "256 colors:", show(tui.FgSeqAt(orange, tui.ColorTier.Indexed256))
    println "16 colors:", show(tui.BgSeqAt(orange, tui.ColorTier.Ansi16))
    println "no color:", show(tui.FgSeqAt(orange, tui.ColorTier.Off))
    println "lowered:", tui.Lower(tui.Color.Indexed(196), tui.ColorTier.Ansi16) == tui.BrightRed
    println "palette:", tui.Black != tui.White, tui.Green != tui.BrightGreen, tui.Yellow != tui.Magenta, tui.Cyan != tui.BrightCyan
    println "bright:", tui.BrightBlack != tui.BrightYellow, tui.BrightBlue != tui.BrightMagenta, tui.BrightWhite != tui.Color.Default
    println "terminal tier known:", tui.DetectTier() == tui.DetectTier()

    base := tui.Style { fg = tui.Green, bold = true }
    over := tui.Style { bg = tui.Black, underline = true }
    both := tui.StyleMerge(base, over)
    println "merged keeps bold:", both.bold, "and underline:", both.underline
    println "equal to default:", tui.StyleEq(tui.StyleDefault, tui.Style {})
    println "on:", show(tui.StyleSgr(both, tui.ColorTier.Ansi16)), "off:", show(tui.StyleSgrOff(both, tui.ColorTier.Ansi16))
    println "frame inset:", tui.BorderInset(tui.BorderStyle.Single), tui.BorderInset(tui.BorderStyle.None)
    println "styles built:", tui.SgrBuilds() > 0
    _ := tui.Style { dim = true, italic = true, reverse = true }
end
