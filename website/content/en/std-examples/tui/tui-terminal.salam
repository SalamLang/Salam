import term
import tui

mut seconds := 0

struct Clock:
    pub use tui.BaseWidget

    pub func Render(buf: tui.Buffer, bounds: tui.Rect):
        buf.PutStr(bounds.x + 1, bounds.y, "running for " + seconds + "s, q quits", tui.StyleDefault)
    end

    pub func HandleEvent(event: tui.Event): bool:
        if event.IsChar("q"):
            ret false
        end
        ret event.kind == tui.MouseEvent
    end
end

func main:
    if not term.IsTerminal():
        printerrln "needs a terminal"
        ret 1
    end
    mut screen := tui.NewTerminalScreen(Clock {})
    screen.tick_ms = 1000
    screen.mouse = true
    screen.mouse_motion = false
    screen.SetGlyphs(tui.GlyphPolicy.Unicode)
    screen.Start()
    defer screen.Close()
    screen.RunWithTick((): seconds++ end)
    println "polled every", tui.PollMs, "ms, queue of", tui.EventCapacity, "running:", screen.running
    ret 0
end
