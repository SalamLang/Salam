import term
import tui

mut seconds := 0

struct Clock:
    pub use tui.BaseWidget

    pub func render(buf: tui.Buffer, bounds: tui.Rect):
        buf.put_str(bounds.x + 1, bounds.y, "running for " + seconds + "s, q quits", tui.StyleDefault)
    end

    pub func handle_event(event: tui.Event): bool:
        if event.is_char("q"):
            ret false
        end
        ret event.kind == tui.MouseEvent
    end
end

func main:
    if not term.IsTerminal():
        printerrln "needs a terminal"
        ret 1
    end
    mut screen := tui.NewTerminalScreen(Clock {})
    screen.tick_ms = 1000
    screen.mouse = true
    screen.mouse_motion = false
    screen.set_glyphs(tui.GlyphPolicy.Unicode)
    screen.start()
    defer screen.Close()
    screen.run_with_tick((): seconds++ end)
    println "polled every", tui.PollMs, "ms, queue of", tui.EventCapacity, "running:", screen.running
    ret 0
end
