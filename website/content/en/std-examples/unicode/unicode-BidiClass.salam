import unicode

func main:
    println unicode.BidiClass(65) == unicode.BcL
    println unicode.BidiClass(1588) == unicode.BcAL
    println unicode.BidiClass(1488) == unicode.BcR
    println unicode.BidiClass(1776) == unicode.BcEN, unicode.BidiClass(1632) == unicode.BcAN
    println unicode.PairedBracketType(40) == unicode.PbtOpen, unicode.PairedBracketType(41) == unicode.PbtClose
    println unicode.PairedBracket(40), unicode.PairedBracket(65)
end
