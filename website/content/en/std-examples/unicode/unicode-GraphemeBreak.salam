import unicode

func main:
    println unicode.GraphemeBreak(1614) == unicode.GcbExtend
    println unicode.GraphemeBreak(8205) == unicode.GcbZWJ
    println unicode.GraphemeBreak(128512) == unicode.GcbExtendedPictographic
    println unicode.GraphemeBreak(10), unicode.GraphemeBreak(65)
    println unicode.ConjunctBreak(2325) == unicode.IncbConsonant, unicode.ConjunctBreak(2381) == unicode.IncbLinker
end
