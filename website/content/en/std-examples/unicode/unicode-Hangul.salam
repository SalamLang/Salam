import unicode

func main:
    lead := 18
    vowel := 0
    tail := 4
    syllable := unicode.HangulSBase + (lead * unicode.HangulVCount + vowel) * unicode.HangulTCount + tail
    println syllable
    println unicode.HangulNCount, unicode.HangulSCount
    println unicode.HangulLBase, unicode.HangulVBase, unicode.HangulTBase
    println unicode.HangulLCount
end
