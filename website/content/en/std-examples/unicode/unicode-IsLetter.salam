import unicode

func main:
    println unicode.IsLetter(1588), unicode.IsAlphabetic(1614), unicode.IsLetter(1614)
    println unicode.IsUpper(915), unicode.IsLower(947), unicode.IsTitle(453)
    println unicode.IsMark(1614), unicode.IsDigit(1776), unicode.IsNumber(8544), unicode.IsDigit(8544)
    println unicode.IsAlnum(1776), unicode.IsPunct(1548), unicode.IsSymbol(65020)
    println unicode.IsSpace(12288), unicode.IsControl(10), unicode.IsFormat(8204), unicode.IsJoinControl(8204)
end
