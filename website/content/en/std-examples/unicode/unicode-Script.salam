import unicode

func main:
    each c in [65, 1588, 945, 20013, 12354, 1776, 1614]:
        println c, unicode.ScriptName(c)
    end
    println unicode.Script(1588) == unicode.ScriptArabic, unicode.Script(65) == unicode.ScriptLatin
    println unicode.Script(66464) == unicode.ScriptOldPersian, unicode.ScriptName(66464)
end
