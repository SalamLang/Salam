import wire

interface Greeter:
    func Hello(): str
end

struct English:
    pub func Hello(): str:
        ret "hello"
    end
end

func main:
    c := wire.New()
    wire.Provide(c, "English", "", English {}, (_c: wire.Container): ret English {} end)
    wire.Bind(c, "Greeter", "English")
    mut g := English {}
    if wire.Get(c, "Greeter", g):
        println g.Hello()
    end
    wire.Close(c)
end
