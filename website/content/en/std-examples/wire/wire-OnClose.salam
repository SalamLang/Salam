import wire

struct Conn:
    pub id: int = 0
end

func main:
    c := wire.New()
    wire.Provide(c, "Conn", "", Conn {}, (_c: wire.Container): ret Conn { id = 7 } end)
    wire.OnClose(c, "Conn", Conn {}, (v: Conn): println "closing", v.id end)
    mut x := Conn {}
    _ok := wire.Get(c, "Conn", x)
    wire.Close(c)
end
