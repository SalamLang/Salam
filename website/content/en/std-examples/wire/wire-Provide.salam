import wire

func main:
    c := wire.New()
    wire.Provide(c, "Base", "", 0, (_c: wire.Container): ret 10 end)
    wire.Provide(c, "Double", "Base", 0, (cx: wire.Container):
        mut b := 0
        _ok := wire.Get(cx, "Base", b)
        ret b * 2
    end)
    mut d := 0
    if wire.Get(c, "Double", d):
        println d
    end
    wire.Close(c)
end
