واردسازی عربی

تابع ریشه:
    نوشته‌ها := ["علی رضایی"، "علي رضايي"، "عـلی رضایی"، "مریم احمدی"، "مريم أحمدي"، "سارا کریمی"]
    ناپایا دیده‌ها := نگاشت {} برگردان نگاشت<رشته، رشته>
    دیرکن دیده‌ها.آزادکن()
    هر نام در نوشته‌ها:
        کلید := عربی.کلید جستجو(نام)
        اگر دیده‌ها.دارد(کلید):
            سرچاپ "تکراری:"، نام، "همان"، دیده‌ها.بگیر(کلید)، "است"
        وگرنه:
            دیده‌ها.درج(کلید، نام)
        پایان
    پایان
    سرچاپ دیده‌ها.اندازه()، "نفر متفاوت"
پایان
