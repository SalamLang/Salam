واردسازی عربی
واردسازی رشته

تابع ریشه:
    عنوان‌ها := ["کتاب آموزش برنامه‌نویسی"، "تاریخ ایران"، "دستور زبان فارسی"، "مدرسهٔ عشق"]
    ناپایا کلیدها := وکتور {} برگردان وکتور<رشته>
    دیرکن کلیدها.آزادکن()
    هر ع در عنوان‌ها:
        کلیدها.بیفزا(عربی.کلید جستجو(ع))
    پایان
    هر پرسش در ["كتاب"، "برنامه نویسی"، "ايران"، "مدرسة"، "فارسي"]:
        ک := عربی.کلید جستجو(پرسش)
        ناپایا یافته‌ها := ۰
        هر ش، کلید در کلیدها:
            اگر رشته.شامل است(کلید، ک):
                سرچاپ "[" + پرسش + "]"، "پیدا شد:"، عنوان‌ها[ش]
                یافته‌ها += ۱
            پایان
        پایان
        اگر یافته‌ها == ۰:
            سرچاپ "[" + پرسش + "]"، "چیزی پیدا نشد"
        پایان
    پایان
پایان
