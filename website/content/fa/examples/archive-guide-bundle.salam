واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    صفحه اصلی := فشرده سازی.بافر از رشته("<html><body><h1>Hello</h1><p>Hello again, hello once more.</p></body></html>\n")
    سبک := فشرده سازی.بافر از رشته("body { margin: 0; }\nh1 { margin: 0; }\np { margin: 0; }\n")
    نشان := فشرده سازی.فشرده سازی جی زیپ رشته("pretend this is an image that is already compressed")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("site/"، پوچ، ۰، ۰))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("site/index.html"، صفحه اصلی.data، صفحه اصلی.len، ۸))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("site/style.css"، سبک.data، سبک.len، ۸))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("site/logo.bin"، نشان.data، نشان.len، ۰))
    اگر وارونه بایگانی.ساخت پرونده زیپ(پرونده‌ها، "site.zip"):
        سرچاپ "نوشتن site.zip نشد"
        برگشت ۱
    پایان
    ناپایا خوب := نادرست
    ز := بایگانی.خواندن پرونده دودویی("site.zip"، خوب)
    ناپایا فهرست := بایگانی.فهرست زیپ(ز.data، ز.len)
    هر م در فهرست:
        اگر م.is_dir:
            سرچاپ م.name، "(پوشه)"
        وگرنه:
            سرچاپ م.name، م.size، "->"، م.compressed_size، "روش"، م.method
        پایان
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    برگشت ۰
پایان
