واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    الف := فشرده سازی.بافر از رشته("first file, stored as it is\n")
    ب := فشرده سازی.بافر از رشته("second file, a little longer than the first one\n")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("a.txt"، الف.داده، الف.طول، ۰))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("b.txt"، ب.داده، ب.طول، ۰))
    ز := بایگانی.ساخت زیپ(پرونده‌ها)

    پ := ز.داده برگردان طبیعی۸*
    پ[۴۰] = ((پ[۴۰] برگردان صحیح) ^ ۱) برگردان طبیعی۸

    ناپایا فهرست := بایگانی.فهرست زیپ(ز.داده، ز.طول)
    ناپایا خوب := نادرست
    هر م در فهرست:
        داده := بایگانی.استخراج با نام از زیپ(ز.داده، ز.طول، م.نام، خوب)
        درست‌است := فشرده سازی.چک جمع سی آر سی بافر(داده) == م.چک‌جمع
        سرچاپ م.نام، "extracted:"، خوب، "checksum matches:"، درست‌است
    پایان
    بایگانی.آزادسازی فهرست(فهرست)

    ناپایا آر‌پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده آر ای آر>
    آر‌پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر("a.txt"، الف.داده، الف.طول، نادرست))
    ر := بایگانی.ساخت آر ای آر(آر‌پرونده‌ها)
    ک := ر.داده برگردان طبیعی۸*
    ک[ر.طول - ۱۲] = ((ک[ر.طول - ۱۲] برگردان صحیح) ^ ۱) برگردان طبیعی۸
    ناپایا وضعیت := ۰
    _ := بایگانی.استخراج آر ای آر(ر.داده، ر.طول، "a.txt"، ۰، وضعیت)
    سرچاپ "rar:"، بایگانی.متن وضعیت آر ای آر(وضعیت)
پایان
