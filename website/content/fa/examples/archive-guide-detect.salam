واردسازی بایگانی
واردسازی فشرده سازی

تابع قالب بایگانی(ب: فشرده سازی.بافر بایت): رشته:
    اگر ب.طول >= ۴ و فشرده سازی.دریافت بایت(ب، ۰) == ۸۰ و فشرده سازی.دریافت بایت(ب، ۱) == ۷۵ و فشرده سازی.دریافت بایت(ب، ۲) == ۳ و فشرده سازی.دریافت بایت(ب، ۳) == ۴:
        برگشت "zip"
    پایان
    اگر ب.طول >= ۲ و فشرده سازی.دریافت بایت(ب، ۰) == ۳۱ و فشرده سازی.دریافت بایت(ب، ۱) == ۱۳۹:
        برگشت "gzip"
    پایان
    اگر بایگانی.آر ای آر است(ب.داده، ب.طول):
        برگشت "rar"
    پایان
    اگر ب.طول >= ۲۶۲ و فشرده سازی.دریافت بایت(ب، ۲۵۷) == ۱۱۷ و فشرده سازی.دریافت بایت(ب، ۲۵۸) == ۱۱۵ و فشرده سازی.دریافت بایت(ب، ۲۵۹) == ۱۱۶ و فشرده سازی.دریافت بایت(ب، ۲۶۰) == ۹۷ و فشرده سازی.دریافت بایت(ب، ۲۶۱) == ۱۱۴:
        برگشت "tar"
    پایان
    برگشت "ناشناخته"
پایان

تابع شمار ورودی‌ها(ب: فشرده سازی.بافر بایت): صحیح:
    گ := قالب بایگانی(ب)
    اگر گ == "zip": برگشت بایگانی.فهرست زیپ(ب.داده، ب.طول).طول() پایان
    اگر گ == "tar": برگشت بایگانی.فهرست تار(ب.داده، ب.طول).طول() پایان
    اگر گ == "rar": برگشت بایگانی.فهرست آر ای آر(ب.داده، ب.طول).طول() پایان
    اگر گ == "gzip":
        ناپایا خوب := نادرست
        درون := فشرده سازی.کدگشایی جی زیپ بافر(ب، خوب)
        اگر خوب: برگشت شمار ورودی‌ها(درون) پایان
    پایان
    برگشت ۰
پایان

تابع ریشه:
    یادداشت := فشرده سازی.بافر از رشته("یک یادداشت کوتاه\n")
    ناپایا زیپی := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    زیپی.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("note.txt"، یادداشت.داده، یادداشت.طول، ۸))
    ناپایا تاری := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    تاری.بیفزا(بایگانی.ساخت ورودی پرونده تار("note.txt"، یادداشت.داده، یادداشت.طول، نادرست))
    تار := بایگانی.ساخت تار(تاری)
    نمونه‌ها := [بایگانی.ساخت زیپ(زیپی)، تار، فشرده سازی.فشرده سازی جی زیپ بافر(تار)، یادداشت]
    هر ن در نمونه‌ها:
        سرچاپ قالب بایگانی(ن)، ن.طول، "بایت،"، شمار ورودی‌ها(ن)، "ورودی"
    پایان
پایان
