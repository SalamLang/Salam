واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    الف := فشرده سازی.بافر از رشته("پرونده‌ی نخست\n")
    ب := فشرده سازی.بافر از رشته("پرونده‌ی دوم\n")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("docs/a.txt"، الف.داده، الف.طول، ۸))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("docs/deep/b.txt"، ب.داده، ب.طول، ۸))
    ز := بایگانی.ساخت زیپ(پرونده‌ها)
    سرچاپ "همه استخراج شد:"، بایگانی.استخراج همه از زیپ(ز.داده، ز.طول، "out")
    ناپایا خوب := نادرست
    خوانده := بایگانی.خواندن پرونده دودویی("out/docs/deep/b.txt"، خوب)
    چاپ "out/docs/deep/b.txt:"، فشرده سازی.بافر به رشته(خوانده)

    _ := بایگانی.استخراج با نام از زیپ(ز.داده، ز.طول، "docs/c.txt"، خوب)
    سرچاپ "docs/c.txt پیدا شد:"، خوب

    ناپایا بدخواه := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    بدخواه.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("../escape.txt"، الف.داده، الف.طول، ۰))
    بدخواه.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("safe.txt"، الف.داده، الف.طول، ۰))
    زب := بایگانی.ساخت زیپ(بدخواه)
    سرچاپ "همه استخراج شد:"، بایگانی.استخراج همه از زیپ(زب.داده، زب.طول، "out2")
    _ := بایگانی.خواندن پرونده دودویی("escape.txt"، خوب)
    سرچاپ "escape.txt نوشته شد:"، خوب
    _ := بایگانی.خواندن پرونده دودویی("out2/safe.txt"، خوب)
    سرچاپ "out2/safe.txt نوشته شد:"، خوب
پایان
