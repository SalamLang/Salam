واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    یادداشت := فشرده سازی.بافر از رشته("a log line that repeats, a log line that repeats, a log line that repeats\n")
    بایگانی.نوشتن پرونده دودویی از بافر("note.txt"، یادداشت)

    سرچاپ "gzip a file:"، بایگانی.فشرده سازی پرونده جی زیپ("note.txt"، "note.txt.gz")
    سرچاپ "gunzip it:"، بایگانی.کدگشایی پرونده جی زیپ("note.txt.gz"، "note-copy.txt")
    ناپایا خوب := نادرست
    رونوشت := بایگانی.خواندن پرونده دودویی("note-copy.txt"، خوب)
    سرچاپ "same bytes:"، فشرده سازی.برابری بافر(رونوشت، یادداشت)

    بسته‌شده := فشرده سازی.فشرده سازی جی زیپ بافر(یادداشت)
    سرچاپ "in memory:"، یادداشت.طول، "bytes become"، بسته‌شده.طول
    برگشتی := فشرده سازی.کدگشایی جی زیپ بافر(بسته‌شده، خوب)
    سرچاپ "round trip:"، خوب، فشرده سازی.برابری بافر(برگشتی، یادداشت)

    پ := بسته‌شده.داده برگردان طبیعی۸*
    پ[بسته‌شده.طول / ۲] = ((پ[بسته‌شده.طول / ۲] برگردان صحیح) ^ ۱) برگردان طبیعی۸
    _ := فشرده سازی.کدگشایی جی زیپ بافر(بسته‌شده، خوب)
    سرچاپ "damaged copy accepted:"، خوب

    سقف := فشرده سازی.فشرده سازی جی زیپ بافر(یادداشت)
    _ := فشرده سازی.کدگشایی جی زیپ با سقف(سقف.داده، سقف.طول، ۱۰، خوب)
    سرچاپ "over a 10 byte limit accepted:"، خوب
پایان
