واردسازی بایگانی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده("notes/"، پوچ، 0، درست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده("notes/a.txt"، "alpha alpha alpha" برگردان تهی*، 17، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده("b.txt"، "bravo" برگردان تهی*، 5، نادرست))

    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam-guide-open")
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه)
    مسیر := مسیر پرونده.پیوند(پوشه، "demo.tar.gz")
    سرچاپ "ساخت:"، بایگانی.متن وضعیت بایگانی(بایگانی.ساخت بایگانی(مسیر، پرونده‌ها))
    پرونده‌ها.آزادکن()

    ناپایا وضعیت := 0
    ناپایا ورودی‌ها := بایگانی.فهرست پرونده بایگانی(مسیر، ""، وضعیت)
    سرچاپ "فهرست:"، بایگانی.متن وضعیت بایگانی(وضعیت)
    هر عنصر در ورودی‌ها:
        سرچاپ " "، عنصر.نام، عنصر.اندازه
    پایان
    بایگانی.آزادسازی فهرست(ورودی‌ها)

    خروجی_مقدار := مسیر پرونده.پیوند(پوشه، "out")
    شمار_بایت := بایگانی.استخراج پرونده بایگانی(مسیر، خروجی_مقدار، ""، وضعیت)
    سرچاپ "استخراج:"، شمار_بایت، بایگانی.متن وضعیت بایگانی(وضعیت)

    ناپایا بایگانی_داده := بایگانی.بازکردن پرونده بایگانی(مسیر، "")
    سرچاپ بایگانی.نام قالب(بایگانی_داده.قالب)، بایگانی_داده.وضعیت
    ناپایا محدودیت‌ها := بایگانی.سقف های پیش فرض()
    محدودیت‌ها.بیشینه مدخل = 2
    بایگانی.تنظیم سقف ها(بایگانی_داده، محدودیت‌ها)
    سرچاپ "محدود:"، بایگانی.استخراج همه از بایگانی(بایگانی_داده، مسیر پرونده.پیوند(پوشه، "tight"))، بایگانی.متن وضعیت بایگانی(بایگانی_داده.وضعیت)
    بایگانی.بستن بایگانی(بایگانی_داده)

    گمشده := بایگانی.استخراج پرونده بایگانی(مسیر پرونده.پیوند(پوشه، "none.zip")، خروجی_مقدار، ""، وضعیت)
    سرچاپ "ناموجود:"، گمشده، بایگانی.متن وضعیت بایگانی(وضعیت)

    ناپایا کد := 0
    تا کد کوچکتربرابر 14:
        سرچاپ کد، بایگانی.متن وضعیت بایگانی(کد)
        کد++
    پایان
    سیستم عامل.حذف همه(پوشه)
پایان
