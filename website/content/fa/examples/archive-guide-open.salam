واردسازی بایگانی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    files.بیفزا(بایگانی.ساخت ورودی پرونده("notes/"، پوچ، 0، درست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده("notes/a.txt"، "alpha alpha alpha" برگردان تهی*، 17، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده("b.txt"، "bravo" برگردان تهی*، 5، نادرست))

    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam-guide-open")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    path := مسیر پرونده.پیوند(dir، "demo.tar.gz")
    سرچاپ "ساخت:"، بایگانی.متن وضعیت بایگانی(بایگانی.ساخت بایگانی(path، files))
    files.آزادکن()

    ناپایا status := 0
    ناپایا entries := بایگانی.فهرست پرونده بایگانی(path، ""، status)
    سرچاپ "فهرست:"، بایگانی.متن وضعیت بایگانی(status)
    هر e در entries:
        سرچاپ " "، e.نام، e.اندازه
    پایان
    بایگانی.آزادسازی فهرست(entries)

    out := مسیر پرونده.پیوند(dir، "out")
    n := بایگانی.استخراج پرونده بایگانی(path، out، ""، status)
    سرچاپ "استخراج:"، n، بایگانی.متن وضعیت بایگانی(status)

    ناپایا arc := بایگانی.بازکردن پرونده بایگانی(path، "")
    سرچاپ بایگانی.نام قالب(arc.قالب)، arc.وضعیت
    ناپایا limits := بایگانی.سقف های پیش فرض()
    limits.بیشینه مدخل = 2
    بایگانی.تنظیم سقف ها(arc، limits)
    سرچاپ "محدود:"، بایگانی.استخراج همه از بایگانی(arc، مسیر پرونده.پیوند(dir، "tight"))، بایگانی.متن وضعیت بایگانی(arc.وضعیت)
    بایگانی.بستن بایگانی(arc)

    missing := بایگانی.استخراج پرونده بایگانی(مسیر پرونده.پیوند(dir، "none.zip")، out، ""، status)
    سرچاپ "ناموجود:"، missing، بایگانی.متن وضعیت بایگانی(status)

    ناپایا code := 0
    تا code کوچکتربرابر 14:
        سرچاپ code، بایگانی.متن وضعیت بایگانی(code)
        code++
    پایان
    سیستم عامل.حذف همه(dir)
پایان
