تابع رقم(ک: صحیح): صحیح:
    اگر ک >= ۴۸ و ک <= ۵۷:
        برگشت ک - ۴۸
    پایان
    اگر ک >= ۹۷ و ک <= ۱۰۲:
        برگشت ک - ۸۷
    پایان
    برگشت -۱
پایان

تابع از هگز(متن: رشته): فشرده سازی.بافر بایت:
    ناپایا خروجی := فشرده سازی.بافر بایت جدید()
    بایت‌ها := متن برگردان طبیعی۸*
    ناپایا بالا := -۱
    تکرار متن.طول() در ای:
        م := رقم(بایت‌ها[ای] برگردان صحیح)
        اگر م < ۰:
            گذر
        پایان
        اگر بالا < ۰:
            بالا = م
        وگرنه:
            فشرده سازی.افزودن بایت(خروجی، بالا * ۱۶ + م)
            بالا = -۱
        پایان
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    ر := از هگز(نمونه)
    ناپایا قفل‌شده := بایگانی.بازکردن آر ای آر(ر.داده، ر.طول، "")
    ناپایا نام‌ها := بایگانی.مدخل‌های آر ای آر(قفل‌شده)
    سرچاپ نام‌ها.طول()، بایگانی.متن وضعیت آر ای آر(قفل‌شده.وضعیت)
    بایگانی.آزادسازی فهرست(نام‌ها)

    ناپایا اشتباه := بایگانی.بازکردن آر ای آر(ر.داده، ر.طول، "guess")
    نام‌ها = بایگانی.مدخل‌های آر ای آر(اشتباه)
    سرچاپ نام‌ها.طول()، اشتباه.وضعیت == بایگانی.آر ای آر گذرواژه اشتباه
    بایگانی.آزادسازی فهرست(نام‌ها)

    ناپایا باز := بایگانی.بازکردن آر ای آر(ر.داده، ر.طول، "secret")
    نام‌ها = بایگانی.مدخل‌های آر ای آر(باز)
    هر م در نام‌ها:
        داده := بایگانی.خواندن از آر ای آر(باز، م.نام، ۰)
        سرچاپ م.نام، م.اندازه، داده.طول، بایگانی.متن وضعیت آر ای آر(باز.وضعیت)
    پایان
    بایگانی.آزادسازی فهرست(نام‌ها)
    سرچاپ بایگانی.خواندن همه از آر ای آر(باز، "unlocked")، بایگانی.متن وضعیت آر ای آر(باز.وضعیت)
پایان
