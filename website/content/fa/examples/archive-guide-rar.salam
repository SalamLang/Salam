تابع رقم(ک: صحیح): صحیح:
    اگر ک >= ۴۸ و ک <= ۵۷:
        برگشت ک - ۴۸
    پایان
    اگر ک >= ۹۷ و ک <= ۱۰۲:
        برگشت ک - ۸۷
    پایان
    برگشت -۱
پایان

تابع از هگز(متن: رشته): فشرده سازی.بافر بایت:
    ناپایا خروجی := فشرده سازی.بافر بایت جدید()
    بایت‌ها := متن برگردان طبیعی۸*
    ناپایا بالا := -۱
    تکرار متن.طول() در ای:
        م := رقم(بایت‌ها[ای] برگردان صحیح)
        اگر م < ۰:
            گذر
        پایان
        اگر بالا < ۰:
            بالا = م
        وگرنه:
            فشرده سازی.افزودن بایت(خروجی، بالا * ۱۶ + م)
            بالا = -۱
        پایان
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    ر := از هگز(نمونه)
    سرچاپ بایگانی.آر ای آر است(ر.داده، ر.طول)
    ناپایا فهرست := بایگانی.فهرست آر ای آر(ر.داده، ر.طول)
    هر م در فهرست:
        سرچاپ م.نام، م.اندازه، م.اندازه فشرده
    پایان
    بایگانی.آزادسازی فهرست(فهرست)

    ناپایا وضعیت := ۰
    ب := بایگانی.استخراج آر ای آر(ر.داده، ر.طول، "b.txt"، ۰، وضعیت)
    سرچاپ بایگانی.متن وضعیت آر ای آر(وضعیت)، ب.طول
پایان
