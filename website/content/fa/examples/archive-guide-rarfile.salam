// زبان: فارسی
واردسازی بایگانی
واردسازی سیستم عامل

تابع ریشه:
    body := "read from a RAR on disk, entry by entry\n"
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده آر ای آر>
    files.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر("notes/a.txt"، body برگردان تهی*، body.طول()، نادرست))
    بایگانی.ساخت پرونده آر ای آر(files، "made.rar")
    files.آزادکن()

    ناپایا rf := بایگانی.بازکردن پرونده آر ای آر("made.rar")
    سرچاپ rf.وضعیت برابر بایگانی.آر ای آر موفق، rf.جریانی
    ناپایا entries := بایگانی.مدخل های پرونده آر ای آر(rf)
    هر e در entries:
        سرچاپ e.نام، e.اندازه
    پایان
    بایگانی.آزادسازی فهرست(entries)

    سرچاپ بایگانی.استخراج از پرونده آر ای آر به پرونده(rf، "notes/a.txt"، "a.out"، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴) برابر بایگانی.آر ای آر موفق
    سرچاپ بایگانی.استخراج از پرونده آر ای آر به پرونده(rf، "notes/a.txt"، "a.out"، 5 برگردان صحیح۶۴، 0 برگردان صحیح۶۴) برابر بایگانی.آر ای آر بیش از حد بزرگ
    بایگانی.بستن پرونده آر ای آر(rf)
    سیستم عامل.حذف("made.rar")
    سیستم عامل.حذف("a.out")
پایان
