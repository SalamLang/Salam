// زبان: فارسی
واردسازی بایگانی
واردسازی سیستم عامل

تابع ریشه:
    بدنه := "read from a RAR on disk, entry by entry\n"
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده آر ای آر>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر("notes/a.txt"، بدنه برگردان تهی*، بدنه.طول()، نادرست))
    بایگانی.ساخت پرونده آر ای آر(پرونده‌ها، "made.rar")
    پرونده‌ها.آزادکن()

    ناپایا چارچوب_خواندن := بایگانی.بازکردن پرونده آر ای آر("made.rar")
    سرچاپ چارچوب_خواندن.وضعیت برابر بایگانی.آر ای آر موفق، چارچوب_خواندن.جریانی
    ناپایا ورودی‌ها := بایگانی.مدخل های پرونده آر ای آر(چارچوب_خواندن)
    هر عنصر در ورودی‌ها:
        سرچاپ عنصر.نام، عنصر.اندازه
    پایان
    بایگانی.آزادسازی فهرست(ورودی‌ها)

    سرچاپ بایگانی.استخراج از پرونده آر ای آر به پرونده(چارچوب_خواندن، "notes/a.txt"، "a.out"، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴) برابر بایگانی.آر ای آر موفق
    سرچاپ بایگانی.استخراج از پرونده آر ای آر به پرونده(چارچوب_خواندن، "notes/a.txt"، "a.out"، 5 برگردان صحیح۶۴، 0 برگردان صحیح۶۴) برابر بایگانی.آر ای آر بیش از حد بزرگ
    بایگانی.بستن پرونده آر ای آر(چارچوب_خواندن)
    سیستم عامل.حذف("made.rar")
    سیستم عامل.حذف("a.out")
پایان
