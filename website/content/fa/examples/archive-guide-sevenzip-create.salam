// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    الف := فشرده سازی.بافر از رشته("first file\n")
    بافر_محلی := فشرده سازی.بافر از رشته("second file, a little longer\n")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("docs/"، پوچ، 0، درست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("docs/a.txt"، الف.داده، الف.طول، نادرست))
    ناپایا دومی := بایگانی.ساخت ورودی پرونده هفت زد("docs/b.txt"، بافر_محلی.داده، بافر_محلی.طول، نادرست)
    دومی.زمان تغییر = 1700000000 برگردان صحیح۶۴
    دومی.دسترسی = 420
    پرونده‌ها.بیفزا(دومی)
    ناپایا پیوند_محلی := بایگانی.ساخت ورودی پرونده هفت زد("docs/latest"، پوچ، 0، نادرست)
    پیوند_محلی.پیوند = "b.txt"
    پرونده‌ها.بیفزا(پیوند_محلی)
    بسته_شده := بایگانی.ساخت هفت زد(پرونده‌ها)
    سرچاپ بایگانی.هفت زد است(بسته_شده.داده، بسته_شده.طول)، بایگانی.ساخت پرونده هفت زد(پرونده‌ها، "made.7z")

    ناپایا ورودی‌ها := بایگانی.فهرست هفت زد(بسته_شده.داده، بسته_شده.طول)
    هر عنصر در ورودی‌ها:
        سرچاپ عنصر.نام، عنصر.اندازه، عنصر.پوشه، عنصر.نوع، عنصر.زمان تغییر
    پایان
    بایگانی.آزادسازی فهرست(ورودی‌ها)

    ناپایا موفق := نادرست
    گرفته := بایگانی.استخراج با نام از هفت زد(بسته_شده.داده، بسته_شده.طول، "docs/b.txt"، موفق)
    سرچاپ موفق، فشرده سازی.بافر به رشته(گرفته) برابر "second file, a little longer\n"
پایان
