// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    a := فشرده سازی.بافر از رشته("first file\n")
    b := فشرده سازی.بافر از رشته("second file, a little longer\n")
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("docs/"، پوچ، 0، درست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("docs/a.txt"، a.داده، a.طول، نادرست))
    ناپایا second := بایگانی.ساخت ورودی پرونده هفت زد("docs/b.txt"، b.داده، b.طول، نادرست)
    second.زمان تغییر = 1700000000 برگردان صحیح۶۴
    second.دسترسی = 420
    files.بیفزا(second)
    ناپایا link := بایگانی.ساخت ورودی پرونده هفت زد("docs/latest"، پوچ، 0، نادرست)
    link.پیوند = "b.txt"
    files.بیفزا(link)
    packed := بایگانی.ساخت هفت زد(files)
    سرچاپ بایگانی.هفت زد است(packed.داده، packed.طول)، بایگانی.ساخت پرونده هفت زد(files، "made.7z")

    ناپایا entries := بایگانی.فهرست هفت زد(packed.داده، packed.طول)
    هر e در entries:
        سرچاپ e.نام، e.اندازه، e.پوشه، e.نوع، e.زمان تغییر
    پایان
    بایگانی.آزادسازی فهرست(entries)

    ناپایا ok := نادرست
    got := بایگانی.استخراج با نام از هفت زد(packed.داده، packed.طول، "docs/b.txt"، ok)
    سرچاپ ok، فشرده سازی.بافر به رشته(got) برابر "second file, a little longer\n"
پایان
