// زبان: فارسی
// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی

پایا PART1 := """
377abcaf271c000457983ded16000000000000004a00000000000000429e4011766f6c756d65206f6e650a766f6c756d6520
74776f0a0104060001091600070b
"""

پایا PART2 := """
01000101000c1600080a014e6ded24000005011113006e006f00740065002e0074007800740000001900140a0100d9199ec4
1c70dd01150601002080a4810000
"""

تابع نیم_بایت(نویسه: صحیح): صحیح:
    اگر نویسه بزرگتربرابر 48 و نویسه کوچکتربرابر 57:
        برگشت نویسه - 48
    پایان
    اگر نویسه بزرگتربرابر 97 و نویسه کوچکتربرابر 102:
        برگشت نویسه - 87
    پایان
    برگشت -1
پایان

تابع از_شانزده(متن_نمونه: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := متن_نمونه برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار متن_نمونه.طول() در شمارنده:
        مقدار_محلی := نیم_بایت(نشانگر_بایت[شمارنده] برگردان صحیح)
        اگر مقدار_محلی کوچکتر 0:
            گذر
        پایان
        اگر بالا کوچکتر 0:
            بالا = مقدار_محلی
        وگرنه:
            فشرده سازی.افزودن بایت(بافر_محلی، بالا * 16 + مقدار_محلی)
            بالا = -1
        پایان
    پایان
    برگشت بافر_محلی
پایان

تابع ریشه:
    ناپایا جلدها := وکتور {} برگردان وکتور<فشرده سازی.بافر بایت>
    جلدها.بیفزا(از_شانزده(PART1))
    جلدها.بیفزا(از_شانزده(PART2))
    ناپایا بایگانی_داده := بایگانی.بازکردن بخش‌های هفت زد(جلدها، "")
    نام‌ها := بایگانی.مدخل‌های هفت زد(بایگانی_داده)
    سرچاپ "مدخل‌ها:"، نام‌ها.طول()، بایگانی_داده.وضعیت
    داده := بایگانی.خواندن از هفت زد(بایگانی_داده، "note.txt"، 0)
    چاپ فشرده سازی.بافر به رشته(داده)
    بایگانی.بستن هفت زد(بایگانی_داده)
    بایگانی.آزادسازی بخش‌های هفت زد(جلدها)
پایان
