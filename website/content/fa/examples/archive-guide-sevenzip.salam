// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

پایا PACKED := """
377abcaf271c0004285eeffde1000000000000002200000000000000b6539000e0009a00455d00271bca866798db2a9932
ecb108f48e70217d76d380887c03113d3cbf05381d9da1ba6b83a1a220c4656aeac3932a993abd9ea11cf8b4a761ae3af5
25cd41b942bff3ee0000000000813307ae0fd29aba3d40c090d2ff7d694d8f17af096379cb439267a35290e659701f3be3
6ecf209c510fa5d7b46a9c1bc2ee771f3e97490b78775d756e5d08a454586e1ec479608d69d1666dfa5b88efa423415340
9765eb30ad5f38ecae89e94cbd79558938ae1d384c90fe7db292aab05a6ec1eb816b7fbbeaf3ea941a1f4ff09d06216330
82fa2e2e1849c8fb9600000017064d0109809400070b01000123030101055d001000000c80ce0a01885a3c9d0000
"""

تابع nib(نویسه: صحیح): صحیح:
    اگر نویسه بزرگتربرابر 48 و نویسه کوچکتربرابر 57:
        برگشت نویسه - 48
    پایان
    اگر نویسه بزرگتربرابر 97 و نویسه کوچکتربرابر 102:
        برگشت نویسه - 87
    پایان
    برگشت -1
پایان

تابع unhex(متن_نمونه: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := متن_نمونه برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار متن_نمونه.طول() در شمارنده:
        مقدار_محلی := nib(نشانگر_بایت[شمارنده] برگردان صحیح)
        اگر مقدار_محلی کوچکتر 0:
            گذر
        پایان
        اگر بالا کوچکتر 0:
            بالا = مقدار_محلی
        وگرنه:
            فشرده سازی.افزودن بایت(بافر_محلی، بالا * 16 + مقدار_محلی)
            بالا = -1
        پایان
    پایان
    برگشت بافر_محلی
پایان

تابع ریشه:
    بسته_شده := unhex(PACKED)
    سرچاپ "بایگانی 7z:"، بایگانی.هفت زد است(بسته_شده.داده، بسته_شده.طول)

    ناپایا وضعیت := 0
    ناپایا فهرست := بایگانی.فهرست هفت زد با وضعیت(بسته_شده.داده، بسته_شده.طول، وضعیت)
    سرچاپ "مدخل‌ها:"، فهرست.طول()، بایگانی.متن وضعیت هفت زد(وضعیت)
    تکرار فهرست.طول() در شمارنده:
        عنصر := فهرست.بگیر(شمارنده)
        ناپایا گونه := "پرونده"
        اگر عنصر.پوشه:
            گونه = "پوشه"
        پایان
        سرچاپ " "، عنصر.نام، گونه، عنصر.اندازه
    پایان
    بایگانی.آزادسازی فهرست(فهرست)

    ناپایا موفق := نادرست
    متغیر_readme := بایگانی.استخراج با نام از هفت زد(بسته_شده.داده، بسته_شده.طول، "readme.txt"، موفق)
    سرچاپ "readme.txt:"، موفق، متغیر_readme.طول، "بایت"
    سقف_دار := بایگانی.استخراج با نام از هفت زد با سقف(بسته_شده.داده، بسته_شده.طول، "readme.txt"، 50، موفق)
    سرچاپ "سقف ۵۰ بایت:"، موفق، سقف_دار.طول

    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sevenzip_guide")
    سیستم عامل.حذف همه(پوشه)
    سرچاپ "استخراج شد:"، بایگانی.استخراج همه از هفت زد(بسته_شده.داده، بسته_شده.طول، پوشه)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(پوشه، "src/main.salam"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(پوشه، "empty.log"))
    سیستم عامل.حذف همه(پوشه)

    ناپایا آسیب‌دیده := فشرده سازی.کپی بافر(بسته_شده)
    فشرده سازی.تنظیم بایت(آسیب‌دیده، آسیب‌دیده.طول - 3، فشرده سازی.دریافت بایت(آسیب‌دیده، آسیب‌دیده.طول - 3) ^ 1)
    خراب := بایگانی.استخراج هفت زد(آسیب‌دیده.داده، آسیب‌دیده.طول، "readme.txt"، 0، وضعیت)
    سرچاپ "خراب:"، بایگانی.متن وضعیت هفت زد(وضعیت)، خراب.طول
پایان
