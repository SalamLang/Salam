// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

پایا PACKED := """
377abcaf271c0004285eeffde1000000000000002200000000000000b6539000e0009a00455d00271bca866798db2a9932
ecb108f48e70217d76d380887c03113d3cbf05381d9da1ba6b83a1a220c4656aeac3932a993abd9ea11cf8b4a761ae3af5
25cd41b942bff3ee0000000000813307ae0fd29aba3d40c090d2ff7d694d8f17af096379cb439267a35290e659701f3be3
6ecf209c510fa5d7b46a9c1bc2ee771f3e97490b78775d756e5d08a454586e1ec479608d69d1666dfa5b88efa423415340
9765eb30ad5f38ecae89e94cbd79558938ae1d384c90fe7db292aab05a6ec1eb816b7fbbeaf3ea941a1f4ff09d06216330
82fa2e2e1849c8fb9600000017064d0109809400070b01000123030101055d001000000c80ce0a01885a3c9d0000
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع ریشه:
    packed := unhex(PACKED)
    سرچاپ "بایگانی 7z:"، بایگانی.هفت زد است(packed.داده، packed.طول)

    ناپایا status := 0
    ناپایا list := بایگانی.فهرست هفت زد با وضعیت(packed.داده، packed.طول، status)
    سرچاپ "مدخل‌ها:"، list.طول()، بایگانی.متن وضعیت هفت زد(status)
    تکرار list.طول() در i:
        e := list.بگیر(i)
        ناپایا kind := "پرونده"
        اگر e.پوشه:
            kind = "پوشه"
        پایان
        سرچاپ " "، e.نام، kind، e.اندازه
    پایان
    بایگانی.آزادسازی فهرست(list)

    ناپایا ok := نادرست
    readme := بایگانی.استخراج با نام از هفت زد(packed.داده، packed.طول، "readme.txt"، ok)
    سرچاپ "readme.txt:"، ok، readme.طول، "بایت"
    capped := بایگانی.استخراج با نام از هفت زد با سقف(packed.داده، packed.طول، "readme.txt"، 50، ok)
    سرچاپ "سقف ۵۰ بایت:"، ok، capped.طول

    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_sevenzip_guide")
    سیستم عامل.حذف همه(dir)
    سرچاپ "استخراج شد:"، بایگانی.استخراج همه از هفت زد(packed.داده، packed.طول، dir)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "src/main.salam"))، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "empty.log"))
    سیستم عامل.حذف همه(dir)

    ناپایا damaged := فشرده سازی.کپی بافر(packed)
    فشرده سازی.تنظیم بایت(damaged، damaged.طول - 3، فشرده سازی.دریافت بایت(damaged، damaged.طول - 3) ^ 1)
    broken := بایگانی.استخراج هفت زد(damaged.داده، damaged.طول، "readme.txt"، 0، status)
    سرچاپ "خراب:"، بایگانی.متن وضعیت هفت زد(status)، broken.طول
پایان
