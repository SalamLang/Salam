// زبان: فارسی
واردسازی بایگانی
واردسازی سیستم عامل

تابع ریشه:
    body := "a large file would be unpacked straight to disk\n"
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("data/log.txt"، body برگردان تهی*، body.طول()، نادرست))
    بایگانی.ساخت پرونده هفت زد(files، "made.7z")
    files.آزادکن()

    ناپایا sf := بایگانی.بازکردن پرونده هفت زد("made.7z"، "")
    ناپایا entries := بایگانی.مدخل های پرونده هفت زد(sf)
    هر e در entries:
        سرچاپ e.نام، e.اندازه
    پایان
    بایگانی.آزادسازی فهرست(entries)

    سرچاپ بایگانی.استخراج از پرونده هفت زد به پرونده(sf، "data/log.txt"، "log.out"، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴) برابر بایگانی.هفت زد موفق
    سرچاپ بایگانی.استخراج از پرونده هفت زد به پرونده(sf، "data/log.txt"، "log.out"، 10 برگردان صحیح۶۴، 0 برگردان صحیح۶۴) برابر بایگانی.هفت زد بیش از حد بزرگ
    بایگانی.بستن پرونده هفت زد(sf)
    سیستم عامل.حذف("made.7z")
    سیستم عامل.حذف("log.out")
پایان
