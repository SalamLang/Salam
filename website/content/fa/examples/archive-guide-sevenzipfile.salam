// زبان: فارسی
واردسازی بایگانی
واردسازی سیستم عامل

تابع ریشه:
    بدنه := "a large file would be unpacked straight to disk\n"
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد("data/log.txt"، بدنه برگردان تهی*، بدنه.طول()، نادرست))
    بایگانی.ساخت پرونده هفت زد(پرونده‌ها، "made.7z")
    پرونده‌ها.آزادکن()

    ناپایا پرونده_هفت := بایگانی.بازکردن پرونده هفت زد("made.7z"، "")
    ناپایا ورودی‌ها := بایگانی.مدخل های پرونده هفت زد(پرونده_هفت)
    هر عنصر در ورودی‌ها:
        سرچاپ عنصر.نام، عنصر.اندازه
    پایان
    بایگانی.آزادسازی فهرست(ورودی‌ها)

    سرچاپ بایگانی.استخراج از پرونده هفت زد به پرونده(پرونده_هفت، "data/log.txt"، "log.out"، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴) برابر بایگانی.هفت زد موفق
    سرچاپ بایگانی.استخراج از پرونده هفت زد به پرونده(پرونده_هفت، "data/log.txt"، "log.out"، 10 برگردان صحیح۶۴، 0 برگردان صحیح۶۴) برابر بایگانی.هفت زد بیش از حد بزرگ
    بایگانی.بستن پرونده هفت زد(پرونده_هفت)
    سیستم عامل.حذف("made.7z")
    سیستم عامل.حذف("log.out")
پایان
