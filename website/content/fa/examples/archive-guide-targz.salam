واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    راهنما := فشرده سازی.بافر از رشته("پشتیبان پوشه‌ی تنظیمات.\n")
    تنظیم := فشرده سازی.بافر از رشته("port = 8080\nworkers = 4\nport_admin = 8081\n")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("config"، پوچ، ۰، درست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("config/README"، راهنما.data، راهنما.len، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("config/app.conf"، تنظیم.data، تنظیم.len، نادرست))
    تار := بایگانی.ساخت تار(پرونده‌ها)
    فشرده := فشرده سازی.فشرده سازی جی زیپ بافر(تار)
    سرچاپ "tar:"، تار.len، "بایت، tar.gz:"، فشرده.len، "بایت"
    بایگانی.نوشتن پرونده دودویی از بافر("config.tar.gz"، فشرده)

    ناپایا خوب := نادرست
    خوانده := بایگانی.خواندن پرونده دودویی("config.tar.gz"، خوب)
    ساده := فشرده سازی.کدگشایی جی زیپ بافر(خوانده، خوب)
    اگر وارونه خوب:
        سرچاپ "config.tar.gz جی‌زیپ درستی نیست"
        برگشت ۱
    پایان
    ناپایا فهرست := بایگانی.فهرست تار(ساده.data، ساده.len)
    هر م در فهرست:
        سرچاپ م.name، م.size، م.is_dir
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    برنامه := بایگانی.استخراج با نام از تار(ساده.data، ساده.len، "config/app.conf"، خوب)
    چاپ فشرده سازی.بافر به رشته(برنامه)
    برگشت ۰
پایان
