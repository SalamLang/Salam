// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    متن := "سلام بایگانی، سلام بایگانی، سلام بایگانی"
    ب := فشرده سازی.بافر از رشته(متن)
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("a.txt"، ب.داده، ب.طول، 0))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("b.txt"، ب.داده، 5، 8))
    ز := بایگانی.ساخت زیپ(پرونده‌ها)
    ناپایا وضعیت := 0
    ناپایا بررسی‌شده := 0
    سالم := بایگانی.استخراج تایید شده از زیپ(ز.داده، ز.طول، "a.txt"، 0، وضعیت)
    سرچاپ وضعیت برابر بایگانی.زیپ موفق، سالم.طول، بایگانی.بررسی زیپ(ز.داده، ز.طول، بررسی‌شده)، بررسی‌شده

    نشانگر := ز.داده برگردان طبیعی۸*
    نشانگر[35] = 0x58 برگردان طبیعی۸
    خراب := بایگانی.استخراج تایید شده از زیپ(ز.داده، ز.طول، "a.txt"، 0، وضعیت)
    سرچاپ وضعیت برابر بایگانی.زیپ چک جمع ناهمخوان، خراب.طول، بایگانی.متن وضعیت زیپ(وضعیت)
    ناپایا خوب := نادرست
    ساده := بایگانی.استخراج با نام از زیپ(ز.داده، ز.طول، "a.txt"، خوب)
    سرچاپ خوب، ساده.طول
    سرچاپ بایگانی.بررسی زیپ(ز.داده، ز.طول، بررسی‌شده)، بررسی‌شده
    ناپایا شکسته := بایگانی.مدخل های خراب زیپ(ز.داده، ز.طول)
    هر م در شکسته:
        سرچاپ "خراب:"، م.نام
    پایان
    بایگانی.آزادسازی فهرست(شکسته)
    _ := بایگانی.استخراج تایید شده از زیپ(ز.داده، ز.طول، "missing.txt"، 0، وضعیت)
    سرچاپ وضعیت برابر بایگانی.زیپ یافت نشد، بایگانی.متن وضعیت زیپ(وضعیت)
پایان
