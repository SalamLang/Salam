تابع با جایزه(نمره‌ها: صحیح[۳]): صحیح[۳]:
    ناپایا خروجی := نمره‌ها
    تکرار طول(خروجی) در ش:
        خروجی[ش] += ۵
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    اصلی := [۷۰، ۸۵، ۹۰]
    ناپایا پیش‌نویس := اصلی
    پیش‌نویس[۰] = ۰
    سرچاپ اصلی، پیش‌نویس
    ارفاقی := با جایزه(اصلی)
    سرچاپ اصلی، ارفاقی
پایان
