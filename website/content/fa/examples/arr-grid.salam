تابع جمع کل(مقدارها: صحیح[]): صحیح:
    ناپایا جمع := ۰
    هر ع در مقدارها:
        جمع += ع
    پایان
    برگشت جمع
پایان

تابع ریشه:
    فروش := [
        [۱۲، ۷، ۳، ۹]،
        [۵، ۱۱، ۸، ۶]،
        [۹، ۴، ۱۰، ۲]
    ]
    شعبه‌ها := ["شمال"، "جنوب"، "شرق"]
    تکرار طول(فروش) در ر:
        سرچاپ شعبه‌ها[ر]، جمع کل(فروش[ر])
    پایان
    ناپایا روزها := ""
    تکرار طول(فروش[۰]) در س:
        ناپایا جمع := ۰
        تکرار طول(فروش) در ر:
            جمع += فروش[ر][س]
        پایان
        روزها += " " + جمع
    پایان
    سرچاپ "هر روز:" + روزها
پایان
