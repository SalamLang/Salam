تابع جایگاه(فهرست: رشته[]، خواسته: رشته): صحیح:
    هر ش، عضو در فهرست:
        اگر عضو == خواسته:
            برگشت ش
        پایان
    پایان
    برگشت -۱
پایان

تابع ریشه:
    ماه‌ها := ["فروردین"، "اردیبهشت"، "خرداد"، "تیر"، "مرداد"، "شهریور"]
    باران := [۷۸، ۶۴، ۵۱، ۳۳، ۱۲، ۴]
    ناپایا مجموع := ۰
    ناپایا پرباران := ۰
    هر ش، م در باران:
        مجموع += م
        اگر م > باران[پرباران]:
            پرباران = ش
        پایان
    پایان
    سرچاپ "مجموع:"، مجموع، "میانگین:"، مجموع / طول(باران)
    سرچاپ "پرباران‌ترین:"، ماه‌ها[پرباران]، باران[پرباران]
    سرچاپ "تیر ماه شماره‌ی"، جایگاه(ماه‌ها، "تیر") + ۱
    سرچاپ "اسفند در جایگاه"، جایگاه(ماه‌ها، "اسفند")
پایان
