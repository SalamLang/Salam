واردسازی اتمی

ناپایا گرفته‌شده := اتمی.پرچم {}
ناپایا برنده‌ها := اتمی.صحیح۶۴ {}
ناپایا بازنده‌ها := اتمی.صحیح۶۴ {}

تابع کوشش برای گرفتن():
    اگر اتمی.آزمون سپس تنظیم(گرفته‌شده):
        اتمی.افزودن(برنده‌ها، ۱)
    وگرنه:
        اتمی.افزودن(بازنده‌ها، ۱)
    پایان
پایان

تابع ریشه:
    گرفته‌شده = اتمی.پرچم جدید(نادرست)
    برنده‌ها = اتمی.صحیح۶۴ جدید(۰)
    بازنده‌ها = اتمی.صحیح۶۴ جدید(۰)
    ناپایا نخ‌ها := وکتور {} برگردان وکتور<صحیح۶۴>
    دیرکن نخ‌ها.آزادکن()
    تکرار ۸:
        نخ‌ها.بیفزا(نخ‌ساز(کوشش برای گرفتن))
    پایان
    هر ن در نخ‌ها:
        نخ‌پیوند(ن)
    پایان
    سرچاپ "برنده‌ها:"، اتمی.بارگذاری(برنده‌ها)، "بازنده‌ها:"، اتمی.بارگذاری(بازنده‌ها)
    اتمی.نابودسازی پرچم(گرفته‌شده)
    اتمی.نابودسازی صحیح۶۴(برنده‌ها)
    اتمی.نابودسازی صحیح۶۴(بازنده‌ها)
پایان
