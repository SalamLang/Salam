واردسازی اتمی

ناپایا شناسه‌ی بعدی := اتمی.صحیح۶۴ {}
ناپایا دفعات := وکتور {} برگردان وکتور<صحیح۶۴>

تابع پخش شناسه():
    تکرار ۱۰۰:
        شناسه := اتمی.افزودن(شناسه‌ی بعدی، ۱)
        دفعات.بنشان(شناسه برگردان صحیح - ۱، دفعات.بگیر(شناسه برگردان صحیح - ۱) + ۱)
    پایان
پایان

تابع ریشه:
    شناسه‌ی بعدی = اتمی.صحیح۶۴ جدید(۰)
    تکرار ۴۰۰:
        دفعات.بیفزا(۰)
    پایان
    الف := نخ‌ساز(پخش شناسه)
    ب := نخ‌ساز(پخش شناسه)
    پ := نخ‌ساز(پخش شناسه)
    ت := نخ‌ساز(پخش شناسه)
    نخ‌پیوند(الف)
    نخ‌پیوند(ب)
    نخ‌پیوند(پ)
    نخ‌پیوند(ت)
    ناپایا تکراری := ۰
    هر ع در دفعات:
        اگر ع != ۱:
            تکراری += ۱
        پایان
    پایان
    سرچاپ "آخرین شناسه:"، اتمی.بارگذاری(شناسه‌ی بعدی)
    سرچاپ "شناسه‌هایی که بیش از یک بار داده شدند:"، تکراری
    دفعات.آزادکن()
    اتمی.نابودسازی صحیح۶۴(شناسه‌ی بعدی)
پایان
