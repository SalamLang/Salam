واردسازی اتمی

ناپایا بیشترین := اتمی.صحیح۶۴ {}

تابع ثبت(مقدار: صحیح۶۴):
    ناپایا دیده‌شده := اتمی.بارگذاری(بیشترین)
    تا مقدار > دیده‌شده:
        اگر اتمی.مقایسه سپس تعویض(بیشترین، دیده‌شده، مقدار):
            برگشت
        پایان
        دیده‌شده = اتمی.بارگذاری(بیشترین)
    پایان
پایان

تابع خوانش‌های پایین():
    تکرار ۵۰۰ در ای:
        ثبت((ای * ۷ % ۹۰۰) برگردان صحیح۶۴)
    پایان
پایان

تابع خوانش‌های بالا():
    تکرار ۵۰۰ در ای:
        ثبت((ای * ۱۳ % ۱۰۰۰) برگردان صحیح۶۴)
    پایان
پایان

تابع ریشه:
    بیشترین = اتمی.صحیح۶۴ جدید(۰)
    الف := نخ‌ساز(خوانش‌های پایین)
    ب := نخ‌ساز(خوانش‌های بالا)
    نخ‌پیوند(الف)
    نخ‌پیوند(ب)
    سرچاپ "بیشترین خوانش:"، اتمی.بارگذاری(بیشترین)
    اتمی.نابودسازی صحیح۶۴(بیشترین)
پایان
