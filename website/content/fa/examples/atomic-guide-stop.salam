واردسازی اتمی
واردسازی همگام سازی

ناپایا ایست := اتمی.پرچم {}
ناپایا دورها := اتمی.صحیح۶۴ {}

تابع کارگر():
    تا وارونه اتمی.گرفتن(ایست):
        اتمی.افزودن(دورها، ۱)
        همگام سازی.خواب میلی ثانیه(۱)
    پایان
پایان

تابع ریشه:
    ایست = اتمی.پرچم جدید(نادرست)
    دورها = اتمی.صحیح۶۴ جدید(۰)
    ن := نخ‌ساز(کارگر)
    تا اتمی.بارگذاری(دورها) < ۲۰:
        همگام سازی.خواب میلی ثانیه(۱)
    پایان
    اتمی.تنظیم(ایست، درست)
    نخ‌پیوند(ن)
    سرچاپ "کارگر دست‌کم ۲۰ دور کار کرد:"، اتمی.بارگذاری(دورها) >= ۲۰
    سرچاپ "پرچم ایست:"، اتمی.گرفتن(ایست)
    اتمی.نابودسازی پرچم(ایست)
    اتمی.نابودسازی صحیح۶۴(دورها)
پایان
