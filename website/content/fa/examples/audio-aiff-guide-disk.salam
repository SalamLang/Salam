واردسازی صدا
واردسازی صدا.ایف
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا کلیپ := صدا.جدید(22050، 1، 100)
    صدا.تنظیم نمونه(کلیپ، 10، 0، -0.5)
    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_guide.aiff")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ ایف.ذخیره ایف با بیت(کلیپ، نشانی، 16)

    ناپایا درستی := نادرست
    ناپایا برگشته := ایف.بازکردن ایف(نشانی، درستی)
    سرچاپ درستی، برگشته.نرخ، برگشته.فریم ها، برگشته.بیت ها
    سرچاپ صدا.نمونه(برگشته، 10، 0)

    نبود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_guide_missing.aiff")
    دیرکن حافظه.آزادسازی(نبود برگردان تهی*)
    ناپایا رفته := نادرست
    ایف.بازکردن ایف(نبود، رفته)
    سرچاپ رفته
    صدا.آزادسازی(کلیپ)
    صدا.آزادسازی(برگشته)
پایان
