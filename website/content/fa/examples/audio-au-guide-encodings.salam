تابع ریشه:
    ناپایا کلیپ := صدا.جدید(8000، 1، 64)
    صدا.تنظیم نمونه(کلیپ، 3، 0، 0.5)

    ناپایا خام := ای‌یو.کدگذاری ای‌یو با رمز(کلیپ، ای‌یو.رمز پی‌سی‌ام۱۶)
    ناپایا میو := ای‌یو.کدگذاری ای‌یو با رمز(کلیپ، ای‌یو.رمز میولا)
    ناپایا اعشاری := ای‌یو.کدگذاری ای‌یو با رمز(کلیپ، ای‌یو.رمز اعشار۳۲)
    سرچاپ فشرده سازی.طول بافر(خام)، فشرده سازی.طول بافر(میو)، فشرده سازی.طول بافر(اعشاری)

    ناپایا سر := ای‌یو.سرآیند {}
    سرچاپ ای‌یو.خواندن سرآیند(میو.داده، میو.طول، سر)
    سرچاپ سر.رمزگذاری برابر ای‌یو.رمز میولا، سر.نرخ، سر.کانال ها، سر.اندازه داده

    ناپایا درستی := نادرست
    ناپایا برگشته := ای‌یو.کدگشایی ای‌یو(میو.داده، میو.طول، درستی)
    سرچاپ درستی، برگشته.بیت ها، ریاضی.قدرمطلق(صدا.نمونه(برگشته، 3، 0) - 0.5) کوچکتر 0.02
    فشرده سازی.آزادسازی بافر(خام)
    فشرده سازی.آزادسازی بافر(میو)
    فشرده سازی.آزادسازی بافر(اعشاری)
    صدا.آزادسازی(کلیپ)
    صدا.آزادسازی(برگشته)
