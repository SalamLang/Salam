واردسازی صدا
واردسازی صدا.کدک
واردسازی فشرده سازی

تابع ریشه:
    ناپایا کلیپ := صدا.جدید(8000، 1، 32)
    صدا.تنظیم نمونه(کلیپ، 3، 0، 0.5)
    ناپایا بافه := کدک.کدگذاری(کلیپ، صدا.قالب ویو)
    سرچاپ فشرده سازی.طول بافر(بافه)
    سرچاپ صدا.نام قالب(صدا.شناسایی قالب(بافه.داده، بافه.طول))

    ناپایا درستی := نادرست
    ناپایا برگشته := کدک.کدگشایی(بافه.داده، بافه.طول، درستی)
    سرچاپ درستی، برگشته.فریم ها، صدا.نمونه(برگشته، 3، 0)

    ناپایا آشغال := فشرده سازی.بافر بایت جدید()
    ناپایا ش := 0
    تا ش کوچکتر 16:
        فشرده سازی.افزودن بایت(آشغال، ش)
        ش += 1
    پایان
    ناپایا خراب := نادرست
    کدک.کدگشایی(آشغال.داده، آشغال.طول، خراب)
    سرچاپ خراب
    فشرده سازی.آزادسازی بافر(بافه)
    فشرده سازی.آزادسازی بافر(آشغال)
    صدا.آزادسازی(کلیپ)
    صدا.آزادسازی(برگشته)
پایان
