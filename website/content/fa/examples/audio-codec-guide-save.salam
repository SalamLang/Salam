واردسازی صدا
واردسازی صدا.کدک
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا کلیپ := صدا.جدید(22050، 2، 64)
    صدا.تنظیم نمونه(کلیپ، 5، 0، 0.5)
    صدا.تنظیم نمونه(کلیپ، 5، 1، -0.25)

    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_guide_codec.wav")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ کدک.کدگذاری شدنی(صدا.قالب ویو)، کدک.ذخیره(کلیپ، نشانی)

    ناپایا درستی := نادرست
    آگاه := کدک.بررسی پرونده(نشانی، درستی)
    سرچاپ درستی، صدا.نام قالب(آگاه.قالب)، آگاه.فریم ها، آگاه.بیت ها، آگاه.بی اتلاف

    ناپایا درستی۲ := نادرست
    ناپایا برگشته := کدک.بازکردن(نشانی، درستی۲)
    سرچاپ درستی۲، برگشته.نرخ، برگشته.کانال ها
    سرچاپ صدا.نمونه(برگشته، 5، 0)، صدا.نمونه(برگشته، 5، 1)
    صدا.آزادسازی(کلیپ)
    صدا.آزادسازی(برگشته)
پایان
