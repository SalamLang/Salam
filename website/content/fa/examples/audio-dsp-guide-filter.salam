واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی ریاضی

تابع نوا(نرخی: صحیح، بسامد: اعشار۶۴، شمار: صحیح): صدا.قطعه:
    ناپایا کلیپ := صدا.جدید(نرخی، 1، شمار)
    ناپایا ش := 0
    تا ش کوچکتر شمار:
        صدا.تنظیم نمونه(کلیپ، ش، 0، ریاضی.سینوس(2.0 * ریاضی.پی * بسامد * (ش برگردان اعشار۶۴) / (نرخی برگردان اعشار۶۴)))
        ش++
    پایان
    برگشت کلیپ
پایان

تابع ریشه:
    صافی := پردازش سیگنال.صافی پایین(1000.0، 0.707، 48000)
    سرچاپ پردازش سیگنال.پاسخ دوقطبی(صافی، 100.0، 48000) بزرگتر 0.99
    سرچاپ پردازش سیگنال.پاسخ دوقطبی(صافی، 10000.0، 48000) کوچکتر 0.02

    ناپایا کم := نوا(48000، 100.0، 2048)
    ناپایا زیاد := نوا(48000، 10000.0، 2048)
    کم پیش از := صدا.جذر میانگین مربع(کم)
    زیاد پیش از := صدا.جذر میانگین مربع(زیاد)
    پردازش سیگنال.پردازش همه کانال‌ها(صافی، کم)
    پردازش سیگنال.پردازش همه کانال‌ها(صافی، زیاد)
    کم دسیبل := صدا.بهره به دسیبل(صدا.جذر میانگین مربع(کم) / کم پیش از)
    زیاد دسیبل := صدا.بهره به دسیبل(صدا.جذر میانگین مربع(زیاد) / زیاد پیش از)
    سرچاپ کم دسیبل بزرگتر -1.0
    سرچاپ زیاد دسیبل کوچکتر -20.0
    صدا.آزادسازی(کم)
    صدا.آزادسازی(زیاد)
پایان
