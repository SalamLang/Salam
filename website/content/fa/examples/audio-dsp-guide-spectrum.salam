واردسازی صدا.پردازش سیگنال
واردسازی ریاضی

تابع ریشه:
    تعداد := 256
    نرخی := 8000
    ناپایا حقیقی‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا موهومی‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    دیرکن حقیقی‌ها.آزادکن()
    دیرکن موهومی‌ها.آزادکن()
    ناپایا ش := 0
    تا ش کوچکتر تعداد:
        حقیقی‌ها.بیفزا(ریاضی.سینوس(2.0 * ریاضی.پی * 1000.0 * (ش برگردان اعشار۶۴) / (نرخی برگردان اعشار۶۴)))
        موهومی‌ها.بیفزا(0.0)
        ش += 1
    پایان
    پردازش سیگنال.اعمال پنجره(حقیقی‌ها.ارجاع(0)، تعداد، پردازش سیگنال.پنجره هان، 0.0)
    سرچاپ پردازش سیگنال.تبدیل فوریه برداری(حقیقی‌ها، موهومی‌ها)
    اندازه‌ها := پردازش سیگنال.اندازه(حقیقی‌ها.ارجاع(0)، موهومی‌ها.ارجاع(0)، تعداد)
    دیرکن اندازه‌ها.آزادکن()
    اوج := پردازش سیگنال.خانه اوج(اندازه‌ها)
    سرچاپ اوج، پردازش سیگنال.بسامد خانه(اوج، تعداد، نرخی)
    سرچاپ پردازش سیگنال.توان دو است(تعداد)، پردازش سیگنال.توان دو بعدی(300)
پایان
