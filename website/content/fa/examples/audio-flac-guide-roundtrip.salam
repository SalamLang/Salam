واردسازی صدا
واردسازی صدا.فلاک
واردسازی صدا.صداساز
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    منبع := صداساز.نوا(330.0، 0.25، 44100، صداساز.موج مثلثی)
    ناپایا قطعه := صدا.به بیت(منبع، 16)
    قطعه.بیت ها = 16
    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_flac_guide.flac")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ "ذخیره شد:"، فلاک.ذخیره فلاک با سطح(قطعه، نشانی، 8)

    ناپایا درستی := نادرست
    اطلاع := فلاک.بررسی پرونده فلاک(نشانی، درستی)
    سرچاپ "بررسی:"، درستی، اطلاع.نرخ، اطلاع.کانال ها، اطلاع.بیت ها، اطلاع.فریم ها

    ناپایا برگشته := فلاک.بازکردن فلاک(نشانی، درستی)
    ناپایا یکسان := برگشته.فریم ها برابر قطعه.فریم ها
    ناپایا ش := 0
    تا ش کوچکتر قطعه.فریم ها:
        اگر صدا.نمونه(برگشته، ش، 0) نابرابر صدا.نمونه(قطعه، ش، 0):
            یکسان = نادرست
        پایان
        ش++
    پایان
    سرچاپ "یکسان:"، یکسان

    ناپایا م := منبع
    صدا.آزادسازی(م)
    صدا.آزادسازی(قطعه)
    صدا.آزادسازی(برگشته)
پایان
