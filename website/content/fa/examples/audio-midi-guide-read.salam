واردسازی صدا
واردسازی صدا.میدی
واردسازی صدا.موسیقی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا آهنگ := میدی.آهنگ جدید(480)
    ناپایا ترک := میدی.ترک جدید()
    میدی.افزودن ضرباهنگ(ترک، 0، 120.0)
    میدی.افزودن نت(ترک، 0، 480، 60، 100، 0)
    میدی.افزودن نت(ترک، 480، 480، 64، 100، 0)
    میدی.افزودن نت(ترک، 960، 960، 67، 100، 0)
    میدی.افزودن ترک(آهنگ، ترک)
    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_midi_read_guide.mid")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    میدی.ذخیره میدی(آهنگ، نشانی)
    میدی.آزادسازی آهنگ(آهنگ)

    ناپایا درستی := نادرست
    ناپایا برگشته := میدی.بازکردن میدی(نشانی، درستی)
    سرچاپ درستی، برگشته.ترک‌ها.طول()، میدی.ضربان(برگشته)
    سرچاپ "ثانیه:"، میدی.تیک به ثانیه(برگشته، میدی.تیک کل(برگشته))

    ناپایا نت‌ها := میدی.نت‌ها(برگشته)
    هر ن در نت‌ها:
        نامی := موسیقی.نام نت(ن.شماره نت)
        سرچاپ نامی، ن.آغاز، ن.درازی
        حافظه.آزادسازی(نامی برگردان تهی*)
    پایان
    نت‌ها.آزادکن()

    قطعه := میدی.ساختن(برگشته، 22050، 1)
    سرچاپ "ساخته شد:"، قطعه.فریم ها بزرگتر 0، صدا.اوج(قطعه) بزرگتر 0.05
    ناپایا ق := قطعه
    صدا.آزادسازی(ق)
    میدی.آزادسازی آهنگ(برگشته)
پایان
