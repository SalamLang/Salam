واردسازی صدا.میدی
واردسازی صدا.موسیقی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا آهنگ := میدی.آهنگ جدید(480)
    ناپایا ترک := میدی.ترک جدید()
    میدی.افزودن ضرباهنگ(ترک، 0، 100.0)
    میدی.افزودن برنامه(ترک، 0، 0، 0)
    ناپایا گام := موسیقی.نت‌های گام(60، موسیقی.گام بزرگ، 5)
    دیرکن گام.آزادکن()
    ناپایا ش := 0
    تا ش کوچکتر گام.طول():
        میدی.افزودن نت(ترک، ش * 480، 480، گام.بگیر(ش)، 90، 0)
        ش += 1
    پایان
    سرچاپ "رویدادها:"، ترک.رویدادها.طول()
    میدی.افزودن ترک(آهنگ، ترک)
    سرچاپ "تیک‌ها:"، میدی.تیک کل(آهنگ)

    ناپایا رمز := میدی.کدگذاری میدی(آهنگ)
    سرچاپ "میدی معتبر:"، میدی.میدی است(رمز.داده، رمز.طول)
    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_midi_guide.mid")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ "ذخیره شد:"، میدی.ذخیره میدی(آهنگ، نشانی)

    فشرده سازی.آزادسازی بافر(رمز)
    میدی.آزادسازی آهنگ(آهنگ)
پایان
