واردسازی صدا.ام‌پی‌تری
واردسازی فشرده سازی

تابع ریشه:
    ناپایا پرونده := فشرده سازی.بافر بایت جدید()
    ناپایا ف := 0
    تا ف کوچکتر 4:
        فشرده سازی.افزودن بایت(پرونده، 255)
        فشرده سازی.افزودن بایت(پرونده، 0xFB)
        فشرده سازی.افزودن بایت(پرونده، 0x90)
        فشرده سازی.افزودن بایت(پرونده، 0xC0)
        ناپایا ش := 4
        تا ش کوچکتر 417:
            فشرده سازی.افزودن بایت(پرونده، 0)
            ش++
        پایان
        ف++
    پایان

    سرچاپ "شبیه ام‌پی‌تری:"، ام‌پی‌تری.ام‌پی‌تری است(پرونده.داده، پرونده.طول)
    ناپایا سر := ام‌پی‌تری.سرآیند {}
    سرچاپ "سرآیند:"، ام‌پی‌تری.خواندن سرآیند(پرونده.داده، پرونده.طول، 0، سر)
    سرچاپ سر.نرخ، "هرتز،"، سر.نرخ بیت، "کیلوبیت،"، سر.کانال ها، "کانال"
    سرچاپ "لایه سه:"، سر.لایه برابر ام‌پی‌تری.لایه سه
    سرچاپ "بایت فریم:"، سر.اندازه فریم، "نمونه:"، سر.نمونه‌ها
    سرچاپ "فریم‌ها:"، ام‌پی‌تری.شمار فریم‌ها(پرونده.داده، پرونده.طول)

    فشرده سازی.آزادسازی بافر(پرونده)
پایان
