واردسازی بایگانی
واردسازی صدا.ام‌پی‌تری
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا پرونده := فشرده سازی.بافر بایت جدید()
    ناپایا ف := 0
    تا ف کوچکتر 40:
        فشرده سازی.افزودن بایت(پرونده، 255)
        فشرده سازی.افزودن بایت(پرونده، 0xFB)
        فشرده سازی.افزودن بایت(پرونده، 0x90)
        فشرده سازی.افزودن بایت(پرونده، 0xC0)
        ناپایا ش := 4
        تا ش کوچکتر 417:
            فشرده سازی.افزودن بایت(پرونده، 0)
            ش += 1
        پایان
        ف += 1
    پایان
    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_mp3_guide.mp3")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ "نوشته شد:"، بایگانی.نوشتن پرونده دودویی از بافر(نشانی، پرونده)

    ناپایا درستی := نادرست
    اطلاع := ام‌پی‌تری.بررسی پرونده ام‌پی‌تری(نشانی، درستی)
    سرچاپ درستی، اطلاع.نرخ، اطلاع.کانال ها، اطلاع.بی اتلاف
    سرچاپ "فریم‌ها:"، اطلاع.فریم ها
    سرچاپ "ثانیه‌ی کامل:"، اطلاع.فریم ها / اطلاع.نرخ

    سرچاپ "فریم ۱ در بایت:"، ام‌پی‌تری.فریم در(پرونده.داده، پرونده.طول، 1)
    سرچاپ "بعد از پایان:"، ام‌پی‌تری.فریم در(پرونده.داده، پرونده.طول، 99)
    سرچاپ "در ۰.۵ ثانیه:"، ام‌پی‌تری.جستن به ثانیه(پرونده.داده، پرونده.طول، 0.5)

    فشرده سازی.آزادسازی بافر(پرونده)
پایان
