واردسازی صدا.موسیقی
واردسازی حافظه

تابع نمایش(برچسب: رشته، نت‌ها: وکتور<صحیح>):
    ناپایا خط := برچسب
    هر ن در نت‌ها:
        نامی := موسیقی.نام نت(ن)
        خط = خط + " " + نامی
        حافظه.آزادسازی(نامی برگردان تهی*)
    پایان
    سرچاپ خط
پایان

تابع ریشه:
    ناپایا بزرگ := موسیقی.نت‌های گام(60، موسیقی.گام بزرگ، 7)
    نمایش("C major:"، بزرگ)
    بزرگ.آزادکن()

    ناپایا کوچک := موسیقی.نت‌های گام(57، موسیقی.گام کوچک، 7)
    نمایش("A minor:"، کوچک)
    کوچک.آزادکن()

    ناپایا سه‌تایی := موسیقی.نت‌های آکورد(60، موسیقی.آکورد بزرگ)
    نمایش("C chord:"، سه‌تایی)
    سه‌تایی.آزادکن()

    ناپایا هفتی := موسیقی.نت‌های آکورد(67، موسیقی.آکورد نمایان۷)
    نمایش("G7:"، هفتی)
    هفتی.آزادکن()
پایان
