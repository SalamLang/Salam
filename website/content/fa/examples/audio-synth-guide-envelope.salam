واردسازی صدا
واردسازی صدا.صداساز

تابع ریشه:
    پوششی := صداساز.پوشش { حمله = 0.05، افت = 0.1، پایداری = 0.6، رهایش = 0.2 }
    سرچاپ "کل:"، صداساز.درازی کل پوشش(پوششی، 0.5)
    هر ز در [0.0، 0.025، 0.05، 0.3، 0.5]:
        سرچاپ ز، صداساز.پوشش در زمان(پوششی، ز، 0.5)
    پایان

    تخت := صداساز.نوا(440.0، 0.7، 22050، صداساز.موج اره‌ای)
    شکل‌دار := صداساز.نوا با پوشش(440.0، 0.5، 22050، صداساز.موج اره‌ای، پوششی، 0.8)
    سرچاپ "اوج تخت:"، صدا.اوج(تخت) بزرگتر 0.9
    سرچاپ "اوج شکل‌دار:"، صدا.اوج(شکل‌دار) کوچکتربرابر 0.81
    سرچاپ "ساکت شروع می‌شود:"، صدا.نمونه(شکل‌دار، 0، 0) برابر 0.0

    ناپایا الف := تخت
    صدا.آزادسازی(الف)
    ناپایا ب := شکل‌دار
    صدا.آزادسازی(ب)
پایان
