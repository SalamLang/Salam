واردسازی صدا
واردسازی صدا.موسیقی
واردسازی صدا.صداساز

تابع ریشه:
    پوششی := صداساز.پوشش { حمله = 0.01، افت = 0.05، پایداری = 0.5، رهایش = 0.1 }
    ناپایا نت‌ها := وکتور {} برگردان وکتور<صداساز.نت>
    دیرکن نت‌ها.آزادکن()
    ناپایا گام := موسیقی.نت‌های گام(60، موسیقی.گام بزرگ، 8)
    دیرکن گام.آزادکن()
    ناپایا ش := 0
    تا ش کوچکتر گام.طول():
        آغاز := (ش برگردان اعشار۶۴) * 0.25
        نت‌ها.بیفزا(صداساز.نت در(گام.بگیر(ش)، آغاز، 0.25، 0.5، صداساز.موج مثلثی))
        ش++
    پایان
    سرچاپ "نت‌ها:"، نت‌ها.طول()

    آهنگ := صداساز.ساختن نت‌ها(نت‌ها، 22050، 2، پوششی)
    سرچاپ آهنگ.کانال ها، آهنگ.نرخ
    سرچاپ "ثانیه:"، صدا.مدت(آهنگ) بزرگتر 2.0
    سرچاپ "بریده:"، صدا.بریده است(آهنگ)

    ناپایا آ := آهنگ
    صدا.آزادسازی(آ)
پایان
