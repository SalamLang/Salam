واردسازی بایگانی
واردسازی صدا.برچسب صدا
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته

تابع ریشه:
    ناپایا برچسب := برچسب صدا.برچسب‌های جدید()
    برچسب.عنوان = رشته.رونوشت("Evening Walk")
    برچسب.هنرمند = رشته.رونوشت("Darya")
    ناپایا سر := برچسب صدا.نوشتن آی‌دی۳ دو(برچسب)
    ناپایا پرونده := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بافر(پرونده، سر)
    ناپایا ش := 0
    تا ش کوچکتر 100:
        فشرده سازی.افزودن بایت(پرونده، 65)
        ش += 1
    پایان

    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_tag_guide.mp3")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ "نوشته شد:"، بایگانی.نوشتن پرونده دودویی از بافر(نشانی، پرونده)

    ناپایا درستی := نادرست
    ناپایا گرفته := برچسب صدا.خواندن برچسب‌های پرونده(نشانی، درستی)
    سرچاپ درستی، گرفته.عنوان، "-"، گرفته.هنرمند

    سرچاپ "صدا از بایت:"، برچسب صدا.آغاز صدا(پرونده.داده، پرونده.طول)
    ناپایا لخت := برچسب صدا.برداشتن برچسب‌ها(پرونده.داده، پرونده.طول)
    سرچاپ "فقط صدا:"، فشرده سازی.طول بافر(لخت)

    برچسب صدا.آزادسازی برچسب‌ها(برچسب)
    برچسب صدا.آزادسازی برچسب‌ها(گرفته)
    فشرده سازی.آزادسازی بافر(سر)
    فشرده سازی.آزادسازی بافر(پرونده)
    فشرده سازی.آزادسازی بافر(لخت)
پایان
