واردسازی صدا
واردسازی صدا.ویو
واردسازی فشرده سازی
واردسازی ریاضی

تابع ریشه:
    ناپایا کلیپ := صدا.جدید(8000، 1، 400)
    ناپایا ش := 0
    تا ش کوچکتر 400:
        صدا.تنظیم نمونه(کلیپ، ش، 0، 0.8 * ریاضی.سینوس(2.0 * ریاضی.پی * 200.0 * (ش برگردان اعشار۶۴) / 8000.0))
        ش++
    پایان
    ناپایا خام := ویو.کدگذاری ویو با بیت(کلیپ، 16)
    ناپایا میو := ویو.کدگذاری میولا(کلیپ)
    ناپایا ایل := ویو.کدگذاری ای‌لا(کلیپ)
    سرچاپ فشرده سازی.طول بافر(خام)، فشرده سازی.طول بافر(میو)، فشرده سازی.طول بافر(ایل)

    ناپایا درستی := نادرست
    ناپایا برگشته := ویو.کدگشایی ویو(میو.داده، میو.طول، درستی)
    سرچاپ درستی، برگشته.فریم ها، برگشته.بیت ها
    ناپایا بدترین := 0.0
    ناپایا ک := 0
    تا ک کوچکتر 400:
        فاصله := ریاضی.قدرمطلق(صدا.نمونه(برگشته، ک، 0) - صدا.نمونه(کلیپ، ک، 0))
        اگر فاصله بزرگتر بدترین:
            بدترین = فاصله
        پایان
        ک++
    پایان
    سرچاپ بدترین کوچکتر 0.03
    فشرده سازی.آزادسازی بافر(خام)
    فشرده سازی.آزادسازی بافر(میو)
    فشرده سازی.آزادسازی بافر(ایل)
    صدا.آزادسازی(کلیپ)
    صدا.آزادسازی(برگشته)
پایان
