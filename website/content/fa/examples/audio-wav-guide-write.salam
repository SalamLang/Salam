تابع نوا(نرخی: صحیح، بسامد: اعشار۶۴، شمار: صحیح): صدا.قطعه:
    ناپایا کلیپ := صدا.جدید(نرخی، 1، شمار)
    ناپایا ش := 0
    تا ش کوچکتر شمار:
        صدا.تنظیم نمونه(کلیپ، ش، 0، 0.5 * ریاضی.سینوس(2.0 * ریاضی.پی * بسامد * (ش برگردان اعشار۶۴) / (نرخی برگردان اعشار۶۴)))
        ش++
    پایان
    برگشت کلیپ
پایان

تابع ریشه:
    ناپایا کلیپ := نوا(8000، 440.0، 800)
    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_guide_tone.wav")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ ویو.ذخیره ویو با بیت(کلیپ، نشانی، 16)

    ناپایا درستی := نادرست
    آگاه := ویو.بررسی پرونده ویو(نشانی، درستی)
    سرچاپ درستی، آگاه.نرخ، آگاه.کانال ها، آگاه.بیت ها، آگاه.فریم ها

    ناپایا درستی۲ := نادرست
    ناپایا برگشته := ویو.بازکردن ویو(نشانی، درستی۲)
    نزدیک := ریاضی.قدرمطلق(صدا.نمونه(برگشته، 5، 0) - صدا.نمونه(کلیپ، 5، 0)) کوچکتر 0.001
    سرچاپ درستی۲، برگشته.فریم ها، نزدیک
    صدا.آزادسازی(کلیپ)
    صدا.آزادسازی(برگشته)
