واردسازی مشتق‌گیری خودکار
واردسازی تانسور

تابع جمع نرم‌مثبت(ت: تانسور.تانسور): اعشار۶۴:
    برگشت تانسور.مجموع همه(تانسور.لگاریتم(تانسور.جمع با عدد(تانسور.نمایی(ت)، ۱.۰)))
پایان

تابع ریشه:
    ناپایا نقطه := تانسور.بازه گام(۴)
    تانسور.جمع عدد درجا(نقطه، -۱.۵)
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(۱)
    ایکس := مشتق‌گیری خودکار.پایش(نوار، نقطه)
    ایگرگ := مشتق‌گیری خودکار.لگاریتم(نوار، مشتق‌گیری خودکار.جمع با عدد(نوار، مشتق‌گیری خودکار.نمایی(نوار، ایکس)، ۱.۰))
    مشتق‌گیری خودکار.پس‌انتشار(نوار، مشتق‌گیری خودکار.مجموع(نوار، ایگرگ))
    از نوار := مشتق‌گیری خودکار.گرادیان(نوار، ایکس)
    سرچاپ "گرادیان نوار درست است:"، مشتق‌گیری خودکار.بررسی گرادیان((ت: تانسور.تانسور): برگشت جمع نرم‌مثبت(ت) پایان، نقطه، از نوار، ۰.۰۰۱، ۰.۰۱)
    دوبرابر := تانسور.مقیاس(از نوار، ۲.۰)
    سرچاپ "گرادیان دو برابر درست است:"، مشتق‌گیری خودکار.بررسی گرادیان((ت: تانسور.تانسور): برگشت جمع نرم‌مثبت(ت) پایان، نقطه، دوبرابر، ۰.۰۰۱، ۰.۰۱)
    نوار.آزادسازی()
پایان
