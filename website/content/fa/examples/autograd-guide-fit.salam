واردسازی مشتق‌گیری خودکار
واردسازی تانسور
واردسازی تبدیل

تابع ستون(مقدارها: اعشار۶۴[]): تانسور.تانسور:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۳۲>
    هر م در مقدارها:
        داده.بیفزا(م برگردان اعشار۳۲)
    پایان
    شکل := تانسور.شکل دو(مقدارها.طول()، ۱)
    برگشت تانسور.از آرایه(شکل، داده)
پایان

تابع ریشه:
    ایکس ها := ستون([۰.۰، ۱.۰، ۲.۰، ۳.۰، ۴.۰])
    ایگرگ ها := ستون([۱.۱، ۲.۹، ۵.۲، ۶.۸، ۹.۱])
    ناپایا وزن := تانسور.صفرها دو(۱، ۱)
    ناپایا سوگیری := تانسور.صفرها دو(۱، ۱)
    ناپایا گرادیان وزن := تانسور.صفرها دو(۱، ۱)
    ناپایا گرادیان سوگیری := تانسور.صفرها دو(۱، ۱)
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(۱)
    تکرار ۲۰۱ در گام:
        نوار.بازنشانی()
        تانسور.تنظیم همه(گرادیان وزن، ۰.۰)
        تانسور.تنظیم همه(گرادیان سوگیری، ۰.۰)
        گره وزن := مشتق‌گیری خودکار.پارامتر(نوار، وزن، گرادیان وزن)
        گره سوگیری := مشتق‌گیری خودکار.پارامتر(نوار، سوگیری، گرادیان سوگیری)
        حدس := مشتق‌گیری خودکار.جمع(نوار، مشتق‌گیری خودکار.ضرب ماتریسی(نوار، مشتق‌گیری خودکار.ورودی(نوار، ایکس ها)، گره وزن)، گره سوگیری)
        زیان := مشتق‌گیری خودکار.خطای میانگین مربعات(نوار، حدس، مشتق‌گیری خودکار.ثابت(نوار، ایگرگ ها))
        مشتق‌گیری خودکار.پس‌انتشار(نوار، زیان)
        تانسور.جمع مقیاس‌دار(وزن، گرادیان وزن، -۰.۰۲)
        تانسور.جمع مقیاس‌دار(سوگیری، گرادیان سوگیری، -۰.۰۲)
        اگر گام % ۵۰ == ۰:
            سرچاپ "گام"، گام، "زیان"، تبدیل.قالب اعشار با دقت(مشتق‌گیری خودکار.مقدار(نوار، زیان).عنصر(۰)، ۳)
        پایان
    پایان
    سرچاپ "y ="، تبدیل.قالب اعشار با دقت(وزن.عنصر(۰)، ۲)، "* x +"، تبدیل.قالب اعشار با دقت(سوگیری.عنصر(۰)، ۲)
    نوار.آزادسازی()
پایان
