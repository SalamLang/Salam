واردسازی ای دبلیو اس

تابع ریشه:
    ناپایا پ := ای دبلیو اس.برای مینیو("http://127.0.0.1:9000"، "backups")
    پ = ای دبلیو اس.با اعتبارنامه(پ، "minioadmin"، "minioadmin")
    گزینه‌ها := ای دبلیو اس.گزینه‌های نوشتن { نوع محتوا = "application/gzip"، رده ذخیره‌سازی = "STANDARD_IA" }
    بارگذاری := ای دبلیو اس.اس۳ بارگذاری پرونده(پ، "db/2026-10-17.sql.gz"، "/var/backups/shop.sql.gz"، گزینه‌ها)
    اگر وارونه بارگذاری.موفق:
        سرچاپ "بارگذاری شکست خورد:"، بارگذاری.کد، بارگذاری.خطا
        برگشت ۱
    پایان
    سرچاپ "بارگذاری شد:"، بارگذاری.بایت‌ها، "بایت در"، بارگذاری.شمار بخش‌ها، "تکه"
    دریافت := ای دبلیو اس.اس۳ دریافت پرونده(پ، "db/2026-10-17.sql.gz"، "/tmp/restore.sql.gz")
    اگر وارونه دریافت.موفق:
        سرچاپ "دریافت شکست خورد:"، دریافت.کد، دریافت.خطا
        برگشت ۱
    پایان
    سرچاپ "بازیابی شد:"، دریافت.بایت‌ها، "بایت در"، دریافت.مسیر
    نشان := ای دبلیو اس.اس۳ خواندن بایت(پ، "site/logo.png")
    اگر نشان.موفق:
        سرچاپ "اندازه‌ی logo.png:"، نشان.طول، "بایت"
    پایان
    ای دبلیو اس.آزادسازی بایت‌ها(نشان)
پایان
