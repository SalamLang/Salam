واردسازی ای دبلیو اس

تابع ریشه:
    ناپایا پ := ای دبلیو اس.برای مینیو("http://127.0.0.1:9000"، "backups")
    پ = ای دبلیو اس.با اعتبارنامه(پ، "minioadmin"، "minioadmin")
    گزینه‌ها := ای دبلیو اس.گزینه‌های نوشتن { content_type = "application/gzip"، storage_class = "STANDARD_IA" }
    بارگذاری := ای دبلیو اس.اس۳ بارگذاری پرونده(پ، "db/2026-10-17.sql.gz"، "/var/backups/shop.sql.gz"، گزینه‌ها)
    اگر وارونه بارگذاری.ok:
        سرچاپ "بارگذاری شکست خورد:"، بارگذاری.code، بارگذاری.error
        برگشت ۱
    پایان
    سرچاپ "بارگذاری شد:"، بارگذاری.bytes، "بایت در"، بارگذاری.parts، "تکه"
    دریافت := ای دبلیو اس.اس۳ دریافت پرونده(پ، "db/2026-10-17.sql.gz"، "/tmp/restore.sql.gz")
    اگر وارونه دریافت.ok:
        سرچاپ "دریافت شکست خورد:"، دریافت.code، دریافت.error
        برگشت ۱
    پایان
    سرچاپ "بازیابی شد:"، دریافت.bytes، "بایت در"، دریافت.path
    نشان := ای دبلیو اس.اس۳ خواندن بایت(پ، "site/logo.png")
    اگر نشان.ok:
        سرچاپ "اندازه‌ی logo.png:"، نشان.len، "بایت"
    پایان
    ای دبلیو اس.آزادسازی بایت‌ها(نشان)
پایان
