واردسازی ای دبلیو اس

تابع ریشه:
    ناپایا پ := ای دبلیو اس.برای مینیو("http://127.0.0.1:9000"، "backups")
    پ = ای دبلیو اس.با اعتبارنامه(پ، "minioadmin"، "minioadmin")
    اگر وارونه ای دبلیو اس.اس۳ سطل وجود دارد(پ، "backups"):
        ساخته := ای دبلیو اس.اس۳ ساخت سطل(پ، "backups")
        اگر وارونه ساخته.موفق:
            سرچاپ "سطل ساخته نشد:"، ساخته.وضعیت، ساخته.کد، ساخته.خطا
            برگشت ۱
        پایان
    پایان
    _ := ای دبلیو اس.اس۳ نوشتن(پ، "2026/10/notes.txt"، "نخستین پشتیبان"، "text/plain; charset=utf-8")
    _ := ای دبلیو اس.اس۳ نوشتن(پ، "2026/10/todo.txt"، "خرید شیر"، "text/plain; charset=utf-8")
    ناپایا فهرست := ای دبلیو اس.اس۳ فهرست پیشوند(پ، "2026/10/")
    هر مورد در فهرست.شیء‌ها:
        سرچاپ مورد.کلید، مورد.اندازه
    پایان
    ای دبلیو اس.آزادسازی فهرست(فهرست)
    خوانده := ای دبلیو اس.اس۳ خواندن(پ، "2026/10/notes.txt")
    اگر خوانده.موفق:
        سرچاپ "خوانده شد:"، خوانده.بدنه
    وگرنه:
        سرچاپ "خواندن شکست خورد:"، خوانده.وضعیت، خوانده.کد
    پایان
پایان
