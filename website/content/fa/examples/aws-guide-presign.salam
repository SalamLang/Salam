واردسازی ای دبلیو اس

تابع ریشه:
    ناپایا پ := ای دبلیو اس.برای ای دبلیو اس("eu-central-1"، "user-uploads")
    پ = ای دبلیو اس.با اعتبارنامه(پ، "AKIAIOSFODNN7EXAMPLE"، "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY")
    زمان := ۱۷۹۲۲۲۴۰۰۰ برگردان صحیح۶۴
    بارگذاری := ای دبلیو اس.گزینه‌های پیش‌امضا { مدت اعتبار = ۳۰۰، نوع محتوا = "image/jpeg" }
    نشانی نوشتن := ای دبلیو اس.اس۳ پیش‌امضا با گزینه(پ، "PUT"، "avatars/42.jpg"، بارگذاری، زمان)
    سرچاپ "بارگذاری:"، نشانی نوشتن.طول() > ۰
    سرچاپ نشانی نوشتن.زیررشته(۰، نشانی نوشتن.بیاب("?"))
    سرچاپ "پس از ۳۰۰ ثانیه باطل می‌شود:"، نشانی نوشتن.بیاب("X-Amz-Expires=300") >= ۰
    سرچاپ "نوع محتوا امضا شده:"، نشانی نوشتن.بیاب("content-type") >= ۰
    دانلود := ای دبلیو اس.گزینه‌های پیش‌امضا { مدت اعتبار = ۳۶۰۰، نحوه نمایش محتوای پاسخ = "attachment; filename=\"photo.jpg\"" }
    نشانی خواندن := ای دبلیو اس.اس۳ پیش‌امضا با گزینه(پ، "GET"، "avatars/42.jpg"، دانلود، زمان)
    سرچاپ "مرورگر فایل را ذخیره می‌کند:"، نشانی خواندن.بیاب("response-content-disposition=attachment") >= ۰
    سرچاپ "دو بار، یک امضا:"، نشانی خواندن == ای دبلیو اس.اس۳ پیش‌امضا با گزینه(پ، "GET"، "avatars/42.jpg"، دانلود، زمان)
