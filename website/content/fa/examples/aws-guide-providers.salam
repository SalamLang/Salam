واردسازی ای دبلیو اس

تابع فضای ذخیره(سرویس: رشته، سطل: رشته): ای دبلیو اس.پیکربندی:
    ترابرد سرویس:
        "r2":
            برگشت ای دبلیو اس.برای آر۲("0123456789abcdef"، سطل)
        پایان
        "spaces":
            برگشت ای دبلیو اس.برای اسپیسز("ams3"، سطل)
        پایان
        "minio":
            برگشت ای دبلیو اس.برای مینیو("http://127.0.0.1:9000"، سطل)
        پایان
    پایان
    برگشت ای دبلیو اس.برای ای دبلیو اس("eu-central-1"، سطل)
پایان

تابع ریشه:
    هر سرویس در ["aws"، "r2"، "spaces"، "minio"]:
        پ := فضای ذخیره(سرویس، "media")
        سرچاپ سرویس، پ.نقطه پایانی، پ.منطقه، پ.سبک مسیر
    پایان
پایان
