واردسازی ای دبلیو اس

تابع پردازش(بدنه: رشته): منطقی:
    سرچاپ "تغییر اندازه‌ی"، بدنه
    برگشت بدنه.طول() > ۰
پایان

تابع ریشه:
    پ := ای دبلیو اس.پیکربندی از محیط("")
    اگر پ.کلید دسترسی.طول() == ۰ یا پ.کلید رمز.طول() == ۰:
        سرچاپ "AWS_ACCESS_KEY_ID و AWS_SECRET_ACCESS_KEY و AWS_REGION را بگذارید"
        برگشت ۱
    پایان
    صف := ای دبلیو اس.اس کیو اس نشانی صف(پ، "image-jobs")
    اگر صف.طول() == ۰:
        سرچاپ "صف image-jobs وجود ندارد"
        برگشت ۱
    پایان
    _ := ای دبلیو اس.اس کیو اس ارسال(پ، صف، "photos/beach.jpg")
    گزینه ها := ای دبلیو اس.گزینه‌های دریافت { بیشترین پیام‌ها = ۱۰، ثانیه انتظار = ۲۰ }
    دسته := ای دبلیو اس.اس کیو اس دریافت(پ، صف، گزینه ها)
    اگر وارونه دسته.موفق:
        سرچاپ "دریافت شکست خورد:"، دسته.کد، دسته.خطا
        برگشت ۱
    پایان
    هر پیام در دسته.پیام‌ها:
        اگر پردازش(پیام.متن):
            _ := ای دبلیو اس.اس کیو اس حذف(پ، صف، پیام.دستگیره دریافت)
        وگرنه:
            _ := ای دبلیو اس.اس کیو اس رها کردن(پ، صف، پیام.دستگیره دریافت)
        پایان
    پایان
    سرچاپ دسته.پیام‌ها.طول()، "پیام پردازش شد"
پایان
