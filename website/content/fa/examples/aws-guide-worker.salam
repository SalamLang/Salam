واردسازی ای دبلیو اس

تابع پردازش(بدنه: رشته): منطقی:
    سرچاپ "تغییر اندازه‌ی"، بدنه
    برگشت بدنه.طول() > ۰
پایان

تابع ریشه:
    پ := ای دبلیو اس.پیکربندی از محیط("")
    اگر پ.access_key.طول() == ۰ یا پ.secret_key.طول() == ۰:
        سرچاپ "AWS_ACCESS_KEY_ID و AWS_SECRET_ACCESS_KEY و AWS_REGION را بگذارید"
        برگشت ۱
    پایان
    صف := ای دبلیو اس.اس کیو اس نشانی صف(پ، "image-jobs")
    اگر صف.طول() == ۰:
        سرچاپ "صف image-jobs وجود ندارد"
        برگشت ۱
    پایان
    _ := ای دبلیو اس.اس کیو اس ارسال(پ، صف، "photos/beach.jpg")
    گزینه ها := ای دبلیو اس.گزینه‌های دریافت { max_messages = ۱۰، wait_seconds = ۲۰ }
    دسته := ای دبلیو اس.اس کیو اس دریافت(پ، صف، گزینه ها)
    اگر وارونه دسته.ok:
        سرچاپ "دریافت شکست خورد:"، دسته.code، دسته.error
        برگشت ۱
    پایان
    هر پیام در دسته.items:
        اگر پردازش(پیام.body):
            _ := ای دبلیو اس.اس کیو اس حذف(پ، صف، پیام.receipt)
        وگرنه:
            _ := ای دبلیو اس.اس کیو اس رها کردن(پ، صف، پیام.receipt)
        پایان
    پایان
    سرچاپ دسته.items.طول()، "پیام پردازش شد"
پایان
