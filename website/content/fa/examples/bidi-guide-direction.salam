واردسازی دوسویه

تابع ریشه:
    خط ها := ["Hello, world"، "سلام دنیا"، "2026 سال خوبی بود"، "Salam یعنی سلام"، "123 456"]
    هر خط در خط ها:
        ناپایا چینش := "چپ"
        اگر دوسویه.تراز بند(خط، دوسویه.جهت خودکار) == ۱:
            چینش = "راست"
        پایان
        سرچاپ چینش، "|"، خط
    پایان
پایان
