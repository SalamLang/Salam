واردسازی دوسویه
واردسازی رشته
واردسازی یونیکد

تابع رسم(خط: رشته): رشته:
    کدها := رشته.کدنقطه ها(خط)
    دیرکن کدها.آزادکن()
    ترازها := دوسویه.ترازها(خط، دوسویه.جهت خودکار)
    دیرکن ترازها.آزادکن()
    ترتیب := دوسویه.ترتیب دیداری(خط، دوسویه.جهت خودکار)
    دیرکن ترتیب.آزادکن()
    ناپایا ب := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(ب)
    هر ش در ترتیب:
        ناپایا کد := کدها.بگیر(ش)
        اگر ترازها.بگیر(ش) % ۲ == ۱:
            کد = یونیکد.کروشه جفت(کد)
        پایان
        رشته.افزودن کدنقطه به بافر(ب، کد)
    پایان
    برگشت رشته.رشته بافر(ب)
پایان

تابع کروشه‌ها(ر: رشته): رشته:
    ناپایا خروجی := ""
    نویسه‌ها := رشته.نویسه ها(ر)
    دیرکن نویسه‌ها.آزادکن()
    هر ن در نویسه‌ها:
        اگر ن == "(" یا ن == ")" یا ن == "[" یا ن == "]":
            خروجی = خروجی + ن
        پایان
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    هر خط در ["قیمت (با مالیات)"، "فصل [۲] و فصل [۳]"]:
        سرچاپ "بازچینش:"، کروشه‌ها(دوسویه.بازچینش(خط، دوسویه.جهت خودکار))، "قرینه‌شده:"، کروشه‌ها(رسم(خط))
    پایان
پایان
