واردسازی دوسویه
واردسازی رشته

تابع ریشه:
    متن := "Salam به معنی peace است"
    نویسه ها := رشته.نویسه ها(متن)
    ترازها := دوسویه.ترازها(متن، دوسویه.جهت راست به چپ)
    ناپایا تکه := ""
    ناپایا تراز := ترازها.بگیر(۰)
    تکرار نویسه ها.طول() در ی:
        اگر ترازها.بگیر(ی) != تراز:
            سرچاپ تراز، "[" + تکه + "]"
            تکه = ""
            تراز = ترازها.بگیر(ی)
        پایان
        تکه = تکه + نویسه ها.بگیر(ی)
    پایان
    سرچاپ تراز، "[" + تکه + "]"
پایان
