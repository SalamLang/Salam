واردسازی دوسویه
واردسازی رشته

تابع ریشه:
    متن := "ab سلام"
    نویسه ها := رشته.نویسه ها(متن)
    ترتیب := دوسویه.ترتیب دیداری(متن، دوسویه.جهت چپ به راست)
    ناپایا کشیده := ""
    هر ستون، شماره در ترتیب:
        سرچاپ ستون، "<-"، شماره، "[" + نویسه ها.بگیر(شماره) + "]"
        کشیده = کشیده + نویسه ها.بگیر(شماره)
    پایان
    سرچاپ کشیده == دوسویه.بازچینش(متن، دوسویه.جهت چپ به راست)
پایان
