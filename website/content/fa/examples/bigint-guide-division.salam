واردسازی عدد بزرگ

تابع نشان بده(برچسب: رشته، عدد: عدد بزرگ.صحیح):
    سرچاپ برچسب، عدد بزرگ.به رشته(عدد)
پایان

تابع ریشه:
    ناپایا موفق := نادرست
    صندوق := عدد بزرگ.تجزیه("1_250_000_000_000_000_000_000"، موفق)
    دیرکن عدد بزرگ.آزادسازی(صندوق)
    برنده‌ها := عدد بزرگ.از صحیح(۷)
    دیرکن عدد بزرگ.آزادسازی(برنده‌ها)
    ناپایا سهم := عدد بزرگ.صفر()
    ناپایا خرده := عدد بزرگ.صفر()
    دیرکن عدد بزرگ.آزادسازی(سهم)
    دیرکن عدد بزرگ.آزادسازی(خرده)
    اگر عدد بزرگ.تقسیم با باقیمانده(صندوق، برنده‌ها، سهم، خرده):
        نشان بده("سهم هر برنده:"، سهم)
        نشان بده("مانده در صندوق:"، خرده)
    پایان
    هیچ‌کس := عدد بزرگ.صفر()
    دیرکن عدد بزرگ.آزادسازی(هیچ‌کس)
    اگر عدد بزرگ.تقسیم با باقیمانده(صندوق، هیچ‌کس، سهم، خرده) برابر نادرست:
        سرچاپ "برنده‌ای نیست: تقسیم با باقیمانده نادرست برگرداند"
    پایان
    بی‌صدا := عدد بزرگ.تقسیم(صندوق، هیچ‌کس)
    دیرکن عدد بزرگ.آزادسازی(بی‌صدا)
    نشان بده("تقسیم بر صفر بی‌صدا می‌دهد"، بی‌صدا)
    بدهی := عدد بزرگ.از صحیح(-۱۰)
    روزها := عدد بزرگ.از صحیح(۳)
    دیرکن عدد بزرگ.آزادسازی(بدهی)
    دیرکن عدد بزرگ.آزادسازی(روزها)
    ناپایا خارج‌قسمت := عدد بزرگ.تقسیم(بدهی، روزها)
    ناپایا مانده := عدد بزرگ.باقیمانده(بدهی، روزها)
    سرچاپ "تقسیم، باقیمانده:"، عدد بزرگ.به رشته(خارج‌قسمت)، عدد بزرگ.به رشته(مانده)
    عدد بزرگ.آزادسازی(خارج‌قسمت)
    عدد بزرگ.آزادسازی(مانده)
    خارج‌قسمت = عدد بزرگ.تقسیم کف(بدهی، روزها)
    مانده = عدد بزرگ.باقیمانده کف(بدهی، روزها)
    سرچاپ "تقسیم کف، باقیمانده کف:"، عدد بزرگ.به رشته(خارج‌قسمت)، عدد بزرگ.به رشته(مانده)
    عدد بزرگ.آزادسازی(خارج‌قسمت)
    عدد بزرگ.آزادسازی(مانده)
    سرچاپ "پیمانه صحیح:"، عدد بزرگ.پیمانه صحیح(بدهی، ۳)
پایان
