واردسازی عدد بزرگ
واردسازی رشته

تابع ریشه:
    ناپایا الف := عدد بزرگ.صفر()
    ناپایا ب := عدد بزرگ.یک()
    تکرار ۱ تا ۳۰۰ در ن:
        بعدی := عدد بزرگ.جمع(الف، ب)
        عدد بزرگ.آزادسازی(الف)
        الف = ب
        ب = بعدی
        اگر ن برابر ۹۲ یا ن برابر ۹۳:
            ناپایا جا شد := نادرست
            مقدار := عدد بزرگ.به صحیح(الف، جا شد)
            سرچاپ "F(" + رشته.از عدد(ن) + ") ="، عدد بزرگ.به رشته(الف)، "در i64 جا می‌شود:"، جا شد، مقدار
        پایان
    پایان
    متن := عدد بزرگ.به رشته(الف)
    سرچاپ "F(300)"، متن.طول()، "رقم دارد"
    سرچاپ متن
    عدد بزرگ.آزادسازی(الف)
    عدد بزرگ.آزادسازی(ب)
پایان
