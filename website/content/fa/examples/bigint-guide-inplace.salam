واردسازی عدد بزرگ

تابع ریشه:
    ناپایا حاصل‌ضرب := عدد بزرگ.یک()
    دیرکن عدد بزرگ.آزادسازی(حاصل‌ضرب)
    تکرار ۱ تا ۵۰ در ی:
        عدد بزرگ.ضرب در صحیح(حاصل‌ضرب، ی برگردان صحیح۶۴)
    پایان
    وارسی := عدد بزرگ.فاکتوریل(۵۰)
    دیرکن عدد بزرگ.آزادسازی(وارسی)
    سرچاپ "!50 ="، عدد بزرگ.به رشته(حاصل‌ضرب)
    سرچاپ "برابر با فاکتوریل(۵۰):"، عدد بزرگ.یکسان است(حاصل‌ضرب، وارسی)
    ناپایا مجموع := عدد بزرگ.صفر()
    دیرکن عدد بزرگ.آزادسازی(مجموع)
    ناپایا توان := عدد بزرگ.یک()
    دیرکن عدد بزرگ.آزادسازی(توان)
    تکرار ۶۴:
        عدد بزرگ.افزودن به(مجموع، توان)
        عدد بزرگ.شیفت چپ در جا(توان، ۱)
    پایان
    سرچاپ "1 + 2 + 4 + ... + 2^63 ="، عدد بزرگ.به رشته(مجموع)
    سرچاپ "یعنی 2^64 - 1:"، عدد بزرگ.یکسان است(مجموع، عدد بزرگ.تفریق صحیح(توان، ۱))
پایان
