واردسازی عدد بزرگ

تابع ریشه:
    ورودی‌ها := ["340282366920938463463374607431768211455"، "-۱۲۳۴۵۶۷۸۹۰۱۲۳۴۵۶۷۸۹۰"، "12a4"، ""]
    هر متن در ورودی‌ها:
        ناپایا موفق := نادرست
        عدد := عدد بزرگ.تجزیه(متن، موفق)
        اگر موفق:
            سرچاپ متن، "->"، عدد بزرگ.طول بیت(عدد)، "بیت، علامت"، عدد بزرگ.علامت(عدد)
        وگرنه:
            سرچاپ "[" + متن + "] عدد صحیح نیست"
        پایان
        عدد بزرگ.آزادسازی(عدد)
    پایان
    ناپایا موفق := نادرست
    کلید := عدد بزرگ.تجزیه با پایه("deadbeefcafebabe0123456789"، ۱۶، موفق)
    سرچاپ موفق، عدد بزرگ.به رشته(کلید)
    سرچاپ "پایه‌ی ۳۶:"، عدد بزرگ.به رشته با پایه(کلید، ۳۶)
    سرچاپ "برگشت به شانزده‌شانزدهی:"، عدد بزرگ.به شانزده‌شانزدهی(کلید)
    سرچاپ "محدود به i64:"، عدد بزرگ.به صحیح محدود(کلید)
    عدد بزرگ.آزادسازی(کلید)
پایان
