واردسازی عدد بزرگ

تابع ریشه:
    پ := عدد بزرگ.از صحیح(۱۰۰۰۰۰۰۰۰۷)
    ق := عدد بزرگ.از صحیح(۹۹۸۲۴۴۳۵۳)
    پیمانه := عدد بزرگ.ضرب(پ، ق)
    فی := عدد بزرگ.ضرب(عدد بزرگ.تفریق صحیح(پ، ۱)، عدد بزرگ.تفریق صحیح(ق، ۱))
    نما := عدد بزرگ.از صحیح(۶۵۵۳۷)
    سرچاپ "کلید عمومی n:"، عدد بزرگ.به رشته(پیمانه)، "e:"، عدد بزرگ.به رشته(نما)
    سرچاپ "ب.م.م(e، phi):"، عدد بزرگ.به رشته(عدد بزرگ.ب م م(نما، فی))
    ناپایا شد := نادرست
    نمای خصوصی := عدد بزرگ.وارون پیمانه‌ای(نما، فی، شد)
    اگر وارونه شد:
        سرچاپ "e وارون ندارد، e دیگری انتخاب کنید"
        برگشت ۱
    پایان
    سرچاپ "نمای خصوصی d:"، عدد بزرگ.به رشته(نمای خصوصی)
    پیام := عدد بزرگ.از صحیح(۴۲۴۲۴۲۴۲۴۲۴۲)
    رمزشده := عدد بزرگ.توان پیمانه‌ای(پیام، نما، پیمانه)
    بازشده := عدد بزرگ.توان پیمانه‌ای(رمزشده، نمای خصوصی، پیمانه)
    سرچاپ "پیام:"، عدد بزرگ.به رشته(پیام)
    سرچاپ "رمزشده:"، عدد بزرگ.به رشته(رمزشده)
    سرچاپ "بازشده:"، عدد بزرگ.به رشته(بازشده)
    سرچاپ "رفت و برگشت درست:"، عدد بزرگ.یکسان است(پیام، بازشده)
    برگشت ۰
پایان
