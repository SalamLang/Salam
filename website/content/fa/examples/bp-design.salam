// زبان: فارسی
واردسازی تبدیل

جداشمار مولفه: قرمز، سبز، آبی پایان

ساختار رنگ:
    همگانی مقدار قرمز: صحیح = ۰
    همگانی مقدار سبز: صحیح = ۰
    همگانی مقدار آبی: صحیح = ۰

    همگانی تابع مقدار(م: مولفه): صحیح:
        برگشت همخوان م:
            قرمز: این.مقدار قرمز پایان
            سبز: این.مقدار سبز پایان
            آبی: این.مقدار آبی پایان
        پایان
    پایان

    همگانی تابع به رشته(): رشته:
        برگشت "rgb(" + این.مقدار قرمز + ", " + این.مقدار سبز + ", " + این.مقدار آبی + ")"
    پایان
پایان

تابع جفت(متن: رشته، از: صحیح): صحیح خطادار:
    برگشت (تلاش تبدیل.تجزیه شانزده(متن.زیررشته(از، ۲))) برگردان صحیح
پایان

تابع خواندن رنگ(متن: رشته): رنگ خطادار:
    ارقام := متن.شروع با("#") ? متن.زیررشته(۱، متن.طول() - ۱) : متن
    اگر ارقام.طول() نابرابر ۶:
        پرتاب خطا خطا.جدید(نوع خطا.آرگومان نامعتبر، "شش رقم شانزده‌دهی لازم است، نه " + ارقام)
    پایان
    برگشت رنگ { مقدار قرمز = تلاش جفت(ارقام، ۰)، مقدار سبز = تلاش جفت(ارقام، ۲)، مقدار آبی = تلاش جفت(ارقام، ۴) }
پایان

تابع مولفه پررنگ(ر: رنگ): مولفه:
    ناپایا بهترین := مولفه.قرمز
    هر م در [مولفه.سبز، مولفه.آبی]:
        اگر ر.مقدار(م) بزرگتر ر.مقدار(بهترین):
            بهترین = م
        پایان
    پایان
    برگشت بهترین
پایان

تابع توضیح(متن: رشته): رشته:
    تلاش:
        ر := تلاش خواندن رنگ(متن)
        برگشت ر.به رشته() + "، پررنگ‌ترین: " + مولفه پررنگ(ر).نام()
    گرفتن خطا خ:
        برگشت "رنگ نامعتبر: " + خ.پیام
    پایان
پایان

تابع ریشه:
    سرچاپ توضیح("#ff8800")
    سرچاپ توضیح("0a141e")
    سرچاپ توضیح("#12")
    سرچاپ توضیح("#gg0000")
پایان
