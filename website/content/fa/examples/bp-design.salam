// زبان: فارسی
واردسازی تبدیل

جداشمار مولفه: قرمز، سبز، آبی پایان

ساختار رنگ:
    همگانی قرمز_مقدار: صحیح = ۰
    همگانی سبز_مقدار: صحیح = ۰
    همگانی آبی_مقدار: صحیح = ۰

    همگانی تابع مقدار(م: مولفه): صحیح:
        برگشت همخوان م:
            قرمز: این.قرمز_مقدار پایان
            سبز: این.سبز_مقدار پایان
            آبی: این.آبی_مقدار پایان
        پایان
    پایان

    همگانی تابع به رشته(): رشته:
        برگشت "rgb(" + این.قرمز_مقدار + ", " + این.سبز_مقدار + ", " + این.آبی_مقدار + ")"
    پایان
پایان

تابع جفت(متن: رشته، از: صحیح): صحیح خطادار:
    برگشت (تلاش تبدیل.تجزیه شانزده(متن.زیررشته(از، ۲))) برگردان صحیح
پایان

تابع خواندن_رنگ(متن: رشته): رنگ خطادار:
    ارقام := متن.شروع با("#") ? متن.زیررشته(۱، متن.طول() - ۱) : متن
    اگر ارقام.طول() نابرابر ۶:
        پرتاب خطا خطا.جدید(نوع خطا.آرگومان نامعتبر، "شش رقم شانزده‌دهی لازم است، نه " + ارقام)
    پایان
    برگشت رنگ { قرمز_مقدار = تلاش جفت(ارقام، ۰)، سبز_مقدار = تلاش جفت(ارقام، ۲)، آبی_مقدار = تلاش جفت(ارقام، ۴) }
پایان

تابع پررنگ‌ترین(ر: رنگ): مولفه:
    ناپایا بهترین := مولفه.قرمز
    هر م در [مولفه.سبز، مولفه.آبی]:
        اگر ر.مقدار(م) بزرگتر ر.مقدار(بهترین):
            بهترین = م
        پایان
    پایان
    برگشت بهترین
پایان

تابع توضیح(متن: رشته): رشته:
    تلاش:
        ر := تلاش خواندن_رنگ(متن)
        برگشت ر.به رشته() + "، پررنگ‌ترین: " + پررنگ‌ترین(ر).نام()
    گرفتن خطا خ:
        برگشت "رنگ نامعتبر: " + خ.پیام
    پایان
پایان

تابع ریشه:
    سرچاپ توضیح("#ff8800")
    سرچاپ توضیح("0a141e")
    سرچاپ توضیح("#12")
    سرچاپ توضیح("#gg0000")
پایان
