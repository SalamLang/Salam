// زبان: فارسی
میانجی شکل:
    تابع مساحت(): اعشار۶۴
پایان

ساختار مربع:
    همگانی ضلع: اعشار۶۴ = ۰.۰
    همگانی تابع مساحت(): اعشار۶۴: برگشت این.ضلع * این.ضلع پایان
پایان

ساختار دایره:
    همگانی شعاع: اعشار۶۴ = ۰.۰
    همگانی تابع مساحت(): اعشار۶۴: برگشت ۳.۰ * این.شعاع * این.شعاع پایان
پایان

تابع بزرگتر_از<T>(الف: T، ب: T): T:
    برگشت الف بزرگتر ب ? الف : ب
پایان

تابع مجموع(شکل ها: وکتور<پویا شکل>): اعشار۶۴:
    ناپایا جمع := ۰.۰
    هر ش در شکل ها:
        جمع += ش.مساحت()
    پایان
    برگشت جمع
پایان

تابع ریشه:
    سرچاپ بزرگتر_از(۳، ۸)، بزرگتر_از("گلابی"، "الف")
    شکل ها := وکتور {} برگردان وکتور<پویا شکل>
    شکل ها.بیفزا(مربع { ضلع = ۲.۰ })
    شکل ها.بیفزا(دایره { شعاع = ۱.۰ })
    سرچاپ مجموع(شکل ها)
    هر ش در شکل ها:
        ش.آزادکن()
    پایان
    شکل ها.آزادکن()
پایان
