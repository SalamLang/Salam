// زبان: فارسی
واردسازی تبدیل

تابع ریشه:
    سرچاپ تبدیل.تجزیه شانزده با پیش فرض("FF"، -۱)، تبدیل.تجزیه شانزده با پیش فرض("0x10"، -۱)
    سرچاپ تبدیل.تجزیه شانزده با پیش فرض("12zz"، -۱)
    تلاش:
        سرچاپ تبدیل.تجزیه شانزده("1a2b")
        سرچاپ تبدیل.تجزیه شانزده("xyz")
    گرفتن خطا خ:
        سرچاپ "عدد شانزده‌دهی نیست:"، خ.پیام
    پایان
پایان
