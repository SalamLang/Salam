واردسازی تقویم

تابع تولد بعدی(زادروز: تقویم.تاریخ جلالی، امروز: تقویم.تاریخ جلالی): تقویم.تاریخ جلالی:
    ناپایا سال هدف := امروز.سال
    ناپایا روز هدف := زادروز.روز
    اگر زادروز.ماه == ۱۲ و روز هدف == ۳۰ و وارونه تقویم.سال کبیسه جلالی(سال هدف):
        روز هدف = ۲۹
    پایان
    ناپایا بعدی := تقویم.تاریخ جلالی { سال = سال هدف، ماه = زادروز.ماه، روز = روز هدف }
    اگر تقویم.مقایسه تاریخ جلالی(بعدی، امروز) < ۰:
        سال هدف += ۱
        روز هدف = زادروز.روز
        اگر زادروز.ماه == ۱۲ و روز هدف == ۳۰ و وارونه تقویم.سال کبیسه جلالی(سال هدف):
            روز هدف = ۲۹
        پایان
        بعدی = تقویم.تاریخ جلالی { سال = سال هدف، ماه = زادروز.ماه، روز = روز هدف }
    پایان
    برگشت بعدی
پایان

تابع ریشه:
    امروز := تقویم.تاریخ جلالی { سال = ۱۴۰۵، ماه = ۷، روز = ۲۵ }
    زادروز := تقویم.تاریخ جلالی { سال = ۱۳۷۰، ماه = ۹، روز = ۳ }
    ناپایا سن := امروز.سال - زادروز.سال
    تولد امسال := تقویم.تاریخ جلالی { سال = امروز.سال، ماه = زادروز.ماه، روز = زادروز.روز }
    اگر تقویم.مقایسه تاریخ جلالی(تولد امسال، امروز) > ۰:
        سن -= ۱
    پایان
    بعدی := تولد بعدی(زادروز، امروز)
    سرچاپ "سن:"، سن
    سرچاپ "تولد بعدی:"، تقویم.قالب جلالی(بعدی)، "(" + تقویم.نام ماه جلالی(بعدی.ماه) + ")"
    سرچاپ "روزهای مانده:"، تقویم.روزهای بین جلالی(امروز، بعدی)
    سرچاپ "به تقویم میلادی:"، تقویم.قالب میلادی(تقویم.جلالی به میلادی(بعدی))
    کبیسه := تقویم.تاریخ جلالی { سال = ۱۴۰۳، ماه = ۱۲، روز = ۳۰ }
    سرچاپ "زاده‌ی ۳۰ اسفند ۱۴۰۳، جشن تولدش در ۱۴۰۵:"، تقویم.قالب جلالی(تولد بعدی(کبیسه، امروز))
پایان
