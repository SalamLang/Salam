واردسازی تقویم

تابع تولد بعدی(زادروز: تقویم.تاریخ جلالی، امروز: تقویم.تاریخ جلالی): تقویم.تاریخ جلالی:
    ناپایا سال هدف := امروز.year
    ناپایا روز هدف := زادروز.day
    اگر زادروز.month == ۱۲ و روز هدف == ۳۰ و وارونه تقویم.سال کبیسه جلالی(سال هدف):
        روز هدف = ۲۹
    پایان
    ناپایا بعدی := تقویم.تاریخ جلالی { year = سال هدف، month = زادروز.month، day = روز هدف }
    اگر تقویم.مقایسه تاریخ جلالی(بعدی، امروز) < ۰:
        سال هدف += ۱
        روز هدف = زادروز.day
        اگر زادروز.month == ۱۲ و روز هدف == ۳۰ و وارونه تقویم.سال کبیسه جلالی(سال هدف):
            روز هدف = ۲۹
        پایان
        بعدی = تقویم.تاریخ جلالی { year = سال هدف، month = زادروز.month، day = روز هدف }
    پایان
    برگشت بعدی
پایان

تابع ریشه:
    امروز := تقویم.تاریخ جلالی { year = ۱۴۰۵، month = ۷، day = ۲۵ }
    زادروز := تقویم.تاریخ جلالی { year = ۱۳۷۰، month = ۹، day = ۳ }
    ناپایا سن := امروز.year - زادروز.year
    تولد امسال := تقویم.تاریخ جلالی { year = امروز.year، month = زادروز.month، day = زادروز.day }
    اگر تقویم.مقایسه تاریخ جلالی(تولد امسال، امروز) > ۰:
        سن -= ۱
    پایان
    بعدی := تولد بعدی(زادروز، امروز)
    سرچاپ "سن:"، سن
    سرچاپ "تولد بعدی:"، تقویم.قالب جلالی(بعدی)، "(" + تقویم.نام ماه جلالی(بعدی.month) + ")"
    سرچاپ "روزهای مانده:"، تقویم.روزهای بین جلالی(امروز، بعدی)
    سرچاپ "به تقویم میلادی:"، تقویم.قالب میلادی(تقویم.جلالی به میلادی(بعدی))
    کبیسه := تقویم.تاریخ جلالی { year = ۱۴۰۳، month = ۱۲، day = ۳۰ }
    سرچاپ "زاده‌ی ۳۰ اسفند ۱۴۰۳، جشن تولدش در ۱۴۰۵:"، تقویم.قالب جلالی(تولد بعدی(کبیسه، امروز))
پایان
