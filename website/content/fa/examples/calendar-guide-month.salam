واردسازی تقویم
واردسازی رشته

تابع ریشه:
    سال نمایش := ۱۴۰۵
    ماه نمایش := ۷
    نخستین := تقویم.تاریخ جلالی { سال = سال نمایش، ماه = ماه نمایش، روز = ۱ }
    سرچاپ تقویم.نام ماه جلالی(ماه نمایش)، سال نمایش
    سرچاپ " ش  ی  د  س  چ  پ  ج"
    جابه‌جایی := تقویم.شماره روز هفته جلالی(تقویم.جلالی به روز ژولیانی(نخستین))
    ناپایا خط := ""
    تکرار جابه‌جایی:
        خط = خط + "   "
    پایان
    روزها := تقویم.روزهای ماه جلالی(سال نمایش، ماه نمایش)
    تکرار ۱ تا روزها در ر:
        اگر ر < ۱۰:
            خط = خط + " "
        پایان
        خط = خط + رشته.از عدد(ر)
        اگر (جابه‌جایی + ر) % ۷ == ۰:
            سرچاپ خط
            خط = ""
        وگرنه:
            خط = خط + " "
        پایان
    پایان
    اگر خط != "":
        سرچاپ خط.پیراست()
    پایان
    سرچاپ "آغاز در"، تقویم.قالب طولانی جلالی(نخستین)، "برابر"، تقویم.قالب میلادی(تقویم.جلالی به میلادی(نخستین))
پایان
