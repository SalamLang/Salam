// زبان: فارسی
بسته ریشه

واردسازی کانال

تابع ریشه:
    c := کانال.جدید(3) برگردان کانال.کانال<رشته>
    سرچاپ "capacity:"، کانال.ظرفیت(c)، "len:"، کانال.طول(c)

    words := وکتور {} برگردان وکتور<رشته>
    words.بیفزا("one")
    words.بیفزا("two")
    سرچاپ "sent:"، کانال.فرستادن همه(c، words)
    سرچاپ "queued:"، کانال.طول(c)
    words.آزادکن()

    ناپایا ok := نادرست
    سرچاپ "first:"، کانال.دریافت(c، ok)، ok
    سرچاپ "next:"، کانال.کوشش برای دریافت(c، ok)، ok
    کانال.بستن(c)
    سرچاپ "closed:"، کانال.بسته است(c)، "send:"، کانال.کوشش برای فرستادن(c، "late")

    left := کانال.تخلیه(c)
    سرچاپ "left:"، left.طول()
    left.آزادکن()
    c.آزادسازی()
پایان
