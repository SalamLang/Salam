واردسازی کانال
واردسازی همگام سازی

ناپایا رویدادها := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
ناپایا فرستنده‌ها := همگام سازی.گروه انتظار {}

تابع حسگر(پایه: صحیح۶۴):
    تکرار ۵ در ای:
        رویدادها.فرستادن(پایه + ای برگردان صحیح۶۴)
    پایان
    همگام سازی.اتمام(فرستنده‌ها)
پایان

تابع حسگر الف(): حسگر(۱۰۰) پایان
تابع حسگر ب(): حسگر(۲۰۰) پایان
تابع حسگر پ(): حسگر(۳۰۰) پایان

تابع بندنده():
    همگام سازی.انتظار(فرستنده‌ها)
    رویدادها.بستن()
پایان

تابع ریشه:
    رویدادها.مقداردهی(۴)
    فرستنده‌ها = همگام سازی.گروه انتظار جدید()
    همگام سازی.افزودن(فرستنده‌ها، ۳)
    الف := نخ‌ساز(حسگر الف)
    ب := نخ‌ساز(حسگر ب)
    پ := نخ‌ساز(حسگر پ)
    ت := نخ‌ساز(بندنده)
    ناپایا سهم حسگرها := [۰، ۰، ۰]
    ناپایا باز := درست
    تا درست:
        م := رویدادها.دریافت(باز)
        اگر وارونه باز:
            بشکن
        پایان
        سهم حسگرها[م / ۱۰۰ - ۱] += ۱
    پایان
    نخ‌پیوند(الف)
    نخ‌پیوند(ب)
    نخ‌پیوند(پ)
    نخ‌پیوند(ت)
    سرچاپ "از حسگر الف:"، سهم حسگرها[۰]
    سرچاپ "از حسگر ب:"، سهم حسگرها[۱]
    سرچاپ "از حسگر پ:"، سهم حسگرها[۲]
    همگام سازی.نابودسازی گروه انتظار(فرستنده‌ها)
    رویدادها.آزادسازی()
پایان
