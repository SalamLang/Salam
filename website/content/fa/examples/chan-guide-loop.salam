واردسازی کانال

ناپایا سفارش‌ها := کانال.کانال {} برگردان کانال.کانال<رشته>

تابع پرداخت():
    هر شناسه در ["A-1001"، "A-1002"، "A-1003"]:
        سفارش‌ها.فرستادن(شناسه)
    پایان
    سفارش‌ها.بستن()
    سرچاپ "پس از بستن، فرستادن کار می‌کند:"، سفارش‌ها.فرستادن("A-1004")
پایان

تابع ریشه:
    سفارش‌ها.مقداردهی(۸)
    ن := نخ‌ساز(پرداخت)
    نخ‌پیوند(ن)
    سرچاپ "منتظر در میان‌گیر:"، سفارش‌ها.طول()
    ناپایا باز := درست
    تا درست:
        شناسه := سفارش‌ها.دریافت(باز)
        اگر وارونه باز: بشکن پایان
        سرچاپ "بسته‌بندی"، شناسه
    پایان
    سرچاپ "بسته و خالی:"، سفارش‌ها.بسته است()، سفارش‌ها.طول()
    سفارش‌ها.آزادسازی()
پایان
