واردسازی کانال

ناپایا عددها := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
ناپایا مربع‌ها := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>

تابع تولید():
    تکرار ۱ تا ۱۰ در ع:
        عددها.فرستادن(ع برگردان صحیح۶۴)
    پایان
    عددها.بستن()
پایان

تابع مربع کردن():
    ناپایا باز := درست
    تا درست:
        ع := عددها.دریافت(باز)
        اگر وارونه باز:
            بشکن
        پایان
        مربع‌ها.فرستادن(ع * ع)
    پایان
    مربع‌ها.بستن()
پایان

تابع ریشه:
    عددها.مقداردهی(۲)
    مربع‌ها.مقداردهی(۲)
    الف := نخ‌ساز(تولید)
    ب := نخ‌ساز(مربع کردن)
    ناپایا جمع := ۰ برگردان صحیح۶۴
    ناپایا شمار := ۰
    ناپایا باز := درست
    تا درست:
        م := مربع‌ها.دریافت(باز)
        اگر وارونه باز:
            بشکن
        پایان
        جمع += م
        شمار += ۱
    پایان
    نخ‌پیوند(الف)
    نخ‌پیوند(ب)
    سرچاپ "مقدارهایی که از خط لوله گذشتند:"، شمار
    سرچاپ "جمع مربع‌ها:"، جمع
    عددها.آزادسازی()
    مربع‌ها.آزادسازی()
پایان
