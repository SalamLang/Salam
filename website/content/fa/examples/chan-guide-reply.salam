واردسازی کانال

ناپایا درخواست‌ها := کانال.کانال {} برگردان کانال.کانال<رشته>
ناپایا پاسخ‌ها := کانال.کانال {} برگردان کانال.کانال<رشته>

تابع کارساز():
    ناپایا باز := درست
    تا درست:
        نام := درخواست‌ها.دریافت(باز)
        اگر وارونه باز:
            بشکن
        پایان
        پاسخ‌ها.فرستادن("سلام، " + نام)
    پایان
پایان

تابع ریشه:
    درخواست‌ها.مقداردهی(۰)
    پاسخ‌ها.مقداردهی(۰)
    ن := نخ‌ساز(کارساز)
    ناپایا باز := درست
    هر نام در ["سارا"، "رضا"، "مینا"]:
        درخواست‌ها.فرستادن(نام)
        سرچاپ پاسخ‌ها.دریافت(باز)
    پایان
    درخواست‌ها.بستن()
    نخ‌پیوند(ن)
    درخواست‌ها.آزادسازی()
    پاسخ‌ها.آزادسازی()
پایان
