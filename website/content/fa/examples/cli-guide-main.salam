واردسازی خط فرمان
واردسازی سیستم عامل

تابع ریشه:
    ناپایا ب := خط فرمان.جدید("notes"، "یادداشت‌های کوتاه نگه می‌دارد"، "1.2.0")
    خط فرمان.ثبت(ب، "new"، "یک یادداشت تازه بنویس")
    خط فرمان.ثبت(ب، "show"، "همه‌ی یادداشت‌ها را چاپ کن")
    آرگ := خط فرمان.آرگومان‌های باقیمانده(سیستم عامل.آرگومان ها())
    دیرکن آرگ.آزادکن()
    دستور := خط فرمان.توزیع(ب، آرگ)
    اگر دستور برابر خط فرمان.دستور راهنما:
        چاپ خط فرمان.راهنما(ب)
        برگشت ۰
    وگرنه دستور برابر خط فرمان.دستور نسخه:
        سرچاپ ب.نسخه
        برگشت ۰
    وگرنه دستور برابر خط فرمان.دستور نامشخص:
        سرچاپ "notes: چنین دستوری نیست:"، آرگ.بگیر(۰)
        برگشت ۲
    پایان
    سرچاپ "اجرای"، دستور، "با"، خط فرمان.آرگومان‌های باقیمانده(آرگ)
    برگشت ۰
پایان
