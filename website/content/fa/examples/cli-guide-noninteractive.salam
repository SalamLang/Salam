واردسازی خط فرمان
واردسازی پرچم
واردسازی رشته

تابع ریشه:
    آرگ := رشته.تفکیک کردن("--name demo"، " ")
    دیرکن آرگ.آزادکن()
    ناپایا پ := پرچم.جدید("init"، "یک پروژه می‌سازد")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن رشته(پ، "name"، ""، ""، "نام پروژه")
    پرچم.افزودن منطقی(پ، "yes"، "y"، نادرست، "تایید نپرس")
    پرچم.تجزیه(پ، آرگ)
    ناپایا نام := پرچم.دریافت رشته(پ، "name")
    اگر نام.طول() برابر ۰: نام = خط فرمان.درخواست با پیش فرض("نام پروژه"، "my-app") پایان
    زبان برنامه := خط فرمان.درخواست با پیش فرض("زبان"، "فارسی")
    سرچاپ ""
    ناپایا ادامه := پرچم.دریافت منطقی(پ، "yes")
    اگر وارونه ادامه: ادامه = خط فرمان.تایید("پروژه‌ی " + نام + " به " + زبان برنامه + " ساخته شود؟") پایان
    سرچاپ ""
    اگر ادامه:
        سرچاپ "ساخته شد:"، نام
    وگرنه:
        سرچاپ "چیزی ساخته نشد؛ برای نپرسیدن --yes را بدهید"
    پایان
پایان
