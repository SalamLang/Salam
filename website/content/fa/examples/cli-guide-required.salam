واردسازی خط فرمان
واردسازی پرچم
واردسازی رشته

تابع استقرار(خط: رشته): صحیح:
    آرگ := رشته.تفکیک کردن(خط، " ")
    دیرکن آرگ.آزادکن()
    ناپایا پ := پرچم.جدید("deploy"، "یک نسخه را بارگذاری می‌کند")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن رشته(پ، "host"، "H"، ""، "سروری که روی آن مستقر می‌شود")
    پرچم.افزودن رشته(پ، "user"، "u"، ""، "نام کاربری")
    پرچم.افزودن صحیح(پ، "port"، "p"، ۲۲، "درگاه SSH")
    اگر وارونه پرچم.تجزیه(پ، آرگ):
        سرچاپ "deploy:"، پرچم.خطا(پ)
        برگشت ۲
    پایان
    ناپایا لازم := وکتور {} برگردان وکتور<رشته>
    دیرکن لازم.آزادکن()
    لازم.بیفزا("host")
    لازم.بیفزا("user")
    جاافتاده := خط فرمان.الزامی بودن پرچم‌ها(پ، لازم)
    دیرکن جاافتاده.آزادکن()
    اگر جاافتاده.طول() بزرگتر ۰:
        سرچاپ "deploy: این پرچم‌ها لازم‌اند: --" + رشته.بپیوند(جاافتاده، "، --")
        برگشت ۲
    پایان
    سرچاپ "استقرار روی"، پرچم.دریافت رشته(پ، "user") + "@" + پرچم.دریافت رشته(پ، "host")، "درگاه"، پرچم.دریافت صحیح(پ، "port")
    برگشت ۰
پایان

تابع ریشه:
    هر خط در ["-H example.com -u sara"، "--host=example.com -p 2222"، "-p 2222"]:
        سرچاپ "$ deploy"، خط
        سرچاپ "کد خروج"، استقرار(خط)
    پایان
پایان
