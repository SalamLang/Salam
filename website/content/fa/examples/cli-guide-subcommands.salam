واردسازی خط فرمان
واردسازی پرچم
واردسازی رشته

تابع دستور افزودن(آرگ: وکتور<رشته>): صحیح:
    ناپایا پ := پرچم.جدید("todo add"، "یک کار می‌افزاید")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن صحیح(پ، "priority"، "p"، ۳، "۱ یعنی فوری‌ترین")
    اگر وارونه پرچم.تجزیه(پ، آرگ):
        سرچاپ "todo add:"، پرچم.خطا(پ)
        برگشت ۲
    پایان
    اگر پرچم.راهنما خواسته(پ):
        چاپ پرچم.راهنما(پ)
        برگشت ۰
    پایان
    واژه‌ها := پرچم.موقعیتی(پ)
    دیرکن واژه‌ها.آزادکن()
    سرچاپ "افزوده شد [" + رشته.بپیوند(واژه‌ها، " ") + "] با اولویت"، پرچم.دریافت صحیح(پ، "priority")
    برگشت ۰
پایان

تابع دستور فهرست(آرگ: وکتور<رشته>): صحیح:
    ناپایا پ := پرچم.جدید("todo list"، "کارها را فهرست می‌کند")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن منطقی(پ، "all"، "a"، نادرست، "کارهای انجام‌شده را هم نشان بده")
    اگر وارونه پرچم.تجزیه(پ، آرگ):
        سرچاپ "todo list:"، پرچم.خطا(پ)
        برگشت ۲
    پایان
    سرچاپ "فهرست"، پرچم.دریافت منطقی(پ، "all") ? "همه‌ی کارها" : "کارهای باز"
    برگشت ۰
پایان

تابع اجرا کن(ب &: خط فرمان.برنامه، خط: رشته): صحیح:
    آرگ := رشته.تفکیک کردن(خط، " ")
    دیرکن آرگ.آزادکن()
    دستور := خط فرمان.توزیع(ب، آرگ)
    باقی := خط فرمان.آرگومان‌های باقیمانده(آرگ)
    دیرکن باقی.آزادکن()
    اگر دستور برابر "add": برگشت دستور افزودن(باقی) پایان
    اگر دستور برابر "list": برگشت دستور فهرست(باقی) پایان
    اگر دستور برابر خط فرمان.دستور نسخه:
        سرچاپ ب.نام، ب.نسخه
        برگشت ۰
    پایان
    اگر دستور برابر خط فرمان.دستور نامشخص: سرچاپ "todo: دستور ناشناخته:"، آرگ.بگیر(۰) پایان
    چاپ خط فرمان.راهنما(ب)
    برگشت دستور برابر خط فرمان.دستور راهنما ? ۰ : ۲
پایان

تابع ریشه:
    ناپایا ب := خط فرمان.جدید("todo"، "یک فهرست کار کوچک"، "0.3.0")
    خط فرمان.ثبت(ب، "add"، "افزودن یک کار")
    خط فرمان.ثبت(ب، "list"، "نمایش کارها")
    هر خط در ["add -p 1 خرید شیر"، "list --all"، "add --priority=high تماس با مادر"، "add --help"، "--version"، "remove 3"]:
        سرچاپ "$ todo"، خط
        سرچاپ "کد خروج"، اجرا کن(ب، خط)
    پایان
پایان
