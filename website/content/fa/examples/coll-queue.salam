واردسازی مجموعه ها

روال ریشه:
    ناپایا صف انتظار := مجموعه ها.صف {} برگردان مجموعه ها.صف<رشته>
    دیرکن صف انتظار.آزادسازی()
    ناپایا منتظرها := مجموعه ها.مجموعه {} برگردان مجموعه ها.مجموعه<رشته>
    دیرکن منتظرها.آزادسازی()

    هر مشتری در ["سارا"، "امید"، "سارا"، "لیلا"، "امید"]:
        اگر منتظرها.دارد(مشتری):
            سرچاپ مشتری، "از پیش در صف است"
            گذر
        پایان
        منتظرها.افزودن(مشتری)
        صف انتظار.وارد کردن(مشتری)
    پایان

    سرچاپ صف انتظار.اندازه()، "نفر در صف، نفر بعدی:"، صف انتظار.مشاهده()
    تا وارونه صف انتظار.خالی است():
        مشتری := صف انتظار.خارج کردن()
        منتظرها.حذف(مشتری)
        سرچاپ "رسیدگی به"، مشتری
    پایان
    سرچاپ منتظرها.خالی است()
پایان
