واردسازی مجموعه ها
واردسازی رشته

تابع متوازن(کد: رشته): منطقی:
    ناپایا بازها := مجموعه ها.پشته {} برگردان مجموعه ها.پشته<رشته>
    دیرکن بازها.آزادسازی()
    نویسه‌ها := رشته.نویسه ها(کد)
    دیرکن نویسه‌ها.آزادکن()
    هر ن در نویسه‌ها:
        اگر ن برابر "(" یا ن برابر "[":
            بازها.افزودن(ن)
        وگرنه ن برابر ")" یا ن برابر "]":
            اگر بازها.خالی است():
                برگشت نادرست
            پایان
            بالا := بازها.برداشتن()
            اگر (ن برابر ")" و بالا != "(") یا (ن برابر "]" و بالا != "["):
                برگشت نادرست
            پایان
        پایان
    پایان
    برگشت بازها.خالی است()
پایان

تابع ریشه:
    سرچاپ متوازن("جمع(الف[۱]، ب[۲])")
    سرچاپ متوازن("ت(ع]")
    سرچاپ متوازن("((ع)")
پایان
