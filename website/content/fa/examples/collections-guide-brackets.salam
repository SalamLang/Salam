واردسازی مجموعه ها
واردسازی رشته

تابع بازکننده(ن: نویسه): نویسه:
    اگر ن برابر ')': برگشت '(' پایان
    اگر ن برابر ']': برگشت '[' پایان
    برگشت '{'
پایان

تابع بررسی(متن: رشته): رشته:
    ناپایا باز := مجموعه ها.پشته {} برگردان مجموعه ها.پشته<نویسه>
    دیرکن باز.آزادسازی()
    تکرار رشته.طول(متن) در ی:
        ن := متن[ی]
        اگر ن برابر '(' یا ن برابر '[' یا ن برابر '{':
            باز.افزودن(ن)
        وگرنه ن برابر ')' یا ن برابر ']' یا ن برابر '}':
            اگر باز.خالی است() یا باز.مشاهده() != بازکننده(ن):
                برگشت "ناجور در جایگاه " + رشته.از عدد(ی)
            پایان
            باز.برداشتن()
        پایان
    پایان
    اگر وارونه باز.خالی است():
        برگشت رشته.از عدد(باز.اندازه()) + " پرانتز باز مانده"
    پایان
    برگشت "متوازن"
پایان

تابع ریشه:
    هر عبارت در ["f(a[1], {b: 2})"، "(1 + 2]"، "{[()]}"، "((x)"، "x)"]:
        سرچاپ عبارت، "->"، بررسی(عبارت)
    پایان
پایان
