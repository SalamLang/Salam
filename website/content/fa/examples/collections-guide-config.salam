واردسازی مجموعه ها
واردسازی رشته

تابع ریشه:
    ناپایا پیکربندی := مجموعه ها.نگاشت مرتب {}
    دیرکن پیکربندی.آزادسازی()
    پیکربندی.تنظیم("host"، "127.0.0.1")
    پیکربندی.تنظیم("port"، "8080")
    پیکربندی.تنظیم("workers"، "4")
    پیکربندی.تنظیم("log"، "info")

    جایگزین‌ها := ["port=9000"، "log=debug"، "tls=on"، "broken"]
    هر خط در جایگزین‌ها:
        برش := رشته.اندیس(خط، "=")
        اگر برش کوچکتر ۰:
            سرچاپ "رد شد:"، خط
            گذر
        پایان
        کلید := خط.زیررشته(۰، برش)
        مقدار := خط.زیررشته(برش + ۱، رشته.طول(خط) - برش - ۱)
        پیشتر بود := پیکربندی.دارد(کلید)
        جایگاه := پیکربندی.تنظیم(کلید، مقدار)
        اگر پیشتر بود:
            سرچاپ "تغییر کرد:"، کلید، "در جایگاه"، جایگاه
        وگرنه:
            سرچاپ "اضافه شد:"، کلید، "در جایگاه"، جایگاه
        پایان
    پایان

    پیکربندی.حذف("workers")
    تکرار پیکربندی.طول() در ی:
        سرچاپ پیکربندی.کلید در(ی) + " = " + پیکربندی.مقدار در(ی)
    پایان
    سرچاپ "timeout:"، پیکربندی.دریافت با پیش فرض("timeout"، "30")
پایان
