واردسازی مجموعه ها

تابع ریشه:
    سقف := ۳
    ناپایا واگرد := مجموعه ها.صف دوسر {} برگردان مجموعه ها.صف دوسر<رشته>
    دیرکن واگرد.آزادسازی()
    ناپایا ازنو := مجموعه ها.پشته {} برگردان مجموعه ها.پشته<رشته>
    دیرکن ازنو.آزادسازی()

    ناپایا سند := ""
    هر واژه در ["سلام"، " زبانی"، " کوچک"، " و"، " فارسی است"]:
        واگرد.افزودن به انتها(سند)
        اگر واگرد.اندازه() بزرگتر سقف:
            واگرد.برداشتن از ابتدا()
        پایان
        ازنو.پاک‌سازی()
        سند = سند + واژه
        سرچاپ "نوشته: [" + سند + "]"
    پایان

    تا وارونه واگرد.خالی است():
        ازنو.افزودن(سند)
        سند = واگرد.برداشتن از انتها()
        سرچاپ "واگرد: [" + سند + "]"
    پایان
    سرچاپ "تاریخچه فقط"، سقف، "گام نگه می‌دارد، پس بقیه از دست رفته‌اند"

    سند = ازنو.برداشتن()
    سرچاپ "ازنو: [" + سند + "]"، ازنو.اندازه()، "گام دیگر برای ازنو"
پایان
