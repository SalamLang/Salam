واردسازی مرتب سازی

ساختار کالا:
    همگانی نام: رشته = ""
    همگانی تعداد: صحیح = ۰
پایان

تابع ریشه:
    ناپایا انبار := نگاشت {} برگردان نگاشت<رشته، کالا>
    دیرکن انبار.آزادکن()
    انبار.درج("TEA-01"، کالا { نام = "چای سبز"، تعداد = ۴۰ })
    انبار.درج("COF-02"، کالا { نام = "دانه‌ی قهوه"، تعداد = ۱۲ })
    انبار.درج("MUG-07"، کالا { نام = "لیوان"، تعداد = ۲ })

    هر کد در ["COF-02"، "MUG-07"، "TEA-01"، "MUG-07"، "BAG-99"]:
        اگر وارونه انبار.دارد(کد):
            سرچاپ "کالای ناشناخته"، کد
            گذر
        پایان
        ناپایا مورد := انبار.بگیر(کد)
        مورد.تعداد -= ۱
        انبار.درج(کد، مورد)
    پایان
    سرچاپ "کلید ناموجود مقدار صفر می‌دهد:"، انبار.بگیر("BAG-99").تعداد

    ناپایا حد سفارش := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن حد سفارش.آزادکن()
    حد سفارش.درج("TEA-01"، ۱۰)

    ناپایا کدها := وکتور {} برگردان وکتور<رشته>
    دیرکن کدها.آزادکن()
    هر کد، مورد در انبار:
        اگر مورد.تعداد بزرگتر ۰:
            کدها.بیفزا(کد)
        وگرنه:
            سرچاپ مورد.نام، "تمام شد"
        پایان
    پایان
    مرتب سازی.مرتب(کدها)
    هر کد در کدها:
        مورد := انبار.بگیر(کد)
        کم است := مورد.تعداد کوچکتربرابر حد سفارش.دریافت با پیش فرض(کد، ۵)
        سرچاپ کد، مورد.نام، مورد.تعداد، "سفارش دوباره:"، کم است
    پایان
پایان
