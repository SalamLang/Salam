واردسازی مجموعه ها

تابع ریشه:
    هزارتو := ["S.#....."، ".##.###."، "....#..."، ".##...#E"]
    سطرها := هزارتو.طول()
    ستون‌ها := ۸
    گام سطر := [-۱، ۱، ۰، ۰]
    گام ستون := [۰، ۰، -۱، ۱]
    ناپایا فاصله := وکتور {} برگردان وکتور<صحیح>
    دیرکن فاصله.آزادکن()
    تکرار سطرها * ستون‌ها:
        فاصله.بیفزا(-۱)
    پایان

    ناپایا نوبت := مجموعه ها.صف {} برگردان مجموعه ها.صف<صحیح>
    دیرکن نوبت.آزادسازی()
    نوبت.وارد کردن(۰)
    فاصله.بنشان(۰، ۰)
    ناپایا هدف := -۱
    تا وارونه نوبت.خالی است():
        خانه := نوبت.خارج کردن()
        س := خانه / ستون‌ها
        ت := خانه % ستون‌ها
        اگر هزارتو[س][ت] برابر 'E':
            هدف = خانه
            بشکن
        پایان
        تکرار ۴ در ج:
            س تازه := س + گام سطر[ج]
            ت تازه := ت + گام ستون[ج]
            اگر س تازه بزرگتربرابر ۰ و س تازه کوچکتر سطرها و ت تازه بزرگتربرابر ۰ و ت تازه کوچکتر ستون‌ها:
                همسایه := س تازه * ستون‌ها + ت تازه
                اگر هزارتو[س تازه][ت تازه] != '#' و فاصله.بگیر(همسایه) برابر -۱:
                    فاصله.بنشان(همسایه، فاصله.بگیر(خانه) + ۱)
                    نوبت.وارد کردن(همسایه)
                پایان
            پایان
        پایان
    پایان
    سرچاپ "کوتاه‌ترین راه تا E:"، فاصله.بگیر(هدف)، "گام"
    ناپایا دیده‌شده := ۰
    هر ف در فاصله:
        اگر ف بزرگتربرابر ۰: دیده‌شده += ۱ پایان
    پایان
    سرچاپ "خانه‌های رسیده:"، دیده‌شده، "از"، سطرها * ستون‌ها
پایان
