واردسازی مجموعه ها

تابع ریشه:
    کارها := ["پشتیبان‌گیری شبانه"، "فرستادن فاکتورها"، "کوچک کردن تصویرها"، "خبر دادن به کشیک"، "بازسازی نمایه"]
    فوریت := [۳، ۲، ۳، ۱، ۲]
    ناپایا صف := مجموعه ها.صف اولویت دار {} برگردان مجموعه ها.صف اولویت دار<صحیح۶۴>
    دیرکن صف.آزادسازی()
    تکرار کارها.طول() در ی:
        صف.افزودن((فوریت[ی] برگردان صحیح۶۴) * ۱۰۰۰ + (ی برگردان صحیح۶۴))
    پایان
    تا وارونه صف.خالی است():
        کلید := صف.برداشتن()
        سرچاپ "فوریت"، کلید / ۱۰۰۰، کارها[(کلید % ۱۰۰۰) برگردان صحیح]
    پایان

    ناپایا بزرگ‌ترها := مجموعه ها.صف اولویت دار {} برگردان مجموعه ها.صف اولویت دار<صحیح>
    دیرکن بزرگ‌ترها.آزادسازی()
    هر حجم در [۱۲۰، ۴۸۰۰، ۳۵، ۹۹۰]:
        بزرگ‌ترها.افزودن(۰ - حجم)
    پایان
    سرچاپ "بزرگ‌ترین بارگذاری اول:"، ۰ - بزرگ‌ترها.برداشتن()، "کیلوبایت، بعد"، ۰ - بزرگ‌ترها.مشاهده()، "کیلوبایت"
پایان
