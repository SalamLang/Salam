واردسازی مجموعه ها

تابع ریشه:
    ناپایا نوبت := وکتور {} برگردان وکتور<رشته>
    دیرکن نوبت.آزادکن()
    هر نام در ["علی"، "سارا"، "رضا"]:
        نوبت.بیفزا(نام)
    پایان
    نوبت.درج(۱، "مینا")
    سرچاپ "پس از درج:"، نوبت
    رفته := نوبت.حذف در(۰)
    سرچاپ "نوبت"، رفته، "رسید ->"، نوبت
    سرچاپ "رضا در جایگاه"، مجموعه ها.اندیس(نوبت، "رضا")، "و امید در"، مجموعه ها.اندیس(نوبت، "امید")

    پشتیبان := مجموعه ها.رونوشت(نوبت)
    دیرکن پشتیبان.آزادکن()
    نام دیگر := نوبت
    نام دیگر.بنشان(۰، "ندا")
    سرچاپ "نام دیگر در نوبت نوشت:"، نوبت.بگیر(۰)
    سرچاپ "رونوشت نگه داشت:     "، پشتیبان.بگیر(۰)

    جلو := مجموعه ها.برش(نوبت، ۰، ۲)
    دیرکن جلو.آزادکن()
    سرچاپ "دو نفر اول:"، جلو، "آخری:"، نوبت.آخر()
پایان
