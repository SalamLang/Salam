واردسازی مجموعه ها
واردسازی مرتب سازی
واردسازی رشته

تابع ریشه:
    متن := "باد آمد و بوی گل آمد و باران آمد"
    ناپایا شمار := مجموعه ها.شمارنده {} برگردان مجموعه ها.شمارنده<رشته>
    دیرکن شمار.آزادسازی()
    ناپایا دیده‌شده := مجموعه ها.مجموعه {} برگردان مجموعه ها.مجموعه<رشته>
    دیرکن دیده‌شده.آزادسازی()
    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    دیرکن ترتیب.آزادکن()

    هر واژه در رشته.واژه ها(متن):
        شمار.افزودن(واژه)
        اگر وارونه دیده‌شده.دارد(واژه):
            دیده‌شده.افزودن(واژه)
            ترتیب.بیفزا(واژه)
        پایان
    پایان
    سرچاپ شمار.متمایز()، "واژه‌ی متفاوت، به ترتیب نخستین کاربرد:"
    سرچاپ ترتیب

    مرتب سازی.مرتب سازی ترتیب‌نگه‌دار با(ترتیب، (الف: رشته، ب: رشته): برگشت شمار.شمارش(الف) بزرگتر شمار.شمارش(ب) پایان)
    سرچاپ "پرکاربردترین‌ها:"
    تکرار ۳ در ی:
        واژه := ترتیب.بگیر(ی)
        سرچاپ "  " + واژه، شمار.شمارش(واژه)
    پایان
پایان
