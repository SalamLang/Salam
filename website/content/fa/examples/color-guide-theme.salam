واردسازی رابط گرافیکی.رنگ
واردسازی ریاضی

تابع r2(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 100.0) / 100.0
پایان

تابع check(name: رشته، text: رنگ.رنگ، back: رنگ.رنگ):
    light := رنگ.نسبت تضاد(رنگ.روشن(text)، رنگ.روشن(back))
    dark := رنگ.نسبت تضاد(رنگ.تیره(text)، رنگ.تیره(back))
    ناپایا verdict := "ok"
    اگر light کوچکتر 4.5 یا dark کوچکتر 4.5:
        verdict = "too low for body text"
    پایان
    سرچاپ name، "light"، r2(light)، "dark"، r2(dark)، verdict
پایان

تابع ریشه:
    ناپایا brand := رنگ.رنگ {}
    اگر وارونه رنگ.تجزیه("#3366aa"، brand):
        برگشت 1
    پایان
    page := رنگ.روشن تیره(رنگ.هگز(0xffffff)، رنگ.هگز(0x121212))
    text := رنگ.روشن تیره(رنگ.هگز(0x1a1a1a)، رنگ.هگز(0xeeeeee))
    accent := رنگ.روشن تیره(brand، رنگ.روشن تر(brand، 0.2))
    muted := رنگ.آمیختن(text، page، 0.45)
    hover := رنگ.روشن تیره(رنگ.تیره تر(brand، 0.08)، رنگ.روشن تر(brand، 0.28))
    سرچاپ "page   "، رنگ.سی اس اس(page)
    سرچاپ "text   "، رنگ.سی اس اس(text)
    سرچاپ "accent "، رنگ.سی اس اس(accent)
    سرچاپ "muted  "، رنگ.سی اس اس(muted)
    سرچاپ "hover  "، رنگ.سی اس اس(hover)
    check("text on page  "، text، page)
    check("accent on page"، accent، page)
    check("muted on page "، muted، page)
پایان
