واردسازی فشرده سازی

تابع ریشه:
    واژه‌ها := ["سلام"، "فشرده"، "بلوک"، "مرتب"، "جریان"، "بایت"، "جدول"، "کد"، "بیت"، "تکرار"]
    ناپایا متن := ""
    ناپایا ع := ۷
    تکرار ۴۰۰۰:
        ع = (ع * ۷۵ + ۷۴) % ۶۵۵۳۷
        متن += واژه‌ها[ع % ۱۰]
        متن += " "
    پایان
    ج := فشرده سازی.فشرده سازی جی زیپ رشته(متن)
    ب := فشرده سازی.فشرده سازی بی زیپ دو رشته(متن)
    سرچاپ "اصلی:"، متن.طول()، "بایت"
    سرچاپ "جی‌زیپ:"، ج.طول، "بایت"
    سرچاپ "بی‌زیپ۲:"، ب.طول، "بایت"
    ناپایا خوب := نادرست
    برگشتی := فشرده سازی.کدگشایی بی زیپ دو بافر(ب، خوب)
    سرچاپ "بازگردانی:"، خوب، فشرده سازی.بافر به رشته(برگشتی) == متن
    _ := فشرده سازی.کدگشایی بی زیپ دو با سقف(ب.داده، ب.طول، ۱۰۰۰، خوب)
    سرچاپ "با سقف ۱۰۰۰ بایت:"، خوب
    ناپایا خراب := فشرده سازی.کپی بافر(ب)
    فشرده سازی.تنظیم بایت(خراب، خراب.طول / ۲، فشرده سازی.دریافت بایت(خراب، خراب.طول / ۲) ^ ۱)
    _ := فشرده سازی.کدگشایی بی زیپ دو بافر(خراب، خوب)
    سرچاپ "خراب:"، خوب
پایان
