واردسازی فشرده سازی
واردسازی رشته

تابع نام روش(روش: صحیح): رشته:
    ترابرد روش:
        فشرده سازی.روش آر ال ای: برگشت "rle" پایان
        فشرده سازی.روش هافمن: برگشت "huffman" پایان
        فشرده سازی.روش الزد۷۷: برگشت "lz77" پایان
        فشرده سازی.روش ال زد دبلیو: برگشت "lzw" پایان
        فشرده سازی.روش دیفلیت: برگشت "deflate" پایان
        فشرده سازی.روش باروز ویلر: برگشت "bwt" پایان
    پایان
    برگشت "هیچ (بی‌فشرده)"
پایان

تابع ردیف(برچسب: رشته، داده: رشته):
    ب := فشرده سازی.بافر از رشته(داده)
    ناپایا سطر := برچسب + ": " + رشته.از عدد(ب.طول) + " بایت، rle " + رشته.از عدد(فشرده سازی.فشرده سازی بافر(فشرده سازی.روش آر ال ای، ب).طول)
    سطر = سطر + "، lz77 " + رشته.از عدد(فشرده سازی.فشرده سازی بافر(فشرده سازی.روش الزد۷۷، ب).طول)
    سطر = سطر + "، gzip " + رشته.از عدد(فشرده سازی.فشرده سازی جی زیپ بافر(ب).طول)
    ناپایا بهترین := ۰
    کوچک‌ترین := فشرده سازی.بهترین فشرده سازی(ب.داده، ب.طول، بهترین)
    سرچاپ سطر
    سرچاپ "  بهترین:"، نام روش(بهترین)، "با"، کوچک‌ترین.طول، "بایت"
پایان

تابع ریشه:
    ناپایا تکراری := ""
    تکرار ۲۰۰: تکراری = تکراری + "0" پایان
    ناپایا واژه‌ها := ""
    تکرار ۱۰: واژه‌ها = واژه‌ها + "خطا در سطر ۴۲; " پایان
    ردیف("تکراری"، تکراری)
    ردیف("واژه‌ها"، واژه‌ها)
    ردیف("کوتاه"، "سلام")
پایان
