واردسازی فشرده سازی
واردسازی کدگذاری

تابع ریشه:
    ناپایا گزارش := ""
    تکرار ۲۰:
        گزارش = گزارش + "GET /api/users 200 12ms\n"
    پایان
    فشرده := فشرده سازی.فشرده سازی جی زیپ رشته(گزارش)
    سرچاپ "اصلی:"، گزارش.طول()، "بایت"
    سرچاپ "جی‌زیپ:"، فشرده.طول، "بایت"
    سرچاپ "نسبت:"، فشرده سازی.نسبت(فشرده.طول، گزارش.طول())
    متن := فشرده سازی.بافر به پایه۶۴(فشرده)
    سرچاپ "پایه۶۴:"، متن.طول()، "نویسه"
    ناپایا خوب := نادرست
    ناپایا رسیده := فشرده سازی.بافر بایت جدید با ظرفیت(متن.طول())
    رسیده.طول = کدگذاری.کدگشایی پایه۶۴ به بایت(متن، رسیده.داده، متن.طول()، خوب)
    سرچاپ "کدگشایی:"، خوب، فشرده سازی.برابری بافر(رسیده، فشرده)
    برگشتی := فشرده سازی.کدگشایی جی زیپ بافر(رسیده، خوب)
    سرچاپ "بازگردانی:"، خوب، فشرده سازی.بافر به رشته(برگشتی) == گزارش
پایان
