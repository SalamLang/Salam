واردسازی فشرده سازی

تابع نوشتن نام‌ها(نام‌ها: وکتور<رشته>): فشرده سازی.بافر بایت:
    ناپایا ب := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بافر(ب، فشرده سازی.بافر از رشته("NAMS"))
    فشرده سازی.افزودن عدد۳۲(ب، نام‌ها.طول())
    هر نام در نام‌ها:
        فشرده سازی.افزودن عدد۳۲(ب، نام.طول())
        فشرده سازی.افزودن بافر(ب، فشرده سازی.بافر از رشته(نام))
    پایان
    برگشت ب
پایان

تابع خواندن نام‌ها(ب: فشرده سازی.بافر بایت):
    ناپایا خ := فشرده سازی.خواننده از بافر(ب)
    نشانه := فشرده سازی.خواندن بایت‌ها(خ، ۴)
    اگر فشرده سازی.بافر به رشته(نشانه) != "NAMS":
        سرچاپ "این پرونده‌ی نام‌ها نیست"
        برگشت
    پایان
    شمار := فشرده سازی.خواندن عدد۳۲(خ)
    تکرار شمار در ی:
        طول نام := فشرده سازی.خواندن عدد۳۲(خ)
        نام := فشرده سازی.خواندن بایت‌ها(خ، طول نام)
        اگر خ.خراب:
            سرچاپ "رکورد"، ی، "ناقص است"
            برگشت
        پایان
        سرچاپ ی، فشرده سازی.بافر به رشته(نام)
    پایان
پایان

تابع ریشه:
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    نام‌ها.بیفزا("آدا")
    نام‌ها.بیفزا("گریس")
    نام‌ها.بیفزا("لینوس")
    ب := نوشتن نام‌ها(نام‌ها)
    سرچاپ "بایت‌ها:"، فشرده سازی.طول بافر(ب)
    خواندن نام‌ها(ب)
    ناپایا بریده := فشرده سازی.خواننده بایت جدید(ب.داده، ۲۰)
    خواندن نام‌ها(فشرده سازی.خواندن بایت‌ها(بریده، ۲۰))
پایان
