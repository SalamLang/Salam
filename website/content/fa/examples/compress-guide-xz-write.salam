بسته ریشه

واردسازی فشرده سازی

تابع ریشه:
    text := "the quick brown fox jumps over the lazy dog. " * 50
    ناپایا ok := نادرست

    xz := فشرده سازی.فشرده سازی ایکس زد رشته(text)
    back := فشرده سازی.کدگشایی ایکس زد بافر(xz، ok)
    سرچاپ ".xz:"، text.طول()، "to"، xz.طول، "bytes"، ok، back.طول
    سرچاپ "magic:"، فشرده سازی.دریافت بایت(xz، 0)، فشرده سازی.دریافت بایت(xz، 1)، فشرده سازی.دریافت بایت(xz، 2)

    fast := فشرده سازی.فشرده سازی ایکس زد با سطح(text برگردان تهی*، text.طول()، 0)
    best := فشرده سازی.فشرده سازی ایکس زد با سطح(text برگردان تهی*، text.طول()، 9)
    سرچاپ "levels:"، fast.طول، best.طول

    none := فشرده سازی.فشرده سازی ایکس زد با بررسی(text برگردان تهی*، text.طول()، 6، فشرده سازی.بررسی ایکس زد هیچ)
    sha := فشرده سازی.فشرده سازی ایکس زد با بررسی(text برگردان تهی*، text.طول()، 6، فشرده سازی.بررسی ایکس زد شا۲۵۶)
    سرچاپ "checks:"، none.طول، xz.طول، sha.طول
    small := فشرده سازی.کدگشایی ایکس زد بافر(sha، ok)
    سرچاپ "sha256 stream:"، ok، small.طول

    lz := فشرده سازی.فشرده سازی الزد ام ای رشته(text)
    again := فشرده سازی.کدگشایی الزد ام ای بافر(lz، ok)
    سرچاپ ".lzma:"، lz.طول، "bytes"، ok، again.طول
    lz9 := فشرده سازی.فشرده سازی الزد ام ای با سطح(text برگردان تهی*، text.طول()، 9)
    سرچاپ "level 9:"، lz9.طول
    buf := فشرده سازی.فشرده سازی الزد ام ای بافر(back)
    سرچاپ "buffer:"، فشرده سازی.برابری بافر(buf، lz)
    سرچاپ "empty:"، فشرده سازی.فشرده سازی ایکس زد بافر(فشرده سازی.بافر بایت جدید()).طول
پایان
