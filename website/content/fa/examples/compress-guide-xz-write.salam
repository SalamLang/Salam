بسته ریشه

واردسازی فشرده سازی

تابع ریشه:
    متن := "the quick brown fox jumps over the lazy dog. " * 50
    ناپایا موفق := نادرست

    ایکس‌زد := فشرده سازی.فشرده سازی ایکس زد رشته(متن)
    بازگشت := فشرده سازی.کدگشایی ایکس زد بافر(ایکس‌زد، موفق)
    سرچاپ ".xz:"، متن.طول()، "to"، ایکس‌زد.طول، "bytes"، موفق، بازگشت.طول
    سرچاپ "magic:"، فشرده سازی.دریافت بایت(ایکس‌زد، 0)، فشرده سازی.دریافت بایت(ایکس‌زد، 1)، فشرده سازی.دریافت بایت(ایکس‌زد، 2)

    سریع := فشرده سازی.فشرده سازی ایکس زد با سطح(متن برگردان تهی*، متن.طول()، 0)
    بهترین := فشرده سازی.فشرده سازی ایکس زد با سطح(متن برگردان تهی*، متن.طول()، 9)
    سرچاپ "levels:"، سریع.طول، بهترین.طول

    هیچ := فشرده سازی.فشرده سازی ایکس زد با بررسی(متن برگردان تهی*، متن.طول()، 6، فشرده سازی.بررسی ایکس زد هیچ)
    درهم := فشرده سازی.فشرده سازی ایکس زد با بررسی(متن برگردان تهی*، متن.طول()، 6، فشرده سازی.بررسی ایکس زد شا۲۵۶)
    سرچاپ "checks:"، هیچ.طول، ایکس‌زد.طول، درهم.طول
    کوچک := فشرده سازی.کدگشایی ایکس زد بافر(درهم، موفق)
    سرچاپ "sha256 stream:"، موفق، کوچک.طول

    الزد := فشرده سازی.فشرده سازی الزد ام ای رشته(متن)
    بازهم := فشرده سازی.کدگشایی الزد ام ای بافر(الزد، موفق)
    سرچاپ ".lzma:"، الزد.طول، "bytes"، موفق، بازهم.طول
    الزد۹ := فشرده سازی.فشرده سازی الزد ام ای با سطح(متن برگردان تهی*، متن.طول()، 9)
    سرچاپ "level 9:"، الزد۹.طول
    بافر := فشرده سازی.فشرده سازی الزد ام ای بافر(بازگشت)
    سرچاپ "buffer:"، فشرده سازی.برابری بافر(بافر، الزد)
    سرچاپ "empty:"، فشرده سازی.فشرده سازی ایکس زد بافر(فشرده سازی.بافر بایت جدید()).طول
پایان
