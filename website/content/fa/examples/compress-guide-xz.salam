// زبان: فارسی
واردسازی فشرده سازی

پایا PACKED := """
fd377a585a000004e6d6b44604c05fcf022101160000000000000000bb0ccf6ce0014e00575d0029984986240afb8a34e4
81db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eba071037cdd425338444ede
4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602aacf40a000005b35fff6fd65c4e300017bcf020000005e9efc
63b1c467fb020000000004595a
"""

تابع nib(نویسه: صحیح): صحیح:
    اگر نویسه بزرگتربرابر 48 و نویسه کوچکتربرابر 57:
        برگشت نویسه - 48
    پایان
    اگر نویسه بزرگتربرابر 97 و نویسه کوچکتربرابر 102:
        برگشت نویسه - 87
    پایان
    برگشت -1
پایان

تابع unhex(متن_نمونه: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := متن_نمونه برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار متن_نمونه.طول() در شمارنده:
        مقدار_محلی := nib(نشانگر_بایت[شمارنده] برگردان صحیح)
        اگر مقدار_محلی کوچکتر 0:
            گذر
        پایان
        اگر بالا کوچکتر 0:
            بالا = مقدار_محلی
        وگرنه:
            فشرده سازی.افزودن بایت(بافر_محلی، بالا * 16 + مقدار_محلی)
            بالا = -1
        پایان
    پایان
    برگشت بافر_محلی
پایان

تابع ریشه:
    بسته_شده := unhex(PACKED)
    ناپایا موفق := نادرست
    متن := فشرده سازی.کدگشایی ایکس زد بافر(بسته_شده، موفق)
    سرچاپ "کدگشایی شد:"، موفق، متن.طول، "بایت از"، بسته_شده.طول
    سرچاپ فشرده سازی.بافر به رشته(متن)

    ناپایا آسیب‌دیده := فشرده سازی.کپی بافر(بسته_شده)
    فشرده سازی.تنظیم بایت(آسیب‌دیده، آسیب‌دیده.طول - 20، فشرده سازی.دریافت بایت(آسیب‌دیده، آسیب‌دیده.طول - 20) ^ 1)
    خراب := فشرده سازی.کدگشایی ایکس زد بافر(آسیب‌دیده، موفق)
    سرچاپ "پرونده خراب:"، موفق، خراب.طول

    کوچک := فشرده سازی.کدگشایی ایکس زد با سقف(بسته_شده.داده، بسته_شده.طول، 100، موفق)
    سرچاپ "سقف ۱۰۰ بایت:"، موفق، کوچک.طول
پایان
