// زبان: فارسی
واردسازی فشرده سازی

پایا PACKED := """
fd377a585a000004e6d6b44604c05fcf022101160000000000000000bb0ccf6ce0014e00575d0029984986240afb8a34e4
81db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eba071037cdd425338444ede
4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602aacf40a000005b35fff6fd65c4e300017bcf020000005e9efc
63b1c467fb020000000004595a
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع ریشه:
    packed := unhex(PACKED)
    ناپایا ok := نادرست
    text := فشرده سازی.کدگشایی ایکس زد بافر(packed، ok)
    سرچاپ "کدگشایی شد:"، ok، text.طول، "بایت از"، packed.طول
    سرچاپ فشرده سازی.بافر به رشته(text)

    ناپایا damaged := فشرده سازی.کپی بافر(packed)
    فشرده سازی.تنظیم بایت(damaged، damaged.طول - 20، فشرده سازی.دریافت بایت(damaged، damaged.طول - 20) ^ 1)
    broken := فشرده سازی.کدگشایی ایکس زد بافر(damaged، ok)
    سرچاپ "پرونده خراب:"، ok، broken.طول

    small := فشرده سازی.کدگشایی ایکس زد با سقف(packed.داده، packed.طول، 100، ok)
    سرچاپ "سقف ۱۰۰ بایت:"، ok، small.طول
پایان
