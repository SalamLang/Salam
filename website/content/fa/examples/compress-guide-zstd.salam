// زبان: فارسی
واردسازی فشرده سازی

پایا PACKED := """
28b52ffd6459008502009285111290cf0184e3820d4c2042136477707af2ed3a409c9edcb0e3e7730fed14fb943c8038
53dea7a9ea4f2fc3f0527dda9e972a958b464c916376e4546b1cd18bf07ca9de9831090100407fa04214ee20b3a1
"""

تابع nib(نویسه: صحیح): صحیح:
    اگر نویسه بزرگتربرابر 48 و نویسه کوچکتربرابر 57:
        برگشت نویسه - 48
    پایان
    اگر نویسه بزرگتربرابر 97 و نویسه کوچکتربرابر 102:
        برگشت نویسه - 87
    پایان
    برگشت -1
پایان

تابع unhex(متن_نمونه: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := متن_نمونه برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار متن_نمونه.طول() در شمارنده:
        مقدار_محلی := nib(نشانگر_بایت[شمارنده] برگردان صحیح)
        اگر مقدار_محلی کوچکتر 0:
            گذر
        پایان
        اگر بالا کوچکتر 0:
            بالا = مقدار_محلی
        وگرنه:
            فشرده سازی.افزودن بایت(بافر_محلی، بالا * 16 + مقدار_محلی)
            بالا = -1
        پایان
    پایان
    برگشت بافر_محلی
پایان

تابع ریشه:
    بسته_شده := unhex(PACKED)
    ناپایا موفق := نادرست
    متن := فشرده سازی.کدگشایی زستد بافر(بسته_شده، موفق)
    سرچاپ "کدگشایی:"، موفق، متن.طول، "بایت از"، بسته_شده.طول
    سرچاپ فشرده سازی.بافر به رشته(متن)

    ناپایا آسیب‌دیده := فشرده سازی.کپی بافر(بسته_شده)
    فشرده سازی.تنظیم بایت(آسیب‌دیده، آسیب‌دیده.طول - 20، فشرده سازی.دریافت بایت(آسیب‌دیده، آسیب‌دیده.طول - 20) ^ 1)
    ناپایا وضعیت := 0
    خراب := فشرده سازی.کدگشایی زستد با جزئیات(آسیب‌دیده.داده، آسیب‌دیده.طول، 0، پوچ، 0، وضعیت)
    سرچاپ "پرونده آسیب‌دیده:"، وضعیت، فشرده سازی.متن وضعیت زستد(وضعیت)، خراب.طول

    کوچک := فشرده سازی.کدگشایی زستد با سقف(بسته_شده.داده، بسته_شده.طول، 100، موفق)
    سرچاپ "سقف ۱۰۰ بایت:"، موفق، کوچک.طول

    مال_من := فشرده سازی.فشرده سازی زستد با سطح(متن.داده، متن.طول، 19)
    بازهم := فشرده سازی.کدگشایی زستد بافر(مال_من، موفق)
    سرچاپ "قاب خودمان:"، مال_من.طول، "بایت،"، فشرده سازی.برابری بافر(بازهم، متن)
    سرچاپ "اندازه ثبت‌شده در سرآیند:"، فشرده سازی.اندازه محتوای زستد(مال_من.داده، مال_من.طول)
پایان
