// زبان: فارسی
واردسازی فشرده سازی

پایا PACKED := """
28b52ffd6459008502009285111290cf0184e3820d4c2042136477707af2ed3a409c9edcb0e3e7730fed14fb943c8038
53dea7a9ea4f2fc3f0527dda9e972a958b464c916376e4546b1cd18bf07ca9de9831090100407fa04214ee20b3a1
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع ریشه:
    packed := unhex(PACKED)
    ناپایا ok := نادرست
    text := فشرده سازی.کدگشایی زستد بافر(packed، ok)
    سرچاپ "کدگشایی:"، ok، text.طول، "بایت از"، packed.طول
    سرچاپ فشرده سازی.بافر به رشته(text)

    ناپایا damaged := فشرده سازی.کپی بافر(packed)
    فشرده سازی.تنظیم بایت(damaged، damaged.طول - 20، فشرده سازی.دریافت بایت(damaged، damaged.طول - 20) ^ 1)
    ناپایا status := 0
    broken := فشرده سازی.کدگشایی زستد با جزئیات(damaged.داده، damaged.طول، 0، پوچ، 0، status)
    سرچاپ "پرونده آسیب‌دیده:"، status، فشرده سازی.متن وضعیت زستد(status)، broken.طول

    small := فشرده سازی.کدگشایی زستد با سقف(packed.داده، packed.طول، 100، ok)
    سرچاپ "سقف ۱۰۰ بایت:"، ok، small.طول

    mine := فشرده سازی.فشرده سازی زستد با سطح(text.داده، text.طول، 19)
    again := فشرده سازی.کدگشایی زستد بافر(mine، ok)
    سرچاپ "قاب خودمان:"، mine.طول، "بایت،"، فشرده سازی.برابری بافر(again، text)
    سرچاپ "اندازه ثبت‌شده در سرآیند:"، فشرده سازی.اندازه محتوای زستد(mine.داده، mine.طول)
پایان
