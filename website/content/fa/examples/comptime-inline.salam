تابع پوشه تنظیمات(برنامه: رشته): رشته:
    اگر سلام سیستم ویندوز:
        برگشت "C:\\Users\\Public\\AppData\\" + برنامه
    وگرنه سلام سیستم مک:
        برگشت "/Users/Shared/Library/Application Support/" + برنامه
    وگرنه:
        برگشت "/etc/" + برنامه
    پایان
پایان

تابع ریشه:
    سرچاپ پوشه تنظیمات("salam")
    اگر سلام سیستم یونیکس:
        سرچاپ "دسترسی: chmod 600"
    پایان
پایان
