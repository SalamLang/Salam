اگر سلام ایمن:
    پایا ساخت := "اشکال‌زدایی"
وگرنه:
    پایا ساخت := "انتشار"
پایان

روال جستجو(عددها: صحیح[]، خواسته: صحیح): صحیح:
    اگر سلام ایمن:
        تکرار طول(عددها) - ۱ در ای:
            اگر عددها[ای] > عددها[ای + ۱]:
                نادرست‌سرچاپ "جستجو: ورودی مرتب نیست"
                بشکن
            پایان
        پایان
    پایان
    ناپایا پایین := ۰
    ناپایا بالا := طول(عددها) - ۱
    تا پایین <= بالا:
        وسط := (پایین + بالا) / ۲
        اگر عددها[وسط] == خواسته:
            برگشت وسط
        وگرنه عددها[وسط] < خواسته:
            پایین = وسط + ۱
        وگرنه:
            بالا = وسط - ۱
        پایان
    پایان
    برگشت -۱
پایان

روال ریشه:
    سرچاپ "ساخت:"، ساخت
    سرچاپ جستجو([۲، ۵، ۸، ۱۳، ۲۱]، ۱۳)
    سرچاپ جستجو([۹، ۴، ۷، ۱]، ۹)
پایان
