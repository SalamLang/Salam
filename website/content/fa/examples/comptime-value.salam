روال خانواده(): رشته:
    ترابرد سلام سیستم:
        "linux"، "android":
            برگشت "لینوکس"
        پایان
        "mac"، "freebsd"، "openbsd"، "netbsd":
            برگشت "بی‌اس‌دی"
        پایان
        "windows":
            برگشت "ویندوز"
        پایان
        وگرنه:
            برگشت "دیگر"
        پایان
    پایان
پایان

روال ریشه:
    سرچاپ "ساخته‌شده برای"، سلام سیستم، "روی"، سلام معماری
    سرچاپ "خانواده:"، خانواده()
    پهن := سلام معماری ایکس۶۴ یا سلام معماری آرم۶۴
    سرچاپ "۶۴ بیتی:"، پهن
    سرچاپ "سلام"، سلام نگارش
پایان
