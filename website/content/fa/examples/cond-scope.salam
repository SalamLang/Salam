روال ریشه:
    وزن := ۳
    پیشتاز := درست
    ناپایا هزینه := ۰
    اگر وزن <= ۱:
        هزینه = ۳۰
    وگرنه وزن <= ۵:
        هزینه = ۵۵
    وگرنه:
        هزینه = ۹۰
    پایان
    اگر پیشتاز:
        هزینه += ۲۵
    پایان
    سرچاپ "هزینه‌ی ارسال:"، هزینه
    برچسب := وزن > ۲ ? "سنگین" : "سبک"
    سرچاپ برچسب
پایان
