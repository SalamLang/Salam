تابع میانگین(جمع: صحیح، تعداد: صحیح): صحیح:
    اگر تعداد != ۰ و جمع / تعداد > ۰:
        برگشت جمع / تعداد
    پایان
    برگشت ۰
پایان

تابع ریشه:
    سرچاپ میانگین(۲۷۰، ۳)، میانگین(۰، ۰)
    نمره‌ها := [۱۲، ۱۸، ۷]
    ای := ۵
    اگر ای < طول(نمره‌ها) و نمره‌ها[ای] > ۱۰:
        سرچاپ "نمره‌ی بالا"
    وگرنه:
        سرچاپ "نمره‌ای در این جایگاه نیست:"، ای
    پایان
    واردشده := درست
    مسدود := نادرست
    اگر واردشده و وارونه مسدود:
        سرچاپ "خوش برگشتید"
    پایان
    موجودی := ۳
    اگر وارونه (موجودی > ۵):
        سرچاپ "وقت سفارش دوباره است"
    پایان
پایان
