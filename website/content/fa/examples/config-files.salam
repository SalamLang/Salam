واردسازی پیکربندی
واردسازی سیستم پرونده.پرونده
واردسازی ورودی خروجی

تابع بارگذاری تنظیمات(مسیر: رشته): پیکربندی.پیکربندی:
    اگر وارونه پرونده.وجود دارد(مسیر):
        سرچاپ "پرونده‌ی"، مسیر، "پیدا نشد؛ پیش‌فرض‌های درونی به کار می‌روند"
        ناپایا پ := پیکربندی.جدید()
        پیکربندی.تنظیم(پ، "server.port"، "8080")
        برگشت پ
    پایان
    برگشت پیکربندی.بارگذاری آی ان آی(مسیر)
پایان

تابع ریشه:
    ورودی خروجی.نوشتن پرونده("shop.ini"، "[server]\nport = 9000   # the public port\n\n[db]\npassword = \"s3cret#2024\"\nmode = TRUE\ntags: fast\n")
    ناپایا پ := بارگذاری تنظیمات("shop.ini")
    دیرکن پیکربندی.آزادسازی(پ)
    کلیدها := پیکربندی.کلیدها(پ)
    دیرکن کلیدها.آزادکن()
    هر ک در کلیدها:
        سرچاپ ک، "="، "[" + پیکربندی.دریافت(پ، ک) + "]"
    پایان
    سرچاپ "db.mode به‌صورت منطقی:"، پیکربندی.دریافت منطقی(پ، "db.mode"، نادرست)
    ناپایا جاافتاده := بارگذاری تنظیمات("missing.ini")
    دیرکن پیکربندی.آزادسازی(جاافتاده)
    سرچاپ "درگاه:"، پیکربندی.دریافت صحیح(جاافتاده، "server.port"، ۰)
پایان
