واردسازی پیکربندی

تابع ریشه:
    پیش فرض := "name = shop\nworkers = 4\ndebug = false\n\n[db]\nhost = localhost\nport = 5432\n"
    تولید := "workers = 16\n\n[db]\nhost = db.internal\npool = 20\n"
    ناپایا پایه := پیکربندی.تجزیه آی ان آی(پیش فرض)
    دیرکن پیکربندی.آزادسازی(پایه)
    ناپایا سرور := پیکربندی.تجزیه آی ان آی(تولید)
    دیرکن پیکربندی.آزادسازی(سرور)
    ناپایا پرچم‌ها := پیکربندی.جدید()
    دیرکن پیکربندی.آزادسازی(پرچم‌ها)
    پیکربندی.تنظیم(پرچم‌ها، "debug"، "yes")
    ناپایا میانی := پیکربندی.ادغام(پایه، سرور)
    دیرکن پیکربندی.آزادسازی(میانی)
    ناپایا نهایی := پیکربندی.ادغام(میانی، پرچم‌ها)
    دیرکن پیکربندی.آزادسازی(نهایی)
    چاپ پیکربندی.قالب آی ان آی(نهایی)
    سرچاپ "کارگرها:"، پیکربندی.دریافت صحیح(نهایی، "workers"، ۱)
    سرچاپ "اشکال‌زدایی:"، پیکربندی.دریافت منطقی(نهایی، "debug"، نادرست)
    سرچاپ "پایگاه داده:"، پیکربندی.دریافت(نهایی، "db.host")، پیکربندی.دریافت صحیح(نهایی، "db.port"، ۵۴۳۲)، پیکربندی.دریافت صحیح(نهایی، "db.pool"، ۵)
پایان
