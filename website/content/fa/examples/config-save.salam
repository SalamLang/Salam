واردسازی پیکربندی
واردسازی ورودی خروجی

تابع ریشه:
    ورودی خروجی.نوشتن پرونده("app.ini"، "theme = light\n\n[editor]\nfont = mono\nsize = 12\n")
    ناپایا پ := پیکربندی.بارگذاری آی ان آی("app.ini")
    دیرکن پیکربندی.آزادسازی(پ)
    پیکربندی.تنظیم(پ، "theme"، "dark")
    پیکربندی.تنظیم(پ، "editor.size"، "14")
    پیکربندی.تنظیم(پ، "editor.title"، "یادداشت‌های من")
    پیکربندی.تنظیم(پ، "window.width"، "1200")
    سرچاپ پیکربندی.حذف(پ، "editor.font")، پیکربندی.حذف(پ، "editor.font")
    ورودی خروجی.نوشتن پرونده("app.ini"، پیکربندی.قالب آی ان آی(پ))
    چاپ ورودی خروجی.خواندن پرونده("app.ini")
    ناپایا دوباره := پیکربندی.بارگذاری آی ان آی("app.ini")
    دیرکن پیکربندی.آزادسازی(دوباره)
    سرچاپ پیکربندی.دریافت(دوباره، "editor.title")، پیکربندی.طول(دوباره) == پیکربندی.طول(پ)
پایان
