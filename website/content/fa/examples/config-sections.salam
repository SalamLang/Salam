واردسازی پیکربندی

ساختار پایگاه:
    همگانی میزبان: رشته = ""
    همگانی درگاه: صحیح۶۴ = ۰
    همگانی ظرفیت: صحیح۶۴ = ۰
پایان

تابع خواندن پایگاه داده(پ &: پیکربندی.پیکربندی): پایگاه:
    برگشت پایگاه {
        میزبان = پیکربندی.دریافت با پیش فرض(پ، "host"، "localhost")،
        درگاه = پیکربندی.دریافت صحیح(پ، "port"، ۵۴۳۲)،
        ظرفیت = پیکربندی.دریافت صحیح(پ، "pool"، ۱۰)
    }
پایان

تابع ریشه:
    متن := "server:\n  port: 8080\n  host: 0.0.0.0\ndatabase:\n  host: db.local\n  port: 6432\nlog: warn\n"
    ناپایا پ := پیکربندی.تجزیه یامل(متن)
    دیرکن پیکربندی.آزادسازی(پ)
    ناپایا سرور := پیکربندی.بخش(پ، "server")
    دیرکن پیکربندی.آزادسازی(سرور)
    کلیدها := پیکربندی.کلیدها(سرور)
    دیرکن کلیدها.آزادکن()
    هر ک در کلیدها:
        سرچاپ "سرور"، ک، "="، پیکربندی.دریافت(سرور، ک)
    پایان
    ناپایا قسمت پایگاه := پیکربندی.بخش(پ، "database")
    دیرکن پیکربندی.آزادسازی(قسمت پایگاه)
    پد := خواندن پایگاه داده(قسمت پایگاه)
    سرچاپ پد.میزبان، پد.درگاه، پد.ظرفیت
    سرچاپ پیکربندی.طول(پ)، پیکربندی.دارد(پ، "log")، پیکربندی.دارد(پ، "server")
پایان
