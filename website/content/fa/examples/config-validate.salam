واردسازی پیکربندی
واردسازی رشته

تابع بررسی(پ &: پیکربندی.پیکربندی): وکتور<رشته>:
    ناپایا مشکل‌ها := وکتور {} برگردان وکتور<رشته>
    لازم := ["APP_PORT"، "DATABASE_URL"]
    هر کلید در لازم:
        اگر پیکربندی.دارد(پ، کلید) == نادرست:
            مشکل‌ها.بیفزا("نبودن " + کلید)
        پایان
    پایان
    اگر پیکربندی.دارد(پ، "APP_PORT"):
        خام := پیکربندی.دریافت(پ، "APP_PORT")
        اگر رشته.از عدد(پیکربندی.دریافت صحیح(پ، "APP_PORT"، ۰)) != خام:
            مشکل‌ها.بیفزا("APP_PORT عدد صحیح نیست: " + خام)
        پایان
    پایان
    برگشت مشکل‌ها
پایان

تابع گزارش بده(نام: رشته، متن: رشته):
    ناپایا پ := پیکربندی.تجزیه محیط(متن)
    دیرکن پیکربندی.آزادسازی(پ)
    مشکل‌ها := بررسی(پ)
    دیرکن مشکل‌ها.آزادکن()
    اگر مشکل‌ها.طول() == ۰:
        سرچاپ نام، "درست است، درگاه"، پیکربندی.دریافت صحیح(پ، "APP_PORT"، ۸۰۸۰)
        برگشت
    پایان
    سرچاپ نام، مشکل‌ها.طول()، "مشکل دارد:"
    هر م در مشکل‌ها:
        سرچاپ " "، م
    پایان
پایان

تابع ریشه:
    ناپایا پ := پیکربندی.تجزیه محیط("APP_PORT=eighty\nAPP_DEBUG=enabled\n")
    دیرکن پیکربندی.آزادسازی(پ)
    سرچاپ پیکربندی.دریافت صحیح(پ، "APP_PORT"، ۸۰۸۰)، پیکربندی.دریافت صحیح(پ، "APP_WORKERS"، ۴)
    سرچاپ پیکربندی.دریافت منطقی(پ، "APP_DEBUG"، درست)، پیکربندی.دریافت منطقی(پ، "APP_CACHE"، درست)
    گزارش بده("broken.env"، "APP_PORT=eighty\n")
    گزارش بده("good.env"، "APP_PORT=9000\nDATABASE_URL=postgres://db/shop\n")
پایان
