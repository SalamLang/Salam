واردسازی تبدیل
واردسازی رشته

تابع ریشه خطادار:
    خام := نگاشت {} برگردان نگاشت<رشته، رشته>
    دیرکن خام.آزادکن()
    خام.درج("اشکال‌زدایی"، " yes ")
    خام.درج("حافظه نهان"، "0")
    خام.درج("رنگ"، "#1E90FF")
    خام.درج("سقف"، "۲۵۰")
    خام.درج("فشرده‌سازی"، "Yes")
    اشکال زدایی := تلاش تبدیل.تجزیه منطقی(خام.بگیر("اشکال‌زدایی"))
    نهان := تلاش تبدیل.تجزیه منطقی(خام.بگیر("حافظه نهان"))
    فشرده := تبدیل.تجزیه منطقی با پیش فرض(خام.بگیر("فشرده‌سازی")، نادرست)
    رنگ := تلاش تبدیل.تجزیه شانزده(رشته.حذف پیشوند(خام.بگیر("رنگ")، "#"))
    سقف := تلاش تبدیل.رشته به عدد(خام.بگیر("سقف"))
    سرچاپ "اشکال‌زدایی:"، تبدیل.قالب منطقی(اشکال زدایی)، "حافظه‌ی نهان:"، تبدیل.قالب منطقی(نهان)، "فشرده‌سازی:"، تبدیل.قالب منطقی(فشرده)
    سرچاپ "سرخ:"، رنگ >> ۱۶، "سبز:"، (رنگ >> ۸) & ۲۵۵، "آبی:"، رنگ & ۲۵۵
    سرچاپ "دو برابر سقف:"، سقف * ۲
    سرچاپ "رنگ دوباره در مبنای شانزده:"، تبدیل.قالب شانزده(رنگ برگردان طبیعی۶۴)
پایان
