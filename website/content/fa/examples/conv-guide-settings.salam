واردسازی تبدیل
واردسازی رشته

تابع ریشه:
    خام := نگاشت {} برگردان نگاشت<رشته، رشته>
    دیرکن خام.آزادکن()
    خام.درج("اشکال‌زدایی"، " yes ")
    خام.درج("حافظه نهان"، "0")
    خام.درج("رنگ"، "#1E90FF")
    خام.درج("سقف"، "۲۵۰")
    اشکال زدایی := تبدیل.تجزیه منطقی(خام.بگیر("اشکال‌زدایی"))
    نهان := تبدیل.تجزیه منطقی(خام.بگیر("حافظه نهان"))
    رنگ := تبدیل.تجزیه شانزده(رشته.حذف پیشوند(خام.بگیر("رنگ")، "#"))
    سقف := تبدیل.رشته به عدد(خام.بگیر("سقف"))
    سرچاپ "اشکال‌زدایی:"، تبدیل.قالب منطقی(اشکال زدایی)، "حافظه‌ی نهان:"، تبدیل.قالب منطقی(نهان)
    سرچاپ "سرخ:"، رنگ >> ۱۶، "سبز:"، (رنگ >> ۸) & ۲۵۵، "آبی:"، رنگ & ۲۵۵
    سرچاپ "دو برابر سقف:"، سقف * ۲
    سرچاپ "رنگ دوباره در مبنای شانزده:"، تبدیل.قالب شانزده(رنگ برگردان طبیعی۶۴)
پایان
