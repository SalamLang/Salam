واردسازی تبدیل

تابع ریشه:
    هر نوشته در ["42"، " ۱۴۰۳ "، "+7"، "12abc"، ""، "-0015"، "99999999999999999999"]:
        تلاش:
            ع := تبدیل.تجزیه عدد(نوشته)
            سرچاپ "[" + نوشته + "]"، "یعنی"، ع
        گرفتن خطا خ:
            سرچاپ "[" + نوشته + "]"، "پذیرفته نشد:"، خ.پیام، "در ستون"، خ.ستون
        پایان
    پایان
پایان
