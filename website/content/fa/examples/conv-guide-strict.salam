واردسازی تبدیل
واردسازی رشته

تابع عدد صحیح کامل(متن: رشته، معتبر &: منطقی): صحیح۶۴:
    پاک := رشته.به رقم انگلیسی(رشته.پیرایش(متن))
    ع := تبدیل.تجزیه عدد(پاک)
    معتبر = پاک != "" و تبدیل.قالب عدد(ع) == رشته.حذف پیشوند(پاک، "+")
    برگشت ع
پایان

تابع ریشه:
    هر نوشته در ["42"، " ۱۴۰۳ "، "+7"، "12abc"، ""، "-0015"]:
        ناپایا پذیرفته := نادرست
        ع := عدد صحیح کامل(نوشته، پذیرفته)
        اگر پذیرفته:
            سرچاپ "[" + نوشته + "]"، "یعنی"، ع
        وگرنه:
            سرچاپ "[" + نوشته + "]"، "عدد صحیح نیست"
        پایان
    پایان
پایان
