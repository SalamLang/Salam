    برگشت پوچ
پایان

تابع ریشه:
    ناپایا کارها := وکتور {} برگردان وکتور<کار>
    دیرکن کارها.آزادکن()
    کارها.بیفزا(کار { نام = "نوشتن آزمون‌ها"، انجام شده = درست })
    کارها.بیفزا(کار { نام = "رفع ایراد ورود" })
    کارها.بیفزا(کار { نام = "به‌روزرسانی راهنما" })
    بعدی := نخستین کار باز(کارها)
    سرچاپ "کار بعدی:"، هسته.انتظار(بعدی، "این‌جا همیشه یک کار باز هست")
    هر ش، ک در کارها:
        کارها.بنشان(ش، کار { نام = ک.نام، انجام شده = درست })
    پایان
    سرچاپ "کاری مانده؟"، نخستین کار باز(کارها).دارد()
پایان
