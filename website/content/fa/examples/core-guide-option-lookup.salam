تابع شماره‌ی تلفن(دفترچه: نگاشت<رشته، رشته>، نام: رشته): رشته؟:
    اگر دفترچه.دارد(نام):
        برگشت دفترچه.بگیر(نام)
    پایان
    برگشت پوچ
پایان

تابع ریشه:
    ناپایا دفترچه := نگاشت {} برگردان نگاشت<رشته، رشته>
    دیرکن دفترچه.آزادکن()
    دفترچه.درج("سارا"، "۰۹۱۲ ۱۱۱ ۲۲۳۳")
    دفترچه.درج("امید"، "۰۹۳۵ ۴۴۴ ۵۵۶۶")
    هر نام در ["امید"، "ندا"]:
        ت := شماره‌ی تلفن(دفترچه، نام)
        اگر ت.دارد():
            سرچاپ نام + ":"، ت.مقدار
        وگرنه:
            سرچاپ نام + ": شماره‌ای ثبت نشده"
        پایان
    پایان
    سرچاپ "تماس با"، شماره‌ی تلفن(دفترچه، "ندا").یابرگردان("پذیرش")
پایان
