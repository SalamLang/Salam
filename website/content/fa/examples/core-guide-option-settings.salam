ساختار تنظیمات:
    همگانی پهنا: صحیح؟ = پوچ
    همگانی عنوان: رشته؟ = پوچ
پایان

تابع شرح(ت: تنظیمات): رشته:
    پ := ت.پهنا.یابرگردان(۸۰)
    ع := ت.عنوان.یابرگردان("بی‌نام")
    برگشت ع + " (" + پ + " ستون)"
پایان

تابع ریشه:
    سرچاپ شرح(تنظیمات {})
    سرچاپ شرح(تنظیمات { پهنا = ۱۲۰ })
    سرچاپ شرح(تنظیمات { پهنا = ۰، عنوان = "گزارش" })
پایان
