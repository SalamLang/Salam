واردسازی هسته

جداشمار نتیجه<ت، خ>:
    موفق(مقدار: ت)
    خطا(پیام: خ)
پایان

تابع خواندن درصد(متن: رشته): نتیجه<صحیح، رشته>:
    ع := متن.به صحیح()
    اگر ع < ۰ یا ع > ۱۰۰:
        برگشت نتیجه.خطا("درصد باید بین ۰ تا ۱۰۰ باشد، رسید: " + متن)
    پایان
    برگشت نتیجه.موفق(ع)
پایان

تابع اعمال تخفیف(قیمت: صحیح، درصد: صحیح): صحیح:
    اگر درصد < ۰ یا درصد > ۱۰۰:
        هسته.خطای مرگبار("اعمال تخفیف با درصد " + درصد + " صدا زده شد")
    پایان
    برگشت قیمت - قیمت * درصد / ۱۰۰
پایان

تابع ریشه:
    هر نوشته در ["۲۰"، "۲۵۰"]:
        ن := خواندن درصد(نوشته)
        همخوان ن:
            موفق(د): سرچاپ "قیمت پس از تخفیف:"، اعمال تخفیف(۸۰، د) پایان
            خطا(پیام): سرچاپ "پذیرفته نشد:"، پیام پایان
        پایان
    پایان
پایان
