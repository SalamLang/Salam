واردسازی پردازنده
واردسازی حافظه
واردسازی تی ال اس

تابع شانزده‌دهی(نشانی: تهی*، تعداد: صحیح): رشته:
    بایت‌ها := نشانی برگردان طبیعی۸*
    ارقام := "0123456789abcdef"
    ناپایا متن := ""
    تکرار تعداد در ن:
        مقدار := بایت‌ها[ن] برگردان صحیح
        متن += ارقام.زیررشته(مقدار >> 4، 1)
        متن += ارقام.زیررشته(مقدار & 15، 1)
    پایان
    برگشت متن
پایان

تابع مهر کردن(): رشته:
    کلید := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    نانس := حافظه.تخصیص صفرشده(12 برگردان طبیعی۶۴)
    پیام := حافظه.تخصیص صفرشده(32 برگردان طبیعی۶۴)
    خروجی := حافظه.تخصیص صفرشده(48 برگردان طبیعی۶۴)
    تی ال اس.مهر خام ای ای اس جی سی ام(کلید، 16، نانس، پوچ، 0، پیام، 32، خروجی)
    نتیجه := شانزده‌دهی(خروجی، 48)
    حافظه.آزادسازی(کلید)
    حافظه.آزادسازی(نانس)
    حافظه.آزادسازی(پیام)
    حافظه.آزادسازی(خروجی)
    برگشت نتیجه
پایان

تابع ریشه:
    پردازنده.تنظیم سخت افزار(درست)
    سریع := مهر کردن()
    پردازنده.تنظیم سخت افزار(نادرست)
    کند := مهر کردن()
    سرچاپ "بایت‌های یکسان:"، سریع برابر کند
    سرچاپ "برچسب:"، سریع.زیررشته(64، 32)
پایان
