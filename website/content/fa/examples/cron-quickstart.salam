واردسازی کرون

پایا ZONE := "Invalid/Nowhere"
پایا OFF := ۲۱۰
پایا AFTER := ۱۷۹۲۸۰۰۳۰۰ برگردان صحیح۶۴

تابع show(spec: رشته):
    e := کرون.تجزیه(spec)
    سرچاپ spec، e.معتبر، کرون.بعدی(e، AFTER، ZONE، OFF)
پایان

تابع ریشه:
    show("*/20 * * * *")
    show("@daily")
    show("0 0 29 feb *")
    show("nope")

    e := کرون.تجزیه("*/5 * * * *")
    سرچاپ کرون.تطبیق فیلدها(e، ۱۵، ۱۰، ۱، ۱، ۰)
    سرچاپ کرون.تطبیق فیلدها(e، ۱۶، ۱۰، ۱، ۱، ۰)
    سرچاپ کرون.اختلاف ثانیه منطقه(ZONE، OFF، AFTER)
پایان
