واردسازی حافظه
واردسازی زمان
واردسازی کرون

ناپایا hits := پوچ برگردان صحیح۶۴*

تابع tick(id: صحیح۶۴):
    اتمی‌بیفزا(hits، ۱ برگردان صحیح۶۴)
    سرچاپ "job"، id، کرون.نام(id برگردان صحیح)
پایان

تابع ریشه:
    hits = حافظه.تخصیص صفرشده(۸ برگردان طبیعی۶۴) برگردان صحیح۶۴*
    کرون.تنظیم منطقه("Invalid/Nowhere"، ۲۱۰)

    every := کرون.افزودن("every minute"، "* * * * *"، tick)
    nightly := کرون.افزودن("nightly"، "0 3 * * *"، tick)
    broken := کرون.افزودن("broken"، "nope"، tick)
    سرچاپ کرون.تعداد()، کرون.نام(every)، کرون.نام(nightly)، broken
    سرچاپ کرون.مشغول است(every)

    started := کرون.اجرای موعد(۱۷۹۲۸۰۰۳۰۰ برگردان صحیح۶۴)
    ناپایا waited := ۰
    تا اتمی‌بخوان(hits) == (۰ برگردان صحیح۶۴) یا waited >= ۲۰۰:
        زمان.خواب(۱۰)
        waited += ۱
    پایان
    سرچاپ "started"، started، "hits"، اتمی‌بخوان(hits)
    سرچاپ کرون.مشغول است(every)

    کرون.اجرا در پس‌زمینه()
    کرون.توقف()
پایان
