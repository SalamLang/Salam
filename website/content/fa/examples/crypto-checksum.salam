واردسازی رمزنگاری
واردسازی کدگذاری
واردسازی حافظه

تابع ریشه:
    تکه‌ها := ["first block of the file, "، "second block, "، "and the last one."]
    ناپایا همه := ""
    ناپایا ح := رمزنگاری.شا۲۵۶ جدید()
    هر تکه در تکه‌ها:
        رمزنگاری.به روز رسانی شا۲۵۶(ح، تکه برگردان تهی*، تکه.طول())
        همه = همه + تکه
    پایان
    خروجی := حافظه.تخصیص(۳۲ برگردان طبیعی۶۴)
    رمزنگاری.نهایی شا۲۵۶(ح، خروجی)
    تکه به تکه := کدگذاری.کدگذاری بایت‌ها پایه۶۴(خروجی، ۳۲)

    رمزنگاری.شا۲۵۶ بایت(همه برگردان تهی*، همه.طول()، خروجی)
    یکجا := کدگذاری.کدگذاری بایت‌ها پایه۶۴(خروجی، ۳۲)
    حافظه.آزادسازی(خروجی)

    سرچاپ "تکه به تکه: " + تکه به تکه
    سرچاپ "یکجا: " + یکجا
    سرچاپ "یکسان:"، تکه به تکه برابر یکجا
    سرچاپ "شکل شانزدهی: " + رمزنگاری.شا۲۵۶ شانزدهی(همه)
پایان
