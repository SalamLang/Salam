واردسازی رمزنگاری
واردسازی رشته

پایا دورها := ۶۰۰۰۰۰

تابع درهم قوی(گذرواژه: رشته): رشته:
    نمک := رمزنگاری.تصادفی ایمن شانزدهی(۱۶)
    برگشت "pbkdf2-sha256$" + دورها + "$" + نمک + "$" + رمزنگاری.پی بی کِی دی اف۲ شانزدهی(گذرواژه، نمک، دورها، ۳۲)
پایان

تابع دورهای(ذخیره: رشته): صحیح:
    برگشت رشته.تفکیک کردن(ذخیره، "$").دریافت(۱).به صحیح()
پایان

تابع ورود(ذخیره &: رشته، گذرواژه: رشته): منطقی:
    اگر وارونه رمزنگاری.تایید گذرواژه(گذرواژه، ذخیره): برگشت نادرست پایان
    اگر دورهای(ذخیره) کوچکتر دورها:
        ذخیره = درهم قوی(گذرواژه)
        سرچاپ "  درهم ذخیره‌شده به"، دورهای(ذخیره)، "دور ارتقا یافت"
    پایان
    برگشت درست
پایان

تابع ریشه:
    ناپایا ذخیره := رمزنگاری.درهم گذرواژه("چای ساعت پنج")
    سرچاپ "درهم گذرواژه"، دورهای(ذخیره)، "دور به کار می‌برد"
    سرچاپ "ورود:"، ورود(ذخیره، "چای ساعت پنج")
    سرچاپ "ورود دوباره:"، ورود(ذخیره، "چای ساعت پنج")
    سرچاپ "گذرواژه‌ی نادرست:"، ورود(ذخیره، "قهوه ساعت شش")
پایان
