واردسازی رمزنگاری
واردسازی رشته

ساختار کاربر:
    همگانی اسم: رشته = ""
    همگانی درهم: رشته = ""
پایان

تابع ثبت کاربر(کاربران &: وکتور<کاربر>، اسم: رشته، گذرواژه: رشته):
    کاربران.بیفزا(کاربر { اسم = اسم، درهم = رمزنگاری.درهم گذرواژه(گذرواژه) })
پایان

تابع احراز هویت(کاربران: وکتور<کاربر>، اسم: رشته، گذرواژه: رشته): منطقی:
    هر ک در کاربران:
        اگر ک.اسم برابر اسم:
            برگشت رمزنگاری.تایید گذرواژه(گذرواژه، ک.درهم)
        پایان
    پایان
    برگشت نادرست
پایان

تابع ریشه:
    ناپایا کاربران := وکتور {} برگردان وکتور<کاربر>
    ثبت کاربر(کاربران، "سارا"، "correct horse battery")
    ثبت کاربر(کاربران، "امید"، "correct horse battery")

    بخش‌ها := رشته.تفکیک کردن(کاربران.بگیر(۰).درهم، "$")
    سرچاپ "شمار بخش‌ها:"، بخش‌ها.طول()، "الگوریتم:"، بخش‌ها.بگیر(۰)، "دور:"، بخش‌ها.بگیر(۱)
    سرچاپ "گذرواژه‌ی یکسان، درهم یکسان؟"، کاربران.بگیر(۰).درهم برابر کاربران.بگیر(۱).درهم
    سرچاپ "سارا با گذرواژه‌ی درست:"، احراز هویت(کاربران، "سارا"، "correct horse battery")
    سرچاپ "سارا با گذرواژه‌ی نادرست:"، احراز هویت(کاربران، "سارا"، "correct horse")
    سرچاپ "کاربر ناشناس:"، احراز هویت(کاربران، "هیچ‌کس"، "x")
پایان
