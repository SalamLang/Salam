واردسازی رمزنگاری

تابع بررسی امضا(راز: رشته، بدنه: رشته، سرآیند: رشته): منطقی:
    مورد انتظار := "sha256=" + رمزنگاری.اچ مک شا۲۵۶ شانزدهی(راز، بدنه)
    برگشت رمزنگاری.برابری راز(مورد انتظار، سرآیند)
پایان

تابع ریشه:
    راز := "whsec_4f9a1c"
    بدنه := "{\"event\":\"order.paid\",\"id\":1042}"
    سرآیند := "sha256=" + رمزنگاری.اچ مک شا۲۵۶ شانزدهی(راز، بدنه)
    سرچاپ "امضا: " + سرآیند

    سرچاپ "درخواست اصلی:"، بررسی امضا(راز، بدنه، سرآیند)
    سرچاپ "بدنه‌ی دست‌خورده:"، بررسی امضا(راز، "{\"event\":\"order.paid\",\"id\":9999}"، سرآیند)
    سرچاپ "راز اشتباه:"، بررسی امضا("guess"، بدنه، سرآیند)
پایان
