واردسازی زمینه

تابع رونوشت پرونده‌ها(ز: زمینه.زمینه، پرونده‌ها: وکتور<رشته>): صحیح:
    ناپایا شمار := ۰
    هر نام در پرونده‌ها:
        اگر زمینه.تمام شده(ز):
            سرچاپ "  پیش از"، نام، "متوقف شد (" + زمینه.خطا(ز) + ")"
            برگشت شمار
        پایان
        سرچاپ "  رونوشت شد:"، نام
        شمار += ۱
    پایان
    برگشت شمار
پایان

تابع ریشه:
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<رشته>
    پرونده‌ها.بیفزا("a.txt")
    پرونده‌ها.بیفزا("b.txt")
    پرونده‌ها.بیفزا("c.txt")
    پایه := زمینه.پس زمینه()

    سرچاپ "اجرای عادی:"
    زنده := زمینه.با لغو(پایه)
    سرچاپ "  جمع"، رونوشت پرونده‌ها(زنده، پرونده‌ها)

    سرچاپ "لغو به دست کاربر:"
    لغو شده := زمینه.با لغو(پایه)
    زمینه.لغو(لغو شده)
    سرچاپ "  جمع"، رونوشت پرونده‌ها(لغو شده، پرونده‌ها)

    سرچاپ "مهلت از پیش گذشته:"
    دیرکرد := زمینه.با موعد(پایه، ۱)
    سرچاپ "  جمع"، رونوشت پرونده‌ها(دیرکرد، پرونده‌ها)

    زمینه.آزادسازی(دیرکرد)
    زمینه.آزادسازی(لغو شده)
    زمینه.آزادسازی(زنده)
    زمینه.آزادسازی(پایه)
    پرونده‌ها.آزادکن()
پایان
