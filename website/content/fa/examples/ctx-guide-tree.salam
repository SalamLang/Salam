واردسازی زمینه

تابع نمایش(نام: رشته، ز: زمینه.زمینه):
    اگر زمینه.تمام شده(ز):
        سرچاپ نام، "متوقف شد:"، زمینه.خطا(ز)
    وگرنه:
        سرچاپ نام، "در حال اجرا"
    پایان
پایان

تابع ریشه:
    پایه := زمینه.پس زمینه()
    درخواست := زمینه.با لغو(پایه)
    پرس‌وجو := زمینه.با لغو(درخواست)
    حافظه نهان := زمینه.با لغو(درخواست)
    ممیزی := زمینه.با لغو(پایه)

    زمینه.لغو(درخواست)

    نمایش("درخواست"، درخواست)
    نمایش("پرس‌وجوی پایگاه داده"، پرس‌وجو)
    نمایش("حافظه‌ی نهان"، حافظه نهان)
    نمایش("ممیزی"، ممیزی)
    نمایش("ریشه"، پایه)

    زمینه.آزادسازی(ممیزی)
    زمینه.آزادسازی(حافظه نهان)
    زمینه.آزادسازی(پرس‌وجو)
    زمینه.آزادسازی(درخواست)
    زمینه.آزادسازی(پایه)
پایان
