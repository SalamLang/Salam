واردسازی زمینه
واردسازی همگام سازی

ناپایا پایه := زمینه.پس زمینه()
ناپایا کار := زمینه.با لغو(پایه)
ناپایا گروه := همگام سازی.گروه انتظار جدید()
ناپایا کار تمام شد := نادرست

تابع کارگر():
    تا وارونه زمینه.تمام شده(کار):
        _ := زمینه.انتظار(کار، ۱۰۰)
    پایان
    کار تمام شد = درست
    همگام سازی.اتمام(گروه)
پایان

تابع ریشه:
    همگام سازی.افزودن(گروه، ۱)
    ن := نخ‌ساز(کارگر)
    همگام سازی.خواب میلی ثانیه(۵۰)
    سرچاپ "از کارگر می‌خواهیم دست بکشد"
    زمینه.لغو(کار)
    همگام سازی.انتظار(گروه)
    نخ‌پیوند(ن)
    سرچاپ "کارگر تمام کرد:"، کار تمام شد، "دلیل:"، زمینه.خطا(کار)

    همگام سازی.نابودسازی گروه انتظار(گروه)
    زمینه.آزادسازی(کار)
    زمینه.آزادسازی(پایه)
پایان
