واردسازی داده
واردسازی ماتریس
واردسازی ریاضی

تابع نام نوع ستون(کد نوع: صحیح): رشته:
    اگر کد نوع برابر داده.ستون صحیح: برگشت "صحیح" پایان
    اگر کد نوع برابر داده.ستون اعشاری: برگشت "اعشاری" پایان
    اگر کد نوع برابر داده.ستون رده‌ای: برگشت "رده‌ای" پایان
    برگشت "متن"
پایان

تابع ریشه:
    متن := "شناسه,شهر,سن,درآمد,نظر\n1,تهران,34,2.5,ارسال سریع\n2,شیراز,,3.1,خوب\n3,تهران,51,4.0,دیر رسید\n4,تبریز,28,1.9,قیمت مناسب\n"
    ناپایا جدول := داده.بارگذاری سی‌اس‌وی(متن، درست)
    هر ی، نام در جدول.نام‌ها:
        سرچاپ نام، "->"، نام نوع ستون(جدول.گونه‌ها.بگیر(ی))
    پایان
    رده‌ها := جدول.سطوح رده‌ای("شهر")
    سرچاپ "رده‌های شهر:"، رده‌ها
    شهر := جدول.نمایه ستون("شهر")
    سن := جدول.نمایه ستون("سن")
    تکرار جدول.سطرها() در ی:
        کد := جدول.خانه‌ها.عنصر(ی، شهر) برگردان صحیح
        ناپایا وضعیت := "ناموجود"
        اگر ریاضی.نامعدد است(جدول.خانه‌ها.عنصر(ی، سن)) برابر نادرست: وضعیت = "معلوم" پایان
        سرچاپ "سطر"، ی، "کد شهر"، کد، "="، رده‌ها.بگیر(کد)، "سن"، وضعیت
    پایان
    ناپایا م := جدول.به ماتریس()
    سرچاپ "به ماتریس"، م.ستون‌ها، "ستون از"، جدول.ستون‌ها()، "ستون را نگه می‌دارد"
    ناپایا یک‌داغ := ماتریس.صفرها(جدول.سطرها()، رده‌ها.طول())
    تکرار جدول.سطرها() در ی: یک‌داغ.تنظیم(ی، جدول.خانه‌ها.عنصر(ی، شهر) برگردان صحیح، ۱.۰) پایان
    سرچاپ "سطر ۳ یک‌داغ:"، یک‌داغ.عنصر(۳، ۰)، یک‌داغ.عنصر(۳، ۱)، یک‌داغ.عنصر(۳، ۲)
    ماتریس.آزادسازی(یک‌داغ)
    ماتریس.آزادسازی(م)
    جدول.آزادسازی()
    برگشت ۰
پایان
