واردسازی داده
واردسازی ماتریس
واردسازی تبدیل

تابع ریشه:
    ناپایا برچسب := ماتریس.ماتریس {}
    ناپایا ضریب‌ها := ماتریس.ماتریس {}
    ویژگی := داده.ساخت رگرسیون(۲۰۰، ۳، ۰.۰۵، ۱۱، برچسب، ضریب‌ها)
    ناپایا مجموعه := داده.مجموعه‌داده ماتریسی { ویژگی‌ها = ویژگی، برچسب‌ها = برچسب }
    ناپایا وزن := ماتریس.صفرها(۳، ۱)
    ناپایا پیمایشگر := مجموعه.دسته‌ها(۲۰، درست، ۷)
    ناپایا دسته ویژگی := ماتریس.ماتریس {}
    ناپایا دسته برچسب := ماتریس.ماتریس {}
    تکرار ۵ در دور:
        پیمایشگر.بازنشانی(دور برگردان صحیح۶۴)
        ناپایا زیان := ۰.۰
        تا پیمایشگر.بعدی(دسته ویژگی، دسته برچسب):
            ناپایا پیش‌بینی := ماتریس.ضرب ماتریسی(دسته ویژگی، وزن)
            ناپایا تفاوت := ماتریس.تفریق(پیش‌بینی، دسته برچسب)
            ناپایا گرادیان := ماتریس.ضرب ترانهاده(دسته ویژگی، تفاوت)
            ماتریس.جمع مقیاس‌دار(وزن، گرادیان، -۰.۱ / (دسته ویژگی.سطرها برگردان اعشار۶۴))
            زیان += ماتریس.ضرب داخلی(تفاوت، تفاوت)
            ماتریس.آزادسازی(پیش‌بینی)
            ماتریس.آزادسازی(تفاوت)
            ماتریس.آزادسازی(گرادیان)
        پایان
        سرچاپ "دور"، دور + ۱، "دسته‌ها"، پیمایشگر.شمار دسته در دور()، "زیان"، تبدیل.قالب اعشار با دقت(زیان / (مجموعه.طول() برگردان اعشار۶۴)، ۴)
    پایان
    تکرار ۳ در ی:
        سرچاپ "w" + ی، "آموخته"، تبدیل.قالب اعشار با دقت(وزن.عنصر(ی، ۰)، ۲)، "واقعی"، تبدیل.قالب اعشار با دقت(ضریب‌ها.عنصر(ی، ۰)، ۲)
    پایان
    ماتریس.آزادسازی(دسته ویژگی)
    ماتریس.آزادسازی(دسته برچسب)
    ماتریس.آزادسازی(وزن)
    ماتریس.آزادسازی(ضریب‌ها)
    پیمایشگر.آزادسازی()
    مجموعه.آزادسازی()
    برگشت ۰
پایان
