واردسازی داده
واردسازی ماتریس
واردسازی فشرده سازی
واردسازی بایگانی
واردسازی کدگذاری.دودویی
واردسازی تبدیل

تابع نوشتن آی‌دی‌ایکس(مسیر: رشته، بعدها: وکتور<صحیح>، مقدارها: وکتور<صحیح>): منطقی:
    ناپایا بافر := فشرده سازی.بافر بایت جدید()
    دودویی.نوشتن طبیعی۸(بافر، ۰)
    دودویی.نوشتن طبیعی۸(بافر، ۰)
    دودویی.نوشتن طبیعی۸(بافر، ۸)
    دودویی.نوشتن طبیعی۸(بافر، بعدها.طول())
    هر ب در بعدها: دودویی.نوشتن طبیعی۳۲ بزرگ‌انتها(بافر، ب) پایان
    هر م در مقدارها: دودویی.نوشتن طبیعی۸(بافر، م) پایان
    خوب := بایگانی.نوشتن پرونده دودویی از بافر(مسیر، بافر)
    فشرده سازی.آزادسازی بافر(بافر)
    برگشت خوب
پایان

تابع ریشه:
    ناپایا بعدها := وکتور {} برگردان وکتور<صحیح>
    بعدها.بیفزا(۳)
    بعدها.بیفزا(۲)
    بعدها.بیفزا(۲)
    ناپایا پیکسل‌ها := وکتور {} برگردان وکتور<صحیح>
    تکرار ۱۲ در ی: پیکسل‌ها.بیفزا(ی * ۲۰) پایان
    نوشتن آی‌دی‌ایکس("images.idx"، بعدها، پیکسل‌ها)
    ناپایا تعداد := وکتور {} برگردان وکتور<صحیح>
    تعداد.بیفزا(۳)
    ناپایا برچسب‌ها := وکتور {} برگردان وکتور<صحیح>
    برچسب‌ها.بیفزا(۷)
    برچسب‌ها.بیفزا(۲)
    برچسب‌ها.بیفزا(۷)
    نوشتن آی‌دی‌ایکس("labels.idx"، تعداد، برچسب‌ها)
    ناپایا تصویرها := ماتریس.ماتریس {}
    ناپایا رده‌ها := ماتریس.ماتریس {}
    اگر داده.بارگذاری ام‌نیست("images.idx"، "labels.idx"، تصویرها، رده‌ها) برابر نادرست:
        سرچاپ "بارگذاری نشد"
        برگشت ۱
    پایان
    سرچاپ "تصویرها:"، تصویرها.سطرها، "پیکسل هر کدام:"، تصویرها.ستون‌ها، "برچسب‌ها:"، رده‌ها.سطرها
    تکرار تصویرها.سطرها در ی:
        سرچاپ "برچسب"، رده‌ها.عنصر(ی، ۰)، "پیکسل‌ها"، تبدیل.قالب اعشار با دقت(تصویرها.عنصر(ی، ۰)، ۳)، تبدیل.قالب اعشار با دقت(تصویرها.عنصر(ی، ۳)، ۳)
    پایان
    ناپایا خوب := نادرست
    خام := داده.بارگذاری آی‌دی‌ایکس("images.idx"، خوب)
    سرچاپ "مقدار خام پیکسل آخر:"، خام.عنصر(۲، ۳)
    سرچاپ "بدون برچسب:"، داده.بارگذاری ام‌نیست("images.idx"، "missing.idx"، تصویرها، رده‌ها)
    ماتریس.آزادسازی(تصویرها)
    ماتریس.آزادسازی(رده‌ها)
    برگشت ۰
پایان
