واردسازی داده
واردسازی ماتریس
واردسازی تبدیل

تابع ریشه:
    متن := "متراژ,اتاق,قیمت\n50,1,105\n70,2,147\n80,2,164\n100,3,208\n120,3,244\n150,4,305\n"
    ناپایا جدول := داده.بارگذاری سی‌اس‌وی(متن، درست)
    ناپایا ویژگی := ماتریس.ماتریس {}
    ناپایا برچسب := ماتریس.ماتریس {}
    اگر جدول.جداسازی ویژگی از برچسب("قیمت"، ویژگی، برچسب) برابر نادرست:
        سرچاپ "ستون قیمت پیدا نشد"
        برگشت ۱
    پایان
    سرچاپ "ویژگی‌ها:"، ویژگی.سطرها، "در"، ویژگی.ستون‌ها، "برچسب:"، برچسب.سطرها، "در"، برچسب.ستون‌ها
    ناپایا ضریب := ماتریس.رگرسیون خطی(ویژگی، برچسب)
    سرچاپ "عرض از مبدا:"، تبدیل.قالب اعشار با دقت(ضریب.عنصر(۰، ۰)، ۲)
    سرچاپ "هر متر مربع:"، تبدیل.قالب اعشار با دقت(ضریب.عنصر(۱، ۰)، ۲)
    سرچاپ "هر اتاق:"، تبدیل.قالب اعشار با دقت(ضریب.عنصر(۲، ۰)، ۲)
    حدس := ضریب.عنصر(۰، ۰) + ۹۰.۰ * ضریب.عنصر(۱، ۰) + ۲.۰ * ضریب.عنصر(۲، ۰)
    سرچاپ "۹۰ متر با ۲ اتاق:"، تبدیل.قالب اعشار با دقت(حدس، ۱)
    ماتریس.آزادسازی(ضریب)
    ماتریس.آزادسازی(ویژگی)
    ماتریس.آزادسازی(برچسب)
    جدول.آزادسازی()
    برگشت ۰
پایان
