واردسازی داده
واردسازی ماتریس

تابع نزدیک‌ترین(مرکزها: ماتریس.ماتریس، نقطه‌ها: ماتریس.ماتریس، ی: صحیح): صحیح:
    ناپایا بهترین := ۰
    ناپایا کمترین فاصله := -۱.۰
    تکرار مرکزها.سطرها در م:
        ناپایا فاصله := ۰.۰
        تکرار نقطه‌ها.ستون‌ها در ج:
            اختلاف := نقطه‌ها.عنصر(ی، ج) - مرکزها.عنصر(م، ج)
            فاصله += اختلاف * اختلاف
        پایان
        اگر کمترین فاصله کوچکتر ۰.۰ یا فاصله کوچکتر کمترین فاصله:
            بهترین = م
            کمترین فاصله = فاصله
        پایان
    پایان
    برگشت بهترین
پایان

تابع ریشه:
    ناپایا برچسب := ماتریس.ماتریس {}
    نقطه‌ها := داده.ساخت خوشه‌ها(۱۲۰، ۳، ۲، ۱.۰، ۵، برچسب)
    ناپایا مجموعه := داده.مجموعه‌داده ماتریسی { ویژگی‌ها = نقطه‌ها، برچسب‌ها = برچسب }
    ناپایا پیمایشگر := مجموعه.دسته‌ها(۹۰، درست، ۱)
    ناپایا ویژگی آموزش := ماتریس.ماتریس {}
    ناپایا آموزش برچسب := ماتریس.ماتریس {}
    ناپایا ویژگی آزمون := ماتریس.ماتریس {}
    ناپایا آزمون برچسب := ماتریس.ماتریس {}
    پیمایشگر.بعدی(ویژگی آموزش، آموزش برچسب)
    پیمایشگر.بعدی(ویژگی آزمون، آزمون برچسب)
    سرچاپ "آموزش:"، ویژگی آموزش.سطرها، "آزمون:"، ویژگی آزمون.سطرها
    ناپایا مرکزها := ماتریس.صفرها(۳، ۲)
    ناپایا اندازه‌ها := ماتریس.صفرها(۳، ۱)
    تکرار ویژگی آموزش.سطرها در ی:
        خوشه := آموزش برچسب.عنصر(ی، ۰) برگردان صحیح
        تکرار ۲ در ج: مرکزها.تنظیم(خوشه، ج، مرکزها.عنصر(خوشه، ج) + ویژگی آموزش.عنصر(ی، ج)) پایان
        اندازه‌ها.تنظیم(خوشه، ۰، اندازه‌ها.عنصر(خوشه، ۰) + ۱.۰)
    پایان
    تکرار ۳ در خوشه:
        تکرار ۲ در ج: مرکزها.تنظیم(خوشه، ج، مرکزها.عنصر(خوشه، ج) / اندازه‌ها.عنصر(خوشه، ۰)) پایان
    پایان
    ناپایا درست‌ها := ۰
    تکرار ویژگی آزمون.سطرها در ی:
        اگر نزدیک‌ترین(مرکزها، ویژگی آزمون، ی) برابر آزمون برچسب.عنصر(ی، ۰) برگردان صحیح: درست‌ها += ۱ پایان
    پایان
    سرچاپ "درست روی نقطه‌های ندیده:"، درست‌ها، "از"، ویژگی آزمون.سطرها
    هر م در [ویژگی آموزش، آموزش برچسب، ویژگی آزمون، آزمون برچسب، مرکزها، اندازه‌ها]:
        ناپایا موقت := م
        ماتریس.آزادسازی(موقت)
    پایان
    پیمایشگر.آزادسازی()
    مجموعه.آزادسازی()
    برگشت ۰
پایان
