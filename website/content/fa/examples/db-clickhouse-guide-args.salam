واردسازی دیتابیس.کلیک هاوس

تابع ریشه:
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    آرگ.بیفزا(کلیک هاوس.آرگومان رشته("o'brien"))
    آرگ.بیفزا(کلیک هاوس.آرگومان صحیح(۴۲ برگردان صحیح۶۴))
    سرچاپ کلیک هاوس.پیوند("SELECT * FROM users WHERE name = ? AND age > ?"، آرگ)
    ناپایا یک := وکتور {} برگردان وکتور<رشته>
    یک.بیفزا(کلیک هاوس.آرگومان صحیح(۷ برگردان صحیح۶۴))
    سرچاپ کلیک هاوس.پیوند("SELECT '?' AS mark, ? /* ? */"، یک)
    سرچاپ کلیک هاوس.نقل قول شناسه("my table")
    سرچاپ کلیک هاوس.پیوند("SELECT ?"، آرگ).طول()
پایان
