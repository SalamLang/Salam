واردسازی دیتابیس.کلیک هاوس

تابع ریشه:
    ناپایا گ := کلیک هاوس.گزینه‌های پیش‌فرض()
    گ.نشانی = "127.0.0.1:8123"
    گ.پایگاه داده = "default"
    گ.نام کاربری = "default"
    ناپایا ا := کلیک هاوس.باز کردن(گ)
    دیرکن ا.بستن()
    اگر وارونه ا.پینگ():
        سرچاپ "no ClickHouse at"، گ.نشانی
        برگشت ۱
    پایان
    سرچاپ ا.نسخه کارگزار()

    هیچ := وکتور {} برگردان وکتور<رشته>
    خوب := ا.اجرا("CREATE TABLE IF NOT EXISTS visits (day Date, page String, hits UInt32) ENGINE = MergeTree ORDER BY (day, page)"، هیچ)
    اگر وارونه خوب:
        سرچاپ "create failed:"، ا.کد()، ا.خطا()
        برگشت ۱
    پایان
    سرچاپ "table ready"
پایان
