واردسازی دیتابیس.کلیک هاوس

تابع ردیف(روز: رشته، صفحه: رشته، بازدید: صحیح۶۴): وکتور<رشته>:
    ناپایا ر := وکتور {} برگردان وکتور<رشته>
    ر.بیفزا(کلیک هاوس.آرگومان رشته(روز))
    ر.بیفزا(کلیک هاوس.آرگومان رشته(صفحه))
    ر.بیفزا(کلیک هاوس.آرگومان صحیح(بازدید))
    برگشت ر
پایان

تابع ریشه:
    ناپایا ا := کلیک هاوس.باز کردن(کلیک هاوس.گزینه‌های پیش‌فرض())
    دیرکن ا.بستن()
    ناپایا دسته := ا.آماده‌سازی دسته("INSERT INTO visits (day, page, hits)")
    اگر دسته.خطا().طول() بزرگتر 0:
        سرچاپ دسته.خطا()
        برگشت ۱
    پایان
    دسته.افزودن(ردیف("2026-11-01"، "/"، ۱۲۰ برگردان صحیح۶۴))
    دسته.افزودن(ردیف("2026-11-01"، "/docs"، ۴۵ برگردان صحیح۶۴))
    دسته.افزودن(ردیف("2026-11-02"، "/"، ۹۸ برگردان صحیح۶۴))
    سرچاپ دسته.طول()، "rows queued"
    اگر وارونه ا.ارسال دسته(دسته):
        سرچاپ "insert failed:"، ا.خطا()
        برگشت ۱
    پایان
    سرچاپ "inserted"
پایان
