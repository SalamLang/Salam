واردسازی دیتابیس.کلیک هاوس

تابع ریشه:
    ناپایا ا := کلیک هاوس.باز کردن(کلیک هاوس.گزینه‌های پیش‌فرض())
    دیرکن ا.بستن()
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    آرگ.بیفزا(کلیک هاوس.آرگومان رشته("2026-11-01"))
    ناپایا ردیف‌ها := ا.پرسمان("SELECT page, sum(hits) AS total FROM visits WHERE day >= ? GROUP BY page ORDER BY total DESC"، آرگ)
    اگر وارونه ردیف‌ها.معتبر():
        سرچاپ ردیف‌ها.خطا()
        برگشت ۱
    پایان
    تا ردیف‌ها.بعدی():
        سرچاپ ردیف‌ها.متن(۰)، ردیف‌ها.صحیح۶۴(۱)
    پایان
    ردیف‌ها.بستن()

    ناپایا پارامتر := نگاشت {} برگردان نگاشت<رشته، رشته>
    پارامتر.درج("page"، "/docs")
    ناپایا یک := ا.پرسمان با پارامتر("SELECT sum(hits) FROM visits WHERE page = {page:String}"، پارامتر)
    تا یک.بعدی():
        سرچاپ "docs:"، یک.صحیح۶۴(۰)
    پایان
    یک.بستن()
پایان
