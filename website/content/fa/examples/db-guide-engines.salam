واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت
واردسازی دیتابیس.پستگرس
واردسازی دیتابیس.مای اس کیو ال
واردسازی محیط

تابع وصل شدن(): پویا دیتابیس.اتصال:
    موتور := محیط.دریافت با پیش فرض("APP_DB"، "sqlite")
    اگر موتور == "postgres":
        برگشت پستگرس.اتصال(پستگرس.بازکردن("host=127.0.0.1 port=5432 user=app password=secret dbname=app"))
    وگرنه موتور == "mysql":
        برگشت مای اس کیو ال.اتصال(مای اس کیو ال.بازکردن("127.0.0.1"، "app"، "secret"، "app"، ۳۳۰۶))
    پایان
    برگشت اس کیو لایت.اتصال(اس کیو لایت.بازکردن("app.db"))
پایان

تابع ریشه:
    پ := وصل شدن()
    اگر وارونه پ.معتبر():
        سرچاپ "اتصال به"، پ.نوع()، "برقرار نشد:"، پ.خطا()
        برگشت ۱
    پایان
    سرچاپ "وصل شد به"، پ.نوع()
    _ := دیتابیس.اجرا کن(پ، "CREATE TABLE IF NOT EXISTS visits (page VARCHAR(100))")
    _ := دیتابیس.اجرا کن(پ، "INSERT INTO visits (page) VALUES ('home')")
    سرچاپ "تعداد بازدیدها تا این‌جا:"، دیتابیس.پرسمان عدد(پ، "SELECT COUNT(*) FROM visits")
    _ := پ.بستن()
    برگشت ۰
پایان
