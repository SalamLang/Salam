واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع مهاجرت‌ها(): دیتابیس.مهاجرت گر:
    ناپایا م := دیتابیس.مهاجرت گر جدید()
    دیتابیس.افزودن مهاجرت(م، ۱، "ساخت کاربران"، "CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT NOT NULL UNIQUE)"، "DROP TABLE users")
    دیتابیس.افزودن مهاجرت(م، ۲، "افزودن نام"، "ALTER TABLE users ADD COLUMN name TEXT DEFAULT ''"، "ALTER TABLE users DROP COLUMN name")
    برگشت م
پایان

تابع راه اندازی(پ: پویا دیتابیس.اتصال):
    ناپایا م := مهاجرت‌ها()
    پیش := دیتابیس.نسخه طرح‌واره(م، پ)
    اعمال شده := دیتابیس.مهاجرت به بالا(م، پ)
    سرچاپ "طرح‌واره"، پیش، "به"، دیتابیس.نسخه طرح‌واره(م، پ)، "(" + اعمال شده + " مهاجرت اعمال شد)"
    دیتابیس.آزادکردن مهاجرت گر(م)
پایان

تابع ریشه:
    پ := اس کیو لایت.اتصال(اس کیو لایت.بازکردن(":memory:"))
    راه اندازی(پ)
    سرچاپ دیتابیس.اجرا کن(پ، "INSERT INTO users (email, name) VALUES ('a@x.ir', 'علی')")
    راه اندازی(پ)
    ناپایا م := مهاجرت‌ها()
    دیتابیس.افزودن مهاجرت(م، ۳، "افزودن شهر"، "ALTER TABLE users ADD COLUMN city TEXT"، "ALTER TABLE users DROP COLUMN city")
    سرچاپ "در انتظار:"، دیتابیس.تعداد در انتظار(م، پ)
    سرچاپ "اعمال شد:"، دیتابیس.مهاجرت به بالا(م، پ)، "اکنون در نسخه‌ی"، دیتابیس.نسخه طرح‌واره(م، پ)
    سرچاپ دیتابیس.پرسمان متن(پ، "SELECT name FROM users WHERE email = 'a@x.ir'")
    دیتابیس.آزادکردن مهاجرت گر(م)
    _ := پ.بستن()
پایان
