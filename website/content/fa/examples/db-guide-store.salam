واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع آماده سازی(پ: پویا دیتابیس.اتصال): منطقی:
    برگشت دیتابیس.اجرا کن(پ، "CREATE TABLE notes (id INTEGER PRIMARY KEY, author TEXT NOT NULL, body TEXT NOT NULL)")
پایان

تابع افزودن یادداشت(پ: پویا دیتابیس.اتصال، نویسنده: رشته، متن: رشته): صحیح۶۴:
    دستور := "INSERT INTO notes (author, body) VALUES (" + دیتابیس.نقل قول(نویسنده) + ", " + دیتابیس.نقل قول(متن) + ")"
    اگر وارونه دیتابیس.اجرا کن(پ، دستور):
        سرچاپ "درج نشد:"، پ.خطا()
        برگشت ۰
    پایان
    برگشت پ.شناسه آخرین درج()
پایان

تابع نمایش یادداشت‌ها(پ: پویا دیتابیس.اتصال، نویسنده: رشته):
    ردیف‌ها := پ.پرسمان("SELECT id, body FROM notes WHERE author = " + دیتابیس.نقل قول(نویسنده) + " ORDER BY id")
    تا ردیف‌ها.بعدی():
        سرچاپ "#" + ردیف‌ها.عدد صحیح(۰)، ردیف‌ها.متن(۱)
    پایان
    _ := ردیف‌ها.بستن()
پایان

تابع ریشه:
    پ := اس کیو لایت.اتصال(اس کیو لایت.بازکردن(":memory:"))
    اگر وارونه آماده سازی(پ):
        سرچاپ "آماده‌سازی نشد:"، پ.خطا()
        برگشت ۱
    پایان
    افزودن یادداشت(پ، "سارا"، "خرید شیر")
    افزودن یادداشت(پ، "امید"، "تماس با بانک")
    افزودن یادداشت(پ، "سارا"، "تولد 'رضا' است")
    افزودن یادداشت(پ، "x' OR '1'='1"، "تلاش برای نفوذ")
    نمایش یادداشت‌ها(پ، "سارا")
    سرچاپ "یادداشت‌های امید:"، دیتابیس.پرسمان عدد(پ، "SELECT COUNT(*) FROM notes WHERE author = 'امید'")
    سرچاپ "همه‌ی یادداشت‌ها:"، دیتابیس.پرسمان عدد(پ، "SELECT COUNT(*) FROM notes")
    _ := پ.بستن()
    برگشت ۰
پایان
