واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع انتقال(پ: پویا دیتابیس.اتصال، از حساب: صحیح، به حساب: صحیح، مبلغ: صحیح): رشته:
    ت := پ.شروع تراکنش()
    اگر وارونه ت.معتبر():
        برگشت "شروع نشد: " + پ.خطا()
    پایان
    _ := ت.اجرا("UPDATE accounts SET balance = balance - " + مبلغ + " WHERE id = " + از حساب)
    _ := ت.اجرا("UPDATE accounts SET balance = balance + " + مبلغ + " WHERE id = " + به حساب)
    ردیف‌ها := ت.پرسمان("SELECT balance FROM accounts WHERE id = " + از حساب)
    ناپایا مانده := ۰
    اگر ردیف‌ها.بعدی():
        مانده = ردیف‌ها.عدد صحیح(۰)
    پایان
    _ := ردیف‌ها.بستن()
    اگر مانده < ۰:
        _ := ت.بازگردانی()
        برگشت "رد شد، فقط " + (مانده + مبلغ) + " مانده"
    پایان
    _ := ت.ثبت تراکنش()
    برگشت مبلغ + " منتقل شد"
پایان

تابع موجودی‌ها(پ: پویا دیتابیس.اتصال): رشته:
    برگشت دیتابیس.پرسمان متن(پ، "SELECT group_concat(name || '=' || balance, ' ') FROM accounts")
پایان

تابع ریشه:
    پ := اس کیو لایت.اتصال(اس کیو لایت.بازکردن(":memory:"))
    ناپایا آغاز := وکتور {} برگردان وکتور<رشته>
    دیرکن آغاز.آزادکن()
    آغاز.بیفزا("CREATE TABLE accounts (id INTEGER PRIMARY KEY, name TEXT, balance INTEGER)")
    آغاز.بیفزا("INSERT INTO accounts VALUES (1, 'علی', 100), (2, 'سارا', 50)")
    سرچاپ دیتابیس.در تراکنش(پ، آغاز)
    سرچاپ انتقال(پ، ۱، ۲، ۳۰)، "|"، موجودی‌ها(پ)
    سرچاپ انتقال(پ، ۱، ۲، ۵۰۰)، "|"، موجودی‌ها(پ)
    سرچاپ انتقال(پ، ۲، ۱، ۸۰)، "|"، موجودی‌ها(پ)
    _ := پ.بستن()
پایان
