واردسازی دیتابیس.مای اس کیو ال

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    سرچاپ "سرور:"، مای اس کیو ال.نسخه سرور(پ)
    سرچاپ "کارخواه:"، مای اس کیو ال.نسخه کلاینت()
    سرچاپ "زنده است:"، مای اس کیو ال.پینگ(پ)
    سرچاپ "پایگاه داده:"، مای اس کیو ال.پرسمان متن(پ، "SELECT DATABASE()")
    سرچاپ "کدینگ:"، مای اس کیو ال.پرسمان متن(پ، "SELECT @@character_set_connection")
    سرچاپ "رمزنگاری:"، مای اس کیو ال.پرسمان متن(پ، "SELECT VARIABLE_VALUE FROM information_schema.SESSION_STATUS WHERE VARIABLE_NAME = 'Ssl_version'")

    رمز غلط := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "wrong"، "shop"، ۳۳۰۶)
    سرچاپ "با گذرواژه نادرست:"، مای اس کیو ال.معتبر(رمز غلط)
    سرچاپ مای اس کیو ال.خطا(رمز غلط)

    بی پاسخ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۷)
    سرچاپ مای اس کیو ال.خطا(بی پاسخ)
    برگشت ۰
پایان
