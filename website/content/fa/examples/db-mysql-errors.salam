واردسازی دیتابیس.مای اس کیو ال

تابع امتحان(پ: مای اس کیو ال.پایگاه داده، دستور: رشته):
    اگر مای اس کیو ال.اجرا(پ، دستور) == ۰:
        سرچاپ "انجام شد"
        برگشت
    پایان
    سرچاپ "کد خطا"، مای اس کیو ال.کدخطا(پ)، "پیام:"، مای اس کیو ال.خطا(پ)
پایان

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    امتحان(پ، "INSERT INTO books (title, author, price) VALUES ('A Wizard of Earthsea', 'Someone', 5)")
    امتحان(پ، "INSERT INTO orders (book_id, customer, qty, total) VALUES (99, 'Omid', 1, 5)")
    امتحان(پ، "INSERT INTO books (title, author) VALUES ('No Price', 'Nobody')")
    امتحان(پ، "SELEC title FROM books")
    امتحان(پ، "UPDATE books SET stock = stock WHERE id = 1")

    ن := مای اس کیو ال.پرسمان(پ، "SELECT name FROM authors")
    اگر وارونه مای اس کیو ال.پرسمان معتبر(ن):
        سرچاپ "پرسمان شکست خورد:"، مای اس کیو ال.کدخطا(پ)، مای اس کیو ال.خطا(پ)
    پایان

    سرچاپ "هنوز وصل است:"، مای اس کیو ال.پینگ(پ)
    سرچاپ "موجودی کتاب ۱:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT stock FROM books WHERE id = 1")
    برگشت ۰
پایان
