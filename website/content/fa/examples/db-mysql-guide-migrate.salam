واردسازی دیتابیس
واردسازی دیتابیس.مای اس کیو ال

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    ا := مای اس کیو ال.اتصال(پ)

    ناپایا م := دیتابیس.مهاجرت گر جدید()
    دیتابیس.افزودن مهاجرت(م، ۱، "reviews"، "CREATE TABLE reviews (id INT AUTO_INCREMENT PRIMARY KEY, book_id INT NOT NULL, stars TINYINT NOT NULL)"، "DROP TABLE reviews")
    دیتابیس.افزودن مهاجرت(م، ۲، "review text"، "ALTER TABLE reviews ADD COLUMN body TEXT NULL"، "ALTER TABLE reviews DROP COLUMN body")

    سرچاپ "نسخه پیش از کار:"، دیتابیس.نسخه طرح‌واره(م، ا)، "در انتظار:"، دیتابیس.تعداد در انتظار(م، ا)
    سرچاپ "اجرا شد:"، دیتابیس.مهاجرت به بالا(م، ا)
    سرچاپ "نسخه پس از کار:"، دیتابیس.نسخه طرح‌واره(م، ا)
    سرچاپ "اجرا شده در بار دوم:"، دیتابیس.مهاجرت به بالا(م، ا)
    سرچاپ "ستون‌های reviews:"، دیتابیس.پرسمان عدد(ا، "SELECT COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = 'shop' AND TABLE_NAME = 'reviews'")

    سرچاپ "برگردانده شد:"، دیتابیس.بازگردانی(م، ا)
    سرچاپ "نسخه اکنون:"، دیتابیس.نسخه طرح‌واره(م، ا)
    سرچاپ "رفتن به نسخه ۰:"، دیتابیس.مهاجرت به(م، ا، ۰)
    سرچاپ "جدول reviews مانده:"، دیتابیس.پرسمان عدد(ا، "SELECT COUNT(*) FROM information_schema.TABLES WHERE TABLE_SCHEMA = 'shop' AND TABLE_NAME = 'reviews'")
    دیتابیس.آزادکردن مهاجرت گر(م)
    ا.بستن()
    برگشت ۰
پایان
