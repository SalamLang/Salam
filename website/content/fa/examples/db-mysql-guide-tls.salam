واردسازی محیط
واردسازی دیتابیس.مای اس کیو ال

تابع وضعیت(پ: مای اس کیو ال.پایگاه داده، نام: رشته): رشته:
    برگشت مای اس کیو ال.پرسمان متن(پ، "SELECT VARIABLE_VALUE FROM information_schema.SESSION_STATUS WHERE VARIABLE_NAME = '" + نام + "'")
پایان

تابع ریشه:
    حالت := محیط.دریافت با پیش فرض("SALAM_MYSQL_SSL_MODE"، "(تنظیم نشده)")
    سرچاپ "SALAM_MYSQL_SSL_MODE:"، حالت
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    نسخه := وضعیت(پ، "Ssl_version")
    اگر نسخه == "":
        سرچاپ "این اتصال رمزنگاری نشده است"
    وگرنه:
        سرچاپ "رمزنگاری با"، نسخه، "و رمز"، وضعیت(پ، "Ssl_cipher")
    پایان
    برگشت ۰
پایان
