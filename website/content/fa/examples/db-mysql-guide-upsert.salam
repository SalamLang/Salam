واردسازی رشته
واردسازی دیتابیس.مای اس کیو ال

ساختار رسیده:
    همگانی عنوان: رشته = ""
    همگانی نویسنده: رشته = ""
    همگانی قیمت: رشته = ""
    همگانی نسخه ها: صحیح = ۰
پایان

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    ناپایا جعبه := وکتور {} برگردان وکتور<رسیده>
    جعبه.بیفزا(رسیده { عنوان = "A Wizard of Earthsea"، نویسنده = "Ursula K. Le Guin"، قیمت = "9.99"، نسخه ها = ۴ })
    جعبه.بیفزا(رسیده { عنوان = "The Tombs of Atuan"، نویسنده = "Ursula K. Le Guin"، قیمت = "9.99"، نسخه ها = ۳ })
    جعبه.بیفزا(رسیده { عنوان = "Kafka on the Shore"، نویسنده = "Haruki Murakami"، قیمت = "13.40"، نسخه ها = ۲ })

    ناپایا ردیف ها := وکتور {} برگردان وکتور<رشته>
    هر ک در جعبه:
        ردیف ها.بیفزا("(" + پ.نقل قول(ک.عنوان) + ", " + پ.نقل قول(ک.نویسنده) + ", " + ک.قیمت + ", " + رشته.از عدد(ک.نسخه ها) + ")")
    پایان
    دستور := "INSERT INTO books (title, author, price, stock) VALUES " + رشته.بپیوند(ردیف ها، ", ") + " ON DUPLICATE KEY UPDATE stock = stock + VALUES(stock), price = VALUES(price)"
    اگر مای اس کیو ال.اجرا(پ، دستور) != ۰:
        سرچاپ "درون‌ریزی شکست خورد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    سرچاپ "ردیف‌های تحت تاثیر:"، مای اس کیو ال.ردیف های تحت تاثیر(پ)
    سرچاپ "شمار کتاب‌ها:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT COUNT(*) FROM books")
    سرچاپ "موجودی Earthsea:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT stock FROM books WHERE title = 'A Wizard of Earthsea'")
    برگشت ۰
پایان
