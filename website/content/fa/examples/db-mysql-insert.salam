واردسازی دیتابیس.مای اس کیو ال

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    مای اس کیو ال.اجرا(پ، `INSERT INTO books (title, author, price, stock, details) VALUES ('Master and Commander', 'Patrick O''Brian', 14.50, 4, '{"pages": 412, "tags": ["sea", "navy"]}')`)
    سرچاپ "شناسه کتاب اول:"، مای اس کیو ال.شناسه آخرین درج(پ)

    مای اس کیو ال.اجرا(پ، "INSERT INTO books (title, author, price, stock, isbn) VALUES ('The Remains of the Day', 'Kazuo Ishiguro', 11.25, 2, '9780571200733')")
    سرچاپ "شناسه کتاب دوم:"، مای اس کیو ال.شناسه آخرین درج(پ)

    چند ردیف := `INSERT INTO books (title, author, price, stock, details) VALUES
        ('A Wizard of Earthsea', 'Ursula K. Le Guin', 9.99, 6, '{"pages": 183, "tags": ["fantasy"]}'),
        ('The Blind Owl', 'Sadegh Hedayat', 8.00, 3, NULL),
        ('شازده احتجاب', 'هوشنگ گلشیری', 7.50, 5, '{"pages": 120, "tags": ["novel"]}')`
    مای اس کیو ال.اجرا(پ، چند ردیف)
    سرچاپ "ردیف‌های افزوده:"، مای اس کیو ال.ردیف های تحت تاثیر(پ)
    سرچاپ "شناسه نخستین ردیف همین درج:"، مای اس کیو ال.شناسه آخرین درج(پ)

    سرچاپ "شمار کتاب‌ها:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT COUNT(*) FROM books")
    سرچاپ "کل موجودی:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT SUM(stock) FROM books")
    برگشت ۰
پایان
