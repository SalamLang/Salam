واردسازی دیتابیس.مای اس کیو ال

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    مای اس کیو ال.اجرا(پ، "UPDATE books SET isbn = '9780393307054' WHERE id = 1")

    ناپایا ن := مای اس کیو ال.پرسمان(پ، "SELECT title, isbn, JSON_VALUE(details, '$.pages') FROM books ORDER BY id")
    تا مای اس کیو ال.بعدی(ن):
        ناپایا شابک := مای اس کیو ال.متن(ن، ۱)
        اگر مای اس کیو ال.خالی است(ن، ۱):
            شابک = "(بی شابک)"
        پایان
        ناپایا صفحه ها := "نامعلوم"
        اگر وارونه مای اس کیو ال.خالی است(ن، ۲):
            صفحه ها = مای اس کیو ال.متن(ن، ۲) + " صفحه"
        پایان
        سرچاپ مای اس کیو ال.متن(ن، ۰)، "|"، شابک، "|"، صفحه ها
    پایان
    مای اس کیو ال.پایان(ن)

    سرچاپ "با IS NULL:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT COUNT(*) FROM books WHERE isbn IS NULL")
    سرچاپ "با = NULL:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT COUNT(*) FROM books WHERE isbn = NULL")
    سرچاپ "عدد صحیحِ NULL:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT NULL")
    سرچاپ "COALESCE:"، مای اس کیو ال.پرسمان متن(پ، "SELECT COALESCE(isbn, 'none') FROM books WHERE id = 3")
    برگشت ۰
پایان
