واردسازی دیتابیس
واردسازی دیتابیس.مای اس کیو ال

تابع ریشه:
    ناپایا استخر := دیتابیس.استخر جدید(۳)
    تکرار ۳ در شماره:
        پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
        اگر وارونه مای اس کیو ال.معتبر(پ):
            سرچاپ "اتصال"، شماره، "برقرار نشد:"، مای اس کیو ال.خطا(پ)
            برگشت ۱
        پایان
        دیتابیس.افزودن(استخر، مای اس کیو ال.اتصال(پ))
    پایان
    سرچاپ "اندازه:"، دیتابیس.اندازه(استخر)، "بیکار:"، دیتابیس.بیکار(استخر)

    الف := دیتابیس.گرفتن(استخر)
    ب := دیتابیس.گرفتن(استخر)
    اتصال الف := دیتابیس.اتصال اجاره‌ای(استخر، الف)
    اتصال ب := دیتابیس.اتصال اجاره‌ای(استخر، ب)
    سرچاپ "نوع:"، اتصال الف.نوع()، "در کار:"، دیتابیس.در استفاده(استخر)
    سرچاپ "نشست‌های جدا:"، دیتابیس.پرسمان عدد(اتصال الف، "SELECT CONNECTION_ID()") != دیتابیس.پرسمان عدد(اتصال ب، "SELECT CONNECTION_ID()")

    انبار := وکتور {} برگردان وکتور<رشته>
    انبار.بیفزا("UPDATE books SET stock = stock + 5 WHERE id = 1")
    انبار.بیفزا("UPDATE books SET stock = stock + 5 WHERE id = 3")
    سرچاپ "افزایش موجودی در یک تراکنش:"، دیتابیس.در تراکنش(اتصال ب، انبار)
    سرچاپ "موجودی کتاب ۱ از دید اتصال دیگر:"، دیتابیس.پرسمان عدد(اتصال الف، "SELECT stock FROM books WHERE id = 1")

    ج := دیتابیس.گرفتن(استخر)
    چهارمی := دیتابیس.گرفتن(استخر)
    سرچاپ "اجاره چهارم:"، دیتابیس.اجاره شده(چهارمی)

    دیتابیس.رهاکردن(استخر، الف)
    دیتابیس.رهاکردن(استخر، ب)
    دیتابیس.رهاکردن(استخر، ج)
    سرچاپ "دوباره بیکار:"، دیتابیس.بیکار(استخر)
    سرچاپ "اتصال‌های مرده حذف‌شده:"، دیتابیس.حذف مرده ها(استخر)
    دیتابیس.آزادکردن(استخر)
    برگشت ۰
پایان
