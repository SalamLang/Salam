واردسازی دیتابیس.مای اس کیو ال

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    فروش := `SELECT b.title, SUM(o.qty), SUM(o.total), COUNT(DISTINCT o.customer)
        FROM orders o JOIN books b ON b.id = o.book_id
        GROUP BY b.id, b.title
        ORDER BY SUM(o.total) DESC`
    ناپایا ن := مای اس کیو ال.پرسمان(پ، فروش)
    سرچاپ مای اس کیو ال.تعداد ردیف(ن)، "کتاب فروش رفته"
    تا مای اس کیو ال.بعدی(ن):
        سرچاپ مای اس کیو ال.متن(ن، ۰)، "| نسخه"، مای اس کیو ال.عدد صحیح(ن، ۱)، "| فروش"، مای اس کیو ال.متن(ن، ۲)، "| مشتری"، مای اس کیو ال.عدد صحیح(ن، ۳)
    پایان
    مای اس کیو ال.پایان(ن)

    سرچاپ "هرگز فروش نرفته:"، مای اس کیو ال.پرسمان متن(پ، "SELECT GROUP_CONCAT(title ORDER BY id SEPARATOR ', ') FROM books WHERE id NOT IN (SELECT book_id FROM orders)")
    سرچاپ "درباره دریا:"، مای اس کیو ال.پرسمان متن(پ، "SELECT title FROM books WHERE JSON_CONTAINS(details, '\"sea\"', '$.tags')")
    سرچاپ "صفحه‌های روی قفسه:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT SUM(stock * JSON_VALUE(details, '$.pages')) FROM books")
    سرچاپ "ارزش موجودی:"، مای اس کیو ال.پرسمان متن(پ، "SELECT SUM(stock * price) FROM books")
    برگشت ۰
پایان
