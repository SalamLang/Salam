واردسازی رشته
واردسازی دیتابیس.مای اس کیو ال

تابع شمار کتاب های نویسنده(پ: مای اس کیو ال.پایگاه داده، نام: رشته): صحیح:
    برگشت مای اس کیو ال.پرسمان عدد(پ، "SELECT COUNT(*) FROM books WHERE author = " + پ.نقل قول(نام))
پایان

تابع الگوی جستجو(پ: مای اس کیو ال.پایگاه داده، واژه: رشته): رشته:
    ناپایا امن := مای اس کیو ال.اسکیپ(پ، واژه)
    امن = رشته.جایگزینی(امن، "%"، "\\%")
    امن = رشته.جایگزینی(امن، "_"، "\\_")
    برگشت "'%" + امن + "%'"
پایان

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    سرچاپ "از Patrick O'Brian:"، شمار کتاب های نویسنده(پ، "Patrick O'Brian")
    سرچاپ "از هوشنگ گلشیری:"، شمار کتاب های نویسنده(پ، "هوشنگ گلشیری")

    حمله := "nobody' OR '1'='1"
    سرچاپ "نقل‌قول‌شده:"، پ.نقل قول(حمله)
    سرچاپ "پرسمان امن پیدا می‌کند:"، شمار کتاب های نویسنده(پ، حمله)
    ناامن := "SELECT COUNT(*) FROM books WHERE author = '" + حمله + "'"
    سرچاپ "پرسمان چسبانده پیدا می‌کند:"، مای اس کیو ال.پرسمان عدد(پ، ناامن)

    سرچاپ "عنوان‌های دارای the:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT COUNT(*) FROM books WHERE title LIKE " + الگوی جستجو(پ، "the"))
    سرچاپ "عنوان‌های دارای %:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT COUNT(*) FROM books WHERE title LIKE " + الگوی جستجو(پ، "%"))
    برگشت ۰
پایان
