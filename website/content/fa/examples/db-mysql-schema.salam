واردسازی دیتابیس.مای اس کیو ال

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    مای اس کیو ال.اجرا(پ، "DROP TABLE IF EXISTS orders")
    مای اس کیو ال.اجرا(پ، "DROP TABLE IF EXISTS books")

    کتاب ها := `CREATE TABLE books (
        id INT AUTO_INCREMENT PRIMARY KEY,
        title VARCHAR(200) NOT NULL UNIQUE,
        author VARCHAR(100) NOT NULL,
        price DECIMAL(8, 2) NOT NULL,
        stock INT NOT NULL DEFAULT 0,
        isbn VARCHAR(20) NULL,
        details JSON NULL
    ) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4`
    سرچاپ "جدول کتاب‌ها:"، مای اس کیو ال.اجرا(پ، کتاب ها)

    سفارش ها := `CREATE TABLE orders (
        id INT AUTO_INCREMENT PRIMARY KEY,
        book_id INT NOT NULL,
        customer VARCHAR(100) NOT NULL,
        qty INT NOT NULL,
        total DECIMAL(10, 2) NOT NULL,
        FOREIGN KEY (book_id) REFERENCES books (id)
    ) ENGINE = InnoDB DEFAULT CHARSET = utf8mb4`
    سرچاپ "جدول سفارش‌ها:"، مای اس کیو ال.اجرا(پ، سفارش ها)

    ناپایا ن := مای اس کیو ال.پرسمان(پ، "SELECT TABLE_NAME, COUNT(*) FROM information_schema.COLUMNS WHERE TABLE_SCHEMA = 'shop' AND TABLE_NAME IN ('books', 'orders') GROUP BY TABLE_NAME ORDER BY TABLE_NAME")
    تا مای اس کیو ال.بعدی(ن):
        سرچاپ "جدول"، مای اس کیو ال.متن(ن، ۰)، "ستون دارد:"، مای اس کیو ال.عدد صحیح(ن، ۱)
    پایان
    مای اس کیو ال.پایان(ن)
    برگشت ۰
پایان
