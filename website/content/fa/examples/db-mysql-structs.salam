واردسازی رشته
واردسازی دیتابیس.مای اس کیو ال

ساختار کتاب:
    همگانی شناسه: صحیح = ۰
    همگانی عنوان: رشته = ""
    همگانی نویسنده: رشته = ""
    همگانی قیمت: رشته = ""
    همگانی موجودی: صحیح = ۰
پایان

تابع خواندن کتاب ها(پ: مای اس کیو ال.پایگاه داده، دستور: رشته): وکتور<کتاب>:
    ناپایا خروجی := وکتور {} برگردان وکتور<کتاب>
    ناپایا ن := مای اس کیو ال.پرسمان(پ، دستور)
    اگر وارونه مای اس کیو ال.پرسمان معتبر(ن):
        سرچاپ "پرسمان شکست خورد:"، مای اس کیو ال.خطا(پ)
        برگشت خروجی
    پایان
    تا مای اس کیو ال.بعدی(ن):
        خروجی.بیفزا(کتاب {
            شناسه = مای اس کیو ال.عدد صحیح(ن، ۰)، عنوان = مای اس کیو ال.متن(ن، ۱)، نویسنده = مای اس کیو ال.متن(ن، ۲)، قیمت = مای اس کیو ال.متن(ن، ۳)، موجودی = مای اس کیو ال.عدد صحیح(ن، ۴)
        })
    پایان
    مای اس کیو ال.پایان(ن)
    برگشت خروجی
پایان

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    ن := مای اس کیو ال.پرسمان(پ، "SELECT id, title, author, price, stock FROM books LIMIT 0")
    ناپایا نام ها := وکتور {} برگردان وکتور<رشته>
    تکرار مای اس کیو ال.تعداد ستون(ن) در ستون:
        نام ها.بیفزا(مای اس کیو ال.نام ستون(ن، ستون))
    پایان
    مای اس کیو ال.پایان(ن)
    سرچاپ "ستون‌ها:"، رشته.بپیوند(نام ها، ", ")

    کتاب ها := خواندن کتاب ها(پ، "SELECT id, title, author, price, stock FROM books ORDER BY price DESC")
    هر ک در کتاب ها:
        سرچاپ ک.شناسه، ک.عنوان، "از"، ک.نویسنده، "به قیمت"، ک.قیمت، "و موجودی"، ک.موجودی
    پایان

    ارزان ها := خواندن کتاب ها(پ، "SELECT id, title, author, price, stock FROM books WHERE price < 9 ORDER BY id")
    سرچاپ "زیر ۹:"، ارزان ها.طول()
    برگشت ۰
پایان
