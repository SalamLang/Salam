واردسازی رشته
واردسازی دیتابیس.مای اس کیو ال

تابع ثبت سفارش(پ: مای اس کیو ال.پایگاه داده، کتاب: صحیح، مشتری: رشته، شمار: صحیح): منطقی:
    اگر مای اس کیو ال.شروع تراکنش(پ) != ۰:
        برگشت نادرست
    پایان
    شناسه := رشته.از عدد(کتاب)
    تعداد := رشته.از عدد(شمار)
    مای اس کیو ال.اجرا(پ، "UPDATE books SET stock = stock - " + تعداد + " WHERE id = " + شناسه + " AND stock >= " + تعداد)
    اگر مای اس کیو ال.ردیف های تحت تاثیر(پ) != ۱:
        مای اس کیو ال.بازگردانی(پ)
        برگشت نادرست
    پایان
    دستور := "INSERT INTO orders (book_id, customer, qty, total) SELECT id, " + پ.نقل قول(مشتری) + ", " + تعداد + ", price * " + تعداد + " FROM books WHERE id = " + شناسه
    اگر مای اس کیو ال.اجرا(پ، دستور) != ۰:
        مای اس کیو ال.بازگردانی(پ)
        برگشت نادرست
    پایان
    برگشت مای اس کیو ال.ثبت تراکنش(پ) == ۰
پایان

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    سرچاپ "سارا، ۲ نسخه از کتاب ۳:"، ثبت سفارش(پ، ۳، "سارا"، ۲)
    سرچاپ "رضا، ۱ نسخه از کتاب ۱:"، ثبت سفارش(پ، ۱، "رضا"، ۱)
    سرچاپ "ندا، ۳ نسخه از کتاب ۵:"، ثبت سفارش(پ، ۵، "ندا"، ۳)
    سرچاپ "علی، ۹ نسخه از کتاب ۱:"، ثبت سفارش(پ، ۱، "علی"، ۹)
    سرچاپ "امید، ۱ نسخه از کتاب ۹۹:"، ثبت سفارش(پ، ۹۹، "امید"، ۱)

    سرچاپ "سفارش‌ها:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT COUNT(*) FROM orders")
    سرچاپ "موجودی کتاب ۱:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT stock FROM books WHERE id = 1")
    سرچاپ "موجودی کتاب ۳:"، مای اس کیو ال.پرسمان عدد(پ، "SELECT stock FROM books WHERE id = 3")
    سرچاپ "فروش:"، مای اس کیو ال.پرسمان متن(پ، "SELECT SUM(total) FROM orders")
    برگشت ۰
پایان
