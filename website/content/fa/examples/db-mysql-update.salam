واردسازی دیتابیس.مای اس کیو ال

تابع ریشه:
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "salam"، "secret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ "اتصال برقرار نشد:"، مای اس کیو ال.خطا(پ)
        برگشت ۱
    پایان
    دیرکن مای اس کیو ال.بستن(پ)

    مای اس کیو ال.اجرا(پ، "UPDATE books SET stock = stock + 10 WHERE author = 'Kazuo Ishiguro'")
    سرچاپ "موجودی افزوده شد:"، مای اس کیو ال.ردیف های تحت تاثیر(پ)

    مای اس کیو ال.اجرا(پ، "UPDATE books SET price = price * 1.10 WHERE price < 9")
    سرچاپ "قیمت تازه:"، مای اس کیو ال.ردیف های تحت تاثیر(پ)

    مای اس کیو ال.اجرا(پ، "UPDATE books SET stock = 12 WHERE id = 2")
    سرچاپ "گذاشتن همان مقدار دوباره تغییر می‌دهد:"، مای اس کیو ال.ردیف های تحت تاثیر(پ)

    مای اس کیو ال.اجرا(پ، "DELETE FROM books WHERE title = 'The Blind Owl'")
    سرچاپ "پاک شد:"، مای اس کیو ال.ردیف های تحت تاثیر(پ)

    ناپایا ن := مای اس کیو ال.پرسمان(پ، "SELECT id, title, price, stock FROM books ORDER BY id")
    تا مای اس کیو ال.بعدی(ن):
        سرچاپ مای اس کیو ال.عدد صحیح(ن، ۰)، مای اس کیو ال.متن(ن، ۱)، مای اس کیو ال.متن(ن، ۲)، مای اس کیو ال.عدد صحیح(ن، ۳)
    پایان
    مای اس کیو ال.پایان(ن)
    برگشت ۰
پایان
