واردسازی دیتابیس.پستگرس

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 port=5432 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)
    اگر وارونه پستگرس.معتبر(پ):
        چاپ "اتصال برقرار نشد: " + پستگرس.خطا(پ)
        برگشت ۱
    پایان
    سرچاپ "وصل شد به"، پستگرس.نام پایگاه داده(پ)، "با کاربر"، پستگرس.نام کاربر(پ)
    سرچاپ "سرور"، پستگرس.نام میزبان(پ) + ":" + پستگرس.درگاه(پ)، "نسخه"، پستگرس.نسخه سرور(پ)
    سرچاپ پستگرس.پرسمان متن(پ، "SELECT split_part(version(), ' on ', 1)")
    سرچاپ "زنده است:"، پستگرس.پینگ(پ)

    اشتباه := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=wrong dbname=bookshop")
    دیرکن پستگرس.بستن(اشتباه)
    سرچاپ "با گذرواژه‌ی نادرست:"، پستگرس.معتبر(اشتباه)
    چاپ پستگرس.خطا(اشتباه)

    خاموش := پستگرس.بازکردن("host=127.0.0.1 port=5499 user=postgres password=secret connect_timeout=3")
    دیرکن پستگرس.بستن(خاموش)
    سرچاپ "وقتی سروری روی درگاه نیست:"، پستگرس.معتبر(خاموش)
    چاپ پستگرس.خطا(خاموش)
پایان
