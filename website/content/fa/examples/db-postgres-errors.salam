واردسازی دیتابیس.پستگرس
واردسازی رشته

تابع آزمودن(پ: پستگرس.پایگاه داده، دستور: رشته):
    اگر پستگرس.اجرا(پ، دستور) نابرابر ۰:
        چاپ پستگرس.خطا(پ)
    پایان
پایان

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)

    آزمودن(پ، "INSERT INTO books (title, author, price) VALUES ('بوف کور', 'کسی دیگر', 5)")
    آزمودن(پ، "UPDATE books SET stock = stock - 50 WHERE id = 1")
    آزمودن(پ، "INSERT INTO orders (customer, book_id, qty, total) VALUES ('امید', 99, 1, 1)")
    آزمودن(پ، "SELEC title FROM books")

    ر := پستگرس.پرسمان(پ، "SELECT nope FROM books")
    سرچاپ "پرسمان معتبر:"، ر.معتبر()، "ردیف:"، ر.تعداد ردیف()، "بعدی:"، ر.بعدی()
    سرچاپ "اجرا با شمارش هنگام خطا:"، پستگرس.اجرا با شمارش(پ، "DELETE FROM nowhere")
    چاپ پستگرس.خطا(پ)

    ت := پ.شروع تراکنش()
    _ := ت.اجرا("UPDATE books SET price = 0 WHERE id = 1")
    _ := ت.اجرا("INSERT INTO books (title) VALUES ('بی‌نام')")
    چاپ پستگرس.خطا(پ)
    _ := ت.اجرا("UPDATE books SET price = 1 WHERE id = 2")
    چاپ پستگرس.خطا(پ)
    ت.بازگردانی()
    سرچاپ "قیمت بوف کور هنوز"، پستگرس.پرسمان متن(پ، "SELECT price FROM books WHERE id = 1")

    قطع کننده := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(قطع کننده)
    فرایند := پستگرس.پرسمان عدد(پ، "SELECT pg_backend_pid()")
    _ := پستگرس.اجرا(قطع کننده، "SELECT pg_terminate_backend(" + رشته.از عدد(فرایند) + ")")
    سرچاپ "پس از قطع شدن از سوی سرور، پینگ:"، پستگرس.پینگ(پ)
    پستگرس.بازنشانی(پ)
    سرچاپ "پس از بازنشانی، پینگ:"، پستگرس.پینگ(پ)، پستگرس.پرسمان عدد(پ، "SELECT count(*) FROM books")
پایان
