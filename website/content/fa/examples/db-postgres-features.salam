واردسازی دیتابیس.پستگرس

تابع نمایش(پ: پستگرس.پایگاه داده، سرتیتر: رشته، دستور: رشته):
    ر := پستگرس.پرسمان(پ، دستور)
    دیرکن ر.بستن()
    سرچاپ سرتیتر
    تا ر.بعدی():
        ناپایا سطر := " "
        تکرار ر.تعداد ستون() در ستون:
            سطر = سطر + " " + ر.متن(ستون)
        پایان
        سرچاپ سطر
    پایان
پایان

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)

    _ := پستگرس.اجرا(پ، `INSERT INTO books (title, author, year, price, stock) VALUES
        ('بوف کور', 'صادق هدایت', 1315, 12.50, 5),
        ('شاهنامه', 'فردوسی', 384, 8.75, 4)
        ON CONFLICT (title) DO UPDATE SET stock = books.stock + EXCLUDED.stock`)
    نمایش(پ، "انبار، افزودن یا اضافه کردن:"، "SELECT title, stock FROM books WHERE title IN ('بوف کور', 'شاهنامه') ORDER BY title")

    _ := پستگرس.اجرا(پ، `UPDATE books SET info = '{"pages": 128, "publisher": "امیرکبیر", "translations": ["فرانسوی", "انگلیسی"]}' WHERE title = 'بوف کور';
        UPDATE books SET info = '{"pages": 1200, "publisher": "قطره"}', tags = '{شعر,کلاسیک}' WHERE title = 'شاهنامه'`)
    نمایش(پ، "فیلدهای jsonb:"، "SELECT title, info->>'publisher', (info->>'pages')::int FROM books WHERE info ? 'publisher' ORDER BY title")
    نمایش(پ، "ترجمه به فرانسوی:"، `SELECT title FROM books WHERE info->'translations' @> '["فرانسوی"]'`)

    نمایش(پ، "آرایه‌ها:"، "SELECT tag, count(*) FROM books, unnest(tags) AS tag GROUP BY tag ORDER BY count(*) DESC, tag")
    نمایش(پ، "جستجوی متنی:"، "SELECT title FROM books WHERE to_tsvector('simple', title) @@ plainto_tsquery('simple', 'مردگان')")
    نمایش(پ، "پرفروش‌ها:"، `SELECT b.author, sum(o.total), rank() OVER (ORDER BY sum(o.total) DESC)
        FROM orders o JOIN books b ON b.id = o.book_id GROUP BY b.author`)
پایان
