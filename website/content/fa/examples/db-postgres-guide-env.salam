واردسازی دیتابیس.پستگرس
واردسازی سیستم عامل

تابع ریشه:
    پ := پستگرس.بازکردن(سیستم عامل.متغیر محیطی("DATABASE_URL"))
    دیرکن پستگرس.بستن(پ)
    اگر وارونه پستگرس.معتبر(پ):
        چاپ "پایگاه داده: " + پستگرس.خطا(پ)
        برگشت ۱
    پایان
    سرچاپ "پایگاه داده‌ی"، پستگرس.نام پایگاه داده(پ)، "روی"، پستگرس.نام میزبان(پ)، "با کاربر"، پستگرس.نام کاربر(پ)
    سرچاپ پستگرس.پرسمان عدد(پ، "SELECT count(*) FROM books")، "کتاب"
پایان
