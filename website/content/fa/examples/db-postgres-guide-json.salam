واردسازی دیتابیس.پستگرس
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

ساختار سفارش:
    همگانی مشتری: رشته = ""
    همگانی تعداد: صحیح = ۰
پایان

ساختار کتاب:
    همگانی عنوان: رشته = ""
    همگانی قیمت: اعشار۶۴ = ۰.۰
    همگانی خریدها: وکتور<سفارش> = وکتور {}
پایان

ساختار قفسه:
    همگانی فهرست: وکتور<کتاب> = وکتور {}
پایان

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)

    متن := پستگرس.پرسمان متن(پ، `SELECT json_build_object('فهرست', coalesce(json_agg(b ORDER BY b."عنوان"), '[]'))
        FROM (SELECT bk.title AS "عنوان", bk.price AS "قیمت",
                     coalesce((SELECT json_agg(json_build_object('مشتری', o.customer, 'تعداد', o.qty) ORDER BY o.id)
                               FROM orders o WHERE o.book_id = bk.id), '[]') AS "خریدها"
              FROM books bk WHERE bk.id IN (SELECT book_id FROM orders)) b`)

    ناپایا قفسه کتاب := قفسه {}
    ناپایا اشکال := خطای کدگذاری.بدون خطا()
    اگر وارونه جیسون.واسریال سازی آسان گیر(متن، قفسه کتاب، اشکال):
        سرچاپ "جیسون نادرست:"، اشکال.پیام
        برگشت ۱
    پایان
    هر ک در قفسه کتاب.فهرست:
        سرچاپ ک.عنوان، ک.قیمت، "سفارش:"، ک.خریدها.طول()
        هر س در ک.خریدها:
            سرچاپ "  " + س.مشتری، "×"، س.تعداد
        پایان
    پایان
پایان
