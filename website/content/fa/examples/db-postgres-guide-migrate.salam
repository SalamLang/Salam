واردسازی دیتابیس
واردسازی دیتابیس.پستگرس

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)
    ا := پستگرس.اتصال(پ)

    ناپایا م := دیتابیس.مهاجرت گر جدید()
    دیرکن دیتابیس.آزادکردن مهاجرت گر(م)
    دیتابیس.افزودن مهاجرت(م، ۱، "نقدها"، `CREATE TABLE reviews (
            id bigint GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
            book_id bigint NOT NULL REFERENCES books (id),
            stars int NOT NULL CHECK (stars BETWEEN 1 AND 5),
            body text)`، "DROP TABLE reviews")
    دیتابیس.افزودن مهاجرت(م، ۲، "نمایه‌ی مشتری سفارش‌ها"، "CREATE INDEX orders_customer ON orders (customer)"، "DROP INDEX orders_customer")

    سرچاپ "نسخه‌ی طرح‌واره"، دیتابیس.نسخه طرح‌واره(م، ا)، "در انتظار"، دیتابیس.تعداد در انتظار(م، ا)
    سرچاپ "اعمال شد:"، دیتابیس.مهاجرت به بالا(م، ا)
    سرچاپ "نسخه‌ی طرح‌واره"، دیتابیس.نسخه طرح‌واره(م، ا)، "در انتظار"، دیتابیس.تعداد در انتظار(م، ا)
    سرچاپ "اعمال شد:"، دیتابیس.مهاجرت به بالا(م، ا)، "در اجرای دوم"

    سرچاپ "بازگردانی:"، دیتابیس.بازگردانی(م، ا)، "اکنون در"، دیتابیس.نسخه طرح‌واره(م، ا)
    سرچاپ "نمایه هست:"، پستگرس.پرسمان عدد(پ، "SELECT count(*) FROM pg_indexes WHERE indexname = 'orders_customer'")
    سرچاپ "مهاجرت تا ۲:"، دیتابیس.مهاجرت به(م، ا، ۲)
    سرچاپ پستگرس.پرسمان متن(پ، "SELECT string_agg(version || ' ' || name, '، ' ORDER BY version) FROM schema_migrations")
پایان
