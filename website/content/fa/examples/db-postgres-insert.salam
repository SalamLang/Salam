واردسازی دیتابیس.پستگرس
واردسازی رشته

تابع افزودن کتاب(پ: پستگرس.پایگاه داده، عنوان: رشته، نویسنده: رشته، سال: صحیح، قیمت: رشته، موجودی: صحیح): صحیح۶۴:
    دستور := "INSERT INTO books (title, author, year, price, stock) VALUES (" + پستگرس.نقل قول(پ، عنوان) + ", " + پستگرس.نقل قول(پ، نویسنده) + ", " + رشته.از عدد(سال) + ", " + قیمت + ", " + رشته.از عدد(موجودی) + ") RETURNING id"
    ر := پستگرس.پرسمان(پ، دستور)
    دیرکن ر.بستن()
    اگر وارونه ر.بعدی():
        چاپ پستگرس.خطا(پ)
        برگشت ۰
    پایان
    برگشت ر.عدد صحیح۶۴(۰)
پایان

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)

    سرچاپ پستگرس.نقل قول(پ، "کتاب 'سووشون' از سیمین دانشور")
    سرچاپ "بوف کور شناسه‌ی"، افزودن کتاب(پ، "بوف کور"، "صادق هدایت"، ۱۳۱۵، "12.50"، ۴)، "گرفت"
    سرچاپ "سووشون شناسه‌ی"، افزودن کتاب(پ، "سووشون"، "سیمین دانشور"، ۱۳۴۸، "9.99"، ۲)، "گرفت"

    تعداد := پستگرس.اجرا با شمارش(پ، `INSERT INTO books (title, author, year, price, stock, isbn, tags) VALUES
        ('گلستان', 'سعدی', 656, 7.25, 3, '978-9643510011', '{شعر,کلاسیک}'),
        ('شازده کوچولو', 'آنتوان دو سنت‌اگزوپری', 1322, 6.00, 10, '978-9643620475', '{افسانه,کلاسیک}'),
        ('سمفونی مردگان', 'عباس معروفی', 1368, 11.00, 1, NULL, '{رمان}')`)
    سرچاپ تعداد، "کتاب دیگر افزوده شد، آخرین شناسه"، پ.شناسه آخرین درج()

    ر := پستگرس.پرسمان(پ، "UPDATE books SET tags = '{رمان,کلاسیک}' WHERE title = 'بوف کور' RETURNING id, title, tags")
    تا ر.بعدی():
        سرچاپ "به‌روز شد"، ر.عدد صحیح(۰)، ر.متن(۱)، ر.متن(۲)
    پایان
    ر.بستن()

    سرچاپ "افزایش قیمت روی"، پستگرس.اجرا با شمارش(پ، "UPDATE books SET price = price + 1 WHERE year < 1300")، "کتاب کهن"
پایان
