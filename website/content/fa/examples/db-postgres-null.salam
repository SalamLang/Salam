واردسازی دیتابیس.پستگرس

تابع مقدار اس کیو ال(پ: پستگرس.پایگاه داده، متن: رشته): رشته:
    اگر متن برابر "":
        برگشت "NULL"
    پایان
    برگشت پستگرس.نقل قول(پ، متن)
پایان

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)

    _ := پستگرس.اجرا(پ، "UPDATE books SET isbn = " + مقدار اس کیو ال(پ، "978-9645595597") + " WHERE title = 'بوف کور'")
    _ := پستگرس.اجرا(پ، "UPDATE books SET isbn = " + مقدار اس کیو ال(پ، "") + " WHERE title LIKE 'سووش%'")

    ر := پستگرس.پرسمان(پ، "SELECT title, isbn FROM books ORDER BY id")
    دیرکن ر.بستن()
    تا ر.بعدی():
        اگر ر.خالی است(۱):
            سرچاپ ر.متن(۰)، "شابک ندارد، متن می‌دهد"، "[" + ر.متن(۱) + "]"
        وگرنه:
            سرچاپ ر.متن(۰)، ر.متن(۱)
        پایان
    پایان

    سرچاپ "بی شابک:"، پستگرس.پرسمان عدد(پ، "SELECT count(*) FROM books WHERE isbn IS NULL")
    سرچاپ "= NULL می‌یابد"، پستگرس.پرسمان عدد(پ، "SELECT count(*) FROM books WHERE isbn = NULL")
    تازه ترین := پستگرس.پرسمان(پ، "SELECT max(year) FROM books WHERE year > 2100")
    دیرکن تازه ترین.بستن()
    تازه ترین.بعدی()
    سرچاپ "بیشینه روی هیچ ردیف:"، تازه ترین.عدد صحیح(۰)، تازه ترین.خالی است(۰)
    سرچاپ پستگرس.پرسمان متن(پ، "SELECT string_agg(coalesce(isbn, 'ندارد'), '، ' ORDER BY id) FROM books")
پایان
