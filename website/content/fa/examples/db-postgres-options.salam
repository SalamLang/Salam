واردسازی دیتابیس.پستگرس

تابع ریشه:
    مدیر := پستگرس.بازکردن کامل("127.0.0.1"، ۵۴۳۲، "postgres"، "secret"، "bookshop")
    دیرکن پستگرس.بستن(مدیر)
    سرچاپ "بازکردن کامل:"، پستگرس.معتبر(مدیر)
    _ := پستگرس.اجرا(مدیر، "DROP ROLE IF EXISTS clerk")
    _ := پستگرس.اجرا(مدیر، "CREATE ROLE clerk LOGIN PASSWORD 'p@ss word'")

    الف := پستگرس.بازکردن("host=127.0.0.1 user=clerk password='p@ss word' dbname=bookshop")
    دیرکن پستگرس.بستن(الف)
    سرچاپ "مقدار در نقل قول:"، پستگرس.معتبر(الف)، پستگرس.نام کاربر(الف)

    ب := پستگرس.بازکردن("postgresql://clerk:p%40ss%20word@127.0.0.1:5432/bookshop?connect_timeout=5")
    دیرکن پستگرس.بستن(ب)
    سرچاپ "نشانی:"، پستگرس.معتبر(ب)، پستگرس.نام کاربر(ب)، پستگرس.نام پایگاه داده(ب)

    ج := پستگرس.بازکردن("host=127.0.0.1 user=clerk password='p@ss word' dbname=bookshop sslmode=disable")
    دیرکن پستگرس.بستن(ج)
    سرچاپ "sslmode=disable:"، پستگرس.معتبر(ج)، پستگرس.پرسمان متن(ج، "SHOW ssl")

    ت := پستگرس.بازکردن("host=127.0.0.1 user=clerk password='p@ss word' dbname=bookshop sslmode=require")
    دیرکن پستگرس.بستن(ت)
    سرچاپ "sslmode=require:"، پستگرس.معتبر(ت)
    چاپ پستگرس.خطا(ت)
پایان
