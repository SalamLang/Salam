واردسازی دیتابیس
واردسازی دیتابیس.پستگرس
واردسازی حافظه
واردسازی نخ

پایا نشانی‌پایگاه := "host=127.0.0.1 user=postgres password=secret dbname=bookshop"

ساختار کار:
    همگانی نویسنده: رشته = ""
    همگانی فروش: صحیح = ۰
پایان

تابع شمارش فروش(ک: کار*):
    پ := پستگرس.بازکردن(نشانی‌پایگاه)
    دیرکن پستگرس.بستن(پ)
    ک[۰].فروش = پستگرس.پرسمان عدد(پ، "SELECT coalesce(sum(o.qty), 0) FROM orders o JOIN books b ON b.id = o.book_id WHERE b.author = " + پستگرس.نقل قول(پ، ک[۰].نویسنده))
پایان

تابع ریشه:
    ناپایا استخر := دیتابیس.استخر جدید(۳)
    دیرکن دیتابیس.آزادکردن(استخر)
    تکرار ۳:
        _ := دیتابیس.افزودن(استخر، پستگرس.اتصال(پستگرس.بازکردن(نشانی‌پایگاه)))
    پایان
    سرچاپ "استخر:"، دیتابیس.اندازه(استخر)، "اتصال،"، دیتابیس.بیکار(استخر)، "بیکار"

    الف := دیتابیس.گرفتن(استخر)
    ب := دیتابیس.گرفتن(استخر)
    سرچاپ "دو درخواست در جریان:"، دیتابیس.در استفاده(استخر)، "در استفاده"
    سرچاپ "کتاب‌ها:"، دیتابیس.پرسمان عدد(دیتابیس.اتصال اجاره‌ای(استخر، الف)، "SELECT count(*) FROM books")، "سفارش‌ها:"، دیتابیس.پرسمان عدد(دیتابیس.اتصال اجاره‌ای(استخر، ب)، "SELECT count(*) FROM orders")
    دیتابیس.رهاکردن(استخر، الف)
    دیتابیس.رهاکردن(استخر، ب)

    ناپایا کارها := وکتور {} برگردان وکتور<کار*>
    دیرکن کارها.آزادکن()
    ناپایا گروه := وکتور {} برگردان وکتور<نخ.نخ>
    دیرکن گروه.آزادکن()
    هر نام در ["صادق هدایت"، "عباس معروفی"، "آنتوان دو سنت‌اگزوپری"، "سعدی"]:
        ک := حافظه.تخصیص(اندازه‌گونه(کار)) برگردان کار*
        ک[۰] = کار { نویسنده = نام }
        کارها.بیفزا(ک)
        گروه = نخ.جمع آوری(گروه، نخ‌ساز(شمارش فروش، ک))
    پایان
    نخ.پیوستن به همه(گروه)
    هر ک در کارها:
        سرچاپ ک[۰].نویسنده، "فروش"، ک[۰].فروش
        حافظه.آزادسازی(ک برگردان تهی*)
    پایان
پایان
