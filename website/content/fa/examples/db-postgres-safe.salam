واردسازی دیتابیس.پستگرس
واردسازی تبدیل
واردسازی رشته

تابع الگوی شبیه(متن: رشته): رشته:
    برگشت "%" + رشته.جایگزینی(رشته.جایگزینی(رشته.جایگزینی(متن، "\\"، "\\\\")، "%"، "\\%")، "_"، "\\_") + "%"
پایان

تابع جستجو(پ: پستگرس.پایگاه داده، واژه ها: رشته): صحیح:
    دستور := "SELECT title FROM books WHERE title ILIKE " + پستگرس.نقل قول(پ، الگوی شبیه(واژه ها)) + " ORDER BY title"
    ر := پستگرس.پرسمان(پ، دستور)
    دیرکن ر.بستن()
    سرچاپ "جستجوی"، پستگرس.نقل قول(پ، واژه ها)، "یافت:"، ر.تعداد ردیف()
    تا ر.بعدی():
        سرچاپ "  " + ر.متن(۰)
    پایان
    برگشت ر.تعداد ردیف()
پایان

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)

    _ := جستجو(پ، "کو")
    _ := جستجو(پ، "x' OR '1'='1")
    _ := جستجو(پ، "'; DROP TABLE books; --")
    _ := جستجو(پ، "100%")
    سرچاپ "کتاب‌ها هنوز سر جایشان‌اند:"، پستگرس.پرسمان عدد(پ، "SELECT count(*) FROM books")

    نوشته := "3 OR 1=1"
    شناسه := تبدیل.تجزیه عدد(نوشته)
    اگر تبدیل.قالب عدد(شناسه) نابرابر نوشته:
        سرچاپ "شناسه‌ی کتاب نیست:"، نوشته
    پایان
    سرچاپ پستگرس.نقل قول(پ، `C:\books\new`)
پایان
