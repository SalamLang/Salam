واردسازی دیتابیس
واردسازی دیتابیس.پستگرس
واردسازی رشته

ساختار کتاب:
    همگانی شناسه: صحیح۶۴ = ۰
    همگانی عنوان: رشته = ""
    همگانی نویسنده: رشته = ""
    همگانی سال: صحیح = ۰
    همگانی سنت: صحیح = ۰
    همگانی موجودی: صحیح = ۰
پایان

تابع پول(سنت: صحیح): رشته:
    خرده := سنت % ۱۰۰
    اگر خرده کوچکتر ۱۰:
        برگشت رشته.از عدد(سنت / ۱۰۰) + ".0" + رشته.از عدد(خرده)
    پایان
    برگشت رشته.از عدد(سنت / ۱۰۰) + "." + رشته.از عدد(خرده)
پایان

تابع خواندن کتاب ها(پ: پستگرس.پایگاه داده، شرط: رشته): وکتور<کتاب>:
    ناپایا خروجی := وکتور {} برگردان وکتور<کتاب>
    ر := پستگرس.پرسمان(پ، "SELECT id, title, author, year, (price * 100)::int AS cents, stock FROM books " + شرط)
    دیرکن ر.بستن()
    تا ر.بعدی():
        خروجی.بیفزا(کتاب { شناسه = ر.عدد صحیح۶۴(۰)، عنوان = ر.متن(۱)، نویسنده = ر.متن(۲)، سال = ر.عدد صحیح(۳)، سنت = ر.عدد صحیح(۴)، موجودی = ر.عدد صحیح(۵) })
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)

    کتاب ها := خواندن کتاب ها(پ، "ORDER BY year")
    سرچاپ کتاب ها.طول()، "کتاب"
    هر ک در کتاب ها:
        سرچاپ ک.شناسه، ک.عنوان، "از"، ک.نویسنده، ک.سال، پول(ک.سنت)، "موجودی"، ک.موجودی
    پایان

    ارزان ها := خواندن کتاب ها(پ، "WHERE price < 10 ORDER BY price")
    سرچاپ "زیر ۱۰:"، ارزان ها.طول()

    ر := پستگرس.پرسمان(پ، "SELECT title, price, stock, isbn FROM books WHERE id = 3")
    دیرکن ر.بستن()
    ر.بعدی()
    تکرار ر.تعداد ستون() در ستون:
        نوع داده := ر.نوع ستون(ستون)
        ناپایا نام := "متن"
        اگر نوع داده برابر دیتابیس.نوع صحیح: نام = "صحیح" پایان
        اگر نوع داده برابر دیتابیس.نوع اعشاری: نام = "اعشاری" پایان
        سرچاپ ر.نام ستون(ستون)، "="، ر.متن(ستون)، "از نوع"، نام
    پایان
پایان
