واردسازی دیتابیس.پستگرس
واردسازی رشته

تابع ثبت سفارش(پ: پستگرس.پایگاه داده، مشتری: رشته، کتاب: صحیح، تعداد: صحیح): منطقی:
    ت := پ.شروع تراکنش()
    اگر وارونه ت.معتبر():
        برگشت نادرست
    پایان
    ر := ت.پرسمان("UPDATE books SET stock = stock - " + رشته.از عدد(تعداد) + " WHERE id = " + رشته.از عدد(کتاب) + " AND stock >= " + رشته.از عدد(تعداد) + " RETURNING price * " + رشته.از عدد(تعداد))
    دیرکن ر.بستن()
    اگر وارونه ر.بعدی():
        ت.بازگردانی()
        سرچاپ مشتری، تعداد، "نسخه از کتاب " + رشته.از عدد(کتاب) + " می‌خواهد: موجودی کافی نیست، بازگردانده شد"
        برگشت نادرست
    پایان
    جمع := ر.متن(۰)
    اگر ت.اجرا("INSERT INTO orders (customer, book_id, qty, total) VALUES (" + پستگرس.نقل قول(پ، مشتری) + ", " + رشته.از عدد(کتاب) + ", " + رشته.از عدد(تعداد) + ", " + جمع + ")") نابرابر ۰:
        ت.بازگردانی()
        برگشت نادرست
    پایان
    اگر ت.ثبت تراکنش() نابرابر ۰:
        برگشت نادرست
    پایان
    سرچاپ مشتری، تعداد، "نسخه از کتاب"، کتاب، "خرید به مبلغ"، جمع
    برگشت درست
پایان

تابع ریشه:
    پ := پستگرس.بازکردن("host=127.0.0.1 user=postgres password=secret dbname=bookshop")
    دیرکن پستگرس.بستن(پ)

    _ := ثبت سفارش(پ، "سارا"، ۱، ۲)
    _ := ثبت سفارش(پ، "امید"، ۵، ۱)
    _ := ثبت سفارش(پ، "لیلا"، ۵، ۱)
    _ := ثبت سفارش(پ، "سارا"، ۴، ۳)

    سرچاپ "سفارش‌ها:"، پستگرس.پرسمان عدد(پ، "SELECT count(*) FROM orders")، "فروش:"، پستگرس.پرسمان متن(پ، "SELECT sum(total) FROM orders")
    سرچاپ "مانده‌ی بوف کور:"، پستگرس.پرسمان عدد(پ، "SELECT stock FROM books WHERE id = 1")، "مانده‌ی سمفونی مردگان:"، پستگرس.پرسمان عدد(پ، "SELECT stock FROM books WHERE id = 5")
پایان
