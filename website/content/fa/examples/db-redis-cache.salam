واردسازی دیتابیس.ردیس

ناپایا شمار ساخت := 0

تابع بساز(شناسه: رشته): رشته:
    شمار ساخت += 1
    برگشت "<h1>یادداشت " + شناسه + "</h1>"
پایان

تابع برگه(ک: ردیس.کلاینت، شناسه: رشته): رشته:
    کلید := "cache:note:" + شناسه
    اگر ردیس.وجود دارد(ک، کلید):
        برگشت ردیس.دریافت(ک، کلید)
    پایان
    اچ‌تی‌ام‌ال := بساز(شناسه)
    ردیس.تنظیم با انقضا(ک، کلید، اچ‌تی‌ام‌ال، 60)
    برگشت اچ‌تی‌ام‌ال
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    سرچاپ برگه(ک، "42")
    سرچاپ برگه(ک، "42")
    سرچاپ برگه(ک، "7")
    سرچاپ "ساخته شد"، شمار ساخت، "بار برای ۳ درخواست"
    سرچاپ "ثانیه‌های مانده:"، ردیس.زمان باقیمانده(ک، "cache:note:42")

    ردیس.حذف(ک، "cache:note:42")
    سرچاپ برگه(ک، "42")
    سرچاپ "ساخته شد"، شمار ساخت، "بار پس از ویرایش"
    ردیس.حذف(ک، "cache:note:42")
    ردیس.حذف(ک، "cache:note:7")
پایان
