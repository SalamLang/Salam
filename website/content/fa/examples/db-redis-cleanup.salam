واردسازی دیتابیس.ردیس
واردسازی مرتب سازی

تابع پیمایش(ک: ردیس.کلاینت، الگو: رشته): وکتور<رشته>:
    ناپایا یافته‌ها := وکتور {} برگردان وکتور<رشته>
    ناپایا نشانگر := "0"
    تا درست:
        ناپایا آرگ‌ها := وکتور {} برگردان وکتور<رشته>
        آرگ‌ها.بیفزا("SCAN")
        آرگ‌ها.بیفزا(نشانگر)
        آرگ‌ها.بیفزا("MATCH")
        آرگ‌ها.بیفزا(الگو)
        آرگ‌ها.بیفزا("COUNT")
        آرگ‌ها.بیفزا("100")
        پ := ردیس.دستور(ک، آرگ‌ها)
        نشانگر = ردیس.پاسخ رشته(ردیس.عنصر آرایه پاسخ(پ، 0))
        دسته := ردیس.عنصر آرایه پاسخ(پ، 1)
        تکرار ردیس.طول آرایه پاسخ(دسته) در ش:
            یافته‌ها.بیفزا(ردیس.پاسخ رشته(ردیس.عنصر آرایه پاسخ(دسته، ش)))
        پایان
        ردیس.آزادسازی پاسخ(پ)
        اگر نشانگر برابر "0":
            بشکن
        پایان
    پایان
    مرتب سازی.مرتب(یافته‌ها)
    برگشت یافته‌ها
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    کلیدها := ردیس.کلیدها(ک، "*")
    مرتب سازی.مرتب(کلیدها)
    هر کلید در کلیدها:
        سرچاپ کلید، ردیس.نوع(ک، کلید)
    پایان

    کهنه‌ها := پیمایش(ک، "visitors:*")
    هر کلید در کهنه‌ها:
        ردیس.حذف(ک، کلید)
    پایان
    سرچاپ کهنه‌ها.طول()، "مجموعه‌ی بازدید حذف شد، مانده:"، پیمایش(ک، "visitors:*").طول()

    سرچاپ "پاک‌سازی:"، ردیس.پاک‌سازی پایگاه داده(ک)، "کلیدهای مانده:"، ردیس.کلیدها(ک، "*").طول()
پایان
