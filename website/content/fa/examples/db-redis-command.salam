واردسازی دیتابیس.ردیس
واردسازی تبدیل

تابع بفرست(ک: ردیس.کلاینت، واژه‌ها: رشته[]): ردیس.پاسخ:
    ناپایا آرگ‌ها := وکتور {} برگردان وکتور<رشته>
    هر واژه در واژه‌ها:
        آرگ‌ها.بیفزا(واژه)
    پایان
    برگشت ردیس.دستور(ک، آرگ‌ها)
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    تکرار 3 در ش:
        شناسه := تبدیل.قالب عدد((ش + 1) برگردان صحیح۶۴)
        پ := بفرست(ک، ["ZADD"، "links:top"، ردیس.دریافت(ک، "clicks:" + شناسه)، شناسه])
        ردیس.آزادسازی پاسخ(پ)
    پایان

    برترین‌ها := بفرست(ک، ["ZREVRANGE"، "links:top"، "0"، "-1"، "WITHSCORES"])
    اگر ردیس.نوع پاسخ(برترین‌ها) برابر ردیس.پاسخ_آرایه:
        ناپایا ش := 0
        تا ش کوچکتر ردیس.طول آرایه پاسخ(برترین‌ها):
            شناسه := ردیس.پاسخ رشته(ردیس.عنصر آرایه پاسخ(برترین‌ها، ش))
            امتیاز := ردیس.پاسخ رشته(ردیس.عنصر آرایه پاسخ(برترین‌ها، ش + 1))
            سرچاپ امتیاز، "کلیک:"، ردیس.دریافت فیلد هش(ک، "link:" + شناسه، "عنوان")
            ش += 2
        پایان
    پایان
    ردیس.آزادسازی پاسخ(برترین‌ها)

    رتبه := بفرست(ک، ["ZREVRANK"، "links:top"، "1"])
    سرچاپ "رتبه‌ی پیوند ۱:"، ردیس.پاسخ صحیح(رتبه) + 1، "پاسخ عددی:"، ردیس.نوع پاسخ(رتبه) برابر ردیس.پاسخ_صحیح
    ردیس.آزادسازی پاسخ(رتبه)

    چند فیلد := بفرست(ک، ["HMGET"، "link:1"، "عنوان"، "مالک"، "رنگ"])
    تکرار ردیس.طول آرایه پاسخ(چند فیلد) در ش:
        عنصر := ردیس.عنصر آرایه پاسخ(چند فیلد، ش)
        سرچاپ "  فیلد"، ش، "[" + ردیس.پاسخ رشته(عنصر) + "]"، "تهی:"، ردیس.پاسخ خالی است(عنصر)
    پایان
    ردیس.آزادسازی پاسخ(چند فیلد)
پایان
