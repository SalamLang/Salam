واردسازی دیتابیس.ردیس

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    اگر وارونه ردیس.معتبر(ک):
        سرچاپ "به ردیس نمی‌رسیم:"، ردیس.خطا(ک)
        برگشت 1
    پایان
    دیرکن ردیس.بستن(ک)

    سرچاپ "پینگ پیش از ورود:"، ردیس.پینگ(ک)
    سرچاپ "گذرواژه‌ی نادرست:"، ردیس.احراز هویت(ک، "guess")
    سرچاپ "گذرواژه‌ی درست:"، ردیس.احراز هویت(ک، "s3cret")
    سرچاپ "پینگ پس از ورود:"، ردیس.پینگ(ک)

    سرچاپ "پایگاه ۱۵:"، ردیس.انتخاب پایگاه داده(ک، 15)
    سرچاپ "پایگاه ۹۹:"، ردیس.انتخاب پایگاه داده(ک، 99)
    سرچاپ "بازگشت به ۰:"، ردیس.انتخاب پایگاه داده(ک، 0)

    خاموش := ردیس.اتصال("127.0.0.1"، 6390)
    سرچاپ "درگاه ۶۳۹۰:"، ردیس.معتبر(خاموش)، ردیس.خطا(خاموش)
پایان
