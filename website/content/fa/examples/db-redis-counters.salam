واردسازی دیتابیس.ردیس
واردسازی تبدیل

تابع کلیک(ک: ردیس.کلاینت، شناسه: صحیح): صحیح۶۴:
    برگشت ردیس.افزایش(ک، "clicks:" + تبدیل.قالب عدد(شناسه برگردان صحیح۶۴))
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    کلیک(ک، 1)
    کلیک(ک، 1)
    کلیک(ک، 3)
    کلیک(ک، 3)
    سرچاپ "کلیک‌های پیوند ۱:"، کلیک(ک، 1)
    سرچاپ "کلیک‌های واردشده‌ی پیوند ۲:"، ردیس.افزایش با مقدار(ک، "clicks:2"، 40)
    سرچاپ "پیوند ۲ پس از برگشت دو کلیک:"، ردیس.افزایش با مقدار(ک، "clicks:2"، -2)
    سرچاپ "پیوند ۳ پس از حذف کلیک ربات:"، ردیس.کاهش(ک، "clicks:3")

    خام := ردیس.دریافت(ک، "clicks:2")
    سرچاپ "به شکل متن:"، خام، "نوع"، ردیس.نوع(ک، "clicks:2")
    مقدار := تبدیل.تجزیه عدد(خام)
    سرچاپ "به شکل عدد به اضافه‌ی یک:"، مقدار + 1

    سرچاپ "شناسه‌ی پیوند بعدی:"، تبدیل.تجزیه عدد(ردیس.دریافت(ک، "links:next")) + 1
پایان
