واردسازی دیتابیس.ردیس

تابع بفرست(ک: ردیس.کلاینت، واژه‌ها: رشته[]): رشته:
    ناپایا آرگ‌ها := وکتور {} برگردان وکتور<رشته>
    هر واژه در واژه‌ها:
        آرگ‌ها.بیفزا(واژه)
    پایان
    پ := ردیس.دستور(ک، آرگ‌ها)
    ناپایا خروجی := "درست"
    اگر وارونه ردیس.پاسخ معتبر(پ):
        خروجی = "پاسخی نیامد: " + ردیس.خطا(ک)
    وگرنه اگر ردیس.پاسخ خطا است(پ):
        خروجی = "خطای سرور: " + ردیس.پاسخ رشته(پ)
    پایان
    ردیس.آزادسازی پاسخ(پ)
    برگشت خروجی
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    سرچاپ "دریافت روی هش: [" + ردیس.دریافت(ک، "link:1") + "]"
    سرچاپ "افزایش روی متن:"، ردیس.افزایش(ک، "site:name")
    سرچاپ بفرست(ک، ["GET"، "link:1"])
    سرچاپ بفرست(ک، ["INCR"، "site:name"])
    سرچاپ بفرست(ک، ["HGET"، "link:1"])
    سرچاپ "اتصال هنوز سالم:"، ردیس.پینگ(ک)، "[" + ردیس.خطا(ک) + "]"

    مدیر := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(مدیر)
    ردیس.احراز هویت(مدیر، "s3cret")
    سرچاپ بفرست(مدیر، ["CLIENT"، "KILL"، "TYPE"، "normal"، "SKIPME"، "yes"])

    سرچاپ "پینگ پس از قطع:"، ردیس.پینگ(ک)
    سرچاپ "معتبر:"، ردیس.معتبر(ک)، "خطا:"، ردیس.خطا(ک)
    سرچاپ بفرست(ک، ["PING"])
پایان
