واردسازی دیتابیس.ردیس
واردسازی زمان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    ردیس.تنظیم با انقضا(ک، "preview:3"، "<b>سلام در گیت‌هاب</b>"، 600)
    سرچاپ "مهلت پیش‌نمایش:"، ردیس.زمان باقیمانده(ک، "preview:3")
    سرچاپ "مهلت پیوند:"، ردیس.زمان باقیمانده(ک، "link:3")
    سرچاپ "مهلت کلید ناموجود:"، ردیس.زمان باقیمانده(ک، "link:99")

    ردیس.تنظیم(ک، "link:3:promo"، "نیم‌بها")
    سرچاپ "انقضای تخفیف تنظیم شد:"، ردیس.انقضا(ک، "link:3:promo"، 1)
    سرچاپ "تخفیف اکنون:"، ردیس.دریافت(ک، "link:3:promo")
    زمان.خواب(1500)
    سرچاپ "تخفیف بعدا: [" + ردیس.دریافت(ک، "link:3:promo") + "]"، ردیس.وجود دارد(ک، "link:3:promo")
    سرچاپ "انقضای کلید ناموجود:"، ردیس.انقضا(ک، "link:3:promo"، 10)

    ردیس.تنظیم(ک، "preview:3"، "<b>پیش‌نمایش تازه</b>")
    سرچاپ "مهلت پس از تنظیم:"، ردیس.زمان باقیمانده(ک، "preview:3")
پایان
