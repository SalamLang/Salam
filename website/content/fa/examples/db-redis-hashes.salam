واردسازی دیتابیس.ردیس
واردسازی تبدیل

ساختار پیوند:
    همگانی شناسه: صحیح۶۴ = 0
    همگانی نشانی: رشته = ""
    همگانی عنوان: رشته = ""
    همگانی مالک: رشته = ""
پایان

تابع ذخیره(ک: ردیس.کلاینت، نشانی: رشته، عنوان: رشته، مالک: رشته): صحیح۶۴:
    شناسه := ردیس.افزایش(ک، "links:next")
    کلید := "link:" + تبدیل.قالب عدد(شناسه)
    ردیس.تنظیم فیلد هش(ک، کلید، "نشانی"، نشانی)
    ردیس.تنظیم فیلد هش(ک، کلید، "عنوان"، عنوان)
    ردیس.تنظیم فیلد هش(ک، کلید، "مالک"، مالک)
    برگشت شناسه
پایان

تابع بارگذاری(ک: ردیس.کلاینت، شناسه: صحیح۶۴): پیوند:
    نگاشت := ردیس.دریافت همه هش(ک، "link:" + تبدیل.قالب عدد(شناسه))
    اگر نگاشت.اندازه() برابر 0:
        برگشت پیوند {}
    پایان
    برگشت پیوند { شناسه = شناسه، نشانی = نگاشت.بگیر("نشانی")، عنوان = نگاشت.بگیر("عنوان")، مالک = نگاشت.بگیر("مالک") }
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    ذخیره(ک، "https://salamlang.ir"، "خانه‌ی سلام"، "سارا")
    ذخیره(ک، "https://salamlang.ir/learn/"، "دوره‌ی سلام"، "امید")
    ذخیره(ک، "https://github.com/SalamLang/Salam"، "سلام در گیت‌هاب"، "سارا")

    تکرار 3 در ش:
        پ := بارگذاری(ک، (ش + 1) برگردان صحیح۶۴)
        سرچاپ پ.شناسه، پ.عنوان، "<-"، پ.نشانی، "از"، پ.مالک
    پایان
    سرچاپ "پیوند ۹ پیدا شد:"، بارگذاری(ک، 9).شناسه نابرابر 0

    سرچاپ "فیلدهای link:2:"، ردیس.تعداد فیلدهای هش(ک، "link:2")
    سرچاپ "مالک link:2:"، ردیس.دریافت فیلد هش(ک، "link:2"، "مالک")
    ردیس.تنظیم فیلد هش(ک، "link:2"، "یادداشت"، "برای دانشجوهای تازه")
    سرچاپ "یادداشت دارد:"، ردیس.فیلد هش وجود دارد(ک، "link:2"، "یادداشت")
    سرچاپ "یادداشت حذف شد:"، ردیس.حذف فیلد هش(ک، "link:2"، "یادداشت")
    سرچاپ "یادداشت دارد:"، ردیس.فیلد هش وجود دارد(ک، "link:2"، "یادداشت")
پایان
