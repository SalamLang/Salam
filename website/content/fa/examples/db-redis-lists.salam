واردسازی دیتابیس.ردیس
واردسازی تبدیل

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    تکرار 3 در ش:
        ردیس.افزودن به ابتدای لیست(ک، "links:recent"، تبدیل.قالب عدد((ش + 1) برگردان صحیح۶۴))
    پایان
    سرچاپ "شمار تازه‌ها:"، ردیس.طول لیست(ک، "links:recent")

    هر شناسه در ردیس.بازه لیست(ک، "links:recent"، 0، -1):
        سرچاپ "  پیوند"، شناسه، ردیس.دریافت فیلد هش(ک، "link:" + شناسه، "عنوان")
    پایان

    سرچاپ "دو تای تازه‌تر:"، ردیس.بازه لیست(ک، "links:recent"، 0، 1).طول()
    سرچاپ "قدیمی‌ترین:"، ردیس.بازه لیست(ک، "links:recent"، -1، -1).بگیر(0)

    ردیس.افزودن به انتهای لیست(ک، "links:review"، "2")
    ردیس.افزودن به انتهای لیست(ک، "links:review"، "3")
    سرچاپ "اولی برای بازبینی:"، ردیس.برداشتن از ابتدای لیست(ک، "links:review")
    سرچاپ "آخری برای بازبینی:"، ردیس.برداشتن از انتهای لیست(ک، "links:review")
    سرچاپ "بازبینی خالی: [" + ردیس.برداشتن از ابتدای لیست(ک، "links:review") + "]"، ردیس.طول لیست(ک، "links:review")
پایان
