واردسازی دیتابیس.ردیس

تابع بردار(ک: ردیس.کلاینت، صف: رشته، ثانیه‌ها: رشته): رشته:
    ناپایا آرگ‌ها := وکتور {} برگردان وکتور<رشته>
    آرگ‌ها.بیفزا("BLPOP")
    آرگ‌ها.بیفزا(صف)
    آرگ‌ها.بیفزا(ثانیه‌ها)
    پ := ردیس.دستور(ک، آرگ‌ها)
    ناپایا کار := ""
    اگر ردیس.نوع پاسخ(پ) برابر ردیس.پاسخ_آرایه:
        کار = ردیس.پاسخ رشته(ردیس.عنصر آرایه پاسخ(پ، 1))
    پایان
    ردیس.آزادسازی پاسخ(پ)
    برگشت کار
پایان

تابع کارگر():
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")
    ناپایا کار := بردار(ک، "queue:email"، "1")
    تا کار.طول() بزرگتر 0:
        ردیس.افزودن به انتهای لیست(ک، "done:email"، "فرستاده شد " + کار)
        کار = بردار(ک، "queue:email"، "1")
    پایان
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    ن := نخ‌ساز(کارگر)
    ردیس.افزودن به انتهای لیست(ک، "queue:email"، "خوشامد:سارا")
    ردیس.افزودن به انتهای لیست(ک، "queue:email"، "خوشامد:امید")
    ردیس.افزودن به انتهای لیست(ک، "queue:email"، "خلاصه:همه")
    سرچاپ "۳ کار در صف گذاشته شد"
    نخ‌پیوند(ن)

    هر خط در ردیس.بازه لیست(ک، "done:email"، 0، -1):
        سرچاپ خط
    پایان
    سرچاپ "مانده در صف:"، ردیس.طول لیست(ک، "queue:email")
    ردیس.حذف(ک، "done:email")
پایان
