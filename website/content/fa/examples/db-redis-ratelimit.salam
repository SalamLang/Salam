واردسازی دیتابیس.ردیس

تابع مجاز(ک: ردیس.کلاینت، کاربر: رشته، سقف: صحیح۶۴، ثانیه‌ها: صحیح): منطقی:
    کلید := "rate:" + کاربر
    شمار := ردیس.افزایش(ک، کلید)
    اگر شمار برابر 1:
        ردیس.انقضا(ک، کلید، ثانیه‌ها)
    پایان
    برگشت شمار کوچکتربرابر سقف
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    تکرار 5 در ش:
        سرچاپ "درخواست"، ش + 1، "سارا مجاز:"، مجاز(ک، "سارا"، 3، 60)
    پایان
    سرچاپ "درخواست 1 امید مجاز:"، مجاز(ک، "امید"، 3، 60)
    سرچاپ "پنجره‌ی سارا تا"، ردیس.زمان باقیمانده(ک، "rate:سارا")، "ثانیه‌ی دیگر"
    ردیس.حذف(ک، "rate:سارا")
    ردیس.حذف(ک، "rate:امید")
پایان
