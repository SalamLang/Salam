واردسازی دیتابیس.ردیس
واردسازی مرتب سازی

تابع بازدید(ک: ردیس.کلاینت، پیوند: رشته، کاربر: رشته): منطقی:
    برگشت ردیس.افزودن به مجموعه(ک، "visitors:" + پیوند، کاربر) برابر 1
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    سرچاپ "نخستین بازدید سارا:"، بازدید(ک، "1"، "سارا")
    سرچاپ "نخستین بازدید امید:"، بازدید(ک، "1"، "امید")
    سرچاپ "سارا دوباره:"، بازدید(ک، "1"، "سارا")
    بازدید(ک، "1"، "رضا")
    بازدید(ک، "3"، "سارا")

    سرچاپ "بازدیدکنندگان یکتای پیوند ۱:"، ردیس.اندازه مجموعه(ک، "visitors:1")
    سرچاپ "رضا پیوند ۳ را دید:"، ردیس.عضو مجموعه است(ک، "visitors:3"، "رضا")

    سرچاپ "رضا حذف شد:"، ردیس.حذف از مجموعه(ک، "visitors:1"، "رضا")
    نام‌ها := ردیس.اعضای مجموعه(ک، "visitors:1")
    مرتب سازی.مرتب(نام‌ها)
    هر نام در نام‌ها:
        سرچاپ "  -"، نام
    پایان
پایان
