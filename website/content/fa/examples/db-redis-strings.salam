واردسازی دیتابیس.ردیس
واردسازی رشته

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    ردیس.تنظیم(ک، "site:name"، "پیوند کوتاه")
    ردیس.تنظیم(ک، "site:motto"، "")
    سرچاپ "نام:"، ردیس.دریافت(ک، "site:name")
    سرچاپ "شعار: [" + ردیس.دریافت(ک، "site:motto") + "]"، ردیس.وجود دارد(ک، "site:motto")
    سرچاپ "مالک: [" + ردیس.دریافت(ک، "site:owner") + "]"، ردیس.وجود دارد(ک، "site:owner")

    ناپایا آرگ‌ها := وکتور {} برگردان وکتور<رشته>
    آرگ‌ها.بیفزا("GET")
    آرگ‌ها.بیفزا("site:owner")
    پ := ردیس.دستور(ک، آرگ‌ها)
    سرچاپ "پاسخ GET site:owner تهی است:"، ردیس.پاسخ خالی است(پ)
    ردیس.آزادسازی پاسخ(پ)

    متن دردسرساز := "x\r\nFLUSHALL\r\n"
    ردیس.تنظیم(ک، "site:tricky"، متن دردسرساز)
    سرچاپ "بایت‌های ذخیره‌شده:"، ردیس.طول رشته(ک، "site:tricky")، "از"، متن دردسرساز.طول()
    سرچاپ "همان متن برگشت:"، رشته.یکسان است(ردیس.دریافت(ک، "site:tricky")، متن دردسرساز)
    سرچاپ "نام هنوز هست:"، ردیس.وجود دارد(ک، "site:name")
    ردیس.حذف(ک، "site:tricky")

    سرچاپ "طول پس از پیوست:"، ردیس.پیوست(ک، "site:name"، " با سلام")
    سرچاپ "نام:"، ردیس.دریافت(ک، "site:name")
پایان
