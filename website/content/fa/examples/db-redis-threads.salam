واردسازی دیتابیس.ردیس

پایا کارگرها := 4
پایا کلیک‌ها := 250

تابع کارگر():
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")
    تکرار کلیک‌ها:
        ردیس.افزایش(ک، "clicks:4")
        ردیس.افزودن به مجموعه(ک، "visitors:4"، "ربات")
    پایان
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")
    ردیس.حذف(ک، "clicks:4")

    ناپایا نخ‌ها := وکتور {} برگردان وکتور<صحیح۶۴>
    تکرار کارگرها:
        نخ‌ها.بیفزا(نخ‌ساز(کارگر))
    پایان
    هر ن در نخ‌ها:
        نخ‌پیوند(ن)
    پایان

    سرچاپ "کلیک‌های پیوند ۴:"، ردیس.دریافت(ک، "clicks:4")، "مورد انتظار"، کارگرها * کلیک‌ها
    سرچاپ "بازدیدکنندگان یکتا:"، ردیس.اندازه مجموعه(ک، "visitors:4")
پایان
