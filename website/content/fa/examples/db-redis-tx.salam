واردسازی دیتابیس.ردیس
واردسازی تبدیل

تابع بفرست(ک: ردیس.کلاینت، واژه‌ها: رشته[]): رشته:
    ناپایا آرگ‌ها := وکتور {} برگردان وکتور<رشته>
    هر واژه در واژه‌ها:
        آرگ‌ها.بیفزا(واژه)
    پایان
    پ := ردیس.دستور(ک، آرگ‌ها)
    ناپایا خروجی := ردیس.پاسخ رشته(پ)
    اگر ردیس.نوع پاسخ(پ) برابر ردیس.پاسخ_آرایه:
        خروجی = "آرایه‌ای با " + تبدیل.قالب عدد(ردیس.طول آرایه پاسخ(پ) برگردان صحیح۶۴) + " عنصر"
    وگرنه اگر ردیس.پاسخ خالی است(پ):
        خروجی = "تهی"
    وگرنه اگر ردیس.نوع پاسخ(پ) برابر ردیس.پاسخ_صحیح:
        خروجی = تبدیل.قالب عدد(ردیس.پاسخ صحیح(پ))
    پایان
    ردیس.آزادسازی پاسخ(پ)
    برگشت خروجی
پایان

تابع ریشه:
    ک := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(ک)
    ردیس.احراز هویت(ک، "s3cret")

    سرچاپ بفرست(ک، ["MULTI"])
    سرچاپ بفرست(ک، ["INCR"، "links:next"])
    سرچاپ بفرست(ک، ["HSET"، "link:4"، "نشانی"، "https://salamlang.ir/std/"، "عنوان"، "کتابخانه‌های سلام"، "مالک"، "امید"])
    سرچاپ بفرست(ک، ["LPUSH"، "links:recent"، "4"])
    سرچاپ بفرست(ک، ["EXEC"])
    سرچاپ "پیوند ۴:"، ردیس.دریافت فیلد هش(ک، "link:4"، "عنوان")، "شناسه‌ی بعدی:"، ردیس.دریافت(ک، "links:next")

    دیگری := ردیس.اتصال("127.0.0.1"، 6379)
    دیرکن ردیس.بستن(دیگری)
    ردیس.احراز هویت(دیگری، "s3cret")

    سرچاپ بفرست(ک، ["WATCH"، "link:4"])
    عنوان := ردیس.دریافت فیلد هش(ک، "link:4"، "عنوان")
    ردیس.تنظیم فیلد هش(دیگری، "link:4"، "عنوان"، "کتابخانه‌ی استاندارد سلام")
    سرچاپ بفرست(ک، ["MULTI"])
    سرچاپ بفرست(ک، ["HSET"، "link:4"، "عنوان"، عنوان + " (بازبینی‌شده)"])
    سرچاپ "EXEC پس از تغییر:"، بفرست(ک، ["EXEC"])
    سرچاپ "عنوان ماند:"، ردیس.دریافت فیلد هش(ک، "link:4"، "عنوان")

    سرچاپ بفرست(ک، ["MULTI"])
    سرچاپ بفرست(ک، ["INCR"، "clicks:4"])
    سرچاپ بفرست(ک، ["DISCARD"])
    سرچاپ "clicks:4 هست:"، ردیس.وجود دارد(ک، "clicks:4")
پایان
