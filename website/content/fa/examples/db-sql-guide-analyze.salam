واردسازی دیتابیس.اس کیو ال

تابع شرح(پرسمان: رشته، طرح: اس کیو ال.فهرست جداول):
    ناپایا ت := اس کیو ال.تحلیل کن(پرسمان، طرح)
    سرچاپ پرسمان
    سرچاپ "  دستور:"، اس کیو ال.نام دستور(ت.kind)، "روی"، ت.table
    ناپایا ای := ۰
    تا ای < ت.params.طول():
        پ := ت.params.بگیر(ای)
        سرچاپ "  جانگهدار"، پ.ordinal، "ستون"، پ.column، "از گونه"، اس کیو ال.گونه سلام(پ.kind، پ.not_null)
        ای = ای + ۱
    پایان
    ناپایا جی := ۰
    تا جی < ت.results.طول():
        س := ت.results.بگیر(جی)
        سرچاپ "  ستون"، س.name، "برمی گردد با گونه"، اس کیو ال.گونه سلام(س.kind، وارونه س.nullable)
        جی = جی + ۱
    پایان
    اس کیو ال.آزادسازی تحلیل(ت)
پایان

تابع ریشه:
    ناپایا طرح := اس کیو ال.فهرست تازه(اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت))
    دیرکن اس کیو ال.آزادسازی فهرست(طرح)
    ناپایا ساخته := اس کیو ال.اعمال(طرح، """
        CREATE TABLE users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT NOT NULL,
            name TEXT,
            age INTEGER
        );
    """)
    اس کیو ال.آزادسازی گزارش(ساخته)

    شرح("SELECT id, name FROM users WHERE email = ? AND age > ?"، طرح)
    شرح("INSERT INTO users (email, name) VALUES (?, ?) RETURNING id"، طرح)
    برگشت ۰
پایان
