واردسازی دیتابیس.اس کیو ال

تابع شرح(پرسمان: رشته، طرح: اس کیو ال.فهرست جداول):
    ناپایا ت := اس کیو ال.تحلیل کن(پرسمان، طرح)
    سرچاپ پرسمان
    سرچاپ "  دستور:"، اس کیو ال.نام دستور(ت.نوع)، "روی"، ت.جدول
    ناپایا ای := ۰
    تا ای < ت.پارامترها.طول():
        پ := ت.پارامترها.بگیر(ای)
        سرچاپ "  جانگهدار"، پ.شماره، "ستون"، پ.ستون، "از گونه"، اس کیو ال.گونه سلام(پ.نوع، پ.تهی‌ناپذیر)
        ای = ای + ۱
    پایان
    ناپایا جی := ۰
    تا جی < ت.نتیجه‌ها.طول():
        س := ت.نتیجه‌ها.بگیر(جی)
        سرچاپ "  ستون"، س.نام، "برمی گردد با گونه"، اس کیو ال.گونه سلام(س.نوع، وارونه س.تهی‌پذیر)
        جی = جی + ۱
    پایان
    اس کیو ال.آزادسازی تحلیل(ت)
پایان

تابع ریشه:
    ناپایا طرح := اس کیو ال.فهرست تازه(اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت))
    دیرکن اس کیو ال.آزادسازی فهرست(طرح)
    ناپایا ساخته := اس کیو ال.اعمال(طرح، """
        CREATE TABLE users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT NOT NULL,
            name TEXT,
            age INTEGER
        );
    """)
    اس کیو ال.آزادسازی گزارش(ساخته)

    شرح("SELECT id, name FROM users WHERE email = ? AND age > ?"، طرح)
    شرح("INSERT INTO users (email, name) VALUES (?, ?) RETURNING id"، طرح)
    برگشت ۰
پایان
