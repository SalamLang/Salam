واردسازی دیتابیس.اس کیو ال

تابع نمایش(پرسمان: رشته، م: اس کیو ال.مقدارها، گ: اس کیو ال.گویش):
    ناپایا ن := اس کیو ال.گزارش {}
    خروجی := اس کیو ال.پرکردن(پرسمان، م، گ، ن)
    اگر ن.بدون خطا:
        سرچاپ خروجی
    وگرنه:
        سرچاپ اس کیو ال.متن گزارش(ن)
    پایان
    اس کیو ال.آزادسازی گزارش(ن)
پایان

تابع ریشه:
    لایت := اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت)
    پست := اس کیو ال.گویش شماره(اس کیو ال.پستگرس)

    ناپایا ردیف := اس کیو ال.مقدارهای تازه()
    اس کیو ال.افزودن متن(ردیف، "O'Brien")
    اس کیو ال.افزودن عدد(ردیف، ۴۱ برگردان صحیح۶۴)
    اس کیو ال.افزودن منطقی(ردیف، درست)
    اس کیو ال.افزودن خالی(ردیف)
    نمایش("INSERT INTO users (name, age, paid, note) VALUES (?, ?, ?, ?)"، ردیف، لایت)
    نمایش("INSERT INTO users (name, age, paid, note) VALUES ($1, $2, $3, $4)"، ردیف، پست)
    اس کیو ال.آزادسازی مقدارها(ردیف)

    ناپایا حمله := اس کیو ال.مقدارهای تازه()
    اس کیو ال.افزودن متن(حمله، "x' OR '1'='1")
    نمایش("SELECT id FROM users WHERE name = ?"، حمله، لایت)
    اس کیو ال.آزادسازی مقدارها(حمله)

    ناپایا یکی := اس کیو ال.مقدارهای تازه()
    اس کیو ال.افزودن عدد(یکی، ۷ برگردان صحیح۶۴)
    نمایش("SELECT id FROM notes WHERE body = '?' AND id = ?"، یکی، لایت)
    نمایش("SELECT id FROM users WHERE id = ? AND org = ?"، یکی، لایت)
    اس کیو ال.آزادسازی مقدارها(یکی)
    برگشت ۰
پایان
