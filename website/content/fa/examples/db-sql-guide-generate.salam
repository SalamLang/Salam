واردسازی دیتابیس.اس کیو ال

تابع ریشه:
    ناپایا طرح := اس کیو ال.فهرست تازه(اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت))
    دیرکن اس کیو ال.آزادسازی فهرست(طرح)
    ناپایا ساخته := اس کیو ال.اعمال(طرح، """
        CREATE TABLE users (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            email TEXT NOT NULL,
            name TEXT
        );
    """)
    اس کیو ال.آزادسازی گزارش(ساخته)

    پرسمان ها := """
-- name: GetUser :one
SELECT id, email, name FROM users WHERE email = ?;

-- name: CreateUser :exec
INSERT INTO users (email, name) VALUES (?, ?);
"""
    ناپایا ن := اس کیو ال.گزارش {}
    ناپایا خوانده := اس کیو ال.خواندن پرسمان ها(پرسمان ها، ن)
    سرچاپ "پرسمان ها:"، خوانده.طول()
    کد := اس کیو ال.تولید کد("store"، خوانده، طرح، ن)
    اگر ن.بدون خطا:
        سرچاپ کد
    وگرنه:
        سرچاپ اس کیو ال.متن گزارش(ن)
    پایان
    اس کیو ال.آزادسازی پرسمان ها(خوانده)
    اس کیو ال.آزادسازی گزارش(ن)
    برگشت ۰
پایان
