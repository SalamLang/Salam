واردسازی دیتابیس.اس کیو ال

تابع گزارش(عنوان: رشته، پرسمان: رشته، گ: اس کیو ال.گویش):
    ناپایا ن := اس کیو ال.بازبینی(پرسمان، گ)
    اگر ن.بدون خطا:
        سرچاپ عنوان، "درست"
    وگرنه:
        سرچاپ عنوان، اس کیو ال.متن گزارش(ن)
    پایان
    اس کیو ال.آزادسازی گزارش(ن)
پایان

تابع ریشه:
    لایت := اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت)
    مای := اس کیو ال.گویش شماره(اس کیو ال.مای اس کیو ال)
    پست := اس کیو ال.گویش شماره(اس کیو ال.پستگرس)

    گزارش("پرسمان ساده: "، "SELECT id, name FROM users WHERE id = ?"، لایت)
    گزارش("نیمه کاره:   "، "SELECT id FROM users WHERE"، لایت)
    گزارش("نشانگر غلط:  "، "SELECT id FROM users WHERE id = ?"، پست)
    گزارش("ویژه پستگرس:"، "SELECT id FROM users WHERE name ILIKE 'a%'"، مای)
    گزارش("ویژه مای:    "، "CREATE TABLE t (id INT AUTO_INCREMENT)"، لایت)
    گزارش("ویرگول فارسی:"، "SELECT id، name FROM users"، لایت)

    سرچاپ "شمار جانگهدار:"، اس کیو ال.شمار پارامتر("UPDATE users SET name = ?, age = ? WHERE id = ?"، لایت)
    برگشت ۰
پایان
