
گام 1: طرحی که از پیش دارید
  2 جدول خوانده شد، 5 ستون روی کتابها

گام 2: پرسمان هایی که از پیش دارید
  نادرست SELECT id, titles FROM کتابها WHERE author_id = ?
          SQL311 no column named "titles" in this statement
          did you mean "title"?
  نادرست SELECT ک.title, ن.nationality FROM کتابها ک JOIN نویسندگان ن ON ن.id = ک.author_id
          SQL311 "ن" has no column "nationality"
  نادرست INSERT INTO کتابها (title) VALUES (?)
          SQL315 "author_id" is NOT NULL with no default and this INSERT leaves it out
          add it to the column list and to every row
  نادرست SELECT id FROM کتابها WHERE year = 'recent'
          SQL330 "year" is int and this compares it with text
          a number goes here without quotes
  نادرست DELETE FROM کتابها
          SQL320 this DELETE has no WHERE clause and removes every row
          add a WHERE clause, or use TRUNCATE when that is what you mean

گام 3: همان پنج تا، درست شده
  درست   SELECT id, title FROM کتابها WHERE author_id = ?
  درست   SELECT ک.title, ن.country FROM کتابها ک JOIN نویسندگان ن ON ن.id = ک.author_id
  درست   INSERT INTO کتابها (author_id, title) VALUES (?, ?)
  درست   SELECT id FROM کتابها WHERE year = 2024
  درست   DELETE FROM کتابها WHERE id = ?

گام 4: یک پرسمان چه می گیرد و چه می دهد
  یک select روی کتابها
  می گیرد year از گونه option.Option<i64>
  می دهد title از گونه str
  می دهد price از گونه option.Option<f64>

گام 5: مقدارها با امنیت سر جایشان می نشینند
  INSERT INTO کتابها (title, year) VALUES ('O''Brien', 1367)

گام 6: یا بگذارید خودش کد را بنویسد
package store

import db
import db.sql
import mem
import option

struct BooksByAuthorRow:
    pub id: i64 = 0 as i64
    pub title: str = ""
    pub year: option.Option<i64> = option.None() as option.Option<i64>
end

func fill_query(c: dyn db.Connection, raw: str, a: sql.Args): str:
    mut rep := sql.Report {}
    out := sql.Fill(raw, a, sql.DialectNamed(c.Kind()), rep)
    sql.FreeReport(rep)
    ret out
end

pub func BooksByAuthor(c: dyn db.Connection, author_id: i64): Vector<BooksByAuthorRow>:
    mut a := sql.NewArgs()
    sql.AddInt(a, author_id)
    q := fill_query(c, "SELECT id, title, year FROM \"کتابها\" WHERE author_id = ?", a)
    sql.FreeArgs(a)
    mut rows := Vector {} as Vector<BooksByAuthorRow>
    r := c.Query(q)
    if r.Ok():
        until r.Next():
            mut out := BooksByAuthorRow {}
            out.id = r.Int64(0)
            out.title = r.Text(1)
            if r.IsNull(2):
                out.year = option.None() as option.Option<i64>
            else:
                out.year = option.Some(r.Int64(2))
            end
            rows.push(out)
        end
        r.Close()
    end
    mem.Free(q as void*)
    ret rows
end

