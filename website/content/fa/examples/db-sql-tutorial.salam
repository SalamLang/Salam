واردسازی رشته
واردسازی دیتابیس.اس کیو ال

ناپایا طرح کلی := اس کیو ال.فهرست جداول {}

تابع عدد(ن: صحیح): رشته:
    برگشت رشته.از عدد(ن برگردان صحیح۶۴)
پایان

تابع گام(ش: صحیح، عنوان: رشته):
    سرچاپ ""
    سرچاپ "گام " + عدد(ش) + ": " + عنوان
پایان

تابع بیازما(پ: رشته):
    ناپایا ن := اس کیو ال.بررسی(پ، طرح کلی)
    اگر ن.بدون خطا و ن.هشدارها == ۰:
        سرچاپ "  درست   " + پ
    وگرنه:
        سرچاپ "  نادرست " + پ
        ناپایا ای := ۰
        تا ای < ن.موارد.طول():
            ع := ن.موارد.بگیر(ای)
            سرچاپ "          " + ع.کد + " " + ع.پیام
            اگر وارونه رشته.خالی است(ع.راهنما):
                سرچاپ "          " + ع.راهنما
            پایان
            ای = ای + ۱
        پایان
    پایان
    اس کیو ال.آزادسازی گزارش(ن)
پایان

تابع ریشه:
    گام(۱، "طرحی که از پیش دارید")
    طرح کلی = اس کیو ال.فهرست تازه(اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت))
    دیرکن اس کیو ال.آزادسازی فهرست(طرح کلی)
    ناپایا ساخته := اس کیو ال.اعمال(طرح کلی، """
        CREATE TABLE نویسندگان (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            country TEXT
        );
        CREATE TABLE کتابها (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            author_id INTEGER NOT NULL,
            title TEXT NOT NULL,
            year INTEGER,
            price REAL
        );
    """)
    شمارش := "  " + عدد(اس کیو ال.شمار جدول(طرح کلی)) + " جدول خوانده شد، "
    سرچاپ شمارش + عدد(اس کیو ال.شمار ستون(طرح کلی، "کتابها")) + " ستون روی کتابها"
    اگر وارونه ساخته.بدون خطا:
        سرچاپ اس کیو ال.متن گزارش(ساخته)
    پایان
    اس کیو ال.آزادسازی گزارش(ساخته)

    گام(۲، "پرسمان هایی که از پیش دارید")
    بیازما("SELECT id, titles FROM کتابها WHERE author_id = ?")
    بیازما("SELECT ک.title, ن.nationality FROM کتابها ک JOIN نویسندگان ن ON ن.id = ک.author_id")
    بیازما("INSERT INTO کتابها (title) VALUES (?)")
    بیازما("SELECT id FROM کتابها WHERE year = 'recent'")
    بیازما("DELETE FROM کتابها")

    گام(۳، "همان پنج تا، درست شده")
    بیازما("SELECT id, title FROM کتابها WHERE author_id = ?")
    بیازما("SELECT ک.title, ن.country FROM کتابها ک JOIN نویسندگان ن ON ن.id = ک.author_id")
    بیازما("INSERT INTO کتابها (author_id, title) VALUES (?, ?)")
    بیازما("SELECT id FROM کتابها WHERE year = 2024")
    بیازما("DELETE FROM کتابها WHERE id = ?")

    گام(۴، "یک پرسمان چه می گیرد و چه می دهد")
    ناپایا ت := اس کیو ال.تحلیل کن("SELECT title, price FROM کتابها WHERE year > ?"، طرح کلی)
    سرچاپ "  یک " + اس کیو ال.نام دستور(ت.نوع) + " روی " + ت.جدول
    پ := ت.پارامترها.بگیر(۰)
    سرچاپ "  می گیرد " + پ.ستون + " از گونه " + اس کیو ال.گونه سلام(پ.نوع، پ.تهی‌ناپذیر)
    ناپایا ای := ۰
    تا ای < ت.نتیجه‌ها.طول():
        س := ت.نتیجه‌ها.بگیر(ای)
        سرچاپ "  می دهد " + س.نام + " از گونه " + اس کیو ال.گونه سلام(س.نوع، وارونه س.تهی‌پذیر)
        ای = ای + ۱
    پایان
    اس کیو ال.آزادسازی تحلیل(ت)

    گام(۵، "مقدارها با امنیت سر جایشان می نشینند")
    ناپایا مقدارها := اس کیو ال.مقدارهای تازه()
    اس کیو ال.افزودن متن(مقدارها، "O'Brien")
    اس کیو ال.افزودن عدد(مقدارها، ۱۳۶۷ برگردان صحیح۶۴)
    ناپایا خطا := اس کیو ال.گزارش {}
    پرشده := اس کیو ال.پرکردن("INSERT INTO کتابها (title, year) VALUES (?, ?)"، مقدارها، اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت)، خطا)
    سرچاپ "  " + پرشده
    اس کیو ال.آزادسازی گزارش(خطا)
    اس کیو ال.آزادسازی مقدارها(مقدارها)

    گام(۶، "یا بگذارید خودش کد را بنویسد")
    ناپایا ن۲ := اس کیو ال.گزارش {}
    ناپایا پرسمان ها := اس کیو ال.خواندن پرسمان ها("""
-- name: BooksByAuthor :many
SELECT id, title, year FROM "کتابها" WHERE author_id = ?;
"""، ن۲)
    کد := اس کیو ال.تولید کد("store"، پرسمان ها، طرح کلی، ن۲)
    سرچاپ کد
    اس کیو ال.آزادسازی پرسمان ها(پرسمان ها)
    اس کیو ال.آزادسازی گزارش(ن۲)
    برگشت ۰
پایان
