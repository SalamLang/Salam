واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع خانه(ردیف‌ها: اس کیو لایت.ردیف ها، ستون: صحیح): رشته:
    ترابرد ردیف‌ها.نوع ستون(ستون):
        دیتابیس.نوع خالی: برگشت "NULL" پایان
        دیتابیس.نوع متن: برگشت "'" + ردیف‌ها.متن(ستون) + "'" پایان
    پایان
    برگشت ردیف‌ها.متن(ستون)
پایان

تابع نمایش(پایگاه: اس کیو لایت.پایگاه داده، پرسش: رشته):
    ردیف‌ها := اس کیو لایت.پرسمان(پایگاه، پرسش)
    دیرکن اس کیو لایت.پایان(ردیف‌ها)
    شمار := ردیف‌ها.تعداد ستون()
    ناپایا سرستون := ""
    تکرار شمار در ستون:
        اگر ستون بزرگتر ۰: سرستون = سرستون + " | " پایان
        سرستون = سرستون + ردیف‌ها.نام ستون(ستون)
    پایان
    سرچاپ سرستون
    تا ردیف‌ها.بعدی():
        ناپایا سطر := ""
        تکرار شمار در ستون:
            اگر ستون بزرگتر ۰: سطر = سطر + " | " پایان
            سطر = سطر + خانه(ردیف‌ها، ستون)
        پایان
        سرچاپ سطر
    پایان
پایان

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن(":memory:")
    دیرکن اس کیو لایت.بستن(پایگاه)
    اس کیو لایت.اجرا(پایگاه، "CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT, price REAL, tag TEXT)")
    اس کیو لایت.اجرا(پایگاه، "INSERT INTO items (name, price, tag) VALUES ('خودکار', 1.5, 'اداری'), ('چراغ', 24, NULL), ('لیوان', NULL, 'آشپزخانه')")

    نمایش(پایگاه، "SELECT * FROM items")
    سرچاپ ""
    نمایش(پایگاه، "SELECT tag, COUNT(*) AS items, SUM(price) AS total FROM items GROUP BY tag ORDER BY tag")
پایان
