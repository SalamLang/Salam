واردسازی دیتابیس.اس کیو لایت
واردسازی سیستم عامل

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)

    اس کیو لایت.اجرا(پایگاه، """
    DROP TABLE IF EXISTS book_search;
    CREATE VIRTUAL TABLE book_search USING fts5(title, author, note);
    INSERT INTO book_search (rowid, title, author, note)
        SELECT id, title, author, COALESCE(note, '') FROM books;
    """)

    دستور := اس کیو لایت.آماده سازی(پایگاه، "SELECT rowid, highlight(book_search, 0, '[', ']') FROM book_search WHERE book_search MATCH ? ORDER BY rank")
    دیرکن اس کیو لایت.پایان(دستور)
    هر پرسش در ["دانشور"، "بوف*"، "امضا*"، "author:هدایت OR شازده"]:
        اس کیو لایت.بازنشانی(دستور)
        اس کیو لایت.اتصال متن(دستور، ۱، پرسش)
        ناپایا سطر := پرسش + ":"
        تا اس کیو لایت.بعدی(دستور):
            سطر = سطر + " " + اس کیو لایت.متن(دستور، ۰) + "=" + اس کیو لایت.متن(دستور، ۱)
        پایان
        سرچاپ سطر
    پایان

    سیستم عامل.حذف("backup.db")
    اگر اس کیو لایت.اجرا(پایگاه، "VACUUM INTO 'backup.db'") نابرابر ۰:
        سرچاپ "پشتیبان گرفته نشد:"، اس کیو لایت.خطا(پایگاه)
        برگشت ۱
    پایان
    پشتیبان := اس کیو لایت.بازکردن("backup.db")
    دیرکن اس کیو لایت.بستن(پشتیبان)
    سرچاپ "پشتیبان"، اس کیو لایت.پرسمان عدد(پشتیبان، "SELECT COUNT(*) FROM books")، "کتاب و"، اس کیو لایت.پرسمان عدد(پشتیبان، "SELECT COUNT(*) FROM loans")، "امانت دارد"
پایان
