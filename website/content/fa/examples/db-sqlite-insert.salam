واردسازی دیتابیس.اس کیو لایت

ساختار کتاب:
    همگانی عنوان: رشته = ""
    همگانی نویسنده: رشته = ""
    همگانی سال: صحیح = ۰
    همگانی نسخه‌ها: صحیح = ۱
    همگانی امتیاز: اعشار۶۴ = ۰.۰
پایان

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)

    ناپایا کتاب‌ها := وکتور {} برگردان وکتور<کتاب>
    دیرکن کتاب‌ها.آزادکن()
    کتاب‌ها.بیفزا(کتاب { عنوان = "بوف کور"، نویسنده = "صادق هدایت"، سال = ۱۳۱۵، نسخه‌ها = ۲، امتیاز = ۴.۵ })
    کتاب‌ها.بیفزا(کتاب { عنوان = "سووشون"، نویسنده = "سیمین دانشور"، سال = ۱۳۴۸، امتیاز = ۴.۱ })
    کتاب‌ها.بیفزا(کتاب { عنوان = "جزیره سرگردانی"، نویسنده = "سیمین دانشور"، سال = ۱۳۷۲، امتیاز = ۴.۳ })
    کتاب‌ها.بیفزا(کتاب { عنوان = "کلیدر"، نویسنده = "محمود دولت‌آبادی"، سال = ۱۳۵۷، نسخه‌ها = ۳، امتیاز = ۴.۶ })
    کتاب‌ها.بیفزا(کتاب { عنوان = "شازده کوچولو"، نویسنده = "آنتوان دو سنت‌اگزوپری"، سال = ۱۳۲۲، امتیاز = ۳.۹ })

    دستور := اس کیو لایت.آماده سازی(پایگاه، "INSERT INTO books (title, author, year, copies, rating) VALUES (?, ?, ?, ?, ?)")
    دیرکن اس کیو لایت.پایان(دستور)
    هر ک در کتاب‌ها:
        اس کیو لایت.بازنشانی(دستور)
        اس کیو لایت.اتصال متن(دستور، ۱، ک.عنوان)
        اس کیو لایت.اتصال متن(دستور، ۲، ک.نویسنده)
        اس کیو لایت.اتصال عدد(دستور، ۳، ک.سال برگردان صحیح۶۴)
        اس کیو لایت.اتصال عدد(دستور، ۴، ک.نسخه‌ها برگردان صحیح۶۴)
        اس کیو لایت.اتصال اعشار(دستور، ۵، ک.امتیاز)
        اس کیو لایت.بعدی(دستور)
        سرچاپ "کتاب"، اس کیو لایت.شناسه آخرین درج(پایگاه)، ک.عنوان
    پایان

    اس کیو لایت.اجرا(پایگاه، "INSERT INTO members (name, email) VALUES ('سارا', 'sara@example.com'), ('رضا', NULL), ('مینا', 'mina@example.com')")
    سرچاپ "عضو افزوده شد:"، اس کیو لایت.تعداد تغییرات(پایگاه)
    سرچاپ "کتاب‌ها:"، اس کیو لایت.پرسمان عدد(پایگاه، "SELECT COUNT(*) FROM books")، "نسخه‌ها:"، اس کیو لایت.پرسمان عدد(پایگاه، "SELECT SUM(copies) FROM books")
پایان
