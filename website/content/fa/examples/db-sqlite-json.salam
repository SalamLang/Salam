واردسازی دیتابیس.اس کیو لایت

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن(":memory:")
    دیرکن اس کیو لایت.بستن(پایگاه)
    اس کیو لایت.اجرا(پایگاه، "CREATE TABLE events (id INTEGER PRIMARY KEY, kind TEXT, body TEXT CHECK (json_valid(body)))")

    دستور := اس کیو لایت.آماده سازی(پایگاه، "INSERT INTO events (kind, body) VALUES (?, ?)")
    دیرکن اس کیو لایت.پایان(دستور)
    گونه‌ها := ["ثبت نام"، "سفارش"، "سفارش"، "خراب"]
    بدنه‌ها := ["{\"user\":\"سارا\",\"plan\":\"free\"}"، "{\"user\":\"سارا\",\"items\":[\"خودکار\",\"لیوان\"],\"total\":12.5}"، "{\"user\":\"رضا\",\"items\":[\"چراغ\"],\"total\":24}"، "{not json"]
    تکرار ۴ در ش:
        اس کیو لایت.بازنشانی(دستور)
        اس کیو لایت.اتصال متن(دستور، ۱، گونه‌ها[ش])
        اس کیو لایت.اتصال متن(دستور، ۲، بدنه‌ها[ش])
        اس کیو لایت.بعدی(دستور)
        اگر اس کیو لایت.بازنشانی(دستور) نابرابر ۰:
            سرچاپ "رد شد"، گونه‌ها[ش] + ":"، اس کیو لایت.خطا(پایگاه)
        پایان
    پایان

    ردیف‌ها := اس کیو لایت.پرسمان(پایگاه، "SELECT body ->> '$.user', json_array_length(body, '$.items'), body ->> '$.total' FROM events WHERE kind = 'سفارش' ORDER BY id")
    تا اس کیو لایت.بعدی(ردیف‌ها):
        سرچاپ اس کیو لایت.متن(ردیف‌ها، ۰)، "| قلم"، اس کیو لایت.عدد صحیح(ردیف‌ها، ۱)، "| جمع"، اس کیو لایت.عدد اعشار(ردیف‌ها، ۲)
    پایان
    اس کیو لایت.پایان(ردیف‌ها)

    سرچاپ اس کیو لایت.پرسمان متن(پایگاه، "SELECT json_group_object(u, n) FROM (SELECT body ->> '$.user' AS u, COUNT(*) AS n FROM events GROUP BY u ORDER BY u)")
پایان
