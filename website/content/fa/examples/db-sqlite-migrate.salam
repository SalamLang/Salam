واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع نمایش نسخه‌ها(اتصال: پویا دیتابیس.اتصال):
    ردیف‌ها := اتصال.پرسمان("SELECT title, copies, shelf FROM books ORDER BY id LIMIT 3")
    تا ردیف‌ها.بعدی():
        سرچاپ ردیف‌ها.متن(۰)، ردیف‌ها.عدد صحیح(۱)، ردیف‌ها.متن(۲)
    پایان
    ردیف‌ها.بستن()
پایان

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)
    اتصال := اس کیو لایت.اتصال(پایگاه)
    سرچاپ "موتور:"، اتصال.نوع()

    ناپایا مهاجرت‌ها := دیتابیس.مهاجرت گر جدید()
    دیرکن دیتابیس.آزادکردن مهاجرت گر(مهاجرت‌ها)
    دیتابیس.افزودن مهاجرت(مهاجرت‌ها، ۱، "قفسه‌ها"، "ALTER TABLE books ADD COLUMN shelf TEXT NOT NULL DEFAULT 'الف'"، "ALTER TABLE books DROP COLUMN shelf")
    دیتابیس.افزودن مهاجرت(مهاجرت‌ها، ۲، "قفسه‌ی رمان بلند"، "UPDATE books SET shelf = 'ب' WHERE id IN (1, 4, 5)"، "UPDATE books SET shelf = 'الف'")

    سرچاپ "در انتظار:"، دیتابیس.تعداد در انتظار(مهاجرت‌ها، اتصال)
    سرچاپ "اجرا شد:"، دیتابیس.مهاجرت به بالا(مهاجرت‌ها، اتصال)
    سرچاپ "نسخه‌ی طرح:"، دیتابیس.نسخه طرح‌واره(مهاجرت‌ها، اتصال)، "در انتظار:"، دیتابیس.تعداد در انتظار(مهاجرت‌ها، اتصال)

    ناپایا اصلاح := وکتور {} برگردان وکتور<رشته>
    دیرکن اصلاح.آزادکن()
    اصلاح.بیفزا("UPDATE books SET copies = copies + 1 WHERE id = 5")
    اصلاح.بیفزا("UPDATE books SET copies = -1 WHERE id = 4")
    سرچاپ "یا هر دو یا هیچ:"، دیتابیس.در تراکنش(اتصال، اصلاح)
    سرچاپ "نسخه‌های شازده کوچولو:"، دیتابیس.پرسمان عدد(اتصال، "SELECT copies FROM books WHERE id = 5")
    نمایش نسخه‌ها(اتصال)
پایان
