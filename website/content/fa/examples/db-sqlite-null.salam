واردسازی دیتابیس.اس کیو لایت

تابع اتصال اختیاری(دستور: اس کیو لایت.ردیف ها، جا: صحیح، مقدار: رشته):
    اگر مقدار برابر "":
        اس کیو لایت.اتصال خالی(دستور، جا)
    وگرنه:
        اس کیو لایت.اتصال متن(دستور، جا، مقدار)
    پایان
پایان

تابع ثبت یادداشت(پایگاه: اس کیو لایت.پایگاه داده، شناسه: صحیح۶۴، یادداشت: رشته):
    دستور := اس کیو لایت.آماده سازی(پایگاه، "UPDATE books SET note = ? WHERE id = ?")
    دیرکن اس کیو لایت.پایان(دستور)
    اتصال اختیاری(دستور، ۱، یادداشت)
    اس کیو لایت.اتصال عدد(دستور، ۲، شناسه)
    اس کیو لایت.بعدی(دستور)
پایان

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)

    ثبت یادداشت(پایگاه، ۱، "با امضای نویسنده")
    ثبت یادداشت(پایگاه، ۴، "")

    ردیف‌ها := اس کیو لایت.پرسمان(پایگاه، "SELECT title, note FROM books WHERE id IN (1, 4)")
    تا اس کیو لایت.بعدی(ردیف‌ها):
        اگر اس کیو لایت.خالی است(ردیف‌ها، ۱):
            سرچاپ اس کیو لایت.متن(ردیف‌ها، ۰) + ": یادداشت ندارد، متن می‌دهد \"" + اس کیو لایت.متن(ردیف‌ها، ۱) + "\""
        وگرنه:
            سرچاپ اس کیو لایت.متن(ردیف‌ها، ۰) + ":"، اس کیو لایت.متن(ردیف‌ها، ۱)
        پایان
    پایان
    اس کیو لایت.پایان(ردیف‌ها)

    رایانامه‌ها := اس کیو لایت.پرسمان(پایگاه، "SELECT name, COALESCE(email, '(بی‌رایانامه)') FROM members ORDER BY id")
    تا اس کیو لایت.بعدی(رایانامه‌ها):
        سرچاپ اس کیو لایت.متن(رایانامه‌ها، ۰)، اس کیو لایت.متن(رایانامه‌ها، ۱)
    پایان
    اس کیو لایت.پایان(رایانامه‌ها)
    سرچاپ "بدون رایانامه:"، اس کیو لایت.پرسمان عدد(پایگاه، "SELECT COUNT(*) FROM members WHERE email IS NULL")
پایان
