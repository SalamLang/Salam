واردسازی دیتابیس.اس کیو لایت
واردسازی رشته

تابع ریشه:
    اگر وارونه اس کیو لایت.در دسترس():
        سرچاپ "SQLite نصب نیست"
        برگشت ۱
    پایان
    سرچاپ "SQLite 3:"، رشته.شروع با(اس کیو لایت.نسخه()، "3.")

    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)
    اگر وارونه اس کیو لایت.معتبر(پایگاه) یا اس کیو لایت.اجرا(پایگاه، "SELECT 1") نابرابر ۰:
        سرچاپ "باز نشد:"، اس کیو لایت.خطا(پایگاه)
        برگشت ۱
    پایان

    سرچاپ "ژورنال:"، اس کیو لایت.پرسمان متن(پایگاه، "PRAGMA journal_mode = WAL")
    اس کیو لایت.اجرا(پایگاه، "PRAGMA foreign_keys = ON")
    سرچاپ "کلید خارجی:"، اس کیو لایت.پرسمان عدد(پایگاه، "PRAGMA foreign_keys")
    سرچاپ "زمان انتظار قفل:"، اس کیو لایت.پرسمان عدد(پایگاه، "PRAGMA busy_timeout = 5000")

    خراب := اس کیو لایت.بازکردن("/no/such/folder/library.db")
    سرچاپ "مسیر نادرست، دستگیره:"، اس کیو لایت.معتبر(خراب)، "| نخستین دستور:"، اس کیو لایت.اجرا(خراب، "SELECT 1")، اس کیو لایت.خطا(خراب)
    اس کیو لایت.بستن(خراب)
پایان
