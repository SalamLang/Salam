واردسازی دیتابیس.اس کیو لایت

تابع جستجو(پایگاه: اس کیو لایت.پایگاه داده، نوشته: رشته):
    دستور := اس کیو لایت.آماده سازی(پایگاه، "SELECT title FROM books WHERE title LIKE '%' || ? || '%' ORDER BY title")
    دیرکن اس کیو لایت.پایان(دستور)
    اس کیو لایت.اتصال متن(دستور، ۱، نوشته)
    ناپایا یافته‌ها := ۰
    تا اس کیو لایت.بعدی(دستور):
        یافته‌ها = یافته‌ها + ۱
    پایان
    سرچاپ "جستجوی"، پایگاه.نقل قول(نوشته) + ":"، یافته‌ها، "نتیجه"
پایان

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)

    جستجو(پایگاه، "و")
    جستجو(پایگاه، "x' OR '1'='1")

    چسبانده := "SELECT COUNT(*) FROM books WHERE title = 'x' OR '1'='1'"
    سرچاپ "چسبانده در SQL:"، اس کیو لایت.پرسمان عدد(پایگاه، چسبانده)، "کتاب"

    دستور := اس کیو لایت.آماده سازی(پایگاه، "INSERT INTO members (name, email) VALUES (?, ?)")
    اس کیو لایت.اتصال متن(دستور، ۱، "نیلوفر 'نیلی' احمدی")
    اس کیو لایت.اتصال متن(دستور، ۲، "niloofar@example.com")
    اس کیو لایت.بعدی(دستور)
    اس کیو لایت.پایان(دستور)
    سرچاپ "عضو تازه"، اس کیو لایت.شناسه آخرین درج(پایگاه)

    نام := "نیلوفر 'نیلی' احمدی"
    اگر اس کیو لایت.اجرا(پایگاه، "UPDATE members SET email = NULL WHERE name = '" + نام + "'") نابرابر ۰:
        سرچاپ "نام چسبانده:"، اس کیو لایت.خطا(پایگاه)
    پایان
    سرچاپ "با نقل قول:"، اس کیو لایت.پرسمان عدد(پایگاه، "SELECT COUNT(*) FROM members WHERE name = " + پایگاه.نقل قول(نام))
پایان
