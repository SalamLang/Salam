واردسازی دیتابیس.اس کیو لایت

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)

    بیرون := اس کیو لایت.پرسمان(پایگاه، """
        SELECT m.name, b.title, l.due
        FROM loans l
        JOIN books b ON b.id = l.book
        JOIN members m ON m.id = l.member
        WHERE l.returned IS NULL
        ORDER BY l.due, m.name""")
    سرچاپ "در امانت:"
    تا اس کیو لایت.بعدی(بیرون):
        سرچاپ " "، اس کیو لایت.متن(بیرون، ۰)، "کتاب"، اس کیو لایت.متن(بیرون، ۱)، "را تا"، اس کیو لایت.متن(بیرون، ۲)، "دارد"
    پایان
    اس کیو لایت.پایان(بیرون)

    دیرکرد := اس کیو لایت.آماده سازی(پایگاه، "SELECT COUNT(*) FROM loans WHERE returned IS NULL AND due < ?")
    اس کیو لایت.اتصال متن(دیرکرد، ۱، "2026-11-01")
    اس کیو لایت.بعدی(دیرکرد)
    سرچاپ "دیرکرد در 2026-11-01:"، اس کیو لایت.عدد صحیح(دیرکرد، ۰)
    اس کیو لایت.پایان(دیرکرد)

    نویسندگان := اس کیو لایت.پرسمان(پایگاه، """
        SELECT author, COUNT(*), SUM(copies), ROUND(AVG(rating), 2)
        FROM books GROUP BY author ORDER BY AVG(rating) DESC""")
    تا اس کیو لایت.بعدی(نویسندگان):
        سرچاپ اس کیو لایت.متن(نویسندگان، ۰)، "| کتاب"، اس کیو لایت.عدد صحیح(نویسندگان، ۱)، "| نسخه"، اس کیو لایت.عدد صحیح(نویسندگان، ۲)، "| امتیاز"، اس کیو لایت.عدد اعشار(نویسندگان، ۳)
    پایان
    اس کیو لایت.پایان(نویسندگان)

    سرچاپ اس کیو لایت.پرسمان متن(پایگاه، "SELECT json_group_array(json_object('id', id, 'title', title)) FROM (SELECT id, title FROM books WHERE copies > 0 ORDER BY id LIMIT 2)")
پایان
