واردسازی دیتابیس.اس کیو لایت

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)

    طرح := """
    CREATE TABLE IF NOT EXISTS books (
        id INTEGER PRIMARY KEY,
        title TEXT NOT NULL,
        author TEXT NOT NULL,
        year INTEGER,
        copies INTEGER NOT NULL DEFAULT 1 CHECK (copies >= 0),
        rating REAL,
        note TEXT
    );
    CREATE TABLE IF NOT EXISTS members (
        id INTEGER PRIMARY KEY,
        name TEXT NOT NULL UNIQUE,
        email TEXT
    );
    CREATE TABLE IF NOT EXISTS loans (
        id INTEGER PRIMARY KEY,
        book INTEGER NOT NULL REFERENCES books (id),
        member INTEGER NOT NULL REFERENCES members (id),
        due TEXT NOT NULL,
        returned TEXT
    );
    CREATE INDEX IF NOT EXISTS books_author ON books (author);
    PRAGMA user_version = 1;
    """
    اگر اس کیو لایت.اجرا(پایگاه، طرح) نابرابر ۰:
        سرچاپ "ساخت جدول‌ها شکست خورد:"، اس کیو لایت.خطا(پایگاه)
        برگشت ۱
    پایان

    ردیف‌ها := اس کیو لایت.پرسمان(پایگاه، "SELECT type, name FROM sqlite_master ORDER BY type, name")
    تا اس کیو لایت.بعدی(ردیف‌ها):
        سرچاپ اس کیو لایت.متن(ردیف‌ها، ۰)، اس کیو لایت.متن(ردیف‌ها، ۱)
    پایان
    اس کیو لایت.پایان(ردیف‌ها)
    سرچاپ "نسخه‌ی طرح:"، اس کیو لایت.پرسمان عدد(پایگاه، "PRAGMA user_version")
پایان
