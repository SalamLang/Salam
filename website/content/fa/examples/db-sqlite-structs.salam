واردسازی دیتابیس.اس کیو لایت

ساختار کتاب:
    همگانی شناسه: صحیح۶۴ = ۰
    همگانی عنوان: رشته = ""
    همگانی نویسنده: رشته = ""
    همگانی سال: صحیح = ۰
    همگانی نسخه‌ها: صحیح = ۰
    همگانی امتیاز: اعشار۶۴ = ۰.۰
پایان

تابع خواندن کتاب(ردیف‌ها: اس کیو لایت.ردیف ها): کتاب:
    برگشت کتاب {
        شناسه = اس کیو لایت.عدد صحیح۶۴(ردیف‌ها، ۰)،
        عنوان = اس کیو لایت.متن(ردیف‌ها، ۱)،
        نویسنده = اس کیو لایت.متن(ردیف‌ها، ۲)،
        سال = اس کیو لایت.عدد صحیح(ردیف‌ها، ۳)،
        نسخه‌ها = اس کیو لایت.عدد صحیح(ردیف‌ها، ۴)،
        امتیاز = اس کیو لایت.عدد اعشار(ردیف‌ها، ۵)
    }
پایان

تابع کتاب‌های نویسنده(پایگاه: اس کیو لایت.پایگاه داده، نام: رشته): وکتور<کتاب>:
    ناپایا خروجی := وکتور {} برگردان وکتور<کتاب>
    دستور := اس کیو لایت.آماده سازی(پایگاه، "SELECT id, title, author, year, copies, rating FROM books WHERE author = ? ORDER BY year")
    دیرکن اس کیو لایت.پایان(دستور)
    اس کیو لایت.اتصال متن(دستور، ۱، نام)
    تا اس کیو لایت.بعدی(دستور):
        خروجی.بیفزا(خواندن کتاب(دستور))
    پایان
    برگشت خروجی
پایان

تابع کتاب با شناسه(پایگاه: اس کیو لایت.پایگاه داده، شناسه: صحیح۶۴، پیدا شد &: منطقی): کتاب:
    دستور := اس کیو لایت.آماده سازی(پایگاه، "SELECT id, title, author, year, copies, rating FROM books WHERE id = ?")
    دیرکن اس کیو لایت.پایان(دستور)
    اس کیو لایت.اتصال عدد(دستور، ۱، شناسه)
    پیدا شد = اس کیو لایت.بعدی(دستور)
    اگر وارونه پیدا شد:
        برگشت کتاب {}
    پایان
    برگشت خواندن کتاب(دستور)
پایان

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)

    دانشور := کتاب‌های نویسنده(پایگاه، "سیمین دانشور")
    دیرکن دانشور.آزادکن()
    هر ک در دانشور:
        سرچاپ ک.شناسه، ک.عنوان، ک.سال، ک.امتیاز
    پایان

    ناپایا پیدا شد := نادرست
    ک := کتاب با شناسه(پایگاه، ۴، پیدا شد)
    سرچاپ پیدا شد، ک.عنوان، "از"، ک.نویسنده + "،"، ک.نسخه‌ها، "نسخه"
    کتاب با شناسه(پایگاه، ۹۹، پیدا شد)
    سرچاپ "کتاب ۹۹ پیدا شد:"، پیدا شد
پایان
