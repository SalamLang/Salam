واردسازی دیتابیس.اس کیو لایت

تابع گام(پایگاه: اس کیو لایت.پایگاه داده، پرسش: رشته، الف: صحیح۶۴، ب: صحیح۶۴، سررسید: رشته): منطقی:
    دستور := اس کیو لایت.آماده سازی(پایگاه، پرسش)
    اس کیو لایت.اتصال عدد(دستور، ۱، الف)
    اگر ب بزرگتر ۰:
        اس کیو لایت.اتصال عدد(دستور، ۲، ب)
        اس کیو لایت.اتصال متن(دستور، ۳، سررسید)
    پایان
    اس کیو لایت.بعدی(دستور)
    برگشت اس کیو لایت.پایان(دستور) برابر ۰ و اس کیو لایت.تعداد تغییرات(پایگاه) برابر ۱
پایان

تابع امانت(پایگاه: اس کیو لایت.پایگاه داده، کتاب: صحیح۶۴، عضو: صحیح۶۴، امروز: رشته): منطقی:
    اگر اس کیو لایت.شروع تراکنش(پایگاه) نابرابر ۰:
        برگشت نادرست
    پایان
    اگر وارونه گام(پایگاه، "UPDATE books SET copies = copies - 1 WHERE id = ? AND copies > 0"، کتاب، ۰، ""):
        اس کیو لایت.بازگردانی(پایگاه)
        برگشت نادرست
    پایان
    اگر وارونه گام(پایگاه، "INSERT INTO loans (book, member, due) VALUES (?, ?, date(?, '+14 days'))"، کتاب، عضو، امروز):
        اس کیو لایت.بازگردانی(پایگاه)
        برگشت نادرست
    پایان
    برگشت اس کیو لایت.ثبت تراکنش(پایگاه) برابر ۰
پایان

تابع ریشه:
    پایگاه := اس کیو لایت.بازکردن("library.db")
    دیرکن اس کیو لایت.بستن(پایگاه)
    اس کیو لایت.اجرا(پایگاه، "PRAGMA foreign_keys = ON")
    امروز := "2026-10-17"

    سرچاپ "سارا سووشون را می‌برد:"، امانت(پایگاه، ۲، ۱، امروز)
    سرچاپ "رضا سووشون را می‌برد:"، امانت(پایگاه، ۲، ۲، امروز)
    سرچاپ "مینا بوف کور را می‌برد:"، امانت(پایگاه، ۱، ۳، امروز)
    سرچاپ "مینا کلیدر را می‌برد:"، امانت(پایگاه، ۴، ۳، "2026-10-20")
    سرچاپ "عضو ۴۲ بوف کور را می‌برد:"، امانت(پایگاه، ۱، ۴۲، امروز)

    سرچاپ "نسخه‌های بوف کور:"، اس کیو لایت.پرسمان عدد(پایگاه، "SELECT copies FROM books WHERE id = 1")
    سرچاپ "امانت‌ها:"، اس کیو لایت.پرسمان عدد(پایگاه، "SELECT COUNT(*) FROM loans")
    سرچاپ "سررسید کتاب سارا:"، اس کیو لایت.پرسمان متن(پایگاه، "SELECT due FROM loans WHERE member = 1")
پایان
