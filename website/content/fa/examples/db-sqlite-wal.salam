واردسازی دیتابیس.اس کیو لایت
واردسازی سیستم عامل

تابع ریشه:
    مسیر := "shop.db"
    نویسنده := اس کیو لایت.بازکردن(مسیر)
    اس کیو لایت.پرسمان متن(نویسنده، "PRAGMA journal_mode = WAL")
    اس کیو لایت.اجرا(نویسنده، "CREATE TABLE stock (item TEXT PRIMARY KEY, qty INTEGER)")
    اس کیو لایت.اجرا(نویسنده، "INSERT INTO stock VALUES ('خودکار', 10)")

    خواننده := اس کیو لایت.بازکردن(مسیر)
    اس کیو لایت.اجرا(خواننده، "PRAGMA busy_timeout = 2000")

    اس کیو لایت.شروع تراکنش(نویسنده)
    اس کیو لایت.اجرا(نویسنده، "UPDATE stock SET qty = 7 WHERE item = 'خودکار'")
    سرچاپ "خواننده در میان نوشتن:"، اس کیو لایت.پرسمان عدد(خواننده، "SELECT qty FROM stock")
    سرچاپ "نویسنده تغییر خودش را می‌بیند:"، اس کیو لایت.پرسمان عدد(نویسنده، "SELECT qty FROM stock")

    دومی := اس کیو لایت.بازکردن(مسیر)
    اس کیو لایت.شروع تراکنش(دومی)
    سرچاپ "نویسنده‌ی دوم:"، اس کیو لایت.اجرا(دومی، "UPDATE stock SET qty = 0")، اس کیو لایت.خطا(دومی)
    اس کیو لایت.بازگردانی(دومی)
    اس کیو لایت.بستن(دومی)

    اس کیو لایت.ثبت تراکنش(نویسنده)
    سرچاپ "خواننده پس از ثبت:"، اس کیو لایت.پرسمان عدد(خواننده، "SELECT qty FROM stock")

    اس کیو لایت.بستن(خواننده)
    اس کیو لایت.بستن(نویسنده)
    سیستم عامل.حذف(مسیر)
پایان
