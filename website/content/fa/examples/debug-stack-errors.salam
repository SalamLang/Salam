واردسازی اشکال زدایی

تابع شکست(پیام: رشته): منطقی:
    سرچاپ "خطا در"، اشکال زدایی.پشته() + ":"، پیام
    برگشت نادرست
پایان

تابع خواندن قیمت(متن: رشته): منطقی:
    اشکال زدایی.ورود("خواندن قیمت")
    دیرکن اشکال زدایی.خروج()
    اگر متن.طول() == ۰:
        برگشت شکست("قیمت خالی است")
    پایان
    برگشت درست
پایان

تابع بارگذاری کالا(نام: رشته، قیمت: رشته): منطقی:
    اشکال زدایی.ورود("بارگذاری کالا " + نام)
    دیرکن اشکال زدایی.خروج()
    برگشت خواندن قیمت(قیمت)
پایان

تابع بارگذاری فهرست(): صحیح:
    اشکال زدایی.ورود("بارگذاری فهرست")
    دیرکن اشکال زدایی.خروج()
    ناپایا شمار := ۰
    اگر بارگذاری کالا("چای"، "4.50"): شمار += ۱ پایان
    اگر بارگذاری کالا("کیک"، ""): شمار += ۱ پایان
    اگر بارگذاری کالا("شیر"، "1.20"): شمار += ۱ پایان
    برگشت شمار
پایان

تابع ریشه:
    سرچاپ بارگذاری فهرست()، "کالا بارگذاری شد، عمق اکنون"، اشکال زدایی.عمق()
پایان
