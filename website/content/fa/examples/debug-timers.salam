واردسازی اشکال زدایی

تابع کار سنگین(ن: صحیح): صحیح:
    ناپایا جمع := ۰
    تکرار ن در ش:
        جمع = (جمع + ش * ش) % ۱۰۰۰۰۰۳
    پایان
    برگشت جمع
پایان

تابع ریشه:
    اشکال زدایی.شروع تایمر("همه")
    اشکال زدایی.شروع تایمر("گام")
    الف := کار سنگین(۲۰۰۰۰۰)
    اولی := اشکال زدایی.پایان تایمر("گام")
    اشکال زدایی.شروع تایمر("گام")
    ب := کار سنگین(۲۰۰۰۰۰)
    دومی := اشکال زدایی.پایان تایمر("گام")
    کل := اشکال زدایی.پایان تایمر("همه")
    بعدتر := اشکال زدایی.پایان تایمر("همه")
    سرچاپ الف == ب
    سرچاپ "هر دو گام در زمان کل جا می‌شوند:"، اولی + دومی <= کل
    سرچاپ "زمان‌سنج پس از پایان تایمر هم جلو می‌رود:"، بعدتر >= کل
    سرچاپ "زمان‌سنج ناشناخته:"، اشکال زدایی.پایان تایمر("هرگز شروع نشده")
پایان
