واردسازی اشکال زدایی
واردسازی رشته

تابع فیبو(ن: صحیح): صحیح:
    اشکال زدایی.ورود("فیبو " + رشته.از عدد(ن برگردان صحیح۶۴))
    دیرکن اشکال زدایی.خروج()
    اگر ن < ۲:
        اشکال زدایی.ردیابی("حالت پایه")
        برگشت ن
    پایان
    برگشت فیبو(ن - ۱) + فیبو(ن - ۲)
پایان

تابع ریشه:
    اشکال زدایی.ردیابی("چاپ نمی‌شود، ردیابی خاموش است")
    اشکال زدایی.فعال‌سازی ردیابی(درست)
    حاصل := فیبو(۳)
    اشکال زدایی.فعال‌سازی ردیابی(نادرست)
    اشکال زدایی.ردیابی("این هم چاپ نمی‌شود")
    نادرست‌سرچاپ "فیبو(۳) ="، حاصل
پایان
