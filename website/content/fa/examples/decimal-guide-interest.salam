واردسازی اعشاری

تابع ریشه:
    ناپایا مانده := اعشاری.از صحیح(۱۰۰۰۰)
    نرخ := اعشاری.از مقیاس(۱۵، ۳)
    یک := اعشاری.از صحیح(۱)
    تکرار ۱ تا ۵ در سال:
        سود := اعشاری.گردکردن(اعشاری.ضرب(مانده، نرخ)، ۲)
        مانده = اعشاری.جمع(مانده، سود)
        سرچاپ "سال"، سال، "سود"، اعشاری.به رشته ثابت(سود، ۲)، "مانده"، اعشاری.قالب گروهی(مانده، ۲، ","، ".")
    پایان

    ضریب := اعشاری.توان(اعشاری.جمع(یک، نرخ)، ۵)
    دقیق := اعشاری.ضرب(اعشاری.از صحیح(۱۰۰۰۰)، ضریب)
    سرچاپ "بدون گرد کردن سالانه"، اعشاری.به رشته(دقیق)
    سرچاپ "گردشده"، اعشاری.به رشته ثابت(اعشاری.گردکردن(دقیق، ۲)، ۲)

    ماهانه := اعشاری.تقسیم صحیح(مانده، ۱۲، ۲، اعشاری.شیوه گردکردن.به سمت صفر)
    سرچاپ "یک دوازدهم، گرد به پایین"، اعشاری.به رشته ثابت(ماهانه، ۲)
پایان
