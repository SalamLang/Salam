واردسازی اعشاری

ساختار ردیف:
    همگانی نام: رشته = ""
    همگانی قیمت: رشته = ""
    همگانی تعداد: صحیح = ۰
پایان

تابع ریشه:
    ناپایا ردیف‌ها := وکتور {} برگردان وکتور<ردیف>
    دیرکن ردیف‌ها.آزادکن()
    ردیف‌ها.بیفزا(ردیف { نام = "دفتر"، قیمت = "4.75"، تعداد = ۳ })
    ردیف‌ها.بیفزا(ردیف { نام = "خودکار"، قیمت = "1.20"، تعداد = ۱۰ })
    ردیف‌ها.بیفزا(ردیف { نام = "کوله‌پشتی"، قیمت = "39.90"، تعداد = ۱ })

    ناپایا جمع جزء := اعشاری.صفر()
    هر ر در ردیف‌ها:
        ناپایا موفق := نادرست
        واحد := اعشاری.تجزیه(ر.قیمت، موفق)
        مبلغ := اعشاری.ضرب صحیح(واحد، ر.تعداد برگردان صحیح۶۴)
        سرچاپ ر.نام، ر.تعداد، "x"، اعشاری.به رشته ثابت(واحد، ۲)، "="، اعشاری.به رشته ثابت(مبلغ، ۲)
        جمع جزء = اعشاری.جمع(جمع جزء، مبلغ)
    پایان

    تخفیف := اعشاری.درصد(جمع جزء، اعشاری.از صحیح(۵)، ۲)
    مشمول مالیات := اعشاری.تفریق(جمع جزء، تخفیف)
    مالیات := اعشاری.درصد(مشمول مالیات، اعشاری.از مقیاس(۹۵، ۱)، ۲)
    کل := اعشاری.جمع(مشمول مالیات، مالیات)
    سرچاپ "جمع جزء"، اعشاری.به رشته ثابت(جمع جزء، ۲)
    سرچاپ "تخفیف ۵٪"، اعشاری.به رشته ثابت(تخفیف، ۲)
    سرچاپ "مالیات ۹.۵٪"، اعشاری.به رشته ثابت(مالیات، ۲)
    سرچاپ "جمع کل"، اعشاری.قالب گروهی(کل، ۲، ","، ".")
پایان
