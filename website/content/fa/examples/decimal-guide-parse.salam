واردسازی اعشاری

تابع ریشه:
    ورودی‌ها := ["1250.50"، "  -3.75 "، "1_000_000"، "۱۲۳.۴۵"، "۱۲۳٫۴۵"، "2.5e3"، "12,50"، "abc"، ""]
    هر متن در ورودی‌ها:
        ناپایا موفق := نادرست
        عدد := اعشاری.تجزیه(متن، موفق)
        اگر موفق:
            سرچاپ "[" + متن + "]"، "->"، اعشاری.به رشته(عدد)، "مقیاس"، اعشاری.مقیاس(عدد)
        وگرنه:
            سرچاپ "[" + متن + "]"، "-> عدد نیست"
        پایان
    پایان
    سرچاپ اعشاری.به رشته(اعشاری.تجزیه با پیش فرض("اشتباه"))
پایان
