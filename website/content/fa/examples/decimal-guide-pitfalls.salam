واردسازی اعشاری

تابع ریشه:
    ناپایا موفق := نادرست
    قیمت := اعشاری.تجزیه("2.345"، موفق)
    سرچاپ "به رشته ثابت نیم به زوج گرد می‌کند:"، اعشاری.به رشته ثابت(قیمت، ۲)
    سرچاپ "اول گردکردن نیم بالا:"، اعشاری.به رشته ثابت(اعشاری.گردکردن نیم بالا(قیمت، ۲)، ۲)
    نرخ := اعشاری.تجزیه("1.075"، موفق)
    ناپایا رشدکرده := اعشاری.ضرب(قیمت، نرخ)
    سرچاپ "ضرب مقیاس‌ها را جمع می‌کند:"، اعشاری.به رشته(رشدکرده)، "مقیاس"، اعشاری.مقیاس(رشدکرده)
    تکرار ۳:
        رشدکرده = اعشاری.ضرب(رشدکرده، نرخ)
    پایان
    سرچاپ "سه بار دیگر:"، اعشاری.به رشته(رشدکرده)، "مقیاس"، اعشاری.مقیاس(رشدکرده)
    سرچاپ "گردشده به دو رقم:"، اعشاری.به رشته(اعشاری.گردکردن(رشدکرده، ۲))
    کارکنان := اعشاری.صفر()
    سرچاپ "سهم میان صفر نفر:"، اعشاری.به رشته(اعشاری.تقسیم گردشده(قیمت، کارکنان، ۲))
    اگر اعشاری.صفر است(کارکنان):
        سرچاپ "پیش از تقسیم، مقسوم‌علیه را بررسی کنید"
    پایان
پایان
