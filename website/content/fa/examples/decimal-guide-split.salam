واردسازی اعشاری

تابع نمایش(برچسب: رشته، سهم‌ها: وکتور<اعشاری.اعشاری>):
    ناپایا خط := برچسب
    هر سهم در سهم‌ها:
        خط = خط + " " + اعشاری.به رشته ثابت(سهم، ۲)
    پایان
    جمع := اعشاری.مجموع(سهم‌ها)
    سرچاپ خط، "| جمع"، اعشاری.به رشته ثابت(جمع، ۲)
پایان

تابع ریشه:
    صورت حساب := اعشاری.از مقیاس(۱۰۰۰۰، ۲)
    ناپایا ساده := اعشاری.تقسیم صحیح(صورت حساب، ۳، ۲، اعشاری.شیوه گردکردن.نیم به زوج)
    سرچاپ "۱۰۰.۰۰ تقسیم بر ۳ گردشده:"، اعشاری.به رشته ثابت(ساده، ۲)، "ضرب در ۳ ="، اعشاری.به رشته ثابت(اعشاری.ضرب صحیح(ساده، ۳)، ۲)
    ساده.آزادسازی()

    ناپایا سه سهم := اعشاری.تقسیم مساوی(صورت حساب، ۳)
    نمایش("تقسیم به ۳:"، سه سهم)
    اعشاری.آزادسازی همه(سه سهم)

    ناپایا نسبت‌ها := وکتور {} برگردان وکتور<صحیح۶۴>
    دیرکن نسبت‌ها.آزادکن()
    نسبت‌ها.بیفزا(۵۰)
    نسبت‌ها.بیفزا(۳۰)
    نسبت‌ها.بیفزا(۲۰)
    سود := اعشاری.از مقیاس(۱۲۳۴۵۷، ۲)
    ناپایا بخش‌ها := اعشاری.تخصیص نسبی(سود، نسبت‌ها)
    نمایش("۵۰/۳۰/۲۰ از ۱۲۳۴.۵۷:"، بخش‌ها)
    اعشاری.آزادسازی همه(بخش‌ها)
پایان
