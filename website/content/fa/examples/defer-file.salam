واردسازی سیستم عامل

روال ذخیره گزارش(مسیر: رشته، جمع: صحیح): منطقی:
    پ := سیستم عامل.بازکردن(مسیر، "w")
    اگر پ == پوچ:
        برگشت نادرست
    پایان
    دیرکن پ.ببند()
    پ.نوشتن("جمع: " + جمع + "\n")
    پ.نوشتن("وضعیت: پرداخت شده\n")
    برگشت درست
پایان

روال ریشه:
    مسیر := سیستم عامل.پوشه موقت() + "/salam-report-fa.txt"
    اگر وارونه ذخیره گزارش(مسیر، ۲۴۵):
        نادرست‌سرچاپ "نوشتن ممکن نشد"، مسیر
        برگشت ۱
    پایان
    دیرکن سیستم عامل.حذف(مسیر)
    چاپ سیستم عامل.خواندن پرونده(مسیر)
پایان
