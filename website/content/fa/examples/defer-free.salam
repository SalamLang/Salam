تابع میانگین خوانش(خام: صحیح[]): صحیح:
    ناپایا معتبر := وکتور {} برگردان وکتور<صحیح>
    دیرکن معتبر.آزادکن()
    هر خ در خام:
        اگر خ >= ۰:
            معتبر.بیفزا(خ)
        پایان
    پایان
    اگر معتبر.طول() == ۰:
        برگشت ۰
    پایان
    ناپایا مجموع := ۰
    هر م در معتبر:
        مجموع += م
    پایان
    برگشت مجموع / معتبر.طول()
پایان

تابع ریشه:
    سرچاپ میانگین خوانش([۲۱، -۱، ۲۳، ۲۵، -۱])
    سرچاپ میانگین خوانش([-۱، -۱])
پایان
