تابع جستجو(فهرست: صحیح[]، خواسته: صحیح): صحیح:
    دیرکن سرچاپ "جستجوی"، خواسته، "تمام شد"
    هر ش، عضو در فهرست:
        اگر عضو == خواسته:
            برگشت ش
        پایان
    پایان
    برگشت -۱
پایان

تابع ریشه:
    کدها := [۴۰۴، ۲۰۰، ۵۰۰]
    سرچاپ "جایگاه:"، جستجو(کدها، ۲۰۰)
    سرچاپ "جایگاه:"، جستجو(کدها، ۳۰۱)
