واردسازی وابستگی

تابع report(label: رشته، c: وابستگی.ظرف):
    msg := وابستگی.ساختن گراف(c)
    سرچاپ label + ":"، msg == "" ? "sound" : msg
    وابستگی.بستن(c)
پایان

تابع ریشه:
    ok := وابستگی.ساخت()
    وابستگی.فراهم کردن(ok، "Repo"، ""، 0، (_c: وابستگی.ظرف): برگشت 1 پایان)
    report("fine"، ok)

    missing := وابستگی.ساخت()
    وابستگی.فراهم کردن(missing، "Service"، "Repo"، 0، (_c: وابستگی.ظرف): برگشت 1 پایان)
    report("missing"، missing)

    twice := وابستگی.ساخت()
    وابستگی.فراهم کردن(twice، "Repo"، ""، 0، (_c: وابستگی.ظرف): برگشت 1 پایان)
    وابستگی.فراهم کردن(twice، "Repo"، ""، 0، (_c: وابستگی.ظرف): برگشت 2 پایان)
    report("duplicate"، twice)

    loop := وابستگی.ساخت()
    وابستگی.فراهم کردن(loop، "A"، "B"، 0، (_c: وابستگی.ظرف): برگشت 1 پایان)
    وابستگی.فراهم کردن(loop، "B"، "C"، 0، (_c: وابستگی.ظرف): برگشت 2 پایان)
    وابستگی.فراهم کردن(loop، "C"، "A"، 0، (_c: وابستگی.ظرف): برگشت 3 پایان)
    report("cycle"، loop)

    empty := وابستگی.ساخت()
    ناپایا n := 0
    سرچاپ "get:"، وابستگی.گرفتن(empty، "Nope"، n)، وابستگی.خطا(empty)
    وابستگی.بستن(empty)
پایان
