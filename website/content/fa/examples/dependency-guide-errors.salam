واردسازی وابستگی

تابع report(برچسب: رشته، نویسه: وابستگی.ظرف):
    پیام_داده := وابستگی.ساختن گراف(نویسه)
    سرچاپ برچسب + ":"، پیام_داده == "" ? "sound" : پیام_داده
    وابستگی.بستن(نویسه)
پایان

تابع ریشه:
    موفق := وابستگی.ساخت()
    وابستگی.فراهم کردن(موفق، "Repo"، ""، 0، (_c: وابستگی.ظرف): برگشت 1 پایان)
    report("fine"، موفق)

    گمشده := وابستگی.ساخت()
    وابستگی.فراهم کردن(گمشده، "Service"، "Repo"، 0، (_c: وابستگی.ظرف): برگشت 1 پایان)
    report("missing"، گمشده)

    دوبار := وابستگی.ساخت()
    وابستگی.فراهم کردن(دوبار، "Repo"، ""، 0، (_c: وابستگی.ظرف): برگشت 1 پایان)
    وابستگی.فراهم کردن(دوبار، "Repo"، ""، 0، (_c: وابستگی.ظرف): برگشت 2 پایان)
    report("duplicate"، دوبار)

    چرخه := وابستگی.ساخت()
    وابستگی.فراهم کردن(چرخه، "A"، "B"، 0، (_c: وابستگی.ظرف): برگشت 1 پایان)
    وابستگی.فراهم کردن(چرخه، "B"، "C"، 0، (_c: وابستگی.ظرف): برگشت 2 پایان)
    وابستگی.فراهم کردن(چرخه، "C"، "A"، 0، (_c: وابستگی.ظرف): برگشت 3 پایان)
    report("cycle"، چرخه)

    خالی := وابستگی.ساخت()
    ناپایا شمار_بایت := 0
    سرچاپ "get:"، وابستگی.گرفتن(خالی، "Nope"، شمار_بایت)، وابستگی.خطا(خالی)
    وابستگی.بستن(خالی)
پایان
