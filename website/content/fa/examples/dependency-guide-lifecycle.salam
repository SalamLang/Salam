واردسازی وابستگی

ناپایا ساخته := 0

ساختار Db:
    همگانی id: صحیح = 0
پایان

ساختار Cache:
    همگانی db: Db = Db {}
پایان

تابع ریشه:
    نویسه := وابستگی.ساخت()
    وابستگی.فراهم کردن(نویسه، "Db"، ""، Db {}، (_c: وابستگی.ظرف):
        ساخته++
        برگشت Db { id = 7 }
    پایان)
    وابستگی.فراهم کردن(نویسه، "Cache"، "Db"، Cache {}، (cx: وابستگی.ظرف):
        ناپایا مقصد_محلی := Db {}
        متغیر__ok := وابستگی.گرفتن(cx، "Db"، مقصد_محلی)
        برگشت Cache { db = مقصد_محلی }
    پایان)
    وابستگی.هنگام بستن(نویسه، "Db"، Db {}، (مقصد_محلی: Db): سرچاپ "closing db"، مقصد_محلی.id پایان)
    وابستگی.هنگام بستن(نویسه، "Cache"، Cache {}، (k: Cache): سرچاپ "closing cache over"، k.db.id پایان)

    پیشین := وابستگی.ساخته شده(نویسه)
    سرچاپ "before"، پیشین.طول()
    پیشین.آزادکن()
    ناپایا الف := Cache {}
    ناپایا بافر_محلی := Cache {}
    متغیر__x := وابستگی.گرفتن(نویسه، "Cache"، الف)
    متغیر__y := وابستگی.گرفتن(نویسه، "Cache"، بافر_محلی)
    سرچاپ "factory runs"، ساخته
    ساخته_شده := وابستگی.ساخته شده(نویسه)
    سرچاپ "order"، ساخته_شده.بگیر(0)، ساخته_شده.بگیر(1)
    ساخته_شده.آزادکن()
    وابستگی.بستن(نویسه)
    وابستگی.بستن(نویسه)
    سرچاپ "done"
پایان
