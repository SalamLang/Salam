واردسازی وابستگی

ساختار Config:
    همگانی محیط: رشته = ""
پایان

ساختار Store:
    همگانی kind: رشته = ""
پایان

تابع build(محیط: رشته): وابستگی.ظرف:
    نویسه := وابستگی.ساخت()
    وابستگی.مقدار(نویسه، "Config"، Config { محیط = محیط })
    وابستگی.فراهم کردن(نویسه، "Mem"، ""، Store {}، (_c: وابستگی.ظرف): برگشت Store { kind = "memory" } پایان)
    وابستگی.فراهم کردن(نویسه، "Disk"، "Config"، Store {}، (cx: وابستگی.ظرف):
        ناپایا پیکربندی := Config {}
        متغیر__ok := وابستگی.گرفتن(cx، "Config"، پیکربندی)
        برگشت Store { kind = "disk for " + پیکربندی.محیط }
    پایان)
    اگر محیط == "test":
        وابستگی.پیوند(نویسه، "Store"، "Mem")
    وگرنه:
        وابستگی.پیوند(نویسه، "Store"، "Disk")
    پایان
    برگشت نویسه
پایان

تابع ریشه:
    برای_محیط := ["test"، "prod"]
    هر محیط در برای_محیط:
        نویسه := build(محیط)
        سرچاپ محیط + ":"، وابستگی.ساختن گراف(نویسه) == "" ? "sound" : "broken"
        ناپایا متن_نمونه := Store {}
        متغیر__ok := وابستگی.گرفتن(نویسه، "Store"، متن_نمونه)
        سرچاپ "  store is"، متن_نمونه.kind
        ساخته_شده := وابستگی.ساخته شده(نویسه)
        سرچاپ "  built"، ساخته_شده.طول()، "of"، وابستگی.تعداد(نویسه)
        ساخته_شده.آزادکن()
        وابستگی.بستن(نویسه)
    پایان
پایان
