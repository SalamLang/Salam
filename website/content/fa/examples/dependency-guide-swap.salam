واردسازی وابستگی

ساختار Config:
    همگانی env: رشته = ""
پایان

ساختار Store:
    همگانی kind: رشته = ""
پایان

تابع build(env: رشته): وابستگی.ظرف:
    c := وابستگی.ساخت()
    وابستگی.مقدار(c، "Config"، Config { env = env })
    وابستگی.فراهم کردن(c، "Mem"، ""، Store {}، (_c: وابستگی.ظرف): برگشت Store { kind = "memory" } پایان)
    وابستگی.فراهم کردن(c، "Disk"، "Config"، Store {}، (cx: وابستگی.ظرف):
        ناپایا cfg := Config {}
        _ok := وابستگی.گرفتن(cx، "Config"، cfg)
        برگشت Store { kind = "disk for " + cfg.env }
    پایان)
    اگر env == "test":
        وابستگی.پیوند(c، "Store"، "Mem")
    وگرنه:
        وابستگی.پیوند(c، "Store"، "Disk")
    پایان
    برگشت c
پایان

تابع ریشه:
    for_env := ["test"، "prod"]
    هر env در for_env:
        c := build(env)
        سرچاپ env + ":"، وابستگی.ساختن گراف(c) == "" ? "sound" : "broken"
        ناپایا s := Store {}
        _ok := وابستگی.گرفتن(c، "Store"، s)
        سرچاپ "  store is"، s.kind
        built := وابستگی.ساخته شده(c)
        سرچاپ "  built"، built.طول()، "of"، وابستگی.تعداد(c)
        built.آزادکن()
        وابستگی.بستن(c)
    پایان
پایان
