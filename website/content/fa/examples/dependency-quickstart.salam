واردسازی وابستگی

ساختار Repo:
    همگانی rows: صحیح = 0
پایان

ساختار Service:
    همگانی repo: Repo = Repo {}
    همگانی تابع Count(): صحیح:
        برگشت این.repo.rows
    پایان
پایان

ساختار Handler:
    همگانی svc: Service = Service {}
    همگانی تابع Serve(): رشته:
        برگشت "rows=" + این.svc.Count()
    پایان
پایان

تابع ریشه:
    c := وابستگی.ساخت()
    وابستگی.فراهم کردن(c، "Repo"، ""، Repo {}، (_c: وابستگی.ظرف): برگشت Repo { rows = 3 } پایان)
    وابستگی.فراهم کردن(c، "Service"، "Repo"، Service {}، (cx: وابستگی.ظرف):
        ناپایا r := Repo {}
        _ok := وابستگی.گرفتن(cx، "Repo"، r)
        برگشت Service { repo = r }
    پایان)
    وابستگی.فراهم کردن(c، "Handler"، "Service"، Handler {}، (cx: وابستگی.ظرف):
        ناپایا s := Service {}
        _ok := وابستگی.گرفتن(cx، "Service"، s)
        برگشت Handler { svc = s }
    پایان)
    err := وابستگی.ساختن گراف(c)
    اگر err نابرابر "":
        سرچاپ err
        برگشت 1
    پایان
    ناپایا h := Handler {}
    _ok := وابستگی.گرفتن(c، "Handler"، h)
    سرچاپ h.Serve()
    وابستگی.بستن(c)
پایان
