واردسازی وابستگی

ساختار Repo:
    همگانی rows: صحیح = 0
پایان

ساختار Service:
    همگانی repo: Repo = Repo {}
    همگانی تابع Count(): صحیح:
        برگشت این.repo.rows
    پایان
پایان

ساختار Handler:
    همگانی svc: Service = Service {}
    همگانی تابع Serve(): رشته:
        برگشت "rows=" + این.svc.Count()
    پایان
پایان

تابع ریشه:
    نویسه := وابستگی.ساخت()
    وابستگی.فراهم کردن(نویسه، "Repo"، ""، Repo {}، (_c: وابستگی.ظرف): برگشت Repo { rows = 3 } پایان)
    وابستگی.فراهم کردن(نویسه، "Service"، "Repo"، Service {}، (cx: وابستگی.ظرف):
        ناپایا پاسخ_محلی := Repo {}
        متغیر__ok := وابستگی.گرفتن(cx، "Repo"، پاسخ_محلی)
        برگشت Service { repo = پاسخ_محلی }
    پایان)
    وابستگی.فراهم کردن(نویسه، "Handler"، "Service"، Handler {}، (cx: وابستگی.ظرف):
        ناپایا متن_نمونه := Service {}
        متغیر__ok := وابستگی.گرفتن(cx، "Service"، متن_نمونه)
        برگشت Handler { svc = متن_نمونه }
    پایان)
    خطا := وابستگی.ساختن گراف(نویسه)
    اگر خطا نابرابر "":
        سرچاپ خطا
        برگشت 1
    پایان
    ناپایا اچ := Handler {}
    متغیر__ok := وابستگی.گرفتن(نویسه، "Handler"، اچ)
    سرچاپ اچ.Serve()
    وابستگی.بستن(نویسه)
پایان
