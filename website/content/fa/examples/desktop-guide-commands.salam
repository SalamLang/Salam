واردسازی رابط گرافیکی.برنامه رومیزی
واردسازی کدگذاری.جیسون
واردسازی همگام سازی

تابع ریشه:
    برنامه رومیزی.آغاز(برنامه رومیزی.پیکربندی { شناسه = "com.example.notes"، نام = "یادداشت"، پوشه دارایی ها = "www" })
    برنامه رومیزی.فرمان("add"، (ف: برنامه رومیزی.فراخوان):
        اگر وارونه ف.دارد("a") یا وارونه ف.دارد("b"):
            ف.رد("a و b لازم است")
            برگشت
        پایان
        ف.پاسخ عددی(ف.عدد("a") + ف.عدد("b"))
    پایان)
    برنامه رومیزی.فرمان ناهمگام("report"، (ف: برنامه رومیزی.فراخوان):
        نام := ف.متن("name")
        همگام سازی.خواب میلی ثانیه(۱۵۰۰)
        ف.پاسخ(`{"name":` + `"` + جیسون.اسکیپ(نام) + `"` + `,"pages":12}`)
    پایان)
    برنامه رومیزی.هنگام رویداد("save"، (داده: رشته):
        برنامه رومیزی.ارسال به رشته رابط(():
            برنامه رومیزی.رویداد فرستادن("saved"، داده)
        پایان)
    پایان)
    پنجره := برنامه رومیزی.باز کردن(برنامه رومیزی.گزینه های پنجره { عنوان = "یادداشت"، پهنا = ۹۰۰، بلندی = ۶۰۰ })
    اگر پنجره.بسته شده است():
        سرچاپ برنامه رومیزی.آخرین خطا()
        برگشت ۱
    پایان
    برنامه رومیزی.اجرا()
پایان
