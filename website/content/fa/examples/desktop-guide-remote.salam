واردسازی برنامه رومیزی

تابع ریشه:
    برنامه رومیزی.آغاز(برنامه رومیزی.پیکربندی { شناسه = "com.example.portal"، نام = "درگاه" })
    ناپایا مجازها := وکتور {} برگردان وکتور<رشته>
    مجازها.بیفزا("pick_folder")
    برنامه رومیزی.اجازه دادن("https://app.example.com"، مجازها)
    برنامه رومیزی.فرمان("pick_folder"، (ف: برنامه رومیزی.فراخوان):
        ف.پاسخ متنی(برنامه رومیزی.انتخاب پوشه("پوشه را انتخاب کنید"))
    پایان)
    پنجره := برنامه رومیزی.باز کردن(برنامه رومیزی.گزینه های پنجره { عنوان = "درگاه"، نشانی = "https://app.example.com/" })
    پنجره.هنگام از کار افتادن((): پنجره.پیمایش(برنامه رومیزی.نشانی دارایی("/error.html")) پایان)
    برنامه رومیزی.اجرا()
پایان
