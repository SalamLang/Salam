واردسازی رابط گرافیکی.نمایش وب

تابع ریشه:
    نمایش وب.آغاز(نمایش وب.پیکربندی { شناسه = "com.example.portal"، نام = "درگاه" })
    ناپایا مجازها := وکتور {} برگردان وکتور<رشته>
    مجازها.بیفزا("pick_folder")
    نمایش وب.اجازه دادن("https://app.example.com"، مجازها)
    نمایش وب.فرمان("pick_folder"، (ف: نمایش وب.فراخوان):
        ف.پاسخ متنی(نمایش وب.انتخاب پوشه("پوشه را انتخاب کنید"))
    پایان)
    پنجره := نمایش وب.باز کردن(نمایش وب.گزینه های پنجره { عنوان = "درگاه"، نشانی = "https://app.example.com/" })
    پنجره.هنگام از کار افتادن((): پنجره.پیمایش(نمایش وب.نشانی دارایی("/error.html")) پایان)
    نمایش وب.اجرا()
پایان
