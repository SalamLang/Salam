واردسازی رابط گرافیکی.برنامه رومیزی

تابع ریشه:
    برنامه رومیزی.آغاز(برنامه رومیزی.پیکربندی { شناسه = "com.example.notes"، نام = "یادداشت"، پوشه دارایی ها = "www" })
    پنجره := برنامه رومیزی.باز کردن(برنامه رومیزی.گزینه های پنجره { عنوان = "یادداشت" })
    ماندن := برنامه رومیزی.نمونه یکتا((ورودی‌ها: وکتور<رشته>):
        سرچاپ "اجرای دوم با"، ورودی‌ها.طول()، "ورودی"
        برنامه رومیزی.گرفتن پنجره("main").تمرکز()
    پایان)
    اگر وارونه ماندن:
        برگشت ۰
    پایان
    برنامه رومیزی.فرمان("choose_folder"، (ف: برنامه رومیزی.فراخوان):
        ف.پاسخ متنی(برنامه رومیزی.انتخاب پوشه("پوشه را انتخاب کنید"))
    پایان)
    برنامه رومیزی.فرمان("sign_in"، (ف: برنامه رومیزی.فراخوان):
        موفق := برنامه رومیزی.ذخیره راز("token"، ف.متن("token"))
        ف.پاسخ درستی(موفق)
    پایان)
    برنامه رومیزی.فرمان("token"، (ف: برنامه رومیزی.فراخوان):
        ف.پاسخ متنی(برنامه رومیزی.خواندن راز("token"))
    پایان)
    برنامه رومیزی.فرمان("done"، (ف: برنامه رومیزی.فراخوان):
        برنامه رومیزی.اعلان("یادداشت"، "خروجی شما آماده است")
        برنامه رومیزی.درخواست توجه(پنجره)
        ف.پاسخ خالی()
    پایان)
    برنامه رومیزی.هنگام کلیک سینی(():
        پنجره.نمایش()
        پنجره.تمرکز()
    پایان)
    ناپایا سینی := وکتور {} برگردان وکتور<برنامه رومیزی.مورد‌منو>
    سینی.بیفزا(برنامه رومیزی.مورد("quit"، "خروج"))
    برنامه رومیزی.تنظیم سینی("icon.png"، "یادداشت"، سینی)
    برنامه رومیزی.اجرا()
پایان
