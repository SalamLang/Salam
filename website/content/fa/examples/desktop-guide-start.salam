واردسازی برنامه رومیزی

تابع ریشه:
    برنامه رومیزی.آغاز(برنامه رومیزی.پیکربندی { شناسه = "com.example.notes"، نام = "یادداشت"، پوشه دارایی ها = "www" })
    برنامه رومیزی.فرمان("greet"، (ف: برنامه رومیزی.فراخوان):
        ف.پاسخ متنی("سلام " + ف.متن("name"))
    پایان)
    برنامه رومیزی.هنگام رویداد("ready"، (_داده: رشته):
        برنامه رومیزی.رویداد فرستادن("saved"، `{"count":1}`)
    پایان)
    پنجره := برنامه رومیزی.باز کردن(برنامه رومیزی.گزینه های پنجره { عنوان = "یادداشت"، پهنا = ۹۰۰، بلندی = ۶۰۰ })
    اگر پنجره.بسته شده است():
        سرچاپ "پنجره باز نشد"
        برگشت ۱
    پایان
    برنامه رومیزی.اجرا()
پایان
