واردسازی رابط گرافیکی.برنامه رومیزی

تابع ریشه:
    برنامه رومیزی.آغاز(برنامه رومیزی.پیکربندی { شناسه = "com.example.notes"، نام = "یادداشت"، پوشه دارایی ها = "www" })
    پنجره اصلی := برنامه رومیزی.باز کردن(برنامه رومیزی.گزینه های پنجره { برچسب = "main"، عنوان = "یادداشت"، پهنا = ۹۰۰، بلندی = ۶۰۰، کمترین پهنا = ۴۸۰، کمترین بلندی = ۳۲۰ })
    پنجره اصلی.هنگام بستن(():
        برگشت برنامه رومیزی.تایید("یادداشت"، "پنجره‌ی یادداشت بسته شود؟")
    پایان)
    پنجره اصلی.هنگام تغییر اندازه((پ: صحیح، ب: صحیح):
        سرچاپ "اندازه"، پ، ب
    پایان)
    برنامه رومیزی.فرمان("open_help"، (ف: برنامه رومیزی.فراخوان):
        راهنما := برنامه رومیزی.باز کردن(برنامه رومیزی.گزینه های پنجره { برچسب = "help"، عنوان = "راهنما"، پهنا = ۵۲۰، بلندی = ۴۲۰، اچ تی ام ال = "<h1>راهنما</h1>" })
        راهنما.رویداد فرستادن("hello"، `{"from":"main"}`)
        ف.پاسخ خالی()
    پایان)
    برنامه رومیزی.هنگام منو((شناسه: رشته):
        اگر شناسه برابر "help":
            برنامه رومیزی.گرفتن پنجره("main").رویداد فرستادن("menu"، `"help"`)
        پایان
        اگر شناسه برابر "quit":
            برنامه رومیزی.خروج()
        پایان
    پایان)
    ناپایا موردها := وکتور {} برگردان وکتور<برنامه رومیزی.مورد‌منو>
    موردها.بیفزا(برنامه رومیزی.مورد("help"، "راهنما"))
    موردها.بیفزا(برنامه رومیزی.خط جداکننده())
    موردها.بیفزا(برنامه رومیزی.مورد("quit"، "خروج"))
    برنامه رومیزی.تنظیم منو(پنجره اصلی، موردها)
    برنامه رومیزی.اجرا()
پایان
