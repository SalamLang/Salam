واردسازی دام

ناپایا مانده := ۱۰
ناپایا زمان‌سنج := ۰ برگردان صحیح۶۴
ناپایا برچسب := ۰ برگردان صحیح۶۴

تابع ریشه:
    برچسب = دام.بساز("h1")
    دام.افزودن(دام.بدنه()، برچسب)
    دام.تنظیم متن(برچسب، "" + مانده)
    زمان‌سنج = دام.تنظیم بازه(():
        مانده -= ۱
        دام.تنظیم متن(برچسب، "" + مانده)
        اگر مانده برابر ۰:
            دام.پاک کردن بازه(زمان‌سنج)
            دام.تنظیم متن(برچسب، "زمان تمام شد")
            دام.تنظیم سبک(برچسب، "color"، "crimson")
            دام.صدا(۶۶۰، ۳۰۰)
        پایان
    پایان، ۱۰۰۰)
پایان
