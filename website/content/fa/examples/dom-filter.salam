واردسازی دام
واردسازی رشته

تابع پالایش(ردیف‌ها: صحیح۶۴، واژه: رشته، شمارنده: صحیح۶۴):
    ناپایا نمایان := ۰
    تکرار دام.تعداد(ردیف‌ها) در ی:
        ردیف := دام.عنصر شماره(ردیف‌ها، ی)
        نام := رشته.کوچک(دام.دریافت متن(ردیف))
        اگر واژه.طول() برابر ۰ یا رشته.شامل است(نام، واژه):
            دام.تنظیم سبک(ردیف، "display"، "")
            نمایان += ۱
        وگرنه:
            دام.تنظیم سبک(ردیف، "display"، "none")
        پایان
    پایان
    دام.تنظیم متن(شمارنده، نمایان + " از " + دام.تعداد(ردیف‌ها) + " کالا")
پایان

تابع ریشه:
    اگر وارونه (دام.وجود دارد("search") و دام.وجود دارد("count")):
        سرچاپ "این اسکریپت به #search و #count در صفحه نیاز دارد"
        برگشت
    پایان
    جستجو := دام.با شناسه("search")
    شمارنده := دام.با شناسه("count")
    ردیف‌ها := دام.پرسمان همه("#products tr")
    اگر دام.تعداد(ردیف‌ها) برابر ۰:
        دام.تنظیم متن(شمارنده، "کالایی نیست")
        برگشت
    پایان
    دام.تنظیم سبک(دام.پرسمان("#products")، "background-color"، "#fafafa")
    دام.هنگام رویداد(جستجو، "input"، ():
        پالایش(ردیف‌ها، رشته.کوچک(رشته.پیرایش(دام.دریافت مقدار(جستجو)))، شمارنده)
    پایان)
    پالایش(ردیف‌ها، ""، شمارنده)
پایان
