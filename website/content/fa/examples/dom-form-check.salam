واردسازی دام
واردسازی رشته

ناپایا رایانامه := ۰ برگردان صحیح۶۴
ناپایا گذرواژه := ۰ برگردان صحیح۶۴
ناپایا دکمه ثبت := ۰ برگردان صحیح۶۴
ناپایا پیام := ۰ برگردان صحیح۶۴

تابع بررسی فرم():
    نشانی := دام.دریافت مقدار(رایانامه)
    رمز := دام.دریافت مقدار(گذرواژه)
    ناپایا مشکل := ""
    اگر وارونه رشته.شامل است(نشانی، "@"):
        مشکل = "یک نشانی رایانامه وارد کنید."
    وگرنه رمز.طول() کوچکتر ۸:
        مشکل = "گذرواژه دست کم ۸ نویسه لازم دارد."
    پایان
    دام.تنظیم متن(پیام، مشکل)
    دام.تنظیم خاصیت منطقی(دکمه ثبت، "disabled"، مشکل.طول() بزرگتر ۰)
    اگر مشکل.طول() بزرگتر ۰:
        دام.افزودن کلاس(پیام، "error")
    وگرنه:
        دام.حذف کلاس(پیام، "error")
    پایان
پایان

تابع ریشه:
    رایانامه = دام.بساز("input")
    دام.تنظیم ویژگی(رایانامه، "type"، "email")
    گذرواژه = دام.بساز("input")
    دام.تنظیم ویژگی(گذرواژه، "type"، "password")
    دکمه ثبت = دام.بساز("button")
    دام.تنظیم متن(دکمه ثبت، "ثبت نام")
    پیام = دام.بساز("p")
    هر عنصر در [رایانامه، گذرواژه، دکمه ثبت، پیام]:
        دام.افزودن(دام.بدنه()، عنصر)
    پایان
    دام.هنگام رویداد(رایانامه، "input"، ():
        بررسی فرم()
    پایان)
    دام.هنگام رویداد(گذرواژه، "input"، ():
        بررسی فرم()
    پایان)
    دام.هنگام رویداد(دکمه ثبت، "click"، ():
        دام.هشدار("خوش آمدید، " + دام.دریافت مقدار(رایانامه))
    پایان)
    بررسی فرم()
پایان
