واردسازی دام

ناپایا فهرست := ۰ برگردان صحیح۶۴
ناپایا ورودی متن := ۰ برگردان صحیح۶۴
ناپایا شمار افزوده := ۰

تابع افزودن کار(متن: رشته):
    مورد := دام.بساز("li")
    دام.تنظیم متن(مورد، متن)
    دام.هنگام رویداد(مورد، "click"، ():
        دام.تعویض کلاس(مورد، "done")
    پایان)
    دام.افزودن(فهرست، مورد)
    شمار افزوده += ۱
    دام.تنظیم عدد ذخیره("todo-added"، شمار افزوده برگردان صحیح۶۴)
پایان

تابع ریشه:
    دام.تنظیم عنوان("کارهای من")
    ورودی متن = دام.بساز("input")
    دام.تنظیم ویژگی(ورودی متن، "placeholder"، "چه کاری باید انجام شود؟")
    دکمه := دام.بساز("button")
    دام.تنظیم متن(دکمه، "افزودن")
    فهرست = دام.بساز("ul")
    دام.افزودن(دام.بدنه()، ورودی متن)
    دام.افزودن(دام.بدنه()، دکمه)
    دام.افزودن(دام.بدنه()، فهرست)

    دام.هنگام رویداد(دکمه، "click"، ():
        متن := دام.دریافت مقدار(ورودی متن)
        اگر متن.طول() بزرگتر ۰:
            افزودن کار(متن)
            دام.تنظیم مقدار(ورودی متن، "")
        پایان
    پایان)
    دام.هنگام رویداد جزئی(ورودی متن، "keydown"، (رخداد: صحیح۶۴):
        اگر دام.کلید رویداد(رخداد) برابر "Enter":
            دام.جلوگیری پیش فرض(رخداد)
            متن := دام.دریافت مقدار(ورودی متن)
            اگر متن.طول() بزرگتر ۰:
                افزودن کار(متن)
                دام.تنظیم مقدار(ورودی متن، "")
            پایان
        پایان
    پایان)
    سرچاپ "کارهای افزوده شده روی این دستگاه تا کنون:"، دام.دریافت عدد ذخیره("todo-added")
پایان
