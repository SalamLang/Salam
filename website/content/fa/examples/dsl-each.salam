بخش کارها:
    موارد := وکتور {} برگردان وکتور<رشته>
    بعدی := ۰
    جعبه:
        فاصله = 16
        شکاف = 8
        بیشینه عرض = 360
        دکمه: شناسه = "add" کلیک = (): موارد.افزودن("کار " + بعدی) بعدی++ پایان محتوا = "افزودن کار" پایان
        اگر موارد.طول() == ۰:
            پاراگراف: رنگ = #6b7280 محتوا = "کاری نیست." پایان
        پایان
        هر ی، م در موارد:
            جعبه:
                چیدمان = ردیف
                تراز = وسط
                شکاف = 8
                فاصله = 8
                پاراگراف: رشد = 1 محتوا = م پایان
                دکمه: کلیک = (): موارد.حذف از(ی) پایان محتوا = "انجام شد" پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "کارها"
    کارها: پایان
پایان
