بخش وظایف:
    موارد := وکتور {} برگردان وکتور<رشته>
    بعدی := ۰
    جعبه:
        فاصله = 16
        شکاف = 8
        بیشینه عرض = 360
        دکمه:
            شناسه = "add"
            کلیک = (): موارد.بیفزا("کار " + بعدی) بعدی++ پایان
            محتوا = "افزودن کار"
        پایان
        فهرست:
            هر م در موارد:
                مورد:
                    کلید = م
                    فاصله = 8
                    اشاره پس‌زمینه = #eef4ff
                    محتوا = م
                پایان
            پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "کارها"
    وظایف: پایان
پایان
