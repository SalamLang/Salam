بخش شمارنده:
    شمار := ۰
    جعبه:
        فاصله = 16
        شکاف = 8
        سرتیتر: اندازه = 2 محتوا = "شمار: " + شمار پایان
        جعبه:
            چیدمان = ردیف
            شکاف = 8
            دکمه: شناسه = "down" کلیک = (): شمار-- پایان محتوا = "-1" پایان
            دکمه: شناسه = "up" کلیک = (): شمار++ پایان محتوا = "+1" پایان
            دکمه: شناسه = "reset" کلیک = (): شمار = ۰ پایان محتوا = "از نو" پایان
        پایان
        اگر شمار > ۵:
            پاراگراف: رنگ = #dc2626 محتوا = "این خیلی زیاد است." پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "شمارنده"
    شمارنده: پایان
