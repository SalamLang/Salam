واردسازی کدگذاری.دودویی
واردسازی فشرده سازی
واردسازی رشته

تابع بایت‌های(ب: فشرده سازی.بافر بایت): رشته:
    ناپایا خروجی := ""
    تکرار فشرده سازی.طول بافر(ب) در ای:
        اگر ای > ۰:
            خروجی = خروجی + " "
        پایان
        خروجی = خروجی + رشته.از عدد(فشرده سازی.دریافت بایت(ب، ای))
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    ناپایا بزرگ := فشرده سازی.بافر بایت جدید()
    دودویی.نوشتن طبیعی۳۲ بزرگ‌انتها(بزرگ، ۱۰۰۰)
    ناپایا کوچک := فشرده سازی.بافر بایت جدید()
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(کوچک، ۱۰۰۰)
    سرچاپ "۱۰۰۰ بزرگ‌انتها: "، بایت‌های(بزرگ)
    سرچاپ "۱۰۰۰ کوچک‌انتها:"، بایت‌های(کوچک)

    ناپایا خ := فشرده سازی.خواننده از بافر(کوچک)
    سرچاپ "خواندن با ترتیب نادرست:"، دودویی.خواندن طبیعی۳۲ بزرگ‌انتها(خ)

    ناپایا همه یک := فشرده سازی.بافر بایت جدید()
    دودویی.نوشتن طبیعی۳۲ بزرگ‌انتها(همه یک، -۱)
    ناپایا خ۲ := فشرده سازی.خواننده از بافر(همه یک)
    م := دودویی.خواندن طبیعی۳۲ بزرگ‌انتها(خ۲)
    سرچاپ "u32 0xFFFFFFFF به شکل صحیح:"، م، "بی علامت:"، (م برگردان صحیح۶۴) & ۴۲۹۴۹۶۷۲۹۵

    ناپایا خ۳ := فشرده سازی.خواننده از بافر(بزرگ)
    _ := دودویی.خواندن طبیعی۳۲ بزرگ‌انتها(خ۳)
    سرچاپ "بایت‌های مانده پس از خواندن:"، فشرده سازی.باقیمانده(خ۳)

    فشرده سازی.آزادسازی بافر(همه یک)
    فشرده سازی.آزادسازی بافر(کوچک)
    فشرده سازی.آزادسازی بافر(بزرگ)
پایان
