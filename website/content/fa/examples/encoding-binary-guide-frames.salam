واردسازی کدگذاری.دودویی
واردسازی فشرده سازی

تابع فرستادن(ب &: فشرده سازی.بافر بایت، پیام: رشته):
    دودویی.نوشتن طبیعی۱۶ بزرگ‌انتها(ب، پیام.طول())
    فشرده سازی.افزودن بایت‌ها(ب، پیام برگردان تهی*، پیام.طول())
پایان

تابع ریشه:
    ناپایا سیم := فشرده سازی.بافر بایت جدید()
    فرستادن(سیم، "HELLO")
    فرستادن(سیم، "سلام")
    فرستادن(سیم، "")
    فرستادن(سیم، "BYE")
    دودویی.نوشتن طبیعی۱۶ بزرگ‌انتها(سیم، ۱۰)
    فشرده سازی.افزودن بایت‌ها(سیم، "par" برگردان تهی*، ۳)
    سرچاپ "روی سیم:"، فشرده سازی.طول بافر(سیم)، "بایت"

    ناپایا خ := فشرده سازی.خواننده از بافر(سیم)
    تا فشرده سازی.باقیمانده(خ) >= ۲:
        ن := دودویی.خواندن طبیعی۱۶ بزرگ‌انتها(خ)
        اگر فشرده سازی.باقیمانده(خ) < ن:
            سرچاپ "قاب ناقص است، منتظر داده‌ی بیشتر بمانید"
            بشکن
        پایان
        ناپایا بدنه := فشرده سازی.خواندن بایت‌ها(خ، ن)
        سرچاپ ن، "بایت: [" + فشرده سازی.بافر به رشته(بدنه) + "]"
        فشرده سازی.آزادسازی بافر(بدنه)
    پایان
    فشرده سازی.آزادسازی بافر(سیم)
پایان
