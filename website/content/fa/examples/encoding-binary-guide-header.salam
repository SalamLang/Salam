واردسازی کدگذاری.دودویی
واردسازی فشرده سازی

تابع نوشتن پرونده(امتیازها: وکتور<صحیح>): فشرده سازی.بافر بایت:
    ناپایا ب := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(ب، "SLM1" برگردان تهی*، ۴)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(ب، ۲)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(ب، امتیازها.طول())
    هر ا در امتیازها:
        دودویی.نوشتن صحیح۳۲ کوچک‌انتها(ب، ا)
    پایان
    برگشت ب
پایان

تابع ریشه:
    ناپایا امتیازها := وکتور {} برگردان وکتور<صحیح>
    امتیازها.بیفزا(۱۲۰)
    امتیازها.بیفزا(-۱۵)
    امتیازها.بیفزا(۹۸۰۰۰)
    ناپایا داده := نوشتن پرونده(امتیازها)
    سرچاپ "پرونده"، فشرده سازی.طول بافر(داده)، "بایت است"

    ناپایا خ := فشرده سازی.خواننده از بافر(داده)
    ناپایا سر := فشرده سازی.خواندن بایت‌ها(خ، ۴)
    نشان := فشرده سازی.بافر به رشته(سر)
    اگر نشان != "SLM1":
        سرچاپ "پرونده‌ی ما نیست"
        برگشت ۱
    پایان
    نسخه := دودویی.خواندن طبیعی۱۶ کوچک‌انتها(خ)
    تعداد := دودویی.خواندن طبیعی۳۲ کوچک‌انتها(خ)
    سرچاپ نشان، "نسخه"، نسخه، "با"، تعداد، "امتیاز"
    تکرار تعداد:
        سرچاپ " "، دودویی.خواندن صحیح۳۲ کوچک‌انتها(خ)
    پایان
    سرچاپ "بایت‌های مانده:"، فشرده سازی.باقیمانده(خ)
    فشرده سازی.آزادسازی بافر(سر)
    فشرده سازی.آزادسازی بافر(داده)
پایان
