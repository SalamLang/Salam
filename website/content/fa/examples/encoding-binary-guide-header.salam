واردسازی کدگذاری.دودویی
واردسازی فشرده سازی
واردسازی رشته

تابع نوشتن پرونده(امتیازها: وکتور<صحیح>): فشرده سازی.بافر بایت:
    ناپایا ب := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(ب، "SLM1" برگردان تهی*، ۴)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(ب، ۲)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(ب، امتیازها.طول())
    هر ا در امتیازها:
        دودویی.نوشتن صحیح۳۲ کوچک‌انتها(ب، ا)
    پایان
    برگشت ب
پایان

تابع خواندن پرونده(داده: فشرده سازی.بافر بایت، اندازه: صحیح): رشته خطادار:
    ناپایا خ := فشرده سازی.خواننده بایت جدید(داده.داده، اندازه)
    ناپایا سر := فشرده سازی.خواندن بایت‌ها(خ، ۴)
    دیرکن فشرده سازی.آزادسازی بافر(سر)
    اگر فشرده سازی.بافر به رشته(سر) != "SLM1":
        پرتاب خطا خطا.در جایگاه(نوع خطا.نحو، "پرونده‌ی ما نیست"، ۰)
    پایان
    نسخه := تلاش دودویی.خواندن طبیعی۱۶ کوچک‌انتها(خ)
    اگر نسخه != ۲:
        پرتاب خطا خطا.در جایگاه(نوع خطا.پشتیبانی نشده، "نسخه‌ی ناشناخته‌ی " + رشته.از عدد(نسخه)، ۴)
    پایان
    تعداد := تلاش دودویی.خواندن طبیعی۳۲ کوچک‌انتها(خ)
    اگر تعداد < ۰ یا تعداد > ۱۰۰۰۰۰:
        پرتاب خطا خطا.در جایگاه(نوع خطا.خارج از بازه، "تعداد باورنکردنی"، ۶)
    پایان
    ناپایا جمع := ۰ برگردان صحیح۶۴
    تکرار تعداد:
        جمع += (تلاش دودویی.خواندن صحیح۳۲ کوچک‌انتها(خ)) برگردان صحیح۶۴
    پایان
    برگشت رشته.از عدد(تعداد) + " امتیاز، جمع " + رشته.از عدد(جمع)
پایان

تابع نمایش(برچسب: رشته، داده: فشرده سازی.بافر بایت، اندازه: صحیح):
    تلاش:
        سرچاپ برچسب، خواندن پرونده(داده، اندازه)
    گرفتن خطا خ:
        سرچاپ برچسب، خ.به رشته()
    پایان
پایان

تابع ریشه:
    ناپایا امتیازها := وکتور {} برگردان وکتور<صحیح>
    امتیازها.بیفزا(۱۲۰)
    امتیازها.بیفزا(-۱۵)
    امتیازها.بیفزا(۹۸۰۰۰)
    ناپایا داده := نوشتن پرونده(امتیازها)
    سرچاپ "پرونده"، فشرده سازی.طول بافر(داده)، "بایت است"

    نمایش("کل پرونده:"، داده، فشرده سازی.طول بافر(داده))
    نمایش("۱۸ بایت نخست:"، داده، ۱۸)
    فشرده سازی.تنظیم بایت(داده، ۴، ۹)
    نمایش("ویرایش‌شده:"، داده، فشرده سازی.طول بافر(داده))
    فشرده سازی.آزادسازی بافر(داده)
پایان
