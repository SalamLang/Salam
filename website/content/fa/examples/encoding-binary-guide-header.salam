واردسازی کدگذاری.دودویی
واردسازی فشرده سازی
واردسازی رشته

تابع نوشتن پرونده(امتیازها: وکتور<صحیح>): فشرده سازی.بافر بایت:
    ناپایا ب := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(ب، "SLM1" برگردان تهی*، ۴)
    دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(ب، ۲)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(ب، امتیازها.طول())
    هر ا در امتیازها:
        دودویی.نوشتن صحیح۳۲ کوچک‌انتها(ب، ا)
    پایان
    برگشت ب
پایان

تابع خواندن پرونده(داده: فشرده سازی.بافر بایت، اندازه: صحیح): رشته:
    ناپایا خ := فشرده سازی.خواننده بایت جدید(داده.داده، اندازه)
    ناپایا سر := فشرده سازی.خواندن بایت‌ها(خ، ۴)
    دیرکن فشرده سازی.آزادسازی بافر(سر)
    اگر فشرده سازی.بافر به رشته(سر) != "SLM1": برگشت "پرونده‌ی ما نیست" پایان
    نسخه := دودویی.خواندن طبیعی۱۶ کوچک‌انتها(خ)
    اگر نسخه != ۲: برگشت "نسخه‌ی ناشناخته‌ی " + رشته.از عدد(نسخه) پایان
    تعداد := دودویی.خواندن طبیعی۳۲ کوچک‌انتها(خ)
    اگر تعداد < ۰ یا تعداد > ۱۰۰۰۰۰: برگشت "تعداد باورنکردنی" پایان
    ناپایا جمع := ۰ برگردان صحیح۶۴
    تکرار تعداد:
        جمع += دودویی.خواندن صحیح۳۲ کوچک‌انتها(خ) برگردان صحیح۶۴
    پایان
    اگر خ.خراب: برگشت "پس از " + رشته.از عدد(خ.جایگاه) + " بایت بریده شده" پایان
    برگشت رشته.از عدد(تعداد) + " امتیاز، جمع " + رشته.از عدد(جمع)
پایان

تابع ریشه:
    ناپایا امتیازها := وکتور {} برگردان وکتور<صحیح>
    امتیازها.بیفزا(۱۲۰)
    امتیازها.بیفزا(-۱۵)
    امتیازها.بیفزا(۹۸۰۰۰)
    ناپایا داده := نوشتن پرونده(امتیازها)
    سرچاپ "پرونده"، فشرده سازی.طول بافر(داده)، "بایت است"

    سرچاپ "کل پرونده:"، خواندن پرونده(داده، فشرده سازی.طول بافر(داده))
    سرچاپ "۱۸ بایت نخست:"، خواندن پرونده(داده، ۱۸)
    فشرده سازی.تنظیم بایت(داده، ۴، ۹)
    سرچاپ "ویرایش‌شده:"، خواندن پرونده(داده، فشرده سازی.طول بافر(داده))
    فشرده سازی.آزادسازی بافر(داده)
پایان
