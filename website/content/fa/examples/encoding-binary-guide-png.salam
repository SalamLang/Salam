تابع ریشه خطادار:
    ناپایا تصویر := پی ان جی ساختگی()
    دیرکن فشرده سازی.آزادسازی بافر(تصویر)
    ناپایا خ := فشرده سازی.خواننده از بافر(تصویر)
    ب۰ := تلاش دودویی.خواندن طبیعی۸(خ)
    ب۱ := تلاش دودویی.خواندن طبیعی۸(خ)
    اگر ب۰ != ۱۳۷ یا ب۱ != ۸۰:
        پرتاب خطا "PNG نیست"
    پایان
    تکرار ۶:
        _ := تلاش دودویی.خواندن طبیعی۸(خ)
    پایان
    طول تکه := تلاش دودویی.خواندن طبیعی۳۲ بزرگ‌انتها(خ)
    ناپایا نوع تکه := فشرده سازی.خواندن بایت‌ها(خ، ۴)
    سرچاپ "نخستین تکه:"، فشرده سازی.بافر به رشته(نوع تکه)، "با"، طول تکه، "بایت"
    فشرده سازی.آزادسازی بافر(نوع تکه)
    پهنا := تلاش دودویی.خواندن طبیعی۳۲ بزرگ‌انتها(خ)
    بلندی := تلاش دودویی.خواندن طبیعی۳۲ بزرگ‌انتها(خ)
    سرچاپ "اندازه:"، پهنا، "x"، بلندی
    عمق := تلاش دودویی.خواندن طبیعی۸(خ)
    رنگ := تلاش دودویی.خواندن طبیعی۸(خ)
    سرچاپ "عمق بیت:"، عمق، "نوع رنگ:"، رنگ
    تلاش:
        دودویی.خواندن طبیعی۸(خ)
