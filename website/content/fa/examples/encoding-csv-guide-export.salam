واردسازی کدگذاری.سی اس وی

ساختار مخاطب:
    همگانی نام: رشته = ""
    همگانی شرکت: رشته = ""
    همگانی یادداشت: رشته = ""
پایان

تابع ریشه:
    ناپایا افراد := وکتور {} برگردان وکتور<مخاطب>
    افراد.بیفزا(مخاطب { نام = "Sara Ahmadi"، شرکت = "Nik, Ltd."، یادداشت = "prefers email" })
    افراد.بیفزا(مخاطب { نام = "Reza"، شرکت = "Pars"، یادداشت = `said "call me Monday"` })

    ناپایا خروجی := ""
    ناپایا سرستون := وکتور {} برگردان وکتور<رشته>
    سرستون.بیفزا("name")
    سرستون.بیفزا("company")
    سرستون.بیفزا("note")
    خروجی = خروجی + سی اس وی.نوشتن خط(سرستون) + "\n"
    هر ف در افراد:
        ناپایا خانه‌ها := وکتور {} برگردان وکتور<رشته>
        خانه‌ها.بیفزا(ف.نام)
        خانه‌ها.بیفزا(ف.شرکت)
        خانه‌ها.بیفزا(ف.یادداشت)
        خروجی = خروجی + سی اس وی.نوشتن خط(خانه‌ها) + "\n"
    پایان
    چاپ خروجی

    ردیف := سی اس وی.خواندن خط(`Reza,Pars,"said ""call me Monday"""`)
    سرچاپ "دوباره خوانده شد:"، ردیف.بگیر(۲)
پایان
