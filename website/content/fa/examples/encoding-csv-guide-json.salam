واردسازی کدگذاری.سی اس وی
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.مقدار

تابع ریشه:
    متن := "sku,title,stock\nBK-01,Notebook,12\nPN-07,\"Pen, blue\",0\n"
    ردیف‌ها := سی اس وی.به مقدار(متن)
    سرچاپ مقدار.طول آرایه(ردیف‌ها)، "ردیف"
    گزینه‌ها := جیسون.گزینه‌های جیسون { تورفتگی = "  "، چیدن کلیدها = درست }
    سرچاپ جیسون.کدگذاری(ردیف‌ها، گزینه‌ها)

    نخست := مقدار.عضو آرایه(ردیف‌ها، ۰)
    سرچاپ "stock یک رشته است:"، مقدار.رشته است(مقدار.مقدار کلید(نخست، "stock"))
