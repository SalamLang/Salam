واردسازی کدگذاری.سی اس وی

تابع نمایش(سطر: رشته):
    خانه‌ها := سی اس وی.خواندن خط(سطر)
    ناپایا م := ""
    هر خ در خانه‌ها:
        م = م + "[" + خ + "]"
    پایان
    سرچاپ خانه‌ها.طول()، "خانه:"، م
پایان

تابع ریشه:
    نمایش("a,b,c")
    نمایش("a,,c")
    نمایش(" a , b ")
    نمایش(`"x,y",z`)
    نمایش(`"she said ""hi""",ok`)
    نمایش("trailing,")

    ناپایا ج := سی اس وی.خواندن همه("id,name\r\n1,Ali\r\n2,Sara\r\n")
    سرچاپ "ردیف‌ها با CRLF:"، ج.rows.طول()، ج.rows.بگیر(۲).fields.بگیر(۱)
    سی اس وی.آزادسازی جدول(ج)
پایان
