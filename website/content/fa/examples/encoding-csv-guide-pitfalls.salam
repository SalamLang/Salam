واردسازی کدگذاری.سی اس وی

تابع نمایش(سطر: رشته):
    تلاش:
        خانه‌ها := سی اس وی.خواندن خط(سطر)
        ناپایا م := ""
        هر خ در خانه‌ها:
            م = م + "[" + خ + "]"
        پایان
        سرچاپ خانه‌ها.طول()، "خانه:"، م
    گرفتن خطا خ:
        سرچاپ "خطا:"، خ.به رشته()، خ.کد
    پایان
پایان

تابع ریشه خطادار:
    نمایش("a,b,c")
    نمایش("a,,c")
    نمایش(" a , b ")
    نمایش(`"x,y",z`)
    نمایش(`"she said ""hi""",ok`)
    نمایش("trailing,")
    نمایش(`"Pen" ,blue,3`)
    نمایش(`5'11",Ali`)
    نمایش(`"never closed,x`)
    نمایش("sku;title;stock")

    نقطه‌ویرگولی := تلاش سی اس وی.خواندن خط سفارشی("sku;title;stock"، سی اس وی.گزینه‌های سی اس وی { جداکننده = ";" })
    سرچاپ "با جداکننده‌ی ';':"، نقطه‌ویرگولی.طول()، "خانه"

    ناپایا ج := تلاش سی اس وی.خواندن همه("id,note\r\n1,\"line one\r\nline two\"\r\n\r\n2,plain\r\n")
    سرچاپ "ردیف‌ها:"، ج.ردیف‌ها.طول()، "| یادداشت ۱"، ج.ردیف‌ها.بگیر(۱).خانه‌ها.بگیر(۱).طول()، "بایت دارد"
    سی اس وی.آزادسازی جدول(ج)
پایان
