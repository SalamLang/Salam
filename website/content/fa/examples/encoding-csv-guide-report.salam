واردسازی کدگذاری.سی اس وی

تابع ریشه:
    متن := `date,city,product,amount
2026-10-01,Tehran,tea,120
2026-10-01,Shiraz,coffee,90
2026-10-02,Tehran,coffee,75
2026-10-02,Tabriz,tea,40
2026-10-03,Shiraz,tea,60
`
    ناپایا جدول := سی اس وی.خواندن همه(متن)
    ناپایا شهرها := وکتور {} برگردان وکتور<رشته>
    ناپایا جمع‌ها := نگاشت {} برگردان نگاشت<رشته، صحیح>
    ناپایا کل := ۰
    هر ای، ردیف در جدول.ردیف‌ها:
        اگر ای == ۰ یا ردیف.خانه‌ها.طول() < ۴:
            گذر
        پایان
        شهر := ردیف.خانه‌ها.بگیر(۱)
        مبلغ := ردیف.خانه‌ها.بگیر(۳).به صحیح()
        اگر وارونه جمع‌ها.دارد(شهر):
            شهرها.بیفزا(شهر)
        پایان
        جمع‌ها.درج(شهر، جمع‌ها.دریافت با پیش فرض(شهر، ۰) + مبلغ)
        کل += مبلغ
    پایان
    هر ش در شهرها:
        سرچاپ ش، جمع‌ها.بگیر(ش)
    پایان
    سرچاپ "جمع کل"، کل
    سی اس وی.آزادسازی جدول(جدول)
پایان
