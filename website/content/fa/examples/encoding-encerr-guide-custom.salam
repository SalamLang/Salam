واردسازی کدگذاری.خطای کدگذاری

ساختار ابعاد:
    همگانی پهنا: صحیح = ۰
    همگانی بلندی: صحیح = ۰
پایان

تابع تجزیه اندازه(متن: رشته، خروجی &: ابعاد، خطا &: خطای کدگذاری.خطای کدگذاری): منطقی:
    ضرب := متن.بیاب("x")
    اگر ضرب < ۰:
        خطا = خطای کدگذاری.خطای اتمام ناگهانی(متن.طول())
        برگشت نادرست
    پایان
    پ := متن.زیررشته(۰، ضرب)
    ب := متن.زیررشته(ضرب + ۱، متن.طول() - ضرب - ۱)
    اگر پ == "" یا ب == "":
        خطا = خطای کدگذاری.خطای نشانه نابجا("expected a number on both sides of 'x'"، ضرب)
        برگشت نادرست
    پایان
    خروجی.پهنا = پ.به صحیح()
    خروجی.بلندی = ب.به صحیح()
    اگر خروجی.پهنا <= ۰ یا خروجی.بلندی <= ۰:
        خطا = خطای کدگذاری.خطای جدید(خطای کدگذاری.نوع سفارشی، "اندازه‌ها باید مثبت باشند"، ۰)
        برگشت نادرست
    پایان
    برگشت درست
پایان

تابع ریشه:
    ورودی‌ها := ["1920x1080"، "800"، "x600"، "0x10"]
    هر م در ورودی‌ها:
        ناپایا ا := ابعاد {}
        ناپایا خطا := خطای کدگذاری.بدون خطا()
        اگر تجزیه اندازه(م، ا، خطا):
            سرچاپ م، "->"، ا.پهنا، "در"، ا.بلندی
        وگرنه خطا.نوع == خطای کدگذاری.نوع اتمام ناگهانی:
            سرچاپ م، "-> ناقص:"، خطا.پیام
        وگرنه:
            سرچاپ م، "-> نوع"، خطا.نوع، "در بایت"، خطا.موقعیت
            سرچاپ "   "، خطا.پیام
        پایان
    پایان
پایان
