واردسازی کدگذاری.خطای کدگذاری
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.پرونده محیط
واردسازی کدگذاری.مسج‌پک
واردسازی کدگذاری.مقدار
واردسازی فشرده سازی

ساختار سقف‌ها:
    @جیسون "max_users"
    همگانی بیشینه کاربر: صحیح = ۰
    @جیسون "max_storage_gb"
    همگانی بیشینه فضا: صحیح = ۰
پایان

تابع گزارش(منبع: رشته، خطا: خطای کدگذاری.خطای کدگذاری):
    اگر وارونه خطای کدگذاری.خطا است(خطا):
        سرچاپ منبع، "درست"
        برگشت
    پایان
    ناپایا چه شد := "ورودی خراب"
    اگر خطا.نوع == خطای کدگذاری.نوع اتمام ناگهانی:
        چه شد = "بریده شده"
    وگرنه خطا.نوع == خطای کدگذاری.نوع داده اضافی:
        چه شد = "داده‌ی اضافی پس از پایان"
    وگرنه خطا.نوع == خطای کدگذاری.نوع سفارشی:
        چه شد = "پشتیبانی نمی‌شود"
    پایان
    سرچاپ منبع، چه شد، "در بایت"، خطا.موقعیت، "(" + خطا.پیام + ")"
پایان

تابع ریشه:
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    ناپایا سقف := سقف‌ها {}
    _ := جیسون.واسریال سازی(`{"max_users": "fifty", "max_storage_gb": 20}`، سقف، خطا)
    گزارش("limits.json:"، خطا)

    خطا = خطای کدگذاری.بدون خطا()
    _ := جیسون.کدگشایی(`{"plan": "team"} {"plan": "pro"}`، خطا)
    گزارش("plan.json:  "، خطا)

    خطا = خطای کدگذاری.بدون خطا()
    ناپایا محیط := پرونده محیط.تجزیه سخت گیرانه("PLAN=team\nSEATS=\"12\n"، خطا)
    گزارش(".env:       "، خطا)
    پرونده محیط.آزادسازی(محیط)

    ناپایا شیء := مقدار.شیء جدید()
    مقدار.تنظیم کلید(شیء، "seats"، مقدار.مقدار صحیح(۱۲))
    بایت‌ها := مسج‌پک.سریال سازی(شیء)
    خطا = خطای کدگذاری.بدون خطا()
    _ := مسج‌پک.واسریال سازی بایت‌ها(بایت‌ها.داده، فشرده سازی.طول بافر(بایت‌ها) - ۱، خطا)
    گزارش("cache.bin:  "، خطا)

    _ := مسج‌پک.واسریال سازی(بایت‌ها، خطا)
    گزارش("خطای مانده:"، خطا)
    خطا = خطای کدگذاری.بدون خطا()
    برگشتی := مسج‌پک.واسریال سازی(بایت‌ها، خطا)
    گزارش("پس از پاک کردن:"، خطا)
    سرچاپ "seats:"، مقدار.به صحیح(مقدار.مقدار کلید(برگشتی، "seats"))
پایان
