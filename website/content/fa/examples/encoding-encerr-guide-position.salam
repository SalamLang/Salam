واردسازی کدگذاری.خطای کدگذاری
واردسازی کدگذاری.جیسون
واردسازی رشته

تابع جایگاه(متن: رشته، بایت: صحیح): رشته:
    ناپایا سطر := ۱
    ناپایا ستون := ۱
    تکرار بایت در ای:
        اگر متن.زیررشته(ای، ۱) == "\n":
            سطر += ۱
            ستون = ۱
        وگرنه:
            ستون += ۱
        پایان
    پایان
    برگشت "سطر " + رشته.از عدد(سطر) + "، ستون " + رشته.از عدد(ستون)
پایان

تابع ریشه:
    متن := `{
  "name": "shop",
  "port": 8080
  "debug": true
}`
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    _ := جیسون.کدگشایی(متن، خطا)
    اگر خطای کدگذاری.خطا است(خطا):
        سرچاپ "settings.json:"، جایگاه(متن، خطا.موقعیت) + ":"، خطا.پیام
    پایان
پایان
