واردسازی کدگذاری.پرونده محیط

تابع ریشه:
    متن := `DB_HOST=localhost
DB_PORT=5432
DB_NAME=shop
DATABASE_URL=postgres://${DB_USER}@${DB_HOST}:${DB_PORT}/${DB_NAME}
CACHE_URL=redis://${REDIS_HOST:-127.0.0.1}:6379
GREETING='costs $5, not expanded'
`
    ناپایا خام := پرونده محیط.تجزیه خام(متن)
    سرچاپ "ارجاع‌ها:"، پرونده محیط.نام‌های ارجاع(خام)

    ناپایا پایه := پرونده محیط.جدید()
    پرونده محیط.تنظیم(پایه، "DB_USER"، "app")

    ناپایا محیط := پرونده محیط.گسترش سند(خام، پایه)
    سرچاپ پرونده محیط.دریافت(محیط، "DATABASE_URL")
    سرچاپ پرونده محیط.دریافت(محیط، "CACHE_URL")
    سرچاپ پرونده محیط.دریافت(محیط، "GREETING")
    سرچاپ "الگو:"، پرونده محیط.گسترش("${DB_NAME}_test"، محیط، پایه)

    پرونده محیط.آزادسازی(محیط)
    پرونده محیط.آزادسازی(پایه)
    پرونده محیط.آزادسازی(خام)
پایان
