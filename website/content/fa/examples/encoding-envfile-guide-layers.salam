واردسازی کدگذاری.پرونده محیط

تابع ریشه:
    مشترک := `# committed to the repository
نام_برنامه=shop
درگاه_متغیر=8080
سطح_گزارش=info
نشانی_پایگاه_داده=postgres://localhost/shop
`
    محلی := `# .env.local, kept out of git
درگاه_متغیر=9000
نشانی_پایگاه_داده=postgres://sara:secret@localhost/shop_dev
`
    ناپایا پیکر := پرونده محیط.تجزیه(مشترک)
    ناپایا رونویس := پرونده محیط.تجزیه(محلی)
    پرونده محیط.ادغام در(پیکر، رونویس)

    درگاه := پرونده محیط.دریافت(پیکر، "PORT").به صحیح()
    سرچاپ پرونده محیط.دریافت(پیکر، "APP_NAME")، "روی درگاه"، درگاه
    سرچاپ "سطح گزارش:"، پرونده محیط.دریافت با پیش فرض(پیکر، "LOG_LEVEL"، "warn")
    سرچاپ "کارگرها:"، پرونده محیط.دریافت با پیش فرض(پیکر، "WORKERS"، "2").به صحیح()
    سرچاپ "کلیدها به ترتیب:"، پرونده محیط.کلیدها(پیکر)

    پرونده محیط.آزادسازی(رونویس)
    پرونده محیط.آزادسازی(پیکر)
پایان
