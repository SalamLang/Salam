واردسازی کدگذاری.پرونده محیط

تابع ریشه:
    متن := `export APP_NAME=shop   # trailing comment
HOME_URL=https://shop.example/#top
MOTD="Welcome!\nOrders ship daily."
TLS_KEY="-----BEGIN KEY-----
MIIEvQIBADANBg
-----END KEY-----"
PRICE_NOTE='$5 off, literally'
EARLY=${LATER}
LATER=set below
PORT=8080
PORT=9090
`
    ناپایا تنظیم‌ها := پرونده محیط.تجزیه(متن)
    سرچاپ "APP_NAME:"، پرونده محیط.دریافت(تنظیم‌ها، "APP_NAME")
    سرچاپ "HOME_URL:"، پرونده محیط.دریافت(تنظیم‌ها، "HOME_URL")
    سرچاپ "MOTD:"، پرونده محیط.دریافت(تنظیم‌ها، "MOTD")
    کلید := پرونده محیط.دریافت(تنظیم‌ها، "TLS_KEY")
    سرچاپ "سطرهای TLS_KEY:"، کلید.بشکاف("\n").طول()
    سرچاپ "PRICE_NOTE:"، پرونده محیط.دریافت(تنظیم‌ها، "PRICE_NOTE")
    سرچاپ "EARLY: [" + پرونده محیط.دریافت(تنظیم‌ها، "EARLY") + "]"
    سرچاپ "PORT:"، پرونده محیط.دریافت(تنظیم‌ها، "PORT")، "کلیدها:"، پرونده محیط.طول(تنظیم‌ها)
    پرونده محیط.آزادسازی(تنظیم‌ها)
پایان
