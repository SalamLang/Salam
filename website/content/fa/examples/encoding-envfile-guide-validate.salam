واردسازی کدگذاری.پرونده محیط
واردسازی کدگذاری.خطای کدگذاری

تابع بارگذاری(نام: رشته، متن: رشته):
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    ناپایا سند := پرونده محیط.تجزیه سخت گیرانه(متن، خطا)
    اگر خطای کدگذاری.خطا است(خطا):
        سرچاپ نام، "خطا در بایت"، خطا.موقعیت، "->"، خطا.پیام
        پرونده محیط.آزادسازی(سند)
        برگشت
    پایان
    لازم := ["DB_URL"، "SECRET_KEY"]
    ناپایا کمبود := ۰
    هر ک در لازم:
        اگر وارونه پرونده محیط.دارد(سند، ک) یا پرونده محیط.دریافت(سند، ک) == "":
            سرچاپ نام، "کم دارد:"، ک
            کمبود += ۱
        پایان
    پایان
    اگر کمبود == ۰:
        سرچاپ نام، "درست است با"، پرونده محیط.طول(سند)، "کلید"
    پایان
    پرونده محیط.آزادسازی(سند)
پایان

تابع ریشه:
    بارگذاری("تولید:"، "DB_URL=postgres://db/shop\nSECRET_KEY=8f2c\n")
    بارگذاری("توسعه:"، "DB_URL=postgres://localhost/shop\nSECRET_KEY=\n")
    بارگذاری("غلط:  "، "DB_URL=postgres://db/shop\nSECRET KEY 8f2c\n")
    بارگذاری("باز:   "، "DB_URL=\"postgres://db/shop\n")
پایان
