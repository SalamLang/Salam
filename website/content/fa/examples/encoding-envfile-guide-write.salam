واردسازی کدگذاری.پرونده محیط

تابع ریشه:
    ناپایا سند := پرونده محیط.تجزیه("APP_NAME=shop\nPORT=8080\n")
    پرونده محیط.تنظیم(سند، "PORT"، "9090")
    پرونده محیط.تنظیم(سند، "WELCOME"، "Hello, \"friend\"")
    پرونده محیط.تنظیم(سند، "SEARCH_URL"، "http://127.0.0.1:7700")
    سرچاپ "APP_NAME حذف شد:"، پرونده محیط.حذف(سند، "APP_NAME")

    چاپ پرونده محیط.قالب(سند)
    سرچاپ "---"
    چاپ پرونده محیط.قالب صادراتی(سند)
    سرچاپ "---"
    سرچاپ پرونده محیط.نقل قول("no-spaces")، پرونده محیط.نقل قول("two words")

    ناپایا دوباره := پرونده محیط.تجزیه(پرونده محیط.قالب(سند))
    سرچاپ "رفت و برگشت:"، پرونده محیط.دریافت(دوباره، "WELCOME")
    پرونده محیط.آزادسازی(دوباره)
    پرونده محیط.آزادسازی(سند)
پایان
