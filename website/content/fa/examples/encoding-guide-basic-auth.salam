واردسازی کدگذاری

تابع سرآیند پایه(کاربر: رشته، گذرواژه: رشته): رشته:
    برگشت "Basic " + کدگذاری.کدگذاری پایه۶۴(کاربر + ":" + گذرواژه)
پایان

تابع خواندن سرآیند(سرآیند: رشته، کاربر &: رشته، گذرواژه &: رشته): منطقی:
    اگر سرآیند.بیاب("Basic ") != ۰:
        برگشت نادرست
    پایان
    ناپایا معتبر := نادرست
    جفت := کدگذاری.کدگشایی پایه۶۴ سخت گیرانه(سرآیند.زیررشته(۶، سرآیند.طول() - ۶)، معتبر)
    دونقطه := جفت.بیاب(":")
    اگر وارونه معتبر یا دونقطه < ۰:
        برگشت نادرست
    پایان
    کاربر = جفت.زیررشته(۰، دونقطه)
    گذرواژه = جفت.زیررشته(دونقطه + ۱، جفت.طول() - دونقطه - ۱)
    برگشت درست
پایان

تابع ریشه:
    س := سرآیند پایه("sara"، "p@ss:2026")
    سرچاپ "Authorization:"، س

    ناپایا کاربر := ""
    ناپایا گذرواژه := ""
    اگر خواندن سرآیند(س، کاربر، گذرواژه):
        سرچاپ "کاربر:"، کاربر
        سرچاپ "گذرواژه:"، گذرواژه
    پایان
    سرچاپ "سرآیند خراب پذیرفته شد:"، خواندن سرآیند("Basic !!not-base64!!"، کاربر، گذرواژه)
پایان
