واردسازی کدگذاری

تابع بررسی(برچسب: رشته، متن: رشته):
    تلاش:
        سرچاپ برچسب، "درست:"، کدگذاری.کدگشایی پایه۶۴(متن)
    گرفتن خطا خ:
        سرچاپ برچسب، "رد شد:"، خ.نام نوع()، "در ستون"، خ.ستون
    پایان
پایان

تابع ریشه:
    بررسی("با پرکننده  "، "U2FsYW0=")
    بررسی("بی پرکننده  "، "U2FsYW0")
    بررسی("شکسته در خط"، "U2Fs\nYW0=")
    بررسی("نشانی‌امن   "، "Pz8_")
    بررسی("فارسی       "، کدگذاری.کدگذاری پایه۶۴("سلام"))
    بررسی("غلط تایپی   "، "U2Fs*W0=")
    بررسی("نیمه‌کاره    "، "U2FsY")
    بررسی("= اضافه     "، "U2E===")
پایان
