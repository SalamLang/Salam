واردسازی کدگذاری

تابع بررسی(برچسب: رشته، متن: رشته):
    ناپایا معتبر := نادرست
    خروجی := کدگذاری.کدگشایی پایه۶۴ سخت گیرانه(متن، معتبر)
    اگر معتبر:
        سرچاپ برچسب، "درست:"، خروجی
    وگرنه:
        سرچاپ برچسب، "رد شد"
    پایان
پایان

تابع ریشه:
    بررسی("با پرکننده  "، "U2FsYW0=")
    بررسی("بی پرکننده  "، "U2FsYW0")
    بررسی("غلط تایپی   "، "U2Fs*W0=")
    بررسی("شکسته در خط"، "U2Fs\nYW0=")
    بررسی("فارسی       "، کدگذاری.کدگذاری پایه۶۴("سلام"))
    سرچاپ "نسخه‌ی آسان‌گیر روی غلط تایپی: [" + کدگذاری.کدگشایی پایه۶۴("U2Fs*W0=") + "]"
    سرچاپ "نسخه‌ی آسان‌گیر بی پرکننده: [" + کدگذاری.کدگشایی پایه۶۴("U2FsYW0") + "]"
پایان
