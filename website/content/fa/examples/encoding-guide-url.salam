واردسازی کدگذاری

تابع پیوند(پایه: رشته، پرسش: رشته، شهر: رشته): رشته:
    برگشت پایه + "?q=" + کدگذاری.کدگذاری نشانی(پرسش) + "&city=" + کدگذاری.کدگذاری نشانی(شهر)
پایان

تابع ریشه:
    نشانی := پیوند("https://example.com/search"، "coffee & cake"، "تهران")
    سرچاپ نشانی

    تکه := "coffee%20%26%20cake"
    سرچاپ "q برابر است با"، کدگذاری.کدگشایی نشانی(تکه)
    سرچاپ "به‌علاوه یعنی فاصله:"، کدگذاری.کدگشایی نشانی("tea+time")
    سرچاپ "رفت و برگشت:"، کدگذاری.کدگشایی نشانی(کدگذاری.کدگذاری نشانی("a/b?c=d")) == "a/b?c=d"
پایان
