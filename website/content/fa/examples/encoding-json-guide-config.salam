واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

ساختار پایگاه‌داده:
    @جیسون "host"
    همگانی میزبان: رشته = "localhost"
    @جیسون "port"
    همگانی درگاه: صحیح = ۵۴۳۲
    @جیسون "pool"
    همگانی استخر: صحیح = ۴
پایان

ساختار پیکربندی:
    @جیسون "name"
    همگانی نام: رشته = "app"
    @جیسون "debug"
    همگانی اشکال زدایی: منطقی = نادرست
    @جیسون "db"
    همگانی پایگاه: پایگاه‌داده = پایگاه‌داده {}
    @جیسون "admins"
    همگانی مدیران: وکتور<رشته> = وکتور {}
پایان

تابع ریشه:
    متن := `{
  "name": "shop",
  "db": {"host": "db.internal", "port": 6432},
  "admins": ["sara", "reza"]
}`
    ناپایا پیکر := پیکربندی {}
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    اگر وارونه جیسون.واسریال سازی آسان گیر(متن، پیکر، خطا):
        سرچاپ "پیکربندی خراب است:"، خطا.پیام
        برگشت ۱
    پایان
    سرچاپ "نام:"، پیکر.نام
    سرچاپ "اشکال‌زدایی:"، پیکر.اشکال زدایی
    سرچاپ "پایگاه‌داده:"، پیکر.پایگاه.میزبان، پیکر.پایگاه.درگاه، "استخر"، پیکر.پایگاه.استخر
    سرچاپ "مدیران:"، پیکر.مدیران.طول()، پیکر.مدیران.بگیر(۰)، پیکر.مدیران.بگیر(۱)
پایان
