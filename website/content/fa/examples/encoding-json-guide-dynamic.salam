واردسازی کدگذاری.جیسون
واردسازی کدگذاری.مقدار
واردسازی کدگذاری.خطای کدگذاری
واردسازی رشته

تابع شرح(م: مقدار.مقدار): رشته:
    اگر مقدار.رشته است(م): برگشت "رشته " + مقدار.به رشته(م) پایان
    اگر مقدار.صحیح است(م): برگشت "صحیح " + رشته.از عدد(مقدار.به صحیح(م)) پایان
    اگر مقدار.اعشاری است(م): برگشت "اعشاری " + رشته.از اعشار(مقدار.به اعشاری(م)) پایان
    اگر مقدار.منطقی است(م):
        اگر مقدار.به منطقی(م): برگشت "منطقی درست" پایان
        برگشت "منطقی نادرست"
    پایان
    اگر مقدار.آرایه است(م): برگشت "آرایه با " + رشته.از عدد(مقدار.طول آرایه(م)) + " عضو" پایان
    اگر مقدار.شیء است(م): برگشت "شیء با " + رشته.از عدد(مقدار.طول شیء(م)) + " کلید" پایان
    برگشت "تهی"
پایان

تابع ریشه:
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    سند := جیسون.کدگشایی(`{"id": 7, "name": "Lamp", "price": 19.5, "sale": true, "tags": ["home", "light"], "size": {"w": 20, "h": 45}, "note": null}`، خطا)
    اگر خطای کدگذاری.خطا است(خطا):
        سرچاپ "خطای تجزیه:"، خطا.پیام
        برگشت ۱
    پایان
    سرچاپ "کلیدها:"، مقدار.طول شیء(سند)
    کلیدها := ["id"، "name"، "price"، "sale"، "tags"، "size"، "note"، "color"]
    هر ک در کلیدها:
        اگر وارونه مقدار.شیء دارد(سند، ک):
            سرچاپ ک، "وجود ندارد"
            گذر
        پایان
        سرچاپ ک، "="، شرح(مقدار.مقدار کلید(سند، ک))
    پایان
    اندازه := مقدار.مقدار کلید(سند، "size")
    سرچاپ "مساحت:"، مقدار.به صحیح(مقدار.مقدار کلید(اندازه، "w")) * مقدار.به صحیح(مقدار.مقدار کلید(اندازه، "h"))
پایان
