واردسازی کدگذاری.جیسون

ساختار ثبت‌نام:
    @جیسون "email"
    همگانی رایانامه: رشته = ""
    @جیسون "age"
    همگانی سن: صحیح = ۰
پایان

تابع بارگذاری(متن: رشته):
    ناپایا ث := ثبت‌نام {}
    تلاش:
        جیسون.واسریال سازی(متن، ث)
        سرچاپ "درست:"، ث.رایانامه، ث.سن
    گرفتن خطا خ:
        سرچاپ خ.نام نوع()، "در خط"، خ.خط، "ستون"، خ.ستون، "->"، خ.پیام
    پایان
پایان

تابع بارگذاری آسان گیر(متن: رشته):
    ناپایا ث := ثبت‌نام {}
    تلاش:
        جیسون.واسریال سازی آسان گیر(متن، ث)
        سرچاپ "آسان‌گیر درست:"، ث.رایانامه، ث.سن
    گرفتن خطا خ:
        سرچاپ "آسان‌گیر:"، خ.به رشته()
    پایان
پایان

تابع ریشه:
    بارگذاری(`{"email": "a@example.com", "age": 31}`)
    بارگذاری(`{"email": "a@example.com", "age": "31"}`)
    بارگذاری(`{"email": "a@example.com", "age": 31`)
    بارگذاری(`{"email": "a@example.com", "age": 31, "plan": "pro"}`)
    بارگذاری آسان گیر(`{"email": "a@example.com", "age": 31, "plan": "pro"}`)

    سرچاپ "معتبر:"، جیسون.معتبر(`[1, 2, 3]`)، جیسون.معتبر(`[1, 2,]`)
    سرچاپ "کلید نبوده [" + جیسون.دریافت(`{"a": 1}`، "b") + "] می‌دهد"
پایان
