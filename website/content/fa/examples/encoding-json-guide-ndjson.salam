واردسازی کدگذاری.جیسون
واردسازی کدگذاری.مقدار

تابع ریشه:
    گزارش‌ها := `{"level": "info", "msg": "started", "ms": 3}
{"level": "warn", "msg": "slow query", "ms": 820}
{"level": "info", "msg": "request", "ms": 41}
{"level": "error", "msg": "timeout", "ms": 5000}
{"level": "info", "msg": "request", "ms": 37}
`
    ناپایا شمارش := نگاشت {} برگردان نگاشت<رشته، صحیح>
    ناپایا کند := ۰
    ناپایا خواننده := جیسون.کدگشای رشته(گزارش‌ها)
    تا خواننده.باز هم():
        خط := خواننده.کدگشایی()
        سطح := مقدار.به رشته(مقدار.مقدار کلید(خط، "level"))
        شمارش.درج(سطح، شمارش.دریافت با پیش فرض(سطح، ۰) + ۱)
        اگر مقدار.به صحیح(مقدار.مقدار کلید(خط، "ms")) > ۵۰۰:
            کند += ۱
        پایان
    پایان
    سرچاپ "info:"، شمارش.دریافت با پیش فرض("info"، ۰)، "warn:"، شمارش.دریافت با پیش فرض("warn"، ۰)، "error:"، شمارش.دریافت با پیش فرض("error"، ۰)
    سرچاپ "کندتر از ۵۰۰ میلی‌ثانیه:"، کند

    ناپایا نویسنده := جیسون.کدگذار حافظه()
    نویسنده.کدگذاری(مقدار.مقدار رشته("summary"))
    نویسنده.کدگذاری(مقدار.مقدار صحیح(کند))
    سرچاپ نویسنده.متن()
    نویسنده.بستن()
پایان
