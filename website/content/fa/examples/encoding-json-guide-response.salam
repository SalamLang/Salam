واردسازی کدگذاری.جیسون

ساختار کالا:
    @جیسون "sku"
    همگانی شناسه: رشته = ""
    @جیسون "title"
    همگانی عنوان: رشته = ""
    @جیسون "price_cents"
    همگانی قیمت: صحیح = ۰
    @جیسون "in_stock"
    همگانی موجود: منطقی = درست
پایان

ساختار صفحه‌نتایج:
    @جیسون "page"
    همگانی شماره: صحیح = ۱
    @جیسون "total"
    همگانی کل: صحیح = ۰
    @جیسون "items"
    همگانی کالاها: وکتور<کالا> = وکتور {}
    @جیسون "-"
    همگانی نهان: رشته = ""
پایان

تابع ریشه:
    ناپایا ص := صفحه‌نتایج { شماره = ۲، کل = ۱۴، نهان = "products:2" }
    ص.کالاها.بیفزا(کالا { شناسه = "BK-01"، عنوان = "Notebook"، قیمت = ۱۲۵۰ })
    ص.کالاها.بیفزا(کالا { شناسه = "PN-07"، عنوان = "Pen \"fine\""، قیمت = ۳۰۰، موجود = نادرست })

    سرچاپ جیسون.سریال سازی(ص)
    سرچاپ جیسون.سریال سازی با تورفتگی(ص، "  ")
پایان
