واردسازی کدگذاری.مسج‌پک
واردسازی کدگذاری.مقدار
واردسازی فشرده سازی

تابع شانزدهی(م: مقدار.مقدار): رشته:
    رقم‌ها := "0123456789abcdef"
    ناپایا ب := مسج‌پک.سریال سازی(م)
    ناپایا خروجی := ""
    تکرار فشرده سازی.طول بافر(ب) در ای:
        ایکس := فشرده سازی.دریافت بایت(ب، ای)
        اگر ای > ۰:
            خروجی = خروجی + " "
        پایان
        خروجی = خروجی + رقم‌ها.زیررشته(ایکس / ۱۶، ۱) + رقم‌ها.زیررشته(ایکس % ۱۶، ۱)
    پایان
    فشرده سازی.آزادسازی بافر(ب)
    برگشت خروجی
پایان

تابع ریشه:
    سرچاپ "5       "، شانزدهی(مقدار.مقدار صحیح(۵))
    سرچاپ "-1      "، شانزدهی(مقدار.مقدار صحیح(-۱))
    سرچاپ "200     "، شانزدهی(مقدار.مقدار صحیح(۲۰۰))
    سرچاپ "70000   "، شانزدهی(مقدار.مقدار صحیح(۷۰۰۰۰))
    سرچاپ "true    "، شانزدهی(مقدار.مقدار منطقی(درست))
    سرچاپ "null    "، شانزدهی(مقدار.مقدار تهی())
    سرچاپ "1.5     "، شانزدهی(مقدار.مقدار اعشاری(۱.۵))
    سرچاپ "\"hi\"    "، شانزدهی(مقدار.مقدار رشته("hi"))

    ناپایا آرایه := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(آرایه، مقدار.مقدار صحیح(۱))
    مقدار.افزودن به آرایه(آرایه، مقدار.مقدار صحیح(۲))
    سرچاپ "[1, 2]  "، شانزدهی(آرایه)

    ناپایا شیء := مقدار.شیء جدید()
    مقدار.تنظیم کلید(شیء، "a"، مقدار.مقدار صحیح(۱))
    سرچاپ "{\"a\": 1}"، شانزدهی(شیء)
پایان
