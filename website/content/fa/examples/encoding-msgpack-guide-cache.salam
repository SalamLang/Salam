واردسازی کدگذاری.مسج‌پک
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری
واردسازی فشرده سازی

ساختار نشست:
    @جیسون "user"
    همگانی کاربر: رشته = ""
    @جیسون "role"
    همگانی نقش: رشته = ""
    @جیسون "visits"
    همگانی بازدید: صحیح = ۰
پایان

تابع ذخیره(نهان &: نگاشت<رشته، فشرده سازی.بافر بایت>، کلید: رشته، ن: نشست):
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    م := جیسون.کدگشایی(جیسون.سریال سازی(ن)، خطا)
    نهان.درج(کلید، مسج‌پک.سریال سازی(م))
پایان

تابع بارگذاری(نهان: نگاشت<رشته، فشرده سازی.بافر بایت>، کلید: رشته، خروجی &: نشست): منطقی:
    اگر وارونه نهان.دارد(کلید):
        برگشت نادرست
    پایان
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    م := مسج‌پک.واسریال سازی(نهان.بگیر(کلید)، خطا)
    اگر خطای کدگذاری.خطا است(خطا):
        برگشت نادرست
    پایان
    برگشت جیسون.واسریال سازی(جیسون.کدگذاری پیش فرض(م)، خروجی، خطا)
پایان

تابع ریشه:
    ناپایا نهان := نگاشت {} برگردان نگاشت<رشته، فشرده سازی.بافر بایت>
    ذخیره(نهان، "session:9f2"، نشست { کاربر = "sara"، نقش = "admin"، بازدید = ۱۲ })

    ناپایا ن := نشست {}
    اگر بارگذاری(نهان، "session:9f2"، ن):
        سرچاپ "پیدا شد:"، ن.کاربر، ن.نقش، ن.بازدید
    پایان
    سرچاپ "کلید نبوده بارگذاری شد:"، بارگذاری(نهان، "session:000"، ن)
پایان
