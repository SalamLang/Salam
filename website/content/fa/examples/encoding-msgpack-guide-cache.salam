واردسازی کدگذاری.مسج‌پک
واردسازی کدگذاری.جیسون
واردسازی فشرده سازی

ساختار نشست:
    @جیسون "user"
    همگانی کاربر: رشته = ""
    @جیسون "role"
    همگانی نقش: رشته = ""
    @جیسون "visits"
    همگانی بازدید: صحیح = ۰
پایان

تابع ذخیره(نهان &: نگاشت<رشته، فشرده سازی.بافر بایت>، کلید: رشته، ن: نشست) خطادار:
    م := تلاش جیسون.کدگشایی(جیسون.سریال سازی(ن))
    نهان.درج(کلید، مسج‌پک.سریال سازی(م))
پایان

تابع بارگذاری(نهان: نگاشت<رشته، فشرده سازی.بافر بایت>، کلید: رشته، خروجی &: نشست): منطقی:
    اگر وارونه نهان.دارد(کلید):
        برگشت نادرست
    پایان
    تلاش:
        م := مسج‌پک.واسریال سازی(نهان.بگیر(کلید))
        جیسون.واسریال سازی(جیسون.کدگذاری پیش فرض(م)، خروجی)
    گرفتن خطا:
        برگشت نادرست
    پایان
    برگشت درست
پایان

تابع ریشه خطادار:
    ناپایا نهان := نگاشت {} برگردان نگاشت<رشته، فشرده سازی.بافر بایت>
    تلاش ذخیره(نهان، "session:9f2"، نشست { کاربر = "sara"، نقش = "admin"، بازدید = ۱۲ })

    ناپایا ن := نشست {}
    اگر بارگذاری(نهان، "session:9f2"، ن):
        سرچاپ "پیدا شد:"، ن.کاربر، ن.نقش، ن.بازدید
    پایان
    سرچاپ "کلید نبوده بارگذاری شد:"، بارگذاری(نهان، "session:000"، ن)
پایان
