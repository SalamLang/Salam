واردسازی کدگذاری.مسج‌پک
واردسازی کدگذاری.مقدار
واردسازی فشرده سازی

تابع ریشه خطادار:
    ناپایا م := مقدار.شیء جدید()
    مقدار.تنظیم کلید(م، "name"، مقدار.مقدار رشته("salam"))
    ب := مسج‌پک.سریال سازی(م)

    کامل := تلاش مسج‌پک.واسریال سازی بایت‌ها(ب.داده، ب.طول)
    سرچاپ "کل بافر:"، تلاش کامل.عضو("name").متن()

    تلاش:
        _ := مسج‌پک.واسریال سازی بایت‌ها(ب.داده، ب.طول - ۳)
    گرفتن خطا خ:
        سرچاپ "بریده:"، خ.است(نوع خطا.اتمام ناگهانی)، خ.به رشته()
    پایان

    ناپایا لکه := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(لکه، 0xc4)
    فشرده سازی.افزودن بایت(لکه، ۲)
    فشرده سازی.افزودن بایت(لکه، 0xca)
    فشرده سازی.افزودن بایت(لکه، 0xfe)
    تلاش:
        _ := مسج‌پک.واسریال سازی(لکه)
    گرفتن خطا خ:
        سرچاپ "bin از کتابخانه‌ای دیگر:"، خ.نام نوع()، "->"، خ.پیام
    پایان

    ناپایا دوتایی := فشرده سازی.کپی بافر(ب)
    فشرده سازی.افزودن بایت(دوتایی، 0x2a)
    نخست := تلاش مسج‌پک.واسریال سازی(دوتایی)
    سرچاپ "یک بایت اضافه پس از مقدار:"، مقدار.طول شیء(نخست)، "کلید خوانده شد"
پایان
