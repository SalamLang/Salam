واردسازی کدگذاری.مسج‌پک
واردسازی کدگذاری.مقدار
واردسازی کدگذاری.خطای کدگذاری
واردسازی فشرده سازی

تابع ریشه:
    ناپایا م := مقدار.شیء جدید()
    مقدار.تنظیم کلید(م، "name"، مقدار.مقدار رشته("salam"))
    ب := مسج‌پک.سریال سازی(م)

    ناپایا خطا := خطای کدگذاری.بدون خطا()
    کامل := مسج‌پک.واسریال سازی بایت‌ها(ب.داده، ب.طول، خطا)
    سرچاپ "کل بافر:"، خطای کدگذاری.خطا است(خطا)، مقدار.به رشته(مقدار.مقدار کلید(کامل، "name"))

    ناپایا بریده := خطای کدگذاری.بدون خطا()
    _ := مسج‌پک.واسریال سازی بایت‌ها(ب.داده، ب.طول - ۳، بریده)
    سرچاپ "بریده:"، خطای کدگذاری.خطا است(بریده)، بریده.نوع == خطای کدگذاری.نوع اتمام ناگهانی، بریده.پیام

    ناپایا لکه := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(لکه، 0xc4)
    فشرده سازی.افزودن بایت(لکه، ۲)
    فشرده سازی.افزودن بایت(لکه، 0xca)
    فشرده سازی.افزودن بایت(لکه، 0xfe)
    ناپایا دودویی := خطای کدگذاری.بدون خطا()
    _ := مسج‌پک.واسریال سازی(لکه، دودویی)
    سرچاپ "bin از کتابخانه‌ای دیگر:"، دودویی.نوع == خطای کدگذاری.نوع سفارشی، دودویی.پیام

    ناپایا دوتایی := فشرده سازی.کپی بافر(ب)
    فشرده سازی.افزودن بایت(دوتایی، 0x2a)
    ناپایا اضافه := خطای کدگذاری.بدون خطا()
    نخست := مسج‌پک.واسریال سازی(دوتایی، اضافه)
    سرچاپ "یک بایت اضافه پس از مقدار:"، خطای کدگذاری.خطا است(اضافه)، مقدار.طول شیء(نخست)، "کلید خوانده شد"
پایان
