واردسازی کدگذاری.مسج‌پک
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.مقدار
واردسازی فشرده سازی

تابع ریشه خطادار:
    متن := `[{"id": 1, "name": "tea", "price": 120, "stock": true},
 {"id": 2, "name": "coffee", "price": 90, "stock": true},
 {"id": 3, "name": "cocoa", "price": 75, "stock": false}]`
    ردیف‌ها := تلاش جیسون.کدگشایی(متن)

    فشرده := جیسون.کدگذاری پیش فرض(ردیف‌ها)
    بسته‌بندی := مسج‌پک.سریال سازی(ردیف‌ها)
    سرچاپ "بایت‌های جیسون:   "، فشرده.طول()
    سرچاپ "بایت‌های مسج‌پک:  "، فشرده سازی.طول بافر(بسته‌بندی)

    برگشتی := تلاش مسج‌پک.واسریال سازی(بسته‌بندی)
    سرچاپ "همان داده:"، مقدار.یکسان است(ردیف‌ها، برگشتی)
پایان
