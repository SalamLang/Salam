واردسازی کدگذاری.پروتوباف

تابع ریشه:
    پروتو := "syntax = \"proto3\";\nmessage Point {\n  sint32 x = 1;\n  sint32 y = 2;\n  string label = 3;\n}\n"
    ناپایا سالم := نادرست
    کد := پروتوباف.تولید کد(پروتو، سالم)
    اگر وارونه سالم:
        سرچاپ "پرونده‌ی proto تجزیه نشد"
        برگشت ۱
    پایان
    خط‌ها := کد.بشکاف("\n")
    هر خط در خط‌ها:
        اگر خط.شروع با("pub ") یا خط.شروع با("package "):
            سرچاپ خط
        پایان
    پایان
    برگشت ۰
پایان
