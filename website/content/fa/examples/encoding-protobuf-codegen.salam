واردسازی کدگذاری.پروتوباف

تابع ریشه:
    پروتو := "syntax = \"proto3\";\nmessage Point {\n  sint32 x = 1;\n  sint32 y = 2;\n  string label = 3;\n}\n"
    ناپایا کد := ""
    تلاش:
        کد = پروتوباف.تولید کد(پروتو)
    گرفتن خطا اشکال:
        سرچاپ "پرونده‌ی proto تجزیه نشد:"، اشکال.به رشته()
        برگشت ۱
    پایان
    خط‌ها := کد.بشکاف("\n")
    هر خط در خط‌ها:
        اگر خط.شروع با("pub ") یا خط.شروع با("package "):
            سرچاپ خط
        پایان
    پایان
    برگشت ۰
پایان
