واردسازی کدگذاری.پروتوباف
واردسازی فشرده سازی

ساختار کاربر:
    همگانی شناسه: صحیح = ۰
    همگانی نام: رشته = ""
    همگانی مدیر: منطقی = نادرست
پایان

تابع خواندن کاربر(داده: تهی*، اندازه: صحیح، سالم &: منطقی): کاربر:
    ناپایا ک := کاربر {}
    ناپایا خ := فشرده سازی.خواننده بایت جدید(داده، اندازه)
    سالم = درست
    تا فشرده سازی.باقیمانده(خ) بزرگتر ۰ و سالم:
        ناپایا شماره := ۰
        ناپایا سیم := ۰
        پروتوباف.خواندن برچسب(خ، شماره، سیم، سالم)
        اگر وارونه سالم: برگشت ک پایان
        ترابرد شماره:
            ۱:
                ک.شناسه = پروتوباف.خواندن عدد متغیر(خ، سالم) برگردان صحیح
                بشکن
            پایان
            ۲:
                ک.نام = پروتوباف.خواندن رشته طول‌دار(خ، سالم)
                بشکن
            پایان
            ۳:
                ک.مدیر = پروتوباف.خواندن عدد متغیر(خ، سالم) نابرابر (۰ برگردان طبیعی۶۴)
                بشکن
            پایان
            وگرنه:
                سرچاپ "رد شدن از فیلد ناشناخته‌ی"، شماره
                پروتوباف.رد کردن فیلد(خ، سیم، سالم)
            پایان
        پایان
    پایان
    برگشت ک
پایان

تابع ریشه:
    ناپایا ب := فشرده سازی.بافر بایت جدید()
    پروتوباف.نوشتن برچسب(ب، ۱، پروتوباف.نوع سیم متغیر)
    پروتوباف.نوشتن عدد متغیر(ب، ۴۲ برگردان طبیعی۶۴)
    پروتوباف.نوشتن برچسب(ب، ۹، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن رشته طول‌دار(ب، "افزوده در نسخه ۲")
    پروتوباف.نوشتن برچسب(ب، ۲، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن رشته طول‌دار(ب، "سارا")
    ناپایا سالم := نادرست
    ک := خواندن کاربر(ب.داده، فشرده سازی.طول بافر(ب)، سالم)
    سرچاپ سالم، ک.شناسه، ک.نام، ک.مدیر
    _ := خواندن کاربر(ب.داده، فشرده سازی.طول بافر(ب) - ۲، سالم)
    سرچاپ "پیام بریده:"، سالم
    فشرده سازی.آزادسازی بافر(ب)
پایان
