واردسازی کدگذاری.پروتوباف
واردسازی فشرده سازی

ساختار کاربر:
    همگانی شناسه: صحیح = ۰
    همگانی نام: رشته = ""
    همگانی مدیر: منطقی = نادرست
پایان

تابع خواندن کاربر(داده: تهی*، اندازه: صحیح): کاربر خطادار:
    ناپایا ک := کاربر {}
    ناپایا خ := فشرده سازی.خواننده بایت جدید(داده، اندازه)
    تا فشرده سازی.باقیمانده(خ) بزرگتر ۰:
        ناپایا شماره := ۰
        ناپایا سیم := ۰
        تلاش پروتوباف.خواندن برچسب(خ، شماره، سیم)
        اگر شماره برابر ۱:
            ک.شناسه = تلاش پروتوباف.خواندن عدد متغیر(خ) برگردان صحیح
        وگرنه شماره برابر ۲:
            ک.نام = تلاش پروتوباف.خواندن رشته طول‌دار(خ)
        وگرنه شماره برابر ۳:
            ک.مدیر = تلاش پروتوباف.خواندن عدد متغیر(خ) نابرابر (۰ برگردان طبیعی۶۴)
        وگرنه:
            سرچاپ "رد شدن از فیلد ناشناخته‌ی"، شماره
            تلاش پروتوباف.رد کردن فیلد(خ، سیم)
        پایان
    پایان
    برگشت ک
پایان

تابع ریشه خطادار:
    ناپایا ب := فشرده سازی.بافر بایت جدید()
    پروتوباف.نوشتن برچسب(ب، ۱، پروتوباف.نوع سیم متغیر)
    پروتوباف.نوشتن عدد متغیر(ب، ۴۲ برگردان طبیعی۶۴)
    پروتوباف.نوشتن برچسب(ب، ۹، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن رشته طول‌دار(ب، "افزوده در نسخه ۲")
    پروتوباف.نوشتن برچسب(ب، ۲، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن رشته طول‌دار(ب، "سارا")
    ک := تلاش خواندن کاربر(ب.داده، فشرده سازی.طول بافر(ب))
    سرچاپ ک.شناسه، ک.نام، ک.مدیر
    تلاش:
        _ := خواندن کاربر(ب.داده، فشرده سازی.طول بافر(ب) - ۲)
    گرفتن خطا اشکال:
        سرچاپ "پیام بریده:"، اشکال.نام نوع()، "|"، اشکال.به رشته()
    پایان
    فشرده سازی.آزادسازی بافر(ب)
پایان
