واردسازی کدگذاری.پروتوباف
واردسازی فشرده سازی

تابع نوشتن قلم(سفارش &: فشرده سازی.بافر بایت، نام: رشته، تعداد: صحیح):
    ناپایا قلم := فشرده سازی.بافر بایت جدید()
    پروتوباف.نوشتن برچسب(قلم، ۱، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن رشته طول‌دار(قلم، نام)
    پروتوباف.نوشتن برچسب(قلم، ۲، پروتوباف.نوع سیم متغیر)
    پروتوباف.نوشتن عدد متغیر(قلم، تعداد برگردان طبیعی۶۴)
    پروتوباف.نوشتن برچسب(سفارش، ۲، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن بایت‌های طول‌دار(سفارش، قلم.داده، فشرده سازی.طول بافر(قلم))
    فشرده سازی.آزادسازی بافر(قلم)
پایان

تابع نمایش قلم(ب: فشرده سازی.بافر بایت):
    ناپایا خ := فشرده سازی.خواننده از بافر(ب)
    ناپایا سالم := درست
    ناپایا نام := ""
    ناپایا تعداد := ۰
    تا فشرده سازی.باقیمانده(خ) بزرگتر ۰ و سالم:
        ناپایا شماره := ۰
        ناپایا سیم := ۰
        پروتوباف.خواندن برچسب(خ، شماره، سیم، سالم)
        اگر شماره برابر ۱: نام = پروتوباف.خواندن رشته طول‌دار(خ، سالم)
        وگرنه شماره برابر ۲: تعداد = پروتوباف.خواندن عدد متغیر(خ، سالم) برگردان صحیح
        وگرنه: پروتوباف.رد کردن فیلد(خ، سیم، سالم) پایان
    پایان
    سرچاپ "  قلم"، نام، "تعداد"، تعداد
پایان

تابع ریشه:
    ناپایا سفارش := فشرده سازی.بافر بایت جدید()
    پروتوباف.نوشتن برچسب(سفارش، ۱، پروتوباف.نوع سیم متغیر)
    پروتوباف.نوشتن عدد متغیر(سفارش، ۱۰۰۱ برگردان طبیعی۶۴)
    نوشتن قلم(سفارش، "خودکار"، ۳)
    نوشتن قلم(سفارش، "دفتر"، ۱)
    سرچاپ "بایت‌های سفارش:"، فشرده سازی.طول بافر(سفارش)

    ناپایا خ := فشرده سازی.خواننده از بافر(سفارش)
    ناپایا سالم := درست
    تا فشرده سازی.باقیمانده(خ) بزرگتر ۰ و سالم:
        ناپایا شماره := ۰
        ناپایا سیم := ۰
        پروتوباف.خواندن برچسب(خ، شماره، سیم، سالم)
        اگر شماره برابر ۱:
            سرچاپ "سفارش"، پروتوباف.خواندن عدد متغیر(خ، سالم)
        وگرنه شماره برابر ۲:
            ناپایا زیرپیام := پروتوباف.خواندن بافر طول‌دار(خ، سالم)
            نمایش قلم(زیرپیام)
            فشرده سازی.آزادسازی بافر(زیرپیام)
        وگرنه:
            پروتوباف.رد کردن فیلد(خ، سیم، سالم)
        پایان
    پایان
    فشرده سازی.آزادسازی بافر(سفارش)
پایان
