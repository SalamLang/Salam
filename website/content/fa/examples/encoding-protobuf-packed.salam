واردسازی کدگذاری.پروتوباف
واردسازی فشرده سازی

تابع خواندن امتیازها(ب: فشرده سازی.بافر بایت): وکتور<صحیح>:
    ناپایا خروجی := وکتور {} برگردان وکتور<صحیح>
    ناپایا خ := فشرده سازی.خواننده از بافر(ب)
    ناپایا سالم := درست
    تا فشرده سازی.باقیمانده(خ) بزرگتر ۰ و سالم:
        ناپایا شماره := ۰
        ناپایا سیم := ۰
        پروتوباف.خواندن برچسب(خ، شماره، سیم، سالم)
        اگر شماره برابر ۱ و سیم برابر پروتوباف.نوع سیم طول‌دار:
            ناپایا فشرده := پروتوباف.خواندن بافر طول‌دار(خ، سالم)
            ناپایا خف := فشرده سازی.خواننده از بافر(فشرده)
            تا فشرده سازی.باقیمانده(خف) بزرگتر ۰ و سالم:
                خروجی.بیفزا(پروتوباف.خواندن عدد متغیر(خف، سالم) برگردان صحیح)
            پایان
            فشرده سازی.آزادسازی بافر(فشرده)
        وگرنه شماره برابر ۱ و سیم برابر پروتوباف.نوع سیم متغیر:
            خروجی.بیفزا(پروتوباف.خواندن عدد متغیر(خ، سالم) برگردان صحیح)
        وگرنه:
            پروتوباف.رد کردن فیلد(خ، سیم، سالم)
        پایان
    پایان
    برگشت خروجی
پایان

تابع ریشه:
    امتیازها := [۷، ۱۵۰، ۳]

    ناپایا بدنه := فشرده سازی.بافر بایت جدید()
    هر ا در امتیازها:
        پروتوباف.نوشتن عدد متغیر(بدنه، ا برگردان طبیعی۶۴)
    پایان
    ناپایا فشرده := فشرده سازی.بافر بایت جدید()
    پروتوباف.نوشتن برچسب(فشرده، ۱، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن بایت‌های طول‌دار(فشرده، بدنه.داده، فشرده سازی.طول بافر(بدنه))

    ناپایا جدا := فشرده سازی.بافر بایت جدید()
    هر ا در امتیازها:
        پروتوباف.نوشتن برچسب(جدا، ۱، پروتوباف.نوع سیم متغیر)
        پروتوباف.نوشتن عدد متغیر(جدا، ا برگردان طبیعی۶۴)
    پایان

    سرچاپ "فشرده:"، فشرده سازی.طول بافر(فشرده)، "بایت ->"، خواندن امتیازها(فشرده)
    سرچاپ "جدا:  "، فشرده سازی.طول بافر(جدا)، "بایت ->"، خواندن امتیازها(جدا)
    فشرده سازی.آزادسازی بافر(جدا)
    فشرده سازی.آزادسازی بافر(فشرده)
    فشرده سازی.آزادسازی بافر(بدنه)
پایان
