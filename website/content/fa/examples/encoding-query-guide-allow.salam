واردسازی کدگذاری.پرس‌وجو

تابع ریشه:
    رسیده := "q=lamp&page=2&utm_source=ad&debug=1&sort=new&callback=x"

    ناپایا ن := پرس‌وجو.کدگشایی(رسیده)
    ناپایا مجاز := وکتور {} برگردان وکتور<رشته>
    مجاز.بیفزا("q")
    مجاز.بیفزا("page")
    مجاز.بیفزا("sort")
    پرس‌وجو.نگه داشتن(ن، مجاز)
    سرچاپ "ماند:"، پرس‌وجو.کدگذاری(ن)

    سرچاپ "sort حذف شد:"، پرس‌وجو.حذف(ن، "sort")
    سرچاپ "دوباره حذف شد:"، پرس‌وجو.حذف(ن، "sort")
    سرچاپ "کلید حافظه‌ی نهان:"، پرس‌وجو.کدگذاری(ن)، "با"، پرس‌وجو.اندازه(ن)، "کلید"
پایان
