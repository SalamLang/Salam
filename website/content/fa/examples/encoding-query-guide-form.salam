واردسازی کدگذاری.پرس‌وجو

تابع ریشه:
    بدنه := "name=Sara+Ahmadi&city=%D8%B4%DB%8C%D8%B1%D8%A7%D8%B2&note=50%25+off%3F&agree=on"
    فرم := پرس‌وجو.کدگشایی(بدنه)
    سرچاپ "فیلدها:"، پرس‌وجو.کلیدها(فرم)
    سرچاپ "نام:"، پرس‌وجو.مقدار(بدنه، "name")
    سرچاپ "شهر:"، پرس‌وجو.مقدار(بدنه، "city")
    سرچاپ "یادداشت:"، پرس‌وجو.مقدار(بدنه، "note")
    سرچاپ "پذیرفت:"، پرس‌وجو.مقدار(بدنه، "agree") == "on"

    ناپایا پاسخ := پرس‌وجو.نگاشت پرس‌وجو جدید()
    پرس‌وجو.تنظیم(پاسخ، "status"، "saved ok")
    سرچاپ "به سبک فرم:"، پرس‌وجو.کدگذاری(پاسخ)
    سرچاپ "به سبک نشانی:"، پرس‌وجو.کدگذاری سفارشی(پاسخ، پرس‌وجو.گزینه‌های پرس‌وجو { فاصله پلاس = نادرست })
پایان
