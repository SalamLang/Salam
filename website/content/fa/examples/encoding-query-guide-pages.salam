واردسازی کدگذاری.پرس‌وجو
واردسازی رشته

تابع پیوند صفحه(کنونی: رشته، صفحه: صحیح): رشته:
    ناپایا ن := پرس‌وجو.کدگشایی(کنونی)
    پرس‌وجو.تنظیم(ن، "page"، رشته.از عدد(صفحه))
    برگشت "/products?" + پرس‌وجو.کدگذاری(ن)
پایان

تابع ریشه:
    کنونی := "category=books&sort=price&tag=new&tag=sale&page=2"
    سرچاپ "قبلی:"، پیوند صفحه(کنونی، ۱)
    سرچاپ "بعدی:"، پیوند صفحه(کنونی، ۳)
    سرچاپ "نخستین بازدید:"، پیوند صفحه("category=books"، ۲)
پایان
