واردسازی کدگذاری.پرس‌وجو

تابع ریشه:
    پرسش := "q=green+tea&brand=nik&brand=pars&min=20&page=3&limit=500"

    واژه‌ها := پرس‌وجو.مقدار(پرسش، "q")
    ناپایا صفحه := ۱
    اگر پرس‌وجو.دارد(پرسش، "page"):
        صفحه = پرس‌وجو.مقدار(پرسش، "page").به صحیح()
    پایان
    ناپایا اندازه صفحه := ۲۰
    اگر پرس‌وجو.دارد(پرسش، "limit"):
        اندازه صفحه = پرس‌وجو.مقدار(پرسش، "limit").به صحیح()
    پایان
    اگر صفحه < ۱: صفحه = ۱ پایان
    اگر اندازه صفحه < ۱ یا اندازه صفحه > ۱۰۰: اندازه صفحه = ۱۰۰ پایان
    برندها := پرس‌وجو.همه مقدارها(پرسش، "brand")

    سرچاپ "جستجوی:"، واژه‌ها
    سرچاپ "برندها:"، برندها.طول()، برندها
    سرچاپ "کمترین قیمت:"، پرس‌وجو.مقدار(پرسش، "min").به صحیح()
    سرچاپ "ردیف‌های"، (صفحه - ۱) * اندازه صفحه + ۱، "تا"، صفحه * اندازه صفحه
پایان
