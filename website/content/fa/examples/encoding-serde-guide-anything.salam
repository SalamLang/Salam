واردسازی کدگذاری.تبدیل قالب

تابع به جیسون(متن: رشته): رشته:
    نوع قالب := تبدیل قالب.تشخیص قالب(متن)
    اگر نوع قالب == "":
        برگشت "(قالب ناشناخته)"
    پایان
    تلاش:
        برگشت نوع قالب + " -> " + تبدیل قالب.تبدیل قالب سخت گیرانه(متن، نوع قالب، "json")
    گرفتن خطا خ:
        برگشت "(خواندن " + نوع قالب + " نشد: " + خ.پیام + ")"
    پایان
پایان

تابع ریشه:
    سرچاپ به جیسون("name: shop\nport: 8080\n")
    سرچاپ به جیسون("name = \"shop\"\nport = 8080\n")
    سرچاپ به جیسون("name,port\nshop,8080\n")
    سرچاپ به جیسون(`{"name": "shop", "port": 8080}`)
    سرچاپ به جیسون("")
پایان
