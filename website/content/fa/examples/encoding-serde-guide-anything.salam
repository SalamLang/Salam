واردسازی کدگذاری.تبدیل قالب

تابع به جیسون(متن: رشته): رشته:
    نوع قالب := تبدیل قالب.تشخیص قالب(متن)
    اگر نوع قالب == "":
        برگشت "(قالب ناشناخته)"
    پایان
    ناپایا شد := نادرست
    خروجی := تبدیل قالب.تبدیل قالب سخت گیرانه(متن، نوع قالب، "json"، شد)
    اگر وارونه شد:
        برگشت "(خواندن " + نوع قالب + " نشد)"
    پایان
    برگشت نوع قالب + " -> " + خروجی
پایان

تابع ریشه:
    سرچاپ به جیسون("name: shop\nport: 8080\n")
    سرچاپ به جیسون("name = \"shop\"\nport = 8080\n")
    سرچاپ به جیسون("name,port\nshop,8080\n")
    سرچاپ به جیسون(`{"name": "shop", "port": 8080}`)
    سرچاپ به جیسون("")
پایان
