واردسازی کدگذاری.تبدیل قالب

تابع آزمودن(برچسب: رشته، داده: رشته، از قالب: رشته، به قالب: رشته):
    تلاش:
        سرچاپ برچسب، "درست:"، تبدیل قالب.تبدیل قالب سخت گیرانه(داده، از قالب، به قالب)
    گرفتن خطا خ:
        سرچاپ برچسب، "شکست خورد:"، خ.نام نوع()، "->"، خ.به رشته()
    پایان
پایان

تابع ریشه:
    آزمودن("یامل درست     "، "- 1\n- 2\n"، "yaml"، "json")
    آزمودن("جیسون خراب    "، `{"a": 1`، "json"، "yaml")
    آزمودن("مبدأ ناشناخته "، `a = 1`، "ini"، "json")
    آزمودن("مقصد ناشناخته "، `{"a": 1}`، "json"، "ini")
    آزمودن("تامل جدول می‌خواهد"، `[1, 2]`، "json"، "toml")
    سرچاپ "نسخه‌ی آسان‌گیر [" + تبدیل قالب.تبدیل قالب(`{"a": 1`، "json"، "yaml") + "] می‌دهد"
پایان
