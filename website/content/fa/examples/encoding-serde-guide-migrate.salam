واردسازی کدگذاری.تبدیل قالب
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.مقدار
واردسازی کدگذاری.خطای کدگذاری

تابع ریشه:
    قدیمی := `server:
  host: 0.0.0.0
  port: 8080
log:
  level: info
`
    ناپایا شد := نادرست
    متن تامل := تبدیل قالب.تبدیل قالب سخت گیرانه(قدیمی، "yaml"، "toml"، شد)
    سرچاپ "تبدیل شد:"، شد
    چاپ متن تامل

    ناپایا خطا := خطای کدگذاری.بدون خطا()
    پیش := جیسون.کدگشایی(تبدیل قالب.تبدیل قالب(قدیمی، "yaml"، "json")، خطا)
    پس := جیسون.کدگشایی(تبدیل قالب.تبدیل قالب(متن تامل، "toml"، "json")، خطا)
    سرچاپ "همان داده:"، مقدار.یکسان است(پیش، پس)
