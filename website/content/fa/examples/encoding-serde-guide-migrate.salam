واردسازی کدگذاری.تبدیل قالب

تابع ریشه:
    قدیمی := `server:
  host: 0.0.0.0
  port: 8080
log:
  level: info
`
    ناپایا شد := نادرست
    متن تامل := تبدیل قالب.تبدیل قالب سخت گیرانه(قدیمی، "yaml"، "toml"، شد)
    سرچاپ "تبدیل شد:"، شد
    چاپ متن تامل

    برگشتی := تبدیل قالب.تبدیل قالب سخت گیرانه(متن تامل، "toml"، "json"، شد)
    سرچاپ "همان داده:"، برگشتی == تبدیل قالب.تبدیل قالب(قدیمی، "yaml"، "json")
پایان
