واردسازی کدگذاری.تبدیل قالب

تابع ریشه:
    سفارش := `{"@id": "1042", "customer": "Sara", "item": ["tea", "cups"], "total": 39}`
    ایکس := تبدیل قالب.تبدیل قالب(سفارش، "json"، "xml")
    سرچاپ ایکس
    سرچاپ "تشخیص:"، تبدیل قالب.تشخیص قالب(ایکس)
    سرچاپ تبدیل قالب.تبدیل قالب("<book lang=\"fa\"><title>Salam</title><pages>153</pages></book>"، "xml"، "json")
پایان
