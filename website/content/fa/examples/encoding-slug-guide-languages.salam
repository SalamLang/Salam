// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع نمایش(عنوان: رشته):
    سرچاپ اسلاگ.تشخیص خط(عنوان) + ":"، اسلاگ.ساخت(عنوان)
پایان

تابع ریشه:
    نمایش("Привет, мир! Щука и Ёж")
    نمایش("Київ Їжак Ґанок")
    نمایش("Ελληνικά: Καλημέρα κόσμε")
    نمایش("Ağaç ışık İstanbul şeker")
    نمایش("Zażółć gęślą jaźń Łódź")
    نمایش("Nguyễn Thị Minh Khai Đà Nẵng")
    نمایش("שלום עולם")
    نمایش("हिन्दी भारत नमस्ते")
    نمایش("สวัสดี ครับ")
    نمایش("こんにちは ラーメン")
    نمایش("안녕하세요 한국어")
    نمایش("你好 世界")
پایان
