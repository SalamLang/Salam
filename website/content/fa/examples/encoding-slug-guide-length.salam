// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع ریشه:
    عنوان := "How to build a fast and friendly web server in Salam"
    ناپایا وپتس := اسلاگ.گزینه ها {}
    وپتس = اسلاگ.گزینه های پیش فرض()
    سرچاپ اسلاگ.ساخت(عنوان)
    وپتس.بیشینه طول = 30
    سرچاپ اسلاگ.ساخت با گزینه(عنوان، وپتس)
    وپتس.بیشینه طول = 12
    سرچاپ اسلاگ.ساخت با گزینه(عنوان، وپتس)
    وپتس.بیشینه طول = 5
    سرچاپ اسلاگ.ساخت با گزینه("extraordinary"، وپتس)
    سرچاپ اسلاگ.ساخت با گزینه(عنوان، اسلاگ.آدرس وب())
پایان
