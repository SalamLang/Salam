// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع ریشه:
    عنوان := "The Quick Brown Fox & the Lazy Dog"
    سرچاپ اسلاگ.ساخت(عنوان)

    ناپایا وپتس := اسلاگ.گزینه ها {}
    وپتس.جداکننده = "_"
    سرچاپ اسلاگ.ساخت با گزینه(عنوان، وپتس)

    وپتس = اسلاگ.گزینه های پیش فرض()
    وپتس.حروف کوچک = نادرست
    سرچاپ اسلاگ.ساخت با گزینه(عنوان، وپتس)

    وپتس = اسلاگ.گزینه های پیش فرض()
    اسلاگ.افزودن کلمه های توقف(وپتس، "the a an and of")
    سرچاپ اسلاگ.ساخت با گزینه(عنوان، وپتس)

    وپتس = اسلاگ.گزینه های پیش فرض()
    وپتس.نمادها = نادرست
    سرچاپ اسلاگ.ساخت با گزینه(عنوان، وپتس)
    وپتس.زبان متن = "de"
    وپتس.نمادها = درست
    سرچاپ اسلاگ.ساخت با گزینه(عنوان، وپتس)

    وپتس = اسلاگ.گزینه های پیش فرض()
    اسلاگ.افزودن جایگزین(وپتس، "C++"، "cpp")
    اسلاگ.افزودن جایگزین(وپتس، "C#"، "csharp")
    سرچاپ اسلاگ.ساخت با گزینه("C++ versus C#"، وپتس)

    وپتس = اسلاگ.گزینه های پیش فرض()
    وپتس.نویسه های مجاز = "."
    سرچاپ اسلاگ.ساخت با گزینه("Report v1.2.final"، وپتس)

    وپتس = اسلاگ.گزینه های پیش فرض()
    وپتس.جایگزین خالی = "untitled"
    سرچاپ اسلاگ.ساخت با گزینه("???"، وپتس)
    اسلاگ.آزادسازی گزینه ها(وپتس)
پایان
