// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع ریشه:
    عنوان := "My Report: Q3 2026 (final).PDF"
    سرچاپ "default   "، اسلاگ.ساخت(عنوان)
    سرچاپ "url       "، اسلاگ.ساخت با گزینه(عنوان، اسلاگ.آدرس وب())
    سرچاپ "filename  "، اسلاگ.ساخت با گزینه(عنوان، اسلاگ.نام پرونده())
    سرچاپ "snake     "، اسلاگ.ساخت با گزینه(عنوان، اسلاگ.اسنیک())
    سرچاپ "identifier"، اسلاگ.ساخت با گزینه("9 lives of a cat"، اسلاگ.شناسه())
    سرچاپ "unicode   "، اسلاگ.ساخت با گزینه("Привет мир"، اسلاگ.یونیکد())
پایان
