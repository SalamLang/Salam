// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع ریشه:
    ناپایا وپتس := اسلاگ.گزینه ها {}
    وپتس = اسلاگ.یونیکد()
    سرچاپ اسلاگ.ساخت با گزینه("سلام دنیا، ۱۲۳ ك ي"، وپتس)
    سرچاپ اسلاگ.ساخت با گزینه("Привет, Мир!"، وپتس)
    سرچاپ اسلاگ.ساخت با گزینه("Crème Brûlée Ñandú"، وپتس)
    سرچاپ اسلاگ.ساخت با گزینه("你好 世界"، وپتس)
    وپتس.حروف کوچک = نادرست
    سرچاپ اسلاگ.ساخت با گزینه("Привет, Мир!"، وپتس)

    وپتس = اسلاگ.گزینه های پیش فرض()
    سرچاپ اسلاگ.ساخت با گزینه("abc 你好 def"، وپتس)
    وپتس.نگه داشتن هان = نادرست
    سرچاپ اسلاگ.ساخت با گزینه("abc 你好 def"، وپتس)
پایان
