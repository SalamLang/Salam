// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع تاکین(س: رشته): منطقی:
    برگشت س برابر "post" یا س برابر "post-2" یا س برابر "post-3"
پایان

تابع ریشه:
    سرچاپ اسلاگ.یکتا("fresh"، (س: رشته): برگشت تاکین(س) پایان)
    سرچاپ اسلاگ.یکتا("post"، (س: رشته): برگشت تاکین(س) پایان)
    سرچاپ اسلاگ.یکتا با جداکننده("post"، "_"، (س: رشته): برگشت تاکین(س) پایان)
    سرچاپ اسلاگ.شماره دار("post"، 7، "-")
پایان
