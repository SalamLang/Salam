// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع ریشه:
    سرچاپ اسلاگ.اسلاگ است("hello-world")
    سرچاپ اسلاگ.اسلاگ است("Hello World")
    سرچاپ اسلاگ.اسلاگ است("-hello-")
    سرچاپ اسلاگ.اسلاگ است("a--b")
    سرچاپ اسلاگ.اسلاگ است(اسلاگ.ساخت("Any title, any language: Привет"))

    سرچاپ اسلاگ.اسلاگ است با گزینه("hello_world"، اسلاگ.اسنیک())
    سرچاپ اسلاگ.اسلاگ است با گزینه("سلام-دنیا"، اسلاگ.یونیکد())
    سرچاپ اسلاگ.اسلاگ است با گزینه("9lives"، اسلاگ.شناسه())
