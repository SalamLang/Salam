واردسازی کدگذاری.تامل

تابع بررسی(برچسب: رشته، متن: رشته):
    ناپایا سالم := نادرست
    _ := تامل.کدگشایی سخت گیرانه(متن، سالم)
    سرچاپ برچسب، سالم
پایان

تابع ریشه:
    بررسی("درست:              "، "a = 1\nb = 'two'\n")
    بررسی("بی مقدار:          "، "a = \n")
    بررسی("رشته‌ی بسته‌نشده:  "، "a = \"open\n")
    بررسی("آرایه‌ی بسته‌نشده: "، "a = [1, 2\n")
    بررسی("جدول بسته‌نشده:    "، "[server\nport = 1\n")
    بررسی("متن چندخطی:        "، "a = \"\"\"x\"\"\"\n")
    بررسی("کلید تکراری:       "، "a = 1\na = 2\n")
    بررسی("رشته‌ی بی‌نقل‌قول:  "، "mode = fast\n")
    سرچاپ "معتبر هم همین را می‌گوید:"، تامل.معتبر("a = 1")، تامل.معتبر("a = ")
پایان
