واردسازی کدگذاری.تامل
واردسازی کدگذاری.مقدار
واردسازی مرتب سازی

تابع ریشه:
    متن := `[package]
name = "shop"
version = "1.4.0"
authors = ["Sara", "Reza"]

[dependencies]
http = "2.1"
json = { version = "1.0", optional = true }
log = "0.9"

[[bin]]
name = "shop"
path = "src/main.salam"

[[bin]]
name = "shop-admin"
path = "src/admin.salam"
`
    ناپایا سالم := نادرست
    سند := تامل.کدگشایی سخت گیرانه(متن، سالم)
    اگر وارونه سالم:
        سرچاپ "تامل معتبر نیست"
        برگشت ۱
    پایان
    مشخصات := مقدار.مقدار کلید(سند، "package")
    سرچاپ مقدار.به رشته(مقدار.مقدار کلید(مشخصات، "name"))، مقدار.به رشته(مقدار.مقدار کلید(مشخصات، "version"))
    سرچاپ "نویسندگان:"، مقدار.طول آرایه(مقدار.مقدار کلید(مشخصات، "authors"))

    وابستگی‌ها := مقدار.مقدار کلید(سند، "dependencies")
    نام‌ها := مقدار.کلیدهای شیء(وابستگی‌ها)
    مرتب سازی.مرتب سازی سریع(نام‌ها)
    هر نام در نام‌ها:
        وابستگی := مقدار.مقدار کلید(وابستگی‌ها، نام)
        اگر مقدار.رشته است(وابستگی):
            سرچاپ "وابستگی"، نام، مقدار.به رشته(وابستگی)
        وگرنه:
            سرچاپ "وابستگی"، نام، مقدار.به رشته(مقدار.مقدار کلید(وابستگی، "version"))، "(اختیاری)"
        پایان
    پایان

    برنامه‌ها := مقدار.مقدار کلید(سند، "bin")
    تکرار مقدار.طول آرایه(برنامه‌ها) در ای:
        ب := مقدار.عضو آرایه(برنامه‌ها، ای)
        سرچاپ "برنامه"، مقدار.به رشته(مقدار.مقدار کلید(ب، "name"))، "از"، مقدار.به رشته(مقدار.مقدار کلید(ب، "path"))
    پایان
پایان
