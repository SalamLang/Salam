واردسازی کدگذاری.تامل
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

ساختار کارساز:
    @جیسون "host"
    همگانی میزبان: رشته = "127.0.0.1"
    @جیسون "port"
    همگانی درگاه: صحیح = ۸۰۰۰
پایان

ساختار تنظیمات:
    @جیسون "title"
    همگانی عنوان: رشته = ""
    @جیسون "debug"
    همگانی اشکال زدایی: منطقی = نادرست
    @جیسون "server"
    همگانی کارساز اصلی: کارساز = کارساز {}
    @جیسون "allowed"
    همگانی مجاز: وکتور<رشته> = وکتور {}
پایان

تابع ریشه:
    متن := `title = "Shop admin"
allowed = ["10.0.0.0/8", "192.168.1.0/24"]

[server]
port = 9090
`
    ناپایا سالم := نادرست
    سند := تامل.کدگشایی سخت گیرانه(متن، سالم)
    ناپایا ت := تنظیمات {}
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    اگر وارونه سالم یا وارونه جیسون.واسریال سازی آسان گیر(جیسون.کدگذاری پیش فرض(سند)، ت، خطا):
        سرچاپ "تنظیمات خراب است"
        برگشت ۱
    پایان
    سرچاپ ت.عنوان، "اشکال‌زدایی:"، ت.اشکال زدایی
    سرچاپ "گوش دادن روی"، ت.کارساز اصلی.میزبان، ت.کارساز اصلی.درگاه
    سرچاپ "شبکه‌های مجاز:"، ت.مجاز.طول()، ت.مجاز.بگیر(۰)
پایان
