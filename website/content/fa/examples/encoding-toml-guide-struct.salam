واردسازی کدگذاری.تامل
واردسازی کدگذاری.جیسون

ساختار کارساز:
    @جیسون "host"
    همگانی میزبان: رشته = "127.0.0.1"
    @جیسون "port"
    همگانی درگاه: صحیح = ۸۰۰۰
پایان

ساختار تنظیمات:
    @جیسون "title"
    همگانی عنوان: رشته = ""
    @جیسون "debug"
    همگانی اشکال زدایی: منطقی = نادرست
    @جیسون "server"
    همگانی کارساز اصلی: کارساز = کارساز {}
    @جیسون "allowed"
    همگانی مجاز: وکتور<رشته> = وکتور {}
پایان

تابع ریشه:
    متن := `title = "Shop admin"
allowed = ["10.0.0.0/8", "192.168.1.0/24"]

[server]
port = 9090
`
    ناپایا ت := تنظیمات {}
    تلاش:
        سند := تامل.کدگشایی(متن)
        جیسون.واسریال سازی آسان گیر(جیسون.کدگذاری پیش فرض(سند)، ت)
    گرفتن خطا خ:
        سرچاپ "تنظیمات خراب است:"، خ.به رشته()
        برگشت ۱
    پایان
    سرچاپ ت.عنوان، "اشکال‌زدایی:"، ت.اشکال زدایی
    سرچاپ "گوش دادن روی"، ت.کارساز اصلی.میزبان، ت.کارساز اصلی.درگاه
    سرچاپ "شبکه‌های مجاز:"، ت.مجاز.طول()، ت.مجاز.بگیر(۰)
پایان
