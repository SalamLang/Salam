واردسازی کدگذاری.تامل
واردسازی کدگذاری.مقدار

تابع نسخه پشتیبان(میزبان: رشته، وزن: صحیح): مقدار.مقدار:
    ناپایا نسخه := مقدار.شیء جدید()
    مقدار.تنظیم کلید(نسخه، "host"، مقدار.مقدار رشته(میزبان))
    مقدار.تنظیم کلید(نسخه، "weight"، مقدار.مقدار صحیح(وزن))
    برگشت نسخه
پایان

تابع ریشه:
    ناپایا پایگاه := مقدار.شیء جدید()
    مقدار.تنظیم کلید(پایگاه، "url"، مقدار.مقدار رشته("postgres://localhost/shop"))
    مقدار.تنظیم کلید(پایگاه، "pool"، مقدار.مقدار صحیح(۸))
    مقدار.تنظیم کلید(پایگاه، "timeout"، مقدار.مقدار اعشاری(۳۰.۰))
    مقدار.تنظیم کلید(پایگاه، "password"، مقدار.مقدار تهی())

    ناپایا نسخه‌ها := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(نسخه‌ها، نسخه پشتیبان("10.0.0.2"، ۲))
    مقدار.افزودن به آرایه(نسخه‌ها، نسخه پشتیبان("10.0.0.3"، ۱))
    مقدار.تنظیم کلید(پایگاه، "replicas"، نسخه‌ها)

    ناپایا ریشه داده := مقدار.شیء جدید()
    مقدار.تنظیم کلید(ریشه داده، "database"، پایگاه)

    ناپایا شد := نادرست
    متن := تامل.کدگذاری سخت گیرانه(ریشه داده، شد)
    سرچاپ "کدگذاری شد:"، شد
    چاپ متن

    برگشتی := مقدار.مقدار کلید(تامل.کدگشایی(متن)، "database")
    سرچاپ "timeout هنوز اعشاری است:"، مقدار.اعشاری است(مقدار.مقدار کلید(برگشتی، "timeout"))
    سرچاپ "password نوشته شد:"، مقدار.شیء دارد(برگشتی، "password")
    سرچاپ "نسخه‌های پشتیبان خوانده‌شده:"، مقدار.طول آرایه(مقدار.مقدار کلید(برگشتی، "replicas"))
پایان
