// زبان: فارسی
واردسازی کدگذاری.یولید

تابع ریشه:
    شناسه := یولید.جدید()
    متن := یولید.رشته(شناسه)
    سرچاپ "length:"، متن.طول()
    عقب := یولید.تجزیه(متن)
    سرچاپ "round trip:"، عقب.موفق و یولید.برابر است(عقب.شناسه، شناسه)
    سرچاپ "close to now:"، یولید.زمان شناسه(شناسه) - یولید.اکنون() کوچکتر 5000
    ستامپ := یولید.جدید برای(1469918176385)
    سرچاپ یولید.رشته(ستامپ.شناسه).طول()، یولید.زمان شناسه(ستامپ.شناسه)
پایان
