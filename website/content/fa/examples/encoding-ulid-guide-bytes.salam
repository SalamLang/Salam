// زبان: فارسی
واردسازی کدگذاری.یولید
واردسازی رشته

تابع هیکس(داده: وکتور<طبیعی۸>): رشته:
    دیگیتس := "0123456789abcdef"
    ناپایا ووت := ""
    تکرار داده.طول() در ی:
        کودی := داده.دریافت(ی) برگردان صحیح
        ووت = ووت + رشته.زیررشته(دیگیتس، کودی / 16، 1) + رشته.زیررشته(دیگیتس، کودی % 16، 1)
    پایان
    برگشت ووت
پایان

تابع ریشه:
    ر := یولید.تجزیه("01ARYZ6S41TSV4RRFFQ69G5FAV")
    راو := یولید.به بایت های یو یو آی دی(ر.شناسه)
    دیرکن راو.آزادکن()
    سرچاپ راو.طول()، هیکس(راو)
    عقب := یولید.از بایت های یو یو آی دی(راو)
    سرچاپ عقب.موفق، یولید.رشته(عقب.شناسه)

    ناپایا سیید := وکتور {} برگردان وکتور<طبیعی۸>
    دیرکن سیید.آزادسازی()
    تکرار 10 در ی:
        سیید.افزودن((ی * 3) برگردان طبیعی۸)
    پایان
    مادی := یولید.از اجزا(1469918176385، سیید)
    سرچاپ یولید.رشته(مادی.شناسه)
    پارت := یولید.بخش تصادفی(مادی.شناسه)
    دیرکن پارت.آزادکن()
    سرچاپ هیکس(پارت)
پایان
