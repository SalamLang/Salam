// زبان: فارسی
واردسازی کدگذاری.یولید

ناپایا فایلینگ := درست

تابع کلوکک(): صحیح۶۴:
    برگشت 5000
پایان

تابع سوورکی(): صحیح۶۴:
    اگر فایلینگ:
        برگشت -1
    پایان
    برگشت 123456
پایان

تابع ریشه:
    گ := یولید.تولیدکننده جدید با((): برگشت کلوکک() پایان، (): برگشت سوورکی() پایان)
    دیرکن یولید.آزادکن(گ)
    ر := یولید.بعدی(گ)
    سرچاپ ر.موفق، ر.خطا برابر یولید.خطای تصادف، یولید.متن خطا(ر.خطا)
    سرچاپ "state untouched:"، یولید.آخرین(گ).موفق
    فایلینگ = نادرست
    وک := یولید.بعدی(گ)
    سرچاپ وک.موفق، یولید.رشته(وک.شناسه)
پایان
