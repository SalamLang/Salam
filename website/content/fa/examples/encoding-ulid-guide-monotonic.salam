// زبان: فارسی
واردسازی کدگذاری.یولید

ناپایا اکنون مس := 1000 برگردان صحیح۶۴
ناپایا کهونک := 7 برگردان صحیح۶۴

تابع کلوکک(): صحیح۶۴:
    برگشت اکنون مس
پایان

تابع سوورکی(): صحیح۶۴:
    برگشت کهونک
پایان

تابع ریشه:
    گ := یولید.تولیدکننده جدید با((): برگشت کلوکک() پایان، (): برگشت سوورکی() پایان)
    دیرکن یولید.آزادکن(گ)
    تکرار 3:
        سرچاپ یولید.رشته(یولید.بعدی(گ).شناسه)
    پایان
    اکنون مس = 1001
    کهونک = 9
    سرچاپ یولید.رشته(یولید.بعدی(گ).شناسه)
    اکنون مس = 900
    آخر := یولید.بعدی(گ)
    سرچاپ "clock went back:"، یولید.زمان شناسه(آخر.شناسه)، یولید.رشته(آخر.شناسه)
    سرچاپ یولید.رشته(یولید.افزایش(آخر.شناسه).شناسه)
پایان
