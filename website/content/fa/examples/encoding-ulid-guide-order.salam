// زبان: فارسی
واردسازی کدگذاری.یولید

تابع ریشه:
    ناپایا یدس := وکتور {} برگردان وکتور<یولید.شناسه یولید>
    دیرکن یدس.آزادسازی()
    ناپایا مارک := 1700000000000 برگردان صحیح۶۴
    تکرار 4:
        یدس.افزودن(یولید.کمینه برای(مارک))
        مارک += 1500
    پایان
    تکرار یدس.طول() در ی:
        سرچاپ یولید.رشته(یدس.دریافت(ی))
    پایان

    لوو := یولید.کمینه برای(1700000001000)
    هیگه := یولید.بیشینه برای(1700000003000)
    سرچاپ "range:"، یولید.رشته(لوو)، یولید.رشته(هیگه)
    تکرار یدس.طول() در ی:
        ینسیدی := یولید.مقایسه(یدس.دریافت(ی)، لوو) بزرگتربرابر 0 و یولید.مقایسه(یدس.دریافت(ی)، هیگه) کوچکتربرابر 0
        سرچاپ ی، ینسیدی
    پایان
پایان
