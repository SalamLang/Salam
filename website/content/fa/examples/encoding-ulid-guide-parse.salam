// زبان: فارسی
واردسازی کدگذاری.یولید

تابع نمایش(متن: رشته):
    ر := یولید.تجزیه(متن)
    اگر ر.موفق:
        سرچاپ متن، "->"، یولید.زمان شناسه(ر.شناسه)، یولید.رشته(ر.شناسه)
    وگرنه:
        سرچاپ متن، "->"، یولید.متن خطا(ر.خطا)
    پایان
پایان

تابع ریشه:
    نمایش("01ARYZ6S41TSV4RRFFQ69G5FAV")
    نمایش("01aryz6s41tsv4rrffq69g5fav")
    نمایش("O1ARYZ6S41TSV4RRFFQ69G5FAV")
    نمایش("7ZZZZZZZZZZZZZZZZZZZZZZZZZ")
    نمایش("80000000000000000000000000")
    نمایش("01ARYZ6S41TSV4RRFFQ69G5FAU")
    نمایش("01ARYZ6S41")
    سرچاپ یولید.تجزیه سخت گیرانه("01aryz6s41tsv4rrffq69g5fav").موفق
    سرچاپ یولید.تجزیه سخت گیرانه("01ARYZ6S41TSV4RRFFQ69G5FAV").موفق
پایان
