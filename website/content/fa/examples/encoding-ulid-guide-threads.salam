// زبان: فارسی
واردسازی کدگذاری.یولید
واردسازی استخر
واردسازی حافظه

پایا وورکیرس := 8
پایا یاکه := 500

تابع ریشه:
    ووت := حافظه.تخصیص صفرشده((وورکیرس * یاکه * 3 * 8) برگردان طبیعی۶۴) برگردان صحیح۶۴*
    سهارید := یولید.پیش فرض()
    استخر.برای موازی(وورکیرس برگردان صحیح۶۴، 4 برگردان صحیح۶۴، (تاسک: صحیح۶۴):
        تکرار یاکه در ک:
            شناسه := یولید.جدید()
            سلوت := ((تاسک * یاکه + ک) * 3) برگردان صحیح
            ووت[سلوت] = شناسه.زمان
            ووت[سلوت + 1] = شناسه.بالا
            ووت[سلوت + 2] = شناسه.پایین
        پایان
    پایان)
    ناپایا سیین := نگاشت {} برگردان نگاشت<رشته، منطقی>
    دیرکن سیین.آزادسازی()
    تکرار وورکیرس * یاکه در ن:
        شناسه := یولید.شناسه یولید { زمان = ووت[ن * 3]، بالا = ووت[ن * 3 + 1]، پایین = ووت[ن * 3 + 2] }
        سیین.قراردادن(یولید.رشته(شناسه)، درست)
    پایان
    سرچاپ "ids:"، وورکیرس * یاکه، "distinct:"، سیین.اندازه()
    سرچاپ یولید.آخرین(سهارید).موفق
    حافظه.آزادسازی(ووت برگردان تهی*)
پایان
