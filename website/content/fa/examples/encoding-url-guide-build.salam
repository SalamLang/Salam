واردسازی کدگذاری.نشانی وب
واردسازی کدگذاری.پرس‌وجو

تابع ریشه:
    پوشه := "My Files"
    نام := "report 2026/Q3.pdf"
    ناپایا ن := نشانی وب.تجزیه نشانی("https://files.example.com")
    ن.مسیر = "/users/sara/" + نشانی وب.کدگذاری بخش مسیر(پوشه) + "/" + نشانی وب.کدگذاری بخش مسیر(نام)

    ناپایا پ := پرس‌وجو.نگاشت پرس‌وجو جدید()
    پرس‌وجو.تنظیم(پ، "download"، "1")
    پرس‌وجو.افزودن(پ، "tag"، "finance")
    پرس‌وجو.افزودن(پ، "tag"، "سه‌ماهه")
    نشانی وب.تنظیم پرس‌وجو(ن، پ)

    کامل := نشانی وب.متن(ن)
    سرچاپ کامل

    برگشتی := نشانی وب.تجزیه نشانی(کامل)
    سرچاپ "مسیر:"، نشانی وب.مسیر کدگشایی‌شده(برگشتی)
    سرچاپ "برچسب‌ها:"، پرس‌وجو.همه مقدارها(برگشتی.پرس‌وجوی خام، "tag")
پایان
