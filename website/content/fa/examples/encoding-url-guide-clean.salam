واردسازی کدگذاری.نشانی وب

تابع پاکسازی(خام: رشته): رشته:
    ناپایا ن := نشانی وب.تجزیه نشانی(خام)
    نام‌ها := نشانی وب.نام پارامترها(ن)
    هر نام در نام‌ها:
        اگر نام.شروع با("utm_") یا نام == "fbclid" یا نام == "gclid":
            _ := نشانی وب.حذف پارامتر(ن، نام)
        پایان
    پایان
    ن.قطعه = ""
    برگشت نشانی وب.متن(ن)
پایان

تابع ریشه:
    سرچاپ پاکسازی("https://shop.example/item/42?color=red&utm_source=news&utm_medium=email#reviews")
    سرچاپ پاکسازی("https://blog.example/post?fbclid=IwAR0abc")
    سرچاپ پاکسازی("https://example.com/search?q=salam%20lang&utm_campaign=fall&page=2&debug")
پایان
