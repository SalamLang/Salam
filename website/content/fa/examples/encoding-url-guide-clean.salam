واردسازی کدگذاری.نشانی وب

تابع پاکسازی(خام: رشته): رشته خطادار:
    ناپایا ن := تلاش نشانی وب.تجزیه نشانی(خام)
    نام‌ها := تلاش نشانی وب.نام پارامترها(ن)
    هر نام در نام‌ها:
        اگر نام.شروع با("utm_") یا نام == "fbclid" یا نام == "gclid":
            _ := تلاش نشانی وب.حذف پارامتر(ن، نام)
        پایان
    پایان
    ن.قطعه = ""
    برگشت نشانی وب.متن(ن)
پایان

تابع ریشه:
    پیوندها := ["https://shop.example/item/42?color=red&utm_source=news&utm_medium=email#reviews"، "https://blog.example/post?fbclid=IwAR0abc"، "https://example.com/search?q=salam%20lang&utm_campaign=fall&page=2&debug"، "https://example.com/sale?off=50%"]
    هر پیوند در پیوندها:
        تلاش:
            سرچاپ پاکسازی(پیوند)
        گرفتن خطا خ:
            سرچاپ "رد شد:"، خ.به رشته()
        پایان
    پایان
پایان
