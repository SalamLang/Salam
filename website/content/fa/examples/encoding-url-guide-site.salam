واردسازی کدگذاری.نشانی وب
واردسازی رشته

تابع هم پایگاه(الف: رشته، ب: رشته): منطقی:
    نا := نشانی وب.تجزیه نشانی(رشته.کوچک(الف))
    نب := نشانی وب.تجزیه نشانی(رشته.کوچک(ب))
    اگر نشانی وب.نشانی عددی است(نا) یا نشانی وب.نشانی عددی است(نب):
        برگشت نشانی وب.نام میزبان(نا) == نشانی وب.نام میزبان(نب)
    پایان
    برگشت نشانی وب.دامنه(نا) == نشانی وب.دامنه(نب)
پایان

تابع ریشه:
    ن := نشانی وب.تجزیه نشانی("https://api.eu.shop.example.co.uk:8443/v1/orders")
    سرچاپ "میزبان:"، نشانی وب.نام میزبان(ن)، "درگاه:"، ن.درگاه
    سرچاپ "دامنه:"، نشانی وب.دامنه(ن)، "پسوند:"، نشانی وب.پسوند عمومی(ن)، "زیردامنه:"، نشانی وب.زیردامنه(ن)

    سرچاپ هم پایگاه("https://www.example.com/a"، "https://login.example.com/b")
    سرچاپ هم پایگاه("https://WWW.Example.com/"، "https://example.com/cart")
    سرچاپ هم پایگاه("https://example.com/"، "https://example.org/")
    سرچاپ هم پایگاه("http://10.0.0.5:8080/"، "http://10.0.0.5/")
پایان
