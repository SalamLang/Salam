// زبان: فارسی
واردسازی کدگذاری.یو یو آی دی

تابع ریشه:
    شناسه := یو یو آی دی.تجزیه الزامی("f81d4fae-7dec-11d0-a765-00a0c91e6bf6")
    سهورت := یو یو آی دی.پایه۶۴ آدرس(شناسه)
    سرچاپ سهورت، سهورت.طول()
    سرچاپ یو یو آی دی.پایه۳۲(شناسه)
    عقب := یو یو آی دی.از پایه۶۴ آدرس(سهورت)
    سرچاپ عقب.موفق، یو یو آی دی.یکسان است(عقب.مقدار، شناسه)
    سرچاپ یو یو آی دی.از پایه۶۴ آدرس("too short").خطا
