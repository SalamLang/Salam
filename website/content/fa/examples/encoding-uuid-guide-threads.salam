// زبان: فارسی
واردسازی کدگذاری.یو یو آی دی
واردسازی حافظه
واردسازی استخر

پایا تعداد_کارگر := 8
پایا سهم_کارگر := 1000

ناپایا شناسه ها := پوچ برگردان طبیعی۶۴*

تابع تولید(کارگر: صحیح):
    تکرار سهم_کارگر در ی:
        شناسه := یو یو آی دی.ساخت نسخه۷()
        سلوت := (کارگر * سهم_کارگر + ی) * 2
        شناسه ها[سلوت] = شناسه.نیمه بالا
        شناسه ها[سلوت + 1] = شناسه.نیمه پایین
    پایان
پایان

تابع ریشه:
    شناسه ها = حافظه.تخصیص((تعداد_کارگر * سهم_کارگر * 16) برگردان طبیعی۶۴) برگردان طبیعی۶۴*
    تکرار تعداد_کارگر در کارگر:
        برو تولید(کارگر)
    پایان
    استخر.انتظار برو()
    ناپایا دیده شده := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن دیده شده.آزادسازی()
    تکرار تعداد_کارگر * سهم_کارگر در ی:
        دیده شده.قراردادن(یو یو آی دی.به متن فشرده(یو یو آی دی.شناسه { نیمه بالا = شناسه ها[ی * 2]، نیمه پایین = شناسه ها[ی * 2 + 1] })، 1)
    پایان
    سرچاپ "generated"، تعداد_کارگر * سهم_کارگر، "unique"، دیده شده.اندازه()
    حافظه.آزادسازی(شناسه ها برگردان تهی*)
پایان
