واردسازی کدگذاری.مقدار
واردسازی کدگذاری.جیسون

تابع بار(نام: رشته، رایانامه: رشته، سن: صحیح، برچسب‌ها: وکتور<رشته>): مقدار.مقدار:
    ناپایا م := مقدار.شیء جدید()
    مقدار.تنظیم کلید(م، "name"، مقدار.مقدار رشته(نام))
    اگر رایانامه != "":
        مقدار.تنظیم کلید(م، "email"، مقدار.مقدار رشته(رایانامه))
    پایان
    اگر سن > ۰:
        مقدار.تنظیم کلید(م، "age"، مقدار.مقدار صحیح(سن))
    پایان
    اگر برچسب‌ها.طول() > ۰:
        ناپایا آرایه := مقدار.آرایه جدید()
        هر ب در برچسب‌ها:
            مقدار.افزودن به آرایه(آرایه، مقدار.مقدار رشته(ب))
        پایان
        مقدار.تنظیم کلید(م، "tags"، آرایه)
    پایان
    برگشت م
پایان

تابع ریشه:
    گزینه‌ها := جیسون.گزینه‌های جیسون { چیدن کلیدها = درست }
    ناپایا برچسب‌ها := وکتور {} برگردان وکتور<رشته>
    سرچاپ جیسون.کدگذاری(بار("Sara"، ""، ۰، برچسب‌ها)، گزینه‌ها)
    برچسب‌ها.بیفزا("beta")
    برچسب‌ها.بیفزا("vip")
    سرچاپ جیسون.کدگذاری(بار("Reza"، "reza@example.com"، ۴۱، برچسب‌ها)، گزینه‌ها)
پایان
