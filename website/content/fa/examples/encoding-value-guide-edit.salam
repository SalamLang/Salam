واردسازی کدگذاری.مقدار
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

تابع قلم(کد کالا: رشته، تعداد: صحیح): مقدار.مقدار:
    ناپایا ق := مقدار.شیء جدید()
    مقدار.تنظیم کلید(ق، "sku"، مقدار.مقدار رشته(کد کالا))
    مقدار.تنظیم کلید(ق، "qty"، مقدار.مقدار صحیح(تعداد))
    برگشت ق
پایان

تابع ریشه:
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    ناپایا سفارش := جیسون.کدگشایی(`{"id": 1042, "customer": {"name": "Sara"}, "lines": [{"sku": "BK-01", "qty": 2}]}`، خطا)

    ناپایا مشتری := مقدار.مقدار کلید(سفارش، "customer")
    مقدار.تنظیم کلید(مشتری، "tier"، مقدار.مقدار رشته("gold"))

    ناپایا قلم‌ها := مقدار.مقدار کلید(سفارش، "lines")
    مقدار.افزودن به آرایه(قلم‌ها، قلم("PN-07"، ۱))
    سرچاپ "پیش از تنظیم کلید:"، مقدار.طول آرایه(مقدار.مقدار کلید(سفارش، "lines"))، "قلم"
    مقدار.تنظیم کلید(سفارش، "lines"، قلم‌ها)
    سرچاپ "پس از تنظیم کلید:"، مقدار.طول آرایه(مقدار.مقدار کلید(سفارش، "lines"))، "قلم"

    سرچاپ جیسون.کدگذاری(سفارش، جیسون.گزینه‌های جیسون { چیدن کلیدها = درست })

    شهر := مقدار.مقدار کلید(مقدار.مقدار کلید(سفارش، "shipping")، "city")
    سرچاپ "شهر ارسال داده شده:"، وارونه مقدار.تهی است(شهر)، "[" + مقدار.به رشته(شهر) + "]"
پایان
