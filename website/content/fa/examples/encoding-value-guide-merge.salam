واردسازی کدگذاری.مقدار
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

تابع ادغام(پایه: مقدار.مقدار، رو: مقدار.مقدار): مقدار.مقدار:
    اگر وارونه مقدار.شیء است(پایه) یا وارونه مقدار.شیء است(رو):
        برگشت مقدار.رونوشت مقدار(رو)
    پایان
    ناپایا نتیجه := مقدار.رونوشت مقدار(پایه)
    هر ک در مقدار.کلیدهای شیء(رو):
        تازه := مقدار.مقدار کلید(رو، ک)
        اگر مقدار.شیء دارد(نتیجه، ک):
            مقدار.تنظیم کلید(نتیجه، ک، ادغام(مقدار.مقدار کلید(نتیجه، ک)، تازه))
        وگرنه:
            مقدار.تنظیم کلید(نتیجه، ک، مقدار.رونوشت مقدار(تازه))
        پایان
    پایان
    برگشت نتیجه
پایان

تابع ریشه:
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    پیش فرض‌ها := جیسون.کدگشایی(`{"server": {"host": "0.0.0.0", "port": 8080}, "log": {"level": "info", "json": false}, "plugins": ["auth"]}`، خطا)
    پایگاه := جیسون.کدگشایی(`{"server": {"port": 9000}, "log": {"level": "debug"}, "plugins": ["auth", "cache"]}`، خطا)

    پیکر := ادغام(پیش فرض‌ها، پایگاه)
    سرچاپ جیسون.کدگذاری(پیکر، جیسون.گزینه‌های جیسون { تورفتگی = "  "، چیدن کلیدها = درست })
    سرچاپ "پیش‌فرض‌ها دست‌نخورده:"، مقدار.به صحیح(مقدار.مقدار کلید(مقدار.مقدار کلید(پیش فرض‌ها، "server")، "port"))
پایان
