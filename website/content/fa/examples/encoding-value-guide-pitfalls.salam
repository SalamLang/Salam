واردسازی کدگذاری.مقدار

تابع ریشه:
    ناپایا الف := مقدار.شیء جدید()
    مقدار.تنظیم کلید(الف، "n"، مقدار.مقدار صحیح(۱))

    ناپایا مشترک := الف
    مقدار.تنظیم کلید(مشترک، "n"، مقدار.مقدار صحیح(۲))
    سرچاپ "پس از ویرایش رونوشت ساده:"، مقدار.به صحیح(مقدار.مقدار کلید(الف، "n"))

    ناپایا جدا := مقدار.رونوشت مقدار(الف)
    مقدار.تنظیم کلید(جدا، "n"، مقدار.مقدار صحیح(۳))
    سرچاپ "پس از ویرایش رونوشت کامل:"، مقدار.به صحیح(مقدار.مقدار کلید(الف، "n"))

    سرچاپ "به صحیح ۲.۹:"، مقدار.به صحیح(مقدار.مقدار اعشاری(۲.۹))
    سرچاپ "به اعشاری ۳:"، مقدار.به اعشاری(مقدار.مقدار صحیح(۳))
    سرچاپ "به صحیح \"5\":"، مقدار.به صحیح(مقدار.مقدار رشته("5"))
    سرچاپ "۱ با ۱.۰ یکسان است:"، مقدار.یکسان است(مقدار.مقدار صحیح(۱)، مقدار.مقدار اعشاری(۱.۰))

    ناپایا یافت شد := نادرست
    _ := مقدار.مقدار کلید با وضعیت(الف، "missing"، یافت شد)
    سرچاپ "کلید نبوده یافت شد:"، یافت شد

    مقدار.آزادسازی مقدار(جدا)
پایان
