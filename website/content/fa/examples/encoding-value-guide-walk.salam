واردسازی کدگذاری.مقدار
واردسازی کدگذاری.جیسون
واردسازی مرتب سازی
واردسازی رشته

تابع پیمودن(م: مقدار.مقدار، مسیر: رشته):
    اگر مقدار.شیء است(م):
        کلیدها := مقدار.کلیدهای شیء(م)
        مرتب سازی.مرتب سازی سریع(کلیدها)
        هر ک در کلیدها:
            پیمودن(مقدار.مقدار کلید(م، ک)، مسیر + "." + ک)
        پایان
    وگرنه مقدار.آرایه است(م):
        تکرار مقدار.طول آرایه(م) در ای:
            پیمودن(مقدار.عضو آرایه(م، ای)، مسیر + "[" + رشته.از عدد(ای) + "]")
        پایان
    وگرنه:
        سرچاپ مسیر، "="، مقدار.رشته اشکال زدایی(م)
    پایان
پایان

تابع ریشه خطادار:
    سند := تلاش جیسون.کدگشایی(`{"order": 1042, "customer": {"name": "Sara", "vip": true}, "lines": [{"sku": "BK-01", "qty": 2}, {"sku": "PN-07", "qty": 1}], "note": null}`)
    پیمودن(سند، "$")
پایان
