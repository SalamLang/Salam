واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه:
    متن := `<app name="shop">
  <listen host="0.0.0.0" port="8080"/>
  <plugin name="auth" enabled="true"/>
  <plugin name="cache" enabled="false"/>
  <plugin name="search"/>
</app>`
    ناپایا سالم := نادرست
    برنامه := اکس‌ام‌ال.کدگشایی سخت گیرانه(متن، سالم)
    اگر وارونه سالم:
        سرچاپ "پیکربندی خوش‌ساخت نیست"
        برگشت ۱
    پایان
    سرچاپ "برنامه:"، اکس‌ام‌ال.ویژگی گره(برنامه، "name")
    شنود := اکس‌ام‌ال.فرزند(برنامه، "listen")
    اگر اکس‌ام‌ال.پیدا شد(شنود):
        سرچاپ "گوش دادن:"، اکس‌ام‌ال.ویژگی گره(شنود، "host") + ":" + اکس‌ام‌ال.ویژگی گره(شنود، "port")
    پایان
    افزونه‌ها := اکس‌ام‌ال.فرزندان(برنامه، "plugin")
    هر ا در افزونه‌ها.گره‌ها:
        ناپایا روشن := درست
        اگر اکس‌ام‌ال.دارای ویژگی(ا، "enabled"):
            روشن = اکس‌ام‌ال.ویژگی گره(ا، "enabled") == "true"
        پایان
        سرچاپ "افزونه"، اکس‌ام‌ال.ویژگی گره(ا، "name")، "روشن:"، روشن
    پایان
    سرچاپ "عنصر cache دارد:"، اکس‌ام‌ال.پیدا شد(اکس‌ام‌ال.فرزند(برنامه، "cache"))
پایان
