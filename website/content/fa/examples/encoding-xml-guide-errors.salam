واردسازی کدگذاری.اکس‌ام‌ال

تابع بررسی(برچسب: رشته، متن: رشته):
    تلاش:
        ناپایا سند := اکس‌ام‌ال.تجزیه(متن)
        سرچاپ برچسب، "درست"
        اکس‌ام‌ال.آزادسازی(سند)
    گرفتن خطا خ:
        سرچاپ برچسب، "خط " + خ.خط + "، ستون " + خ.ستون + ":"، خ.پیام
    پایان
پایان

تابع ریشه:
    بررسی("درست:          "، "<a><b>1</b></a>")
    بررسی("ناجور:         "، "<a>\n  <b>1</a>")
    بررسی("دو ریشه:       "، "<a/><b/>")
    بررسی("موجودیت بد:    "، "<a>&nope;</a>")
    بررسی("& بی‌گریز:      "، "<a>salt & pepper</a>")
    سرچاپ "بررسی سریع:"، اکس‌ام‌ال.خوش‌ساخت است("<x/>")، اکس‌ام‌ال.خوش‌ساخت است("<x>")
    سرچاپ "متن گریزانده:"، اکس‌ام‌ال.اسکیپ متن("salt & pepper")
پایان
