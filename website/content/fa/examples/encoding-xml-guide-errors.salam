واردسازی کدگذاری.اکس‌ام‌ال

تابع بررسی(برچسب: رشته، متن: رشته):
    ناپایا خطا := اکس‌ام‌ال.بدون خطا()
    ناپایا سند := اکس‌ام‌ال.تجزیه(متن، خطا)
    اگر خطا.موفق:
        سرچاپ برچسب، "درست"
    وگرنه:
        سرچاپ برچسب، اکس‌ام‌ال.متن خطا(خطا)
    پایان
    اکس‌ام‌ال.آزادسازی(سند)
پایان

تابع ریشه:
    بررسی("درست:          "، "<a><b>1</b></a>")
    بررسی("ناجور:         "، "<a>\n  <b>1</a>")
    بررسی("دو ریشه:       "، "<a/><b/>")
    بررسی("موجودیت بد:    "، "<a>&nope;</a>")
    بررسی("& بی‌گریز:      "، "<a>salt & pepper</a>")
    ناپایا خطا := اکس‌ام‌ال.بدون خطا()
    سرچاپ "بررسی سریع:"، اکس‌ام‌ال.خوش‌ساخت است("<x/>"، خطا)، اکس‌ام‌ال.خوش‌ساخت است("<x>"، خطا)
    سرچاپ "متن گریزانده:"، اکس‌ام‌ال.اسکیپ متن("salt & pepper")
پایان
