واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه:
    خوراک := `<feed xmlns="http://www.w3.org/2005/Atom" xmlns:m="http://search.yahoo.com/mrss/">
  <title>Salam videos</title>
  <entry>
    <title>Install Salam</title>
    <m:thumbnail url="https://cdn.example/install.jpg"/>
  </entry>
  <entry>
    <title>Your first web server</title>
    <m:thumbnail url="https://cdn.example/server.jpg"/>
  </entry>
</feed>`
    ناپایا خطا := اکس‌ام‌ال.بدون خطا()
    ناپایا سند := اکس‌ام‌ال.تجزیه(خوراک، خطا)
    اگر وارونه خطا.موفق:
        سرچاپ اکس‌ام‌ال.متن خطا(خطا)
        برگشت ۱
    پایان
    بالا := اکس‌ام‌ال.گره سند(سند)
    سرچاپ "مدخل‌ها با نام:      "، اکس‌ام‌ال.انتخاب عدد(سند، بالا، "count(//entry)"، خطا)
    سرچاپ "با پیشوند m:        "، اکس‌ام‌ال.انتخاب عدد(سند، بالا، "count(//m:thumbnail)"، خطا)
    سرچاپ "با پیشوند media:    "، اکس‌ام‌ال.انتخاب عدد(سند، بالا، "count(//media:thumbnail)"، خطا)

    پرسش := "//*[local-name() = 'thumbnail' and namespace-uri() = 'http://search.yahoo.com/mrss/']"
    ناپایا تصویرها := اکس‌ام‌ال.انتخاب(سند، بالا، پرسش، خطا)
    هر ت در تصویرها.شناسه‌ها:
        سرچاپ اکس‌ام‌ال.نام(سند، ت)، "نام محلی:"، اکس‌ام‌ال.نام محلی(سند، ت)، "->"، اکس‌ام‌ال.مقدار ویژگی(سند، ت، "url")
    پایان
    اکس‌ام‌ال.آزادسازی فهرست(تصویرها)

    ریشه سند := اکس‌ام‌ال.عنصر ریشه(سند)
    سرچاپ "فضای نام ریشه:"، اکس‌ام‌ال.نشانی فضای نام(سند، ریشه سند)
    اکس‌ام‌ال.آزادسازی(سند)
پایان
