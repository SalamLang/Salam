واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه خطادار:
    خوراک := `<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>Salam blog</title>
    <item>
      <title>Salam 0.5.5 is out</title>
      <link>https://example.com/posts/055</link>
      <category>release</category>
    </item>
    <item>
      <title>Writing a JSON API</title>
      <link>https://example.com/posts/json-api</link>
      <category>tutorial</category>
    </item>
    <item>
      <title>The Persian keywords</title>
      <link>https://example.com/posts/persian</link>
      <category>tutorial</category>
    </item>
  </channel>
</rss>`
    ناپایا سند := تلاش اکس‌ام‌ال.تجزیه(خوراک)
    بالا := اکس‌ام‌ال.گره سند(سند)
    سرچاپ "خوراک:"، تلاش اکس‌ام‌ال.انتخاب رشته(سند، بالا، "/rss/channel/title")
    سرچاپ "نوشته‌ها:"، تلاش اکس‌ام‌ال.انتخاب عدد(سند، بالا، "count(//item)")

    ناپایا آموزشی := تلاش اکس‌ام‌ال.انتخاب(سند، بالا، "//item[category = 'tutorial']")
    هر گره در آموزشی.شناسه‌ها:
        سرچاپ "-"، تلاش اکس‌ام‌ال.انتخاب رشته(سند، گره، "title")، "<" + تلاش اکس‌ام‌ال.انتخاب رشته(سند، گره، "link") + ">"
    پایان
    اکس‌ام‌ال.آزادسازی فهرست(آموزشی)
    اکس‌ام‌ال.آزادسازی(سند)
پایان
