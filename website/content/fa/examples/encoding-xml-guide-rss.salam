واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه:
    خوراک := `<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0">
  <channel>
    <title>Salam blog</title>
    <item>
      <title>Salam 0.5.5 is out</title>
      <link>https://example.com/posts/055</link>
      <category>release</category>
    </item>
    <item>
      <title>Writing a JSON API</title>
      <link>https://example.com/posts/json-api</link>
      <category>tutorial</category>
    </item>
    <item>
      <title>The Persian keywords</title>
      <link>https://example.com/posts/persian</link>
      <category>tutorial</category>
    </item>
  </channel>
</rss>`
    ناپایا خطا := اکس‌ام‌ال.بدون خطا()
    ناپایا سند := اکس‌ام‌ال.تجزیه(خوراک، خطا)
    اگر وارونه خطا.موفق:
        سرچاپ "خوراک خراب است:"، اکس‌ام‌ال.متن خطا(خطا)
        برگشت ۱
    پایان
    بالا := اکس‌ام‌ال.گره سند(سند)
    سرچاپ "خوراک:"، اکس‌ام‌ال.انتخاب رشته(سند، بالا، "/rss/channel/title"، خطا)
    سرچاپ "نوشته‌ها:"، اکس‌ام‌ال.انتخاب عدد(سند، بالا، "count(//item)"، خطا)

    ناپایا آموزشی := اکس‌ام‌ال.انتخاب(سند، بالا، "//item[category = 'tutorial']"، خطا)
    هر گره در آموزشی.شناسه‌ها:
        سرچاپ "-"، اکس‌ام‌ال.انتخاب رشته(سند، گره، "title"، خطا)، "<" + اکس‌ام‌ال.انتخاب رشته(سند، گره، "link"، خطا) + ">"
    پایان
    اکس‌ام‌ال.آزادسازی فهرست(آموزشی)
    اکس‌ام‌ال.آزادسازی(سند)
پایان
