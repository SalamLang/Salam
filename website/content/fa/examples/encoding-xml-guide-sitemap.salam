واردسازی کدگذاری.اکس‌ام‌ال

تابع افزودن نشانی(سند &: اکس‌ام‌ال.سند، پدر: صحیح، جا: رشته، تغییر: رشته):
    ن := اکس‌ام‌ال.ساخت عنصر(سند، "url")
    اکس‌ام‌ال.افزودن فرزند(سند، پدر، ن)
    ج := اکس‌ام‌ال.ساخت عنصر(سند، "loc")
    اکس‌ام‌ال.افزودن فرزند(سند، ن، ج)
    اکس‌ام‌ال.افزودن فرزند(سند، ج، اکس‌ام‌ال.ساخت متن(سند، جا))
    ت := اکس‌ام‌ال.ساخت عنصر(سند، "lastmod")
    اکس‌ام‌ال.افزودن فرزند(سند، ن، ت)
    اکس‌ام‌ال.افزودن فرزند(سند، ت، اکس‌ام‌ال.ساخت متن(سند، تغییر))
پایان

تابع ریشه:
    ناپایا سند := اکس‌ام‌ال.سند جدید()
    بن := اکس‌ام‌ال.ساخت عنصر(سند، "urlset")
    اکس‌ام‌ال.افزودن فرزند(سند، اکس‌ام‌ال.گره سند(سند)، بن)
    اکس‌ام‌ال.تنظیم ویژگی(سند، بن، "xmlns"، "http://www.sitemaps.org/schemas/sitemap/0.9")

    افزودن نشانی(سند، بن، "https://example.com/"، "2026-10-01")
    افزودن نشانی(سند، بن، "https://example.com/search?q=tea&page=2"، "2026-10-12")

    ناپایا گزینه‌ها := اکس‌ام‌ال.گزینه‌های نوشتن پیش فرض()
    گزینه‌ها.اعلان = درست
    گزینه‌ها.تورفتگی = "  "
    چاپ اکس‌ام‌ال.نوشتن سفارشی(سند، گزینه‌ها)
    اکس‌ام‌ال.آزادسازی(سند)
پایان
