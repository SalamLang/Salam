واردسازی کدگذاری.اکس‌ام‌ال
واردسازی رشته

تابع ریشه:
    خوراک := `<products>
  <product sku="TEA-01" stock="14"><name>Green tea</name><price>4.50</price></product>
  <product sku="CUP-02" stock="0"><name>Glass cup</name><price>7.25</price></product>
  <product sku="POT-03" stock="3"><name>Tea pot &amp; lid</name><price>21.00</price></product>
</products>`
    ناپایا خوان := اکس‌ام‌ال.نشانه‌خوان جدید(خوراک)
    ناپایا کد کالا := ""
    ناپایا درون نام := نادرست
    ناپایا کالاها := ۰
    ناپایا ناموجود := ۰
    ناپایا تمام := نادرست
    تا وارونه تمام:
        ن := اکس‌ام‌ال.نشانه بعدی(خوان)
        اگر ن.kind == اکس‌ام‌ال.نشانه اتمام:
            تمام = درست
        وگرنه ن.kind == اکس‌ام‌ال.نشانه آغاز عنصر و ن.tag == "product":
            کالاها += ۱
            کد کالا = ن.attrs.بگیر("sku")
            اگر ن.attrs.بگیر("stock") == "0": ناموجود += ۱ پایان
        وگرنه ن.kind == اکس‌ام‌ال.نشانه آغاز عنصر و ن.tag == "name":
            درون نام = درست
        وگرنه ن.kind == اکس‌ام‌ال.نشانه انتهای عنصر و ن.tag == "name":
            درون نام = نادرست
        وگرنه ن.kind == اکس‌ام‌ال.نشانه متن و درون نام:
            سرچاپ کد کالا، "یعنی"، رشته.پیرایش(ن.text)
        پایان
    پایان
    سرچاپ کالاها، "کالا،"، ناموجود، "ناموجود"
پایان
