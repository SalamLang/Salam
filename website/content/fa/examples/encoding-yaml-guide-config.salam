واردسازی کدگذاری.یامل

تابع تنظیم(متن: رشته، مسیر: رشته، پیش فرض: رشته): رشته:
    اگر یامل.دارد(متن، مسیر):
        برگشت یامل.دریافت(متن، مسیر)
    پایان
    برگشت پیش فرض
پایان

تابع ریشه:
    متن := `# settings for the shop
server:
  host: 0.0.0.0
  port: 8080
  workers: 4
log:
  level: debug
features:
  search: true
  beta: false
`
    ناپایا لازم := وکتور {} برگردان وکتور<رشته>
    لازم.بیفزا("server")
    لازم.بیفزا("log")
    اگر وارونه یامل.دارد کلیدها(متن، لازم):
        سرچاپ "یکی از بخش‌های پیکربندی نیست"
        برگشت ۱
    پایان

    سرچاپ "گوش دادن روی"، یامل.دریافت(متن، "server.host") + ":" + یامل.دریافت(متن، "server.port")
    سرچاپ "کارگرها:"، یامل.دریافت عدد(متن، "server.workers")
    سرچاپ "سطح گزارش:"، تنظیم(متن، "log.level"، "info")
    سرچاپ "پرونده‌ی گزارش:"، تنظیم(متن، "log.file"، "stdout")
    سرچاپ "جستجو روشن:"، یامل.دریافت منطقی(متن، "features.search")، "آزمایشی روشن:"، یامل.دریافت منطقی(متن، "features.beta")
    سرچاپ "پرچم‌های ویژگی:"، یامل.کلیدها(متن، "features")
پایان
