واردسازی کدگذاری.یامل
واردسازی رشته

تابع ریشه:
    متن := `jobs:
  - name: lint
    run: salam format --check
  - name: test
    run: sh tests/run.sh
    needs: [lint]
  - name: deploy
    run: sh deploy.sh
    needs: [test]
    branch: main
`
    تعداد := یامل.طول(متن، "jobs")
    سرچاپ تعداد، "کار"
    تکرار تعداد در ای:
        جا := "jobs[" + رشته.از عدد(ای) + "]"
        سطر := یامل.دریافت(متن، جا + ".name") + ": " + یامل.دریافت(متن، جا + ".run")
        اگر یامل.دارد(متن، جا + ".needs"):
            سرچاپ سطر، "(پس از"، یامل.دریافت(متن، جا + ".needs[0]") + ")"
        وگرنه:
            سرچاپ سطر
        پایان
        اگر یامل.دارد(متن، جا + ".branch"):
            سرچاپ "  فقط روی"، یامل.دریافت(متن، جا + ".branch")
        پایان
    پایان
پایان
