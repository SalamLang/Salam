واردسازی کدگذاری.یامل

تابع ریشه:
    متن := `kind: Deployment
metadata:
  name: web
spec:
  replicas: 3
---
kind: Service
metadata:
  name: web
spec:
  port: 80
---
kind: ConfigMap
metadata:
  name: web-config
`
    اسناد := یامل.تفکیک کردن اسناد(متن)
    سرچاپ اسناد.طول()، "سند"
    هر سند در اسناد:
        سرچاپ "-"، یامل.دریافت(سند، "kind")، یامل.دریافت(سند، "metadata.name")، "معتبر:"، یامل.معتبر(سند)
    پایان
    سرچاپ "Deployment به شکل جیسون:"، یامل.به جیسون(اسناد.بگیر(۰))
پایان
