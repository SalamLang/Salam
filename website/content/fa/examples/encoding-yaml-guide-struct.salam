واردسازی کدگذاری.یامل
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

ساختار سرویس:
    @جیسون "name"
    همگانی نام: رشته = ""
    @جیسون "image"
    همگانی تصویر: رشته = ""
    @جیسون "replicas"
    همگانی نسخه‌ها: صحیح = ۱
    @جیسون "ports"
    همگانی درگاه‌ها: وکتور<صحیح> = وکتور {}
پایان

تابع ریشه:
    متن := `name: api
image: shop/api:2.3
ports:
  - 80
  - 443
`
    ناپایا س := سرویس {}
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    اگر وارونه جیسون.واسریال سازی آسان گیر(یامل.به جیسون(متن)، س، خطا):
        سرچاپ "سرویس خراب است:"، خطا.پیام
        برگشت ۱
    پایان
    سرچاپ س.نام، "این تصویر را اجرا می‌کند:"، س.تصویر
    سرچاپ "نسخه‌ها:"، س.نسخه‌ها
    سرچاپ "درگاه‌ها:"، س.درگاه‌ها.طول()، س.درگاه‌ها.بگیر(۰)، س.درگاه‌ها.بگیر(۱)
پایان
