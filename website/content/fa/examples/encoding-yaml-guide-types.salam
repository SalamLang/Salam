واردسازی کدگذاری.یامل
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

ساختار محدودیت‌ها:
    @جیسون "max_upload"
    همگانی بیشترین بارگذاری: صحیح۶۴ = ۰
    @جیسون "public"
    همگانی عمومی: منطقی = نادرست
    @جیسون "code"
    همگانی کد: رشته = ""
پایان

تابع بارگذاری(متن: رشته):
    ناپایا م := محدودیت‌ها {}
    ناپایا خطا := خطای کدگذاری.بدون خطا()
    اگر جیسون.واسریال سازی آسان گیر(یامل.به جیسون(متن)، م، خطا):
        سرچاپ "  بارگذاری شد:"، م.بیشترین بارگذاری، م.عمومی، م.کد
    وگرنه:
        سرچاپ "  رد شد:"، خطا.پیام
    پایان
پایان

تابع ریشه:
    متن := "max_upload: 5368709120\npublic: yes\ncode: 007\n"
    سرچاپ "public از نوع"، یامل.نوع(متن، "public")، "است، پس دریافت منطقی می‌گوید"، یامل.دریافت منطقی(متن، "public")
    سرچاپ "code از نوع"، یامل.نوع(متن، "code")، "است با متن"، یامل.دریافت(متن، "code")
    سرچاپ "دریافت عدد سرریز می‌کند:"، یامل.دریافت عدد(متن، "max_upload")
    سرچاپ "به شکل جیسون:"، یامل.به جیسون(متن)
    بارگذاری(متن)
    بارگذاری("max_upload: 5368709120\npublic: true\ncode: \"007\"\n")
پایان
