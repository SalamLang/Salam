    دارد(مقدار: ت)
    هیچ
پایان

روال تقسیم(الف: صحیح، ب: صحیح): شاید<صحیح>:
    اگر ب == ۰:
        برگشت شاید.هیچ
    پایان
    برگشت شاید.دارد(الف / ب)
پایان

روال شرح(ش: شاید<صحیح>): رشته:
    برگشت همخوان ش:
        دارد(م): "حاصل " + م پایان
        هیچ: "تقسیم بر صفر" پایان
    پایان
پایان

روال ریشه:
    سرچاپ شرح(تقسیم(۱۰، ۲))
    سرچاپ شرح(تقسیم(۱، ۰))
