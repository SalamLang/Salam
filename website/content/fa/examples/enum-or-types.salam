واردسازی رشته

تابع تنظیم(متن: رشته): صحیح یا منطقی یا رشته:
    اگر متن == "درست" یا متن == "نادرست":
        برگشت متن == "درست"
    پایان
    ع := متن.به صحیح()
    اگر رشته.از عدد(ع برگردان صحیح۶۴) == متن:
        برگشت ع
    پایان
    برگشت متن
پایان

تابع توصیف(م: صحیح یا منطقی یا رشته): رشته:
    برگشت همخوان م:
        صحیح ع: "عدد " + رشته.از عدد(ع برگردان صحیح۶۴) پایان
        منطقی ب: "کلید " + (ب ? "روشن" : "خاموش") پایان
        رشته س: "متن " + س پایان
    پایان
پایان

تابع ریشه:
    هر متن در ["8080"، "درست"، "لوکال‌هاست"]:
        سرچاپ توصیف(تنظیم(متن))
    پایان
پایان
