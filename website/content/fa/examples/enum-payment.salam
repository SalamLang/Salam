جداشمار پرداخت:
    نقدی
    کارت(چهاررقم: رشته، مبلغ: صحیح)
    بن(کد: رشته)
پایان

روال برچسب(پ: پرداخت): رشته:
    برگشت همخوان پ:
        نقدی: "نقدی" پایان
        کارت(رقم‌ها، _): "کارت با پایان " + رقم‌ها پایان
        بن ب: "بن " + ب.کد پایان
    پایان
پایان

روال ریشه:
    پرداخت‌ها := [پرداخت.نقدی، پرداخت.کارت("۴۲۴۲"، ۱۲۰)، پرداخت.بن("بهار")]
    هر پ در پرداخت‌ها:
        سرچاپ پ.نام()، "->"، برچسب(پ)
    پایان
    سرچاپ پرداخت.کارت("۴۲۴۲"، ۱۲۰) == پرداخت‌ها[۱]، پرداخت‌ها[۰] == پرداخت‌ها[۲]
    سرچاپ "شمار روش‌های پرداخت:"، پرداخت.شمار()
پایان
