واردسازی محیط
واردسازی رشته

ساختار پیکربندی:
    همگانی میزبان: رشته = ""
    همگانی درگاه: صحیح۶۴ = ۰
    همگانی کارگرها: صحیح۶۴ = ۰
    همگانی اشکال زدایی: منطقی = نادرست
    همگانی نشانی پایگاه: رشته = ""
    همگانی کلید: رشته = ""
پایان

تابع خواندن پیکربندی(): پیکربندی:
    برگشت پیکربندی {
        میزبان = محیط.دریافت با پیش فرض("APP_HOST"، "127.0.0.1")،
        درگاه = محیط.دریافت صحیح("APP_PORT"، ۸۰۸۰)،
        کارگرها = محیط.دریافت صحیح("APP_WORKERS"، ۴)،
        اشکال زدایی = محیط.دریافت منطقی("APP_DEBUG"، نادرست)،
        نشانی پایگاه = محیط.دریافت با پیش فرض("APP_DB_URL"، "sqlite://app.db")،
        کلید = محیط.دریافت("APP_API_KEY")
    }
پایان

تابع ریشه:
    محیط.تنظیم("APP_PORT"، "9000")
    محیط.تنظیم("APP_DEBUG"، "yes")
    محیط.تنظیم("APP_API_KEY"، "sk-test-1234567890")
    محیط.حذف("APP_HOST")
    محیط.حذف("APP_WORKERS")
    محیط.حذف("APP_DB_URL")
    پ := خواندن پیکربندی()
    سرچاپ "گوش می‌دهد روی"، پ.میزبان + ":" + رشته.از عدد(پ.درگاه برگردان صحیح)
    سرچاپ "کارگرها:"، پ.کارگرها، "اشکال‌زدایی:"، پ.اشکال زدایی
    سرچاپ "پایگاه داده:"، پ.نشانی پایگاه
    سرچاپ "کلید API:"، محیط.پوشاندن(پ.کلید)
    اگر پ.کلید.طول() برابر ۰: سرچاپ "هشدار: APP_API_KEY تنظیم نشده است" پایان
پایان
