واردسازی محیط
واردسازی ورودی خروجی

تابع ریشه:
    ورودی خروجی.نوشتن پرونده(".env"، "# تنظیمات محلی\nexport APP_NAME=\"فروشگاه سلام\"\nAPP_PORT=8080\nAPP_URL=http://localhost:${APP_PORT}\nAPP_GREETING='سلام ${APP_NAME}'\nEMPTY=\n")
    محیط.تنظیم("APP_PORT"، "3000")
    سرچاپ "خوانده شد:"، محیط.بارگذاری(".env")
    سرچاپ محیط.دریافت("APP_NAME")
    سرچاپ محیط.دریافت("APP_PORT")
    سرچاپ محیط.دریافت("APP_URL")
    سرچاپ محیط.دریافت("APP_GREETING")
    سرچاپ محیط.دارد("EMPTY")، "[" + محیط.دریافت("EMPTY") + "]"، محیط.دریافت با پیش فرض("EMPTY"، "جایگزین")
پایان
