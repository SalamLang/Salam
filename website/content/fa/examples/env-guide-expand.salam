واردسازی محیط

تابع ریشه:
    محیط.تنظیم("DB_USER"، "shop")
    محیط.تنظیم("DB_NAME"، "orders")
    محیط.حذف("DB_HOST")
    محیط.حذف("DB_PORT")
    الگو := "postgres://${DB_USER}@${DB_HOST:-localhost}:${DB_PORT:-5432}/${DB_NAME}"
    سرچاپ محیط.گسترش(الگو)
    محیط.تنظیم("DB_HOST"، "db.example.com")
    سرچاپ محیط.گسترش(الگو)
    سرچاپ محیط.گسترش("تعریف‌نشده: [${NOT_SET_ANYWHERE}]")
پایان
