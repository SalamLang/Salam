واردسازی محیط
واردسازی ورودی خروجی

تابع ریشه:
    ورودی خروجی.نوشتن پرونده(".env"، "DB_HOST=localhost\nLOG_LEVEL=debug\nCACHE=off\n")
    ورودی خروجی.نوشتن پرونده(".env.local"، "DB_HOST=127.0.0.1\n")
    ورودی خروجی.نوشتن پرونده(".env.production"، "DB_HOST=db.internal\nLOG_LEVEL=warn\n")
    ورودی خروجی.نوشتن پرونده(".env.production.local"، "LOG_LEVEL=error\n")
    محیط.تنظیم("SALAM_ENV"، "production")
    محیط.تنظیم("CACHE"، "on")
    سرچاپ "نمایه:"، محیط.نمایه()، محیط.تولید است()
    سرچاپ "بارگذاری شد:"، محیط.بارگذاری نمایه(".")
    سرچاپ "DB_HOST ="، محیط.دریافت("DB_HOST")
    سرچاپ "LOG_LEVEL ="، محیط.دریافت("LOG_LEVEL")
    سرچاپ "CACHE ="، محیط.دریافت("CACHE")
پایان
