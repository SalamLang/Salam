واردسازی خطا

تابع خواندن پرونده(مسیر: رشته، اشکال &: خطا.خطا):
    ناپایا خ := خطا.جدید در(خطا.ورودی خروجی، "اجازه‌ی خواندن " + مسیر + " نیست"، "fs.read_file")
    دیرکن خطا.آزادسازی(خ)
    اشکال = خطا.با فراداده(خ، "مسیر"، مسیر)
پایان

تابع بارگذاری تنظیمات(اشکال &: خطا.خطا):
    ناپایا درونی := خطا.خالی()
    خواندن پرونده("/etc/shop/config.yaml"، درونی)
    دیرکن خطا.آزادسازی(درونی)
    اگر وارونه خطا.بدون خطا(درونی):
        اشکال = خطا.پیچیدن در(درونی، "تنظیمات بارگذاری نشد"، "config.load")
        برگشت
    پایان
    اشکال = خطا.خالی()
پایان

تابع راه‌اندازی(اشکال &: خطا.خطا):
    ناپایا درونی := خطا.خالی()
    بارگذاری تنظیمات(درونی)
    دیرکن خطا.آزادسازی(درونی)
    اگر وارونه خطا.بدون خطا(درونی):
        اشکال = خطا.پیچیدن با نوع(درونی، خطا.داخلی، "فروشگاه راه نیفتاد")
        برگشت
    پایان
    اشکال = خطا.خالی()
پایان

تابع ریشه:
    ناپایا اشکال := خطا.خالی()
    راه‌اندازی(اشکال)
    دیرکن خطا.آزادسازی(اشکال)
    سرچاپ خطا.قالب(اشکال)
    سرچاپ "نوع:"، خطا.نوع(اشکال)
    سرچاپ "علت ریشه‌ای:"، خطا.پیام ریشه(اشکال)
    سرچاپ "خطای ورودی خروجی بوده:"، خطا.است(اشکال، خطا.ورودی خروجی)
    سرچاپ "قابل تکرار:"، خطا.قابل تکرار است(اشکال)
پایان
