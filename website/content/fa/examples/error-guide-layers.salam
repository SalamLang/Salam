واردسازی خطا
واردسازی رشته

تابع بارگیری کاربر(شناسه: صحیح، اشکال &: خطا.خطا): رشته:
    اگر شناسه <= ۰:
        اشکال = خطا.جدید(خطا.آرگومان نامعتبر، "شناسه باید مثبت باشد")
        برگشت ""
    پایان
    اگر شناسه != ۷:
        اشکال = خطا.با فراداده(خطا.جدید(خطا.یافت نشد، "چنین کاربری نیست")، "شناسه"، رشته.از عدد(شناسه))
        برگشت ""
    پایان
    اشکال = خطا.خالی()
    برگشت "لیلا"
پایان

تابع خوشامد(شناسه: صحیح، اشکال &: خطا.خطا): رشته:
    ناپایا درونی := خطا.خالی()
    نام := بارگیری کاربر(شناسه، درونی)
    اگر وارونه خطا.بدون خطا(درونی):
        اشکال = خطا.پیچیدن(درونی، "ساختن خوشامد ممکن نشد")
        برگشت ""
    پایان
    اشکال = خطا.خالی()
    برگشت "خوش برگشتی، " + نام
پایان

تابع وضعیت برای(خ: خطا.خطا): صحیح:
    اگر خطا.بدون خطا(خ): برگشت ۲۰۰ پایان
    اگر خطا.یافت نشد است(خ): برگشت ۴۰۴ پایان
    اگر خطا.آرگومان نامعتبر است(خ): برگشت ۴۰۰ پایان
    برگشت ۵۰۰
پایان

تابع ریشه:
    هر شناسه در [۷، ۳، -۱]:
        ناپایا اشکال := خطا.خالی()
        متن := خوشامد(شناسه، اشکال)
        وضعیت := وضعیت برای(اشکال)
        اگر خطا.بدون خطا(اشکال):
            سرچاپ وضعیت، متن
        وگرنه:
            سرچاپ وضعیت، خطا.پیام(اشکال)
            اگر خطا.فراداده(اشکال، "شناسه") != "":
                سرچاپ "    شناسه‌ی ناموجود:"، خطا.فراداده(اشکال، "شناسه")
            پایان
        پایان
    پایان
پایان
