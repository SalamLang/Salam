تابع بارگیری کاربر(شناسه: صحیح): رشته خطادار:
    اگر شناسه <= ۰:
        پرتاب خطا خطا.جدید(نوع خطا.آرگومان نامعتبر، "شناسه باید مثبت باشد")
    پایان
    اگر شناسه != ۷:
        پرتاب خطا خطا.جدید(نوع خطا.یافت نشد، "چنین کاربری نیست").با کد("user." + شناسه)
    پایان
    برگشت "لیلا"
پایان

تابع خوشامد(شناسه: صحیح): رشته خطادار:
    تلاش:
        برگشت "خوش برگشتی، " + بارگیری کاربر(شناسه)
    گرفتن خطا خ:
        پرتاب خطا خ.بپیچ("ساختن پیام خوشامد ممکن نشد")
    پایان
پایان

تابع وضعیت برای(خ: خطا): صحیح:
    اگر خ.است(نوع خطا.یافت نشد):
        برگشت ۴۰۴
    وگرنه خ.است(نوع خطا.آرگومان نامعتبر):
        برگشت ۴۰۰
    پایان
    برگشت ۵۰۰
پایان

تابع ریشه:
    هر شناسه در [7، 3، -1]:
        تلاش:
            سرچاپ ۲۰۰، خوشامد(شناسه)
        گرفتن خطا خ:
            سرچاپ وضعیت برای(خ)، خ.به رشته()
            اگر خ.کد != "":
                سرچاپ "    کد:"، خ.کد
            پایان
        پایان
    پایان
پایان
