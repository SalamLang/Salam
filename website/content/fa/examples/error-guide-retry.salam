واردسازی خطاها
واردسازی همگام سازی

ناپایا شمار := ۰

تابع قیمت بگیر(): صحیح خطادار:
    شمار += ۱
    اگر شمار < ۳:
        پرتاب خطا خطا.جدید(نوع خطا.ناموجود، "سرویس قیمت شلوغ است")
    پایان
    برگشت ۴۲۰۰
پایان

تابع قیمت پایدار(): صحیح خطادار:
    ناپایا س := خطاها.سیاست تکرار جدید(۵، ۱۰، ۸۰)
    ناپایا دفعه := ۱
    تا درست:
        تلاش:
            برگشت قیمت بگیر()
        گرفتن خطا خ:
            اگر وارونه خطاها.باید تکرار شود(س، خ، دفعه):
                پرتاب خطا خ.بپیچ("پس از " + دفعه + " کوشش رها شد")
            پایان
            صبر := خطاها.تاخیر برای کوشش(س، دفعه)
            سرچاپ "کوشش"، دفعه، "ناموفق بود:"، خ.پیام، "| صبر"، صبر، "میلی‌ثانیه"
            همگام سازی.خواب میلی ثانیه(صبر)
        پایان
        دفعه += ۱
    پایان
پایان

تابع ریشه:
    تلاش:
        سرچاپ "قیمت:"، قیمت پایدار()
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
    پایان
    بد := خطا.جدید(نوع خطا.آرگومان نامعتبر، "کالای ناشناخته")
    ناپایا س := خطاها.سیاست تکرار جدید(۵، ۱۰، ۸۰)
    سرچاپ "درخواست بد دوباره امتحان شود؟"، خطاها.باید تکرار شود(س، بد، ۱)
پایان
