واردسازی خطا
واردسازی همگام سازی

ناپایا فراخوانی‌ها := ۰

تابع گرفتن قیمت(اشکال &: خطا.خطا): صحیح:
    فراخوانی‌ها += ۱
    اگر فراخوانی‌ها < ۳:
        اشکال = خطا.جدید(خطا.در دسترس نیست، "سرویس قیمت سرش شلوغ است")
        برگشت ۰
    پایان
    اشکال = خطا.خالی()
    برگشت ۴۲۰۰
پایان

تابع ریشه:
    ناپایا سیاست := خطا.سیاست تکرار جدید(۵، ۱۰، ۸۰)
    ناپایا تلاش := ۱
    ناپایا اشکال := خطا.خالی()
    ناپایا قیمت := گرفتن قیمت(اشکال)
    تا خطا.باید تکرار شود(سیاست، اشکال، تلاش):
        درنگ := خطا.تاخیر برای تلاش(سیاست، تلاش)
        سرچاپ "تلاش"، تلاش، "شکست خورد:"، خطا.پیام(اشکال)، "| صبر"، درنگ، "میلی‌ثانیه"
        همگام سازی.خواب میلی ثانیه(درنگ)
        تلاش += ۱
        قیمت = گرفتن قیمت(اشکال)
    پایان
    اگر خطا.بدون خطا(اشکال):
        سرچاپ "قیمت:"، قیمت، "پس از"، تلاش، "تلاش"
    وگرنه:
        سرچاپ "منصرف شد:"، خطا.قالب(اشکال)
    پایان
    درخواست بد := خطا.جدید(خطا.آرگومان نامعتبر، "کالای ناشناخته")
    سرچاپ "درخواست نادرست دوباره فرستاده شود؟"، خطا.باید تکرار شود(سیاست، درخواست بد، ۱)
پایان
