ساختار ثبت‌نام:
    همگانی رایانامه: رشته = ""
    همگانی سن: صحیح = ۰
    همگانی گذرواژه: رشته = ""
پایان

تابع بررسی(ث: ثبت‌نام): وکتور<خطا>:
    ناپایا مشکل‌ها := وکتور {} برگردان وکتور<خطا>
    اگر وارونه ث.رایانامه.دربردارد("@"):
        مشکل‌ها.بیفزا(خطا.جدید(نوع خطا.آرگومان نامعتبر، "رایانامه @ ندارد").با مسیر("رایانامه"))
    پایان
    اگر ث.سن < ۱۳:
        مشکل‌ها.بیفزا(خطا.جدید(نوع خطا.خارج از بازه، "دست‌کم باید ۱۳ سال داشته باشید").با مسیر("سن"))
    پایان
    اگر ث.گذرواژه.طول() < ۸:
        مشکل‌ها.بیفزا(خطا.جدید(نوع خطا.آرگومان نامعتبر، "گذرواژه خیلی کوتاه است").با مسیر("گذرواژه"))
    پایان
    برگشت مشکل‌ها
پایان

تابع ثبت(ث: ثبت‌نام): رشته خطادار:
    مشکل‌ها := بررسی(ث)
    اگر مشکل‌ها.طول() > ۰:
        پرتاب خطا خطا.جدید(نوع خطا.آرگومان نامعتبر، مشکل‌ها.طول() + " فیلد باید درست شود")
    پایان
    برگشت "خوش آمدی، " + ث.رایانامه
پایان

تابع ریشه:
    فرم := ثبت‌نام { رایانامه = "sara.example.com"، سن = ۱۱، گذرواژه = "abc" }
    مشکل‌ها := بررسی(فرم)
    سرچاپ مشکل‌ها.طول()، "مشکل:"
    هر م در مشکل‌ها:
        سرچاپ "  " + م.مسیر + ":"، م.پیام
    پایان
    تلاش:
        سرچاپ ثبت(فرم)
    گرفتن خطا خ:
        سرچاپ "ثبت نشد:"، خ.پیام
    پایان
    تلاش:
        سرچاپ ثبت(ثبت‌نام { رایانامه = "sara@example.com"، سن = ۳۰، گذرواژه = "به اندازه‌ی کافی بلند" })
    گرفتن خطا خ:
        سرچاپ "ثبت نشد:"، خ.پیام
    پایان
پایان
