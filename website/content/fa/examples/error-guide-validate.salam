واردسازی خطا

ساختار نام‌نویسی:
    همگانی رایانامه: رشته = ""
    همگانی سن: صحیح = ۰
    همگانی گذرواژه: رشته = ""
پایان

تابع بررسی(ث: نام‌نویسی): وکتور<خطا.خطا>:
    ناپایا مشکل‌ها := وکتور {} برگردان وکتور<خطا.خطا>
    اگر وارونه ث.رایانامه.دربردارد("@"):
        مشکل‌ها.بیفزا(خطا.با فراداده(خطا.جدید(خطا.آرگومان نامعتبر، "رایانامه @ ندارد")، "فیلد"، "رایانامه"))
    پایان
    اگر ث.سن < ۱۳:
        ناپایا آرگومان‌ها := وکتور {} برگردان وکتور<رشته>
        دیرکن آرگومان‌ها.آزادکن()
        آرگومان‌ها.بیفزا("۱۳")
        مشکل‌ها.بیفزا(خطا.با فراداده(خطا.جدید قالبی(خطا.آرگومان نامعتبر، "سن شما باید دست‌کم {} باشد"، آرگومان‌ها)، "فیلد"، "سن"))
    پایان
    اگر ث.گذرواژه.طول() < ۸:
        مشکل‌ها.بیفزا(خطا.با فراداده(خطا.جدید(خطا.آرگومان نامعتبر، "گذرواژه خیلی کوتاه است")، "فیلد"، "گذرواژه"))
    پایان
    برگشت مشکل‌ها
پایان

تابع ریشه:
    فرم := نام‌نویسی { رایانامه = "sara.example.com"، سن = ۱۱، گذرواژه = "abc" }
    مشکل‌ها := بررسی(فرم)
    سرچاپ مشکل‌ها.طول()، "مشکل:"
    هر م در مشکل‌ها:
        سرچاپ "  " + خطا.فراداده(م، "فیلد") + ":"، خطا.پیام(م)
    پایان
    سالم := بررسی(نام‌نویسی { رایانامه = "sara@example.com"، سن = ۳۰، گذرواژه = "به اندازه‌ی کافی بلند" })
    سرچاپ "فرم درست"، سالم.طول()، "مشکل دارد"
پایان
