واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    برای‌هرنویسنده := الستیک سرچ.زیرتجمیع‌ها(الستیک سرچ.تجمیع واژه‌ها("author"، 5)، الستیک سرچ.افزودن تجمیع(""، "avg_year"، الستیک سرچ.تجمیع میانگین("year")))
    ناپایا تجمیع‌ها := الستیک سرچ.افزودن تجمیع(""، "by_author"، برای‌هرنویسنده)
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "oldest"، الستیک سرچ.تجمیع کمینه("year"))
    سرچاپ الستیک سرچ.بدنه جستجو(الستیک سرچ.درخواست جستجو { size = 0، aggs = تجمیع‌ها })

    پاسخ := `{"hits":{"total":{"value":120,"relation":"eq"},"hits":[]},"aggregations":{"oldest":{"value":940.0},"by_author":{"buckets":[{"key":"ferdowsi","doc_count":70,"avg_year":{"value":1010.0}},{"key":"saadi","doc_count":50,"avg_year":{"value":1258.0}}]}}}`
    نتیجه := الستیک سرچ.تجزیه نتیجه جستجو(پاسخ)
    سرچاپ "oldest:"، الستیک سرچ.مقدار تجمیع(نتیجه، "oldest")
    هر د در الستیک سرچ.سطل‌های تجمیع(نتیجه، "by_author"):
        سرچاپ د.key، د.doc_count، الستیک سرچ.مقدار تجمیع در(د.raw، "avg_year")
    پایان
پایان
