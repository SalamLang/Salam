واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا ک := الستیک سرچ.اتصال("http://localhost:9200")
    ناپایا د := الستیک سرچ.دسته‌ای تازه()
    تکرار 10000 در ش:
        شناسه := رشته.از عدد(ش برگردان صحیح۶۴)
        الستیک سرچ.نمایه کردن دسته‌ای(د، "logs"، شناسه، `{"line":` + شناسه + `}`)
        اگر الستیک سرچ.طول دسته‌ای(د) برابر 1000:
            نتیجه := الستیک سرچ.اجرای دسته‌ای(ک، د)
            سرچاپ نتیجه.تعداد موفق، نتیجه.تعداد ناموفق
            الستیک سرچ.بازنشانی دسته‌ای(د)
        پایان
    پایان
    اگر الستیک سرچ.طول دسته‌ای(د) > 0:
        نتیجه := الستیک سرچ.اجرای دسته‌ای(ک، د)
        سرچاپ نتیجه.تعداد موفق، نتیجه.تعداد ناموفق
    پایان
    الستیک سرچ.تازه‌سازی(ک، "logs")
    سرچاپ الستیک سرچ.شمارش(ک، "logs"، "")
    الستیک سرچ.بستن(ک)
پایان
