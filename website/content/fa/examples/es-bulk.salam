واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا د := الستیک سرچ.دسته‌ای تازه()
    تکرار 3 در ش:
        شناسه := رشته.از عدد(ش برگردان صحیح۶۴)
        الستیک سرچ.نمایه کردن دسته‌ای(د، "logs"، شناسه، `{"line":` + شناسه + `,"level":"info"}`)
    پایان
    الستیک سرچ.به‌روزرسانی دسته‌ای(د، "logs"، "1"، `{"level":"warn"}`)
    الستیک سرچ.حذف دسته‌ای(د، "logs"، "2")
    سرچاپ الستیک سرچ.طول دسته‌ای(د)، "actions"
    چاپ الستیک سرچ.بدنه دسته‌ای(د)

    پاسخ := `{"took":5,"errors":true,"items":[{"index":{"_id":"0","status":201,"result":"created"}},{"index":{"_id":"1","status":201,"result":"created"}},{"index":{"_id":"2","status":201,"result":"created"}},{"update":{"_id":"1","status":200,"result":"updated"}},{"delete":{"_id":"2","status":429,"error":{"type":"es_rejected_execution_exception","reason":"queue is full"}}}]}`
    نتیجه := الستیک سرچ.تجزیه نتیجه دسته‌ای(پاسخ)
    سرچاپ نتیجه.succeeded، "ok,"، نتیجه.failed، "failed"
    هر قلم در نتیجه.items:
        اگر وارونه قلم.ok:
            سرچاپ "retry"، قلم.action، قلم.id، قلم.error_type
        پایان
    پایان
پایان
