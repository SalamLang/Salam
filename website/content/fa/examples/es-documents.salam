واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا ک := الستیک سرچ.اتصال("http://localhost:9200")
    طرح‌نگاشت := `{"mappings":{"properties":{"title":{"type":"text"},"author":{"type":"keyword"},"year":{"type":"integer"}}}}`
    اگر وارونه الستیک سرچ.نمایه موجود است(ک، "books"):
        الستیک سرچ.ایجاد نمایه(ک، "books"، طرح‌نگاشت)
    پایان

    نوشته := الستیک سرچ.نمایه کردن با گزینه(ک، "books"، "1"، `{"title":"Shahnameh","author":"ferdowsi","year":1010}`، الستیک سرچ.گزینه‌ها { refresh = الستیک سرچ.تازه‌سازی با انتظار })
    سرچاپ نوشته.ok، نوشته.result، نوشته.version

    س := الستیک سرچ.دریافت(ک، "books"، "1")
    اگر س.found:
        سرچاپ س.source
    پایان

    به‌روزشده := الستیک سرچ.به‌روزرسانی با گزینه(ک، "books"، "1"، `{"year":1011}`، الستیک سرچ.گزینه‌ها { if_seq_no = س.seq_no، if_primary_term = س.primary_term })
    اگر وارونه به‌روزشده.ok:
        سرچاپ "someone else changed it first:"، الستیک سرچ.نوع خطا(ک)
    پایان

    سرچاپ الستیک سرچ.موجود است(ک، "books"، "1")، الستیک سرچ.شمارش(ک، "books"، "")
    الستیک سرچ.حذف(ک، "books"، "1")
    الستیک سرچ.بستن(ک)
پایان
