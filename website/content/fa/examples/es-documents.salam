واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا ک := الستیک سرچ.اتصال("http://localhost:9200")
    طرح‌نگاشت := `{"mappings":{"properties":{"title":{"type":"text"},"author":{"type":"keyword"},"year":{"type":"integer"}}}}`
    اگر وارونه الستیک سرچ.نمایه موجود است(ک، "books"):
        الستیک سرچ.ایجاد نمایه(ک، "books"، طرح‌نگاشت)
    پایان

    نوشته := الستیک سرچ.نمایه کردن با گزینه(ک، "books"، "1"، `{"title":"Shahnameh","author":"ferdowsi","year":1010}`، الستیک سرچ.گزینه‌ها { تازه‌سازی = الستیک سرچ.تازه‌سازی با انتظار })
    سرچاپ نوشته.موفق، نوشته.نتیجه، نوشته.نسخه

    س := الستیک سرچ.دریافت(ک، "books"، "1")
    اگر س.یافت شد:
        سرچاپ س.منبع
    پایان

    به‌روزشده := الستیک سرچ.به‌روزرسانی با گزینه(ک، "books"، "1"، `{"year":1011}`، الستیک سرچ.گزینه‌ها { شرط شماره ترتیب = س.شماره ترتیب، شرط دوره اصلی = س.دوره اصلی })
    اگر وارونه به‌روزشده.موفق:
        سرچاپ "someone else changed it first:"، الستیک سرچ.نوع خطا(ک)
    پایان

    سرچاپ الستیک سرچ.موجود است(ک، "books"، "1")، الستیک سرچ.شمارش(ک، "books"، "")
    الستیک سرچ.حذف(ک، "books"، "1")
    الستیک سرچ.بستن(ک)
پایان
