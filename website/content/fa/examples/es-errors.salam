واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا پیکر := الستیک سرچ.پیکربندی { بیشینه کوشش مجدد = 3، مهلت میلی‌ثانیه = 5000، اتصال پایدار = درست }
    پیکر.گره‌ها.بیفزا("http://es-1:9200")
    پیکر.گره‌ها.بیفزا("http://es-2:9200")
    ناپایا ک := الستیک سرچ.کارخواه تازه(پیکر)
    نوشته := الستیک سرچ.ایجاد(ک، "books"، "1"، `{"title":"Shahnameh"}`)
    اگر وارونه نوشته.موفق:
        ترابرد الستیک سرچ.نوع خطا(ک):
            "version_conflict_engine_exception":
                سرچاپ "already there"
                بشکن
            پایان
            "":
                سرچاپ "no node answered:"، الستیک سرچ.خطا(ک)
                بشکن
            پایان
            وگرنه:
                سرچاپ الستیک سرچ.وضعیت(ک)، الستیک سرچ.خطا(ک)
            پایان
        پایان
    پایان
    پ := الستیک سرچ.انجام(ک، "GET"، "/_cat/indices?format=json"، "")
    سرچاپ پ.وضعیت، پ.بدنه
    الستیک سرچ.بستن(ک)
پایان
