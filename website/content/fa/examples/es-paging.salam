واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا ک := الستیک سرچ.اتصال("http://localhost:9200")
    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    ترتیب.بیفزا(الستیک سرچ.مرتب صعودی("year"))

    نقطه := الستیک سرچ.گشودن نقطه زمانی(ک، "books"، "1m")
    ناپایا نشانگر := ""
    ناپایا ادامه := درست
    تا ادامه:
        صفحه := الستیک سرچ.جستجو(ک، ""، الستیک سرچ.درخواست جستجو { اندازه = 500، مرتب‌سازی = ترتیب، شناسه نقطه زمانی = نقطه، مدت نگهداری نقطه زمانی = "1m"، نشانگر ادامه = نشانگر })
        اگر صفحه.یافته‌ها.طول() برابر 0:
            ادامه = نادرست
        وگرنه:
            هر یافته در صفحه.یافته‌ها:
                سرچاپ یافته.شناسه
            پایان
            نشانگر = صفحه.یافته‌ها.بگیر(صفحه.یافته‌ها.طول() - 1).مرتب‌سازی
        پایان
    پایان
    الستیک سرچ.بستن نقطه زمانی(ک، نقطه)
    الستیک سرچ.بستن(ک)
پایان
