واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا ک := الستیک سرچ.اتصال("http://localhost:9200")
    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    ترتیب.بیفزا(الستیک سرچ.مرتب صعودی("year"))
    ترتیب.بیفزا(الستیک سرچ.مرتب صعودی("_id"))

    نقطه := الستیک سرچ.گشودن نقطه زمانی(ک، "books"، "1m")
    ناپایا نشانگر := ""
    ناپایا ادامه := درست
    تا ادامه:
        صفحه := الستیک سرچ.جستجو(ک، ""، الستیک سرچ.درخواست جستجو { size = 500، sort = ترتیب، pit_id = نقطه، pit_keep_alive = "1m"، search_after = نشانگر })
        اگر صفحه.hits.طول() برابر 0:
            ادامه = نادرست
        وگرنه:
            هر یافته در صفحه.hits:
                سرچاپ یافته.id
            پایان
            نشانگر = صفحه.hits.بگیر(صفحه.hits.طول() - 1).sort
        پایان
    پایان
    الستیک سرچ.بستن نقطه زمانی(ک، نقطه)
    الستیک سرچ.بستن(ک)
پایان
