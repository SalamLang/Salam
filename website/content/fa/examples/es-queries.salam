واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا بایدها := وکتور {} برگردان وکتور<رشته>
    بایدها.بیفزا(الستیک سرچ.تطبیق("title"، "book of kings"))
    ناپایا پالایه := وکتور {} برگردان وکتور<رشته>
    پالایه.بیفزا(الستیک سرچ.بازه("year"، "900"، "1100"))
    پالایه.بیفزا(الستیک سرچ.نقیض(الستیک سرچ.واژه("status"، "draft")))
    پرس‌وجو := الستیک سرچ.پالایش شده(الستیک سرچ.همه شرط‌ها(بایدها)، پالایه)
    سرچاپ پرس‌وجو

    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    ترتیب.بیفزا(الستیک سرچ.مرتب نزولی("year"))
    ناپایا نمایان := وکتور {} برگردان وکتور<رشته>
    نمایان.بیفزا("title")
    نمایان.بیفزا("year")
    درخواست := الستیک سرچ.درخواست جستجو { query = پرس‌وجو، size = 10، sort = ترتیب، source = نمایان }
    سرچاپ الستیک سرچ.بدنه جستجو(درخواست)
پایان
