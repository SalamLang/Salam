واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    بدنه := `{"took":3,"hits":{"total":{"value":2,"relation":"eq"},"max_score":1.8,"hits":[{"_id":"1","_score":1.8,"_source":{"title":"Shahnameh","year":1010}},{"_id":"7","_score":0.9,"_source":{"title":"Garshasp-nama","year":1066}}]}}`
    نتیجه := الستیک سرچ.تجزیه نتیجه جستجو(بدنه)
