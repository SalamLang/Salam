واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا ک := الستیک سرچ.اتصال("http://localhost:9200")
    ناپایا فیلدها := وکتور {} برگردان وکتور<رشته>
    فیلدها.بیفزا("title")
    درخواست := الستیک سرچ.درخواست جستجو { query = الستیک سرچ.تطبیق("title"، "kings")، size = 5، highlight = الستیک سرچ.برجسته‌سازی(فیلدها) }
    نتیجه := الستیک سرچ.جستجو(ک، "books"، درخواست)
    اگر وارونه نتیجه.ok:
        سرچاپ "search failed:"، الستیک سرچ.خطا(ک)
        برگشت
    پایان
    سرچاپ نتیجه.total، "matches in"، نتیجه.took، "ms"
    هر یافته در نتیجه.hits:
        سرچاپ یافته.id، یافته.score، یافته.source، یافته.highlight
    پایان
    الستیک سرچ.بستن(ک)
پایان
