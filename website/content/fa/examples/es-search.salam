واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا ک := الستیک سرچ.اتصال("http://localhost:9200")
    ناپایا فیلدها := وکتور {} برگردان وکتور<رشته>
    فیلدها.بیفزا("title")
    درخواست := الستیک سرچ.درخواست جستجو { پرسمان = الستیک سرچ.تطبیق("title"، "kings")، اندازه = 5، برجسته‌سازی = الستیک سرچ.برجسته‌سازی(فیلدها) }
    نتیجه := الستیک سرچ.جستجو(ک، "books"، درخواست)
    اگر وارونه نتیجه.موفق:
        سرچاپ "search failed:"، الستیک سرچ.خطا(ک)
        برگشت
    پایان
    سرچاپ نتیجه.کل، "matches in"، نتیجه.زمان اجرا، "ms"
    هر یافته در نتیجه.یافته‌ها:
        سرچاپ یافته.شناسه، یافته.امتیاز، یافته.منبع، یافته.برجسته‌سازی
    پایان
    الستیک سرچ.بستن(ک)
پایان
