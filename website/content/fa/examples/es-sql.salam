واردسازی دیتابیس
واردسازی دیتابیس.الستیک سرچ

تابع نویسندگان(رابط: پویا دیتابیس.اتصال):
    ردیف‌ها := رابط.پرسمان("SELECT author, COUNT(*) AS books FROM books GROUP BY author ORDER BY author")
    تا ردیف‌ها.بعدی():
        سرچاپ ردیف‌ها.متن(0)، ردیف‌ها.عدد صحیح(1)
    پایان
    ردیف‌ها.بستن()
پایان

تابع ریشه:
    ناپایا ک := الستیک سرچ.اتصال("http://localhost:9200")
    ناپایا پارامترها := وکتور {} برگردان وکتور<رشته>
    پارامترها.بیفزا("1000")
    ناپایا ردیف‌ها := الستیک سرچ.اس کیو ال با پارامتر(ک، "SELECT title, year FROM books WHERE year > ? ORDER BY year"، پارامترها، 100)
    تا ردیف‌ها.بعدی():
        سرچاپ ردیف‌ها.متن(0)، ردیف‌ها.عدد صحیح(1)
    پایان
    ردیف‌ها.بستن()
    نویسندگان(الستیک سرچ.اتصال عمومی(ک))
    الستیک سرچ.بستن(ک)
پایان
