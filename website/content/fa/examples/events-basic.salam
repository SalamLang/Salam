    خاموش_خود := رویدادها.روی(عنصر، "x"، (ev: رویدادها.رویداد<صحیح>): note("x " + ev.داده) پایان)
    متغیر__adder := رویدادها.روی(عنصر، "x"، (_ev: رویدادها.رویداد<صحیح>):
