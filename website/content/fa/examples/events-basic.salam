    الف := رویدادها.روی(عنصر، "user.login"، (ev: رویدادها.رویداد<صحیح>): note("a " + ev.موضوع + " " + ev.داده) پایان)
    بافر_محلی := رویدادها.روی(عنصر، "user.*"، (ev: رویدادها.رویداد<صحیح>): note("b " + ev.موضوع + " " + ev.داده) پایان)
    متغیر__c := رویدادها.یک‌بار(عنصر، "user.login"، (ev: رویدادها.رویداد<صحیح>): note("once " + ev.داده) پایان)
    متغیر__d := رویدادها.روی همه(عنصر، (ev: رویدادها.رویداد<صحیح>): note("any " + ev.موضوع) پایان)
    متغیر__f := رویدادها.روی(عنصر، "order.#"، (ev: رویدادها.رویداد<صحیح>): note("order " + ev.موضوع) پایان)

