واردسازی رویدادها

ناپایا گذرگاه := رویدادها.جدید() برگردان رویدادها.انتشاردهنده<صحیح>
ناپایا ژرفا := 0

تابع ریشه:
    گذرگاه = رویدادها.جدید() برگردان رویدادها.انتشاردهنده<صحیح>
    _a := رویدادها.روی(گذرگاه، "count"، (ev: رویدادها.رویداد<صحیح>): سرچاپ "count"، ev.داده اگر ev.داده کوچکتر 3: ژرفا++ _n := رویدادها.انتشار(گذرگاه، "count"، ev.داده + 1) پایان پایان)
    _b := رویدادها.روی(گذرگاه، "count"، (ev: رویدادها.رویداد<صحیح>): اگر ev.داده برابر 3: _n := رویدادها.انتشار(گذرگاه، "done"، ev.داده) پایان پایان)
    _c := رویدادها.روی(گذرگاه، "done"، (ev: رویدادها.رویداد<صحیح>): سرچاپ "done at"، ev.داده پایان)

    سرچاپ "handlers called"، رویدادها.انتشار(گذرگاه، "count"، 1)
    سرچاپ "nested emits"، ژرفا
    رویدادها.آزادکن(گذرگاه)
