واردسازی رویدادها

ناپایا درآمد := 0
ناپایا بازرسی := 0

ساختار Order:
    همگانی id: صحیح = 0
    همگانی item: رشته = ""
    همگانی qty: صحیح = 0
پایان

تابع ریشه:
    گذرگاه := رویدادها.جدید() برگردان رویدادها.انتشاردهنده<Order>
    متغیر__a := رویدادها.روی(گذرگاه، "order.paid"، (ev: رویدادها.رویداد<Order>):
        درآمد += ev.داده.qty * 10
        سرچاپ "paid"، ev.داده.id، ev.داده.item
    پایان)
    متغیر__b := رویدادها.روی(گذرگاه، "order.cancelled"، (ev: رویدادها.رویداد<Order>):
        سرچاپ "cancelled"، ev.داده.id
    پایان)
    متغیر__c := رویدادها.روی همه(گذرگاه، (_ev: رویدادها.رویداد<Order>): بازرسی++ پایان)

    سرچاپ رویدادها.انتشار(گذرگاه، "order.paid"، Order { id = 1، item = "tea"، qty = 3 })
    سرچاپ رویدادها.انتشار(گذرگاه، "order.cancelled"، Order { id = 2 })
    سرچاپ رویدادها.انتشار(گذرگاه، "order.shipped"، Order { id = 1 })
    سرچاپ "revenue"، درآمد، "audited"، بازرسی
    رویدادها.آزادکن(گذرگاه)
پایان
