واردسازی رویدادها

ناپایا revenue := 0
ناپایا audited := 0

ساختار Order:
    همگانی id: صحیح = 0
    همگانی item: رشته = ""
    همگانی qty: صحیح = 0
پایان

تابع ریشه:
    bus := رویدادها.جدید() برگردان رویدادها.انتشاردهنده<Order>
    _a := رویدادها.روی(bus، "order.paid"، (ev: رویدادها.رویداد<Order>):
        revenue += ev.داده.qty * 10
        سرچاپ "paid"، ev.داده.id، ev.داده.item
    پایان)
    _b := رویدادها.روی(bus، "order.cancelled"، (ev: رویدادها.رویداد<Order>):
        سرچاپ "cancelled"، ev.داده.id
    پایان)
    _c := رویدادها.روی همه(bus، (_ev: رویدادها.رویداد<Order>): audited++ پایان)

    سرچاپ رویدادها.انتشار(bus، "order.paid"، Order { id = 1، item = "tea"، qty = 3 })
    سرچاپ رویدادها.انتشار(bus، "order.cancelled"، Order { id = 2 })
    سرچاپ رویدادها.انتشار(bus، "order.shipped"، Order { id = 1 })
    سرچاپ "revenue"، revenue، "audited"، audited
    رویدادها.آزادکن(bus)
پایان
