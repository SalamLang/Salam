واردسازی رویدادها

ناپایا clicks := 0

ساختار Panel:
    همگانی ids: وکتور<صحیح> = وکتور {}
پایان

تابع openPanel(bus: رویدادها.انتشاردهنده<رشته>): Panel:
    ناپایا p := Panel {}
    p.ids.بیفزا(رویدادها.روی(bus، "ui.click"، (_ev: رویدادها.رویداد<رشته>): clicks++ پایان))
    p.ids.بیفزا(رویدادها.روی(bus، "ui.key.*"، (_ev: رویدادها.رویداد<رشته>): clicks += 10 پایان))
    برگشت p
پایان

تابع closePanel(bus: رویدادها.انتشاردهنده<رشته>، p: Panel):
    هر id در p.ids:
        _ok := رویدادها.خاموش(bus، id)
    پایان
    p.ids.آزادکن()
پایان

تابع ریشه:
    bus := رویدادها.جدید() برگردان رویدادها.انتشاردهنده<رشته>
    p := openPanel(bus)
    سرچاپ "open"، رویدادها.تعداد(bus)، رویدادها.انتشار(bus، "ui.click"، "a")، رویدادها.انتشار(bus، "ui.key.enter"، "b")
    closePanel(bus، p)
    سرچاپ "closed"، رویدادها.تعداد(bus)، رویدادها.انتشار(bus، "ui.click"، "c")
    سرچاپ "clicks"، clicks
    رویدادها.آزادکن(bus)
پایان
