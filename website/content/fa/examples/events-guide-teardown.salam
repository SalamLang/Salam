واردسازی رویدادها

ناپایا کلیک‌ها := 0

ساختار Panel:
    همگانی ids: وکتور<صحیح> = وکتور {}
پایان

تابع بازکردن_پنل(گذرگاه: رویدادها.انتشاردهنده<رشته>): Panel:
    ناپایا ویژگی_محلی := Panel {}
    ویژگی_محلی.ids.بیفزا(رویدادها.روی(گذرگاه، "ui.click"، (_ev: رویدادها.رویداد<رشته>): کلیک‌ها++ پایان))
    ویژگی_محلی.ids.بیفزا(رویدادها.روی(گذرگاه، "ui.key.*"، (_ev: رویدادها.رویداد<رشته>): کلیک‌ها += 10 پایان))
    برگشت ویژگی_محلی
پایان

تابع بستن_پنل(گذرگاه: رویدادها.انتشاردهنده<رشته>، ویژگی_محلی: Panel):
    هر شناسه در ویژگی_محلی.ids:
        متغیر__ok := رویدادها.خاموش(گذرگاه، شناسه)
    پایان
    ویژگی_محلی.ids.آزادکن()
پایان

تابع ریشه:
    گذرگاه := رویدادها.جدید() برگردان رویدادها.انتشاردهنده<رشته>
    ویژگی_محلی := بازکردن_پنل(گذرگاه)
    سرچاپ "open"، رویدادها.تعداد(گذرگاه)، رویدادها.انتشار(گذرگاه، "ui.click"، "a")، رویدادها.انتشار(گذرگاه، "ui.key.enter"، "b")
    بستن_پنل(گذرگاه، ویژگی_محلی)
    سرچاپ "closed"، رویدادها.تعداد(گذرگاه)، رویدادها.انتشار(گذرگاه، "ui.click"، "c")
    سرچاپ "clicks"، کلیک‌ها
    رویدادها.آزادکن(گذرگاه)
پایان
