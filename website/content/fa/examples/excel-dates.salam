واردسازی اکسل
واردسازی زمان

تابع نمایش(برچسب: رشته، لحظه: صحیح۶۴):
    سرچاپ برچسب، زمان.سال جهانی(لحظه)، زمان.ماه جهانی(لحظه)، زمان.روز جهانی(لحظه)
پایان

تابع ریشه:
    آغاز := ۱۷۷۴۰۰۸۰۰۰ برگردان صحیح۶۴
    سررسید := ۱۷۷۵۱۳۱۲۰۰ برگردان صحیح۶۴
    ناپایا کتاب := اکسل.کتاب کار جدید()
    ناپایا برگه := کتاب.افزودن برگه("پروژه")
    برگه.تنظیم رشته(۰، ۰، "آغاز")
    برگه.تنظیم تاریخ(۰، ۱، آغاز)
    برگه.تنظیم رشته(۱، ۰، "پایان")
    برگه.تنظیم تاریخ(۱، ۱، سررسید)
    برگه.تنظیم فرمول(۲، ۱، "B2-B1"، اکسل.تبدیل زمان به سریال(سررسید) - اکسل.تبدیل زمان به سریال(آغاز))
    کتاب.ذخیره("plan.xlsx")
    ناپایا خوب := نادرست
    ناپایا خطا := ""
    ناپایا خوانده := اکسل.بازکردن("plan.xlsx"، خوب، خطا)
    برگه خوانده := خوانده.برگه("پروژه")
    سلول := برگه خوانده.دریافت سلول(۰، ۱)
    سرچاپ "گونه تاریخ است:"، سلول.نوع برابر اکسل.سلول تاریخ
    سرچاپ "عدد سریال:"، سلول.عدد
    نمایش("آغاز:"، اکسل.تبدیل سریال به زمان(سلول.عدد))
    نمایش("پایان:"، اکسل.تبدیل سریال به زمان(برگه خوانده.دریافت عدد(۱، ۱)))
    سرچاپ "روزهای میان دو تاریخ:"، برگه خوانده.دریافت عدد(۲، ۱)
    سرچاپ "سریال ۱۹۷۰-۰۱-۰۱:"، اکسل.تبدیل زمان به سریال(۰)
    خوانده.آزادسازی()
    کتاب.آزادسازی()
    برگشت ۰
پایان
