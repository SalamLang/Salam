واردسازی اکسل
واردسازی ورودی خروجی

تابع خروجی برگه‌ها(مسیر: رشته): صحیح:
    ناپایا خوب := نادرست
    ناپایا خطا := ""
    ناپایا کتاب := اکسل.بازکردن(مسیر، خوب، خطا)
    اگر خوب برابر نادرست:
        سرچاپ "باز نشد"، مسیر، ":"، خطا
        برگشت ۰
    پایان
    نام‌ها := کتاب.نام برگه‌ها()
    هر ی، نام در نام‌ها:
        مقصد := نام + ".csv"
        ورودی خروجی.نوشتن پرونده(مقصد، اکسل.برگه به سی‌اس‌وی(کتاب.برگه‌ها.بگیر(ی)))
        سرچاپ "نوشته شد"، مقصد
    پایان
    کتاب.آزادسازی()
    برگشت نام‌ها.طول()
پایان

تابع ریشه:
    ناپایا کتاب := اکسل.کتاب کار جدید()
    ناپایا کاربران := کتاب.افزودن برگه("users")
    کاربران.تنظیم رشته(۰، ۰، "نام")
    کاربران.تنظیم رشته(۰، ۱، "یادداشت")
    کاربران.تنظیم رشته(۱، ۰، "علی")
    کاربران.تنظیم رشته(۱، ۱، "چای دوست دارد, نه قهوه")
    ناپایا انبار := کتاب.افزودن برگه("stock")
    انبار.تنظیم رشته(۰، ۰، "کالا")
    انبار.تنظیم رشته(۰، ۱، "تعداد")
    انبار.تنظیم رشته(۱، ۰، "خودکار")
    انبار.تنظیم عدد صحیح(۱، ۱، ۴۰)
    اکسل.نوشتن اُدی‌اس(کتاب، "office.ods")
    سرچاپ "قالب ods است:"، اکسل.تشخیص قالب("office.ods") برابر اکسل.قالب اُدی‌اس
    سرچاپ "برگه‌های خروجی:"، خروجی برگه‌ها("office.ods")
    سرچاپ ورودی خروجی.خواندن پرونده("users.csv")
    سرچاپ ورودی خروجی.خواندن پرونده("stock.csv")
    سرچاپ "برگه‌های خروجی:"، خروجی برگه‌ها("nothing.xlsx")
    کتاب.آزادسازی()
    برگشت ۰
پایان
