واردسازی اکسل

تابع مقدار خانه(برگه: اکسل.برگه، ارجاع: رشته): رشته:
    ناپایا سطر := ۰
    ناپایا ستون := ۰
    اگر اکسل.تجزیه ارجاع سلول(ارجاع، سطر، ستون) برابر نادرست: برگشت "ارجاع نادرست" پایان
    اگر برگه.دارای سلول(سطر، ستون) برابر نادرست: برگشت "خالی" پایان
    برگشت برگه.دریافت رشته(سطر، ستون)
پایان

تابع ریشه:
    ناپایا برگه := اکسل.سی‌اس‌وی به برگه("سفارش,شهر,کالا\n101,تهران,خودکار\n102,تبریز,کتاب\n103,تهران,کتاب\n104,شیراز,خودکار\n"، "orders")
    سرچاپ "C3 ="، مقدار خانه(برگه، "C3")، "| A9 ="، مقدار خانه(برگه، "A9")، "| 3C ="، مقدار خانه(برگه، "3C")
    سطرها := برگه.پالایش سطرها(۱، "تهران")
    هر س در سطرها:
        سرچاپ "سفارش تهران"، برگه.دریافت رشته(س، ۰)، "کالا:"، برگه.دریافت رشته(س، ۲)
    پایان
    یافته‌ها := برگه.جستجو("کتاب")
    سرچاپ "کتاب"، یافته‌ها.طول()، "بار آمده است"
    شهر := اکسل.اندیس ستون("B")
    سرچاپ "ستون B"، برگه.دریافت ستون(شهر).طول()، "سلول دارد و ستون آخر"، اکسل.برچسب ستون(برگه.شمار ستون‌ها() - ۱)، "است"
    برگه.آزادسازی()
    برگشت ۰
پایان
