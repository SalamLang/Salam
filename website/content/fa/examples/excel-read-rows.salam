واردسازی اکسل

تابع ستون سرآیند(برگه: اکسل.برگه*، نام: رشته): صحیح:
    تکرار برگه.شمار ستون‌ها() در س:
        اگر برگه.دریافت رشته(۰، س) برابر نام: برگشت س پایان
    پایان
    برگشت -۱
پایان

تابع ساخت پرونده():
    ناپایا کتاب := اکسل.کتاب کار جدید()
    برگه := کتاب.افزودن برگه("نمره‌ها")
    هر س، عنوان در ["نام"، "شهر"، "نمره"]: برگه.تنظیم رشته(۰، س، عنوان) پایان
    برگه.تنظیم رشته(۱، ۰، "علی")
    برگه.تنظیم رشته(۱، ۱، "تهران")
    برگه.تنظیم عدد(۱، ۲، ۱۷.۵)
    برگه.تنظیم رشته(۲، ۰، "سارا")
    برگه.تنظیم رشته(۲، ۱، "شیراز")
    برگه.تنظیم عدد(۲، ۲، ۱۹)
    برگه.تنظیم رشته(۴، ۰، "رضا")
    برگه.تنظیم رشته(۴، ۲، "غایب")
    کتاب.ذخیره("grades.xlsx")
    کتاب.آزادسازی()
پایان

تابع ریشه:
    ساخت پرونده()
    ناپایا خوب := نادرست
    ناپایا خطا := ""
    ناپایا کتاب := اکسل.بازکردن("grades.xlsx"، خوب، خطا)
    اگر خوب برابر نادرست:
        سرچاپ "باز نشد:"، خطا
        برگشت ۱
    پایان
    برگه := کتاب.برگه در(۰)
    ستون نام := ستون سرآیند(برگه، "نام")
    ستون نمره := ستون سرآیند(برگه، "نمره")
    ناپایا جمع := ۰.۰
    ناپایا شمرده := ۰
    تکرار برگه.شمار سطرها() - ۱ در ی:
        سطر := ی + ۱
        اگر برگه.دارای سلول(سطر، ستون نام) برابر نادرست: گذر پایان
        سلول := برگه.دریافت سلول(سطر، ستون نمره)
        اگر سلول.نوع نابرابر اکسل.سلول عددی:
            سرچاپ برگه.دریافت رشته(سطر، ستون نام)، "کنار گذاشته شد:"، برگه.دریافت رشته(سطر، ستون نمره)
            گذر
        پایان
        سرچاپ برگه.دریافت رشته(سطر، ستون نام)، سلول.عدد
        جمع += سلول.عدد
        شمرده += ۱
    پایان
    سرچاپ "میانگین"، شمرده، "نفر ="، جمع / (شمرده برگردان اعشار۶۴)
    کتاب.آزادسازی()
    برگشت ۰
پایان
