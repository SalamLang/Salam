واردسازی اکسل

تابع ریشه:
    ناپایا کتاب := اکسل.کتاب کار جدید()
    ناپایا برگه := کتاب.افزودن برگه("فروردین")
    عنوان := کتاب.سبک‌ها.دریافت با افزودن(اکسل.سبک { پررنگ = درست، اندازه قلم = ۱۴، چینش افقی = اکسل.میان‌چین })
    سرستون := کتاب.سبک‌ها.دریافت با افزودن(اکسل.سبک { پررنگ = درست، رنگ زمینه = "DDEBF7" })
    پول := کتاب.سبک‌ها.دریافت با افزودن(اکسل.سبک { قالب عدد = "#,##0.00" })
    برگه.تنظیم رشته(۰، ۰، "فروش فروردین ۱۴۰۵")
    برگه.ادغام سلول‌ها(۰، ۰، ۰، ۳)
    برگه.تنظیم سبک(۰، ۰، عنوان)
    هر ستون، نام در ["کالا"، "تعداد"، "قیمت"، "جمع"]:
        برگه.تنظیم رشته(۱، ستون، نام)
        برگه.تنظیم سبک(۱، ستون، سرستون)
    پایان
    کالاها := ["چای"، "شکر"، "برنج"]
    تعدادها := [۱۲، ۳۰، ۵]
    قیمت‌ها := [۴.۵، ۱.۲۵، ۹.۸]
    ناپایا کل := ۰.۰
    تکرار ۳ در ی:
        سطر := ی + ۲
        مبلغ := (تعدادها[ی] برگردان اعشار۶۴) * قیمت‌ها[ی]
        برگه.تنظیم رشته(سطر، ۰، کالاها[ی])
        برگه.تنظیم عدد صحیح(سطر، ۱، تعدادها[ی] برگردان صحیح۶۴)
        برگه.تنظیم عدد(سطر، ۲، قیمت‌ها[ی])
        برگه.تنظیم فرمول(سطر، ۳، اکسل.ارجاع سلول(سطر، ۱) + "*" + اکسل.ارجاع سلول(سطر، ۲)، مبلغ)
        برگه.تنظیم سبک(سطر، ۳، پول)
        کل += مبلغ
    پایان
    برگه.تنظیم رشته(۵، ۲، "مجموع")
    برگه.تنظیم فرمول(۵، ۳، "SUM(D3:D5)"، کل)
    برگه.تنظیم سبک(۵، ۳، پول)
    سرچاپ "ذخیره شد:"، کتاب.ذخیره("march.xlsx")
    ناپایا خوب := نادرست
    ناپایا خطا := ""
    ناپایا خوانده := اکسل.بازکردن("march.xlsx"، خوب، خطا)
    ب := خوانده.برگه("فروردین")
    سرچاپ ب.دریافت رشته(۰، ۰)، "ادغام شده:"، ب.ادغام‌شده است(۰، ۳)
    سرچاپ ب.دریافت فرمول(۵، ۳)، "="، ب.دریافت عدد(۵، ۳)
    سرچاپ "سبک D3:"، خوانده.سبک‌ها.بگیر(ب.دریافت سلول(۲، ۳).شماره سبک).قالب عدد
    خوانده.آزادسازی()
    کتاب.آزادسازی()
    برگشت ۰
پایان
