واردسازی حافظه

درون‌داد:
    تابع snprintf(buf: تهی*، size: اندازه مثبت، format: رشته، ...): صحیح
    تابع getenv(name: رشته): رشته
پایان

تابع ریشه:
    بافر := حافظه.تخصیص صفرشده(۳۲ برگردان طبیعی۶۴) برگردان طبیعی۸*
    دیرکن حافظه.آزادسازی(بافر برگردان تهی*)

    ن := snprintf(بافر برگردان تهی*، ۳۲ برگردان اندازه مثبت، "%s-%05d"، "INV"، ۴۲)
    برچسب := بافر برگردان رشته
    سرچاپ ن، برچسب

    بایت‌ها := [۷۲، ۱۰۵، ۰، ۳۳، ۳۳]
    تکرار ۵ در ای:
        بافر[ای] = بایت‌ها[ای] برگردان طبیعی۸
    پایان
    متن := بافر برگردان رشته
    سرچاپ "به‌صورت رشته:"، طول(متن)، "بایت"
    ناپایا جمع := ۰
    تکرار ۵ در ای:
        جمع += بافر[ای] برگردان صحیح
    پایان
    سرچاپ "از راه اشاره‌گر:"، جمع

    مقدار := getenv("SALAM_EXAMPLE_UNSET")
    اگر (مقدار برگردان تهی*) == پوچ:
        سرچاپ "SALAM_EXAMPLE_UNSET تعریف نشده است"
    پایان
پایان
