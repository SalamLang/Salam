درون‌داد:
    تابع printf(متغیر_format: رشته، ...): صحیح
    تابع strlen(متن_نمونه: رشته): اندازه مثبت
    تابع atoi(متن_نمونه: رشته): صحیح
    تابع toupper(نویسه: صحیح): صحیح
پایان

تابع ریشه:
    سرچاپ "رسید"
    printf("%-8s %3d x %6.2f\n"، "coffee"، ۲، ۳.۵)
    printf("%-8s %3d x %6.2f\n"، "bagel"، ۱، ۲.۲۵)
    شمار := atoi("12") + atoi("30")
    سرچاپ "اقلام:"، شمار
    واژه := "salam"
    سرچاپ "بایت‌ها:"، strlen(واژه)
    سرچاپ "حرف اول:"، نویسه‌ازکد(toupper(کدنویسه(واژه)))
پایان
