درون‌داد:
    روال printf(format: رشته، ...): صحیح
    روال strlen(s: رشته): اندازه مثبت
    روال atoi(s: رشته): صحیح
    روال toupper(c: صحیح): صحیح
پایان

روال ریشه:
    سرچاپ "رسید"
    printf("%-8s %3d x %6.2f\n"، "coffee"، ۲، ۳.۵)
    printf("%-8s %3d x %6.2f\n"، "bagel"، ۱، ۲.۲۵)
    شمار := atoi("12") + atoi("30")
    سرچاپ "اقلام:"، شمار
    واژه := "salam"
    سرچاپ "بایت‌ها:"، strlen(واژه)
    سرچاپ "حرف اول:"، نویسه‌ازکد(toupper(کدنویسه(واژه)))
پایان
