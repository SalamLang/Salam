واردسازی حافظه

درون‌داد:
    روال qsort(base: تهی*، count: اندازه مثبت، width: اندازه مثبت، compare: تهی*)
پایان

برون‌داد:
    روال by_score(الف: تهی*، ب: تهی*): صحیح:
        ایکس := (الف برگردان صحیح۳۲*)[۰]
        ایگرگ := (ب برگردان صحیح۳۲*)[۰]
        اگر ایکس < ایگرگ:
            برگشت -۱
        وگرنه ایکس > ایگرگ:
            برگشت ۱
        پایان
        برگشت ۰
    پایان
پایان

روال ریشه:
    نمره‌ها := [۴۲، ۷، ۱۹، ۸۸، ۳]
    ن := طول(نمره‌ها)
    پ := حافظه.تخصیص((ن * ۴) برگردان طبیعی۶۴) برگردان صحیح۳۲*
    دیرکن حافظه.آزادسازی(پ برگردان تهی*)
    تکرار ن در ای:
        پ[ای] = نمره‌ها[ای]
    پایان

    qsort(پ برگردان تهی*، ن برگردان اندازه مثبت، ۴ برگردان اندازه مثبت، &by_score)

    ناپایا سطر := ""
    تکرار ن در ای:
        سطر += " " + پ[ای]
    پایان
    سرچاپ "مرتب‌شده:" + سطر
پایان
