واردسازی مسیر پرونده

تابع ریشه:
    پرونده‌ها := ["src/main.salam"، "src/util.salam"، "README.md"، "docs/guide.md"، "logo.svg"، "Makefile"، "docs/intro.md"]
    ترتیب := وکتور {} برگردان وکتور<رشته>
    دیرکن ترتیب.آزادکن()
    شمار := نگاشت {} برگردان نگاشت<رشته، صحیح>
    هر پرونده در پرونده‌ها:
        ناپایا پس := مسیر پرونده.پسوند(پرونده)
        اگر پس.طول() برابر ۰: پس = "(بی‌پسوند)" پایان
        اگر شمار.دارد(پس):
            شمار.درج(پس، شمار.بگیر(پس) + ۱)
        وگرنه:
            شمار.درج(پس، ۱)
            ترتیب.بیفزا(پس)
        پایان
    پایان
    هر پس در ترتیب:
        سرچاپ پس، شمار.بگیر(پس)
    پایان
پایان
