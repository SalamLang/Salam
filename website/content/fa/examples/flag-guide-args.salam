واردسازی خط فرمان
واردسازی پرچم
واردسازی سیستم عامل

تابع ریشه:
    ناپایا آرگ := خط فرمان.آرگومان‌های باقیمانده(سیستم عامل.آرگومان ها())
    دیرکن آرگ.آزادکن()
    اگر آرگ.طول() برابر ۰:
        هر آ در ["--name"، "سارا"، "-n"، "2"، "--excited"]: آرگ.بیفزا(آ) پایان
    پایان
    ناپایا پ := پرچم.جدید("greet"، "یک خوشامد چاپ می‌کند")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن رشته(پ، "name"، ""، "دنیا"، "به چه کسی سلام کنیم")
    پرچم.افزودن صحیح(پ، "times"، "n"، ۱، "چند بار")
    پرچم.افزودن منطقی(پ، "excited"، "e"، نادرست، "با سه علامت تعجب تمام کن")
    اگر وارونه پرچم.تجزیه(پ، آرگ):
        سرچاپ "greet:"، پرچم.خطا(پ)
        برگشت ۲
    پایان
    اگر پرچم.راهنما خواسته(پ):
        چاپ پرچم.راهنما(پ)
        برگشت ۰
    پایان
    خط := "سلام " + پرچم.دریافت رشته(پ، "name") + (پرچم.دریافت منطقی(پ، "excited") ? "!!!" : ".")
    تکرار پرچم.دریافت صحیح(پ، "times") برگردان صحیح:
        سرچاپ خط
    پایان
    برگشت ۰
پایان
