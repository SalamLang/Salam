واردسازی پرچم
واردسازی رشته

تابع امتحان(خط: رشته): صحیح:
    آرگ := رشته.تفکیک کردن(خط، " ")
    دیرکن آرگ.آزادکن()
    ناپایا پ := پرچم.جدید("resize"، "اندازه‌ی تصویرها را عوض می‌کند")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن صحیح(پ، "width"، "w"، ۸۰۰، "پهنای تازه به پیکسل")
    پرچم.افزودن اعشاری(پ، "quality"، "q"، ۰.۹، "کیفیت JPEG")
    پرچم.افزودن رشته(پ، "out"، "o"، "out"، "پوشه‌ی خروجی")
    اگر وارونه پرچم.تجزیه(پ، آرگ):
        سرچاپ "خطا:"، پرچم.خطا(پ)
        برگشت ۲
    پایان
    سرچاپ "پذیرفته شد: پهنا"، پرچم.دریافت صحیح(پ، "width")، "کیفیت"، پرچم.دریافت اعشاری(پ، "quality")، "پرونده‌ها"، پرچم.موقعیتی(پ)
    برگشت ۰
پایان

تابع ریشه:
    هر خط در ["-w 640 a.jpg"، "--width=wide a.jpg"، "--quality=0,5 a.jpg"، "--height 100"، "a.jpg -o"]:
        سرچاپ "$ resize"، خط
        سرچاپ "کد خروج"، امتحان(خط)
    پایان
پایان
