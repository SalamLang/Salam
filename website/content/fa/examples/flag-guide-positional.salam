واردسازی پرچم
واردسازی رشته

تابع ریشه:
    آرگ := رشته.تفکیک کردن("-r --dry-run=false --depth ۳ src docs -- --not-a-flag -r"، " ")
    دیرکن آرگ.آزادکن()
    ناپایا پ := پرچم.جدید("sync"، "پوشه‌ها را رونوشت می‌کند")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن منطقی(پ، "recursive"، "r"، نادرست، "زیرپوشه‌ها را هم بگرد")
    پرچم.افزودن منطقی(پ، "dry-run"، "n"، درست، "فقط بگو چه می‌شود")
    پرچم.افزودن صحیح(پ، "depth"، "d"، ۱، "تا چه عمقی برود")
    سرچاپ پرچم.تجزیه(پ، آرگ)، "[" + پرچم.خطا(پ) + "]"
    سرچاپ "بازگشتی:"، پرچم.دریافت منطقی(پ، "recursive")
    سرچاپ "اجرای آزمایشی:"، پرچم.دریافت منطقی(پ، "dry-run")
    سرچاپ "عمق:"، پرچم.دریافت صحیح(پ، "depth")
    موقعیت‌ها := پرچم.موقعیتی(پ)
    دیرکن موقعیت‌ها.آزادکن()
    هر ش، م در موقعیت‌ها:
        سرچاپ "آرگومان"، ش، م
    پایان
پایان
