واردسازی محیط
واردسازی پرچم
واردسازی رشته

تابع درگاه از(خط: رشته): صحیح۶۴:
    آرگ := رشته.تفکیک کردن(خط، " ")
    دیرکن آرگ.آزادکن()
    ناپایا پ := پرچم.جدید("server"، "")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن صحیح(پ، "port"، "p"، ۸۰۸۰، "درگاهی که روی آن گوش می‌دهد")
    پرچم.تجزیه(پ، آرگ)
    اگر پرچم.تنظیم شده(پ، "port"): برگشت پرچم.دریافت صحیح(پ، "port") پایان
    برگشت محیط.دریافت صحیح("PORT"، پرچم.دریافت صحیح(پ، "port"))
پایان

تابع ریشه:
    محیط.حذف("PORT")
    سرچاپ "هیچ چیز تنظیم نشده:"، درگاه از("app.log")
    محیط.تنظیم("PORT"، "3000")
    سرچاپ "PORT=3000:"، درگاه از("app.log")
    سرچاپ "PORT=3000 و -p 9000:"، درگاه از("-p 9000")
    سرچاپ "PORT=3000 و --port=8080:"، درگاه از("--port=8080")
پایان
