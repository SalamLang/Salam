واردسازی قالب بندی

تابع دو رقم شانزده(ع: صحیح): رشته:
    ش := قالب بندی.شانزده(ع برگردان طبیعی۶۴)
    اگر ش.طول() < ۲:
        برگشت "0" + ش
    پایان
    برگشت ش
پایان

تابع رنگ وب(سرخ: صحیح، سبز: صحیح، آبی: صحیح): رشته:
    برگشت "#" + دو رقم شانزده(سرخ) + دو رقم شانزده(سبز) + دو رقم شانزده(آبی)
پایان

تابع ریشه:
    سرچاپ رنگ وب(۲۵۵، ۱۶۵، ۰)
    سرچاپ رنگ وب(۰، ۱۲۸، ۱۲۸)
    سرچاپ رنگ وب(۹، ۹، ۹)
    ناپایا روشنی := ۰
    تا روشنی <= ۲۵۵:
        سرچاپ قالب بندی.پرکردن چپ(قالب بندی.عدد صحیح(روشنی)، ۳)، رنگ وب(روشنی، روشنی، روشنی)
        روشنی += ۸۵
    پایان
پایان
