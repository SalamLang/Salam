واردسازی قالب بندی

ساختار سفارش:
    همگانی مشتری: رشته = ""
    همگانی شماره: صحیح = ۰
    همگانی پرداخت شده: منطقی = نادرست
پایان

تابع پیام سفارش(س: سفارش): رشته:
    ناپایا مقدارها := وکتور {} برگردان وکتور<رشته>
    دیرکن مقدارها.آزادکن()
    مقدارها.بیفزا(س.مشتری)
    مقدارها.بیفزا(قالب بندی.عدد صحیح(س.شماره))
    مقدارها.بیفزا(س.پرداخت شده ? "پرداخت شده" : "در انتظار پرداخت")
    برگشت قالب بندی.قالب رشته("{} عزیز، سفارش {} {} است."، مقدارها)
پایان

تابع ریشه:
    سرچاپ پیام سفارش(سفارش { مشتری = "نیما"، شماره = ۱۰۴۲، پرداخت شده = درست })
    سرچاپ پیام سفارش(سفارش { مشتری = "لیلا"، شماره = ۱۰۴۳ })
پایان
