واردسازی قالب بندی

تابع ردیف(نام: رشته، مقدار: اعشار۶۴):
    سرچاپ قالب بندی.پرکردن راست(نام، ۱۰)،
        قالب بندی.عدد اعشار با الگو(مقدار، "%10.3f")،
        قالب بندی.عدد اعشار با الگو(مقدار، "%12.4e")،
        قالب بندی.عدد اعشار با الگو(مقدار، "%g")
پایان

تابع ریشه:
    ردیف("پی"، ۳.۱۴۱۵۹۲۶۵۳۵۸۹۷۹)
    ردیف("نور"، ۲۹۹۷۹۲۴۵۸.۰)
    ردیف("الکترون"، ۰.۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۰۱۶۰۲۱۸)
    ردیف("تغییر"، -۰.۰۴۲۵)
    سرچاپ قالب بندی.عدد اعشار با الگو(۰.۱۲۵، "%.2f")،
        قالب بندی.عدد اعشار با الگو(۰.۱۳۵، "%.2f")،
        قالب بندی.عدد اعشار با الگو(۲.۵، "%.0f")
    سرچاپ "#" + قالب بندی.عدد صحیح با الگو(۲۵۵، "%02x") + قالب بندی.عدد صحیح با الگو(۱۶۵، "%02x") +
        قالب بندی.عدد صحیح با الگو(۰، "%02x")
    سرچاپ قالب بندی.عدد صحیح با الگو(۴۲، "%+06d")،
        قالب بندی.عدد صحیح با الگو(۵، "%#b")،
        قالب بندی.عدد صحیح با الگو(۸، "%#o")
پایان
