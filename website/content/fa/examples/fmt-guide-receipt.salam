واردسازی قالب بندی

ساختار خرید:
    همگانی نام: رشته = ""
    همگانی تعداد: صحیح = ۰
    همگانی قیمت: اعشار۶۴ = ۰.۰
پایان

تابع ردیف(الف: رشته، ب: رشته، پ: رشته): رشته:
    برگشت قالب بندی.پرکردن راست(الف، ۱۲) + قالب بندی.پرکردن چپ(ب، ۵) + قالب بندی.پرکردن چپ(پ، ۱۰)
پایان

تابع ریشه:
    اقلام := [خرید { نام = "قهوه"، تعداد = ۲، قیمت = ۳.۵ }، خرید { نام = "کروسان"، تعداد = ۳، قیمت = ۲.۲۵ }، خرید { نام = "آب"، تعداد = ۱، قیمت = ۱.۰ }]
    سرچاپ "|" + قالب بندی.وسط چین("رسید خرید"، ۲۵) + "|"
    سرچاپ ردیف("کالا"، "تعداد"، "مبلغ")
    ناپایا جمع := ۰.۰
    هر قلم در اقلام:
        مبلغ := قلم.قیمت * قلم.تعداد
        جمع += مبلغ
        سرچاپ ردیف(قلم.نام، قالب بندی.عدد صحیح(قلم.تعداد)، قالب بندی.عدد اعشار با دقت(مبلغ، ۲))
    پایان
    سرچاپ ردیف("جمع"، ""، قالب بندی.عدد اعشار با دقت(جمع، ۲))
پایان
