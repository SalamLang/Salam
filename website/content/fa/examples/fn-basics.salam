تابع جمع ردیف(بها: صحیح، تعداد: صحیح): صحیح:
    برگشت بها * تعداد
پایان

تابع نمایش ردیف(نام: رشته، مبلغ: صحیح):
    سرچاپ نام + ":"، مبلغ
پایان

تابع ریشه:
    چای := جمع ردیف(۴۵، ۲)
    کیک := جمع ردیف(۱۲۰، ۱)
    نمایش ردیف("چای"، چای)
    نمایش ردیف("کیک"، کیک)
    نمایش ردیف("جمع کل"، چای + کیک)
پایان
