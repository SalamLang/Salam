تابع بررسی نام کاربری(نام: رشته): رشته:
    اگر نام.شمارنویسه() < ۳:
        برگشت "خیلی کوتاه"
    پایان
    اگر نام.شمارنویسه() > ۱۲:
        برگشت "خیلی بلند"
    پایان
    اگر نام == "مدیر":
        برگشت "رزرو شده"
    پایان
    برگشت "درست"
پایان

تابع خوشامد(نام: رشته):
    اگر بررسی نام کاربری(نام) != "درست":
        سرچاپ "نمی‌توان خوشامد گفت به"، نام
        برگشت
    پایان
    سرچاپ "خوش آمدی،"، نام
پایان

تابع ریشه:
    سرچاپ بررسی نام کاربری("من")
    سرچاپ بررسی نام کاربری("مدیریت‌کل‌سامانه‌ها")
    سرچاپ بررسی نام کاربری("مدیر")
    خوشامد("مینا")
    خوشامد("آب")
پایان
