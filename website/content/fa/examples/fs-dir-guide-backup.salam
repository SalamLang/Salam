واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده.پرونده
واردسازی رشته

تابع نسخه(پایه: رشته، شماره: صحیح): رشته:
    برگشت پایه.پیوست(".bak").پیوست(رشته.از عدد(شماره))
پایان

تابع پشتیبان بگیر(منبع: رشته، نگه‌داری: صحیح):
    پوشه.حذف همه(نسخه(منبع، نگه‌داری))
    ناپایا ن := نگه‌داری - ۱
    تا ن >= ۱:
        اگر پوشه.وجود دارد(نسخه(منبع، ن)): پوشه.جابجایی(نسخه(منبع، ن)، نسخه(منبع، ن + ۱)) پایان
        ن -= ۱
    پایان
    پوشه.کپی(منبع، نسخه(منبع، ۱))
پایان

تابع ریشه:
    پوشه.ساخت پوشه ها("یادداشت")
    تکرار ۱ تا ۴ در روز:
        پرونده.نوشتن متن("یادداشت/امروز.txt"، "روز ".پیوست(رشته.از عدد(روز)))
        پشتیبان بگیر("یادداشت"، ۳)
    پایان
    تکرار ۱ تا ۳ در ن:
        سرچاپ نسخه("یادداشت"، ن)، پرونده.خواندن متن(نسخه("یادداشت"، ن).پیوست("/امروز.txt"))
    پایان
    سرچاپ "یادداشت.bak4 هست:"، پوشه.وجود دارد(نسخه("یادداشت"، ۴))
    هر د در ["یادداشت"، "یادداشت.bak1"، "یادداشت.bak2"، "یادداشت.bak3"]: پوشه.حذف همه(د) پایان
پایان
