واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده.پرونده
واردسازی سیستم عامل.خطا

تابع گزارش(کار: رشته، کد: صحیح):
    اگر کد == ۰:
        سرچاپ کار، "انجام شد"
    وگرنه:
        سرچاپ کار، "شکست خورد:"، خطا.پیام آخرین خطا()
    پایان
پایان

تابع ریشه:
    گزارش("ساخت داده"، پوشه.ساخت پوشه("داده"))
    گزارش("ساخت دوباره‌ی داده"، پوشه.ساخت پوشه("داده"))
    گزارش("ساخت a/b/c"، پوشه.ساخت پوشه("a/b/c"))
    پرونده.نوشتن متن("داده/x.txt"، "x")
    گزارش("حذف داده"، پوشه.حذف("داده"))
    سرچاپ "داده/x.txt پوشه است:"، پوشه.وجود دارد("داده/x.txt")، "پرونده است:"، پرونده.وجود دارد("داده/x.txt")
    گزارش("حذف کامل داده"، پوشه.حذف همه("داده"))
    سرچاپ "فهرست پوشه‌ی ناموجود:"، پوشه.فهرست("داده").طول()
پایان
