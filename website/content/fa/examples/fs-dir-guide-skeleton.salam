تابع ریشه:
    هر د در ["فروشگاه/src/models"، "فروشگاه/src/views"، "فروشگاه/tests"، "فروشگاه/docs"]:
        پوشه.ساخت پوشه ها(د)
    پایان
    پرونده.نوشتن متن("فروشگاه/main.salam"، "تابع ریشه:\nپایان\n")
