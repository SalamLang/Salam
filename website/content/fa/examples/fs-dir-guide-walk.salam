واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده.پرونده
واردسازی سیستم پرونده.مسیر

تابع ریشه:
    پوشه.ساخت پوشه ها("سایت/pages/blog")
    پوشه.ساخت پوشه ها("سایت/assets/img")
    پرونده.نوشتن متن("سایت/pages/index.html"، "<h1>Home</h1>")
    پرونده.نوشتن متن("سایت/pages/blog/first.html"، "<p>First post</p>")
    پرونده.نوشتن متن("سایت/assets/style.css"، "body { margin: 0 }")
    پرونده.نوشتن متن("سایت/assets/img/logo.svg"، "<svg/>")
    شمار := نگاشت {} برگردان نگاشت<رشته، صحیح>
    ناپایا حجم := ۰ برگردان صحیح۶۴
    هر پ در پوشه.پیمایش("سایت"):
        پسوند := مسیر.پسوند(پ)
        اگر شمار.دارد(پسوند): شمار.درج(پسوند، شمار.بگیر(پسوند) + ۱) وگرنه: شمار.درج(پسوند، ۱) پایان
        حجم += پرونده.اندازه(پ)
    پایان
    هر پسوند در [".html"، ".css"، ".svg"]:
        سرچاپ پسوند، شمار.بگیر(پسوند)
    پایان
    سرچاپ "جمع:"، حجم، "بایت، برابر با پوشه.اندازه:"، حجم == پوشه.اندازه("سایت")
    پوشه.حذف همه("سایت")
پایان
