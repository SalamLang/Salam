واردسازی سیستم پرونده.پرونده

تابع سالم است(پ: رشته): منطقی:
    انتظار := پرونده.خواندن متن(پ.پیوست(".sha256")).پیراست()
    برگشت پرونده.هش شا۲۵۶(پ) == انتظار
پایان

تابع ریشه:
    پرونده.نوشتن بایت‌ها("انتشار.tar"، "pretend this is a release archive")
    پرونده.نوشتن متن("انتشار.tar.sha256"، پرونده.هش شا۲۵۶("انتشار.tar").پیوست("\n"))
    سرچاپ "سالم:"، سالم است("انتشار.tar")
    پرونده.افزودن("انتشار.tar"، "!")
    سرچاپ "پس از تغییر:"، سالم است("انتشار.tar")
    پرونده.حذف("انتشار.tar")
    پرونده.حذف("انتشار.tar.sha256")
پایان
