واردسازی سیستم پرونده.پرونده
واردسازی رشته

تابع ریشه:
    پرونده.نوشتن متن("برنامه.conf"، "# تنظیمات فروشگاه\nname = فروشگاه سر کوچه\n\nport = 8080\ncurrency = IRR\n")
    تنظیمات := نگاشت {} برگردان نگاشت<رشته، رشته>
    هر سطر در پرونده.خواندن خط‌ها("برنامه.conf"):
        ت := سطر.پیراست()
        اگر ت.طول() == ۰ یا رشته.شروع با(ت، "#"): گذر پایان
        جای مساوی := رشته.اندیس(ت، "=")
        اگر جای مساوی < ۰: گذر پایان
        تنظیمات.درج(ت.زیررشته(۰، جای مساوی).پیراست()، ت.زیررشته(جای مساوی + ۱، ت.طول() - جای مساوی - ۱).پیراست())
    پایان
    سرچاپ تنظیمات.اندازه()، "تنظیم"
    سرچاپ "نام:"، تنظیمات.بگیر("name")
    سرچاپ "درگاه:"، تنظیمات.بگیر("port")
    پرونده.حذف("برنامه.conf")
پایان
