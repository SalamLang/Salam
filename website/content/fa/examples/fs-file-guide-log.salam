واردسازی سیستم پرونده.پرونده

تابع ثبت(سطر: رشته):
    پرونده.افزودن("برنامه.log"، سطر.پیوست("\n"))
پایان

تابع ریشه:
    ثبت("شروع شد")
    ثبت("۳ سفارش بارگذاری شد")
    ثبت("صورت‌حساب ۱۰۴۲ فرستاده شد")
    ثبت("متوقف شد")
    سطرها := پرونده.خواندن خط‌ها("برنامه.log")
    سرچاپ "گزارش"، سطرها.طول()، "خط و"، پرونده.اندازه("برنامه.log")، "بایت دارد"
    سرچاپ "دو خط آخر:"
    ناپایا ی := سطرها.طول() - ۲
    تا ی < سطرها.طول():
        سرچاپ " "، سطرها.بگیر(ی)
        ی += ۱
    پایان
    پرونده.حذف("برنامه.log")
پایان
