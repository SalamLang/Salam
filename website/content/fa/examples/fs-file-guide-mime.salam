واردسازی سیستم پرونده

تابع ریشه:
    هر نام در ["index.html"، "app.js"، "logo.SVG"، "photo.jpeg"، "داده.json"، "یادداشت"، "backup.7z"]:
        پسوند := سیستم پرونده.پسوند(نام)
        اگر پسوند == "": سرچاپ نام، "(بدون پسوند)"، سیستم پرونده.نوع مایم(نام)
        وگرنه: سرچاپ نام، پسوند، سیستم پرونده.نوع مایم(نام)
        پایان
    پایان
پایان
