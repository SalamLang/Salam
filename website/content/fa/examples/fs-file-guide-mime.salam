واردسازی سیستم پرونده.پرونده

تابع ریشه:
    هر نام در ["index.html"، "app.js"، "logo.SVG"، "photo.jpeg"، "داده.json"، "یادداشت"، "backup.7z"]:
        پسوند := پرونده.پسوند(نام)
        اگر پسوند == "": سرچاپ نام، "(بدون پسوند)"، پرونده.نوع مایم(نام)
        وگرنه: سرچاپ نام، پسوند، پرونده.نوع مایم(نام)
        پایان
    پایان
پایان
