واردسازی سیستم پرونده
واردسازی سیستم عامل.خطا

تابع ذخیره(پ: رشته، داده: رشته): منطقی:
    اگر سیستم پرونده.وجود دارد(پ): سیستم پرونده.کپی(پ، پ.پیوست(".bak")) پایان
    اگر سیستم پرونده.نوشتن اتمی(پ، داده) != ۰:
        سرچاپ "ذخیره نشد:"، خطا.پیام آخرین خطا()
        برگشت نادرست
    پایان
    برگشت درست
پایان

تابع ریشه:
    ذخیره("نمایه.json"، "{\"name\": \"سارا\"}")
    ذخیره("نمایه.json"، "{\"name\": \"سارا\", \"city\": \"تبریز\"}")
    سرچاپ "نسخه‌ی فعلی:"، سیستم پرونده.خواندن متن("نمایه.json")
    سرچاپ "پشتیبان:"، سیستم پرونده.خواندن متن("نمایه.json.bak")
    سرچاپ "پرونده‌ی موقت ماند:"، سیستم پرونده.وجود دارد("نمایه.json.tmp")
    ذخیره("پوشه-ناموجود/نمایه.json"، "{}")
    سیستم پرونده.حذف("نمایه.json")
    سیستم پرونده.حذف("نمایه.json.bak")
پایان
