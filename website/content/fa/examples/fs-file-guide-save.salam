واردسازی سیستم پرونده.پرونده
واردسازی سیستم عامل.خطا

تابع ذخیره(پ: رشته، داده: رشته): منطقی:
    اگر پرونده.وجود دارد(پ): پرونده.کپی(پ، پ.پیوست(".bak")) پایان
    اگر پرونده.نوشتن اتمی(پ، داده) != ۰:
        سرچاپ "ذخیره نشد:"، خطا.پیام آخرین خطا()
        برگشت نادرست
    پایان
    برگشت درست
پایان

تابع ریشه:
    ذخیره("نمایه.json"، "{\"name\": \"سارا\"}")
    ذخیره("نمایه.json"، "{\"name\": \"سارا\", \"city\": \"تبریز\"}")
    سرچاپ "نسخه‌ی فعلی:"، پرونده.خواندن متن("نمایه.json")
    سرچاپ "پشتیبان:"، پرونده.خواندن متن("نمایه.json.bak")
    سرچاپ "پرونده‌ی موقت ماند:"، پرونده.وجود دارد("نمایه.json.tmp")
    ذخیره("پوشه-ناموجود/نمایه.json"، "{}")
    پرونده.حذف("نمایه.json")
    پرونده.حذف("نمایه.json.bak")
پایان
