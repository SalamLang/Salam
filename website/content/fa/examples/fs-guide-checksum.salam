واردسازی سیستم پرونده

تابع سالم است(پ: رشته): منطقی:
    انتظار := سیستم پرونده.خواندن متن(پ.پیوست(".sha256")).پیراست()
    برگشت سیستم پرونده.هش شا۲۵۶(پ) == انتظار
پایان

تابع ریشه:
    سیستم پرونده.نوشتن بایت‌ها("انتشار.tar"، "pretend this is a release archive")
    سیستم پرونده.نوشتن متن("انتشار.tar.sha256"، سیستم پرونده.هش شا۲۵۶("انتشار.tar").پیوست("\n"))
    سرچاپ "سالم:"، سالم است("انتشار.tar")
    سیستم پرونده.افزودن("انتشار.tar"، "!")
    سرچاپ "پس از تغییر:"، سالم است("انتشار.tar")
    سیستم پرونده.حذف("انتشار.tar")
    سیستم پرونده.حذف("انتشار.tar.sha256")
پایان
