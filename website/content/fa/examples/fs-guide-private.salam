واردسازی سیستم پرونده

تابع هشتی(م: صحیح): رشته:
    برگشت "0o" + ((م >> ۶) & ۷) + ((م >> ۳) & ۷) + (م & ۷)
پایان

تابع ریشه:
    سیستم پرونده.نوشتن متن("توکن.txt"، "s3cr3t")
    سیستم پرونده.تغییر مجوز("توکن.txt"، 0o644)
    سرچاپ "پیش از تغییر:"، هشتی(سیستم پرونده.مجوزها("توکن.txt"))
    سیستم پرونده.تغییر مجوز("توکن.txt"، 0o600)
    م := سیستم پرونده.مجوزها("توکن.txt")
    سرچاپ "پس از تغییر:"، هشتی(م)
    اگر (م & 0o077) برابر ۰:
        سرچاپ "فقط مالک می‌تواند آن را بخواند"
    پایان
    سیستم پرونده.حذف("توکن.txt")
پایان
