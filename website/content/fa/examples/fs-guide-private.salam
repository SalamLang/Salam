واردسازی سیستم پرونده
واردسازی سیستم پرونده.پرونده

تابع ریشه:
    پرونده.نوشتن متن("توکن.txt"، "s3cr3t")
    سیستم پرونده.تغییر مجوز("توکن.txt"، 0o644)
    سرچاپ "پیش از تغییر:"، سیستم پرونده.مجوزها("توکن.txt")
    سیستم پرونده.تغییر مجوز("توکن.txt"، 0o600)
    م := سیستم پرونده.مجوزها("توکن.txt")
    سرچاپ "پس از تغییر:"، م
    اگر م % ۱۰۰ == ۰:
        سرچاپ "فقط مالک می‌تواند آن را بخواند"
    پایان
    پرونده.حذف("توکن.txt")
پایان
