واردسازی سیستم پرونده
واردسازی سیستم پرونده.پرونده

تابع حرف‌ها(رقم: صحیح): رشته:
    ناپایا خروجی := ""
    اگر رقم >= ۴: خروجی = خروجی + "r" وگرنه: خروجی = خروجی + "-" پایان
    اگر رقم % ۴ >= ۲: خروجی = خروجی + "w" وگرنه: خروجی = خروجی + "-" پایان
    اگر رقم % ۲ == ۱: خروجی = خروجی + "x" وگرنه: خروجی = خروجی + "-" پایان
    برگشت خروجی
پایان

تابع نمایش(م: صحیح): رشته:
    برگشت حرف‌ها(م / ۱۰۰) + حرف‌ها(م / ۱۰ % ۱۰) + حرف‌ها(م % ۱۰)
پایان

تابع ریشه:
    پرونده.نوشتن متن("استقرار.sh"، "echo deploying\n")
    هر حالت در [0o755 ، 0o750 ، 0o644 ، 0o600]:
        سیستم پرونده.تغییر مجوز("استقرار.sh"، حالت)
        م := سیستم پرونده.مجوزها("استقرار.sh")
        سرچاپ م، نمایش(م)
    پایان
    پرونده.حذف("استقرار.sh")
پایان
