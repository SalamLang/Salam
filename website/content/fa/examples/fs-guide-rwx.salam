واردسازی سیستم پرونده

تابع حرف‌ها(رقم: صحیح): رشته:
    ناپایا خروجی := ""
    اگر (رقم & ۴) نابرابر ۰: خروجی += "r" وگرنه:
        خروجی += "-"
    پایان
    اگر (رقم & ۲) نابرابر ۰: خروجی += "w" وگرنه:
        خروجی += "-"
    پایان
    اگر (رقم & ۱) نابرابر ۰: خروجی += "x" وگرنه:
        خروجی += "-"
    پایان
    برگشت خروجی
پایان

تابع نمایش(م: صحیح): رشته:
    برگشت حرف‌ها((م >> ۶) & ۷) + حرف‌ها((م >> ۳) & ۷) + حرف‌ها(م & ۷)
پایان

تابع هشتی(م: صحیح): رشته:
    برگشت "0o" + ((م >> ۶) & ۷) + ((م >> ۳) & ۷) + (م & ۷)
پایان

تابع ریشه:
    سیستم پرونده.نوشتن متن("استقرار.sh"، "echo deploying\n")
    هر حالت در [0o755، 0o750، 0o644، 0o600]:
        سیستم پرونده.تغییر مجوز("استقرار.sh"، حالت)
        م := سیستم پرونده.مجوزها("استقرار.sh")
        سرچاپ هشتی(م)، نمایش(م)
    پایان
    سیستم پرونده.حذف("استقرار.sh")
پایان
