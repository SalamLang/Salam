واردسازی سیستم پرونده.مسیر
واردسازی سیستم پرونده.پوشه
واردسازی ورودی خروجی

تابع نام پشتیبان(پ: رشته): رشته:
    نام تازه := مسیر.نام بدون پسوند(پ).پیوست(".bak").پیوست(مسیر.پسوند(پ))
    برگشت مسیر.پیوند(مسیر.نام پوشه(پ)، نام تازه)
پایان

تابع ریشه:
    پوشه.ساخت پوشه ها("notes/2026")
    هر پ در ["notes/todo.txt"، "notes/2026/plan.md"]:
        ورودی خروجی.نوشتن پرونده(پ، "پیش‌نویس ".پیوست(مسیر.نام پرونده(پ)))
        پشتیبان := نام پشتیبان(پ)
        ورودی خروجی.نوشتن پرونده(پشتیبان، ورودی خروجی.خواندن پرونده(پ))
        سرچاپ پ، "ذخیره شد در"، پشتیبان
    پایان
    سرچاپ ورودی خروجی.خواندن پرونده("notes/2026/plan.bak.md")
پایان
