واردسازی سیستم پرونده.مسیر

تابع مسیر خروجی(ریشه منبع: رشته، ریشه خروجی: رشته، پرونده: رشته): رشته:
    نسبی := مسیر.مسیر نسبی(ریشه منبع، پرونده)
    پوشه مقصد := مسیر.پیوند(ریشه خروجی، مسیر.نام پوشه(نسبی))
    صفحه‌ی خروجی := مسیر.نام بدون پسوند(نسبی).پیوست(".html")
    برگشت مسیر.پاک سازی(مسیر.پیوند(پوشه مقصد، صفحه‌ی خروجی))
پایان

تابع ریشه:
    منبع := "/site/content"
    خروجی := "/site/public"
    هر پرونده در ["/site/content/index.md"، "/site/content/blog/hello.md"، "/site/content/blog/2026/salam.v2.md"]:
        سرچاپ مسیر.مسیر نسبی(منبع، پرونده)، "->"، مسیر خروجی(منبع، خروجی، پرونده)
    پایان
