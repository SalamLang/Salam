واردسازی سیستم پرونده.مسیر

تابع پیدا کن(پوشه اصلی: رشته، خواسته: رشته): رشته:
    اگر وارونه مسیر.مسیر امن است(پوشه اصلی، خواسته): برگشت "" پایان
    برگشت مسیر.پاک سازی(مسیر.پیوند(پوشه اصلی، خواسته))
پایان

تابع ریشه:
    پوشه بارگذاری := "/srv/uploads"
    هر نام در ["avatar.png"، "2026/report.pdf"، "a/../b.txt"، "../secret.txt"، "a/../../etc/passwd"، "/etc/passwd"، ""]:
        کامل := پیدا کن(پوشه بارگذاری، نام)
        اگر کامل.طول() برابر ۰:
            سرچاپ "رد شد"، "[" + نام + "]"
        وگرنه:
            سرچاپ "فرستاده شد"، کامل
        پایان
    پایان
پایان
