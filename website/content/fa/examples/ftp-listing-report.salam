واردسازی اف‌تی‌پی
واردسازی رشته

تابع ریشه:
    خام := "drwxr-xr-x    2 ftp ftp     4096 Jan 01  2026 old\n-rw-r--r--    1 ftp ftp   120034 Oct 02 08:10 sales-2026-10-01.csv\n-rw-r--r--    1 ftp ftp   118702 Oct 03 08:10 sales-2026-10-02.csv\n-rw-r--r--    1 ftp ftp  2251800 Oct 03 08:12 photos.zip\nlrwxrwxrwx    1 ftp ftp       20 Oct 03 08:12 latest.csv -> sales-2026-10-02.csv"

    ناپایا مجموع := ۰ برگردان صحیح۶۴
    ناپایا شمار پرونده := ۰
    ناپایا بزرگ‌ترین := اف‌تی‌پی.اطلاعات پرونده {}
    هر خط در رشته.تفکیک کردن(خام، "\n"):
        پرونده := اف‌تی‌پی.تحلیل خط فهرست(خط)
        اگر پرونده.پوشه:
            سرچاپ "پوشه"، پرونده.نام
            گذر
        پایان
        اگر پرونده.پیوند:
            سرچاپ "پیوند"، پرونده.نام
            گذر
        پایان
        سرچاپ "پرونده"، پرونده.نام، پرونده.اندازه، پرونده.تاریخ خام
        شمار پرونده += ۱
        مجموع += پرونده.اندازه
        اگر پرونده.اندازه بزرگتر بزرگ‌ترین.اندازه:
            بزرگ‌ترین = پرونده
        پایان
    پایان
    سرچاپ شمار پرونده، "پرونده،"، مجموع، "بایت؛ بزرگ‌ترین:"، بزرگ‌ترین.نام
پایان
