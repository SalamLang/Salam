واردسازی اف‌تی‌پی

تابع ریشه:
    ناپایا کارخواه := اف‌تی‌پی.اتصال امن("ftp.example-host.com"، ۲۱)
    اگر وارونه اف‌تی‌پی.سالم(کارخواه):
        سرچاپ "اتصال برقرار نشد:"، اف‌تی‌پی.آخرین پاسخ(کارخواه)
        برگشت ۱
    پایان
    اگر وارونه اف‌تی‌پی.امن(کارخواه) یا وارونه اف‌تی‌پی.داده امن(کارخواه):
        سرچاپ "سرور نشست را رمز نکرد، کار متوقف شد"
        اف‌تی‌پی.بستن(کارخواه)
        برگشت ۱
    پایان
    اگر وارونه اف‌تی‌پی.ورود(کارخواه، "site-user"، "app-password"):
        سرچاپ "ورود ناموفق:"، اف‌تی‌پی.آخرین کد(کارخواه)، اف‌تی‌پی.آخرین پاسخ(کارخواه)
        اف‌تی‌پی.بستن(کارخواه)
        برگشت ۱
    پایان
    _ := اف‌تی‌پی.دودویی(کارخواه)
    _ := اف‌تی‌پی.ساخت مسیر کامل(کارخواه، "/public_html")
    اگر اف‌تی‌پی.وجود دارد(کارخواه، "/public_html/index.html"):
        _ := اف‌تی‌پی.تغییر نام(کارخواه، "/public_html/index.html"، "/public_html/index.old.html")
    پایان
    اگر وارونه اف‌تی‌پی.ارسال پوشه(کارخواه، "dist"، "/public_html"):
        سرچاپ "بارگذاری ناموفق:"، اف‌تی‌پی.آخرین پاسخ(کارخواه)
        برگشت ۱
    پایان
    سرچاپ "بارگذاری شد، اندازه‌ی index.html:"، اف‌تی‌پی.اندازه(کارخواه، "/public_html/index.html")، "بایت"
    اف‌تی‌پی.خروج(کارخواه)
    اف‌تی‌پی.بستن(کارخواه)
    برگشت ۰
پایان
