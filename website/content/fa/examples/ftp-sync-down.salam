واردسازی اف‌تی‌پی
واردسازی سیستم عامل

تابع ریشه:
    ناپایا کارخواه := اف‌تی‌پی.اتصال امن("files.example.com"، ۲۱)
    اگر وارونه اف‌تی‌پی.سالم(کارخواه) یا وارونه اف‌تی‌پی.ورود(کارخواه، "reports"، "app-password"):
        سرچاپ "ورود ممکن نشد:"، اف‌تی‌پی.آخرین پاسخ(کارخواه)
        برگشت ۱
    پایان
    _ := اف‌تی‌پی.دودویی(کارخواه)
    _ := سیستم عامل.ساخت پوشه ها("reports")
    ناپایا گرفته شده := ۰
    ناپایا رد شده := ۰
    هر پرونده در اف‌تی‌پی.فهرست(کارخواه، "/daily"):
        اگر پرونده.پوشه یا پرونده.پیوند:
            گذر
        پایان
        مسیر محلی := "reports/" + پرونده.نام
        اگر سیستم عامل.وجود دارد(مسیر محلی):
            رد شده += ۱
            گذر
        پایان
        اگر اف‌تی‌پی.دریافت(کارخواه، "/daily/" + پرونده.نام، مسیر محلی):
            گرفته شده += ۱
        وگرنه:
            سرچاپ "ناموفق:"، پرونده.نام، اف‌تی‌پی.آخرین پاسخ(کارخواه)
        پایان
    پایان
    سرچاپ "گرفته شد"، گرفته شده، "پرونده‌ی تازه، رد شد"، رد شده
    اف‌تی‌پی.خروج(کارخواه)
    اف‌تی‌پی.بستن(کارخواه)
    برگشت ۰
پایان
