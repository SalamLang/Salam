واردسازی سرور اف‌تی‌پی
واردسازی محیط

تابع ریشه:
    ناپایا پیکربندی := سرور اف‌تی‌پی.پیکربندی نو()
    پیکربندی.درگاه = ۲۱۲۱
    پیکربندی.ریشه = "/srv/ftp"
    پیکربندی.کاربر = "reports"
    پیکربندی.گذرواژه = محیط.دریافت("FTP_PASSWORD")
    اگر پیکربندی.گذرواژه.طول() برابر ۰:
        سرچاپ "ابتدا FTP_PASSWORD را بگذارید"
        برگشت ۱
    پایان
    پیکربندی.تی‌ال‌اس فعال = درست
    پیکربندی.پرونده گواهی = "/etc/ssl/certs/ftp.crt"
    پیکربندی.پرونده کلید = "/etc/ssl/private/ftp.key"
    پیکربندی.اجبار تی‌ال‌اس = درست
    ناپایا سرور := سرور اف‌تی‌پی.جدید(پیکربندی)
    اگر وارونه سرور اف‌تی‌پی.گوش دادن(سرور):
        سرچاپ "گوش دادن روی درگاه ممکن نشد"، پیکربندی.درگاه
        برگشت ۱
    پایان
    سرور اف‌تی‌پی.خدمت(سرور)
    برگشت ۰
پایان
