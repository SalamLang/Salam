میانجی امتیازدار:
    روال امتیاز(): صحیح
    روال برچسب(): رشته
پایان

ساختار بازیکن:
    همگانی نام: رشته = ""
    همگانی امتیازها: صحیح = ۰
    همگانی روال امتیاز(): صحیح: برگشت این.امتیازها پایان
    همگانی روال برچسب(): رشته: برگشت این.نام پایان
پایان

ساختار پیشنهاد:
    همگانی خریدار: رشته = ""
    همگانی مبلغ: صحیح = ۰
    همگانی روال امتیاز(): صحیح: برگشت این.مبلغ پایان
    همگانی روال برچسب(): رشته: برگشت این.خریدار + " با " + این.مبلغ پایان
پایان

ساختار جدول<ت: امتیازدار>:
    ردیف‌ها: وکتور<ت> = وکتور {}

    همگانی روال بیفزای(مورد: ت):
        این.ردیف‌ها.بیفزا(مورد)
    پایان

    همگانی روال بهترین(): ت:
        ناپایا برتر := این.ردیف‌ها.بگیر(۰)
        هر ر در این.ردیف‌ها:
            اگر ر.امتیاز() > برتر.امتیاز():
                برتر = ر
            پایان
        پایان
        برگشت برتر
    پایان

    همگانی روال جمع کل(): صحیح:
        ناپایا جمع := ۰
        هر ر در این.ردیف‌ها:
            جمع += ر.امتیاز()
        پایان
        برگشت جمع
    پایان

    همگانی روال آزادکن():
        این.ردیف‌ها.آزادکن()
    پایان
پایان

روال بالاتر<ت: امتیازدار>(الف: ت، ب: ت): ت:
    اگر ب.امتیاز() > الف.امتیاز():
        برگشت ب
    پایان
    برگشت الف
پایان

روال ریشه:
    تیم := جدول {} برگردان جدول<بازیکن>
    دیرکن تیم.آزادکن()
    تیم.بیفزای(بازیکن { نام = "سارا"، امتیازها = ۴۲ })
    تیم.بیفزای(بازیکن { نام = "رضا"، امتیازها = ۵۷ })
    تیم.بیفزای(بازیکن { نام = "مینا"، امتیازها = ۴۹ })
    سرچاپ "بهترین بازیکن:"، تیم.بهترین().برچسب()
    سرچاپ "جمع امتیاز تیم:"، تیم.جمع کل()

    اول := پیشنهاد { خریدار = "علی"، مبلغ = ۱۲۰ }
    دوم := پیشنهاد { خریدار = "نیما"، مبلغ = ۱۵۰ }
    سرچاپ "پیشنهاد برنده:"، بالاتر(اول، دوم).برچسب()
پایان
