ساختار جفت<الف، ب>:
    همگانی اولی: الف
    همگانی دومی: ب
پایان

روال جابجا<الف، ب>(ج: جفت<الف، ب>): جفت<ب، الف>:
    برگشت جفت { اولی = ج.دومی، دومی = ج.اولی }
پایان

روال ریشه:
    موجودی := جفت { اولی = "مداد"، دومی = ۱۲۰ } برگردان جفت<رشته، صحیح>
    سرچاپ موجودی
    سرچاپ جابجا(موجودی)
    نقطه := جفت { اولی = ۲.۵، دومی = -۱.۰ } برگردان جفت<اعشار۶۴، اعشار۶۴>
    سرچاپ نقطه.اولی + نقطه.دومی
پایان
