ساختار پشته<ت>:
    اقلام: وکتور<ت> = وکتور {}

    همگانی تابع بگذار(مقدار: ت):
        این.اقلام.بیفزا(مقدار)
    پایان

    همگانی تابع بردار(): ت:
        برگشت این.اقلام.دربیاور()
    پایان

    همگانی تابع رویی(): ت:
        برگشت این.اقلام.بگیر(این.اقلام.طول() - ۱)
    پایان

    همگانی تابع تعداد(): صحیح:
        برگشت این.اقلام.طول()
    پایان

    همگانی تابع خالی است(): منطقی:
        برگشت این.اقلام.طول() == ۰
    پایان

    همگانی تابع آزادکن():
        این.اقلام.آزادکن()
    پایان
پایان

تابع ریشه:
    واگرد := پشته {} برگردان پشته<رشته>
    دیرکن واگرد.آزادکن()
    واگرد.بگذار("نوشتن «سلام»")
    واگرد.بگذار("پررنگ کردن")
    واگرد.بگذار("پاک کردن یک خط")
    سرچاپ واگرد.تعداد()، "گام، آخرین:"، واگرد.رویی()
    تا وارونه واگرد.خالی است():
        سرچاپ "واگرد"، واگرد.بردار()
    پایان

    صفحه‌ها := پشته {} برگردان پشته<صحیح>
    دیرکن صفحه‌ها.آزادکن()
    صفحه‌ها.بگذار(۱)
    صفحه‌ها.بگذار(۱۴)
    سرچاپ "بازگشت به صفحه‌ی"، صفحه‌ها.بردار()
پایان
