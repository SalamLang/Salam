واردسازی جی‌جی‌یو‌اف
واردسازی فشرده سازی
واردسازی کدگذاری.دودویی

تابع ریشه:
    ناپایا موفق := نادرست
    ناپایا آشغال := فشرده سازی.بافر بایت جدید()
    متن := "PK this is a zip archive, not a model file"
    فشرده سازی.افزودن بایت‌ها(آشغال، متن برگردان تهی*، متن.طول())
    ناپایا خراب := جی‌جی‌یو‌اف.تجزیه جی‌جی‌یو‌اف(آشغال، موفق)
    سرچاپ "فایل zip:"، موفق، "|"، خراب.خطا
    خراب.آزادسازی()

    ناپایا خالی := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(خالی، "GGUF" برگردان تهی*، ۴)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(خالی، ۳)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(خالی، ۰)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(خالی، ۰)
    ناپایا مدل := جی‌جی‌یو‌اف.تجزیه جی‌جی‌یو‌اف(خالی، موفق)
    سرچاپ "مدل خالی:"، موفق، مدل.نسخه، مدل.کلیدها.طول()، مدل.تانسورها.طول()
    سرچاپ "معماری: [" + مدل.فراداده رشته("general.architecture") + "]"
    سرچاپ "طول بافت:"، مدل.فراداده صحیح("llama.context_length"، ۲۰۴۸)
    سرچاپ "نمایه تانسور:"، مدل.نمایه تانسور("token_embd.weight")، "نمایه فراداده:"، مدل.نمایه فراداده("tokenizer.tokens")
    مدل.آزادسازی()
