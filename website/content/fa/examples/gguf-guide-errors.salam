واردسازی جی‌جی‌یو‌اف
واردسازی فشرده سازی
واردسازی کدگذاری.دودویی

تابع ریشه خطادار:
    ناپایا آشغال := فشرده سازی.بافر بایت جدید()
    متن := "PK this is a zip archive, not a model file"
    فشرده سازی.افزودن بایت‌ها(آشغال، متن برگردان تهی*، متن.طول())
    تلاش:
        جی‌جی‌یو‌اف.تجزیه جی‌جی‌یو‌اف(آشغال)
    گرفتن خطا خ:
        سرچاپ "فایل zip:"، خ.نام نوع()، "|"، خ.به رشته()، "|"، خ.کد
    پایان
    فشرده سازی.آزادسازی بافر(آشغال)

    ناپایا بریده := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(بریده، "GGUF" برگردان تهی*، ۴)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(بریده، ۳)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(بریده، ۱)
    تلاش:
        جی‌جی‌یو‌اف.تجزیه جی‌جی‌یو‌اف(بریده)
    گرفتن خطا خ:
        سرچاپ "بریده:"، خ.به رشته()
    پایان
    فشرده سازی.آزادسازی بافر(بریده)

    ناپایا خالی := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(خالی، "GGUF" برگردان تهی*، ۴)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(خالی، ۳)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(خالی، ۰)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(خالی، ۰)
    ناپایا مدل := تلاش جی‌جی‌یو‌اف.تجزیه جی‌جی‌یو‌اف(خالی)
    سرچاپ "مدل خالی:"، مدل.نسخه، مدل.کلیدها.طول()، مدل.تانسورها.طول()
    سرچاپ "معماری: [" + مدل.فراداده رشته("general.architecture") + "]"
    سرچاپ "طول بافت:"، مدل.فراداده صحیح("llama.context_length"، ۲۰۴۸)
    سرچاپ "نمایه تانسور:"، مدل.نمایه تانسور("token_embd.weight")، "نمایه فراداده:"، مدل.نمایه فراداده("tokenizer.tokens")
    مدل.آزادسازی()
پایان
