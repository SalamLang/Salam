واردسازی جی‌جی‌یو‌اف
واردسازی سیستم عامل
واردسازی رشته

تابع ریشه:
    آرگ ها := سیستم عامل.آرگومان ها()
    اگر آرگ ها.طول() < ۲:
        سرچاپ "روش کاربرد: gguf-guide-inspect model.gguf"
        برگشت ۱
    پایان
    ناپایا موفق := نادرست
    ناپایا مدل := جی‌جی‌یو‌اف.بارگذاری جی‌جی‌یو‌اف(آرگ ها.بگیر(۱)، موفق)
    اگر وارونه موفق:
        سرچاپ "مدل GGUF نیست:"، مدل.error
        برگشت ۱
    پایان
    معماری := مدل.فراداده رشته("general.architecture")
    سرچاپ "نام"، مدل.فراداده رشته("general.name")
    سرچاپ "معماری"، معماری
    سرچاپ "لایه‌ها"، مدل.فراداده صحیح(معماری + ".block_count"، ۰)
    سرچاپ "بافت"، مدل.فراداده صحیح(معماری + ".context_length"، ۰)
    سرچاپ "جاسازی"، مدل.فراداده صحیح(معماری + ".embedding_length"، ۰)
    واژگان := مدل.نمایه فراداده("tokenizer.ggml.tokens")
    اگر واژگان >= ۰:
        سرچاپ "واژگان"، مدل.values.بگیر(واژگان).strs.طول()
    پایان
    ناپایا وزن ها := ۰ برگردان صحیح۶۴
    ناپایا بایت ها := ۰ برگردان صحیح۶۴
    ناپایا نوع ها := نگاشت {} برگردان نگاشت<صحیح، صحیح>
    تکرار مدل.tensors.طول() در ی:
        اطلاعات := مدل.tensors.بگیر(ی)
        وزن ها += اطلاعات.شمار() برگردان صحیح۶۴
        بایت ها += جی‌جی‌یو‌اف.بایت‌های تانسور(مدل، ی) برگردان صحیح۶۴
        اگر نوع ها.دارد(اطلاعات.ggml_type):
            نوع ها.درج(اطلاعات.ggml_type، نوع ها.بگیر(اطلاعات.ggml_type) + ۱)
        وگرنه:
            نوع ها.درج(اطلاعات.ggml_type، ۱)
        پایان
    پایان
    سرچاپ مدل.tensors.طول()، "تانسور،"، وزن ها / ۱۰۰۰۰۰۰، "میلیون وزن،"، بایت ها / ۱۰۴۸۵۷۶، "مبی‌بایت"
    سرچاپ "تانسورهای Q8_0:"، نوع ها.دارد(جی‌جی‌یو‌اف.نوع کوانتیزه هشت صفر)، "Q4_0:"، نوع ها.دارد(جی‌جی‌یو‌اف.نوع کوانتیزه چهار صفر)، "F16:"، نوع ها.دارد(جی‌جی‌یو‌اف.نوع اعشاری شانزده)
    سرچاپ "قالب گفتگو دارد:"، رشته.شامل است(مدل.فراداده رشته("tokenizer.chat_template")، "{%")
    مدل.آزادسازی()
پایان
