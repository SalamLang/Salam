واردسازی جی‌جی‌یو‌اف
واردسازی فشرده سازی
واردسازی کدگذاری.دودویی
واردسازی تبدیل

تابع نوشتن نام(ب &: فشرده سازی.بافر بایت، متن: رشته):
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(ب، متن.طول() برگردان صحیح۶۴)
    فشرده سازی.افزودن بایت‌ها(ب، متن برگردان تهی*، متن.طول())
پایان

تابع ریشه:
    ناپایا ب := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(ب، "GGUF" برگردان تهی*، ۴)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(ب، ۳)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(ب، ۱)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(ب، ۰)
    نوشتن نام(ب، "token_embd.weight")
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(ب، ۲)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(ب، ۳۲)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(ب، ۲)
    دودویی.نوشتن طبیعی۳۲ کوچک‌انتها(ب، جی‌جی‌یو‌اف.نوع کوانتیزه هشت صفر)
    دودویی.نوشتن طبیعی۶۴ کوچک‌انتها(ب، ۰)
    تا فشرده سازی.طول بافر(ب) % ۳۲ != ۰:
        دودویی.نوشتن طبیعی۸(ب، ۰)
    پایان
    تکرار ۲ در سطر:
        دودویی.نوشتن طبیعی۱۶ کوچک‌انتها(ب، 0x2E66)
        تکرار ۳۲ در ستون:
            عدد := (سطر * ۳۲ + ستون) * ۳ - ۶۰
            دودویی.نوشتن طبیعی۸(ب، عدد & ۲۵۵)
        پایان
    پایان
    ناپایا موفق := نادرست
    ناپایا مدل := جی‌جی‌یو‌اف.تجزیه جی‌جی‌یو‌اف(ب، موفق)
    نمایه := مدل.نمایه تانسور("token_embd.weight")
    اطلاعات := مدل.تانسورها.بگیر(نمایه)
    سرچاپ اطلاعات.نام، "ابعاد"، اطلاعات.ابعاد.بگیر(۰)، "x"، اطلاعات.ابعاد.بگیر(۱)، "در"، جی‌جی‌یو‌اف.بایت‌های تانسور(مدل، نمایه)، "بایت"
    ناپایا وزن‌ها := جی‌جی‌یو‌اف.بارگذاری تانسور اعشاری(مدل، نمایه، موفق)
    سرچاپ "بار شد:"، موفق، "شکل"، وزن‌ها.شکل.بگیر(۰)، "x"، وزن‌ها.شکل.بگیر(۱)
    ناپایا آغاز := ""
    تکرار ۴ در ستون:
        آغاز = آغاز + " " + تبدیل.قالب اعشار با دقت(وزن‌ها.در دو(۱، ستون)، ۳)
    پایان
    سرچاپ "جاسازی نشانه‌ی ۱ با این‌ها شروع می‌شود:" + آغاز
    وزن‌ها.آزادسازی()
    مدل.آزادسازی()
پایان
