واردسازی گوگل
واردسازی ورودی خروجی
واردسازی شبکه.اچ تی تی پی

تابع فرستادن اعلان(حساب: گوگل.حساب سرویس، توکن دستگاه: رشته، عنوان: رشته، متن: رشته): منطقی:
    ناپایا گرفت := نادرست
    توکن := گوگل.توکن دسترسی(حساب، گوگل.دامنه اف سی ام، گرفت)
    اگر وارونه گرفت:
        سرچاپ "توکن دسترسی گرفته نشد"
        برگشت نادرست
    پایان
    نشانی := "https://fcm.googleapis.com/v1/projects/" + حساب.شناسه پروژه + "/messages:send"
    پیام := ```
        {"message": {"token": "${{ توکن دستگاه }}", "notification": {"title": "${{ عنوان }}", "body": "${{ متن }}"}}}
        ```
    ناپایا سرآیندها := اچ تی تی پی.سرصفحه جدید()
    سرآیندها.درج("Authorization"، گوگل.سرآیند مجوز(توکن))
    سرآیندها.درج("Content-Type"، "application/json")
    پ := اچ تی تی پی.ارسال با(نشانی، پیام، سرآیندها)
    اگر اچ تی تی پی.وضعیت(پ) != ۲۰۰:
        سرچاپ "پاسخ FCM:"، اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.بدنه(پ)
        برگشت نادرست
    پایان
    سرچاپ "فرستاده شد:"، اچ تی تی پی.بدنه(پ)
    برگشت درست
پایان

تابع ریشه:
    حساب := گوگل.تجزیه حساب سرویس(ورودی خروجی.خواندن پرونده("service-account.json"))
    اگر وارونه حساب.موفق:
        سرچاپ "service-account.json پیدا نشد یا نامعتبر است"
        برگشت ۱
    پایان
    فرستادن اعلان(حساب، "DEVICE_REGISTRATION_TOKEN"، "سفارش فرستاده شد"، "بسته‌ی شما در راه است")
    فرستادن اعلان(حساب، "DEVICE_REGISTRATION_TOKEN"، "تحویل شد"، "بسته‌ی شما رسید")
    برگشت ۰
پایان
