واردسازی گوگل
واردسازی ورودی خروجی

تابع بارگذاری(مسیر: رشته): گوگل.حساب سرویس:
    متن := ورودی خروجی.خواندن پرونده(مسیر)
    اگر متن == "":
        سرچاپ "خواندن"، مسیر، "ممکن نیست"
        برگشت گوگل.حساب سرویس {}
    پایان
    حساب := گوگل.تجزیه حساب سرویس(متن)
    اگر وارونه حساب.موفق:
        سرچاپ مسیر، "پرونده‌ی حساب سرویس نیست: client_email یا private_key ندارد"
    پایان
    برگشت حساب
پایان

تابع ریشه:
    ورودی خروجی.نوشتن پرونده("good.json"، `{"type":"service_account","project_id":"shop-prod","client_email":"push@shop-prod.iam.gserviceaccount.com","private_key":"-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"}`)
    ورودی خروجی.نوشتن پرونده("broken.json"، `{"type":"service_account","project_id":"shop-prod"}`)
    هر م در ["good.json"، "broken.json"، "missing.json"]:
        حساب := بارگذاری(م)
        اگر حساب.موفق:
            سرچاپ "پروژه‌ی"، حساب.شناسه پروژه، "با حساب"، حساب.ایمیل حساب
            سرچاپ "کلید بار شد:"، حساب.کلید خصوصی.طول() > ۰
        پایان
    پایان
پایان
