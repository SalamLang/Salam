واردسازی گوگل
واردسازی ورودی خروجی
واردسازی شبکه.اچ تی تی پی
واردسازی کدگذاری.نشانی وب

تابع بارگذاری(حساب: گوگل.حساب سرویس، سطل: رشته، نام: رشته، محتوا: رشته، نوع محتوا: رشته): منطقی:
    ناپایا گرفت := نادرست
    توکن := گوگل.توکن دسترسی(حساب، گوگل.دامنه ذخیره‌سازی، گرفت)
    اگر وارونه گرفت:
        برگشت نادرست
    پایان
    مقصد := "https://storage.googleapis.com/upload/storage/v1/b/" + سطل + "/o?uploadType=media&name=" + نشانی وب.کدگذاری بخش مسیر(نام)
    ناپایا سرآیندها := اچ تی تی پی.سرصفحه جدید()
    سرآیندها.درج("Authorization"، گوگل.سرآیند مجوز(توکن))
    سرآیندها.درج("Content-Type"، نوع محتوا)
    پ := اچ تی تی پی.ارسال با(مقصد، محتوا، سرآیندها)
    سرچاپ نام، "->"، اچ تی تی پی.وضعیت(پ)
    برگشت اچ تی تی پی.وضعیت(پ) == ۲۰۰
پایان

تابع ریشه:
    حساب := گوگل.تجزیه حساب سرویس(ورودی خروجی.خواندن پرونده("service-account.json"))
    اگر وارونه حساب.موفق:
        سرچاپ "service-account.json پیدا نشد یا نامعتبر است"
        برگشت ۱
    پایان
    بارگذاری(حساب، "my-bucket"، "reports/2026-10.csv"، "day,sales\n1,120\n2,95\n"، "text/csv")
    بارگذاری(حساب، "my-bucket"، "notes/salam.txt"، "سلام"، "text/plain; charset=utf-8")
    گوگل.فراموش کردن توکن(حساب)
    برگشت ۰
پایان
