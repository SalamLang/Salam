واردسازی گراف

تابع ریشه:
    دفترها := ["مرکزی"، "شمال"، "جنوب"، "شرق"، "غرب"]
    ناپایا محل‌ها := گراف.بی‌جهت جدید(۵)
    دیرکن محل‌ها.آزادسازی()
    هر ی، نام در دفترها:
        محل‌ها.تنظیم نام(ی، نام)
    پایان
    محل‌ها.افزودن یال وزن‌دار(۰، ۱، ۴.۰)
    محل‌ها.افزودن یال وزن‌دار(۰، ۲، ۳.۰)
    محل‌ها.افزودن یال وزن‌دار(۰، ۳، ۶.۰)
    محل‌ها.افزودن یال وزن‌دار(۰، ۴، ۵.۰)
    محل‌ها.افزودن یال وزن‌دار(۱، ۳، ۲.۰)
    محل‌ها.افزودن یال وزن‌دار(۲، ۴، ۲.۵)
    محل‌ها.افزودن یال وزن‌دار(۳، ۴، ۷.۰)
    محل‌ها.ساخت()

    ناپایا برگزیده := وکتور {} برگردان وکتور<صحیح>
    دیرکن برگزیده.آزادکن()
    جمع := گراف.کروسکال(محل‌ها، برگزیده)
    سرچاپ برگزیده.طول()، "کابل، روی هم"، جمع، "کیلومتر:"
    هر یال در برگزیده:
        سرچاپ "  " + محل‌ها.نام(محل‌ها.سر یال(یال))، "-"، محل‌ها.نام(محل‌ها.ته یال(یال))، محل‌ها.وزن یال(یال)، "کیلومتر"
    پایان
    سرچاپ "همه‌ی گزینه‌ها با هم:"، گراف.وزن کل(محل‌ها)، "کیلومتر"

    ناپایا درخت := گراف.درخت پوشای کمینه(محل‌ها)
    دیرکن درخت.آزادسازی()
    چاپ گراف.به مرمید(درخت)
پایان
