واردسازی گراف

تابع ریشه:
    ناپایا شبکه := گراف.از فهرست یال("0 1\n1 2\n2 0\n2 3\n3 4\n4 5\n5 3\n6 7"، ۸، نادرست)
    دیرکن شبکه.آزادسازی()
    سرچاپ شبکه.مرتبه()، "دستگاه،"، شبکه.اندازه()، "پیوند"
    سرچاپ "همبند:"، گراف.همبند است(شبکه)، "بخش‌ها:"، گراف.شمار مؤلفه(شبکه)
    اندازه‌ها := گراف.اندازه مؤلفه‌ها(شبکه)
    سرچاپ "اندازه‌ی بخش‌ها:"، اندازه‌ها

    ناپایا مؤلفه‌ی دستگاه := وکتور {} برگردان وکتور<صحیح>
    دیرکن مؤلفه‌ی دستگاه.آزادکن()
    _ := گراف.مؤلفه‌ها(شبکه، مؤلفه‌ی دستگاه)
    سرچاپ "دستگاه ۷ در بخش"، مؤلفه‌ی دستگاه.بگیر(۷)، "است، با دستگاه ۶:"، مؤلفه‌ی دستگاه.بگیر(۶) برابر مؤلفه‌ی دستگاه.بگیر(۷)

    برش := گراف.نقاط برش(شبکه)
    سرچاپ "دستگاه‌هایی که خرابی‌شان شبکه را دو تکه می‌کند:"، برش
    پل‌ها := گراف.پل‌ها(شبکه)
    هر یال در پل‌ها:
        سرچاپ "پیوند تکی:"، شبکه.سر یال(یال)، "-"، شبکه.ته یال(یال)
    پایان
پایان
