واردسازی گراف

تابع متن مسیر(گ &: گراف.گراف، مسیر: وکتور<صحیح>): رشته:
    ناپایا متن := ""
    هر ی، گره در مسیر:
        اگر ی بزرگتر ۰: متن = متن + " <- " پایان
        متن = متن + گ.نام(گره)
    پایان
    برگشت متن
پایان

تابع ریشه:
    ناپایا جاده‌ها := گراف.بی‌جهت جدید(۶)
    دیرکن جاده‌ها.آزادسازی()
    هر ی، شهر در ["تهران"، "قم"، "کاشان"، "اصفهان"، "اراک"، "یزد"]:
        جاده‌ها.تنظیم نام(ی، شهر)
    پایان
    جاده‌ها.افزودن یال وزن‌دار(۰، ۱، ۱۴۰.۰)
    جاده‌ها.افزودن یال وزن‌دار(۱، ۲، ۱۰۵.۰)
    جاده‌ها.افزودن یال وزن‌دار(۲، ۳، ۲۱۰.۰)
    جاده‌ها.افزودن یال وزن‌دار(۱، ۴، ۱۳۵.۰)
    جاده‌ها.افزودن یال وزن‌دار(۴، ۳، ۲۸۰.۰)
    جاده‌ها.افزودن یال وزن‌دار(۳، ۵، ۳۲۰.۰)
    جاده‌ها.افزودن یال وزن‌دار(۲، ۵، ۵۶۰.۰)
    جاده‌ها.ساخت()

    سفر := گراف.کوتاه‌ترین مسیر(جاده‌ها، ۰، ۵)
    سرچاپ متن مسیر(جاده‌ها، سفر)، "|"، گراف.طول کوتاه‌ترین مسیر(جاده‌ها، ۰، ۵)، "کیلومتر"
    گام‌ها := گراف.مسیر گامی(جاده‌ها، ۰، ۵)
    سرچاپ "کمترین توقف:"، متن مسیر(جاده‌ها، گام‌ها)
    فاصله‌ها := گراف.فاصله دایکسترا(جاده‌ها، ۰)
    هر ی، فاصله در فاصله‌ها:
        سرچاپ "  تهران تا"، جاده‌ها.نام(ی)، فاصله، "کیلومتر"
    پایان
پایان
