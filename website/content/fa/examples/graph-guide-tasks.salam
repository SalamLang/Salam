واردسازی گراف

تابع ریشه:
    کارها := ["طراحی"، "پایگاه داده"، "سمت سرور"، "رابط کاربری"، "آزمون"، "انتشار"]
    روزها := [۳.۰، ۲.۰، ۵.۰، ۴.۰، ۲.۰، ۱.۰]
    ناپایا برنامه := گراف.جهت‌دار جدید(۶)
    دیرکن برنامه.آزادسازی()
    هر ی، نام در کارها:
        برنامه.تنظیم نام(ی، نام)
    پایان
    هر جفت در ["0 1"، "0 3"، "1 2"، "2 4"، "3 4"، "4 5"]:
        بخش‌ها := جفت.بشکاف(" ")
        مبدأ := بخش‌ها.بگیر(۰).به صحیح()
        برنامه.افزودن یال وزن‌دار(مبدأ، بخش‌ها.بگیر(۱).به صحیح()، روزها[مبدأ])
    پایان
    برنامه.ساخت()

    ناپایا ترتیب := وکتور {} برگردان وکتور<صحیح>
    دیرکن ترتیب.آزادکن()
    اگر گراف.مرتب‌سازی توپولوژیک(برنامه، ترتیب) برابر نادرست:
        سرچاپ "برنامه دور دارد"
        برگشت ۱
    پایان
    ناپایا خط := "ترتیب:"
    هر کار در ترتیب:
        خط = خط + " " + برنامه.نام(کار)
    پایان
    سرچاپ خط

    ناپایا لایه := وکتور {} برگردان وکتور<صحیح>
    دیرکن لایه.آزادکن()
    مرحله‌ها := گراف.لایه‌های توپولوژیک(برنامه، لایه)
    سرچاپ "مرحله‌ها:"، مرحله‌ها
    هر ی، نام در کارها:
        سرچاپ "  مرحله‌ی"، لایه.بگیر(ی)، نام
    پایان

    بحرانی := گراف.مسیر بحرانی(برنامه)
    ناپایا مسیر := "مسیر بحرانی:"
    هر کار در بحرانی:
        مسیر = مسیر + " " + برنامه.نام(کار)
    پایان
    سرچاپ مسیر
پایان
