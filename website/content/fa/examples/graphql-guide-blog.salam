واردسازی گراف‌کیوال
واردسازی کدگذاری.مقدار

ناپایا نویسندگان := مقدار.آرایه جدید()
ناپایا نوشته‌ها := مقدار.آرایه جدید()

تابع شخص(شناسه: صحیح۶۴، نام: رشته): مقدار.مقدار:
    ناپایا ش := مقدار.شیء جدید()
    مقدار.تنظیم کلید(ش، "id"، مقدار.مقدار صحیح(شناسه))
    مقدار.تنظیم کلید(ش، "name"، مقدار.مقدار رشته(نام))
    برگشت ش
پایان

تابع نوشته(شناسه: صحیح۶۴، عنوان: رشته، نویسنده: صحیح۶۴): مقدار.مقدار:
    ناپایا ن := مقدار.شیء جدید()
    مقدار.تنظیم کلید(ن، "id"، مقدار.مقدار صحیح(شناسه))
    مقدار.تنظیم کلید(ن، "title"، مقدار.مقدار رشته(عنوان))
    مقدار.تنظیم کلید(ن، "authorId"، مقدار.مقدار صحیح(نویسنده))
    برگشت ن
پایان

تابع همه نوشته‌ها(جا: صحیح۶۴):
    گراف‌کیوال.حل(جا، نوشته‌ها)
پایان

تابع نویسنده نوشته(جا: صحیح۶۴):
    خواسته := مقدار.به صحیح(گراف‌کیوال.فیلد والد(جا، "authorId"))
    تکرار مقدار.طول آرایه(نویسندگان) در ش:
        ن := مقدار.عضو آرایه(نویسندگان، ش)
        اگر مقدار.به صحیح(مقدار.مقدار کلید(ن، "id")) == خواسته:
            گراف‌کیوال.حل(جا، ن)
            برگشت
        پایان
    پایان
    گراف‌کیوال.حل تهی(جا)
پایان

تابع ریشه:
    مقدار.افزودن به آرایه(نویسندگان، شخص(۱، "سارا"))
    مقدار.افزودن به آرایه(نویسندگان، شخص(۲، "امید"))
    مقدار.افزودن به آرایه(نوشته‌ها، نوشته(۱۰، "سلام GraphQL"، ۱))
    مقدار.افزودن به آرایه(نوشته‌ها، نوشته(۱۱، "سلام و SQL"، ۲))
    مقدار.افزودن به آرایه(نوشته‌ها، نوشته(۱۲، "حل‌کننده‌ها به زبان ساده"، ۱))
    ناپایا خ := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای نحوی، "")
    ناپایا طرح := گراف‌کیوال.تجزیه طرح‌واره(`
type Author { id: Int! name: String! }
type Post { id: Int! title: String! author: Author }
type Query { posts: [Post!]! }`، خ)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Query"، "posts"، همه نوشته‌ها)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Post"، "author"، نویسنده نوشته)
    ناپایا ن۱ := گراف‌کیوال.اجرای ساده(طرح، `{ posts { title author { name } } }`)
    سرچاپ گراف‌کیوال.نتیجه به جیسون قطعی(ن۱)
    گراف‌کیوال.آزادسازی نتیجه(ن۱)
    ناپایا ن۲ := گراف‌کیوال.اجرای ساده(طرح، `{ posts { id } }`)
    سرچاپ گراف‌کیوال.نتیجه به جیسون قطعی(ن۲)
    گراف‌کیوال.آزادسازی نتیجه(ن۲)
    گراف‌کیوال.آزادسازی طرح‌واره(طرح)
پایان
