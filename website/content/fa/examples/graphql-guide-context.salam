واردسازی گراف‌کیوال
واردسازی کدگذاری.مقدار

تابع کاربر جاری(جا: صحیح۶۴): رشته:
    زمینه := گراف‌کیوال.زمینه(جا)
    اگر مقدار.شیء است(زمینه) و مقدار.شیء دارد(زمینه، "user"):
        برگشت مقدار.به رشته(مقدار.مقدار کلید(زمینه، "user"))
    پایان
    برگشت ""
پایان

تابع من(جا: صحیح۶۴):
    نام := کاربر جاری(جا)
    اگر نام == "":
        گراف‌کیوال.حل تهی(جا)
        برگشت
    پایان
    گراف‌کیوال.حل رشته(جا، نام)
پایان

تابع حقوق(جا: صحیح۶۴):
    اگر کاربر جاری(جا) != "admin":
        گراف‌کیوال.شکست(جا، "فقط مدیر می‌تواند فهرست حقوق را بخواند")
        برگشت
    پایان
    گراف‌کیوال.حل عددی(جا، ۱۸۲۰۰۰)
پایان

تابع پرسش(طرح: گراف‌کیوال.طرح‌واره، کاربر: رشته):
    ناپایا زمینه := مقدار.شیء جدید()
    اگر کاربر != "":
        مقدار.تنظیم کلید(زمینه، "user"، مقدار.مقدار رشته(کاربر))
    پایان
    ناپایا ن := گراف‌کیوال.اجرای منبع(طرح، `{ me payroll }`، ""، مقدار.مقدار تهی()، مقدار.مقدار تهی()، زمینه)
    سرچاپ "[" + کاربر + "]"، گراف‌کیوال.نتیجه به جیسون قطعی(ن)
    گراف‌کیوال.آزادسازی نتیجه(ن)
پایان

تابع ریشه:
    ناپایا خ := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای نحوی، "")
    ناپایا طرح := گراف‌کیوال.تجزیه طرح‌واره(`type Query { me: String payroll: Int }`، خ)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Query"، "me"، من)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Query"، "payroll"، حقوق)
    پرسش(طرح، "")
    پرسش(طرح، "سارا")
    پرسش(طرح، "admin")
    گراف‌کیوال.آزادسازی طرح‌واره(طرح)
پایان
