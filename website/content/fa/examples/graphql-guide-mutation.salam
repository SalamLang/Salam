واردسازی گراف‌کیوال
واردسازی کدگذاری.مقدار

ناپایا کارها := مقدار.آرایه جدید()

تابع فهرست(جا: صحیح۶۴):
    گراف‌کیوال.حل(جا، کارها)
پایان

تابع افزودن کار(جا: صحیح۶۴):
    داده := گراف‌کیوال.آرگومان(جا، "input")
    عنوان := مقدار.به رشته(مقدار.مقدار کلید(داده، "title"))
    اگر عنوان == "":
        گراف‌کیوال.شکست(جا، "عنوان نباید خالی باشد")
        برگشت
    پایان
    ناپایا ک := مقدار.شیء جدید()
    مقدار.تنظیم کلید(ک، "id"، مقدار.مقدار صحیح(مقدار.طول آرایه(کارها) + ۱))
    مقدار.تنظیم کلید(ک، "title"، مقدار.مقدار رشته(عنوان))
    ناپایا انجام := نادرست
    اگر مقدار.شیء دارد(داده، "done"):
        انجام = مقدار.به منطقی(مقدار.مقدار کلید(داده، "done"))
    پایان
    مقدار.تنظیم کلید(ک، "done"، مقدار.مقدار منطقی(انجام))
    مقدار.افزودن به آرایه(کارها، ک)
    گراف‌کیوال.حل(جا، ک)
پایان

تابع ریشه:
    ناپایا خ := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای نحوی، "")
    ناپایا طرح := گراف‌کیوال.تجزیه طرح‌واره(`
type Todo { id: Int! title: String! done: Boolean! }
input TodoInput { title: String! done: Boolean = false }
type Query { todos: [Todo!]! }
type Mutation { addTodo(input: TodoInput!): Todo }`، خ)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Query"، "todos"، فهرست)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Mutation"، "addTodo"، افزودن کار)

    افزودن := `mutation Add($t: TodoInput!) { addTodo(input: $t) { id title done } }`
    هر عنوان در ["نوشتن گزارش"، ""، "فرستادن صورتحساب‌ها"]:
        ناپایا فیلدها := مقدار.شیء جدید()
        مقدار.تنظیم کلید(فیلدها، "title"، مقدار.مقدار رشته(عنوان))
        ناپایا متغیرها := مقدار.شیء جدید()
        مقدار.تنظیم کلید(متغیرها، "t"، فیلدها)
        ناپایا ن := گراف‌کیوال.اجرای منبع(طرح، افزودن، "Add"، متغیرها، مقدار.مقدار تهی()، مقدار.مقدار تهی())
        اگر گراف‌کیوال.نتیجه موفق(ن):
            سرچاپ گراف‌کیوال.نتیجه به جیسون قطعی(ن)
        وگرنه:
            سرچاپ "خطا:"، گراف‌کیوال.پیام خطای نتیجه(ن)
        پایان
        گراف‌کیوال.آزادسازی نتیجه(ن)
    پایان
    ناپایا همه := گراف‌کیوال.اجرای ساده(طرح، `{ todos { id title } }`)
    سرچاپ گراف‌کیوال.نتیجه به جیسون قطعی(همه)
    گراف‌کیوال.آزادسازی نتیجه(همه)
    ناپایا بد := گراف‌کیوال.اجرای ساده(طرح، `mutation { addTodo(input: { done: true }) { id } }`)
    سرچاپ گراف‌کیوال.پیام خطای نتیجه(بد)
    گراف‌کیوال.آزادسازی نتیجه(بد)
    گراف‌کیوال.آزادسازی طرح‌واره(طرح)
پایان
