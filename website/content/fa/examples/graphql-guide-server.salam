واردسازی گراف‌کیوال
واردسازی کدگذاری.مقدار
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی رشته

ناپایا طرح := گراف‌کیوال.طرح‌واره جدید()

تابع من(جا: صحیح۶۴):
    زمینه := گراف‌کیوال.زمینه(جا)
    اگر مقدار.شیء دارد(زمینه، "user"):
        گراف‌کیوال.حل رشته(جا، مقدار.به رشته(مقدار.مقدار کلید(زمینه، "user")))
        برگشت
    پایان
    گراف‌کیوال.حل تهی(جا)
پایان

تابع پژواک(جا: صحیح۶۴):
    گراف‌کیوال.حل رشته(جا، گراف‌کیوال.آرگومان رشته(جا، "text"))
پایان

تابع نقطه پایانی(ز: صحیح۶۴):
    ناپایا زمینه درخواست := مقدار.شیء جدید()
    مجوز := اچ تی تی پی.سرصفحه(ز، "Authorization")
    اگر رشته.شروع با(مجوز، "Bearer "):
        مقدار.تنظیم کلید(زمینه درخواست، "user"، مقدار.مقدار رشته(رشته.حذف پیشوند(مجوز، "Bearer ")))
    پایان
    پاسخ := گراف‌کیوال.رسیدگی به وب(طرح، اچ تی تی پی.روش(ز)، اچ تی تی پی.سرصفحه(ز، "Content-Type")، اچ تی تی پی.بدنه(ز)، اچ تی تی پی.پرسمان خام(ز)، مقدار.مقدار تهی()، زمینه درخواست)
    اچ تی تی پی.تنظیم وضعیت(ز، پاسخ.وضعیت)
    اچ تی تی پی.تنظیم سرصفحه(ز، "Content-Type"، پاسخ.نوع محتوا)
    اچ تی تی پی.متن(ز، پاسخ.بدنه)
پایان

تابع ریشه:
    ناپایا خ := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای نحوی، "")
    گراف‌کیوال.تجزیه در طرح‌واره(طرح، "type Query { me: String echo(text: String!): String! }"، خ)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Query"، "me"، من)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Query"، "echo"، پژواک)
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/graphql"، نقطه پایانی)
    مسیریاب.دریافت(م، "/graphql"، نقطه پایانی)
    ناپایا س := اچ تی تی پی.سرور جدید(۸۰۹۰)
    اچ تی تی پی.استفاده(س، م)
    سرچاپ "GraphQL روی http://127.0.0.1:8090/graphql"
    اچ تی تی پی.اجرا(س)
پایان
