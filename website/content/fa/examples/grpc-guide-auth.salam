واردسازی جی آر پی سی
واردسازی همگام سازی
واردسازی فشرده سازی

ناپایا سرور := جی آر پی سی.سرور جدید(۰)
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع موجودی(ف: صحیح۶۴):
    ناپایا رسید := نادرست
    حساب := جی آر پی سی.دریافت متن(ف، رسید)
    نشانه := جی آر پی سی.دریافت فراداده(جی آر پی سی.فراداده فراخوان(ف)، "authorization")
    اگر نشانه == "":
        جی آر پی سی.شکست(ف، جی آر پی سی.وضعیت احراز نشده، "نشانه فرستاده نشده")
        برگشت
    پایان
    اگر نشانه != "Bearer good-token":
        جی آر پی سی.شکست(ف، جی آر پی سی.وضعیت دسترسی رد شد، "این نشانه اجازه‌ی خواندن " + حساب + " را ندارد")
        برگشت
    پایان
    _ := جی آر پی سی.ارسال متن(ف، حساب + ": 1250")
    جی آر پی سی.تنظیم وضعیت(ف، جی آر پی سی.وضعیت بدون خطا، "")
پایان

تابع اجرای سرور():
    _ := جی آر پی سی.گوش دادن(سرور)
    همگام سازی.اتمام(آماده)
    _ := جی آر پی سی.خدمت به تعداد(سرور، ۱)
پایان

تابع ریشه:
    جی آر پی سی.ثبت متد("/bank.Accounts/Balance"، موجودی)
    همگام سازی.افزودن(آماده، ۱)
    ن := نخ‌ساز(اجرای سرور)
    همگام سازی.انتظار(آماده)
    ناپایا کانال := جی آر پی سی.اتصال("127.0.0.1"، جی آر پی سی.درگاه(سرور))
    جی آر پی سی.تنظیم مهلت(کانال، ۵۰۰۰)
    هر نشانه در [""، "Bearer old-token"، "Bearer good-token"]:
        ناپایا فراداده := جی آر پی سی.فراداده جدید()
        اگر نشانه != "":
            _ := جی آر پی سی.افزودن فراداده(فراداده، "authorization"، نشانه)
        پایان
        ناپایا وضعیت := جی آر پی سی.وضعیت {}
        پاسخ := جی آر پی سی.فراخوان یگانه(کانال، "/bank.Accounts/Balance"، فشرده سازی.بافر از رشته("acc-42")، فراداده، وضعیت)
        اگر جی آر پی سی.وضعیت موفق(وضعیت):
            سرچاپ "موفق:"، فشرده سازی.بافر به رشته(پاسخ)
        وگرنه:
            سرچاپ جی آر پی سی.نام وضعیت(وضعیت.کد)، "(" + وضعیت.کد + "):"، وضعیت.پیام
        پایان
    پایان
    جی آر پی سی.بستن کانال(کانال)
    نخ‌پیوند(ن)
    جی آر پی سی.توقف سرور(سرور)
پایان
