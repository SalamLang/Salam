واردسازی جی آر پی سی
واردسازی کدگذاری.پروتوباف
واردسازی فشرده سازی
واردسازی همگام سازی

ناپایا سرور := جی آر پی سی.سرور جدید(۰)
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع رمزگذاری کاربر(شناسه: صحیح، نام: رشته): فشرده سازی.بافر بایت:
    ناپایا ب := فشرده سازی.بافر بایت جدید()
    پروتوباف.نوشتن برچسب(ب، ۱، پروتوباف.نوع سیم متغیر)
    پروتوباف.نوشتن عدد متغیر(ب، شناسه برگردان طبیعی۶۴)
    پروتوباف.نوشتن برچسب(ب، ۲، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن رشته طول‌دار(ب، نام)
    برگشت ب
پایان

تابع دریافت کاربر(ف: صحیح۶۴):
    ناپایا رسید := نادرست
    درخواست := جی آر پی سی.دریافت(ف، رسید)
    ناپایا خواننده := فشرده سازی.خواننده از بافر(درخواست)
    ناپایا سالم := درست
    ناپایا فیلد := ۰
    ناپایا سیم := ۰
    پروتوباف.خواندن برچسب(خواننده، فیلد، سیم، سالم)
    شناسه := پروتوباف.خواندن عدد متغیر(خواننده، سالم) برگردان صحیح
    اگر وارونه سالم یا فیلد != ۱:
        جی آر پی سی.شکست(ف، جی آر پی سی.وضعیت آرگومان نامعتبر، "فیلد ۱ با شناسه‌ی کاربر لازم است")
        برگشت
    پایان
    اگر شناسه != ۷:
        جی آر پی سی.شکست(ف، جی آر پی سی.وضعیت یافت نشد، "کاربر " + شناسه + " وجود ندارد")
        برگشت
    پایان
    ناپایا پاسخ := رمزگذاری کاربر(۷، "مریم")
    _ := جی آر پی سی.ارسال(ف، پاسخ)
    فشرده سازی.آزادسازی بافر(پاسخ)
    جی آر پی سی.تنظیم وضعیت(ف، جی آر پی سی.وضعیت بدون خطا، "")
پایان

تابع اجرای سرور():
    _ := جی آر پی سی.گوش دادن(سرور)
    همگام سازی.اتمام(آماده)
    _ := جی آر پی سی.خدمت به تعداد(سرور، ۱)
پایان

تابع پرسیدن(کانال &: جی آر پی سی.کانال، شناسه: صحیح):
    ناپایا درخواست := فشرده سازی.بافر بایت جدید()
    پروتوباف.نوشتن برچسب(درخواست، ۱، پروتوباف.نوع سیم متغیر)
    پروتوباف.نوشتن عدد متغیر(درخواست، شناسه برگردان طبیعی۶۴)
    ناپایا وضعیت := جی آر پی سی.وضعیت {}
    پاسخ := جی آر پی سی.فراخوان یگانه(کانال، "/users.Users/Get"، درخواست، جی آر پی سی.فراداده جدید()، وضعیت)
    فشرده سازی.آزادسازی بافر(درخواست)
    اگر وارونه جی آر پی سی.وضعیت موفق(وضعیت):
        سرچاپ "کاربر"، شناسه، "یعنی"، جی آر پی سی.متن وضعیت(وضعیت)
        برگشت
    پایان
    ناپایا خواننده := فشرده سازی.خواننده از بافر(پاسخ)
    ناپایا سالم := درست
    ناپایا فیلد := ۰
    ناپایا سیم := ۰
    پروتوباف.خواندن برچسب(خواننده، فیلد، سیم، سالم)
    شماره := پروتوباف.خواندن عدد متغیر(خواننده، سالم)
    پروتوباف.خواندن برچسب(خواننده، فیلد، سیم، سالم)
    سرچاپ "کاربر"، شماره، "نامش"، پروتوباف.خواندن رشته طول‌دار(خواننده، سالم)، "است"
پایان

تابع ریشه:
    جی آر پی سی.ثبت متد(جی آر پی سی.مسیر متد("users.Users"، "Get")، دریافت کاربر)
    همگام سازی.افزودن(آماده، ۱)
    ن := نخ‌ساز(اجرای سرور)
    همگام سازی.انتظار(آماده)
    ناپایا کانال := جی آر پی سی.اتصال("127.0.0.1"، جی آر پی سی.درگاه(سرور))
    جی آر پی سی.تنظیم مهلت(کانال، ۵۰۰۰)
    پرسیدن(کانال، ۷)
    پرسیدن(کانال، ۸)
    جی آر پی سی.بستن کانال(کانال)
    نخ‌پیوند(ن)
    جی آر پی سی.توقف سرور(سرور)
پایان
