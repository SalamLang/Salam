واردسازی جی آر پی سی
واردسازی فشرده سازی
واردسازی همگام سازی

ناپایا سرور := جی آر پی سی.سرور جدید(۰)
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع جمع کل(ف: صحیح۶۴):
    ناپایا جمع := ۰
    ناپایا تعداد := ۰
    ناپایا ادامه := درست
    تا ادامه:
        ناپایا رسید := نادرست
        خوانش := جی آر پی سی.دریافت متن(ف، رسید)
        اگر وارونه رسید:
            ادامه = نادرست
        وگرنه:
            جمع += خوانش.به صحیح()
            تعداد += ۱
        پایان
    پایان
    _ := جی آر پی سی.ارسال متن(ف، "" + تعداد + " خوانش، جمع " + جمع)
    جی آر پی سی.تنظیم وضعیت(ف، جی آر پی سی.وضعیت بدون خطا، "")
پایان

تابع اجرای سرور():
    _ := جی آر پی سی.گوش دادن(سرور)
    همگام سازی.اتمام(آماده)
    _ := جی آر پی سی.خدمت به تعداد(سرور، ۱)
پایان

تابع ریشه:
    جی آر پی سی.ثبت متد جریانی("/meter.Meter/Upload"، جمع کل، درست، نادرست)
    همگام سازی.افزودن(آماده، ۱)
    ن := نخ‌ساز(اجرای سرور)
    همگام سازی.انتظار(آماده)
    ناپایا کانال := جی آر پی سی.اتصال("127.0.0.1"، جی آر پی سی.درگاه(سرور))
    جی آر پی سی.تنظیم مهلت(کانال، ۵۰۰۰)
    فراخوان := جی آر پی سی.شروع فراخوان(کانال، "/meter.Meter/Upload"، جی آر پی سی.فراداده جدید())
    خوانش‌ها := ["12"، "7"، "30"، "1"]
    هر ش، خ در خوانش‌ها:
        ناپایا پیام := فشرده سازی.بافر از رشته(خ)
        _ := جی آر پی سی.ارسال پیام(کانال، فراخوان، پیام، ش == طول(خوانش‌ها) - ۱)
        فشرده سازی.آزادسازی بافر(پیام)
    پایان
    ناپایا رسید := نادرست
    پاسخ := جی آر پی سی.دریافت پیام(کانال، فراخوان، رسید)
    سرچاپ فشرده سازی.بافر به رشته(پاسخ)
    سرچاپ جی آر پی سی.متن وضعیت(جی آر پی سی.پایان فراخوان(کانال، فراخوان))
    جی آر پی سی.بستن کانال(کانال)
    نخ‌پیوند(ن)
    جی آر پی سی.توقف سرور(سرور)
پایان
