واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    ورودی_مقادیر := ["#3366aa"، "rgb(51 102 170 / 50%)"، "hsl(210, 50%, 40%)"، "mix(red, blue, 30%)"، "rgb(300, 0, 0)"، "hsl(210 50%)"، "darkgrey"، "dark grey"، "darkgray"، "lightgreem"، "rgb(51, 102 170)"، "#12345"]
    ناپایا پذیرفته := 0
    هر متن در ورودی_مقادیر:
        پیام_متنی := رنگ.خطا(متن)
        اگر پیام_متنی برابر "":
            ناپایا نویسه := رنگ.رنگ {}
            رنگ.تجزیه(متن، نویسه)
            سرچاپ "ok     "، متن، "=>"، رنگ.سی اس اس(نویسه)
            پذیرفته++
        وگرنه:
            سرچاپ "refused"، متن
            سرچاپ "       "، پیام_متنی
        پایان
    پایان
    سرچاپ پذیرفته، "of"، ورودی_مقادیر.طول()، "accepted"
پایان
