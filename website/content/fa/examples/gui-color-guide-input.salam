واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    inputs := ["#3366aa"، "rgb(51 102 170 / 50%)"، "hsl(210, 50%, 40%)"، "mix(red, blue, 30%)"، "rgb(300, 0, 0)"، "hsl(210 50%)"، "darkgrey"، "dark grey"، "darkgray"، "lightgreem"، "rgb(51, 102 170)"، "#12345"]
    ناپایا accepted := 0
    هر text در inputs:
        message := رنگ.خطا(text)
        اگر message برابر "":
            ناپایا c := رنگ.رنگ {}
            رنگ.تجزیه(text، c)
            سرچاپ "ok     "، text، "=>"، رنگ.سی اس اس(c)
            accepted++
        وگرنه:
            سرچاپ "refused"، text
            سرچاپ "       "، message
        پایان
    پایان
    سرچاپ accepted، "of"، inputs.طول()، "accepted"
پایان
