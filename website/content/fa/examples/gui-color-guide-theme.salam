واردسازی رابط گرافیکی.رنگ
واردسازی ریاضی

تابع r2(مقدار_محلی: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(مقدار_محلی * 100.0) / 100.0
پایان

تابع check(نام: رشته، متن: رنگ.رنگ، بازگشت: رنگ.رنگ):
    روشن := رنگ.نسبت تضاد(رنگ.روشن(متن)، رنگ.روشن(بازگشت))
    تیره := رنگ.نسبت تضاد(رنگ.تیره(متن)، رنگ.تیره(بازگشت))
    ناپایا حکم := "ok"
    اگر روشن کوچکتر 4.5 یا تیره کوچکتر 4.5:
        حکم = "too low for body text"
    پایان
    سرچاپ نام، "light"، r2(روشن)، "dark"، r2(تیره)، حکم
پایان

تابع ریشه:
    ناپایا برند := رنگ.رنگ {}
    اگر وارونه رنگ.تجزیه("#3366aa"، برند):
        برگشت 1
    پایان
    صفحه_مقدار := رنگ.روشن تیره(رنگ.هگز(0xffffff)، رنگ.هگز(0x121212))
    متن := رنگ.روشن تیره(رنگ.هگز(0x1a1a1a)، رنگ.هگز(0xeeeeee))
    تأکیدی := رنگ.روشن تیره(برند، رنگ.روشن تر(برند، 0.2))
    ملایم := رنگ.آمیختن(متن، صفحه_مقدار، 0.45)
    شناور := رنگ.روشن تیره(رنگ.تیره تر(برند، 0.08)، رنگ.روشن تر(برند، 0.28))
    سرچاپ "page   "، رنگ.سی اس اس(صفحه_مقدار)
    سرچاپ "text   "، رنگ.سی اس اس(متن)
    سرچاپ "accent "، رنگ.سی اس اس(تأکیدی)
    سرچاپ "muted  "، رنگ.سی اس اس(ملایم)
    سرچاپ "hover  "، رنگ.سی اس اس(شناور)
    check("text on page  "، متن، صفحه_مقدار)
    check("accent on page"، تأکیدی، صفحه_مقدار)
    check("muted on page "، ملایم، صفحه_مقدار)
پایان
