// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس
واردسازی رابط گرافیکی.جعبه سی اس اس

تابع add(els &: وکتور<سی اس اس.عنصر>، kind: رشته، parent: صحیح، classes: رشته، base: رشته): صحیح:
    ناپایا e := سی اس اس.عنصر تازه(kind، parent)
    e.کلاس های عنصر = classes
    e.اعلان های پایه = base
    els.بیفزا(e)
    برگشت els.طول() - 1
پایان

تابع ریشه:
    ناپایا sheet := سی اس اس.برگه تازه()
    دیرکن sheet.آزادسازی برگه()
    _g := sheet.افزودن قاعده("*"، "box-sizing: border-box")
    _c := sheet.افزودن قاعده(".card h2"، "margin: 0 0 8px")
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    body := add(els، "page"، -1، ""، "font-family: Vazirmatn, sans-serif; background: #f8fafc")
    card := add(els، "box"، body، "card"، "padding: 1em; border: 1px solid #e2e8f0; border-radius: 12px; max-width: 30rem")
    title := add(els، "h2"، card، ""، "color: #0f172a")
    text := add(els، "paragraph"، card، ""، "line-height: 1.5")
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 800.0، بلندی پنجره = 600.0 })
    هر i در [body، card، title، text]:
        cs := sheet.سبک عنصر(i)
        سرچاپ els[i].برچسب عنصر، سی اس اس.متن مقدار(cs، "display")، سی اس اس.متن مقدار(cs، "font-size")، سی اس اس.متن مقدار(cs، "margin-top")، سی اس اس.متن مقدار(cs، "padding-top")، سی اس اس.متن مقدار(cs، "color")
    پایان
    ناپایا tree := جعبه سی اس اس.درخت {}
    دیرکن tree.آزاد کردن()
    ناپایا ids := وکتور {} برگردان وکتور<صحیح>
    دیرکن ids.آزادکن()
    تکرار els.طول() در i:
        ids.بیفزا(tree.افزودن گره(سی اس اس.به جعبه(sheet.سبک عنصر(i))))
        اگر els[i].والد عنصر بزرگتربرابر 0:
            tree.افزودن فرزند(ids[els[i].والد عنصر]، ids[i])
        پایان
    پایان
    tree.محاسبه(ids[0]، جعبه سی اس اس.معین(800.0)، جعبه سی اس اس.معین(600.0))
    l := tree.جانمایی گره(ids[card])
    سرچاپ "card box"، l.ایکس، l.ایگرگ، l.پهنای جعبه، l.بلندی جعبه
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان
