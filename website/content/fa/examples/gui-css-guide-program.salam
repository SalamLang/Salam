تابع styles(): سی اس اس.برنامه‌سبک:
    ناپایا p := سی اس اس.برنامه سبک تازه()
    p.افزودن گزینشگر ساده(3، "card"، ""، 0، 0، 0، نادرست)
    p.افزودن گزینشگر مرکب(0، 1، 0)
    p.افزودن گزینشگر کامل(0، 1، 1000، نادرست، نادرست)
    p.افزودن پرسش رسانه(-1، [سی اس اس.آغاز کارکرد("")، سی اس اس.کلیدواژه("max-width")، سی اس اس.جداکننده(58، نادرست)، سی اس اس.کمیت با واحد(600.0، "px")، سی اس اس.بستن پرانتز()])
    p.افزودن اعلان("padding-top"، نادرست، [سی اس اس.کمیت با واحد(12.0، "px")])
    p.افزودن اعلان("color"، درست، [سی اس اس.نشان هش("334155")])
    p.افزودن اعلان("font-family"، نادرست، [سی اس اس.کلیدواژه با متن("vazirmatn"، "Vazirmatn")، سی اس اس.ویرگول()، سی اس اس.کلیدواژه("sans-serif")])
    p.افزودن اعلان("line-height"، نادرست، [سی اس اس.عدد(1.5)])
    p.افزودن اعلان("order"، نادرست، [سی اس اس.عدد گرد(2.0)])
    p.افزودن اعلان("width"، نادرست، [سی اس اس.درصد(50.0)])
    p.افزودن اعلان("background-image"، نادرست، [سی اس اس.نشانی منبع("bg.png")])
    p.افزودن اعلان متنی("--label"، "\"hi\""، نادرست)
    p.بستن فهرست اعلان(8)
    p.افزودن اعلان("margin-top"، نادرست، [سی اس اس.متن نقل شده("x")])
    p.بستن فهرست اعلان(1)
    p.افزودن قاعده برنامه(0، 0، 0)
    برگشت p
پایان

تابع ریشه:
    ناپایا p := سی اس اس.برنامه سبک تازه()
    card := سی اس اس.ترجمه اعلان ها(p، "padding: 16px; border-radius: 8px")
    سرچاپ "list"، card، "same text"، سی اس اس.ترجمه اعلان ها(p، "padding: 16px; border-radius: 8px")، "empty"، سی اس اس.ترجمه اعلان ها(p، "")
    سرچاپ "rule"، سی اس اس.ترجمه قاعده(p، ".card:hover"، "background: #eef"، "")، سی اس اس.ترجمه قاعده(p، ".card"، "padding: 8px"، "(max-width: 600px)")
    سرچاپ "css rules"، سی اس اس.ترجمه سی اس اس(p، "h1 { margin: 0 } @media (prefers-color-scheme: dark) { body { color: #eee } }")
    _bad := سی اس اس.ترجمه اعلان ها(p، "colr: red")
    سرچاپ "errors"، سی اس اس.شمار خطاهای برنامه(p)
    e := سی اس اس.خطای برنامه(p، 0)
    سرچاپ e
    حافظه.آزادسازی(e برگردان تهی*)
    src := سی اس اس.متن برنامه سبک(p، "page_styles"، "css")
    سرچاپ src.شروع با("func page_styles(): css.Program:")
    حافظه.آزادسازی(src برگردان تهی*)
    wide := سی اس اس.اعلان زمان اجرا(p، "width"، "240px")
    ناپایا sheet := سی اس اس.برگه از برنامه(p)
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    els.بیفزا(سی اس اس.عنصر تازه("page"، -1))
    ناپایا box := سی اس اس.عنصر تازه("box"، 0)
    box.کلاس های عنصر = "card"
    box.شناسه اعلان پایه = card
    box.شناسه اعلان اشاره = -1
    box.شناسه اعلان تمرکز = -1
    box.شناسه اعلان فشردن = -1
    box.شناسه های اعلان زمان اجرا.بیفزا(wide)
    els.بیفزا(box)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 500.0 })
    cs := sheet.سبک عنصر(1)
    سرچاپ "padding"، سی اس اس.متن درازا(cs.فاصله داخلی بالا)، "width"، سی اس اس.متن درازا(cs.پهنا)
    سرچاپ "added again"، sheet.افزودن برنامه(p)
    ناپایا q := styles()
    piece := سی اس اس.کلیدواژه("auto")
    سرچاپ "piece"، piece.گونه تکه، piece.متن تکه، piece.متن خام تکه، piece.عدد تکه، piece.کد تکه، piece.فاصله پیش از تکه، "program"، q.شناسه برنامه بزرگتربرابر 0
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
    sheet.آزادسازی برگه()
    q.آزادسازی برنامه()
    p.آزادسازی برنامه()
پایان
