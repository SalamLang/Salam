// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس

تابع ریشه:
    ناپایا sheet := سی اس اس.برگه تازه()
    دیرکن sheet.آزادسازی برگه()
    _r := sheet.افزودن قاعده("nav a:hover"، "text-decoration: none")
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    els.بیفزا(سی اس اس.عنصر تازه("page"، -1))
    ناپایا nav := سی اس اس.عنصر تازه("nav"، 0)
    nav.اعلان های پایه = "display: flex; gap: 8px; padding: 16px"
    nav.افزودن رسانه("(max-width: 600px)"، "flex-direction: column; padding: 8px")
    els.بیفزا(nav)
    ناپایا button := سی اس اس.عنصر تازه("button"، 1)
    button.اعلان های پایه = "background: #2563eb; color: white; border: none; transition: background 200ms ease-in-out"
    button.اعلان های اشاره = "background: #1d4ed8"
    button.اعلان های فشردن = "transform: scale(0.98)"
    els.بیفزا(button)
    ناپایا link := سی اس اس.عنصر تازه("link"، 1)
    link.افزودن ویژگی("href"، "/help")
    els.بیفزا(link)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 900.0، بلندی پنجره = 700.0 })
    سرچاپ "wide"، سی اس اس.متن مقدار(sheet.سبک عنصر(1)، "flex-direction")، سی اس اس.متن مقدار(sheet.سبک عنصر(1)، "padding-top")
    سرچاپ "button"، سی اس اس.متن مقدار(sheet.سبک عنصر(2)، "background-color")، سی اس اس.متن مقدار(sheet.سبک عنصر(2)، "transition-duration")
    top := سی اس اس.زنجیره اشاره(els، 2)
    سرچاپ "hover touches"، sheet.سبک دهی دوباره(els، top)، "elements:"، سی اس اس.متن مقدار(sheet.سبک عنصر(2)، "background-color")
    ناپایا b := els.ارجاع(2)
    b.فشرده = درست
    _p := sheet.سبک دهی دوباره(els، 2)
    سرچاپ "pressed"، سی اس اس.متن مقدار(sheet.سبک عنصر(2)، "transform")
    top2 := سی اس اس.زنجیره اشاره(els، 3)
    _q := sheet.سبک دهی دوباره(els، top2)
    سرچاپ "link"، سی اس اس.متن مقدار(sheet.سبک عنصر(3)، "text-decoration-line")، سی اس اس.متن مقدار(sheet.سبک عنصر(3)، "cursor")
    _m := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 500.0، بلندی پنجره = 700.0، حالت تیره = درست })
    سرچاپ "narrow"، سی اس اس.متن مقدار(sheet.سبک عنصر(1)، "flex-direction")، سی اس اس.متن مقدار(sheet.سبک عنصر(1)، "padding-top")
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان
