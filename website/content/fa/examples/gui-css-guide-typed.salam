// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس
واردسازی حافظه

تابع styles(): سی اس اس.برنامه‌سبک:
    ناپایا p := سی اس اس.برنامه سبک تازه()
    p.افزودن اعلان نوع دار(سی اس اس.شناسه ویژگی سبک("display")، 0، [سی اس اس.کلیدواژه با شناسه(سی اس اس.شناسه کلیدواژه("flex"))])
    p.افزودن اعلان نوع دار(سی اس اس.شناسه ویژگی سبک("margin-top")، 0، [سی اس اس.کمیت با شناسه واحد(1.5، سی اس اس.شناسه کلیدواژه("em"))])
    p.افزودن اعلان نوع دار(سی اس اس.شناسه ویژگی سبک("width")، 0، [سی اس اس.کارکرد با شناسه(سی اس اس.شناسه کلیدواژه("calc"))، سی اس اس.درصد(100.0)، سی اس اس.جداکننده(45، درست)، سی اس اس.کمیت با شناسه واحد(20.0، سی اس اس.شناسه کلیدواژه("px"))، سی اس اس.بستن پرانتز()])
    p.افزودن اعلان نوع دار(سی اس اس.شناسه ویژگی سبک("color-scheme")، 2، [سی اس اس.کلیدواژه با شناسه(سی اس اس.شناسه کلیدواژه("light"))، سی اس اس.کلیدواژه با شناسه(سی اس اس.شناسه کلیدواژه("dark"))])
    p.افزودن اعلان نوع دار(سی اس اس.شناسه ویژگی سبک("color")، 2، [سی اس اس.رنگ حل شده(0x111111ff، 0xeeeeeeff، 1)])
    p.بستن فهرست اعلان(5)
    برگشت p
پایان

تابع ریشه:
    name := سی اس اس.نام ویژگی سبک(سی اس اس.شناسه ویژگی سبک("color"))
    kw := سی اس اس.نام کلیدواژه(سی اس اس.شناسه کلیدواژه("flex"))
    سرچاپ "ids"، سی اس اس.شناسه ویژگی سبک("color")، name، سی اس اس.شناسه کلیدواژه("flex")، kw
    حافظه.آزادسازی(name برگردان تهی*)
    حافظه.آزادسازی(kw برگردان تهی*)
    piece := سی اس اس.رنگ حل شده(0x3366aaff، 0x99bbffff، 1)
    سرچاپ "piece"، piece.شناسه نام تکه، piece.رنگ روشن تکه، piece.رنگ تیره تکه، سی اس اس.کلیدواژه با شناسه(5).شناسه نام تکه
    ناپایا c := سی اس اس.رنگ‌سی‌اس‌اس {}
    _ok := سی اس اس.تجزیه رنگ("oklch(0.7 0.1 30)"، c)
    سرچاپ "oklch"، c.قرمز، c.سبز، c.آبی
    mixed := سی اس اس.متن رنگ(سی اس اس.آمیختن رنگ ها(سی اس اس.رنگ‌سی‌اس‌اس { قرمز = 255 }، سی اس اس.رنگ‌سی‌اس‌اس { آبی = 255، آلفا = 0 }، 0.5))
    سرچاپ "mix"، mixed
    حافظه.آزادسازی(mixed برگردان تهی*)
    ناپایا p := styles()
    ناپایا sheet := سی اس اس.برگه از برنامه(p)
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    els.بیفزا(سی اس اس.عنصر تازه("page"، -1))
    ناپایا box := سی اس اس.عنصر تازه("box"، 0)
    box.شناسه اعلان پایه = 0
    els.بیفزا(box)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط { پهنای پنجره = 400.0 })
    سرچاپ "light"، سی اس اس.متن مقدار(sheet.سبک عنصر(1)، "color")، سی اس اس.متن مقدار(sheet.سبک عنصر(1)، "width")
    سرچاپ "restyled"، sheet.تنظیم طرح رنگ(els، درست)
    سرچاپ "dark"، سی اس اس.متن مقدار(sheet.سبک عنصر(1)، "color")
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
    sheet.آزادسازی برگه()
    p.آزادسازی برنامه()
پایان
