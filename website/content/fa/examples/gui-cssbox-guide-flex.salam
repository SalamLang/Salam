// زبان: فارسی
واردسازی رابط گرافیکی.جعبه سی اس اس

تابع label(chars: صحیح، mi: جعبه سی اس اس.داده‌سنجش): جعبه سی اس اس.سنجیده:
    full := (chars برگردان اعشار۶۴) * 8.0
    اگر mi.پهنای موجود.قسم فضا برابر جعبه سی اس اس.نوع‌فضا.فضای کمینه محتوا:
        برگشت جعبه سی اس اس.سنجش شده با خط پایه(40.0، 32.0، 12.0)
    پایان
    اگر mi.پهنای موجود.قسم فضا برابر جعبه سی اس اس.نوع‌فضا.فضای معین و mi.پهنای موجود.مقدار فضا کوچکتر full:
        برگشت جعبه سی اس اس.سنجش شده با خط پایه(mi.پهنای موجود.مقدار فضا، 32.0، 12.0)
    پایان
    برگشت جعبه سی اس اس.سنجش شده با خط پایه(full، 16.0، 12.0)
پایان

تابع ریشه:
    ناپایا t := جعبه سی اس اس.درخت {}
    دیرکن t.آزاد کردن()
    bar := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.فلکس، پهنا = جعبه سی اس اس.پیکسل(400.0)، حاشیه درونی = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(8.0))، فاصله ستون ها = جعبه سی اس اس.پیکسل(8.0)، تراز آیتم ها = جعبه سی اس اس.نوع‌تراز.تراز خط پایه، چینش محتوا = جعبه سی اس اس.نوع‌تراز.فاصله میان })
    title := t.افزودن گره(جعبه سی اس اس.سبک { رشد فلکس = 1.0، کوچک شدن فلکس = 1.0، پایه فلکس = جعبه سی اس اس.خودکار() })
    t.تنظیم سنجش(title، (mi: جعبه سی اس اس.داده‌سنجش): برگشت label(30، mi) پایان)
    button := t.افزودن گره(جعبه سی اس اس.سبک { حاشیه درونی = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.پیکسل(4.0)، جعبه سی اس اس.پیکسل(12.0)، جعبه سی اس اس.پیکسل(4.0)، جعبه سی اس اس.پیکسل(12.0))، مرز = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(1.0)) })
    t.تنظیم سنجش(button، (mi: جعبه سی اس اس.داده‌سنجش): برگشت label(4، mi) پایان)
    badge := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(24.0)، بلندی = جعبه سی اس اس.پیکسل(24.0)، تراز خود = جعبه سی اس اس.نوع‌تراز.تراز میانه، ترتیب = -1 })
    t.افزودن فرزند(bar، title)
    t.افزودن فرزند(bar، button)
    t.افزودن فرزند(bar، badge)
    t.محاسبه(bar، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای بیشینه())
    هر id در [bar، badge، title، button]:
        l := t.جانمایی گره(id)
        سرچاپ id، l.ایکس، l.ایگرگ، l.پهنای جعبه، l.بلندی جعبه
    پایان
    rtl := t.سبک گره(bar)
    ناپایا s := rtl
    s.جهت = جعبه سی اس اس.نوع‌جهت.راست به چپ
    t.تنظیم سبک(bar، s)
    t.محاسبه(bar، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای بیشینه())
    سرچاپ "rtl badge x"، t.جانمایی گره(badge).ایکس، "title x"، t.جانمایی گره(title).ایکس
پایان
