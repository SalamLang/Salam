// زبان: فارسی
واردسازی رابط گرافیکی.جعبه سی اس اس

تابع ریشه:
    ناپایا t := جعبه سی اس اس.درخت {}
    دیرکن t.آزاد کردن()
    page := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.شبکه ای، پهنا = جعبه سی اس اس.پیکسل(400.0)، الگوی ستون های شبکه = "120px 1fr"، الگوی سطرهای شبکه = "40px auto 30px"، ناحیه های شبکه = `"head head" "side main" "foot foot"`، فاصله ستون ها = جعبه سی اس اس.پیکسل(10.0)، فاصله سطرها = جعبه سی اس اس.پیکسل(6.0) })
    head := t.افزودن گره(جعبه سی اس اس.سبک { آغاز سطر شبکه = "head"، انتهای سطر شبکه = "head"، آغاز ستون شبکه = "head"، انتهای ستون شبکه = "head" })
    side := t.افزودن گره(جعبه سی اس اس.سبک { آغاز سطر شبکه = "side"، انتهای سطر شبکه = "side"، آغاز ستون شبکه = "side"، انتهای ستون شبکه = "side"، بلندی = جعبه سی اس اس.پیکسل(80.0) })
    body := t.افزودن گره(جعبه سی اس اس.سبک { آغاز سطر شبکه = "main"، انتهای سطر شبکه = "main"، آغاز ستون شبکه = "main"، انتهای ستون شبکه = "main"، چینش خود = جعبه سی اس اس.نوع‌تراز.تراز میانه، پهنا = جعبه سی اس اس.پیکسل(100.0)، بلندی = جعبه سی اس اس.پیکسل(50.0) })
    foot := t.افزودن گره(جعبه سی اس اس.سبک { آغاز سطر شبکه = "foot"، انتهای سطر شبکه = "foot"، آغاز ستون شبکه = "foot"، انتهای ستون شبکه = "foot" })
    tiles := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.شبکه ای، پهنا = جعبه سی اس اس.پیکسل(250.0)، الگوی ستون های شبکه = "repeat(auto-fill, minmax(70px, 1fr))"، جریان خودکار شبکه = جعبه سی اس اس.نوع‌جریان‌شبکه.جریان سطری، فاصله ستون ها = جعبه سی اس اس.پیکسل(4.0) })
    هر c در [head، side، body، foot]:
        t.افزودن فرزند(page، c)
    پایان
    تکرار 4:
        tile := t.افزودن گره(جعبه سی اس اس.سبک { بلندی = جعبه سی اس اس.پیکسل(20.0) })
        t.افزودن فرزند(tiles، tile)
    پایان
    t.محاسبه(page، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای بیشینه())
    هر id در [page، head، side، body، foot]:
        l := t.جانمایی گره(id)
        سرچاپ id، l.ایکس، l.ایگرگ، l.پهنای جعبه، l.بلندی جعبه
    پایان
    t.محاسبه(tiles، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای بیشینه())
    تکرار t.شمار فرزندان(tiles) در i:
        l := t.جانمایی گره(t.فرزند(tiles، i))
        سرچاپ "tile"، i، l.ایکس، l.ایگرگ، l.پهنای جعبه
    پایان
    سرچاپ جعبه سی اس اس.فهرست ردیف معتبر است("1fr [mid] minmax(40px, 2fr)")، جعبه سی اس اس.اندازه های ردیف معتبر است("50px auto")، جعبه سی اس اس.خط شبکه معتبر است("span 2")، جعبه سی اس اس.نواحی شبکه معتبر است("'a b' 'a c'")
پایان
