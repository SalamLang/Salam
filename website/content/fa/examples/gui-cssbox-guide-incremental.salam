// زبان: فارسی
واردسازی رابط گرافیکی.جعبه سی اس اس

تابع ریشه:
    ناپایا t := جعبه سی اس اس.درخت {}
    دیرکن t.آزاد کردن()
    list := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.فلکس، جهت فلکس = جعبه سی اس اس.نوع‌جهت‌فلکس.ستونی، فاصله سطرها = جعبه سی اس اس.پیکسل(4.0) })
    ناپایا items := وکتور {} برگردان وکتور<صحیح>
    دیرکن items.آزادکن()
    تکرار 3 در i:
        item := t.افزودن گره(جعبه سی اس اس.سبک { بلندی = جعبه سی اس اس.پیکسل(20.0) })
        t.تنظیم سنجش(item، (_mi: جعبه سی اس اس.داده‌سنجش): برگشت جعبه سی اس اس.سنجش شده(100.0 + (i برگردان اعشار۶۴) * 10.0، 20.0) پایان)
        items.بیفزا(item)
    پایان
    t.تنظیم فرزندان(list، items)
    سرچاپ "nodes"، t.شمار گره ها()، "children"، t.شمار فرزندان(list)، "second"، t.فرزند(list، 1)، "parent"، t.والد(items.بگیر(0))
    t.محاسبه(list، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای بیشینه())
    سرچاپ "size"، t.جانمایی گره(list).پهنای جعبه، t.جانمایی گره(list).بلندی جعبه، "calls"، t.شمار محاسبه ها()، "measures"، t.شمار سنجش ها()
    t.صفر کردن شمارنده ها()
    t.محاسبه(list، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای بیشینه())
    سرچاپ "again"، t.شمار محاسبه ها()، "dirty"، t.تغییر کرده است(list)
    t.تنظیم سنجش(items.بگیر(2)، (_mi: جعبه سی اس اس.داده‌سنجش): برگشت جعبه سی اس اس.سنجش شده(200.0، 20.0) پایان)
    سرچاپ "dirty"، t.تغییر کرده است(list)، t.تغییر کرده است(items.بگیر(0))
    t.محاسبه(list، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای بیشینه())
    سرچاپ "width"، t.جانمایی گره(list).پهنای جعبه، "calls"، t.شمار محاسبه ها()
    t.حذف سنجش(items.بگیر(2))
    t.علامت تغییر(items.بگیر(1))
    t.تنظیم گردکردن(نادرست)
    t.محاسبه(list، جعبه سی اس اس.فضای کمینه()، جعبه سی اس اس.فضای بیشینه())
    سرچاپ "width"، t.جانمایی گره(list).پهنای جعبه
پایان
