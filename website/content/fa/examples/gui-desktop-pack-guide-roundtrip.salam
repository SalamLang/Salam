واردسازی رابط گرافیکی.برنامه رومیزی.دارایی فشرده
واردسازی سیستم عامل
واردسازی ورودی خروجی

تابع ریشه:
    سیستم عامل.ساخت پوشه ها("www")
    ورودی خروجی.نوشتن پرونده("www/index.html"، "<h1>Hello</h1>")
    ورودی خروجی.نوشتن پرونده("www/style.css"، "body { margin: 0 }")
    سرچاپ "فشرده شد"، دارایی فشرده.فشرده کردن پوشه("www"، "app.pack"، "com.example.app")، "پرونده"
    ناپایا باز شده := دارایی فشرده.فشرده {}
    اگر وارونه دارایی فشرده.باز کردن("app.pack"، "com.example.app"، باز شده):
        سرچاپ "باز نشد"
        برگشت ۱
    پایان
    سرچاپ "درون آن"، باز شده.شمار()
    صفحه := باز شده.خواندن("index.html")
    سرچاپ "اندازه‌ی index.html"، صفحه.اندازه، "بایت"
    گمشده := باز شده.خواندن("nothing.txt")
    سرچاپ "nothing.txt پیدا شد:"، گمشده.داده نابرابر پوچ
پایان
