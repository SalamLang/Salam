// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(t &: چیدمان.درخت چیدمان، name: رشته، id: صحیح):
    سرچاپ name، t.ایکس(id)، t.ایگرگ(id)، t.پهنا(id)، t.بلندی(id)
پایان

تابع build(t &: چیدمان.درخت چیدمان، dir: صحیح): (صحیح، صحیح، صحیح، صحیح):
    app := t.افزودن(-1، چیدمان.سبک چیدمان { جهت = dir })
    header := t.افزودن(app، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(48.0)، فاصله درونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(16.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(16.0))، تراز = چیدمان.تراز‌وسط، فاصله ستون‌ها = چیدمان.پیکسلی(12.0) })
    t.افزودن(header، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(32.0)، بلندی = چیدمان.پیکسلی(32.0) })
    t.افزودن(header، چیدمان.سبک چیدمان { رشد = 1.0، بلندی = چیدمان.پیکسلی(20.0) })
    body := t.افزودن(app، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، رشد = 1.0، پایه = چیدمان.پیکسلی(0.0) })
    side := t.افزودن(body، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(180.0)، پهنای مرز = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(1.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)) })
    content := t.افزودن(body، چیدمان.سبک چیدمان { رشد = 1.0، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(16.0))، فاصله سطرها = چیدمان.پیکسلی(8.0)، سرریز عمودی = چیدمان.سرریز‌خودکار })
    تکرار 30:
        t.افزودن(content، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(40.0)، کاهش = 0.0 })
    پایان
    footer := t.افزودن(app، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(24.0) })
    برگشت header، side، content، footer
پایان

تابع ریشه:
    ناپایا t := چیدمان.درخت تازه()
    header، side، content، footer := build(t، چیدمان.جهت‌چپ‌به‌راست)
    t.چیدن(800.0، 600.0)
    show(t، "header"، header)
    show(t، "side"، side)
    show(t، "content"، content)
    show(t، "footer"، footer)
    سرچاپ "content scrolls by"، t.بلندی محتوا(content) - t.بلندی(content)

    ناپایا r := چیدمان.درخت تازه()
    _، rside، rcontent، _ := build(r، چیدمان.جهت‌راست‌به‌چپ)
    r.چیدن(800.0، 600.0)
    show(r، "rtl side"، rside)
    show(r، "rtl content"، rcontent)
پایان
