// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(موقت &: چیدمان.درخت چیدمان، نام: رشته، شناسه: صحیح):
    سرچاپ نام، موقت.ایکس(شناسه)، موقت.ایگرگ(شناسه)، موقت.پهنا(شناسه)، موقت.بلندی(شناسه)
پایان

تابع build(موقت &: چیدمان.درخت چیدمان، پوشه: صحیح): (صحیح، صحیح، صحیح، صحیح):
    برنامه := موقت.افزودن(-1، چیدمان.سبک چیدمان { جهت = پوشه })
    سرصفحه := موقت.افزودن(برنامه، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، بلندی = چیدمان.پیکسلی(48.0)، فاصله درونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(16.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(16.0))، تراز = چیدمان.تراز‌وسط، فاصله ستون‌ها = چیدمان.پیکسلی(12.0) })
    موقت.افزودن(سرصفحه، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(32.0)، بلندی = چیدمان.پیکسلی(32.0) })
    موقت.افزودن(سرصفحه، چیدمان.سبک چیدمان { رشد = 1.0، بلندی = چیدمان.پیکسلی(20.0) })
    بدنه := موقت.افزودن(برنامه، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، رشد = 1.0، پایه = چیدمان.پیکسلی(0.0)، کمینه بلندی = چیدمان.پیکسلی(0.0) })
    کنار := موقت.افزودن(بدنه، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(180.0)، پهنای مرز = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(1.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(0.0)) })
    محتوا := موقت.افزودن(بدنه، چیدمان.سبک چیدمان { رشد = 1.0، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(16.0))، فاصله سطرها = چیدمان.پیکسلی(8.0)، سرریز عمودی = چیدمان.سرریز‌خودکار })
    تکرار 30:
        موقت.افزودن(محتوا، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(40.0)، کاهش = 0.0 })
    پایان
    پاورقی := موقت.افزودن(برنامه، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(24.0) })
    برگشت سرصفحه، کنار، محتوا، پاورقی
پایان

تابع ریشه:
    ناپایا موقت := چیدمان.درخت تازه()
    سرصفحه، کنار، محتوا، پاورقی := build(موقت، چیدمان.جهت‌چپ‌به‌راست)
    موقت.چیدن(800.0، 600.0)
    show(موقت، "header"، سرصفحه)
    show(موقت، "side"، کنار)
    show(موقت، "content"، محتوا)
    show(موقت، "footer"، پاورقی)
    سرچاپ "content scrolls by"، موقت.بلندی محتوا(محتوا) - موقت.بلندی(محتوا)

    ناپایا پاسخ_محلی := چیدمان.درخت تازه()
    _، rside، rcontent، _ := build(پاسخ_محلی، چیدمان.جهت‌راست‌به‌چپ)
    پاسخ_محلی.چیدن(800.0، 600.0)
    show(پاسخ_محلی، "rtl side"، rside)
    show(پاسخ_محلی، "rtl content"، rcontent)
پایان
