// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع paragraph(t &: چیدمان.درخت چیدمان، parent: صحیح، words: صحیح): صحیح:
    id := t.افزودن(parent، چیدمان.سبک چیدمان {})
    t.تنظیم سنجش(id، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴):
        ناپایا per := words
        اگر w بزرگتربرابر 0.0:
            per = ((w + 4.0) / 44.0) برگردان صحیح
            اگر per کوچکتر 1:
                per = 1
            پایان
            اگر per بزرگتر words:
                per = words
            پایان
        پایان
        lines := (words + per - 1) / per
        برگشت چیدمان.ابعاد { پهنا = (per برگردان اعشار۶۴) * 44.0 - 4.0، بلندی = (lines برگردان اعشار۶۴) * 18.0، خط پایه = 14.0 }
    پایان)
    برگشت id
پایان

تابع ریشه:
    ناپایا t := چیدمان.درخت تازه()
    card := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، تراز = چیدمان.تراز‌خط‌پایه، فاصله ستون‌ها = چیدمان.پیکسلی(12.0)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(8.0))، بلندی = چیدمان.به اندازه محتوا() })
    label := paragraph(t، card، 1)
    text := paragraph(t، card، 20)
    ناپایا st := t.سبک(text)
    st.رشد = 1.0
    st.پایه = چیدمان.پیکسلی(0.0)
    t.تنظیم سبک(text، st)
    هر width در [600.0، 300.0، 600.0]:
        t.صفر کردن شمارنده‌ها()
        t.چیدن(width، 400.0)
        سرچاپ "width"، width، "card height"، t.بلندی(card)، "text size"، t.پهنا(text)، t.بلندی(text)، "label y"، t.ایگرگ(label)، "measures"، t.شمار سنجش‌ها()
    پایان
    t.صفر کردن شمارنده‌ها()
    t.چیدن(600.0، 400.0)
    سرچاپ "unchanged layout calls"، t.شمار چیدن‌ها()، "measures"، t.شمار سنجش‌ها()
    t.علامت تغییر(text)
    t.چیدن(600.0، 400.0)
    سرچاپ "text changed, layout calls"، t.شمار چیدن‌ها()، "measures"، t.شمار سنجش‌ها()
پایان
