// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع پاراگراف(موقت &: چیدمان.درخت چیدمان، والد: صحیح، واژه‌ها: صحیح): صحیح:
    شناسه := موقت.افزودن(والد، چیدمان.سبک چیدمان {})
    موقت.تنظیم سنجش(شناسه، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴):
        ناپایا در_هر := واژه‌ها
        اگر w بزرگتربرابر 0.0:
            در_هر = ((w + 4.0) / 44.0) برگردان صحیح
            اگر در_هر کوچکتر 1:
                در_هر = 1
            پایان
            اگر در_هر بزرگتر واژه‌ها:
                در_هر = واژه‌ها
            پایان
        پایان
        خط‌ها := (واژه‌ها + در_هر - 1) / در_هر
        برگشت چیدمان.ابعاد { پهنا = (در_هر برگردان اعشار۶۴) * 44.0 - 4.0، بلندی = (خط‌ها برگردان اعشار۶۴) * 18.0، خط پایه = 14.0 }
    پایان)
    برگشت شناسه
پایان

تابع ریشه:
    ناپایا موقت := چیدمان.درخت تازه()
    کارت := موقت.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، تراز = چیدمان.تراز‌خط‌پایه، فاصله ستون‌ها = چیدمان.پیکسلی(12.0)، فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(8.0))، بلندی = چیدمان.به اندازه محتوا() })
    برچسب := پاراگراف(موقت، کارت، 1)
    متن := پاراگراف(موقت، کارت، 20)
    ناپایا سبک_متن := موقت.سبک(متن)
    سبک_متن.رشد = 1.0
    سبک_متن.پایه = چیدمان.پیکسلی(0.0)
    موقت.تنظیم سبک(متن، سبک_متن)
    هر متغیر_width در [600.0، 300.0، 600.0]:
        موقت.صفر کردن شمارنده‌ها()
        موقت.چیدن(متغیر_width، 400.0)
        سرچاپ "width"، متغیر_width، "card height"، موقت.بلندی(کارت)، "text size"، موقت.پهنا(متن)، موقت.بلندی(متن)، "label y"، موقت.ایگرگ(برچسب)، "measures"، موقت.شمار سنجش‌ها()
    پایان
    موقت.صفر کردن شمارنده‌ها()
    موقت.چیدن(600.0، 400.0)
    سرچاپ "unchanged layout calls"، موقت.شمار چیدن‌ها()، "measures"، موقت.شمار سنجش‌ها()
    موقت.علامت تغییر(متن)
    موقت.چیدن(600.0، 400.0)
    سرچاپ "text changed, layout calls"، موقت.شمار چیدن‌ها()، "measures"، موقت.شمار سنجش‌ها()
پایان
