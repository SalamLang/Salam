// زبان: فارسی
واردسازی رابط گرافیکی.نقاشی

تابع ریشه:
    ناپایا بوم۱ := نقاشی.بوم تازه(۱۶۰، ۱۰۰)
    بوم۱.پاک کردن(نقاشی.رنگ از سه مولفه(۲۴۰، ۲۴۲، ۲۴۷))
    جعبه := نقاشی.مستطیل از(۲۰.۰، ۲۰.۰، ۱۲۰.۰، ۶۰.۰)
    شعاع ها := نقاشی.شعاع گوشه ها(۱۶.۰، ۱۶.۰، ۴.۰، ۴.۰)
    بوم۱.رسم سایه(جعبه، شعاع ها، نقاشی.سایه { جابجایی ایگرگ = ۴.۰، تاری = ۱۲.۰، رنگ = نقاشی.رنگ از چهار مولفه(۲۰، ۳۰، ۶۰، ۸۰) })
    ناپایا پس زمینه := نقاشی.گرادیان خطی(۱۸۰.۰)
    پس زمینه.افزودن ایست(۰.۰، نقاشی.رنگ از سه مولفه(۲۵۵، ۲۵۵، ۲۵۵))
    پس زمینه.افزودن ایست(۱.۰، نقاشی.رنگ از سه مولفه(۲۲۶، ۲۳۴، ۲۵۲))
    بوم۱.پرکردن گرادیان(جعبه، شعاع ها، پس زمینه)
    پس زمینه.رهاسازی()
    بوم۱.رسم کادر(جعبه، شعاع ها، نقاشی.کادر توپر(۱.۵، نقاشی.رنگ از سه مولفه(۱۵۰، ۱۷۰، ۲۲۰)))
    بوم۱.رسم دورخط(جعبه، شعاع ها، ۲.۰، ۲.۰، نقاشی.رنگ از چهار مولفه(۶۰، ۱۱۰، ۲۳۰، ۱۶۰))
    بالا۱ := بوم۱.پیکسل(۸۰، ۲۴)
    پایین۱ := بوم۱.پیکسل(۸۰، ۷۵)
    سرچاپ "بالای کارت:"، بالا۱.قرمز، بالا۱.سبز، بالا۱.آبی
    سرچاپ "پایین کارت:"، پایین۱.قرمز، پایین۱.سبز، پایین۱.آبی
    سرچاپ "چکیده:"، بوم۱.چکیده()
    بوم۱.رهاسازی()
پایان
