// زبان: فارسی
واردسازی رابط گرافیکی.نقاشی

تابع بکش(بوم۱ &: نقاشی.بوم، ایکس۱: اعشار۶۴):
    بوم۱.پاک کردن(نقاشی.رنگ از سه مولفه(۲۵۵، ۲۵۵، ۲۵۵))
    بوم۱.پرکردن مستطیل گرد(نقاشی.مستطیل از(ایکس۱، ۱۰.۰، ۳۰.۰، ۳۰.۰)، نقاشی.شعاع یکسان(۸.۰)، نقاشی.رنگ از سه مولفه(۲۳۰، ۸۰، ۴۰))
پایان

تابع ریشه:
    ناپایا صفحه۱ := نقاشی.بوم تازه(۱۰۰، ۵۰)
    بکش(صفحه۱، ۱۰.۰)
    ناپایا آسیب := نقاشی.ناحیه {}
    آسیب.افزودن(نقاشی.مستطیل پیکسلی از(۱۰، ۱۰، ۳۰، ۳۰))
    آسیب.افزودن(نقاشی.مستطیل پیکسلی از(۵۰، ۱۰، ۳۰، ۳۰))
    صفحه۱.تنظیم ناحیه(آسیب)
    بکش(صفحه۱، ۵۰.۰)
    صفحه۱.حذف ناحیه()
    ناپایا تازه۱ := نقاشی.بوم تازه(۱۰۰، ۵۰)
    بکش(تازه۱، ۵۰.۰)
    سرچاپ "مستطیل های بازکشیده:"، آسیب.شمار()
    سرچاپ "همانند بازکشیدن کامل:"، صفحه۱.چکیده() برابر تازه۱.چکیده()
    تازه۱.رهاسازی()
    صفحه۱.رهاسازی()
پایان
