// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(800، 450، "3D cube")
    ریلیب.تنظیم نرخ فریم هدف(60)
    ناپایا camera := ریلیب.ساخت دوربین سه‌بعدی(ریلیب.ساخت بردار سه(6.0، 6.0، 6.0)، ریلیب.ساخت بردار سه(0.0، 1.0، 0.0)، ریلیب.ساخت بردار سه(0.0، 1.0، 0.0)، 45.0، ریلیب.نمایش پرسپکتیو)
    تا وارونه ریلیب.پنجره باید بسته شود():
        ریلیب.به‌روزرسانی دوربین(camera، ریلیب.دوربین مداری)
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.شروع حالت سه‌بعدی(camera)
        ریلیب.رسم مکعب(ریلیب.ساخت بردار سه(0.0، 1.0، 0.0)، 2.0، 2.0، 2.0، ریلیب.قرمز())
        ریلیب.رسم لبه‌های مکعب(ریلیب.ساخت بردار سه(0.0، 1.0، 0.0)، 2.0، 2.0، 2.0، ریلیب.عنابی())
        ریلیب.رسم شبکه(10، 1.0)
        ریلیب.پایان حالت سه‌بعدی()
        ریلیب.رسم نرخ فریم(10، 10)
        ریلیب.پایان رسم()
    پایان
    ریلیب.بستن پنجره()
پایان
