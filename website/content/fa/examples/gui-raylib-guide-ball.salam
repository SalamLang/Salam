// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(800، 450، "Bouncing ball")
    ریلیب.تنظیم نرخ فریم هدف(60)
    ناپایا ایکس := 400.0
    ناپایا وای := 225.0
    ناپایا سرعت افقی := 240.0
    ناپایا سرعت عمودی := 180.0
    تا وارونه ریلیب.پنجره باید بسته شود():
        گام زمانی := ریلیب.زمان فریم() برگردان اعشار۶۴
        ایکس += سرعت افقی * گام زمانی
        وای += سرعت عمودی * گام زمانی
        اگر ایکس کوچکتر 20.0 یا ایکس بزرگتر 780.0:
            سرعت افقی = 0.0 - سرعت افقی
        پایان
        اگر وای کوچکتر 20.0 یا وای بزرگتر 430.0:
            سرعت عمودی = 0.0 - سرعت عمودی
        پایان
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم دایره(ایکس برگردان صحیح، وای برگردان صحیح، 20.0، ریلیب.عنابی())
        ریلیب.رسم متن("Close the window to quit"، 10، 10، 20، ریلیب.خاکستری تیره())
        ریلیب.پایان رسم()
    پایان
    ریلیب.بستن پنجره()
پایان
