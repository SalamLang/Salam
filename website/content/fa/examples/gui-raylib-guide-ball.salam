// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(800، 450، "Bouncing ball")
    ریلیب.تنظیم نرخ فریم هدف(60)
    ناپایا x := 400.0
    ناپایا y := 225.0
    ناپایا dx := 240.0
    ناپایا dy := 180.0
    تا وارونه ریلیب.پنجره باید بسته شود():
        dt := ریلیب.زمان فریم() برگردان اعشار۶۴
        x += dx * dt
        y += dy * dt
        اگر x کوچکتر 20.0 یا x بزرگتر 780.0:
            dx = 0.0 - dx
        پایان
        اگر y کوچکتر 20.0 یا y بزرگتر 430.0:
            dy = 0.0 - dy
        پایان
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم دایره(x برگردان صحیح، y برگردان صحیح، 20.0، ریلیب.عنابی())
        ریلیب.رسم متن("Close the window to quit"، 10، 10، 20، ریلیب.خاکستری تیره())
        ریلیب.پایان رسم()
    پایان
    ریلیب.بستن پنجره()
پایان
