// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(800، 450، "Move the square")
    ریلیب.تنظیم نرخ فریم هدف(60)
    ناپایا px := 100.0
    ناپایا py := 100.0
    wall := ریلیب.ساخت مستطیل(500.0، 150.0، 60.0، 150.0)
    تا وارونه ریلیب.پنجره باید بسته شود():
        dt := ریلیب.زمان فریم() برگردان اعشار۶۴
        ناپایا nx := px
        ناپایا ny := py
        اگر ریلیب.کلید پایین است(ریلیب.کلید راست): nx += 200.0 * dt پایان
        اگر ریلیب.کلید پایین است(ریلیب.کلید چپ): nx -= 200.0 * dt پایان
        اگر ریلیب.کلید پایین است(ریلیب.کلید پایین): ny += 200.0 * dt پایان
        اگر ریلیب.کلید پایین است(ریلیب.کلید بالا): ny -= 200.0 * dt پایان
        player := ریلیب.ساخت مستطیل(nx، ny، 40.0، 40.0)
        اگر وارونه ریلیب.برخورد مستطیل‌ها(player، wall):
            px = nx
            py = ny
        پایان
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم مستطیل رکوردی(wall، ریلیب.خاکستری تیره())
        ریلیب.رسم مستطیل(px برگردان صحیح، py برگردان صحیح، 40، 40، ریلیب.آبی())
        ریلیب.رسم متن("Arrow keys move the square"، 10، 10، 20، ریلیب.خاکستری())
        ریلیب.پایان رسم()
    پایان
    ریلیب.بستن پنجره()
پایان
