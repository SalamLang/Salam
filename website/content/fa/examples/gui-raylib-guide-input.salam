// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(800، 450، "Move the square")
    ریلیب.تنظیم نرخ فریم هدف(60)
    ناپایا جای افقی := 100.0
    ناپایا جای عمودی := 100.0
    دیوار := ریلیب.ساخت مستطیل(500.0، 150.0، 60.0، 150.0)
    تا وارونه ریلیب.پنجره باید بسته شود():
        گام زمانی := ریلیب.زمان فریم() برگردان اعشار۶۴
        ناپایا افقی بعدی := جای افقی
        ناپایا عمودی بعدی := جای عمودی
        اگر ریلیب.کلید پایین است(ریلیب.کلید راست): افقی بعدی += 200.0 * گام زمانی پایان
        اگر ریلیب.کلید پایین است(ریلیب.کلید چپ): افقی بعدی -= 200.0 * گام زمانی پایان
        اگر ریلیب.کلید پایین است(ریلیب.کلید پایین): عمودی بعدی += 200.0 * گام زمانی پایان
        اگر ریلیب.کلید پایین است(ریلیب.کلید بالا): عمودی بعدی -= 200.0 * گام زمانی پایان
        بازیکن := ریلیب.ساخت مستطیل(افقی بعدی، عمودی بعدی، 40.0، 40.0)
        اگر وارونه ریلیب.برخورد مستطیل‌ها(بازیکن، دیوار):
            جای افقی = افقی بعدی
            جای عمودی = عمودی بعدی
        پایان
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم مستطیل رکوردی(دیوار، ریلیب.خاکستری تیره())
        ریلیب.رسم مستطیل(جای افقی برگردان صحیح، جای عمودی برگردان صحیح، 40، 40، ریلیب.آبی())
        ریلیب.رسم متن("Arrow keys move the square"، 10، 10، 20، ریلیب.خاکستری())
        ریلیب.پایان رسم()
    پایان
    ریلیب.بستن پنجره()
پایان
