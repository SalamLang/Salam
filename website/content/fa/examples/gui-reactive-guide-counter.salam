واردسازی رابط گرافیکی.واکنشی

ناپایا count := واکنشی.ویژگی‌صحیح {}
ناپایا label := واکنشی.ویژگی‌متنی {}
ناپایا wide := واکنشی.ویژگی‌منطقی {}
ناپایا needs_paint := نادرست

تابع paint():
    سرچاپ "  paint:"، label.بخوان()، wide.بخوان() ? "(wide)" : ""
پایان

تابع click():
    count.بنشان(count.نگاه() + 1)
پایان

تابع ریشه:
    count = واکنشی.صحیح تازه(0).نام بده("count")
    label = واکنشی.متن تازه("").نام بده("label")
    label.پیوند((): برگشت "Count: " + count.بخوان() پایان)
    wide = واکنشی.منطقی تازه(نادرست)
    wide.پیوند((): برگشت count.بخوان() بزرگتربرابر 10 پایان)
    screen := واکنشی.ردیابی((): paint() پایان، (): needs_paint = درست پایان)
    saved := واکنشی.هنگام تغییر(count، (): سرچاپ "  save"، count.بخوان() پایان)

    تکرار 3 در frame:
        click()
        اگر frame برابر 2:
            count.بنشان(10)
        پایان
        _n := واکنشی.اجرای کنترل‌کننده ها()
        اگر needs_paint:
            needs_paint = نادرست
            _r := screen.تازه کن()
        پایان
    پایان
    saved.آزاد کن()
    screen.آزاد کن()
پایان
