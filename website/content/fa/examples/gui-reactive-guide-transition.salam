واردسازی تبدیل
واردسازی رابط گرافیکی.واکنشی

ناپایا hovered := واکنشی.ویژگی‌منطقی {}
ناپایا background := واکنشی.ویژگی‌صحیح {}
ناپایا dirty := نادرست

تابع show(ms: صحیح۶۴):
    c := ((background.بخوان() برگردان صحیح۶۴) & 0xFFFFFFFF) برگردان طبیعی۶۴
    سرچاپ "  t"، ms، "background"، تبدیل.قالب شانزده(c)
پایان

تابع ریشه:
    واکنشی.تنظیم زمان(0 برگردان صحیح۶۴)
    hovered = واکنشی.منطقی تازه(نادرست)
    background = واکنشی.صحیح تازه(0)
    background.پیوند((): برگشت hovered.بخوان() ? 0xFF3366CC برگردان صحیح : 0xFFFFFFFF برگردان صحیح پایان)
    background.پویانمایی(واکنشی.پویانمایی‌ویژگی { مدت = 300، نرمش = واکنشی.خواندن نرمش("ease-in-out"، واکنشی.نرمش عادی())، رنگی = درست })
    screen := واکنشی.ردیابی((): _c := background.بخوان() پایان، (): dirty = درست پایان)

    سرچاپ "pointer enters at 0 ms"
    hovered.بنشان(درست)
    ناپایا now := 0 برگردان صحیح۶۴
    تا واکنشی.پویانمایی جاری() یا dirty:
        اگر dirty:
            dirty = نادرست
            _r := screen.تازه کن()
            show(now)
        پایان
        now += 100
        واکنشی.تنظیم زمان(now)
    پایان
    سرچاپ "idle at"، now، "ms, running"، واکنشی.پویانمایی جاری()
    screen.آزاد کن()
پایان
