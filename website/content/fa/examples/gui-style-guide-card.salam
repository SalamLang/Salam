واردسازی رابط گرافیکی.سبک

تابع ریشه:
    names := ["layout"، "gap"، "padding"، "radius"، "background"، "color"، "shadow"، "width"، "max width"، "opacity"]
    values := ["row"، "12"، "16, 24"، "12"، "linear(90, #3366aa, #5588cc)"، "white"، "0, 4, 12, #00000040"، "100% - 32"، "480"، "120%"]
    ناپایا s := سبک.پیش فرض("box")
    ناپایا rule := ""
    تکرار names.طول() در i:
        p := سبک.ویژگی با نام(names[i])
        ناپایا v := سبک.مقدار {}
        اگر وارونه سبک.تجزیه(p، values[i]، v):
            سرچاپ سبک.خطا(p، values[i])
            گذر
        پایان
        سبک.بگذار(s، p، v)
        rule += سبک.سی اس اس(p، v) + ";"
    پایان
    سرچاپ "web:"، ".card{" + rule + "}"
    سرچاپ "native: row"، s.چیدمان برابر سبک.واژه‌ردیف، "gap"، s.شکاف ستون.پیکسل، "padding"، s.فاصله بالا.پیکسل، s.فاصله ابتدا.پیکسل
    سرچاپ "native: width"، s.عرض.طول.درصد، "% plus"، s.عرض.طول.پیکسل، "px, at most"، s.بیشینه عرض.طول.پیکسل
    سرچاپ "native: shadow blur"، s.سایه.بگیر(0).تاری.پیکسل، "background layers"، s.پس‌زمینه.طول()
پایان
