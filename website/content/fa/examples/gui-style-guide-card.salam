واردسازی رابط گرافیکی.سبک

تابع ریشه:
    نام‌ها := ["layout"، "gap"، "padding"، "radius"، "background"، "color"، "shadow"، "width"، "max width"، "opacity"]
    مقدارها := ["row"، "12"، "16, 24"، "12"، "linear(90, #3366aa, #5588cc)"، "white"، "0, 4, 12, #00000040"، "100% - 32"، "480"، "120%"]
    ناپایا نمونه := سبک.پیش فرض("box")
    ناپایا قاعده := ""
    تکرار نام‌ها.طول() در شمارنده:
        ویژگی := سبک.ویژگی با نام(نام‌ها[شمارنده])
        ناپایا مقدار := سبک.مقدار {}
        اگر وارونه سبک.تجزیه(ویژگی، مقدارها[شمارنده]، مقدار):
            سرچاپ سبک.خطا(ویژگی، مقدارها[شمارنده])
            گذر
        پایان
        سبک.بگذار(نمونه، ویژگی، مقدار)
        قاعده += سبک.سی اس اس(ویژگی، مقدار) + ";"
    پایان
    سرچاپ "web:"، ".card{" + قاعده + "}"
    سرچاپ "native: row"، نمونه.چیدمان برابر سبک.واژه‌ردیف، "gap"، نمونه.شکاف ستون.پیکسل، "padding"، نمونه.فاصله بالا.پیکسل، نمونه.فاصله ابتدا.پیکسل
    سرچاپ "native: width"، نمونه.عرض.طول.درصد، "% plus"، نمونه.عرض.طول.پیکسل، "px, at most"، نمونه.بیشینه عرض.طول.پیکسل
    سرچاپ "native: shadow blur"، نمونه.سایه.بگیر(0).تاری.پیکسل، "background layers"، نمونه.پس‌زمینه.طول()
پایان
