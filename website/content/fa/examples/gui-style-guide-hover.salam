واردسازی رابط گرافیکی.سبک

تابع value(p: صحیح، text: رشته): سبک.مقدار:
    ناپایا v := سبک.مقدار {}
    سبک.تجزیه(p، text، v)
    برگشت v
پایان

تابع ریشه:
    rest := value(سبک.ویژگی‌پس‌زمینه، "#3366aa")
    hover := value(سبک.ویژگی‌پس‌زمینه، "#5588cc")
    lift := value(سبک.ویژگی‌جابه‌جایی، "0, -2")
    still := value(سبک.ویژگی‌جابه‌جایی، "0")
    tr := value(سبک.ویژگی‌گذار، "200ms, ease out")
    ناپایا s := سبک.ظاهر {}
    سبک.بگذار(s، سبک.ویژگی‌گذار، tr)
    easing := s.گذار.بگیر(0).نرمش
    سرچاپ "web:"، سبک.سی اس اس(سبک.ویژگی‌گذار، tr)
    تکرار 5 در frame:
        ms := (frame برگردان اعشار۶۴) * 50.0
        k := سبک.نرمش در(easing، ms / s.گذار.بگیر(0).مدت)
        bg := سبک.میان یابی(سبک.ویژگی‌پس‌زمینه، rest، hover، k)
        y := سبک.میان یابی(سبک.ویژگی‌جابه‌جایی، still، lift، k)
        سرچاپ ms، "ms:"، سبک.قالب(سبک.ویژگی‌پس‌زمینه، bg)، "translate"، سبک.قالب(سبک.ویژگی‌جابه‌جایی، y)
    پایان
    سرچاپ سبک.خطا(سبک.ویژگی‌گذار، "fast")
پایان
