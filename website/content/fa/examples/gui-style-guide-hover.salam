واردسازی رابط گرافیکی.سبک

تابع مقدار_تابع(ویژگی_محلی: صحیح، متن: رشته): سبک.مقدار:
    ناپایا مقدار_محلی := سبک.مقدار {}
    سبک.تجزیه(ویژگی_محلی، متن، مقدار_محلی)
    برگشت مقدار_محلی
پایان

تابع ریشه:
    آرام := مقدار_تابع(سبک.ویژگی‌پس‌زمینه، "#3366aa")
    شناور := مقدار_تابع(سبک.ویژگی‌پس‌زمینه، "#5588cc")
    بالا_آمدن := مقدار_تابع(سبک.ویژگی‌جابه‌جایی، "0, -2")
    ثابت := مقدار_تابع(سبک.ویژگی‌جابه‌جایی، "0")
    گذار := مقدار_تابع(سبک.ویژگی‌گذار، "200ms, ease out")
    ناپایا متن_نمونه := سبک.ظاهر {}
    سبک.بگذار(متن_نمونه، سبک.ویژگی‌گذار، گذار)
    آسان‌سازی := متن_نمونه.گذار.بگیر(0).نرمش
    سرچاپ "web:"، سبک.سی اس اس(سبک.ویژگی‌گذار، گذار)
    تکرار 5 در متغیر_frame:
        میلی‌ثانیه := (متغیر_frame برگردان اعشار۶۴) * 50.0
        شمارنده۳ := سبک.نرمش در(آسان‌سازی، میلی‌ثانیه / متن_نمونه.گذار.بگیر(0).مدت)
        پس‌زمینه := سبک.میان یابی(سبک.ویژگی‌پس‌زمینه، آرام، شناور، شمارنده۳)
        وای := سبک.میان یابی(سبک.ویژگی‌جابه‌جایی، ثابت، بالا_آمدن، شمارنده۳)
        سرچاپ میلی‌ثانیه، "ms:"، سبک.قالب(سبک.ویژگی‌پس‌زمینه، پس‌زمینه)، "translate"، سبک.قالب(سبک.ویژگی‌جابه‌جایی، وای)
    پایان
    سرچاپ سبک.خطا(سبک.ویژگی‌گذار، "fast")
پایان
