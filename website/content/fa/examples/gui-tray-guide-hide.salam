واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سینی

ناپایا has_tray := نادرست
ناپایا quitting := نادرست

تابع handle_tray():
    ناپایا ev := سینی.رویداد {}
    تا سینی.برداشتن رویداد(ev):
        اگر ev.نوع برابر سینی.نوع‌رویداد.کلیک یا ev.شناسه گزینه برابر "show":
            رابط کاربری.نمایش پنجره()
        وگرنه ev.شناسه گزینه برابر "quit":
            quitting = درست
            سینی.پنهان کردن()
            رابط کاربری.توقف()
        پایان
    پایان
پایان

تابع ریشه:
    ناپایا items := وکتور {} برگردان وکتور<سینی.گزینه>
    items.افزودن(سینی.گزینه تازه("show"، "Show window"))
    items.افزودن(سینی.خط جدا())
    items.افزودن(سینی.گزینه تازه("quit"، "Quit"))
    سینی.تنظیم بیدارباش((): رابط کاربری.بی اعتبار سازی() پایان)
    has_tray = سینی.نمایش("assets/icon.png"، "My app"، items)
    رابط کاربری.هنگام درخواست بستن(():
        اگر has_tray و وارونه quitting:
            رابط کاربری.پنهان کردن پنجره()
            برگشت نادرست
        پایان
        برگشت درست
    پایان)
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده‌صفحه):
        handle_tray()
        b.گشودن عنصر("text")
        b.متن فرزند("Close this window: it stays in the tray.")
        b.بستن عنصر()
    پایان)
پایان
