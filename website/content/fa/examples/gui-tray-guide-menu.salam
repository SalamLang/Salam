واردسازی رابط گرافیکی.سینی
واردسازی زمان

ناپایا connected := نادرست
ناپایا running := درست

تابع menu(): وکتور<سینی.گزینه>:
    ناپایا items := وکتور {} برگردان وکتور<سینی.گزینه>
    اگر connected:
        items.افزودن(سینی.گزینه تازه("disconnect"، "Disconnect"))
    وگرنه:
        items.افزودن(سینی.گزینه تازه("connect"، "Connect"))
    پایان
    items.افزودن(سینی.خط جدا())
    items.افزودن(سینی.گزینه تازه("quit"، "Quit"))
    برگشت items
پایان

تابع refresh():
    سینی.تنظیم منو(menu())
    سینی.تنظیم راهنما(connected ? "Connected" : "Disconnected")
پایان

تابع ریشه:
    اگر وارونه سینی.نمایش("assets/icon.png"، "Disconnected"، menu()):
        سرچاپ "no tray:"، سینی.آخرین خطا()
        برگشت
    پایان
    تا running:
        ناپایا ev := سینی.رویداد {}
        تا سینی.برداشتن رویداد(ev):
            اگر ev.شناسه گزینه برابر "connect" یا ev.شناسه گزینه برابر "disconnect":
                connected = ev.شناسه گزینه برابر "connect"
                refresh()
            وگرنه ev.شناسه گزینه برابر "quit":
                running = نادرست
            پایان
        پایان
        زمان.خواب(50)
    پایان
    سینی.پنهان کردن()
پایان
