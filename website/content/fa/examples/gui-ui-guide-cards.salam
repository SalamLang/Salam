واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک
واردسازی رابط گرافیکی.نقاشی

تابع none(): وکتور<رابط کاربری.وصله‌سبک>:
    برگشت رابط کاربری.بی وصله()
پایان

تابع block(b: رابط کاربری.سازنده‌صفحه، name: رشته، color: رشته):
    b.گشودن عنصر("box")
    b.شناسه عنصر(name)
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌عرض، "90")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌ارتفاع، "50")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌پس‌زمینه، color)
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌گردی، "8")
    b.بستن عنصر()
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.گشودن عنصر("box")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌چیدمان، "row")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌شکاف، "12")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌فاصله، "16")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌پس‌زمینه، "#f4f6fa")
    block(b، "tea"، "#cc3333")
    block(b، "coffee"، "#3366aa")
    block(b، "juice"، "#33aa55")
    b.بستن عنصر()
پایان

تابع probe(c: نقاشی.بوم، name: رشته، x: صحیح، y: صحیح):
    p := c.پیکسل(x، y)
    سرچاپ name، p.قرمز، p.سبز، p.آبی
پایان

تابع ریشه:
    ناپایا c := رابط کاربری.نگاره صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 400، 120)
    سرچاپ رابط کاربری.گزارش صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 400، 120)
    probe(c، "tea"، 40، 40)
    probe(c، "coffee"، 150، 40)
    probe(c، "juice"، 260، 40)
    probe(c، "gap"، 113، 40)
    c.رهاسازی()
پایان
