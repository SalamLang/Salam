واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک

تابع none(): وکتور<رابط کاربری.وصله‌سبک>:
    برگشت رابط کاربری.بی وصله()
پایان

تابع cell(b: رابط کاربری.سازنده‌صفحه، name: رشته، span: رشته):
    b.گشودن عنصر("box")
    b.شناسه عنصر(name)
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌ارتفاع، "40")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌گستره‌ستون، span)
    b.بستن عنصر()
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.گشودن عنصر("box")
    b.شناسه عنصر("grid")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌چیدمان، "grid")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌ستون‌ها، "1fr, 2fr, 100")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌شکاف، "10")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌فاصله، "10")
    cell(b، "a"، "1")
    cell(b، "b"، "1")
    cell(b، "c"، "1")
    cell(b، "wide"، "2")
    cell(b، "last"، "1")
    b.بستن عنصر()
پایان

تابع ریشه:
    سرچاپ رابط کاربری.گزارش صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 400، 200)
پایان
