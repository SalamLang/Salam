// زبان: فارسی
واردسازی رابط گرافیکی.رابط کاربری
واردسازی رشته

ناپایا count := 0
ناپایا name := ""

تابع page(): رشته:
    برگشت `<!doctype html><html lang="en" dir="ltr"><head><title>Counter</title><style>button:hover{background:#dde}</style></head><body><h1 id="count">Count ` + count + `</h1><button id="add" onclick="add()">Add</button><input id="name" oninput="named(event)" placeholder="Name"><p>Hello ` + رشته.جایگزینی(name، "<"، "&lt;") + `</p><a href="https://salamlang.ir">site</a> <a href="/about">about</a></body></html>`
پایان

تابع about(): رشته:
    برگشت `<!doctype html><html><head><title>About</title></head><body><p>Made with Salam.</p><a href="/">back</a></body></html>`
پایان

تابع ریشه:
    رابط کاربری.ثبت رسیدگی("add"، (): count++ پایان)
    رابط کاربری.ثبت رسیدگی("named"، ():
        ev := رابط کاربری.رخداد جاری()
        name = ev.مقدار
        سرچاپ ev.گونه رخداد، ev.هدف، ev.متن، ev.کلید، ev.تیک خورده، ev.دکمه موشی، ev.کلیدهای کمکی، ev.ایکس، ev.ایگرگ، ev.جابجایی افقی، ev.جابجایی عمودی
    پایان)
    رابط کاربری.صفحه برنامه("/"، (): برگشت page() پایان)
    رابط کاربری.صفحه برنامه("/about"، (): برگشت about() پایان)
    رابط کاربری.تنظیم بازکننده نشانی((url: رشته):
        سرچاپ "would open"، url
        برگشت درست
    پایان)
    رابط کاربری.تنظیم ناوبر((url: رشته): برگشت url برابر "/never" پایان)
    اگر count بزرگتر 0:
        رابط کاربری.اجرا((): برگشت page() پایان)
        رابط کاربری.اجرای سند(`<p>A fixed page</p>`)
        رابط کاربری.اجرای سند با(`<p>A fixed page</p>`، رابط کاربری.گزینه‌ها { عنوان = "Fixed"، پهنا = 400.0، بلندی = 300.0 })
        رابط کاربری.تازه سازی()
        سرچاپ رابط کاربری.باز کردن نشانی("https://salamlang.ir")
    پایان
    رابط کاربری.اجرا با((): برگشت page() پایان، رابط کاربری.گزینه‌ها { عنوان = "Counter"، پهنا = 480.0، بلندی = 320.0، تغییر اندازه پذیر = درست، پس زمینه = "#ffffff"، بی سر = درست، مقیاس = 1.0، گام های آزمایشی = "click #add\nclick #add\nquit" })
    سرچاپ "count"، count، "opened"، رابط کاربری.نشانی های باز شده().طول()
پایان
