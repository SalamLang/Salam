واردسازی رابط گرافیکی.نمایش وب.نصب ساز رومیزی
واردسازی ورودی خروجی

تابع ریشه:
    متن := "[app]\nid = \"com.example.notes\"\nname = \"Notes\"\nversion = \"1.2.0\"\nassets = \"www\"\ncategory = \"Utility\"\n"
    ورودی خروجی.نوشتن پرونده("salam.toml"، متن)
    ناپایا ش := نصب ساز رومیزی.شناسنامه {}
    اگر وارونه نصب ساز رومیزی.خواندن شناسنامه("salam.toml"، ش):
        سرچاپ "جدول [app] نیست"
        برگشت ۱
    پایان
    سرچاپ ش.شناسه
    سرچاپ ش.نام، ش.نگارش
    سرچاپ "پرونده‌ی اصلی:"، ش.ورودی
    سرچاپ "دارایی‌ها:"، ش.دارایی ها
    سرچاپ "نام کوتاه:"، ش.نام کوتاه
پایان
