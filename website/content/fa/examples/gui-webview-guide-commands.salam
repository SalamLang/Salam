واردسازی رابط گرافیکی.نمایش وب
واردسازی کدگذاری.جیسون
واردسازی همگام سازی

تابع ریشه:
    نمایش وب.آغاز(نمایش وب.پیکربندی { شناسه = "com.example.notes"، نام = "یادداشت"، پوشه دارایی ها = "www" })
    نمایش وب.فرمان("add"، (ف: نمایش وب.فراخوان):
        اگر وارونه ف.دارد("a") یا وارونه ف.دارد("b"):
            ف.رد("a و b لازم است")
            برگشت
        پایان
        ف.پاسخ عددی(ف.عدد("a") + ف.عدد("b"))
    پایان)
    نمایش وب.فرمان ناهمگام("report"، (ف: نمایش وب.فراخوان):
        نام := ف.متن("name")
        همگام سازی.خواب میلی ثانیه(۱۵۰۰)
        ف.پاسخ(`{"name":` + `"` + جیسون.اسکیپ(نام) + `"` + `,"pages":12}`)
    پایان)
    نمایش وب.هنگام رویداد("save"، (داده: رشته):
        نمایش وب.ارسال به رشته رابط(():
            نمایش وب.رویداد فرستادن("saved"، داده)
        پایان)
    پایان)
    پنجره := نمایش وب.باز کردن(نمایش وب.گزینه های پنجره { عنوان = "یادداشت"، پهنا = ۹۰۰، بلندی = ۶۰۰ })
    اگر پنجره.بسته شده است():
        سرچاپ نمایش وب.آخرین خطا()
        برگشت ۱
    پایان
    نمایش وب.اجرا()
پایان
