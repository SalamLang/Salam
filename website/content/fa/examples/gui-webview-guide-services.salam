واردسازی رابط گرافیکی.نمایش وب

تابع ریشه:
    نمایش وب.آغاز(نمایش وب.پیکربندی { شناسه = "com.example.notes"، نام = "یادداشت"، پوشه دارایی ها = "www" })
    پنجره := نمایش وب.باز کردن(نمایش وب.گزینه های پنجره { عنوان = "یادداشت" })
    ماندن := نمایش وب.نمونه یکتا((ورودی‌ها: وکتور<رشته>):
        سرچاپ "اجرای دوم با"، ورودی‌ها.طول()، "ورودی"
        نمایش وب.گرفتن پنجره("main").تمرکز()
    پایان)
    اگر وارونه ماندن:
        برگشت ۰
    پایان
    نمایش وب.فرمان("choose_folder"، (ف: نمایش وب.فراخوان):
        ف.پاسخ متنی(نمایش وب.انتخاب پوشه("پوشه را انتخاب کنید"))
    پایان)
    نمایش وب.فرمان("sign_in"، (ف: نمایش وب.فراخوان):
        موفق := نمایش وب.ذخیره راز("token"، ف.متن("token"))
        ف.پاسخ درستی(موفق)
    پایان)
    نمایش وب.فرمان("token"، (ف: نمایش وب.فراخوان):
        ف.پاسخ متنی(نمایش وب.خواندن راز("token"))
    پایان)
    نمایش وب.فرمان("done"، (ف: نمایش وب.فراخوان):
        نمایش وب.اعلان("یادداشت"، "خروجی شما آماده است")
        نمایش وب.درخواست توجه(پنجره)
        ف.پاسخ خالی()
    پایان)
    نمایش وب.هنگام کلیک سینی(():
        پنجره.نمایش()
        پنجره.تمرکز()
    پایان)
    ناپایا سینی := وکتور {} برگردان وکتور<نمایش وب.مورد‌منو>
    سینی.بیفزا(نمایش وب.مورد("quit"، "خروج"))
    نمایش وب.تنظیم سینی("icon.png"، "یادداشت"، سینی)
    نمایش وب.اجرا()
پایان
