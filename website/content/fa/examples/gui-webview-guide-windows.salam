واردسازی رابط گرافیکی.نمایش وب

تابع ریشه:
    نمایش وب.آغاز(نمایش وب.پیکربندی { شناسه = "com.example.notes"، نام = "یادداشت"، پوشه دارایی ها = "www" })
    پنجره اصلی := نمایش وب.باز کردن(نمایش وب.گزینه های پنجره { برچسب = "main"، عنوان = "یادداشت"، پهنا = ۹۰۰، بلندی = ۶۰۰، کمترین پهنا = ۴۸۰، کمترین بلندی = ۳۲۰ })
    پنجره اصلی.هنگام بستن(():
        برگشت نمایش وب.تایید("یادداشت"، "پنجره‌ی یادداشت بسته شود؟")
    پایان)
    پنجره اصلی.هنگام تغییر اندازه((پ: صحیح، ب: صحیح):
        سرچاپ "اندازه"، پ، ب
    پایان)
    نمایش وب.فرمان("open_help"، (ف: نمایش وب.فراخوان):
        راهنما := نمایش وب.باز کردن(نمایش وب.گزینه های پنجره { برچسب = "help"، عنوان = "راهنما"، پهنا = ۵۲۰، بلندی = ۴۲۰، اچ تی ام ال = "<h1>راهنما</h1>" })
        راهنما.رویداد فرستادن("hello"، `{"from":"main"}`)
        ف.پاسخ خالی()
    پایان)
    نمایش وب.هنگام منو((شناسه: رشته):
        اگر شناسه برابر "help":
            نمایش وب.گرفتن پنجره("main").رویداد فرستادن("menu"، `"help"`)
        پایان
        اگر شناسه برابر "quit":
            نمایش وب.خروج()
        پایان
    پایان)
    ناپایا موردها := وکتور {} برگردان وکتور<نمایش وب.مورد‌منو>
    موردها.بیفزا(نمایش وب.مورد("help"، "راهنما"))
    موردها.بیفزا(نمایش وب.خط جداکننده())
    موردها.بیفزا(نمایش وب.مورد("quit"، "خروج"))
    نمایش وب.تنظیم منو(پنجره اصلی، موردها)
    نمایش وب.اجرا()
پایان
