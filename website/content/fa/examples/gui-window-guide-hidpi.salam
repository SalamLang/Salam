// زبان: فارسی
واردسازی رابط گرافیکی.پنجره ها
واردسازی حافظه

تابع ریشه:
    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { پهنا = 100.0، بلندی = 50.0، بی سر = درست، مقیاس = 1.5، نمایان = نادرست })
    size := w.اندازه()
    سرچاپ "logical"، size.پهنا، size.بلندی، "physical"، size.پهنای فیزیکی، size.بلندی فیزیکی
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.تغییر مقیاس، شماره پنجره = w.شناسه، مقیاس = 2.0 })
    e := پنجره ها.سرکشی رویداد()
    سرچاپ "new scale"، e.مقیاس، "logical"، e.پهنا، e.بلندی، "physical"، e.پهنای فیزیکی، e.بلندی فیزیکی
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.تغییر اندازه، شماره پنجره = w.شناسه، پهنای فیزیکی = 300، بلندی فیزیکی = 100 })
    r := پنجره ها.سرکشی رویداد()
    سرچاپ "resized to"، r.پهنا، r.بلندی
    width := r.پهنای فیزیکی
    height := r.بلندی فیزیکی
    pixels := حافظه.تخصیص صفرشده(((width * height) * 4) برگردان طبیعی۶۴) برگردان طبیعی۳۲*
    دیرکن حافظه.آزادسازی(pixels برگردان تهی*)
    w.ارائه کامل(pixels برگردان تهی*، width، height، width * 4)
    ناپایا damage := وکتور {} برگردان وکتور<پنجره ها.مستطیل>
    دیرکن damage.آزادکن()
    damage.بیفزا(پنجره ها.مستطیل { ایکس = 10، ایگرگ = 10، پهنا = 20، بلندی = 8 })
    damage.بیفزا(پنجره ها.مستطیل { ایکس = 290، ایگرگ = 90، پهنا = 50، بلندی = 50 })
    w.ارائه(pixels برگردان تهی*، width، height، width * 4، damage)
    سرچاپ "copied"، w.شمار آخرین ناحیه ها()، "rects inside"، w.آخرین ناحیه تغییر()
پایان
