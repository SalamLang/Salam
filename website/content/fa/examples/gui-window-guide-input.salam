// زبان: فارسی
واردسازی رابط گرافیکی.پنجره ها

تابع ریشه:
    پنجره ها.تنظیم ساعت دستی(درست)
    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { پهنا = 300.0، بلندی = 200.0، بی سر = درست، نمایان = نادرست })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن دکمه، شماره پنجره = w.شناسه، ایکس = 40.0، ایگرگ = 30.0، دکمه = پنجره ها.دکمه‌موشی.دکمه چپ })
    پنجره ها.جلو بردن ساعت(120)
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن دکمه، شماره پنجره = w.شناسه، ایکس = 41.0، ایگرگ = 30.0، دکمه = پنجره ها.دکمه‌موشی.دکمه چپ })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن کلید، شماره پنجره = w.شناسه، کلید = پنجره ها.کلیدها.کلید ای، کد فیزیکی = 38 })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.ورود متن، شماره پنجره = w.شناسه، متن = "a" })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.پیش نویس نویسه ساز، شماره پنجره = w.شناسه، متن = "سل"، جای نشانگر = 4 })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.ثبت نویسه ساز، شماره پنجره = w.شناسه، متن = "سلام" })
    ناپایا e := پنجره ها.سرکشی رویداد()
    تا e.نوع نابرابر پنجره ها.نوع‌رویداد.هیچ رویداد:
        ترابرد e.نوع:
            پنجره ها.نوع‌رویداد.فشردن دکمه:
                سرچاپ "click"، e.شمار کلیک، "at"، e.ایکس، e.ایگرگ
                بشکن
            پایان
            پنجره ها.نوع‌رویداد.فشردن کلید:
                سرچاپ "key A:"، e.کلید برابر پنجره ها.کلیدها.کلید ای
                بشکن
            پایان
            پنجره ها.نوع‌رویداد.ورود متن، پنجره ها.نوع‌رویداد.ثبت نویسه ساز:
                سرچاپ "insert"، e.متن
                بشکن
            پایان
            پنجره ها.نوع‌رویداد.پیش نویس نویسه ساز:
                سرچاپ "composing"، e.متن، "caret at byte"، e.جای نشانگر
                بشکن
            پایان
            وگرنه:
                بشکن
            پایان
        پایان
        e = پنجره ها.سرکشی رویداد()
    پایان
    w.تنظیم جای نویسه ساز(40.0، 30.0، 2.0، 18.0)
    سرچاپ "candidate window goes to"، w.جای نویسه ساز()
پایان
