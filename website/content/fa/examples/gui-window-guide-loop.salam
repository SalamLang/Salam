// زبان: فارسی
واردسازی رابط گرافیکی.پنجره ها
واردسازی حافظه

تابع paint(w: پنجره ها.پنجره، frame: صحیح):
    size := w.اندازه()
    width := size.پهنای فیزیکی
    height := size.بلندی فیزیکی
    pixels := حافظه.تخصیص صفرشده(((width * height) * 4) برگردان طبیعی۶۴) برگردان طبیعی۳۲*
    دیرکن حافظه.آزادسازی(pixels برگردان تهی*)
    shade := (frame * 40) برگردان طبیعی۳۲
    تکرار width * height در i:
        pixels[i] = (0xFF000000 برگردان طبیعی۳۲) | (shade << 8)
    پایان
    w.ارائه کامل(pixels برگردان تهی*، width، height، width * 4)
پایان

تابع ریشه:
    پنجره ها.تنظیم ساعت دستی(درست)
    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { عنوان = "Clock"، پهنا = 64.0، بلندی = 48.0، بی سر = درست })
    tick := پنجره ها.تنظیم زمان سنج(500، درست)
    ناپایا frames := 0
    تا w.باز است():
        e := پنجره ها.انتظار رویداد(-1)
        ترابرد e.نوع:
            پنجره ها.نوع‌رویداد.درخواست بازکشی:
                paint(w، frames)
                frames++
                سرچاپ "frame"، frames، "at"، پنجره ها.ساعت()، "ms"
                بشکن
            پایان
            پنجره ها.نوع‌رویداد.زنگ زمان سنج:
                w.درخواست بازکشی دوباره()
                اگر frames برابر 3:
                    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.درخواست بستن، شماره پنجره = w.شناسه })
                پایان
                بشکن
            پایان
            پنجره ها.نوع‌رویداد.درخواست بستن:
                سرچاپ "closing"
                پنجره ها.پاک کردن زمان سنج(tick)
                w.بستن()
                بشکن
            پایان
            وگرنه:
                بشکن
            پایان
        پایان
    پایان
    سرچاپ "presented"، w.شمار ارائه()، "frames"
پایان
