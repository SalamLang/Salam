// زبان: فارسی
واردسازی رابط گرافیکی.پنجره ها
واردسازی حافظه

تابع ریشه:
    پنجره ها.تنظیم ساعت دستی(درست)
    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { پهنا = 2.0، بلندی = 2.0، بی سر = درست، نمایان = نادرست })
    pixels := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴) برگردان طبیعی۳۲*
    دیرکن حافظه.آزادسازی(pixels برگردان تهی*)
    pixels[0] = 0xFFFF0000 برگردان طبیعی۳۲
    pixels[3] = 0x80000080 برگردان طبیعی۳۲
    w.ارائه کامل(pixels برگردان تهی*، 2، 2، 8)
    سرچاپ "top left red:"، w.نقطه در(0، 0) برابر (0xFFFF0000 برگردان طبیعی۳۲)
    سرچاپ "bottom right half blue:"، w.نقطه در(1، 1) برابر (0x80000080 برگردان طبیعی۳۲)
    timer := پنجره ها.تنظیم زمان سنج(1000، نادرست)
    ناپایا e := پنجره ها.انتظار رویداد(-1)
    تا e.نوع نابرابر پنجره ها.نوع‌رویداد.زنگ زمان سنج:
        سرچاپ "skipped event"، e.نوع برگردان صحیح
        e = پنجره ها.انتظار رویداد(-1)
    پایان
    سرچاپ "timer"، e.زمان سنج برابر timer، "after"، پنجره ها.ساعت()، "ms of test time"
    w.بستن()
پایان
