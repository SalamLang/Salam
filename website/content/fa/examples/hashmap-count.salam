واردسازی مرتب سازی
واردسازی رشته

تابع ریشه:
    متن := "سیب انار به سیب انار سیب توت به سیب"
    واژه‌ها := رشته.تفکیک کردن(متن، " ")
    دیرکن واژه‌ها.آزادکن()

    ناپایا شمار := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن شمار.آزادکن()
    هر واژه در واژه‌ها:
        شمار.درج(واژه، شمار.دریافت با پیش فرض(واژه، ۰) + ۱)
    پایان
    سرچاپ واژه‌ها.طول()، "واژه و"، شمار.اندازه()، "واژه‌ی متفاوت"

    ناپایا کلیدها := وکتور {} برگردان وکتور<رشته>
    دیرکن کلیدها.آزادکن()
    هر واژه، _ در شمار:
        کلیدها.بیفزا(واژه)
    پایان
    مرتب سازی.مرتب(کلیدها)
    هر واژه در کلیدها:
        سرچاپ واژه، شمار.بگیر(واژه)
    پایان
پایان
