واردسازی بین‌المللی‌سازی

تابع ریشه:
    ناپایا ف := بین‌المللی‌سازی.جدید("en")
    دیرکن بین‌المللی‌سازی.آزادسازی(ف)
    بین‌المللی‌سازی.تنظیم(ف، "en"، "title"، "Settings")
    بین‌المللی‌سازی.تنظیم(ف، "en"، "save"، "Save changes")
    بین‌المللی‌سازی.تنظیم(ف، "en"، "reset"، "Reset to defaults")
    بین‌المللی‌سازی.تنظیم(ف، "en"، "help"، "Help")
    بین‌المللی‌سازی.تنظیم(ف، "fa"، "title"، "تنظیمات")
    بین‌المللی‌سازی.تنظیم(ف، "fa"، "save"، "ذخیره‌ی تغییرات")
    ناپایا همه := ۰
    ناپایا جاافتاده := ۰
    هر ک در ف.کلیدها:
        اگر ک.زیررشته(۰، ۳) برابر "en:":
            کلید := ک.زیررشته(۳، ک.طول() - ۳)
            همه += ۱
            اگر بین‌المللی‌سازی.دارد(ف، "fa"، کلید) برابر نادرست:
                جاافتاده += ۱
                سرچاپ "ترجمه‌ی فارسی ندارد:"، کلید، "و نشان می‌دهد:"، بین‌المللی‌سازی.ترجمه(ف، "fa"، کلید)
            پایان
        پایان
    پایان
    سرچاپ "فارسی:"، همه - جاافتاده، "از"، همه، "ترجمه شده"
پایان
