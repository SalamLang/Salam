واردسازی بین‌المللی‌سازی
واردسازی ورودی خروجی

تابع ریشه:
    ورودی خروجی.نوشتن پرونده("en.txt"، "# English\ntitle = Notes\nwelcome = Welcome back, {name}\nprice = 'Only $5 # today'\n")
    ورودی خروجی.نوشتن پرونده("fa.txt"، "# Persian\ntitle = یادداشت‌ها\nwelcome = {name}، خوش برگشتی\n")
    ناپایا ف := بین‌المللی‌سازی.جدید("en")
    دیرکن بین‌المللی‌سازی.آزادسازی(ف)
    سرچاپ "کلیدهای انگلیسی:"، بین‌المللی‌سازی.بارگذاری زبان(ف، "en"، "en.txt")
    سرچاپ "کلیدهای فارسی:"، بین‌المللی‌سازی.بارگذاری زبان(ف، "fa"، "fa.txt")
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    ناپایا مقدارها := وکتور {} برگردان وکتور<رشته>
    دیرکن نام‌ها.آزادکن()
    دیرکن مقدارها.آزادکن()
    نام‌ها.بیفزا("name")
    مقدارها.بیفزا("سارا")
    هر زبان در ["en"، "fa"]:
        سرچاپ بین‌المللی‌سازی.ترجمه(ف، زبان، "title")
        سرچاپ بین‌المللی‌سازی.ترجمه قالبی(ف، زبان، "welcome"، نام‌ها، مقدارها)
        سرچاپ بین‌المللی‌سازی.ترجمه(ف، زبان، "price")
    پایان
پایان
