واردسازی بین‌المللی‌سازی

تابع آماده‌سازی(ف &: بین‌المللی‌سازی.فهرست ترجمه):
    بین‌المللی‌سازی.تنظیم(ف، "en"، "menu.open"، "Open")
    بین‌المللی‌سازی.تنظیم(ف، "en"، "menu.save"، "Save")
    بین‌المللی‌سازی.تنظیم(ف، "en"، "menu.quit"، "Quit")
    بین‌المللی‌سازی.تنظیم(ف، "fa"، "menu.open"، "باز کردن")
    بین‌المللی‌سازی.تنظیم(ف، "fa"، "menu.save"، "ذخیره")
    بین‌المللی‌سازی.تنظیم(ف، "fa"، "menu.quit"، "خروج")
    بین‌المللی‌سازی.تنظیم(ف، "de"، "menu.open"، "Öffnen")
    بین‌المللی‌سازی.تنظیم(ف، "de"، "menu.save"، "Speichern")
پایان

تابع نمایش منو(ف &: بین‌المللی‌سازی.فهرست ترجمه، زبان: رشته):
    باز := بین‌المللی‌سازی.ترجمه(ف، زبان، "menu.open")
    ذخیره := بین‌المللی‌سازی.ترجمه(ف، زبان، "menu.save")
    خروج := بین‌المللی‌سازی.ترجمه(ف، زبان، "menu.quit")
    سرچاپ زبان + ":"، باز، "|"، ذخیره، "|"، خروج
پایان

تابع ریشه:
    ناپایا ف := بین‌المللی‌سازی.جدید("en")
    دیرکن بین‌المللی‌سازی.آزادسازی(ف)
    آماده‌سازی(ف)
    هر زبان در ["en"، "fa"، "de"، "ja"]:
        نمایش منو(ف، زبان)
    پایان
پایان
