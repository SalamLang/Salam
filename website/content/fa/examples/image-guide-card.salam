واردسازی تصویر
واردسازی سیستم عامل

تابع ریشه:
    آرگومان‌ها := سیستم عامل.آرگومان ها()
    ناپایا مسیر قلم := تصویر.یافتن قلم عربی()
    اگر آرگومان‌ها.طول() > ۱:
        مسیر قلم = آرگومان‌ها.بگیر(۱)
    پایان
    ناپایا موفق := نادرست
    قلم := تصویر.بارگذاری قلم(مسیر قلم، موفق)
    اگر وارونه موفق:
        سرچاپ "قلمی با حرف‌های فارسی پیدا نشد؛ مسیر یک پرونده‌ی ttf را بدهید"
        برگشت ۱
    پایان
    دیرکن تصویر.آزادسازی قلم(قلم)
    ناپایا کارت := تصویر.جدید با رنگ(۱۲۰۰، ۶۳۰، تصویر.خواندن هگز("#1b4332"))
    دیرکن تصویر.آزادسازی(کارت)
    سفید := تصویر.قرمز سبز آبی(۲۵۵، ۲۵۵، ۲۵۵)
    سبک عنوان := تصویر.سبک متن { اندازه = ۷۲.۰ }
    اندازه := تصویر.نوشتن متن جا‌شده در کادر(کارت، ۸۰.۰، ۱۲۰.۰، ۱۰۴۰.۰، ۲۶۰.۰، "سلام ۰٫۶ منتشر شد: سریع‌تر و کوچک‌تر"، سفید، قلم، سبک عنوان، ۰.۹، ۹۶.۰)
    سرچاپ "اندازه‌ی عنوان:"، اندازه
    سبک ریز := تصویر.سبک متن { اندازه = ۳۶.۰ }
    پهنا := تصویر.عرض متن با سبک(قلم، "salamlang.ir"، سبک ریز)
    تصویر.نوشتن متن با سبک(کارت، ۱۱۲۰.۰ - پهنا، ۵۶۰.۰، "salamlang.ir"، تصویر.خواندن هگز("#95d5b2")، قلم، سبک ریز)
    سرچاپ "ذخیره شد:"، تصویر.ذخیره(کارت، "release-card.png")
پایان
