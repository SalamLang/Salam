واردسازی تصویر

تابع ریشه:
    فروش := [۱۲، ۳۰، ۲۲، ۴۱، ۳۵]
    برچسب‌ها := ["MON"، "TUE"، "WED"، "THU"، "FRI"]
    پهنا := ۲۶۰
    بلندا := ۱۶۰
    ناپایا نمودار := تصویر.جدید با رنگ(پهنا، بلندا، تصویر.قرمز سبز آبی(۲۵۵، ۲۵۵، ۲۵۵))
    دیرکن تصویر.آزادسازی(نمودار)
    کم := تصویر.خواندن هگز("#9ecae1")
    زیاد := تصویر.خواندن هگز("#08519c")
    تصویر.رسم خط(نمودار، ۲۰، ۱۳۰، ۲۵۰، ۱۳۰، تصویر.خاکستری(۸۰))
    هر ی، مقدار در فروش:
        ستون := مقدار * ۲
        ط := ۳۰ + ی * ۴۵
        رنگ := تصویر.درون‌یابی رنگ(کم، زیاد، (مقدار برگردان اعشار۶۴) / ۴۱.۰)
        تصویر.رسم مستطیل پر(نمودار، ط، ۱۳۰ - ستون، ۳۰، ستون، رنگ)
        تصویر.نوشتن متن(نمودار، ط + ۱۵ - تصویر.عرض متن(برچسب‌ها[ی]، ۱) / ۲، ۱۳۶، برچسب‌ها[ی]، تصویر.خاکستری(۴۰)، ۱)
    پایان
    تصویر.نوشتن متن(نمودار، ۲۰، ۸، "SALES"، تصویر.خاکستری(۲۰)، ۲)
    تصویر.ذخیره(نمودار، "chart.png")

    بلندترین := تصویر.دریافت پیکسل(نمودار، ۳۰ + ۳ * ۴۵ + ۱۵، ۱۳۰ - ۴۱)
    سرچاپ "رنگ بلندترین ستون:"، تصویر.به هگز آر جی بی(بلندترین)
    سرچاپ "رنگ نخستین ستون:"، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(نمودار، ۴۵، ۱۲۹))
    سرچاپ "زمینه:"، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(نمودار، ۵، ۵))
    سرچاپ "پهنای عنوان:"، تصویر.عرض متن("SALES"، ۲)، "پیکسل"
پایان
