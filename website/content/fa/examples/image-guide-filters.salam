واردسازی تصویر
واردسازی قالب بندی

تابع ریشه:
    ناپایا پایه := تصویر.جدید(۶۴، ۶۴)
    دیرکن تصویر.آزادسازی(پایه)
    تصویر.پر کردن(پایه، تصویر.قرمز سبز آبی(۳۰، ۳۰، ۳۰))
    تصویر.رسم مستطیل پر(پایه، ۱۶، ۱۶، ۳۲، ۳۲، تصویر.قرمز سبز آبی(۲۴۰، ۲۴۰، ۲۴۰))

    ناپایا نرم := تصویر.تار شده(پایه، ۳)
    ناپایا تیز := تصویر.تیزتر شده(نرم، ۱.۰)
    دیرکن تصویر.آزادسازی(نرم)
    دیرکن تصویر.آزادسازی(تیز)
    سرچاپ "پیکسل لبه، اصلی:"، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(پایه، ۱۶، ۳۲))
    سرچاپ "پیکسل لبه، تار:"، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(نرم، ۱۶، ۳۲))
    سرچاپ "خطای تاری:"، قالب بندی.عدد اعشار با دقت(تصویر.میانگین خطای مطلق(پایه، نرم)، ۲)، "PSNR"، قالب بندی.عدد اعشار با دقت(تصویر.نسبت سیگنال به نویز(پایه، نرم)، ۱)، "dB"
    سرچاپ "پس از تیز کردن:"، قالب بندی.عدد اعشار با دقت(تصویر.نسبت سیگنال به نویز(پایه، تیز)، ۱)، "dB، لبه"، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(تیز، ۱۶، ۳۲))

    ناپایا خاکستری := تصویر.کپی(پایه)
    دیرکن تصویر.آزادسازی(خاکستری)
    تصویر.پر کردن با هگز(خاکستری، "#cc3344")
    تصویر.خاکستری کردن(خاکستری)
    سرچاپ "قرمز پس از خاکستری کردن:"، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(خاکستری، ۰، ۰))، "درخشندگی"، تصویر.درخشندگی(تصویر.خواندن هگز("#cc3344"))
    تصویر.آستانه(خاکستری، ۱۲۸)
    سرچاپ "پس از آستانه‌ی ۱۲۸:"، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(خاکستری، ۰، ۰))
پایان
