واردسازی تصویر

تابع اندازه(عکس: تصویر.تصویر): رشته:
    برگشت "" + عکس.عرض + "x" + عکس.ارتفاع
پایان

تابع ریشه:
    ناپایا عکس := تصویر.جدید(۱۲۰۰، ۸۰۰)
    دیرکن تصویر.آزادسازی(عکس)
    تصویر.پر کردن با هگز(عکس، "#3a6ea5")
    تصویر.رسم دایره پر(عکس، ۶۰۰، ۴۰۰، ۲۵۰، تصویر.خواندن هگز("#f2c14e"))
    اگر تصویر.ذخیره(عکس، "photo.jpg") برابر نادرست:
        سرچاپ "نوشتن photo.jpg ممکن نشد"
        برگشت ۱
    پایان

    ناپایا موفق := نادرست
    ناپایا خوانده := تصویر.بازکردن("photo.jpg"، موفق)
    دیرکن تصویر.آزادسازی(خوانده)
    سرچاپ "باز شد:"، موفق، اندازه(خوانده)

    ناپایا کوچک := تصویر.تصویر کوچک(خوانده، ۲۰۰)
    ناپایا کارت := تصویر.تغییر اندازه پرکننده(خوانده، ۳۰۰، ۳۰۰)
    ناپایا بنر := تصویر.تغییر اندازه متناسب(خوانده، ۶۰۰، ۲۰۰)
    دیرکن تصویر.آزادسازی(کوچک)
    دیرکن تصویر.آزادسازی(کارت)
    دیرکن تصویر.آزادسازی(بنر)
    سرچاپ "تصویر کوچک:"، اندازه(کوچک)
    سرچاپ "کارت مربعی:"، اندازه(کارت)
    سرچاپ "قاب بنر:"، اندازه(بنر)
    تصویر.ذخیره(کوچک، "thumb.png")
    تصویر.ذخیره(کارت، "card.webp")
    سرچاپ "قالب‌ها:"، تصویر.قالب از پسوند("thumb.png") برابر تصویر.قالب پی‌ان‌جی، تصویر.قالب از پسوند("card.webp") برابر تصویر.قالب وب‌پی
پایان
