واردسازی تصویر

تابع ریشه:
    ناپایا عکس := تصویر.جدید با رنگ(۴۰۰، ۳۰۰، تصویر.خواندن هگز("#2d6a4f"))
    دیرکن تصویر.آزادسازی(عکس)
    متن := "MADE WITH SALAM"
    بزرگنمایی := ۲
    ناپایا نشان := تصویر.جدید(تصویر.عرض متن(متن، بزرگنمایی) + ۸، تصویر.ارتفاع قلم * بزرگنمایی + ۸)
    دیرکن تصویر.آزادسازی(نشان)
    تصویر.پر کردن(نشان، تصویر.قرمز سبز آبی آلفا(۰، ۰، ۰، ۱۶۰))
    تصویر.نوشتن متن(نشان، ۴، ۴، متن، تصویر.قرمز سبز آبی(۲۵۵، ۲۵۵، ۲۵۵)، بزرگنمایی)
    سرچاپ "اندازه‌ی نشان:"، نشان.عرض، "x"، نشان.ارتفاع

    ط := عکس.عرض - نشان.عرض - ۱۰
    ع := عکس.ارتفاع - نشان.ارتفاع - ۱۰
    تصویر.روپوش(عکس، نشان، ط، ع، ۰.۶)
    سرچاپ "جای نشان:"، ط، ع
    سرچاپ "گوشه‌ی دست نخورده:"، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(عکس، ۰، ۰))
    سرچاپ "زیر نشان:"، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(عکس، ط + ۱، ع + ۱))
    تصویر.ذخیره(عکس، "marked.png")
پایان
