میانجی شکل:
    تابع مساحت(): اعشار۶۴
    تابع شرح(): رشته:
        برگشت "مساحت " + این.مساحت()
    پایان
پایان

ساختار دایره:
    همگانی شعاع: اعشار۶۴ = ۱.۰
    همگانی تابع مساحت(): اعشار۶۴:
        برگشت ۳.۱۴ * این.شعاع * این.شعاع
    پایان
پایان

ساختار مربع:
    همگانی ضلع: اعشار۶۴ = ۱.۰
    همگانی تابع مساحت(): اعشار۶۴:
        برگشت این.ضلع * این.ضلع
    پایان
    همگانی تابع شرح(): رشته:
        برگشت "مربعی با ضلع " + این.ضلع
    پایان
پایان

تابع ریشه:
    سرچاپ دایره { شعاع = ۲.۰ }.شرح()
    سرچاپ مربع { ضلع = ۳.۰ }.شرح()
پایان
