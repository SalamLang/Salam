میانجی پیام‌رسان:
    روال بفرست(گیرنده: رشته، متن: رشته): منطقی
    روال راه(): رشته
پایان

ساختار ایمیل:
    همگانی سرور: رشته = "mail.example.com"
    همگانی روال بفرست(گیرنده: رشته، متن: رشته): منطقی:
        سرچاپ "  ایمیل به"، گیرنده، "از"، این.سرور، "|"، متن
        برگشت درست
    پایان
    همگانی روال راه(): رشته: برگشت "ایمیل" پایان
پایان

ساختار پیامک:
    همگانی اعتبار: صحیح = ۰
    همگانی روال بفرست(گیرنده: رشته، متن: رشته): منطقی:
        اگر این.اعتبار == ۰:
            برگشت نادرست
        پایان
        سرچاپ "  پیامک به"، گیرنده، "|"، متن
        برگشت درست
    پایان
    همگانی روال راه(): رشته: برگشت "پیامک" پایان
پایان

ساختار هشدار:
    همگانی با: پویا پیام‌رسان = ایمیل {}
    همگانی روال بزن(گیرنده: رشته):
        شد := این.با.بفرست(گیرنده، "دیسک تقریباً پر است")
        سرچاپ "هشدار با"، این.با.راه()، شد ? "فرستاده شد" : "نرسید"
    پایان
پایان

روال ریشه:
    راه‌ها := وکتور {} برگردان وکتور<پویا پیام‌رسان>
    راه‌ها.بیفزا(ایمیل {})
    راه‌ها.بیفزا(پیامک { اعتبار = ۰ })
    راه‌ها.بیفزا(پیامک { اعتبار = ۵ })
    ناپایا رسیده := ۰
    هر ر در راه‌ها:
        اگر ر.بفرست("سارا"، "سفارش شما ارسال شد"):
            رسیده += ۱
        پایان
    پایان
    سرچاپ رسیده، "از"، راه‌ها.طول()، "پیام رسید"
    هر ر در راه‌ها:
        ر.آزادکن()
    پایان
    راه‌ها.آزادکن()

    زنگ := هشدار { با = پیامک { اعتبار = ۱ } }
    زنگ.بزن("پشتیبانی")
    زنگ.با.آزادکن()
پایان
