میانجی شکل:
    روال مساحت(): صحیح
    روال نام(): رشته
پایان

ساختار مربع:
    ضلع: صحیح = ۰
    همگانی روال مساحت(): صحیح: برگشت این.ضلع * این.ضلع پایان
    همگانی روال نام(): رشته: برگشت "مربع" پایان
پایان

ساختار مستطیل:
    پهنا: صحیح = ۰
    بلندی: صحیح = ۰
    همگانی روال مساحت(): صحیح: برگشت این.پهنا * این.بلندی پایان
    همگانی روال نام(): رشته: برگشت "مستطیل" پایان
پایان

روال توصیف(ش: dyn شکل):
    سرچاپ ش.نام()، ش.مساحت()
پایان

روال ریشه:
    توصیف(مربع { ضلع = ۵ })
    توصیف(مستطیل { پهنا = ۴، بلندی = ۶ })
پایان
