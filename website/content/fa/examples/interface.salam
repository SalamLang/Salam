میانجی شکل:
    تابع مساحت(): صحیح
    تابع نام(): رشته
پایان

ساختار مربع:
    ضلع: صحیح = ۰
    همگانی تابع مساحت(): صحیح: برگشت این.ضلع * این.ضلع پایان
    همگانی تابع نام(): رشته: برگشت "مربع" پایان
پایان

ساختار مستطیل:
    پهنا: صحیح = ۰
    بلندی: صحیح = ۰
    همگانی تابع مساحت(): صحیح: برگشت این.پهنا * این.بلندی پایان
    همگانی تابع نام(): رشته: برگشت "مستطیل" پایان
پایان

تابع توصیف(ش: پویا شکل):
    سرچاپ ش.نام()، ش.مساحت()
پایان

تابع ریشه:
    توصیف(مربع { ضلع = ۵ })
    توصیف(مستطیل { پهنا = ۴، بلندی = ۶ })
پایان
