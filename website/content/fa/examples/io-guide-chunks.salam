واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع ریشه:
    ورودی خروجی.نوشتن پرونده("big.txt"، رشته.تکرار("0123456789"، ۲۵))
    پ := سیستم عامل.بازکردن("big.txt"، "rb")
    اگر پ == پوچ:
        ورودی خروجی.نوشتن خطا با خط جدید("باز کردن big.txt ممکن نیست")
        برگشت ۱
    پایان
    دیرکن ورودی خروجی.بستن(پ)
    ناپایا جمع := ۰
    ناپایا تکه‌ها := ۰
    تا درست:
        تکه := ورودی خروجی.خواندن(پ، ۶۴ برگردان طبیعی۶۴)
        اگر تکه == "":
            بشکن
        پایان
        تکه‌ها += ۱
        جمع += تکه.طول()
        سرچاپ "تکه‌ی"، تکه‌ها، "اندازه‌اش"، تکه.طول()، "بایت است"
    پایان
    سرچاپ جمع، "بایت در"، تکه‌ها، "تکه خوانده شد"
    برگشت ۰
پایان
