واردسازی ورودی خروجی
واردسازی رشته

تابع ریشه:
    ورودی خروجی.نوشتن پرونده("app.conf"، "# تنظیمات سرور\nدرگاه = ۸۰۸۰\n\nمیزبان = localhost\nکارگرها = ۴\n")
    ناپایا تنظیمات := نگاشت {} برگردان نگاشت<رشته، رشته>
    دیرکن تنظیمات.آزادکن()
    خط‌ها := ورودی خروجی.خط ها("app.conf")
    دیرکن خط‌ها.آزادکن()
    هر خط در خط‌ها:
        اگر خط == "" یا رشته.شروع با(خط، "#"):
            گذر
        پایان
        جای مساوی := رشته.اندیس(خط، "=")
        اگر جای مساوی < ۰:
            ورودی خروجی.نوشتن خطا با خط جدید("خط بدون '=' کنار گذاشته شد: " + خط)
            گذر
        پایان
        کلید := رشته.پیرایش(رشته.زیررشته(خط، ۰، جای مساوی))
        مقدار := رشته.پیرایش(رشته.زیررشته(خط، جای مساوی + ۱، خط.طول() - جای مساوی - ۱))
        تنظیمات.درج(کلید، مقدار)
    پایان
    سرچاپ "میزبان:"، تنظیمات.بگیر("میزبان")
    سرچاپ "درگاه:"، تنظیمات.بگیر("درگاه").به صحیح() + ۱
    سرچاپ "تنظیم‌های خوانده‌شده:"، تنظیمات.اندازه()
پایان
