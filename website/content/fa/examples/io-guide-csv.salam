واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع ریشه:
    ورودی خروجی.نوشتن پرونده("sales.csv"، "کالا,تعداد,قیمت\nخودکار,3,12\nدفتر,2,45\nکیف,1,180\n")
    پ := سیستم عامل.بازکردن("sales.csv"، "rb")
    دیرکن ورودی خروجی.بستن(پ)
    سرستون := ورودی خروجی.خواندن خط(پ)
    سرچاپ "ستون‌ها:"، سرستون
    ناپایا جمع := ۰
    ناپایا خط := ورودی خروجی.خواندن خط(پ)
    تا خط != "":
        ستون‌ها := رشته.تفکیک کردن(خط، ",")
        هزینه := ستون‌ها.بگیر(۱).به صحیح() * ستون‌ها.بگیر(۲).به صحیح()
        سرچاپ ستون‌ها.بگیر(۰)، هزینه
        جمع += هزینه
        ستون‌ها.آزادکن()
        خط = ورودی خروجی.خواندن خط(پ)
    پایان
    سرچاپ "جمع کل:"، جمع
پایان
