واردسازی ورودی خروجی

تابع ثبت(مسیر: رشته، سطح: رشته، پیام: رشته):
    اگر ورودی خروجی.افزودن به پرونده(مسیر، "[" + سطح + "] " + پیام + "\n") < ۰:
        ورودی خروجی.نوشتن خطا با خط جدید("نوشتن در " + مسیر + " ممکن نیست")
    پایان
پایان

تابع ریشه:
    مسیر := "app.log"
    ورودی خروجی.نوشتن پرونده(مسیر، "")
    ثبت(مسیر، "آگاهی"، "سرور راه افتاد")
    ثبت(مسیر، "هشدار"، "دیسک ۹۱ درصد پر است")
    ثبت(مسیر، "آگاهی"، "به درخواست پاسخ داده شد")
    ثبت(مسیر، "خطا"، "پایگاه داده پاسخ نداد")
    ناپایا مشکل‌ها := ۰
    خط‌ها := ورودی خروجی.خط ها(مسیر)
    دیرکن خط‌ها.آزادکن()
    هر خط در خط‌ها:
        اگر خط.شروع با("[هشدار]") یا خط.شروع با("[خطا]"):
            مشکل‌ها += ۱
            سرچاپ خط
        پایان
    پایان
    سرچاپ خط‌ها.طول()، "خط،"، مشکل‌ها، "مورد نیاز به بررسی دارد"
پایان
