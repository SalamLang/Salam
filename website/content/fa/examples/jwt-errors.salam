واردسازی جی دبلیو تی
واردسازی رشته

تابع گزارش(برچسب: رشته، توکن: رشته، راز: رشته، گزینه: جی دبلیو تی.گزینه ها):
    ناپایا خطا := ۰
    _ := جی دبلیو تی.تایید(توکن، راز، گزینه، خطا)
    اگر خطا برابر جی دبلیو تی.بدون خطا:
        سرچاپ برچسب + ": درست"
    وگرنه:
        سرچاپ برچسب + ": " + جی دبلیو تی.متن خطا(خطا)
    پایان
پایان

تابع ریشه:
    راز := "a-long-random-secret-for-this-demo"
    ناپایا ادعا := جی دبلیو تی.ادعاهای جدید()
    ادعا.sub = "7"
    ادعا.iss = "auth.example.com"
    ادعا.iat = ۱۷۹۰۰۰۰۰۰۰
    ادعا.nbf = ۱۷۹۰۰۰۰۰۰۰
    ادعا.exp = ۱۷۹۰۰۰۰۹۰۰
    ناپایا خطا := ۰
    توکن := جی دبلیو تی.امضای اچ اس۲۵۶(ادعا، راز، خطا)

    ناپایا گزینه := جی دبلیو تی.گزینه های پیش فرض()
    گزینه.issuer = "auth.example.com"
    گزینه.now = ۱۷۹۰۰۰۰۳۰۰
    گزارش("توکن تازه"، توکن، راز، گزینه)
    گزارش("راز نادرست"، توکن، "guess"، گزینه)

    بخش‌ها := رشته.تفکیک کردن(توکن، ".")
    جعلی := بخش‌ها.بگیر(۰) + "." + جی دبلیو تی.کدگذاری پایه۶۴ نشانی("{\"sub\":\"1\",\"iss\":\"auth.example.com\"}") + "." + بخش‌ها.بگیر(۲)
    گزارش("بار دست‌کاری شده"، جعلی، راز، گزینه)

    گزینه.now = ۱۷۹۰۰۰۱۰۰۰
    گزارش("۱۰۰ ثانیه پس از انقضا"، توکن، راز، گزینه)
    گزینه.leeway = ۱۲۰
    گزارش("همان، با ۱۲۰ ثانیه ارفاق"، توکن، راز، گزینه)

    گزینه.leeway = ۰
    گزینه.now = ۱۷۸۹۹۹۹۰۰۰
    گزارش("پیش از nbf"، توکن، راز، گزینه)

    گزینه.now = ۱۷۹۰۰۰۰۳۰۰
    گزینه.issuer = "evil.example.com"
    گزارش("صادرکننده‌ی دیگر"، توکن، راز، گزینه)

    قوی := جی دبلیو تی.امضای اچ اس۵۱۲(ادعا، راز، خطا)
    ناپایا گزینه‌ی سخت‌گیر := جی دبلیو تی.گزینه ها برای(جی دبلیو تی.الگوریتم اچ اس۲۵۶)
    گزینه‌ی سخت‌گیر.now = ۱۷۹۰۰۰۰۳۰۰
    گزارش("توکن HS512 به جای HS256"، قوی، راز، گزینه‌ی سخت‌گیر)
پایان
