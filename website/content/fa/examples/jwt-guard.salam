واردسازی کدگذاری.جیسون
واردسازی جی دبلیو تی
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا نگهبان من := جی دبلیو تی.نگهبان جدید("k8R2pX7wQ4mZ9vL1cT6yB3nH5sD0fG2a")

تابع ورود کاربر(ز: صحیح۶۴):
    ناپایا ادعا := جی دبلیو تی.ادعاهای جدید()
    ادعا.موضوع = اچ تی تی پی.فرم(ز، "user")
    جی دبلیو تی.تنظیم رشته(ادعا، "scope"، "orders:read")
    ناپایا خطای امضا := ۰
    توکن := جی دبلیو تی.صدور(نگهبان من، ادعا، ۹۰۰، خطای امضا)
    اچ تی تی پی.جیسون(ز، "{\"token\":\"" + توکن + "\"}")
پایان

تابع سفارش‌ها(ز: صحیح۶۴):
    ناپایا ت := جی دبلیو تی.توکن {}
    اگر وارونه جی دبلیو تی.نیاز به دامنه(ز، نگهبان من، "orders:read"، ت): برگشت پایان
    اچ تی تی پی.جیسون(ز، "{\"orders_for\":\"" + ت.ادعاها.موضوع + "\"}")
پایان

تابع مدیریت(ز: صحیح۶۴):
    ناپایا ت := جی دبلیو تی.توکن {}
    اگر وارونه جی دبلیو تی.نیاز به دامنه(ز، نگهبان من، "admin"، ت): برگشت پایان
    اچ تی تی پی.متن(ز، "خوش آمدید، مدیر")
پایان

تابع درخواست(مسیر: رشته، توکن: رشته):
    ناپایا سرها := اچ تی تی پی.سرصفحه جدید()
    اگر توکن.طول() بزرگتر ۰: سرها.درج("Authorization"، "Bearer " + توکن) پایان
    پ := اچ تی تی پی.دریافت با("http://127.0.0.1:18662" + مسیر، سرها)
    سرچاپ مسیر، اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.بدنه(پ)
پایان

تابع ریشه:
    نگهبان من.گزینه‌ها.انقضا لازم = درست
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/login"، ورود کاربر)
    مسیریاب.دریافت(م، "/orders"، سفارش‌ها)
    مسیریاب.دریافت(م، "/admin"، مدیریت)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۸۶۶۲)
    اچ تی تی پی.تنظیم میزبان(س، "127.0.0.1")
    اچ تی تی پی.استفاده(س، م)
    اگر وارونه اچ تی تی پی.اجرا در پس زمینه(س):
        سرچاپ "درگاه ۱۸۶۶۲ گرفته است"
        برگشت ۱
    پایان
    پاسخ := اچ تی تی پی.ارسال("http://127.0.0.1:18662/login"، "user=sara")
    توکن := جیسون.دریافت(اچ تی تی پی.بدنه(پاسخ)، "token")
    درخواست("/orders"، "")
    درخواست("/orders"، توکن)
    درخواست("/admin"، توکن)

    ناپایا همیشگی := جی دبلیو تی.ادعاهای جدید()
    همیشگی.موضوع = "sara"
    جی دبلیو تی.تنظیم رشته(همیشگی، "scope"، "orders:read")
    ناپایا خطا := ۰
    درخواست("/orders"، جی دبلیو تی.امضای اچ اس۲۵۶(همیشگی، نگهبان من.کلید امضا، خطا))
    برگشت ۰
پایان
