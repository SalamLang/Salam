واردسازی جی دبلیو تی

تابع راز کلید(شناسه: رشته): رشته:
    کلیدها := نگاشت {} برگردان نگاشت<رشته، رشته>
    کلیدها.درج("2026-09"، "old-secret-kept-for-one-more-week")
    کلیدها.درج("2026-10"، "current-secret-used-for-new-tokens")
    اگر کلیدها.دارد(شناسه):
        برگشت کلیدها.بگیر(شناسه)
    پایان
    برگشت ""
پایان

تابع بررسی(توکن: رشته) خطادار:
    سرآیند := تلاش جی دبلیو تی.کدگشایی(توکن)
    راز := راز کلید(سرآیند.شناسه کلید)
    اگر راز.طول() برابر ۰:
        سرچاپ "کلید"، سرآیند.شناسه کلید، "رد شد: کلید ناشناخته"
        برگشت
    پایان
    ناپایا گزینه := جی دبلیو تی.گزینه های پیش فرض()
    گزینه.اکنون = ۱۷۹۰۰۰۰۱۰۰
    ت := تلاش جی دبلیو تی.تایید(توکن، راز، گزینه)
    سرچاپ "کلید"، سرآیند.شناسه کلید، "معتبر:"، ت.معتبر، "کاربر:"، ت.ادعاها.موضوع
پایان

تابع ریشه خطادار:
    ناپایا ادعا := جی دبلیو تی.ادعاهای جدید()
    ادعا.موضوع = "user-17"
    ادعا.زمان صدور = ۱۷۹۰۰۰۰۰۰۰
    ادعا.زمان انقضا = ۱۷۹۰۰۰۳۶۰۰
    کهنه := تلاش جی دبلیو تی.امضا با شناسه کلید(ادعا، جی دبلیو تی.الگوریتم اچ اس۲۵۶، "2026-09"، "old-secret-kept-for-one-more-week")
    تازه := تلاش جی دبلیو تی.امضا با شناسه کلید(ادعا، جی دبلیو تی.الگوریتم اچ اس۲۵۶، "2026-10"، "current-secret-used-for-new-tokens")
    سرگردان := تلاش جی دبلیو تی.امضا با شناسه کلید(ادعا، جی دبلیو تی.الگوریتم اچ اس۲۵۶، "2025-01"، "a-secret-nobody-has-anymore")
    تلاش بررسی(کهنه)
    تلاش بررسی(تازه)
    تلاش بررسی(سرگردان)
پایان
