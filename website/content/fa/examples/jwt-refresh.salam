واردسازی جی دبلیو تی

تابع صدور(کاربر: رشته، کاربرد: رشته، زمان صدور: صحیح۶۴، عمر: صحیح۶۴، راز: رشته): رشته:
    ناپایا ادعا := جی دبلیو تی.ادعاهای جدید()
    ادعا.موضوع = کاربر
    ادعا.زمان صدور = زمان صدور
    ادعا.زمان انقضا = زمان صدور + عمر
    جی دبلیو تی.تنظیم رشته(ادعا، "use"، کاربرد)
    ناپایا خطا := ۰
    برگشت جی دبلیو تی.امضای اچ اس۲۵۶(ادعا، راز، خطا)
پایان

تابع پذیرش(توکن: رشته، کاربرد لازم: رشته، اکنون: صحیح۶۴، راز: رشته): منطقی:
    ناپایا گزینه := جی دبلیو تی.گزینه های پیش فرض()
    گزینه.اکنون = اکنون
    گزینه.انقضا لازم = درست
    ناپایا خطا := ۰
    ت := جی دبلیو تی.تایید(توکن، راز، گزینه، خطا)
    اگر وارونه ت.معتبر:
        سرچاپ "  رد شد:"، جی دبلیو تی.متن خطا(خطا)
        برگشت نادرست
    پایان
    اگر جی دبلیو تی.رشته(ت، "use") نابرابر کاربرد لازم:
        سرچاپ "  رد شد: لازم بود"، کاربرد لازم، "ولی آمد"، جی دبلیو تی.رشته(ت، "use")
        برگشت نادرست
    پایان
    برگشت درست
پایان

تابع ریشه:
    راز := "server-side-secret-of-at-least-32-bytes"
    ورود := ۱۷۹۰۰۰۰۰۰۰ برگردان صحیح۶۴
    دسترسی := صدور("42"، "access"، ورود، ۹۰۰، راز)
    تمدید := صدور("42"، "refresh"، ورود، ۳۰ * ۸۶۴۰۰، راز)

    سرچاپ "درخواست پس از ۵ دقیقه:"، پذیرش(دسترسی، "access"، ورود + ۳۰۰، راز)
    سرچاپ "درخواست پس از ۲۰ دقیقه:"، پذیرش(دسترسی، "access"، ورود + ۱۲۰۰، راز)
    سرچاپ "تمدید پس از ۲۰ دقیقه:"، پذیرش(تمدید، "refresh"، ورود + ۱۲۰۰، راز)
    دسترسی تازه := صدور("42"، "access"، ورود + ۱۲۰۰، ۹۰۰، راز)
    سرچاپ "درخواست با توکن تازه:"، پذیرش(دسترسی تازه، "access"، ورود + ۱۳۰۰، راز)
    سرچاپ "توکن تمدید به جای دسترسی:"، پذیرش(تمدید، "access"، ورود + ۱۳۰۰، راز)
پایان
