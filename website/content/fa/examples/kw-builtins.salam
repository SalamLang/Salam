روال ریشه:
    واژه := "salam"
    سرچاپ زبان()، طول(واژه)، اندازه‌گونه(صحیح۶۴)
    سرچاپ کدنویسه("A")، نویسه‌ازکد(۶۶)، مقایسه‌رشته("ab"، "ac") < ۰

    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن نام‌ها.آزادکن()
    نام‌ها.بیفزا("sara")
    نام‌ها.بیفزا("reza")
    سرچاپ نام‌ها.طول()، نام‌ها.بگیر(۱)، نام‌ها.دربیاور()

    ناپایا سن‌ها := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن سن‌ها.آزادکن()
    سن‌ها.درج("sara"، ۳۱)
    سرچاپ سن‌ها.دارد("sara")، سن‌ها.بگیر("sara")، سن‌ها.اندازه()

    متن := "  hello world  ".پیراست()
    سرچاپ متن.شروع با("hello")، متن.بیاب("world")، متن.زیررشته(۰، ۵)
    سرچاپ "سلام".طول()، "سلام".شمارنویسه()
پایان
