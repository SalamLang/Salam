گونه قاعده = تابع (صحیح) منطقی

تابع شمردن(مقدارها: صحیح[]، شرط: قاعده): صحیح:
    ناپایا ن := ۰
    هر م در مقدارها:
        اگر شرط(م):
            ن += ۱
        پایان
    پایان
    برگشت ن
پایان

تابع ریشه:
    دماها := [۱۲، ۱۸، ۲۵، ۳۱، ۹، ۲۷]
    گرم := (د: صحیح): برگشت د >= ۲۵ پایان
    سرچاپ "روزهای گرم:"، شمردن(دماها، گرم)
    سرچاپ "روزهای سرد:"، شمردن(دماها، (د: صحیح): برگشت د < ۱۰ پایان)
پایان
