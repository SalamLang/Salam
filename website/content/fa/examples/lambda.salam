روال به‌کاربردن(ر: روال (صحیح) صحیح، مقدار: صحیح): صحیح:
    برگشت ر(مقدار)
پایان

روال ریشه:
    دوبرابر := (ع: صحیح) => ع * ۲
    سرچاپ دوبرابر(۵)
    سرچاپ به‌کاربردن((ع: صحیح) => ع * ع، ۷)
    رده := (نمره: صحیح):
        قبول := نمره >= ۱۰
        برگشت قبول ? "قبول" : "مردود"
    پایان
    سرچاپ رده(۱۴)، رده(۸)
پایان
