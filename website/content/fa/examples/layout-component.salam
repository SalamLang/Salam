بخش طرح(نام، بها):
    جعبه:
        کادر = 1px، توپر، #ddd
        گردی = 12px
        فاصله = 16
        سرتیتر: اندازه = ۲ محتوا = نام پایان
        پاراگراف: محتوا = "ماهانه " + بها + " هزار تومان" پایان
        محتوا: پایان
    پایان
