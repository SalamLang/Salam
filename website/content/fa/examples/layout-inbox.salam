بخش نشان(متن: رشته):
    اسپن: محتوا = متن پس‌زمینه = "#fde68a" پایان
پایان

چیدمان صندوق(کاربر: رشته، موضوع‌ها: وکتور<رشته>، نخوانده: صحیح):
    عنوان = "صندوق " + کاربر
    زبان = "فارسی"
    جهت = "راست به چپ"
    سرتیتر: اندازه = ۱ محتوا = "درود، " + کاربر پایان
    اگر نخوانده == ۰:
        پاراگراف: محتوا = "پیام تازه‌ای ندارید" پایان
    وگرنه:
        پاراگراف: محتوا = "نخوانده: " + نخوانده پایان
        فهرست:
            هر ش، م در موضوع‌ها:
                مورد: محتوا = (ش + ۱) + ". " + م پایان
            پایان
        پایان
    پایان
پایان

روال ریشه:
    ناپایا موضوع‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن موضوع‌ها.آزادکن()
    موضوع‌ها.بیفزا("جلسه‌ی ساعت ۱۰")
    موضوع‌ها.بیفزا("<b>جایزه</b> رایگان & بیشتر")
    سرچاپ صندوق("سارا"، موضوع‌ها، موضوع‌ها.طول())
    سرچاپ نشان("تازه")
پایان
