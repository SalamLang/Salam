صفحه کارت(نام: رشته، امتیاز: صحیح):
    عنوان = «کارت » + نام
    زبان = «فارسی»
    جهت = «راست به چپ»
    سرتیتر:
        اندازه = ۲
        محتوا = نام
    پایان
    اگر امتیاز بزرگتربرابر ۵۰:
        پاراگراف:
            محتوا = «قبول»
        پایان
    وگرنه:
        پاراگراف:
            محتوا = «مردود»
        پایان
    پایان
پایان

تابع از(صفحه: رشته، نشانه: رشته): رشته:
    آغاز := صفحه.بیاب(نشانه)
    برگشت صفحه.زیررشته(آغاز، صفحه.طول() - آغاز)
پایان

تابع ریشه:
    سرچاپ از(کارت(«علی»، ۷۰)، "<body>")
پایان
