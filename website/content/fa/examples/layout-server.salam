واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

چیدمان خوشامد(نام: رشته):
    عنوان = "درود " + نام
    زبان = "فارسی"
    جهت = "راست به چپ"
    سرتیتر: اندازه = ۱ محتوا = "درود، " + نام پایان
    پاراگراف: محتوا = "این صفحه روی سرور ساخته شد." پایان
پایان

روال خانه(زمینه: صحیح۶۴):
    ناپایا نام := اچ تی تی پی.پرسمان زمینه(زمینه، "name")
    اگر نام == "":
        نام = "مهمان"
    پایان
    اچ تی تی پی.اچ تی ام ال زمینه(زمینه، خوشامد(نام))
پایان

روال ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/"، خانه)
    ناپایا س := اچ تی تی پی.سرور جدید(۸۰۸۰)
    اچ تی تی پی.استفاده(س، م)
    اچ تی تی پی.اجرا(س)
پایان
