پایا رنگ‌اصلی := "#0f766e"
پایا فاصله := ۱۶

چیدمان:
    عنوان = "تعرفه‌ها"
    زبان = "فارسی"
    جهت = "راست به چپ"
    سراسری: اندازه جعبه = "border-box" پایان
    سراسری: گزینشگر = "body" حاشیه = "0" خانواده قلم = "sans-serif" پایان
    بخش:
        نمایش = "flex"
        شکاف = فاصله + "px"
        فاصله داخلی = فاصله * ۲ + "px"
        جعبه:
            کادر = "1px solid #ddd"
            گردی کادر = "12px"
            فاصله داخلی = فاصله + "px"
            سرتیتر: اندازه = ۲ محتوا = "رایگان" پایان
            پاراگراف: محتوا = "برای امتحان کردن" پایان
        پایان
        جعبه:
            کادر = "2px solid " + رنگ‌اصلی
            گردی کادر = "12px"
            فاصله داخلی = فاصله + "px"
            سرتیتر: اندازه = ۲ محتوا = "حرفه‌ای" رنگ = رنگ‌اصلی پایان
            دکمه:
                محتوا = "ارتقا"
                پس‌زمینه = رنگ‌اصلی
                رنگ = "سفید"
                اشاره پس‌زمینه = "#115e59"
                نشانگر = "pointer"
            پایان
        پایان
    پایان
پایان
