پایا رنگ‌اصلی := "#0f766e"
پایا فاصله := ۱۶

صفحه:
    عنوان = "تعرفه‌ها"
    زبان = "فارسی"
    جهت = "راست به چپ"
    سراسری: پایان
    سراسری: گزینشگر = "body" حاشیه = "0" قلم = ساده پایان
    بخش:
        چیدمان = ردیف
        شکاف = فاصله، +، "px"
        فاصله داخلی = فاصله * ۲ + "px"
        جعبه:
            کادر = 1px، توپر، #ddd
            گردی = 12px
            فاصله داخلی = فاصله + "px"
            سرتیتر: اندازه = ۲ محتوا = "رایگان" پایان
            پاراگراف: محتوا = "برای امتحان کردن" پایان
        پایان
        جعبه:
            کادر = 2px، توپر + رنگ‌اصلی
            گردی = 12px
            فاصله داخلی = فاصله + "px"
            سرتیتر: اندازه = ۲ محتوا = "حرفه‌ای" رنگ = رنگ‌اصلی پایان
            دکمه:
                محتوا = "ارتقا"
                پس‌زمینه = رنگ‌اصلی
                رنگ = سفید
                اشاره پس‌زمینه = #115e59
                نشانگر = "pointer"
            پایان
        پایان
    پایان
پایان
