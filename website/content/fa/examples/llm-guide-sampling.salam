واردسازی مدل زبانی بزرگ
واردسازی تانسور

تابع شمارش(نمونه‌بردار &: مدل زبانی بزرگ.نمونه‌بردار، لاجیت ها &: تانسور.تانسور): رشته:
    ناپایا دیده := [۰، ۰، ۰، ۰]
    ناپایا اخیر := وکتور {} برگردان وکتور<صحیح>
    تکرار ۱۰۰۰:
        دیده[نمونه‌بردار.نمونه(لاجیت ها، ۰، اخیر)] += ۱
    پایان
    برگشت "" + دیده[۰] + " " + دیده[۱] + " " + دیده[۲] + " " + دیده[۳]
پایان

تابع ریشه:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۳۲>
    هر م در [۲.۰، ۱.۵، ۰.۵، -۱.۰]:
        داده.بیفزا(م برگردان اعشار۳۲)
    پایان
    شکل := تانسور.شکل دو(۱، ۴)
    لاجیت ها := تانسور.از آرایه(شکل، داده)
    سرچاپ "حریصانه همیشه این را برمی‌دارد:"، مدل زبانی بزرگ.حریصانه(لاجیت ها، ۰)
    ناپایا ساده := مدل زبانی بزرگ.نمونه‌بردار جدید(۱)
    سرچاپ "دمای ۱.۰:"، شمارش(ساده، لاجیت ها)
    ناپایا سرد := مدل زبانی بزرگ.نمونه‌بردار جدید(۱)
    سرد.دما = ۰.۳
    سرچاپ "دمای ۰.۳:"، شمارش(سرد، لاجیت ها)
    ناپایا داغ := مدل زبانی بزرگ.نمونه‌بردار جدید(۱)
    داغ.دما = ۲.۰
    سرچاپ "دمای ۲.۰:"، شمارش(داغ، لاجیت ها)
    ناپایا دو برتر := مدل زبانی بزرگ.نمونه‌بردار جدید(۱)
    دو برتر.شمار محتمل‌ترین‌ها = ۲
    سرچاپ "top_k ۲:  "، شمارش(دو برتر، لاجیت ها)
پایان
