واردسازی مدل زبانی بزرگ

تابع نمایش(توکن‌ساز &: مدل زبانی بزرگ.توکن‌ساز، متن: رشته):
    شناسه‌ها := توکن‌ساز.رمزگذاری(متن)
    ناپایا تکه ها := ""
    هر شناسه در شناسه‌ها:
        تکه ها = تکه ها + "[" + توکن‌ساز.متن توکن(شناسه) + "]"
    پایان
    سرچاپ متن، "<-"، شناسه‌ها.طول()، "توکن"، تکه ها
پایان

تابع ریشه:
    ناپایا توکن‌ساز := مدل زبانی بزرگ.توکن‌ساز جدید(مدل زبانی بزرگ.توکن‌ساز بایتی)
    هر تکه در ["l"، "o"، "w"، "e"، "r"، "n"، "s"، "t"، "Ġ"، "lo"، "low"، "er"، "lower"]:
        _ := توکن‌ساز.افزودن توکن(تکه، ۰.۰)
    پایان
    توکن‌ساز.افزودن ادغام("l"، "o")
    توکن‌ساز.افزودن ادغام("lo"، "w")
    توکن‌ساز.افزودن ادغام("e"، "r")
    توکن‌ساز.افزودن ادغام("low"، "er")
    توکن‌ساز.پایان()
    توکن‌ساز.افزودن توکن آغاز = نادرست
    نمایش(توکن‌ساز، "low")
    نمایش(توکن‌ساز، "lower")
    نمایش(توکن‌ساز، "slower")
    نمایش(توکن‌ساز، "newest")
    نمایش(توکن‌ساز، "lower tower")
    سرچاپ "رفت و برگشت:"، توکن‌ساز.رمزگشایی(توکن‌ساز.رمزگذاری("lower tower")) == "lower tower"
    توکن‌ساز.آزادسازی()
پایان
