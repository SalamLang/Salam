واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع ریشه:
    مسیر := سیستم عامل.پوشه موقت() + "/salam_guide_square_fa.ll"
    _ := ورودی خروجی.نوشتن پرونده(مسیر، `define i32 @square_sum(i32 %n) {
entry:
  %a = alloca i32
  store i32 0, ptr %a
  %x = mul i32 %n, %n
  %old = load i32, ptr %a
  %new = add i32 %old, %x
  store i32 %new, ptr %a
  %r = load i32, ptr %a
  ret i32 %r
}
`)
    تجزیه := ال ال وی ام.تجزیه آی آر(مسیر)
    اگر وارونه تجزیه.ok:
        سرچاپ تجزیه.err
        برگشت ۱
    پایان
    ساخت := ال ال وی ام.ماشین هدف جدید("x86_64-unknown-linux-gnu"، ال ال وی ام.بهینه‌سازی دو، نادرست)
    اگر وارونه ساخت.ok:
        سرچاپ ساخت.err
        برگشت ۱
    پایان
    ال ال وی ام.تنظیم سه‌تایی هدف(تجزیه.mod، "x86_64-unknown-linux-gnu")
    ال ال وی ام.اعمال آرایش داده(تجزیه.mod، ساخت.tm)
    بهینه := ال ال وی ام.اجرای بهینه‌سازی(تجزیه.mod، ساخت.tm، ال ال وی ام.بهینه‌سازی دو)
    اگر وارونه بهینه.ok:
        سرچاپ بهینه.err
        برگشت ۱
    پایان
    متن := ال ال وی ام.ماژول به رشته(تجزیه.mod)
    هر خط در رشته.تفکیک کردن(متن، "\n"):
        اگر رشته.شروع با(خط، "define") یا رشته.شروع با(خط، "  "):
            سرچاپ خط
        پایان
    پایان
    اسمبلی := سیستم عامل.پوشه موقت() + "/salam_guide_square_fa.s"
    تولید := ال ال وی ام.تولید اسمبلی(تجزیه.mod، ساخت.tm، اسمبلی)
    اگر وارونه تولید.ok:
        سرچاپ تولید.err
        برگشت ۱
    پایان
    هر خط در رشته.تفکیک کردن(ورودی خروجی.خواندن پرونده(اسمبلی)، "\n"):
        اگر رشته.شروع با(خط، "\t") و وارونه رشته.شروع با(خط، "\t."):
            سرچاپ رشته.پیرایش(رشته.جایگزینی(خط، "\t"، " "))
        پایان
    پایان
    ال ال وی ام.آزادسازی ماشین هدف(ساخت.tm)
    ال ال وی ام.آزادسازی ماژول(تجزیه.mod)
    ال ال وی ام.آزادسازی زمینه(تجزیه.ctx)
پایان
