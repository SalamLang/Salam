واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی رشته

تابع ریشه:
    برنامه := "2 3 + 4 * 6 -"
    ز := ال ال وی ام.زمینه جدید()
    م := ال ال وی ام.ماژول جدید(ز، "rpn")
    س := ال ال وی ام.سازنده جدید(ز)
    ص۳۲ := ال ال وی ام.نوع سی‌ودو بیتی(ز)
    هیچ := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    تابعک := ال ال وی ام.افزودن تابعی(م، "main"، ال ال وی ام.نوع تابعی(ص۳۲، هیچ، نادرست))
    ال ال وی ام.قرار دادن در انتها(س، ال ال وی ام.افزودن بلوک(ز، تابعک، "entry"))
    ناپایا پشته := وکتور {} برگردان وکتور<ال ال وی ام.مقدار>
    هر واژه در رشته.تفکیک کردن(برنامه، " "):
        اگر واژه == "+" یا واژه == "-" یا واژه == "*":
            راست := پشته.دربیاور()
            چپ := پشته.دربیاور()
            اگر واژه == "+": پشته.بیفزا(ال ال وی ام.جمع(س، چپ، راست، "t")) پایان
            اگر واژه == "-": پشته.بیفزا(ال ال وی ام.تفریق(س، چپ، راست، "t")) پایان
            اگر واژه == "*": پشته.بیفزا(ال ال وی ام.ضرب(س، چپ، راست، "t")) پایان
        وگرنه:
            پشته.بیفزا(ال ال وی ام.ثابت صحیح(ص۳۲، رشته.تبدیل به عدد(واژه) برگردان صحیح۶۴))
        پایان
    پایان
    _ := ال ال وی ام.بازگشت(س، پشته.دربیاور())
    سرچاپ ال ال وی ام.بررسی(م).معتبر
    مسیر := سیستم عامل.پوشه موقت() + "/salam_guide_rpn_fa.ll"
    _ := ورودی خروجی.نوشتن پرونده(مسیر، ال ال وی ام.ماژول به رشته(م))
    سرچاپ برنامه، "="، ال ال وی ام.اجرای جیت(مسیر).مقدار برگشتی
    ال ال وی ام.آزادسازی سازنده(س)
    ال ال وی ام.آزادسازی ماژول(م)
    ال ال وی ام.آزادسازی زمینه(ز)
پایان
