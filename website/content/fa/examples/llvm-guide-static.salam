واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل

تابع ریشه:
    پوشه := سیستم عامل.پوشه موقت()
    ll := پوشه + "/salam_guide_static_fa.ll"
    _ := ورودی خروجی.نوشتن پرونده(ll، `define i32 @main() {
entry:
  ret i32 7
}
`)
    ناپایا گ := ال ال وی ام.تنظیمات پیش‌فرض()
    گ.سطح بهینه‌سازی = ال ال وی ام.بهینه‌سازی دو
    گ.سه‌تایی هدف = "x86_64-unknown-linux-musl"
    گ.نوع خروجی = ال ال وی ام.خروجی شیء
    گ.پرونده خروجی = پوشه + "/salam_guide_static_fa.o"
    ساخته := ال ال وی ام.اجرا(ll، گ)
    اگر وارونه ساخته.موفق:
        سرچاپ "کامپایل نشد:"، ساخته.خطا
        برگشت ۱
    پایان
    سرچاپ "این‌جا پیوند می‌خورد:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد(گ.سه‌تایی هدف)
    پیوند := ال ال وی ام.پیوند خودکار(گ.پرونده خروجی، پوشه + "/salam_guide_static_fa"، گ)
    اگر وارونه پیوند.موفق:
        سرچاپ "پیوند نخورد:"، پیوند.خطا
        برگشت ۱
    پایان
    سرچاپ "ساخته شد:"، پوشه + "/salam_guide_static_fa"
پایان
