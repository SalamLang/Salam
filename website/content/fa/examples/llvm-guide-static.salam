واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل

تابع ریشه:
    پوشه := سیستم عامل.پوشه موقت()
    ll := پوشه + "/salam_guide_static_fa.ll"
    _ := ورودی خروجی.نوشتن پرونده(ll، `define i32 @main() {
entry:
  ret i32 7
}
`)
    ناپایا گ := ال ال وی ام.تنظیمات پیش‌فرض()
    گ.opt_level = ال ال وی ام.بهینه‌سازی دو
    گ.target_triple = "x86_64-unknown-linux-musl"
    گ.output_mode = ال ال وی ام.خروجی شیء
    گ.output_file = پوشه + "/salam_guide_static_fa.o"
    ساخته := ال ال وی ام.اجرا(ll، گ)
    اگر وارونه ساخته.ok:
        سرچاپ "کامپایل نشد:"، ساخته.error
        برگشت ۱
    پایان
    سرچاپ "این‌جا پیوند می‌خورد:"، ال ال وی ام.می‌توان سه‌تایی را پیوند داد(گ.target_triple)
    پیوند := ال ال وی ام.پیوند خودکار(گ.output_file، پوشه + "/salam_guide_static_fa"، گ)
    اگر وارونه پیوند.ok:
        سرچاپ "پیوند نخورد:"، پیوند.err
        برگشت ۱
    پایان
    سرچاپ "ساخته شد:"، پوشه + "/salam_guide_static_fa"
پایان
