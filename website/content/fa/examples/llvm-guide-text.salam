واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل

تابع ریشه:
    مسیر := سیستم عامل.پوشه موقت() + "/salam_guide_sum_fa.ll"
    _ := ورودی خروجی.نوشتن پرونده(مسیر، `define i32 @main() {
entry:
  br label %loop
loop:
  %i = phi i32 [ 1, %entry ], [ %next, %loop ]
  %acc = phi i32 [ 0, %entry ], [ %sum, %loop ]
  %sum = add i32 %acc, %i
  %next = add i32 %i, 1
  %more = icmp sle i32 %next, 10
  br i1 %more, label %loop, label %done
done:
  ret i32 %sum
}
`)
    تجزیه := ال ال وی ام.تجزیه آی آر(مسیر)
    اگر وارونه تجزیه.موفق:
        سرچاپ "خطای تجزیه:"، تجزیه.خطا
        برگشت ۱
    پایان
    نتیجه بررسی := ال ال وی ام.بررسی(تجزیه.ماژول)
    سرچاپ "درست است:"، نتیجه بررسی.معتبر
    ال ال وی ام.آزادسازی ماژول(تجزیه.ماژول)
    ال ال وی ام.آزادسازی زمینه(تجزیه.زمینه)
    ن := ال ال وی ام.اجرای جیت(مسیر)
    سرچاپ "جمع ۱ تا ۱۰ ="، ن.مقدار برگشتی
پایان
