واردسازی ال ال وی ام

تابع ریشه:
    ز := ال ال وی ام.زمینه جدید()
    م := ال ال وی ام.ماژول جدید(ز، "broken")
    س := ال ال وی ام.سازنده جدید(ز)
    ص۳۲ := ال ال وی ام.نوع سی‌ودو بیتی(ز)
    هیچ := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    تابعک := ال ال وی ام.افزودن تابعی(م، "answer"، ال ال وی ام.نوع تابعی(ص۳۲، هیچ، نادرست))
    ال ال وی ام.قرار دادن در انتها(س، ال ال وی ام.افزودن بلوک(ز، تابعک، "entry"))
    _ := ال ال وی ام.جمع(س، ال ال وی ام.ثابت صحیح(ص۳۲، ۴۰)، ال ال وی ام.ثابت صحیح(ص۳۲، ۲)، "x")
    نتیجه := ال ال وی ام.بررسی(م)
    اگر وارونه نتیجه.معتبر:
        سرچاپ "رد شد:"، نتیجه.خطا
    پایان
    ال ال وی ام.آزادسازی سازنده(س)
    ال ال وی ام.آزادسازی ماژول(م)
    ال ال وی ام.آزادسازی زمینه(ز)
پایان
