واردسازی ال ال وی ام.سه‌گانه هدف
واردسازی رشته

تابع ترتیب بایت(آرایش: رشته): رشته:
    اگر آرایش.طول() == ۰:
        برگشت "نامعلوم"
    پایان
    اگر رشته.شروع با(آرایش، "E"):
        برگشت "بزرگ‌پایان"
    پایان
    برگشت "کوچک‌پایان"
پایان

تابع ریشه:
    هدف‌ها := ["x86_64-pc-windows-msvc"، "aarch64-apple-darwin"، "riscv64-unknown-linux-gnu"، "armeb-unknown-linux-gnueabi"، "wasm32-unknown-wasi"، "aarch64-linux-android"]
    هر هدف در هدف‌ها:
        آرایش := سه‌گانه هدف.آرایش داده(هدف)
        سرچاپ هدف
        سرچاپ "  اشاره‌گر:"، سه‌گانه هدف.بیت‌های اشاره‌گر(هدف)، "بیتی،"، ترتیب بایت(آرایش)
        سرچاپ "  ویندوز:"، سه‌گانه هدف.ویندوز است(هدف)، "| glibc:"، سه‌گانه هدف.گلیبسی است(هدف)
        اگر آرایش.طول() == ۰:
            سرچاپ "  آرایش داده‌ی آماده ندارد؛ انتخاب با LLVM"
        پایان
    پایان
پایان
