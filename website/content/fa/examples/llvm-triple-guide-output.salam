واردسازی ال ال وی ام.سه‌گانه هدف
واردسازی رشته

تابع نام خروجی(نام: رشته، هدف: رشته): رشته:
    اگر سه‌گانه هدف.ویندوز است(هدف):
        برگشت نام + ".exe"
    پایان
    برگشت نام
پایان

تابع یادداشت کتابخانه(هدف: رشته): رشته:
    اگر سه‌گانه هدف.ویندوز است(هدف):
        برگشت "با کتابخانه‌ی C ویندوز پیوند می‌خورد"
    وگرنه سه‌گانه هدف.گلیبسی است(هدف):
        برگشت "روی ماشین مقصد glibc لازم دارد"
    وگرنه رشته.شامل است(هدف، "musl"):
        برگشت "می‌تواند کاملا ایستا باشد"
    پایان
    برگشت "از کتابخانه‌ی C سیستم استفاده می‌کند"
پایان

تابع ریشه:
    هر هدف در ["x86_64-unknown-linux-gnu"، "x86_64-linux-musl"، "x86_64-w64-windows-gnu"، "aarch64-apple-darwin"]:
        سرچاپ نام خروجی("app"، هدف)، "برای"، هدف
        سرچاپ "  " + یادداشت کتابخانه(هدف)
    پایان
پایان
