واردسازی گزارش

تابع خط ورود(کاربر: رشته، تلاش‌ها: صحیح۶۴، موفق: منطقی، عامل: رشته): رشته:
    ناپایا فیلدها := وکتور {} برگردان وکتور<رشته>
    دیرکن فیلدها.آزادکن()
    فیلدها.بیفزا(گزارش.فیلد("user"، کاربر))
    فیلدها.بیفزا(گزارش.فیلد عدد("attempts"، تلاش‌ها))
    فیلدها.بیفزا(گزارش.فیلد منطقی("ok"، موفق))
    فیلدها.بیفزا(گزارش.فیلد("agent"، عامل))
    برگشت گزارش.کلید مقدار("ورود"، فیلدها)
پایان

تابع ریشه:
    گزارش.به خروجی استاندارد()
    گزارش.نمایش زمان(نادرست)
    گزارش.اطلاعات(خط ورود("سارا"، ۱، درست، "curl/8.5"))
    گزارش.هشدار(خط ورود("کاربر مهمان"، ۳، نادرست، "my \"test\" bot"))
    سرچاپ گزارش.فیلد("empty"، "")
    سرچاپ گزارش.فیلد("path"، "/a b")
پایان
