واردسازی گزارش
واردسازی رشته

ساختار درخواست:
    همگانی روش: رشته = ""
    همگانی مسیر: رشته = ""
    همگانی وضعیت: صحیح = ۰
    همگانی زمان: صحیح = ۰
پایان

تابع ثبت درخواست(د: درخواست):
    ناپایا کلیدها := وکتور {} برگردان وکتور<رشته>
    ناپایا مقدارها := وکتور {} برگردان وکتور<رشته>
    دیرکن کلیدها.آزادکن()
    دیرکن مقدارها.آزادکن()
    کلیدها.بیفزا("method")
    مقدارها.بیفزا(د.روش)
    کلیدها.بیفزا("path")
    مقدارها.بیفزا(د.مسیر)
    کلیدها.بیفزا("status")
    مقدارها.بیفزا(رشته.از عدد(د.وضعیت برگردان صحیح۶۴))
    کلیدها.بیفزا("ms")
    مقدارها.بیفزا(رشته.از عدد(د.زمان برگردان صحیح۶۴))
    اگر د.وضعیت >= ۵۰۰:
        گزارش.خطا با فیلد("درخواست شکست خورد"، کلیدها، مقدارها)
    وگرنه د.وضعیت >= ۴۰۰:
        گزارش.هشدار با فیلد("درخواست رد شد"، کلیدها، مقدارها)
    وگرنه:
        گزارش.اطلاعات با فیلد("درخواست انجام شد"، کلیدها، مقدارها)
    پایان
پایان

تابع ریشه:
    گزارش.به خروجی استاندارد()
    گزارش.نمایش زمان(نادرست)
    گزارش.تنظیم قالب(گزارش.قالب جیسون)
    گزارش.تنظیم پیشوند("api")
    ثبت درخواست(درخواست { روش = "GET"، مسیر = "/products"، وضعیت = ۲۰۰، زمان = ۱۲ })
    ثبت درخواست(درخواست { روش = "POST"، مسیر = "/login"، وضعیت = ۴۰۱، زمان = ۳ })
    ثبت درخواست(درخواست { روش = "GET"، مسیر = "/report \"q3\""، وضعیت = ۵۰۳، زمان = ۹۵۰ })
پایان
