واردسازی گزارش
واردسازی پیکربندی

تابع راه اندازی(متن: رشته):
    ناپایا پ := پیکربندی.تجزیه محیط(متن)
    دیرکن پیکربندی.آزادسازی(پ)
    سطح := گزارش.تجزیه سطح(پیکربندی.دریافت با پیش فرض(پ، "LOG_LEVEL"، "info"))
    گزارش.تنظیم سطح(سطح)
    گزارش.تنظیم پیشوند(پیکربندی.دریافت با پیش فرض(پ، "APP_NAME"، "برنامه"))
    سرچاپ "-- سطح"، گزارش.نام سطح(گزارش.دریافت سطح())
پایان

تابع کار():
    گزارش.اشکال زدایی("جست‌وجوی حافظه‌ی نهان برای کلید user:7")
    گزارش.اطلاعات("سفارش ۱۰۴۲ پذیرفته شد")
    گزارش.هشدار("درگاه پرداخت دیر جواب داد")
    گزارش.خطا("رسید به ایمیل فرستاده نشد")
پایان

تابع ریشه:
    گزارش.به خروجی استاندارد()
    گزارش.نمایش زمان(نادرست)
    راه اندازی("LOG_LEVEL=debug\nAPP_NAME=فروشگاه\n")
    کار()
    راه اندازی("LOG_LEVEL=warning\nAPP_NAME=فروشگاه\n")
    کار()
    راه اندازی("LOG_LEVEL=loud\n")
    کار()
پایان
