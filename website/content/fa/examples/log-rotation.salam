واردسازی گزارش
واردسازی سیستم عامل
واردسازی ورودی خروجی
واردسازی رشته

تابع خط اول(مسیر: رشته): رشته:
    خط‌ها := ورودی خروجی.خواندن پرونده(مسیر).بشکاف("\n")
    دیرکن خط‌ها.آزادکن()
    برگشت خط‌ها.بگیر(۰)
پایان

تابع ریشه:
    پرونده‌ها := ["worker.log"، "worker.log.1"، "worker.log.2"، "worker.log.3"]
    هر پ در پرونده‌ها:
        سیستم عامل.حذف(پ)
    پایان
    گزارش.نمایش زمان(نادرست)
    اگر گزارش.به پرونده("worker.log") != ۰:
        سرچاپ "worker.log باز نشد"
        برگشت ۱
    پایان
    گزارش.تنظیم چرخش(۱۲۰، ۲)
    تکرار ۲۴ در ش:
        گزارش.اطلاعات("کار شماره‌ی " + رشته.از عدد(ش برگردان صحیح۶۴) + " انجام شد")
    پایان
    گزارش.بستن پرونده()
    هر پ در پرونده‌ها:
        اگر سیستم عامل.وجود دارد(پ):
            سرچاپ پ، "با این خط شروع می‌شود:"، خط اول(پ)
        وگرنه:
            سرچاپ پ، "وجود ندارد"
        پایان
    پایان
پایان
