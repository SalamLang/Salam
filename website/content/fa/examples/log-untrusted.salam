واردسازی گزارش

تابع جفت(الف: رشته، ب: رشته): وکتور<رشته>:
    ناپایا فهرست := وکتور {} برگردان وکتور<رشته>
    فهرست.بیفزا(الف)
    فهرست.بیفزا(ب)
    برگشت فهرست
پایان

تابع ریشه:
    گزارش.به خروجی استاندارد()
    گزارش.نمایش زمان(نادرست)
    نام := "مینا\n[ERROR] disk full"
    مقدارها := جفت(نام، "10.0.0.7")
    دیرکن مقدارها.آزادکن()
    گزارش.اطلاعات قالبی("کاربر {} از {} وارد شد"، مقدارها)
    کلیدها := جفت("user"، "ip")
    دیرکن کلیدها.آزادکن()
    گزارش.تنظیم قالب(گزارش.قالب جیسون)
    گزارش.اطلاعات با فیلد("کاربر وارد شد"، کلیدها، مقدارها)
    گزارش.تنظیم قالب(گزارش.قالب متن)
    گزارش.تنظیم سطح(گزارش.سطح خطا + ۱)
    گزارش.خطا("این را کسی نمی‌بیند")
    گزارش.تنظیم سطح(گزارش.سطح اطلاعات)
    گزارش.اطلاعات("گزارش دوباره روشن شد")
پایان
