تابع ریشه:
    نام‌ها := ["سارا"، "رضا"]
    هر ش، نام در نام‌ها:
        سرچاپ ش، نام
    پایان
    ناپایا نمره‌ها := وکتور {} برگردان وکتور<صحیح>
    نمره‌ها.بیفزا(18)
    نمره‌ها.بیفزا(20)
    ناپایا جمع := 0
    هر نمره در نمره‌ها:
        جمع += نمره
    پایان
    سرچاپ "جمع:"، جمع
    ناپایا سن‌ها := نگاشت {} برگردان نگاشت<رشته، صحیح>
    سن‌ها.درج("سارا"، 30)
    هر نام، سن در سن‌ها:
        سرچاپ نام، سن
    پایان
    هر ش، ح در "سلام":
        سرچاپ ش، ح
    پایان
    ناپایا سطر := ""
    هر ب در "Hi!".بایت ها():
        سطر = سطر + (ب برگردان صحیح) + " "
    پایان
    سرچاپ سطر
پایان
