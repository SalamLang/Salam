تابع ریشه:
    ناپایا انبار := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن انبار.آزادکن()
    انبار.درج("خودکار"، ۱۲)
    انبار.درج("جوهر"، ۰)
    انبار.درج("کاغذ"، ۲۵۰)
    انبار.درج("گیره"، ۳)
    ناپایا کل := ۰
    ناپایا کم := ۰
    هر _، تعداد در انبار:
        کل += تعداد
        اگر تعداد < ۵:
            کم += ۱
        پایان
    پایان
    سرچاپ "کل موجودی:"، کل
    سرچاپ "کالاهای نیازمند سفارش:"، کم
    ناپایا بهاها := [۱۰۰، ۲۵۰، ۴۰]
    هر ش، بها در بهاها:
        بهاها[ش] = بها + بها / ۱۰
    پایان
    سرچاپ بهاها
پایان
