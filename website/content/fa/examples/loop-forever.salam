روال ریشه:
    کل := ۲۳
    اندازه صفحه := ۱۰
    ناپایا صفحه := ۱
    تا درست:
        نخست := (صفحه - ۱) * اندازه صفحه + ۱
        ناپایا واپسین := صفحه * اندازه صفحه
        اگر واپسین > کل:
            واپسین = کل
        پایان
        سرچاپ "صفحه"، صفحه، "مورد"، نخست، "تا"، واپسین
        اگر واپسین == کل:
            بشکن
        پایان
        صفحه += ۱
    پایان
پایان
