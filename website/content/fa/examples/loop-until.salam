روال جمع رقم‌ها(عدد: صحیح): صحیح:
    ناپایا ن := عدد
    ناپایا جمع := ۰
    تا ن != ۰:
        جمع += ن % ۱۰
        ن = ن / ۱۰
    پایان
    برگشت جمع
پایان

روال ریشه:
    سرچاپ جمع رقم‌ها(۱۴۰۵)، جمع رقم‌ها(۰)
    ناپایا پس‌انداز := ۱۰۰۰.۰
    ناپایا سال‌ها := ۰
    تا پس‌انداز < ۲۰۰۰.۰:
        پس‌انداز = پس‌انداز * ۱.۰۸
        سال‌ها += ۱
    پایان
    سرچاپ "دو برابر شد پس از"، سال‌ها، "سال"
پایان
