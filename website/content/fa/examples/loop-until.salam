تابع جمع رقم‌ها(عدد: صحیح): صحیح:
    ناپایا ن := عدد
    ناپایا جمع := ۰
    تا ن != ۰:
        جمع += ن % ۱۰
        ن /= ۱۰
    پایان
    برگشت جمع
پایان

تابع ریشه:
    سرچاپ جمع رقم‌ها(۱۴۰۵)، جمع رقم‌ها(۰)
    ناپایا پس‌انداز := ۱۰۰۰.۰
    ناپایا سال‌ها := ۰
    تا پس‌انداز < ۲۰۰۰.۰:
        پس‌انداز *= ۱.۰۸
        سال‌ها++
    پایان
    سرچاپ "دو برابر شد پس از"، سال‌ها، "سال"
پایان
