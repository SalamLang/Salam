تابع ریشه:
    فرمان‌ها := ["آغاز"، "وضعیت"، "توقف"، "پرش"، "خروج"]
    ناپایا روشن := نادرست
    هر فرمان در فرمان‌ها:
        همخوان فرمان:
            "آغاز"، "اجرا":
                روشن = درست
                سرچاپ "در حال آغاز"
            پایان
            "توقف":
                روشن = نادرست
                سرچاپ "در حال توقف"
            پایان
            "وضعیت":
                سرچاپ روشن ? "روشن" : "خاموش"
            پایان
            "خروج": سرچاپ "خدانگهدار" پایان
            وگرنه: سرچاپ "فرمان ناشناخته:"، فرمان پایان
        پایان
    پایان
پایان
