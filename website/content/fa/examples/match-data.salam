جداشمار پرداخت:
    نقد(مبلغ: صحیح)
    کارت(مبلغ: صحیح، چهاررقم: رشته)
    بن(کد: رشته)
    رایگان
پایان

تابع رسید(پ: پرداخت): رشته:
    برگشت همخوان پ:
        نقد(م) اگر م >= ۱۰۰۰: "نقد " + م + "، دوباره بشمارید" پایان
        نقد(م): "نقد " + م پایان
        کارت(م، چهاررقم): "کارت با پایان " + چهاررقم + "، " + م پایان
        بن(_): "پرداخت با بن خرید" پایان
        رایگان: "پرداختی لازم نیست" پایان
    پایان
پایان

تابع ریشه:
    سرچاپ رسید(پرداخت.نقد(۱۵۰۰))
    سرچاپ رسید(پرداخت.نقد(۲۰))
    سرچاپ رسید(پرداخت.کارت(۸۰، "4421"))
    سرچاپ رسید(پرداخت.بن("BAHAR"))
    سرچاپ رسید(پرداخت.رایگان)
    پ := پرداخت.کارت(۳۵، "0042")
    برچسب := همخوان پ:
        کارت ک: "پرداخت کارتی به مبلغ " + ک.مبلغ پایان
        وگرنه: "نوع دیگری از پرداخت" پایان
    پایان
    سرچاپ برچسب
پایان
