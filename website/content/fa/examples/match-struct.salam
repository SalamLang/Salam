ساختار نقطه:
    همگانی ایکس: صحیح = ۰
    همگانی ایگرگ: صحیح = ۰
پایان

روال جای(ن: نقطه): رشته:
    برگشت همخوان ن:
        نقطه { ایکس = ۰، ایگرگ = ۰ } => "مبدأ"
        نقطه { ایکس = ۰، ایگرگ } => "روی محور عمودی، ایگرگ = " + ایگرگ
        نقطه { ایکس، ایگرگ = ۰ } => "روی محور افقی، ایکس = " + ایکس
        وگرنه => "جای دیگر"
    پایان
پایان

روال ریشه:
    سرچاپ جای(نقطه {})
    سرچاپ جای(نقطه { ایگرگ = ۵ })
    سرچاپ جای(نقطه { ایکس = ۳ })
    سرچاپ جای(نقطه { ایکس = ۱، ایگرگ = ۲ })
پایان
