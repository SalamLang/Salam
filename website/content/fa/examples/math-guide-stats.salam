واردسازی ریاضی
واردسازی قالب بندی

تابع ریشه:
    نمره‌ها := [۷۲.۰، ۸۵.۵، ۹۰.۰، ۶۴.۵، ۸۸.۰]
    ناپایا مجموع := ۰.۰
    ناپایا کمترین := نمره‌ها[۰]
    ناپایا بیشترین := نمره‌ها[۰]
    هر ن در نمره‌ها:
        مجموع += ن
        کمترین = ریاضی.کمینه(کمترین، ن)
        بیشترین = ریاضی.بیشینه(بیشترین، ن)
    پایان
    میانگین := مجموع / ۵.۰
    ناپایا مربع‌ها := ۰.۰
    هر ن در نمره‌ها:
        مربع‌ها += ریاضی.توان(ن - میانگین، ۲.۰)
    پایان
    انحراف := ریاضی.جذر(مربع‌ها / ۵.۰)
    سرچاپ "میانگین:"، میانگین
    سرچاپ "کمترین:"، کمترین، "بیشترین:"، بیشترین
    سرچاپ "انحراف معیار:"، قالب بندی.عدد اعشار با دقت(انحراف، ۲)
    هر ن در نمره‌ها:
        ز := (ن - میانگین) / انحراف
        سرچاپ ن، "به اندازه‌ی"، قالب بندی.عدد اعشار با دقت(ریاضی.قدرمطلق(ز)، ۲)، "انحراف معیار"، ز کوچکتر ۰.۰ ? "پایین‌تر است" : "بالاتر است"
    پایان
پایان
