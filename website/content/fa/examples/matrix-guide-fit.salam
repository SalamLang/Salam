واردسازی ماتریس

تابع بساز(سطرها: صحیح، ستون‌ها: صحیح، عددها: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در عددها.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع گرد(مقدار: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، مقدار)، ۲)
پایان

تابع ریشه:
    ناپایا متراژ := بساز(۵، ۱، "50 70 90 110 130")
    ناپایا اجاره := بساز(۵، ۱، "520 690 910 1080 1300")
    ناپایا خط := ماتریس.رگرسیون خطی(متراژ، اجاره)
    سرچاپ "اجاره ="، گرد(خط.عنصر(۰، ۰))، "+"، گرد(خط.عنصر(۱، ۰))، "* متراژ"
    ناپایا طرح := ماتریس.واندرموند(متراژ، ۲)
    ناپایا برازش := ماتریس.ضرب ماتریسی(طرح، خط)
    سرچاپ "ضریب تعیین"، ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، ماتریس.آر دو(اجاره، برازش))، ۴)
    سرچاپ "۱۰۰ متر مربع:"، گرد(خط.عنصر(۰، ۰) + خط.عنصر(۱، ۰) * ۱۰۰.۰)

    ناپایا سرعت := بساز(۶، ۱، "40 60 80 100 120 140")
    ناپایا مصرف := بساز(۶، ۱، "7.1 6.0 5.8 6.4 7.5 9.1")
    ناپایا منحنی := ماتریس.کمترین مربعات(ماتریس.واندرموند(سرعت، ۳)، مصرف)
    الف := منحنی.عنصر(۰، ۰)
    ب := منحنی.عنصر(۱، ۰)
    ج := منحنی.عنصر(۲، ۰)
    بهترین := ۰.۰ - ب / (۲.۰ * ج)
    سرچاپ "کم‌مصرف‌ترین سرعت"، گرد(بهترین)، "با مصرف"، گرد(الف + ب * بهترین + ج * بهترین * بهترین)
    خط.آزادسازی()
    طرح.آزادسازی()
    برازش.آزادسازی()
    منحنی.آزادسازی()
پایان
