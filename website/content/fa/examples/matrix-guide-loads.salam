واردسازی ماتریس

تابع بساز(سطرها: صحیح، ستون‌ها: صحیح، عددها: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در عددها.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع ریشه:
    ناپایا فنرها := بساز(۳، ۳، "20 -10 0 -10 20 -10 0 -10 10")
    ناپایا تج := ماتریس.تجزیه(فنرها)
    اگر تج.تکین:
        سرچاپ "دستگاه جواب یکتا ندارد"
        برگشت ۱
    پایان
    بارها := ["0 0 5"، "5 0 0"، "1 1 1"]
    هر بار در بارها:
        ناپایا نیرو := بساز(۳، ۱، بار)
        ناپایا جابه‌جایی := ماتریس.حل با تجزیه(تج، نیرو)
        سرچاپ "بار"، بار، "->"، ماتریس.به رشته با دقت(ماتریس.ترانهاده(جابه‌جایی)، ۲)
        نیرو.آزادسازی()
        جابه‌جایی.آزادسازی()
    پایان
    سرچاپ "دترمینان"، ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، ماتریس.دترمینان(فنرها))، ۱)
    تج.آزادسازی()
    فنرها.آزادسازی()
پایان
