واردسازی ماتریس

تابع بساز(سطرها: صحیح، ستون‌ها: صحیح، عددها: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در عددها.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع ریشه:
    ناپایا هوا := بساز(۳، ۳، "0.7 0.2 0.1 0.3 0.4 0.3 0.2 0.3 0.5")
    سرچاپ "جمع هر سطر یک است:"، ماتریس.تصادفی سطری است(هوا، ۰.۰۰۰۰۰۱)
    ناپایا امروز := بساز(۱، ۳، "1 0 0")
    هر روزها در [۱، ۲، ۷، ۳۰]:
        ناپایا آینده := ماتریس.ضرب ماتریسی(امروز، ماتریس.توان ماتریس(هوا، روزها))
        سرچاپ "پس از"، روزها، "روز"، ماتریس.به رشته با دقت(آینده، ۳)
        آینده.آزادسازی()
    پایان
    ناپایا بارانی := بساز(۱، ۳، "0 0 1")
    ناپایا بعدها := ماتریس.ضرب ماتریسی(بارانی، ماتریس.توان ماتریس(هوا، ۳۰))
    سرچاپ "از یک روز بارانی"، ماتریس.به رشته با دقت(بعدها، ۳)
    هوا.آزادسازی()
    امروز.آزادسازی()
    بارانی.آزادسازی()
    بعدها.آزادسازی()
پایان
