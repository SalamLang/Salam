واردسازی ماتریس

تابع بساز(سطرها: صحیح، ستون‌ها: صحیح، عددها: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در عددها.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع ریشه:
    ناپایا دوبرابر := بساز(۲، ۲، "1 2 2 4")
    ناپایا راست := بساز(۲، ۱، "3 6")
    سرچاپ "تکین"، ماتریس.تکین است(دوبرابر)، "رتبه"، ماتریس.رتبه دقیق(دوبرابر)
    سرچاپ "حل می‌دهد"، ماتریس.رشته شکل(ماتریس.حل(دوبرابر، راست))
    سرچاپ "سازگار"، ماتریس.سازگار است(دوبرابر، راست)
    سرچاپ "یک جواب"، ماتریس.به رشته با دقت(ماتریس.ترانهاده(ماتریس.حل عمومی(دوبرابر، راست))، ۲)

    ناپایا ه := ماتریس.هیلبرت(۸)
    سرچاپ "هیلبرت(۸) بدحالت است:"، ماتریس.شرط دو(ه) بزرگتر ۱۰۰۰۰۰۰۰۰۰.۰
    ناپایا یک‌ها := ماتریس.یک‌ها(۸، ۱)
    ناپایا حاصل := ماتریس.ضرب ماتریسی(ه، یک‌ها)
    ناپایا برگشتی := ماتریس.حل(ه، حاصل)
    سرچاپ "برابر دقیق"، ماتریس.همه نزدیک(برگشتی، یک‌ها، ۰.۰)، "نزدیک"، ماتریس.همه نزدیک(برگشتی، یک‌ها، ۰.۰۰۰۱)

    ناپایا دهم := بساز(۱، ۲، "0.1 0.2")
    ناپایا سه‌برابر := ماتریس.مقیاس(دهم، ۳.۰)
    ناپایا انتظار := بساز(۱، ۲، "0.3 0.6")
    سرچاپ "۰.۱ * ۳ دقیقاً ۰.۳:"، ماتریس.همه نزدیک(سه‌برابر، انتظار، ۰.۰)، "در حد رواداری:"، ماتریس.همه نزدیک(سه‌برابر، انتظار، ماتریس.رواداری ماتریس)
پایان
