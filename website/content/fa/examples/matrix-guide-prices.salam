واردسازی ماتریس

تابع بساز(سطرها: صحیح، ستون‌ها: صحیح، عددها: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در عددها.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع ریشه:
    ناپایا سبدها := بساز(۳، ۳، "2 1 1 1 3 2 1 0 4")
    ناپایا جمع‌ها := بساز(۳، ۱، "9.5 17 17.5")
    ناپایا قیمت‌ها := ماتریس.حل(سبدها، جمع‌ها)
    اگر قیمت‌ها.تهی است():
        سرچاپ "سبدها قیمت‌ها را مشخص نمی‌کنند"
        برگشت ۱
    پایان
    نام‌ها := ["سیب"، "نان"، "پنیر"]
    هر ی، نام در نام‌ها:
        سرچاپ نام، ماتریس.به رشته با دقت(ماتریس.سطر(قیمت‌ها، ی)، ۲)
    پایان
    ناپایا وارسی := ماتریس.باقیمانده(سبدها، قیمت‌ها، جمع‌ها)
    سرچاپ "بزرگ‌ترین خطا ناچیز است:"، ماتریس.بیشینه قدرمطلق(وارسی) کوچکتر ۰.۰۰۰۰۰۱
    ناپایا سفارش := بساز(۱، ۳، "4 2 1")
    سرچاپ "۴ سیب، ۲ نان، ۱ پنیر:"، ماتریس.به رشته با دقت(ماتریس.ضرب ماتریسی(سفارش، قیمت‌ها)، ۲)
    قیمت‌ها.آزادسازی()
    وارسی.آزادسازی()
پایان
