واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.با مهلت(میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")، 5000)
    اگر وارونه میلیسرچ.سالم است(کارخواه):
        سرچاپ "میلی‌سرچ اجرا نیست در " + کارخواه.میزبان
        برگشت 1
    پایان
    ناپایا اشکال := میلیسرچ.خطا {}
    نسخه := میلیسرچ.دریافت نسخه(کارخواه، اشکال)
    سرچاپ "وصل شد به میلی‌سرچ " + نسخه.شماره نسخه

    میلیسرچ.دریافت نمایه(کارخواه، "no_such_index"، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
    پایان
    برگشت 0
پایان
