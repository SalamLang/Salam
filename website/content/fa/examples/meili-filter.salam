واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    تنظیمات := `{"filterableAttributes": ["ژانر", "سال"], "sortableAttributes": ["سال"]}`
    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی تنظیمات(کارخواه، "movies"، تنظیمات، اشکال)، اشکال)

    ناپایا جستار := میلیسرچ.درخواست جستجو { فیلتر = "ژانر = خانوادگی AND سال > 2010" }
    جستار.مرتب‌سازی.بیفزا("سال:desc")
    جستار.وجه‌ها.بیفزا("ژانر")
    جستار.ویژگی‌های بازیابی.بیفزا("عنوان")
    جستار.ویژگی‌های بازیابی.بیفزا("سال")
    نتیجه := میلیسرچ.جستجو(کارخواه، "movies"، جستار، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
        برگشت 1
    پایان
    هر یافته در نتیجه.نتایج:
        سرچاپ یافته
    پایان

    همه := میلیسرچ.جستجو(کارخواه، "movies"، میلیسرچ.درخواست جستجو { وجه‌ها = جستار.وجه‌ها، حد = 0 }، اشکال)
    سرچاپ "ژانرها: " + همه.توزیع وجه
    برگشت 0
پایان
