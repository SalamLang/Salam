واردسازی دیتابیس.میلیسرچ
واردسازی کدگذاری.جیسون

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    ناپایا جستار := میلیسرچ.درخواست جستجو { پرسش = "خدمه"، نتایج صفحه = 1، شماره صفحه = 1 }
    جستار.ویژگی‌های برجسته.بیفزا("خلاصه")
    جستار.برچسب پیش از برجسته = "["
    جستار.برچسب پس از برجسته = "]"
    جستار.ویژگی‌های برش.بیفزا("خلاصه")
    جستار.طول برش = 6
    نتیجه := میلیسرچ.جستجو(کارخواه، "movies"، جستار، اشکال)
    سرچاپ "صفحه " + نتیجه.شماره صفحه + " از " + نتیجه.کل صفحه‌ها + "، " + نتیجه.کل نتایج + " نتیجه"
    هر یافته در نتیجه.نتایج:
        قالب‌بندی‌شده := جیسون.دریافت(یافته، "_formatted")
        سرچاپ جیسون.دریافت(یافته، "عنوان") + ": " + جیسون.دریافت(قالب‌بندی‌شده، "خلاصه")
    پایان
    برگشت 0
پایان
