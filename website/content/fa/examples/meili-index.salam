واردسازی دیتابیس.میلیسرچ

ساختار فیلم:
    همگانی شناسه: صحیح = 0
    همگانی عنوان: رشته = ""
    همگانی ژانر: رشته = ""
    همگانی سال: صحیح = 0
    همگانی خلاصه: رشته = ""
پایان

تابع اثر(شناسه: صحیح، عنوان: رشته، ژانر: رشته، سال: صحیح، خلاصه: رشته): فیلم:
    برگشت فیلم { شناسه = شناسه، عنوان = عنوان، ژانر = ژانر، سال = سال، خلاصه = خلاصه }
پایان

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    میلیسرچ.انتظار(کارخواه، میلیسرچ.ایجاد نمایه(کارخواه، "movies"، "شناسه"، اشکال)، اشکال)

    ناپایا فیلم‌ها := وکتور {} برگردان وکتور<فیلم>
    فیلم‌ها.بیفزا(اثر(1، "مخمصه"، "جنایی"، 1995، "یک کارآگاه در لس‌آنجلس دنبال خدمه‌ای از دزدان حرفه‌ای است."))
    فیلم‌ها.بیفزا(اثر(2، "موانا"، "خانوادگی"، 2016، "دختری برای نجات جزیره‌اش از اقیانوس می‌گذرد."))
    فیلم‌ها.بیفزا(اثر(3، "بیگانه"، "ترسناک"، 1979، "خدمه یک کشتی باری فضایی با موجودی مرگبار روبه‌رو می‌شوند."))
    فیلم‌ها.بیفزا(اثر(4، "بالا"، "خانوادگی"، 2009، "پیرمردی خانه‌اش را با هزاران بادکنک به پرواز درمی‌آورد."))
    فیلم‌ها.بیفزا(اثر(5، "ورود"، "درام"، 2016، "یک زبان‌شناس یاد می‌گیرد با مهمانانی از جهانی دیگر حرف بزند."))
    فیلم‌ها.بیفزا(اثر(6، "تلماسه"، "ماجرایی"، 2021، "یک اشراف‌زاده جوان برای سیاره‌ای بیابانی می‌جنگد."))
    فیلم‌ها.بیفزا(اثر(7، "میان‌ستاره‌ای"، "درام"، 2014، "کاوشگران از یک کرم‌چاله می‌گذرند تا خانه‌ای تازه پیدا کنند."))
    فیلم‌ها.بیفزا(اثر(8، "کوکو"، "خانوادگی"، 2017، "پسری برای یافتن خانواده‌اش به سرزمین مردگان می‌رود."))

    کار := میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندهای نوع(کارخواه، "movies"، فیلم‌ها، "شناسه"، اشکال)، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
        برگشت 1
    پایان
    سرچاپ "نمایه‌سازی: " + کار.وضعیت
    آمار := میلیسرچ.دریافت آمار نمایه(کارخواه، "movies"، اشکال)
    سرچاپ "سندهای movies: " + آمار.تعداد سندها
    برگشت 0
پایان
