واردسازی دیتابیس.میلیسرچ
واردسازی زمان

تابع ریشه:
    مدیر := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    ناپایا مسیرها := میلیسرچ.درخواست کلید { نام = "ویترین فروشگاه"، توضیح = "فقط جستجو در نمایه movies" }
    مسیرها.کنش‌ها.بیفزا("search")
    مسیرها.نمایه‌های مجاز.بیفزا("movies")
    کلید := میلیسرچ.ایجاد کلید(مدیر، مسیرها، اشکال)
    سرچاپ "کلید تازه " + کلید.نام + " می‌تواند: " + کلید.کنش‌ها.بگیر(0)

    قاعده‌ها := `{"movies": {"filter": "ژانر = خانوادگی"}}`
    توکن := میلیسرچ.توکن مستاجر(کلید.شناسه یکتا، کلید.کلید، قاعده‌ها، زمان.اکنون() + 3600، اشکال)
    کودکان := میلیسرچ.جدید("http://127.0.0.1:7700"، توکن)
    نتیجه := میلیسرچ.پرسش(کودکان، "movies"، ""، اشکال)
    سرچاپ "توکن می‌بیند: " + نتیجه.تخمین کل نتایج + " فیلم خانوادگی"

    میلیسرچ.پرسش(کودکان، "books"، ""، اشکال)
    سرچاپ "books با توکن: " + اشکال.کد

    سرچاپ "کلید حذف شد: " + میلیسرچ.حذف کلید(مدیر، کلید.شناسه یکتا، اشکال)
    برگشت 0
پایان
