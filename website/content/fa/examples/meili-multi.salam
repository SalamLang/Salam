واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندها(کارخواه، "books"، `[{"شناسه": 1, "عنوان": "تلماسه", "نویسنده": "فرانک هربرت"}, {"شناسه": 2, "عنوان": "کوکو و ماه", "نویسنده": "یک نویسنده"}]`، "شناسه"، اشکال)، اشکال)

    ناپایا پرسش‌ها := وکتور {} برگردان وکتور<میلیسرچ.پرسش چندگانه>
    پرسش‌ها.بیفزا(میلیسرچ.پرسش چندگانه { نمایه = "movies"، درخواست = میلیسرچ.درخواست جستجو { پرسش = "تلماسه" } })
    پرسش‌ها.بیفزا(میلیسرچ.پرسش چندگانه { نمایه = "books"، درخواست = میلیسرچ.درخواست جستجو { پرسش = "تلماسه" } })
    هر مسیرها در میلیسرچ.جستجوی چندگانه(کارخواه، پرسش‌ها، اشکال):
        سرچاپ مسیرها.نمایه + ": " + مسیرها.نتایج.طول() + " نتیجه"
    پایان

    ادغام‌شده := میلیسرچ.جستجوی فدرال(کارخواه، پرسش‌ها، میلیسرچ.فدراسیون { حد = 5 }، اشکال)
    سرچاپ "فدرال: " + ادغام‌شده.نتایج.طول() + " نتیجه در یک فهرست"

    ژانرها := میلیسرچ.جستجوی وجه(کارخواه، "movies"، میلیسرچ.درخواست جستجوی وجه { نام وجه = "ژانر"، پرسش وجه = "خان" }، اشکال)
    هر ژانری در ژانرها.نتایج:
        سرچاپ "ژانر " + ژانری.مقدار + ": " + ژانری.شمار
    پایان
    برگشت 0
پایان
