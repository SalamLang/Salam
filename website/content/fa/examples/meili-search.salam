واردسازی دیتابیس.میلیسرچ

ساختار فیلم:
    همگانی شناسه: صحیح = 0
    همگانی عنوان: رشته = ""
    همگانی سال: صحیح = 0
پایان

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    نتیجه := میلیسرچ.پرسش(کارخواه، "movies"، "فظایی"، اشکال)
    سرچاپ "نتیجه‌ها برای \"" + نتیجه.پرسش + "\": " + نتیجه.تخمین کل نتایج
    ناپایا فیلم‌ها := وکتور {} برگردان وکتور<فیلم>
    اگر میلیسرچ.نتایج به نوع(نتیجه، فیلم‌ها، اشکال):
        هر نمونه در فیلم‌ها:
            سرچاپ "  " + نمونه.عنوان + " (" + نمونه.سال + ")"
        پایان
    پایان
    برگشت 0
پایان
