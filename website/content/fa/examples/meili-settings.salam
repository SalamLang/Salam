واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی مترادف‌ها(کارخواه، "movies"، `{"کارتون": ["دختری", "پسری"], "فضا": ["سیاره", "کرم‌چاله"]}`، اشکال)، اشکال)
    ناپایا کلمات توقف := وکتور {} برگردان وکتور<رشته>
    کلمات توقف.بیفزا("یک")
    کلمات توقف.بیفزا("از")
    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی کلمات توقف(کارخواه، "movies"، کلمات توقف، اشکال)، اشکال)
    ناپایا قابل جستجو := وکتور {} برگردان وکتور<رشته>
    قابل جستجو.بیفزا("عنوان")
    قابل جستجو.بیفزا("خلاصه")
    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی ویژگی‌های قابل جستجو(کارخواه، "movies"، قابل جستجو، اشکال)، اشکال)

    نتیجه := میلیسرچ.پرسش(کارخواه، "movies"، "کارتون"، اشکال)
    سرچاپ "نتیجه‌ها برای \"کارتون\"، مترادف دختری و پسری: " + نتیجه.تخمین کل نتایج
    نتیجه فضا := میلیسرچ.پرسش(کارخواه، "movies"، "فضا"، اشکال)
    سرچاپ "نتیجه‌ها برای \"فضا\": " + نتیجه فضا.تخمین کل نتایج
    سرچاپ "قابل جستجو: " + میلیسرچ.دریافت تنظیم(کارخواه، "movies"، "searchable-attributes"، اشکال)
    برگشت 0
پایان
