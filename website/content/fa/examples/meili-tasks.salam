واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    رسید := میلیسرچ.افزودن سندها(کارخواه، "movies"، `[{"عنوان": "بدون شناسه"}]`، ""، اشکال)
    سرچاپ "کار در صف " + رسید.شناسه کار + ": " + رسید.وضعیت
    کار := میلیسرچ.انتظار برای کار(کارخواه، رسید.شناسه کار، 10000، 50، اشکال)
    سرچاپ "پایان با وضعیت " + کار.وضعیت
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ "چرا: " + اشکال.کد
    پایان

    ناپایا پرسش := میلیسرچ.پرسش کار { حد = 3 }
    پرسش.نمایه‌ها.بیفزا("movies")
    پرسش.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت موفق)
    صفحه := میلیسرچ.دریافت کارها(کارخواه، پرسش، اشکال)
    سرچاپ "کارهای موفق اخیر روی movies:"
    هر رسیدی در صفحه.نتیجه‌ها:
        سرچاپ "  " + رسیدی.نوع
    پایان
    برگشت 0
پایان
