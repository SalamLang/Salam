واردسازی دیتابیس.میلیسرچ

ساختار فیلم:
    همگانی شناسه: صحیح = 0
    همگانی عنوان: رشته = ""
    همگانی سال: صحیح = 0
پایان

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی سندها(کارخواه، "movies"، `[{"شناسه": 6, "عنوان": "تلماسه: بخش یک"}]`، ""، اشکال)، اشکال)
    ناپایا تلماسه := فیلم {}
    اگر میلیسرچ.دریافت سند به نوع(کارخواه، "movies"، "6"، تلماسه، اشکال):
        سرچاپ "نام تازه: " + تلماسه.عنوان + " (" + تلماسه.سال + ")"
    پایان

    میلیسرچ.انتظار(کارخواه، میلیسرچ.حذف سند(کارخواه، "movies"، "3"، اشکال)، اشکال)
    میلیسرچ.دریافت سند(کارخواه، "movies"، "3"، وکتور {} برگردان وکتور<رشته>، اشکال)
    سرچاپ "پس از حذف: " + اشکال.کد

    حذف‌شده := میلیسرچ.انتظار(کارخواه، میلیسرچ.حذف سندها با فیلتر(کارخواه، "movies"، "سال < 2000"، اشکال)، اشکال)
    سرچاپ "حذف با فیلتر: " + حذف‌شده.وضعیت + " " + حذف‌شده.جزئیات
    سرچاپ "مانده: " + میلیسرچ.دریافت آمار نمایه(کارخواه، "movies"، اشکال).تعداد سندها
    برگشت 0
پایان
