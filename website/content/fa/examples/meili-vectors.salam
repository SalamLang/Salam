واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    میلیسرچ.انتظار(کارخواه، میلیسرچ.ایجاد نمایه(کارخواه، "movies_ai"، "شناسه"، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی جاسازها(کارخواه، "movies_ai"، `{"manual": {"source": "userProvided", "dimensions": 3}}`، اشکال)، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
        برگشت 1
    پایان
    سندها := `[
        {"شناسه": 2, "عنوان": "موانا", "_vectors": {"manual": [0.9, 0.1, 0.0]}},
        {"شناسه": 4, "عنوان": "بالا", "_vectors": {"manual": [0.8, 0.2, 0.1]}},
        {"شناسه": 5, "عنوان": "ورود", "_vectors": {"manual": [0.1, 0.9, 0.3]}},
        {"شناسه": 6, "عنوان": "تلماسه", "_vectors": {"manual": [0.2, 0.8, 0.4]}},
        {"شناسه": 7, "عنوان": "میان‌ستاره‌ای", "_vectors": {"manual": [0.1, 0.8, 0.5]}},
        {"شناسه": 8, "عنوان": "کوکو", "_vectors": {"manual": [0.9, 0.0, 0.1]}}
    ]`
    کار := میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندها(کارخواه، "movies_ai"، سندها، ""، اشکال)، اشکال)
    سرچاپ "بردارها ذخیره شد: " + کار.وضعیت

    ناپایا جستار := میلیسرچ.درخواست جستجو { جاساز ترکیبی = "manual"، نسبت معنایی = 1.0، حد = 2 }
    جستار.بردار.بیفزا(0.15)
    جستار.بردار.بیفزا(0.85)
    جستار.بردار.بیفزا(0.4)
    جستار.ویژگی‌های بازیابی.بیفزا("عنوان")
    نتیجه := میلیسرچ.جستجو(کارخواه، "movies_ai"، جستار، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
        برگشت 1
    پایان
    هر یافته در نتیجه.نتایج:
        سرچاپ "نزدیک به پرسش: " + یافته
    پایان

    ناپایا شبیه := میلیسرچ.درخواست مشابه { شناسه = "2"، جاساز = "manual"، حد = 2 }
    شبیه.ویژگی‌های بازیابی.بیفزا("عنوان")
    هر یافته در میلیسرچ.سندهای مشابه(کارخواه، "movies_ai"، شبیه، اشکال).نتایج:
        سرچاپ "شبیه موانا: " + یافته
    پایان
    برگشت 0
پایان
