روال صفر کن اولی(نمره‌ها: صحیح[۳]):
    نمره‌ها[۰] = ۰
پایان

روال صفر کن اولی درجا(نمره‌ها: صحیح[]):
    نمره‌ها[۰] = ۰
پایان

روال ریشه:
    هفته := [۷، ۵، ۹]
    ناپایا برنامه := هفته
    برنامه[۱] = ۱۰۰
    سرچاپ هفته، برنامه
    صفر کن اولی(هفته)
    سرچاپ هفته
    ناپایا زنده := [۷، ۵، ۹]
    صفر کن اولی درجا(زنده)
    سرچاپ زنده
پایان
