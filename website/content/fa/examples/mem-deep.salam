تابع آزادکن جدول(ج: وکتور<وکتور<صحیح>>):
    هر ردیف در ج:
        ردیف.آزادکن()
    پایان
    ج.آزادکن()
پایان

تابع ریشه:
    صندلی‌ها := وکتور {} برگردان وکتور<وکتور<صحیح>>
    تکرار ۲ در ر:
        ردیف := وکتور {} برگردان وکتور<صحیح>
        تکرار ۳ در س:
            ردیف.بیفزا(ر * ۳ + س + ۱)
        پایان
        صندلی‌ها.بیفزا(ردیف)
    پایان
    سطحی := صندلی‌ها.رونوشت()
    عمیق := صندلی‌ها.رونوشت عمیق()
    صندلی‌ها.بگیر(۰).بنشان(۰، ۰)
    سرچاپ صندلی‌ها
    سرچاپ سطحی
    سرچاپ عمیق
    سطحی.آزادکن()
    آزادکن جدول(عمیق)
    آزادکن جدول(صندلی‌ها)
پایان
