ساختار دانش‌آموز:
    همگانی نام: رشته = ""
    همگانی کلاس: رشته = ""
پایان

روال گروه بندی(همه: وکتور<دانش‌آموز>): نگاشت<رشته، وکتور<رشته>>:
    گروه‌ها := نگاشت {} برگردان نگاشت<رشته، وکتور<رشته>>
    هر د در همه:
        نام‌ها := گروه‌ها.دارد(د.کلاس) ? گروه‌ها.بگیر(د.کلاس) : وکتور {} برگردان وکتور<رشته>
        نام‌ها.بیفزا(د.نام)
        گروه‌ها.درج(د.کلاس، نام‌ها)
    پایان
    برگشت گروه‌ها
پایان

روال ریشه:
    شاگردان := وکتور {} برگردان وکتور<دانش‌آموز>
    دیرکن شاگردان.آزادکن()
    شاگردان.بیفزا(دانش‌آموز { نام = "سارا"، کلاس = "هفتم الف" })
    شاگردان.بیفزا(دانش‌آموز { نام = "رضا"، کلاس = "هفتم ب" })
    شاگردان.بیفزا(دانش‌آموز { نام = "مینا"، کلاس = "هفتم الف" })

    گروه‌ها := گروه بندی(شاگردان)
    دیرکن گروه‌ها.آزادکن()
    هر کلاس، نام‌ها در گروه‌ها:
        سرچاپ کلاس، نام‌ها
    پایان
    هر _، نام‌ها در گروه‌ها:
        نام‌ها.آزادکن()
    پایان
پایان
