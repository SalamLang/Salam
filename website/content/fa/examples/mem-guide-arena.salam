واردسازی حافظه

ساختار توکن:
    همگانی آغاز: صحیح = ۰
    همگانی اندازه: صحیح = ۰
پایان

تابع توکن کردن(ق &: حافظه.قلمرو، خط: رشته): صحیح:
    ناپایا شمار := ۰
    ناپایا ای := ۰
    تا ای < خط.طول():
        اگر خط[ای] == ' ':
            ای += ۱
        وگرنه:
            ت := حافظه.تخصیص در قلمرو(ق، اندازه‌گونه(توکن)) برگردان توکن*
            ت[۰] = توکن { آغاز = ای }
            تا ای < خط.طول() و خط[ای] != ' ':
                ای += ۱
            پایان
            ت[۰].اندازه = ای - ت[۰].آغاز
            شمار += ۱
        پایان
    پایان
    برگشت شمار
پایان

تابع ریشه:
    ناپایا قلمرو := حافظه.قلمرو جدید(۴۰۹۶ برگردان طبیعی۶۴)
    خط‌ها := ["GET /index.html HTTP/1.1"، "POST /api/orders HTTP/1.1"، "DELETE /api/orders/7"]
    هر خط در خط‌ها:
        ع := توکن کردن(قلمرو، خط)
        سرچاپ ع، "توکن،"، حافظه.استفاده شده قلمرو(قلمرو)، "بایت مصرف شده"
        حافظه.بازنشانی قلمرو(قلمرو)
    پایان
    سرچاپ "پس از آخرین بازنشانی:"، حافظه.استفاده شده قلمرو(قلمرو)، "بایت مصرف شده از"، حافظه.ظرفیت قلمرو(قلمرو)
    حافظه.آزادسازی قلمرو(قلمرو)
پایان
