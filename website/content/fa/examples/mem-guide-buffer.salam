واردسازی حافظه

ساختار میانگیر:
    همگانی داده: طبیعی۸* = پوچ
    همگانی طول داده: طبیعی۶۴ = ۰
    همگانی ظرفیت: طبیعی۶۴ = ۰
پایان

تابع افزودن(م &: میانگیر، بایت: طبیعی۸):
    اگر م.طول داده == م.ظرفیت:
        ناپایا بعدی := م.ظرفیت * (۲ برگردان طبیعی۶۴)
        اگر بعدی == (۰ برگردان طبیعی۶۴):
            بعدی = ۴ برگردان طبیعی۶۴
        پایان
        م.داده = حافظه.بازتخصیص(م.داده برگردان تهی*، بعدی) برگردان طبیعی۸*
        م.ظرفیت = بعدی
        سرچاپ "بزرگ شد به"، م.ظرفیت، "بایت"
    پایان
    م.داده[م.طول داده] = بایت
    م.طول داده += ۱ برگردان طبیعی۶۴
پایان

تابع ریشه:
    ناپایا م := میانگیر {}
    متن := "Hello, arena and pool!"
    تکرار متن.طول() در ای:
        افزودن(م، متن[ای] برگردان طبیعی۸)
    پایان
    سرچاپ "طول:"، م.طول داده، "ظرفیت:"، م.ظرفیت
    ناپایا جمع := ۰
    تکرار م.طول داده برگردان صحیح در ای:
        جمع += م.داده[ای] برگردان صحیح
    پایان
    سرچاپ "جمع بایت‌ها:"، جمع
    حافظه.آزادسازی(م.داده برگردان تهی*)
پایان
