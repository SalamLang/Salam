واردسازی حافظه
واردسازی رشته

ساختار گره:
    همگانی مقدار: صحیح = ۰
    همگانی بعدی: گره* = پوچ
پایان

تابع گذاشتن(ا &: حافظه.استخر، سر: گره*، مقدار: صحیح): گره*:
    گ := حافظه.تخصیص از استخر(ا) برگردان گره*
    اگر گ == پوچ:
        سرچاپ "استخر پر است، کنار گذاشته شد:"، مقدار
        برگشت سر
    پایان
    گ[۰] = گره { مقدار = مقدار، بعدی = سر }
    برگشت گ
پایان

تابع برداشتن(ا &: حافظه.استخر، سر: گره*): گره*:
    بعدی := سر[۰].بعدی
    حافظه.بازگشت به استخر(ا، سر برگردان تهی*)
    برگشت بعدی
پایان

تابع ریشه:
    ناپایا استخر گره := حافظه.استخر جدید(اندازه‌گونه(گره)، ۳ برگردان طبیعی۶۴)
    ناپایا سر := پوچ برگردان گره*
    تکرار ۱ تا ۴ در م:
        سر = گذاشتن(استخر گره، سر، م * ۱۰)
    پایان
    سرچاپ "بالا:"، سر[۰].مقدار
    سر = برداشتن(استخر گره، سر)
    سر = گذاشتن(استخر گره، سر، ۹۹)
    ناپایا نتیجه := ""
    تا سر != پوچ:
        نتیجه = نتیجه + رشته.از عدد(سر[۰].مقدار) + " "
        سر = برداشتن(استخر گره، سر)
    پایان
    سرچاپ "پشته:"، نتیجه.پیراست()
    حافظه.نابودسازی استخر(استخر گره)
پایان
