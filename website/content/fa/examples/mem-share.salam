روال ریشه:
    سبد := وکتور {} برگردان وکتور<رشته>
    دیرکن سبد.آزادکن()
    سبد.بیفزا("نان")
    سبد.بیفزا("شیر")
    نما := سبد
    سبد.بنشان(۰، "برنج")
    سبد.بیفزا("چای")
    سرچاپ سبد، نما

    ذخیره := سبد.رونوشت()
    دیرکن ذخیره.آزادکن()
    سبد.بنشان(۱، "تخم‌مرغ")
    ذخیره.بیفزا("نمک")
    سرچاپ سبد، ذخیره
پایان
