تابع ریشه:
    سبد := وکتور {} برگردان وکتور<رشته>
    سبد.بیفزا("نان")
    سبد.بیفزا("شیر")
    نما := سبد
    دیرکن نما.آزادکن()
    نما.بنشان(۰، "برنج")
    نما.بیفزا("چای")
    سرچاپ نما

    ذخیره := نما.رونوشت()
    دیرکن ذخیره.آزادکن()
    نما.بنشان(۱، "تخم‌مرغ")
    ذخیره.بیفزا("نمک")
    سرچاپ نما، ذخیره
پایان
