واردسازی رشته
واردسازی حافظه

تابع نامک(عنوان: رشته): رشته:
    برگشت رشته.جایگزینی(عنوان، " "، "-")
پایان

تابع برچسب(عنوان: رشته): رشته:
    ن := نامک(عنوان)
    دیرکن حافظه.آزادسازی(ن برگردان تهی*)
    برگشت "#" + ن
پایان

تابع ریشه:
    نشانی := نامک("نخستین نوشته‌ی من")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ نشانی

    ب := برچسب("خبرهای سلام")
    دیرکن حافظه.آزادسازی(ب برگردان تهی*)
    سرچاپ ب

    بافر := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(بافر)
    تکرار ۳ در ی:
        اگر ی > ۰:
            رشته.افزودن به بافر(بافر، "، ")
        پایان
        رشته.افزودن به بافر(بافر، "ردیف ")
        رشته.افزودن عدد به بافر(بافر، (ی + ۱) برگردان صحیح۶۴)
    پایان
    گزارش := رشته.رشته بافر(بافر)
    دیرکن حافظه.آزادسازی(گزارش برگردان تهی*)
    سرچاپ گزارش
پایان
