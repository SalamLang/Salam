واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    اگر وارونه متاتریدر.آغاز(""، 0 برگردان صحیح۶۴، ""، ""، 60000، نادرست):
        e := متاتریدر.آخرین خطا()
        نادرست‌سرچاپ "no bridge:"، e.کد، e.توضیح
        برگشت 1
    پایان

    a := متاتریدر.دریافت اطلاعات حساب()
    اگر وارونه متاتریدر.موفق():
        e := متاتریدر.آخرین خطا()
        نادرست‌سرچاپ "account failed:"، e.کد، e.توضیح
        متاتریدر.پایان()
        برگشت 1
    پایان
    سرچاپ a.شناسه ورود، a.نام، a.ارز
    سرچاپ "balance"، a.موجودی، "equity"، a.دارایی خالص
    سرچاپ "margin"، a.حاشیه، "free"، a.حاشیه آزاد

    t := متاتریدر.دریافت اطلاعات ترمینال()
    سرچاپ t.شرکت، t.نام، t.شماره ساخت، t.متصل

    متاتریدر.پایان()
    برگشت 0
پایان
