واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    کندل‌ها := متاتریدر.کپی کندل‌ها از تاریخ("EURUSD"، متاتریدر.بازه یک ساعت، 1700000000 برگردان صحیح۶۴، 10)
    هر خوانده در کندل‌ها:
        سرچاپ خوانده.زمان، خوانده.قیمت باز، خوانده.بیشترین قیمت، خوانده.کمترین قیمت، خوانده.قیمت‌بسته، خوانده.حجم تیک
    پایان

    اخیر := متاتریدر.کپی کندل‌ها از موقعیت("EURUSD"، متاتریدر.بازه پنج دقیقه، 0، 5)
    سرچاپ "recent:"، اخیر.طول()

    پنجره زمانی := متاتریدر.کپی‌کندل‌ها‌در‌بازه("EURUSD"، متاتریدر.بازه یک روز، 1700000000 برگردان صحیح۶۴، 1700086400 برگردان صحیح۶۴)
    سرچاپ "daily:"، پنجره زمانی.طول()

    نوسان‌ها := متاتریدر.کپی نوسانات از تاریخ("EURUSD"، 1700000000 برگردان صحیح۶۴، 100، متاتریدر.تمام نوسانات قیمت)
    هر موقت در نوسان‌ها:
        سرچاپ موقت.زمان به میلی‌ثانیه، موقت.قیمت خرید، موقت.قیمت فروش، موقت.آخرین قیمت، موقت.پرچم‌ها
    پایان

    نوسان‌های معاملاتی := متاتریدر.کپی‌نوسانات‌در‌بازه("EURUSD"، 1700000000000 برگردان صحیح۶۴، 1700000600000 برگردان صحیح۶۴، متاتریدر.نوسانات قیمت معاملاتی)
    سرچاپ "trade ticks:"، نوسان‌های معاملاتی.طول()
    برگشت 0
پایان
