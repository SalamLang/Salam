واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    سرچاپ "symbols:"، متاتریدر.تعداد نمادها()
    هر s در متاتریدر.دریافت نمادها():
        سرچاپ s.نام، s.رقم اعشار، s.اسپرد، s.حالت معامله
    پایان

    majors := متاتریدر.دریافت نمادها با گروه("*USD*")
    سرچاپ "usd symbols:"، majors.طول()

    info := متاتریدر.دریافت اطلاعات نماد("EURUSD")
    سرچاپ info.قیمت خرید، info.قیمت فروش، info.اندازه پوینت، info.رقم اعشار
    سرچاپ info.حداقل حجم، info.گام حجم، info.حداکثر حجم
    سرچاپ info.سطح حد ضرر سود، info.اندازه قرارداد

    tick := متاتریدر.نوسان نماد("EURUSD")
    سرچاپ tick.زمان، tick.قیمت خرید، tick.قیمت فروش، tick.آخرین قیمت، tick.حجم

    اگر وارونه متاتریدر.انتخاب نماد("EURUSD"، درست):
        نادرست‌سرچاپ "cannot select EURUSD"
    پایان
    برگشت 0
پایان
