واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    سرچاپ "symbols:"، متاتریدر.تعداد نمادها()
    هر s در متاتریدر.دریافت نمادها():
        سرچاپ s.نام، s.رقم اعشار، s.اسپرد، s.حالت معامله
    پایان

    اصلی‌ها := متاتریدر.دریافت نمادها با گروه("*USD*")
    سرچاپ "usd symbols:"، اصلی‌ها.طول()

    اطلاعات := متاتریدر.دریافت اطلاعات نماد("EURUSD")
    سرچاپ اطلاعات.قیمت خرید، اطلاعات.قیمت فروش، اطلاعات.اندازه پوینت، اطلاعات.رقم اعشار
    سرچاپ اطلاعات.حداقل حجم، اطلاعات.گام حجم، اطلاعات.حداکثر حجم
    سرچاپ اطلاعات.سطح حد ضرر سود، اطلاعات.اندازه قرارداد

    نوسان := متاتریدر.نوسان نماد("EURUSD")
    سرچاپ نوسان.زمان، نوسان.قیمت خرید، نوسان.قیمت فروش، نوسان.آخرین قیمت، نوسان.حجم

    اگر وارونه متاتریدر.انتخاب نماد("EURUSD"، درست):
        نادرست‌سرچاپ "cannot select EURUSD"
    پایان
    برگشت 0
پایان
