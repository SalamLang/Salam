واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    سرچاپ "orders:"، متاتریدر.تعداد سفارش‌های فعال()
    هر o در متاتریدر.دریافت سفارش‌های فعال():
        سرچاپ o.شماره تیکت، o.نماد، o.نوع سفارش، o.وضعیت، o.حجم فعلی، o.قیمت ورود
    پایان
    هر p در متاتریدر.دریافت پوزیشن‌های باز():
        سرچاپ p.شماره تیکت، p.نماد، p.نوع پوزیشن، p.حجم، p.قیمت ورود، p.سود
    پایان

    ناپایا req := متاتریدر.درخواست معامله {}
    req.عملیات = متاتریدر.عملیات معامله فوری
    req.نماد = "EURUSD"
    req.حجم = 0.10
    req.قیمت = 1.0821
    req.نوع سفارش = متاتریدر.سفارش خرید
    req.نوع پرشدن = متاتریدر.پرشدن فوری
    req.نوع زمان = متاتریدر.اعتبار نامحدود
    req.انحراف مجاز = 10
    req.شناسه ربات = 2026
    req.یادداشت = "salam"

    check := متاتریدر.بررسی سفارش(req)
    سرچاپ "check:"، check.کد نتیجه، check.حاشیه، check.حاشیه آزاد، check.یادداشت
    اگر check.کد نتیجه نابرابر 0:
        برگشت 1
    پایان

    sent := متاتریدر.ارسال سفارش(req)
    سرچاپ "send:"، sent.کد نتیجه، sent.شماره سفارش، sent.شماره معامله، sent.قیمت
    اگر sent.کد نتیجه نابرابر متاتریدر.کد اجرای کامل و sent.کد نتیجه نابرابر متاتریدر.کد ثبت سفارش:
        نادرست‌سرچاپ "order rejected:"، sent.یادداشت
        برگشت 1
    پایان

    margin := متاتریدر.محاسبه حاشیه سفارش(متاتریدر.سفارش خرید، "EURUSD"، 0.10، 1.0821)
    profit := متاتریدر.محاسبه سود سفارش(متاتریدر.سفارش خرید، "EURUSD"، 0.10، 1.0821، 1.09)
    سرچاپ margin، profit
    برگشت 0
پایان
