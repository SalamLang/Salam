واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    سرچاپ "orders:"، متاتریدر.تعداد سفارش‌های فعال()
    هر o در متاتریدر.دریافت سفارش‌های فعال():
        سرچاپ o.شماره تیکت، o.نماد، o.نوع سفارش، o.وضعیت، o.حجم فعلی، o.قیمت ورود
    پایان
    هر p در متاتریدر.دریافت پوزیشن‌های باز():
        سرچاپ p.شماره تیکت، p.نماد، p.نوع پوزیشن، p.حجم، p.قیمت ورود، p.سود
    پایان

    ناپایا درخواست := متاتریدر.درخواست معامله {}
    درخواست.عملیات = متاتریدر.عملیات معامله فوری
    درخواست.نماد = "EURUSD"
    درخواست.حجم = 0.10
    درخواست.قیمت = 1.0821
    درخواست.نوع سفارش = متاتریدر.سفارش خرید
    درخواست.نوع پرشدن = متاتریدر.پرشدن فوری
    درخواست.نوع زمان = متاتریدر.اعتبار نامحدود
    درخواست.انحراف مجاز = 10
    درخواست.شناسه ربات = 2026
    درخواست.یادداشت = "salam"

    بررسی := متاتریدر.بررسی سفارش(درخواست)
    سرچاپ "check:"، بررسی.کد نتیجه، بررسی.حاشیه، بررسی.حاشیه آزاد، بررسی.یادداشت
    اگر بررسی.کد نتیجه نابرابر 0:
        برگشت 1
    پایان

    ارسال شده := متاتریدر.ارسال سفارش(درخواست)
    سرچاپ "send:"، ارسال شده.کد نتیجه، ارسال شده.شماره سفارش، ارسال شده.شماره معامله، ارسال شده.قیمت
    اگر ارسال شده.کد نتیجه نابرابر متاتریدر.کد اجرای کامل و ارسال شده.کد نتیجه نابرابر متاتریدر.کد ثبت سفارش:
        نادرست‌سرچاپ "order rejected:"، ارسال شده.یادداشت
        برگشت 1
    پایان

    حاشیه := متاتریدر.محاسبه حاشیه سفارش(متاتریدر.سفارش خرید، "EURUSD"، 0.10، 1.0821)
    سود := متاتریدر.محاسبه سود سفارش(متاتریدر.سفارش خرید، "EURUSD"، 0.10، 1.0821، 1.09)
    سرچاپ حاشیه، سود
    برگشت 0
پایان
