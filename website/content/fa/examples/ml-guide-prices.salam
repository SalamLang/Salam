واردسازی یادگیری ماشین
واردسازی ماتریس

تابع بساز(سطرها: صحیح، ستون‌ها: صحیح، عددها: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در عددها.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع یک رقم(عدد: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، عدد)، ۱)
پایان

تابع ریشه:
    ناپایا خانه‌ها := بساز(۸، ۳، "50 1 20 65 2 15 80 2 10 90 3 30 100 3 5 120 4 12 140 4 3 160 5 8")
    ناپایا قیمت := بساز(۸، ۱، "105 140 178 172 228 260 312 344")

    ناپایا مدل := یادگیری ماشین.رگرسیون خطی {}
    دیرکن مدل.آزادسازی()
    سرچاپ "برازش شد"، مدل.برازش(خانه‌ها، قیمت)
    سرچاپ "هر متر"، یک رقم(مدل.ضریب‌ها.عنصر(۰، ۰))، "هر اتاق"، یک رقم(مدل.ضریب‌ها.عنصر(۱، ۰))، "هر سال عمر"، یک رقم(مدل.ضریب‌ها.عنصر(۲، ۰))
    سرچاپ "پایه"، یک رقم(مدل.عرض از مبدأ)

    ناپایا پیش‌بینی := مدل.پیش‌بینی(خانه‌ها)
    سرچاپ "R2"، ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، یادگیری ماشین.ضریب تعیین(قیمت، پیش‌بینی))، ۳)، "RMSE"، یک رقم(یادگیری ماشین.ریشه میانگین مربعات خطا(قیمت، پیش‌بینی))

    ناپایا پیشنهاد := مدل.پیش‌بینی(بساز(۲، ۳، "110 3 10 70 2 25"))
    سرچاپ "۱۱۰ متر، ۳ اتاق، ۱۰ سال:"، یک رقم(پیشنهاد.عنصر(۰، ۰))
    سرچاپ "۷۰ متر، ۲ اتاق، ۲۵ سال:"، یک رقم(پیشنهاد.عنصر(۱، ۰))
پایان
