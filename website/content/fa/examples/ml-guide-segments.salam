واردسازی یادگیری ماشین
واردسازی ماتریس

تابع بساز(سطرها: صحیح، ستون‌ها: صحیح، عددها: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در عددها.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع ریشه:
    ناپایا مشتریان := بساز(۱۰، ۲، "2 15 3 20 1 10 2 12 12 30 14 35 11 28 4 210 5 250 3 190")

    ناپایا مقیاس‌گر := یادگیری ماشین.مقیاس‌گر استاندارد {}
    دیرکن مقیاس‌گر.آزادسازی()
    ناپایا مقیاس‌شده := مقیاس‌گر.برازش سپس تبدیل(مشتریان)

    ناپایا خوشه‌بند := یادگیری ماشین.کی میانگین { شمار خوشه‌ها = 3، بذر = 5 }
    دیرکن خوشه‌بند.آزادسازی()
    ناپایا برچسب‌ها := خوشه‌بند.برازش سپس پیش‌بینی(مقیاس‌شده)
    سرچاپ "امتیاز سایه‌نما"، ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، یادگیری ماشین.امتیاز سایه‌نما(مقیاس‌شده، برچسب‌ها))، ۲)

    ناپایا مرکزها := مقیاس‌گر.تبدیل معکوس(خوشه‌بند.مرکزها)
    تکرار ۳ در خ:
        ناپایا اعضا := ۰
        تکرار برچسب‌ها.سطرها در ی:
            اگر برچسب‌ها.عنصر(ی، ۰) برگردان صحیح برابر خ: اعضا += ۱ پایان
        پایان
        سرچاپ "گروه"، خ، "مشتری"، اعضا، "مراجعه"، ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، مرکزها.عنصر(خ، ۰))، ۱)، "خرید"، ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، مرکزها.عنصر(خ، ۱))، ۱)
    پایان

    ناپایا تازه := مقیاس‌گر.تبدیل(بساز(۱، ۲، "13 32"))
    سرچاپ "مشتری تازه به گروه"، خوشه‌بند.پیش‌بینی(تازه).عنصر(۰، ۰) برگردان صحیح، "می‌رود"
پایان
