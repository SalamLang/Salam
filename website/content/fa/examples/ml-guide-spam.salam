واردسازی یادگیری ماشین
واردسازی ماتریس

تابع شمارش واژه‌ها(پیام‌ها: وکتور<رشته>، واژگان: وکتور<رشته>): ماتریس.ماتریس:
    ناپایا م := ماتریس.صفرها(پیام‌ها.طول()، واژگان.طول())
    هر ی، متن در پیام‌ها:
        هر واژه در متن.بشکاف(" "):
            هر ج، شناخته در واژگان:
                اگر واژه برابر شناخته: م.تنظیم(ی، ج، م.عنصر(ی، ج) + ۱.۰) پایان
            پایان
        پایان
    پایان
    برگشت م
پایان

تابع ریشه:
    ناپایا واژگان := وکتور {} برگردان وکتور<رشته>
    دیرکن واژگان.آزادکن()
    هر واژه در ["رایگان"، "برنده"، "جایزه"، "فوری"، "جلسه"، "ناهار"، "گزارش"، "فردا"]: واژگان.بیفزا(واژه) پایان

    ناپایا آموزشی := وکتور {} برگردان وکتور<رشته>
    دیرکن آموزشی.آزادکن()
    هر م در ["برنده‌ی جایزه رایگان فوری"، "جایزه رایگان فوری"، "برنده فوری برنده"، "جلسه فردا"، "ناهار فردا"، "گزارش برای جلسه"]: آموزشی.بیفزا(م) پایان
    ناپایا نشان‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    هر ن در [۱.۰، ۱.۰، ۱.۰، ۰.۰، ۰.۰، ۰.۰]: نشان‌ها.بیفزا(ن) پایان
    ناپایا برچسب‌ها := ماتریس.از آرایه(۶، ۱، نشان‌ها)

    ناپایا مدل := یادگیری ماشین.بیز ساده چندجمله‌ای { ضریب هموارسازی = 1.0 }
    دیرکن مدل.آزادسازی()
    ناپایا داده := شمارش واژه‌ها(آموزشی، واژگان)
    سرچاپ "آموزش دید"، مدل.برازش(داده، برچسب‌ها)

    ناپایا صندوق := وکتور {} برگردان وکتور<رشته>
    دیرکن صندوق.آزادکن()
    هر م در ["ناهار رایگان فردا"، "شما برنده جایزه شدید"، "گزارش را فردا بفرست"]: صندوق.بیفزا(م) پایان
    ناپایا پیش‌بینی := مدل.پیش‌بینی(شمارش واژه‌ها(صندوق، واژگان))
    هر ی، متن در صندوق:
        ناپایا رأی := "صندوق"
        اگر پیش‌بینی.عنصر(ی، ۰) برابر ۱.۰: رأی = "هرزنامه" پایان
        سرچاپ رأی، "<-"، متن
    پایان
پایان
