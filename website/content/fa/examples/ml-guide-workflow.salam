واردسازی یادگیری ماشین
واردسازی ماتریس

تابع بساز(سطرها: صحیح، ستون‌ها: صحیح، عددها: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در عددها.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع ریشه:
    ناپایا ساعت‌ها := بساز(۱۲، ۲، "1 4 2 5 2 8 3 6 3 9 4 5 5 7 6 8 7 6 8 7 9 8 10 7")
    ناپایا قبولی := بساز(۱۲، ۱، "0 0 0 0 1 0 1 1 1 1 1 1")

    ناپایا تقسیم := یادگیری ماشین.تقسیم آموزش‌آزمون(ساعت‌ها، قبولی، ۰.۲۵، ۲)
    دیرکن تقسیم.آزادسازی()
    سرچاپ "آموزش"، ماتریس.رشته شکل(تقسیم.ویژگی‌های آموزش)، "آزمون"، ماتریس.رشته شکل(تقسیم.ویژگی‌های آزمون)

    ناپایا مقیاس‌گر := یادگیری ماشین.مقیاس‌گر استاندارد {}
    دیرکن مقیاس‌گر.آزادسازی()
    ناپایا آموزش := مقیاس‌گر.برازش سپس تبدیل(تقسیم.ویژگی‌های آموزش)
    ناپایا آزمون := مقیاس‌گر.تبدیل(تقسیم.ویژگی‌های آزمون)

    ناپایا مدل := یادگیری ماشین.رگرسیون لجستیک { بیشترین دور = 2000 }
    دیرکن مدل.آزادسازی()
    سرچاپ "آموزش دید"، مدل.برازش(آموزش، تقسیم.برچسب‌های آموزش)
    ناپایا پیش‌بینی := مدل.پیش‌بینی(آزمون)
    سرچاپ "دقت"، یادگیری ماشین.دقت(تقسیم.برچسب‌های آزمون، پیش‌بینی)
    سرچاپ "ماتریس درهم‌ریختگی"، ماتریس.به بازنمایی(یادگیری ماشین.ماتریس درهم‌ریختگی(تقسیم.برچسب‌های آزمون، پیش‌بینی، ۲)، ۰)

    ناپایا دانشجو := مقیاس‌گر.تبدیل(بساز(۱، ۲، "6 6"))
    احتمال := مدل.پیش‌بینی احتمال(دانشجو)
    سرچاپ "شانس قبولی"، ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، احتمال.عنصر(۰، ۱))، ۲)
پایان
