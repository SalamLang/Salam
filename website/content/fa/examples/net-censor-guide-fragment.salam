// زبان: فارسی
واردسازی شبکه.سانسورشکن
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

پایا HELLO := "160301008c010000880303000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f206465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80818283000613011302c02b0100003900000014001200000f7777772e6578616d706c652e636f6d000a00040002001d0010000e000c02683208687474702f312e31002b0003020304"

ناپایا درگاه := 0
ناپایا دیده := ""
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع server():
    کارساز := تی سی پی.پیوند(0)
    درگاه = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    نویسه := تی سی پی.پذیرش(کارساز)
    تی سی پی.تنظیم مهلت خواندن(نویسه، 1500)
    تا درست:
        داده := تی سی پی.خواندن(نویسه، 4096)
        اگر داده.طول() برابر 0:
            بشکن
        پایان
        دیده += داده.طول() + " "
    پایان
    تی سی پی.بستن(نویسه)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(server)
    همگام سازی.انتظار(آماده)

    متغیر_hello := سانسورشکن.از هگز(HELLO)
    اندازه‌ها := سانسورشکن.اندازه تکه‌ها از روی نام سرور(متغیر_hello.داده، متغیر_hello.طول، نادرست)
    ناپایا تکه‌ها := سانسورشکن.برش(متغیر_hello.داده، متغیر_hello.طول، اندازه‌ها)
    سرچاپ "نام سرور از بایت"، سانسورشکن.تجزیه پیام آغازین(متغیر_hello.داده، متغیر_hello.طول).جایگاه نام سرور، "شروع می‌شود و پس از"، اندازه‌ها.بگیر(0)، "بایت بریده می‌شود"

    اتصال := تی سی پی.شماره گیری("127.0.0.1"، درگاه)
    تی سی پی.غیرفعال‌سازی نگل(اتصال، درست)
    تکرار تکه‌ها.طول() در شمارنده:
        تکه := تکه‌ها.بگیر(شمارنده)
        تی سی پی.نوشتن بایت(اتصال، تکه.داده، تکه.طول)
        همگام سازی.خواب میلی ثانیه(60)
    پایان
    تی سی پی.بستن(اتصال)
    نخ‌پیوند(موقت)
    سرچاپ "سرور خواند:"، دیده
    سرچاپ "تکه‌های فرستاده‌شده:"، تکه‌ها.طول()
    سانسورشکن.آزاد کردن تکه‌ها(تکه‌ها)
پایان
