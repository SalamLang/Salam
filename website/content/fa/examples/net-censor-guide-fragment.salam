// زبان: فارسی
واردسازی شبکه.سانسورشکن
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

پایا HELLO := "160301008c010000880303000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f206465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80818283000613011302c02b0100003900000014001200000f7777772e6578616d706c652e636f6d000a00040002001d0010000e000c02683208687474702f312e31002b0003020304"

ناپایا port := 0
ناپایا seen := ""
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع server():
    srv := تی سی پی.پیوند(0)
    port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    c := تی سی پی.پذیرش(srv)
    تی سی پی.تنظیم مهلت خواندن(c، 1500)
    تا درست:
        data := تی سی پی.خواندن(c، 4096)
        اگر data.طول() برابر 0:
            بشکن
        پایان
        seen += data.طول() + " "
    پایان
    تی سی پی.بستن(c)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)

    hello := سانسورشکن.از هگز(HELLO)
    sizes := سانسورشکن.اندازه تکه‌ها از روی نام سرور(hello.داده، hello.طول، نادرست)
    ناپایا pieces := سانسورشکن.برش(hello.داده، hello.طول، sizes)
    سرچاپ "server name starts at byte"، سانسورشکن.تجزیه پیام آغازین(hello.داده، hello.طول).جایگاه نام سرور، "and is cut after"، sizes.بگیر(0)، "bytes"

    conn := تی سی پی.شماره گیری("127.0.0.1"، port)
    تی سی پی.غیرفعال‌سازی نگل(conn، درست)
    تکرار pieces.طول() در i:
        piece := pieces.بگیر(i)
        تی سی پی.نوشتن بایت(conn، piece.داده، piece.طول)
        همگام سازی.خواب میلی ثانیه(60)
    پایان
    تی سی پی.بستن(conn)
    نخ‌پیوند(t)
    سرچاپ "the server read:"، seen
    سرچاپ "pieces sent:"، pieces.طول()
    سانسورشکن.آزاد کردن تکه‌ها(pieces)
پایان
