واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.تی سی پی

ناپایا سرور := تی سی پی.سرور {}

تابع خوشامد():
    ا := تی سی پی.پذیرش(سرور)
    _ := تی سی پی.نوشتن(ا، "سلام، پیدایم کردی")
    تی سی پی.بستن(ا)
پایان

تابع وصل شو(میزبان: رشته، درگاه: صحیح): تی سی پی.اتصال شبکه:
    نشانی := دی‌ان‌اس.جستجو(میزبان)
    اگر نشانی == "":
        سرچاپ "نشانی"، میزبان، "پیدا نشد"
        برگشت تی سی پی.اتصال شبکه {}
    پایان
    سرچاپ میزبان، "یعنی"، نشانی
    برگشت تی سی پی.شماره گیری(نشانی، درگاه)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    ن := نخ‌ساز(خوشامد)
    ا := وصل شو("localhost"، تی سی پی.درگاه(سرور))
    اگر تی سی پی.اتصال معتبر(ا):
        تی سی پی.تنظیم مهلت خواندن(ا، ۲۰۰۰)
        سرچاپ تی سی پی.خواندن(ا، ۱۰۲۴)
        تی سی پی.بستن(ا)
    پایان
    نخ‌پیوند(ن)
    تی سی پی.بستن سرور(سرور)
    بد := وصل شو("no-such-host.invalid"، ۸۰)
    سرچاپ "وصل شد:"، تی سی پی.اتصال معتبر(بد)
پایان
