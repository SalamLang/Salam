واردسازی شبکه.دی‌ان‌اس

تابع ریشه:
    دامنه := "gmail.com"
    سرورهای نامه := دی‌ان‌اس.جستجوی ام‌ایکس(دامنه)
    اگر سرورهای نامه.رکوردها.طول() == ۰:
        سرچاپ دامنه، "رکورد MX ندارد و نامه به رکورد A آن می‌رود"
    پایان
    ناپایا بهترین := دی‌ان‌اس.رکورد {}
    هر ر در سرورهای نامه.رکوردها:
        سرچاپ "MX"، ر.اولویت، ر.داده
        اگر بهترین.داده == "" یا ر.اولویت < بهترین.اولویت:
            بهترین = ر
        پایان
    پایان
    سرچاپ "اول به این سرور تحویل بده:"، بهترین.داده
    هر متن در دی‌ان‌اس.جستجوی تی‌ایکس‌تی(دامنه):
        اگر متن.شروع با("v=spf1"):
            سرچاپ "SPF:"، متن
        پایان
    پایان
    هر متن در دی‌ان‌اس.جستجوی تی‌ایکس‌تی("_dmarc." + دامنه):
        اگر متن.شروع با("v=DMARC1"):
            سرچاپ "DMARC:"، متن
        پایان
    پایان
پایان
