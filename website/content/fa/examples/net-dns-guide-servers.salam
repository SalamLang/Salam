واردسازی شبکه.دی‌ان‌اس

تابع نمایش(کارگزار: رشته، نام: رشته):
    پ := دی‌ان‌اس.پرسش از کارگزار(کارگزار، نام، دی‌ان‌اس.نوع آ، ۲۰۰۰)
    اگر پ.id == ۰ و وارونه پ.qr:
        سرچاپ کارگزار، "پاسخی نداد"
        برگشت
    پایان
    اگر پ.rcode == ۳:
        سرچاپ کارگزار، "می‌گوید"، نام، "وجود ندارد"
        برگشت
    پایان
    هر ر در پ.answers.items:
        اگر ر.rtype == دی‌ان‌اس.نوع آ:
            سرچاپ کارگزار، نام، "->"، ر.data، "برای"، ر.ttl، "ثانیه"
        وگرنه:
            سرچاپ کارگزار، نام، "نام دیگرِ"، ر.data، "است"
        پایان
    پایان
پایان

تابع ریشه:
    کارگزارها := دی‌ان‌اس.کارگزارهای پیش‌فرض()
    سرچاپ "کارگزارهای سیستم:"، کارگزارها
    نمایش(کارگزارها.بگیر(۰)، "www.github.com")
    نمایش("1.1.1.1"، "salamlang.ir")
    نمایش("1.1.1.1"، "no-such-name.invalid")
    نمایش("192.0.2.1"، "salamlang.ir")
پایان
