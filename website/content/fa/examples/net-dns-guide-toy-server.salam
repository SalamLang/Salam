واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.یو دی پی
واردسازی حافظه

ناپایا سرور := یو دی پی.سوکت یو دی پی {}

تابع پاسخ نبودن():
    یو دی پی.تنظیم زمان انتظار(سرور، ۲۰۰۰)
    بافر := حافظه.تخصیص صفرشده(۵۱۲ برگردان طبیعی۶۴)
    ناپایا میزبان := ""
    ناپایا درگاه := ۰
    تعداد := یو دی پی.دریافت بایت(سرور، بافر، ۵۱۲، میزبان، درگاه)
    پرسش := دی‌ان‌اس.کدگشایی(بافر، تعداد)
    سرچاپ "سرور: پرسش"، پرسش.شناسه، "برای"، پرسش.پرسش‌ها.پرسش‌ها[۰].نام دامنه
    ب := بافر برگردان طبیعی۸*
    ب[۲] = ب[۲] | (۱۲۸ برگردان طبیعی۸)
    ب[۳] = ۱۳۱ برگردان طبیعی۸
    _ := یو دی پی.ارسال بایت(سرور، میزبان، درگاه، بافر، تعداد)
    حافظه.آزادسازی(بافر)
پایان

تابع نام کد(کد: صحیح): رشته:
    ترابرد کد:
        ۰: برگشت "NOERROR" پایان
        ۲: برگشت "SERVFAIL" پایان
        ۳: برگشت "NXDOMAIN" پایان
        ۵: برگشت "REFUSED" پایان
    پایان
    برگشت "دیگر"
پایان

تابع ریشه:
    سرور = یو دی پی.پیوند روی("127.0.0.1"، ۰)
    ن := نخ‌ساز(پاسخ نبودن)
    پرسش := دی‌ان‌اس.کدگذاری پرسش("shop.example"، دی‌ان‌اس.نوع آ، ۷)
    کارخواه := یو دی پی.باز کردن()
    یو دی پی.تنظیم زمان انتظار(کارخواه، ۲۰۰۰)
    _ := یو دی پی.ارسال بایت(کارخواه، "127.0.0.1"، یو دی پی.درگاه(سرور)، پرسش.داده، پرسش.طول)
    پاسخ := حافظه.تخصیص صفرشده(۵۱۲ برگردان طبیعی۶۴)
    ناپایا میزبان := ""
    ناپایا درگاه := ۰
    تعداد := یو دی پی.دریافت بایت(کارخواه، پاسخ، ۵۱۲، میزبان، درگاه)
    نخ‌پیوند(ن)
    پ := دی‌ان‌اس.کدگشایی(پاسخ، تعداد)
    سرچاپ "کارخواه: پاسخ"، پ.شناسه، "qr"، پ.نشانه پاسخ، "ra"، پ.جستجوی بازگشتی ممکن
    سرچاپ "کارخواه: کد نتیجه"، پ.کد نتیجه، نام کد(پ.کد نتیجه)، "پاسخ‌ها"، پ.پاسخ‌ها.رکوردها.طول()
    حافظه.آزادسازی(پاسخ)
    یو دی پی.بستن(کارخواه)
    یو دی پی.بستن(سرور)
پایان
