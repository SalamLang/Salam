واردسازی شبکه.پست الکترونیک
واردسازی سیستم عامل

تابع ریشه:
    کاربر := سیستم عامل.متغیر محیطی("MAIL_USER")
    گذرواژه := سیستم عامل.متغیر محیطی("MAIL_APP_PASSWORD")
    فرستاده := پست الکترونیک.ارسال("smtp.gmail.com"، ۴۶۵، درست، کاربر، گذرواژه، کاربر، "sara@example.com"، "گزارش هفتگی"، "گزارش آماده است."، "<p><b>گزارش</b> آماده است.</p>")
    سرچاپ "با گذرواژه فرستاده شد:"، فرستاده
    ناپایا ک := پست الکترونیک.اتصال امن اس‌ام‌تی‌پی("smtp.gmail.com"، ۴۶۵)
    اگر وارونه (ک.سالم و پست الکترونیک.سلام(ک، "example.com")):
        سرچاپ "اتصال برقرار نشد:"، ک.آخرین پاسخ
        برگشت ۱
    پایان
    اگر وارونه پست الکترونیک.احراز هویت ایکس‌اواث۲(ک، کاربر، سیستم عامل.متغیر محیطی("MAIL_OAUTH_TOKEN")):
        سرچاپ "ورود پذیرفته نشد:"، ک.آخرین پاسخ
        پست الکترونیک.خروج اس‌ام‌تی‌پی(ک)
        برگشت ۱
    پایان
    خوب := پست الکترونیک.فرستنده(ک، کاربر) و پست الکترونیک.گیرنده(ک، "sara@example.com") و پست الکترونیک.داده(ک، پست الکترونیک.ساخت پیام(کاربر، "sara@example.com"، "سلام"، "با توکن OAuth فرستاده شد."، ""))
    سرچاپ "با توکن فرستاده شد:"، خوب
    پست الکترونیک.خروج اس‌ام‌تی‌پی(ک)
    برگشت ۰
پایان
