واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی
واردسازی رشته

ناپایا سرور := تی سی پی.سرور {}

تابع سطر بعدی(ا: تی سی پی.اتصال شبکه، انباشته &: رشته): رشته:
    تا انباشته.بیاب("\r\n") کوچکتر ۰:
        انباشته += تی سی پی.خواندن(ا، ۴۰۹۶)
    پایان
    جا := انباشته.بیاب("\r\n")
    سطر := انباشته.زیررشته(۰، جا)
    انباشته = انباشته.زیررشته(جا + ۲، انباشته.طول() - جا - ۲)
    برگشت سطر
پایان

تابع سرور آی‌مپ():
    ا := تی سی پی.پذیرش(سرور)
    ناپایا انباشته := ""
    _ := تی سی پی.نوشتن(ا، "* OK IMAP ready\r\n")
    ناپایا تمام := نادرست
    تا وارونه تمام:
        سطر := سطر بعدی(ا، انباشته)
        برچسب := رشته.تفکیک کردن(سطر، " ")[۰]
        اگر رشته.شامل است(سطر، " FETCH "):
            اولی := "Subject: Invoice 12\r\nFrom: billing@shop.test\r\n\r\n"
            دومی := "Subject: Lunch?\r\nFrom: reza@example.com\r\n\r\n"
            _ := تی سی پی.نوشتن(ا، "* 2 FETCH (BODY[HEADER.FIELDS (SUBJECT FROM)] {" + اولی.طول() + "}\r\n" + اولی + ")\r\n")
            _ := تی سی پی.نوشتن(ا، "* 3 FETCH (BODY[HEADER.FIELDS (SUBJECT FROM)] {" + دومی.طول() + "}\r\n" + دومی + ")\r\n")
        وگرنه رشته.شامل است(سطر، " LOGOUT"):
            _ := تی سی پی.نوشتن(ا، "* BYE\r\n")
            تمام = درست
        پایان
        _ := تی سی پی.نوشتن(ا، برچسب + " OK done\r\n")
    پایان
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(سرور آی‌مپ)
    ناپایا ک := پست الکترونیک.اتصال آی‌مپ("127.0.0.1"، تی سی پی.درگاه(سرور))
    _ := پست الکترونیک.ورود(ک، "sara"، "secret") و پست الکترونیک.انتخاب(ک، "INBOX")
    سطرها := پست الکترونیک.دریافت پیام‌ها(ک، "2:3"، "BODY.PEEK[HEADER.FIELDS (SUBJECT FROM)]")
    سرچاپ "سطرهای رسیده:"، سطرها.طول()
    ناپایا موضوع := ""
    ناپایا فرستنده := ""
    هر سطر در سطرها:
        اگر رشته.شروع با(سطر، "Subject: "):
            موضوع = سطر.زیررشته(۹، سطر.طول() - ۹)
        وگرنه رشته.شروع با(سطر، "From: "):
            فرستنده = سطر.زیررشته(۶، سطر.طول() - ۶)
        وگرنه سطر == ")":
            سرچاپ فرستنده، "نوشته:"، موضوع
        پایان
    پایان
    پست الکترونیک.خروج آی‌مپ(ک)
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور)
پایان
