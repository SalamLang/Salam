واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی
واردسازی رشته

ناپایا سرور := تی سی پی.سرور {}

تابع سطر بعدی(ا: تی سی پی.اتصال شبکه، انباشته &: رشته): رشته:
    تا انباشته.بیاب("\r\n") کوچکتر ۰:
        انباشته += تی سی پی.خواندن(ا، ۴۰۹۶)
    پایان
    جا := انباشته.بیاب("\r\n")
    سطر := انباشته.زیررشته(۰، جا)
    انباشته = انباشته.زیررشته(جا + ۲، انباشته.طول() - جا - ۲)
    برگشت سطر
پایان

تابع سرور آی‌مپ():
    ا := تی سی پی.پذیرش(سرور)
    ناپایا انباشته := ""
    _ := تی سی پی.نوشتن(ا، "* OK IMAP ready\r\n")
    ناپایا تمام := نادرست
    تا وارونه تمام:
        سطر := سطر بعدی(ا، انباشته)
        برچسب := رشته.تفکیک کردن(سطر، " ")[۰]
        اگر رشته.شامل است(سطر، " SELECT "):
            _ := تی سی پی.نوشتن(ا، "* 3 EXISTS\r\n* 2 RECENT\r\n")
        وگرنه رشته.شامل است(سطر، " SEARCH "):
            _ := تی سی پی.نوشتن(ا، "* SEARCH 2 3\r\n")
        وگرنه رشته.شامل است(سطر، " FETCH "):
            _ := تی سی پی.نوشتن(ا، "* 2 FETCH (FLAGS (\\Recent))\r\n* 3 FETCH (FLAGS (\\Recent \\Flagged))\r\n")
        وگرنه رشته.شامل است(سطر، " LOGOUT"):
            _ := تی سی پی.نوشتن(ا، "* BYE\r\n")
            تمام = درست
        پایان
        _ := تی سی پی.نوشتن(ا، برچسب + " OK done\r\n")
    پایان
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(سرور آی‌مپ)
    ناپایا ک := پست الکترونیک.اتصال آی‌مپ("127.0.0.1"، تی سی پی.درگاه(سرور))
    سرچاپ "وارد شد:"، ک.سالم و پست الکترونیک.ورود(ک، "sara"، "secret")
    انتخاب := پست الکترونیک.دستور(ک، "SELECT \"INBOX\"")
    هر سطر در انتخاب.خطوط:
        اگر رشته.پایان با(سطر، " EXISTS"): سرچاپ "صندوق:"، سطر پایان
    پایان
    نخوانده := پست الکترونیک.دستور(ک، "SEARCH UNSEEN")
    سرچاپ "نخوانده:"، نخوانده.خطوط[۰]، "وضعیت:"، نخوانده.وضعیت
    هر سطر در پست الکترونیک.دریافت پیام‌ها(ک، "2:3"، "FLAGS"):
        سرچاپ " "، سطر
    پایان
    پست الکترونیک.خروج آی‌مپ(ک)
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور)
پایان
