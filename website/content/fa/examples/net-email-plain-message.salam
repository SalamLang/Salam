واردسازی شبکه.پست الکترونیک
واردسازی رشته
واردسازی کدگذاری

تابع نمایش(پیام: رشته):
    هر سطر در رشته.تفکیک کردن(پیام، "\r\n"):
        سرچاپ سطر
    پایان
    سرچاپ "-----"
پایان

تابع ریشه:
    متنی := پست الکترونیک.ساخت پیام("shop@example.com"، "sara@example.com"، "Your code"، "کد ورود شما ۴۸۲۱ است."، "")
    نمایش(متنی)
    اچ‌تی‌ام‌ال := پست الکترونیک.ساخت پیام("shop@example.com"، "sara@example.com"، "Welcome"، ""، "<h1>سارا، خوش آمدید</h1>")
    نمایش(اچ‌تی‌ام‌ال)
    پیام دوگانه := پست الکترونیک.ساخت پیام("shop@example.com"، "sara@example.com"، "News"، "نسخه‌ی ساده"، "<p>نسخه‌ی HTML</p>")
    تکه‌ها := رشته.تفکیک کردن(پیام دوگانه، "Content-Type: ")
    هر ی، تکه در تکه‌ها:
        اگر ی بزرگتر ۰: سرچاپ "Content-Type"، ی، "برابر"، رشته.تفکیک کردن(تکه، ";")[۰] پایان
    پایان
    موضوع := "=?UTF-8?B?" + کدگذاری.کدگذاری پایه۶۴("سفارش شما رسید") + "?="
    سرچاپ "موضوع کدگذاری‌شده:"، موضوع
پایان
