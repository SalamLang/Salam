واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی
واردسازی رشته

ناپایا سرور := تی سی پی.سرور {}

تابع سطر بعدی(ا: تی سی پی.اتصال شبکه، انباشته &: رشته): رشته:
    تا انباشته.بیاب("\r\n") کوچکتر ۰:
        انباشته += تی سی پی.خواندن(ا، ۴۰۹۶)
    پایان
    جا := انباشته.بیاب("\r\n")
    سطر := انباشته.زیررشته(۰، جا)
    انباشته = انباشته.زیررشته(جا + ۲، انباشته.طول() - جا - ۲)
    برگشت سطر
پایان

تابع سرور پاپ():
    نامه‌ها := ["Subject: Welcome\r\n\r\nسلام سارا."، "Subject: Invoice 12\r\n\r\nجمع: ۴۰ دلار\r\n..پایان صورت‌حساب"]
    ا := تی سی پی.پذیرش(سرور)
    ناپایا انباشته := ""
    _ := تی سی پی.نوشتن(ا، "+OK ready\r\n")
    ناپایا سطر := سطر بعدی(ا، انباشته)
    تا سطر نابرابر "QUIT":
        اگر سطر برابر "STAT":
            _ := تی سی پی.نوشتن(ا، "+OK 2 " + (نامه‌ها[۰].طول() + نامه‌ها[۱].طول()) + "\r\n")
        وگرنه سطر برابر "LIST":
            _ := تی سی پی.نوشتن(ا، "+OK\r\n1 " + نامه‌ها[۰].طول() + "\r\n2 " + نامه‌ها[۱].طول() + "\r\n.\r\n")
        وگرنه رشته.شروع با(سطر، "RETR "):
            شماره := سطر.زیررشته(۵، سطر.طول() - ۵).به صحیح()
            _ := تی سی پی.نوشتن(ا، "+OK\r\n" + نامه‌ها[شماره - ۱] + "\r\n.\r\n")
        وگرنه:
            _ := تی سی پی.نوشتن(ا، "+OK\r\n")
        پایان
        سطر = سطر بعدی(ا، انباشته)
    پایان
    _ := تی سی پی.نوشتن(ا، "+OK bye\r\n")
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(سرور پاپ)
    ناپایا ک := پست الکترونیک.اتصال پاپ۳("127.0.0.1"، تی سی پی.درگاه(سرور))
    اگر وارونه (ک.سالم و پست الکترونیک.کاربر(ک، "sara") و پست الکترونیک.گذرواژه(ک، "secret")):
        سرچاپ "ورود شکست خورد"
        برگشت ۱
    پایان
    سرچاپ "وضعیت:"، پست الکترونیک.وضعیت(ک)
    هر مورد در پست الکترونیک.فهرست پیام‌های پاپ۳(ک):
        تکه‌ها := رشته.تفکیک کردن(مورد، " ")
        شماره := تکه‌ها[۰].به صحیح()
        متن := پست الکترونیک.دریافت پیام پاپ۳(ک، شماره)
        موضوع := رشته.تفکیک کردن(متن، "\r\n")[۰]
        سرچاپ "نامه"، شماره، "(" + تکه‌ها[۱] + " بایت):"، موضوع
    پایان
    سرچاپ "سطر آخر نامه‌ی ۲:"، رشته.تفکیک کردن(پست الکترونیک.دریافت پیام پاپ۳(ک، ۲)، "\r\n")[۳]
    سرچاپ "حذف ۱:"، پست الکترونیک.حذف(ک، ۱)
    پست الکترونیک.خروج پاپ۳(ک)
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور)
    برگشت ۰
پایان
