واردسازی شبکه.پست الکترونیک
واردسازی شبکه.تی سی پی

ناپایا سرور := تی سی پی.سرور {}
ناپایا دیده‌ها := وکتور {} برگردان وکتور<رشته>

تابع سطر بعدی(ا: تی سی پی.اتصال شبکه، انباشته &: رشته): رشته:
    تا انباشته.بیاب("\r\n") کوچکتر ۰:
        انباشته += تی سی پی.خواندن(ا، ۴۰۹۶)
    پایان
    جا := انباشته.بیاب("\r\n")
    سطر := انباشته.زیررشته(۰، جا)
    انباشته = انباشته.زیررشته(جا + ۲، انباشته.طول() - جا - ۲)
    برگشت سطر
پایان

تابع سرور نامه():
    ا := تی سی پی.پذیرش(سرور)
    ناپایا انباشته := ""
    _ := تی سی پی.نوشتن(ا، "220 mail.test ready\r\n")
    ناپایا باز := درست
    تا باز:
        سطر := سطر بعدی(ا، انباشته)
        دیده‌ها.بیفزا(سطر)
        اگر سطر برابر "DATA":
            _ := تی سی پی.نوشتن(ا، "354 end with a dot\r\n")
            ناپایا متن := سطر بعدی(ا، انباشته)
            تا متن نابرابر ".":
                متن = سطر بعدی(ا، انباشته)
            پایان
            _ := تی سی پی.نوشتن(ا، "250 queued as 1001\r\n")
        وگرنه سطر برابر "QUIT":
            _ := تی سی پی.نوشتن(ا، "221 bye\r\n")
            باز = نادرست
        وگرنه:
            _ := تی سی پی.نوشتن(ا، "250 ok\r\n")
        پایان
    پایان
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(سرور نامه)
    ناپایا ک := پست الکترونیک.اتصال اس‌ام‌تی‌پی("127.0.0.1"، تی سی پی.درگاه(سرور))
    سرچاپ "وصل شد:"، ک.سالم
    _ := پست الکترونیک.سلام(ک، "shop.test")
    _ := پست الکترونیک.فرستنده(ک، "orders@shop.test")
    هر گیرنده در ["sara@example.com"، "reza@example.com"]:
        _ := پست الکترونیک.گیرنده(ک، گیرنده)
    پایان
    پیام := پست الکترونیک.ساخت پیام("orders@shop.test"، "sara@example.com, reza@example.com"، "Order 1001"، "سفارش شما فرستاده شد."، "")
    سرچاپ "پذیرفته شد:"، پست الکترونیک.داده(ک، پیام)، ک.آخرین پاسخ.پیراست()
    پست الکترونیک.خروج اس‌ام‌تی‌پی(ک)
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور)
    سرچاپ "آنچه سرور دید:"
    هر سطر در دیده‌ها:
        سرچاپ " "، سطر
    پایان
پایان
