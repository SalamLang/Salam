واردسازی شبکه.فست سی جی آی
واردسازی شبکه.تی سی پی

تابع ریشه:
    ناپایا پ := فست سی جی آی.پارامترهای جدید()
    دیرکن فست سی جی آی.آزادسازی(پ)
    فست سی جی آی.افزودن(پ، "GATEWAY_INTERFACE"، "CGI/1.1")
    فست سی جی آی.افزودن(پ، "REQUEST_METHOD"، "GET")
    فست سی جی آی.افزودن(پ، "SCRIPT_NAME"، "/index.php")
    فست سی جی آی.افزودن(پ، "SCRIPT_FILENAME"، "/srv/app/index.php")
    فست سی جی آی.افزودن(پ، "QUERY_STRING"، "a=1")

    ا := فست سی جی آی.اتصال("127.0.0.1"، ۹۰۰۰، ۳۰۰۰)
    اگر وارونه تی سی پی.اتصال معتبر(ا):
        سرچاپ "php-fpm is not listening on 127.0.0.1:9000"
        برگشت ۱
    پایان
    دیرکن تی سی پی.بستن(ا)

    ناپایا پاسخ := فست سی جی آی.اجرا(ا، پ، پوچ، ۰، ۵۰۰۰)
    اگر وارونه پاسخ.موفق:
        سرچاپ "failed:"، پاسخ.خطا
        برگشت ۱
    پایان
    سرچاپ پاسخ.وضعیت، پاسخ.اندازه، "bytes"
    هر س در پاسخ.سرصفحه ها:
        سرچاپ س.نام + ": " + س.مقدار
    پایان
    فست سی جی آی.آزادسازی پاسخ(پاسخ)
پایان
