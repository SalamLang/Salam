واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری
واردسازی تبدیل

ناپایا کتاب‌ها := وکتور {} برگردان وکتور<کتاب>

ساختار کتاب:
    @جیسون "id"
    همگانی شناسه: صحیح = ۰
    @جیسون "title"
    همگانی عنوان: رشته = ""
پایان

تابع فهرست(ز: صحیح۶۴):
    اچ تی تی پی.جیسون(ز، جیسون.سریال سازی(کتاب‌ها))
پایان

تابع نمایش(ز: صحیح۶۴):
    شماره := تبدیل.رشته به عدد(اچ تی تی پی.پارامتر(ز، "id"))
    هر ک در کتاب‌ها:
        اگر ک.شناسه برابر شماره:
            اچ تی تی پی.جیسون(ز، جیسون.سریال سازی(ک))
            برگشت
        پایان
    پایان
    اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۴)
    اچ تی تی پی.جیسون(ز، `{"error":"چنین کتابی نیست"}`)
پایان

تابع ساختن(ز: صحیح۶۴):
    ناپایا ک := کتاب {}
    ناپایا خ := خطای کدگذاری.بدون خطا()
    اگر وارونه جیسون.واسریال سازی آسان گیر(اچ تی تی پی.بدنه(ز)، ک، خ):
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۰)
        اچ تی تی پی.جیسون(ز، "{" + جیسون.عضو("error"، خ.پیام) + "}")
        برگشت
    پایان
    ک.شناسه = کتاب‌ها.طول() + ۱
    کتاب‌ها.بیفزا(ک)
    اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۱)
    اچ تی تی پی.تنظیم سرصفحه(ز، "Location"، "/books/" + ک.شناسه)
    اچ تی تی پی.جیسون(ز، جیسون.سریال سازی(ک))
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/books"، فهرست)
    مسیریاب.دریافت(م، "/books/:id"، نمایش)
    مسیریاب.ارسال(م، "/books"، ساختن)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۸۱)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19781"
    پ := اچ تی تی پی.ارسال(پایه + "/books"، `{"title": "شازده کوچولو"}`)
    سرچاپ اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.دریافت سرصفحه(پ، "location")، اچ تی تی پی.بدنه(پ)
    _ := اچ تی تی پی.ارسال(پایه + "/books"، `{"title": "مثنوی"}`)
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.دریافت(پایه + "/books"))
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.دریافت(پایه + "/books/2"))
    نبود := اچ تی تی پی.دریافت(پایه + "/books/9")
    سرچاپ اچ تی تی پی.وضعیت(نبود)، اچ تی تی پی.بدنه(نبود)
    بد := اچ تی تی پی.ارسال(پایه + "/books"، `{"title": 7}`)
    سرچاپ اچ تی تی پی.وضعیت(بد)، اچ تی تی پی.بدنه(بد)
پایان
