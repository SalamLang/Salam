واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی کدگذاری.جیسون

تابع ساخت تیکت(ز: صحیح۶۴):
    نوع محتوا := اچ تی تی پی.سرصفحه(ز، "Content-Type")
    اگر نوع محتوا != "application/json":
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۱۵)
        اچ تی تی پی.جیسون(ز، "{\"error\":\"expected JSON, got " + نوع محتوا + "\"}")
        برگشت
    پایان
    عنوان := جیسون.دریافت(اچ تی تی پی.بدنه(ز)، "title")
    اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۱)
    اچ تی تی پی.جیسون(ز، "{\"id\":31,\"title\":" + جیسون.رشته جیسون(عنوان) + "}")
پایان

تابع تیکت‌های قدیمی(ز: صحیح۶۴): اچ تی تی پی.تغییرمسیر(ز، "/v2/tickets") پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/tickets"، ساخت تیکت)
    مسیریاب.دریافت(م، "/tickets"، تیکت‌های قدیمی)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۸۶۳۲)
    اچ تی تی پی.تنظیم میزبان(س، "127.0.0.1")
    اچ تی تی پی.استفاده(س، م)
    اگر وارونه اچ تی تی پی.اجرا در پس زمینه(س):
        سرچاپ "درگاه ۱۸۶۳۲ گرفته است"
        برگشت ۱
    پایان
    پایه := "http://127.0.0.1:18632"
    بدنه := `{"title": "کاغذ چاپگر تمام شده"}`

    ساده := اچ تی تی پی.ارسال(پایه + "/tickets"، بدنه)
    سرچاپ "ارسال:"، اچ تی تی پی.وضعیت(ساده)، اچ تی تی پی.بدنه(ساده)

    ناپایا سرها := اچ تی تی پی.سرصفحه جدید()
    سرها.درج("Content-Type"، "application/json")
    ساخته := اچ تی تی پی.ارسال با(پایه + "/tickets"، بدنه، سرها)
    سرچاپ "ارسال با:"، اچ تی تی پی.وضعیت(ساخته)، اچ تی تی پی.موفق(ساخته)، "شناسه"، جیسون.دریافت عدد(اچ تی تی پی.بدنه(ساخته)، "id")

    جابه‌جا := اچ تی تی پی.دریافت(پایه + "/tickets")
    سرچاپ "دریافت:"، اچ تی تی پی.وضعیت(جابه‌جا)، "Location:"، اچ تی تی پی.دریافت سرصفحه(جابه‌جا، "location")

    خاموش := اچ تی تی پی.دریافت("http://127.0.0.1:1/tickets")
    سرچاپ "سرور خاموش:"، اچ تی تی پی.وضعیت(خاموش)، اچ تی تی پی.موفق(خاموش)، اچ تی تی پی.خطا(خاموش)
    برگشت ۰
پایان
