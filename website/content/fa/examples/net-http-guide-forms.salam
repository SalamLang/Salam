واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی قالب

ناپایا پیام‌ها := وکتور {} برگردان وکتور<رشته>

تابع تابلو(ز: صحیح۶۴):
    ناپایا صفحه := "<ul>"
    هر پیام در پیام‌ها:
        صفحه = صفحه + "<li>" + قالب.گریز اچ تی ام ال(پیام) + "</li>"
    پایان
    اچ تی تی پی.اچ تی ام ال(ز، صفحه + "</ul>")
پایان

تابع نوشتن(ز: صحیح۶۴):
    نام := اچ تی تی پی.فرم(ز، "name")
    متن := اچ تی تی پی.فرم(ز، "text")
    اگر نام برابر "" یا متن برابر "":
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۰)
        اچ تی تی پی.متن(ز، "نام و متن هر دو لازم‌اند")
        برگشت
    پایان
    پیام‌ها.بیفزا(نام + ": " + متن)
    اچ تی تی پی.تغییرمسیر(ز، "/board")
پایان

تابع جستجو(ز: صحیح۶۴):
    واژه := اچ تی تی پی.پرسمان(ز، "q")
    ناپایا تعداد := ۰
    هر پیام در پیام‌ها:
        اگر پیام.بیاب(واژه) بزرگتربرابر ۰:
            تعداد += ۱
        پایان
    پایان
    اچ تی تی پی.متن(ز، "«" + واژه + "» در " + تعداد + " پیام پیدا شد")
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/board"، تابلو)
    مسیریاب.ارسال(م، "/board"، نوشتن)
    مسیریاب.دریافت(م، "/search"، جستجو)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۸۲)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19782"
    ناپایا فرم := اچ تی تی پی.سرصفحه جدید()
    فرم.درج("name"، "سارا")
    فرم.درج("text"، "ساعت ۵ می‌بینمت و چای & شیرینی بیاور")
    ناپایا سر := اچ تی تی پی.سرصفحه جدید()
    سر.درج("Content-Type"، "application/x-www-form-urlencoded")
    پ := اچ تی تی پی.ارسال با(پایه + "/board"، اچ تی تی پی.کدگذاری فرم(فرم)، سر)
    سرچاپ اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.دریافت سرصفحه(پ، "location")
    ناقص := اچ تی تی پی.ارسال با(پایه + "/board"، "name=Reza"، سر)
    سرچاپ اچ تی تی پی.وضعیت(ناقص)، اچ تی تی پی.بدنه(ناقص)
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.دریافت(پایه + "/board"))
    ناپایا پرسش := اچ تی تی پی.سرصفحه جدید()
    پرسش.درج("q"، "چای")
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.دریافت(اچ تی تی پی.با پرسمان(پایه + "/search"، پرسش)))
پایان
