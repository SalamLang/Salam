واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع وارد شده(ز: صحیح۶۴): منطقی:
    اگر اچ تی تی پی.سرصفحه(ز، "Authorization") برابر "Bearer s3cret":
        برگشت درست
    پایان
    اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۱)
    اچ تی تی پی.تنظیم سرصفحه(ز، "WWW-Authenticate"، "Bearer")
    اچ تی تی پی.جیسون(ز، `{"error":"اول وارد شوید"}`)
    برگشت نادرست
پایان

تابع سلامت(ز: صحیح۶۴):
    اچ تی تی پی.متن(ز، "ok")
پایان

تابع نمایه(ز: صحیح۶۴):
    اگر وارونه وارد شده(ز): برگشت پایان
    اچ تی تی پی.جیسون(ز، `{"user":"maryam"}`)
پایان

تابع پاک کردن(ز: صحیح۶۴):
    اگر وارونه وارد شده(ز): برگشت پایان
    اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۴)
    اچ تی تی پی.متن(ز، "")
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/health"، سلامت)
    مسیریاب.گروه(م، "/api/v1"، "GET"، "/profile"، نمایه)
    مسیریاب.گروه(م، "/api/v1"، "DELETE"، "/posts/:id"، پاک کردن)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۸۳)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19783"
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.دریافت(پایه + "/health"))
    پ := اچ تی تی پی.دریافت(پایه + "/api/v1/profile")
    سرچاپ اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.دریافت سرصفحه(پ، "www-authenticate")، اچ تی تی پی.بدنه(پ)
    ناپایا مجوز := اچ تی تی پی.سرصفحه جدید()
    مجوز.درج("Authorization"، "Bearer s3cret")
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.دریافت با(پایه + "/api/v1/profile"، مجوز))
    سرچاپ اچ تی تی پی.وضعیت(اچ تی تی پی.حذف با(پایه + "/api/v1/posts/3"، مجوز))
    سرچاپ اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت(پایه + "/profile"))
پایان
