واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا سرور := تی سی پی.سرور {}

تابع پشتیبان():
    تکرار ۶:
        اتصال := تی سی پی.پذیرش(سرور)
        درخواست := تی سی پی.خواندن(اتصال، ۴۰۹۶)
        اگر درخواست.بیاب("GET /old ") برابر ۰:
            _ := تی سی پی.نوشتن(اتصال، "HTTP/1.1 302 Found\r\nLocation: /new\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
        وگرنه درخواست.بیاب("GET /silent ") برابر ۰:
            همگام سازی.خواب میلی ثانیه(۷۰۰)
        وگرنه درخواست.بیاب("GET /big ") برابر ۰:
            تی سی پی.نوشتن اچ تی تی پی(اتصال، "200 OK"، "text/plain"، "0123456789")
        وگرنه:
            تی سی پی.نوشتن اچ تی تی پی(اتصال، "200 OK"، "text/plain"، "landed")
        پایان
        تی سی پی.بستن(اتصال)
    پایان
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(پشتیبان)
    پایه := "http://127.0.0.1:" + تی سی پی.درگاه(سرور)
    ناپایا کارخواه := اچ تی تی پی.کارخواه جدید()
    کارخواه.تنظیم سقف تغییر مسیر(۳)
    کارخواه.تنظیم مهلت(۵۰۰۰)
    کارخواه.تنظیم مهلت بیکاری(۲۰۰۰)
    کارخواه.تنظیم سقف بدنه(۱۰۰۰)
    پاسخ := کارخواه.دریافت(پایه + "/old")
    سرچاپ پاسخ.وضعیت، اچ تی تی پی.بدنه(پاسخ)، پاسخ.نشانی.بیاب("/new") بزرگتر ۰
    ناپایا تنگ := اچ تی تی پی.گزینه های درخواست {}
    تنگ.حداکثر‌بدنه = ۵
    بزرگ := اچ تی تی پی.انجام درخواست("GET"، پایه + "/big"، اچ تی تی پی.سرصفحه جدید()، ""، تنگ)
    سرچاپ بزرگ.وضعیت، بزرگ.خطا
    ناپایا سریع := اچ تی تی پی.گزینه های درخواست {}
    سریع.میلی‌ثانیه‌زمان‌انتظار = ۲۰۰
    ساکت := اچ تی تی پی.انجام درخواست("GET"، پایه + "/silent"، اچ تی تی پی.سرصفحه جدید()، ""، سریع)
    سرچاپ ساکت.وضعیت، ساکت.خطا
    خام := کارخواه.درخواست بایتی("GET"، پایه + "/big"، ""، "")
    سرچاپ خام.وضعیت، خام.بدنه.طول
    سرچاپ کارخواه.درخواست خام("GET"، پایه + "/new"، "X-Id: 1\r\n"، "").وضعیت
    کارخواه.آزادسازی()
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور)
پایان
