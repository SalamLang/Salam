واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی سیستم عامل
واردسازی تبدیل

تابع خانه(ز: صحیح۶۴):
    اچ تی تی پی.اچ تی ام ال(ز، "<h1>سلام</h1>")
پایان

تابع سلامت(ز: صحیح۶۴):
    اچ تی تی پی.جیسون(ز، `{"status":"ok"}`)
پایان

تابع ریشه:
    درگاه := تبدیل.رشته به عدد با پیش فرض(سیستم عامل.متغیر محیطی("PORT")، ۸۰۸۰)
    اچ تی تی پی.بیشینه بایت بدنه(۱۰۴۸۵۷۶)
    اچ تی تی پی.تنظیم بیکاری زنده نگه داشتن(۵۰۰۰)
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/"، خانه)
    مسیریاب.دریافت(م، "/health"، سلامت)
    مسیریاب.ایستا(م، "/assets"، "public")
    ناپایا س := اچ تی تی پی.سرور جدید(درگاه)
    اچ تی تی پی.تنظیم میزبان(س، "0.0.0.0")
    اچ تی تی پی.پنهان سازی توکن(س)
    اچ تی تی پی.فعال سازی گزارش دسترسی(س)
    اچ تی تی پی.استفاده(س، م)
    سرچاپ "گوش دادن روی درگاه " + درگاه
    اچ تی تی پی.اجرا(س)
پایان
