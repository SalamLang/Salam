واردسازی شبکه.مسیریاب
واردسازی سیستم عامل

تابع ریشه:
    _ := سیستم عامل.ساخت پوشه ها("public/css")
    _ := سیستم عامل.نوشتن پرونده("public/index.html"، "<h1>خوش آمدید</h1>")
    _ := سیستم عامل.نوشتن پرونده("public/css/site.css"، "body { margin: 0 }")
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ایستا(م، "/site"، "public")
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۸۴)
    اچ تی تی پی.پنهان سازی توکن(س)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19784"
    صفحه := اچ تی تی پی.دریافت(پایه + "/site/index.html")
    سرچاپ اچ تی تی پی.وضعیت(صفحه)، اچ تی تی پی.دریافت سرصفحه(صفحه، "content-type")، اچ تی تی پی.بدنه(صفحه)
    سبک := اچ تی تی پی.دریافت(پایه + "/site/css/site.css")
    سرچاپ اچ تی تی پی.دریافت سرصفحه(سبک، "content-type")، اچ تی تی پی.بدنه(سبک)
    سرچاپ اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت(پایه + "/site/missing.png"))
    سرچاپ اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت(پایه + "/site/../secret.txt"))
    سرچاپ اچ تی تی پی.دریافت سرصفحه(صفحه، "server")
