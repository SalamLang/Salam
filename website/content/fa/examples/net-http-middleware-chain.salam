واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.میان افزار
واردسازی شبکه.مسیریاب

تابع سرآیند صفحه(ز: صحیح۶۴):
    میان افزار.امن(ز)
    میان افزار.بدون کش(ز)
پایان

تابع سرآیند فایل(ز: صحیح۶۴، ثانیه: صحیح):
    میان افزار.کش(ز، ثانیه)
پایان

تابع حساب(ز: صحیح۶۴):
    سرآیند صفحه(ز)
    اچ تی تی پی.اچ تی ام ال(ز، "<h1>حساب شما</h1>")
پایان

تابع نشان(ز: صحیح۶۴):
    سرآیند فایل(ز، ۸۶۴۰۰)
    اچ تی تی پی.متن(ز، "logo bytes")
پایان

تابع اخبار(ز: صحیح۶۴):
    سرآیند فایل(ز، ۶۰)
    اچ تی تی پی.جیسون(ز، `["نسخه 0.5.5"]`)
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/account"، حساب)
    مسیریاب.دریافت(م، "/logo.svg"، نشان)
    مسیریاب.دریافت(م، "/news.json"، اخبار)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۸۶)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19786"
    هر مسیر در ["/account"، "/logo.svg"، "/news.json"]:
        پ := اچ تی تی پی.دریافت(پایه + مسیر)
        سرچاپ مسیر + " cache-control=" + اچ تی تی پی.دریافت سرصفحه(پ، "cache-control") + " frame=" + اچ تی تی پی.دریافت سرصفحه(پ، "x-frame-options")
    پایان
پایان
