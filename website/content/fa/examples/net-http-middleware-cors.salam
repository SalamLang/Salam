واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.میان افزار
واردسازی شبکه.مسیریاب

تابع پیش پرواز(ز: صحیح۶۴):
    میان افزار.اجازه به همه(ز)
    اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۴)
    اچ تی تی پی.متن(ز، "")
پایان

تابع یادداشت‌ها(ز: صحیح۶۴):
    میان افزار.اجازه به همه(ز)
    میان افزار.بدون کش(ز)
    اچ تی تی پی.جیسون(ز، `[{"id":1,"text":"نان بخر"}]`)
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.گزینه ها(م، "/api/notes"، پیش پرواز)
    مسیریاب.دریافت(م، "/api/notes"، یادداشت‌ها)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۸۵)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    نشانی := "http://127.0.0.1:19785/api/notes"
    ناپایا سر := اچ تی تی پی.سرصفحه جدید()
    سر.درج("Origin"، "https://app.example.com")
    سر.درج("Access-Control-Request-Method"، "GET")
    پ := اچ تی تی پی.گزینه ها با(نشانی، سر)
    سرچاپ "پیش پرواز:"، اچ تی تی پی.وضعیت(پ)
    هر نام در ["access-control-allow-origin"، "access-control-allow-methods"، "access-control-allow-headers"]:
        سرچاپ "  " + نام + ": " + اچ تی تی پی.دریافت سرصفحه(پ، نام)
    پایان
    د := اچ تی تی پی.دریافت با(نشانی، سر)
    سرچاپ "دریافت:"، اچ تی تی پی.وضعیت(د)، اچ تی تی پی.بدنه(د)
    سرچاپ "  cache-control: " + اچ تی تی پی.دریافت سرصفحه(د، "cache-control")
    سرچاپ "  pragma: " + اچ تی تی پی.دریافت سرصفحه(د، "pragma")
پایان
