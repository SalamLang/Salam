واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.میان افزار
واردسازی شبکه.مسیریاب

تابع اجازه به مبدا(ز: صحیح۶۴، مبدا: رشته):
    اگر اچ تی تی پی.سرصفحه(ز، "Origin") برابر مبدا:
        اچ تی تی پی.تنظیم سرصفحه(ز، "Access-Control-Allow-Origin"، مبدا)
        اچ تی تی پی.تنظیم سرصفحه(ز، "Vary"، "Origin")
    پایان
پایان

تابع جیسون لازم(ز: صحیح۶۴): منطقی:
    اگر اچ تی تی پی.سرصفحه(ز، "Content-Type").شروع با("application/json"):
        برگشت درست
    پایان
    اچ تی تی پی.تنظیم وضعیت(ز، ۴۱۵)
    اچ تی تی پی.جیسون(ز، `{"error":"جیسون بفرستید"}`)
    برگشت نادرست
پایان

تابع ثبت سفارش(ز: صحیح۶۴):
    میان افزار.امن(ز)
    اجازه به مبدا(ز، "https://shop.example.com")
    اگر وارونه جیسون لازم(ز): برگشت پایان
    اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۱)
    اچ تی تی پی.جیسون(ز، اچ تی تی پی.بدنه(ز))
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/orders"، ثبت سفارش)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۸۷)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    نشانی := "http://127.0.0.1:19787/orders"
    ناپایا سرآیند مجاز := اچ تی تی پی.سرصفحه جدید()
    سرآیند مجاز.درج("Origin"، "https://shop.example.com")
    سرآیند مجاز.درج("Content-Type"، "application/json")
    پ := اچ تی تی پی.ارسال با(نشانی، `{"item":"چای"}`، سرآیند مجاز)
    سرچاپ اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.بدنه(پ)، "[" + اچ تی تی پی.دریافت سرصفحه(پ، "access-control-allow-origin") + "]"
    ناپایا بیگانه := اچ تی تی پی.سرصفحه جدید()
    بیگانه.درج("Origin"، "https://evil.example")
    بیگانه.درج("Content-Type"، "text/plain")
    ب := اچ تی تی پی.ارسال با(نشانی، "item=tea"، بیگانه)
    سرچاپ اچ تی تی پی.وضعیت(ب)، اچ تی تی پی.بدنه(ب)، "[" + اچ تی تی پی.دریافت سرصفحه(ب، "access-control-allow-origin") + "]"
پایان
