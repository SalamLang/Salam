واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.میان افزار
واردسازی شبکه.مسیریاب

تابع سخت‌گیرانه(ز: صحیح۶۴):
    میان افزار.امن(ز)
    اچ تی تی پی.تنظیم سرصفحه(ز، "Content-Security-Policy"، "default-src 'self'")
    اچ تی تی پی.تنظیم سرصفحه(ز، "Strict-Transport-Security"، "max-age=31536000")
    اچ تی تی پی.تنظیم سرصفحه(ز، "Referrer-Policy"، "same-origin")
پایان

تابع فاکتور(ز: صحیح۶۴):
    سخت‌گیرانه(ز)
    میان افزار.بدون کش(ز)
    اچ تی تی پی.اچ تی ام ال(ز، "<h1>فاکتور ۱۰۴۲</h1>")
پایان

تابع گزارش(ز: صحیح۶۴):
    میان افزار.بدون کش(ز)
    میان افزار.کش(ز، ۳۰۰)
    اچ تی تی پی.متن(ز، "گزارش ماهانه")
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/invoice"، فاکتور)
    مسیریاب.دریافت(م، "/report"، گزارش)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۸۶۴۲)
    اچ تی تی پی.تنظیم میزبان(س، "127.0.0.1")
    اچ تی تی پی.استفاده(س، م)
    اگر وارونه اچ تی تی پی.اجرا در پس زمینه(س):
        سرچاپ "درگاه ۱۸۶۴۲ گرفته است"
        برگشت ۱
    پایان
    الف := اچ تی تی پی.دریافت("http://127.0.0.1:18642/invoice")
    هر نام در ["x-frame-options"، "content-security-policy"، "strict-transport-security"، "referrer-policy"]:
        سرچاپ نام + ": " + اچ تی تی پی.دریافت سرصفحه(الف، نام)
    پایان
    ب := اچ تی تی پی.دریافت("http://127.0.0.1:18642/report")
    سرچاپ "سطرهای cache-control در /report:"، اچ تی تی پی.مقادیر سرصفحه(ب، "cache-control")
    برگشت ۰
پایان
