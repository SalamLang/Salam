واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.تی سی پی
واردسازی کدگذاری.جیسون

ناپایا سرور := تی سی پی.سرور {}

ساختار رابط:
    همگانی نشانی: اچ تی تی پی.نقطه پایانی = اچ تی تی پی.نقطه پایانی {}
    همگانی توکن: رشته = ""

    همگانی تابع خواندن مسیر(مسیر: رشته): رشته:
        ناپایا سر := "GET " + مسیر + " HTTP/1.1\r\n"
        سر += "Host: " + این.نشانی.میزبان + "\r\n"
        سر += "Authorization: Bearer " + این.توکن + "\r\n"
        سر += "Accept: application/json\r\n"
        سر += "Connection: close\r\n\r\n"
        ناپایا خام := اچ تی تی پی.ارسال خام با مهلت(این.نشانی، سر، پوچ، ۰، ۵۰۰۰)
        دیرکن اچ تی تی پی.آزادسازی پاسخ خام(خام)
        برگشت اچ تی تی پی.متن پاسخ خام(خام)
    پایان
پایان

تابع پشتیبان():
    تکرار ۲:
        ا := تی سی پی.پذیرش(سرور)
        درخواست := تی سی پی.خواندن(ا، ۴۰۹۶)
        اگر درخواست.بیاب("GET /users/7 ") برابر ۰:
            تی سی پی.نوشتن اچ تی تی پی(ا، "200 OK"، "application/json; charset=utf-8"، `{"id": 7, "name": "سارا", "city": "شیراز"}`)
        وگرنه:
            تی سی پی.نوشتن اچ تی تی پی(ا، "200 OK"، "application/json; charset=utf-8"، `[{"item": "خودکار", "qty": 3}, {"item": "دفتر", "qty": 1}]`)
        پایان
        تی سی پی.بستن(ا)
    پایان
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(پشتیبان)
    رابط برنامه := رابط { نشانی = اچ تی تی پی.تجزیه نقطه پایانی("http://127.0.0.1:" + تی سی پی.درگاه(سرور))، توکن = "abc123" }
    کاربر := رابط برنامه.خواندن مسیر("/users/7")
    سرچاپ جیسون.دریافت(کاربر، "name")، "از"، جیسون.دریافت(کاربر، "city")
    سفارش‌ها := رابط برنامه.خواندن مسیر("/users/7/orders")
    هر سفارش در جیسون.اقلام(سفارش‌ها):
        سرچاپ " "، جیسون.دریافت عدد(سفارش، "qty")، "عدد"، جیسون.دریافت(سفارش، "item")
    پایان
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور)
پایان
