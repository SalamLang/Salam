واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.تی سی پی
واردسازی حافظه
واردسازی تبدیل

ناپایا سرور := تی سی پی.سرور {}

تابع پرونده‌ها():
    ا := تی سی پی.پذیرش(سرور)
    _ := تی سی پی.خواندن(ا، ۴۰۹۶)
    تصویر := [۱۳۷، ۸۰، ۷۸، ۷۱، ۱۳، ۱۰، ۲۶، ۱۰، ۰، ۰، ۰، ۱۳]
    بافر := حافظه.تخصیص(۱۲ برگردان طبیعی۶۴) برگردان طبیعی۸*
    تکرار ۱۲ در ی:
        بافر[ی] = تصویر[ی] برگردان طبیعی۸
    پایان
    _ := تی سی پی.نوشتن(ا، "HTTP/1.1 200 OK\r\nContent-Type: image/png\r\nContent-Length: 12\r\nConnection: close\r\n\r\n")
    _ := تی سی پی.نوشتن بایت(ا، بافر برگردان تهی*، ۱۲)
    حافظه.آزادسازی(بافر برگردان تهی*)
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(پرونده‌ها)
    نشانی := اچ تی تی پی.تجزیه نقطه پایانی("http://127.0.0.1:" + تی سی پی.درگاه(سرور))
    سر := "GET /logo.png HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
    ناپایا پ := اچ تی تی پی.ارسال خام با مهلت(نشانی، سر، پوچ، ۰، ۵۰۰۰)
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور)
    سرچاپ پ.موفق، پ.وضعیت، اچ تی تی پی.مقدار سرصفحه(پ.سرصفحه، "content-type")
    سرچاپ "بایت‌های رسیده:"، پ.اندازه
    بایت‌ها := پ.داده برگردان طبیعی۸*
    ناپایا شانزدهی := ""
    تکرار پ.اندازه در ی:
        اگر ی بزرگتر ۰: شانزدهی += " " پایان
        اگر بایت‌ها[ی] کوچکتر ۱۶: شانزدهی += "0" پایان
        شانزدهی += تبدیل.قالب شانزده(بایت‌ها[ی] برگردان طبیعی۶۴)
    پایان
    سرچاپ شانزدهی
    سرچاپ "PNG است:"، پ.اندازه بزرگتربرابر ۴ و بایت‌ها[۱] برگردان صحیح برابر ۸۰ و بایت‌ها[۲] برگردان صحیح برابر ۷۸ و بایت‌ها[۳] برگردان صحیح برابر ۷۱
    سرچاپ "متن پاسخ خام فقط"، اچ تی تی پی.متن پاسخ خام(پ).طول()، "بایت نگه می‌دارد"
    اچ تی تی پی.آزادسازی پاسخ خام(پ)
پایان
