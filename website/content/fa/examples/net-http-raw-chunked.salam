واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.تی سی پی

ناپایا سرور := تی سی پی.سرور {}

تابع خبرنامه():
    تکرار ۲ در ی:
        ا := تی سی پی.پذیرش(سرور)
        _ := تی سی پی.خواندن(ا، ۴۰۹۶)
        اگر ی کوچکتر ۱:
            _ := تی سی پی.نوشتن(ا، "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nTransfer-Encoding: chunked\r\n\r\n6\r\nnews: \r\n9\r\nall quiet\r\n0\r\n\r\n")
        وگرنه:
            _ := تی سی پی.خواندن(ا، ۴۰۹۶)
        پایان
        تی سی پی.بستن(ا)
    پایان
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(خبرنامه)
    نشانی := اچ تی تی پی.تجزیه نقطه پایانی("http://127.0.0.1:" + تی سی پی.درگاه(سرور))
    سر := "GET /feed HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"

    ناپایا خام := اچ تی تی پی.ارسال خام با مهلت(نشانی، سر، پوچ، ۰، ۲۰۰۰)
    سرچاپ "بدنه:"، اچ تی تی پی.متن پاسخ خام(خام)
    اچ تی تی پی.آزادسازی پاسخ خام(خام)

    ناپایا کند := اچ تی تی پی.ارسال خام با مهلت(نشانی، سر، پوچ، ۰، ۳۰۰)
    سرچاپ "سرور خاموش:"، کند.موفق، کند.وضعیت، کند.خطا
    اچ تی تی پی.آزادسازی پاسخ خام(کند)
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور)
