واردسازی شبکه.اچ تی تی پی
واردسازی کدگذاری.جیسون

تابع ریشه:
    نشانی := اچ تی تی پی.تجزیه نقطه پایانی("https://api.github.com")
    سرچاپ نشانی.میزبان، نشانی.درگاه، نشانی.امن
    ناپایا سر := "GET /repos/SalamLang/Salam HTTP/1.1\r\n"
    سر += "Host: api.github.com\r\n"
    سر += "User-Agent: salam-example\r\n"
    سر += "Accept: application/vnd.github+json\r\n"
    سر += "Connection: close\r\n\r\n"
    ناپایا پ := اچ تی تی پی.ارسال خام با مهلت(نشانی، سر، پوچ، ۰، ۱۰۰۰۰)
    دیرکن اچ تی تی پی.آزادسازی پاسخ خام(پ)
    بدنه := اچ تی تی پی.متن پاسخ خام(پ)
    اگر پ.وضعیت برابر ۰:
        سرچاپ "درخواست شکست خورد:"، پ.خطا
        برگشت ۱
    پایان
    سرچاپ "وضعیت:"، پ.وضعیت
    سرچاپ "سهمیه‌ی باقی‌مانده:"، اچ تی تی پی.مقدار سرصفحه(پ.سرصفحه، "x-ratelimit-remaining")
    اگر پ.موفق:
        سرچاپ جیسون.دریافت(بدنه، "full_name")، "به زبان"، جیسون.دریافت(بدنه، "language")، "نوشته شده است"
    پایان
    برگشت ۰
پایان
