واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.تی سی پی
واردسازی کدگذاری.جیسون

ناپایا سرور := تی سی پی.سرور {}

تابع خواندن درخواست(ا: تی سی پی.اتصال شبکه): رشته:
    ناپایا رسیده := تی سی پی.خواندن(ا، ۴۰۹۶)
    تا رسیده.بیاب("\r\n\r\n") کوچکتر ۰:
        رسیده += تی سی پی.خواندن(ا، ۴۰۹۶)
    پایان
    انتهای سر := رسیده.بیاب("\r\n\r\n") + ۴
    اندازه := اچ تی تی پی.مقدار سرصفحه(رسیده، "content-length").به صحیح()
    تا رسیده.طول() کوچکتر انتهای سر + اندازه:
        رسیده += تی سی پی.خواندن(ا، ۴۰۹۶)
    پایان
    برگشت رسیده
پایان

تابع رابط برنامه():
    ا := تی سی پی.پذیرش(سرور)
    درخواست := خواندن درخواست(ا)
    جا := درخواست.بیاب("\r\n\r\n") + ۴
    بدنه := درخواست.زیررشته(جا، درخواست.طول() - جا)
    نام := جیسون.دریافت(بدنه، "name")
    مجوز := اچ تی تی پی.مقدار سرصفحه(درخواست، "authorization")
    پاسخ := "{\"id\": 7, \"name\": \"" + نام + "\", \"auth\": \"" + مجوز + "\"}"
    سر := "HTTP/1.1 201 Created\r\nContent-Type: application/json\r\nLocation: /users/7\r\nContent-Length: " + پاسخ.طول() + "\r\nConnection: close\r\n\r\n"
    _ := تی سی پی.نوشتن(ا، سر + پاسخ)
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    ک := نخ‌ساز(رابط برنامه)
    نشانی := اچ تی تی پی.تجزیه نقطه پایانی("http://127.0.0.1:" + تی سی پی.درگاه(سرور))
    بدنه := `{"name": "سارا", "role": "editor"}`
    ناپایا سر := "POST /users HTTP/1.1\r\n"
    سر += "Host: 127.0.0.1\r\n"
    سر += "Authorization: Bearer abc123\r\n"
    سر += "Content-Type: application/json\r\n"
    سر += "Content-Length: " + بدنه.طول() + "\r\n"
    سر += "Connection: close\r\n\r\n"
    ناپایا پ := اچ تی تی پی.ارسال خام با مهلت(نشانی، سر، بدنه برگردان تهی*، بدنه.طول()، ۵۰۰۰)
    پاسخ‌متن := اچ تی تی پی.متن پاسخ خام(پ)
    اچ تی تی پی.آزادسازی پاسخ خام(پ)
    نخ‌پیوند(ک)
    تی سی پی.بستن سرور(سرور)
    سرچاپ "وضعیت:"، پ.وضعیت، پ.موفق
    سرچاپ "نشانی تازه:"، اچ تی تی پی.مقدار سرصفحه(پ.سرصفحه، "Location")
    سرچاپ "شناسه:"، جیسون.دریافت عدد(پاسخ‌متن، "id")
    سرچاپ "بدنه:"، پاسخ‌متن
پایان
