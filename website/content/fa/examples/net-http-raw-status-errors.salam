واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.تی سی پی

ناپایا سرور := تی سی پی.سرور {}

تابع رابط برنامه():
    تکرار ۲:
        ا := تی سی پی.پذیرش(سرور)
        درخواست := تی سی پی.خواندن(ا، ۴۰۹۶)
        اگر درخواست.بیاب("GET /missing ") برابر ۰:
            تی سی پی.نوشتن اچ تی تی پی(ا، "404 Not Found"، "application/json; charset=utf-8"، `{"error": "چنین صفحه‌ای نیست"}`)
        وگرنه:
            تی سی پی.نوشتن اچ تی تی پی(ا، "503 Service Unavailable"، "text/plain; charset=utf-8"، "بعدا دوباره امتحان کنید")
        پایان
        تی سی پی.بستن(ا)
    پایان
پایان

تابع بگیر از(نشانی: اچ تی تی پی.نقطه پایانی، مسیر: رشته):
    سر := "GET " + مسیر + " HTTP/1.1\r\nHost: " + نشانی.میزبان + "\r\nConnection: close\r\n\r\n"
    ناپایا پ := اچ تی تی پی.ارسال خام با مهلت(نشانی، سر، پوچ، ۰، ۵۰۰۰)
    بدنه := اچ تی تی پی.متن پاسخ خام(پ)
    اگر پ.موفق:
        سرچاپ مسیر، "کار کرد:"، بدنه
    وگرنه پ.وضعیت بزرگتر ۰:
        سرچاپ مسیر، "پاسخ"، پ.وضعیت، "داد با"، بدنه
    وگرنه:
        سرچاپ مسیر، "شکست خورد:"، پ.خطا
    پایان
    اچ تی تی پی.آزادسازی پاسخ خام(پ)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(رابط برنامه)
    نشانی := اچ تی تی پی.تجزیه نقطه پایانی("http://127.0.0.1:" + تی سی پی.درگاه(سرور))
    بگیر از(نشانی، "/missing")
    بگیر از(نشانی، "/busy")
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور)
    بگیر از(اچ تی تی پی.تجزیه نقطه پایانی("http://127.0.0.1:1")، "/nobody-listens")
    نشانی بد := اچ تی تی پی.تجزیه نقطه پایانی("ftp://files.example.com")
    سرچاپ "نشانی ftp درست است:"، نشانی بد.موفق
    بگیر از(نشانی بد، "/")
پایان
