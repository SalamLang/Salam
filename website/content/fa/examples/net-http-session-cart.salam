واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.نشست
واردسازی شبکه.مسیریاب
واردسازی تبدیل
واردسازی رشته

تابع افزودن(ز: صحیح۶۴):
    کالا := رشته.رونوشت(اچ تی تی پی.پارامتر(ز، "item"))
    ناپایا ن := نشست.شروع(ز)
    ناپایا تعداد := ۰
    اگر نشست.مقدار دارد(ن، کالا):
        تعداد = تبدیل.رشته به عدد(نشست.مقدار(ن، کالا))
    پایان
    نشست.تنظیم مقدار(ن، کالا، "" + (تعداد + ۱))
    نشست.ذخیره(ن)
    اچ تی تی پی.متن(ز، کالا + " افزوده شد")
پایان

تابع سبد(ز: صحیح۶۴):
    ن := نشست.شروع(ز)
    ناپایا متن := ""
    هر کالا در ["tea"، "bread"، "cheese"]:
        اگر نشست.مقدار دارد(ن، کالا):
            متن = متن + (متن برابر "" ? "" : "، ") + کالا + " x" + نشست.مقدار(ن، کالا)
        پایان
    پایان
    اچ تی تی پی.متن(ز، متن برابر "" ? "سبد خالی است" : متن)
پایان

تابع خالی کردن(ز: صحیح۶۴):
    ناپایا ن := نشست.شروع(ز)
    نشست.پاک کردن مقادیر(ن)
    نشست.ذخیره(ن)
    اچ تی تی پی.متن(ز، "خالی شد")
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/cart/:item"، افزودن)
    مسیریاب.دریافت(م، "/cart"، سبد)
    مسیریاب.حذف(م، "/cart"، خالی کردن)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۹۲)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19792/cart"
    ناپایا سارا := اچ تی تی پی.کارخواه جدید()
    ناپایا رضا := اچ تی تی پی.کارخواه جدید()
    _ := سارا.ارسال(پایه + "/tea"، "")
    _ := سارا.ارسال(پایه + "/tea"، "")
    _ := سارا.ارسال(پایه + "/bread"، "")
    _ := رضا.ارسال(پایه + "/cheese"، "")
    سرچاپ "سارا:"، اچ تی تی پی.بدنه(سارا.دریافت(پایه))
    سرچاپ "رضا:"، اچ تی تی پی.بدنه(رضا.دریافت(پایه))
    سرچاپ اچ تی تی پی.بدنه(سارا.حذف(پایه))
    سرچاپ "سارا:"، اچ تی تی پی.بدنه(سارا.دریافت(پایه))
    سرچاپ "رضا:"، اچ تی تی پی.بدنه(رضا.دریافت(پایه))
پایان
