واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.نشست
واردسازی شبکه.مسیریاب
واردسازی رشته

تابع سلام(ز: صحیح۶۴):
    ن := نشست.شروع(ز)
    اچ تی تی پی.متن(ز، "نشست " + (ن.شناسه.طول() > ۰))
پایان

تابع ریشه:
    نشست.پیکربندی("shop_sid"، ۱۸۰۰، درست، "Strict")
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/"، سلام)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۹۳)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پ := اچ تی تی پی.دریافت("http://127.0.0.1:19793/")
    سرچاپ اچ تی تی پی.بدنه(پ)
    خط := اچ تی تی پی.خطوط کوکی(پ).دریافت(۰)
    هر تکه در رشته.تفکیک کردن(خط، "; "):
        اگر تکه.شروع با("shop_sid="):
            سرچاپ "shop_sid=<شناسه‌ی تصادفی>"
        وگرنه وارونه تکه.شروع با("Expires="):
            سرچاپ تکه
        پایان
    پایان
    ناپایا ن := نشست.جدید()
    نشست.تنظیم مقدار(ن، "theme"، "dark")
    نشست.ذخیره(ن)
    سرچاپ "نگه‌داری به مدت"، ن.بیشترین عمر، "ثانیه"
    سرچاپ "پاک‌شده‌ها:"، نشست.پاکسازی منقضی شده ها()
    نشست.نابودسازی(ن.شناسه)
    ناپایا یافت := درست
    _ := نشست.دریافت(ن.شناسه، یافت)
    سرچاپ "پس از نابودسازی:"، یافت
پایان
