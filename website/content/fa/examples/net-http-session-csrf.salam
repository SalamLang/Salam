واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.نشست
واردسازی شبکه.مسیریاب

تابع فرم(ز: صحیح۶۴):
    ناپایا ن := نشست.شروع(ز)
    توکن := نشست.توکن سی اس آر اف(ن)
    نشست.ذخیره(ن)
    اچ تی تی پی.اچ تی ام ال(ز، `<form method="post" action="/email"><input type="hidden" name="csrf" value="` + توکن + `"><input name="email"></form>`)
پایان

تابع تغییر ایمیل(ز: صحیح۶۴):
    ن := نشست.شروع(ز)
    اگر وارونه نشست.تایید سی اس آر اف(ن، اچ تی تی پی.فرم(ز، "csrf")):
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۳)
        اچ تی تی پی.متن(ز، "فرم منقضی شده است، صفحه را دوباره باز کنید")
        برگشت
    پایان
    اچ تی تی پی.متن(ز، "ایمیل به " + اچ تی تی پی.فرم(ز، "email") + " تغییر کرد")
پایان

تابع توکن صفحه(صفحه: رشته): رشته:
    آغاز := صفحه.بیاب(`value="`) + ۷
    باقی := صفحه.زیررشته(آغاز، صفحه.طول() - آغاز)
    برگشت باقی.زیررشته(۰، باقی.بیاب(`"`))
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/email"، فرم)
    مسیریاب.ارسال(م، "/email"، تغییر ایمیل)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۹۱)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    نشانی := "http://127.0.0.1:19791/email"
    ناپایا مرورگر := اچ تی تی پی.کارخواه جدید()
    مرورگر.تنظیم سرصفحه("Content-Type"، "application/x-www-form-urlencoded")
    توکن := توکن صفحه(اچ تی تی پی.بدنه(مرورگر.دریافت(نشانی)))
    سرچاپ "طول توکن:"، توکن.طول()
    جعلی := مرورگر.ارسال(نشانی، "email=evil%40example.com")
    سرچاپ اچ تی تی پی.وضعیت(جعلی)، اچ تی تی پی.بدنه(جعلی)
    واقعی := مرورگر.ارسال(نشانی، "csrf=" + توکن + "&email=sara%40example.com")
    سرچاپ اچ تی تی پی.وضعیت(واقعی)، اچ تی تی پی.بدنه(واقعی)
پایان
