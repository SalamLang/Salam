واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.نشست
واردسازی شبکه.مسیریاب

تابع ورود(ز: صحیح۶۴):
    اگر اچ تی تی پی.فرم(ز، "user") نابرابر "sara" یا اچ تی تی پی.فرم(ز، "password") نابرابر "open sesame":
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۱)
        اچ تی تی پی.متن(ز، "نام کاربری یا گذرواژه نادرست است")
        برگشت
    پایان
    ناپایا ن := نشست.شروع(ز)
    نشست.بازتولید(ز، ن)
    نشست.تنظیم مقدار(ن، "user"، "sara")
    نشست.ذخیره(ن)
    اچ تی تی پی.تغییرمسیر(ز، "/me")
پایان

تابع من(ز: صحیح۶۴):
    ن := نشست.شروع(ز)
    اگر وارونه نشست.مقدار دارد(ن، "user"):
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۱)
        اچ تی تی پی.متن(ز، "لطفا وارد شوید")
        برگشت
    پایان
    اچ تی تی پی.متن(ز، "سلام " + نشست.مقدار(ن، "user"))
پایان

تابع خروج(ز: صحیح۶۴):
    نشست.پایان(ز)
    اچ تی تی پی.متن(ز، "خارج شدید")
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/login"، ورود)
    مسیریاب.دریافت(م، "/me"، من)
    مسیریاب.ارسال(م، "/logout"، خروج)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۹۰)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19790"
    ناپایا مرورگر := اچ تی تی پی.کارخواه جدید()
    مرورگر.تنظیم سرصفحه("Content-Type"، "application/x-www-form-urlencoded")
    سرچاپ اچ تی تی پی.بدنه(مرورگر.دریافت(پایه + "/me"))
    بد := مرورگر.ارسال(پایه + "/login"، "user=sara&password=guess")
    سرچاپ اچ تی تی پی.وضعیت(بد)، اچ تی تی پی.بدنه(بد)
    خوب := مرورگر.ارسال(پایه + "/login"، "user=sara&password=open+sesame")
    سرچاپ اچ تی تی پی.وضعیت(خوب)، اچ تی تی پی.دریافت سرصفحه(خوب، "location")
    سرچاپ اچ تی تی پی.بدنه(مرورگر.دریافت(پایه + "/me"))
    سرچاپ اچ تی تی پی.بدنه(مرورگر.ارسال(پایه + "/logout"، ""))
    سرچاپ اچ تی تی پی.بدنه(مرورگر.دریافت(پایه + "/me"))
پایان
