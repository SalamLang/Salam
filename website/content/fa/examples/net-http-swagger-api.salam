واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.سواگر
واردسازی شبکه.مسیریاب
واردسازی کدگذاری.جیسون

ساختار کار:
    @جیسون "id"
    همگانی شناسه: صحیح = ۰
    @جیسون "title"
    همگانی عنوان: رشته = ""
    @جیسون "done"
    همگانی انجام شده: منطقی = نادرست
پایان

تابع فهرست(ز: صحیح۶۴):
    اچ تی تی پی.جیسون(ز، `[{"id":1,"title":"نوشتن مستندات","done":false}]`)
پایان

تابع ساختن(ز: صحیح۶۴):
    اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۱)
    اچ تی تی پی.جیسون(ز، اچ تی تی پی.بدنه(ز))
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    ناپایا سند := سواگر.جدید("tasks"، "1.0.0")
    مسیریاب.دریافت(م، "/tasks"، فهرست)
    _ := سواگر.مسیر(سند، "GET"، "/tasks")
    سواگر.خلاصه(سند، "همه‌ی کارها")
    سواگر.برچسب(سند، "tasks")
    سواگر.برمی گرداند(سند، ۲۰۰، "کارها"، [کار {}])
    مسیریاب.ارسال(م، "/tasks"، ساختن)
    _ := سواگر.مسیر(سند، "POST"، "/tasks")
    سواگر.خلاصه(سند، "افزودن یک کار")
    سواگر.برچسب(سند، "tasks")
    سواگر.می پذیرد(سند، "کار تازه"، کار {})
    سواگر.برمی گرداند(سند، ۲۰۱، "کار ذخیره شده"، کار {})
    سرچاپ "جا افتاده:"، سواگر.جا افتاده(سند، م)
    سواگر.نصب(سند، م، "/docs")
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۹۴)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    مشخصات := اچ تی تی پی.بدنه(اچ تی تی پی.دریافت("http://127.0.0.1:19794/docs/openapi.json"))
    سرچاپ جیسون.کلیدها(جیسون.دریافت(مشخصات، "paths"))
    سرچاپ جیسون.دریافت مسیر(مشخصات، "paths./tasks.post.summary")
    سرچاپ جیسون.دریافت مسیر(مشخصات، "paths./tasks.get.responses.200.description")
    سرچاپ جیسون.دریافت مسیر(مشخصات، "paths./tasks.get.responses.200.content")
    سرچاپ جیسون.کلیدها(جیسون.دریافت مسیر(مشخصات، "components.schemas.کار.properties"))
    سرچاپ اچ تی تی پی.وضعیت(اچ تی تی پی.دریافت("http://127.0.0.1:19794/docs"))
    سواگر.آزاد سازی(سند)
پایان
