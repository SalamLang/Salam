واردسازی شبکه.اچ تی تی پی.سواگر
واردسازی کدگذاری.جیسون

ساختار فاکتور:
    @جیسون "number"
    همگانی شماره: رشته = ""
    @جیسون "total"
    همگانی جمع: اعشار۶۴ = ۰.۰
پایان

تابع ریشه:
    ناپایا سند := سواگر.جدید("billing"، "1.4.0")
    سواگر.سرور(سند، "https://billing.example.com"، "اصلی")
    سواگر.احراز هویت حامل(سند، "user"، "JWT")
    سواگر.احراز هویت کلید(سند، "partner"، "header"، "X-Partner-Key")
    _ := سواگر.مسیر(سند، "GET"، "/invoices/:number")
    سواگر.خلاصه(سند، "یک فاکتور")
    سواگر.امن(سند، "user")
    سواگر.برمی گرداند(سند، ۲۰۰، "فاکتور"، فاکتور {})
    سواگر.بدون بدنه برمی گرداند(سند، ۴۰۱، "توکن معتبر نیست")
    _ := سواگر.مسیر(سند، "POST"، "/partner/invoices")
    سواگر.خلاصه(سند، "شریک تجاری فاکتور می‌فرستد")
    سواگر.امن(سند، "partner")
    سواگر.می پذیرد(سند، "فاکتور"، فاکتور {})
    سواگر.بدون بدنه برمی گرداند(سند، ۲۰۲، "پذیرفته شد")
    سرچاپ "مشکلات:"، سواگر.مشکلات(سند).طول()
    سرچاپ سواگر.نوشتن مشخصات(سند، "openapi.json")
    مشخصات := سواگر.مشخصات از پرونده("openapi.json")
    سرچاپ جیسون.فشرده سازی(جیسون.دریافت مسیر(مشخصات، "components.securitySchemes.user"))
    سرچاپ جیسون.فشرده سازی(جیسون.دریافت مسیر(مشخصات، "components.securitySchemes.partner"))
    سرچاپ جیسون.فشرده سازی(جیسون.دریافت مسیر(مشخصات، "paths./invoices/{number}.get.security"))
    سرچاپ جیسون.دریافت مسیر(مشخصات، "components.schemas.فاکتور.properties.total.type")
    سواگر.آزاد سازی(سند)
پایان
