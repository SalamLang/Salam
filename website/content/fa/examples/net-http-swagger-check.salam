واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.سواگر
واردسازی شبکه.مسیریاب

تابع هیچ(ز: صحیح۶۴):
    اچ تی تی پی.متن(ز، "")
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/users/:id"، هیچ)
    مسیریاب.حذف(م، "/users/:id"، هیچ)
    مسیریاب.دریافت(م، "/reports"، هیچ)
    ناپایا سند := سواگر.جدید("users"، "2.0.0")
    _ := سواگر.مسیر(سند، "GET"، "/users/:id")
    سواگر.خلاصه(سند، "یک کاربر")
    سواگر.امن(سند، "token")
    سواگر.برمی گرداند متن(سند، ۲۰۰، "کاربر")
    _ := سواگر.مسیر(سند، "DELETE"، "/users/:id")
    سواگر.پارامتر مسیر(سند، "id"، "شناسه‌ی کاربر")
    سواگر.بدون بدنه برمی گرداند(سند، ۲۰۴۰، "حذف شد")
    ناپایا شمار := ۰
    هر مشکل در سواگر.مشکلات(سند):
        سرچاپ "مشکل:"، مشکل
        شمار += ۱
    پایان
    هر مسیر در سواگر.جا افتاده(سند، م):
        سرچاپ "مستند نشده:"، مسیر
        شمار += ۱
    پایان
    سرچاپ شمار، "مورد،"، شمار > ۰ ? "پس ساخت شکست می‌خورد" : "پس ساخت می‌گذرد"
    سواگر.آزاد سازی(سند)
پایان
