واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.سواگر
واردسازی شبکه.مسیریاب

تابع پینگ(ز: صحیح۶۴):
    اچ تی تی پی.متن(ز، "pong")
پایان

تابع پژواک(ز: صحیح۶۴):
    اچ تی تی پی.جیسون(ز، اچ تی تی پی.بدنه(ز))
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/ping"، پینگ)
    مسیریاب.ارسال(م، "/echo"، پژواک)
    ناپایا سند := سواگر.جدید("echo service"، "0.1.0")
    سواگر.توضیح(سند، "به پینگ پاسخ می‌دهد و جیسون را همان‌طور که آمده برمی‌گرداند.")
    سواگر.سرور(سند، "http://localhost:8080"، "همین دستگاه")
    سواگر.پویش(سند، م)
    _ := سواگر.انتخاب مسیر(سند، "GET"، "/ping")
    سواگر.خلاصه(سند، "آیا سرویس بالا است")
    سواگر.برمی گرداند متن(سند، ۲۰۰، "همیشه pong")
    _ := سواگر.انتخاب مسیر(سند، "POST"، "/echo")
    سواگر.خلاصه(سند، "جیسون بفرستید و همان را پس بگیرید")
    سواگر.می پذیرد خام(سند، "هر مقدار جیسون"، سواگر.نوع جیسون، "{}"، درست)
    سواگر.برمی گرداند خام(سند، ۲۰۰، "همان مقدار"، سواگر.نوع جیسون، "{}")
    سواگر.نصب(سند، م، "/docs")
    ناپایا س := اچ تی تی پی.سرور جدید(۸۰۸۰)
    اچ تی تی پی.استفاده(س، م)
    سرچاپ "مستندات در http://localhost:8080/docs"
    اچ تی تی پی.اجرا(س)
پایان
