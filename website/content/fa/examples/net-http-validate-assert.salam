واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.اعتبارسنجی
واردسازی شبکه.مسیریاب

تابع انتقال(ز: صحیح۶۴):
    مبلغ := اچ تی تی پی.پرسمان(ز، "amount")
    حساب := اچ تی تی پی.پرسمان(ز، "to")
    مبلغ معتبر := اعتبارسنجی.تطابق دارد(مبلغ، "^[1-9][0-9]{0,6}$")
    اعتبارسنجی.ادعا(ز، مبلغ معتبر، "مبلغ باید عددی صحیح از 1 تا 9999999 باشد")
    اگر وارونه مبلغ معتبر: برگشت پایان
    حساب معتبر := اعتبارسنجی.تطابق دارد(حساب، "^IR[0-9]{24}$")
    اعتبارسنجی.ادعا(ز، حساب معتبر، "مقصد باید شبا باشد: IR و پس از آن 24 رقم")
    اگر وارونه حساب معتبر: برگشت پایان
    اچ تی تی پی.جیسون(ز، `{"sent":` + مبلغ + `,"to":"` + حساب + `"}`)
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/transfer"، انتقال)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۸۹)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19789/transfer"
    هر پرسش در ["?amount=0&to=IR1"، "?amount=500&to=IR1"، "?amount=500&to=IR123456789012345678901234"]:
        پ := اچ تی تی پی.دریافت(پایه + پرسش)
        سرچاپ اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.بدنه(پ)
    پایان
پایان
