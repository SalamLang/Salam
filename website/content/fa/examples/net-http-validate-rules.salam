واردسازی شبکه.اچ تی تی پی.اعتبارسنجی
واردسازی رشته

تابع بررسی(برچسب: رشته، پذیرفته: منطقی):
    سرچاپ برچسب + ": " + (پذیرفته ? "پذیرفته" : "رد شد")
پایان

تابع ریشه:
    بررسی("نام خالی"، اعتبارسنجی.الزامی(""))
    بررسی("نامی از فاصله"، اعتبارسنجی.الزامی("   "))
    بررسی("فاصله‌ها پس از پیرایش"، اعتبارسنجی.الزامی(رشته.پیرایش("   ")))
    بررسی("نام کاربری ali_75"، اعتبارسنجی.تطابق دارد("ali_75"، "^[a-z][a-z0-9_]{2,15}$"))
    بررسی("نام کاربری 7up"، اعتبارسنجی.تطابق دارد("7up"، "^[a-z][a-z0-9_]{2,15}$"))
    بررسی("کد پستی 1234567890"، اعتبارسنجی.تطابق دارد("1234567890"، "^[0-9]{10}$"))
    بررسی("رنگ #1e90ff"، اعتبارسنجی.تطابق دارد("#1e90ff"، "^#[0-9a-fA-F]{6}$"))
    بررسی("گذرواژه‌ی ۶ نویسه‌ای"، اعتبارسنجی.طول("abc123"، ۸، ۶۴))
    بررسی("نام چهار حرفی مریم"، اعتبارسنجی.طول("مریم"، ۲، ۴))
    سرچاپ "بایت‌های نام:"، "مریم".طول()
    بررسی("ایمیل a@b.ir"، اعتبارسنجی.ایمیل است("a@b.ir"))
    بررسی("ایمیل @."، اعتبارسنجی.ایمیل است("@."))
پایان
