واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.اعتبارسنجی
واردسازی شبکه.مسیریاب
واردسازی کدگذاری.جیسون
واردسازی رشته

تابع ثبت نام(ز: صحیح۶۴):
    نام := رشته.پیرایش(اچ تی تی پی.فرم(ز، "name"))
    ایمیل := رشته.پیرایش(اچ تی تی پی.فرم(ز، "email"))
    گذرواژه := اچ تی تی پی.فرم(ز، "password")
    ناپایا خطاها := وکتور {} برگردان وکتور<رشته>
    اگر وارونه اعتبارسنجی.الزامی(نام): خطاها.بیفزا(جیسون.رشته جیسون("نام لازم است")) پایان
    اگر وارونه اعتبارسنجی.ایمیل است(ایمیل): خطاها.بیفزا(جیسون.رشته جیسون("ایمیل درست نیست")) پایان
    اگر وارونه اعتبارسنجی.طول(گذرواژه، ۸، ۶۴): خطاها.بیفزا(جیسون.رشته جیسون("گذرواژه باید ۸ تا ۶۴ نویسه باشد")) پایان
    اگر خطاها.طول() > ۰:
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۲۲)
        اچ تی تی پی.جیسون(ز، "{" + جیسون.عضو خام("errors"، جیسون.آرایه(خطاها)) + "}")
        برگشت
    پایان
    اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۱)
    اچ تی تی پی.جیسون(ز، "{" + جیسون.عضو("welcome"، نام) + "}")
پایان

تابع بفرست(فرم: رشته):
    ناپایا سر := اچ تی تی پی.سرصفحه جدید()
    سر.درج("Content-Type"، "application/x-www-form-urlencoded")
    پ := اچ تی تی پی.ارسال با("http://127.0.0.1:19788/signup"، فرم، سر)
    سرچاپ اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.بدنه(پ)
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/signup"، ثبت نام)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۸۸)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    بفرست("name=+&email=ali&password=123")
    بفرست("name=Ali&email=ali%40example.com&password=123")
    بفرست("name=Ali&email=ali%40example.com&password=long+enough")
پایان
