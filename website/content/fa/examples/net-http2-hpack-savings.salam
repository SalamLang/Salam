واردسازی شبکه.اچ تی تی پی۲

تابع سرآیندهای درخواست(مسیر: رشته): اچ تی تی پی۲.فهرست سرآیندها:
    ناپایا سرآیندها := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":method"، "GET")
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":scheme"، "https")
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":authority"، "shop.example.com")
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":path"، مسیر)
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، "user-agent"، "salam-client/1.0")
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، "accept"، "application/json")
    اچ تی تی پی۲.افزودن سرآیند حساس(سرآیندها، "authorization"، "Bearer eyJhbGciOiJIUzI1NiJ9.e30.x")
    برگشت سرآیندها
پایان

تابع اندازه متنی(سرآیندها: اچ تی تی پی۲.فهرست سرآیندها): صحیح:
    ناپایا اندازه := ۰
    هر مورد در سرآیندها.سرآیندها:
        اندازه += مورد.نام.طول() + مورد.مقدار.طول() + ۴
    پایان
    برگشت اندازه
پایان

تابع ریشه:
    ناپایا جدول := اچ تی تی پی۲.جدول پویا جدید(۴۰۹۶)
    هر مسیر در ["/cart"، "/cart/items"، "/checkout"]:
        سرآیندها := سرآیندهای درخواست(مسیر)
        بلوک := اچ تی تی پی۲.کدگذاری فهرست سرآیند(جدول، سرآیندها، درست)
        سرچاپ مسیر، "به شکل متن HTTP/1.1:"، اندازه متنی(سرآیندها)، "بایت، HPACK:"، بلوک.طول، "بایت، مدخل‌های جدول:"، اچ تی تی پی۲.تعداد جدول پویا(جدول)
    پایان
    سرچاپ "فقط هافمن، مقدار user-agent:"، "salam-client/1.0".طول()، "->"، اچ تی تی پی۲.طول کدشده متن("salam-client/1.0")
پایان
