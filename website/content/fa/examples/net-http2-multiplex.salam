واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی
واردسازی فشرده سازی

ناپایا سرور من := تی سی پی.سرور {}

تابع پاسخ‌گو():
    سوکت := تی سی پی.پذیرش(سرور من)
    ناپایا اتصال := اچ تی تی پی۲.اتصال جدید(اچ تی تی پی۲.ترابری ساده(سوکت.توصیفگر)، درست)
    اگر وارونه اچ تی تی پی۲.دست‌دهی سرور(اتصال):
        برگشت
    پایان
    ناپایا شناسه‌ها := وکتور {} برگردان وکتور<صحیح>
    تا شناسه‌ها.طول() کوچکتر ۳:
        شناسه‌ها.بیفزا(اچ تی تی پی۲.انتظار سرآیند(اتصال، ۲۰))
    پایان
    ناپایا ش := شناسه‌ها.طول() - ۱
    تا ش بزرگتربرابر ۰:
        شناسه := شناسه‌ها.بگیر(ش)
        مسیر := اچ تی تی پی۲.دریافت سرآیند(اچ تی تی پی۲.جریان با شناسه(اتصال، شناسه).سرآیندها، ":path")
        ناپایا سرآیندها := اچ تی تی پی۲.فهرست سرآیندها {}
        اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":status"، "200")
        _ := اچ تی تی پی۲.ارسال سرآیندها(اتصال، شناسه، سرآیندها، نادرست)
        _ := اچ تی تی پی۲.ارسال داده(اتصال، شناسه، فشرده سازی.بافر از رشته("صفحه‌ی " + مسیر)، درست)
        ش -= ۱
    پایان
    _ := اچ تی تی پی۲.انتظار اتمام جریان(اتصال، ۰، ۵)
    اچ تی تی پی۲.بستن اتصال(اتصال)
پایان

تابع درخواست(اتصال &: اچ تی تی پی۲.اتصال اچ تی تی پی۲، مسیر: رشته): صحیح:
    شناسه := اچ تی تی پی۲.شناسه جریان بعدی(اتصال)
    ناپایا سرآیندها := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":method"، "GET")
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":scheme"، "http")
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":path"، مسیر)
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":authority"، "127.0.0.1")
    _ := اچ تی تی پی۲.ارسال سرآیندها(اتصال، شناسه، سرآیندها، درست)
    برگشت شناسه
پایان

تابع ریشه:
    سرور من = تی سی پی.پیوند(۰)
    نخ := نخ‌ساز(پاسخ‌گو)
    سوکت := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(سرور من))
    ناپایا اتصال := اچ تی تی پی۲.اتصال جدید(اچ تی تی پی۲.ترابری ساده(سوکت.توصیفگر)، نادرست)
    اگر وارونه اچ تی تی پی۲.دست‌دهی کارخواه(اتصال):
        سرچاپ "دست‌دهی ناموفق"
        برگشت ۱
    پایان
    ناپایا شناسه‌ها := وکتور {} برگردان وکتور<صحیح>
    هر نشانی در ["/a"، "/b"، "/c"]:
        شناسه‌ها.بیفزا(درخواست(اتصال، نشانی))
    پایان
    سرچاپ "سه درخواست فرستاده شد روی جریان‌های"، شناسه‌ها.بگیر(۰)، شناسه‌ها.بگیر(۱)، شناسه‌ها.بگیر(۲)
    هر شناسه در شناسه‌ها:
        _ := اچ تی تی پی۲.انتظار اتمام جریان(اتصال، شناسه، ۵۰)
        s := اچ تی تی پی۲.جریان با شناسه(اتصال، شناسه)
        سرچاپ "جریان"، شناسه، اچ تی تی پی۲.دریافت سرآیند(s.سرآیندها، ":status")، فشرده سازی.بافر به رشته(s.بدنه)
    پایان
    سرچاپ "اتصال‌های به کار رفته: ۱، جریان‌ها:"، اچ تی تی پی۲.تعداد جریان‌ها(اتصال)
    _ := اچ تی تی پی۲.ارسال خداحافظی(اتصال، اچ تی تی پی۲.کد بدون خطا، "")
    اچ تی تی پی۲.بستن اتصال(اتصال)
    نخ‌پیوند(نخ)
    تی سی پی.بستن سرور(سرور من)
    برگشت ۰
پایان
