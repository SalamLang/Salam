واردسازی شبکه.اچ تی تی پی۲
واردسازی تی ال اس

تابع ریشه:
    میزبان := "www.cloudflare.com"
    ناپایا پیکربندی := تی ال اس.پیکربندی جدید(میزبان)
    پیکربندی.پروتکل برنامه = "h2"
    امن := تی ال اس.اتصال امن(میزبان، ۴۴۳، پیکربندی)
    اگر وارونه تی ال اس.اتصال معتبر(امن):
        سرچاپ "TLS ناموفق:"، تی ال اس.خطای اتصال(امن)
        برگشت ۱
    پایان
    ناپایا اتصال := اچ تی تی پی۲.اتصال جدید(اچ تی تی پی۲.ترابری امن(امن)، نادرست)
    اگر وارونه اچ تی تی پی۲.دست‌دهی کارخواه(اتصال):
        سرچاپ "سرور HTTP/2 را نپذیرفت"
        برگشت ۱
    پایان
    شناسه := اچ تی تی پی۲.شناسه جریان بعدی(اتصال)
    ناپایا سرآیندها := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":method"، "HEAD")
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":scheme"، "https")
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":path"، "/")
    اچ تی تی پی۲.افزودن سرآیند(سرآیندها، ":authority"، میزبان)
    _ := اچ تی تی پی۲.ارسال سرآیندها(اتصال، شناسه، سرآیندها، درست)
    اگر اچ تی تی پی۲.انتظار اتمام جریان(اتصال، شناسه، ۱۰۰):
        جریان := اچ تی تی پی۲.جریان با شناسه(اتصال، شناسه)
        سرچاپ "وضعیت:"، اچ تی تی پی۲.دریافت سرآیند(جریان.سرآیندها، ":status")
        سرچاپ "سرور:"، اچ تی تی پی۲.دریافت سرآیند(جریان.سرآیندها، "server")
        سرچاپ "بایت‌های بدنه:"، جریان.بدنه.طول
    پایان
    اچ تی تی پی۲.بستن اتصال(اتصال)
    برگشت ۰
پایان
