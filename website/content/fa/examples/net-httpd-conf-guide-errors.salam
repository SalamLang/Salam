واردسازی شبکه.سرور وب.پیکربندی وب

تابع بررسی(متن: رشته):
    ناپایا د := پیکربندی وب.تجزیه(متن)
    دیرکن پیکربندی وب.آزاد سازی(د)
    اگر د.درست است:
        سرچاپ "ok"
    وگرنه:
        سرچاپ پیکربندی وب.متن خطا(د، "app.salam")
    پایان
پایان

تابع ریشه:
    بررسی("listen = 80\n")
    بررسی("server:\n    site:\n")
    بررسی("names = \"open\n")
    بررسی("listen 80\n")
پایان
