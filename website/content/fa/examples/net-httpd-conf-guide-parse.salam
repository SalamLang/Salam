واردسازی شبکه.سرور وب.پیکربندی وب

تابع ریشه:
    متن := `
server:
    max connections = 100
    site:
        متغیر_listen = 8080
        نام‌ها = "a.test"
    end
end
`
    ناپایا د := پیکربندی وب.تجزیه(متن)
    دیرکن پیکربندی وب.آزاد سازی(د)
    اگر وارونه د.درست است:
        سرچاپ پیکربندی وب.متن خطا(د، "app.salam")
        برگشت ۱
    پایان
    سرور := پیکربندی وب.یافتن فرزند(د، پیکربندی وب.گره ریشه()، "server")
    سرچاپ پیکربندی وب.نام(د، سرور)، پیکربندی وب.شمار فرزندان(د، سرور)
    حد := پیکربندی وب.یافتن فرزند(د، سرور، "max connections")
    سرچاپ پیکربندی وب.متن مقدار گره(د، حد، ۰)
    سایت := پیکربندی وب.یافتن فرزند(د، سرور، "site")
    سرچاپ پیکربندی وب.متن مقدار گره(د، پیکربندی وب.یافتن فرزند(د، سایت، "names")، ۰)
پایان
