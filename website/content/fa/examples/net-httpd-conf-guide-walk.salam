واردسازی شبکه.سرور وب.پیکربندی وب

تابع ریشه:
    متن := `
server:
    site:
        listen = 80 tls
        names = "a.test"
        location "/api/": cache = 1h end
    end
end
`
    ناپایا د := پیکربندی وب.تجزیه(متن)
    دیرکن پیکربندی وب.آزاد سازی(د)
    سایت := پیکربندی وب.یافتن فرزند(د، پیکربندی وب.یافتن فرزند(د، پیکربندی وب.گره ریشه()، "server")، "site")
    تکرار پیکربندی وب.شمار فرزندان(د، سایت) در ای:
        شماره := پیکربندی وب.فرزند شماره(د، سایت، ای)
        گ := د.گره ها.بگیر(شماره)
        اگر گ.بلوک است:
            سرچاپ "block"، پیکربندی وب.نام(د، شماره)، گ.برچسب ها.بگیر(۰)، گ.خط گره
        وگرنه:
            م := گ.مقدارها.بگیر(۰)
            سرچاپ "setting"، پیکربندی وب.نام(د، شماره)، م.متن مقدار، م.نوع مقدار == پیکربندی وب.مقدار عددی
        پایان
    پایان
پایان
