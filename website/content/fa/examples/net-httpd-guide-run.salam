واردسازی سیستم عامل
واردسازی شبکه.سرور وب

تابع ریشه:
    ناپایا مسیر := "web.salam"
    آرگ := سیستم عامل.آرگومان ها()
    اگر آرگ.طول() > ۱:
        مسیر = آرگ[۱]
    پایان
    اگر سرور وب.بررسی(مسیر) != ۰:
        برگشت ۱
    پایان
    اگر وارونه سرور وب.بارگذاری پرونده(مسیر):
        برگشت ۲
    پایان
    سرچاپ "در حال سرویس"، سرور وب.شمار سایت ها()، "سایت"
    کد := سرور وب.اجرا()
    سرور وب.توقف()
    برگشت کد
پایان
