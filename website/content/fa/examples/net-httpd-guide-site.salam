واردسازی سیستم عامل
واردسازی ورودی خروجی
واردسازی رشته
واردسازی شبکه.سرور وب

تابع ریشه:
    ریشه_پوشه := سیستم عامل.پوشه موقت() + "/salam_guide_site_fa"
    سیستم عامل.حذف همه(ریشه_پوشه)
    سیستم عامل.ساخت پوشه ها(ریشه_پوشه + "/shop")
    سیستم عامل.ساخت پوشه ها(ریشه_پوشه + "/blog")
    ورودی خروجی.نوشتن پرونده(ریشه_پوشه + "/shop/index.html"، "shop")
    متن := `
server:
    site:
        listen = 8080
        names = "shop.test www.shop.test"
        root = "@ROOT@/shop"
        location "/assets/": cache = 30d end
        location "= /health": return = 200 "ok" end
    end
    site:
        listen = 8080
        names = "*.blog.test"
        root = "@ROOT@/blog"
        default = true
    end
end
`
    خوب := سرور وب.بارگذاری متن پیکربندی(رشته.جایگزینی(متن، "@ROOT@"، ریشه_پوشه)، "web.salam")
    سرچاپ خوب، سرور وب.شمار سایت ها()
    سرچاپ سرور وب.سایت برای("www.shop.test"، ۸۰۸۰)، سرور وب.سایت برای("a.blog.test"، ۸۰۸۰)، سرور وب.سایت برای("other.test"، ۸۰۸۰)
    سرچاپ سرور وب.الگوی مسیر(سرور وب.مسیر برای(۰، "/health"))
    سرچاپ سرور وب.مسیر برای(۰، "/about")
    سیستم عامل.حذف همه(ریشه_پوشه)
پایان
