// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا درگاه_مبدأ := 0
ناپایا درگاه_پژواک := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع مبدأ_سرور():
    کارساز۲ := تی سی پی.پیوند(0)
    درگاه_مبدأ = تی سی پی.درگاه(کارساز۲)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز۲)
        درخواست_متن := تی سی پی.خواندن(نویسه، 4096)
        نخستین := درخواست_متن.زیررشته(0، درخواست_متن.بیاب("\r\n"))
        بدنه := "origin saw: " + نخستین
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: " + بدنه.طول() + "\r\nConnection: close\r\n\r\n" + بدنه)
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع پژواک():
    کارساز۲ := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز۲)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز۲)
        تی سی پی.نوشتن(نویسه، "echo:" + تی سی پی.خواندن(نویسه، 100))
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع آغاز_پشتوانه‌ها():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(مبدأ_سرور)
    متغیر__b := نخ‌ساز(پژواک)
    همگام سازی.انتظار(آماده)
پایان

تابع ریشه:
    آغاز_پشتوانه‌ها()
    ناپایا پیکربندی_کارساز := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(پیکربندی_کارساز، درست)
    کارساز := پراکسی اچ‌تی‌تی‌پی.شروع(پیکربندی_کارساز)
    کارخواه := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، کارساز.درگاه)

    ساده := پراکسی اچ‌تی‌تی‌پی.دریافت(کارخواه، "http://127.0.0.1:" + درگاه_مبدأ + "/news")
    سرچاپ "HTTP ساده:"، ساده.وضعیت، ساده.بدنه

    تونل := پراکسی اچ‌تی‌تی‌پی.اتصال(کارخواه، "127.0.0.1"، درگاه_پژواک)
    تونل.جریان.نوشتن("anything, even TLS")
    سرچاپ "تونل:"، تونل.وضعیت، تونل.جریان.خواندن(100)
    تونل.جریان.بستن()
    پراکسی اچ‌تی‌تی‌پی.توقف(کارساز)
پایان
