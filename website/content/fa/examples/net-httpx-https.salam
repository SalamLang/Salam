واردسازی شبکه.اچ تی تی پی ساده
واردسازی کدگذاری.جیسون

تابع ریشه:
    نشانی := اچ تی تی پی ساده.تجزیه نقطه پایانی("https://api.github.com")
    سرچاپ نشانی.host، نشانی.port، نشانی.secure
    ناپایا سر := "GET /repos/SalamLang/Salam HTTP/1.1\r\n"
    سر += "Host: api.github.com\r\n"
    سر += "User-Agent: salam-example\r\n"
    سر += "Accept: application/vnd.github+json\r\n"
    سر += "Connection: close\r\n\r\n"
    پ := اچ تی تی پی ساده.ارسال متن(نشانی، سر، "")
    اگر پ.status برابر ۰:
        سرچاپ "درخواست شکست خورد:"، پ.error
        برگشت ۱
    پایان
    سرچاپ "وضعیت:"، پ.status
    سرچاپ "سهمیه‌ی باقی‌مانده:"، اچ تی تی پی ساده.مقدار سرصفحه(پ.head، "x-ratelimit-remaining")
    اگر پ.ok:
        سرچاپ جیسون.دریافت(پ.body، "full_name")، "به زبان"، جیسون.دریافت(پ.body، "language")، "نوشته شده است"
    پایان
    برگشت ۰
پایان
