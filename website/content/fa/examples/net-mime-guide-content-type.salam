واردسازی شبکه.مایم
واردسازی رشته

تابع توصیف(سرآیند: رشته): رشته:
    نم := مایم.تجزیه نوع محتوا(سرآیند)
    رسانه := رشته.کوچک(نم.نوع رسانه)
    ناپایا نویسه‌گان := مایم.دریافت پارامتر(نم، "charset")
    اگر نویسه‌گان.طول() == ۰: نویسه‌گان = "ندارد" پایان
    اگر رسانه == "application/json":
        برگشت "بدنه جیسون، نویسه‌گان " + نویسه‌گان
    وگرنه رسانه == "application/x-www-form-urlencoded":
        برگشت "فرم کدگذاری‌شده در نشانی"
    وگرنه رسانه == "multipart/form-data":
        برگشت "بارگذاری، مرز " + مایم.دریافت پارامتر(نم، "boundary")
    وگرنه رسانه.بیاب("text/") == ۰:
        برگشت "متن ساده، نویسه‌گان " + نویسه‌گان
    پایان
    برگشت "ناشناخته: [" + رسانه + "]"
پایان

تابع ریشه:
    سرچاپ توصیف("application/json")
    سرچاپ توصیف("application/json; charset=utf-8")
    سرچاپ توصیف("application/x-www-form-urlencoded")
    سرچاپ توصیف("multipart/form-data; boundary=\"abc123\"")
    سرچاپ توصیف("text/csv;charset=windows-1256")
    سرچاپ توصیف("Application/JSON")
    سرچاپ توصیف("")
پایان
