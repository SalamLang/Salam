واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.مایم
واردسازی فشرده سازی

تابع بارگذاری(زمینه: صحیح۶۴):
    نم := مایم.تجزیه نوع محتوا(اچ تی تی پی.سرصفحه(زمینه، "Content-Type"))
    بدنه := اچ تی تی پی.بدنه(زمینه)
    بخش‌ها := مایم.تجزیه چندبخشی(بدنه برگردان تهی*، بدنه.طول()، مایم.دریافت پارامتر(نم، "boundary"))
    ناپایا پاسخ := ""
    هر ب در بخش‌ها.اقلام:
        پاسخ += ب.نام + ": " + فشرده سازی.بافر به رشته(ب.بدنه) + "\n"
    پایان
    اچ تی تی پی.متن(زمینه، پاسخ)
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/upload"، بارگذاری)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۸۵۸۷)
    اچ تی تی پی.تنظیم میزبان(س، "127.0.0.1")
    اچ تی تی پی.استفاده(س، م)
    اگر وارونه اچ تی تی پی.اجرا در پس زمینه(س):
        سرچاپ "درگاه ۱۸۵۸۷ گرفته است"
        برگشت ۱
    پایان

    ناپایا فرم := مایم.نویسنده چندبخشی جدید()
    مایم.نوشتن فیلد(فرم، "user"، "مریم")
    مایم.نوشتن پرونده متنی(فرم، "todo"، "todo.txt"، "text/plain"، "خرید نان")
    بدنه := مایم.بستن نویسنده(فرم)
    سرصفحه‌ها := نگاشت {} برگردان نگاشت<رشته، رشته>
    سرصفحه‌ها.درج("Content-Type"، مایم.سرآیند نوع محتوا(فرم))
    جواب := اچ تی تی پی.ارسال با("http://127.0.0.1:18587/upload"، فشرده سازی.بافر به رشته(بدنه)، سرصفحه‌ها)
    سرچاپ جواب.وضعیت
    چاپ جواب.بدنه
    برگشت ۰
پایان
