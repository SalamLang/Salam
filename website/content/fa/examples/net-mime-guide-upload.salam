واردسازی شبکه.مایم
واردسازی فشرده سازی

تابع رسیدگی به بارگذاری(نوع: رشته، بدنه: فشرده سازی.بافر بایت):
    نم := مایم.تجزیه نوع محتوا(نوع)
    اگر نم.نوع رسانه != "multipart/form-data":
        سرچاپ "۴۱۵ نوع رسانه پشتیبانی نمی‌شود"
        برگشت
    پایان
    مرز := مایم.دریافت پارامتر(نم، "boundary")
    بخش‌ها := مایم.تجزیه چندبخشی(بدنه.داده، بدنه.طول، مرز)
    هر ب در بخش‌ها.اقلام:
        اگر ب.نام پرونده.طول() > ۰:
            سرچاپ "پرونده"، ب.نام، ب.نام پرونده، ب.نوع محتوا، ب.بدنه.طول، "بایت"
        وگرنه:
            سرچاپ "فیلد"، ب.نام، "="، فشرده سازی.بافر به رشته(ب.بدنه)
        پایان
    پایان
پایان

تابع ریشه:
    ناپایا فرم := مایم.نویسنده چندبخشی جدید()
    مایم.نوشتن فیلد(فرم، "title"، "سفر شیراز")
    مایم.نوشتن فیلد(فرم، "album"، "۱۴۰۵")
    مایم.نوشتن پرونده متنی(فرم، "notes"، "notes.txt"، ""، "روز اول: باغ ارم")
    عکس := فشرده سازی.بافر از رشته("not really a jpeg")
    مایم.نوشتن پرونده(فرم، "photo"، "eram.jpg"، ""، عکس.داده، عکس.طول)
    بدنه := مایم.بستن نویسنده(فرم)
    رسیدگی به بارگذاری(مایم.سرآیند نوع محتوا(فرم)، بدنه)
    رسیدگی به بارگذاری("application/json"، بدنه)
پایان
