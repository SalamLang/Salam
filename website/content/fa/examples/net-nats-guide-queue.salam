واردسازی شبکه.نتس

تابع ریشه:
    ناپایا nc := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    a := نتس.اشتراک صف(nc، "jobs"، "workers")
    b := نتس.اشتراک صف(nc، "jobs"، "workers")
    _ok := نتس.لغو خودکار اشتراک(nc، a، 10)
    تکرار 6 در i:
        _sent := نتس.انتشار(nc، "jobs"، "job " + i)
    پایان
    _flushed := نتس.تخلیه(nc، 1000)

    ناپایا handled := 0
    تکرار 2 در k:
        s := k == 0 ? a : b
        ناپایا m := نتس.پیام بعدی(nc، s، 200)
        تا m.سالم:
            handled += 1
            m = نتس.پیام بعدی(nc، s، 200)
        پایان
    پایان
    سرچاپ "handled"، handled، "subscriptions"، نتس.شمار اشتراک(nc)
    سرچاپ "drained"، نتس.تخلیه کامل(nc، 1000)
    برگشت 0
پایان
