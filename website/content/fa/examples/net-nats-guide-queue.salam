واردسازی شبکه.نتس

تابع ریشه:
    ناپایا اتصال_نتس := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    الف := نتس.اشتراک صف(اتصال_نتس، "jobs"، "workers")
    بافر_محلی := نتس.اشتراک صف(اتصال_نتس، "jobs"، "workers")
    متغیر__ok := نتس.لغو خودکار اشتراک(اتصال_نتس، الف، 10)
    تکرار 6 در شمارنده:
        متغیر__sent := نتس.انتشار(اتصال_نتس، "jobs"، "job " + شمارنده)
    پایان
    متغیر__flushed := نتس.تخلیه(اتصال_نتس، 1000)

    ناپایا رسیدگی := 0
    تکرار 2 در شمارنده۳:
        متن_نمونه := شمارنده۳ == 0 ? الف : بافر_محلی
        ناپایا تعداد۲ := نتس.پیام بعدی(اتصال_نتس، متن_نمونه، 200)
        تا تعداد۲.سالم:
            رسیدگی++
            تعداد۲ = نتس.پیام بعدی(اتصال_نتس، متن_نمونه، 200)
        پایان
    پایان
    سرچاپ "handled"، رسیدگی، "subscriptions"، نتس.شمار اشتراک(اتصال_نتس)
    سرچاپ "drained"، نتس.تخلیه کامل(اتصال_نتس، 1000)
    برگشت 0
پایان
