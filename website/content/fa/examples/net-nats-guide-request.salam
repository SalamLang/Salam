واردسازی شبکه.نتس

تابع ریشه:
    ناپایا اتصال_نتس := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    متغیر__s := نتس.اشتراک پاسخگو(اتصال_نتس، "svc.shout"، ""، (m: نتس.پیام): برگشت m.داده + "!" پایان)

    پاسخ_محلی := نتس.درخواست(اتصال_نتس، "svc.shout"، "hello"، 1000)
    اگر پاسخ_محلی.سالم:
        سرچاپ "reply:"، پاسخ_محلی.داده
    وگرنه:
        سرچاپ "failed:"، پاسخ_محلی.خطا
    پایان

    رفته := نتس.درخواست(اتصال_نتس، "svc.nobody"، "x"، 1000)
    سرچاپ رفته.سالم، رفته.خطا

    کند := نتس.درخواست(اتصال_نتس، "svc.silent"، "x"، 150)
    سرچاپ کند.سالم، کند.خطا

    نتس.بستن(اتصال_نتس)
    برگشت 0
پایان
