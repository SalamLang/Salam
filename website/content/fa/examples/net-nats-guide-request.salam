واردسازی شبکه.نتس

تابع ریشه:
    ناپایا nc := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    _s := نتس.اشتراک پاسخگو(nc، "svc.shout"، ""، (m: نتس.پیام): برگشت m.داده + "!" پایان)

    r := نتس.درخواست(nc، "svc.shout"، "hello"، 1000)
    اگر r.سالم:
        سرچاپ "reply:"، r.داده
    وگرنه:
        سرچاپ "failed:"، r.خطا
    پایان

    gone := نتس.درخواست(nc، "svc.nobody"، "x"، 1000)
    سرچاپ gone.سالم، gone.خطا

    slow := نتس.درخواست(nc، "svc.silent"، "x"، 150)
    سرچاپ slow.سالم، slow.خطا

    نتس.بستن(nc)
    برگشت 0
پایان
