واردسازی شبکه.نتس

تابع show(pattern: رشته، subject: رشته):
    سرچاپ pattern، subject، نتس.تطبیق موضوع(pattern، subject)
پایان

تابع ریشه:
    show("orders.*"، "orders.created")
    show("orders.*"، "orders.created.eu")
    show("orders.>"، "orders.created.eu")
    show("orders.>"، "orders")
    show("*.created"، "orders.created")
    show("orders.created"، "orders.created")
    سرچاپ نتس.موضوع معتبر("orders..created")، نتس.موضوع معتبر(".orders")، نتس.موضوع معتبر("orders.")
    سرچاپ نتس.موضوع معتبر("")، نتس.موضوع معتبر("a b")، نتس.موضوع معتبر("orders.>")
پایان
