واردسازی شبکه.نتس

تابع ریشه:
    ناپایا اچ := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(اچ، "Trace"، "a1")
    نتس.افزودن سرآیند(اچ، "Trace"، "b2")
    نتس.تنظیم سرآیند(اچ، "Tenant"، "acme")
    سرچاپ نتس.گرفتن سرآیند(اچ، "Tenant")، نتس.شمار سرآیند(اچ)، نتس.سرآیند دارد(اچ، "Trace")
    سرچاپ نتس.موضوع معتبر("orders.created")، نتس.موضوع معتبر("bad subject")
