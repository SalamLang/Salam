واردسازی شبکه.نتس

تابع ریشه:
    ناپایا h := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(h، "Trace"، "a1")
    نتس.افزودن سرآیند(h، "Trace"، "b2")
    نتس.تنظیم سرآیند(h، "Tenant"، "acme")
    سرچاپ نتس.گرفتن سرآیند(h، "Tenant")، نتس.شمار سرآیند(h)، نتس.سرآیند دارد(h، "Trace")
    سرچاپ نتس.موضوع معتبر("orders.created")، نتس.موضوع معتبر("bad subject")
