واردسازی شبکه.پراکسی
واردسازی شبکه.تی سی پی

تابع ریشه:
    ناپایا زنجیره := پراکسی.زنجیره جدید()
    پراکسی.افزودن(زنجیره، پراکسی.پراکسی ساکس۵ جدید("127.0.0.1:9050"))
    پراکسی.افزودن(زنجیره، پراکسی.پراکسی اچ‌تی‌تی‌پی با احراز هویت("exit.example.net:3128"، "team"، "s3cret"))

    ناپایا اتصال := پراکسی.شماره‌گیری زنجیره‌ای(زنجیره، "example.com"، ۸۰)
    اگر وارونه تی سی پی.اتصال معتبر(اتصال):
        سرچاپ "زنجیره کار نمی‌کند، اتصال مستقیم امتحان می‌شود"
        اتصال = تی سی پی.شماره گیری("example.com"، ۸۰)
    پایان
    اگر وارونه تی سی پی.اتصال معتبر(اتصال):
        سرچاپ "به example.com نمی‌رسیم"
        برگشت ۱
    پایان
    تی سی پی.نوشتن(اتصال، "HEAD / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
    پاسخ := تی سی پی.خواندن(اتصال، ۴۰۹۶)
    سرچاپ پاسخ.زیررشته(۰، پاسخ.بیاب("\r\n"))
    تی سی پی.بستن(اتصال)
    برگشت ۰
پایان
