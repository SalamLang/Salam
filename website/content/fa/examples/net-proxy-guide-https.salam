واردسازی شبکه.پراکسی
واردسازی شبکه.تی سی پی
واردسازی تی ال اس
واردسازی رشته

تابع خط نخست(متن: رشته): رشته:
    جای شکست خط := متن.بیاب("\r\n")
    اگر جای شکست خط < ۰: برگشت متن پایان
    برگشت متن.زیررشته(۰، جای شکست خط)
پایان

تابع ریشه:
    میزبان := "example.com"
    پ := پراکسی.پراکسی اچ‌تی‌تی‌پی جدید("127.0.0.1:3128")
    اتصال := پراکسی.شماره‌گیری(پ، میزبان، ۴۴۳)
    اگر وارونه تی سی پی.اتصال معتبر(اتصال):
        سرچاپ "تونلی از " + پ.میزبان + ":" + رشته.از عدد(پ.درگاه برگردان صحیح۶۴) + " ساخته نشد"
        برگشت ۱
    پایان
    ناپایا امن := تی سی پی.ارتقا به تی ال اس(اتصال، تی ال اس.پیکربندی جدید(میزبان))
    اگر وارونه تی ال اس.اتصال معتبر(امن):
        سرچاپ "TLS شکست خورد: " + تی ال اس.خطای اتصال(امن)
        برگشت ۱
    پایان
    تی ال اس.نوشتن(امن، "GET / HTTP/1.1\r\nHost: " + میزبان + "\r\nConnection: close\r\n\r\n")
    سرچاپ خط نخست(تی ال اس.خواندن(امن، ۴۰۹۶))
    تی ال اس.بستن اتصال(امن)
    برگشت ۰
پایان
