واردسازی شبکه.پراکسی
واردسازی شبکه.تی سی پی
واردسازی رشته

ناپایا شنونده := تی سی پی.سرور {}
ناپایا دیده‌شده := ""

تابع پراکسی ساختگی():
    ا := تی سی پی.پذیرش(شنونده)
    دیده‌شده = تی سی پی.خواندن(ا، ۴۰۹۶)
    تی سی پی.نوشتن(ا، "HTTP/1.1 200 Connection established\r\n\r\n")
    پیام := تی سی پی.خواندن(ا، ۱۰۰)
    تی سی پی.نوشتن(ا، "پژواک: " + پیام)
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    شنونده = تی سی پی.پیوند(۰)
    کارگر := نخ‌ساز(پراکسی ساختگی)
    پ := پراکسی.پراکسی اچ‌تی‌تی‌پی با احراز هویت("127.0.0.1:" + رشته.از عدد(تی سی پی.درگاه(شنونده) برگردان صحیح۶۴)، "ali"، "secret")
    اتصال := پراکسی.شماره‌گیری(پ، "example.com"، ۴۴۳)
    اگر وارونه تی سی پی.اتصال معتبر(اتصال):
        سرچاپ "پراکسی تونل را نپذیرفت"
        برگشت ۱
    پایان
    تی سی پی.نوشتن(اتصال، "سلام")
    سرچاپ تی سی پی.خواندن(اتصال، ۱۰۰)
    تی سی پی.بستن(اتصال)
    نخ‌پیوند(کارگر)
    چاپ رشته.جایگزینی(دیده‌شده، "\r\n"، "\n")
    تی سی پی.بستن سرور(شنونده)
    برگشت ۰
پایان
