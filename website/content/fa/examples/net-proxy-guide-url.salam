واردسازی شبکه.پراکسی
واردسازی رشته

تابع از نشانی(نشانی: رشته، خوب &: منطقی): پراکسی.پراکسی:
    خوب = درست
    ناپایا باقی := نشانی
    ناپایا ساکس := نادرست
    اگر رشته.شروع با(باقی، "socks5://"):
        ساکس = درست
        باقی = باقی.زیررشته(۹، باقی.طول() - ۹)
    وگرنه رشته.شروع با(باقی، "http://"):
        باقی = باقی.زیررشته(۷، باقی.طول() - ۷)
    وگرنه:
        خوب = نادرست
        برگشت پراکسی.پراکسی {}
    پایان
    ناپایا کاربر := ""
    ناپایا گذرواژه := ""
    جای اَت := باقی.بیاب("@")
    اگر جای اَت >= ۰:
        اعتبارنامه := باقی.زیررشته(۰، جای اَت)
        باقی = باقی.زیررشته(جای اَت + ۱، باقی.طول() - جای اَت - ۱)
        دونقطه := اعتبارنامه.بیاب(":")
        کاربر = اعتبارنامه.زیررشته(۰، دونقطه)
        گذرواژه = اعتبارنامه.زیررشته(دونقطه + ۱، اعتبارنامه.طول() - دونقطه - ۱)
    پایان
    اگر ساکس: برگشت پراکسی.پراکسی ساکس۵ با احراز هویت(باقی، کاربر، گذرواژه) پایان
    برگشت پراکسی.پراکسی اچ‌تی‌تی‌پی با احراز هویت(باقی، کاربر، گذرواژه)
پایان

تابع ریشه:
    نشانی‌ها := ["http://10.0.0.5:3128"، "socks5://127.0.0.1:9050"، "socks5://ali:s3cret@gw.example.net:1080"، "ftp://old.example.net:21"]
    هر ن در نشانی‌ها:
        ناپایا خوب := نادرست
        پ := از نشانی(ن، خوب)
        اگر وارونه خوب:
            سرچاپ ن، "-> پشتیبانی نمی‌شود"
            گذر
        پایان
        ناپایا نوع := "http"
        اگر پ.نوع == پراکسی.نوع ساکس۵: نوع = "socks5" پایان
        سرچاپ ن، "->"، نوع، پ.میزبان، پ.درگاه، "کاربر=[" + پ.نام کاربری + "]"
    پایان
پایان
