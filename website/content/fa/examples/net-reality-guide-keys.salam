// زبان: فارسی
واردسازی شبکه.ریالیتی

تابع ریشه:
    keys := ریالیتی.ساخت کلید()
    سرچاپ "private key length:"، keys.کلید خصوصی.طول()
    سرچاپ "public key length:"، keys.کلید عمومی.طول()
    سرچاپ "public matches private:"، ریالیتی.کلید عمومی از خصوصی(keys.کلید خصوصی) برابر keys.کلید عمومی

    sid := ریالیتی.شناسه کوتاه جدید(4)
    سرچاپ "short id digits:"، sid.طول()
    سرچاپ "valid short ids:"، ریالیتی.شناسه کوتاه معتبر(sid)، ریالیتی.شناسه کوتاه معتبر("abcd1234")، ریالیتی.شناسه کوتاه معتبر("zz")
    سرچاپ "valid public keys:"، ریالیتی.کلید عمومی معتبر(keys.کلید عمومی)، ریالیتی.کلید عمومی معتبر("short")
پایان
