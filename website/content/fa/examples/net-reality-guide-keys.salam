// زبان: فارسی
واردسازی شبکه.ریالیتی

تابع ریشه:
    کلیدها_محلی := ریالیتی.ساخت کلید()
    سرچاپ "طول کلید خصوصی:"، کلیدها_محلی.کلید خصوصی.طول()
    سرچاپ "طول کلید عمومی:"، کلیدها_محلی.کلید عمومی.طول()
    سرچاپ "عمومی با خصوصی می‌خواند:"، ریالیتی.کلید عمومی از خصوصی(کلیدها_محلی.کلید خصوصی) برابر کلیدها_محلی.کلید عمومی

    شناسه_نشست := ریالیتی.شناسه کوتاه جدید(4)
    سرچاپ "رقم‌های شناسه‌ی کوتاه:"، شناسه_نشست.طول()
    سرچاپ "شناسه‌های کوتاه معتبر:"، ریالیتی.شناسه کوتاه معتبر(شناسه_نشست)، ریالیتی.شناسه کوتاه معتبر("abcd1234")، ریالیتی.شناسه کوتاه معتبر("zz")
    سرچاپ "کلیدهای عمومی معتبر:"، ریالیتی.کلید عمومی معتبر(کلیدها_محلی.کلید عمومی)، ریالیتی.کلید عمومی معتبر("short")
پایان
