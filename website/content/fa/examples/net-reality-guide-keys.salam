// زبان: فارسی
واردسازی شبکه.ریالیتی

تابع ریشه:
    keys := ریالیتی.ساخت کلید()
    سرچاپ "طول کلید خصوصی:"، keys.کلید خصوصی.طول()
    سرچاپ "طول کلید عمومی:"، keys.کلید عمومی.طول()
    سرچاپ "عمومی با خصوصی می‌خواند:"، ریالیتی.کلید عمومی از خصوصی(keys.کلید خصوصی) برابر keys.کلید عمومی

    sid := ریالیتی.شناسه کوتاه جدید(4)
    سرچاپ "رقم‌های شناسه‌ی کوتاه:"، sid.طول()
    سرچاپ "شناسه‌های کوتاه معتبر:"، ریالیتی.شناسه کوتاه معتبر(sid)، ریالیتی.شناسه کوتاه معتبر("abcd1234")، ریالیتی.شناسه کوتاه معتبر("zz")
    سرچاپ "کلیدهای عمومی معتبر:"، ریالیتی.کلید عمومی معتبر(keys.کلید عمومی)، ریالیتی.کلید عمومی معتبر("short")
پایان
