// زبان: فارسی
واردسازی شبکه.ریالیتی
واردسازی شبکه.تی سی پی
واردسازی تی ال اس

ناپایا ss := ریالیتی.تنظیمات سرور {}

تابع decoy(arg: تهی*):
    srv := تی سی پی.سرور { توصیفگر = arg برگردان صحیح۶۴ }
    c := تی سی پی.پذیرش(srv)
    اگر تی سی پی.اتصال معتبر(c):
        تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "decoy site says hello")
        تی سی پی.بستن(c)
    پایان
پایان

تابع serve(arg: تهی*):
    srv := تی سی پی.سرور { توصیفگر = arg برگردان صحیح۶۴ }
    c := تی سی پی.پذیرش(srv)
    اگر وارونه تی سی پی.اتصال معتبر(c):
        برگشت
    پایان
    r := ریالیتی.پذیرش(c.توصیفگر، ss)
    اگر r.معتبر:
        ناپایا t := r.اتصال
        d := تی ال اس.خواندن(t، 4096)
        تی ال اس.نوشتن(t، "hello " + d + " from short id " + r.شناسه کوتاه)
        تی ال اس.بستن اتصال(t)
    پایان
پایان

تابع ریشه:
    keys := ریالیتی.ساخت کلید()
    dest := تی سی پی.پیوند(0)
    dth := نخ‌ساز(decoy، dest.توصیفگر برگردان تهی*)
    ss.کلید خصوصی = keys.کلید خصوصی
    ss.مقصد = "127.0.0.1:" + تی سی پی.درگاه(dest)
    ss.نام های سرور = "www.example.com"
    ss.شناسه های کوتاه = "abcd1234"

    srv := تی سی پی.پیوند(0)
    sth := نخ‌ساز(serve، srv.توصیفگر برگردان تهی*)
    c := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(srv))
    ناپایا s := ریالیتی.تنظیمات {}
    s.نام سرور = "www.example.com"
    s.کلید عمومی = keys.کلید عمومی
    s.شناسه کوتاه = "abcd1234"
    ناپایا t := ریالیتی.اتصال روی(c.توصیفگر، s)
    سرچاپ "کارخواه وصل شد:"، تی ال اس.اتصال معتبر(t)
    تی ال اس.نوشتن(t، "reality")
    سرچاپ تی ال اس.خواندن(t، 4096)
    تی ال اس.بستن اتصال(t)
    نخ‌پیوند(sth)
    تی سی پی.بستن(تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(dest)))
    نخ‌پیوند(dth)

    dest2 := تی سی پی.پیوند(0)
    dth2 := نخ‌ساز(decoy، dest2.توصیفگر برگردان تهی*)
    ss.مقصد = "127.0.0.1:" + تی سی پی.درگاه(dest2)
    srv2 := تی سی پی.پیوند(0)
    sth2 := نخ‌ساز(serve، srv2.توصیفگر برگردان تهی*)
    p := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(srv2))
    تی سی پی.نوشتن(p، "GET / HTTP/1.1\r\nHost: www.example.com\r\n\r\n")
    سرچاپ "کاوشگر این را می‌گیرد:"، تی سی پی.خواندن(p، 4096)
    تی سی پی.بستن(p)
    نخ‌پیوند(sth2)
    نخ‌پیوند(dth2)
    تی سی پی.بستن سرور(srv)
    تی سی پی.بستن سرور(srv2)
    تی سی پی.بستن سرور(dest)
    تی سی پی.بستن سرور(dest2)
پایان
