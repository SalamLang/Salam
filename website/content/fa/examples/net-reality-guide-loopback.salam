// زبان: فارسی
واردسازی شبکه.ریالیتی
واردسازی شبکه.تی سی پی
واردسازی تی ال اس

ناپایا سوکت_کارساز := ریالیتی.تنظیمات سرور {}

تابع فریب(آرگومان: تهی*):
    کارساز := تی سی پی.سرور { توصیفگر = آرگومان برگردان صحیح۶۴ }
    نویسه := تی سی پی.پذیرش(کارساز)
    اگر تی سی پی.اتصال معتبر(نویسه):
        تی سی پی.خواندن(نویسه، 4096)
        تی سی پی.نوشتن(نویسه، "decoy site says hello")
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع سرویس(آرگومان: تهی*):
    کارساز := تی سی پی.سرور { توصیفگر = آرگومان برگردان صحیح۶۴ }
    نویسه := تی سی پی.پذیرش(کارساز)
    اگر وارونه تی سی پی.اتصال معتبر(نویسه):
        برگشت
    پایان
    پاسخ_محلی := ریالیتی.پذیرش(نویسه.توصیفگر، سوکت_کارساز)
    اگر پاسخ_محلی.معتبر:
        ناپایا موقت := پاسخ_محلی.اتصال
        مقصد_محلی := تی ال اس.خواندن(موقت، 4096)
        تی ال اس.نوشتن(موقت، "hello " + مقصد_محلی + " from short id " + پاسخ_محلی.شناسه کوتاه)
        تی ال اس.بستن اتصال(موقت)
    پایان
پایان

تابع ریشه:
    کلیدها_محلی := ریالیتی.ساخت کلید()
    مقصد := تی سی پی.پیوند(0)
    رشته_مقصد := نخ‌ساز(فریب، مقصد.توصیفگر برگردان تهی*)
    سوکت_کارساز.کلید خصوصی = کلیدها_محلی.کلید خصوصی
    سوکت_کارساز.مقصد = "127.0.0.1:" + تی سی پی.درگاه(مقصد)
    سوکت_کارساز.نام های سرور = "www.example.com"
    سوکت_کارساز.شناسه های کوتاه = "abcd1234"

    کارساز := تی سی پی.پیوند(0)
    رشته_کارساز := نخ‌ساز(سرویس، کارساز.توصیفگر برگردان تهی*)
    نویسه := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(کارساز))
    ناپایا متن_نمونه := ریالیتی.تنظیمات {}
    متن_نمونه.نام سرور = "www.example.com"
    متن_نمونه.کلید عمومی = کلیدها_محلی.کلید عمومی
    متن_نمونه.شناسه کوتاه = "abcd1234"
    ناپایا موقت := ریالیتی.اتصال روی(نویسه.توصیفگر، متن_نمونه)
    سرچاپ "کارخواه وصل شد:"، تی ال اس.اتصال معتبر(موقت)
    تی ال اس.نوشتن(موقت، "reality")
    سرچاپ تی ال اس.خواندن(موقت، 4096)
    تی ال اس.بستن اتصال(موقت)
    نخ‌پیوند(رشته_کارساز)
    تی سی پی.بستن(تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(مقصد)))
    نخ‌پیوند(رشته_مقصد)

    مقصد۲ := تی سی پی.پیوند(0)
    رشته_مقصد۲ := نخ‌ساز(فریب، مقصد۲.توصیفگر برگردان تهی*)
    سوکت_کارساز.مقصد = "127.0.0.1:" + تی سی پی.درگاه(مقصد۲)
    کارساز۲ := تی سی پی.پیوند(0)
    رشته_کارساز۲ := نخ‌ساز(سرویس، کارساز۲.توصیفگر برگردان تهی*)
    ویژگی_محلی := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(کارساز۲))
    تی سی پی.نوشتن(ویژگی_محلی، "GET / HTTP/1.1\r\nHost: www.example.com\r\n\r\n")
    سرچاپ "کاوشگر این را می‌گیرد:"، تی سی پی.خواندن(ویژگی_محلی، 4096)
    تی سی پی.بستن(ویژگی_محلی)
    نخ‌پیوند(رشته_کارساز۲)
    نخ‌پیوند(رشته_مقصد۲)
    تی سی پی.بستن سرور(کارساز)
    تی سی پی.بستن سرور(کارساز۲)
    تی سی پی.بستن سرور(مقصد)
    تی سی پی.بستن سرور(مقصد۲)
پایان
