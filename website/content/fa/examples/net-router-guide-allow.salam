واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع فهرست سفارش‌ها(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "سفارش‌ها") پایان
تابع ثبت سفارش(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "ثبت شد") پایان

تابع روش‌های مجاز(م: مسیریاب.مسیریاب، مسیر: رشته): رشته:
    روش‌ها := ["GET"، "POST"، "PUT"، "PATCH"، "DELETE"]
    ناپایا خروجی := ""
    هر ر در روش‌ها:
        ناپایا یافته := مسیریاب.اعزام(م، ر، مسیر)
        اگر یافته.پیدا شد:
            اگر خروجی.طول() > ۰: خروجی += ", " پایان
            خروجی += ر
        پایان
        مسیریاب.آزادسازی تطابق(یافته)
    پایان
    برگشت خروجی
پایان

تابع پاسخ بده(م: مسیریاب.مسیریاب، روش: رشته، مسیر: رشته):
    ناپایا ت := مسیریاب.اعزام(م، روش، مسیر)
    اگر ت.پیدا شد:
        سرچاپ روش، مسیر، "-> ۲۰۰"
    وگرنه:
        مجاز := روش‌های مجاز(م، مسیر)
        اگر مجاز.طول() > ۰:
            سرچاپ روش، مسیر، "-> ۴۰۵، Allow:"، مجاز
        وگرنه:
            سرچاپ روش، مسیر، "-> ۴۰۴"
        پایان
    پایان
    مسیریاب.آزادسازی تطابق(ت)
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/orders"، فهرست سفارش‌ها)
    مسیریاب.ارسال(م، "/orders"، ثبت سفارش)
    پاسخ بده(م، "GET"، "/orders")
    پاسخ بده(م، "DELETE"، "/orders")
    پاسخ بده(م، "GET"، "/invoices")
پایان
