واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع خودم(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "خودم") پایان
تابع کاربر(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "کاربر") پایان
تابع دارایی‌ها(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "دارایی‌ها") پایان
تابع صفحه عمومی(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "صفحه") پایان

تابع نام رسیدگی‌کننده(تابع‌ک: صحیح۶۴): رشته:
    اگر تابع‌ک == خودم: برگشت "خودم" پایان
    اگر تابع‌ک == کاربر: برگشت "کاربر" پایان
    اگر تابع‌ک == دارایی‌ها: برگشت "دارایی‌ها" پایان
    اگر تابع‌ک == صفحه عمومی: برگشت "صفحه" پایان
    برگشت "?"
پایان

تابع نشان بده(م: مسیریاب.مسیریاب، روش: رشته، مسیر: رشته):
    ناپایا ت := مسیریاب.اعزام(م، روش، مسیر)
    اگر ت.پیدا شد:
        سرچاپ روش، مسیر، "->"، نام رسیدگی‌کننده(ت.گرداننده)، ت.پارامترها.اقلام.طول()، "پارامتر"
    وگرنه:
        سرچاپ روش، مسیر، "-> مسیری نیست"
    پایان
    مسیریاب.آزادسازی تطابق(ت)
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/assets/*"، دارایی‌ها)
    مسیریاب.دریافت(م، "/users/:name"، کاربر)
    مسیریاب.دریافت(م، "/users/me"، خودم)
    مسیریاب.دریافت(م، "/*"، صفحه عمومی)

    نشان بده(م، "GET"، "/users/me")
    نشان بده(م، "GET"، "/users/sara")
    نشان بده(م، "GET"، "/users/sara/")
    نشان بده(م، "GET"، "/users/me/")
    نشان بده(م، "GET"، "/assets/css/site.css")
    نشان بده(م، "GET"، "/about")
    نشان بده(م، "HEAD"، "/users/sara")
    نشان بده(م، "POST"، "/users/sara")
پایان
