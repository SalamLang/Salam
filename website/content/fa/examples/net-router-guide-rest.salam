واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع فهرست یادداشت‌ها(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "همه یادداشت‌ها") پایان
تابع ساخت یادداشت(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "ساخته شد") پایان
تابع نمایش یادداشت(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "یک یادداشت") پایان
تابع ویرایش یادداشت(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "ویرایش شد") پایان
تابع حذف یادداشت(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "حذف شد") پایان

تابع نام رسیدگی‌کننده(تابع‌ک: صحیح۶۴): رشته:
    اگر تابع‌ک == فهرست یادداشت‌ها: برگشت "فهرست یادداشت‌ها" پایان
    اگر تابع‌ک == ساخت یادداشت: برگشت "ساخت یادداشت" پایان
    اگر تابع‌ک == نمایش یادداشت: برگشت "نمایش یادداشت" پایان
    اگر تابع‌ک == ویرایش یادداشت: برگشت "ویرایش یادداشت" پایان
    اگر تابع‌ک == حذف یادداشت: برگشت "حذف یادداشت" پایان
    برگشت "?"
پایان

تابع امتحان درخواست(م: مسیریاب.مسیریاب، روش: رشته، مسیر: رشته):
    ناپایا ت := مسیریاب.اعزام(م، روش، مسیر)
    اگر ت.پیدا شد:
        شناسه := مسیریاب.دریافت پارامتر(ت، "id")
        اگر شناسه.طول() > ۰:
            سرچاپ روش، مسیر، "->"، نام رسیدگی‌کننده(ت.گرداننده)، "با شناسه"، شناسه
        وگرنه:
            سرچاپ روش، مسیر، "->"، نام رسیدگی‌کننده(ت.گرداننده)
        پایان
    وگرنه:
        سرچاپ روش، مسیر، "-> ۴۰۴"
    پایان
    مسیریاب.آزادسازی تطابق(ت)
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/notes"، فهرست یادداشت‌ها)
    مسیریاب.ارسال(م، "/notes"، ساخت یادداشت)
    مسیریاب.دریافت(م، "/notes/:id"، نمایش یادداشت)
    مسیریاب.قراردادن(م، "/notes/:id"، ویرایش یادداشت)
    مسیریاب.حذف(م، "/notes/:id"، حذف یادداشت)

    امتحان درخواست(م، "GET"، "/notes")
    امتحان درخواست(م، "POST"، "/notes")
    امتحان درخواست(م، "GET"، "/notes/17")
    امتحان درخواست(م، "PUT"، "/notes/17")
    امتحان درخواست(م، "DELETE"، "/notes/17")
    امتحان درخواست(م، "DELETE"، "/notes")
    امتحان درخواست(م، "GET"، "/notes/17/comments")
پایان
