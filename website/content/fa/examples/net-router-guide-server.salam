واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع نمایش برچسب(زمینه: صحیح۶۴):
    خام := اچ تی تی پی.پارامتر(زمینه، "tag")
    اچ تی تی پی.متن(زمینه، "raw=" + خام + " decoded=" + اچ تی تی پی.رمزگشایی نشانی(خام))
پایان

تابع نمایش نوشته(زمینه: صحیح۶۴):
    اچ تی تی پی.جیسون(زمینه، "{\"post\":\"" + اچ تی تی پی.پارامتر(زمینه، "slug") + "\",\"page\":\"" + اچ تی تی پی.پرسمان(زمینه، "page") + "\"}")
پایان

تابع دیرهنگام(زمینه: صحیح۶۴): اچ تی تی پی.متن(زمینه، "late") پایان

تابع بگیر(مسیر: رشته):
    پاسخ := اچ تی تی پی.دریافت("http://127.0.0.1:18589" + مسیر)
    سرچاپ مسیر، پاسخ.وضعیت، پاسخ.بدنه
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/tags/:tag"، نمایش برچسب)
    مسیریاب.دریافت(م، "/blog/:slug"، نمایش نوشته)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۸۵۸۹)
    اچ تی تی پی.تنظیم میزبان(س، "127.0.0.1")
    اچ تی تی پی.استفاده(س، م)
    مسیریاب.دریافت(م، "/late"، دیرهنگام)
    اگر وارونه اچ تی تی پی.اجرا در پس زمینه(س):
        سرچاپ "درگاه ۱۸۵۸۹ گرفته است"
        برگشت ۱
    پایان
    بگیر("/tags/open%20source")
    بگیر("/blog/hello-salam?page=2")
    بگیر("/late")
    برگشت ۰
پایان
