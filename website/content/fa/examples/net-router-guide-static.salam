واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی سیستم عامل

تابع وضعیت(زمینه: صحیح۶۴): اچ تی تی پی.جیسون(زمینه، "{\"ok\":true}") پایان

تابع بگیر(مسیر: رشته):
    پاسخ := اچ تی تی پی.دریافت("http://127.0.0.1:18588" + مسیر)
    سرچاپ مسیر، پاسخ.وضعیت، اچ تی تی پی.دریافت سرصفحه(پاسخ، "Content-Type")
پایان

تابع ریشه:
    سیستم عامل.ساخت پوشه ها("public/css")
    سیستم عامل.نوشتن پرونده("public/index.html"، "<h1>سلام</h1>")
    سیستم عامل.نوشتن پرونده("public/css/site.css"، "h1 { color: teal }")

    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/api/status"، وضعیت)
    مسیریاب.ایستا(م، "/"، "public")
    ناپایا س := اچ تی تی پی.سرور جدید(۱۸۵۸۸)
    اچ تی تی پی.تنظیم میزبان(س، "127.0.0.1")
    اچ تی تی پی.استفاده(س، م)
    اگر وارونه اچ تی تی پی.اجرا در پس زمینه(س):
        سرچاپ "درگاه ۱۸۵۸۸ گرفته است"
        برگشت ۱
    پایان
    بگیر("/")
    بگیر("/css/site.css")
    بگیر("/api/status")
    بگیر("/missing.png")
    سیستم عامل.حذف همه("public")
    برگشت ۰
پایان
