واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع کاربران نسخه۱(زمینه: صحیح۶۴): اچ تی تی پی.جیسون(زمینه، "[\"ali\"]") پایان
تابع کاربران نسخه۲(زمینه: صحیح۶۴): اچ تی تی پی.جیسون(زمینه، "{\"users\":[\"ali\"]}") پایان
تابع کاربر نسخه۲(زمینه: صحیح۶۴): اچ تی تی پی.جیسون(زمینه، "{}") پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    ن۱ := "/api/v1"
    ن۲ := "/api/v2"
    مسیریاب.گروه(م، ن۱، "GET"، "/users"، کاربران نسخه۱)
    مسیریاب.گروه(م، ن۲، "GET"، "/users"، کاربران نسخه۲)
    مسیریاب.گروه(م، ن۲، "GET"، "/users/:id"، کاربر نسخه۲)

    هر مس در م.مسیرها:
        سرچاپ مس.روش، مس.الگو
    پایان
    ناپایا ت := مسیریاب.اعزام(م، "GET"، "/api/v2/users/5")
    سرچاپ ت.گرداننده == کاربر نسخه۲، مسیریاب.دریافت پارامتر(ت، "id")
    مسیریاب.آزادسازی تطابق(ت)
    ناپایا قدیمی := مسیریاب.اعزام(م، "GET"، "/api/v1/users")
    سرچاپ قدیمی.گرداننده == کاربران نسخه۱
    مسیریاب.آزادسازی تطابق(قدیمی)
پایان
