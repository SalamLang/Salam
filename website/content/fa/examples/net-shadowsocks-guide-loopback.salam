واردسازی حافظه
واردسازی شبکه.شدوساکس

پایا PASSWORD := "correct horse"

ناپایا srv := شدوساکس.سرور {}
ناپایا seen := ""

تابع answer(c: شدوساکس.اتصال):
    t := شدوساکس.مقصد اتصال(c)
    seen = t.میزبان + ":" + t.درگاه
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    n := شدوساکس.خواندن(c، buf، 4096)
    شدوساکس.نوشتن(c، buf، n)
    حافظه.آزادسازی(buf)
    شدوساکس.بستن(c)
پایان

تابع serve():
    شدوساکس.خدمت(srv، (c: شدوساکس.اتصال): answer(c) پایان)
پایان

تابع ریشه:
    srv = شدوساکس.گوش دادن(0، "chacha20-ietf-poly1305"، PASSWORD)
    سرچاپ شدوساکس.سرور معتبر(srv)
    t := نخ‌ساز(serve)

    cfg := شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور(srv)، روش = "chacha20-ietf-poly1305"، گذرواژه = PASSWORD }
    c := شدوساکس.برقراری اتصال(cfg، "example.com"، 443)
    سرچاپ شدوساکس.معتبر(c)
    شدوساکس.نوشتن رشته(c، "hello through shadowsocks")
    سرچاپ شدوساکس.خواندن رشته(c، 4096)
    شدوساکس.بستن(c)

    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(t)
    شدوساکس.نابودی سرور(srv)
    سرچاپ "server saw"، seen
پایان
