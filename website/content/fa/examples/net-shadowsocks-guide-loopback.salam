واردسازی حافظه
واردسازی شبکه.شدوساکس

پایا PASSWORD := "correct horse"

ناپایا کارساز := شدوساکس.سرور {}
ناپایا دیده := ""

تابع answer(نویسه: شدوساکس.اتصال):
    موقت := شدوساکس.مقصد اتصال(نویسه)
    دیده = موقت.میزبان + ":" + موقت.درگاه
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    شمار_بایت := شدوساکس.خواندن(نویسه، بافر، 4096)
    شدوساکس.نوشتن(نویسه، بافر، شمار_بایت)
    حافظه.آزادسازی(بافر)
    شدوساکس.بستن(نویسه)
پایان

تابع serve():
    شدوساکس.خدمت(کارساز، (نویسه: شدوساکس.اتصال): answer(نویسه) پایان)
پایان

تابع ریشه:
    کارساز = شدوساکس.گوش دادن(0، "chacha20-ietf-poly1305"، PASSWORD)
    سرچاپ شدوساکس.سرور معتبر(کارساز)
    موقت := نخ‌ساز(serve)

    پیکربندی := شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور(کارساز)، روش = "chacha20-ietf-poly1305"، گذرواژه = PASSWORD }
    نویسه := شدوساکس.برقراری اتصال(پیکربندی، "example.com"، 443)
    سرچاپ شدوساکس.معتبر(نویسه)
    شدوساکس.نوشتن رشته(نویسه، "hello through shadowsocks")
    سرچاپ شدوساکس.خواندن رشته(نویسه، 4096)
    شدوساکس.بستن(نویسه)

    شدوساکس.توقف سرور(کارساز)
    نخ‌پیوند(موقت)
    شدوساکس.نابودی سرور(کارساز)
    سرچاپ "سرور دید"، دیده
پایان
