واردسازی شبکه.شدوساکس

تابع show(name: رشته):
    m := شدوساکس.یافتن روش(name)
    سرچاپ m.نام، m.معتبر، m.طول کلید، m.طول نمک، m.نسخه۲۰۲۲
پایان

تابع ریشه:
    show("aes-128-gcm")
    show("aes-256-gcm")
    show("chacha20-ietf-poly1305")
    show("2022-blake3-aes-128-gcm")
    show("2022-blake3-aes-256-gcm")
    show("2022-blake3-chacha20-poly1305")
    show("rc4-md5")
پایان
