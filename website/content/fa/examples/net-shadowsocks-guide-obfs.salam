واردسازی حافظه
واردسازی شبکه.شدوساکس

ناپایا srv := شدوساکس.سرور {}

تابع answer(c: شدوساکس.اتصال):
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    n := شدوساکس.خواندن(c، buf، 4096)
    شدوساکس.نوشتن(c، buf، n)
    حافظه.آزادسازی(buf)
    شدوساکس.بستن(c)
پایان

تابع serve():
    شدوساکس.خدمت(srv، (c: شدوساکس.اتصال): answer(c) پایان)
پایان

تابع ریشه:
    srv = شدوساکس.گوش دادن با پوشش(0، "chacha20-ietf-poly1305"، "pw"، "http")
    t := نخ‌ساز(serve)

    cfg := شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور(srv)، روش = "chacha20-ietf-poly1305"، گذرواژه = "pw"، پوشش = "http"، میزبان پوشش = "cdn.example.com" }
    c := شدوساکس.برقراری اتصال(cfg، "example.com"، 80)
    شدوساکس.نوشتن رشته(c، "inside an http disguise")
    سرچاپ شدوساکس.خواندن رشته(c، 4096)
    شدوساکس.بستن(c)

    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(t)
    شدوساکس.نابودی سرور(srv)
پایان
