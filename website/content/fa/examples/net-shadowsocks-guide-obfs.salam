واردسازی حافظه
واردسازی شبکه.شدوساکس

ناپایا کارساز := شدوساکس.سرور {}

تابع answer(نویسه: شدوساکس.اتصال):
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    شمار_بایت := شدوساکس.خواندن(نویسه، بافر، 4096)
    شدوساکس.نوشتن(نویسه، بافر، شمار_بایت)
    حافظه.آزادسازی(بافر)
    شدوساکس.بستن(نویسه)
پایان

تابع serve():
    شدوساکس.خدمت(کارساز، (نویسه: شدوساکس.اتصال): answer(نویسه) پایان)
پایان

تابع ریشه:
    کارساز = شدوساکس.گوش دادن با پوشش(0، "chacha20-ietf-poly1305"، "pw"، "http")
    موقت := نخ‌ساز(serve)

    پیکربندی := شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور(کارساز)، روش = "chacha20-ietf-poly1305"، گذرواژه = "pw"، پوشش = "http"، میزبان پوشش = "cdn.example.com" }
    نویسه := شدوساکس.برقراری اتصال(پیکربندی، "example.com"، 80)
    شدوساکس.نوشتن رشته(نویسه، "inside an http disguise")
    سرچاپ شدوساکس.خواندن رشته(نویسه، 4096)
    شدوساکس.بستن(نویسه)

    شدوساکس.توقف سرور(کارساز)
    نخ‌پیوند(موقت)
    شدوساکس.نابودی سرور(کارساز)
پایان
