واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی شبکه.شدوساکس

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع server():
    carrier := تی سی پی.پیوند(0)
    port = تی سی پی.درگاه(carrier)
    srv := شدوساکس.گوش دادن(0، "aes-128-gcm"، "inner")
    همگام سازی.اتمام(ready)
    raw := تی سی پی.پذیرش(carrier)
    c := شدوساکس.پذیرش روی جریان(srv، تونل.جریان تی سی پی { اتصال = raw })
    اگر شدوساکس.معتبر(c):
        buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
        n := شدوساکس.خواندن(c، buf، 4096)
        شدوساکس.نوشتن(c، buf، n)
        حافظه.آزادسازی(buf)
        شدوساکس.بستن(c)
    پایان
    شدوساکس.نابودی سرور(srv)
    تی سی پی.بستن سرور(carrier)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)

    link := تونل.جریان تی سی پی { اتصال = تی سی پی.شماره گیری("127.0.0.1"، port) }
    cfg := شدوساکس.پیکربندی { روش = "aes-128-gcm"، گذرواژه = "inner" }
    c := شدوساکس.اتصال روی جریان(link، cfg، "example.com"، 443)
    شدوساکس.نوشتن رشته(c، "any stream will do")
    سرچاپ شدوساکس.خواندن رشته(c، 4096)

    s := شدوساکس.به عنوان جریان(c)
    سرچاپ s.معتبر()
    شدوساکس.بستن(c)
    نخ‌پیوند(t)
پایان
