واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی شبکه.شدوساکس

ناپایا درگاه := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع server():
    حامل := تی سی پی.پیوند(0)
    درگاه = تی سی پی.درگاه(حامل)
    کارساز := شدوساکس.گوش دادن(0، "aes-128-gcm"، "inner")
    همگام سازی.اتمام(آماده)
    خام := تی سی پی.پذیرش(حامل)
    نویسه := شدوساکس.پذیرش روی جریان(کارساز، تونل.جریان تی سی پی { اتصال = خام })
    اگر شدوساکس.معتبر(نویسه):
        بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
        شمار_بایت := شدوساکس.خواندن(نویسه، بافر، 4096)
        شدوساکس.نوشتن(نویسه، بافر، شمار_بایت)
        حافظه.آزادسازی(بافر)
        شدوساکس.بستن(نویسه)
    پایان
    شدوساکس.نابودی سرور(کارساز)
    تی سی پی.بستن سرور(حامل)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(server)
    همگام سازی.انتظار(آماده)

    پیوند_محلی := تونل.جریان تی سی پی { اتصال = تی سی پی.شماره گیری("127.0.0.1"، درگاه) }
    پیکربندی := شدوساکس.پیکربندی { روش = "aes-128-gcm"، گذرواژه = "inner" }
    نویسه := شدوساکس.اتصال روی جریان(پیوند_محلی، پیکربندی، "example.com"، 443)
    شدوساکس.نوشتن رشته(نویسه، "any stream will do")
    سرچاپ شدوساکس.خواندن رشته(نویسه، 4096)

    متن_نمونه := شدوساکس.به عنوان جریان(نویسه)
    سرچاپ متن_نمونه.معتبر()
    شدوساکس.بستن(نویسه)
    نخ‌پیوند(موقت)
پایان
