واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.شدوساکس

ناپایا هدف := تی سی پی.سرور {}
ناپایا کارساز := شدوساکس.سرور {}

تابع پژواک():
    نویسه := تی سی پی.پذیرش(هدف)
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    شمار_بایت := تی سی پی.خواندن بایت(نویسه، بافر، 4096)
    تی سی پی.نوشتن بایت(نویسه، بافر، شمار_بایت)
    حافظه.آزادسازی(بافر)
    تی سی پی.بستن(نویسه)
پایان

تابع سرویس():
    شدوساکس.خدمت رله(کارساز)
پایان

تابع ریشه:
    هدف = تی سی پی.پیوند(0)
    پژواک_رشته := نخ‌ساز(پژواک)

    کارساز = شدوساکس.گوش دادن(0، "aes-256-gcm"، "relay password")
    کارساز_رشته := نخ‌ساز(سرویس)

    پیکربندی := شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور(کارساز)، روش = "aes-256-gcm"، گذرواژه = "relay password" }
    نویسه := شدوساکس.برقراری اتصال(پیکربندی، "127.0.0.1"، تی سی پی.درگاه(هدف))
    شدوساکس.نوشتن رشته(نویسه، "through the relay")
    سرچاپ شدوساکس.خواندن رشته(نویسه، 4096)
    شدوساکس.بستن(نویسه)

    نخ‌پیوند(پژواک_رشته)
    شدوساکس.توقف سرور(کارساز)
    نخ‌پیوند(کارساز_رشته)
    شدوساکس.نابودی سرور(کارساز)
    تی سی پی.بستن سرور(هدف)
پایان
