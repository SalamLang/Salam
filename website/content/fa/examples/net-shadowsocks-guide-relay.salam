واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.شدوساکس

ناپایا target := تی سی پی.سرور {}
ناپایا srv := شدوساکس.سرور {}

تابع echo():
    c := تی سی پی.پذیرش(target)
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    n := تی سی پی.خواندن بایت(c، buf، 4096)
    تی سی پی.نوشتن بایت(c، buf، n)
    حافظه.آزادسازی(buf)
    تی سی پی.بستن(c)
پایان

تابع serve():
    شدوساکس.خدمت رله(srv)
پایان

تابع ریشه:
    target = تی سی پی.پیوند(0)
    te := نخ‌ساز(echo)

    srv = شدوساکس.گوش دادن(0، "aes-256-gcm"، "relay password")
    ts := نخ‌ساز(serve)

    cfg := شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور(srv)، روش = "aes-256-gcm"، گذرواژه = "relay password" }
    c := شدوساکس.برقراری اتصال(cfg، "127.0.0.1"، تی سی پی.درگاه(target))
    شدوساکس.نوشتن رشته(c، "through the relay")
    سرچاپ شدوساکس.خواندن رشته(c، 4096)
    شدوساکس.بستن(c)

    نخ‌پیوند(te)
    شدوساکس.توقف سرور(srv)
    نخ‌پیوند(ts)
    شدوساکس.نابودی سرور(srv)
    تی سی پی.بستن سرور(target)
پایان
