واردسازی حافظه
واردسازی رشته
واردسازی شبکه.یو دی پی
واردسازی شبکه.شدوساکس

ناپایا سوکت_پژواک := یو دی پی.سوکت یو دی پی {}
ناپایا بازپخش := شدوساکس.سرور یو دی پی {}

تابع echo():
    بافر := حافظه.تخصیص(2000 برگردان طبیعی۶۴)
    ناپایا میزبان := ""
    ناپایا درگاه := 0
    شمار_بایت := یو دی پی.دریافت بایت(سوکت_پژواک، بافر، 2000، میزبان، درگاه)
    یو دی پی.ارسال بایت(سوکت_پژواک، میزبان، درگاه، بافر، شمار_بایت)
    حافظه.آزادسازی(بافر)
پایان

تابع serve():
    شدوساکس.خدمت یو دی پی(بازپخش)
پایان

تابع ریشه:
    سوکت_پژواک = یو دی پی.پیوند(0)
    بازپخش = شدوساکس.گوش دادن یو دی پی(0، "chacha20-ietf-poly1305"، "udp password")
    پژواک_رشته := نخ‌ساز(echo)
    کارساز_رشته := نخ‌ساز(serve)

    پیکربندی := شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور یو دی پی(بازپخش)، روش = "chacha20-ietf-poly1305"، گذرواژه = "udp password" }
    نویسه := شدوساکس.اتصال یو دی پی(پیکربندی)
    شدوساکس.مهلت یو دی پی(نویسه، 3000)
    شدوساکس.ارسال یو دی پی(نویسه، "127.0.0.1"، یو دی پی.درگاه(سوکت_پژواک)، "ping" برگردان تهی*، 4)

    بافر := حافظه.تخصیص صفرشده(2000 برگردان طبیعی۶۴)
    ناپایا متغیر_from := شدوساکس.مقصد {}
    شمار_بایت := شدوساکس.دریافت یو دی پی(نویسه، بافر، 1999، متغیر_from)
    سرچاپ رشته.زیررشته(بافر برگردان رشته، 0، شمار_بایت)، متغیر_from.میزبان، متغیر_from.درگاه برابر یو دی پی.درگاه(سوکت_پژواک)

    حافظه.آزادسازی(بافر)
    نخ‌پیوند(پژواک_رشته)
    شدوساکس.توقف یو دی پی(بازپخش)
    نخ‌پیوند(کارساز_رشته)
    شدوساکس.بستن یو دی پی(نویسه)
    شدوساکس.نابودی یو دی پی(بازپخش)
    یو دی پی.بستن(سوکت_پژواک)
پایان
