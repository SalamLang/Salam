واردسازی حافظه
واردسازی رشته
واردسازی شبکه.یو دی پی
واردسازی شبکه.شدوساکس

ناپایا echo_sock := یو دی پی.سوکت یو دی پی {}
ناپایا relay := شدوساکس.سرور یو دی پی {}

تابع echo():
    buf := حافظه.تخصیص(2000 برگردان طبیعی۶۴)
    ناپایا host := ""
    ناپایا port := 0
    n := یو دی پی.دریافت بایت(echo_sock، buf، 2000، host، port)
    یو دی پی.ارسال بایت(echo_sock، host، port، buf، n)
    حافظه.آزادسازی(buf)
پایان

تابع serve():
    شدوساکس.خدمت یو دی پی(relay)
پایان

تابع ریشه:
    echo_sock = یو دی پی.پیوند(0)
    relay = شدوساکس.گوش دادن یو دی پی(0، "chacha20-ietf-poly1305"، "udp password")
    te := نخ‌ساز(echo)
    ts := نخ‌ساز(serve)

    cfg := شدوساکس.پیکربندی { میزبان = "127.0.0.1"، درگاه = شدوساکس.درگاه سرور یو دی پی(relay)، روش = "chacha20-ietf-poly1305"، گذرواژه = "udp password" }
    c := شدوساکس.اتصال یو دی پی(cfg)
    شدوساکس.مهلت یو دی پی(c، 3000)
    شدوساکس.ارسال یو دی پی(c، "127.0.0.1"، یو دی پی.درگاه(echo_sock)، "ping" برگردان تهی*، 4)

    buf := حافظه.تخصیص صفرشده(2000 برگردان طبیعی۶۴)
    ناپایا from := شدوساکس.مقصد {}
    n := شدوساکس.دریافت یو دی پی(c، buf، 1999، from)
    سرچاپ رشته.زیررشته(buf برگردان رشته، 0، n)، from.میزبان، from.درگاه برابر یو دی پی.درگاه(echo_sock)

    حافظه.آزادسازی(buf)
    نخ‌پیوند(te)
    شدوساکس.توقف یو دی پی(relay)
    نخ‌پیوند(ts)
    شدوساکس.بستن یو دی پی(c)
    شدوساکس.نابودی یو دی پی(relay)
    یو دی پی.بستن(echo_sock)
پایان
