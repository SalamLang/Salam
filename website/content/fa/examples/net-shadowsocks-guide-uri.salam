واردسازی شبکه.شدوساکس

تابع ریشه:
    u := شدوساکس.تجزیه نشانی("ss://Y2hhY2hhMjAtaWV0Zi1wb2x5MTMwNTpzZWNyZXQ@203.0.113.5:8388/?plugin=obfs-local%3Bobfs%3Dtls%3Bobfs-host%3Dcdn.example.com#my%20server")
    سرچاپ u.معتبر، u.روش، u.گذرواژه، u.میزبان، u.درگاه، u.برچسب
    سرچاپ u.افزونه

    p := شدوساکس.تجزیه افزونه(u.افزونه)
    سرچاپ p.نام، شدوساکس.گرفتن گزینه افزونه(p، "obfs"، "")، شدوساکس.گزینه افزونه موجود است(p، "obfs-host")، شدوساکس.گزینه افزونه موجود است(p، "missing")
    شدوساکس.آزادسازی افزونه(p)

    cfg := شدوساکس.تبدیل به پیکربندی(u)
    سرچاپ cfg.میزبان، cfg.درگاه، cfg.روش، cfg.پوشش، cfg.میزبان پوشش

    سرچاپ شدوساکس.قالب بندی نشانی(u)
    bad := شدوساکس.تجزیه نشانی("ss://not-a-link")
    سرچاپ bad.معتبر
پایان
