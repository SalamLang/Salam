واردسازی شبکه.شدوساکس

تابع ریشه:
    نشانی_مقدار := شدوساکس.تجزیه نشانی("ss://Y2hhY2hhMjAtaWV0Zi1wb2x5MTMwNTpzZWNyZXQ@203.0.113.5:8388/?plugin=obfs-local%3Bobfs%3Dtls%3Bobfs-host%3Dcdn.example.com#my%20server")
    سرچاپ نشانی_مقدار.معتبر، نشانی_مقدار.روش، نشانی_مقدار.گذرواژه، نشانی_مقدار.میزبان، نشانی_مقدار.درگاه، نشانی_مقدار.برچسب
    سرچاپ نشانی_مقدار.افزونه

    ویژگی_محلی := شدوساکس.تجزیه افزونه(نشانی_مقدار.افزونه)
    سرچاپ ویژگی_محلی.نام، شدوساکس.گرفتن گزینه افزونه(ویژگی_محلی، "obfs"، "")، شدوساکس.گزینه افزونه موجود است(ویژگی_محلی، "obfs-host")، شدوساکس.گزینه افزونه موجود است(ویژگی_محلی، "missing")
    شدوساکس.آزادسازی افزونه(ویژگی_محلی)

    پیکربندی := شدوساکس.تبدیل به پیکربندی(نشانی_مقدار)
    سرچاپ پیکربندی.میزبان، پیکربندی.درگاه، پیکربندی.روش، پیکربندی.پوشش، پیکربندی.میزبان پوشش

    سرچاپ شدوساکس.قالب بندی نشانی(نشانی_مقدار)
    بد := شدوساکس.تجزیه نشانی("ss://not-a-link")
    سرچاپ بد.معتبر
پایان
