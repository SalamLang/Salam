واردسازی شبکه.سوکت‌آیاو
واردسازی شبکه.وب‌سوکت
واردسازی کدگذاری.جیسون

ناپایا سرور من := وب‌سوکت.سرور {}
ناپایا دیده‌ها := وکتور {} برگردان وکتور<رشته>

تابع سرور ساختگی():
    ناپایا ا := وب‌سوکت.پذیرش(سرور من)
    _ := وب‌سوکت.ارسال متن(ا، `0{"sid":"s1","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    اگر وب‌سوکت.دریافت متن(ا) != "40": برگشت پایان
    _ := وب‌سوکت.ارسال متن(ا، `40{"sid":"a1"}`)
    دیده‌ها.بیفزا(وب‌سوکت.دریافت متن(ا))
    _ := وب‌سوکت.ارسال متن(ا، `430[{"ok":true,"members":3}]`)
    _ := وب‌سوکت.ارسال متن(ا، `4217["تأیید","سفارش ۱۰۴۲"]`)
    دیده‌ها.بیفزا(وب‌سوکت.دریافت متن(ا))
    _ := وب‌سوکت.ارسال متن(ا، "41")
    _ := وب‌سوکت.دریافت با مهلت(ا، ۱۰۰۰)
    وب‌سوکت.بستن(ا)
پایان

تابع ریشه:
    سرور من = وب‌سوکت.شنود(۰)
    نخ := نخ‌ساز(سرور ساختگی)
    ناپایا گزینه := سوکت‌آیاو.گزینه‌های جدید()
    گزینه.حمل‌ونقل = سوکت‌آیاو.حمل‌ونقل وب‌سوکت
    گزینه.اتصال دوباره = نادرست
    کارخواه := سوکت‌آیاو.اتصال با("http://127.0.0.1:" + وب‌سوکت.درگاه(سرور من)، گزینه)

    ناپایا آرگ‌ها := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن رشته(آرگ‌ها، "اتاق-۱")
    ناپایا پاسخ سرور := سوکت‌آیاو.ارسال منتظر تایید(کارخواه، "پیوستن"، آرگ‌ها، ۲۰۰۰)
    سوکت‌آیاو.آزادسازی آرگومان(آرگ‌ها)
    سرچاپ "پاسخ پیوستن:"، پاسخ سرور.رسیده، "اعضا:"، جیسون.دریافت عدد(سوکت‌آیاو.آرگومان تایید(پاسخ سرور، ۰)، "members")
    سوکت‌آیاو.آزادسازی تایید(پاسخ سرور)

    ناپایا ادامه := درست
    تا ادامه:
        رخداد := سوکت‌آیاو.بعدی(کارخواه، ۳۰۰۰)
        اگر رخداد.نوع برابر سوکت‌آیاو.رویداد پیام و رخداد.نام برابر "تأیید":
            سرچاپ "سرور می‌پرسد:"، سوکت‌آیاو.آرگومان رشته(رخداد، ۰)، "شناسه‌ی تایید"، رخداد.شماره تایید
            _ := سوکت‌آیاو.پاسخ رشته(رخداد، "بله")
        وگرنه رخداد.نوع برابر سوکت‌آیاو.رویداد قطع یا رخداد.نوع برابر سوکت‌آیاو.رویداد مهلت:
            ادامه = نادرست
        پایان
    پایان
    سوکت‌آیاو.بستن(کارخواه)
    نخ‌پیوند(نخ)
    وب‌سوکت.بستن سرور(سرور من)
    سرچاپ "سرور دید:"
    هر سطر در دیده‌ها: سرچاپ " "، سطر پایان
پایان
