واردسازی شبکه.سوکت‌آیاو
واردسازی رشته

ناپایا کارخواه := سوکت‌آیاو.کارخواه {}

تابع ریشه:
    ناپایا گزینه := سوکت‌آیاو.گزینه‌های جدید()
    گزینه.تعداد کوشش اتصال دوباره = ۱۰
    گزینه.تاخیر اتصال دوباره = ۲۰۰۰
    کارخواه = سوکت‌آیاو.اتصال با("http://localhost:3000"، گزینه)
    اگر وارونه سوکت‌آیاو.متصل است(کارخواه):
        سرچاپ "به گفتگو دسترسی نیست:"، سوکت‌آیاو.آخرین خطا(کارخواه)
        برگشت ۱
    پایان

    ناپایا آرگومان‌ها := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن رشته(آرگومان‌ها، "support")
    ناپایا تایید := سوکت‌آیاو.ارسال منتظر تایید(کارخواه، "join"، آرگومان‌ها، ۵۰۰۰)
    سوکت‌آیاو.آزادسازی آرگومان(آرگومان‌ها)
    اگر وارونه تایید.رسیده:
        سرچاپ "پیوستن به اتاق از مهلت گذشت"
        برگشت ۱
    پایان
    سرچاپ "به اتاق پشتیبانی پیوستیم، شمار اعضا:"، سوکت‌آیاو.عدد تایید(تایید، ۰)
    سوکت‌آیاو.آزادسازی تایید(تایید)

    سوکت‌آیاو.روی(کارخواه، "message"، (رخداد: سوکت‌آیاو.رویداد):
        متن := سوکت‌آیاو.آرگومان رشته(رخداد، ۱)
        اگر رشته.شروع با(متن، "!time"):
            _ := سوکت‌آیاو.ارسال رشته(کارخواه، "message"، "ساعت کاری ۹ تا ۱۷ است")
        پایان
    پایان)
    سوکت‌آیاو.روی(کارخواه، "disconnect"، (رخداد: سوکت‌آیاو.رویداد):
        سرچاپ "اتصال از دست رفت:"، رخداد.پیام
    پایان)
    سوکت‌آیاو.روی(کارخواه، "reconnect"، (رخداد: سوکت‌آیاو.رویداد):
        _ := رخداد
        سرچاپ "برگشتیم پس از"، سوکت‌آیاو.تلاش‌ها(کارخواه)، "تلاش"
    پایان)
    سوکت‌آیاو.اجرا(کارخواه)
    برگشت ۰
پایان
