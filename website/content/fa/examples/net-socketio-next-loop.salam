واردسازی شبکه.سوکت‌آیاو
واردسازی شبکه.وب‌سوکت

ناپایا سرور من := وب‌سوکت.سرور {}

تابع سرور ساختگی():
    ناپایا اتصال := وب‌سوکت.پذیرش(سرور من)
    _ := وب‌سوکت.ارسال متن(اتصال، `0{"sid":"s1","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    پیام := وب‌سوکت.دریافت با مهلت(اتصال، ۳۰۰۰)
    اگر پیام.نوع برابر وب‌سوکت.متن و پیام.متن برابر "40":
        _ := وب‌سوکت.ارسال متن(اتصال، `40{"sid":"a1"}`)
        _ := وب‌سوکت.ارسال متن(اتصال، `42["قیمت","BTC",61250]`)
        _ := وب‌سوکت.ارسال متن(اتصال، `42["قیمت","ETH",2410]`)
        _ := وب‌سوکت.ارسال متن(اتصال، `42["halt","maintenance"]`)
        _ := وب‌سوکت.ارسال متن(اتصال، "41")
    پایان
    _ := وب‌سوکت.دریافت با مهلت(اتصال، ۱۰۰۰)
    وب‌سوکت.بستن(اتصال)
پایان

تابع ریشه:
    سرور من = وب‌سوکت.شنود(۰)
    نخ := نخ‌ساز(سرور ساختگی)
    ناپایا گزینه := سوکت‌آیاو.گزینه‌های جدید()
    گزینه.حمل‌ونقل = سوکت‌آیاو.حمل‌ونقل وب‌سوکت
    گزینه.اتصال دوباره = نادرست
    کارخواه := سوکت‌آیاو.اتصال با("http://127.0.0.1:" + وب‌سوکت.درگاه(سرور من)، گزینه)

    ناپایا ادامه := درست
    تا ادامه:
        رخداد := سوکت‌آیاو.بعدی(کارخواه، ۳۰۰۰)
        اگر رخداد.نوع برابر سوکت‌آیاو.رویداد پیام و رخداد.نام برابر "قیمت":
            سرچاپ "قیمت"، سوکت‌آیاو.آرگومان رشته(رخداد، ۰)، سوکت‌آیاو.آرگومان عددی(رخداد، ۱)
        وگرنه رخداد.نوع برابر سوکت‌آیاو.رویداد پیام:
            سرچاپ "رویداد"، رخداد.نام، سوکت‌آیاو.آرگومان رشته(رخداد، ۰)
        وگرنه رخداد.نوع برابر سوکت‌آیاو.رویداد قطع:
            سرچاپ "قطع شد:"، رخداد.پیام، رخداد.پیام برابر سوکت‌آیاو.قطع توسط سرور
            ادامه = نادرست
        وگرنه رخداد.نوع برابر سوکت‌آیاو.رویداد مهلت:
            سرچاپ "در مهلت چیزی نرسید"
            ادامه = نادرست
        پایان
    پایان
    سوکت‌آیاو.بستن(کارخواه)
    نخ‌پیوند(نخ)
    وب‌سوکت.بستن سرور(سرور من)
پایان
