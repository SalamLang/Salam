// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        data := تی سی پی.خواندن(c، 4096)
        اگر data.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(c، data)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            بشکن
        پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    listener := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، listener.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(listener)
پایان

تابع ریشه:
    target := start_echo()
    proxy := ساکس.شروع(ساکس.پیکربندی سرور جدید(0))

    client := ساکس.کلاینت جدید("127.0.0.1"، proxy.درگاه)
    result := ساکس.اتصال(client، "127.0.0.1"، target)
    اگر وارونه result.موفق:
        سرچاپ "پراکسی نپذیرفت:"، result.کد، result.خطا
        برگشت
    پایان
    result.جریان.نوشتن("hello from behind the proxy")
    سرچاپ result.جریان.خواندن(100)
    result.جریان.بستن()
    ساکس.توقف(proxy)
پایان
