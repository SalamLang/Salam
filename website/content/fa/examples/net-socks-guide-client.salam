// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع اتصال_پژواک(آرگومان: صحیح۶۴):
    نویسه := تی سی پی.اتصال از توصیف‌گر(آرگومان)
    تا درست:
        داده := تی سی پی.خواندن(نویسه، 4096)
        اگر داده.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(نویسه، داده)
    پایان
    تی سی پی.بستن(نویسه)
پایان

تابع پذیرش_پژواک(آرگومان: صحیح۶۴):
    کارساز := تی سی پی.سرور { توصیفگر = آرگومان }
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        اگر وارونه تی سی پی.اتصال معتبر(نویسه):
            بشکن
        پایان
        ساکس.برو(اتصال_پژواک، نویسه.توصیفگر برگردان تهی*)
    پایان
پایان

تابع آغاز_پژواک(): صحیح:
    شنونده := تی سی پی.پیوند(0)
    ساکس.برو(پذیرش_پژواک، شنونده.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(شنونده)
پایان

تابع ریشه:
    هدف := آغاز_پژواک()
    ناپایا پیکربندی_پروکسی := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(پیکربندی_پروکسی، درست)
    پروکسی := ساکس.شروع(پیکربندی_پروکسی)

    کارخواه := ساکس.کلاینت جدید("127.0.0.1"، پروکسی.درگاه)
    نتیجه := ساکس.اتصال(کارخواه، "127.0.0.1"، هدف)
    اگر وارونه نتیجه.موفق:
        سرچاپ "پراکسی نپذیرفت:"، نتیجه.کد، نتیجه.خطا
        برگشت
    پایان
    نتیجه.جریان.نوشتن("hello from behind the proxy")
    سرچاپ نتیجه.جریان.خواندن(100)
    نتیجه.جریان.بستن()
    ساکس.توقف(پروکسی)
پایان
