واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.رندر‌سرور
واردسازی کدگذاری.جیسون

تابع افزودن(ک: صحیح۶۴):
    ارگس := رندر‌سرور.پارامترها(ک)
    ا := جیسون.دریافت عدد(ارگس، "a")
    ب := جیسون.دریافت عدد(ارگس، "b")
    رندر‌سرور.پاسخ موفق(ک، "{\"sum\":" + (ا + ب) + "}")
پایان

تابع ریشه:
    رندر‌سرور.ثبت کارکرد("Add"، افزودن)
    ناپایا ر := مسیریاب.مسیریاب جدید()
    رندر‌سرور.نصب(ر)
    ناپایا س := اچ تی تی پی.سرور جدید(0)
    اچ تی تی پی.استفاده(س، ر)
    پورت := اچ تی تی پی.اجرا در پس زمینه با درگاه(س)
    باسی := "http://127.0.0.1:" + پورت

    سیسسیون := اچ تی تی پی.دریافت(باسی + "/_salam/session")
    توکین := جیسون.دریافت(اچ تی تی پی.بدنه(سیسسیون)، "token")

    ناپایا ه := اچ تی تی پی.سرصفحه جدید()
    ه.درج("Content-Type"، "application/json")
    ه.درج("X-Salam-Token"، توکین)
    گوود := اچ تی تی پی.ارسال با(باسی + "/_salam/fn/Add"، "{\"args\":{\"a\":2,\"b\":40}}"، ه)
    سرچاپ اچ تی تی پی.وضعیت(گوود)، اچ تی تی پی.بدنه(گوود)

    ونکنوون := اچ تی تی پی.ارسال با(باسی + "/_salam/fn/Nope"، "{\"args\":{}}"، ه)
    سرچاپ اچ تی تی پی.وضعیت(ونکنوون)

    ناپایا انون := اچ تی تی پی.سرصفحه جدید()
    انون.درج("Content-Type"، "application/json")
    نوتهینگ := اچ تی تی پی.ارسال با(باسی + "/_salam/fn/Add"، "{\"args\":{}}"، انون)
    سرچاپ اچ تی تی پی.وضعیت(نوتهینگ)

    ناپایا کروسس := اچ تی تی پی.سرصفحه جدید()
    کروسس.درج("Content-Type"، "application/json")
    کروسس.درج("X-Salam-Token"، توکین)
    کروسس.درج("Origin"، "http://evil.example")
    بلوککید := اچ تی تی پی.ارسال با(باسی + "/_salam/fn/Add"، "{\"args\":{}}"، کروسس)
    سرچاپ اچ تی تی پی.وضعیت(بلوککید)
پایان
