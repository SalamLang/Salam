واردسازی شبکه.تی سی پی
واردسازی رشته

ناپایا سرور := تی سی پی.سرور {}

تابع پاسخ(خط: رشته): رشته:
    واژه‌ها := خط.بشکاف(" ")
    فرمان := واژه‌ها.بگیر(۰)
    اگر فرمان == "جمع" و واژه‌ها.طول() == ۳:
        برگشت رشته.از عدد(واژه‌ها.بگیر(۱).به صحیح() + واژه‌ها.بگیر(۲).به صحیح())
    پایان
    اگر فرمان == "طول" و واژه‌ها.طول() == ۲:
        برگشت رشته.از عدد(واژه‌ها.بگیر(۱).شمارنویسه())
    پایان
    برگشت "خطا: فرمان ناشناخته: " + فرمان
پایان

تابع خدمت():
    ا := تی سی پی.پذیرش(سرور)
    تی سی پی.تنظیم مهلت خواندن(ا، ۲۰۰۰)
    ناپایا شمار := ۰
    تا درست:
        درخواست := تی سی پی.خواندن(ا، ۱۰۲۴)
        اگر درخواست == "":
            بشکن
        پایان
        _ := تی سی پی.نوشتن(ا، پاسخ(درخواست))
        شمار += ۱
    پایان
    تی سی پی.بستن(ا)
    سرچاپ "سرور: به"، شمار، "درخواست پاسخ داد"
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    ن := نخ‌ساز(خدمت)
    ا := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(سرور))
    تی سی پی.تنظیم مهلت خواندن(ا، ۲۰۰۰)
    هر درخواست در ["جمع ۲ ۴۰"، "طول سلام"، "پینگ"]:
        _ := تی سی پی.نوشتن(ا، درخواست)
        سرچاپ درخواست، "->"، تی سی پی.خواندن(ا، ۱۰۲۴)
    پایان
    تی سی پی.بستن(ا)
    نخ‌پیوند(ن)
    تی سی پی.بستن سرور(سرور)
پایان
