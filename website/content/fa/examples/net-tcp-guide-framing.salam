واردسازی شبکه.تی سی پی

ناپایا سرور := تی سی پی.سرور {}

تابع فرستنده():
    ا := تی سی پی.پذیرش(سرور)
    _ := تی سی پی.نوشتن(ا، "سیب\nموز")
    _ := تی سی پی.نوشتن(ا، "\nگیلاس\nخر")
    _ := تی سی پی.نوشتن(ا، "ما\n")
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    ن := نخ‌ساز(فرستنده)
    ا := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(سرور))
    تی سی پی.تنظیم مهلت خواندن(ا، ۲۰۰۰)
    ناپایا مانده := ""
    ناپایا شمار := ۰
    تا درست:
        تکه := تی سی پی.خواندن(ا، ۴۰۹۶)
        اگر تکه == "":
            بشکن
        پایان
        مانده = مانده + تکه
        ناپایا جا := مانده.بیاب("\n")
        تا جا >= ۰:
            شمار += ۱
            سرچاپ شمار، مانده.زیررشته(۰، جا)
            مانده = مانده.زیررشته(جا + ۱، مانده.طول() - جا - ۱)
            جا = مانده.بیاب("\n")
        پایان
    پایان
    سرچاپ "باقی مانده:"، مانده.طول()، "بایت"
    تی سی پی.بستن(ا)
    نخ‌پیوند(ن)
    تی سی پی.بستن سرور(سرور)
پایان
