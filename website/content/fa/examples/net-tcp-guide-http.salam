واردسازی شبکه.تی سی پی

ناپایا سرور := تی سی پی.سرور {}

تابع رسیدگی():
    ا := تی سی پی.پذیرش(سرور)
    تی سی پی.تنظیم مهلت(ا، ۲۰۰۰)
    درخواست := تی سی پی.خواندن(ا، ۴۰۹۶)
    خط اول := درخواست.بشکاف("\r\n").بگیر(۰)
    مسیر := خط اول.بشکاف(" ").بگیر(۱)
    اگر مسیر == "/hello":
        تی سی پی.نوشتن اچ تی تی پی(ا، "200 OK"، "text/plain; charset=utf-8"، "سلام از سلام")
    وگرنه:
        تی سی پی.نوشتن اچ تی تی پی(ا، "404 Not Found"، "text/plain; charset=utf-8"، "صفحه‌ای در " + مسیر + " نیست")
    پایان
    تی سی پی.بستن(ا)
پایان

تابع بگیر صفحه(مسیر: رشته):
    ن := نخ‌ساز(رسیدگی)
    ا := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(سرور))
    تی سی پی.تنظیم مهلت(ا، ۲۰۰۰)
    _ := تی سی پی.نوشتن(ا، "GET " + مسیر + " HTTP/1.1\r\nHost: localhost\r\n\r\n")
    ناپایا پاسخ := ""
    تا درست:
        تکه := تی سی پی.خواندن(ا، ۴۰۹۶)
        اگر تکه == "":
            بشکن
        پایان
        پاسخ = پاسخ + تکه
    پایان
    تی سی پی.بستن(ا)
    نخ‌پیوند(ن)
    مرز := پاسخ.بیاب("\r\n\r\n")
    سرچاپ پاسخ.بشکاف("\r\n").بگیر(۰)
    سرچاپ "  بدنه:"، پاسخ.زیررشته(مرز + ۴، پاسخ.طول() - مرز - ۴)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    بگیر صفحه("/hello")
    بگیر صفحه("/missing")
    تی سی پی.بستن سرور(سرور)
پایان
