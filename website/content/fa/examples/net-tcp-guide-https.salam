واردسازی شبکه.تی سی پی
واردسازی تی ال اس

تابع ریشه:
    ناپایا ا := تی سی پی.شماره گیری امن("example.com"، ۴۴۳)
    اگر وارونه تی ال اس.اتصال معتبر(ا):
        سرچاپ "TLS شکست خورد:"، تی ال اس.خطای اتصال(ا)
        برگشت ۱
    پایان
    سرچاپ "پروتکل:"، تی ال اس.نسخه(ا)
    _ := تی ال اس.نوشتن(ا، "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
    سرآیند := تی ال اس.خواندن(ا، ۴۰۹۶)
    سرچاپ سرآیند.بشکاف("\r\n").بگیر(۰)
    تی ال اس.بستن اتصال(ا)
    برگشت ۰
پایان
