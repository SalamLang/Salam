واردسازی شبکه.تی سی پی

تابع ریشه:
    خاموش := تی سی پی.پیوند(۰)
    ا := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(خاموش))
    سرچاپ "وصل شد:"، تی سی پی.اتصال معتبر(ا)
    تی سی پی.تنظیم مهلت خواندن(ا، ۳۰۰)
    پاسخ := تی سی پی.خواندن(ا، ۱۰۲۴)
    اگر پاسخ == "":
        سرچاپ "در ۳۰۰ میلی‌ثانیه پاسخی نیامد، دست می‌کشیم"
    پایان
    تی سی پی.بستن(ا)
    تی سی پی.بستن سرور(خاموش)

    ردشده := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(خاموش))
    اگر وارونه تی سی پی.اتصال معتبر(ردشده):
        سرچاپ "دیگر کسی روی آن درگاه گوش نمی‌دهد"
    پایان
پایان
