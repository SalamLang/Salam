واردسازی شبکه.تی سی پی
واردسازی کانال
واردسازی رشته

ناپایا سرور := تی سی پی.سرور {}
ناپایا کارها := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>

تابع پذیرنده():
    تکرار ۳:
        ا := تی سی پی.پذیرش(سرور)
        اگر تی سی پی.اتصال معتبر(ا): _ := کارها.فرستادن(ا.توصیفگر) پایان
    پایان
    کارها.بستن()
پایان

تابع کارگر():
    ناپایا باز := درست
    تا درست:
        توصیف‌گر := کارها.دریافت(باز)
        اگر وارونه باز: بشکن پایان
        ا := تی سی پی.اتصال از توصیف‌گر(توصیف‌گر)
        تی سی پی.تنظیم مهلت خواندن(ا، ۲۰۰۰)
        درخواست := تی سی پی.خواندن(ا، ۱۰۲۴)
        _ := تی سی پی.نوشتن(ا، "سلام " + رشته.بزرگ(درخواست))
        تی سی پی.بستن(ا)
    پایان
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    کارها.مقداردهی(۸)
    پ := نخ‌ساز(پذیرنده)
    ک۱ := نخ‌ساز(کارگر)
    ک۲ := نخ‌ساز(کارگر)

    نام‌ها := ["sara"، "reza"، "mina"]
    ناپایا اتصال‌ها := وکتور {} برگردان وکتور<تی سی پی.اتصال شبکه>
    تکرار نام‌ها.طول():
        ا := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(سرور))
        تی سی پی.تنظیم مهلت خواندن(ا، ۲۰۰۰)
        اتصال‌ها.بیفزا(ا)
    پایان
    هر ش، ا در اتصال‌ها:
        _ := تی سی پی.نوشتن(ا، نام‌ها[ش])
    پایان
    هر ش، ا در اتصال‌ها:
        سرچاپ نام‌ها[ش]، "->"، تی سی پی.خواندن(ا، ۱۰۲۴)
        تی سی پی.بستن(ا)
    پایان
    نخ‌پیوند(پ)
    نخ‌پیوند(ک۱)
    نخ‌پیوند(ک۲)
    تی سی پی.بستن سرور(سرور)
پایان
