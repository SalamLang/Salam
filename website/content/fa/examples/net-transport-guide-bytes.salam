// زبان: فارسی
واردسازی شبکه.انتقال شبکه

تابع ریشه:
    ناپایا بافر_محلی := انتقال شبکه.بایت‌های جدید(16)
    انتقال شبکه.نوشتن بایت(بافر_محلی، 0x7f)
    انتقال شبکه.نوشتن شانزده بیت(بافر_محلی، 443)
    انتقال شبکه.نوشتن رشته(بافر_محلی، "hi")
    سرچاپ انتقال شبکه.به هگزا(بافر_محلی)، بافر_محلی.طول
    سرچاپ انتقال شبکه.خواندن شانزده بیت(بافر_محلی، 1)، انتقال شبکه.بایت در(بافر_محلی، 3) برگردان صحیح
    انتقال شبکه.آزادسازی بایت‌ها(بافر_محلی)

    الف := انتقال شبکه.نشانی جدید("example.com"، 443)
    سرچاپ الف.میزبان، الف.درگاه، الف.نوع برابر انتقال شبکه.نشانی دامنه
    سرچاپ انتقال شبکه.نشانی جدید("192.168.1.9"، 80).نوع برابر انتقال شبکه.نشانی آی پی چهار
    سرچاپ انتقال شبکه.نشانی جدید("2001:db8::1"، 8080).نوع برابر انتقال شبکه.نشانی آی پی شش

    ناپایا سیم := انتقال شبکه.بایت‌های جدید(32)
    انتقال شبکه.نوشتن نشانی(سیم، الف)
    سرچاپ انتقال شبکه.به هگزا(سیم)
    ناپایا بازگشت := انتقال شبکه.نشانی {}
    استفاده_شده := انتقال شبکه.خواندن نشانی(سیم، 0، بازگشت)
    سرچاپ استفاده_شده، بازگشت.میزبان، بازگشت.درگاه
    انتقال شبکه.آزادسازی بایت‌ها(سیم)

    شناسه := انتقال شبکه.تجزیه یو یو آی دی("b831381d-6324-4d53-ad4f-8cda48b30811")
    سرچاپ شناسه.خراب، شناسه.طول، انتقال شبکه.قالب یو یو آی دی(شناسه)
    سرچاپ انتقال شبکه.تجزیه یو یو آی دی("not a uuid").خراب
