// زبان: فارسی
واردسازی شبکه.انتقال شبکه

تابع ریشه:
    ناپایا b := انتقال شبکه.بایت‌های جدید(16)
    انتقال شبکه.نوشتن بایت(b، 0x7f)
    انتقال شبکه.نوشتن شانزده بیت(b، 443)
    انتقال شبکه.نوشتن رشته(b، "hi")
    سرچاپ انتقال شبکه.به هگزا(b)، b.طول
    سرچاپ انتقال شبکه.خواندن شانزده بیت(b، 1)، انتقال شبکه.بایت در(b، 3) برگردان صحیح
    انتقال شبکه.آزادسازی بایت‌ها(b)

    a := انتقال شبکه.نشانی جدید("example.com"، 443)
    سرچاپ a.میزبان، a.درگاه، a.نوع برابر انتقال شبکه.نشانی دامنه
    سرچاپ انتقال شبکه.نشانی جدید("192.168.1.9"، 80).نوع برابر انتقال شبکه.نشانی آی پی چهار
    سرچاپ انتقال شبکه.نشانی جدید("2001:db8::1"، 8080).نوع برابر انتقال شبکه.نشانی آی پی شش

    ناپایا wire := انتقال شبکه.بایت‌های جدید(32)
    انتقال شبکه.نوشتن نشانی(wire، a)
    سرچاپ انتقال شبکه.به هگزا(wire)
    ناپایا back := انتقال شبکه.نشانی {}
    used := انتقال شبکه.خواندن نشانی(wire، 0، back)
    سرچاپ used، back.میزبان، back.درگاه
    انتقال شبکه.آزادسازی بایت‌ها(wire)

    id := انتقال شبکه.تجزیه یو یو آی دی("b831381d-6324-4d53-ad4f-8cda48b30811")
    سرچاپ id.خراب، id.طول، انتقال شبکه.قالب یو یو آی دی(id)
    سرچاپ انتقال شبکه.تجزیه یو یو آی دی("not a uuid").خراب
پایان
