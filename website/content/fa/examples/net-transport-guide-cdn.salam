// زبان: فارسی
واردسازی شبکه.انتقال شبکه

تابع client_settings(): انتقال شبکه.تنظیمات:
    ناپایا s := انتقال شبکه.تنظیمات {}
    s.شبکه = "ws"
    s.تی ال اس = درست
    s.نام سرور = "front.example.net"
    s.سربرگ میزبان = "vpn.example.org"
    s.مسیر = "/ws-8f3a"
    s.الپن = "http/1.1"
    s.داده زودهنگام = 2048
    s.مهلت میلی ثانیه = 8000
    برگشت s
پایان

تابع server_settings(): انتقال شبکه.تنظیمات:
    ناپایا s := انتقال شبکه.تنظیمات {}
    s.شبکه = "ws"
    s.مسیر = "/ws-8f3a"
    s.سربرگ میزبان = "vpn.example.org"
    برگشت s
پایان

تابع ریشه:
    c := انتقال شبکه.شماره گیری("front.example.net"، 443، client_settings())
    سرچاپ انتقال شبکه.معتبر(c)، c.خطا
    l := انتقال شبکه.شنود(10000، server_settings())
    سرچاپ انتقال شبکه.شنونده معتبر(l)
    انتقال شبکه.بستن شنونده(l)
پایان
