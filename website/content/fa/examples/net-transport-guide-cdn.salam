// زبان: فارسی
واردسازی شبکه.انتقال شبکه

تابع client_settings(): انتقال شبکه.تنظیمات:
    ناپایا متن_نمونه := انتقال شبکه.تنظیمات {}
    متن_نمونه.شبکه = "ws"
    متن_نمونه.تی ال اس = درست
    متن_نمونه.نام سرور = "front.example.net"
    متن_نمونه.سربرگ میزبان = "vpn.example.org"
    متن_نمونه.مسیر = "/ws-8f3a"
    متن_نمونه.الپن = "http/1.1"
    متن_نمونه.داده زودهنگام = 2048
    متن_نمونه.مهلت میلی ثانیه = 8000
    برگشت متن_نمونه
پایان

تابع server_settings(): انتقال شبکه.تنظیمات:
    ناپایا متن_نمونه := انتقال شبکه.تنظیمات {}
    متن_نمونه.شبکه = "ws"
    متن_نمونه.مسیر = "/ws-8f3a"
    متن_نمونه.سربرگ میزبان = "vpn.example.org"
    برگشت متن_نمونه
پایان

تابع ریشه:
    نویسه := انتقال شبکه.شماره گیری("front.example.net"، 443، client_settings())
    سرچاپ انتقال شبکه.معتبر(نویسه)، نویسه.خطا
    ال := انتقال شبکه.شنود(10000، server_settings())
    سرچاپ انتقال شبکه.شنونده معتبر(ال)
    انتقال شبکه.بستن شنونده(ال)
پایان
