// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه

ناپایا درگاه := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع echo_once():
    تنظیمات := انتقال شبکه.تنظیمات {}
    ال := انتقال شبکه.شنود(0، تنظیمات)
    درگاه = انتقال شبکه.درگاه شنونده(ال)
    همگام سازی.اتمام(آماده)
    ناپایا نویسه := انتقال شبکه.پذیرش(ال)
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    شمار_بایت := انتقال شبکه.خواندن(نویسه، بافر، 4096)
    اگر شمار_بایت بزرگتر 0:
        انتقال شبکه.نوشتن(نویسه، بافر، شمار_بایت)
    پایان
    حافظه.آزادسازی(بافر)
    انتقال شبکه.بستن(نویسه)
    انتقال شبکه.بستن شنونده(ال)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(echo_once)
    همگام سازی.انتظار(آماده)

    ناپایا نویسه := انتقال شبکه.شماره گیری("127.0.0.1"، درگاه، انتقال شبکه.تنظیمات {})
    اگر وارونه انتقال شبکه.معتبر(نویسه):
        سرچاپ "شماره‌گیری شکست خورد:"، نویسه.خطا
        برگشت
    پایان
    ناپایا پیام_داده := انتقال شبکه.از رشته("hello transport")
    انتقال شبکه.ارسال بایت ها(نویسه، پیام_داده)
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    شمار_بایت := انتقال شبکه.خواندن(نویسه، بافر، 4096)
    سرچاپ "پژواک"، شمار_بایت، "بایت:"، (بافر برگردان رشته).زیررشته(0، شمار_بایت)
    حافظه.آزادسازی(بافر)
    انتقال شبکه.آزادسازی بایت‌ها(پیام_داده)
    انتقال شبکه.بستن(نویسه)
    نخ‌پیوند(موقت)
پایان
