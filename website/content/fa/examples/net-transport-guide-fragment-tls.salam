// زبان: فارسی
واردسازی شبکه.انتقال شبکه

تابع ریشه:
    ناپایا s := انتقال شبکه.تنظیمات {}
    s.تی ال اس = درست
    s.نام سرور = "example.com"
    s.تکه تکه کردن = درست
    s.کمینه تکه = 3
    s.بیشینه تکه = 30
    s.تاخیر تکه میلی ثانیه = 5
    s.مهلت میلی ثانیه = 8000
    ناپایا c := انتقال شبکه.شماره گیری("example.com"، 443، s)
    سرچاپ انتقال شبکه.معتبر(c)، c.خطا
    انتقال شبکه.بستن(c)
پایان
