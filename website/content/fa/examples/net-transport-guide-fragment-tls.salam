// زبان: فارسی
واردسازی شبکه.انتقال شبکه

تابع ریشه:
    ناپایا متن_نمونه := انتقال شبکه.تنظیمات {}
    متن_نمونه.تی ال اس = درست
    متن_نمونه.نام سرور = "example.com"
    متن_نمونه.تکه تکه کردن = درست
    متن_نمونه.کمینه تکه = 3
    متن_نمونه.بیشینه تکه = 30
    متن_نمونه.تاخیر تکه میلی ثانیه = 5
    متن_نمونه.مهلت میلی ثانیه = 8000
    ناپایا نویسه := انتقال شبکه.شماره گیری("example.com"، 443، متن_نمونه)
    سرچاپ انتقال شبکه.معتبر(نویسه)، نویسه.خطا
    انتقال شبکه.بستن(نویسه)
پایان
