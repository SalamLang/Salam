// زبان: فارسی
واردسازی شبکه.انتقال شبکه

تابع ریشه:
    اندازه‌ها := انتقال شبکه.اندازه تکه ها(517، 5، 20)
    ناپایا مجموع := 0
    ناپایا متغیر_in_range := درست
    تکرار اندازه‌ها.طول() در شمارنده:
        شمار_بایت := اندازه‌ها.بگیر(شمارنده)
        مجموع += شمار_بایت
        اگر شمارنده کوچکتر اندازه‌ها.طول() - 1 و (شمار_بایت کوچکتر 5 یا شمار_بایت بزرگتر 20):
            متغیر_in_range = نادرست
        پایان
    پایان
    سرچاپ "مجموع تکه‌ها برابر است با"، مجموع
    سرچاپ "همه‌ی تکه‌ها جز آخری ۵ تا ۲۰ بایت‌اند:"، متغیر_in_range
    سرچاپ "بیش از ۲۵ تکه:"، اندازه‌ها.طول() بزرگتر 25
    سرچاپ "یک تکه وقتی کمینه و بیشینه کل پیام را می‌پوشانند:"، انتقال شبکه.اندازه تکه ها(10، 50، 60).طول()
پایان
