// زبان: فارسی
واردسازی شبکه.انتقال شبکه

تابع ریشه:
    sizes := انتقال شبکه.اندازه تکه ها(517، 5، 20)
    ناپایا total := 0
    ناپایا in_range := درست
    تکرار sizes.طول() در i:
        n := sizes.بگیر(i)
        total += n
        اگر i کوچکتر sizes.طول() - 1 و (n کوچکتر 5 یا n بزرگتر 20):
            in_range = نادرست
        پایان
    پایان
    سرچاپ "مجموع تکه‌ها برابر است با"، total
    سرچاپ "همه‌ی تکه‌ها جز آخری ۵ تا ۲۰ بایت‌اند:"، in_range
    سرچاپ "بیش از ۲۵ تکه:"، sizes.طول() بزرگتر 25
    سرچاپ "یک تکه وقتی کمینه و بیشینه کل پیام را می‌پوشانند:"، انتقال شبکه.اندازه تکه ها(10، 50، 60).طول()
پایان
