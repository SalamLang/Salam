// زبان: فارسی
واردسازی شبکه.انتقال شبکه

تابع ریشه:
    sizes := انتقال شبکه.اندازه تکه ها(517، 5، 20)
    ناپایا total := 0
    ناپایا in_range := درست
    تکرار sizes.طول() در i:
        n := sizes.بگیر(i)
        total += n
        اگر i کوچکتر sizes.طول() - 1 و (n کوچکتر 5 یا n بزرگتر 20):
            in_range = نادرست
        پایان
    پایان
    سرچاپ "pieces add up to"، total
    سرچاپ "every piece but the last is 5 to 20 bytes:"، in_range
    سرچاپ "more than 25 pieces:"، sizes.طول() بزرگتر 25
    سرچاپ "one piece when min and max cover the whole message:"، انتقال شبکه.اندازه تکه ها(10، 50، 60).طول()
پایان
