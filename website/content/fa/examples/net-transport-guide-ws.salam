// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه

ناپایا درگاه := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا مسیر_دیده := ""
ناپایا میزبان_دیده := ""

تابع settings(): انتقال شبکه.تنظیمات:
    ناپایا متن_نمونه := انتقال شبکه.تنظیمات {}
    متن_نمونه.شبکه = "ws"
    متن_نمونه.مسیر = "/tunnel"
    متن_نمونه.سربرگ میزبان = "cdn.example.com"
    برگشت متن_نمونه
پایان

تابع worker():
    متن_نمونه := settings()
    ال := انتقال شبکه.شنود(0، متن_نمونه)
    درگاه = انتقال شبکه.درگاه شنونده(ال)
    همگام سازی.اتمام(آماده)
    ناپایا نویسه := انتقال شبکه.پذیرش خام(ال)
    اگر انتقال شبکه.ارتقا(نویسه، متن_نمونه):
        مسیر_دیده = نویسه.مسیر درخواست
        میزبان_دیده = نویسه.میزبان درخواست
        بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
        شمار_بایت := انتقال شبکه.خواندن(نویسه، بافر، 4096)
        انتقال شبکه.نوشتن(نویسه، بافر، شمار_بایت)
        حافظه.آزادسازی(بافر)
    پایان
    انتقال شبکه.بستن(نویسه)
    انتقال شبکه.بستن شنونده(ال)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(worker)
    همگام سازی.انتظار(آماده)

    ناپایا نویسه := انتقال شبکه.شماره گیری("127.0.0.1"، درگاه، settings())
    ناپایا پیام_داده := انتقال شبکه.از رشته("inside a websocket")
    انتقال شبکه.ارسال بایت ها(نویسه، پیام_داده)
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    شمار_بایت := انتقال شبکه.خواندن(نویسه، بافر، 4096)
    سرچاپ (بافر برگردان رشته).زیررشته(0، شمار_بایت)
    حافظه.آزادسازی(بافر)
    انتقال شبکه.آزادسازی بایت‌ها(پیام_داده)
    انتقال شبکه.بستن(نویسه)
    نخ‌پیوند(موقت)
    سرچاپ "سرور مسیر را دید"، مسیر_دیده، "و میزبان"، میزبان_دیده

    ناپایا نادرست := settings()
    نادرست.مسیر = "/other"
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    متغیر_t2 := نخ‌ساز(worker)
    همگام سازی.انتظار(آماده)
    بد := انتقال شبکه.شماره گیری("127.0.0.1"، درگاه، نادرست)
    سرچاپ "مسیر اشتباه پذیرفته شد:"، انتقال شبکه.معتبر(بد)
    سرچاپ بد.خطا
    نخ‌پیوند(متغیر_t2)
پایان
