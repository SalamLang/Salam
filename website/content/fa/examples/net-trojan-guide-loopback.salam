// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.تروجان
واردسازی همگام سازی

ناپایا درگاه_پژواک := 0
ناپایا درگاه_وب := 0
ناپایا وب_دیده := ""
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع کارساز_پژواک():
    کارساز۲ := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز۲)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز۲)
        تا درست:
            داده := تی سی پی.خواندن(نویسه، 4096)
            اگر داده.طول() برابر 0:
                بشکن
            پایان
            تی سی پی.نوشتن(نویسه، "echo:" + داده)
        پایان
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع کارساز_وب():
    کارساز۲ := تی سی پی.پیوند(0)
    درگاه_وب = تی سی پی.درگاه(کارساز۲)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز۲)
        وب_دیده = تی سی پی.خواندن(نویسه، 4096)
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: 12\r\nConnection: close\r\n\r\nhello probes")
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع راه‌اندازی_کارسازها():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(کارساز_پژواک)
    متغیر__b := نخ‌ساز(کارساز_وب)
    همگام سازی.انتظار(آماده)
پایان

تابع متن_از(ویژگی_محلی: تهی*، شمار_بایت: صحیح): رشته:
    بافر := حافظه.تخصیص((شمار_بایت + 1) برگردان طبیعی۶۴)
    حافظه.کپی(بافر، ویژگی_محلی، شمار_بایت برگردان طبیعی۶۴)
    (بافر برگردان طبیعی۸*)[شمار_بایت] = 0 برگردان طبیعی۸
    برگشت بافر برگردان رشته
پایان

تابع خواندن_متن(ال &: تروجان.پیوند، متغیر_want: صحیح): رشته:
    بافر := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(بافر)
    ناپایا خروجی_مقدار := ""
    تا خروجی_مقدار.طول() کوچکتر متغیر_want:
        شمار_بایت := تروجان.خواندن پیوند(ال، بافر، 8192)
        اگر شمار_بایت کوچکتربرابر 0:
            بشکن
        پایان
        خروجی_مقدار += متن_از(بافر، شمار_بایت)
    پایان
    برگشت خروجی_مقدار
پایان

تابع ریشه:
    راه‌اندازی_کارسازها()
    ناپایا پیکربندی := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    تروجان.افزودن گذرواژه(پیکربندی، "secret")
    تروجان.تعیین جایگزین(پیکربندی، "127.0.0.1"، درگاه_وب)
    کارساز := تروجان.سرویس‌دهی بدون رمز(پیکربندی، 0)

    ناپایا کارخواه := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، کارساز.درگاه، "secret")
    کارخواه.با تی ال اس = نادرست
    ناپایا پیوند_محلی := تروجان.شماره گیری(کارخواه، "127.0.0.1"، درگاه_پژواک)
    تروجان.نوشتن متن پیوند(پیوند_محلی، "through trojan")
    سرچاپ خواندن_متن(پیوند_محلی، 19)
    تروجان.بستن پیوند(پیوند_محلی)

    غریبه := تی سی پی.شماره گیری("127.0.0.1"، کارساز.درگاه)
    تی سی پی.نوشتن(غریبه، "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
    سرچاپ تی سی پی.خواندن(غریبه، 4096).زیررشته(0، 15)
    تی سی پی.بستن(غریبه)
    تروجان.توقف(کارساز)
پایان
