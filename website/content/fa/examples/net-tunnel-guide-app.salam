// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.ساکس
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تروجان
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا درگاه_محلی := 0
ناپایا درگاه_خارج := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع سرویس_پژواک(نام: رشته، درگاه: صحیح):
    کارساز := تی سی پی.پیوند(درگاه)
    اگر نام برابر "local":
        درگاه_محلی = تی سی پی.درگاه(کارساز)
    وگرنه:
        درگاه_خارج = تی سی پی.درگاه(کارساز)
    پایان
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        داده := تی سی پی.خواندن(نویسه، 100)
        تی سی پی.نوشتن(نویسه، نام + " saw " + داده)
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع پژواک_محلی():
    سرویس_پژواک("local"، 0)
پایان

تابع پژواک_خارجی():
    سرویس_پژواک("abroad"، 0)
پایان

تابع بپرس(متغیر_proxy_port: صحیح، درگاه: صحیح، متن: رشته): رشته:
    پاسخ_محلی := ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، متغیر_proxy_port)، "127.0.0.1"، درگاه)
    پاسخ_محلی.جریان.نوشتن(متن)
    پاسخ_متن := پاسخ_محلی.جریان.خواندن(100)
    پاسخ_محلی.جریان.بستن()
    برگشت پاسخ_متن
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(پژواک_محلی)
    متغیر__b := نخ‌ساز(پژواک_خارجی)
    همگام سازی.انتظار(آماده)

    ناپایا پیکربندی_دور := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.افزودن گذرواژه(پیکربندی_دور، "secret")
    دور := تروجان.سرویس‌دهی بدون رمز(پیکربندی_دور، 0)

    قاعده‌ها := تونل.تجزیه قاعده‌ها("DST-PORT," + درگاه_خارج + ",proxy\nDOMAIN-SUFFIX,ir,direct\nFINAL,direct\n"، "direct")
    سرچاپ "خطاهای قاعده:"، قاعده‌ها.خطاها.طول()

    ناپایا شماره‌گیر := تونل.شماره‌گیر مسیریاب جدید(قاعده‌ها.مسیریاب)
    تونل.افزودن به شماره‌گیر مسیریاب(شماره‌گیر، "direct"، تونل.مستقیم())
    گام := تروجان.اتصال‌دهنده جدید("127.0.0.1"، دور.درگاه، "secret")
    تونل.افزودن به شماره‌گیر مسیریاب(شماره‌گیر، "proxy"، تونل.از طریق(تونل.مستقیم()، گام))

    ناپایا ترکیبی := تونل.ترکیبی جدید()
    تونل.تنظیم ساکس۵ ترکیبی(ترکیبی، ساکس.ورودی جدید(ساکس.پیکربندی سرور جدید(0)))
    تونل.تنظیم اچ تی تی پی ترکیبی(ترکیبی، پراکسی اچ‌تی‌تی‌پی.ورودی جدید(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)))
    پیشرو := تونل.انتقال‌دهنده جدید(شماره‌گیر، ترکیبی)
    ورودی_شبکه := تونل.شنود تی سی پی(0)
    تونل.سرویس‌دهی پس‌زمینه(ورودی_شبکه، ترکیبی، پیشرو)

    سرچاپ بپرس(ورودی_شبکه.درگاه، درگاه_محلی، "hello")
    سرچاپ بپرس(ورودی_شبکه.درگاه، درگاه_خارج، "hello")

    وب_مقدار := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، ورودی_شبکه.درگاه)، "127.0.0.1"، درگاه_خارج)
    سرچاپ "HTTP CONNECT:"، وب_مقدار.وضعیت
    وب_مقدار.جریان.نوشتن("via http")
    سرچاپ وب_مقدار.جریان.خواندن(100)
    وب_مقدار.جریان.بستن()

    همگام سازی.خواب میلی ثانیه(100)
    سرچاپ "اتصال‌ها:"، پیشرو.آمار.شمار کل()
    ورودی_شبکه.توقف()
    تروجان.توقف(دور)
پایان
