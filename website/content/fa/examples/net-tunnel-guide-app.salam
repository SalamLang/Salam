// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.ساکس
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تروجان
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا local_port := 0
ناپایا abroad_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع serve_echo(name: رشته، port: صحیح):
    srv := تی سی پی.پیوند(port)
    اگر name برابر "local":
        local_port = تی سی پی.درگاه(srv)
    وگرنه:
        abroad_port = تی سی پی.درگاه(srv)
    پایان
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        data := تی سی پی.خواندن(c، 100)
        تی سی پی.نوشتن(c، name + " saw " + data)
        تی سی پی.بستن(c)
    پایان
پایان

تابع local_echo():
    serve_echo("local"، 0)
پایان

تابع abroad_echo():
    serve_echo("abroad"، 0)
پایان

تابع ask(proxy_port: صحیح، port: صحیح، text: رشته): رشته:
    r := ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، proxy_port)، "127.0.0.1"، port)
    r.جریان.نوشتن(text)
    answer := r.جریان.خواندن(100)
    r.جریان.بستن()
    برگشت answer
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _a := نخ‌ساز(local_echo)
    _b := نخ‌ساز(abroad_echo)
    همگام سازی.انتظار(ready)

    ناپایا remote_cfg := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.افزودن گذرواژه(remote_cfg، "secret")
    remote := تروجان.سرویس‌دهی بدون رمز(remote_cfg، 0)

    rules := تونل.تجزیه قاعده‌ها("DST-PORT," + abroad_port + ",proxy\nDOMAIN-SUFFIX,ir,direct\nFINAL,direct\n"، "direct")
    سرچاپ "خطاهای قاعده:"، rules.خطاها.طول()

    ناپایا dialer := تونل.شماره‌گیر مسیریاب جدید(rules.مسیریاب)
    تونل.افزودن به شماره‌گیر مسیریاب(dialer، "direct"، تونل.مستقیم())
    hop := تروجان.اتصال‌دهنده جدید("127.0.0.1"، remote.درگاه، "secret")
    تونل.افزودن به شماره‌گیر مسیریاب(dialer، "proxy"، تونل.از طریق(تونل.مستقیم()، hop))

    ناپایا mixed := تونل.ترکیبی جدید()
    تونل.تنظیم ساکس۵ ترکیبی(mixed، ساکس.ورودی جدید(ساکس.پیکربندی سرور جدید(0)))
    تونل.تنظیم اچ تی تی پی ترکیبی(mixed، پراکسی اچ‌تی‌تی‌پی.ورودی جدید(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)))
    forward := تونل.انتقال‌دهنده جدید(dialer، mixed)
    inbound := تونل.شنود تی سی پی(0)
    تونل.سرویس‌دهی پس‌زمینه(inbound، mixed، forward)

    سرچاپ ask(inbound.درگاه، local_port، "hello")
    سرچاپ ask(inbound.درگاه، abroad_port، "hello")

    web := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، inbound.درگاه)، "127.0.0.1"، abroad_port)
    سرچاپ "HTTP CONNECT:"، web.وضعیت
    web.جریان.نوشتن("via http")
    سرچاپ web.جریان.خواندن(100)
    web.جریان.بستن()

    همگام سازی.خواب میلی ثانیه(100)
    سرچاپ "اتصال‌ها:"، forward.آمار.شمار کل()
    inbound.توقف()
    تروجان.توقف(remote)
پایان
