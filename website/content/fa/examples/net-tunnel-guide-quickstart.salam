// زبان: فارسی
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

تابع ریشه:
    پیوندها := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@vpn.example.org:443?security=tls&type=ws&host=vpn.example.org&path=%2Fws&sni=front.example.net#My Server\ntrojan://s3cret@vpn.example.org:443?sni=vpn.example.org#Backup\nnot a link"
    اشتراک := تونل.تجزیه اشتراک(پیوندها)
    سرچاپ "سرورها:"، اشتراک.گره‌ها.طول()، "ردشده:"، اشتراک.ردشده

    ناپایا گزینه‌ها := وی‌پی‌ان.گزینه‌ها {}
    گزینه‌ها.تکه‌تکه کردن = درست
    گزینه‌ها.استفاده از دی او اچ = درست
    گزینه‌ها.حل‌کننده = دی‌اوه‌اچ.حل‌کننده جدید(دی‌اوه‌اچ.کارگزارهای پیش‌فرض())
    وی‌پی‌ان.ثبت با گزینه‌ها(گزینه‌ها)

    پیکربندی := تونل.پیکربندی از گره‌ها(اشتراک.گره‌ها، 18080)
    خطاها := تونل.اعتبارسنجی پیکربندی(پیکربندی)
    سرچاپ "مشکل‌های پیکربندی:"، خطاها.طول()

    آمار := تونل.آمار جدید()
    شنونده‌ها := وی‌پی‌ان.شروع همه(پیکربندی، آمار)
    سرچاپ "در حال شنود:"، وی‌پی‌ان.معتبر(شنونده‌ها[0])
    وی‌پی‌ان.توقف(شنونده‌ها[0])
پایان
