// زبان: فارسی
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

تابع ریشه:
    links := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@vpn.example.org:443?security=tls&type=ws&host=vpn.example.org&path=%2Fws&sni=front.example.net#My Server\ntrojan://s3cret@vpn.example.org:443?sni=vpn.example.org#Backup\nnot a link"
    sub := تونل.تجزیه اشتراک(links)
    سرچاپ "سرورها:"، sub.گره‌ها.طول()، "ردشده:"، sub.ردشده

    ناپایا options := وی‌پی‌ان.گزینه‌ها {}
    options.تکه‌تکه کردن = درست
    options.استفاده از دی او اچ = درست
    options.حل‌کننده = دی‌اوه‌اچ.حل‌کننده جدید(دی‌اوه‌اچ.کارگزارهای پیش‌فرض())
    وی‌پی‌ان.ثبت با گزینه‌ها(options)

    cfg := تونل.پیکربندی از گره‌ها(sub.گره‌ها، 18080)
    errors := تونل.اعتبارسنجی پیکربندی(cfg)
    سرچاپ "مشکل‌های پیکربندی:"، errors.طول()

    stats := تونل.آمار جدید()
    listeners := وی‌پی‌ان.شروع همه(cfg، stats)
    سرچاپ "در حال شنود:"، وی‌پی‌ان.معتبر(listeners[0])
    وی‌پی‌ان.توقف(listeners[0])
پایان
