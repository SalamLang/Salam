واردسازی شبکه.یو دی پی
واردسازی حافظه

تابع ریشه:
    گیرنده := یو دی پی.پیوند روی("127.0.0.1"، ۰)
    فرستنده := یو دی پی.باز کردن()
    یو دی پی.تنظیم زمان انتظار(گیرنده، ۲۰۰۰)

    بیرون := حافظه.تخصیص صفرشده(۸ برگردان طبیعی۶۴)
    ب := بیرون برگردان طبیعی۸*
    ب[۰] = ۱ برگردان طبیعی۸
    ب[۱] = ۴۲ برگردان طبیعی۸
    ب[۲] = ۱ برگردان طبیعی۸
    ب[۳] = ۴۴ برگردان طبیعی۸
    فرستاده := یو دی پی.ارسال بایت(فرستنده، "127.0.0.1"، یو دی پی.درگاه(گیرنده)، بیرون، ۴)
    سرچاپ فرستاده، "بایت فرستاده شد"

    بافر := حافظه.تخصیص صفرشده(۱۵۰۰ برگردان طبیعی۶۴)
    ناپایا میزبان := ""
    ناپایا درگاه := ۰
    تعداد := یو دی پی.دریافت بایت(گیرنده، بافر، ۱۵۰۰، میزبان، درگاه)
    د := بافر برگردان طبیعی۸*
    نوع پیام := د[۰] برگردان صحیح
    حسگر := د[۱] برگردان صحیح
    مقدار حسگر := (د[۲] برگردان صحیح) * ۲۵۶ + (د[۳] برگردان صحیح)
    سرچاپ تعداد، "بایت از"، میزبان، "رسید"
    سرچاپ "نوع"، نوع پیام، "حسگر"، حسگر، "مقدار"، مقدار حسگر

    حافظه.آزادسازی(بیرون)
    حافظه.آزادسازی(بافر)
    یو دی پی.بستن(فرستنده)
    یو دی پی.بستن(گیرنده)
پایان
