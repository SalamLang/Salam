واردسازی شبکه.یو دی پی

تابع ریشه:
    گروه := "239.255.42.99"
    درگاه := ۹۹۹۹
    شنونده := یو دی پی.پیوند(درگاه)
    اگر وارونه یو دی پی.پیوستن به گروه پخش(شنونده، گروه):
        سرچاپ "پیوستن به"، گروه، "نشد"
        برگشت ۱
    پایان
    یو دی پی.تنظیم زمان انتظار(شنونده، ۱۰۰۰)

    اعلام‌کننده := یو دی پی.باز کردن()
    _ := یو دی پی.ارسال(اعلام‌کننده، گروه، درگاه، "چاپگر در 192.168.1.50")

    ب := یو دی پی.دریافت(شنونده، ۱۵۰۰)
    اگر ب.داده == "":
        سرچاپ "کسی چیزی اعلام نکرد"
    وگرنه:
        سرچاپ "شنیده شد:"، ب.داده
    پایان
    _ := یو دی پی.ترک گروه پخش(شنونده، گروه)
    یو دی پی.بستن(اعلام‌کننده)
    یو دی پی.بستن(شنونده)
    برگشت ۰
پایان
