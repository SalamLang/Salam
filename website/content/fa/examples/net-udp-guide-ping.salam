واردسازی شبکه.یو دی پی
واردسازی رشته

ناپایا سرور := یو دی پی.سوکت یو دی پی {}

تابع پاسخ‌گو():
    یو دی پی.تنظیم زمان انتظار(سرور، ۲۰۰۰)
    ناپایا شمار := ۰
    تا شمار < ۳:
        ب := یو دی پی.دریافت(سرور، ۱۵۰۰)
        اگر ب.داده == "":
            بشکن
        پایان
        شمار += ۱
        _ := یو دی پی.ارسال(سرور، ب.میزبان فرستنده، ب.درگاه فرستنده، "پونگ " + رشته.از عدد(شمار) + " برای " + ب.داده)
    پایان
پایان

تابع ریشه:
    سرور = یو دی پی.پیوند روی("127.0.0.1"، ۰)
    ن := نخ‌ساز(پاسخ‌گو)
    کارخواه := یو دی پی.باز کردن()
    یو دی پی.تنظیم زمان انتظار(کارخواه، ۲۰۰۰)
    هر نام در ["آلفا"، "بتا"، "گاما"]:
        _ := یو دی پی.ارسال(کارخواه، "127.0.0.1"، یو دی پی.درگاه(سرور)، نام)
        سرچاپ یو دی پی.دریافت(کارخواه، ۱۵۰۰).داده
    پایان
    نخ‌پیوند(ن)
    یو دی پی.بستن(کارخواه)
    یو دی پی.بستن(سرور)
پایان
