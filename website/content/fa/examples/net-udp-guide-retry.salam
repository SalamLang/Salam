واردسازی شبکه.یو دی پی

ناپایا سرور := یو دی پی.سوکت یو دی پی {}

تابع سرور بدقلق():
    یو دی پی.تنظیم زمان انتظار(سرور، ۳۰۰۰)
    ناپایا دیده := ۰
    تا دیده < ۳:
        ب := یو دی پی.دریافت(سرور، ۱۵۰۰)
        اگر ب.داده == "":
            بشکن
        پایان
        دیده += ۱
        اگر دیده == ۳:
            _ := یو دی پی.ارسال(سرور، ب.میزبان فرستنده، ب.درگاه فرستنده، "رسید: " + ب.داده)
        پایان
    پایان
پایان

تابع بپرس(سوکت: یو دی پی.سوکت یو دی پی، درگاه: صحیح، پرسش: رشته، دفعه‌ها: صحیح): رشته:
    تکرار دفعه‌ها در ای:
        _ := یو دی پی.ارسال(سوکت، "127.0.0.1"، درگاه، پرسش)
        پاسخ := یو دی پی.دریافت(سوکت، ۱۵۰۰)
        اگر پاسخ.داده != "":
            برگشت پاسخ.داده
        پایان
        سرچاپ "تلاش"، ای + ۱، "بی‌پاسخ ماند"
    پایان
    برگشت ""
پایان

تابع ریشه:
    سرور = یو دی پی.پیوند روی("127.0.0.1"، ۰)
    ن := نخ‌ساز(سرور بدقلق)
    کارخواه := یو دی پی.باز کردن()
    یو دی پی.تنظیم زمان انتظار(کارخواه، ۲۰۰)
    جواب := بپرس(کارخواه، یو دی پی.درگاه(سرور)، "وضعیت؟"، ۵)
    اگر جواب == "":
        سرچاپ "سرور در دسترس نیست"
    وگرنه:
        سرچاپ "پاسخ:"، جواب
    پایان
    نخ‌پیوند(ن)
    یو دی پی.بستن(کارخواه)
    یو دی پی.بستن(سرور)
پایان
