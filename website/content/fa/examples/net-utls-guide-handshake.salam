// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.اثر انگشت تی ال اس
واردسازی تی ال اس

تابع ریشه:
    c := تی سی پی.شماره گیری("www.example.com"، 443)
    ناپایا o := اثر انگشت تی ال اس.گزینه‌ها {}
    o.نام کارساز = "www.example.com"
    o.پروتکل برنامه = "http/1.1"
    cfg := تی ال اس.پیکربندی جدید("www.example.com")
    ناپایا t := اثر انگشت تی ال اس.پوشش کارخواه(c.توصیفگر، اثر انگشت تی ال اس.نمایه("chrome")، o، cfg)
    اگر وارونه تی ال اس.اتصال معتبر(t):
        سرچاپ "failed:"، تی ال اس.خطای اتصال(t)
        برگشت 1
    پایان
    تی ال اس.نوشتن(t، "GET / HTTP/1.1\r\nHost: www.example.com\r\nConnection: close\r\n\r\n")
    سرچاپ تی ال اس.خواندن(t، 200)
    تی ال اس.بستن اتصال(t)
پایان
