// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.اثر انگشت تی ال اس
واردسازی تی ال اس

تابع ریشه:
    نویسه := تی سی پی.شماره گیری("www.example.com"، 443)
    ناپایا او := اثر انگشت تی ال اس.گزینه‌ها {}
    او.نام کارساز = "www.example.com"
    او.پروتکل برنامه = "http/1.1"
    پیکربندی := تی ال اس.پیکربندی جدید("www.example.com")
    ناپایا موقت := اثر انگشت تی ال اس.پوشش کارخواه(نویسه.توصیفگر، اثر انگشت تی ال اس.نمایه("chrome")، او، پیکربندی)
    اگر وارونه تی ال اس.اتصال معتبر(موقت):
        سرچاپ "شکست خورد:"، تی ال اس.خطای اتصال(موقت)
        برگشت 1
    پایان
    تی ال اس.نوشتن(موقت، "GET / HTTP/1.1\r\nHost: www.example.com\r\nConnection: close\r\n\r\n")
    سرچاپ تی ال اس.خواندن(موقت، 200)
    تی ال اس.بستن اتصال(موقت)
پایان
