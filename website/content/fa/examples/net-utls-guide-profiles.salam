// زبان: فارسی
واردسازی شبکه.اثر انگشت تی ال اس

تابع ریشه:
    سرچاپ "نمایه‌ها:"، اثر انگشت تی ال اس.نام نمایه‌ها()
    ناپایا o := اثر انگشت تی ال اس.گزینه‌ها {}
    o.نام کارساز = "www.example.com"
    o.کلید پسا کوانتومی = نادرست
    هر name در ["chrome"، "firefox"، "safari"]:
        ناپایا h := اثر انگشت تی ال اس.ساخت(اثر انگشت تی ال اس.نمایه(name)، o)
        سرچاپ name، "پیام آغازین بزرگ‌تر از ۴۰۰ بایت است:"، h.خام.طول بزرگتر 400
        سرچاپ اثر انگشت تی ال اس.جی ای سه(h.خام)
        اثر انگشت تی ال اس.آزادسازی سلام(h)
    پایان
    سرچاپ "نمایه‌ی ناشناخته معتبر است:"، اثر انگشت تی ال اس.نمایه("netscape").معتبر
پایان
