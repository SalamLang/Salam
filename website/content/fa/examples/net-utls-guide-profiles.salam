// زبان: فارسی
واردسازی شبکه.اثر انگشت تی ال اس

تابع ریشه:
    سرچاپ "نمایه‌ها:"، اثر انگشت تی ال اس.نام نمایه‌ها()
    ناپایا او := اثر انگشت تی ال اس.گزینه‌ها {}
    او.نام کارساز = "www.example.com"
    او.کلید پسا کوانتومی = نادرست
    هر نام در ["chrome"، "firefox"، "safari"]:
        ناپایا اچ := اثر انگشت تی ال اس.ساخت(اثر انگشت تی ال اس.نمایه(نام)، او)
        سرچاپ نام، "پیام آغازین بزرگ‌تر از ۴۰۰ بایت است:"، اچ.خام.طول بزرگتر 400
        سرچاپ اثر انگشت تی ال اس.جی ای سه(اچ.خام)
        اثر انگشت تی ال اس.آزادسازی سلام(اچ)
    پایان
    سرچاپ "نمایه‌ی ناشناخته معتبر است:"، اثر انگشت تی ال اس.نمایه("netscape").معتبر
پایان
