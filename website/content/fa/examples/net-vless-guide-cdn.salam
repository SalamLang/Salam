// زبان: فارسی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا SHARE := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@front.example.net:443?encryption=none&security=tls&sni=front.example.net&alpn=http%2F1.1&type=ws&host=vpn.example.org&path=%2Fws-8f3a#cdn"

تابع ریشه:
    ال := وی لس.تجزیه پیوند(SHARE)
    اگر وارونه ال.معتبر:
        سرچاپ "پیوند نادرست:"، ال.خطا
        برگشت
    پایان
    هدف := انتقال شبکه.نشانی جدید("example.com"، 80)
    ناپایا نویسه := وی لس.شماره گیری پیوند(ال، وی لس.فرمان تی سی پی، هدف)
    اگر وارونه نویسه.معتبر:
        سرچاپ "اتصال ممکن نشد:"، نویسه.خطا
        برگشت
    پایان
    ناپایا درخواست := انتقال شبکه.از رشته("HEAD / HTTP/1.0\r\nHost: example.com\r\n\r\n")
    وی لس.نوشتن(نویسه، درخواست.نشانگر، درخواست.طول)
    انتقال شبکه.آزادسازی بایت‌ها(درخواست)
    وی لس.بستن(نویسه)
پایان
