// زبان: فارسی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا SHARE := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@front.example.net:443?encryption=none&security=tls&sni=front.example.net&alpn=http%2F1.1&type=ws&host=vpn.example.org&path=%2Fws-8f3a#cdn"

تابع ریشه:
    l := وی لس.تجزیه پیوند(SHARE)
    اگر وارونه l.معتبر:
        سرچاپ "پیوند نادرست:"، l.خطا
        برگشت
    پایان
    target := انتقال شبکه.نشانی جدید("example.com"، 80)
    ناپایا c := وی لس.شماره گیری پیوند(l، وی لس.فرمان تی سی پی، target)
    اگر وارونه c.معتبر:
        سرچاپ "اتصال ممکن نشد:"، c.خطا
        برگشت
    پایان
    ناپایا req := انتقال شبکه.از رشته("HEAD / HTTP/1.0\r\nHost: example.com\r\n\r\n")
    وی لس.نوشتن(c، req.نشانگر، req.طول)
    انتقال شبکه.آزادسازی بایت‌ها(req)
    وی لس.بستن(c)
پایان
