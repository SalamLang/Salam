// زبان: فارسی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

تابع ریشه:
    ناپایا پاسخ_محلی := وی لس.درخواست {}
    پاسخ_محلی.شناسه = انتقال شبکه.تجزیه یو یو آی دی(ID)
    پاسخ_محلی.فرمان = وی لس.فرمان تی سی پی
    پاسخ_محلی.نشانی = انتقال شبکه.نشانی جدید("example.com"، 443)
    سیم := وی لس.کدگذاری درخواست(پاسخ_محلی)
    سرچاپ انتقال شبکه.به هگزا(سیم)
    سرچاپ سیم.طول، "بایت: نگارش، ۱۶ بایت شناسه، ۰ بایت افزودنی، فرمان، درگاه، نوع نشانی، طول، نام"

    ناپایا بازگشت := وی لس.درخواست {}
    استفاده_شده := وی لس.کدگشایی درخواست(سیم، بازگشت)
    سرچاپ استفاده_شده برابر سیم.طول، بازگشت.نشانی.میزبان، بازگشت.نشانی.درگاه، بازگشت.فرمان، انتقال شبکه.قالب یو یو آی دی(بازگشت.شناسه) برابر ID

    برش := انتقال شبکه.از هگزا("00b831381d63244d53ad4f8cda48b3081100" + "0101bb020b6578616d")
    سرچاپ "سرآیند ناقص کدگشایی می‌شود به"، وی لس.کدگشایی درخواست(برش، بازگشت)
    فرد := انتقال شبکه.از هگزا("01b831381d63244d53ad4f8cda48b3081100" + "0101bb020b6578616d706c652e636f6d")
    سرچاپ "نگارش اشتباه کدگشایی می‌شود به"، وی لس.کدگشایی درخواست(فرد، بازگشت)
