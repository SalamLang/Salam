// زبان: فارسی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

تابع ریشه:
    ناپایا r := وی لس.درخواست {}
    r.شناسه = انتقال شبکه.تجزیه یو یو آی دی(ID)
    r.فرمان = وی لس.فرمان تی سی پی
    r.نشانی = انتقال شبکه.نشانی جدید("example.com"، 443)
    wire := وی لس.کدگذاری درخواست(r)
    سرچاپ انتقال شبکه.به هگزا(wire)
    سرچاپ wire.طول، "بایت: نگارش، ۱۶ بایت شناسه، ۰ بایت افزودنی، فرمان، درگاه، نوع نشانی، طول، نام"

    ناپایا back := وی لس.درخواست {}
    used := وی لس.کدگشایی درخواست(wire، back)
    سرچاپ used برابر wire.طول، back.نشانی.میزبان، back.نشانی.درگاه، back.فرمان، انتقال شبکه.قالب یو یو آی دی(back.شناسه) برابر ID

    cut := انتقال شبکه.از هگزا("00b831381d63244d53ad4f8cda48b3081100" + "0101bb020b6578616d")
    سرچاپ "سرآیند ناقص کدگشایی می‌شود به"، وی لس.کدگشایی درخواست(cut، back)
    odd := انتقال شبکه.از هگزا("01b831381d63244d53ad4f8cda48b3081100" + "0101bb020b6578616d706c652e636f6d")
    سرچاپ "نگارش اشتباه کدگشایی می‌شود به"، وی لس.کدگشایی درخواست(odd، back)
پایان
