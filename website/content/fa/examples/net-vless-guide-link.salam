// زبان: فارسی
واردسازی شبکه.وی لس

تابع ریشه:
    متن := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@cdn.example.com:443?encryption=none&security=tls&sni=front.example.net&alpn=http%2F1.1&fp=chrome&type=ws&host=vpn.example.org&path=%2Fws-8f3a%3Fed%3D2048#My%20Server"
    ال := وی لس.تجزیه پیوند(متن)
    سرچاپ ال.معتبر، ال.میزبان، ال.درگاه، ال.برچسب
    سرچاپ ال.امنیت، ال.شبکه، ال.نام سرور، ال.سربرگ میزبان، ال.مسیر

    متن_نمونه := وی لس.تنظیمات پیوند(ال)
    سرچاپ متن_نمونه.شبکه، متن_نمونه.تی ال اس، متن_نمونه.نام سرور، متن_نمونه.سربرگ میزبان، متن_نمونه.مسیر، متن_نمونه.داده زودهنگام

    بازهم := وی لس.تجزیه پیوند(وی لس.قالب پیوند(ال))
    سرچاپ "رفت‌وبرگشت مسیر را نگه می‌دارد:"، بازهم.مسیر برابر ال.مسیر

    سرچاپ وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h:443?security=quic").خطا
    سرچاپ وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h:443?type=kcp").خطا
    سرچاپ وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h:443?encryption=aes").خطا
    سرچاپ وی لس.تجزیه پیوند("vless://oops@h:443").خطا
پایان
