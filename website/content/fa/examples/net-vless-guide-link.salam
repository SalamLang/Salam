// زبان: فارسی
واردسازی شبکه.وی لس

تابع ریشه:
    text := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@cdn.example.com:443?encryption=none&security=tls&sni=front.example.net&alpn=http%2F1.1&fp=chrome&type=ws&host=vpn.example.org&path=%2Fws-8f3a%3Fed%3D2048#My%20Server"
    l := وی لس.تجزیه پیوند(text)
    سرچاپ l.معتبر، l.میزبان، l.درگاه، l.برچسب
    سرچاپ l.امنیت، l.شبکه، l.نام سرور، l.سربرگ میزبان، l.مسیر

    s := وی لس.تنظیمات پیوند(l)
    سرچاپ s.شبکه، s.تی ال اس، s.نام سرور، s.سربرگ میزبان، s.مسیر، s.داده زودهنگام

    again := وی لس.تجزیه پیوند(وی لس.قالب پیوند(l))
    سرچاپ "رفت‌وبرگشت مسیر را نگه می‌دارد:"، again.مسیر برابر l.مسیر

    سرچاپ وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h:443?security=quic").خطا
    سرچاپ وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h:443?type=kcp").خطا
    سرچاپ وی لس.تجزیه پیوند("vless://b831381d-6324-4d53-ad4f-8cda48b30811@h:443?encryption=aes").خطا
    سرچاپ وی لس.تجزیه پیوند("vless://oops@h:443").خطا
پایان
