// زبان: فارسی
واردسازی رشته
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا seen := ""

تابع server():
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا users := وکتور {} برگردان وکتور<وی لس.کاربر>
    users.بیفزا(وی لس.کاربر جدید(ID، ""))
    ناپایا c := وی لس.پذیرش(انتقال شبکه.پذیرش(l)، users)
    اگر c.معتبر:
        seen = c.درخواست.نشانی.میزبان + ":" + رشته.از عدد(c.درخواست.نشانی.درگاه برگردان صحیح۶۴)
        buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
        n := وی لس.خواندن(c، buf، 4096)
        وی لس.نوشتن(c، buf، n)
        حافظه.آزادسازی(buf)
    وگرنه:
        seen = "refused: " + c.خطا
    پایان
    وی لس.بستن(c)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)

    target := انتقال شبکه.نشانی جدید("example.com"، 443)
    ناپایا c := وی لس.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {}، ID، ""، وی لس.فرمان تی سی پی، target)
    ناپایا msg := انتقال شبکه.از رشته("hello through vless")
    وی لس.نوشتن(c، msg.نشانگر، msg.طول)
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    n := وی لس.خواندن(c، buf، 4096)
    سرچاپ (buf برگردان رشته).زیررشته(0، n)
    حافظه.آزادسازی(buf)
    انتقال شبکه.آزادسازی بایت‌ها(msg)
    وی لس.بستن(c)
    نخ‌پیوند(t)
    سرچاپ "سرور مقصد را دید"، seen
پایان
