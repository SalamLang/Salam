// زبان: فارسی
واردسازی رشته
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا درگاه := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا دیده := ""

تابع server():
    ال := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    درگاه = انتقال شبکه.درگاه شنونده(ال)
    همگام سازی.اتمام(آماده)
    ناپایا کاربران := وکتور {} برگردان وکتور<وی لس.کاربر>
    کاربران.بیفزا(وی لس.کاربر جدید(ID، ""))
    ناپایا نویسه := وی لس.پذیرش(انتقال شبکه.پذیرش(ال)، کاربران)
    اگر نویسه.معتبر:
        دیده = نویسه.درخواست.نشانی.میزبان + ":" + رشته.از عدد(نویسه.درخواست.نشانی.درگاه برگردان صحیح۶۴)
        بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
        شمار_بایت := وی لس.خواندن(نویسه، بافر، 4096)
        وی لس.نوشتن(نویسه، بافر، شمار_بایت)
        حافظه.آزادسازی(بافر)
    وگرنه:
        دیده = "refused: " + نویسه.خطا
    پایان
    وی لس.بستن(نویسه)
    انتقال شبکه.بستن شنونده(ال)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(server)
    همگام سازی.انتظار(آماده)

    هدف := انتقال شبکه.نشانی جدید("example.com"، 443)
    ناپایا نویسه := وی لس.شماره گیری("127.0.0.1"، درگاه، انتقال شبکه.تنظیمات {}، ID، ""، وی لس.فرمان تی سی پی، هدف)
    ناپایا پیام_داده := انتقال شبکه.از رشته("hello through vless")
    وی لس.نوشتن(نویسه، پیام_داده.نشانگر، پیام_داده.طول)
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    شمار_بایت := وی لس.خواندن(نویسه، بافر، 4096)
    سرچاپ (بافر برگردان رشته).زیررشته(0، شمار_بایت)
    حافظه.آزادسازی(بافر)
    انتقال شبکه.آزادسازی بایت‌ها(پیام_داده)
    وی لس.بستن(نویسه)
    نخ‌پیوند(موقت)
    سرچاپ "سرور مقصد را دید"، دیده
پایان
