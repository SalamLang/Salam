// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی لس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا pipe := تونل.لوله جدید()
ناپایا done := همگام سازی.گروه انتظار جدید()
ناپایا seen := ""

تابع server():
    ناپایا users := وکتور {} برگردان وکتور<وی لس.کاربر>
    users.بیفزا(وی لس.کاربر جدید(ID، ""))
    c := وی لس.پذیرش روی جریان(تونل.سر دوم لوله(pipe)، users)
    seen = c.درخواست.نشانی.میزبان
    s := وی لس.به عنوان جریان(c)
    buf := حافظه.تخصیص(256 برگردان طبیعی۶۴)
    n := s.خواندن بایت(buf، 256)
    s.نوشتن بایت(buf، n)
    حافظه.آزادسازی(buf)
    s.بستن()
    همگام سازی.اتمام(done)
پایان

تابع ریشه:
    همگام سازی.افزودن(done، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(server)
    c := وی لس.اتصال روی جریان(تونل.سر اول لوله(pipe)، ID، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("inner.example"، 443))
    s := وی لس.به عنوان جریان(c)
    s.نوشتن("hello over a pipe")
    buf := حافظه.تخصیص صفرشده(256 برگردان طبیعی۶۴)
    n := s.خواندن بایت(buf، 256)
    سرچاپ (buf برگردان رشته).زیررشته(0، n)
    حافظه.آزادسازی(buf)
    s.بستن()
    همگام سازی.انتظار(done)
    سرچاپ "server saw"، seen
پایان
