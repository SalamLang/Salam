// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی لس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا لوله := تونل.لوله جدید()
ناپایا انجام := همگام سازی.گروه انتظار جدید()
ناپایا دیده := ""

تابع server():
    ناپایا کاربران := وکتور {} برگردان وکتور<وی لس.کاربر>
    کاربران.بیفزا(وی لس.کاربر جدید(ID، ""))
    نویسه := وی لس.پذیرش روی جریان(تونل.سر دوم لوله(لوله)، کاربران)
    دیده = نویسه.درخواست.نشانی.میزبان
    متن_نمونه := وی لس.به عنوان جریان(نویسه)
    بافر := حافظه.تخصیص(256 برگردان طبیعی۶۴)
    شمار_بایت := متن_نمونه.خواندن بایت(بافر، 256)
    متن_نمونه.نوشتن بایت(بافر، شمار_بایت)
    حافظه.آزادسازی(بافر)
    متن_نمونه.بستن()
    همگام سازی.اتمام(انجام)
پایان

تابع ریشه:
    همگام سازی.افزودن(انجام، 1 برگردان صحیح۶۴)
    متغیر__t := نخ‌ساز(server)
    نویسه := وی لس.اتصال روی جریان(تونل.سر اول لوله(لوله)، ID، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("inner.example"، 443))
    متن_نمونه := وی لس.به عنوان جریان(نویسه)
    متن_نمونه.نوشتن("hello over a pipe")
    بافر := حافظه.تخصیص صفرشده(256 برگردان طبیعی۶۴)
    شمار_بایت := متن_نمونه.خواندن بایت(بافر، 256)
    سرچاپ (بافر برگردان رشته).زیررشته(0، شمار_بایت)
    حافظه.آزادسازی(بافر)
    متن_نمونه.بستن()
    همگام سازی.انتظار(انجام)
    سرچاپ "سرور دید"، دیده
پایان
