// زبان: فارسی
واردسازی رشته
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع server():
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا users := وکتور {} برگردان وکتور<وی لس.کاربر>
    users.بیفزا(وی لس.کاربر جدید(ID، ""))
    ناپایا c := وی لس.پذیرش(انتقال شبکه.پذیرش(l)، users)
    تا c.معتبر:
        ناپایا p := انتقال شبکه.بایت‌های جدید(64)
        اگر وارونه وی لس.خواندن بسته(c، p):
            انتقال شبکه.آزادسازی بایت‌ها(p)
            بشکن
        پایان
        وی لس.نوشتن بسته(c، p.نشانگر، p.طول)
        انتقال شبکه.آزادسازی بایت‌ها(p)
    پایان
    وی لس.بستن(c)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
    dns := انتقال شبکه.نشانی جدید("8.8.8.8"، 53)
    ناپایا c := وی لس.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {}، ID، ""، وی لس.فرمان یو دی پی، dns)
    تکرار 3 در i:
        ناپایا msg := انتقال شبکه.از رشته("datagram " + رشته.از عدد(i برگردان صحیح۶۴))
        وی لس.نوشتن بسته(c، msg.نشانگر، msg.طول)
        ناپایا back := انتقال شبکه.بایت‌های جدید(64)
        وی لس.خواندن بسته(c، back)
        سرچاپ back.طول، (back.نشانگر برگردان رشته).زیررشته(0، back.طول)
        انتقال شبکه.آزادسازی بایت‌ها(back)
        انتقال شبکه.آزادسازی بایت‌ها(msg)
    پایان
    وی لس.بستن(c)
    نخ‌پیوند(t)
پایان
