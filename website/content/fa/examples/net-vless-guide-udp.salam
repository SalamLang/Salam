تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(کارساز)
    همگام سازی.انتظار(آماده)
    دی‌ان‌اس := انتقال شبکه.نشانی جدید("8.8.8.8"، 53)
    ناپایا نویسه := وی لس.شماره گیری("127.0.0.1"، درگاه، انتقال شبکه.تنظیمات {}، ID، ""، وی لس.فرمان یو دی پی، دی‌ان‌اس)
    تکرار 3 در شمارنده:
        ناپایا پیام_داده := انتقال شبکه.از رشته("datagram " + رشته.از عدد(شمارنده برگردان صحیح۶۴))
        وی لس.نوشتن بسته(نویسه، پیام_داده.نشانگر، پیام_داده.طول)
        ناپایا بازگشت := انتقال شبکه.بایت‌های جدید(64)
        وی لس.خواندن بسته(نویسه، بازگشت)
        سرچاپ بازگشت.طول، (بازگشت.نشانگر برگردان رشته).زیررشته(0، بازگشت.طول)
        انتقال شبکه.آزادسازی بایت‌ها(بازگشت)
        انتقال شبکه.آزادسازی بایت‌ها(پیام_داده)
