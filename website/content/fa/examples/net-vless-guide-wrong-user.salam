// زبان: فارسی
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی لس

پایا GOOD := "b831381d-6324-4d53-ad4f-8cda48b30811"
پایا OTHER := "5783a3e7-e373-51cd-8642-c83782b807c5"

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا verdict := ""

تابع server():
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا users := وکتور {} برگردان وکتور<وی لس.کاربر>
    users.بیفزا(وی لس.کاربر جدید(GOOD، ""))
    ناپایا c := وی لس.پذیرش(انتقال شبکه.پذیرش(l)، users)
    verdict = c.معتبر ? "accepted " + c.کاربر : "refused: " + c.خطا
    وی لس.بستن(c)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
    ناپایا c := وی لس.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {}، OTHER، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("example.com"، 80))
    سرچاپ "سمت کارخواه تا وقتی نخوانده سالم به نظر می‌رسد:"، c.معتبر
    نخ‌پیوند(t)
    سرچاپ verdict
    وی لس.بستن(c)
پایان
