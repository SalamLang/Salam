// زبان: فارسی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی مس

تابع ریشه:
    ناپایا متن_نمونه := انتقال شبکه.تنظیمات {}
    متن_نمونه.شبکه = "ws"
    متن_نمونه.تی ال اس = درست
    متن_نمونه.نام سرور = "front.example.net"
    متن_نمونه.سربرگ میزبان = "vpn.example.org"
    متن_نمونه.مسیر = "/vm-31c9"
    متن_نمونه.الپن = "http/1.1"

    هدف := انتقال شبکه.نشانی جدید("example.com"، 80)
    ناپایا نویسه := وی مس.شماره گیری("front.example.net"، 443، متن_نمونه، "b831381d-6324-4d53-ad4f-8cda48b30811"، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، وی مس.فرمان تی سی پی، هدف)
    اگر وارونه نویسه.معتبر:
        سرچاپ "اتصال ممکن نشد:"، نویسه.خطا
        برگشت
    پایان
    ناپایا درخواست := انتقال شبکه.از رشته("HEAD / HTTP/1.0\r\nHost: example.com\r\n\r\n")
    وی مس.نوشتن(نویسه، درخواست.نشانگر، درخواست.طول)
    انتقال شبکه.آزادسازی بایت‌ها(درخواست)
    وی مس.بستن(نویسه)
پایان
