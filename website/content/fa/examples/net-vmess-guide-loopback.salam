// زبان: فارسی
واردسازی حافظه
واردسازی رشته
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی مس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا درگاه := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا دیده := ""

تابع server():
    ال := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    درگاه = انتقال شبکه.درگاه شنونده(ال)
    همگام سازی.اتمام(آماده)
    ناپایا کاربران := وکتور {} برگردان وکتور<وی مس.کاربر>
    کاربران.بیفزا(وی مس.کاربر جدید(ID))
    ناپایا چارچوب_خواندن := وی مس.فیلتر بازپخش جدید()
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    تکرار 3:
        ناپایا نویسه := وی مس.پذیرش(انتقال شبکه.پذیرش(ال)، کاربران، چارچوب_خواندن)
        اگر وارونه نویسه.معتبر:
            دیده += "refused(" + نویسه.خطا + ") "
            گذر
        پایان
        دیده += نویسه.درخواست.نشانی.میزبان + " security " + رشته.از عدد(نویسه.درخواست.امنیت برگردان صحیح۶۴) + "; "
        شمار_بایت := وی مس.خواندن(نویسه، بافر، 4096)
        وی مس.نوشتن(نویسه، بافر، شمار_بایت)
        وی مس.بستن(نویسه)
    پایان
    حافظه.آزادسازی(بافر)
    انتقال شبکه.بستن شنونده(ال)
پایان

تابع talk(متغیر_security: صحیح):
    هدف := انتقال شبکه.نشانی جدید("example.com"، 443)
    ناپایا نویسه := وی مس.شماره گیری("127.0.0.1"، درگاه، انتقال شبکه.تنظیمات {}، ID، متغیر_security، وی مس.فرمان تی سی پی، هدف)
    ناپایا پیام_داده := انتقال شبکه.از رشته("hello through vmess")
    وی مس.نوشتن(نویسه، پیام_داده.نشانگر، پیام_داده.طول)
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    شمار_بایت := وی مس.خواندن(نویسه، بافر، 4096)
    سرچاپ متغیر_security، (بافر برگردان رشته).زیررشته(0، شمار_بایت)
    حافظه.آزادسازی(بافر)
    انتقال شبکه.آزادسازی بایت‌ها(پیام_داده)
    وی مس.بستن(نویسه)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(server)
    همگام سازی.انتظار(آماده)
    talk(وی مس.امنیت ای ای اس۱۲۸ جی سی ام)
    talk(وی مس.امنیت چاچا۲۰ پلی۱۳۰۵)
    talk(وی مس.امنیت هیچ)
    نخ‌پیوند(موقت)
    سرچاپ دیده
پایان
