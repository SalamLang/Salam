// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی لس
واردسازی شبکه.وی مس

پایا OUTER := "b831381d-6324-4d53-ad4f-8cda48b30811"
پایا INNER := "5783a3e7-e373-51cd-8642-c83782b807c5"

ناپایا pipe := تونل.لوله جدید()
ناپایا done := همگام سازی.گروه انتظار جدید()
ناپایا seen := ""

تابع server():
    ناپایا vl := وکتور {} برگردان وکتور<وی لس.کاربر>
    vl.بیفزا(وی لس.کاربر جدید(OUTER، ""))
    ناپایا vm := وکتور {} برگردان وکتور<وی مس.کاربر>
    vm.بیفزا(وی مس.کاربر جدید(INNER))
    ناپایا rf := وی مس.فیلتر بازپخش جدید()
    outer := وی لس.پذیرش روی جریان(تونل.سر دوم لوله(pipe)، vl)
    inner := وی مس.پذیرش روی جریان(وی لس.به عنوان جریان(outer)، vm، rf)
    seen = outer.درخواست.نشانی.میزبان + " then " + inner.درخواست.نشانی.میزبان
    s := وی مس.به عنوان جریان(inner)
    buf := حافظه.تخصیص(256 برگردان طبیعی۶۴)
    n := s.خواندن بایت(buf، 256)
    s.نوشتن بایت(buf، n)
    حافظه.آزادسازی(buf)
    s.بستن()
    همگام سازی.اتمام(done)
پایان

تابع ریشه:
    همگام سازی.افزودن(done، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(server)
    outer := وی لس.اتصال روی جریان(تونل.سر اول لوله(pipe)، OUTER، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("hop.example"، 443))
    inner := وی مس.اتصال روی جریان(وی لس.به عنوان جریان(outer)، INNER، وی مس.امنیت چاچا۲۰ پلی۱۳۰۵، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("final.example"، 443))
    s := وی مس.به عنوان جریان(inner)
    s.نوشتن("two layers deep")
    buf := حافظه.تخصیص صفرشده(256 برگردان طبیعی۶۴)
    n := s.خواندن بایت(buf، 256)
    سرچاپ (buf برگردان رشته).زیررشته(0، n)
    حافظه.آزادسازی(buf)
    s.بستن()
    همگام سازی.انتظار(done)
    سرچاپ "server saw"، seen
پایان
