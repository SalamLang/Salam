// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی لس
واردسازی شبکه.وی مس

پایا OUTER := "b831381d-6324-4d53-ad4f-8cda48b30811"
پایا INNER := "5783a3e7-e373-51cd-8642-c83782b807c5"

ناپایا لوله := تونل.لوله جدید()
ناپایا انجام := همگام سازی.گروه انتظار جدید()
ناپایا دیده := ""

تابع server():
    ناپایا وی‌لس := وکتور {} برگردان وکتور<وی لس.کاربر>
    وی‌لس.بیفزا(وی لس.کاربر جدید(OUTER، ""))
    ناپایا وی‌مس := وکتور {} برگردان وکتور<وی مس.کاربر>
    وی‌مس.بیفزا(وی مس.کاربر جدید(INNER))
    ناپایا چارچوب_خواندن := وی مس.فیلتر بازپخش جدید()
    بیرونی := وی لس.پذیرش روی جریان(تونل.سر دوم لوله(لوله)، وی‌لس)
    درونی := وی مس.پذیرش روی جریان(وی لس.به عنوان جریان(بیرونی)، وی‌مس، چارچوب_خواندن)
    دیده = بیرونی.درخواست.نشانی.میزبان + " then " + درونی.درخواست.نشانی.میزبان
    متن_نمونه := وی مس.به عنوان جریان(درونی)
    بافر := حافظه.تخصیص(256 برگردان طبیعی۶۴)
    شمار_بایت := متن_نمونه.خواندن بایت(بافر، 256)
    متن_نمونه.نوشتن بایت(بافر، شمار_بایت)
    حافظه.آزادسازی(بافر)
    متن_نمونه.بستن()
    همگام سازی.اتمام(انجام)
پایان

تابع ریشه:
    همگام سازی.افزودن(انجام، 1 برگردان صحیح۶۴)
    متغیر__t := نخ‌ساز(server)
    بیرونی := وی لس.اتصال روی جریان(تونل.سر اول لوله(لوله)، OUTER، ""، وی لس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("hop.example"، 443))
    درونی := وی مس.اتصال روی جریان(وی لس.به عنوان جریان(بیرونی)، INNER، وی مس.امنیت چاچا۲۰ پلی۱۳۰۵، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("final.example"، 443))
    متن_نمونه := وی مس.به عنوان جریان(درونی)
    متن_نمونه.نوشتن("two layers deep")
    بافر := حافظه.تخصیص صفرشده(256 برگردان طبیعی۶۴)
    شمار_بایت := متن_نمونه.خواندن بایت(بافر، 256)
    سرچاپ (بافر برگردان رشته).زیررشته(0، شمار_بایت)
    حافظه.آزادسازی(بافر)
    متن_نمونه.بستن()
    همگام سازی.انتظار(انجام)
    سرچاپ "سرور دید"، دیده
پایان
