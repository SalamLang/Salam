// زبان: فارسی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی مس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

تابع ریشه:
    key := وی مس.کلید فرمان(انتقال شبکه.تجزیه یو یو آی دی(ID))
    سرچاپ "کلید فرمان"، انتقال شبکه.به هگزا(key)

    stamp := 1700000000 برگردان صحیح۶۴
    salt := انتقال شبکه.از هگزا("a1b2c3d4")
    authid := وی مس.ساخت شناسه احراز(key، stamp، salt)
    سرچاپ "شناسه‌ی احراز"، انتقال شبکه.به هگزا(authid)

    ناپایا when := 0 برگردان صحیح۶۴
    سرچاپ "با کلید درست باز می‌شود:"، وی مس.گشودن شناسه احراز(key، authid، when)، when برابر stamp
    other := وی مس.کلید فرمان(انتقال شبکه.تجزیه یو یو آی دی("5783a3e7-e373-51cd-8642-c83782b807c5"))
    سرچاپ "برای کاربر دیگر رد می‌شود:"، وارونه وی مس.گشودن شناسه احراز(other، authid، when)

    nonce := انتقال شبکه.از هگزا("1112131415161718")
    sealed := وی مس.مهر سرآیند(key، انتقال شبکه.از رشته("a small header")، stamp، salt، nonce)
    سرچاپ "سرآیند مهرشده"، sealed.طول، "بایت است"
    سرچاپ "پنجره‌ی زمانی به ثانیه:"، وی مس.پنجره زمانی
    سرچاپ "گزینه‌ی پیش‌فرض برای aes-gcm:"، وی مس.گزینه پیش فرض(وی مس.امنیت ای ای اس۱۲۸ جی سی ام)
    سرچاپ "گزینه‌ی پیش‌فرض برای none:"، وی مس.گزینه پیش فرض(وی مس.امنیت هیچ)
    سرچاپ "گزینه‌ی پیش‌فرض برای zero:"، وی مس.گزینه پیش فرض(وی مس.امنیت صفر)
پایان
