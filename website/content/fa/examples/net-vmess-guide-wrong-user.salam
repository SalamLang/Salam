// زبان: فارسی
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی مس

پایا GOOD := "b831381d-6324-4d53-ad4f-8cda48b30811"
پایا OTHER := "5783a3e7-e373-51cd-8642-c83782b807c5"

ناپایا درگاه := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()
ناپایا حکم := ""

تابع کارساز():
    ال := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    درگاه = انتقال شبکه.درگاه شنونده(ال)
    همگام سازی.اتمام(آماده)
    ناپایا کاربران := وکتور {} برگردان وکتور<وی مس.کاربر>
    کاربران.بیفزا(وی مس.کاربر جدید(GOOD))
    ناپایا چارچوب_خواندن := وی مس.فیلتر بازپخش جدید()
    ناپایا نویسه := وی مس.پذیرش(انتقال شبکه.پذیرش(ال)، کاربران، چارچوب_خواندن)
    حکم = نویسه.معتبر ? "accepted " + نویسه.کاربر : "refused: " + نویسه.خطا
    وی مس.بستن(نویسه)
    انتقال شبکه.بستن شنونده(ال)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(کارساز)
    همگام سازی.انتظار(آماده)
    ناپایا نویسه := وی مس.شماره گیری("127.0.0.1"، درگاه، انتقال شبکه.تنظیمات {}، OTHER، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("example.com"، 80))
    نخ‌پیوند(موقت)
    سرچاپ حکم
    وی مس.بستن(نویسه)
پایان
