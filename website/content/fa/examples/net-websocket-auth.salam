واردسازی شبکه.وب‌سوکت
واردسازی شبکه.اچ تی تی پی

ناپایا سرور := وب‌سوکت.سرور {}

تابع دروازه():
    تکرار ۲:
        ناپایا اتصال := وب‌سوکت.پذیرش(سرور)
        توکن := اچ تی تی پی.مقدار سرصفحه(اتصال.سرآیندهای دست‌دهی، "authorization")
        اگر توکن برابر "Bearer sara-token":
            _ := وب‌سوکت.ارسال متن(اتصال، "سارا، خوش آمدی")
            پرسش := وب‌سوکت.دریافت متن(اتصال)
            _ := وب‌سوکت.ارسال متن(اتصال، "پرسیدی: " + پرسش)
        وگرنه:
            _ := وب‌سوکت.ارسال متن(اتصال، "شما کی هستید؟")
        پایان
        وب‌سوکت.بستن(اتصال)
    پایان
پایان

تابع امتحان(درگاه: صحیح، سرآیند اضافه: رشته):
    ناپایا ک := وب‌سوکت.شماره گیری با سربرگ("127.0.0.1"، درگاه، "/live"، سرآیند اضافه)
    سرچاپ "باز:"، وب‌سوکت.باز است(ک)، "سرور می‌گوید:"، وب‌سوکت.دریافت متن(ک)
    اگر سرآیند اضافه نابرابر "":
        _ := وب‌سوکت.ارسال متن(ک، "خبر تازه‌ای هست؟")
        سرچاپ وب‌سوکت.دریافت متن(ک)
    پایان
    پیام := وب‌سوکت.دریافت با مهلت(ک، ۲۰۰۰)
    سرچاپ "سرور بست:"، وب‌سوکت.بسته است(پیام)
پایان

تابع ریشه:
    سرور = وب‌سوکت.شنود(۰)
    نخ := نخ‌ساز(دروازه)
    امتحان(وب‌سوکت.درگاه(سرور)، "Authorization: Bearer sara-token\r\n")
    امتحان(وب‌سوکت.درگاه(سرور)، "")
    نخ‌پیوند(نخ)
    وب‌سوکت.بستن سرور(سرور)
پایان
