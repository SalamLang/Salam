واردسازی شبکه.وب‌سوکت
واردسازی رشته
واردسازی همگام سازی

ناپایا سرور := وب‌سوکت.سرور {}
ناپایا هاب := وب‌سوکت.هاب جدید()
ناپایا قفل := همگام سازی.قفل جدید()

تابع اعلام(متن: رشته):
    همگام سازی.قفل کردن(قفل)
    _ := وب‌سوکت.پخش(هاب، "lobby"، متن)
    همگام سازی.باز کردن قفل(قفل)
پایان

تابع عضو():
    ناپایا اتصال := وب‌سوکت.پذیرش(سرور)
    اگر وارونه وب‌سوکت.باز است(اتصال): برگشت پایان
    نام := رشته.جایگزینی(اتصال.مسیر، "/chat/"، "")
    نسخه عضویت := اتصال
    همگام سازی.قفل کردن(قفل)
    وب‌سوکت.ثبت(هاب، "lobby"، نسخه عضویت)
    همگام سازی.باز کردن قفل(قفل)
    _ := وب‌سوکت.ارسال متن(اتصال، "خوش آمدی، " + نام)
    تا وب‌سوکت.باز است(اتصال):
        پ := وب‌سوکت.دریافت پیام(اتصال)
        اگر وارونه وب‌سوکت.متن است(پ): بشکن پایان
        اعلام(نام + ": " + پ.متن)
    پایان
    همگام سازی.قفل کردن(قفل)
    وب‌سوکت.لغو ثبت(هاب، "lobby"، نسخه عضویت)
    همگام سازی.باز کردن قفل(قفل)
    اعلام(نام + " رفت")
    وب‌سوکت.بستن(اتصال)
پایان

تابع ریشه:
    سرور = وب‌سوکت.شنود(۰)
    درگاه := وب‌سوکت.درگاه(سرور)
    الف := نخ‌ساز(عضو)
    ب := نخ‌ساز(عضو)
    ناپایا سارا := وب‌سوکت.شماره گیری("127.0.0.1"، درگاه، "/chat/sara")
    سرچاپ "سارا گرفت:"، وب‌سوکت.دریافت متن(سارا)
    ناپایا رضا := وب‌سوکت.شماره گیری("127.0.0.1"، درگاه، "/chat/reza")
    سرچاپ "رضا گرفت:"، وب‌سوکت.دریافت متن(رضا)

    _ := وب‌سوکت.ارسال متن(سارا، "ناهار ساعت یک؟")
    سرچاپ "سارا گرفت:"، وب‌سوکت.دریافت متن(سارا)
    سرچاپ "رضا گرفت:"، وب‌سوکت.دریافت متن(رضا)

    وب‌سوکت.بستن(رضا)
    سرچاپ "سارا گرفت:"، وب‌سوکت.دریافت متن(سارا)
    وب‌سوکت.بستن(سارا)
    نخ‌پیوند(الف)
    نخ‌پیوند(ب)
    سرچاپ "باقی‌مانده در لابی:"، وب‌سوکت.اندازه اتاق(هاب، "lobby")
    وب‌سوکت.بستن سرور(سرور)
    همگام سازی.نابودسازی(قفل)
پایان
