واردسازی شبکه.وب‌سوکت
واردسازی زمان

ناپایا سرور := وب‌سوکت.سرور {}

تابع کارگر():
    ناپایا اتصال := وب‌سوکت.پذیرش(سرور)
    زمان.خواب(۴۰۰)
    _ := وب‌سوکت.ارسال متن(اتصال، "گزارش آماده است")
    تا وب‌سوکت.باز است(اتصال):
        پیام := وب‌سوکت.دریافت پیام(اتصال)
        اگر وب‌سوکت.بسته است(پیام) یا پیام.نوع برابر وب‌سوکت.هیچ: بشکن پایان
    پایان
    وب‌سوکت.بستن(اتصال)
پایان

تابع ریشه:
    سرور = وب‌سوکت.شنود(۰)
    نخ := نخ‌ساز(کارگر)
    ناپایا ک := وب‌سوکت.شماره گیری("127.0.0.1"، وب‌سوکت.درگاه(سرور)، "/jobs/42")
    ناپایا بیکار := ۰
    ناپایا جواب := ""
    تا جواب برابر "" و بیکار کوچکتر ۵۰:
        پیام := وب‌سوکت.دریافت با مهلت(ک، ۱۰۰)
        اگر پیام.نوع برابر وب‌سوکت.مهلت:
            بیکار += ۱
            _ := وب‌سوکت.پینگ فرست(ک، "هنوز این‌جام")
        وگرنه وب‌سوکت.متن است(پیام):
            جواب = پیام.متن
        وگرنه وب‌سوکت.بسته است(پیام):
            بشکن
        پایان
    پایان
    سرچاپ "جواب:"، جواب
    سرچاپ "در انتظار پینگ فرستاد:"، بیکار بزرگتر ۰
    وب‌سوکت.بستن(ک)
    نخ‌پیوند(نخ)
    وب‌سوکت.بستن سرور(سرور)
پایان
