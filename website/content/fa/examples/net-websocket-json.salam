واردسازی شبکه.وب‌سوکت
واردسازی کدگذاری.جیسون

ناپایا سرور := وب‌سوکت.سرور {}

تابع گفتگو():
    ناپایا اتصال := وب‌سوکت.پذیرش(سرور)
    ناپایا نام := ""
    تا وب‌سوکت.باز است(اتصال):
        پیام := وب‌سوکت.دریافت پیام(اتصال)
        اگر وارونه وب‌سوکت.متن است(پیام): بشکن پایان
        نوع := جیسون.دریافت(پیام.متن، "type")
        اگر نوع برابر "join":
            نام = جیسون.دریافت(پیام.متن، "name")
            _ := وب‌سوکت.ارسال متن(اتصال، `{"type": "joined", "users": 1}`)
        وگرنه نوع برابر "say":
            پاسخ := `{"type": "said", "from": ` + جیسون.رشته جیسون(نام) + `, "text": ` + جیسون.رشته جیسون(جیسون.دریافت(پیام.متن، "text")) + `}`
            _ := وب‌سوکت.ارسال متن(اتصال، پاسخ)
        وگرنه:
            _ := وب‌سوکت.ارسال متن(اتصال، `{"type": "error", "reason": "unknown type"}`)
        پایان
    پایان
    وب‌سوکت.بستن(اتصال)
پایان

تابع بپرس(ک &: وب‌سوکت.اتصال وب، درخواست: رشته): رشته:
    _ := وب‌سوکت.ارسال متن(ک، درخواست)
    برگشت وب‌سوکت.دریافت متن(ک)
پایان

تابع ریشه:
    سرور = وب‌سوکت.شنود(۰)
    نخ := نخ‌ساز(گفتگو)
    ناپایا ک := وب‌سوکت.شماره گیری("127.0.0.1"، وب‌سوکت.درگاه(سرور)، "/chat")
    پیوست := بپرس(ک، `{"type": "join", "name": "سارا"}`)
    سرچاپ جیسون.دریافت(پیوست، "type")، "کاربران:"، جیسون.دریافت عدد(پیوست، "users")
    گفته := بپرس(ک، `{"type": "say", "text": "سلام \"به همه\""}`)
    سرچاپ جیسون.دریافت(گفته، "from")، "گفت:"، جیسون.دریافت(گفته، "text")
    سرچاپ بپرس(ک، `{"type": "dance"}`)
    وب‌سوکت.بستن(ک)
    نخ‌پیوند(نخ)
    وب‌سوکت.بستن سرور(سرور)
پایان
