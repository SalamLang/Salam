واردسازی شبکه.وب‌سوکت
واردسازی رشته

ناپایا سرور := وب‌سوکت.سرور {}
ناپایا هاب := وب‌سوکت.هاب جدید()

تابع پذیرنده():
    تکرار ۳:
        اتصال := وب‌سوکت.پذیرش(سرور)
        اتاق := رشته.جایگزینی(اتصال.مسیر، "/rooms/"، "")
        وب‌سوکت.ثبت(هاب، اتاق، اتصال)
    پایان
پایان

تابع ریشه:
    سرور = وب‌سوکت.شنود(۰)
    درگاه := وب‌سوکت.درگاه(سرور)
    نخ := نخ‌ساز(پذیرنده)
    ناپایا علی := وب‌سوکت.شماره گیری("127.0.0.1"، درگاه، "/rooms/news")
    ناپایا سارا := وب‌سوکت.شماره گیری("127.0.0.1"، درگاه، "/rooms/news")
    ناپایا رضا := وب‌سوکت.شماره گیری("127.0.0.1"، درگاه، "/rooms/sport")
    نخ‌پیوند(نخ)
    سرچاپ "خبر:"، وب‌سوکت.اندازه اتاق(هاب، "news")، "ورزش:"، وب‌سوکت.اندازه اتاق(هاب، "sport")
    سرچاپ "به"، وب‌سوکت.پخش(هاب، "news"، "نرخ‌ها بالا رفت")، "نفر در خبر فرستاده شد"
    سرچاپ "به"، وب‌سوکت.پخش(هاب، "sport"، "نیمه‌ی اول ۲ بر ۱")، "نفر در ورزش فرستاده شد"
    سرچاپ "علی:"، وب‌سوکت.دریافت متن(علی)
    سرچاپ "سارا:"، وب‌سوکت.دریافت متن(سارا)
    سرچاپ "رضا:"، وب‌سوکت.دریافت متن(رضا)
    سرچاپ "کسی در شطرنج نیست:"، وب‌سوکت.پخش(هاب، "chess"، "سلام")
    وب‌سوکت.بستن(علی)
    وب‌سوکت.بستن(سارا)
    وب‌سوکت.بستن(رضا)
    وب‌سوکت.بستن سرور(سرور)
پایان
