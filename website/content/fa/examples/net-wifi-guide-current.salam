// زبان: فارسی
واردسازی شبکه.وای‌فای

تابع ریشه:
    س := وای‌فای.وضعیت کنونی()
    ترابرد س.حالت:
        وای‌فای.وضعیت اتصال.وصل:
            اگر س.نام شبکه معلوم:
                سرچاپ "on Wi-Fi"، س.نام شبکه، "security"، وای‌فای.نام امنیت(س.امنیت)
            وگرنه:
                سرچاپ "on Wi-Fi, name not available:"، س.دلیل
            پایان
            بشکن
        پایان
        وای‌فای.وضعیت اتصال.قطع:
            سرچاپ "Wi-Fi is not connected"
            بشکن
        پایان
        وای‌فای.وضعیت اتصال.بدون وای فای:
            سرچاپ "this machine has no Wi-Fi"
            بشکن
        پایان
        وای‌فای.وضعیت اتصال.نامعلوم:
            سرچاپ "cannot tell:"، س.دلیل
            بشکن
        پایان
    پایان
پایان
