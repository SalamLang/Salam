// زبان: فارسی
واردسازی شبکه.وای‌فای

تابع دیکیدی(س: وای‌فای.وضعیت، تروستید: وکتور<رشته>): رشته:
    ترابرد وای‌فای.سنجش اعتماد(س، تروستید):
        وای‌فای.اعتماد.نامطمئن: برگشت "connect the VPN" پایان
        وای‌فای.اعتماد.مورد اعتماد: برگشت "stay as you are" پایان
        وای‌فای.اعتماد.اعتماد نامعلوم: برگشت "ask the user" پایان
        وای‌فای.اعتماد.روی وای فای نیست: برگشت "not on Wi-Fi" پایان
    پایان
    برگشت ""
پایان

تابع ریشه:
    ناپایا تروستید := وکتور {} برگردان وکتور<رشته>
    دیرکن تروستید.آزاد()
    تروستید.افزودن("Home")
    سرچاپ دیکیدی(وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.وصل، نام شبکه = "Home"، نام شبکه معلوم = درست، امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو }، تروستید)
    سرچاپ دیکیدی(وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.وصل، نام شبکه = "Airport"، نام شبکه معلوم = درست، امنیت = وای‌فای.امنیت شبکه.باز }، تروستید)
    سرچاپ دیکیدی(وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.وصل، امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو }، تروستید)
    سرچاپ دیکیدی(وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.وصل، امنیت = وای‌فای.امنیت شبکه.باز }، تروستید)
    سرچاپ دیکیدی(وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.بدون وای فای }، تروستید)
پایان
