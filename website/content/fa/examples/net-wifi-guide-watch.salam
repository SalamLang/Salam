// زبان: فارسی
واردسازی شبکه.وای‌فای
واردسازی همگام سازی

تابع ریشه:
    ناپایا تروستید := وکتور {} برگردان وکتور<رشته>
    دیرکن تروستید.آزاد()
    تروستید.افزودن("Home")
    تروستید.افزودن("Office")
    ناپایا آخر := وای‌فای.وضعیت کنونی()
    سرچاپ "starting on a network that is"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(آخر، تروستید))
    تکرار 10:
        اکنون := وای‌فای.وضعیت کنونی()
        اگر وای‌فای.تغییر کرده(آخر، اکنون):
            اگر وای‌فای.نامطمئن است(اکنون، تروستید):
                سرچاپ "untrusted network, starting the VPN"
            وگرنه:
                سرچاپ "network is"، وای‌فای.نام اعتماد(وای‌فای.سنجش اعتماد(اکنون، تروستید))
            پایان
            وای‌فای.آزادسازی وضعیت(آخر)
            آخر = اکنون
        وگرنه:
            وای‌فای.آزادسازی وضعیت(اکنون)
        پایان
        همگام سازی.خواب میلی ثانیه(3000)
    پایان
    وای‌فای.آزادسازی وضعیت(آخر)
پایان
