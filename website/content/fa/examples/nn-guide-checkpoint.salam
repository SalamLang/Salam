واردسازی شبکه عصبی
واردسازی مشتق‌گیری خودکار
واردسازی تانسور
واردسازی فشرده سازی

تابع ساختن(مخزن &: شبکه عصبی.مخزن پارامتر، دانه: صحیح۶۴): شبکه عصبی.ترتیبی:
    ناپایا مولد := تانسور.مولد تصادفی جدید(دانه)
    ناپایا مدل := شبکه عصبی.ترتیبی {}
    مدل.افزودن(شبکه عصبی.لایه خطی جدید(مخزن، "fc1"، ۳، ۴، مولد))
    مدل.افزودن(شبکه عصبی.لایه گلو {})
    مدل.افزودن(شبکه عصبی.لایه خطی جدید(مخزن، "fc2"، ۴، ۲، مولد))
    برگشت مدل
پایان

تابع اجرا(مدل &: شبکه عصبی.ترتیبی، مخزن &: شبکه عصبی.مخزن پارامتر، ایکس &: تانسور.تانسور): تانسور.تانسور:
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(۱)
    خروجی := تانسور.همانند(مشتق‌گیری خودکار.مقدار(نوار، مدل.پیشرو(نوار، مخزن، مشتق‌گیری خودکار.ورودی(نوار، ایکس))))
    نوار.آزادسازی()
    برگشت خروجی
پایان

تابع ریشه:
    ایکس := تانسور.یک‌ها(تانسور.شکل دو(۱، ۳))
    ناپایا آموزش دیده := شبکه عصبی.مخزن پارامتر {}
    ناپایا اولی := ساختن(آموزش دیده، ۱)
    ناپایا ذخیره := شبکه عصبی.ذخیره نقطه بازرسی در بافر(آموزش دیده)

    ناپایا تازه := شبکه عصبی.مخزن پارامتر {}
    ناپایا دومی := ساختن(تازه، ۹۹)
    سرچاپ "پیش از بارگذاری، خروجی یکی است:"، تانسور.همه نزدیک(اجرا(اولی، آموزش دیده، ایکس)، اجرا(دومی، تازه، ایکس)، ۰.۰۰۰۰۰۱)
    سرچاپ "بارگذاری شد:"، شبکه عصبی.بارگذاری نقطه بازرسی از بافر(ذخیره، تازه)
    سرچاپ "پس از بارگذاری، خروجی یکی است:"، تانسور.همه نزدیک(اجرا(اولی، آموزش دیده، ایکس)، اجرا(دومی، تازه، ایکس)، ۰.۰۰۰۰۰۱)
    سرچاپ "پارامترها:"، تازه.شمار()
    فشرده سازی.آزادسازی بافر(ذخیره)
    آموزش دیده.آزادسازی()
    تازه.آزادسازی()
پایان
