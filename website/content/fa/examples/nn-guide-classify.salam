واردسازی شبکه عصبی
واردسازی مشتق‌گیری خودکار
واردسازی بهینه‌سازی
واردسازی تانسور

تابع ریشه:
    ناپایا مولد := تانسور.مولد تصادفی جدید(۵)
    ناپایا نقطه ها := تانسور.صفرها دو(۶۰، ۲)
    ناپایا برچسب ها := وکتور {} برگردان وکتور<صحیح>
    تکرار ۶۰ در ی:
        دسته := ی % ۳
        برچسب ها.بیفزا(دسته)
        مرکز ایکس := (دسته برگردان اعشار۶۴) * ۲.۰
        مرکز ایگرگ := ((دسته % ۲) برگردان اعشار۶۴) * ۲.۰
        نقطه ها.تنظیم در دو(ی، ۰، مرکز ایکس + مولد.نرمال بعدی() * ۰.۳)
        نقطه ها.تنظیم در دو(ی، ۱، مرکز ایگرگ + مولد.نرمال بعدی() * ۰.۳)
    پایان
    ناپایا مخزن := شبکه عصبی.مخزن پارامتر {}
    ناپایا مدل := شبکه عصبی.ترتیبی {}
    مدل.افزودن(شبکه عصبی.لایه خطی جدید(مخزن، "fc1"، ۲، ۱۶، مولد))
    مدل.افزودن(شبکه عصبی.لایه یکسوساز {})
    مدل.افزودن(شبکه عصبی.لایه خطی جدید(مخزن، "fc2"، ۱۶، ۳، مولد))
    ناپایا آدام := بهینه‌سازی.آدام { lr = ۰.۰۵ }
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(۱)
    تکرار ۲۰۰:
        نوار.بازنشانی()
        مخزن.صفر کردن گرادیان()
        لوجیت ها := مدل.پیشرو(نوار، مخزن، مشتق‌گیری خودکار.ورودی(نوار، نقطه ها))
        زیان := مشتق‌گیری خودکار.آنتروپی متقاطع لوجیت(نوار، لوجیت ها، برچسب ها)
        مشتق‌گیری خودکار.پس‌انتشار(نوار، زیان)
        آدام.گام(مخزن)
    پایان
    نوار.بازنشانی()
    حدس ها := تانسور.نمایه بیشینه محور(مشتق‌گیری خودکار.مقدار(نوار، مدل.پیشرو(نوار، مخزن، مشتق‌گیری خودکار.ورودی(نوار، نقطه ها)))، ۱، نادرست)
    ناپایا امتیاز := ۰
    تکرار ۶۰ در ی:
        اگر حدس ها.عنصر(ی) برگردان صحیح == برچسب ها.بگیر(ی):
            امتیاز += ۱
        پایان
    پایان
    سرچاپ "درست:"، امتیاز، "از ۶۰"
    نوار.آزادسازی()
    آدام.آزادسازی()
    مخزن.آزادسازی()
پایان
