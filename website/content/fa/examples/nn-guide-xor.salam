واردسازی شبکه عصبی
واردسازی مشتق‌گیری خودکار
واردسازی بهینه‌سازی
واردسازی تانسور

تابع جدول(مقدارها: اعشار۶۴[]، سطرها: صحیح، ستون‌ها: صحیح): تانسور.تانسور:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۳۲>
    هر م در مقدارها:
        داده.بیفزا(م برگردان اعشار۳۲)
    پایان
    شکل := تانسور.شکل دو(سطرها، ستون‌ها)
    برگشت تانسور.از آرایه(شکل، داده)
پایان

تابع ریشه:
    ورودی‌ها := جدول([۰.۰، ۰.۰، ۰.۰، ۱.۰، ۱.۰، ۰.۰، ۱.۰، ۱.۰]، ۴، ۲)
    برچسب ها := جدول([۰.۰، ۱.۰، ۱.۰، ۰.۰]، ۴، ۱)
    ناپایا مخزن := شبکه عصبی.مخزن پارامتر {}
    ناپایا مولد := تانسور.مولد تصادفی جدید(۷)
    ناپایا مدل := شبکه عصبی.ترتیبی {}
    مدل.افزودن(شبکه عصبی.لایه خطی جدید(مخزن، "hidden"، ۲، ۸، مولد))
    مدل.افزودن(شبکه عصبی.لایه تانژانت هذلولی {})
    مدل.افزودن(شبکه عصبی.لایه خطی جدید(مخزن، "out"، ۸، ۱، مولد))
    ناپایا آدام := بهینه‌سازی.آدام { lr = ۰.۰۵ }
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(۱)
    ناپایا مقدار زیان := ۰.۰
    تکرار ۵۰۰:
        نوار.بازنشانی()
        مخزن.صفر کردن گرادیان()
        لوجیت ها := مدل.پیشرو(نوار، مخزن، مشتق‌گیری خودکار.ورودی(نوار، ورودی‌ها))
        زیان := مشتق‌گیری خودکار.آنتروپی دودویی لوجیت(نوار، لوجیت ها، مشتق‌گیری خودکار.ثابت(نوار، برچسب ها))
        مشتق‌گیری خودکار.پس‌انتشار(نوار، زیان)
        آدام.گام(مخزن)
        مقدار زیان = مشتق‌گیری خودکار.مقدار(نوار، زیان).عنصر(۰)
    پایان
    سرچاپ "زیان کمتر از ۰.۰۵:"، مقدار زیان < ۰.۰۵
    نوار.بازنشانی()
    احتمال ها := تانسور.سیگموئید(مشتق‌گیری خودکار.مقدار(نوار، مدل.پیشرو(نوار، مخزن، مشتق‌گیری خودکار.ورودی(نوار، ورودی‌ها))))
    تکرار ۴ در ی:
        سرچاپ ورودی‌ها.در دو(ی، ۰)، "xor"، ورودی‌ها.در دو(ی، ۱)، "="، (احتمال ها.عنصر(ی) + ۰.۵) برگردان صحیح
    پایان
    نوار.آزادسازی()
    آدام.آزادسازی()
    مخزن.آزادسازی()
پایان
