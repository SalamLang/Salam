واردسازی نود

تابع ریشه:
    متن := `{"name": "shop", "port": 8080, "debug": true, "db": {"host": "127.0.0.1"}}`
    پیکربندی := نود.فراخوان رشته یک(نود.سراسری("JSON")، "parse"، متن)
    سرچاپ "نام:"، نود.دریافت خاصیت رشته ای(پیکربندی، "name")
    سرچاپ "درگاه:"، نود.دریافت خاصیت عددی(پیکربندی، "port")
    سرچاپ "اشکال‌زدایی:"، نود.دریافت خاصیت منطقی(پیکربندی، "debug")
    پایگاه := نود.دریافت خاصیت(پیکربندی، "db")
    سرچاپ "میزبان پایگاه داده:"، نود.دریافت خاصیت رشته ای(پایگاه، "host")
    ناپایا کارگرها := ۴.۰
    اگر وارونه نود.بی‌مقدار است(نود.دریافت خاصیت(پیکربندی، "workers")):
        کارگرها = نود.دریافت خاصیت عددی(پیکربندی، "workers")
    پایان
    سرچاپ "کارگرها:"، کارگرها
    نود.تنظیم خاصیت عددی(پیکربندی، "workers"، کارگرها)
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با یک مقدار(نود.سراسری("JSON")، "stringify"، پیکربندی))
پایان
