واردسازی نود
واردسازی رشته

تابع ریشه:
    پوشه := نود.ساخت پوشه موقت(نود.پیوستن مسیر(نود.پوشه موقت()، "salam-notes-"))
    نود.نوشتن فایل(نود.پیوستن مسیر(پوشه، "a.txt")، "یک\nدو\nسه\n")
    نود.نوشتن فایل(نود.پیوستن مسیر(پوشه، "b.txt")، "تنها خط\n")
    نود.نوشتن فایل(نود.پیوستن مسیر(پوشه، "c.md")، "# عنوان\n")
    fs := نود.واردکردن("fs")
    نام‌ها := نود.فراخوان رشته یک(fs، "readdirSync"، پوشه)
    _ := نود.فراخوان(نام‌ها، "sort")
    ناپایا جمع := ۰
    تکرار نود.دریافت خاصیت عددی(نام‌ها، "length") برگردان صحیح در ی:
        نام := نود.دریافت خاصیت رشته ای(نام‌ها، رشته.از عدد(ی))
        اگر وارونه رشته.پایان با(نام، ".txt"):
            گذر
        پایان
        متن := نود.خواندن فایل(نود.پیوستن مسیر(پوشه، نام))
        خط‌ها := رشته.شمارش(متن، "\n")
        جمع += خط‌ها
        سرچاپ نام، خط‌ها
    پایان
    سرچاپ "جمع"، جمع
    نود.حذف بازگشتی(پوشه)
پایان
