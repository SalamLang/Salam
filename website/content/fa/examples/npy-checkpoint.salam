واردسازی ان‌پی‌وای
واردسازی ماتریس

تابع سطر(الف: اعشار۶۴، ب: اعشار۶۴): ماتریس.ماتریس:
    ناپایا م := ماتریس.صفرها(۱، ۲)
    م.تنظیم(۰، ۰، الف)
    م.تنظیم(۰، ۱، ب)
    برگشت م
پایان

تابع بارگذاری(مسیر: رشته، کلید: رشته، خوب &: منطقی): ماتریس.ماتریس:
    ناپایا آرایه := ان‌پی‌وای.خواندن ان‌پی‌زد(مسیر، کلید، خوب)
    ناپایا م := ماتریس.ماتریس {}
    اگر خوب: م = ان‌پی‌وای.به ماتریس(آرایه، خوب) پایان
    آرایه.آزادسازی()
    برگشت م
پایان

تابع ریشه:
    ناپایا وزن := ماتریس.صفرها(۲، ۲)
    وزن.تنظیم(۰، ۰، ۰.۵)
    وزن.تنظیم(۰، ۱، -۱.۰)
    وزن.تنظیم(۱، ۰، ۲.۰)
    وزن.تنظیم(۱، ۱، ۰.۲۵)
    ناپایا سوگیری := سطر(۱.۰، ۰.۰)
    ناپایا کلیدها := وکتور {} برگردان وکتور<رشته>
    کلیدها.بیفزا("W")
    کلیدها.بیفزا("b")
    ناپایا آرایه‌ها := وکتور {} برگردان وکتور<ان‌پی‌وای.آرایه ان‌پی‌وای>
    آرایه‌ها.بیفزا(ان‌پی‌وای.از ماتریس(وزن))
    آرایه‌ها.بیفزا(ان‌پی‌وای.از ماتریس(سوگیری))
    سرچاپ "ذخیره شد:"، ان‌پی‌وای.نوشتن ان‌پی‌زد("model.npz"، کلیدها، آرایه‌ها)
    ناپایا خوب := نادرست
    سرچاپ "آرایه‌های پرونده:"، ان‌پی‌وای.فهرست ان‌پی‌زد("model.npz"، خوب)
    ناپایا وزن خوانده := بارگذاری("model.npz"، "W"، خوب)
    ناپایا سوگیری خوانده := بارگذاری("model.npz"، "b"، خوب)
    ناپایا نمونه := سطر(۳.۰، ۴.۰)
    ناپایا حاصل‌ضرب := ماتریس.ضرب ماتریسی(نمونه، وزن خوانده)
    ناپایا پیش‌بینی := ماتریس.جمع بردار سطری(حاصل‌ضرب، سوگیری خوانده)
    سرچاپ "پیش‌بینی:"، پیش‌بینی.عنصر(۰، ۰)، پیش‌بینی.عنصر(۰، ۱)
    _ := بارگذاری("model.npz"، "gamma"، خوب)
    سرچاپ "gamma پیدا شد:"، خوب
    تکرار آرایه‌ها.طول() در ی:
        ناپایا آ := آرایه‌ها.بگیر(ی)
        آ.آزادسازی()
    پایان
    ماتریس.آزادسازی(وزن)
    ماتریس.آزادسازی(سوگیری)
    ماتریس.آزادسازی(وزن خوانده)
    ماتریس.آزادسازی(سوگیری خوانده)
    ماتریس.آزادسازی(نمونه)
    ماتریس.آزادسازی(حاصل‌ضرب)
    ماتریس.آزادسازی(پیش‌بینی)
    برگشت ۰
پایان
