واردسازی ان‌پی‌وای
واردسازی فشرده سازی
واردسازی ورودی خروجی

تابع آزمودن خواندن(مسیر: رشته):
    تلاش:
        ناپایا آ := ان‌پی‌وای.خواندن پرونده ان‌پی‌وای(مسیر)
        سرچاپ مسیر، "->"، آ.شکل
        آ.آزادسازی()
    گرفتن خطا خ:
        سرچاپ مسیر، "->"، خ.نام نوع()، "|"، خ.به رشته()
    پایان
پایان

تابع ریشه:
    ناپایا سالم := ان‌پی‌وای.آرایه ان‌پی‌وای {}
    سالم.شکل.بیفزا(۲)
    سالم.شکل.بیفزا(۲)
    تکرار ۴ در ی: سالم.عنصرها.بیفزا(ی برگردان اعشار۶۴) پایان
    ان‌پی‌وای.نوشتن پرونده ان‌پی‌وای(سالم، "good.npy")
    ورودی خروجی.نوشتن پرونده("notes.npy"، "این فقط یک متن ساده است")
    ناپایا بافر := ان‌پی‌وای.نوشتن ان‌پی‌وای(سالم)
    ناپایا نیمه := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(نیمه، بافر.داده، فشرده سازی.طول بافر(بافر) - ۸)
    تلاش:
        ان‌پی‌وای.خواندن ان‌پی‌وای(نیمه.داده، فشرده سازی.طول بافر(نیمه))
    گرفتن خطا خ:
        سرچاپ "بریده ->"، خ.به رشته()، خ.کد
    پایان
    آزمودن خواندن("good.npy")
    آزمودن خواندن("notes.npy")
    آزمودن خواندن("missing.npy")
    تلاش:
        ان‌پی‌وای.فهرست ان‌پی‌زد("missing.npz")
    گرفتن خطا خ:
        سرچاپ "missing.npz ->"، خ.است(نوع خطا.یافت نشد)، خ.مسیر
    پایان
    فشرده سازی.آزادسازی بافر(نیمه)
    فشرده سازی.آزادسازی بافر(بافر)
    سالم.آزادسازی()
    برگشت ۰
پایان
