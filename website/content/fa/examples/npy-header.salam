واردسازی ان‌پی‌وای
واردسازی فشرده سازی
واردسازی رشته

تابع ریشه:
    ناپایا آرایه := ان‌پی‌وای.آرایه ان‌پی‌وای {}
    آرایه.shape.بیفزا(۳)
    تکرار ۳ در ی: آرایه.data.بیفزا((ی + ۱) برگردان اعشار۶۴) پایان
    ناپایا بافر := ان‌پی‌وای.نوشتن ان‌پی‌وای(آرایه)
    سرچاپ "اندازه‌ی پرونده:"، فشرده سازی.طول بافر(بافر)، "بایت"
    سرچاپ "بایت جادویی:"، فشرده سازی.دریافت بایت(بافر، ۰)
    طول سرآیند := فشرده سازی.دریافت بایت(بافر، ۸) + ۲۵۶ * فشرده سازی.دریافت بایت(بافر، ۹)
    سرچاپ "نسخه:"، فشرده سازی.دریافت بایت(بافر، ۶)، "طول سرآیند:"، طول سرآیند
    ناپایا سازنده := رشته.سازنده()
    تکرار طول سرآیند در ی:
        رشته.افزودن نویسه به بافر(سازنده، فشرده سازی.دریافت بایت(بافر، ۱۰ + ی))
    پایان
    متن := رشته.رشته بافر(سازنده)
    سرچاپ "سرآیند:"، رشته.پیرایش راست(متن)
    سرچاپ "بایت‌های داده:"، فشرده سازی.طول بافر(بافر) - ۱۰ - طول سرآیند
    ناپایا خوب := نادرست
    ناپایا خوانده := ان‌پی‌وای.خواندن ان‌پی‌وای(بافر.data، فشرده سازی.طول بافر(بافر)، خوب)
    سرچاپ خوب، خوانده.shape، خوانده.data، خوانده.dtype برابر ان‌پی‌وای.نوع اعشاری هشت
    رشته.آزادسازی بافر(سازنده)
    فشرده سازی.آزادسازی بافر(بافر)
    خوانده.آزادسازی()
    آرایه.آزادسازی()
    برگشت ۰
پایان
