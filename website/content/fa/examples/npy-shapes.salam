واردسازی ان‌پی‌وای
واردسازی ماتریس

تابع خانه(آ: ان‌پی‌وای.آرایه ان‌پی‌وای، ی: صحیح، ج: صحیح، ک: صحیح): اعشار۶۴:
    سطرها := آ.شکل.بگیر(۱)
    ستون‌ها := آ.شکل.بگیر(۲)
    برگشت آ.عنصرها.بگیر((ی * سطرها + ج) * ستون‌ها + ک)
پایان

تابع ریشه(): صحیح خطادار:
    ناپایا مکعب := ان‌پی‌وای.آرایه ان‌پی‌وای {}
    مکعب.شکل.بیفزا(۲)
    مکعب.شکل.بیفزا(۳)
    مکعب.شکل.بیفزا(۴)
    تکرار ۲۴ در ن: مکعب.عنصرها.بیفزا(ن برگردان اعشار۶۴) پایان
    سرچاپ "شمار بعد:"، مکعب.شمار بعد()، "شمار:"، مکعب.شمار()
    سرچاپ "مکعب[1][2][3] ="، خانه(مکعب، ۱، ۲، ۳)
    تلاش:
        ان‌پی‌وای.به ماتریس(مکعب)
    گرفتن خطا خ:
        سرچاپ "سه‌بعدی به ماتریس:"، خ.به رشته()
    پایان
    ان‌پی‌وای.نوشتن پرونده ان‌پی‌وای(مکعب، "cube.npy")
    ناپایا خوانده := تلاش ان‌پی‌وای.خواندن پرونده ان‌پی‌وای("cube.npy")
    سرچاپ "خوانده شد:"، خوانده.شکل، خانه(خوانده، ۱، ۲، ۳)
    ناپایا خط := ان‌پی‌وای.آرایه ان‌پی‌وای {}
    خط.شکل.بیفزا(۴)
    تکرار ۴ در ن: خط.عنصرها.بیفزا((ن * ن) برگردان اعشار۶۴) پایان
    ناپایا م := تلاش ان‌پی‌وای.به ماتریس(خط)
    سرچاپ "یک‌بعدی به ماتریس:"، م.سطرها، "در"، م.ستون‌ها، م.عنصر(۰، ۳)
    ماتریس.آزادسازی(م)
    خط.آزادسازی()
    خوانده.آزادسازی()
    مکعب.آزادسازی()
    برگشت ۰
پایان
