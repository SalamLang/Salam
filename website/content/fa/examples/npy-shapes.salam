واردسازی ان‌پی‌وای
واردسازی ماتریس

تابع خانه(آ: ان‌پی‌وای.آرایه ان‌پی‌وای، ی: صحیح، ج: صحیح، ک: صحیح): اعشار۶۴:
    سطرها := آ.شکل.بگیر(۱)
    ستون‌ها := آ.شکل.بگیر(۲)
    برگشت آ.عنصرها.بگیر((ی * سطرها + ج) * ستون‌ها + ک)
پایان

تابع ریشه:
    ناپایا مکعب := ان‌پی‌وای.آرایه ان‌پی‌وای {}
    مکعب.شکل.بیفزا(۲)
    مکعب.شکل.بیفزا(۳)
    مکعب.شکل.بیفزا(۴)
    تکرار ۲۴ در ن: مکعب.عنصرها.بیفزا(ن برگردان اعشار۶۴) پایان
    سرچاپ "شمار بعد:"، مکعب.شمار بعد()، "شمار:"، مکعب.شمار()
    سرچاپ "مکعب[1][2][3] ="، خانه(مکعب، ۱، ۲، ۳)
    ناپایا خوب := درست
    _ := ان‌پی‌وای.به ماتریس(مکعب، خوب)
    سرچاپ "سه‌بعدی به ماتریس:"، خوب
    ان‌پی‌وای.نوشتن پرونده ان‌پی‌وای(مکعب، "cube.npy")
    ناپایا خوانده := ان‌پی‌وای.خواندن پرونده ان‌پی‌وای("cube.npy"، خوب)
    سرچاپ "خوانده شد:"، خوب، خوانده.شکل، خانه(خوانده، ۱، ۲، ۳)
    ناپایا خط := ان‌پی‌وای.آرایه ان‌پی‌وای {}
    خط.شکل.بیفزا(۴)
    تکرار ۴ در ن: خط.عنصرها.بیفزا((ن * ن) برگردان اعشار۶۴) پایان
    ناپایا م := ان‌پی‌وای.به ماتریس(خط، خوب)
    سرچاپ "یک‌بعدی به ماتریس:"، خوب، م.سطرها، "در"، م.ستون‌ها، م.عنصر(۰، ۳)
    ماتریس.آزادسازی(م)
    خط.آزادسازی()
    خوانده.آزادسازی()
    مکعب.آزادسازی()
    برگشت ۰
پایان
