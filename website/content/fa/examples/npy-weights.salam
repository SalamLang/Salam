واردسازی ان‌پی‌وای
واردسازی ماتریس

تابع ریشه(): صحیح خطادار:
    ناپایا وزن := ماتریس.صفرها(۲، ۳)
    تکرار ۲ در ی:
        تکرار ۳ در ج:
            وزن.تنظیم(ی، ج، (ی * ۱۰ + ج) برگردان اعشار۶۴ / ۴.۰)
        پایان
    پایان
    ناپایا آرایه := ان‌پی‌وای.از ماتریس(وزن)
    اگر ان‌پی‌وای.نوشتن پرونده ان‌پی‌وای(آرایه، "weights.npy") برابر نادرست:
        سرچاپ "نوشتن weights.npy ممکن نشد"
        برگشت ۱
    پایان
    ناپایا خوانده := تلاش ان‌پی‌وای.خواندن پرونده ان‌پی‌وای("weights.npy")
    سرچاپ "شکل:"، خوانده.شکل، "عنصرها:"، خوانده.شمار()
    ناپایا م := تلاش ان‌پی‌وای.به ماتریس(خوانده)
    تکرار م.سطرها در ی:
        سرچاپ م.عنصر(ی، ۰)، م.عنصر(ی، ۱)، م.عنصر(ی، ۲)
    پایان
    سرچاپ "مقدارها یکسان‌اند:"، ماتریس.مجموع(م) برابر ماتریس.مجموع(وزن)
    ماتریس.آزادسازی(م)
    ماتریس.آزادسازی(وزن)
    خوانده.آزادسازی()
    آرایه.آزادسازی()
    برگشت ۰
پایان
