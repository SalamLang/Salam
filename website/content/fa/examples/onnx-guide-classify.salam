واردسازی اونیکس
واردسازی تانسور

تابع ریشه:
    ناپایا موفق := نادرست
    ناپایا مدل := اونیکس.بارگذاری اونیکس("iris.onnx"، موفق)
    اگر وارونه موفق:
        سرچاپ "iris.onnx خوانده نشد:"، مدل.خطا
        برگشت ۱
    پایان
    نام دسته ها := ["setosa"، "versicolor"، "virginica"]
    ناپایا ویژگی ها := وکتور {} برگردان وکتور<اعشار۳۲>
    هر م در [۵.۱، ۳.۵، ۱.۴، ۰.۲، ۶.۷، ۳.۰، ۵.۲، ۲.۳]:
        ویژگی ها.بیفزا(م برگردان اعشار۳۲)
    پایان
    شکل := تانسور.شکل دو(۲، ۴)
    ناپایا خوراک ها := وکتور {} برگردان وکتور<تانسور.تانسور>
    خوراک ها.بیفزا(تانسور.از آرایه(شکل، ویژگی ها))
    خروجی ها := اونیکس.اجرا(مدل، خوراک ها، موفق)
    اگر وارونه موفق:
        سرچاپ "مدل اجرا نشد:"، مدل.خطا
        برگشت ۱
    پایان
    احتمال ها := تانسور.بیشینه نرم(خروجی ها.بگیر(۰))
    بهترین := تانسور.نمایه بیشینه محور(احتمال ها، ۱، نادرست)
    تکرار ۲ در ی:
        سرچاپ "گل"، ی، "از گونه‌ی"، نام دسته ها[بهترین.عنصر(ی) برگردان صحیح] + " است"
    پایان
    مدل.آزادسازی()
پایان
