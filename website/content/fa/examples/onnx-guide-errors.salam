واردسازی اونیکس
واردسازی تانسور
واردسازی فشرده سازی
واردسازی کدگذاری.پروتوباف

تابع متن(ب &: فشرده سازی.بافر بایت، شماره: صحیح، مقدار: رشته):
    پروتوباف.نوشتن برچسب(ب، شماره، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن رشته طول‌دار(ب، مقدار)
پایان

تابع زیرپیام(ب &: فشرده سازی.بافر بایت، شماره: صحیح، پیام: فشرده سازی.بافر بایت):
    پروتوباف.نوشتن برچسب(ب، شماره، پروتوباف.نوع سیم طول‌دار)
    پروتوباف.نوشتن بایت‌های طول‌دار(ب، پیام.داده، فشرده سازی.طول بافر(پیام))
پایان

تابع مدل یکسوساز(): فشرده سازی.بافر بایت:
    ناپایا گره := فشرده سازی.بافر بایت جدید()
    متن(گره، ۱، "x")
    متن(گره، ۲، "y")
    متن(گره، ۴، "Relu")
    ناپایا خوراک ایکس := فشرده سازی.بافر بایت جدید()
    متن(خوراک ایکس، ۱، "x")
    ناپایا خروجی ایگرگ := فشرده سازی.بافر بایت جدید()
    متن(خروجی ایگرگ، ۱، "y")
    ناپایا گراف := فشرده سازی.بافر بایت جدید()
    زیرپیام(گراف، ۱، گره)
    زیرپیام(گراف، ۱۱، خوراک ایکس)
    زیرپیام(گراف، ۱۲، خروجی ایگرگ)
    ناپایا م := فشرده سازی.بافر بایت جدید()
    پروتوباف.نوشتن برچسب(م، ۱، پروتوباف.نوع سیم متغیر)
    پروتوباف.نوشتن عدد متغیر(م، ۸ برگردان طبیعی۶۴)
    زیرپیام(م، ۷، گراف)
    برگشت م
پایان

تابع ریشه:
    ناپایا موفق := نادرست
    آشغال := "this is not a model"
    _ := اونیکس.تجزیه اونیکس(آشغال برگردان تهی*، آشغال.طول()، موفق)
    سرچاپ "متن بی‌ربط خوانده شد:"، موفق

    ناپایا بایت ها := مدل یکسوساز()
    ناپایا مدل := اونیکس.تجزیه اونیکس(بایت ها.داده، فشرده سازی.طول بافر(بایت ها)، موفق)
    سرچاپ "مدل خوانده شد:"، موفق، "ورودی‌ها:"، مدل.نام ورودی‌ها().طول()

    ناپایا هیچ := وکتور {} برگردان وکتور<تانسور.تانسور>
    _ := اونیکس.اجرا(مدل، هیچ، موفق)
    سرچاپ "اجرا بدون ورودی:"، موفق، "|"، مدل.خطا

    ناپایا خوراک ها := وکتور {} برگردان وکتور<تانسور.تانسور>
    خوراک ها.بیفزا(تانسور.بازه گام(۴) - تانسور.پرشده(تانسور.شکل یک(۴)، ۲.۰))
    نتیجه ها := اونیکس.اجرا(مدل، خوراک ها، موفق)
    سرچاپ "اجرا با x:"، موفق، تانسور.به رشته(نتیجه ها.بگیر(۰))
    مدل.آزادسازی()
    فشرده سازی.آزادسازی بافر(بایت ها)
پایان
