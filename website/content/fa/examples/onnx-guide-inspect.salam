واردسازی اونیکس
واردسازی سیستم عامل

تابع ریشه:
    آرگ ها := سیستم عامل.آرگومان ها()
    اگر آرگ ها.طول() < ۲:
        سرچاپ "روش کاربرد: onnx-guide-inspect model.onnx"
        برگشت ۱
    پایان
    ناپایا موفق := نادرست
    ناپایا مدل := اونیکس.بارگذاری اونیکس(آرگ ها.بگیر(۱)، موفق)
    اگر وارونه موفق:
        سرچاپ "مدل خوانده نشد:"، مدل.error
        برگشت ۱
    پایان
    سرچاپ "نسخه‌ی IR"، مدل.ir_version
    سرچاپ "ورودی‌ها"، مدل.نام ورودی‌ها()، "خروجی‌ها"، مدل.outputs
    ناپایا شمار := نگاشت {} برگردان نگاشت<رشته، صحیح>
    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    هر گره در مدل.nodes:
        اگر شمار.دارد(گره.op):
            شمار.درج(گره.op، شمار.بگیر(گره.op) + ۱)
        وگرنه:
            شمار.درج(گره.op، ۱)
            ترتیب.بیفزا(گره.op)
        پایان
    پایان
    هر نام در ترتیب:
        سرچاپ "  " + نام، شمار.بگیر(نام)
    پایان
    ناپایا وزن ها := ۰
    هر ت در مدل.inits:
        وزن ها += ت.شمار درایه‌ها()
    پایان
    سرچاپ مدل.inits.طول()، "تانسور وزن،"، وزن ها، "عدد"
    مدل.آزادسازی()
پایان
