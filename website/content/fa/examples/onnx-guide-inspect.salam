واردسازی اونیکس
واردسازی سیستم عامل

تابع ریشه:
    آرگ ها := سیستم عامل.آرگومان ها()
    اگر آرگ ها.طول() < ۲:
        سرچاپ "روش کاربرد: onnx-guide-inspect model.onnx"
        برگشت ۱
    پایان
    ناپایا موفق := نادرست
    ناپایا مدل := اونیکس.بارگذاری اونیکس(آرگ ها.بگیر(۱)، موفق)
    اگر وارونه موفق:
        سرچاپ "مدل خوانده نشد:"، مدل.خطا
        برگشت ۱
    پایان
    سرچاپ "نسخه‌ی IR"، مدل.نسخه آی آر
    سرچاپ "ورودی‌ها"، مدل.نام ورودی‌ها()، "خروجی‌ها"، مدل.خروجی‌ها
    ناپایا شمار := نگاشت {} برگردان نگاشت<رشته، صحیح>
    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    هر گره در مدل.گره‌ها:
        اگر شمار.دارد(گره.عملگر):
            شمار.درج(گره.عملگر، شمار.بگیر(گره.عملگر) + ۱)
        وگرنه:
            شمار.درج(گره.عملگر، ۱)
            ترتیب.بیفزا(گره.عملگر)
        پایان
    پایان
    هر نام در ترتیب:
        سرچاپ "  " + نام، شمار.بگیر(نام)
    پایان
    ناپایا وزن ها := ۰
    هر ت در مدل.وزن‌های ثابت:
        وزن ها += ت.شمار درایه‌ها()
    پایان
    سرچاپ مدل.وزن‌های ثابت.طول()، "تانسور وزن،"، وزن ها، "عدد"
    مدل.آزادسازی()
پایان
