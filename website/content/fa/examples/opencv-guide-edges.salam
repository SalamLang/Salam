واردسازی اپن‌سی‌وی

تابع پیکسل‌های سفید(تصویر: اپن‌سی‌وی.ماتریس): صحیح:
    نمودار := تصویر.هیستوگرام خاکستری()
    برگشت نمودار.بگیر(۲۵۵)
پایان

تابع ریشه:
    اگر وارونه اپن‌سی‌وی.در دسترس():
        سرچاپ "اپن‌سی‌وی در دسترس نیست:"، اپن‌سی‌وی.آخرین خطا()
        برگشت ۱
    پایان
    ناپایا عکس := اپن‌سی‌وی.خواندن("photo.jpg")
    اگر وارونه عکس.معتبر() یا عکس.خالی():
        سرچاپ "photo.jpg پیدا نشد، یک تصویر آزمایشی کشیده می‌شود"
        عکس = اپن‌سی‌وی.بوم خالی(۳۲۰، ۲۴۰، ۳، اپن‌سی‌وی.آر‌جی‌بی(۲۰۰، ۲۰۰، ۲۰۰))
        عکس.دایره(۱۶۰، ۱۲۰، ۷۰، اپن‌سی‌وی.آر‌جی‌بی(۴۰، ۴۰، ۴۰)، -۱)
    پایان
    دیرکن عکس.آزادسازی()
    سرچاپ "اندازه:"، عکس.عرض()، "x"، عکس.ارتفاع()، "کانال‌ها:"، عکس.کانال‌ها()

    ناپایا خاکستری := عکس.به خاکستری()
    ناپایا نرم := خاکستری.تاری گاوسی(۵، ۱.۴)
    ناپایا لبه‌ها := نرم.لبه‌یابی کنی(۵۰.۰، ۱۵۰.۰)
    ناپایا ضخیم := لبه‌ها.اتساع(۳، ۱)
    دیرکن خاکستری.آزادسازی()
    دیرکن نرم.آزادسازی()
    دیرکن لبه‌ها.آزادسازی()
    دیرکن ضخیم.آزادسازی()
    سرچاپ "پیکسل‌های لبه:"، پیکسل‌های سفید(لبه‌ها)، "پس از اتساع:"، پیکسل‌های سفید(ضخیم)
    سرچاپ "ذخیره شد:"، اپن‌سی‌وی.نوشتن("edges.png"، ضخیم)
پایان
