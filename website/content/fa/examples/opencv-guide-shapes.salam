واردسازی اپن‌سی‌وی

تابع ریشه:
    اگر وارونه اپن‌سی‌وی.در دسترس():
        سرچاپ "اپن‌سی‌وی در دسترس نیست:"، اپن‌سی‌وی.آخرین خطا()
        برگشت ۱
    پایان
    ناپایا تخته := اپن‌سی‌وی.بوم خالی(۴۰۰، ۳۰۰، ۳، اپن‌سی‌وی.سفید())
    دیرکن تخته.آزادسازی()
    تخته.مستطیل(۴۰، ۴۰، ۱۲۰، ۸۰، اپن‌سی‌وی.سیاه()، -۱)
    تخته.دایره(۲۸۰، ۹۰، ۵۰، اپن‌سی‌وی.سیاه()، -۱)
    تخته.مستطیل(۱۵۰، ۱۹۰، ۲۰۰، ۷۰، اپن‌سی‌وی.سیاه()، -۱)

    ناپایا خاکستری := تخته.به خاکستری()
    ناپایا ماسک := خاکستری.آستانه‌گذاری(۱۲۸.۰، ۲۵۵.۰، اپن‌سی‌وی.آستانه دودویی معکوس)
    ناپایا یافته‌ها := ماسک.یافتن پیرامون‌ها()
    دیرکن خاکستری.آزادسازی()
    دیرکن ماسک.آزادسازی()
    دیرکن یافته‌ها.آزادسازی()
    سرچاپ "شکل‌های پیداشده:"، یافته‌ها.تعداد()
    تکرار یافته‌ها.تعداد() در ی:
        قاب := یافته‌ها.مستطیل محاط(ی)
        سرچاپ "  شکل در"، قاب.افقی، قاب.عمودی، "اندازه"، قاب.عرض، "x"، قاب.ارتفاع، "مساحت"، یافته‌ها.مساحت(ی) برگردان صحیح
        تخته.مستطیل(قاب.افقی - ۳، قاب.عمودی - ۳، قاب.عرض + ۶، قاب.ارتفاع + ۶، اپن‌سی‌وی.قرمز()، ۲)
    پایان
    سرچاپ "ذخیره شد:"، تخته.ذخیره("shapes.png")
پایان
