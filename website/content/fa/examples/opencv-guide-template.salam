واردسازی اپن‌سی‌وی

تابع ریشه:
    اگر وارونه اپن‌سی‌وی.در دسترس():
        سرچاپ "اپن‌سی‌وی در دسترس نیست:"، اپن‌سی‌وی.آخرین خطا()
        برگشت ۱
    پایان
    ناپایا صفحه‌نما := اپن‌سی‌وی.بوم خالی(۶۴۰، ۴۸۰، ۳، اپن‌سی‌وی.آر‌جی‌بی(۲۳۰، ۲۳۰، ۲۳۰))
    دیرکن صفحه‌نما.آزادسازی()
    صفحه‌نما.مستطیل(۴۲۰، ۳۰۰، ۹۰، ۴۰، اپن‌سی‌وی.آر‌جی‌بی(۳۰، ۱۲۰، ۲۲۰)، -۱)
    صفحه‌نما.نوشتن متن("OK"، ۴۴۵، ۳۳۰، ۰.۹، اپن‌سی‌وی.سفید()، ۲)
    صفحه‌نما.مستطیل(۱۰۰، ۱۰۰، ۲۰۰، ۶۰، اپن‌سی‌وی.آر‌جی‌بی(۱۲۰، ۱۲۰، ۱۲۰)، -۱)

    ناپایا دکمه := صفحه‌نما.برش(۴۲۰، ۳۰۰، ۹۰، ۴۰)
    دیرکن دکمه.آزادسازی()
    یافته := صفحه‌نما.یافتن الگو(دکمه)
    اگر یافته.found:
        سرچاپ "دکمه در"، یافته.x، یافته.y، "امتیاز بالای ۰.۹۹:"، یافته.score بزرگتر ۰.۹۹
        صفحه‌نما.مستطیل(یافته.x، یافته.y، ۹۰، ۴۰، اپن‌سی‌وی.قرمز()، ۲)
    وگرنه:
        سرچاپ "دکمه روی صفحه نیست"
    پایان
    سرچاپ "ذخیره شد:"، صفحه‌نما.ذخیره("found.png")
پایان
