واردسازی اپن‌سی‌وی

تابع ریشه:
    اگر وارونه اپن‌سی‌وی.در دسترس():
        سرچاپ "اپن‌سی‌وی در دسترس نیست:"، اپن‌سی‌وی.آخرین خطا()
        برگشت ۱
    پایان
    ناپایا نویسنده := اپن‌سی‌وی.نویسنده ویدیو جدید("ball.avi"، "MJPG"، ۱۰.۰، ۱۶۰، ۱۲۰)
    اگر وارونه نویسنده.معتبر():
        سرچاپ "این نسخه‌ی اپن‌سی‌وی نمی‌تواند ویدیوی MJPG بنویسد"
        برگشت ۱
    پایان
    تکرار ۲۰ در ی:
        ناپایا قاب := اپن‌سی‌وی.بوم خالی(۱۶۰، ۱۲۰، ۳، اپن‌سی‌وی.سیاه())
        قاب.دایره(۱۰ + ی * ۷، ۶۰، ۸، اپن‌سی‌وی.سبز()، -۱)
        نویسنده.نوشتن(قاب)
        قاب.آزادسازی()
    پایان
    نویسنده.بستن()

    ناپایا ویدیو := اپن‌سی‌وی.بازکردن ویدیو("ball.avi")
    اگر وارونه ویدیو.معتبر():
        سرچاپ "ball.avi باز نشد"
        برگشت ۱
    پایان
    سرچاپ "قاب‌ها:"، ویدیو.تعداد فریم()، "قاب در ثانیه:"، ویدیو.فریم در ثانیه()
    ناپایا خوانده := ۰
    ناپایا آخری := اپن‌سی‌وی.ماتریس {}
    تا درست:
        قاب := ویدیو.خواندن()
        اگر قاب.خالی(): بشکن پایان
        خوانده += ۱
        آخری.آزادسازی()
        آخری = قاب
    پایان
    سرچاپ خوانده، "قاب خوانده شد، قاب آخر"، آخری.عرض()، "x"، آخری.ارتفاع()
    آخری.آزادسازی()
    ویدیو.بستن()
پایان
