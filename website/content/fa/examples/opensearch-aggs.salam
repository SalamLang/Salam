واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ناپایا تجمیع‌ها := اپن سرچ.افزودن تجمیع("{}"، "authors"، اپن سرچ.تجمیع واژه‌ها("author"، 3))
    تجمیع‌ها = اپن سرچ.افزودن تجمیع(تجمیع‌ها، "avg_year"، اپن سرچ.تجمیع میانگین("year"))
    سرچاپ اپن سرچ.بدنه جستجو(اپن سرچ.درخواست جستجو { size = 0، aggs = تجمیع‌ها })

    پاسخ سرور := `{"took":2,"hits":{"total":{"value":40,"relation":"eq"},"hits":[]},"aggregations":{"authors":{"buckets":[{"key":"Saadi","doc_count":12},{"key":"Rumi","doc_count":9},{"key":"Hafez","doc_count":7}]},"avg_year":{"value":1265.5}}}`
    ر := اپن سرچ.تجزیه جستجو(پاسخ سرور)
    هر ب در اپن سرچ.سطل‌ها(ر.aggregations، "authors"):
        سرچاپ ب.key، ب.doc_count
    پایان
    سرچاپ "میانگین سال:"، اپن سرچ.مقدار تجمیع(ر.aggregations، "avg_year")
پایان
