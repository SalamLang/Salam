واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    ناپایا ب := اپن سرچ.دسته‌ای تازه()
    اپن سرچ.نمایه‌سازی دسته‌ای(ب، "books"، "1"، `{"title":"Shahnameh, the Book of Kings","author":"Ferdowsi","year":1010}`)
    اپن سرچ.نمایه‌سازی دسته‌ای(ب، "books"، "2"، `{"title":"Masnavi","author":"Rumi","year":1258}`)
    اپن سرچ.نمایه‌سازی دسته‌ای(ب، "books"، "3"، `{"title":"Golestan","author":"Saadi","year":1258}`)
    اپن سرچ.نمایه‌سازی دسته‌ای(ب، "books"، "4"، `{"title":"Kings and Heroes","author":"Anonymous","year":1900}`)
    پاسخ := اپن سرچ.ارسال دسته‌ای با تازه‌سازی(ک، ب، اپن سرچ.تازه‌سازی فوری)
    اپن سرچ.آزادسازی دسته‌ای(ب)
    سرچاپ پاسخ.succeeded، "ذخیره شد،"، پاسخ.failed، "شکست خورد"
    هر قلم در پاسخ.items:
        اگر وارونه قلم.ok:
            سرچاپ قلم.id، قلم.error_type، قلم.error_reason
        پایان
    پایان
پایان
