واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ناپایا تنظیم := اپن سرچ.پیکربندی پیش‌فرض()
    تنظیم.nodes.بیفزا("https://node2.example.com:9200, https://node3.example.com:9200")
    تنظیم.username = "app"
    تنظیم.password = "s3cret-pass"
    تنظیم.ca_file = "/etc/ssl/certs/opensearch-ca.pem"
    تنظیم.timeout_ms = 10000
    تنظیم.max_retries = 2
    ک := اپن سرچ.کارخواه تازه(تنظیم)
    سرچاپ اپن سرچ.معتبر(ک)، اپن سرچ.گره‌ها(ک)

    محلی := اپن سرچ.اتصال بدون وارسی گواهی("https://localhost:9200"، "admin"، "admin-pass")
    سرچاپ اپن سرچ.معتبر(محلی)

    آمازون := اپن سرچ.اتصال آمازون(
        "https://search-books.eu-west-1.es.amazonaws.com"، "eu-west-1"، اپن سرچ.سرویس دامنه،
        "AKIA..."، "secret-key"، ""
    )
    سرچاپ اپن سرچ.معتبر(آمازون)
پایان
