واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    اگر وارونه اپن سرچ.پینگ(ک):
        سرچاپ "پاسخی نیامد:"، اپن سرچ.خطا(ک)
        برگشت 1
    پایان
    آگاهی := اپن سرچ.دریافت اطلاعات(ک)
    سرچاپ آگاهی.توزیع، آگاهی.نسخه، آگاهی.نام خوشه
    ه := اپن سرچ.سلامت خوشه(ک)
    سرچاپ "سلامت:"، ه.وضعیت، ه.گره‌ها، "گره"
    برگشت 0
پایان
