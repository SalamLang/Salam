واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    ناپایا ویژگی‌ها := وکتور {} برگردان وکتور<رشته>
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی("title"، "text"))
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی("author"، "keyword"))
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی("year"، "integer"))
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی("stock"، "integer"))
    سرچاپ "ساخته شد:"، اپن سرچ.ایجاد نمایه با تنظیمات(ک، "books"، 1، 0، اپن سرچ.ویژگی‌ها(ویژگی‌ها))

    ن := اپن سرچ.نمایه‌سازی با گزینه(ک، "books"، "1"، `{"title":"Shahnameh","author":"Ferdowsi","year":1010,"stock":3}`، اپن سرچ.گزینه‌ها { تازه‌سازی = اپن سرچ.تازه‌سازی با انتظار })
    سرچاپ "نمایه شد:"، ن.موفق، ن.نتیجه، ن.نسخه

    د := اپن سرچ.دریافت(ک، "books"، "1")
    اگر د.یافت شد:
        سرچاپ "عنوان:"، اپن سرچ.مسیر جیسون(د.منبع، "title")
    پایان

    به‌روز := اپن سرچ.به‌روزرسانی(ک، "books"، "1"، `{"stock":2}`)
    سرچاپ "به‌روز شد:"، به‌روز.نتیجه، به‌روز.نسخه

    حذف شده := اپن سرچ.حذف سند(ک، "books"، "1")
    سرچاپ "حذف شد:"، حذف شده.نتیجه
پایان
