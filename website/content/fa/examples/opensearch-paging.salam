واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    نقطه := اپن سرچ.ایجاد نقطه زمانی(ک، "books"، "2m")
    ناپایا درخواست := اپن سرچ.درخواست جستجو { query = اپن سرچ.تطبیق همه()، size = 100، pit_id = نقطه، pit_keep_alive = "2m" }
    درخواست.sort.بیفزا(اپن سرچ.مرتب صعودی("year"))
    ناپایا دیده‌شده := 0
    ناپایا صفحه := اپن سرچ.جستجو با درخواست(ک، ""، درخواست)
    تا صفحه.hits.طول() > 0:
        دیده‌شده += صفحه.hits.طول()
        درخواست.search_after = صفحه.hits.بگیر(صفحه.hits.طول() - 1).sort
        صفحه = اپن سرچ.جستجو با درخواست(ک، ""، درخواست)
    پایان
    اپن سرچ.حذف نقطه زمانی(ک، نقطه)
    سرچاپ دیده‌شده، "کتاب"
پایان
