واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    نقطه := اپن سرچ.ایجاد نقطه زمانی(ک، "books"، "2m")
    ناپایا درخواست := اپن سرچ.درخواست جستجو { پرسمان = اپن سرچ.تطبیق همه()، اندازه = 100، شناسه نقطه زمانی = نقطه، زنده‌ماندن نقطه زمانی = "2m" }
    درخواست.مرتب‌سازی.بیفزا(اپن سرچ.مرتب صعودی("year"))
    ناپایا دیده‌شده := 0
    ناپایا صفحه := اپن سرچ.جستجو با درخواست(ک، ""، درخواست)
    تا صفحه.نتایج.طول() > 0:
        دیده‌شده += صفحه.نتایج.طول()
        درخواست.ادامه پس از = صفحه.نتایج.بگیر(صفحه.نتایج.طول() - 1).مرتب‌سازی
        صفحه = اپن سرچ.جستجو با درخواست(ک، ""، درخواست)
    پایان
    اپن سرچ.حذف نقطه زمانی(ک، نقطه)
    سرچاپ دیده‌شده، "کتاب"
پایان
