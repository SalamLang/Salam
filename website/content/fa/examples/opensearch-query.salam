واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    سرچاپ اپن سرچ.تطبیق("title"، "book of kings")
    سرچاپ اپن سرچ.واژه("author"، "Ferdowsi")
    سرچاپ اپن سرچ.بازه صحیح("year"، 1000، 1300)

    ناپایا شرط := اپن سرچ.پرسمان منطقی {}
    شرط.الزامی.بیفزا(اپن سرچ.تطبیق("title"، "kings"))
    شرط.فیلتر.بیفزا(اپن سرچ.بازه صحیح("year"، 1000، 1300))
    شرط.ممنوع.بیفزا(اپن سرچ.واژه("author"، "Anonymous"))
    سرچاپ اپن سرچ.پرسمان منطقی ساخته(شرط)

    ناپایا درخواست := اپن سرچ.درخواست جستجو { پرسمان = اپن سرچ.پرسمان منطقی ساخته(شرط)، اندازه = 5 }
    درخواست.مرتب‌سازی.بیفزا(اپن سرچ.مرتب نزولی("year"))
    درخواست.منبع.بیفزا("title")
    سرچاپ اپن سرچ.بدنه جستجو(درخواست)
پایان
