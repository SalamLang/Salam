واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    ناپایا فیلدها := وکتور {} برگردان وکتور<رشته>
    فیلدها.بیفزا("title")
    ناپایا درخواست := اپن سرچ.درخواست جستجو { query = اپن سرچ.تطبیق("title"، "kings")، size = 10 }
    درخواست.highlight = اپن سرچ.برجسته‌سازی(فیلدها)
    ر := اپن سرچ.جستجو با درخواست(ک، "books"، درخواست)
    اگر وارونه ر.ok:
        سرچاپ ر.error
        برگشت 1
    پایان
    سرچاپ ر.total، "یافته"
    هر ه در ر.hits:
        سرچاپ ه.id، ه.score، ه.source
    پایان
    برگشت 0
پایان
