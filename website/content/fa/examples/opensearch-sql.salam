واردسازی دیتابیس
واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    رابط := اپن سرچ.اتصال عمومی(ک)
    سرچاپ دیتابیس.پرسمان عدد(رابط، "SELECT COUNT(*) FROM books WHERE year > 1200")
    ردیف‌ها := رابط.پرسمان("SELECT author, COUNT(*) AS n FROM books GROUP BY author ORDER BY n DESC")
    تا ردیف‌ها.بعدی():
        سرچاپ ردیف‌ها.متن(0)، ردیف‌ها.عدد صحیح(1)
    پایان
    ردیف‌ها.بستن()

    پ := اپن سرچ.پی پی ال(ک، "source=books | where year > 1200 | stats count() by author")
    تا پ.بعدی():
        سرچاپ پ.متن(1)، پ.عدد صحیح(0)
    پایان
    پ.بستن()
پایان
