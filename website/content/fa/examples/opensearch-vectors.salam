واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    روش درخواست := اپن سرچ.روش همسایه‌یابی { engine = "lucene"، space_type = "cosinesimil" }
    ناپایا افزوده := وکتور {} برگردان وکتور<رشته>
    افزوده.بیفزا(اپن سرچ.ویژگی("name"، "text"))
    اپن سرچ.ایجاد نمایه(ک، "places"، اپن سرچ.بدنه نمایه همسایه‌یابی("embedding"، 3، روش درخواست، افزوده))
    اپن سرچ.نمایه‌سازی(ک، "places"، "1"، `{"name":"Naderi Cafe","embedding":[0.1,0.9,0.2]}`)
    اپن سرچ.تازه‌سازی(ک، "places")

    ناپایا ز := وکتور {} برگردان وکتور<اعشار۶۴>
    ز.بیفزا(0.1)
    ز.بیفزا(0.8)
    ز.بیفزا(0.3)
    ر := اپن سرچ.جستجو(ک، "places"، اپن سرچ.نزدیک‌ترین همسایه‌ها("embedding"، ز، 3))
    هر ه در ر.hits:
        سرچاپ ه.id، ه.score، ه.source
    پایان
پایان
