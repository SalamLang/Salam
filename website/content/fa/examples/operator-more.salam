ساختار صفحه:
    خانه‌ها: صحیح[۹] = [۰، ۰، ۰، ۰، ۰، ۰، ۰، ۰، ۰]
    همگانی تابع [](ش: صحیح): صحیح:
        برگشت این.خانه‌ها[ش]
    پایان
    همگانی ناپایا تابع []=(ش: صحیح، نشان: صحیح):
        این.خانه‌ها[ش] = نشان
    پایان
پایان

ساختار بردار:
    همگانی ایکس: صحیح = ۰
    همگانی وای: صحیح = ۰
    همگانی تابع +(دیگر: بردار): بردار:
        برگشت بردار { ایکس = این.ایکس + دیگر.ایکس، وای = این.وای + دیگر.وای }
    پایان
    همگانی تابع *(ضریب: صحیح): بردار:
        برگشت بردار { ایکس = این.ایکس * ضریب، وای = این.وای * ضریب }
    پایان
    همگانی تابع -: بردار:
        برگشت بردار { ایکس = -این.ایکس، وای = -این.وای }
    پایان
    همگانی تابع ==(دیگر: بردار): منطقی:
        برگشت این.ایکس == دیگر.ایکس و این.وای == دیگر.وای
    پایان
پایان

تابع ریشه:
    ناپایا ص := صفحه {}
    ص[۴] = ۱
    ص[۰] = ۲
    سرچاپ ص[۴]، ص[۰]، ص[۸]

    ناپایا جا := بردار { ایکس = ۱، وای = ۲ }
    جا += بردار { ایکس = ۱۰، وای = ۰ }
    سرچاپ جا، جا * ۳، -جا
    سرچاپ جا != بردار {}
پایان
