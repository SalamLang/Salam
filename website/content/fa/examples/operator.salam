ساختار بردار:
    همگانی ایکس: صحیح = ۰
    همگانی وای: صحیح = ۰
    همگانی تابع +(دیگر: بردار): بردار:
        برگشت بردار { ایکس = این.ایکس + دیگر.ایکس، وای = این.وای + دیگر.وای }
    پایان
    همگانی تابع ==(دیگر: بردار): منطقی:
        برگشت این.ایکس == دیگر.ایکس و این.وای == دیگر.وای
    پایان
پایان

تابع ریشه:
    الف := بردار { ایکس = ۱، وای = ۲ }
    ب := بردار { ایکس = ۳، وای = ۴ }
    سرچاپ الف + ب
    سرچاپ الف == ب، (الف + ب) == بردار { ایکس = ۴، وای = ۶ }
پایان
