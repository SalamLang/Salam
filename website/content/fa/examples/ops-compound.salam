تابع ریشه:
    ناپایا موجودی := ۱۰۰
    موجودی += ۵۰
    موجودی -= ۳۰
    موجودی *= ۲
    موجودی /= ۳
    موجودی %= ۵۰
    سرچاپ "موجودی:"، موجودی
    ناپایا گزارش := "آغاز"
    گزارش += "، ذخیره شد"
    گزارش += "، پرونده‌ها: " + ۳
    سرچاپ گزارش
    ناپایا ش := ۵
    ش++
    ش--
    ش++
    ق := ش++
    سرچاپ "ق:"، ق، "ش:"، ش
پایان
