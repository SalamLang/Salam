تابع ریشه:
    دقیقه‌ها := ۱۳۵
    سرچاپ دقیقه‌ها / ۶۰، "ساعت و"، دقیقه‌ها % ۶۰، "دقیقه"
    مهمان‌ها := ۱۷
    صندلی میز := ۴
    میزها := (مهمان‌ها + صندلی میز - ۱) / صندلی میز
    سرچاپ "میز لازم:"، میزها
    سرچاپ "صندلی خالی:"، میزها * صندلی میز - مهمان‌ها
    ن := ۷
    سرچاپ ن، "عددی"، ن % ۲ == ۰ ? "زوج" : "فرد"، "است"
    سرچاپ -۷ / ۲، -۷ % ۲
پایان
