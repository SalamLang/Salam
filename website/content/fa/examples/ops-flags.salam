پایا خواندنی := ۱
پایا نوشتنی := ۲
پایا اجرایی := ۴

روال ریشه:
    ناپایا مجوز := خواندنی | نوشتنی
    سرچاپ "نوشتن مجاز است:"، (مجوز & نوشتنی) != ۰
    مجوز |= اجرایی
    مجوز &= ~نوشتنی
    سرچاپ "نوشتن مجاز است:"، (مجوز & نوشتنی) != ۰
    سرچاپ "اجرا مجاز است:"، (مجوز & اجرایی) != ۰
    سرچاپ "بیت‌ها:"، مجوز
    سرچاپ "۵۰۰۰ بایت به کیلوبایت:"، ۵۰۰۰ >> ۱۰
پایان
