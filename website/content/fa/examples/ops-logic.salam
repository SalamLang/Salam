روال بررسی(نام: رشته): منطقی:
    سرچاپ "  بررسی شد"، نام
    برگشت درست
پایان

روال ریشه:
    تعداد := ۰
    جمع := ۵۰
    اگر تعداد > ۰ و جمع / تعداد > ۱۰:
        سرچاپ "میانگین بالاست"
    وگرنه:
        سرچاپ "هنوز داده‌ای نیست"
    پایان
    سرچاپ نادرست و بررسی("الف")
    سرچاپ درست یا بررسی("ب")
    سرچاپ درست و بررسی("پ")
    وارد شده := درست
    مسدود := نادرست
    سرچاپ "اجازه‌ی ارسال:"، وارد شده و وارونه مسدود
پایان
