تابع ریشه:
    دما := ۳۲
    هوا := دما بزرگتر ۳۰ ? "گرم" : "معتدل"
    سرچاپ "هوا", هوا, "است"
    نمره := ۱۴
    رتبه := نمره بزرگتربرابر ۱۷ ? "عالی" : نمره بزرگتربرابر ۱۴ ? "خوب" : نمره بزرگتربرابر ۱۰ ? "قبول" : "مردود"
    سرچاپ "نتیجه:"، رتبه
    موجودی := ۰
    سرچاپ موجودی بزرگتر ۰ ؟ "موجود است" : "ناموجود"
پایان
