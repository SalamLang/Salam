واردسازی بهینه‌سازی
واردسازی شبکه عصبی
واردسازی مشتق‌گیری خودکار
واردسازی تانسور
واردسازی تبدیل

تابع ریشه:
    ناپایا مخزن := شبکه عصبی.مخزن پارامتر {}
    دستگیره := مخزن.افزودن("w"، تانسور.پرشده(تانسور.شکل یک(۲)، ۱.۰))
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(۱)
    ناپایا بهینه‌ساز := بهینه‌سازی.گرادیان کاهشی تصادفی { lr = ۰.۱ }
    تکرار ۳ در گام:
        نوار.بازنشانی()
        مخزن.صفر کردن گرادیان()
        بهینه‌ساز.lr = بهینه‌سازی.نرخ پله‌ای(۰.۱، گام برگردان صحیح۶۴، ۱، ۰.۵)
        وزن := شبکه عصبی.پیوند(نوار، مخزن، دستگیره)
        زیان := مشتق‌گیری خودکار.مجموع(نوار، مشتق‌گیری خودکار.مقیاس(نوار، مشتق‌گیری خودکار.مربع(نوار، وزن)، ۵۰۰.۰))
        مشتق‌گیری خودکار.پس‌انتشار(نوار، زیان)
        پیش از برش := بهینه‌سازی.برش نُرم گرادیان(مخزن، ۱.۰)
        ناپایا پ := مخزن.عنصر(دستگیره)
        سرچاپ "گام"، گام، "نرخ"، بهینه‌ساز.lr، "نُرم"، تبدیل.قالب اعشار با دقت(پیش از برش، ۱)، "گرادیان بریده"، تبدیل.قالب اعشار با دقت(پ.گرادیان.عنصر(۰)، ۳)، تبدیل.قالب اعشار با دقت(پ.گرادیان.عنصر(۱)، ۳)
        بهینه‌ساز.گام(مخزن)
        سرچاپ "  اکنون وزن"، تبدیل.قالب اعشار با دقت(پ.مقدار.عنصر(۰)، ۳)، تبدیل.قالب اعشار با دقت(پ.مقدار.عنصر(۱)، ۳)
    پایان
    نوار.آزادسازی()
    بهینه‌ساز.آزادسازی()
    مخزن.آزادسازی()
پایان
