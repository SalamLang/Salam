واردسازی هوش مصنوعی.بهینه‌سازی
واردسازی هوش مصنوعی.شبکه عصبی
واردسازی هوش مصنوعی.مشتق‌گیری خودکار
واردسازی هوش مصنوعی.تانسور
واردسازی تبدیل

تابع اجرا(روش: صحیح): اعشار۶۴:
    ناپایا مخزن := شبکه عصبی.مخزن پارامتر {}
    آغاز := تانسور.پرشده(تانسور.شکل یک(۲)، ۱.۰)
    دستگیره := مخزن.افزودن("xy"، آغاز)
    ناپایا داده مقیاس := وکتور {} برگردان وکتور<اعشار۳۲>
    داده مقیاس.بیفزا(۱.۰ برگردان اعشار۳۲)
    داده مقیاس.بیفزا(۵۰.۰ برگردان اعشار۳۲)
    ناپایا شکل مقیاس := تانسور.شکل یک(۲)
    ناپایا مقیاس := تانسور.از آرایه(شکل مقیاس، داده مقیاس)
    ناپایا ساده := بهینه‌سازی.گرادیان کاهشی تصادفی { نرخ یادگیری = ۰.۰۱۹ }
    ناپایا تکانه دار := بهینه‌سازی.گرادیان کاهشی تصادفی { نرخ یادگیری = ۰.۰۱، تکانه = ۰.۹ }
    ناپایا آدام := بهینه‌سازی.آدام { نرخ یادگیری = ۰.۱ }
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(۱)
    ناپایا آخرین := ۰.۰
    تکرار ۴۰:
        نوار.بازنشانی()
        مخزن.صفر کردن گرادیان()
        پ := شبکه عصبی.پیوند(نوار، مخزن، دستگیره)
        زیان := مشتق‌گیری خودکار.مجموع(نوار، مشتق‌گیری خودکار.ضرب درایه‌ای(نوار، مشتق‌گیری خودکار.ثابت(نوار، مقیاس)، مشتق‌گیری خودکار.مربع(نوار، پ)))
        مشتق‌گیری خودکار.پس‌انتشار(نوار، زیان)
        آخرین = مشتق‌گیری خودکار.مقدار(نوار، زیان).عنصر(۰)
        اگر روش == ۰: ساده.گام(مخزن) پایان
        اگر روش == ۱: تکانه دار.گام(مخزن) پایان
        اگر روش == ۲: آدام.گام(مخزن) پایان
    پایان
    نوار.آزادسازی()
    ساده.آزادسازی()
    تکانه دار.آزادسازی()
    آدام.آزادسازی()
    مخزن.آزادسازی()
    برگشت آخرین
پایان

تابع ریشه:
    نام ها := ["SGD"، "SGD با تکانه"، "Adam"]
    تکرار ۳ در روش:
        سرچاپ نام ها[روش]، تبدیل.قالب اعشار با دقت(اجرا(روش)، ۴)
    پایان
