واردسازی بهینه‌سازی
واردسازی شبکه عصبی
واردسازی مشتق‌گیری خودکار
واردسازی تانسور
واردسازی تبدیل

تابع ریشه:
    مسافت := [۱.۰، ۲.۵، ۴.۰، ۵.۵، ۷.۰، ۸.۵، ۳.۰، ۶.۰]
    اقلام := [۱.۰، ۳.۰، ۲.۰، ۵.۰، ۱.۰، ۴.۰، ۶.۰، ۲.۰]
    دقیقه‌ها := [۱۴.۰، ۲۲.۵، ۲۶.۰، ۳۷.۵، ۳۷.۰، ۴۸.۵، ۳۳.۰، ۳۶.۰]
    ناپایا ورودی‌ها := تانسور.صفرها دو(۸، ۲)
    ناپایا هدف‌ها := تانسور.صفرها دو(۸، ۱)
    تکرار ۸ در ی:
        ورودی‌ها.تنظیم در دو(ی، ۰، مسافت[ی] / ۱۰.۰)
        ورودی‌ها.تنظیم در دو(ی، ۱، اقلام[ی] / ۱۰.۰)
        هدف‌ها.تنظیم در دو(ی، ۰، دقیقه‌ها[ی] / ۱۰.۰)
    پایان
    ناپایا مولد := تانسور.مولد تصادفی جدید(۱)
    ناپایا مخزن := شبکه عصبی.مخزن پارامتر {}
    مدل := شبکه عصبی.لایه خطی جدید(مخزن، "eta"، ۲، ۱، مولد)
    ناپایا بهینه‌ساز := بهینه‌سازی.آدام دابلیو جدید(۰.۱، ۰.۰۱)
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(۱)
    کل := ۴۰۰ برگردان صحیح۶۴
    تکرار ۴۰۰ در گام:
        نوار.بازنشانی()
        مخزن.صفر کردن گرادیان()
        حدس := مدل.پیشرو(نوار، مخزن، مشتق‌گیری خودکار.ورودی(نوار، ورودی‌ها))
        زیان := مشتق‌گیری خودکار.خطای میانگین مربعات(نوار، حدس، مشتق‌گیری خودکار.ثابت(نوار، هدف‌ها))
        مشتق‌گیری خودکار.پس‌انتشار(نوار، زیان)
        نرم := بهینه‌سازی.برش نُرم گرادیان(مخزن، ۵.۰)
        بهینه‌ساز.lr = بهینه‌سازی.گرمایش سپس کسینوس(۰.۱، گام برگردان صحیح۶۴، ۲۰، کل، ۰.۰۰۱)
        بهینه‌ساز.گام(مخزن)
        اگر گام % ۱۰۰ == ۰ یا گام == ۳۹۹:
            سرچاپ "گام"، گام، "نرخ"، تبدیل.قالب اعشار با دقت(بهینه‌ساز.lr، ۴)، "زیان"، تبدیل.قالب اعشار با دقت(مشتق‌گیری خودکار.مقدار(نوار، زیان).عنصر(۰)، ۴)، "نرم گرادیان"، تبدیل.قالب اعشار با دقت(نرم، ۳)
        پایان
    پایان
    وزن‌ها := مخزن.عنصر(مدل.شماره وزن).مقدار
    بایاس := مخزن.عنصر(مدل.شماره سوگیری).مقدار
    سرچاپ "دقیقه ="، تبدیل.قالب اعشار با دقت(بایاس.عنصر(۰) * ۱۰.۰، ۱)، "+"، تبدیل.قالب اعشار با دقت(وزن‌ها.عنصر(۰)، ۲)، "برای هر کیلومتر +"، تبدیل.قالب اعشار با دقت(وزن‌ها.عنصر(۱)، ۲)، "برای هر قلم"
    نوار.آزادسازی()
    بهینه‌ساز.آزادسازی()
    مخزن.آزادسازی()
    ورودی‌ها.آزادسازی()
    هدف‌ها.آزادسازی()
پایان
