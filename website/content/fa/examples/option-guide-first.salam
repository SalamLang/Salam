واردسازی اختیاری

ساختار کار:
    همگانی نام: رشته = ""
    همگانی انجام شده: منطقی = نادرست
پایان

تابع نخستین کار باز(کارها: وکتور<کار>): اختیاری.اختیاری<رشته>:
    هر ک در کارها:
        اگر وارونه ک.انجام شده:
            برگشت اختیاری.یک مقدار(ک.نام)
        پایان
    پایان
    برگشت اختیاری.هیچ مقدار()
پایان

تابع ریشه:
    ناپایا کارها := وکتور {} برگردان وکتور<کار>
    دیرکن کارها.آزادکن()
    کارها.بیفزا(کار { نام = "نوشتن آزمون‌ها"، انجام شده = درست })
    کارها.بیفزا(کار { نام = "رفع ایراد ورود" })
    کارها.بیفزا(کار { نام = "به‌روزرسانی راهنما" })
    بعدی := نخستین کار باز(کارها)
    سرچاپ "کار بعدی:"، اختیاری.انتظار(بعدی، "این‌جا همیشه یک کار باز هست")
    هر ش، ک در کارها:
        کارها.بنشان(ش، کار { نام = ک.نام، انجام شده = درست })
    پایان
    سرچاپ "کاری مانده؟"، اختیاری.دارد(نخستین کار باز(کارها))
پایان
