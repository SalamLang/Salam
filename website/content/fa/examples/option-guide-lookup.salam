واردسازی اختیاری

تابع شماره‌ی تلفن(دفترچه: نگاشت<رشته، رشته>، نام: رشته): اختیاری.اختیاری<رشته>:
    اگر دفترچه.دارد(نام):
        برگشت اختیاری.یک مقدار(دفترچه.بگیر(نام))
    پایان
    برگشت اختیاری.هیچ مقدار()
پایان

تابع ریشه:
    ناپایا دفترچه := نگاشت {} برگردان نگاشت<رشته، رشته>
    دیرکن دفترچه.آزادکن()
    دفترچه.درج("سارا"، "۰۹۱۲ ۱۱۱ ۲۲۳۳")
    دفترچه.درج("امید"، "۰۹۳۵ ۴۴۴ ۵۵۶۶")
    هر نام در ["امید"، "ندا"]:
        ت := شماره‌ی تلفن(دفترچه، نام)
        اگر اختیاری.دارد(ت):
            سرچاپ نام + ":"، ت.مقدار
        وگرنه:
            سرچاپ نام + ": شماره‌ای ثبت نشده"
        پایان
    پایان
    سرچاپ "تماس با"، اختیاری.یابرگردان(شماره‌ی تلفن(دفترچه، "ندا")، "پذیرش")
پایان
