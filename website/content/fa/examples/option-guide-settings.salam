واردسازی اختیاری

ساختار تنظیمات:
    همگانی پهنا: اختیاری.اختیاری<صحیح> = اختیاری.هیچ مقدار() برگردان اختیاری.اختیاری<صحیح>
    همگانی عنوان: اختیاری.اختیاری<رشته> = اختیاری.هیچ مقدار() برگردان اختیاری.اختیاری<رشته>
پایان

تابع شرح(ت: تنظیمات): رشته:
    پ := اختیاری.یابرگردان(ت.پهنا، ۸۰)
    ع := اختیاری.یابرگردان(ت.عنوان، "بی‌نام")
    برگشت ع + " (" + پ + " ستون)"
پایان

تابع ریشه:
    سرچاپ شرح(تنظیمات {})
    سرچاپ شرح(تنظیمات { پهنا = اختیاری.یک مقدار(۱۲۰) })
    سرچاپ شرح(تنظیمات { پهنا = اختیاری.یک مقدار(۰)، عنوان = اختیاری.یک مقدار("گزارش") })
پایان
