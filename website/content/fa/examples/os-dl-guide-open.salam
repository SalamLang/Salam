// زبان: فارسی
واردسازی سیستم عامل.بارگذاری کتابخانه
واردسازی رشته

تابع اولین را باز کن(مسیرها: رشته[]): تهی*:
    هر مسیر در مسیرها:
        کتابخانه := بارگذاری کتابخانه.باز کردن(مسیر)
        اگر کتابخانه نابرابر پوچ:
            برگشت کتابخانه
        پایان
    پایان
    برگشت پوچ
پایان

تابع ریشه:
    اگر وارونه بارگذاری کتابخانه.پشتیبانی می شود():
        سرچاپ "dynamic loading is not available here"
        برگشت
    پایان
    کتابخانه := اولین را باز کن(["libno-such-library.so"، "libc.so.6"، "libc.dylib"، "/usr/lib/libSystem.B.dylib"، "libc.so.7"])
    اگر کتابخانه برابر پوچ:
        سرچاپ "no C library found:"، بارگذاری کتابخانه.خطا()
        برگشت
    پایان
    دیرکن _closed := بارگذاری کتابخانه.بستن(کتابخانه)
    سرچاپ "opened a C library"
    متن := "shared library"
    درازا := بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(کتابخانه، "strlen")، [(متن برگردان تهی*) برگردان اندازه])
    سرچاپ "strlen says"، رشته.از عدد(درازا برگردان صحیح۶۴)
پایان
