// زبان: فارسی
واردسازی سیستم عامل.بارگذاری کتابخانه
واردسازی رشته

تابع صدا زدن با نام(کتابخانه: تهی*، نام: رشته، آرگومان: اندازه): رشته:
    نشانی := بارگذاری کتابخانه.نماد(کتابخانه، نام)
    اگر نشانی برابر پوچ:
        برگشت نام + ": not found"
    پایان
    برگشت نام + ": " + رشته.از عدد(بارگذاری کتابخانه.فراخوان(نشانی، [آرگومان]) برگردان صحیح۶۴)
پایان

تابع ریشه:
    اگر وارونه بارگذاری کتابخانه.پشتیبانی می شود():
        سرچاپ "dynamic loading is not available here"
        برگشت
    پایان
    کتابخانه := بارگذاری کتابخانه.باز کردن برنامه()
    اگر کتابخانه برابر پوچ:
        سرچاپ "cannot open the program:"، بارگذاری کتابخانه.خطا()
        برگشت
    پایان
    دیرکن _closed := بارگذاری کتابخانه.بستن(کتابخانه)
    متن := "salam"
    سرچاپ صدا زدن با نام(کتابخانه، "strlen"، (متن برگردان تهی*) برگردان اندازه)
    سرچاپ صدا زدن با نام(کتابخانه، "labs"، (0 - 42) برگردان اندازه)
    سرچاپ صدا زدن با نام(کتابخانه، "no_such_function"، 1 برگردان اندازه)
پایان
