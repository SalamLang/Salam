واردسازی سیستم عامل.خطا
واردسازی سیستم پرونده.پرونده

تابع ریشه:
    پرونده.حذف("گمشده.txt")
    پرونده.نوشتن متن("سالم.txt"، "خوب")
    سرچاپ "پس از یک نوشتن موفق:"، خطا.خطا دارد()، خطا.پیام آخرین خطا()
    خطا.پاک کردن خطا()
    پرونده.نوشتن متن("سالم.txt"، "هنوز خوب")
    سرچاپ "پس از پاک کردن و یک نوشتن موفق:"، خطا.خطا دارد()
    پرونده.حذف("سالم.txt")
    سرچاپ "پس از حذف سالم.txt:"، خطا.خطا دارد()
