واردسازی سیستم عامل.خطا
واردسازی سیستم پرونده

تابع ریشه:
    سیستم پرونده.حذف("گمشده.txt")
    سیستم پرونده.نوشتن متن("سالم.txt"، "خوب")
    سرچاپ "پس از یک نوشتن موفق:"، خطا.خطا دارد()، خطا.پیام آخرین خطا()
    خطا.پاک کردن خطا()
    سیستم پرونده.نوشتن متن("سالم.txt"، "هنوز خوب")
    سرچاپ "پس از پاک کردن و یک نوشتن موفق:"، خطا.خطا دارد()
    سیستم پرونده.حذف("سالم.txt")
    سرچاپ "پس از حذف سالم.txt:"، خطا.خطا دارد()
