واردسازی سیستم عامل.خطا
واردسازی سیستم پرونده.پرونده

تابع توضیح(خ: خطا.خطای سیستم عامل): رشته:
    ترابرد خ.کد:
        خطا.پرونده یافت نشد: برگشت "چنین پرونده‌ای نیست: " + خ.مسیر پایان
        خطا.خطای ورودی خروجی: برگشت خ.عملیات + " روی " + خ.مسیر + " شکست خورد" پایان
        خطا.فرآیند ناموفق: برگشت "این برنامه اجرا نشد: " + خ.مسیر پایان
    پایان
    برگشت "مشکل دیگری پیش آمد در " + خ.عملیات
پایان

تابع حذف پیش نویس(نام: رشته):
    خطا.پاک کردن خطا()
    پرونده.حذف(نام)
    اگر خطا.خطا دارد():
        سرچاپ "حذف نشد:"، توضیح(خطا.آخرین خطا())
        برگشت
    پایان
    سرچاپ "حذف شد:"، نام
پایان

تابع ریشه:
    پرونده.نوشتن متن("پیش‌نویس.txt"، "یادداشت")
    حذف پیش نویس("پیش‌نویس.txt")
    حذف پیش نویس("پیش‌نویس.txt")
پایان
