واردسازی سیستم عامل.خطا
واردسازی سیستم پرونده.پرونده

تابع توضیح(خ: خطا.خطای سیستم عامل): رشته:
    ترابرد خ.code:
        خطا.پرونده یافت نشد: برگشت "چنین پرونده‌ای نیست: " + خ.path پایان
        خطا.خطای ورودی خروجی: برگشت خ.operation + " روی " + خ.path + " شکست خورد" پایان
        خطا.فرآیند ناموفق: برگشت "این برنامه اجرا نشد: " + خ.path پایان
    پایان
    برگشت "مشکل دیگری پیش آمد در " + خ.operation
پایان

تابع حذف پیش نویس(نام: رشته):
    خطا.پاک کردن خطا()
    پرونده.حذف(نام)
    اگر خطا.خطا دارد():
        سرچاپ "حذف نشد:"، توضیح(خطا.آخرین خطا())
        برگشت
    پایان
    سرچاپ "حذف شد:"، نام
پایان

تابع ریشه:
    پرونده.نوشتن متن("پیش‌نویس.txt"، "یادداشت")
    حذف پیش نویس("پیش‌نویس.txt")
    حذف پیش نویس("پیش‌نویس.txt")
پایان
