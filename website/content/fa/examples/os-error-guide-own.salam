واردسازی سیستم عامل.خطا
واردسازی سیستم پرونده

تابع خواندن درگاه(مسیر: رشته): صحیح:
    خطا.پاک کردن خطا()
    اگر وارونه سیستم پرونده.وجود دارد(مسیر):
        خطا.تنظیم خطا(خطا.پرونده یافت نشد، "پرونده‌ی تنظیمات نیست"، "خواندن درگاه"، مسیر، ۰)
        برگشت ۰
    پایان
    متن := سیستم پرونده.خواندن متن(مسیر).پیراست()
    درگاه := متن.به صحیح()
    اگر درگاه <= ۰ یا درگاه > ۶۵۵۳۵:
        خطا.تنظیم خطا(خطا.مسیر نامعتبر، "شماره‌ی درگاه نیست: " + متن، "خواندن درگاه"، مسیر، ۰)
        برگشت ۰
    پایان
    برگشت درگاه
پایان

تابع نمایش(مسیر: رشته):
    درگاه := خواندن درگاه(مسیر)
    اگر خطا.خطا دارد():
        خ := خطا.آخرین خطا()
        سرچاپ خ.عملیات + "(" + خ.مسیر + "):"، خ.پیام
        برگشت
    پایان
    سرچاپ مسیر، "می‌گوید درگاه"، درگاه
پایان

تابع ریشه:
    سیستم پرونده.نوشتن متن("درست.conf"، "8080\n")
    سیستم پرونده.نوشتن متن("خراب.conf"، "هشتاد\n")
    نمایش("درست.conf")
    نمایش("خراب.conf")
    نمایش("ناموجود.conf")
    سیستم پرونده.حذف("درست.conf")
    سیستم پرونده.حذف("خراب.conf")
پایان
