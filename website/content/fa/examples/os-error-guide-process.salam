واردسازی سیستم عامل.خطا
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("--version")
    خطا.پاک کردن خطا()
    ناپایا ف := فرآیند.شروع با ضبط("/no/such/program"، آرگ)
    اگر خطا.خطا دارد():
        خ := خطا.آخرین خطا()
        سرچاپ "اجرا نشد:"، خ.کد == خطا.فرآیند ناموفق، خ.عملیات، خ.مسیر
        برگشت ۰
    پایان
    کد := فرآیند.انتظار(ف)
    فرآیند.پاکسازی(ف)
    سرچاپ "اجرا شد، ولی با این کد بیرون آمد:"، کد
پایان
