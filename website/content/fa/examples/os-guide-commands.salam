واردسازی سیستم عامل

تابع ابزار هست(نام: رشته): منطقی:
    برگشت سیستم عامل.اجرا("command -v " + نام + " > /dev/null") == ۰
پایان

تابع ریشه:
    سرچاپ "sh هست:"، ابزار هست("sh")
    سرچاپ "ابزار ساختگی هست:"، ابزار هست("no-such-tool-here")
    ن := سیستم عامل.اجرا با خروجی("printf '۳\\n۱\\n۲\\n' | sort")
    اگر ن.کد != ۰:
        نادرست‌سرچاپ "sort شکست خورد با کد"، ن.کد
        برگشت ۱
    پایان
    چاپ ن.خروجی
    شمار := سیستم عامل.خروجی فرمان("printf 'الف\\nب\\n' | wc -l").پیراست()
    سرچاپ "سطرهایی که wc شمرد:"، شمار
پایان
