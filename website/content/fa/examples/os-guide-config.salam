واردسازی سیستم عامل

تابع تنظیم(متن: رشته، کلید: رشته، پیش فرض: رشته): رشته:
    هر سطر در متن.بشکاف("\n"):
        اگر سطر.شروع با(کلید + "="):
            برگشت سطر.زیررشته(کلید.طول() + ۱، سطر.طول() - کلید.طول() - ۱)
        پایان
    پایان
    برگشت پیش فرض
پایان

تابع ریشه:
    مسیر := "برنامه.conf"
    اگر وارونه سیستم عامل.وجود دارد(مسیر):
        سیستم عامل.نوشتن پرونده(مسیر، "درگاه=8080\nنام=یادداشت‌ها\n")
        سرچاپ "پرونده‌ی پیش‌فرض نوشته شد:"، مسیر
    پایان
    متن := سیستم عامل.خواندن پرونده(مسیر)
    سرچاپ "درگاه:"، تنظیم(متن، "درگاه"، "80")
    سرچاپ "نام:"، تنظیم(متن، "نام"، "برنامه")
    سرچاپ "اشکال‌زدایی:"، تنظیم(متن، "اشکال‌زدایی"، "خاموش")
    سیستم عامل.حذف(مسیر)
پایان
