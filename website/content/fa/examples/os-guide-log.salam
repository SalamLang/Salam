واردسازی سیستم عامل

تابع ثبت(مسیر: رشته، پیام: رشته):
    سیستم عامل.افزودن به پرونده(مسیر، پیام + "\n")
پایان

تابع ریشه:
    مسیر := "برنامه.log"
    ثبت(مسیر، "شروع شد")
    ثبت(مسیر، "سارا وارد شد")
    ثبت(مسیر، "متوقف شد")
    سرچاپ "اندازه:"، سیستم عامل.اندازه پرونده(مسیر)، "بایت"
    سطرها := سیستم عامل.خواندن پرونده(مسیر).بشکاف("\n")
    سرچاپ "نخستین رخداد:"، سطرها.بگیر(۰)
    اگر سیستم عامل.اندازه پرونده(مسیر) > ۳۲:
        سیستم عامل.جابجایی(مسیر، "برنامه.log.1")
        سرچاپ "چرخانده شد:"، سیستم عامل.وجود دارد("برنامه.log.1")، سیستم عامل.وجود دارد(مسیر)
    پایان
    ثبت(مسیر، "گزارش تازه")
    سرچاپ "اندازه‌ی تازه:"، سیستم عامل.اندازه پرونده(مسیر)
    سیستم عامل.حذف(مسیر)
    سیستم عامل.حذف("برنامه.log.1")
پایان
