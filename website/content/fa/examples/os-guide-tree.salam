واردسازی سیستم عامل
واردسازی مرتب سازی

تابع ریشه:
    سیستم عامل.ساخت پوشه ها("سایت/صفحه‌ها/وبلاگ")
    سیستم عامل.ساخت پوشه ها("سایت/دارایی‌ها")
    سیستم عامل.نوشتن پرونده("سایت/صفحه‌ها/خانه.salam"، "تابع ریشه: پایان")
    سیستم عامل.نوشتن پرونده("سایت/صفحه‌ها/وبلاگ/نخستین.salam"، "تابع ریشه: پایان")
    سیستم عامل.نوشتن پرونده("سایت/دارایی‌ها/نشان.svg"، "<svg/>")
    ناپایا شمار := ۰
    ناپایا بایت‌ها := ۰ برگردان صحیح۶۴
    هر پ در سیستم عامل.پیمایش("سایت"):
        اگر پ.ختم با(".salam"):
            شمار += ۱
            بایت‌ها += سیستم عامل.اندازه پرونده(پ)
        پایان
    پایان
    سرچاپ "پرونده‌های کد:"، شمار، "با"، بایت‌ها، "بایت"
    پوشه‌ها := سیستم عامل.فهرست پوشه ها("سایت")
    مرتب سازی.مرتب(پوشه‌ها)
    هر نام در پوشه‌ها:
        سرچاپ "پوشه:"، نام
    پایان
    سیستم عامل.حذف همه("سایت")
    سرچاپ "پاک شد:"، وارونه سیستم عامل.وجود دارد("سایت")
پایان
