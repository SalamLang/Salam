// زبان: فارسی
واردسازی سیستم عامل.نگاشت حافظه

تابع ریشه:
    اگر وارونه نگاشت حافظه.پشتیبانی می شود():
        سرچاپ "memory mapping is not available here"
        برگشت
    پایان
    برگه := نگاشت حافظه.اندازه صفحه()
    جدول := نگاشت حافظه.تخصیص(برگه، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی نوشتن)
    دیرکن _freed := نگاشت حافظه.آزادسازی(جدول، برگه)
    خانه ها := جدول برگردان صحیح۳۲*
    تکرار 16 در ا:
        خانه ها[ا] = ا * ا
    پایان
    سرچاپ "filled:"، خانه ها[3]، خانه ها[15]
    سرچاپ "read-only:"، نگاشت حافظه.تغییر دسترسی(جدول، برگه، نگاشت حافظه.دسترسی خواندن)
    سرچاپ "still readable:"، خانه ها[4]
    سرچاپ "writable again:"، نگاشت حافظه.تغییر دسترسی(جدول، برگه، نگاشت حافظه.دسترسی خواندن | نگاشت حافظه.دسترسی نوشتن)
    خانه ها[4] = 99
    سرچاپ "after the change:"، خانه ها[4]
پایان
