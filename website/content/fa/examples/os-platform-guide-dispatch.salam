واردسازی سیستم عامل.سکو

تابع نام اجرایی(نام: رشته): رشته:
    اگر سکو.ویندوز است():
        برگشت نام + ".exe"
    پایان
    برگشت نام
پایان

تابع فرمان بازکردن(): رشته:
    اگر سکو.ویندوز است(): برگشت "start" پایان
    اگر سکو.مک است(): برگشت "open" پایان
    برگشت "xdg-open"
پایان

تابع ریشه:
    ناپایا جورها := ۰
    اگر سکو.لینوکس است(): جورها += ۱ پایان
    اگر سکو.ویندوز است(): جورها += ۱ پایان
    اگر سکو.مک است(): جورها += ۱ پایان
    اگر سکو.فری‌بی‌اس‌دی است(): جورها += ۱ پایان
    اگر سکو.وب‌اسمبلی است(): جورها += ۱ پایان
    سرچاپ "حداکثر یک سیستم جور شد:"، جورها <= ۱
    سرچاپ "نام پرونده‌ی اجرایی ساخته شد:"، نام اجرایی("salam").شروع با("salam")
    سرچاپ "فرمان بازکردن انتخاب شد:"، فرمان بازکردن().طول() > ۰
پایان
