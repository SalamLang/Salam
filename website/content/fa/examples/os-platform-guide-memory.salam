واردسازی سیستم عامل.سکو

پایا مگابایت := ۱۰۴۸۵۷۶ برگردان صحیح۶۴

تابع اندازه حافظه نهان(): صحیح۶۴:
    ناپایا اندازه := سکو.کل حافظه() / ۱۶
    اگر اندازه کوچکتر ۶۴ * مگابایت:
        اندازه = ۶۴ * مگابایت
    پایان
    اگر اندازه بزرگتر ۱۰۲۴ * مگابایت:
        اندازه = ۱۰۲۴ * مگابایت
    پایان
    آزاد := سکو.حافظه موجود()
    اگر آزاد بزرگتر ۰ و اندازه بزرگتر آزاد / ۲:
        اندازه = آزاد / ۲
    پایان
    برگشت اندازه
پایان

تابع ریشه:
    اندازه := اندازه حافظه نهان()
    سرچاپ "حافظه‌ی نهان حداکثر ۱ گیگابایت:"، اندازه کوچکتربرابر ۱۰۲۴ * مگابایت
    سرچاپ "حافظه‌ی نهان مثبت:"، اندازه بزرگتر ۰
    آزاد := سکو.حافظه موجود()
    سرچاپ "در حافظه‌ی آزاد جا می‌شود:"، آزاد کوچکتر ۰ یا اندازه کوچکتربرابر آزاد
پایان
