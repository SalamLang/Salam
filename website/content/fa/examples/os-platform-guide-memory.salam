واردسازی سیستم عامل.سکو

پایا مگابایت := ۱۰۴۸۵۷۶ برگردان صحیح۶۴

تابع اندازه حافظه نهان(): صحیح۶۴:
    ناپایا اندازه := سکو.کل حافظه() / ۱۶
    اگر اندازه < ۶۴ * مگابایت:
        اندازه = ۶۴ * مگابایت
    پایان
    اگر اندازه > ۱۰۲۴ * مگابایت:
        اندازه = ۱۰۲۴ * مگابایت
    پایان
    آزاد := سکو.حافظه موجود()
    اگر آزاد > ۰ و اندازه > آزاد / ۲:
        اندازه = آزاد / ۲
    پایان
    برگشت اندازه
پایان

تابع ریشه:
    اندازه := اندازه حافظه نهان()
    سرچاپ "حافظه‌ی نهان حداکثر ۱ گیگابایت:"، اندازه <= ۱۰۲۴ * مگابایت
    سرچاپ "حافظه‌ی نهان مثبت:"، اندازه > ۰
    آزاد := سکو.حافظه موجود()
    سرچاپ "در حافظه‌ی آزاد جا می‌شود:"، آزاد < ۰ یا اندازه <= آزاد
پایان
