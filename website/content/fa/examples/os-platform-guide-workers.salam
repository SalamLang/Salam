واردسازی سیستم عامل.سکو

تابع شمار کارگر(سقف: صحیح): صحیح:
    هسته‌ها := سکو.تعداد پردازنده()
    اگر هسته‌ها < ۱:
        برگشت ۱
    پایان
    اگر هسته‌ها > سقف:
        برگشت سقف
    پایان
    برگشت هسته‌ها
پایان

تابع ریشه:
    کارگرها := شمار کارگر(۸)
    سرچاپ "کارگرها میان ۱ و ۸:"، کارگرها >= ۱ و کارگرها <= ۸
    سرچاپ "هرگز بیش از هسته‌ها:"، کارگرها <= سکو.تعداد پردازنده()
    یکی := شمار کارگر(۱)
    سرچاپ "با سقف یک:"، یکی
پایان
