واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("[%s]\n")
    آرگ.بیفزا("دو واژه")
    آرگ.بیفزا("it's quoted")
    آرگ.بیفزا("$HOME")
    آرگ.بیفزا("*.txt; rm -rf x")
    ناپایا ف := فرآیند.شروع با ضبط("printf"، آرگ)
    فرآیند.انتظار(ف)
    چاپ فرآیند.خواندن خروجی(ف)
    فرآیند.پاکسازی(ف)
پایان
