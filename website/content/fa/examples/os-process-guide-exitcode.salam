واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("-c")
    آرگ.بیفزا("echo در حال رونوشت; echo دیسک پر است >&2; exit 3")
    ناپایا ف := فرآیند.شروع با ضبط("sh"، آرگ)
    کد := فرآیند.انتظار(ف)
    خروجی := فرآیند.خواندن خروجی(ف).پیراست()
    پیام خطا := فرآیند.خواندن خطا(ف).پیراست()
    فرآیند.پاکسازی(ف)
    سرچاپ "خروجی:"، خروجی
    اگر کد != ۰:
        سرچاپ "با کد"، کد، "شکست خورد و گفت:"، پیام خطا
        برگشت ۰
    پایان
    سرچاپ "همه چیز درست بود"
پایان
