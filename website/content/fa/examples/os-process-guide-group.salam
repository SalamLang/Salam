// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان("sleep 30 & sleep 30 & wait")
    cmd.گروه تازه = درست
    cmd.حالت خروجی = فرآیند.لوله
    ناپایا child := فرآیند.اجرای فرزند(cmd)
    سرچاپ "گروه کشته شد:"، child.کشتن گروه()
    st := child.انتظار(2000)
    سرچاپ "سیگنال:"، st.سیگنال
    tail := child.خواندن موجود(2000)
    سرچاپ "لوله بسته شد:"، tail.پایان
    tail.آزادسازی()
    child.بستن()
    cmd.آزادسازی()
پایان
