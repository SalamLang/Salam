// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان("sleep 30 & sleep 30 & wait")
    فرمان.گروه تازه = درست
    فرمان.حالت خروجی = فرآیند.لوله
    ناپایا فرزند_فرآیند := فرآیند.اجرای فرزند(فرمان)
    سرچاپ "گروه کشته شد:"، فرزند_فرآیند.کشتن گروه()
    سبک_متن := فرزند_فرآیند.انتظار(2000)
    سرچاپ "سیگنال:"، سبک_متن.سیگنال
    دم := فرزند_فرآیند.خواندن موجود(2000)
    سرچاپ "لوله بسته شد:"، دم.پایان
    دم.آزادسازی()
    فرزند_فرآیند.بستن()
    فرمان.آزادسازی()
پایان
