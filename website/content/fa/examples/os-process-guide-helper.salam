واردسازی سیستم عامل.خطا
واردسازی سیستم عامل.فرآیند

تابع ضبط(برنامه: رشته، آرگ: وکتور<رشته>، موفق &: منطقی): رشته:
    خطا.پاک کردن خطا()
    ناپایا ف := فرآیند.شروع با ضبط(برنامه، آرگ)
    اگر خطا.خطا دارد():
        موفق = نادرست
        برگشت ""
    پایان
    دیرکن فرآیند.پاکسازی(ف)
    موفق = فرآیند.انتظار(ف) == ۰
    برگشت فرآیند.خواندن خروجی(ف)
پایان

تابع ریشه:
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("-c")
    آرگ.بیفزا("printf '۳۰\\n۱۰\\n۲۰\\n' | sort")
    ناپایا موفق := نادرست
    خروجی := ضبط("sh"، آرگ، موفق)
    سرچاپ "موفق بود:"، موفق
    چاپ خروجی
    ضبط("/no/such/tool"، آرگ، موفق)
    سرچاپ "ابزار ناموجود موفق بود:"، موفق
پایان
