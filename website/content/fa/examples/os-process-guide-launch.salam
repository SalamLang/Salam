// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان("read name; echo hello $name")
    فرمان.حالت ورودی = فرآیند.لوله
    فرمان.حالت خروجی = فرآیند.لوله
    ناپایا فرزند_فرآیند := فرآیند.اجرای فرزند(فرمان)
    اگر وارونه فرزند_فرآیند.راه افتاد:
        سرچاپ "اجرا نشد:"، فرزند_فرآیند.خطا
        برگشت 1
    پایان
    فرزند_فرآیند.نوشتن("Sara\n")
    پاسخ_فرآیند := فرزند_فرآیند.خواندن خط(2000)
    سرچاپ پاسخ_فرآیند.داده
    پاسخ_فرآیند.آزادسازی()
    سرچاپ "کد خروج:"، فرزند_فرآیند.انتظار(2000).کد
    فرزند_فرآیند.بستن()
    فرمان.آزادسازی()
پایان
