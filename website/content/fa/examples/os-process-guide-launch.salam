// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان("read name; echo hello $name")
    cmd.حالت ورودی = فرآیند.لوله
    cmd.حالت خروجی = فرآیند.لوله
    ناپایا child := فرآیند.اجرای فرزند(cmd)
    اگر وارونه child.راه افتاد:
        سرچاپ "اجرا نشد:"، child.خطا
        برگشت 1
    پایان
    child.نوشتن("Sara\n")
    reply := child.خواندن خط(2000)
    سرچاپ reply.داده
    reply.آزادسازی()
    سرچاپ "کد خروج:"، child.انتظار(2000).کد
    child.بستن()
    cmd.آزادسازی()
پایان
