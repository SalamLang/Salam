واردسازی سیستم عامل.فرآیند

تابع کار(نام: رشته، ثانیه: رشته): فرآیند.فرآیند:
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("-c")
    آرگ.بیفزا("sleep " + ثانیه + "; echo " + نام + " تمام شد")
    برگشت فرآیند.شروع با ضبط("sh"، آرگ)
پایان

تابع ریشه:
    ناپایا کارها := وکتور {} برگردان وکتور<فرآیند.فرآیند>
    دیرکن کارها.آزادکن()
    کارها.بیفزا(کار("تصویرک‌ها"، "0.3"))
    کارها.بیفزا(کار("نمایه‌ی جستجو"، "0.1"))
    کارها.بیفزا(کار("نقشه‌ی سایت"، "0.2"))
    سرچاپ کارها.طول()، "کار شروع شد"
    تکرار کارها.طول() در ش:
        ناپایا ف := کارها.بگیر(ش)
        کد := فرآیند.انتظار(ف)
        سرچاپ کد، فرآیند.خواندن خروجی(ف).پیراست()
        فرآیند.پاکسازی(ف)
    پایان
پایان
