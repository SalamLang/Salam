// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان("echo first; sleep 0.3; echo second")
    فرمان.حالت خروجی = فرآیند.لوله
    ناپایا فرزند_فرآیند := فرآیند.اجرای فرزند(فرمان)
    الف := فرزند_فرآیند.خواندن خط(2000)
    سرچاپ "خط:"، الف.داده
    بافر_محلی := فرزند_فرآیند.خواندن خط(50)
    سرچاپ "هنوز چیزی نیست:"، بافر_محلی.مهلت تمام شد
    نویسه := فرزند_فرآیند.خواندن خط(2000)
    سرچاپ "خط:"، نویسه.داده
    مقصد_محلی := فرزند_فرآیند.خواندن خط(2000)
    سرچاپ "بسته شد:"، مقصد_محلی.پایان
    الف.آزادسازی()
    بافر_محلی.آزادسازی()
    نویسه.آزادسازی()
    مقصد_محلی.آزادسازی()
    متغیر__status := فرزند_فرآیند.انتظار(2000)
    فرزند_فرآیند.بستن()
    فرمان.آزادسازی()
پایان
