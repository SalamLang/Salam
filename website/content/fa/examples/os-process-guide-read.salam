// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان("echo first; sleep 0.3; echo second")
    cmd.حالت خروجی = فرآیند.لوله
    ناپایا child := فرآیند.اجرای فرزند(cmd)
    a := child.خواندن خط(2000)
    سرچاپ "خط:"، a.داده
    b := child.خواندن خط(50)
    سرچاپ "هنوز چیزی نیست:"، b.مهلت تمام شد
    c := child.خواندن خط(2000)
    سرچاپ "خط:"، c.داده
    d := child.خواندن خط(2000)
    سرچاپ "بسته شد:"، d.پایان
    a.آزادسازی()
    b.آزادسازی()
    c.آزادسازی()
    d.آزادسازی()
    _status := child.انتظار(2000)
    child.بستن()
    cmd.آزادسازی()
پایان
