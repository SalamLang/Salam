// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع describe(script: رشته):
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان(script)
    ناپایا child := فرآیند.اجرای فرزند(cmd)
    st := child.انتظار(2000)
    اگر st.خارج شد:
        سرچاپ "با کد خارج شد"، st.کد
    وگرنه st.سیگنال خورد:
        سرچاپ "با سیگنال کشته شد"، st.سیگنال
    پایان
    child.بستن()
    cmd.آزادسازی()
پایان

تابع ریشه:
    describe("exit 3")
    describe("kill -TERM $$")
    describe("kill -KILL $$")
پایان
