// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع توصیف(متغیر_script: رشته):
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان(متغیر_script)
    ناپایا فرزند_فرآیند := فرآیند.اجرای فرزند(فرمان)
    سبک_متن := فرزند_فرآیند.انتظار(2000)
    اگر سبک_متن.خارج شد:
        سرچاپ "با کد خارج شد"، سبک_متن.کد
    وگرنه سبک_متن.سیگنال خورد:
        سرچاپ "با سیگنال کشته شد"، سبک_متن.سیگنال
    پایان
    فرزند_فرآیند.بستن()
    فرمان.آزادسازی()
پایان

تابع ریشه:
    توصیف("exit 3")
    توصیف("kill -TERM $$")
    توصیف("kill -KILL $$")
پایان
