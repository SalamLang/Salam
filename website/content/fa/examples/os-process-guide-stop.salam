واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("30")
    ناپایا کارگر := فرآیند.شروع("sleep"، آرگ)
    سرچاپ "شروع شد، در حال اجرا:"، فرآیند.در حال اجرا(کارگر)
    اگر فرآیند.پایان دادن(کارگر) != ۰:
        سرچاپ "نتوانستم به آن علامت بفرستم"
        برگشت ۱
    پایان
    کد := فرآیند.انتظار(کارگر)
    سرچاپ "با کد خروج"، کد، "متوقف شد = 128 + علامت"، کد - ۱۲۸
    سرچاپ "در حال اجرا:"، فرآیند.در حال اجرا(کارگر)
    برگشت ۰
پایان
