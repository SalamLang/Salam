// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا آرگومان‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگومان‌ها.آزادکن()
    آرگومان‌ها.بیفزا("-c")
    آرگومان‌ها.بیفزا("cat; echo done")
    ناپایا موفق := فرآیند.اجرا با مهلت("sh"، آرگومان‌ها، "from stdin\n"، 2000)
    چاپ موفق.خروجی
    سرچاپ "مهلت تمام شد:"، موفق.مهلت تمام شد
    موفق.آزادسازی()

    ناپایا آرگومان_معلق := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگومان_معلق.آزادکن()
    آرگومان_معلق.بیفزا("-c")
    آرگومان_معلق.بیفزا("sleep 30")
    ناپایا معلق := فرآیند.اجرا با مهلت("sh"، آرگومان_معلق، ""، 200)
    سرچاپ "مهلت تمام شد:"، معلق.مهلت تمام شد، "کد بازگشت:"، معلق.وضعیت.کد بازگشت()
    معلق.آزادسازی()
پایان
