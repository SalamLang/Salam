// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا args := وکتور {} برگردان وکتور<رشته>
    دیرکن args.آزادکن()
    args.بیفزا("-c")
    args.بیفزا("cat; echo done")
    ناپایا ok := فرآیند.اجرا با مهلت("sh"، args، "from stdin\n"، 2000)
    چاپ ok.خروجی
    سرچاپ "مهلت تمام شد:"، ok.مهلت تمام شد
    ok.آزادسازی()

    ناپایا hang_args := وکتور {} برگردان وکتور<رشته>
    دیرکن hang_args.آزادکن()
    hang_args.بیفزا("-c")
    hang_args.بیفزا("sleep 30")
    ناپایا hang := فرآیند.اجرا با مهلت("sh"، hang_args، ""، 200)
    سرچاپ "مهلت تمام شد:"، hang.مهلت تمام شد، "کد بازگشت:"، hang.وضعیت.کد بازگشت()
    hang.آزادسازی()
پایان
