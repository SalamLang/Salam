// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("cat")
    ناپایا پایانه := پایانه مجازی.باز کردن(فرمان، 24، 80)
    پایانه.نوشتن("typed on a terminal\r")
    پژواک_شده := پایانه.خواندن برای متن("terminal\r\n"، 2000)
    سرچاپ "پایانه آن را بازتاباند:"، وارونه پژواک_شده.مهلت تمام شد
    پژواک_شده.آزادسازی()
    پاسخ_متن := پایانه.خواندن برای متن("terminal\r\n"، 2000)
    سرچاپ "cat پاسخ داد:"، وارونه پاسخ_متن.مهلت تمام شد
    پاسخ_متن.آزادسازی()
    پایانه.بستن ورودی()
    سرچاپ "خروج:"، پایانه.انتظار(2000).کد
    پایانه.بستن()
    فرمان.آزادسازی()
پایان
