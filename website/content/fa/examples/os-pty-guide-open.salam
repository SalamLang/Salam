// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("cat")
    ناپایا term := پایانه مجازی.باز کردن(cmd، 24، 80)
    term.نوشتن("typed on a terminal\r")
    echoed := term.خواندن برای متن("terminal\r\n"، 2000)
    سرچاپ "پایانه آن را بازتاباند:"، وارونه echoed.مهلت تمام شد
    echoed.آزادسازی()
    answer := term.خواندن برای متن("terminal\r\n"، 2000)
    سرچاپ "cat پاسخ داد:"، وارونه answer.مهلت تمام شد
    answer.آزادسازی()
    term.بستن ورودی()
    سرچاپ "خروج:"، term.انتظار(2000).کد
    term.بستن()
    cmd.آزادسازی()
پایان
