// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان("printf 'name? '; read name; echo \"hi $name\"")
    ناپایا پایانه := پایانه مجازی.باز کردن(فرمان، 24، 80)
    پرسش_متن := پایانه.خواندن برای متن("name? "، 2000)
    سرچاپ "پرسش دیده شد:"، وارونه پرسش_متن.مهلت تمام شد
    پرسش_متن.آزادسازی()
    پایانه.نوشتن("Sara\r")
    پاسخ_فرآیند := پایانه.خواندن برای متن("hi Sara"، 2000)
    سرچاپ "پاسخ دیده شد:"، وارونه پاسخ_فرآیند.مهلت تمام شد
    پاسخ_فرآیند.آزادسازی()
    سرچاپ "خروج:"، پایانه.انتظار(2000).کد
    پایانه.بستن()
    فرمان.آزادسازی()
پایان
