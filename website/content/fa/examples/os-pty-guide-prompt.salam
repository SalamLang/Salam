// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان("printf 'name? '; read name; echo \"hi $name\"")
    ناپایا term := پایانه مجازی.باز کردن(cmd، 24، 80)
    ask := term.خواندن برای متن("name? "، 2000)
    سرچاپ "پرسش دیده شد:"، وارونه ask.مهلت تمام شد
    ask.آزادسازی()
    term.نوشتن("Sara\r")
    reply := term.خواندن برای متن("hi Sara"، 2000)
    سرچاپ "پاسخ دیده شد:"، وارونه reply.مهلت تمام شد
    reply.آزادسازی()
    سرچاپ "خروج:"، term.انتظار(2000).کد
    term.بستن()
    cmd.آزادسازی()
پایان
