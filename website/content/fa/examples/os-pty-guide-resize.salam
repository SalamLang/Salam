// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان("stty size; read x; stty size")
    ناپایا term := پایانه مجازی.باز کردن(cmd، 24، 80)
    first := term.خواندن برای متن("24 80"، 2000)
    سرچاپ "اندازه‌ی نخست دیده شد:"، وارونه first.مهلت تمام شد
    first.آزادسازی()
    سرچاپ "تغییر اندازه:"، پایانه مجازی.تغییر اندازه(term، 50، 132)
    term.نوشتن("\r")
    second := term.خواندن برای متن("50 132"، 2000)
    سرچاپ "اندازه‌ی دوم دیده شد:"، وارونه second.مهلت تمام شد
    second.آزادسازی()
    سرچاپ "خروج:"، term.انتظار(2000).کد
    term.بستن()
    cmd.آزادسازی()
پایان
