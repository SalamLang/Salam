// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان("stty size; read x; stty size")
    ناپایا پایانه := پایانه مجازی.باز کردن(فرمان، 24، 80)
    نخستین := پایانه.خواندن برای متن("24 80"، 2000)
    سرچاپ "اندازه‌ی نخست دیده شد:"، وارونه نخستین.مهلت تمام شد
    نخستین.آزادسازی()
    سرچاپ "تغییر اندازه:"، پایانه مجازی.تغییر اندازه(پایانه، 50، 132)
    پایانه.نوشتن("\r")
    دومی := پایانه.خواندن برای متن("50 132"، 2000)
    سرچاپ "اندازه‌ی دوم دیده شد:"، وارونه دومی.مهلت تمام شد
    دومی.آزادسازی()
    سرچاپ "خروج:"، پایانه.انتظار(2000).کد
    پایانه.بستن()
    فرمان.آزادسازی()
پایان
