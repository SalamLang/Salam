واردسازی سیستم عامل.پوسته

تابع آزمودن(فرمان: رشته):
    ن := پوسته.اجرا با متن فرمان(فرمان)
    اگر ن.کد == ۰:
        سرچاپ "موفق:"، فرمان
        برگشت
    پایان
    سرچاپ "ناموفق:"، فرمان، "با کد"، ن.کد
    سرچاپ "  پیام خطا دارد:"، ن.خروجی خطا.طول() > ۰
پایان

تابع ریشه:
    آزمودن("ls .")
    آزمودن("ls no-such-folder")
    سرچاپ "کد خروج false:"، پوسته.اجرای پوسته("false")
پایان
