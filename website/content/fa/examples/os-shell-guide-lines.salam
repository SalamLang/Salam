واردسازی سیستم عامل
واردسازی سیستم عامل.پوسته

تابع ریشه:
    سیستم عامل.نوشتن پرونده("خرید.csv"، "1,2\n")
    سیستم عامل.نوشتن پرونده("فروش.csv"، "3,4\n")
    سیستم عامل.نوشتن پرونده("یادداشت.txt"، "سلام\n")
    ن := پوسته.اجرا با متن فرمان("ls")
    ناپایا شمار := ۰
    هر نام در ن.خروجی.پیراست().بشکاف("\n"):
        اگر نام.ختم با(".csv"):
            سرچاپ "پیدا شد:"، نام
            شمار += ۱
        پایان
    پایان
    سرچاپ شمار، "پرونده‌ی csv"
    سیستم عامل.حذف("خرید.csv")
    سیستم عامل.حذف("فروش.csv")
    سیستم عامل.حذف("یادداشت.txt")
پایان
