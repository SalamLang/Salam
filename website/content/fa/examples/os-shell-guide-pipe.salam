واردسازی سیستم عامل.پوسته

تابع اسکریپت(متن: رشته): پوسته.نتیجه فرمان:
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("-c")
    آرگ.بیفزا(متن)
    برگشت پوسته.اجرا("sh"، آرگ)
پایان

تابع ریشه:
    ن := اسکریپت("printf 'سرخ\\nآبی\\nسرخ\\nسبز\\nسرخ\\n' | sort | uniq -c | sort -rn | head -n 1")
    اگر ن.code != ۰:
        سرچاپ "لوله شکست خورد:"، ن.err
        برگشت ۰
    پایان
    سرچاپ "پرتکرارترین:"، ن.out.پیراست()
    ن۲ := اسکریپت("echo ذخیره شد > یادداشت.txt && cat یادداشت.txt && rm یادداشت.txt")
    سرچاپ ن۲.code، ن۲.out.پیراست()
پایان
