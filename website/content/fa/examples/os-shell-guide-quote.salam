واردسازی سیستم عامل.پوسته

تابع ریشه:
    ن := پوسته.اجرا با متن فرمان("echo 'دو واژه'")
    سرچاپ "اجرا با متن فرمان:"، ن.خروجی.پیراست()
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("دو واژه")
    ن۲ := پوسته.اجرا("echo"، آرگ)
    سرچاپ "اجرا:"، ن۲.خروجی.پیراست()
    ناپایا اسکریپت := وکتور {} برگردان وکتور<رشته>
    دیرکن اسکریپت.آزادکن()
    اسکریپت.بیفزا("-c")
    اسکریپت.بیفزا("echo 'دو واژه'")
    ن۳ := پوسته.اجرا("sh"، اسکریپت)
    سرچاپ "sh -c:"، ن۳.خروجی.پیراست()
پایان
