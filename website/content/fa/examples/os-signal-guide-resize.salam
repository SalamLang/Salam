// زبان: فارسی
واردسازی حافظه
واردسازی سیستم عامل.سیگنال

تابع ریشه:
    اگر وارونه سیگنال.تغییر اندازه پشتیبانی می شود():
        سرچاپ "این‌جا SIGWINCH نیست: به جایش اندازه پایانه را بپرسید"
        برگشت 0
    پایان
    قبلی := سیگنال.نصب گرداننده تغییر اندازه()
    اگر قبلی برابر پوچ:
        سرچاپ "گرداننده نصب نشد"
        برگشت 1
    پایان
    مجموعه := سیگنال.مجموعه تغییر اندازه جدید()
    خروجی := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)
    سرچاپ "هنوز چیزی نیامده:"، سیگنال.انتظار با مهلت(مجموعه، خروجی، 100) برابر سیگنال.نتیجه اتمام مهلت
    _ := سیگنال.بیدار کردن تغییر اندازه()
    سرچاپ "پس از تغییر اندازه:"، سیگنال.انتظار با مهلت(مجموعه، خروجی، 1000) برابر سیگنال.نتیجه رسیدن
    سرچاپ "شماره سیگنال:"، (خروجی برگردان صحیح۳۲*)[0]
    حافظه.آزادسازی(خروجی)
    حافظه.آزادسازی(مجموعه)
    سرچاپ "بازگردانده شد:"، سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، قبلی)
    حافظه.آزادسازی(قبلی)
    برگشت 0
پایان
