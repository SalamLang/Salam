// زبان: فارسی
واردسازی حافظه
واردسازی سیستم عامل.سیگنال

تابع ریشه:
    توقف := سیگنال.مجموعه جدید()
    دیرکن حافظه.آزادسازی(توقف)
    _ := سیگنال.افزودن سیگنال(توقف، سیگنال.سیگنال وقفه)
    _ := سیگنال.افزودن سیگنال(توقف، سیگنال.سیگنال خاتمه)
    اگر وارونه سیگنال.مسدود کردن(توقف):
        سرچاپ "سیگنال‌های توقف مسدود نشدند"
        برگشت 1
    پایان
    سرچاپ "در حال کار؛ برای توقف Ctrl+C بزنید یا kill را اجرا کنید"
    _ := سیگنال.فرستادن به خود(سیگنال.سیگنال خاتمه)
    سیگ := سیگنال.انتظار سیگنال(توقف)
    اگر سیگ برابر سیگنال.سیگنال وقفه:
        سرچاپ "Ctrl+C: ذخیره و خروج"
    وگرنه سیگ برابر سیگنال.سیگنال خاتمه:
        سرچاپ "SIGTERM: ذخیره و خروج"
    وگرنه:
        سرچاپ "انتظار ناموفق بود با وضعیت"، سیگ
        برگشت 1
    پایان
    برگشت 0
پایان
