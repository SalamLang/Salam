// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی اتمی
واردسازی سیستم عامل.سیگنال

ناپایا توقف‌شدن := اتمی.پرچم جدید(نادرست)

تابع کارگر(_ورودی: تهی*):
    تا وارونه اتمی.گرفتن(توقف‌شدن):
        همگام سازی.خواب میلی ثانیه(10)
    پایان
    سرچاپ "کارگر درخواست توقف را دید"
پایان

تابع ریشه:
    توقف := سیگنال.مجموعه جدید()
    دیرکن حافظه.آزادسازی(توقف)
    _ := سیگنال.افزودن سیگنال(توقف، سیگنال.سیگنال خاتمه)
    _ := سیگنال.مسدود کردن(توقف)
    نخ := نخ‌ساز(کارگر، پوچ)
    _ := سیگنال.فرستادن به خود(سیگنال.سیگنال خاتمه)
    سرچاپ "ریشه سیگنال گرفت"، سیگنال.انتظار سیگنال(توقف)
    اتمی.تنظیم(توقف‌شدن، درست)
    نخ‌پیوند(نخ)
    اتمی.نابودسازی پرچم(توقف‌شدن)
    سرچاپ "خروج تمیز"
پایان
