واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده
واردسازی سیستم پرونده.مسیر
واردسازی سیستم عامل.موقت

تابع ریشه:
    کارگاه := موقت.پوشه موقت()
    اگر کارگاه == "":
        سرچاپ "پوشه‌ی کار ساخته نشد"
        برگشت ۱
    پایان
    دیرکن موقت.حذف پوشه(کارگاه)
    سیستم پرونده.نوشتن متن(مسیر.پیوند(کارگاه، "تکه ۱.txt")، "سلام ")
    سیستم پرونده.نوشتن متن(مسیر.پیوند(کارگاه، "تکه ۲.txt")، "دنیا\n")
    ناپایا متن کامل := ""
    هر نام در ["تکه ۱.txt"، "تکه ۲.txt"]:
        متن کامل += سیستم پرونده.خواندن متن(مسیر.پیوند(کارگاه، نام))
    پایان
    چاپ متن کامل
    سرچاپ پوشه.فهرست پرونده ها(کارگاه).طول()، "تکه،"، پوشه.اندازه(کارگاه)، "بایت"
    برگشت ۰
پایان
