واردسازی سیستم پرونده
واردسازی سیستم عامل.موقت

تابع ریشه:
    پیش نویس := موقت.پرونده موقت()
    سیستم پرونده.افزودن(پیش نویس، "شناسه,نام\n")
    سیستم پرونده.افزودن(پیش نویس، "1,سارا\n")
    سیستم پرونده.افزودن(پیش نویس، "2,رضا\n")
    سطرها := سیستم پرونده.خواندن خط‌ها(پیش نویس)
    سرچاپ سطرها.طول()، "خط آماده شد"
    اگر سیستم پرونده.کپی(پیش نویس، "افراد.csv") == ۰:
        سرچاپ "افراد.csv منتشر شد،"، سیستم پرونده.اندازه("افراد.csv")، "بایت"
    پایان
    موقت.حذف(پیش نویس)
    سرچاپ "پیش‌نویس باقی ماند:"، سیستم پرونده.وجود دارد(پیش نویس)
    چاپ سیستم پرونده.خواندن متن("افراد.csv")
    سیستم پرونده.حذف("افراد.csv")
پایان
