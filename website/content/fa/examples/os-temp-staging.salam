واردسازی سیستم پرونده.پرونده
واردسازی سیستم عامل.موقت

تابع ریشه:
    پیش نویس := موقت.پرونده موقت()
    پرونده.افزودن(پیش نویس، "شناسه,نام\n")
    پرونده.افزودن(پیش نویس، "1,سارا\n")
    پرونده.افزودن(پیش نویس، "2,رضا\n")
    سطرها := پرونده.خواندن خط‌ها(پیش نویس)
    سرچاپ سطرها.طول()، "خط آماده شد"
    اگر پرونده.کپی(پیش نویس، "افراد.csv") == ۰:
        سرچاپ "افراد.csv منتشر شد،"، پرونده.اندازه("افراد.csv")، "بایت"
    پایان
    موقت.حذف(پیش نویس)
    سرچاپ "پیش‌نویس باقی ماند:"، پرونده.وجود دارد(پیش نویس)
    چاپ پرونده.خواندن متن("افراد.csv")
    پرونده.حذف("افراد.csv")
پایان
