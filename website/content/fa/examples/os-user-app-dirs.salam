واردسازی محیط
واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده.پرونده
واردسازی سیستم پرونده.مسیر
واردسازی سیستم عامل
واردسازی سیستم عامل.کاربر

تابع ریشه:
    محیط.تنظیم("HOME"، مسیر.پیوند(سیستم عامل.پوشه جاری()، "demo-home"))
    محیط.حذف("XDG_CONFIG_HOME")
    محیط.حذف("XDG_CACHE_HOME")
    پیکربندی := مسیر.پیوند(کاربر.پوشه پیکربندی()، "notes")
    انبار := مسیر.پیوند(کاربر.پوشه حافظه پنهان()، "notes")
    پوشه.ساخت پوشه ها(پیکربندی)
    پوشه.ساخت پوشه ها(انبار)
    تنظیمات := مسیر.پیوند(پیکربندی، "settings.ini")
    تکرار ۲ در دور:
        اگر پرونده.وجود دارد(تنظیمات):
            سرچاپ "اجرای"، دور + ۱، "پیدا کرد:"، پرونده.خواندن متن(تنظیمات).پیراست()
        وگرنه:
            پرونده.نوشتن متن(تنظیمات، "theme=dark\n")
            سرچاپ "اجرای"، دور + ۱، "تنظیمات پیش‌فرض را نوشت"
        پایان
    پایان
    پرونده.نوشتن متن(مسیر.پیوند(انبار، "index.bin")، "0123456789")
    سرچاپ "جای تنظیمات: ~/" + مسیر.مسیر نسبی(کاربر.پوشه خانگی()، تنظیمات)
    سرچاپ "حافظه‌ی پنهان"، پوشه.اندازه(انبار)، "بایت دارد"
    پوشه.حذف همه(کاربر.پوشه خانگی())
پایان
