واردسازی رشته

تابع گسترش(پ: رشته): رشته:
    اگر پ == "~": برگشت کاربر.پوشه خانگی() پایان
    اگر رشته.شروع با(پ، "~/"):
        برگشت مسیر.پیوند(کاربر.پوشه خانگی()، پ.زیررشته(۲، پ.طول() - ۲))
    پایان
    برگشت پ
پایان

تابع ریشه:
    محیط.تنظیم("HOME"، "/home/sara")
    هر پ در ["~"، "~/notes/today.md"، "/etc/hosts"، "reports/may.csv"]:
        سرچاپ پ، "->"، گسترش(پ)
    پایان
پایان
