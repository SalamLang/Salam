واردسازی محیط
واردسازی سیستم عامل.کاربر

تابع ریشه:
    محیط.تنظیم("HOME"، "/home/sara")
    محیط.حذف("XDG_CONFIG_HOME")
    محیط.حذف("XDG_CACHE_HOME")
    سرچاپ "خانه:"، کاربر.پوشه خانگی()
    سرچاپ "پیکربندی:"، کاربر.پوشه پیکربندی()
    سرچاپ "حافظه پنهان:"، کاربر.پوشه حافظه پنهان()
    محیط.تنظیم("XDG_CONFIG_HOME"، "/data/sara/config")
    محیط.تنظیم("XDG_CACHE_HOME"، "/fast-disk/cache")
    سرچاپ "پیکربندی:"، کاربر.پوشه پیکربندی()
    سرچاپ "حافظه پنهان:"، کاربر.پوشه حافظه پنهان()
پایان
