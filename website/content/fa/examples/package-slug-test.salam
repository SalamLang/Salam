واردسازی آزمایش

فراخوانی slug "package-slug.salam"

تابع آزمون_ساخت():
    آزمایش.ادعای برابری رشته(slug.بساز("Hello, World!")، "hello-world")
    آزمایش.ادعای برابری رشته(slug.بساز("  Salam   Lang  ")، "salam-lang")
    آزمایش.ادعای برابری رشته(slug.بساز("")، "")
پایان

تابع آزمون_ساخت_بیشینه():
    آزمایش.ادعای برابری رشته(slug.بساز با سقف("Packages in Salam are simple"، 14)، "packages-in-sa")
پایان
