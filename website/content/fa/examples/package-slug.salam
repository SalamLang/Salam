بسته slug

واردسازی رشته

پایا مجاز := "abcdefghijklmnopqrstuvwxyz0123456789"

تابع حرف است(تکه: رشته): منطقی:
    برگشت رشته.شامل است(مجاز، تکه)
پایان

@en "Make"
@fa "بساز"
همگانی تابع بساز(متن: رشته): رشته:
    کوچک := رشته.کوچک(متن)
    ناپایا خروجی := ""
    ناپایا خط تیره := نادرست
    تکرار رشته.طول(کوچک) در ا:
        تکه := رشته.زیررشته(کوچک، ا، 1)
        اگر حرف است(تکه):
            خروجی = خروجی + تکه
            خط تیره = نادرست
        وگرنه اگر وارونه خط تیره و رشته.طول(خروجی) > 0:
            خروجی = خروجی + "-"
            خط تیره = درست
        پایان
    پایان
    برگشت رشته.حذف پسوند(خروجی، "-")
پایان

@en "MakeMax"
@fa "بساز با سقف"
همگانی تابع بساز با سقف(متن: رشته، سقف: صحیح): رشته:
    کامل := بساز(متن)
    اگر رشته.طول(کامل) <= سقف:
        برگشت کامل
    پایان
    برگشت رشته.حذف پسوند(رشته.زیررشته(کامل، 0، سقف)، "-")
پایان
