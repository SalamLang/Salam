واردسازی کدگذاری.جیسون

روال ریشه:
    سفارش := `{"id": 42, "item": "دفتر", "qty": 3}`
    اگر وارونه جیسون.معتبر(سفارش):
        سرچاپ "جیسون معتبر نیست"
        برگشت ۱
    پایان
    سرچاپ "سفارش"، جیسون.دریافت عدد(سفارش، "id")
    سرچاپ جیسون.دریافت عدد(سفارش، "qty")، "عدد"، جیسون.دریافت(سفارش، "item")
    سرچاپ جیسون.دارد(سفارش، "coupon")
پایان
