واردسازی استخر
واردسازی حافظه
واردسازی رشته

ناپایا پیکسل‌ها := پوچ برگردان صحیح*
پهنا := ۸
بلندا := ۶

تابع روشن کردن سطر(ع: صحیح۶۴):
    تکرار پهنا در س:
        ای := (ع برگردان صحیح) * پهنا + س
        ناپایا م := پیکسل‌ها[ای] + ۶۰
        اگر م > ۲۵۵:
            م = ۲۵۵
        پایان
        پیکسل‌ها[ای] = م
    پایان
پایان

تابع ریشه:
    پیکسل‌ها = حافظه.تخصیص صفرشده(اندازه‌گونه(صحیح) * ((پهنا * بلندا) برگردان طبیعی۶۴)) برگردان صحیح*
    تکرار پهنا * بلندا در ای:
        پیکسل‌ها[ای] = (ای * ۳۷) % ۲۵۶
    پایان
    استخر.برای موازی(بلندا، ۳، (ع: صحیح۶۴): روشن کردن سطر(ع) پایان)
    تکرار بلندا در ع:
        ناپایا خط := ""
        تکرار پهنا در س:
            خط = خط + رشته.از عدد(پیکسل‌ها[ع * پهنا + س]) + " "
        پایان
        سرچاپ خط.پیراست()
    پایان
    حافظه.آزادسازی(پیکسل‌ها برگردان تهی*)
پایان
