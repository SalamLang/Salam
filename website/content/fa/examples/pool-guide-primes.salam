واردسازی استخر
واردسازی اتمی

ناپایا پیداشده := اتمی.صحیح۶۴ {}

تابع اول است(ع: صحیح۶۴): منطقی:
    اگر ع < ۲:
        برگشت نادرست
    پایان
    ناپایا م := ۲ برگردان صحیح۶۴
    تا م * م <= ع:
        اگر ع % م == ۰:
            برگشت نادرست
        پایان
        م += ۱
    پایان
    برگشت درست
پایان

تابع ریشه:
    پیداشده = اتمی.صحیح۶۴ جدید(۰)
    استخر.برای موازی(۱۰۰۰۰۰، استخر.تعداد پردازنده()، (ع: صحیح۶۴):
        اگر اول است(ع):
            اتمی.افزودن(پیداشده، ۱)
        پایان
    پایان)
    سرچاپ "عددهای اول کوچک‌تر از ۱۰۰۰۰۰:"، اتمی.بارگذاری(پیداشده)
    اتمی.نابودسازی صحیح۶۴(پیداشده)
پایان
