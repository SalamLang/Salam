واردسازی تصادفی
واردسازی رشته

پایا الفبا := "ABCDEFGHJKLMNPQRSTUVWXYZ23456789"

تابع کد تخفیف(گروه‌ها: صحیح): رشته:
    ناپایا بخش‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن بخش‌ها.آزادکن()
    تکرار گروه‌ها:
        بخش‌ها.بیفزا(تصادفی.متن از(۴، الفبا))
    پایان
    برگشت رشته.بپیوند(بخش‌ها، "-")
پایان

تابع فقط از(متن: رشته، مجاز: رشته): منطقی:
    تکرار متن.طول() در ی:
        اگر رشته.شامل است(مجاز، متن.زیررشته(ی، ۱)) برابر نادرست: برگشت نادرست پایان
    پایان
    برگشت درست
پایان

تابع ریشه:
    تصادفی.بذر خودکار()
    کد := کد تخفیف(۳)
    سرچاپ "کد تخفیف:"، کد.طول()، "نویسه، خط‌تیره‌ها:"، کد.زیررشته(۴، ۱) + کد.زیررشته(۹، ۱)
    سرچاپ "بدون 0، O، 1 و I:"، فقط از(رشته.جایگزینی(کد، "-"، "")، الفبا)
    پیامکی := تصادفی.رقم(۶)
    سرچاپ "کد پیامکی:"، پیامکی.طول()، "رقم،"، فقط از(پیامکی، "0123456789")
    رمز := تصادفی.عدد با طول(۴)
    سرچاپ "رمز میان ۱۰۰۰ و ۹۹۹۹:"، رمز بزرگتربرابر ۱۰۰۰ و رمز کوچکتربرابر ۹۹۹۹
    سرچاپ "نسخه‌ی شناسه‌ی یکتا:"، تصادفی.شناسه یکتا().زیررشته(۱۴، ۱)
پایان
