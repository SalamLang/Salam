واردسازی تصادفی

تابع انتخاب وزن‌دار(نام‌ها: وکتور<رشته>، وزن‌ها: وکتور<اعشار۶۴>): رشته:
    ناپایا مجموع := ۰.۰
    هر وزن در وزن‌ها:
        مجموع += وزن
    پایان
    ناپایا ع := تصادفی.اعشار در بازه(۰.۰، مجموع)
    تکرار نام‌ها.طول() در ی:
        ع -= وزن‌ها.بگیر(ی)
        اگر ع کوچکتر ۰.۰: برگشت نام‌ها.بگیر(ی) پایان
    پایان
    برگشت نام‌ها.بگیر(نام‌ها.طول() - ۱)
پایان

تابع ریشه:
    تصادفی.بذر(۹۹)
    ناپایا شرکت‌کنندگان := وکتور {} برگردان وکتور<رشته>
    دیرکن شرکت‌کنندگان.آزادکن()
    هر نام در ["علی"، "سارا"، "رضا"، "مینا"، "امید"، "ندا"]:
        شرکت‌کنندگان.بیفزا(نام)
    پایان
    ناپایا ترتیب := تصادفی.بهم ریختن رشته(شرکت‌کنندگان)
    دیرکن ترتیب.آزادکن()
    برندگان := [ترتیب.بگیر(۰)، ترتیب.بگیر(۱)، ترتیب.بگیر(۲)]
    سرچاپ "۳ برنده، همه متفاوت:"، برندگان[۰] != برندگان[۱] و برندگان[۱] != برندگان[۲] و برندگان[۰] != برندگان[۲]
    سرچاپ "فهرست اصلی دست نخورده:"، شرکت‌کنندگان.بگیر(۰)، شرکت‌کنندگان.طول()
    ناپایا جایزه‌ها := وکتور {} برگردان وکتور<رشته>
    ناپایا وزن‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    دیرکن جایزه‌ها.آزادکن()
    دیرکن وزن‌ها.آزادکن()
    جایزه‌ها.بیفزا("معمولی")
    وزن‌ها.بیفزا(۸۰.۰)
    جایزه‌ها.بیفزا("کمیاب")
    وزن‌ها.بیفزا(۱۸.۰)
    جایزه‌ها.بیفزا("افسانه‌ای")
    وزن‌ها.بیفزا(۲.۰)
    ناپایا کمیاب := ۰
    ناپایا افسانه‌ای := ۰
    تکرار ۱۰۰۰۰:
        جایزه := انتخاب وزن‌دار(جایزه‌ها، وزن‌ها)
        اگر جایزه برابر "کمیاب": کمیاب += ۱ پایان
        اگر جایزه برابر "افسانه‌ای": افسانه‌ای += ۱ پایان
    پایان
    سرچاپ "جایزه‌ی کمیاب نزدیک ۱۸۰۰:"، کمیاب بزرگتر ۱۶۰۰ و کمیاب کوچکتر ۲۰۰۰
    سرچاپ "جایزه‌ی افسانه‌ای نزدیک ۲۰۰:"، افسانه‌ای بزرگتر ۱۲۰ و افسانه‌ای کوچکتر ۲۸۰
پایان
