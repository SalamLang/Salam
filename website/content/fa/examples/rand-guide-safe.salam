واردسازی تصادفی
واردسازی ریاضی
واردسازی رشته

تابع انتخاب(فهرست: وکتور<رشته>، جایگزین: رشته): رشته:
    اگر فهرست.طول() برابر ۰: برگشت جایگزین پایان
    برگشت تصادفی.انتخاب رشته(فهرست)
پایان

تابع میان(الف: صحیح۶۴، ب: صحیح۶۴): صحیح۶۴:
    برگشت تصادفی.عدد در بازه(ریاضی.کمینه صحیح۶۴(الف، ب)، ریاضی.بیشینه صحیح۶۴(الف، ب))
پایان

تابع ریشه:
    تصادفی.بذر خودکار()
    ناپایا هیچ‌کس := وکتور {} برگردان وکتور<رشته>
    دیرکن هیچ‌کس.آزادکن()
    سرچاپ "فهرست خالی:"، انتخاب(هیچ‌کس، "هیچ‌کس")
    ن := میان(۱۰ برگردان صحیح۶۴، ۱ برگردان صحیح۶۴)
    سرچاپ "مرزهای وارونه هم کار می‌کنند:"، ن بزرگتربرابر ۱ و ن کوچکتربرابر ۱۰
    واژه := "سلام"
    سرچاپ "تعداد بایت‌های"، واژه + ":"، واژه.طول()
    ناپایا حرف‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن حرف‌ها.آزادکن()
    هر حرف در ["س"، "ل"، "ا"، "م"]:
        حرف‌ها.بیفزا(حرف)
    پایان
    سرچاپ "یک حرف کامل:"، انتخاب(حرف‌ها، "").طول() برابر ۲
    ناپایا درهم := تصادفی.بهم ریختن رشته(حرف‌ها)
    دیرکن درهم.آزادکن()
    سرچاپ "واژه‌ی درهم همه‌ی حرف‌ها را دارد:"، رشته.بپیوند(درهم، "").طول() برابر واژه.طول()
پایان
