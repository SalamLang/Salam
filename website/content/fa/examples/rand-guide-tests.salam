واردسازی تصادفی

تابع پرتاب تاس(بذر: صحیح۶۴، تعداد: صحیح): وکتور<صحیح>:
    تصادفی.بذر(بذر)
    ناپایا نتیجه := وکتور {} برگردان وکتور<صحیح>
    تکرار تعداد:
        نتیجه.بیفزا(تصادفی.عدد۳۲بیتی در بازه(۱، ۶))
    پایان
    برگشت نتیجه
پایان

تابع یکسان(الف: وکتور<صحیح>، ب: وکتور<صحیح>): منطقی:
    اگر الف.طول() != ب.طول(): برگشت نادرست پایان
    تکرار الف.طول() در ی:
        اگر الف.بگیر(ی) != ب.بگیر(ی): برگشت نادرست پایان
    پایان
    برگشت درست
پایان

تابع ریشه:
    ناپایا اول := پرتاب تاس(۲۰۲۶، ۲۰)
    ناپایا دوم := پرتاب تاس(۲۰۲۶، ۲۰)
    ناپایا دیگری := پرتاب تاس(۷، ۲۰)
    دیرکن اول.آزادکن()
    دیرکن دوم.آزادکن()
    دیرکن دیگری.آزادکن()
    سرچاپ "بذر یکسان، پرتاب‌های یکسان:"، یکسان(اول، دوم)
    سرچاپ "بذر دیگر، پرتاب‌های یکسان:"، یکسان(اول، دیگری)
پایان
