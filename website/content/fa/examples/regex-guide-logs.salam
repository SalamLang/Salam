واردسازی عبارت باقاعده

تابع ریشه:
    خط‌ها := ["2026-10-01 12:00:01 INFO server started on :8080"،
        "2026-10-01 12:00:07 WARN slow query took 1200ms"،
        "2026-10-01 12:01:13 ERROR db: connection refused"،
        "این خط گزارش نیست"،
        "2026-10-01 12:02:40 ERROR db: connection refused"]
    الگو := عبارت باقاعده.کامپایل("^(?P<date>[0-9-]+) (?P<time>[0-9:]+) (?P<level>[A-Z]+) (?P<msg>.*)$")
    شمار := نگاشت {} برگردان نگاشت<رشته، صحیح>
    هر خط در خط‌ها:
        ت := عبارت باقاعده.یافتن تطبیق(الگو، خط)
        اگر وارونه ت.موفق:
            سرچاپ "رد شد:"، خط
            گذر
        پایان
        سطح := عبارت باقاعده.گروه با نام(ت، "level")
        اگر شمار.دارد(سطح):
            شمار.درج(سطح، شمار.بگیر(سطح) + ۱)
        وگرنه:
            شمار.درج(سطح، ۱)
        پایان
        اگر سطح برابر "ERROR":
            سرچاپ عبارت باقاعده.گروه با نام(ت، "time")، عبارت باقاعده.گروه با نام(ت، "msg")
        پایان
    پایان
    سرچاپ "INFO"، شمار.بگیر("INFO")، "WARN"، شمار.بگیر("WARN")، "ERROR"، شمار.بگیر("ERROR")
پایان
