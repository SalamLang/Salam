واردسازی عبارت باقاعده
واردسازی رشته

تابع نمایش(برچسب: رشته، یافته‌ها: وکتور<رشته>):
    سرچاپ برچسب، یافته‌ها.طول()، "|"، رشته.بپیوند(یافته‌ها، "، ")
پایان

تابع ریشه:
    پست := "سفر به #تهران و #اصفهان با #قطار_شبانه"
    نمایش("#\\w+ پیدا می‌کند"، عبارت باقاعده.یافتن همه رشته("#\\w+"، پست))
    نمایش("#[^ ]+ پیدا می‌کند"، عبارت باقاعده.یافتن همه رشته("#[^ ]+"، پست))
    نمایش("هه+ پیدا می‌کند"، عبارت باقاعده.یافتن همه رشته("هه+"، "عالیههههه"))
    نمایش("ه(ه)+ پیدا می‌کند"، عبارت باقاعده.یافتن همه رشته("ه(ه)+"، "عالیههههه"))
    شهر := عبارت باقاعده.یافتن تطبیق رشته("(تهران|اصفهان|شیراز)"، پست)
    سرچاپ "نخستین شهر:"، عبارت باقاعده.گروه(شهر، ۰)، "در بایت"، شهر.آغاز
پایان
