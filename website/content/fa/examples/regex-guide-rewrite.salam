واردسازی عبارت باقاعده

تابع ریشه خطادار:
    متن := "Invoice   2026-10-17,  due 2026-11-01.   Paid:  no"
    مرتب := تلاش عبارت باقاعده.جایگزینی همه رشته("[ \t]+"، متن، " ")
    سرچاپ مرتب
    تاریخ‌ها := تلاش عبارت باقاعده.کامپایل("([0-9]{4})-([0-9]{2})-([0-9]{2})")
    سرچاپ عبارت باقاعده.جایگزینی همه با بسط(تاریخ‌ها، مرتب، "$3/$2/$1")
    سرچاپ عبارت باقاعده.جایگزینی با بسط(تاریخ‌ها، مرتب، "[$0]")
    واژه‌ها := عبارت باقاعده.تفکیک کردن(تلاش عبارت باقاعده.کامپایل("[ ,.:]+")، "red, green.  blue: yellow")
    سرچاپ واژه‌ها.طول()، واژه‌ها
پایان
