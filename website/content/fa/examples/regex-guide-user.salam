واردسازی عبارت باقاعده

تابع جستجو(الگو: رشته، متن: رشته):
    تلاش:
        ع := عبارت باقاعده.کامپایل(الگو)
        یافته‌ها := عبارت باقاعده.یافتن همه تطبیق ها(ع، متن، -۱)
        سرچاپ الگو، "<-"، یافته‌ها.طول()، "مورد"
        هر ت در یافته‌ها:
            سرچاپ "  در"، ت.آغاز، عبارت باقاعده.گروه(ت، ۰)
        پایان
    گرفتن خطا خ:
        سرچاپ "الگوی نادرست:"، الگو، "<-"، خ.پیام، "در بایت"، خ.جایگاه
    پایان
پایان

تابع ریشه:
    متن := "cat catalog concat dog"
    جستجو("cat"، متن)
    جستجو("\\w*cat\\w*"، متن)
    جستجو("[a-z]+og"، متن)
    جستجو("cat("، متن)
    جستجو("[a-z"، متن)
پایان
