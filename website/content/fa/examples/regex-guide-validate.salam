واردسازی عبارت باقاعده

تابع بررسی(نام: رشته، الگو: عبارت باقاعده.عبارت باقاعده، مقدار: رشته):
    اگر عبارت باقاعده.تطبیق(الگو، مقدار):
        سرچاپ نام، مقدار، "درست"
    وگرنه:
        سرچاپ نام، مقدار، "رد شد"
    پایان
پایان

تابع ریشه:
    ایمیل := عبارت باقاعده.کامپایل("^[a-z0-9._]+@[a-z0-9-]+(\\.[a-z0-9-]+)+$")
    موبایل := عبارت باقاعده.کامپایل("^09[0-9]{9}$")
    کد پستی := عبارت باقاعده.کامپایل("^[0-9]{5}-?[0-9]{5}$")
    بررسی("ایمیل"، ایمیل، "sara.k@mail.example.com")
    بررسی("ایمیل"، ایمیل، "sara@localhost")
    بررسی("موبایل"، موبایل، "09121234567")
    بررسی("موبایل"، موبایل، "0912123456")
    بررسی("کد پستی"، کد پستی، "13145-67890")
    بررسی("کد پستی"، کد پستی، "1314567890")
    بررسی("کد پستی"، کد پستی، "13145 67890")
پایان
