واردسازی نتیجه
واردسازی رشته

ساختار نشانی:
    همگانی میزبان: رشته = ""
    همگانی درگاه: صحیح = ۰
پایان

تابع خواندن درگاه(متن: رشته): نتیجه.نتیجه<صحیح، رشته>:
    ع := متن.به صحیح()
    اگر رشته.از عدد(ع) != متن:
        برگشت نتیجه.نتیجه.خطا("درگاه عدد نیست: '" + متن + "'")
    پایان
    اگر ع < ۱ یا ع > ۶۵۵۳۵:
        برگشت نتیجه.نتیجه.خطا("درگاه بیرون از بازه است: " + ع)
    پایان
    برگشت نتیجه.نتیجه.موفق(ع)
پایان

تابع خواندن نشانی(متن: رشته): نتیجه.نتیجه<نشانی، رشته>:
    دونقطه := رشته.آخرین اندیس(متن، ":")
    اگر دونقطه <= ۰:
        برگشت نتیجه.نتیجه.خطا("انتظار میزبان:درگاه می‌رفت، رسید: '" + متن + "'")
    پایان
    درگاه := خواندن درگاه(رشته.زیررشته(متن، دونقطه + ۱، متن.طول() - دونقطه - ۱))?
    برگشت نتیجه.نتیجه.موفق(نشانی { میزبان = رشته.زیررشته(متن، ۰، دونقطه)، درگاه = درگاه })
پایان

تابع ریشه:
    هر متن در ["db.local:5432"، "localhost"، "cache:99999"، "api:http"]:
        همخوان خواندن نشانی(متن):
            موفق(ن): سرچاپ "اتصال به"، ن.میزبان، "روی درگاه"، ن.درگاه پایان
            خطا(پیام): سرچاپ "خطا:"، پیام پایان
        پایان
    پایان
پایان
