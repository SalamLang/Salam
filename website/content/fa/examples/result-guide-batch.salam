واردسازی نتیجه

تابع خواندن نمره(متن: رشته): نتیجه.نتیجه<صحیح، رشته>:
    ع := متن.به صحیح()
    اگر ع == ۰ و متن != "۰":
        برگشت نتیجه.نتیجه.خطا("'" + متن + "' عدد نیست")
    پایان
    اگر ع < ۰ یا ع > ۲۰:
        برگشت نتیجه.نتیجه.خطا(متن + " بیرون از بازه‌ی ۰ تا ۲۰ است")
    پایان
    برگشت نتیجه.نتیجه.موفق(ع)
پایان

تابع ریشه:
    ردیف‌ها := ["۱۸"، "abc"، "۲۰"، "۲۵"، "۰"، "۱۴"]
    ناپایا جمع := ۰
    ناپایا درست‌ها := ۰
    ناپایا خطاها := وکتور {} برگردان وکتور<رشته>
    دیرکن خطاها.آزادکن()
    هر ش، متن در ردیف‌ها:
        همخوان خواندن نمره(متن):
            موفق(ع):
                جمع += ع
                درست‌ها += ۱
            پایان
            خطا(پیام): خطاها.بیفزا("ردیف " + (ش + ۱) + ": " + پیام) پایان
        پایان
    پایان
    سرچاپ درست‌ها، "ردیف درست، میانگین"، جمع / درست‌ها
    هر خ در خطاها:
        سرچاپ خ
    پایان
پایان
