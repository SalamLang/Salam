واردسازی نتیجه

جداشمار ناکامی:
    کاربر ناشناس(نام: رشته)،
    رمز اشتباه(فرصت: صحیح)،
    قفل شده
پایان

تابع ورود(نام: رشته، رمز: رشته، شکست‌ها: صحیح): نتیجه.نتیجه<رشته، ناکامی>:
    اگر نام != "سارا":
        برگشت نتیجه.نتیجه.خطا(ناکامی.کاربر ناشناس(نام))
    پایان
    اگر شکست‌ها >= ۳:
        برگشت نتیجه.نتیجه.خطا(ناکامی.قفل شده)
    پایان
    اگر رمز != "s3cret":
        برگشت نتیجه.نتیجه.خطا(ناکامی.رمز اشتباه(۲ - شکست‌ها))
    پایان
    برگشت نتیجه.نتیجه.موفق("نشانه-" + نام)
پایان

تابع توضیح(خ: ناکامی): رشته:
    برگشت همخوان خ:
        کاربر ناشناس(ن): "حسابی به نام " + ن + " نیست" پایان
        رمز اشتباه(مانده): "رمز نادرست است، " + مانده + " فرصت دیگر دارید" پایان
        قفل شده: "حساب قفل شده، با پشتیبانی تماس بگیرید" پایان
    پایان
پایان

تابع ریشه:
    تلاش‌ها := [ورود("سارا"، "s3cret"، ۰)، ورود("رضا"، "x"، ۰)، ورود("سارا"، "guess"، ۱)، ورود("سارا"، "s3cret"، ۳)]
    هر ن در تلاش‌ها:
        همخوان ن:
            موفق(نشانه): سرچاپ "خوش آمدید،"، نشانه پایان
            خطا(خ): سرچاپ توضیح(خ) پایان
        پایان
    پایان
پایان
