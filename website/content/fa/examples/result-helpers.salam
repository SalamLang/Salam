واردسازی نتیجه

تابع خواندن سن(متن: رشته): نتیجه.نتیجه<صحیح، رشته>:
    ن := متن.به صحیح()
    اگر ن <= ۰ یا ن > ۱۵۰:
        برگشت نتیجه.نتیجه.خطا("سن نامعتبر: " + متن)
    پایان
    برگشت نتیجه.نتیجه.موفق(ن)
پایان

تابع ریشه:
    خوب := خواندن سن("۴۲")
    بد := خواندن سن("چهل")
    سرچاپ نتیجه.موفق است(خوب)، نتیجه.خطا است(بد)
    سرچاپ نتیجه.با پیش فرض(بد، ۱۸)
    سرچاپ نتیجه.انتظار(خوب، "سن لازم است")
    سرچاپ همخوان بد:
        موفق(سن): "سن " + سن پایان
        خطا(پیام): "خطا: " + پیام پایان
    پایان
پایان
