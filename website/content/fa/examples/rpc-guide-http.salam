واردسازی فراخوان دور
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا بازدیدها := ۰

تابع بازدید(ف: صحیح۶۴):
    بازدیدها += ۱
    فراخوان دور.پاسخ عددی(ف، بازدیدها)
پایان

تابع خوشامد(ف: صحیح۶۴):
    فراخوان دور.پاسخ متنی(ف، "سلام، " + فراخوان دور.پارامتر متنی فراخوان(ف، "name"، ۰))
پایان

تابع نقطه پایانی(زمینه: صحیح۶۴):
    اچ تی تی پی.جیسون(زمینه، فراخوان دور.پردازش متن(اچ تی تی پی.بدنه(زمینه)))
پایان

تابع ریشه:
    فراخوان دور.ثبت متد("hit"، بازدید)
    فراخوان دور.ثبت متد("greet"، خوشامد)
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/rpc"، نقطه پایانی)
    ناپایا س := اچ تی تی پی.سرور جدید(۸۰۹۰)
    اچ تی تی پی.استفاده(س، م)
    سرچاپ "JSON-RPC روی http://127.0.0.1:8090/rpc"
    اچ تی تی پی.اجرا(س)
پایان
