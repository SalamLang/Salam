واردسازی فراخوان دور
واردسازی رشته
واردسازی ورودی خروجی

تابع شمار واژه(ف: صحیح۶۴):
    واژه‌ها := رشته.واژه ها(فراخوان دور.پارامتر متنی فراخوان(ف، "text"، ۰))
    فراخوان دور.پاسخ عددی(ف، واژه‌ها.طول())
    واژه‌ها.آزادکن()
پایان

تابع فریاد(ف: صحیح۶۴):
    فراخوان دور.پاسخ متنی(ف، رشته.بزرگ(فراخوان دور.پارامتر متنی فراخوان(ف، "text"، ۰)))
پایان

تابع ریشه:
    فراخوان دور.ثبت متد("words"، شمار واژه)
    فراخوان دور.ثبت متد("shout"، فریاد)
    پاسخ‌داده := فراخوان دور.خدمت ورودی خروجی(فراخوان دور.قاب خطی)
    ورودی خروجی.نوشتن خطا با خط جدید("به " + پاسخ‌داده + " درخواست پاسخ داده شد")
پایان
