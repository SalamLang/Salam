واردسازی فراخوان دور
واردسازی کدگذاری.مقدار
واردسازی همگام سازی

ناپایا سرور := فراخوان دور.سرور جدید(۰، فراخوان دور.کدک جیسون)
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع تبدیل ارز(ف: صحیح۶۴):
    مبلغ := فراخوان دور.پارامتر اعشاری فراخوان(ف، "amount"، ۰)
    ارز := فراخوان دور.پارامتر متنی فراخوان(ف، "to"، ۱)
    اگر ارز == "EUR":
        فراخوان دور.پاسخ اعشاری(ف، مبلغ * ۰.۵)
        برگشت
    پایان
    فراخوان دور.شکست(ف، -۳۲۰۱۰، "ارز ناشناخته: " + ارز)
پایان

تابع اجرای سرور():
    _ := فراخوان دور.گوش دادن(سرور)
    همگام سازی.اتمام(آماده)
    _ := فراخوان دور.خدمت به تعداد(سرور، ۱)
پایان

تابع ریشه:
    فراخوان دور.ثبت متد("convert"، تبدیل ارز)
    همگام سازی.افزودن(آماده، ۱)
    ن := نخ‌ساز(اجرای سرور)
    همگام سازی.انتظار(آماده)

    ناپایا کارخواه := فراخوان دور.اتصال کارخواه("127.0.0.1"، فراخوان دور.درگاه سرور(سرور)، فراخوان دور.کدک جیسون)
    اگر وارونه فراخوان دور.کارخواه معتبر(کارخواه):
        سرچاپ "اتصال برقرار نشد:"، فراخوان دور.خطای کارخواه(کارخواه)
        برگشت ۱
    پایان
    ناپایا پارامترها := مقدار.شیء جدید()
    مقدار.تنظیم کلید(پارامترها، "amount"، مقدار.مقدار اعشاری(۴۰.۰))
    مقدار.تنظیم کلید(پارامترها، "to"، مقدار.مقدار رشته("EUR"))
    خوب := فراخوان دور.فراخوان(کارخواه، "convert"، پارامترها)
    سرچاپ "۴۰ برابر است با"، فراخوان دور.نتیجه اعشاری(خوب)، "یورو"

    مقدار.تنظیم کلید(پارامترها، "to"، مقدار.مقدار رشته("XYZ"))
    بد := فراخوان دور.فراخوان(کارخواه، "convert"، پارامترها)
    اگر فراخوان دور.پاسخ خطاست(بد):
        سرچاپ "خطا"، فراخوان دور.کد خطا(بد)، فراخوان دور.پیام خطا(بد)
    پایان
    فراخوان دور.بستن کارخواه(کارخواه)
    نخ‌پیوند(ن)
    فراخوان دور.توقف سرور(سرور)
    برگشت ۰
پایان
