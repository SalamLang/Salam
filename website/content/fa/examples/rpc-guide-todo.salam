واردسازی فراخوان دور
واردسازی کدگذاری.مقدار

ناپایا کارها := وکتور {} برگردان وکتور<رشته>

تابع افزودن کار(ف: صحیح۶۴):
    عنوان := فراخوان دور.پارامتر متنی فراخوان(ف، "title"، ۰)
    اگر عنوان == "":
        فراخوان دور.پارامتر نامعتبر(ف، "عنوان لازم است")
        برگشت
    پایان
    کارها.بیفزا(عنوان)
    فراخوان دور.پاسخ عددی(ف، کارها.طول())
پایان

تابع فهرست کارها(ف: صحیح۶۴):
    ناپایا اقلام := مقدار.آرایه جدید()
    هر ک در کارها:
        مقدار.افزودن به آرایه(اقلام، مقدار.مقدار رشته(ک))
    پایان
    فراخوان دور.پاسخ دادن(ف، اقلام)
پایان

تابع شمار کارها(ف: صحیح۶۴):
    فراخوان دور.پاسخ عددی(ف، کارها.طول())
پایان

تابع ریشه:
    فراخوان دور.ثبت متد با توضیح("todo.add"، افزودن کار، "یک کار می‌افزاید و تعداد کارها را برمی‌گرداند")
    فراخوان دور.ثبت متد با توضیح("todo.list"، فهرست کارها، "همه‌ی کارها را برمی‌گرداند")
    فراخوان دور.ثبت متد("todo.count"، شمار کارها)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"todo.add","params":{"title":"خرید نان"},"id":1}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"todo.add","params":["تماس با سارا"],"id":2}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"todo.add","params":{},"id":3}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"todo.list","id":4}`)
    سرچاپ فراخوان دور.پردازش متن(`[{"jsonrpc":"2.0","method":"todo.count","id":5},{"jsonrpc":"2.0","method":"todo.delete","id":6}]`)
    سرچاپ فراخوان دور.توضیح متد("todo.add")
    کارها.آزادکن()
پایان
