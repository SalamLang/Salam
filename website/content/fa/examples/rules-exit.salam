تابع سن از(متن: رشته، سن &: صحیح): منطقی:
    ن := متن.به صحیح()
    اگر ن <= ۰ یا ن > ۱۵۰:
        برگشت نادرست
    پایان
    سن = ن
    برگشت درست
پایان

تابع ریشه:
    ناپایا سن := ۰
    هر متن در ["42"، "abc"، "900"]:
        اگر سن از(متن، سن):
            سرچاپ متن، "سن درستی است"
        وگرنه:
            سرچاپ متن، "سن نیست"
        پایان
    پایان
    اگر سن == ۰:
        نادرست‌سرچاپ "هیچ سن درستی پیدا نشد"
        برگشت ۱
    پایان
    سرچاپ "آخرین سن درست:"، سن
پایان
