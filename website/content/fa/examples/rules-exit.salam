تابع سن از(متن: رشته): صحیح خطادار:
    ن := متن.به صحیح()
    اگر ن <= ۰ یا ن > ۱۵۰:
        پرتاب خطا خطا.جدید(نوع خطا.خارج از بازه، "«" + متن + "» سن نیست")
    پایان
    برگشت ن
پایان

تابع بزرگ‌ترین(متن‌ها: وکتور<رشته>): صحیح خطادار:
    ناپایا بیشینه := ۰
    هر متن در متن‌ها:
        سن := تلاش سن از(متن)
        اگر سن > بیشینه:
            بیشینه = سن
        پایان
    پایان
    برگشت بیشینه
پایان

تابع ریشه:
    هر متن در ["42"، "abc"]:
        تلاش:
            سرچاپ متن، "سن درستی است:"، سن از(متن)
        گرفتن خطا خ:
            سرچاپ خ.پیام
        پایان
    پایان
    جایگزین := تلاش سن از("900") گرفتن خطا ۱۸
    سرچاپ "با مقدار جایگزین:"، جایگزین
    ناپایا متن‌ها := وکتور {} برگردان وکتور<رشته>
    متن‌ها.بیفزا("30")
    متن‌ها.بیفزا("45")
    تلاش:
        سرچاپ "بزرگ‌ترین:"، بزرگ‌ترین(متن‌ها)
    گرفتن خطا خ:
        نادرست‌سرچاپ "بزرگ‌ترین سن پیدا نشد:"، خ.پیام
        برگشت ۱
    پایان
پایان
