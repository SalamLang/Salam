جداشمار چراغ: قرمز، زرد، سبز پایان

تابع کار(چ: چراغ): رشته:
    برگشت همخوان چ:
        قرمز: "بایست" پایان
        زرد: "آهسته" پایان
        سبز: "برو" پایان
    پایان
پایان

تابع علامت(ن: صحیح): رشته:
    اگر ن > ۰:
        برگشت "مثبت"
    وگرنه ن < ۰:
        برگشت "منفی"
    پایان
    برگشت "صفر"
پایان

تابع ریشه:
    سرچاپ کار(چراغ.زرد)، کار(چراغ.سبز)
    سرچاپ علامت(-۴)، علامت(۰)، علامت(۹)
پایان
