پایا سقف := ۳

روال ریشه:
    نام‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن نام‌ها.آزادکن()
    نام‌ها.بیفزا("سارا")
    نام‌ها.بیفزا("رضا")
    نام‌ها.بیفزا("مینا")
    نام‌ها.بیفزا("علی")
    ناپایا نشان‌داده := ۰
    هر ن در نام‌ها:
        اگر نشان‌داده == سقف:
            بشکن
        پایان
        سرچاپ ن
        نشان‌داده += ۱
    پایان
    سرچاپ نشان‌داده، "از"، نام‌ها.طول()، "نام نشان داده شد"
پایان
