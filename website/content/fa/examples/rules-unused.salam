میانجی پاسخگو:
    تابع پاسخ(کاربر: رشته، متن: رشته): رشته
پایان

ساختار پژواک:
    همگانی تابع پاسخ(کاربر: رشته، متن: رشته): رشته:
        برگشت کاربر + " گفت " + متن
    پایان
پایان

ساختار فریاد:
    همگانی تابع پاسخ(_کاربر: رشته، متن: رشته): رشته:
        برگشت متن + "!"
    پایان
پایان

تابع اجرا(پ: پویا پاسخگو):
    سرچاپ پ.پاسخ("سارا"، "سلام")
پایان

تابع ریشه:
    اجرا(پژواک {})
    اجرا(فریاد {})
پایان
