واردسازی زمان اجرا
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی تبدیل
واردسازی رشته

تابع سلامت(ز: صحیح۶۴):
    ناپایا بدنه := `{"status": "ok", "os": "` + زمان اجرا.نام سیستم عامل() + `", "arch": "` + زمان اجرا.معماری() + `"`
    بدنه = بدنه + `, "cpus": ` + تبدیل.قالب عدد(زمان اجرا.تعداد پردازنده() برگردان صحیح۶۴)
    بدنه = بدنه + `, "uptime_ms": ` + تبدیل.قالب عدد(زمان اجرا.زمان فعالیت به میلی‌ثانیه())
    بدنه = بدنه + `, "used_memory": ` + تبدیل.قالب عدد(زمان اجرا.حافظه استفاده شده())
    بدنه = بدنه + `, "build": "` + زمان اجرا.پرچم‌های ساخت() + `"}`
    اچ تی تی پی.جیسون(ز، بدنه)
پایان

تابع ریشه:
    زمان اجرا.علامت‌گذاری شروع()
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/health"، سلامت)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۷۳۵)
    اچ تی تی پی.استفاده(س، م)
    سرچاپ اچ تی تی پی.اجرا در پس زمینه(س)
    پاسخ := اچ تی تی پی.دریافت("http://127.0.0.1:19735/health")
    متن := اچ تی تی پی.بدنه(پاسخ)
    سرچاپ اچ تی تی پی.وضعیت(پاسخ)، اچ تی تی پی.دریافت سرصفحه(پاسخ، "content-type")
    سرچاپ رشته.شروع با(متن، `{"status": "ok"`)، رشته.شامل است(متن، `"uptime_ms": `)
پایان
