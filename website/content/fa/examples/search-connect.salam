واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}

    اگر وارونه تایپسنس.سلامت(ک، خ):
        سرچاپ "تایپ‌سنس آماده نیست:"، تایپسنس.متن خطا(خ)
        برگشت ۱
    پایان
    سرچاپ "وصل شد، نسخه‌ی سرور"، تایپسنس.نسخه سرور(ک، خ)

    _ := تایپسنس.دریافت مجموعه(ک، "no_such_collection"، خ)
    اگر وارونه تایپسنس.موفق(خ):
        سرچاپ "وضعیت"، خ.status، "پیدا نشد:"، تایپسنس.پیدا نشد(خ)
        سرچاپ تایپسنس.متن خطا(خ)
    پایان
پایان
