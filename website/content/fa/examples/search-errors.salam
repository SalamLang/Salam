واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ناپایا تنظیم := اپن سرچ.پیکربندی پیش‌فرض()
    تنظیم.nodes = وکتور {} برگردان وکتور<رشته>
    تنظیم.nodes.بیفزا("http://127.0.0.1:1")
    تنظیم.max_retries = 0
    ک := اپن سرچ.کارخواه تازه(تنظیم)
    سرچاپ "پیکربندی معتبر:"، اپن سرچ.معتبر(ک)

    د := اپن سرچ.دریافت(ک، "books"، "1")
    سرچاپ "پیدا شد:"، د.found
    سرچاپ "وضعیت:"، اپن سرچ.وضعیت(ک)
    سرچاپ "خطا:"، اپن سرچ.خطا(ک)

    خراب := اپن سرچ.اتصال("ftp://example.com")
    سرچاپ "پیکربندی معتبر:"، اپن سرچ.معتبر(خراب)، "|"، اپن سرچ.خطا(خراب)
پایان
