واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}

    ناپایا ج := تایپسنس.جستجوی جدید("*"، "")
    ج.فیلدهای دسته‌بندی = "genre"
    ن := تایپسنس.جستجو(ک، "lesson_books"، ج، خ)
    هر د در ن.دسته‌بندی‌ها:
        هر ش در د.شمارها:
            سرچاپ د.نام فیلد، ش.مقدار، ش.تعداد
        پایان
    پایان

    ناپایا گ := تایپسنس.جستجوی جدید("*"، "")
    گ.فیلدهای گروه‌بندی = "genre"
    گ.حد گروه = ۱
    گ.ترتیب = "year:asc"
    نگ := تایپسنس.جستجو(ک، "lesson_books"، گ، خ)
    هر گروه در نگ.گروه‌ها:
        سرچاپ "کهن‌ترین"، رشته.بپیوند(گروه.کلید، "") + ":"، گروه.یافته‌ها.بگیر(۰).سند
    پایان
پایان
