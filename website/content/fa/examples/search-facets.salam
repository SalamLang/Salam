واردسازی رشته
واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}

    ناپایا ج := تایپسنس.جستجوی جدید("*"، "")
    ج.facet_by = "genre"
    ن := تایپسنس.جستجو(ک، "lesson_books"، ج، خ)
    هر د در ن.facets:
        هر ش در د.counts:
            سرچاپ د.field_name، ش.value، ش.count
        پایان
    پایان

    ناپایا گ := تایپسنس.جستجوی جدید("*"، "")
    گ.group_by = "genre"
    گ.group_limit = ۱
    گ.sort_by = "year:asc"
    نگ := تایپسنس.جستجو(ک، "lesson_books"، گ، خ)
    هر گروه در نگ.groups:
        سرچاپ "کهن‌ترین"، رشته.بپیوند(گروه.key، "") + ":"، گروه.hits.بگیر(۰).document
    پایان
پایان
