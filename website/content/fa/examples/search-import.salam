واردسازی دیتابیس.تایپسنس

ساختار کتاب:
    @json "id"
    همگانی شناسه: رشته = ""
    @json "title"
    همگانی عنوان: رشته = ""
    @json "author"
    همگانی نویسنده: رشته = ""
    @json "genre"
    همگانی گونه: رشته = ""
    @json "year"
    همگانی سال: صحیح = ۰
پایان

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}

    ناپایا کتاب‌ها := وکتور {} برگردان وکتور<کتاب>
    کتاب‌ها.بیفزا(کتاب { شناسه = "1"، عنوان = "کلیدر"، نویسنده = "محمود دولت‌آبادی"، گونه = "رمان"، سال = ۱۹۸۴ })
    کتاب‌ها.بیفزا(کتاب { شناسه = "2"، عنوان = "جای خالی سلوچ"، نویسنده = "محمود دولت‌آبادی"، گونه = "رمان"، سال = ۱۹۷۹ })
    کتاب‌ها.بیفزا(کتاب { شناسه = "3"، عنوان = "بوف کور"، نویسنده = "صادق هدایت"، گونه = "داستان"، سال = ۱۹۳۶ })
    کتاب‌ها.بیفزا(کتاب { شناسه = "4"، عنوان = "سووشون"، نویسنده = "سیمین دانشور"، گونه = "رمان"، سال = ۱۹۶۹ })
    کتاب‌ها.بیفزا(کتاب { شناسه = "5"، عنوان = "شازده احتجاب"، نویسنده = "هوشنگ گلشیری"، گونه = "داستان"، سال = ۱۹۶۹ })
    ن := تایپسنس.درون ریزی از نوع(ک، "lesson_books"، کتاب‌ها، تایپسنس.گزینه های نوشتن { action = تایپسنس.کنش درج }، خ)
    سرچاپ "وارد شد"، ن.success، "ناموفق"، ن.failed

    _ := تایپسنس.ساخت سند(ک، "lesson_books"، `{"id": "6", "title": "گلستان", "author": "سعدی", "genre": "نثر", "year": "1258"}`، خ)
    سرچاپ "نوع نادرست:"، تایپسنس.متن خطا(خ)
    سرچاپ تایپسنس.درج سند(ک، "lesson_books"، `{"id": "6", "title": "گلستان", "author": "سعدی", "genre": "نثر", "year": 1258}`، خ)

    ناپایا ب := کتاب {}
    اگر تایپسنس.دریافت سند به نوع(ک، "lesson_books"، "1"، ب، خ):
        سرچاپ "خوانده شد:"، ب.عنوان، "از"، ب.نویسنده
    پایان
    سرچاپ تایپسنس.به‌روزرسانی سند(ک، "lesson_books"، "6"، `{"rating": 4.9}`، خ)
پایان
