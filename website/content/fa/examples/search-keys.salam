واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا مدیر := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(مدیر)
    ناپایا خ := تایپسنس.خطا {}

    ناپایا مجموعه‌ها := وکتور {} برگردان وکتور<رشته>
    مجموعه‌ها.بیفزا("lesson_books")
    کلید := تایپسنس.کلید فقط جستجو(مدیر، "website search"، مجموعه‌ها، خ)
    سرچاپ "کلید جستجو ساخته شد، اجازه دارد:"، کلید.کنش‌ها.بگیر(۰)

    محدود := تایپسنس.کلید جستجوی محدود(کلید.مقدار، تایپسنس.پارامترهای جستجو { فیلتر = "genre:=داستان" }، ۰)
    ناپایا مرورگر := تایپسنس.جدید("http://localhost:8108"، محدود)
    دیرکن تایپسنس.آزادسازی(مرورگر)
    سرچاپ "مرورگر"، تایپسنس.جستجو(مرورگر، "lesson_books"، تایپسنس.جستجوی جدید("*"، "")، خ).یافت‌شده، "کتاب می‌بیند"
    _ := تایپسنس.حذف سند(مرورگر، "lesson_books"، "1"، خ)
    سرچاپ "و نمی‌تواند حذف کند:"، خ.وضعیت
    _ := تایپسنس.حذف کلید(مدیر، کلید.شناسه، خ)
پایان
