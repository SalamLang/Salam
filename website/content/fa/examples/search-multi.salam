واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}

    ناپایا جستجوها := وکتور {} برگردان وکتور<تایپسنس.درخواست جستجو>
    جستجوها.بیفزا(تایپسنس.درخواست جستجو { مجموعه = "lesson_books"، پارامترها = تایپسنس.جستجوی جدید("کلیدر"، "title") })
    جستجوها.بیفزا(تایپسنس.درخواست جستجو { مجموعه = "lesson_books"، پارامترها = تایپسنس.جستجوی جدید("هدایت"، "author") })
    مشترک := تایپسنس.پارامترهای جستجو { اندازه صفحه = ۳ }

    هر ن در تایپسنس.جستجوی چندگانه(ک، جستجوها، مشترک، خ):
        سرچاپ "جستجو پیدا کرد"، ن.یافت‌شده
    پایان
    اج := تایپسنس.جستجوی اجتماع(ک، جستجوها، مشترک، خ)
    سرچاپ "اجتماع پیدا کرد"، اج.یافت‌شده
    هر ی در اج.یافته‌ها:
        سرچاپ "  از جستجوی"، ی.شماره جستجو، ی.سند
    پایان
پایان
