واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}

    ناپایا جستجوها := وکتور {} برگردان وکتور<تایپسنس.درخواست جستجو>
    جستجوها.بیفزا(تایپسنس.درخواست جستجو { collection = "lesson_books"، params = تایپسنس.جستجوی جدید("کلیدر"، "title") })
    جستجوها.بیفزا(تایپسنس.درخواست جستجو { collection = "lesson_books"، params = تایپسنس.جستجوی جدید("هدایت"، "author") })
    مشترک := تایپسنس.پارامترهای جستجو { per_page = ۳ }

    هر ن در تایپسنس.جستجوی چندگانه(ک، جستجوها، مشترک، خ):
        سرچاپ "جستجو پیدا کرد"، ن.found
    پایان
    اج := تایپسنس.جستجوی اجتماع(ک، جستجوها، مشترک، خ)
    سرچاپ "اجتماع پیدا کرد"، اج.found
    هر ی در اج.hits:
        سرچاپ "  از جستجوی"، ی.search_index، ی.document
    پایان
پایان
