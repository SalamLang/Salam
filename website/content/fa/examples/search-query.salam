واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    سرچاپ اپن سرچ.تطبیق("title"، "book of kings")
    سرچاپ اپن سرچ.واژه("author"، "Ferdowsi")
    سرچاپ اپن سرچ.بازه صحیح("year"، 1000، 1300)

    ناپایا شرط := اپن سرچ.پرسمان منطقی {}
    شرط.must.بیفزا(اپن سرچ.تطبیق("title"، "kings"))
    شرط.filter.بیفزا(اپن سرچ.بازه صحیح("year"، 1000، 1300))
    شرط.must_not.بیفزا(اپن سرچ.واژه("author"، "Anonymous"))
    سرچاپ اپن سرچ.پرسمان منطقی ساخته(شرط)

    ناپایا درخواست := اپن سرچ.درخواست جستجو { query = اپن سرچ.پرسمان منطقی ساخته(شرط)، size = 5 }
    درخواست.sort.بیفزا(اپن سرچ.مرتب نزولی("year"))
    درخواست.source.بیفزا("title")
    سرچاپ اپن سرچ.بدنه جستجو(درخواست)
پایان
