واردسازی دیتابیس.تایپسنس

تابع نشان(برچسب: رشته، ن: تایپسنس.نتیجه جستجو):
    سرچاپ برچسب، "پیدا شد"، ن.found
    هر ی در ن.hits:
        سرچاپ "   "، ی.document
    پایان
پایان

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}

    نشان("دولت‌آبادی:"، تایپسنس.جستجو(ک، "lesson_books"، تایپسنس.جستجوی جدید("دولت‌آبادی"، "author")، خ))
    نشان("غلط تایپی:"، تایپسنس.جستجو(ک، "lesson_books"، تایپسنس.جستجوی جدید("سوشون"، "title")، خ))

    ناپایا ج := تایپسنس.جستجوی جدید("*"، "")
    ج.filter_by = "genre:=رمان && year:<1980"
    ج.sort_by = "year:desc"
    ج.include_fields = "title,year"
    نشان("با پالایه:"، تایپسنس.جستجو(ک، "lesson_books"، ج، خ))

    ناپایا ب := تایپسنس.جستجوی جدید("دولت‌آبادی"، "author,title")
    ب.per_page = ۱
    ن := تایپسنس.جستجو(ک، "lesson_books"، ب، خ)
    سرچاپ "صفحه"، ن.page، "از"، ن.found، "نتیجه، برجسته:"، تایپسنس.برجسته(ن.hits.بگیر(۰)، "author")
پایان
