واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    پاسخ سرور := `{"took":3,"timed_out":false,"hits":{"total":{"value":2,"relation":"eq"},"max_score":2.1,"hits":[{"_index":"books","_id":"1","_score":2.1,"_source":{"title":"Shahnameh","author":"Ferdowsi"},"highlight":{"title":["<em>Shahnameh</em>"]}},{"_index":"books","_id":"7","_score":0.8,"_source":{"title":"Tales from the Shahnameh","author":"Anonymous"}}]}}`
    ر := اپن سرچ.تجزیه جستجو(پاسخ سرور)
    سرچاپ ر.total، "یافته در"، ر.took، "میلی‌ثانیه"
    هر ه در ر.hits:
        سرچاپ ه.id، ه.score، اپن سرچ.مسیر جیسون(ه.source، "title")، "از"، اپن سرچ.مسیر جیسون(ه.source، "author")
    پایان
    سرچاپ اپن سرچ.مسیر جیسون(ر.hits.بگیر(0).highlight، "title.0")
پایان
