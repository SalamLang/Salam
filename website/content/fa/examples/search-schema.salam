واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "lesson_books"، خ)

    ناپایا طرح := تایپسنس.طرح { نام = "lesson_books"، فیلد مرتب‌سازی پیش‌فرض = "year" }
    طرح.فیلدها.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد جدید("author"، تایپسنس.نوع متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("genre"، تایپسنس.نوع متن))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد جدید("year"، تایپسنس.نوع عدد۳۲))
    طرح.فیلدها.بیفزا(تایپسنس.فیلد { نام = "rating"، نوع = تایپسنس.نوع اعشاری، اختیاری = درست })

    مجموعه := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    اگر وارونه تایپسنس.موفق(خ):
        سرچاپ تایپسنس.متن خطا(خ)
        برگشت ۱
    پایان
    سرچاپ "ساخته شد"، مجموعه.نام، "با"، مجموعه.فیلدها.طول()، "فیلد"
    هر فیلد در مجموعه.فیلدها:
        سرچاپ " "، فیلد.نام، فیلد.نوع، "دسته‌بندی:"، فیلد.دسته‌بندی
    پایان
پایان
