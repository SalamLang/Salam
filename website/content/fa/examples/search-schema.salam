واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "lesson_books"، خ)

    ناپایا طرح := تایپسنس.طرح { name = "lesson_books"، default_sorting_field = "year" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("author"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد دسته بندی("genre"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("year"، تایپسنس.نوع عدد۳۲))
    طرح.fields.بیفزا(تایپسنس.فیلد { name = "rating"، kind = تایپسنس.نوع اعشاری، optional = درست })

    مجموعه := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    اگر وارونه تایپسنس.موفق(خ):
        سرچاپ تایپسنس.متن خطا(خ)
        برگشت ۱
    پایان
    سرچاپ "ساخته شد"، مجموعه.name، "با"، مجموعه.fields.طول()، "فیلد"
    هر فیلد در مجموعه.fields:
        سرچاپ " "، فیلد.name، فیلد.kind، "دسته‌بندی:"، فیلد.facet
    پایان
پایان
