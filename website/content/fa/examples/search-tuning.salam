واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}

    ناپایا واژه‌ها := وکتور {} برگردان وکتور<رشته>
    واژه‌ها.بیفزا("رمان")
    واژه‌ها.بیفزا("داستان بلند")
    ناپایا مترادف‌ها := وکتور {} برگردان وکتور<تایپسنس.مترادف>
    مترادف‌ها.بیفزا(تایپسنس.مترادف { شناسه = "novel"، مترادف‌ها = واژه‌ها })
    _ := تایپسنس.درج دسته مترادف(ک، "lesson_words"، مترادف‌ها، خ)

    ناپایا سنجاق‌ها := وکتور {} برگردان وکتور<تایپسنس.سنجاق>
    سنجاق‌ها.بیفزا(تایپسنس.سنجاق { شناسه = "2"، جایگاه = ۱ })
    ناپایا قاعده‌ها := وکتور {} برگردان وکتور<تایپسنس.قاعده گزینش>
    قاعده‌ها.بیفزا(تایپسنس.قاعده گزینش { شناسه = "salouch-first"، پرسمان = "دولت‌آبادی"، نوع تطابق = تایپسنس.تطابق دقیق، سنجاق‌شده‌ها = سنجاق‌ها })
    _ := تایپسنس.درج دسته گزینش(ک، "lesson_rules"، قاعده‌ها، خ)

    _ := تایپسنس.به‌روزرسانی مجموعه(ک، "lesson_books"، `{"synonym_sets": ["lesson_words"], "curation_sets": ["lesson_rules"]}`، خ)
    سرچاپ "داستان بلند"، تایپسنس.جستجو(ک، "lesson_books"، تایپسنس.جستجوی جدید("داستان بلند"، "genre")، خ).یافت‌شده، "کتاب پیدا می‌کند"
    ن := تایپسنس.جستجو(ک، "lesson_books"، تایپسنس.جستجوی جدید("دولت‌آبادی"، "author")، خ)
    سرچاپ "نخستین یافته:"، ن.یافته‌ها.بگیر(۰).سند، "گزینش‌شده:"، ن.یافته‌ها.بگیر(۰).گزینش‌شده
پایان
