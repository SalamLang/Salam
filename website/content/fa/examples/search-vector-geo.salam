واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا ک := تایپسنس.جدید("http://localhost:8108"، "xyz")
    دیرکن تایپسنس.آزادسازی(ک)
    ناپایا خ := تایپسنس.خطا {}
    _ := تایپسنس.حذف مجموعه(ک، "lesson_places"، خ)

    ناپایا طرح := تایپسنس.طرح { name = "lesson_places" }
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("name"، تایپسنس.نوع متن))
    طرح.fields.بیفزا(تایپسنس.فیلد جدید("location"، تایپسنس.نوع نقطه جغرافیایی))
    طرح.fields.بیفزا(تایپسنس.فیلد بردار("style"، ۲))
    _ := تایپسنس.ساخت مجموعه(ک، طرح، خ)
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"name": "کافه‌ی آرام کتابخانه", "location": [35.7019, 51.4223], "style": [0.9, 0.1]}`)
    سندها.بیفزا(`{"name": "باشگاه پرسروصدا", "location": [35.6990, 51.4180], "style": [0.1, 0.9]}`)
    سندها.بیفزا(`{"name": "چایخانه‌ی باغ", "location": [35.8040, 51.4330], "style": [0.8, 0.2]}`)
    _ := تایپسنس.درون ریزی سندها(ک، "lesson_places"، سندها، تایپسنس.گزینه های نوشتن {}، خ)

    ناپایا نزدیک := تایپسنس.جستجوی جدید("*"، "")
    نزدیک.filter_by = "location:(35.7000, 51.4200, 2 km)"
    نزدیک.sort_by = "location(35.7000, 51.4200):asc"
    نزدیک.include_fields = "name"
    هر ی در تایپسنس.جستجو(ک، "lesson_places"، نزدیک، خ).hits:
        سرچاپ "نزدیک:"، ی.document، ی.geo_distance_meters
    پایان

    ناپایا مانند := تایپسنس.جستجوی جدید("*"، "")
    مانند.vector_query = "style:([1.0, 0.0], k: 2)"
    مانند.include_fields = "name"
    هر ی در تایپسنس.جستجو(ک، "lesson_places"، مانند، خ).hits:
        سرچاپ "آرام:"، ی.document
    پایان
    _ := تایپسنس.حذف مجموعه(ک، "lesson_places"، خ)
پایان
