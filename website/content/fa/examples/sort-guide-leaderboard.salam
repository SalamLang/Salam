واردسازی مرتب سازی

تابع ریشه:
    بازیکنان := ["علی"، "سارا"، "رضا"، "مینا"، "کاوه"]
    ناپایا امتیازها := وکتور {} برگردان وکتور<اعشار۶۴>
    ناپایا بردها := وکتور {} برگردان وکتور<صحیح>
    ناپایا ترتیب := وکتور {} برگردان وکتور<صحیح>
    دیرکن امتیازها.آزادکن()
    دیرکن بردها.آزادکن()
    دیرکن ترتیب.آزادکن()
    هر ا در [۷۲.۵، ۹۱.۰، ۶۴.۰، ۸۸.۵، ۹۱.۵]:
        امتیازها.بیفزا(ا)
    پایان
    هر ب در [۳، ۷، ۲، ۶، ۸]:
        بردها.بیفزا(ب)
    پایان
    تکرار بازیکنان.طول() در ی:
        ترتیب.بیفزا(ی)
    پایان

    مرتب سازی.مرتب‌سازی نمایه نزولی(ترتیب، امتیازها)
    سرچاپ "رتبه بازیکن امتیاز برد"
    هر رتبه، ی در ترتیب:
        سرچاپ رتبه + ۱، بازیکنان[ی]، امتیازها.بگیر(ی)، بردها.بگیر(ی)
    پایان

    مرتب := مرتب سازی.مرتب شده(امتیازها)
    سرچاپ "میانه‌ی امتیاز:"، مرتب.بگیر(مرتب.طول() / ۲)
    سرچاپ "بهترین:"، مرتب سازی.بیشینه(امتیازها)، "بدترین:"، مرتب سازی.کمینه(امتیازها)
پایان
