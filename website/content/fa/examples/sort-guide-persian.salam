واردسازی مرتب سازی
واردسازی رشته

پایا الفبا := "آابپتثجچحخدذرزژسشصضطظعغفقکگلمنوهی"

تابع جایگاه(حرف: رشته): صحیح:
    ی := رشته.اندیس(الفبا، حرف)
    اگر ی کوچکتر ۰: برگشت ۱۰۰۰ پایان
    برگشت ی
پایان

تابع الفبایی جلوتر(الف: رشته، ب: رشته): منطقی:
    ناپایا ی := ۰
    تا ی کوچکتر الف.طول() و ی کوچکتر ب.طول():
        جا الف := جایگاه(الف.زیررشته(ی، ۲))
        جا ب := جایگاه(ب.زیررشته(ی، ۲))
        اگر جا الف != جا ب: برگشت جا الف کوچکتر جا ب پایان
        ی += ۲
    پایان
    برگشت الف.طول() کوچکتر ب.طول()
پایان

تابع ریشه:
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن نام‌ها.آزادکن()
    هر ن در ["هما"، "پریسا"، "وحید"، "آرش"، "ژاله"، "گلناز"، "بابک"، "چکاوک"، "زهرا"، "کاوه"، "یاسمن"، "حسن"]:
        نام‌ها.بیفزا(ن)
    پایان
    ناپایا بایتی := مرتب سازی.مرتب شده(نام‌ها)
    دیرکن بایتی.آزادکن()
    سرچاپ "مرتب:"، بایتی
    مرتب سازی.مرتب سازی با(نام‌ها، (الف: رشته، ب: رشته): برگشت الفبایی جلوتر(الف، ب) پایان)
    سرچاپ "الفبایی:"، نام‌ها
پایان
