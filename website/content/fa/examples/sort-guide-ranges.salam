واردسازی مرتب سازی

تابع ریشه:
    ناپایا قیمت‌ها := وکتور {} برگردان وکتور<صحیح>
    دیرکن قیمت‌ها.آزادکن()
    هر ق در [۱۲۰، ۴۵، ۳۰۰، ۹۹، ۴۵، ۲۱۰، ۱۵۰، ۸۰]:
        قیمت‌ها.بیفزا(ق)
    پایان
    مرتب سازی.مرتب(قیمت‌ها)
    سرچاپ "مرتب‌شده:"، قیمت‌ها

    پایین := مرتب سازی.کران پایین(قیمت‌ها، ۸۰)
    بالا := مرتب سازی.کران بالا(قیمت‌ها، ۱۵۰)
    سرچاپ "میان ۸۰ و ۱۵۰:"، بالا - پایین، "کالا"
    تکرار پایین تا بالا - ۱ در ی:
        چاپ قیمت‌ها.بگیر(ی)، ""
    پایان
    سرچاپ ""

    سرچاپ "چند کالا ۴۵ است:"، مرتب سازی.کران بالا(قیمت‌ها، ۴۵) - مرتب سازی.کران پایین(قیمت‌ها، ۴۵)

    هر تازه در [۱۰۰، ۱۰، ۵۰۰]:
        سرچاپ "قیمت تازه‌ی"، تازه، "در اندیس"، مرتب سازی.کران پایین(قیمت‌ها، تازه)، "ترتیب را نگه می‌دارد"
    پایان
    سرچاپ "جای ۲۱۰:"، مرتب سازی.جستجوی دودویی(قیمت‌ها، ۲۱۰)، "جای ۲۱۱:"، مرتب سازی.جستجوی دودویی(قیمت‌ها، ۲۱۱)
پایان
