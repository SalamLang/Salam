واردسازی مرتب سازی

ساختار کارمند:
    همگانی نام: رشته = ""
    همگانی تیم: رشته = ""
    همگانی حقوق: صحیح = ۰
پایان

تابع نمایش(کارکنان: وکتور<کارمند>):
    هر ک در کارکنان:
        سرچاپ "  " + ک.تیم، ک.نام، ک.حقوق
    پایان
پایان

تابع ریشه:
    ناپایا کارکنان := وکتور {} برگردان وکتور<کارمند>
    دیرکن کارکنان.آزادکن()
    کارکنان.بیفزا(کارمند { نام = "سارا"، تیم = "وب"، حقوق = ۵۲۰۰ })
    کارکنان.بیفزا(کارمند { نام = "امید"، تیم = "داده"، حقوق = ۶۱۰۰ })
    کارکنان.بیفزا(کارمند { نام = "لیلا"، تیم = "وب"، حقوق = ۶۱۰۰ })
    کارکنان.بیفزا(کارمند { نام = "بابک"، تیم = "داده"، حقوق = ۴۸۰۰ })
    کارکنان.بیفزا(کارمند { نام = "نیما"، تیم = "وب"، حقوق = ۵۲۰۰ })

    ترتیب تیمی := (الف: کارمند، ب: کارمند):
        اگر الف.تیم != ب.تیم: برگشت الف.تیم کوچکتر ب.تیم پایان
        اگر الف.حقوق != ب.حقوق: برگشت الف.حقوق بزرگتر ب.حقوق پایان
        برگشت الف.نام کوچکتر ب.نام
    پایان
    مرتب سازی.مرتب سازی با(کارکنان، ترتیب تیمی)
    سرچاپ "تیم، بعد بیشترین حقوق، بعد نام:"
    نمایش(کارکنان)

    ارزان‌ترین := مرتب سازی.مرتب شده با(کارکنان، (الف: کارمند، ب: کارمند): برگشت الف.حقوق کوچکتر ب.حقوق پایان)
    سرچاپ "کمترین حقوق:"، ارزان‌ترین.بگیر(۰).نام
    سرچاپ "هنوز به ترتیب تیم است:"، مرتب سازی.مرتب است با(کارکنان، ترتیب تیمی)
پایان
