واردسازی مرتب سازی
واردسازی رشته

تابع ریشه:
    متن := "the quick fox and the lazy dog and the cat"
    ناپایا واژه‌ها := رشته.واژه ها(متن)
    دیرکن واژه‌ها.آزادکن()
    مرتب سازی.مرتب(واژه‌ها)

    ناپایا یکتا := وکتور {} برگردان وکتور<رشته>
    دیرکن یکتا.آزادکن()
    هر واژه در واژه‌ها:
        اگر یکتا.طول() برابر ۰ یا یکتا.بگیر(یکتا.طول() - ۱) != واژه:
            یکتا.بیفزا(واژه)
        پایان
    پایان
    سرچاپ یکتا.طول()، "واژه‌ی متفاوت:"، یکتا

    مرتب سازی.مرتب سازی با(یکتا، (الف: رشته، ب: رشته):
        اگر الف.طول() != ب.طول(): برگشت الف.طول() بزرگتر ب.طول() پایان
        برگشت الف کوچکتر ب
    پایان)
    سرچاپ "بلندترین اول:"، یکتا

    مرتب سازی.مرتب نزولی(واژه‌ها)
    سرچاپ "نخستین واژه به ترتیب وارونه:"، واژه‌ها.بگیر(۰)
پایان
