واردسازی اس اس اچ

تابع ریشه:
    ناپایا پیکربندی := اس اس اچ.پیکربندی جدید("db.example.com"، ۲۲، "backup")
    _ := اس اس اچ.با فایل کلید(پیکربندی، "/home/backup/.ssh/id_rsa")
    ناپایا کارخواه := اس اس اچ.اتصال(پیکربندی)
    اگر وارونه اس اس اچ.معتبر(کارخواه):
        سرچاپ "اتصال ناموفق:"، اس اس اچ.خطا(کارخواه)
        برگشت ۱
    پایان

    مسیر سرور := "/tmp/shop-backup.sql.gz"
    خروجی := اس اس اچ.اجرا(کارخواه، "pg_dump shop | gzip > " + مسیر سرور)
    اگر خروجی.کد خروج نابرابر ۰:
        سرچاپ "pg_dump شکست خورد:"، خروجی.خروجی خطا
        اس اس اچ.بستن(کارخواه)
        برگشت ۱
    پایان

    ناپایا اس اف تی پی := اس اس اچ.باز کردن اس اف تی پی(کارخواه)
    اطلاعات := اس اس اچ.وضعیت(کارخواه، اس اف تی پی، مسیر سرور)
    سرچاپ "اندازه‌ی پشتیبان روی سرور:"، اطلاعات.اندازه، "بایت"
    اگر اس اس اچ.دانلود(کارخواه، اس اف تی پی، مسیر سرور، "shop-backup.sql.gz"):
        سرچاپ "دانلود شد"
        _ := اس اس اچ.حذف(کارخواه، اس اف تی پی، مسیر سرور)
    وگرنه:
        سرچاپ "دانلود ناموفق:"، اس اس اچ.خطا(کارخواه)
    پایان
    اس اس اچ.بستن اس اف تی پی(کارخواه، اس اف تی پی)
    اس اس اچ.بستن(کارخواه)
    برگشت ۰
پایان
