واردسازی اس اس اچ
واردسازی رشته

تابع اجرای گام‌ها(کارخواه &: اس اس اچ.کارخواه، گام‌ها: وکتور<رشته>): منطقی:
    هر گام در گام‌ها:
        نتیجه := اس اس اچ.اجرا(کارخواه، گام)
        اگر وارونه نتیجه.موفق یا نتیجه.کد خروج نابرابر ۰:
            سرچاپ "شکست خورد:"، گام
            سرچاپ رشته.پیرایش(نتیجه.خروجی خطا)
            برگشت نادرست
        پایان
        سرچاپ "انجام شد:"، گام
    پایان
    برگشت درست
پایان

تابع ریشه:
    ناپایا پیکربندی := اس اس اچ.پیکربندی جدید("app1.example.com"، اس اس اچ.پورت پیش فرض، "deploy")
    اگر وارونه اس اس اچ.با فایل کلید(پیکربندی، "/home/deploy/.ssh/id_rsa"):
        سرچاپ "فایل کلید خوانده نشد"
        برگشت ۱
    پایان
    اس اس اچ.با حالت کلید میزبان(پیکربندی، اس اس اچ.حالت کلید میزبان سخت‌گیر)
    ناپایا کارخواه := اس اس اچ.اتصال(پیکربندی)
    اگر وارونه اس اس اچ.معتبر(کارخواه):
        سرچاپ "اتصال ناموفق:"، اس اس اچ.خطا(کارخواه)
        برگشت ۱
    پایان

    ناپایا گام‌ها := وکتور {} برگردان وکتور<رشته>
    گام‌ها.بیفزا("cd /srv/app && git fetch --quiet && git checkout --quiet v2.4.0")
    گام‌ها.بیفزا("cd /srv/app && ./salam build --release")
    گام‌ها.بیفزا("sudo systemctl restart app")
    گام‌ها.بیفزا("systemctl is-active app")
    انجام شد := اجرای گام‌ها(کارخواه، گام‌ها)
    اس اس اچ.بستن(کارخواه)
    اگر وارونه انجام شد:
        برگشت ۱
    پایان
    برگشت ۰
پایان
