واردسازی اس اس اچ

تابع امتحان(حالت: صحیح، برچسب: رشته):
    ناپایا پیکربندی := اس اس اچ.پیکربندی جدید("new-server.example.com"، ۲۲، "admin")
    اس اس اچ.با رمز عبور(پیکربندی، "first-login-password")
    اس اس اچ.با مسیر میزبان های شناخته شده(پیکربندی، "known_hosts")
    اس اس اچ.با حالت کلید میزبان(پیکربندی، حالت)
    ناپایا کارخواه := اس اس اچ.اتصال(پیکربندی)
    اگر اس اس اچ.معتبر(کارخواه):
        سرچاپ برچسب، "وصل شد، کلید میزبان"، اس اس اچ.اثر انگشت کلید میزبان(کارخواه)
        اس اس اچ.بستن(کارخواه)
    وگرنه:
        سرچاپ برچسب، "رد شد:"، اس اس اچ.خطا(کارخواه)
    پایان
پایان

تابع ریشه:
    امتحان(اس اس اچ.حالت کلید میزبان سخت‌گیر، "سخت‌گیر، known_hosts خالی:")
    امتحان(اس اس اچ.حالت پذیرش کلید میزبان تازه، "پذیرش کلید تازه، بار نخست:")
    امتحان(اس اس اچ.حالت کلید میزبان سخت‌گیر، "سخت‌گیر، کلید اکنون ثبت شده:")
پایان
