واردسازی اس اس اچ
واردسازی رشته
واردسازی تبدیل

تابع خواندن خط(خط: رشته): اس اس اچ.پیکربندی:
    بخش‌ها := رشته.تفکیک کردن(خط، " ")
    ناپایا درگاه := اس اس اچ.پورت پیش فرض
    ناپایا میزبان := بخش‌ها.بگیر(۰)
    اگر رشته.شامل است(میزبان، ":"):
        تکه‌ها := رشته.تفکیک کردن(میزبان، ":")
        میزبان = تکه‌ها.بگیر(۰)
        درگاه = تبدیل.رشته به عدد(تکه‌ها.بگیر(۱))
    پایان
    ناپایا پیکربندی := اس اس اچ.پیکربندی جدید(میزبان، درگاه، بخش‌ها.بگیر(۱))
    اس اس اچ.با حالت کلید میزبان(پیکربندی، اس اس اچ.حالت کلید میزبان سخت‌گیر)
    اس اس اچ.با مسیر میزبان های شناخته شده(پیکربندی، "/etc/deploy/known_hosts")
    برگشت پیکربندی
پایان

تابع ریشه:
    فهرست := "web1.example.com deploy\nweb2.example.com deploy\nbastion.example.com:2222 ops"
    هر خط در رشته.تفکیک کردن(فهرست، "\n"):
        پیکربندی := خواندن خط(خط)
        سرچاپ پیکربندی.نام کاربری + "@" + پیکربندی.میزبان، "درگاه"، پیکربندی.درگاه، "سخت‌گیر:"، پیکربندی.حالت کلید میزبان برابر اس اس اچ.حالت کلید میزبان سخت‌گیر
    پایان
پایان
