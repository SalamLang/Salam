واردسازی اس اس ال
واردسازی شبکه.تی سی پی
واردسازی رشته

تابع دریافت صفحه(زمینه: اس اس ال.زمینه، میزبان: رشته، مسیر: رشته): رشته:
    سوکت := تی سی پی.شماره گیری(میزبان، ۴۴۳)
    اگر وارونه تی سی پی.اتصال معتبر(سوکت):
        برگشت "دسترسی نشد به " + میزبان
    پایان
    اتصال := اس اس ال.پوشاندن(زمینه، سوکت.توصیفگر)
    _ := اس اس ال.تنظیم نام میزبان(اتصال، میزبان)
    اگر وارونه اس اس ال.اتصال برقرار کردن(اتصال):
        پیام := اس اس ال.متن خطای اتصال(اتصال)
        اس اس ال.بستن(اتصال)
        تی سی پی.بستن(سوکت)
        برگشت "دست‌دهی ناموفق: " + پیام
    پایان
    _ := اس اس ال.نوشتن(اتصال، "GET " + مسیر + " HTTP/1.1\r\nHost: " + میزبان + "\r\nConnection: close\r\n\r\n")
    ناپایا پاسخ := ""
    تا درست:
        تکه := اس اس ال.خواندن(اتصال، ۱۶۳۸۴)
        اگر تکه.طول() برابر ۰:
            بشکن
        پایان
        پاسخ += تکه
    پایان
    اس اس ال.خاموش‌ کردن(اتصال)
    اس اس ال.بستن(اتصال)
    تی سی پی.بستن(سوکت)
    برگشت رشته.تفکیک کردن(پاسخ، "\r\n").بگیر(۰)
پایان

تابع ریشه:
    زمینه := اس اس ال.زمینه جدید مشتری()
    _ := اس اس ال.تنظیم مسیرهای پیش‌فرض تایید(زمینه)
    _ := اس اس ال.تنظیم کمینه نسخه(زمینه، اس اس ال.تی ال اس۱۲)
    اس اس ال.تنظیم تایید(زمینه، اس اس ال.تایید طرف مقابل)
    سرچاپ دریافت صفحه(زمینه، "example.com"، "/")
    سرچاپ دریافت صفحه(زمینه، "expired.badssl.com"، "/")
    اس اس ال.بستن زمینه(زمینه)
پایان
