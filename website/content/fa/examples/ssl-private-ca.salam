واردسازی اس اس ال
واردسازی شبکه.تی سی پی

تابع ریشه:
    زمینه := اس اس ال.زمینه جدید مشتری()
    اگر وارونه اس اس ال.بارگذاری مکان تایید(زمینه، "/etc/company/ca.pem"):
        سرچاپ "مرجع گواهی شرکت خوانده نشد:"، اس اس ال.آخرین متن خطا()
        برگشت ۱
    پایان
    اس اس ال.تنظیم تایید(زمینه، اس اس ال.تایید طرف مقابل)
    _ := اس اس ال.تنظیم کمینه نسخه(زمینه، اس اس ال.تی ال اس۱۳)

    سوکت := تی سی پی.شماره گیری("billing.internal"، ۸۴۴۳)
    اتصال := اس اس ال.پوشاندن(زمینه، سوکت.توصیفگر)
    _ := اس اس ال.تنظیم نام میزبان(اتصال، "billing.internal")
    موفق := اس اس ال.اتصال برقرار کردن(اتصال)
    اگر وارونه موفق یا وارونه اس اس ال.طرف مقابل تاییدشده(اتصال):
        سرچاپ "سرور رد شد، نتیجه‌ی تایید"، اس اس ال.نتیجه تایید(اتصال)، اس اس ال.متن خطای اتصال(اتصال)
        اس اس ال.بستن(اتصال)
        تی سی پی.بستن(سوکت)
        برگشت ۱
    پایان
    _ := اس اس ال.نوشتن(اتصال، "PING\n")
    سرچاپ "پاسخ سرور:"، اس اس ال.خواندن(اتصال، ۱۰۲۴)
    اس اس ال.خاموش‌ کردن(اتصال)
    اس اس ال.بستن(اتصال)
    تی سی پی.بستن(سوکت)
    اس اس ال.بستن زمینه(زمینه)
    برگشت ۰
پایان
