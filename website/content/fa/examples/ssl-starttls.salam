واردسازی اس اس ال
واردسازی شبکه.تی سی پی
واردسازی رشته

تابع بگو(سوکت: تی سی پی.اتصال شبکه، خط: رشته): رشته:
    _ := تی سی پی.نوشتن(سوکت، خط + "\r\n")
    برگشت تی سی پی.خواندن(سوکت، ۴۰۹۶)
پایان

تابع ریشه:
    سوکت := تی سی پی.شماره گیری("smtp.gmail.com"، ۵۸۷)
    خوشامد := تی سی پی.خواندن(سوکت، ۴۰۹۶)
    سرچاپ "بی‌رمز:"، رشته.تفکیک کردن(خوشامد، "\r\n").بگیر(۰)
    _ := بگو(سوکت، "EHLO client.example.com")
    پاسخ := بگو(سوکت، "STARTTLS")
    اگر وارونه رشته.شروع با(پاسخ، "220"):
        سرچاپ "STARTTLS پشتیبانی نمی‌شود:"، پاسخ
        تی سی پی.بستن(سوکت)
        برگشت ۱
    پایان

    زمینه := اس اس ال.زمینه جدید مشتری()
    _ := اس اس ال.تنظیم مسیرهای پیش‌فرض تایید(زمینه)
    اس اس ال.تنظیم تایید(زمینه، اس اس ال.تایید طرف مقابل)
    اتصال := اس اس ال.پوشاندن(زمینه، سوکت.توصیفگر)
    _ := اس اس ال.تنظیم نام میزبان(اتصال، "smtp.gmail.com")
    اگر وارونه اس اس ال.اتصال برقرار کردن(اتصال):
        سرچاپ "دست‌دهی ناموفق:"، اس اس ال.متن خطای اتصال(اتصال)
        برگشت ۱
    پایان
    _ := اس اس ال.نوشتن(اتصال، "EHLO client.example.com\r\n")
    سرچاپ "رمز شده:"، رشته.تفکیک کردن(اس اس ال.خواندن(اتصال، ۴۰۹۶)، "\r\n").بگیر(۰)
    _ := اس اس ال.نوشتن(اتصال، "QUIT\r\n")
    اس اس ال.خاموش‌ کردن(اتصال)
    اس اس ال.بستن(اتصال)
    تی سی پی.بستن(سوکت)
    اس اس ال.بستن زمینه(زمینه)
    برگشت ۰
پایان
