واردسازی رشته

پایا فروشگاه := "کتاب‌فروشی سلام"

روال ریشه:
    سرچاپ فروشگاه
    سرچاپ خط جداکننده()
    سرچاپ سطر("شاهنامه"، ۲)
    سرچاپ سطر("گلستان"، ۱)
پایان

روال خط جداکننده(): رشته:
    برگشت رشته.تکرار("-"، ۲۰)
پایان

روال سطر(عنوان: رشته، تعداد: صحیح): رشته:
    برگشت عنوان + " × " + تعداد
پایان
