واردسازی رشته

پایا فروشگاه := "کتاب‌فروشی سلام"

تابع ریشه:
    سرچاپ فروشگاه
    سرچاپ خط جداکننده()
    سرچاپ سطر("شاهنامه"، ۲)
    سرچاپ سطر("گلستان"، ۱)
پایان

تابع خط جداکننده(): رشته:
    برگشت رشته.تکرار("-"، ۲۰)
پایان

تابع سطر(عنوان: رشته، تعداد: صحیح): رشته:
    برگشت عنوان + " × " + تعداد
پایان
