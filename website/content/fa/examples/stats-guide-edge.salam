واردسازی آمار

تابع ریشه:
    خالی := وکتور {} برگردان وکتور<اعشار۶۴>
    سرچاپ "خالی:"، آمار.میانگین(خالی)، آمار.میانه(خالی)، آمار.بیشینه(خالی)
    ناپایا یکی := وکتور {} برگردان وکتور<اعشار۶۴>
    دیرکن یکی.آزادکن()
    یکی.بیفزا(۷.۰)
    سرچاپ "یک مقدار:"، آمار.واریانس(یکی)، آمار.واریانس جامعه(یکی)
    ناپایا نرخ‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    دیرکن نرخ‌ها.آزادکن()
    هر ن در [۱.۲، ۰.۰، ۱.۵]:
        نرخ‌ها.بیفزا(ن)
    پایان
    سرچاپ "میانگین هندسی با یک صفر:"، آمار.میانگین هندسی(نرخ‌ها)
    سرچاپ "صدک ۱۵۰ محدود می‌شود:"، آمار.صدک(نرخ‌ها، ۱۵۰.۰)
    اگر خالی.طول() برابر ۰:
        سرچاپ "داده‌ای نیست، گزارشی هم نیست"
    پایان
پایان
