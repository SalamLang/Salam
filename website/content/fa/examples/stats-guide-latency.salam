واردسازی آمار
واردسازی تبدیل

تابع نمایش(برچسب: رشته، مقدار: اعشار۶۴):
    سرچاپ برچسب، تبدیل.قالب اعشار با دقت(مقدار، ۱)، "میلی‌ثانیه"
پایان

تابع ریشه:
    ناپایا زمان‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    دیرکن زمان‌ها.آزادکن()
    هر ز در [۴۲.۰، ۳۸.۰، ۴۵.۰، ۴۰.۰، ۳۹.۰، ۴۱.۰، ۴۴.۰، ۳۷.۰، ۴۳.۰، ۱۲۰۰.۰]:
        زمان‌ها.بیفزا(ز)
    پایان
    نمایش("میانگین:"، آمار.میانگین(زمان‌ها))
    نمایش("p50:"، آمار.صدک(زمان‌ها، ۵۰.۰))
    نمایش("p90:"، آمار.صدک(زمان‌ها، ۹۰.۰))
    نمایش("p99:"، آمار.صدک(زمان‌ها، ۹۹.۰))
    نمایش("بیشینه:"، آمار.بیشینه(زمان‌ها))
    سقف := ۱۰۰.۰
    اگر آمار.صدک(زمان‌ها، ۹۰.۰) بزرگتر سقف:
        سرچاپ "هشدار: p90 از سقف"، سقف، "میلی‌ثانیه بیشتر است"
    وگرنه:
        سرچاپ "p90 در محدوده‌ی مجاز است"
    پایان
پایان
