واردسازی آمار
واردسازی رشته
واردسازی تبدیل
واردسازی نوع‌ها

تابع ریشه:
    خط := "12.5, 15, ۱۸, n/a, 20, , 9.75"
    ناپایا مقدارها := وکتور {} برگردان وکتور<اعشار۶۴>
    دیرکن مقدارها.آزادکن()
    ناپایا ردشده := ۰
    هر خانه در رشته.تفکیک کردن(خط، ","):
        م := رشته.پیرایش(خانه)
        اگر نوع‌ها.عددی است(م):
            مقدارها.بیفزا(تبدیل.تجزیه اعشار(رشته.به رقم انگلیسی(م)))
        وگرنه:
            ردشده += ۱
        پایان
    پایان
    سرچاپ مقدارها.طول()، "عدد خوانده شد و"، ردشده، "خانه کنار گذاشته شد"
    سرچاپ "مجموع:"، آمار.مجموع(مقدارها)
    سرچاپ "میانگین:"، آمار.میانگین(مقدارها)
    سرچاپ "میانه:"، آمار.میانه(مقدارها)
پایان
