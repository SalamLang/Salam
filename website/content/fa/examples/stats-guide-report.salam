واردسازی آمار
واردسازی تبدیل

تابع ریشه:
    نام‌ها := ["سارا"، "رضا"، "مینا"، "علی"، "ندا"، "امید"، "لیلا"]
    ناپایا نمره‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    دیرکن نمره‌ها.آزادکن()
    هر ن در [۱۴.۵، ۱۷.۰، ۱۹.۵، ۱۱.۰، ۱۶.۰، ۸.۵، ۱۸.۰]:
        نمره‌ها.بیفزا(ن)
    پایان
    میانگین := آمار.میانگین(نمره‌ها)
    انحراف := آمار.انحراف معیار(نمره‌ها)
    سرچاپ "دانش‌آموزان:"، نمره‌ها.طول()
    سرچاپ "میانگین:"، تبدیل.قالب اعشار با دقت(میانگین، ۲)
    سرچاپ "میانه:"، آمار.میانه(نمره‌ها)
    سرچاپ "انحراف معیار:"، تبدیل.قالب اعشار با دقت(انحراف، ۲)
    سرچاپ "بازه:"، آمار.کمینه(نمره‌ها)، "تا"، آمار.بیشینه(نمره‌ها)
    سرچاپ "۲۵٪ بالای کلاس:"، آمار.صدک(نمره‌ها، ۷۵.۰)، "و بیشتر"
    هر ی، نام در نام‌ها:
        ز := (نمره‌ها.بگیر(ی) - میانگین) / انحراف
        اگر ز بزرگتر ۱.۰:
            سرچاپ نام، "خیلی بالاتر از کلاس است:"، تبدیل.قالب اعشار با دقت(ز، ۲)
        وگرنه ز کوچکتر -۱.۰:
            سرچاپ نام، "به کمک نیاز دارد:"، تبدیل.قالب اعشار با دقت(ز، ۲)
        پایان
    پایان
پایان
