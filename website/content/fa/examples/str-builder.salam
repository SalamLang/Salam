واردسازی رشته
واردسازی قالب بندی

روال ریشه:
    کالاها := ["چای"، "نان"، "پنیر"]
    بهاها := [۴۵، ۳۰، ۱۲۰]
    ناپایا ب := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(ب)
    ناپایا جمع := ۰
    هر ش، کالا در کالاها:
        رشته.افزودن به بافر(ب، قالب بندی.پرکردن راست(کالا، ۱۰))
        رشته.افزودن به بافر(ب، قالب بندی.پرکردن چپ("" + بهاها[ش]، ۶))
        رشته.افزودن به بافر(ب، "\n")
        جمع += بهاها[ش]
    پایان
    رشته.افزودن به بافر(ب، رشته.تکرار("-"، ۱۶) + "\n")
    رشته.افزودن به بافر(ب، قالب بندی.پرکردن راست("جمع"، ۱۰))
    رشته.افزودن به بافر(ب، قالب بندی.پرکردن چپ("" + جمع، ۶))
    سرچاپ رشته.رشته بافر(ب)
پایان
