روال پیش‌نمایش(عنوان: رشته، سقف: صحیح): رشته:
    اگر عنوان.شمارنویسه() <= سقف:
        برگشت عنوان
    پایان
    برگشت عنوان.زیررشته نویسه(۰، سقف) + "..."
پایان

روال ریشه:
    سلام := "سلام"
    سرچاپ سلام.طول()، سلام.شمارنویسه()
    سرچاپ سلام.نویسه شماره(۰)، سلام.بیاب نویسه("م")، سلام.بیاب("م")
    واژه := "cafe"
    سرچاپ واژه[۰]، واژه[۰] برگردان صحیح
    سرچاپ پیش‌نمایش("عنوان کوتاه"، ۲۰)
    سرچاپ پیش‌نمایش("پیش‌بینی هوای تبریز برای آخر هفته"، ۲۰)
پایان
