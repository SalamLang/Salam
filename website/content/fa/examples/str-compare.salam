واردسازی رشته

روال ریشه:
    سرچاپ "سیب" == "سیب"، "apple" < "banana"، "Zebra" < "apple"
    سرچاپ رشته.مقایسه("انار"، "سیب")، رشته.مقایسه("به"، "به")، رشته.مقایسه("سیب"، "انار")
    نوشته := "Sara"
    ذخیره := "SARA"
    سرچاپ نوشته == ذخیره، رشته.یکسان بدون حساسیت(نوشته، ذخیره)
    سرچاپ "گل" < "لاله"، "بابا" < "پدر"
پایان
