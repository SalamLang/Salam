واردسازی رشته

تابع ریشه:
    سرچاپ "سیب" برابر "سیب"، "apple" کوچکتر "banana"، "Zebra" کوچکتر "apple"
    سرچاپ رشته.مقایسه("انار"، "سیب")، رشته.مقایسه("به"، "به")، رشته.مقایسه("سیب"، "انار")
    نوشته := "Sara"
    ذخیره := "SARA"
    سرچاپ نوشته برابر ذخیره، رشته.یکسان بدون حساسیت(نوشته، ذخیره)
    سرچاپ "گل" کوچکتر "لاله"، "بابا" کوچکتر "پدر"
پایان
