تابع ریشه:
    نام := "آرش"
    سن := ۲۵
    پیام := "سلام " + نام + "، شما " + سن + " سال دارید."
    سرچاپ پیام
    سرچاپ "جمع: " + ۲ + ۳
    سرچاپ "جمع: " + (۲ + ۳)
    سرچاپ "بها " + ۲.۵ + "، پرداخت شد: " + درست
    ناپایا گزارش := "آغاز شد"
    گزارش += "، وصل شد"
    گزارش += "، " + ۳ + " پرونده فرستاده شد"
    سرچاپ گزارش
پایان
