واردسازی رشته

تابع پاک‌سازی تلفن(خام: رشته): رشته:
    لاتین := رشته.به رقم انگلیسی(خام)
    برگشت رشته.جایگزینی(رشته.جایگزینی(لاتین، " "، "")، "-"، "")
پایان

تابع همه رقم(م: رشته): منطقی:
    اگر م.طول() == ۰:
        برگشت نادرست
    پایان
    کدها := رشته.کدنقطه ها(م)
    دیرکن کدها.آزادکن()
    هر ک در کدها:
        اگر وارونه رشته.رقم اسکی است(ک):
            برگشت نادرست
        پایان
    پایان
    برگشت درست
پایان

تابع ریشه:
    تلفن := پاک‌سازی تلفن("۰۹۱۲ ۳۴۵-۶۷۸۹")
    سرچاپ تلفن، تلفن.طول()، همه رقم(تلفن)
    سرچاپ همه رقم(پاک‌سازی تلفن("۰۹۱۲ ۳۴x ۶۷۸۹"))
    سرچاپ "۲۵۰۰۰".به صحیح() + ۱، "۱۲الف".به صحیح()، "الف".به صحیح()
    سرچاپ رشته.به رقم فارسی("فاکتور " + ۱۴۰۵ + "، جمع " + ۲۵۰۰۰ + " تومان")
پایان
