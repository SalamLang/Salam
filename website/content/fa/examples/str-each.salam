تابع ریشه:
    واژه := "سلام"
    هر ح در واژه:
        چاپ ح + " "
    پایان
    سرچاپ ""
    هر ش، ح در "café":
        سرچاپ ش، ح
    پایان
    ناپایا مصوت := 0
    هر ح در "Tabriz تبریز":
        اگر ح برابر "a" یا ح برابر "i" یا ح برابر "ی": مصوت++ پایان
    پایان
    سرچاپ "مصوت:"، مصوت
    هر ش، ب در "Hi".بایت ها():
        سرچاپ ش، ب برگردان صحیح
    پایان
پایان
