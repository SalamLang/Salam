واردسازی رشته

تابع توصیف(نشانی: رشته): رشته:
    ناپایا متغیر_schemes := وکتور {} برگردان وکتور<رشته>
    متغیر_schemes.بیفزا("http://")
    متغیر_schemes.بیفزا("https://")
    اگر وارونه رشته.شروع با یکی از(نشانی، متغیر_schemes):
        برگشت نشانی + ": not a web address"
    پایان
    ناپایا موفق := نادرست
    آرام := رشته.برش پیشوند(نشانی، "https://"، موفق)
    متغیر_secure := موفق
    میزبان := رشته.برش پیشوند(آرام، "http://"، موفق)
    ناپایا گونه := "page"
    اگر میزبان.ختم با(".png") یا میزبان.ختم با(".jpg"):
        گونه = "image"
    پایان
    اگر میزبان.دربردارد("?"):
        گونه += " with a query"
    پایان
    ناپایا برچسب := "plain"
    اگر متغیر_secure:
        برچسب = "secure"
    پایان
    برگشت برچسب + " " + گونه + " at " + میزبان
پایان

تابع ریشه:
    هر نشانی در ["https://salamlang.ir/logo.png"، "http://example.org/a?x=1"، "ftp://example.org/file"، "HTTPS://Example.org"]:
        سرچاپ توصیف(نشانی)
    پایان
    سرچاپ رشته.شروع با بدون حساسیت("HTTPS://Example.org"، "https://")
    سرچاپ رشته.پایان با بدون حساسیت("Photo.JPG"، ".jpg")
پایان
