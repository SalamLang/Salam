واردسازی رشته

تابع describe(url: رشته): رشته:
    ناپایا schemes := وکتور {} برگردان وکتور<رشته>
    schemes.بیفزا("http://")
    schemes.بیفزا("https://")
    اگر وارونه رشته.شروع با یکی از(url، schemes):
        برگشت url + ": not a web address"
    پایان
    ناپایا ok := نادرست
    rest := رشته.برش پیشوند(url، "https://"، ok)
    secure := ok
    host := رشته.برش پیشوند(rest، "http://"، ok)
    ناپایا kind := "page"
    اگر host.ختم با(".png") یا host.ختم با(".jpg"):
        kind = "image"
    پایان
    اگر host.دربردارد("?"):
        kind += " with a query"
    پایان
    ناپایا label := "plain"
    اگر secure:
        label = "secure"
    پایان
    برگشت label + " " + kind + " at " + host
پایان

تابع ریشه:
    هر url در ["https://salamlang.ir/logo.png"، "http://example.org/a?x=1"، "ftp://example.org/file"، "HTTPS://Example.org"]:
        سرچاپ describe(url)
    پایان
    سرچاپ رشته.شروع با بدون حساسیت("HTTPS://Example.org"، "https://")
    سرچاپ رشته.پایان با بدون حساسیت("Photo.JPG"، ".jpg")
پایان
