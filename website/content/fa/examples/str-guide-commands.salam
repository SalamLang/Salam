واردسازی رشته

تابع رسیدگی(خط: رشته): رشته:
    متن := رشته.پیرایش(خط)
    اگر وارونه رشته.شروع با(متن، "/"):
        برگشت "گفتگو: " + متن
    پایان
    فاصله := رشته.اندیس(متن، " ")
    ناپایا نام := متن
    ناپایا باقی := ""
    اگر فاصله > ۰:
        نام = رشته.زیررشته(متن، ۰، فاصله)
        باقی = رشته.پیرایش(رشته.زیررشته(متن، فاصله + ۱، متن.طول() - فاصله - ۱))
    پایان
    اگر رشته.یکسان بدون حساسیت(نام، "/help"):
        برگشت "فرمان‌ها: /help، /say متن، /shout متن"
    وگرنه رشته.یکسان بدون حساسیت(نام، "/say"):
        برگشت "ربات می‌گوید: " + باقی
    وگرنه رشته.یکسان بدون حساسیت(نام، "/shout"):
        برگشت "ربات فریاد می‌زند: " + رشته.بزرگ(باقی)
    پایان
    برگشت "فرمان ناشناخته: " + رشته.حذف پیشوند(نام، "/")
پایان

تابع ریشه:
    هر خط در ["سلام به همه"، "/HELP"، "  /say صبح بخیر "، "/Shout fire drill"، "/dance"]:
        سرچاپ رسیدگی(خط)
    پایان
پایان
