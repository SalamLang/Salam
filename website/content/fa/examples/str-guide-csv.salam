واردسازی رشته

تابع فیلد سی اس وی(ر: رشته): رشته:
    اگر رشته.شامل است(ر، ",") یا رشته.شامل است(ر، "\"") یا رشته.شامل است(ر، "\n"):
        برگشت "\"" + رشته.جایگزینی(ر، "\""، "\"\"") + "\""
    پایان
    برگشت ر
پایان

تابع افزودن ردیف(ب &: رشته.سازنده رشته، خانه‌ها: رشته[]):
    هر ش، خانه در خانه‌ها:
        اگر ش > ۰:
            رشته.افزودن به بافر(ب، ",")
        پایان
        رشته.افزودن به بافر(ب، فیلد سی اس وی(خانه))
    پایان
    رشته.افزودن به بافر(ب، "\n")
پایان

تابع ریشه:
    ناپایا ب := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(ب)
    افزودن ردیف(ب، ["نام"، "شهر"، "یادداشت"])
    افزودن ردیف(ب، ["علی"، "تهران"، "چای دوست دارد"])
    افزودن ردیف(ب، ["سارا"، "شیراز, فارس"، "گفت \"سلام\""])
    چاپ رشته.رشته بافر(ب)
پایان
