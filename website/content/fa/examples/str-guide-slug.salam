واردسازی رشته

تابع نامک(عنوان: رشته): رشته:
    ناپایا ب := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(ب)
    کدها := رشته.کدنقطه ها(رشته.کوچک(رشته.پیرایش(عنوان)))
    دیرکن کدها.آزادکن()
    ناپایا خط تیره := نادرست
    هر کد در کدها:
        اگر رشته.الفبایی عددی است(کد):
            اگر خط تیره و وارونه رشته.بافر خالی است(ب):
                رشته.افزودن به بافر(ب، "-")
            پایان
            رشته.افزودن کدنقطه به بافر(ب، کد)
            خط تیره = نادرست
        وگرنه:
            خط تیره = درست
        پایان
    پایان
    برگشت رشته.رشته بافر(ب)
پایان

تابع ریشه:
    سرچاپ نامک("Hello, World!")
    سرچاپ نامک("  10 Tips for Faster   Builds ")
    سرچاپ نامک("سلام ۰.۵: چه چیزهایی تازه است؟")
    سرچاپ نامک("سلام دنیا، به سلام خوش آمدید")
پایان
