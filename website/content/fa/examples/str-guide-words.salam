واردسازی رشته

تابع ریشه:
    متن := "گربه نشست. سگ هم نشست، و گربه دوید! سگ ماند."
    پاک := رشته.جایگزینی(رشته.جایگزینی(رشته.جایگزینی(متن، "."، " ")، "،"، " ")، "!"، " ")
    واژه‌ها := رشته.واژه ها(پاک)
    دیرکن واژه‌ها.آزادکن()
    ناپایا شمار := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن شمار.آزادکن()
    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    دیرکن ترتیب.آزادکن()
    هر و۱ در واژه‌ها:
        اگر شمار.دارد(و۱):
            شمار.درج(و۱، شمار.بگیر(و۱) + ۱)
        وگرنه:
            شمار.درج(و۱، ۱)
            ترتیب.بیفزا(و۱)
        پایان
    پایان
    سرچاپ واژه‌ها.طول()، "واژه،"، ترتیب.طول()، "واژه‌ی متفاوت"
    هر و۱ در ترتیب:
        اگر شمار.بگیر(و۱) > ۱:
            سرچاپ و۱، شمار.بگیر(و۱)
        پایان
    پایان
پایان
