روال ریشه:
    متن := "  زبان برنامه‌نویسی سلام  "
    تمیز := متن.پیراست()
    سرچاپ تمیز
    سرچاپ "salam".طول(), "salam lang".زیررشته(۰، ۵)
    سرچاپ "salam lang".بیاب("lang")
    بخش‌ها := "سیب,انار,انگور".بشکاف(",")
    سرچاپ بخش‌ها.طول(), بخش‌ها.بگیر(۱)
    سرچاپ "سلام".پیوست("!")
    سرچاپ "سلام".شمارنویسه()
پایان
