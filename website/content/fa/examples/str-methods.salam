تابع ریشه:
    متن := "  زبان برنامه‌نویسی سلام  "
    تمیز := متن.پیراست()
    سرچاپ تمیز
    سرچاپ "salam".طول(), "salam lang".زیررشته(۰، ۵)
    سرچاپ "salam lang".بیاب("lang")
    بخش‌ها := "سیب,انار,انگور".بشکاف(",")
    سرچاپ بخش‌ها.طول(), بخش‌ها.بگیر(۱)
    سرچاپ "سلام".پیوست("!")
    سرچاپ "گزارش.pdf".ختم با(".pdf")، "سلام دنیا".شروع با("سلام")، "سلام دنیا".دربردارد("م د")
    سرچاپ "۴۲".به صحیح() + ۱، "2.5".به اعشار() * ۲.۰
پایان
