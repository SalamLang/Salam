واردسازی رشته

تابع ریشه:
    خط := "نام = سارا؛ شهر = شیراز؛ زبان = فارسی"
    پاره‌ها := رشته.تفکیک کردن(خط، "؛")
    دیرکن پاره‌ها.آزادکن()
    هر پاره در پاره‌ها:
        جفت := رشته.تفکیک کردن(پاره، "=")
        سرچاپ رشته.پیرایش(جفت.بگیر(۰)) + ":"، رشته.پیرایش(جفت.بگیر(۱))
        جفت.آزادکن()
    پایان
    مسیر := "/home/sara/notes/todo.txt"
    سرچاپ رشته.حذف پیشوند(مسیر، "/home/sara/")، رشته.آخرین اندیس(مسیر، "/")
    سرچاپ رشته.جایگزینی("۱۴۰۵-۰۷-۱۵"، "-"، "/")، رشته.شمارش("بادبادک"، "با")
    واژه‌ها := رشته.واژه ها("  فاصله‌های    زیادی   این‌جاست  ")
    دیرکن واژه‌ها.آزادکن()
    سرچاپ رشته.بپیوند(واژه‌ها، " ")
    سرچاپ رشته.بزرگ("salam")، رشته.شامل است(مسیر، "notes")
پایان
