ساختار نقطه:
    همگانی ایکس: صحیح = ۰
    همگانی وای: صحیح = ۰
پایان

روال صفر رونوشت(ن: نقطه):
    ن.ایکس = ۰
پایان

روال صفر کن(ن &: نقطه):
    ن.ایکس = ۰
پایان

روال ریشه:
    آغاز := نقطه { ایکس = ۳، وای = ۴ }
    ناپایا مقصد := آغاز
    مقصد.وای = ۱۰
    سرچاپ آغاز، مقصد
    سرچاپ آغاز == نقطه { ایکس = ۳، وای = ۴ }، آغاز == مقصد

    صفر رونوشت(مقصد)
    سرچاپ مقصد.ایکس
    صفر کن(مقصد)
    سرچاپ مقصد.ایکس
پایان
