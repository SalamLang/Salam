ساختار تاریخچه:
    همگانی ساخت: رشته = ""
    همگانی ویرایش: رشته = ""
    همگانی تابع شرح(): رشته:
        برگشت "ساخته در " + این.ساخت + "، ویرایش در " + این.ویرایش
    پایان
پایان

ساختار نوشته:
    همگانی شامل تاریخچه
    همگانی عنوان: رشته = ""
    همگانی تابع شرح(): رشته:
        برگشت این.عنوان + " (" + این.تاریخچه.شرح() + ")"
    پایان
پایان

تابع ریشه:
    ناپایا ن := نوشته { عنوان = "سلام"، ساخت = "۱۴۰۵/۰۷/۰۹" }
    ن.ویرایش = "۱۴۰۵/۰۷/۱۳"
    سرچاپ ن.شرح()
    سرچاپ ن.ساخت، ن.تاریخچه.ویرایش
    سرچاپ ن
پایان
