ساختار جانور:
    همگانی نام: رشته = ""
    همگانی تابع معرفی(): رشته:
        برگشت "من " + این.نام + " هستم"
    پایان
پایان

ساختار سگ:
    همگانی شامل جانور
    همگانی نژاد: رشته = ""
پایان

تابع ریشه:
    س := سگ { نام = "رکس"، نژاد = "شکاری" }
    سرچاپ س.معرفی()
    سرچاپ س.نام، س.نژاد
پایان
