ساختار حساب:
    دارنده: رشته = ""
    موجودی: صحیح = ۰
    همگانی ایستا روال باز کن(دارنده: رشته): حساب:
        برگشت حساب { دارنده = دارنده }
    پایان
    همگانی روال نام دارنده(): رشته:
        برگشت این.دارنده
    پایان
    همگانی روال مانده(): صحیح:
        برگشت این.موجودی
    پایان
    همگانی ناپایا روال واریز(مبلغ: صحیح): منطقی:
        اگر مبلغ <= ۰:
            برگشت نادرست
        پایان
        این.موجودی += مبلغ
        برگشت درست
    پایان
    همگانی ناپایا روال برداشت(مبلغ: صحیح): منطقی:
        اگر مبلغ <= ۰ یا مبلغ > این.موجودی:
            برگشت نادرست
        پایان
        این.موجودی -= مبلغ
        برگشت درست
    پایان
پایان

روال ریشه:
    ناپایا ح := حساب.باز کن("سارا")
    سرچاپ ح.واریز(۵۰۰)، ح.برداشت(۸۰۰)، ح.برداشت(۱۲۰)
    سرچاپ ح.نام دارنده()، ح.مانده()
پایان
