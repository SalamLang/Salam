ساختار حساب:
    دارنده: رشته = ""
    موجودی: صحیح = ۰
    همگانی ایستا تابع باز کن(دارنده: رشته): حساب:
        برگشت حساب { دارنده = دارنده }
    پایان
    همگانی تابع نام دارنده(): رشته:
        برگشت این.دارنده
    پایان
    همگانی تابع مانده(): صحیح:
        برگشت این.موجودی
    پایان
    همگانی ناپایا تابع واریز(مبلغ: صحیح): منطقی:
        اگر مبلغ <= ۰:
            برگشت نادرست
        پایان
        این.موجودی += مبلغ
        برگشت درست
    پایان
    همگانی ناپایا تابع برداشت(مبلغ: صحیح): منطقی:
        اگر مبلغ <= ۰ یا مبلغ > این.موجودی:
            برگشت نادرست
        پایان
        این.موجودی -= مبلغ
        برگشت درست
    پایان
پایان

تابع ریشه:
    ناپایا ح := حساب.باز کن("سارا")
    سرچاپ ح.واریز(۵۰۰)، ح.برداشت(۸۰۰)، ح.برداشت(۱۲۰)
    سرچاپ ح.نام دارنده()، ح.مانده()
پایان
