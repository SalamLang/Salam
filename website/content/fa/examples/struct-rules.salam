ساختار مشتری:
    همگانی میزبان: رشته
    همگانی کاربر: رشته = ""
    همگانی رمز: رشته = ""
    همگانی توکن: رشته = ""
    قاعده کاربر نیازمند رمز
    قاعده فقط یکی(کاربر، توکن)
پایان

تابع ریشه:
    الف := مشتری { میزبان = "db"، کاربر = "علی"، رمز = "راز" }
    سرچاپ الف.میزبان، الف.کاربر
    ب := مشتری { میزبان = "api"، توکن = "abc" }
    سرچاپ ب.میزبان، ب.توکن
پایان
