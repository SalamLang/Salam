ساختار پول:
    همگانی ریال: صحیح = ۰
    همگانی تابع to_str(): رشته:
        تومان := این.ریال / ۱۰
        باقی := این.ریال % ۱۰
        اگر باقی == ۰:
            برگشت "" + تومان + " تومان"
        پایان
        برگشت "" + تومان + " تومان و " + باقی + " ریال"
    پایان
پایان

ساختار کالا:
    همگانی نام: رشته = ""
    همگانی قیمت: پول = پول {}
پایان

تابع ریشه:
    خودکار := کالا { نام = "خودکار"، قیمت = پول { ریال = ۲۵۰۰۰ } }
    سرچاپ خودکار.قیمت
    سرچاپ خودکار
    سرچاپ "جمع: " + پول { ریال = ۱۲۰۵۵ }.to_str()
پایان
