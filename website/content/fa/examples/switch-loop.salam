روال ریشه:
    خوانده‌ها := [۲۱، -۱، ۲۳، ۹۹۹، ۲۵، ۰، ۳۰]
    ناپایا جمع := ۰
    ناپایا شمار := ۰
    هر خ در خوانده‌ها:
        ترابرد خ:
            -۱:
                سرچاپ "حسگر خاموش است، رد شد"
                گذر
            پایان
            ۹۹۹:
                سرچاپ "نشانه‌ی پایان داده، توقف"
                بشکن ۲
            پایان
            وگرنه:
                جمع += خ
                شمار += ۱
            پایان
        پایان
        سرچاپ "خوانده‌ی"، خ، "پذیرفته شد"
    پایان
    سرچاپ "میانگین"، شمار، "خوانده:"، جمع / شمار
پایان
