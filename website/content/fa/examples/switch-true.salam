تابع ریشه:
    تکرار ۳ در ای:
        دما := ای * ۱۵
        ترابرد درست:
            دما کوچکتر ۱۰:
                سرچاپ دما, "سرد"
                بشکن
            پایان
            دما کوچکتر ۲۵:
                سرچاپ دما, "معتدل"
                بشکن
            پایان
            وگرنه:
                سرچاپ دما, "گرم"
            پایان
        پایان
    پایان
    نمره := ۷۵
    ترابرد نمره:
        بزرگتربرابر ۹۰:
            سرچاپ "عالی"
            بشکن
        پایان
        بزرگتربرابر ۶۰:
            سرچاپ "قبول"
            بشکن
        پایان
        وگرنه:
            سرچاپ "مردود"
        پایان
    پایان
پایان
