تابع ریشه:
    تکرار ۳ در ای:
        دما := ای * ۱۵
        ترابرد درست:
            دما < ۱۰:
                سرچاپ دما, "سرد"
                بشکن
            پایان
            دما < ۲۵:
                سرچاپ دما, "معتدل"
                بشکن
            پایان
            وگرنه:
                سرچاپ دما, "گرم"
            پایان
        پایان
    پایان
    نمره := ۷۵
    ترابرد نمره:
        >= ۹۰:
            سرچاپ "عالی"
            بشکن
        پایان
        >= ۶۰:
            سرچاپ "قبول"
            بشکن
        پایان
        وگرنه:
            سرچاپ "مردود"
        پایان
    پایان
پایان
