تابع ریشه:
    تکرار ۵ در روز:
        ترابرد روز:
            ۰:
                سرچاپ روز, "شنبه، آغاز هفته"
                بشکن
            پایان
            ۱ تا ۳:
                سرچاپ روز, "میانه‌ی هفته"
                بشکن
            پایان
            وگرنه:
                سرچاپ روز, "نزدیک تعطیلی"
            پایان
        پایان
    پایان
پایان
