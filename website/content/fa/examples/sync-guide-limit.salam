واردسازی همگام سازی

ناپایا جاها := همگام سازی.نشانگر {}
ناپایا قفل := همگام سازی.قفل {}
ناپایا فعال‌ها := ۰
ناپایا بیشینه := ۰
ناپایا تمام‌شده := ۰

تابع دانلود():
    همگام سازی.گرفتن(جاها)
    همگام سازی.قفل کردن(قفل)
    فعال‌ها += ۱
    اگر فعال‌ها > بیشینه:
        بیشینه = فعال‌ها
    پایان
    همگام سازی.باز کردن قفل(قفل)
    همگام سازی.خواب میلی ثانیه(۲۰)
    همگام سازی.قفل کردن(قفل)
    فعال‌ها -= ۱
    تمام‌شده += ۱
    همگام سازی.باز کردن قفل(قفل)
    همگام سازی.رها کردن(جاها)
پایان

تابع ریشه:
    جاها = همگام سازی.نشانگر جدید(۲)
    قفل = همگام سازی.قفل جدید()
    ناپایا کارها := وکتور {} برگردان وکتور<صحیح۶۴>
    دیرکن کارها.آزادکن()
    تکرار ۶:
        کارها.بیفزا(نخ‌ساز(دانلود))
    پایان
    هر ن در کارها:
        نخ‌پیوند(ن)
    پایان
    سرچاپ "دانلودهای تمام‌شده:"، تمام‌شده
    سرچاپ "هیچ‌گاه بیش از دو تا با هم:"، بیشینه <= ۲
    همگام سازی.نابودسازی(قفل)
    همگام سازی.نابودسازی نشانگر(جاها)
پایان
