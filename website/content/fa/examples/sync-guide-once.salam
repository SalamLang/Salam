واردسازی همگام سازی

ناپایا آماده‌سازی := همگام سازی.یک بار {}
ناپایا جدول := وکتور {} برگردان وکتور<صحیح>
ناپایا ساخت‌ها := ۰

تابع ساختن جدول():
    ساخت‌ها += ۱
    تکرار ۱۰ در ای:
        جدول.بیفزا(ای * ای)
    پایان
پایان

تابع مربع(ع: صحیح): صحیح:
    همگام سازی.انجام(آماده‌سازی، (): ساختن جدول() پایان)
    برگشت جدول.بگیر(ع)
پایان

تابع کارگر():
    _ := مربع(۳)
پایان

تابع ریشه:
    آماده‌سازی = همگام سازی.یک بار جدید()
    الف := نخ‌ساز(کارگر)
    ب := نخ‌ساز(کارگر)
    پ := نخ‌ساز(کارگر)
    نخ‌پیوند(الف)
    نخ‌پیوند(ب)
    نخ‌پیوند(پ)
    سرچاپ "مربع ۷:"، مربع(۷)
    سرچاپ "جدول"، ساخت‌ها، "بار ساخته شد"
    جدول.آزادکن()
    همگام سازی.نابودسازی یک بار(آماده‌سازی)
پایان
