واردسازی همگام سازی

ناپایا قفل := همگام سازی.قفل {}
ناپایا کار هست := همگام سازی.متغیر شرط {}
ناپایا کارهای تمام‌شده := همگام سازی.گروه انتظار {}
ناپایا صف := وکتور {} برگردان وکتور<صحیح>
ناپایا برداشته := ۰
ناپایا صف تعطیل := نادرست
ناپایا هزینه‌ی کل := ۰

تابع کارگر():
    همگام سازی.قفل کردن(قفل)
    تا درست:
        تا برداشته == صف.طول() و وارونه صف تعطیل:
            همگام سازی.انتظار شرط(کار هست، قفل)
        پایان
        اگر برداشته == صف.طول(): بشکن پایان
        اندازه := صف.بگیر(برداشته)
        برداشته += ۱
        همگام سازی.باز کردن قفل(قفل)
        هزینه := اندازه * ۲
        همگام سازی.قفل کردن(قفل)
        هزینه‌ی کل += هزینه
        همگام سازی.اتمام(کارهای تمام‌شده)
    پایان
    همگام سازی.باز کردن قفل(قفل)
پایان

تابع ریشه:
    قفل = همگام سازی.قفل جدید()
    کار هست = همگام سازی.متغیر شرط جدید()
    کارهای تمام‌شده = همگام سازی.گروه انتظار جدید()
    کارگرها := [نخ‌ساز(کارگر)، نخ‌ساز(کارگر)، نخ‌ساز(کارگر)]
    تکرار ۱ تا ۱۰ در اندازه:
        همگام سازی.افزودن(کارهای تمام‌شده، ۱)
        همگام سازی.قفل کردن(قفل)
        صف.بیفزا(اندازه)
        همگام سازی.اعلام(کار هست)
        همگام سازی.باز کردن قفل(قفل)
    پایان
    همگام سازی.انتظار(کارهای تمام‌شده)
    سرچاپ "هر ۱۰ کار تمام شد، هزینه‌ی کل"، هزینه‌ی کل
    همگام سازی.قفل کردن(قفل)
    سرچاپ "کسی اعلام نکرد، ۲۰ میلی‌ثانیه صبر شد، بیدار شد:"، همگام سازی.انتظار شرط با مهلت(کار هست، قفل، ۲۰)
    صف تعطیل = درست
    همگام سازی.اعلام سراسری(کار هست)
    همگام سازی.باز کردن قفل(قفل)
    هر ن در کارگرها: نخ‌پیوند(ن) پایان
    سرچاپ "کارگرها ایستادند"
    صف.آزادکن()
    همگام سازی.نابودسازی گروه انتظار(کارهای تمام‌شده)
    همگام سازی.نابودسازی متغیر شرط(کار هست)
    همگام سازی.نابودسازی(قفل)
پایان
