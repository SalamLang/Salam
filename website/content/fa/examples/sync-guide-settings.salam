واردسازی همگام سازی

ناپایا تنظیمات := نگاشت {} برگردان نگاشت<رشته، صحیح>
ناپایا نگهبان := همگام سازی.قفل خواندن نوشتن {}
ناپایا خواندن‌ها := ۰
ناپایا قفل شمارش := همگام سازی.قفل {}

تابع خواننده():
    تکرار ۲۰۰:
        همگام سازی.قفل خواندن(نگهبان)
        سقف := تنظیمات.بگیر("سقف")
        همگام سازی.باز کردن قفل خواندن(نگهبان)
        اگر سقف > ۰:
            همگام سازی.قفل کردن(قفل شمارش)
            خواندن‌ها += ۱
            همگام سازی.باز کردن قفل(قفل شمارش)
        پایان
    پایان
پایان

تابع نویسنده():
    تکرار ۱ تا ۵ در م:
        همگام سازی.قفل نوشتن(نگهبان)
        تنظیمات.درج("سقف"، م * ۱۰)
        همگام سازی.باز کردن قفل نوشتن(نگهبان)
    پایان
پایان

تابع ریشه:
    نگهبان = همگام سازی.قفل خواندن نوشتن جدید()
    قفل شمارش = همگام سازی.قفل جدید()
    تنظیمات.درج("سقف"، ۵)
    الف := نخ‌ساز(خواننده)
    ب := نخ‌ساز(خواننده)
    ن := نخ‌ساز(نویسنده)
    نخ‌پیوند(الف)
    نخ‌پیوند(ب)
    نخ‌پیوند(ن)
    سرچاپ "تعداد خواندن:"، خواندن‌ها
    سرچاپ "سقف نهایی:"، تنظیمات.بگیر("سقف")
    تنظیمات.آزادکن()
    همگام سازی.نابودسازی(قفل شمارش)
    همگام سازی.نابودسازی قفل خواندن نوشتن(نگهبان)
پایان
