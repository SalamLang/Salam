واردسازی همگام سازی

ناپایا حساب‌ها := وکتور {} برگردان وکتور<صحیح>
ناپایا قفل حساب := همگام سازی.قفل {}
ناپایا گروه := همگام سازی.گروه انتظار {}

تابع انتقال(مبدا: صحیح، مقصد: صحیح، مبلغ: صحیح): منطقی:
    همگام سازی.قفل کردن(قفل حساب)
    دیرکن همگام سازی.باز کردن قفل(قفل حساب)
    اگر حساب‌ها.بگیر(مبدا) < مبلغ:
        برگشت نادرست
    پایان
    حساب‌ها.بنشان(مبدا، حساب‌ها.بگیر(مبدا) - مبلغ)
    حساب‌ها.بنشان(مقصد، حساب‌ها.بگیر(مقصد) + مبلغ)
    برگشت درست
پایان

تابع کارمند():
    تکرار ۱۰۰۰ در ای:
        انتقال(ای % ۳، (ای + ۱) % ۳، ۷)
    پایان
    همگام سازی.اتمام(گروه)
پایان

تابع ریشه:
    قفل حساب = همگام سازی.قفل جدید()
    گروه = همگام سازی.گروه انتظار جدید()
    حساب‌ها.بیفزا(۵۰۰)
    حساب‌ها.بیفزا(۳۰۰)
    حساب‌ها.بیفزا(۲۰۰)
    همگام سازی.افزودن(گروه، ۴)
    ناپایا کارگرها := وکتور {} برگردان وکتور<صحیح۶۴>
    دیرکن کارگرها.آزادکن()
    تکرار ۴:
        کارگرها.بیفزا(نخ‌ساز(کارمند))
    پایان
    همگام سازی.انتظار(گروه)
    هر ن در کارگرها:
        نخ‌پیوند(ن)
    پایان
    کل := حساب‌ها.بگیر(۰) + حساب‌ها.بگیر(۱) + حساب‌ها.بگیر(۲)
    سرچاپ "پول موجود در بانک:"، کل
    سرچاپ "انتقالی که بیش از موجودی است:"، انتقال(۰، ۱، ۱۰۰۰۰۰)
    حساب‌ها.آزادکن()
    همگام سازی.نابودسازی گروه انتظار(گروه)
    همگام سازی.نابودسازی(قفل حساب)
پایان
