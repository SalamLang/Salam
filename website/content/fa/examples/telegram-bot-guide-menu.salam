واردسازی تلگرام.بات

تابع فهرست(): رشته:
    ناپایا اول := وکتور {} برگردان وکتور<رشته>
    اول.بیفزا(بات.دکمه درون خطی("چای"، "order:tea"))
    اول.بیفزا(بات.دکمه درون خطی("قهوه"، "order:coffee"))
    ناپایا دوم := وکتور {} برگردان وکتور<رشته>
    دوم.بیفزا(بات.دکمه درون خطی با پیوند("ساعت کاری"، "https://example.com/hours"))
    ناپایا ردیف ها := وکتور {} برگردان وکتور<رشته>
    ردیف ها.بیفزا(بات.ردیف(اول))
    ردیف ها.بیفزا(بات.ردیف(دوم))
    برگشت بات.صفحه کلید درون خطی(ردیف ها)
پایان

تابع ریشه:
    ناپایا گزینه ها := بات.گزینه های ارسال {}
    گزینه ها.صفحه‌کلید = فهرست()
    سرچاپ بات.پاسخ پیام با گزینه ها(۴۲، "چه میل دارید؟"، گزینه ها)

    کلیک := بات.تجزیه بروزرسانی(`{"update_id":7,"callback_query":{"id":"cq7","data":"order:tea","from":{"id":42,"first_name":"سارا"},"message":{"message_id":31,"chat":{"id":42,"type":"private"}}}}`)
    اگر کلیک.فشردن دکمه دارد:
        پرسش := کلیک.فشردن دکمه
        سرچاپ بات.پاسخ فوری پرسمان بازخوان(پرسش.شناسه، "ثبت شد"، نادرست)
        اگر پرسش.پیام دارد:
            سرچاپ بات.پاسخ ویرایش متن پیام(پرسش.پیام.گفتگو.شناسه، پرسش.پیام.شناسه پیام، "یک چای برای " + پرسش.کاربر.نام، "")
        پایان
    پایان
پایان
