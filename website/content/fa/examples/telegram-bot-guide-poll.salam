واردسازی تلگرام.بات
واردسازی محیط

تابع ریشه:
    توکن := محیط.دریافت("TELEGRAM_TOKEN")
    اگر توکن.طول() == ۰:
        سرچاپ "TELEGRAM_TOKEN را برابر توکنی بگذارید که BotFather داده است"
        برگشت ۱
    پایان
    ربات := بات.بات جدید(توکن)
    من := بات.دریافت من(ربات)
    اگر وارونه بات.موفق(من):
        سرچاپ "توکن پذیرفته نشد:"، من.کد خطا، من.توضیح، من.خطای شبکه
        برگشت ۱
    پایان
    _ := بات.حذف وب هوک(ربات)
    ناپایا دستورها := وکتور {} برگردان وکتور<رشته>
    دستورها.بیفزا(بات.دستور بات("start"، "سلام کردن"))
    دستورها.بیفزا(بات.دستور بات("echo"، "تکرار متن شما"))
    _ := بات.تنظیم دستورات بات(ربات، دستورها)
    سرچاپ "در حال دریافت پیام‌ها، برای توقف Ctrl+C را بزنید"
    بات.حلقه دریافت(ربات، ۳۰، (ب: بات.بروزرسانی):
        اگر وارونه ب.پیام دارد:
            برگشت
        پایان
        پ := ب.پیام
        _ := بات.ارسال کنش گفتگو(ربات، پ.گفتگو.شناسه، "typing")
        اگر بات.نام دستور(پ.متن) == "echo":
            _ := بات.ارسال پیام(ربات، پ.گفتگو.شناسه، بات.آرگومان های دستور(پ.متن))
        وگرنه:
            _ := بات.ارسال پیام(ربات، پ.گفتگو.شناسه، "سلام " + پ.فرستنده.نام + "، بنویس /echo و یک متن")
        پایان
    پایان)
پایان
