واردسازی تلگرام.بات
واردسازی رشته

تابع پاسخ(ب: بات.بروزرسانی): رشته:
    اگر وارونه ب.پیام دارد:
        برگشت ""
    پایان
    پ := ب.پیام
    اگر وارونه بات.دستور است(پ.متن):
        برگشت بات.پاسخ پیام(پ.گفتگو.شناسه، "گفتی: " + پ.متن)
    پایان
    ترابرد بات.نام دستور(پ.متن):
        "start":
            برگشت بات.پاسخ پیام(پ.گفتگو.شناسه، "سلام " + پ.فرستنده.نام + "! بنویس /add 2 3")
        پایان
        "add":
            تکه ها := رشته.تفکیک کردن(بات.آرگومان های دستور(پ.متن)، " ")
            اگر تکه ها.طول() != ۲:
                برگشت بات.پاسخ پیام(پ.گفتگو.شناسه، "شکل درست: /add A B")
            پایان
            جمع := رشته.تبدیل به عدد(تکه ها.بگیر(۰)) + رشته.تبدیل به عدد(تکه ها.بگیر(۱))
            برگشت بات.پاسخ پیام(پ.گفتگو.شناسه، رشته.از عدد(جمع))
        پایان
    پایان
    برگشت بات.پاسخ پیام(پ.گفتگو.شناسه، "این دستور را نمی‌شناسم")
پایان

تابع ریشه:
    صندوق := [`{"update_id":1,"message":{"message_id":1,"text":"/start","chat":{"id":42,"type":"private"},"from":{"id":42,"first_name":"سارا"}}}`،
        `{"update_id":2,"message":{"message_id":2,"text":"/add 2 3","chat":{"id":42,"type":"private"}}}`،
        `{"update_id":3,"message":{"message_id":3,"text":"/add 2","chat":{"id":42,"type":"private"}}}`،
        `{"update_id":4,"message":{"message_id":4,"text":"/weather@my_bot","chat":{"id":42,"type":"private"}}}`،
        `{"update_id":5,"message":{"message_id":5,"text":"صبح بخیر","chat":{"id":42,"type":"private"}}}`]
    هر خام در صندوق:
        سرچاپ پاسخ(بات.تجزیه بروزرسانی(خام))
    پایان
پایان
