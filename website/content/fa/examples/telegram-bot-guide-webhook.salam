واردسازی تلگرام.بات
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی محیط

ناپایا راز := ""

تابع قلاب(ز: صحیح۶۴):
    اگر اچ تی تی پی.سرصفحه(ز، بات.سرآیند راز) != راز:
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۱)
        اچ تی تی پی.متن(ز، "")
        برگشت
    پایان
    ب := بات.تجزیه بروزرسانی(اچ تی تی پی.بدنه(ز))
    اگر وارونه ب.پیام دارد:
        اچ تی تی پی.متن(ز، "")
        برگشت
    پایان
    پ := ب.پیام
    اچ تی تی پی.تنظیم سرصفحه(ز، "Content-Type"، "application/json")
    اچ تی تی پی.متن(ز، بات.پاسخ پیام(پ.گفتگو.شناسه، "رسید: " + پ.متن))
پایان

تابع ریشه:
    توکن := محیط.دریافت("TELEGRAM_TOKEN")
    نشانی عمومی := محیط.دریافت("PUBLIC_URL")
    راز = محیط.دریافت("WEBHOOK_SECRET")
    اگر توکن.طول() == ۰ یا نشانی عمومی.طول() == ۰ یا راز.طول() == ۰:
        سرچاپ "TELEGRAM_TOKEN و PUBLIC_URL و WEBHOOK_SECRET را تنظیم کنید"
        برگشت ۱
    پایان
    ربات := بات.بات جدید(توکن)
    تنظیم := بات.تنظیم وب هوک با رمز(ربات، نشانی عمومی + "/telegram"، راز)
    اگر وارونه بات.موفق(تنظیم):
        سرچاپ "تنظیم وب هوک شکست خورد:"، تنظیم.کد خطا، تنظیم.توضیح
        برگشت ۱
    پایان
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/telegram"، قلاب)
    ناپایا س := اچ تی تی پی.سرور جدید(۸۴۴۳)
    اچ تی تی پی.استفاده(س، م)
    سرچاپ "وب هوک روی درگاه ۸۴۴۳"
    اچ تی تی پی.اجرا(س)
پایان
