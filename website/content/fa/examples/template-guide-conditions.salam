واردسازی قالب

تابع نشان(کاربر: رشته، مدیر: رشته، نخوانده: رشته): رشته:
    ناپایا ز := قالب.زمینه جدید()
    دیرکن ز.آزادکن()
    ز.درج("کاربر"، کاربر)
    ز.درج("مدیر"، مدیر)
    ز.درج("نخوانده"، نخوانده)
    برگشت قالب.رندر("{{کاربر}}{{#if مدیر}} [مدیر]{{/if}}: {{#if نخوانده}}{{نخوانده}} پیام تازه{{else}}پیام تازه‌ای نیست{{/if}}"، ز)
پایان

تابع ریشه:
    سرچاپ نشان("سارا"، "true"، "۳")
    سرچاپ نشان("رضا"، "false"، "0")
    سرچاپ نشان("مینا"، ""، "۱۲")
    سرچاپ نشان("علی"، "بله"، "")
پایان
