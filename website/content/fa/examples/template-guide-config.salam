واردسازی قالب

تابع پیکربندی سایت(نام: رشته، درگاه: رشته، رمزنگاری: رشته): رشته:
    ناپایا ز := قالب.زمینه جدید()
    دیرکن ز.آزادکن()
    ز.درج("نام"، نام)
    ز.درج("درگاه"، درگاه)
    ز.درج("رمزنگاری"، رمزنگاری)
    ناپایا متن := "server {\n"
    متن = متن + "    server_name " + قالب.متغیر("نام") + ";\n"
    متن = متن + "    listen {{درگاه}}{{#if رمزنگاری}} ssl{{/if}};\n"
    متن = متن + "    root /srv/{{نام}}/public;\n}"
    برگشت قالب.رندر(متن، ز)
پایان

تابع ریشه:
    سرچاپ پیکربندی سایت("blog.example"، "443"، "on")
    سرچاپ پیکربندی سایت("intranet.local"، "8080"، "")
    ناپایا خالی := قالب.زمینه جدید()
    دیرکن خالی.آزادکن()
    سرچاپ "[" + قالب.رندر("{{ناموجود}}"، خالی) + "]"
    سرچاپ قالب.رندر("چپ {{باز"، خالی)
پایان
