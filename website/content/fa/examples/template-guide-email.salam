واردسازی قالب

تابع ریشه:
    نامه := "سلام {{نام}}،\n\nسفارش {{سفارش}} شما ارسال شد.\n{{#if رهگیری}}از این نشانی پیگیری کنید: {{رهگیری}}\n{{/if}}{{! خط رهگیری اختیاری است }}\nبا سپاس،\n{{فروشگاه}}"

    ناپایا ز := قالب.زمینه جدید()
    دیرکن ز.آزادکن()
    ز.درج("نام"، "سارا")
    ز.درج("سفارش"، "#۱۰۴۲")
    ز.درج("رهگیری"، "https://post.example/T-77")
    ز.درج("فروشگاه"، "کتاب‌فروشی کوچه")
    سرچاپ قالب.رندر(نامه، ز)
    سرچاپ "-----"
    ز.درج("نام"، "رضا")
    ز.درج("سفارش"، "#۱۰۴۳")
    ز.درج("رهگیری"، "")
    سرچاپ قالب.رندر(نامه، ز)
پایان
