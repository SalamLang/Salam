واردسازی قالب

ساختار کتاب:
    همگانی عنوان: رشته = ""
    همگانی نویسنده: رشته = ""
پایان

تابع ریشه:
    ناپایا کتاب‌ها := وکتور {} برگردان وکتور<کتاب>
    دیرکن کتاب‌ها.آزادکن()
    کتاب‌ها.بیفزا(کتاب { عنوان = "نمک و جوهر"، نویسنده = "ن. کریمی" })
    کتاب‌ها.بیفزا(کتاب { عنوان = "<script>alert(1)</script>"، نویسنده = "یک بازدیدکننده" })

    ردیف := "<li>{{عنوان}} نوشته‌ی {{نویسنده}}</li>\n"
    ناپایا ردیف‌ها := ""
    ناپایا مورد := قالب.زمینه جدید()
    دیرکن مورد.آزادکن()
    هر ک در کتاب‌ها:
        مورد.درج("عنوان"، ک.عنوان)
        مورد.درج("نویسنده"، ک.نویسنده)
        ردیف‌ها = ردیف‌ها + قالب.رندر اچ تی ام ال(ردیف، مورد)
    پایان

    ناپایا صفحه‌ی اصلی := قالب.زمینه جدید()
    دیرکن صفحه‌ی اصلی.آزادکن()
    صفحه‌ی اصلی.درج("سرتیتر"، "کتاب‌های تازه")
    صفحه‌ی اصلی.درج("موردها"، ردیف‌ها)
    اسکلت := "<h1>{{سرتیتر}}</h1>\n<ul>\n{{موردها}}</ul>"
    سرچاپ قالب.رندر(اسکلت، صفحه‌ی اصلی)
پایان
