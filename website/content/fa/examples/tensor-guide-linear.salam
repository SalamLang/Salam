واردسازی تانسور

تابع ماتریس(سطرها: صحیح، ستون‌ها: صحیح، مقدارها: اعشار۶۴[]): تانسور.تانسور:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۳۲>
    هر م در مقدارها:
        داده.بیفزا(م برگردان اعشار۳۲)
    پایان
    شکل := تانسور.شکل دو(سطرها، ستون‌ها)
    برگشت تانسور.از آرایه(شکل، داده)
پایان

تابع ریشه:
    ورودی‌ها := ماتریس(۳، ۲، [۱.۰، ۲.۰، ۰.۰، ۱.۰، ۳.۰، ۰.۰])
    وزن := ماتریس(۲، ۳، [۱.۰، ۰.۰، -۱.۰، ۰.۵، ۱.۰، ۲.۰])
    سوگیری := ماتریس(۱، ۳، [۰.۰، -۱.۰، ۰.۵])
    امتیازها := تانسور.ضرب ماتریسی(ورودی‌ها، وزن) + سوگیری
    سرچاپ "امتیازها"، تانسور.رشته شکل(امتیازها)، تانسور.به رشته(امتیازها)
    پنهان := تانسور.یکسوساز(امتیازها)
    سرچاپ "یکسوساز"، تانسور.به رشته(پنهان)
    برترین := تانسور.نمایه بیشینه محور(امتیازها، ۱، نادرست)
    سرچاپ "بهترین دسته‌ی هر سطر"، تانسور.به رشته(برترین)
پایان
