واردسازی تانسور

تابع ریشه:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۳۲>
    هر م در [۲.۰، ۲۰.۰، ۴.۰، ۴۰.۰، ۴.۰، ۴۰.۰، ۴.۰، ۴۰.۰، ۵.۰، ۵۰.۰، ۵.۰، ۵۰.۰، ۷.۰، ۷۰.۰، ۹.۰، ۹۰.۰]:
        داده.بیفزا(م برگردان اعشار۳۲)
    پایان
    شکل := تانسور.شکل دو(۸، ۲)
    نمونه‌ها := تانسور.از آرایه(شکل، داده)
    میانگین := تانسور.میانگین محور(نمونه‌ها، ۰، درست)
    سرچاپ "میانگین"، تانسور.رشته شکل(میانگین)، تانسور.به رشته(میانگین)
    مرکزی := نمونه‌ها - میانگین
    پراکندگی := تانسور.ریشه دوم(تانسور.میانگین محور(تانسور.مربع(مرکزی)، ۰، درست))
    سرچاپ "پراکندگی"، تانسور.به رشته(پراکندگی)
    مقیاس شده := مرکزی / پراکندگی
    سرچاپ "ستون اول"، تانسور.به رشته(تانسور.باریک‌سازی(مقیاس شده، ۱، ۰، ۱))
    سرچاپ "ستون‌ها یکی شدند:"، تانسور.همه نزدیک(تانسور.باریک‌سازی(مقیاس شده، ۱، ۰، ۱)، تانسور.باریک‌سازی(مقیاس شده، ۱، ۱، ۱)، ۰.۰۰۰۱)
    سرچاپ "میانگین تازه"، تانسور.به رشته(تانسور.میانگین محور(مقیاس شده، ۰، نادرست))
پایان
