واردسازی تانسور

تابع ریشه:
    نام ها := ["گربه"، "سگ"، "خودرو"، "اتوبوس"]
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۳۲>
    هر م در [۰.۹، ۰.۱، ۰.۰، ۰.۸، ۰.۲، ۰.۰، ۰.۰، ۰.۱، ۰.۹، ۰.۱، ۰.۰، ۰.۸]:
        داده.بیفزا(م برگردان اعشار۳۲)
    پایان
    شکل := تانسور.شکل دو(۴، ۳)
    بردارها := تانسور.از آرایه(شکل، داده)
    ناپایا داده پرسش := وکتور {} برگردان وکتور<اعشار۳۲>
    هر م در [۰.۷، ۰.۳، ۰.۰]:
        داده پرسش.بیفزا(م برگردان اعشار۳۲)
    پایان
    شکل پرسش := تانسور.شکل یک(۳)
    پرسش := تانسور.از آرایه(شکل پرسش، داده پرسش)
    امتیازها := تانسور.ضرب در بردار(بردارها، پرسش)
    ناپایا ترتیب := تانسور.تهی()
    برترها := تانسور.کِی برتر(امتیازها، ۲، درست، ترتیب)
    تکرار ۲ در ی:
        شماره := ترتیب.عنصر(ی) برگردان صحیح
        سرچاپ نام ها[شماره]، (برترها.عنصر(ی) * ۱۰۰.۰ + ۰.۵) برگردان صحیح
    پایان
پایان
