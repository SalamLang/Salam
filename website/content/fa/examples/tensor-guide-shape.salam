واردسازی تانسور

تابع ریشه:
    ناپایا خوانده‌ها := وکتور {} برگردان وکتور<اعشار۳۲>
    هر مصرف در [۱.۵، ۳.۵، ۴.۲۵، ۲.۰، ۱.۰، ۲.۷۵، ۵.۵، ۲.۲۵، ۰.۷۵، ۳.۰، ۳.۲۵، ۱.۷۵]:
        خوانده‌ها.بیفزا(مصرف برگردان اعشار۳۲)
    پایان
    تخت := تانسور.از آرایه(تانسور.شکل یک(۱۲)، خوانده‌ها)
    ناپایا شکل روزها := تانسور.شکل دو(۳، ۴)
    روزها := تانسور.تغییر شکل(تخت، شکل روزها)
    سرچاپ "روز در بازه"، تانسور.رشته شکل(روزها)
    سرچاپ "هر روز"، تانسور.به رشته(تانسور.مجموع محور(روزها، ۱، نادرست))
    سرچاپ "هر بازه"، تانسور.به رشته(تانسور.مجموع محور(روزها، ۰، نادرست))
    سرچاپ "جمع تجمعی روز دوم"، تانسور.به رشته(تانسور.جمع تجمعی(تانسور.برش محور صفر(روزها، ۱، ۱)، ۱))
    اوج‌ها := تانسور.بزرگتر از عدد(روزها، ۴.۰)
    سرچاپ "خوانده‌های اوج"، تانسور.به رشته(تانسور.پرکردن ماسک‌شده(روزها، تانسور.کوچکتر از عدد(روزها، ۴.۰)، ۰.۰))
    سرچاپ "شمار اوج‌ها"، تانسور.مجموع همه(اوج‌ها)
    سرچاپ "بازه‌ها در سطرها"، تانسور.رشته شکل(تانسور.ترانهاده دوبعدی(روزها))
    ناپایا شکل ناجور := تانسور.شکل دو(۵، ۲)
    سرچاپ "تغییر شکل ۱۲ به 5x2:"، تانسور.رشته شکل(تانسور.تغییر شکل(تخت، شکل ناجور))
پایان
