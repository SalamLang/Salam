واردسازی پایانه

تابع خط وضعیت(برچسب: رشته، پیام: رشته): رشته:
    ناپایا نشان := "[" + برچسب + "]"
    اگر برچسب == "ok":
        نشان = پایانه.سبز(نشان)
    وگرنه برچسب == "warn":
        نشان = پایانه.زرد(نشان)
    وگرنه برچسب == "fail":
        نشان = پایانه.ضخیم(پایانه.قرمز(نشان))
    پایان
    برگشت پایانه.پرکردن راست(نشان، ۷) + پیام
پایان

تابع ریشه:
    پایانه.تنظیم حالت رنگ(پایانه.رنگ همیشه)
    خط := خط وضعیت("warn"، "حافظه‌ی نهان ۹۱٪ پر است")
    سرچاپ "بایت:"، خط.طول()، "| ستون روی صفحه:"، پایانه.پهنا(خط)
    ناپایا پرونده گزارش := وکتور {} برگردان وکتور<رشته>
    دیرکن پرونده گزارش.آزادکن()
    پرونده گزارش.بیفزا(پایانه.پاک‌سازی(خط وضعیت("ok"، "تنظیمات بارگذاری شد")))
    پرونده گزارش.بیفزا(پایانه.پاک‌سازی(خط))
    پرونده گزارش.بیفزا(پایانه.پاک‌سازی(خط وضعیت("fail"، "به کارساز رایانامه دسترسی نشد")))
    سرچاپ "--- پرونده‌ی گزارش ---"
    هر مدخل در پرونده گزارش:
        سرچاپ مدخل
    پایان
پایان
