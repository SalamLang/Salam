واردسازی پایانه

تابع کشیدن(گزینه‌ها: وکتور<رشته>، انتخاب‌شده: صحیح):
    پایانه.نوشتن(پایانه.دنباله پاک‌سازی صفحه())
    پایانه.نوشتن(پایانه.ضخیم("یک زبان برگزینید (پیکان‌ها، Enter، q)") + "\r\n\r\n")
    هر ای، گزینه در گزینه‌ها:
        اگر ای == انتخاب‌شده:
            پایانه.نوشتن(پایانه.برعکس(" > " + گزینه + " ") + "\r\n")
        وگرنه:
            پایانه.نوشتن("   " + گزینه + "\r\n")
        پایان
    پایان
    پایانه.تخلیه()
پایان

تابع ریشه:
    اگر وارونه پایانه.پایانه است(پایانه.شناسه ورودی):
        نادرست‌سرچاپ "این برنامه را در پایانه اجرا کنید"
        برگشت ۱
    پایان
    ناپایا گزینه‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن گزینه‌ها.آزادکن()
    گزینه‌ها.بیفزا("سلام")
    گزینه‌ها.بیفزا("C")
    گزینه‌ها.بیفزا("Go")
    گزینه‌ها.بیفزا("Rust")
    ناپایا وضعیت := پایانه.حالت خام(پایانه.شناسه ورودی)
    پایانه.ورود به صفحه جایگزین()
    پایانه.پنهان‌سازی مکان‌نما()
    ناپایا انتخاب‌شده := ۰
    ناپایا برگزیده := -۱
    تا برگزیده < ۰:
        کشیدن(گزینه‌ها، انتخاب‌شده)
        ک := پایانه.خواندن کلید()
        اگر ک.کد == پایانه.کلید بالا و انتخاب‌شده > ۰:
            انتخاب‌شده -= ۱
        وگرنه ک.کد == پایانه.کلید پایین و انتخاب‌شده < گزینه‌ها.طول() - ۱:
            انتخاب‌شده += ۱
        وگرنه ک.کد == پایانه.کلید ورود:
            برگزیده = انتخاب‌شده
        وگرنه ک.کد == پایانه.کلید انتهای ورودی یا (ک.کد == پایانه.کلید نویسه و ک.نویسه == "q"):
            بشکن
        پایان
    پایان
    پایانه.نمایش مکان‌نما()
    پایانه.خروج از صفحه جایگزین()
    پایانه.بازگردانی(وضعیت)
    اگر برگزیده >= ۰:
        سرچاپ "برگزیدید:"، گزینه‌ها.بگیر(برگزیده)
    پایان
    برگشت ۰
پایان
