واردسازی پایانه

ساختار سرویس:
    همگانی نام: رشته = ""
    همگانی وضعیت: رشته = ""
    همگانی حافظه: صحیح۶۴ = ۰
    همگانی زمان کار: صحیح۶۴ = ۰
پایان

تابع وضعیت رنگی(س: رشته): رشته:
    اگر س == "فعال":
        برگشت پایانه.سبز(س)
    وگرنه س == "ناقص":
        برگشت پایانه.زرد(س)
    پایان
    برگشت پایانه.قرمز(س)
پایان

تابع ریشه:
    سرویس‌ها := [
        سرویس { نام = "api"، وضعیت = "فعال"، حافظه = ۱۵۷۲۸۶۴۰۰، زمان کار = ۹۳۷۸۴۰۰۰ }،
        سرویس { نام = "search-indexer"، وضعیت = "ناقص"، حافظه = ۱۰۷۳۷۴۱۸۲۴، زمان کار = ۴۵۰۰۰۰۰ }،
        سرویس { نام = "mail"، وضعیت = "متوقف"، حافظه = ۰، زمان کار = ۰ }
    ]
    سرچاپ پایانه.ضخیم(پایانه.پرکردن راست("سرویس"، ۱۴) + " " + پایانه.پرکردن راست("وضعیت"، ۹) + " " + پایانه.پرکردن چپ("حافظه"، ۹) + "  مدت کار")
    هر س در سرویس‌ها:
        نام := پایانه.پرکردن راست(پایانه.کوتاه‌سازی(س.نام، ۱۴)، ۱۴)
        وضعیت := پایانه.پرکردن راست(وضعیت رنگی(س.وضعیت)، ۹)
        ناپایا کارکرد := "-"
        اگر س.زمان کار > ۰:
            کارکرد = پایانه.قالب‌بندی مدت(س.زمان کار)
        پایان
        سرچاپ نام، وضعیت، پایانه.پرکردن چپ(پایانه.قالب‌بندی بایت(س.حافظه)، ۹)، ""، کارکرد
    پایان
پایان
