واردسازی آزمایش

تابع خواندن درگاه(متن: رشته، خطا &: رشته): صحیح:
    خطا = ""
    اگر متن.طول() == ۰:
        خطا = "درگاه خالی است"
        برگشت ۰
    پایان
    عدد := متن.به صحیح()
    اگر عدد < ۱ یا عدد > ۶۵۵۳۵:
        خطا = "درگاه باید میان ۱ و ۶۵۵۳۵ باشد"
        برگشت ۰
    پایان
    برگشت عدد
پایان

تابع ریشه:
    ناپایا خطا := ""
    آزمایش.ادعای برابری عدد(خواندن درگاه("۸۰۸۰"، خطا)، ۸۰۸۰)
    آزمایش.ادعای برابری رشته(خطا، "")

    آزمایش.ادعای برابری عدد(خواندن درگاه(""، خطا)، ۰)
    آزمایش.ادعای شامل بودن(خطا، "خالی")

    آزمایش.ادعای برابری عدد(خواندن درگاه("۷۰۰۰۰"، خطا)، ۰)
    آزمایش.ادعای نابرابری رشته(خطا، "")
    آزمایش.ادعای شامل بودن(خطا، "۶۵۵۳۵")
    برگشت آزمایش.خلاصه()
پایان
