واردسازی آزمایش

تابع حروف اول(نام: رشته): رشته:
    تکه‌ها := نام.بشکاف(" ")
    ناپایا نتیجه := ""
    هر ت در تکه‌ها:
        نتیجه = نتیجه + ت.زیررشته(۰، ۱)
    پایان
    برگشت نتیجه
پایان

تابع ریشه:
    آزمایش.ادعای برابری رشته(حروف اول("Ada Lovelace")، "AL")
    آزمایش.ادعای برابری رشته(حروف اول("grace hopper")، "GH")
    آزمایش.ادعای برابری عدد(آزمایش.ناموفق()، ۱)
    شکست‌ها := آزمایش.خلاصه()
    سرچاپ "کد خروجی‌ای که CI می‌بیند:"، شکست‌ها
پایان
