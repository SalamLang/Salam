واردسازی آزمایش

تابع محدود کن(م: صحیح، کمینه: صحیح، بیشینه: صحیح): صحیح:
    اگر م < کمینه:
        برگشت کمینه
    پایان
    اگر م > بیشینه:
        برگشت بیشینه
    پایان
    برگشت م
پایان

تابع میانگین(مقدارها: وکتور<صحیح>): اعشار۶۴:
    اگر مقدارها.طول() == ۰:
        برگشت ۰.۰
    پایان
    ناپایا جمع := ۰
    هر م در مقدارها:
        جمع += م
    پایان
    برگشت جمع برگردان اعشار۶۴ / مقدارها.طول() برگردان اعشار۶۴
پایان

تابع گزارش(نام: رشته، شکست قبلی: صحیح):
    اگر آزمایش.ناموفق() == شکست قبلی:
        سرچاپ "درست"، نام
    وگرنه:
        سرچاپ "شکست"، نام
    پایان
پایان

تابع آزمون محدود کن():
    قبلی := آزمایش.ناموفق()
    آزمایش.ادعای برابری عدد(محدود کن(۵، ۰، ۱۰)، ۵)
    آزمایش.ادعای برابری عدد(محدود کن(-۳، ۰، ۱۰)، ۰)
    آزمایش.ادعای برابری عدد(محدود کن(۴۲، ۰، ۱۰)، ۱۰)
    گزارش("محدود کن"، قبلی)
پایان

تابع آزمون میانگین():
    قبلی := آزمایش.ناموفق()
    ناپایا م := وکتور {} برگردان وکتور<صحیح>
    دیرکن م.آزادکن()
    آزمایش.ادعای برابری اعشار(میانگین(م)، ۰.۰، ۰.۰۰۰۰۰۱)
    م.بیفزا(۱)
    م.بیفزا(۲)
    م.بیفزا(۴)
    آزمایش.ادعای برابری اعشار(میانگین(م)، ۲.۳۳۳۳۳۳، ۰.۰۰۰۰۱)
    گزارش("میانگین"، قبلی)
پایان

تابع ریشه:
    آزمون محدود کن()
    آزمون میانگین()
    برگشت آزمایش.خلاصه()
پایان
