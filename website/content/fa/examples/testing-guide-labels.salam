واردسازی آزمایش
واردسازی رشته

ساختار مورد:
    همگانی نام: رشته = ""
    همگانی ورودی: رشته = ""
    همگانی انتظار: رشته = ""
پایان

تابع نامک(عنوان: رشته): رشته:
    برگشت رشته.جایگزینی(رشته.کوچک(عنوان)، " "، "-")
پایان

تابع بررسی(م: مورد):
    نتیجه := نامک(م.ورودی)
    آزمایش.ادعا با پیام(نتیجه == م.انتظار، م.نام + ": به‌دست‌آمده [" + نتیجه + "] مورد انتظار [" + م.انتظار + "]")
پایان

تابع ریشه:
    موردها := [
        مورد { نام = "واژه‌های ساده"، ورودی = "Hello World"، انتظار = "hello-world" }،
        مورد { نام = "فاصله‌ی پایانی"، ورودی = "Release notes "، انتظار = "release-notes" }،
        مورد { نام = "یک واژه"، ورودی = "Salam"، انتظار = "salam" }
    ]
    هر م در موردها:
        بررسی(م)
    پایان
    شکست‌ها := آزمایش.خلاصه()
    سرچاپ "کد خروج:"، شکست‌ها > ۰ ? ۱ : ۰
پایان
