واردسازی آزمایش
واردسازی رشته

ساختار مورد:
    همگانی عدد: صحیح = ۰
    همگانی انتظار: رشته = ""
پایان

تابع فیزباز(عدد: صحیح): رشته:
    اگر عدد % ۱۵ == ۰:
        برگشت "FizzBuzz"
    وگرنه عدد % ۳ == ۰:
        برگشت "Fizz"
    وگرنه عدد % ۵ == ۰:
        برگشت "Buzz"
    پایان
    برگشت رشته.از عدد(عدد)
پایان

تابع ریشه:
    موردها := [
        مورد { عدد = ۱، انتظار = "1" }،
        مورد { عدد = ۳، انتظار = "Fizz" }،
        مورد { عدد = ۵، انتظار = "Buzz" }،
        مورد { عدد = ۹، انتظار = "Fizz" }،
        مورد { عدد = ۱۰، انتظار = "Buzz" }،
        مورد { عدد = ۱۵، انتظار = "FizzBuzz" }،
        مورد { عدد = ۹۸، انتظار = "98" }
    ]
    هر م در موردها:
        آزمایش.ادعای برابری رشته(فیزباز(م.عدد)، م.انتظار)
    پایان
    برگشت آزمایش.خلاصه()
پایان
