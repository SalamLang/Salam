واردسازی متن.تفاوت
واردسازی سیستم پرونده
واردسازی سیستم پرونده.مسیر
واردسازی سیستم عامل.موقت

تابع ریشه:
    کار := موقت.پوشه موقت()
    دیرکن موقت.حذف پوشه(کار)
    چپ := مسیر.پیوند(کار، "config.old")
    راست := مسیر.پیوند(کار، "config.new")
    سیستم پرونده.نوشتن متن(چپ، "port=80\nhost=a\nmode=safe\n")
    سیستم پرونده.نوشتن متن(راست، "port=8080\nhost=a\nmode=safe\ndebug=1\n")
    متغیر_patch := تفاوت.تفاوت یکپارچه متن(سیستم پرونده.خواندن متن(چپ)، سیستم پرونده.خواندن متن(راست)، "config.old"، "config.new"، 1)
    اگر متغیر_patch.طول() برابر 0:
        سرچاپ "the files are the same"
    وگرنه:
        چاپ متغیر_patch
    پایان
    سرچاپ "same file:"، تفاوت.تفاوت یکپارچه متن("x\n"، "x\n"، "a"، "b"، 3).طول() برابر 0
پایان
