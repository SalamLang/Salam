واردسازی متن.تفاوت
واردسازی سیستم پرونده.پرونده
واردسازی سیستم پرونده.مسیر
واردسازی سیستم عامل.موقت

تابع ریشه:
    work := موقت.پوشه موقت()
    دیرکن موقت.حذف پوشه(work)
    left := مسیر.پیوند(work، "config.old")
    right := مسیر.پیوند(work، "config.new")
    پرونده.نوشتن متن(left، "port=80\nhost=a\nmode=safe\n")
    پرونده.نوشتن متن(right، "port=8080\nhost=a\nmode=safe\ndebug=1\n")
    patch := تفاوت.تفاوت یکپارچه متن(پرونده.خواندن متن(left)، پرونده.خواندن متن(right)، "config.old"، "config.new"، 1)
    اگر patch.طول() برابر 0:
        سرچاپ "the files are the same"
    وگرنه:
        چاپ patch
    پایان
    سرچاپ "same file:"، تفاوت.تفاوت یکپارچه متن("x\n"، "x\n"، "a"، "b"، 3).طول() برابر 0
پایان
