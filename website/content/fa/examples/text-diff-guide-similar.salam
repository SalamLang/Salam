// زبان: فارسی
واردسازی متن.تفاوت

تابع نزدیک ترین(واژه: رشته، گزینه ها: رشته[]): رشته:
    ناپایا برگزیده := ""
    ناپایا بهترین امتیاز := 0.0
    هر گزینه در گزینه ها:
        امتیاز := تفاوت.نسبت شباهت متن(واژه، گزینه)
        اگر امتیاز بزرگتر بهترین امتیاز:
            بهترین امتیاز = امتیاز
            برگزیده = گزینه
        پایان
    پایان
    برگشت برگزیده
پایان

تابع ریشه:
    دستورها := ["build"، "run"، "check"، "format"، "version"]
    هر نوشته در ["biuld"، "chek"، "formt"، "xyz"]:
        حدس := نزدیک ترین(نوشته، دستورها)
        امتیاز := حدس.طول() بزرگتر 0 ? تفاوت.نسبت شباهت متن(نوشته، حدس) : 0.0
        اگر امتیاز بزرگتربرابر 0.6:
            سرچاپ نوشته، "->"، حدس
        وگرنه:
            سرچاپ نوشته، "-> no suggestion"
        پایان
    پایان

    قدیمی := تفاوت.خط ها("a\nb\nc\nd\n")
    تازه := تفاوت.خط ها("a\nb\nx\nd\n")
    دیرکن قدیمی.آزادکن()
    دیرکن تازه.آزادکن()
    سرچاپ "lines in common:"، تفاوت.نسبت شباهت(قدیمی، تازه)
پایان
