واردسازی متن
واردسازی حافظه

تابع ریشه:
    ر := "ش€😀"
    و۱ := متن.به یوتف شانزده(ر)
    دیرکن حافظه.آزادسازی(و۱)
    ت := متن.طول یوتف شانزده(ر)
    ناپایا ش := ۰
    تا ش < ت:
        واحد := متن.واحد یوتف شانزده(و۱، ش)
        اگر واحد >= ۵۵۲۹۶ و واحد < ۵۶۳۲۰:
            پایین := متن.واحد یوتف شانزده(و۱، ش + ۱)
            کد := ۶۵۵۳۶ + (واحد - ۵۵۲۹۶) * ۱۰۲۴ + (پایین - ۵۶۳۲۰)
            سرچاپ "واحدهای"، ش، "و"، ش + ۱، "یک جفت‌اند: نقطه‌ی کد"، کد
            ش += ۲
        وگرنه:
            سرچاپ "واحد"، ش، "همان نقطه‌ی کد"، واحد، "است"
            ش += ۱
        پایان
    پایان
    سرچاپ متن.از یوتف شانزده(و۱) == ر
پایان
