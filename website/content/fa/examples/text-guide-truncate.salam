واردسازی رشته
واردسازی متن

تابع کوتاه کن(پیام: رشته، سقف: صحیح): رشته:
    اگر متن.طول یوتف شانزده(پیام) <= سقف:
        برگشت پیام
    پایان
    ناپایا خروجی := ""
    ناپایا مصرف شده := ۱
    نویسه‌ها := رشته.نویسه ها(پیام)
    دیرکن نویسه‌ها.آزادکن()
    هر ن در نویسه‌ها:
        واحدها := متن.طول یوتف شانزده(ن)
        اگر مصرف شده + واحدها > سقف:
            بشکن
        پایان
        خروجی = خروجی + ن
        مصرف شده += واحدها
    پایان
    برگشت خروجی + "…"
پایان

تابع ریشه:
    سقف := ۱۶
    هر پ در ["سفارش ارسال شد"، "سفارش شماره‌ی ۴۴۷۱ شما ارسال شد"، "خبر خوب 🎉🎉🎉🎉🎉"]:
        کوتاه := کوتاه کن(پ، سقف)
        سرچاپ کوتاه، "(" + متن.طول یوتف شانزده(کوتاه) + " واحد)"
    پایان
پایان
