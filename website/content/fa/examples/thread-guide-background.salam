واردسازی نخ

ناپایا واژه‌ها := ۰
ناپایا خط‌ها := ۰

تابع شمردن متن():
    متن := "the quick brown fox\njumps over\nthe lazy dog"
    ناپایا درون واژه := نادرست
    خط‌ها = ۱
    تکرار متن.طول() در ای:
        ح := متن[ای]
        اگر ح == '\n':
            خط‌ها += ۱
        پایان
        اگر ح == ' ' یا ح == '\n':
            درون واژه = نادرست
        وگرنه وارونه درون واژه:
            درون واژه = درست
            واژه‌ها += ۱
        پایان
    پایان
پایان

تابع ریشه:
    کارگر := نخ.جدید(نخ‌ساز(شمردن متن))
    سرچاپ "نخ اصلی: خواندن تنظیمات"
    سرچاپ "نخ اصلی: باز کردن گزارش"
    نخ.پیوستن(کارگر)
    سرچاپ "خط‌ها:"، خط‌ها، "واژه‌ها:"، واژه‌ها
پایان
