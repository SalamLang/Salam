واردسازی نخ
واردسازی حافظه

ساختار تکه:
    همگانی آغاز: صحیح۶۴ = ۰
    همگانی انتها: صحیح۶۴ = ۰
    همگانی جمع: صحیح۶۴ = ۰
پایان

تابع جمع بازه(ب: تکه*):
    ناپایا مجموع := ۰ برگردان صحیح۶۴
    ناپایا ای := ب[۰].آغاز
    تا ای <= ب[۰].انتها:
        مجموع += ای
        ای += ۱
    پایان
    ب[۰].جمع = مجموع
پایان

تابع تکه تازه(اول: صحیح۶۴، آخر: صحیح۶۴): تکه*:
    ب := حافظه.تخصیص(اندازه‌گونه(تکه)) برگردان تکه*
    ب[۰] = تکه { آغاز = اول، انتها = آخر }
    برگشت ب
پایان

تابع ریشه:
    اندازه := ۲۵۰ برگردان صحیح۶۴
    ناپایا تکه‌ها := وکتور {} برگردان وکتور<تکه*>
    دیرکن تکه‌ها.آزادکن()
    ناپایا گروه := وکتور {} برگردان وکتور<نخ.نخ>
    دیرکن گروه.آزادکن()
    تکرار ۴ در ش:
        ب := تکه تازه((ش برگردان صحیح۶۴) * اندازه + ۱، (ش برگردان صحیح۶۴ + ۱) * اندازه)
        تکه‌ها.بیفزا(ب)
        گروه = نخ.جمع آوری(گروه، نخ‌ساز(جمع بازه، ب))
    پایان
    نخ.پیوستن به همه(گروه)
    ناپایا کل := ۰ برگردان صحیح۶۴
    هر ب در تکه‌ها:
        سرچاپ ب[۰].آغاز، "تا"، ب[۰].انتها، "="، ب[۰].جمع
        کل += ب[۰].جمع
        حافظه.آزادسازی(ب برگردان تهی*)
    پایان
    سرچاپ "جمع کل:"، کل
پایان
