واردسازی حافظه

ساختار کار:
    همگانی آغاز: صحیح = ۰
    همگانی انتها: صحیح = ۰
    همگانی جمع: صحیح۶۴ = ۰
پایان

روال انجام(ک: کار*):
    ناپایا مجموع := ۰ برگردان صحیح۶۴
    تکرار ک[۰].آغاز تا ک[۰].انتها در ای:
        مجموع += ای برگردان صحیح۶۴
    پایان
    ک[۰].جمع = مجموع
پایان

روال کار تازه(اول: صحیح، آخر: صحیح): کار*:
    ک := حافظه.تخصیص(اندازه‌گونه(کار)) برگردان کار*
    ک[۰] = کار { آغاز = اول، انتها = آخر }
    برگشت ک
پایان

روال ریشه:
    الف := کار تازه(۱، ۵۰۰)
    ب := کار تازه(۵۰۱، ۱۰۰۰)
    ن۱ := نخ‌ساز(انجام، الف)
    ن۲ := نخ‌ساز(انجام، ب)
    نخ‌پیوند(ن۱)
    نخ‌پیوند(ن۲)
    سرچاپ الف[۰].جمع، ب[۰].جمع
    سرچاپ "جمع کل:"، الف[۰].جمع + ب[۰].جمع
    حافظه.آزادسازی(الف برگردان تهی*)
    حافظه.آزادسازی(ب برگردان تهی*)
پایان
