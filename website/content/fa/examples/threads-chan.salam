واردسازی کانال

ناپایا کارها := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
ناپایا نتیجه‌ها := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>

تابع کارگر():
    ناپایا باز := درست
    تا درست:
        ع := کارها.دریافت(باز)
        اگر وارونه باز:
            بشکن
        پایان
        نتیجه‌ها.فرستادن(ع * ع)
    پایان
پایان

تابع ریشه:
    کارها.مقداردهی(۴)
    نتیجه‌ها.مقداردهی(۱۶)
    الف := نخ‌ساز(کارگر)
    ب := نخ‌ساز(کارگر)
    تکرار ۱ تا ۱۰ در ای:
        کارها.فرستادن(ای برگردان صحیح۶۴)
    پایان
    کارها.بستن()
    نخ‌پیوند(الف)
    نخ‌پیوند(ب)
    نتیجه‌ها.بستن()
    ناپایا جمع := ۰ برگردان صحیح۶۴
    ناپایا باز := درست
    تا درست:
        م := نتیجه‌ها.دریافت(باز)
        اگر وارونه باز:
            بشکن
        پایان
        جمع += م
    پایان
    سرچاپ "جمع مربع‌ها:"، جمع
    کارها.آزادسازی()
    نتیجه‌ها.آزادسازی()
پایان
