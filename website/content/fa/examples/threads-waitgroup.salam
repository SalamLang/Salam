واردسازی همگام سازی

ناپایا انجام‌شده := ۰
ناپایا قفل := همگام سازی.قفل جدید()
ناپایا گروه := همگام سازی.گروه انتظار جدید()

روال کار():
    همگام سازی.قفل کردن(قفل)
    انجام‌شده += ۱
    همگام سازی.باز کردن قفل(قفل)
    همگام سازی.اتمام(گروه)
پایان

روال ریشه:
    ناپایا نخ‌ها := وکتور {} برگردان وکتور<صحیح۶۴>
    دیرکن نخ‌ها.آزادکن()
    همگام سازی.افزودن(گروه، ۵)
    تکرار ۵:
        نخ‌ها.بیفزا(نخ‌ساز(کار))
    پایان
    همگام سازی.انتظار(گروه)
    سرچاپ "تمام شد:"، انجام‌شده
    هر ر در نخ‌ها:
        نخ‌پیوند(ر)
    پایان
    همگام سازی.نابودسازی گروه انتظار(گروه)
    همگام سازی.نابودسازی(قفل)
پایان
