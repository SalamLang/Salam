واردسازی زمان
واردسازی رشته

تابع روزهای باقی‌مانده(انقضا: صحیح۶۴، امروز: صحیح۶۴): صحیح۶۴:
    برگشت زمان.اختلاف ثانیه(انقضا، امروز) / زمان.ثانیه در روز
پایان

تابع ریشه:
    امروز := زمان.از اجزای جهانی(۲۰۲۶، ۳، ۱۰، ۹، ۰، ۰)
    ثبت‌نام‌ها := ["2026-01-15T08:30:00Z"، "2026-02-20T18:45:00Z"، "2026-03-09T23:10:00Z"، "تاریخ نیست"]
    هر ث در ثبت‌نام‌ها:
        ت := زمان.تجزیه ایزو(ث)
        اگر وارونه ت.معتبر:
            سرچاپ "رد کردن تاریخ نادرست:"، ث
            گذر
        پایان
        انقضا := زمان.افزودن مدت(ت.ثانیه مبدا، زمان.روزها(۳۰))
        مانده := روزهای باقی‌مانده(انقضا، امروز)
        اگر مانده < ۰:
            سرچاپ زمان.قالب ایزو جهانی(ت.ثانیه مبدا)، "منقضی شده،"، -مانده، "روز پیش"
        وگرنه:
            سرچاپ زمان.قالب ایزو جهانی(ت.ثانیه مبدا)، "پایان در"، زمان.قالب ایزو جهانی(انقضا)، "(" + رشته.از عدد(مانده) + " روز مانده)"
        پایان
    پایان
پایان
