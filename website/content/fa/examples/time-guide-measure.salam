واردسازی زمان

تابع فیبوناچی(ع: صحیح): صحیح۶۴:
    اگر ع < ۲:
        برگشت ع
    پایان
    برگشت فیبوناچی(ع - ۱) + فیبوناچی(ع - ۲)
پایان

تابع ریشه:
    آغاز := زمان.نانوثانیه یکنواخت()
    نتیجه := فیبوناچی(۲۷)
    مدت := زمان.مدت از(آغاز)
    سرچاپ "فیبوناچی(۲۷) ="، نتیجه
    سرچاپ "چیزی اندازه گرفته شد:"، وارونه مدت.منفی است()
    سرچاپ "کمتر از ده ثانیه:"، مدت.کمتر(زمان.ثانیه‌ها(۱۰))
    بودجه := زمان.ثانیه‌ها(۵)
    اگر بودجه.کمتر(مدت):
        سرچاپ "کندتر از بودجه‌ی"، بودجه.به رشته()
    وگرنه:
        سرچاپ "در بودجه‌ی"، بودجه.به رشته()
    پایان
پایان
