واردسازی زمان

تابع نام روز هفته(لحظه: صحیح۶۴): رشته:
    نام‌ها := ["پنجشنبه"، "جمعه"، "شنبه"، "یکشنبه"، "دوشنبه"، "سه‌شنبه"، "چهارشنبه"]
    برگشت نام‌ها[(لحظه / زمان.ثانیه در روز) % ۷]
پایان

تابع اجرای بعدی(پس از: صحیح۶۴، ساعت: صحیح، دقیقه: صحیح): صحیح۶۴:
    آغاز روز := پس از - پس از % زمان.ثانیه در روز
    ناپایا اجرا := آغاز روز + (ساعت برگردان صحیح۶۴) * زمان.ثانیه در ساعت + (دقیقه برگردان صحیح۶۴) * زمان.ثانیه در دقیقه
    اگر اجرا <= پس از:
        اجرا += زمان.ثانیه در روز
    پایان
    برگشت اجرا
پایان

تابع ریشه:
    ناپایا ز := زمان.از اجزای جهانی(۲۰۲۶، ۱۰، ۱۶، ۱۴، ۲۰، ۰)
    سرچاپ "اکنون:"، نام روز هفته(ز)، زمان.قالب ایزو جهانی(ز)
    تکرار ۳:
        ز = اجرای بعدی(ز، ۲، ۳۰)
        سرچاپ "پشتیبان‌گیری:"، نام روز هفته(ز)، زمان.قالب ایزو جهانی(ز)
    پایان
    سرچاپ "شکل HTTP:"، زمان.قالب تاریخ اچ‌تی‌تی‌پی(ز)
پایان
