واردسازی زمان

تابع ریشه:
    ناپایا تیک‌زن := زمان.تیک‌زن جدید(زمان.میلی‌ثانیه‌ها(۲۰))
    ناپایا مهلت := زمان.زمان‌سنج جدید(زمان.میلی‌ثانیه‌ها(۵۰۰))
    ناپایا ضربان‌ها := ۰
    تا ضربان‌ها < ۵ و وارونه مهلت.منقضی شده():
        تیک‌زن.انتظار()
        ضربان‌ها += ۱
        سرچاپ "ضربان"، ضربان‌ها
    پایان
    تیک‌زن.توقف()
    سرچاپ "مهلت گذشت:"، مهلت.منقضی شده()
    شروع := زمان.نانوثانیه یکنواخت()
    آماده := زمان.صبر برای(():
        برگشت زمان.مدت از(شروع).میلی‌ثانیه() >= ۳۰
    پایان، زمان.میلی‌ثانیه‌ها(۵)، زمان.ثانیه‌ها(۱))
    سرچاپ "حافظه‌ی نهان گرم شد:"، آماده
    بالا آمد := زمان.صبر برای((): برگشت نادرست پایان، زمان.میلی‌ثانیه‌ها(۵)، زمان.میلی‌ثانیه‌ها(۲۰))
    سرچاپ "سرور بالا آمد:"، بالا آمد
پایان
