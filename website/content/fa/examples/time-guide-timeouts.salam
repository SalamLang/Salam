واردسازی زمان

تابع خواندن مهلت(نام: رشته، متن: رشته، پیش‌فرض: زمان.مدت): زمان.مدت:
    ت := زمان.تجزیه مدت(متن)
    اگر وارونه ت.معتبر:
        سرچاپ نام + ": خوانده نشد"، "\"" + متن + "\"، به‌جای آن"، پیش‌فرض.به رشته()
        برگشت پیش‌فرض
    پایان
    اگر ت.مقدار.کمتر(زمان.میلی‌ثانیه‌ها(۱۰۰)) یا زمان.دقیقه‌ها(۱۰).کمتر(ت.مقدار):
        سرچاپ نام + ":"، ت.مقدار.به رشته()، "بیرون از بازه است، به‌جای آن"، پیش‌فرض.به رشته()
        برگشت پیش‌فرض
    پایان
    سرچاپ نام + ":"، ت.مقدار.به رشته()
    برگشت ت.مقدار
پایان

تابع ریشه:
    اتصال := خواندن مهلت("اتصال"، "2.5s"، زمان.ثانیه‌ها(۵))
    درخواست := خواندن مهلت("درخواست"، "1m30s"، زمان.ثانیه‌ها(۳۰))
    کوشش دوباره := خواندن مهلت("تلاش دوباره"، "به‌زودی"، زمان.ثانیه‌ها(۱))
    بیکاری := خواندن مهلت("بیکاری"، "2h"، زمان.دقیقه‌ها(۵))
    بدترین := اتصال.جمع(درخواست.ضرب(۳)).جمع(کوشش دوباره.ضرب(۲))
    سرچاپ "بدترین حالت برای سه تلاش:"، بدترین.به رشته()
    سرچاپ "بیکاری به میلی‌ثانیه:"، بیکاری.میلی‌ثانیه()
پایان
