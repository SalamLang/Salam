واردسازی تی ال اس

ساختار طرف:
    همگانی کلید خصوصی: رشته = ""
    همگانی کلید عمومی: رشته = ""
پایان

تابع طرف تازه(): طرف:
    ناپایا ط := طرف {}
    _ := تی ال اس.تولید کلید ای سی دی اچ(ط.کلید خصوصی، ط.کلید عمومی)
    برگشت ط
پایان

تابع کلید نشست(من: طرف، عمومی دیگری: رشته، نمک: رشته): رشته:
    ناپایا موفق := نادرست
    مشترک := تی ال اس.راز مشترک ای سی دی اچ(من.کلید خصوصی، عمومی دیگری، موفق)
    برگشت تی ال اس.اچ کی دی اف شا۲۵۶(مشترک، نمک، "notes app v1 session"، ۳۲، موفق)
پایان

تابع ریشه:
    آرش := طرف تازه()
    بهار := طرف تازه()
    نمک := تی ال اس.نمک تصادفی(۱۶)

    کلید آرش := کلید نشست(آرش، بهار.کلید عمومی، نمک)
    کلید بهار := کلید نشست(بهار، آرش.کلید عمومی، نمک)
    سرچاپ "هر دو طرف به یک کلید رسیدند:"، کلید آرش برابر کلید بهار

    ناپایا موفق := نادرست
    پیام := تی ال اس.مهر ای ای اس جی سی ام(کلید آرش، تی ال اس.نانس جی سی ام(۰)، "ساعت نه در ایستگاه"، موفق)
    سرچاپ "آرش"، پیام.طول()، "نویسه‌ی base64 فرستاد"
    سرچاپ "بهار می‌خواند:"، تی ال اس.گشودن ای ای اس جی سی ام(کلید بهار، تی ال اس.نانس جی سی ام(۰)، پیام، موفق)

    فضول := طرف تازه()
    کلید فضول := کلید نشست(فضول، آرش.کلید عمومی، نمک)
    _ := تی ال اس.گشودن ای ای اس جی سی ام(کلید فضول، تی ال اس.نانس جی سی ام(۰)، پیام، موفق)
    سرچاپ "فضول، تنها با کلیدهای عمومی، می‌تواند بخواند:"، موفق
پایان
