// زبان: فارسی
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا نام := ""
ناپایا مشترک := نادرست
ناپایا شمار ذخیره := 0

تابع مستطیل(ایکس: صحیح، ایگرگ: صحیح، پهنا: صحیح): رابط‌پایانه.مستطیل:
    برگشت رابط‌پایانه.مستطیل { ایکس = ایکس، ایگرگ = ایگرگ، عرض = پهنا، ارتفاع = 1 }
پایان

تابع کلید(دنباله: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(دنباله) }
پایان

تابع تایپ(ص &: رابط‌پایانه.صفحه، متن: رشته):
    تکرار متن.طول() در شماره:
        _ := ص.هدایت رویداد(کلید(متن.زیررشته(شماره، 1)))
    پایان
پایان

تابع ریشه:
    ناپایا ص := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 30، 4)
    دیرکن ص.بستن()
    ص.تنظیم نگاشت کلید(رابط‌پایانه.نگاشت کلید پیش‌فرض())

    برچسب := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.متن جدید("نام:") برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(برچسب).تنظیم محدوده(مستطیل(1، 0، 6))
    ناپایا خانه نام := رابط‌پایانه.کادر متن جدید()
    خانه نام.تنظیم متن راهنما("نام شما")
    خانه نام.هنگام ثبت = (مقدار: رشته):
        نام = مقدار
        برگشت درست
    پایان
    فیلد := ص.افزودن(رابط‌پایانه.شناسه ریشه، خانه نام برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(فیلد).تنظیم محدوده(مستطیل(7، 0، 20))
    ناپایا کادر := رابط‌پایانه.کادر انتخاب جدید("خبرنامه بفرست"، نادرست)
    کادر.هنگام تغییر انتخاب = (فعال: منطقی): مشترک = فعال پایان
    خبر := ص.افزودن(رابط‌پایانه.شناسه ریشه، کادر برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(خبر).تنظیم محدوده(مستطیل(1، 1، 20))
    ناپایا دکمه := رابط‌پایانه.دکمه جدید("ثبت")
    دکمه.هنگام کلیک = (): شمار ذخیره++ پایان
    ذخیره := ص.افزودن(رابط‌پایانه.شناسه ریشه، دکمه برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(ذخیره).تنظیم محدوده(مستطیل(1، 2، 10))

    سرچاپ "تمرکز اول:"، ص.شناسه متمرکز() برابر فیلد
    تایپ(ص، "سارا")
    _ := ص.هدایت رویداد(کلید("\r"))
    _ := ص.هدایت رویداد(کلید("\t"))
    _ := ص.هدایت رویداد(کلید(" "))
    _ := ص.هدایت رویداد(کلید("\t"))
    _ := ص.هدایت رویداد(کلید("\r"))
    سرچاپ "نام:"، نام، "خبرنامه:"، مشترک، "ذخیره:"، شمار ذخیره

    ص.بازترسیم()
    تکرار ص.بافر.ارتفاع در ردیف:
        سرچاپ "|" + ص.بافر.متن ردیف(ردیف) + "|"
    پایان
پایان
