// زبان: فارسی
واردسازی پایانه
واردسازی رابط‌پایانه

ساختار سلام:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی شمار فشار: صحیح = 0

    همگانی تابع ترسیم(بافر: رابط‌پایانه.بافر، مرز: رابط‌پایانه.مستطیل):
        بافر.نوشتن متن(مرز.ایکس + 2، مرز.ایگرگ + 1، "سلام از رابط‌پایانه!"، رابط‌پایانه.ظاهر { پررنگ = درست، رنگ پیش‌زمینه = رابط‌پایانه.فیروزه‌ای })
        بافر.نوشتن متن(مرز.ایکس + 2، مرز.ایگرگ + 3، "اینتر " + این.شمار فشار + " بار فشرده شد"، رابط‌پایانه.ظاهر پیش‌فرض)
        بافر.نوشتن متن(مرز.ایکس + 2، مرز.پایین() - 1، "q برای خروج"، رابط‌پایانه.ظاهر { کم‌رنگ = درست })
    پایان

    همگانی تابع پردازش رویداد(رویداد: رابط‌پایانه.رویداد): منطقی:
        اگر رویداد.کلید است(پایانه.کلید ورود):
            این.شمار فشار++
            برگشت درست
        پایان
        برگشت نادرست
    پایان
پایان

تابع ریشه:
    اگر وارونه پایانه.پایانه دارد():
        نادرست‌سرچاپ "مرا در یک پایانه اجرا کنید"
        برگشت 1
    پایان
    ناپایا ص := رابط‌پایانه.صفحه ترمینال جدید(سلام {})
    ص.آغاز()
    دیرکن ص.بستن()
    ص.نمایش تغییرات()
    ناپایا رخداد := رابط‌پایانه.رویداد {}
    تا ص.رویداد بعدی(رخداد):
        مصرف شد := ص.هدایت رویداد(رخداد)
        اگر وارونه مصرف شد و (رخداد.نویسه است("q") یا رخداد.ترکیب کنترل است("c")):
            ص.توقف()
        پایان
        ص.نمایش تغییرات()
    پایان
    برگشت 0
پایان
