// زبان: فارسی
واردسازی رابط‌پایانه

تابع ثابت(تعداد: صحیح): رابط‌پایانه.قاعده‌اندازه‌گذاری:
    برگشت رابط‌پایانه.قاعده‌اندازه‌گذاری { نوع = رابط‌پایانه.نوع‌اندازه‌گذاری.ثابت، تعداد سلول = تعداد }
پایان

تابع ریشه:
    عنوان := رابط‌پایانه.متن جدید("دانلودها") برگردان پویا رابط‌پایانه.ویجت
    خط جدا := رابط‌پایانه.جداکننده جدید() برگردان پویا رابط‌پایانه.ویجت
    ناپایا نوار := رابط‌پایانه.نوار پیشرفت جدید()
    نوار.تنظیم پیشرفت(40)
    پیشرفت := نوار برگردان پویا رابط‌پایانه.ویجت
    ناپایا بدنه := رابط‌پایانه.متن جدید("فایل salam-0.6.3.tar.gz تا 40% دانلود شده است. باقی این خط درون ستون شکسته خواهد شد.")
    بدنه.تنظیم شکست خط(رابط‌پایانه.حالت‌شکست‌خط.بر پایه واژه)
    متن := بدنه برگردان پویا رابط‌پایانه.ویجت

    ناپایا ستون := رابط‌پایانه.ستون جدید()
    ستون.تنظیم فاصله درونی(رابط‌پایانه.فاصله‌های چهارگانه یکسان(1))
    اول := ستون.افزودن(عنوان)
    دوم := ستون.افزودن(خط جدا)
    سوم := ستون.افزودن(پیشرفت)
    _ := ستون.افزودن(متن)
    ستون.تنظیم ارتفاع(اول، ثابت(1))
    ستون.تنظیم ارتفاع(دوم، ثابت(1))
    ستون.تنظیم ارتفاع(سوم، ثابت(1))

    ناپایا ص := رابط‌پایانه.صفحه جدید(ستون برگردان پویا رابط‌پایانه.ویجت، 32، 8)
    دیرکن ص.بستن()
    _ := ص.افزودن(رابط‌پایانه.شناسه ریشه، عنوان)
    _ := ص.افزودن(رابط‌پایانه.شناسه ریشه، خط جدا)
    _ := ص.افزودن(رابط‌پایانه.شناسه ریشه، پیشرفت)
    _ := ص.افزودن(رابط‌پایانه.شناسه ریشه، متن)
    ص.بازترسیم()
    تکرار ص.بافر.ارتفاع در ردیف:
        سرچاپ "|" + ص.بافر.متن ردیف(ردیف) + "|"
    پایان
پایان
