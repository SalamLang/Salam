// زبان: فارسی
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا بازشده := -1

تابع ردیف(اولی: رشته، دومی: رشته): وکتور<رشته>:
    ناپایا خانه‌ها := وکتور {} برگردان وکتور<رشته>
    خانه‌ها.بیفزا(اولی)
    خانه‌ها.بیفزا(دومی)
    برگشت خانه‌ها
پایان

تابع ستون(پهنا: صحیح، چینش: رابط‌پایانه.تراز): رابط‌پایانه.ستون‌جدول:
    برگشت رابط‌پایانه.ستون‌جدول { عرض = رابط‌پایانه.قاعده‌اندازه‌گذاری { نوع = رابط‌پایانه.نوع‌اندازه‌گذاری.ثابت، تعداد سلول = پهنا }، تراز = چینش }
پایان

تابع پایین(): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = پایانه.کلید پایین } }
پایان

تابع ریشه:
    ناپایا ص := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 34، 6)
    دیرکن ص.بستن()

    ناپایا فایل‌ها := وکتور {} برگردان وکتور<رشته>
    فایل‌ها.بیفزا("main.salam")
    فایل‌ها.بیفزا("util.salam")
    فایل‌ها.بیفزا("README.md")
    فهرست := ص.افزودن(رابط‌پایانه.شناسه ریشه، رابط‌پایانه.فهرست جدید(فایل‌ها) برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(فهرست).تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 12، ارتفاع = 3 })

    ناپایا نما := رابط‌پایانه.نمای جدول جدید()
    _ := نما.افزودن ستون(ستون(8، رابط‌پایانه.تراز.چپ))
    _ := نما.افزودن ستون(ستون(7، رابط‌پایانه.تراز.راست))
    نما.جدول.سرآیند = درست
    _ := نما.افزودن ردیف(ردیف("نام"، "خطوط"))
    _ := نما.افزودن ردیف(ردیف("tui"، "8956"))
    _ := نما.افزودن ردیف(ردیف("signal"، "976"))
    _ := نما.افزودن ردیف(ردیف("term"، "1944"))
    نما.فعال‌سازی = (شماره: صحیح):
        بازشده = شماره
        برگشت درست
    پایان
    شناسه جدول := ص.افزودن(رابط‌پایانه.شناسه ریشه، نما برگردان پویا رابط‌پایانه.ویجت)
    ص.ویجت(شناسه جدول).تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 13، ایگرگ = 0، عرض = 20، ارتفاع = 5 })

    _ := ص.تمرکز(فهرست)
    _ := ص.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی("j") })
    _ := ص.تمرکز(شناسه جدول)
    _ := ص.هدایت رویداد(پایین())
    _ := ص.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = پایانه.کلید ورود } })
    نام‌ها := ["tui"، "signal"، "term"]
    سرچاپ "باز شد:"، نام‌ها[بازشده]
    ص.بازترسیم()
    تکرار ص.بافر.ارتفاع در سطر:
        سرچاپ "|" + ص.بافر.متن ردیف(سطر) + "|"
    پایان
پایان
