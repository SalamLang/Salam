// زبان: فارسی
واردسازی پایانه
واردسازی رابط‌پایانه

ساختار سلام:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی شمار فشار: صحیح = 0

    همگانی تابع ترسیم(بافر: رابط‌پایانه.بافر، مرز: رابط‌پایانه.مستطیل):
        رابط‌پایانه.ترسیم کادر(بافر، مرز، رابط‌پایانه.سبک‌کادر.گوشه‌گرد، رابط‌پایانه.ظاهر پیش‌فرض، "سلام!")
        بافر.نوشتن متن(مرز.ایکس + 2، مرز.ایگرگ + 1، "سلام از رابط‌پایانه!"، رابط‌پایانه.ظاهر { پررنگ = درست })
        بافر.نوشتن متن(مرز.ایکس + 2، مرز.ایگرگ + 2، "اینتر " + این.شمار فشار + " بار فشرده شد"، رابط‌پایانه.ظاهر پیش‌فرض)
    پایان

    همگانی تابع پردازش رویداد(رویداد: رابط‌پایانه.رویداد): منطقی:
        اگر رویداد.کلید است(پایانه.کلید ورود):
            این.شمار فشار++
            برگشت درست
        پایان
        برگشت نادرست
    پایان
پایان

تابع نمایش(ص: رابط‌پایانه.صفحه):
    ص.بازترسیم()
    تکرار ص.بافر.ارتفاع در ردیف:
        سرچاپ ص.بافر.متن ردیف(ردیف)
    پایان
پایان

تابع ریشه:
    ناپایا ص := رابط‌پایانه.صفحه جدید(سلام {}، 30، 4)
    دیرکن ص.بستن()
    نمایش(ص)
    اینتر := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.کلید { کد = پایانه.کلید ورود } }
    _ := ص.هدایت رویداد(اینتر)
    _ := ص.هدایت رویداد(اینتر)
    نمایش(ص)
پایان
