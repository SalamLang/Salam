گونه ریال: صحیح
    روال *(تعداد: صحیح): ریال:
        برگشت ((این برگردان صحیح) * تعداد) برگردان ریال
    پایان
    روال متن(): رشته:
        برگشت "" + ((این برگردان صحیح) / ۱۰) + " تومان"
    پایان
پایان

روال ریشه:
    قیمت := ۴۹۹۰۰ برگردان ریال
    ارسال := ۲۵۰۰۰ برگردان ریال
    جمع := قیمت * ۳ + ارسال
    سرچاپ جمع.متن()، جمع > قیمت
    سرچاپ جمع
    نفرها := ۲
    سهم := ((جمع برگردان صحیح) / نفرها) برگردان ریال
    سرچاپ "سهم هر نفر"، سهم.متن()
پایان
