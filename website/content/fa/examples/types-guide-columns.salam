واردسازی رشته
واردسازی نوع‌ها

تابع گسترده‌تر(قبلی: صحیح، خانه: رشته): صحیح:
    ن := نوع‌ها.نوعِ(رشته.پیرایش(خانه))
    اگر ن برابر نوع‌ها.نوع خالی: برگشت قبلی پایان
    اگر قبلی برابر نوع‌ها.نوع خالی یا قبلی برابر ن: برگشت ن پایان
    اگر (قبلی برابر نوع‌ها.نوع صحیح و ن برابر نوع‌ها.نوع اعشاری) یا (قبلی برابر نوع‌ها.نوع اعشاری و ن برابر نوع‌ها.نوع صحیح):
        برگشت نوع‌ها.نوع اعشاری
    پایان
    برگشت نوع‌ها.نوع رشته
پایان

تابع ریشه:
    ردیف‌ها := ["id,name,price,stock,active"، "1,چای,4.5,120,true"، "2,قهوه,7,,false"، "3,کاکائو,5.25,80,TRUE"، "4,ماته,۶,n/a,true"]
    سرستون := رشته.تفکیک کردن(ردیف‌ها[۰]، ",")
    ناپایا نوع ستون‌ها := وکتور {} برگردان وکتور<صحیح>
    دیرکن نوع ستون‌ها.آزادکن()
    تکرار سرستون.طول():
        نوع ستون‌ها.بیفزا(نوع‌ها.نوع خالی)
    پایان
    تکرار ۱ تا ردیف‌ها.طول() - ۱ در ر:
        خانه‌ها := رشته.تفکیک کردن(ردیف‌ها[ر]، ",")
        هر س، خانه در خانه‌ها:
            نوع ستون‌ها.بنشان(س، گسترده‌تر(نوع ستون‌ها.بگیر(س)، خانه))
        پایان
    پایان
    هر س، نام در سرستون:
        سرچاپ نام، "->"، نوع‌ها.نام نوع(نوع ستون‌ها.بگیر(س))
    پایان
پایان
