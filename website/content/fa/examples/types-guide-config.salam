واردسازی رشته
واردسازی نوع‌ها

تابع ریشه:
    خط‌ها := ["port = 8080"، "ratio = 0.75"، "debug = false"، "name = فروشگاه"، "retries = -3"، "timeout ="، "limit = 1e3"]
    هر خط در خط‌ها:
        بخش‌ها := رشته.تفکیک کردن(خط، "=")
        کلید := رشته.پیرایش(بخش‌ها.بگیر(۰))
        مقدار := رشته.پیرایش(بخش‌ها.بگیر(۱))
        ن := نوع‌ها.نوعِ(مقدار)
        ترابرد ن:
            نوع‌ها.نوع صحیح:
                سرچاپ کلید، "عدد صحیح است:"، مقدار
                بشکن
            پایان
            نوع‌ها.نوع اعشاری:
                سرچاپ کلید، "عدد اعشاری است:"، مقدار
                بشکن
            پایان
            نوع‌ها.نوع منطقی:
                سرچاپ کلید، "کلید روشن و خاموش است:"، رشته.کوچک(مقدار)
                بشکن
            پایان
            نوع‌ها.نوع خالی:
                سرچاپ کلید، "مقدار ندارد، پیش‌فرض به کار می‌رود"
                بشکن
            پایان
            وگرنه:
                سرچاپ کلید، "متن است:"، مقدار
            پایان
        پایان
    پایان
پایان
