واردسازی رشته
واردسازی نوع‌ها

تابع واژه‌ها(خط: رشته): وکتور<رشته>:
    ناپایا نتیجه := وکتور {} برگردان وکتور<رشته>
    هر واژه در رشته.تفکیک کردن(خط، " "):
        اگر واژه.طول() بزرگتر ۰: نتیجه.بیفزا(واژه) پایان
    پایان
    برگشت نتیجه
پایان

تابع بسنج(برچسب: رشته، گرفته: وکتور<رشته>، خواسته: وکتور<رشته>):
    اگر نوع‌ها.یکسان(گرفته، خواسته):
        سرچاپ "قبول"، برچسب
    وگرنه:
        سرچاپ "رد"، برچسب، "گرفته"، گرفته.طول()، "واژه، خواسته"، خواسته.طول()
    پایان
پایان

تابع ریشه:
    ناپایا خواسته := وکتور {} برگردان وکتور<رشته>
    دیرکن خواسته.آزادکن()
    خواسته.بیفزا("سلام")
    خواسته.بیفزا("دنیا")
    الف := واژه‌ها("سلام دنیا")
    ب := واژه‌ها("  سلام   دنیا ")
    ج := واژه‌ها("سلام دنیای بزرگ")
    دیرکن الف.آزادکن()
    دیرکن ب.آزادکن()
    دیرکن ج.آزادکن()
    بسنج("فاصله‌ی تکی"، الف، خواسته)
    بسنج("فاصله‌ی اضافه"، ب، خواسته)
    بسنج("سه واژه"، ج، خواسته)
پایان
