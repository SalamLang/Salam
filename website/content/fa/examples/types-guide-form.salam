واردسازی رشته
واردسازی تبدیل
واردسازی نوع‌ها

تابع ریشه:
    سن := "۳۴"
    قیمت := "۱۲٫۵"
    تعداد := "12.0"
    عضویت := " بله "
    اگر نوع‌ها.صحیح است(سن):
        سرچاپ "سن:"، تبدیل.تجزیه عدد(رشته.به رقم انگلیسی(سن))
    پایان
    اگر نوع‌ها.عددی است(قیمت):
        پاک := رشته.جایگزینی(رشته.به رقم انگلیسی(قیمت)، "٫"، ".")
        سرچاپ "قیمت دو تا:"، تبدیل.تجزیه اعشار(پاک) * ۲.۰
    پایان
    اگر نوع‌ها.صحیح است(تعداد) برابر نادرست:
        سرچاپ "تعداد باید عدد صحیح باشد، ولی"، تعداد، "آمده که از نوع"، نوع‌ها.نام نوع(نوع‌ها.نوعِ(تعداد))، "است"
    پایان
    اگر نوع‌ها.منطقی است(عضویت) برابر نادرست:
        سرچاپ "عضویت باید true یا false باشد، ولی [" + عضویت + "] آمده"
    پایان
پایان
