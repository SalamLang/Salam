// زبان: فارسی
واردسازی رابط گرافیکی.حروف‌چینی
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    ناپایا شمار_قلم := حروف‌چینی.مجموعه قلم تازه()
    حروف‌چینی.افزودن پرونده قلم(شمار_قلم، مسیر پرونده.پیوند(مسیر پرونده.پوشه(سیستم عامل.متغیر محیطی("SALAM_STD"))، "books/fonts/XB Zar.ttf"))
    ناپایا گستره‌ها := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    گستره‌ها.بیفزا(حروف‌چینی.تکه متن { متن = "سلام ABC دنیا"، خانواده‌های قلم = XB, Zar، اندازه = 20.0 })
    ناپایا سبک_متن := حروف‌چینی.سبک بند {}
    سبک_متن.فاصله‌های سفید = حروف‌چینی.فاصله سفید.PreWrap
    ناپایا ویژگی_محلی := حروف‌چینی.بند تازه(شمار_قلم، گستره‌ها، سبک_متن)
    ناپایا ال := حروف‌چینی.چیدن بند(ویژگی_محلی، شمار_قلم، 0.0)
    ناپایا موقعیت := حروف‌چینی.آزمون برخورد(ویژگی_محلی، ال، ال.پهنا، 10.0)
    سرچاپ "click at the right edge: offset"، موقعیت.جابجایی
    تکرار 6:
        موقعیت = حروف‌چینی.جابجایی دیداری(ویژگی_محلی، ال، موقعیت، نادرست)
        هشتک := حروف‌چینی.مستطیل نشانگر(ویژگی_محلی، ال، موقعیت)
        سرچاپ "left arrow: offset"، موقعیت.جابجایی، "caret x"، هشتک.ایکس
    پایان
    چهارگوش‌ها := حروف‌چینی.مستطیل‌های گزینش(ویژگی_محلی، ال، 6، 15)
    سرچاپ "selection of 'م ABC د' needs"، چهارگوش‌ها.طول()، "rectangles"
    چهارگوش‌ها.آزادکن()
    حروف‌چینی.آزادسازی چیدمان(ال)
    حروف‌چینی.آزادسازی بند(ویژگی_محلی)
    گستره‌ها.آزادکن()
    حروف‌چینی.آزادسازی مجموعه قلم(شمار_قلم)
پایان
