// زبان: فارسی
واردسازی رابط گرافیکی.حروف‌چینی
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    ناپایا fc := حروف‌چینی.مجموعه قلم تازه()
    حروف‌چینی.افزودن پرونده قلم(fc، مسیر پرونده.پیوند(مسیر پرونده.پوشه(سیستم عامل.متغیر محیطی("SALAM_STD"))، "books/fonts/XB Zar.ttf"))
    ناپایا spans := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    spans.بیفزا(حروف‌چینی.تکه متن { متن = "سلام ABC دنیا"، خانواده‌های قلم = XB, Zar، اندازه = 20.0 })
    ناپایا st := حروف‌چینی.سبک بند {}
    st.فاصله‌های سفید = حروف‌چینی.فاصله سفید.PreWrap
    ناپایا p := حروف‌چینی.بند تازه(fc، spans، st)
    ناپایا l := حروف‌چینی.چیدن بند(p، fc، 0.0)
    ناپایا pos := حروف‌چینی.آزمون برخورد(p، l، l.پهنا، 10.0)
    سرچاپ "click at the right edge: offset"، pos.جابجایی
    تکرار 6:
        pos = حروف‌چینی.جابجایی دیداری(p، l، pos، نادرست)
        caret := حروف‌چینی.مستطیل نشانگر(p، l، pos)
        سرچاپ "left arrow: offset"، pos.جابجایی، "caret x"، caret.ایکس
    پایان
    rects := حروف‌چینی.مستطیل‌های گزینش(p، l، 6، 15)
    سرچاپ "selection of 'م ABC د' needs"، rects.طول()، "rectangles"
    rects.آزادکن()
    حروف‌چینی.آزادسازی چیدمان(l)
    حروف‌چینی.آزادسازی بند(p)
    spans.آزادکن()
    حروف‌چینی.آزادسازی مجموعه قلم(fc)
پایان
