// زبان: فارسی
واردسازی رابط گرافیکی.حروف‌چینی
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    fonts := مسیر پرونده.پیوند(مسیر پرونده.پوشه(سیستم عامل.متغیر محیطی("SALAM_STD"))، "books/fonts/")
    ناپایا fc := حروف‌چینی.مجموعه قلم تازه()
    حروف‌چینی.افزودن پرونده قلم(fc، fonts + "XB Zar.ttf")
    حروف‌چینی.افزودن پرونده قلم(fc، fonts + "DejaVuSansMono.ttf")
    ناپایا spans := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    spans.بیفزا(حروف‌چینی.تکه متن { متن = "زبان برنامه‌نویسی "، خانواده‌های قلم = "XB Zar"، اندازه = 20.0، برچسب = 1 })
    spans.بیفزا(حروف‌چینی.تکه متن { متن = "Salam"، خانواده‌های قلم = "DejaVu Sans Mono"، اندازه = 16.0، برچسب = 2 })
    spans.بیفزا(حروف‌چینی.تکه متن { متن = " متن فارسی را درست می‌چیند."، خانواده‌های قلم = "XB Zar"، اندازه = 20.0، برچسب = 3 })
    ناپایا p := حروف‌چینی.بند تازه(fc، spans، حروف‌چینی.سبک بند {})
    سرچاپ "min"، حروف‌چینی.پهنای کمینه محتوا(p)، "max"، حروف‌چینی.پهنای بیشینه محتوا(p)
    هر width در [400.0، 160.0]:
        ناپایا l := حروف‌چینی.چیدن بند(p، fc، width)
        سرچاپ "width"، width، "lines"، l.خط‌ها.طول()، "height"، l.بلندی
        هر line در l.خط‌ها:
            چاپ "  baseline "، line.خط پایه، ":"
            ناپایا k := line.آغاز دنباله
            تا k کوچکتر line.آغاز دنباله + line.شمار دنباله:
                run := l.دنباله‌ها.بگیر(k)
                اگر run.شمار گلیف بزرگتر 0:
                    چاپ " [tag "، run.برچسب، " x "، run.ایکس، (run.راست به چپ ? " rtl" : " ltr")، "]"
                پایان
                k++
            پایان
            سرچاپ ""
        پایان
        حروف‌چینی.آزادسازی چیدمان(l)
    پایان
    حروف‌چینی.آزادسازی بند(p)
    spans.آزادکن()
    حروف‌چینی.آزادسازی مجموعه قلم(fc)
پایان
