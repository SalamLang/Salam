// زبان: فارسی
واردسازی رابط گرافیکی.حروف‌چینی
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    قلم‌ها := مسیر پرونده.پیوند(مسیر پرونده.پوشه(سیستم عامل.متغیر محیطی("SALAM_STD"))، "books/fonts/")
    ناپایا شمار_قلم := حروف‌چینی.مجموعه قلم تازه()
    حروف‌چینی.افزودن پرونده قلم(شمار_قلم، قلم‌ها + "XB Zar.ttf")
    حروف‌چینی.افزودن پرونده قلم(شمار_قلم، قلم‌ها + "DejaVuSansMono.ttf")
    ناپایا گستره‌ها := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    گستره‌ها.بیفزا(حروف‌چینی.تکه متن { متن = "زبان برنامه‌نویسی "، خانواده‌های قلم = XB, Zar، اندازه = 20.0، برچسب = 1 })
    گستره‌ها.بیفزا(حروف‌چینی.تکه متن { متن = "Salam"، خانواده‌های قلم = DejaVu, Sans, Mono، اندازه = 16.0، برچسب = 2 })
    گستره‌ها.بیفزا(حروف‌چینی.تکه متن { متن = " متن فارسی را درست می‌چیند."، خانواده‌های قلم = XB, Zar، اندازه = 20.0، برچسب = 3 })
    ناپایا ویژگی_محلی := حروف‌چینی.بند تازه(شمار_قلم، گستره‌ها، حروف‌چینی.سبک بند {})
    سرچاپ "min"، حروف‌چینی.پهنای کمینه محتوا(ویژگی_محلی)، "max"، حروف‌چینی.پهنای بیشینه محتوا(ویژگی_محلی)
    هر متغیر_width در [400.0، 160.0]:
        ناپایا ال := حروف‌چینی.چیدن بند(ویژگی_محلی، شمار_قلم، متغیر_width)
        سرچاپ "width"، متغیر_width، "lines"، ال.خط‌ها.طول()، "height"، ال.بلندی
        هر خط در ال.خط‌ها:
            چاپ "  baseline "، خط.خط پایه، ":"
            ناپایا شمارنده۳ := خط.آغاز دنباله
            تا شمارنده۳ کوچکتر خط.آغاز دنباله + خط.شمار دنباله:
                اجرا_مقدار := ال.دنباله‌ها.بگیر(شمارنده۳)
                اگر اجرا_مقدار.شمار گلیف بزرگتر 0:
                    چاپ " [tag "، اجرا_مقدار.برچسب، " x "، اجرا_مقدار.ایکس، (اجرا_مقدار.راست به چپ ? " rtl" : " ltr")، "]"
                پایان
                شمارنده۳++
            پایان
            سرچاپ ""
        پایان
        حروف‌چینی.آزادسازی چیدمان(ال)
    پایان
    حروف‌چینی.آزادسازی بند(ویژگی_محلی)
    گستره‌ها.آزادکن()
    حروف‌چینی.آزادسازی مجموعه قلم(شمار_قلم)
پایان
