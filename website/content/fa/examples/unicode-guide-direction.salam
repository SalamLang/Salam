واردسازی یونیکد
واردسازی رشته

تابع جهت(متن: رشته): رشته:
    کدها := رشته.کدنقطه ها(متن)
    دیرکن کدها.آزادکن()
    هر کد در کدها:
        رده := یونیکد.رده دوسویه(کد)
        اگر رده == یونیکد.رده دوسویه چپ به راست:
            برگشت "ltr"
        پایان
        اگر رده == یونیکد.رده دوسویه راست به چپ یا رده == یونیکد.رده دوسویه عربی:
            برگشت "rtl"
        پایان
    پایان
    برگشت "خنثی"
پایان

تابع ریشه:
    هر خط در ["Hello"، "سلام دنیا"، "۲۰۲۶: سال نو"، "(42) Answer"، "!!! ۱۲۳"، "שלום"]:
        سرچاپ جهت(خط)، "|"، خط
    پایان
پایان
