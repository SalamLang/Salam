واردسازی یونیکد
واردسازی رشته

تابع حذف نشانه‌ها(متن: رشته): رشته:
    ناپایا ب := رشته.سازنده()
    دیرکن رشته.آزادسازی بافر(ب)
    کدها := رشته.کدنقطه ها(متن)
    دیرکن کدها.آزادکن()
    هر کد در کدها:
        ت := یونیکد.طول تجزیه(کد)
        اگر ت == ۰:
            اگر وارونه یونیکد.نشانه است(کد):
                رشته.افزودن کدنقطه به بافر(ب، کد)
            پایان
            گذر
        پایان
        تکرار ت در ک:
            جزء := یونیکد.تجزیه در(کد، ک)
            اگر وارونه یونیکد.نشانه است(جزء):
                رشته.افزودن کدنقطه به بافر(ب، جزء)
            پایان
        پایان
    پایان
    برگشت رشته.رشته بافر(ب)
پایان

تابع ریشه:
    سرچاپ حذف نشانه‌ها("کِتابُ الْعَرَبِیَّة")
    سرچاپ حذف نشانه‌ها("آموزشِ زبانِ برنامه‌نویسیِ سلام")
    سرچاپ حذف نشانه‌ها("café crème brûlée")
پایان
