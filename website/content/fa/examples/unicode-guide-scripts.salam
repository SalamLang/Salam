واردسازی یونیکد
واردسازی رشته

تابع خط‌های نام(نام: رشته): وکتور<رشته>:
    ناپایا یافته‌ها := وکتور {} برگردان وکتور<رشته>
    کدها := رشته.کدنقطه ها(نام)
    دیرکن کدها.آزادکن()
    هر کد در کدها:
        خ := یونیکد.خط(کد)
        اگر خ == یونیکد.خط مشترک یا خ == یونیکد.خط موروثی:
            گذر
        پایان
        نام خط := یونیکد.نام خط(کد)
        ناپایا دیده شده := نادرست
        هر ی در یافته‌ها:
            اگر ی == نام خط:
                دیده شده = درست
            پایان
        پایان
        اگر وارونه دیده شده:
            یافته‌ها.بیفزا(نام خط)
        پایان
    پایان
    برگشت یافته‌ها
پایان

تابع ریشه:
    هر نام در ["paypal"، "pаypal"، "علی_2000"، "Reza۱۳۷۰"]:
        خ := خط‌های نام(نام)
        داوری := خ.طول() > ۱ ? "آمیخته، بررسی شود" : "درست"
        سرچاپ نام، خ، داوری
        خ.آزادکن()
    پایان
پایان
