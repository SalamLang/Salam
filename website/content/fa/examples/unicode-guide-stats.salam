واردسازی یونیکد
واردسازی رشته

تابع ریشه:
    متن := "Salam 2026! سلامِ ۱۴۰۵، café (ok)"
    کدها := رشته.کدنقطه ها(متن)
    دیرکن کدها.آزادکن()
    ناپایا حرف‌ها := ۰
    ناپایا رقم‌ها := ۰
    ناپایا فاصله‌ها := ۰
    ناپایا نشانه‌گذاری := ۰
    ناپایا اعراب := ۰
    هر کد در کدها:
        اگر یونیکد.حرف است(کد):
            حرف‌ها += ۱
        وگرنه یونیکد.رقم است(کد):
            رقم‌ها += ۱
        وگرنه یونیکد.فاصله است(کد):
            فاصله‌ها += ۱
        وگرنه یونیکد.نشانه نگارشی است(کد):
            نشانه‌گذاری += ۱
        وگرنه یونیکد.نشانه است(کد):
            اعراب += ۱
        پایان
    پایان
    سرچاپ "نقطه‌های کد:"، کدها.طول()
    سرچاپ "حرف:"، حرف‌ها، "رقم:"، رقم‌ها، "فاصله:"، فاصله‌ها
    سرچاپ "نشانه‌ی نگارشی:"، نشانه‌گذاری، "نشانه:"، اعراب
پایان
