تابع ریشه:
    جمع خرید := ۱۴۰
    اگر جمع خرید بزرگتربرابر ۱۰۰:
        امتیاز := جمع خرید / ۲۰
        سرچاپ "امتیاز این خرید:"، امتیاز
    پایان
    برچسب := "سفارش"
    اگر جمع خرید بزرگتر ۱۲۰:
        برچسب := "سفارش بزرگ"
        سرچاپ "درون بلوک:"، برچسب
    پایان
    سرچاپ "پس از بلوک:"، برچسب
پایان
