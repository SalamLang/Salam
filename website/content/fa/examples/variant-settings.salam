ساختار تنظیم:
    همگانی کلید: رشته = ""
    همگانی مقدار: گوناگون<صحیح، منطقی، رشته> = ۰
پایان

تابع نمایش(ت: تنظیم): رشته:
    برگشت ت.کلید + " = " + همخوان ت.مقدار:
        صحیح ع: "" + ع پایان
        منطقی پرچم: پرچم ? "بله" : "نه" پایان
        رشته م: "«" + م + "»" پایان
    پایان
پایان

تابع ریشه:
    ناپایا تنظیم‌ها := وکتور {} برگردان وکتور<تنظیم>
    دیرکن تنظیم‌ها.آزادکن()
    تنظیم‌ها.بیفزا(تنظیم { کلید = "درگاه"، مقدار = ۸۰۸۰ })
    تنظیم‌ها.بیفزا(تنظیم { کلید = "اشکال‌زدایی"، مقدار = درست })
    تنظیم‌ها.بیفزا(تنظیم { کلید = "نام"، مقدار = "فروشگاه" })
    هر ت در تنظیم‌ها:
        سرچاپ نمایش(ت)
    پایان
پایان
