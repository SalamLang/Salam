روال ریشه:
    ناپایا فهرست پخش := وکتور {} برگردان وکتور<رشته>
    دیرکن فهرست پخش.آزادکن()
    فهرست پخش.بیفزا("مرغ سحر")
    فهرست پخش.بیفزا("سلطان قلب‌ها")
    فهرست پخش.بیفزا("گل گلدون")
    فهرست پخش.درج(۰، "پیش‌درآمد")
    سرچاپ فهرست پخش
    برداشته := فهرست پخش.حذف در(۲)
    سرچاپ "برداشته شد:"، برداشته
    سرچاپ "اولی:"، فهرست پخش.اول()، "آخری:"، فهرست پخش.آخر()
    فهرست پخش[۱] = فهرست پخش[۱] + " (اجرای زنده)"
    سرچاپ فهرست پخش[۱]، فهرست پخش.طول()
    فهرست پخش.پاک‌سازی()
    سرچاپ فهرست پخش.خالی است()
پایان
