ساختار کار:
    همگانی عنوان: رشته = ""
    همگانی دقیقه: صحیح = ۰
    همگانی انجام‌شده: منطقی = نادرست
پایان

روال ریشه:
    ناپایا کارها := وکتور {} برگردان وکتور<کار>
    دیرکن کارها.آزادکن()
    کارها.بیفزا(کار { عنوان = "جلسه‌ی صبح"، دقیقه = ۱۵ })
    کارها.بیفزا(کار { عنوان = "نوشتن گزارش"، دقیقه = ۹۰ })
    کارها.بیفزا(کار { عنوان = "بازبینی کد"، دقیقه = ۴۰ })

    اولی := کارها.ارجاع(۰)
    اولی.انجام‌شده = درست

    ناپایا مانده := ۰
    هر ش، ک در کارها:
        نشان := ک.انجام‌شده ? "x" : " "
        سرچاپ ش + ۱، "[" + نشان + "]"، ک.عنوان
        اگر وارونه ک.انجام‌شده:
            مانده += ک.دقیقه
        پایان
    پایان
    سرچاپ "دقیقه‌های مانده:"، مانده
پایان
