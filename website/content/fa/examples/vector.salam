روال ریشه:
    ناپایا عددها := وکتور {} برگردان وکتور<صحیح>
    دیرکن عددها.آزادکن()
    عددها.بیفزا(۱۰)
    عددها.بیفزا(۲۰)
    عددها.بیفزا(۳۰)
    عددها.بنشان(۱، ۲۵)
    سرچاپ عددها.طول()، عددها.بگیر(۱)
    آخری := عددها.دربیاور()
    سرچاپ آخری، عددها.طول()
    هر ع در عددها:
        سرچاپ ع
    پایان
پایان
