پایا عکس := "data:image/svg+xml,%3Csvg%20xmlns=%27http://www.w3.org/2000/svg%27%20viewBox=%270%200%20160%20100%27%3E%3Crect%20width=%27160%27%20height=%27100%27%20fill=%27%2338bdf8%27/%3E%3Ccircle%20cx=%27122%27%20cy=%2725%27%20r=%2714%27%20fill=%27%23fde047%27/%3E%3Cpath%20d=%27M0%20100L50%2040L100%20100Z%27%20fill=%27%23166534%27/%3E%3Cpath%20d=%27M60%20100L110%2055L160%20100Z%27%20fill=%27%2315803d%27/%3E%3C/svg%3E"

بخش کاشی(عبارت، اثر):
    جعبه:
        تصویر: نشانی = عکس جایگزین = "" عرض = 120 پالایه = اثر پایان
        پاراگراف: محتوا = عبارت فضا = "4px 0" پایان
    پایان
پایان

صفحه:
    عنوان = "پالایه‌ها"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        نمایش = "فلکس" شکاف = 12 پیچش آرایش = "پیچیده" تراز متن = "وسط" اندازه قلم = 13
        کاشی: عبارت = "none" اثر = "none" پایان
        کاشی: عبارت = "blur(2px)" اثر = "blur(2px)" پایان
        کاشی: عبارت = "grayscale(1)" اثر = "grayscale(1)" پایان
        کاشی: عبارت = "sepia(0.9)" اثر = "sepia(0.9)" پایان
        کاشی: عبارت = "hue-rotate(120deg)" اثر = "hue-rotate(120deg)" پایان
        کاشی: عبارت = "brightness(1.3) contrast(1.4)" اثر = "brightness(1.3) contrast(1.4)" پایان
        کاشی: عبارت = "invert(1)" اثر = "invert(1)" پایان
        کاشی: عبارت = "saturate(3)" اثر = "saturate(3)" پایان
    پایان
