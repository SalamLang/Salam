پایا عکس := "data:image/png;base64,"

صفحه:
    عنوان = "جاگیری تصویر"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        نمایش = "فلکس" شکاف = 12 پیچش آرایش = "پیچیده" تراز متن = "وسط"
        جعبه:
            تصویر: نشانی = عکس جایگزین = "پر کردن" عرض = 130 ارتفاع = 130 جاگیری شیء = "پر کردن" کادر = "1px solid #94a3b8" پایان
            پاراگراف: محتوا = "پر کردن" پایان
        پایان
        جعبه:
            تصویر: نشانی = عکس جایگزین = "جا دادن" عرض = 130 ارتفاع = 130 جاگیری شیء = "جا دادن" کادر = "1px solid #94a3b8" پایان
            پاراگراف: محتوا = "جا دادن" پایان
        پایان
        جعبه:
            تصویر: نشانی = عکس جایگزین = "پوشاندن" عرض = 130 ارتفاع = 130 جاگیری شیء = "پوشاندن" کادر = "1px solid #94a3b8" پایان
            پاراگراف: محتوا = "پوشاندن" پایان
        پایان
        جعبه:
            تصویر: نشانی = عکس جایگزین = "پوشاندن، راست" عرض = 130 ارتفاع = 130 جاگیری شیء = "پوشاندن" موقعیت شیء = "راست وسط" کادر = "1px solid #94a3b8" پایان
            پاراگراف: محتوا = "پوشاندن، راست" پایان
        پایان
    پایان
پایان
