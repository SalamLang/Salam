واردسازی دام

تابع بررسی():
    اگر دام.دریافت خاصیت منطقی(دام.با شناسه("agree")، "checked"):
        دام.تنظیم متن(دام.با شناسه("state")، "پذیرفته شد")
    وگرنه:
        دام.تنظیم متن(دام.با شناسه("state")، "هنوز نپذیرفته‌اید")
    پایان
پایان

صفحه:
    عنوان = "رنگ تاکید و رنگ نشانگر"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        ورودی: نوع = "تیک" شناسه = "agree" رنگ تاکید = "#db2777" تغییر = بررسی پایان
        برچسب: برای = "agree" محتوا = " شرط‌ها را می‌پذیرم" پایان
    پایان
    پاراگراف: شناسه = "state" محتوا = "هنوز نپذیرفته‌اید" پایان
    ورودی: نوع = "متنی" رنگ نشانگر متن = "#db2777" جانگهدار = "اینجا بنویسید، نشانگر صورتی است" عرض = 260 فاصله = 8 پایان
پایان
