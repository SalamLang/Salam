واردسازی دام

تابع تازه():
    محو := دام.دریافت مقدار(دام.با شناسه("blur"))
    چرخش := دام.دریافت مقدار(دام.با شناسه("hue"))
    دام.تنظیم سبک(دام.با شناسه("pic")، "filter"، "blur(" + محو + "px) hue-rotate(" + چرخش + "deg)")
    دام.تنظیم متن(دام.با شناسه("out")، "blur(" + محو + "px) hue-rotate(" + چرخش + "deg)")
پایان

صفحه:
    عنوان = "پالایه‌ی زنده"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        شناسه = "pic"
        عرض = 220
        ارتفاع = 120
        گردی کادر = 12
        پس زمینه = "radial-gradient(circle at 70% 30%, #fde047 0 14%, transparent 15%), linear-gradient(#38bdf8, #0ea5e9 60%, #166534 60%)"
    پایان
    جعبه:
        فضا = "12px 0"
        برچسب: محتوا = "محوی " پایان
        ورودی: نوع = "بازه" شناسه = "blur" کمینه = 0 بیشینه = 10 مقدار = 0 ورودی = تازه پایان
    پایان
    جعبه:
        برچسب: محتوا = "چرخش فام " پایان
        ورودی: نوع = "بازه" شناسه = "hue" کمینه = 0 بیشینه = 360 مقدار = 0 ورودی = تازه پایان
    پایان
    پاراگراف: شناسه = "out" محتوا = "blur(0px) hue-rotate(0deg)" پایان
پایان
