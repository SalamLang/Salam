صفحه:
    عنوان = "متن دور یک شکل"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, serif" فضا = "1.5rem" بیشینه عرض = "34rem" ارتفاع خط = 1.6 پایان
    جعبه:
        شناوری = "راست"
        عرض = 150
        ارتفاع = 150
        فضا = "0 0 0 12px"
        پس زمینه = "radial-gradient(circle at 35% 35%, #fde047, #ea580c)"
        گردی کادر = "50%"
        بیرونی شکل = "circle(50%)"
        فضا شکل = 10
    پایان
    پاراگراف:
        محتوا = "متن معمولاً دور مستطیل یک جعبه‌ی شناور می‌پیچد. با «بیرونی شکل» به‌جای مستطیل دور دایره می‌پیچد، پس سطرها زیر انحنا فرو می‌روند و گوشه‌های خالی هم به کار می‌آیند. «فضا شکل» میان شکل و واژه‌ها کمی فاصله می‌اندازد، و این پاراگراف آن‌قدر بلند است که اثر آن را کنار خورشید در هر سطر ببینید."
    پایان
پایان
