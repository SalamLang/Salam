واردسازی دام

تابع تازه():
    افقی := دام.دریافت مقدار(دام.با شناسه("x"))
    عمودی := دام.دریافت مقدار(دام.با شناسه("y"))
    محو := دام.دریافت مقدار(دام.با شناسه("blur"))
    گردی := دام.دریافت مقدار(دام.با شناسه("radius"))
    سایه := افقی + "px " + عمودی + "px " + محو + "px rgb(0 0 0 / 35%)"
    دام.تنظیم سبک(دام.با شناسه("card")، "box-shadow"، سایه)
    دام.تنظیم سبک(دام.با شناسه("card")، "border-radius"، گردی + "px")
    دام.تنظیم متن(دام.با شناسه("css")، "box-shadow: " + سایه + "; border-radius: " + گردی + "px")
پایان

صفحه:
    عنوان = "آزمایشگاه سایه"
