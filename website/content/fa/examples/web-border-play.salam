    جعبه: برچسب: محتوا = "عمودی" عرض = 70 نمایش = "inline-block" پایان ورودی: نوع = "بازه" شناسه = "y" کمینه = "-20" بیشینه = "20" مقدار = "4" ورودی = تازه پایان پایان
    جعبه: برچسب: محتوا = "محو" عرض = 70 نمایش = "inline-block" پایان ورودی: نوع = "بازه" شناسه = "blur" کمینه = "0" بیشینه = "40" مقدار = "12" ورودی = تازه پایان پایان
