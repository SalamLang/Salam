واردسازی دام
واردسازی وب.بوم

تابع ریشه:
    عنصر := دام.بساز("canvas")
    دام.تنظیم ویژگی(عنصر، "id"، "chart")
    دام.تنظیم ویژگی(عنصر، "width"، "420")
    دام.تنظیم ویژگی(عنصر، "height"، "240")
    دام.افزودن(دام.بدنه()، عنصر)
    بوم من := بوم.دریافت بوم("chart")

    ماه‌ها := ["فروردین"، "اردیبهشت"، "خرداد"، "تیر"، "مرداد"، "شهریور"]
    فروش := [۴۲.۰، ۵۵.۰، ۳۸.۰، ۷۱.۰، ۶۴.۰، ۸۰.۰]
    بیشینه := ۱۰۰.۰
    پایه := ۲۰۰.۰
    پهنای ستون := ۴۰.۰
    فاصله := ۲۴.۰

    بوم.سبک خط(بوم من، "#999")
    بوم.ضخامت خط(بوم من، ۱)
    بوم.شروع مسیر(بوم من)
    بوم.برو به(بوم من، ۳۰، پایه)
    بوم.خط به(بوم من، ۴۱۰، پایه)
    بوم.بکش(بوم من)

    بوم.قلم(بوم من، "13px sans-serif")
    بوم.ترازبندی متن(بوم من، "center")
    هر ش، مقدار در فروش:
        افقی := ۴۰.۰ + (ش برگردان اعشار۶۴) * (پهنای ستون + فاصله)
        بلندی := مقدار / بیشینه * ۱۶۰.۰
        بوم.سبک پرشدگی(بوم من، "#3b82f6")
        بوم.شروع مسیر(بوم من)
        بوم.مستطیل گرد(بوم من، افقی، پایه - بلندی، پهنای ستون، بلندی، ۴)
        بوم.پرکن(بوم من)
        بوم.سبک پرشدگی(بوم من، "#222")
        بوم.پرکردن متن(بوم من، ماه‌ها[ش]، افقی + پهنای ستون / ۲، پایه + ۱۸)
        بوم.پرکردن متن(بوم من، "" + (مقدار برگردان صحیح)، افقی + پهنای ستون / ۲، پایه - بلندی - ۶)
    پایان
پایان
