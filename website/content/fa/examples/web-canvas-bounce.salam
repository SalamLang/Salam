واردسازی دام
واردسازی وب.بوم

ناپایا افقی := ۶۰.۰
ناپایا عمودی := ۶۰.۰
ناپایا گام افقی := ۳.۰
ناپایا گام عمودی := ۲.۰
ناپایا بوم من := ۰ برگردان صحیح۶۴

تابع ریشه:
    عنصر := دام.بساز("canvas")
    دام.تنظیم ویژگی(عنصر، "id"، "box")
    دام.تنظیم ویژگی(عنصر، "width"، "360")
    دام.تنظیم ویژگی(عنصر، "height"، "220")
    دام.افزودن(دام.بدنه()، عنصر)
    بوم من = بوم.دریافت بوم("box")
    شعاع := ۱۴.۰

    دام.چرخش فریم((گذشته: اعشار۶۴):
        _ := گذشته
        پهنا := بوم.عرض(بوم من)
        بلندی := بوم.ارتفاع(بوم من)
        افقی += گام افقی
        عمودی += گام عمودی
        اگر افقی کوچکتر شعاع یا افقی بزرگتر پهنا - شعاع:
            گام افقی = ۰.۰ - گام افقی
        پایان
        اگر عمودی کوچکتر شعاع یا عمودی بزرگتر بلندی - شعاع:
            گام عمودی = ۰.۰ - گام عمودی
        پایان
        بوم.سبک پرشدگی(بوم من، "#10131a")
        بوم.پرکردن مستطیل(بوم من، ۰، ۰، پهنا، بلندی)
        بوم.شروع مسیر(بوم من)
        بوم.کمان(بوم من، افقی، عمودی، شعاع، ۰، ۶.۲۸۳۲)
        بوم.سبک پرشدگی(بوم من، "#f59e0b")
        بوم.پرکن(بوم من)
    پایان)
پایان
