واردسازی دام
واردسازی وب.بوم

ناپایا بوم من := ۰ برگردان صحیح۶۴
ناپایا زاویه := ۰.۰

تابع ریشه:
    عنصر := دام.بساز("canvas")
    دام.تنظیم ویژگی(عنصر، "id"، "spin")
    دام.تنظیم ویژگی(عنصر، "width"، "120")
    دام.تنظیم ویژگی(عنصر، "height"، "120")
    دام.افزودن(دام.بدنه()، عنصر)
    بوم من = بوم.دریافت بوم("spin")

    دام.چرخش فریم((گذشته: اعشار۶۴):
        زاویه += گذشته / ۴۰۰.۰
        بوم.پاک کردن مستطیل(بوم من، ۰، ۰، ۱۲۰، ۱۲۰)
        بوم.ذخیره وضعیت(بوم من)
        بوم.جابجایی مختصات(بوم من، ۶۰، ۶۰)
        بوم.چرخش(بوم من، زاویه)
        تکرار ۱۲ در ش:
            بوم.شفافیت(بوم من، (ش برگردان اعشار۶۴ + ۱.۰) / ۱۲.۰)
            بوم.سبک پرشدگی(بوم من، "#0ea5e9")
            بوم.شروع مسیر(بوم من)
            بوم.مستطیل گرد(بوم من، -۴، -۴۴، ۸، ۱۸، ۴)
            بوم.پرکن(بوم من)
            بوم.چرخش(بوم من، ۶.۲۸۳۲ / ۱۲.۰)
        پایان
        بوم.بازگردانی وضعیت(بوم من)
    پایان)
پایان
