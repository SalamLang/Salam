واردسازی دام
واردسازی وب.بوم

ناپایا ز := ۰ برگردان صحیح۶۴
ناپایا صفحه بوم := ۰ برگردان صحیح۶۴
ناپایا مهر := ۰ برگردان صحیح۶۴
ناپایا شمار مهرها := ۰

تابع پاک کردن صفحه():
    بوم.سبک پرشدگی(ز، "#f1f5f9")
    بوم.پرکردن مستطیل(ز، ۰، ۰، بوم.عرض(ز)، بوم.ارتفاع(ز))
    بوم.سبک پرشدگی(ز، "#334155")
    بوم.قلم(ز، "14px sans-serif")
    بوم.ترازبندی متن(ز، "right")
    بوم.پرکردن متن(ز، "برای گذاشتن مهر کلیک کنید"، ۳۹۰، ۲۰)
پایان

تابع ریشه:
    صفحه بوم = دام.بساز("canvas")
    دام.تنظیم ویژگی(صفحه بوم، "width"، "400")
    دام.تنظیم ویژگی(صفحه بوم، "height"، "260")
    دام.افزودن(دام.بدنه()، صفحه بوم)
    ز = بوم.زمینه عنصر(صفحه بوم)
    مهر = دام.بارگذاری تصویر("stamp.png")
    پاک کردن صفحه()

    دام.هنگام رویداد جزئی(صفحه بوم، "click"، (ر: صحیح۶۴):
        اگر وارونه دام.تصویر آماده(مهر): برگشت پایان
        کادر := دام.فراخوان(صفحه بوم، "getBoundingClientRect")
        جای افقی := دام.رویداد افقی(ر) - دام.دریافت خاصیت عددی(کادر، "left")
        جای عمودی := دام.رویداد عمودی(ر) - دام.دریافت خاصیت عددی(کادر، "top")
        بوم.رسم تصویر(ز، مهر، جای افقی - ۱۶، جای عمودی - ۱۶، ۳۲، ۳۲)
        شمار مهرها += ۱
        دام.تنظیم عنوان(شمار مهرها + " مهر")
    پایان)
    دام.هنگام رویداد جزئی(صفحه بوم، "contextmenu"، (ر: صحیح۶۴):
        دام.جلوگیری پیش فرض(ر)
        پاک کردن صفحه()
        شمار مهرها = ۰
    پایان)
پایان
