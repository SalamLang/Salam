واردسازی دام

صفحه:
    عنوان = "اندازه جعبه"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 20 پایان
    سراسری: گزینشگر = ".border" اندازه جعبه = "border-box" پایان
    جعبه:
        شناسه = "b"
        عرض = 240
        فاصله = 20
        کادر = "6px solid #0f766e"
        پس زمینه = "#ccfbf1"
        محتوا = "عرض = 240"
    پایان
    پاراگراف: شناسه = "out" محتوا = "عرض جعبه اکنون 292 پیکسل است" پایان
    دکمه:
        محتوا = "تغییر اندازه جعبه"
        کلیک = ():
            دام.تعویض کلاس(دام.با شناسه("b")، "border")
            پهنا := دام.دریافت خاصیت عددی(دام.با شناسه("b")، "offsetWidth")
            دام.تنظیم متن(دام.با شناسه("out")، "عرض جعبه اکنون " + پهنا + " پیکسل است")
        پایان
    پایان
پایان
