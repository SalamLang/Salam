پایا گام := 16
پایا رنگ‌اصلی := "#0f766e"

بخش کارت(عنوان، متن، فام):
    جعبه:
        فاصله = گام
        فضا = "0 0 " + گام + "px"
        کادر = "2px solid " + فام
        گردی کادر = گام / 2 + "px"
        سرتیتر: اندازه = 3 محتوا = عنوان رنگ = فام فضا = "0 0 6px" پایان
        پاراگراف: محتوا = متن فضا = 0 پایان
        محتوا: پایان
    پایان
پایان

صفحه:
    عنوان = "کارت‌های قابل استفاده‌ی دوباره"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = گام * 2 + "px" پایان
    کارت: عنوان = "سریع" متن = "به کد ماشین ساخته می‌شود." فام = رنگ‌اصلی پایان
    کارت: عنوان = "ایمن" متن = "هنگام ترجمه بررسی می‌شود." فام = "#2563eb"
        پاراگراف: محتوا = "حتی سبک‌های صفحه." رنگ = "#64748b" پایان
    پایان
