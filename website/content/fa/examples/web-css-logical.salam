صفحه:
    عنوان = "ویژگی‌های منطقی"
    سراسری: اندازه جعبه = "border-box" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 20 پایان
    سراسری: گزینشگر = "p" فضا = "0 0 12px" پایان
    جعبه:
        جهت = ltr
        پاراگراف:
            اندازه خطی = "70%"
            فضا ابتدا = 40
            فاصله خطی = "24 8"
            فاصله بلوکی = 10
            کادر خطی آغاز = "6px solid #0f766e"
            پس زمینه = "#ccfbf1"
            محتوا = "جهت چپ به راست: آغاز همان سمت چپ است"
        پایان
    پایان
