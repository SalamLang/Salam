    سراسری: گزینشگر = "p" فضا = "0 0 10px" جهت متن = ltr پایان
    پاراگراف: محتوا = "فاصله\u200e = 24" فاصله = 24 پس زمینه = "#e0f2fe" پایان
    پاراگراف: محتوا = "فاصله\u200e = 8 40" فاصله = "8 40" پس زمینه = "#dcfce7" پایان
    پاراگراف: محتوا = "کادر\u200e = 3px dashed" فاصله = 12 کادر = "3px dashed #0f766e" پایان
    پاراگراف: محتوا = "عرض\u200e = 60%" فاصله = 12 عرض = "60%" پس زمینه = "#fef9c3" پایان
