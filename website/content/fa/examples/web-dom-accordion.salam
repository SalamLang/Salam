بخش تکه(نام: رشته، سرخط: رشته):
    باز := نادرست
    جعبه:
        کادر = 1، "توپر"، "#e2e8f0"
        گردی = 10
        سرریز = "پنهان"
        فضا = 0، 0، 8، 0
        دکمه:
            شناسه = "h-" + نام
            عرض = "پر"
            تراز متن = "ابتدا"
            فاصله = 12، 14
            اندازه قلم = 16
            وزن قلم = 400
            کادر = 0
            پس‌زمینه = "#f1f5f9"
            نشانگر = "اشاره"
            اشاره:
                پس‌زمینه = "#e0e7ff"
            پایان
            اگر باز:
                وزن قلم = 700
            پایان
            aria expanded = باز ? "true" : "false"
            کلیک = (): باز = باز برابر نادرست پایان
            محتوا = سرخط
        پایان
        اگر باز:
            جعبه:
                فاصله = 0، 14، 12، 14
                محتوا: پایان
            پایان
        پایان
    پایان
پایان

