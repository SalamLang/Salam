واردسازی دام

تابع بگردان(نام: رشته):
    سرخط := دام.با شناسه("h-" + نام)
    قاب := دام.با شناسه("p-" + نام)
    دام.تعویض کلاس(قاب، "open")
    اگر دام.دریافت ویژگی(سرخط، "aria-expanded") == "true":
        دام.تنظیم ویژگی(سرخط، "aria-expanded"، "false")
    وگرنه:
        دام.تنظیم ویژگی(سرخط، "aria-expanded"، "true")
    پایان
پایان

بخش تاشو(نام، عنوان):
    جعبه:
        کلاس = "fold"
        دکمه: شناسه = "h-" + نام باز شده دسترسی‌پذیری = "false" کلیک = (): بگردان(نام) پایان محتوا = عنوان پایان
        جعبه: شناسه = "p-" + نام کلاس = "pane"
            محتوا: پایان
        پایان
    پایان
پایان

صفحه:
    عنوان = "پرسش‌های پرتکرار"
    ظاهر سفارشی: محتوا = ".pane { display: none; padding: 0 14px 12px } .pane.open { display: block } .fold button { width: 100%; text-align: start; padding: 12px 14px; font-size: 1rem; border: 0; background: #f1f5f9; cursor: pointer; font-family: inherit } .fold button:hover { background: #e0e7ff } .fold button[aria-expanded=true] { font-weight: bold }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "30rem" پایان
    سراسری: گزینشگر = ".fold" کادر = "1px solid #e2e8f0" گردی کادر = 10 سرریز = پنهان فضا = "0 0 8px 0" پایان
    تاشو: نام = "ship" عنوان = "ارسال سفارش چقدر طول می‌کشد؟"
        پاراگراف: محتوا = "دو تا چهار روز کاری، در سراسر کشور." پایان
    پایان
