واردسازی دام

پایا حد := 80

تابع بسنج:
    استفاده := دام.دریافت خاصیت عددی(دام.با شناسه("note")، "textLength") برگردان صحیح۶۴
    دام.تنظیم متن(دام.با شناسه("used")، "" + استفاده + " / " + حد)
    اگر استفاده > حد:
        دام.تنظیم سبک(دام.با شناسه("used")، "color"، "#dc2626")
        دام.تنظیم سبک(دام.با شناسه("bar")، "width"، "100%")
        دام.تنظیم سبک(دام.با شناسه("bar")، "background"، "#dc2626")
    وگرنه:
        دام.تنظیم سبک(دام.با شناسه("used")، "color"، "#475569")
        دام.تنظیم سبک(دام.با شناسه("bar")، "width"، "" + استفاده * 100 / حد + "%")
        دام.تنظیم سبک(دام.با شناسه("bar")، "background"، "#4f46e5")
    پایان
    دام.تنظیم خاصیت منطقی(دام.با شناسه("post")، "disabled"، استفاده == 0 یا استفاده > حد)
پایان

صفحه:
    عنوان = "شمارنده‌ی نویسه"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "28rem" پایان
    متن بلند: شناسه = "note" ورودی = بسنج ردیف‌ها = 3 جانگهدار = "یادداشت کوتاهی بنویسید" عرض = "100%" فاصله = 10 اندازه قلم = "1rem" خانواده قلم = inherit اندازه جعبه = "border-box" گردی کادر = 8 کادر = "1px solid #cbd5e1" پایان
    جعبه: ارتفاع = 6 پس زمینه = "#e2e8f0" گردی کادر = 3 فضا = "6px 0"
        جعبه: شناسه = "bar" ارتفاع = "100%" عرض = "0%" پس زمینه = "#4f46e5" گردی کادر = 3 گذار = "width 0.15s" پایان
    پایان
    جعبه: نمایش = فلکس چینش = "space-between" ترازعمودی = وسط
        تکه: شناسه = "used" محتوا = "0 / 80" رنگ = "#475569" جهت = "ltr" پایان
        دکمه: شناسه = "post" غیرفعال = درست محتوا = "ارسال" فاصله = "6px 16px" پایان
    پایان
پایان
