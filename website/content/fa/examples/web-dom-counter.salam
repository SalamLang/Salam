واردسازی دام

ناپایا شمار := 0

تابع ترسیم:
    نمایشگر := دام.با شناسه("value")
    دام.تنظیم متن(نمایشگر، "" + شمار)
    اگر شمار کوچکتر 0:
        دام.تنظیم سبک(نمایشگر، "color"، "#dc2626")
    وگرنه:
        دام.تنظیم سبک(نمایشگر، "color"، "#0f172a")
    پایان
پایان

تابع بیفزا:
    شمار++
    ترسیم()
پایان

تابع بکاه:
    شمار--
    ترسیم()
پایان

تابع صفرکن:
    شمار = 0
    ترسیم()
پایان

صفحه:
    عنوان = "شمارنده"
    قلم = "Tahoma"، سیستمی، ساده
    فضا = 1.5rem
    جعبه:
        بیشینه عرض = 16rem
        فضا = 0، خودکار
        فاصله = 20
        تراز متن = وسط
        کادر = 1px، توپر، #e2e8f0
        گردی = 14
        سرتیتر:
            شناسه = "value"
            اندازه = 1
            محتوا = "0"
            اندازه قلم = 4rem
            فضا = 0، 0، 12px، 0
        پایان
