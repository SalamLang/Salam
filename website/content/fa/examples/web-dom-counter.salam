واردسازی دام

ناپایا شمار := 0

تابع ترسیم:
    نمایشگر := دام.با شناسه("value")
    دام.تنظیم متن(نمایشگر، "" + شمار)
    اگر شمار < 0:
        دام.تنظیم سبک(نمایشگر، "color"، "#dc2626")
    وگرنه:
        دام.تنظیم سبک(نمایشگر، "color"، "#0f172a")
    پایان
پایان

تابع بیفزا:
    شمار += 1
    ترسیم()
پایان

تابع بکاه:
    شمار -= 1
    ترسیم()
پایان

تابع صفرکن:
    شمار = 0
    ترسیم()
پایان

صفحه:
    عنوان = "شمارنده"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    سراسری: گزینشگر = "button" فاصله = "8px 18px" اندازه قلم = "1.1rem" کادر = "1px solid #cbd5e1" گردی کادر = 8 پس زمینه = "#f8fafc" نشانگر = اشاره‌گر پایان
    سراسری: گزینشگر = "button:hover" پس زمینه = "#e0e7ff" پایان
    جعبه:
        بیشینه عرض = "16rem" فضا = "0 auto" فاصله = 20 ترازمتن = وسط کادر = "1px solid #e2e8f0" گردی کادر = 14
        سرتیتر: شناسه = "value" اندازه = 1 محتوا = "0" اندازه قلم = "4rem" فضا = "0 0 12px 0" پایان
        دکمه: شناسه = "minus" کلیک = بکاه محتوا = "-1" جهت = "ltr" پایان
        دکمه: شناسه = "plus" کلیک = بیفزا محتوا = "+1" فضا = "0 8px" جهت = "ltr" پایان
        دکمه: شناسه = "zero" کلیک = صفرکن محتوا = "از نو" پایان
    پایان
پایان
