واردسازی دام

تابع محدود:
    عبارت := دام.دریافت مقدار(دام.با شناسه("q"))
    سطرها := دام.پرسمان همه("#books li")
    ناپایا دیده := 0
    تکرار دام.تعداد(سطرها) در ردیف:
        سطر := دام.عنصر شماره(سطرها، ردیف)
        اگر دام.دریافت متن(سطر).دربردارد(عبارت):
            دام.تنظیم سبک(سطر، "display"، "")
            دیده += 1
        وگرنه:
            دام.تنظیم سبک(سطر، "display"، "none")
        پایان
    پایان
    دام.تنظیم متن(دام.با شناسه("found")، "" + دیده + " از " + دام.تعداد(سطرها))
    اگر دیده == 0:
        دام.تنظیم سبک(دام.با شناسه("none")، "display"، "block")
    وگرنه:
        دام.تنظیم سبک(دام.با شناسه("none")، "display"، "none")
    پایان
پایان

صفحه:
    عنوان = "پالایش"
    ظاهر سفارشی: محتوا = "#books li { padding: 10px 12px; margin: 6px 0; background: #f1f5f9; border-radius: 8px }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "26rem" پایان
    ورودی: شناسه = "q" نوع = جستجو ورودی = محدود جانگهدار = "جست‌وجو در قفسه" عرض = "100%" فاصله = 10 اندازه قلم = "1rem" اندازه جعبه = "border-box" گردی کادر = 8 کادر = "1px solid #cbd5e1" پایان
    پاراگراف: شناسه = "found" محتوا = "6 از 6" رنگ = "#475569" فضا = "6px 0" پایان
    فهرست: شناسه = "books" سبک فهرست = هیچ فاصله = 0
        مورد: محتوا = "شازده کوچولو" پایان
        مورد: محتوا = "غرور و تعصب" پایان
        مورد: محتوا = "هابیت" پایان
        مورد: محتوا = "زنان کوچک" پایان
        مورد: محتوا = "موبی دیک" پایان
        مورد: محتوا = "آرزوهای بزرگ" پایان
    پایان
    پاراگراف: شناسه = "none" محتوا = "هیچ کتابی در قفسه با این عبارت نمی‌خواند." نمایش = هیچ رنگ = "#b45309" پایان
