تابع قفسه(): وکتور<رشته>:
    ناپایا کتاب‌ها := وکتور {} برگردان وکتور<رشته>
    کتاب‌ها.افزودن("شازده کوچولو")
    کتاب‌ها.افزودن("غرور و تعصب")
    کتاب‌ها.افزودن("هابیت")
    کتاب‌ها.افزودن("زنان کوچک")
    کتاب‌ها.افزودن("موبی دیک")
    کتاب‌ها.افزودن("آرزوهای بزرگ")
    برگشت کتاب‌ها
پایان

تابع مطابقت(عنوان: رشته، واژه: رشته): منطقی:
    برگشت عنوان.کوچک().دربردارد(واژه.کوچک())
پایان

تابع یافته(کتاب‌ها: وکتور<رشته>، واژه: رشته): صحیح:
    ناپایا شمار := 0
    تکرار کتاب‌ها.طول() در ک:
        اگر مطابقت(کتاب‌ها.بگیر(ک)، واژه):
            شمار++
        پایان
    پایان
    برگشت شمار
پایان

تابع کل(کتاب‌ها: وکتور<رشته>): صحیح:
    برگشت کتاب‌ها.طول()
پایان

