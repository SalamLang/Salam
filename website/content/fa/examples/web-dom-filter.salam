            عرض = پر
            فاصله = 10
            اندازه قلم = 16
            گردی = 8
            کادر = 1، توپر، #cbd5e1
            جانگهدار = "قفسه را بگردید"
            ورودی = (v: رشته): جستار = v پایان
        پایان
        پاراگراف: شناسه = "found" رنگ = #475569 فضا = 6، 0 محتوا = یافته(کتاب‌ها، جستار) + " از " + کل(کتاب‌ها) پایان
        فهرست:
            شناسه = "books"
            فاصله = 0
            هر عنوان در کتاب‌ها:
                اگر مطابقت(عنوان، جستار):
                    مورد: کلید = عنوان فاصله = 10، 12 فضا = 6، 0 پس‌زمینه = #f1f5f9 گردی = 8 محتوا = عنوان پایان
                پایان
            پایان
        پایان
        اگر یافته(کتاب‌ها، جستار) برابر 0:
            پاراگراف: شناسه = "none" رنگ = #b45309 محتوا = "هیچ کتابی در قفسه نمی‌خواند." پایان
        پایان
    پایان
پایان

