واردسازی دام

تابع ذخیره:
    نوشته := دام.دریافت مقدار(دام.با شناسه("text"))
    دام.تنظیم متن ذخیره("note"، نوشته)
    اگر دام.دریافت متن ذخیره("note") == نوشته:
        دام.تنظیم متن(دام.با شناسه("state")، "روی این دستگاه ذخیره شد.")
    وگرنه:
        دام.تنظیم متن(دام.با شناسه("state")، "این مرورگر آن را نگه نمی‌دارد.")
    پایان
پایان

تابع بارگذاری:
    ذخیره‌شده := دام.دریافت متن ذخیره("note")
    اگر ذخیره‌شده.طول() > 0:
        دام.تنظیم مقدار(دام.با شناسه("text")، ذخیره‌شده)
        دام.تنظیم متن(دام.با شناسه("state")، "یادداشت ذخیره‌شده‌ی شما بارگذاری شد.")
    وگرنه:
        دام.تنظیم متن(دام.با شناسه("state")، "هنوز چیزی ذخیره نشده است.")
    پایان
پایان

صفحه:
    عنوان = "یادداشت"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "28rem" پایان
    متن بلند: شناسه = "text" ورودی = ذخیره ردیف‌ها = 4 جانگهدار = "یادداشت شما" عرض = "100%" فاصله = 10 اندازه قلم = "1rem" خانواده قلم = inherit اندازه جعبه = "border-box" گردی کادر = 8 کادر = "1px solid #cbd5e1" پایان
    جعبه: نمایش = فلکس چینش = "space-between" ترازعمودی = وسط فضا = "6px 0"
        تکه: شناسه = "state" محتوا = "هنوز چیزی ذخیره نشده است." رنگ = "#475569" پایان
        دکمه: شناسه = "again" کلیک = بارگذاری محتوا = "بارگذاری یادداشت" فاصله = "6px 14px" پایان
    پایان
    اسکریپت سفارشی: محتوا = "window.addEventListener('DOMContentLoaded', function () { بارگذاری(); });" پایان
پایان
