واردسازی دام

تابع رای(نام: رشته):
    جمع := دام.با شناسه("votes-" + نام)
    دام.تنظیم متن(جمع، "" + (دام.دریافت متن(جمع).به صحیح() + 1))
پایان

بخش گزینه(نام):
    جعبه:
        کلاس = "choice"
        دکمه: کلیک = (): رای(نام) پایان محتوا = "رأی به " + نام پایان
        تکه: شناسه = "votes-" + نام محتوا = "0" پایان
    پایان
پایان

صفحه:
    عنوان = "نظرسنجی"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "26rem" پایان
    سراسری: گزینشگر = ".choice" نمایش = فلکس چینش = "space-between" ترازعمودی = وسط فاصله = "8px 12px" فضا = "0 0 8px 0" پس زمینه = "#f1f5f9" گردی کادر = 10 پایان
    سراسری: گزینشگر = ".choice button" فاصله = "6px 14px" کادر = "1px solid #6366f1" گردی کادر = 8 پس زمینه = سفید رنگ = "#4338ca" نشانگر = اشاره‌گر خانواده قلم = inherit پایان
    سراسری: گزینشگر = ".choice span" اندازه قلم = "1.4rem" وزن قلم = پررنگ رنگ = "#0f172a" پایان
    سرتیتر: اندازه = 2 محتوا = "نوشیدنی مورد علاقه‌ی شما؟" فضا = "0 0 12px 0" پایان
    گزینه: نام = "چای" پایان
    گزینه: نام = "قهوه" پایان
    گزینه: نام = "آبمیوه" پایان
