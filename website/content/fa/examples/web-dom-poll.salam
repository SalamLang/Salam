واردسازی دام

تابع رای(نام: رشته):
    جمع := دام.با شناسه("votes-" + نام)
    دام.تنظیم متن(جمع، "" + (دام.دریافت متن(جمع).به صحیح() + 1))
پایان

بخش گزینه(نام):
    جعبه:
        کلاس = "choice"
        چیدمان = "ردیف"
        چینش = "میان"
        تراز = "وسط"
        فاصله = 8px، 12px
        فضا = 0، 0، 8px، 0
        پس‌زمینه = "#f1f5f9"
        گردی = 10
        دکمه:
            فاصله = 6px، 14px
            کادر = 1px، "توپر"، "#6366f1"
            گردی = 8
            پس‌زمینه = "سفید"
            رنگ = "#4338ca"
            نشانگر = "اشاره"
            قلم = "inherit"
            کلیک = (): رای(نام) پایان
            محتوا = "رأی به " + نام
        پایان
        تکه:
            اندازه قلم = 1.4rem
            وزن قلم = "پررنگ"
            رنگ = "#0f172a"
            شناسه = "votes-" + نام
            محتوا = "0"
        پایان
    پایان
پایان

