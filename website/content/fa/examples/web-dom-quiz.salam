واردسازی دام

ناپایا پرسیده := 0
ناپایا امتیاز := 0
ناپایا قفل := نادرست

تابع کارت(شماره: صحیح): رشته:
    ترابرد شماره:
        0: برگشت "کدام عنصر بزرگ‌ترین سرتیتر است؟|h1|h6|header|0" پایان
        1: برگشت "کدام ویژگی به تصویر متن جایگزین می‌دهد؟|alt|src|title|0" پایان
        وگرنه: برگشت "کدام رویداد با هر تایپ در یک کادر رخ می‌دهد؟|click|input|load|1" پایان
    پایان
    برگشت ""
پایان

تابع نمایش‌کارت:
    اجزا := کارت(پرسیده).بشکاف("|")
    دام.تنظیم متن(دام.با شناسه("ask")، اجزا.بگیر(0))
    تکرار 3 در k:
        دام.تنظیم متن(دام.با شناسه("c" + k)، اجزا.بگیر(k + 1))
        دام.تنظیم ویژگی(دام.با شناسه("c" + k)، "class"، "choice")
    پایان
    دام.تنظیم متن(دام.با شناسه("verdict")، "یک پاسخ انتخاب کنید.")
    قفل = نادرست
پایان

تابع انتخاب(k: صحیح):
    اگر وارونه قفل:
        قفل = درست
        درست‌ها := کارت(پرسیده).بشکاف("|").بگیر(4).به صحیح()
        اگر k == درست‌ها:
            امتیاز += 1
            دام.افزودن کلاس(دام.با شناسه("c" + k)، "right")
            دام.تنظیم متن(دام.با شناسه("verdict")، "درست است.")
        وگرنه:
            دام.افزودن کلاس(دام.با شناسه("c" + k)، "wrong")
            دام.افزودن کلاس(دام.با شناسه("c" + درست‌ها)، "right")
            دام.تنظیم متن(دام.با شناسه("verdict")، "این بار نه.")
        پایان
    پایان
پایان

تابع بعدی:
    اگر پرسیده == 3:
        پرسیده = 0
        امتیاز = 0
        دام.تنظیم متن(دام.با شناسه("next")، "بعدی")
        نمایش‌کارت()
    وگرنه قفل:
        پرسیده += 1
        اگر پرسیده == 3:
            دام.تنظیم متن(دام.با شناسه("verdict")، "امتیاز شما " + امتیاز + " از 3 است.")
            دام.تنظیم متن(دام.با شناسه("next")، "بازی دوباره")
        وگرنه:
            نمایش‌کارت()
        پایان
    پایان
پایان

صفحه:
    عنوان = "پرسش و پاسخ"
    ظاهر سفارشی: محتوا = ".choice { display: block; width: 100%; margin: 6px 0; padding: 10px 14px; text-align: start; font-size: 1rem; font-family: inherit; border: 1px solid #cbd5e1; border-radius: 8px; background: white; cursor: pointer } .choice:hover { background: #eef2ff } .choice.right { background: #dcfce7; border-color: #16a34a } .choice.wrong { background: #fee2e2; border-color: #dc2626 }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "28rem" پایان
    سرتیتر: شناسه = "ask" اندازه = 3 محتوا = "کدام عنصر بزرگ‌ترین سرتیتر است؟" پایان
    دکمه: شناسه = "c0" کلاس = "choice" کلیک = (): انتخاب(0) پایان محتوا = "h1" جهت = "ltr" پایان
    دکمه: شناسه = "c1" کلاس = "choice" کلیک = (): انتخاب(1) پایان محتوا = "h6" جهت = "ltr" پایان
    دکمه: شناسه = "c2" کلاس = "choice" کلیک = (): انتخاب(2) پایان محتوا = "header" جهت = "ltr" پایان
    پاراگراف: شناسه = "verdict" محتوا = "یک پاسخ انتخاب کنید." رنگ = "#475569" پایان
    دکمه: شناسه = "next" کلیک = بعدی محتوا = "بعدی" فاصله = "8px 18px" کادر = "0" پس زمینه = "#4f46e5" رنگ = سفید گردی کادر = 8 نشانگر = اشاره‌گر پایان
پایان
