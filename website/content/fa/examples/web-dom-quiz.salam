تابع پرسش(شماره: صحیح): رشته:
    ترابرد شماره:
        0: برگشت "کدام عنصر بزرگ‌ترین سرتیتر است؟|h1|h6|header|0" پایان
        1: برگشت "کدام ویژگی به تصویر متن جایگزین می‌دهد؟|alt|src|title|0" پایان
        وگرنه: برگشت "کدام رویداد با هر تایپ در یک کادر رخ می‌دهد؟|click|input|load|1" پایان
    پایان
    برگشت ""
پایان

تابع قسمت(شماره: صحیح، ک: صحیح): رشته:
    برگشت پرسش(شماره).بشکاف("|").بگیر(ک)
پایان

تابع شماره پاسخ(شماره: صحیح): صحیح:
    برگشت قسمت(شماره، 4).به صحیح()
پایان

تابع نشان(شماره: صحیح، برگزیده: صحیح، ک: صحیح): صحیح:
    اگر برگزیده کوچکتر 0:
        برگشت 0
    پایان
    اگر ک برابر شماره پاسخ(شماره):
        برگشت 1
    پایان
    اگر ک برابر برگزیده:
        برگشت 2
    پایان
    برگشت 0
پایان

بخش گزینه(برچسب: رشته، نشان: صحیح، انتخاب):
    دکمه:
        عرض = پر
        فضا = 6، 0
        فاصله = 10، 14
        تراز متن = ابتدا
        اندازه قلم = 16
        کادر = 1، توپر، #cbd5e1
        گردی = 8
        پس‌زمینه = سفید
        نشانگر = اشاره
        اشاره:
            پس‌زمینه = #eef2ff
        پایان
        اگر نشان برابر 1:
            پس‌زمینه = #dcfce7
            کادر = 1، توپر، #16a34a
        پایان
        اگر نشان برابر 2:
            پس‌زمینه = #fee2e2
            کادر = 1، توپر، #dc2626
        پایان
        کلیک = انتخاب
        محتوا = برچسب
    پایان
پایان

بخش پرسشنامه:
    پرسیده := 0
    امتیاز := 0
    برگزیده := -1
    جعبه:
        قلم = سیستمی، ساده
        فضا = 24
        بیشینه عرض = 448
        اگر پرسیده کوچکتر 3:
            سرتیتر:
                شناسه = "ask"
                اندازه = 3
                محتوا = قسمت(پرسیده، 0)
            پایان
            گزینه:
                برچسب = قسمت(پرسیده، 1)
                نشان = نشان(پرسیده، برگزیده، 0)
                انتخاب = ():
                    اگر برگزیده کوچکتر 0:
                        برگزیده = 0
                        اگر شماره پاسخ(پرسیده) برابر 0:
                            امتیاز++
                        پایان
                    پایان
                پایان
            پایان
            گزینه:
                برچسب = قسمت(پرسیده، 2)
                نشان = نشان(پرسیده، برگزیده، 1)
                انتخاب = ():
                    اگر برگزیده کوچکتر 0:
                        برگزیده = 1
                        اگر شماره پاسخ(پرسیده) برابر 1:
                            امتیاز++
                        پایان
                    پایان
                پایان
            پایان
            گزینه:
                برچسب = قسمت(پرسیده، 3)
                نشان = نشان(پرسیده، برگزیده، 2)
                انتخاب = ():
                    اگر برگزیده کوچکتر 0:
                        برگزیده = 2
                        اگر شماره پاسخ(پرسیده) برابر 2:
                            امتیاز++
                        پایان
                    پایان
                پایان
            پایان
            پاراگراف:
                شناسه = "verdict"
                رنگ = #475569
                محتوا = (برگزیده کوچکتر 0) ? "یک پاسخ انتخاب کنید." : ((برگزیده برابر شماره پاسخ(
                    پرسیده
                )) ? "درست است." : "این بار نه.")
            پایان
        وگرنه:
            سرتیتر:
                اندازه = 3
                محتوا = "امتیاز شما " + امتیاز + " از ۳ بود."
            پایان
        پایان
        دکمه:
            شناسه = "next"
            فاصله = 8، 18
            کادر = 0
            پس‌زمینه = #4f46e5
            رنگ = سفید
            گردی = 8
            نشانگر = اشاره
            کلیک = ():
                اگر پرسیده برابر 3:
                    پرسیده = 0
                    امتیاز = 0
                    برگزیده = -1
                وگرنه برگزیده بزرگتربرابر 0:
                    پرسیده++
                    برگزیده = -1
                پایان
            پایان
            محتوا = (پرسیده برابر 3) ? "دوباره بازی کن" : "بعدی"
        پایان
    پایان
پایان

صفحه:
    عنوان = "پرسشنامه"
    پرسشنامه: پایان
