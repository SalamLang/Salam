واردسازی دام

تابع رزرو(رویداد: صحیح۶۴):
    دام.تعویض کلاس(دام.هدف رویداد(رویداد)، "taken")
    گرفته := دام.تعداد(دام.پرسمان همه(".seat.taken"))
    دام.تنظیم متن(دام.با شناسه("summary")، "" + گرفته + " صندلی از 8 صندلی انتخاب شده است")
پایان

صفحه:
    عنوان = "صندلی‌ها"
    ظاهر سفارشی: محتوا = ".seat { width: 44px; height: 44px; border: 2px solid #94a3b8; border-radius: 8px 8px 14px 14px; background: white; cursor: pointer } .seat:hover { border-color: #4f46e5 } .seat.taken { background: #4f46e5; border-color: #4f46e5 }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه: نمایش = شبکه ستون های شبکه = "repeat(4, 44px)" شکاف = 10 چینش = آغاز
        دکمه: تکرار = 8 کلاس = "seat" کلیک = رزرو برچسب دسترسی‌پذیری = "صندلی" پایان
    پایان
    پاراگراف: شناسه = "summary" محتوا = "0 صندلی از 8 صندلی انتخاب شده است" رنگ = "#475569" پایان
پایان
