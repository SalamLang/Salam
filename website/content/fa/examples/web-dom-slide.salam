واردسازی دام

ناپایا آغاز := 0.0

تابع بلغز(زمان: اعشار۶۴):
    ناپایا چپ := (زمان - آغاز) / 4.0
    اگر چپ کوچکتر 240.0:
        دام.درخواست فریم((بعدی: اعشار۶۴): بلغز(بعدی) پایان)
    وگرنه:
        چپ = 240.0
    پایان
    دام.تنظیم سبک(دام.با شناسه("ball")، "left"، "" + چپ + "px")
پایان

تابع پرتاب:
    آغاز = دام.اکنون()
    دام.درخواست فریم((زمان: اعشار۶۴): بلغز(زمان) پایان)
پایان

صفحه:
    عنوان = "لغزش"
    قلم = "Tahoma"، "سیستمی"، "ساده"
    فضا = 1.5rem
    جعبه:
        عرض = 280
        ارتفاع = 44
        پس‌زمینه = "#e0e7ff"
        گردی = 22
        جهت = "ltr"
        جعبه:
            شناسه = "ball"
            موقعیت = "مطلق"
            بالا = 4
            چپ = 0
            عرض = 36
            ارتفاع = 36
            پس‌زمینه = "#4f46e5"
            گردی = 50%
        پایان
    پایان
    دکمه:
        شناسه = "go"
        کلیک = پرتاب
        محتوا = "بلغزان"
        فضا = 14px، 0، 0، 0
        فاصله = 8px، 18px
        کادر = 0
        پس‌زمینه = "#4f46e5"
        رنگ = "سفید"
        گردی = 8
        نشانگر = "اشاره"
        قلم = "inherit"
    پایان
پایان
