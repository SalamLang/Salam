واردسازی دام

ناپایا دهم := 0
ناپایا ضربان := 0 برگردان صحیح۶۴
ناپایا روشن := نادرست

تابع ترسیم:
    دام.تنظیم متن(دام.با شناسه("time")، "" + دهم / 600 + ":" + دهم / 10 % 60 / 10 + دهم / 10 % 60 % 10 + "." + دهم % 10)
پایان

تابع تیک:
    دهم += 1
    ترسیم()
پایان

تابع آغازوپایان:
    اگر روشن:
        دام.پاک کردن بازه(ضربان)
        روشن = نادرست
        دام.تنظیم متن(دام.با شناسه("go")، "شروع")
    وگرنه:
        ضربان = دام.تنظیم بازه((): تیک() پایان، 100)
        روشن = درست
        دام.تنظیم متن(دام.با شناسه("go")، "توقف")
    پایان
پایان

تابع صفرکن:
    دهم = 0
    ترسیم()
پایان

صفحه:
    عنوان = "کرنومتر"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    سراسری: گزینشگر = "button" فاصله = "8px 20px" اندازه قلم = "1.05rem" کادر = "1px solid #cbd5e1" گردی کادر = 8 پس زمینه = "#f8fafc" نشانگر = اشاره‌گر پایان
    جعبه:
        بیشینه عرض = "16rem" فضا = "0 auto" فاصله = 20 ترازمتن = وسط کادر = "1px solid #e2e8f0" گردی کادر = 14
        پاراگراف: شناسه = "time" محتوا = "0:00.0" اندازه قلم = "3rem" خانواده قلم = "ui-monospace, monospace" فضا = "0 0 12px 0" جهت = "ltr" پایان
        دکمه: شناسه = "go" کلیک = آغازوپایان محتوا = "شروع" پایان
        دکمه: شناسه = "clear" کلیک = صفرکن محتوا = "از نو" فضا = "0 8px 0 0" پایان
    پایان
پایان
