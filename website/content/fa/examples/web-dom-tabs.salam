واردسازی دام

تابع برگزین(شماره: صحیح):
    زبانه‌ها := دام.پرسمان همه(".tab")
    برگه‌ها := دام.پرسمان همه(".sheet")
    تکرار دام.تعداد(زبانه‌ها) در ردیف:
        زبانه := دام.عنصر شماره(زبانه‌ها، ردیف)
        برگه := دام.عنصر شماره(برگه‌ها، ردیف)
        اگر ردیف == شماره:
            دام.افزودن کلاس(زبانه، "on")
            دام.افزودن کلاس(برگه، "on")
            دام.تنظیم ویژگی(زبانه، "aria-selected"، "true")
        وگرنه:
            دام.حذف کلاس(زبانه، "on")
            دام.حذف کلاس(برگه، "on")
            دام.تنظیم ویژگی(زبانه، "aria-selected"، "false")
        پایان
    پایان
پایان

صفحه:
    عنوان = "نان تخت"
    ظاهر سفارشی: محتوا = ".tab { padding: 10px 18px; border: 0; border-bottom: 3px solid transparent; background: none; font-size: 1rem; font-family: inherit; cursor: pointer } .tab:hover { background: #f1f5f9 } .tab.on { border-bottom-color: #4f46e5; font-weight: bold } .sheet { display: none; padding: 14px 4px } .sheet.on { display: block }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "32rem" پایان
    جعبه: نقش = tablist کادر پایین = "1px solid #e2e8f0"
        دکمه: کلاس = "tab on" aria selected = "true" کلیک = (): برگزین(0) پایان محتوا = "نمای کلی" پایان
        دکمه: کلاس = "tab" aria selected = "false" کلیک = (): برگزین(1) پایان محتوا = "دستور" پایان
        دکمه: کلاس = "tab" aria selected = "false" کلیک = (): برگزین(2) پایان محتوا = "نظرها" پایان
    پایان
    جعبه: کلاس = "sheet on" محتوا = "نانی نازک که روی سنگ داغ، در حدود چهار دقیقه پخته می‌شود." پایان
    جعبه: کلاس = "sheet" محتوا = "آرد، آب، نمک و یک قاشق خمیرمایه. خمیر را یک ساعت استراحت بدهید." پایان
    جعبه: کلاس = "sheet" محتوا = "میانگین چهار و نیم ستاره از ۲۱۲ خواننده." پایان
پایان
