واردسازی دام

ناپایا شبانه := نادرست

تابع بچرخان:
    دام.تعویض کلاس(دام.بدنه()، "night")
    شبانه = وارونه شبانه
    اگر شبانه:
        دام.تنظیم متن(دام.با شناسه("flip")، "رفتن به حالت روز")
    وگرنه:
        دام.تنظیم متن(دام.با شناسه("flip")، "رفتن به حالت شب")
    پایان
پایان

صفحه:
    عنوان = "حالت شب"
    ظاهر سفارشی: محتوا = "body { background: #f8fafc; color: #0f172a; transition: background 0.3s, color 0.3s } body.night { background: #0f172a; color: #e2e8f0 } body.night .card { background: #1e293b; border-color: #334155 }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 0 فاصله = "1.5rem" کمینه ارتفاع = "12rem" پایان
    جعبه:
        کلاس = "card"
        بیشینه عرض = "26rem" فاصله = 20 پس زمینه = سفید کادر = "1px solid #e2e8f0" گردی کادر = 14
        سرتیتر: اندازه = 2 محتوا = "عصر بخیر" فضا = "0 0 8px 0" پایان
        پاراگراف: محتوا = "یک کلاس روی بدنه‌ی صفحه همه‌ی رنگ‌ها را عوض می‌کند." پایان
        دکمه: شناسه = "flip" کلیک = بچرخان محتوا = "رفتن به حالت شب" فاصله = "8px 16px" گردی کادر = 8 کادر = "1px solid #6366f1" پس زمینه = "#6366f1" رنگ = سفید نشانگر = اشاره‌گر پایان
    پایان
پایان
