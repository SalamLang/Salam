واردسازی دام

تابع شمار(موارد: وکتور<رشته>): صحیح:
    برگشت موارد.طول()
پایان

تابع بدون(فهرست: وکتور<رشته>، کدام: رشته): وکتور<رشته>:
    ناپایا نتیجه := وکتور {} برگردان وکتور<رشته>
    ناپایا دیده := نادرست
    تکرار فهرست.طول() در ک:
        خط := فهرست.بگیر(ک)
        اگر وارونه دیده و خط برابر کدام:
            دیده = درست
        وگرنه:
            نتیجه.افزودن(خط)
        پایان
    پایان
    برگشت نتیجه
پایان

بخش وظیفه(برچسب: رشته):
    نگه‌داشته := برچسب
    جعبه:
        چیدمان = ردیف
        چینش = میان
        تراز = وسط
        فاصله = 8، 12
        فضا = 6، 0
        پس‌زمینه = #f1f5f9
        گردی = 8
        پاراگراف:
            فضا = 0
            محتوا = برچسب
        پایان
        دکمه:
            کادر = 0
            پس‌زمینه = #e0e7ff
            گردی = 6
            فاصله = 4، 10
            نشانگر = اشاره
            کلیک = (): برانگیز("انجام"، نگه‌داشته) پایان
            محتوا = "انجام شد"
        پایان
    پایان
پایان

بخش کارنامه:
    موارد := وکتور {} برگردان وکتور<رشته>
    پیش‌نویس := ""
    جعبه:
        قلم = سیستمی، ساده
        فضا = 24
        بیشینه عرض = 416
        فرم:
            شناسه = "new"
            چیدمان = ردیف
            شکاف = 8
            ارسال = (e: صحیح۶۴):
                دام.جلوگیری پیش فرض(e)
                اگر پیش‌نویس.طول() بزرگتر 0:
                    موارد.افزودن("" + پیش‌نویس)
                    پیش‌نویس = ""
                پایان
            پایان
            ورودی:
                شناسه = "name"
                رشد = 1
                فاصله = 8
                اندازه قلم = 16
                مقدار = پیش‌نویس
                جانگهدار = "چه باید کرد؟"
                ورودی = (v: رشته): پیش‌نویس = v پایان
            پایان
            دکمه:
                شناسه = "add"
                نوع = ارسال
                فاصله = 8، 16
                کادر = 0
                پس‌زمینه = #4f46e5
                رنگ = سفید
                گردی = 8
                نشانگر = اشاره
                محتوا = "افزودن"
            پایان
        پایان
        فهرست:
            فاصله = 0
            هر کار در موارد:
                مورد:
                    کلید = کار
                    وظیفه:
                        برچسب = کار
                        هنگام انجام = (کدام: رشته): موارد = بدون(موارد، کدام) پایان
                    پایان
                پایان
            پایان
        پایان
        پاراگراف:
            شناسه = "left"
            رنگ = #475569
            محتوا = شمار(موارد) + " کار مانده"
        پایان
    پایان
پایان

صفحه:
    عنوان = "کارها"
