واردسازی دام

تابع بشمار:
    مانده := دام.تعداد(دام.پرسمان همه("#tasks li"))
    دام.تنظیم متن(دام.با شناسه("left")، "" + مانده + " کار مانده")
پایان

تابع ثبت(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
    خانه := دام.با شناسه("name")
    نوشته := دام.دریافت مقدار(خانه)
    اگر نوشته.طول() > 0:
        سطر := دام.بساز("li")
        عبارت := دام.بساز("span")
        دام.تنظیم متن(عبارت، نوشته)
        انجام := دام.بساز("button")
        دام.تنظیم متن(انجام، "انجام شد")
        دام.هنگام رویداد(انجام، "click"، (): دام.برداشتن(سطر) بشمار() پایان)
        دام.افزودن(سطر، عبارت)
        دام.افزودن(سطر، انجام)
        دام.افزودن(دام.با شناسه("tasks")، سطر)
        دام.تنظیم مقدار(خانه، "")
        بشمار()
    پایان
پایان

صفحه:
    عنوان = "کارهای من"
    ظاهر سفارشی: محتوا = "#tasks li { display: flex; justify-content: space-between; align-items: center; padding: 8px 12px; margin: 6px 0; background: #f1f5f9; border-radius: 8px } #tasks button { border: 0; background: #e0e7ff; border-radius: 6px; padding: 4px 10px; cursor: pointer }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "26rem" پایان
    فرم:
        شناسه = "new" ارسال = ثبت نمایش = فلکس شکاف = 8
        ورودی: شناسه = "name" جانگهدار = "چه کاری باید انجام شود؟" فلکس = 1 فاصله = 8 اندازه قلم = "1rem" پایان
        دکمه: شناسه = "add" نوع = ارسال محتوا = "افزودن" فاصله = "8px 16px" کادر = "0" پس زمینه = "#4f46e5" رنگ = سفید گردی کادر = 8 نشانگر = اشاره‌گر پایان
    پایان
    فهرست: شناسه = "tasks" سبک فهرست = هیچ فاصله = 0 پایان
    پاراگراف: شناسه = "left" محتوا = "0 کار مانده" رنگ = "#475569" پایان
پایان
