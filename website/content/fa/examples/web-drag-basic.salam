واردسازی دام

تابع بردار(رویداد: صحیح۶۴):
    انتقال := دام.دریافت خاصیت(رویداد، "dataTransfer")
    _ := دام.فراخوان رشته دو(انتقال، "setData"، "text/plain"، "parcel")
پایان

تابع اجازه(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
پایان

تابع فرود(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
    انتقال := دام.دریافت خاصیت(رویداد، "dataTransfer")
    کد کالا := دام.فراخوان رشته یک(انتقال، "getData"، "text/plain")
    دام.افزودن(دام.با شناسه("zone")، دام.با شناسه("" + کد کالا))
    دام.تنظیم متن(دام.با شناسه("status")، "بسته رها شد.")
پایان

صفحه:
    عنوان = "کشیدن و رها کردن"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    جعبه: شناسه = "parcel" کشیدنی = درست شروع کشیدن = بردار
        محتوا = "بسته" نمایش = "inline-block" فاصله = "10px 20px" نشانگر = گرفتن
        پس زمینه = "#fde68a" گردی کادر = 6
    پایان
    جعبه: شناسه = "zone" عبور کشیدن = اجازه رها کردن = فرود
        فضا بالا = 20 فاصله = 30 کمینه ارتفاع = 40 کادر = "2px dashed #94a3b8" گردی کادر = 8
        محتوا = "ناحیه‌ی رها کردن"
    پایان
    پاراگراف: شناسه = "status" محتوا = "بسته را روی ناحیه بکشید." پایان
پایان
