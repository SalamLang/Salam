واردسازی دام

بخش کارت(کد، برچسب):
    جعبه: شناسه = کد کشیدنی = درست شروع کشیدن = بردار محتوا = برچسب
        فاصله = "8px 12px" فضا پایین = 8 پس زمینه = "white" گردی کادر = 6 نشانگر = گرفتن
    پایان
پایان

بخش ستون(کد، برچسب):
    جعبه: شناسه = کد عبور کشیدن = اجازه خروج کشیدن = ترک رها کردن = فرود
        پس زمینه = "#e2e8f0" گردی کادر = 8 فاصله = 12 کمینه ارتفاع = 140 عرض = 150
        سرتیتر: اندازه = 3 محتوا = برچسب فضا = "0 0 10px" پایان
        محتوا: پایان
    پایان
پایان

تابع بردار(رویداد: صحیح۶۴):
    انتقال := دام.دریافت خاصیت(رویداد، "dataTransfer")
    _ := دام.فراخوان رشته دو(انتقال، "setData"، "text/plain"، دام.دریافت خاصیت رشته ای(دام.هدف رویداد(رویداد)، "id"))
پایان

تابع اجازه(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
    دام.افزودن کلاس(دام.دریافت خاصیت(رویداد، "currentTarget")، "hot")
پایان

تابع ترک(رویداد: صحیح۶۴):
    دام.حذف کلاس(دام.دریافت خاصیت(رویداد، "currentTarget")، "hot")
پایان

تابع فرود(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
    ستون کار := دام.دریافت خاصیت(رویداد، "currentTarget")
    دام.حذف کلاس(ستون کار، "hot")
    کد کارت := دام.فراخوان رشته یک(دام.دریافت خاصیت(رویداد، "dataTransfer")، "getData"، "text/plain")
    دام.افزودن(ستون کار، دام.با شناسه("" + کد کارت))
پایان

