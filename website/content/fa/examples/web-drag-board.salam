واردسازی دام

تابع بردار(e: صحیح۶۴):
    انتقال := دام.دریافت خاصیت(e، "dataTransfer")
    _ := دام.فراخوان رشته دو(
        انتقال، "setData"، "text/plain"، دام.دریافت خاصیت رشته ای(دام.هدف رویداد(e)، "id")
    )
پایان

تابع بپذیر(e: صحیح۶۴):
    دام.جلوگیری پیش فرض(e)
پایان

تابع بگذار(e: صحیح۶۴):
    شناسه‌ی کار := دام.فراخوان رشته یک(دام.دریافت خاصیت(e، "dataTransfer")، "getData"، "text/plain")
    دام.افزودن(دام.دریافت خاصیت(e، "currentTarget")، دام.با شناسه("" + شناسه‌ی کار))
پایان

بخش کار(کد، برچسب):
    جعبه:
        شناسه = کد
        کشیدنی = "بله"
        شروع کشیدن = بردار
        فاصله = 8، 12
        فضا پایین = 8
        پس‌زمینه = "سفید"
        گردی = 6
        نشانگر = "گرفتن"
        محتوا = برچسب
    پایان
پایان

بخش ستون(کد، برچسب):
    داغ := نادرست
    جعبه:
        شناسه = کد
        پس‌زمینه = "#e2e8f0"
        گردی = 8
        فاصله = 12
        کمینه ارتفاع = 140
        عرض = 150
        دورخط = 2، توپر، شفاف
        اگر داغ:
            دورخط = 2، توپر، #2563eb
        پایان
        عبور کشیدن = (e: صحیح۶۴):
            بپذیر(e)
            داغ = درست
        پایان
        خروج کشیدن = (): داغ = نادرست پایان
        رها کردن = (e: صحیح۶۴):
            بپذیر(e)
            داغ = نادرست
            بگذار(e)
        پایان
        سرتیتر:
            اندازه = 3
            محتوا = برچسب
            فضا = 0، 0، 10
        پایان
        محتوا: پایان
    پایان
پایان

