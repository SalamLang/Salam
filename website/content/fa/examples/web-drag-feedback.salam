واردسازی دام

ناپایا شمار := ۰

تابع آغاز(رویداد: صحیح۶۴):
    انتقال := دام.دریافت خاصیت(رویداد، "dataTransfer")
    _ := دام.فراخوان رشته دو(انتقال، "setData"، "text/plain"، "note")
    شمار = ۰
    دام.تنظیم متن(دام.با شناسه("log")، "شروع کشیدن")
پایان

تابع کشش():
    شمار += ۱
    دام.تنظیم متن(دام.با شناسه("log")، "رویداد کشیدن " + شمار + " بار رخ داد")
پایان

تابع اجازه(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
پایان

تابع ترک():
    دام.حذف کلاس(دام.با شناسه("zone")، "hot")
پایان

تابع فرود(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
    ترک()
پایان

تابع خاتمه(رویداد: صحیح۶۴):
    اثر := دام.دریافت خاصیت رشته ای(دام.دریافت خاصیت(رویداد، "dataTransfer")، "dropEffect")
    دام.تنظیم متن(دام.با شناسه("log")، "پایان کشیدن، dropEffect = " + اثر)
پایان

صفحه:
    ظاهر سفارشی: محتوا = ".hot { background: #dcfce7; border-color: #16a34a }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    جعبه: شناسه = "note" کشیدنی = درست
        شروع کشیدن = آغاز
        کشیدن = کشش
        اتمام کشیدن = خاتمه
        محتوا = "برگه‌ی یادداشت" نمایش = "inline-block" فاصله = "10px 20px" پس زمینه = "#fde68a"
    پایان
    جعبه: شناسه = "zone" عبور کشیدن = اجازه
        ورود کشیدن = (): دام.افزودن کلاس(دام.با شناسه("zone")، "hot") پایان
        خروج کشیدن = ترک رها کردن = فرود
        محتوا = "اینجا رها کنید" فضا بالا = 20 فاصله = 30 کادر = "2px dashed #94a3b8" گردی کادر = 8
    پایان
    پاراگراف: شناسه = "log" محتوا = "هنوز چیزی رخ نداده." پایان
پایان
