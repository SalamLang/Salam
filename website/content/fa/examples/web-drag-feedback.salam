واردسازی دام

بخش بازخورد:
    شمار := ۰
    داغ := نادرست
    وضع := "هنوز چیزی نیست."
    جعبه:
        قلم = سیستمی، ساده
        فضا = 24
        جعبه:
            شناسه = "note"
            کشیدنی = "بله"
            فاصله = 10، 20
            پس‌زمینه = "#fde68a"
            شروع کشیدن = (e: صحیح۶۴):
                انتقال := دام.دریافت خاصیت(e، "dataTransfer")
                _ := دام.فراخوان رشته دو(انتقال، "setData"، "text/plain"، "note")
                شمار = ۰
                وضع = "شروع کشیدن"
            پایان
            کشیدن = (): شمار++ وضع = "رویداد کشیدن " + شمار + " بار رخ داد" پایان
            اتمام کشیدن = (e: صحیح۶۴):
                وضع = "پایان کشیدن، dropEffect = " + دام.دریافت خاصیت رشته ای(
                    دام.دریافت خاصیت(e، "dataTransfer")، "dropEffect"
                )
            پایان
            محتوا = "یادداشت چسبان"
        پایان
        جعبه:
            شناسه = "zone"
            فضا بالا = 20
            فاصله = 30
            کادر = 2، خط چین، #94a3b8
            گردی = 8
            اگر داغ:
                پس‌زمینه = #dcfce7
                کادر = 2، خط چین، #16a34a
            پایان
            عبور کشیدن = (e: صحیح۶۴): دام.جلوگیری پیش فرض(e) پایان
            ورود کشیدن = (): داغ = درست پایان
            خروج کشیدن = (): داغ = نادرست پایان
            رها کردن = (e: صحیح۶۴):
                دام.جلوگیری پیش فرض(e)
                داغ = نادرست
            پایان
            محتوا = "اینجا رها کنید"
        پایان
        پاراگراف:
            شناسه = "log"
            محتوا = وضع
        پایان
    پایان
پایان

صفحه:
    عنوان = "بازخورد کشیدن"
    بازخورد: پایان
پایان
