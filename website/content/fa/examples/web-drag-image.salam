واردسازی دام

پایا یدک := "data:image/gif;base64,R0lGODlhAQABAIAAAMvV4QAAACwAAAAAAQABAAACAkQBADs="

ناپایا خط ها := ""

تابع بگو(متن: رشته):
    خط ها = خط ها + متن + "\n"
    دام.تنظیم متن(دام.با شناسه("log")، خط ها)
پایان

تابع خراب():
    تصویر دوم := دام.با شناسه("second")
    اگر دام.دریافت ویژگی(تصویر دوم، "src") نابرابر یدک:
        بگو("خطا: تصویر دوم خراب است، جایگزین گذاشته شد")
        دام.تنظیم ویژگی(تصویر دوم، "src"، یدک)
    پایان
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    جعبه: نمایش = فلکس شکاف = 16
        تصویر: شناسه = "first" جایگزین = "یک مربع آبی" عرض = 80 ارتفاع = 80 بار شد = (): بگو("بار شد: تصویر اول رسید") پایان
