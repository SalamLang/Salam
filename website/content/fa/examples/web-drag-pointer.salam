واردسازی دام

ناپایا کشیده می‌شود := نادرست
ناپایا شروع افقی := ۰.۰
ناپایا شروع عمودی := ۰.۰
ناپایا پایه افقی := ۰.۰
ناپایا پایه عمودی := ۰.۰

تابع بگیر(رویداد: صحیح۶۴):
    توپ := دام.هدف رویداد(رویداد)
    _ := دام.فراخوان یک(توپ، "setPointerCapture"، دام.دریافت خاصیت عددی(رویداد، "pointerId"))
    کشیده می‌شود = درست
    شروع افقی = دام.رویداد افقی(رویداد)
    شروع عمودی = دام.رویداد عمودی(رویداد)
    پایه افقی = دام.دریافت خاصیت عددی(توپ، "offsetLeft")
    پایه عمودی = دام.دریافت خاصیت عددی(توپ، "offsetTop")
    دام.تنظیم متن(دام.با شناسه("info")، "اشاره‌گر پایین رفت (" + دام.دریافت خاصیت رشته ای(رویداد، "pointerType") + ")")
پایان

تابع جابجا(رویداد: صحیح۶۴):
    اگر کشیده می‌شود:
        توپ := دام.هدف رویداد(رویداد)
        دام.تنظیم سبک(توپ، "left"، (پایه افقی + دام.رویداد افقی(رویداد) - شروع افقی) + "px")
        دام.تنظیم سبک(توپ، "top"، (پایه عمودی + دام.رویداد عمودی(رویداد) - شروع عمودی) + "px")
    پایان
پایان

تابع رها():
    کشیده می‌شود = نادرست
    دام.تنظیم متن(دام.با شناسه("info")، "اشاره‌گر بالا آمد")
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    جعبه: موقعیت = نسبی عرض = 320 ارتفاع = 180 پس زمینه = "#e0f2fe" گردی کادر = 10
        جعبه: شناسه = "ball" موقعیت = مطلق چپ = 20 بالا = 20 عرض = 60 ارتفاع = 60 پس زمینه = "#0284c7"
            گردی کادر = "50%" نشانگر = گرفتن کنش لمسی = هیچ
            فشردن اشاره‌گر = بگیر حرکت اشاره‌گر = جابجا رها کردن اشاره‌گر = رها
            شروع ضبط اشاره‌گر = (): دام.تنظیم متن(دام.با شناسه("cap")، "گرفته شد") پایان
            اتمام ضبط اشاره‌گر = (): دام.تنظیم متن(دام.با شناسه("cap")، "آزاد شد") پایان
        پایان
    پایان
    پاراگراف: شناسه = "info" محتوا = "توپ را بکشید." پایان
    پاراگراف: شناسه = "cap" محتوا = "-" پایان
پایان
