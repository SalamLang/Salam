واردسازی دام

تابع به‌روزرسانی():
    ناحیه := دام.با شناسه("text")
    فاصله باقی := دام.دریافت خاصیت عددی(ناحیه، "scrollHeight") - دام.دریافت خاصیت عددی(ناحیه، "clientHeight")
    درصد := دام.دریافت خاصیت عددی(ناحیه، "scrollTop") * ۱۰۰.۰ / فاصله باقی
    دام.تنظیم سبک(دام.با شناسه("bar")، "width"، درصد + "%")
پایان

تابع ایستادن():
    جا := دام.دریافت خاصیت عددی(دام.با شناسه("text")، "scrollTop")
    دام.تنظیم متن(دام.با شناسه("note")، "پیمایش در " + جا + " پیکسل ایستاد.")
پایان

تابع بازگشت():
    دام.تنظیم خاصیت عددی(دام.با شناسه("text")، "scrollTop"، ۰.۰)
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 بیشینه عرض = 420 پایان
    جعبه: ارتفاع = 6 پس زمینه = "#e2e8f0" گردی کادر = 3
        جعبه: شناسه = "bar" ارتفاع = 6 عرض = "0%" پس زمینه = "#2563eb" گردی کادر = 3 پایان
    پایان
    جعبه: شناسه = "text" ارتفاع = 150 سرریز عمودی = خودکار فاصله = "0 12px" کادر = "1px solid #cbd5e1"
        رفتار پیمایش = نرم پیمایش = به‌روزرسانی اتمام پیمایش = ایستادن
        پاراگراف: تکرار = 12 محتوا = "با هر پیمایش مقدار scrollTop عوض می‌شود و رویداد پیمایش رخ می‌دهد." پایان
    پایان
    دکمه: کلیک = بازگشت محتوا = "برگرد به بالا" فضا بالا = 10 پایان
    پاراگراف: شناسه = "note" محتوا = "متن بالا را پیمایش کنید." پایان
