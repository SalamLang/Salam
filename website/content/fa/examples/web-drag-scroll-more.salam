واردسازی دام

ناپایا کل := ۶ برگردان صحیح۶۴

تابع بیشتر():
    فهرست := دام.با شناسه("feed")
    مانده := دام.دریافت خاصیت عددی(فهرست، "scrollHeight") - دام.دریافت خاصیت عددی(فهرست، "scrollTop") - دام.دریافت خاصیت عددی(فهرست، "clientHeight")
    اگر مانده کوچکتر ۳۰.۰:
        تکرار ۵ در ش:
            مورد := دام.بساز("p")
            دام.تنظیم متن(مورد، "مورد بارگذاری‌شده " + (کل + ش + ۱))
            دام.افزودن(فهرست، مورد)
        پایان
        کل += ۵
        دام.تنظیم متن(دام.با شناسه("count")، "تا اینجا " + کل + " مورد")
    پایان
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 بیشینه عرض = 360 پایان
    جعبه: شناسه = "feed" ارتفاع = 130 سرریز عمودی = خودکار فاصله = "0 12px" پس زمینه = "#f8fafc" کادر = "1px solid #cbd5e1" پیمایش = بیشتر
        پاراگراف: تکرار = ۶ محتوا = "یک مورد نخست" پایان
    پایان
    پاراگراف: شناسه = "count" محتوا = "تا اینجا 6 مورد" پایان
پایان
