واردسازی دام

ناپایا برداشته := ۰ برگردان صحیح۶۴

بخش ردیف(کد، برچسب):
    جعبه: شناسه = کد کشیدنی = درست شروع کشیدن = بردار عبور کشیدن = اجازه رها کردن = فرود
        محتوا = برچسب فاصله = "10px 14px" فضا پایین = 6 پس زمینه = "#f1f5f9" گردی کادر = 6 نشانگر = گرفتن
    پایان
پایان

تابع بردار(رویداد: صحیح۶۴):
    برداشته = دام.هدف رویداد(رویداد)
    _ := دام.فراخوان رشته دو(دام.دریافت خاصیت(رویداد، "dataTransfer")، "setData"، "text/plain"، "row")
پایان

تابع اجازه(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
پایان

تابع فرود(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
    هدف := دام.دریافت خاصیت(رویداد، "currentTarget")
    مستطیل := دام.فراخوان(هدف، "getBoundingClientRect")
    وسط := دام.دریافت خاصیت عددی(مستطیل، "top") + دام.دریافت خاصیت عددی(مستطیل، "height") / ۲.۰
    بالاتر := دام.رویداد عمودی(رویداد) کوچکتر وسط
    فهرست := دام.با شناسه("list")
    ردیف ها := دام.پرسمان همه("#list > div")
    تکرار دام.تعداد(ردیف ها) در ش:
        ردیف := دام.عنصر شماره(ردیف ها، ش)
        اگر ردیف برابر هدف:
            اگر بالاتر: دام.افزودن(فهرست، برداشته) پایان
            دام.افزودن(فهرست، ردیف)
            اگر وارونه بالاتر: دام.افزودن(فهرست، برداشته) پایان
        وگرنه ردیف نابرابر برداشته:
            دام.افزودن(فهرست، ردیف)
        پایان
    پایان
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 بیشینه عرض = 320 پایان
    جعبه: شناسه = "list"
        ردیف: کد = "a" برچسب = "بیدار شدن" پایان
        ردیف: کد = "b" برچسب = "دم کردن چای" پایان
        ردیف: کد = "c" برچسب = "خواندن درس" پایان
        ردیف: کد = "d" برچسب = "نوشتن یک صفحه" پایان
    پایان
    پاراگراف: شناسه = "hint" محتوا = "یک ردیف را به جای تازه بکشید." پایان
پایان
