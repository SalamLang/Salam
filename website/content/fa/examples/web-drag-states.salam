واردسازی دام

ناپایا مسیر := ""

تابع ثبت(چه: رشته):
    اگر مسیر.طول() بزرگتر ۱۱۰: مسیر = "" پایان
    مسیر = مسیر + چه + "  "
    دام.تنظیم متن(دام.با شناسه("trail")، مسیر)
پایان

تابع دیده(رویداد: صحیح۶۴):
    ثبت("over:" + دام.دریافت خاصیت رشته ای(دام.هدف رویداد(رویداد)، "id"))
پایان

تابع رفته(رویداد: صحیح۶۴):
    ثبت("out:" + دام.دریافت خاصیت رشته ای(دام.هدف رویداد(رویداد)، "id"))
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    جعبه: شناسه = "outer" عرض = 280 فاصله = 24 پس زمینه = "#ede9fe" گردی کادر = 10
        محتوا = "بیرونی"
        ورود اشاره‌گر = (): ثبت("enter") پایان خروج اشاره‌گر = (): ثبت("leave") پایان
        عبور اشاره‌گر = دیده بیرون رفتن اشاره‌گر = رفته
        لغو اشاره‌گر = (): ثبت("cancel") پایان
        جعبه: شناسه = "inner" فضا بالا = 12 فاصله = 20 پس زمینه = "#c4b5fd" گردی کادر = 8 محتوا = "درونی" پایان
    پایان
    پاراگراف: شناسه = "trail" فضای سفید = "pre-wrap" محتوا = "ماوس، قلم یا انگشت را روی جعبه‌ها حرکت دهید." پایان
