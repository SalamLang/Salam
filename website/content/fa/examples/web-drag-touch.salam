واردسازی دام

تابع بگذار(رویداد: صحیح۶۴):
    مستطیل := دام.فراخوان(دام.با شناسه("pad")، "getBoundingClientRect")
    نشانه := دام.با شناسه("mark")
    دام.تنظیم سبک(
        نشانه، "left"، (دام.لمس افقی(رویداد) - دام.دریافت خاصیت عددی(مستطیل، "left") - ۲۰.۰) + "px"
    )
    دام.تنظیم سبک(
        نشانه، "top"، (دام.لمس عمودی(رویداد) - دام.دریافت خاصیت عددی(مستطیل، "top") - ۲۰.۰) + "px"
    )
    دام.تنظیم سبک(نشانه، "display"، "block")
    انگشت ها := دام.دریافت خاصیت عددی(دام.دریافت خاصیت(رویداد، "touches")، "length")
    دام.تنظیم متن(دام.با شناسه("info")، "انگشت‌های روی صفحه: " + انگشت ها)
پایان

تابع بردار(چه: رشته):
    دام.تنظیم سبک(دام.با شناسه("mark")، "display"، "none")
    دام.تنظیم متن(دام.با شناسه("info")، چه)
پایان

صفحه:
    قلم = "Tahoma"، "سیستمی"، "ساده"
    فضا = 24
    جعبه:
        شناسه = "pad"
        عرض = 320
        ارتفاع = 180
        پس‌زمینه = "#fef3c7"
        گردی = 10
        کنش لمسی = "هیچ"
        انتخاب‌پذیر = نادرست
        شروع لمس = بگذار
        حرکت لمس = بگذار
        اتمام لمس = (): بردار("پایان لمس") پایان
        لغو لمس = (): بردار("لمس لغو شد") پایان
        محتوا = "اینجا را با انگشت لمس کنید"
        جعبه:
            شناسه = "mark"
            موقعیت = "مطلق"
            نمایان = نادرست
            عرض = 40
            ارتفاع = 40
            گردی = 50%
            پس‌زمینه = "#f59e0b"
        پایان
    پایان
    پاراگراف:
        شناسه = "info"
        محتوا = "منتظر لمس."
    پایان
پایان
