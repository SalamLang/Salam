واردسازی دام

تابع اندازه():
    متن := "پنجره: " + دام.عرض پنجره() + " در " + دام.ارتفاع پنجره() + " پیکسل"
    دام.تنظیم متن(دام.با شناسه("size")، متن)
پایان

تابع جایگاه():
    فاصله := دام.ارتفاع سند() - دام.ارتفاع پنجره()
    دام.تنظیم سبک(دام.با شناسه("bar")، "width"، دام.پیمایش عمودی() * ۱۰۰.۰ / فاصله + "%")
پایان

تابع راه‌اندازی():
    دام.هنگام تغییر اندازه((): اندازه() پایان)
    دام.رویداد پنجره("scroll"، (): جایگاه() پایان)
    اندازه()
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 0 پایان
