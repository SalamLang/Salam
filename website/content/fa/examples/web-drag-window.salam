        جعبه: شناسه = "bar" ارتفاع = 6 عرض = "0%" پس زمینه = "#16a34a" پایان
    پایان
    جعبه: فاصله = "24px 24px 600px"
        پاراگراف: شناسه = "size" محتوا = "منتظر بارگذاری صفحه." پایان
