صفحه:
    عنوان = "تراز کردن متن"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ارتفاع خط = 1.9 پایان
    جعبه: ترازمتن = "start" محتوا = "آغاز: سویی که خواندن از آن شروع می‌شود." کادر = "1px solid #cbd5e1" فاصله = 8 فضا پایین = 8 پایان
    جعبه: ترازمتن = "center" محتوا = "وسط: سطرها در میانه." کادر = "1px solid #cbd5e1" فاصله = 8 فضا پایین = 8 پایان
    جعبه: ترازمتن = "end" محتوا = "پایان: سویی که خواندن در آن تمام می‌شود." کادر = "1px solid #cbd5e1" فاصله = 8 فضا پایین = 8 پایان
    جعبه:
        ترازمتن = "justify"
        تراز خط آخر = "center"
        تورفتگی متن = "2em"
        کادر = "1px solid #cbd5e1"
        فاصله = 8
        فضا پایین = 8
        بیشینه عرض = 420
        محتوا = "متن دوطرفه همه‌ی سطرها را به یک پهنا می‌رساند و سطر آخر را می‌شود جداگانه جا داد. سطر نخست دو حرف تورفتگی دارد، چون در کتاب‌ها هر بند را این‌طور شروع می‌کنند."
