صفحه:
    عنوان = "اندازه‌ی قلم"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ارتفاع خط = 1.9 پایان
    پاراگراف: اندازه قلم = 12 محتوا = "۱۲ یعنی ۱۲ پیکسل" پایان
    پاراگراف: اندازه قلم = 12 + 6 محتوا = "یک عبارت: ۱۲ + ۶ می‌شود ۱۸ پیکسل" پایان
    پاراگراف: اندازه قلم = "1.5rem" محتوا = "1.5rem یعنی یک‌ونیم برابر اندازه‌ی ریشه" پایان
    پاراگراف: اندازه قلم = "150%" محتوا = "۱۵۰ درصد اندازه‌ی والد" پایان
    پاراگراف: اندازه قلم = "x-large" محتوا = "واژه‌ی کلیدی x-large" پایان
    پاراگراف: اندازه قلم = "clamp(1rem, 4vw, 2rem)" محتوا = "clamp() با پنجره بزرگ می‌شود، ولی در یک بازه" پایان
