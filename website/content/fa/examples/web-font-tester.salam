واردسازی دام

صفحه:
    عنوان = "آزمون قلم"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    پاراگراف: شناسه = "برچسب" محتوا = "اندازه: 28 پیکسل" پایان
    جعبه: نمایش = "flex" شکاف = 12
        ورودی: شناسه = "اندازه" نوع = "range" کمینه = 12 بیشینه = 64 مقدار = 28
            ورودی = ():
                اندازه := دام.دریافت مقدار(دام.با شناسه("اندازه"))
                دام.تنظیم سبک(دام.با شناسه("نمونه")، "font-size"، اندازه + "px")
                دام.تنظیم متن(دام.با شناسه("برچسب")، "اندازه: " + اندازه + " پیکسل")
            پایان
        پایان
        انتخاب: شناسه = "خانواده" تغییر = (): دام.تنظیم سبک(دام.با شناسه("نمونه")، "font-family"، دام.دریافت مقدار(دام.با شناسه("خانواده"))) پایان
            گزینه: مقدار = "Tahoma, sans-serif" محتوا = "بدون سریف" پایان
            گزینه: مقدار = "Georgia, serif" محتوا = "سریف" پایان
            گزینه: مقدار = "ui-monospace, monospace" محتوا = "هم‌عرض" پایان
        پایان
    پایان
    پاراگراف: شناسه = "نمونه" خانواده قلم = "Tahoma, sans-serif" اندازه قلم = 28 محتوا = "هر نویسنده‌ای در جست‌وجوی واژه‌ی درست است." پایان
