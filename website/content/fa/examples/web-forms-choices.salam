واردسازی دام

تابع نمایش:
    ناپایا اندازه := "کوچک"
    اگر دام.دریافت خاصیت منطقی(دام.با شناسه("s-large"), "checked"): اندازه = "بزرگ" پایان
    ناپایا افزودنی‌ها := ""
    اگر دام.دریافت خاصیت منطقی(دام.با شناسه("x-cheese"), "checked"): افزودنی‌ها += " پنیر" پایان
    اگر دام.دریافت خاصیت منطقی(دام.با شناسه("x-olives"), "checked"): افزودنی‌ها += " زیتون" پایان
    دام.تنظیم متن(دام.با شناسه("out"), "اندازه: " + اندازه + ". افزودنی‌ها:" + افزودنی‌ها)
پایان

صفحه:
    عنوان = "سفارش پیتزا"
    قلم = "Tahoma"، "سیستمی"، "ساده"
    فضا = 1.5rem
    فرم:
        تغییر = نمایش
        گروه فیلد:
            عنوان گروه:
                محتوا = "اندازه"
            پایان
            برچسب:
                فضا = 0.3rem، 0
                ورودی:
                    شناسه = "s-small"
                    نوع = "رادیویی"
                    نام = "size"
                    مقدار = "small"
                    تیک خورده = درست
                پایان
                تکه:
                    محتوا = " کوچک"
                پایان
            پایان
            برچسب:
                فضا = 0.3rem، 0
                ورودی:
                    شناسه = "s-large"
                    نوع = "رادیویی"
                    نام = "size"
                    مقدار = "large"
                پایان
                تکه:
                    محتوا = " بزرگ"
                پایان
            پایان
        پایان
        گروه فیلد:
            عنوان گروه:
                محتوا = "افزودنی‌ها"
            پایان
            برچسب:
                فضا = 0.3rem، 0
                ورودی:
                    شناسه = "x-cheese"
                    نوع = "تیک"
                    نام = "extra"
                    مقدار = "cheese"
                پایان
                تکه:
                    محتوا = " پنیر"
                پایان
            پایان
            برچسب:
                فضا = 0.3rem، 0
                ورودی:
                    شناسه = "x-olives"
                    نوع = "تیک"
                    نام = "extra"
                    مقدار = "olives"
                پایان
                تکه:
                    محتوا = " زیتون"
                پایان
            پایان
        پایان
    پایان
    پاراگراف:
        شناسه = "out"
        محتوا = "اندازه: کوچک. افزودنی‌ها:"
    پایان
پایان
