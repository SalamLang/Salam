واردسازی دام

تابع تعویض:
    همان := دام.دریافت خاصیت منطقی(دام.با شناسه("same"), "checked")
    دام.تنظیم خاصیت منطقی(دام.با شناسه("ship"), "disabled", همان)
پایان

صفحه:
    عنوان = "فیلدهای گروه‌بندی‌شده"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "26rem" پایان
    سراسری: گزینشگر = "fieldset input" نمایش = "block" فضا = "0.4rem 0" فاصله = 5 پایان
    فرم:
        گروه فیلد:
            عنوان گروه: محتوا = "نشانی صورت‌حساب" پایان
            ورودی: نام = "street" جانگهدار = "خیابان" پایان
            ورودی: نام = "town" جانگهدار = "شهر" پایان
        پایان
        برچسب: ورودی: شناسه = "same" نوع = تیک تغییر = تعویض پایان تکه: محتوا = " ارسال به همین نشانی" پایان پایان
        گروه فیلد: شناسه = "ship"
