واردسازی دام

تابع گزارش:
    پرونده‌ها := دام.دریافت خاصیت(دام.با شناسه("pics"), "files")
    تعداد := دام.تعداد(پرونده‌ها)
    ناپایا متن := "پرونده‌ای انتخاب نشده."
    اگر تعداد بزرگتر ۰: متن = "انتخاب شد: " + دام.دریافت خاصیت رشته ای(دام.عنصر شماره(پرونده‌ها, ۰), "name") پایان
    اگر تعداد بزرگتر ۱: متن = متن + " و " + (تعداد - ۱) + " پرونده‌ی دیگر" پایان
    دام.تنظیم متن(دام.با شناسه("out"), متن)
پایان

صفحه:
    عنوان = "بارگذاری پرونده"
    قلم = "Tahoma"، "سیستمی"، "ساده"
    فضا = 1.5rem
    فرم:
        روش = "ارسال"
        رمزگذاری = "چندبخشی"
        برچسب:
            برای = "pics"
            محتوا = "تصویرها "
        پایان
        ورودی:
            شناسه = "pics"
            نام = "pics"
            نوع = "پرونده"
            پذیرش = "image/png, image/jpeg, .webp"
            چندتایی = درست
            تغییر = گزارش
        پایان
    پایان
    پاراگراف:
        شناسه = "out"
        محتوا = "پرونده‌ای انتخاب نشده."
    پایان
پایان
