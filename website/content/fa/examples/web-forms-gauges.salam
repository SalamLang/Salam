واردسازی دام

تابع جابجایی:
    سطح := دام.دریافت مقدار(دام.با شناسه("level"))
    دام.تنظیم متن(دام.با شناسه("shown"), سطح + " درصد")
    دام.تنظیم خاصیت رشته ای(دام.با شناسه("bar"), "value", سطح)
    دام.تنظیم خاصیت رشته ای(دام.با شناسه("gauge"), "value", سطح)
پایان

صفحه:
    عنوان = "خروجی، پیشرفت و سنجه"
    قلم = "Tahoma"، سیستمی، ساده
    فضا = 1.5rem
    فرم:
        برچسب:
            برای = "level"
            محتوا = "شارژ باتری "
        پایان
        ورودی:
            شناسه = "level"
            نوع = بازه
            کمینه = ۰
            بیشینه = ۱۰۰
            مقدار = ۴۰
            ورودی = جابجایی
        پایان
        خروجی:
            شناسه = "shown"
            برای = "level"
            محتوا = "40 درصد"
        پایان
    پایان
    پیشرفت:
        عرض = 16rem
        فضا = 0.6rem، 0
        شناسه = "bar"
        مقدار = ۴۰
        بیشینه = ۱۰۰
    پایان
    سنجه:
        عرض = 16rem
        فضا = 0.6rem، 0
        شناسه = "gauge"
        مقدار = ۴۰
        کمینه = ۰
        بیشینه = ۱۰۰
        حد پایین = ۲۵
        حد بالا = ۷۵
        بهینه = ۱۰۰
    پایان
