واردسازی دام

تابع ثبت:
    روز := دام.دریافت ویژگی(دام.با شناسه("birth"), "data-value")
    دام.تنظیم متن(دام.با شناسه("out"), "مقدار ذخیره‌شده: " + روز)
پایان

صفحه:
    عنوان = "تاریخ شمسی"
    قلم = "Tahoma"، سیستمی، ساده
    فضا = 1.5rem
    برچسب:
        برای = "birth"
        محتوا = "تاریخ تولد "
    پایان
    ورودی:
        شناسه = "birth"
        نام = "birth"
        نوع = "تاریخ شمسی"
        جانگهدار = "۱۳۸۰/۰۱/۰۱"
        تغییر = ثبت
    پایان
    پاراگراف:
        شناسه = "out"
        محتوا = "مقدار ذخیره‌شده:"
    پایان
