واردسازی دام

تابع عضویت(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
    اگر دام.فراخوان(دام.با شناسه("sign"), "reportValidity") برگردان منطقی:
        نام := دام.دریافت مقدار(دام.با شناسه("name"))
        ایمیل := دام.دریافت مقدار(دام.با شناسه("mail"))
        دام.تنظیم متن(دام.با شناسه("out"), "خوش آمدید " + نام + ". برایتان به نشانی " + ایمیل + " می‌نویسیم.")
    پایان
پایان

صفحه:
    عنوان = "عضویت"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "24rem" پایان
    سراسری: گزینشگر = "label" نمایش = "block" فضا = "0.8rem 0 0.2rem" پایان
    سراسری: گزینشگر = "input" فاصله = 6 عرض = "100%" اندازه جعبه = "border-box" پایان
    فرم: شناسه = "sign"
        برچسب: برای = "name" محتوا = "نام شما" پایان
        ورودی: شناسه = "name" نام = "name" الزامی = درست جانگهدار = "علی رضایی" پایان
        برچسب: برای = "mail" محتوا = "ایمیل" پایان
        ورودی: شناسه = "mail" نام = "mail" نوع = ایمیل الزامی = درست جانگهدار = "ali@example.com" پایان
        دکمه: نوع = ارسال کلیک = عضویت محتوا = "عضو شو" فضا = "1rem 0" فاصله = "6px 18px" پایان
    پایان
    پاراگراف: شناسه = "out" رنگ = "#0f766e" پایان
پایان
