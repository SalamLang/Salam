صفحه:
    عنوان = "نوع‌های ورودی"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    فرم:
        نمایش = "grid"
        ستون های شبکه = "7rem 12rem"
        شکاف = "0.6rem 1rem"
        برچسب: برای = "n" محتوا = "عدد" پایان
        ورودی: شناسه = "n" نوع = عدد پایان
        برچسب: برای = "p" محتوا = "تلفن" پایان
        ورودی: شناسه = "p" نوع = تلفن پایان
        برچسب: برای = "u" محتوا = "نشانی وب" پایان
        ورودی: شناسه = "u" نوع = نشانی پایان
        برچسب: برای = "q" محتوا = "جستجو" پایان
        ورودی: شناسه = "q" نوع = جستجو پایان
        برچسب: برای = "d" محتوا = "تاریخ" پایان
        ورودی: شناسه = "d" نوع = تاریخ پایان
        برچسب: برای = "t" محتوا = "ساعت" پایان
        ورودی: شناسه = "t" نوع = زمان پایان
        برچسب: برای = "c" محتوا = "رنگ" پایان
        ورودی: شناسه = "c" نوع = "رنگ ورودی" پایان
        برچسب: برای = "v" محتوا = "صدا" پایان
        ورودی: شناسه = "v" نوع = بازه پایان
    پایان
