واردسازی دام

تابع بررسی(رویداد: صحیح۶۴):
    میدان := دام.هدف رویداد(رویداد)
    ی := دام.دریافت خاصیت(میدان, "validity")
    ناپایا متن := "درست است."
    اگر دام.دریافت خاصیت منطقی(ی, "valueMissing"): متن = "پر کردن این بخش لازم است."
    وگرنه دام.دریافت خاصیت منطقی(ی, "tooShort"): متن = "دست‌کم ۳ نویسه بنویسید."
    وگرنه دام.دریافت خاصیت منطقی(ی, "patternMismatch"): متن = "فقط حرف کوچک انگلیسی، بدون فاصله."
    وگرنه دام.دریافت خاصیت منطقی(ی, "rangeUnderflow"): متن = "سن باید ۱۸ یا بیشتر باشد."
    وگرنه دام.دریافت خاصیت منطقی(ی, "rangeOverflow"): متن = "سن را تا ۹۹ وارد کنید."
    پایان
    دام.تنظیم متن(دام.با شناسه(دام.دریافت خاصیت رشته ای(میدان, "id") + "-note"), متن)
پایان

صفحه:
    عنوان = "اعتبارسنجی"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    سبک: محتوا = "input:user-invalid { border: 2px solid #dc2626 } input:user-valid { border: 2px solid #16a34a }" پایان
    فرم:
        برچسب: برای = "user" محتوا = "نام کاربری" پایان
        ورودی: شناسه = "user" الزامی = درست کمینه طول = ۳ الگو = "[a-z]+" ورودی = بررسی پایان
        پاراگراف: شناسه = "user-note" محتوا = "دست‌کم ۳ حرف." پایان
        برچسب: برای = "age" محتوا = "سن" پایان
        ورودی: شناسه = "age" نوع = عدد الزامی = درست کمینه = ۱۸ بیشینه = ۹۹ ورودی = بررسی پایان
        پاراگراف: شناسه = "age-note" محتوا = "از ۱۸ تا ۹۹." پایان
    پایان
پایان
