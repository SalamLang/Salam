واردسازی دام

ناپایا بازاست := نادرست

تابع بازوبسته:
    بازاست = وارونه بازاست
    سوییچ := دام.با شناسه("menu-button")
    اگر بازاست:
        دام.تنظیم ویژگی(سوییچ، "aria-expanded"، "true")
        دام.تنظیم متن(سوییچ، "پنهان کردن منو")
    وگرنه:
        دام.تنظیم ویژگی(سوییچ، "aria-expanded"، "false")
        دام.تنظیم متن(سوییچ، "نمایش منو")
    پایان
    دام.تنظیم خاصیت منطقی(دام.با شناسه("menu")، "hidden"، وارونه بازاست)
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    دکمه:
        شناسه = "menu-button"
        باز شده دسترسی‌پذیری = "false"
        کنترل‌کننده دسترسی‌پذیری = "menu"
        کلیک = بازوبسته
        محتوا = "نمایش منو"
    پایان
    فهرست:
        شناسه = "menu"
        پنهان = درست
        مورد: محتوا = "خانه" پایان
        مورد: محتوا = "فروشگاه" پایان
        مورد: محتوا = "تماس" پایان
    پایان
پایان
