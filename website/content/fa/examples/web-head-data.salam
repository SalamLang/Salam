واردسازی دام

تابع انتخاب(رویداد: صحیح۶۴):
    طرح := دام.هدف رویداد(رویداد)
    دام.تنظیم متن(دام.با شناسه("chosen")، دام.دریافت ویژگی(طرح، "data-plan") + "، ماهی " + دام.دریافت ویژگی(طرح، "data-price") + " هزار تومان")
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        نمایش = flex
        شکاف = 8
        فضا = "0 0 12px"
        دکمه: داده plan = "پایه" داده price = "۵۰" کلیک = انتخاب محتوا = "پایه" پایان
        دکمه: داده plan = "تیمی" داده price = "۱۲۰" کلیک = انتخاب محتوا = "تیمی" پایان
        دکمه: داده plan = "شرکتی" داده price = "۴۰۰" کلیک = انتخاب محتوا = "شرکتی" پایان
