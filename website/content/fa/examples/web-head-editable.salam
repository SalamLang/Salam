واردسازی دام

تابع بازتاب:
    دام.تنظیم متن(دام.با شناسه("status")، "یادداشت می‌گوید: " + دام.دریافت متن(دام.با شناسه("note")))
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    پاراگراف: محتوا = "روی جعبه کلیک کنید و بنویسید. یک عنصر معمولی است که می‌شود ویرایشش کرد." پایان
    جعبه:
        شناسه = "note"
        ویرایش‌پذیر = درست
        غلط‌یاب = بله
        ترتیب جهش = ۰
        فاصله = 12
        کادر = "2px dashed #64748b"
        گردی کادر = 8
        محتوا = "یک یادداشت کوتاه"
        ورودی = بازتاب
    پایان
    پاراگراف: شناسه = "status" محتوا = "یادداشت می‌گوید: یک یادداشت کوتاه" پایان
