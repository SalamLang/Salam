واردسازی دام

تابع بازخوانی:
    دام.تنظیم متن(دام.با شناسه("out-title")، "عنوان: " + دام.دریافت متن(دام.پرسمان("title")))
    دام.تنظیم متن(دام.با شناسه("out-lang")، "زبان: " + دام.دریافت ویژگی(دام.پرسمان("html")، "lang"))
    دام.تنظیم متن(دام.با شناسه("out-desc")، "شرح: " + دام.دریافت ویژگی(دام.پرسمان("meta[name=description]")، "content"))
    دام.تنظیم متن(دام.با شناسه("out-canon")، "نشانی اصلی: " + دام.دریافت ویژگی(دام.پرسمان("link[rel=canonical]")، "href"))
پایان

صفحه:
    عنوان = "خواندن سر صفحه"
    متا: نام = "description" محتوا = "صفحه‌ای که سر خودش را می‌خواند." پایان
    پیوند سر: رابطه = "canonical" نشانی = "https://example.com/head" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    دکمه: کلیک = بازخوانی محتوا = "سر صفحه را بخوان" پایان
    پاراگراف: شناسه = "out-title" محتوا = "عنوان: ؟" پایان
    پاراگراف: شناسه = "out-lang" محتوا = "زبان: ؟" پایان
    پاراگراف: شناسه = "out-desc" محتوا = "شرح: ؟" پایان
    پاراگراف: شناسه = "out-canon" محتوا = "نشانی اصلی: ؟" پایان
پایان
