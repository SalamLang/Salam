واردسازی دام

ناپایا ایکس := 120
ناپایا ایگرگ := 60

تابع هدایت(رخداد: صحیح۶۴):
    کلید := دام.کلید رویداد(رخداد)
    اگر کلید برابر "ArrowLeft":
        ایکس -= 12
    وگرنه کلید برابر "ArrowRight":
        ایکس += 12
    وگرنه کلید برابر "ArrowUp":
        ایگرگ -= 12
    وگرنه کلید برابر "ArrowDown":
        ایگرگ += 12
    وگرنه:
        برگشت
    پایان
    دام.جلوگیری پیش فرض(رخداد)
    ایکس = ایکس کوچکتر 0 ? 0 : (ایکس بزرگتر 270 ? 270 : ایکس)
    ایگرگ = ایگرگ کوچکتر 0 ? 0 : (ایگرگ بزرگتر 120 ? 120 : ایگرگ)
    دام.تنظیم سبک(دام.با شناسه("ball")، "left"، ایکس + "px")
    دام.تنظیم سبک(دام.با شناسه("ball")، "top"، ایگرگ + "px")
پایان

صفحه:
    عنوان = "کلیدهای جهت‌نما"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        شناسه = "arena"
        ترتیب جهش = 0
        فشردن کلید = هدایت
        موقعیت = نسبی
        عرض = 300
        ارتفاع = 150
        پس زمینه = "#ecfeff"
        کادر = "2px solid #67e8f9"
        گردی کادر = 10
        جعبه: شناسه = "ball" موقعیت = مطلق چپ = 120 بالا = 60 عرض = 30 ارتفاع = 30 گردی کادر = "50%" پس زمینه = "#0891b2" پایان
    پایان
    پاراگراف: محتوا = "روی جعبه کلیک کنید و بعد با کلیدهای جهت‌نما بچرخانید." پایان
پایان
