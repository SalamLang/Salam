واردسازی دام

ناپایا رونوشتها := 0
ناپایا برشها := 0

تابع آمار:
    دام.تنظیم متن(دام.با شناسه("stats")، "رونوشت " + رونوشتها + " بار، برش " + برشها + " بار")
پایان

تابع رونوشتشده:
    رونوشتها += 1
    آمار()
پایان

تابع بریده:
    برشها += 1
    آمار()
پایان

تابع چسبانده(رخداد: صحیح۶۴):
    متن := دام.فراخوان رشته یک(دام.دریافت خاصیت(رخداد، "clipboardData")، "getData"، "text")
    دام.تنظیم خاصیت(دام.با شناسه("last")، "textContent"، متن)
پایان

صفحه:
    عنوان = "حافظه‌ی موقت"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    ورودی: شناسه = "field" رونوشت = رونوشتشده برش = بریده چسباندن = چسبانده مقدار = "در این کادر رونوشت، برش یا چسباندن را امتحان کنید" عرض = "100%" فاصله = 10 اندازه قلم = "1rem" اندازه جعبه = "border-box" پایان
    پاراگراف: شناسه = "stats" محتوا = "رونوشت 0 بار، برش 0 بار" پایان
    پاراگراف:
        محتوا = "آخرین متن چسبانده‌شده: "
        تکه: شناسه = "last" محتوا = "هیچ" وزن قلم = "bold" پایان
    پایان
پایان
