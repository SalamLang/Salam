واردسازی دام

تابع شمارش:
    تعداد := دام.دریافت مقدار(دام.با شناسه("msg")).طول()
    باقی := دام.با شناسه("left")
    دام.تنظیم متن(باقی، تعداد + " / 80")
    اگر تعداد بزرگتربرابر 70:
        دام.تنظیم سبک(باقی، "color"، "#b91c1c")
    وگرنه:
        دام.تنظیم سبک(باقی، "color"، "#475569")
    پایان
پایان

صفحه:
    عنوان = "شمارنده‌ی نویسه"
    قلم = "Tahoma"، سیستمی، ساده
    فضا = 1.5rem
    ورودی:
        نوع = "ناحیه متن"
        شناسه = "msg"
        ورودی = شمارش
        بیشینه طول = 80
        ردیف‌ها = 3
        جانگهدار = "یک پیام کوتاه"
        عرض = 100%
        فاصله = 10
        اندازه قلم = 1rem
    پایان
    پاراگراف:
        شناسه = "left"
        محتوا = "0 / 80"
        تراز متن = چپ
        فضا = 4px، 0
        جهت = ltr
    پایان
پایان
