واردسازی دام

تابع بازکردن:
    دام.تنظیم متن(دام.با شناسه("log")، "پنجره باز است.")
    _ر := دام.فراخوان(دام.با شناسه("dlg")، "showModal")
پایان

تابع انصرافداد:
    دام.تنظیم متن(دام.با شناسه("log")، "انصراف رخ داد (Escape زده شد).")
پایان

تابع بستهشد:
    دام.تنظیم متن(دام.با شناسه("end")، "بسته شدن رخ داد، مقدار برگشتی: " + دام.دریافت خاصیت رشته ای(دام.با شناسه("dlg")، "returnValue"))
پایان

تابع تاییدحذف:
    _ر := دام.فراخوان رشته یک(دام.با شناسه("dlg")، "close"، "deleted")
پایان

صفحه:
    عنوان = "پنجره‌ی گفتگو"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    دکمه: شناسه = "open" کلیک = بازکردن محتوا = "حذف پرونده" فاصله = "8px 16px" پایان
    پنجره گفتگو:
        شناسه = "dlg"
        انصراف = انصرافداد
        بسته شدن = بستهشد
        پاراگراف: محتوا = "این پرونده برای همیشه حذف شود؟" پایان
        دکمه: شناسه = "yes" کلیک = تاییدحذف محتوا = "حذف" فاصله = "6px 14px" پایان
    پایان
    پاراگراف: شناسه = "log" محتوا = "هنوز چیزی نشده." پایان
    پاراگراف: شناسه = "end" محتوا = "" پایان
پایان
