واردسازی دام

تابع فشرده(رخداد: صحیح۶۴):
    دام.تنظیم متن(دام.با شناسه("down")، "فشردن کلید: " + دام.کلید رویداد(رخداد) + "، کد " + دام.دریافت خاصیت رشته ای(رخداد، "code"))
    اگر دام.دریافت خاصیت منطقی(رخداد، "repeat"):
        دام.تنظیم متن(دام.با شناسه("note")، "کلید نگه داشته شده و مرورگر آن را تکرار می‌کند.")
    وگرنه:
        دام.تنظیم متن(دام.با شناسه("note")، "")
    پایان
پایان

تابع رهاشده(رخداد: صحیح۶۴):
    دام.تنظیم متن(دام.با شناسه("up")، "رها کردن کلید: " + دام.کلید رویداد(رخداد))
    دام.تنظیم متن(دام.با شناسه("note")، "")
پایان

صفحه:
    عنوان = "کدام کلید؟"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    ورودی: شناسه = "field" فشردن کلید = فشرده رها کردن کلید = رهاشده جانگهدار = "اینجا کلیک کنید و کلیدها را بزنید" عرض = "100%" فاصله = 10 اندازه قلم = "1rem" اندازه جعبه = "border-box" پایان
    پاراگراف: شناسه = "down" محتوا = "فشردن کلید: هنوز چیزی نشده" خانواده قلم = monospace جهت = ltr پایان
    پاراگراف: شناسه = "up" محتوا = "رها کردن کلید: هنوز چیزی نشده" خانواده قلم = monospace جهت = ltr پایان
    پاراگراف: شناسه = "note" محتوا = "" رنگ = "#b45309" پایان
پایان
