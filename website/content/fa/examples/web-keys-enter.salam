واردسازی دام

تابع نوشتن(رخداد: صحیح۶۴):
    کادر := دام.با شناسه("task")
    کلید := دام.کلید رویداد(رخداد)
    اگر کلید برابر "Enter" و دام.دریافت مقدار(کادر).طول() بزرگتر 0:
        مورد := دام.بساز("li")
        دام.تنظیم متن(مورد، دام.دریافت مقدار(کادر))
        دام.افزودن(دام.با شناسه("list")، مورد)
        دام.تنظیم مقدار(کادر، "")
    وگرنه کلید برابر "Escape":
        دام.تنظیم مقدار(کادر، "")
    پایان
پایان

صفحه:
    عنوان = "فهرست کارها"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" بیشینه عرض = "28rem" پایان
    ورودی: شناسه = "task" فشردن کلید = نوشتن جانگهدار = "کار تازه، بعد Enter" عرض = "100%" فاصله = 10 اندازه قلم = "1rem" اندازه جعبه = "border-box" پایان
    پاراگراف: محتوا = "Enter کار را اضافه می‌کند. Escape کادر را خالی می‌کند." رنگ = "#64748b" اندازه قلم = "0.9rem" پایان
    فهرست: شناسه = "list" پایان
پایان
