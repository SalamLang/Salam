واردسازی دام

تابع پالایش:
    عبارت := دام.دریافت مقدار(دام.با شناسه("q"))
    موردها := دام.پرسمان همه("#fruits li")
    تکرار دام.تعداد(موردها) در شماره:
        مورد := دام.عنصر شماره(موردها، شماره)
        اگر دام.دریافت متن(مورد).دربردارد(عبارت):
            دام.تنظیم سبک(مورد، "display"، "")
        وگرنه:
            دام.تنظیم سبک(مورد، "display"، "none")
        پایان
    پایان
پایان

صفحه:
    عنوان = "جست‌وجوی زنده"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    ورودی: شناسه = "q" ورودی = پالایش جانگهدار = "جست‌وجوی میوه" عرض = "100%" فاصله = 10 اندازه قلم = "1rem" اندازه جعبه = "border-box" پایان
    فهرست: شناسه = "fruits"
        مورد: محتوا = "سیب" پایان
        مورد: محتوا = "موز" پایان
        مورد: محتوا = "آلبالو" پایان
        مورد: محتوا = "انبه" پایان
        مورد: محتوا = "پرتقال" پایان
        مورد: محتوا = "گلابی" پایان
    پایان
پایان
