واردسازی دام

تابع راهنما(متن: رشته):
    دام.تنظیم متن(دام.با شناسه("hint")، متن)
پایان

تابع بررسینام:
    اگر دام.دریافت مقدار(دام.با شناسه("name")).طول() برابر 0:
        راهنما("نام را باید بنویسید.")
        دام.تنظیم سبک(دام.با شناسه("name")، "border-color"، "#dc2626")
    وگرنه:
        راهنما("سپاس.")
        دام.تنظیم سبک(دام.با شناسه("name")، "border-color"، "")
    پایان
پایان

صفحه:
    عنوان = "فوکوس و از دست دادن فوکوس"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    سراسری: گزینشگر = "input" نمایش = بلوکی عرض = "100%" فاصله = 10 فضا = "0 0 10px 0" اندازه قلم = "1rem" کادر = "2px solid #cbd5e1" گردی کادر = 6 اندازه جعبه = "border-box" پایان
    ورودی: شناسه = "name" جانگهدار = "نام و نام خانوادگی" فوکوس = (): راهنما("نام را همان‌طور که روی کارتتان است بنویسید.") پایان از دست رفتن فوکوس = بررسینام پایان
