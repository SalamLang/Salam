واردسازی دام

تابع افزودنی(رخداد: صحیح۶۴):
    داده := دام.دریافت خاصیت(رخداد، "formData")
    _ر := دام.فراخوان رشته دو(داده، "append"، "source"، "newsletter")
    دام.تنظیم متن(دام.با شناسه("out")، "داده‌ی فرم: فرم یک فیلد پنهان به نام source اضافه کرد.")
پایان

صفحه:
    عنوان = "داده‌ی فرم"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    فرم:
        شناسه = "news"
        داده فرم = افزودنی
        ورودی: نام = "email" مقدار = "sara@example.com" فاصله = 10 اندازه قلم = "1rem" جهت = ltr پایان
        دکمه: شناسه = "build" نوع = button کلیک = "new FormData(document.getElementById('news'))" محتوا = "ساختن داده‌ی فرم" فاصله = "8px 16px" فضا = "0 8px 0 0" پایان
    پایان
    پاراگراف: شناسه = "out" محتوا = "هنوز چیزی ساخته نشده." پایان
