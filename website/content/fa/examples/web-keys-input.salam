واردسازی دام

ناپایا ورودیها := 0
ناپایا تغییرها := 0

تابع نوشتن:
    دام.تنظیم متن(دام.با شناسه("counts")، "ورودی " + ورودیها + " بار رخ داد، تغییر " + تغییرها + " بار رخ داد")
پایان

صفحه:
    عنوان = "ورودی و تغییر"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    ورودی: شناسه = "field" ورودی = (): ورودیها += 1 نوشتن() پایان تغییر = (): تغییرها += 1 نوشتن() پایان جانگهدار = "بنویسید، بعد Enter بزنید یا بیرون کلیک کنید" عرض = "100%" فاصله = 10 اندازه قلم = "1rem" اندازه جعبه = "border-box" پایان
    پاراگراف: شناسه = "counts" محتوا = "ورودی 0 بار رخ داد، تغییر 0 بار رخ داد" پایان
    پاراگراف: محتوا = "ورودی هر ضربه‌ی کلید را دنبال می‌کند. تغییر صبر می‌کند تا کارتان تمام شود." رنگ = "#64748b" پایان
پایان
