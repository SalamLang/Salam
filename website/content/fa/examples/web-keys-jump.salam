واردسازی دام
واردسازی وب.بوم
واردسازی وب.کلیدها

ناپایا افقی := ۴۰.۰
ناپایا عمودی := ۱۶۰.۰
ناپایا سرعت عمودی := ۰.۰
ناپایا بوم من := ۰ برگردان صحیح۶۴

تابع ریشه:
    عنصر := دام.بساز("canvas")
    دام.تنظیم ویژگی(عنصر، "id"، "level")
    دام.تنظیم ویژگی(عنصر، "width"، "400")
    دام.تنظیم ویژگی(عنصر، "height"، "200")
    دام.افزودن(دام.بدنه()، عنصر)
    بوم من = بوم.دریافت بوم("level")
    کلیدها.آماده سازی()
    زمین := ۱۶۰.۰

    دام.چرخش فریم((گذشته: اعشار۶۴):
        _ := گذشته
        اگر کلیدها.نگه داشته("ArrowLeft"):
            افقی -= ۳
        پایان
        اگر کلیدها.نگه داشته("ArrowRight"):
            افقی += ۳
        پایان
        پرش := کلیدها.فشرده شد(" ")
        اگر پرش و عمودی بزرگتربرابر زمین:
            سرعت عمودی = -۹
        پایان
        سرعت عمودی += ۰.۵
        عمودی += سرعت عمودی
        اگر عمودی بزرگتر زمین:
            عمودی = زمین
            سرعت عمودی = ۰
        پایان
        بوم.پاک کردن مستطیل(بوم من، ۰، ۰، ۴۰۰، ۲۰۰)
        بوم.سبک پرشدگی(بوم من، "#444")
        بوم.پرکردن مستطیل(بوم من، ۰، زمین + ۲۰، ۴۰۰، ۲۰)
        بوم.سبک پرشدگی(بوم من، "#e11d48")
        بوم.پرکردن مستطیل(بوم من، افقی، عمودی، ۲۰، ۲۰)
    پایان)
پایان
