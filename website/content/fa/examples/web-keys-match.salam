صفحه:
    عنوان = "جست‌وجو در صفحه"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    پاراگراف: شناسه = "state" محتوا = "متن زیر تا وقتی مرورگر آن را پیدا نکند پنهان می‌ماند." پایان
    جعبه: شناسه = "secret" پنهان = "until-found" محتوا = "کلمه‌ی رمز انار است." فاصله = 14 پس زمینه = "#fef3c7" گردی کادر = 8 پایان
    اسکریپت سفارشی: محتوا = "document.getElementById('secret').addEventListener('beforematch', function () { document.getElementById('state').textContent = 'پیش از تطبیق رخ داد: مرورگر دارد متن را نشان می‌دهد'; });" پایان
