واردسازی دام
واردسازی ریاضی
واردسازی رشته
واردسازی وب.بوم
واردسازی وب.کلیدها

ناپایا جای افقی := ۲۰۰.۰
ناپایا جای عمودی := ۱۵۰.۰
ناپایا ز := ۰ برگردان صحیح۶۴

تابع پایین است(جهت: رشته، حرف: رشته): منطقی:
    برگشت کلیدها.نگه داشته(جهت) یا کلیدها.نگه داشته(حرف) یا کلیدها.نگه داشته(رشته.بزرگ(حرف))
پایان

تابع محور(جهت منفی: رشته، حرف منفی: رشته، جهت مثبت: رشته، حرف مثبت: رشته): اعشار۶۴:
    ناپایا مقدار := ۰.۰
    اگر پایین است(جهت منفی، حرف منفی): مقدار -= ۱.۰ پایان
    اگر پایین است(جهت مثبت، حرف مثبت): مقدار += ۱.۰ پایان
    برگشت مقدار
پایان

تابع ریشه:
    عنصر := دام.بساز("canvas")
    دام.تنظیم ویژگی(عنصر، "id"، "field")
    دام.تنظیم ویژگی(عنصر، "width"، "400")
    دام.تنظیم ویژگی(عنصر، "height"، "300")
    دام.افزودن(دام.بدنه()، عنصر)
    ز = بوم.دریافت بوم("field")
    کلیدها.آماده سازی()
    هر کلید در ["w"، "a"، "s"، "d"، "W"، "A"، "S"، "D"]:
        کلیدها.پیگیری(کلید)
    پایان
    سرعت := ۰.۲

    دام.چرخش فریم((گذشته: اعشار۶۴):
        ناپایا گام افقی := محور("ArrowLeft"، "a"، "ArrowRight"، "d")
        ناپایا گام عمودی := محور("ArrowUp"، "w"، "ArrowDown"، "s")
        طول بردار := ریاضی.جذر(گام افقی * گام افقی + گام عمودی * گام عمودی)
        اگر طول بردار بزرگتر ۰.۰:
            گام افقی = گام افقی / طول بردار
            گام عمودی = گام عمودی / طول بردار
        پایان
        جای افقی = ریاضی.محدودسازی اعشار(جای افقی + گام افقی * سرعت * گذشته، ۱۰.۰، ۳۹۰.۰)
        جای عمودی = ریاضی.محدودسازی اعشار(جای عمودی + گام عمودی * سرعت * گذشته، ۱۰.۰، ۲۹۰.۰)
        بوم.سبک پرشدگی(ز، "#0f172a")
        بوم.پرکردن مستطیل(ز، ۰، ۰، ۴۰۰، ۳۰۰)
        بوم.سبک پرشدگی(ز، "#22c55e")
        بوم.شروع مسیر(ز)
        بوم.کمان(ز، جای افقی، جای عمودی، ۱۰، ۰، ۶.۲۸۳۲)
        بوم.پرکن(ز)
    پایان)
پایان
