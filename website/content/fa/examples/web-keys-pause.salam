واردسازی دام
واردسازی وب.بوم
واردسازی وب.کلیدها

ناپایا مکث := نادرست
ناپایا زاویه := ۰.۰
ناپایا بوم من := ۰ برگردان صحیح۶۴

تابع ریشه:
    عنصر := دام.بساز("canvas")
    دام.تنظیم ویژگی(عنصر، "id"، "game")
    دام.تنظیم ویژگی(عنصر، "width"، "200")
    دام.تنظیم ویژگی(عنصر، "height"، "200")
    دام.افزودن(دام.بدنه()، عنصر)
    بوم من = بوم.دریافت بوم("game")
    کلیدها.آماده سازی()
    کلیدها.پیگیری("p")
    کلیدها.پیگیری("P")
    کلیدها.پیگیری("Escape")

    دام.چرخش فریم((اکنون: اعشار۶۴):
        _ := اکنون
        اگر کلیدها.فشرده شد("p") یا کلیدها.فشرده شد("P") یا کلیدها.فشرده شد("Escape"):
            مکث = وارونه مکث
        پایان
        اگر وارونه مکث:
            زاویه += ۰.۰۵
        پایان
        بوم.پاک کردن مستطیل(بوم من، ۰، ۰، ۲۰۰، ۲۰۰)
        بوم.ذخیره وضعیت(بوم من)
        بوم.جابجایی مختصات(بوم من، ۱۰۰، ۱۰۰)
        بوم.چرخش(بوم من، زاویه)
        بوم.سبک پرشدگی(بوم من، "#22c55e")
        بوم.پرکردن مستطیل(بوم من، -۳۰، -۳۰، ۶۰، ۶۰)
        بوم.بازگردانی وضعیت(بوم من)
        اگر مکث:
            بوم.سبک پرشدگی(بوم من، "#000")
            بوم.قلم(بوم من، "18px sans-serif")
            بوم.ترازبندی متن(بوم من، "center")
            بوم.پرکردن متن(بوم من، "مکث، P را بزنید"، ۱۰۰، ۱۹۰)
        پایان
    پایان)
پایان
