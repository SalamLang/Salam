واردسازی دام

تابع انتخابشد:
    کادر := دام.با شناسه("text")
    الف := دام.دریافت خاصیت عددی(کادر، "selectionStart") برگردان صحیح۶۴
    ب := دام.دریافت خاصیت عددی(کادر، "selectionEnd") برگردان صحیح۶۴
    دام.تنظیم متن(دام.با شناسه("sel")، "انتخاب: " + (ب - الف) + " نویسه، از " + الف + " تا " + ب)
پایان

تابع مکاننما:
    جا := دام.دریافت خاصیت عددی(دام.با شناسه("text")، "selectionStart") برگردان صحیح۶۴
    دام.تنظیم متن(دام.با شناسه("caret")، "تغییر انتخاب: مکان‌نما در " + جا)
پایان

تابع شروعشد:
    دام.تنظیم متن(دام.با شناسه("start")، "شروع انتخاب: انتخاب تازه‌ای در این پاراگراف آغاز شد.")
پایان

صفحه:
    عنوان = "انتخاب متن"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    متن بلند: شناسه = "text" انتخاب = انتخابشد تغییر انتخاب = مکاننما ردیف‌ها = 3 محتوا = "بخشی از این کلمه‌ها را با ماوس یا با Shift و کلیدهای جهت‌نما انتخاب کنید." عرض = "100%" فاصله = 10 اندازه قلم = "1rem" اندازه جعبه = "border-box" پایان
    پاراگراف: شناسه = "sel" محتوا = "انتخاب: چیزی انتخاب نشده" پایان
    پاراگراف: شناسه = "caret" محتوا = "تغییر انتخاب: هنوز مکان‌نمایی نیست" پایان
    پاراگراف: شناسه = "para" شروع انتخاب = شروعشد محتوا = "این پاراگراف را هم می‌توانید انتخاب کنید." پس زمینه = "#fef9c3" فاصله = 8 پایان
    پاراگراف: شناسه = "start" محتوا = "شروع انتخاب: هنوز چیزی نشده" پایان
پایان
