واردسازی دام

تابع میانبر(رخداد: صحیح۶۴):
    کنترل := دام.دریافت خاصیت منطقی(رخداد، "ctrlKey") یا دام.دریافت خاصیت منطقی(رخداد، "metaKey")
    کد := دام.دریافت خاصیت رشته ای(رخداد، "code")
    اگر کنترل و کد برابر "KeyS":
        دام.جلوگیری پیش فرض(رخداد)
        دام.تنظیم متن(دام.با شناسه("status")، "با Ctrl+S ذخیره شد")
    وگرنه کنترل و کد برابر "Enter":
        دام.جلوگیری پیش فرض(رخداد)
        دام.تنظیم متن(دام.با شناسه("status")، "با Ctrl+Enter فرستاده شد")
    پایان
پایان

صفحه:
    عنوان = "میانبرها"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        شناسه = "editor"
        فشردن کلید = میانبر
        متن بلند: شناسه = "notes" ردیف‌ها = 5 جانگهدار = "اینجا بنویسید. Ctrl+S و Ctrl+Enter را امتحان کنید." عرض = "100%" فاصله = 10 اندازه قلم = "1rem" اندازه جعبه = "border-box" پایان
    پایان
    پاراگراف: شناسه = "status" محتوا = "هنوز چیزی نشده." رنگ = "#047857" پایان
پایان
