واردسازی دام

تابع ارسالفرم(رخداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رخداد)
    کی := دام.دریافت مقدار(دام.با شناسه("who"))
    نشانی := دام.دریافت مقدار(دام.با شناسه("mail"))
    دام.تنظیم متن(دام.با شناسه("result")، "سپاس، " + کی + ". به " + نشانی + " می‌نویسیم.")
پایان

تابع خالیشد:
    دام.تنظیم متن(دام.با شناسه("result")، "فرم خالی شد.")
پایان

صفحه:
    عنوان = "ثبت نام"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    سراسری: گزینشگر = "input" نمایش = بلوکی عرض = "100%" فاصله = 10 فضا = "0 0 10px 0" اندازه قلم = "1rem" اندازه جعبه = "border-box" پایان
    سراسری: گزینشگر = "button" فاصله = "8px 16px" فضا = "0 0 0 8px" اندازه قلم = "1rem" پایان
    فرم:
        شناسه = "signup"
        ارسال = ارسالفرم
        بازنشانی = خالیشد
        ورودی: شناسه = "who" جانگهدار = "نام شما" پایان
        ورودی: شناسه = "mail" نوع = email جانگهدار = "رایانامه‌ی شما" پایان
        دکمه: شناسه = "go" نوع = submit محتوا = "ثبت نام" پایان
        دکمه: شناسه = "clear" نوع = reset محتوا = "پاک کردن" پایان
    پایان
    پاراگراف: شناسه = "result" محتوا = "" رنگ = "#047857" پایان
پایان
