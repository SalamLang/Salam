واردسازی دام

تابع ارسالفرم(رخداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رخداد)
    کی := دام.دریافت مقدار(دام.با شناسه("who"))
    نشانی := دام.دریافت مقدار(دام.با شناسه("mail"))
    دام.تنظیم متن(دام.با شناسه("result")، "سپاس، " + کی + ". به " + نشانی + " می‌نویسیم.")
پایان

تابع خالیشد:
    دام.تنظیم متن(دام.با شناسه("result")، "فرم خالی شد.")
پایان

صفحه:
    عنوان = "ثبت نام"
    قلم = "Tahoma"، سیستمی، ساده فضا = 1.5rem
    فرم:
        شناسه = "signup"
        ارسال = ارسالفرم
        بازنشانی = خالیشد
        ورودی: عرض = 100% فاصله = 10 فضا = 0، 0، 10px، 0 اندازه قلم = 1rem شناسه = "who" جانگهدار = "نام شما" پایان
        ورودی: عرض = 100% فاصله = 10 فضا = 0، 0، 10px، 0 اندازه قلم = 1rem شناسه = "mail" نوع = ایمیل جانگهدار = "رایانامه‌ی شما" پایان
        دکمه: فاصله = 8px، 16px فضا = 0، 0، 0، 8px اندازه قلم = 1rem شناسه = "go" نوع = ارسال محتوا = "ثبت نام" پایان
        دکمه: فاصله = 8px، 16px فضا = 0، 0، 0، 8px اندازه قلم = 1rem شناسه = "clear" نوع = بازنشانی محتوا = "پاک کردن" پایان
    پایان
    پاراگراف: شناسه = "result" محتوا = "" رنگ = #047857 پایان
