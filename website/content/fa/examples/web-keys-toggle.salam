واردسازی دام

تابع بازشد:
    اگر دام.دریافت خاصیت منطقی(دام.با شناسه("more")، "open"):
        دام.تنظیم متن(دام.با شناسه("dstate")، "جزئیات باز است.")
    وگرنه:
        دام.تنظیم متن(دام.با شناسه("dstate")، "جزئیات بسته است.")
    پایان
پایان

تابع واشد(رخداد: صحیح۶۴):
    دام.تنظیم متن(دام.با شناسه("pstate")، "حالت تازه‌ی واشو: " + دام.دریافت خاصیت رشته ای(رخداد، "newState"))
پایان

تابع درشرف(رخداد: صحیح۶۴):
    دام.تنظیم متن(دام.با شناسه("before")، "پیش از تغییر حالت: در شرف " + دام.دریافت خاصیت رشته ای(رخداد، "newState"))
پایان

