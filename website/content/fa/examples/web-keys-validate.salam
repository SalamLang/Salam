    کادر := دام.هدف رویداد(رخداد)
    اگر دام.دریافت خاصیت منطقی(دام.دریافت خاصیت(کادر، "validity")، "valueMissing"):
        _الف := دام.فراخوان رشته یک(کادر، "setCustomValidity"، "لطفاً رایانامه‌تان را بنویسید.")
