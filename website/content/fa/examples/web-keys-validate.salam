        _ب := دام.فراخوان رشته یک(کادر، "setCustomValidity"، "این شبیه نشانی رایانامه نیست.")
    پایان
    دام.تنظیم متن(دام.با شناسه("why")، "نامعتبر: " + دام.دریافت خاصیت رشته ای(کادر، "validationMessage"))
پایان

