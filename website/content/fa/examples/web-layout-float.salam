صفحه:
    عنوان = "دور پیچیدن متن به دور یک جعبه"
    سراسری: اندازه جعبه = "border-box" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 20 بیشینه عرض = 480 ارتفاع خط = 1.5 پایان
    جعبه: شناوری = "inline-start" عرض = 110 ارتفاع = 90 فضا = "4 0 6" فضا انتها = 14 پس زمینه = "#fcd34d" فاصله = 8 محتوا = "شناور" پایان
    پاراگراف: محتوا = "جعبه‌ی شناور از جریان عادی بیرون می‌رود و به یک سو می‌چسبد، و سطرهای متنِ بعدی دور آن می‌پیچند. عکس‌های میان نوشته‌های مجله همین‌طور می‌نشینند. این نوشته را آن‌قدر ادامه بدهید که از جعبه بلندتر شود و زیر آن بپیچد." پایان
    جعبه: پاک‌سازی شناوری = دوسو پس زمینه = "#e2e8f0" فاصله = 8 محتوا = "پاک‌سازی دوسو: این جعبه زیر جعبه‌ی شناور شروع می‌شود." پایان
پایان
