واردسازی دام

پایا زیرنویس := "data:text/vtt,WEBVTT%0A%0A00:00.000 --> 00:01.000%0Aسلام%0A%0A00:01.000 --> 00:02.000%0Aبه همه%0A%0A00:02.000 --> 00:03.000%0Aخوش آمدید"

تابع صدا(): رشته:
    ناپایا موج := "data:audio/wav;base64,UklGRu5dAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgASlVOSwIAAAAAAGRhdGHAXQAA"
    تکرار ۴۰۰: موج += "oKCgoKCgoKCgoGBgYGBgYGBgYGCgoKCgoKCgoKCgYGBgYGBgYGBgYKCgoKCgoKCgoKBgYGBgYGBgYGBg" پایان
    برگشت موج
پایان

تابع نشان‌بده():
    نشانه ها := دام.دریافت خاصیت(دام.دریافت خاصیت(دام.با شناسه("words")، "track")، "activeCues")
    اگر دام.دریافت خاصیت عددی(نشانه ها، "length") بزرگتر ۰.۰:
        دام.تنظیم متن(دام.با شناسه("line")، دام.دریافت خاصیت رشته ای(دام.عنصر شماره(نشانه ها، ۰)، "text"))
    وگرنه:
        دام.تنظیم متن(دام.با شناسه("line")، "...")
    پایان
پایان

تابع شروع‌کن():
    پخش کننده := دام.با شناسه("sound")
    دام.تنظیم ویژگی(دام.با شناسه("words")، "src"، زیرنویس)
    دام.تنظیم ویژگی(پخش کننده، "src"، صدا())
    _ := دام.فراخوان(پخش کننده، "play")
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    صدا: شناسه = "sound" کنترل‌ها = درست
        شیار: شناسه = "words" نوع شیار = "captions" پیش‌فرض = درست تغییر نشانه = نشان‌بده نشانی = "captions.vtt"
        پایان
    پایان
    دکمه: کلیک = شروع‌کن محتوا = "پخش با زیرنویس" پایان
    سرتیتر: اندازه = 2 شناسه = "line" محتوا = "پخش را بزنید." پایان
پایان
