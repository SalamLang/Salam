واردسازی دام

ناپایا خط ها := ""
ناپایا شمار := ۰ برگردان صحیح۶۴

تابع بگو(چه: رشته):
    اگر شمار == ۱۲: خط ها = "" شمار = ۰ پایان
    خط ها = خط ها + چه + "\n"
    شمار += ۱
    دام.تنظیم متن(دام.با شناسه("log")، خط ها)
پایان

تابع صدا(): رشته:
    ناپایا موج := "data:audio/wav;base64,UklGRu5dAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgASlVOSwIAAAAAAGRhdGHAXQAA"
    تکرار ۴۰۰: موج += "oKCgoKCgoKCgoGBgYGBgYGBgYGCgoKCgoKCgoKCgYGBgYGBgYGBgYKCgoKCgoKCgoKBgYGBgYGBgYGBg" پایان
    برگشت موج
پایان

تابع بارگذار():
    دام.تنظیم ویژگی(دام.با شناسه("sound")، "src"، صدا())
پایان

تابع پخش‌کن():
    _ := دام.فراخوان(دام.با شناسه("sound")، "play")
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    صدا: شناسه = "sound" کنترل‌ها = درست پیش‌بارگذاری = "none"
        شروع بارگذاری = (): بگو("load start") پایان
        تعلیق = (): بگو("suspend") پایان
        بارگذاری ابرداده = (): بگو("loaded metadata") پایان
        بارگذاری داده = (): بگو("loaded data") پایان
        قابل پخش = (): بگو("can play") پایان
        قابل پخش کامل = (): بگو("can play through") پایان
        پخش = (): بگو("play") پایان
        در حال پخش = (): بگو("playing") پایان
        مکث = (): بگو("pause") پایان
        اتمام پخش = (): بگو("ended") پایان
    پایان
    جعبه: نمایش = فلکس شکاف = 8
        دکمه: کلیک = بارگذار محتوا = "بارگذاری صدا" پایان
        دکمه: کلیک = پخش‌کن محتوا = "پخش" پایان
        دکمه: کلیک = (): _ := دام.فراخوان(دام.با شناسه("sound")، "pause") پایان محتوا = "مکث" پایان
    پایان
    پاراگراف: شناسه = "log" فضای سفید = "pre-wrap" محتوا = "رویدادها اینجا می‌آیند." پایان
پایان
