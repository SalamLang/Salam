واردسازی دام

تابع صدا(): رشته:
    ناپایا موج := "data:audio/wav;base64,UklGRu5dAABXQVZFZm10IBAAAAABAAEAQB8AAEAfAAABAAgASlVOSwIAAAAAAGRhdGHAXQAA"
    تکرار ۴۰۰: موج += "oKCgoKCgoKCgoGBgYGBgYGBgYGCgoKCgoKCgoKCgYGBgYGBgYGBgYKCgoKCgoKCgoKBgYGBgYGBgYGBg" پایان
    برگشت موج
پایان

تابع تعویض():
    پخش کننده := دام.با شناسه("sound")
    اگر دام.دریافت ویژگی(پخش کننده، "src") برابر "":
        دام.تنظیم ویژگی(پخش کننده، "src"، صدا())
    پایان
    اگر دام.دریافت خاصیت منطقی(پخش کننده، "paused"):
        _ := دام.فراخوان(پخش کننده، "play")
    وگرنه:
        _ := دام.فراخوان(پخش کننده، "pause")
    پایان
پایان

تابع پیشرفت():
    پخش کننده := دام.با شناسه("sound")
    اکنون := دام.دریافت خاصیت عددی(پخش کننده، "currentTime")
    دام.تنظیم سبک(دام.با شناسه("fill")، "width"، اکنون * ۱۰۰.۰ / دام.دریافت خاصیت عددی(پخش کننده، "duration") + "%")
    دام.تنظیم متن(دام.با شناسه("time")، دام.فراخوان یک(دام.سراسری("Math")، "floor"، اکنون) + " ثانیه از 3 ثانیه")
پایان

تابع بلندی():
    دام.تنظیم خاصیت عددی(دام.با شناسه("sound")، "volume"، دام.دریافت خاصیت عددی(دام.با شناسه("level")، "valueAsNumber") / ۱۰۰.۰)
پایان

تابع نمایش صدا():
    درصد := دام.فراخوان یک(دام.سراسری("Math")، "round"، دام.دریافت خاصیت عددی(دام.با شناسه("sound")، "volume") * ۱۰۰.۰)
    دام.تنظیم متن(دام.با شناسه("say")، "صدا " + درصد + " درصد")
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 بیشینه عرض = 360 پایان
    صدا: شناسه = "sound" پیش‌بارگذاری = "none" پخش = (): دام.تنظیم متن(دام.با شناسه("go")، "مکث") پایان
        مکث = (): دام.تنظیم متن(دام.با شناسه("go")، "پخش") پایان به‌روزرسانی زمان = پیشرفت تغییر صدا = نمایش صدا
    پایان
    جعبه: نمایش = فلکس شکاف = 12 ترازعمودی = وسط
        دکمه: شناسه = "go" کلیک = تعویض محتوا = "پخش" عرض = 70 پایان
        جعبه: فلکس = 1 ارتفاع = 8 پس زمینه = "#e2e8f0" گردی کادر = 4
            جعبه: شناسه = "fill" عرض = "0%" ارتفاع = 8 پس زمینه = "#7c3aed" گردی کادر = 4 پایان
        پایان
    پایان
    پاراگراف: شناسه = "time" محتوا = "0 ثانیه از 3 ثانیه" پایان
    جعبه: نمایش = فلکس شکاف = 12 ترازعمودی = وسط
        ورودی: شناسه = "level" نوع = بازه کمینه = 0 بیشینه = 100 مقدار = 100 ورودی = بلندی پایان
        تکه: شناسه = "say" محتوا = "صدا 100 درصد" پایان
    پایان
پایان
