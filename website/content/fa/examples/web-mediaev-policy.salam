واردسازی دام

تابع ممنوع(رویداد: صحیح۶۴):
    چه چیزی := دام.دریافت خاصیت رشته ای(رویداد، "blockedURI")
    قاعده := دام.دریافت خاصیت رشته ای(رویداد، "violatedDirective")
    دام.تنظیم متن(دام.با شناسه("log")، "مسدود شد: " + چه چیزی + " (" + قاعده + ")")
پایان

تابع نوشتن‌ویژگی():
    دام.تنظیم ویژگی(دام.با شناسه("card")، "style"، "background: gold")
پایان

تابع سبک‌دهی():
    دام.تنظیم سبک(دام.با شناسه("card")، "background"، "lightgreen")
    دام.تنظیم متن(دام.با شناسه("log")، "تنظیم سبک کار کرد.")
پایان

صفحه:
    متا: معادل اچ‌تی‌تی‌پی = "Content-Security-Policy" محتوا = "style-src-attr 'none'" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    جعبه: شناسه = "card" نقض سیاست امنیتی = ممنوع فاصله = 20 گردی کادر = 8 پس زمینه = "#e2e8f0"
        محتوا = "سیاست این صفحه ویژگی style را برای این کارت ممنوع کرده است."
    پایان
    جعبه: نمایش = فلکس شکاف = 8 فضا بالا = 12
        دکمه: کلیک = نوشتن‌ویژگی محتوا = "ویژگی style را بنویس" پایان
        دکمه: کلیک = سبک‌دهی محتوا = "از تنظیم سبک استفاده کن" پایان
    پایان
    پاراگراف: شناسه = "log" محتوا = "هنوز نقضی رخ نداده." پایان
پایان
