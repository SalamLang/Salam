واردسازی دام

ناپایا اعضا := ۰ برگردان صحیح۶۴

تابع تغییر‌کرد(رویداد: صحیح۶۴):
    گره ها := دام.فراخوان(دام.هدف رویداد(رویداد)، "assignedNodes")
    دام.تنظیم متن(دام.با شناسه("log")، "تغییر شکاف: " + دام.دریافت خاصیت عددی(گره ها، "length") + " مورد در شکاف")
پایان

تابع بپیوند():
    اعضا += ۱
    فرد := دام.بساز("p")
    دام.تنظیم متن(فرد، "عضو " + اعضا)
    دام.افزودن(دام.با شناسه("team")، فرد)
پایان

صفحه:
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    جعبه: شناسه = "team" فاصله = "4px 16px" پس زمینه = "#f5f3ff" کادر = "2px solid #7c3aed" گردی کادر = 8
        قالب: حالت ریشه سایه = "open"
            سرتیتر: اندازه = 3 محتوا = "تیم" پایان
            جایگاه: تغییر شکاف = تغییر‌کرد پایان
        پایان
    پایان
    دکمه: کلیک = بپیوند محتوا = "افزودن یک عضو" فضا بالا = 12 پایان
    پاراگراف: شناسه = "log" محتوا = "هنوز چیزی در شکاف نیست." پایان
پایان
