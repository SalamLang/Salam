واردسازی دام

ناپایا خط ها := ""
ناپایا وصل شده := نادرست

تابع ثبت(نوع: رشته، رویداد: صحیح۶۴):
    خط ها = خط ها + نوع + ": " + دام.دریافت خاصیت رشته ای(رویداد، "propertyName") + "\n"
    دام.تنظیم متن(دام.با شناسه("log")، خط ها)
پایان

تابع تمام‌شد(رویداد: صحیح۶۴):
    ثبت("پایان"، رویداد)
پایان

تابع اتصال():
    اگر وارونه وصل شده:
        وصل شده = درست
        مهره := دام.با شناسه("chip")
        دام.هنگام رویداد جزئی(مهره، "transitionrun"، (رویداد: صحیح۶۴): ثبت("اجرا"، رویداد) پایان)
        دام.هنگام رویداد جزئی(مهره، "transitionstart"، (رویداد: صحیح۶۴): ثبت("شروع"، رویداد) پایان)
        دام.هنگام رویداد جزئی(مهره، "transitioncancel"، (رویداد: صحیح۶۴): ثبت("لغو"، رویداد) پایان)
    پایان
پایان

تابع جابجایی():
    اتصال()
    خط ها = ""
    دام.تعویض کلاس(دام.با شناسه("chip")، "moved")
پایان

تابع رفت‌وبرگشت():
    جابجایی()
    دام.تنظیم مهلت((): دام.تعویض کلاس(دام.با شناسه("chip")، "moved") پایان، ۱۵۰)
پایان

صفحه:
    ظاهر سفارشی: محتوا = ".moved { transform: translateX(-180px) }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    جعبه: عرض = 240 فاصله = "10px 0"
        جعبه: شناسه = "chip" عرض = 50 ارتفاع = 40 گردی کادر = 8 پس زمینه = "#2563eb"
            گذار = "transform 0.4s 0.3s" اتمام گذار = تمام‌شد
        پایان
    پایان
    جعبه: نمایش = فلکس شکاف = 8
        دکمه: کلیک = جابجایی محتوا = "حرکت بده" پایان
        دکمه: کلیک = رفت‌وبرگشت محتوا = "حرکت بده و پس بگیر" پایان
    پایان
    پاراگراف: شناسه = "log" فضای سفید = "pre-wrap" محتوا = "" پایان
پایان
