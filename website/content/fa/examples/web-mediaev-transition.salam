واردسازی دام

ناپایا سطرها := ""
ناپایا سیم‌کشی‌شده := نادرست

تابع ثبت(نوع: رشته، e: صحیح۶۴):
    سطرها = سطرها + نوع + ": " + دام.دریافت خاصیت رشته ای(e، "propertyName") + "\n"
    دام.تنظیم متن(دام.با شناسه("log")، سطرها)
پایان

تابع سیم‌کشی:
    اگر وارونه سیم‌کشی‌شده:
        سیم‌کشی‌شده = درست
        تراشه := دام.با شناسه("chip")
        دام.هنگام رویداد جزئی(تراشه، "transitionrun"، (e: صحیح۶۴): ثبت("اجرا"، e) پایان)
        دام.هنگام رویداد جزئی(تراشه، "transitionstart"، (e: صحیح۶۴): ثبت("شروع"، e) پایان)
        دام.هنگام رویداد جزئی(تراشه، "transitioncancel"، (e: صحیح۶۴): ثبت("لغو"، e) پایان)
    پایان
پایان

بخش جابه‌جاکننده:
    جابه‌جا := نادرست
    جعبه:
        قلم = سیستمی، ساده
        فضا = 24
        جعبه:
            عرض = 240
            فاصله = 10، 0
            جعبه:
                شناسه = "chip"
                عرض = 50
                ارتفاع = 40
                گردی = 8
                پس‌زمینه = #2563eb
                جابه‌جایی = 0، 0
                گذار = 400ms
                اگر جابه‌جا:
                    جابه‌جایی = 180، 0
                پایان
                اتمام گذار = (e: صحیح۶۴): ثبت("پایان"، e) پایان
            پایان
        پایان
        جعبه:
            چیدمان = ردیف
            شکاف = 8
            دکمه:
                کلیک = ():
                    سیم‌کشی()
                    سطرها = ""
                    جابه‌جا = جابه‌جا برابر نادرست
                پایان
                محتوا = "حرکت بده"
            پایان
            دکمه:
                کلیک = ():
                    سیم‌کشی()
                    سطرها = ""
                    جابه‌جا = جابه‌جا برابر نادرست
                    دام.تنظیم مهلت((): جابه‌جا = جابه‌جا برابر نادرست پایان، 150)
                پایان
                محتوا = "حرکت بده و برگردان"
            پایان
        پایان
        پاراگراف:
            شناسه = "log"
            فضای سفید = حفظ
            محتوا = ""
        پایان
    پایان
پایان

صفحه:
    عنوان = "رویدادهای گذار"
    جابه‌جاکننده: پایان
پایان
