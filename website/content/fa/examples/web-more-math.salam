صفحه:
    عنوان = "سبک‌های ریاضی"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ارتفاع خط = 1.8 پایان
    سراسری: گزینشگر = "math" اندازه قلم = "1.6rem" فضا = "0 1.5rem 0 0" پایان
    پاراگراف: محتوا = "سبک ریاضی: عادی، سپس فشرده" پایان
    جعبه: نمایش = flex
        ریاضی: سبک ریاضی = normal
            محتوا = "<munderover><mo>&#x2211;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><mi>i</mi></mfrac>"
        پایان
        ریاضی: سبک ریاضی = compact
            محتوا = "<munderover><mo>&#x2211;</mo><mrow><mi>i</mi><mo>=</mo><mn>1</mn></mrow><mi>n</mi></munderover><mfrac><mn>1</mn><mi>i</mi></mfrac>"
        پایان
    پایان
    ظاهر سفارشی: محتوا = "#d0, #d1, #d2 { font-size: math }" پایان
    پاراگراف: محتوا = "عمق ریاضی ۰ و ۱ و ۲ در کنار هم" پایان
    جعبه: نمایش = flex ترازعمودی = baseline اندازه قلم = "3rem"
        ریاضی: شناسه = "d0" عمق ریاضی = 0 محتوا = "<mi>x</mi><mo>+</mo><mn>1</mn>" پایان
        ریاضی: شناسه = "d1" عمق ریاضی = 1 محتوا = "<mi>x</mi><mo>+</mo><mn>1</mn>" پایان
        ریاضی: شناسه = "d2" عمق ریاضی = 2 محتوا = "<mi>x</mi><mo>+</mo><mn>1</mn>" پایان
    پایان
