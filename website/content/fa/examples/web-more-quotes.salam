صفحه:
    عنوان = "گیومه‌ها"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ارتفاع خط = 1.8 پایان
    پاراگراف: نقل قول‌ها = `"«" "»" "‹" "›"`
        محتوا = "سارا گفت: "
        نقل قول: محتوا = "امید به من گفت: "
            نقل قول: محتوا = "هرگز نایست" پایان
        پایان
        تکه: محتوا = "." پایان
    پایان
    پاراگراف: نقل قول‌ها = `"“" "”" "‘" "’"`
        محتوا = "همان جمله با نشانه‌های دیگر: "
        نقل قول: محتوا = "امید به من گفت: "
            نقل قول: محتوا = "هرگز نایست" پایان
        پایان
    پایان
    نقل قول بلند: نقل قول‌ها = "none" کادر = "none" فضا = "1rem 0" رنگ = "#475569"
        محتوا = "بدون گیومه."
    پایان
    نقل قول بلند: نقل قول‌ها = `"[" "]"` رنگ = "#0f766e"
        پیش‌از محتوای تولیدی = open-quote
        پس‌از محتوای تولیدی = close-quote
        محتوا = "با open-quote و close-quote افزوده شده."
    پایان
پایان
