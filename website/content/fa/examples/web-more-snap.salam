صفحه:
    عنوان = "برگه‌های چسبنده"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ارتفاع خط = 1.8 پایان
    سراسری: گزینشگر = "#strip > *" فلکس = "0 0 80%" ارتفاع = 120 رنگ = white اندازه قلم = "1.6rem" نمایش = flex ترازعمودی = center چینش = center گردی کادر = 12 تراز چسبیدن پیمایش = start توقف چسبیدن پیمایش = always پایان
    ظاهر سفارشی: محتوا = "#strip::scroll-marker-group { display: flex; gap: 8px; justify-content: center; padding: 8px } #strip > *::scroll-marker { content: ''; width: 10px; height: 10px; border-radius: 50%; background: #94a3b8 } #strip > *::scroll-marker:target-current { background: #0f766e }" پایان
    جعبه: شناسه = "strip" نمایش = flex شکاف = 12 سرریز افقی = auto فاصله = "0 20" نوع چسبیدن پیمایش = "x mandatory" فاصله پیمایش = "0 20" گروه نشانگر پیمایش = after
