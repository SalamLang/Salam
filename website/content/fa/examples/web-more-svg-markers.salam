صفحه:
    عنوان = "نشانگر روی خط"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ارتفاع خط = 1.8 پایان
    اس‌وی‌جی: عرض = 0 ارتفاع = 0 موقعیت = absolute
        محتوا = "<defs><marker id='start' viewBox='0 0 10 10' refX='5' refY='5' markerWidth='6' markerHeight='6'><circle cx='5' cy='5' r='5' fill='#2563eb'/></marker><marker id='mid' viewBox='0 0 10 10' refX='5' refY='5' markerWidth='5' markerHeight='5'><rect width='10' height='10' fill='#f59e0b'/></marker><marker id='end' viewBox='0 0 10 10' refX='8' refY='5' markerWidth='8' markerHeight='8' orient='auto'><path d='M0 0 L10 5 L0 10 z' fill='#dc2626'/></marker></defs>"
    پایان
    اس‌وی‌جی: جعبه دید = "0 0 300 120" عرض = 300 ارتفاع = 120 پرکردن = none خط دور = "#0f766e" ضخامت خط دور = 3 نشانگر آغاز = "url(#start)" نشانگر میانه = "url(#mid)" نشانگر انتها = "url(#end)"
        محتوا = "<polyline points='20,90 100,30 180,80 270,30'/>"
    پایان
    پاراگراف: محتوا = "یک نقطه در آغاز، مربع‌ها در گوشه‌ها و یک پیکان در پایان." پایان
