صفحه:
    عنوان = "ایست‌های شیب و پالایه‌ها"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ارتفاع خط = 1.8 پایان
    سراسری: گزینشگر = ".s1" رنگ ایست = "#0f766e" شفافیت ایست = 1 پایان
    سراسری: گزینشگر = ".s2" رنگ ایست = "#2563eb" شفافیت ایست = 0.25 پایان
    سراسری: گزینشگر = ".tint" رنگ سیل = "#7c3aed" شفافیت سیل = 0.5 پایان
    سراسری: گزینشگر = "filter" میان‌یابی رنگ پالایه = sRGB پایان
    اس‌وی‌جی: جعبه دید = "0 0 220 120" عرض = 220 ارتفاع = 120
        محتوا = "<defs><linearGradient id='g' x1='0' x2='1'><stop class='s1' offset='0'/><stop class='s2' offset='1'/></linearGradient><filter id='f'><feFlood class='tint' result='c'/><feComposite in='c' in2='SourceGraphic' operator='in' result='t'/><feMerge><feMergeNode in='SourceGraphic'/><feMergeNode in='t'/></feMerge></filter></defs><rect x='5' y='10' width='100' height='100' rx='10' fill='url(#g)'/><rect x='115' y='10' width='100' height='100' rx='10' fill='#38bdf8' filter='url(#f)'/>"
    پایان
    پاراگراف: محتوا = "چپ: شیبی که رنگ ایست‌هایش با CSS داده شده. راست: پالایه‌ای که رنگ سیلش از CSS می‌آید." پایان
پایان
