صفحه:
    عنوان = "پرکردن و خط دور"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ارتفاع خط = 1.8 پایان
    جعبه: نمایش = flex شکاف = 24 پیچش آرایش = wrap
        جعبه:
            اس‌وی‌جی: جعبه دید = "0 0 100 100" عرض = 120 ارتفاع = 120 پرکردن = "#5eead4" شفافیت پرکردن = 0.6 قاعده پرکردن = evenodd خط دور = "#0f766e" ضخامت خط دور = 3 اتصال خط دور = round
                محتوا = "<polygon points='50,5 80,95 5,35 95,35 20,95'/>"
            پایان
            پاراگراف: محتوا = "پرکردن زوج و فرد" پایان
        پایان
        جعبه:
            اس‌وی‌جی: جعبه دید = "0 0 100 100" عرض = 120 ارتفاع = 120 پرکردن = none خط دور = "#c2410c" ضخامت خط دور = 8 سر خط دور = round الگوی خط‌چین خط دور = "1 14" فاصله خط‌چین = 4
                محتوا = "<circle cx='50' cy='50' r='38'/>"
            پایان
            پاراگراف: محتوا = "خط نقطه‌چین" پایان
        پایان
        جعبه:
            اس‌وی‌جی: جعبه دید = "0 0 100 100" عرض = 120 ارتفاع = 120 پرکردن = none خط دور = "#2563eb" ضخامت خط دور = 14 اتصال خط دور = miter حد گوشه خط دور = 2
                محتوا = "<polyline points='15,85 50,15 85,85'/>"
            پایان
            پاراگراف: محتوا = "گوشه‌ی تیز که حد آن را می‌برد" پایان
        پایان
    پایان
