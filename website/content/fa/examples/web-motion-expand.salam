واردسازی دام

ناپایا باز := نادرست

تابع تعویض():
    باز = وارونه باز
    اگر باز:
        دام.تنظیم سبک(دام.با شناسه("panel"), "height", "auto")
    وگرنه:
        دام.تنظیم سبک(دام.با شناسه("panel"), "height", "0")
    پایان
پایان

