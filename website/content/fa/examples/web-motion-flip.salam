واردسازی دام

ناپایا برگشته := نادرست

تابع برگرداندن():
    برگشته = وارونه برگشته
    اگر برگشته:
        دام.تنظیم سبک(دام.با شناسه("card"), "transform", "rotateY(180deg)")
    وگرنه:
        دام.تنظیم سبک(دام.با شناسه("card"), "transform", "rotateY(0deg)")
    پایان
پایان

