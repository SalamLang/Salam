صفحه:
    عنوان = "حرکت روی مسیر"
    سبک: محتوا = "@keyframes drive { to { offset-distance: 100% } }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 30 پایان
    جعبه:
        ارتفاع = 130
        عرض = 260
        فاصله = "40 0 0 20"
        اندازه جعبه = "border-box"
        کادر = "1px dashed #94a3b8"
        جعبه:
            عرض = 28
            ارتفاع = 20
            پس زمینه = "#f59e0b"
            مسیر برش = "polygon(0 0, 100% 50%, 0 100%)"
            مسیر حرکت = "path('M 0 40 C 60 -40, 120 120, 200 40')"
            چرخش مسیر = auto
            پویانمایی = "drive 3s ease-in-out infinite alternate"
        پایان
    پایان
پایان
