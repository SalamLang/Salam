واردسازی دام

ناپایا روان := درست

تابع تعویض():
    روان = وارونه روان
    اگر روان:
        دام.تنظیم سبک(دام.با شناسه("ring"), "animation-play-state", "running")
        دام.تنظیم متن(دام.با شناسه("btn"), "توقف")
    وگرنه:
        دام.تنظیم سبک(دام.با شناسه("ring"), "animation-play-state", "paused")
        دام.تنظیم متن(دام.با شناسه("btn"), "ادامه")
    پایان
پایان

صفحه:
    عنوان = "توقف پویانمایی"
    سبک: محتوا = "@keyframes spin { to { transform: rotate(1turn) } }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 30 پایان
    جعبه:
        شناسه = "ring"
        عرض = 48
        ارتفاع = 48
        کادر = "6px solid #e2e8f0"
        رنگ کادر بالا = "#be123c"
        گردی کادر = "50%"
        پویانمایی = "spin 1.2s linear infinite"
    پایان
    دکمه: شناسه = "btn" فضا بالا = 16 کلیک = تعویض محتوا = "توقف" پایان
پایان
