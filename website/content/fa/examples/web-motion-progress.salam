صفحه:
    عنوان = "نوار پیشرفت خواندن"
    سبک: محتوا = "@keyframes fill { from { transform: scaleX(0) } to { transform: scaleX(1) } }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 0 ارتفاع خط = 1.9 پایان
    جعبه:
        موقعیت = fixed
        بالا = 0
        چپ = 0
        عرض = "100%"
        ارتفاع = 6
        پس زمینه = "#0f766e"
        مبدا دگرگونی = "0 50%"
        نام پویانمایی = fill
        تابع زمان‌بندی پویانمایی = linear
        خط زمان پویانمایی = "scroll()"
    پایان
    جعبه:
        فاصله = 24
        سرتیتر: اندازه = 2 محتوا = "پایین بروید" پایان
        پاراگراف: تکرار = 14 محتوا = "نوار بالای صفحه با جای پیمایش بزرگ می‌شود. هیچ برنامه‌ای پیمایش را نمی‌خواند، مرورگر پویانمایی را به آن وصل می‌کند." پایان
