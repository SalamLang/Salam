صفحه:
    عنوان = "احترام به کاهش حرکت"
    سبک: محتوا = "@keyframes pulse { 50% { transform: scale(1.25); opacity: 0.6 } } @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important } }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 30 پایان
    جعبه:
        عرض = 40
        ارتفاع = 40
        گردی کادر = "50%"
        پس زمینه = "#be123c"
        پویانمایی = "pulse 1.2s ease-in-out infinite"
    پایان
    پاراگراف: محتوا = "این نقطه می‌تپد، مگر اینکه دستگاه شما کاهش حرکت را خواسته باشد." پایان
پایان
