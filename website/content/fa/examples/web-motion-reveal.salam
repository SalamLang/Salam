صفحه:
    عنوان = "نمایان شدن با پیمایش"
    سبک: محتوا = "@keyframes show { from { opacity: 0; transform: translateY(30px) } to { opacity: 1; transform: none } }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 24 پایان
    سرتیتر: اندازه = 2 محتوا = "پایین بروید" پایان
    جعبه:
        ارتفاع = 160
        فضا = "0 0 40"
        فاصله = 16
        پس زمینه = "#e0f2fe"
        گردی کادر = 10
        نام پویانمایی = show
        تابع زمان‌بندی پویانمایی = linear
        حالت پرکردن پویانمایی = both
        خط زمان پویانمایی = "view()"
        بازه پویانمایی = "entry 0% entry 100%"
        تکرار = 6
        محتوا = "همین که وارد صفحه می‌شوم کم‌کم پیدا می‌شوم"
    پایان
