صفحه:
    عنوان = "گذار نما"
    سبک: محتوا = ".wide { width: 240px !important; height: 100px !important; background: #f59e0b !important } ::view-transition-group(tile) { animation-duration: 500ms }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 30 پایان
    جعبه:
        شناسه = "tile"
        عرض = 80
        ارتفاع = 80
        پس زمینه = "#0f766e"
        گردی کادر = 12
        نام گذار نما = tile
    پایان
    دکمه: فضا بالا = 16 کلیک = "var f = function () { document.getElementById('tile').classList.toggle('wide') }; if (document.startViewTransition) { document.startViewTransition(f) } else { f() }" محتوا = "تغییر شکل" پایان
