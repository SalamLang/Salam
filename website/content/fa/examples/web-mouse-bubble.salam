واردسازی دام

تابع بیرونی(رخداد: صحیح۶۴):
    کی := دام.دریافت ویژگی(دام.هدف رویداد(رخداد)، "id")
    دام.تنظیم متن(دام.با شناسه("log")، "جعبه‌ی بیرونی کلیکی از این عنصر شنید: " + کی)
پایان

تابع ایستا(رخداد: صحیح۶۴):
    دام.توقف انتشار(رخداد)
    دام.تنظیم متن(دام.با شناسه("log")، "دکمه‌ی توقف‌دهنده کلیک را برای خودش نگه داشت.")
پایان

صفحه:
    عنوان = "حباب شدن رویداد"
    قلم = "Tahoma"، سیستمی، ساده
    فضا = 1.5rem
    جعبه:
        شناسه = "outer-box"
        کلیک = بیرونی
        فاصله = 20
        پس‌زمینه = #ede9fe
        گردی = 10
        پاراگراف:
            محتوا = "جعبه‌ی بیرونی"
            فضا = 0، 0، 10px، 0
        پایان
        دکمه:
            فاصله = 8px، 14px
            فضا = 0، 0، 0، 8px
            اندازه قلم = 1rem
            شناسه = "plain"
            محتوا = "دکمه‌ی ساده"
        پایان
        دکمه:
            فاصله = 8px، 14px
            فضا = 0، 0، 0، 8px
            اندازه قلم = 1rem
            شناسه = "stopper"
            کلیک = ایستا
            محتوا = "دکمه‌ی توقف‌دهنده"
        پایان
        تکه:
            شناسه = "label"
            محتوا = "یا این نوشته"
        پایان
    پایان
    پاراگراف:
        شناسه = "log"
        محتوا = "روی چیزی کلیک کنید."
    پایان
پایان
