واردسازی دام

ناپایا تاریخچه := ""
ناپایا سطرها := 0

تابع یادداشت(متن: رشته):
    سطرها += 1
    اگر سطرها بزرگتر 7:
        تاریخچه = ""
        سطرها = 1
    پایان
    تاریخچه = تاریخچه + متن + "\n"
    دام.تنظیم متن(دام.با شناسه("log")، تاریخچه)
پایان

تابع کمکی(رخداد: صحیح۶۴):
    یادداشت("کلیک کمکی، دکمه‌ی " + (دام.دریافت خاصیت عددی(رخداد، "button") برگردان صحیح۶۴))
پایان

تابع زمینه(رخداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رخداد)
    یادداشت("منوی زمینه (منوی خود مرورگر بسته شد)")
پایان

صفحه:
    عنوان = "انواع کلیک"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        شناسه = "pad"
        کلیک = (): یادداشت("کلیک") پایان
        دو کلیک = (): یادداشت("دو کلیک") پایان
        کلیک کمکی = کمکی
        منوی زمینه = زمینه
        محتوا = "اینجا کلیک کنید، دو کلیک کنید، با دکمه‌ی وسط یا راست کلیک کنید"
        فاصله = 28
        پس زمینه = "#e0f2fe"
        گردی کادر = 10
        انتخاب کاربر = هیچ
    پایان
    پاراگراف: شناسه = "log" محتوا = "هنوز چیزی نشده." فضای سفید = "pre-line" کمینه ارتفاع = "10em" پایان
پایان
