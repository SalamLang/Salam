واردسازی دام

تابع حرکت(رخداد: صحیح۶۴):
    زمین := دام.با شناسه("pad")
    مستطیل := دام.فراخوان(زمین، "getBoundingClientRect")
    ایکس := (دام.رویداد افقی(رخداد) - دام.دریافت خاصیت عددی(مستطیل، "left")) برگردان صحیح۶۴
    ایگرگ := (دام.رویداد عمودی(رخداد) - دام.دریافت خاصیت عددی(مستطیل، "top")) برگردان صحیح۶۴
    دام.تنظیم متن(دام.با شناسه("pos")، "x " + ایکس + "، y " + ایگرگ)
    نقطه := دام.با شناسه("dot")
    دام.تنظیم سبک(نقطه، "left"، "" + ایکس + "px")
    دام.تنظیم سبک(نقطه، "top"، "" + ایگرگ + "px")
پایان

صفحه:
    عنوان = "مکان اشاره‌گر"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        شناسه = "pad"
        حرکت ماوس = حرکت
        موقعیت = نسبی
        ارتفاع = 180
        پس زمینه = "#ecfccb"
        گردی کادر = 10
        نشانگر = نشانه‌گیر
        سرریز = پنهان
        جعبه: شناسه = "dot" موقعیت = مطلق عرض = 12 ارتفاع = 12 فضا = "-6px 0 0 -6px" گردی کادر = "50%" پس زمینه = "#15803d" رویدادهای اشاره‌گر = هیچ پایان
    پایان
    پاراگراف: شناسه = "pos" محتوا = "ماوس را روی ناحیه‌ی سبز حرکت دهید." پایان
پایان
