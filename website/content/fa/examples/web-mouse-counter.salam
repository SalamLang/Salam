واردسازی دام

ناپایا شمار := 0

تابع نوشتن:
    دام.تنظیم متن(دام.با شناسه("n")، "" + شمار)
پایان

صفحه:
    عنوان = "شمارنده‌ی کلیک"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ترازمتن = وسط پایان
    سرتیتر: شناسه = "n" اندازه = 1 محتوا = "0" اندازه قلم = "4rem" فضا = "0 0 12px 0" پایان
    دکمه: شناسه = "plus" کلیک = (): شمار += 1 نوشتن() پایان محتوا = "+۱" فاصله = "8px 18px" اندازه قلم = "1.1rem" پایان
    دکمه: شناسه = "reset" کلیک = (): شمار = 0 نوشتن() پایان محتوا = "از نو" فاصله = "8px 18px" اندازه قلم = "1.1rem" فضا = "0 8px 0 0" پایان
پایان
