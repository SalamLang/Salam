واردسازی دام

ناپایا میکشد := نادرست

تابع شروع(رخداد: صحیح۶۴):
    میکشد = درست
    کشیدن(رخداد)
پایان

تابع توقف:
    میکشد = نادرست
پایان

تابع کشیدن(رخداد: صحیح۶۴):
    اگر میکشد:
        مستطیل := دام.فراخوان(دام.با شناسه("board")، "getBoundingClientRect")
        نقطه := دام.بساز("div")
        دام.تنظیم ویژگی(نقطه، "class"، "dot")
        دام.تنظیم سبک(نقطه، "left"، "" + (دام.رویداد افقی(رخداد) - دام.دریافت خاصیت عددی(مستطیل، "left")) + "px")
        دام.تنظیم سبک(نقطه، "top"، "" + (دام.رویداد عمودی(رخداد) - دام.دریافت خاصیت عددی(مستطیل، "top")) + "px")
        دام.افزودن(دام.با شناسه("board")، نقطه)
    پایان
پایان

تابع پاکسازی:
    دام.تنظیم اچ تی ام ال(دام.با شناسه("board")، "")
پایان

صفحه:
    عنوان = "نقاشی"
    ظاهر سفارشی: محتوا = ".dot { position: absolute; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: #7c3aed; pointer-events: none }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        شناسه = "board"
        فشردن ماوس = شروع
        حرکت ماوس = کشیدن
        رها کردن ماوس = توقف
        خروج ماوس = توقف
        موقعیت = نسبی
        ارتفاع = 200
        پس زمینه = "#faf5ff"
        کادر = "2px dashed #c4b5fd"
        گردی کادر = 10
        نشانگر = نشانه‌گیر
        سرریز = پنهان
        انتخاب کاربر = هیچ
    پایان
    دکمه: شناسه = "clear" کلیک = پاکسازی محتوا = "پاک کن" فضا = "10px 0 0 0" فاصله = "6px 14px" پایان
پایان
