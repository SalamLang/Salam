                    رنگ = "سفید"
                    گردی = 8
                    تراز متن = "وسط"
                    محتوا = "درونی"
                پایان
            پایان
            پاراگراف:
                شناسه = "count-a"
                محتوا = "ورود 0، خروج 0"
            پایان
        پایان
        جعبه:
