واردسازی دام

ناپایا ورودها := 0
ناپایا خروجها := 0
ناپایا عبورها := 0
ناپایا بیرونرفتنها := 0

تابع نوشتنالف:
    دام.تنظیم متن(دام.با شناسه("count-a")، "ورود " + ورودها + "، خروج " + خروجها)
پایان

تابع نوشتنب:
    دام.تنظیم متن(دام.با شناسه("count-b")، "عبور " + عبورها + "، بیرون رفتن " + بیرونرفتنها)
پایان

صفحه:
    عنوان = "ورود و خروج"
    قلم = "Tahoma"، "سیستمی"، "ساده"
    فضا = 1.5rem
    جعبه:
        چیدمان = "ردیف"
        شکاف = 24
        پیچش = درست
        جعبه:
            سرتیتر:
                اندازه = 3
                محتوا = "ورود و خروج"
                فضا = 0، 0، 8px، 0
            پایان
            جعبه:
                شناسه = "a"
                کلاس = "zone"
                ارتفاع = 90
                عرض = 220
                پس‌زمینه = "#dbeafe"
