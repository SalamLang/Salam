واردسازی دام

ناپایا ورودها := 0
ناپایا خروجها := 0
ناپایا عبورها := 0
ناپایا بیرونرفتنها := 0

تابع نوشتنالف:
    دام.تنظیم متن(دام.با شناسه("count-a")، "ورود " + ورودها + "، خروج " + خروجها)
پایان

تابع نوشتنب:
    دام.تنظیم متن(دام.با شناسه("count-b")، "عبور " + عبورها + "، بیرون رفتن " + بیرونرفتنها)
پایان

صفحه:
    عنوان = "ورود و خروج"
    سراسری: گزینشگر = "body" قلم = "Tahoma"، سیستمی، ساده فضا = 1.5rem پایان
    سراسری: گزینشگر = ".zone" ارتفاع = 90 عرض = 220 پس‌زمینه = #dbeafe گردی = 10 فاصله = 10 پایان
    سراسری: گزینشگر = ".inner" موقعیت = مطلق چپ = 10 بالا = 10 عرض = 70 ارتفاع = 70 پس‌زمینه = #2563eb رنگ = سفید گردی = 8 تراز متن = وسط پایان
    جعبه:
        چیدمان = ردیف
        شکاف = 24
        پیچش = درست
        جعبه:
            سرتیتر: اندازه = 3 محتوا = "ورود و خروج" فضا = 0، 0، 8px، 0 پایان
            جعبه:
                شناسه = "a" کلاس = "zone" محتوا = "بیرونی"
                ورود ماوس = (): ورودها++ نوشتنالف() پایان
                خروج ماوس = (): خروجها++ نوشتنالف() پایان
                جعبه: شناسه = "a-inner" کلاس = "inner" محتوا = "درونی" پایان
            پایان
            پاراگراف: شناسه = "count-a" محتوا = "ورود 0، خروج 0" پایان
        پایان
        جعبه:
            سرتیتر: اندازه = 3 محتوا = "عبور و بیرون رفتن" فضا = 0، 0، 8px، 0 پایان
            جعبه:
                شناسه = "b" کلاس = "zone" محتوا = "بیرونی"
                عبور ماوس = (): عبورها++ نوشتنب() پایان
                بیرون رفتن ماوس = (): بیرونرفتنها++ نوشتنب() پایان
                جعبه: شناسه = "b-inner" کلاس = "inner" محتوا = "درونی" پایان
            پایان
            پاراگراف: شناسه = "count-b" محتوا = "عبور 0، بیرون رفتن 0" پایان
        پایان
    پایان
