واردسازی دام

ناپایا ورودها := 0
ناپایا خروجها := 0
ناپایا عبورها := 0
ناپایا بیرونرفتنها := 0

تابع نوشتنالف:
    دام.تنظیم متن(دام.با شناسه("count-a")، "ورود " + ورودها + "، خروج " + خروجها)
پایان

تابع نوشتنب:
    دام.تنظیم متن(دام.با شناسه("count-b")، "عبور " + عبورها + "، بیرون رفتن " + بیرونرفتنها)
پایان

صفحه:
    عنوان = "ورود و خروج"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    سراسری: گزینشگر = ".zone" موقعیت = نسبی ارتفاع = 90 عرض = 220 پس زمینه = "#dbeafe" گردی کادر = 10 فاصله = 10 اندازه جعبه = "border-box" پایان
    سراسری: گزینشگر = ".inner" موقعیت = مطلق چپ = 10 بالا = 10 عرض = 70 ارتفاع = 70 پس زمینه = "#2563eb" رنگ = سفید گردی کادر = 8 ترازمتن = وسط پایان
    جعبه:
        نمایش = فلکس
        شکاف = 24
        پیچش آرایش = پیچیده
        جعبه:
            سرتیتر: اندازه = 3 محتوا = "ورود و خروج" فضا = "0 0 8px 0" پایان
            جعبه:
                شناسه = "a" کلاس = "zone" محتوا = "بیرونی"
                ورود ماوس = (): ورودها += 1 نوشتنالف() پایان
                خروج ماوس = (): خروجها += 1 نوشتنالف() پایان
                جعبه: شناسه = "a-inner" کلاس = "inner" محتوا = "درونی" پایان
            پایان
            پاراگراف: شناسه = "count-a" محتوا = "ورود 0، خروج 0" پایان
        پایان
        جعبه:
            سرتیتر: اندازه = 3 محتوا = "عبور و بیرون رفتن" فضا = "0 0 8px 0" پایان
            جعبه:
                شناسه = "b" کلاس = "zone" محتوا = "بیرونی"
                عبور ماوس = (): عبورها += 1 نوشتنب() پایان
                بیرون رفتن ماوس = (): بیرونرفتنها += 1 نوشتنب() پایان
                جعبه: شناسه = "b-inner" کلاس = "inner" محتوا = "درونی" پایان
            پایان
            پاراگراف: شناسه = "count-b" محتوا = "عبور 0، بیرون رفتن 0" پایان
        پایان
    پایان
پایان
