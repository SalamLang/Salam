واردسازی دام

ناپایا تعداد := 0

تابع نامدار():
    تعداد++
    دام.تنظیم متن(دام.با شناسه("out")، "تابع نام‌دار، کلیک " + تعداد)
پایان

تابع بارخداد(رخداد: صحیح۶۴):
    دام.تنظیم متن(
        دام.با شناسه("out")، "تابع با رویداد، مکان اشاره‌گر در x برابر " + دام.رویداد افقی(رخداد)
    )
پایان

