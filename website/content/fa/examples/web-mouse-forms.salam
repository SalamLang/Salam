واردسازی دام

ناپایا تعداد := 0

تابع نامدار():
    تعداد += 1
    دام.تنظیم متن(دام.با شناسه("out")، "تابع نام‌دار، کلیک " + تعداد)
پایان

تابع بارخداد(رخداد: صحیح۶۴):
    دام.تنظیم متن(دام.با شناسه("out")، "تابع با رویداد، مکان اشاره‌گر در x برابر " + دام.رویداد افقی(رخداد))
پایان

صفحه:
    عنوان = "چهار راه برای کار با کلیک"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    سراسری: گزینشگر = "button" فاصله = "8px 14px" فضا = "0 0 8px 8px" اندازه قلم = "1rem" پایان
