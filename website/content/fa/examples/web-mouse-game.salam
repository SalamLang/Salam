واردسازی دام

ناپایا برخوردها := 0
ناپایا خطاها := 0

تابع امتیاز:
    دام.تنظیم متن(دام.با شناسه("score")، "موفق " + برخوردها + "، ناموفق " + خطاها)
پایان

تابع جابجایی:
    هدف := دام.با شناسه("target")
    دام.تنظیم سبک(هدف، "left"، "" + ((دام.تصادفی() * 85.0) برگردان صحیح۶۴) + "%")
    دام.تنظیم سبک(هدف، "top"، "" + ((دام.تصادفی() * 75.0) برگردان صحیح۶۴) + "%")
پایان

تابع زدن(رخداد: صحیح۶۴):
    دام.توقف انتشار(رخداد)
    برخوردها++
    امتیاز()
    جابجایی()
پایان

تابع خطا:
    خطاها++
    امتیاز()
پایان

صفحه:
    عنوان = "مربع را بگیر"
    قلم = "Tahoma"، "سیستمی"، "ساده"
    فضا = 1.5rem
    جعبه:
        شناسه = "field"
        کلیک = خطا

        ارتفاع = 220
        پس‌زمینه = "#fef9c3"
        گردی = 10
        سرریز = "پنهان"
        نشانگر = "نشانه"
        جعبه:
            شناسه = "target"
            کلیک = زدن
            موقعیت = "مطلق"
            چپ = 40%
            بالا = 30%
            عرض = 44
            ارتفاع = 44
            پس‌زمینه = "#dc2626"
            گردی = 8
            نشانگر = "اشاره"
        پایان
    پایان
    پاراگراف:
        شناسه = "score"
        محتوا = "موفق 0، ناموفق 0"
    پایان
پایان
