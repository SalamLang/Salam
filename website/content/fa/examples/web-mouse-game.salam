واردسازی دام

ناپایا برخوردها := 0
ناپایا خطاها := 0

تابع امتیاز:
    دام.تنظیم متن(دام.با شناسه("score")، "موفق " + برخوردها + "، ناموفق " + خطاها)
پایان

تابع جابجایی:
    هدف := دام.با شناسه("target")
    دام.تنظیم سبک(هدف، "left"، "" + ((دام.تصادفی() * 85.0) برگردان صحیح۶۴) + "%")
    دام.تنظیم سبک(هدف، "top"، "" + ((دام.تصادفی() * 75.0) برگردان صحیح۶۴) + "%")
پایان

تابع زدن(رخداد: صحیح۶۴):
    دام.توقف انتشار(رخداد)
    برخوردها += 1
    امتیاز()
    جابجایی()
پایان

تابع خطا:
    خطاها += 1
    امتیاز()
پایان

صفحه:
    عنوان = "مربع را بگیر"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        شناسه = "field"
        کلیک = خطا
        موقعیت = نسبی
        ارتفاع = 220
        پس زمینه = "#fef9c3"
        گردی کادر = 10
        سرریز = پنهان
        نشانگر = نشانه‌گیر
        جعبه: شناسه = "target" کلیک = زدن موقعیت = مطلق چپ = "40%" بالا = "30%" عرض = 44 ارتفاع = 44 پس زمینه = "#dc2626" گردی کادر = 8 نشانگر = اشاره‌گر پایان
    پایان
    پاراگراف: شناسه = "score" محتوا = "موفق 0، ناموفق 0" پایان
پایان
