واردسازی دام

تابع بازکردن(رخداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رخداد)
    منو := دام.با شناسه("menu")
    دام.تنظیم سبک(منو، "left"، "" + دام.رویداد افقی(رخداد) + "px")
    دام.تنظیم سبک(منو، "top"، "" + دام.رویداد عمودی(رخداد) + "px")
    دام.تنظیم سبک(منو، "display"، "block")
پایان

تابع بستن():
    دام.تنظیم سبک(دام.با شناسه("menu")، "display"، "none")
پایان

تابع انتخاب(گزینه: رشته):
    دام.تنظیم متن(دام.با شناسه("chosen")، "انتخاب شما: " + گزینه)
    بستن()
پایان

صفحه:
    عنوان = "منوی دلخواه"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 0 پایان
    جعبه:
        شناسه = "area"
        منوی زمینه = بازکردن
        کلیک = بستن
        فاصله = 32
        کمینه ارتفاع = "260px"
        پس زمینه = "#f1f5f9"
        پاراگراف: محتوا = "در هر جای این ناحیه راست کلیک کنید." پایان
        پاراگراف: شناسه = "chosen" محتوا = "چیزی انتخاب نشده." پایان
    پایان
    جعبه:
        شناسه = "menu"
        نمایش = هیچ
        موقعیت = ثابت
        پس زمینه = سفید
        کادر = "1px solid #cbd5e1"
        گردی کادر = 8
        سایه کادر = "0 6px 18px rgba(0,0,0,0.18)"
        فاصله = 4
        دکمه: شناسه = "copy" کلیک = (): انتخاب("رونوشت") پایان محتوا = "رونوشت" نمایش = بلوکی عرض = "100%" پایان
        دکمه: شناسه = "rename" کلیک = (): انتخاب("تغییر نام") پایان محتوا = "تغییر نام" نمایش = بلوکی عرض = "100%" پایان
        دکمه: شناسه = "delete" کلیک = (): انتخاب("حذف") پایان محتوا = "حذف" نمایش = بلوکی عرض = "100%" پایان
    پایان
