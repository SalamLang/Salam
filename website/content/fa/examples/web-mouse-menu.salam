واردسازی دام

تابع بازکردن(رخداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رخداد)
    منو := دام.با شناسه("menu")
    دام.تنظیم سبک(منو، "left"، "" + دام.رویداد افقی(رخداد) + "px")
    دام.تنظیم سبک(منو، "top"، "" + دام.رویداد عمودی(رخداد) + "px")
    دام.تنظیم سبک(منو، "display"، "block")
پایان

تابع بستن():
    دام.تنظیم سبک(دام.با شناسه("menu")، "display"، "none")
پایان

تابع انتخاب(گزینه: رشته):
    دام.تنظیم متن(دام.با شناسه("chosen")، "انتخاب شما: " + گزینه)
    بستن()
پایان

صفحه:
    عنوان = "منوی دلخواه"
    قلم = "Tahoma"، "سیستمی"، "ساده"
    فضا = 0
    جعبه:
        شناسه = "area"
        منوی زمینه = بازکردن
        کلیک = بستن
        فاصله = 32
        کمینه ارتفاع = 260px
        پس‌زمینه = "#f1f5f9"
        پاراگراف:
            محتوا = "در هر جای این ناحیه راست کلیک کنید."
        پایان
        پاراگراف:
            شناسه = "chosen"
            محتوا = "چیزی انتخاب نشده."
        پایان
    پایان
    جعبه:
        شناسه = "menu"
        نمایان = نادرست
        موقعیت = "ثابت"
        پس‌زمینه = "سفید"
        کادر = 1px، "توپر"، "#cbd5e1"
        گردی = 8
        سایه = [0، 6، 18، "#0000002e"]
        فاصله = 4
        دکمه:
            شناسه = "copy"
            کلیک = (): انتخاب("رونوشت") پایان
            محتوا = "رونوشت"
            عرض = 100%
        پایان
