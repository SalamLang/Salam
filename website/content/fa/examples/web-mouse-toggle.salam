واردسازی دام

صفحه:
    عنوان = "چراغ"
    ظاهر سفارشی: محتوا = "#room.on { background: #fde68a; color: #422006 } #room.on .bulb { background: #f59e0b }" پایان
    قلم = "Tahoma"، سیستمی، ساده فضا = 1.5rem
    جعبه:
        شناسه = "room"
        پس‌زمینه = #1e293b
        رنگ = #e2e8f0
        فاصله = 24
        گردی = 12
        تراز متن = وسط
        گذار = 0.3s
        جعبه: کلاس = "bulb" عرض = 60 ارتفاع = 60 فضا = 0، خودکار، 12px پس‌زمینه = #475569 گردی = 50% پایان
        دکمه: شناسه = "switch" کلیک = (): دام.تعویض کلاس(دام.با شناسه("room")، "on") پایان محتوا = "کلید" فاصله = 6px، 16px پایان
