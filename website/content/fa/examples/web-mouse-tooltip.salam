واردسازی دام

تابع نمایاندن(متن: رشته):
    راهنما := دام.با شناسه("tip")
    دام.تنظیم متن(راهنما، متن)
    دام.تنظیم سبک(راهنما، "display"، "block")
پایان

تابع پنهان:
    دام.تنظیم سبک(دام.با شناسه("tip")، "display"، "none")
پایان

تابع دنبالکردن(رخداد: صحیح۶۴):
    راهنما := دام.با شناسه("tip")
    دام.تنظیم سبک(راهنما، "left"، "" + (دام.رویداد افقی(رخداد) + 14.0) + "px")
    دام.تنظیم سبک(راهنما، "top"، "" + (دام.رویداد عمودی(رخداد) + 18.0) + "px")
پایان

صفحه:
    عنوان = "راهنمای شناور"
    قلم = "Tahoma"، سیستمی، ساده فضا = 1.5rem
    دکمه: فاصله = 8px، 14px فضا = 0، 0، 0، 8px اندازه قلم = 1rem شناسه = "save" محتوا = "ذخیره" ورود ماوس = (): نمایاندن("پرونده را ذخیره می‌کند") پایان حرکت ماوس = دنبالکردن خروج ماوس = پنهان پایان
    دکمه: فاصله = 8px، 14px فضا = 0، 0، 0، 8px اندازه قلم = 1rem شناسه = "open" محتوا = "باز کردن" ورود ماوس = (): نمایاندن("پرونده‌ای را از دیسک باز می‌کند") پایان حرکت ماوس = دنبالکردن خروج ماوس = پنهان پایان
    دکمه: فاصله = 8px، 14px فضا = 0، 0، 0، 8px اندازه قلم = 1rem شناسه = "share" محتوا = "اشتراک" ورود ماوس = (): نمایاندن("پیوندی را برای دوستتان می‌فرستد") پایان حرکت ماوس = دنبالکردن خروج ماوس = پنهان پایان
    جعبه: شناسه = "tip" نمایان = نادرست موقعیت = ثابت پس‌زمینه = #0f172a رنگ = سفید فاصله = 4px، 10px گردی = 6 اندازه قلم = 0.85rem تعاملی = نادرست پایان
