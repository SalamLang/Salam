واردسازی دام

ناپایا بزرگنمایی := 1.0

تابع چرخش(رخداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رخداد)
    اگر دام.دریافت خاصیت عددی(رخداد، "deltaY") کوچکتر 0.0:
        بزرگنمایی = بزرگنمایی * 1.1
    وگرنه:
        بزرگنمایی = بزرگنمایی / 1.1
    پایان
    اگر بزرگنمایی بزرگتر 3.0:
        بزرگنمایی = 3.0
    پایان
    اگر بزرگنمایی کوچکتر 0.5:
        بزرگنمایی = 0.5
    پایان
    درصد := (بزرگنمایی * 100.0) برگردان صحیح۶۴
    دام.تنظیم سبک(دام.با شناسه("card")، "transform"، "scale(" + بزرگنمایی + ")")
    دام.تنظیم متن(دام.با شناسه("level")، "بزرگنمایی " + درصد + "٪")
پایان

صفحه:
    عنوان = "بزرگنمایی با چرخ ماوس"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    جعبه:
        شناسه = "stage"
        چرخ ماوس = چرخش
        ارتفاع = 200
        سرریز = پنهان
        پس زمینه = "#f1f5f9"
        گردی کادر = 10
        نمایش = فلکس
        ترازعمودی = وسط
        چینش = وسط
        جعبه: شناسه = "card" محتوا = "چرخ ماوس را روی من بچرخانید" فاصله = 24 پس زمینه = "#0f766e" رنگ = سفید گردی کادر = 10 پایان
    پایان
    پاراگراف: شناسه = "level" محتوا = "بزرگنمایی 100٪" پایان
پایان
