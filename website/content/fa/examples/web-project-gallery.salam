واردسازی دام

ناپایا فعلی := 0 برگردان صحیح۶۴

تابع نمایش‌عکس(شماره: صحیح۶۴):
    کاشی‌ها := دام.پرسمان همه("[data-n]")
    کل := دام.تعداد(کاشی‌ها)
    فعلی = (شماره + کل) % کل
    کاشی := دام.عنصر شماره(کاشی‌ها، فعلی)
    دام.تنظیم سبک(دام.با شناسه("big")، "background"، دام.دریافت ویژگی(کاشی، "data-bg"))
    دام.تنظیم متن(دام.با شناسه("cap")، دام.دریافت ویژگی(کاشی، "data-title") + " (" + (فعلی + 1) + " از " + کل + ")")
پایان

تابع بازکردن(رویداد: صحیح۶۴):
    نمایش‌عکس(دام.دریافت ویژگی(دام.هدف رویداد(رویداد)، "data-n").به صحیح() برگردان صحیح۶۴)
    _باز := دام.فراخوان(دام.با شناسه("lightbox")، "showModal")
پایان

تابع بستن:
    _بسته := دام.فراخوان(دام.با شناسه("lightbox")، "close")
پایان

تابع کلیدها(رویداد: صحیح۶۴):
    اگر دام.کلید رویداد(رویداد) == "ArrowRight":
        نمایش‌عکس(فعلی - 1)
    وگرنه دام.کلید رویداد(رویداد) == "ArrowLeft":
        نمایش‌عکس(فعلی + 1)
    پایان
پایان

تابع پشت‌پرده(رویداد: صحیح۶۴):
    اگر دام.هدف رویداد(رویداد) == دام.با شناسه("lightbox"):
        بستن()
    پایان
پایان

بخش عکس(شماره، نام، روشن، تیره):
    دکمه:
        داده n = شماره داده title = نام داده bg = "linear-gradient(135deg, " + روشن + ", " + تیره + ")" کلیک = بازکردن
        پس زمینه = "linear-gradient(135deg, " + روشن + ", " + تیره + ")" محتوا = نام نسبت ابعاد = "4 / 3" کادر = 0 گردی کادر = 12
        رنگ = سفید اندازه قلم = "1rem" وزن قلم = 600 ترازمتن = آغاز فاصله = 12 نشانگر = اشاره‌گر گذار = "transform 0.15s" خانواده قلم = inherit
        اشاره دگرگونی = "scale(1.04)"
    پایان
پایان

صفحه:
    عنوان = "آلبوم سفر"
    ظاهر سفارشی: محتوا = "dialog { border: 0; border-radius: 16px; padding: 16px; width: min(34rem, 92vw) } dialog::backdrop { background: rgba(15, 23, 42, 0.7) } .bar button { padding: 8px 16px; border: 0; border-radius: 8px; background: #e2e8f0; cursor: pointer; font-family: inherit } .bar button:hover { background: #cbd5e1 }" پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 0 فاصله = "24px 5vw" پس زمینه = "#0f172a" رنگ = سفید پایان
    سرتیتر: اندازه = 1 محتوا = "سفر به کویر" اندازه قلم = "1.8rem" فضا = "0 0 16px 0" پایان
    جعبه: نمایش = شبکه ستون های شبکه = "repeat(auto-fill, minmax(150px, 1fr))" شکاف = 12
        عکس: شماره = 0 نام = "طلوع" روشن = "#f97316" تیره = "#facc15" پایان
        عکس: شماره = 1 نام = "چادر" روشن = "#7c3aed" تیره = "#ec4899" پایان
        عکس: شماره = 2 نام = "تپه‌ها" روشن = "#d97706" تیره = "#fde68a" پایان
        عکس: شماره = 3 نام = "واحه" روشن = "#059669" تیره = "#67e8f9" پایان
        عکس: شماره = 4 نام = "ستاره‌ها" روشن = "#1e1b4b" تیره = "#6366f1" پایان
        عکس: شماره = 5 نام = "راه برگشت" روشن = "#475569" تیره = "#cbd5e1" پایان
    پایان
    پنجره گفتگو: شناسه = "lightbox" فشردن کلید = کلیدها کلیک = پشت‌پرده رنگ = "#0f172a"
        جعبه: شناسه = "big" ارتفاع = 260 گردی کادر = 12 پایان
        پاراگراف: شناسه = "cap" فضا = "12px 0" وزن قلم = 600 پایان
        جعبه: کلاس = "bar" نمایش = فلکس شکاف = 8
            دکمه: شناسه = "back" کلیک = (): نمایش‌عکس(فعلی - 1) پایان محتوا = "قبلی" پایان
            دکمه: شناسه = "forth" کلیک = (): نمایش‌عکس(فعلی + 1) پایان محتوا = "بعدی" پایان
            دکمه: شناسه = "shut" کلیک = بستن محتوا = "بستن" فضا چپ = خودکار پایان
        پایان
    پایان
پایان
