        قلم = سیستمی، ساده
        فاصله = 24، 40
        پس‌زمینه = #0f172a
        رنگ = سفید
        کمینه ارتفاع = 640
        سرتیتر: اندازه = 1 محتوا = "سفر به تپه‌های شنی" اندازه قلم = 29 فضا = 0، 0، 16، 0 پایان
        جعبه:
            چیدمان = شبکه
            ستون‌ها = repeat(fill، minmax(150، 1fr))
            شکاف = 12
            عکس: عنوان = عنوان از(0) طیف = رنگ‌آمیزی(0) انتخاب = (): فعلی = 0 پایان پایان
            عکس: عنوان = عنوان از(1) طیف = رنگ‌آمیزی(1) انتخاب = (): فعلی = 1 پایان پایان
            عکس: عنوان = عنوان از(2) طیف = رنگ‌آمیزی(2) انتخاب = (): فعلی = 2 پایان پایان
            عکس: عنوان = عنوان از(3) طیف = رنگ‌آمیزی(3) انتخاب = (): فعلی = 3 پایان پایان
            عکس: عنوان = عنوان از(4) طیف = رنگ‌آمیزی(4) انتخاب = (): فعلی = 4 پایان پایان
            عکس: عنوان = عنوان از(5) طیف = رنگ‌آمیزی(5) انتخاب = (): فعلی = 5 پایان پایان
        پایان
        اگر فعلی بزرگتربرابر 0:
            جعبه:
                شناسه = "lightbox"
                موقعیت = ثابت
                فاصله از لبه = 0
                چیدمان = پشته
                تراز = وسط
                چینش = وسط
                فشردن کلید = (e: صحیح۶۴):
                    اگر دام.کلید رویداد(e) برابر "ArrowRight":
                        فعلی = (فعلی + 1) % 6
                    وگرنه دام.کلید رویداد(e) برابر "ArrowLeft":
                        فعلی = (فعلی + 5) % 6
                    پایان
                پایان
                جعبه: شناسه = "backdrop" عرض = پر ارتفاع = پر پس‌زمینه = #0f172ab3 کلیک = (): فعلی = -1 پایان پایان
                جعبه:
                    عرض = 92%
                    بیشینه عرض = 544
                    فاصله = 16
                    گردی = 16
                    پس‌زمینه = سفید
                    رنگ = #0f172a
                    جعبه: شناسه = "big" ارتفاع = 260 گردی = 12 پس‌زمینه = رنگ‌آمیزی(فعلی) پایان
                    پاراگراف: شناسه = "cap" فضا = 12، 0 وزن قلم = 600 محتوا = عنوان از(فعلی) + " (" + (فعلی + 1) + " از ۶)" پایان
                    جعبه:
                        چیدمان = ردیف
                        شکاف = 8
                        دکمه: شناسه = "back" فاصله = 8، 16 کادر = 0 گردی = 8 پس‌زمینه = #e2e8f0 نشانگر = اشاره کلیک = (): فعلی = (فعلی + 5) % 6 پایان محتوا = "قبلی" پایان
                        دکمه: شناسه = "forth" فاصله = 8، 16 کادر = 0 گردی = 8 پس‌زمینه = #e2e8f0 نشانگر = اشاره کلیک = (): فعلی = (فعلی + 1) % 6 پایان محتوا = "بعدی" پایان
                        دکمه: شناسه = "shut" فاصله = 8، 16 کادر = 0 گردی = 8 پس‌زمینه = #e2e8f0 نشانگر = اشاره فضا ابتدا = خودکار کلیک = (): فعلی = -1 پایان محتوا = "بستن" پایان
                    پایان
                پایان
