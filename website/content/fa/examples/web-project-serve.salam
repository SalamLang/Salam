واردسازی شبکه.مسیریاب

صفحه خوشامد(نام: رشته، طرح: رشته):
    عنوان = "خوش آمدید " + نام
    زبان = "فارسی"
    جهت = "راست به چپ"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 0 پس زمینه = "#fafaf9" پایان
    اصلی: بیشینه عرض = "30rem" فضا = "48px auto" فاصله = 28 پس زمینه = سفید گردی کادر = 16
        سرتیتر: اندازه = 1 محتوا = "خوش آمدید " + نام پایان
        پاراگراف: محتوا = "طرح " + طرح + " شما از دوشنبه شروع می‌شود." پایان
    پایان
پایان

تابع خانه(زمینه: صحیح۶۴):
    ناپایا نام := اچ تی تی پی.پرسمان(زمینه، "name")
    ناپایا طرح := اچ تی تی پی.پرسمان(زمینه، "plan")
    اگر نام == "":
        نام = "دوست عزیز"
    پایان
    اگر طرح == "":
        طرح = "تکی"
    پایان
    اچ تی تی پی.اچ تی ام ال(زمینه، خوشامد(نام، طرح))
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/"، خانه)
    ناپایا س := اچ تی تی پی.سرور جدید(۸۰۸۰)
    اچ تی تی پی.استفاده(س، م)
    اچ تی تی پی.اجرا(س)
پایان
