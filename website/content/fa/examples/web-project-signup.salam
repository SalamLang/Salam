واردسازی دام

ناپایا دیده := نادرست

تابع داوری(خانه: رشته، خوب: منطقی، پیام: رشته):
    عنصر := دام.با شناسه(خانه)
    دام.حذف کلاس(عنصر، "good")
    دام.حذف کلاس(عنصر، "bad")
    اگر دام.دریافت مقدار(عنصر).طول() > 0:
        اگر خوب:
            دام.افزودن کلاس(عنصر، "good")
        وگرنه:
            دام.افزودن کلاس(عنصر، "bad")
        پایان
    پایان
    اگر خوب:
        دام.تنظیم متن(دام.با شناسه(خانه + "-note")، "")
    وگرنه:
        دام.تنظیم متن(دام.با شناسه(خانه + "-note")، پیام)
    پایان
پایان

تابع بسنج:
    رمز := دام.دریافت مقدار(دام.با شناسه("pw"))
    ناپایا امتیاز := 0
    اگر رمز.طول() >= 8:
        امتیاز += 1
    پایان
    اگر رمز.کوچک() != رمز:
        امتیاز += 1
    پایان
    تکرار 10 در رقم:
        اگر رمز.دربردارد("" + رقم):
            امتیاز = امتیاز + 1
            بشکن
        پایان
    پایان
    ایمیل := دام.دریافت مقدار(دام.با شناسه("mail"))
    نامخوب := دام.دریافت مقدار(دام.با شناسه("name")).طول() >= 2
    ایمیلخوب := ایمیل.دربردارد("@") و ایمیل.دربردارد(".") و ایمیل.طول() >= 6
    رمزخوب := امتیاز == 3
    تکرارخوب := رمز.طول() > 0 و دام.دریافت مقدار(دام.با شناسه("again")) == رمز
    داوری("name"، نامخوب، "لطفاً نامتان را بنویسید.")
    داوری("mail"، ایمیلخوب، "این شبیه نشانی ایمیل نیست.")
    داوری("pw"، رمزخوب، "رمز باید ۸ نویسه، یک حرف بزرگ و یک رقم داشته باشد.")
    داوری("again"، تکرارخوب، "دو رمز یکی نیستند.")
    دام.تنظیم سبک(دام.با شناسه("meter")، "width"، "" + امتیاز * 33 + "%")
    دام.تنظیم خاصیت منطقی(دام.با شناسه("join")، "disabled"، وارونه (نامخوب و ایمیلخوب و رمزخوب و تکرارخوب))
پایان

تابع نمایش:
    دیده = وارونه دیده
    اگر دیده:
        دام.تنظیم ویژگی(دام.با شناسه("pw")، "type"، "text")
    وگرنه:
        دام.تنظیم ویژگی(دام.با شناسه("pw")، "type"، "password")
    پایان
پایان

تابع خوشامد(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
    دام.تنظیم متن(دام.با شناسه("done")، "خوش آمدید " + دام.دریافت مقدار(دام.با شناسه("name")) + ". صندوق ایمیلتان را ببینید.")
پایان

