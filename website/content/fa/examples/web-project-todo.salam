    عنوان = "کارها"
    ظاهر سفارشی: محتوا = ".pick { border: 0; background: none; padding: 4px 10px; border-radius: 6px; cursor: pointer; font-family: inherit } .pick.on { background: #e0e7ff; color: #3730a3 } .words { flex: 1; padding: 0 10px } .words.done { text-decoration: line-through; color: #94a3b8 } li { display: flex; align-items: center; padding: 10px 4px; border-bottom: 1px solid #e2e8f0 } li button { border: 0; background: none; color: #94a3b8; cursor: pointer } li button:hover { color: #dc2626 }" پایان
