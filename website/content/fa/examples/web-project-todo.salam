                دکمه: شناسه = "f1" کلاس = "pick" کلیک = (): حالت = 1 ترسیم() پایان محتوا = "باقی‌مانده" پایان
                دکمه: شناسه = "f2" کلاس = "pick" کلیک = (): حالت = 2 ترسیم() پایان محتوا = "انجام‌شده" پایان
            پایان
        پایان
    پایان
