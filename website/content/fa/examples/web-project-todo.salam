واردسازی دام

ناپایا نوشته‌ها := وکتور {} برگردان وکتور<رشته>
ناپایا انجام‌شده‌ها := وکتور {} برگردان وکتور<منطقی>
ناپایا حالت := 0

تابع گزینش(شرط: منطقی، آری: رشته، نه: رشته): رشته:
    اگر شرط:
        برگشت آری
    پایان
    برگشت نه
پایان

تابع نگهدار:
    ناپایا پیوسته := ""
    تکرار نوشته‌ها.طول() در ردیف:
        پیوسته += گزینش(انجام‌شده‌ها.بگیر(ردیف)، "1"، "0") + نوشته‌ها.بگیر(ردیف) + "\n"
    پایان
    دام.تنظیم متن ذخیره("todos"، پیوسته)
پایان

تابع ترسیم:
    نگهدارنده := دام.با شناسه("items")
    دام.تنظیم اچ تی ام ال(نگهدارنده، "")
    ناپایا باز := 0
    تکرار نوشته‌ها.طول() در ردیف:
        اگر وارونه انجام‌شده‌ها.بگیر(ردیف):
            باز += 1
        پایان
        اگر حالت == 0 یا (حالت == 1 و وارونه انجام‌شده‌ها.بگیر(ردیف)) یا (حالت == 2 و انجام‌شده‌ها.بگیر(ردیف)):
            سطر := دام.بساز("li")
            تیک := دام.بساز("input")
            دام.تنظیم ویژگی(تیک، "type"، "checkbox")
            دام.تنظیم خاصیت منطقی(تیک، "checked"، انجام‌شده‌ها.بگیر(ردیف))
            دام.هنگام رویداد(تیک، "change"، (): انجام‌شده‌ها.تنظیم(ردیف، وارونه انجام‌شده‌ها.بگیر(ردیف)) نگهدار() ترسیم() پایان)
            عبارت := دام.بساز("span")
            دام.تنظیم متن(عبارت، نوشته‌ها.بگیر(ردیف))
            دام.تنظیم ویژگی(عبارت، "class"، گزینش(انجام‌شده‌ها.بگیر(ردیف)، "words done"، "words"))
            حذف := دام.بساز("button")
            دام.تنظیم متن(حذف، "x")
            دام.هنگام رویداد(حذف، "click"، (): نوشته‌ها.حذف در(ردیف) انجام‌شده‌ها.حذف در(ردیف) نگهدار() ترسیم() پایان)
            دام.افزودن(سطر، تیک)
            دام.افزودن(سطر، عبارت)
            دام.افزودن(سطر، حذف)
            دام.افزودن(نگهدارنده، سطر)
        پایان
    پایان
    دام.تنظیم متن(دام.با شناسه("left")، "" + باز + " کار مانده")
    تکرار 3 در k:
        دام.تنظیم ویژگی(دام.با شناسه("f" + k)، "class"، گزینش(k == حالت، "pick on"، "pick"))
    پایان
پایان

تابع همگی:
    اگر نوشته‌ها.طول() == 0:
        خط‌ها := دام.دریافت متن ذخیره("todos").بشکاف("\n")
        تکرار خط‌ها.طول() - 1 در ردیف:
            نوشته‌ها.بیفزا(خط‌ها.بگیر(ردیف).زیررشته(1، خط‌ها.بگیر(ردیف).طول()))
            انجام‌شده‌ها.بیفزا(خط‌ها.بگیر(ردیف).زیررشته(0، 1) == "1")
        پایان
    پایان
    حالت = 0
    ترسیم()
پایان

تابع ثبت(رویداد: صحیح۶۴):
    دام.جلوگیری پیش فرض(رویداد)
    متن := دام.دریافت مقدار(دام.با شناسه("new"))
    اگر متن.طول() > 0:
        نوشته‌ها.بیفزا(متن)
        انجام‌شده‌ها.بیفزا(نادرست)
        دام.تنظیم مقدار(دام.با شناسه("new")، "")
        نگهدار()
        ترسیم()
    پایان
پایان

