واردسازی دام

تابع بارگیری(): وکتور<رشته>:
    ناپایا یافته := وکتور {} برگردان وکتور<رشته>
    خط‌ها := دام.دریافت متن ذخیره("todos").بشکاف("\n")
    تکرار خط‌ها.طول() - 1 در ک:
        یافته.بیفزا(خط‌ها.بگیر(ک))
    پایان
    برگشت یافته
پایان

تابع یکجا(وظایف: وکتور<رشته>): رشته:
    ناپایا متن := ""
    تکرار وظایف.طول() در ک:
        متن += وظایف.بگیر(ک) + "\n"
    پایان
    برگشت متن
پایان

تابع انجام شده(خط: رشته): منطقی:
    برگشت خط.زیررشته(0، 1) برابر "1"
پایان

تابع واژه‌ها(خط: رشته): رشته:
    برگشت خط.زیررشته(1، خط.طول())
پایان

تابع دیده شود(حالت: صحیح، خط: رشته): منطقی:
    برگشت حالت برابر 0 یا (حالت برابر 1 و وارونه انجام شده(خط)) یا (حالت برابر 2 و انجام شده(خط))
پایان

تابع شمار باز(وظایف: وکتور<رشته>): صحیح:
    ناپایا باز := 0
    تکرار وظایف.طول() در ک:
        اگر وارونه انجام شده(وظایف.بگیر(ک)):
            باز++
        پایان
    پایان
    برگشت باز
پایان

تابع نگه‌دار(فهرست: وکتور<رشته>):
    دام.تنظیم متن ذخیره("todos"، یکجا(فهرست))
پایان

تابع تغییر یافته(فهرست: وکتور<رشته>، کدام: رشته): وکتور<رشته>:
    ناپایا نتیجه := وکتور {} برگردان وکتور<رشته>
    ناپایا دیده := نادرست
    تکرار فهرست.طول() در ک:
        خط := فهرست.بگیر(ک)
        اگر وارونه دیده و خط برابر کدام:
            دیده = درست
            ناپایا نشان := "1"
            اگر انجام شده(کدام):
                نشان = "0"
            پایان
            نتیجه.افزودن(نشان + واژه‌ها(کدام))
        وگرنه:
            نتیجه.افزودن(خط)
        پایان
    پایان
    نگه‌دار(نتیجه)
    برگشت نتیجه
پایان

تابع بدون(فهرست: وکتور<رشته>، کدام: رشته): وکتور<رشته>:
    ناپایا نتیجه := وکتور {} برگردان وکتور<رشته>
    ناپایا دیده := نادرست
    تکرار فهرست.طول() در ک:
        خط := فهرست.بگیر(ک)
        اگر وارونه دیده و خط برابر کدام:
            دیده = درست
        وگرنه:
            نتیجه.افزودن(خط)
        پایان
    پایان
    نگه‌دار(نتیجه)
    برگشت نتیجه
پایان

