صفحه:
    عنوان = "روشن و تاریک"
    سبک:
        محتوا = ":root { color-scheme: light dark; --bg: #ffffff; --fg: #111827; --card: #e5e7eb } @media (prefers-color-scheme: dark) { :root { --bg: #111827; --fg: #f9fafb; --card: #1f2937 } }"
    پایان
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 0 پس زمینه = "var(--bg)" رنگ = "var(--fg)" پایان
    جعبه:
        فاصله = 24
        سرتیتر: اندازه = 2 محتوا = "از دستگاه شما پیروی می‌کند" پایان
        پاراگراف: محتوا = "رنگ‌ها متغیرهای CSS هستند. وقتی دستگاه در حالت تاریک است، یک پرس‌وجوی رسانه آن‌ها را عوض می‌کند." پایان
        جعبه: پس زمینه = "var(--card)" فاصله = 16 گردی کادر = 8 محتوا = "کارتی که از همین متغیرها می‌خواند" پایان
    پایان
پایان
