صفحه:
    عنوان = "صفحه‌ی شناور"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 0 ارتفاع خط = 1.9 پایان
    سراسری: اندازه جعبه = "border-box" پایان
    جعبه:
        بیشینه عرض = "40rem"
        فضا = "0 auto"
        فاصله = "clamp(1rem, 4vw, 3rem)"
        سرتیتر:
            اندازه = 1
            اندازه قلم = "clamp(1.6rem, 6vw, 2.8rem)"
            محتوا = "از پایه شناور"
        پایان
        پاراگراف: محتوا = "این جعبه بیشینه عرض دارد، پس در صفحه‌ی پهن بیشتر از آن بزرگ نمی‌شود. در صفحه‌ی باریک همراه صفحه کوچک می‌شود." پایان
        جعبه:
            عرض = "min(100%, 24rem)"
            پس زمینه = "#dbeafe"
            کادر = "2px solid #1d4ed8"
            فاصله = 12
            محتوا = "عرض: min(100%, 24rem)"
        پایان
    پایان
پایان
