واردسازی دام
واردسازی تبدیل

ناپایا شمار := 0

تابع شمردن():
    شمار += 1
    دام.تنظیم متن(دام.با شناسه("n"), "کلیک‌های رسیده: " + تبدیل.قالب عدد(شمار))
پایان

بخش خانه(نشان):
    جعبه: فاصله = "8 12" پس زمینه = "#e0f2fe" گردی کادر = 6 ترازمتن = center نشانگر = نشان محتوا = نشان پایان
پایان

صفحه:
    عنوان = "نشانگر و کنترل اشاره"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 20 پایان
    جعبه:
        نمایش = grid
        ستون های شبکه = "repeat(auto-fit, minmax(110px, 1fr))"
        شکاف = 8
        خانه: نشان = "pointer" پایان
        خانه: نشان = "not-allowed" پایان
        خانه: نشان = "grab" پایان
        خانه: نشان = "zoom-in" پایان
    پایان
    پاراگراف: انتخاب کاربر = none محتوا = "این جمله را با موشواره نمی‌شود انتخاب کرد." پایان
    جعبه:
        نمایش = flex
        شکاف = 8
        دکمه: شناسه = "on" کلیک = شمردن محتوا = "کار می‌کند" پایان
        دکمه: شناسه = "off" رویدادهای اشاره‌گر = none شفافیت = 0.5 کلیک = شمردن محتوا = "pointer-events: none" پایان
    پایان
    پاراگراف: شناسه = "n" محتوا = "کلیک‌های رسیده: ۰" پایان
    متن بلند: تغییر اندازه = vertical ردیف‌ها = 2 محتوا = "گوشه را بکشید تا اندازه عوض شود" پایان
