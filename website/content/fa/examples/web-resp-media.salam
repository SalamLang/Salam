صفحه:
    عنوان = "پرس‌وجوی رسانه روی یک عنصر"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = 16 پایان
    سراسری: گزینشگر = ".tile" پس زمینه = "#dbeafe" گردی کادر = 8 فاصله = 16 ترازمتن = "center" پایان
    جعبه:
        نمایش = grid
        ستون های شبکه = "repeat(3, 1fr)"
        شکاف = 12
        پس زمینه = "#f1f5f9"
        فاصله = 12
        رسانه:
            شرط = "(max-width: 480px)"
            ستون های شبکه = "1fr"
            پس زمینه = "#fef3c7"
        پایان
        جعبه: کلاس = "tile" محتوا = "یک" پایان
        جعبه: کلاس = "tile" محتوا = "دو" پایان
        جعبه: کلاس = "tile" محتوا = "سه" پایان
    پایان
    پاراگراف: محتوا = "در صفحه‌ی پهن سه ستون، و زیر ۴۸۰ پیکسل یک ستون با زمینه‌ی زرد." پایان
