صفحه:
    عنوان = "سبک دادن به ستون‌ها"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    سراسری: گزینشگر = "th, td" فاصله = "8px 16px" پایان
    سراسری: گزینشگر = "table" ادغام کادر = collapse پایان
    جدول:
        گروه ستون:
            تعریف ستون: پس زمینه = "#e2e8f0" پایان
            تعریف ستون: پوشش = 2 پس زمینه = "#ecfccb" پایان
            تعریف ستون: پس زمینه = "#fee2e2" پایان
        پایان
        سرصفحه:
            ردیف:
                ستون: محتوا = "شهر" پایان
                ستون: محتوا = "شنبه" پایان
                ستون: محتوا = "یکشنبه" پایان
                ستون: محتوا = "دوشنبه" پایان
            پایان
        پایان
        اصلی:
            ردیف:
                ستون: سرستون = درست محتوا = "تبریز" پایان
                ستون: محتوا = "۴" پایان
                ستون: محتوا = "۶" پایان
                ستون: محتوا = "۳" پایان
            پایان
            ردیف:
                ستون: سرستون = درست محتوا = "شیراز" پایان
                ستون: محتوا = "۱۸" پایان
                ستون: محتوا = "۲۱" پایان
                ستون: محتوا = "۱۹" پایان
            پایان
        پایان
    پایان
پایان
