        سرصفحه:
            ردیف:
                ستون: محتوا = "نام" پایان
                ستون: محتوا = "نقش" پایان
                ستون: محتوا = "سن" پایان
            پایان
        پایان
        اصلی:
            ردیف: اشاره پس زمینه = "#ccfbf1"
                ستون: محتوا = "سارا" پایان
                ستون: محتوا = "طراح" پایان
                ستون: محتوا = "۳۱" پایان
            پایان
            ردیف: اشاره پس زمینه = "#ccfbf1"
                ستون: محتوا = "امید" پایان
                ستون: محتوا = "مهندس" پایان
                ستون: محتوا = "۲۸" پایان
            پایان
