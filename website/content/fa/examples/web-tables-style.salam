صفحه:
    عنوان = "یک جدول آراسته"
    قلم = "Tahoma"، سیستمی، ساده فضا = 1.5rem
    سبک: محتوا = "tbody tr:nth-child(even) { background: #f1f5f9 }" پایان
    جدول:
        ادغام کادر = collapse
        عرض = 100%
        بیشینه عرض = 28rem
        عنوان جدول: محتوا = "اعضای تیم" جای عنوان جدول = پایین رنگ = #64748b فاصله = 8 پایان
        سرصفحه:
            ردیف:
                ستون: پس‌زمینه = #0f766e رنگ = سفید فاصله = 10 تراز متن = ابتدا محتوا = "نام" پایان
                ستون: پس‌زمینه = #0f766e رنگ = سفید فاصله = 10 تراز متن = ابتدا محتوا = "نقش" پایان
                ستون: پس‌زمینه = #0f766e رنگ = سفید فاصله = 10 تراز متن = ابتدا محتوا = "سن" پایان
            پایان
        پایان
        اصلی:
            ردیف: اشاره پس زمینه = #ccfbf1
                ستون: فاصله = 10 تراز متن = ابتدا محتوا = "سارا" پایان
                ستون: فاصله = 10 تراز متن = ابتدا محتوا = "طراح" پایان
                ستون: فاصله = 10 تراز متن = ابتدا محتوا = "۳۱" پایان
            پایان
            ردیف: اشاره پس زمینه = #ccfbf1
                ستون: فاصله = 10 تراز متن = ابتدا محتوا = "امید" پایان
                ستون: فاصله = 10 تراز متن = ابتدا محتوا = "مهندس" پایان
                ستون: فاصله = 10 تراز متن = ابتدا محتوا = "۲۸" پایان
            پایان
            ردیف: اشاره پس زمینه = #ccfbf1
                ستون: فاصله = 10 تراز متن = ابتدا محتوا = "لیلا" پایان
                ستون: فاصله = 10 تراز متن = ابتدا محتوا = "نویسنده" پایان
                ستون: فاصله = 10 تراز متن = ابتدا محتوا = "۳۵" پایان
            پایان
        پایان
    پایان
