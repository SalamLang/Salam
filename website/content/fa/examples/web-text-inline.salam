صفحه:
    عنوان = "متن درون‌خطی"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" ارتفاع خط = 2 پایان
    پاراگراف:
        محتوا = "فرمول آب H"
        زیرنویس: محتوا = "2" پایان
        تکه: محتوا = "O است و انرژی E = mc" پایان
        بالانویس: محتوا = "2" پایان
        تکه: محتوا = ". " پایان
        قوی: محتوا = "هرگز" پایان
        تکه: محتوا = " آب " پایان
        تاکید: محتوا = "دوم" پایان
        تکه: محتوا = " را ننوشید. برای ذخیره " پایان
        صفحه کلید: محتوا = "Ctrl + S" پایان
        تکه: محتوا = " را بزنید یا در کد " پایان
        کد: محتوا = "save()" پایان
        تکه: محتوا = " را صدا کنید. " پایان
        برجسته: محتوا = "این بخش برجسته شده است." پایان
    پایان
