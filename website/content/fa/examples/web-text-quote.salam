صفحه:
    عنوان = "نقل قول و کد"
    سراسری: گزینشگر = "body" خانواده قلم = "Tahoma, system-ui, sans-serif" فضا = "1.5rem" پایان
    نقل قول بلند:
        منبع نقل = "https://example.com/essay"
        محتوا = "هر چیز را تا جای ممکن ساده کنید، اما ساده‌تر از آن نه."
    پایان
