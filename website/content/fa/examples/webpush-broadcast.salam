واردسازی اعلان وب

تابع ریشه:
    کلیدها := اعلان وب.کلیدها از("BLmOwafYGSjiuCX_1RSCO_n0YmacxYMDqitMydKE4A1Wp2qmUuMXg2IM_hzcrmZLun4jEu_lKfVdtnAp0LMK4NE"، "Nhh4m4Va4yhL-53i302044iqeAeMtnOEYlIT2KWRJmg")
    اگر وارونه کلیدها.ok:
        سرچاپ "کلیدهای VAPID خراب‌اند"
        برگشت ۱
    پایان
    ناپایا اشتراک‌ها := وکتور {} برگردان وکتور<اعلان وب.اشتراک>
    اشتراک‌ها.بیفزا(اعلان وب.اشتراک { endpoint = "https://fcm.googleapis.com/fcm/send/abc"، p256dh = "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4"، auth = "BTBZMqHH6r4Tts7J_aSIgg" })
    اشتراک‌ها.بیفزا(اعلان وب.اشتراک { endpoint = "https://updates.push.services.mozilla.com/wpush/v2/def"، p256dh = "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4"، auth = "BTBZMqHH6r4Tts7J_aSIgg" })

    ناپایا گزینه := اعلان وب.گزینه‌های جدید("mailto:ops@example.com")
    گزینه.ttl = ۳۶۰۰
    گزینه.urgency = "high"
    گزینه.topic = "deploy"

    ناپایا ماندنی := وکتور {} برگردان وکتور<اعلان وب.اشتراک>
    ناپایا فرستاده := ۰
    هر اشتراک در اشتراک‌ها:
        نتیجه := اعلان وب.ارسال(کلیدها، اشتراک، `{"title":"انتشار تمام شد","body":"نسخه‌ی ۲.۴ در دسترس است"}`، گزینه)
        اگر نتیجه.ok:
            فرستاده += ۱
            ماندنی.بیفزا(اشتراک)
        وگرنه نتیجه.gone:
            سرچاپ "حذف"، اشتراک.endpoint
        وگرنه:
            سرچاپ "تلاش دوباره بعدا"، اشتراک.endpoint، نتیجه.status، نتیجه.error
            ماندنی.بیفزا(اشتراک)
        پایان
    پایان
    سرچاپ "فرستاده شد"، فرستاده، "از"، اشتراک‌ها.طول()، "و ماندنی"، ماندنی.طول()
    برگشت ۰
پایان
