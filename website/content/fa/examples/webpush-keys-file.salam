واردسازی اعلان وب
واردسازی سیستم عامل
واردسازی رشته

تابع کلیدهای ماندگار(مسیر: رشته): اعلان وب.کلیدها:
    اگر سیستم عامل.وجود دارد(مسیر):
        خط‌ها := رشته.تفکیک کردن(سیستم عامل.خواندن پرونده(مسیر)، "\n")
        اگر خط‌ها.طول() >= ۲:
            برگشت اعلان وب.کلیدها از(خط‌ها.بگیر(۰)، خط‌ها.بگیر(۱))
        پایان
    پایان
    تازه := اعلان وب.ساخت کلیدها()
    سیستم عامل.نوشتن پرونده(مسیر، تازه.public_key + "\n" + تازه.private_key + "\n")
    برگشت تازه
پایان

تابع ریشه:
    مسیر := "vapid-keys.txt"
    نخست := کلیدهای ماندگار(مسیر)
    دوم := کلیدهای ماندگار(مسیر)
    سرچاپ "کلیدها معتبر:"، نخست.ok، دوم.ok
    سرچاپ "همان کلیدها در اجرای دوم:"، نخست.public_key برابر دوم.public_key
    سرچاپ "طول کلید عمومی:"، نخست.public_key.طول()
    سرچاپ "نقطه‌ی فشرده نشده (با B آغاز می‌شود):"، رشته.شروع با(نخست.public_key، "B")
    سیستم عامل.حذف(مسیر)
پایان
