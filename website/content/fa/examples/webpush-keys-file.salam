واردسازی اعلان وب
واردسازی سیستم عامل
واردسازی رشته

تابع کلیدهای ماندگار(مسیر: رشته): اعلان وب.کلیدها:
    اگر سیستم عامل.وجود دارد(مسیر):
        خط‌ها := رشته.تفکیک کردن(سیستم عامل.خواندن پرونده(مسیر)، "\n")
        اگر خط‌ها.طول() >= ۲:
            برگشت اعلان وب.کلیدها از(خط‌ها.بگیر(۰)، خط‌ها.بگیر(۱))
        پایان
    پایان
    تازه := اعلان وب.ساخت کلیدها()
    سیستم عامل.نوشتن پرونده(مسیر، تازه.کلید عمومی + "\n" + تازه.کلید خصوصی + "\n")
    برگشت تازه
پایان

تابع ریشه:
    مسیر := "vapid-keys.txt"
    نخست := کلیدهای ماندگار(مسیر)
    دوم := کلیدهای ماندگار(مسیر)
    سرچاپ "کلیدها معتبر:"، نخست.معتبر، دوم.معتبر
    سرچاپ "همان کلیدها در اجرای دوم:"، نخست.کلید عمومی برابر دوم.کلید عمومی
    سرچاپ "طول کلید عمومی:"، نخست.کلید عمومی.طول()
    سرچاپ "نقطه‌ی فشرده نشده (با B آغاز می‌شود):"، رشته.شروع با(نخست.کلید عمومی، "B")
    سیستم عامل.حذف(مسیر)
پایان
