واردسازی اعلان وب
واردسازی کدگذاری.جیسون

تابع بار(عنوان: رشته، متن: رشته، نشانی: رشته): رشته:
    ناپایا عضوها := وکتور {} برگردان وکتور<رشته>
    عضوها.بیفزا(جیسون.عضو("title"، عنوان))
    عضوها.بیفزا(جیسون.عضو("body"، متن))
    عضوها.بیفزا(جیسون.عضو("url"، نشانی))
    برگشت جیسون.شیء(عضوها)
پایان

تابع ریشه:
    اشتراک := اعلان وب.اشتراک {
        نقطه پایانی = "https://push.example.net/x"،
        کلید مرورگر = "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4"،
        راز احراز هویت = "BTBZMqHH6r4Tts7J_aSIgg"
    }
    کوچک := بار("پاسخ تازه"، "سارا به پرسش شما پاسخ داد"، "/q/1042")
    سرچاپ کوچک

    ناپایا موفق := نادرست
    هر اندازه در [کوچک.طول()، ۱۰۰۰، ۳۰۰۰، ۳۹۹۳]:
        ناپایا متن := ""
        تا متن.طول() < اندازه:
            متن = متن + "x"
        پایان
        مهر شده := اعلان وب.رمزنگاری(اشتراک، متن، موفق)
        سرچاپ "متن ساده"، اندازه، "بایت، پس از رمز و base64url"، مهر شده.طول()
    پایان
پایان
