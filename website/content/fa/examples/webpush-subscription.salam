واردسازی اعلان وب
واردسازی کدگذاری.جیسون
واردسازی رشته

تابع از مرورگر(متن: رشته): اعلان وب.اشتراک:
    برگشت اعلان وب.اشتراک {
        نقطه پایانی = جیسون.دریافت(متن، "endpoint")،
        کلید مرورگر = جیسون.دریافت مسیر(متن، "keys.p256dh")،
        راز احراز هویت = جیسون.دریافت مسیر(متن، "keys.auth")
    }
پایان

تابع ریشه:
    رسیده := `{"endpoint":"https://fcm.googleapis.com/fcm/send/dQw4w9WgXcQ:APA91b","expirationTime":null,"keys":{"p256dh":"BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4","auth":"BTBZMqHH6r4Tts7J_aSIgg"}}`
    اشتراک := از مرورگر(رسیده)
    سرچاپ "نشانی:"، اشتراک.نقطه پایانی
    سرچاپ "سرویس گوگل:"، رشته.شروع با(اشتراک.نقطه پایانی، "https://fcm.googleapis.com/")
    سرچاپ "طول p256dh:"، اشتراک.کلید مرورگر.طول()، "طول auth:"، اشتراک.راز احراز هویت.طول()

    ناپایا موفق := نادرست
    بدنه := اعلان وب.رمزنگاری(اشتراک، "{\"title\":\"خوش آمدید\"}"، موفق)
    سرچاپ "کلیدها قابل استفاده:"، موفق، "بدنه‌ی رمز شده آماده:"، بدنه.طول() > ۰

    خراب := از مرورگر(`{"endpoint":"https://push.example.net/1","keys":{"p256dh":"abc","auth":"xyz"}}`)
    _ := اعلان وب.رمزنگاری(خراب، "سلام"، موفق)
    سرچاپ "کلیدهای خراب قابل استفاده:"، موفق
پایان
