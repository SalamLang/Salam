واردسازی نمایش وب
واردسازی کدگذاری.جیسون

ساختار کار:
    همگانی عنوان: رشته = ""
    همگانی انجام: منطقی = نادرست
پایان

تابع ریشه:
    ناپایا کارها := وکتور {} برگردان وکتور<کار>
    کارها.بیفزا(کار { عنوان = "نوشتن گزارش"، انجام = درست })
    کارها.بیفزا(کار { عنوان = "فرستادن آن برای سارا" })
    کارها.بیفزا(کار { عنوان = "رزرو اتاق جلسه" })
    صفحه := `<div dir="rtl">
<h2 id="count"></h2>
<ul id="list"></ul>
</div>
<script>
const tasks = ` + جیسون.سریال سازی(کارها) + `;
const open = tasks.filter(t => !t.انجام).length;
document.getElementById("count").textContent = open + " از " + tasks.length + " کار مانده است";
for (const t of tasks) {
  const li = document.createElement("li");
  li.textContent = (t.انجام ? "[x] " : "[ ] ") + t.عنوان;
  document.getElementById("list").appendChild(li);
}
</script>`
    ناپایا پنجره := نمایش وب.ایجاد(نادرست)
    پنجره.تنظیم عنوان("کارها")
    پنجره.تنظیم اندازه(۴۰۰، ۳۰۰، نمایش وب.بدون اشاره)
    پنجره.تنظیم اچ تی ام ال(صفحه)
    پنجره.اجرا()
    پنجره.نابود کردن()
پایان
