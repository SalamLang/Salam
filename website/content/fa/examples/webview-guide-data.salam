واردسازی نمایش وب
واردسازی کدگذاری.جیسون

ساختار کار:
    همگانی عنوان: رشته = ""
    همگانی انجام: منطقی = نادرست
پایان

تابع ریشه:
    ناپایا کارها := وکتور {} برگردان وکتور<کار>
    کارها.بیفزا(کار { عنوان = "نوشتن گزارش"، انجام = درست })
    کارها.بیفزا(کار { عنوان = "فرستادن آن برای سارا" })
    ناپایا پنجره := نمایش وب.ایجاد(درست)
    پنجره.تنظیم عنوان("کارها")
    پنجره.تنظیم اندازه(۴۰۰، ۳۰۰، نمایش وب.بدون اشاره)
    پنجره.اولیه‌سازی("window.tasks = " + جیسون.سریال سازی(کارها) + ";")
    پنجره.تنظیم اچ تی ام ال(`<ul id="list" dir="rtl"></ul>
<script>
for (const t of window.tasks) {
  const li = document.createElement("li");
  li.textContent = (t.انجام ? "[x] " : "[ ] ") + t.عنوان;
  document.getElementById("list").appendChild(li);
}
</script>`)
    پنجره.ارزیابی("document.title = window.tasks.length + ' کار'")
    پنجره.اجرا()
    پنجره.نابود کردن()
پایان
