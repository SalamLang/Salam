واردسازی نمایش وب
واردسازی سیستم عامل

تابع ریشه:
    آرگ ها := سیستم عامل.آرگومان ها()
    ناپایا نشانی := "https://www.salamlang.ir/"
    اگر آرگ ها.طول() > ۱:
        نشانی = آرگ ها.بگیر(۱)
    پایان
    ناپایا پنجره := نمایش وب.ایجاد()
    پنجره.تنظیم عنوان(نشانی)
    پنجره.تنظیم اندازه(۱۲۸۰، ۸۰۰، نمایش وب.بدون اشاره)
    پنجره.پیمایش(نشانی)
    پنجره.اجرا()
    اگر پنجره.بسته شده است():
        سرچاپ "پنجره بسته شد"
    پایان
    پنجره.نابود کردن()
پایان
