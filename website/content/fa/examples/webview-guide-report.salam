واردسازی نمایش وب
واردسازی رشته

ساختار کالا:
    همگانی نام: رشته = ""
    همگانی تعداد: صحیح = ۰
    همگانی بها: صحیح = ۰
پایان

تابع صفحه سفارش(کالاها: وکتور<کالا>): رشته:
    ناپایا ردیف ها := ""
    ناپایا جمع کل := ۰
    هر ک در کالاها:
        مبلغ := ک.تعداد * ک.بها
        جمع کل += مبلغ
        ردیف ها = ردیف ها + "<tr><td>" + ک.نام + "</td><td>" + رشته.از عدد(ک.تعداد) + "</td><td>" + رشته.از عدد(مبلغ) + "</td></tr>"
    پایان
    سبک := "body{font-family:sans-serif;margin:2em;direction:rtl}td,th{padding:4px 12px;text-align:right}"
    برگشت "<style>" + سبک + "</style><h1>سفارش</h1><table><tr><th>کالا</th><th>تعداد</th><th>مبلغ</th></tr>" + ردیف ها + "</table><p>جمع کل: " + رشته.از عدد(جمع کل) + "</p>"
پایان

تابع ریشه:
    ناپایا کالاها := وکتور {} برگردان وکتور<کالا>
    کالاها.بیفزا(کالا { نام = "چای"، تعداد = ۲، بها = ۴۵ })
    کالاها.بیفزا(کالا { نام = "کیک"، تعداد = ۱، بها = ۱۲۰ })
    ناپایا پنجره := نمایش وب.ایجاد()
    پنجره.تنظیم عنوان("سفارش")
    پنجره.تنظیم اندازه(۴۸۰، ۳۲۰، نمایش وب.اشاره ثابت)
    پنجره.تنظیم اچ تی ام ال(صفحه سفارش(کالاها))
    پنجره.اجرا()
    پنجره.نابود کردن()
پایان
