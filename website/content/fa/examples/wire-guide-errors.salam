واردسازی تزریق

تابع report(label: رشته، c: تزریق.ظرف):
    msg := تزریق.ساختن گراف(c)
    سرچاپ label + ":"، msg == "" ? "sound" : msg
    تزریق.بستن(c)
پایان

تابع ریشه:
    ok := تزریق.ساخت()
    تزریق.فراهم کردن(ok، "Repo"، ""، 0، (_c: تزریق.ظرف): برگشت 1 پایان)
    report("fine"، ok)

    missing := تزریق.ساخت()
    تزریق.فراهم کردن(missing، "Service"، "Repo"، 0، (_c: تزریق.ظرف): برگشت 1 پایان)
    report("missing"، missing)

    twice := تزریق.ساخت()
    تزریق.فراهم کردن(twice، "Repo"، ""، 0، (_c: تزریق.ظرف): برگشت 1 پایان)
    تزریق.فراهم کردن(twice، "Repo"، ""، 0، (_c: تزریق.ظرف): برگشت 2 پایان)
    report("duplicate"، twice)

    loop := تزریق.ساخت()
    تزریق.فراهم کردن(loop، "A"، "B"، 0، (_c: تزریق.ظرف): برگشت 1 پایان)
    تزریق.فراهم کردن(loop، "B"، "C"، 0، (_c: تزریق.ظرف): برگشت 2 پایان)
    تزریق.فراهم کردن(loop، "C"، "A"، 0، (_c: تزریق.ظرف): برگشت 3 پایان)
    report("cycle"، loop)

    empty := تزریق.ساخت()
    ناپایا n := 0
    سرچاپ "get:"، تزریق.گرفتن(empty، "Nope"، n)، تزریق.خطا(empty)
    تزریق.بستن(empty)
پایان
