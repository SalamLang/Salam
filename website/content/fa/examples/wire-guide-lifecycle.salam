واردسازی تزریق

ناپایا made := 0

ساختار Db:
    همگانی id: صحیح = 0
پایان

ساختار Cache:
    همگانی db: Db = Db {}
پایان

تابع ریشه:
    c := تزریق.ساخت()
    تزریق.فراهم کردن(c، "Db"، ""، Db {}، (_c: تزریق.ظرف):
        made += 1
        برگشت Db { id = 7 }
    پایان)
    تزریق.فراهم کردن(c، "Cache"، "Db"، Cache {}، (cx: تزریق.ظرف):
        ناپایا d := Db {}
        _ok := تزریق.گرفتن(cx، "Db"، d)
        برگشت Cache { db = d }
    پایان)
    تزریق.هنگام بستن(c، "Db"، Db {}، (d: Db): سرچاپ "closing db"، d.id پایان)
    تزریق.هنگام بستن(c، "Cache"، Cache {}، (k: Cache): سرچاپ "closing cache over"، k.db.id پایان)

    before := تزریق.ساخته شده(c)
    سرچاپ "before"، before.طول()
    before.آزادکن()
    ناپایا a := Cache {}
    ناپایا b := Cache {}
    _x := تزریق.گرفتن(c، "Cache"، a)
    _y := تزریق.گرفتن(c، "Cache"، b)
    سرچاپ "factory runs"، made
    built := تزریق.ساخته شده(c)
    سرچاپ "order"، built.بگیر(0)، built.بگیر(1)
    built.آزادکن()
    تزریق.بستن(c)
    تزریق.بستن(c)
    سرچاپ "done"
پایان
