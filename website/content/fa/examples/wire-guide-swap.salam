واردسازی تزریق

ساختار Config:
    همگانی env: رشته = ""
پایان

ساختار Store:
    همگانی kind: رشته = ""
پایان

تابع build(env: رشته): تزریق.ظرف:
    c := تزریق.ساخت()
    تزریق.مقدار(c، "Config"، Config { env = env })
    تزریق.فراهم کردن(c، "Mem"، ""، Store {}، (_c: تزریق.ظرف): برگشت Store { kind = "memory" } پایان)
    تزریق.فراهم کردن(c، "Disk"، "Config"، Store {}، (cx: تزریق.ظرف):
        ناپایا cfg := Config {}
        _ok := تزریق.گرفتن(cx، "Config"، cfg)
        برگشت Store { kind = "disk for " + cfg.env }
    پایان)
    اگر env == "test":
        تزریق.پیوند(c، "Store"، "Mem")
    وگرنه:
        تزریق.پیوند(c، "Store"، "Disk")
    پایان
    برگشت c
پایان

تابع ریشه:
    for_env := ["test"، "prod"]
    هر env در for_env:
        c := build(env)
        سرچاپ env + ":"، تزریق.ساختن گراف(c) == "" ? "sound" : "broken"
        ناپایا s := Store {}
        _ok := تزریق.گرفتن(c، "Store"، s)
        سرچاپ "  store is"، s.kind
        built := تزریق.ساخته شده(c)
        سرچاپ "  built"، built.طول()، "of"، تزریق.تعداد(c)
        built.آزادکن()
        تزریق.بستن(c)
    پایان
پایان
