واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    text := "fields of an entry, fields of an entry"
    b := فشرده سازی.بافر از رشته(text)

    ناپایا zin := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    zin.بیفزا(بایگانی.ورودی پرونده زیپ { نام = "docs/"، نشانی داده = پوچ، طول داده = 0، روش = 0 })
    zin.بیفزا(بایگانی.ورودی پرونده زیپ { نام = "docs/a.txt"، نشانی داده = b.داده، طول داده = b.طول، روش = 8 })
    z := بایگانی.ساخت زیپ(zin)
    ناپایا zentries := بایگانی.فهرست زیپ(z.داده، z.طول)
    هر e در zentries:
        سرچاپ e.نام، e.اندازه، e.اندازه فشرده کوچکتربرابر e.اندازه، e.پوشه، e.روش، e.چک‌جمع برابر فشرده سازی.چک جمع سی آر سی بافر(b) یا e.پوشه، e.زمان تغییر بزرگتربرابر 0
    پایان
    بایگانی.آزادسازی فهرست(zentries)

    ناپایا tin := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    tin.بیفزا(بایگانی.ورودی پرونده تار { نام = "notes/"، نشانی داده = پوچ، طول داده = 0، پوشه = درست })
    tin.بیفزا(بایگانی.ورودی پرونده تار { نام = "notes/a.txt"، نشانی داده = b.داده، طول داده = b.طول، پوشه = نادرست })
    t := بایگانی.ساخت تار(tin)
    ناپایا tentries := بایگانی.فهرست تار(t.داده، t.طول)
    هر e در tentries:
        سرچاپ e.نام، e.اندازه، e.پوشه
    پایان
    بایگانی.آزادسازی فهرست(tentries)
پایان
