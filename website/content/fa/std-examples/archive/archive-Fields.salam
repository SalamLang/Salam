واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    متن := "fields of an entry, fields of an entry"
    بافر_محلی := فشرده سازی.بافر از رشته(متن)

    ناپایا متغیر_zin := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    متغیر_zin.بیفزا(بایگانی.ورودی پرونده زیپ { نام = "docs/"، نشانی داده = پوچ، طول داده = 0، روش = 0 })
    متغیر_zin.بیفزا(بایگانی.ورودی پرونده زیپ { نام = "docs/a.txt"، نشانی داده = بافر_محلی.داده، طول داده = بافر_محلی.طول، روش = 8 })
    زد := بایگانی.ساخت زیپ(متغیر_zin)
    ناپایا متغیر_zentries := بایگانی.فهرست زیپ(زد.داده، زد.طول)
    هر عنصر در متغیر_zentries:
        سرچاپ عنصر.نام، عنصر.اندازه، عنصر.اندازه فشرده کوچکتربرابر عنصر.اندازه، عنصر.پوشه، عنصر.روش، عنصر.چک‌جمع برابر فشرده سازی.چک جمع سی آر سی بافر(بافر_محلی) یا عنصر.پوشه، عنصر.زمان تغییر بزرگتربرابر 0
    پایان
    بایگانی.آزادسازی فهرست(متغیر_zentries)

    ناپایا متغیر_tin := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    متغیر_tin.بیفزا(بایگانی.ورودی پرونده تار { نام = "notes/"، نشانی داده = پوچ، طول داده = 0، پوشه = درست })
    متغیر_tin.بیفزا(بایگانی.ورودی پرونده تار { نام = "notes/a.txt"، نشانی داده = بافر_محلی.داده، طول داده = بافر_محلی.طول، پوشه = نادرست })
    موقت := بایگانی.ساخت تار(متغیر_tin)
    ناپایا متغیر_tentries := بایگانی.فهرست تار(موقت.داده، موقت.طول)
    هر عنصر در متغیر_tentries:
        سرچاپ عنصر.نام، عنصر.اندازه، عنصر.پوشه
    پایان
    بایگانی.آزادسازی فهرست(متغیر_tentries)
پایان
