// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_filecap_example")
    سیستم عامل.ساخت پوشه ها(dir)
    src := مسیر پرونده.پیوند(dir، "plain.bin")
    packed := مسیر پرونده.پیوند(dir، "plain.xz")
    back := مسیر پرونده.پیوند(dir، "back.bin")
    ناپایا raw := فشرده سازی.بافر بایت جدید()
    تکرار 20000 در i:
        فشرده سازی.افزودن بایت(raw، 97 + (i % 5))
    پایان
    _ := بایگانی.نوشتن پرونده دودویی از بافر(src، raw)
    _ := بایگانی.فشرده سازی پرونده ایکس زد(src، packed)
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده ایکس زد با سقف(packed، back، 1000 برگردان صحیح۶۴))
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده ایکس زد با سقف(packed، back، 0 برگردان صحیح۶۴))
    _ := بایگانی.فشرده سازی پرونده بی زیپ دو(src، packed)
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده بی زیپ دو با سقف(packed، back، 1000 برگردان صحیح۶۴))
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده بی زیپ دو با سقف(packed، back، 0 برگردان صحیح۶۴))
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده الزد ام ای با سقف(src، back، 0 برگردان صحیح۶۴))
    سیستم عامل.حذف همه(dir)
پایان
