// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_filecap_example")
    سیستم عامل.ساخت پوشه ها(پوشه)
    مبدأ := مسیر پرونده.پیوند(پوشه، "plain.bin")
    بسته_شده := مسیر پرونده.پیوند(پوشه، "plain.xz")
    بازگشت := مسیر پرونده.پیوند(پوشه، "back.bin")
    ناپایا خام := فشرده سازی.بافر بایت جدید()
    تکرار 20000 در شمارنده:
        فشرده سازی.افزودن بایت(خام، 97 + (شمارنده % 5))
    پایان
    _ := بایگانی.نوشتن پرونده دودویی از بافر(مبدأ، خام)
    _ := بایگانی.فشرده سازی پرونده ایکس زد(مبدأ، بسته_شده)
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده ایکس زد با سقف(بسته_شده، بازگشت، 1000 برگردان صحیح۶۴))
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده ایکس زد با سقف(بسته_شده، بازگشت، 0 برگردان صحیح۶۴))
    _ := بایگانی.فشرده سازی پرونده بی زیپ دو(مبدأ، بسته_شده)
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده بی زیپ دو با سقف(بسته_شده، بازگشت، 1000 برگردان صحیح۶۴))
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده بی زیپ دو با سقف(بسته_شده، بازگشت، 0 برگردان صحیح۶۴))
    سرچاپ بایگانی.متن وضعیت بایگانی(بایگانی.کدگشایی پرونده الزد ام ای با سقف(مبدأ، بازگشت، 0 برگردان صحیح۶۴))
    سیستم عامل.حذف همه(پوشه)
پایان
