بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    files.بیفزا(بایگانی.ساخت ورودی پرونده("docs/"، پوچ، 0، درست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده("docs/a.txt"، "hello hello hello hello" برگردان تهی*، 23، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده("b.txt"، "bee" برگردان تهی*، 3، نادرست))

    ناپایا status := 0
    ناپایا built := بایگانی.ساخت بایگانی در بافر(بایگانی.قالب تار جی زیپ، files، status)
    سرچاپ status، بایگانی.نام قالب(بایگانی.تشخیص قالب(built.داده، built.طول))

    ناپایا arc := بایگانی.بازکردن بایگانی(built.داده، built.طول، "")
    سرچاپ بایگانی.نام قالب(arc.قالب)، arc.وضعیت
    ناپایا entries := بایگانی.فهرست بایگانی(arc)
    هر e در entries:
        سرچاپ e.نام، e.اندازه، e.پوشه
    پایان
    بایگانی.آزادسازی فهرست(entries)

    ناپایا data := بایگانی.خواندن از بایگانی(arc، "docs/a.txt")
    سرچاپ arc.وضعیت، فشرده سازی.بافر به رشته(data)
    فشرده سازی.آزادسازی بافر(data)
    ناپایا missing := بایگانی.خواندن از بایگانی(arc، "nope.txt")
    سرچاپ arc.وضعیت، بایگانی.متن وضعیت بایگانی(arc.وضعیت)
    فشرده سازی.آزادسازی بافر(missing)

    dest := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam-open-demo")
    n := بایگانی.استخراج همه از بایگانی(arc، dest)
    سرچاپ n، بایگانی.متن وضعیت بایگانی(arc.وضعیت)، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dest، "docs/a.txt"))
    سیستم عامل.حذف همه(dest)

    ناپایا tight := بایگانی.سقف های پیش فرض()
    tight.بیشینه مدخل = 2
    ناپایا small := بایگانی.بازکردن با سقف(built.داده، built.طول، ""، tight)
    سرچاپ بایگانی.استخراج همه از بایگانی(small، dest)، بایگانی.متن وضعیت بایگانی(small.وضعیت)
    بایگانی.بستن بایگانی(small)
    بایگانی.بستن بایگانی(arc)

    سرچاپ بایگانی.تشخیص قالب از نام("backup.tgz") برابر بایگانی.قالب تار جی زیپ، بایگانی.تشخیص قالب از نام("notes.txt") برابر بایگانی.قالب ناشناخته
    فشرده سازی.آزادسازی بافر(built)
    files.آزادکن()
پایان
