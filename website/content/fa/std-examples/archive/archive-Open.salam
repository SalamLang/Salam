بسته ریشه

واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده("docs/"، پوچ، 0، درست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده("docs/a.txt"، "hello hello hello hello" برگردان تهی*، 23، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده("b.txt"، "bee" برگردان تهی*، 3، نادرست))

    ناپایا وضعیت := 0
    ناپایا ساخته_شده := بایگانی.ساخت بایگانی در بافر(بایگانی.قالب تار جی زیپ، پرونده‌ها، وضعیت)
    سرچاپ وضعیت، بایگانی.نام قالب(بایگانی.تشخیص قالب(ساخته_شده.داده، ساخته_شده.طول))

    ناپایا بایگانی_داده := بایگانی.بازکردن بایگانی(ساخته_شده.داده، ساخته_شده.طول، "")
    سرچاپ بایگانی.نام قالب(بایگانی_داده.قالب)، بایگانی_داده.وضعیت
    ناپایا ورودی‌ها := بایگانی.فهرست بایگانی(بایگانی_داده)
    هر عنصر در ورودی‌ها:
        سرچاپ عنصر.نام، عنصر.اندازه، عنصر.پوشه
    پایان
    بایگانی.آزادسازی فهرست(ورودی‌ها)

    ناپایا داده := بایگانی.خواندن از بایگانی(بایگانی_داده، "docs/a.txt")
    سرچاپ بایگانی_داده.وضعیت، فشرده سازی.بافر به رشته(داده)
    فشرده سازی.آزادسازی بافر(داده)
    ناپایا گمشده := بایگانی.خواندن از بایگانی(بایگانی_داده، "nope.txt")
    سرچاپ بایگانی_داده.وضعیت، بایگانی.متن وضعیت بایگانی(بایگانی_داده.وضعیت)
    فشرده سازی.آزادسازی بافر(گمشده)

    مقصد := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam-open-demo")
    تعداد := بایگانی.استخراج همه از بایگانی(بایگانی_داده، مقصد)
    سرچاپ تعداد، بایگانی.متن وضعیت بایگانی(بایگانی_داده.وضعیت)، سیستم عامل.وجود دارد(مسیر پرونده.پیوند(مقصد، "docs/a.txt"))
    سیستم عامل.حذف همه(مقصد)

    ناپایا متغیر_tight := بایگانی.سقف های پیش فرض()
    متغیر_tight.بیشینه مدخل = 2
    ناپایا کوچک := بایگانی.بازکردن با سقف(ساخته_شده.داده، ساخته_شده.طول، ""، متغیر_tight)
    سرچاپ بایگانی.استخراج همه از بایگانی(کوچک، مقصد)، بایگانی.متن وضعیت بایگانی(کوچک.وضعیت)
    بایگانی.بستن بایگانی(کوچک)
    بایگانی.بستن بایگانی(بایگانی_داده)

    سرچاپ بایگانی.تشخیص قالب از نام("backup.tgz") برابر بایگانی.قالب تار جی زیپ، بایگانی.تشخیص قالب از نام("notes.txt") برابر بایگانی.قالب ناشناخته
    فشرده سازی.آزادسازی بافر(ساخته_شده)
    پرونده‌ها.آزادکن()
پایان
