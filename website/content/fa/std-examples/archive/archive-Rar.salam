واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    الف := فشرده سازی.بافر از رشته("first file\n")
    ب := فشرده سازی.بافر از رشته("second file, a little longer\n")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده آر ای آر>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر("docs/"، پوچ، ۰، درست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده آر ای آر("docs/a.txt"، الف.داده، الف.طول، نادرست))
    ناپایا دوم := بایگانی.ساخت ورودی پرونده آر ای آر("docs/b.txt"، ب.داده، ب.طول، نادرست)
    دوم.زمان تغییر = ۱۷۰۰۰۰۰۰۰۰ برگردان صحیح۶۴
    پرونده‌ها.بیفزا(دوم)
    ر := بایگانی.ساخت آر ای آر(پرونده‌ها)
    سرچاپ بایگانی.آر ای آر است(ر.داده، ر.طول)، بایگانی.ساخت پرونده آر ای آر(پرونده‌ها، "made.rar")

    ناپایا فهرست := بایگانی.فهرست آر ای آر(ر.داده، ر.طول)
    هر م در فهرست:
        سرچاپ م.نام، م.اندازه، م.پوشه، م.زمان تغییر
    پایان
    بایگانی.آزادسازی فهرست(فهرست)

    ناپایا وضعیت := ۰
    گرفته := بایگانی.استخراج آر ای آر(ر.داده، ر.طول، "docs/b.txt"، ۰، وضعیت)
    سرچاپ وضعیت == بایگانی.آر ای آر موفق، فشرده سازی.بافر به رشته(گرفته) == "second file, a little longer\n"
    _ := بایگانی.استخراج آر ای آر(ر.داده، ر.طول، "docs/none.txt"، ۰، وضعیت)
    سرچاپ وضعیت == بایگانی.آر ای آر یافت نشد، بایگانی.متن وضعیت آر ای آر(وضعیت)

    ناپایا خوب := نادرست
    کوچک := بایگانی.استخراج با نام از آر ای آر با سقف(ر.داده، ر.طول، "docs/b.txt"، ۵، خوب)
    سرچاپ خوب، کوچک.طول
    سرچاپ بایگانی.متن وضعیت آر ای آر(بایگانی.آر ای آر بیش از حد بزرگ)

    تعداد := بایگانی.استخراج همه از آر ای آر با وضعیت(ر.داده، ر.طول، "rar-out"، وضعیت)
    سرچاپ تعداد، بایگانی.متن وضعیت آر ای آر(وضعیت)

    خراب := فشرده سازی.کپی بافر(ر)
    پ := خراب.داده برگردان طبیعی۸*
    پ[خراب.طول - ۱۵] = ((پ[خراب.طول - ۱۵] برگردان صحیح) ^ ۱) برگردان طبیعی۸
    _ := بایگانی.استخراج آر ای آر(خراب.داده، خراب.طول، "docs/b.txt"، ۰، وضعیت)
    سرچاپ وضعیت == بایگانی.آر ای آر چک جمع ناهمخوان، بایگانی.متن وضعیت آر ای آر(وضعیت)
پایان
