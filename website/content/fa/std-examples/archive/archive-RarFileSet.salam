تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع save(dir: رشته، name: رشته، hex: رشته): رشته:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := hex برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار hex.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    path := مسیر پرونده.پیوند(dir، name)
    _ := بایگانی.نوشتن پرونده دودویی از بافر(path، b)
    فشرده سازی.آزادسازی بافر(b)
    برگشت path
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_rarfile_set")
    سیستم عامل.ساخت پوشه ها(dir)
    first := save(dir، "set.part1.rar"، PART1)
    second := save(dir، "set.part2.rar"، PART2)
    locked := save(dir، "locked.rar"، LOCKED)

    ناپایا rf := بایگانی.بازکردن بخش های پرونده آر ای آر(first، "")
    سرچاپ "volumes"، rf.بخش ها.paths.طول()، بایگانی.متن وضعیت آر ای آر(rf.وضعیت)
    out := مسیر پرونده.پیوند(dir، "out")
    سرچاپ بایگانی.متن وضعیت آر ای آر(بایگانی.استخراج همه از پرونده آر ای آر(rf، out، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴))
    بایگانی.بستن پرونده آر ای آر(rf)

    ناپایا bad := بایگانی.بازکردن پرونده آر ای آر با گذرواژه(locked، "wrong")
    سرچاپ "wrong password"، بایگانی.متن وضعیت آر ای آر(bad.وضعیت)
    بایگانی.بستن پرونده آر ای آر(bad)
    ناپایا good := بایگانی.بازکردن پرونده آر ای آر با گذرواژه(locked، "secret")
    ناپایا es := بایگانی.مدخل های پرونده آر ای آر(good)
    سرچاپ "right password"، es.طول()، es.بگیر(0).نام، es.بگیر(0).اندازه
    بایگانی.آزادسازی فهرست(es)
    بایگانی.بستن پرونده آر ای آر(good)

    حافظه.آزادسازی(out برگردان تهی*)
    حافظه.آزادسازی(first برگردان تهی*)
    حافظه.آزادسازی(second برگردان تهی*)
    حافظه.آزادسازی(locked برگردان تهی*)
    سیستم عامل.حذف همه(dir)
    حافظه.آزادسازی(dir برگردان تهی*)
پایان
