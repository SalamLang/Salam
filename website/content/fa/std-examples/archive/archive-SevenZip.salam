تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع ریشه:
    packed := unhex(ENCRYPTED)
    ناپایا arc := بایگانی.بازکردن هفت زد(packed.داده، packed.طول، "")
    ناپایا names := بایگانی.مدخل‌های هفت زد(arc)
    سرچاپ "بدون گذرواژه:"، names.طول()، arc.وضعیت، بایگانی.متن وضعیت هفت زد(arc.وضعیت)

    arc = بایگانی.بازکردن هفت زد(packed.داده، packed.طول، "wrong")
    names = بایگانی.مدخل‌های هفت زد(arc)
    سرچاپ "گذرواژه نادرست:"، names.طول()، arc.وضعیت برابر بایگانی.هفت زد گذرواژه اشتباه

    arc = بایگانی.بازکردن هفت زد(packed.داده، packed.طول، "secret")
    names = بایگانی.مدخل‌های هفت زد(arc)
    سرچاپ "گذرواژه درست:"، names.طول()، arc.وضعیت برابر بایگانی.هفت زد موفق
    تکرار names.طول() در i:
        e := names.بگیر(i)
        سرچاپ " "، e.نام، e.اندازه، e.دسترسی، e.زمان تغییر
    پایان

    data := بایگانی.خواندن از هفت زد(arc، "src/main.salam"، 0)
    سرچاپ فشرده سازی.بافر به رشته(data)
    missing := بایگانی.خواندن از هفت زد(arc، "nothing.txt"، 0)
    سرچاپ "ناموجود:"، arc.وضعیت برابر بایگانی.هفت زد یافت نشد، missing.طول
    big := بایگانی.خواندن از هفت زد(arc، "readme.txt"، 10)
    سرچاپ "بیش از حد بزرگ:"، arc.وضعیت برابر بایگانی.هفت زد بیش از حد بزرگ، big.طول

    سرچاپ "پشتیبانی نمی‌شود:"، بایگانی.متن وضعیت هفت زد(بایگانی.هفت زد پشتیبانی نمی شود)
    سرچاپ "خراب:"، بایگانی.متن وضعیت هفت زد(بایگانی.هفت زد خراب)
    سرچاپ "چک‌جمع نادرست:"، بایگانی.متن وضعیت هفت زد(بایگانی.هفت زد چک جمع ناهمخوان)
    سرچاپ "ناامن:"، بایگانی.متن وضعیت هفت زد(بایگانی.هفت زد مسیر ناامن)
    سرچاپ "فهرست:"، بایگانی.فهرست هفت زد(packed.داده، packed.طول).طول()
    سرچاپ "استخراج:"، بایگانی.استخراج هفت زد(packed.داده، packed.طول، "readme.txt"، 0، arc.وضعیت).طول، arc.وضعیت
پایان
