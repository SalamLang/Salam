// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی

پایا ENCRYPTED := """
377abcaf271c000492b1434900010000000000003e0000000000000075a266e9cc0ca30fca42d412a3e1dd1194db4dd8fc
e2cf1a1d4df4ce0ca88687e1ab395abaa1bbe78d42aa044be8e9373779efdfd2ddd634772d8f0c62fa54d113cc6b3ac143
47c180a90a35752ec2feffd2b46d3a9a3c870cb0fe3a0a301165c3ad2ab69243d4c4aa154bf810ebf8b3e5988d6a3a9e4e
59bd2f4e7ad24baf35ba6aaad91e0b0a82e28a8c70941e255f48219088e4a3df6ae61451a7a0ad953c0d9e191005562c55
a4351cc71942b1bc90035da6a20467642f8d730da31f7a96c473e6f1986d738ecaaf865bbc4984c08559da1d3ace6c445a
6c34f94739a978d845b0f96290becff7b72085916669b917dbc847e2c2f359083aad6a78ac2674231153cb170650010980
b000070b0100022406f1070112530fd1de53f747a979d2abd82144f9abe78423030101055d0010000001000c80ad80de0a
0178dd34010000
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := s برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار s.طول() در شمارنده:
        مقدار_محلی := nib(نشانگر_بایت[شمارنده] برگردان صحیح)
        اگر مقدار_محلی کوچکتر 0:
            گذر
        پایان
        اگر بالا کوچکتر 0:
            بالا = مقدار_محلی
        وگرنه:
            فشرده سازی.افزودن بایت(بافر_محلی، بالا * 16 + مقدار_محلی)
            بالا = -1
        پایان
    پایان
    برگشت بافر_محلی
پایان

تابع ریشه:
    بسته_شده := unhex(ENCRYPTED)
    ناپایا بایگانی_داده := بایگانی.بازکردن هفت زد(بسته_شده.داده، بسته_شده.طول، "")
    ناپایا نام‌ها := بایگانی.مدخل‌های هفت زد(بایگانی_داده)
    سرچاپ "بدون گذرواژه:"، نام‌ها.طول()، بایگانی_داده.وضعیت، بایگانی.متن وضعیت هفت زد(بایگانی_داده.وضعیت)

    بایگانی_داده = بایگانی.بازکردن هفت زد(بسته_شده.داده، بسته_شده.طول، "wrong")
    نام‌ها = بایگانی.مدخل‌های هفت زد(بایگانی_داده)
    سرچاپ "گذرواژه نادرست:"، نام‌ها.طول()، بایگانی_داده.وضعیت برابر بایگانی.هفت زد گذرواژه اشتباه

    بایگانی_داده = بایگانی.بازکردن هفت زد(بسته_شده.داده، بسته_شده.طول، "secret")
    نام‌ها = بایگانی.مدخل‌های هفت زد(بایگانی_داده)
    سرچاپ "گذرواژه درست:"، نام‌ها.طول()، بایگانی_داده.وضعیت برابر بایگانی.هفت زد موفق
    تکرار نام‌ها.طول() در شمارنده:
        عنصر := نام‌ها.بگیر(شمارنده)
        سرچاپ " "، عنصر.نام، عنصر.اندازه، عنصر.دسترسی، عنصر.زمان تغییر
    پایان

    داده := بایگانی.خواندن از هفت زد(بایگانی_داده، "src/main.salam"، 0)
    سرچاپ فشرده سازی.بافر به رشته(داده)
    گمشده := بایگانی.خواندن از هفت زد(بایگانی_داده، "nothing.txt"، 0)
    سرچاپ "ناموجود:"، بایگانی_داده.وضعیت برابر بایگانی.هفت زد یافت نشد، گمشده.طول
    متغیر_big := بایگانی.خواندن از هفت زد(بایگانی_داده، "readme.txt"، 10)
    سرچاپ "بیش از حد بزرگ:"، بایگانی_داده.وضعیت برابر بایگانی.هفت زد بیش از حد بزرگ، متغیر_big.طول

    سرچاپ "پشتیبانی نمی‌شود:"، بایگانی.متن وضعیت هفت زد(بایگانی.هفت زد پشتیبانی نمی شود)
    سرچاپ "خراب:"، بایگانی.متن وضعیت هفت زد(بایگانی.هفت زد خراب)
    سرچاپ "چک‌جمع نادرست:"، بایگانی.متن وضعیت هفت زد(بایگانی.هفت زد چک جمع ناهمخوان)
    سرچاپ "ناامن:"، بایگانی.متن وضعیت هفت زد(بایگانی.هفت زد مسیر ناامن)
    سرچاپ "فهرست:"، بایگانی.فهرست هفت زد(بسته_شده.داده، بسته_شده.طول).طول()
    سرچاپ "استخراج:"، بایگانی.استخراج هفت زد(بسته_شده.داده، بسته_شده.طول، "readme.txt"، 0، بایگانی_داده.وضعیت).طول، بایگانی_داده.وضعیت
پایان
