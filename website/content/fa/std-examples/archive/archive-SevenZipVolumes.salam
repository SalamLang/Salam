// زبان: فارسی
// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی

پایا PART1 := """
377abcaf271c000457983ded16000000000000004a00000000000000429e4011766f6c756d65206f6e650a766f6c756d6520
74776f0a0104060001091600070b
"""

پایا PART2 := """
01000101000c1600080a014e6ded24000005011113006e006f00740065002e0074007800740000001900140a0100d9199ec4
1c70dd01150601002080a4810000
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع ریشه:
    ناپایا volumes := وکتور {} برگردان وکتور<فشرده سازی.بافر بایت>
    volumes.بیفزا(unhex(PART1))
    volumes.بیفزا(unhex(PART2))
    ناپایا arc := بایگانی.بازکردن بخش‌های هفت زد(volumes، "")
    names := بایگانی.مدخل‌های هفت زد(arc)
    سرچاپ "مدخل‌ها:"، names.طول()، arc.وضعیت
    data := بایگانی.خواندن از هفت زد(arc، "note.txt"، 0)
    چاپ فشرده سازی.بافر به رشته(data)
    بایگانی.بستن هفت زد(arc)
    بایگانی.آزادسازی بخش‌های هفت زد(volumes)
پایان
