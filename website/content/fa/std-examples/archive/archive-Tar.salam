واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    ب := فشرده سازی.بافر از رشته("خط اول\nخط دوم\n")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes"، پوچ، ۰، درست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/a.txt"، ب.داده، ب.طول، نادرست))
    ت := بایگانی.ساخت تار(پرونده‌ها)
    سرچاپ ت.طول % ۵۱۲
    ناپایا فهرست := بایگانی.فهرست تار(ت.داده، ت.طول)
    هر م در فهرست:
        سرچاپ م.نام، م.اندازه، م.پوشه
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    ناپایا خوب := نادرست
    الف := بایگانی.استخراج با نام از تار(ت.داده، ت.طول، "notes/a.txt"، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(الف)
    سرچاپ بایگانی.ساخت پرونده تار(پرونده‌ها، "out.tar")، بایگانی.استخراج همه از تار(ت.داده، ت.طول، "untarred")
    سرچاپ بایگانی.فشرده سازی پرونده جی زیپ("out.tar"، "out.tar.gz")، بایگانی.کدگشایی پرونده جی زیپ("out.tar.gz"، "back.tar")
    ک := بایگانی.خواندن پرونده دودویی("back.tar"، خوب)
    سرچاپ خوب، ک.طول == ت.طول
    بایگانی.اطمینان از پوشه("a/b/c")
    سرچاپ بایگانی.نوشتن پرونده دودویی("a/b/c/x.bin"، ب.داده، ۳)، بایگانی.نوشتن پرونده دودویی از بافر("a/b/c/y.bin"، ب)
    ناپایا ب۲ := فشرده سازی.بافر بایت جدید()
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(ب۲، ۵۱۳)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(ب۲، ۷۰۰۰۰)
    سرچاپ بایگانی.خواندن شانزده بیتی کم ارزش‌اول(ب۲.داده، ۰)، بایگانی.خواندن عدد۳۲ کم ارزش‌اول(ب۲.داده، ۲)
