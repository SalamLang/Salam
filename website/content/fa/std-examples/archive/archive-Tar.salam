واردسازی بایگانی
واردسازی فشرده سازی

روال ریشه:
    ب := فشرده سازی.بافر از رشته("خط اول\nخط دوم\n")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes"، پوچ، ۰، درست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/a.txt"، ب.data، ب.len، نادرست))
    ت := بایگانی.ساخت تار(پرونده‌ها)
    سرچاپ ت.len % ۵۱۲
    ناپایا فهرست := بایگانی.فهرست تار(ت.data، ت.len)
    هر م در فهرست:
        سرچاپ م.name، م.size، م.is_dir
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    ناپایا خوب := نادرست
    الف := بایگانی.استخراج با نام از تار(ت.data، ت.len، "notes/a.txt"، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(الف)
    سرچاپ بایگانی.ساخت پرونده تار(پرونده‌ها، "out.tar")، بایگانی.استخراج همه از تار(ت.data، ت.len، "untarred")
    سرچاپ بایگانی.فشرده سازی پرونده جی زیپ("out.tar"، "out.tar.gz")، بایگانی.کدگشایی پرونده جی زیپ("out.tar.gz"، "back.tar")
    ک := بایگانی.خواندن پرونده دودویی("back.tar"، خوب)
    سرچاپ خوب، ک.len == ت.len
    بایگانی.اطمینان از پوشه("a/b/c")
    سرچاپ بایگانی.نوشتن پرونده دودویی("a/b/c/x.bin"، ب.data، ۳)، بایگانی.نوشتن پرونده دودویی از بافر("a/b/c/y.bin"، ب)
    ناپایا ب۲ := فشرده سازی.بافر بایت جدید()
    بایگانی.نوشتن شانزده بیتی کم ارزش‌اول(ب۲، ۵۱۳)
    بایگانی.نوشتن عدد۳۲ کم ارزش‌اول(ب۲، ۷۰۰۰۰)
    سرچاپ بایگانی.خواندن شانزده بیتی کم ارزش‌اول(ب۲.data، ۰)، بایگانی.خواندن عدد۳۲ کم ارزش‌اول(ب۲.data، ۲)
پایان
