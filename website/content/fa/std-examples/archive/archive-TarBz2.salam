// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    متغیر_hello := فشرده سازی.بافر از رشته("hello\n")
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("hello.txt"، متغیر_hello.داده، متغیر_hello.طول، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes"، پوچ، 0، درست))
    متغیر_notes := فشرده سازی.بافر از رشته("note\n".تکرار(200))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/list.txt"، متغیر_notes.داده، متغیر_notes.طول، نادرست))

    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_tarbz2_example")
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه)
    مسیر := مسیر پرونده.پیوند(پوشه، "all.tar.bz2")
    سرچاپ "file:"، بایگانی.ساخت پرونده تار بی زیپ دو(پرونده‌ها، مسیر)
    سرچاپ "level 1:"، بایگانی.ساخت پرونده تار بی زیپ دو با سطح(پرونده‌ها، مسیر پرونده.پیوند(پوشه، "fast.tar.bz2")، 1)

    ناپایا موفق := نادرست
    بسته_شده := بایگانی.خواندن پرونده دودویی(مسیر، موفق)
    ساده := بایگانی.ساخت تار(پرونده‌ها)
    متغیر_one := فشرده سازی.فشرده سازی بی زیپ دو با سطح(ساده.داده، ساده.طول، 9)
    سرچاپ "one bzip2 stream:"، فشرده سازی.برابری بافر(بسته_شده، متغیر_one)

    مقصد := مسیر پرونده.پیوند(پوشه، "out")
    سرچاپ "extract:"، بایگانی.استخراج همه از پرونده تار بی زیپ دو(مسیر، مقصد، 0 برگردان صحیح۶۴)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(مقصد، "notes/list.txt"))
    سیستم عامل.حذف همه(پوشه)
پایان
