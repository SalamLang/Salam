// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    hello := فشرده سازی.بافر از رشته("hello\n")
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("hello.txt"، hello.داده، hello.طول، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes"، پوچ، 0، درست))
    notes := فشرده سازی.بافر از رشته("note\n".تکرار(200))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/list.txt"، notes.داده، notes.طول، نادرست))

    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_tarbz2_example")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    path := مسیر پرونده.پیوند(dir، "all.tar.bz2")
    سرچاپ "file:"، بایگانی.ساخت پرونده تار بی زیپ دو(files، path)
    سرچاپ "level 1:"، بایگانی.ساخت پرونده تار بی زیپ دو با سطح(files، مسیر پرونده.پیوند(dir، "fast.tar.bz2")، 1)

    ناپایا ok := نادرست
    packed := بایگانی.خواندن پرونده دودویی(path، ok)
    plain := بایگانی.ساخت تار(files)
    one := فشرده سازی.فشرده سازی بی زیپ دو با سطح(plain.داده، plain.طول، 9)
    سرچاپ "one bzip2 stream:"، فشرده سازی.برابری بافر(packed، one)

    dest := مسیر پرونده.پیوند(dir، "out")
    سرچاپ "extract:"، بایگانی.استخراج همه از پرونده تار بی زیپ دو(path، dest، 0 برگردان صحیح۶۴)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dest، "notes/list.txt"))
    سیستم عامل.حذف همه(dir)
پایان
