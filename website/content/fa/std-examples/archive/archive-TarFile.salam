// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل

تابع ریشه:
    بدنه := "streamed straight from the archive\n"
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("logs/a.txt"، بدنه برگردان تهی*، بدنه.طول()، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("logs/b.txt"، بدنه برگردان تهی*، 10، نادرست))
    ناپایا ساخته := بایگانی.ساخت تار(پرونده‌ها)
    پرونده‌ها.آزادکن()
    بایگانی.نوشتن پرونده دودویی از بافر("made.tar"، ساخته)
    فشرده سازی.آزادسازی بافر(ساخته)

    ناپایا پرونده_تار := بایگانی.بازکردن پرونده تار("made.tar")
    ناپایا عنصر := بایگانی.مدخل {}
    تا بایگانی.مدخل بعدی پرونده تار(پرونده_تار، عنصر):
        سرچاپ عنصر.نام، عنصر.اندازه
        اگر عنصر.نام برابر "logs/a.txt":
            سرچاپ بایگانی.استخراج از پرونده تار به پرونده(پرونده_تار، عنصر، "a.out"، 0 برگردان صحیح۶۴) برابر بایگانی.تار موفق
            سرچاپ بایگانی.استخراج از پرونده تار به پرونده(پرونده_تار، عنصر، "a.out"، 5 برگردان صحیح۶۴) برابر بایگانی.تار بیش از حد بزرگ
        پایان
        بایگانی.آزادسازی مدخل(عنصر)
    پایان
    بایگانی.بستن پرونده تار(پرونده_تار)

    سرچاپ بایگانی.استخراج همه از پرونده تار("made.tar"، "out"، 0 برگردان صحیح۶۴) برابر بایگانی.تار موفق
    سیستم عامل.حذف همه("out")
    سیستم عامل.حذف("made.tar")
    سیستم عامل.حذف("a.out")
پایان
