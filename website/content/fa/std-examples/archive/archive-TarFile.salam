// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل

تابع ریشه:
    body := "streamed straight from the archive\n"
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("logs/a.txt"، body برگردان تهی*، body.طول()، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("logs/b.txt"، body برگردان تهی*، 10، نادرست))
    ناپایا made := بایگانی.ساخت تار(files)
    files.آزادکن()
    بایگانی.نوشتن پرونده دودویی از بافر("made.tar"، made)
    فشرده سازی.آزادسازی بافر(made)

    ناپایا tf := بایگانی.بازکردن پرونده تار("made.tar")
    ناپایا e := بایگانی.مدخل {}
    تا بایگانی.مدخل بعدی پرونده تار(tf، e):
        سرچاپ e.نام، e.اندازه
        اگر e.نام برابر "logs/a.txt":
            سرچاپ بایگانی.استخراج از پرونده تار به پرونده(tf، e، "a.out"، 0 برگردان صحیح۶۴) برابر بایگانی.تار موفق
            سرچاپ بایگانی.استخراج از پرونده تار به پرونده(tf، e، "a.out"، 5 برگردان صحیح۶۴) برابر بایگانی.تار بیش از حد بزرگ
        پایان
        بایگانی.آزادسازی مدخل(e)
    پایان
    بایگانی.بستن پرونده تار(tf)

    سرچاپ بایگانی.استخراج همه از پرونده تار("made.tar"، "out"، 0 برگردان صحیح۶۴) برابر بایگانی.تار موفق
    سیستم عامل.حذف همه("out")
    سیستم عامل.حذف("made.tar")
    سیستم عامل.حذف("a.out")
پایان
