واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    متن := "log line\n".تکرار(500)
    محتوا := فشرده سازی.بافر از رشته(متن)
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("app.log"، محتوا.داده، محتوا.طول، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("empty"، پوچ، 0، درست))
    ز := بایگانی.ساخت تار جی زیپ(پرونده‌ها)
    سرچاپ ز.طول کوچکتر محتوا.طول
    ناپایا خوب := نادرست
    ناپایا فهرست := بایگانی.فهرست تار جی زیپ(ز.داده، ز.طول، خوب)
    سرچاپ خوب، فهرست.طول()
    بایگانی.آزادسازی فهرست(فهرست)
    یکی := بایگانی.استخراج با نام از تار جی زیپ(ز.داده، ز.طول، "app.log"، خوب)
    سرچاپ خوب، یکی.طول برابر محتوا.طول
    کوچک := بایگانی.فهرست تار جی زیپ با سقف(ز.داده، ز.طول، 1000، خوب)
    سرچاپ خوب، کوچک.طول()
    _ := بایگانی.استخراج با نام از تار جی زیپ با سقف(ز.داده، ز.طول، "app.log"، 100000، خوب)
    سرچاپ خوب
    سرچاپ بایگانی.استخراج همه از تار جی زیپ با سقف(ز.داده، ز.طول، "tooSmall"، 1000)
    سرچاپ بایگانی.استخراج همه از تار جی زیپ(ز.داده، ز.طول، "unpacked")
    سرچاپ بایگانی.ساخت پرونده تار جی زیپ(پرونده‌ها، "logs.tar.gz")
پایان
