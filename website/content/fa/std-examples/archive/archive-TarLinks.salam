واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    محتوا := فشرده سازی.بافر از رشته("hello\n")
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    ناپایا الف := بایگانی.ساخت ورودی پرونده تار("a.txt"، محتوا.داده، محتوا.طول، نادرست)
    الف.زمان تغییر = 1700000000 برگردان صحیح۶۴
    الف.دسترسی = 0o640
    پرونده‌ها.بیفزا(الف)
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("current"، "a.txt"))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پیوند سخت تار("copy.txt"، "a.txt"))
    عمیق := "reports/".تکرار(20) + "summary.txt"
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار(عمیق، محتوا.داده، محتوا.طول، نادرست))
    ت := بایگانی.ساخت تار(پرونده‌ها)
    ناپایا فهرست := بایگانی.فهرست تار(ت.داده، ت.طول)
    هر م در فهرست:
        سرچاپ م.نوع، م.نام.طول()، م.پیوند، م.اندازه، م.زمان تغییر، م.دسترسی
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    سرچاپ بایگانی.استخراج همه از تار(ت.داده، ت.طول، "linked")
    ناپایا بد := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    بد.بیفزا(بایگانی.ساخت ورودی پرونده تار("fine.txt"، محتوا.داده، محتوا.طول، نادرست))
    بد.بیفزا(بایگانی.ساخت ورودی پیوند نمادین تار("escape"، "../outside"))
    ب := بایگانی.ساخت تار(بد)
    سرچاپ بایگانی.استخراج همه از تار(ب.داده، ب.طول، "guarded")
پایان
