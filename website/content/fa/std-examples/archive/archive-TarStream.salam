// زبان: فارسی
واردسازی بایگانی
واردسازی سیستم عامل

تابع ریشه:
    body := "streamed straight from the compressed file\n"
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/a.txt"، body برگردان تهی*، body.طول()، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/b.txt"، body برگردان تهی*، 10، نادرست))
    سرچاپ بایگانی.ساخت پرونده تار جی زیپ(files، "pack.tar.gz")
    files.آزادکن()

    ناپایا st := 0
    ناپایا entries := بایگانی.مدخل های پرونده تار فشرده("pack.tar.gz"، بایگانی.قالب تار جی زیپ، st)
    هر e در entries:
        سرچاپ e.نام، e.اندازه
    پایان
    سرچاپ st
    بایگانی.آزادسازی فهرست(entries)

    سرچاپ بایگانی.استخراج همه از پرونده تار جی زیپ("pack.tar.gz"، "unpacked"، 0 برگردان صحیح۶۴)
    سرچاپ سیستم عامل.اندازه پرونده("unpacked/notes/a.txt")، سیستم عامل.اندازه پرونده("unpacked/notes/b.txt")
    سرچاپ بایگانی.استخراج همه از پرونده تار فشرده("pack.tar.gz"، بایگانی.قالب تار جی زیپ، "capped"، 20 برگردان صحیح۶۴)
    سرچاپ سیستم عامل.وجود دارد("capped/notes/a.txt")، سیستم عامل.وجود دارد("capped/notes/b.txt")
    سیستم عامل.حذف همه("unpacked")
    سیستم عامل.حذف همه("capped")
    سیستم عامل.حذف("pack.tar.gz")
پایان
