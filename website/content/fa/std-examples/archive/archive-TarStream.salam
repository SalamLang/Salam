// زبان: فارسی
واردسازی بایگانی
واردسازی سیستم عامل

تابع ریشه:
    بدنه := "streamed straight from the compressed file\n"
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/a.txt"، بدنه برگردان تهی*، بدنه.طول()، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/b.txt"، بدنه برگردان تهی*، 10، نادرست))
    سرچاپ بایگانی.ساخت پرونده تار جی زیپ(پرونده‌ها، "pack.tar.gz")
    پرونده‌ها.آزادکن()

    ناپایا سبک_متن := 0
    ناپایا ورودی‌ها := بایگانی.مدخل های پرونده تار فشرده("pack.tar.gz"، بایگانی.قالب تار جی زیپ، سبک_متن)
    هر عنصر در ورودی‌ها:
        سرچاپ عنصر.نام، عنصر.اندازه
    پایان
    سرچاپ سبک_متن
    بایگانی.آزادسازی فهرست(ورودی‌ها)

    سرچاپ بایگانی.استخراج همه از پرونده تار جی زیپ("pack.tar.gz"، "unpacked"، 0 برگردان صحیح۶۴)
    سرچاپ سیستم عامل.اندازه پرونده("unpacked/notes/a.txt")، سیستم عامل.اندازه پرونده("unpacked/notes/b.txt")
    سرچاپ بایگانی.استخراج همه از پرونده تار فشرده("pack.tar.gz"، بایگانی.قالب تار جی زیپ، "capped"، 20 برگردان صحیح۶۴)
    سرچاپ سیستم عامل.وجود دارد("capped/notes/a.txt")، سیستم عامل.وجود دارد("capped/notes/b.txt")
    سیستم عامل.حذف همه("unpacked")
    سیستم عامل.حذف همه("capped")
    سیستم عامل.حذف("pack.tar.gz")
پایان
