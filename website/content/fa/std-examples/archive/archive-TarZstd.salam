// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    hello := فشرده سازی.بافر از رشته("hello\n")
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("hello.txt"، hello.داده، hello.طول، نادرست))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes"، پوچ، 0، درست))
    notes := فشرده سازی.بافر از رشته("note\n".تکرار(200))
    files.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/list.txt"، notes.داده، notes.طول، نادرست))

    tz := بایگانی.ساخت تار زستد(files)
    سرچاپ "تار زستد:"، tz.طول، "بایت،"، فشرده سازی.زستد است بافر(tz)
    ناپایا ok := نادرست
    ناپایا entries := بایگانی.فهرست تار زستد(tz.داده، tz.طول، ok)
    سرچاپ "ورودی‌ها:"، ok، entries.طول()
    هر e در entries:
        سرچاپ e.نام، e.اندازه
    پایان
    بایگانی.آزادسازی فهرست(entries)
    one := بایگانی.استخراج با نام از تار زستد(tz.داده، tz.طول، "hello.txt"، ok)
    سرچاپ ok، فشرده سازی.بافر به رشته(one)
    small := بایگانی.فهرست تار زستد با سقف(tz.داده، tz.طول، 1000، ok)
    سرچاپ "سقف ۱۰۰۰ بایت:"، ok، small.طول()

    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_tarzstd_example")
    سیستم عامل.حذف همه(dir)
    سرچاپ "استخراج:"، بایگانی.استخراج همه از تار زستد(tz.داده، tz.طول، dir)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(dir، "notes/list.txt"))
    path := مسیر پرونده.پیوند(dir، "all.tar.zst")
    سرچاپ "پرونده:"، بایگانی.ساخت پرونده تار زستد(files، path)
    سیستم عامل.حذف همه(dir)
پایان
