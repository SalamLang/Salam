// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    متغیر_hello := فشرده سازی.بافر از رشته("hello\n")
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("hello.txt"، متغیر_hello.داده، متغیر_hello.طول، نادرست))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes"، پوچ، 0، درست))
    متغیر_notes := فشرده سازی.بافر از رشته("note\n".تکرار(200))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده تار("notes/list.txt"، متغیر_notes.داده، متغیر_notes.طول، نادرست))

    متغیر_tz := بایگانی.ساخت تار زستد(پرونده‌ها)
    سرچاپ "تار زستد:"، متغیر_tz.طول، "بایت،"، فشرده سازی.زستد است بافر(متغیر_tz)
    ناپایا موفق := نادرست
    ناپایا ورودی‌ها := بایگانی.فهرست تار زستد(متغیر_tz.داده، متغیر_tz.طول، موفق)
    سرچاپ "ورودی‌ها:"، موفق، ورودی‌ها.طول()
    هر عنصر در ورودی‌ها:
        سرچاپ عنصر.نام، عنصر.اندازه
    پایان
    بایگانی.آزادسازی فهرست(ورودی‌ها)
    متغیر_one := بایگانی.استخراج با نام از تار زستد(متغیر_tz.داده، متغیر_tz.طول، "hello.txt"، موفق)
    سرچاپ موفق، فشرده سازی.بافر به رشته(متغیر_one)
    کوچک := بایگانی.فهرست تار زستد با سقف(متغیر_tz.داده، متغیر_tz.طول، 1000، موفق)
    سرچاپ "سقف ۱۰۰۰ بایت:"، موفق، کوچک.طول()

    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_tarzstd_example")
    سیستم عامل.حذف همه(پوشه)
    سرچاپ "استخراج:"، بایگانی.استخراج همه از تار زستد(متغیر_tz.داده، متغیر_tz.طول، پوشه)
    سرچاپ سیستم عامل.وجود دارد(مسیر پرونده.پیوند(پوشه، "notes/list.txt"))
    مسیر := مسیر پرونده.پیوند(پوشه، "all.tar.zst")
    سرچاپ "پرونده:"، بایگانی.ساخت پرونده تار زستد(پرونده‌ها، مسیر)
    سیستم عامل.حذف همه(پوشه)
پایان
