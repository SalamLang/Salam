// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع same(path: رشته، want: فشرده سازی.بافر بایت): منطقی:
    ناپایا ok := نادرست
    got := بایگانی.خواندن پرونده دودویی(path، ok)
    برگشت ok و فشرده سازی.برابری بافر(got، want)
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_write_example")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    plain := مسیر پرونده.پیوند(dir، "notes.txt")
    back := مسیر پرونده.پیوند(dir، "back.bin")
    text := فشرده سازی.بافر از رشته("Salam keeps notes in plain files. ".تکرار(2000))
    بایگانی.نوشتن پرونده دودویی از بافر(plain، text)
    بایگانی.تنظیم اندازه قطعه نوشتن(16384)

    سرچاپ "جی زیپ:"، بایگانی.فشرده سازی پرونده جی زیپ(plain، مسیر پرونده.پیوند(dir، "n.gz"))، بایگانی.کدگشایی پرونده جی زیپ(مسیر پرونده.پیوند(dir، "n.gz")، back)، same(back، text)
    سرچاپ "بی زیپ دو، سطح ۱:"، بایگانی.فشرده سازی پرونده بی زیپ دو با سطح(plain، مسیر پرونده.پیوند(dir، "n.bz2")، 1)، بایگانی.کدگشایی پرونده بی زیپ دو(مسیر پرونده.پیوند(dir، "n.bz2")، back)، same(back، text)
    سرچاپ "ایکس زد، سطح ۹:"، بایگانی.فشرده سازی پرونده ایکس زد با سطح(plain، مسیر پرونده.پیوند(dir، "n.xz")، 9)، بایگانی.کدگشایی پرونده ایکس زد(مسیر پرونده.پیوند(dir، "n.xz")، back)، same(back، text)
    سرچاپ "الزد ام ای، سطح ۳:"، بایگانی.فشرده سازی پرونده الزد ام ای با سطح(plain، مسیر پرونده.پیوند(dir، "n.lzma")، 3)، بایگانی.کدگشایی پرونده الزد ام ای(مسیر پرونده.پیوند(dir، "n.lzma")، back)، same(back، text)

    ناپایا tar_files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    tar_files.بیفزا(بایگانی.ساخت ورودی پرونده تار از مسیر("docs/notes.txt"، plain))
    tar_files.بیفزا(بایگانی.ساخت ورودی پرونده تار("docs/hello.txt"، "hello" برگردان تهی*، 5، نادرست))
    tgz := مسیر پرونده.پیوند(dir، "n.tar.zst")
    سرچاپ "تار زستد:"، بایگانی.ساخت پرونده تار زستد با سطح(tar_files، tgz، 5)

    ناپایا zip_files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    zip_files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ از مسیر("notes.txt"، plain، بایگانی.روش زیپ دیفلیت، 0))
    secret := "top secret"
    zip_files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ رمزدار("secret.txt"، secret برگردان تهی*، secret.طول()، بایگانی.روش زیپ دیفلیت، 0، "pass"، بایگانی.رمزگذاری زیپ خودکار))
    zpath := مسیر پرونده.پیوند(dir، "n.zip")
    سرچاپ "زیپ:"، بایگانی.ساخت پرونده زیپ(zip_files، zpath)، بایگانی.ساخت پرونده زیپ بزرگ(zip_files، مسیر پرونده.پیوند(dir، "n64.zip"))
    ناپایا zf := بایگانی.بازکردن پرونده زیپ(zpath)
    سرچاپ "مدخل‌ها:"، zf.شمار، "وضعیت:"، zf.وضعیت
    سرچاپ "بدون گذرواژه:"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "secret.txt"، back، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ رمزگذاری شده
    بایگانی.تنظیم گذرواژه پرونده زیپ(zf، "pass")
    سرچاپ "با گذرواژه:"، بایگانی.استخراج از پرونده زیپ به پرونده(zf، "secret.txt"، back، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ موفق، same(back، فشرده سازی.بافر از رشته(secret))
    بایگانی.بستن پرونده زیپ(zf)

    ناپایا sz_files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    sz_files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد از مسیر("notes.txt"، plain))
    szpath := مسیر پرونده.پیوند(dir، "n.7z")
    سرچاپ "هفت زد، سطح ۵:"، بایگانی.ساخت پرونده هفت زد با سطح(sz_files، szpath، 5)
    ناپایا sf := بایگانی.بازکردن پرونده هفت زد(szpath، "")
    سرچاپ "استخراج هفت زد:"، بایگانی.استخراج از پرونده هفت زد به پرونده(sf، "notes.txt"، back، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)، same(back، text)
    بایگانی.بستن پرونده هفت زد(sf)
    سیستم عامل.حذف همه(dir)
پایان
