// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع same(path: رشته، want: فشرده سازی.بافر بایت): منطقی:
    ناپایا موفق := نادرست
    گرفته := بایگانی.خواندن پرونده دودویی(path، موفق)
    برگشت موفق و فشرده سازی.برابری بافر(گرفته، want)
پایان

تابع ریشه:
    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_write_example")
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه)
    ساده := مسیر پرونده.پیوند(پوشه، "notes.txt")
    بازگشت := مسیر پرونده.پیوند(پوشه، "back.bin")
    متن := فشرده سازی.بافر از رشته("Salam keeps notes in plain files. ".تکرار(2000))
    بایگانی.نوشتن پرونده دودویی از بافر(ساده، متن)
    بایگانی.تنظیم اندازه قطعه نوشتن(16384)

    سرچاپ "جی زیپ:"، بایگانی.فشرده سازی پرونده جی زیپ(ساده، مسیر پرونده.پیوند(پوشه، "n.gz"))، بایگانی.کدگشایی پرونده جی زیپ(مسیر پرونده.پیوند(پوشه، "n.gz")، بازگشت)، same(بازگشت، متن)
    سرچاپ "بی زیپ دو، سطح ۱:"، بایگانی.فشرده سازی پرونده بی زیپ دو با سطح(ساده، مسیر پرونده.پیوند(پوشه، "n.bz2")، 1)، بایگانی.کدگشایی پرونده بی زیپ دو(مسیر پرونده.پیوند(پوشه، "n.bz2")، بازگشت)، same(بازگشت، متن)
    سرچاپ "ایکس زد، سطح ۹:"، بایگانی.فشرده سازی پرونده ایکس زد با سطح(ساده، مسیر پرونده.پیوند(پوشه، "n.xz")، 9)، بایگانی.کدگشایی پرونده ایکس زد(مسیر پرونده.پیوند(پوشه، "n.xz")، بازگشت)، same(بازگشت، متن)
    سرچاپ "الزد ام ای، سطح ۳:"، بایگانی.فشرده سازی پرونده الزد ام ای با سطح(ساده، مسیر پرونده.پیوند(پوشه، "n.lzma")، 3)، بایگانی.کدگشایی پرونده الزد ام ای(مسیر پرونده.پیوند(پوشه، "n.lzma")، بازگشت)، same(بازگشت، متن)

    ناپایا متغیر_tar_files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده تار>
    متغیر_tar_files.بیفزا(بایگانی.ساخت ورودی پرونده تار از مسیر("docs/notes.txt"، ساده))
    متغیر_tar_files.بیفزا(بایگانی.ساخت ورودی پرونده تار("docs/hello.txt"، "hello" برگردان تهی*، 5، نادرست))
    متغیر_tgz := مسیر پرونده.پیوند(پوشه، "n.tar.zst")
    سرچاپ "تار زستد:"، بایگانی.ساخت پرونده تار زستد با سطح(متغیر_tar_files، متغیر_tgz، 5)

    ناپایا متغیر_zip_files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    متغیر_zip_files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ از مسیر("notes.txt"، ساده، بایگانی.روش زیپ دیفلیت، 0))
    متغیر_secret := "top secret"
    متغیر_zip_files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ رمزدار("secret.txt"، متغیر_secret برگردان تهی*، متغیر_secret.طول()، بایگانی.روش زیپ دیفلیت، 0، "pass"، بایگانی.رمزگذاری زیپ خودکار))
    متغیر_zpath := مسیر پرونده.پیوند(پوشه، "n.zip")
    سرچاپ "زیپ:"، بایگانی.ساخت پرونده زیپ(متغیر_zip_files، متغیر_zpath)، بایگانی.ساخت پرونده زیپ بزرگ(متغیر_zip_files، مسیر پرونده.پیوند(پوشه، "n64.zip"))
    ناپایا پرونده_زیپ := بایگانی.بازکردن پرونده زیپ(متغیر_zpath)
    سرچاپ "مدخل‌ها:"، پرونده_زیپ.شمار، "وضعیت:"، پرونده_زیپ.وضعیت
    سرچاپ "بدون گذرواژه:"، بایگانی.استخراج از پرونده زیپ به پرونده(پرونده_زیپ، "secret.txt"، بازگشت، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ رمزگذاری شده
    بایگانی.تنظیم گذرواژه پرونده زیپ(پرونده_زیپ، "pass")
    سرچاپ "با گذرواژه:"، بایگانی.استخراج از پرونده زیپ به پرونده(پرونده_زیپ، "secret.txt"، بازگشت، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ موفق، same(بازگشت، فشرده سازی.بافر از رشته(متغیر_secret))
    بایگانی.بستن پرونده زیپ(پرونده_زیپ)

    ناپایا متغیر_sz_files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده هفت زد>
    متغیر_sz_files.بیفزا(بایگانی.ساخت ورودی پرونده هفت زد از مسیر("notes.txt"، ساده))
    متغیر_szpath := مسیر پرونده.پیوند(پوشه، "n.7z")
    سرچاپ "هفت زد، سطح ۵:"، بایگانی.ساخت پرونده هفت زد با سطح(متغیر_sz_files، متغیر_szpath، 5)
    ناپایا پرونده_هفت := بایگانی.بازکردن پرونده هفت زد(متغیر_szpath، "")
    سرچاپ "استخراج هفت زد:"، بایگانی.استخراج از پرونده هفت زد به پرونده(پرونده_هفت، "notes.txt"، بازگشت، 0 برگردان صحیح۶۴، 0 برگردان صحیح۶۴)، same(بازگشت، متن)
    بایگانی.بستن پرونده هفت زد(پرونده_هفت)
    سیستم عامل.حذف همه(پوشه)
پایان
