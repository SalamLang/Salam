// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

پایا XZ := """
fd377a585a000004e6d6b44604c05fcf022101160000000000000000bb0ccf6ce0014e00575d0029984986240afb8a34e4
81db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eba071037cdd425338444ede
4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602aacf40a000005b35fff6fd65c4e300017bcf020000005e9efc
63b1c467fb020000000004595a
"""

پایا LZMA := """
5d00008000ffffffffffffffff0029984986240afb8a34e481db780958f3d0144436dd3bb4ca45234051fa042e5be57640
2f66b72801fb0f3b421e32e3eba071037cdd425338444ede4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602ad
8d68e0bcfed44dc0
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_xz_example")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    xz_path := مسیر پرونده.پیوند(dir، "notes.txt.xz")
    lzma_path := مسیر پرونده.پیوند(dir، "notes.txt.lzma")
    out_path := مسیر پرونده.پیوند(dir، "notes.txt")
    بایگانی.نوشتن پرونده دودویی از بافر(xz_path، unhex(XZ))
    بایگانی.نوشتن پرونده دودویی از بافر(lzma_path، unhex(LZMA))

    سرچاپ "ایکس زد:"، بایگانی.کدگشایی پرونده ایکس زد(xz_path، out_path)
    ناپایا ok := نادرست
    text := بایگانی.خواندن پرونده دودویی(out_path، ok)
    سرچاپ ok، text.طول، "بایت"
    سرچاپ "الزد ام ای:"، بایگانی.کدگشایی پرونده الزد ام ای(lzma_path، out_path)
    سرچاپ "قالب نادرست:"، بایگانی.کدگشایی پرونده ایکس زد(lzma_path، out_path)
    سرچاپ "ناموجود:"، بایگانی.کدگشایی پرونده ایکس زد(مسیر پرونده.پیوند(dir، "none.xz")، out_path)
    سیستم عامل.حذف همه(dir)
پایان
