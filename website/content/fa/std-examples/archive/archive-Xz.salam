// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

پایا XZ := """
fd377a585a000004e6d6b44604c05fcf022101160000000000000000bb0ccf6ce0014e00575d0029984986240afb8a34e4
81db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eba071037cdd425338444ede
4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602aacf40a000005b35fff6fd65c4e300017bcf020000005e9efc
63b1c467fb020000000004595a
"""

پایا LZMA := """
5d00008000ffffffffffffffff0029984986240afb8a34e481db780958f3d0144436dd3bb4ca45234051fa042e5be57640
2f66b72801fb0f3b421e32e3eba071037cdd425338444ede4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602ad
8d68e0bcfed44dc0
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := s برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار s.طول() در شمارنده:
        مقدار_محلی := nib(نشانگر_بایت[شمارنده] برگردان صحیح)
        اگر مقدار_محلی کوچکتر 0:
            گذر
        پایان
        اگر بالا کوچکتر 0:
            بالا = مقدار_محلی
        وگرنه:
            فشرده سازی.افزودن بایت(بافر_محلی، بالا * 16 + مقدار_محلی)
            بالا = -1
        پایان
    پایان
    برگشت بافر_محلی
پایان

تابع ریشه:
    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_xz_example")
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه)
    متغیر_xz_path := مسیر پرونده.پیوند(پوشه، "notes.txt.xz")
    متغیر_lzma_path := مسیر پرونده.پیوند(پوشه، "notes.txt.lzma")
    متغیر_out_path := مسیر پرونده.پیوند(پوشه، "notes.txt")
    بایگانی.نوشتن پرونده دودویی از بافر(متغیر_xz_path، unhex(XZ))
    بایگانی.نوشتن پرونده دودویی از بافر(متغیر_lzma_path، unhex(LZMA))

    سرچاپ "ایکس زد:"، بایگانی.کدگشایی پرونده ایکس زد(متغیر_xz_path، متغیر_out_path)
    ناپایا موفق := نادرست
    متن := بایگانی.خواندن پرونده دودویی(متغیر_out_path، موفق)
    سرچاپ موفق، متن.طول، "بایت"
    سرچاپ "الزد ام ای:"، بایگانی.کدگشایی پرونده الزد ام ای(متغیر_lzma_path، متغیر_out_path)
    سرچاپ "قالب نادرست:"، بایگانی.کدگشایی پرونده ایکس زد(متغیر_lzma_path، متغیر_out_path)
    سرچاپ "ناموجود:"، بایگانی.کدگشایی پرونده ایکس زد(مسیر پرونده.پیوند(پوشه، "none.xz")، متغیر_out_path)

    ساده := مسیر پرونده.پیوند(پوشه، "plain.txt")
    بایگانی.نوشتن پرونده دودویی از بافر(ساده، متن)
    بسته_شده := مسیر پرونده.پیوند(پوشه، "plain.txt.xz")
    سرچاپ "فشرده ایکس زد:"، بایگانی.فشرده سازی پرونده ایکس زد(ساده، بسته_شده)، بایگانی.کدگشایی پرونده ایکس زد(بسته_شده، متغیر_out_path)
    سرچاپ "فشرده الزد ام ای:"، بایگانی.فشرده سازی پرونده الزد ام ای(ساده، متغیر_lzma_path)، بایگانی.کدگشایی پرونده الزد ام ای(متغیر_lzma_path، متغیر_out_path)
    سرچاپ "فشرده ناموجود:"، بایگانی.فشرده سازی پرونده ایکس زد(مسیر پرونده.پیوند(پوشه، "none.txt")، بسته_شده)
    سیستم عامل.حذف همه(پوشه)
پایان
