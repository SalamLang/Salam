واردسازی بایگانی
واردسازی فشرده سازی

روال ریشه:
    متن := "سلام بایگانی، سلام بایگانی، سلام بایگانی"
    ب := فشرده سازی.بافر از رشته(متن)
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("docs/"، پوچ، ۰، ۰))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("docs/a.txt"، ب.data، ب.len، ۸))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("b.txt"، ب.data، ۵، ۰))
    ز := بایگانی.ساخت زیپ(پرونده‌ها)
    ناپایا فهرست := بایگانی.فهرست زیپ(ز.data، ز.len)
    هر م در فهرست:
        سرچاپ م.name، م.size، م.compressed_size < م.size، م.is_dir، م.method
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    ناپایا خوب := نادرست
    الف := بایگانی.استخراج با نام از زیپ(ز.data، ز.len، "docs/a.txt"، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(الف) == متن
    _ := بایگانی.استخراج با نام از زیپ(ز.data، ز.len، "نیست"، خوب)
    سرچاپ خوب
    سرچاپ بایگانی.ساخت پرونده زیپ(پرونده‌ها، "out.zip")، بایگانی.استخراج همه از زیپ(ز.data، ز.len، "unzipped")
    خوانده := بایگانی.خواندن پرونده دودویی("unzipped/docs/a.txt"، خوب)
    سرچاپ خوب، خوانده.len == ب.len
    سرچاپ بایگانی.آیا آر ای آر است(ز.data، ز.len)، بایگانی.فهرست آر ای آر(ز.data، ز.len).طول()
    _ := بایگانی.استخراج با نام از آر ای آر(ز.data، ز.len، "x"، خوب)
    سرچاپ خوب، بایگانی.استخراج همه از آر ای آر(ز.data، ز.len، "rar-out")
پایان
