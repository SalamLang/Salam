واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    متن := "سلام بایگانی، سلام بایگانی، سلام بایگانی"
    ب := فشرده سازی.بافر از رشته(متن)
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("docs/"، پوچ، ۰، ۰))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("docs/a.txt"، ب.داده، ب.طول، ۸))
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("b.txt"، ب.داده، ۵، ۰))
    ز := بایگانی.ساخت زیپ(پرونده‌ها)
    ناپایا فهرست := بایگانی.فهرست زیپ(ز.داده، ز.طول)
    هر م در فهرست:
        سرچاپ م.نام، م.اندازه، م.اندازه فشرده < م.اندازه، م.پوشه، م.روش
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    ناپایا خوب := نادرست
    الف := بایگانی.استخراج با نام از زیپ(ز.داده، ز.طول، "docs/a.txt"، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(الف) == متن
    _ := بایگانی.استخراج با نام از زیپ(ز.داده، ز.طول، "نیست"، خوب)
    سرچاپ خوب
    سرچاپ بایگانی.ساخت پرونده زیپ(پرونده‌ها، "out.zip")، بایگانی.استخراج همه از زیپ(ز.داده، ز.طول، "unzipped")
    خوانده := بایگانی.خواندن پرونده دودویی("unzipped/docs/a.txt"، خوب)
    سرچاپ خوب، خوانده.طول == ب.طول
    سرچاپ بایگانی.آر ای آر است(ز.داده، ز.طول)، بایگانی.فهرست آر ای آر(ز.داده، ز.طول).طول()
    _ := بایگانی.استخراج با نام از آر ای آر(ز.داده، ز.طول، "x"، خوب)
    سرچاپ خوب، بایگانی.استخراج همه از آر ای آر(ز.داده، ز.طول، "rar-out")
پایان
