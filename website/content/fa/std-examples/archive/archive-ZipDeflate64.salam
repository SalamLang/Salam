واردسازی بایگانی
واردسازی فشرده سازی

تابع hex_val(c: صحیح): صحیح:
    اگر c بزرگتربرابر 97: برگشت c - 87 پایان
    برگشت c - 48
پایان

تابع unhex(h: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := h برگردان طبیعی۸*
    ناپایا شمارنده := 0
    تا شمارنده + 1 کوچکتر h.طول():
        فشرده سازی.افزودن بایت(بافر_محلی، hex_val(نشانگر_بایت[شمارنده] برگردان صحیح) * 16 + hex_val(نشانگر_بایت[شمارنده + 1] برگردان صحیح))
        شمارنده += 2
    پایان
    برگشت بافر_محلی
پایان

تابع ریشه:
    زد := unhex("")
    ناپایا ورودی‌ها := بایگانی.فهرست زیپ(زد.داده، زد.طول)
    هر عنصر در ورودی‌ها:
        سرچاپ عنصر.نام، عنصر.اندازه، عنصر.اندازه فشرده، عنصر.روش برابر بایگانی.روش زیپ دیفلیت۶۴
    پایان
    بایگانی.آزادسازی فهرست(ورودی‌ها)
    ناپایا وضعیت := 0
    متن := بایگانی.استخراج تایید شده از زیپ(زد.داده، زد.طول، "t.txt"، 0، وضعیت)
    سرچاپ وضعیت برابر بایگانی.زیپ موفق، فشرده سازی.بافر به رشته(متن)
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("t.txt"، متن.داده، متن.طول، بایگانی.روش زیپ دیفلیت۶۴))
    متغیر_written := بایگانی.ساخت زیپ(پرونده‌ها)
    ناپایا بازگشت := بایگانی.فهرست زیپ(متغیر_written.داده، متغیر_written.طول)
    سرچاپ "written with method"، بازگشت.بگیر(0).روش
    بایگانی.آزادسازی فهرست(بازگشت)
پایان
