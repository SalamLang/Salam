واردسازی بایگانی
واردسازی فشرده سازی

تابع hex_val(c: صحیح): صحیح:
    اگر c بزرگتربرابر 97: برگشت c - 87 پایان
    برگشت c - 48
پایان

تابع unhex(h: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := h برگردان طبیعی۸*
    ناپایا i := 0
    تا i + 1 کوچکتر h.طول():
        فشرده سازی.افزودن بایت(b، hex_val(bp[i] برگردان صحیح) * 16 + hex_val(bp[i + 1] برگردان صحیح))
        i += 2
    پایان
    برگشت b
پایان

تابع ریشه:
    z := unhex("")
    ناپایا entries := بایگانی.فهرست زیپ(z.داده، z.طول)
    هر e در entries:
        سرچاپ e.نام، e.اندازه، e.اندازه فشرده، e.روش برابر بایگانی.روش زیپ دیفلیت۶۴
    پایان
    بایگانی.آزادسازی فهرست(entries)
    ناپایا status := 0
    text := بایگانی.استخراج تایید شده از زیپ(z.داده، z.طول، "t.txt"، 0، status)
    سرچاپ status برابر بایگانی.زیپ موفق، فشرده سازی.بافر به رشته(text)
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("t.txt"، text.داده، text.طول، بایگانی.روش زیپ دیفلیت۶۴))
    written := بایگانی.ساخت زیپ(files)
    ناپایا back := بایگانی.فهرست زیپ(written.داده، written.طول)
    سرچاپ "written with method"، back.بگیر(0).روش
    بایگانی.آزادسازی فهرست(back)
پایان
