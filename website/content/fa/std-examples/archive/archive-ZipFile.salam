// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل

تابع ریشه:
    بدنه := "a large file would be unpacked straight to disk\n"
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("data/log.txt"، بدنه برگردان تهی*، بدنه.طول()، 8))
    ناپایا ساخته := بایگانی.ساخت زیپ(پرونده‌ها)
    پرونده‌ها.آزادکن()
    بایگانی.نوشتن پرونده دودویی از بافر("made.zip"، ساخته)
    فشرده سازی.آزادسازی بافر(ساخته)

    ناپایا پرونده_زیپ := بایگانی.بازکردن پرونده زیپ("made.zip")
    ناپایا ورودی‌ها := بایگانی.مدخل های پرونده زیپ(پرونده_زیپ)
    هر عنصر در ورودی‌ها:
        سرچاپ عنصر.نام، عنصر.اندازه
    پایان
    بایگانی.آزادسازی فهرست(ورودی‌ها)

    سرچاپ بایگانی.استخراج از پرونده زیپ به پرونده(پرونده_زیپ، "data/log.txt"، "log.out"، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ موفق
    سرچاپ بایگانی.استخراج از پرونده زیپ به پرونده(پرونده_زیپ، "data/log.txt"، "log.out"، 10 برگردان صحیح۶۴) برابر بایگانی.زیپ بیش از حد بزرگ
    بایگانی.بستن پرونده زیپ(پرونده_زیپ)
    سیستم عامل.حذف("made.zip")
    سیستم عامل.حذف("log.out")
پایان
