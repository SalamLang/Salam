// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل

تابع ریشه:
    body := "a large file would be unpacked straight to disk\n"
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("data/log.txt"، body برگردان تهی*، body.طول()، 8))
    ناپایا made := بایگانی.ساخت زیپ(files)
    files.آزادکن()
    بایگانی.نوشتن پرونده دودویی از بافر("made.zip"، made)
    فشرده سازی.آزادسازی بافر(made)

    ناپایا zf := بایگانی.بازکردن پرونده زیپ("made.zip")
    ناپایا entries := بایگانی.مدخل های پرونده زیپ(zf)
    هر e در entries:
        سرچاپ e.نام، e.اندازه
    پایان
    بایگانی.آزادسازی فهرست(entries)

    سرچاپ بایگانی.استخراج از پرونده زیپ به پرونده(zf، "data/log.txt"، "log.out"، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ موفق
    سرچاپ بایگانی.استخراج از پرونده زیپ به پرونده(zf، "data/log.txt"، "log.out"، 10 برگردان صحیح۶۴) برابر بایگانی.زیپ بیش از حد بزرگ
    بایگانی.بستن پرونده زیپ(zf)
    سیستم عامل.حذف("made.zip")
    سیستم عامل.حذف("log.out")
پایان
