// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی رشته

تابع ریشه:
    ناپایا متن := فشرده سازی.بافر بایت جدید()
    تکرار 80 در شمارنده:
        خط := "line " + رشته.از عدد(شمارنده * 7 % 23) + ": zip entries can use several methods\n"
        فشرده سازی.افزودن بایت‌ها(متن، خط برگردان تهی*، خط.طول())
    پایان
    سرچاپ "متن:"، متن.طول، "بایت"
    نام‌ها := ["ذخیره"، "دیفلیت"، "بی‌زیپ۲"، "الزد ام ای"، "زد استاندارد"]
    متغیر_methods := [بایگانی.روش زیپ ذخیره، بایگانی.روش زیپ دیفلیت، بایگانی.روش زیپ بی زیپ دو، بایگانی.روش زیپ الزد ام ای، بایگانی.روش زیپ زد استاندارد]
    تکرار 5 در شمارنده:
        ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
        پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("notes.txt"، متن.داده، متن.طول، متغیر_methods[شمارنده]))
        زد := بایگانی.ساخت زیپ(پرونده‌ها)
        ناپایا متغیر_checked := 0
        ناپایا وضعیت := 0
        بازگشت := بایگانی.استخراج تایید شده از زیپ(زد.داده، زد.طول، "notes.txt"، 0، وضعیت)
        سرچاپ نام‌ها[شمارنده]، "روش"، متغیر_methods[شمارنده]، "زیپ"، زد.طول، "بایت، بررسی"، بایگانی.بررسی زیپ(زد.داده، زد.طول، متغیر_checked)، "متن یکسان"، وضعیت برابر 0 و فشرده سازی.برابری بافر(بازگشت، متن)
    پایان

    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ با سطح("fast.txt"، متن.داده، متن.طول، بایگانی.روش زیپ زد استاندارد، 1))
    ناپایا بهترین := بایگانی.ساخت ورودی پرونده زیپ("best.txt"، متن.داده، متن.طول، بایگانی.روش زیپ زد استاندارد)
    بهترین.سطح = 19
    پرونده‌ها.بیفزا(بهترین)
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("empty.txt"، پوچ، 0، بایگانی.روش زیپ بی زیپ دو))
    زد := بایگانی.ساخت زیپ(پرونده‌ها)
    ناپایا ورودی‌ها := بایگانی.فهرست زیپ(زد.داده، زد.طول)
    هر عنصر در ورودی‌ها:
        سرچاپ عنصر.نام، "روش"، عنصر.روش، عنصر.اندازه، "←"، عنصر.اندازه فشرده
    پایان
    بایگانی.آزادسازی فهرست(ورودی‌ها)
پایان
