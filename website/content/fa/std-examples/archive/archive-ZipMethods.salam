// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی رشته

تابع ریشه:
    ناپایا text := فشرده سازی.بافر بایت جدید()
    تکرار 80 در i:
        line := "line " + رشته.از عدد(i * 7 % 23) + ": zip entries can use several methods\n"
        فشرده سازی.افزودن بایت‌ها(text، line برگردان تهی*، line.طول())
    پایان
    سرچاپ "متن:"، text.طول، "بایت"
    names := ["ذخیره"، "دیفلیت"، "بی‌زیپ۲"، "الزد ام ای"، "زد استاندارد"]
    methods := [بایگانی.روش زیپ ذخیره، بایگانی.روش زیپ دیفلیت، بایگانی.روش زیپ بی زیپ دو، بایگانی.روش زیپ الزد ام ای، بایگانی.روش زیپ زد استاندارد]
    تکرار 5 در i:
        ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
        files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("notes.txt"، text.داده، text.طول، methods[i]))
        z := بایگانی.ساخت زیپ(files)
        ناپایا checked := 0
        ناپایا status := 0
        back := بایگانی.استخراج تایید شده از زیپ(z.داده، z.طول، "notes.txt"، 0، status)
        سرچاپ names[i]، "روش"، methods[i]، "زیپ"، z.طول، "بایت، بررسی"، بایگانی.بررسی زیپ(z.داده، z.طول، checked)، "متن یکسان"، status برابر 0 و فشرده سازی.برابری بافر(back، text)
    پایان

    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ با سطح("fast.txt"، text.داده، text.طول، بایگانی.روش زیپ زد استاندارد، 1))
    ناپایا best := بایگانی.ساخت ورودی پرونده زیپ("best.txt"، text.داده، text.طول، بایگانی.روش زیپ زد استاندارد)
    best.سطح = 19
    files.بیفزا(best)
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("empty.txt"، پوچ، 0، بایگانی.روش زیپ بی زیپ دو))
    z := بایگانی.ساخت زیپ(files)
    ناپایا entries := بایگانی.فهرست زیپ(z.داده، z.طول)
    هر e در entries:
        سرچاپ e.نام، "روش"، e.روش، e.اندازه، "←"، e.اندازه فشرده
    پایان
    بایگانی.آزادسازی فهرست(entries)
پایان
