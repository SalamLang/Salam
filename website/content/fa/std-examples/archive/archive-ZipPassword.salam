تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        c := bp[i] برگردان صحیح
        ناپایا v := -1
        اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
            v = c - 48
        وگرنه c بزرگتربرابر 97 و c کوچکتربرابر 102:
            v = c - 87
        پایان
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع ریشه:
    بایگانی.نوشتن پرونده دودویی از بافر("secret.zip"، unhex(HEX))
    ناپایا zf := بایگانی.بازکردن پرونده زیپ("secret.zip")
    سرچاپ بایگانی.استخراج از پرونده زیپ به پرونده(zf، "t.txt"، "t.out"، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ رمزگذاری شده
    بایگانی.تنظیم گذرواژه پرونده زیپ(zf، "nope")
    سرچاپ بایگانی.استخراج از پرونده زیپ به پرونده(zf، "t.txt"، "t.out"، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ گذرواژه اشتباه
    بایگانی.تنظیم گذرواژه پرونده زیپ(zf، "pw123")
    سرچاپ بایگانی.استخراج از پرونده زیپ به پرونده(zf، "t.txt"، "t.out"، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ موفق
    بایگانی.بستن پرونده زیپ(zf)
    سیستم عامل.حذف("secret.zip")
    سیستم عامل.حذف("t.out")
پایان
