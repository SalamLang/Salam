// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل

تابع ریشه:
    ناپایا data := فشرده سازی.بافر بایت جدید با ظرفیت(150000)
    تکرار 150000 در i:
        فشرده سازی.افزودن بایت(data، 65 + i % 23)
    پایان
    ناپایا files := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    files.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("big.bin"، data.داده، data.طول، 0))
    سرچاپ بایگانی.ساخت پرونده زیپ چندقطعه ای(files، "split.zip"، 65536 برگردان صحیح۶۴، بایگانی.زیپ قطعه دیسکی)
    files.آزادکن()
    فشرده سازی.آزادسازی بافر(data)

    ناپایا zf := بایگانی.بازکردن پرونده زیپ("split.zip")
    سرچاپ zf.وضعیت برابر بایگانی.زیپ موفق، zf.شمار، zf.قطعه ها.طول()
    سرچاپ بایگانی.استخراج از پرونده زیپ به پرونده(zf، "big.bin"، "big.out"، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ موفق، سیستم عامل.اندازه پرونده("big.out")
    بایگانی.بستن پرونده زیپ(zf)
    سیستم عامل.حذف("big.out")
    سیستم عامل.حذف("split.z01")
    سیستم عامل.حذف("split.z02")
    سیستم عامل.حذف("split.zip")
پایان
