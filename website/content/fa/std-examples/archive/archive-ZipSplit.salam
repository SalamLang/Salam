// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی سیستم عامل

تابع ریشه:
    ناپایا داده := فشرده سازی.بافر بایت جدید با ظرفیت(150000)
    تکرار 150000 در شمارنده:
        فشرده سازی.افزودن بایت(داده، 65 + شمارنده % 23)
    پایان
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("big.bin"، داده.داده، داده.طول، 0))
    سرچاپ بایگانی.ساخت پرونده زیپ چندقطعه ای(پرونده‌ها، "split.zip"، 65536 برگردان صحیح۶۴، بایگانی.زیپ قطعه دیسکی)
    پرونده‌ها.آزادکن()
    فشرده سازی.آزادسازی بافر(داده)

    ناپایا پرونده_زیپ := بایگانی.بازکردن پرونده زیپ("split.zip")
    سرچاپ پرونده_زیپ.وضعیت برابر بایگانی.زیپ موفق، پرونده_زیپ.شمار، پرونده_زیپ.قطعه ها.طول()
    سرچاپ بایگانی.استخراج از پرونده زیپ به پرونده(پرونده_زیپ، "big.bin"، "big.out"، 0 برگردان صحیح۶۴) برابر بایگانی.زیپ موفق، سیستم عامل.اندازه پرونده("big.out")
    بایگانی.بستن پرونده زیپ(پرونده_زیپ)
    سیستم عامل.حذف("big.out")
    سیستم عامل.حذف("split.z01")
    سیستم عامل.حذف("split.z02")
    سیستم عامل.حذف("split.zip")
پایان
