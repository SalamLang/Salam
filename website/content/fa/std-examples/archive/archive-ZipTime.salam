// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی

تابع ریشه:
    متن := "سلام، سلام، سلام"
    ب := فشرده سازی.بافر از رشته(متن)
    ناپایا نام‌دار := بایگانی.ساخت ورودی پرونده زیپ("سلام.txt"، ب.داده، ب.طول، 8)
    نام‌دار.زمان تغییر = 1700000000 برگردان صحیح۶۴
    ناپایا پرونده‌ها := وکتور {} برگردان وکتور<بایگانی.ورودی پرونده زیپ>
    پرونده‌ها.بیفزا(نام‌دار)
    پرونده‌ها.بیفزا(بایگانی.ساخت ورودی پرونده زیپ("plain.txt"، ب.داده، ب.طول، 8))
    ز := بایگانی.ساخت زیپ(پرونده‌ها)
    ناپایا فهرست := بایگانی.فهرست زیپ(ز.داده، ز.طول)
    هر م در فهرست:
        سرچاپ م.نام، م.زمان تغییر
    پایان
    بایگانی.آزادسازی فهرست(فهرست)
    سرچاپ "پرچم UTF-8:"، (بایگانی.خواندن شانزده بیتی کم ارزش‌اول(ز.داده، 6) & 0x800) نابرابر 0

    بزرگ := بایگانی.ساخت زیپ بزرگ(پرونده‌ها)
    ناپایا دوباره := بایگانی.فهرست زیپ(بزرگ.داده، بزرگ.طول)
    سرچاپ دوباره.طول()، بزرگ.طول بزرگتر ز.طول، دوباره.بگیر(0).اندازه
    بایگانی.آزادسازی فهرست(دوباره)
    ناپایا بررسی‌شده := 0
    سرچاپ بایگانی.بررسی زیپ(بزرگ.داده، بزرگ.طول، بررسی‌شده)، بررسی‌شده
پایان
