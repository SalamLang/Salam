// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    dir := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_zstd_example")
    سیستم عامل.حذف همه(dir)
    سیستم عامل.ساخت پوشه ها(dir)
    plain := مسیر پرونده.پیوند(dir، "notes.txt")
    packed := مسیر پرونده.پیوند(dir، "notes.txt.zst")
    back := مسیر پرونده.پیوند(dir، "notes.back")
    text := فشرده سازی.بافر از رشته("Salam keeps notes in plain files. ".تکرار(50))
    بایگانی.نوشتن پرونده دودویی از بافر(plain، text)

    سرچاپ "فشرده‌سازی:"، بایگانی.فشرده سازی پرونده زستد(plain، packed)
    ناپایا ok := نادرست
    z := بایگانی.خواندن پرونده دودویی(packed، ok)
    سرچاپ ok، z.طول، "بایت،"، فشرده سازی.زستد است بافر(z)
    سرچاپ "کدگشایی:"، بایگانی.کدگشایی پرونده زستد(packed، back)
    again := بایگانی.خواندن پرونده دودویی(back، ok)
    سرچاپ فشرده سازی.برابری بافر(again، text)
    سرچاپ "سطح ۱۹:"، بایگانی.فشرده سازی پرونده زستد با سطح(plain، packed، 19)
    سرچاپ "قالب نادرست:"، بایگانی.کدگشایی پرونده زستد(plain، back)
    سرچاپ "ناموجود:"، بایگانی.کدگشایی پرونده زستد(مسیر پرونده.پیوند(dir، "none.zst")، back)
    سیستم عامل.حذف همه(dir)
پایان
