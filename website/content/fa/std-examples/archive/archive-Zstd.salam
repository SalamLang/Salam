// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی سیستم عامل

تابع ریشه:
    پوشه := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_zstd_example")
    سیستم عامل.حذف همه(پوشه)
    سیستم عامل.ساخت پوشه ها(پوشه)
    ساده := مسیر پرونده.پیوند(پوشه، "notes.txt")
    بسته_شده := مسیر پرونده.پیوند(پوشه، "notes.txt.zst")
    بازگشت := مسیر پرونده.پیوند(پوشه، "notes.back")
    متن := فشرده سازی.بافر از رشته("Salam keeps notes in plain files. ".تکرار(50))
    بایگانی.نوشتن پرونده دودویی از بافر(ساده، متن)

    سرچاپ "فشرده‌سازی:"، بایگانی.فشرده سازی پرونده زستد(ساده، بسته_شده)
    ناپایا موفق := نادرست
    زد := بایگانی.خواندن پرونده دودویی(بسته_شده، موفق)
    سرچاپ موفق، زد.طول، "بایت،"، فشرده سازی.زستد است بافر(زد)
    سرچاپ "کدگشایی:"، بایگانی.کدگشایی پرونده زستد(بسته_شده، بازگشت)
    دوباره := بایگانی.خواندن پرونده دودویی(بازگشت، موفق)
    سرچاپ فشرده سازی.برابری بافر(دوباره، متن)
    سرچاپ "سطح ۱۹:"، بایگانی.فشرده سازی پرونده زستد با سطح(ساده، بسته_شده، 19)
    سرچاپ "قالب نادرست:"، بایگانی.کدگشایی پرونده زستد(ساده، بازگشت)
    سرچاپ "ناموجود:"، بایگانی.کدگشایی پرونده زستد(مسیر پرونده.پیوند(پوشه، "none.zst")، بازگشت)
    سیستم عامل.حذف همه(پوشه)
پایان
