واردسازی اتمی

ناپایا شمارنده := اتمی.صحیح۶۴ {}

روال کارگر():
    تکرار ۱۰۰۰:
        اتمی.افزودن(شمارنده، ۱)
    پایان
پایان

روال ریشه:
    شمارنده = اتمی.صحیح۶۴ جدید(۰)
    الف := spawn(کارگر)
    ب := spawn(کارگر)
    join(الف)
    join(ب)
    سرچاپ اتمی.بارگذاری(شمارنده)
    اتمی.ذخیره(شمارنده، ۱۰)
    سرچاپ اتمی.تعویض(شمارنده، ۲۰)، اتمی.بارگذاری(شمارنده)
    سرچاپ اتمی.مقایسه سپس تعویض(شمارنده، ۲۰، ۳۰)، اتمی.مقایسه سپس تعویض(شمارنده، ۲۰، ۴۰)، اتمی.بارگذاری(شمارنده)
    اتمی.نابودسازی صحیح۶۴(شمارنده)
    پ := اتمی.پرچم جدید(نادرست)
    سرچاپ اتمی.آزمون سپس تنظیم(پ)، اتمی.آزمون سپس تنظیم(پ)، اتمی.گرفتن(پ)
    اتمی.تنظیم(پ، نادرست)
    سرچاپ اتمی.گرفتن(پ)
    اتمی.نابودسازی پرچم(پ)
پایان
