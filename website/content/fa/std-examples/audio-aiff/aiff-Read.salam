تابع ریشه:
    ناپایا کلیپ := صدا.جدید(44100، 2، 64)
    صدا.تنظیم نمونه(کلیپ، 7، 1، 0.5)
    بافه := ایف.کدگذاری ایف با بیت(کلیپ، 24)
    سرچاپ ایف.ایف است(بافه.داده، بافه.طول)، ایف.ایف است(بافه.داده، 4)
    سرچاپ صدا.نام قالب(صدا.شناسایی قالب(بافه.داده، بافه.طول))

    ناپایا مش := ایف.مشترک {}
    سرچاپ ایف.خواندن مشترک(بافه.داده، بافه.طول، مش)
    سرچاپ مش.کانال ها، مش.فریم ها، مش.بیت ها، مش.نرخ
    سرچاپ مش.روش فشرده برابر ایف.فشرده هیچ، مش.اندازه داده

    ناپایا درستی := نادرست
    آگاه := ایف.بررسی ایف(بافه.داده، بافه.طول، درستی)
    سرچاپ درستی، آگاه.نرخ، آگاه.کانال ها، آگاه.بیت ها، آگاه.فریم ها، آگاه.بی اتلاف

    ناپایا درستی۲ := نادرست
    برگشته := ایف.کدگشایی ایف(بافه.داده، بافه.طول، درستی۲)
    سرچاپ درستی۲، برگشته.فریم ها، برگشته.بیت ها، صدا.نمونه(برگشته، 7، 1)

    هر نرخی در [8000، 22050، 44100، 96000]:
        ناپایا یکی := صدا.جدید(نرخی، 1، 2)
        بررسی۲ := ایف.کدگذاری ایف با بیت(یکی، 16)
        ناپایا مش۲ := ایف.مشترک {}
        ایف.خواندن مشترک(بررسی۲.داده، بررسی۲.طول، مش۲)
        سرچاپ نرخی، مش۲.نرخ برابر نرخی
        فشرده سازی.آزادسازی بافر(بررسی۲)
        صدا.آزادسازی(یکی)
    پایان

    سرچاپ فشرده سازی.طول بافر(ایف.کدگذاری ایف با بیت(کلیپ، 12))، فشرده سازی.طول بافر(ایف.کدگذاری ایف(صدا.قطعه {}))

    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_aiff_example.aiff")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ ایف.ذخیره ایف با بیت(کلیپ، نشانی، 16)
    ناپایا درستی۳ := نادرست
    دیسکی := ایف.بازکردن ایف(نشانی، درستی۳)
    سرچاپ درستی۳، دیسکی.بیت ها، دیسکی.فریم ها
    ناپایا رفته := نادرست
    نبود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_aiff_none.aiff")
    دیرکن حافظه.آزادسازی(نبود برگردان تهی*)
    ایف.بازکردن ایف(نبود، رفته)
    سرچاپ رفته

    فشرده سازی.آزادسازی بافر(بافه)
    صدا.آزادسازی(کلیپ)
    صدا.آزادسازی(برگشته)
    صدا.آزادسازی(دیسکی)
