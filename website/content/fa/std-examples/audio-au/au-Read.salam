تابع ریشه:
    ناپایا کلیپ := صدا.جدید(22050، 1، 64)
    صدا.تنظیم نمونه(کلیپ، 3، 0، 0.5)
    بافه := ای‌یو.کدگذاری ای‌یو با رمز(کلیپ، ای‌یو.رمز پی‌سی‌ام۱۶)
    سرچاپ ای‌یو.ای‌یو است(بافه.داده، بافه.طول)، ای‌یو.ای‌یو است(بافه.داده، 8)
    سرچاپ صدا.نام قالب(صدا.شناسایی قالب(بافه.داده، بافه.طول))

    ناپایا سر := ای‌یو.سرآیند {}
    سرچاپ ای‌یو.خواندن سرآیند(بافه.داده، بافه.طول، سر)
    سرچاپ سر.جای داده برابر ای‌یو.اندازه سرآیند، سر.رمزگذاری برابر ای‌یو.رمز پی‌سی‌ام۱۶
    سرچاپ سر.نرخ، سر.کانال ها، سر.اندازه داده

    ناپایا درستی := نادرست
    آگاه := ای‌یو.بررسی ای‌یو(بافه.داده، بافه.طول، درستی)
    سرچاپ درستی، آگاه.نرخ، آگاه.کانال ها، آگاه.بیت ها، آگاه.فریم ها، آگاه.بی اتلاف

    ناپایا درستی۲ := نادرست
    برگشته := ای‌یو.کدگشایی ای‌یو(بافه.داده، بافه.طول، درستی۲)
    سرچاپ درستی۲، برگشته.فریم ها، برگشته.بیت ها، صدا.نمونه(برگشته، 3، 0)

    بافه۲ := ای‌یو.کدگذاری ای‌یو با رمز(کلیپ، ای‌یو.رمز اعشار۳۲)
    ناپایا درستی۳ := نادرست
    برگشته۲ := ای‌یو.کدگشایی ای‌یو(بافه۲.داده، بافه۲.طول، درستی۳)
    سرچاپ درستی۳، برگشته۲.بیت ها، صدا.نمونه(برگشته۲، 3، 0) برابر صدا.نمونه(کلیپ، 3، 0)

    بافه۳ := ای‌یو.کدگذاری ای‌یو با رمز(کلیپ، ای‌یو.رمز میولا)
    ناپایا درستی۴ := نادرست
    برگشته۳ := ای‌یو.کدگشایی ای‌یو(بافه۳.داده، بافه۳.طول، درستی۴)
    سرچاپ درستی۴، برگشته۳.بیت ها، ریاضی.قدرمطلق(صدا.نمونه(برگشته۳، 3، 0) - 0.5) کوچکتر 0.02
    ناپایا درستی۵ := نادرست
    سرچاپ ای‌یو.بررسی ای‌یو(بافه۳.داده، بافه۳.طول، درستی۵).بی اتلاف
    سرچاپ فشرده سازی.طول بافر(بافه۳) برابر ای‌یو.اندازه سرآیند + 64

