واردسازی صدا
واردسازی صدا.کدک
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    سرچاپ کدک.کدگشایی شدنی(صدا.قالب ویو)، کدک.کدگذاری شدنی(صدا.قالب ویو)
    سرچاپ کدک.کدگشایی شدنی(صدا.قالب ام‌پی‌تری)، کدک.کدگذاری شدنی(صدا.قالب فلاک)
    سرچاپ کدک.قالب‌ها().طول()، کدک.قالب‌ها().بگیر(0) برابر صدا.قالب ویو

    ناپایا کلیپ := صدا.جدید(22050، 2، 64)
    صدا.تنظیم نمونه(کلیپ، 5، 0، 0.5)
    صدا.تنظیم نمونه(کلیپ، 5، 1، -0.25)

    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_codec_open.wav")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ کدک.ذخیره(کلیپ، نشانی)
    ناپایا درستی := نادرست
    برگشته := کدک.بازکردن(نشانی، درستی)
    سرچاپ درستی، برگشته.فریم ها، برگشته.کانال ها، برگشته.نرخ، برگشته.بیت ها
    سرچاپ صدا.نمونه(برگشته، 5، 0)، صدا.نمونه(برگشته، 5، 1)

    ناپایا درستی۲ := نادرست
    آگاه := کدک.بررسی پرونده(نشانی، درستی۲)
    سرچاپ درستی۲، صدا.نام قالب(آگاه.قالب)، آگاه.فریم ها، آگاه.بیت ها، آگاه.بی اتلاف

    بافه := کدک.کدگذاری(کلیپ، صدا.قالب ویو)
    سرچاپ فشرده سازی.طول بافر(بافه) برابر 44 + 64 * 2 * 2
    ناپایا درستی۳ := نادرست
    حافظه۱ := کدک.کدگشایی(بافه.داده، بافه.طول، درستی۳)
    سرچاپ درستی۳، حافظه۱.فریم ها
    ناپایا درستی۴ := نادرست
    حافظه۲ := کدک.بررسی(بافه.داده، بافه.طول، درستی۴)
    سرچاپ درستی۴، حافظه۲.کانال ها

    امپیتری := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_codec_open.mp3")
    دیرکن حافظه.آزادسازی(امپیتری برگردان تهی*)
    سرچاپ کدک.ذخیره(کلیپ، امپیتری)
    سرچاپ فشرده سازی.طول بافر(کدک.کدگذاری(کلیپ، صدا.قالب ام‌پی‌تری))
    ناپایا خراب := نادرست
    ناپایا آشغال := فشرده سازی.بافر بایت جدید()
    ناپایا شمارنده := 0
    تا شمارنده کوچکتر 16:
        فشرده سازی.افزودن بایت(آشغال، شمارنده)
        شمارنده += 1
    پایان
    کدک.کدگشایی(آشغال.داده، آشغال.طول، خراب)
    سرچاپ خراب
    ناپایا رفته := نادرست
    نبود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_codec_nope.wav")
    دیرکن حافظه.آزادسازی(نبود برگردان تهی*)
    کدک.بازکردن(نبود، رفته)
    سرچاپ رفته
    فشرده سازی.آزادسازی بافر(بافه)
    فشرده سازی.آزادسازی بافر(آشغال)
    صدا.آزادسازی(کلیپ)
    صدا.آزادسازی(برگشته)
    صدا.آزادسازی(حافظه۱)
پایان
