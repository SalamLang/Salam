واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی صدا.صداساز
واردسازی ریاضی

تابع ریشه:
    بم := صداساز.نوا(110.0، 0.1، 22050، صداساز.موج سینوسی)
    زیر := صداساز.نوا(1760.0، 0.1، 22050، صداساز.موج سینوسی)
    سرچاپ پردازش سیگنال.نرخ صفرگذر(زیر) بزرگتر پردازش سیگنال.نرخ صفرگذر(بم) * 4.0
    سرچاپ پردازش سیگنال.نرخ صفرگذر(صدا.قطعه {})

    هر بسامد در [220.0، 440.0]:
        نوایی := صداساز.نوا(بسامد، 0.1، 22050، صداساز.موج سینوسی)
        یافته := پردازش سیگنال.شناسایی زیروبمی(نوایی، 0، 2048)
        سرچاپ ریاضی.قدرمطلق(یافته - بسامد) / بسامد کوچکتر 0.05
        ناپایا دور := نوایی
        صدا.آزادسازی(دور)
    پایان
    سرچاپ پردازش سیگنال.شناسایی زیروبمی(صدا.قطعه {}، 0، 2048)

    پرمایه := صداساز.افزایشی(220.0، 8، 0.7، 0.12، 22050)
    ناپایا طیفی := پردازش سیگنال.تبدیل فوریه کوتاه(پرمایه، 1024، 256، پردازش سیگنال.پنجره هان)
    سرچاپ طیفی.خانه‌ها، طیفی.نرخ، طیفی.گام، طیفی.فریم ها بزرگتر 1
    سرچاپ پردازش سیگنال.طیف در(طیفی، 0، 9999)
    مرکزی := پردازش سیگنال.مرکز طیفی(طیفی، 1)
    سرچاپ مرکزی بزرگتر 100.0، مرکزی کوچکتر 5000.0
    سرچاپ پردازش سیگنال.افت طیفی(طیفی، 1، 0.85) بزرگتر 0.0
    تختی := پردازش سیگنال.تختی طیفی(طیفی، 1)
    سرچاپ تختی بزرگتربرابر 0.0، تختی کوچکتربرابر 1.0
    سرچاپ پردازش سیگنال.شار طیفی(طیفی، 0)

    نوفه := صداساز.نوفه سپید(0.12، 22050)
    ناپایا طیف۲ := پردازش سیگنال.تبدیل فوریه کوتاه(نوفه، 1024، 256، پردازش سیگنال.پنجره هان)
    سرچاپ پردازش سیگنال.تختی طیفی(طیف۲، 1) بزرگتر تختی

    بلندی := صداساز.نوا(440.0، 0.1، 22050، صداساز.موج سینوسی)
    لافزی := پردازش سیگنال.بلندی لافز(بلندی)
    سرچاپ لافزی کوچکتر 0.0، لافزی بزرگتر -40.0
    ناپایا آرام := صدا.کپی(بلندی)
    صدا.بهره(آرام، -20.0)
    سرچاپ ریاضی.قدرمطلق((پردازش سیگنال.بلندی لافز(آرام) - لافزی) + 20.0) کوچکتر 1.0
    ناپایا هنجار := صدا.کپی(بلندی)
    پردازش سیگنال.هنجارسازی لافز(هنجار، -16.0)
    سرچاپ ریاضی.قدرمطلق(پردازش سیگنال.بلندی لافز(هنجار) + 16.0) کوچکتر 1.0
    سرچاپ پردازش سیگنال.اوج راستین دسیبل(بلندی) بزرگتربرابر صدا.اوج دسیبل(بلندی) - 0.01

