واردسازی صدا.پردازش سیگنال
واردسازی ریاضی

تابع ریشه:
    الف := پردازش سیگنال.مختلط { حقیقی = 3.0، موهومی = 4.0 }
    بی := پردازش سیگنال.مختلط { حقیقی = 1.0، موهومی = -2.0 }
    سرچاپ الف.حقیقی، الف.موهومی
    سرچاپ پردازش سیگنال.اندازه مختلط(الف)
    سرچاپ پردازش سیگنال.جمع مختلط(الف، بی).حقیقی، پردازش سیگنال.جمع مختلط(الف، بی).موهومی
    سرچاپ پردازش سیگنال.تفریق مختلط(الف، بی).حقیقی، پردازش سیگنال.تفریق مختلط(الف، بی).موهومی
    سرچاپ پردازش سیگنال.ضرب مختلط(الف، بی).حقیقی، پردازش سیگنال.ضرب مختلط(الف، بی).موهومی
    سرچاپ پردازش سیگنال.مقیاس مختلط(الف، 2.0).حقیقی، پردازش سیگنال.مقیاس مختلط(الف، 2.0).موهومی
    سرچاپ پردازش سیگنال.همیوغ مختلط(الف).حقیقی، پردازش سیگنال.همیوغ مختلط(الف).موهومی
    رو := پردازش سیگنال.مختلط { حقیقی = 0.0، موهومی = 1.0 }
    سرچاپ ریاضی.قدرمطلق(پردازش سیگنال.زاویه مختلط(رو) - ریاضی.پی / 2.0) کوچکتر 0.000000001
    پی۲ := پردازش سیگنال.مختلط از قطبی(2.0، 0.0)
    سرچاپ ریاضی.قدرمطلق(پی۲.حقیقی - 2.0) کوچکتر 0.000000001، ریاضی.قدرمطلق(پی۲.موهومی) کوچکتر 0.000000001
    سرچاپ پردازش سیگنال.اندازه مختلط(پردازش سیگنال.مختلط از قطبی(5.0، 1.0))
