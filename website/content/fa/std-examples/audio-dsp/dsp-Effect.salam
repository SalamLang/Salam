واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی صدا.صداساز
واردسازی ریاضی

تابع ریشه:
    منبع := صداساز.نوا(440.0، 0.1، 22050، صداساز.موج سینوسی)
    سرچاپ منبع.فریم ها، منبع.نرخ

    پژواکی := پردازش سیگنال.پژواک(منبع، 0.02، 2، 0.5)
    سرچاپ پژواکی.فریم ها، پژواکی.فریم ها برابر منبع.فریم ها + 2 * 441
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(پژواکی، 451، 0) - (صدا.نمونه(منبع، 451، 0) + صدا.نمونه(منبع، 10، 0) * 0.5)) کوچکتر 0.001

    اتاقی := پردازش سیگنال.بازآوا(منبع، 0.5، 0.3)
    سرچاپ اتاقی.فریم ها، صدا.اوج(اتاقی) کوچکتربرابر 1.0
    خشک := پردازش سیگنال.بازآوا(منبع، 0.5، 0.0)
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(خشک، 50، 0) - صدا.نمونه(منبع، 50، 0)) کوچکتر 0.0001

    همخوانی := پردازش سیگنال.همخوان(منبع، 0.5، 2.0، 0.5)
    فلنجری := پردازش سیگنال.فلنجر(منبع، 0.5، 1.0، 0.5)
    سرچاپ همخوانی.فریم ها، فلنجری.فریم ها
    سرچاپ پردازش سیگنال.همبستگی(منبع، همخوانی) کوچکتر 0.999، پردازش سیگنال.همبستگی(منبع، فلنجری) کوچکتر 0.9999

    ناپایا لرزشی := صدا.کپی(منبع)
    پردازش سیگنال.لرزش دامنه(لرزشی، 10.0، 1.0)
    سرچاپ صدا.جذر میانگین مربع(لرزشی) کوچکتر صدا.جذر میانگین مربع(منبع)، صدا.اوج(لرزشی) کوچکتربرابر صدا.اوج(منبع) + 0.0001

    ناپایا تاخیری := صدا.کپی(منبع)
    پردازش سیگنال.تاخیر(تاخیری، 0.01، 0.5، 0.5)
    سرچاپ تاخیری.فریم ها برابر منبع.فریم ها

    فشرده := پردازش سیگنال.فشرده‌ساز { آستانه = -20.0، نسبت = 8.0، حمله = 0.001، رهایش = 0.05 }
    ناپایا سخت := صدا.کپی(منبع)
    پردازش سیگنال.پردازش فشرده‌ساز(فشرده، سخت)
    سرچاپ صدا.جذر میانگین مربع دسیبل(سخت) کوچکتر صدا.جذر میانگین مربع دسیبل(منبع) - 6.0

    ناپایا بلندی := صدا.کپی(منبع)
    صدا.مقیاس(بلندی، 4.0)
    پردازش سیگنال.پردازش محدودساز(بلندی، -1.0)
    سرچاپ صدا.اوج دسیبل(بلندی) کوچکتربرابر -1.0 + 0.001

    ناپایا دروازه‌ای := صدا.کپی(منبع)
    صدا.بهره(دروازه‌ای، -60.0)
    پردازش سیگنال.پردازش دروازه(دروازه‌ای، -40.0، 0.001)
    سرچاپ صدا.اوج(دروازه‌ای) کوچکتر 0.0001

    درازتر := پردازش سیگنال.کشش زمانی(منبع، 2.0)
    سرچاپ درازتر.فریم ها برابر منبع.فریم ها * 2، درازتر.نرخ
    بالاتر := پردازش سیگنال.جابجایی زیروبمی(منبع، 12.0)
    سرچاپ بالاتر.فریم ها، بالاتر.نرخ
    سرچاپ پردازش سیگنال.شناسایی زیروبمی(بالاتر، 0، 2048) بزرگتر 700.0

