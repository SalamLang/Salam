واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی ریاضی

تابع نوا(نرخی: صحیح، بسامد: اعشار۶۴، شمار: صحیح): صدا.قطعه:
    ناپایا کلیپ := صدا.جدید(نرخی، 1، شمار)
    ناپایا شمارنده := 0
    تا شمارنده کوچکتر شمار:
        صدا.تنظیم نمونه(کلیپ، شمارنده، 0، ریاضی.سینوس(2.0 * ریاضی.پی * بسامد * (شمارنده برگردان اعشار۶۴) / (نرخی برگردان اعشار۶۴)))
        شمارنده += 1
    پایان
    برگشت کلیپ
پایان

تابع ریشه:
    صاف۱ := پردازش سیگنال.صافی پایین(1000.0، 0.707، 48000)
    سرچاپ پردازش سیگنال.پاسخ دوقطبی(صاف۱، 100.0، 48000) بزرگتر 0.99
    سرچاپ ریاضی.قدرمطلق(پردازش سیگنال.پاسخ دوقطبی(صاف۱، 1000.0، 48000) - 0.7071) کوچکتر 0.01
    سرچاپ پردازش سیگنال.پاسخ دوقطبی(صاف۱، 10000.0، 48000) کوچکتر 0.02
    صاف۲ := پردازش سیگنال.صافی بالا(1000.0، 0.707، 48000)
    سرچاپ پردازش سیگنال.پاسخ دوقطبی(صاف۲، 10000.0، 48000) بزرگتر 0.99، پردازش سیگنال.پاسخ دوقطبی(صاف۲، 100.0، 48000) کوچکتر 0.02
    صاف۳ := پردازش سیگنال.صافی میان(1000.0، 1.0، 48000)
    سرچاپ ریاضی.قدرمطلق(پردازش سیگنال.پاسخ دوقطبی(صاف۳، 1000.0، 48000) - 1.0) کوچکتر 0.01، پردازش سیگنال.پاسخ دوقطبی(صاف۳، 100.0، 48000) کوچکتر 0.2
    صاف۴ := پردازش سیگنال.صافی شکاف(1000.0، 1.0، 48000)
    سرچاپ پردازش سیگنال.پاسخ دوقطبی(صاف۴، 1000.0، 48000) کوچکتر 0.01، پردازش سیگنال.پاسخ دوقطبی(صاف۴، 100.0، 48000) بزرگتر 0.9
    صاف۵ := پردازش سیگنال.صافی همه(1000.0، 0.707، 48000)
    سرچاپ ریاضی.قدرمطلق(پردازش سیگنال.پاسخ دوقطبی(صاف۵، 500.0، 48000) - 1.0) کوچکتر 0.000001
    صاف۶ := پردازش سیگنال.قله(1000.0، 1.0، 6.0، 48000)
    سرچاپ پردازش سیگنال.پاسخ دوقطبی(صاف۶، 1000.0، 48000) بزرگتر 1.98، پردازش سیگنال.پاسخ دوقطبی(صاف۶، 1000.0، 48000) کوچکتر 2.01
    صاف۷ := پردازش سیگنال.قفسه پایین(1000.0، 0.707، 6.0، 48000)
    سرچاپ پردازش سیگنال.پاسخ دوقطبی(صاف۷، 50.0، 48000) بزرگتر 1.9، ریاضی.قدرمطلق(پردازش سیگنال.پاسخ دوقطبی(صاف۷، 20000.0، 48000) - 1.0) کوچکتر 0.05
    صاف۸ := پردازش سیگنال.قفسه بالا(1000.0، 0.707، 6.0، 48000)
    سرچاپ پردازش سیگنال.پاسخ دوقطبی(صاف۸، 20000.0، 48000) بزرگتر 1.9

    ناپایا بلند := نوا(48000، 10000.0، 2048)
    پیشین := صدا.جذر میانگین مربع(بلند)
    پردازش سیگنال.پردازش همه کانال‌ها(صاف۱، بلند)
    سرچاپ صدا.بهره به دسیبل(صدا.جذر میانگین مربع(بلند) / پیشین) کوچکتر -20.0
    ناپایا کوتاه := نوا(48000، 100.0، 2048)
    پیشین۲ := صدا.جذر میانگین مربع(کوتاه)
    پردازش سیگنال.پردازش همه کانال‌ها(صاف۱، کوتاه)
    سرچاپ صدا.بهره به دسیبل(صدا.جذر میانگین مربع(کوتاه) / پیشین۲) بزرگتر -1.0

    ناپایا یکی := پردازش سیگنال.صافی پایین(1000.0، 0.707، 48000)
    پردازش سیگنال.گام دوقطبی(یکی، 1.0)
    سرچاپ یکی.ز۱ نابرابر 0.0
    پردازش سیگنال.بازنشانی دوقطبی(یکی)
    سرچاپ یکی.ز۱، یکی.ز۲
    سرچاپ ریاضی.قدرمطلق(یکی.ب۰ - صاف۱.ب۰) کوچکتر 0.000000001

    ناپایا کانالی := نوا(8000، 100.0، 400)
    صدا.مقیاس(کانالی، 0.5)
    ناپایا کاف := 0
    تا کاف کوچکتر کانالی.فریم ها:
        صدا.افزودن نمونه(کانالی، کاف، 0، 0.25)
        کاف += 1
    پایان
    سرچاپ صدا.انحراف جریان مستقیم(کانالی) بزرگتر 0.2
    پردازش سیگنال.حذف جریان مستقیم(کانالی)
    سرچاپ ریاضی.قدرمطلق(صدا.انحراف جریان مستقیم(کانالی)) کوچکتر 0.000001
    ناپایا تکی := پردازش سیگنال.صافی پایین(1000.0، 0.707، 8000)
    پردازش سیگنال.پردازش دوقطبی(تکی، کانالی، 0)
    سرچاپ کانالی.فریم ها
