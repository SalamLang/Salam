واردسازی صدا
واردسازی صدا.پردازش سیگنال
واردسازی ریاضی

تابع نوا(نرخی: صحیح، بسامد: اعشار۶۴، شمار: صحیح): صدا.قطعه:
    ناپایا کلیپ := صدا.جدید(نرخی، 1، شمار)
    ناپایا شمارنده := 0
    تا شمارنده کوچکتر شمار:
        صدا.تنظیم نمونه(کلیپ، شمارنده، 0، ریاضی.سینوس(2.0 * ریاضی.پی * بسامد * (شمارنده برگردان اعشار۶۴) / (نرخی برگردان اعشار۶۴)))
        شمارنده += 1
    پایان
    برگشت کلیپ
پایان

تابع ریشه:
    منبع := نوا(44100، 440.0، 4410)
    رو := پردازش سیگنال.بازنمونه سینک(منبع، 48000، 16)
    سرچاپ رو.نرخ، رو.فریم ها
    برگشته := پردازش سیگنال.بازنمونه سینک(رو، 44100، 16)
    سرچاپ برگشته.نرخ، برگشته.فریم ها
    میانه := صدا.برش(منبع، 64، منبع.فریم ها - 128)
    میانه۲ := صدا.برش(برگشته، 64، برگشته.فریم ها - 128)
    سرچاپ پردازش سیگنال.همبستگی(میانه، میانه۲) بزرگتر 0.999
    مکعب := پردازش سیگنال.بازنمونه مکعبی(منبع، 48000)
    مکعب۲ := پردازش سیگنال.بازنمونه مکعبی(مکعب، 44100)
    میانه۳ := صدا.برش(مکعب۲، 64، مکعب۲.فریم ها - 128)
    سرچاپ مکعب.نرخ، پردازش سیگنال.همبستگی(میانه، میانه۳) بزرگتر 0.999
    سرچاپ پردازش سیگنال.بازنمونه به(منبع، 48000، پردازش سیگنال.کیفیت خطی).نرخ
    سرچاپ پردازش سیگنال.بازنمونه به(منبع، 48000، پردازش سیگنال.کیفیت مکعبی).نرخ
    سرچاپ پردازش سیگنال.بازنمونه به(منبع، 48000، پردازش سیگنال.کیفیت سینک).نرخ
    همان := پردازش سیگنال.بازنمونه سینک(منبع، 44100، 16)
    سرچاپ ریاضی.قدرمطلق(پردازش سیگنال.همبستگی(منبع، همان) - 1.0) کوچکتر 0.000001
    سرچاپ پردازش سیگنال.همبستگی(منبع، صدا.قطعه {})
    سرچاپ پردازش سیگنال.بتای کایزر
    زیر := پردازش سیگنال.بازنمونه سینک(منبع، 22050، 16)
    سرچاپ زیر.نرخ، زیر.فریم ها
    صدا.آزادسازی(منبع)
