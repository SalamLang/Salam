واردسازی صدا
واردسازی صدا.فلاک
واردسازی صدا.صداساز
واردسازی فشرده سازی

تابع ریشه:
    منبع := صداساز.نوا(440.0، 0.1، 44100، صداساز.موج سینوسی)
    ناپایا کوانت := صدا.به بیت(منبع، 16)
    کوانت.بیت ها = 16
    رمزی := فلاک.کدگذاری فلاک(کوانت)
    سرچاپ فلاک.فلاک است(رمزی.data، رمزی.len)، فلاک.فلاک است(رمزی.data، 4)
    سرچاپ صدا.نام قالب(صدا.شناسایی قالب(رمزی.data، رمزی.len))

    بلوکها := فلاک.بلوک‌ها(رمزی.data، رمزی.len)
    سرچاپ بلوکها.طول()، بلوکها.بگیر(0).گونه برابر فلاک.بلوک آگاهی جریان، بلوکها.بگیر(0).آخرین، بلوکها.بگیر(0).اندازه

    ناپایا آگاهی := فلاک.آگاهی جریان {}
    سرچاپ فلاک.خواندن آگاهی جریان(رمزی.data، رمزی.len، آگاهی)
    سرچاپ آگاهی.نرخ، آگاهی.کانال ها، آگاهی.بیت ها، آگاهی.شمار کل برگردان صحیح
    سرچاپ آگاهی.ام‌دی۵.len، آگاهی.جای صدا
    سرچاپ آگاهی.کمینه بلوک، آگاهی.بیشینه بلوک

    ناپایا فریمی := فلاک.آگاهی فریم {}
    سری := فلاک.خواندن سرآیند فریم(رمزی.data، رمزی.len، آگاهی.جای صدا، آگاهی، فریمی)
    سرچاپ سری بزرگتر 0، فریمی.کانال ها، فریمی.بیت ها، فریمی.نرخ، فریمی.اندازه بلوک

    ناپایا درستی := نادرست
    برگشته := فلاک.کدگشایی فلاک(رمزی.data، رمزی.len، درستی)
    سرچاپ درستی، برگشته.فریم ها، برگشته.کانال ها، برگشته.بیت ها
    سرچاپ صدا.نمونه(برگشته، 100، 0) برابر صدا.نمونه(کوانت، 100، 0)

    ناپایا درستی۲ := نادرست
    اطلاع := فلاک.بررسی فلاک(رمزی.data، رمزی.len، درستی۲)
    سرچاپ درستی۲، اطلاع.نرخ، اطلاع.کانال ها، اطلاع.بیت ها، اطلاع.فریم ها، اطلاع.بی اتلاف

    سرچاپ فلاک.بیشینه کانال، فلاک.بیشینه اندازه بلوک
    ناپایا آشغال := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت(آشغال، 1)
    سرچاپ فلاک.سی‌آر‌سی۸(آشغال.data، 0، 0)، فلاک.سی‌آر‌سی۱۶ بافر(آشغال، 0، 1) برابر فلاک.سی‌آر‌سی۱۶(آشغال.data، 0، 1)
    ناپایا خراب := نادرست
    فلاک.کدگشایی فلاک(آشغال.data، آشغال.len، خراب)
    سرچاپ خراب

    فلاک.آزادسازی آگاهی جریان(آگاهی)
    بلوکها.آزادکن()
    فشرده سازی.آزادسازی بافر(رمزی)
    فشرده سازی.آزادسازی بافر(آشغال)
    صدا.آزادسازی(منبع)
    صدا.آزادسازی(کوانت)
    صدا.آزادسازی(برگشته)
پایان
