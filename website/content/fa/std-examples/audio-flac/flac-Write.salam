واردسازی صدا
واردسازی صدا.فلاک
واردسازی صدا.صداساز
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    منبع := صداساز.نوا(440.0، 0.2، 44100، صداساز.موج سینوسی)
    ناپایا نوایی := صدا.به بیت(منبع، 16)
    نوایی.بیت ها = 16
    خامی := نوایی.فریم ها * نوایی.کانال ها * 2
    سرچاپ نوایی.فریم ها، خامی

    رمزی := فلاک.کدگذاری فلاک(نوایی)
    سرچاپ فشرده سازی.طول بافر(رمزی) کوچکتر خامی / 2
    سرچاپ فلاک.بازبینی فلاک(رمزی.داده، رمزی.طول)
    سرچاپ فلاک.بلوک پیش‌فرض

    ناپایا درستی := نادرست
    برگشته := فلاک.کدگشایی فلاک(رمزی.داده، رمزی.طول، درستی)
    ناپایا بیشینه := 0.0
    ناپایا شمارنده := 0
    تا شمارنده کوچکتر نوایی.فریم ها:
        فرق := صدا.نمونه(برگشته، شمارنده، 0) - صدا.نمونه(نوایی، شمارنده، 0)
        اگر فرق بزرگتر بیشینه:
            بیشینه = فرق
        پایان
        اگر 0.0 - فرق بزرگتر بیشینه:
            بیشینه = 0.0 - فرق
        پایان
        شمارنده += 1
    پایان
    سرچاپ بیشینه

    هر سطح در [0، 5، 8]:
        یکی := فلاک.کدگذاری فلاک با سطح(نوایی، سطح)
        سرچاپ سطح، فشرده سازی.طول بافر(یکی) بزرگتر 42، فلاک.بازبینی فلاک(یکی.داده، یکی.طول)
        فشرده سازی.آزادسازی بافر(یکی)
    پایان
    سرچاپ فشرده سازی.طول بافر(فلاک.کدگذاری فلاک(صدا.قطعه {}))

    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_flac_example.flac")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ فلاک.ذخیره فلاک(نوایی، نشانی)
    ناپایا درستی۲ := نادرست
    دیسکی := فلاک.بازکردن فلاک(نشانی، درستی۲)
    سرچاپ درستی۲، دیسکی.فریم ها برابر نوایی.فریم ها، دیسکی.بیت ها
    سرچاپ فلاک.ذخیره فلاک با سطح(نوایی، نشانی، 8)
    ناپایا درستی۳ := نادرست
    اطلاع := فلاک.بررسی پرونده فلاک(نشانی، درستی۳)
    سرچاپ درستی۳، اطلاع.فریم ها
    ناپایا رفته := نادرست
    نبود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_flac_none.flac")
    دیرکن حافظه.آزادسازی(نبود برگردان تهی*)
    فلاک.بازکردن فلاک(نبود، رفته)
    سرچاپ رفته

    فشرده سازی.آزادسازی بافر(رمزی)
    صدا.آزادسازی(منبع)
    صدا.آزادسازی(نوایی)
    صدا.آزادسازی(برگشته)
    صدا.آزادسازی(دیسکی)
پایان
