واردسازی صدا
واردسازی صدا.میدی
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی ریاضی
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا آهنگم := میدی.آهنگ جدید(480)
    ناپایا ترکم := میدی.ترک جدید()
    میدی.افزودن ضرباهنگ(ترکم، 0، 120.0)
    ناپایا شماره := 0
    تا شماره کوچکتر 4:
        میدی.افزودن نت(ترکم، شماره * 480، 240، 60 + شماره * 2، 100، 0)
        شماره += 1
    پایان
    میدی.افزودن ترک(آهنگم، ترکم)
    رمزی := میدی.کدگذاری میدی(آهنگم)

    سرچاپ میدی.میدی است(رمزی.داده، رمزی.طول)، میدی.میدی است(رمزی.داده، 8)
    سرچاپ صدا.نام قالب(صدا.شناسایی قالب(رمزی.داده، رمزی.طول))
    ناپایا درستی := نادرست
    ناپایا برگشته := میدی.کدگشایی میدی(رمزی.داده، رمزی.طول، درستی)
    سرچاپ درستی، برگشته.تقسیم، برگشته.ترک‌ها.طول()
    سرچاپ ریاضی.قدرمطلق(میدی.ضربان(برگشته) - 120.0) کوچکتر 0.01
    سرچاپ میدی.تیک کل(برگشته)
    سرچاپ میدی.تیک به ثانیه(برگشته، 480)، میدی.ثانیه به تیک(برگشته، 0.5)

    ناپایا نت‌هایم := میدی.نت‌ها(برگشته)
    سرچاپ نت‌هایم.طول()، نت‌هایم.بگیر(0).شماره نت، نت‌هایم.بگیر(3).شماره نت
    سرچاپ نت‌هایم.بگیر(1).آغاز، نت‌هایم.بگیر(0).درازی
    نت‌هایم.آزادکن()

    ساخته := میدی.ساختن(برگشته، 22050، 1)
    سرچاپ ساخته.فریم ها بزرگتر 0، صدا.اوج(ساخته) بزرگتر 0.05
    سرچاپ میدی.نام برنامه(0)، میدی.نام برنامه(200) برابر ""

    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_midi_example.mid")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ میدی.ذخیره میدی(آهنگم، نشانی)
    ناپایا درستی۲ := نادرست
    ناپایا دیسکی := میدی.بازکردن میدی(نشانی، درستی۲)
    سرچاپ درستی۲، دیسکی.ترک‌ها.طول()
    ناپایا رفته := نادرست
    نبود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_midi_none.mid")
    دیرکن حافظه.آزادسازی(نبود برگردان تهی*)
    میدی.بازکردن میدی(نبود، رفته)
    سرچاپ رفته

    ناپایا خراب := نادرست
    میدی.کدگشایی میدی(رمزی.داده، 8، خراب)
    سرچاپ خراب

    فشرده سازی.آزادسازی بافر(رمزی)
    ناپایا آر := ساخته
    صدا.آزادسازی(آر)
    میدی.آزادسازی آهنگ(آهنگم)
    میدی.آزادسازی آهنگ(برگشته)
    میدی.آزادسازی آهنگ(دیسکی)
پایان
