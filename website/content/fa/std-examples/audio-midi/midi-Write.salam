واردسازی صدا.میدی
واردسازی فشرده سازی

تابع ریشه:
    ناپایا آهنگم := میدی.آهنگ جدید(480)
    سرچاپ آهنگم.تقسیم، آهنگم.قالب، آهنگم.ضرباهنگ برگردان صحیح
    سرچاپ میدی.تقسیم پیش‌فرض

    ناپایا ترکم := میدی.ترک جدید()
    میدی.افزودن ضرباهنگ(ترکم، 0، 120.0)
    میدی.افزودن برنامه(ترکم، 0، 0، 0)
    میدی.افزودن واپایش(ترکم، 0، 7، 100، 0)
    ناپایا شماره := 0
    تا شماره کوچکتر 4:
        میدی.افزودن نت(ترکم، شماره * 480، 240، 60 + شماره * 2، 100، 0)
        شماره += 1
    پایان
    سرچاپ ترکم.رویدادها.طول()
    میدی.افزودن ترک(آهنگم، ترکم)
    سرچاپ آهنگم.ترک‌ها.طول()، میدی.تیک کل(آهنگم)

    یکی := ترکم.رویدادها.بگیر(1)
    سرچاپ یکی.تیک، یکی.وضعیت برابر میدی.نت روشن، یکی.داده۱، یکی.داده۲، یکی.کانال

    سرچاپ میدی.نت روشن، میدی.نت خاموش، میدی.تغییر واپایش، میدی.تغییر برنامه، میدی.رویداد فرا

    رمزی := میدی.کدگذاری میدی(آهنگم)
    سرچاپ فشرده سازی.طول بافر(رمزی) بزرگتر 22، میدی.میدی است(رمزی.داده، رمزی.طول)
    ناپایا خالی := میدی.آهنگ جدید(480)
    سرچاپ فشرده سازی.طول بافر(میدی.کدگذاری میدی(خالی))
    میدی.آزادسازی آهنگ(خالی)

    فشرده سازی.آزادسازی بافر(رمزی)
    میدی.آزادسازی آهنگ(آهنگم)
پایان
