    فشرده سازی.افزودن بایت(بافه، سر۱)
    فشرده سازی.افزودن بایت(بافه، سر۲)
    فشرده سازی.افزودن بایت(بافه، سر۳)
    ناپایا شمارنده := 4
    تا شمارنده کوچکتر اندازه۳:
        فشرده سازی.افزودن بایت(بافه، 0)
        شمارنده += 1
    پایان
پایان

تابع ریشه:
    ناپایا یکم := فشرده سازی.بافر بایت جدید()
    ناپایا شماره := 0
    تا شماره کوچکتر 3:
        افزودن فریم(یکم، 251، 144، 192، 417)
        شماره += 1
    پایان
    سرچاپ فشرده سازی.طول بافر(یکم)
    سرچاپ ام‌پی‌تری.ام‌پی‌تری است(یکم.داده، یکم.طول)، صدا.نام قالب(صدا.شناسایی قالب(یکم.داده، یکم.طول))
    سرچاپ برچسب صدا.آی‌دی۳ دو دارد(یکم.داده، یکم.طول)، ام‌پی‌تری.آغاز صدا(یکم.داده، یکم.طول)

    ناپایا سری := ام‌پی‌تری.سرآیند {}
    سرچاپ ام‌پی‌تری.خواندن سرآیند(یکم.داده، یکم.طول، 0، سری)
    سرچاپ سری.نگارش برابر ام‌پی‌تری.نگارش یک، سری.لایه برابر ام‌پی‌تری.لایه سه
    سرچاپ سری.نرخ، سری.نرخ بیت، سری.کانال ها، سری.حالت برابر ام‌پی‌تری.حالت یک‌کاناله
    سرچاپ سری.نمونه‌ها، سری.اندازه فریم، سری.لایی، سری.سی‌آر‌سی
    سرچاپ ام‌پی‌تری.شمار فریم‌ها(یکم.داده، یکم.طول)

    ناپایا درستی := نادرست
    اطلاع := ام‌پی‌تری.بررسی ام‌پی‌تری(یکم.داده، یکم.طول، درستی)
    سرچاپ درستی، اطلاع.نرخ، اطلاع.کانال ها، اطلاع.بیت ها، اطلاع.بی اتلاف
    سرچاپ اطلاع.فریم ها

    سرچاپ ام‌پی‌تری.فریم در(یکم.داده، یکم.طول، 0)، ام‌پی‌تری.فریم در(یکم.داده، یکم.طول، 1)
    سرچاپ ام‌پی‌تری.فریم در(یکم.داده، یکم.طول، 99)
    سرچاپ ام‌پی‌تری.جستن به ثانیه(یکم.داده، یکم.طول، 0.03) بزرگتربرابر 0
    ناپایا سرها := ام‌پی‌تری.سرآیندها(یکم.داده، یکم.طول)
    سرچاپ سرها.طول()، سرها.بگیر(0).نرخ، سرها.بگیر(2).نرخ بیت
    سرها.آزادکن()

    ناپایا دوم := فشرده سازی.بافر بایت جدید()
    ناپایا پی := 0
    تا پی کوچکتر 2:
        افزودن فریم(دوم، 243، 128، 0، 208)
        پی += 1
    پایان
    ناپایا سری۲ := ام‌پی‌تری.سرآیند {}
    سرچاپ ام‌پی‌تری.خواندن سرآیند(دوم.داده، دوم.طول، 0، سری۲)
    سرچاپ سری۲.نگارش برابر ام‌پی‌تری.نگارش دو، سری۲.نرخ، سری۲.کانال ها، سری۲.نمونه‌ها، سری۲.اندازه فریم
    سرچاپ ام‌پی‌تری.شمار فریم‌ها(دوم.داده، دوم.طول)

    سرچاپ ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش یک، ام‌پی‌تری.لایه سه)، ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش دو، ام‌پی‌تری.لایه سه)
    سرچاپ ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش دوونیم، ام‌پی‌تری.لایه سه)، ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش یک، ام‌پی‌تری.لایه یک)
    سرچاپ ام‌پی‌تری.نمونه در فریم(ام‌پی‌تری.نگارش یک، ام‌پی‌تری.لایه دو)
    سرچاپ ام‌پی‌تری.حالت دوکاناله، ام‌پی‌تری.حالت پیوسته، ام‌پی‌تری.حالت دوگانه، ام‌پی‌تری.حالت یک‌کاناله

    ناپایا آشغال := فشرده سازی.بافر بایت جدید()
    ناپایا جی := 0
    تا جی کوچکتر 32:
        فشرده سازی.افزودن بایت(آشغال، جی)
        جی += 1
    پایان
    سرچاپ ام‌پی‌تری.یافتن همگامی(آشغال.داده، آشغال.طول، 0)، ام‌پی‌تری.ام‌پی‌تری است(آشغال.داده، آشغال.طول)
    سرچاپ ام‌پی‌تری.شمار فریم‌ها(آشغال.داده، آشغال.طول)
    ناپایا خراب := ام‌پی‌تری.سرآیند {}
    سرچاپ ام‌پی‌تری.خواندن سرآیند(آشغال.داده، آشغال.طول، 0، خراب)
    ناپایا درستی۲ := نادرست
    ام‌پی‌تری.بررسی ام‌پی‌تری(آشغال.داده، آشغال.طول، درستی۲)
    سرچاپ درستی۲
    ناپایا آگاهی۲ := ام‌پی‌تری.آگاهی نرخ متغیر {}
    سرچاپ ام‌پی‌تری.خواندن آگاهی نرخ متغیر(یکم.داده، یکم.طول، آگاهی۲)، آگاهی۲.یافت شد

