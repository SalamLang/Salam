واردسازی صدا.موسیقی

تابع ریشه:
    ناپایا شوری := موسیقی.دستگاه(موسیقی.دستگاه شور)
    سرچاپ شوری.طول()، شوری.بگیر(0)، شوری.بگیر(2)، شوری.بگیر(6)
    شوری.آزادکن()
    ناپایا ماهوری := موسیقی.دستگاه(موسیقی.دستگاه ماهور)
    سرچاپ ماهوری.بگیر(2)
    ماهوری.آزادکن()
    ناپایا همایونی := موسیقی.دستگاه(موسیقی.دستگاه همایون)
    سرچاپ همایونی.بگیر(1)
    همایونی.آزادکن()
    ناپایا سه‌گاهی := موسیقی.دستگاه(موسیقی.دستگاه سه‌گاه)
    سرچاپ سه‌گاهی.بگیر(2)
    سه‌گاهی.آزادکن()

    سرچاپ موسیقی.سنت کرن، موسیقی.سنت سری

    ناپایا بسامدها := موسیقی.بسامدهای دستگاه(60، موسیقی.دستگاه شور)
    سرچاپ بسامدها.طول()
    سرچاپ بسامدها.بگیر(0) برابر موسیقی.نت به بسامد(60)
    سرچاپ بسامدها.بگیر(2) بزرگتر موسیقی.نت به بسامد(63)، بسامدها.بگیر(2) کوچکتر موسیقی.نت به بسامد(64)
    بسامدها.آزادکن()

    سرچاپ موسیقی.نسبت طبیعی(0)، موسیقی.نسبت طبیعی(7)، موسیقی.نسبت طبیعی(4)
    سرچاپ موسیقی.نسبت فیثاغورسی(0)، موسیقی.نسبت فیثاغورسی(7)، موسیقی.نسبت فیثاغورسی(2)
    سرچاپ موسیقی.بسامد طبیعی(69، 7)
