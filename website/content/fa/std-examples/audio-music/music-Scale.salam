واردسازی صدا.موسیقی

تابع ریشه:
    ناپایا بزرگی := موسیقی.گام(موسیقی.گام بزرگ)
    سرچاپ بزرگی.طول()، بزرگی.بگیر(0)، بزرگی.بگیر(6)
    بزرگی.آزادکن()
    ناپایا کوچکی := موسیقی.گام(موسیقی.گام کوچک)
    سرچاپ کوچکی.بگیر(2)، کوچکی.بگیر(5)
    کوچکی.آزادکن()
    ناپایا کروماتیکی := موسیقی.گام(موسیقی.گام کروماتیک)
    سرچاپ کروماتیکی.طول()
    کروماتیکی.آزادکن()
    ناپایا پنجی := موسیقی.گام(موسیقی.گام پنج‌نت)
    سرچاپ پنجی.طول()
    پنجی.آزادکن()
    ناپایا بلوزی := موسیقی.گام(موسیقی.گام بلوز)
    سرچاپ بلوزی.طول()، بلوزی.بگیر(3)
    بلوزی.آزادکن()
    ناپایا دورینی := موسیقی.گام(موسیقی.گام دورین)
    سرچاپ دورینی.بگیر(2)، دورینی.بگیر(6)
    دورینی.آزادکن()

    ناپایا رشته := موسیقی.نت‌های گام(60، موسیقی.گام بزرگ، 8)
    سرچاپ رشته.طول()، رشته.بگیر(0)، رشته.بگیر(7)
    رشته.آزادکن()

    ناپایا سه‌تایی := موسیقی.نت‌های آکورد(60، موسیقی.آکورد بزرگ)
    سرچاپ سه‌تایی.طول()، سه‌تایی.بگیر(1)، سه‌تایی.بگیر(2)
    سه‌تایی.آزادکن()
    ناپایا هفتی := موسیقی.نت‌های آکورد(60، موسیقی.آکورد کوچک۷)
    سرچاپ هفتی.طول()، هفتی.بگیر(3)
    هفتی.آزادکن()
    ناپایا کاسته‌ای := موسیقی.آکورد(موسیقی.آکورد کاسته)
    سرچاپ کاسته‌ای.بگیر(2)
    کاسته‌ای.آزادکن()
    ناپایا معلقی := موسیقی.آکورد(موسیقی.آکورد معلق۴)
    سرچاپ معلقی.بگیر(1)
    معلقی.آزادکن()
    ناپایا افزوده‌ای := موسیقی.آکورد(موسیقی.آکورد افزوده)
    سرچاپ افزوده‌ای.بگیر(2)
    افزوده‌ای.آزادکن()
    ناپایا نمایانی := موسیقی.آکورد(موسیقی.آکورد نمایان۷)
    سرچاپ نمایانی.بگیر(3)
    نمایانی.آزادکن()
