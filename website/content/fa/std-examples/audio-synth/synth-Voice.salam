واردسازی صدا
واردسازی صدا.موسیقی
واردسازی صدا.صداساز

تابع ریشه:
    ناپایا بسامدها := موسیقی.بسامدهای دستگاه(57، موسیقی.دستگاه شور)
    آکوردی := صداساز.آکورد(بسامدها، 0.05، 22050، صداساز.موج سینوسی)
    سرچاپ آکوردی.فریم ها، صدا.اوج(آکوردی) بزرگتر 0.1، صدا.بریده است(آکوردی)
    بسامدها.آزادکن()

    سپیدی := صداساز.نوفه سپید(0.05، 22050)
    صورتی := صداساز.نوفه صورتی(0.05، 22050)
    قهوه‌ای := صداساز.نوفه قهوه‌ای(0.05، 22050)
    سرچاپ صدا.جذر میانگین مربع(سپیدی) بزرگتر 0.3، صدا.جذر میانگین مربع(صورتی) بزرگتر 0.01، صدا.جذر میانگین مربع(قهوه‌ای) بزرگتر 0.001

    اف‌امی := صداساز.نوا اف‌ام(220.0، 2.0، 3.0، 0.05، 22050)
    سرچاپ اف‌امی.فریم ها، صدا.اوج(اف‌امی) بزرگتر 0.5
    افزایشی۲ := صداساز.افزایشی(220.0، 6، 0.6، 0.05، 22050)
    سرچاپ افزایشی۲.فریم ها، صدا.اوج(افزایشی۲) بزرگتر 0.1
    کارپلوسی := صداساز.کارپلوس استرانگ(220.0، 0.05، 22050، 0.99)
    سرچاپ کارپلوسی.فریم ها، صدا.اوج(کارپلوسی) بزرگتر 0.1

    یکی := صداساز.نت در(60، 0.0، 0.1، 0.4، صداساز.موج سینوسی)
    سرچاپ یکی.شماره نت، یکی.آغاز، یکی.درازی، یکی.بهره، یکی.موج

    ناپایا عبارت := وکتور {} برگردان وکتور<صداساز.نت>
    ناپایا گامی := موسیقی.نت‌های گام(60، موسیقی.گام بزرگ، 4)
    ناپایا کاف := 0
    تا کاف کوچکتر گامی.طول():
        عبارت.بیفزا(صداساز.نت در(گامی.بگیر(کاف)، (کاف برگردان اعشار۶۴) * 0.05، 0.04، 0.4، صداساز.موج سینوسی))
        کاف += 1
    پایان
    گامی.آزادکن()
    پوششی := صداساز.پوشش { حمله = 0.005، افت = 0.01، پایداری = 0.6، رهایش = 0.02 }
    آهنگی := صداساز.ساختن نت‌ها(عبارت، 22050، 2، پوششی)
    سرچاپ آهنگی.کانال ها، آهنگی.فریم ها بزرگتر 0، صدا.اوج(آهنگی) بزرگتر 0.1، صدا.بریده است(آهنگی)
    عبارت.آزادکن()
    هیچی := صداساز.ساختن نت‌ها(وکتور {} برگردان وکتور<صداساز.نت>، 22050، 1، پوششی)
    سرچاپ صدا.خالی است(هیچی)

    ناپایا الف := آکوردی
    صدا.آزادسازی(الف)
    ناپایا بی := سپیدی
    صدا.آزادسازی(بی)
    ناپایا سی := صورتی
    صدا.آزادسازی(سی)
    ناپایا دی := قهوه‌ای
    صدا.آزادسازی(دی)
    ناپایا اف := اف‌امی
    صدا.آزادسازی(اف)
    ناپایا جی := افزایشی۲
    صدا.آزادسازی(جی)
    ناپایا اچ := کارپلوسی
    صدا.آزادسازی(اچ)
    ناپایا آی := آهنگی
    صدا.آزادسازی(آی)
پایان
