واردسازی صدا.برچسب صدا
واردسازی فشرده سازی
واردسازی رشته

تابع ریشه:
    ناپایا برچسبم := برچسب صدا.برچسب‌های جدید()
    سرچاپ برچسب صدا.برچسب دارد(برچسبم)
    برچسبم.عنوان = رشته.رونوشت("Shiraz Nights")
    برچسبم.هنرمند = رشته.رونوشت("Darya")
    برچسبم.آلبوم = رشته.رونوشت("Zagros")
    برچسبم.سبک = رشته.رونوشت("Folk")
    برچسبم.سال = 2026
    برچسبم.شماره قطعه = 3
    برچسبم.شمار قطعه‌ها = 12
    سرچاپ برچسب صدا.برچسب دارد(برچسبم)

    نگارش۱ := برچسب صدا.نوشتن آی‌دی۳ یک(برچسبم)
    سرچاپ فشرده سازی.طول بافر(نگارش۱)
    ناپایا پرونده۱ := فشرده سازی.بافر بایت جدید()
    ناپایا لایه := 0
    تا لایه کوچکتر 32:
        فشرده سازی.افزودن بایت(پرونده۱، 0)
        لایه += 1
    پایان
    فشرده سازی.افزودن بافر(پرونده۱، نگارش۱)
    سرچاپ برچسب صدا.آی‌دی۳ یک دارد(پرونده۱.داده، پرونده۱.طول)، برچسب صدا.پایان صدا(پرونده۱.داده، پرونده۱.طول)
    ناپایا گرفته۱ := برچسب صدا.برچسب‌های جدید()
    سرچاپ برچسب صدا.خواندن آی‌دی۳ یک(پرونده۱.داده، پرونده۱.طول، گرفته۱)
    سرچاپ گرفته۱.عنوان، گرفته۱.هنرمند، گرفته۱.آلبوم، گرفته۱.سال، گرفته۱.شماره قطعه

    نگارش۲ := برچسب صدا.نوشتن آی‌دی۳ دو(برچسبم)
    سرچاپ برچسب صدا.آی‌دی۳ دو دارد(نگارش۲.داده، نگارش۲.طول)، برچسب صدا.نگارش آی‌دی۳ دو(نگارش۲.داده، نگارش۲.طول)
    سرچاپ برچسب صدا.اندازه آی‌دی۳ دو(نگارش۲.داده، نگارش۲.طول) برابر فشرده سازی.طول بافر(نگارش۲)
    ناپایا گرفته۲ := برچسب صدا.برچسب‌های جدید()
    سرچاپ برچسب صدا.خواندن آی‌دی۳ دو(نگارش۲.داده، نگارش۲.طول، گرفته۲)
    سرچاپ گرفته۲.عنوان، گرفته۲.هنرمند، گرفته۲.آلبوم، گرفته۲.سبک
    سرچاپ گرفته۲.سال، گرفته۲.شماره قطعه، گرفته۲.شمار قطعه‌ها

    ناپایا فارسی := برچسب صدا.برچسب‌های جدید()
    فارسی.عنوان = رشته.رونوشت("شب‌های شیراز")
    فارسی۲ := برچسب صدا.نوشتن آی‌دی۳ دو(فارسی)
    ناپایا گرفته۳ := برچسب صدا.برچسب‌های جدید()
    برچسب صدا.خواندن آی‌دی۳ دو(فارسی۲.داده، فارسی۲.طول، گرفته۳)
    سرچاپ گرفته۳.عنوان

    ناپایا کامل := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بافر(کامل، نگارش۲)
    ناپایا بدنه := 0
    تا بدنه کوچکتر 40:
        فشرده سازی.افزودن بایت(کامل، 65)
        بدنه += 1
    پایان
    فشرده سازی.افزودن بافر(کامل، نگارش۱)
    سرچاپ برچسب صدا.آغاز صدا(کامل.داده، کامل.طول) برابر فشرده سازی.طول بافر(نگارش۲)
    لخت := برچسب صدا.برداشتن برچسب‌ها(کامل.داده، کامل.طول)
    سرچاپ فشرده سازی.طول بافر(لخت)، فشرده سازی.دریافت بایت(لخت، 0)

    سرچاپ برچسب صدا.نام سبک(17)، برچسب صدا.نام سبک(8)، برچسب صدا.نام سبک(200) برابر ""
    ناپایا درستی := نادرست
    ناپایا خودکار := برچسب صدا.خواندن برچسب‌ها(نگارش۲.داده، نگارش۲.طول، درستی)
    سرچاپ درستی، خودکار.عنوان

    برچسب صدا.آزادسازی برچسب‌ها(برچسبم)
    برچسب صدا.آزادسازی برچسب‌ها(گرفته۱)
    برچسب صدا.آزادسازی برچسب‌ها(گرفته۲)
    برچسب صدا.آزادسازی برچسب‌ها(فارسی)
    برچسب صدا.آزادسازی برچسب‌ها(گرفته۳)
    برچسب صدا.آزادسازی برچسب‌ها(خودکار)
    فشرده سازی.آزادسازی بافر(نگارش۱)
    فشرده سازی.آزادسازی بافر(نگارش۲)
    فشرده سازی.آزادسازی بافر(فارسی۲)
    فشرده سازی.آزادسازی بافر(پرونده۱)
    فشرده سازی.آزادسازی بافر(کامل)
    فشرده سازی.آزادسازی بافر(لخت)
