واردسازی ریاضی

تابع ریشه:
    سرچاپ صدا.پی‌سی‌ام به میولا(0)، صدا.میولا به پی‌سی‌ام(صدا.پی‌سی‌ام به میولا(0))
    سرچاپ صدا.پی‌سی‌ام به میولا(16000)، صدا.میولا به پی‌سی‌ام(144)
    سرچاپ صدا.پی‌سی‌ام به ای‌لا(16000)، صدا.ای‌لا به پی‌سی‌ام(186)
    سرچاپ صدا.پی‌سی‌ام به ای‌لا(0)، صدا.ای‌لا به پی‌سی‌ام(213)

    ناپایا نزدیک := 0
    ناپایا دورتر := 0
    ناپایا مقدار := -32768
    تا مقدار کوچکتر 32768:
        فرق := ریاضی.قدرمطلق صحیح(صدا.میولا به پی‌سی‌ام(صدا.پی‌سی‌ام به میولا(مقدار)) - مقدار)
        اگر ریاضی.قدرمطلق صحیح(مقدار) کوچکتربرابر 256:
            اگر فرق بزرگتر نزدیک:
                نزدیک = فرق
            پایان
        پایان
        اگر فرق بزرگتر دورتر:
            دورتر = فرق
        پایان
        مقدار += 7
    پایان
    سرچاپ نزدیک، دورتر

    ناپایا کلیپ := صدا.جدید(8000، 2، 50)
    صدا.تنظیم نمونه(کلیپ، 10، 0، 0.5)
    میو := ویو.کدگذاری میولا(کلیپ)
    ایل := ویو.کدگذاری ای‌لا(کلیپ)
    سرچاپ فشرده سازی.طول بافر(میو)، فشرده سازی.طول بافر(ایل)، فشرده سازی.طول بافر(ویو.کدگذاری ویو با بیت(کلیپ، 16))
    ناپایا درستی := نادرست
    برگشته := ویو.کدگشایی ویو(میو.داده، میو.طول، درستی)
    سرچاپ درستی، برگشته.فریم ها، برگشته.کانال ها، برگشته.بیت ها
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(برگشته، 10، 0) - 0.5) کوچکتر 0.01
    فشرده سازی.آزادسازی بافر(میو)
    فشرده سازی.آزادسازی بافر(ایل)
    صدا.آزادسازی(کلیپ)
