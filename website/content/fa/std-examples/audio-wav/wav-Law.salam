واردسازی صدا
واردسازی صدا.ویو
واردسازی فشرده سازی
واردسازی ریاضی

تابع ریشه:
    سرچاپ ویو.کدگذاری میولا بایت(0)، ویو.کدگشایی میولا بایت(ویو.کدگذاری میولا بایت(0))
    سرچاپ ویو.کدگذاری میولا بایت(16000)، ویو.کدگشایی میولا بایت(144)
    سرچاپ ویو.کدگذاری ای‌لا بایت(16000)، ویو.کدگشایی ای‌لا بایت(186)
    سرچاپ ویو.کدگذاری ای‌لا بایت(0)، ویو.کدگشایی ای‌لا بایت(213)

    ناپایا نزدیک := 0
    ناپایا دورتر := 0
    ناپایا مقدار := -32768
    تا مقدار کوچکتر 32768:
        فرق := ریاضی.قدرمطلق صحیح(ویو.کدگشایی میولا بایت(ویو.کدگذاری میولا بایت(مقدار)) - مقدار)
        اگر ریاضی.قدرمطلق صحیح(مقدار) کوچکتربرابر 256:
            اگر فرق بزرگتر نزدیک:
                نزدیک = فرق
            پایان
        پایان
        اگر فرق بزرگتر دورتر:
            دورتر = فرق
        پایان
        مقدار += 7
    پایان
    سرچاپ نزدیک، دورتر

    ناپایا کلیپ := صدا.جدید(8000، 2، 50)
    صدا.تنظیم نمونه(کلیپ، 10، 0، 0.5)
    میو := ویو.کدگذاری میولا(کلیپ)
    ایل := ویو.کدگذاری ای‌لا(کلیپ)
    سرچاپ فشرده سازی.طول بافر(میو)، فشرده سازی.طول بافر(ایل)، فشرده سازی.طول بافر(ویو.کدگذاری ویو با بیت(کلیپ، 16))
    ناپایا درستی := نادرست
    برگشته := ویو.کدگشایی ویو(میو.data، میو.len، درستی)
    سرچاپ درستی، برگشته.فریم ها، برگشته.کانال ها، برگشته.بیت ها
    سرچاپ ریاضی.قدرمطلق(صدا.نمونه(برگشته، 10، 0) - 0.5) کوچکتر 0.01
    فشرده سازی.آزادسازی بافر(میو)
    فشرده سازی.آزادسازی بافر(ایل)
    صدا.آزادسازی(کلیپ)
پایان
