واردسازی صدا
واردسازی صدا.ویو
واردسازی فشرده سازی

تابع ریشه:
    ناپایا کلیپ := صدا.جدید(22050، 2، 100)
    صدا.تنظیم نمونه(کلیپ، 7، 1، 0.5)
    بافه := ویو.کدگذاری ویو با بیت(کلیپ، 24)
    سرچاپ ویو.ویو است(بافه.data، بافه.len)، ویو.ویو است(بافه.data، 4)
    ناپایا شکل := ویو.قالب {}
    سرچاپ ویو.خواندن قالب(بافه.data، بافه.len، شکل)
    سرچاپ شکل.کدک برابر ویو.کدک پی‌سی‌ام، شکل.کانال ها، شکل.نرخ، شکل.بیت ها، شکل.همترازی بلوک، شکل.نرخ بایت
    فهرست := ویو.تکه‌ها(بافه.data، بافه.len)
    سرچاپ فهرست.طول()
    ناپایا یکتکه := ویو.تکه {}
    سرچاپ ویو.یافتن تکه(بافه.data، بافه.len، ویو.برچسب("data")، یکتکه)، یکتکه.جابجایی، یکتکه.اندازه
    ناپایا گم := ویو.تکه {}
    سرچاپ ویو.یافتن تکه(بافه.data، بافه.len، ویو.برچسب("cue ")، گم)
    ناپایا درستی := نادرست
    آگاه := ویو.بررسی ویو(بافه.data، بافه.len، درستی)
    سرچاپ درستی، آگاه.نرخ، آگاه.کانال ها، آگاه.بیت ها، آگاه.فریم ها، آگاه.بی اتلاف
    ناپایا درستی۲ := نادرست
    برگشته := ویو.کدگشایی ویو(بافه.data، بافه.len، درستی۲)
    سرچاپ درستی۲، برگشته.فریم ها، برگشته.بیت ها، صدا.نمونه(برگشته، 7، 1)
    فشرده سازی.آزادسازی بافر(بافه)
    صدا.آزادسازی(کلیپ)
پایان
