واردسازی صدا
واردسازی صدا.ویو
واردسازی فشرده سازی
واردسازی مسیر پرونده
واردسازی حافظه
واردسازی سیستم عامل

تابع ریشه:
    ناپایا کلیپ := صدا.جدید(8000، 1، 100)
    صدا.تنظیم نمونه(کلیپ، 0، 0، 0.5)
    صدا.تنظیم نمونه(کلیپ، 1، 0، -0.25)
    سرچاپ فشرده سازی.طول بافر(ویو.کدگذاری ویو با بیت(کلیپ، 8))، فشرده سازی.طول بافر(ویو.کدگذاری ویو با بیت(کلیپ، 16))
    سرچاپ فشرده سازی.طول بافر(ویو.کدگذاری ویو با بیت(کلیپ، 24))، فشرده سازی.طول بافر(ویو.کدگذاری ویو با بیت(کلیپ، 32))
    سرچاپ فشرده سازی.طول بافر(ویو.کدگذاری ویو اعشاری(کلیپ))
    سرچاپ فشرده سازی.طول بافر(ویو.کدگذاری ویو(کلیپ))
    کلیپ.بیت ها = 24
    سرچاپ فشرده سازی.طول بافر(ویو.کدگذاری ویو(کلیپ))
    سرچاپ فشرده سازی.طول بافر(ویو.کدگذاری ویو با بیت(کلیپ، 12))، فشرده سازی.طول بافر(ویو.کدگذاری ویو(صدا.قطعه {}))

    نشانی := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_wav_write.wav")
    دیرکن حافظه.آزادسازی(نشانی برگردان تهی*)
    سرچاپ ویو.ذخیره ویو با بیت(کلیپ، نشانی، 24)
    ناپایا درستی := نادرست
    دیسکی := ویو.بازکردن ویو(نشانی، درستی)
    سرچاپ درستی، دیسکی.فریم ها، دیسکی.بیت ها، صدا.نمونه(دیسکی، 0، 0)، صدا.نمونه(دیسکی، 1، 0)
    ناپایا درستی۲ := نادرست
    آگاه := ویو.بررسی پرونده ویو(نشانی، درستی۲)
    سرچاپ درستی۲، آگاه.فریم ها، آگاه.بیت ها

    نشانیف := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_wav_write_f32.wav")
    دیرکن حافظه.آزادسازی(نشانیف برگردان تهی*)
    سرچاپ ویو.ذخیره ویو اعشاری(کلیپ، نشانیف)
    ناپایا درستی۳ := نادرست
    دیسکف := ویو.بازکردن ویو(نشانیف، درستی۳)
    سرچاپ درستی۳، دیسکف.بیت ها، صدا.نمونه(دیسکف، 1، 0)

    ناپایا رفته := نادرست
    نبود := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "salam_wav_nope.wav")
    دیرکن حافظه.آزادسازی(نبود برگردان تهی*)
    ویو.بازکردن ویو(نبود، رفته)
    سرچاپ رفته
    صدا.آزادسازی(کلیپ)
پایان
