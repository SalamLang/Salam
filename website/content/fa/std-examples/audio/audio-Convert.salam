واردسازی صدا

تابع ریشه:
    ناپایا دو := صدا.جدید(8000، 2، 4)
    ناپایا ش := 0
    تا ش کوچکتر 4:
        صدا.تنظیم نمونه(دو، ش، 0، (ش برگردان اعشار۶۴) / 8.0)
        صدا.تنظیم نمونه(دو، ش، 1، 0.0 - (ش برگردان اعشار۶۴) / 16.0)
        ش += 1
    پایان
    دو.بیت ها = 16
    تک := صدا.به یک‌کاناله(دو)
    سرچاپ تک.کانال ها، صدا.نمونه(تک، 2، 0)، تک.بیت ها
    پهن := صدا.به دوکاناله(تک)
    سرچاپ پهن.کانال ها، صدا.نمونه(پهن، 2، 0) برابر صدا.نمونه(پهن، 2، 1)
    چهار := صدا.به کانال‌ها(تک، 4)
    سرچاپ چهار.کانال ها، صدا.نمونه(چهار، 1، 3)
    چپ := صدا.کانال(دو، 0)
    راست := صدا.کانال(دو، 1)
    سرچاپ چپ.کانال ها، صدا.نمونه(چپ، 3، 0)، صدا.نمونه(راست، 3، 0)
    تکه := صدا.جداسازی کانال‌ها(دو)
    سرچاپ تکه.طول()
    بافته := صدا.درهم‌بافی کانال‌ها(تکه)
    سرچاپ بافته.کانال ها، صدا.نمونه(بافته، 3، 1) برابر صدا.نمونه(دو، 3، 1)
    پایین := صدا.به نرخ(دو، 4000)
    سرچاپ پایین.نرخ، پایین.فریم ها، پایین.بیت ها
    بالا := صدا.به نرخ(تک، 16000)
    سرچاپ بالا.نرخ، بالا.فریم ها، صدا.نمونه(بالا، 2، 0)
    زبر := صدا.به بیت(تک، 4)
    سرچاپ زبر.بیت ها، صدا.نمونه(زبر، 1، 0)، صدا.نمونه(زبر، 3، 0)
    صدا.آزادسازی(دو)
    صدا.آزادسازی(تک)
پایان
