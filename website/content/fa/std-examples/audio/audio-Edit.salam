واردسازی صدا

تابع شیب(شمار: صحیح): صدا.قطعه:
    ناپایا ق := صدا.جدید(8000، 1، شمار)
    ناپایا ش := 0
    تا ش کوچکتر شمار:
        صدا.تنظیم نمونه(ق، ش، 0، (ش برگردان اعشار۶۴) / 32.0)
        ش += 1
    پایان
    برگشت ق
پایان

تابع ریشه:
    الف := شیب(8)
    تکه := صدا.برش(الف، 2، 3)
    سرچاپ تکه.فریم ها، صدا.نمونه(تکه، 0، 0)، صدا.نمونه(تکه، 2، 0)
    سرچاپ صدا.برش زمانی(الف، 0.0، 0.0005).فریم ها، صدا.برش(الف، 6، 10).فریم ها
    پیو := صدا.پیوند(تکه، تکه)
    سرچاپ پیو.فریم ها، صدا.نمونه(پیو، 3، 0)
    سرچاپ صدا.تکرار صدا(تکه، 4).فریم ها
    آم := صدا.آمیختن(الف، الف، 1.0، 0.5)
    سرچاپ صدا.نمونه(آم، 4، 0)
    ناپایا گ := صدا.کپی(الف)
    صدا.مقیاس(گ، 2.0)
    سرچاپ صدا.نمونه(گ، 1، 0)
    صدا.بهره(گ، 0.0)
    سرچاپ صدا.نمونه(گ، 1، 0)
    صدا.مقیاس(گ، 100.0)
    صدا.محدود کردن(گ)
    سرچاپ صدا.اوج(گ)
    ناپایا ن := صدا.کپی(الف)
    صدا.هنجارسازی(ن، 0.0)
    سرچاپ صدا.اوج(ن)
    ناپایا واگرد := صدا.کپی(الف)
    صدا.وارونه کردن(واگرد)
    سرچاپ صدا.نمونه(واگرد، 0، 0)، صدا.نمونه(واگرد، 7، 0)
    ناپایا م := صدا.کپی(الف)
    صدا.محو ورودی(م، صدا.مدت(م))
    سرچاپ صدا.نمونه(م، 0، 0)، صدا.نمونه(م، 4، 0)
    ناپایا خ := صدا.کپی(الف)
    صدا.محو خروجی(خ، صدا.مدت(خ))
    سرچاپ صدا.نمونه(خ، 0، 0)
    سرچاپ صدا.لایی گذاری(الف، 0.001، 0.001).فریم ها
    ناپایا سر := صدا.قطعه {}
    ناپایا دنباله := صدا.قطعه {}
    صدا.شکافتن(الف، 0.0005، سر، دنباله)
    سرچاپ سر.فریم ها، دنباله.فریم ها، صدا.نمونه(دنباله، 0، 0)
    ناپایا شکاف := صدا.جدید(8000، 1، 8)
    صدا.تنظیم نمونه(شکاف، 3، 0، 0.5)
    صدا.تنظیم نمونه(شکاف، 4، 0، 0.5)
    سرچاپ صدا.برش سکوت(شکاف، -60.0).فریم ها
    ناپایا هدف := صدا.جدید(8000، 1، 8)
    صدا.آمیختن در(هدف، تکه، 2، 1.0)
    سرچاپ صدا.نمونه(هدف، 2، 0)، صدا.نمونه(هدف، 0، 0)
    صدا.آزادسازی(الف)
پایان
