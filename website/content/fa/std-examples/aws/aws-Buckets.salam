واردسازی ای دبلیو اس

تابع ریشه:
    پ := ای دبلیو اس.پیکربندی از محیط("")
    اگر وارونه ای دبلیو اس.پیکربندی شده(پ):
        سرچاپ "اعتبارنامه‌ی AWS تنظیم نشده است"
        برگشت
    پایان

    سطل := "salam-demo-2026"
    _ := ای دبلیو اس.اس۳ ساخت سطل(پ، سطل)
    _ := ای دبلیو اس.اس۳ ساخت سطل با دسترسی(پ، سطل + "-logs"، "private")
    سرچاپ ای دبلیو اس.اس۳ سطل وجود دارد(پ، سطل)، ای دبلیو اس.اس۳ سرآیند سطل(پ، سطل).status، ای دبلیو اس.اس۳ منطقه سطل(پ، سطل)

    ناپایا ف := ای دبلیو اس.اس۳ فهرست سطل‌ها(پ)
    سرچاپ ف.ok، ف.owner، ای دبلیو اس.شمار سطل‌ها(ف)
    تکرار ای دبلیو اس.شمار سطل‌ها(ف) در ش:
        س := ای دبلیو اس.سطل شماره(ف، ش)
        سرچاپ س.name، س.created، س.region
    پایان
    ای دبلیو اس.آزادسازی فهرست سطل‌ها(ف)

    _ := ای دبلیو اس.اس۳ تنظیم نسخه‌بندی(پ، سطل، درست)
    سرچاپ ای دبلیو اس.اس۳ نسخه‌بندی(پ، سطل)
    ناپایا ب := ای دبلیو اس.برچسب‌های جدید()
    ای دبلیو اس.تنظیم برچسب(ب، "project"، "salam")
    _ := ای دبلیو اس.اس۳ تنظیم برچسب سطل(پ، سطل، ب)
    ای دبلیو اس.آزادسازی سرآیندها(ب)
    ناپایا ب۲ := ای دبلیو اس.اس۳ برچسب سطل(پ، سطل)
    سرچاپ ای دبلیو اس.دریافت سرآیند(ب۲، "project")
    ای دبلیو اس.آزادسازی سرآیندها(ب۲)
    _ := ای دبلیو اس.اس۳ حذف برچسب سطل(پ، سطل)

    سیاست := `{"Version":"2012-10-17","Statement":[{"Effect":"Allow","Principal":"*","Action":"s3:GetObject","Resource":"arn:aws:s3:::salam-demo-2026/public/*"}]}`
    _ := ای دبلیو اس.اس۳ تنظیم سیاست سطل(پ، سطل، سیاست)
    سرچاپ ای دبلیو اس.اس۳ سیاست سطل(پ، سطل).طول() > ۰
    _ := ای دبلیو اس.اس۳ حذف سیاست سطل(پ، سطل)
    _ := ای دبلیو اس.اس۳ تنظیم کورز سطل(پ، سطل، "https://salamlang.ir"، "GET,PUT"، ۳۶۰۰)
    سرچاپ ای دبلیو اس.اس۳ کورز سطل(پ، سطل).طول() > ۰
    _ := ای دبلیو اس.اس۳ حذف کورز سطل(پ، سطل)
    _ := ای دبلیو اس.اس۳ تنظیم چرخه عمر(پ، سطل، ای دبلیو اس.اس۳ قاعده انقضا("tmp/"، ۷، ۱))
    سرچاپ ای دبلیو اس.اس۳ چرخه عمر(پ، سطل).طول() > ۰
    _ := ای دبلیو اس.اس۳ حذف چرخه عمر(پ، سطل)

    _ := ای دبلیو اس.اس۳ حذف سطل(پ، سطل + "-logs")
    سرچاپ ای دبلیو اس.اس۳ حذف سطل(پ، سطل).ok
پایان
