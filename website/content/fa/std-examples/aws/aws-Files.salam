واردسازی ای دبلیو اس

تابع ریشه:
    پ := ای دبلیو اس.پیکربندی از نمایه("default"، "backup")
    اگر وارونه ای دبلیو اس.پیکربندی شده(پ):
        سرچاپ "نمایه‌ی default در ~/.aws پیدا نشد"
        برگشت
    پایان

    گ := ای دبلیو اس.گزینه‌های نوشتن { اندازه جزء = ای دبلیو اس.اندازه پیش‌فرض بخش }
    ن := ای دبلیو اس.اس۳ بارگذاری پرونده(پ، "db/dump.sql"، "/tmp/dump.sql"، گ)
    سرچاپ ن.موفق، ن.بایت‌ها، ن.شمار بخش‌ها، ن.ای تگ
    سرچاپ ای دبلیو اس.اس۳ ای‌تگ پرونده("/tmp/dump.sql"، ای دبلیو اس.اندازه پیش‌فرض بخش) == ن.ای تگ
    _ := ای دبلیو اس.اس۳ بارگذاری پرونده با نوع(پ، "img/logo.png"، "/tmp/logo.png"، "image/png")
    د := ای دبلیو اس.اس۳ دریافت پرونده(پ، "db/dump.sql"، "/tmp/restore.sql")
    سرچاپ د.موفق، د.مسیر، د.خطا

    پو := ای دبلیو اس.اس۳ بارگذاری پوشه(پ، "/var/www/site"، "site/"، ای دبلیو اس.گزینه‌های نوشتن {})
    سرچاپ پو.موفق، پو.شمار پرونده‌ها، پو.مجموع بایت‌ها، پو.ردشده‌ها، پو.مسیر ناموفق
    _ := ای دبلیو اس.اس۳ دریافت پیشوند(پ، "site/"، "/tmp/site")

    سرچاپ ای دبلیو اس.کمینه اندازه بخش، ای دبلیو اس.بیشینه شمار بخش‌ها
    ناپایا ب := ای دبلیو اس.اس۳ آغاز بارگذاری(پ، "video.mp4"، ای دبلیو اس.گزینه‌های نوشتن { نوع محتوا = "video/mp4" })
    اگر وارونه ب.موفق:
        سرچاپ ب.خطا
        برگشت
    پایان
    تکه := "x" * ای دبلیو اس.کمینه اندازه بخش
    _ := ای دبلیو اس.اس۳ بارگذاری بخش(پ، ب، ۱، تکه برگردان تهی*، تکه.طول())
    _ := ای دبلیو اس.اس۳ رونوشت بخش(پ، ب، ۲، "old.mp4"، ای دبلیو اس.گزینه‌های رونوشت {}، ۰، ۵۲۴۲۸۷۹)
    سرچاپ ای دبلیو اس.بخش‌های بارگذاری(ب)، ای دبلیو اس.بایت‌های بارگذاری(ب)
    فب := ای دبلیو اس.اس۳ فهرست بخش‌ها(پ، "video.mp4"، ب.شناسه بارگذاری)
    تکرار ای دبلیو اس.شمار بخش‌ها(فب) در ش:
        م := ای دبلیو اس.بخش شماره(فب، ش)
        سرچاپ م.شماره، م.ای تگ، م.اندازه
    پایان
    سرچاپ ای دبلیو اس.اس۳ تکمیل بارگذاری(پ، ب).موفق
    ای دبلیو اس.آزادسازی بخش‌ها(ب)

    ف := ای دبلیو اس.اس۳ فهرست بارگذاری‌ها(پ، "")
    تکرار ای دبلیو اس.شمار بارگذاری‌ها(ف) در ج:
        ق := ای دبلیو اس.بارگذاری شماره(ف، ج)
        _ := ای دبلیو اس.اس۳ لغو بارگذاری(پ، ای دبلیو اس.بارگذاری چندبخشی { کلید = ق.کلید، شناسه بارگذاری = ق.شناسه بارگذاری })
    پایان
    _ := ای دبلیو اس.اس۳ نوشتن بزرگ(پ، "big.bin"، تکه برگردان تهی*، تکه.طول()، ۰، ای دبلیو اس.گزینه‌های نوشتن {})
    _ := ای دبلیو اس.اس۳ رونوشت بزرگ(پ، "big.bin"، "big2.bin"، ۰، ای دبلیو اس.گزینه‌های رونوشت {})
پایان
