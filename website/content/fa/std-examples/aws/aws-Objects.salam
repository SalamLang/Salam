واردسازی ای دبلیو اس

تابع ریشه:
    پ := ای دبلیو اس.پیکربندی از محیط("photos")
    اگر وارونه ای دبلیو اس.پیکربندی شده(پ):
        سرچاپ "AWS_ACCESS_KEY_ID و AWS_SECRET_ACCESS_KEY را تنظیم کنید"
        برگشت
    پایان

    ن := ای دبلیو اس.اس۳ نوشتن(پ، "notes/hello.txt"، "سلام دنیا"، "text/plain; charset=utf-8")
    سرچاپ ن.ok، ن.status، ن.etag، ن.request_id
    گ := ای دبلیو اس.گزینه‌های نوشتن { content_type = "text/html"، cache_control = "max-age=3600"، storage_class = "STANDARD_IA"، acl = "public-read" }
    ای دبلیو اس.تنظیم سرآیند(گ.meta، "owner"، "ali")
    _ := ای دبلیو اس.اس۳ نوشتن با گزینه(پ، "site/index.html"، "<h1>سلام</h1>"، گ)
    داده := "salam"
    _ := ای دبلیو اس.اس۳ نوشتن بایت(پ، "raw.bin"، داده برگردان تهی*، داده.طول()، "application/octet-stream")
    _ := ای دبلیو اس.اس۳ نوشتن بایت با گزینه(پ، "raw2.bin"، داده برگردان تهی*، داده.طول()، گ)

    خ := ای دبلیو اس.اس۳ خواندن(پ، "notes/hello.txt")
    اگر خ.ok:
        سرچاپ خ.body، خ.length، ای دبلیو اس.سرآیند نتیجه(خ، "Content-Type")
    وگرنه:
        سرچاپ خ.status، خ.code، خ.error
    پایان
    _ := ای دبلیو اس.اس۳ خواندن با گزینه(پ، "notes/hello.txt"، ای دبلیو اس.گزینه‌های خواندن { if_none_match = خ.etag })
    ناپایا ب := ای دبلیو اس.اس۳ خواندن بایت(پ، "raw.bin")
    سرچاپ ب.ok، ب.len، ای دبلیو اس.سرآیند بایت‌ها(ب، "ETag")
    ای دبلیو اس.آزادسازی بایت‌ها(ب)
    ناپایا ب۲ := ای دبلیو اس.اس۳ خواندن بازه(پ، "raw.bin"، ۰، ۱)
    ای دبلیو اس.آزادسازی بایت‌ها(ب۲)
    ناپایا ب۳ := ای دبلیو اس.اس۳ خواندن بایت با گزینه(پ، "raw.bin"، ای دبلیو اس.گزینه‌های خواندن { range_start = ۲، range_end = ۴ })
    ای دبلیو اس.آزادسازی بایت‌ها(ب۳)

    ا := ای دبلیو اس.اس۳ اطلاعات شیء(پ، "site/index.html")
    سرچاپ ا.ok، ا.size، ا.content_type، ا.last_modified، ا.storage_class
    _ := ای دبلیو اس.اس۳ اطلاعات نسخه(پ، "site/index.html"، ا.version_id)
    سرچاپ ای دبلیو اس.اس۳ سرآیند شیء(پ، "raw.bin").status، ای دبلیو اس.اس۳ وجود دارد(پ، "raw.bin")، ای دبلیو اس.اس۳ اندازه(پ، "raw.bin")
    سرچاپ ای دبلیو اس.اس۳ چکیده شیء(پ، "raw.bin")

    _ := ای دبلیو اس.اس۳ رونوشت(پ، "notes/hello.txt"، "notes/copy.txt")
    _ := ای دبلیو اس.اس۳ رونوشت با گزینه(پ، "notes/hello.txt"، "archive/hello.txt"، ای دبلیو اس.گزینه‌های رونوشت { storage_class = "GLACIER" })
    _ := ای دبلیو اس.اس۳ جابجایی(پ، "notes/copy.txt"، "notes/moved.txt")
    _ := ای دبلیو اس.اس۳ به‌روزرسانی زمان(پ، "notes/moved.txt"، ای دبلیو اس.گزینه‌های رونوشت {})
    _ := ای دبلیو اس.اس۳ بازگردانی از آرشیو(پ، "archive/hello.txt"، ۲، "Standard")

    _ := ای دبلیو اس.اس۳ تنظیم برچسب شیء(پ، "raw.bin"، ای دبلیو اس.برچسب‌های جدید())
    _ := ای دبلیو اس.اس۳ افزودن برچسب شیء(پ، "raw.bin"، "team"، "web")
    ناپایا ب۴ := ای دبلیو اس.اس۳ برچسب شیء(پ، "raw.bin")
    سرچاپ ای دبلیو اس.متن برچسب‌ها(ب۴)
    ای دبلیو اس.آزادسازی سرآیندها(ب۴)
    ناپایا ب۵ := ای دبلیو اس.اس۳ برچسب نسخه(پ، "raw.bin"، "")
    ای دبلیو اس.آزادسازی سرآیندها(ب۵)
    _ := ای دبلیو اس.اس۳ حذف برچسب شیء(پ، "raw.bin")
    _ := ای دبلیو اس.اس۳ عمومی کردن(پ، "raw.bin")
    _ := ای دبلیو اس.اس۳ خصوصی کردن(پ، "raw.bin")
    _ := ای دبلیو اس.اس۳ تنظیم دسترسی شیء(پ، "raw.bin"، "private")
    سرچاپ ای دبلیو اس.اس۳ دسترسی شیء(پ، "raw.bin").طول() > ۰
    _ := ای دبلیو اس.اس۳ تنظیم توقیف قانونی(پ، "raw.bin"، درست)
    سرچاپ ای دبلیو اس.اس۳ توقیف قانونی(پ، "raw.bin")
    _ := ای دبلیو اس.اس۳ تنظیم نگهداری(پ، "raw.bin"، "GOVERNANCE"، ۱۸۹۳۴۵۶۰۰۰ برگردان صحیح۶۴)

    ناپایا ل := ای دبلیو اس.اس۳ فهرست(پ، ای دبلیو اس.گزینه‌های فهرست { prefix = "notes/"، max_keys = ۱۰۰ })
    هر ش در ل.items:
        سرچاپ ش.key، ش.size
    پایان
    ای دبلیو اس.آزادسازی فهرست(ل)
    ناپایا ل۲ := ای دبلیو اس.اس۳ فهرست پیشوند(پ، "site/")
    ای دبلیو اس.آزادسازی فهرست(ل۲)
    ناپایا ل۳ := ای دبلیو اس.اس۳ فهرست پوشه(پ، "")
    سرچاپ ای دبلیو اس.شمار پیشوندهای فهرست(ل۳)
    ای دبلیو اس.آزادسازی فهرست(ل۳)
    ناپایا ل۴ := ای دبلیو اس.اس۳ فهرست همه(پ، "")
    سرچاپ ای دبلیو اس.شمار فهرست(ل۴)، ای دبلیو اس.اندازه کل فهرست(ل۴)
    ای دبلیو اس.آزادسازی فهرست(ل۴)
    ناپایا ل۵ := ای دبلیو اس.اس۳ فهرست همه با گزینه(پ، ای دبلیو اس.گزینه‌های فهرست { prefix = "site/" })
    ای دبلیو اس.آزادسازی فهرست(ل۵)
    ناپایا ل۶ := ای دبلیو اس.اس۳ فهرست نسخه یک(پ، ای دبلیو اس.گزینه‌های فهرست {}، "")
    ای دبلیو اس.آزادسازی فهرست(ل۶)
    ناپایا ل۷ := ای دبلیو اس.اس۳ فهرست نسخه‌ها(پ، ای دبلیو اس.گزینه‌های فهرست { prefix = "raw" }، ""، "")
    ای دبلیو اس.آزادسازی فهرست(ل۷)
    ناپایا ک := ای دبلیو اس.اس۳ کلیدها(پ، "notes/")
    _ := ای دبلیو اس.اس۳ حذف چندتایی(پ، ک)
    ای دبلیو اس.آزادسازی کلیدها(ک)
    _ := ای دبلیو اس.اس۳ حذف پیشوند(پ، "site/")
    _ := ای دبلیو اس.اس۳ حذف نسخه(پ، "raw2.bin"، "")
    سرچاپ ای دبلیو اس.اس۳ حذف(پ، "raw.bin").ok
پایان
