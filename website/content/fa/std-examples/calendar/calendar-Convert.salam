واردسازی تقویم

تابع ریشه:
    م := تقویم.تاریخ میلادی { year = ۲۰۲۴، month = ۳، day = ۲۰ }
    ج := تقویم.میلادی به جلالی(م)
    ه := تقویم.میلادی به هجری(م)
    سرچاپ تقویم.قالب میلادی(م)، تقویم.قالب جلالی(ج)، تقویم.قالب هجری(ه)
    سرچاپ تقویم.قالب طولانی جلالی(ج)
    سرچاپ تقویم.قالب طولانی هجری فارسی(ه)
    سرچاپ تقویم.قالب طولانی هجری عربی(ه)
    سرچاپ تقویم.قالب طولانی میلادی(م)
    سرچاپ تقویم.قالب میلادی(تقویم.جلالی به میلادی(تقویم.تاریخ جلالی { year = ۱۴۰۳، month = ۱، day = ۱ }))
    سرچاپ تقویم.قالب میلادی(تقویم.هجری به میلادی(تقویم.تاریخ هجری قمری { year = ۱۴۴۵، month = ۹، day = ۱ }))
    سرچاپ تقویم.قالب هجری(تقویم.جلالی به هجری(ج))، تقویم.قالب جلالی(تقویم.هجری به جلالی(ه))
    ر := تقویم.میلادی به روز ژولیانی(م)
    سرچاپ ر، تقویم.جلالی به روز ژولیانی(ج)، تقویم.هجری به روز ژولیانی(ه)
    سرچاپ تقویم.قالب میلادی(تقویم.روز ژولیانی به میلادی(ر + ۱))، تقویم.قالب جلالی(تقویم.روز ژولیانی به جلالی(ر + ۱))، تقویم.قالب هجری(تقویم.روز ژولیانی به هجری(ر + ۱))
پایان
