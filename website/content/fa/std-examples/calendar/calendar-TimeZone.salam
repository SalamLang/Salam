واردسازی تقویم

روال ریشه:
    ت := ۱۷۱۰۹۴۳۵۰۹
    تهران := تقویم.منطقه زمانی تهران()
    سرچاپ تهران.name، تهران.offset_minutes
    سرچاپ تقویم.قالب جلالی(تقویم.تاریخ جلالی محلی(ت، تهران))، تقویم.قالب ساعت(تقویم.ساعت محلی(ت، تهران))
    سرچاپ تقویم.قالب میلادی(تقویم.تاریخ میلادی محلی(ت، تقویم.منطقه زمانی توکیو()))، تقویم.قالب ساعت(تقویم.ساعت محلی(ت، تقویم.منطقه زمانی توکیو()))
    سرچاپ تقویم.قالب هجری(تقویم.تاریخ هجری محلی(ت، تقویم.منطقه زمانی مکه()))
    هر منطقه در [تقویم.منطقه زمانی جهانی()، تقویم.منطقه زمانی کابل()، تقویم.منطقه زمانی ریاض()، تقویم.منطقه زمانی دبی()، تقویم.منطقه زمانی استانبول()، تقویم.منطقه زمانی لندن()، تقویم.منطقه زمانی نیویورک()]:
        سرچاپ منطقه.name، منطقه.offset_minutes، تقویم.قالب ساعت(تقویم.ساعت محلی(ت، منطقه))
    پایان
    م := تقویم.تاریخ میلادی { year = ۲۰۲۴، month = ۳، day = ۲۰ }
    س := تقویم.زمان ساعت { hour = ۲۳، minute = ۰، second = ۰ }
    سرچاپ تقویم.میلادی محلی به زمان مطلق(م، س، تهران)
    سرچاپ تقویم.قالب میلادی(تقویم.تبدیل میلادی بین مناطق زمانی(م، س، تهران، تقویم.منطقه زمانی توکیو()))، تقویم.قالب ساعت(تقویم.تبدیل ساعت بین مناطق زمانی(م، س، تهران، تقویم.منطقه زمانی توکیو()))
    ثابت := تقویم.منطقه زمانی ثابت("UTC+05:30"، ۳۳۰)
    سرچاپ ثابت.name، تقویم.قالب ساعت(تقویم.ساعت محلی(ت، ثابت))
    محلی := تقویم.منطقه زمانی محلی(ت)
    سرچاپ محلی.name، محلی.offset_minutes == تقویم.اختلاف زمانی محلی(ت)
پایان
