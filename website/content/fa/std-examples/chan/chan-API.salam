// زبان: فارسی
بسته ریشه

واردسازی کانال

تابع ریشه:
    نویسه := کانال.جدید(3) برگردان کانال.کانال<رشته>
    سرچاپ "capacity:"، کانال.ظرفیت(نویسه)، "len:"، کانال.طول(نویسه)

    واژه‌ها := وکتور {} برگردان وکتور<رشته>
    واژه‌ها.بیفزا("one")
    واژه‌ها.بیفزا("two")
    سرچاپ "sent:"، کانال.فرستادن همه(نویسه، واژه‌ها)
    سرچاپ "queued:"، کانال.طول(نویسه)
    واژه‌ها.آزادکن()

    ناپایا موفق := نادرست
    سرچاپ "first:"، کانال.دریافت(نویسه، موفق)، موفق
    سرچاپ "next:"، کانال.کوشش برای دریافت(نویسه، موفق)، موفق
    کانال.بستن(نویسه)
    سرچاپ "closed:"، کانال.بسته است(نویسه)، "send:"، کانال.کوشش برای فرستادن(نویسه، "late")

    چپ := کانال.تخلیه(نویسه)
    سرچاپ "left:"، چپ.طول()
    چپ.آزادکن()
    نویسه.آزادسازی()
پایان
