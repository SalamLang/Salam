واردسازی کانال
واردسازی همگام سازی

ناپایا کارها := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
ناپایا نتیجه‌ها := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
ناپایا گروه := همگام سازی.گروه انتظار {}

تابع کارگر():
    ناپایا باز := درست
    تا درست:
        ع := کارها.دریافت(باز)
        اگر وارونه باز:
            بشکن
        پایان
        نتیجه‌ها.فرستادن(ع * ع)
    پایان
    همگام سازی.اتمام(گروه)
پایان

تابع ریشه:
    کارها.مقداردهی(۴)
    نتیجه‌ها.مقداردهی(۱۶)
    گروه = همگام سازی.گروه انتظار جدید()
    همگام سازی.افزودن(گروه، ۲)
    الف := نخ‌ساز(کارگر)
    ب := نخ‌ساز(کارگر)
    تکرار ۱ تا ۱۱ در ع:
        کارها.فرستادن(ع)
    پایان
    کارها.بستن()
    همگام سازی.انتظار(گروه)
    نخ‌پیوند(الف)
    نخ‌پیوند(ب)
    نتیجه‌ها.بستن()
    ناپایا جمع := ۰ برگردان صحیح۶۴
    ناپایا باز := درست
    تا درست:
        م := نتیجه‌ها.دریافت(باز)
        اگر وارونه باز:
            بشکن
        پایان
        جمع += م
    پایان
    سرچاپ "جمع مربع‌ها:"، جمع
    سرچاپ کارها.بسته است()، کارها.طول()، کارها.ظرفیت()، کارها.فرستادن(۱)
    همگام سازی.نابودسازی گروه انتظار(گروه)
    کارها.آزادسازی()
    نتیجه‌ها.آزادسازی()
پایان
