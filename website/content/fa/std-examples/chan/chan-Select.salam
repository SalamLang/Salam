واردسازی کانال
واردسازی استخر

تابع ریشه:
    ناپایا الف := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
    ناپایا بافر_محلی := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
    الف.مقداردهی(2 برگردان صحیح۶۴)
    بافر_محلی.مقداردهی(2 برگردان صحیح۶۴)
    ناپایا متغیر_all := وکتور {} برگردان وکتور<کانال.کانال<صحیح۶۴>>
    متغیر_all.بیفزا(الف)
    متغیر_all.بیفزا(بافر_محلی)
    ویژگی_محلی := استخر.جدید(1 برگردان صحیح۶۴، 2 برگردان صحیح۶۴)
    استخر.ارسال(ویژگی_محلی، (): بافر_محلی.فرستادن(42 برگردان صحیح۶۴) پایان)
    ناپایا مقدار_محلی := 0 برگردان صحیح۶۴
    سرچاپ کانال.گزینش(متغیر_all، مقدار_محلی، 1000 برگردان صحیح۶۴)
    سرچاپ مقدار_محلی
    سرچاپ کانال.گزینش(متغیر_all، مقدار_محلی، 10 برگردان صحیح۶۴)
    الف.بستن()
    بافر_محلی.بستن()
    سرچاپ کانال.گزینش(متغیر_all، مقدار_محلی، 10 برگردان صحیح۶۴)
    استخر.توقف(ویژگی_محلی)
    الف.آزادسازی()
    بافر_محلی.آزادسازی()
پایان
