واردسازی کانال
واردسازی استخر

تابع ریشه:
    ناپایا a := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
    ناپایا b := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
    a.مقداردهی(2 برگردان صحیح۶۴)
    b.مقداردهی(2 برگردان صحیح۶۴)
    ناپایا all := وکتور {} برگردان وکتور<کانال.کانال<صحیح۶۴>>
    all.بیفزا(a)
    all.بیفزا(b)
    p := استخر.جدید(1 برگردان صحیح۶۴، 2 برگردان صحیح۶۴)
    استخر.ارسال(p، (): b.فرستادن(42 برگردان صحیح۶۴) پایان)
    ناپایا v := 0 برگردان صحیح۶۴
    سرچاپ کانال.گزینش(all، v، 1000 برگردان صحیح۶۴)
    سرچاپ v
    سرچاپ کانال.گزینش(all، v، 10 برگردان صحیح۶۴)
    a.بستن()
    b.بستن()
    سرچاپ کانال.گزینش(all، v، 10 برگردان صحیح۶۴)
    استخر.توقف(p)
    a.آزادسازی()
    b.آزادسازی()
پایان
