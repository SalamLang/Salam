واردسازی کانال

تابع ریشه:
    ناپایا کار := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
    کار.مقداردهی(1 برگردان صحیح۶۴)
    ناپایا متغیر_cs := وکتور {} برگردان وکتور<کانال.کانال<صحیح۶۴>>
    متغیر_cs.بیفزا(کار)
    موقت := کانال.پس از(30 برگردان صحیح۶۴)
    متغیر_cs.بیفزا(موقت.کانال)
    ناپایا مقدار_محلی := 0 برگردان صحیح۶۴
    سرچاپ "timer fired first: "، کانال.گزینش(متغیر_cs، مقدار_محلی، 2000 برگردان صحیح۶۴)
    سرچاپ "tick value: "، مقدار_محلی
    کانال.توقف زمان‌سنج(موقت)

    شمارنده۳ := کانال.ضربان(10 برگردان صحیح۶۴)
    ناپایا موفق := نادرست
    ناپایا دیده := 0
    تا دیده کوچکتر 3:
        شمارنده۳.کانال.دریافت(موفق)
        دیده++
    پایان
    سرچاپ "ticks: "، دیده
    کانال.توقف زمان‌سنج(شمارنده۳)

    متغیر_quick := کانال.پس از(500 برگردان صحیح۶۴)
    کانال.توقف زمان‌سنج(متغیر_quick)
    سرچاپ "stopped early"
    کار.آزادسازی()
پایان
