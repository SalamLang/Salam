واردسازی کانال

تابع ریشه:
    ناپایا work := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
    work.مقداردهی(1 برگردان صحیح۶۴)
    ناپایا cs := وکتور {} برگردان وکتور<کانال.کانال<صحیح۶۴>>
    cs.بیفزا(work)
    t := کانال.پس از(30 برگردان صحیح۶۴)
    cs.بیفزا(t.کانال)
    ناپایا v := 0 برگردان صحیح۶۴
    سرچاپ "timer fired first: "، کانال.گزینش(cs، v، 2000 برگردان صحیح۶۴)
    سرچاپ "tick value: "، v
    کانال.توقف زمان‌سنج(t)

    k := کانال.ضربان(10 برگردان صحیح۶۴)
    ناپایا ok := نادرست
    ناپایا seen := 0
    تا seen کوچکتر 3:
        k.کانال.دریافت(ok)
        seen++
    پایان
    سرچاپ "ticks: "، seen
    کانال.توقف زمان‌سنج(k)

    quick := کانال.پس از(500 برگردان صحیح۶۴)
    کانال.توقف زمان‌سنج(quick)
    سرچاپ "stopped early"
    work.آزادسازی()
پایان
