واردسازی خط فرمان
واردسازی رشته

روال اجرا کن(ب &: خط فرمان.برنامه، خط: رشته):
    آرگ := رشته.تفکیک کردن(خط، " ")
    د := خط فرمان.توزیع(ب، آرگ)
    اگر د == خط فرمان.دستور راهنما:
        سرچاپ "راهنما خواسته شد"
    وگرنه د == خط فرمان.دستور نسخه:
        سرچاپ "نسخه:", ب.version
    وگرنه د == خط فرمان.دستور نامشخص:
        سرچاپ "دستور ناشناخته"
    وگرنه:
        سرچاپ "اجرا:", د، خط فرمان.آرگومان‌های باقیمانده(آرگ)
    پایان
    آرگ.آزادکن()
پایان

روال ریشه:
    ناپایا ب := خط فرمان.جدید("salamctl"، "مدیریت پروژه"، "1.0.0")
    خط فرمان.ثبت(ب، "build"، "ساختن پروژه")
    خط فرمان.ثبت(ب، "test"، "اجرای آزمون‌ها")
    سرچاپ خط فرمان.دستور دارد(ب، "build")، خط فرمان.شرح دستور(ب، "test")
    هر خط در ["build --fast"، "--help"، "--version"، "deploy"]:
        اجرا کن(ب، خط)
    پایان
    چاپ خط فرمان.راهنما(ب)
پایان
