واردسازی خط فرمان
واردسازی پرچم

روال ریشه:
    ناپایا پ := پرچم.جدید("deploy"، "")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن رشته(پ، "host"، "h"، ""، "سرور")
    پرچم.افزودن رشته(پ، "user"، "u"، ""، "کاربر")
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("--host=example.com")
    پرچم.تجزیه(پ، آرگ)
    ناپایا لازم := وکتور {} برگردان وکتور<رشته>
    دیرکن لازم.آزادکن()
    لازم.بیفزا("host")
    لازم.بیفزا("user")
    سرچاپ "جاافتاده:", خط فرمان.الزامی بودن پرچم‌ها(پ، لازم)
پایان
