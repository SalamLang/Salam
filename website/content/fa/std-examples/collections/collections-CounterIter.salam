واردسازی مجموعه ها
واردسازی رشته

تابع ریشه:
    ناپایا ش := مجموعه ها.شمارنده {} برگردان مجموعه ها.شمارنده<رشته>
    دیرکن ش.آزادسازی()
    هر و۱ در رشته.واژه ها("به نام خدا به نام دوست به"):
        ش.افزودن(و۱)
    پایان
    ناپایا جمع := ۰
    ناپایا پی := ش.پیمایش()
    تا پی.بعدی دارد():
        اگر پی.کلید() == "به":
            سرچاپ پی.کلید()، پی.مقدار()
        پایان
        جمع += پی.مقدار()
        پی.بعدی()
    پایان
    سرچاپ جمع، ش.متمایز()
پایان
