روال ریشه:
    ناپایا ن := نگاشت {} برگردان نگاشت<رشته، صحیح>
    دیرکن ن.آزادسازی()
    سرچاپ ن.خالی است()
    ن.قراردادن("سیب"، ۳)
    ن.درج("انار"، ۵)
    ن.قراردادن("سیب"، ۴)
    سرچاپ ن.اندازه()، ن.دارد("سیب")، ن.دریافت("سیب")، ن.دریافت با پیش فرض("موز"، ۰)
    سرچاپ ن.حذف("انار")، ن.حذف("انار")، ن.اندازه()
    ناپایا پ := ن.پیمایشگر()
    تا پ.بعدی دارد():
        سرچاپ پ.کلید()، پ.مقدار()
        پ.بعدی()
    پایان
پایان
