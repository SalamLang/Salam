واردسازی مجموعه ها

تابع ریشه:
    ناپایا ن := مجموعه ها.نگاشت مرتب {}
    دیرکن ن.آزادسازی()
    ن.تنظیم("نام"، "سلام")
    ن.تنظیم("نسخه"، "۰.۴.۸")
    ن.تنظیم("زبان"، "فارسی")
    سرچاپ ن.طول()، ن.دارد("نسخه")، ن.دریافت("نام")، ن.دریافت با پیش فرض("مجوز"، "-")
    سرچاپ ن.نمایه کلید("زبان")، ن.کلید در(۰)، ن.مقدار در(۰)
    ن.تنظیم در(۰، "Salam")
    سرچاپ ن.حذف("نسخه")، ن.طول()
    کلیدها := ن.رونوشت کلیدها()
    سرچاپ کلیدها
پایان
