واردسازی مجموعه ها

تابع ریشه:
    ناپایا ن := مجموعه ها.نگاشت مرتب {}
    دیرکن ن.آزادسازی()
    ن.تنظیم("نام"، "سلام")
    ن.تنظیم("نسخه"، "۰.۵.۰")
    ن.تنظیم("زبان"، "فارسی")
    ناپایا پی := ن.پیمایش()
    تا پی.بعدی دارد():
        سرچاپ پی.کلید()، پی.مقدار()
        پی.بعدی()
    پایان
پایان
