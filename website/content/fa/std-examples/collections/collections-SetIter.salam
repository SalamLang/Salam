واردسازی مجموعه ها

تابع ریشه:
    ناپایا م := مجموعه ها.مجموعه {} برگردان مجموعه ها.مجموعه<رشته>
    دیرکن م.آزادسازی()
    هر ب در ["سلام"، "دنیا"، "سلام"]:
        م.افزودن(ب)
    پایان
    ناپایا دیده := ۰
    ناپایا پی := م.پیمایش()
    تا پی.بعدی دارد():
        اگر م.دارد(پی.مقدار()):
            دیده += ۱
        پایان
        پی.بعدی()
    پایان
    سرچاپ دیده، م.اندازه()
پایان
