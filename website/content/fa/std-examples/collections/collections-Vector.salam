تابع ریشه:
    ناپایا و۱ := وکتور {} برگردان وکتور<صحیح>
    دیرکن و۱.آزادسازی()
    و۱.رزرو(۸)
    سرچاپ و۱.طول()، و۱.ظرفیت() >= ۸، و۱.خالی است()
    و۱.افزودن(۱۰)
    و۱.افزودن(۲۰)
    و۱.افزودن(۳۰)
    سرچاپ و۱، و۱.اول()، و۱.آخر()، و۱.دریافت(۱)، و۱[۲]
    و۱.تنظیم(۰، ۱۱)
    و۱[۱] = ۲۲
    و۱.درج(۱، ۱۵)
    سرچاپ و۱
    سرچاپ و۱.حذف در(۱)، و۱.برداشتن()، و۱
    ا := و۱.ارجاع(۰)
    ا[۰] = ۹۹
    سرچاپ و۱
    و۱.تنظیم با تغییر اندازه(و۱.طول()، ۷)
    سرچاپ و۱
    و۱.پاک‌سازی()
    سرچاپ و۱.طول()
    ناپایا ص := وکتور {} برگردان وکتور<صحیح>
    دیرکن ص.آزادسازی()
    ص.صفرها(۳)
    سرچاپ ص
    ناپایا خ := وکتور {} برگردان وکتور<صحیح>
