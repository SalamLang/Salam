واردسازی رابط گرافیکی.رنگ
واردسازی ریاضی

تابع r2(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 100.0) / 100.0
پایان

تابع ریشه:
    white := رنگ.هگز(0xffffff)
    هر hex در [0x777777، 0x3366aa، 0x1a1a1a]:
        c := رنگ.هگز(hex)
        سرچاپ رنگ.سی اس اس(c)، "luminance"، r2(رنگ.درخشندگی(c))، "contrast on white"، r2(رنگ.نسبت تضاد(c، white))
    پایان
    base := رنگ.هگز(0x3366aa)
    سرچاپ "lighter"، رنگ.سی اس اس(رنگ.روشن تر(base، 0.1))، "darker"، رنگ.سی اس اس(رنگ.تیره تر(base، 0.1))
پایان
