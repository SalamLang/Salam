واردسازی رابط گرافیکی.رنگ

تابع show(text: رشته):
    ناپایا c := رنگ.رنگ {}
    اگر رنگ.تجزیه(text، c):
        سرچاپ text
        سرچاپ "  css   "، رنگ.سی اس اس(c)
        سرچاپ "  source"، رنگ.کد سلام(c)
        سرچاپ "  in sRGB"، رنگ.درون گستره(c)، "same as #f00"، رنگ.یکسان(c، رنگ.هگز(0xff0000))
    پایان
پایان

تابع ریشه:
    show("red")
    show("rgba(0, 0, 0, 0.25)")
    show("color(display p3, 1, 0, 0)")
    show("color(rec2020, 1, 0, 0)")
    show("current")
پایان
