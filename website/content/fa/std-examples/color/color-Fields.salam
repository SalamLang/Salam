واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    c := رنگ.آر جی بی آلفا(51، 102، 170، 0.5)
    سرچاپ "r"، c.قرمز، "g"، c.سبز، "b"، c.آبی، "a"، c.آلفا، "current"، c.کنونی
    wide := رنگ.تازه(1.093، -0.227، -0.15، 1.0)
    سرچاپ "wide gamut red keeps channels outside 0 to 1:"، wide.قرمز، wide.سبز
    سرچاپ "argb"، رنگ.ای آر جی بی(c)، "back"، رنگ.سی اس اس(رنگ.از ای آر جی بی(رنگ.ای آر جی بی(c)))
    سرچاپ "argb clamps"، رنگ.ای آر جی بی(wide)
