واردسازی فشرده سازی

تابع ریشه:
    متن := "سلام بی‌زیپ! سلام بی‌زیپ! سلام بی‌زیپ! سلام بی‌زیپ!"
    ز := فشرده سازی.فشرده سازی بی زیپ دو رشته(متن)
    سرچاپ فشرده سازی.دریافت بایت(ز، ۰)، فشرده سازی.دریافت بایت(ز، ۱)، فشرده سازی.دریافت بایت(ز، ۲)، فشرده سازی.دریافت بایت(ز، ۳)
    ناپایا خوب := نادرست
    ب := فشرده سازی.کدگشایی بی زیپ دو بافر(ز، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(ب) == متن
    مبدا := فشرده سازی.بافر از رشته(متن)
    ز۲ := فشرده سازی.فشرده سازی بی زیپ دو بافر(مبدا)
    ز۳ := فشرده سازی.فشرده سازی بی زیپ دو(مبدا.داده، مبدا.طول)
    سرچاپ فشرده سازی.برابری بافر(ز۲، ز۳)
    ز۴ := فشرده سازی.فشرده سازی بی زیپ دو با سطح(مبدا.داده، مبدا.طول، ۱)
    سرچاپ فشرده سازی.دریافت بایت(ز۴، ۳)
    برگشتی := فشرده سازی.کدگشایی بی زیپ دو(ز۴.داده، ز۴.طول، خوب)
    سرچاپ خوب، فشرده سازی.برابری بافر(برگشتی، مبدا)
    _ := فشرده سازی.کدگشایی بی زیپ دو(مبدا.داده، مبدا.طول، خوب)
    سرچاپ خوب
    _ := فشرده سازی.کدگشایی بی زیپ دو با سقف(ز.داده، ز.طول، ۱۰، خوب)
    سرچاپ خوب
    کامل := فشرده سازی.کدگشایی بی زیپ دو با سقف(ز.داده، ز.طول، ۱۰۰۰، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(کامل) == متن
پایان
