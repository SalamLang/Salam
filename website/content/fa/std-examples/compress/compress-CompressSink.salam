// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته

تابع collect(p: تهی*، n: صحیح، c: تهی*): منطقی:
    فشرده سازی.افزودن بایت‌ها((c برگردان فشرده سازی.بافر بایت*)[0]، p، n)
    برگشت درست
پایان

تابع ریشه:
    ناپایا متن := فشرده سازی.بافر بایت جدید()
    تکرار 20000 در شمارنده:
        خط := "record " + رشته.از عدد((شمارنده * 13) برگردان صحیح۶۴) + " ok\n"
        فشرده سازی.افزودن بایت‌ها(متن، خط برگردان تهی*، خط.طول())
    پایان
    بایگانی.نوشتن پرونده دودویی از بافر("sink.tmp"، متن)
    پرونده_باز := فشرده سازی.بازکردن پرونده برای خواندن("sink.tmp")
    اندازه := فشرده سازی.اندازه پرونده(پرونده_باز)
    خروجی_مقدار := حافظه.تخصیص صفرشده(اندازه‌گونه(فشرده سازی.بافر بایت)) برگردان فشرده سازی.بافر بایت*
    متغیر_emit := (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان

    خروجی_مقدار[0] = فشرده سازی.بافر بایت جدید()
    ناپایا متغیر_bz := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، متغیر_emit، خروجی_مقدار برگردان تهی*)
    سرچاپ فشرده سازی.فشرده سازی بی زیپ دو پرونده به مقصد(پرونده_باز، 0 برگردان صحیح۶۴، اندازه، 9، متغیر_bz)
    ناپایا متغیر_one := فشرده سازی.فشرده سازی بی زیپ دو با سطح(متن.داده، متن.طول، 9)
    سرچاپ "bzip2 same bytes"، فشرده سازی.برابری بافر(خروجی_مقدار[0]، متغیر_one)
    ناپایا موفق := نادرست
    ناپایا بازگشت := فشرده سازی.کدگشایی بی زیپ دو(خروجی_مقدار[0].داده، خروجی_مقدار[0].طول، موفق)
    سرچاپ "bzip2 round trip"، موفق، فشرده سازی.برابری بافر(بازگشت، متن)
    فشرده سازی.آزادسازی بافر(بازگشت)
    فشرده سازی.آزادسازی بافر(متغیر_one)
    فشرده سازی.آزادسازی بافر(خروجی_مقدار[0])

    خروجی_مقدار[0] = فشرده سازی.بافر بایت جدید()
    ناپایا متغیر_zs := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، متغیر_emit، خروجی_مقدار برگردان تهی*)
    سرچاپ فشرده سازی.فشرده سازی زستد پرونده به مقصد(پرونده_باز، 0 برگردان صحیح۶۴، اندازه، 3، متغیر_zs)
    متغیر_one = فشرده سازی.فشرده سازی زستد با سطح(متن.داده، متن.طول، 3)
    سرچاپ "zstd same bytes"، فشرده سازی.برابری بافر(خروجی_مقدار[0]، متغیر_one)
    بازگشت = فشرده سازی.کدگشایی زستد(خروجی_مقدار[0].داده، خروجی_مقدار[0].طول، موفق)
    سرچاپ "zstd round trip"، موفق، فشرده سازی.برابری بافر(بازگشت، متن)
    فشرده سازی.آزادسازی بافر(بازگشت)
    فشرده سازی.آزادسازی بافر(متغیر_one)
    فشرده سازی.آزادسازی بافر(خروجی_مقدار[0])

    خروجی_مقدار[0] = فشرده سازی.بافر بایت جدید()
    ناپایا الزد := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، متغیر_emit، خروجی_مقدار برگردان تهی*)
    سرچاپ فشرده سازی.فشرده سازی الزد ام ای پرونده به مقصد(پرونده_باز، 0 برگردان صحیح۶۴، اندازه، 6، درست، الزد)
    بازگشت = فشرده سازی.کدگشایی الزد ام ای خام(خروجی_مقدار[0].داده، 5، ((خروجی_مقدار[0].داده برگردان صحیح۶۴) + (5 برگردان صحیح۶۴)) برگردان تهی*، خروجی_مقدار[0].طول - 5، متن.طول، 0، موفق)
    سرچاپ "lzma round trip"، موفق، فشرده سازی.برابری بافر(بازگشت، متن)
    فشرده سازی.آزادسازی بافر(بازگشت)
    فشرده سازی.آزادسازی بافر(خروجی_مقدار[0])

    فشرده سازی.بستن پرونده(پرونده_باز)
    حافظه.آزادسازی(خروجی_مقدار برگردان تهی*)
    فشرده سازی.آزادسازی بافر(متن)
    سیستم عامل.حذف("sink.tmp")
پایان
