// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته

تابع collect(p: تهی*، n: صحیح، c: تهی*): منطقی:
    فشرده سازی.افزودن بایت‌ها((c برگردان فشرده سازی.بافر بایت*)[0]، p، n)
    برگشت درست
پایان

تابع ریشه:
    ناپایا text := فشرده سازی.بافر بایت جدید()
    تکرار 20000 در i:
        line := "record " + رشته.از عدد((i * 13) برگردان صحیح۶۴) + " ok\n"
        فشرده سازی.افزودن بایت‌ها(text، line برگردان تهی*، line.طول())
    پایان
    بایگانی.نوشتن پرونده دودویی از بافر("sink.tmp"، text)
    fp := فشرده سازی.بازکردن پرونده برای خواندن("sink.tmp")
    size := فشرده سازی.اندازه پرونده(fp)
    out := حافظه.تخصیص صفرشده(اندازه‌گونه(فشرده سازی.بافر بایت)) برگردان فشرده سازی.بافر بایت*
    emit := (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان

    out[0] = فشرده سازی.بافر بایت جدید()
    ناپایا bz := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، emit، out برگردان تهی*)
    سرچاپ فشرده سازی.فشرده سازی بی زیپ دو پرونده به مقصد(fp، 0 برگردان صحیح۶۴، size، 9، bz)
    ناپایا one := فشرده سازی.فشرده سازی بی زیپ دو با سطح(text.داده، text.طول، 9)
    سرچاپ "bzip2 same bytes"، فشرده سازی.برابری بافر(out[0]، one)
    ناپایا ok := نادرست
    ناپایا back := فشرده سازی.کدگشایی بی زیپ دو(out[0].داده، out[0].طول، ok)
    سرچاپ "bzip2 round trip"، ok، فشرده سازی.برابری بافر(back، text)
    فشرده سازی.آزادسازی بافر(back)
    فشرده سازی.آزادسازی بافر(one)
    فشرده سازی.آزادسازی بافر(out[0])

    out[0] = فشرده سازی.بافر بایت جدید()
    ناپایا zs := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، emit، out برگردان تهی*)
    سرچاپ فشرده سازی.فشرده سازی زستد پرونده به مقصد(fp، 0 برگردان صحیح۶۴، size، 3، zs)
    one = فشرده سازی.فشرده سازی زستد با سطح(text.داده، text.طول، 3)
    سرچاپ "zstd same bytes"، فشرده سازی.برابری بافر(out[0]، one)
    back = فشرده سازی.کدگشایی زستد(out[0].داده، out[0].طول، ok)
    سرچاپ "zstd round trip"، ok، فشرده سازی.برابری بافر(back، text)
    فشرده سازی.آزادسازی بافر(back)
    فشرده سازی.آزادسازی بافر(one)
    فشرده سازی.آزادسازی بافر(out[0])

    out[0] = فشرده سازی.بافر بایت جدید()
    ناپایا lz := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، emit، out برگردان تهی*)
    سرچاپ فشرده سازی.فشرده سازی الزد ام ای پرونده به مقصد(fp، 0 برگردان صحیح۶۴، size، 6، درست، lz)
    back = فشرده سازی.کدگشایی الزد ام ای خام(out[0].داده، 5، ((out[0].داده برگردان صحیح۶۴) + (5 برگردان صحیح۶۴)) برگردان تهی*، out[0].طول - 5، text.طول، 0، ok)
    سرچاپ "lzma round trip"، ok، فشرده سازی.برابری بافر(back، text)
    فشرده سازی.آزادسازی بافر(back)
    فشرده سازی.آزادسازی بافر(out[0])

    فشرده سازی.بستن پرونده(fp)
    حافظه.آزادسازی(out برگردان تهی*)
    فشرده سازی.آزادسازی بافر(text)
    سیستم عامل.حذف("sink.tmp")
پایان
