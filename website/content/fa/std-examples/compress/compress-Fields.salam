واردسازی فشرده سازی

تابع ریشه:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(بافر_محلی، "abc" برگردان تهی*، 3)
    سرچاپ بافر_محلی.طول، بافر_محلی.ظرفیت بزرگتربرابر بافر_محلی.طول، بافر_محلی.داده نابرابر پوچ
    ناپایا خوانده := فشرده سازی.خواننده از بافر(بافر_محلی)
    سرچاپ خوانده.طول، خوانده.جایگاه، خوانده.خراب، خوانده.داده برابر بافر_محلی.داده
    _ := فشرده سازی.خواندن بایت(خوانده)
    سرچاپ خوانده.جایگاه
    _ := فشرده سازی.خواندن بایت‌ها(خوانده، 5)
    سرچاپ خوانده.خراب

    ناپایا نویسنده := فشرده سازی.نویسنده بیت جدید()
    فشرده سازی.نوشتن بیت‌ها(نویسنده، 5، 3)
    سرچاپ نویسنده.شمار بیت‌ها، نویسنده.انباره، نویسنده.بافر.طول
    فشرده سازی.تخلیه بیت(نویسنده)
    سرچاپ نویسنده.شمار بیت‌ها، نویسنده.بافر.طول
    ناپایا متغیر_br := فشرده سازی.خواننده بیت از بافر(نویسنده.بافر)
    سرچاپ متغیر_br.طول، متغیر_br.جایگاه، متغیر_br.شمار بیت‌ها، متغیر_br.انباره، متغیر_br.خراب، متغیر_br.داده برابر نویسنده.بافر.داده
    سرچاپ فشرده سازی.خواندن بیت‌ها(متغیر_br، 3)، متغیر_br.شمار بیت‌ها، متغیر_br.جایگاه
    _ := فشرده سازی.خواندن بیت‌ها(متغیر_br، 16)
    سرچاپ متغیر_br.خراب
    فشرده سازی.آزادسازی نویسنده بیت(نویسنده)
    فشرده سازی.آزادسازی بافر(بافر_محلی)

    متغیر_methods := [فشرده سازی.روش هیچ، فشرده سازی.روش آر ال ای، فشرده سازی.روش هافمن، فشرده سازی.روش الزد۷۷، فشرده سازی.روش ال زد دبلیو، فشرده سازی.روش دیفلیت، فشرده سازی.روش باروز ویلر]
    هر تعداد۲ در متغیر_methods:
        خروجی_مقدار := فشرده سازی.فشرده سازی رشته(تعداد۲، "aaaaabbbbbaaaaabbbbb")
        سرچاپ تعداد۲، فشرده سازی.بافر به رشته(فشرده سازی.کدگشایی(تعداد۲، خروجی_مقدار.داده، خروجی_مقدار.طول))
