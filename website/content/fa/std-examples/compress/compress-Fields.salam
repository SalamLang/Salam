واردسازی فشرده سازی

تابع ریشه:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بایت‌ها(b، "abc" برگردان تهی*، 3)
    سرچاپ b.طول، b.ظرفیت بزرگتربرابر b.طول، b.داده نابرابر پوچ
    ناپایا r := فشرده سازی.خواننده از بافر(b)
    سرچاپ r.طول، r.جایگاه، r.خراب، r.داده برابر b.داده
    _ := فشرده سازی.خواندن بایت(r)
    سرچاپ r.جایگاه
    _ := فشرده سازی.خواندن بایت‌ها(r، 5)
    سرچاپ r.خراب

    ناپایا w := فشرده سازی.نویسنده بیت جدید()
    فشرده سازی.نوشتن بیت‌ها(w، 5، 3)
    سرچاپ w.شمار بیت‌ها، w.انباره، w.بافر.طول
    فشرده سازی.تخلیه بیت(w)
    سرچاپ w.شمار بیت‌ها، w.بافر.طول
    ناپایا br := فشرده سازی.خواننده بیت از بافر(w.بافر)
    سرچاپ br.طول، br.جایگاه، br.شمار بیت‌ها، br.انباره، br.خراب، br.داده برابر w.بافر.داده
    سرچاپ فشرده سازی.خواندن بیت‌ها(br، 3)، br.شمار بیت‌ها، br.جایگاه
    _ := فشرده سازی.خواندن بیت‌ها(br، 16)
    سرچاپ br.خراب
    فشرده سازی.آزادسازی نویسنده بیت(w)
    فشرده سازی.آزادسازی بافر(b)

    methods := [فشرده سازی.روش هیچ، فشرده سازی.روش آر ال ای، فشرده سازی.روش هافمن، فشرده سازی.روش الزد۷۷، فشرده سازی.روش ال زد دبلیو، فشرده سازی.روش دیفلیت، فشرده سازی.روش باروز ویلر]
    هر m در methods:
        out := فشرده سازی.فشرده سازی رشته(m، "aaaaabbbbbaaaaabbbbb")
        سرچاپ m، فشرده سازی.بافر به رشته(فشرده سازی.کدگشایی(m، out.داده، out.طول))
    پایان
