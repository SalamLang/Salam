واردسازی فشرده سازی

تابع ریشه:
    متن := "سلام جی‌زیپ! سلام جی‌زیپ! سلام جی‌زیپ!"
    ج := فشرده سازی.فشرده سازی جی زیپ رشته(متن)
    سرچاپ فشرده سازی.دریافت بایت(ج، ۰)، فشرده سازی.دریافت بایت(ج، ۱)
    ناپایا خوب := نادرست
    ب := فشرده سازی.کدگشایی جی زیپ بافر(ج، خوب)
    سرچاپ خوب، فشرده سازی.بافر به رشته(ب) == متن
    ب۲ := فشرده سازی.بافر از رشته(متن)
    ج۲ := فشرده سازی.فشرده سازی جی زیپ بافر(ب۲)
    ج۳ := فشرده سازی.فشرده سازی جی زیپ(ب۲.data، ب۲.len)
    سرچاپ فشرده سازی.برابری بافر(ج۲، ج۳)
    _ := فشرده سازی.کدگشایی جی زیپ(ب۲.data، ب۲.len، خوب)
    سرچاپ خوب
    د := فشرده سازی.فشرده سازی دیفلیت(ب۲.data، ب۲.len)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی دیفلیت(د.data، د.len)، ب۲)
    خام := فشرده سازی.دیفلیت خام(ب۲.data، ب۲.len)
    باز := فشرده سازی.کدگشایی دیفلیت خام(خام.data، خام.len، ب۲.len، خوب)
    سرچاپ خوب، فشرده سازی.برابری بافر(باز، ب۲)
پایان
