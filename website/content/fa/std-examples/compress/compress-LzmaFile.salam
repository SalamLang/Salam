// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی رشته

تابع collect(p: تهی*، n: صحیح، c: تهی*): منطقی:
    فشرده سازی.افزودن بایت‌ها((c برگردان فشرده سازی.بافر بایت*)[0]، p، n)
    برگشت درست
پایان

تابع ریشه:
    ناپایا text := فشرده سازی.بافر بایت جدید()
    تکرار 2000 در i:
        line := "row " + رشته.از عدد((i * 3) برگردان صحیح۶۴) + "\n"
        فشرده سازی.افزودن بایت‌ها(text، line برگردان تهی*، line.طول())
    پایان
    packed := فشرده سازی.فشرده سازی الزد ام ای(text.داده، text.طول)
    بایگانی.نوشتن پرونده دودویی از بافر("lz.tmp"، packed)

    fp := فشرده سازی.بازکردن پرونده برای خواندن("lz.tmp")
    got := حافظه.تخصیص صفرشده(اندازه‌گونه(فشرده سازی.بافر بایت)) برگردان فشرده سازی.بافر بایت*
    got[0] = فشرده سازی.بافر بایت جدید()
    ناپایا sink := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، got برگردان تهی*)
    st := فشرده سازی.کدگشایی الزد ام ای از پرونده به مقصد(packed.داده، 5، fp، 13 برگردان صحیح۶۴، (packed.طول - 13) برگردان صحیح۶۴، text.طول برگردان صحیح۶۴، sink، 0 برگردان صحیح۶۴)
    فشرده سازی.بستن پرونده(fp)
    سرچاپ st، sink.نوشته شده، فشرده سازی.برابری بافر(got[0]، text)

    fp2 := فشرده سازی.بازکردن پرونده برای خواندن("lz.tmp")
    ناپایا small := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، got برگردان تهی*)
    سرچاپ فشرده سازی.کدگشایی الزد ام ای از پرونده به مقصد(packed.داده، 5، fp2، 13 برگردان صحیح۶۴، (packed.طول - 13) برگردان صحیح۶۴، text.طول برگردان صحیح۶۴، small، 100 برگردان صحیح۶۴)
    فشرده سازی.بستن پرونده(fp2)
    فشرده سازی.آزادسازی بافر(got[0])
    حافظه.آزادسازی(got برگردان تهی*)
پایان
