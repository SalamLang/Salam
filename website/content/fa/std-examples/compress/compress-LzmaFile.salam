// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی رشته

تابع collect(p: تهی*، n: صحیح، c: تهی*): منطقی:
    فشرده سازی.افزودن بایت‌ها((c برگردان فشرده سازی.بافر بایت*)[0]، p، n)
    برگشت درست
پایان

تابع ریشه:
    ناپایا متن := فشرده سازی.بافر بایت جدید()
    تکرار 2000 در شمارنده:
        خط := "row " + رشته.از عدد((شمارنده * 3) برگردان صحیح۶۴) + "\n"
        فشرده سازی.افزودن بایت‌ها(متن، خط برگردان تهی*، خط.طول())
    پایان
    بسته_شده := فشرده سازی.فشرده سازی الزد ام ای(متن.داده، متن.طول)
    بایگانی.نوشتن پرونده دودویی از بافر("lz.tmp"، بسته_شده)

    پرونده_باز := فشرده سازی.بازکردن پرونده برای خواندن("lz.tmp")
    گرفته := حافظه.تخصیص صفرشده(اندازه‌گونه(فشرده سازی.بافر بایت)) برگردان فشرده سازی.بافر بایت*
    گرفته[0] = فشرده سازی.بافر بایت جدید()
    ناپایا مقصد_جریان := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، گرفته برگردان تهی*)
    سبک_متن := فشرده سازی.کدگشایی الزد ام ای از پرونده به مقصد(بسته_شده.داده، 5، پرونده_باز، 13 برگردان صحیح۶۴، (بسته_شده.طول - 13) برگردان صحیح۶۴، متن.طول برگردان صحیح۶۴، مقصد_جریان، 0 برگردان صحیح۶۴)
    فشرده سازی.بستن پرونده(پرونده_باز)
    سرچاپ سبک_متن، مقصد_جریان.نوشته شده، فشرده سازی.برابری بافر(گرفته[0]، متن)

    متغیر_fp2 := فشرده سازی.بازکردن پرونده برای خواندن("lz.tmp")
    ناپایا کوچک := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، گرفته برگردان تهی*)
    سرچاپ فشرده سازی.کدگشایی الزد ام ای از پرونده به مقصد(بسته_شده.داده، 5، متغیر_fp2، 13 برگردان صحیح۶۴، (بسته_شده.طول - 13) برگردان صحیح۶۴، متن.طول برگردان صحیح۶۴، کوچک، 100 برگردان صحیح۶۴)
    فشرده سازی.بستن پرونده(متغیر_fp2)
    فشرده سازی.آزادسازی بافر(گرفته[0])
    حافظه.آزادسازی(گرفته برگردان تهی*)
پایان
