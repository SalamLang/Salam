واردسازی فشرده سازی

تابع ریشه:
    متن := "آبآبآبآبآبآب سلام سلام سلام سلام سلام سلام سلام سلام"
    ب := فشرده سازی.بافر از رشته(متن)
    هر روش در [فشرده سازی.روش هیچ، فشرده سازی.روش آر ال ای، فشرده سازی.روش هافمن، فشرده سازی.روش الزد۷۷، فشرده سازی.روش ال زد دبلیو، فشرده سازی.روش دیفلیت، فشرده سازی.روش باروز ویلر]:
        ناپایا ف := فشرده سازی.فشرده سازی بافر(روش، ب)
        ناپایا ب۲ := فشرده سازی.کدگشایی بافر(روش، ف)
        سرچاپ روش، فشرده سازی.طول بافر(ف)، فشرده سازی.برابری بافر(ب، ب۲)
        فشرده سازی.آزادسازی بافر(ف)
        فشرده سازی.آزادسازی بافر(ب۲)
    پایان
    ناپایا بهترین := ۰
    ف := فشرده سازی.بهترین فشرده سازی(ب.داده، ب.طول، بهترین)
    سرچاپ بهترین، فشرده سازی.نسبت(ف.طول، ب.طول) < ۱.۰
    ر := فشرده سازی.فشرده سازی رشته(فشرده سازی.روش دیفلیت، "aaaaaaaaaa")
    ب۳ := فشرده سازی.کدگشایی(فشرده سازی.روش دیفلیت، ر.داده، ر.طول)
    سرچاپ فشرده سازی.بافر به رشته(ب۳)
    ب۴ := فشرده سازی.فشرده سازی(فشرده سازی.روش آر ال ای، ب.داده، ب.طول)
    سرچاپ فشرده سازی.طول بافر(ب۴) > ۰، فشرده سازی.روش.هافمن
    سرچاپ فشرده سازی.طول بافر(فشرده سازی.کدگشایی طول اجرا(فشرده سازی.فشرده سازی طول اجرا(ب.داده، ب.طول).داده، فشرده سازی.فشرده سازی طول اجرا(ب.داده، ب.طول).طول)) == ب.طول
    ه := فشرده سازی.فشرده سازی هافمن(ب.داده، ب.طول)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی هافمن(ه.داده، ه.طول)، ب)
    ل := فشرده سازی.فشرده سازی الزد۷۷(ب.داده، ب.طول)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی الزد۷۷(ل.داده، ل.طول)، ب)
    و۲ := فشرده سازی.فشرده سازی ال زد دبلیو(ب.داده، ب.طول)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی ال زد دبلیو(و۲.داده، و۲.طول)، ب)
    ب۵ := فشرده سازی.فشرده سازی باروز ویلر(ب.داده، ب.طول)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی باروز ویلر(ب۵.داده، ب۵.طول)، ب)
    ناپایا اصلی := ۰
    ت := فشرده سازی.تبدیل باروز ویلر(ب.داده، ۶، اصلی)
    سرچاپ اصلی، فشرده سازی.بافر به رشته(فشرده سازی.معکوس باروز ویلر(ت.داده، ت.طول، اصلی)) == "آبآ"
    م := فشرده سازی.کدگذاری انتقال به جلو(ب)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی انتقال به جلو(م)، ب)
    ناپایا متغیر_good := نادرست
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی طول اجرا با سقف(ب۴.داده، ب۴.طول، 0، متغیر_good)، ب)، متغیر_good
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی هافمن با سقف(ه.داده، ه.طول، 0، متغیر_good)، ب)، متغیر_good
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی الزد۷۷ با سقف(ل.داده، ل.طول، 0، متغیر_good)، ب)، متغیر_good
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی ال زد دبلیو با سقف(و۲.داده، و۲.طول، 0، متغیر_good)، ب)، متغیر_good
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی باروز ویلر با سقف(ب۵.داده، ب۵.طول، 0، متغیر_good)، ب)، متغیر_good
    متغیر_df := فشرده سازی.فشرده سازی دیفلیت(ب.داده، ب.طول)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی دیفلیت با سقف(متغیر_df.داده، متغیر_df.طول، 0، متغیر_good)، ب)، متغیر_good
    سرچاپ فشرده سازی.طول بافر(فشرده سازی.کدگشایی با سقف(فشرده سازی.روش الزد۷۷، ل.داده، ل.طول، 1، متغیر_good))، متغیر_good
    سرچاپ فشرده سازی.طول بافر(فشرده سازی.کدگشایی با سقف(فشرده سازی.روش الزد۷۷، "not compressed data" برگردان تهی*، 19، 0، متغیر_good))، متغیر_good

پایان
