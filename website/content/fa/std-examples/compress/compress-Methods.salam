واردسازی فشرده سازی

تابع ریشه:
    متن := "آبآبآبآبآبآب سلام سلام سلام سلام سلام سلام سلام سلام"
    ب := فشرده سازی.بافر از رشته(متن)
    هر روش در [فشرده سازی.روش هیچ، فشرده سازی.روش آر ال ای، فشرده سازی.روش هافمن، فشرده سازی.روش الزد۷۷، فشرده سازی.روش ال زد دبلیو، فشرده سازی.روش دیفلیت، فشرده سازی.روش باروز ویلر]:
        ناپایا ف := فشرده سازی.فشرده سازی بافر(روش، ب)
        ناپایا ب۲ := فشرده سازی.کدگشایی بافر(روش، ف)
        سرچاپ روش، فشرده سازی.طول بافر(ف)، فشرده سازی.برابری بافر(ب، ب۲)
        فشرده سازی.آزادسازی بافر(ف)
        فشرده سازی.آزادسازی بافر(ب۲)
    پایان
    ناپایا بهترین := ۰
    ف := فشرده سازی.بهترین فشرده سازی(ب.data، ب.len، بهترین)
    سرچاپ بهترین، فشرده سازی.نسبت(ف.len، ب.len) < ۱.۰
    ر := فشرده سازی.فشرده سازی رشته(فشرده سازی.روش دیفلیت، "aaaaaaaaaa")
    ب۳ := فشرده سازی.کدگشایی(فشرده سازی.روش دیفلیت، ر.data، ر.len)
    سرچاپ فشرده سازی.بافر به رشته(ب۳)
    ب۴ := فشرده سازی.فشرده سازی(فشرده سازی.روش آر ال ای، ب.data، ب.len)
    سرچاپ فشرده سازی.طول بافر(ب۴) > ۰، فشرده سازی.روش.هافمن
    سرچاپ فشرده سازی.طول بافر(فشرده سازی.کدگشایی طول اجرا(فشرده سازی.فشرده سازی طول اجرا(ب.data، ب.len).data، فشرده سازی.فشرده سازی طول اجرا(ب.data، ب.len).len)) == ب.len
    ه := فشرده سازی.فشرده سازی هافمن(ب.data، ب.len)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی هافمن(ه.data، ه.len)، ب)
    ل := فشرده سازی.فشرده سازی الزد۷۷(ب.data، ب.len)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی الزد۷۷(ل.data، ل.len)، ب)
    و۲ := فشرده سازی.فشرده سازی ال زد دبلیو(ب.data، ب.len)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی ال زد دبلیو(و۲.data، و۲.len)، ب)
    ب۵ := فشرده سازی.فشرده سازی باروز ویلر(ب.data، ب.len)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی باروز ویلر(ب۵.data، ب۵.len)، ب)
    ناپایا اصلی := ۰
    ت := فشرده سازی.تبدیل باروز ویلر(ب.data، ۶، اصلی)
    سرچاپ اصلی، فشرده سازی.بافر به رشته(فشرده سازی.معکوس باروز ویلر(ت.data، ت.len، اصلی)) == "آبآ"
    م := فشرده سازی.کدگذاری انتقال به جلو(ب)
    سرچاپ فشرده سازی.برابری بافر(فشرده سازی.کدگشایی انتقال به جلو(م)، ب)
پایان
