واردسازی فشرده سازی
واردسازی حافظه

تابع ریشه:
    متن := "stream me, stream me, stream me. " * 100
    بسته_شده := فشرده سازی.دیفلیت خام(متن برگردان تهی*، متن.طول())

    ناپایا مقصد_جریان := فشرده سازی.بازکردن مقصد("packed.bin"، 0 برگردان صحیح۶۴)
    سرچاپ فشرده سازی.نوشتن در مقصد(مقصد_جریان، بسته_شده.داده، بسته_شده.طول)، مقصد_جریان.نوشته شده برابر (بسته_شده.طول برگردان صحیح۶۴)، مقصد_جریان.ناموفق
    سرچاپ فشرده سازی.بستن مقصد(مقصد_جریان)، مقصد_جریان.پرونده برابر پوچ

    پرونده_باز := فشرده سازی.بازکردن پرونده برای خواندن("packed.bin")
    اندازه := فشرده سازی.اندازه پرونده(پرونده_باز)
    سرچاپ اندازه برابر (بسته_شده.طول برگردان صحیح۶۴)
    سر := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    گرفته := فشرده سازی.خواندن از جایگاه پرونده(پرونده_باز، 0 برگردان صحیح۶۴، سر، 4)
    سرچاپ گرفته، فشرده سازی.جابجایی در پرونده(پرونده_باز، 0 برگردان صحیح۶۴)
    حافظه.آزادسازی(سر)

    ناپایا متغیر_reader := فشرده سازی.خواننده بیت از پرونده(پرونده_باز، 0 برگردان صحیح۶۴، اندازه)
    سرچاپ متغیر_reader.پرونده برابر پرونده_باز، متغیر_reader.باقی مانده برابر اندازه
    ناپایا خروجی_مقدار := فشرده سازی.بازکردن مقصد("text.txt"، 0 برگردان صحیح۶۴)
    موفق := فشرده سازی.کدگشایی دیفلیت خام به مقصد(متغیر_reader، خروجی_مقدار، نادرست)
    فشرده سازی.آزادسازی خواننده بیت پرونده(متغیر_reader)
    سرچاپ موفق، فشرده سازی.بستن مقصد(خروجی_مقدار)، خروجی_مقدار.نوشته شده برابر (متن.طول() برگردان صحیح۶۴)، خروجی_مقدار.چک جمع برابر فشرده سازی.چک جمع سی آر سی رشته(متن)

    ناپایا کوچک := فشرده سازی.بازکردن مقصد("small.txt"، 100 برگردان صحیح۶۴)
    ناپایا دوباره := فشرده سازی.خواننده بیت از پرونده(پرونده_باز، 0 برگردان صحیح۶۴، اندازه)
    سرچاپ فشرده سازی.کدگشایی دیفلیت خام به مقصد(دوباره، کوچک، نادرست)، کوچک.فراتر از سقف، کوچک.سقف
    فشرده سازی.آزادسازی خواننده بیت پرونده(دوباره)
    فشرده سازی.بستن مقصد(کوچک)

    ناپایا بخش := فشرده سازی.بازکردن مقصد("part.bin"، 0 برگردان صحیح۶۴)
    سرچاپ فشرده سازی.رونوشت از پرونده به مقصد(بخش، پرونده_باز، 2 برگردان صحیح۶۴، 10 برگردان صحیح۶۴)، بخش.نوشته شده
    فشرده سازی.بستن مقصد(بخش)
    فشرده سازی.بستن پرونده(پرونده_باز)

    نخست := "hello, "
    دومی := "world"
    درحال_اجرا := فشرده سازی.به‌روزرسانی چک جمع سی آر سی(فشرده سازی.به‌روزرسانی چک جمع سی آر سی(0 برگردان طبیعی۳۲، نخست برگردان تهی*، نخست.طول())، دومی برگردان تهی*، دومی.طول())
    سرچاپ درحال_اجرا برابر فشرده سازی.چک جمع سی آر سی رشته(نخست + دومی)

    متغیر_gen := (off: صحیح۶۴، dst: تهی*، n: صحیح، _c: تهی*):
        ویژگی_محلی := dst برگردان طبیعی۸*
        تکرار n در شمارنده۳:
            ویژگی_محلی[شمارنده۳] = ((off + (شمارنده۳ برگردان صحیح۶۴)) & (255 برگردان صحیح۶۴)) برگردان طبیعی۸
        پایان
        برگشت n
    پایان
    متغیر_marker := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    متغیر_cfp := فشرده سازی.بازکردن خواندن تابعی(1000 برگردان صحیح۶۴، متغیر_gen، متغیر_marker)
    سرچاپ فشرده سازی.اندازه پرونده(متغیر_cfp)، فشرده سازی.بافت خواندن تابعی(متغیر_cfp) برابر متغیر_marker
    متغیر_probe := حافظه.تخصیص(4 برگردان طبیعی۶۴)
    سرچاپ فشرده سازی.خواندن از جایگاه پرونده(متغیر_cfp، 258 برگردان صحیح۶۴، متغیر_probe، 4)، (متغیر_probe برگردان طبیعی۸*)[0]، (متغیر_probe برگردان طبیعی۸*)[3]
    فشرده سازی.بستن پرونده(متغیر_cfp)
    حافظه.آزادسازی(متغیر_probe)
    حافظه.آزادسازی(متغیر_marker)

    متغیر_call := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴) برگردان طبیعی۸*
    متغیر_call[0] = 0xE8 برگردان طبیعی۸
    متغیر_call[2] = 1 برگردان طبیعی۸
    ناپایا متغیر_mask := 0
    انجام := فشرده سازی.گام فیلتر شاخه(فشرده سازی.فیلتر ایکس۸۶، متغیر_call برگردان تهی*، 16، 0 برگردان صحیح۶۴، متغیر_mask)
    سرچاپ انجام، متغیر_call[1] برگردان صحیح، متغیر_call[2] برگردان صحیح، متغیر_call[3] برگردان صحیح، متغیر_call[4] برگردان صحیح، متغیر_mask
    حافظه.آزادسازی(متغیر_call برگردان تهی*)

    متغیر_wf := فشرده سازی.بازکردن پرونده برای نوشتن("empty.bin")
    سرچاپ فشرده سازی.اندازه پرونده(متغیر_wf)
    فشرده سازی.بستن پرونده(متغیر_wf)
    سرچاپ فشرده سازی.بازکردن پرونده برای خواندن("no-such-file.bin") برابر پوچ
پایان
