// زبان: فارسی
واردسازی فشرده سازی

تابع name(متغیر_why: صحیح): رشته:
    اگر متغیر_why برابر فشرده سازی.کدگشایی موفق: برگشت "ok" پایان
    اگر متغیر_why برابر فشرده سازی.کدگشایی بزرگ: برگشت "too big" پایان
    برگشت "corrupt"
پایان

تابع ریشه:
    خام := فشرده سازی.بافر از رشته("abcabcabcabcabcabcabcabcabcabcabcabc")
    متغیر_gz := فشرده سازی.فشرده سازی جی زیپ(خام.داده، خام.طول)
    ایکس_زد := فشرده سازی.فشرده سازی ایکس زد(خام.داده، خام.طول)
    متغیر_bz := فشرده سازی.فشرده سازی بی زیپ دو(خام.داده، خام.طول)
    الزد := فشرده سازی.فشرده سازی الزد ام ای(خام.داده، خام.طول)
    ناپایا متغیر_why := 0
    _ := فشرده سازی.کدگشایی جی زیپ با علت(متغیر_gz.داده، متغیر_gz.طول، 10، متغیر_why)
    سرچاپ "gzip"، name(متغیر_why)
    _ := فشرده سازی.کدگشایی ایکس زد با علت(ایکس_زد.داده، ایکس_زد.طول، 10، متغیر_why)
    سرچاپ "xz"، name(متغیر_why)
    _ := فشرده سازی.کدگشایی بی زیپ دو با علت(متغیر_bz.داده، متغیر_bz.طول، 10، متغیر_why)
    سرچاپ "bzip2"، name(متغیر_why)
    _ := فشرده سازی.کدگشایی الزد ام ای با علت(الزد.داده، الزد.طول، 10، متغیر_why)
    سرچاپ "lzma"، name(متغیر_why)
    بازگشت := فشرده سازی.کدگشایی جی زیپ با علت(متغیر_gz.داده، متغیر_gz.طول، 0، متغیر_why)
    سرچاپ "no limit"، name(متغیر_why)، بازگشت.طول
    _ := فشرده سازی.کدگشایی جی زیپ با علت(متغیر_gz.داده، متغیر_gz.طول - 6، 0، متغیر_why)
    سرچاپ "cut"، name(متغیر_why)
پایان
