// زبان: فارسی
واردسازی فشرده سازی

تابع name(why: صحیح): رشته:
    اگر why برابر فشرده سازی.کدگشایی موفق: برگشت "ok" پایان
    اگر why برابر فشرده سازی.کدگشایی بزرگ: برگشت "too big" پایان
    برگشت "corrupt"
پایان

تابع ریشه:
    raw := فشرده سازی.بافر از رشته("abcabcabcabcabcabcabcabcabcabcabcabc")
    gz := فشرده سازی.فشرده سازی جی زیپ(raw.داده، raw.طول)
    xz := فشرده سازی.فشرده سازی ایکس زد(raw.داده، raw.طول)
    bz := فشرده سازی.فشرده سازی بی زیپ دو(raw.داده، raw.طول)
    lz := فشرده سازی.فشرده سازی الزد ام ای(raw.داده، raw.طول)
    ناپایا why := 0
    _ := فشرده سازی.کدگشایی جی زیپ با علت(gz.داده، gz.طول، 10، why)
    سرچاپ "gzip"، name(why)
    _ := فشرده سازی.کدگشایی ایکس زد با علت(xz.داده، xz.طول، 10، why)
    سرچاپ "xz"، name(why)
    _ := فشرده سازی.کدگشایی بی زیپ دو با علت(bz.داده، bz.طول، 10، why)
    سرچاپ "bzip2"، name(why)
    _ := فشرده سازی.کدگشایی الزد ام ای با علت(lz.داده، lz.طول، 10، why)
    سرچاپ "lzma"، name(why)
    back := فشرده سازی.کدگشایی جی زیپ با علت(gz.داده، gz.طول، 0، why)
    سرچاپ "no limit"، name(why)، back.طول
    _ := فشرده سازی.کدگشایی جی زیپ با علت(gz.داده، gz.طول - 6، 0، why)
    سرچاپ "cut"، name(why)
پایان
