// زبان: فارسی
واردسازی فشرده سازی

پایا XZ := """
fd377a585a000004e6d6b44604c05fcf022101160000000000000000bb0ccf6ce0014e00575d0029984986240afb8a34e4
81db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eba071037cdd425338444ede
4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602aacf40a000005b35fff6fd65c4e300017bcf020000005e9efc
63b1c467fb020000000004595a
"""

پایا LZMA := """
5d00008000ffffffffffffffff0029984986240afb8a34e481db780958f3d0144436dd3bb4ca45234051fa042e5be57640
2f66b72801fb0f3b421e32e3eba071037cdd425338444ede4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602ad
8d68e0bcfed44dc0
"""

تابع nib(نویسه: صحیح): صحیح:
    اگر نویسه بزرگتربرابر 48 و نویسه کوچکتربرابر 57:
        برگشت نویسه - 48
    پایان
    اگر نویسه بزرگتربرابر 97 و نویسه کوچکتربرابر 102:
        برگشت نویسه - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := s برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار s.طول() در شمارنده:
        مقدار_محلی := nib(نشانگر_بایت[شمارنده] برگردان صحیح)
        اگر مقدار_محلی کوچکتر 0:
            گذر
        پایان
        اگر بالا کوچکتر 0:
            بالا = مقدار_محلی
        وگرنه:
            فشرده سازی.افزودن بایت(بافر_محلی، بالا * 16 + مقدار_محلی)
            بالا = -1
        پایان
    پایان
    برگشت بافر_محلی
پایان

تابع ریشه:
    ایکس_زد := unhex(XZ)
    الزد := unhex(LZMA)
    ناپایا موفق := نادرست
    الف := فشرده سازی.کدگشایی ایکس زد(ایکس_زد.داده، ایکس_زد.طول، موفق)
    سرچاپ "ایکس زد:"، موفق، الف.طول
    بافر_محلی := فشرده سازی.کدگشایی ایکس زد بافر(ایکس_زد، موفق)
    سرچاپ "ایکس زد بافر:"، موفق، فشرده سازی.برابری بافر(الف، بافر_محلی)
    نویسه := فشرده سازی.کدگشایی ایکس زد با سقف(ایکس_زد.داده، ایکس_زد.طول، الف.طول، موفق)
    سرچاپ "ایکس زد با سقف:"، موفق، نویسه.طول
    دال := فشرده سازی.کدگشایی ایکس زد با سقف(ایکس_زد.داده، ایکس_زد.طول، الف.طول - 1، موفق)
    سرچاپ "ایکس زد یک بایت بیش از سقف:"، موفق، دال.طول
    عنصر := فشرده سازی.کدگشایی الزد ام ای(الزد.داده، الزد.طول، موفق)
    سرچاپ "الزد ام ای:"، موفق، فشرده سازی.برابری بافر(الف، عنصر)
    پرونده_محلی := فشرده سازی.کدگشایی الزد ام ای بافر(الزد، موفق)
    سرچاپ "الزد ام ای بافر:"، موفق، پرونده_محلی.طول
    جی := فشرده سازی.کدگشایی الزد ام ای با سقف(الزد.داده، الزد.طول، 50، موفق)
    سرچاپ "الزد ام ای با سقف ۵۰:"، موفق، جی.طول
پایان
