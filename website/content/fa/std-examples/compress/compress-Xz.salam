// زبان: فارسی
واردسازی فشرده سازی

پایا XZ := """
fd377a585a000004e6d6b44604c05fcf022101160000000000000000bb0ccf6ce0014e00575d0029984986240afb8a34e4
81db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eba071037cdd425338444ede
4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602aacf40a000005b35fff6fd65c4e300017bcf020000005e9efc
63b1c467fb020000000004595a
"""

پایا LZMA := """
5d00008000ffffffffffffffff0029984986240afb8a34e481db780958f3d0144436dd3bb4ca45234051fa042e5be57640
2f66b72801fb0f3b421e32e3eba071037cdd425338444ede4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602ad
8d68e0bcfed44dc0
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع ریشه:
    xz := unhex(XZ)
    lz := unhex(LZMA)
    ناپایا ok := نادرست
    a := فشرده سازی.کدگشایی ایکس زد(xz.داده، xz.طول، ok)
    سرچاپ "ایکس زد:"، ok، a.طول
    b := فشرده سازی.کدگشایی ایکس زد بافر(xz، ok)
    سرچاپ "ایکس زد بافر:"، ok، فشرده سازی.برابری بافر(a، b)
    c := فشرده سازی.کدگشایی ایکس زد با سقف(xz.داده، xz.طول، a.طول، ok)
    سرچاپ "ایکس زد با سقف:"، ok، c.طول
    d := فشرده سازی.کدگشایی ایکس زد با سقف(xz.داده، xz.طول، a.طول - 1، ok)
    سرچاپ "ایکس زد یک بایت بیش از سقف:"، ok، d.طول
    e := فشرده سازی.کدگشایی الزد ام ای(lz.داده، lz.طول، ok)
    سرچاپ "الزد ام ای:"، ok، فشرده سازی.برابری بافر(a، e)
    f := فشرده سازی.کدگشایی الزد ام ای بافر(lz، ok)
    سرچاپ "الزد ام ای بافر:"، ok، f.طول
    g := فشرده سازی.کدگشایی الزد ام ای با سقف(lz.داده، lz.طول، 50، ok)
    سرچاپ "الزد ام ای با سقف ۵۰:"، ok، g.طول
پایان
