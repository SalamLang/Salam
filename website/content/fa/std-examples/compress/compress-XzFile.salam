// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته

تابع collect(p: تهی*، n: صحیح، c: تهی*): منطقی:
    فشرده سازی.افزودن بایت‌ها((c برگردان فشرده سازی.بافر بایت*)[0]، p، n)
    برگشت درست
پایان

تابع ریشه:
    ناپایا text := فشرده سازی.بافر بایت جدید()
    تکرار 5000 در i:
        line := "line " + رشته.از عدد((i * 7) برگردان صحیح۶۴) + "\n"
        فشرده سازی.افزودن بایت‌ها(text، line برگردان تهی*، line.طول())
    پایان
    ناپایا packed := فشرده سازی.فشرده سازی ایکس زد(text.داده، text.طول)
    بایگانی.نوشتن پرونده دودویی از بافر("xz.tmp"، packed)

    fp := فشرده سازی.بازکردن پرونده برای خواندن("xz.tmp")
    got := حافظه.تخصیص صفرشده(اندازه‌گونه(فشرده سازی.بافر بایت)) برگردان فشرده سازی.بافر بایت*
    got[0] = فشرده سازی.بافر بایت جدید()
    ناپایا sink := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، got برگردان تهی*)
    st := فشرده سازی.کدگشایی ایکس زد از پرونده به مقصد(fp، 0 برگردان صحیح۶۴، فشرده سازی.اندازه پرونده(fp)، sink، 0 برگردان صحیح۶۴)
    سرچاپ st برابر فشرده سازی.کدگشایی موفق، sink.نوشته شده برابر (text.طول برگردان صحیح۶۴)، فشرده سازی.برابری بافر(got[0]، text)
    فشرده سازی.بستن پرونده(fp)

    fp2 := فشرده سازی.بازکردن پرونده برای خواندن("xz.tmp")
    ناپایا small := فشرده سازی.مقصد تابعی(100 برگردان صحیح۶۴، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، got برگردان تهی*)
    سرچاپ فشرده سازی.کدگشایی ایکس زد از پرونده به مقصد(fp2، 0 برگردان صحیح۶۴، فشرده سازی.اندازه پرونده(fp2)، small، 0 برگردان صحیح۶۴) برابر فشرده سازی.کدگشایی بزرگ
    فشرده سازی.بستن پرونده(fp2)
    فشرده سازی.آزادسازی بافر(got[0])
    حافظه.آزادسازی(got برگردان تهی*)
    فشرده سازی.آزادسازی بافر(text)
    فشرده سازی.آزادسازی بافر(packed)
    سیستم عامل.حذف("xz.tmp")
پایان
