// زبان: فارسی
واردسازی بایگانی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی سیستم عامل
واردسازی رشته

تابع collect(p: تهی*، n: صحیح، c: تهی*): منطقی:
    فشرده سازی.افزودن بایت‌ها((c برگردان فشرده سازی.بافر بایت*)[0]، p، n)
    برگشت درست
پایان

تابع ریشه:
    ناپایا متن := فشرده سازی.بافر بایت جدید()
    تکرار 5000 در شمارنده:
        خط := "line " + رشته.از عدد((شمارنده * 7) برگردان صحیح۶۴) + "\n"
        فشرده سازی.افزودن بایت‌ها(متن، خط برگردان تهی*، خط.طول())
    پایان
    ناپایا بسته_شده := فشرده سازی.فشرده سازی ایکس زد(متن.داده، متن.طول)
    بایگانی.نوشتن پرونده دودویی از بافر("xz.tmp"، بسته_شده)

    پرونده_باز := فشرده سازی.بازکردن پرونده برای خواندن("xz.tmp")
    گرفته := حافظه.تخصیص صفرشده(اندازه‌گونه(فشرده سازی.بافر بایت)) برگردان فشرده سازی.بافر بایت*
    گرفته[0] = فشرده سازی.بافر بایت جدید()
    ناپایا مقصد_جریان := فشرده سازی.مقصد تابعی(0 برگردان صحیح۶۴، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، گرفته برگردان تهی*)
    سبک_متن := فشرده سازی.کدگشایی ایکس زد از پرونده به مقصد(پرونده_باز، 0 برگردان صحیح۶۴، فشرده سازی.اندازه پرونده(پرونده_باز)، مقصد_جریان، 0 برگردان صحیح۶۴)
    سرچاپ سبک_متن برابر فشرده سازی.کدگشایی موفق، مقصد_جریان.نوشته شده برابر (متن.طول برگردان صحیح۶۴)، فشرده سازی.برابری بافر(گرفته[0]، متن)
    فشرده سازی.بستن پرونده(پرونده_باز)

    متغیر_fp2 := فشرده سازی.بازکردن پرونده برای خواندن("xz.tmp")
    ناپایا کوچک := فشرده سازی.مقصد تابعی(100 برگردان صحیح۶۴، (p: تهی*، n: صحیح، c: تهی*): برگشت collect(p، n، c) پایان، گرفته برگردان تهی*)
    سرچاپ فشرده سازی.کدگشایی ایکس زد از پرونده به مقصد(متغیر_fp2، 0 برگردان صحیح۶۴، فشرده سازی.اندازه پرونده(متغیر_fp2)، کوچک، 0 برگردان صحیح۶۴) برابر فشرده سازی.کدگشایی بزرگ
    فشرده سازی.بستن پرونده(متغیر_fp2)
    فشرده سازی.آزادسازی بافر(گرفته[0])
    حافظه.آزادسازی(گرفته برگردان تهی*)
    فشرده سازی.آزادسازی بافر(متن)
    فشرده سازی.آزادسازی بافر(بسته_شده)
    سیستم عامل.حذف("xz.tmp")
پایان
