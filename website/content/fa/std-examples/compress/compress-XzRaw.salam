// زبان: فارسی
واردسازی فشرده سازی
واردسازی رشته

پایا RAW_LZMA := """
0029984986240afb8a34e481db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eb
a071037cdd425338444ede4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602ad8d68e0bcfed44dc0
"""

پایا RAW_LZMA2 := """
e0014e00595d0029984986240afb8a34e481db780958f3d0144436994e538c60ac746c02dc278329cadecbb68a986c0818
f3d60fca80edf59196fa1d512909ac7b63cbe3650a7fe9860c6f9bfc85ae148860e1e0b15ff7ea8080b5235108050000
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع show(label: رشته، b: فشرده سازی.بافر بایت):
    ناپایا line := label
    تکرار b.طول در i:
        v := فشرده سازی.دریافت بایت(b، i)
        line += " "
        line += رشته.از عدد(v برگردان صحیح۶۴)
    پایان
    سرچاپ line
پایان

تابع ریشه:
    سرچاپ "سقف واژه‌نامه:"، فشرده سازی.بیشینه اندازه واژه نامه الزد ام ای
    props := unhex("5d00000100")
    raw1 := unhex(RAW_LZMA)
    ناپایا ok := نادرست
    a := فشرده سازی.کدگشایی الزد ام ای خام(props.داده، props.طول، raw1.داده، raw1.طول، 335، 0، ok)
    سرچاپ "الزد ام ای خام:"، ok، a.طول
    raw2 := unhex(RAW_LZMA2)
    b := فشرده سازی.کدگشایی الزد ام ای۲ خام(16، raw2.داده، raw2.طول، 335، 0، ok)
    سرچاپ "الزد ام ای۲ خام:"، ok، فشرده سازی.برابری بافر(a، b)
    c := فشرده سازی.کدگشایی الزد ام ای۲ خام(16، raw2.داده، raw2.طول، 100، 0، ok)
    سرچاپ "الزد ام ای۲ خام، اندازه نادرست:"، ok، c.طول

    call := unhex("e810000000909090")
    show("پیش"، call)
    سرچاپ فشرده سازی.کدگشایی فیلتر شاخه(فشرده سازی.فیلتر ایکس۸۶، call.داده، call.طول، 0)
    show("ایکس۸۶"، call)

    steps := unhex("01010101")
    سرچاپ فشرده سازی.کدگشایی فیلتر دلتا(steps.داده، steps.طول، 1)
    show("دلتا"، steps)
    سرچاپ فشرده سازی.کدگشایی فیلتر شاخه(99، steps.داده، steps.طول، 0)، فشرده سازی.کدگشایی فیلتر دلتا(steps.داده، steps.طول، 0)
پایان
