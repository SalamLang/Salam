// زبان: فارسی
واردسازی فشرده سازی
واردسازی رشته

پایا RAW_LZMA := """
0029984986240afb8a34e481db780958f3d0144436dd3bb4ca45234051fa042e5be576402f66b72801fb0f3b421e32e3eb
a071037cdd425338444ede4cb8c8c742828bc92c1b53df8ea763015d902c3d49f9c602ad8d68e0bcfed44dc0
"""

پایا RAW_LZMA2 := """
e0014e00595d0029984986240afb8a34e481db780958f3d0144436994e538c60ac746c02dc278329cadecbb68a986c0818
f3d60fca80edf59196fa1d512909ac7b63cbe3650a7fe9860c6f9bfc85ae148860e1e0b15ff7ea8080b5235108050000
"""

تابع nib(نویسه: صحیح): صحیح:
    اگر نویسه بزرگتربرابر 48 و نویسه کوچکتربرابر 57:
        برگشت نویسه - 48
    پایان
    اگر نویسه بزرگتربرابر 97 و نویسه کوچکتربرابر 102:
        برگشت نویسه - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := s برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار s.طول() در شمارنده:
        مقدار_محلی := nib(نشانگر_بایت[شمارنده] برگردان صحیح)
        اگر مقدار_محلی کوچکتر 0:
            گذر
        پایان
        اگر بالا کوچکتر 0:
            بالا = مقدار_محلی
        وگرنه:
            فشرده سازی.افزودن بایت(بافر_محلی، بالا * 16 + مقدار_محلی)
            بالا = -1
        پایان
    پایان
    برگشت بافر_محلی
پایان

تابع show(label: رشته، بافر_محلی: فشرده سازی.بافر بایت):
    ناپایا خط := label
    تکرار بافر_محلی.طول در شمارنده:
        مقدار_محلی := فشرده سازی.دریافت بایت(بافر_محلی، شمارنده)
        خط += " "
        خط += رشته.از عدد(مقدار_محلی برگردان صحیح۶۴)
    پایان
    سرچاپ خط
پایان

تابع ریشه:
    سرچاپ "سقف واژه‌نامه:"، فشرده سازی.بیشینه اندازه واژه نامه الزد ام ای
    متغیر_props := unhex("5d00000100")
    متغیر_raw1 := unhex(RAW_LZMA)
    ناپایا موفق := نادرست
    الف := فشرده سازی.کدگشایی الزد ام ای خام(متغیر_props.داده، متغیر_props.طول، متغیر_raw1.داده، متغیر_raw1.طول، 335، 0، موفق)
    سرچاپ "الزد ام ای خام:"، موفق، الف.طول
    متغیر_raw2 := unhex(RAW_LZMA2)
    بافر_محلی := فشرده سازی.کدگشایی الزد ام ای۲ خام(16، متغیر_raw2.داده، متغیر_raw2.طول، 335، 0، موفق)
    سرچاپ "الزد ام ای۲ خام:"، موفق، فشرده سازی.برابری بافر(الف، بافر_محلی)
    نویسه := فشرده سازی.کدگشایی الزد ام ای۲ خام(16، متغیر_raw2.داده، متغیر_raw2.طول، 100، 0، موفق)
    سرچاپ "الزد ام ای۲ خام، اندازه نادرست:"، موفق، نویسه.طول

    متغیر_call := unhex("e810000000909090")
    show("پیش"، متغیر_call)
    سرچاپ فشرده سازی.کدگشایی فیلتر شاخه(فشرده سازی.فیلتر ایکس۸۶، متغیر_call.داده، متغیر_call.طول، 0)
    show("ایکس۸۶"، متغیر_call)

    متغیر_steps := unhex("01010101")
    سرچاپ فشرده سازی.کدگشایی فیلتر دلتا(متغیر_steps.داده، متغیر_steps.طول، 1)
    show("دلتا"، متغیر_steps)
    سرچاپ فشرده سازی.کدگشایی فیلتر شاخه(99، متغیر_steps.داده، متغیر_steps.طول، 0)، فشرده سازی.کدگشایی فیلتر دلتا(متغیر_steps.داده، متغیر_steps.طول، 0)
پایان
