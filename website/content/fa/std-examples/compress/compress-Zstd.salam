// زبان: فارسی
واردسازی فشرده سازی
واردسازی رشته

تابع ریشه:
    ناپایا متن := فشرده سازی.بافر بایت جدید()
    تکرار 60 در شمارنده:
        خط := "ورودی " + رشته.از عدد(شمارنده * 37 % 101) + ": سلام قاب زستد می‌نویسد\n"
        فشرده سازی.افزودن بایت‌ها(متن، خط برگردان تهی*، خط.طول())
    پایان
    بسته_شده := فشرده سازی.فشرده سازی زستد(متن.داده، متن.طول)
    سرچاپ "سطح پیش‌فرض:"، بسته_شده.طول، "بایت از"، متن.طول
    سرچاپ "زستد است:"، فشرده سازی.زستد است(بسته_شده.داده، بسته_شده.طول)، فشرده سازی.زستد است بافر(بسته_شده)، فشرده سازی.زستد است(متن.داده، متن.طول)
    سرچاپ "اندازه در سرآیند:"، فشرده سازی.اندازه محتوای زستد(بسته_شده.داده، بسته_شده.طول)

    ناپایا موفق := نادرست
    بازگشت := فشرده سازی.کدگشایی زستد(بسته_شده.داده، بسته_شده.طول، موفق)
    سرچاپ "کدگشایی:"، موفق، فشرده سازی.برابری بافر(بازگشت، متن)
    متغیر_back2 := فشرده سازی.کدگشایی زستد بافر(بسته_شده، موفق)
    سرچاپ "شکل بافر:"، موفق، متغیر_back2.طول

    سریع := فشرده سازی.فشرده سازی زستد با سطح(متن.داده، متن.طول، 1)
    بهترین := فشرده سازی.فشرده سازی زستد با سطح(متن.داده، متن.طول، 19)
    متغیر_stored := فشرده سازی.فشرده سازی زستد با سطح(متن.داده، متن.طول، 0)
    سرچاپ "سطح ۱ و ۱۹ کوچکتر از ذخیره‌ی خام:"، سریع.طول کوچکتر متغیر_stored.طول، بهترین.طول کوچکتر متغیر_stored.طول
    سرچاپ "ذخیره‌ی خام اضافه می‌کند"، متغیر_stored.طول - متن.طول، "بایت قاب‌بندی"
    ساده := فشرده سازی.فشرده سازی زستد با گزینه(متن.داده، متن.طول، 3، نادرست)
    سرچاپ "بدون چک جمع"، بسته_شده.طول - ساده.طول، "بایت کمتر"
    متغیر_fromstr := فشرده سازی.فشرده سازی زستد رشته("hello hello hello hello")
    متغیر_fromstr_buf := فشرده سازی.فشرده سازی زستد بافر(متن)
    سرچاپ "شکل رشته و بافر:"، متغیر_fromstr.طول، متغیر_fromstr_buf.طول

    ناپایا وضعیت := 0
    سقف_دار := فشرده سازی.کدگشایی زستد با جزئیات(بسته_شده.داده، بسته_شده.طول، 100، پوچ، 0، وضعیت)
    سرچاپ "سقف ۱۰۰:"، وضعیت، فشرده سازی.متن وضعیت زستد(وضعیت)، سقف_دار.طول
    متغیر_limit := فشرده سازی.کدگشایی زستد با سقف(بسته_شده.داده، بسته_شده.طول، متن.طول، موفق)
    سرچاپ "سقف برابر با اندازه:"، موفق، متغیر_limit.طول
    بد := فشرده سازی.بافر از رشته("not a zstd stream")
    متغیر_nope := فشرده سازی.کدگشایی زستد با جزئیات(بد.داده، بد.طول، 0، پوچ، 0، وضعیت)
    سرچاپ "داده نامعتبر:"، وضعیت، فشرده سازی.متن وضعیت زستد(وضعیت)، متغیر_nope.طول
    سرچاپ "کدها:"، فشرده سازی.زستد موفق، فشرده سازی.زستد خطای قالب، فشرده سازی.زستد خطای ناقص، فشرده سازی.زستد خطای خراب، فشرده سازی.زستد خطای چک جمع، فشرده سازی.زستد خطای بزرگ، فشرده سازی.زستد خطای واژه نامه
پایان
