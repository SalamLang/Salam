// زبان: فارسی
واردسازی فشرده سازی
واردسازی رشته

تابع ریشه:
    ناپایا text := فشرده سازی.بافر بایت جدید()
    تکرار 60 در i:
        line := "ورودی " + رشته.از عدد(i * 37 % 101) + ": سلام قاب زستد می‌نویسد\n"
        فشرده سازی.افزودن بایت‌ها(text، line برگردان تهی*، line.طول())
    پایان
    packed := فشرده سازی.فشرده سازی زستد(text.داده، text.طول)
    سرچاپ "سطح پیش‌فرض:"، packed.طول، "بایت از"، text.طول
    سرچاپ "زستد است:"، فشرده سازی.زستد است(packed.داده، packed.طول)، فشرده سازی.زستد است بافر(packed)، فشرده سازی.زستد است(text.داده، text.طول)
    سرچاپ "اندازه در سرآیند:"، فشرده سازی.اندازه محتوای زستد(packed.داده، packed.طول)

    ناپایا ok := نادرست
    back := فشرده سازی.کدگشایی زستد(packed.داده، packed.طول، ok)
    سرچاپ "کدگشایی:"، ok، فشرده سازی.برابری بافر(back، text)
    back2 := فشرده سازی.کدگشایی زستد بافر(packed، ok)
    سرچاپ "شکل بافر:"، ok، back2.طول

    fast := فشرده سازی.فشرده سازی زستد با سطح(text.داده، text.طول، 1)
    best := فشرده سازی.فشرده سازی زستد با سطح(text.داده، text.طول، 19)
    stored := فشرده سازی.فشرده سازی زستد با سطح(text.داده، text.طول، 0)
    سرچاپ "سطح ۱ و ۱۹ کوچکتر از ذخیره‌ی خام:"، fast.طول کوچکتر stored.طول، best.طول کوچکتر stored.طول
    سرچاپ "ذخیره‌ی خام اضافه می‌کند"، stored.طول - text.طول، "بایت قاب‌بندی"
    plain := فشرده سازی.فشرده سازی زستد با گزینه(text.داده، text.طول، 3، نادرست)
    سرچاپ "بدون چک جمع"، packed.طول - plain.طول، "بایت کمتر"
    fromstr := فشرده سازی.فشرده سازی زستد رشته("hello hello hello hello")
    fromstr_buf := فشرده سازی.فشرده سازی زستد بافر(text)
    سرچاپ "شکل رشته و بافر:"، fromstr.طول، fromstr_buf.طول

    ناپایا status := 0
    capped := فشرده سازی.کدگشایی زستد با جزئیات(packed.داده، packed.طول، 100، پوچ، 0، status)
    سرچاپ "سقف ۱۰۰:"، status، فشرده سازی.متن وضعیت زستد(status)، capped.طول
    limit := فشرده سازی.کدگشایی زستد با سقف(packed.داده، packed.طول، text.طول، ok)
    سرچاپ "سقف برابر با اندازه:"، ok، limit.طول
    bad := فشرده سازی.بافر از رشته("not a zstd stream")
    nope := فشرده سازی.کدگشایی زستد با جزئیات(bad.داده، bad.طول، 0، پوچ، 0، status)
    سرچاپ "داده نامعتبر:"، status، فشرده سازی.متن وضعیت زستد(status)، nope.طول
    سرچاپ "کدها:"، فشرده سازی.زستد موفق، فشرده سازی.زستد خطای قالب، فشرده سازی.زستد خطای ناقص، فشرده سازی.زستد خطای خراب، فشرده سازی.زستد خطای چک جمع، فشرده سازی.زستد خطای بزرگ، فشرده سازی.زستد خطای واژه نامه
پایان
