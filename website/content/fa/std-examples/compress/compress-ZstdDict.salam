// زبان: فارسی
واردسازی فشرده سازی

پایا FRAME := """
28b52ffd645900ed010092430c11a0ed7425bfff01a825dda80e11a94a1c014020bd51a7cf6fcc41d92e1f9a01043a9c
4edf68a4ea1867b8bed41b6e2a240200f7874039c1d515ee20b3a1
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا b := فشرده سازی.بافر بایت جدید()
    bp := s برگردان طبیعی۸*
    ناپایا hi := -1
    تکرار s.طول() در i:
        v := nib(bp[i] برگردان صحیح)
        اگر v کوچکتر 0:
            گذر
        پایان
        اگر hi کوچکتر 0:
            hi = v
        وگرنه:
            فشرده سازی.افزودن بایت(b، hi * 16 + v)
            hi = -1
        پایان
    پایان
    برگشت b
پایان

تابع ریشه:
    frame := unhex(FRAME)
    dict := فشرده سازی.بافر از رشته("Salam is a programming language. ")
    ناپایا status := 0
    without := فشرده سازی.کدگشایی زستد با جزئیات(frame.داده، frame.طول، 0، پوچ، 0، status)
    سرچاپ "بدون واژه‌نامه:"، status، فشرده سازی.متن وضعیت زستد(status)، without.طول
    ناپایا ok := نادرست
    text := فشرده سازی.کدگشایی زستد با واژه نامه(frame.داده، frame.طول، dict.داده، dict.طول، ok)
    سرچاپ "با واژه‌نامه:"، ok، text.طول، "بایت از"، frame.طول
    سرچاپ فشرده سازی.بافر به رشته(text)
    other := فشرده سازی.بافر از رشته("some other bytes")
    wrong := فشرده سازی.کدگشایی زستد با جزئیات(frame.داده، frame.طول، 0، other.داده، other.طول، status)
    سرچاپ "با واژه‌نامه دیگر:"، status، wrong.طول
پایان
