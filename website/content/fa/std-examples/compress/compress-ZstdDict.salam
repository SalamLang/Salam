// زبان: فارسی
واردسازی فشرده سازی

پایا FRAME := """
28b52ffd645900ed010092430c11a0ed7425bfff01a825dda80e11a94a1c014020bd51a7cf6fcc41d92e1f9a01043a9c
4edf68a4ea1867b8bed41b6e2a240200f7874039c1d515ee20b3a1
"""

تابع nib(c: صحیح): صحیح:
    اگر c بزرگتربرابر 48 و c کوچکتربرابر 57:
        برگشت c - 48
    پایان
    اگر c بزرگتربرابر 97 و c کوچکتربرابر 102:
        برگشت c - 87
    پایان
    برگشت -1
پایان

تابع unhex(s: رشته): فشرده سازی.بافر بایت:
    ناپایا بافر_محلی := فشرده سازی.بافر بایت جدید()
    نشانگر_بایت := s برگردان طبیعی۸*
    ناپایا بالا := -1
    تکرار s.طول() در شمارنده:
        مقدار_محلی := nib(نشانگر_بایت[شمارنده] برگردان صحیح)
        اگر مقدار_محلی کوچکتر 0:
            گذر
        پایان
        اگر بالا کوچکتر 0:
            بالا = مقدار_محلی
        وگرنه:
            فشرده سازی.افزودن بایت(بافر_محلی، بالا * 16 + مقدار_محلی)
            بالا = -1
        پایان
    پایان
    برگشت بافر_محلی
پایان

تابع ریشه:
    متغیر_frame := unhex(FRAME)
    متغیر_dict := فشرده سازی.بافر از رشته("Salam is a programming language. ")
    ناپایا وضعیت := 0
    متغیر_without := فشرده سازی.کدگشایی زستد با جزئیات(متغیر_frame.داده، متغیر_frame.طول، 0، پوچ، 0، وضعیت)
    سرچاپ "بدون واژه‌نامه:"، وضعیت، فشرده سازی.متن وضعیت زستد(وضعیت)، متغیر_without.طول
    ناپایا موفق := نادرست
    متن := فشرده سازی.کدگشایی زستد با واژه نامه(متغیر_frame.داده، متغیر_frame.طول، متغیر_dict.داده، متغیر_dict.طول، موفق)
    سرچاپ "با واژه‌نامه:"، موفق، متن.طول، "بایت از"، متغیر_frame.طول
    سرچاپ فشرده سازی.بافر به رشته(متن)
    دیگر := فشرده سازی.بافر از رشته("some other bytes")
    نادرست := فشرده سازی.کدگشایی زستد با جزئیات(متغیر_frame.داده، متغیر_frame.طول، 0، دیگر.داده، دیگر.طول، وضعیت)
    سرچاپ "با واژه‌نامه دیگر:"، وضعیت، نادرست.طول
پایان
