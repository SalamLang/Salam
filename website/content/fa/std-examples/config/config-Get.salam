واردسازی پیکربندی

تابع ریشه:
    ناپایا پ := پیکربندی.جدید()
    دیرکن پیکربندی.آزادسازی(پ)
    پیکربندی.تنظیم(پ، "name"، "سلام")
    پیکربندی.تنظیم(پ، "port"، "8080")
    پیکربندی.تنظیم(پ، "debug"، "yes")
    پیکربندی.تنظیم(پ، "ratio"، "0.5")
    سرچاپ پیکربندی.طول(پ)، پیکربندی.دارد(پ، "port")، پیکربندی.دریافت(پ، "name")
    سرچاپ پیکربندی.دریافت صحیح(پ، "port"، ۸۰)، پیکربندی.دریافت اعشاری(پ، "ratio"، ۱.۰)، پیکربندی.دریافت منطقی(پ، "debug"، نادرست)
    سرچاپ پیکربندی.دریافت با پیش فرض(پ، "host"، "localhost")
    سرچاپ پیکربندی.حذف(پ، "ratio")، پیکربندی.کلیدها(پ)
پایان
