واردسازی پیکربندی
واردسازی ورودی خروجی

تابع ریشه:
    ناپایا پایه := پیکربندی.تجزیه محیط("MODE=dev\nPORT=3000\n")
    ناپایا رو := پیکربندی.تجزیه محیط("PORT=80\nLOG=info\n")
    دیرکن پیکربندی.آزادسازی(پایه)
    دیرکن پیکربندی.آزادسازی(رو)
    ناپایا ادغام := پیکربندی.ادغام(پایه، رو)
    دیرکن پیکربندی.آزادسازی(ادغام)
    چاپ پیکربندی.قالب محیط(ادغام)
    چاپ پیکربندی.قالب محیط صادراتی(رو)
    ورودی خروجی.نوشتن پرونده(".env"، "TOKEN=abc\n")
    ناپایا ف := پیکربندی.بارگذاری محیط(".env")
    دیرکن پیکربندی.آزادسازی(ف)
    سرچاپ پیکربندی.دریافت(ف، "TOKEN")
پایان
