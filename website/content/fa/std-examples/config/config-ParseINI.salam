واردسازی پیکربندی
واردسازی ورودی خروجی

تابع ریشه:
    متن := "name = سلام\n\n[db]\nhost = localhost\nport = 5432\n"
    ناپایا پ := پیکربندی.تجزیه آی ان آی(متن)
    دیرکن پیکربندی.آزادسازی(پ)
    سرچاپ پیکربندی.کلیدها(پ)
    ناپایا ب := پیکربندی.بخش(پ، "db")
    دیرکن پیکربندی.آزادسازی(ب)
    سرچاپ پیکربندی.دریافت(ب، "port")
    چاپ پیکربندی.قالب آی ان آی(ب)
    ورودی خروجی.نوشتن پرونده("app.ini"، متن)
    ناپایا خوانده := پیکربندی.بارگذاری آی ان آی("app.ini")
    دیرکن پیکربندی.آزادسازی(خوانده)
    سرچاپ پیکربندی.دریافت(خوانده، "db.host")
پایان
