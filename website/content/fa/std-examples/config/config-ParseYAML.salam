واردسازی ورودی خروجی

روال ریشه:
    متن := "app:\n  name: salam\n  port: 8080\nlog: info\n"
    ناپایا پ := پیکربندی.تجزیه یامل(متن)
    دیرکن پیکربندی.آزادسازی(پ)
    سرچاپ پیکربندی.کلیدها(پ)، پیکربندی.دریافت صحیح(پ، "app.port"، ۰)
    ورودی خروجی.نوشتن پرونده("app.yaml"، متن)
    ناپایا ف := پیکربندی.بارگذاری یامل("app.yaml")
    دیرکن پیکربندی.آزادسازی(ف)
    سرچاپ پیکربندی.دریافت(ف، "log")
