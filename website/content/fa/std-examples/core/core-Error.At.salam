تابع رقم(متن: رشته، جا: صحیح): صحیح خطادار:
    ک := متن.زیررشته(جا، ۱)
    اگر ک < "0" یا ک > "9":
        پرتاب خطا خطا.در جایگاه(نوع خطا.نحو، "رقم انتظار می‌رفت"، جا)
    پایان
    برگشت ک.به صحیح()
پایان

تابع ریشه:
    متن := "12x4"
    تکرار متن.طول() در ن:
        تلاش:
            سرچاپ "رقم"، رقم(متن، ن)
        گرفتن خطا خ:
            سرچاپ خ.به رشته()
            سرچاپ "جایگاه"، خ.جایگاه
        پایان
    پایان
پایان
