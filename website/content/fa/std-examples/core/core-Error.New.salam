تابع یافتن کاربر(شناسه: صحیح): رشته خطادار:
    اگر شناسه != ۱:
        پرتاب خطا خطا.جدید(نوع خطا.یافت نشد، "کاربری با شناسه‌ی " + شناسه + " نیست")
    پایان
    برگشت "سارا"
پایان

تابع ریشه:
    هر شناسه در [۱، ۷]:
        تلاش:
            سرچاپ "پیدا شد"، یافتن کاربر(شناسه)
        گرفتن خطا خ:
            سرچاپ خ.نام نوع() + ":"، خ.پیام
        پایان
    پایان
پایان
