تابع خواندن یادداشت(نام: رشته): رشته خطادار:
    اگر نام == "":
        پرتاب خطا خطا.جدید(نوع خطا.آرگومان نامعتبر، "نام خالی است")
    پایان
    اگر نام != "notes.txt":
        پرتاب خطا خطا.جدید(نوع خطا.یافت نشد، نام + " وجود ندارد")
    پایان
    برگشت "محتوای " + نام
پایان

تابع ریشه:
    هر نام در ["notes.txt"، "todo.txt"، ""]:
        تلاش:
            سرچاپ خواندن یادداشت(نام)
        گرفتن خطا خ:
            اگر خ.است(نوع خطا.یافت نشد):
                سرچاپ "اول بسازیدش:"، خ.پیام
            وگرنه:
                سرچاپ "نمی‌شود ادامه داد:"، خ.پیام
            پایان
        پایان
    پایان
پایان
