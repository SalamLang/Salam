تابع سن خوانی(متن: رشته): صحیح خطادار:
    اگر متن == "":
        پرتاب خطا خطا.جدید(نوع خطا.کلید ناموجود، "سن داده نشده است")
    پایان
    ن := متن.به صحیح()
    اگر ن < ۰ یا ن > ۱۵۰:
        پرتاب خطا خطا.جدید(نوع خطا.خارج از بازه، "سن " + ن + " خارج از بازه است").با کد("age.range")
    پایان
    برگشت ن
پایان

تابع ریشه:
    هر متن در ["42"، ""، "200"]:
        تلاش:
            سرچاپ "سن"، سن خوانی(متن)
        گرفتن خطا خ:
            سرچاپ خ.نام نوع() + ":"، خ.پیام
            سرچاپ "  کد:"، خ.کد، "| خارج از بازه:"، خ.است(نوع خطا.خارج از بازه)
        پایان
    پایان
    خ := خطا.در جایگاه(نوع خطا.نحو، "رقم انتظار می‌رفت"، ۴).با مسیر("$.age")
    سرچاپ خ.به رشته()
    جادار := خ.با موقعیت(۴، ۲، ۳).بپیچ("خواندن فرم")
    سرچاپ جادار.به رشته()
    سرچاپ جادار.جایگاه، جادار.خط، جادار.ستون، جادار.زمینه
پایان
