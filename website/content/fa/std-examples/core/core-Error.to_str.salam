تابع ریشه:
    ساده := خطا.جدید(نوع خطا.اتمام زمان، "سرور پاسخ نداد")
    سرچاپ ساده.به رشته()
    خالی := خطا.جدید(نوع خطا.یافت نشد، "")
    سرچاپ خالی.به رشته()
    جایی := خطا.جدید(نوع خطا.نحو، "ویرگول جا افتاده").با مسیر("$.items[2]").با موقعیت(۴۰، ۳، ۹)
    سرچاپ جایی.به رشته()
    پیچیده := جایی.بپیچ("خواندن سفارش").بپیچ("رسیدگی به درخواست")
    سرچاپ پیچیده.به رشته()
