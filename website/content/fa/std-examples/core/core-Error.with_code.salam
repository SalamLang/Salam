تابع سن خوانی(متن: رشته): صحیح خطادار:
    ن := متن.به صحیح()
    اگر ن < ۰ یا ن > ۱۵۰:
        پرتاب خطا خطا.جدید(نوع خطا.خارج از بازه، "سن " + ن + " خارج از بازه است").با کد("age.range")
    پایان
    برگشت ن
پایان

تابع ریشه:
    هر متن در ["30"، "200"]:
        تلاش:
            سرچاپ "سن"، سن خوانی(متن)
        گرفتن خطا خ:
            اگر خ.کد == "age.range":
                سرچاپ "دوباره بپرسید:"، خ.پیام
            پایان
            سرچاپ "کد:"، خ.کد
        پایان
    پایان
پایان
