تابع بررسی(کاربر: رشته، سن: صحیح): صحیح خطادار:
    اگر سن < ۱۸:
        پرتاب خطا خطا.جدید(نوع خطا.خارج از بازه، "باید دست‌کم ۱۸ باشد").با مسیر("$.users[" + کاربر + "].age")
    پایان
    برگشت سن
پایان

تابع ریشه:
    تلاش:
        سرچاپ بررسی("sara"، ۳۱)
        سرچاپ بررسی("omid"، ۱۲)
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
        سرچاپ "کجا:"، خ.مسیر
    پایان
پایان
