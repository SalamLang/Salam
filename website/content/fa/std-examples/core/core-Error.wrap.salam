تابع خواندن درگاه(متن: رشته): صحیح خطادار:
    ن := متن.به صحیح()
    اگر ن < ۱ یا ن > ۶۵۵۳۵:
        پرتاب خطا خطا.جدید(نوع خطا.خارج از بازه، "درگاه " + ن + " معتبر نیست")
    پایان
    برگشت ن
پایان

تابع بارگذاری پیکربندی(متن: رشته): صحیح خطادار:
    تلاش:
        برگشت خواندن درگاه(متن)
    گرفتن خطا خ:
        پرتاب خطا خ.بپیچ("خواندن درگاه")
    پایان
پایان

تابع ریشه:
    تلاش:
        سرچاپ بارگذاری پیکربندی("80")
        سرچاپ بارگذاری پیکربندی("70000")
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
        سرچاپ "زمینه:"، خ.زمینه
        سرچاپ "نوع:"، خ.نام نوع()
    پایان
پایان
