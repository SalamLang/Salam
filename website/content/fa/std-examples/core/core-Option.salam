واردسازی هسته

تابع جستجو(نام‌ها: وکتور<رشته>، دنبال: رشته): هسته.اختیاری<صحیح>:
    هر ش، ن در نام‌ها:
        اگر ن == دنبال:
            برگشت هسته.یک مقدار(ش)
        پایان
    پایان
    برگشت هسته.هیچ مقدار()
پایان

تابع ریشه:
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن نام‌ها.آزادکن()
    نام‌ها.بیفزا("علی")
    نام‌ها.بیفزا("مریم")
    ی := جستجو(نام‌ها، "مریم")
    ن := جستجو(نام‌ها، "رضا")
    سرچاپ هسته.دارد(ی)، هسته.ندارد(ی)، ی.مقدار، ی.موجود
    سرچاپ هسته.دارد(ن)، هسته.ندارد(ن)
    سرچاپ هسته.باز کردن(ی)، هسته.انتظار(ی، "باید پیدا می‌شد")
    سرچاپ هسته.با پیش فرض(ن، -۱)
پایان
