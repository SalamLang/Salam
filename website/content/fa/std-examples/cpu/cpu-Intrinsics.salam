واردسازی پردازنده
واردسازی حافظه

تابع نمایش(برچسب: رشته، مقدار: طبیعی۱۲۸):
    بافر := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    پردازنده.ذخیره شانزده بایت(بافر، مقدار)
    نشانی := بافر برگردان طبیعی۸*
    ارقام := "0123456789abcdef"
    ناپایا متن := ""
    تکرار 16 در ن:
        بایت := نشانی[ن] برگردان صحیح
        متن += ارقام.زیررشته(بایت >> 4، 1)
        متن += ارقام.زیررشته(بایت & 15، 1)
    پایان
    سرچاپ برچسب، متن
    حافظه.آزادسازی(بافر)
پایان

تابع ریشه:
    بافر := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    نشانی := بافر برگردان طبیعی۸*
    تکرار 16 در ن:
        نشانی[ن] = (ن * 17) برگردان طبیعی۸
    پایان
    ایکس := پردازنده.بارگیری شانزده بایت(بافر)
    نمایش("بارگیری "، ایکس)
    نمایش("دور     "، پردازنده.دور رمز(ایکس، ایکس))
    نمایش("دور آخر "، پردازنده.دور آخر رمز(ایکس، ایکس))
    نمایش("ضرب     "، پردازنده.ضرب بدون نقلی(ایکس، ایکس، 0))
    نمایش("ضرب بالا"، پردازنده.ضرب بدون نقلی(ایکس، ایکس، 17))
    نمایش("جابجایی "، پردازنده.جابجایی نیمه ها(ایکس))
    نمایش("وارونه  "، پردازنده.وارونه سازی بایت ها(ایکس))
    پردازنده.تنظیم سخت افزار(نادرست)
    سرچاپ "خاموش:"، پردازنده.دارای رمز سخت افزاری()
    پردازنده.تنظیم سخت افزار(درست)
    ویژگی‌ها := پردازنده.ویژگی های پردازنده()
    هست := (ویژگی‌ها & پردازنده.ویژگی رمز سخت افزاری) نابرابر 0
    سرچاپ "روشن با پردازنده می‌خواند:"، پردازنده.دارای رمز سخت افزاری() برابر هست
    سرچاپ "خانواده‌ها می‌خوانند:"، پردازنده.دارای ای ای اس ان آی() برابر (هست و (ویژگی‌ها & پردازنده.ویژگی ایکس۸۶) نابرابر 0)، پردازنده.دارای رمز آرم() برابر (هست و (ویژگی‌ها & پردازنده.ویژگی آرم۶۴) نابرابر 0)، پردازنده.دارای ضرب بدون نقلی() برابر پردازنده.دارای ای ای اس ان آی()
    حافظه.آزادسازی(بافر)
پایان
