واردسازی حافظه
واردسازی زمان
واردسازی کرون

ناپایا برخوردها := پوچ برگردان صحیح۶۴*

تابع tick(_id: صحیح۶۴):
    اتمی‌بیفزا(برخوردها، 1 برگردان صحیح۶۴)
پایان

تابع wait():
    ناپایا منتظر := 0
    تا اتمی‌بخوان(برخوردها) برابر (0 برگردان صحیح۶۴) و منتظر کوچکتر 200:
        زمان.خواب(10)
        منتظر++
    پایان
    تکرار کرون.کل() در شمارنده:
        تا کرون.مشغول است(شمارنده) و منتظر کوچکتر 400:
            زمان.خواب(10)
            منتظر++
        پایان
    پایان
پایان

تابع ریشه:
    برخوردها = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    کرون.تنظیم منطقه("Invalid/Nowhere"، 0)

    روزانه := کرون.روزانه در("report"، "10:30"، tick)
    هفتگی := کرون.هفتگی در("backup"، "mon-fri"، "02:00:15"، tick)
    کرون.تنظیم برچسب(هفتگی، "ops,nightly")
    کرون.یک بار("launch"، 1792900000 برگردان صحیح۶۴، tick)
    محدود := کرون.افزودن("limited"، "*/5 * * * * *"، tick)
    کرون.محدودیت(محدود، 1)

    سرچاپ "next daily"، کرون.اجرای بعدی(روزانه، 1792800300 برگردان صحیح۶۴)
    سرچاپ "next weekly"، کرون.اجرای بعدی(هفتگی، 1792800300 برگردان صحیح۶۴)
    سرچاپ "next limited"، کرون.اجرای بعدی(محدود، 1792800300 برگردان صحیح۶۴)
    سرچاپ "found"، کرون.یافتن("backup") برابر هفتگی، "tagged"، کرون.برچسب دارد(هفتگی، "ops")

    سرچاپ "launch"، کرون.اجرای موعد(1792900000 برگردان صحیح۶۴)
    wait()
    سرچاپ "removed by tag"، کرون.حذف با برچسب("ops")، "left"، کرون.تعداد()
پایان
