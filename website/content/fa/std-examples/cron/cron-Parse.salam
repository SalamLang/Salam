واردسازی کرون

پایا ZONE := "Invalid/Nowhere"
پایا OFF := ۲۱۰
پایا AFTER := ۱۷۹۲۸۰۰۳۰۰ برگردان صحیح۶۴

تابع نمایش(مشخصه: رشته):
    عنصر := کرون.تجزیه(مشخصه)
    سرچاپ مشخصه، عنصر.معتبر، کرون.بعدی(عنصر، AFTER، ZONE، OFF)
پایان

تابع ریشه:
    نمایش("*/20 * * * *")
    نمایش("@daily")
    نمایش("0 0 29 feb *")
    نمایش("nope")

    عنصر := کرون.تجزیه("*/5 * * * *")
    سرچاپ کرون.تطبیق فیلدها(عنصر، ۱۵، ۱۰، ۱، ۱، ۰)
    سرچاپ کرون.تطبیق فیلدها(عنصر، ۱۶، ۱۰، ۱، ۱، ۰)
    سرچاپ کرون.اختلاف ثانیه منطقه(ZONE، OFF، AFTER)
پایان
