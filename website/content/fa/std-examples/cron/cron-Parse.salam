واردسازی کرون

پایا ZONE := "Invalid/Nowhere"
پایا OFF := ۲۱۰
پایا AFTER := ۱۷۹۲۸۰۰۳۰۰ برگردان صحیح۶۴

تابع نمایش(مشخصه: رشته):
    e := کرون.تجزیه(مشخصه)
    سرچاپ مشخصه، e.معتبر، کرون.بعدی(e، AFTER، ZONE، OFF)
پایان

تابع ریشه:
    نمایش("*/20 * * * *")
    نمایش("@daily")
    نمایش("0 0 29 feb *")
    نمایش("nope")

    e := کرون.تجزیه("*/5 * * * *")
    سرچاپ کرون.تطبیق فیلدها(e، ۱۵، ۱۰، ۱، ۱، ۰)
    سرچاپ کرون.تطبیق فیلدها(e، ۱۶، ۱۰، ۱، ۱، ۰)
    سرچاپ کرون.اختلاف ثانیه منطقه(ZONE، OFF، AFTER)
پایان
