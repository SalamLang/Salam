واردسازی داده
واردسازی ماتریس

تابع شمار یک‌ها(وای: ماتریس.ماتریس): صحیح:
    ناپایا ش := ۰
    تکرار وای.سطرها در ای:
        اگر وای.عنصر(ای، ۰) == ۱.۰:
            ش += ۱
        پایان
    پایان
    برگشت ش
پایان

تابع ریشه:
    ناپایا وای := ماتریس.ماتریس {}
    خ := داده.ساخت خوشه‌ها(۹۰، ۳، ۲، ۰.۵، ۴۲، وای)
    سرچاپ خ.سطرها، خ.ستون‌ها، وای.سطرها
    ه := داده.ساخت هلال‌ها(۱۰۰، ۰.۱، ۷، وای)
    سرچاپ ه.سطرها، ه.ستون‌ها، شمار یک‌ها(وای)
    د := داده.ساخت دایره‌ها(۶۰، ۰.۰۵، ۰.۵، ۷، وای)
    سرچاپ د.سطرها، شمار یک‌ها(وای)
    ناپایا ضریب := ماتریس.ماتریس {}
    ر := داده.ساخت رگرسیون(۵۰، ۳، ۰.۱، ۱، وای، ضریب)
    سرچاپ ر.سطرها، ر.ستون‌ها، ضریب.سطرها
    ک := داده.ساخت دسته‌بندی(۴۰، ۴، ۲، ۱.۰، ۳، وای)
    سرچاپ ک.سطرها، ک.ستون‌ها، شمار یک‌ها(وای) > ۰
پایان
