واردسازی داده
واردسازی ماتریس

تابع ریشه خطادار:
    متن := "age,city,score,ok\n30,tehran,1.5,1\n25,shiraz,2.5,0\n41,tehran,3.0,1\n"
    ناپایا ج := تلاش داده.بارگذاری سی‌اس‌وی(متن، درست)
    سرچاپ ج.سطرها()، ج.ستون‌ها()، ج.نام‌ها، ج.نمایه ستون("score")، ج.نمایه ستون("x")
    سرچاپ ج.گونه‌ها[۰] == داده.ستون صحیح، ج.گونه‌ها[۱] == داده.ستون رده‌ای، ج.گونه‌ها[۲] == داده.ستون اعشاری، داده.ستون رشته‌ای
    سرچاپ ج.سطوح رده‌ای("city")
    ناپایا م := ج.به ماتریس()
    سرچاپ م.سطرها، م.ستون‌ها، م.عنصر(۲، ۱)
    ناپایا ایکس := ماتریس.ماتریس {}
    ناپایا وای := ماتریس.ماتریس {}
    سرچاپ ج.جداسازی ویژگی از برچسب("ok"، ایکس، وای)، ایکس.ستون‌ها، وای.عنصر(۱، ۰)
    تلاش:
        داده.بارگذاری پرونده سی‌اس‌وی("نیست.csv"، درست)
    گرفتن خطا خ:
        سرچاپ خ.نام نوع()، خ.مسیر
    پایان
    ماتریس.آزادسازی(م)
    ماتریس.آزادسازی(ایکس)
    ماتریس.آزادسازی(وای)
    ج.آزادسازی()
پایان
