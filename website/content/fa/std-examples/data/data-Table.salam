واردسازی داده
واردسازی ماتریس

تابع ریشه:
    متن := "age,city,score,ok\n30,tehran,1.5,1\n25,shiraz,2.5,0\n41,tehran,3.0,1\n"
    ناپایا ج := داده.بارگذاری سی‌اس‌وی(متن، درست)
    سرچاپ ج.سطرها()، ج.ستون‌ها()، ج.names، ج.نمایه ستون("score")، ج.نمایه ستون("x")
    سرچاپ ج.kinds[۰] == داده.ستون صحیح، ج.kinds[۱] == داده.ستون رده‌ای، ج.kinds[۲] == داده.ستون اعشاری، داده.ستون رشته‌ای
    سرچاپ ج.سطوح رده‌ای("city")
    ناپایا م := ج.به ماتریس()
    سرچاپ م.rows، م.cols، م.عنصر(۲، ۱)
    ناپایا ایکس := ماتریس.ماتریس {}
    ناپایا وای := ماتریس.ماتریس {}
    سرچاپ ج.جداسازی ویژگی از برچسب("ok"، ایکس، وای)، ایکس.cols، وای.عنصر(۱، ۰)
    ناپایا خوب := درست
    _ := داده.بارگذاری پرونده سی‌اس‌وی("نیست.csv"، درست، خوب)
    سرچاپ خوب
    ماتریس.آزادسازی(م)
    ماتریس.آزادسازی(ایکس)
    ماتریس.آزادسازی(وای)
    ج.آزادسازی()
