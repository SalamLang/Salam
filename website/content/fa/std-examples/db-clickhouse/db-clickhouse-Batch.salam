واردسازی دیتابیس.کلیک هاوس

تابع ریشه:
    ناپایا c := کلیک هاوس.باز کردن(کلیک هاوس.گزینه‌های پیش‌فرض())
    دیرکن c.بستن()

    ناپایا b := c.آماده‌سازی دسته("INSERT INTO events (id, name, tags, score)")
    اگر b.خطا().طول() بزرگتر 0:
        سرچاپ b.خطا()
        برگشت
    پایان
    سرچاپ b.سرآیند، b.پهنا

    ناپایا tags := وکتور {} برگردان وکتور<رشته>
    tags.بیفزا(کلیک هاوس.آرگومان رشته("a"))
    tags.بیفزا(کلیک هاوس.آرگومان رشته("b"))
    ناپایا row := وکتور {} برگردان وکتور<رشته>
    row.بیفزا(کلیک هاوس.آرگومان صحیح(1 برگردان صحیح۶۴))
    row.بیفزا(کلیک هاوس.آرگومان رشته("o'brien"))
    row.بیفزا(کلیک هاوس.آرگومان آرایه(tags))
    row.بیفزا(کلیک هاوس.آرگومان اعشاری(2.5))
    سرچاپ b.افزودن(row)

    ناپایا bad := وکتور {} برگردان وکتور<رشته>
    bad.بیفزا(کلیک هاوس.آرگومان تهی())
    سرچاپ b.افزودن(bad)، b.خطا()، b.طول()، b.ردیف‌ها.طول()

    again := کلیک هاوس.آرگومان‌ها(row)
    سرچاپ b.افزودن(again)
    سرچاپ c.ارسال دسته(b)
    b.رها کردن()

    keys := کلیک هاوس.آرگومان‌ها(tags)
    سرچاپ کلیک هاوس.آرگومان نگاشت(keys، keys)
    سرچاپ کلیک هاوس.آرگومان چندتایی(keys)، کلیک هاوس.آرگومان منطقی(درست)، کلیک هاوس.آرگومان خام("now()")
    سرچاپ کلیک هاوس.نقل قول شناسه("my table")
پایان
