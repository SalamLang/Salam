واردسازی دیتابیس.کلیک هاوس

تابع ریشه:
    ناپایا نویسه := کلیک هاوس.باز کردن(کلیک هاوس.گزینه‌های پیش‌فرض())
    دیرکن نویسه.بستن()

    ناپایا بافر_محلی := نویسه.آماده‌سازی دسته("INSERT INTO events (id, name, tags, score)")
    اگر بافر_محلی.خطا().طول() بزرگتر 0:
        سرچاپ بافر_محلی.خطا()
        برگشت
    پایان
    سرچاپ بافر_محلی.سرآیند، بافر_محلی.پهنا

    ناپایا متغیر_tags := وکتور {} برگردان وکتور<رشته>
    متغیر_tags.بیفزا(کلیک هاوس.آرگومان رشته("a"))
    متغیر_tags.بیفزا(کلیک هاوس.آرگومان رشته("b"))
    ناپایا ردیف := وکتور {} برگردان وکتور<رشته>
    ردیف.بیفزا(کلیک هاوس.آرگومان صحیح(1 برگردان صحیح۶۴))
    ردیف.بیفزا(کلیک هاوس.آرگومان رشته("o'brien"))
    ردیف.بیفزا(کلیک هاوس.آرگومان آرایه(متغیر_tags))
    ردیف.بیفزا(کلیک هاوس.آرگومان اعشاری(2.5))
    سرچاپ بافر_محلی.افزودن(ردیف)

    دوباره := کلیک هاوس.آرگومان‌ها(ردیف)
    سرچاپ بافر_محلی.افزودن(دوباره)
    سرچاپ نویسه.ارسال دسته(بافر_محلی)

    ناپایا خراب := نویسه.آماده‌سازی دسته("INSERT INTO events (id, name, tags, score)")
    ناپایا بد := وکتور {} برگردان وکتور<رشته>
    بد.بیفزا(کلیک هاوس.آرگومان تهی())
    سرچاپ خراب.افزودن(بد)، خراب.خطا()، خراب.طول()، خراب.ردیف‌ها.طول()
    خراب.رها کردن()

    کلیدها := کلیک هاوس.آرگومان‌ها(متغیر_tags)
    سرچاپ کلیک هاوس.آرگومان نگاشت(کلیدها، کلیدها)
    سرچاپ کلیک هاوس.آرگومان چندتایی(کلیدها)، کلیک هاوس.آرگومان منطقی(درست)، کلیک هاوس.آرگومان خام("now()")
    سرچاپ کلیک هاوس.نقل قول شناسه("my table")
پایان
