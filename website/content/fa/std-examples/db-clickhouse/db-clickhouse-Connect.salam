واردسازی دیتابیس.کلیک هاوس

تابع ریشه:
    ناپایا او := کلیک هاوس.گزینه‌های پیش‌فرض()
    او.نشانی = "127.0.0.1:8123"
    او.پایگاه داده = "shop"
    او.نام کاربری = "default"
    او.گذرواژه = ""
    او.امن = نادرست
    او.مهلت میلی‌ثانیه = 10000
    او.تنظیمات.درج("max_threads"، "4")
    او.سرآیندها.درج("X-Request-Source"، "docs")
    سرچاپ کلیک هاوس.درگاه پیش‌فرض، کلیک هاوس.درگاه امن پیش‌فرض

    ناپایا نویسه := کلیک هاوس.باز کردن(او)
    اگر وارونه نویسه.پینگ():
        سرچاپ "no server:"، نویسه.خطا()، نویسه.وضعیت
        برگشت
    پایان
    سرچاپ نویسه.نسخه کارگزار()، نویسه.پایه، نویسه.باز

    متغیر_byurl := کلیک هاوس.باز کردن نشانی("clickhouse://default:@127.0.0.1:8123/shop?max_threads=4")
    سرچاپ متغیر_byurl.معتبر()، متغیر_byurl.گزینه‌ها.پایگاه داده

    هیچ := وکتور {} برگردان وکتور<رشته>
    سرچاپ نویسه.اجرا("CREATE TABLE IF NOT EXISTS events (id UInt64, name String) ENGINE = MergeTree ORDER BY id"، هیچ)
    ناپایا متغیر_ins := نگاشت {} برگردان نگاشت<رشته، رشته>
    متغیر_ins.درج("id"، "1")
    متغیر_ins.درج("name"، "first")
    سرچاپ نویسه.اجرا با پارامتر("INSERT INTO events VALUES ({id:UInt64}, {name:String})"، متغیر_ins)
    سرچاپ نویسه.اجرا با تنظیمات("OPTIMIZE TABLE events"، هیچ، او.تنظیمات)
    ناپایا متغیر_pn := نگاشت {} برگردان نگاشت<رشته، رشته>
    متغیر_pn.درج("n"، "7")
    سرچاپ نویسه.اجرای کامل("SELECT {n:UInt8}"، متغیر_pn، نگاشت {} برگردان نگاشت<رشته، رشته>)
    اگر وارونه نویسه.معتبر():
        سرچاپ "failed with code"، نویسه.کد()، نویسه.خطا()
    پایان
    سرچاپ نویسه.شناسه پرسمان، نویسه.ردیف‌های خوانده، نویسه.ردیف‌های نوشته
    نویسه.بستن()
پایان
