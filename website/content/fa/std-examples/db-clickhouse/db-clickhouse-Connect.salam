واردسازی دیتابیس.کلیک هاوس

تابع ریشه:
    ناپایا o := کلیک هاوس.گزینه‌های پیش‌فرض()
    o.نشانی = "127.0.0.1:8123"
    o.پایگاه داده = "shop"
    o.نام کاربری = "default"
    o.گذرواژه = ""
    o.امن = نادرست
    o.مهلت میلی‌ثانیه = 10000
    o.تنظیمات.درج("max_threads"، "4")
    o.سرآیندها.درج("X-Request-Source"، "docs")
    سرچاپ کلیک هاوس.درگاه پیش‌فرض، کلیک هاوس.درگاه امن پیش‌فرض

    ناپایا c := کلیک هاوس.باز کردن(o)
    اگر وارونه c.پینگ():
        سرچاپ "no server:"، c.خطا()، c.وضعیت
        برگشت
    پایان
    سرچاپ c.نسخه کارگزار()، c.پایه، c.باز

    byurl := کلیک هاوس.باز کردن نشانی("clickhouse://default:@127.0.0.1:8123/shop?max_threads=4")
    سرچاپ byurl.معتبر()، byurl.گزینه‌ها.پایگاه داده

    none := وکتور {} برگردان وکتور<رشته>
    سرچاپ c.اجرا("CREATE TABLE IF NOT EXISTS events (id UInt64, name String) ENGINE = MergeTree ORDER BY id"، none)
    ناپایا ins := نگاشت {} برگردان نگاشت<رشته، رشته>
    ins.درج("id"، "1")
    ins.درج("name"، "first")
    سرچاپ c.اجرا با پارامتر("INSERT INTO events VALUES ({id:UInt64}, {name:String})"، ins)
    سرچاپ c.اجرا با تنظیمات("OPTIMIZE TABLE events"، none، o.تنظیمات)
    ناپایا pn := نگاشت {} برگردان نگاشت<رشته، رشته>
    pn.درج("n"، "7")
    سرچاپ c.اجرای کامل("SELECT {n:UInt8}"، pn، نگاشت {} برگردان نگاشت<رشته، رشته>)
    اگر وارونه c.معتبر():
        سرچاپ "failed with code"، c.کد()، c.خطا()
    پایان
    سرچاپ c.شناسه پرسمان، c.ردیف‌های خوانده، c.ردیف‌های نوشته
    c.بستن()
پایان
