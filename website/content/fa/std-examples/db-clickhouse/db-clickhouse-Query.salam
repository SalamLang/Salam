واردسازی دیتابیس.کلیک هاوس

تابع ریشه:
    ناپایا نویسه := کلیک هاوس.باز کردن(کلیک هاوس.گزینه‌های پیش‌فرض())
    دیرکن نویسه.بستن()
    هیچ := وکتور {} برگردان وکتور<رشته>

    ناپایا آرگومان‌ها := وکتور {} برگردان وکتور<رشته>
    آرگومان‌ها.بیفزا(کلیک هاوس.آرگومان طبیعی(10 برگردان طبیعی۶۴))
    ناپایا ردیف‌ها := نویسه.پرسمان("SELECT id, name, price, tags, active FROM events WHERE id >= ?"، آرگومان‌ها)
    اگر وارونه ردیف‌ها.معتبر():
        سرچاپ ردیف‌ها.خطا()
        برگشت
    پایان
    سرچاپ ردیف‌ها.تعداد ستون()، ردیف‌ها.تعداد ردیف()، ردیف‌ها.جمع
    تکرار ردیف‌ها.تعداد ستون() در شمارنده:
        سرچاپ شمارنده، ردیف‌ها.نام ستون(شمارنده)، ردیف‌ها.نوع ستون(شمارنده)، ردیف‌ها.دسته ستون(شمارنده)، ردیف‌ها.شماره ستون(ردیف‌ها.نام ستون(شمارنده))
    پایان
    تا ردیف‌ها.بعدی():
        سرچاپ ردیف‌ها.طبیعی۶۴(0)، ردیف‌ها.صحیح۶۴(0)، ردیف‌ها.صحیح(0)، ردیف‌ها.متن(1)، ردیف‌ها.اعشار(2)، ردیف‌ها.منطقی(4)
        سرچاپ ردیف‌ها.تهی است(1)، ردیف‌ها.خام(3)، ردیف‌ها.فهرست(3).طول()، ردیف‌ها.ردیف().طول()
        سرچاپ ردیف‌ها.متن با نام("name")، ردیف‌ها.صحیح۶۴ با نام("id")، ردیف‌ها.اعشار با نام("price")
    پایان
    سرچاپ ردیف‌ها.جایگاه، ردیف‌ها.نام‌ها.طول()، ردیف‌ها.نوع‌ها.طول()، ردیف‌ها.ردیف‌ها.طول()، ردیف‌ها.سلول‌ها.طول()
    ردیف‌ها.بستن()

    ناپایا متغیر_params := نگاشت {} برگردان نگاشت<رشته، رشته>
    متغیر_params.درج("min"، "10")
    ناپایا متغیر_byname := نویسه.پرسمان با پارامتر("SELECT count() FROM events WHERE id >= {min:UInt64}"، متغیر_params)
    سرچاپ متغیر_byname.معتبر()
    متغیر_byname.بستن()

    ناپایا محدودیت‌ها := نگاشت {} برگردان نگاشت<رشته، رشته>
    محدودیت‌ها.درج("max_execution_time"، "5")
    ناپایا محدود := نویسه.پرسمان با تنظیمات("SELECT sum(id) FROM events"، هیچ، محدودیت‌ها)
    سرچاپ محدود.معتبر()
    محدود.بستن()

    ناپایا متغیر_full := نویسه.پرسمان کامل("SELECT {min:UInt64}"، متغیر_params، محدودیت‌ها)
    سرچاپ متغیر_full.معتبر()
    متغیر_full.بستن()

    نخست := نویسه.پرسمان یک ردیف("SELECT id, name FROM events ORDER BY id LIMIT 1"، هیچ)
    اگر نخست.طول() برابر 2:
        سرچاپ نخست.بگیر(0)، نخست.بگیر(1)
    پایان
    سرچاپ نویسه.پرسمان متن("SELECT version()")، نویسه.پرسمان عدد("SELECT count() FROM events")
پایان
