واردسازی دیتابیس.کلیک هاوس

تابع ریشه:
    ناپایا c := کلیک هاوس.باز کردن(کلیک هاوس.گزینه‌های پیش‌فرض())
    دیرکن c.بستن()
    none := وکتور {} برگردان وکتور<رشته>

    ناپایا args := وکتور {} برگردان وکتور<رشته>
    args.بیفزا(کلیک هاوس.آرگومان طبیعی(10 برگردان طبیعی۶۴))
    ناپایا rows := c.پرسمان("SELECT id, name, price, tags, active FROM events WHERE id >= ?"، args)
    اگر وارونه rows.معتبر():
        سرچاپ rows.خطا()
        برگشت
    پایان
    سرچاپ rows.تعداد ستون()، rows.تعداد ردیف()، rows.جمع
    تکرار rows.تعداد ستون() در i:
        سرچاپ i، rows.نام ستون(i)، rows.نوع ستون(i)، rows.دسته ستون(i)، rows.شماره ستون(rows.نام ستون(i))
    پایان
    تا rows.بعدی():
        سرچاپ rows.طبیعی۶۴(0)، rows.صحیح۶۴(0)، rows.صحیح(0)، rows.متن(1)، rows.اعشار(2)، rows.منطقی(4)
        سرچاپ rows.تهی است(1)، rows.خام(3)، rows.فهرست(3).طول()، rows.ردیف().طول()
        سرچاپ rows.متن با نام("name")، rows.صحیح۶۴ با نام("id")، rows.اعشار با نام("price")
    پایان
    سرچاپ rows.جایگاه، rows.نام‌ها.طول()، rows.نوع‌ها.طول()، rows.ردیف‌ها.طول()، rows.سلول‌ها.طول()
    rows.بستن()

    ناپایا params := نگاشت {} برگردان نگاشت<رشته، رشته>
    params.درج("min"، "10")
    ناپایا byname := c.پرسمان با پارامتر("SELECT count() FROM events WHERE id >= {min:UInt64}"، params)
    سرچاپ byname.معتبر()
    byname.بستن()

    ناپایا limits := نگاشت {} برگردان نگاشت<رشته، رشته>
    limits.درج("max_execution_time"، "5")
    ناپایا limited := c.پرسمان با تنظیمات("SELECT sum(id) FROM events"، none، limits)
    سرچاپ limited.معتبر()
    limited.بستن()

    ناپایا full := c.پرسمان کامل("SELECT {min:UInt64}"، params، limits)
    سرچاپ full.معتبر()
    full.بستن()

    first := c.پرسمان یک ردیف("SELECT id, name FROM events ORDER BY id LIMIT 1"، none)
    اگر first.طول() برابر 2:
        سرچاپ first.بگیر(0)، first.بگیر(1)
    پایان
    سرچاپ c.پرسمان متن("SELECT version()")، c.پرسمان عدد("SELECT count() FROM events")
پایان
