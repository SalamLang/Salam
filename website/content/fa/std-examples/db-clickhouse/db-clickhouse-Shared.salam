واردسازی دیتابیس
واردسازی دیتابیس.کلیک هاوس

تابع total(نویسه: پویا دیتابیس.اتصال، table: رشته): صحیح:
    برگشت دیتابیس.پرسمان عدد(نویسه، "SELECT count() FROM " + table)
پایان

تابع ریشه:
    نویسه := کلیک هاوس.باز کردن(کلیک هاوس.گزینه‌های پیش‌فرض())
    دال := کلیک هاوس.به دیتابیس(نویسه)
    دیرکن دال.بستن()
    سرچاپ دال.نوع() برابر دیتابیس.کلیک هاوس، دال.پینگ()
    سرچاپ total(دال، "events")
    خوانده := دال.پرسمان("SELECT id, name FROM events LIMIT 5")
    تا خوانده.بعدی():
        سرچاپ خوانده.عدد صحیح۶۴(0)، خوانده.متن(1)، خوانده.نوع ستون(0)
    پایان
    خوانده.بستن()
    موقت := دال.شروع تراکنش()
    سرچاپ موقت.اجرا("INSERT INTO events VALUES (99, 'x')")، موقت.ثبت تراکنش()
پایان
