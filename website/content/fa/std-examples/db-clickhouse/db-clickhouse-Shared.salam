واردسازی دیتابیس
واردسازی دیتابیس.کلیک هاوس

تابع total(c: پویا دیتابیس.اتصال، table: رشته): صحیح:
    برگشت دیتابیس.پرسمان عدد(c، "SELECT count() FROM " + table)
پایان

تابع ریشه:
    c := کلیک هاوس.باز کردن(کلیک هاوس.گزینه‌های پیش‌فرض())
    d := کلیک هاوس.به دیتابیس(c)
    دیرکن d.بستن()
    سرچاپ d.نوع() برابر دیتابیس.کلیک هاوس، d.پینگ()
    سرچاپ total(d، "events")
    r := d.پرسمان("SELECT id, name FROM events LIMIT 5")
    تا r.بعدی():
        سرچاپ r.عدد صحیح۶۴(0)، r.متن(1)، r.نوع ستون(0)
    پایان
    r.بستن()
    t := d.شروع تراکنش()
    سرچاپ t.اجرا("INSERT INTO events VALUES (99, 'x')")، t.ثبت تراکنش()
پایان
