واردسازی زمان
واردسازی کدگذاری.جیسون
واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ک := الستیک سرچ.اتصال("http://localhost:9200")

    الستیک سرچ.تنظیم خط لوله(ک، "clean"، `{"processors":[{"lowercase":{"field":"tag"}},{"set":{"field":"seen","value":true}}]}`)
    آزمون := الستیک سرچ.شبیه‌سازی خط لوله(ک، "clean"، `{"docs":[{"_source":{"tag":"LOUD"}}]}`)
    سرچاپ جیسون.دریافت مسیر(آزمون، "docs.0.doc._source.tag")
    الستیک سرچ.نمایه کردن با گزینه(ک، "books"، "9"، `{"tag":"Poetry"}`، الستیک سرچ.گزینه‌ها { pipeline = "clean" })

    الستیک سرچ.تنظیم الگوی نمایه(ک، "app_logs"، `{"index_patterns":["applog-*"],"data_stream":{},"priority":200}`)
    الستیک سرچ.ایجاد جریان داده(ک، "applog-web")
    الستیک سرچ.ایجاد(ک، "applog-web"، ""، `{"@timestamp":"2026-10-16T10:00:00Z","msg":"started"}`)
    الستیک سرچ.چرخش نمایه(ک، "applog-web"، "")
    سرچاپ الستیک سرچ.دریافت جریان داده(ک، "applog-web")

    سیاست := `{"policy":{"phases":{"delete":{"min_age":"30d","actions":{"delete":{}}}}}}`
    اگر وارونه الستیک سرچ.اوپن سرچ است(ک): الستیک سرچ.تنظیم سیاست چرخه عمر(ک، "month"، سیاست) پایان

    الستیک سرچ.تنظیم مخزن پشتیبان(ک، "backups"، `{"type":"fs","settings":{"location":"/mnt/backups"}}`)
    الستیک سرچ.ایجاد پشتیبان(ک، "backups"، "nightly"، `{"indices":"books"}`)
    سرچاپ الستیک سرچ.فهرست پشتیبان‌ها(ک، "backups")

    شناسه := الستیک سرچ.شروع به‌روزرسانی با پرسمان(ک، "books"، الستیک سرچ.تطبیق همه()، الستیک سرچ.اسکریپت("ctx._source.year += 1"، ""))
    ناپایا کار := الستیک سرچ.دریافت کار(ک، شناسه)
    تا کار.ok و وارونه کار.completed:
        زمان.خواب(200)
        کار = الستیک سرچ.دریافت کار(ک، شناسه)
    پایان
    سرچاپ جیسون.دریافت(کار.response، "updated")

    الستیک سرچ.تنظیم اسکریپت ذخیره(ک، "by_tag"، "mustache"، `{"query":{"term":{"tag":"{{tag}}"}}}`)
    یافته‌ها := الستیک سرچ.جستجو با الگو(ک، "books"، "by_tag"، `{"tag":"poetry"}`)
    سرچاپ یافته‌ها.total

    ناپایا ج := الستیک سرچ.ارسال جستجوی ناهمگام(ک، "books"، الستیک سرچ.درخواست جستجو { query = الستیک سرچ.تطبیق همه() }، "1s")
    تا ج.running:
        ج = الستیک سرچ.دریافت جستجوی ناهمگام(ک، ج.id، "1s")
    پایان
    سرچاپ ج.result.total
    الستیک سرچ.حذف جستجوی ناهمگام(ک، ج.id)

    سرچاپ الستیک سرچ.اعتبارسنجی پرسمان(ک، "books"، الستیک سرچ.تطبیق("title"، "shahnameh"))
    سرچاپ الستیک سرچ.توضیح امتیاز(ک، "books"، "9"، الستیک سرچ.واژه("tag"، "poetry"))
    سرچاپ الستیک سرچ.تنظیم تنظیمات خوشه(ک، `{"persistent":{"indices.recovery.max_bytes_per_sec":"100mb"}}`)
پایان
