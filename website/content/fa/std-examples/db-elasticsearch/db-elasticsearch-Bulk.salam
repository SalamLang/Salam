واردسازی رشته
واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ک := الستیک سرچ.اتصال("http://localhost:9200")
    ناپایا د := الستیک سرچ.دسته‌ای تازه()
    تکرار 1000 در ش:
        شناسه := رشته.از عدد(ش برگردان صحیح۶۴)
        الستیک سرچ.نمایه کردن دسته‌ای(د، "logs"، شناسه، `{"line":` + شناسه + `,"level":"info"}`)
    پایان
    الستیک سرچ.به‌روزرسانی دسته‌ای(د، "logs"، "7"، `{"level":"warn"}`)
    الستیک سرچ.درج روزآمد دسته‌ای(د، "logs"، "new"، `{"line":-1}`)
    الستیک سرچ.حذف دسته‌ای(د، "logs"، "8")
    سرچاپ الستیک سرچ.طول دسته‌ای(د)
    نتیجه := الستیک سرچ.اجرای دسته‌ای با گزینه(ک، ""، د، الستیک سرچ.گزینه‌ها { refresh = الستیک سرچ.تازه‌سازی فوری })
    سرچاپ نتیجه.ok، نتیجه.succeeded، نتیجه.failed، نتیجه.took
    اگر نتیجه.errors:
        هر قلم در نتیجه.items:
            اگر وارونه قلم.ok: سرچاپ قلم.action، قلم.id، قلم.status، قلم.error_type، قلم.error_reason پایان
        پایان
    پایان
    الستیک سرچ.بازنشانی دسته‌ای(د)
پایان
