واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا تنظیم := الستیک سرچ.پیکربندی پیش‌فرض()
    تنظیم.نام کاربری = "elastic"
    تنظیم.گذرواژه = "s3cret"
    تنظیم.پرونده مرجع گواهی = "/etc/elasticsearch/certs/http_ca.crt"
    تنظیم.مهلت میلی‌ثانیه = 10000
    تنظیم.سرآیندها.درج("X-Opaque-Id"، "salam-docs")
    ناپایا ک := الستیک سرچ.کارخواه تازه(تنظیم)
    اگر وارونه الستیک سرچ.پینگ(ک):
        سرچاپ "cannot reach elasticsearch:"، الستیک سرچ.خطا(ک)
        برگشت
    پایان
    دانسته := الستیک سرچ.دریافت اطلاعات(ک)
    سرچاپ دانسته.توزیع، دانسته.نسخه، الستیک سرچ.سلامت خوشه(ک).وضعیت

    نگاشت := `{"mappings":{"properties":{"title":{"type":"text"},"year":{"type":"integer"}}}}`
    اگر وارونه الستیک سرچ.نمایه موجود است(ک، "books"):
        الستیک سرچ.ایجاد نمایه(ک، "books"، نگاشت)
    پایان
    نوشته := الستیک سرچ.نمایه کردن با گزینه(ک، "books"، "1"، `{"title":"Shahnameh","year":1010}`، الستیک سرچ.گزینه‌ها { تازه‌سازی = الستیک سرچ.تازه‌سازی با انتظار })
    سرچاپ نوشته.نتیجه، نوشته.نسخه

    س := الستیک سرچ.دریافت(ک، "books"، "1")
    اگر س.یافت شد: سرچاپ س.منبع پایان
    ب := الستیک سرچ.به‌روزرسانی با گزینه(ک، "books"، "1"، `{"year":1011}`، الستیک سرچ.گزینه‌ها { شرط شماره ترتیب = س.شماره ترتیب، شرط دوره اصلی = س.دوره اصلی })
    اگر وارونه ب.موفق: سرچاپ "conflict:"، الستیک سرچ.نوع خطا(ک) پایان
    الستیک سرچ.به‌روزرسانی با اسکریپت(ک، "books"، "1"، "ctx._source.year += params.n"، `{"n": 1}`)
    سرچاپ الستیک سرچ.موجود است(ک، "books"، "1")، الستیک سرچ.شمارش(ک، "books"، "")

    پ := الستیک سرچ.انجام(ک، "GET"، "/_cat/health?format=json"، "")
    سرچاپ پ.وضعیت، پ.بدنه
    الستیک سرچ.حذف(ک، "books"، "1")
    الستیک سرچ.بستن(ک)
پایان
