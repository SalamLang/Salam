واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ناپایا تنظیم := الستیک سرچ.پیکربندی پیش‌فرض()
    تنظیم.username = "elastic"
    تنظیم.password = "s3cret"
    تنظیم.ca_file = "/etc/elasticsearch/certs/http_ca.crt"
    تنظیم.timeout_ms = 10000
    تنظیم.headers.درج("X-Opaque-Id"، "salam-docs")
    ناپایا ک := الستیک سرچ.کارخواه تازه(تنظیم)
    اگر وارونه الستیک سرچ.پینگ(ک):
        سرچاپ "cannot reach elasticsearch:"، الستیک سرچ.خطا(ک)
        برگشت
    پایان
    دانسته := الستیک سرچ.دریافت اطلاعات(ک)
    سرچاپ دانسته.distribution، دانسته.version، الستیک سرچ.سلامت خوشه(ک).status

    نگاشت := `{"mappings":{"properties":{"title":{"type":"text"},"year":{"type":"integer"}}}}`
    اگر وارونه الستیک سرچ.نمایه موجود است(ک، "books"):
        الستیک سرچ.ایجاد نمایه(ک، "books"، نگاشت)
    پایان
    نوشته := الستیک سرچ.نمایه کردن با گزینه(ک، "books"، "1"، `{"title":"Shahnameh","year":1010}`، الستیک سرچ.گزینه‌ها { refresh = الستیک سرچ.تازه‌سازی با انتظار })
    سرچاپ نوشته.result، نوشته.version

    س := الستیک سرچ.دریافت(ک، "books"، "1")
    اگر س.found: سرچاپ س.source پایان
    ب := الستیک سرچ.به‌روزرسانی با گزینه(ک، "books"، "1"، `{"year":1011}`، الستیک سرچ.گزینه‌ها { if_seq_no = س.seq_no، if_primary_term = س.primary_term })
    اگر وارونه ب.ok: سرچاپ "conflict:"، الستیک سرچ.نوع خطا(ک) پایان
    الستیک سرچ.به‌روزرسانی با اسکریپت(ک، "books"، "1"، "ctx._source.year += params.n"، `{"n": 1}`)
    سرچاپ الستیک سرچ.موجود است(ک، "books"، "1")، الستیک سرچ.شمارش(ک، "books"، "")

    پ := الستیک سرچ.انجام(ک، "GET"، "/_cat/health?format=json"، "")
    سرچاپ پ.status، پ.body
    الستیک سرچ.حذف(ک، "books"، "1")
    الستیک سرچ.بستن(ک)
پایان
