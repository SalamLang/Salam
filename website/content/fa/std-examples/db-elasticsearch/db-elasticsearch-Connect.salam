واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    سرچاپ الستیک سرچ.کدگذاری پایه("elastic"، "s3cret")
    سرچاپ الستیک سرچ.کدگشایی شناسه ابری("prod:ZXVyb3BlLmNsb3VkLmVzLmlvJGFiYyRkZWY=")

    پایه := الستیک سرچ.اتصال با رمز("https://localhost:9200"، "elastic"، "s3cret")
    سرچاپ الستیک سرچ.سرآیند احراز(پایه)
    کلیددار := الستیک سرچ.اتصال با کلید("https://localhost:9200"، "VnVhQ2ZHY0JDZGJrUW0tZTVhT3g6dWkybHAyYXhUTm1zeWFrdzl0dk5ndw==")
    سرچاپ الستیک سرچ.سرآیند احراز(کلیددار)
    ابری := الستیک سرچ.اتصال ابری("prod:ZXVyb3BlLmNsb3VkLmVzLmlvJGFiYyRkZWY="، "key")
    سرچاپ الستیک سرچ.معتبر(ابری)

    ک := الستیک سرچ.اتصال("http://localhost:9200")
    اگر وارونه الستیک سرچ.معتبر(ک):
        سرچاپ الستیک سرچ.وضعیت(ک)، الستیک سرچ.علت خطا(ک)
    پایان
    سرچاپ الستیک سرچ.توزیع(ک)
    سرچاپ الستیک سرچ.گره‌ها(ک)
    سرچاپ الستیک سرچ.اطلاعات گره‌ها(ک)
    سرچاپ الستیک سرچ.آمار خوشه(ک)
    سرچاپ الستیک سرچ.انتظار برای وضعیت(ک، "yellow"، "30s").وضعیت

    پاسخ := الستیک سرچ.انجام چندخطی(ک، "POST"، "/_bulk"، `{"delete":{"_index":"books","_id":"1"}}` + "\n")
    سرچاپ پاسخ.وضعیت
پایان
