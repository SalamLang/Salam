واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ک := الستیک سرچ.اتصال("http://localhost:9200")
    گزینه‌ها := الستیک سرچ.گزینه‌ها { تازه‌سازی = الستیک سرچ.تازه‌سازی فوری }

    سرچاپ الستیک سرچ.نمایه کردن(ک، "books"، "1"، `{"title":"Shahnameh","year":1010}`).نتیجه
    سرچاپ الستیک سرچ.ایجاد با گزینه(ک، "books"، "2"، `{"title":"Masnavi","year":1258}`، گزینه‌ها).نتیجه
    سرچاپ الستیک سرچ.درج روزآمد(ک، "books"، "3"، `{"title":"Divan","year":1368}`).نتیجه
    سرچاپ الستیک سرچ.به‌روزرسانی(ک، "books"، "3"، `{"year":1369}`).نتیجه

    سرچاپ الستیک سرچ.دریافت منبع(ک، "books"، "1")
    سند := الستیک سرچ.دریافت با گزینه(ک، "books"، "2"، الستیک سرچ.گزینه‌ها { مسیریابی = "poetry" })
    سرچاپ سند.یافت شد، سند.شناسه
    ناپایا شناسه‌ها := وکتور {} برگردان وکتور<رشته>
    شناسه‌ها.بیفزا("1")
    شناسه‌ها.بیفزا("2")
    شناسه‌ها.بیفزا("3")
    هر مدرک در الستیک سرچ.دریافت چندگانه(ک، "books"، شناسه‌ها):
        سرچاپ مدرک.شناسه، مدرک.یافت شد
    پایان

    به‌روز := الستیک سرچ.به‌روزرسانی با پرسمان(ک، "books"، الستیک سرچ.واژه("year"، "1010")، الستیک سرچ.اسکریپت("ctx._source.year += 1"، ""))
    سرچاپ به‌روز
    همچنین := الستیک سرچ.به‌روزرسانی با پرسمان با گزینه(ک، "books"، الستیک سرچ.تطبیق همه()، الستیک سرچ.اسکریپت("ctx._source.seen = true"، "")، گزینه‌ها)
    سرچاپ همچنین

    سرچاپ الستیک سرچ.نمایه‌سازی دوباره(ک، "books"، "books_v2")

    سرچاپ الستیک سرچ.حذف با گزینه(ک، "books"، "1"، گزینه‌ها).نتیجه
    سرچاپ الستیک سرچ.حذف با پرسمان با گزینه(ک، "books"، الستیک سرچ.واژه("year"، "1369")، گزینه‌ها)
پایان
