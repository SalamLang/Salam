واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ک := الستیک سرچ.اتصال("http://localhost:9200")

    الستیک سرچ.ایجاد نمایه(ک، "books_v1"، `{"settings":{"number_of_shards":1}}`)
    سرچاپ الستیک سرچ.دریافت نمایه(ک، "books_v1")
    سرچاپ الستیک سرچ.دریافت نگاشت(ک، "books_v1")
    الستیک سرچ.تنظیم نگاشت(ک، "books_v1"، `{"properties":{"author":{"type":"keyword"}}}`)
    سرچاپ الستیک سرچ.دریافت تنظیمات(ک، "books_v1")
    الستیک سرچ.تنظیم تنظیمات(ک، "books_v1"، `{"index":{"refresh_interval":"5s"}}`)

    هر اطلاعات در الستیک سرچ.فهرست نمایه‌ها(ک، "books*"):
        سرچاپ اطلاعات.نمایه، اطلاعات.شمار اسناد، اطلاعات.سلامت
    پایان

    الستیک سرچ.تنظیم نام مستعار(ک، "books_v1"، "books")
    سرچاپ الستیک سرچ.نام مستعار موجود است(ک، "books")، الستیک سرچ.دریافت نام مستعار(ک، "books")
    الستیک سرچ.ایجاد نمایه(ک، "books_v2"، "")
    الستیک سرچ.جابجایی نام مستعار(ک، "books"، "books_v1"، "books_v2")
    الستیک سرچ.به‌روزرسانی نام‌های مستعار(ک، `{"actions":[{"add":{"index":"books_v2","alias":"latest"}}]}`)
    الستیک سرچ.حذف نام مستعار(ک، "books_v2"، "latest")

    الستیک سرچ.تنظیم الگوی نمایه(ک، "books_tpl"، `{"index_patterns":["books-*"],"priority":100}`)
    سرچاپ الستیک سرچ.الگوی نمایه موجود است(ک، "books_tpl")
    الستیک سرچ.حذف الگوی نمایه(ک، "books_tpl")

    الستیک سرچ.تازه‌سازی(ک، "books_v2")
    الستیک سرچ.تخلیه(ک، "books_v2")
    الستیک سرچ.ادغام اجباری(ک، "books_v2"، 1)
    الستیک سرچ.بستن نمایه(ک، "books_v2")
    الستیک سرچ.گشودن نمایه(ک، "books_v2")
    سرچاپ الستیک سرچ.تحلیل(ک، "books_v2"، "standard"، "The Book of Kings")
    سرچاپ الستیک سرچ.آمار نمایه(ک، "books_v2")

    الستیک سرچ.حذف نمایه(ک، "books_v1")
    الستیک سرچ.حذف نمایه(ک، "books_v2")
پایان
