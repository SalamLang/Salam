واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ک := الستیک سرچ.اتصال("http://localhost:9200")

    ناپایا واژه‌ها := وکتور {} برگردان وکتور<رشته>
    واژه‌ها.بیفزا("poetry")
    واژه‌ها.بیفزا("history")
    ناپایا فیلدها := وکتور {} برگردان وکتور<رشته>
    فیلدها.بیفزا("title")
    فیلدها.بیفزا("summary")
    ناپایا شناسه‌ها := وکتور {} برگردان وکتور<رشته>
    شناسه‌ها.بیفزا("1")
    شناسه‌ها.بیفزا("2")

    ناپایا بایدها := وکتور {} برگردان وکتور<رشته>
    بایدها.بیفزا(الستیک سرچ.تطبیق همه واژه‌ها("title"، "persian poetry"))
    بایدها.بیفزا(الستیک سرچ.تطبیق تقریبی("title"، "shahnama"))
    بایدها.بیفزا(الستیک سرچ.تطبیق عبارت("summary"، "book of kings"))
    بایدها.بیفزا(الستیک سرچ.تطبیق پیشوند عبارت("summary"، "book of"))
    بایدها.بیفزا(الستیک سرچ.تطبیق چندگانه("kings"، فیلدها))
    ناپایا پالایه‌ها := وکتور {} برگردان وکتور<رشته>
    پالایه‌ها.بیفزا(الستیک سرچ.واژه عددی("year"، 1010 برگردان صحیح۶۴))
    پالایه‌ها.بیفزا(الستیک سرچ.واژه منطقی("published"، درست))
    پالایه‌ها.بیفزا(الستیک سرچ.واژه‌ها("tag"، واژه‌ها))
    پالایه‌ها.بیفزا(الستیک سرچ.بازه باز("year"، "900"، "1500"))
    پالایه‌ها.بیفزا(الستیک سرچ.فیلد موجود("author"))
    پالایه‌ها.بیفزا(الستیک سرچ.شناسه‌ها(شناسه‌ها))
    پالایه‌ها.بیفزا(الستیک سرچ.تودرتو("reviews"، الستیک سرچ.واژه("reviews.stars"، "5")))
    پالایه‌ها.بیفزا(الستیک سرچ.فاصله جغرافیایی("place"، 36.2، 59.6، "50km"))
    ناپایا بهتر := وکتور {} برگردان وکتور<رشته>
    بهتر.بیفزا(الستیک سرچ.پیشوند("author"، "fer"))
    بهتر.بیفزا(الستیک سرچ.نویسه عام("author"، "f*si"))
    بهتر.بیفزا(الستیک سرچ.عبارت باقاعده("author"، "fer.*"))
    بهتر.بیفزا(الستیک سرچ.تقریبی("author"، "ferdowsy"))
    بهتر.بیفزا(الستیک سرچ.رشته پرسمان("title:shah* AND year:[900 TO 1500]"))
    بهتر.بیفزا(الستیک سرچ.رشته پرسمان ساده("epic | lyric"، فیلدها))
    ناپایا هیچ := وکتور {} برگردان وکتور<رشته>
    هیچ.بیفزا(الستیک سرچ.تطبیق هیچ())

    پرسمان := الستیک سرچ.ترکیب منطقی(بایدها، پالایه‌ها، بهتر، هیچ)
    سرچاپ الستیک سرچ.یکی از شرط‌ها(بهتر)
    سرچاپ الستیک سرچ.امتیاز ثابت(الستیک سرچ.فیلد موجود("author"))

    ناپایا بردار := وکتور {} برگردان وکتور<اعشار۶۴>
    بردار.بیفزا(0.1)
    بردار.بیفزا(0.9)
    سرچاپ الستیک سرچ.نزدیک‌ترین همسایه‌ها("embedding"، بردار، 5، 50)

    ناپایا تجمیع‌ها := الستیک سرچ.افزودن تجمیع(""، "authors"، الستیک سرچ.تجمیع یکتا("author"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "first"، الستیک سرچ.تجمیع کمینه("year"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "total"، الستیک سرچ.تجمیع جمع("pages"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "pages"، الستیک سرچ.تجمیع آمار("pages"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "values"، الستیک سرچ.تجمیع شمار مقدار("year"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "by_century"، الستیک سرچ.تجمیع بافت‌نگار("year"، 100.0))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "by_month"، الستیک سرچ.تجمیع بافت‌نگار تاریخ("added"، "month"))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "drafts"، الستیک سرچ.تجمیع پالایه(الستیک سرچ.واژه("status"، "draft")))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "latest"، الستیک سرچ.تجمیع برترین یافته‌ها(3))

    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    ترتیب.بیفزا(الستیک سرچ.مرتب صعودی("year"))
    درخواست := الستیک سرچ.درخواست جستجو { پرسمان = پرسمان، اندازه = 20، مرتب‌سازی = ترتیب، تجمیع‌ها = تجمیع‌ها }
    بدنه := الستیک سرچ.بدنه جستجو(درخواست)
    سرچاپ بدنه
    سرچاپ الستیک سرچ.افزودن عضو(بدنه، "track_total_hits"، "true")

    نتیجه := الستیک سرچ.جستجوی خام(ک، "books"، بدنه)
    اگر وارونه نتیجه.موفق:
        سرچاپ الستیک سرچ.خطا(ک)
        برگشت
    پایان
    سرچاپ نتیجه.کل، الستیک سرچ.تجمیع خام(نتیجه، "pages")
    هر سطل در الستیک سرچ.سطل‌های تجمیع در(الستیک سرچ.تجمیع خام(نتیجه، "by_century")، "buckets"):
        سرچاپ سطل.کلید، سطل.شمار اسناد
    پایان

    سریع := الستیک سرچ.جستجوی پرسمان(ک، "books"، الستیک سرچ.تطبیق همه()، 5)
    سرچاپ سریع.کل

    ناپایا بدنه‌ها := وکتور {} برگردان وکتور<رشته>
    بدنه‌ها.بیفزا(`{"query":` + الستیک سرچ.تطبیق("title"، "shahnameh") + `}`)
    بدنه‌ها.بیفزا(`{"query":` + الستیک سرچ.پیشوند("author"، "fer") + `}`)
    هر پاسخ در الستیک سرچ.جستجوی چندگانه(ک، "books"، بدنه‌ها):
        سرچاپ پاسخ.موفق، پاسخ.کل
    پایان

    تجزیه‌شده := الستیک سرچ.تجزیه نتیجه جستجو(`{"took":1,"hits":{"total":{"value":0,"relation":"eq"},"hits":[]}}`)
    سرچاپ تجزیه‌شده.کل
پایان
