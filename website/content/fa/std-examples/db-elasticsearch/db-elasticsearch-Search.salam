واردسازی دیتابیس.الستیک سرچ

تابع ریشه:
    ک := الستیک سرچ.اتصال("http://localhost:9200")
    ناپایا بایدها := وکتور {} برگردان وکتور<رشته>
    بایدها.بیفزا(الستیک سرچ.تطبیق("title"، "persian poetry"))
    ناپایا پالایه‌ها := وکتور {} برگردان وکتور<رشته>
    پالایه‌ها.بیفزا(الستیک سرچ.بازه("year"، "900"، "1500"))
    پالایه‌ها.بیفزا(الستیک سرچ.نقیض(الستیک سرچ.واژه("status"، "draft")))
    ناپایا تجمیع‌ها := الستیک سرچ.افزودن تجمیع(""، "by_author"، الستیک سرچ.زیرتجمیع‌ها(الستیک سرچ.تجمیع واژه‌ها("author"، 5)، الستیک سرچ.افزودن تجمیع(""، "avg_year"، الستیک سرچ.تجمیع میانگین("year"))))
    تجمیع‌ها = الستیک سرچ.افزودن تجمیع(تجمیع‌ها، "newest"، الستیک سرچ.تجمیع بیشینه("year"))
    ناپایا ترتیب := وکتور {} برگردان وکتور<رشته>
    ترتیب.بیفزا(الستیک سرچ.مرتب نزولی("year"))
    ناپایا فیلدها := وکتور {} برگردان وکتور<رشته>
    فیلدها.بیفزا("title")
    درخواست := الستیک سرچ.درخواست جستجو {
        پرسمان = الستیک سرچ.پالایش شده(الستیک سرچ.همه شرط‌ها(بایدها)، پالایه‌ها)، اندازه = 10، مرتب‌سازی = ترتیب، تجمیع‌ها = تجمیع‌ها، برجسته‌سازی = الستیک سرچ.برجسته‌سازی(فیلدها)
    }
    نتیجه := الستیک سرچ.جستجو(ک، "books"، درخواست)
    اگر وارونه نتیجه.موفق:
        سرچاپ الستیک سرچ.خطا(ک)
        برگشت
    پایان
    سرچاپ نتیجه.کل، نتیجه.رابطه کل، نتیجه.زمان اجرا
    هر ی در نتیجه.یافته‌ها:
        سرچاپ ی.شناسه، ی.امتیاز، ی.منبع، ی.برجسته‌سازی
    پایان
    سرچاپ الستیک سرچ.مقدار تجمیع(نتیجه، "newest")
    هر د در الستیک سرچ.سطل‌های تجمیع(نتیجه، "by_author"):
        سرچاپ د.کلید، د.شمار اسناد، الستیک سرچ.مقدار تجمیع در(د.خام، "avg_year")
    پایان

    ناپایا صفحه := الستیک سرچ.جستجوی پیمایشی(ک، "books"، الستیک سرچ.درخواست جستجو { پرسمان = الستیک سرچ.تطبیق همه()، اندازه = 500 }، "1m")
    تا صفحه.یافته‌ها.طول() بزرگتر 0:
        سرچاپ "page of"، صفحه.یافته‌ها.طول()
        صفحه = الستیک سرچ.پیمایش(ک، صفحه.شناسه پیمایش، "1m")
    پایان
    الستیک سرچ.پاک کردن پیمایش(ک، صفحه.شناسه پیمایش)

    نقطه := الستیک سرچ.گشودن نقطه زمانی(ک، "books"، "1m")
    نخست := الستیک سرچ.جستجو(ک، ""، الستیک سرچ.درخواست جستجو { شناسه نقطه زمانی = نقطه، اندازه = 100، مرتب‌سازی = ترتیب })
    اگر نخست.یافته‌ها.طول() بزرگتر 0:
        واپسین := نخست.یافته‌ها.بگیر(نخست.یافته‌ها.طول() - 1)
        پسین := الستیک سرچ.جستجو(ک، ""، الستیک سرچ.درخواست جستجو { شناسه نقطه زمانی = نقطه، اندازه = 100، مرتب‌سازی = ترتیب، نشانگر ادامه = واپسین.مرتب‌سازی })
        سرچاپ پسین.یافته‌ها.طول()
    پایان
    الستیک سرچ.بستن نقطه زمانی(ک، نقطه)
    سرچاپ الستیک سرچ.حذف با پرسمان(ک، "books"، الستیک سرچ.واژه("status"، "draft"))
پایان
