واردسازی دیتابیس
واردسازی دیتابیس.الستیک سرچ

تابع گزارش(رابط: پویا دیتابیس.اتصال):
    ردیف‌ها := رابط.پرسمان("SELECT level, COUNT(*) AS n FROM logs GROUP BY level")
    تا ردیف‌ها.بعدی():
        سرچاپ ردیف‌ها.متن(0)، ردیف‌ها.عدد صحیح(1)
    پایان
    ردیف‌ها.بستن()
پایان

تابع ریشه:
    ک := الستیک سرچ.اتصال("http://localhost:9200")
    ناپایا پارامترها := وکتور {} برگردان وکتور<رشته>
    پارامترها.بیفزا("100")
    ناپایا ردیف‌ها := الستیک سرچ.اس کیو ال با پارامتر(ک، "SELECT line, level FROM logs WHERE line < ? ORDER BY line"، پارامترها، 50)
    سرچاپ ردیف‌ها.تعداد ستون()، ردیف‌ها.نام ستون(0)، ردیف‌ها.نام نوع ستون(0)، ردیف‌ها.نوع ستون(0) برابر دیتابیس.نوع صحیح
    تا ردیف‌ها.بعدی():
        سرچاپ ردیف‌ها.عدد صحیح۶۴(0)، ردیف‌ها.متن(1)، ردیف‌ها.خالی است(1)
    پایان
    ردیف‌ها.بستن()
    چاپ الستیک سرچ.متن اس کیو ال(ک، "SELECT level FROM logs LIMIT 3")
    سرچاپ الستیک سرچ.ترجمه اس کیو ال(ک، "SELECT line FROM logs WHERE level = 'warn'")
    گزارش(الستیک سرچ.اتصال عمومی(ک))
پایان
