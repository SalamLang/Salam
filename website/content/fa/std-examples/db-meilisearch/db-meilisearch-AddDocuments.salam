واردسازی دیتابیس.میلیسرچ

ساختار فیلم:
    همگانی شناسه: صحیح = 0
    همگانی عنوان: رشته = ""
    همگانی سال: صحیح = 0
پایان

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    سندها := `[{"شناسه": 1, "عنوان": "Carol", "سال": 2015}, {"شناسه": 2, "عنوان": "Moana", "سال": 2016}]`
    میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندها(کارخواه، "movies"، سندها، "شناسه"، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی سندها(کارخواه، "movies"، `[{"شناسه": 2, "سال": 2017}]`، ""، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندهای ان‌دی‌جیسون(کارخواه، "movies"، "{\"id\": 3, \"title\": \"Heat\"}\n"، ""، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی سندهای ان‌دی‌جیسون(کارخواه، "movies"، "{\"id\": 3, \"year\": 1995}\n"، ""، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندهای سی‌اس‌وی(کارخواه، "movies"، "id:number;title\n4;Up\n"، ""، ";"، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی سندهای سی‌اس‌وی(کارخواه، "movies"، "id:number,year:number\n4,2009\n"، ""، ""، اشکال)، اشکال)

    ناپایا نوع‌دار := وکتور {} برگردان وکتور<فیلم>
    نوع‌دار.بیفزا(فیلم { شناسه = 5، عنوان = "Alien"، سال = 1979 })
    میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندهای نوع(کارخواه، "movies"، نوع‌دار، "شناسه"، اشکال)، اشکال)

    ناپایا انبوه := وکتور {} برگردان وکتور<رشته>
    تکرار 2500 در شماره:
        انبوه.بیفزا(`{"شناسه": ` + (100 + شماره) + `, "عنوان": "Movie ` + شماره + `"}`)
    پایان
    کارها := میلیسرچ.افزودن سندها در دسته‌ها(کارخواه، "movies"، انبوه، 1000، "شناسه"، اشکال)
    هر رسیدی در کارها:
        میلیسرچ.انتظار(کارخواه، رسیدی، اشکال)
    پایان

    ناپایا فیلدها := وکتور {} برگردان وکتور<رشته>
    فیلدها.بیفزا("عنوان")
    سرچاپ میلیسرچ.دریافت سند(کارخواه، "movies"، "1"، فیلدها، اشکال)
    ناپایا نمونه := فیلم {}
    اگر میلیسرچ.دریافت سند به نوع(کارخواه، "movies"، "2"، نمونه، اشکال):
        سرچاپ نمونه.عنوان، نمونه.سال
    پایان

    ناپایا پرسش := میلیسرچ.پرسش سند { حد = 10، فیلتر = "year > 2000"، بازیابی بردارها = نادرست }
    پرسش.فیلدها.بیفزا("شناسه")
    پرسش.فیلدها.بیفزا("عنوان")
    پرسش.مرتب‌سازی.بیفزا("سال:desc")
    پرسش.شناسه‌ها.بیفزا("1")
    پرسش.شناسه‌ها.بیفزا("2")
    صفحه := میلیسرچ.دریافت سندها(کارخواه، "movies"، میلیسرچ.پرسش سند { جابجایی = 0، حد = 20 }، اشکال)
    ناپایا فیلم‌ها := وکتور {} برگردان وکتور<فیلم>
    اگر میلیسرچ.سندها به نوع(صفحه، فیلم‌ها، اشکال):
        سرچاپ فیلم‌ها.طول()، صفحه.کل
    پایان
    سرچاپ میلیسرچ.دریافت سندها(کارخواه، "movies"، پرسش، اشکال).نتیجه‌ها.طول()

    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی سندها با اسکریپت(کارخواه، "movies"، "doc.title = doc.title.to_upper()"، "id < 10"، ""، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.حذف سند(کارخواه، "movies"، "5"، اشکال)، اشکال)
    ناپایا شناسه‌ها := وکتور {} برگردان وکتور<رشته>
    شناسه‌ها.بیفزا("3")
    شناسه‌ها.بیفزا("4")
    میلیسرچ.انتظار(کارخواه، میلیسرچ.حذف سندها(کارخواه، "movies"، شناسه‌ها، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.حذف سندها با فیلتر(کارخواه، "movies"، "id >= 100"، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.حذف همه سندها(کارخواه، "movies"، اشکال)، اشکال)
    سرچاپ میلیسرچ.متن خطا(اشکال)

    برچسب‌خورده := میلیسرچ.با فراداده(کارخواه، "import-2026-10-16")
    گزینه‌ها := میلیسرچ.گزینه‌های سند { نوع محتوا = "application/x-ndjson"، ادغام = درست، کلید اصلی = "شناسه"، جداکننده ستون = ""، بدون ساخت = درست }
    میلیسرچ.انتظار(کارخواه، میلیسرچ.افزودن سندها با گزینه(برچسب‌خورده، "movies"، "{\"id\": 1, \"year\": 2016}\n"، گزینه‌ها، اشکال)، اشکال)
    سرچاپ میلیسرچ.دریافت سند با گزینه(کارخواه، "movies"، "1"، میلیسرچ.پرسش سند { بازیابی بردارها = درست، استفاده از شبکه = نادرست }، اشکال)
پایان
