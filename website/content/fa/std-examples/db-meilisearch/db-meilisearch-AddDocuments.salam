واردسازی دیتابیس.میلیسرچ

ساختار Movie:
    همگانی id: صحیح = 0
    همگانی title: رشته = ""
    همگانی year: صحیح = 0
پایان

تابع ریشه:
    ک := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا خ := میلیسرچ.خطا {}

    سندها := `[{"id": 1, "title": "Carol", "year": 2015}, {"id": 2, "title": "Moana", "year": 2016}]`
    میلیسرچ.انتظار(ک، میلیسرچ.افزودن سندها(ک، "movies"، سندها، "id"، خ)، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.به‌روزرسانی سندها(ک، "movies"، `[{"id": 2, "year": 2017}]`، ""، خ)، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.افزودن سندهای ان‌دی‌جیسون(ک، "movies"، "{\"id\": 3, \"title\": \"Heat\"}\n"، ""، خ)، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.به‌روزرسانی سندهای ان‌دی‌جیسون(ک، "movies"، "{\"id\": 3, \"year\": 1995}\n"، ""، خ)، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.افزودن سندهای سی‌اس‌وی(ک، "movies"، "id:number;title\n4;Up\n"، ""، ";"، خ)، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.به‌روزرسانی سندهای سی‌اس‌وی(ک، "movies"، "id:number,year:number\n4,2009\n"، ""، ""، خ)، خ)

    ناپایا typed := وکتور {} برگردان وکتور<Movie>
    typed.بیفزا(Movie { id = 5، title = "Alien"، year = 1979 })
    میلیسرچ.انتظار(ک، میلیسرچ.افزودن سندهای نوع(ک، "movies"، typed، "id"، خ)، خ)

    ناپایا many := وکتور {} برگردان وکتور<رشته>
    تکرار 2500 در i:
        many.بیفزا(`{"id": ` + (100 + i) + `, "title": "Movie ` + i + `"}`)
    پایان
    tasks := میلیسرچ.افزودن سندها در دسته‌ها(ک، "movies"، many، 1000، "id"، خ)
    هر t در tasks:
        میلیسرچ.انتظار(ک، t، خ)
    پایان

    ناپایا fields := وکتور {} برگردان وکتور<رشته>
    fields.بیفزا("title")
    سرچاپ میلیسرچ.دریافت سند(ک، "movies"، "1"، fields، خ)
    ناپایا m := Movie {}
    اگر میلیسرچ.دریافت سند به نوع(ک، "movies"، "2"، m، خ):
        سرچاپ m.title، m.year
    پایان

    ناپایا q := میلیسرچ.پرسش سند { limit = 10، filter = "year > 2000"، retrieve_vectors = نادرست }
    q.fields.بیفزا("id")
    q.fields.بیفزا("title")
    q.sort.بیفزا("year:desc")
    q.ids.بیفزا("1")
    q.ids.بیفزا("2")
    page := میلیسرچ.دریافت سندها(ک، "movies"، میلیسرچ.پرسش سند { offset = 0، limit = 20 }، خ)
    ناپایا movies := وکتور {} برگردان وکتور<Movie>
    اگر میلیسرچ.سندها به نوع(page، movies، خ):
        سرچاپ movies.طول()، page.total
    پایان
    سرچاپ میلیسرچ.دریافت سندها(ک، "movies"، q، خ).results.طول()

    میلیسرچ.انتظار(ک، میلیسرچ.به‌روزرسانی سندها با اسکریپت(ک، "movies"، "doc.title = doc.title.to_upper()"، "id < 10"، ""، خ)، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.حذف سند(ک، "movies"، "5"، خ)، خ)
    ناپایا ids := وکتور {} برگردان وکتور<رشته>
    ids.بیفزا("3")
    ids.بیفزا("4")
    میلیسرچ.انتظار(ک، میلیسرچ.حذف سندها(ک، "movies"، ids، خ)، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.حذف سندها با فیلتر(ک، "movies"، "id >= 100"، خ)، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.حذف همه سندها(ک، "movies"، خ)، خ)
    سرچاپ میلیسرچ.متن خطا(خ)

    tagged := میلیسرچ.با فراداده(ک، "import-2026-10-16")
    opts := میلیسرچ.گزینه‌های سند { content_type = "application/x-ndjson"، update = درست، primary_key = "id"، csv_delimiter = ""، skip_creation = درست }
    میلیسرچ.انتظار(ک، میلیسرچ.افزودن سندها با گزینه(tagged، "movies"، "{\"id\": 1, \"year\": 2016}\n"، opts، خ)، خ)
    سرچاپ میلیسرچ.دریافت سند با گزینه(ک، "movies"، "1"، میلیسرچ.پرسش سند { retrieve_vectors = درست، use_network = نادرست }، خ)
پایان
