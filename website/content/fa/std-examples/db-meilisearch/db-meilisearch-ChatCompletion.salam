واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}
    میلیسرچ.به‌روزرسانی ویژگی‌های آزمایشی(کارخواه، `{"chatCompletions": true}`، اشکال)

    تنظیمات := `{"source": "openAi", "apiKey": "sk-your-key", "prompts": {"system": "You answer questions about our movie catalog."}}`
    سرچاپ میلیسرچ.به‌روزرسانی تنظیمات گفتگو(کارخواه، "support"، تنظیمات، اشکال)
    سرچاپ میلیسرچ.دریافت تنظیمات گفتگو(کارخواه، "support"، اشکال)
    فضاها := میلیسرچ.فهرست فضاهای گفتگو(کارخواه، 0، 20، اشکال)
    سرچاپ فضاها.کل، فضاها.جابجایی، فضاها.حد
    هر فضا در فضاها.نتیجه‌ها:
        سرچاپ فضا، میلیسرچ.دریافت فضای گفتگو(کارخواه، فضا، اشکال)
    پایان

    درخواست گفتگو := `{"model": "gpt-4o-mini", "stream": true, "messages": [{"role": "user", "content": "Which space movies do you have?"}]}`
    سرچاپ میلیسرچ.تکمیل گفتگو(کارخواه، "support"، درخواست گفتگو، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
    پایان
    سرچاپ میلیسرچ.بازنشانی تنظیمات گفتگو(کارخواه، "support"، اشکال)
    سرچاپ میلیسرچ.حذف فضای گفتگو(کارخواه، "support"، اشکال)
پایان
