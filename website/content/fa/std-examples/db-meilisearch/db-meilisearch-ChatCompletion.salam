واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    ک := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا خ := میلیسرچ.خطا {}
    میلیسرچ.به‌روزرسانی ویژگی‌های آزمایشی(ک، `{"chatCompletions": true}`، خ)

    settings := `{"source": "openAi", "apiKey": "sk-your-key", "prompts": {"system": "You answer questions about our movie catalog."}}`
    سرچاپ میلیسرچ.به‌روزرسانی تنظیمات گفتگو(ک، "support"، settings، خ)
    سرچاپ میلیسرچ.دریافت تنظیمات گفتگو(ک، "support"، خ)
    ws := میلیسرچ.فهرست فضاهای گفتگو(ک، 0، 20، خ)
    سرچاپ ws.total، ws.offset، ws.limit
    هر name در ws.results:
        سرچاپ name، میلیسرچ.دریافت فضای گفتگو(ک، name، خ)
    پایان

    request := `{"model": "gpt-4o-mini", "stream": true, "messages": [{"role": "user", "content": "Which space movies do you have?"}]}`
    سرچاپ میلیسرچ.تکمیل گفتگو(ک، "support"، request، خ)
    اگر وارونه میلیسرچ.موفق(خ):
        سرچاپ میلیسرچ.متن خطا(خ)
    پایان
    سرچاپ میلیسرچ.بازنشانی تنظیمات گفتگو(ک، "support"، خ)
    سرچاپ میلیسرچ.حذف فضای گفتگو(ک، "support"، خ)
پایان
