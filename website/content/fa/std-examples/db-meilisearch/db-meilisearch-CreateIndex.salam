واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    رسید := میلیسرچ.ایجاد نمایه(کارخواه، "movies"، "شناسه"، اشکال)
    سرچاپ رسید.شناسه کار، رسید.نمایه، رسید.وضعیت، رسید.نوع، رسید.زمان صف
    انجام‌شده := میلیسرچ.انتظار(کارخواه، رسید، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
        برگشت
    پایان
    سرچاپ انجام‌شده.وضعیت

    شماره := میلیسرچ.دریافت نمایه(کارخواه، "movies"، اشکال)
    سرچاپ شماره.شناسه یکتا، شماره.کلید اصلی، شماره.زمان ساخت، شماره.زمان تغییر
    صفحه := میلیسرچ.فهرست نمایه‌ها(کارخواه، 0، 20، اشکال)
    سرچاپ صفحه.کل، صفحه.جابجایی، صفحه.حد
    هر نمایه‌ای در صفحه.نتیجه‌ها:
        سرچاپ نمایه‌ای.شناسه یکتا
    پایان

    میلیسرچ.انتظار برای کار(کارخواه، میلیسرچ.به‌روزرسانی نمایه(کارخواه، "movies"، "movie_id"، اشکال).شناسه کار، 10000، 50، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.تغییر نام نمایه(کارخواه، "movies"، "films"، اشکال)، اشکال)

    ناپایا جابجایی‌ها := وکتور {} برگردان وکتور<میلیسرچ.جابجایی نمایه>
    جابجایی‌ها.بیفزا(میلیسرچ.جابجایی نمایه { نخست = "films"، دوم = "films_next" })
    جابجایی‌ها.بیفزا(میلیسرچ.جابجایی نمایه { نخست = "drafts"، دوم = "drafts_v2"، تغییر نام = درست })
    میلیسرچ.انتظار(کارخواه، میلیسرچ.جابجایی نمایه‌ها(کارخواه، جابجایی‌ها، اشکال)، اشکال)

    سرور := میلیسرچ.دریافت آمار نمایه(کارخواه، "films"، اشکال)
    سرچاپ سرور.تعداد سندها، سرور.اندازه خام سندها، سرور.میانگین اندازه سند، سرور.نمایه‌سازی جاری
    سرچاپ سرور.تعداد بردارها، سرور.تعداد سندهای جاسازی‌شده، سرور.توزیع فیلد

    میلیسرچ.انتظار(کارخواه، میلیسرچ.فشرده‌سازی نمایه(کارخواه، "movies"، اشکال)، اشکال)
    ناپایا پرسش وجه := میلیسرچ.پرسش فیلدها { جابجایی = 0، حد = 50، فیلتر = `{"filterable": true}` }
    پرسش وجه.الگوهای ویژگی.بیفزا("*")
    فیلدها := میلیسرچ.فهرست فیلدها(کارخواه، "movies"، پرسش وجه، اشکال)
    سرچاپ فیلدها.کل، فیلدها.جابجایی، فیلدها.حد
    هر ف در فیلدها.نتیجه‌ها:
        سرچاپ ف.نام، ف.نمایشی، ف.قابل جستجو، ف.قابل مرتب‌سازی، ف.متمایز، ف.قابل فیلتر، ف.قاعده رتبه‌بندی، ف.محلی، ف.خام.طول()
    پایان
    سرچاپ سرور.اندازه نمایه، سرور.اندازه به کار رفته نمایه، سرور.اندازه پایگاه‌های درونی
    میلیسرچ.انتظار(کارخواه، میلیسرچ.حذف نمایه(کارخواه، "films"، اشکال)، اشکال)
پایان
