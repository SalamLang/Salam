واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    ک := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا خ := میلیسرچ.خطا {}

    اطلاعات := میلیسرچ.ایجاد نمایه(ک، "movies"، "id"، خ)
    سرچاپ اطلاعات.task_uid، اطلاعات.index_uid، اطلاعات.status، اطلاعات.kind، اطلاعات.enqueued_at
    done := میلیسرچ.انتظار(ک، اطلاعات، خ)
    اگر وارونه میلیسرچ.موفق(خ):
        سرچاپ میلیسرچ.متن خطا(خ)
        برگشت
    پایان
    سرچاپ done.status

    i := میلیسرچ.دریافت نمایه(ک، "movies"، خ)
    سرچاپ i.uid، i.primary_key، i.created_at، i.updated_at
    page := میلیسرچ.فهرست نمایه‌ها(ک، 0، 20، خ)
    سرچاپ page.total، page.offset، page.limit
    هر idx در page.results:
        سرچاپ idx.uid
    پایان

    میلیسرچ.انتظار برای کار(ک، میلیسرچ.به‌روزرسانی نمایه(ک، "movies"، "movie_id"، خ).task_uid، 10000، 50، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.تغییر نام نمایه(ک، "movies"، "films"، خ)، خ)

    ناپایا swaps := وکتور {} برگردان وکتور<میلیسرچ.جابجایی نمایه>
    swaps.بیفزا(میلیسرچ.جابجایی نمایه { first = "films"، second = "films_next" })
    swaps.بیفزا(میلیسرچ.جابجایی نمایه { first = "drafts"، second = "drafts_v2"، rename = درست })
    میلیسرچ.انتظار(ک، میلیسرچ.جابجایی نمایه‌ها(ک، swaps، خ)، خ)

    s := میلیسرچ.دریافت آمار نمایه(ک، "films"، خ)
    سرچاپ s.number_of_documents، s.raw_document_db_size، s.avg_document_size، s.is_indexing
    سرچاپ s.number_of_embeddings، s.number_of_embedded_documents، s.field_distribution
    میلیسرچ.انتظار(ک، میلیسرچ.حذف نمایه(ک، "films"، خ)، خ)
پایان
