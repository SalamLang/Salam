واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    ک := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا خ := میلیسرچ.خطا {}

    hook := میلیسرچ.ایجاد وب هوک(ک، "https://example.com/meilisearch-hook"، `{"Authorization": "Bearer hook-secret"}`، خ)
    اگر وارونه میلیسرچ.موفق(خ):
        سرچاپ میلیسرچ.متن خطا(خ)
        برگشت
    پایان
    سرچاپ hook.uuid، hook.url، hook.headers، hook.is_editable
    سرچاپ میلیسرچ.دریافت وب هوک(ک، hook.uuid، خ).url
    سرچاپ میلیسرچ.به‌روزرسانی وب هوک(ک، hook.uuid، "https://example.com/v2/hook"، ""، خ).url
    هر w در میلیسرچ.فهرست وب هوک‌ها(ک، خ):
        سرچاپ w.uuid، w.url
    پایان
    سرچاپ میلیسرچ.حذف وب هوک(ک، hook.uuid، خ)
پایان
