واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    هوک := میلیسرچ.ایجاد وب هوک(کارخواه، "https://example.com/meilisearch-hook"، `{"Authorization": "Bearer hook-secret"}`، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
        برگشت
    پایان
    سرچاپ هوک.شناسه جهانی، هوک.نشانی، هوک.سرآیندها، هوک.قابل ویرایش
    سرچاپ میلیسرچ.دریافت وب هوک(کارخواه، هوک.شناسه جهانی، اشکال).نشانی
    سرچاپ میلیسرچ.به‌روزرسانی وب هوک(کارخواه، هوک.شناسه جهانی، "https://example.com/v2/hook"، ""، اشکال).نشانی
    هر هوکی در میلیسرچ.فهرست وب هوک‌ها(کارخواه، اشکال):
        سرچاپ هوکی.شناسه جهانی، هوکی.نشانی
    پایان
    سرچاپ میلیسرچ.حذف وب هوک(کارخواه، هوک.شناسه جهانی، اشکال)
پایان
