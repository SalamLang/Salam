واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    رسید := میلیسرچ.حذف نمایه(کارخواه، "old_movies"، اشکال)
    رسیدی := میلیسرچ.انتظار برای کار(کارخواه، رسید.شناسه کار، 30000، 100، اشکال)
    سرچاپ رسیدی.شناسه یکتا، رسیدی.شناسه دسته، رسیدی.نمایه، رسیدی.وضعیت، رسیدی.نوع، رسیدی.لغو با، رسیدی.جزئیات، رسیدی.مدت
    سرچاپ رسیدی.زمان صف، رسیدی.زمان شروع، رسیدی.زمان اتمام
    اگر رسیدی.وضعیت برابر میلیسرچ.وضعیت ناموفق:
        سرچاپ رسیدی.خطا.کد، رسیدی.خطا.پیام
    پایان
    سرچاپ میلیسرچ.دریافت کار(کارخواه، رسید.شناسه کار، اشکال).وضعیت

    ناپایا پرسش := میلیسرچ.پرسش کار { حد = 20، از = -1، وارون = درست، صف پس از = "2025-01-01T00:00:00Z" }
    پرسش.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت موفق)
    پرسش.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت ناموفق)
    پرسش.نمایه‌ها.بیفزا("movies")
    پرسش.نوع‌ها.بیفزا("documentAdditionOrUpdate")
    پرسش.شناسه‌های یکتا.بیفزا(1)
    پرسش.شناسه‌های دسته.بیفزا(1)
    پرسش.لغو با.بیفزا(2)
    پرسش.صف پیش از = "2030-01-01T00:00:00Z"
    پرسش.شروع پیش از = "2030-01-01T00:00:00Z"
    پرسش.شروع پس از = "2025-01-01T00:00:00Z"
    پرسش.اتمام پیش از = "2030-01-01T00:00:00Z"
    پرسش.اتمام پس از = "2025-01-01T00:00:00Z"
    صفحه := میلیسرچ.دریافت کارها(کارخواه، پرسش، اشکال)
    سرچاپ صفحه.کل، صفحه.حد، صفحه.از، صفحه.بعدی
    هر کار در صفحه.نتیجه‌ها:
        سرچاپ کار.شناسه یکتا، کار.نوع، کار.وضعیت
    پایان

    ناپایا معوق := میلیسرچ.پرسش کار {}
    معوق.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت در صف)
    معوق.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت در حال پردازش)
    سرچاپ میلیسرچ.لغو کارها(کارخواه، معوق، اشکال).شناسه کار
    ناپایا تمام‌شده := میلیسرچ.پرسش کار {}
    تمام‌شده.وضعیت‌ها.بیفزا(میلیسرچ.وضعیت لغو شده)
    سرچاپ میلیسرچ.حذف کارها(کارخواه، تمام‌شده، اشکال).شناسه کار

    دسته‌ها := میلیسرچ.دریافت دسته‌ها(کارخواه، میلیسرچ.پرسش کار { حد = 5 }، اشکال)
    سرچاپ دسته‌ها.کل، دسته‌ها.حد، دسته‌ها.از، دسته‌ها.بعدی
    هر دسته‌ای در دسته‌ها.نتیجه‌ها:
        تک := میلیسرچ.دریافت دسته(کارخواه، دسته‌ای.شناسه یکتا، اشکال)
        سرچاپ تک.شناسه یکتا، تک.راهبرد دسته، تک.جزئیات، تک.آمار، تک.پیشرفت، تک.مدت، تک.زمان شروع، تک.زمان اتمام
    پایان

    سرچاپ رسیدی.فراداده سفارشی، رسیدی.شبکه، رسید.فراداده سفارشی
    سرچاپ میلیسرچ.دریافت سندهای کار(کارخواه، رسید.شناسه کار، اشکال)
    فشرده‌سازی := میلیسرچ.فشرده‌سازی صف کارها(کارخواه، اشکال)
    سرچاپ فشرده‌سازی.وضعیت، فشرده‌سازی.اندازه قبل، فشرده‌سازی.اندازه بعد، فشرده‌سازی.اقدام لازم، فشرده‌سازی.پیام خطا
پایان
