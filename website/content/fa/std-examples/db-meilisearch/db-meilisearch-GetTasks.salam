واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    ک := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا خ := میلیسرچ.خطا {}

    اطلاعات := میلیسرچ.حذف نمایه(ک، "old_movies"، خ)
    t := میلیسرچ.انتظار برای کار(ک، اطلاعات.task_uid، 30000، 100، خ)
    سرچاپ t.uid، t.batch_uid، t.index_uid، t.status، t.kind، t.canceled_by، t.details، t.duration
    سرچاپ t.enqueued_at، t.started_at، t.finished_at
    اگر t.status برابر میلیسرچ.وضعیت ناموفق:
        سرچاپ t.error.code، t.error.message
    پایان
    سرچاپ میلیسرچ.دریافت کار(ک، اطلاعات.task_uid، خ).status

    ناپایا q := میلیسرچ.پرسش کار { limit = 20، from = -1، reverse = درست، after_enqueued_at = "2025-01-01T00:00:00Z" }
    q.statuses.بیفزا(میلیسرچ.وضعیت موفق)
    q.statuses.بیفزا(میلیسرچ.وضعیت ناموفق)
    q.index_uids.بیفزا("movies")
    q.types.بیفزا("documentAdditionOrUpdate")
    q.uids.بیفزا(1)
    q.batch_uids.بیفزا(1)
    q.canceled_by.بیفزا(2)
    q.before_enqueued_at = "2030-01-01T00:00:00Z"
    q.before_started_at = "2030-01-01T00:00:00Z"
    q.after_started_at = "2025-01-01T00:00:00Z"
    q.before_finished_at = "2030-01-01T00:00:00Z"
    q.after_finished_at = "2025-01-01T00:00:00Z"
    page := میلیسرچ.دریافت کارها(ک، q، خ)
    سرچاپ page.total، page.limit، page.from، page.next
    هر task در page.results:
        سرچاپ task.uid، task.kind، task.status
    پایان

    ناپایا pending := میلیسرچ.پرسش کار {}
    pending.statuses.بیفزا(میلیسرچ.وضعیت در صف)
    pending.statuses.بیفزا(میلیسرچ.وضعیت در حال پردازش)
    سرچاپ میلیسرچ.لغو کارها(ک، pending، خ).task_uid
    ناپایا finished := میلیسرچ.پرسش کار {}
    finished.statuses.بیفزا(میلیسرچ.وضعیت لغو شده)
    سرچاپ میلیسرچ.حذف کارها(ک، finished، خ).task_uid

    batches := میلیسرچ.دریافت دسته‌ها(ک، میلیسرچ.پرسش کار { limit = 5 }، خ)
    سرچاپ batches.total، batches.limit، batches.from، batches.next
    هر b در batches.results:
        one := میلیسرچ.دریافت دسته(ک، b.uid، خ)
        سرچاپ one.uid، one.batch_strategy، one.details، one.stats، one.progress، one.duration، one.started_at، one.finished_at
    پایان

    سرچاپ t.custom_metadata، t.network، اطلاعات.custom_metadata
    سرچاپ میلیسرچ.دریافت سندهای کار(ک، اطلاعات.task_uid، خ)
    comp := میلیسرچ.فشرده‌سازی صف کارها(ک، خ)
    سرچاپ comp.status، comp.pre_size، comp.post_size، comp.action_required، comp.error_message
پایان
