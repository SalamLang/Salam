    ناپایا more := میلیسرچ.درخواست جستجو { query = "space"، show_performance_details = درست، use_network = نادرست، personalize = `{"userContext": "likes old films"}`، inline_rule = `{"actions": {"pin": [{"id": "1", "position": 0}]}}` }
    more.locales.بیفزا("eng")
    detailed := میلیسرچ.جستجو(ک، "movies"، more، خ)
