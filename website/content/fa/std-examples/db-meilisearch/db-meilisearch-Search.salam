    fed := میلیسرچ.جستجوی فدرال(ک، queries، میلیسرچ.فدراسیون { offset = 0، limit = 20، page = -1، hits_per_page = -1، facets_by_index = `{"movies": ["genre"]}`، merge_facets = `{}` }، خ)
    سرچاپ fed.hits.طول()

    ناپایا fr := میلیسرچ.درخواست جستجوی وجه { facet_name = "genre"، facet_query = "dra"، query = "space"، filter = "year > 2000"، matching_strategy = میلیسرچ.تطبیق همه، exhaustive_facet_count = درست }
    fr.attributes_to_search_on.بیفزا("title")
    fs := میلیسرچ.جستجوی وجه(ک، "movies"، fr، خ)
