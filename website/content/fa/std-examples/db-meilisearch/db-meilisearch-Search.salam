واردسازی دیتابیس.میلیسرچ

ساختار Movie:
    همگانی id: صحیح = 0
    همگانی title: رشته = ""
پایان

تابع ریشه:
    ک := میلیسرچ.جدید("http://127.0.0.1:7700"، "searchKey")
    ناپایا خ := میلیسرچ.خطا {}

    quick := میلیسرچ.پرسش(ک، "movies"، "botman"، خ)
    سرچاپ quick.query، quick.estimated_total_hits، quick.processing_time_ms

    ناپایا r := میلیسرچ.درخواست جستجو { query = "space"، limit = 10، offset = 0، filter = "year > 2000 AND genre = Drama" }
    r.facets.بیفزا("genre")
    r.sort.بیفزا("year:desc")
    r.attributes_to_retrieve.بیفزا("id")
    r.attributes_to_retrieve.بیفزا("title")
    r.attributes_to_highlight.بیفزا("title")
    r.highlight_pre_tag = "<mark>"
    r.highlight_post_tag = "</mark>"
    r.attributes_to_crop.بیفزا("overview")
    r.crop_length = 20
    r.crop_marker = "..."
    r.matching_strategy = میلیسرچ.تطبیق همه
    r.show_ranking_score = درست
    r.show_ranking_score_details = نادرست
    r.show_matches_position = نادرست
    r.ranking_score_threshold = 0.2
    r.attributes_to_search_on.بیفزا("title")
    r.locales.بیفزا("eng")
    r.distinct = "studio"
    نتیجه := میلیسرچ.جستجو(ک، "movies"، r، خ)
    اگر وارونه میلیسرچ.موفق(خ):
        سرچاپ میلیسرچ.متن خطا(خ)
        برگشت
    پایان
    سرچاپ نتیجه.index_uid، نتیجه.offset، نتیجه.limit، نتیجه.facet_distribution، نتیجه.facet_stats، نتیجه.raw.طول()
    هر hit در نتیجه.hits:
        سرچاپ hit
    پایان
    ناپایا movies := وکتور {} برگردان وکتور<Movie>
    اگر میلیسرچ.نتایج به نوع(نتیجه، movies، خ):
        سرچاپ movies.طول()
    پایان

    pages := میلیسرچ.جستجو(ک، "movies"، میلیسرچ.درخواست جستجو { query = "space"، page = 2، hits_per_page = 20 }، خ)
    سرچاپ pages.page، pages.hits_per_page، pages.total_hits، pages.total_pages

    ناپایا hybrid := میلیسرچ.درخواست جستجو { query = "a sad robot"، hybrid_embedder = "default"، hybrid_semantic_ratio = 0.7، retrieve_vectors = نادرست، matching_strategy = میلیسرچ.تطبیق آخر }
    hybrid.vector.بیفزا(0.1)
    hybrid.media = `{"image": "https://example.com/robot.png"}`
    hybrid.extra = `{"showPerformanceDetails": true}`
    سرچاپ میلیسرچ.جستجو(ک، "movies"، hybrid، خ).semantic_hit_count، میلیسرچ.تطبیق فراوانی

    ناپایا queries := وکتور {} برگردان وکتور<میلیسرچ.پرسش چندگانه>
    queries.بیفزا(میلیسرچ.پرسش چندگانه { index_uid = "movies"، request = میلیسرچ.درخواست جستجو { query = "moana" } })
    queries.بیفزا(میلیسرچ.پرسش چندگانه { index_uid = "books"، request = میلیسرچ.درخواست جستجو { query = "moana" }، weight = 0.5، remote = "" })
    هر one در میلیسرچ.جستجوی چندگانه(ک، queries، خ):
