    ناپایا fq := میلیسرچ.درخواست جستجوی وجه { facet_name = "genre"، ranking_score_threshold = 0.1، hybrid_embedder = "default"، hybrid_semantic_ratio = 0.5، media = ""، use_network = نادرست }
    fq.locales.بیفزا("eng")
    fq.vector.بیفزا(0.2)
    سرچاپ میلیسرچ.جستجوی وجه(ک، "movies"، fq، خ).remote_errors
    ناپایا posq := وکتور {} برگردان وکتور<میلیسرچ.پرسش چندگانه>
    posq.بیفزا(میلیسرچ.پرسش چندگانه { index_uid = "movies"، request = میلیسرچ.درخواست جستجو { query = "up" }، query_position = 0 })
    سرچاپ میلیسرچ.جستجوی فدرال(ک، posq، میلیسرچ.فدراسیون { distinct = "studio"، personalize = ""، show_performance_details = درست }، خ).hits.طول()
