واردسازی دیتابیس.میلیسرچ

ساختار فیلم:
    همگانی شناسه: صحیح = 0
    همگانی عنوان: رشته = ""
پایان

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "searchKey")
    ناپایا اشکال := میلیسرچ.خطا {}

    سریع := میلیسرچ.پرسش(کارخواه، "movies"، "botman"، اشکال)
    سرچاپ سریع.پرسش، سریع.تخمین کل نتایج، سریع.زمان پردازش

    ناپایا مسیرها := میلیسرچ.درخواست جستجو { پرسش = "space"، حد = 10، جابجایی = 0، فیلتر = "year > 2000 AND genre = Drama" }
    مسیرها.وجه‌ها.بیفزا("ژانر")
    مسیرها.مرتب‌سازی.بیفزا("سال:desc")
    مسیرها.ویژگی‌های بازیابی.بیفزا("شناسه")
    مسیرها.ویژگی‌های بازیابی.بیفزا("عنوان")
    مسیرها.ویژگی‌های برجسته.بیفزا("عنوان")
    مسیرها.برچسب پیش از برجسته = "<mark>"
    مسیرها.برچسب پس از برجسته = "</mark>"
    مسیرها.ویژگی‌های برش.بیفزا("overview")
    مسیرها.طول برش = 20
    مسیرها.نشان برش = "..."
    مسیرها.راهبرد تطبیق = میلیسرچ.تطبیق همه
    مسیرها.نمایش امتیاز = درست
    مسیرها.نمایش جزئیات امتیاز = نادرست
    مسیرها.نمایش جای تطبیق = نادرست
    مسیرها.آستانه امتیاز = 0.2
    مسیرها.ویژگی‌های جستجو.بیفزا("عنوان")
    مسیرها.زبان‌ها.بیفزا("eng")
    مسیرها.متمایز = "studio"
    نتیجه := میلیسرچ.جستجو(کارخواه، "movies"، مسیرها، اشکال)
    اگر وارونه میلیسرچ.موفق(اشکال):
        سرچاپ میلیسرچ.متن خطا(اشکال)
        برگشت
    پایان
    سرچاپ نتیجه.نمایه، نتیجه.جابجایی، نتیجه.حد، نتیجه.توزیع وجه، نتیجه.آمار وجه، نتیجه.خام.طول()
    هر یافته در نتیجه.نتایج:
        سرچاپ یافته
    پایان
    ناپایا فیلم‌ها := وکتور {} برگردان وکتور<فیلم>
    اگر میلیسرچ.نتایج به نوع(نتیجه، فیلم‌ها، اشکال):
        سرچاپ فیلم‌ها.طول()
    پایان

    برگه‌ها := میلیسرچ.جستجو(کارخواه، "movies"، میلیسرچ.درخواست جستجو { پرسش = "space"، شماره صفحه = 2، نتایج صفحه = 20 }، اشکال)
    سرچاپ برگه‌ها.شماره صفحه، برگه‌ها.نتایج صفحه، برگه‌ها.کل نتایج، برگه‌ها.کل صفحه‌ها

    ناپایا ترکیبی := میلیسرچ.درخواست جستجو { پرسش = "a sad robot"، جاساز ترکیبی = "default"، نسبت معنایی = 0.7، بازیابی بردارها = نادرست، راهبرد تطبیق = میلیسرچ.تطبیق آخر }
    ترکیبی.بردار.بیفزا(0.1)
    ترکیبی.رسانه = `{"image": "https://example.com/robot.png"}`
    ترکیبی.افزوده = `{"showPerformanceDetails": true}`
    سرچاپ میلیسرچ.جستجو(کارخواه، "movies"، ترکیبی، اشکال).شمار نتایج معنایی، میلیسرچ.تطبیق فراوانی

    ناپایا پرسش‌ها := وکتور {} برگردان وکتور<میلیسرچ.پرسش چندگانه>
    پرسش‌ها.بیفزا(میلیسرچ.پرسش چندگانه { نمایه = "movies"، درخواست = میلیسرچ.درخواست جستجو { پرسش = "moana" } })
    پرسش‌ها.بیفزا(میلیسرچ.پرسش چندگانه { نمایه = "books"، درخواست = میلیسرچ.درخواست جستجو { پرسش = "moana" }، وزن = 0.5، سرور دور = "" })
    هر تک در میلیسرچ.جستجوی چندگانه(کارخواه، پرسش‌ها، اشکال):
        سرچاپ تک.نمایه، تک.نتایج.طول()
    پایان
    فدرال := میلیسرچ.جستجوی فدرال(کارخواه، پرسش‌ها، میلیسرچ.فدراسیون { جابجایی = 0، حد = 20، شماره صفحه = -1، نتایج صفحه = -1، وجه‌های نمایه‌ها = `{"movies": ["ژانر"]}`، ادغام وجه‌ها = `{}` }، اشکال)
    سرچاپ فدرال.نتایج.طول()

    ناپایا درخواست وجه := میلیسرچ.درخواست جستجوی وجه { نام وجه = "ژانر"، پرسش وجه = "dra"، پرسش = "space"، فیلتر = "year > 2000"، راهبرد تطبیق = میلیسرچ.تطبیق همه، شمارش کامل وجه = درست }
    درخواست وجه.ویژگی‌های جستجو.بیفزا("عنوان")
    نتیجه وجه := میلیسرچ.جستجوی وجه(کارخواه، "movies"، درخواست وجه، اشکال)
    سرچاپ نتیجه وجه.پرسش وجه، نتیجه وجه.زمان پردازش
    هر دستگیره در نتیجه وجه.نتایج:
        سرچاپ دستگیره.مقدار، دستگیره.شمار
    پایان

    ناپایا درخواست مشابه := میلیسرچ.درخواست مشابه { شناسه = "143"، جاساز = "default"، حد = 5، جابجایی = 0، فیلتر = "year > 2000"، نمایش امتیاز = درست، نمایش جزئیات امتیاز = نادرست، آستانه امتیاز = 0.5، بازیابی بردارها = نادرست }
    درخواست مشابه.ویژگی‌های بازیابی.بیفزا("عنوان")
    سرچاپ میلیسرچ.سندهای مشابه(کارخواه، "movies"، درخواست مشابه، اشکال).نتایج.طول()

    ناپایا بیشتر := میلیسرچ.درخواست جستجو { پرسش = "space"، نمایش جزئیات کارایی = درست، استفاده از شبکه = نادرست، شخصی‌سازی = `{"userContext": "likes old films"}`، قاعده درجا = `{"actions": {"pin": [{"شناسه": "1", "position": 0}]}}` }
    بیشتر.زبان‌ها.بیفزا("eng")
    مفصل := میلیسرچ.جستجو(کارخواه، "movies"، بیشتر، اشکال)
    سرچاپ مفصل.شناسه درخواست، مفصل.جزئیات کارایی، مفصل.بردار پرسش، مفصل.خطاهای دور، مفصل.فراداده، مفصل.وجه‌های نمایه‌ها
    ناپایا پرسش وجه := میلیسرچ.درخواست جستجوی وجه { نام وجه = "ژانر"، آستانه امتیاز = 0.1، جاساز ترکیبی = "default"، نسبت معنایی = 0.5، رسانه = ""، استفاده از شبکه = نادرست }
    پرسش وجه.زبان‌ها.بیفزا("eng")
    پرسش وجه.بردار.بیفزا(0.2)
    سرچاپ میلیسرچ.جستجوی وجه(کارخواه، "movies"، پرسش وجه، اشکال).خطاهای دور
    ناپایا پرسش‌های جایگاه := وکتور {} برگردان وکتور<میلیسرچ.پرسش چندگانه>
    پرسش‌های جایگاه.بیفزا(میلیسرچ.پرسش چندگانه { نمایه = "movies"، درخواست = میلیسرچ.درخواست جستجو { پرسش = "up" }، جایگاه پرسش = 0 })
    سرچاپ میلیسرچ.جستجوی فدرال(کارخواه، پرسش‌های جایگاه، میلیسرچ.فدراسیون { متمایز = "studio"، شخصی‌سازی = ""، نمایش جزئیات کارایی = درست }، اشکال).نتایج.طول()
    سرچاپ میلیسرچ.سندهای مشابه(کارخواه، "movies"، میلیسرچ.درخواست مشابه { شناسه = "1"، جاساز = "default"، نمایش جزئیات کارایی = درست }، اشکال).نتایج.طول()
پایان
