واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    ک := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا خ := میلیسرچ.خطا {}
    میلیسرچ.به‌روزرسانی ویژگی‌های آزمایشی(ک، `{"dynamicSearchRules": true}`، خ)

    rule := `{"active": true, "precedence": 1, "conditions": {"query": {"words": "sale"}}, "actions": {"pin": [{"id": "42", "position": 0}]}}`
    میلیسرچ.انتظار(ک، میلیسرچ.به‌روزرسانی قاعده جستجو(ک، "black-friday"، rule، خ)، خ)
    r := میلیسرچ.دریافت قاعده جستجو(ک، "black-friday"، خ)
    سرچاپ r.uid، r.active، r.precedence، r.last_updated_at، r.conditions، r.actions، r.raw.طول()

    page := میلیسرچ.فهرست قاعده‌های جستجو(ک، میلیسرچ.پرسش قاعده جستجو { offset = 0، limit = 20، query = "sale"، active = 1 }، خ)
    سرچاپ page.total، page.offset، page.limit
    هر one در page.results:
        سرچاپ one.uid
    پایان
    میلیسرچ.انتظار(ک، میلیسرچ.حذف قاعده جستجو(ک، "black-friday"، خ)، خ)
    میلیسرچ.انتظار(ک، میلیسرچ.حذف همه قاعده‌های جستجو(ک، خ)، خ)
پایان
