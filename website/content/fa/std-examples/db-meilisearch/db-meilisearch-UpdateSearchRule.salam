واردسازی دیتابیس.میلیسرچ

تابع ریشه:
    کارخواه := میلیسرچ.جدید("http://127.0.0.1:7700"، "masterKey")
    ناپایا اشکال := میلیسرچ.خطا {}
    میلیسرچ.به‌روزرسانی ویژگی‌های آزمایشی(کارخواه، `{"dynamicSearchRules": true}`، اشکال)

    قاعده := `{"active": true, "precedence": 1, "conditions": {"query": {"words": "sale"}}, "actions": {"pin": [{"شناسه": "42", "position": 0}]}}`
    میلیسرچ.انتظار(کارخواه، میلیسرچ.به‌روزرسانی قاعده جستجو(کارخواه، "black-friday"، قاعده، اشکال)، اشکال)
    مسیرها := میلیسرچ.دریافت قاعده جستجو(کارخواه، "black-friday"، اشکال)
    سرچاپ مسیرها.شناسه یکتا، مسیرها.فعال، مسیرها.اولویت، مسیرها.زمان آخرین تغییر، مسیرها.شرط‌ها، مسیرها.کنش‌ها، مسیرها.خام.طول()

    صفحه := میلیسرچ.فهرست قاعده‌های جستجو(کارخواه، میلیسرچ.پرسش قاعده جستجو { جابجایی = 0، حد = 20، پرسش = "sale"، فعال = 1 }، اشکال)
    سرچاپ صفحه.کل، صفحه.جابجایی، صفحه.حد
    هر تک در صفحه.نتیجه‌ها:
        سرچاپ تک.شناسه یکتا
    پایان
    میلیسرچ.انتظار(کارخواه، میلیسرچ.حذف قاعده جستجو(کارخواه، "black-friday"، اشکال)، اشکال)
    میلیسرچ.انتظار(کارخواه، میلیسرچ.حذف همه قاعده‌های جستجو(کارخواه، اشکال)، اشکال)
پایان
