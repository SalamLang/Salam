واردسازی دیتابیس
واردسازی دیتابیس.مای اس کیو ال

روال ریشه:
    اگر وارونه مای اس کیو ال.در دسترس():
        سرچاپ "کتابخانه‌ی MySQL نصب نیست"
        برگشت
    پایان
    _ := مای اس کیو ال.آماده سازی کتابخانه()
    _ := مای اس کیو ال.آماده سازی نخ()
    سرچاپ مای اس کیو ال.نسخه کلاینت()
    پ := مای اس کیو ال.بازکردن("127.0.0.1"، "app"، "s3cret"، "shop"، ۳۳۰۶)
    اگر وارونه مای اس کیو ال.معتبر(پ):
        سرچاپ مای اس کیو ال.کدخطا(پ)، مای اس کیو ال.خطا(پ)
        برگشت
    پایان
    سرچاپ مای اس کیو ال.نسخه سرور(پ)، مای اس کیو ال.پینگ(پ)
    _ := مای اس کیو ال.تنظیم کدینگ(پ، "utf8mb4")
    _ := مای اس کیو ال.انتخاب پایگاه داده(پ، "shop")
    نام := مای اس کیو ال.اسکیپ(پ، "O'Brien")
    _ := مای اس کیو ال.اجرا(پ، "INSERT INTO customers (name) VALUES ('" + نام + "')")
    سرچاپ مای اس کیو ال.شناسه آخرین درج(پ)، مای اس کیو ال.ردیف های تحت تاثیر(پ)، مای اس کیو ال.تعداد تغییرات(پ)

    _ := مای اس کیو ال.ثبت خودکار(پ، نادرست)
    _ := مای اس کیو ال.شروع تراکنش(پ)
    _ := مای اس کیو ال.اجرا(پ، "UPDATE products SET stock = stock - 1 WHERE id = 7")
    اگر مای اس کیو ال.پرسمان عدد(پ، "SELECT stock FROM products WHERE id = 7") < ۰:
        _ := مای اس کیو ال.بازگردانی(پ)
    وگرنه:
        _ := مای اس کیو ال.ثبت تراکنش(پ)
    پایان

    ناپایا ن := مای اس کیو ال.پرسمان(پ، "SELECT id, name, price, note FROM products")
    اگر مای اس کیو ال.پرسمان معتبر(ن):
        سرچاپ مای اس کیو ال.تعداد ستون(ن)، مای اس کیو ال.تعداد ردیف(ن)، مای اس کیو ال.نام ستون(ن، ۱)
        تا مای اس کیو ال.بعدی(ن):
            سرچاپ مای اس کیو ال.عدد صحیح(ن، ۰)، مای اس کیو ال.متن(ن، ۱)، مای اس کیو ال.عدد اعشار(ن، ۲)، مای اس کیو ال.عدد صحیح۶۴(ن، ۰)، مای اس کیو ال.خالی است(ن، ۳)
        پایان
        مای اس کیو ال.پایان(ن)
    پایان
    سرچاپ مای اس کیو ال.پرسمان متن(پ، "SELECT VERSION()")

    ا := مای اس کیو ال.اتصال(پ)
    سرچاپ ا.نوع()، دیتابیس.پرسمان عدد(ا، "SELECT COUNT(*) FROM products")
    سرچاپ پ.نوع()، پ.پینگ()، پ.نقل قول("x'y")
    ر := پ.پرسمان("SELECT name FROM customers")
    تا ر.بعدی():
        سرچاپ ر.متن(۰)
    پایان
    _ := ر.بستن()
    مای اس کیو ال.بستن(پ)
    مای اس کیو ال.پایان نخ()
    مای اس کیو ال.پایان کتابخانه()
    _ := مای اس کیو ال.بازکردن کامل("localhost"، "app"، "s3cret"، "shop"، ۰، "/tmp/mysql.sock"، ۰ برگردان طبیعی۶۴)
پایان
