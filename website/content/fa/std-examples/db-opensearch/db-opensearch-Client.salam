واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ناپایا تنظیم := اپن سرچ.پیکربندی پیش‌فرض()
    تنظیم.nodes.بیفزا("https://node2.example.com:9200, https://node3.example.com:9200")
    تنظیم.username = "admin"
    تنظیم.password = "S3cret-pass!"
    تنظیم.ca_file = "/etc/ssl/certs/opensearch-ca.pem"
    تنظیم.timeout_ms = 10000
    تنظیم.max_retries = 2
    تنظیم.headers.درج("X-Opaque-Id"، "shop-api")
    ناپایا ک := اپن سرچ.کارخواه تازه(تنظیم)
    اگر وارونه اپن سرچ.معتبر(ک):
        سرچاپ اپن سرچ.خطا(ک)
        برگشت 1
    پایان
    سرچاپ اپن سرچ.گره‌ها(ک)، اپن سرچ.سرآیند احراز(ک).طول() بزرگتر 0، اپن سرچ.نسخه کارخواه
    سرچاپ اپن سرچ.پینگ(ک)

    آگاهی := اپن سرچ.دریافت اطلاعات(ک)
    سرچاپ آگاهی.ok، آگاهی.name، آگاهی.cluster_name، آگاهی.cluster_uuid، آگاهی.version، آگاهی.distribution
    سرچاپ آگاهی.build_type، آگاهی.lucene_version، آگاهی.minimum_wire_compatibility_version، آگاهی.tagline

    ر := اپن سرچ.انجام(ک، "GET"، "/_cat/health?format=json"، "")
    سرچاپ ر.ok، ر.status، ر.body
    اگر وارونه ر.ok:
        سرچاپ ر.error، ر.error_type، ر.error_reason
    پایان
    چندخطی := اپن سرچ.انجام چندخطی(ک، "POST"، "/_bulk"، "{\"delete\":{\"_index\":\"shop\",\"_id\":\"1\"}}\n")
    سرچاپ چندخطی.status، اپن سرچ.وضعیت(ک)، اپن سرچ.نوع خطا(ک)، اپن سرچ.علت خطا(ک)
    متنی := اپن سرچ.انجام متنی(ک، "POST"، "/_plugins/_sql?format=csv"، `{"query":"SELECT 1"}`، "application/json")
    سرچاپ متنی.body
    اپن سرچ.بستن(ک)

    ناپایا محلی := اپن سرچ.اتصال(اپن سرچ.نشانی پیش‌فرض)
    سرچاپ اپن سرچ.معتبر(محلی)، اپن سرچ.درگاه پیش‌فرض، اپن سرچ.مهلت گره از کار افتاده
    اپن سرچ.بستن(محلی)
    ناپایا نمایشی := اپن سرچ.اتصال بدون وارسی گواهی("https://localhost:9200"، "admin"، "S3cret-pass!")
    اپن سرچ.بستن(نمایشی)
    ناپایا احراز := اپن سرچ.اتصال با رمز("https://search.example.com"، "reader"، "pass")
    سرچاپ اپن سرچ.کدگذاری پایه("reader"، "pass")
    اپن سرچ.بستن(احراز)

    ناپایا آمازون := اپن سرچ.اتصال آمازون(
        "https://search-shop.eu-west-1.es.amazonaws.com"، "eu-west-1"، اپن سرچ.سرویس دامنه،
        "AKIAEXAMPLE"، "secret-key"، ""
    )
    اپن سرچ.تنظیم زمان امضا(آمازون، 1700000000 برگردان صحیح۶۴)
    سرچاپ اپن سرچ.سلامت خوشه(آمازون).status
    اپن سرچ.بستن(آمازون)
    ناپایا بی‌سرور := اپن سرچ.اتصال آمازون(
        "https://abc123.eu-west-1.aoss.amazonaws.com"، "eu-west-1"، اپن سرچ.سرویس بی‌سرور،
        "AKIAEXAMPLE"، "secret-key"، "session-token"
    )
    اپن سرچ.بستن(بی‌سرور)
    برگشت 0
پایان
