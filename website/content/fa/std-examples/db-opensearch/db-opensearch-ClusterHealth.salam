واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    c := اپن سرچ.اتصال("http://localhost:9200")
    h := اپن سرچ.سلامت خوشه(c)
    سرچاپ h.ok، h.cluster_name، h.status، h.timed_out، h.nodes، h.data_nodes، h.active_primary_shards
    سرچاپ h.active_shards، h.relocating_shards، h.initializing_shards، h.unassigned_shards، h.pending_tasks، h.active_shards_percent
    سرچاپ اپن سرچ.انتظار وضعیت(c، "books"، "yellow"، "30s").status
    سرچاپ اپن سرچ.آمار خوشه(c).طول() بزرگتر 0، اپن سرچ.حالت خوشه(c، "metadata").طول() بزرگتر 0
    سرچاپ اپن سرچ.تنظیم تنظیمات خوشه(c، `{"cluster.routing.allocation.enable":"all"}`، "")
    سرچاپ اپن سرچ.دریافت تنظیمات خوشه(c)
    سرچاپ اپن سرچ.توضیح تخصیص(c، `{"index":"books","shard":0,"primary":true}`).طول()
    سرچاپ اپن سرچ.اطلاعات گره‌ها(c، "os").طول() بزرگتر 0، اپن سرچ.آمار گره‌ها(c، "jvm").طول() بزرگتر 0، اپن سرچ.نخ‌های پرکار(c).طول() بزرگتر 0
    هر row در اپن سرچ.فهرست(c، "shards?h=index,shard,state"):
        سرچاپ row
    پایان
    سرچاپ اپن سرچ.فهرست متنی(c، "nodes")، اپن سرچ.افزونه‌ها(c)، اپن سرچ.دارای افزونه(c، "opensearch-knn")

    rx := اپن سرچ.نمایه‌سازی دوباره با بدنه(c، `{"source":{"index":"books"},"dest":{"index":"books_v4"}}`، نادرست)
    t := اپن سرچ.دریافت کار(c، rx.task)
    سرچاپ t.ok، t.id، t.completed، t.action، t.description، t.status، t.response، t.error
    سرچاپ اپن سرچ.انتظار کار(c، rx.task، "60s").completed، اپن سرچ.لغو کار(c، rx.task)
    سرچاپ اپن سرچ.فهرست کارها(c، "*reindex").طول() بزرگتر 0

    سرچاپ اپن سرچ.تنظیم مخزن(c، "backups"، "fs"، `{"location":"/mnt/backups"}`)، اپن سرچ.وارسی مخزن(c، "backups")
    سرچاپ اپن سرچ.دریافت مخزن(c، "backups")، اپن سرچ.ایجاد تصویر لحظه‌ای(c، "backups"، "nightly-1"، "books"، درست)
    سرچاپ اپن سرچ.تصویرهای لحظه‌ای(c، "backups")، اپن سرچ.دریافت تصویر لحظه‌ای(c، "backups"، "nightly-1").طول() بزرگتر 0
    سرچاپ اپن سرچ.وضعیت تصویر لحظه‌ای(c، "backups"، "nightly-1").طول() بزرگتر 0
    سرچاپ اپن سرچ.بازیابی تصویر لحظه‌ای(c، "backups"، "nightly-1"، `{"indices":"books","rename_pattern":"(.+)","rename_replacement":"restored_$1"}`، درست)
    سرچاپ اپن سرچ.حذف تصویر لحظه‌ای(c، "backups"، "nightly-1")، اپن سرچ.حذف مخزن(c، "backups")

    ناپایا procs := وکتور {} برگردان وکتور<رشته>
    procs.بیفزا(اپن سرچ.پردازنده("lowercase"، `{"field":"tag"}`))
    procs.بیفزا(اپن سرچ.پردازنده("set"، `{"field":"seen","value":true}`))
    سرچاپ اپن سرچ.تنظیم خط لوله(c، "clean"، اپن سرچ.خط لوله("tidy incoming books"، procs))
    ناپایا docs := وکتور {} برگردان وکتور<رشته>
    docs.بیفزا(`{"tag":"POETRY"}`)
    سرچاپ اپن سرچ.شبیه‌سازی خط لوله(c، "clean"، docs)، اپن سرچ.دریافت خط لوله(c، "clean").طول() بزرگتر 0
    سرچاپ اپن سرچ.حذف خط لوله(c، "clean")

    سرچاپ اپن سرچ.تنظیم اسکریپت(c، "double"، "doc['stock'].value * 2")، اپن سرچ.دریافت اسکریپت(c، "double")
    سرچاپ اپن سرچ.تنظیم الگوی جستجو(c، "by_tag"، `{"query":{"term":{"tag":"{{tag}}"}}}`)، اپن سرچ.حذف اسکریپت(c، "by_tag")، اپن سرچ.حذف اسکریپت(c، "double")
