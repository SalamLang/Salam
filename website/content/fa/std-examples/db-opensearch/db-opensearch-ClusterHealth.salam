واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    ه := اپن سرچ.سلامت خوشه(ک)
    سرچاپ ه.ok، ه.cluster_name، ه.status، ه.timed_out، ه.nodes، ه.data_nodes، ه.active_primary_shards
    سرچاپ ه.active_shards، ه.relocating_shards، ه.initializing_shards، ه.unassigned_shards، ه.pending_tasks، ه.active_shards_percent
    سرچاپ اپن سرچ.انتظار وضعیت(ک، "books"، "yellow"، "30s").status
    سرچاپ اپن سرچ.آمار خوشه(ک).طول() بزرگتر 0، اپن سرچ.حالت خوشه(ک، "metadata").طول() بزرگتر 0
    سرچاپ اپن سرچ.تنظیم تنظیمات خوشه(ک، `{"cluster.routing.allocation.enable":"all"}`، "")
    سرچاپ اپن سرچ.دریافت تنظیمات خوشه(ک)
    سرچاپ اپن سرچ.توضیح تخصیص(ک، `{"index":"books","shard":0,"primary":true}`).طول()
    سرچاپ اپن سرچ.اطلاعات گره‌ها(ک، "os").طول() بزرگتر 0، اپن سرچ.آمار گره‌ها(ک، "jvm").طول() بزرگتر 0، اپن سرچ.نخ‌های پرکار(ک).طول() بزرگتر 0
    هر ردیف در اپن سرچ.فهرست(ک، "shards?h=index,shard,state"):
        سرچاپ ردیف
    پایان
    سرچاپ اپن سرچ.فهرست متنی(ک، "nodes")، اپن سرچ.افزونه‌ها(ک)، اپن سرچ.دارای افزونه(ک، "opensearch-knn")

    بازنمایه := اپن سرچ.نمایه‌سازی دوباره با بدنه(ک، `{"source":{"index":"books"},"dest":{"index":"books_v4"}}`، نادرست)
    ت := اپن سرچ.دریافت کار(ک، بازنمایه.task)
    سرچاپ ت.ok، ت.id، ت.completed، ت.action، ت.description، ت.status، ت.response، ت.error
    سرچاپ اپن سرچ.انتظار کار(ک، بازنمایه.task، "60s").completed، اپن سرچ.لغو کار(ک، بازنمایه.task)
    سرچاپ اپن سرچ.فهرست کارها(ک، "*reindex").طول() بزرگتر 0

    سرچاپ اپن سرچ.تنظیم مخزن(ک، "backups"، "fs"، `{"location":"/mnt/backups"}`)، اپن سرچ.وارسی مخزن(ک، "backups")
    سرچاپ اپن سرچ.دریافت مخزن(ک، "backups")، اپن سرچ.ایجاد تصویر لحظه‌ای(ک، "backups"، "nightly-1"، "books"، درست)
    سرچاپ اپن سرچ.تصویرهای لحظه‌ای(ک، "backups")، اپن سرچ.دریافت تصویر لحظه‌ای(ک، "backups"، "nightly-1").طول() بزرگتر 0
    سرچاپ اپن سرچ.وضعیت تصویر لحظه‌ای(ک، "backups"، "nightly-1").طول() بزرگتر 0
    سرچاپ اپن سرچ.بازیابی تصویر لحظه‌ای(ک، "backups"، "nightly-1"، `{"indices":"books","rename_pattern":"(.+)","rename_replacement":"restored_$1"}`، درست)
    سرچاپ اپن سرچ.حذف تصویر لحظه‌ای(ک، "backups"، "nightly-1")، اپن سرچ.حذف مخزن(ک، "backups")

    ناپایا پردازنده‌ها := وکتور {} برگردان وکتور<رشته>
    پردازنده‌ها.بیفزا(اپن سرچ.پردازنده("lowercase"، `{"field":"tag"}`))
    پردازنده‌ها.بیفزا(اپن سرچ.پردازنده("set"، `{"field":"seen","value":true}`))
    سرچاپ اپن سرچ.تنظیم خط لوله(ک، "clean"، اپن سرچ.خط لوله("tidy incoming books"، پردازنده‌ها))
    ناپایا سندها := وکتور {} برگردان وکتور<رشته>
    سندها.بیفزا(`{"tag":"POETRY"}`)
    سرچاپ اپن سرچ.شبیه‌سازی خط لوله(ک، "clean"، سندها)، اپن سرچ.دریافت خط لوله(ک، "clean").طول() بزرگتر 0
    سرچاپ اپن سرچ.حذف خط لوله(ک، "clean")

    سرچاپ اپن سرچ.تنظیم اسکریپت(ک، "double"، "doc['stock'].value * 2")، اپن سرچ.دریافت اسکریپت(ک، "double")
    سرچاپ اپن سرچ.تنظیم الگوی جستجو(ک، "by_tag"، `{"query":{"term":{"tag":"{{tag}}"}}}`)، اپن سرچ.حذف اسکریپت(ک، "by_tag")، اپن سرچ.حذف اسکریپت(ک، "double")
