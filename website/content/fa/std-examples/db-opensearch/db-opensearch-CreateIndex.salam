واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    c := اپن سرچ.اتصال("http://localhost:9200")
    ناپایا props := وکتور {} برگردان وکتور<رشته>
    props.بیفزا(اپن سرچ.ویژگی("title"، "text"))
    props.بیفزا(اپن سرچ.ویژگی با گزینه("title_fa"، "text"، `{"analyzer":"persian"}`))
    props.بیفزا(اپن سرچ.ویژگی("tag"، "keyword"))
    props.بیفزا(اپن سرچ.ویژگی("year"، "integer"))
    سرچاپ اپن سرچ.ایجاد نمایه با تنظیمات(c، "books"، 1، 0، اپن سرچ.ویژگی‌ها(props))
    سرچاپ اپن سرچ.ایجاد نمایه(c، "logs-000001"، `{"aliases":{"logs":{"is_write_index":true}}}`)
    سرچاپ اپن سرچ.وجود نمایه(c، "books")، اپن سرچ.دریافت نمایه(c، "books").طول() بزرگتر 0
    سرچاپ اپن سرچ.تنظیم نگاشت(c، "books"، "{" + اپن سرچ.ویژگی("isbn"، "keyword") + "}")
    سرچاپ اپن سرچ.تنظیم نگاشت با بدنه(c، "books"، `{"dynamic":"strict"}`)، اپن سرچ.دریافت نگاشت(c، "books")
    سرچاپ اپن سرچ.تنظیم تنظیمات(c، "books"، `{"index":{"refresh_interval":"5s"}}`)
    سرچاپ اپن سرچ.دریافت تنظیمات(c، "books").طول() بزرگتر 0، اپن سرچ.دریافت یک تنظیم(c، "books"، "index.refresh_interval")
    سرچاپ اپن سرچ.تازه‌سازی(c، "books")، اپن سرچ.تخلیه(c، "books")، اپن سرچ.ادغام اجباری(c، "books"، 1)، اپن سرچ.پاک‌سازی حافظه نهان(c، "books")
    سرچاپ اپن سرچ.بستن نمایه(c، "books")، اپن سرچ.گشودن نمایه(c، "books")
    سرچاپ اپن سرچ.تنظیم تنظیمات(c، "books"، `{"index.blocks.write":true}`)
    سرچاپ اپن سرچ.همسان‌سازی نمایه(c، "books"، "books_clone"، "")، اپن سرچ.کوچک‌سازی نمایه(c، "books"، "books_small"، "")، اپن سرچ.شکافتن نمایه(c، "books"، "books_big"، `{"settings":{"index.number_of_shards":2}}`)
    سرچاپ اپن سرچ.آمار نمایه(c، "books").طول() بزرگتر 0

    سرچاپ اپن سرچ.افزودن نام مستعار(c، "books"، "library")، اپن سرچ.وجود نام مستعار(c، "library")، اپن سرچ.نمایه‌های نام مستعار(c، "library")
    سرچاپ اپن سرچ.افزودن نام مستعار پالایش شده(c، "books"، "poetry"، اپن سرچ.واژه("tag"، "poetry")، نادرست)
    سرچاپ اپن سرچ.دریافت نام‌های مستعار(c، "books")، اپن سرچ.حذف نام مستعار(c، "books"، "poetry")
    ناپایا acts := وکتور {} برگردان وکتور<رشته>
    acts.بیفزا(اپن سرچ.کنش نام مستعار("add"، "books_clone"، "library"))
    acts.بیفزا(اپن سرچ.کنش نام مستعار("remove"، "books"، "library"))
    سرچاپ اپن سرچ.به‌روزرسانی نام‌های مستعار(c، acts)، اپن سرچ.جابجایی نام مستعار(c، "library"، "books_clone"، "books")

    ناپایا patterns := وکتور {} برگردان وکتور<رشته>
    patterns.بیفزا("logs-*")
    tpl := اپن سرچ.الگوی نمایه(patterns، `{"number_of_replicas":0}`، "{" + اپن سرچ.ویژگی("msg"، "text") + "}"، 10)
    سرچاپ اپن سرچ.تنظیم الگوی نمایه(c، "logs"، tpl)، اپن سرچ.وجود الگوی نمایه(c، "logs")، اپن سرچ.دریافت الگوی نمایه(c، "logs").طول() بزرگتر 0
    سرچاپ اپن سرچ.تنظیم الگوی جزء(c، "base"، `{"template":{"settings":{"number_of_shards":1}}}`)، اپن سرچ.دریافت الگوی جزء(c، "base").طول() بزرگتر 0
    سرچاپ اپن سرچ.چرخش نمایه(c، "logs"، `{"max_docs":1000000,"max_age":"7d"}`)
    سرچاپ اپن سرچ.تنظیم الگوی نمایه(c، "events"، `{"index_patterns":["events-*"],"data_stream":{}}`)
    سرچاپ اپن سرچ.ایجاد جریان داده(c، "events-web")، اپن سرچ.جریان‌های داده(c)، اپن سرچ.حذف جریان داده(c، "events-web")
    سرچاپ اپن سرچ.تحلیل متن(c، ""، "standard"، "Salam to OpenSearch")
    هر ix در اپن سرچ.فهرست نمایه‌ها(c، "books*"):
        سرچاپ ix.health، ix.status، ix.index، ix.uuid، ix.primaries، ix.replicas، ix.docs_count، ix.docs_deleted، ix.store_size
    پایان
    سرچاپ اپن سرچ.حذف الگوی نمایه(c، "logs")، اپن سرچ.حذف الگوی نمایه(c، "events")، اپن سرچ.حذف الگوی جزء(c، "base")
    سرچاپ اپن سرچ.حذف نمایه(c، "books_clone,books_small,books_big")، اپن سرچ.حذف نمایه موجود(c، "never-made")
