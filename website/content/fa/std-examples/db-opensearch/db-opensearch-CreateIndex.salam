واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    ناپایا ویژگی‌ها := وکتور {} برگردان وکتور<رشته>
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی("title"، "text"))
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی با گزینه("title_fa"، "text"، `{"analyzer":"persian"}`))
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی("tag"، "keyword"))
    ویژگی‌ها.بیفزا(اپن سرچ.ویژگی("year"، "integer"))
    سرچاپ اپن سرچ.ایجاد نمایه با تنظیمات(ک، "books"، 1، 0، اپن سرچ.ویژگی‌ها(ویژگی‌ها))
    سرچاپ اپن سرچ.ایجاد نمایه(ک، "logs-000001"، `{"aliases":{"logs":{"is_write_index":true}}}`)
    سرچاپ اپن سرچ.وجود نمایه(ک، "books")، اپن سرچ.دریافت نمایه(ک، "books").طول() بزرگتر 0
    سرچاپ اپن سرچ.تنظیم نگاشت(ک، "books"، "{" + اپن سرچ.ویژگی("isbn"، "keyword") + "}")
    سرچاپ اپن سرچ.تنظیم نگاشت با بدنه(ک، "books"، `{"dynamic":"strict"}`)، اپن سرچ.دریافت نگاشت(ک، "books")
    سرچاپ اپن سرچ.تنظیم تنظیمات(ک، "books"، `{"index":{"refresh_interval":"5s"}}`)
    سرچاپ اپن سرچ.دریافت تنظیمات(ک، "books").طول() بزرگتر 0، اپن سرچ.دریافت یک تنظیم(ک، "books"، "index.refresh_interval")
    سرچاپ اپن سرچ.تازه‌سازی(ک، "books")، اپن سرچ.تخلیه(ک، "books")، اپن سرچ.ادغام اجباری(ک، "books"، 1)، اپن سرچ.پاک‌سازی حافظه نهان(ک، "books")
    سرچاپ اپن سرچ.بستن نمایه(ک، "books")، اپن سرچ.گشودن نمایه(ک، "books")
    سرچاپ اپن سرچ.تنظیم تنظیمات(ک، "books"، `{"index.blocks.write":true}`)
    سرچاپ اپن سرچ.همسان‌سازی نمایه(ک، "books"، "books_clone"، "")، اپن سرچ.کوچک‌سازی نمایه(ک، "books"، "books_small"، "")، اپن سرچ.شکافتن نمایه(ک، "books"، "books_big"، `{"settings":{"index.number_of_shards":2}}`)
    سرچاپ اپن سرچ.آمار نمایه(ک، "books").طول() بزرگتر 0

    سرچاپ اپن سرچ.افزودن نام مستعار(ک، "books"، "library")، اپن سرچ.وجود نام مستعار(ک، "library")، اپن سرچ.نمایه‌های نام مستعار(ک، "library")
    سرچاپ اپن سرچ.افزودن نام مستعار پالایش شده(ک، "books"، "poetry"، اپن سرچ.واژه("tag"، "poetry")، نادرست)
    سرچاپ اپن سرچ.دریافت نام‌های مستعار(ک، "books")، اپن سرچ.حذف نام مستعار(ک، "books"، "poetry")
    ناپایا کنش‌های نام := وکتور {} برگردان وکتور<رشته>
    کنش‌های نام.بیفزا(اپن سرچ.کنش نام مستعار("add"، "books_clone"، "library"))
    کنش‌های نام.بیفزا(اپن سرچ.کنش نام مستعار("remove"، "books"، "library"))
    سرچاپ اپن سرچ.به‌روزرسانی نام‌های مستعار(ک، کنش‌های نام)، اپن سرچ.جابجایی نام مستعار(ک، "library"، "books_clone"، "books")

    ناپایا الگوها := وکتور {} برگردان وکتور<رشته>
    الگوها.بیفزا("logs-*")
    الگو := اپن سرچ.الگوی نمایه(الگوها، `{"number_of_replicas":0}`، "{" + اپن سرچ.ویژگی("msg"، "text") + "}"، 10)
    سرچاپ اپن سرچ.تنظیم الگوی نمایه(ک، "logs"، الگو)، اپن سرچ.وجود الگوی نمایه(ک، "logs")، اپن سرچ.دریافت الگوی نمایه(ک، "logs").طول() بزرگتر 0
    سرچاپ اپن سرچ.تنظیم الگوی جزء(ک، "base"، `{"template":{"settings":{"number_of_shards":1}}}`)، اپن سرچ.دریافت الگوی جزء(ک، "base").طول() بزرگتر 0
    سرچاپ اپن سرچ.چرخش نمایه(ک، "logs"، `{"max_docs":1000000,"max_age":"7d"}`)
    سرچاپ اپن سرچ.تنظیم الگوی نمایه(ک، "events"، `{"index_patterns":["events-*"],"data_stream":{}}`)
    سرچاپ اپن سرچ.ایجاد جریان داده(ک، "events-web")، اپن سرچ.جریان‌های داده(ک)، اپن سرچ.حذف جریان داده(ک، "events-web")
    سرچاپ اپن سرچ.تحلیل متن(ک، ""، "standard"، "Salam to OpenSearch")
    هر نمایه در اپن سرچ.فهرست نمایه‌ها(ک، "books*"):
        سرچاپ نمایه.health، نمایه.status، نمایه.index، نمایه.uuid، نمایه.primaries، نمایه.replicas، نمایه.docs_count، نمایه.docs_deleted، نمایه.store_size
    پایان
    سرچاپ اپن سرچ.حذف الگوی نمایه(ک، "logs")، اپن سرچ.حذف الگوی نمایه(ک، "events")، اپن سرچ.حذف الگوی جزء(ک، "base")
    سرچاپ اپن سرچ.حذف نمایه(ک، "books_clone,books_small,books_big")، اپن سرچ.حذف نمایه موجود(ک، "never-made")
