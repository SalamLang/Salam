واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    ن := اپن سرچ.نمایه‌سازی(ک، "books"، "1"، `{"title":"The Book of Kings","year":1010,"stock":3}`)
    سرچاپ ن.ok، ن.status، ن.index، ن.id، ن.result، ن.version، ن.seq_no، ن.primary_term
    سرچاپ ن.shards_total، ن.shards_successful، ن.error
    خودکار := اپن سرچ.نمایه‌سازی با گزینه(ک، "books"، ""، `{"title":"Masnavi"}`، اپن سرچ.گزینه‌ها { refresh = اپن سرچ.تازه‌سازی با انتظار، routing = "poetry" })
    سرچاپ خودکار.id
    تکراری := اپن سرچ.ایجاد سند(ک، "books"، "1"، `{"title":"again"}`)
    سرچاپ تکراری.ok، تکراری.status
    لوله‌شده := اپن سرچ.ایجاد سند با گزینه(ک، "books"، "2"، `{"title":"Golestan"}`، اپن سرچ.گزینه‌ها { pipeline = "clean"، timeout = "5s"، wait_for_active_shards = "1" })
    سرچاپ لوله‌شده.result

    د := اپن سرچ.دریافت(ک، "books"، "1")
    سرچاپ د.found، د.index، د.id، د.version، د.seq_no، د.primary_term، د.routing، د.source، د.fields، د.error
    ناپایا فقط := وکتور {} برگردان وکتور<رشته>
    فقط.بیفزا("title")
    سرچاپ اپن سرچ.دریافت فیلدها(ک، "books"، "1"، فقط، "").source
    سرچاپ اپن سرچ.دریافت منبع(ک، "books"، "1")، اپن سرچ.وجود سند(ک، "books"، "1")

    سرچاپ اپن سرچ.به‌روزرسانی(ک، "books"، "1"، `{"stock":2}`).result
    شرطی := اپن سرچ.به‌روزرسانی با گزینه(ک، "books"، "1"، `{"doc":{"stock":1}}`، اپن سرچ.گزینه‌ها { if_seq_no = د.seq_no، if_primary_term = د.primary_term، retry_on_conflict = -1 })
    سرچاپ شرطی.ok، اپن سرچ.نوع خطا(ک)
    سرچاپ اپن سرچ.به‌روزرسانی درجی(ک، "books"، "9"، `{"title":"Shahnameh","stock":1}`).result
    سرچاپ اپن سرچ.به‌روزرسانی اسکریپتی(ک، "books"، "1"، اپن سرچ.اسکریپت("ctx._source.stock += params.n"، `{"n":5}`)، `{"stock":5}`).result
    سرچاپ اپن سرچ.حذف سند با گزینه(ک، "books"، "9"، اپن سرچ.گزینه‌ها { refresh = اپن سرچ.تازه‌سازی فوری، version = 3، version_type = "external" }).result
    سرچاپ اپن سرچ.حذف سند(ک، "books"، "2").result

    ناپایا شناسه‌ها := وکتور {} برگردان وکتور<رشته>
    شناسه‌ها.بیفزا("1")
    شناسه‌ها.بیفزا("404")
    هر سند در اپن سرچ.دریافت چندگانه(ک، "books"، شناسه‌ها):
        سرچاپ سند.id، سند.found
    پایان
    سرچاپ اپن سرچ.شمارش(ک، "books"، "")، اپن سرچ.شمارش(ک، "books"، اپن سرچ.بازه("year"، "1000"، ""))

    ناپایا ب := اپن سرچ.دسته‌ای تازه()
    اپن سرچ.نمایه‌سازی دسته‌ای(ب، "books"، "10"، `{"title":"Divan"}`)
    اپن سرچ.نمایه‌سازی دسته‌ای مسیردار(ب، "books"، "11"، "poetry"، `{"title":"Rubaiyat"}`)
    اپن سرچ.ایجاد دسته‌ای(ب، "books"، ""، `{"title":"Bustan"}`)
    اپن سرچ.به‌روزرسانی دسته‌ای(ب، "books"، "10"، `{"stock":4}`)
    اپن سرچ.به‌روزرسانی درجی دسته‌ای(ب، "books"، "12"، `{"title":"Kalila"}`)
    اپن سرچ.حذف دسته‌ای(ب، "books"، "3")
    سرچاپ اپن سرچ.اندازه دسته‌ای(ب)، ب.count، ب.lines.طول()
    چاپ اپن سرچ.بدنه دسته‌ای(ب)
    نتیجه دسته := اپن سرچ.ارسال دسته‌ای با تازه‌سازی(ک، ب، اپن سرچ.بدون تازه‌سازی)
    سرچاپ نتیجه دسته.ok، نتیجه دسته.status، نتیجه دسته.took، نتیجه دسته.errors، نتیجه دسته.succeeded، نتیجه دسته.failed، نتیجه دسته.error
    هر قلم در نتیجه دسته.items:
        سرچاپ قلم.action، قلم.index، قلم.id، قلم.status، قلم.ok، قلم.result، قلم.version، قلم.error_type، قلم.error_reason
    پایان
    اپن سرچ.بازنشانی دسته‌ای(ب)
    اپن سرچ.نمایه‌سازی دسته‌ای(ب، "books"، "13"، `{"title":"Makhzan"}`)
    سرچاپ اپن سرچ.ارسال دسته‌ای(ک، ب).ok
    اپن سرچ.آزادسازی دسته‌ای(ب)
    سرچاپ اپن سرچ.تجزیه دسته‌ای(`{"took":1,"errors":false,"items":[]}`).ok

    به‌روزشده‌ها := اپن سرچ.به‌روزرسانی پرسمانی(ک، "books"، اپن سرچ.واژه("stock"، "0")، اپن سرچ.اسکریپت("ctx._source.out = true"، ""))
    سرچاپ به‌روزشده‌ها.ok، به‌روزشده‌ها.status، به‌روزشده‌ها.took، به‌روزشده‌ها.timed_out، به‌روزشده‌ها.total، به‌روزشده‌ها.updated، به‌روزشده‌ها.batches، به‌روزشده‌ها.version_conflicts، به‌روزشده‌ها.noops، به‌روزشده‌ها.failures
    به‌روزشده‌ها۲ := اپن سرچ.به‌روزرسانی پرسمانی با گزینه(ک، "books"، ""، ""، اپن سرچ.گزینه‌ها { conflicts = "proceed"، pipeline = "clean" })
    سرچاپ به‌روزشده‌ها۲.updated
    حذف‌شده‌ها := اپن سرچ.حذف پرسمانی(ک، "books"، اپن سرچ.واژه("out"، "true"))
    سرچاپ حذف‌شده‌ها.deleted، اپن سرچ.حذف پرسمانی با گزینه(ک، "books"، اپن سرچ.تطبیق همه()، اپن سرچ.گزینه‌ها { refresh = "true"، conflicts = "proceed" }).deleted
    بازنمایه := اپن سرچ.نمایه‌سازی دوباره(ک، "books"، "books_v2")
    سرچاپ بازنمایه.created، بازنمایه.error
    کار := اپن سرچ.نمایه‌سازی دوباره با بدنه(ک، `{"source":{"index":"books"},"dest":{"index":"books_v3"}}`، نادرست)
    سرچاپ کار.task
پایان
