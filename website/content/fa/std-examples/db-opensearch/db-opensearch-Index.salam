واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    ن := اپن سرچ.نمایه‌سازی(ک، "books"، "1"، `{"title":"The Book of Kings","year":1010,"stock":3}`)
    سرچاپ ن.موفق، ن.وضعیت، ن.نمایه، ن.شناسه، ن.نتیجه، ن.نسخه، ن.شماره توالی، ن.دوره اصلی
    سرچاپ ن.کل شارد‌ها، ن.شارد‌های موفق، ن.خطا
    خودکار := اپن سرچ.نمایه‌سازی با گزینه(ک، "books"، ""، `{"title":"Masnavi"}`، اپن سرچ.گزینه‌ها { تازه‌سازی = اپن سرچ.تازه‌سازی با انتظار، مسیریابی = "poetry" })
    سرچاپ خودکار.شناسه
    تکراری := اپن سرچ.ایجاد سند(ک، "books"، "1"، `{"title":"again"}`)
    سرچاپ تکراری.موفق، تکراری.وضعیت
    لوله‌شده := اپن سرچ.ایجاد سند با گزینه(ک، "books"، "2"، `{"title":"Golestan"}`، اپن سرچ.گزینه‌ها { خط لوله = "clean"، مهلت = "5s"، منتظر شارد‌های فعال = "1" })
    سرچاپ لوله‌شده.نتیجه

    د := اپن سرچ.دریافت(ک، "books"، "1")
    سرچاپ د.یافت شد، د.نمایه، د.شناسه، د.نسخه، د.شماره توالی، د.دوره اصلی، د.مسیریابی، د.منبع، د.فیلدها، د.خطا
    ناپایا فقط := وکتور {} برگردان وکتور<رشته>
    فقط.بیفزا("title")
    سرچاپ اپن سرچ.دریافت فیلدها(ک، "books"، "1"، فقط، "").منبع
    سرچاپ اپن سرچ.دریافت منبع(ک، "books"، "1")، اپن سرچ.وجود سند(ک، "books"، "1")

    سرچاپ اپن سرچ.به‌روزرسانی(ک، "books"، "1"، `{"stock":2}`).نتیجه
    شرطی := اپن سرچ.به‌روزرسانی با گزینه(ک، "books"، "1"، `{"doc":{"stock":1}}`، اپن سرچ.گزینه‌ها { شرط شماره توالی = د.شماره توالی، شرط دوره اصلی = د.دوره اصلی، کوشش مجدد هنگام تعارض = -1 })
    سرچاپ شرطی.موفق، اپن سرچ.نوع خطا(ک)
    سرچاپ اپن سرچ.به‌روزرسانی درجی(ک، "books"، "9"، `{"title":"Shahnameh","stock":1}`).نتیجه
    سرچاپ اپن سرچ.به‌روزرسانی اسکریپتی(ک، "books"، "1"، اپن سرچ.اسکریپت("ctx._source.stock += params.n"، `{"n":5}`)، `{"stock":5}`).نتیجه
    سرچاپ اپن سرچ.حذف سند با گزینه(ک، "books"، "9"، اپن سرچ.گزینه‌ها { تازه‌سازی = اپن سرچ.تازه‌سازی فوری، نسخه = 3، نوع نسخه = "external" }).نتیجه
    سرچاپ اپن سرچ.حذف سند(ک، "books"، "2").نتیجه

    ناپایا شناسه‌ها := وکتور {} برگردان وکتور<رشته>
    شناسه‌ها.بیفزا("1")
    شناسه‌ها.بیفزا("404")
    هر سند در اپن سرچ.دریافت چندگانه(ک، "books"، شناسه‌ها):
        سرچاپ سند.شناسه، سند.یافت شد
    پایان
    سرچاپ اپن سرچ.شمارش(ک، "books"، "")، اپن سرچ.شمارش(ک، "books"، اپن سرچ.بازه("year"، "1000"، ""))

    ناپایا ب := اپن سرچ.دسته‌ای تازه()
    اپن سرچ.نمایه‌سازی دسته‌ای(ب، "books"، "10"، `{"title":"Divan"}`)
    اپن سرچ.نمایه‌سازی دسته‌ای مسیردار(ب، "books"، "11"، "poetry"، `{"title":"Rubaiyat"}`)
    اپن سرچ.ایجاد دسته‌ای(ب، "books"، ""، `{"title":"Bustan"}`)
    اپن سرچ.به‌روزرسانی دسته‌ای(ب، "books"، "10"، `{"stock":4}`)
    اپن سرچ.به‌روزرسانی درجی دسته‌ای(ب، "books"، "12"، `{"title":"Kalila"}`)
    اپن سرچ.حذف دسته‌ای(ب، "books"، "3")
    سرچاپ اپن سرچ.اندازه دسته‌ای(ب)، ب.شمار، ب.خط‌ها.طول()
    چاپ اپن سرچ.بدنه دسته‌ای(ب)
    نتیجه دسته := اپن سرچ.ارسال دسته‌ای با تازه‌سازی(ک، ب، اپن سرچ.بدون تازه‌سازی)
    سرچاپ نتیجه دسته.موفق، نتیجه دسته.وضعیت، نتیجه دسته.زمان اجرا، نتیجه دسته.خطا دارد، نتیجه دسته.تعداد موفق، نتیجه دسته.تعداد ناموفق، نتیجه دسته.خطا
    هر قلم در نتیجه دسته.موارد:
        سرچاپ قلم.عملیات، قلم.نمایه، قلم.شناسه، قلم.وضعیت، قلم.موفق، قلم.نتیجه، قلم.نسخه، قلم.نوع خطا، قلم.علت خطا
    پایان
    اپن سرچ.بازنشانی دسته‌ای(ب)
    اپن سرچ.نمایه‌سازی دسته‌ای(ب، "books"، "13"، `{"title":"Makhzan"}`)
    سرچاپ اپن سرچ.ارسال دسته‌ای(ک، ب).موفق
    اپن سرچ.آزادسازی دسته‌ای(ب)
    سرچاپ اپن سرچ.تجزیه دسته‌ای(`{"took":1,"errors":false,"items":[]}`).موفق

    به‌روزشده‌ها := اپن سرچ.به‌روزرسانی پرسمانی(ک، "books"، اپن سرچ.واژه("stock"، "0")، اپن سرچ.اسکریپت("ctx._source.out = true"، ""))
    سرچاپ به‌روزشده‌ها.موفق، به‌روزشده‌ها.وضعیت، به‌روزشده‌ها.زمان اجرا، به‌روزشده‌ها.مهلت تمام شد، به‌روزشده‌ها.کل، به‌روزشده‌ها.به‌روز‌شده، به‌روزشده‌ها.دسته‌ها، به‌روزشده‌ها.تعارض‌های نسخه، به‌روزشده‌ها.بدون تغییر، به‌روزشده‌ها.ناموفق‌ها
    به‌روزشده‌ها۲ := اپن سرچ.به‌روزرسانی پرسمانی با گزینه(ک، "books"، ""، ""، اپن سرچ.گزینه‌ها { تعارض‌ها = "proceed"، خط لوله = "clean" })
    سرچاپ به‌روزشده‌ها۲.به‌روز‌شده
    حذف‌شده‌ها := اپن سرچ.حذف پرسمانی(ک، "books"، اپن سرچ.واژه("out"، "true"))
    سرچاپ حذف‌شده‌ها.حذف‌شده، اپن سرچ.حذف پرسمانی با گزینه(ک، "books"، اپن سرچ.تطبیق همه()، اپن سرچ.گزینه‌ها { تازه‌سازی = "true"، تعارض‌ها = "proceed" }).حذف‌شده
    بازنمایه := اپن سرچ.نمایه‌سازی دوباره(ک، "books"، "books_v2")
    سرچاپ بازنمایه.ایجاد‌شده، بازنمایه.خطا
    کار := اپن سرچ.نمایه‌سازی دوباره با بدنه(ک، `{"source":{"index":"books"},"dest":{"index":"books_v3"}}`، نادرست)
    سرچاپ کار.کار
