واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    c := اپن سرچ.اتصال("http://localhost:9200")
    w := اپن سرچ.نمایه‌سازی(c، "books"، "1"، `{"title":"The Book of Kings","year":1010,"stock":3}`)
    سرچاپ w.ok، w.status، w.index، w.id، w.result، w.version، w.seq_no، w.primary_term
    سرچاپ w.shards_total، w.shards_successful، w.error
    auto := اپن سرچ.نمایه‌سازی با گزینه(c، "books"، ""، `{"title":"Masnavi"}`، اپن سرچ.گزینه‌ها { refresh = اپن سرچ.تازه‌سازی با انتظار، routing = "poetry" })
    سرچاپ auto.id
    dup := اپن سرچ.ایجاد سند(c، "books"، "1"، `{"title":"again"}`)
    سرچاپ dup.ok، dup.status
    piped := اپن سرچ.ایجاد سند با گزینه(c، "books"، "2"، `{"title":"Golestan"}`، اپن سرچ.گزینه‌ها { pipeline = "clean"، timeout = "5s"، wait_for_active_shards = "1" })
    سرچاپ piped.result

    d := اپن سرچ.دریافت(c، "books"، "1")
    سرچاپ d.found، d.index، d.id، d.version، d.seq_no، d.primary_term، d.routing، d.source، d.fields، d.error
    ناپایا only := وکتور {} برگردان وکتور<رشته>
    only.بیفزا("title")
    سرچاپ اپن سرچ.دریافت فیلدها(c، "books"، "1"، only، "").source
    سرچاپ اپن سرچ.دریافت منبع(c، "books"، "1")، اپن سرچ.وجود سند(c، "books"، "1")

    سرچاپ اپن سرچ.به‌روزرسانی(c، "books"، "1"، `{"stock":2}`).result
    cas := اپن سرچ.به‌روزرسانی با گزینه(c، "books"، "1"، `{"doc":{"stock":1}}`، اپن سرچ.گزینه‌ها { if_seq_no = d.seq_no، if_primary_term = d.primary_term، retry_on_conflict = -1 })
    سرچاپ cas.ok، اپن سرچ.نوع خطا(c)
    سرچاپ اپن سرچ.به‌روزرسانی درجی(c، "books"، "9"، `{"title":"Shahnameh","stock":1}`).result
    سرچاپ اپن سرچ.به‌روزرسانی اسکریپتی(c، "books"، "1"، اپن سرچ.اسکریپت("ctx._source.stock += params.n"، `{"n":5}`)، `{"stock":5}`).result
    سرچاپ اپن سرچ.حذف سند با گزینه(c، "books"، "9"، اپن سرچ.گزینه‌ها { refresh = اپن سرچ.تازه‌سازی فوری، version = 3، version_type = "external" }).result
    سرچاپ اپن سرچ.حذف سند(c، "books"، "2").result

    ناپایا ids := وکتور {} برگردان وکتور<رشته>
    ids.بیفزا("1")
    ids.بیفزا("404")
    هر doc در اپن سرچ.دریافت چندگانه(c، "books"، ids):
        سرچاپ doc.id، doc.found
    پایان
    سرچاپ اپن سرچ.شمارش(c، "books"، "")، اپن سرچ.شمارش(c، "books"، اپن سرچ.بازه("year"، "1000"، ""))

    ناپایا b := اپن سرچ.دسته‌ای تازه()
    اپن سرچ.نمایه‌سازی دسته‌ای(b، "books"، "10"، `{"title":"Divan"}`)
    اپن سرچ.نمایه‌سازی دسته‌ای مسیردار(b، "books"، "11"، "poetry"، `{"title":"Rubaiyat"}`)
    اپن سرچ.ایجاد دسته‌ای(b، "books"، ""، `{"title":"Bustan"}`)
    اپن سرچ.به‌روزرسانی دسته‌ای(b، "books"، "10"، `{"stock":4}`)
    اپن سرچ.به‌روزرسانی درجی دسته‌ای(b، "books"، "12"، `{"title":"Kalila"}`)
    اپن سرچ.حذف دسته‌ای(b، "books"، "3")
    سرچاپ اپن سرچ.اندازه دسته‌ای(b)، b.count، b.lines.طول()
    چاپ اپن سرچ.بدنه دسته‌ای(b)
    br := اپن سرچ.ارسال دسته‌ای با تازه‌سازی(c، b، اپن سرچ.بدون تازه‌سازی)
    سرچاپ br.ok، br.status، br.took، br.errors، br.succeeded، br.failed، br.error
    هر it در br.items:
        سرچاپ it.action، it.index، it.id، it.status، it.ok، it.result، it.version، it.error_type، it.error_reason
    پایان
    اپن سرچ.بازنشانی دسته‌ای(b)
    اپن سرچ.نمایه‌سازی دسته‌ای(b، "books"، "13"، `{"title":"Makhzan"}`)
    سرچاپ اپن سرچ.ارسال دسته‌ای(c، b).ok
    اپن سرچ.آزادسازی دسته‌ای(b)
    سرچاپ اپن سرچ.تجزیه دسته‌ای(`{"took":1,"errors":false,"items":[]}`).ok

    ub := اپن سرچ.به‌روزرسانی پرسمانی(c، "books"، اپن سرچ.واژه("stock"، "0")، اپن سرچ.اسکریپت("ctx._source.out = true"، ""))
    سرچاپ ub.ok، ub.status، ub.took، ub.timed_out، ub.total، ub.updated، ub.batches، ub.version_conflicts، ub.noops، ub.failures
    ub2 := اپن سرچ.به‌روزرسانی پرسمانی با گزینه(c، "books"، ""، ""، اپن سرچ.گزینه‌ها { conflicts = "proceed"، pipeline = "clean" })
    سرچاپ ub2.updated
    dq := اپن سرچ.حذف پرسمانی(c، "books"، اپن سرچ.واژه("out"، "true"))
    سرچاپ dq.deleted، اپن سرچ.حذف پرسمانی با گزینه(c، "books"، اپن سرچ.تطبیق همه()، اپن سرچ.گزینه‌ها { refresh = "true"، conflicts = "proceed" }).deleted
    rx := اپن سرچ.نمایه‌سازی دوباره(c، "books"، "books_v2")
    سرچاپ rx.created، rx.error
    task := اپن سرچ.نمایه‌سازی دوباره با بدنه(c، `{"source":{"index":"books"},"dest":{"index":"books_v3"}}`، نادرست)
    سرچاپ task.task
پایان
