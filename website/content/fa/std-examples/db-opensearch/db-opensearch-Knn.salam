واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    روش درخواست := اپن سرچ.روش همسایه‌یابی { name = "hnsw"، engine = "lucene"، space_type = "cosinesimil"، m = 16، ef_construction = 128 }
    ناپایا افزوده := وکتور {} برگردان وکتور<رشته>
    افزوده.بیفزا(اپن سرچ.ویژگی("text"، "text"))
    سرچاپ اپن سرچ.تنظیمات نمایه همسایه‌یابی(1، 0)، اپن سرچ.فیلد بردار همسایه‌یابی(3، روش درخواست)
    سرچاپ اپن سرچ.ایجاد نمایه(ک، "places"، اپن سرچ.بدنه نمایه همسایه‌یابی("embedding"، 3، روش درخواست، افزوده))
    اپن سرچ.نمایه‌سازی(ک، "places"، "1"، `{"text":"a cafe","embedding":[0.1,0.9,0.2]}`)
    اپن سرچ.تازه‌سازی(ک، "places")
    ناپایا ز := وکتور {} برگردان وکتور<اعشار۶۴>
    ز.بیفزا(0.1)
    ز.بیفزا(0.8)
    ز.بیفزا(0.3)
    ر := اپن سرچ.جستجو(ک، "places"، اپن سرچ.نزدیک‌ترین همسایه‌ها("embedding"، ز، 5))
    سرچاپ ر.total
    سرچاپ اپن سرچ.گرم‌کردن همسایه‌یابی(ک، "places")، اپن سرچ.پاک‌سازی حافظه همسایه‌یابی(ک، "places")، اپن سرچ.آمار همسایه‌یابی(ک).طول() بزرگتر 0
    سرچاپ اپن سرچ.آموزش مدل همسایه‌یابی(ک، "pq-model"، `{"training_index":"train","training_field":"v","dimension":3,"method":{"name":"ivf","engine":"faiss"}}`)
    سرچاپ اپن سرچ.دریافت مدل همسایه‌یابی(ک، "pq-model")، اپن سرچ.حذف مدل همسایه‌یابی(ک، "pq-model")

    ناپایا ن := وکتور {} برگردان وکتور<اعشار۶۴>
    ن.بیفزا(0.3)
    ن.بیفزا(0.7)
    سرچاپ اپن سرچ.تنظیم خط لوله جستجو(ک، "hybrid"، اپن سرچ.خط لوله نرمال‌سازی("min_max"، "arithmetic_mean"، ن))
    سرچاپ اپن سرچ.دریافت خط لوله جستجو(ک، "hybrid")، اپن سرچ.حذف خط لوله جستجو(ک، "hybrid")

    کار := اپن سرچ.ثبت مدل یادگیری(ک، `{"name":"huggingface/sentence-transformers/all-MiniLM-L6-v2","version":"1.0.1","model_format":"TORCH_SCRIPT"}`)
    سرچاپ اپن سرچ.دریافت کار یادگیری(ک، کار)
    سرچاپ اپن سرچ.استقرار مدل یادگیری(ک، "model-1")، اپن سرچ.دریافت مدل یادگیری(ک، "model-1").طول() بزرگتر 0
    سرچاپ اپن سرچ.پیش‌بینی مدل(ک، "text_embedding"، "model-1"، `{"text_docs":["salam"]}`)
    سرچاپ اپن سرچ.برچیدن مدل یادگیری(ک، "model-1")، اپن سرچ.حذف مدل یادگیری(ک، "model-1")
