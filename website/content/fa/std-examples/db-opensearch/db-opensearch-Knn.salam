    سرچاپ اپن سرچ.دریافت خط لوله جستجو(c، "hybrid")، اپن سرچ.حذف خط لوله جستجو(c، "hybrid")

    task := اپن سرچ.ثبت مدل یادگیری(c، `{"name":"huggingface/sentence-transformers/all-MiniLM-L6-v2","version":"1.0.1","model_format":"TORCH_SCRIPT"}`)
