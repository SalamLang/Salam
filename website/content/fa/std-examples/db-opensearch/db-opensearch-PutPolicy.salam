واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    c := اپن سرچ.اتصال بدون وارسی گواهی("https://localhost:9200"، "admin"، "S3cret-pass!")
    ناپایا patterns := وکتور {} برگردان وکتور<رشته>
    patterns.بیفزا("logs-*")
    سرچاپ اپن سرچ.تنظیم سیاست(c، "logs-30d"، اپن سرچ.سیاست حذف پس از("drop old logs"، "30d"، patterns))
    سرچاپ اپن سرچ.دریافت سیاست(c، "logs-30d").طول() بزرگتر 0
    سرچاپ اپن سرچ.به‌روزرسانی سیاست(c، "logs-30d"، اپن سرچ.سیاست حذف پس از("drop old logs"، "60d"، patterns)، 0 برگردان صحیح۶۴، 1 برگردان صحیح۶۴)
    سرچاپ اپن سرچ.افزودن سیاست(c، "logs-000001"، "logs-30d")، اپن سرچ.شناسه سیاست نمایه(c، "logs-000001")
    سرچاپ اپن سرچ.تغییر سیاست(c، "logs-000001"، "logs-30d"، "hot")، اپن سرچ.تلاش دوباره سیاست(c، "logs-000001")
    سرچاپ اپن سرچ.توضیح سیاست(c، "logs-000001")، اپن سرچ.برداشتن سیاست(c، "logs-000001")، اپن سرچ.حذف سیاست(c، "logs-30d")

    me := اپن سرچ.من کیستم(c)
    سرچاپ me.ok، me.user، me.roles، me.backend_roles، me.tenants، me.error
    سرچاپ اپن سرچ.سلامت امنیت(c)
    ناپایا perms := وکتور {} برگردان وکتور<رشته>
    perms.بیفزا("cluster_monitor")
    ناپایا actions := وکتور {} برگردان وکتور<رشته>
    actions.بیفزا("read")
    سرچاپ اپن سرچ.تنظیم نقش(c، "logs_reader"، اپن سرچ.بدنه نقش(perms، patterns، actions))، اپن سرچ.دریافت نقش(c، "logs_reader")
    سرچاپ اپن سرچ.تنظیم کاربر(c، "maryam"، "Strong-Pass-1!"، وکتور {} برگردان وکتور<رشته>، `{"team":"ops"}`)، اپن سرچ.دریافت کاربر(c، "maryam")
    ناپایا users := وکتور {} برگردان وکتور<رشته>
    users.بیفزا("maryam")
    سرچاپ اپن سرچ.تنظیم نگاشت نقش(c، "logs_reader"، users، وکتور {} برگردان وکتور<رشته>)، اپن سرچ.دریافت نگاشت نقش(c، "logs_reader")
    سرچاپ اپن سرچ.کاربران(c)، اپن سرچ.تغییر گذرواژه(c، "S3cret-pass!"، "N3w-secret-pass!")
    سرچاپ اپن سرچ.حذف نگاشت نقش(c، "logs_reader")، اپن سرچ.حذف کاربر(c، "maryam")، اپن سرچ.حذف نقش(c، "logs_reader")

    monitor := `{"type":"monitor","name":"errors","enabled":true,"schedule":{"period":{"interval":5,"unit":"MINUTES"}},"inputs":[{"search":{"indices":["logs-*"],"query":{"size":0,"query":{"match":{"level":"error"}}}}}],"triggers":[]}`
    id := اپن سرچ.ایجاد پایشگر(c، monitor)
    سرچاپ id، اپن سرچ.دریافت پایشگر(c، id).طول() بزرگتر 0، اپن سرچ.به‌روزرسانی پایشگر(c، id، monitor)
    سرچاپ اپن سرچ.اجرای پایشگر(c، id، درست).طول() بزرگتر 0، اپن سرچ.جستجوی پایشگرها(c، اپن سرچ.تطبیق همه()).total
    سرچاپ اپن سرچ.حذف پایشگر(c، id)
پایان
