واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال بدون وارسی گواهی("https://localhost:9200"، "admin"، "S3cret-pass!")
    ناپایا الگوها := وکتور {} برگردان وکتور<رشته>
    الگوها.بیفزا("logs-*")
    سرچاپ اپن سرچ.تنظیم سیاست(ک، "logs-30d"، اپن سرچ.سیاست حذف پس از("drop old logs"، "30d"، الگوها))
    سرچاپ اپن سرچ.دریافت سیاست(ک، "logs-30d").طول() بزرگتر 0
    سرچاپ اپن سرچ.به‌روزرسانی سیاست(ک، "logs-30d"، اپن سرچ.سیاست حذف پس از("drop old logs"، "60d"، الگوها)، 0 برگردان صحیح۶۴، 1 برگردان صحیح۶۴)
    سرچاپ اپن سرچ.افزودن سیاست(ک، "logs-000001"، "logs-30d")، اپن سرچ.شناسه سیاست نمایه(ک، "logs-000001")
    سرچاپ اپن سرچ.تغییر سیاست(ک، "logs-000001"، "logs-30d"، "hot")، اپن سرچ.تلاش دوباره سیاست(ک، "logs-000001")
    سرچاپ اپن سرچ.توضیح سیاست(ک، "logs-000001")، اپن سرچ.برداشتن سیاست(ک، "logs-000001")، اپن سرچ.حذف سیاست(ک، "logs-30d")

    من := اپن سرچ.من کیستم(ک)
    سرچاپ من.ok، من.user، من.roles، من.backend_roles، من.tenants، من.error
    سرچاپ اپن سرچ.سلامت امنیت(ک)
    ناپایا مجوزها := وکتور {} برگردان وکتور<رشته>
    مجوزها.بیفزا("cluster_monitor")
    ناپایا کنش‌ها := وکتور {} برگردان وکتور<رشته>
    کنش‌ها.بیفزا("read")
    سرچاپ اپن سرچ.تنظیم نقش(ک، "logs_reader"، اپن سرچ.بدنه نقش(مجوزها، الگوها، کنش‌ها))، اپن سرچ.دریافت نقش(ک، "logs_reader")
    سرچاپ اپن سرچ.تنظیم کاربر(ک، "maryam"، "Strong-Pass-1!"، وکتور {} برگردان وکتور<رشته>، `{"team":"ops"}`)، اپن سرچ.دریافت کاربر(ک، "maryam")
    ناپایا کاربران := وکتور {} برگردان وکتور<رشته>
    کاربران.بیفزا("maryam")
    سرچاپ اپن سرچ.تنظیم نگاشت نقش(ک، "logs_reader"، کاربران، وکتور {} برگردان وکتور<رشته>)، اپن سرچ.دریافت نگاشت نقش(ک، "logs_reader")
    سرچاپ اپن سرچ.کاربران(ک)، اپن سرچ.تغییر گذرواژه(ک، "S3cret-pass!"، "N3w-secret-pass!")
    سرچاپ اپن سرچ.حذف نگاشت نقش(ک، "logs_reader")، اپن سرچ.حذف کاربر(ک، "maryam")، اپن سرچ.حذف نقش(ک، "logs_reader")

    پایشگر := `{"type":"monitor","name":"errors","enabled":true,"schedule":{"period":{"interval":5,"unit":"MINUTES"}},"inputs":[{"search":{"indices":["logs-*"],"query":{"size":0,"query":{"match":{"level":"error"}}}}}],"triggers":[]}`
    شناسه := اپن سرچ.ایجاد پایشگر(ک، پایشگر)
    سرچاپ شناسه، اپن سرچ.دریافت پایشگر(ک، شناسه).طول() بزرگتر 0، اپن سرچ.به‌روزرسانی پایشگر(ک، شناسه، پایشگر)
    سرچاپ اپن سرچ.اجرای پایشگر(ک، شناسه، درست).طول() بزرگتر 0، اپن سرچ.جستجوی پایشگرها(ک، اپن سرچ.تطبیق همه()).total
    سرچاپ اپن سرچ.حذف پایشگر(ک، شناسه)
پایان
