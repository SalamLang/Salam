واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    c := اپن سرچ.اتصال("http://localhost:9200")
    ناپایا req := اپن سرچ.درخواست جستجو { query = اپن سرچ.تطبیق("title"، "kings")، size = 10 }
    req.sort.بیفزا(اپن سرچ.مرتب نزولی("year"))
    req.aggs = اپن سرچ.افزودن تجمیع(اپن سرچ.افزودن تجمیع("{}"، "by_tag"، اپن سرچ.تجمیع واژه‌ها("tag"، 5))، "avg_year"، اپن سرچ.تجمیع میانگین("year"))
    req.aggs = اپن سرچ.افزودن تجمیع(req.aggs، "stats"، اپن سرچ.تجمیع آمار("year"))
    req.suggest = اپن سرچ.پیشنهاد واژه("fix"، "kngs"، "title")
    r := اپن سرچ.جستجو با درخواست(c، "books"، req)
    سرچاپ r.ok، r.status، r.took، r.timed_out، r.total، r.total_relation، r.max_score، r.error
    هر h در r.hits:
        سرچاپ h.index، h.id، h.score، h.source، h.sort، h.highlight، h.fields، h.inner_hits، h.matched_queries، h.raw.طول()
    پایان
    هر bk در اپن سرچ.سطل‌ها(r.aggregations، "by_tag"):
        سرچاپ bk.key، bk.key_as_string، bk.doc_count، bk.raw.طول()
    پایان
    سرچاپ اپن سرچ.مقدار تجمیع(r.aggregations، "avg_year")، اپن سرچ.فیلد تجمیع(r.aggregations، "stats"، "max")
    سرچاپ اپن سرچ.تجمیع خام(r.aggregations، "stats")، اپن سرچ.پیشنهادها(r.suggest، "fix")
    سرچاپ اپن سرچ.جستجو(c، "books,articles"، اپن سرچ.تطبیق همه()).total
    سرچاپ اپن سرچ.جستجوی خام(c، "books"، `{"query":{"match_all":{}},"size":1}`).hits.طول()
    p := اپن سرچ.پارامترهای جستجو {
        routing = "poetry"، preference = "_local"، search_pipeline = "rerank"، search_type = "dfs_query_then_fetch"،
        request_cache = "true"، allow_partial_search_results = "false"، ignore_unavailable = درست
    }
    سرچاپ اپن سرچ.جستجو با پارامتر(c، "books"، `{"size":0}`، p).total، p.scroll.طول()
    parsed := اپن سرچ.تجزیه جستجو(r.raw)
    سرچاپ parsed.hits.طول()، parsed.scroll_id، parsed.pit_id

    ناپایا page := اپن سرچ.جستجوی پیمایشی(c، "books"، اپن سرچ.درخواست جستجو { query = اپن سرچ.تطبیق همه()، size = 500 }، "1m")
    ناپایا seen := 0
    تا page.hits.طول() بزرگتر 0:
        seen += page.hits.طول()
        page = اپن سرچ.پیمایش(c، page.scroll_id، "1m")
    پایان
    سرچاپ seen، اپن سرچ.پاک‌سازی پیمایش(c، page.scroll_id)

    pit := اپن سرچ.ایجاد نقطه زمانی(c، "books"، "2m")
    ناپایا preq := اپن سرچ.درخواست جستجو { query = اپن سرچ.تطبیق همه()، size = 100، pit_id = pit، pit_keep_alive = "2m" }
    preq.sort.بیفزا(اپن سرچ.مرتب صعودی("year"))
    ناپایا pp := اپن سرچ.جستجو با درخواست(c، ""، preq)
    تا pp.hits.طول() بزرگتر 0:
        preq.search_after = pp.hits.بگیر(pp.hits.طول() - 1).sort
        pp = اپن سرچ.جستجو با درخواست(c، ""، preq)
    پایان
    سرچاپ اپن سرچ.فهرست نقطه‌های زمانی(c)، اپن سرچ.حذف نقطه زمانی(c، pit)، اپن سرچ.حذف همه نقطه‌های زمانی(c)

    ناپایا bodies := وکتور {} برگردان وکتور<رشته>
    bodies.بیفزا(`{"query":{"term":{"tag":"poetry"}},"size":0}`)
    bodies.بیفزا(`{"query":{"match_all":{}},"size":0}`)
    هر one در اپن سرچ.جستجوی چندگانه(c، "books"، bodies):
        سرچاپ one.ok، one.total
