واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    ناپایا درخواست := اپن سرچ.درخواست جستجو { query = اپن سرچ.تطبیق("title"، "kings")، size = 10 }
    درخواست.sort.بیفزا(اپن سرچ.مرتب نزولی("year"))
    درخواست.aggs = اپن سرچ.افزودن تجمیع(اپن سرچ.افزودن تجمیع("{}"، "by_tag"، اپن سرچ.تجمیع واژه‌ها("tag"، 5))، "avg_year"، اپن سرچ.تجمیع میانگین("year"))
    درخواست.aggs = اپن سرچ.افزودن تجمیع(درخواست.aggs، "stats"، اپن سرچ.تجمیع آمار("year"))
    ناپایا صدک‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    صدک‌ها.بیفزا(50.0)
    صدک‌ها.بیفزا(99.0)
    درخواست.aggs = اپن سرچ.افزودن تجمیع(درخواست.aggs، "pages"، اپن سرچ.تجمیع صدک‌ها("pages"، صدک‌ها))
    درخواست.suggest = اپن سرچ.پیشنهاد واژه("fix"، "kngs"، "title")
    ر := اپن سرچ.جستجو با درخواست(ک، "books"، درخواست)
    سرچاپ ر.ok، ر.status، ر.took، ر.timed_out، ر.total، ر.total_relation، ر.max_score، ر.error
    هر ه در ر.hits:
        سرچاپ ه.index، ه.id، ه.score، ه.source، ه.sort، ه.highlight، ه.fields، ه.inner_hits، ه.matched_queries، ه.raw.طول()
    پایان
    هر سطل در اپن سرچ.سطل‌ها(ر.aggregations، "by_tag"):
        سرچاپ سطل.key، سطل.key_as_string، سطل.doc_count، سطل.raw.طول()
    پایان
    سرچاپ اپن سرچ.مقدار تجمیع(ر.aggregations، "avg_year")، اپن سرچ.فیلد تجمیع(ر.aggregations، "stats"، "max")
    سرچاپ اپن سرچ.تجمیع خام(ر.aggregations، "stats")، اپن سرچ.پیشنهادها(ر.suggest، "fix")
    سرچاپ اپن سرچ.صدک تجمیع(ر.aggregations، "pages"، 50.0)، اپن سرچ.صدک تجمیع(ر.aggregations، "pages"، 99.0)
    سرچاپ اپن سرچ.جستجو(ک، "books,articles"، اپن سرچ.تطبیق همه()).total
    سرچاپ اپن سرچ.جستجوی خام(ک، "books"، `{"query":{"match_all":{}},"size":1}`).hits.طول()
    پ := اپن سرچ.پارامترهای جستجو {
        routing = "poetry"، preference = "_local"، search_pipeline = "rerank"، search_type = "dfs_query_then_fetch"،
        request_cache = "true"، allow_partial_search_results = "false"، ignore_unavailable = درست
    }
    سرچاپ اپن سرچ.جستجو با پارامتر(ک، "books"، `{"size":0}`، پ).total، پ.scroll.طول()
    تجزیه‌شده := اپن سرچ.تجزیه جستجو(ر.raw)
    سرچاپ تجزیه‌شده.hits.طول()، تجزیه‌شده.scroll_id، تجزیه‌شده.pit_id

    ناپایا صفحه := اپن سرچ.جستجوی پیمایشی(ک، "books"، اپن سرچ.درخواست جستجو { query = اپن سرچ.تطبیق همه()، size = 500 }، "1m")
    ناپایا دیده‌شده := 0
    تا صفحه.hits.طول() بزرگتر 0:
        دیده‌شده += صفحه.hits.طول()
        صفحه = اپن سرچ.پیمایش(ک، صفحه.scroll_id، "1m")
    پایان
    سرچاپ دیده‌شده، اپن سرچ.پاک‌سازی پیمایش(ک، صفحه.scroll_id)

    نقطه := اپن سرچ.ایجاد نقطه زمانی(ک، "books"، "2m")
    ناپایا درخواست نقطه := اپن سرچ.درخواست جستجو { query = اپن سرچ.تطبیق همه()، size = 100، pit_id = نقطه، pit_keep_alive = "2m" }
    درخواست نقطه.sort.بیفزا(اپن سرچ.مرتب صعودی("year"))
    ناپایا صفحه نقطه := اپن سرچ.جستجو با درخواست(ک، ""، درخواست نقطه)
    تا صفحه نقطه.hits.طول() بزرگتر 0:
        درخواست نقطه.search_after = صفحه نقطه.hits.بگیر(صفحه نقطه.hits.طول() - 1).sort
        صفحه نقطه = اپن سرچ.جستجو با درخواست(ک، ""، درخواست نقطه)
    پایان
    سرچاپ اپن سرچ.فهرست نقطه‌های زمانی(ک)، اپن سرچ.حذف نقطه زمانی(ک، نقطه)، اپن سرچ.حذف همه نقطه‌های زمانی(ک)

    ناپایا بدنه‌ها := وکتور {} برگردان وکتور<رشته>
    بدنه‌ها.بیفزا(`{"query":{"term":{"tag":"poetry"}},"size":0}`)
    بدنه‌ها.بیفزا(`{"query":{"match_all":{}},"size":0}`)
    هر یکی در اپن سرچ.جستجوی چندگانه(ک، "books"، بدنه‌ها):
