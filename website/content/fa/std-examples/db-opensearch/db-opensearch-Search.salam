    سرچاپ اپن سرچ.جستجوی الگو(c، "books"، "by_tag"، `{"tag":"poetry"}`).total
    سرچاپ اپن سرچ.جستجوی الگوی درون‌خطی(c، "books"، `{"query":{"term":{"tag":"{{t}}"}}}`، `{"t":"poetry"}`).total
    سرچاپ اپن سرچ.نمایش الگو(c، `{"query":{"term":{"tag":"{{t}}"}}}`، `{"t":"poetry"}`)
    سرچاپ اپن سرچ.توضیح امتیاز(c، "books"، "1"، اپن سرچ.تطبیق("title"، "kings"))
    سرچاپ اپن سرچ.اعتبارسنجی پرسمان(c، "books"، اپن سرچ.تطبیق("title"، "kings"))
    ناپایا fields := وکتور {} برگردان وکتور<رشته>
    fields.بیفزا("title")
    سرچاپ اپن سرچ.توانایی فیلدها(c، "books"، fields)
    سرچاپ اپن سرچ.مسیر جیسون(r.raw، "hits.hits.0._source.title")، اپن سرچ.مسیر خام جیسون(r.raw، "hits.total")
    سرچاپ اپن سرچ.اقلام جیسون(`[1,"two",{"three":3}]`).طول()
