واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    ناپایا درخواست := اپن سرچ.درخواست جستجو { پرسمان = اپن سرچ.تطبیق("title"، "kings")، اندازه = 10 }
    درخواست.مرتب‌سازی.بیفزا(اپن سرچ.مرتب نزولی("year"))
    درخواست.تجمیع‌ها = اپن سرچ.افزودن تجمیع(اپن سرچ.افزودن تجمیع("{}"، "by_tag"، اپن سرچ.تجمیع واژه‌ها("tag"، 5))، "avg_year"، اپن سرچ.تجمیع میانگین("year"))
    درخواست.تجمیع‌ها = اپن سرچ.افزودن تجمیع(درخواست.تجمیع‌ها، "stats"، اپن سرچ.تجمیع آمار("year"))
    ناپایا صدک‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    صدک‌ها.بیفزا(50.0)
    صدک‌ها.بیفزا(99.0)
    درخواست.تجمیع‌ها = اپن سرچ.افزودن تجمیع(درخواست.تجمیع‌ها، "pages"، اپن سرچ.تجمیع صدک‌ها("pages"، صدک‌ها))
    درخواست.پیشنهاد‌ها = اپن سرچ.پیشنهاد واژه("fix"، "kngs"، "title")
    ر := اپن سرچ.جستجو با درخواست(ک، "books"، درخواست)
    سرچاپ ر.موفق، ر.وضعیت، ر.زمان اجرا، ر.مهلت تمام شد، ر.کل، ر.نسبت کل، ر.بیشترین امتیاز، ر.خطا
    هر ه در ر.نتایج:
        سرچاپ ه.نمایه، ه.شناسه، ه.امتیاز، ه.منبع، ه.مرتب‌سازی، ه.برجسته‌سازی، ه.فیلدها، ه.نتایج درونی، ه.پرسمان‌های منطبق، ه.خام.طول()
    پایان
    هر سطل در اپن سرچ.سطل‌ها(ر.تجمیع‌ها، "by_tag"):
        سرچاپ سطل.کلید، سطل.کلید متنی، سطل.تعداد سند، سطل.خام.طول()
    پایان
    سرچاپ اپن سرچ.مقدار تجمیع(ر.تجمیع‌ها، "avg_year")، اپن سرچ.فیلد تجمیع(ر.تجمیع‌ها، "stats"، "max")
    سرچاپ اپن سرچ.تجمیع خام(ر.تجمیع‌ها، "stats")، اپن سرچ.پیشنهادها(ر.پیشنهاد‌ها، "fix")
    سرچاپ اپن سرچ.صدک تجمیع(ر.تجمیع‌ها، "pages"، 50.0)، اپن سرچ.صدک تجمیع(ر.تجمیع‌ها، "pages"، 99.0)
    سرچاپ اپن سرچ.جستجو(ک، "books,articles"، اپن سرچ.تطبیق همه()).کل
    سرچاپ اپن سرچ.جستجوی خام(ک، "books"، `{"query":{"match_all":{}},"size":1}`).نتایج.طول()
    پ := اپن سرچ.پارامترهای جستجو {
        مسیریابی = "poetry"، ترجیح = "_local"، خط لوله جستجو = "rerank"، نوع جستجو = "dfs_query_then_fetch"،
        حافظه نهان درخواست = "true"، اجازه نتیجه ناقص = "false"، نادیده گرفتن ناموجود = درست
    }
    سرچاپ اپن سرچ.جستجو با پارامتر(ک، "books"، `{"size":0}`، پ).کل، پ.پیمایش.طول()
    تجزیه‌شده := اپن سرچ.تجزیه جستجو(ر.خام)
    سرچاپ تجزیه‌شده.نتایج.طول()، تجزیه‌شده.شناسه پیمایش، تجزیه‌شده.شناسه نقطه زمانی

    ناپایا صفحه := اپن سرچ.جستجوی پیمایشی(ک، "books"، اپن سرچ.درخواست جستجو { پرسمان = اپن سرچ.تطبیق همه()، اندازه = 500 }، "1m")
    ناپایا دیده‌شده := 0
    تا صفحه.نتایج.طول() بزرگتر 0:
        دیده‌شده += صفحه.نتایج.طول()
        صفحه = اپن سرچ.پیمایش(ک، صفحه.شناسه پیمایش، "1m")
    پایان
    سرچاپ دیده‌شده، اپن سرچ.پاک‌سازی پیمایش(ک، صفحه.شناسه پیمایش)

    نقطه := اپن سرچ.ایجاد نقطه زمانی(ک، "books"، "2m")
    ناپایا درخواست نقطه := اپن سرچ.درخواست جستجو { پرسمان = اپن سرچ.تطبیق همه()، اندازه = 100، شناسه نقطه زمانی = نقطه، زنده‌ماندن نقطه زمانی = "2m" }
    درخواست نقطه.مرتب‌سازی.بیفزا(اپن سرچ.مرتب صعودی("year"))
    ناپایا صفحه نقطه := اپن سرچ.جستجو با درخواست(ک، ""، درخواست نقطه)
    تا صفحه نقطه.نتایج.طول() بزرگتر 0:
        درخواست نقطه.ادامه پس از = صفحه نقطه.نتایج.بگیر(صفحه نقطه.نتایج.طول() - 1).مرتب‌سازی
        صفحه نقطه = اپن سرچ.جستجو با درخواست(ک، ""، درخواست نقطه)
    پایان
    سرچاپ اپن سرچ.فهرست نقطه‌های زمانی(ک)، اپن سرچ.حذف نقطه زمانی(ک، نقطه)، اپن سرچ.حذف همه نقطه‌های زمانی(ک)

    ناپایا بدنه‌ها := وکتور {} برگردان وکتور<رشته>
    بدنه‌ها.بیفزا(`{"query":{"term":{"tag":"poetry"}},"size":0}`)
    بدنه‌ها.بیفزا(`{"query":{"match_all":{}},"size":0}`)
    هر یکی در اپن سرچ.جستجوی چندگانه(ک، "books"، بدنه‌ها):
        سرچاپ یکی.موفق، یکی.کل
    پایان
    سرچاپ اپن سرچ.جستجوی الگو(ک، "books"، "by_tag"، `{"tag":"poetry"}`).کل
    سرچاپ اپن سرچ.جستجوی الگوی درون‌خطی(ک، "books"، `{"query":{"term":{"tag":"{{t}}"}}}`، `{"t":"poetry"}`).کل
    سرچاپ اپن سرچ.نمایش الگو(ک، `{"query":{"term":{"tag":"{{t}}"}}}`، `{"t":"poetry"}`)
    سرچاپ اپن سرچ.توضیح امتیاز(ک، "books"، "1"، اپن سرچ.تطبیق("title"، "kings"))
    سرچاپ اپن سرچ.اعتبارسنجی پرسمان(ک، "books"، اپن سرچ.تطبیق("title"، "kings"))
    ناپایا فیلدها := وکتور {} برگردان وکتور<رشته>
    فیلدها.بیفزا("title")
    سرچاپ اپن سرچ.توانایی فیلدها(ک، "books"، فیلدها)
    سرچاپ اپن سرچ.مسیر جیسون(ر.خام، "hits.hits.0._source.title")، اپن سرچ.مسیر خام جیسون(ر.خام، "hits.total")
    سرچاپ اپن سرچ.اقلام جیسون(`[1,"two",{"three":3}]`).طول()
پایان
