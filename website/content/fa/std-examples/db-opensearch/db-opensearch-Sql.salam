واردسازی دیتابیس
واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    ک := اپن سرچ.اتصال("http://localhost:9200")
    رابط := اپن سرچ.اتصال عمومی(ک)
    سرچاپ رابط.نوع()، رابط.معتبر()، رابط.پینگ()، دیتابیس.پرسمان عدد(رابط، "SELECT COUNT(*) FROM books")
    ردیف‌ها := رابط.پرسمان("SELECT title, year, price FROM books WHERE year > 1000 ORDER BY year")
    سرچاپ ردیف‌ها.معتبر()، ردیف‌ها.تعداد ستون()، ردیف‌ها.نام ستون(0)، ردیف‌ها.نوع ستون(1)
    تا ردیف‌ها.بعدی():
        سرچاپ ردیف‌ها.متن(0)، ردیف‌ها.عدد صحیح(1)، ردیف‌ها.عدد صحیح۶۴(1)، ردیف‌ها.عدد اعشار(2)، ردیف‌ها.خالی است(2)
    پایان
    ردیف‌ها.بستن()
    سرچاپ رابط.اجرا("DELETE FROM books WHERE year < 0")، رابط.تعداد تغییرات()، رابط.شناسه آخرین درج()، رابط.خطا()، رابط.نقل قول("it's")
    تراکنش := رابط.شروع تراکنش()
    سرچاپ تراکنش.معتبر()، تراکنش.اجرا("SELECT 1")، تراکنش.پرسمان("SELECT 1").معتبر()، تراکنش.ثبت تراکنش()، تراکنش.بازگردانی()

    ناپایا پارامترها := وکتور {} برگردان وکتور<رشته>
    پارامترها.بیفزا(اپن سرچ.پارامتر اس کیو ال("integer"، "1000"))
    ناپایا صفحه‌بندی‌شده := اپن سرچ.اس کیو ال با پارامتر(ک، "SELECT title FROM books WHERE year > ?"، پارامترها، 100)
    سرچاپ صفحه‌بندی‌شده.مجموع()، صفحه‌بندی‌شده.نام نوع ستون(0)، صفحه‌بندی‌شده.خطا()
    تا صفحه‌بندی‌شده.بعدی():
        سرچاپ صفحه‌بندی‌شده.خام(0)
    پایان
    صفحه‌بندی‌شده.بستن()
    نتیجه جدول := اپن سرچ.اس کیو ال(ک، "SHOW TABLES LIKE books%")
    نتیجه جدول.بستن()
    سرچاپ اپن سرچ.اس کیو ال با قالب(ک، "SELECT title FROM books"، "csv")
    سرچاپ اپن سرچ.توضیح اس کیو ال(ک، "SELECT title FROM books").طول() بزرگتر 0

    پ := اپن سرچ.پی پی ال(ک، "source=books | where year > 1000 | stats count() by tag")
    تا پ.بعدی():
        سرچاپ پ.عدد صحیح(0)، پ.متن(1)
    پایان
    پ.بستن()
    سرچاپ اپن سرچ.پی پی ال با قالب(ک، "source=books | fields title"، "raw")، اپن سرچ.توضیح پی پی ال(ک، "source=books").طول() بزرگتر 0
    د := اپن سرچ.پایگاه داده { handle = ک.handle }
    ت := اپن سرچ.تراکنش {}
    سرچاپ د.نوع()، ت.معتبر()، رابط.بستن()
پایان
