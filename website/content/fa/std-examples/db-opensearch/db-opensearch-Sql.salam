واردسازی دیتابیس
واردسازی دیتابیس.اپن سرچ

تابع ریشه:
    c := اپن سرچ.اتصال("http://localhost:9200")
    conn := اپن سرچ.اتصال عمومی(c)
    سرچاپ conn.نوع()، conn.معتبر()، conn.پینگ()، دیتابیس.پرسمان عدد(conn، "SELECT COUNT(*) FROM books")
    rows := conn.پرسمان("SELECT title, year, price FROM books WHERE year > 1000 ORDER BY year")
    سرچاپ rows.معتبر()، rows.تعداد ستون()، rows.نام ستون(0)، rows.نوع ستون(1)
    تا rows.بعدی():
        سرچاپ rows.متن(0)، rows.عدد صحیح(1)، rows.عدد صحیح۶۴(1)، rows.عدد اعشار(2)، rows.خالی است(2)
    پایان
    rows.بستن()
    سرچاپ conn.اجرا("DELETE FROM books WHERE year < 0")، conn.تعداد تغییرات()، conn.شناسه آخرین درج()، conn.خطا()، conn.نقل قول("it's")
    tx := conn.شروع تراکنش()
    سرچاپ tx.معتبر()، tx.اجرا("SELECT 1")، tx.پرسمان("SELECT 1").معتبر()، tx.ثبت تراکنش()، tx.بازگردانی()

    ناپایا params := وکتور {} برگردان وکتور<رشته>
    params.بیفزا(اپن سرچ.پارامتر اس کیو ال("integer"، "1000"))
    ناپایا paged := اپن سرچ.اس کیو ال با پارامتر(c، "SELECT title FROM books WHERE year > ?"، params، 100)
    سرچاپ paged.مجموع()، paged.نام نوع ستون(0)، paged.خطا()
    تا paged.بعدی():
        سرچاپ paged.خام(0)
    پایان
    paged.بستن()
    rs := اپن سرچ.اس کیو ال(c، "SHOW TABLES LIKE books%")
    rs.بستن()
    سرچاپ اپن سرچ.اس کیو ال با قالب(c، "SELECT title FROM books"، "csv")
    سرچاپ اپن سرچ.توضیح اس کیو ال(c، "SELECT title FROM books").طول() بزرگتر 0

    p := اپن سرچ.پی پی ال(c، "source=books | where year > 1000 | stats count() by tag")
    تا p.بعدی():
        سرچاپ p.عدد صحیح(0)، p.متن(1)
    پایان
    p.بستن()
    سرچاپ اپن سرچ.پی پی ال با قالب(c، "source=books | fields title"، "raw")، اپن سرچ.توضیح پی پی ال(c، "source=books").طول() بزرگتر 0
    d := اپن سرچ.پایگاه داده { handle = c.handle }
    t := اپن سرچ.تراکنش {}
    سرچاپ d.نوع()، t.معتبر()، conn.بستن()
پایان
