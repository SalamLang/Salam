واردسازی دیتابیس
واردسازی دیتابیس.پستگرس

روال ریشه:
    اگر وارونه پستگرس.در دسترس():
        سرچاپ "کلاینت پستگرس در دسترس نیست"
        برگشت
    پایان
    سرچاپ پستگرس.نسخه کلاینت()
    پ := پستگرس.بازکردن("host=127.0.0.1 port=5432 dbname=shop user=app password=s3cret")
    اگر وارونه پستگرس.معتبر(پ):
        سرچاپ پستگرس.خطا(پ)
        برگشت
    پایان
    سرچاپ پستگرس.نسخه سرور(پ)، پستگرس.نام پایگاه داده(پ)، پستگرس.نام کاربر(پ)، پستگرس.نام میزبان(پ)، پستگرس.درگاه(پ)
    سرچاپ پستگرس.پینگ(پ)
    _ := پستگرس.اجرا(پ، "CREATE TABLE IF NOT EXISTS items (id SERIAL PRIMARY KEY, name TEXT, price NUMERIC)")
    _ := پستگرس.اجرا(پ، "INSERT INTO items (name, price) VALUES (" + پستگرس.نقل قول(پ، "چای") + ", 12.5)")
    سرچاپ پستگرس.اجرا با شمارش(پ، "UPDATE items SET price = price * 1.1")

    ر := پستگرس.پرسمان(پ، "SELECT id, name, price FROM items ORDER BY id")
    سرچاپ ر.معتبر()، ر.تعداد ستون()، ر.تعداد ردیف()، ر.نام ستون(۱)
    تا ر.بعدی():
        سرچاپ ر.عدد صحیح(۰)، ر.متن(۱)، ر.عدد اعشار(۲)، ر.عدد صحیح۶۴(۰)، ر.خالی است(۲)، ر.نوع ستون(۱)
    پایان
    _ := ر.بستن()
    سرچاپ پستگرس.پرسمان عدد(پ، "SELECT COUNT(*) FROM items")، پستگرس.پرسمان متن(پ، "SELECT version()")

    ا := پستگرس.اتصال(پ)
    ت := ا.شروع تراکنش()
    _ := ت.اجرا("DELETE FROM items")
    _ := ت.بازگردانی()
    سرچاپ دیتابیس.پرسمان عدد(ا، "SELECT COUNT(*) FROM items")، پ.نوع()
    پستگرس.بازنشانی(پ)
    _ := پستگرس.بستن(پ)
    _ := پستگرس.بازکردن کامل("db.example.com"، ۵۴۳۲، "app"، "s3cret"، "shop")
پایان
