واردسازی دیتابیس.ردیس

روال ریشه:
    ک := ردیس.اتصال("127.0.0.1"، ۶۳۷۹)
    اگر وارونه ردیس.معتبر(ک):
        سرچاپ ردیس.خطا(ک)
        برگشت
    پایان
    _ := ردیس.احراز هویت(ک، "s3cret")
    _ := ردیس.انتخاب پایگاه داده(ک، ۱)
    سرچاپ ردیس.پینگ(ک)

    _ := ردیس.تنظیم(ک، "greeting"، "سلام")
    _ := ردیس.تنظیم با انقضا(ک، "session:42"، "token"، ۳۶۰۰)
    سرچاپ ردیس.دریافت(ک، "greeting")، ردیس.وجود دارد(ک، "greeting")، ردیس.زمان باقیمانده(ک، "session:42")
    سرچاپ ردیس.افزایش(ک، "visits")، ردیس.افزایش با مقدار(ک، "visits"، ۱۰)، ردیس.کاهش(ک، "visits")
    سرچاپ ردیس.پیوست(ک، "greeting"، "!")، ردیس.طول رشته(ک، "greeting")، ردیس.نوع(ک، "greeting")
    _ := ردیس.انقضا(ک، "greeting"، ۶۰)
    سرچاپ ردیس.کلیدها(ک، "session:*").طول()
    _ := ردیس.حذف(ک، "greeting")

    _ := ردیس.تنظیم فیلد هش(ک، "user:1"، "name"، "مریم")
    _ := ردیس.تنظیم فیلد هش(ک، "user:1"، "city"، "تهران")
    سرچاپ ردیس.دریافت فیلد هش(ک، "user:1"، "name")، ردیس.فیلد هش وجود دارد(ک، "user:1"، "age")، ردیس.تعداد فیلدهای هش(ک، "user:1")
    همه := ردیس.دریافت همه هش(ک، "user:1")
    سرچاپ همه.اندازه()
    _ := ردیس.حذف فیلد هش(ک، "user:1"، "city")

    _ := ردیس.افزودن به انتهای لیست(ک، "jobs"، "a")
    _ := ردیس.افزودن به ابتدای لیست(ک، "jobs"، "b")
    سرچاپ ردیس.طول لیست(ک، "jobs")، ردیس.بازه لیست(ک، "jobs"، ۰، -۱).طول()
    سرچاپ ردیس.برداشتن از ابتدای لیست(ک، "jobs")، ردیس.برداشتن از انتهای لیست(ک، "jobs")

    _ := ردیس.افزودن به مجموعه(ک، "tags"، "go")
    _ := ردیس.افزودن به مجموعه(ک، "tags"، "salam")
    سرچاپ ردیس.عضو مجموعه است(ک، "tags"، "salam")، ردیس.اندازه مجموعه(ک، "tags")، ردیس.اعضای مجموعه(ک، "tags").طول()
    _ := ردیس.حذف از مجموعه(ک، "tags"، "go")
    سرچاپ ردیس.انتشار(ک، "news"، "خبر تازه")

    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    آرگ.افزودن("GET")
    آرگ.افزودن("visits")
    پ := ردیس.دستور(ک، آرگ)
    اگر ردیس.پاسخ معتبر(پ) و وارونه ردیس.پاسخ خطا است(پ) و وارونه ردیس.پاسخ خالی است(پ):
        سرچاپ ردیس.نوع پاسخ(پ) == ردیس.پاسخ_رشته، ردیس.پاسخ رشته(پ)
    پایان
    ردیس.آزادسازی پاسخ(پ)
    ناپایا آرگ۲ := وکتور {} برگردان وکتور<رشته>
    آرگ۲.افزودن("LRANGE")
    آرگ۲.افزودن("jobs")
    آرگ۲.افزودن("0")
    آرگ۲.افزودن("-1")
    پ۲ := ردیس.دستور(ک، آرگ۲)
    اگر ردیس.نوع پاسخ(پ۲) == ردیس.پاسخ_آرایه:
        تکرار ردیس.طول آرایه پاسخ(پ۲) در ش:
            سرچاپ ردیس.پاسخ رشته(ردیس.عنصر آرایه پاسخ(پ۲، ش))
        پایان
    پایان
    سرچاپ ردیس.پاسخ صحیح(پ۲)، ردیس.پاسخ_صحیح، ردیس.پاسخ_خالی، ردیس.پاسخ_وضعیت، ردیس.پاسخ_خطا، ردیس.پاسخ_اعشار
    ردیس.آزادسازی پاسخ(پ۲)
    _ := ردیس.پاک‌سازی پایگاه داده(ک)
    ردیس.بستن(ک)
پایان
