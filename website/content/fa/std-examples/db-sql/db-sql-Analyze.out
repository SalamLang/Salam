SELECT id, name FROM users WHERE email = ? AND age > ?
  دستور: select روی users
  جانگهدار 1 ستون email از گونه str
  جانگهدار 2 ستون age از گونه option.Option<i64>
  ستون id برمی گردد با گونه i64
  ستون name برمی گردد با گونه option.Option<str>
INSERT INTO users (email, name) VALUES (?, ?) RETURNING id
  دستور: insert روی users
  جانگهدار 1 ستون email از گونه str
  جانگهدار 2 ستون name از گونه option.Option<str>
  ستون id برمی گردد با گونه i64
