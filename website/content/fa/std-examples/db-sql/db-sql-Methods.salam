واردسازی دیتابیس.اس کیو ال

تابع ریشه:
    لایت := اس کیو ال.گویش شماره(اس کیو ال.اس کیو لایت)
    سرچاپ لایت.name، اس کیو ال.گویش نام("postgresql").name، اس کیو ال.گویش شماره(اس کیو ال.ماریادی بی).name

    ناپایا بد := اس کیو ال.بازبینی("SELECT id FROM t WHERE"، لایت)
    سرچاپ بد.ok، بد.errors، بد.warnings، بد.statements
    سرچاپ اس کیو ال.متن عیب(بد.items.بگیر(۰))
    اس کیو ال.آزادسازی گزارش(بد)

    سرچاپ اس کیو ال.شمار پارامتر("SELECT a FROM t WHERE b = ? AND c = ?"، لایت)
    ناپایا نشانه ها := اس کیو ال.جانگهدارها("SELECT a FROM t WHERE b = ? AND c = ?"، لایت)
    سرچاپ نشانه ها.طول()، نشانه ها.بگیر(۰)
    نشانه ها.آزادکن()

    ناپایا فهرست := اس کیو ال.فهرست تازه(لایت)
    ناپایا طرح := اس کیو ال.اعمال(فهرست، """
        CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT NOT NULL, age INTEGER);
    """)
    سرچاپ "طرح:"، طرح.ok، اس کیو ال.شمار جدول(فهرست)، اس کیو ال.نام جدول(فهرست، ۰)
    اس کیو ال.آزادسازی گزارش(طرح)
    سرچاپ اس کیو ال.جدول دارد(فهرست، "users")، اس کیو ال.ستون دارد(فهرست، "users"، "email")
    ستون یک := اس کیو ال.ستون شماره(فهرست، "users"، ۱)
    سرچاپ ستون یک.name، اس کیو ال.نام نوع(ستون یک.kind)، ستون یک.not_null

    ناپایا گم := اس کیو ال.بررسی("SELECT nope FROM users"، فهرست)
    سرچاپ اس کیو ال.متن گزارش(گم)
    اس کیو ال.آزادسازی گزارش(گم)

    ناپایا ت := اس کیو ال.تحلیل کن("SELECT id, age FROM users WHERE email = ?"، فهرست)
    سرچاپ اس کیو ال.نام دستور(ت.kind)، ت.table، ت.params.طول()، ت.results.طول()
    پ := ت.params.بگیر(۰)
    سرچاپ پ.marker، پ.ordinal، پ.table + "." + پ.column، اس کیو ال.گونه سلام(پ.kind، پ.not_null)
    س := ت.results.بگیر(۱)
    سرچاپ س.name، اس کیو ال.نام نوع(س.kind)، س.nullable
    اس کیو ال.آزادسازی تحلیل(ت)

    ناپایا مقدارها := اس کیو ال.مقدارهای تازه()
    اس کیو ال.افزودن عدد(مقدارها، ۳ برگردان صحیح۶۴)
    اس کیو ال.افزودن متن(مقدارها، "a'b")
    اس کیو ال.افزودن منطقی(مقدارها، نادرست)
    اس کیو ال.افزودن اعشار(مقدارها، ۲.۵)
    اس کیو ال.افزودن خالی(مقدارها)
    سرچاپ اس کیو ال.شمار مقدار(مقدارها)
    ناپایا خطا := اس کیو ال.گزارش {}
    پرشده := اس کیو ال.پرکردن("INSERT INTO t (a, b, c, d, e) VALUES (?, ?, ?, ?, ?)"، مقدارها، لایت، خطا)
    سرچاپ پرشده
    اس کیو ال.آزادسازی گزارش(خطا)
    اس کیو ال.آزادسازی مقدارها(مقدارها)

    اس کیو ال.آزادسازی فهرست(فهرست)
    برگشت ۰
پایان
