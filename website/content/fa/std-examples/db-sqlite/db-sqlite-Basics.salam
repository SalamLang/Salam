واردسازی دیتابیس.اس کیو لایت

تابع ریشه:
    سرچاپ اس کیو لایت.در دسترس()، اس کیو لایت.نسخه().طول() > ۰
    پ := اس کیو لایت.بازکردن(":memory:")
    سرچاپ اس کیو لایت.معتبر(پ)
    _ := اس کیو لایت.اجرا(پ، "CREATE TABLE books (id INTEGER PRIMARY KEY, title TEXT NOT NULL, pages INTEGER, price REAL, note TEXT)")
    _ := اس کیو لایت.اجرا(پ، "INSERT INTO books (title, pages, price) VALUES ('شازده کوچولو', 96, 4.5)")
    سرچاپ اس کیو لایت.شناسه آخرین درج(پ)، اس کیو لایت.تعداد تغییرات(پ)

    د := اس کیو لایت.آماده سازی(پ، "INSERT INTO books (title, pages, price, note) VALUES (?, ?, ?, ?)")
    سرچاپ اس کیو لایت.دستور معتبر(د)
    _ := اس کیو لایت.اتصال متن(د، ۱، "بوف کور")
    _ := اس کیو لایت.اتصال عدد(د، ۲، ۱۲۰)
    _ := اس کیو لایت.اتصال اعشار(د، ۳، ۶.۲۵)
    _ := اس کیو لایت.اتصال خالی(د، ۴)
    _ := اس کیو لایت.بعدی(د)
    _ := اس کیو لایت.بازنشانی(د)
    _ := اس کیو لایت.اتصال متن(د، ۱، "سووشون")
    _ := اس کیو لایت.اتصال عدد(د، ۲، ۳۰۴)
    _ := اس کیو لایت.اتصال اعشار(د، ۳، ۹)
    _ := اس کیو لایت.اتصال متن(د، ۴، "کلاسیک")
    _ := اس کیو لایت.بعدی(د)
    _ := اس کیو لایت.پایان(د)
    سرچاپ اس کیو لایت.مجموع تغییرات(پ)

    ر := اس کیو لایت.پرسمان(پ، "SELECT id, title, pages, price, note FROM books ORDER BY id")
    سرچاپ اس کیو لایت.تعداد ستون(ر)، اس کیو لایت.نام ستون(ر، ۱)
    تا اس کیو لایت.بعدی(ر):
        ناپایا یادداشت := "-"
        اگر وارونه اس کیو لایت.خالی است(ر، ۴):
            یادداشت = اس کیو لایت.متن(ر، ۴)
        پایان
        سرچاپ اس کیو لایت.عدد صحیح(ر، ۰)، اس کیو لایت.متن(ر، ۱)، اس کیو لایت.عدد صحیح۶۴(ر، ۲)، اس کیو لایت.عدد اعشار(ر، ۳)، یادداشت
    پایان
    _ := اس کیو لایت.پایان(ر)

    ن := اس کیو لایت.پرسمان(پ، "SELECT pages, title, price, note FROM books WHERE id = 2")
    _ := اس کیو لایت.بعدی(ن)
    سرچاپ اس کیو لایت.نوع ستون(ن، ۰)، اس کیو لایت.نوع ستون(ن، ۱)، اس کیو لایت.نوع ستون(ن، ۲)، اس کیو لایت.نوع ستون(ن، ۳)
    _ := اس کیو لایت.پایان(ن)

    سرچاپ اس کیو لایت.پرسمان عدد(پ، "SELECT SUM(pages) FROM books")، اس کیو لایت.پرسمان متن(پ، "SELECT title FROM books ORDER BY price DESC LIMIT 1")

    _ := اس کیو لایت.شروع تراکنش(پ)
    _ := اس کیو لایت.اجرا(پ، "DELETE FROM books")
    _ := اس کیو لایت.بازگردانی(پ)
    _ := اس کیو لایت.شروع تراکنش(پ)
    _ := اس کیو لایت.اجرا(پ، "UPDATE books SET price = price * 2")
    _ := اس کیو لایت.ثبت تراکنش(پ)
    سرچاپ اس کیو لایت.پرسمان عدد(پ، "SELECT COUNT(*) FROM books")، اس کیو لایت.پرسمان متن(پ، "SELECT price FROM books WHERE id = 1")

    سرچاپ اس کیو لایت.اجرا(پ، "SELECT * FROM missing") != ۰
    سرچاپ اس کیو لایت.خطا(پ)
    _ := اس کیو لایت.بستن(پ)
پایان
