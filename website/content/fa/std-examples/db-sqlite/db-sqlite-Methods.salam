واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع ریشه:
    پ := اس کیو لایت.بازکردن(":memory:")
    سرچاپ پ.نوع()، پ.معتبر()، پ.پینگ()
    _ := پ.اجرا("CREATE TABLE notes (id INTEGER PRIMARY KEY, body TEXT, stars REAL)")
    _ := پ.اجرا("INSERT INTO notes (body, stars) VALUES (" + پ.نقل قول("یادداشتِ 'اول'") + ", 4.5)")
    سرچاپ پ.شناسه آخرین درج()، پ.تعداد تغییرات()

    ت := پ.شروع تراکنش()
    _ := ت.اجرا("INSERT INTO notes (body) VALUES ('دوم')")
    تر := ت.پرسمان("SELECT COUNT(*) FROM notes")
    _ := تر.بعدی()
    سرچاپ تر.عدد صحیح(۰)
    _ := تر.بستن()
    سرچاپ ت.معتبر()، ت.ثبت تراکنش()

    ر := پ.پرسمان("SELECT id, body, stars FROM notes ORDER BY id")
    سرچاپ ر.معتبر()، ر.تعداد ستون()، ر.نام ستون(۲)
    تا ر.بعدی():
        ناپایا ستاره := "-"
        اگر وارونه ر.خالی است(۲):
            ستاره = "" + ر.عدد اعشار(۲)
        پایان
        سرچاپ ر.عدد صحیح۶۴(۰)، ر.متن(۱)، ستاره، ر.نوع ستون(۲)
    پایان
    _ := ر.بستن()

    ت۲ := پ.شروع تراکنش()
    _ := ت۲.اجرا("DELETE FROM notes")
    _ := ت۲.بازگردانی()
    ا := اس کیو لایت.اتصال(پ)
    سرچاپ دیتابیس.پرسمان عدد(ا، "SELECT COUNT(*) FROM notes")
    سرچاپ پ.اجرا("DROP TABLE nope") != ۰، پ.خطا()
    سرچاپ پ.بستن()
پایان
