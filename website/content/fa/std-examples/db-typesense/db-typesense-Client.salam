واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ناپایا nodes := وکتور {} برگردان وکتور<رشته>
    nodes.بیفزا("http://ts-1:8108")
    nodes.بیفزا("http://ts-2:8108")
    nodes.بیفزا("http://ts-3:8108")
    ناپایا ک := تایپسنس.خوشه جدید(nodes، "admin-key")
    دیرکن تایپسنس.آزادسازی(ک)
    تایپسنس.تنظیم نزدیک‌ترین گره(ک، "http://ts-local:8108")
    تایپسنس.افزودن گره(ک، "http://ts-4:8108")
    تایپسنس.افزودن سرصفحه(ک، "X-Request-Source"، "salam")
    ک.timeout_ms = 5000
    ک.retries = 2
    ک.retry_interval_ms = 200
    ک.healthcheck_ms = 30000

    ناپایا خ := تایپسنس.خطا {}
    اگر وارونه تایپسنس.سلامت(ک، خ):
        سرچاپ "آماده نیست: " + تایپسنس.متن خطا(خ)
        برگشت 1
    پایان
    سرچاپ تایپسنس.سالم است(ک)، تایپسنس.گره سالم است(ک، 0)، تایپسنس.گره سالم است(ک، -1)
    سرچاپ "نسخه‌ی سرور"، تایپسنس.نسخه سرور(ک، خ)، تایپسنس.اشکال زدایی(ک، خ)
    st := تایپسنس.وضعیت(ک، خ)
    سرچاپ st.state، st.committed_index، st.queued_writes
    سرچاپ تایپسنس.آمار(ک، خ)
    سرچاپ تایپسنس.سنجه ها(ک، خ)
    سرچاپ تایپسنس.ساخت تصویر لحظه ای(ک، "/data/snapshots/today"، خ)
    سرچاپ تایپسنس.رای گیری(ک، خ)، تایپسنس.پاک کردن حافظه نهان(ک، خ)، تایپسنس.فشرده سازی پایگاه(ک، خ)، تایپسنس.بازنشانی همتاها(ک، خ)
    سرچاپ تایپسنس.تغییرات طرح(ک، خ).طول()
    سرچاپ تایپسنس.تنظیم گزارش درخواست کند(ک، 1000، خ)، تایپسنس.به‌روزرسانی پیکربندی(ک، `{"healthy-read-lag": 1000}`، خ)

    body := تایپسنس.درخواست(ک، "GET"، "/collections?limit=1"، ""، خ)
    اگر وارونه تایپسنس.موفق(خ):
        سرچاپ خ.status، خ.kind، خ.message
        سرچاپ خ.kind == تایپسنس.نوع اچ تی تی پی، خ.kind == تایپسنس.نوع شبکه، خ.kind == تایپسنس.نوع نامعتبر، خ.kind == تایپسنس.نوع رمزگشایی
        سرچاپ تایپسنس.پیدا نشد(خ)، تایپسنس.تداخل دارد(خ)
        برگشت 1
    پایان
    سرچاپ body
    سرچاپ تایپسنس.درخواست با نوع(ک، "POST"، "/stemming/dictionaries/import?id=plurals"، "text/plain"، `{"word":"کتب","root":"کتاب"}`، خ)
    سرچاپ تایپسنس.نسخه کلاینت، ک.nodes.طول()، ک.nearest، ک.api_key.طول()، ک.headers.طول()، ک.state.طول()
    single := تایپسنس.جدید("localhost:8108"، "admin-key")
    سرچاپ single.nodes.بگیر(0)
پایان
