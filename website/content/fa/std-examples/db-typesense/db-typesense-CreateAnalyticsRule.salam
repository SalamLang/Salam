واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    popular := تایپسنس.قاعده تحلیل {
        name = "popular-searches"، kind = تایپسنس.قاعده پرسمان های پرطرفدار، collection = "books"، event_type = تایپسنس.رویداد جستجو،
        params = `{"destination_collection": "popular_queries", "limit": 1000}`
    }
    سرچاپ تایپسنس.جیسون قاعده تحلیل(popular)
    made := تایپسنس.ساخت قاعده تحلیل(ک، popular، خ)
    سرچاپ made.name، made.kind، made.collection، made.event_type، made.params

    clicks := تایپسنس.قاعده تحلیل {
        name = "book-clicks"، kind = تایپسنس.قاعده شمارنده، collection = "books"، event_type = تایپسنس.رویداد کلیک،
        rule_tag = "homepage"، params = `{"destination_collection": "books", "counter_field": "popularity", "weight": 1}`
    }
    سرچاپ تایپسنس.درج قاعده تحلیل(ک، clicks، خ).rule_tag
    سرچاپ تایپسنس.ساخت قاعده تحلیل از جیسون(ک، `{"name": "no-results", "type": "nohits_queries", "collection": "books", "event_type": "search", "params": {"destination_collection": "nohits", "limit": 100}}`، خ)
    سرچاپ تایپسنس.درج قاعده تحلیل از جیسون(ک، "old-style"، `{"type": "popular_queries", "params": {"source": {"collections": ["books"]}, "destination": {"collection": "pq"}}}`، خ)
    سرچاپ تایپسنس.دریافت قاعده تحلیل(ک، "book-clicks"، خ).raw
    هر r در تایپسنس.فهرست قاعده های تحلیل(ک، "homepage"، خ):
        سرچاپ r.name، r.kind
    پایان

    سرچاپ تایپسنس.ارسال رویداد(ک، "book-clicks"، تایپسنس.رویداد کلیک، `{"doc_id": "42", "user_id": "u-7"}`، خ)
    سرچاپ تایپسنس.ارسال رویداد از جیسون(ک، `{"name": "book-clicks", "event_type": "click", "data": {"doc_id": "43", "user_id": "u-7"}}`، خ)
    هر e در تایپسنس.دریافت رویدادها(ک، "u-7"، "book-clicks"، 20، خ):
        سرچاپ e
    پایان
    سرچاپ تایپسنس.تخلیه تحلیل(ک، خ)، تایپسنس.وضعیت تحلیل(ک، خ)
    سرچاپ تایپسنس.حذف قاعده تحلیل(ک، "no-results"، خ)
    سرچاپ تایپسنس.قاعده گزارش، تایپسنس.رویداد تبدیل، تایپسنس.رویداد بازدید، تایپسنس.رویداد سفارشی

    m := تایپسنس.مدل گفتگو {
        id = "books-assistant"، model_name = "openai/gpt-4o-mini"، api_key = "sk-..."، history_collection = "conversations"،
        system_prompt = "تو از کاتالوگ ما کتاب پیشنهاد می‌کنی."، max_bytes = 16384، ttl = 86400، account_id = ""، vllm_url = ""، extra = ""
    }
    سرچاپ تایپسنس.جیسون مدل گفتگو(m)
    سرچاپ تایپسنس.ساخت مدل گفتگو(ک، m، خ)
    سرچاپ تایپسنس.دریافت مدل گفتگو(ک، "books-assistant"، خ)
    سرچاپ تایپسنس.فهرست مدل های گفتگو(ک، خ).طول()
    سرچاپ تایپسنس.به‌روزرسانی مدل گفتگو(ک، "books-assistant"، تایپسنس.مدل گفتگو { system_prompt = "در یک جمله پاسخ بده." }، خ)
    سرچاپ تایپسنس.حذف مدل گفتگو(ک، "books-assistant"، خ)

    سرچاپ تایپسنس.ساخت مدل جستجوی زبانی(ک، `{"id": "gpt-4o-nl", "model_name": "openai/gpt-4o-mini", "api_key": "sk-...", "max_bytes": 16000}`، خ)
    سرچاپ تایپسنس.دریافت مدل جستجوی زبانی(ک، "gpt-4o-nl"، خ)
    سرچاپ تایپسنس.فهرست مدل های جستجوی زبانی(ک، خ).طول()
    سرچاپ تایپسنس.به‌روزرسانی مدل جستجوی زبانی(ک، "gpt-4o-nl"، `{"temperature": 0.0}`، خ)
    سرچاپ تایپسنس.حذف مدل جستجوی زبانی(ک، "gpt-4o-nl"، خ)
پایان
