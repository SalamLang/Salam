واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا s := تایپسنس.طرح { name = "books_v2"، default_sorting_field = "year"، enable_nested_fields = درست }
    s.fields.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    s.fields.بیفزا(تایپسنس.فیلد { name = "title_fa"، kind = تایپسنس.نوع متن، locale = "fa"، stem = درست، optional = درست })
    s.fields.بیفزا(تایپسنس.فیلد دسته بندی("year"، تایپسنس.نوع عدد۳۲))
    s.fields.بیفزا(تایپسنس.فیلد دسته بندی("genres"، تایپسنس.نوع آرایه متن))
    s.fields.بیفزا(تایپسنس.فیلد { name = "price"، kind = تایپسنس.نوع اعشاری، range_index = درست })
    s.fields.بیفزا(تایپسنس.فیلد { name = "isbn"، kind = تایپسنس.نوع متن، index = نادرست، optional = درست })
    s.fields.بیفزا(تایپسنس.فیلد { name = "author_id"، kind = تایپسنس.نوع متن، reference = "authors.id" })
    s.fields.بیفزا(تایپسنس.فیلد { name = "location"، kind = تایپسنس.نوع نقطه جغرافیایی، optional = درست })
    s.fields.بیفزا(تایپسنس.فیلد بردار("embedding"، 384))
    ناپایا from := وکتور {} برگردان وکتور<رشته>
    from.بیفزا("title")
    s.fields.بیفزا(تایپسنس.فیلد جاسازی("title_vector"، from، "ts/all-MiniLM-L12-v2"))
    s.fields.بیفزا(تایپسنس.فیلد { name = "meta.*"، kind = تایپسنس.نوع خودکار، optional = درست })
    s.symbols_to_index.بیفزا("+")
    s.token_separators.بیفزا("-")
    s.metadata = `{"owner": "کاتالوگ"}`
    سرچاپ تایپسنس.جیسون طرح(s)

    col := تایپسنس.ساخت مجموعه(ک، s، خ)
    اگر تایپسنس.تداخل دارد(خ):
        سرچاپ "books_v2 از قبل وجود دارد"
    پایان
    سرچاپ col.name، col.num_documents، col.created_at، col.fields.طول()
    هر f در col.fields:
        سرچاپ f.name، f.kind، f.facet، f.optional، f.sort، f.index، f.store
    پایان

    اگر تایپسنس.مجموعه وجود دارد(ک، "books_v2"، خ):
        سرچاپ تایپسنس.دریافت مجموعه(ک، "books_v2"، خ).default_sorting_field
    پایان
    هر x در تایپسنس.فهرست مجموعه ها(ک، خ):
        سرچاپ x.name، x.num_documents
    پایان
    ناپایا skip := وکتور {} برگردان وکتور<رشته>
    skip.بیفزا("fields")
    سرچاپ تایپسنس.صفحه مجموعه ها(ک، 0، 20، skip، خ).طول()

    ناپایا add := وکتور {} برگردان وکتور<تایپسنس.فیلد>
    add.بیفزا(تایپسنس.فیلد دسته بندی("publisher"، تایپسنس.نوع متن))
    سرچاپ تایپسنس.افزودن فیلدها(ک، "books_v2"، add، خ)
    ناپایا drop := وکتور {} برگردان وکتور<رشته>
    drop.بیفزا("isbn")
    سرچاپ تایپسنس.حذف فیلدها(ک، "books_v2"، drop، خ)
    سرچاپ تایپسنس.تنظیم فراداده مجموعه(ک، "books_v2"، `{"owner": "تیم جستجو"}`، خ)
    سرچاپ تایپسنس.به‌روزرسانی مجموعه(ک، "books_v2"، `{"synonym_sets": ["book-words"]}`، خ)

    a := تایپسنس.درج نام مستعار(ک، "books"، "books_v2"، خ)
    سرچاپ a.name، a.collection_name
    سرچاپ تایپسنس.دریافت نام مستعار(ک، "books"، خ).collection_name
    هر al در تایپسنس.فهرست نام های مستعار(ک، خ):
        سرچاپ al.name، "->"، al.collection_name
    پایان
    سرچاپ تایپسنس.رونوشت مجموعه(ک، "books_v2"، "books_v3"، خ).name
    سرچاپ تایپسنس.خالی کردن مجموعه(ک، "books_v3"، خ)
    سرچاپ تایپسنس.حذف مجموعه(ک، "books_v3"، خ).name
    سرچاپ تایپسنس.حذف نام مستعار(ک، "old_books"، خ).name
    سرچاپ تایپسنس.ساخت مجموعه از جیسون(ک، `{"name": "authors", "fields": [{"name": "name", "type": "string"}]}`، خ).name
    سرچاپ تایپسنس.جیسون فیلد(تایپسنس.فیلد جدید("pages"، تایپسنس.نوع عدد۳۲))
    سرچاپ تایپسنس.نوع متن ستاره، تایپسنس.نوع آرایه عدد۳۲، تایپسنس.نوع عدد۶۴، تایپسنس.نوع آرایه عدد۶۴، تایپسنس.نوع آرایه اعشاری
    سرچاپ تایپسنس.نوع بولی، تایپسنس.نوع آرایه بولی، تایپسنس.نوع آرایه نقطه جغرافیایی، تایپسنس.نوع چندضلعی جغرافیایی
    سرچاپ تایپسنس.نوع شیء، تایپسنس.نوع آرایه شیء، تایپسنس.نوع تصویر
پایان
