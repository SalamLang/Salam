واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا s := تایپسنس.طرح { نام = "books_v2"، فیلد مرتب‌سازی پیش‌فرض = "year"، فیلدهای تودرتو = درست }
    s.فیلدها.بیفزا(تایپسنس.فیلد جدید("title"، تایپسنس.نوع متن))
    s.فیلدها.بیفزا(تایپسنس.فیلد { نام = "title_fa"، نوع = تایپسنس.نوع متن، منطقه زبانی = "fa"، ریشه‌یابی = درست، اختیاری = درست })
    s.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("year"، تایپسنس.نوع عدد۳۲))
    s.فیلدها.بیفزا(تایپسنس.فیلد دسته بندی("genres"، تایپسنس.نوع آرایه متن))
    s.فیلدها.بیفزا(تایپسنس.فیلد { نام = "price"، نوع = تایپسنس.نوع اعشاری، نمایه بازه‌ای = درست })
    s.فیلدها.بیفزا(تایپسنس.فیلد { نام = "isbn"، نوع = تایپسنس.نوع متن، نمایه = نادرست، اختیاری = درست })
    s.فیلدها.بیفزا(تایپسنس.فیلد { نام = "author_id"، نوع = تایپسنس.نوع متن، ارجاع = "authors.id" })
    s.فیلدها.بیفزا(تایپسنس.فیلد { نام = "location"، نوع = تایپسنس.نوع نقطه جغرافیایی، اختیاری = درست })
    s.فیلدها.بیفزا(تایپسنس.فیلد بردار("embedding"، 384))
    ناپایا فیلدهای منبع := وکتور {} برگردان وکتور<رشته>
    فیلدهای منبع.بیفزا("title")
    s.فیلدها.بیفزا(تایپسنس.فیلد جاسازی("title_vector"، فیلدهای منبع، "ts/all-MiniLM-L12-v2"))
    s.فیلدها.بیفزا(تایپسنس.فیلد { نام = "meta.*"، نوع = تایپسنس.نوع خودکار، اختیاری = درست })
    s.نمادهای نمایه‌شده.بیفزا("+")
    s.جداکننده‌های واژه.بیفزا("-")
    s.فراداده = `{"owner": "کاتالوگ"}`
    سرچاپ تایپسنس.جیسون طرح(s)

    مجموعه ساخته := تایپسنس.ساخت مجموعه(ک، s، خ)
    اگر تایپسنس.تداخل دارد(خ):
        سرچاپ "books_v2 از قبل وجود دارد"
    پایان
    سرچاپ مجموعه ساخته.نام، مجموعه ساخته.تعداد سندها، مجموعه ساخته.زمان ساخت، مجموعه ساخته.فیلدها.طول()
    هر f در مجموعه ساخته.فیلدها:
        سرچاپ f.نام، f.نوع، f.دسته‌بندی، f.اختیاری، f.مرتب‌سازی، f.نمایه، f.ذخیره
    پایان

    اگر تایپسنس.مجموعه وجود دارد(ک، "books_v2"، خ):
        سرچاپ تایپسنس.دریافت مجموعه(ک، "books_v2"، خ).فیلد مرتب‌سازی پیش‌فرض
    پایان
    هر x در تایپسنس.فهرست مجموعه ها(ک، خ):
        سرچاپ x.نام، x.تعداد سندها
    پایان
    ناپایا مستثنی ها := وکتور {} برگردان وکتور<رشته>
    مستثنی ها.بیفزا("fields")
    سرچاپ تایپسنس.صفحه مجموعه ها(ک، 0، 20، مستثنی ها، خ).طول()

    ناپایا فیلدهای تازه := وکتور {} برگردان وکتور<تایپسنس.فیلد>
    فیلدهای تازه.بیفزا(تایپسنس.فیلد دسته بندی("publisher"، تایپسنس.نوع متن))
    سرچاپ تایپسنس.افزودن فیلدها(ک، "books_v2"، فیلدهای تازه، خ)
    ناپایا فیلدهای حذفی := وکتور {} برگردان وکتور<رشته>
    فیلدهای حذفی.بیفزا("isbn")
    سرچاپ تایپسنس.حذف فیلدها(ک، "books_v2"، فیلدهای حذفی، خ)
    سرچاپ تایپسنس.تنظیم فراداده مجموعه(ک، "books_v2"، `{"owner": "تیم جستجو"}`، خ)
    سرچاپ تایپسنس.به‌روزرسانی مجموعه(ک، "books_v2"، `{"synonym_sets": ["book-words"]}`، خ)

    a := تایپسنس.درج نام مستعار(ک، "books"، "books_v2"، خ)
    سرچاپ a.نام، a.نام مجموعه
    سرچاپ تایپسنس.دریافت نام مستعار(ک، "books"، خ).نام مجموعه
    هر al در تایپسنس.فهرست نام های مستعار(ک، خ):
        سرچاپ al.نام، "->"، al.نام مجموعه
    پایان
    سرچاپ تایپسنس.رونوشت مجموعه(ک، "books_v2"، "books_v3"، خ).نام
    سرچاپ تایپسنس.خالی کردن مجموعه(ک، "books_v3"، خ)
    سرچاپ تایپسنس.حذف مجموعه(ک، "books_v3"، خ).نام
    سرچاپ تایپسنس.حذف نام مستعار(ک، "old_books"، خ).نام
    سرچاپ تایپسنس.ساخت مجموعه از جیسون(ک، `{"name": "authors", "fields": [{"name": "name", "type": "string"}]}`، خ).نام
    سرچاپ تایپسنس.جیسون فیلد(تایپسنس.فیلد جدید("pages"، تایپسنس.نوع عدد۳۲))
    سرچاپ تایپسنس.نوع متن ستاره، تایپسنس.نوع آرایه عدد۳۲، تایپسنس.نوع عدد۶۴، تایپسنس.نوع آرایه عدد۶۴، تایپسنس.نوع آرایه اعشاری
    سرچاپ تایپسنس.نوع بولی، تایپسنس.نوع آرایه بولی، تایپسنس.نوع آرایه نقطه جغرافیایی، تایپسنس.نوع چندضلعی جغرافیایی
    سرچاپ تایپسنس.نوع شیء، تایپسنس.نوع آرایه شیء، تایپسنس.نوع تصویر
پایان
