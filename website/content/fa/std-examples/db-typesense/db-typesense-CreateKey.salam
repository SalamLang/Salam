واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا کتاب ها := وکتور {} برگردان وکتور<رشته>
    کتاب ها.بیفزا("books")
    کلید جستجوگر := تایپسنس.کلید فقط جستجو(ک، "جستجوی وب‌سایت"، کتاب ها، خ)
    سرچاپ کلید جستجوگر.شناسه، کلید جستجوگر.مقدار، کلید جستجوگر.کنش‌ها.طول()، کلید جستجوگر.مجموعه‌ها.بگیر(0)

    ناپایا کنش های مجاز := وکتور {} برگردان وکتور<رشته>
    کنش های مجاز.بیفزا("documents:*")
    کنش های مجاز.بیفزا("collections:get")
    ناپایا سازمان ها := وکتور {} برگردان وکتور<رشته>
    سازمان ها.بیفزا("org_.*")
    مشخصات نویسنده := تایپسنس.مشخصات کلید { توضیح = "نویسنده‌ی مستاجرها"، کنش‌ها = کنش های مجاز، مجموعه‌ها = سازمان ها، زمان انقضا = 1924992000، حذف خودکار = درست }
    سرچاپ تایپسنس.جیسون مشخصات کلید(مشخصات نویسنده)
    k := تایپسنس.ساخت کلید(ک، مشخصات نویسنده، خ)
    سرچاپ k.مقدار، k.زمان انقضا، k.حذف خودکار

    ناپایا همه کنش ها := وکتور {} برگردان وکتور<رشته>
    همه کنش ها.بیفزا(تایپسنس.کنش کلید همه)
    کلید مدیر := تایپسنس.ساخت کلید(ک، تایپسنس.مشخصات کلید { توضیح = "مدیر"، کنش‌ها = همه کنش ها، مجموعه‌ها = همه کنش ها، مقدار = "my-chosen-admin-key" }، خ)
    سرچاپ کلید مدیر.شناسه

    g := تایپسنس.دریافت کلید(ک، k.شناسه، خ)
    سرچاپ g.پیشوند مقدار، g.توضیح
    هر کلید در تایپسنس.فهرست کلیدها(ک، خ):
        سرچاپ کلید.شناسه، کلید.پیشوند مقدار، کلید.توضیح، کلید.کنش‌ها.طول()، کلید.مجموعه‌ها.طول()، کلید.زمان انقضا
    پایان
    سرچاپ تایپسنس.حذف کلید(ک، k.شناسه، خ)

    دامنه جستجو := تایپسنس.پارامترهای جستجو { فیلتر = "company_id:=124"، فیلدهای مستثنی = "salary" }
    کلید محدود := تایپسنس.کلید جستجوی محدود(کلید جستجوگر.مقدار، دامنه جستجو، 1924992000)
    سرچاپ کلید محدود
    سرچاپ تایپسنس.ساخت کلید جستجوی محدود(کلید جستجوگر.مقدار، `{"filter_by":"user_id:=42"}`)
    ناپایا مرورگر := تایپسنس.جدید("https://search.example.com"، کلید محدود)
    دیرکن تایپسنس.آزادسازی(مرورگر)
    سرچاپ تایپسنس.جستجو(مرورگر، "books"، تایپسنس.جستجوی جدید("تل‌ماسه"، "title")، خ).یافت‌شده
    سرچاپ تایپسنس.کنش کلید جستجو
پایان
