واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا books := وکتور {} برگردان وکتور<رشته>
    books.بیفزا("books")
    search := تایپسنس.کلید فقط جستجو(ک، "جستجوی وب‌سایت"، books، خ)
    سرچاپ search.id، search.value، search.actions.طول()، search.collections.بگیر(0)

    ناپایا actions := وکتور {} برگردان وکتور<رشته>
    actions.بیفزا("documents:*")
    actions.بیفزا("collections:get")
    ناپایا orgs := وکتور {} برگردان وکتور<رشته>
    orgs.بیفزا("org_.*")
    spec := تایپسنس.مشخصات کلید { description = "نویسنده‌ی مستاجرها"، actions = actions، collections = orgs، expires_at = 1924992000، autodelete = درست }
    سرچاپ تایپسنس.جیسون مشخصات کلید(spec)
    k := تایپسنس.ساخت کلید(ک، spec، خ)
    سرچاپ k.value، k.expires_at، k.autodelete

    ناپایا all := وکتور {} برگردان وکتور<رشته>
    all.بیفزا(تایپسنس.کنش کلید همه)
    admin := تایپسنس.ساخت کلید(ک، تایپسنس.مشخصات کلید { description = "مدیر"، actions = all، collections = all، value = "my-chosen-admin-key" }، خ)
    سرچاپ admin.id

    g := تایپسنس.دریافت کلید(ک، k.id، خ)
    سرچاپ g.value_prefix، g.description
    هر key در تایپسنس.فهرست کلیدها(ک، خ):
        سرچاپ key.id، key.value_prefix، key.description، key.actions.طول()، key.collections.طول()، key.expires_at
    پایان
    سرچاپ تایپسنس.حذف کلید(ک، k.id، خ)

    scope := تایپسنس.پارامترهای جستجو { filter_by = "company_id:=124"، exclude_fields = "salary" }
    scoped := تایپسنس.کلید جستجوی محدود(search.value، scope، 1924992000)
    سرچاپ scoped
    سرچاپ تایپسنس.ساخت کلید جستجوی محدود(search.value، `{"filter_by":"user_id:=42"}`)
    ناپایا browser := تایپسنس.جدید("https://search.example.com"، scoped)
    دیرکن تایپسنس.آزادسازی(browser)
    سرچاپ تایپسنس.جستجو(browser، "books"، تایپسنس.جستجوی جدید("تل‌ماسه"، "title")، خ).found
    سرچاپ تایپسنس.کنش کلید جستجو
پایان
