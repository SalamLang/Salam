واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا books := وکتور {} برگردان وکتور<رشته>
    books.بیفزا("books")
    search := تایپسنس.کلید فقط جستجو(ک، "جستجوی وب‌سایت"، books، خ)
    سرچاپ search.شناسه، search.مقدار، search.کنش‌ها.طول()، search.مجموعه‌ها.بگیر(0)

    ناپایا actions := وکتور {} برگردان وکتور<رشته>
    actions.بیفزا("documents:*")
    actions.بیفزا("collections:get")
    ناپایا orgs := وکتور {} برگردان وکتور<رشته>
    orgs.بیفزا("org_.*")
    spec := تایپسنس.مشخصات کلید { توضیح = "نویسنده‌ی مستاجرها"، کنش‌ها = actions، مجموعه‌ها = orgs، زمان انقضا = 1924992000، حذف خودکار = درست }
    سرچاپ تایپسنس.جیسون مشخصات کلید(spec)
    k := تایپسنس.ساخت کلید(ک، spec، خ)
    سرچاپ k.مقدار، k.زمان انقضا، k.حذف خودکار

    ناپایا all := وکتور {} برگردان وکتور<رشته>
    all.بیفزا(تایپسنس.کنش کلید همه)
    admin := تایپسنس.ساخت کلید(ک، تایپسنس.مشخصات کلید { توضیح = "مدیر"، کنش‌ها = all، مجموعه‌ها = all، مقدار = "my-chosen-admin-key" }، خ)
    سرچاپ admin.شناسه

    g := تایپسنس.دریافت کلید(ک، k.شناسه، خ)
    سرچاپ g.پیشوند مقدار، g.توضیح
    هر key در تایپسنس.فهرست کلیدها(ک، خ):
        سرچاپ key.شناسه، key.پیشوند مقدار، key.توضیح، key.کنش‌ها.طول()، key.مجموعه‌ها.طول()، key.زمان انقضا
    پایان
    سرچاپ تایپسنس.حذف کلید(ک، k.شناسه، خ)

    scope := تایپسنس.پارامترهای جستجو { فیلتر = "company_id:=124"، فیلدهای مستثنی = "salary" }
    scoped := تایپسنس.کلید جستجوی محدود(search.مقدار، scope، 1924992000)
    سرچاپ scoped
    سرچاپ تایپسنس.ساخت کلید جستجوی محدود(search.مقدار، `{"filter_by":"user_id:=42"}`)
    ناپایا browser := تایپسنس.جدید("https://search.example.com"، scoped)
    دیرکن تایپسنس.آزادسازی(browser)
    سرچاپ تایپسنس.جستجو(browser، "books"، تایپسنس.جستجوی جدید("تل‌ماسه"، "title")، خ).یافت‌شده
    سرچاپ تایپسنس.کنش کلید جستجو
پایان
