واردسازی دیتابیس.تایپسنس

ساختار کتاب:
    همگانی id: رشته = ""
    همگانی title: رشته = ""
    همگانی year: صحیح = 0
پایان

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    سرچاپ تایپسنس.ساخت سند(ک، "books"، `{"id": "1", "title": "تل‌ماسه", "year": 1965}`، خ)
    سرچاپ تایپسنس.درج سند(ک، "books"، `{"id": "1", "title": "تل‌ماسه", "year": 1965}`، خ)
    سرچاپ تایپسنس.جایگذاری سند(ک، "books"، `{"id": "2", "title": "اِما"}`، خ)
    سرچاپ تایپسنس.به‌روزرسانی سند(ک، "books"، "2"، `{"year": 1815}`، خ)
    سرچاپ تایپسنس.به‌روزرسانی سند با گزینه(ک، "books"، "2"، `{"year": "1815"}`، تایپسنس.ناپاک تبدیل با رد، خ)
    سرچاپ تایپسنس.نمایه سازی سند(ک، "books"، `{"id": "3", "title": "اولیس", "year": "1922"}`، تایپسنس.گزینه های نوشتن { action = تایپسنس.کنش درج، dirty_values = تایپسنس.ناپاک تبدیل با کنار }، خ)
    سرچاپ تایپسنس.دریافت سند(ک، "books"، "1"، خ)
    سرچاپ تایپسنس.سند وجود دارد(ک، "books"، "42"، خ)

    ناپایا b := کتاب {}
    اگر تایپسنس.دریافت سند به نوع(ک، "books"، "1"، b، خ):
        سرچاپ b.title، b.year
    پایان
    سرچاپ تایپسنس.ساخت سند از نوع(ک، "books"، کتاب { id = "4"، title = "دلبند"، year = 1987 }، خ)
    سرچاپ تایپسنس.درج سند از نوع(ک، "books"، کتاب { id = "4"، title = "دلبند"، year = 1987 }، خ)

    ناپایا books := وکتور {} برگردان وکتور<کتاب>
    books.بیفزا(کتاب { id = "5"، title = "هملت"، year = 1603 })
    books.بیفزا(کتاب { id = "6"، title = "میدل‌مارچ"، year = 1871 })
    r := تایپسنس.درون ریزی از نوع(ک، "books"، books، تایپسنس.گزینه های نوشتن { action = تایپسنس.کنش درج، batch_size = 100، return_id = درست }، خ)
    سرچاپ r.success، r.failed، r.ids.طول()، r.documents.طول()، r.lines.طول()
    هر e در r.errors:
        سرچاپ e.line، e.id، e.code، e.error، e.document
    پایان

    ناپایا docs := وکتور {} برگردان وکتور<رشته>
    docs.بیفزا(`{"id": "7", "title": "ترغیب", "year": 1817}`)
    docs.بیفزا(`{"id": "8", "title": "والدن", "year": "1854"}`)
    r2 := تایپسنس.درون ریزی سندها(ک، "books"، docs، تایپسنس.گزینه های نوشتن { action = تایپسنس.کنش ساخت، dirty_values = تایپسنس.ناپاک رد، return_doc = درست }، خ)
    سرچاپ r2.success، r2.failed
    r3 := تایپسنس.درون ریزی جیسون خطی(ک، "books"، "{\"id\": \"9\", \"title\": \"اِما\"}\n"، تایپسنس.گزینه های نوشتن { action = تایپسنس.کنش به‌روزرسانی، remote_embedding_batch_size = 50 }، خ)
    سرچاپ r3.success، تایپسنس.کنش جایگذاری، تایپسنس.ناپاک کنار گذاشتن

    سرچاپ تایپسنس.به‌روزرسانی با پالایه(ک، "books"، "year:<1900"، `{"classic": true}`، خ)
    سرچاپ تایپسنس.حذف با پالایه(ک، "books"، "year:<1700"، 500، خ)
    سرچاپ تایپسنس.حذف سند(ک، "books"، "9"، خ)

    lines := تایپسنس.برون بری سندها(ک، "books"، تایپسنس.گزینه های برون بری { filter_by = "year:>1800"، include_fields = "id,title,year"، exclude_fields = "" }، خ)
    ناپایا back := وکتور {} برگردان وکتور<کتاب>
    اگر تایپسنس.رمزگشایی سندها(lines، back، خ):
        سرچاپ back.طول()
    پایان
    ناپایا one := کتاب {}
    سرچاپ تایپسنس.رمزگشایی سند(`{"id": "1", "title": "تل‌ماسه", "year": 1965}`، one، خ)، one.title
    سرچاپ تایپسنس.برون بری جیسون خطی(ک، "books"، تایپسنس.گزینه های برون بری {}، خ).طول()
پایان
