واردسازی دیتابیس.تایپسنس

ساختار کتاب:
    همگانی id: رشته = ""
    همگانی title: رشته = ""
    همگانی year: صحیح = 0
پایان

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    سرچاپ تایپسنس.ساخت سند(ک، "books"، `{"id": "1", "title": "تل‌ماسه", "year": 1965}`، خ)
    سرچاپ تایپسنس.درج سند(ک، "books"، `{"id": "1", "title": "تل‌ماسه", "year": 1965}`، خ)
    سرچاپ تایپسنس.جایگذاری سند(ک، "books"، `{"id": "2", "title": "اِما"}`، خ)
    سرچاپ تایپسنس.به‌روزرسانی سند(ک، "books"، "2"، `{"year": 1815}`، خ)
    سرچاپ تایپسنس.به‌روزرسانی سند با گزینه(ک، "books"، "2"، `{"year": "1815"}`، تایپسنس.ناپاک تبدیل با رد، خ)
    سرچاپ تایپسنس.نمایه سازی سند(ک، "books"، `{"id": "3", "title": "اولیس", "year": "1922"}`، تایپسنس.گزینه های نوشتن { کنش = تایپسنس.کنش درج، مقدارهای ناپاک = تایپسنس.ناپاک تبدیل با کنار }، خ)
    سرچاپ تایپسنس.دریافت سند(ک، "books"، "1"، خ)
    سرچاپ تایپسنس.سند وجود دارد(ک، "books"، "42"، خ)

    ناپایا بافر_محلی := کتاب {}
    اگر تایپسنس.دریافت سند به نوع(ک، "books"، "1"، بافر_محلی، خ):
        سرچاپ بافر_محلی.title، بافر_محلی.year
    پایان
    سرچاپ تایپسنس.ساخت سند از نوع(ک، "books"، کتاب { id = "4"، title = "دلبند"، year = 1987 }، خ)
    سرچاپ تایپسنس.درج سند از نوع(ک، "books"، کتاب { id = "4"، title = "دلبند"، year = 1987 }، خ)

    ناپایا متغیر_books := وکتور {} برگردان وکتور<کتاب>
    متغیر_books.بیفزا(کتاب { id = "5"، title = "هملت"، year = 1603 })
    متغیر_books.بیفزا(کتاب { id = "6"، title = "میدل‌مارچ"، year = 1871 })
    خوانده := تایپسنس.درون ریزی از نوع(ک، "books"، متغیر_books، تایپسنس.گزینه های نوشتن { کنش = تایپسنس.کنش درج، اندازه دسته = 100، بازگرداندن شناسه = درست }، خ)
    سرچاپ خوانده.موفق، خوانده.ناموفق، خوانده.شناسه‌ها.طول()، خوانده.سندها.طول()، خوانده.سطرها.طول()
    هر عنصر در خوانده.خطاها:
        سرچاپ عنصر.سطر، عنصر.شناسه، عنصر.کد، عنصر.خطا، عنصر.سند
    پایان

    ناپایا متغیر_docs := وکتور {} برگردان وکتور<رشته>
    متغیر_docs.بیفزا(`{"id": "7", "title": "ترغیب", "year": 1817}`)
    متغیر_docs.بیفزا(`{"id": "8", "title": "والدن", "year": "1854"}`)
    متغیر_r2 := تایپسنس.درون ریزی سندها(ک، "books"، متغیر_docs، تایپسنس.گزینه های نوشتن { کنش = تایپسنس.کنش ساخت، مقدارهای ناپاک = تایپسنس.ناپاک رد، بازگرداندن سند = درست }، خ)
    سرچاپ متغیر_r2.موفق، متغیر_r2.ناموفق
    متغیر_r3 := تایپسنس.درون ریزی جیسون خطی(ک، "books"، "{\"id\": \"9\", \"title\": \"اِما\"}\n"، تایپسنس.گزینه های نوشتن { کنش = تایپسنس.کنش به‌روزرسانی، اندازه دسته جاسازی دور = 50 }، خ)
    سرچاپ متغیر_r3.موفق، تایپسنس.کنش جایگذاری، تایپسنس.ناپاک کنار گذاشتن

    سرچاپ تایپسنس.به‌روزرسانی با پالایه(ک، "books"، "year:<1900"، `{"classic": true}`، خ)
    سرچاپ تایپسنس.حذف با پالایه(ک، "books"، "year:<1700"، 500، خ)
    سرچاپ تایپسنس.حذف سند(ک، "books"، "9"، خ)

    خط‌ها := تایپسنس.برون بری سندها(ک، "books"، تایپسنس.گزینه های برون بری { فیلتر = "year:>1800"، فیلدهای شامل = "id,title,year"، فیلدهای مستثنی = "" }، خ)
    ناپایا بازگشت := وکتور {} برگردان وکتور<کتاب>
    اگر تایپسنس.رمزگشایی سندها(خط‌ها، بازگشت، خ):
        سرچاپ بازگشت.طول()
    پایان
    ناپایا متغیر_one := کتاب {}
    سرچاپ تایپسنس.رمزگشایی سند(`{"id": "1", "title": "تل‌ماسه", "year": 1965}`، متغیر_one، خ)، متغیر_one.title
    سرچاپ تایپسنس.برون بری جیسون خطی(ک، "books"، تایپسنس.گزینه های برون بری {}، خ).طول()
پایان
