واردسازی رشته
واردسازی دیتابیس.تایپسنس

ساختار کتاب:
    همگانی id: رشته = ""
    همگانی title: رشته = ""
    همگانی year: صحیح = 0
پایان

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "search-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا p := تایپسنس.جستجوی جدید("تل‌ماسه"، "title,description")
    p.وزن فیلدهای جستجو = "3,1"
    p.فیلتر = "year:>1950 && genres:=[scifi]"
    p.ترتیب = "_text_match:desc,year:desc"
    p.فیلدهای دسته‌بندی = "genres,year"
    p.بیشترین مقدار دسته‌بندی = 10
    p.اندازه صفحه = 20
    p.صفحه = 1
    p.تعداد غلط املایی = "2,1"
    p.برچسب ابتدای برجسته = "<b>"
    p.برچسب انتهای برجسته = "</b>"
    تایپسنس.تنظیم پارامتر(p، "prioritize_exact_match"، "false")
    سرچاپ تایپسنس.متن پرسمان جستجو(p)
    سرچاپ تایپسنس.جیسون پارامترهای جستجو(p)

    r := تایپسنس.جستجو(ک، "books"، p، خ)
    اگر وارونه تایپسنس.موفق(خ):
        سرچاپ تایپسنس.متن خطا(خ)
        برگشت 1
    پایان
    سرچاپ r.یافت‌شده، r.تعداد کل، r.صفحه، r.زمان جستجو میلی‌ثانیه، r.قطع جستجو
    هر h در r.یافته‌ها:
        سرچاپ h.سند، h.امتیاز تطابق متن، h.گزینش‌شده، تایپسنس.برجسته(h، "title")
        سرچاپ h.برجسته، h.برجسته‌ها، h.اطلاعات تطابق متن، h.فاصله برداری، h.فاصله جغرافیایی، h.اطلاعات جستجوی ترکیبی، h.خام.طول()
    پایان
    هر f در r.دسته‌بندی‌ها:
        چاپ f.نام فیلد، f.نمونه‌ای، f.آمار، ":"
        هر fc در f.شمارها:
            چاپ " " + fc.مقدار + "=" + fc.تعداد + " " + fc.برجسته‌شده
        پایان
        سرچاپ ""
    پایان
    ناپایا books := وکتور {} برگردان وکتور<کتاب>
    اگر تایپسنس.یافته ها به نوع(r، books، خ):
        سرچاپ books.طول()
    پایان
    سرچاپ r.پارامترهای درخواست، r.خام.طول()

    ناپایا g := تایپسنس.جستجوی جدید("*"، "")
    g.فیلدهای گروه‌بندی = "genres"
    g.حد گروه = 3
    g.فیلدهای شامل = "id,title"
    rg := تایپسنس.جستجو(ک، "books"، g، خ)
    سرچاپ rg.یافت‌شده، rg.سندهای یافت‌شده
    هر grp در rg.گروه‌ها:
        سرچاپ رشته.بپیوند(grp.کلید، ",")، grp.یافت‌شده، grp.یافته‌ها.طول()
    پایان

    ناپایا v := تایپسنس.جستجوی جدید("*"، "")
    v.پرسمان برداری = "embedding:([0.12, 0.45, 0.87], k: 10)"
    v.فیلدهای مستثنی = "embedding"
    سرچاپ تایپسنس.جستجوی خام(ک، "books"، v، خ)

    ناپایا rag := تایپسنس.جستجوی جدید("کدام کتاب‌ها درباره‌ی بیابان هستند؟"، "title_vector")
    rag.گفتگو = درست
    rag.شناسه مدل گفتگو = "books-assistant"
    rag.شناسه گفتگو = ""
    rag.پیشوند = "false"
    rag.جستجوی کامل = درست
    rag.مهلت جستجو میلی‌ثانیه = 200
    rag.استفاده از کش = درست
    rag.مدت کش = 60
    سرچاپ تایپسنس.جستجو(ک، "books"، rag، خ).گفتگو

    ناپایا nl := تایپسنس.جستجوی جدید("کتاب‌های علمی تخیلی بعد از ۱۹۶۰ به ترتیب سال"، "title")
    nl.پرسمان زبان طبیعی = درست
    nl.شناسه مدل زبان طبیعی = "gpt-4o-nl"
    سرچاپ تایپسنس.جستجو(ک، "books"، nl، خ).پرسمان تفسیرشده

    ناپایا reqs := وکتور {} برگردان وکتور<تایپسنس.درخواست جستجو>
    reqs.بیفزا(تایپسنس.درخواست جستجو { مجموعه = "books"، پارامترها = تایپسنس.جستجوی جدید("تل‌ماسه"، "") })
    reqs.بیفزا(تایپسنس.درخواست جستجو { مجموعه = "authors"، پارامترها = تایپسنس.جستجوی جدید("هربرت"، "name")، کلید دسترسی = "scoped-key" })
    common := تایپسنس.جستجوی جدید(""، "title")
    هر m در تایپسنس.جستجوی چندگانه(ک، reqs، common، خ):
        سرچاپ m.یافت‌شده، m.کد، m.خطا
    پایان
    سرچاپ تایپسنس.جستجوی چندگانه خام(ک، reqs، common، خ).طول()
    u := تایپسنس.جستجوی اجتماع(ک، reqs، common، خ)
    هر h در u.یافته‌ها:
        سرچاپ h.مجموعه، h.شماره جستجو، h.سند
    پایان
    ناپایا rr := تایپسنس.تجزیه نتیجه جستجو(`{"found": 0, "hits": []}`)
    سرچاپ rr.یافت‌شده، rr.کد، rr.خطا، تایپسنس.بیشینه پرسمان دریافت
    تایپسنس.آزادسازی نتیجه(rr)
پایان
