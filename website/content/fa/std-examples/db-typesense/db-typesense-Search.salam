واردسازی رشته
واردسازی دیتابیس.تایپسنس

ساختار کتاب:
    همگانی id: رشته = ""
    همگانی title: رشته = ""
    همگانی year: صحیح = 0
پایان

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "search-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا p := تایپسنس.جستجوی جدید("تل‌ماسه"، "title,description")
    p.query_by_weights = "3,1"
    p.filter_by = "year:>1950 && genres:=[scifi]"
    p.sort_by = "_text_match:desc,year:desc"
    p.facet_by = "genres,year"
    p.max_facet_values = 10
    p.per_page = 20
    p.page = 1
    p.num_typos = "2,1"
    p.highlight_start_tag = "<b>"
    p.highlight_end_tag = "</b>"
    تایپسنس.تنظیم پارامتر(p، "prioritize_exact_match"، "false")
    سرچاپ تایپسنس.متن پرسمان جستجو(p)
    سرچاپ تایپسنس.جیسون پارامترهای جستجو(p)

    r := تایپسنس.جستجو(ک، "books"، p، خ)
    اگر وارونه تایپسنس.موفق(خ):
        سرچاپ تایپسنس.متن خطا(خ)
        برگشت 1
    پایان
    سرچاپ r.found، r.out_of، r.page، r.search_time_ms، r.search_cutoff
    هر h در r.hits:
        سرچاپ h.document، h.text_match، h.curated، تایپسنس.برجسته(h، "title")
        سرچاپ h.highlight، h.highlights، h.text_match_info، h.vector_distance، h.geo_distance_meters، h.hybrid_search_info، h.raw.طول()
    پایان
    هر f در r.facets:
        چاپ f.field_name، f.sampled، f.stats، ":"
        هر fc در f.counts:
            چاپ " " + fc.value + "=" + fc.count + " " + fc.highlighted
        پایان
        سرچاپ ""
    پایان
    ناپایا books := وکتور {} برگردان وکتور<کتاب>
    اگر تایپسنس.یافته ها به نوع(r، books، خ):
        سرچاپ books.طول()
    پایان
    سرچاپ r.request_params، r.raw.طول()

    ناپایا g := تایپسنس.جستجوی جدید("*"، "")
    g.group_by = "genres"
    g.group_limit = 3
    g.include_fields = "id,title"
    rg := تایپسنس.جستجو(ک، "books"، g، خ)
    سرچاپ rg.found، rg.found_docs
    هر grp در rg.groups:
        سرچاپ رشته.بپیوند(grp.key، ",")، grp.found، grp.hits.طول()
    پایان

    ناپایا v := تایپسنس.جستجوی جدید("*"، "")
    v.vector_query = "embedding:([0.12, 0.45, 0.87], k: 10)"
    v.exclude_fields = "embedding"
    سرچاپ تایپسنس.جستجوی خام(ک، "books"، v، خ)

    ناپایا rag := تایپسنس.جستجوی جدید("کدام کتاب‌ها درباره‌ی بیابان هستند؟"، "title_vector")
    rag.conversation = درست
    rag.conversation_model_id = "books-assistant"
    rag.conversation_id = ""
    rag.prefix = "false"
    rag.exhaustive_search = درست
    rag.search_cutoff_ms = 200
    rag.use_cache = درست
    rag.cache_ttl = 60
    سرچاپ تایپسنس.جستجو(ک، "books"، rag، خ).conversation

    ناپایا nl := تایپسنس.جستجوی جدید("کتاب‌های علمی تخیلی بعد از ۱۹۶۰ به ترتیب سال"، "title")
    nl.nl_query = درست
    nl.nl_model_id = "gpt-4o-nl"
    سرچاپ تایپسنس.جستجو(ک، "books"، nl، خ).parsed_nl_query

    ناپایا reqs := وکتور {} برگردان وکتور<تایپسنس.درخواست جستجو>
    reqs.بیفزا(تایپسنس.درخواست جستجو { collection = "books"، params = تایپسنس.جستجوی جدید("تل‌ماسه"، "") })
    reqs.بیفزا(تایپسنس.درخواست جستجو { collection = "authors"، params = تایپسنس.جستجوی جدید("هربرت"، "name")، api_key = "scoped-key" })
    common := تایپسنس.جستجوی جدید(""، "title")
    هر m در تایپسنس.جستجوی چندگانه(ک، reqs، common، خ):
        سرچاپ m.found، m.code، m.error
    پایان
    سرچاپ تایپسنس.جستجوی چندگانه خام(ک، reqs، common، خ).طول()
    u := تایپسنس.جستجوی اجتماع(ک، reqs، common، خ)
    هر h در u.hits:
        سرچاپ h.collection، h.search_index، h.document
    پایان
    ناپایا rr := تایپسنس.تجزیه نتیجه جستجو(`{"found": 0, "hits": []}`)
    سرچاپ rr.found، rr.code، rr.error، تایپسنس.بیشینه پرسمان دریافت
    تایپسنس.آزادسازی نتیجه(rr)
پایان
