واردسازی رشته
واردسازی دیتابیس.تایپسنس

ساختار کتاب:
    همگانی id: رشته = ""
    همگانی title: رشته = ""
    همگانی year: صحیح = 0
پایان

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "search-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا ویژگی_محلی := تایپسنس.جستجوی جدید("تل‌ماسه"، "title,description")
    ویژگی_محلی.وزن فیلدهای جستجو = "3,1"
    ویژگی_محلی.فیلتر = "year:>1950 && genres:=[scifi]"
    ویژگی_محلی.ترتیب = "_text_match:desc,year:desc"
    ویژگی_محلی.فیلدهای دسته‌بندی = "genres,year"
    ویژگی_محلی.بیشترین مقدار دسته‌بندی = 10
    ویژگی_محلی.اندازه صفحه = 20
    ویژگی_محلی.صفحه = 1
    ویژگی_محلی.تعداد غلط املایی = "2,1"
    ویژگی_محلی.برچسب ابتدای برجسته = "<b>"
    ویژگی_محلی.برچسب انتهای برجسته = "</b>"
    تایپسنس.تنظیم پارامتر(ویژگی_محلی، "prioritize_exact_match"، "false")
    سرچاپ تایپسنس.متن پرسمان جستجو(ویژگی_محلی)
    سرچاپ تایپسنس.جیسون پارامترهای جستجو(ویژگی_محلی)

    خوانده := تایپسنس.جستجو(ک، "books"، ویژگی_محلی، خ)
    اگر وارونه تایپسنس.موفق(خ):
        سرچاپ تایپسنس.متن خطا(خ)
        برگشت 1
    پایان
    سرچاپ خوانده.یافت‌شده، خوانده.تعداد کل، خوانده.صفحه، خوانده.زمان جستجو میلی‌ثانیه، خوانده.قطع جستجو
    هر اچ در خوانده.یافته‌ها:
        سرچاپ اچ.سند، اچ.امتیاز تطابق متن، اچ.گزینش‌شده، تایپسنس.برجسته(اچ، "title")
        سرچاپ اچ.برجسته، اچ.برجسته‌ها، اچ.اطلاعات تطابق متن، اچ.فاصله برداری، اچ.فاصله جغرافیایی، اچ.اطلاعات جستجوی ترکیبی، اچ.خام.طول()
    پایان
    هر پرونده_محلی در خوانده.دسته‌بندی‌ها:
        چاپ پرونده_محلی.نام فیلد، پرونده_محلی.نمونه‌ای، پرونده_محلی.آمار، ":"
        هر شمار_قلم در پرونده_محلی.شمارها:
            چاپ " " + شمار_قلم.مقدار + "=" + شمار_قلم.تعداد + " " + شمار_قلم.برجسته‌شده
        پایان
        سرچاپ ""
    پایان
    ناپایا متغیر_books := وکتور {} برگردان وکتور<کتاب>
    اگر تایپسنس.یافته ها به نوع(خوانده، متغیر_books، خ):
        سرچاپ متغیر_books.طول()
    پایان
    سرچاپ خوانده.پارامترهای درخواست، خوانده.خام.طول()

    ناپایا جی := تایپسنس.جستجوی جدید("*"، "")
    جی.فیلدهای گروه‌بندی = "genres"
    جی.حد گروه = 3
    جی.فیلدهای شامل = "id,title"
    متغیر_rg := تایپسنس.جستجو(ک، "books"، جی، خ)
    سرچاپ متغیر_rg.یافت‌شده، متغیر_rg.سندهای یافت‌شده
    هر متغیر_grp در متغیر_rg.گروه‌ها:
        سرچاپ رشته.بپیوند(متغیر_grp.کلید، ",")، متغیر_grp.یافت‌شده، متغیر_grp.یافته‌ها.طول()
    پایان

    ناپایا مقدار_محلی := تایپسنس.جستجوی جدید("*"، "")
    مقدار_محلی.پرسمان برداری = "embedding:([0.12, 0.45, 0.87], k: 10)"
    مقدار_محلی.فیلدهای مستثنی = "embedding"
    سرچاپ تایپسنس.جستجوی خام(ک، "books"، مقدار_محلی، خ)

    ناپایا متغیر_rag := تایپسنس.جستجوی جدید("کدام کتاب‌ها درباره‌ی بیابان هستند؟"، "title_vector")
    متغیر_rag.گفتگو = درست
    متغیر_rag.شناسه مدل گفتگو = "books-assistant"
    متغیر_rag.شناسه گفتگو = ""
    متغیر_rag.پیشوند = "false"
    متغیر_rag.جستجوی کامل = درست
    متغیر_rag.مهلت جستجو میلی‌ثانیه = 200
    متغیر_rag.استفاده از کش = درست
    متغیر_rag.مدت کش = 60
    سرچاپ تایپسنس.جستجو(ک، "books"، متغیر_rag، خ).گفتگو

    ناپایا متغیر_nl := تایپسنس.جستجوی جدید("کتاب‌های علمی تخیلی بعد از ۱۹۶۰ به ترتیب سال"، "title")
    متغیر_nl.پرسمان زبان طبیعی = درست
    متغیر_nl.شناسه مدل زبان طبیعی = "gpt-4o-nl"
    سرچاپ تایپسنس.جستجو(ک، "books"، متغیر_nl، خ).پرسمان تفسیرشده

    ناپایا متغیر_reqs := وکتور {} برگردان وکتور<تایپسنس.درخواست جستجو>
    متغیر_reqs.بیفزا(تایپسنس.درخواست جستجو { مجموعه = "books"، پارامترها = تایپسنس.جستجوی جدید("تل‌ماسه"، "") })
    متغیر_reqs.بیفزا(تایپسنس.درخواست جستجو { مجموعه = "authors"، پارامترها = تایپسنس.جستجوی جدید("هربرت"، "name")، کلید دسترسی = "scoped-key" })
    متغیر_common := تایپسنس.جستجوی جدید(""، "title")
    هر تعداد۲ در تایپسنس.جستجوی چندگانه(ک، متغیر_reqs، متغیر_common، خ):
        سرچاپ تعداد۲.یافت‌شده، تعداد۲.کد، تعداد۲.خطا
    پایان
    سرچاپ تایپسنس.جستجوی چندگانه خام(ک، متغیر_reqs، متغیر_common، خ).طول()
    یو := تایپسنس.جستجوی اجتماع(ک، متغیر_reqs، متغیر_common، خ)
    هر اچ در یو.یافته‌ها:
        سرچاپ اچ.مجموعه، اچ.شماره جستجو، اچ.سند
    پایان
    ناپایا متغیر_rr := تایپسنس.تجزیه نتیجه جستجو(`{"found": 0, "hits": []}`)
    سرچاپ متغیر_rr.یافت‌شده، متغیر_rr.کد، متغیر_rr.خطا، تایپسنس.بیشینه پرسمان دریافت
    تایپسنس.آزادسازی نتیجه(متغیر_rr)
پایان
