واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا واژه های مترادف := وکتور {} برگردان وکتور<رشته>
    واژه های مترادف.بیفزا("کتاب")
    واژه های مترادف.بیفزا("رمان")
    واژه های مترادف.بیفزا("book")
    ناپایا اقلام := وکتور {} برگردان وکتور<تایپسنس.مترادف>
    اقلام.بیفزا(تایپسنس.مترادف { شناسه = "books"، مترادف‌ها = واژه های مترادف })
    دسته مترادف := تایپسنس.درج دسته مترادف(ک، "book-words"، اقلام، خ)
    سرچاپ دسته مترادف.نام، دسته مترادف.مترادف‌ها.طول()
    ناپایا مترادف تک := وکتور {} برگردان وکتور<رشته>
    مترادف تک.بیفزا("جلدشومیز")
    متن_نمونه := تایپسنس.مترادف { شناسه = "paper"، واژه پایه = "کتاب"، مترادف‌ها = مترادف تک، منطقه زبانی = "fa"، نمادهای نمایه‌شده = وکتور {} برگردان وکتور<رشته> }
    سرچاپ تایپسنس.جیسون مترادف(متن_نمونه)
    سرچاپ تایپسنس.درج مترادف دسته(ک، "book-words"، متن_نمونه، خ).واژه پایه
    سرچاپ تایپسنس.دریافت مترادف دسته(ک، "book-words"، "paper"، خ).مترادف‌ها.طول()
    سرچاپ تایپسنس.فهرست مترادف های دسته(ک، "book-words"، خ).طول()، تایپسنس.دریافت دسته مترادف(ک، "book-words"، خ).مترادف‌ها.طول()، تایپسنس.فهرست دسته های مترادف(ک، خ).طول()
    سرچاپ تایپسنس.حذف مترادف دسته(ک، "book-words"، "paper"، خ)

    سرچاپ تایپسنس.درج مترادف(ک، "books"، متن_نمونه، خ).شناسه
    سرچاپ تایپسنس.دریافت مترادف(ک، "books"، "paper"، خ).واژه پایه، تایپسنس.فهرست مترادف ها(ک، "books"، خ).طول()
    سرچاپ تایپسنس.حذف مترادف(ک، "books"، "paper"، خ)

    ناپایا سنجاق ها := وکتور {} برگردان وکتور<تایپسنس.سنجاق>
    سنجاق ها.بیفزا(تایپسنس.سنجاق { شناسه = "42"، جایگاه = 1 })
    ناپایا پنهان ها := وکتور {} برگردان وکتور<رشته>
    پنهان ها.بیفزا("13")
    ناپایا برچسب های قاعده := وکتور {} برگردان وکتور<رشته>
    برچسب های قاعده.بیفزا("summer-sale")
    قاعده نمونه := تایپسنس.قاعده گزینش {
        شناسه = "promote-dune"، پرسمان = "تل‌ماسه"، نوع تطابق = تایپسنس.تطابق دقیق، سنجاق‌شده‌ها = سنجاق ها، پنهان‌شده‌ها = پنهان ها،
        فیلتر یافته‌های سنجاق‌شده = درست، شروع اعتبار = 1924992000، فراداده = `{"campaign": "تابستان"}`
    }
    سرچاپ تایپسنس.جیسون گزینش(قاعده نمونه)
    ناپایا قاعده های نمونه := وکتور {} برگردان وکتور<تایپسنس.قاعده گزینش>
    قاعده های نمونه.بیفزا(قاعده نمونه)
    قاعده های نمونه.بیفزا(تایپسنس.قاعده گزینش {
        شناسه = "sale"، برچسب‌ها = برچسب های قاعده، فیلتر قاعده = "on_sale:=true"، فیلتر = "stock:>0"، ترتیب = "price:asc"،
        نوع تطابق = تایپسنس.تطابق شامل، پرسمان جایگزین = ""، حذف واژه‌های جورشده = درست، توقف پردازش = نادرست،
        انتهای اعتبار = 1956528000، افزوده = ""
    })
    دسته گزینش := تایپسنس.درج دسته گزینش(ک، "promotions"، قاعده های نمونه، خ)
    سرچاپ دسته گزینش.نام، دسته گزینش.قاعده‌ها.طول()
    سرچاپ تایپسنس.درج قاعده دسته گزینش(ک، "promotions"، قاعده نمونه، خ).شناسه
    سرچاپ تایپسنس.دریافت قاعده دسته گزینش(ک، "promotions"، "sale"، خ).ترتیب، تایپسنس.فهرست قاعده های دسته گزینش(ک، "promotions"، خ).طول()
    سرچاپ تایپسنس.دریافت دسته گزینش(ک، "promotions"، خ).قاعده‌ها.طول()، تایپسنس.فهرست دسته های گزینش(ک، خ).طول()
    سرچاپ تایپسنس.حذف قاعده دسته گزینش(ک، "promotions"، "sale"، خ)
    سرچاپ تایپسنس.به‌روزرسانی مجموعه(ک، "books"، `{"synonym_sets": ["book-words"], "curation_sets": ["promotions"]}`، خ)

    سرچاپ تایپسنس.درج بازنویسی(ک، "books"، قاعده نمونه، خ).شناسه
    سرچاپ تایپسنس.دریافت بازنویسی(ک، "books"، "promote-dune"، خ).پرسمان، تایپسنس.فهرست بازنویسی ها(ک، "books"، خ).طول()
    سرچاپ تایپسنس.حذف بازنویسی(ک، "books"، "promote-dune"، خ)

    ناپایا جستجوی فهرست := تایپسنس.جستجوی جدید(""، "title,description")
    جستجوی فهرست.اندازه صفحه = 24
    جستجوی فهرست.ترتیب = "popularity:desc"
    پیش تنظیم ساخته := تایپسنس.درج پیش تنظیم جستجو(ک، "listing"، جستجوی فهرست، خ)
    سرچاپ پیش تنظیم ساخته.نام، پیش تنظیم ساخته.مقدار
    سرچاپ تایپسنس.درج پیش تنظیم(ک، "listing-raw"، `{"query_by": "title"}`، خ).مقدار
    سرچاپ تایپسنس.دریافت پیش تنظیم(ک، "listing"، خ).مقدار
    هر ایکس در تایپسنس.فهرست پیش تنظیم ها(ک، خ):
        سرچاپ ایکس.نام
    پایان
    سرچاپ تایپسنس.حذف پیش تنظیم(ک، "listing-raw"، خ)

    ناپایا کلمات توقف := وکتور {} برگردان وکتور<رشته>
    کلمات توقف.بیفزا("و")
    کلمات توقف.بیفزا("از")
    توقف ساخته := تایپسنس.درج کلمات توقف(ک، "persian"، کلمات توقف، "fa"، خ)
    سرچاپ توقف ساخته.شناسه، توقف ساخته.منطقه زبانی، توقف ساخته.کلمات توقف.طول()
    سرچاپ تایپسنس.دریافت کلمات توقف(ک، "persian"، خ).کلمات توقف.طول()، تایپسنس.فهرست کلمات توقف(ک، خ).طول()
    سرچاپ تایپسنس.حذف کلمات توقف(ک، "persian"، خ)

    ناپایا ریشه ها := وکتور {} برگردان وکتور<تایپسنس.ریشه کلمه>
    ریشه ها.بیفزا(تایپسنس.ریشه کلمه { واژه = "کتب"، واژه پایه = "کتاب" })
    ریشه ها.بیفزا(تایپسنس.ریشه کلمه { واژه = "علوم"، واژه پایه = "علم" })
    سرچاپ تایپسنس.درون ریزی واژه نامه ریشه یابی(ک، "irregular"، ریشه ها، خ)
    سرچاپ تایپسنس.درون ریزی ریشه یابی جیسون خطی(ک، "irregular"، `{"word": "کلمات", "root": "کلمه"}`، خ)
    دال := تایپسنس.دریافت واژه نامه ریشه یابی(ک، "irregular"، خ)
    سرچاپ دال.شناسه، دال.واژه‌ها.طول()
    سرچاپ تایپسنس.فهرست واژه نامه های ریشه یابی(ک، خ).طول()
    سرچاپ تایپسنس.حذف واژه نامه ریشه یابی(ک، "irregular"، خ)
    سرچاپ تایپسنس.حذف دسته گزینش(ک، "promotions"، خ)، تایپسنس.حذف دسته مترادف(ک، "book-words"، خ)
پایان
