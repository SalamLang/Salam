واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا words := وکتور {} برگردان وکتور<رشته>
    words.بیفزا("کتاب")
    words.بیفزا("رمان")
    words.بیفزا("book")
    ناپایا items := وکتور {} برگردان وکتور<تایپسنس.مترادف>
    items.بیفزا(تایپسنس.مترادف { شناسه = "books"، مترادف‌ها = words })
    set := تایپسنس.درج دسته مترادف(ک، "book-words"، items، خ)
    سرچاپ set.نام، set.مترادف‌ها.طول()
    ناپایا one := وکتور {} برگردان وکتور<رشته>
    one.بیفزا("جلدشومیز")
    s := تایپسنس.مترادف { شناسه = "paper"، واژه پایه = "کتاب"، مترادف‌ها = one، منطقه زبانی = "fa"، نمادهای نمایه‌شده = وکتور {} برگردان وکتور<رشته> }
    سرچاپ تایپسنس.جیسون مترادف(s)
    سرچاپ تایپسنس.درج مترادف دسته(ک، "book-words"، s، خ).واژه پایه
    سرچاپ تایپسنس.دریافت مترادف دسته(ک، "book-words"، "paper"، خ).مترادف‌ها.طول()
    سرچاپ تایپسنس.فهرست مترادف های دسته(ک، "book-words"، خ).طول()، تایپسنس.دریافت دسته مترادف(ک، "book-words"، خ).مترادف‌ها.طول()، تایپسنس.فهرست دسته های مترادف(ک، خ).طول()
    سرچاپ تایپسنس.حذف مترادف دسته(ک، "book-words"، "paper"، خ)

    سرچاپ تایپسنس.درج مترادف(ک، "books"، s، خ).شناسه
    سرچاپ تایپسنس.دریافت مترادف(ک، "books"، "paper"، خ).واژه پایه، تایپسنس.فهرست مترادف ها(ک، "books"، خ).طول()
    سرچاپ تایپسنس.حذف مترادف(ک، "books"، "paper"، خ)

    ناپایا pins := وکتور {} برگردان وکتور<تایپسنس.سنجاق>
    pins.بیفزا(تایپسنس.سنجاق { شناسه = "42"، جایگاه = 1 })
    ناپایا hide := وکتور {} برگردان وکتور<رشته>
    hide.بیفزا("13")
    ناپایا tags := وکتور {} برگردان وکتور<رشته>
    tags.بیفزا("summer-sale")
    rule := تایپسنس.قاعده گزینش {
        شناسه = "promote-dune"، پرسمان = "تل‌ماسه"، نوع تطابق = تایپسنس.تطابق دقیق، سنجاق‌شده‌ها = pins، پنهان‌شده‌ها = hide،
        فیلتر یافته‌های سنجاق‌شده = درست، شروع اعتبار = 1924992000، فراداده = `{"campaign": "تابستان"}`
    }
    سرچاپ تایپسنس.جیسون گزینش(rule)
    ناپایا rules := وکتور {} برگردان وکتور<تایپسنس.قاعده گزینش>
    rules.بیفزا(rule)
    rules.بیفزا(تایپسنس.قاعده گزینش {
        شناسه = "sale"، برچسب‌ها = tags، فیلتر قاعده = "on_sale:=true"، فیلتر = "stock:>0"، ترتیب = "price:asc"،
        نوع تطابق = تایپسنس.تطابق شامل، پرسمان جایگزین = ""، حذف واژه‌های جورشده = درست، توقف پردازش = نادرست،
        انتهای اعتبار = 1956528000، افزوده = ""
    })
    cs := تایپسنس.درج دسته گزینش(ک، "promotions"، rules، خ)
    سرچاپ cs.نام، cs.قاعده‌ها.طول()
    سرچاپ تایپسنس.درج قاعده دسته گزینش(ک، "promotions"، rule، خ).شناسه
    سرچاپ تایپسنس.دریافت قاعده دسته گزینش(ک، "promotions"، "sale"، خ).ترتیب، تایپسنس.فهرست قاعده های دسته گزینش(ک، "promotions"، خ).طول()
    سرچاپ تایپسنس.دریافت دسته گزینش(ک، "promotions"، خ).قاعده‌ها.طول()، تایپسنس.فهرست دسته های گزینش(ک، خ).طول()
    سرچاپ تایپسنس.حذف قاعده دسته گزینش(ک، "promotions"، "sale"، خ)
    سرچاپ تایپسنس.به‌روزرسانی مجموعه(ک، "books"، `{"synonym_sets": ["book-words"], "curation_sets": ["promotions"]}`، خ)

    سرچاپ تایپسنس.درج بازنویسی(ک، "books"، rule، خ).شناسه
    سرچاپ تایپسنس.دریافت بازنویسی(ک، "books"، "promote-dune"، خ).پرسمان، تایپسنس.فهرست بازنویسی ها(ک، "books"، خ).طول()
    سرچاپ تایپسنس.حذف بازنویسی(ک، "books"، "promote-dune"، خ)

    ناپایا listing := تایپسنس.جستجوی جدید(""، "title,description")
    listing.اندازه صفحه = 24
    listing.ترتیب = "popularity:desc"
    pr := تایپسنس.درج پیش تنظیم جستجو(ک، "listing"، listing، خ)
    سرچاپ pr.نام، pr.مقدار
    سرچاپ تایپسنس.درج پیش تنظیم(ک، "listing-raw"، `{"query_by": "title"}`، خ).مقدار
    سرچاپ تایپسنس.دریافت پیش تنظیم(ک، "listing"، خ).مقدار
    هر x در تایپسنس.فهرست پیش تنظیم ها(ک، خ):
        سرچاپ x.نام
    پایان
    سرچاپ تایپسنس.حذف پیش تنظیم(ک، "listing-raw"، خ)

    ناپایا sw := وکتور {} برگردان وکتور<رشته>
    sw.بیفزا("و")
    sw.بیفزا("از")
    st := تایپسنس.درج کلمات توقف(ک، "persian"، sw، "fa"، خ)
    سرچاپ st.شناسه، st.منطقه زبانی، st.کلمات توقف.طول()
    سرچاپ تایپسنس.دریافت کلمات توقف(ک، "persian"، خ).کلمات توقف.طول()، تایپسنس.فهرست کلمات توقف(ک، خ).طول()
    سرچاپ تایپسنس.حذف کلمات توقف(ک، "persian"، خ)

    ناپایا stem := وکتور {} برگردان وکتور<تایپسنس.ریشه کلمه>
    stem.بیفزا(تایپسنس.ریشه کلمه { واژه = "کتب"، واژه پایه = "کتاب" })
    stem.بیفزا(تایپسنس.ریشه کلمه { واژه = "علوم"، واژه پایه = "علم" })
    سرچاپ تایپسنس.درون ریزی واژه نامه ریشه یابی(ک، "irregular"، stem، خ)
    سرچاپ تایپسنس.درون ریزی ریشه یابی جیسون خطی(ک، "irregular"، `{"word": "کلمات", "root": "کلمه"}`، خ)
    d := تایپسنس.دریافت واژه نامه ریشه یابی(ک، "irregular"، خ)
    سرچاپ d.شناسه، d.واژه‌ها.طول()
    سرچاپ تایپسنس.فهرست واژه نامه های ریشه یابی(ک، خ).طول()
    سرچاپ تایپسنس.حذف واژه نامه ریشه یابی(ک، "irregular"، خ)
    سرچاپ تایپسنس.حذف دسته گزینش(ک، "promotions"، خ)، تایپسنس.حذف دسته مترادف(ک، "book-words"، خ)
پایان
