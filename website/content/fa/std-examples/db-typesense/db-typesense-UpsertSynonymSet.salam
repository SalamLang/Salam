واردسازی دیتابیس.تایپسنس

تابع ریشه:
    ک := تایپسنس.جدید("http://localhost:8108"، "admin-key")
    ناپایا خ := تایپسنس.خطا {}

    ناپایا words := وکتور {} برگردان وکتور<رشته>
    words.بیفزا("کتاب")
    words.بیفزا("رمان")
    words.بیفزا("book")
    ناپایا items := وکتور {} برگردان وکتور<تایپسنس.مترادف>
    items.بیفزا(تایپسنس.مترادف { id = "books"، synonyms = words })
    set := تایپسنس.درج دسته مترادف(ک، "book-words"، items، خ)
    سرچاپ set.name، set.items.طول()
    ناپایا one := وکتور {} برگردان وکتور<رشته>
    one.بیفزا("جلدشومیز")
    s := تایپسنس.مترادف { id = "paper"، root = "کتاب"، synonyms = one، locale = "fa"، symbols_to_index = وکتور {} برگردان وکتور<رشته> }
    سرچاپ تایپسنس.جیسون مترادف(s)
    سرچاپ تایپسنس.درج مترادف دسته(ک، "book-words"، s، خ).root
    سرچاپ تایپسنس.دریافت مترادف دسته(ک، "book-words"، "paper"، خ).synonyms.طول()
    سرچاپ تایپسنس.فهرست مترادف های دسته(ک، "book-words"، خ).طول()، تایپسنس.دریافت دسته مترادف(ک، "book-words"، خ).items.طول()، تایپسنس.فهرست دسته های مترادف(ک، خ).طول()
    سرچاپ تایپسنس.حذف مترادف دسته(ک، "book-words"، "paper"، خ)

    سرچاپ تایپسنس.درج مترادف(ک، "books"، s، خ).id
    سرچاپ تایپسنس.دریافت مترادف(ک، "books"، "paper"، خ).root، تایپسنس.فهرست مترادف ها(ک، "books"، خ).طول()
    سرچاپ تایپسنس.حذف مترادف(ک، "books"، "paper"، خ)

    ناپایا pins := وکتور {} برگردان وکتور<تایپسنس.سنجاق>
    pins.بیفزا(تایپسنس.سنجاق { id = "42"، position = 1 })
    ناپایا hide := وکتور {} برگردان وکتور<رشته>
    hide.بیفزا("13")
    ناپایا tags := وکتور {} برگردان وکتور<رشته>
    tags.بیفزا("summer-sale")
    rule := تایپسنس.قاعده گزینش {
        id = "promote-dune"، query = "تل‌ماسه"، match_type = تایپسنس.تطابق دقیق، includes = pins، excludes = hide،
        filter_curated_hits = درست، effective_from_ts = 1924992000، metadata = `{"campaign": "تابستان"}`
    }
    سرچاپ تایپسنس.جیسون گزینش(rule)
    ناپایا rules := وکتور {} برگردان وکتور<تایپسنس.قاعده گزینش>
    rules.بیفزا(rule)
    rules.بیفزا(تایپسنس.قاعده گزینش {
        id = "sale"، tags = tags، rule_filter_by = "on_sale:=true"، filter_by = "stock:>0"، sort_by = "price:asc"،
        match_type = تایپسنس.تطابق شامل، replace_query = ""، remove_matched_tokens = درست، stop_processing = نادرست،
        effective_to_ts = 1956528000، extra = ""
    })
    cs := تایپسنس.درج دسته گزینش(ک، "promotions"، rules، خ)
    سرچاپ cs.name، cs.items.طول()
    سرچاپ تایپسنس.درج قاعده دسته گزینش(ک، "promotions"، rule، خ).id
    سرچاپ تایپسنس.دریافت قاعده دسته گزینش(ک، "promotions"، "sale"، خ).sort_by، تایپسنس.فهرست قاعده های دسته گزینش(ک، "promotions"، خ).طول()
    سرچاپ تایپسنس.دریافت دسته گزینش(ک، "promotions"، خ).items.طول()، تایپسنس.فهرست دسته های گزینش(ک، خ).طول()
    سرچاپ تایپسنس.حذف قاعده دسته گزینش(ک، "promotions"، "sale"، خ)
    سرچاپ تایپسنس.به‌روزرسانی مجموعه(ک، "books"، `{"synonym_sets": ["book-words"], "curation_sets": ["promotions"]}`، خ)

    سرچاپ تایپسنس.درج بازنویسی(ک، "books"، rule، خ).id
    سرچاپ تایپسنس.دریافت بازنویسی(ک، "books"، "promote-dune"، خ).query، تایپسنس.فهرست بازنویسی ها(ک، "books"، خ).طول()
    سرچاپ تایپسنس.حذف بازنویسی(ک، "books"، "promote-dune"، خ)

    ناپایا listing := تایپسنس.جستجوی جدید(""، "title,description")
    listing.per_page = 24
    listing.sort_by = "popularity:desc"
    pr := تایپسنس.درج پیش تنظیم جستجو(ک، "listing"، listing، خ)
    سرچاپ pr.name، pr.value
    سرچاپ تایپسنس.درج پیش تنظیم(ک، "listing-raw"، `{"query_by": "title"}`، خ).value
    سرچاپ تایپسنس.دریافت پیش تنظیم(ک، "listing"، خ).value
    هر x در تایپسنس.فهرست پیش تنظیم ها(ک، خ):
        سرچاپ x.name
    پایان
    سرچاپ تایپسنس.حذف پیش تنظیم(ک، "listing-raw"، خ)

    ناپایا sw := وکتور {} برگردان وکتور<رشته>
    sw.بیفزا("و")
    sw.بیفزا("از")
    st := تایپسنس.درج کلمات توقف(ک، "persian"، sw، "fa"، خ)
    سرچاپ st.id، st.locale، st.stopwords.طول()
    سرچاپ تایپسنس.دریافت کلمات توقف(ک، "persian"، خ).stopwords.طول()، تایپسنس.فهرست کلمات توقف(ک، خ).طول()
    سرچاپ تایپسنس.حذف کلمات توقف(ک، "persian"، خ)

    ناپایا stem := وکتور {} برگردان وکتور<تایپسنس.ریشه کلمه>
    stem.بیفزا(تایپسنس.ریشه کلمه { word = "کتب"، root = "کتاب" })
    stem.بیفزا(تایپسنس.ریشه کلمه { word = "علوم"، root = "علم" })
    سرچاپ تایپسنس.درون ریزی واژه نامه ریشه یابی(ک، "irregular"، stem، خ)
    سرچاپ تایپسنس.درون ریزی ریشه یابی جیسون خطی(ک، "irregular"، `{"word": "کلمات", "root": "کلمه"}`، خ)
    d := تایپسنس.دریافت واژه نامه ریشه یابی(ک، "irregular"، خ)
    سرچاپ d.id، d.words.طول()
    سرچاپ تایپسنس.فهرست واژه نامه های ریشه یابی(ک، خ).طول()
    سرچاپ تایپسنس.حذف واژه نامه ریشه یابی(ک، "irregular"، خ)
    سرچاپ تایپسنس.حذف دسته گزینش(ک، "promotions"، خ)، تایپسنس.حذف دسته مترادف(ک، "book-words"، خ)
پایان
