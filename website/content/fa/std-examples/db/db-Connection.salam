واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع گزارش(ا: dyn دیتابیس.اتصال):
    سرچاپ ا.نوع()، ا.معتبر()، ا.پینگ()
    _ := ا.اجرا("CREATE TABLE users (id INTEGER PRIMARY KEY, name TEXT, score REAL)")
    _ := ا.اجرا("INSERT INTO users (name, score) VALUES (" + ا.نقل قول("O'Brien") + ", 7.5)")
    _ := ا.اجرا("INSERT INTO users (name, score) VALUES ('مریم', 9)")
    سرچاپ ا.شناسه آخرین درج()، ا.تعداد تغییرات()

    ر := ا.پرسمان("SELECT id, name, score FROM users ORDER BY id")
    سرچاپ ر.معتبر()، ر.تعداد ستون()، ر.نام ستون(۱)
    تا ر.بعدی():
        سرچاپ ر.عدد صحیح(۰)، ر.متن(۱)، ر.عدد اعشار(۲)، ر.عدد صحیح۶۴(۰)، ر.خالی است(۲)، ر.نوع ستون(۱)
    پایان
    _ := ر.بستن()

    ت := ا.شروع تراکنش()
    سرچاپ ت.معتبر()
    _ := ت.اجرا("UPDATE users SET score = 0")
    ت‌ر := ت.پرسمان("SELECT SUM(score) FROM users")
    _ := ت‌ر.بعدی()
    سرچاپ ت‌ر.عدد اعشار(۰)
    _ := ت‌ر.بستن()
    _ := ت.بازگردانی()
    ت۲ := ا.شروع تراکنش()
    _ := ت۲.اجرا("DELETE FROM users WHERE id = 1")
    _ := ت۲.ثبت تراکنش()

    سرچاپ دیتابیس.پرسمان عدد(ا، "SELECT COUNT(*) FROM users")، دیتابیس.پرسمان عدد۶۴(ا، "SELECT MAX(id) FROM users")
    سرچاپ دیتابیس.پرسمان اعشار(ا، "SELECT score FROM users")، دیتابیس.پرسمان متن(ا، "SELECT name FROM users")
    سرچاپ دیتابیس.شمارش ردیف ها(ا، "SELECT * FROM users")
    سرچاپ دیتابیس.اجرا کن(ا، "INSERT INTO users (name) VALUES ('علی')")، دیتابیس.اجرا کن(ا، "INSERT INTO nowhere VALUES (1)")
    سرچاپ ا.خطا()
    ناپایا دستورها := وکتور {} برگردان وکتور<رشته>
    دستورها.افزودن("INSERT INTO users (name) VALUES ('سارا')")
    دستورها.افزودن("INSERT INTO users (name) VALUES ('رضا')")
    سرچاپ دیتابیس.اجرای همه(ا، دستورها)
    دستورها.افزودن("INSERT INTO nowhere VALUES (1)")
    سرچاپ دیتابیس.در تراکنش(ا، دستورها)، دیتابیس.پرسمان عدد(ا، "SELECT COUNT(*) FROM users")
    سرچاپ دیتابیس.نقل قول("it's")
    _ := ا.بستن()
پایان

تابع ریشه:
    گزارش(اس کیو لایت.اتصال(اس کیو لایت.بازکردن(":memory:")))
    سرچاپ دیتابیس.اس کیو لایت، دیتابیس.مای اس کیو ال، دیتابیس.پستگرس
    سرچاپ دیتابیس.نوع خالی، دیتابیس.نوع صحیح، دیتابیس.نوع اعشاری، دیتابیس.نوع متن، دیتابیس.نوع دودویی
