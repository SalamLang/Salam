واردسازی دیتابیس
واردسازی دیتابیس.اس کیو لایت

تابع ریشه:
    ا := اس کیو لایت.اتصال(اس کیو لایت.بازکردن(":memory:"))
    ناپایا م := دیتابیس.مهاجرت گر جدید()
    دیتابیس.افزودن مهاجرت(م، ۱، "users"، "CREATE TABLE users (id INTEGER PRIMARY KEY, email TEXT NOT NULL)"، "DROP TABLE users")
    دیتابیس.افزودن مهاجرت(م، ۲، "posts"، "CREATE TABLE posts (id INTEGER PRIMARY KEY, title TEXT); INSERT INTO posts (title) VALUES ('سلام')"، "DROP TABLE posts")
    دیتابیس.افزودن مهاجرت(م، ۳، "tags"، "ALTER TABLE posts ADD COLUMN tag TEXT"، "ALTER TABLE posts DROP COLUMN tag")
    سرچاپ دیتابیس.تعداد مهاجرت(م)، دیتابیس.نسخه طرح‌واره(م، ا)، دیتابیس.تعداد در انتظار(م، ا)

    سرچاپ دیتابیس.مهاجرت به(م، ا، ۲)
    سرچاپ دیتابیس.نسخه طرح‌واره(م، ا)، دیتابیس.اعمال شده(م، ا، ۲)، دیتابیس.اعمال شده(م، ا، ۳)
    سرچاپ دیتابیس.مهاجرت به بالا(م، ا)، دیتابیس.نسخه طرح‌واره(م، ا)
    سرچاپ دیتابیس.مهاجرت به بالا(م، ا)
    سرچاپ دیتابیس.بازگردانی(م، ا)، دیتابیس.نسخه طرح‌واره(م، ا)
    سرچاپ دیتابیس.مهاجرت به(م، ا، ۰)، دیتابیس.نسخه طرح‌واره(م، ا)
    سرچاپ دیتابیس.پرسمان عدد(ا، "SELECT COUNT(*) FROM " + دیتابیس.جدول مهاجرت)
    دیتابیس.آزادکردن مهاجرت گر(م)

    ناپایا م۲ := دیتابیس.مهاجرت گر در("app_versions")
    دیتابیس.افزودن مهاجرت(م۲، ۱، "t"، "CREATE TABLE t (x INTEGER)"، "DROP TABLE t")
    سرچاپ دیتابیس.ساخت جدول(م۲، ا)، دیتابیس.مهاجرت به بالا(م۲، ا)، م۲.table
    دیتابیس.آزادکردن مهاجرت گر(م۲)

    تکه‌ها := دیتابیس.جداکردن دستورها("INSERT INTO t VALUES (1); SELECT ';' ; ")
    سرچاپ تکه‌ها.طول()، تکه‌ها.دریافت(۱)
پایان
