واردسازی اشکال زدایی

روال فرزند():
    اشکال زدایی.ورود("فرزند")
    سرچاپ اشکال زدایی.عمق()
    سرچاپ اشکال زدایی.پشته()
    اشکال زدایی.خروج()
پایان

روال ریشه:
    اشکال زدایی.ورود("ریشه")
    فرزند()
    اشکال زدایی.خروج()
    سرچاپ اشکال زدایی.عمق()
    اشکال زدایی.ادعا(۱ + ۱ == ۲، "حساب درست است")
    اشکال زدایی.ادعای خالی نبودن(اشکال زدایی.آمار حافظه() برگردان تهی*، "آمار حافظه")
    اشکال زدایی.فعال‌سازی ردیابی(درست)
    سرچاپ اشکال زدایی.ردیابی فعال است()
    اشکال زدایی.ردیابی("یک پیام ردیابی")
    اشکال زدایی.شروع تایمر("حلقه")
    ناپایا ج := ۰
    تکرار ۱۰۰۰ در ای:
        ج += ای
    پایان
    سرچاپ ج، اشکال زدایی.پایان تایمر("حلقه") >= ۰.۰
    اگر ج < ۰:
        اشکال زدایی.شکست‌نقطه()
    پایان
پایان
