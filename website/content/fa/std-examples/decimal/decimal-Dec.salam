واردسازی اعشاری
واردسازی عدد بزرگ

روال ریشه:
    ناپایا الف := اعشاری.از مقیاس(۱۰۰۵، ۲)
    دیرکن الف.آزادسازی()
    سرچاپ الف.به رشته()، الف.صفر است()، الف.علامت()
    ب := الف.همانند()
    سرچاپ اعشاری.به رشته(ب)، اعشاری.مقیاس(ب)، عدد بزرگ.به رشته(اعشاری.بی‌مقیاس(ب))
    سرچاپ اعشاری.به رشته(اعشاری.صفر())، اعشاری.به رشته(اعشاری.از صحیح(۴۲))
    سرچاپ اعشاری.به رشته(اعشاری.جدید(عدد بزرگ.از صحیح(۳۱۴۱۵)، ۴))
    سرچاپ اعشاری.به رشته(اعشاری.از اعشاری ماشین(۰.۱، ۳))
    سرچاپ اعشاری.صفر است(اعشاری.صفر())، اعشاری.منفی است(اعشاری.از صحیح(-۱))، اعشاری.علامت(الف)
    ناپایا د := اعشاری.همانند(الف)
    اعشاری.آزادسازی(د)
پایان
