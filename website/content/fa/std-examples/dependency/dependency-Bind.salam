واردسازی وابستگی

میانجی Greeter:
    تابع Hello(): رشته
پایان

ساختار English:
    همگانی تابع Hello(): رشته:
        برگشت "hello"
    پایان
پایان

تابع ریشه:
    نویسه := وابستگی.ساخت()
    وابستگی.فراهم کردن(نویسه، "English"، ""، English {}، (_c: وابستگی.ظرف): برگشت English {} پایان)
    وابستگی.پیوند(نویسه، "Greeter"، "English")
    ناپایا جی := English {}
    اگر وابستگی.گرفتن(نویسه، "Greeter"، جی):
        سرچاپ جی.Hello()
    پایان
    وابستگی.بستن(نویسه)
پایان
