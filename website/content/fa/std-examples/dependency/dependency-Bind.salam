واردسازی وابستگی

میانجی Greeter:
    تابع Hello(): رشته
پایان

ساختار English:
    همگانی تابع Hello(): رشته:
        برگشت "hello"
    پایان
پایان

تابع ریشه:
    c := وابستگی.ساخت()
    وابستگی.فراهم کردن(c، "English"، ""، English {}، (_c: وابستگی.ظرف): برگشت English {} پایان)
    وابستگی.پیوند(c، "Greeter"، "English")
    ناپایا g := English {}
    اگر وابستگی.گرفتن(c، "Greeter"، g):
        سرچاپ g.Hello()
    پایان
    وابستگی.بستن(c)
پایان
