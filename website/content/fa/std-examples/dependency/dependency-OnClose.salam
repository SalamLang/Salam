واردسازی وابستگی

ساختار Conn:
    همگانی id: صحیح = 0
پایان

تابع ریشه:
    c := وابستگی.ساخت()
    وابستگی.فراهم کردن(c، "Conn"، ""، Conn {}، (_c: وابستگی.ظرف): برگشت Conn { id = 7 } پایان)
    وابستگی.هنگام بستن(c، "Conn"، Conn {}، (v: Conn): سرچاپ "closing"، v.id پایان)
    ناپایا x := Conn {}
    _ok := وابستگی.گرفتن(c، "Conn"، x)
    وابستگی.بستن(c)
پایان
