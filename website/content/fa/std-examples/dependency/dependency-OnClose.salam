واردسازی وابستگی

ساختار Conn:
    همگانی id: صحیح = 0
پایان

تابع ریشه:
    نویسه := وابستگی.ساخت()
    وابستگی.فراهم کردن(نویسه، "Conn"، ""، Conn {}، (_c: وابستگی.ظرف): برگشت Conn { id = 7 } پایان)
    وابستگی.هنگام بستن(نویسه، "Conn"، Conn {}، (v: Conn): سرچاپ "closing"، v.id پایان)
    ناپایا ایکس := Conn {}
    متغیر__ok := وابستگی.گرفتن(نویسه، "Conn"، ایکس)
    وابستگی.بستن(نویسه)
پایان
