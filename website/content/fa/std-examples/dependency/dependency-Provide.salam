واردسازی وابستگی

تابع ریشه:
    c := وابستگی.ساخت()
    وابستگی.فراهم کردن(c، "Base"، ""، 0، (_c: وابستگی.ظرف): برگشت 10 پایان)
    وابستگی.فراهم کردن(c، "Double"، "Base"، 0، (cx: وابستگی.ظرف):
        ناپایا b := 0
        _ok := وابستگی.گرفتن(cx، "Base"، b)
        برگشت b * 2
    پایان)
    ناپایا d := 0
    اگر وابستگی.گرفتن(c، "Double"، d):
        سرچاپ d
    پایان
    وابستگی.بستن(c)
پایان
