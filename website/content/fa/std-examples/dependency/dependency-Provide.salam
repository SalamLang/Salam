واردسازی وابستگی

تابع ریشه:
    نویسه := وابستگی.ساخت()
    وابستگی.فراهم کردن(نویسه، "Base"، ""، 0، (_c: وابستگی.ظرف): برگشت 10 پایان)
    وابستگی.فراهم کردن(نویسه، "Double"، "Base"، 0، (cx: وابستگی.ظرف):
        ناپایا بافر_محلی := 0
        متغیر__ok := وابستگی.گرفتن(cx، "Base"، بافر_محلی)
        برگشت بافر_محلی * 2
    پایان)
    ناپایا دال := 0
    اگر وابستگی.گرفتن(نویسه، "Double"، دال):
        سرچاپ دال
    پایان
    وابستگی.بستن(نویسه)
پایان
