واردسازی وابستگی

ساختار Config:
    همگانی port: صحیح = 0
پایان

تابع ریشه:
    نویسه := وابستگی.ساخت()
    وابستگی.مقدار(نویسه، "Config"، Config { port = 8080 })
    ناپایا پیکربندی := Config {}
    اگر وابستگی.گرفتن(نویسه، "Config"، پیکربندی):
        سرچاپ پیکربندی.port
    پایان
    وابستگی.بستن(نویسه)
پایان
