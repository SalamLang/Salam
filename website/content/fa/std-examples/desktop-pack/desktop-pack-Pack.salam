واردسازی برنامه رومیزی.دارایی فشرده

تابع ریشه:
    سرچاپ دارایی فشرده.فشرده کردن پوشه("www"، "app.pack"، "com.example.app")
    سرچاپ دارایی فشرده.افزودن فشرده("app"، "app.pack")
    ناپایا بازشده := دارایی فشرده.فشرده {}
    اگر دارایی فشرده.باز کردن("app"، "com.example.app"، بازشده):
        سرچاپ بازشده.مسیر، بازشده.کلید، بازشده.شمار()
        داده خوانده := بازشده.خواندن("index.html")
        سرچاپ داده خوانده.داده != پوچ، داده خوانده.اندازه
    پایان
    سرچاپ دارایی فشرده.خواندن بازه("app.pack"، ۰ برگردان صحیح۶۴، ۴ برگردان صحیح۶۴) != پوچ
پایان
