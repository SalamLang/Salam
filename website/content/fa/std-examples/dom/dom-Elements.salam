واردسازی دام

روال ریشه:
    فهرست := دام.بساز("ul")
    دام.تنظیم ویژگی(فهرست، "id"، "books")
    دام.افزودن(دام.بدنه()، فهرست)
    تکرار ۳ در ش:
        م := دام.بساز("li")
        دام.تنظیم متن(م، "کتاب " + (ش + ۱))
        دام.افزودن کلاس(م، "book")
        دام.افزودن(فهرست، م)
    پایان
    سرچاپ دام.وجود دارد("books")، دام.وجود دارد("nothing")

    همه := دام.پرسمان همه("li.book")
    سرچاپ دام.تعداد(همه)
    دوم := دام.عنصر شماره(همه، ۱)
    سرچاپ دام.دریافت متن(دوم)
    دام.تعویض کلاس(دوم، "selected")
    سرچاپ دام.دریافت ویژگی(دوم، "class")
    دام.حذف کلاس(دوم، "book")
    سرچاپ دام.دریافت ویژگی(دوم، "class")

    دام.تنظیم سبک(دوم، "color"، "red")
    سرچاپ دام.دریافت سبک(دوم، "color")
    اول := دام.پرسمان("li")
    دام.برداشتن(اول)
    سرچاپ دام.تعداد(دام.پرسمان همه("li"))

    ج := دام.با شناسه("books")
    دام.تنظیم اچ تی ام ال(ج، "<li>تازه</li>")
پایان
