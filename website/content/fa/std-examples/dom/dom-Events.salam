واردسازی دام

ناپایا شمار := ۰

تابع ریشه:
    دکمه := دام.بساز("button")
    دام.تنظیم متن(دکمه، "بزن")
    دام.تنظیم ویژگی(دکمه، "data-autofire"، "click")
    دام.افزودن(دام.بدنه()، دکمه)
    دام.هنگام رویداد(دکمه، "click"، ():
        شمار += ۱
        سرچاپ "کلیک"، شمار
    پایان)

    جعبه := دام.بساز("input")
    دام.تنظیم ویژگی(جعبه، "data-autofire"، "keydown")
    دام.افزودن(دام.بدنه()، جعبه)
    دام.تنظیم مقدار(جعبه، "سلام")
    سرچاپ دام.دریافت مقدار(جعبه)
    دام.هنگام رویداد جزئی(جعبه، "keydown"، (ر: صحیح۶۴):
        اگر دام.کلید رویداد(ر) == "Enter":
            دام.جلوگیری پیش فرض(ر)
        پایان
        دام.توقف انتشار(ر)
        سرچاپ "هدف:"، دام.دریافت مقدار(دام.هدف رویداد(ر))
    پایان)

    دام.رویداد جزئی پنجره("mousemove"، (ر: صحیح۶۴):
        سرچاپ دام.رویداد افقی(ر)، دام.رویداد عمودی(ر)
    پایان)
    دام.رویداد جزئی پنجره("touchstart"، (ر: صحیح۶۴):
        سرچاپ دام.لمس افقی(ر)، دام.لمس عمودی(ر)
    پایان)
    دام.رویداد پنجره("scroll"، ():
        سرچاپ دام.پیمایش افقی()، دام.پیمایش عمودی()
    پایان)
    دام.هنگام آماده(():
        سرچاپ "صفحه آماده است"
    پایان)
    دام.هنگام تغییر اندازه(():
        سرچاپ دام.عرض پنجره()، دام.ارتفاع پنجره()
    پایان)
پایان
