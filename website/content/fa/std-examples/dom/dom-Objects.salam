واردسازی دام

تابع ریشه:
    س := دام.سند()
    سرچاپ دام.دریافت خاصیت رشته ای(س، "title")
    دام.تنظیم خاصیت رشته ای(س، "title"، "صفحه‌ی من")
    سرچاپ دام.دریافت خاصیت رشته ای(س، "title")
    پ := دام.پنجره()
    سرچاپ دام.دریافت خاصیت عددی(پ، "innerWidth") == دام.عرض پنجره()
    سرچاپ دام.عرض سند() > ۰، دام.ارتفاع سند() > ۰

    جعبه := دام.بساز("input")
    دام.تنظیم خاصیت منطقی(جعبه، "disabled"، درست)
    سرچاپ دام.دریافت خاصیت منطقی(جعبه، "disabled")
    دام.تنظیم خاصیت عددی(جعبه، "tabIndex"، ۳)
    سرچاپ دام.دریافت خاصیت عددی(جعبه، "tabIndex")
    دام.تنظیم خاصیت(جعبه، "parentRef"، دام.بدنه())
    سرچاپ دام.دریافت خاصیت(جعبه، "parentRef") == دام.بدنه()

    ریاضی := دام.سراسری("Math")
    سرچاپ دام.فراخوان یک(ریاضی، "abs"، -۵)، دام.فراخوان دو(ریاضی، "max"، ۲، ۹)
    سرچاپ دام.فراخوان سه(ریاضی، "max"، ۱، ۲، ۳)، دام.فراخوان چهار(ریاضی، "min"، ۴، ۳، ۲، ۱)
    _ := دام.فراخوان(جعبه، "focus")
    _ := دام.فراخوان رشته یک(جعبه، "removeAttribute"، "placeholder")
    _ := دام.فراخوان رشته دو(جعبه، "setAttribute"، "name"، "q")
    سرچاپ دام.دریافت ویژگی(جعبه، "name")

    بوم := دام.بساز("canvas")
    ز := دام.دریافت زمینه(بوم، "2d")
    سرچاپ ز != ۰

    دام.تنظیم عدد ذخیره("best"، ۴۲)
    دام.تنظیم متن ذخیره("name"، "مریم")
    سرچاپ دام.دریافت عدد ذخیره("best")، دام.دریافت متن ذخیره("name")

    ت := دام.تصادفی()
    سرچاپ ت >= ۰.۰ و ت < ۱.۰، دام.تصادفی صحیح(۶) < ۶
    سرچاپ دام.اکنون() >= ۰.۰

    دکمه := دام.بساز("button")
    سلام کن := ():
        سرچاپ "سلام"
    پایان
    دام.هنگام رویداد(دکمه، "click"، سلام کن)
    دام.توقف رویداد(دکمه، "click"، سلام کن)

    عکس := دام.بارگذاری تصویر("logo.png")
    سرچاپ دام.تصویر آماده(عکس)
    دام.صدا(۴۴۰، ۲۰۰)
    اگر دام.تایید("ادامه بدهیم؟"):
        نام := دام.درخواست ورودی("نامت چیست؟")
        دام.هشدار("سلام " + نام)
    پایان
پایان
