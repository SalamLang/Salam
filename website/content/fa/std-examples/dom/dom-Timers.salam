واردسازی دام

ناپایا تیک := ۰
ناپایا بازه := ۰ برگردان صحیح۶۴

تابع ریشه:
    دام.تنظیم عنوان("زمان‌سنج")
    آغاز := دام.اکنون()
    _ := دام.تنظیم مهلت(():
        سرچاپ "یک ثانیه گذشت"
    پایان، ۱۰۰۰)
    لغو := دام.تنظیم مهلت(():
        سرچاپ "این اجرا نمی‌شود"
    پایان، ۵۰۰۰)
    دام.پاک کردن مهلت(لغو)
    بازه = دام.تنظیم بازه(():
        تیک += ۱
        اگر تیک == ۳:
            دام.پاک کردن بازه(بازه)
        پایان
    پایان، ۲۰۰)
    دام.درخواست فریم((زمان: اعشار۶۴):
        سرچاپ "فریم پس از"، زمان - آغاز
    پایان)
    دام.چرخش فریم((زمان: اعشار۶۴):
        _ := زمان
    پایان)
پایان
