واردسازی کدگذاری.سی اس وی
واردسازی کدگذاری.مقدار

تابع ریشه خطادار:
    متن := "name,city\nعلی,تهران\n\"سارا، مهندس\",\"شیراز\"\n"
    ناپایا ج := تلاش سی اس وی.خواندن همه(متن)
    سرچاپ ج.ردیف‌ها.طول()
    هر ر در ج.ردیف‌ها:
        سرچاپ ر.خانه‌ها.طول()، ر.خانه‌ها[۰]
    پایان
    سرچاپ سی اس وی.نوشتن همه(ج)
    سی اس وی.آزادسازی جدول(ج)
    سرچاپ تلاش سی اس وی.خواندن خط(`a,"b,c",d`)
    ناپایا خانه‌ها := وکتور {} برگردان وکتور<رشته>
    خانه‌ها.بیفزا("ساده")
    خانه‌ها.بیفزا(`با "نقل"`)
    سرچاپ سی اس وی.نوشتن خط(خانه‌ها)
    م := تلاش سی اس وی.به مقدار("name,age\nعلی,30\n")
    سرچاپ مقدار.طول آرایه(م)، مقدار.به رشته(مقدار.مقدار کلید(مقدار.عضو آرایه(م، ۰)، "name"))
    سرچاپ سی اس وی.از مقدار(م)
    گ := سی اس وی.گزینه‌های سی اس وی { سرستون = نادرست }
    ب := تلاش سی اس وی.به مقدار سفارشی("1,2\n3,4\n"، گ)
    سرچاپ مقدار.طول آرایه(ب)، سی اس وی.از مقدار سفارشی(ب، گ)
    نقطه‌ویرگول := سی اس وی.گزینه‌های سی اس وی { جداکننده = ";" }
    ناپایا اروپایی := تلاش سی اس وی.خواندن همه سفارشی("name;price\n\"Tea; green\";2,50\n"، نقطه‌ویرگول)
    سرچاپ اروپایی.ردیف‌ها.بگیر(۱).خانه‌ها، سی اس وی.نوشتن خط سفارشی(اروپایی.ردیف‌ها.بگیر(۱).خانه‌ها، نقطه‌ویرگول)
    سرچاپ سی اس وی.نوشتن همه سفارشی(اروپایی، سی اس وی.گزینه‌های سی اس وی { جداکننده = "\t" }).طول()
    سی اس وی.آزادسازی جدول(اروپایی)
    خالی := تلاش سی اس وی.خواندن همه سفارشی("a\n\nb\n"، سی اس وی.گزینه‌های سی اس وی { نگه داشتن خط خالی = درست })
    سرچاپ خالی.ردیف‌ها.طول()، تلاش سی اس وی.خواندن خط سفارشی("x|y"، سی اس وی.گزینه‌های سی اس وی { جداکننده = "|" })
    تلاش:
        سی اس وی.خواندن همه("id,note\n1,\"open\n")
    گرفتن خطا خ:
        سرچاپ خ.به رشته()، خ.کد
    پایان
پایان
