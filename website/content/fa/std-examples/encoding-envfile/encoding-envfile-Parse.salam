واردسازی کدگذاری.پرونده محیط
واردسازی کدگذاری.خطای کدگذاری

روال ریشه:
    متن := "# تنظیمات\nHOST=localhost\nPORT=8080\nexport NAME=\"سلام دنیا\"\nURL=http://${HOST}:${PORT}/\n"
    ناپایا س := پرونده محیط.تجزیه(متن)
    سرچاپ پرونده محیط.طول(س)، پرونده محیط.کلیدها(س)
    سرچاپ پرونده محیط.دریافت(س، "NAME")، پرونده محیط.دارد(س، "DEBUG")، پرونده محیط.دریافت با پیش فرض(س، "DEBUG"، "false")
    سرچاپ پرونده محیط.کلید در(س، ۰)، پرونده محیط.مقدار در(س، ۱)
    سرچاپ پرونده محیط.دریافت(س، "URL")
    خام := پرونده محیط.تجزیه خام(متن)
    سرچاپ پرونده محیط.دریافت(خام، "URL")، پرونده محیط.نام‌های ارجاع(خام)
    ناپایا پایه := پرونده محیط.جدید()
    گسترده := پرونده محیط.گسترش سند(خام، پایه)
    سرچاپ پرونده محیط.دریافت(گسترده، "URL")
    سرچاپ پرونده محیط.گسترش("${HOST}/api"، س، پایه)، پرونده محیط.نام‌های ارجاع در("$A و ${B}")
    پرونده محیط.تنظیم(س، "DEBUG"، "true")
    سرچاپ پرونده محیط.حذف(س، "URL")
    سرچاپ پرونده محیط.قالب(س)
    سرچاپ پرونده محیط.قالب صادراتی(پایه) == ""، پرونده محیط.نقل قول("a b")
    ناپایا دیگر := پرونده محیط.تجزیه("PORT=9090\nMODE=prod\n")
    پرونده محیط.ادغام در(س، دیگر)
    سرچاپ پرونده محیط.دریافت(س، "PORT")، پرونده محیط.دریافت(س، "MODE")
    ناپایا خ := خطای کدگذاری.بدون خطا()
    _ := پرونده محیط.تجزیه سخت گیرانه("=بی‌کلید\n"، خ)
    سرچاپ خطای کدگذاری.خطا است(خ)، پرونده محیط.معتبر("A=1\n")
    سرچاپ پرونده محیط.تجزیه مقدار(`"a\tb"`)، پرونده محیط.تجزیه مقدار گسترده("x ; comment"، درست)
    پرونده محیط.آزادسازی(س)
    پرونده محیط.آزادسازی(خام)
    پرونده محیط.آزادسازی(پایه)
    پرونده محیط.آزادسازی(گسترده)
    پرونده محیط.آزادسازی(دیگر)
پایان
