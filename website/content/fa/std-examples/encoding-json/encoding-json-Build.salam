واردسازی کدگذاری.جیسون

تابع ریشه:
    ناپایا برچسب‌ها := وکتور {} برگردان وکتور<رشته>
    برچسب‌ها.بیفزا(جیسون.رشته جیسون("سلام"))
    برچسب‌ها.بیفزا(جیسون.رشته جیسون(`خط "نقل"`))
    ناپایا اعضا := وکتور {} برگردان وکتور<رشته>
    اعضا.بیفزا(جیسون.عضو("name"، "علی"))
    اعضا.بیفزا(جیسون.عضو عدد("age"، ۳۰))
    اعضا.بیفزا(جیسون.عضو منطقی("admin"، نادرست))
    اعضا.بیفزا(جیسون.عضو اعشار("score"، ۱۸.۵))
    اعضا.بیفزا(جیسون.عضو خام("tags"، جیسون.آرایه(برچسب‌ها)))
    متن := جیسون.شیء(اعضا)
    سرچاپ متن
    سرچاپ جیسون.معتبر(متن)، جیسون.معتبر("{ناقص")
    سرچاپ جیسون.دریافت(متن، "name")، جیسون.دریافت عدد(متن، "age")، جیسون.دریافت اعشار(متن، "score")
    سرچاپ جیسون.دارد(متن، "admin")، جیسون.دارد(متن، "email")، جیسون.کلیدها(متن)
    سرچاپ جیسون.اسکیپ("یک\tدو")
    زیبا := جیسون.تورفتگی(متن)
    سرچاپ زیبا
    سرچاپ جیسون.فشرده سازی(زیبا) == جیسون.فشرده سازی(متن)
    سرچاپ جیسون.تورفتگی چهار(`{"a":1}`)
    سرچاپ جیسون.تورفتگی تب(`{"a":1}`) == "{\n\t\"a\": 1\n}"، جیسون.تورفتگی سفارشی(`[1]`، "--")
پایان
