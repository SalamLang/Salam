واردسازی کدگذاری.جیسون

ساختار کاربر:
    @جیسون "name"
    همگانی نام: رشته = ""
    @جیسون "age"
    همگانی سن: صحیح = ۰
    @جیسون "tags"
    همگانی برچسب‌ها: وکتور<رشته> = وکتور {}
    @جیسون "-"
    همگانی گذرواژه: رشته = ""
پایان

تابع ریشه:
    ناپایا ک := کاربر { نام = "مریم"، سن = ۲۸، گذرواژه = "راز" }
    ک.برچسب‌ها.بیفزا("مدیر")
    سرچاپ جیسون.سریال سازی(ک)
    سرچاپ جیسون.سریال سازی با تورفتگی(ک، "  ")
    ناپایا خوانده := کاربر {}
    تلاش:
        جیسون.واسریال سازی(`{"name": "رضا", "age": 41, "tags": ["a", "b"]}`، خوانده)
        سرچاپ خوانده.نام، خوانده.سن، خوانده.برچسب‌ها.طول()
        جیسون.واسریال سازی(`{"name": "رضا", "age": "چهل"}`، خوانده)
    گرفتن خطا خ:
        سرچاپ خ.نام نوع()، خ.به رشته()
    پایان
    ناپایا آسان := کاربر {}
    تلاش:
        جیسون.واسریال سازی آسان گیر(`{"name": "سارا", "extra": 1}`، آسان)
        سرچاپ آسان.نام
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
    پایان
    سرچاپ جیسون.طرحواره(ک)
    پوشش := جیسون.پوشش طرحواره(ک)
    سرچاپ جیسون.ادغام طرحواره(پوشش) == جیسون.طرحواره(ک)
پایان
