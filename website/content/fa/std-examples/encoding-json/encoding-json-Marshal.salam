واردسازی کدگذاری.جیسون
واردسازی کدگذاری.خطای کدگذاری

ساختار کاربر:
    @json "name"
    همگانی نام: رشته = ""
    @json "age"
    همگانی سن: صحیح = ۰
    @json "tags"
    همگانی برچسب‌ها: وکتور<رشته> = وکتور {}
    @json "-"
    همگانی گذرواژه: رشته = ""
پایان

روال ریشه:
    ناپایا ک := کاربر { نام = "مریم"، سن = ۲۸، گذرواژه = "راز" }
    ک.برچسب‌ها.بیفزا("مدیر")
    سرچاپ جیسون.سریال سازی(ک)
    سرچاپ جیسون.سریال سازی با تورفتگی(ک، "  ")
    ناپایا خوانده := کاربر {}
    ناپایا خ := خطای کدگذاری.بدون خطا()
    سرچاپ جیسون.واسریال سازی(`{"name": "رضا", "age": 41, "tags": ["a", "b"]}`، خوانده، خ)
    سرچاپ خوانده.نام، خوانده.سن، خوانده.برچسب‌ها.طول()
    سرچاپ جیسون.واسریال سازی(`{"name": "رضا", "age": "چهل"}`، خوانده، خ)، خ.message
    ناپایا آسان := کاربر {}
    سرچاپ جیسون.واسریال سازی آسان گیر(`{"name": "سارا", "extra": 1}`، آسان، خ)، آسان.نام
    سرچاپ جیسون.طرحواره(ک)
    پوشش := جیسون.پوشش طرحواره(ک)
    سرچاپ جیسون.ادغام طرحواره(پوشش) == جیسون.طرحواره(ک)
پایان
