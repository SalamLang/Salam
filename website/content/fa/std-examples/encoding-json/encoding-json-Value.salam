واردسازی کدگذاری.جیسون
واردسازی کدگذاری.مقدار
واردسازی سیستم پرونده.پرونده

تابع ریشه خطادار:
    م := تلاش جیسون.کدگشایی(`{"city": "تهران", "zones": [1, 2, 22]}`)
    سرچاپ تلاش م.عضو("city").متن()
    سرچاپ جیسون.کدگذاری پیش فرض(م)
    گ := جیسون.گزینه‌های جیسون { تورفتگی = "  "، چیدن کلیدها = درست }
    سرچاپ جیسون.کدگذاری(م، گ)
    تلاش:
        _ := جیسون.کدگشایی("[1, 2")
    گرفتن خطا خ:
        سرچاپ خ.نام نوع()، خ.جایگاه، خ.به رشته()
    پایان
    ناپایا ک := جیسون.کدگذار حافظه()
    ک.کدگذاری(مقدار.مقدار صحیح(۱))
    ک.کدگذاری(مقدار.مقدار رشته("دو"))
    سرچاپ ک.متن()
    ک.بستن()
    ناپایا ت := جیسون.کدگذار حافظه با تورفتگی("  ")
    ت.کدگذاری(م)
    سرچاپ ت.متن()
    ت.بستن()
    ن := پرونده.بازکردن("lines.ndjson"، "wb")
    ناپایا پن := جیسون.کدگذار جدید(ن)
    پن.کدگذاری(مقدار.مقدار صحیح(۱۰))
    پن.کدگذاری(مقدار.مقدار صحیح(۲۰))
    پن.بستن()
    ناپایا پت := جیسون.کدگذار جدید با تورفتگی(پرونده.بازکردن("pretty.json"، "wb")، "\t")
    پت.کدگذاری(م)
    پت.بستن()
    ناپایا خوان := جیسون.کدگشای جدید(پرونده.بازکردن("lines.ndjson"، "rb"))
    ناپایا جمع := ۰ برگردان صحیح۶۴
    تا خوان.باز هم():
        جمع += تلاش خوان.کدگشایی().عدد صحیح()
    پایان
    سرچاپ جمع
    ناپایا گ۲ := جیسون.کدگشای رشته("{\"a\": 1}\n{\"a\": 2}\n")
    تا گ۲.باز هم():
        سرچاپ جیسون.کدگذاری پیش فرض(تلاش گ۲.کدگشایی())
    پایان
پایان
