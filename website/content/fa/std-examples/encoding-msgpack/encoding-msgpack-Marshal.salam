واردسازی فشرده سازی

تابع ریشه خطادار:
    ناپایا م := مقدار.شیء جدید()
    مقدار.تنظیم کلید(م، "id"، مقدار.مقدار صحیح(۷))
    مقدار.تنظیم کلید(م، "ok"، مقدار.مقدار منطقی(درست))
    ب := مسج‌پک.سریال سازی(م)
    سرچاپ فشرده سازی.طول بافر(ب)، فشرده سازی.بافر به پایه۶۴(ب)
    ب۲ := تلاش مسج‌پک.واسریال سازی(ب)
    سرچاپ مقدار.یکسان است(م، ب۲)، تلاش ب۲.عضو("id").عدد صحیح()
    ب۳ := تلاش مسج‌پک.واسریال سازی بایت‌ها(ب.داده، ب.طول)
    سرچاپ مقدار.یکسان است(م، ب۳)
    گ := مسج‌پک.گزینه‌های مسج‌پک {}
    سرچاپ فشرده سازی.طول بافر(مسج‌پک.سریال سازی سفارشی(م، گ))
    سرچاپ کدگذاری.کدگذاری شانزده(فشرده سازی.بافر به رشته(مسج‌پک.سریال سازی(مقدار.مقدار صحیح(۵))))
