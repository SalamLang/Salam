واردسازی کدگذاری.پروتوباف
واردسازی رشته

تابع ریشه خطادار:
    منبع := "syntax = \"proto3\";\nmessage Ping { string text = 1; }\nservice Echo {\n  rpc Say (Ping) returns (Ping);\n  rpc Stream (stream Ping) returns (stream Ping);\n}\n"
    کد := تلاش پروتوباف.تولید کد(منبع)
    سرچاپ رشته.شامل است(کد، "struct Ping")، رشته.شامل است(کد، "UnmarshalPing(data: void*, n: int): Ping throws")
    پ := تلاش پروتوباف.تجزیه پرونده(منبع)
    سرچاپ پروتوباف.تعداد سرویس‌ها(پ)، پروتوباف.نام سرویس(پ، ۰)، پروتوباف.تعداد متدهای سرویس(پ، ۰)
    سرچاپ پروتوباف.امضای متد(پ، ۰، ۰)
    سرچاپ پروتوباف.امضای متد(پ، ۰، ۱)
    سرچاپ رشته.شامل است(پروتوباف.تولید سرویس‌ها(پ)، "Echo")
    همه := تلاش پروتوباف.تولید با سرویس‌ها(منبع)
    سرچاپ رشته.طول(همه) > رشته.طول(کد)، رشته.شامل است(همه، "EchoStreamRecv(ch &: grpc.Channel, sid: int, got &: bool): Ping throws")
    سرچاپ تلاش پروتوباف.خلاصه سرویس(منبع)
    تلاش:
        _ := پروتوباف.تولید کد("message Ping { string text = 1 }")
    گرفتن خطا اشکال:
        سرچاپ اشکال.به رشته()
    پایان
پایان
