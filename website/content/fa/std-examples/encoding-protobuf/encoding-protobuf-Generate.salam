واردسازی کدگذاری.پروتوباف
واردسازی رشته

تابع ریشه:
    منبع := "syntax = \"proto3\";\nmessage Ping { string text = 1; }\nservice Echo {\n  rpc Say (Ping) returns (Ping);\n  rpc Stream (stream Ping) returns (stream Ping);\n}\n"
    ناپایا خوب := نادرست
    کد := پروتوباف.تولید کد(منبع، خوب)
    سرچاپ خوب، رشته.شامل است(کد، "struct Ping")
    پ := پروتوباف.تجزیه پرونده(منبع، خوب)
    سرچاپ پروتوباف.تعداد سرویس‌ها(پ)، پروتوباف.نام سرویس(پ، ۰)، پروتوباف.تعداد متدهای سرویس(پ، ۰)
    سرچاپ پروتوباف.امضای متد(پ، ۰، ۰)
    سرچاپ پروتوباف.امضای متد(پ، ۰، ۱)
    سرچاپ رشته.شامل است(پروتوباف.تولید سرویس‌ها(پ)، "Echo")
    همه := پروتوباف.تولید با سرویس‌ها(منبع، خوب)
    سرچاپ خوب، رشته.طول(همه) > رشته.طول(کد)
    سرچاپ پروتوباف.خلاصه سرویس(منبع، خوب)
پایان
