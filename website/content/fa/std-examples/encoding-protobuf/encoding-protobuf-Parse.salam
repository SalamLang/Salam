واردسازی کدگذاری.پروتوباف

روال ریشه:
    منبع := "syntax = \"proto3\";\npackage shop;\n\nenum Status { OPEN = 0; DONE = 1; }\n\nmessage Order {\n  int64 id = 1;\n  repeated string items = 2;\n  map<string, int32> counts = 3;\n  Status status = 4;\n  oneof pay { string card = 5; bool cash = 6; }\n}\n\nservice Orders {\n  rpc Get (Order) returns (Order);\n  rpc Watch (Order) returns (stream Order);\n}\n"
    ناپایا خوب := نادرست
    پ := پروتوباف.تجزیه پرونده(منبع، خوب)
    سرچاپ خوب، پ.packageName، پ.messages.طول()، پ.enums.طول()، پ.services.طول()، پ.imports.طول()
    پیام := پ.messages[۰]
    سرچاپ پیام.name، پیام.fields.طول()، پیام.oneofs[۰].name، پیام.oneofs[۰].fieldIndices
    هر ف در پیام.fields:
        سرچاپ ف.number، ف.name، پروتوباف.نام نوع فیلد(ف.kind)، ف.typeName، ف.repeated، ف.oneofIndex
    پایان
    م := پیام.fields[۲]
    سرچاپ م.kind == پروتوباف.نوع فیلد نگاشت، پروتوباف.نام نوع فیلد(م.keyKind)، پروتوباف.نام نوع فیلد(م.mapValueKind)
    ش := پ.enums[۰]
    سرچاپ ش.name، ش.values[۱].name، ش.values[۱].number
    س := پ.services[۰]
    سرچاپ س.name، س.methods[۱].name، س.methods[۱].inputType، س.methods[۱].serverStream، س.methods[۱].clientStream
    سرچاپ پروتوباف.نوع ساده از نام("sint64") == پروتوباف.نوع فیلد صحیح۶۴ زیگزاگ، پروتوباف.نوع ساده از نام("Order")
    ناپایا ن := پروتوباف.نشانه گذاری("message A { int32 x = 1; }"، خوب)
    سرچاپ خوب، ن.toks.طول()، ن.toks[۰].lexeme، ن.toks[۰].kind == پروتوباف.نشانه شناسه، ن.toks[۲].kind == پروتوباف.نشانه آکولاد باز
    سرچاپ ن.toks[۶].ival، ن.toks[۶].line
    _ := پروتوباف.تجزیه پرونده("message {"، خوب)
    سرچاپ خوب
پایان
