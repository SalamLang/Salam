واردسازی کدگذاری.پروتوباف

تابع ریشه:
    منبع := "syntax = \"proto3\";\npackage shop;\n\nenum Status { OPEN = 0; DONE = 1; }\n\nmessage Order {\n  int64 id = 1;\n  repeated string items = 2;\n  map<string, int32> counts = 3;\n  Status status = 4;\n  oneof pay { string card = 5; bool cash = 6; }\n}\n\nservice Orders {\n  rpc Get (Order) returns (Order);\n  rpc Watch (Order) returns (stream Order);\n}\n"
    ناپایا خوب := نادرست
    پ := پروتوباف.تجزیه پرونده(منبع، خوب)
    سرچاپ خوب، پ.نام پکیج، پ.پیام‌ها.طول()، پ.شمارشی‌ها.طول()، پ.سرویس‌ها.طول()، پ.پرونده‌های واردشده.طول()
    پیام := پ.پیام‌ها[۰]
    سرچاپ پیام.نام، پیام.فیلدها.طول()، پیام.گروه‌های یکی از[۰].نام، پیام.گروه‌های یکی از[۰].شماره فیلدها
    هر ف در پیام.فیلدها:
        سرچاپ ف.شماره، ف.نام، پروتوباف.نام نوع فیلد(ف.نوع)، ف.نام نوع، ف.تکرارشونده، ف.شماره گروه یکی از
    پایان
    م := پیام.فیلدها[۲]
    سرچاپ م.نوع == پروتوباف.نوع فیلد نگاشت، پروتوباف.نام نوع فیلد(م.نوع کلید)، پروتوباف.نام نوع فیلد(م.نوع مقدار نقشه)
    ش := پ.شمارشی‌ها[۰]
    سرچاپ ش.نام، ش.مقدارها[۱].نام، ش.مقدارها[۱].عدد
    س := پ.سرویس‌ها[۰]
    سرچاپ س.نام، س.متدها[۱].نام، س.متدها[۱].نوع درخواست، س.متدها[۱].خروجی جریانی، س.متدها[۱].ورودی جریانی
    سرچاپ پروتوباف.نوع ساده از نام("sint64") == پروتوباف.نوع فیلد صحیح۶۴ زیگزاگ، پروتوباف.نوع ساده از نام("Order")
    ناپایا ن := پروتوباف.نشانه گذاری("message A { int32 x = 1; }"، خوب)
    سرچاپ خوب، ن.نشانه‌ها.طول()، ن.نشانه‌ها[۰].متن، ن.نشانه‌ها[۰].نوع == پروتوباف.نشانه شناسه، ن.نشانه‌ها[۲].نوع == پروتوباف.نشانه آکولاد باز
    سرچاپ ن.نشانه‌ها[۶].مقدار صحیح، ن.نشانه‌ها[۶].شماره خط
    _ := پروتوباف.تجزیه پرونده("message {"، خوب)
    سرچاپ خوب
پایان
