واردسازی کدگذاری.پرس‌وجو

تابع ریشه:
    متن := "q=%D8%B3%D9%84%D8%A7%D9%85&page=2&tag=a&tag=b&empty="
    سرچاپ پرس‌وجو.مقدار(متن، "q")، پرس‌وجو.مقدار(متن، "page")، پرس‌وجو.دارد(متن، "empty")، پرس‌وجو.دارد(متن، "x")
    سرچاپ پرس‌وجو.همه مقدارها(متن، "tag")
    ناپایا ن := پرس‌وجو.کدگشایی(متن)
    سرچاپ پرس‌وجو.اندازه(ن)، پرس‌وجو.کلیدها(ن)
    پرس‌وجو.افزودن(ن، "tag"، "c")
    پرس‌وجو.تنظیم(ن، "page"، "3")
    سرچاپ پرس‌وجو.حذف(ن، "empty")
    سرچاپ پرس‌وجو.کدگذاری(ن)
    ناپایا نگه := وکتور {} برگردان وکتور<رشته>
    نگه.بیفزا("q")
    پرس‌وجو.نگه داشتن(ن، نگه)
    سرچاپ پرس‌وجو.کدگذاری(ن)
    گ := پرس‌وجو.گزینه‌های پرس‌وجو {}
    سرچاپ پرس‌وجو.کدگذاری سفارشی(پرس‌وجو.کدگشایی سفارشی("b=2&a=1"، گ)، گ)
    خالی := پرس‌وجو.نگاشت پرس‌وجو جدید()
    سرچاپ پرس‌وجو.اندازه(خالی)
پایان
