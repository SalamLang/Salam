واردسازی کدگذاری.تبدیل قالب

تابع ریشه:
    جیسون := `{"name": "salam", "port": 8080, "tags": ["a", "b"]}`
    سرچاپ تبدیل قالب.تشخیص قالب(جیسون)، تبدیل قالب.تشخیص قالب("a: 1\nb: 2\n")، تبدیل قالب.تشخیص قالب("<a/>")، تبدیل قالب.تشخیص قالب("[x]\ny = 1\n")، تبدیل قالب.تشخیص قالب("a,b\n1,2\n")
    سرچاپ تبدیل قالب.تشخیص شماره قالب(جیسون) == تبدیل قالب.قالب جیسون، تبدیل قالب.قالب ناشناخته، تبدیل قالب.قالب یامل، تبدیل قالب.قالب تامل، تبدیل قالب.قالب اکس‌ام‌ال، تبدیل قالب.قالب سی اس وی
    سرچاپ تبدیل قالب.تبدیل قالب(جیسون، "json"، "yaml")
    سرچاپ تبدیل قالب.تبدیل قالب(جیسون، "json"، "toml")
    سرچاپ تبدیل قالب.تبدیل قالب("name,age\nعلی,30\n"، "csv"، "json")
    ناپایا شد := نادرست
    _ := تبدیل قالب.تبدیل قالب سخت گیرانه(جیسون، "json"، "pdf"، شد)
    سرچاپ شد
پایان
