// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع ریشه:
    ناپایا وپتس := اسلاگ.گزینه ها {}
    وپتس = اسلاگ.گزینه های پیش فرض()
    وپتس.جداکننده = "_"
    وپتس.بیشینه طول = 20
    وپتس.زبان متن = "de"
    اسلاگ.افزودن کلمه های توقف(وپتس، "the of")
    اسلاگ.افزودن جایگزین(وپتس، "&"، " und ")
    سرچاپ اسلاگ.ساخت با گزینه("The Best of Müller & Söhne in Köln"، وپتس)
    اسلاگ.آزادسازی گزینه ها(وپتس)

    سرچاپ اسلاگ.ساخت با گزینه("Report (final).pdf"، اسلاگ.نام پرونده())
    سرچاپ اسلاگ.ساخت با گزینه("9 lives"، اسلاگ.شناسه())
    سرچاپ اسلاگ.ساخت با گزینه("Привет мир"، اسلاگ.یونیکد())
    سرچاپ اسلاگ.ساخت با گزینه("a b c"، اسلاگ.آدرس وب())
پایان
