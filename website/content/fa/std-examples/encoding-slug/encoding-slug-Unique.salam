// زبان: فارسی
واردسازی کدگذاری.اسلاگ

تابع وسید(س: رشته): منطقی:
    برگشت س برابر "post" یا س برابر "post-2"
پایان

تابع ریشه:
    سرچاپ اسلاگ.یکتا("post"، (س: رشته): برگشت وسید(س) پایان)
    سرچاپ اسلاگ.یکتا با جداکننده("post"، "_"، (س: رشته): برگشت وسید(س) پایان)
    سرچاپ اسلاگ.شماره دار("post"، 5، "-")
    سرچاپ اسلاگ.اسلاگ است("post-3")
    سرچاپ اسلاگ.اسلاگ است با گزینه("Post_3"، اسلاگ.اسنیک())
پایان
