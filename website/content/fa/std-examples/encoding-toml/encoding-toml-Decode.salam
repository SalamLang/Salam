واردسازی کدگذاری.تامل
واردسازی کدگذاری.مقدار

روال ریشه:
    متن := "title = \"سلام\"\n\n[server]\nhost = \"localhost\"\nport = 8080\ntags = [\"a\", \"b\"]\n"
    سرچاپ تامل.معتبر(متن)، تامل.معتبر("= بدون کلید")
    م := تامل.کدگشایی(متن)
    س := مقدار.مقدار کلید(م، "server")
    سرچاپ مقدار.به رشته(مقدار.مقدار کلید(م، "title"))، مقدار.به صحیح(مقدار.مقدار کلید(س، "port"))
    سرچاپ تامل.کدگذاری(م)
    ناپایا خوانده شد := نادرست
    _ := تامل.کدگشایی سخت گیرانه("a = \n"، خوانده شد)
    سرچاپ خوانده شد
    ناپایا نوشت := نادرست
    سرچاپ تامل.کدگذاری سخت گیرانه(مقدار.مقدار صحیح(۱)، نوشت)، نوشت
پایان
