// زبان: فارسی
واردسازی کدگذاری.یولید

تابع ریشه:
    یدس := یولید.دسته جدید(5)
    دیرکن یدس.آزادکن()
    ناپایا ینکریاسینگ := یدس.طول() برابر 5
    تکرار یدس.طول() - 1 در ی:
        اگر وارونه یولید.کوچکتر است(یدس.بگیر(ی)، یدس.بگیر(ی + 1)):
            ینکریاسینگ = نادرست
        پایان
    پایان
    سرچاپ یدس.طول()، ینکریاسینگ
پایان
