// زبان: فارسی
واردسازی کدگذاری.یولید

تابع ریشه:
    یارلی := یولید.کمینه برای(1000)
    لاتی := یولید.بیشینه برای(1000)
    سرچاپ یولید.مقایسه(یارلی، لاتی)، یولید.مقایسه(لاتی، یارلی)، یولید.مقایسه(یارلی، یارلی)
    سرچاپ یولید.رشته(یارلی)
    سرچاپ یولید.رشته(لاتی)
    سرچاپ یولید.صفر است(یولید.کمینه برای(0))، یولید.صفر است(یارلی)
    گام := یولید.افزایش(یارلی)
    سرچاپ یولید.رشته(گام.شناسه)
    سرچاپ یولید.افزایش(لاتی).موفق
پایان
