// زبان: فارسی
واردسازی کدگذاری.یولید

ناپایا تیکک := 2000 برگردان صحیح۶۴

تابع کلوکک(): صحیح۶۴:
    برگشت تیکک
پایان

تابع سوورکی(): صحیح۶۴:
    برگشت 3
پایان

تابع ریشه:
    وون := یولید.تولیدکننده جدید()
    سرچاپ یولید.آخرین(وون).موفق
    یولید.آزادکن(وون)
    گ := یولید.تولیدکننده جدید با((): برگشت کلوکک() پایان، (): برگشت سوورکی() پایان)
    ر := یولید.بعدی(گ)
    سرچاپ ر.موفق، ر.خطا، یولید.رشته(ر.شناسه)
    سرچاپ یولید.آخرین(گ).موفق، یولید.برابر است(یولید.آخرین(گ).شناسه، ر.شناسه)
    سرچاپ گ.وضعیت نابرابر پوچ
    یولید.آزادکن(گ)
پایان
