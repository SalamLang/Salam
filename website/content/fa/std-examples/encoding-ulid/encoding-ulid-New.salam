واردسازی کدگذاری.یولید

تابع ریشه:
    شناسه := یولید.جدید()
    متن := یولید.رشته(شناسه)
    سرچاپ متن.طول()، یولید.رشته جدید().طول()
    سرچاپ یولید.زمان شناسه(شناسه) - یولید.اکنون() کوچکتر 5000
    سرچاپ یولید.برابر است(شناسه، یولید.تجزیه(متن).شناسه)
    سرچاپ یولید.کوچکتر است(شناسه، یولید.جدید())
    ستامپ := یولید.جدید برای(1469918176385)
    سرچاپ ستامپ.موفق، ستامپ.خطا برابر یولید.بدون خطا، یولید.زمان شناسه(ستامپ.شناسه)
    سرچاپ یولید.آخرین(یولید.پیش فرض()).موفق
    سرچاپ شناسه.زمان بزرگتر 0، شناسه.بالا بزرگتربرابر 0، شناسه.پایین بزرگتربرابر 0
