// زبان: فارسی
واردسازی کدگذاری.یولید

تابع ریشه:
    الف := یولید.جدید()
    ب := یولید.رشته جدید()
    سرچاپ یولید.رشته(الف).طول()، ب.طول()
    سرچاپ یولید.کوچکتر است(الف، یولید.تجزیه(ب).شناسه)
    ی := یولید.جدید برای(1469918176385)
    سرچاپ ی.موفق، یولید.زمان شناسه(ی.شناسه)، ی.شناسه.زمان
    سرچاپ یولید.جدید برای(یولید.بیشینه زمان + 1).خطا برابر یولید.خطای زمان
    سرچاپ یولید.اکنون() بزرگتر 1700000000000
    پایانی := یولید.آخرین(یولید.پیش فرض())
    سرچاپ پایانی.موفق، یولید.کوچکتر است(الف، پایانی.شناسه)
    تازه := یولید.تولیدکننده جدید()
    دیرکن یولید.آزادکن(تازه)
    سرچاپ یولید.آخرین(تازه).خطا برابر یولید.خطای زمان
پایان
