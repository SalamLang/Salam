// زبان: فارسی
واردسازی کدگذاری.یولید

ناپایا تیکک := 100 برگردان صحیح۶۴

تابع کلوکک(): صحیح۶۴:
    برگشت تیکک
پایان

تابع سوورکی(): صحیح۶۴:
    برگشت 1
پایان

تابع ریشه:
    گ := یولید.تولیدکننده جدید با((): برگشت کلوکک() پایان، (): برگشت سوورکی() پایان)
    دیرکن یولید.آزادکن(گ)
    اول := یولید.بعدی(گ)
    سیکوند := یولید.بعدی(گ)
    سرچاپ یولید.رشته(اول.شناسه)
    سرچاپ یولید.رشته(سیکوند.شناسه)
    سرچاپ یولید.کوچکتر است(اول.شناسه، سیکوند.شناسه)
    فورکید := یولید.بعدی برای(گ، 50)
    سرچاپ یولید.زمان شناسه(فورکید.شناسه)، یولید.کوچکتر است(سیکوند.شناسه، فورکید.شناسه)
پایان
