    سرچاپ تلاش نشانی وب.نام پارامترها(ن)، پرس‌وجو.اندازه(تلاش نشانی وب.پرس‌وجو(ن))
    تلاش نشانی وب.تنظیم پارامتر(ن، "page"، "3")
    سرچاپ تلاش نشانی وب.حذف پارامتر(ن، "sort")، نشانی وب.متن(ن)
    ناپایا نگه := وکتور {} برگردان وکتور<رشته>
    نگه.بیفزا("page")
    تلاش نشانی وب.نگه داشتن پارامترها(ن، نگه)
    ناپایا پ := پرس‌وجو.نگاشت پرس‌وجو جدید()
    پرس‌وجو.افزودن(پ، "q"، "سلام دنیا")
    نشانی وب.تنظیم پرس‌وجو(ن، پ)
    سرچاپ نشانی وب.متن(ن)
    نشانی وب.پاک کردن پرس‌وجو(ن)
    سرچاپ نشانی وب.متن(ن)
