واردسازی کدگذاری.نشانی وب
واردسازی کدگذاری.پرس‌وجو

تابع ریشه:
    ناپایا ن := نشانی وب.تجزیه نشانی("https://user%20a:pw@shop.example.co.uk:8443/کتاب/%D8%B3%D9%84%D8%A7%D9%85?page=2&sort=new#top")
    سرچاپ ن.scheme، ن.host، ن.port، ن.path، ن.raw_query، ن.fragment
    سرچاپ نشانی وب.نام میزبان(ن)، نشانی وب.میزبان با درگاه(ن)، نشانی وب.نشانی عددی است(ن)
    سرچاپ نشانی وب.برچسب‌های میزبان(ن)، نشانی وب.پسوند عمومی(ن)، نشانی وب.دامنه(ن)، نشانی وب.زیردامنه(ن)
    سرچاپ نشانی وب.مسیر کدگشایی‌شده(ن)، نشانی وب.اطلاعات کاربر کدگشایی‌شده(ن)
    سرچاپ نشانی وب.نام پارامترها(ن)، پرس‌وجو.اندازه(نشانی وب.پرس‌وجو(ن))
    نشانی وب.تنظیم پارامتر(ن، "page"، "3")
    سرچاپ نشانی وب.حذف پارامتر(ن، "sort")، نشانی وب.متن(ن)
    ناپایا نگه := وکتور {} برگردان وکتور<رشته>
    نگه.بیفزا("page")
    نشانی وب.نگه داشتن پارامترها(ن، نگه)
    ناپایا پ := پرس‌وجو.نگاشت پرس‌وجو جدید()
    پرس‌وجو.افزودن(پ، "q"، "سلام دنیا")
    نشانی وب.تنظیم پرس‌وجو(ن، پ)
    سرچاپ نشانی وب.متن(ن)
    نشانی وب.پاک کردن پرس‌وجو(ن)
    سرچاپ نشانی وب.متن(ن)
    سرچاپ نشانی وب.متن(نشانی وب.پیوستن نشانی(ن، "../img/a.png"))، نشانی وب.کدگذاری بخش مسیر("a b/c")
    سرچاپ نشانی وب.نشانی عددی است(نشانی وب.تجزیه نشانی("http://127.0.0.1/"))
