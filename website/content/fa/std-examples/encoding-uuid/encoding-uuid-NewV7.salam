// زبان: فارسی
واردسازی کدگذاری.یو یو آی دی

تابع ریشه:
    یدس := یو یو آی دی.دسته نسخه۷(5)
    دیرکن یدس.آزادکن()
    ناپایا وردیرید := درست
    تکرار یدس.طول() - 1 در ی:
        اگر وارونه یو یو آی دی.پیش از(یدس.بگیر(ی)، یدس.بگیر(ی + 1)): وردیرید = نادرست پایان
    پایان
    سرچاپ "version"، یو یو آی دی.نسخه(یدس.بگیر(0))، "ordered"، وردیرید
    سرچاپ یو یو آی دی.زمان دارد(یدس.بگیر(0))
پایان
