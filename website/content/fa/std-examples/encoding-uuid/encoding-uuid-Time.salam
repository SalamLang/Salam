// زبان: فارسی
واردسازی کدگذاری.یو یو آی دی

تابع ریشه:
    و1 := یو یو آی دی.نسخه۱ از اجزا(0x1EC9414C232AB00، 0x33C8، 0x9F6BDECED846)
    و6 := یو یو آی دی.نسخه۶ از اجزا(0x1EC9414C232AB00، 0x33C8، 0x9F6BDECED846)
    سرچاپ و1
    سرچاپ و6
    سرچاپ یو یو آی دی.میلی ثانیه یونیکس(و1)،
        یو یو آی دی.دنباله ساعت(و6)،
        یو یو آی دی.گره(و1) برابر 0x9F6BDECED846
    سرچاپ یو یو آی دی.برچسب زمانی(و1) برابر یو یو آی دی.برچسب زمانی(و6)
    ا := یو یو آی دی.ساخت نسخه۱()
    ب := یو یو آی دی.ساخت نسخه۱()
    سرچاپ یو یو آی دی.برچسب زمانی(ا) کوچکتر یو یو آی دی.برچسب زمانی(ب)،
        یو یو آی دی.گره(ا) برابر یو یو آی دی.شناسه گره()
    وون := یو یو آی دی.ساخت نسخه۱ با گره(0x0123456789AB)
    سرچاپ یو یو آی دی.گره(وون) برابر 0x0123456789AB، یو یو آی دی.نسخه(یو یو آی دی.ساخت نسخه۶())
پایان
