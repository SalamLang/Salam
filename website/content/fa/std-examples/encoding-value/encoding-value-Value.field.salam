واردسازی کدگذاری.جیسون

تابع ریشه خطادار:
    سند := تلاش جیسون.کدگشایی(`{"name": "چراغ", "price": 19.5, "stock": 12, "sale": true, "tags": ["خانه", "نور"]}`)
    سرچاپ تلاش سند.عضو("name").متن()
    سرچاپ تلاش سند.عضو("price").عدد اعشاری()
    سرچاپ تلاش سند.عضو("stock").عدد صحیح()
    سرچاپ تلاش سند.عضو("sale").درستی()
    سرچاپ تلاش سند.عضو("tags").عنصر(۱).متن()
    تلاش:
        سرچاپ سند.عضو("color").متن()
    گرفتن خطا خ:
        سرچاپ خ.نام نوع()، "->"، خ.پیام
    پایان
    تلاش:
        سرچاپ سند.عضو("tags").عنصر(۵).متن()
    گرفتن خطا خ:
        سرچاپ خ.نام نوع()، "->"، خ.پیام
    پایان
    تلاش:
        سرچاپ سند.عضو("name").عدد صحیح()
    گرفتن خطا خ:
        سرچاپ خ.نام نوع()، "->"، خ.پیام
    پایان
    شمار := تلاش سند.عضو("count").عدد صحیح() گرفتن خطا ۰
    سرچاپ "شمار یا پیش‌فرض:"، شمار
پایان
