واردسازی کدگذاری.مقدار

تابع ریشه:
    ناپایا کاربر := مقدار.شیء جدید()
    مقدار.تنظیم کلید(کاربر، "name"، مقدار.مقدار رشته("نرگس"))
    مقدار.تنظیم کلید(کاربر، "age"، مقدار.مقدار صحیح(۳۴))
    مقدار.تنظیم کلید(کاربر، "height"، مقدار.مقدار اعشاری(۱.۶۸))
    مقدار.تنظیم کلید(کاربر، "admin"، مقدار.مقدار منطقی(نادرست))
    مقدار.تنظیم کلید(کاربر، "phone"، مقدار.مقدار تهی())
    ناپایا زبان‌ها := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(زبان‌ها، مقدار.مقدار رشته("fa"))
    مقدار.افزودن به آرایه(زبان‌ها، مقدار.مقدار رشته("en"))
    مقدار.تنظیم عضو آرایه(زبان‌ها، ۱، مقدار.مقدار رشته("ar"))
    مقدار.تنظیم کلید(کاربر، "langs"، زبان‌ها)
    سرچاپ مقدار.رشته اشکال زدایی(کاربر)
    سرچاپ مقدار.طول شیء(کاربر)، مقدار.شیء دارد(کاربر، "age")، مقدار.کلیدهای شیء(کاربر)
    سرچاپ مقدار.به رشته(مقدار.مقدار کلید(کاربر، "name"))، مقدار.به صحیح(مقدار.مقدار کلید(کاربر، "age"))، مقدار.به اعشاری(مقدار.مقدار کلید(کاربر، "height"))، مقدار.به منطقی(مقدار.مقدار کلید(کاربر، "admin"))
    ز := مقدار.مقدار کلید(کاربر، "langs")
    سرچاپ مقدار.آرایه است(ز)، مقدار.طول آرایه(ز)، مقدار.به رشته(مقدار.عضو آرایه(ز، ۱))
    ناپایا هست := نادرست
    _ := مقدار.مقدار کلید با وضعیت(کاربر، "email"، هست)
    سرچاپ هست
    ت := مقدار.مقدار کلید(کاربر، "phone")
    سرچاپ مقدار.تهی است(ت)، مقدار.منطقی است(ت)، مقدار.صحیح است(مقدار.مقدار صحیح(۱))، مقدار.اعشاری است(مقدار.مقدار اعشاری(۱.۰))، مقدار.عدد است(مقدار.مقدار صحیح(۱))
    سرچاپ مقدار.رشته است(مقدار.مقدار رشته(""))، مقدار.شیء است(کاربر)، ت.kind == مقدار.نوع تهی، مقدار.نوع شیء
    ناپایا ک := مقدار.رونوشت مقدار(کاربر)
    سرچاپ مقدار.یکسان است(ک، کاربر)
    حذف شد := مقدار.حذف کلید(ک، "phone")
    سرچاپ حذف شد، مقدار.یکسان است(ک، کاربر)
    ناپایا عددها := وکتور {} برگردان وکتور<مقدار.مقدار>
    عددها.بیفزا(مقدار.مقدار صحیح(۱))
    ناپایا فیلدها := نگاشت {} برگردان نگاشت<رشته، مقدار.مقدار>
    فیلدها.درج("x"، مقدار.مقدار آرایه(عددها))
    سرچاپ مقدار.رشته اشکال زدایی(مقدار.مقدار شیء(فیلدها))
    مقدار.آزادسازی مقدار(ک)
