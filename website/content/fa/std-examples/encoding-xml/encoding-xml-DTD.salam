واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه:
    د := اکس‌ام‌ال.تجزیه دی‌تی‌دی("<!ELEMENT note (to, body)>\n<!ELEMENT to (#PCDATA)>\n<!ELEMENT body (#PCDATA)>\n<!ATTLIST note id ID #REQUIRED kind (a|b) \"a\">")
    سرچاپ د.موفق، اکس‌ام‌ال.شمار عنصرهای اعلام‌شده(د)، اکس‌ام‌ال.شمار ویژگی‌های اعلام‌شده(د)
    ع := د.عنصرها[۰]
    سرچاپ ع.نام، ع.محتوا == اکس‌ام‌ال.محتوای فرزندان، ع.مدل
    ویژ := د.ویژگی‌ها[۱]
    سرچاپ ویژ.نام، ویژ.گونه == اکس‌ام‌ال.ویژگی فهرستی، ویژ.حالت == اکس‌ام‌ال.پیش فرض با مقدار، ویژ.مقدار پیش‌فرض، ویژ.مقدارهای مجاز
    ناپایا خ := اکس‌ام‌ال.بدون خطا()
    ناپایا خوب := اکس‌ام‌ال.تجزیه("<note id=\"n1\"><to>من</to><body>سلام</body></note>"، خ)
    ناپایا گزارش := اکس‌ام‌ال.اعتبارسنجی(خوب، د)
    سرچاپ گزارش.معتبر
    اکس‌ام‌ال.آزادسازی گزارش(گزارش)
    سرچاپ اکس‌ام‌ال.اعمال پیش فرض‌ها(خوب، د)، اکس‌ام‌ال.مقدار ویژگی(خوب، اکس‌ام‌ال.عنصر ریشه(خوب)، "kind")
    ناپایا بد := اکس‌ام‌ال.تجزیه("<note><body>بی گیرنده</body></note>"، خ)
    ناپایا گ۲ := اکس‌ام‌ال.اعتبارسنجی(بد، د)
    سرچاپ گ۲.معتبر، گ۲.موردها.طول()
    سرچاپ اکس‌ام‌ال.متن گزارش(گ۲)
    اکس‌ام‌ال.آزادسازی گزارش(گ۲)
    ناپایا درونی := اکس‌ام‌ال.تجزیه("<!DOCTYPE a [<!ELEMENT a EMPTY>]><a>متن</a>"، خ)
    ناپایا گ۳ := اکس‌ام‌ال.اعتبارسنجی زیرمجموعه داخلی(درونی)
    سرچاپ گ۳.معتبر، درونی.نوع سند
    اکس‌ام‌ال.آزادسازی گزارش(گ۳)
    ناپایا فضا := اکس‌ام‌ال.تجزیه("<a xmlns:x=\"urn:x\"><x:b/></a>"، خ)
    ناپایا گ۴ := اکس‌ام‌ال.بررسی فضای نام(فضا)
    سرچاپ گ۴.معتبر
    اکس‌ام‌ال.آزادسازی گزارش(گ۴)
    ناپایا د۲ := د
    اکس‌ام‌ال.آزادسازی دی‌تی‌دی(د۲)
    اکس‌ام‌ال.آزادسازی(خوب)
    اکس‌ام‌ال.آزادسازی(بد)
    اکس‌ام‌ال.آزادسازی(درونی)
    اکس‌ام‌ال.آزادسازی(فضا)
پایان
