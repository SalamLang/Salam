واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه:
    متن := "<?xml version=\"1.0\"?>\n<library xmlns:b=\"urn:books\">\n  <!-- فهرست -->\n  <b:book id=\"1\" lang=\"fa\"><title>بوف کور</title><year>1315</year></b:book>\n  <b:book id=\"2\"><title>سووشون</title></b:book>\n</library>"
    ناپایا خ := اکس‌ام‌ال.بدون خطا()
    ناپایا س := اکس‌ام‌ال.تجزیه(متن، خ)
    سرچاپ خ.موفق، س.نسخه، اکس‌ام‌ال.شمار گره‌ها(س) > ۰
    ر := اکس‌ام‌ال.عنصر ریشه(س)
    سرچاپ اکس‌ام‌ال.نام(س، ر)، اکس‌ام‌ال.نوع(س، ر) == اکس‌ام‌ال.نوع عنصر، اکس‌ام‌ال.والد(س، ر) == اکس‌ام‌ال.گره سند(س)
    ناپایا کتاب‌ها := اکس‌ام‌ال.عنصرها(س، ر)
    سرچاپ کتاب‌ها.شناسه‌ها.طول()
    ک := کتاب‌ها.شناسه‌ها[۰]
    سرچاپ اکس‌ام‌ال.نام(س، ک)، اکس‌ام‌ال.نام محلی(س، ک)، اکس‌ام‌ال.پیشوند(س، ک)، اکس‌ام‌ال.نشانی فضای نام(س، ک)
    سرچاپ اکس‌ام‌ال.خط(س، ک)، اکس‌ام‌ال.ستون(س، ک)، اکس‌ام‌ال.عمق(س، ک)، اکس‌ام‌ال.مسیر(س، ک)
    سرچاپ اکس‌ام‌ال.شمار ویژگی‌ها(س، ک)، اکس‌ام‌ال.ویژگی دارد(س، ک، "lang")، اکس‌ام‌ال.مقدار ویژگی(س، ک، "id")
    ویژ := اکس‌ام‌ال.ویژگی شماره(س، ک، ۱)
    سرچاپ ویژ.نام، ویژ.مقدار
    ع := اکس‌ام‌ال.نخستین عنصر با نام(س، ک، "title")
    سرچاپ اکس‌ام‌ال.متن(س، ع)، اکس‌ام‌ال.متن(س، ک)، اکس‌ام‌ال.عنصر است(س، ع)
    سرچاپ اکس‌ام‌ال.شمار فرزندان(س، ک)، اکس‌ام‌ال.نام(س، اکس‌ام‌ال.فرزند شماره(س، ک، ۱))
    سرچاپ اکس‌ام‌ال.نام(س، اکس‌ام‌ال.گره هم‌سطح بعدی(س، ع))، اکس‌ام‌ال.گره هم‌سطح قبلی(س، ع)
    ناپایا همه := اکس‌ام‌ال.نوادگان(س، ر)
    ناپایا عنوان‌ها := اکس‌ام‌ال.عنصرهای با نام(س، ر، "b:book")
    ناپایا نیاکان := اکس‌ام‌ال.نیاکان(س، ع)
    ناپایا فرزندها := اکس‌ام‌ال.گره‌های فرزند(س، ر)
    سرچاپ همه.شناسه‌ها.طول()، عنوان‌ها.شناسه‌ها.طول()، نیاکان.شناسه‌ها.طول()، فرزندها.شناسه‌ها.طول()
    سرچاپ اکس‌ام‌ال.وجود دارد(س، ۹۹۹۹)، اکس‌ام‌ال.مقدار(س، اکس‌ام‌ال.فرزند شماره(س، ع، ۰))
    اکس‌ام‌ال.آزادسازی فهرست(همه)
    اکس‌ام‌ال.آزادسازی فهرست(عنوان‌ها)
    اکس‌ام‌ال.آزادسازی فهرست(نیاکان)
    اکس‌ام‌ال.آزادسازی فهرست(فرزندها)
    اکس‌ام‌ال.آزادسازی فهرست(کتاب‌ها)
    _ := اکس‌ام‌ال.تجزیه("<a><b></a>"، خ)
    سرچاپ خ.موفق، خ.خط، اکس‌ام‌ال.متن خطا(خ)
    سرچاپ اکس‌ام‌ال.خوش‌ساخت است("<x/>"، خ)
    اکس‌ام‌ال.آزادسازی(س)
    ناپایا گ := اکس‌ام‌ال.گزینه‌های پیش فرض()
    گ.نگه‌داشتن توضیح‌ها = نادرست
    ناپایا د := اکس‌ام‌ال.تجزیه سفارشی("<!DOCTYPE p [<!ENTITY site \"سلام\">]><p xmlns:x=\"urn:x\" x:id=\"7\">&site; <b>ب</b> پایان</p>"، گ، خ)
    پ := اکس‌ام‌ال.عنصر ریشه(د)
    سرچاپ خ.موفق، اکس‌ام‌ال.شمار موجودیت‌ها(د)، اکس‌ام‌ال.مقدار موجودیت(د، "site")
    سرچاپ "[" + اکس‌ام‌ال.متن مستقیم(د، پ) + "]"، اکس‌ام‌ال.مقدار ویژگی با فضای نام(د، پ، "urn:x"، "id")
    سرچاپ اکس‌ام‌ال.سقف عمق موجودیت، اکس‌ام‌ال.سقف گسترش موجودیت، گ.بیشترین عمق
    اکس‌ام‌ال.آزادسازی(د)
پایان
