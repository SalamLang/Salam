واردسازی کدگذاری.اکس‌ام‌ال
واردسازی کدگذاری.مقدار

روال ریشه:
    ن := اکس‌ام‌ال.کدگشایی("<config env=\"prod\"><db host=\"localhost\" port=\"5432\"/><feature>search</feature><feature>chat</feature></config>")
    سرچاپ ن.tag، اکس‌ام‌ال.دارای ویژگی(ن، "env")، اکس‌ام‌ال.ویژگی گره(ن، "env")
    د := اکس‌ام‌ال.فرزند(ن، "db")
    سرچاپ اکس‌ام‌ال.پیدا شد(د)، اکس‌ام‌ال.ویژگی گره(د، "port")، اکس‌ام‌ال.پیدا شد(اکس‌ام‌ال.فرزند(ن، "cache"))
    ف := اکس‌ام‌ال.فرزندان(ن، "feature")
    سرچاپ ف.items.طول()، ف.items[۱].text
    ناپایا ت := اکس‌ام‌ال.گره ساده جدید("item")
    اکس‌ام‌ال.تنظیم ویژگی گره(ت، "id"، "3")
    ناپایا ب := اکس‌ام‌ال.گره ساده جدید("name")
    ب.text = "کتاب"
    اکس‌ام‌ال.افزودن گره فرزند(ت، ب)
    سرچاپ اکس‌ام‌ال.کدگذاری(ت)
    سرچاپ اکس‌ام‌ال.کدگذاری با تورفتگی(ت، "  ")
    سرچاپ اکس‌ام‌ال.کدگذاری با اعلان(ت)
    سرچاپ اکس‌ام‌ال.معتبر("<a><b/></a>")، اکس‌ام‌ال.معتبر("<a><b></a>")
    ناپایا خوانده := نادرست
    _ := اکس‌ام‌ال.کدگشایی سخت گیرانه("<a>"، خوانده)
    سرچاپ خوانده
    م := اکس‌ام‌ال.به مقدار(ن)
    سرچاپ مقدار.رشته اشکال زدایی(م)
    سرچاپ اکس‌ام‌ال.کدگذاری(اکس‌ام‌ال.از مقدار(م، "root"))
    سرچاپ اکس‌ام‌ال.اسکیپ متن("a < b & c")، اکس‌ام‌ال.اسکیپ ویژگی(`"x"`)، اکس‌ام‌ال.بازگردانی موجودیت‌ها("&lt;p&gt; &amp; &#1587;")
    ناپایا خوان := اکس‌ام‌ال.نشانه‌خوان جدید("<a x=\"1\">سلام<!--c--></a>")
    تا درست:
        ن۲ := اکس‌ام‌ال.نشانه بعدی(خوان)
        اگر ن۲.kind == اکس‌ام‌ال.نشانه اتمام یا ن۲.kind == اکس‌ام‌ال.نشانه خطا:
            بشکن
        پایان
        سرچاپ ن۲.kind، ن۲.tag، ن۲.text
    پایان
    سرچاپ اکس‌ام‌ال.نشانه آغاز عنصر، اکس‌ام‌ال.نشانه انتهای عنصر، اکس‌ام‌ال.نشانه متن، اکس‌ام‌ال.نشانه توضیح، اکس‌ام‌ال.نشانه سی‌دیتا
پایان
