واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه خطادار:
    ناپایا س := تلاش اکس‌ام‌ال.تجزیه("<shop><item price=\"120\">چای</item><item price=\"80\">قند</item><item price=\"45\">نان</item></shop>")
    ر := اکس‌ام‌ال.گره سند(س)
    ناپایا ارزان := تلاش اکس‌ام‌ال.انتخاب(س، ر، "//item[@price < 100]")
    سرچاپ ارزان.شناسه‌ها.طول()
    هر گ در ارزان.شناسه‌ها:
        سرچاپ اکس‌ام‌ال.متن(س، گ)
    پایان
    اکس‌ام‌ال.آزادسازی فهرست(ارزان)
    سرچاپ تلاش اکس‌ام‌ال.انتخاب رشته(س، ر، "/shop/item[1]")، تلاش اکس‌ام‌ال.انتخاب عدد(س، ر، "sum(//item/@price)")، تلاش اکس‌ام‌ال.انتخاب منطقی(س، ر، "count(//item) = 3")
    ن := تلاش اکس‌ام‌ال.انتخاب نخستین(س، ر، "//item[last()]")
    سرچاپ اکس‌ام‌ال.نام گره(س، ن)، اکس‌ام‌ال.مقدار متنی گره(س، ن)
    ناپایا م := تلاش اکس‌ام‌ال.ارزیابی(س، ر، "//item/@price")
    سرچاپ م.نوع == اکس‌ام‌ال.مقدار مجموعه گره، م.گره‌ها.شناسه‌ها.طول()
    ش := م.گره‌ها.شناسه‌ها[۰]
    سرچاپ اکس‌ام‌ال.ارجاع ویژگی است(ش)، اکس‌ام‌ال.ویژگی ارجاع‌شده(س، ش).مقدار، اکس‌ام‌ال.ارجاع ویژگی است(اکس‌ام‌ال.ارجاع ویژگی(۰))
    اکس‌ام‌ال.آزادسازی مقدار(م)
    ع := تلاش اکس‌ام‌ال.ارزیابی(س، ر، "string-length('سلام')")
    سرچاپ ع.نوع == اکس‌ام‌ال.مقدار عدد، ع.عدد، اکس‌ام‌ال.مقدار رشته، اکس‌ام‌ال.مقدار منطقی
    تلاش:
        اکس‌ام‌ال.انتخاب(س، ر، "//item[@")
    گرفتن خطا خ:
        سرچاپ خ.نام نوع()، خ.ستون، خ.پیام
    پایان
    اکس‌ام‌ال.آزادسازی(س)
پایان
