واردسازی کدگذاری.اکس‌ام‌ال

تابع ریشه:
    ناپایا خ := اکس‌ام‌ال.بدون خطا()
    ناپایا س := اکس‌ام‌ال.تجزیه("<shop><item price=\"120\">چای</item><item price=\"80\">قند</item><item price=\"45\">نان</item></shop>"، خ)
    ر := اکس‌ام‌ال.گره سند(س)
    ناپایا ارزان := اکس‌ام‌ال.انتخاب(س، ر، "//item[@price < 100]"، خ)
    سرچاپ ارزان.items.طول()
    هر گ در ارزان.items:
        سرچاپ اکس‌ام‌ال.متن(س، گ)
    پایان
    اکس‌ام‌ال.آزادسازی فهرست(ارزان)
    سرچاپ اکس‌ام‌ال.انتخاب رشته(س، ر، "/shop/item[1]"، خ)، اکس‌ام‌ال.انتخاب عدد(س، ر، "sum(//item/@price)"، خ)، اکس‌ام‌ال.انتخاب منطقی(س، ر، "count(//item) = 3"، خ)
    ن := اکس‌ام‌ال.انتخاب نخستین(س، ر، "//item[last()]"، خ)
    سرچاپ اکس‌ام‌ال.نام گره(س، ن)، اکس‌ام‌ال.مقدار متنی گره(س، ن)
    ناپایا م := اکس‌ام‌ال.ارزیابی(س، ر، "//item/@price"، خ)
    سرچاپ م.kind == اکس‌ام‌ال.مقدار مجموعه گره، م.nodes.items.طول()
    ش := م.nodes.items[۰]
    سرچاپ اکس‌ام‌ال.ارجاع ویژگی است(ش)، اکس‌ام‌ال.ویژگی ارجاع‌شده(س، ش).value، اکس‌ام‌ال.ارجاع ویژگی است(اکس‌ام‌ال.ارجاع ویژگی(۰))
    اکس‌ام‌ال.آزادسازی مقدار(م)
    ع := اکس‌ام‌ال.ارزیابی(س، ر، "string-length('سلام')"، خ)
    سرچاپ ع.kind == اکس‌ام‌ال.مقدار عدد، ع.number، اکس‌ام‌ال.مقدار رشته، اکس‌ام‌ال.مقدار منطقی
    _ := اکس‌ام‌ال.انتخاب(س، ر، "//item[@"، خ)
    سرچاپ خ.ok
    اکس‌ام‌ال.آزادسازی(س)
پایان
