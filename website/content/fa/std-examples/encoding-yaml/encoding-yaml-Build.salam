واردسازی کدگذاری.یامل
واردسازی کدگذاری.مقدار
واردسازی کدگذاری.خطای کدگذاری
واردسازی رشته

تابع ریشه:
    ناپایا اعضا := وکتور {} برگردان وکتور<رشته>
    اعضا.بیفزا(یامل.عضو("name"، "salam"))
    اعضا.بیفزا(یامل.عضو عدد("port"، ۸۰۸۰))
    اعضا.بیفزا(یامل.عضو منطقی("debug"، نادرست))
    اعضا.بیفزا(یامل.عضو اعشار("ratio"، ۰.۲۵))
    ناپایا میزبان‌ها := وکتور {} برگردان وکتور<رشته>
    میزبان‌ها.بیفزا(یامل.رشته یامل("a: b"))
    اعضا.بیفزا(یامل.عضو خام("hosts"، یامل.آرایه(میزبان‌ها)))
    شیء := یامل.شیء(اعضا)
    سرچاپ شیء
    سرچاپ یامل.برونریزی(شیء)
    سرچاپ رشته.شامل است(یامل.برونریزی تب(`{"a": {"b": 1}}`)، "\tb: 1")، یامل.برونریزی سفارشی(`{"a": [1]}`، "    ")
    سرچاپ یامل.اسکیپ("یک: دو")
    سرچاپ یامل.تجزیه("x: 1")
    ناپایا خ := خطای کدگذاری.بدون خطا()
    م := یامل.کدگشایی("شهر: تهران\nجمعیت: 9000000\n"، خ)
    سرچاپ مقدار.به صحیح(مقدار.مقدار کلید(م، "جمعیت"))
    سرچاپ یامل.کدگذاری(م)
پایان
