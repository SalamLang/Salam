واردسازی کدگذاری.یامل

روال ریشه:
    متن := "app:\n  name: salam\n  port: 8080\n  debug: true\n  ratio: 0.5\n  hosts:\n    - a.example\n    - b.example\n"
    سرچاپ یامل.معتبر(متن)، یامل.دارد(متن، "app.name")، یامل.دارد(متن، "app.user")
    سرچاپ یامل.دریافت(متن، "app.name")، یامل.دریافت عدد(متن، "app.port")، یامل.دریافت منطقی(متن، "app.debug")، یامل.دریافت اعشار(متن، "app.ratio")
    سرچاپ یامل.نوع(متن، "app.hosts")، یامل.طول(متن، "app.hosts")، یامل.دریافت(متن، "app.hosts[1]")
    سرچاپ یامل.کلیدها(متن، "app")
    ناپایا لازم := وکتور {} برگردان وکتور<رشته>
    لازم.بیفزا("app")
    سرچاپ یامل.دارد کلیدها(متن، لازم)
    لازم.بیفزا("db")
    سرچاپ یامل.دارد کلیدها(متن، لازم)
    سرچاپ یامل.به جیسون(متن)
    سرچاپ یامل.تفکیک کردن اسناد("a: 1\n---\nb: 2\n").طول()
پایان
