واردسازی کدگذاری
واردسازی حافظه

تابع ریشه:
    ک := کدگذاری.کدگذاری پایه۶۴("سلام دنیا")
    سرچاپ ک
    ب := حافظه.تخصیص(۳ برگردان طبیعی۶۴)
    حافظه.تنظیم(ب، ۲۵۵، ۳ برگردان طبیعی۶۴)
    سرچاپ کدگذاری.کدگذاری بایت‌ها پایه۶۴(ب، ۳)
    خروجی := حافظه.تخصیص(۸ برگردان طبیعی۶۴)
    تلاش:
        سرچاپ کدگذاری.کدگشایی پایه۶۴(ک)
        سرچاپ کدگذاری.کدگشایی پایه۶۴("YWJj")، کدگذاری.کدگشایی پایه۶۴("YQ")، کدگذاری.کدگشایی پایه۶۴("Pz8_")
        سرچاپ کدگذاری.کدگشایی پایه۶۴ به بایت("AAEC"، خروجی، ۸)
        سرچاپ کدگذاری.کدگشایی پایه۶۴("***")
    گرفتن خطا خ:
        سرچاپ خ.نام نوع() + ": " + خ.به رشته()
    پایان
    تلاش:
        _ := کدگذاری.کدگشایی پایه۶۴ به بایت("AAECAwQF"، خروجی، ۴)
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
    پایان
    حافظه.آزادسازی(ب)
    حافظه.آزادسازی(خروجی)
پایان
