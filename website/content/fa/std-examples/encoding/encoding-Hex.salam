واردسازی کدگذاری

تابع ریشه:
    ش := کدگذاری.کدگذاری شانزده("Hi!")
    سرچاپ کدگذاری.مقدار شانزده("f")، کدگذاری.مقدار شانزده("A")، کدگذاری.مقدار شانزده("z")
    ن := کدگذاری.کدگذاری نشانی("نام=علی & سن=۳۰")
    سرچاپ ن
    تلاش:
        سرچاپ ش، کدگذاری.کدگشایی شانزده(ش)
        سرچاپ کدگذاری.کدگشایی نشانی(ن)
        سرچاپ کدگذاری.کدگشایی شانزده("4869z1")
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
    پایان
    تلاش:
        سرچاپ کدگذاری.کدگشایی نشانی("100%")
    گرفتن خطا خ:
        سرچاپ خ.به رشته()
    پایان
پایان
