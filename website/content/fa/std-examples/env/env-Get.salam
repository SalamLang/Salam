واردسازی محیط

روال ریشه:
    محیط.تنظیم("PORT"، "8080")
    محیط.تنظیم("DEBUG"، "true")
    محیط.تنظیم("RATIO"، "0.75")
    سرچاپ محیط.دریافت("PORT")، محیط.دارد("PORT")، محیط.دارد("NOPE")
    سرچاپ محیط.دریافت صحیح("PORT"، ۸۰)، محیط.دریافت صحیح("NOPE"، ۸۰)
    سرچاپ محیط.دریافت منطقی("DEBUG"، نادرست)، محیط.دریافت اعشاری("RATIO"، ۱.۰)
    سرچاپ محیط.دریافت با پیش فرض("HOST"، "localhost")
    محیط.حذف("PORT")
    سرچاپ محیط.دارد("PORT")
    محیط.تنظیم("API_KEY"، "sk-1234567890abcdef")
    سرچاپ محیط.پوشاندن("sk-1234567890abcdef")، محیط.دریافت پوشیده("API_KEY")
    محیط.تنظیم("NAME"، "سلام")
    سرچاپ محیط.گسترش("زبان ${NAME} روی درگاه ${PORT:-3000}")
پایان
