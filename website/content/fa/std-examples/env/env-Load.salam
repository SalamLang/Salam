واردسازی محیط
واردسازی ورودی خروجی

روال ریشه:
    ورودی خروجی.نوشتن پرونده(".env"، "DB_HOST=localhost\nDB_PORT=5432\n# توضیح\n")
    سرچاپ محیط.بارگذاری(".env")، محیط.دریافت("DB_HOST")
    محیط.تنظیم("DB_PORT"، "1")
    محیط.بارگذاری(".env")
    سرچاپ محیط.دریافت("DB_PORT")
    محیط.بارگذاری اجباری(".env")
    سرچاپ محیط.دریافت("DB_PORT")
    سرچاپ محیط.بارگذاری متن("A=1\nB=2")، محیط.دریافت("B")
    سرچاپ محیط.بارگذاری نقطه‌محیط(".env")
    ورودی خروجی.نوشتن پرونده(".env.test"، "MODE=testing\n")
    محیط.تنظیم("SALAM_ENV"، "test")
    سرچاپ محیط.بارگذاری نمایه(".")، محیط.دریافت("MODE")
پایان
