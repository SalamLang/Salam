واردسازی خطا

روال یافتن کاربر(شناسه: صحیح): خطا.خطا:
    اگر شناسه <= ۰:
        برگشت خطا.جدید(خطا.آرگومان نامعتبر، "شناسه باید مثبت باشد")
    پایان
    اگر شناسه > ۱۰۰:
        برگشت خطا.جدید در(خطا.یافت نشد، "کاربر پیدا نشد"، "یافتن کاربر")
    پایان
    برگشت خطا.خالی()
پایان

روال ریشه:
    هر ش در [۷، -۱، ۵۰۰]:
        ناپایا خ := یافتن کاربر(ش)
        اگر خطا.بدون خطا(خ):
            سرچاپ ش، "پیدا شد"، خطا.خالی است(خ)
        وگرنه:
            سرچاپ ش، خطا.نوع(خ)، خطا.پیام(خ)
            سرچاپ خطا.است(خ، خطا.یافت نشد)، خطا.یافت نشد است(خ)، خطا.آرگومان نامعتبر است(خ)
        پایان
        خطا.آزادسازی(خ)
    پایان
    ناپایا م := وکتور {} برگردان وکتور<رشته>
    دیرکن م.آزادکن()
    م.بیفزا("config.ini")
    خ۲ := خطا.جدید قالبی(خطا.ورودی خروجی، "نمی‌توان {} را خواند"، م)
    سرچاپ خطا.پیام(خ۲)
پایان
