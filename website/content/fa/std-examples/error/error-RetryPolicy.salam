واردسازی خطا

روال ریشه:
    ناپایا س := خطا.سیاست تکرار جدید(۴، ۱۰۰، ۱۰۰۰)
    سرچاپ س.max_attempts، س.base_delay_ms، س.max_delay_ms
    خ := خطا.جدید(خطا.پایان زمان، "سرور پاسخ نداد")
    ناپایا تلاش := ۱
    تا خطا.باید تکرار شود(س، خ، تلاش):
        سرچاپ "تلاش", تلاش، "پس از", خطا.تاخیر برای تلاش(س، تلاش)، "میلی‌ثانیه"
        تلاش += ۱
    پایان
    سرچاپ خطا.باید تکرار شود(س، خطا.جدید(خطا.آرگومان نامعتبر، "ورودی بد")، ۱)
پایان
