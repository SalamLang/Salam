واردسازی رویدادها
واردسازی حافظه

ناپایا مجموع := 0
ناپایا آخر := 0
ناپایا مرتب := درست
ناپایا دیده := 0

تابع add(ev: رویدادها.رویداد<صحیح>):
    مجموع += ev.داده
    اگر ev.داده نابرابر آخر + 1:
        مرتب = نادرست
    پایان
    آخر = ev.داده
    دیده++
پایان

تابع worker(p: رویدادها.انتشاردهنده<صحیح>*):
    رویدادها.پردازش صف(p[0])
پایان

تابع ریشه:
    عنصر := رویدادها.جدید ناهمگام(4) برگردان رویدادها.انتشاردهنده<صحیح>
    جعبه := حافظه.تخصیص صفرشده(اندازه‌گونه(رویدادها.انتشاردهنده<صحیح>) برگردان طبیعی۶۴) برگردان رویدادها.انتشاردهنده<صحیح>*
    جعبه[0] = عنصر
    رشته_اجرایی := نخ‌ساز(worker، جعبه)
    متغیر__id := رویدادها.روی(عنصر، "tick"، (ev: رویدادها.رویداد<صحیح>): add(ev) پایان)

    سرچاپ "first queued"، رویدادها.انتشار ناهمگام(عنصر، "tick"، 1)
    تکرار 2 تا 200 در شمارنده:
        متغیر__ok := رویدادها.انتشار ناهمگام(عنصر، "tick"، شمارنده)
    پایان
    رویدادها.تخلیه(عنصر)
    سرچاپ "seen"، دیده
    سرچاپ "total"، مجموع
    سرچاپ "ordered"، مرتب
    سرچاپ "pending"، رویدادها.در انتظار(عنصر)

    متغیر__ok := رویدادها.انتشار ناهمگام(عنصر، "tick"، 201)
    متغیر__ok2 := رویدادها.انتشار ناهمگام(عنصر، "other"، 999)
    رویدادها.بستن(عنصر)
    نخ‌پیوند(رشته_اجرایی)
    سرچاپ "after close seen"، دیده
    سرچاپ "total"، مجموع
    سرچاپ "emit after close"، رویدادها.انتشار ناهمگام(عنصر، "tick"، 5)
    رویدادها.بستن(عنصر)

    ساده := رویدادها.جدید() برگردان رویدادها.انتشاردهنده<صحیح>
    سرچاپ "async on sync emitter"، رویدادها.انتشار ناهمگام(ساده، "x"، 1)
    رویدادها.آزادکن(ساده)
    رویدادها.آزادکن(عنصر)
    حافظه.آزادسازی(جعبه برگردان تهی*)
    برگشت 0
پایان
