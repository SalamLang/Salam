واردسازی رویدادها

ناپایا e := رویدادها.جدید() برگردان رویدادها.انتشاردهنده<صحیح>
ناپایا log := وکتور {} برگردان وکتور<رشته>

تابع note(s: رشته):
    log.بیفزا(s)
پایان

تابع ریشه:
    e = رویدادها.جدید() برگردان رویدادها.انتشاردهنده<صحیح>
    a := رویدادها.روی(e، "user.login"، (ev: رویدادها.رویداد<صحیح>): note("a " + ev.موضوع + " " + ev.داده) پایان)
    b := رویدادها.روی(e، "user.*"، (ev: رویدادها.رویداد<صحیح>): note("b " + ev.موضوع + " " + ev.داده) پایان)
    _c := رویدادها.یک‌بار(e، "user.login"، (ev: رویدادها.رویداد<صحیح>): note("once " + ev.داده) پایان)
    _d := رویدادها.روی همه(e، (ev: رویدادها.رویداد<صحیح>): note("any " + ev.موضوع) پایان)
    _f := رویدادها.روی(e، "order.#"، (ev: رویدادها.رویداد<صحیح>): note("order " + ev.موضوع) پایان)

    سرچاپ "count login"، رویدادها.شمار(e، "user.login")
    سرچاپ "count user.a.b"، رویدادها.شمار(e، "user.a.b")
    سرچاپ "count order"، رویدادها.شمار(e، "order")
    سرچاپ "count order.x.y"، رویدادها.شمار(e، "order.x.y")
    سرچاپ "calls"، رویدادها.انتشار(e، "user.login"، 1)
    سرچاپ "calls"، رویدادها.انتشار(e، "user.login"، 2)
    سرچاپ "calls"، رویدادها.انتشار(e، "user.logout"، 3)
    سرچاپ "calls"، رویدادها.انتشار(e، "order.new.eu"، 4)
    سرچاپ "calls"، رویدادها.انتشار(e، "other"، 5)

    سرچاپ "off a"، رویدادها.خاموش(e، a)
    سرچاپ "off a again"، رویدادها.خاموش(e، a)
    سرچاپ "off topic"، رویدادها.خاموش موضوع(e، "user.*")
    سرچاپ "off b"، رویدادها.خاموش(e، b)
    سرچاپ "len"، رویدادها.تعداد(e)
    سرچاپ "calls"، رویدادها.انتشار(e، "user.login"، 6)

    selfoff := رویدادها.روی(e، "x"، (ev: رویدادها.رویداد<صحیح>): note("x " + ev.داده) پایان)
    _adder := رویدادها.روی(e، "x"، (_ev: رویدادها.رویداد<صحیح>):
        _id := رویدادها.روی(e، "y"، (_v: رویدادها.رویداد<صحیح>): note("y") پایان)
        _ok := رویدادها.خاموش(e، selfoff)
    پایان)
    سرچاپ "len before"، رویدادها.تعداد(e)
    رویدادها.انتشار(e، "x"، 7)
    سرچاپ "len after"، رویدادها.تعداد(e)
    رویدادها.انتشار(e، "x"، 8)

    تکرار log.طول() در i:
        سرچاپ log.بگیر(i)
    پایان
    log.آزادکن()
    رویدادها.آزادکن(e)
    برگشت 0
پایان
