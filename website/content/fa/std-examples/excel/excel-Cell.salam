واردسازی اکسل

تابع ریشه:
    سرچاپ اکسل.برچسب ستون(۰)، اکسل.برچسب ستون(۲۵)، اکسل.برچسب ستون(۲۶)، اکسل.برچسب ستون(۷۰۳)
    سرچاپ اکسل.اندیس ستون("A")، اکسل.اندیس ستون("AA")، اکسل.ارجاع سلول(۴، ۲)
    ناپایا سطر := ۰
    ناپایا ستون := ۰
    سرچاپ اکسل.تجزیه ارجاع سلول("C5"، سطر، ستون)، سطر، ستون، اکسل.تجزیه ارجاع سلول("5C"، سطر، ستون)
    سریال := اکسل.تبدیل زمان به سریال(۰)
    سرچاپ سریال، اکسل.تبدیل سریال به زمان(۴۵۳۷۱.۰)
    ر := اکسل.سلول رشته‌ای جدید(۰، ۰، "متن")
    ع := اکسل.سلول عددی جدید(۰، ۱، ۳.۵)
    م := اکسل.سلول منطقی جدید(۰، ۲، نادرست)
    ت := اکسل.سلول تاریخ جدید(۰، ۳، ۰)
    ف := اکسل.سلول فرمول جدید(۰، ۴، "A1*2"، ۷.۰)
    سرچاپ ر.نوع == اکسل.سلول رشته‌ای، ع.عدد، م.منطقی، ت.نوع == اکسل.سلول تاریخ، ف.فرمول، ف.عدد
    سرچاپ اکسل.سلول خالی، اکسل.سلول عددی، اکسل.سلول منطقی، اکسل.سلول فرمول
    ناپایا سبک‌ها := اکسل.جدول سبک جدید()
    پررنگ := اکسل.سبک { پررنگ = درست، رنگ زمینه = "FFFF00"، چینش افقی = اکسل.میان‌چین }
    شناسه := سبک‌ها.دریافت با افزودن(پررنگ)
    سرچاپ شناسه، سبک‌ها.دریافت با افزودن(پررنگ) == شناسه، سبک‌ها.شمار()، سبک‌ها.دریافت(شناسه).پررنگ
    سرچاپ پررنگ.یکسان است(سبک‌ها.دریافت(شناسه))، پررنگ.نام قلم، پررنگ.اندازه قلم
    سرچاپ اکسل.آرایش پیش‌فرض، اکسل.چپ‌چین، اکسل.راست‌چین، اکسل.بالاچین، اکسل.میان‌چین عمودی، اکسل.پایین‌چین
    سبک‌ها.آزادسازی()
پایان
