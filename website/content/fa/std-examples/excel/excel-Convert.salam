واردسازی اکسل

روال ریشه:
    ناپایا ب := اکسل.سی‌اس‌وی به برگه("name,score\nعلی,17\n\"سارا, ع\",19.5\n"، "نمره‌ها")
    سرچاپ ب.name، ب.شمار سطرها()، ب.دریافت رشته(۲، ۰)، ب.دریافت عدد(۲، ۱)
    سرچاپ اکسل.برگه به سی‌اس‌وی(ب)
    سرچاپ اکسل.برگه به جیسون(ب)
    ناپایا ج := اکسل.جیسون به برگه(`[["a", "b"], ["1", "x"], ["2", "y"]]`، "داده")
    سرچاپ ج.شمار سطرها()، ج.شمار ستون‌ها()، ج.دریافت رشته(۰، ۱)، ج.دریافت رشته(۲، ۰)
    ک := "<row r=\"2\"><c r=\"A2\" t=\"s\"><v>0</v></c><br/></row>"
    آغاز := اکسل.یافتن ایکس‌ام‌ال(ک، "c"، ۰)
    سرچاپ آغاز، اکسل.ویژگی ایکس‌ام‌ال(ک، آغاز، "r")، اکسل.پایان برچسب ایکس‌ام‌ال(ک، آغاز)
    سرچاپ اکسل.درون ایکس‌ام‌ال(ک، "v"، ۰)، اکسل.بستن خودکار ایکس‌ام‌ال(ک، اکسل.یافتن ایکس‌ام‌ال(ک، "br"، ۰))
    سرچاپ اکسل.یافتن بستن ایکس‌ام‌ال(ک، "row"، ۱۰)
    سرچاپ اکسل.اسکیپ ایکس‌ام‌ال("a<b&c")، اکسل.برگرداندن اسکیپ ایکس‌ام‌ال("a&lt;b&amp;c")
    ب.آزادسازی()
    ج.آزادسازی()
پایان
