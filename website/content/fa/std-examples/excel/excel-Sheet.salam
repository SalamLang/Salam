واردسازی اکسل

تابع ریشه:
    ناپایا ب := اکسل.برگه جدید("فروش")
    ب.تنظیم رشته(۰، ۰، "کالا")
    ب.تنظیم رشته(۰، ۱، "تعداد")
    ب.تنظیم سلول(۱، ۰، "چای")
    ب.تنظیم عدد صحیح(۱، ۱، ۱۲)
    ب.تنظیم سلول(۲، ۰، "قند")
    ب.تنظیم عدد(۲، ۱، ۴.۵)
    ب.تنظیم منطقی(۳، ۰، درست)
    ب.تنظیم تاریخ(۳، ۱، ۱۷۱۰۹۴۳۵۰۹)
    ب.تنظیم فرمول(۴، ۱، "SUM(B2:B3)"، ۱۶.۵)
    ب.تنظیم خطا(۵، ۰، "#DIV/0!")
    سرچاپ ب.name، ب.شمار سطرها()، ب.شمار ستون‌ها()
    سرچاپ ب.دریافت رشته(۱، ۰)، ب.دریافت عدد(۱، ۱)، ب.دریافت عدد(۲، ۱)، ب.دریافت منطقی(۳، ۰)، ب.دریافت فرمول(۴، ۱)
    س := ب.دریافت سلول(۵، ۰)
    سرچاپ س.kind == اکسل.سلول خطا، س.text، ب.دریافت سلول(۳، ۱).kind == اکسل.سلول تاریخ
    سرچاپ ب.دارای سلول(۱، ۱)، ب.دارای سلول(۹، ۹)
    ب.پاک‌سازی سلول(۵، ۰)
    سرچاپ ب.دارای سلول(۵، ۰)
    ناپایا سطر := وکتور {} برگردان وکتور<رشته>
    سطر.بیفزا("نان")
    سطر.بیفزا("7")
    ب.تنظیم سطر(۶، سطر)
    ب.تنظیم ستون(۳، سطر)
    ناپایا جدول := وکتور {} برگردان وکتور<رشته>
    هر م در ["a"، "b"، "c"، "d"]:
        جدول.بیفزا(م)
    پایان
    ب.تنظیم جدول(۸، ۰، جدول، ۲)
    سرچاپ ب.دریافت سطر(۶).طول()، ب.دریافت ستون(۳).طول()، ب.دریافت همه().طول()
    سرچاپ ب.دریافت رشته(۹، ۱)
    پیدا := ب.جستجو("نان")
    سرچاپ پیدا.طول()، پیدا[۰].row، پیدا[۰].col
    سرچاپ ب.پالایش سطرها(۰، "چای")
    ب.ادغام سلول‌ها(۰، ۰، ۰، ۱)
    ناپایا یافت := نادرست
    ب۲ := ب.بازه ادغام‌شده(۰، ۱، یافت)
    سرچاپ ب.ادغام‌شده است(۰، ۱)، یافت، ب۲.row1، ب۲.col2، ب.merges.طول()
    ب.تنظیم سبک(۱، ۱، ۲)
    سرچاپ ب.دریافت سلول(۱، ۱).style_id، ب.max_row، ب.max_col، ب.cells.اندازه() > ۰
    ب.آزادسازی()
پایان
