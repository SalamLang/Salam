واردسازی اکسل

تابع ریشه:
    ناپایا ک := اکسل.کتاب کار جدید()
    ناپایا ب := ک.افزودن برگه("قیمت‌ها")
    ب.تنظیم رشته(۰، ۰، "کالا")
    ب.تنظیم رشته(۰، ۱، "قیمت")
    ب.تنظیم رشته(۱، ۰، "چای سبز، ۵۰۰ گرمی")
    ب.تنظیم عدد(۱، ۱، ۴.۵)
    ب.تنظیم رشته(۲، ۰، "شکر")
    ب.تنظیم عدد(۲، ۱، ۱.۲۵)
    ب.راست‌به‌چپ = درست
    ب.ثابت کردن(۱، ۱)
    ب.تنظیم فیلتر خودکار(۰، ۰، ۲، ۱)
    سرچاپ ب.راست‌به‌چپ، ب.سطرهای ثابت، ب.ستون‌های ثابت، ب.فیلتر خودکار
    ب.پهنای خودکار()
    سرچاپ ب.پهنای ستون‌ها
    ب.تنظیم پهنای ستون(۳، ۳۰.۰)
    سرچاپ ب.پهنای ستون‌ها.طول()، ب.پهنای ستون‌ها[۲]، ب.پهنای ستون‌ها[۳]
    قاب‌دار := اکسل.سبک { کادر = درست، شکستن خط = درست }
    شناسه := ک.سبک‌ها.دریافت با افزودن(قاب‌دار)
    ب.تنظیم سبک(۰، ۰، شناسه)
    سرچاپ اکسل.نوشتن ایکس‌ال‌اس‌ایکس(ک، "prices.xlsx")
    ناپایا خوب := نادرست
    ناپایا خطا := ""
    ناپایا خوانده := اکسل.بازکردن("prices.xlsx"، خوب، خطا)
    اگر خوب:
        برگشتی := خوانده.برگه("قیمت‌ها")
        سرچاپ خوب، برگشتی.فیلتر خودکار، خوانده.سبک‌ها.دریافت(برگشتی.دریافت سلول(۰، ۰).شماره سبک).شکستن خط
    وگرنه:
        سرچاپ خوب، خطا
    پایان
    خوانده.آزادسازی()
    ک.آزادسازی()
پایان
