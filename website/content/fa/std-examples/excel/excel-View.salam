واردسازی اکسل

تابع ریشه:
    ناپایا ک := اکسل.کتاب کار جدید()
    ناپایا ب := ک.افزودن برگه("قیمت‌ها")
    ب.تنظیم رشته(۰، ۰، "کالا")
    ب.تنظیم رشته(۰، ۱، "قیمت")
    ب.تنظیم رشته(۱، ۰، "چای سبز، ۵۰۰ گرمی")
    ب.تنظیم عدد(۱، ۱، ۴.۵)
    ب.تنظیم رشته(۲، ۰، "شکر")
    ب.تنظیم عدد(۲، ۱، ۱.۲۵)
    ب.rtl = درست
    ب.ثابت کردن(۱، ۱)
    ب.تنظیم فیلتر خودکار(۰، ۰، ۲، ۱)
    سرچاپ ب.rtl، ب.freeze_rows، ب.freeze_cols، ب.auto_filter
    ب.پهنای خودکار()
    سرچاپ ب.col_widths
    ب.تنظیم پهنای ستون(۳، ۳۰.۰)
    سرچاپ ب.col_widths.طول()، ب.col_widths[۲]، ب.col_widths[۳]
    قاب‌دار := اکسل.سبک { border = درست، wrap = درست }
    شناسه := ک.styles.دریافت با افزودن(قاب‌دار)
    ب.تنظیم سبک(۰، ۰، شناسه)
    سرچاپ اکسل.نوشتن ایکس‌ال‌اس‌ایکس(ک، "prices.xlsx")
    ناپایا خوب := نادرست
    ناپایا خطا := ""
    ناپایا خوانده := اکسل.بازکردن("prices.xlsx"، خوب، خطا)
    برگشتی := خوانده.برگه("قیمت‌ها")
    سرچاپ خوب، برگشتی.auto_filter، خوانده.styles.دریافت(برگشتی.دریافت سلول(۰، ۰).style_id).wrap
    خوانده.آزادسازی()
    ک.آزادسازی()
پایان
