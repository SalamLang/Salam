واردسازی اکسل

روال ریشه:
    ناپایا ک := اکسل.کتاب کار جدید()
    ناپایا الف := ک.افزودن برگه("الف")
    الف.تنظیم رشته(۰، ۰، "سلام")
    الف.تنظیم عدد(۰، ۱، ۲.۵)
    ناپایا ب := ک.افزودن برگه("ب")
    ب.تنظیم عدد صحیح(۰، ۰، ۴۲)
    سرچاپ ک.شمار برگه‌ها()، ک.نام برگه‌ها()، ک.اندیس برگه("ب")، ک.برگه در(۰).name
    سرچاپ ک.تغییر نام برگه(۱، "دوم")، ک.برگه("دوم").دریافت عدد(۰، ۰)
    سرچاپ ک.تنظیم برگه فعال(۱)، ک.برگه فعال().name، ک.active_sheet
    سرچاپ اکسل.نوشتن ایکس‌ال‌اس‌ایکس(ک، "book.xlsx")، اکسل.نوشتن اُدی‌اس(ک، "book.ods")، ک.ذخیره("copy.xlsx")، اکسل.ذخیره(ک، "book.csv")
    سرچاپ اکسل.تشخیص قالب("book.xlsx") == اکسل.قالب ایکس‌ال‌اس‌ایکس، اکسل.تشخیص قالب("book.ods") == اکسل.قالب اُدی‌اس، اکسل.تشخیص قالب("a.txt")، اکسل.قالب ایکس‌ال‌اس، اکسل.قالب سی‌اس‌وی، اکسل.قالب نامشخص
    ناپایا خوب := نادرست
    ناپایا خطا := ""
    ناپایا خوانده := اکسل.بازکردن("book.xlsx"، خوب، خطا)
    سرچاپ خوب، خوانده.نام برگه‌ها()، خوانده.برگه("الف").دریافت رشته(۰، ۰)، خوانده.format == اکسل.قالب ایکس‌ال‌اس‌ایکس
    ناپایا خ۲ := اکسل.خواندن ایکس‌ال‌اس‌ایکس("copy.xlsx"، خوب، خطا)
    ناپایا خ۳ := اکسل.خواندن اُدی‌اس("book.ods"، خوب، خطا)
    سرچاپ خوب، خ۳.برگه("دوم").دریافت عدد(۰، ۰)، خ۲.شمار برگه‌ها()
    ناپایا م := اکسل.بازرسی("book.xlsx"، خوب، خطا)
    سرچاپ خوب، م.exists، م.size > ۰، م.sheet_names، م.sheet_rows، م.sheet_cols
    م.آزادسازی()
    ناپایا س := اکسل.خواندن کتاب کار سی‌اس‌وی("book.csv"، خوب، خطا)
    سرچاپ خوب، س.برگه در(۰).دریافت رشته(۰، ۰)، اکسل.نوشتن کتاب کار سی‌اس‌وی(س، "again.csv")
    _ := اکسل.بازکردن("نیست.xlsx"، خوب، خطا)
    سرچاپ خوب، خطا != ""
    _ := اکسل.خواندن ایکس‌ال‌اس("نیست.xls"، خوب، خطا)
    سرچاپ خوب، اکسل.ایکس‌ال‌اس است(پوچ، ۰)
    سرچاپ ک.حذف برگه با نام("الف")، ک.حذف برگه(۵)، ک.حذف برگه(۰)، ک.شمار برگه‌ها()
    ناپایا ت := اکسل.جدید()
    سرچاپ ت.شمار برگه‌ها()
    ت.آزادسازی()
    خوانده.آزادسازی()
    خ۲.آزادسازی()
    خ۳.آزادسازی()
    س.آزادسازی()
    ک.آزادسازی()
پایان
