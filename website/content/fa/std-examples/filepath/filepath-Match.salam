واردسازی مسیر پرونده

تابع check(pattern: رشته، name: رشته):
    سرچاپ pattern، name، مسیر پرونده.تطبیق الگو(pattern، name)
پایان

تابع ریشه:
    check("*.salam"، "main.salam")
    check("*.salam"، "std/main.salam")
    check("**/*.salam"، "std/os/main.salam")
    check("**/*.salam"، "main.salam")
    check("v?.[0-9]"، "v1.5")
    check("[!a-c]*"، "dog")
    check("cache/**"، "cache/a/b")
    سرچاپ مسیر پرونده.الگو دارد("src/main.salam")، مسیر پرونده.الگو دارد("src/*.salam")
پایان
