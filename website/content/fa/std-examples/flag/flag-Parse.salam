واردسازی پرچم

تابع ریشه:
    ناپایا پ := پرچم.جدید("کپی"، "پرونده‌ها را رونوشت می‌کند")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن منطقی(پ، "verbose"، "v"، نادرست، "گزارش کامل")
    پرچم.افزودن رشته(پ، "out"، "o"، "خروجی"، "پوشه‌ی مقصد")
    پرچم.افزودن صحیح(پ، "jobs"، "j"، ۱، "تعداد کار همزمان")
    پرچم.افزودن اعشاری(پ، "ratio"، "r"، ۱.۰، "نسبت فشرده‌سازی")
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    هر آ در ["-v"، "--out=backup"، "-j"، "4"، "a.txt"، "b.txt"]:
        آرگ.بیفزا(آ)
    پایان
    سرچاپ پرچم.تجزیه(پ، آرگ)، "[" + پرچم.خطا(پ) + "]"
    سرچاپ پرچم.دریافت منطقی(پ، "verbose")، پرچم.دریافت رشته(پ، "out")، پرچم.دریافت صحیح(پ، "jobs")، پرچم.دریافت اعشاری(پ، "ratio")
    سرچاپ پرچم.تنظیم شده(پ، "jobs")، پرچم.تنظیم شده(پ، "ratio")
    سرچاپ پرچم.موقعیتی(پ)، پرچم.راهنما خواسته(پ)
    سرچاپ پرچم.نوع منطقی، پرچم.نوع رشته، پرچم.نوع صحیح، پرچم.نوع اعشاری
پایان
