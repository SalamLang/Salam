واردسازی پرچم

روال ریشه:
    ناپایا پ := پرچم.جدید("ابزار"، "یک ابزار نمونه")
    دیرکن پرچم.آزادسازی(پ)
    پرچم.افزودن منطقی(پ، "quiet"، "q"، نادرست، "بی‌صدا")
    پرچم.افزودن صحیح(پ، "port"، "p"، ۸۰۸۰، "درگاه")
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("--help")
    پرچم.تجزیه(پ، آرگ)
    اگر پرچم.راهنما خواسته(پ):
        چاپ پرچم.راهنما(پ)
    پایان
    ناپایا بد := وکتور {} برگردان وکتور<رشته>
    دیرکن بد.آزادکن()
    بد.بیفزا("--port=abc")
    ناپایا پ۲ := پرچم.جدید("ابزار"، "")
    دیرکن پرچم.آزادسازی(پ۲)
    پرچم.افزودن صحیح(پ۲، "port"، "p"، ۸۰۸۰، "درگاه")
    سرچاپ پرچم.تجزیه(پ۲، بد)، پرچم.خطا(پ۲)
پایان
