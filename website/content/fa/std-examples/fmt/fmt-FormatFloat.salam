واردسازی قالب بندی

تابع ریشه:
    سرچاپ "[" + قالب بندی.عدد اعشار با الگو(۳.۱۴۱۵۹، "%.2f") + "]"
    سرچاپ "[" + قالب بندی.عدد اعشار با الگو(۰.۱۲۵، "%.2f") + "]"
    سرچاپ "[" + قالب بندی.عدد اعشار با الگو(-۲.۵، "%8.1f") + "]"
    سرچاپ "[" + قالب بندی.عدد اعشار با الگو(۴۲.۰، "%+08.2f") + "]"
    سرچاپ "[" + قالب بندی.عدد اعشار با الگو(۱۲۳۴۵۶۷.۰، "%e") + "]"
    سرچاپ "[" + قالب بندی.عدد اعشار با الگو(۰.۰۰۰۱، "%g") + "]"
    سرچاپ "[" + قالب بندی.عدد صحیح با الگو(۲۵۵، "%#x") + "]"
    سرچاپ "[" + قالب بندی.عدد صحیح با الگو(۴۲، "%-6d") + "]"
    سرچاپ "[" + قالب بندی.عدد صحیح با الگو(۷، "%05d") + "]"
    سرچاپ "[" + قالب بندی.عدد صحیح با الگو(۵، "%b") + "]"
پایان
