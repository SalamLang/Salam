واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده
واردسازی سیستم عامل
واردسازی سیستم عامل.موقت

تابع show(title: رشته، items: وکتور<رشته>، متغیر_root: رشته):
    سرچاپ title
    هر مورد در items:
        سرچاپ "  " + مورد.زیررشته(متغیر_root.طول() + 1، مورد.طول() - متغیر_root.طول() - 1)
    پایان
    items.آزادکن()
پایان

تابع ریشه:
    متغیر_root := موقت.پوشه موقت()
    دیرکن موقت.حذف پوشه(متغیر_root)
    سیستم عامل.ساخت پوشه ها(متغیر_root + "/src/deep")
    هر نام در ["src/a.c"، "src/b.h"، "src/deep/c.c"، "top.c"]:
        سیستم پرونده.نوشتن متن(متغیر_root + "/" + نام، "x")
    پایان
    show("src/*.c"، پوشه.الگوجویی(متغیر_root + "/src/*.c")، متغیر_root)
    show("**/*.c"، پوشه.الگوجویی(متغیر_root + "/**/*.c")، متغیر_root)
    show("walk *.h"، پوشه.پیمایش با الگو(متغیر_root، "*.h")، متغیر_root)
    show("walk src/**/*.c"، پوشه.پیمایش با الگو(متغیر_root، "src/**/*.c")، متغیر_root)
پایان
