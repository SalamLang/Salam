واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده.پرونده
واردسازی سیستم عامل
واردسازی سیستم عامل.موقت

تابع show(title: رشته، items: وکتور<رشته>، root: رشته):
    سرچاپ title
    هر item در items:
        سرچاپ "  " + item.زیررشته(root.طول() + 1، item.طول() - root.طول() - 1)
    پایان
    items.آزادکن()
پایان

تابع ریشه:
    root := موقت.پوشه موقت()
    دیرکن موقت.حذف پوشه(root)
    سیستم عامل.ساخت پوشه ها(root + "/src/deep")
    هر name در ["src/a.c"، "src/b.h"، "src/deep/c.c"، "top.c"]:
        پرونده.نوشتن متن(root + "/" + name، "x")
    پایان
    show("src/*.c"، پوشه.الگوجویی(root + "/src/*.c")، root)
    show("**/*.c"، پوشه.الگوجویی(root + "/**/*.c")، root)
    show("walk *.h"، پوشه.پیمایش با الگو(root، "*.h")، root)
    show("walk src/**/*.c"، پوشه.پیمایش با الگو(root، "src/**/*.c")، root)
پایان
