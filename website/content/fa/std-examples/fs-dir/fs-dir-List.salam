واردسازی سیستم پرونده.پوشه
واردسازی سیستم پرونده.پرونده

روال ریشه:
    پوشه.ساخت پوشه("کتابخانه")
    پوشه.ساخت پوشه ها("کتابخانه/شعر/حافظ")
    پرونده.نوشتن متن("کتابخانه/فهرست.txt"، "۳ کتاب")
    پرونده.نوشتن متن("کتابخانه/شعر/حافظ/غزل.txt"، "الا یا ایها الساقی")
    سرچاپ پوشه.وجود دارد("کتابخانه")، پوشه.پوشه است("کتابخانه/فهرست.txt")
    سرچاپ پوشه.فهرست("کتابخانه").طول()، پوشه.فهرست پوشه ها("کتابخانه")، پوشه.فهرست پرونده ها("کتابخانه")
    سرچاپ پوشه.پیمایش("کتابخانه").طول()، پوشه.اندازه("کتابخانه") > ۰
    سرچاپ پوشه.مجوزها("کتابخانه") > ۰، پوشه.زمان تغییر("کتابخانه") > ۰
    پوشه.کپی("کتابخانه"، "پشتیبان")
    پوشه.جابجایی("پشتیبان"، "بایگانی")
    سرچاپ پوشه.وجود دارد("پشتیبان")، پوشه.وجود دارد("بایگانی/شعر/حافظ")، پرونده.وجود دارد("بایگانی/شعر/حافظ/غزل.txt")
    پوشه.ساخت پوشه("خالی")
    پوشه.حذف("خالی")
    پوشه.حذف همه("کتابخانه")
    پوشه.حذف همه("بایگانی")
    سرچاپ پوشه.وجود دارد("کتابخانه")، پوشه.وجود دارد("خالی")
پایان
