واردسازی سیستم پرونده.پرونده

روال ریشه:
    پرونده.نوشتن متن("اصلی.txt"، "سلام")
    پرونده.کپی("اصلی.txt"، "رونوشت.txt")
    پرونده.جابجایی("رونوشت.txt"، "جابه‌جا.txt")
    پرونده.تغییر نام("جابه‌جا.txt"، "نهایی.txt")
    سرچاپ پرونده.وجود دارد("رونوشت.txt")، پرونده.وجود دارد("نهایی.txt")، پرونده.خواندن متن("نهایی.txt")
    پرونده.حذف("نهایی.txt")
    سرچاپ پرونده.وجود دارد("نهایی.txt")
پایان
