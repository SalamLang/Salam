واردسازی سیستم پرونده
واردسازی سیستم پرونده.پرونده

تابع ریشه:
    پرونده.نوشتن متن("قدیمی.txt"، "کد قدیمی")
    سرچاپ پرونده.خواندن متن("قدیمی.txt")، سیستم پرونده.خواندن متن("قدیمی.txt")
    سرچاپ پرونده.اندازه("قدیمی.txt") == سیستم پرونده.اندازه("قدیمی.txt")، پرونده.وجود دارد("قدیمی.txt")
    و۱ := پرونده.وضعیت("قدیمی.txt")
    سرچاپ و۱.وجود دارد، و۱.اندازه
    پرونده.حذف("قدیمی.txt")
    سرچاپ سیستم پرونده.وجود دارد("قدیمی.txt")
پایان
