واردسازی سیستم پرونده

تابع ریشه:
    سیستم پرونده.نوشتن متن("شعر.txt"، "بنی آدم اعضای یکدیگرند\n")
    سیستم پرونده.افزودن("شعر.txt"، "که در آفرینش ز یک گوهرند\n")
    چاپ سیستم پرونده.خواندن متن("شعر.txt")
    سرچاپ سیستم پرونده.خواندن همه("شعر.txt") == سیستم پرونده.خواندن متن("شعر.txt")
    خط‌ها := سیستم پرونده.خواندن خط‌ها("شعر.txt")
    سرچاپ خط‌ها.طول()، خط‌ها.بگیر(۱)
    سیستم پرونده.نوشتن بایت‌ها("داده.bin"، "ABCDEF")
    سرچاپ سیستم پرونده.خواندن بایت‌ها("داده.bin"، ۳)
    سیستم پرونده.نوشتن اتمی("تنظیمات.txt"، "زبان=فارسی")
    سرچاپ سیستم پرونده.خواندن متن("تنظیمات.txt")
    پ := سیستم پرونده.بازکردن("شعر.txt"، "rb")
    سرچاپ پ.خواندن خط()
    سیستم پرونده.بستن(پ)
پایان
