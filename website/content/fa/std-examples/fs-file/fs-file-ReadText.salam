واردسازی سیستم پرونده.پرونده

روال ریشه:
    پرونده.نوشتن متن("شعر.txt"، "بنی آدم اعضای یکدیگرند\n")
    پرونده.افزودن("شعر.txt"، "که در آفرینش ز یک گوهرند\n")
    چاپ پرونده.خواندن متن("شعر.txt")
    سرچاپ پرونده.خواندن همه("شعر.txt") == پرونده.خواندن متن("شعر.txt")
    خط‌ها := پرونده.خواندن خط‌ها("شعر.txt")
    سرچاپ خط‌ها.طول()، خط‌ها.بگیر(۱)
    پرونده.نوشتن بایت‌ها("داده.bin"، "ABCDEF")
    سرچاپ پرونده.خواندن بایت‌ها("داده.bin"، ۳)
    پرونده.نوشتن اتمی("تنظیمات.txt"، "زبان=فارسی")
    سرچاپ پرونده.خواندن متن("تنظیمات.txt")
    پ := پرونده.بازکردن("شعر.txt"، "rb")
    سرچاپ پ.خواندن خط()
    پرونده.بستن(پ)
