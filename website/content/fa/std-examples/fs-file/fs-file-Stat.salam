واردسازی سیستم پرونده.پرونده

تابع ریشه:
    پرونده.نوشتن متن("عکس.png"، "PNG")
    و۱ := پرونده.وضعیت("عکس.png")
    سرچاپ و۱.وجود دارد، و۱.اندازه، و۱.زمان تغییر > ۰، و۱.مجوزها > ۰
    سرچاپ پرونده.اندازه("عکس.png")، پرونده.وجود دارد("عکس.png")
    سرچاپ پرونده.زمان تغییر("عکس.png") > ۰، پرونده.زمان دسترسی("عکس.png") > ۰، پرونده.زمان ایجاد("عکس.png") >= ۰
    پرونده.تغییر مجوز("عکس.png"، 0o600)
    سرچاپ پرونده.مجوزها("عکس.png")
    سرچاپ پرونده.پسوند("عکس.png")، پرونده.نوع مایم("عکس.png")، پرونده.نوع مایم("نامه.pdf")
    سرچاپ پرونده.وضعیت("نیست.txt").وجود دارد
پایان
