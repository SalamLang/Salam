واردسازی سیستم پرونده.مسیر

تابع ریشه:
    پ := مسیر.پیوند("/home/sara"، "docs/cv.pdf")
    سرچاپ پ
    ت := مسیر.تقسیم(پ)
    سرچاپ ت.dir، ت.base
    سرچاپ مسیر.نام پوشه(پ)، مسیر.پوشه والد(پ)، مسیر.نام پرونده(پ)، مسیر.نام پایه(پ)
    سرچاپ مسیر.پسوند(پ)، مسیر.نام بدون پسوند(پ)
    سرچاپ مسیر.نرمال سازی("/a/./b/../c//d")، مسیر.پاک سازی("a/b/../../c")
    سرچاپ مسیر.مطلق است(پ)، مسیر.مطلق است("docs")، مسیر.مطلق است(مسیر.مسیر مطلق("docs"))
    سرچاپ مسیر.مسیر نسبی("/home/sara"، "/home/sara/docs/cv.pdf")
    سرچاپ مسیر.مسیر امن است("/srv/files"، "a/b.txt")، مسیر.مسیر امن است("/srv/files"، "../../etc/passwd")
    سرچاپ مسیر.اعتبارسنجی مسیر("docs/cv.pdf")، مسیر.اعتبارسنجی مسیر("")
