واردسازی سیستم پرونده

تابع ریشه:
    سیستم پرونده.نوشتن متن("اصلی.txt"، "سلام")
    سیستم پرونده.کپی("اصلی.txt"، "رونوشت.txt")
    سیستم پرونده.جابجایی("رونوشت.txt"، "جابه‌جا.txt")
    سیستم پرونده.تغییر نام("جابه‌جا.txt"، "نهایی.txt")
    سرچاپ سیستم پرونده.وجود دارد("رونوشت.txt")، سیستم پرونده.وجود دارد("نهایی.txt")، سیستم پرونده.خواندن متن("نهایی.txt")
    سیستم پرونده.حذف("نهایی.txt")
    سرچاپ سیستم پرونده.وجود دارد("نهایی.txt")
پایان
