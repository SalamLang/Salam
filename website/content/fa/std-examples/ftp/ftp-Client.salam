واردسازی اف‌تی‌پی
واردسازی تی ال اس

تابع ریشه:
    ناپایا ک := اف‌تی‌پی.اتصال امن("ftp.example.com"، ۲۱)
    اگر وارونه اف‌تی‌پی.سالم(ک) یا وارونه اف‌تی‌پی.ورود(ک، "ali"، "s3cret"):
        سرچاپ اف‌تی‌پی.آخرین کد(ک)، اف‌تی‌پی.آخرین پاسخ(ک)
        برگشت
    پایان
    سرچاپ اف‌تی‌پی.امن(ک)، اف‌تی‌پی.داده امن(ک)
    سرچاپ اف‌تی‌پی.سامانه(ک)
    سرچاپ اف‌تی‌پی.قابلیت‌ها(ک)
    _ := اف‌تی‌پی.دودویی(ک)
    سرچاپ اف‌تی‌پی.مسیر جاری(ک)
    _ := اف‌تی‌پی.ساخت مسیر کامل(ک، "/site/assets")
    _ := اف‌تی‌پی.تغییر مسیر(ک، "/site")
    _ := اف‌تی‌پی.نوشتن(ک، "index.html"، "<h1>سلام</h1>")
    _ := اف‌تی‌پی.افزودن(ک، "log.txt"، "یک خط تازه\n")
    سرچاپ اف‌تی‌پی.خواندن(ک، "index.html")
    سرچاپ اف‌تی‌پی.ارسال(ک، "logo.png"، "assets/logo.png")
    سرچاپ اف‌تی‌پی.دریافت(ک، "log.txt"، "log-copy.txt")
    هر ا در اف‌تی‌پی.فهرست(ک، "."):
        سرچاپ ا.name، ا.size، ا.is_dir
    پایان
    هر نام در اف‌تی‌پی.فهرست نام‌ها(ک، "assets"):
        سرچاپ نام
    پایان
    سرچاپ اف‌تی‌پی.فهرست خام(ک، ".").طول() > ۰
    سرچاپ اف‌تی‌پی.اندازه(ک، "index.html")، اف‌تی‌پی.زمان تغییر(ک، "index.html")
    سرچاپ اف‌تی‌پی.پوشه است(ک، "assets")، اف‌تی‌پی.پیوند است(ک، "current")، اف‌تی‌پی.وجود دارد(ک، "old.html")
    _ := اف‌تی‌پی.تغییر نام(ک، "log.txt"، "log-1.txt")
    _ := اف‌تی‌پی.انتقال(ک، "log-1.txt"، "archive/log-1.txt")
    _ := اف‌تی‌پی.حذف(ک، "archive/log-1.txt")
    _ := اف‌تی‌پی.یک سطح بالا(ک)
    _ := اف‌تی‌پی.ساخت پوشه(ک، "tmp")
    _ := اف‌تی‌پی.حذف پوشه(ک، "tmp")
    _ := اف‌تی‌پی.حذف همه(ک، "/site/old")
    _ := اف‌تی‌پی.ارسال پوشه(ک، "public"، "/site")
    _ := اف‌تی‌پی.دریافت پوشه(ک، "/site"، "backup")
    سرچاپ اف‌تی‌پی.فرمان(ک، "SITE CHMOD 644 index.html")
    سرچاپ اف‌تی‌پی.بی‌کار(ک)
    _ := اف‌تی‌پی.متنی(ک)
    اف‌تی‌پی.خروج(ک)
    اف‌تی‌پی.بستن(ک)

    ناپایا س := اف‌تی‌پی.اتصال("ftp.example.com"، ۲۱)
    سرچاپ اف‌تی‌پی.احراز تی‌ال‌اس(س)
    ناپایا پ := تی ال اس.پیکربندی جدید("ftp.example.com")
    پ.ca_file = "company-ca.pem"
    ناپایا ب := اف‌تی‌پی.اتصال امن با تنظیمات("ftp.example.com"، ۲۱، پ)
    ناپایا د := اف‌تی‌پی.اتصال("ftp.example.com"، ۲۱)
    سرچاپ اف‌تی‌پی.ارتقا به تی‌ال‌اس(د، پ)
    اف‌تی‌پی.بستن(س)
    اف‌تی‌پی.بستن(ب)
    اف‌تی‌پی.بستن(د)
پایان
