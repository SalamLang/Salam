واردسازی اف‌تی‌پی

روال ریشه:
    سرچاپ اف‌تی‌پی.کد پاسخ("230 Login successful.")، اف‌تی‌پی.کد پاسخ("خراب")
    سرچاپ اف‌تی‌پی.خط پایانی است("211-Features:")، اف‌تی‌پی.خط پایانی است("211 End")
    سرچاپ اف‌تی‌پی.تحلیل پسیو("227 Entering Passive Mode (192,168,1,10,19,137)")
    سرچاپ اف‌تی‌پی.تحلیل پسیو گسترده("229 Entering Extended Passive Mode (|||50000|)")
    ا := اف‌تی‌پی.تحلیل خط فهرست("-rw-r--r--    1 ftp      ftp          1024 Sep 30 12:00 notes.txt")
    سرچاپ ا.name، ا.size، ا.is_dir، ا.is_link، ا.mode، ا.raw_date
    پ := اف‌تی‌پی.تحلیل خط فهرست("drwxr-xr-x    2 ftp      ftp          4096 Jan 01  2026 backup")
    سرچاپ پ.name، پ.is_dir
    ل := اف‌تی‌پی.تحلیل خط فهرست("lrwxrwxrwx    1 ftp      ftp             7 Mar 03 09:15 current -> backup")
    سرچاپ ل.name، ل.is_link
پایان
