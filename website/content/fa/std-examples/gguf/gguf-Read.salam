پایان

تابع ریشه:
    ناپایا بافر := فشرده سازی.بافر بایت جدید()
    ساختن(بافر)
    مسیر := سیستم عامل.پوشه موقت() + "/salam_tiny.gguf"
    _ := بایگانی.نوشتن پرونده دودویی از بافر(مسیر، بافر)
    ناپایا سالم := نادرست
    ناپایا حافظه‌ای := جی‌جی‌یو‌اف.تجزیه جی‌جی‌یو‌اف(بافر، سالم)
    سرچاپ سالم، حافظه‌ای.خطا == ""
    حافظه‌ای.آزادسازی()

    ناپایا گ := جی‌جی‌یو‌اف.بارگذاری جی‌جی‌یو‌اف(مسیر، سالم)
    سرچاپ سالم، گ.موفق، گ.نسخه، گ.کلیدها.طول()، گ.تانسورها.طول()، گ.هم‌ترازی، گ.آغاز داده
    سرچاپ گ.فراداده رشته("general.architecture")، گ.فراداده صحیح("llama.context_length"، ۰)، گ.فراداده صحیح("llama.block_count"، ۳۲)
    توکن‌ها := گ.مقدارها.دریافت(گ.نمایه فراداده("tokenizer.tokens"))
    سرچاپ توکن‌ها.گونه == جی‌جی‌یو‌اف.فراداده آرایه، توکن‌ها.نوع عنصر == جی‌جی‌یو‌اف.فراداده رشته، توکن‌ها.آرایه رشته.دریافت(۱)
    ش := گ.نمایه تانسور("w")
    اطلاعات := گ.تانسورها.دریافت(ش)
    سرچاپ اطلاعات.نام، اطلاعات.ابعاد.طول()، اطلاعات.شمار()، اطلاعات.نوع وزن، اطلاعات.جابجایی، جی‌جی‌یو‌اف.بایت‌های تانسور(گ، ش)
    ناپایا ت := جی‌جی‌یو‌اف.بارگذاری تانسور اعشاری(گ، ش، سالم)
    سرچاپ سالم، ت.عنصر(۰)، ت.عنصر(۵)
    ت.آزادسازی()
    سرچاپ جی‌جی‌یو‌اف.نوع اعشاری شانزده، جی‌جی‌یو‌اف.نوع کوانتیزه چهار صفر، جی‌جی‌یو‌اف.نوع کوانتیزه چهار یک، جی‌جی‌یو‌اف.نوع کوانتیزه هشت صفر
    گ.آزادسازی()
پایان
