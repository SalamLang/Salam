واردسازی گوگل

روال ریشه:
    سند := `{"type":"service_account","project_id":"salam-demo","client_email":"bot@salam-demo.iam.gserviceaccount.com","private_key":"(کلید خصوصی این‌جا)"}`
    ح := گوگل.تجزیه حساب سرویس(سند)
    سرچاپ ح.ok، ح.project_id، ح.client_email
    سرچاپ ح.token_uri
    سرچاپ ح.private_key.طول() > ۰
    سرچاپ گوگل.تجزیه حساب سرویس(`{"project_id":"x"}`).ok
    سرچاپ گوگل.سرآیند مجوز("ya29.abc")
    سرچاپ گوگل.دامنه اف سی ام
    سرچاپ گوگل.دامنه ذخیره‌سازی
    سرچاپ گوگل.دامنه ابر
پایان
