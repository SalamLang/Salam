واردسازی گوگل

تابع ریشه:
    سند := `{"type":"service_account","project_id":"salam-demo","client_email":"bot@salam-demo.iam.gserviceaccount.com","private_key":"(کلید خصوصی این‌جا)"}`
    ح := گوگل.تجزیه حساب سرویس(سند)
    سرچاپ ح.موفق، ح.شناسه پروژه، ح.ایمیل حساب
    سرچاپ ح.نشانی توکن
    سرچاپ ح.کلید خصوصی.طول() > ۰
    سرچاپ گوگل.تجزیه حساب سرویس(`{"project_id":"x"}`).موفق
    سرچاپ گوگل.سرآیند مجوز("ya29.abc")
