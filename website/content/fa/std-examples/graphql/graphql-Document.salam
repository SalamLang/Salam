واردسازی گراف‌کیوال
واردسازی کدگذاری.مقدار

تابع ریشه:
    متن := `query Books($limit: Int = 5) { books(limit: $limit, tags: ["a", "b"]) @include(if: true) { ...Info alias: title } }
fragment Info on Book { id year }`
    سرچاپ گراف‌کیوال.تجزیه موفق(متن)، گراف‌کیوال.تجزیه موفق("{ a ")، گراف‌کیوال.تحلیل واژگانی موفق("{ a }")
    ناپایا خطا := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای نحوی، "")
    ناپایا س := گراف‌کیوال.تجزیه(متن، خطا)
    سرچاپ س.ops.طول()، س.frags.طول()
    چاپ گراف‌کیوال.چاپ(س)
    ع := گراف‌کیوال.یافتن عملیات(س، "Books")
    عملیات := س.ops.دریافت(ع)
    سرچاپ عملیات.name، گراف‌کیوال.نام نوع عملیات(عملیات.optype)، عملیات.shorthand، عملیات.varDefs.طول()، عملیات.line
    گ := گراف‌کیوال.گزینش در(س، عملیات.selections.دریافت(۰))
    سرچاپ گ.kind == گراف‌کیوال.گزینش فیلد، گ.name، گراف‌کیوال.کلید پاسخ(گ)، گ.args.طول()، گ.directives.طول()، گ.selections.طول()، گ.line، گ.col
    آرگ := گ.args.دریافت(۱)
    سرچاپ آرگ.name، گراف‌کیوال.چاپ مقدار(س، آرگ.value)، گراف‌کیوال.مقدار در(س، آرگ.value).kind == گراف‌کیوال.مقدار فهرست
    تعریف := عملیات.varDefs.دریافت(۰)
    سرچاپ تعریف.name، گراف‌کیوال.چاپ ارجاع نوع(س، تعریف.typeRef)، گراف‌کیوال.نام ارجاع نوع(س، تعریف.typeRef)
    سرچاپ گراف‌کیوال.ارجاع نوع ناتهی است(س، تعریف.typeRef)، گراف‌کیوال.ارجاع نوع فهرست است(س، تعریف.typeRef)، گراف‌کیوال.ارجاع نوع در(س، تعریف.typeRef).name
    ق := س.frags.دریافت(گراف‌کیوال.یافتن قطعه(س، "Info"))
    سرچاپ ق.name، ق.typeCondition، ق.selections.طول()
    سرچاپ گراف‌کیوال.چاپ مقدار رشته("سلام \"دنیا\"")
    گراف‌کیوال.آزادسازی سند(س)

    ناپایا سالم := نادرست
    ج := گراف‌کیوال.توکن‌سازی(`{ a(x: 1.5, y: "s") }`، سالم)
    سرچاپ سالم، ج.toks.طول()
    ت := ج.toks.دریافت(۵)
    سرچاپ گراف‌کیوال.نام نوع توکن(ت.kind)، ت.lexeme، ت.fval، ت.line، ت.col
    سرچاپ گراف‌کیوال.توکن رشته است(گراف‌کیوال.نشانه رشته)، گراف‌کیوال.نام نوع توکن(گراف‌کیوال.نشانه آکولاد باز)

    _ := گراف‌کیوال.تجزیه("{ a(", خطا)
    سرچاپ خطا.category == گراف‌کیوال.دسته خطای نحوی، خطا.line، خطا.col، خطا.hasLocation
    سرچاپ گراف‌کیوال.رشته خطا(خطا)

    ناپایا ف := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای اجرا، "شکست")
    گراف‌کیوال.افزودن کلید مسیر(ف، "books")
    گراف‌کیوال.افزودن نمایه مسیر(ف، ۲)
    گراف‌کیوال.افزودن کلید مسیر(ف، "title")
    سرچاپ گراف‌کیوال.طول مسیر(ف)، گراف‌کیوال.رشته مسیر(ف)
    ناپایا فهرست := گراف‌کیوال.فهرست خطا {}
    گراف‌کیوال.افزودن خطا(فهرست، ف)
    گراف‌کیوال.افزودن خطا(فهرست، گراف‌کیوال.خطا در محل(گراف‌کیوال.دسته خطای اعتبارسنجی، "بد"، ۳، ۷))
    گراف‌کیوال.افزودن خطا(فهرست، گراف‌کیوال.خطای نحوی("پرانتز باز مانده"، ۱، ۴))
    سرچاپ گراف‌کیوال.خطا دارد(فهرست)، گراف‌کیوال.تعداد خطا(فهرست)، گراف‌کیوال.خطا در(فهرست، ۱).line
    سرچاپ مقدار.طول آرایه(گراف‌کیوال.خطاها به مقدار(فهرست))، مقدار.شیء است(گراف‌کیوال.خطا به مقدار(ف))
    گراف‌کیوال.آزادسازی خطا(خطا)
    گراف‌کیوال.آزادسازی فهرست خطا(فهرست)
    سرچاپ گراف‌کیوال.دسته خطای درخواست، گراف‌کیوال.ویرایش مشخصات

    ناپایا ط := گراف‌کیوال.تجزیه طرح‌واره("type Query { n(x: Int!): Int e: Color } enum Color { RED }"، خطا)
    سرچاپ گراف‌کیوال.اعتبارسنجی منبع(ط، "{ n(x: \"a\") }").items.طول() > ۰
    ناپایا س۲ := گراف‌کیوال.تجزیه("{ n(x: 1) e }"، خطا)
    سرچاپ گراف‌کیوال.اعتبارسنجی موفق(ط، س۲)، گراف‌کیوال.اعتبارسنجی(ط، س۲).items.طول()
    ب := گراف‌کیوال.تبدیل نتیجه برگ(ط، "Color"، مقدار.مقدار رشته("RED"))
    سرچاپ ب.ok، مقدار.به رشته(ب.value)
    ب۲ := گراف‌کیوال.تبدیل نتیجه برگ(ط، "Int"، مقدار.مقدار رشته("x"))
    سرچاپ ب۲.ok، ب۲.message.طول() > ۰
    گراف‌کیوال.آزادسازی سند(س۲)
    گراف‌کیوال.آزادسازی طرح‌واره(ط)
پایان
