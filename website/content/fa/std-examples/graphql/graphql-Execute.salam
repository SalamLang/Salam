واردسازی گراف‌کیوال
واردسازی کدگذاری.مقدار

تابع کتاب(شناسه: رشته، عنوان: رشته، سال: صحیح۶۴): مقدار.مقدار:
    ناپایا ک := مقدار.شیء جدید()
    مقدار.تنظیم کلید(ک، "id"، مقدار.مقدار رشته(شناسه))
    مقدار.تنظیم کلید(ک، "title"، مقدار.مقدار رشته(عنوان))
    مقدار.تنظیم کلید(ک، "year"، مقدار.مقدار صحیح(سال))
    برگشت ک
پایان

تابع سلام(ش: صحیح۶۴):
    گراف‌کیوال.حل رشته(ش، "سلام " + گراف‌کیوال.آرگومان رشته(ش، "name"))
پایان

تابع کتاب‌ها(ش: صحیح۶۴):
    ناپایا آ := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(آ، کتاب("1"، "بوف کور"، ۱۹۳۶))
    مقدار.افزودن به آرایه(آ، کتاب("2"، "سووشون"، ۱۹۶۹))
    گراف‌کیوال.حل(ش، آ)
پایان

تابع یک کتاب(ش: صحیح۶۴):
    اگر گراف‌کیوال.آرگومان عددی(ش، "id") == ۲:
        گراف‌کیوال.حل(ش، کتاب("2"، "سووشون"، ۱۹۶۹))
    وگرنه:
        گراف‌کیوال.حل تهی(ش)
    پایان
پایان

تابع سن(ش: صحیح۶۴):
    سال := مقدار.به صحیح(گراف‌کیوال.فیلد والد(ش، "year"))
    گراف‌کیوال.حل عددی(ش، ۲۰۲۶ - سال)
پایان

تابع امتیاز(ش: صحیح۶۴):
    گراف‌کیوال.حل اعشاری(ش، گراف‌کیوال.آرگومان اعشاری(ش، "base") * ۲.۰)
پایان

تابع موجود(ش: صحیح۶۴):
    گراف‌کیوال.حل بولی(ش، گراف‌کیوال.آرگومان بولی(ش، "only") یا گراف‌کیوال.آرگومان دارد(ش، "x"))
پایان

تابع خراب(ش: صحیح۶۴):
    گراف‌کیوال.شکست(ش، "سرویس در دسترس نیست")
پایان

تابع ریشه:
    ناپایا خطا := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای نحوی، "")
    ناپایا ط := گراف‌کیوال.تجزیه طرح‌واره(`
type Query {
  hello(name: String = "دنیا"): String!
  books: [Book!]!
  book(id: Int!): Book
  score(base: Float!): Float!
  inStock(only: Boolean!): Boolean!
  broken: String
}
type Book {
  id: ID!
  title: String!
  year: Int!
  age: Int!
}`، خطا)
    _ := گراف‌کیوال.تعیین حل‌کننده(ط، "Query"، "hello"، سلام)
    _ := گراف‌کیوال.تعیین حل‌کننده(ط، "Query"، "books"، کتاب‌ها)
    _ := گراف‌کیوال.تعیین حل‌کننده(ط، "Query"، "book"، یک کتاب)
    _ := گراف‌کیوال.تعیین حل‌کننده(ط، "Query"، "score"، امتیاز)
    _ := گراف‌کیوال.تعیین حل‌کننده(ط، "Query"، "inStock"، موجود)
    _ := گراف‌کیوال.تعیین حل‌کننده(ط، "Query"، "broken"، خراب)
    _ := گراف‌کیوال.تعیین حل‌کننده(ط، "Book"، "age"، سن)
    سرچاپ گراف‌کیوال.حل‌کننده دارد(ط، "Book"، "age")، گراف‌کیوال.حل‌کننده دارد(ط، "Book"، "title")

    ناپایا ن := گراف‌کیوال.اجرای ساده(ط، `{ hello books { title year age } }`)
    سرچاپ گراف‌کیوال.نتیجه موفق(ن)
    سرچاپ گراف‌کیوال.نتیجه به جیسون قطعی(ن)
    گراف‌کیوال.آزادسازی نتیجه(ن)

    ناپایا متغیرها := مقدار.شیء جدید()
    مقدار.تنظیم کلید(متغیرها، "id"، مقدار.مقدار صحیح(۲))
    ناپایا ن۲ := گراف‌کیوال.اجرای منبع(ط، `query One($id: Int!) { book(id: $id) { title } missing: book(id: 9) { title } score(base: 1.5) inStock(only: true) hello(name: "مریم") }`، "One"، متغیرها، مقدار.مقدار تهی()، مقدار.مقدار تهی())
    سرچاپ گراف‌کیوال.نتیجه به جیسون قطعی(ن۲)
    گراف‌کیوال.آزادسازی نتیجه(ن۲)

    ناپایا ن۳ := گراف‌کیوال.اجرای ساده(ط، `{ broken hello }`)
    سرچاپ گراف‌کیوال.نتیجه موفق(ن۳)، گراف‌کیوال.پیام خطای نتیجه(ن۳)
    سرچاپ گراف‌کیوال.نتیجه به جیسون قطعی(ن۳)
    گراف‌کیوال.آزادسازی نتیجه(ن۳)

    ناپایا ن۴ := گراف‌کیوال.اجرای ساده(ط، `{ nope }`)
    سرچاپ گراف‌کیوال.پیام خطای نتیجه(ن۴)
    گراف‌کیوال.آزادسازی نتیجه(ن۴)
    گراف‌کیوال.بازنشانی شکاف‌ها()
    گراف‌کیوال.آزادسازی طرح‌واره(ط)
پایان
