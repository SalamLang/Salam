واردسازی گراف‌کیوال
واردسازی کدگذاری.مقدار
واردسازی شبکه.اچ تی تی پی شبکه
واردسازی شبکه.مسیریاب شبکه

ناپایا طرح := گراف‌کیوال.طرح‌واره جدید()

روال من(ش: صحیح۶۴):
    ز := گراف‌کیوال.زمینه(ش)
    ناپایا نام := "مهمان"
    اگر مقدار.شیء دارد(ز، "user"):
        نام = مقدار.به رشته(مقدار.مقدار کلید(ز، "user"))
    پایان
    گراف‌کیوال.حل رشته(ش، نام + " (" + گراف‌کیوال.نام نوع والد(ش) + "." + گراف‌کیوال.نام فیلد(ش) + ")")
پایان

روال جمع(ش: صحیح۶۴):
    گراف‌کیوال.حل عددی(ش، گراف‌کیوال.آرگومان عددی(ش، "a") + گراف‌کیوال.آرگومان عددی(ش، "b"))
پایان

روال نقطه پایانی(ز: صحیح۶۴):
    پ := گراف‌کیوال.رسیدگی ساده به وب(طرح، اچ تی تی پی شبکه.روش زمینه(ز)، اچ تی تی پی شبکه.سرصفحه زمینه(ز، "Content-Type")، اچ تی تی پی شبکه.بدنه زمینه(ز)، اچ تی تی پی شبکه.پرسمان خام زمینه(ز))
    اچ تی تی پی شبکه.وضعیت زمینه(ز، پ.status)
    اچ تی تی پی شبکه.تنظیم سرصفحه زمینه(ز، "Content-Type"، پ.contentType)
    اچ تی تی پی شبکه.متن زمینه(ز، پ.body)
پایان

روال ریشه:
    ناپایا خطا := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای نحوی، "")
    گراف‌کیوال.تجزیه در طرح‌واره(طرح، "type Query { me: String! add(a: Int!, b: Int!): Int! }"، خطا)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Query"، "me"، من)
    _ := گراف‌کیوال.تعیین حل‌کننده(طرح، "Query"، "add"، جمع)

    ناپایا م := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.ارسال(م، "/graphql"، نقطه پایانی)
    مسیریاب شبکه.دریافت(م، "/graphql"، نقطه پایانی)
    ناپایا س := اچ تی تی پی شبکه.سرور جدید(۱۹۶۱۳)
    اچ تی تی پی شبکه.استفاده(س، م)
    _ := اچ تی تی پی شبکه.اجرا در پس زمینه(س)

    ناپایا متغیر := مقدار.شیء جدید()
    مقدار.تنظیم کلید(متغیر، "x"، مقدار.مقدار صحیح(۴۰))
    بدنه := گراف‌کیوال.ساخت بدنه درخواست("query Sum($x: Int!) { add(a: $x, b: 2) }"، "Sum"، متغیر)
    سرچاپ بدنه
    ناپایا سر := اچ تی تی پی شبکه.سرصفحه جدید()
    سر.درج("Content-Type"، "application/json")
    پ := اچ تی تی پی شبکه.ارسال با("http://127.0.0.1:19613/graphql"، بدنه، سر)
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ)، اچ تی تی پی شبکه.بدنه(پ)
    ناپایا ج := گراف‌کیوال.تجزیه پاسخ(اچ تی تی پی شبکه.بدنه(پ))
    سرچاپ گراف‌کیوال.پاسخ موفق(ج)، ج.hasData، مقدار.به صحیح(گراف‌کیوال.فیلد پاسخ(ج، "add"))
    گراف‌کیوال.آزادسازی پاسخ کارخواه(ج)

    پرس := گراف‌کیوال.ساخت رشته پرس‌وجو("{ me }"، ""، مقدار.مقدار تهی())
    پ۲ := اچ تی تی پی شبکه.دریافت("http://127.0.0.1:19613/graphql?" + پرس)
    سرچاپ اچ تی تی پی شبکه.بدنه(پ۲)
    پ۳ := اچ تی تی پی شبکه.ارسال با("http://127.0.0.1:19613/graphql"، گراف‌کیوال.ساخت بدنه پرس‌وجو("{ nope }")، سر)
    ناپایا ج۳ := گراف‌کیوال.تجزیه پاسخ(اچ تی تی پی شبکه.بدنه(پ۳))
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ۳)، گراف‌کیوال.پاسخ موفق(ج۳)، گراف‌کیوال.پیام خطای پاسخ(ج۳)
    گراف‌کیوال.آزادسازی پاسخ کارخواه(ج۳)

    ناپایا د := گراف‌کیوال.تجزیه درخواست جیسون(`{"query":"{ me }"}`)
    ناپایا زمینه := مقدار.شیء جدید()
    مقدار.تنظیم کلید(زمینه، "user"، مقدار.مقدار رشته("مریم"))
    ناپایا ن := گراف‌کیوال.رسیدگی به درخواست(طرح، د، مقدار.مقدار تهی()، زمینه)
    سرچاپ گراف‌کیوال.نتیجه به جیسون(ن)
    گراف‌کیوال.آزادسازی نتیجه(ن)
    گراف‌کیوال.آزادسازی درخواست وب(د)
    ب := گراف‌کیوال.تجزیه درخواست وب("PUT"، "application/json"، "{}"، "")
    سرچاپ ب.ok، ب.error
    پ۴ := گراف‌کیوال.رسیدگی به وب(طرح، "POST"، "application/json"، "not json"، ""، مقدار.مقدار تهی()، مقدار.مقدار تهی())
    سرچاپ پ۴.status
پایان
