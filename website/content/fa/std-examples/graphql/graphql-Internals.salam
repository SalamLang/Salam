واردسازی گراف‌کیوال
واردسازی کدگذاری.مقدار
واردسازی کدگذاری.جیسون

تابع اسم‌ها(ش: صحیح۶۴):
    گراف‌کیوال.حل رشته(ش، جیسون.کدگذاری پیش فرض(گراف‌کیوال.آرگومان‌ها(ش)))
پایان

تابع ریشه:
    ناپایا سالم := نادرست
    ج := گراف‌کیوال.توکن‌سازی(`query Q($v: [Int!]! = [1]) @x { ...F a: b(c: 2.5, d: """متن""") | & ? }`، سالم)
    ناپایا گونه‌ها := ""
    هر ت در ج.توکن‌ها:
        اگر گونه‌ها.طول() > ۰:
            گونه‌ها += " "
        پایان
        گونه‌ها += گراف‌کیوال.نام نوع توکن(ت.نوع)
    پایان
    سرچاپ سالم، گونه‌ها
    سرچاپ گراف‌کیوال.نشانه انتهای متن، گراف‌کیوال.نشانه نام، گراف‌کیوال.نشانه عدد صحیح، گراف‌کیوال.نشانه عدد اعشاری، گراف‌کیوال.نشانه رشته بلوکی، گراف‌کیوال.نشانه علامت تعجب، گراف‌کیوال.نشانه دلار
    سرچاپ گراف‌کیوال.نشانه امپرسند، گراف‌کیوال.نشانه پرانتز باز، گراف‌کیوال.نشانه پرانتز بسته، گراف‌کیوال.نشانه پخش، گراف‌کیوال.نشانه دونقطه، گراف‌کیوال.نشانه مساوی، گراف‌کیوال.نشانه ات
    سرچاپ گراف‌کیوال.نشانه کروشه باز، گراف‌کیوال.نشانه کروشه بسته، گراف‌کیوال.نشانه آکولاد بسته، گراف‌کیوال.نشانه خط عمودی، گراف‌کیوال.نشانه خطا

    ناپایا خطا := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای نحوی، "")
    ناپایا ط := گراف‌کیوال.تجزیه طرح‌واره(`
type Query { names(a: Boolean, b: Float, o: In, v: Int): String! book: Book }
input In { x: Int! }
type Book { id: ID! title: String! }`، خطا)
    _ := گراف‌کیوال.تعیین حل‌کننده(ط، "Query"، "names"، اسم‌ها)

    ناپایا س := گراف‌کیوال.تجزیه(`query ($v: Int, $l: [Int!]) { names(a: true, b: 1.5, o: { x: 3 }, v: $v) book { id ...F ... on Book { title } } }
fragment F on Book { title }`، خطا)
    عملیات := س.عملیات‌ها.دریافت(۰)
    سرچاپ عملیات.نوع عملیات == گراف‌کیوال.عملیات پرسمان
    نام‌ها := گراف‌کیوال.گزینش در(س، عملیات.گزینش‌ها.دریافت(۰))
    ناپایا متغیرها := مقدار.شیء جدید()
    مقدار.تنظیم کلید(متغیرها، "v"، مقدار.مقدار صحیح(۴۲))
    هر آ در نام‌ها.آرگومان‌ها:
        م := گراف‌کیوال.مقدار در(س، آ.مقدار)
        ل := گراف‌کیوال.تبدیل لفظ به مقدار(ط، س، آ.مقدار، متغیرها)
        سرچاپ آ.نام، م.نوع == گراف‌کیوال.مقدار بولی، م.نوع == گراف‌کیوال.مقدار اعشاری، م.نوع == گراف‌کیوال.مقدار شیء، م.نوع == گراف‌کیوال.مقدار متغیر، ل.موفق، جیسون.کدگذاری پیش فرض(ل.مقدار)
    پایان

    ل۲ := عملیات.تعریف‌های متغیر.دریافت(۱).ارجاع نوع
    عنصر := گراف‌کیوال.عنصر ارجاع نوع(س، ل۲)
    سرچاپ گراف‌کیوال.چاپ ارجاع نوع(س، ل۲)، گراف‌کیوال.چاپ ارجاع نوع(س، عنصر)، گراف‌کیوال.ارجاع نوع در(س، عنصر).نوع == گراف‌کیوال.ارجاع نوع نام‌دار
    ناپایا فهرست := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(فهرست، مقدار.مقدار صحیح(۱))
    مقدار.افزودن به آرایه(فهرست، مقدار.مقدار رشته("دو"))
    ت := گراف‌کیوال.تبدیل ورودی(ط، س، ل۲، فهرست)
    سرچاپ ت.موفق، ت.پیام.طول() > ۰

    کتاب := گراف‌کیوال.گزینش در(س، عملیات.گزینش‌ها.دریافت(۱))
    سرچاپ گراف‌کیوال.گزینش در(س، کتاب.گزینش‌ها.دریافت(۱)).نوع == گراف‌کیوال.گزینش پخش قطعه، گراف‌کیوال.گزینش در(س، کتاب.گزینش‌ها.دریافت(۲)).نوع == گراف‌کیوال.گزینش قطعه درون‌خطی
    ناپایا گروه‌ها := گراف‌کیوال.گردآوری فیلدها(ط، س، کتاب.گزینش‌ها، "Book"، متغیرها)
    هر گ در گروه‌ها.گروه‌ها:
        سرچاپ گ.کلید، گ.گزینش‌ها.طول()، گراف‌کیوال.ادغام گزینش‌ها(س، گ).طول()
    پایان
    گراف‌کیوال.آزادسازی گروه‌های فیلد(گروه‌ها)

    ناپایا ن := گراف‌کیوال.اجرا(ط، س، ""، متغیرها، مقدار.مقدار تهی()، مقدار.مقدار تهی())
    ناپایا افزونه := مقدار.شیء جدید()
    مقدار.تنظیم کلید(افزونه، "ms"، مقدار.مقدار صحیح(۳))
    گراف‌کیوال.تعیین افزونه‌ها(ن، افزونه)
    سرچاپ مقدار.شیء است(گراف‌کیوال.نتیجه به مقدار(ن))
    سرچاپ گراف‌کیوال.نتیجه به جیسون با تورفتگی(ن)
    گراف‌کیوال.آزادسازی نتیجه(ن)
    گراف‌کیوال.آزادسازی سند(س)
    گراف‌کیوال.آزادسازی طرح‌واره(ط)
    گراف‌کیوال.آزادسازی خطا(خطا)
پایان
