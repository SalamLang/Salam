"تاریخ به شکل YYYY-MM-DD"
scalar Date

interface Node {
  id: ID!
}

"نویسنده"
type Author implements Node {
  id: ID!
  name: String!
  born: Date
}

enum Genre {
  NOVEL
  POETRY
}

union SearchResult = Author

input AuthorInput {
  name: String!
}

type Query {
  authors: [Author!]!
  search(text: String!, genre: Genre): [SearchResult!]!
}

type Mutation {
  addAuthor(input: AuthorInput!): Author!
}
---
enum Genre {
  NOVEL
  POETRY
}

true true true
Author true نویسنده true
search genre false
name
true
true false true
true true 1
Mutation 0
deprecated
true
true false
true true
true
true false
true 0
0 2 3 4 5
