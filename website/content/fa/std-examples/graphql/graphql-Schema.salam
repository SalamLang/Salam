واردسازی گراف‌کیوال

تابع ریشه:
    ناپایا ط := گراف‌کیوال.طرح‌واره جدید()
    گراف‌کیوال.افزودن نوع اسکالر(ط، "Date"، "تاریخ به شکل YYYY-MM-DD")
    گراف‌کیوال.افزودن نوع رابط(ط، "Node"، "")
    _ := گراف‌کیوال.افزودن فیلد(ط، "Node"، "id"، "ID!")
    گراف‌کیوال.افزودن نوع شیء(ط، "Author"، "نویسنده")
    گراف‌کیوال.افزودن رابط به(ط، "Author"، "Node")
    _ := گراف‌کیوال.افزودن فیلد(ط، "Author"، "id"، "ID!")
    _ := گراف‌کیوال.افزودن فیلد(ط، "Author"، "name"، "String!")
    _ := گراف‌کیوال.افزودن فیلد(ط، "Author"، "born"، "Date")
    ناپایا ژانرها := وکتور {} برگردان وکتور<رشته>
    ژانرها.افزودن("NOVEL")
    ژانرها.افزودن("POETRY")
    گراف‌کیوال.افزودن نوع شمارشی(ط، "Genre"، ژانرها)
    ناپایا اعضا := وکتور {} برگردان وکتور<رشته>
    اعضا.افزودن("Author")
    گراف‌کیوال.افزودن نوع اجتماع(ط، "SearchResult"، اعضا)
    گراف‌کیوال.افزودن نوع ورودی(ط، "AuthorInput"، "")
    _ := گراف‌کیوال.افزودن فیلد ورودی(ط، "AuthorInput"، "name"، "String!")
    گراف‌کیوال.افزودن نوع شیء(ط، "Query"، "")
    _ := گراف‌کیوال.افزودن فیلد(ط، "Query"، "authors"، "[Author!]!")
    _ := گراف‌کیوال.افزودن فیلد(ط، "Query"، "search"، "[SearchResult!]!")
    _ := گراف‌کیوال.افزودن آرگومان فیلد(ط، "Query"، "search"، "text"، "String!")
    _ := گراف‌کیوال.افزودن آرگومان فیلد(ط، "Query"، "search"، "genre"، "Genre")
    گراف‌کیوال.افزودن نوع شیء(ط، "Mutation"، "")
    _ := گراف‌کیوال.افزودن فیلد(ط، "Mutation"، "addAuthor"، "Author!")
    _ := گراف‌کیوال.افزودن آرگومان فیلد(ط، "Mutation"، "addAuthor"، "input"، "AuthorInput!")
    گراف‌کیوال.تعیین انواع ریشه(ط، "Query"، "Mutation"، "")
    چاپ گراف‌کیوال.چاپ طرح‌واره(ط)
    سرچاپ "---"
    سرچاپ گراف‌کیوال.چاپ نوع(ط، "Genre")

    سرچاپ گراف‌کیوال.نوع دارد(ط، "Author")، گراف‌کیوال.نمایه نوع(ط، "Author") >= ۰، گراف‌کیوال.تعداد نوع(ط) > ۵
    ن := گراف‌کیوال.یافتن نوع(ط، "Author")
    سرچاپ ن.name، ن.kind == گراف‌کیوال.گونه شیء، ن.description، گراف‌کیوال.فیلد دارد(ن، "born")
    ف := گراف‌کیوال.یافتن فیلد(گراف‌کیوال.یافتن نوع(ط، "Query")، "search")
    سرچاپ ف.name، گراف‌کیوال.یافتن آرگومان(ف، "genre").name، گراف‌کیوال.یافتن آرگومان(ف، "genre").hasDefault
    سرچاپ گراف‌کیوال.یافتن فیلد ورودی(گراف‌کیوال.یافتن نوع(ط، "AuthorInput")، "name").name
    سرچاپ گراف‌کیوال.مقدار شمارشی دارد(گراف‌کیوال.یافتن نوع(ط، "Genre")، "POETRY")
    سرچاپ گراف‌کیوال.نوع ورودی است(ط، "AuthorInput")، گراف‌کیوال.نوع خروجی است(ط، "AuthorInput")، گراف‌کیوال.نوع برگ است(ط، "Genre")
    سرچاپ گراف‌کیوال.نوع انتزاعی است(ط، "SearchResult")، گراف‌کیوال.نوع ممکن است(ط، "Node"، "Author")، گراف‌کیوال.انواع ممکن(ط، "Node").طول()
    سرچاپ گراف‌کیوال.نام نوع ریشه(ط، گراف‌کیوال.عملیات تغییر)، گراف‌کیوال.نام نوع ریشه(ط، گراف‌کیوال.عملیات اشتراک).طول()
    سرچاپ گراف‌کیوال.یافتن تعریف دستورالعمل(ط، "deprecated").name
    سرچاپ گراف‌کیوال.نوع در(ط، ۰).name.طول() > ۰
    سرچاپ گراف‌کیوال.نوع درون‌نگری است("__Schema")، گراف‌کیوال.نوع درون‌نگری است("Author")
    گراف‌کیوال.افزودن انواع درون‌نگری(ط)
    سرچاپ گراف‌کیوال.نوع دارد(ط، "__Type")، گراف‌کیوال.چاپ کامل طرح‌واره(ط).طول() > گراف‌کیوال.چاپ طرح‌واره(ط).طول()
    سرچاپ گراف‌کیوال.متن ارجاع نوع(ط، "[Int!]") >= ۰

    سرچاپ گراف‌کیوال.تجزیه طرح‌واره موفق("type Query { a: Int }")، گراف‌کیوال.تجزیه طرح‌واره موفق("type {")
    ناپایا خطا := گراف‌کیوال.خطای جدید(گراف‌کیوال.دسته خطای نحوی، "")
    گراف‌کیوال.تجزیه در طرح‌واره(ط، "extend type Author { alias: String }"، خطا)
    سرچاپ گراف‌کیوال.فیلد دارد(گراف‌کیوال.یافتن نوع(ط، "Author")، "alias")، خطا.message.طول()
    سرچاپ گراف‌کیوال.گونه نرده‌ای، گراف‌کیوال.گونه رابط، گراف‌کیوال.گونه اجتماع، گراف‌کیوال.گونه شمارشی، گراف‌کیوال.گونه شیء ورودی
    گراف‌کیوال.آزادسازی طرح‌واره(ط)
پایان
