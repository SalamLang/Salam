واردسازی جی آر پی سی
واردسازی فشرده سازی
واردسازی همگام سازی

ناپایا سرور := جی آر پی سی.سرور جدید(۰)
ناپایا آماده := همگام سازی.گروه انتظار جدید()

روال سلام(ف: صحیح۶۴):
    ناپایا سالم := نادرست
    نام := جی آر پی سی.دریافت متن(ف، سالم)
    _ := جی آر پی سی.ارسال متن(ف، "سلام " + نام)
    جی آر پی سی.تنظیم وضعیت(ف، جی آر پی سی.وضعیت بدون خطا، "")
پایان

روال شمارش(ف: صحیح۶۴):
    ناپایا سالم := نادرست
    _ := جی آر پی سی.دریافت(ف، سالم)
    تکرار ۳ در ش:
        _ := جی آر پی سی.ارسال(ف، فشرده سازی.بافر از رشته("" + (۳ - ش)))
    پایان
    جی آر پی سی.تنظیم وضعیت(ف، جی آر پی سی.وضعیت بدون خطا، "")
پایان

روال ردیابی(ف: صحیح۶۴):
    ناپایا سالم := نادرست
    _ := جی آر پی سی.دریافت متن(ف، سالم)
    _ := جی آر پی سی.ارسال متن(ف، جی آر پی سی.دریافت فراداده(جی آر پی سی.فراداده فراخوان(ف)، "x-trace") + " " + جی آر پی سی.مسیر فراخوان(ف))
    جی آر پی سی.تنظیم وضعیت(ف، جی آر پی سی.وضعیت بدون خطا، "")
پایان

روال ممنوع(ف: صحیح۶۴):
    جی آر پی سی.شکست(ف، جی آر پی سی.وضعیت دسترسی رد شد، "توکن منقضی شده")
پایان

روال اجرای سرور():
    _ := جی آر پی سی.گوش دادن(سرور)
    همگام سازی.اتمام(آماده)
    _ := جی آر پی سی.خدمت به تعداد(سرور، ۱)
پایان

روال ریشه:
    مسیر سلام := جی آر پی سی.مسیر متد("demo.Greeter"، "SayHello")
    سرچاپ مسیر سلام
    جی آر پی سی.ثبت متد(مسیر سلام، سلام)
    جی آر پی سی.ثبت متد جریانی("/demo.Greeter/Countdown"، شمارش، نادرست، درست)
    جی آر پی سی.ثبت متد("/demo.Greeter/Trace"، ردیابی)
    جی آر پی سی.ثبت متد("/demo.Greeter/Admin"، ممنوع)
    سرچاپ جی آر پی سی.تعداد متدها()، جی آر پی سی.متد دارد(مسیر سلام)
    همگام سازی.افزودن(آماده، ۱)
    ن := spawn(اجرای سرور)
    همگام سازی.انتظار(آماده)

    ناپایا ک := جی آر پی سی.اتصال("127.0.0.1"، جی آر پی سی.درگاه(سرور))
    جی آر پی سی.تنظیم مهلت(ک، ۵۰۰۰)
    سرچاپ جی آر پی سی.کانال معتبر(ک)
    ناپایا نتیجه := جی آر پی سی.وضعیت {}
    سرچاپ جی آر پی سی.فراخوان یگانه متنی(ک، مسیر سلام، "مریم"، نتیجه)، جی آر پی سی.وضعیت موفق(نتیجه)

    ف := جی آر پی سی.شروع فراخوان(ک، "/demo.Greeter/Countdown"، جی آر پی سی.فراداده جدید())
    _ := جی آر پی سی.ارسال پیام(ک، ف، فشرده سازی.بافر از رشته("go")، درست)
    ناپایا ادامه := درست
    تا ادامه:
        ناپایا سالم := نادرست
        پ := جی آر پی سی.دریافت پیام(ک، ف، سالم)
        اگر وارونه سالم:
            ادامه = نادرست
        وگرنه:
            سرچاپ "پیام:"، فشرده سازی.بافر به رشته(پ)
        پایان
    پایان
    سرچاپ جی آر پی سی.تعداد فراداده(جی آر پی سی.سرآیندهای فراخوان(ک، ف))
    سرچاپ جی آر پی سی.متن وضعیت(جی آر پی سی.پایان فراخوان(ک، ف))

    ناپایا ف‌د := جی آر پی سی.فراداده جدید()
    _ := جی آر پی سی.افزودن فراداده(ف‌د، "x-trace"، "t-42")
    ناپایا نتیجه۲ := جی آر پی سی.وضعیت {}
    پاسخ := جی آر پی سی.فراخوان یگانه(ک، "/demo.Greeter/Trace"، فشرده سازی.بافر از رشته("x")، ف‌د، نتیجه۲)
    سرچاپ فشرده سازی.بافر به رشته(پاسخ)

    ف۲ := جی آر پی سی.شروع فراخوان(ک، "/demo.Greeter/Trace"، ف‌د)
    _ := جی آر پی سی.ارسال پیام(ک، ف۲، فشرده سازی.بافر از رشته("y")، نادرست)
    _ := جی آر پی سی.بستن ارسال(ک، ف۲)
    ناپایا سالم۲ := نادرست
    _ := جی آر پی سی.دریافت پیام(ک، ف۲، سالم۲)
    _ := جی آر پی سی.پایان فراخوان(ک، ف۲)
    سرچاپ سالم۲، جی آر پی سی.دنباله‌های فراخوان(ک، ف۲).items.طول() >= ۰

    ناپایا نتیجه۳ := جی آر پی سی.وضعیت {}
    _ := جی آر پی سی.فراخوان یگانه متنی(ک، "/demo.Greeter/Admin"، ""، نتیجه۳)
    سرچاپ نتیجه۳.code، نتیجه۳.message، جی آر پی سی.نام وضعیت(نتیجه۳.code)
    ناپایا نتیجه۴ := جی آر پی سی.وضعیت {}
    _ := جی آر پی سی.فراخوان یگانه متنی(ک، "/demo.Greeter/Nope"، ""، نتیجه۴)
    سرچاپ جی آر پی سی.متن وضعیت(نتیجه۴)
    جی آر پی سی.بستن کانال(ک)
    join(ن)
    جی آر پی سی.توقف سرور(سرور)
    جی آر پی سی.بازنشانی متدها()
    سرچاپ جی آر پی سی.تعداد متدها()
پایان
