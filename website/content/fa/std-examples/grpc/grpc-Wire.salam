واردسازی جی آر پی سی
واردسازی فشرده سازی
واردسازی شبکه.اچ تی تی پی۲

تابع ریشه:
    یک := جی آر پی سی.قاب‌بندی پیام متنی("سلام")
    سرچاپ یک.len، فشرده سازی.دریافت بایت(یک، ۰)، فشرده سازی.دریافت بایت(یک، ۴)
    ناپایا همه := فشرده سازی.بافر بایت جدید()
    فشرده سازی.افزودن بافر(همه، یک)
    فشرده سازی.افزودن بافر(همه، جی آر پی سی.قاب‌بندی پیام(فشرده سازی.بافر از رشته("دو")، نادرست))
    فشرده سازی.افزودن بافر(همه، جی آر پی سی.قاب‌بندی فشرده(فشرده سازی.بافر از رشته("سه سه سه سه سه")، درست))
    سرچاپ جی آر پی سی.تعداد پیام‌ها(همه)، جی آر پی سی.پیام کامل دارد(همه، ۰)
    ناپایا جا := ۰
    ناپایا سالم := نادرست
    تا جی آر پی سی.پیام کامل دارد(همه، جا):
        پ := جی آر پی سی.پیام بعدی(همه، جا، سالم)
        سرچاپ سالم، فشرده سازی.بافر به رشته(پ)
    پایان

    ناپایا ف := جی آر پی سی.فراداده جدید()
    _ := جی آر پی سی.افزودن فراداده(ف، "authorization"، "Bearer abc")
    _ := جی آر پی سی.افزودن فراداده(ف، "x-tag"، "a")
    _ := جی آر پی سی.افزودن فراداده(ف، "x-tag"، "b")
    _ := جی آر پی سی.افزودن فراداده دودویی(ف، "trace-bin"، "\x01\x02")
    سرچاپ جی آر پی سی.تعداد فراداده(ف)، جی آر پی سی.فراداده دارد(ف، "x-tag")، جی آر پی سی.دریافت فراداده(ف، "authorization")
    سرچاپ جی آر پی سی.دریافت همه فراداده(ف، "x-tag").طول()
    سرچاپ جی آر پی سی.کلید فراداده(ف، ۳)، جی آر پی سی.مقدار فراداده(ف، ۳).طول()
    ناپایا سر := اچ تی تی پی۲.فهرست سرآیندها {}
    جی آر پی سی.فراداده به سرآیند(ف، سر)
    سرچاپ اچ تی تی پی۲.تعداد سرآیندها(سر)، اچ تی تی پی۲.دریافت سرآیند(سر، "trace-bin")
    سرچاپ جی آر پی سی.تعداد فراداده(جی آر پی سی.فراداده از سرآیند(سر))

    خ := جی آر پی سی.وضعیت جدید(جی آر پی سی.وضعیت یافت نشد، "کاربر ۴۲ نیست")
    سرچاپ جی آر پی سی.وضعیت موفق(خ)، جی آر پی سی.متن وضعیت(خ)
    پیام := جی آر پی سی.کدگذاری پیام وضعیت("۱۰۰٪ کامل")
    سرچاپ پیام، جی آر پی سی.کدگشایی پیام وضعیت(پیام)
    سرچاپ جی آر پی سی.قالب‌بندی کد وضعیت(۱۴)، جی آر پی سی.تجزیه کد وضعیت("14")، جی آر پی سی.تجزیه کد وضعیت("x")
    سرچاپ جی آر پی سی.نام وضعیت(جی آر پی سی.وضعیت گذشت مهلت)، جی آر پی سی.نام وضعیت(جی آر پی سی.وضعیت احراز نشده)
    سرچاپ جی آر پی سی.وضعیت لغو شده، جی آر پی سی.وضعیت ناشناخته، جی آر پی سی.وضعیت آرگومان نامعتبر، جی آر پی سی.وضعیت از پیش موجود
    سرچاپ جی آر پی سی.وضعیت منابع تمام شد، جی آر پی سی.وضعیت پیش‌شرط ناموفق، جی آر پی سی.وضعیت قطع شده، جی آر پی سی.وضعیت خارج از محدوده
    سرچاپ جی آر پی سی.وضعیت پیاده‌سازی نشده، جی آر پی سی.وضعیت خطای داخلی، جی آر پی سی.وضعیت ناموجود، جی آر پی سی.وضعیت از دست رفتن داده
    سرچاپ جی آر پی سی.نوع محتوا، جی آر پی سی.نوع محتوای پروتو، جی آر پی سی.نوع محتوای جیسون
    سرچاپ جی آر پی سی.بدون فشرده‌سازی، جی آر پی سی.فشرده‌سازی جی زیپ، جی آر پی سی.بیشینه قاب‌ها، جی آر پی سی.بیشینه اندازه پیام
