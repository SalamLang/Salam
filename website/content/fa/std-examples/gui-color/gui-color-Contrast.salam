واردسازی رابط گرافیکی.رنگ
واردسازی ریاضی

تابع r2(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 100.0) / 100.0
پایان

تابع ریشه:
    متغیر_white := رنگ.هگز(0xffffff)
    هر متغیر_hex در [0x777777، 0x3366aa، 0x1a1a1a]:
        نویسه := رنگ.هگز(متغیر_hex)
        سرچاپ رنگ.سی اس اس(نویسه)، "luminance"، r2(رنگ.درخشندگی(نویسه))، "contrast on white"، r2(رنگ.نسبت تضاد(نویسه، متغیر_white))
    پایان
    متغیر_base := رنگ.هگز(0x3366aa)
    سرچاپ "lighter"، رنگ.سی اس اس(رنگ.روشن تر(متغیر_base، 0.1))، "darker"، رنگ.سی اس اس(رنگ.تیره تر(متغیر_base، 0.1))
پایان
