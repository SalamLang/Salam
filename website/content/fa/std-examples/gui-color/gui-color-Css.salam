واردسازی رابط گرافیکی.رنگ

تابع show(text: رشته):
    ناپایا نویسه := رنگ.رنگ {}
    اگر رنگ.تجزیه(text، نویسه):
        سرچاپ text
        سرچاپ "  css   "، رنگ.سی اس اس(نویسه)
        سرچاپ "  source"، رنگ.کد سلام(نویسه)
        سرچاپ "  in sRGB"، رنگ.درون گستره(نویسه)، "same as #f00"، رنگ.یکسان(نویسه، رنگ.هگز(0xff0000))
    پایان
پایان

تابع ریشه:
    show("red")
    show("rgba(0, 0, 0, 0.25)")
    show("color(display p3, 1, 0, 0)")
    show("color(rec2020, 1, 0, 0)")
    show("current")
پایان
