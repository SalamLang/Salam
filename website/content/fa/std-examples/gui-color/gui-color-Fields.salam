واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    نویسه := رنگ.آر جی بی آلفا(51، 102، 170، 0.5)
    سرچاپ "r"، نویسه.قرمز، "g"، نویسه.سبز، "b"، نویسه.آبی، "a"، نویسه.آلفا، "current"، نویسه.کنونی
    متغیر_wide := رنگ.تازه(1.093، -0.227، -0.15، 1.0)
    سرچاپ "wide gamut red keeps channels outside 0 to 1:"، متغیر_wide.قرمز، متغیر_wide.سبز
    سرچاپ "argb"، رنگ.ای آر جی بی(نویسه)، "back"، رنگ.سی اس اس(رنگ.از ای آر جی بی(رنگ.ای آر جی بی(نویسه)))
    سرچاپ "argb clamps"، رنگ.ای آر جی بی(متغیر_wide)
پایان
