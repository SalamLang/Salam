واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    c := رنگ.روشن تیره(رنگ.هگز(0x3366aa)، رنگ.آر جی بی(200، 220، 255))
    سرچاپ رنگ.سی اس اس(c)، رنگ.تیره دارد(c)، رنگ.تیره دارد(رنگ.هگز(0x3366aa))
    سرچاپ "light"، رنگ.سی اس اس(رنگ.روشن(c))، "dark"، رنگ.سی اس اس(رنگ.تیره(c))
    سرچاپ "fields"، c.دارای تیره، c.قرمز تیره، c.سبز تیره، c.آبی تیره، c.آلفای تیره، c.کنونی تیره
    ناپایا t := رنگ.رنگ {}
    اگر رنگ.تجزیه("light dark(current, white)"، t):
        سرچاپ رنگ.سی اس اس(t)، t.کنونی، t.کنونی تیره
    پایان
    سرچاپ "mix keeps both"، رنگ.سی اس اس(رنگ.آمیختن(c، رنگ.هگز(0xffffff)، 0.5))
پایان
