واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    نویسه := رنگ.روشن تیره(رنگ.هگز(0x3366aa)، رنگ.آر جی بی(200، 220، 255))
    سرچاپ رنگ.سی اس اس(نویسه)، رنگ.تیره دارد(نویسه)، رنگ.تیره دارد(رنگ.هگز(0x3366aa))
    سرچاپ "light"، رنگ.سی اس اس(رنگ.روشن(نویسه))، "dark"، رنگ.سی اس اس(رنگ.تیره(نویسه))
    سرچاپ "fields"، نویسه.دارای تیره، نویسه.قرمز تیره، نویسه.سبز تیره، نویسه.آبی تیره، نویسه.آلفای تیره، نویسه.کنونی تیره
    ناپایا موقت := رنگ.رنگ {}
    اگر رنگ.تجزیه("light dark(current, white)"، موقت):
        سرچاپ رنگ.سی اس اس(موقت)، موقت.کنونی، موقت.کنونی تیره
    پایان
    سرچاپ "mix keeps both"، رنگ.سی اس اس(رنگ.آمیختن(نویسه، رنگ.هگز(0xffffff)، 0.5))
پایان
