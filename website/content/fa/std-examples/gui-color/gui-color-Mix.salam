واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    متغیر_red := رنگ.هگز(0xff0000)
    متغیر_blue := رنگ.هگز(0x0000ff)
    سرچاپ "Mix 30%"، رنگ.سی اس اس(رنگ.آمیختن(متغیر_red، متغیر_blue، 0.3))
    هر متغیر_space در ["oklab"، "oklch"، "srgb"، "hsl"]:
        سرچاپ "MixIn"، متغیر_space، رنگ.سی اس اس(رنگ.آمیختن با فضا(متغیر_red، متغیر_blue، 0.5، متغیر_space))
    پایان
    متغیر_clear := رنگ.آر جی بی آلفا(255، 0، 0، 0.0)
    تکرار 5 در شمارنده:
        موقت := شمارنده برگردان اعشار۶۴ / 4.0
        سرچاپ "Lerp"، موقت، رنگ.سی اس اس(رنگ.درون یابی(متغیر_clear، متغیر_blue، موقت))
    پایان
پایان
