واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    red := رنگ.هگز(0xff0000)
    blue := رنگ.هگز(0x0000ff)
    سرچاپ "Mix 30%"، رنگ.سی اس اس(رنگ.آمیختن(red، blue، 0.3))
    هر space در ["oklab"، "oklch"، "srgb"، "hsl"]:
        سرچاپ "MixIn"، space، رنگ.سی اس اس(رنگ.آمیختن با فضا(red، blue، 0.5، space))
    پایان
    clear := رنگ.آر جی بی آلفا(255، 0، 0، 0.0)
    تکرار 5 در i:
        t := i برگردان اعشار۶۴ / 4.0
        سرچاپ "Lerp"، t، رنگ.سی اس اس(رنگ.درون یابی(clear، blue، t))
    پایان
پایان
