واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    هر text در ["#3366aa"، "rgb(51, 102, 170)"، "hsl(210, 50%, 40%)"، "oklch(0.7 0.25 30)"، "light dark(white, #222)"، "قرمز"، "rgb(51, 102)"، "redd"]:
        ناپایا c := رنگ.رنگ {}
        اگر رنگ.تجزیه(text، c):
            سرچاپ text، "=>"، رنگ.سی اس اس(c)
        وگرنه:
            سرچاپ text، "=>"، رنگ.خطا(text)
        پایان
    پایان
پایان
