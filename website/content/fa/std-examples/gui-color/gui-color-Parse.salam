واردسازی رابط گرافیکی.رنگ

تابع ریشه:
    هر متن در ["#3366aa"، "rgb(51, 102, 170)"، "hsl(210, 50%, 40%)"، "oklch(0.7 0.25 30)"، "light dark(white, #222)"، "قرمز"، "rgb(51, 102)"، "redd"]:
        ناپایا نویسه := رنگ.رنگ {}
        اگر رنگ.تجزیه(متن، نویسه):
            سرچاپ متن، "=>"، رنگ.سی اس اس(نویسه)
        وگرنه:
            سرچاپ متن، "=>"، رنگ.خطا(متن)
        پایان
    پایان
پایان
