// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس

تابع ریشه:
    ناپایا برگه := سی اس اس.برگه تازه()
    دیرکن برگه.آزادسازی برگه()
    ناپایا عنصرها := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا کارت := سی اس اس.عنصر تازه("box"، -۱)
    کارت.اعلان های پایه = "border: 8px solid; border-image: linear-gradient(45deg, red, blue) 30% fill / 2 / 4px round stretch; background: linear-gradient(90deg in oklch, oklch(70% 0.15 30), 25%, oklch(60% 0.12 250))"
    عنصرها.بیفزا(کارت)
    _n := برگه.محاسبه سبک ها(عنصرها، سی اس اس.محیط {})
    سبک := برگه.سبک عنصر(0)
    لبه := سبک.تصویر لبه
    سرچاپ "منبع:"، سی اس اس.متن مقدار(سبک، "border-image-source")
    سرچاپ "برش:"، سی اس اس.متن درازا(لبه.برش بالا)، سی اس اس.متن درازا(لبه.برش راست)، سی اس اس.متن درازا(لبه.برش پایین)، سی اس اس.متن درازا(لبه.برش چپ)، "پر"، لبه.پرکردن میانه
    سرچاپ "پهنا:"، لبه.پهنای تصویر بالا.قسم درازا برابر سی اس اس.نوع‌درازا.عدد بی واحد، لبه.پهنای تصویر بالا.پیکسل درازا، لبه.پهنای تصویر راست.پیکسل درازا، لبه.پهنای تصویر پایین.پیکسل درازا، لبه.پهنای تصویر چپ.پیکسل درازا
    سرچاپ "بیرون زدگی:"، سی اس اس.متن درازا(لبه.بیرون زدگی بالا)، سی اس اس.متن درازا(لبه.بیرون زدگی راست)، سی اس اس.متن درازا(لبه.بیرون زدگی پایین)، سی اس اس.متن درازا(لبه.بیرون زدگی چپ)
    سرچاپ "تکرار:"، لبه.تکرار افقی لبه برابر سی اس اس.کاشی‌پس‌زمینه.کاشی گرد شده، لبه.تکرار عمودی لبه برابر سی اس اس.کاشی‌پس‌زمینه.کشیدن، لبه.منبع تصویر لبه.نوع تصویر لایه برابر سی اس اس.نوع‌تصویر.گرادیان خطی
    لایه := سبک.لایه های پس زمینه[۰]
    سرچاپ "فضای گرادیان:"، لایه.فضای درون یابی، "فام:"، لایه.روش درون یابی فام، "نوشته شده:"، لایه.فضای درون یابی نوشته شده
    ناپایا ایستگاه‌ها := سی اس اس.ایستگاه های شیب(لایه، ۲۰۰.۰)
    نخست := ایستگاه‌ها[۰]
    واپسین := ایستگاه‌ها[ایستگاه‌ها.طول() - ۱]
    سرچاپ "ایستگاه‌ها هنگام کشیدن:"، ایستگاه‌ها.طول()، سی اس اس.متن رنگ(نخست.رنگ ایستگاه)، "در"، نخست.جای ایستگاه.پیکسل درازا، "تا"، سی اس اس.متن رنگ(واپسین.رنگ ایستگاه)، "در"، واپسین.جای ایستگاه.پیکسل درازا
    ایستگاه‌ها.آزادکن()
    ناپایا آ := سی اس اس.رنگ‌سی‌اس‌اس {}
    ناپایا ب := سی اس اس.رنگ‌سی‌اس‌اس {}
    _x := سی اس اس.تجزیه رنگ("oklch(70% 0.15 30)"، آ)
    _y := سی اس اس.تجزیه رنگ("oklch(60% 0.12 250)"، ب)
    میانه := سی اس اس.آمیختن رنگ ها(آ، ب، ۰.۵)
    سرچاپ "قدیمی:"، آ.رنگ قدیمی، "میانه‌ی گذار:"، سی اس اس.متن رنگ(میانه)
    عنصرها[۰].آزادسازی عنصر()
    عنصرها.آزادکن()
پایان
