// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس

تابع ریشه:
    ناپایا sheet := سی اس اس.برگه تازه()
    دیرکن sheet.آزادسازی برگه()
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا root := سی اس اس.عنصر تازه("page"، -1)
    root.اعلان های پایه = "color: #222; font: 16px/1.5 Vazirmatn, sans-serif"
    els.بیفزا(root)
    ناپایا card := سی اس اس.عنصر تازه("box"، 0)
    card.اعلان های پایه = `display: flex; position: relative; top: 4px; flex-flow: row wrap; gap: 8px 2%; padding: 12px 16px; margin: 0 auto; border: 2px solid #ccc; border-radius: 12px; background: linear-gradient(to right, #fff 0%, #eee 100%), url(bg.png) center / cover no-repeat, #fafafa; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.2); outline: 1px dashed red; outline-offset: 2px; opacity: 0.9; transform: rotate(5deg) scale(1.1); transform-origin: left top; translate: 4px 2px; rotate: 10deg; scale: 2; transition: opacity 300ms ease-out 100ms; cursor: pointer; z-index: 3; text-align: center; text-shadow: 1px 1px 2px black; letter-spacing: 1px; word-spacing: 2px; text-decoration: underline overline line-through wavy red 2px; list-style: square inside; caret-color: blue; accent-color: green; color-scheme: light dark; aspect-ratio: 4 / 3; overflow: hidden auto; white-space: nowrap; text-overflow: ellipsis; word-break: break-all; overflow-wrap: anywhere; tab-size: 4; vertical-align: middle; float: left; clear: both; user-select: none; pointer-events: none; visibility: visible; object-fit: cover; object-position: right bottom; border-collapse: collapse; border-spacing: 2px 4px; table-layout: fixed; appearance: none; font-style: italic; font-variant-caps: small-caps; font-stretch: condensed; text-transform: uppercase; text-indent: 1em; order: 2; flex-grow: 1; flex-shrink: 0; flex-basis: 50%; justify-content: center; align-items: stretch; align-self: flex-start; align-content: space-around; justify-items: start; justify-self: end; box-sizing: border-box; direction: ltr; min-width: 100px; max-width: 800px; min-height: 2em; max-height: none; width: 50%; height: auto; right: auto; bottom: auto; left: 0`
    els.بیفزا(card)
    _n := sheet.محاسبه سبک ها(els، سی اس اس.محیط {})
    cs := sheet.سبک عنصر(1)
    سرچاپ cs.نمایش، cs.جایگاه، سی اس اس.متن درازا(cs.فاصله از بالا)، سی اس اس.متن درازا(cs.فاصله از راست)، سی اس اس.متن درازا(cs.فاصله از پایین)، سی اس اس.متن درازا(cs.فاصله از چپ)
    سرچاپ cs.سنجش جعبه، سی اس اس.متن درازا(cs.پهنا)، سی اس اس.متن درازا(cs.بلندی)، سی اس اس.متن درازا(cs.کمینه پهنا)، سی اس اس.متن درازا(cs.کمینه بلندی)، سی اس اس.متن درازا(cs.بیشینه پهنا)
    سرچاپ سی اس اس.متن درازا(cs.بیشینه بلندی)، cs.نسبت ابعاد، سی اس اس.متن درازا(cs.حاشیه بالا)، سی اس اس.متن درازا(cs.حاشیه راست)، سی اس اس.متن درازا(cs.حاشیه پایین)، سی اس اس.متن درازا(cs.حاشیه چپ)
    سرچاپ سی اس اس.متن درازا(cs.فاصله داخلی بالا)، سی اس اس.متن درازا(cs.فاصله داخلی راست)، سی اس اس.متن درازا(cs.فاصله داخلی پایین)، سی اس اس.متن درازا(cs.فاصله داخلی چپ)، cs.مرز بالا.پهنای ضلع، cs.مرز بالا.سبک ضلع
    سرچاپ سی اس اس.متن رنگ(cs.مرز بالا.رنگ ضلع)، cs.مرز راست.پهنای ضلع، cs.مرز راست.سبک ضلع، سی اس اس.متن رنگ(cs.مرز راست.رنگ ضلع)، cs.مرز پایین.پهنای ضلع، cs.مرز پایین.سبک ضلع
    سرچاپ سی اس اس.متن رنگ(cs.مرز پایین.رنگ ضلع)، cs.مرز چپ.پهنای ضلع، cs.مرز چپ.سبک ضلع، سی اس اس.متن رنگ(cs.مرز چپ.رنگ ضلع)، سی اس اس.متن درازا(cs.گردی بالا چپ.شعاع افقی)، سی اس اس.متن درازا(cs.گردی بالا چپ.شعاع عمودی)
    سرچاپ سی اس اس.متن درازا(cs.گردی بالا راست.شعاع افقی)، سی اس اس.متن درازا(cs.گردی بالا راست.شعاع عمودی)، سی اس اس.متن درازا(cs.گردی پایین راست.شعاع افقی)، سی اس اس.متن درازا(cs.گردی پایین راست.شعاع عمودی)، سی اس اس.متن درازا(cs.گردی پایین چپ.شعاع افقی)، سی اس اس.متن درازا(cs.گردی پایین چپ.شعاع عمودی)
    سرچاپ cs.سرریز افقی، cs.سرریز عمودی، cs.جهت نوشتار، cs.جهت فلکس، cs.شکست فلکس، cs.رشد فلکس
    سرچاپ cs.کوچک شدن فلکس، سی اس اس.متن درازا(cs.پایه فلکس)، cs.پخش محتوا، cs.تراز فرزندان، cs.تراز خود، cs.تراز محتوا
    سرچاپ cs.پخش فرزندان، cs.پخش خود، سی اس اس.متن درازا(cs.فاصله سطرها)، سی اس اس.متن درازا(cs.فاصله ستون ها)، cs.ترتیب، cs.عمق لایه
    سرچاپ cs.عمق خودکار، cs.شناور، cs.پاک سازی، cs.ترازبندی عمودی، سی اس اس.متن درازا(cs.درازای ترازبندی عمودی)، سی اس اس.متن رنگ(cs.رنگ متن)
    سرچاپ سی اس اس.متن رنگ(cs.رنگ پس زمینه)، cs.لایه های پس زمینه.طول()، cs.سایه های جعبه.طول()، cs.خط دور.پهنای ضلع، cs.خط دور.سبک ضلع، سی اس اس.متن رنگ(cs.خط دور.رنگ ضلع)
    سرچاپ cs.فاصله خط دور، cs.ماتی، cs.تبدیل ها.طول()، سی اس اس.متن درازا(cs.مبدأ تبدیل افقی)، سی اس اس.متن درازا(cs.مبدأ تبدیل عمودی)، سی اس اس.متن درازا(cs.انتقال افقی)
    سرچاپ سی اس اس.متن درازا(cs.انتقال عمودی)، cs.چرخش، cs.مقیاس افقی، cs.مقیاس عمودی، cs.دیدپذیری عنصر، "[" + cs.نشانگر + "]"
    سرچاپ cs.رویداد اشاره گر، cs.گزینش پذیری، "[" + cs.خانواده قلم + "]"، cs.سایز قلم، cs.ضریب سایز کلیدواژه، cs.وزن قلم
    سرچاپ cs.حالت قلم، cs.حروف کوچک بزرگ، cs.کشیدگی قلم، cs.ارتفاع خط، cs.ضریب ارتفاع خط، cs.ارتفاع خط معمولی
    سرچاپ cs.فاصله حروف، cs.فاصله واژه ها، cs.ترازبندی متن، سی اس اس.متن درازا(cs.تورفتگی متن)، cs.دگرگونی حروف، cs.فضای سفید متن
    سرچاپ cs.زیرخط، cs.بالاخط، cs.خط خورده، cs.سبک خط تزیینی، سی اس اس.متن رنگ(cs.رنگ خط تزیینی)، سی اس اس.متن درازا(cs.ضخامت خط تزیینی)
    سرچاپ cs.سایه های متن.طول()، cs.برش متن سرریز، cs.شکست واژه ها، cs.شکستن سرریز، cs.شمار فاصله تب، cs.درازای تب
    سرچاپ "[" + cs.نوع نشانه فهرست + "]"، cs.جای نشانه فهرست، "[" + cs.تصویر نشانه فهرست + "]"، cs.ادغام مرزها، cs.فاصله مرزها افقی، cs.فاصله مرزها عمودی
    سرچاپ cs.روش چینش جدول، cs.گذارها.طول()، سی اس اس.متن رنگ(cs.رنگ نشانگر متن)، سی اس اس.متن رنگ(cs.رنگ تاکید)، cs.تاکید خودکار، "[" + cs.ظاهر + "]"
    سرچاپ cs.طرح رنگ عنصر، cs.تیره به کار رفته، cs.جاگیری تصویر، سی اس اس.متن درازا(cs.جای تصویر افقی)، سی اس اس.متن درازا(cs.جای تصویر عمودی)
    l := cs.لایه های پس زمینه[0]
    سرچاپ l.نوع تصویر لایه، l.نشانی تصویر.طول()، l.گرادیان تکراری، l.زاویه گرادیان، l.سوی افقی گرادیان، l.سوی عمودی گرادیان، l.شکل گرادیان، l.گستره گرادیان، سی اس اس.متن درازا(l.شعاع افقی گرادیان)، سی اس اس.متن درازا(l.شعاع عمودی گرادیان)، سی اس اس.متن درازا(l.مرکز افقی گرادیان)، سی اس اس.متن درازا(l.مرکز عمودی گرادیان)
    سرچاپ l.ایستگاه های رنگ.طول()، سی اس اس.متن درازا(l.جای افقی لایه)، سی اس اس.متن درازا(l.جای عمودی لایه)، l.ابعاد لایه، سی اس اس.متن درازا(l.پهنای لایه)، سی اس اس.متن درازا(l.بلندی لایه)، l.کاشی افقی لایه، l.کاشی عمودی لایه، l.برش لایه، l.مبدأ لایه، l.لایه ثابت
    st := l.ایستگاه های رنگ[1]
    سرچاپ سی اس اس.متن رنگ(st.رنگ ایستگاه)، سی اس اس.متن درازا(st.جای ایستگاه)، st.جای دارد، st.راهنمای میانی
    u := cs.لایه های پس زمینه[1]
    سرچاپ u.نوع تصویر لایه، u.نشانی تصویر، u.ابعاد لایه، u.کاشی افقی لایه
    s := cs.سایه های جعبه[0]
    سرچاپ s.جابجایی افقی سایه، s.جابجایی عمودی سایه، s.تاری سایه، s.گسترش سایه، سی اس اس.متن رنگ(s.رنگ سایه)، s.سایه داخلی
    f := cs.تبدیل ها[1]
    سرچاپ f.قسم کارکرد تبدیل، سی اس اس.متن درازا(f.جابجایی افقی)، سی اس اس.متن درازا(f.جابجایی عمودی)، f.ضریب الف، f.ضریب ب، f.ضریب پ، f.ضریب ت، f.ضریب ث، f.ضریب ج
    t := cs.گذارها[0]
    سرچاپ t.ویژگی گذار، t.مدت گذار، t.درنگ گذار، t.زمان بندی گذار.قسم زمان بندی
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان
