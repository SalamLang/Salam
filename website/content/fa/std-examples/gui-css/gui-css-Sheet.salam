// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس
واردسازی حافظه

تابع ریشه:
    ناپایا sheet := سی اس اس.برگه تازه()
    دیرکن sheet.آزادسازی برگه()
    سرچاپ "rules"، sheet.شمار قاعده ها() بزرگتر 100
    _a := sheet.افزودن قاعده(".card > p:first-child"، "color: #334155; margin: 0 0 8px")
    _b := sheet.افزودن قاعده رسانه("(max-width: 600px)"، ".card"، "padding: 8px")
    سرچاپ "css rules"، sheet.افزودن سی اس اس("@media (prefers-color-scheme: dark) { body { background: #111 } } a:hover { color: red }")
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    ناپایا body := سی اس اس.عنصر تازه("page"، -1)
    body.اعلان های پایه = "font-family: Vazirmatn, sans-serif; --gap: 12px"
    els.بیفزا(body)
    ناپایا card := سی اس اس.عنصر تازه("box"، 0)
    card.شناسه عنصر = "main"
    card.کلاس های عنصر = "card"
    card.اعلان های پایه = "display: flex; gap: var(--gap); padding: 16px"
    card.افزودن رسانه("(min-width: 1200px)"، "padding: 32px")
    els.بیفزا(card)
    ناپایا p := سی اس اس.عنصر تازه("paragraph"، 1)
    p.افزودن ویژگی("lang"، "en")
    els.بیفزا(p)
    ناپایا link := سی اس اس.عنصر تازه("link"، 1)
    link.افزودن ویژگی("href"، "/next")
    link.اعلان های اشاره = "text-decoration: none"
    link.اعلان های تمرکز = "outline: 2px solid blue"
    link.اعلان های فشردن = "color: purple"
    els.بیفزا(link)
    سرچاپ "tag"، link.برچسب عنصر، link.کلید عنصر، link.والد عنصر، link.ویژگی دارد("href")
    env := سی اس اس.محیط { پهنای پنجره = 800.0، بلندی پنجره = 600.0، حالت تیره = نادرست، حرکت کمتر = نادرست، اشاره گر شناور = درست، اشاره گر دقیق = درست، جهت صفحه = "ltr"، زبان صفحه = "en" }
    سرچاپ "distinct"، sheet.محاسبه سبک ها(els، env)، "elements"، sheet.شمار عنصرها()
    cs := sheet.سبک عنصر(2)
    سرچاپ "p"، سی اس اس.متن مقدار(cs، "color")، سی اس اس.متن مقدار(cs، "margin-top")، سی اس اس.متن مقدار(cs، "margin-bottom")
    سرچاپ "card"، سی اس اس.متن مقدار(sheet.سبک عنصر(1)، "column-gap")، سی اس اس.متن مقدار(sheet.سبک عنصر(1)، "padding-top")
    سرچاپ "root"، سی اس اس.متن مقدار(sheet.سبک ریشه()، "display")، "same style"، sheet.شناسه سبک(2) برابر sheet.شناسه سبک(2)
    g := sheet.متغیر سفارشی(2، "--gap")
    سرچاپ "var"، g
    حافظه.آزادسازی(g برگردان تهی*)
    سرچاپ "matches"، sheet.تطبیق گزینشگر("#main > a[href]"، els، 3)
    top := سی اس اس.زنجیره اشاره(els، 3)
    سرچاپ "hovered"، els[3].زیر اشاره، els[1].زیر اشاره، "restyled"، sheet.سبک دهی دوباره(els، top)
    سرچاپ "after hover"، سی اس اس.متن مقدار(sheet.سبک عنصر(3)، "text-decoration-line")، "cascades"، sheet.شمار آبشارها()، "distinct"، sheet.شمار سبک های یکتا()
    ناپایا l2 := els.ارجاع(3)
    l2.دارای تمرکز = درست
    l2.تمرکز نمایان = درست
    l2.فشرده = درست
    _r := sheet.سبک دهی دوباره(els، 3)
    سرچاپ "focus"، سی اس اس.متن مقدار(sheet.سبک عنصر(3)، "outline-style")، سی اس اس.متن مقدار(sheet.سبک عنصر(3)، "color")
    ناپایا bare := سی اس اس.برگه خالی()
    دیرکن bare.آزادسازی برگه()
    سرچاپ "empty"، bare.شمار قاعده ها()، "defaults added"، bare.افزودن پیش فرض ها() بزرگتر 0
    ua := سی اس اس.سی اس اس پیش فرض()
    سرچاپ "default css bytes"، ua.طول() بزرگتر 1000، سی اس اس.برچسب نوع("ordered list")
    حافظه.آزادسازی(ua برگردان تهی*)
    سرچاپ "media"، env.پهنای پنجره، env.بلندی پنجره، env.حالت تیره، env.حرکت کمتر، env.اشاره گر شناور، env.اشاره گر دقیق، env.جهت صفحه، env.زبان صفحه، "[" + link.شناسه عنصر + "]"، "[" + link.کلاس های عنصر + "]"، "[" + link.اعلان های پایه + "]"
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        سرچاپ i، x.نام ویژگی ها.طول()، x.مقدار ویژگی ها.طول()، x.شرط های رسانه.طول()، x.اعلان های رسانه.طول()
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان
