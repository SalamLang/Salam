// زبان: فارسی
واردسازی رابط گرافیکی.سی اس اس
واردسازی حافظه

تابع ریشه:
    ناپایا c := سی اس اس.رنگ‌سی‌اس‌اس {}
    ok := سی اس اس.تجزیه رنگ("hsl(210 80% 50% / 0.5)"، c)
    t := سی اس اس.متن رنگ(c)
    سرچاپ ok، c.قرمز، c.سبز، c.آبی، c.آلفا، t
    حافظه.آزادسازی(t برگردان تهی*)
    ناپایا ds := سی اس اس.تجزیه اعلان ها("margin: 4px 8px; color: red !important; --x: 1")
    تکرار ds.طول() در i:
        d := ds[i]
        سرچاپ d.نام اعلان، d.مقدار اعلان، d.مهم
    پایان
    سی اس اس.آزادسازی اعلان ها(ds)
    sp := سی اس اس.ویژگی مندی گزینشگر("#nav .item:hover > a")
    سرچاپ "specificity"، sp.شمار شناسه ها، sp.شمار کلاس ها، sp.شمار نوع ها
    env := سی اس اس.محیط { پهنای پنجره = 500.0، بلندی پنجره = 800.0 }
    سرچاپ "media"، سی اس اس.تطبیق رسانه("(max-width: 600px) and (orientation: portrait)"، env)
    ease := سی اس اس.زمان‌بندی {}
    سرچاپ "ease"، ease.قسم زمان بندی، ease.ایکس یک، ease.ایگرگ یک، ease.ایکس دو، ease.ایگرگ دو، ease.شمار پله ها، ease.جای پرش، سی اس اس.مقدار تسهیل(ease، 0.5) بزرگتر 0.8
    steps := سی اس اس.زمان‌بندی { قسم زمان بندی = سی اس اس.نوع‌زمان‌بندی.Steps، شمار پله ها = 4، جای پرش = سی اس اس.جای‌پله.JumpEnd }
    سرچاپ "steps"، سی اس اس.مقدار تسهیل(steps، 0.6)
    ناپایا sheet := سی اس اس.برگه تازه()
    دیرکن sheet.آزادسازی برگه()
    ناپایا els := وکتور {} برگردان وکتور<سی اس اس.عنصر>
    els.بیفزا(سی اس اس.عنصر تازه("page"، -1))
    ناپایا box := سی اس اس.عنصر تازه("box"، 0)
    box.اعلان های پایه = "width: calc(100% - 2em); height: min(50vh, 300px); border-radius: 20px / 10px; transform: translate(10px, 0) rotate(90deg); font-family: Vazirmatn, Tahoma, sans-serif; display: flex; padding: 1em"
    els.بیفزا(box)
    _n := sheet.محاسبه سبک ها(els، env)
    cs := sheet.سبک عنصر(1)
    w := cs.پهنا
    wtext := سی اس اس.متن درازا(w)
    سرچاپ "width"، wtext، w.قسم درازا، w.پیکسل درازا، w.درصد درازا، w.درصد دارد، w.عبارت محاسبه.طول() برابر 0، سی اس اس.حل درازا(w، 300.0)
    حافظه.آزادسازی(wtext برگردان تهی*)
    سرچاپ "needs basis"، سی اس اس.نیاز به پایه(cs)
    b := سی اس اس.به جعبه(cs)
    bi := سی اس اس.به جعبه درون(cs، 300.0، 200.0)
    سرچاپ "box"، b.نمایش، b.پهنا.قسم درازا، bi.پهنا.مقدار درازا، bi.بلندی.مقدار درازا
    m := سی اس اس.ماتریس تبدیل(cs، 100.0، 40.0)
    سرچاپ "matrix"، m.خانه الف، m.خانه ب، m.خانه پ، m.خانه ت، m.خانه ث، m.خانه ج
    r := سی اس اس.شعاع های به کار رفته(cs، 30.0، 40.0)
    سرچاپ "radii"، r.بالا چپ افقی، r.بالا چپ عمودی، r.بالا راست افقی، r.بالا راست عمودی، r.پایین راست افقی، r.پایین راست عمودی، r.پایین چپ افقی، r.پایین چپ عمودی
    ناپایا fams := سی اس اس.خانواده های قلم(cs)
    سرچاپ "families"، fams.طول()، fams[0]، fams[2]
    fams.آزادکن()
    v := سی اس اس.متن مقدار(cs، "border-top-left-radius")
    سرچاپ "value text"، v
    حافظه.آزادسازی(v برگردان تهی*)
    تکرار els.طول() در i:
        ناپایا x := els.ارجاع(i)
        x.آزادسازی عنصر()
    پایان
    els.آزادکن()
پایان
