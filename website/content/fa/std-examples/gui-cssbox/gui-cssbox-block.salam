// زبان: فارسی
واردسازی رابط گرافیکی.جعبه سی اس اس

تابع ریشه:
    ناپایا t := جعبه سی اس اس.درخت {}
    دیرکن t.آزاد کردن()
    page := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(320.0)، جایگاه = جعبه سی اس اس.نوع‌جایگاه.نسبی، مرز = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(2.0)) })
    head := t.افزودن گره(جعبه سی اس اس.سبک { بلندی = جعبه سی اس اس.پیکسل(40.0)، حاشیه بیرونی = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.پیکسل(10.0)، جعبه سی اس اس.پیکسل(0.0)، جعبه سی اس اس.پیکسل(20.0)، جعبه سی اس اس.پیکسل(0.0)) })
    card := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.درصد(50.0)، حاشیه بیرونی = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.پیکسل(30.0)، جعبه سی اس اس.خودکار()، جعبه سی اس اس.پیکسل(0.0)، جعبه سی اس اس.خودکار())، حاشیه درونی = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(10.0))، سنجش جعبه = جعبه سی اس اس.نوع‌سنجش‌جعبه.جعبه مرز، کمینه بلندی = جعبه سی اس اس.پیکسل(60.0) })
    close := t.افزودن گره(جعبه سی اس اس.سبک { جایگاه = جعبه سی اس اس.نوع‌جایگاه.مطلق، فاصله جایگاه = جعبه سی اس اس.ساخت چهارسو(جعبه سی اس اس.پیکسل(4.0)، جعبه سی اس اس.پیکسل(4.0)، جعبه سی اس اس.خودکار()، جعبه سی اس اس.خودکار())، پهنا = جعبه سی اس اس.پیکسل(16.0)، بلندی = جعبه سی اس اس.پیکسل(16.0) })
    hidden := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.بدون نمایش، بلندی = جعبه سی اس اس.پیکسل(500.0) })
    t.افزودن فرزند(page، head)
    t.افزودن فرزند(page، card)
    t.افزودن فرزند(page، close)
    t.افزودن فرزند(page، hidden)
    t.محاسبه(page، جعبه سی اس اس.معین(800.0)، جعبه سی اس اس.معین(600.0))
    هر id در [page، head، card، close، hidden]:
        l := t.جانمایی گره(id)
        سرچاپ id، l.ایکس، l.ایگرگ، l.پهنای جعبه، l.بلندی جعبه، "margin"، l.حاشیه بیرونی جعبه.لبه بالا، l.حاشیه بیرونی جعبه.لبه چپ
    پایان
پایان
