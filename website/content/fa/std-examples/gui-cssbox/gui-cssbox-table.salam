// زبان: فارسی
واردسازی رابط گرافیکی.جعبه سی اس اس

تابع ریشه:
    ناپایا t := جعبه سی اس اس.درخت {}
    دیرکن t.آزاد کردن()
    table := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.جدول، فاصله مرز افقی = 4.0، فاصله مرز عمودی = 2.0، مرز = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(1.0)) })
    caption := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.عنوان جدول، سوی عنوان = جعبه سی اس اس.نوع‌سوی‌عنوان.عنوان پایین، بلندی = جعبه سی اس اس.پیکسل(16.0) })
    body := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.گروه سطر جدول })
    t.افزودن فرزند(table، caption)
    t.افزودن فرزند(table، body)
    widths := [30.0، 80.0، 50.0، 40.0، 120.0]
    ناپایا cells := وکتور {} برگردان وکتور<صحیح>
    دیرکن cells.آزادکن()
    تکرار 2 در r:
        row := t.افزودن گره(جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.سطر جدول })
        t.افزودن فرزند(body، row)
        تکرار 3 - r در c:
            ناپایا st := جعبه سی اس اس.سبک { نمایش = جعبه سی اس اس.نوع‌نمایش.خانه جدول، مرز = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(2.0))، حاشیه درونی = جعبه سی اس اس.همه سوها(جعبه سی اس اس.پیکسل(2.0))، تراز عمودی = جعبه سی اس اس.نوع‌تراز‌عمودی.تراز عمودی میانه }
            اگر r برابر 1 و c برابر 1:
                st.گستره ستون = 2
            پایان
            اگر r برابر 0 و c برابر 0:
                st.گستره سطر = 2
            پایان
            cell := t.افزودن گره(st)
            inner := t.افزودن گره(جعبه سی اس اس.سبک { پهنا = جعبه سی اس اس.پیکسل(widths[r * 3 + c])، بلندی = جعبه سی اس اس.پیکسل(12.0 + (r برگردان اعشار۶۴) * 10.0) })
            t.افزودن فرزند(cell، inner)
            t.افزودن فرزند(row، cell)
            cells.بیفزا(cell)
        پایان
    پایان
    t.محاسبه(table، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای بیشینه())
    tl := t.جانمایی گره(table)
    سرچاپ "table"، tl.پهنای جعبه، tl.بلندی جعبه
    هر c در cells:
        l := t.جانمایی گره(c)
        سرچاپ "cell"، c، l.ایکس، l.ایگرگ، l.پهنای جعبه، l.بلندی جعبه
    پایان
    cl := t.جانمایی گره(caption)
    سرچاپ "caption"، cl.ایگرگ، cl.پهنای جعبه
    ناپایا fixed := t.سبک گره(table)
    fixed.چینش جدول = جعبه سی اس اس.نوع‌چینش‌جدول.چینش ثابت جدول
    fixed.پهنا = جعبه سی اس اس.پیکسل(300.0)
    fixed.ادغام مرز = جعبه سی اس اس.نوع‌ادغام‌مرز.مرز ادغام شده
    t.تنظیم سبک(table، fixed)
    t.محاسبه(table، جعبه سی اس اس.فضای بیشینه()، جعبه سی اس اس.فضای بیشینه())
    هر c در cells:
        l := t.جانمایی گره(c)
        سرچاپ "fixed"، c، l.ایکس، l.پهنای جعبه، l.مرز جعبه.لبه چپ
    پایان
پایان
