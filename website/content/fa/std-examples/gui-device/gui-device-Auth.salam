واردسازی رابط گرافیکی.دستگاه
واردسازی رابط گرافیکی.رابط کاربری

تابع label(): رشته:
    state := دستگاه.وضعیت تایید هویت()
    اگر state برابر دستگاه.وضعیت تایید.موفق:
        برگشت "unlocked"
    پایان
    اگر state برابر دستگاه.وضعیت تایید.در انتظار:
        برگشت "waiting"
    پایان
    اگر state برابر دستگاه.وضعیت تایید.ناموفق:
        برگشت "not recognised"
    پایان
    برگشت "locked"
پایان

تابع ریشه:
    اگر وارونه دستگاه.قابل تایید():
        سرچاپ "no biometrics here"
        برگشت
    پایان
    دستگاه.هنگام تغییر((): رابط کاربری.بی اعتبار سازی() پایان)
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده صفحه):
        b.گشودن عنصر("button")
        b.رسیدگی رخداد("click"، (): _ok := دستگاه.تایید هویت("Unlock the notes") پایان)
        b.متن فرزند(label())
        b.بستن عنصر()
    پایان)
پایان
