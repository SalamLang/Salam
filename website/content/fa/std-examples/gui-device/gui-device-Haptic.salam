واردسازی رابط گرافیکی.دستگاه

تابع ریشه:
    اگر وارونه دستگاه.قابل لرزش():
        سرچاپ "no vibration here"
        برگشت
    پایان
    _ok := دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.ضربه)
    _ok2 := دستگاه.بازخورد لمسی(دستگاه.نوع لرزش.موفق)
    _ok3 := دستگاه.لرزاندن(200)
پایان
