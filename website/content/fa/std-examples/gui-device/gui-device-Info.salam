واردسازی رابط گرافیکی.دستگاه
واردسازی رابط گرافیکی.رابط کاربری

تابع network_name(): رشته:
    kind := دستگاه.شبکه()
    اگر kind برابر دستگاه.نوع شبکه.وای فای:
        برگشت "wifi"
    پایان
    اگر kind برابر دستگاه.نوع شبکه.تلفن همراه:
        برگشت "mobile data"
    پایان
    اگر kind برابر دستگاه.نوع شبکه.بدون شبکه:
        برگشت "offline"
    پایان
    برگشت "connected"
پایان

تابع ریشه:
    اگر دستگاه.نام سامانه().طول() برابر 0:
        سرچاپ "no device info here"
        برگشت
    پایان
    دستگاه.هنگام تغییر((): رابط کاربری.بی اعتبار سازی() پایان)
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده صفحه):
        b.گشودن عنصر("button")
        b.متن فرزند(دستگاه.مدل() + "، " + دستگاه.نام سامانه() + " " + دستگاه.نسخه سامانه())
        b.بستن عنصر()
        b.گشودن عنصر("button")
        b.متن فرزند("battery " + دستگاه.سطح باتری() + "%، " + network_name())
        b.بستن عنصر()
        b.گشودن عنصر("button")
        b.متن فرزند(دستگاه.زبان() + "، " + دستگاه.منطقه زمانی() + "، v" + دستگاه.نسخه برنامه())
        b.بستن عنصر()
    پایان)
پایان
