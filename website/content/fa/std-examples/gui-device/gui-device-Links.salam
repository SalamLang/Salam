واردسازی رابط گرافیکی.دستگاه
واردسازی رابط گرافیکی.رابط کاربری

ناپایا last := ""

تابع ریشه:
    last = دستگاه.پیوند آغاز()
    اگر last.طول() برابر 0 و دستگاه.سکو() برابر "none":
        سرچاپ "no links here"
        برگشت
    پایان
    دستگاه.هنگام باز شدن پیوند((url: رشته): رابط کاربری.بی اعتبار سازی() last = url پایان)
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده صفحه):
        b.گشودن عنصر("button")
        b.متن فرزند("opened with " + last)
        b.بستن عنصر()
        b.گشودن عنصر("button")
        b.رسیدگی رخداد("click"، (): _ok := دستگاه.گشودن تنظیمات() پایان)
        b.متن فرزند("app settings")
        b.بستن عنصر()
    پایان)
پایان
