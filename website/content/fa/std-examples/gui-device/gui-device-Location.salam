واردسازی رشته
واردسازی رابط گرافیکی.دستگاه
واردسازی رابط گرافیکی.رابط کاربری

تابع where(): رشته:
    state := دستگاه.وضعیت یابی()
    اگر state برابر دستگاه.وضعیت مکان.آماده:
        here := دستگاه.آخرین مکان()
        برگشت "lat " + رشته.از اعشار(here.عرض جغرافیایی) + " lon " + رشته.از اعشار(here.طول جغرافیایی) + " within " + رشته.از اعشار(here.دقت) + " m"
    پایان
    اگر state برابر دستگاه.وضعیت مکان.در انتظار:
        برگشت "looking for the position"
    پایان
    اگر state برابر دستگاه.وضعیت مکان.ناموفق:
        برگشت "no position"
    پایان
    برگشت "tap to locate"
پایان

تابع ask():
    اگر دستگاه.بررسی مجوز(دستگاه.مجوز.مکان) برابر دستگاه.وضعیت مجوز.داده شده:
        _ok := دستگاه.درخواست مکان()
        رابط کاربری.بی اعتبار سازی()
    وگرنه:
        _ok2 := دستگاه.درخواست مجوز(دستگاه.مجوز.مکان)
    پایان
پایان

تابع ریشه:
    سرچاپ where()
    دستگاه.هنگام تغییر((): رابط کاربری.بی اعتبار سازی() پایان)
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده صفحه):
        b.گشودن عنصر("button")
        b.رسیدگی رخداد("click"، (): ask() پایان)
        b.متن فرزند(where())
        b.بستن عنصر()
    پایان)
پایان
