واردسازی رابط گرافیکی.دستگاه
واردسازی ورودی خروجی

تابع ریشه:
    dir := دستگاه.پوشه داده()
    اگر dir.طول() برابر 0:
        سرچاپ "no app folders here"
        برگشت
    پایان
    سرچاپ "data"، dir
    سرچاپ "cache"، دستگاه.پوشه حافظه نهان()
    سرچاپ "documents"، دستگاه.پوشه اسناد()
    سرچاپ "temp"، دستگاه.پوشه موقت()
    _ok := ورودی خروجی.نوشتن پرونده(dir + "/notes.txt"، "saved")
پایان
