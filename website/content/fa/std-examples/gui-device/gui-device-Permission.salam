واردسازی رابط گرافیکی.دستگاه
واردسازی رابط گرافیکی.رابط کاربری

تابع label(): رشته:
    s := دستگاه.بررسی مجوز(دستگاه.مجوز.دوربین)
    اگر s برابر دستگاه.وضعیت مجوز.داده شده:
        برگشت "Camera allowed"
    پایان
    اگر s برابر دستگاه.وضعیت مجوز.رد شده:
        برگشت "Camera denied"
    پایان
    برگشت "Ask for the camera"
پایان

تابع ریشه:
    سرچاپ label()
    دستگاه.هنگام تغییر((): رابط کاربری.بی اعتبار سازی() پایان)
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده صفحه):
        b.گشودن عنصر("button")
        b.رسیدگی رخداد("click"، (): _ok := دستگاه.درخواست مجوز(دستگاه.مجوز.دوربین) پایان)
        b.متن فرزند(label())
        b.بستن عنصر()
    پایان)
پایان
