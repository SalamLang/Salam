واردسازی رابط گرافیکی.دستگاه
واردسازی رابط گرافیکی.رابط کاربری

تابع label(): رشته:
    state := دستگاه.وضعیت عکس گیری()
    اگر state برابر دستگاه.وضعیت عکس.آماده:
        برگشت "saved to " + دستگاه.آخرین عکس()
    پایان
    اگر state برابر دستگاه.وضعیت عکس.در انتظار:
        برگشت "waiting for the photo"
    پایان
    اگر state برابر دستگاه.وضعیت عکس.ناموفق:
        برگشت "no photo"
    پایان
    برگشت "choose a photo"
پایان

تابع ریشه:
    سرچاپ label()
    دستگاه.هنگام تغییر((): رابط کاربری.بی اعتبار سازی() پایان)
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده صفحه):
        b.گشودن عنصر("button")
        b.رسیدگی رخداد("click"، (): _ok := دستگاه.برگزیدن عکس() پایان)
        b.متن فرزند(label())
        b.بستن عنصر()
        b.گشودن عنصر("button")
        b.رسیدگی رخداد("click"، (): _ok2 := دستگاه.گرفتن عکس() پایان)
        b.متن فرزند("take a photo")
        b.بستن عنصر()
    پایان)
پایان
