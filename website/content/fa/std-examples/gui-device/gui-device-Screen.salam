واردسازی رابط گرافیکی.دستگاه
واردسازی رابط گرافیکی.رابط کاربری

ناپایا full := نادرست

تابع ریشه:
    اگر وارونه دستگاه.بیدار نگه داشتن(درست):
        سرچاپ "no screen control here"
        برگشت
    پایان
    _lock := دستگاه.قفل جهت(دستگاه.جهت صفحه.عمودی)
    رابط کاربری.اجرای صفحه((): برگشت رابط کاربری.بی وصله() پایان، (b: رابط کاربری.سازنده صفحه):
        b.گشودن عنصر("button")
        b.رسیدگی رخداد("click"، (): full = وارونه full _ok := دستگاه.فراگیر(full) پایان)
        b.متن فرزند("full screen")
        b.بستن عنصر()
        b.گشودن عنصر("button")
        b.رسیدگی رخداد("click"، (): _ok2 := دستگاه.گذاشتن روشنایی(1.0) پایان)
        b.متن فرزند("full brightness")
        b.بستن عنصر()
    پایان)
پایان
