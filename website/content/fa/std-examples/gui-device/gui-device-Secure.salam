واردسازی رابط گرافیکی.دستگاه

تابع ریشه:
    اگر وارونه دستگاه.ذخیره امن("token"، "s3cret"):
        سرچاپ "no secure storage here"
        برگشت
    پایان
    سرچاپ "token"، دستگاه.خواندن امن("token")
    _gone := دستگاه.حذف امن("token")
    سرچاپ "after delete"، دستگاه.خواندن امن("token").طول()
پایان
