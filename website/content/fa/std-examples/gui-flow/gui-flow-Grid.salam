// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(موقت &: چیدمان.درخت چیدمان، name: رشته، id: صحیح):
    سرچاپ name، موقت.ایکس(id)، موقت.ایگرگ(id)، موقت.پهنا(id)، موقت.بلندی(id)
پایان

تابع ریشه:
    ناپایا ستون‌ها := وکتور {} برگردان وکتور<چیدمان.شیار>
    ستون‌ها.افزودن(چیدمان.شیار با درازا(چیدمان.پیکسلی(80.0)))
    ستون‌ها.افزودن(چیدمان.شیار کمینه بیشینه(چیدمان.شیار با درازا(چیدمان.پیکسلی(60.0))، چیدمان.شیار سهمی(1.0)))
    ستون‌ها.افزودن(چیدمان.شیار اندازه محتوا(چیدمان.پیکسلی(100.0)))
    ناپایا ردیف‌ها := وکتور {} برگردان وکتور<چیدمان.شیار>
    ردیف‌ها.افزودن(چیدمان.شیار با درازا(چیدمان.پیکسلی(30.0)))
    ردیف‌ها.افزودن(چیدمان.شیار خودکار())
    گذار := ستون‌ها.دریافت(1)
    سرچاپ "minmax track"، گذار.کمینه.پیکسل، گذار.بیشینه.نوع، گذار.سهم، گذار.اندازه محتوا، گذار.شمار تکرار، گذار.شیارها.طول()
    ناپایا موقت := چیدمان.درخت تازه()
    متغیر_grid := موقت.افزودن(-1، چیدمان.سبک چیدمان {
        چینش = چیدمان.چینش‌شبکه‌ای،
        ستون‌ها = ستون‌ها،
        سطرها = ردیف‌ها،
        سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(20.0))،
        ستون‌های خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(40.0))،
        جریان خودکار = چیدمان.جریان‌سطری،
        فاصله ستون‌ها = چیدمان.پیکسلی(10.0)،
        فاصله سطرها = چیدمان.پیکسلی(5.0)
    })
    سرصفحه := موقت.افزودن(متغیر_grid، چیدمان.سبک چیدمان { ستون = 1، گستره ستون = 3 })
    کنار := موقت.افزودن(متغیر_grid، چیدمان.سبک چیدمان { سطر = 2، گستره سطر = 2، ستون = 1 })
    بدنه := موقت.افزودن(متغیر_grid، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(50.0) })
    متغیر_note := موقت.افزودن(متغیر_grid، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(30.0)، بلندی = چیدمان.پیکسلی(10.0)، پخش اختصاصی = چیدمان.تراز‌انتها، تراز اختصاصی = چیدمان.تراز‌وسط })
    آخر := موقت.افزودن(متغیر_grid، چیدمان.سبک چیدمان { ستون = -1 })
    موقت.چیدن(360.0، 400.0)
    show(موقت، "grid"، متغیر_grid)
    show(موقت، "header"، سرصفحه)
    show(موقت، "side"، کنار)
    show(موقت، "body"، بدنه)
    show(موقت، "note"، متغیر_note)
    show(موقت، "last"، آخر)

    ناپایا متغیر_cards := وکتور {} برگردان وکتور<چیدمان.شیار>
    ناپایا درونی := وکتور {} برگردان وکتور<چیدمان.شیار>
    درونی.افزودن(چیدمان.شیار کمینه بیشینه(چیدمان.شیار با درازا(چیدمان.پیکسلی(100.0))، چیدمان.شیار سهمی(1.0)))
    متغیر_cards.افزودن(چیدمان.شیارهای تکراری(چیدمان.تکرار‌اندازه‌محتوا، درونی))
    ناپایا جی := چیدمان.درخت تازه()
    متغیر_gallery := جی.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = متغیر_cards، سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(60.0))، فاصله ستون‌ها = چیدمان.پیکسلی(10.0) })
    الف := جی.افزودن(متغیر_gallery، چیدمان.سبک چیدمان {})
    بافر_محلی := جی.افزودن(متغیر_gallery، چیدمان.سبک چیدمان {})
    جی.چیدن(450.0، 300.0)
    show(جی، "card a"، الف)
    show(جی، "card b"، بافر_محلی)
    سرچاپ "repeat counts"، چیدمان.تکرار‌پرکننده، چیدمان.تکرار‌اندازه‌محتوا
    سرچاپ "auto flow"، چیدمان.جریان‌سطری، چیدمان.جریان‌ستونی، چیدمان.جریان‌سطری‌فشرده، چیدمان.جریان‌ستونی‌فشرده
پایان
