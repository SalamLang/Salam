// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(t &: چیدمان.درخت چیدمان، name: رشته، id: صحیح):
    سرچاپ name، t.ایکس(id)، t.ایگرگ(id)، t.پهنا(id)، t.بلندی(id)
پایان

تابع ریشه:
    ناپایا cols := وکتور {} برگردان وکتور<چیدمان.شیار>
    cols.افزودن(چیدمان.شیار با درازا(چیدمان.پیکسلی(80.0)))
    cols.افزودن(چیدمان.شیار کمینه بیشینه(چیدمان.شیار با درازا(چیدمان.پیکسلی(60.0))، چیدمان.شیار سهمی(1.0)))
    cols.افزودن(چیدمان.شیار اندازه محتوا(چیدمان.پیکسلی(100.0)))
    ناپایا rows := وکتور {} برگردان وکتور<چیدمان.شیار>
    rows.افزودن(چیدمان.شیار با درازا(چیدمان.پیکسلی(30.0)))
    rows.افزودن(چیدمان.شیار خودکار())
    tr := cols.دریافت(1)
    سرچاپ "minmax track"، tr.کمینه.پیکسل، tr.بیشینه.نوع، tr.سهم، tr.اندازه محتوا، tr.شمار تکرار، tr.شیارها.طول()
    ناپایا t := چیدمان.درخت تازه()
    grid := t.افزودن(-1، چیدمان.سبک چیدمان {
        چینش = چیدمان.چینش‌شبکه‌ای،
        ستون‌ها = cols،
        سطرها = rows،
        سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(20.0))،
        ستون‌های خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(40.0))،
        جریان خودکار = چیدمان.جریان‌سطری،
        فاصله ستون‌ها = چیدمان.پیکسلی(10.0)،
        فاصله سطرها = چیدمان.پیکسلی(5.0)
    })
    header := t.افزودن(grid، چیدمان.سبک چیدمان { ستون = 1، گستره ستون = 3 })
    side := t.افزودن(grid، چیدمان.سبک چیدمان { سطر = 2، گستره سطر = 2، ستون = 1 })
    body := t.افزودن(grid، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(50.0) })
    note := t.افزودن(grid، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(30.0)، بلندی = چیدمان.پیکسلی(10.0)، پخش اختصاصی = چیدمان.تراز‌انتها، تراز اختصاصی = چیدمان.تراز‌وسط })
    last := t.افزودن(grid، چیدمان.سبک چیدمان { ستون = -1 })
    t.چیدن(360.0، 400.0)
    show(t، "grid"، grid)
    show(t، "header"، header)
    show(t، "side"، side)
    show(t، "body"، body)
    show(t، "note"، note)
    show(t، "last"، last)

    ناپایا cards := وکتور {} برگردان وکتور<چیدمان.شیار>
    ناپایا inner := وکتور {} برگردان وکتور<چیدمان.شیار>
    inner.افزودن(چیدمان.شیار کمینه بیشینه(چیدمان.شیار با درازا(چیدمان.پیکسلی(100.0))، چیدمان.شیار سهمی(1.0)))
    cards.افزودن(چیدمان.شیارهای تکراری(چیدمان.تکرار‌اندازه‌محتوا، inner))
    ناپایا g := چیدمان.درخت تازه()
    gallery := g.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌شبکه‌ای، ستون‌ها = cards، سطرهای خودکار = چیدمان.شیار با درازا(چیدمان.پیکسلی(60.0))، فاصله ستون‌ها = چیدمان.پیکسلی(10.0) })
    a := g.افزودن(gallery، چیدمان.سبک چیدمان {})
    b := g.افزودن(gallery، چیدمان.سبک چیدمان {})
    g.چیدن(450.0، 300.0)
    show(g، "card a"، a)
    show(g، "card b"، b)
    سرچاپ "repeat counts"، چیدمان.تکرار‌پرکننده، چیدمان.تکرار‌اندازه‌محتوا
    سرچاپ "auto flow"، چیدمان.جریان‌سطری، چیدمان.جریان‌ستونی، چیدمان.جریان‌سطری‌فشرده، چیدمان.جریان‌ستونی‌فشرده
پایان
