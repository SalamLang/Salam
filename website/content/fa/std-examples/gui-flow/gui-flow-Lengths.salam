// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(name: رشته، l: چیدمان.درازا):
    سرچاپ name، "px"، l.پیکسل، "pct"، l.درصد، "kind"، l.نوع
پایان

تابع ریشه:
    show("Px(12)"، چیدمان.پیکسلی(12.0))
    show("Pct(0.5)"، چیدمان.درصدی(0.5))
    show("PxPct(-20, 1)"، چیدمان.پیکسل باضافه درصد(-20.0، 1.0))
    show("Auto"، چیدمان.خودکار())
    show("Fill"، چیدمان.پرکننده())
    show("Fit"، چیدمان.به اندازه محتوا())
    show("MinContent"، چیدمان.کمینه محتوا())
    show("MaxContent"، چیدمان.بیشینه محتوا())
    show("NoLimit"، چیدمان.بی‌حد())
    سرچاپ "kinds"، چیدمان.درازای‌ثابت، چیدمان.درازای‌خودکار، چیدمان.درازای‌پرکننده، چیدمان.درازای‌اندازه‌محتوا، چیدمان.درازای‌کمینه‌محتوا، چیدمان.درازای‌بیشینه‌محتوا، چیدمان.درازای‌تهی
    pad := چیدمان.چهار لبه(چیدمان.پیکسلی(4.0)، چیدمان.پیکسلی(8.0)، چیدمان.پیکسلی(4.0)، چیدمان.پیکسلی(16.0))
    سرچاپ "sides top"، pad.بالا.پیکسل، "end"، pad.انتها.پیکسل، "bottom"، pad.پایین.پیکسل، "start"، pad.آغاز.پیکسل
    ناپایا m := چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0))
    m.چپ = چیدمان.پیکسلی(2.0)
    m.راست = چیدمان.خودکار()
    سرچاپ "all with physical overrides"، m.بالا.پیکسل، m.چپ.پیکسل، m.راست.نوع
    s := چیدمان.ابعاد { پهنا = 120.0، بلندی = 16.0، خط پایه = 12.0 }
    سرچاپ "size"، s.پهنا، s.بلندی، s.خط پایه

    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.درصدی(0.05))، تراز = چیدمان.تراز‌آغاز })
    a := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسل باضافه درصد(-20.0، 1.0)، بلندی = چیدمان.پیکسلی(10.0) })
    b := t.افزودن(root، چیدمان.سبک چیدمان { پهنا = چیدمان.پرکننده()، بلندی = چیدمان.پیکسلی(10.0)، فاصله بیرونی = m })
    t.چیدن(200.0، 100.0)
    سرچاپ "a"، t.ایکس(a)، t.ایگرگ(a)، t.پهنا(a)، t.بلندی(a)
    سرچاپ "b"، t.ایکس(b)، t.ایگرگ(b)، t.پهنا(b)، t.بلندی(b)
پایان
