// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(name: رشته، l: چیدمان.درازا):
    سرچاپ name، "px"، l.پیکسل، "pct"، l.درصد، "kind"، l.نوع
پایان

تابع ریشه:
    show("Px(12)"، چیدمان.پیکسلی(12.0))
    show("Pct(0.5)"، چیدمان.درصدی(0.5))
    show("PxPct(-20, 1)"، چیدمان.پیکسل باضافه درصد(-20.0، 1.0))
    show("Auto"، چیدمان.خودکار())
    show("Fill"، چیدمان.پرکننده())
    show("Fit"، چیدمان.به اندازه محتوا())
    show("MinContent"، چیدمان.کمینه محتوا())
    show("MaxContent"، چیدمان.بیشینه محتوا())
    show("NoLimit"، چیدمان.بی‌حد())
    سرچاپ "kinds"، چیدمان.درازای‌ثابت، چیدمان.درازای‌خودکار، چیدمان.درازای‌پرکننده، چیدمان.درازای‌اندازه‌محتوا، چیدمان.درازای‌کمینه‌محتوا، چیدمان.درازای‌بیشینه‌محتوا، چیدمان.درازای‌تهی
    متغیر_pad := چیدمان.چهار لبه(چیدمان.پیکسلی(4.0)، چیدمان.پیکسلی(8.0)، چیدمان.پیکسلی(4.0)، چیدمان.پیکسلی(16.0))
    سرچاپ "sides top"، متغیر_pad.بالا.پیکسل، "end"، متغیر_pad.انتها.پیکسل، "bottom"، متغیر_pad.پایین.پیکسل، "start"، متغیر_pad.آغاز.پیکسل
    ناپایا تعداد۲ := چیدمان.همه لبه‌ها(چیدمان.پیکسلی(10.0))
    تعداد۲.چپ = چیدمان.پیکسلی(2.0)
    تعداد۲.راست = چیدمان.خودکار()
    سرچاپ "all with physical overrides"، تعداد۲.بالا.پیکسل، تعداد۲.چپ.پیکسل، تعداد۲.راست.نوع
    متن_نمونه := چیدمان.ابعاد { پهنا = 120.0، بلندی = 48.0، خط پایه = 12.0، خط پایه آخر = 44.0 }
    سرچاپ "size"، متن_نمونه.پهنا، متن_نمونه.بلندی، متن_نمونه.خط پایه، متن_نمونه.خط پایه آخر

    ناپایا موقت := چیدمان.درخت تازه()
    متغیر_root := موقت.افزودن(-1، چیدمان.سبک چیدمان { فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.درصدی(0.05))، تراز = چیدمان.تراز‌آغاز })
    الف := موقت.افزودن(متغیر_root، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسل باضافه درصد(-20.0، 1.0)، بلندی = چیدمان.پیکسلی(10.0) })
    بافر_محلی := موقت.افزودن(متغیر_root، چیدمان.سبک چیدمان { پهنا = چیدمان.پرکننده()، بلندی = چیدمان.پیکسلی(10.0)، فاصله بیرونی = تعداد۲ })
    موقت.چیدن(200.0، 100.0)
    سرچاپ "a"، موقت.ایکس(الف)، موقت.ایگرگ(الف)، موقت.پهنا(الف)، موقت.بلندی(الف)
    سرچاپ "b"، موقت.ایکس(بافر_محلی)، موقت.ایگرگ(بافر_محلی)، موقت.پهنا(بافر_محلی)، موقت.بلندی(بافر_محلی)
پایان
