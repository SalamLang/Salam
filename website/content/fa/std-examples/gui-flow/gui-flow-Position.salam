// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(t &: چیدمان.درخت چیدمان، name: رشته، id: صحیح):
    سرچاپ name، t.ایکس(id)، t.ایگرگ(id)، t.پهنا(id)، t.بلندی(id)
پایان

تابع ریشه:
    ناپایا t := چیدمان.درخت تازه()
    page := t.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌پشته‌ای، سرریز افقی = چیدمان.سرریز‌پنهان، سرریز عمودی = چیدمان.سرریز‌پیمایش })
    content := t.افزودن(page، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(900.0)، پهنا = چیدمان.پرکننده() })
    ناپایا top := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌چسبان، بلندی = چیدمان.پیکسلی(40.0) }
    top.فاصله جایگاه.بالا = چیدمان.پیکسلی(0.0)
    bar := t.افزودن(content، top)
    ناپایا corner := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، پهنا = چیدمان.پیکسلی(50.0)، بلندی = چیدمان.پیکسلی(20.0)، لایه = 1 }
    corner.فاصله جایگاه.انتها = چیدمان.پیکسلی(10.0)
    corner.فاصله جایگاه.بالا = چیدمان.پیکسلی(10.0)
    badge := t.افزودن(content، corner)
    ناپایا fab := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌ثابت، پهنا = چیدمان.پیکسلی(48.0)، بلندی = چیدمان.پیکسلی(48.0)، لایه = 2 }
    fab.فاصله جایگاه.راست = چیدمان.پیکسلی(16.0)
    fab.فاصله جایگاه.پایین = چیدمان.پیکسلی(16.0)
    button := t.افزودن(content، fab)
    t.چیدن(300.0، 400.0)
    سرچاپ "content size"، t.پهنای محتوا(page)، t.بلندی محتوا(page)
    t.تنظیم پیمایش(page، 0.0، 120.0)
    سرچاپ "scroll"، t.پیمایش افقی(page)، t.پیمایش عمودی(page)
    show(t، "bar"، bar)
    show(t، "badge"، badge)
    show(t، "button"، button)
    سرچاپ "button on screen"، t.ایکس مطلق(button)، t.ایگرگ مطلق(button)
    چاپ "paint order"
    order := t.ترتیب نقاشی(content)
    هر id در order:
        چاپ " "، id، "layer"، t.لایه(id)
    پایان
    سرچاپ ""
    order.آزادکن()
    سرچاپ "positions"، چیدمان.جایگاه‌عادی، چیدمان.جایگاه‌مطلق، چیدمان.جایگاه‌ثابت، چیدمان.جایگاه‌چسبان
    سرچاپ "overflow"، چیدمان.سرریز‌پیدا، چیدمان.سرریز‌پنهان، چیدمان.سرریز‌پیمایش، چیدمان.سرریز‌خودکار

    ناپایا p := چیدمان.درخت تازه()
    para := p.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، تراز متن = چیدمان.متن‌وسط، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.به اندازه محتوا() })
    ناپایا words := وکتور {} برگردان وکتور<صحیح>
    تکرار 4:
        id := p.افزودن(para، چیدمان.سبک چیدمان { فاصله بیرونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(2.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(2.0)) })
        p.تنظیم سنجش(id، (_id: صحیح، _w: اعشار۶۴، _h: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 30.0، بلندی = 12.0، خط پایه = 9.0 } پایان)
        words.افزودن(id)
    پایان
    p.چیدن(300.0، 300.0)
    هر i، id در words:
        show(p، "word" + i، id)
    پایان
    سرچاپ "paragraph baseline"، p.خط پایه(para)
    سرچاپ "text aligns"، چیدمان.متن‌از‌آغاز، چیدمان.متن‌وسط، چیدمان.متن‌از‌انتها، چیدمان.متن‌تمام‌چین، چیدمان.متن‌چپ، چیدمان.متن‌راست
پایان
