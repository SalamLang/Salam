// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(موقت &: چیدمان.درخت چیدمان، name: رشته، شناسه: صحیح):
    سرچاپ name، موقت.ایکس(شناسه)، موقت.ایگرگ(شناسه)، موقت.پهنا(شناسه)، موقت.بلندی(شناسه)
پایان

تابع ریشه:
    ناپایا موقت := چیدمان.درخت تازه()
    صفحه_مقدار := موقت.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌پشته‌ای، سرریز افقی = چیدمان.سرریز‌پنهان، سرریز عمودی = چیدمان.سرریز‌پیمایش })
    محتوا := موقت.افزودن(صفحه_مقدار، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(900.0)، پهنا = چیدمان.پرکننده() })
    ناپایا متغیر_top := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌چسبان، بلندی = چیدمان.پیکسلی(40.0) }
    متغیر_top.فاصله جایگاه.بالا = چیدمان.پیکسلی(0.0)
    متغیر_bar := موقت.افزودن(محتوا، متغیر_top)
    ناپایا متغیر_corner := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌مطلق، پهنا = چیدمان.پیکسلی(50.0)، بلندی = چیدمان.پیکسلی(20.0)، لایه = 1 }
    متغیر_corner.فاصله جایگاه.انتها = چیدمان.پیکسلی(10.0)
    متغیر_corner.فاصله جایگاه.بالا = چیدمان.پیکسلی(10.0)
    متغیر_badge := موقت.افزودن(محتوا، متغیر_corner)
    ناپایا متغیر_fab := چیدمان.سبک چیدمان { جایگاه = چیدمان.جایگاه‌ثابت، پهنا = چیدمان.پیکسلی(48.0)، بلندی = چیدمان.پیکسلی(48.0)، لایه = 2 }
    متغیر_fab.فاصله جایگاه.راست = چیدمان.پیکسلی(16.0)
    متغیر_fab.فاصله جایگاه.پایین = چیدمان.پیکسلی(16.0)
    متغیر_button := موقت.افزودن(محتوا، متغیر_fab)
    موقت.چیدن(300.0، 400.0)
    سرچاپ "content size"، موقت.پهنای محتوا(صفحه_مقدار)، موقت.بلندی محتوا(صفحه_مقدار)
    موقت.تنظیم پیمایش(صفحه_مقدار، 0.0، 120.0)
    سرچاپ "scroll"، موقت.پیمایش افقی(صفحه_مقدار)، موقت.پیمایش عمودی(صفحه_مقدار)
    show(موقت، "bar"، متغیر_bar)
    show(موقت، "badge"، متغیر_badge)
    show(موقت، "button"، متغیر_button)
    سرچاپ "button on screen"، موقت.ایکس مطلق(متغیر_button)، موقت.ایگرگ مطلق(متغیر_button)
    چاپ "paint order"
    متغیر_order := موقت.ترتیب نقاشی(محتوا)
    هر شناسه در متغیر_order:
        چاپ " "، شناسه، "layer"، موقت.لایه(شناسه)
    پایان
    سرچاپ ""
    متغیر_order.آزادکن()
    سرچاپ "positions"، چیدمان.جایگاه‌عادی، چیدمان.جایگاه‌مطلق، چیدمان.جایگاه‌ثابت، چیدمان.جایگاه‌چسبان
    سرچاپ "overflow"، چیدمان.سرریز‌پیدا، چیدمان.سرریز‌پنهان، چیدمان.سرریز‌پیمایش، چیدمان.سرریز‌خودکار

    ناپایا ویژگی_محلی := چیدمان.درخت تازه()
    متغیر_para := ویژگی_محلی.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌جریانی، تراز متن = چیدمان.متن‌وسط، پهنا = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.به اندازه محتوا() })
    ناپایا واژه‌ها := وکتور {} برگردان وکتور<صحیح>
    تکرار 4:
        شناسه := ویژگی_محلی.افزودن(متغیر_para، چیدمان.سبک چیدمان { فاصله بیرونی = چیدمان.چهار لبه(چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(2.0)، چیدمان.پیکسلی(0.0)، چیدمان.پیکسلی(2.0)) })
        ویژگی_محلی.تنظیم سنجش(شناسه، (_id: صحیح، _w: اعشار۶۴، _h: اعشار۶۴): برگشت چیدمان.ابعاد { پهنا = 30.0، بلندی = 12.0، خط پایه = 9.0 } پایان)
        واژه‌ها.افزودن(شناسه)
    پایان
    ویژگی_محلی.چیدن(300.0، 300.0)
    هر i، شناسه در واژه‌ها:
        show(ویژگی_محلی، "word" + i، شناسه)
    پایان
    سرچاپ "paragraph baseline"، ویژگی_محلی.خط پایه(متغیر_para)
    سرچاپ "text aligns"، چیدمان.متن‌از‌آغاز، چیدمان.متن‌وسط، چیدمان.متن‌از‌انتها، چیدمان.متن‌تمام‌چین، چیدمان.متن‌چپ، چیدمان.متن‌راست
پایان
