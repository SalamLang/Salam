// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(موقت &: چیدمان.درخت چیدمان، name: رشته، id: صحیح):
    سرچاپ name، موقت.ایکس(id)، موقت.ایگرگ(id)، موقت.پهنا(id)، موقت.بلندی(id)
پایان

تابع ریشه:
    ناپایا موقت := چیدمان.درخت تازه()
    متغیر_bar := موقت.افزودن(-1، چیدمان.سبک چیدمان {
        چینش = چیدمان.چینش‌سطری،
        فاصله ستون‌ها = چیدمان.پیکسلی(8.0)،
        فاصله سطرها = چیدمان.پیکسلی(4.0)،
        تراز = چیدمان.تراز‌وسط،
        پخش = چیدمان.تراز‌آغاز،
        تراز محتوا = چیدمان.تراز‌آغاز،
        شکستن = نادرست،
        برعکس = نادرست،
        فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(6.0))،
        پهنای مرز = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(1.0))،
        بلندی = چیدمان.پیکسلی(48.0)،
        جهت = چیدمان.جهت‌چپ‌به‌راست
    })
    متغیر_logo := موقت.افزودن(متغیر_bar، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(32.0)، نسبت ابعاد = 1.0 })
    متغیر_title := موقت.افزودن(متغیر_bar، چیدمان.سبک چیدمان { رشد = 1.0، کاهش = 1.0، پایه = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(20.0)، کمینه پهنا = چیدمان.پیکسلی(60.0)، بیشینه پهنا = چیدمان.پیکسلی(400.0) })
    متغیر_search := موقت.افزودن(متغیر_bar، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(120.0)، کمینه بلندی = چیدمان.پیکسلی(24.0)، بیشینه بلندی = چیدمان.بی‌حد()، تراز اختصاصی = چیدمان.تراز‌کشیده })
    متغیر_menu := موقت.افزودن(متغیر_bar، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(24.0)، بلندی = چیدمان.پیکسلی(24.0)، ترتیب = -1 })
    متغیر_hidden := موقت.افزودن(متغیر_bar، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(50.0)، پیدا = نادرست })
    موقت.چیدن(400.0، 300.0)
    show(موقت، "bar"، متغیر_bar)
    show(موقت، "logo"، متغیر_logo)
    show(موقت، "title"، متغیر_title)
    show(موقت، "search"، متغیر_search)
    show(موقت، "menu"، متغیر_menu)
    show(موقت، "hidden"، متغیر_hidden)

    سرچاپ "layouts"، چیدمان.چینش‌ستونی، چیدمان.چینش‌سطری، چیدمان.چینش‌شبکه‌ای، چیدمان.چینش‌پشته‌ای، چیدمان.چینش‌جریانی
    سرچاپ "aligns"، چیدمان.تراز‌خودکار، چیدمان.تراز‌آغاز، چیدمان.تراز‌وسط، چیدمان.تراز‌انتها، چیدمان.تراز‌کشیده، چیدمان.تراز‌خط‌پایه، چیدمان.تراز‌فاصله‌میانی، چیدمان.تراز‌فاصله‌پیرامون، چیدمان.تراز‌فاصله‌یکسان
    سرچاپ "directions"، چیدمان.جهت‌موروثی، چیدمان.جهت‌چپ‌به‌راست، چیدمان.جهت‌راست‌به‌چپ

    ناپایا نویسنده := چیدمان.درخت تازه()
    فهرست := نویسنده.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، شکستن = درست، فاصله ستون‌ها = چیدمان.پیکسلی(10.0)، فاصله سطرها = چیدمان.پیکسلی(10.0)، پخش = چیدمان.تراز‌فاصله‌میانی، تراز محتوا = چیدمان.تراز‌انتها، بلندی = چیدمان.پیکسلی(150.0)، جهت = چیدمان.جهت‌راست‌به‌چپ })
    ناپایا متغیر_cards := وکتور {} برگردان وکتور<صحیح>
    تکرار 5:
        متغیر_cards.افزودن(نویسنده.افزودن(فهرست، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(70.0)، بلندی = چیدمان.پیکسلی(40.0) }))
    پایان
    نویسنده.چیدن(250.0، 300.0)
    هر i، c در متغیر_cards:
        show(نویسنده، "card" + i، c)
    پایان
پایان
