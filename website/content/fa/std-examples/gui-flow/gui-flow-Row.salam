// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع show(t &: چیدمان.درخت چیدمان، name: رشته، id: صحیح):
    سرچاپ name، t.ایکس(id)، t.ایگرگ(id)، t.پهنا(id)، t.بلندی(id)
پایان

تابع ریشه:
    ناپایا t := چیدمان.درخت تازه()
    bar := t.افزودن(-1، چیدمان.سبک چیدمان {
        چینش = چیدمان.چینش‌سطری،
        فاصله ستون‌ها = چیدمان.پیکسلی(8.0)،
        فاصله سطرها = چیدمان.پیکسلی(4.0)،
        تراز = چیدمان.تراز‌وسط،
        پخش = چیدمان.تراز‌آغاز،
        تراز محتوا = چیدمان.تراز‌آغاز،
        شکستن = نادرست،
        برعکس = نادرست،
        فاصله درونی = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(6.0))،
        پهنای مرز = چیدمان.همه لبه‌ها(چیدمان.پیکسلی(1.0))،
        بلندی = چیدمان.پیکسلی(48.0)،
        جهت = چیدمان.جهت‌چپ‌به‌راست
    })
    logo := t.افزودن(bar، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(32.0)، نسبت ابعاد = 1.0 })
    title := t.افزودن(bar، چیدمان.سبک چیدمان { رشد = 1.0، کاهش = 1.0، پایه = چیدمان.پیکسلی(100.0)، بلندی = چیدمان.پیکسلی(20.0)، کمینه پهنا = چیدمان.پیکسلی(60.0)، بیشینه پهنا = چیدمان.پیکسلی(400.0) })
    search := t.افزودن(bar، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(120.0)، کمینه بلندی = چیدمان.پیکسلی(24.0)، بیشینه بلندی = چیدمان.بی‌حد()، تراز اختصاصی = چیدمان.تراز‌کشیده })
    menu := t.افزودن(bar، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(24.0)، بلندی = چیدمان.پیکسلی(24.0)، ترتیب = -1 })
    hidden := t.افزودن(bar، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(50.0)، پیدا = نادرست })
    t.چیدن(400.0، 300.0)
    show(t، "bar"، bar)
    show(t، "logo"، logo)
    show(t، "title"، title)
    show(t، "search"، search)
    show(t، "menu"، menu)
    show(t، "hidden"، hidden)

    سرچاپ "layouts"، چیدمان.چینش‌ستونی، چیدمان.چینش‌سطری، چیدمان.چینش‌شبکه‌ای، چیدمان.چینش‌پشته‌ای، چیدمان.چینش‌جریانی
    سرچاپ "aligns"، چیدمان.تراز‌خودکار، چیدمان.تراز‌آغاز، چیدمان.تراز‌وسط، چیدمان.تراز‌انتها، چیدمان.تراز‌کشیده، چیدمان.تراز‌خط‌پایه، چیدمان.تراز‌فاصله‌میانی، چیدمان.تراز‌فاصله‌پیرامون، چیدمان.تراز‌فاصله‌یکسان
    سرچاپ "directions"، چیدمان.جهت‌موروثی، چیدمان.جهت‌چپ‌به‌راست، چیدمان.جهت‌راست‌به‌چپ

    ناپایا w := چیدمان.درخت تازه()
    list := w.افزودن(-1، چیدمان.سبک چیدمان { چینش = چیدمان.چینش‌سطری، شکستن = درست، فاصله ستون‌ها = چیدمان.پیکسلی(10.0)، فاصله سطرها = چیدمان.پیکسلی(10.0)، پخش = چیدمان.تراز‌فاصله‌میانی، تراز محتوا = چیدمان.تراز‌انتها، بلندی = چیدمان.پیکسلی(150.0)، جهت = چیدمان.جهت‌راست‌به‌چپ })
    ناپایا cards := وکتور {} برگردان وکتور<صحیح>
    تکرار 5:
        cards.افزودن(w.افزودن(list، چیدمان.سبک چیدمان { پهنا = چیدمان.پیکسلی(70.0)، بلندی = چیدمان.پیکسلی(40.0) }))
    پایان
    w.چیدن(250.0، 300.0)
    هر i، c در cards:
        show(w، "card" + i، c)
    پایان
پایان
