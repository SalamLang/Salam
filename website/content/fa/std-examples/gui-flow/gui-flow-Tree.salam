// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع ریشه:
    ناپایا موقت := چیدمان.درخت تازه()
    متغیر_root := موقت.افزودن(-1، چیدمان.سبک چیدمان { فاصله سطرها = چیدمان.پیکسلی(4.0) })
    الف := موقت.افزودن(متغیر_root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(20.0) })
    بافر_محلی := موقت.افزودن(متغیر_root، چیدمان.سبک چیدمان {})
    موقت.تنظیم سنجش(بافر_محلی، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴):
        ناپایا خط‌ها := 1.0
        اگر w بزرگتربرابر 0.0 و w کوچکتر 200.0:
            خط‌ها = 2.0
        پایان
        برگشت چیدمان.ابعاد { پهنا = 200.0، بلندی = خط‌ها * 16.0، خط پایه = 12.0 }
    پایان)
    موقت.چیدن(300.0، 200.0)
    سرچاپ "valid"، موقت.معتبر(بافر_محلی)، موقت.معتبر(42)، "count"، موقت.شمار گره‌ها()
    سرچاپ "parent"، موقت.والد(بافر_محلی)، "children"، موقت.شمار فرزندان(متغیر_root)، "second"، موقت.فرزند(متغیر_root، 1)
    سرچاپ "b"، موقت.ایکس(بافر_محلی)، موقت.ایگرگ(بافر_محلی)، موقت.پهنا(بافر_محلی)، موقت.بلندی(بافر_محلی)، "baseline"، موقت.خط پایه(بافر_محلی)
    سرچاپ "calls"، موقت.شمار چیدن‌ها()، موقت.شمار سنجش‌ها()
    موقت.صفر کردن شمارنده‌ها()
    موقت.چیدن(300.0، 200.0)
    سرچاپ "again"، موقت.شمار چیدن‌ها()، موقت.شمار سنجش‌ها()، "dirty"، موقت.تغییر کرده(متغیر_root)

    ناپایا سبک_متن := موقت.سبک(الف)
    سبک_متن.بلندی = چیدمان.پیکسلی(30.0)
    موقت.تنظیم سبک(الف، سبک_متن)
    سرچاپ "after SetStyle dirty"، موقت.تغییر کرده(الف)، موقت.تغییر کرده(متغیر_root)، موقت.تغییر کرده(بافر_محلی)
    موقت.چیدن(300.0، 200.0)
    سرچاپ "b moved to"، موقت.ایگرگ(بافر_محلی)، "calls"، موقت.شمار چیدن‌ها()

    موقت.علامت تغییر(بافر_محلی)
    موقت.چیدن(150.0، 200.0)
    سرچاپ "narrow b"، موقت.پهنا(بافر_محلی)، موقت.بلندی(بافر_محلی)
    موقت.حذف سنجش(بافر_محلی)
    موقت.جابجایی(بافر_محلی، متغیر_root، 0)
    موقت.چیدن(150.0، 200.0)
    سرچاپ "b first"، موقت.فرزند(متغیر_root، 0)، موقت.ایگرگ(الف)، موقت.بلندی(بافر_محلی)
    موقت.حذف(الف)
    سرچاپ "removed"، موقت.معتبر(الف)، موقت.شمار فرزندان(متغیر_root)
    موقت.آزادسازی()
    سرچاپ "freed"، موقت.شمار گره‌ها()
پایان
