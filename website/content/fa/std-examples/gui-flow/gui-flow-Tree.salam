// زبان: فارسی
واردسازی رابط گرافیکی.چیدمان

تابع ریشه:
    ناپایا t := چیدمان.درخت تازه()
    root := t.افزودن(-1، چیدمان.سبک چیدمان { فاصله سطرها = چیدمان.پیکسلی(4.0) })
    a := t.افزودن(root، چیدمان.سبک چیدمان { بلندی = چیدمان.پیکسلی(20.0) })
    b := t.افزودن(root، چیدمان.سبک چیدمان {})
    t.تنظیم سنجش(b، (_id: صحیح، w: اعشار۶۴، _h: اعشار۶۴):
        ناپایا lines := 1.0
        اگر w بزرگتربرابر 0.0 و w کوچکتر 200.0:
            lines = 2.0
        پایان
        برگشت چیدمان.ابعاد { پهنا = 200.0، بلندی = lines * 16.0، خط پایه = 12.0 }
    پایان)
    t.چیدن(300.0، 200.0)
    سرچاپ "valid"، t.معتبر(b)، t.معتبر(42)، "count"، t.شمار گره‌ها()
    سرچاپ "parent"، t.والد(b)، "children"، t.شمار فرزندان(root)، "second"، t.فرزند(root، 1)
    سرچاپ "b"، t.ایکس(b)، t.ایگرگ(b)، t.پهنا(b)، t.بلندی(b)، "baseline"، t.خط پایه(b)
    سرچاپ "calls"، t.شمار چیدن‌ها()، t.شمار سنجش‌ها()
    t.صفر کردن شمارنده‌ها()
    t.چیدن(300.0، 200.0)
    سرچاپ "again"، t.شمار چیدن‌ها()، t.شمار سنجش‌ها()، "dirty"، t.تغییر کرده(root)

    ناپایا st := t.سبک(a)
    st.بلندی = چیدمان.پیکسلی(30.0)
    t.تنظیم سبک(a، st)
    سرچاپ "after SetStyle dirty"، t.تغییر کرده(a)، t.تغییر کرده(root)، t.تغییر کرده(b)
    t.چیدن(300.0، 200.0)
    سرچاپ "b moved to"، t.ایگرگ(b)، "calls"، t.شمار چیدن‌ها()

    t.علامت تغییر(b)
    t.چیدن(150.0، 200.0)
    سرچاپ "narrow b"، t.پهنا(b)، t.بلندی(b)
    t.حذف سنجش(b)
    t.جابجایی(b، root، 0)
    t.چیدن(150.0، 200.0)
    سرچاپ "b first"، t.فرزند(root، 0)، t.ایگرگ(a)، t.بلندی(b)
    t.حذف(a)
    سرچاپ "removed"، t.معتبر(a)، t.شمار فرزندان(root)
پایان
