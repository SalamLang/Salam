// زبان: فارسی
واردسازی رابط گرافیکی.نقاشی

تابع ریشه:
    ناپایا بوم۱ := نقاشی.بوم تازه(۱۲۰، ۸۰)
    بوم۱.پاک کردن(نقاشی.رنگ از سه مولفه(۲۴۵، ۲۴۶، ۲۵۰))
    کارت := نقاشی.مستطیل از(۲۰.۰، ۱۵.۰، ۸۰.۰، ۵۰.۰)
    شعاع ها := نقاشی.شعاع یکسان(۱۰.۰)
    بوم۱.رسم سایه(کارت، شعاع ها، نقاشی.سایه { جابجایی ایگرگ = ۳.۰، تاری = ۸.۰، رنگ = نقاشی.رنگ از چهار مولفه(۰، ۰، ۰، ۹۰) })
    بوم۱.پرکردن مستطیل گرد(کارت، شعاع ها، نقاشی.رنگ از سه مولفه(۲۵۵، ۲۵۵، ۲۵۵))
    ناپایا کادر۱ := نقاشی.کادر توپر(۲.۰، نقاشی.رنگ از سه مولفه(۶۰، ۱۱۰، ۲۲۰))
    کادر۱.پهنای چپ = ۶.۰
    کادر۱.رنگ چپ = نقاشی.رنگ از سه مولفه(۲۳۰، ۸۰، ۴۰)
    بوم۱.رسم کادر(کارت، شعاع ها، کادر۱)
    بوم۱.رسم دورخط(کارت، شعاع ها، ۱.۰، ۳.۰، نقاشی.رنگ از چهار مولفه(۶۰، ۱۱۰، ۲۲۰، ۱۲۰))
    رنگ۱ := بوم۱.پیکسل(۶۰، ۴۰)
    سرچاپ "درون:"، رنگ۱.قرمز، رنگ۱.سبز، رنگ۱.آبی
    رنگ۲ := بوم۱.پیکسل(۲۲، ۴۰)
    سرچاپ "کادر چپ:"، رنگ۲.قرمز، رنگ۲.سبز، رنگ۲.آبی
    سرچاپ "چکیده:"، بوم۱.چکیده()
    بوم۱.رهاسازی()
پایان
