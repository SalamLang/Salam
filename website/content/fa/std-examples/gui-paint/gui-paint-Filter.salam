// زبان: فارسی
واردسازی رابط گرافیکی.نقاشی

تابع ریشه:
    ناپایا بوم۱ := نقاشی.بوم تازه(۱۲۰، ۶۰)
    بوم۱.پاک کردن(نقاشی.رنگ از سه مولفه(۲۵۵، ۲۵۵، ۲۵۵))
    تکرار ۶ در ای:
        بوم۱.پرکردن مستطیل(نقاشی.مستطیل از((ای * ۲۰) برگردان اعشار۶۴، ۰.۰، ۱۰.۰، ۶۰.۰)، نقاشی.رنگ از سه مولفه(۳۰، ۳۰، ۳۰))
    پایان
    ناپایا شیشه := نقاشی.زنجیره‌پالایه {}
    شیشه.افزودن پالایه(نقاشی.پالایه تازه(نقاشی.نوع‌پالایه.تار کردن، ۳.۰))
    شیشه.افزودن پالایه(نقاشی.پالایه تازه(نقاشی.نوع‌پالایه.روشنایی، ۱.۳))
    بوم۱.پالایه پس زمینه(نقاشی.مستطیل از(۴.۰، ۴.۰، ۵۰.۰، ۳۰.۰)، نقاشی.شعاع یکسان(۶.۰)، شیشه)
    شیشه.رهاسازی()
    ناپایا نما := نقاشی.زنجیره‌پالایه {}
    نما.افزودن پالایه(نقاشی.پالایه تازه(نقاشی.نوع‌پالایه.قهوه ای کهنه، ۱.۰))
    نما.افزودن پالایه(نقاشی.پالایه سایه افتاده(۳.۰، ۳.۰، ۲.۰، نقاشی.رنگ از چهار مولفه(۰، ۰، ۰، ۱۶۰)))
    سرچاپ "فضای دور لایه:"، نما.گستره پالایه()، "خالی:"، نما.خالی است()
    کاشی := نقاشی.مستطیل از(۷۰.۰، ۱۰.۰، ۳۰.۰، ۳۰.۰)
    بوم۱.آغاز لایه پالایه(کاشی، نما)
    بوم۱.پرکردن مستطیل گرد(کاشی، نقاشی.شعاع یکسان(۶.۰)، نقاشی.رنگ از سه مولفه(۴۰، ۱۲۰، ۲۲۰))
    بوم۱.ادغام لایه با پالایه(نما، ۱.۰)
    نما.رهاسازی()
    سرچاپ "شیشه‌ی مات خاکستری است:"، بوم۱.پیکسل(۱۴، ۲۰).قرمز > ۶۰
    سرچاپ "کاشی قهوه‌ای کهنه:"، بوم۱.پیکسل(۸۵، ۲۵).قرمز > بوم۱.پیکسل(۸۵، ۲۵).آبی
    سرچاپ "چکیده:"، بوم۱.چکیده()
    بوم۱.رهاسازی()
پایان
