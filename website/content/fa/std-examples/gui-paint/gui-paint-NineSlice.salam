// زبان: فارسی
واردسازی رابط گرافیکی.نقاشی

تابع ریشه:
    ناپایا قاب := نقاشی.بوم تازه(۳۰، ۳۰)
    قاب.پاک کردن(نقاشی.رنگ از سه مولفه(۴۰، ۹۰، ۲۰۰))
    قاب.پرکردن مستطیل(نقاشی.مستطیل از(۱۰.۰، ۱۰.۰، ۱۰.۰، ۱۰.۰)، نقاشی.رنگ از سه مولفه(۲۴۰، ۲۴۰، ۲۴۰))
    قاب.پرکردن مستطیل(نقاشی.مستطیل از(۰.۰، ۰.۰، ۱۰.۰، ۱۰.۰)، نقاشی.رنگ از سه مولفه(۲۲۰، ۵۰، ۵۰))
    ناپایا برش‌ها := نقاشی.نه‌برش { برش بالایی = ۱۰.۰، برش راستی = ۱۰.۰، برش پایینی = ۱۰.۰، برش چپی = ۱۰.۰ }
    برش‌ها.پهنای بالایی = ۶.۰
    برش‌ها.پهنای راستی = ۶.۰
    برش‌ها.پهنای پایینی = ۶.۰
    برش‌ها.پهنای چپی = ۶.۰
    برش‌ها.تکرار افقی = نقاشی.تکرارتصویر.گردشده
    برش‌ها.تکرار عمودی = نقاشی.تکرارتصویر.کشیده
    برش‌ها.پرکردن وسط = درست
    ناپایا بوم۱ := نقاشی.بوم تازه(۱۰۰، ۶۰)
    بوم۱.پاک کردن(نقاشی.رنگ از سه مولفه(۲۵۵، ۲۵۵، ۲۵۵))
    بوم۱.رسم نه برش(قاب، نقاشی.مستطیل از(۴.۰، ۴.۰، ۹۲.۰، ۵۲.۰)، برش‌ها، ۱.۰)
    گوشه := بوم۱.پیکسل(۶، ۶)
    سرچاپ "گوشه:"، گوشه.قرمز، گوشه.سبز، گوشه.آبی
    میانه := بوم۱.پیکسل(۵۰، ۳۰)
    سرچاپ "میانه:"، میانه.قرمز، میانه.سبز، میانه.آبی
    سرچاپ "چکیده:"، بوم۱.چکیده()
    بوم۱.رهاسازی()
    قاب.رهاسازی()
پایان
