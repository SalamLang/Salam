// زبان: فارسی
واردسازی رابط گرافیکی.نقاشی

تابع ریشه:
    ناپایا بوم۱ := نقاشی.بوم تازه(۱۲۰، ۸۰)
    بوم۱.پاک کردن(نقاشی.رنگ از سه مولفه(۲۵۵، ۲۵۵، ۲۵۵))
    چرخش := نقاشی.تبدیل جابجایی(-۳۰.۰، -۲۰.۰).سپس(نقاشی.تبدیل چرخش(۲۰.۰)).سپس(نقاشی.تبدیل کجی(۱۰.۰، ۰.۰)).سپس(نقاشی.تبدیل جابجایی(۴۵.۰، ۴۰.۰))
    بوم۱.افزودن تبدیل(چرخش)
    کارت := نقاشی.مستطیل از(۰.۰، ۰.۰، ۶۰.۰، ۴۰.۰)
    بوم۱.رسم سایه(کارت، نقاشی.شعاع یکسان(۸.۰)، نقاشی.سایه { جابجایی ایگرگ = ۳.۰، تاری = ۶.۰، رنگ = نقاشی.رنگ از چهار مولفه(۰، ۰، ۰، ۹۰) })
    بوم۱.پرکردن مستطیل گرد(کارت، نقاشی.شعاع یکسان(۸.۰)، نقاشی.رنگ از سه مولفه(۲۵۰، ۲۴۰، ۲۰۰))
    ناپایا کادر := نقاشی.کادر توپر(۳.۰، نقاشی.رنگ از سه مولفه(۲۰۰، ۶۰، ۰))
    کادر.سبک بالا = نقاشی.سبک‌کادر.خط‌چین
    کادر.سبک پایین = نقاشی.سبک‌کادر.نقطه‌چین
    بوم۱.رسم کادر(کارت، نقاشی.شعاع یکسان(۸.۰)، کادر)
    بوم۱.افزودن برش گرد(نقاشی.مستطیل از(۱۰.۰، ۱۰.۰، ۴۰.۰، ۲۰.۰)، نقاشی.شعاع یکسان(۶.۰))
    بوم۱.پرکردن مستطیل(نقاشی.مستطیل از(۰.۰، ۰.۰، ۶۰.۰، ۴۰.۰)، نقاشی.رنگ از چهار مولفه(۰، ۹۰، ۲۰۰، ۱۲۰))
    بوم۱.برداشتن برش()
    بوم۱.برداشتن تبدیل()
    بوم۱.رسم دورخط با سبک(نقاشی.مستطیل از(۹۰.۰، ۲۰.۰، ۲۰.۰، ۴۰.۰)، نقاشی.شعاع یکسان(۴.۰)، ۲.۰، ۳.۰، نقاشی.رنگ از سه مولفه(۰، ۰، ۰)، نقاشی.سبک‌کادر.نقطه‌چین)
    گوشه := چرخش.اعمال روی نقطه(نقاشی.نقطه { ایکس = ۰.۰، ایگرگ = ۰.۰ })
    بازگشته := چرخش.وارون تبدیل().اعمال روی نقطه(گوشه)
    جعبه := چرخش.نگاشت مستطیل(کارت)
    سرچاپ "گوشه‌ی کارت روی صفحه:"، گوشه.ایکس > ۱۰.۰، گوشه.ایگرگ < ۲۰.۰
    سرچاپ "بازگشت به کارت:"، بازگشته.ایکس > -۰.۰۰۱ و بازگشته.ایکس < ۰.۰۰۱
    سرچاپ "جعبه‌ی روی صفحه پهن‌تر از کارت است:"، جعبه.پهنا > ۶۰.۰
    سرچاپ "همانی:"، نقاشی.تبدیل همانی().همانی است()، چرخش.همانی است()
    سرچاپ "چکیده:"، بوم۱.چکیده()
    بوم۱.رهاسازی()
پایان
