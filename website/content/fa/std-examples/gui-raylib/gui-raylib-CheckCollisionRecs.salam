// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(400، 300، "Collision")
    الف := ریلیب.ساخت مستطیل(50.0، 50.0، 100.0، 100.0)
    تا وارونه ریلیب.پنجره باید بسته شود():
        نشانگر := ریلیب.مکان ماوس()
        بافر_محلی := ریلیب.ساخت مستطیل(نشانگر.ایکس برگردان اعشار۶۴، نشانگر.وای برگردان اعشار۶۴، 60.0، 60.0)
        برخورد := ریلیب.برخورد مستطیل‌ها(الف، بافر_محلی)
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم مستطیل رکوردی(الف، برخورد ? ریلیب.قرمز() : ریلیب.سبز())
        ریلیب.رسم مستطیل رکوردی(بافر_محلی، ریلیب.کم‌رنگ کردن(ریلیب.آبی()، 0.5))
        ریلیب.پایان رسم()
    پایان
    ریلیب.بستن پنجره()
پایان
