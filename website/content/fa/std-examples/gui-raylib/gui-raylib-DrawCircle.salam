// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(400، 300، "Circles")
    تا وارونه ریلیب.پنجره باید بسته شود():
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم دایره(200، 150، 80.0، ریلیب.آبی آسمانی())
        ریلیب.رسم خطوط دایره(200، 150، 80.0، ریلیب.آبی تیره())
        ریلیب.پایان رسم()
    پایان
    ریلیب.بستن پنجره()
پایان
