// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(640، 360، "Hello Salam")
    ریلیب.تنظیم نرخ فریم هدف(60)
    تا وارونه ریلیب.پنجره باید بسته شود():
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم متن("Hello from Salam"، 190، 170، 30، ریلیب.خاکستری تیره())
        ریلیب.پایان رسم()
    پایان
    ریلیب.بستن پنجره()
پایان
