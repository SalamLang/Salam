// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(400، 300، "Keys")
    ناپایا ایکس := 200
    تا وارونه ریلیب.پنجره باید بسته شود():
        اگر ریلیب.کلید پایین است(ریلیب.کلید راست): ایکس += 3 پایان
        اگر ریلیب.کلید پایین است(ریلیب.کلید چپ): ایکس -= 3 پایان
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم دایره(ایکس، 150، 20.0، ریلیب.عنابی())
        ریلیب.پایان رسم()
    پایان
    ریلیب.بستن پنجره()
پایان
