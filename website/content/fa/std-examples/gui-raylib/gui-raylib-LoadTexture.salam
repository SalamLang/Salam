// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(400، 300، "Texture")
    متغیر_tex := ریلیب.بارگذاری بافت("logo.png")
    تا وارونه ریلیب.پنجره باید بسته شود():
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم بافت(متغیر_tex، 100، 50، ریلیب.سفید())
        ریلیب.پایان رسم()
    پایان
    ریلیب.آزادسازی بافت(متغیر_tex)
    ریلیب.بستن پنجره()
پایان
