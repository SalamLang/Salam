// زبان: فارسی
واردسازی رابط گرافیکی.ریلیب

تابع ریشه:
    ریلیب.ایجاد پنجره(400، 300، "Sound")
    ریلیب.راه‌اندازی دستگاه صدا()
    متغیر_beep := ریلیب.بارگذاری صدا("beep.wav")
    تا وارونه ریلیب.پنجره باید بسته شود():
        اگر ریلیب.کلید فشرده شد(ریلیب.کلید فاصله):
            ریلیب.پخش صدا(متغیر_beep)
        پایان
        ریلیب.شروع رسم()
        ریلیب.پاک کردن پس‌زمینه(ریلیب.سفید ری())
        ریلیب.رسم متن("Press space"، 130، 140، 24، ریلیب.خاکستری تیره())
        ریلیب.پایان رسم()
    پایان
    ریلیب.آزادسازی صدا(متغیر_beep)
    ریلیب.بستن دستگاه صدا()
    ریلیب.بستن پنجره()
پایان
