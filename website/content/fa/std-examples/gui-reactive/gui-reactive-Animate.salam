واردسازی تبدیل
واردسازی رابط گرافیکی.واکنشی

تابع ریشه:
    واکنشی.تنظیم زمان(0 برگردان صحیح۶۴)
    left := واکنشی.اعشاری تازه(0.0)
    left.پویانمایی(واکنشی.پویانمایی‌ویژگی { مدت = 400، نرمش = واکنشی.نرمش خروج() })
    left.بنشان(200.0)
    سرچاپ "running"، واکنشی.پویانمایی جاری()، واکنشی.شمار پویانمایی ها()
    تا واکنشی.پویانمایی جاری():
        سرچاپ "t"، واکنشی.اکنون()، "left"، left.بخوان()
        واکنشی.جلو بردن زمان(100 برگردان صحیح۶۴)
    پایان
    سرچاپ "t"، واکنشی.اکنون()، "left"، left.بخوان()، "running"، واکنشی.پویانمایی جاری()

    واکنشی.تنظیم زمان(1000 برگردان صحیح۶۴)
    tint := واکنشی.صحیح تازه(0xFF000000 برگردان صحیح)
    tint.پویانمایی(واکنشی.پویانمایی‌ویژگی { مدت = 200، درنگ = 100، رنگی = درست })
    tint.بنشان(0xFFFFFFFF برگردان صحیح)
    تکرار 4 در i:
        واکنشی.تنظیم زمان(1000 برگردان صحیح۶۴ + (i * 100) برگردان صحیح۶۴)
        سرچاپ "tint"، تبدیل.قالب شانزده(((tint.بخوان() برگردان صحیح۶۴) & 0xFFFFFFFF) برگردان طبیعی۶۴)
    پایان
پایان
