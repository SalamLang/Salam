واردسازی رابط گرافیکی.واکنشی

تابع ریشه:
    width := واکنشی.صحیح تازه(3).نام بده("width")
    height := واکنشی.صحیح تازه(4).نام بده("height")
    area := واکنشی.صحیح تازه(0).نام بده("area")
    area.پیوند((): برگشت width.بخوان() * height.بخوان() پایان)
    سرچاپ "area"، area.بخوان()، "bound"، area.پیوند دارد()

    width.بنشان(10)
    سرچاپ "dirty after a set"، area.کهنه است()، "evaluations so far"، واکنشی.شمار ارزیابی()
    سرچاپ "area"، area.بخوان()، "evaluations so far"، واکنشی.شمار ارزیابی()
    سرچاپ "peek reads without tracking"، area.نگاه()

    marks := واکنشی.شمار نشانه گذاری()
    height.بنشان(5)
    height.بنشان(6)
    سرچاپ "dirty marks for two sets"، واکنشی.شمار نشانه گذاری() - marks

    area.بنشان(1)
    سرچاپ "a set replaces the binding"، area.پیوند دارد()، area.بخوان()
    سرچاپ "nodes"، واکنشی.گره های زنده()، "edges"، واکنشی.یال های زنده()

    width.آزاد کن()
    height.آزاد کن()
    area.آزاد کن()
    واکنشی.بازنشانی()
    سرچاپ "nodes after reset"، واکنشی.گره های زنده()
پایان
