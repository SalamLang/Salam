واردسازی رابط گرافیکی.واکنشی
واردسازی ریاضی

تابع r3(v: اعشار۶۴): اعشار۶۴:
    برگشت ریاضی.گردکردن(v * 1000.0) / 1000.0
پایان

تابع ریشه:
    هر e در [واکنشی.نرمش خطی()، واکنشی.نرمش عادی()، واکنشی.نرمش ورود()، واکنشی.نرمش خروج()، واکنشی.نرمش ورود خروج()]:
        سرچاپ r3(e.مقدار لحظه(0.25))، r3(e.مقدار لحظه(0.5))، r3(e.مقدار لحظه(0.75))
    پایان
    custom := واکنشی.نرمش بزیه(0.68، -0.6، 0.32، 1.6)
    سرچاپ "custom"، r3(custom.مقدار لحظه(0.25))، r3(custom.مقدار لحظه(0.75))
    s := واکنشی.نرمش پله ای(3، واکنشی.جای‌پله.پرش آغاز)
    سرچاپ "steps"، s.مقدار لحظه(0.0)، r3(s.مقدار لحظه(0.5))، s.مقدار لحظه(1.0)
    p := واکنشی.خواندن نرمش("cubic-bezier(0.1, 0.7, 1.0, 0.1)"، واکنشی.نرمش عادی())
    سرچاپ "parsed"، p.گونه برابر واکنشی.گونه‌نرمش.بزیه مکعبی، p.ایکس یک، p.ایگرگ یک، p.ایکس دو، p.ایگرگ دو
    q := واکنشی.خواندن نرمش("steps(5, jump-none)"، واکنشی.نرمش عادی())
    سرچاپ "parsed steps"، q.شمار پله، q.جای پرش برابر واکنشی.جای‌پله.بدون پرش
    bad := واکنشی.خواندن نرمش("bounce"، واکنشی.نرمش خطی())
    سرچاپ "fallback"، bad.گونه برابر واکنشی.گونه‌نرمش.خطی
پایان
