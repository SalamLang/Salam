واردسازی رابط گرافیکی.واکنشی

تابع ریشه:
    واکنشی.چاپ خطاها(نادرست)
    a := واکنشی.صحیح تازه(0).نام بده("min width")
    b := واکنشی.صحیح تازه(0).نام بده("preferred width")
    a.پیوند((): برگشت b.بخوان() + 1 پایان)
    b.پیوند((): برگشت a.بخوان() + 1 پایان)
    سرچاپ "value with the loop cut"، a.بخوان()
    سرچاپ "errors"، واکنشی.شمار خطاها()
    سرچاپ واکنشی.آخرین خطا()
پایان
