واردسازی رابط گرافیکی.واکنشی

تابع ریشه:
    model := واکنشی.متن تازه("hello")
    field := واکنشی.متن تازه("")
    واکنشی.همبند کن(model، field)
    سرچاپ model.بخوان()، field.بخوان()
    field.بنشان("typed in the field")
    سرچاپ model.بخوان()
    model.بنشان("set by the program")
    سرچاپ field.بخوان()

    volume := واکنشی.صحیح تازه(5)
    slider := واکنشی.صحیح تازه(0)
    knob := واکنشی.صحیح تازه(0)
    واکنشی.همبند کن(volume، slider)
    واکنشی.همبند کن(slider، knob)
    knob.بنشان(9)
    سرچاپ volume.بخوان()، slider.بخوان()، knob.بخوان()
    slider.جدا کن()
    slider.بنشان(1)
    سرچاپ volume.بخوان()، slider.بخوان()، knob.بخوان()
پایان
