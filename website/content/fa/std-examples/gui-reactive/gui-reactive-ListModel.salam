واردسازی رابط گرافیکی.واکنشی

ساختار Row:
    همگانی name: رشته = ""
    همگانی done: منطقی = نادرست
پایان

تابع ریشه:
    rows := واکنشی.مدل فهرست تازه() برگردان واکنشی.مدل‌فهرست<Row>
    _id := rows.گوش بده((ev: واکنشی.رویداد‌مدل): سرچاپ "  change"، ev.گونه برگردان صحیح، "index"، ev.شماره، "count"، ev.شمار پایان)
    status := واکنشی.متن تازه("")
    status.پیوند((): برگشت "" + rows.طول() + " rows" پایان)
    rows.بیفزا(Row { name = "milk" })
    rows.بیفزا(Row { name = "bread" })
    rows.درج کن(0، Row { name = "eggs" })
    سرچاپ status.بخوان()، rows.بخوان(0).name
    rows.بنشان(1، Row { name = "milk"، done = درست })
    rows.حذف کن(0، 1)
    سرچاپ status.بخوان()، rows.بخوان(0).done
    h := rows.هنگام تغییر((): سرچاپ "  rows changed" پایان)
    rows.پاک کن()
    سرچاپ "handlers"، واکنشی.اجرای کنترل‌کننده ها()، status.بخوان()
    ناپایا more := وکتور {} برگردان وکتور<Row>
    more.بیفزا(Row { name = "tea" })
    rows.جایگزین کن(more)
    more.آزادکن()
    rows.گوش نده(_id)
    rows.بیفزا(Row { name = "rice" })
    سرچاپ status.بخوان()، واکنشی.تغییر‌مدل.بازسازی کامل برگردان صحیح
    h.آزاد کن()
    rows.آزاد کن()
پایان
