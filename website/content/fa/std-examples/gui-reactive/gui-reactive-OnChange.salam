واردسازی رابط گرافیکی.واکنشی

تابع ریشه:
    count := واکنشی.صحیح تازه(0)
    title := واکنشی.متن تازه("")
    title.پیوند((): برگشت "Count: " + count.بخوان() پایان)
    h := واکنشی.هنگام تغییر(title، (): سرچاپ "  title changed to"، title.بخوان() پایان)
    count.بنشان(1)
    count.بنشان(2)
    count.بنشان(3)
    سرچاپ "pending"، واکنشی.کنترل‌کننده های منتظر()
    سرچاپ "handlers run"، واکنشی.اجرای کنترل‌کننده ها()
    count.بنشان(3)
    سرچاپ "same value"، واکنشی.اجرای کنترل‌کننده ها()
    h.آزاد کن()
    count.بنشان(4)
    سرچاپ "after Free"، واکنشی.اجرای کنترل‌کننده ها()
