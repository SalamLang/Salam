واردسازی رابط گرافیکی.واکنشی

ساختار Size:
    همگانی w: صحیح = 0
    همگانی h: صحیح = 0
پایان

تابع ریشه:
    window := واکنشی.ویژگی تازه(Size { w = 800، h = 600 }).نام بده("window size")
    pad := واکنشی.صحیح تازه(16)
    content := واکنشی.ویژگی تازه(Size {})
    content.پیوند(():
        s := window.بخوان()
        برگشت Size { w = s.w - 2 * pad.بخوان()، h = s.h - 2 * pad.بخوان() }
    پایان)
    سرچاپ content.بخوان()، content.پیوند دارد()
    h := content.هنگام تغییر((): سرچاپ "  content is now"، content.نگاه() پایان)
    window.بنشان(Size { w = 1024، h = 768 })
    سرچاپ "handlers"، واکنشی.اجرای کنترل‌کننده ها()
    h.آزاد کن()
    window.آزاد کن()
    content.آزاد کن()
پایان
