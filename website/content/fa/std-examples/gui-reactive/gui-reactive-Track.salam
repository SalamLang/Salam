واردسازی رابط گرافیکی.واکنشی

ناپایا redraws := 0

تابع ریشه:
    x := واکنشی.صحیح تازه(1)
    y := واکنشی.صحیح تازه(2)
    t := واکنشی.ردیابی((): سرچاپ "  paint at"، x.بخوان()، y.بخوان() پایان، (): redraws++ پایان).نام بده("paint")
    x.بنشان(10)
    y.بنشان(20)
    سرچاپ "dirty"، t.کهنه است()، "redraw requests"، redraws
    سرچاپ "refreshed"، t.تازه کن()
    سرچاپ "refresh with nothing new"، t.تازه کن()

    واکنشی.آغاز دسته()
    x.بنشان(3)
    سرچاپ "in batch"، واکنشی.داخل دسته()، "requests"، redraws
    y.بنشان(4)
    واکنشی.اتمام دسته()
    سرچاپ "after the batch"، redraws
    _r := t.تازه کن()

    واکنشی.دسته(():
        x.بنشان(5)
        y.بنشان(6)
    پایان)
    سرچاپ "after Batch"، redraws
    _r2 := t.تازه کن()
    t.آزاد کن()
پایان
