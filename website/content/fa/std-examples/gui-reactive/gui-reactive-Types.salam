واردسازی رابط گرافیکی.واکنشی
واردسازی رشته

تابع ریشه:
    bytes := واکنشی.صحیح۶۴ تازه(3000000000 برگردان صحیح۶۴)
    scale := واکنشی.اعشاری تازه(1.5)
    visible := واکنشی.منطقی تازه(درست)
    name := واکنشی.متن تازه("Sara")
    greeting := واکنشی.متن تازه("")
    greeting.پیوند((): برگشت "Hello, " + name.بخوان() + "!" پایان)
    shown := واکنشی.متن تازه("")
    shown.پیوند رونوشتی((): برگشت visible.بخوان() ? name.بخوان() : "hidden" پایان)
    سرچاپ greeting.بخوان()، shown.بخوان()
    name.بنشان("Reza")
    visible.بنشان(نادرست)
    سرچاپ greeting.بخوان()، shown.بخوان()
    سرچاپ bytes.بخوان()، scale.بخوان() * 2.0

    gap := واکنشی.صحیح ثابت(8)
    big := واکنشی.صحیح۶۴ ثابت(9000000000 برگردان صحیح۶۴)
    ratio := واکنشی.اعشاری ثابت(0.5)
    flag := واکنشی.منطقی ثابت(درست)
    label := واکنشی.متن ثابت("fixed")
    سرچاپ gap.بخوان()، big.بخوان()، ratio.بخوان()، flag.بخوان()، label.بخوان()، "node"، gap.گره، "fixed"، gap.مقدار ثابت

    kept := رشته.رونوشت(greeting.بخوان())
    name.بنشان("Mina")
    سرچاپ "copy kept"، kept، "now"، greeting.بخوان()
پایان
