واردسازی رابط گرافیکی.سبک

تابع show(prop: صحیح، text: رشته):
    ناپایا مقدار_محلی := سبک.مقدار {}
    سبک.تجزیه(prop، text، مقدار_محلی)
    سرچاپ سبک.نام ویژگی(prop)، "="، text
    سرچاپ "   "، سبک.سی اس اس(prop، مقدار_محلی)
پایان

تابع ریشه:
    show(سبک.ویژگی‌چیدمان، "row")
    show(سبک.ویژگی‌چیدمان، "stack")
    show(سبک.ویژگی‌عرض، "100% - 20")
    show(سبک.ویژگی‌فاصله، "8, 16, 4, 2")
    show(سبک.ویژگی‌نمایان، "false")
    show(سبک.ویژگی‌تاری، "4")
    show(سبک.ویژگی‌گذار، "200ms, ease out")
    متغیر_base := سبک.سی اس اس پایه()
    سرچاپ "base sheet:"، متغیر_base.طول() بزرگتر 1000، متغیر_base.زیررشته(0، 40)
پایان
