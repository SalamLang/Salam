واردسازی رابط گرافیکی.سبک

تابع ریشه:
    ناپایا الف := سبک.مقدار {}
    ناپایا بافر_محلی := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌عرض، "100%"، الف)
    سبک.تجزیه(سبک.ویژگی‌عرض، "100% - 40"، بافر_محلی)
    هر موقت در [0.0، 0.5، 1.0]:
        سرچاپ "width at"، موقت، "="، سبک.قالب(سبک.ویژگی‌عرض، سبک.میان یابی(سبک.ویژگی‌عرض، الف، بافر_محلی، موقت))
    پایان
    ناپایا نویسه := سبک.مقدار {}
    ناپایا دال := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌سایه، "none"، نویسه)
    سبک.تجزیه(سبک.ویژگی‌سایه، "0, 4, 8, black"، دال)
    سرچاپ "shadow half way:"، سبک.قالب(سبک.ویژگی‌سایه، سبک.میان یابی(سبک.ویژگی‌سایه، نویسه، دال، 0.5))
    متغیر_ease := سبک.نرمش { گونه = سبک.نرمش‌فنر، سختی = 170.0، میرایی = 26.0 }
    سرچاپ "spring at 0.5:"، (سبک.نرمش در(متغیر_ease، 0.5) * 1000.0) برگردان صحیح
پایان
