واردسازی رابط گرافیکی.سبک

تابع ریشه:
    ناپایا a := سبک.مقدار {}
    ناپایا b := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌عرض، "100%"، a)
    سبک.تجزیه(سبک.ویژگی‌عرض، "100% - 40"، b)
    هر t در [0.0، 0.5، 1.0]:
        سرچاپ "width at"، t، "="، سبک.قالب(سبک.ویژگی‌عرض، سبک.میان یابی(سبک.ویژگی‌عرض، a، b، t))
    پایان
    ناپایا c := سبک.مقدار {}
    ناپایا d := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌سایه، "none"، c)
    سبک.تجزیه(سبک.ویژگی‌سایه، "0, 4, 8, black"، d)
    سرچاپ "shadow half way:"، سبک.قالب(سبک.ویژگی‌سایه، سبک.میان یابی(سبک.ویژگی‌سایه، c، d، 0.5))
    ease := سبک.نرمش { گونه = سبک.نرمش‌فنر، سختی = 170.0، میرایی = 26.0 }
    سرچاپ "spring at 0.5:"، (سبک.نرمش در(ease، 0.5) * 1000.0) برگردان صحیح
پایان
