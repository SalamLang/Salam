واردسازی رابط گرافیکی.سبک

تابع ریشه:
    هر text در ["8, 16"، "100% - 20"، "۸، ۱۶٪"، "8 16"، "-4"]:
        ناپایا v := سبک.مقدار {}
        اگر سبک.تجزیه(سبک.ویژگی‌فاصله، text، v):
            سرچاپ "padding ="، text، "->"، سبک.قالب(سبک.ویژگی‌فاصله، v)، "/"، v.اجزا.طول()، "items"
        وگرنه:
            سرچاپ سبک.خطا(سبک.ویژگی‌فاصله، text)
        پایان
    پایان
    ناپایا b := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌کادر، "#3366aa, 2"، b)
    سرچاپ "border:"، سبک.قالب(سبک.ویژگی‌کادر، b)
    ناپایا sh := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌سایه، "[0, 4, 8, black], [0, 1, 2, red]"، sh)
    سرچاپ "shadow groups:"، sh.آغازها.طول()، "first item kind is a length:"، sh.اجزا.بگیر(0).گونه برابر سبک.جزء‌طول
پایان
