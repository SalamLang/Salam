واردسازی رابط گرافیکی.سبک

تابع ریشه:
    هر متن در ["8, 16"، "100% - 20"، "۸، ۱۶٪"، "8 16"، "-4"]:
        ناپایا مقدار_محلی := سبک.مقدار {}
        اگر سبک.تجزیه(سبک.ویژگی‌فاصله، متن، مقدار_محلی):
            سرچاپ "padding ="، متن، "->"، سبک.قالب(سبک.ویژگی‌فاصله، مقدار_محلی)، "/"، مقدار_محلی.اجزا.طول()، "items"
        وگرنه:
            سرچاپ سبک.خطا(سبک.ویژگی‌فاصله، متن)
        پایان
    پایان
    ناپایا بافر_محلی := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌کادر، "#3366aa, 2"، بافر_محلی)
    سرچاپ "border:"، سبک.قالب(سبک.ویژگی‌کادر، بافر_محلی)
    ناپایا متغیر_sh := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌سایه، "[0, 4, 8, black], [0, 1, 2, red]"، متغیر_sh)
    سرچاپ "shadow groups:"، متغیر_sh.آغازها.طول()، "first item kind is a length:"، متغیر_sh.اجزا.بگیر(0).گونه برابر سبک.جزء‌طول
پایان
