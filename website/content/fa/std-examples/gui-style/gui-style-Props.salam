واردسازی رابط گرافیکی.سبک

تابع ریشه:
    سرچاپ سبک.شمار‌ویژگی‌ها، "properties,"، سبک.شمار‌واژه‌ها - 1، "keywords"
    p := سبک.ویژگی با نام("فاصله")
    info := سبک.اطلاعات(p)
    سرچاپ p برابر سبک.ویژگی‌فاصله، سبک.نام ویژگی(p)، سبک.نام فارسی ویژگی(p)، info.گونه برابر سبک.گونه‌طول، info.کمینه، info.بیشینه، info.آغازین
    سرچاپ "inherited:"، سبک.ارثی است(سبک.ویژگی‌رنگ)، سبک.ارثی است(سبک.ویژگی‌فاصله)، "animatable:"، سبک.پویانما است(سبک.ویژگی‌شفافیت)، سبک.پویانما است(سبک.ویژگی‌چیدمان)
    هر w در سبک.واژه‌های ویژگی(سبک.ویژگی‌چیدمان):
        سرچاپ "  "، سبک.نام واژه(w)، "="، سبک.نام فارسی واژه(w)
    پایان
    سرچاپ سبک.واژه با نام("ردیف") برابر سبک.واژه‌ردیف
پایان
