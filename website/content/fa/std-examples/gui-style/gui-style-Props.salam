واردسازی رابط گرافیکی.سبک

تابع ریشه:
    سرچاپ سبک.شمار‌ویژگی‌ها، "properties,"، سبک.شمار‌واژه‌ها - 1، "keywords"
    ویژگی_محلی := سبک.ویژگی با نام("فاصله")
    اطلاعات := سبک.اطلاعات(ویژگی_محلی)
    سرچاپ ویژگی_محلی برابر سبک.ویژگی‌فاصله، سبک.نام ویژگی(ویژگی_محلی)، سبک.نام فارسی ویژگی(ویژگی_محلی)، اطلاعات.گونه برابر سبک.گونه‌طول، اطلاعات.کمینه، اطلاعات.بیشینه، اطلاعات.آغازین
    سرچاپ "inherited:"، سبک.ارثی است(سبک.ویژگی‌رنگ)، سبک.ارثی است(سبک.ویژگی‌فاصله)، "animatable:"، سبک.پویانما است(سبک.ویژگی‌شفافیت)، سبک.پویانما است(سبک.ویژگی‌چیدمان)
    هر نویسنده در سبک.واژه‌های ویژگی(سبک.ویژگی‌چیدمان):
        سرچاپ "  "، سبک.نام واژه(نویسنده)، "="، سبک.نام فارسی واژه(نویسنده)
    پایان
