واردسازی رابط گرافیکی.سبک

تابع ریشه:
    page := سبک.پیش فرض("page")
    ناپایا h := سبک.پیش فرض("h1")
    سبک.ارث بری(page، h)
    ناپایا v := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌رنگ، "#3366aa"، v)
    سبک.بگذار(h، سبک.ویژگی‌رنگ، v)
    سبک.تجزیه(سبک.ویژگی‌فاصله، "8, 16"، v)
    سبک.بگذار(h، سبک.ویژگی‌فاصله، v)
    سرچاپ "layout flow:"، h.چیدمان برابر سبک.واژه‌جریان، "font size:"، h.اندازه قلم.ام، "em, weight"، h.وزن قلم
    سرچاپ "padding:"، h.فاصله بالا.پیکسل، h.فاصله انتها.پیکسل، h.فاصله پایین.پیکسل، h.فاصله ابتدا.پیکسل
    سرچاپ "color:"، سبک.قالب(سبک.ویژگی‌رنگ، سبک.بگیر(h، سبک.ویژگی‌رنگ))
    سرچاپ "margin:"، سبک.قالب(سبک.ویژگی‌فضا، سبک.بگیر(h، سبک.ویژگی‌فضا))
    button := سبک.پیش فرض("button")
    سرچاپ "button:"، button.چیدمان برابر سبک.واژه‌ردیف، button.نشانگر برابر سبک.واژه‌اشاره، button.ضخامت کادر بالا.پیکسل
