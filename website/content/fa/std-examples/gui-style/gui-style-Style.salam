واردسازی رابط گرافیکی.سبک

تابع ریشه:
    صفحه_مقدار := سبک.پیش فرض("page")
    ناپایا اچ := سبک.پیش فرض("h1")
    سبک.ارث بری(صفحه_مقدار، اچ)
    ناپایا مقدار_محلی := سبک.مقدار {}
    سبک.تجزیه(سبک.ویژگی‌رنگ، "#3366aa"، مقدار_محلی)
    سبک.بگذار(اچ، سبک.ویژگی‌رنگ، مقدار_محلی)
    سبک.تجزیه(سبک.ویژگی‌فاصله، "8, 16"، مقدار_محلی)
    سبک.بگذار(اچ، سبک.ویژگی‌فاصله، مقدار_محلی)
    سرچاپ "layout flow:"، اچ.چیدمان برابر سبک.واژه‌جریان، "font size:"، اچ.اندازه قلم.ام، "em, weight"، اچ.وزن قلم
    سرچاپ "padding:"، اچ.فاصله بالا.پیکسل، اچ.فاصله انتها.پیکسل، اچ.فاصله پایین.پیکسل، اچ.فاصله ابتدا.پیکسل
    سرچاپ "color:"، سبک.قالب(سبک.ویژگی‌رنگ، سبک.بگیر(اچ، سبک.ویژگی‌رنگ))
    سرچاپ "margin:"، سبک.قالب(سبک.ویژگی‌فضا، سبک.بگیر(اچ، سبک.ویژگی‌فضا))
    متغیر_button := سبک.پیش فرض("button")
    سرچاپ "button:"، متغیر_button.چیدمان برابر سبک.واژه‌ردیف، متغیر_button.نشانگر برابر سبک.واژه‌اشاره، متغیر_button.ضخامت کادر بالا.پیکسل
پایان
