واردسازی رابط گرافیکی.سینی

تابع ریشه:
    ناپایا items := وکتور {} برگردان وکتور<سینی.گزینه>
    items.افزودن(سینی.گزینه تازه("show"، "Show window"))
    items.افزودن(سینی.گزینه تیک دار("auto"، "Connect at login"، درست))
    items.افزودن(سینی.خط جدا())
    items.افزودن(سینی.گزینه { شناسه = "update"، برچسب = "Check for updates"، فعال = نادرست })
    items.افزودن(سینی.گزینه تازه("quit"، "Quit"))
    هر it در items:
        سرچاپ it.شناسه، it.برچسب، it.فعال، it.تیک خورده، it.جداکننده
    پایان
    سینی.تنظیم منو(items)
    سرچاپ "shown"، سینی.نمایان است()
پایان
