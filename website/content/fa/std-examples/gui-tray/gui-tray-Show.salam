واردسازی رابط گرافیکی.سینی

تابع ریشه:
    اگر وارونه سینی.پشتیبانی شده():
        سرچاپ "no tray on"، سینی.سامانه پشتیبان()، "because"، سینی.آخرین خطا()
        برگشت
    پایان
    ناپایا items := وکتور {} برگردان وکتور<سینی.گزینه>
    items.افزودن(سینی.گزینه تازه("quit"، "Quit"))
    اگر وارونه سینی.نمایش("assets/icon.png"، "Disconnected"، items):
        سرچاپ "tray failed:"، سینی.آخرین خطا()
        برگشت
    پایان
    سینی.تنظیم راهنما("Connected")
    _ok := سینی.تنظیم نماد("assets/icon-on.png")
    سینی.پنهان کردن()
پایان
