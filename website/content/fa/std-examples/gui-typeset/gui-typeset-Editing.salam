// زبان: فارسی
واردسازی رابط گرافیکی.حروف‌چینی
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    ناپایا fc := حروف‌چینی.مجموعه قلم تازه()
    حروف‌چینی.افزودن پرونده قلم(fc، مسیر پرونده.پیوند(مسیر پرونده.پوشه(سیستم عامل.متغیر محیطی("SALAM_STD"))، "books/fonts/XB Zar.ttf"))
    ناپایا spans := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    spans.بیفزا(حروف‌چینی.تکه متن { متن = "نام Salam است"، خانواده‌های قلم = "XB Zar"، اندازه = 20.0 })
    ناپایا st := حروف‌چینی.سبک بند {}
    st.فاصله‌های سفید = حروف‌چینی.فاصله سفید.PreWrap
    ناپایا p := حروف‌چینی.بند تازه(fc، spans، st)
    ناپایا l := حروف‌چینی.چیدن بند(p، fc، 0.0)
    hit := حروف‌چینی.آزمون برخورد(p، l، 40.0، 10.0)
    سرچاپ hit.جابجایی، hit.وابسته به پیش، hit.خط
    caret := حروف‌چینی.مستطیل نشانگر(p، l، hit)
    سرچاپ caret.ایکس، caret.ایگرگ، caret.پهنا، caret.بلندی
    rects := حروف‌چینی.مستطیل‌های گزینش(p، l، 3، 12)
    هر r در rects:
        سرچاپ r.ایکس، r.پهنا
    پایان
    rects.آزادکن()
    سرچاپ حروف‌چینی.خوشه بعدی(p، 0)، حروف‌چینی.خوشه پیشین(p، 4)، حروف‌چینی.انتهای واژه بعدی(p، 0)، حروف‌چینی.آغاز واژه پیشین(p، 12)
    ناپایا pos := حروف‌چینی.جای متن { جابجایی = 0 }
    تکرار 4:
        pos = حروف‌چینی.جابجایی دیداری(p، l، pos، نادرست)
        چاپ pos.جابجایی، " "
    پایان
    سرچاپ ""
    حروف‌چینی.آزادسازی چیدمان(l)
    حروف‌چینی.آزادسازی بند(p)
    spans.آزادکن()
    حروف‌چینی.آزادسازی مجموعه قلم(fc)
پایان
