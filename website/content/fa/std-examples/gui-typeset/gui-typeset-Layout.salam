// زبان: فارسی
واردسازی رابط گرافیکی.حروف‌چینی
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    fonts := مسیر پرونده.پیوند(مسیر پرونده.پوشه(سیستم عامل.متغیر محیطی("SALAM_STD"))، "books/fonts/")
    ناپایا fc := حروف‌چینی.مجموعه قلم تازه()
    حروف‌چینی.افزودن پرونده قلم(fc، fonts + "XB Zar.ttf")
    حروف‌چینی.افزودن پرونده قلم(fc، fonts + "DejaVuSansMono.ttf")
    ناپایا spans := وکتور {} برگردان وکتور<حروف‌چینی.تکه متن>
    spans.بیفزا(حروف‌چینی.تکه متن { متن = "قیمت این کتاب "، خانواده‌های قلم = "XB Zar"، اندازه = 18.0، برچسب = 1، زبان = "fa" })
    spans.بیفزا(حروف‌چینی.تکه متن { متن = "12 USD"، خانواده‌های قلم = "DejaVu Sans Mono"، اندازه = 14.0، برچسب = 2، فاصله حرف‌ها = 0.5 })
    spans.بیفزا(حروف‌چینی.تکه متن { متن = " است."، خانواده‌های قلم = "XB Zar"، اندازه = 18.0، برچسب = 3، فاصله واژه‌ها = 2.0، بلندی خط = 30.0، ضریب بلندی خط = 0.0 })
    ناپایا st := حروف‌چینی.سبک بند {}
    st.چینش = حروف‌چینی.چینش متن.Justify
    st.جهت = حروف‌چینی.جهت متن خودکار
    st.فاصله‌های سفید = حروف‌چینی.فاصله سفید.Normal
    st.شکستن سرریز = حروف‌چینی.شکستن سرریز.BreakWord
    st.بیشینه خط‌ها = 3
    st.سه نقطه = درست
    st.زبان = "fa"
    ناپایا p := حروف‌چینی.بند تازه(fc، spans، st)
    سرچاپ حروف‌چینی.پهنای کمینه محتوا(p)، حروف‌چینی.پهنای بیشینه محتوا(p)، p.کمینه محتوا، p.بیشینه محتوا
    سرچاپ p.متن، p.سبک.بیشینه خط‌ها، p.تکه‌ها.طول()، p.آغاز تکه‌ها.بگیر(1)، حروف‌چینی.تکه جای(p، 30)
    c := p.نویسه‌ها.بگیر(0)
    سرچاپ c.جابجایی، c.کد نویسه، c.تکه، c.تراز، c.تراز پایه، c.پرچم‌ها، c.پیشروی، c.شکست، c.چهره
    r := p.دنباله‌ها.بگیر(0)
    سرچاپ r.آغاز نویسه، r.انتهای نویسه، r.آغاز گلیف، r.انتهای گلیف، r.تراز، r.چهره، r.تکه، r.اندازه شصت‌وچهارم
    g := p.گلیف‌ها.بگیر(0)
    سرچاپ g.شناسه، g.نویسه، g.پیشروی، g.جابجایی افقی، g.جابجایی عمودی
    ناپایا l := حروف‌چینی.چیدن بند(p، fc، 110.0)
    سرچاپ l.پهنا، l.بلندی، l.بیشینه پهنا، l.بریده‌شده، l.خط‌ها.طول()
    هر lb در l.خط‌ها:
        سرچاپ lb.آغاز، lb.انتهای بایت، lb.آغاز نویسه، lb.انتهای نویسه، lb.آغاز فاصله پایانی، lb.بالا، lb.خط پایه، lb.بلندی، lb.صعود، lb.نزول، lb.ایکس، lb.پهنا، lb.آغاز دنباله، lb.شمار دنباله، lb.شکست سخت، lb.راست به چپ، lb.فاصله افزوده
    پایان
    هر run در l.دنباله‌ها:
        سرچاپ run.چهره، run.اندازه، run.ایکس، run.پهنا، run.آغاز، run.انتهای بایت، run.آغاز نویسه، run.انتهای نویسه، run.راست به چپ، run.تراز، run.برچسب، run.تکه، run.آغاز گلیف، run.شمار گلیف، run.سه نقطه
    پایان
    pg := l.گلیف‌ها.بگیر(0)
    سرچاپ pg.شناسه، pg.ایکس، pg.ایگرگ، pg.خوشه، pg.پیشروی
    حروف‌چینی.آزادسازی چیدمان(l)
    حروف‌چینی.آزادسازی بند(p)
    spans.آزادکن()
    حروف‌چینی.آزادسازی مجموعه قلم(fc)
پایان
