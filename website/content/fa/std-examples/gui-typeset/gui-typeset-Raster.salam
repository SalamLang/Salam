// زبان: فارسی
واردسازی رابط گرافیکی.حروف‌چینی
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    ناپایا ok := نادرست
    ناپایا f := حروف‌چینی.بارگذاری قلم(مسیر پرونده.پیوند(مسیر پرونده.پوشه(سیستم عامل.متغیر محیطی("SALAM_STD"))، "books/fonts/XB Zar.ttf")، ok)
    gid := حروف‌چینی.اندیس نویسه(f، 0x0634)
    ناپایا m := حروف‌چینی.شطرنجی کردن گلیف(f، gid، 24.0، حروف‌چینی.زیرپیکسل(12.25))
    سرچاپ m.پهنا، m.بلندی، m.گام سطر، m.چپ، m.بالا، حروف‌چینی.درهم ماسک گلیف(m)
    سرچاپ حروف‌چینی.مبدا افقی گلیف(12.25، m)، حروف‌چینی.مبدا عمودی گلیف(30.0، m)
    bp := m.داده برگردان طبیعی۸*
    تکرار m.بلندی در y:
        تکرار m.پهنا در x:
            چاپ bp[y * m.گام سطر + x] بزرگتر (127 برگردان طبیعی۸) ? "#" : "."
        پایان
        سرچاپ ""
    پایان
    حروف‌چینی.آزادسازی ماسک گلیف(m)
    ناپایا cache := حروف‌چینی.نهانگاه گلیف تازه(65536)
    a := حروف‌چینی.گلیف نهان(cache، f، gid، 24.0، 12.25)
    b := حروف‌چینی.گلیف نهان(cache، f، gid، 24.0، 40.25)
    سرچاپ a.پهنا برابر b.پهنا، cache.برخوردها، cache.نیافته‌ها، cache.گنجایش، cache.بایت‌ها بزرگتر 0، cache.ساعت، cache.خانه‌ها.طول()، cache.فهرست.اندازه()
    slot := cache.خانه‌ها.بگیر(0)
    سرچاپ slot.کلید بزرگتر (0 برگردان صحیح۶۴)، slot.ماسک.پهنا، slot.مهر زمان، slot.اشغال
    حروف‌چینی.آزادسازی نهانگاه گلیف(cache)
    ناپایا o := حروف‌چینی.طرح تبدیل‌شده(f، gid، 0.01، 0.0، 0.0، -0.01، 2.0، 20.0)
    pt := o.نقطه‌ها.بگیر(0)
    سرچاپ o.نقطه‌ها.طول()، o.پایان‌های کانتور.طول()، pt.روی منحنی
    ناپایا cov := حروف‌چینی.پوشش طرح(o، 64، 64)
    سرچاپ cov.ایکس، cov.ایگرگ، cov.پهنا، cov.بلندی، cov.مقدارها.طول()
    حروف‌چینی.آزادسازی سطرهای پوشش(cov)
    حروف‌چینی.آزادسازی طرح(o)
    حروف‌چینی.آزادسازی قلم(f)
پایان
