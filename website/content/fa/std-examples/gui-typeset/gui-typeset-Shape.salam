// زبان: فارسی
واردسازی رابط گرافیکی.حروف‌چینی
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    ناپایا ok := نادرست
    ناپایا f := حروف‌چینی.بارگذاری قلم(مسیر پرونده.پیوند(مسیر پرونده.پوشه(سیستم عامل.متغیر محیطی("SALAM_STD"))، "books/fonts/XB Zar.ttf")، ok)
    glyphs := حروف‌چینی.شکل‌دهی متن(f، "می‌خواهم"، درست، ""، "fa")
    هر g در glyphs:
        سرچاپ g.شناسه، g.خوشه، g.پیشروی افقی، g.جابجایی افقی، g.جابجایی عمودی
    پایان
    glyphs.آزادکن()
    سرچاپ حروف‌چینی.شکل‌دهی عربی("سلام")
    سرچاپ حروف‌چینی.متن راست به چپ است("سلام")، حروف‌چینی.جهت پایه("Salam سلام") برابر حروف‌چینی.جهت متن چپ به راست
    سرچاپ حروف‌چینی.به ترتیب نمایشی("abc سلام"، حروف‌چینی.جهت متن خودکار)
    cps := حروف‌چینی.کدهای نمایشی("لا"، حروف‌چینی.جهت متن راست به چپ، درست)
    سرچاپ cps.طول()، cps.بگیر(0)
    cps.آزادکن()
    حروف‌چینی.آزادسازی قلم(f)
پایان
