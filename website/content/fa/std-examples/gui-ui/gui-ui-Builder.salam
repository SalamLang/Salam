واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک

تابع none(): وکتور<رابط کاربری.وصله‌سبک>:
    برگشت رابط کاربری.بی وصله()
پایان

تابع size(b: رابط کاربری.سازنده‌صفحه، w: رشته، h: رشته):
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌عرض، w)
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌ارتفاع، h)
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.عنوان صفحه("Menu")
    b.زبان صفحه("en")
    b.جهت صفحه("ltr")
    b.گشودن عنصر("box")
    b.شناسه عنصر("menu")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌چیدمان، "row")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌شکاف، "8")
    b.گشودن عنصر("box")
    b.شناسه عنصر("open")
    b.کلید عنصر("k1")
    b.ویژگی عنصر("title"، "Open the file")
    b.ویژگی دودویی عنصر("disabled"، نادرست)
    size(b، "80"، "30")
    b.بستن عنصر()
    b.گشودن عنصر("box")
    b.شناسه عنصر("save")
    b.کلید عنصر("k2")
    b.ویژگی دودویی عنصر("disabled"، درست)
    size(b، "80"، "30")
    b.بستن عنصر()
    b.بستن عنصر()
پایان

تابع ریشه:
    سرچاپ رابط کاربری.گزارش صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 300، 100)
