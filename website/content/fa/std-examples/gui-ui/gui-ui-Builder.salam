// زبان: فارسی
واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سی اس اس

ناپایا count := 0

تابع styles(): سی اس اس.برنامه‌سبک:
    ناپایا p := سی اس اس.برنامه سبک تازه()
    _box := سی اس اس.ترجمه اعلان ها(p، "padding: 16px; font-family: sans-serif")
    _btn := سی اس اس.ترجمه اعلان ها(p، "padding: 6px 12px; border-radius: 6px")
    _hover := سی اس اس.ترجمه اعلان ها(p، "background: #dde")
    برگشت p
پایان

تابع page(b: رابط کاربری.سازنده‌صفحه):
    b.عنوان صفحه("Counter")
    b.زبان صفحه("en")
    b.جهت صفحه("ltr")
    b.گشودن عنصر("div")
    b.اعلان های عنصر(0، -1، -1، -1)
    b.گشودن عنصر("h1")
    b.شناسه عنصر("count")
    b.متن فرزند("Count " + count)
    b.بستن عنصر()
    b.گشودن عنصر("button")
    b.اعلان های عنصر(1، 2، -1، -1)
    b.شناسه عنصر("add")
    b.کلاس عنصر("primary")
    b.کلید عنصر("add")
    b.ویژگی عنصر("type"، "button")
    b.ویژگی دودویی عنصر("disabled"، count بزرگتر 5)
    b.رسیدگی رخداد("click"، (): count++ پایان)
    b.متن فرزند("Add")
    b.بستن عنصر()
    b.گشودن عنصر("p")
    b.سبک زمان اجرا("width"، (100 + count * 10) + "px")
    b.متن فرزند("Grows with the count")
    b.بستن عنصر()
    b.بستن عنصر()
پایان

تابع ریشه:
    اگر count بزرگتر 99:
        رابط کاربری.اجرای ترجمه شده((): برگشت styles() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان)
    پایان
    رابط کاربری.اجرای ترجمه شده با((): برگشت styles() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان، رابط کاربری.گزینه‌ها { پهنا = 320.0، بلندی = 200.0، بی سر = درست، گام های آزمایشی = "click #add\nclick #add\nquit" })
    سرچاپ "count"، count
    ناپایا cv := رابط کاربری.نگاره ترجمه شده((): برگشت styles() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان، 320، 200)
    سرچاپ "canvas"، cv.پهنا، cv.بلندی
    cv.رهاسازی()
پایان
