واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک

تابع none(): وکتور<رابط کاربری.وصله‌سبک>:
    برگشت رابط کاربری.بی وصله()
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.گشودن عنصر("box")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌فاصله، "10")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌پس‌زمینه، "#ffffff")
    b.گشودن عنصر("box")
    b.شناسه عنصر("card")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌عرض، "50")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌ارتفاع، "30")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌پس‌زمینه، "#3366aa")
    b.بستن عنصر()
    b.بستن عنصر()
پایان

تابع ریشه:
    ناپایا one := رابط کاربری.نگاره صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 200، 100)
    ناپایا two := رابط کاربری.نگاره صفحه با مقیاس((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 200، 100، 2.0)
    سرچاپ "scale 1"، one.پهنا، one.بلندی
    سرچاپ "scale 2"، two.پهنا، two.بلندی
    p := one.پیکسل(30، 20)
    q := two.پیکسل(60، 40)
    سرچاپ "card"، p.قرمز، p.سبز، p.آبی، q.قرمز، q.سبز، q.آبی
    سرچاپ رابط کاربری.گزارش صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 200، 100)
    one.رهاسازی()
    two.رهاسازی()
پایان
