// زبان: فارسی
واردسازی رابط گرافیکی.رابط کاربری
واردسازی سیستم عامل
واردسازی مسیر پرونده

تابع ریشه:
    _a := رابط کاربری.افزودن پرونده قلم("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf")
    _b := رابط کاربری.افزودن پوشه قلم("/usr/share/fonts/truetype/noto")
    doc := `<!doctype html><html lang="fa" dir="rtl"><head><style>.card{border:2px solid #36c;border-radius:10px;padding:12px;margin:12px;box-shadow:0 2px 6px rgba(0,0,0,.3)}</style></head><body><div class="card"><h2>سلام</h2><p>یک کارت با <b>متن فارسی</b>.</p></div></body></html>`
    ناپایا cv := رابط کاربری.نگاره(doc، 320، 200)
    سرچاپ "size"، cv.پهنا، cv.بلندی
    cv.رهاسازی()
    ناپایا hi := رابط کاربری.نگاره با مقیاس(doc، 320، 200، 2.0)
    سرچاپ "hidpi"، hi.پهنا، hi.بلندی
    hi.رهاسازی()
    path := مسیر پرونده.پیوند(سیستم عامل.پوشه موقت()، "gui-ui-render.png")
    سرچاپ "png"، رابط کاربری.نگاره پی ان جی(doc، 320، 200، path)
    سیستم عامل.حذف(path)
    tree := رابط کاربری.گزارش سند(doc، 320، 200)
    سرچاپ "dump starts with body"، tree.شروع با("body")
    p := رابط کاربری.سنجش زمان(doc، 320، 200)
    سرچاپ "elements"، p.شمار عنصرها، "timed"، p.زمان تجزیه بزرگتربرابر 0.0 و p.زمان سبک بزرگتربرابر 0.0 و p.زمان چیدمان بزرگتربرابر 0.0 و p.زمان نقاشی بزرگتربرابر 0.0
پایان
