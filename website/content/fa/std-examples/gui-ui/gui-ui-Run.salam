واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک

ناپایا clicks := 0

تابع none(): وکتور<رابط کاربری.وصله‌سبک>:
    برگشت رابط کاربری.بی وصله()
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.عنوان صفحه("Counter")
    b.گشودن عنصر("box")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌فاصله، "16")
    b.گشودن عنصر("button")
    b.شناسه عنصر("go")
    b.رسیدگی رخداد("click"، (): clicks++ پایان)
    b.متن فرزند("Clicked " + clicks + " times")
    b.بستن عنصر()
    b.بستن عنصر()
پایان

تابع ریشه:
    o := رابط کاربری.گزینه‌ها { پهنا = 480.0، بلندی = 320.0، عنوان = "Counter" }
    رابط کاربری.اجرای صفحه با((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، o)
    سرچاپ "clicks"، clicks
    سرچاپ رابط کاربری.گزارش درخت()
    رابط کاربری.اجرای صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان)
پایان
