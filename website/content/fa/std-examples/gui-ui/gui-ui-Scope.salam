ناپایا count := 0
ناپایا touched := 0 برگردان صحیح۶۴
ناپایا likes := وکتور {} برگردان وکتور<صحیح>

تابع take(w: صحیح): صحیح۶۴:
    ناپایا t := 0 برگردان صحیح۶۴
    اگر w == 0:
        t = touched
        touched = 0
    پایان
    برگشت t
پایان

تابع sites():
    رابط کاربری.جایگاه دامنه(1، -1، 0، 1)
    رابط کاربری.جایگاه دامنه(2، 0، 0، 0)
پایان

تابع card(b: رابط کاربری.سازنده‌صفحه، name: رشته):
    b.دامنه واکنشی(2، (b: رابط کاربری.سازنده‌صفحه):
        k := b.نمونه بخش(0)
        اگر b.نمونه تازه():
            اگر k < likes.طول():
                likes[k] = 0
            وگرنه:
                likes.بیفزا(0)
            پایان
        پایان
        b.گشودن عنصر("button")
        b.شناسه عنصر(name)
        b.رسیدگی رخداد("click"، ():
            likes[k] += 1
            رابط کاربری.لمس نمونه(0، k)
        پایان)
        b.متن فرزند(name + " " + likes[k])
        b.بستن عنصر()
    پایان)
پایان

تابع page(b: رابط کاربری.سازنده‌صفحه):
    b.راه اندازی واکنش(1، (w: صحیح): برگشت take(w) پایان، (): sites() پایان)
    b.گشودن عنصر("div")
    b.دامنه واکنشی(1، (b: رابط کاربری.سازنده‌صفحه):
        b.گشودن عنصر("h1")
        b.شناسه عنصر("count")
        b.متن فرزند("Count " + count)
        b.بستن عنصر()
    پایان)
    b.گشودن عنصر("button")
    b.شناسه عنصر("add")
    b.رسیدگی رخداد("click"، ():
        count++
        touched |= 1
    پایان)
    b.متن فرزند("Add")
    b.بستن عنصر()
    b.گشودن عنصر("button")
    b.شناسه عنصر("redraw")
    b.رسیدگی رخداد("click"، (): رابط کاربری.بی اعتبار سازی() پایان)
    b.متن فرزند("Redraw")
    b.بستن عنصر()
    card(b، "tea")
    card(b، "cake")
    b.بستن عنصر()
پایان

تابع ریشه:
    script := "click #add\nclick #add\nclick #tea\nclick #cake\nclick #cake\nclick #redraw\nquit"
    رابط کاربری.اجرای ترجمه شده با((): برگشت سی اس اس.برنامه سبک تازه() پایان، (b: رابط کاربری.سازنده‌صفحه): page(b) پایان، رابط کاربری.گزینه‌ها { پهنا = 320.0، بلندی = 200.0، بی سر = درست، گام های آزمایشی = script })
    سرچاپ "count"، count، "tea"، likes[0]، "cake"، likes[1]
    سرچاپ "scope runs"، رابط کاربری.شمار اجرای دامنه()
