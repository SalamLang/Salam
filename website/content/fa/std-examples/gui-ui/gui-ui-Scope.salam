واردسازی رابط گرافیکی.رابط کاربری

ناپایا total := 0
ناپایا touched := 0 برگردان صحیح۶۴
ناپایا likes := وکتور {} برگردان وکتور<صحیح>

تابع take(w: صحیح): صحیح۶۴:
    ناپایا t := 0 برگردان صحیح۶۴
    اگر w برابر 0:
        t = touched
        touched = 0
    پایان
    برگشت t
پایان

تابع sites():
    رابط کاربری.جایگاه دامنه(1، -1، 0، 1)
    رابط کاربری.جایگاه دامنه(2، 0، 0، 0)
پایان

تابع none(): وکتور<رابط کاربری.وصله‌سبک>:
    برگشت رابط کاربری.بی وصله()
پایان

تابع item(b: رابط کاربری.سازنده‌صفحه، name: رشته):
    b.دامنه کلیددار(2، name، (b: رابط کاربری.سازنده‌صفحه): k := b.نمونه بخش(0) اگر b.نمونه تازه(): اگر k کوچکتر likes.طول(): likes[k] = 0 وگرنه: likes.بیفزا(0) پایان پایان b.گشودن عنصر("button") b.شناسه عنصر(name) b.رسیدگی رخداد("click"، (): likes[k] += 1 رابط کاربری.لمس نمونه(0، k) پایان) b.بستن عنصر() پایان)
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.راه اندازی واکنش(1، (w: صحیح): برگشت take(w) پایان، (): sites() پایان)
    b.گشودن عنصر("box")
    b.دامنه واکنشی(1، (b: رابط کاربری.سازنده‌صفحه): اگر b.یادداشت دامنه("" + total): برگشت پایان b.گشودن عنصر("box") b.شناسه عنصر("total") b.ویژگی عنصر("data-total"، "" + total) b.بستن عنصر() پایان)
    b.گشودن عنصر("button")
    b.شناسه عنصر("add")
    b.رسیدگی رخداد("click"، (): total++ touched |= 1 پایان)
    b.بستن عنصر()
    b.گشودن عنصر("button")
    b.شناسه عنصر("redraw")
    b.رسیدگی رخداد("click"، (): رابط کاربری.بی اعتبار سازی() پایان)
    b.بستن عنصر()
    item(b، "tea")
    item(b، "cake")
    b.بستن عنصر()
پایان

تابع ریشه:
    ناپایا c := رابط کاربری.نگاره صفحه((): برگشت none() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 200، 100)
