// زبان: فارسی
واردسازی رابط گرافیکی.رابط کاربری

ناپایا clicks := 0

تابع view(): رشته:
    برگشت `<!doctype html><html><head><title>Start</title><style>.on{color:red}</style></head><body><p id="msg" class="on">Clicked ` + clicks + `</p><button id="btn" onclick="hit()">Hit</button><input id="field" value="abc"><input id="box" type="checkbox"></body></html>`
پایان

تابع ریشه:
    رابط کاربری.ثبت رسیدگی("hit"، (): clicks++ پایان)
    ok := رابط کاربری.آغاز((): برگشت view() پایان، رابط کاربری.گزینه‌ها { پهنا = 320.0، بلندی = 200.0، بی سر = درست })
    سرچاپ "started"، ok، رابط کاربری.پنجره جاری().عنوان پنجره()، رابط کاربری.گام(0)
    رابط کاربری.اجرای گام ها("click #btn\nclick #field\ntype !")
    msg := رابط کاربری.با شناسه("msg")
    سرچاپ "text"، msg.متن عنصر()، "tag"، msg.برچسب()، "exists"، msg.وجود دارد()
    field := رابط کاربری.با شناسه("field")
    سرچاپ "value"، field.مقدار عنصر()
    field.تنظیم مقدار("set")
    box := رابط کاربری.با شناسه("box")
    box.تنظیم تیک(درست)
    سرچاپ "checked"، box.تیک خورده است()، "value"، field.مقدار عنصر()
    msg.افزودن کلاس("big")
    msg.حذف کلاس("on")
    msg.تنظیم ویژگی("title"، "note")
    سرچاپ "class"، msg.دارای کلاس("big")، msg.دارای کلاس("on")، "attr"، msg.ویژگی("title")
    msg.تنظیم متن("replaced until the next view")
    رابط کاربری.با شناسه("btn").تمرکز()
    رابط کاربری.با شناسه("btn").نمایان کردن()
    رابط کاربری.با شناسه("btn").کلیک()
    _alive := رابط کاربری.گام(0)
    سرچاپ "clicks"، clicks، msg.متن عنصر()، "red"، msg.سبک محاسبه شده().رنگ متن.قرمز
    r := msg.مستطیل()
    سرچاپ "has box"، r.پهنا بزرگتر 0.0، r.بلندی بزرگتر 0.0، r.ایکس بزرگتربرابر 0.0، r.ایگرگ بزرگتربرابر 0.0
    سرچاپ "frames"، رابط کاربری.شمار قاب() بزرگتر 0، "dump lines"، رابط کاربری.گزارش درخت().طول() بزرگتر 0
    رابط کاربری.اجرای گام ها("hover #btn")
    سرچاپ "damage"، رابط کاربری.شمار آسیب آخر() بزرگتربرابر 0، رابط کاربری.مساحت آسیب آخر() بزرگتربرابر 0
    partial := رابط کاربری.قاب().چکیده()
    رابط کاربری.بازنگاری کامل()
    سرچاپ "partial equals full"، partial برابر رابط کاربری.قاب().چکیده()
    رابط کاربری.توقف()
    _ok := رابط کاربری.آغاز سند(`<p>fixed</p>`، رابط کاربری.گزینه‌ها { بی سر = درست })
    رابط کاربری.توقف()
پایان
