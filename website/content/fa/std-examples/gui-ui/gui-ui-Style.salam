واردسازی رابط گرافیکی.رابط کاربری
واردسازی رابط گرافیکی.سبک

تابع patches(): وکتور<رابط کاربری.وصله‌سبک>:
    ناپایا all := رابط کاربری.بی وصله()
    ناپایا red := رابط کاربری.وصله تازه()
    ناپایا v := سبک.مقدار {}
    اگر سبک.تجزیه(سبک.ویژگی‌پس‌زمینه، "#cc0000"، v):
        red.بیفزا(سبک.ویژگی‌پس‌زمینه، v)
    پایان
    اگر سبک.تجزیه(سبک.ویژگی‌گردی، "6"، v):
        red.بیفزا(سبک.ویژگی‌گردی، v)
    پایان
    سرچاپ "patch length"، red.طول()
    all.بیفزا(red)
    برگشت all
پایان

تابع view(b: رابط کاربری.سازنده‌صفحه):
    b.گشودن عنصر("box")
    b.شناسه عنصر("a")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌عرض، "60")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌ارتفاع، "40")
    b.وصله عنصر(رابط کاربری.حالت پایه، 0)
    b.تنظیم سبک متنی(رابط کاربری.حالت شناور، سبک.ویژگی‌پس‌زمینه، "#0000cc")
    b.بستن عنصر()
    b.گشودن عنصر("box")
    b.شناسه عنصر("b")
    ناپایا v := سبک.مقدار {}
    اگر سبک.تجزیه(سبک.ویژگی‌پس‌زمینه، "#00aa00"، v):
        b.تنظیم سبک(رابط کاربری.حالت پایه، سبک.ویژگی‌پس‌زمینه، v)
    پایان
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌عرض، "60")
    b.تنظیم سبک متنی(رابط کاربری.حالت پایه، سبک.ویژگی‌ارتفاع، "40")
    b.بستن عنصر()
پایان

تابع ریشه:
    ناپایا c := رابط کاربری.نگاره صفحه((): برگشت patches() پایان، (b: رابط کاربری.سازنده‌صفحه): view(b) پایان، 100، 100)
    a := c.پیکسل(30، 20)
    b := c.پیکسل(30، 60)
    سرچاپ "a"، a.قرمز، a.سبز، a.آبی
    سرچاپ "b"، b.قرمز، b.سبز، b.آبی
    سرچاپ "states"،
        رابط کاربری.حالت پایه،
        رابط کاربری.حالت شناور،
        رابط کاربری.حالت تمرکز،
        رابط کاربری.حالت تمرکز درون،
        رابط کاربری.حالت فعال،
        رابط کاربری.حالت غیرفعال،
        رابط کاربری.حالت تیک خورده،
        رابط کاربری.حالت نامعتبر،
        رابط کاربری.حالت جای نوشته،
        رابط کاربری.حالت گزینش
    c.رهاسازی()
پایان
