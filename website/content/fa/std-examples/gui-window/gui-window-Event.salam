// زبان: فارسی
واردسازی رابط گرافیکی.پنجره ها

تابع ریشه:
    پنجره ها.تنظیم ساعت دستی(درست)
    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { پهنا = 300.0، بلندی = 200.0، بی سر = درست })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن دکمه، شماره پنجره = w.شناسه، ایکس = 10.0، ایگرگ = 20.0، دکمه = پنجره ها.دکمه‌موشی.دکمه چپ })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن دکمه، شماره پنجره = w.شناسه، ایکس = 10.0، ایگرگ = 20.0، دکمه = پنجره ها.دکمه‌موشی.دکمه چپ })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.فشردن کلید، شماره پنجره = w.شناسه، کلید = پنجره ها.کلیدها.کلید ورود، کد فیزیکی = 36، کلیدهای تغییر = پنجره ها.تغییرکنترل })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.ورود متن، شماره پنجره = w.شناسه، متن = "سلام" })
    پنجره ها.تزریق رویداد(پنجره ها.رویداد { نوع = پنجره ها.نوع‌رویداد.چرخش چرخ، شماره پنجره = w.شناسه، جابجایی عمودی = 1.0، واحد جابجایی = پنجره ها.واحدچرخش.چرخش خطی })
    ناپایا e := پنجره ها.سرکشی رویداد()
    تا e.نوع نابرابر پنجره ها.نوع‌رویداد.هیچ رویداد:
        ترابرد e.نوع:
            پنجره ها.نوع‌رویداد.فشردن دکمه:
                سرچاپ "down"، e.ایکس، e.ایگرگ، e.دکمه برابر پنجره ها.دکمه‌موشی.دکمه چپ، "clicks"، e.شمار کلیک
                بشکن
            پایان
            پنجره ها.نوع‌رویداد.فشردن کلید:
                سرچاپ "key"، e.کلید برابر پنجره ها.کلیدها.کلید ورود، e.کد فیزیکی، (e.کلیدهای تغییر & پنجره ها.تغییرکنترل) نابرابر 0، e.تکراری
                بشکن
            پایان
            پنجره ها.نوع‌رویداد.ورود متن:
                سرچاپ "text"، e.متن
                بشکن
            پایان
            پنجره ها.نوع‌رویداد.چرخش چرخ:
                سرچاپ "wheel"، e.جابجایی افقی، e.جابجایی عمودی، e.واحد جابجایی برابر پنجره ها.واحدچرخش.چرخش خطی
                بشکن
            پایان
            وگرنه:
                سرچاپ "other"، e.نوع برگردان صحیح، e.شماره پنجره
                بشکن
            پایان
        پایان
        e = پنجره ها.انتظار رویداد(0)
    پایان
    w.بستن()
پایان
