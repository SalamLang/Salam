// زبان: فارسی
واردسازی رابط گرافیکی.پنجره ها

تابع ریشه:
    options := پنجره ها.گزینه‌پنجره {
        عنوان = "Notes"، پهنا = 400.0، بلندی = 300.0، کمترین پهنا = 200.0، کمترین بلندی = 150.0،
        بیشترین پهنا = 800.0، بیشترین بلندی = 600.0، تغییرپذیر = درست، قاب دار = درست، وسط صفحه نمایش = درست،
        ایکس = 0.0، ایگرگ = 0.0، رنگ زمینه = 0xF5F5F5FF برگردان طبیعی۳۲، نمایان = درست، بی سر = درست، مقیاس = 2.0
    }
    w := پنجره ها.باز کردن(options)
    سرچاپ w.شناسه، w.باز است()، w.بی سر است()، w.متمرکز است()، w.عنوان پنجره()
    size := w.اندازه()
    سرچاپ size.پهنا، size.بلندی، size.پهنای فیزیکی، size.بلندی فیزیکی، w.ضریب مقیاس()
    w.تنظیم عنوان("Notes (2)")
    w.تنظیم اندازه(1000.0، 100.0)
    سرچاپ w.عنوان پنجره()، w.اندازه()
    w.تنظیم کمترین اندازه(100.0، 100.0)
    w.تنظیم بیشترین اندازه(0.0، 0.0)
    w.تنظیم اندازه(1000.0، 100.0)
    سرچاپ w.اندازه()
    w.تنظیم نشانگر(پنجره ها.شکل‌نشانگر.نشانگر دست)
    w.تنظیم جای نویسه ساز(20.0، 40.0، 2.0، 16.0)
    سرچاپ w.نشانگر کنونی() برابر پنجره ها.شکل‌نشانگر.نشانگر دست، w.جای نویسه ساز()
    w.تنظیم تمام صفحه(درست)
    سرچاپ w.تمام صفحه است()
    w.تنظیم تمام صفحه(نادرست)
    w.کمینه کردن()
    w.بیشینه کردن()
    w.بازگرداندن()
    w.متمرکز کردن()
    w.درخواست بازکشی دوباره()
    سرچاپ w.دستگیره() برابر پوچ
    w.بستن()
    سرچاپ w.باز است()
پایان
