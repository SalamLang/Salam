// زبان: فارسی
واردسازی رابط گرافیکی.پنجره ها
واردسازی حافظه

تابع ریشه:
    w := پنجره ها.باز کردن(پنجره ها.گزینه‌پنجره { پهنا = 4.0، بلندی = 3.0، بی سر = درست })
    pixels := حافظه.تخصیص صفرشده((4 * 3 * 4) برگردان طبیعی۶۴) برگردان طبیعی۳۲*
    دیرکن حافظه.آزادسازی(pixels برگردان تهی*)
    تکرار 12 در i:
        pixels[i] = 0xFF336699 برگردان طبیعی۳۲
    پایان
    سرچاپ w.ارائه کامل(pixels برگردان تهی*، 4، 3، 16)، w.شمار ارائه()، w.آخرین ناحیه تغییر()
    pixels[5] = 0xFFFF0000 برگردان طبیعی۳۲
    ناپایا damage := وکتور {} برگردان وکتور<پنجره ها.مستطیل>
    دیرکن damage.آزادکن()
    damage.بیفزا(پنجره ها.مستطیل { ایکس = 1، ایگرگ = 1، پهنا = 1، بلندی = 1 })
    سرچاپ w.ارائه(pixels برگردان تهی*، 4، 3، 16، damage)، w.آخرین ناحیه تغییر()، w.شمار آخرین ناحیه ها()
    سرچاپ w.نقطه در(1، 1) برابر (0xFFFF0000 برگردان طبیعی۳۲)، w.نقطه نمایش داده شده(0، 0) برابر (0xFF336699 برگردان طبیعی۳۲)
    سرچاپ w.تنظیم نماد(pixels برگردان تهی*، 2، 2، 16)
    w.بستن()
پایان
