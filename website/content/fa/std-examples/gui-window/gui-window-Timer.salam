// زبان: فارسی
واردسازی رابط گرافیکی.پنجره ها

تابع ریشه:
    پنجره ها.تنظیم ساعت دستی(درست)
    tick := پنجره ها.تنظیم زمان سنج(100، درست)
    once := پنجره ها.تنظیم زمان سنج(250، نادرست)
    تکرار 4:
        e := پنجره ها.انتظار رویداد(-1)
        سرچاپ e.نوع برابر پنجره ها.نوع‌رویداد.زنگ زمان سنج، e.زمان سنج برابر tick ? "tick" : "once"، پنجره ها.ساعت()
    پایان
    پنجره ها.پاک کردن زمان سنج(tick)
    پنجره ها.جلو بردن ساعت(1000)
    سرچاپ پنجره ها.ساعت()، پنجره ها.انتظار رویداد(10).نوع برابر پنجره ها.نوع‌رویداد.هیچ رویداد
    پنجره ها.بیدار کردن()
    سرچاپ پنجره ها.انتظار رویداد(-1).نوع برابر پنجره ها.نوع‌رویداد.بیدارباش، once بزرگتر tick
پایان
