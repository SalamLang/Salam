واردسازی بین‌المللی‌سازی
واردسازی ورودی خروجی

تابع ریشه:
    ناپایا ف := بین‌المللی‌سازی.جدید("en")
    دیرکن بین‌المللی‌سازی.آزادسازی(ف)
    ورودی خروجی.نوشتن پرونده("en.txt"، "apple.one = one apple\napple.other = {n} apples\n")
    سرچاپ بین‌المللی‌سازی.بارگذاری زبان(ف، "en"، "en.txt")
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن نام‌ها.آزادکن()
    نام‌ها.بیفزا("n")
    هر ن در [۱، ۵]:
        ناپایا مقدارها := وکتور {} برگردان وکتور<رشته>
        مقدارها.بیفزا("" + ن)
        سرچاپ بین‌المللی‌سازی.جایگذاری(بین‌المللی‌سازی.جمع(ف، "en"، "apple"، ن)، نام‌ها، مقدارها)
        مقدارها.آزادکن()
    پایان
    سرچاپ بین‌المللی‌سازی.تشخیص زبان().طول() > ۰
پایان
