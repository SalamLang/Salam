واردسازی بین‌المللی‌سازی

تابع ریشه:
    ناپایا ف := بین‌المللی‌سازی.جدید("en")
    دیرکن بین‌المللی‌سازی.آزادسازی(ف)
    بین‌المللی‌سازی.تنظیم(ف، "fa"، "greet"، "سلام {name}، {n} پیام تازه داری")
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    ناپایا مقدارها := وکتور {} برگردان وکتور<رشته>
    دیرکن نام‌ها.آزادکن()
    دیرکن مقدارها.آزادکن()
    نام‌ها.بیفزا("name")
    نام‌ها.بیفزا("n")
    مقدارها.بیفزا("مریم")
    مقدارها.بیفزا("۳")
    سرچاپ بین‌المللی‌سازی.ترجمه قالبی(ف، "fa"، "greet"، نام‌ها، مقدارها)
    سرچاپ بین‌المللی‌سازی.جایگذاری("{name} و باز هم {name}"، نام‌ها، مقدارها)
پایان
