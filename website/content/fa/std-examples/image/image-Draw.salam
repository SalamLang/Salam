واردسازی تصویر
واردسازی سیستم عامل

روال ریشه:
    ناپایا ت := تصویر.جدید(۸، ۶)
    سرچاپ ت.width، ت.height، تصویر.خالی است(ت)، تصویر.در محدوده(ت، ۷، ۵)، تصویر.در محدوده(ت، ۸، ۰)
    تصویر.پر کردن(ت، تصویر.قرمز سبز آبی(۲۵۵، ۲۵۵، ۲۵۵))
    تصویر.پر کردن با هگز(ت، "#202040")
    تصویر.تنظیم پیکسل(ت، ۰، ۰، تصویر.قرمز سبز آبی(۲۵۵، ۰، ۰))
    تصویر.ترکیب پیکسل(ت، ۱، ۰، تصویر.قرمز سبز آبی آلفا(۲۵۵، ۲۵۵، ۲۵۵، ۱۲۸))
    سرچاپ تصویر.به هگز(تصویر.دریافت پیکسل(ت، ۰، ۰))، تصویر.به هگز(تصویر.دریافت پیکسل(ت، ۱، ۰))، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(ت، ۲، ۰))
    تصویر.رسم خط(ت، ۰، ۵، ۷، ۵، تصویر.خاکستری(۲۰۰))
    تصویر.رسم مستطیل(ت، ۱، ۱، ۴، ۳، تصویر.خواندن هگز("#ffcc00"))
    تصویر.رسم مستطیل پر(ت، ۲، ۲، ۲، ۱، تصویر.خواندن هگز("#00ff00"))
    تصویر.رسم دایره(ت، ۶، ۲، ۱، تصویر.خاکستری(۲۵۵))
    تصویر.رسم دایره پر(ت، ۶، ۲، ۰، تصویر.خاکستری(۱۰))
    سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(ت، ۳، ۲))، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(ت، ۴، ۵))

    رنگ := تصویر.خواندن هگز("#336699")
    سرچاپ رنگ.r، رنگ.g، رنگ.b، رنگ.a، تصویر.درخشندگی(رنگ)
    سرچاپ تصویر.برابری(رنگ، تصویر.قرمز سبز آبی(۵۱، ۱۰۲، ۱۵۳))، تصویر.به هگز(تصویر.ترکیب(رنگ، تصویر.قرمز سبز آبی آلفا(۲۵۵، ۲۵۵، ۲۵۵، ۰)))
    سرچاپ تصویر.به هگز آر جی بی(تصویر.درون‌یابی رنگ(تصویر.خاکستری(۰)، تصویر.خاکستری(۲۰۰)، ۰.۵))

    ناپایا متنی := تصویر.جدید با رنگ(۴۰، ۱۰، تصویر.خاکستری(۰))
    تصویر.نوشتن متن(متنی، ۱، ۱، "SALAM"، تصویر.خاکستری(۲۵۵)، ۱)
    سرچاپ تصویر.عرض متن("SALAM"، ۱)، تصویر.عرض قلم، تصویر.ارتفاع قلم

    پوشه := سیستم عامل.پوشه موقت()
    سرچاپ تصویر.ذخیره(ت، پوشه + "/salam.png")، تصویر.ذخیره پی‌ان‌جی(ت، پوشه + "/salam2.png")، تصویر.ذخیره بی‌ام‌پی(ت، پوشه + "/salam.bmp")، تصویر.ذخیره جی‌پگ(ت، پوشه + "/salam.jpg"، ۹۰)
    سرچاپ تصویر.ذخیره با کیفیت(ت، پوشه + "/salam2.jpg"، ۵۰)، تصویر.ذخیره وب‌پی(ت، پوشه + "/salam.webp")
    ناپایا سالم := نادرست
    خوانده := تصویر.بازکردن(پوشه + "/salam.png"، سالم)
    سرچاپ سالم، خوانده.width، تصویر.برابری(تصویر.دریافت پیکسل(خوانده، ۰، ۰)، تصویر.دریافت پیکسل(ت، ۰، ۰))
    پ := تصویر.بازکردن پی‌ان‌جی(پوشه + "/salam2.png"، سالم)
    ب := تصویر.بازکردن بی‌ام‌پی(پوشه + "/salam.bmp"، سالم)
    ج := تصویر.بازکردن جی‌پگ(پوشه + "/salam.jpg"، سالم)
    سرچاپ سالم، پ.width، ب.height، ج.width
    سرچاپ تصویر.قالب از پسوند("a.jpeg") == تصویر.قالب جی‌پگ، تصویر.قالب از پسوند("a.png") == تصویر.قالب پی‌ان‌جی، تصویر.قالب از پسوند("a.txt") == تصویر.قالب نامشخص

    بافر := تصویر.کدگذاری پی‌ان‌جی(ت)
    سرچاپ تصویر.شناسایی قالب(بافر.data، بافر.len) == تصویر.قالب پی‌ان‌جی، تصویر.وب‌پی است(بافر.data، بافر.len)
    از بافر := تصویر.کدگشایی پی‌ان‌جی(بافر.data، بافر.len، سالم)
    عمومی := تصویر.کدگشایی(بافر.data، بافر.len، سالم)
    سرچاپ سالم، از بافر.width، عمومی.height
    بی := تصویر.کدگذاری بی‌ام‌پی(ت)
    بی۲ := تصویر.کدگشایی بی‌ام‌پی(بی.data، بی.len، سالم)
    جی := تصویر.کدگذاری جی‌پگ(ت، ۸۰)
    جی۲ := تصویر.کدگشایی جی‌پگ(جی.data، جی.len، سالم)
    سرچاپ تصویر.شناسایی قالب(بی.data، بی.len) == تصویر.قالب بی‌ام‌پی، تصویر.شناسایی قالب(جی.data، جی.len) == تصویر.قالب جی‌پگ، بی۲.width، جی۲.width
    آ := تصویر.کدگذاری(ت، تصویر.قالب بی‌ام‌پی، ۹۰)
    وبی := تصویر.کدگذاری وب‌پی(ت)
    سرچاپ آ.len == بی.len، وبی.len > ۰، تصویر.قالب وب‌پی
    شفاف := تصویر.جدید با رنگ(۱، ۱، تصویر.قرمز سبز آبی آلفا(۰، ۰، ۰، ۰))
    سرچاپ تصویر.به هگز(تصویر.دریافت پیکسل(تصویر.تخت کردن آلفا(شفاف، تصویر.خاکستری(۲۵۵))، ۰، ۰))
    تبدیلی := تصویر.تبدیل(ت، تصویر.قالب جی‌پگ)
    سرچاپ تبدیلی.width
    وب := تصویر.کدگشایی وب‌پی(وبی.data، وبی.len، سالم)
    سرچاپ سالم، وب.width، تصویر.برابری(تصویر.دریافت پیکسل(وب، ۱، ۰)، تصویر.دریافت پیکسل(ت، ۱، ۰))
    وب۲ := تصویر.بازکردن وب‌پی(پوشه + "/salam.webp"، سالم)
    سرچاپ سالم، وب۲.height
    ناپایا کپی := تصویر.کپی(ت)
    تصویر.آزادسازی(کپی)
    تصویر.آزادسازی(ت)
پایان
