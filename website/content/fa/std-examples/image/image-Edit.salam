واردسازی تصویر

روال اندازه(نام: رشته، ت: تصویر.تصویر):
    سرچاپ نام، "" + ت.width + "x" + ت.height
پایان

روال ریشه:
    ناپایا ت := تصویر.جدید با رنگ(۸، ۴، تصویر.خاکستری(۱۰۰))
    تصویر.تنظیم پیکسل(ت، ۰، ۰، تصویر.قرمز سبز آبی(۲۵۵، ۰، ۰))
    اندازه("نزدیک‌ترین"، تصویر.تغییر اندازه نزدیک‌ترین همسایه(ت، ۴، ۲))
    اندازه("دو خطی"، تصویر.تغییر اندازه دو خطی(ت، ۱۶، ۸))
    اندازه("تغییر اندازه"، تصویر.تغییر اندازه(ت، ۲، ۲، تصویر.دو خطی))
    اندازه("نزدیک"، تصویر.تغییر اندازه(ت، ۲، ۲، تصویر.نزدیک‌ترین همسایه))
    اندازه("مقیاس"، تصویر.مقیاس(ت، ۰.۵))
    اندازه("برش"، تصویر.برش(ت، ۲، ۱، ۳، ۲))
    ساعتگرد := تصویر.چرخش ساعتگرد(ت)
    اندازه("ساعتگرد"، ساعتگرد)
    سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(ساعتگرد، ۳، ۰))
    اندازه("پادساعتگرد"، تصویر.چرخش پادساعتگرد(ت))
    سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(تصویر.چرخش صدوهشتاد درجه(ت)، ۷، ۳))
    سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(تصویر.قرینه افقی(ت)، ۷، ۰))، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(تصویر.قرینه عمودی(ت)، ۰، ۳))
    اندازه("متناسب"، تصویر.تغییر اندازه متناسب(ت، ۴، ۴))
    اندازه("پرکننده"، تصویر.تغییر اندازه پرکننده(ت، ۴، ۴))
    اندازه("کوچک"، تصویر.تصویر کوچک(ت، ۲))

    ناپایا ر := تصویر.جدید با رنگ(۲، ۱، تصویر.قرمز سبز آبی(۲۰۰، ۱۰۰، ۵۰))
    تصویر.خاکستری کردن(ر)
    سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(ر، ۰، ۰))
    تصویر.معکوس کردن(ر)
    تصویر.روشنایی(ر، ۱۰)
    تصویر.کنتراست(ر، ۱.۵)
    سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(ر، ۰، ۰))
    تصویر.آستانه(ر، ۱۲۸)
    سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(ر، ۰، ۰))
    ناپایا نقطه := تصویر.جدید با رنگ(۵، ۵، تصویر.خاکستری(۰))
    تصویر.تنظیم پیکسل(نقطه، ۲، ۲، تصویر.خاکستری(۲۵۵))
    تار := تصویر.تار شده(نقطه، ۱)
    سرچاپ تصویر.دریافت پیکسل(تار، ۲، ۲).r < ۲۵۵، تصویر.دریافت پیکسل(تار، ۱، ۲).r > ۰
    سرچاپ تصویر.دریافت پیکسل(تصویر.تیزتر شده(نقطه، ۱.۰)، ۲، ۲).r
    ناپایا پایه := تصویر.جدید با رنگ(۲، ۲، تصویر.خاکستری(۰))
    تصویر.روپوش(پایه، تصویر.جدید با رنگ(۱، ۱، تصویر.خاکستری(۲۰۰))، ۱، ۱، ۰.۵)
    سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(پایه، ۱، ۱))، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(پایه، ۰، ۰))

    ناپایا بافت := تصویر.محاسبه بافت‌نگار(نقطه)
    سرچاپ تصویر.خواندن بافت‌نگار(بافت.luma، ۰)، تصویر.خواندن بافت‌نگار(بافت.luma، ۲۵۵)، تصویر.خواندن بافت‌نگار(بافت.r، ۲۵۵)، تصویر.خواندن بافت‌نگار(بافت.g، ۰)، تصویر.خواندن بافت‌نگار(بافت.b، ۰)
    تصویر.آزادسازی بافت‌نگار(بافت)
    سیاه := تصویر.جدید با رنگ(۵، ۵، تصویر.خاکستری(۰))
    تفاوت := تصویر.تفاوت(نقطه، سیاه)
    سرچاپ تصویر.دریافت پیکسل(تفاوت، ۲، ۲).r، تصویر.دریافت پیکسل(تفاوت، ۰، ۰).r
    سرچاپ (تصویر.میانگین خطای مطلق(نقطه، سیاه) * ۱۰۰.۰ + ۰.۵) برگردان صحیح، (تصویر.نسبت سیگنال به نویز(نقطه، سیاه) + ۰.۵) برگردان صحیح
پایان
