واردسازی تصویر
واردسازی ورودی خروجی

روال ریشه:
    سرچاپ تصویر.یافتن قلم سیستم()، تصویر.یافتن قلم عربی()
    ناپایا سالم := نادرست
    ناپایا قلم := تصویر.بارگذاری قلم سیستم(سالم)
    اگر وارونه سالم:
        قلم = تصویر.بارگذاری قلم("Vazirmatn-Regular.ttf"، سالم)
    پایان
    اگر وارونه سالم:
        سرچاپ "قلمی پیدا نشد"
        برگشت
    پایان
    سرچاپ تصویر.قلم معتبر(قلم)، تصویر.واحد در ام(قلم)، تصویر.تعداد نویسه‌ها(قلم)
    اندازه := ۳۲.۰
    سرچاپ تصویر.ضریب مقیاس(قلم، اندازه)، تصویر.صعود پیکسلی(قلم، اندازه)، تصویر.نزول پیکسلی(قلم، اندازه)، تصویر.ارتفاع خط پیکسلی(قلم، اندازه)
    الف := تصویر.اندیس نویسه(قلم، ۶۵)
    ب := تصویر.اندیس نویسه(قلم، ۸۶)
    سرچاپ تصویر.پیشروی نویسه(قلم، الف)، تصویر.کرنینگ(قلم، الف، ب)، تصویر.نویسه طرح دارد(قلم، الف)
    ناپایا x0 := ۰
    ناپایا y0 := ۰
    ناپایا x1 := ۰
    ناپایا y1 := ۰
    سرچاپ تصویر.کادر نویسه(قلم، الف، x0، y0، x1، y1)، x1 - x0، y1 - y0

    ناپایا ت := تصویر.جدید با رنگ(۴۰۰، ۱۲۰، تصویر.خاکستری(۲۵۵))
    سیاه := تصویر.خاکستری(۰)
    _ := تصویر.نوشتن متن قلم(ت، ۱۰.۰، ۴۰.۰، "Salam"، سیاه، قلم، اندازه)
    سرچاپ تصویر.عرض متن قلم(قلم، "Salam"، اندازه)
    سبک := تصویر.سبک متن { size = ۲۸.۰، tracking = ۱.۰، kern = درست، dir = تصویر.جهت متن خودکار، shape = درست }
    _ := تصویر.نوشتن متن با سبک(ت، ۱۰.۰، ۸۰.۰، "سلام دنیا"، سیاه، قلم، سبک)
    سرچاپ تصویر.عرض متن با سبک(قلم، "سلام دنیا"، سبک)، تصویر.عرض جوهر متن(قلم، "سلام"، سبک)، تصویر.ارتفاع جوهر متن(قلم، "سلام"، سبک)
    ناپایا عرض := ۰.۰
    ناپایا ارتفاع := ۰.۰
    سرچاپ تصویر.اندازه جوهر متن(قلم، "سلام"، سبک، عرض، ارتفاع)، عرض، ارتفاع
    ناپایا a0 := ۰.۰
    ناپایا b0 := ۰.۰
    ناپایا a1 := ۰.۰
    ناپایا b1 := ۰.۰
    سرچاپ تصویر.کادر متن(قلم، "سلام"، سبک، a0، b0، a1، b1)
    سرچاپ تصویر.اندازه متناسب با عرض(قلم، "سلام"، سبک، ۲۰۰.۰، ۹۶.۰)، تصویر.اندازه متناسب با کادر(قلم، "سلام"، سبک، ۲۰۰.۰، ۵۰.۰، ۹۶.۰)
    _ := تصویر.رسم نویسه با سبک(ت، الف، ۳۰۰.۰، ۴۰.۰، سیاه، قلم، سبک)
    _ := تصویر.رسم کدنقطه با سبک(ت، ۱۶۰۰، ۳۴۰.۰، ۴۰.۰، سیاه، قلم، سبک)
    _ := تصویر.نوشتن متن وسط‌چین(ت، ۲۰۰.۰، ۶۰.۰، "وسط"، سیاه، قلم، سبک)
    _ := تصویر.نوشتن متن وسط تصویر(ت، "وسط"، سیاه، قلم، سبک)
    _ := تصویر.نوشتن متن در کادر(ت، ۰.۰، ۰.۰، ۲۰۰.۰، ۶۰.۰، "کادر"، سیاه، قلم، سبک، تصویر.آرایش متن راست، تصویر.آرایش عمودی وسط)
    _ := تصویر.نوشتن متن جا‌شده در کادر(ت، ۰.۰، ۶۰.۰، ۲۰۰.۰، ۶۰.۰، "جا"، سیاه، قلم، سبک، ۰.۸، ۶۴.۰)
    _ := تصویر.نوشتن متن جا‌شده در تصویر(ت، "سلام"، سیاه، قلم، سبک، ۰.۹، ۱۲۰.۰)
    سرچاپ تصویر.آرایش متن چپ، تصویر.آرایش متن وسط، تصویر.آرایش عمودی بالا، تصویر.آرایش عمودی پایین، تصویر.آرایش عمودی خط پایه
    _ := تصویر.ذخیره(ت، "salam-text.png")

    داده := ورودی خروجی.خواندن پرونده("Vazirmatn-Regular.ttf")
    ناپایا ق۲ := تصویر.خواندن قلم(داده برگردان تهی*، داده.طول()، سالم)
    ناپایا ق۳ := تصویر.خواندن قلم با اندیس(داده برگردان تهی*، داده.طول()، ۰، سالم)
    ناپایا ق۴ := تصویر.بارگذاری قلم با اندیس("NotoSansCJK.ttc"، ۰، سالم)
    سرچاپ تصویر.قلم سی‌اف‌اف است(داده برگردان تهی*، داده.طول())
    تصویر.آزادسازی قلم(ق۲)
    تصویر.آزادسازی قلم(ق۳)
    تصویر.آزادسازی قلم(ق۴)
    تصویر.آزادسازی قلم(قلم)
    تصویر.آزادسازی(ت)
پایان
