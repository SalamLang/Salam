واردسازی تصویر
واردسازی فشرده سازی
واردسازی سیستم عامل

تابع ریشه:
    گزینه := تصویر.گزینه‌های جی‌پگ { quality = ۸۰، subsample = درست، density_unit = ۱، x_density = ۳۰۰، y_density = ۳۰۰، comment = "ساخته شده با سلام" }
    ناپایا ت := تصویر.جدید با رنگ(۴۰، ۲۴، تصویر.قرمز سبز آبی(۳۰، ۱۲۰، ۲۰۰))
    تصویر.رسم مستطیل پر(ت، ۱۰، ۶، ۲۰، ۱۲، تصویر.قرمز سبز آبی(۲۵۰، ۲۰۰، ۴۰))

    ناپایا جریان := تصویر.جریان جی‌پگ جدید(۴۰، ۲۴، گزینه)
    سرچاپ جریان.ok، جریان.mcu_w، جریان.mcu_h، جریان.mcus_x، جریان.mcu_rows
    تصویر.نوشتن نوار جی‌پگ(جریان، تصویر.برش(ت، ۰، ۰، ۴۰، ۱۶))
    سرچاپ جریان.rows_written، جریان.mcu_row
    ناپایا سطر := فشرده سازی.بافر بایت جدید()
    تکرار ۸ در ی:
        فشرده سازی.بازنشانی بافر(سطر)
        تکرار ۴۰ در ایکس:
            رنگ := تصویر.دریافت پیکسل(ت، ایکس، ۱۶ + ی)
            فشرده سازی.افزودن بایت(سطر، رنگ.r برگردان صحیح)
            فشرده سازی.افزودن بایت(سطر، رنگ.g برگردان صحیح)
            فشرده سازی.افزودن بایت(سطر، رنگ.b برگردان صحیح)
        پایان
        تصویر.نوشتن سطر جی‌پگ(جریان، سطر.data برگردان طبیعی۸*، ۳)
    پایان
    فشرده سازی.آزادسازی بافر(سطر)
    سرچاپ تصویر.پایان جریان جی‌پگ(جریان)، جریان.rows_written
    سرچاپ فشرده سازی.دریافت بایت(جریان.out، ۰)، فشرده سازی.دریافت بایت(جریان.out، ۱)، فشرده سازی.دریافت بایت(جریان.out، ۱۳)، فشرده سازی.دریافت بایت(جریان.out، ۱۴) * ۲۵۶ + فشرده سازی.دریافت بایت(جریان.out، ۱۵)

    ناپایا موفق := نادرست
    برگشتی := تصویر.کدگشایی جی‌پگ(جریان.out.data، جریان.out.len، موفق)
    سرچاپ موفق، برگشتی.width، برگشتی.height
    ناپایا یکجا := تصویر.کدگذاری جی‌پگ با گزینه(ت، گزینه)
    سرچاپ فشرده سازی.برابری بافر(یکجا، جریان.out)
    فشرده سازی.آزادسازی بافر(یکجا)
    فشرده سازی.آزادسازی بافر(جریان.out)

    سرچاپ تصویر.ذخیره جی‌پگ با گزینه(ت، "card.jpg"، تصویر.گزینه‌های جی‌پگ { quality = ۹۵، subsample = نادرست })، سیستم عامل.اندازه پرونده("card.jpg") > ۰
    سیستم عامل.حذف("card.jpg")
پایان
