واردسازی تصویر
واردسازی فشرده سازی
واردسازی سیستم عامل

تابع ریشه:
    گزینه := تصویر.گزینه‌های جی‌پگ { کیفیت = ۸۰، کاهش نمونه‌های رنگ = درست، واحد تراکم = ۱، تراکم افقی = ۳۰۰، تراکم عمودی = ۳۰۰، توضیح = "ساخته شده با سلام" }
    ناپایا ت := تصویر.جدید با رنگ(۴۰، ۲۴، تصویر.قرمز سبز آبی(۳۰، ۱۲۰، ۲۰۰))
    تصویر.رسم مستطیل پر(ت، ۱۰، ۶، ۲۰، ۱۲، تصویر.قرمز سبز آبی(۲۵۰، ۲۰۰، ۴۰))

    ناپایا جریان := تصویر.جریان جی‌پگ جدید(۴۰، ۲۴، گزینه)
    سرچاپ جریان.آماده، جریان.عرض واحد کدشده، جریان.ارتفاع واحد کدشده، جریان.واحدهای کدشده‌ی سطر، جریان.شمار نوارها
    ناپایا بالا := تصویر.برش(ت، ۰، ۰، ۴۰، ۱۶)
    تصویر.نوشتن نوار جی‌پگ(جریان، بالا)
    تصویر.آزادسازی(بالا)
    سرچاپ جریان.سطرهای نوشته‌شده، جریان.شماره نوار
    ناپایا سطر := فشرده سازی.بافر بایت جدید()
    تکرار ۸ در ی:
        فشرده سازی.بازنشانی بافر(سطر)
        تکرار ۴۰ در ایکس:
            رنگ := تصویر.دریافت پیکسل(ت، ایکس، ۱۶ + ی)
            فشرده سازی.افزودن بایت(سطر، رنگ.قرمز برگردان صحیح)
            فشرده سازی.افزودن بایت(سطر، رنگ.سبز برگردان صحیح)
            فشرده سازی.افزودن بایت(سطر، رنگ.آبی برگردان صحیح)
        پایان
        تصویر.نوشتن سطر جی‌پگ(جریان، سطر.داده برگردان طبیعی۸*، ۳)
    پایان
    فشرده سازی.آزادسازی بافر(سطر)
    سرچاپ تصویر.پایان جریان جی‌پگ(جریان)، جریان.سطرهای نوشته‌شده
    سرچاپ فشرده سازی.دریافت بایت(جریان.خروجی، ۰)، فشرده سازی.دریافت بایت(جریان.خروجی، ۱)، فشرده سازی.دریافت بایت(جریان.خروجی، ۱۳)، فشرده سازی.دریافت بایت(جریان.خروجی، ۱۴) * ۲۵۶ + فشرده سازی.دریافت بایت(جریان.خروجی، ۱۵)

    ناپایا موفق := نادرست
    ناپایا برگشتی := تصویر.کدگشایی جی‌پگ(جریان.خروجی.داده، جریان.خروجی.طول، موفق)
    سرچاپ موفق، برگشتی.عرض، برگشتی.ارتفاع
    تصویر.آزادسازی(برگشتی)
    ناپایا یکجا := تصویر.کدگذاری جی‌پگ با گزینه(ت، گزینه)
    سرچاپ فشرده سازی.برابری بافر(یکجا، جریان.خروجی)
    فشرده سازی.آزادسازی بافر(یکجا)
    فشرده سازی.آزادسازی بافر(جریان.خروجی)

    سرچاپ تصویر.ذخیره جی‌پگ با گزینه(ت، "card.jpg"، تصویر.گزینه‌های جی‌پگ { کیفیت = ۹۵، کاهش نمونه‌های رنگ = نادرست })، سیستم عامل.اندازه پرونده("card.jpg") > ۰
    سیستم عامل.حذف("card.jpg")
    تصویر.آزادسازی(ت)
پایان
