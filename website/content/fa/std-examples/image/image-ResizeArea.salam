واردسازی تصویر
واردسازی فشرده سازی

تابع ریشه:
    ناپایا ت := تصویر.جدید با رنگ(۶، ۴، تصویر.خاکستری(۰))
    تصویر.رسم مستطیل پر(ت، ۳، ۰، ۳، ۴، تصویر.خاکستری(۲۵۵))
    ناپایا کوچک := تصویر.تغییر اندازه ناحیه‌ای(ت، ۲، ۱)
    سرچاپ کوچک.عرض، کوچک.ارتفاع، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(کوچک، ۰، ۰))، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(کوچک، ۱، ۰))
    ناپایا نقطه := تصویر.تغییر اندازه ناحیه‌ای(ت، ۱، ۱)
    سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(نقطه، ۰، ۰))
    تصویر.آزادسازی(نقطه)
    تصویر.آزادسازی(کوچک)
    تصویر.آزادسازی(ت)

    ناپایا نمونه‌بردار := تصویر.نمونه‌بردار ناحیه‌ای جدید(۶، ۴، ۳، ۲)
    سرچاپ نمونه‌بردار.آماده، نمونه‌بردار.عرض خروجی، نمونه‌بردار.ارتفاع خروجی، نمونه‌بردار.سطر بعدی
    ناپایا سطر := فشرده سازی.بافر بایت جدید()
    تکرار ۴ در ی:
        فشرده سازی.بازنشانی بافر(سطر)
        تکرار ۶ در ایکس:
            مقدار := ایکس < ۳ ? ۰ : ۲۵۵
            فشرده سازی.افزودن بایت(سطر، مقدار)
            فشرده سازی.افزودن بایت(سطر، ی * ۶۰)
            فشرده سازی.افزودن بایت(سطر، ۱۰۰)
        پایان
        تصویر.افزودن سطر به نمونه‌بردار(نمونه‌بردار، سطر.داده برگردان طبیعی۸*، ۳)
    پایان
    فشرده سازی.آزادسازی بافر(سطر)
    تصویر.آزادسازی نمونه‌بردار(نمونه‌بردار)
    سرچاپ نمونه‌بردار.سطر بعدی، نمونه‌بردار.آماده
    تکرار ۲ در ی:
        سرچاپ تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(نمونه‌بردار.تصویر خروجی، ۰، ی))، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(نمونه‌بردار.تصویر خروجی، ۱، ی))، تصویر.به هگز آر جی بی(تصویر.دریافت پیکسل(نمونه‌بردار.تصویر خروجی، ۲، ی))
    پایان
    تصویر.آزادسازی(نمونه‌بردار.تصویر خروجی)
