واردسازی ورودی خروجی

روال ریشه:
    ناپایا خط‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن خط‌ها.آزادکن()
    خط‌ها.بیفزا("سیب")
    خط‌ها.بیفزا("انار")
    خط‌ها.بیفزا("انگور")
    بایت := ورودی خروجی.نوشتن خط ها("میوه‌ها.txt"، خط‌ها)
    سرچاپ "نوشته شد:", بایت, "بایت"
    خوانده := ورودی خروجی.خط ها("میوه‌ها.txt")
    دیرکن خوانده.آزادکن()
    هر (ش، م) در خوانده:
        سرچاپ ش + ۱, م
    پایان
پایان
