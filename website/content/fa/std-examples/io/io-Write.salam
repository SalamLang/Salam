واردسازی ورودی خروجی
واردسازی سیستم عامل

روال ریشه:
    پ := سیستم عامل.بازکردن("گزارش.txt"، "wb")
    ن := ورودی خروجی.نوشتن(پ، "گزارش امروز\n")
    ورودی خروجی.بستن(پ)
    سرچاپ "بایت‌های نوشته‌شده:", ن
    مبدأ := سیستم عامل.بازکردن("گزارش.txt"، "rb")
    مقصد := سیستم عامل.بازکردن("رونوشت.txt"، "wb")
    سرچاپ "رونوشت:", ورودی خروجی.کپی(مقصد، مبدأ), "بایت"
    ورودی خروجی.بستن(مبدأ)
    ورودی خروجی.بستن(مقصد)
    چاپ ورودی خروجی.خواندن پرونده("رونوشت.txt")
پایان
