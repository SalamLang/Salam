واردسازی جی دبلیو تی

تابع دلیل رد(توکن: رشته، گ: جی دبلیو تی.گزینه ها): رشته:
    تلاش:
        _ := جی دبلیو تی.تایید(توکن، "k"، گ)
        برگشت "ok"
    گرفتن خطا خ:
        برگشت خ.کد
    پایان
پایان

تابع ریشه خطادار:
    سرچاپ جی دبلیو تی.الگوریتم اچ اس۲۵۶، جی دبلیو تی.الگوریتم اچ اس۳۸۴، جی دبلیو تی.الگوریتم اچ اس۵۱۲
    سرچاپ جی دبلیو تی.الگوریتم پشتیبانی می شود("HS512")، جی دبلیو تی.الگوریتم پشتیبانی می شود("none")، جی دبلیو تی.اندازه چکیده("HS384")

    ناپایا ا := جی دبلیو تی.ادعاهای جدید()
    ا.موضوع = "7"
    ا.شناسه توکن = "t-1"
    جی دبلیو تی.انقضا در(ا، ۳۶۰۰)
    جی دبلیو تی.معتبر نه پیش از(ا، ۰)
    یک := تلاش جی دبلیو تی.امضای اچ اس۳۸۴(ا، "k")
    دو := تلاش جی دبلیو تی.امضای اچ اس۵۱۲(ا، "k")
    سه := تلاش جی دبلیو تی.امضا(ا، جی دبلیو تی.الگوریتم اچ اس۲۵۶، "k")
    چهار := تلاش جی دبلیو تی.امضا با شناسه کلید(ا، "HS256"، "key-2026"، "k")
    د۱ := تلاش جی دبلیو تی.کدگشایی(یک)
    د۲ := تلاش جی دبلیو تی.کدگشایی(دو)
    د۴ := تلاش جی دبلیو تی.کدگشایی(چهار)
    سرچاپ د۱.الگوریتم، د۲.الگوریتم، د۴.شناسه کلید

    ت := تلاش جی دبلیو تی.تایید اچ اس۲۵۶(سه، "k")
    سرچاپ ت.معتبر، جی دبلیو تی.ثانیه های باقی مانده(ت) > ۳۵۰۰
    ب := تلاش جی دبلیو تی.تایید(یک، "k"، جی دبلیو تی.گزینه ها برای("HS384"))
    سرچاپ ب.معتبر
    سرچاپ دلیل رد(یک، جی دبلیو تی.گزینه های پیش فرض())

    خام := تلاش جی دبلیو تی.امضای جیسون(`{"sub":"1"}`، "HS256"، ""، "k")
    سرچاپ خام
    د := تلاش جی دبلیو تی.کدگشایی(خام)
    سرچاپ د.سرآیند جیسون، د.بدنه جیسون
    سرچاپ جی دبلیو تی.امضای ورودی(د.ورودی امضا، "HS256"، "k") == د.امضا

    کد := جی دبلیو تی.کدگذاری پایه۶۴ نشانی("سلام؟")
    سرچاپ کد.طول()
    سرچاپ تلاش جی دبلیو تی.کدگشایی پایه۶۴ نشانی(کد)
    سرچاپ جی دبلیو تی.کدگذاری پایه۶۴ نشانی بایت("hi?" برگردان تهی*، ۳)
    تلاش:
        _ := جی دبلیو تی.کدگشایی پایه۶۴ نشانی("aGk/")
    گرفتن خطا خ:
        سرچاپ خ.کد، خ.جایگاه، خ.پیام
    پایان
    تلاش:
        _ := جی دبلیو تی.امضای اچ اس۲۵۶(ا، "")
    گرفتن خطا خ:
        سرچاپ خ.کد، خ.است(نوع خطا.آرگومان نامعتبر)، خ.پیام
    پایان
    ناپایا سخت‌گیر := جی دبلیو تی.گزینه ها برای("HS384")
    سخت‌گیر.صادرکننده = "salamlang.ir"
    سرچاپ دلیل رد(یک، سخت‌گیر)، دلیل رد("a.b"، سخت‌گیر)، دلیل رد("e30.e30.x"، سخت‌گیر)
پایان
