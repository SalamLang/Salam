واردسازی جی دبلیو تی
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

ناپایا نگه := جی دبلیو تی.نگهبان جدید("راز-سرور-که-فقط-سرور-می-داند")

تابع ورود(ز: صحیح۶۴):
    ناپایا ا := جی دبلیو تی.ادعاهای جدید()
    ا.موضوع = "42"
    جی دبلیو تی.تنظیم رشته(ا، "scope"، "read")
    جی دبلیو تی.تنظیم خام(ا، "roles"، `["editor"]`)
    تلاش:
        توکن := جی دبلیو تی.صدور(نگه، ا، ۳۶۰۰)
        جی دبلیو تی.تنظیم کوکی نشست ناامن(ز، نگه، توکن، ۳۶۰۰)
        اچ تی تی پی.متن(ز، توکن)
    گرفتن خطا خ:
        اچ تی تی پی.تنظیم وضعیت(ز، ۵۰۰)
        اچ تی تی پی.متن(ز، خ.پیام)
    پایان
پایان

تابع من(ز: صحیح۶۴):
    ناپایا ت := جی دبلیو تی.توکن {}
    اگر جی دبلیو تی.نیاز(ز، نگه، ت):
        اچ تی تی پی.متن(ز، "سلام کاربر " + ت.ادعاها.موضوع)
    پایان
پایان

تابع مدیر(ز: صحیح۶۴):
    ناپایا ت := جی دبلیو تی.توکن {}
    اگر جی دبلیو تی.نیاز به دامنه(ز، نگه، "admin"، ت):
        اچ تی تی پی.متن(ز، "پنل مدیر")
    پایان
پایان

تابع ویرایش(ز: صحیح۶۴):
    ناپایا ت := جی دبلیو تی.توکن {}
    اگر جی دبلیو تی.نیاز به ادعا(ز، نگه، "roles"، "editor"، ت):
        اچ تی تی پی.متن(ز، "ویرایشگر")
    پایان
پایان

تابع پرونده(ز: صحیح۶۴):
    ناپایا ت := جی دبلیو تی.توکن {}
    اگر جی دبلیو تی.نیاز به موضوع(ز، نگه، اچ تی تی پی.پارامتر(ز، "id")، ت):
        اچ تی تی پی.متن(ز، "پرونده‌ی خودت")
    پایان
پایان

تابع بررسی دستی(ز: صحیح۶۴):
    تلاش:
        ت := جی دبلیو تی.بررسی(ز، نگه)
        اگر ت.ادعاها.موضوع == "0":
            جی دبلیو تی.ممنوع(ز، "کاربر مسدود است")
        وگرنه:
            اچ تی تی پی.متن(ز، "معتبر")
        پایان
    گرفتن خطا خ:
        اگر خ.کد == "jwt.missing_token":
            جی دبلیو تی.بدون گواهی(ز، نگه)
        وگرنه:
            جی دبلیو تی.غیرمجاز(ز، نگه، خ.پیام)
        پایان
    پایان
پایان

تابع ورود امن(ز: صحیح۶۴):
    تلاش:
        توکن := جی دبلیو تی.صدور برای(نگه، "42"، ۳۶۰۰)
        جی دبلیو تی.تنظیم کوکی نشست(ز، نگه، توکن، ۳۶۰۰)
        اچ تی تی پی.متن(ز، "وارد شدید")
    گرفتن خطا خ:
        اچ تی تی پی.تنظیم وضعیت(ز، ۵۰۰)
        اچ تی تی پی.متن(ز، خ.پیام)
    پایان
پایان

تابع خروج(ز: صحیح۶۴):
    جی دبلیو تی.پاک کردن کوکی نشست(ز، نگه)
    اچ تی تی پی.متن(ز، "خارج شدید")
پایان

تابع ریشه خطادار:
    نگه.کوکی = "session"
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/login"، ورود)
    مسیریاب.دریافت(م، "/me"، من)
    مسیریاب.دریافت(م، "/admin"، مدیر)
    مسیریاب.دریافت(م، "/edit"، ویرایش)
    مسیریاب.دریافت(م، "/users/:id"، پرونده)
    مسیریاب.دریافت(م، "/check"، بررسی دستی)
    مسیریاب.ارسال(م، "/login/secure"، ورود امن)
    مسیریاب.ارسال(م، "/logout"، خروج)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۶۱۰)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19610"

    ورود پاسخ := اچ تی تی پی.ارسال(پایه + "/login"، "")
    توکن := اچ تی تی پی.بدنه(ورود پاسخ)
    سرچاپ اچ تی تی پی.نگاشت کوکی(ورود پاسخ).دریافت("session") == توکن
    امن پاسخ := اچ تی تی پی.ارسال(پایه + "/login/secure"، "")
    سرچاپ اچ تی تی پی.بدنه(امن پاسخ)، اچ تی تی پی.نگاشت کوکی(امن پاسخ).دریافت("session").طول() > ۰
    ناپایا سر := اچ تی تی پی.سرصفحه جدید()
    سر.درج("Authorization"، "Bearer " + توکن)
    سرچاپ جی دبلیو تی.تجزیه حامل("Bearer " + توکن) == توکن
    بپرس(پایه، "/me"، سر)
    بپرس(پایه، "/admin"، سر)
    بپرس(پایه، "/edit"، سر)
    بپرس(پایه، "/users/42"، سر)
    بپرس(پایه، "/users/7"، سر)
    بپرس(پایه، "/check"، سر)
    بپرس(پایه، "/me"، اچ تی تی پی.سرصفحه جدید())
    ناپایا بد := اچ تی تی پی.سرصفحه جدید()
    بد.درج("Authorization"، "Bearer x.y.z")
    بپرس(پایه، "/check"، بد)
    ناپایا کوکی := اچ تی تی پی.سرصفحه جدید()
    کوکی.درج("Cookie"، "session=" + توکن)
    بپرس(پایه، "/me"، کوکی)

    ناپایا دسترسی := ""
    ناپایا تازه‌سازی := ""
    تلاش جی دبلیو تی.صدور جفت(نگه، "42"، ۹۰۰، ۸۶۴۰۰، دسترسی، تازه‌سازی)
    سرچاپ دسترسی.طول() > ۰، دسترسی != تازه‌سازی
    یک := تلاش جی دبلیو تی.صدور برای(نگه، "42"، ۶۰)
    بررسی‌شده := تلاش جی دبلیو تی.تایید(یک، نگه.کلید امضا، نگه.گزینه‌ها)
    سرچاپ بررسی‌شده.ادعاها.موضوع، نگه.قلمرو
پایان

تابع بپرس(پایه: رشته، مسیر: رشته، سر: نگاشت<رشته، رشته>):
    پ := اچ تی تی پی.دریافت با(پایه + مسیر، سر)
    سرچاپ مسیر، اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.بدنه(پ)
پایان
