واردسازی جی دبلیو تی

تابع دلیل(توکن: رشته، راز: رشته، گ: جی دبلیو تی.گزینه ها): رشته:
    تلاش:
        _ := جی دبلیو تی.تایید(توکن، راز، گ)
        برگشت "ok"
    گرفتن خطا خ:
        برگشت خ.کد + " " + خ.پیام
    پایان
پایان

تابع ریشه خطادار:
    ناپایا ا := جی دبلیو تی.ادعاهای جدید()
    ا.صادرکننده = "salamlang.ir"
    ا.موضوع = "42"
    ا.مخاطب = "api"
    ا.زمان صدور = ۱۷۰۰۰۰۰۰۰۰
    ا.زمان انقضا = ۱۷۰۰۰۰۳۶۰۰
    جی دبلیو تی.تنظیم رشته(ا، "name"، "مریم")
    جی دبلیو تی.تنظیم عدد(ا، "level"، ۳)
    جی دبلیو تی.تنظیم منطقی(ا، "admin"، نادرست)
    جی دبلیو تی.تنظیم خام(ا، "scope"، `"read write"`)
    جی دبلیو تی.تنظیم خام(ا، "roles"، `["editor","viewer"]`)
    سرچاپ جی دبلیو تی.جیسون ادعاها(ا)

    توکن := تلاش جی دبلیو تی.امضای اچ اس۲۵۶(ا، "راز-بلند-و-تصادفی")
    سرچاپ توکن.طول() > ۰
    سرچاپ توکن

    ناپایا گ := جی دبلیو تی.گزینه های پیش فرض()
    گ.اکنون = ۱۷۰۰۰۰۱۰۰۰
    گ.صادرکننده = "salamlang.ir"
    گ.مخاطب = "api"
    ت := تلاش جی دبلیو تی.تایید(توکن، "راز-بلند-و-تصادفی"، گ)
    سرچاپ ت.معتبر، ت.الگوریتم، ت.نوع، ت.ادعاها.موضوع
    سرچاپ جی دبلیو تی.رشته(ت، "name")، جی دبلیو تی.عدد(ت، "level")، جی دبلیو تی.منطقی(ت، "admin")، جی دبلیو تی.دارد(ت، "email")
    سرچاپ جی دبلیو تی.خام(ت، "level")، جی دبلیو تی.دامنه دارد(ت، "write")، جی دبلیو تی.مخاطب دارد(ت، "api")، جی دبلیو تی.فهرست دارد(ت، "roles"، "editor")

    سرچاپ دلیل(توکن، "راز-دیگر"، گ)
    گ.اکنون = ۱۸۰۰۰۰۰۰۰۰
    سرچاپ دلیل(توکن، "راز-بلند-و-تصادفی"، گ)
    گ.اکنون = ۱۷۰۰۰۰۱۰۰۰
    گ.صادرکننده = "example.com"
    سرچاپ جی دبلیو تی.معتبر است(توکن، "راز-بلند-و-تصادفی"، گ)
    تلاش:
        _ := جی دبلیو تی.کدگشایی("abc")
    گرفتن خطا خ:
        سرچاپ خ.کد، خ.است(نوع خطا.نحو)
    پایان
پایان
