واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل

تابع ریشه:
    ز := ال ال وی ام.زمینه جدید()
    م := ال ال وی ام.ماژول جدید(ز، "fib")
    س := ال ال وی ام.سازنده جدید(ز)
    ص۳۲ := ال ال وی ام.نوع سی‌ودو بیتی(ز)

    هیچ := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    نوع اصلی := ال ال وی ام.نوع تابع(ص۳۲، هیچ، نادرست)
    اصلی := ال ال وی ام.افزودن تابع(م، "main"، نوع اصلی)
    آغاز := ال ال وی ام.افزودن بلوک(ز، اصلی، "entry")
    حلقه := ال ال وی ام.افزودن بلوک(ز، اصلی، "loop")
    پایانی := ال ال وی ام.افزودن بلوک(ز، اصلی، "done")

    ال ال وی ام.قرار دادن در انتها(س، آغاز)
    _ := ال ال وی ام.پرش(س، حلقه)
    ال ال وی ام.قرار دادن در انتها(س، حلقه)
    شمارنده := ال ال وی ام.فای(س، ص۳۲، "i")
    الف := ال ال وی ام.فای(س، ص۳۲، "a")
    ب := ال ال وی ام.فای(س، ص۳۲، "b")
    جمع := ال ال وی ام.جمع(س، الف، ب، "sum")
    بعدی := ال ال وی ام.جمع(س، شمارنده، ال ال وی ام.ثابت صحیح(ص۳۲، ۱)، "inext")
    ادامه := ال ال وی ام.مقایسه صحیح(س، ال ال وی ام.مقایسه کمتر علامت‌دار، بعدی، ال ال وی ام.ثابت صحیح(ص۳۲، ۱۰)، "more")
    _ := ال ال وی ام.پرش شرطی(س، ادامه، حلقه، پایانی)

    ناپایا مبداها := وکتور {} برگردان وکتور<ال ال وی ام.بلوک پایه>
    مبداها.بیفزا(آغاز)
    مبداها.بیفزا(حلقه)
    ناپایا ورودی ش := وکتور {} برگردان وکتور<ال ال وی ام.مقدار>
    ورودی ش.بیفزا(ال ال وی ام.ثابت صحیح(ص۳۲، ۰))
    ورودی ش.بیفزا(بعدی)
    ال ال وی ام.افزودن ورودی فای(شمارنده، ورودی ش، مبداها)
    ناپایا ورودی الف := وکتور {} برگردان وکتور<ال ال وی ام.مقدار>
    ورودی الف.بیفزا(ال ال وی ام.ثابت صحیح(ص۳۲، ۰))
    ورودی الف.بیفزا(ب)
    ال ال وی ام.افزودن ورودی فای(الف، ورودی الف، مبداها)
    ناپایا ورودی ب := وکتور {} برگردان وکتور<ال ال وی ام.مقدار>
    ورودی ب.بیفزا(ال ال وی ام.ثابت صحیح(ص۳۲، ۱))
    ورودی ب.بیفزا(جمع)
    ال ال وی ام.افزودن ورودی فای(ب، ورودی ب، مبداها)
    ال ال وی ام.قرار دادن در انتها(س، پایانی)
    _ := ال ال وی ام.بازگشت(س، ب)

    ب۲ := ال ال وی ام.بررسی(م)
    سرچاپ ب۲.ok
    چاپ ال ال وی ام.ماژول به رشته(م)
    مسیر := سیستم عامل.پوشه موقت() + "/salam_fib.ll"
    _ := ورودی خروجی.نوشتن پرونده(مسیر، ال ال وی ام.ماژول به رشته(م))
    ن := ال ال وی ام.اجرای جیت(مسیر)
    سرچاپ ن.ok، ن.rc
    ال ال وی ام.آزادسازی سازنده(س)
    ال ال وی ام.آزادسازی ماژول(م)
    ال ال وی ام.آزادسازی زمینه(ز)
پایان
