واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل

روال ریشه:
    ز := ال ال وی ام.زمینه جدید()
    م := ال ال وی ام.ماژول جدید(ز، "hello")
    س := ال ال وی ام.سازنده جدید(ز)
    ص۳۲ := ال ال وی ام.نوع سی‌ودو بیتی(ز)
    ص۶۴ := ال ال وی ام.نوع شصت‌وچهار بیتی(ز)
    ا۶۴ := ال ال وی ام.نوع اعشاری دقیق(ز)
    اش := ال ال وی ام.نوع اشاره‌گر(ز)
    _ := ال ال وی ام.نوع یک بیتی(ز)
    _ := ال ال وی ام.نوع هشت بیتی(ز)
    _ := ال ال وی ام.نوع شانزده بیتی(ز)
    _ := ال ال وی ام.نوع اعشاری(ز)
    _ := ال ال وی ام.نوع آرایه(ص۳۲، ۴)

    ناپایا پارامترهای قالب := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    پارامترهای قالب.بیفزا(اش)
    نوع قالب := ال ال وی ام.نوع تابع(ص۳۲، پارامترهای قالب، درست)
    _ := ال ال وی ام.افزودن تابع(م، "printf"، نوع قالب)
    چاپگر := ال ال وی ام.تابع نام‌دار(م، "printf")

    ناپایا دو عدد := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    دو عدد.بیفزا(ص۶۴)
    دو عدد.بیفزا(ص۶۴)
    نوع حساب := ال ال وی ام.نوع تابع(ص۶۴، دو عدد، نادرست)
    حساب := ال ال وی ام.افزودن تابع(م، "calc"، نوع حساب)
    ال ال وی ام.تنظیم پیوند(حساب، ال ال وی ام.پیوند درونی)
    ال ال وی ام.قرار دادن در انتها(س، ال ال وی ام.افزودن بلوک(ز، حساب، "entry"))
    ل := ال ال وی ام.پارامتر(حساب، ۰)
    ر := ال ال وی ام.پارامتر(حساب، ۱)
    ت := ال ال وی ام.تفریق(س، ال ال وی ام.ضرب(س، ل، ر، "m")، ال ال وی ام.تقسیم علامت‌دار(س، ل، ر، "d")، "t")
    _ := ال ال وی ام.بازگشت(س، ال ال وی ام.جمع(س، ت، ال ال وی ام.باقیمانده علامت‌دار(س، ل، ر، "r")، "x"))

    شمار := ال ال وی ام.افزودن سراسری(م، ص۶۴، "count")
    ال ال وی ام.تنظیم مقدار اولیه(شمار، ال ال وی ام.ثابت صحیح(ص۶۴، ۴۰))
    پی := ال ال وی ام.افزودن سراسری(م، ا۶۴، "pi")
    ال ال وی ام.تنظیم مقدار اولیه(پی، ال ال وی ام.ثابت اعشاری(ا۶۴، ۳.۱۴))
    ال ال وی ام.تنظیم ثابت سراسری(پی، درست)

    هیچ := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    اصلی := ال ال وی ام.افزودن تابع(م، "main"، ال ال وی ام.نوع تابع(ص۳۲، هیچ، نادرست))
    ال ال وی ام.قرار دادن در انتها(س، ال ال وی ام.افزودن بلوک(ز، اصلی، "entry"))
    سرچاپ ال ال وی ام.بلوک درج(س).handle != پوچ
    جا := ال ال وی ام.تخصیص پشته(س، ص۶۴، "n")
    _ := ال ال وی ام.ذخیره(س، ال ال وی ام.بارگذاری(س، ص۶۴، شمار، "c")، جا)
    ناپایا آرگ := وکتور {} برگردان وکتور<ال ال وی ام.مقدار>
    آرگ.بیفزا(ال ال وی ام.بارگذاری(س، ص۶۴، جا، "n1"))
    آرگ.بیفزا(ال ال وی ام.ثابت صحیح(ص۶۴، ۸))
    نتیجه := ال ال وی ام.فراخوان(س، نوع حساب، حساب، آرگ، "v")
    ناپایا آرگ قالب := وکتور {} برگردان وکتور<ال ال وی ام.مقدار>
    آرگ قالب.بیفزا(ال ال وی ام.رشته سراسری(س، "calc(40, 8) = %lld\n"، "fmt"))
    آرگ قالب.بیفزا(نتیجه)
    _ := ال ال وی ام.فراخوان(س، نوع قالب، چاپگر، آرگ قالب، "")
    _ := ال ال وی ام.بازگشت(س، ال ال وی ام.ثابت صحیح(ص۳۲، ۰))

    تهی := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    هیچ‌کار := ال ال وی ام.افزودن تابع(م، "noop"، ال ال وی ام.نوع تابع(ال ال وی ام.نوع تهی(ز)، تهی، نادرست))
    ال ال وی ام.تنظیم پیوند(هیچ‌کار، ال ال وی ام.پیوند خصوصی)
    ال ال وی ام.قرار دادن در انتها(س، ال ال وی ام.افزودن بلوک(ز، هیچ‌کار، "entry"))
    _ := ال ال وی ام.بازگشت تهی(س)
    سرچاپ ال ال وی ام.پیوند بیرونی، ال ال وی ام.بررسی(م).ok
    سرچاپ ال ال وی ام.مقایسه مساوی، ال ال وی ام.مقایسه نامساوی، ال ال وی ام.مقایسه بیشتر بی‌علامت، ال ال وی ام.مقایسه بیشتر مساوی بی‌علامت، ال ال وی ام.مقایسه کمتر بی‌علامت، ال ال وی ام.مقایسه کمتر مساوی بی‌علامت
    سرچاپ ال ال وی ام.مقایسه بیشتر علامت‌دار، ال ال وی ام.مقایسه بیشتر مساوی علامت‌دار، ال ال وی ام.مقایسه کمتر علامت‌دار، ال ال وی ام.مقایسه کمتر مساوی علامت‌دار

    مسیر := سیستم عامل.پوشه موقت() + "/salam_hello.ll"
    _ := ورودی خروجی.نوشتن پرونده(مسیر، ال ال وی ام.ماژول به رشته(م))
    سرچاپ ال ال وی ام.اجرای جیت(مسیر).rc
    ال ال وی ام.آزادسازی سازنده(س)
    ال ال وی ام.آزادسازی ماژول(م)
    ال ال وی ام.آزادسازی زمینه(ز)
پایان
