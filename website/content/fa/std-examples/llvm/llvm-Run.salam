واردسازی ال ال وی ام
واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی حافظه

تابع ریشه:
    سرچاپ ال ال وی ام.در دسترس()
    پوشه := سیستم عامل.پوشه موقت()
    ll := پوشه + "/salam_args.ll"
    _ := ورودی خروجی.نوشتن پرونده(ll، `define i32 @main(i32 %argc, ptr %argv) {
entry:
  %n = mul i32 %argc, 10
  ret i32 %n
}
`)

    ت := ال ال وی ام.تجزیه آی آر(ll)
    سرچاپ ت.ok
    ب := ال ال وی ام.بررسی(ت.mod)
    سرچاپ ب.ok، ال ال وی ام.بررسی با بازگرداندن وضعیت
    ال ال وی ام.تنظیم سه‌تایی هدف(ت.mod، ال ال وی ام.سه‌تایی پیش‌فرض())
    سرچاپ ال ال وی ام.سه‌تایی هدف(ت.mod) == ال ال وی ام.سه‌تایی پیش‌فرض()
    ال ال وی ام.آزادسازی ماژول(ت.mod)
    ال ال وی ام.آزادسازی زمینه(ت.ctx)

    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    آرگ.بیفزا("a")
    آرگ.بیفزا("b")
    سرچاپ ال ال وی ام.اجرای جیت با آرگومان(ll، آرگ).rc

    ناپایا گ := ال ال وی ام.تنظیمات پیش‌فرض()
    سرچاپ گ.opt_level، گ.output_mode
    گ.output_mode = ال ال وی ام.خروجی جیت
    گ.run_args = آرگ
    سرچاپ ال ال وی ام.اجرا(ll، گ).rc
    گ.output_mode = ال ال وی ام.خروجی شیء
    گ.output_file = پوشه + "/salam_args.o"
    سرچاپ ال ال وی ام.اجرا(ll، گ).ok
    گ.output_mode = ال ال وی ام.خروجی اسمبلی
    گ.output_file = پوشه + "/salam_args.s"
    سرچاپ ال ال وی ام.اجرا(ll، گ).ok
    سرچاپ ال ال وی ام.خروجی آی آر، ال ال وی ام.خروجی بیت‌کد، ال ال وی ام.خروجی اجرایی

    سرچاپ ال ال وی ام.سه‌تایی پیوند میزبان()، ال ال وی ام.ال ال دی در دسترس()
    سرچاپ ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-unknown-linux-musl")، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("x86_64-w64-windows-gnu")، ال ال وی ام.می‌توان سه‌تایی را پیوند داد("aarch64-apple-darwin")
    سرچاپ ال ال وی ام.پیونددهنده ای ال اف، ال ال وی ام.پیونددهنده مینگو، ال ال وی ام.پیونددهنده کاف، ال ال وی ام.پیونددهنده ماخ او، ال ال وی ام.پیونددهنده وسم
    ن := ال ال وی ام.پیوند خارجی(پوشه + "/salam_args.o"، پوشه + "/salam_args"، ال ال وی ام.تنظیمات پیش‌فرض())
    سرچاپ ن.ok، ن.err
    اگر ن.ok:
        سرچاپ سیستم عامل.اجرا(پوشه + "/salam_args x y")
    پایان

    ناپایا م := ال ال وی ام.تنظیمات پیش‌فرض()
    م.target_triple = "x86_64-unknown-linux-musl"
    سرچاپ ال ال وی ام.پیوند خودکار(پوشه + "/salam_args.o"، پوشه + "/salam_args_musl"، م).ok
    _ := ال ال وی ام.پیوند ای ال اف(پوشه + "/a.o"، پوشه + "/a"، م)
    _ := ال ال وی ام.پیوند مینگو(پوشه + "/a.o"، پوشه + "/a.exe"، م)
    _ := ال ال وی ام.پیوند وازی(پوشه + "/a.o"، پوشه + "/a.wasm"، م)
    ناپایا آرگ‌ها := حافظه.تخصیص(۶۴ برگردان طبیعی۶۴) برگردان رشته*
    آرگ‌ها[۰] = "ld.lld"
    آرگ‌ها[۱] = "--version"
    سرچاپ ال ال وی ام.پیوند(ال ال وی ام.پیونددهنده ای ال اف، آرگ‌ها برگردان تهی*، ۲)
    حافظه.آزادسازی(آرگ‌ها برگردان تهی*)
پایان
