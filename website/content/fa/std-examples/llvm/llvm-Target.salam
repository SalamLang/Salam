واردسازی ال ال وی ام
واردسازی سیستم عامل

روال ساختن(ز: ال ال وی ام.زمینه): ال ال وی ام.ماژول:
    م := ال ال وی ام.ماژول جدید(ز، "calc")
    س := ال ال وی ام.سازنده جدید(ز)
    ص۳۲ := ال ال وی ام.نوع سی‌ودو بیتی(ز)
    ناپایا دو := وکتور {} برگردان وکتور<ال ال وی ام.نوع>
    دو.بیفزا(ص۳۲)
    دو.بیفزا(ص۳۲)
    ت := ال ال وی ام.افزودن تابع(م، "salam_add"، ال ال وی ام.نوع تابع(ص۳۲، دو، نادرست))
    ال ال وی ام.قرار دادن در انتها(س، ال ال وی ام.افزودن بلوک(ز، ت، "entry"))
    _ := ال ال وی ام.بازگشت(س، ال ال وی ام.جمع(س، ال ال وی ام.پارامتر(ت، ۰)، ال ال وی ام.پارامتر(ت، ۱)، "s"))
    ال ال وی ام.آزادسازی سازنده(س)
    برگشت م
پایان

روال ریشه:
    ال ال وی ام.مقداردهی اهداف()
    سرچاپ ال ال وی ام.سه‌تایی پیش‌فرض().طول() > ۰
    سرچاپ ال ال وی ام.سطح تولید کد(ال ال وی ام.بهینه‌سازی دو) == ال ال وی ام.سطح تولید پیش‌فرض، ال ال وی ام.خط لوله پاس(ال ال وی ام.بهینه‌سازی سه)
    سرچاپ ال ال وی ام.بهینه‌سازی صفر، ال ال وی ام.بهینه‌سازی یک، ال ال وی ام.بهینه‌سازی اندازه، ال ال وی ام.بهینه‌سازی کمینه اندازه
    سرچاپ ال ال وی ام.سطح تولید بدون بهینه‌سازی، ال ال وی ام.سطح تولید کم، ال ال وی ام.سطح تولید تهاجمی
    سرچاپ ال ال وی ام.پرونده اسمبلی، ال ال وی ام.پرونده شیء، ال ال وی ام.جابجایی پیش‌فرض، ال ال وی ام.جابجایی مستقل از مکان، ال ال وی ام.مدل کد پیش‌فرض

    ن := ال ال وی ام.ماشین هدف جدید(""، ال ال وی ام.بهینه‌سازی دو، نادرست)
    اگر وارونه ن.ok:
        سرچاپ "ماشین هدف ساخته نشد:"، ن.err
        برگشت
    پایان
    ز := ال ال وی ام.زمینه جدید()
    م := ساختن(ز)
    ال ال وی ام.اعمال آرایش داده(م، ن.tm)
    ب := ال ال وی ام.اجرای بهینه‌سازی(م، ن.tm، ال ال وی ام.بهینه‌سازی دو)
    سرچاپ ب.ok
    پوشه := سیستم عامل.پوشه موقت()
    سرچاپ ال ال وی ام.تولید اسمبلی(م، ن.tm، پوشه + "/salam_add.s").ok
    سرچاپ ال ال وی ام.تولید شیء(م، ن.tm، پوشه + "/salam_add.o").ok
    سرچاپ ال ال وی ام.تولید بیت‌کد(م، پوشه + "/salam_add.bc").ok

    سرچاپ ال ال وی ام.کارهای موازی() > ۰
    بخش‌ها := ال ال وی ام.بخش‌های موازی(م، ۴)
    سرچاپ بخش‌ها >= ۱
    م۲ := ساختن(ز)
    پ := ال ال وی ام.بهینه‌سازی سپس تولید موازی(م۲، ن.tm، ال ال وی ام.بهینه‌سازی دو، ۲، پوشه + "/salam_part")
    سرچاپ پ.ok، پ.objects.طول() >= ۱
    ال ال وی ام.آزادسازی ماژول(م)
    ال ال وی ام.آزادسازی ماژول(م۲)
    ال ال وی ام.آزادسازی ماشین هدف(ن.tm)
    ال ال وی ام.آزادسازی زمینه(ز)
پایان
