واردسازی گزارش

تابع ریشه:
    گزارش.به خروجی استاندارد()
    گزارش.نمایش زمان(نادرست)
    ناپایا کلیدها := وکتور {} برگردان وکتور<رشته>
    ناپایا مقدارها := وکتور {} برگردان وکتور<رشته>
    دیرکن کلیدها.آزادکن()
    دیرکن مقدارها.آزادکن()
    کلیدها.بیفزا("user")
    مقدارها.بیفزا("sara")
    کلیدها.بیفزا("ms")
    مقدارها.بیفزا("42")
    گزارش.اطلاعات با فیلد("درخواست انجام شد"، کلیدها، مقدارها)
    گزارش.هشدار با فیلد("کند بود"، کلیدها، مقدارها)
    گزارش.خطا با فیلد("شکست خورد"، کلیدها، مقدارها)
    گزارش.تنظیم سطح(گزارش.سطح اشکال زدایی)
    گزارش.اشکال زدایی با فیلد("جزئیات"، کلیدها، مقدارها)
    گزارش.تنظیم قالب(گزارش.قالب جیسون)
    گزارش.اطلاعات("به شکل جیسون")
    سرچاپ گزارش.دریافت قالب() == گزارش.قالب جیسون، گزارش.قالب متن
    ناپایا ف := وکتور {} برگردان وکتور<رشته>
    دیرکن ف.آزادکن()
    ف.بیفزا(گزارش.فیلد("path"، "/login"))
    ف.بیفزا(گزارش.فیلد عدد("status"، ۲۰۰))
    ف.بیفزا(گزارش.فیلد منطقی("cached"، نادرست))
    سرچاپ گزارش.کلید مقدار("پاسخ"، ف)
پایان
