واردسازی ماتریس

روال ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

روال نشان(نام: رشته، م &: ماتریس.ماتریس):
    سرچاپ نام، ماتریس.به بازنمایی(ماتریس.حذف ریزه(م، ۰.۰۰۰۰۰۱)، ۳)
پایان

روال گ(عدد: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، عدد)، ۳)
پایان

روال ریشه:
    ناپایا متقارن := ساختن(۲، ۲، "2 1 1 2")
    ناپایا تجزیه := ماتریس.ویژه متقارن(متقارن)
    سرچاپ تجزیه.ok، تجزیه.n، تجزیه.sweeps >= ۰
    نشان("مقادیر"، تجزیه.values)
    نشان("بازسازی"، ماتریس.بازسازی ویژه(تجزیه))
    تجزیه.آزادسازی()
    نشان("مقادیر ویژه متقارن"، ماتریس.مقادیر ویژه متقارن(متقارن))
    سرچاپ گ(ماتریس.شعاع طیفی متقارن(متقارن))
    نشان("توان"، ماتریس.توان متقارن(متقارن، ۲.۰))
    نشان("جذر"، ماتریس.ضرب ماتریسی(ماتریس.جذر متقارن(متقارن)، ماتریس.جذر متقارن(متقارن)))

    ناپایا عمومی := ساختن(۲، ۲، "0 1 -2 -3")
    ناپایا ع := ماتریس.مقادیر ویژه(عمومی)
    سرچاپ ع.ok، ع.n، ماتریس.به بازنمایی(ع.re، ۳)، ماتریس.به بازنمایی(ع.im، ۳)، ع.iterations >= ۰
    ع.آزادسازی()
    ناپایا چرخش := ساختن(۲، ۲، "0 -1 1 0")
    ناپایا مختلط := ماتریس.مقادیر ویژه خودکار(چرخش)
    نشان("موهومی"، مختلط.im)
    سرچاپ گ(ماتریس.شعاع طیفی(عمومی))
    نشان("هسنبرگ"، ماتریس.هسنبرگ(ساختن(۳، ۳، "1 2 3 4 5 6 7 8 10")))
    نشان("مشخصه"، ماتریس.چندجمله‌ای مشخصه(عمومی))
    ناپایا بردار := ماتریس.بردار ویژه برای(متقارن، ۳.۰، ۵۰)
    نشان("بردار ویژه"، ماتریس.قدرمطلق(بردار))
    ناپایا توانی := ماتریس.تکرار توانی(متقارن، ۱۰۰)
    ناپایا غالب := ماتریس.زیرماتریس(توانی، ۰، ۰، ۲، ۱)
    سرچاپ گ(توانی.عنصر(۲، ۰))، گ(ماتریس.خارج‌قسمت ریلی(متقارن، غالب))، گ(ماتریس.تکرار وارون شیفت‌دار(متقارن، ۰.۹، ۵۰))

    ناپایا م := ساختن(۳، ۲، "3 0 0 4 0 0")
    ناپایا ت := ماتریس.تجزیه تکین(م)
    سرچاپ ت.ok، ماتریس.رشته شکل(ت.u)، ماتریس.رشته شکل(ت.v)
    نشان("مقادیر تکین"، ت.s)
    ت.آزادسازی()
    نشان("تکین"، ماتریس.مقادیر تکین(م))
    سرچاپ ماتریس.رتبه(م، ۰.۰۰۰۰۰۱)
    نشان("شبه‌وارون"، ماتریس.شبه‌وارون(م، ۰.۰۰۰۰۰۱))
    نشان("فضای تهی"، ماتریس.فضای تهی(ساختن(۲، ۲، "1 1 1 1")، ۰.۰۰۰۰۰۱))
    نشان("فضای ستونی"، ماتریس.قدرمطلق(ماتریس.فضای ستونی(ساختن(۲، ۲، "1 1 1 1")، ۰.۰۰۰۰۰۱)))
    نشان("رتبه پایین"، ماتریس.تقریب رتبه پایین(ساختن(۲، ۲، "3 0 0 1")، ۱))

    ت۰ := ۰.۰۰۰۰۰۱
    ناپایا همانی := ماتریس.همانی(۳)
    سرچاپ ماتریس.مربع است(همانی)، ماتریس.همه نزدیک(همانی، همانی، ت۰)، ماتریس.صفر است(ماتریس.صفرها(۲، ۲)، ت۰)، ماتریس.همانی است(همانی، ت۰)
    سرچاپ ماتریس.متقارن است(متقارن، ت۰)، ماتریس.پادمتقارن است(چرخش، ت۰)، ماتریس.قطری است(همانی، ت۰)
    سرچاپ ماتریس.بالامثلثی است(ساختن(۲، ۲، "1 2 0 3")، ت۰)، ماتریس.پایین‌مثلثی است(ساختن(۲، ۲، "1 0 2 3")، ت۰)
    ناپایا سه قطری := ساختن(۳، ۳، "2 1 0 1 2 1 0 1 2")
    سرچاپ ماتریس.نواری است(سه قطری، ۱، ۱، ت۰)، ماتریس.پهنای نوار پایین(سه قطری، ت۰)، ماتریس.پهنای نوار بالا(سه قطری، ت۰)
    سرچاپ ماتریس.متعامد است(چرخش، ت۰)، ماتریس.نرمال است(متقارن، ت۰)، ماتریس.خودتوان است(ساختن(۲، ۲، "1 0 0 0")، ت۰)
    سرچاپ ماتریس.خودوارون است(ساختن(۲، ۲، "0 1 1 0")، ت۰)، ماتریس.پوچ‌توان است(ساختن(۲، ۲، "0 1 0 0")، ت۰)
    سرچاپ ماتریس.معین مثبت است(متقارن، ت۰)، ماتریس.نیمه‌معین مثبت است(ساختن(۲، ۲، "1 1 1 1")، ت۰)
    سرچاپ ماتریس.تکین است(ساختن(۲، ۲، "1 2 2 4"))، ماتریس.وارون‌پذیر است(متقارن)
    ناپایا احتمال := ساختن(۲، ۲، "0.5 0.5 0.5 0.5")
    سرچاپ ماتریس.تصادفی سطری است(احتمال، ت۰)، ماتریس.تصادفی ستونی است(احتمال، ت۰)، ماتریس.تصادفی دوگانه است(احتمال، ت۰)
    سرچاپ ماتریس.جایگشتی است(ساختن(۲، ۲، "0 1 1 0")، ت۰)، ماتریس.توپلیتز است(سه قطری، ت۰)، ماتریس.هنکل است(ساختن(۲، ۲، "1 2 2 3")، ت۰)
    سرچاپ گ(ماتریس.چگالی(سه قطری))
پایان
