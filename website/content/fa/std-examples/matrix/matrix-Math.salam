واردسازی ماتریس

روال ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

روال نشان(نام: رشته، م &: ماتریس.ماتریس):
    سرچاپ نام، ماتریس.به بازنمایی(م، ۱)
پایان

روال گ(عدد: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، عدد)، ۳)
پایان

روال ریشه:
    ناپایا الف := ساختن(۲، ۲، "1 2 3 4")
    ناپایا ب := ساختن(۲، ۲، "0 1 1 0")
    ناپایا ر := ساختن(۱، ۲، "10 20")
    ناپایا س := ساختن(۲، ۱، "1 -1")
    نشان("ترانهاده"، ماتریس.ترانهاده(الف))
    نشان("ضرب"، ماتریس.ضرب ماتریسی(الف، ب))
    ناپایا خروجی := ماتریس.صفرها(۲، ۲)
    سرچاپ ماتریس.ترانهاده در(الف، خروجی)، ماتریس.ضرب ماتریسی در(الف، ب، خروجی)
    نشان("در"، خروجی)
    نشان("ضرب ترانهاده"، ماتریس.ضرب ترانهاده(الف، ب))
    نشان("ضرب در ترانهاده"، ماتریس.ضرب در ترانهاده(الف، ب))
    نشان("گرام"، ماتریس.گرام(الف))
    نشان("ماتریس در بردار"، ماتریس.ضرب در بردار(الف، س))
    نشان("بردار در ماتریس"، ماتریس.ضرب بردار در ماتریس(ر، الف))
    سرچاپ ماتریس.ضرب داخلی(س، س)، ماتریس.رد(الف)
    نشان("خارجی"، ماتریس.ضرب خارجی(س، س))
    نشان("کرونکر"، ماتریس.ضرب کرونکر(ماتریس.همانی(۲)، ماتریس.پرشده(۱، ۲، ۳.۰)))
    نشان("توان"، ماتریس.توان ماتریس(الف، ۲))
    نشان("برداری"، ماتریس.ضرب برداری(ساختن(۳، ۱، "1 0 0")، ساختن(۳، ۱، "0 1 0")))

    نشان("جمع"، ماتریس.جمع(الف، ب))
    نشان("تفریق"، ماتریس.تفریق(الف، ب))
    نشان("ضرب درایه‌ای"، ماتریس.ضرب درایه‌ای(الف، ب))
    نشان("تقسیم درایه‌ای"، ماتریس.تقسیم درایه‌ای(الف، الف))
    نشان("قرینه"، ماتریس.قرینه(الف))
    نشان("با عدد"، ماتریس.جمع با عدد(ماتریس.تفریق عدد(ماتریس.مقیاس(ماتریس.تقسیم با عدد(الف، ۲.۰)، ۴.۰)، ۱.۰)، ۱.۰))
    ناپایا ج := ماتریس.همانند(الف)
    ماتریس.جمع درجا(ج، ب)
    ماتریس.تفریق درجا(ج، ب)
    ماتریس.ضرب درایه‌ای درجا(ج، الف)
    ماتریس.مقیاس درجا(ج، ۰.۵)
    ماتریس.جمع عدد درجا(ج، ۱.۰)
    ماتریس.قرینه درجا(ج)
    ماتریس.جمع مقیاس‌دار(ج، الف، ۲.۰)
    نشان("درجا"، ج)
    نشان("ترکیب"، ماتریس.ترکیب(الف، ۲.۰، ب، -۱.۰))
    نشان("بیشینه درایه‌ای"، ماتریس.بیشینه درایه‌ای(الف، ماتریس.پرشده(۲، ۲، ۲.۵)))
    نشان("کمینه درایه‌ای"، ماتریس.کمینه درایه‌ای(الف، ماتریس.پرشده(۲، ۲، ۲.۵)))
    نشان("جمع سطری"، ماتریس.جمع بردار سطری(الف، ر))
    نشان("جمع ستونی"، ماتریس.جمع بردار ستونی(الف، س))
    نشان("ضرب سطری"، ماتریس.ضرب بردار سطری(الف، ر))
    نشان("ضرب ستونی"، ماتریس.ضرب بردار ستونی(الف، س))

    ناپایا م := ساختن(۱، ۴، "-2.25 0 0.5 9")
    نشان("قدرمطلق"، ماتریس.قدرمطلق(م))
    نشان("جذر"، ماتریس.جذر(ماتریس.قدرمطلق(م)))
    نشان("ریشه سوم"، ماتریس.ریشه سوم(ساختن(۱، ۲، "8 -27")))
    نشان("کف و سقف"، ماتریس.چینش افقی(ماتریس.کف(م)، ماتریس.سقف(م)))
    نشان("گرد و برش"، ماتریس.چینش افقی(ماتریس.گرد(م)، ماتریس.برش(م)))
    نشان("علامت"، ماتریس.علامت(م))
    نشان("مربع"، ماتریس.مربع(م))
    نشان("وارون درایه‌ای"، ماتریس.وارون درایه‌ای(ساختن(۱، ۲، "2 4")))
    نشان("توان درایه‌ای"، ماتریس.توان درایه‌ای(ساختن(۱، ۲، "2 3")، ۳.۰))
    نشان("برش بازه"، ماتریس.برش بازه(م، ۰.۰، ۱.۰))
    نشان("با عدد"، ماتریس.چینش افقی(ماتریس.بیشینه با عدد(م، ۰.۰)، ماتریس.کمینه با عدد(م، ۰.۰)))
    نشان("حذف ریزه"، ماتریس.حذف ریزه(ساختن(۱، ۲، "0.0000001 1")، ۰.۰۰۰۱))
    ناپایا صفر := ماتریس.صفرها(۱، ۱)
    سرچاپ ماتریس.به رشته با دقت(ماتریس.چینش افقی(ماتریس.نمایی(صفر)، ماتریس.لگاریتم(ماتریس.یک‌ها(۱، ۱)))، ۳)، ماتریس.به رشته با دقت(ماتریس.لگاریتم ده(ماتریس.پرشده(۱، ۱، ۱۰۰.۰))، ۳)، ماتریس.به رشته با دقت(ماتریس.لگاریتم دو(ماتریس.پرشده(۱، ۱، ۸.۰))، ۳)
    سرچاپ ماتریس.به رشته با دقت(ماتریس.چینش افقی(ماتریس.سینوس(صفر)، ماتریس.کسینوس(صفر))، ۳)، ماتریس.به رشته با دقت(ماتریس.تانژانت(صفر)، ۳)
    سرچاپ ماتریس.به رشته با دقت(ماتریس.چینش افقی(ماتریس.وارون سینوس(صفر)، ماتریس.وارون کسینوس(ماتریس.یک‌ها(۱، ۱)))، ۳)، ماتریس.به رشته با دقت(ماتریس.وارون تانژانت(صفر)، ۳)
    سرچاپ ماتریس.به رشته با دقت(ماتریس.چینش افقی(ماتریس.سینوس هذلولی(صفر)، ماتریس.کسینوس هذلولی(صفر))، ۳)، ماتریس.به رشته با دقت(ماتریس.تانژانت هذلولی(صفر)، ۳)

    سرچاپ ماتریس.مجموع(الف)، ماتریس.حاصل‌ضرب(الف)، ماتریس.میانگین(الف)، ماتریس.کمینه(الف)، ماتریس.بیشینه(الف)، ماتریس.دامنه(الف)
    ش := ماتریس.اندیس بیشینه(الف)
    سرچاپ ماتریس.اندیس کمینه(الف)، ش، ماتریس.سطر اندیس(الف، ش)، ماتریس.ستون اندیس(الف، ش)، ماتریس.بیشینه قدرمطلق(م)
    سرچاپ گ(ماتریس.واریانس(الف، درست))، گ(ماتریس.انحراف معیار(الف، نادرست))، ماتریس.میانه(الف)
    نشان("مجموع سطرها"، ماتریس.مجموع سطرها(الف))
    نشان("مجموع ستون‌ها"، ماتریس.مجموع ستون‌ها(الف))
    نشان("میانگین سطرها"، ماتریس.میانگین سطرها(الف))
    نشان("میانگین ستون‌ها"، ماتریس.میانگین ستون‌ها(الف))
    نشان("کمینه و بیشینه سطرها"، ماتریس.چینش افقی(ماتریس.کمینه سطرها(الف)، ماتریس.بیشینه سطرها(الف)))
    نشان("کمینه و بیشینه ستون‌ها"، ماتریس.چینش عمودی(ماتریس.کمینه ستون‌ها(الف)، ماتریس.بیشینه ستون‌ها(الف)))
    نشان("تجمعی"، ماتریس.چینش افقی(ماتریس.مجموع تجمعی سطری(الف)، ماتریس.مجموع تجمعی ستونی(الف)))
    نشان("ضرب تجمعی"، ماتریس.ضرب تجمعی سطری(الف))
    سرچاپ ماتریس.شمار ناصفر(ب)، ماتریس.هر(ب)، ماتریس.همه(ب)، ماتریس.همه متناهی(ب)

    سرچاپ گ(ماتریس.نرم فروبنیوس(الف))، ماتریس.نرم یک(الف)، ماتریس.نرم بی‌نهایت(الف)، ماتریس.نرم بیشینه(الف)
    سرچاپ گ(ماتریس.نرم دو(الف))، گ(ماتریس.نرم هسته‌ای(الف))، ماتریس.نرم بردار(س، ۱.۰)، گ(ماتریس.فاصله(س، ماتریس.صفرها(۲، ۱)))
    نشان("بهنجار"، ماتریس.بهنجارسازی(ساختن(۱، ۲، "3 4")))
    سرچاپ ماتریس.به رشته با دقت(ماتریس.بهنجارسازی سطرها(الف)، ۲)
    سرچاپ ماتریس.به رشته با دقت(ماتریس.بهنجارسازی ستون‌ها(الف)، ۲)
    سرچاپ گ(ماتریس.شرط یک(الف))، گ(ماتریس.شرط بی‌نهایت(الف))، گ(ماتریس.شرط دو(الف))
پایان
