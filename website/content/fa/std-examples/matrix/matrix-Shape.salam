واردسازی ماتریس

تابع ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع نشان(نام: رشته، م &: ماتریس.ماتریس):
    سرچاپ نام، ماتریس.به بازنمایی(م، ۱)
پایان

تابع ریشه:
    ناپایا الف := ساختن(۲، ۳، "1 2 3 4 5 6")
    ناپایا مربعی := ساختن(۳، ۳، "1 2 3 4 5 6 7 8 9")
    نشان("تغییر شکل"، ماتریس.تغییر شکل(الف، ۳، ۲))
    نشان("تخت"، ماتریس.تخت‌سازی(الف))
    نشان("تخت ستونی"، ماتریس.تخت‌سازی ستونی(الف))
    ناپایا سطر := ماتریس.سطر(الف، ۱)
    ناپایا ستون := ماتریس.ستون(الف، ۲)
    نشان("سطر"، سطر)
    نشان("ستون"، ستون)
    ناپایا ب := ماتریس.همانند(الف)
    ماتریس.تنظیم سطر(ب، ۰، سطر)
    ماتریس.تنظیم ستون(ب، ۰، ستون)
    نشان("تنظیم"، ب)
    نشان("زیرماتریس"، ماتریس.زیرماتریس(مربعی، ۱، ۱، ۲، ۲))
    نشان("کهاد"، ماتریس.کهاد(مربعی، ۰، ۰))
    نشان("حذف سطر"، ماتریس.حذف سطر(مربعی، ۱))
    نشان("حذف ستون"، ماتریس.حذف ستون(مربعی، ۱))
    نشان("درج سطر"، ماتریس.درج سطر(الف، ۱، ماتریس.سطر(الف، ۰)))
    نشان("درج ستون"، ماتریس.درج ستون(الف، ۰، ماتریس.ستون(الف، ۲)))
    ماتریس.تعویض سطر(ب، ۰، ۱)
    ماتریس.تعویض ستون(ب، ۰، ۲)
    نشان("تعویض"، ب)
    نشان("قطر"، ماتریس.قطر(مربعی))
    نشان("قطر جابه‌جا"، ماتریس.قطر جابه‌جا(مربعی، ۱))
    ناپایا ج := ماتریس.همانند(مربعی)
    ماتریس.تنظیم قطر(ج، ماتریس.یک‌ها(۳، ۱))
    ماتریس.افزودن به قطر(ج، ۱۰.۰)
    نشان("قطر تازه"، ماتریس.قطر(ج))
    نشان("افقی"، ماتریس.چینش افقی(الف، الف))
    نشان("عمودی"، ماتریس.چینش عمودی(الف، الف))
    نشان("افزوده"، ماتریس.افزوده(مربعی، ماتریس.همانی(۳)))
    نشان("قطری بلوکی"، ماتریس.قطری بلوکی(ماتریس.همانی(۱)، ماتریس.پرشده(۱، ۱، ۲.۰)))
    نشان("بالامثلثی"، ماتریس.بالامثلثی(مربعی، ۰))
    نشان("پایین‌مثلثی"، ماتریس.پایین‌مثلثی(مربعی، -۱))
    نشان("متقارن‌سازی"، ماتریس.متقارن‌سازی بالا(مربعی))
    نشان("بخش متقارن"، ماتریس.بخش متقارن(مربعی))
    نشان("پادمتقارن"، ماتریس.بخش پادمتقارن(مربعی))
    نشان("برعکس عمودی"، ماتریس.برعکس عمودی(الف))
    نشان("برعکس افقی"، ماتریس.برعکس افقی(الف))
    نشان("چرخش"، ماتریس.چرخش نود(الف، ۱))
    نشان("دوری"، ماتریس.چرخش دوری(الف، ۰، ۱))
    نشان("کاشی"، ماتریس.کاشی‌کاری(ماتریس.همانی(۱)، ۲، ۲))
    نشان("لبه"، ماتریس.لبه‌گذاری(ماتریس.همانی(۱)، ۱، ۰، ۰، ۱، ۹.۰))
پایان
