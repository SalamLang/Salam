واردسازی ماتریس

روال ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

روال نشان(نام: رشته، م &: ماتریس.ماتریس):
    سرچاپ نام، ماتریس.به بازنمایی(ماتریس.حذف ریزه(م، ۰.۰۰۰۰۰۱)، ۳)
پایان

روال گ(عدد: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، عدد)، ۳)
پایان

روال ریشه:
    ناپایا الف := ساختن(۳، ۳، "4 1 0 1 3 1 0 1 2")
    ناپایا ب := ساختن(۳، ۱، "1 2 3")
    سرچاپ گ(ماتریس.دترمینان(الف))، گ(ماتریس.لگاریتم قدرمطلق دترمینان(الف))
    نشان("حل"، ماتریس.حل(الف، ب))
    نشان("حل برداری"، ماتریس.حل برداری(الف، ب))
    ناپایا تجزیه := ماتریس.تجزیه(الف)
    سرچاپ تجزیه.n، تجزیه.piv.طول()، تجزیه.sign، تجزیه.singular، ماتریس.رشته شکل(تجزیه.lu)
    نشان("با تجزیه"، ماتریس.حل با تجزیه(تجزیه، ب))
    تجزیه.آزادسازی()
    ناپایا وارون := ماتریس.وارون(الف)
    نشان("الف در وارون"، ماتریس.ضرب ماتریسی(الف، وارون))
    نشان("الحاقی"، ماتریس.الحاقی(ساختن(۲، ۲، "1 2 3 4")))
    نشان("باقیمانده"، ماتریس.باقیمانده(الف، ماتریس.حل(الف، ب)، ب))

    ناپایا کیوآر := ماتریس.تجزیه کیوآر(الف)
    سرچاپ کیوآر.m، کیوآر.n، کیوآر.full_rank، ماتریس.رشته شکل(کیوآر.qr)، ماتریس.رشته شکل(کیوآر.rdiag)
    نشان("کیو در آر"، ماتریس.ضرب ماتریسی(ماتریس.کیو(کیوآر)، ماتریس.آر(کیوآر)))
    نشان("حل کیوآر"، ماتریس.حل کیوآر(کیوآر، ب))
    کیوآر.آزادسازی()
    ناپایا نقاط := ساختن(۴، ۲، "1 0 1 1 1 2 1 3")
    ناپایا مقادیر := ساختن(۴، ۱، "1 3 5 7")
    نشان("کمترین مربعات"، ماتریس.کمترین مربعات(نقاط، مقادیر))
    نشان("متعامد"، ماتریس.گرام(ماتریس.متعامدسازی(نقاط)))

    نشان("چولسکی"، ماتریس.چولسکی(الف))
    نشان("حل معین مثبت"، ماتریس.حل معین مثبت(الف، ب))
    نشان("حل چولسکی"، ماتریس.حل چولسکی(ماتریس.چولسکی(الف)، ب))
    نشان("وارون معین مثبت"، ماتریس.ضرب ماتریسی(الف، ماتریس.وارون معین مثبت(الف)))
    سرچاپ گ(ماتریس.دترمینان معین مثبت(الف))، گ(ماتریس.لگاریتم دترمینان معین مثبت(الف))
    ناپایا ال := ماتریس.تجزیه ال‌دی‌ال(الف)
    سرچاپ ال.ok، ال.n، ماتریس.رشته شکل(ال.l)، ماتریس.رشته شکل(ال.d)
    نشان("حل ال‌دی‌ال"، ماتریس.حل ال‌دی‌ال(ال، ب))
    ال.آزادسازی()
    نشان("لختی"، ماتریس.لختی(ساختن(۲، ۲، "1 0 0 -1")))

    ناپایا تکین := ساختن(۳، ۳، "1 2 3 2 4 6 1 1 1")
    نشان("پلکانی"، ماتریس.پلکانی سطری(تکین))
    نشان("کاهش‌یافته"، ماتریس.پلکانی کاهش‌یافته(تکین))
    نشان("ستون‌های محوری"، ماتریس.ستون‌های محوری(تکین))
    سرچاپ ماتریس.رتبه دقیق(تکین)، ماتریس.پوچی(تکین)
    نشان("فضای تهی"، ماتریس.فضای تهی دقیق(تکین))
    نشان("فضای ستونی"، ماتریس.فضای ستونی دقیق(تکین))
    ناپایا راست := ساختن(۳، ۱، "6 12 3")
    سرچاپ ماتریس.سازگار است(تکین، راست)، ماتریس.سازگار است(تکین، ساختن(۳، ۱، "1 3 3"))
    نشان("حل عمومی"، ماتریس.حل عمومی(تکین، راست))

    سرچاپ ماتریس.غالب قطری است(الف)
    ناپایا ژ := ماتریس.حل ژاکوبی(الف، ب، ۲۰۰، ۰.۰۰۰۰۰۰۰۱)
    سرچاپ ژ.converged، ژ.iterations > ۰، ژ.residual < ۰.۰۰۰۱
    نشان("ژاکوبی"، ژ.x)
    ژ.آزادسازی()
    هر روش در [۱، ۲، ۳]:
        ناپایا ن := ماتریس.حل گاوس زایدل(الف، ب، ۲۰۰، ۰.۰۰۰۰۰۰۰۱)
        اگر روش == ۲:
            ن = ماتریس.حل فوق‌آسایش(الف، ب، ۱.۲، ۲۰۰، ۰.۰۰۰۰۰۰۰۱)
        وگرنه روش == ۳:
            ن = ماتریس.حل گرادیان مزدوج(الف، ب، ۲۰۰، ۰.۰۰۰۰۰۰۰۱)
        پایان
        نشان("تکراری"، ن.x)
        ن.آزادسازی()
    پایان

    ناپایا ک := ساختن(۲، ۲، "1 0 0 2")
    نشان("نمایی"، ماتریس.نمایی ماتریسی(ماتریس.صفرها(۲، ۲)))
    نشان("جذر"، ماتریس.جذر ماتریسی(ساختن(۲، ۲، "4 0 0 9")))
    نشان("علامت"، ماتریس.علامت ماتریسی(ساختن(۲، ۲، "2 0 0 -3")))
    نشان("چندجمله‌ای"، ماتریس.ارزیابی چندجمله‌ای(ک، ساختن(۱، ۳، "1 0 1")))
    نشان("کیلی همیلتون"، ماتریس.کیلی همیلتون(ک))
    نشان("لگاریتم"، ماتریس.لگاریتم متقارن(ماتریس.همانی(۲)))
پایان
