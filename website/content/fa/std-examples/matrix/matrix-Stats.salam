واردسازی ماتریس

تابع ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع نشان(نام: رشته، م &: ماتریس.ماتریس):
    سرچاپ نام، ماتریس.به بازنمایی(ماتریس.حذف ریزه(م، ۰.۰۰۰۰۰۱)، ۳)
پایان

تابع گ(عدد: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، عدد)، ۳)
پایان

تابع ریشه:
    نشان("هیلبرت"، ماتریس.هیلبرت(۲))
    نشان("هیلبرت در وارون"، ماتریس.ضرب ماتریسی(ماتریس.هیلبرت(۳)، ماتریس.وارون هیلبرت(۳)))
    نشان("واندرموند"، ماتریس.واندرموند(ساختن(۳، ۱، "1 2 3")، ۳))
    نشان("توپلیتز"، ماتریس.توپلیتز(ساختن(۳، ۱، "1 2 3")، ساختن(۱، ۳، "1 4 5")))
    نشان("هنکل"، ماتریس.هنکل(ساختن(۳، ۱، "1 2 3")، ساختن(۱، ۳، "3 4 5")))
    نشان("دورانی"، ماتریس.دورانی(ساختن(۱، ۳، "1 2 3")))
    نشان("همراه"، ماتریس.همراه(ساختن(۱، ۳، "1 -3 2")))
    نشان("پاسکال"، ماتریس.پاسکال(۳))
    نشان("دوران"، ماتریس.دوران دوبعدی(۰.۰))
    نشان("دوران سه‌بعدی"، ماتریس.دوران سه‌بعدی(۲، ۰.۰))
    نشان("هاوس‌هولدر"، ماتریس.هاوس‌هولدر(ساختن(۲، ۱، "1 0")))
    نشان("گیونز"، ماتریس.گیونز(۲، ۰، ۱، ۰.۰))
    نشان("جایگشت"، ماتریس.جایگشت(ساختن(۱، ۳، "2 0 1")))

    ناپایا مولد := ماتریس.مولد جدید(۷)
    سرچاپ مولد.بیت بعدی() > ۰، مولد.اعشاری بعدی() < ۱.۰، مولد.نرمال بعدی() < ۱۰.۰
    ناپایا ت := ماتریس.تصادفی(۲، ۳، -۱.۰، ۱.۰، ۵)
    سرچاپ ماتریس.رشته شکل(ت)، ماتریس.کمینه(ت) >= -۱.۰، ماتریس.بیشینه(ت) < ۱.۰، ماتریس.همه نزدیک(ت، ماتریس.تصادفی(۲، ۳، -۱.۰، ۱.۰، ۵)، ۰.۰)
    سرچاپ ماتریس.رشته شکل(ماتریس.تصادفی نرمال(۲، ۲، ۱))
    سرچاپ ماتریس.متقارن است(ماتریس.تصادفی متقارن(۳، ۱)، ۰.۰۰۰۰۰۱)، ماتریس.معین مثبت است(ماتریس.تصادفی معین مثبت(۳، ۱)، ۰.۰۰۰۰۰۱)، ماتریس.متعامد است(ماتریس.تصادفی متعامد(۳، ۱)، ۰.۰۰۰۰۱)

    ناپایا داده := ساختن(۴، ۲، "1 2 2 4 3 6 4 8")
    نشان("مرکزی"، ماتریس.مرکزی‌سازی ستون‌ها(داده))
    نشان("میانگین ستونی"، ماتریس.میانگین ستونی(داده))
    نشان("انحراف معیار"، ماتریس.انحراف معیار ستون‌ها(داده، نادرست))
    نشان("استاندارد"، ماتریس.استانداردسازی(داده، نادرست))
    نشان("کوواریانس"، ماتریس.کوواریانس(داده، درست))
    نشان("همبستگی"، ماتریس.همبستگی(داده))
    ناپایا پی := ماتریس.برازش مولفه اصلی(داده)
    سرچاپ ماتریس.رشته شکل(پی.components)، ماتریس.رشته شکل(پی.variances)، ماتریس.رشته شکل(پی.center)
    نشان("واریانس تبیین‌شده"، ماتریس.واریانس تبیین‌شده(پی))
    نشان("تبدیل"، ماتریس.قدرمطلق(ماتریس.تبدیل مولفه اصلی(پی، داده، ۱)))
    پی.آزادسازی()
    ناپایا پی۲ := ماتریس.مولفه اصلی از تجزیه تکین(داده)
    نشان("از تجزیه تکین"، ماتریس.واریانس تبیین‌شده(پی۲))
    پی۲.آزادسازی()

    ناپایا ایکس := ساختن(۴، ۱، "1 2 3 4")
    ناپایا وای := ساختن(۴، ۱، "3 5 7 9")
    ضریب := ماتریس.رگرسیون خطی(ایکس، وای)
    نشان("رگرسیون"، ضریب)
    سرچاپ گ(ماتریس.آر دو(وای، وای))
پایان
