واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    الف := متاتریدر.دریافت اطلاعات حساب()
    اگر وارونه متاتریدر.موفق():
        عنصر := متاتریدر.آخرین خطا()
        نادرست‌سرچاپ "account failed:"، عنصر.کد، عنصر.توضیح
        برگشت 1
    پایان
    سرچاپ الف.شناسه ورود، الف.نام، الف.سرور، الف.ارز
    سرچاپ "balance"، الف.موجودی، "equity"، الف.دارایی خالص
    سرچاپ "margin"، الف.حاشیه، "free"، الف.حاشیه آزاد، "level"، الف.سطح حاشیه
    سرچاپ "leverage"، الف.اهرم، "limit"، الف.سقف سفارش
    اگر الف.معامله مجاز:
        سرچاپ "trading is allowed"
    پایان

    موقت := متاتریدر.دریافت اطلاعات ترمینال()
    سرچاپ موقت.شرکت، موقت.نام، موقت.شماره ساخت، موقت.متصل
    سرچاپ موقت.مسیر
    سرچاپ موقت.مسیر داده
    برگشت 0
پایان
