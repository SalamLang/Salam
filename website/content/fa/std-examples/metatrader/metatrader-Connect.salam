واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")
    سرچاپ متاتریدر.نشانی پل()

    اگر وارونه متاتریدر.آغاز(""، 12345678 برگردان صحیح۶۴، "secret"، "Broker-Demo"، 60000، نادرست):
        عنصر := متاتریدر.آخرین خطا()
        نادرست‌سرچاپ "initialize failed:"، عنصر.کد، عنصر.توضیح
        برگشت 1
    پایان
    اگر وارونه متاتریدر.ورود(12345678 برگردان صحیح۶۴، "secret"، "Broker-Demo"، 60000):
        عنصر := متاتریدر.آخرین خطا()
        نادرست‌سرچاپ "login failed:"، عنصر.کد، عنصر.توضیح
        برگشت 1
    پایان

    مقدار_محلی := متاتریدر.نسخه()
    سرچاپ "connected:"، متاتریدر.متصل است()
    سرچاپ "terminal:"، مقدار_محلی.نسخه ترمینال، "build"، مقدار_محلی.شماره ساخت، مقدار_محلی.تاریخ انتشار ساخت
    اگر وارونه متاتریدر.موفق():
        عنصر := متاتریدر.آخرین خطا()
        نادرست‌سرچاپ عنصر.کد، عنصر.توضیح
    پایان

    متاتریدر.پایان()
    برگشت 0
پایان
