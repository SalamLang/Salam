واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")
    سرچاپ متاتریدر.نشانی پل()

    اگر وارونه متاتریدر.آغاز(""، 12345678 برگردان صحیح۶۴، "secret"، "Broker-Demo"، 60000، نادرست):
        e := متاتریدر.آخرین خطا()
        نادرست‌سرچاپ "initialize failed:"، e.کد، e.توضیح
        برگشت 1
    پایان
    اگر وارونه متاتریدر.ورود(12345678 برگردان صحیح۶۴، "secret"، "Broker-Demo"، 60000):
        e := متاتریدر.آخرین خطا()
        نادرست‌سرچاپ "login failed:"، e.کد، e.توضیح
        برگشت 1
    پایان

    v := متاتریدر.نسخه()
    سرچاپ "connected:"، متاتریدر.متصل است()
    سرچاپ "terminal:"، v.نسخه ترمینال، "build"، v.شماره ساخت، v.تاریخ انتشار ساخت
    اگر وارونه متاتریدر.موفق():
        e := متاتریدر.آخرین خطا()
        نادرست‌سرچاپ e.کد، e.توضیح
    پایان

    متاتریدر.پایان()
    برگشت 0
پایان
