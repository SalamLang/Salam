واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    date_from := 1700000000 برگردان صحیح۶۴
    date_to := 1700086400 برگردان صحیح۶۴

    سرچاپ "orders:"، متاتریدر.تعداد سفارش‌های تاریخچه(date_from، date_to)
    هر o در متاتریدر.دریافت سفارش‌های تاریخچه(date_from، date_to):
        سرچاپ o.شماره تیکت، o.نماد، o.وضعیت، o.حجم اولیه، o.قیمت ورود
    پایان

    سرچاپ "deals:"، متاتریدر.تعداد معامله‌های تاریخچه(date_from، date_to)
    هر d در متاتریدر.دریافت معامله‌های تاریخچه(date_from، date_to):
        سرچاپ d.شماره تیکت، d.شماره سفارش، d.شناسه پوزیشن، d.نوع معامله، d.نوع ورود، d.سود، d.کمیسیون، d.سواپ
    پایان

    اگر متاتریدر.افزودن دفتر سفارش("EURUSD"):
        هر b در متاتریدر.دریافت دفتر سفارش("EURUSD"):
            سرچاپ b.نوع سطح دفتر، b.قیمت، b.حجم
        پایان
        متاتریدر.آزادسازی دفتر سفارش("EURUSD")
    پایان
    برگشت 0
پایان
