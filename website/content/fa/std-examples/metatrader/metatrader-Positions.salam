واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    سرچاپ "orders:"، متاتریدر.تعداد سفارش‌های فعال()
    هر او در متاتریدر.دریافت سفارش‌های فعال():
        سرچاپ او.شماره تیکت، او.نماد، او.نوع سفارش، او.وضعیت، او.حجم فعلی، او.قیمت ورود
    پایان
    سرچاپ "EURUSD orders:"، متاتریدر.دریافت سفارش‌های فعال با نماد("EURUSD").طول()
    سرچاپ "USD orders:"، متاتریدر.دریافت سفارش‌های فعال با گروه("*USD*").طول()
    سفارش های معلق := متاتریدر.دریافت سفارش فعال با شماره(1001 برگردان صحیح۶۴)
    اگر سفارش های معلق.طول() بزرگتر 0:
        سرچاپ "order 1001:"، سفارش های معلق.بگیر(0).نماد، سفارش های معلق.بگیر(0).قیمت ورود
    پایان

    سرچاپ "positions:"، متاتریدر.تعداد پوزیشن‌های باز()
    هر ویژگی_محلی در متاتریدر.دریافت پوزیشن‌های باز():
        سرچاپ ویژگی_محلی.شماره تیکت، ویژگی_محلی.نماد، ویژگی_محلی.نوع پوزیشن، ویژگی_محلی.حجم، ویژگی_محلی.قیمت ورود، ویژگی_محلی.سود
    پایان
    سرچاپ "EURUSD positions:"، متاتریدر.دریافت پوزیشن‌های باز با نماد("EURUSD").طول()
    سرچاپ "USD positions:"، متاتریدر.دریافت پوزیشن‌های باز با گروه("*USD*").طول()
    پوزیشن گشوده := متاتریدر.دریافت پوزیشن باز با شماره(2001 برگردان صحیح۶۴)
    اگر پوزیشن گشوده.طول() بزرگتر 0:
        سرچاپ "position 2001:"، پوزیشن گشوده.بگیر(0).نماد، پوزیشن گشوده.بگیر(0).سود
    پایان
    برگشت 0
پایان
