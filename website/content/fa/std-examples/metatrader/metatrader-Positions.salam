واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    سرچاپ "orders:"، متاتریدر.تعداد سفارش‌های فعال()
    هر o در متاتریدر.دریافت سفارش‌های فعال():
        سرچاپ o.شماره تیکت، o.نماد، o.نوع سفارش، o.وضعیت، o.حجم فعلی، o.قیمت ورود
    پایان
    سرچاپ "EURUSD orders:"، متاتریدر.دریافت سفارش‌های فعال با نماد("EURUSD").طول()
    سرچاپ "USD orders:"، متاتریدر.دریافت سفارش‌های فعال با گروه("*USD*").طول()
    pending := متاتریدر.دریافت سفارش فعال با شماره(1001 برگردان صحیح۶۴)
    اگر pending.طول() بزرگتر 0:
        سرچاپ "order 1001:"، pending.بگیر(0).نماد، pending.بگیر(0).قیمت ورود
    پایان

    سرچاپ "positions:"، متاتریدر.تعداد پوزیشن‌های باز()
    هر p در متاتریدر.دریافت پوزیشن‌های باز():
        سرچاپ p.شماره تیکت، p.نماد، p.نوع پوزیشن، p.حجم، p.قیمت ورود، p.سود
    پایان
    سرچاپ "EURUSD positions:"، متاتریدر.دریافت پوزیشن‌های باز با نماد("EURUSD").طول()
    سرچاپ "USD positions:"، متاتریدر.دریافت پوزیشن‌های باز با گروه("*USD*").طول()
    open := متاتریدر.دریافت پوزیشن باز با شماره(2001 برگردان صحیح۶۴)
    اگر open.طول() بزرگتر 0:
        سرچاپ "position 2001:"، open.بگیر(0).نماد، open.بگیر(0).سود
    پایان
    برگشت 0
پایان
