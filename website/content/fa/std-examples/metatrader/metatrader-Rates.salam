واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    کندل ها := متاتریدر.کپی کندل‌ها از تاریخ("EURUSD"، متاتریدر.بازه یک ساعت، 1700000000 برگردان صحیح۶۴، 10)
    هر r در کندل ها:
        سرچاپ r.زمان، r.قیمت باز، r.بیشترین قیمت، r.کمترین قیمت، r.قیمت‌بسته، r.حجم تیک
    پایان

    کندل های اخیر := متاتریدر.کپی کندل‌ها از موقعیت("EURUSD"، متاتریدر.بازه پنج دقیقه، 0، 5)
    سرچاپ "recent:"، کندل های اخیر.طول()

    کندل های بازه := متاتریدر.کپی‌کندل‌ها‌در‌بازه("EURUSD"، متاتریدر.بازه یک روز، 1700000000 برگردان صحیح۶۴، 1700086400 برگردان صحیح۶۴)
    سرچاپ "daily:"، کندل های بازه.طول()

    نوسان ها := متاتریدر.کپی نوسانات از تاریخ("EURUSD"، 1700000000 برگردان صحیح۶۴، 100، متاتریدر.تمام نوسانات قیمت)
    هر t در نوسان ها:
        سرچاپ t.زمان به میلی‌ثانیه، t.قیمت خرید، t.قیمت فروش، t.آخرین قیمت، t.پرچم‌ها
    پایان

    نوسان های معاملاتی := متاتریدر.کپی‌نوسانات‌در‌بازه("EURUSD"، 1700000000000 برگردان صحیح۶۴، 1700000600000 برگردان صحیح۶۴، متاتریدر.نوسانات قیمت معاملاتی)
    سرچاپ "trade ticks:"، نوسان های معاملاتی.طول()
    برگشت 0
پایان
