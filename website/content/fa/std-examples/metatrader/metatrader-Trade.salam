واردسازی متاتریدر

تابع ریشه:
    متاتریدر.تنظیم نشانی پل("http://127.0.0.1:18812")

    سرچاپ "orders:"، متاتریدر.تعداد سفارش‌های فعال()
    هر o در متاتریدر.دریافت سفارش‌های فعال():
        سرچاپ o.شماره تیکت، o.نماد، o.نوع سفارش، o.وضعیت، o.حجم فعلی، o.قیمت ورود
    پایان
    هر p در متاتریدر.دریافت پوزیشن‌های باز():
        سرچاپ p.شماره تیکت، p.نماد، p.نوع پوزیشن، p.حجم، p.قیمت ورود، p.سود
    پایان

    ناپایا درخواست := متاتریدر.درخواست معامله {}
    درخواست.عملیات = متاتریدر.عملیات معامله فوری
    درخواست.نماد = "EURUSD"
    درخواست.حجم = 0.10
    درخواست.قیمت = 1.0821
    درخواست.نوع سفارش = متاتریدر.سفارش خرید
    درخواست.نوع پرشدن = متاتریدر.پرشدن فوری
    درخواست.نوع زمان = متاتریدر.اعتبار نامحدود
    درخواست.انحراف مجاز = 10
    درخواست.شناسه ربات = 2026
    درخواست.یادداشت = "salam"

    نتیجه بررسی := متاتریدر.بررسی سفارش(درخواست)
    سرچاپ "check:"، نتیجه بررسی.کد نتیجه، نتیجه بررسی.حاشیه، نتیجه بررسی.حاشیه آزاد، نتیجه بررسی.یادداشت
    اگر نتیجه بررسی.کد نتیجه نابرابر 0:
        برگشت 1
    پایان

    نتیجه ارسال := متاتریدر.ارسال سفارش(درخواست)
    سرچاپ "send:"، نتیجه ارسال.کد نتیجه، نتیجه ارسال.شماره سفارش، نتیجه ارسال.شماره معامله، نتیجه ارسال.قیمت
    اگر نتیجه ارسال.کد نتیجه نابرابر متاتریدر.کد اجرای کامل و نتیجه ارسال.کد نتیجه نابرابر متاتریدر.کد ثبت سفارش:
        نادرست‌سرچاپ "order rejected:"، نتیجه ارسال.یادداشت
        برگشت 1
    پایان

    حاشیه سفارش := متاتریدر.محاسبه حاشیه سفارش(متاتریدر.سفارش خرید، "EURUSD"، 0.10، 1.0821)
    سود سفارش := متاتریدر.محاسبه سود سفارش(متاتریدر.سفارش خرید، "EURUSD"، 0.10، 1.0821، 1.09)
    سرچاپ حاشیه سفارش، سود سفارش
    برگشت 0
پایان
