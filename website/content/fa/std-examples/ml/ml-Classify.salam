واردسازی یادگیری ماشین
واردسازی ماتریس

تابع ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع نشان(نام: رشته، م &: ماتریس.ماتریس):
    سرچاپ نام، ماتریس.به بازنمایی(ماتریس.حذف ریزه(م، ۰.۰۰۰۰۰۱)، ۳)
پایان

تابع گ(عدد: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، عدد)، ۳)
پایان

تابع ریشه:
    ناپایا ایکس := ساختن(۸، ۲، "1 1 1 2 2 1 2 2 6 6 6 7 7 6 7 7")
    ناپایا وای := ساختن(۸، ۱، "0 0 0 0 1 1 1 1")
    ناپایا آزمون := ساختن(۲، ۲، "1.5 1.5 6.5 6.5")

    ناپایا همسایه := یادگیری ماشین.دسته‌بند نزدیک‌ترین همسایه { شمار همسایه‌ها = ۳، وزن‌دار = درست، الگوریتم = یادگیری ماشین.همسایه درخت کی‌دی }
    سرچاپ همسایه.برازش(ایکس، وای)، همسایه.موفق، همسایه.شمار رده‌ها، همسایه.اندازه برگ، همسایه.شمار نخ‌ها، ماتریس.رشته شکل(همسایه.ویژگی‌های آموزش)، ماتریس.رشته شکل(همسایه.برچسب‌های آموزش)، همسایه.درخت.موفق
    نشان("همسایه"، همسایه.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(همسایه.پیش‌بینی احتمال(آزمون))، گ(همسایه.امتیاز(ایکس، وای))، یادگیری ماشین.همسایه جستجوی کامل
    ناپایا رگرسور := یادگیری ماشین.رگرسور نزدیک‌ترین همسایه { شمار همسایه‌ها = ۲ }
    سرچاپ رگرسور.برازش(ایکس، وای)، رگرسور.موفق، رگرسور.وزن‌دار، رگرسور.الگوریتم، رگرسور.اندازه برگ، رگرسور.شمار نخ‌ها، ماتریس.رشته شکل(رگرسور.ویژگی‌های آموزش)، ماتریس.رشته شکل(رگرسور.برچسب‌های آموزش)، رگرسور.درخت.موفق
    نشان("رگرسور"، رگرسور.پیش‌بینی(آزمون))
    سرچاپ گ(رگرسور.امتیاز(ایکس، وای))

    ناپایا گاوسی := یادگیری ماشین.بیز ساده گاوسی {}
    سرچاپ گاوسی.برازش(ایکس، وای)، گاوسی.موفق، گاوسی.شمار رده‌ها، گاوسی.هموارسازی واریانس > ۰.۰، ماتریس.رشته شکل(گاوسی.میانگین‌ها)، ماتریس.رشته شکل(گاوسی.واریانس‌ها)، ماتریس.رشته شکل(گاوسی.لگاریتم پیشین‌ها)
    نشان("گاوسی"، گاوسی.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(گاوسی.پیش‌بینی احتمال(آزمون))، گ(گاوسی.امتیاز(ایکس، وای))
    ناپایا شمارش := ساختن(۴، ۳، "3 0 1 2 0 0 0 3 1 0 2 2")
    ناپایا موضوع := ساختن(۴، ۱، "0 0 1 1")
    ناپایا چندجمله‌ای := یادگیری ماشین.بیز ساده چندجمله‌ای { ضریب هموارسازی = ۱.۰ }
    سرچاپ چندجمله‌ای.برازش(شمارش، موضوع)، چندجمله‌ای.موفق، چندجمله‌ای.یادگیری پیشین، چندجمله‌ای.شمار رده‌ها، ماتریس.رشته شکل(چندجمله‌ای.لگاریتم احتمال)، ماتریس.رشته شکل(چندجمله‌ای.لگاریتم پیشین‌ها)
    نشان("چندجمله‌ای"، چندجمله‌ای.پیش‌بینی(شمارش))
    سرچاپ ماتریس.رشته شکل(چندجمله‌ای.تصمیم(شمارش))، ماتریس.رشته شکل(چندجمله‌ای.پیش‌بینی احتمال(شمارش))، گ(چندجمله‌ای.امتیاز(شمارش، موضوع))

    ناپایا خطی := یادگیری ماشین.تحلیل تشخیصی خطی {}
    سرچاپ خطی.برازش(ایکس، وای)، خطی.موفق، خطی.شمار رده‌ها، خطی.منظم‌سازی > ۰.۰، ماتریس.رشته شکل(خطی.میانگین‌ها)، ماتریس.رشته شکل(خطی.کوواریانس)، ماتریس.رشته شکل(خطی.لگاریتم پیشین‌ها)
    نشان("خطی"، خطی.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(خطی.پیش‌بینی احتمال(آزمون))، گ(خطی.امتیاز(ایکس، وای))
    ناپایا درجه دو := یادگیری ماشین.تحلیل تشخیصی درجه دو {}
    سرچاپ درجه دو.برازش(ایکس، وای)، درجه دو.موفق، درجه دو.شمار رده‌ها، درجه دو.منظم‌سازی > ۰.۰، ماتریس.رشته شکل(درجه دو.میانگین‌ها)، درجه دو.کوواریانس‌ها.طول()، ماتریس.رشته شکل(درجه دو.لگاریتم پیشین‌ها)
    نشان("درجه دو"، درجه دو.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(درجه دو.پیش‌بینی احتمال(آزمون))، گ(درجه دو.امتیاز(ایکس، وای))

    ناپایا خطی ب := یادگیری ماشین.ماشین بردار پشتیبان خطی { جریمه = ۱.۰ }
    سرچاپ خطی ب.برازش(ایکس، وای)، خطی ب.موفق، خطی ب.شمار رده‌ها، خطی ب.بیشترین دور، خطی ب.رواداری > ۰.۰، خطی ب.بذر، ماتریس.رشته شکل(خطی ب.ضریب‌ها)، ماتریس.رشته شکل(خطی ب.عرض از مبدأ)
    نشان("بردار پشتیبان خطی"، خطی ب.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(خطی ب.تصمیم(آزمون))، گ(خطی ب.امتیاز(ایکس، وای))
    ناپایا هسته := یادگیری ماشین.دسته‌بند بردار پشتیبان { هسته = یادگیری ماشین.هسته شعاعی، جریمه = ۱۰.۰، گاما = ۰.۵ }
    سرچاپ هسته.برازش(ایکس، وای)، هسته.موفق، هسته.شمار رده‌ها، هسته.شمار بردار پشتیبان() > ۰، هسته.درجه، هسته.ضریب صفر، هسته.بیشترین دور، هسته.رواداری > ۰.۰، هسته.بذر
    سرچاپ ماتریس.رشته شکل(هسته.بردارهای پشتیبان)، ماتریس.رشته شکل(هسته.ضریب‌های دوگان)، ماتریس.رشته شکل(هسته.سوگیری)
    نشان("هسته شعاعی"، هسته.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(هسته.تصمیم(آزمون))، گ(هسته.امتیاز(ایکس، وای))، یادگیری ماشین.هسته خطی، یادگیری ماشین.هسته چندجمله‌ای

    ناپایا واقعی := ساختن(۶، ۱، "0 0 1 1 1 0")
    ناپایا پیش := ساختن(۶، ۱، "0 1 1 1 0 0")
    ناپایا امتیاز := ساختن(۶، ۱، "0.1 0.6 0.8 0.9 0.4 0.2")
    سرچاپ گ(یادگیری ماشین.دقت(واقعی، پیش))، گ(یادگیری ماشین.صحت(واقعی، پیش، ۱.۰))، گ(یادگیری ماشین.بازیابی(واقعی، پیش، ۱.۰))، گ(یادگیری ماشین.اف یک(واقعی، پیش، ۱.۰))، گ(یادگیری ماشین.اف یک کلان(واقعی، پیش، ۲))
    نشان("درهم‌ریختگی"، یادگیری ماشین.ماتریس درهم‌ریختگی(واقعی، پیش، ۲))
    سرچاپ گ(یادگیری ماشین.سطح زیر منحنی(واقعی، امتیاز))، گ(یادگیری ماشین.میانگین صحت(واقعی، امتیاز))، گ(یادگیری ماشین.دقت متوازن(واقعی، پیش))، گ(یادگیری ماشین.ضریب همبستگی متیوز(واقعی، پیش))، گ(یادگیری ماشین.کاپای کوهن(واقعی، پیش))
    سرچاپ ماتریس.رشته شکل(یادگیری ماشین.منحنی راک(واقعی، امتیاز))، ماتریس.رشته شکل(یادگیری ماشین.منحنی صحت بازیابی(واقعی، امتیاز))
    ناپایا احتمال := ساختن(۶، ۲، "0.9 0.1 0.4 0.6 0.2 0.8 0.1 0.9 0.6 0.4 0.8 0.2")
    سرچاپ گ(یادگیری ماشین.خطای لگاریتمی(واقعی، احتمال))
    همسایه.آزادسازی()
    رگرسور.آزادسازی()
    گاوسی.آزادسازی()
    چندجمله‌ای.آزادسازی()
    خطی.آزادسازی()
    درجه دو.آزادسازی()
    خطی ب.آزادسازی()
    هسته.آزادسازی()
پایان
