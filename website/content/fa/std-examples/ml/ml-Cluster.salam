واردسازی یادگیری ماشین
واردسازی ماتریس

تابع ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع گ(عدد: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، عدد)، ۳)
پایان

تابع ریشه:
    ناپایا ایکس := ساختن(۸، ۲، "1 1 1 2 2 1 2 2 8 8 8 9 9 8 9 9")
    ناپایا واقعی := ساختن(۸، ۱، "0 0 0 0 1 1 1 1")

    ناپایا کا := یادگیری ماشین.کی میانگین { شمار خوشه‌ها = ۲، بذر = ۱ }
    ناپایا برچسب := کا.برازش سپس پیش‌بینی(ایکس)
    سرچاپ کا.موفق، کا.شمار تکرارها > ۰، گ(کا.inertia)، ماتریس.رشته شکل(کا.مرکزها)، کا.بیشترین دور، کا.رواداری > ۰.۰، کا.شمار اجراها، کا.شمار نخ‌ها
    سرچاپ برچسب.عنصر(۰، ۰) != برچسب.عنصر(۴، ۰)، گ(یادگیری ماشین.شاخص رند تعدیل‌شده(برچسب، واقعی))، گ(یادگیری ماشین.امتیاز سایه‌نما(ایکس، برچسب))
    سرچاپ کا.برازش(ایکس)، ماتریس.رشته شکل(کا.پیش‌بینی(ایکس))
    ناپایا کوچک := یادگیری ماشین.کی میانگین دسته کوچک { شمار خوشه‌ها = ۲، اندازه دسته = ۴، بیشترین دور = ۵۰، بذر = ۲ }
    سرچاپ کوچک.برازش(ایکس)، کوچک.موفق، ماتریس.رشته شکل(کوچک.مرکزها)، گ(یادگیری ماشین.شاخص رند تعدیل‌شده(کوچک.برازش سپس پیش‌بینی(ایکس)، واقعی))، ماتریس.رشته شکل(کوچک.پیش‌بینی(ایکس))

    ناپایا چگالی := یادگیری ماشین.دی‌بی‌اسکن { شعاع همسایگی = ۱.۵، کمترین نمونه = ۳ }
    ناپایا خوشه‌ها := چگالی.برازش سپس پیش‌بینی(ایکس)
    سرچاپ چگالی.موفق، چگالی.شمار خوشه‌ها، ماتریس.رشته شکل(چگالی.برچسب‌ها)، گ(یادگیری ماشین.شاخص رند تعدیل‌شده(خوشه‌ها، واقعی))، چگالی.برازش(ایکس)

    ناپایا تجمیعی := یادگیری ماشین.خوشه‌بندی تجمیعی { شمار خوشه‌ها = ۲، پیوند = یادگیری ماشین.پیوند میانگین }
    سرچاپ گ(یادگیری ماشین.شاخص رند تعدیل‌شده(تجمیعی.برازش سپس پیش‌بینی(ایکس)، واقعی))، تجمیعی.موفق، ماتریس.رشته شکل(تجمیعی.برچسب‌ها)، تجمیعی.برازش(ایکس)
    سرچاپ یادگیری ماشین.پیوند تکی، یادگیری ماشین.پیوند کامل

    ناپایا آمیزه := یادگیری ماشین.آمیزه گاوسی { k = ۲، بذر = ۳ }
    سرچاپ گ(یادگیری ماشین.شاخص رند تعدیل‌شده(آمیزه.برازش سپس پیش‌بینی(ایکس)، واقعی))، آمیزه.موفق، آمیزه.شمار تکرارها > ۰، آمیزه.لگاریتم راست‌نمایی != ۰.۰، آمیزه.بیشترین دور، آمیزه.رواداری > ۰.۰، آمیزه.کف واریانس > ۰.۰
    سرچاپ ماتریس.رشته شکل(آمیزه.میانگین‌ها)، ماتریس.رشته شکل(آمیزه.واریانس‌ها)، ماتریس.رشته شکل(آمیزه.وزن‌ها)، آمیزه.برازش(ایکس)
    سرچاپ ماتریس.رشته شکل(آمیزه.پیش‌بینی(ایکس))، ماتریس.رشته شکل(آمیزه.پیش‌بینی احتمال(ایکس))

    ناپایا تسنه := یادگیری ماشین.تی‌اس‌ان‌ای { شمار مؤلفه‌ها = ۲، سرگشتگی = ۲.۰، شمار تکرارها = ۲۵۰، بذر = ۴ }
    ناپایا جاسازی := تسنه.برازش سپس تبدیل(ایکس)
    سرچاپ تسنه.موفق، ماتریس.رشته شکل(جاسازی)، ماتریس.رشته شکل(تسنه.جاسازی)، تسنه.واگرایی کی ال >= ۰.۰، تسنه.نرخ یادگیری، تسنه.بزرگ‌نمایی آغازین
    کا.آزادسازی()
    کوچک.آزادسازی()
    چگالی.آزادسازی()
    تجمیعی.آزادسازی()
    آمیزه.آزادسازی()
    تسنه.آزادسازی()
پایان
