واردسازی یادگیری ماشین
واردسازی ماتریس

تابع ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع نشان(نام: رشته، م &: ماتریس.ماتریس):
    سرچاپ نام، ماتریس.به بازنمایی(ماتریس.حذف ریزه(م، ۰.۰۰۰۰۰۱)، ۳)
پایان

تابع گ(عدد: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، عدد)، ۳)
پایان

تابع ریشه:
    ناپایا ایکس := ساختن(۵، ۲، "1 0 2 1 3 0 4 1 5 0")
    ناپایا وای := ساختن(۵، ۱، "3 6 7 10 11")
    ناپایا خطی := یادگیری ماشین.رگرسیون خطی {}
    سرچاپ خطی.برازش(ایکس، وای)، خطی.موفق، خطی.برازش عرض از مبدأ، گ(خطی.عرض از مبدأ)
    نشان("ضریب‌ها"، خطی.ضریب‌ها)
    ناپایا پیش := خطی.پیش‌بینی(ایکس)
    نشان("پیش‌بینی"، پیش)
    سرچاپ گ(خطی.امتیاز(ایکس، وای))، گ(یادگیری ماشین.ضریب تعیین(وای، پیش))
    ناپایا خطا := ساختن(۵، ۱، "3.5 5.5 7 10 12")
    سرچاپ گ(یادگیری ماشین.میانگین مربعات خطا(وای، خطا))، گ(یادگیری ماشین.میانگین قدرمطلق خطا(وای، خطا))، گ(یادگیری ماشین.ریشه میانگین مربعات خطا(وای، خطا))
    سرچاپ گ(یادگیری ماشین.میانه خطای مطلق(وای، خطا))، گ(یادگیری ماشین.میانگین درصد خطای مطلق(وای، خطا))، گ(یادگیری ماشین.واریانس تبیین‌شده(وای، خطا))

    ناپایا ستیغی := یادگیری ماشین.رگرسیون ستیغی { ضریب منظم‌سازی = ۱.۰ }
    سرچاپ ستیغی.برازش(ایکس، وای)، ستیغی.موفق، ستیغی.ضریب منظم‌سازی، ستیغی.برازش عرض از مبدأ، گ(ستیغی.عرض از مبدأ)
    نشان("ستیغی"، ستیغی.ضریب‌ها)
    سرچاپ ستیغی.امتیاز(ایکس، وای) > ۰.۹، ماتریس.رشته شکل(ستیغی.پیش‌بینی(ایکس))
    ناپایا لاسو := یادگیری ماشین.لاسو { ضریب منظم‌سازی = ۰.۱ }
    سرچاپ لاسو.برازش(ایکس، وای)، لاسو.موفق، لاسو.ضریب منظم‌سازی، لاسو.نسبت ال یک، لاسو.برازش عرض از مبدأ، لاسو.بیشترین دور، لاسو.رواداری > ۰.۰، لاسو.شمار تکرارها > ۰، لاسو.عرض از مبدأ > ۰.۰
    نشان("لاسو"، لاسو.ضریب‌ها)
    سرچاپ لاسو.امتیاز(ایکس، وای) > ۰.۹، ماتریس.رشته شکل(لاسو.پیش‌بینی(ایکس))
    ناپایا کشسان := یادگیری ماشین.شبکه کشسان جدید(۰.۱، ۰.۵)
    سرچاپ کشسان.برازش(ایکس، وای)، کشسان.نسبت ال یک

    ناپایا ساعت := ساختن(۶، ۱، "1 2 3 4 5 6")
    ناپایا قبولی := ساختن(۶، ۱، "0 0 0 1 1 1")
    ناپایا لجستیک := یادگیری ماشین.رگرسیون لجستیک { ضریب منظم‌سازی = ۰.۰۱، بیشترین دور = ۲۰۰۰ }
    سرچاپ لجستیک.برازش(ساعت، قبولی)، لجستیک.موفق، لجستیک.شمار رده‌ها، لجستیک.برازش عرض از مبدأ، لجستیک.شمار تکرارها > ۰، لجستیک.رواداری > ۰.۰
    سرچاپ ماتریس.رشته شکل(لجستیک.ضریب‌ها)، ماتریس.رشته شکل(لجستیک.عرض از مبدأ)
    نشان("پیش‌بینی"، لجستیک.پیش‌بینی(ساعت))
    ناپایا احتمال := لجستیک.پیش‌بینی احتمال(ساختن(۲، ۱، "1 6"))
    سرچاپ احتمال.عنصر(۰، ۱) < ۰.۵، احتمال.عنصر(۱، ۱) > ۰.۵، گ(لجستیک.امتیاز(ساعت، قبولی))
    خطی.آزادسازی()
    ستیغی.آزادسازی()
    لاسو.آزادسازی()
    کشسان.آزادسازی()
    لجستیک.آزادسازی()
پایان
