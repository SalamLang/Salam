واردسازی یادگیری ماشین
واردسازی ماتریس

تابع ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع نشان(نام: رشته، م &: ماتریس.ماتریس):
    سرچاپ نام، ماتریس.به بازنمایی(ماتریس.حذف ریزه(م، ۰.۰۰۰۰۰۱)، ۳)
پایان

تابع صحیح‌ها(بردار: وکتور<صحیح>): رشته:
    ناپایا متن := "["
    تکرار بردار.طول() در ش:
        اگر ش > ۰:
            متن += " "
        پایان
        متن += "" + بردار.دریافت(ش)
    پایان
    برگشت متن + "]"
پایان

تابع ریشه:
    ناپایا داده := ساختن(۴، ۲، "1 10 2 20 3 30 4 40")
    ناپایا استاندارد := یادگیری ماشین.مقیاس‌گر استاندارد {}
    ناپایا مقیاس‌شده := استاندارد.برازش سپس تبدیل(داده)
    نشان("استاندارد"، مقیاس‌شده)
    نشان("میانگین"، استاندارد.میانگین)
    سرچاپ استاندارد.موفق، استاندارد.با میانگین، استاندارد.با انحراف معیار، ماتریس.رشته شکل(استاندارد.انحراف معیار)
    نشان("برگشت"، استاندارد.تبدیل معکوس(مقیاس‌شده))
    ناپایا کمینه بیشینه := یادگیری ماشین.مقیاس‌گر کمینه‌بیشینه { کمینه = ۰.۰، بیشینه = ۱.۰ }
    سرچاپ کمینه بیشینه.برازش(داده)
    نشان("کمینه‌بیشینه"، کمینه بیشینه.تبدیل(داده))
    نشان("برگشت"، کمینه بیشینه.تبدیل معکوس(کمینه بیشینه.برازش سپس تبدیل(داده)))
    سرچاپ کمینه بیشینه.موفق، ماتریس.رشته شکل(کمینه بیشینه.کمینه داده)، ماتریس.رشته شکل(کمینه بیشینه.دامنه داده)
    سرچاپ استاندارد.برازش(داده)، ماتریس.رشته شکل(استاندارد.تبدیل(داده))

    ناپایا برچسب‌ها := وکتور {} برگردان وکتور<رشته>
    هر برچسب در ["گربه"، "سگ"، "گربه"، "ماهی"]:
        برچسب‌ها.بیفزا(برچسب)
    پایان
    ناپایا رمزگذار := یادگیری ماشین.رمزگذار برچسب {}
    ناپایا عددی := رمزگذار.برازش سپس تبدیل(برچسب‌ها)
    نشان("برچسب"، عددی)
    سرچاپ رمزگذار.موفق، رمزگذار.رده‌ها.طول()، رمزگذار.نمایه("سگ")، رمزگذار.تبدیل معکوس(عددی).دریافت(۳)، رمزگذار.برازش(برچسب‌ها)، ماتریس.رشته شکل(رمزگذار.تبدیل(برچسب‌ها))
    ناپایا تک‌داغ := یادگیری ماشین.رمزگذار تک‌داغ {}
    ناپایا داغ := تک‌داغ.برازش سپس تبدیل(عددی)
    نشان("تک‌داغ"، داغ)
    نشان("برگشت"، تک‌داغ.تبدیل معکوس(داغ))
    سرچاپ تک‌داغ.موفق، تک‌داغ.شمار رده‌ها، تک‌داغ.برازش(عددی)، ماتریس.رشته شکل(تک‌داغ.تبدیل(عددی))
    سرچاپ صحیح‌ها(یادگیری ماشین.برچسب به عدد(عددی))، یادگیری ماشین.شمارش رده‌ها(عددی)

    ناپایا ناقص := ساختن(۳، ۲، "1 4 nan 6 3 nan")
    ناپایا جایگذار := یادگیری ماشین.جایگذار ساده { راهبرد = یادگیری ماشین.جایگذاری میانگین }
    نشان("میانگین"، جایگذار.برازش سپس تبدیل(ناقص))
    ناپایا جایگذار۲ := یادگیری ماشین.جایگذار ساده { راهبرد = یادگیری ماشین.جایگذاری ثابت، مقدار پرکننده = -۱.۰ }
    سرچاپ جایگذار۲.برازش(ناقص)، جایگذار۲.موفق، ماتریس.رشته شکل(جایگذار۲.آمارها)
    نشان("ثابت"، جایگذار۲.تبدیل(ناقص))
    سرچاپ یادگیری ماشین.جایگذاری میانه
    ناپایا چندجمله‌ای := یادگیری ماشین.ویژگی چندجمله‌ای { درجه = ۲، شامل سوگیری = درست }
    نشان("چندجمله‌ای"، چندجمله‌ای.تبدیل(ساختن(۱، ۲، "2 3")))

    ناپایا خطی := ساختن(۴، ۲، "1 2 2 4 3 6 4 8")
    ناپایا مولفه := یادگیری ماشین.تحلیل مؤلفه اصلی { شمار مؤلفه‌ها = ۱ }
    سرچاپ مولفه.برازش(خطی)، مولفه.موفق، ماتریس.رشته شکل(مولفه.مؤلفه‌ها)، ماتریس.رشته شکل(مولفه.میانگین)
    نشان("واریانس"، مولفه.نسبت توضیح‌داده‌شده)
    سرچاپ ماتریس.رشته شکل(مولفه.واریانس توضیح‌داده‌شده)، ماتریس.رشته شکل(مولفه.تبدیل(خطی))، ماتریس.رشته شکل(مولفه.برازش سپس تبدیل(خطی))
    نشان("برگشت"، مولفه.تبدیل معکوس(مولفه.تبدیل(خطی)))
    ناپایا بریده := یادگیری ماشین.تجزیه مقادیر تکین بریده { شمار مؤلفه‌ها = ۱ }
    سرچاپ بریده.برازش(خطی)، بریده.موفق، ماتریس.رشته شکل(بریده.مؤلفه‌ها)، ماتریس.رشته شکل(بریده.مقدارهای تکین)، ماتریس.رشته شکل(بریده.واریانس توضیح‌داده‌شده)، ماتریس.رشته شکل(بریده.نسبت توضیح‌داده‌شده)
    سرچاپ ماتریس.رشته شکل(بریده.تبدیل(خطی))، ماتریس.رشته شکل(بریده.برازش سپس تبدیل(خطی))

    ناپایا ایکس := ساختن(۶، ۱، "1 2 3 4 5 6")
    ناپایا وای := ساختن(۶، ۱، "0 0 0 1 1 1")
    ناپایا تقسیم := یادگیری ماشین.تقسیم آموزش‌آزمون(ایکس، وای، ۰.۵، ۷)
    سرچاپ ماتریس.رشته شکل(تقسیم.ویژگی‌های آموزش)، ماتریس.رشته شکل(تقسیم.ویژگی‌های آزمون)، ماتریس.رشته شکل(تقسیم.برچسب‌های آموزش)، ماتریس.رشته شکل(تقسیم.برچسب‌های آزمون)
    ناپایا برش‌ها := یادگیری ماشین.کی برش(۶، ۳، نادرست، ۰)
    سرچاپ برش‌ها.شمار()، صحیح‌ها(برش‌ها.آزمون.دریافت(۰))، صحیح‌ها(برش‌ها.آموزش.دریافت(۰))
    ناپایا طبقه‌ای := یادگیری ماشین.کی برش طبقه‌ای(وای، ۳، ۱)
    سرچاپ طبقه‌ای.شمار()، طبقه‌ای.آزمون.دریافت(۰).طول()
    سرچاپ یادگیری ماشین.رواداری یادگیری > ۰.۰
    استاندارد.آزادسازی()
    کمینه بیشینه.آزادسازی()
    رمزگذار.آزادسازی()
    جایگذار.آزادسازی()
    مولفه.آزادسازی()
    بریده.آزادسازی()
پایان
