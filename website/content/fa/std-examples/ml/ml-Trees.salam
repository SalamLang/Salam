واردسازی یادگیری ماشین
واردسازی ماتریس

تابع ساختن(سطرها: صحیح، ستون‌ها: صحیح، اعداد: رشته): ماتریس.ماتریس:
    ناپایا داده := وکتور {} برگردان وکتور<اعشار۶۴>
    هر عدد در اعداد.بشکاف(" "):
        داده.بیفزا(عدد.به اعشار())
    پایان
    برگشت ماتریس.از آرایه(سطرها، ستون‌ها، داده)
پایان

تابع نشان(نام: رشته، م &: ماتریس.ماتریس):
    سرچاپ نام، ماتریس.به بازنمایی(ماتریس.حذف ریزه(م، ۰.۰۰۰۰۰۱)، ۳)
پایان

تابع گ(عدد: اعشار۶۴): رشته:
    برگشت ماتریس.به رشته با دقت(ماتریس.پرشده(۱، ۱، عدد)، ۳)
پایان

تابع صحیح‌ها(بردار: وکتور<صحیح>): رشته:
    ناپایا متن := "["
    تکرار بردار.طول() در ش:
        اگر ش > ۰:
            متن += " "
        پایان
        متن += "" + بردار.دریافت(ش)
    پایان
    برگشت متن + "]"
پایان

تابع ریشه:
    ناپایا ایکس := ساختن(۸، ۲، "1 1 1 2 2 1 2 2 6 6 6 7 7 6 7 7")
    ناپایا وای := ساختن(۸، ۱، "0 0 0 0 1 1 1 1")
    ناپایا آزمون := ساختن(۲، ۲، "1.5 1.5 6.5 6.5")

    ناپایا درخت := یادگیری ماشین.درخت تصمیم { معیار = یادگیری ماشین.معیار جینی، بیشترین عمق = ۳ }
    سرچاپ درخت.برازش(ایکس، وای)، درخت.موفق، درخت.شمار رده‌ها، درخت.رگرسیون است()، درخت.شمار گره()، درخت.اعمال سطر(آزمون، ۰) >= ۰
    سرچاپ درخت.کمترین نمونه شکاف، درخت.کمترین نمونه برگ، درخت.بیشترین ویژگی، درخت.بذر، درخت.شمار رده‌ی پیشنهادی، درخت.ویژگی.طول()، درخت.آستانه.طول()، درخت.چپ.طول()، درخت.راست.طول()، ماتریس.رشته شکل(درخت.مقدار)
    نشان("درخت"، درخت.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(درخت.پیش‌بینی احتمال(آزمون))، گ(درخت.امتیاز(ایکس، وای))
    ناپایا رگرسیون := یادگیری ماشین.درخت تصمیم { معیار = یادگیری ماشین.معیار میانگین مربعات }
    سرچاپ رگرسیون.برازش(ایکس، ساختن(۸، ۱، "1 1 1 1 5 5 5 5"))، رگرسیون.رگرسیون است()، یادگیری ماشین.معیار آنتروپی

    ناپایا جنگل := یادگیری ماشین.جنگل تصادفی { شمار درخت‌ها = ۲۰، بیشترین عمق = ۴، بذر = ۳ }
    سرچاپ جنگل.برازش(ایکس، وای)، جنگل.موفق، جنگل.شمار رده‌ها، جنگل.درخت‌ها.طول()، جنگل.رگرسیون است()، جنگل.معیار، جنگل.کمترین نمونه برگ، جنگل.بیشترین ویژگی، جنگل.بوت‌استرپ، جنگل.شمار نخ‌ها
    نشان("جنگل"، جنگل.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(جنگل.پیش‌بینی احتمال(آزمون))، گ(جنگل.امتیاز(ایکس، وای))
    جنگل.آزادسازی درخت‌ها()

    ناپایا آدا := یادگیری ماشین.آدابوست { شمار برآوردگرها = ۱۰ }
    سرچاپ آدا.برازش(ایکس، وای)، آدا.موفق، آدا.شمار رده‌ها، آدا.درخت‌ها.طول() > ۰، آدا.وزن درخت‌ها.طول() > ۰، آدا.بیشترین عمق، آدا.نرخ یادگیری، آدا.بذر
    نشان("آدابوست"، آدا.پیش‌بینی(آزمون))
    سرچاپ گ(آدا.امتیاز(ایکس، وای))
    آدا.آزادسازی همه()

    ناپایا گرادیان := یادگیری ماشین.تقویت گرادیانی { شمار برآوردگرها = ۲۰، نرخ یادگیری = ۰.۳، بیشترین عمق = ۲ }
    سرچاپ گرادیان.برازش(ایکس، وای)، گرادیان.موفق، گرادیان.شمار رده‌ها، گرادیان.درخت‌ها.طول()، گرادیان.کمترین نمونه برگ، گرادیان.رگرسیون، ماتریس.رشته شکل(گرادیان.پیش‌بینی پایه)
    نشان("تقویت گرادیانی"، گرادیان.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(گرادیان.تصمیم(آزمون))، ماتریس.رشته شکل(گرادیان.پیش‌بینی احتمال(آزمون))، گ(گرادیان.امتیاز(ایکس، وای))
    گرادیان.آزادسازی همه()

    ناپایا هیستوگرام := یادگیری ماشین.تقویت گرادیان هیستوگرامی { شمار برآوردگرها = ۲۰، کمترین نمونه برگ = ۱، بیشترین بازه = ۱۶ }
    سرچاپ هیستوگرام.برازش(ایکس، وای)، هیستوگرام.موفق، هیستوگرام.شمار رده‌ها، هیستوگرام.درخت‌ها.طول() > ۰، هیستوگرام.بیشترین عمق، هیستوگرام.ضریب ال دو، هیستوگرام.نرخ یادگیری، هیستوگرام.رگرسیون، هیستوگرام.edges.طول() > ۰، هیستوگرام.آغاز مرزها.طول()، هیستوگرام.پیش‌بینی پایه.طول()
    نشان("هیستوگرامی"، هیستوگرام.پیش‌بینی(آزمون))
    سرچاپ ماتریس.رشته شکل(هیستوگرام.تصمیم(آزمون))، ماتریس.رشته شکل(هیستوگرام.پیش‌بینی احتمال(آزمون))، گ(هیستوگرام.امتیاز(ایکس، وای))
    ناپایا یکی := هیستوگرام.درخت‌ها.دریافت(۰)
    سرچاپ یکی.ویژگی.طول() > ۰، یکی.آستانه.طول() > ۰، یکی.چپ.طول() > ۰، یکی.راست.طول() > ۰، یکی.مقدار.طول() > ۰
    هیستوگرام.آزادسازی همه()

    ناپایا کی‌دی := یادگیری ماشین.درخت کی‌دی جدید(ایکس، ۲)
    ناپایا فاصله‌ها := وکتور {} برگردان وکتور<اعشار۶۴>
    سرچاپ کی‌دی.موفق، کی‌دی.اندازه برگ، کی‌دی.شمار گره() > ۰، صحیح‌ها(کی‌دی.پرس‌وجو(آزمون، ۱، ۲، فاصله‌ها))، گ(فاصله‌ها.دریافت(۰))
    سرچاپ ماتریس.رشته شکل(کی‌دی.داده)، کی‌دی.جایگشت.طول()، کی‌دی.آغاز گره‌ها.طول() > ۰، کی‌دی.انتهای گره‌ها.طول() > ۰، کی‌دی.بعد گره‌ها.طول() > ۰، کی‌دی.شکاف گره‌ها.طول() > ۰، کی‌دی.فرزند چپ گره‌ها.طول() > ۰، کی‌دی.فرزند راست گره‌ها.طول() > ۰
    ناپایا خالی := یادگیری ماشین.درخت کی‌دی {}
    سرچاپ خالی.ساخت(ایکس)، خالی.شمار گره() > ۰
    کی‌دی.آزادسازی()
    خالی.آزادسازی()
    درخت.آزادسازی()
    رگرسیون.آزادسازی()
پایان
