// زبان: فارسی
واردسازی ناوبری

تابع ریشه:
    سرچاپ ناوبری.تطبیق("/users/:id"، "/users/42")
    سرچاپ ناوبری.پارامتر("/users/:id"، "/users/42"، "id")
    سرچاپ ناوبری.تطبیق("/users/:id?"، "/users")
    سرچاپ ناوبری.پارامتر("/files/*path"، "/files/a/b.txt"، "path")
    سرچاپ ناوبری.مقدار پرسمان("q=hello+world&page=2"، "q")
    سرچاپ ناوبری.بازگشایی("a%2Fb")
    سرچاپ ناوبری.رتبه("/users/new") بزرگتر ناوبری.رتبه("/users/:id")
    سرچاپ ناوبری.عدد صحیح است("42")
    م := ناوبری.مسیر { نشانی = "/users/42"، پرسمان = "tab=posts"، الگو = "/users/:id" }
    سرچاپ م.نشانی + " " + م.پرسمان + " " + م.الگو
پایان
