// زبان: فارسی
واردسازی ناوبری

تابع ریشه:
    سرچاپ ناوبری.یکسان سازی("a//b/./c/../d/")
    ناپایا مسیر := ""
    ناپایا پرس := ""
    ناوبری.جداسازی نشانی("/search?q=salam#top"، مسیر، پرس)
    سرچاپ مسیر + " | " + پرس
    سرچاپ ناوبری.حل نشانی("/users/3"، "edit")
    سرچاپ ناوبری.حل نشانی("/users/3"، "..")
    سرچاپ ناوبری.حل نشانی("/users/3"، "?page=2")
    سرچاپ ناوبری.نشانی صفحه(درست، ""، "/about")
    سرچاپ ناوبری.نشانی صفحه(نادرست، "/app"، "/about")
    سرچاپ ناوبری.برداشتن پایه("/app"، "/app/about")
پایان
