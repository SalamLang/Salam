// زبان: فارسی
واردسازی شبکه.سانسورشکن

تابع ریشه:
    ناپایا متغیر_set := سانسورشکن.مجموعه دامنه جدید()
    سرچاپ سانسورشکن.افزودن قاعده(متغیر_set، "example.com")، سانسورشکن.افزودن قاعده(متغیر_set، "full:only.test.org")، سانسورشکن.افزودن قاعده(متغیر_set، "keyword:torrent")
    سرچاپ سانسورشکن.افزودن قاعده(متغیر_set، "domain:*.cdn.net")، سانسورشکن.افزودن قاعده(متغیر_set، "regexp:a.*")، سانسورشکن.افزودن قاعده(متغیر_set، "  ")
    سرچاپ سانسورشکن.افزودن قاعده‌ها(متغیر_set، "# a comment\nblocked.io # trailing\n\nfoo.bar\n")، متغیر_set.شمار
    سرچاپ سانسورشکن.تطبیق دامنه(متغیر_set، "example.com")، سانسورشکن.تطبیق دامنه(متغیر_set، "WWW.Example.COM.")، سانسورشکن.تطبیق دامنه(متغیر_set، "badexample.com")
    سرچاپ سانسورشکن.تطبیق دامنه(متغیر_set، "only.test.org")، سانسورشکن.تطبیق دامنه(متغیر_set، "x.only.test.org")، سانسورشکن.تطبیق دامنه(متغیر_set، "my-torrent-site.xyz")
    سرچاپ سانسورشکن.تطبیق دامنه(متغیر_set، "a.b.cdn.net")، سانسورشکن.تطبیق دامنه(متغیر_set، "x.blocked.io")، سانسورشکن.تطبیق دامنه(متغیر_set، "net")
    سرچاپ متغیر_set.پسوندها.اندازه()، متغیر_set.دامنه‌های کامل.اندازه()، متغیر_set.کلیدواژه‌ها.طول()
    سانسورشکن.آزاد کردن مجموعه دامنه(متغیر_set)

    سرچاپ سانسورشکن.میزبان خصوصی("192.168.1.5")، سانسورشکن.میزبان خصوصی("172.20.0.1")، سانسورشکن.میزبان خصوصی("172.40.0.1")، سانسورشکن.میزبان خصوصی("localhost")، سانسورشکن.میزبان خصوصی("::1")، سانسورشکن.میزبان خصوصی("example.com")

    ناپایا متغیر_classifier := سانسورشکن.دسته‌بند جدید(سانسورشکن.تصمیم پراکسی)
    متغیر_classifier.مستقیم = سانسورشکن.مجموعه مستقیم ایران()
    متغیر_classifier.مسدود = سانسورشکن.مجموعه دامنه جدید()
    سانسورشکن.افزودن قاعده(متغیر_classifier.مسدود، "ads.example.org")
    هر میزبان در ["www.digikala.com"، "mail.sharif.ir"، "youtube.com"، "ads.example.org"، "192.168.1.5"، "172.40.0.1"]:
        سرچاپ میزبان، سانسورشکن.دسته‌بندی(متغیر_classifier، میزبان)
    پایان
    سرچاپ سانسورشکن.تصمیم پراکسی، سانسورشکن.تصمیم مستقیم، سانسورشکن.تصمیم مسدود

    متغیر_filtered := سانسورشکن.مجموعه فیلترشده()
    سرچاپ سانسورشکن.تطبیق دامنه(متغیر_filtered، "m.youtube.com")، سانسورشکن.تطبیق دامنه(متغیر_filtered، "digikala.com")
    سرچاپ سانسورشکن.فهرست مستقیم ایران().شروع با("#")، سانسورشکن.فهرست فیلترشده().دربردارد("youtube.com")
پایان
