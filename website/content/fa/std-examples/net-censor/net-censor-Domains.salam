// زبان: فارسی
واردسازی شبکه.سانسورشکن

تابع ریشه:
    ناپایا set := سانسورشکن.مجموعه دامنه جدید()
    سرچاپ سانسورشکن.افزودن قاعده(set، "example.com")، سانسورشکن.افزودن قاعده(set، "full:only.test.org")، سانسورشکن.افزودن قاعده(set، "keyword:torrent")
    سرچاپ سانسورشکن.افزودن قاعده(set، "domain:*.cdn.net")، سانسورشکن.افزودن قاعده(set، "regexp:a.*")، سانسورشکن.افزودن قاعده(set، "  ")
    سرچاپ سانسورشکن.افزودن قاعده‌ها(set، "# a comment\nblocked.io # trailing\n\nfoo.bar\n")، set.شمار
    سرچاپ سانسورشکن.تطبیق دامنه(set، "example.com")، سانسورشکن.تطبیق دامنه(set، "WWW.Example.COM.")، سانسورشکن.تطبیق دامنه(set، "badexample.com")
    سرچاپ سانسورشکن.تطبیق دامنه(set، "only.test.org")، سانسورشکن.تطبیق دامنه(set، "x.only.test.org")، سانسورشکن.تطبیق دامنه(set، "my-torrent-site.xyz")
    سرچاپ سانسورشکن.تطبیق دامنه(set، "a.b.cdn.net")، سانسورشکن.تطبیق دامنه(set، "x.blocked.io")، سانسورشکن.تطبیق دامنه(set، "net")
    سرچاپ set.پسوندها.اندازه()، set.دامنه‌های کامل.اندازه()، set.کلیدواژه‌ها.طول()
    سانسورشکن.آزاد کردن مجموعه دامنه(set)

    سرچاپ سانسورشکن.میزبان خصوصی("192.168.1.5")، سانسورشکن.میزبان خصوصی("172.20.0.1")، سانسورشکن.میزبان خصوصی("172.40.0.1")، سانسورشکن.میزبان خصوصی("localhost")، سانسورشکن.میزبان خصوصی("::1")، سانسورشکن.میزبان خصوصی("example.com")

    ناپایا classifier := سانسورشکن.دسته‌بند جدید(سانسورشکن.تصمیم پراکسی)
    classifier.مستقیم = سانسورشکن.مجموعه مستقیم ایران()
    classifier.مسدود = سانسورشکن.مجموعه دامنه جدید()
    سانسورشکن.افزودن قاعده(classifier.مسدود، "ads.example.org")
    هر host در ["www.digikala.com"، "mail.sharif.ir"، "youtube.com"، "ads.example.org"، "192.168.1.5"، "172.40.0.1"]:
        سرچاپ host، سانسورشکن.دسته‌بندی(classifier، host)
    پایان
    سرچاپ سانسورشکن.تصمیم پراکسی، سانسورشکن.تصمیم مستقیم، سانسورشکن.تصمیم مسدود

    filtered := سانسورشکن.مجموعه فیلترشده()
    سرچاپ سانسورشکن.تطبیق دامنه(filtered، "m.youtube.com")، سانسورشکن.تطبیق دامنه(filtered، "digikala.com")
    سرچاپ سانسورشکن.فهرست مستقیم ایران().شروع با("#")، سانسورشکن.فهرست فیلترشده().دربردارد("youtube.com")
پایان
