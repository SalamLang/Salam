// زبان: فارسی
واردسازی فشرده سازی
واردسازی شبکه.سانسورشکن

پایا HELLO := "160301008c010000880303000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f206465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80818283000613011302c02b0100003900000014001200000f7777772e6578616d706c652e636f6d000a00040002001d0010000e000c02683208687474702f312e31002b0003020304"

تابع total(v: وکتور<صحیح>): صحیح:
    ناپایا sum := 0
    تکرار v.طول() در i:
        sum += v.بگیر(i)
    پایان
    برگشت sum
پایان

تابع ریشه:
    hello := سانسورشکن.از هگز(HELLO)

    even := سانسورشکن.اندازه تکه‌ها(100، سانسورشکن.تقسیم مساوی، 3، 0، 1 برگردان صحیح۶۴)
    سرچاپ even.بگیر(0)، even.بگیر(1)، even.بگیر(2)، total(even)
    random := سانسورشکن.اندازه تکه‌ها(1000، سانسورشکن.تقسیم تصادفی، 5، 0، 42 برگردان صحیح۶۴)
    again := سانسورشکن.اندازه تکه‌ها(1000، سانسورشکن.تقسیم تصادفی، 5، 0، 42 برگردان صحیح۶۴)
    سرچاپ random.طول()، total(random)، random.بگیر(0) برابر again.بگیر(0)، random.بگیر(4) برابر again.بگیر(4)
    first := سانسورشکن.اندازه تکه‌ها(517، سانسورشکن.تقسیم پس از نخستین تکه، 2، 5، 0 برگردان صحیح۶۴)
    سرچاپ first.بگیر(0)، first.بگیر(1)
    سرچاپ سانسورشکن.اندازه تکه‌ها(3، سانسورشکن.تقسیم مساوی، 10، 0، 0 برگردان صحیح۶۴).طول()

    cuts := سانسورشکن.اندازه تکه‌ها از روی نام سرور(hello.داده، hello.طول، نادرست)
    سرچاپ cuts.بگیر(0)، cuts.بگیر(1)، total(cuts)
    lone := سانسورشکن.اندازه تکه‌ها از روی نام سرور(hello.داده، hello.طول، درست)
    سرچاپ lone.طول()، lone.بگیر(0)، lone.بگیر(1)، total(lone)

    ناپایا pieces := سانسورشکن.برش(hello.داده، hello.طول، cuts)
    سرچاپ pieces.طول()، فشرده سازی.برابری بافر(سانسورشکن.پیوست(pieces)، hello)
    سانسورشکن.آزاد کردن تکه‌ها(pieces)

    ناپایا records := سانسورشکن.تکه‌تکه کردن پیام آغازین(hello.داده، hello.طول، 4، سانسورشکن.تقسیم مساوی، 0 برگردان صحیح۶۴)
    سرچاپ records.طول()
    head := records.بگیر(0)
    سرچاپ head.طول، فشرده سازی.دریافت بایت(head، 0)، فشرده سازی.دریافت بایت(head، 1)، فشرده سازی.دریافت بایت(head، 2)
    all := سانسورشکن.پیوست(records)
    سرچاپ all.طول، all.طول برابر hello.طول + 15
    سرچاپ سانسورشکن.تجزیه پیام آغازین(all.داده، all.طول).معتبر، سانسورشکن.تجزیه پیام آغازین(head.داده، head.طول).ناقص
    سانسورشکن.آزاد کردن تکه‌ها(records)

    ناپایا by_hand := سانسورشکن.تکه‌تکه کردن رکوردها(hello.داده، hello.طول، cuts)
    سرچاپ by_hand.طول()، by_hand.بگیر(0).طول، by_hand.بگیر(1).طول
    سانسورشکن.آزاد کردن تکه‌ها(by_hand)
    سرچاپ "not a handshake:"، سانسورشکن.تکه‌تکه کردن پیام آغازین("GET / HTTP/1.1" برگردان تهی*، 14، 3، سانسورشکن.تقسیم مساوی، 0 برگردان صحیح۶۴).طول()
    سرچاپ سانسورشکن.بیشینه داده رکورد
پایان
