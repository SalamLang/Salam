// زبان: فارسی
واردسازی فشرده سازی
واردسازی شبکه.سانسورشکن

پایا HELLO := "160301008c010000880303000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f206465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80818283000613011302c02b0100003900000014001200000f7777772e6578616d706c652e636f6d000a00040002001d0010000e000c02683208687474702f312e31002b0003020304"

تابع total(v: وکتور<صحیح>): صحیح:
    ناپایا جمع := 0
    تکرار v.طول() در شمارنده:
        جمع += v.بگیر(شمارنده)
    پایان
    برگشت جمع
پایان

تابع ریشه:
    متغیر_hello := سانسورشکن.از هگز(HELLO)

    متغیر_even := سانسورشکن.اندازه تکه‌ها(100، سانسورشکن.تقسیم مساوی، 3، 0، 1 برگردان صحیح۶۴)
    سرچاپ متغیر_even.بگیر(0)، متغیر_even.بگیر(1)، متغیر_even.بگیر(2)، total(متغیر_even)
    متغیر_random := سانسورشکن.اندازه تکه‌ها(1000، سانسورشکن.تقسیم تصادفی، 5، 0، 42 برگردان صحیح۶۴)
    دوباره := سانسورشکن.اندازه تکه‌ها(1000، سانسورشکن.تقسیم تصادفی، 5، 0، 42 برگردان صحیح۶۴)
    سرچاپ متغیر_random.طول()، total(متغیر_random)، متغیر_random.بگیر(0) برابر دوباره.بگیر(0)، متغیر_random.بگیر(4) برابر دوباره.بگیر(4)
    نخست := سانسورشکن.اندازه تکه‌ها(517، سانسورشکن.تقسیم پس از نخستین تکه، 2، 5، 0 برگردان صحیح۶۴)
    سرچاپ نخست.بگیر(0)، نخست.بگیر(1)
    سرچاپ سانسورشکن.اندازه تکه‌ها(3، سانسورشکن.تقسیم مساوی، 10، 0، 0 برگردان صحیح۶۴).طول()

    متغیر_cuts := سانسورشکن.اندازه تکه‌ها از روی نام سرور(متغیر_hello.داده، متغیر_hello.طول، نادرست)
    سرچاپ متغیر_cuts.بگیر(0)، متغیر_cuts.بگیر(1)، total(متغیر_cuts)
    متغیر_lone := سانسورشکن.اندازه تکه‌ها از روی نام سرور(متغیر_hello.داده، متغیر_hello.طول، درست)
    سرچاپ متغیر_lone.طول()، متغیر_lone.بگیر(0)، متغیر_lone.بگیر(1)، total(متغیر_lone)

    ناپایا تکه‌ها := سانسورشکن.برش(متغیر_hello.داده، متغیر_hello.طول، متغیر_cuts)
    سرچاپ تکه‌ها.طول()، فشرده سازی.برابری بافر(سانسورشکن.پیوست(تکه‌ها)، متغیر_hello)
    سانسورشکن.آزاد کردن تکه‌ها(تکه‌ها)

    ناپایا رکوردها := سانسورشکن.تکه‌تکه کردن پیام آغازین(متغیر_hello.داده، متغیر_hello.طول، 4، سانسورشکن.تقسیم مساوی، 0 برگردان صحیح۶۴)
    سرچاپ رکوردها.طول()
    سر := رکوردها.بگیر(0)
    سرچاپ سر.طول، فشرده سازی.دریافت بایت(سر، 0)، فشرده سازی.دریافت بایت(سر، 1)، فشرده سازی.دریافت بایت(سر، 2)
    متغیر_all := سانسورشکن.پیوست(رکوردها)
    سرچاپ متغیر_all.طول، متغیر_all.طول برابر متغیر_hello.طول + 15
    سرچاپ سانسورشکن.تجزیه پیام آغازین(متغیر_all.داده، متغیر_all.طول).معتبر، سانسورشکن.تجزیه پیام آغازین(سر.داده، سر.طول).ناقص
    سانسورشکن.آزاد کردن تکه‌ها(رکوردها)

    ناپایا متغیر_by_hand := سانسورشکن.تکه‌تکه کردن رکوردها(متغیر_hello.داده، متغیر_hello.طول، متغیر_cuts)
    سرچاپ متغیر_by_hand.طول()، متغیر_by_hand.بگیر(0).طول، متغیر_by_hand.بگیر(1).طول
    سانسورشکن.آزاد کردن تکه‌ها(متغیر_by_hand)
    سرچاپ "not a handshake:"، سانسورشکن.تکه‌تکه کردن پیام آغازین("GET / HTTP/1.1" برگردان تهی*، 14، 3، سانسورشکن.تقسیم مساوی، 0 برگردان صحیح۶۴).طول()
    سرچاپ سانسورشکن.بیشینه داده رکورد
پایان
