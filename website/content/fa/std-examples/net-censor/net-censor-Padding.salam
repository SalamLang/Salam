// زبان: فارسی
واردسازی فشرده سازی
واردسازی شبکه.سانسورشکن

تابع ریشه:
    بدنه := "secret payload"
    متغیر_wrapped := سانسورشکن.پوشاندن رکورد(بدنه برگردان تهی*، بدنه.طول()، 20)
    سرچاپ متغیر_wrapped.طول، فشرده سازی.دریافت بایت(متغیر_wrapped، 0)، فشرده سازی.دریافت بایت(متغیر_wrapped، 1)، فشرده سازی.دریافت بایت(متغیر_wrapped، 2)
    ناپایا گرفته := فشرده سازی.بافر بایت جدید()
    سرچاپ سانسورشکن.گشودن رکورد(متغیر_wrapped.داده، متغیر_wrapped.طول، گرفته)، گرفته.طول
    سرچاپ "needs more:"، سانسورشکن.گشودن رکورد(متغیر_wrapped.داده، متغیر_wrapped.طول - 1، گرفته)
    سرچاپ "not a record:"، سانسورشکن.گشودن رکورد("GET / HTTP/1.1" برگردان تهی*، 14، گرفته)
    سرچاپ "too big:"، سانسورشکن.پوشاندن رکورد(بدنه برگردان تهی*، 20000، 0).طول

    ناپایا متغیر_big := فشرده سازی.بافر بایت جدید()
    تکرار 40000 در شمارنده:
        فشرده سازی.افزودن بایت(متغیر_big، شمارنده % 251)
    پایان
    متغیر_stream := سانسورشکن.پوشاندن جریان(متغیر_big.داده، متغیر_big.طول، 5، 50)
    ناپایا بازگشت := فشرده سازی.بافر بایت جدید()
    ناپایا متغیر_offset := 0
    ناپایا رکوردها := 0
    تا متغیر_offset کوچکتر متغیر_stream.طول:
        استفاده_شده := سانسورشکن.گشودن رکورد(((متغیر_stream.داده برگردان صحیح۶۴) + (متغیر_offset برگردان صحیح۶۴)) برگردان تهی*، متغیر_stream.طول - متغیر_offset، بازگشت)
        اگر استفاده_شده کوچکتربرابر 0:
            بشکن
        پایان
        متغیر_offset += استفاده_شده
        رکوردها++
    پایان
    سرچاپ رکوردها، فشرده سازی.برابری بافر(بازگشت، متغیر_big)، متغیر_offset برابر متغیر_stream.طول

    سرچاپ سانسورشکن.طول لایه(100، 10، 10، 64)
    سرچاپ سانسورشکن.طول لایه(100، 0، 0، 1)
    سرچاپ سانسورشکن.بایت‌های تصادفی(32).طول، سانسورشکن.عدد تصادفی(5، 5)
    خوانده := سانسورشکن.عدد تصادفی(10، 20)
    سرچاپ خوانده بزرگتربرابر 10، خوانده کوچکتربرابر 20
پایان
