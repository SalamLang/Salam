// زبان: فارسی
واردسازی فشرده سازی
واردسازی شبکه.سانسورشکن

تابع ریشه:
    body := "secret payload"
    wrapped := سانسورشکن.پوشاندن رکورد(body برگردان تهی*، body.طول()، 20)
    سرچاپ wrapped.طول، فشرده سازی.دریافت بایت(wrapped، 0)، فشرده سازی.دریافت بایت(wrapped، 1)، فشرده سازی.دریافت بایت(wrapped، 2)
    ناپایا got := فشرده سازی.بافر بایت جدید()
    سرچاپ سانسورشکن.گشودن رکورد(wrapped.داده، wrapped.طول، got)، got.طول
    سرچاپ "needs more:"، سانسورشکن.گشودن رکورد(wrapped.داده، wrapped.طول - 1، got)
    سرچاپ "not a record:"، سانسورشکن.گشودن رکورد("GET / HTTP/1.1" برگردان تهی*، 14، got)
    سرچاپ "too big:"، سانسورشکن.پوشاندن رکورد(body برگردان تهی*، 20000، 0).طول

    ناپایا big := فشرده سازی.بافر بایت جدید()
    تکرار 40000 در i:
        فشرده سازی.افزودن بایت(big، i % 251)
    پایان
    stream := سانسورشکن.پوشاندن جریان(big.داده، big.طول، 5، 50)
    ناپایا back := فشرده سازی.بافر بایت جدید()
    ناپایا offset := 0
    ناپایا records := 0
    تا offset کوچکتر stream.طول:
        used := سانسورشکن.گشودن رکورد(((stream.داده برگردان صحیح۶۴) + (offset برگردان صحیح۶۴)) برگردان تهی*، stream.طول - offset، back)
        اگر used کوچکتربرابر 0:
            بشکن
        پایان
        offset += used
        records++
    پایان
    سرچاپ records، فشرده سازی.برابری بافر(back، big)، offset برابر stream.طول

    سرچاپ سانسورشکن.طول لایه(100، 10، 10، 64)
    سرچاپ سانسورشکن.طول لایه(100، 0، 0، 1)
    سرچاپ سانسورشکن.بایت‌های تصادفی(32).طول، سانسورشکن.عدد تصادفی(5، 5)
    r := سانسورشکن.عدد تصادفی(10، 20)
    سرچاپ r بزرگتربرابر 10، r کوچکتربرابر 20
پایان
