// زبان: فارسی
واردسازی شبکه.سانسورشکن

تابع ریشه:
    ناپایا guard := سانسورشکن.نگهبان کاوش جدید(3، 1000 برگردان صحیح۶۴، 5000 برگردان صحیح۶۴)
    سرچاپ guard.بیشینه شکست، guard.بازه شمارش، guard.مدت مسدودی
    سرچاپ سانسورشکن.اجازه نگهبان(guard، "1.2.3.4"، 0 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.ثبت شکست(guard، "1.2.3.4"، 100 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(guard، "1.2.3.4"، 200 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(guard، "1.2.3.4"، 300 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.اجازه نگهبان(guard، "1.2.3.4"، 400 برگردان صحیح۶۴)، سانسورشکن.اجازه نگهبان(guard، "5.6.7.8"، 400 برگردان صحیح۶۴)، سانسورشکن.اجازه نگهبان(guard، "1.2.3.4"، 5400 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.ثبت شکست(guard، "9.9.9.9"، 0 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(guard، "9.9.9.9"، 2000 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(guard، "9.9.9.9"، 2100 برگردان صحیح۶۴)
    سانسورشکن.ثبت شکست(guard، "7.7.7.7"، 0 برگردان صحیح۶۴)
    سانسورشکن.ثبت شکست(guard، "7.7.7.7"، 10 برگردان صحیح۶۴)
    سانسورشکن.ثبت موفقیت(guard، "7.7.7.7")
    سرچاپ سانسورشکن.ثبت شکست(guard، "7.7.7.7"، 20 برگردان صحیح۶۴)، guard.شکست‌ها.بگیر("7.7.7.7")
    سانسورشکن.آزاد کردن نگهبان(guard)

    ناپایا cache := سانسورشکن.حافظه تکرار جدید(1000 برگردان صحیح۶۴، 4)
    سرچاپ cache.ماندگاری، cache.بیشینه ورودی
    سرچاپ سانسورشکن.تکراری است(cache، "a"، 0 برگردان صحیح۶۴)، سانسورشکن.تکراری است(cache، "a"، 500 برگردان صحیح۶۴)، سانسورشکن.تکراری است(cache، "a"، 1600 برگردان صحیح۶۴)
    سرچاپ cache.دیده‌شده.اندازه()
    سانسورشکن.آزاد کردن حافظه تکرار(cache)

    سرچاپ سانسورشکن.باید جایگزین شود(نادرست)، سانسورشکن.باید جایگزین شود(درست)
    wait := سانسورشکن.تاخیر تصادفی(5، 20)
    سرچاپ wait بزرگتربرابر 5، wait کوچکتربرابر 20
    سرچاپ سانسورشکن.پاسخ طعمه().زیررشته(0، 22)
    سرچاپ سانسورشکن.پاسخ طعمه().دربردارد("nginx")
پایان
