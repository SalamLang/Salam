// زبان: فارسی
واردسازی شبکه.سانسورشکن

تابع ریشه:
    ناپایا متغیر_guard := سانسورشکن.نگهبان کاوش جدید(3، 1000 برگردان صحیح۶۴، 5000 برگردان صحیح۶۴)
    سرچاپ متغیر_guard.بیشینه شکست، متغیر_guard.بازه شمارش، متغیر_guard.مدت مسدودی
    سرچاپ سانسورشکن.اجازه نگهبان(متغیر_guard، "1.2.3.4"، 0 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.ثبت شکست(متغیر_guard، "1.2.3.4"، 100 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(متغیر_guard، "1.2.3.4"، 200 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(متغیر_guard، "1.2.3.4"، 300 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.اجازه نگهبان(متغیر_guard، "1.2.3.4"، 400 برگردان صحیح۶۴)، سانسورشکن.اجازه نگهبان(متغیر_guard، "5.6.7.8"، 400 برگردان صحیح۶۴)، سانسورشکن.اجازه نگهبان(متغیر_guard، "1.2.3.4"، 5400 برگردان صحیح۶۴)
    سرچاپ سانسورشکن.ثبت شکست(متغیر_guard، "9.9.9.9"، 0 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(متغیر_guard، "9.9.9.9"، 2000 برگردان صحیح۶۴)، سانسورشکن.ثبت شکست(متغیر_guard، "9.9.9.9"، 2100 برگردان صحیح۶۴)
    سانسورشکن.ثبت شکست(متغیر_guard، "7.7.7.7"، 0 برگردان صحیح۶۴)
    سانسورشکن.ثبت شکست(متغیر_guard، "7.7.7.7"، 10 برگردان صحیح۶۴)
    سانسورشکن.ثبت موفقیت(متغیر_guard، "7.7.7.7")
    سرچاپ سانسورشکن.ثبت شکست(متغیر_guard، "7.7.7.7"، 20 برگردان صحیح۶۴)، متغیر_guard.شکست‌ها.بگیر("7.7.7.7")
    سانسورشکن.آزاد کردن نگهبان(متغیر_guard)

    ناپایا متغیر_cache := سانسورشکن.حافظه تکرار جدید(1000 برگردان صحیح۶۴، 4)
    سرچاپ متغیر_cache.ماندگاری، متغیر_cache.بیشینه ورودی
    سرچاپ سانسورشکن.تکراری است(متغیر_cache، "a"، 0 برگردان صحیح۶۴)، سانسورشکن.تکراری است(متغیر_cache، "a"، 500 برگردان صحیح۶۴)، سانسورشکن.تکراری است(متغیر_cache، "a"، 1600 برگردان صحیح۶۴)
    سرچاپ متغیر_cache.دیده‌شده.اندازه()
    سانسورشکن.آزاد کردن حافظه تکرار(متغیر_cache)

    سرچاپ سانسورشکن.باید جایگزین شود(نادرست)، سانسورشکن.باید جایگزین شود(درست)
    متغیر_wait := سانسورشکن.تاخیر تصادفی(5، 20)
    سرچاپ متغیر_wait بزرگتربرابر 5، متغیر_wait کوچکتربرابر 20
    سرچاپ سانسورشکن.پاسخ طعمه().زیررشته(0، 22)
    سرچاپ سانسورشکن.پاسخ طعمه().دربردارد("nginx")
پایان
