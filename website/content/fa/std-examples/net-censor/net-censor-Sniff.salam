// زبان: فارسی
واردسازی شبکه.سانسورشکن

پایا HELLO := "160301008c010000880303000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f206465666768696a6b6c6d6e6f707172737475767778797a7b7c7d7e7f80818283000613011302c02b0100003900000014001200000f7777772e6578616d706c652e636f6d000a00040002001d0010000e000c02683208687474702f312e31002b0003020304"

تابع ریشه:
    hello := سانسورشکن.از هگز(HELLO)
    سرچاپ "hello bytes:"، hello.طول، سانسورشکن.به هگز(hello).طول()
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل(hello.داده، hello.طول))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل("GET / HTTP/1.1" برگردان تهی*، 14))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل("SSH-2.0-OpenSSH_9.6" برگردان تهی*، 19))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل(سانسورشکن.از هگز("050100").داده، 3))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل(سانسورشکن.از هگز("0401005000000001").داده، 8))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل("GE" برگردان تهی*، 2))
    سرچاپ سانسورشکن.نام نوع(سانسورشکن.تشخیص پروتکل("zzzz" برگردان تهی*، 4))
    سرچاپ سانسورشکن.تشخیص پروتکل(hello.داده، hello.طول) برابر سانسورشکن.نوع تی ال اس، سانسورشکن.نوع ناشناخته، سانسورشکن.نوع اچ تی تی پی، سانسورشکن.نوع اس اس اچ، سانسورشکن.نوع ساکس۵، سانسورشکن.نوع ساکس۴، سانسورشکن.نوع داده ناکافی

    ch := سانسورشکن.تجزیه پیام آغازین(hello.داده، hello.طول)
    سرچاپ ch.معتبر، ch.ناقص، ch.طول رکورد
    سرچاپ ch.نام سرور، ch.جایگاه نام سرور، ch.طول نام سرور
    سرچاپ ch.نسخه رکورد، ch.نسخه پیام، ch.طول شناسه نشست، ch.شمار رمزها، ch.شمار افزونه‌ها
    سرچاپ ch.دارای تی ال اس سیزده، ch.دارای ای سی اچ، ch.پروتکل‌های برنامه.طول()، ch.پروتکل‌های برنامه.بگیر(0)، ch.پروتکل‌های برنامه.بگیر(1)
    سرچاپ سانسورشکن.استخراج نام سرور(hello.داده، hello.طول)

    cut := سانسورشکن.تجزیه پیام آغازین(hello.داده، 60)
    سرچاپ "cut short:"، cut.معتبر، cut.ناقص، cut.نام سرور.طول()
    سرچاپ "not tls:"، سانسورشکن.تجزیه پیام آغازین("GET / HTTP/1.1" برگردان تهی*، 14).معتبر
پایان
