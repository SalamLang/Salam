// زبان: فارسی
واردسازی شبکه.دی‌اوه‌اچ

تابع ریشه:
    ناپایا کارسازها := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    کارسازها.بیفزا(دی‌اوه‌اچ.کلودفلر())
    کارسازها.بیفزا(دی‌اوه‌اچ.گوگل دی‌اوه‌تی())
    کارسازها.بیفزا(دی‌اوه‌اچ.کواد نه())
    حل_کننده := دی‌اوه‌اچ.حل‌کننده جدید(کارسازها)
    دی‌اوه‌اچ.تعیین مهلت(حل_کننده، 3000)

    پاسخ_متن := دی‌اوه‌اچ.حل(حل_کننده، "example.com"، 1)
    سرچاپ پاسخ_متن.معتبر، پاسخ_متن.از حافظه، پاسخ_متن.کارگزار، پاسخ_متن.زمان ماندگاری
    هر متغیر_ip در دی‌اوه‌اچ.جستجوی میزبان(حل_کننده، "example.com"):
        سرچاپ متغیر_ip
    پایان

    متغیر_stub := دی‌اوه‌اچ.راه‌اندازی کارگزار محلی(حل_کننده، "127.0.0.1"، 5353)
    سرچاپ "local resolver on port"، متغیر_stub.درگاه
    دی‌اوه‌اچ.توقف کارگزار محلی(متغیر_stub)
پایان
