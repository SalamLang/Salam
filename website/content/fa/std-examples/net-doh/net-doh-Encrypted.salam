// زبان: فارسی
واردسازی شبکه.دی‌اوه‌اچ

تابع ریشه:
    ناپایا servers := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    servers.بیفزا(دی‌اوه‌اچ.کلودفلر())
    servers.بیفزا(دی‌اوه‌اچ.گوگل دی‌اوه‌تی())
    servers.بیفزا(دی‌اوه‌اچ.کواد نه())
    resolver := دی‌اوه‌اچ.حل‌کننده جدید(servers)
    دی‌اوه‌اچ.تعیین مهلت(resolver، 3000)

    answer := دی‌اوه‌اچ.حل(resolver، "example.com"، 1)
    سرچاپ answer.معتبر، answer.از حافظه، answer.کارگزار، answer.زمان ماندگاری
    هر ip در دی‌اوه‌اچ.جستجوی میزبان(resolver، "example.com"):
        سرچاپ ip
    پایان

    stub := دی‌اوه‌اچ.راه‌اندازی کارگزار محلی(resolver، "127.0.0.1"، 5353)
    سرچاپ "local resolver on port"، stub.درگاه
    دی‌اوه‌اچ.توقف کارگزار محلی(stub)
پایان
