// زبان: فارسی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی همگام سازی

ناپایا http_port := 0
ناپایا methods := ""
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع find_text(b: فشرده سازی.بافر بایت، pattern: رشته): صحیح:
    n := pattern.طول()
    ناپایا i := 0
    تا i + n کوچکتربرابر b.طول:
        ناپایا same := درست
        تکرار n در j:
            اگر فشرده سازی.دریافت بایت(b، i + j) نابرابر (pattern برگردان طبیعی۸*)[j] برگردان صحیح:
                same = نادرست
                بشکن
            پایان
        پایان
        اگر same:
            برگشت i
        پایان
        i++
    پایان
    برگشت 0 - 1
پایان

تابع text_at(b: فشرده سازی.بافر بایت، off: صحیح، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، ((b.داده برگردان صحیح۶۴) + (off برگردان صحیح۶۴)) برگردان تهی*، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع from_base64url(s: رشته): فشرده سازی.بافر بایت:
    alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    ناپایا out := فشرده سازی.بافر بایت جدید()
    ناپایا acc := 0
    ناپایا bits := 0
    تکرار s.طول() در i:
        v := alphabet.بیاب(s.زیررشته(i، 1))
        اگر v کوچکتر 0:
            بشکن
        پایان
        acc = (acc << 6) | v
        bits += 6
        اگر bits بزرگتربرابر 8:
            bits -= 8
            فشرده سازی.افزودن بایت(out، (acc >> bits) & 255)
            acc = acc & ((1 << bits) - 1)
        پایان
    پایان
    برگشت out
پایان

تابع serve_one(c: تی سی پی.اتصال شبکه):
    ناپایا raw := فشرده سازی.بافر بایت جدید()
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    ناپایا head_end := 0 - 1
    ناپایا need := 0
    تا درست:
        n := تی سی پی.خواندن بایت(c، buf، 4096)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        فشرده سازی.افزودن بایت‌ها(raw، buf، n)
        head_end = find_text(raw، "\r\n\r\n")
        اگر head_end بزرگتربرابر 0:
            head := رشته.کوچک(text_at(raw، 0، head_end))
            at := head.بیاب("content-length:")
            اگر at بزرگتربرابر 0:
                rest := head.زیررشته(at + 15، head.طول() - at - 15)
                ناپایا line_end := rest.بیاب("\r\n")
                اگر line_end کوچکتر 0:
                    line_end = rest.طول()
                پایان
                need = رشته.پیرایش(rest.زیررشته(0، line_end)).به صحیح()
            پایان
            اگر raw.طول بزرگتربرابر head_end + 4 + need:
                بشکن
            پایان
        پایان
    پایان
    ناپایا wire := فشرده سازی.بافر بایت جدید()
    اگر text_at(raw، 0، 4) برابر "POST":
        methods += "POST "
        فشرده سازی.افزودن بایت‌ها(wire، ((raw.داده برگردان صحیح۶۴) + (head_end برگردان صحیح۶۴) + 4) برگردان تهی*، need)
    وگرنه:
        methods += "GET "
        line := text_at(raw، 0، find_text(raw، "\r\n"))
        rest := line.زیررشته(line.بیاب("dns=") + 4، line.طول())
        wire = from_base64url(rest.زیررشته(0، rest.بیاب(" ")))
    پایان
    question := دی‌ان‌اس.کدگشایی(wire.داده، wire.طول)
    asked := question.پرسش‌ها.پرسش‌ها.بگیر(0)
    ناپایا records := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    records.بیفزا(دی‌ان‌اس.رکورد { نام دامنه = asked.نام دامنه، نوع رکورد = دی‌ان‌اس.نوع آ، رده = 1، زمان ماندگاری = 300، داده = "192.0.2.80" })
    answer := دی‌اوه‌اچ.کدگذاری پاسخ(question.شناسه، asked.نام دامنه، asked.نوع رکورد، 0، records)
    head := "HTTP/1.1 200 OK\r\nContent-Type: application/dns-message\r\nConnection: close\r\nContent-Length: " + answer.طول + "\r\n\r\n"
    تی سی پی.نوشتن(c، head)
    تی سی پی.نوشتن بایت(c، answer.داده، answer.طول)
    تی سی پی.بستن(c)
پایان

تابع http_server():
    srv := تی سی پی.پیوند(0)
    http_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        serve_one(تی سی پی.پذیرش(srv))
    پایان
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(http_server)
    همگام سازی.انتظار(ready)
    base := "http://127.0.0.1:" + http_port + "/dns-query"

    post := دی‌اوه‌اچ.کارگزار جدید("post"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ پست، base)
    سرچاپ post.با تی ال اس، post.درگاه برابر http_port، post.مسیر
    r := دی‌اوه‌اچ.پرسش(post، "web.test"، دی‌ان‌اس.نوع آ، 2000)
    سرچاپ r.معتبر، r.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده

    get := دی‌اوه‌اچ.کارگزار جدید("get"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ گت، base)
    g := دی‌اوه‌اچ.پرسش(get، "web.test"، دی‌ان‌اس.نوع آ، 2000)
    سرچاپ g.معتبر، g.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده
    سرچاپ methods
پایان
