// زبان: فارسی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.تی سی پی
واردسازی رشته
واردسازی همگام سازی

ناپایا متغیر_http_port := 0
ناپایا متغیر_methods := ""
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع find_text(b: فشرده سازی.بافر بایت، pattern: رشته): صحیح:
    تعداد := pattern.طول()
    ناپایا شمارنده := 0
    تا شمارنده + تعداد کوچکتربرابر b.طول:
        ناپایا متغیر_same := درست
        تکرار تعداد در شمارنده۲:
            اگر فشرده سازی.دریافت بایت(b، شمارنده + شمارنده۲) نابرابر (pattern برگردان طبیعی۸*)[شمارنده۲] برگردان صحیح:
                متغیر_same = نادرست
                بشکن
            پایان
        پایان
        اگر متغیر_same:
            برگشت شمارنده
        پایان
        شمارنده++
    پایان
    برگشت 0 - 1
پایان

تابع text_at(b: فشرده سازی.بافر بایت، off: صحیح، تعداد: صحیح): رشته:
    بافر := حافظه.تخصیص((تعداد + 1) برگردان طبیعی۶۴)
    حافظه.کپی(بافر، ((b.داده برگردان صحیح۶۴) + (off برگردان صحیح۶۴)) برگردان تهی*، تعداد برگردان طبیعی۶۴)
    (بافر برگردان طبیعی۸*)[تعداد] = 0 برگردان طبیعی۸
    برگشت بافر برگردان رشته
پایان

تابع from_base64url(s: رشته): فشرده سازی.بافر بایت:
    متغیر_alphabet := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-_"
    ناپایا خروجی_مقدار := فشرده سازی.بافر بایت جدید()
    ناپایا متغیر_acc := 0
    ناپایا متغیر_bits := 0
    تکرار s.طول() در شمارنده:
        مقدار_محلی := متغیر_alphabet.بیاب(s.زیررشته(شمارنده، 1))
        اگر مقدار_محلی کوچکتر 0:
            بشکن
        پایان
        متغیر_acc = (متغیر_acc << 6) | مقدار_محلی
        متغیر_bits += 6
        اگر متغیر_bits بزرگتربرابر 8:
            متغیر_bits -= 8
            فشرده سازی.افزودن بایت(خروجی_مقدار، (متغیر_acc >> متغیر_bits) & 255)
            متغیر_acc = متغیر_acc & ((1 << متغیر_bits) - 1)
        پایان
    پایان
    برگشت خروجی_مقدار
پایان

تابع serve_one(c: تی سی پی.اتصال شبکه):
    ناپایا خام := فشرده سازی.بافر بایت جدید()
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    ناپایا متغیر_head_end := 0 - 1
    ناپایا متغیر_need := 0
    تا درست:
        تعداد := تی سی پی.خواندن بایت(c، بافر، 4096)
        اگر تعداد کوچکتربرابر 0:
            بشکن
        پایان
        فشرده سازی.افزودن بایت‌ها(خام، بافر، تعداد)
        متغیر_head_end = find_text(خام، "\r\n\r\n")
        اگر متغیر_head_end بزرگتربرابر 0:
            سر := رشته.کوچک(text_at(خام، 0، متغیر_head_end))
            متغیر_at := سر.بیاب("content-length:")
            اگر متغیر_at بزرگتربرابر 0:
                آرام := سر.زیررشته(متغیر_at + 15، سر.طول() - متغیر_at - 15)
                ناپایا متغیر_line_end := آرام.بیاب("\r\n")
                اگر متغیر_line_end کوچکتر 0:
                    متغیر_line_end = آرام.طول()
                پایان
                متغیر_need = رشته.پیرایش(آرام.زیررشته(0، متغیر_line_end)).به صحیح()
            پایان
            اگر خام.طول بزرگتربرابر متغیر_head_end + 4 + متغیر_need:
                بشکن
            پایان
        پایان
    پایان
    ناپایا سیم := فشرده سازی.بافر بایت جدید()
    اگر text_at(خام، 0، 4) برابر "POST":
        متغیر_methods += "POST "
        فشرده سازی.افزودن بایت‌ها(سیم، ((خام.داده برگردان صحیح۶۴) + (متغیر_head_end برگردان صحیح۶۴) + 4) برگردان تهی*، متغیر_need)
    وگرنه:
        متغیر_methods += "GET "
        خط := text_at(خام، 0، find_text(خام، "\r\n"))
        آرام := خط.زیررشته(خط.بیاب("dns=") + 4، خط.طول())
        سیم = from_base64url(آرام.زیررشته(0، آرام.بیاب(" ")))
    پایان
    پرسش := دی‌ان‌اس.کدگشایی(سیم.داده، سیم.طول)
    پرسیده := پرسش.پرسش‌ها.پرسش‌ها.بگیر(0)
    ناپایا رکوردها := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    رکوردها.بیفزا(دی‌ان‌اس.رکورد { نام دامنه = پرسیده.نام دامنه، نوع رکورد = دی‌ان‌اس.نوع آ، رده = 1، زمان ماندگاری = 300، داده = "192.0.2.80" })
    پاسخ_متن := دی‌اوه‌اچ.کدگذاری پاسخ(پرسش.شناسه، پرسیده.نام دامنه، پرسیده.نوع رکورد، 0، رکوردها)
    سر := "HTTP/1.1 200 OK\r\nContent-Type: application/dns-message\r\nConnection: close\r\nContent-Length: " + پاسخ_متن.طول + "\r\n\r\n"
    تی سی پی.نوشتن(c، سر)
    تی سی پی.نوشتن بایت(c، پاسخ_متن.داده، پاسخ_متن.طول)
    تی سی پی.بستن(c)
پایان

تابع http_server():
    کارساز := تی سی پی.پیوند(0)
    متغیر_http_port = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    تا درست:
        serve_one(تی سی پی.پذیرش(کارساز))
    پایان
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    متغیر__t := نخ‌ساز(http_server)
    همگام سازی.انتظار(آماده)
    متغیر_base := "http://127.0.0.1:" + متغیر_http_port + "/dns-query"

    متغیر_post := دی‌اوه‌اچ.کارگزار جدید("post"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ پست، متغیر_base)
    سرچاپ متغیر_post.با تی ال اس، متغیر_post.درگاه برابر متغیر_http_port، متغیر_post.مسیر
    خوانده := دی‌اوه‌اچ.پرسش(متغیر_post، "web.test"، دی‌ان‌اس.نوع آ، 2000)
    سرچاپ خوانده.معتبر، خوانده.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده

    متغیر_get := دی‌اوه‌اچ.کارگزار جدید("get"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ گت، متغیر_base)
    جی := دی‌اوه‌اچ.پرسش(متغیر_get، "web.test"، دی‌ان‌اس.نوع آ، 2000)
    سرچاپ جی.معتبر، جی.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده
    سرچاپ متغیر_methods
پایان
