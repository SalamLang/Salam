// زبان: فارسی
واردسازی فشرده سازی
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ

تابع ریشه:
    سرچاپ دی‌اوه‌اچ.نشانی آی‌پی است("1.2.3.4")، دی‌اوه‌اچ.نشانی آی‌پی است("2001:db8::1")، دی‌اوه‌اچ.نشانی آی‌پی است("dns.google")، دی‌اوه‌اچ.نشانی آی‌پی است("1.2.3")
    url := دی‌اوه‌اچ.تجزیه نشانی وب("https://dns.example.net/dns-query")
    سرچاپ url.معتبر، url.با تی ال اس، url.میزبان، url.درگاه، url.مسیر
    plain := دی‌اوه‌اچ.تجزیه نشانی وب("http://127.0.0.1:8053")
    سرچاپ plain.معتبر، plain.با تی ال اس، plain.درگاه، plain.مسیر
    سرچاپ دی‌اوه‌اچ.تجزیه نشانی وب("ftp://x").معتبر

    ناپایا v4 := فشرده سازی.بافر بایت جدید()
    سرچاپ دی‌اوه‌اچ.تجزیه آی‌پی۴("10.0.0.7"، v4)، v4.طول
    ناپایا v6 := فشرده سازی.بافر بایت جدید()
    سرچاپ دی‌اوه‌اچ.تجزیه آی‌پی۶("2001:db8::7"، v6)، v6.طول
    سرچاپ دی‌اوه‌اچ.تجزیه آی‌پی۴("10.0.0"، فشرده سازی.بافر بایت جدید())

    ناپایا records := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    records.بیفزا(دی‌ان‌اس.رکورد { نام دامنه = "example.test"، نوع رکورد = دی‌ان‌اس.نوع آ، رده = 1، زمان ماندگاری = 300، داده = "192.0.2.7" })
    wire := دی‌اوه‌اچ.کدگذاری پاسخ(4242، "example.test"، دی‌ان‌اس.نوع آ، 0، records)
    message := دی‌ان‌اس.کدگشایی(wire.داده، wire.طول)
    سرچاپ message.شناسه، message.نشانه پاسخ، message.کد نتیجه، message.پرسش‌ها.پرسش‌ها.طول()، message.پاسخ‌ها.رکوردها.طول()
    answer := message.پاسخ‌ها.رکوردها.بگیر(0)
    سرچاپ answer.نام دامنه، answer.زمان ماندگاری، answer.داده
    nx := دی‌اوه‌اچ.کدگذاری پاسخ(7، "nothing.test"، دی‌ان‌اس.نوع آ، 3، وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>)
    سرچاپ دی‌ان‌اس.کدگشایی(nx.داده، nx.طول).کد نتیجه
پایان
