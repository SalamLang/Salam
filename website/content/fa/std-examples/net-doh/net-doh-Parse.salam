// زبان: فارسی
واردسازی فشرده سازی
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ

تابع ریشه:
    سرچاپ دی‌اوه‌اچ.نشانی آی‌پی است("1.2.3.4")، دی‌اوه‌اچ.نشانی آی‌پی است("2001:db8::1")، دی‌اوه‌اچ.نشانی آی‌پی است("dns.google")، دی‌اوه‌اچ.نشانی آی‌پی است("1.2.3")
    نشانی := دی‌اوه‌اچ.تجزیه نشانی وب("https://dns.example.net/dns-query")
    سرچاپ نشانی.معتبر، نشانی.با تی ال اس، نشانی.میزبان، نشانی.درگاه، نشانی.مسیر
    ساده := دی‌اوه‌اچ.تجزیه نشانی وب("http://127.0.0.1:8053")
    سرچاپ ساده.معتبر، ساده.با تی ال اس، ساده.درگاه، ساده.مسیر
    سرچاپ دی‌اوه‌اچ.تجزیه نشانی وب("ftp://x").معتبر

    ناپایا متغیر_v4 := فشرده سازی.بافر بایت جدید()
    سرچاپ دی‌اوه‌اچ.تجزیه آی‌پی۴("10.0.0.7"، متغیر_v4)، متغیر_v4.طول
    ناپایا متغیر_v6 := فشرده سازی.بافر بایت جدید()
    سرچاپ دی‌اوه‌اچ.تجزیه آی‌پی۶("2001:db8::7"، متغیر_v6)، متغیر_v6.طول
    سرچاپ دی‌اوه‌اچ.تجزیه آی‌پی۴("10.0.0"، فشرده سازی.بافر بایت جدید())

    ناپایا رکوردها := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    رکوردها.بیفزا(دی‌ان‌اس.رکورد { نام دامنه = "example.test"، نوع رکورد = دی‌ان‌اس.نوع آ، رده = 1، زمان ماندگاری = 300، داده = "192.0.2.7" })
    سیم := دی‌اوه‌اچ.کدگذاری پاسخ(4242، "example.test"، دی‌ان‌اس.نوع آ، 0، رکوردها)
    پیام_متن := دی‌ان‌اس.کدگشایی(سیم.داده، سیم.طول)
    سرچاپ پیام_متن.شناسه، پیام_متن.نشانه پاسخ، پیام_متن.کد نتیجه، پیام_متن.پرسش‌ها.پرسش‌ها.طول()، پیام_متن.پاسخ‌ها.رکوردها.طول()
    پاسخ_متن := پیام_متن.پاسخ‌ها.رکوردها.بگیر(0)
    سرچاپ پاسخ_متن.نام دامنه، پاسخ_متن.زمان ماندگاری، پاسخ_متن.داده
    متغیر_nx := دی‌اوه‌اچ.کدگذاری پاسخ(7، "nothing.test"، دی‌ان‌اس.نوع آ، 3، وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>)
    سرچاپ دی‌ان‌اس.کدگشایی(متغیر_nx.داده، متغیر_nx.طول).کد نتیجه
پایان
