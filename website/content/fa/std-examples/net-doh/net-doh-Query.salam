// زبان: فارسی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.یو دی پی
واردسازی همگام سازی

ناپایا درگاه_یودی‌پی := 0
ناپایا پرس_وجوها := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع record(name: رشته، rtype: صحیح، ttl: صحیح، data: رشته): دی‌ان‌اس.رکورد:
    برگشت دی‌ان‌اس.رکورد { نام دامنه = name، نوع رکورد = rtype، رده = 1، زمان ماندگاری = ttl، داده = data }
پایان

تابع answer_for(p: تهی*، تعداد: صحیح): فشرده سازی.بافر بایت:
    پرس_وجوها++
    پرسش := دی‌ان‌اس.کدگشایی(p، تعداد)
    پرسیده := پرسش.پرسش‌ها.پرسش‌ها.بگیر(0)
    ناپایا رکوردها := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    ناپایا کد_بازگشت := 0
    اگر پرسیده.نام دامنه برابر "a.test" و پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع آ:
        رکوردها.بیفزا(record("a.test"، دی‌ان‌اس.نوع آ، 120، "10.0.0.1"))
        رکوردها.بیفزا(record("a.test"، دی‌ان‌اس.نوع آ، 300، "10.0.0.2"))
    وگرنه پرسیده.نام دامنه برابر "v6.test" و پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع کواداِی:
        رکوردها.بیفزا(record("v6.test"، دی‌ان‌اس.نوع کواداِی، 300، "2001:db8::5"))
    وگرنه پرسیده.نام دامنه برابر "txt.test" و پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع تی‌ایکس‌تی:
        رکوردها.بیفزا(record("txt.test"، دی‌ان‌اس.نوع تی‌ایکس‌تی، 60، "hello world"))
    وگرنه پرسیده.نام دامنه برابر "alias.test":
        رکوردها.بیفزا(record("alias.test"، دی‌ان‌اس.نوع سی‌نیم، 60، "target.test"))
        اگر پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع آ:
            رکوردها.بیفزا(record("target.test"، دی‌ان‌اس.نوع آ، 60، "10.9.9.9"))
        پایان
    وگرنه:
        کد_بازگشت = 3
    پایان
    برگشت دی‌اوه‌اچ.کدگذاری پاسخ(پرسش.شناسه، پرسیده.نام دامنه، پرسیده.نوع رکورد، کد_بازگشت، رکوردها)
پایان

تابع udp_server():
    متن_نمونه := یو دی پی.پیوند(0)
    درگاه_یودی‌پی = یو دی پی.درگاه(متن_نمونه)
    همگام سازی.اتمام(آماده)
    بافر := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    ناپایا از_میزبان := ""
    ناپایا از_درگاه := 0
    تا درست:
        تعداد := یو دی پی.دریافت بایت(متن_نمونه، بافر، 2048، از_میزبان، از_درگاه)
        اگر تعداد بزرگتر 0:
            پاسخ_متن := answer_for(بافر، تعداد)
            یو دی پی.ارسال بایت(متن_نمونه، از_میزبان، از_درگاه، پاسخ_متن.داده، پاسخ_متن.طول)
        پایان
    پایان
پایان

تابع start_mock():
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    متغیر__t := نخ‌ساز(udp_server)
    همگام سازی.انتظار(آماده)
پایان

تابع mock_server(name: رشته): دی‌اوه‌اچ.کارگزار:
    ناپایا کارساز := دی‌اوه‌اچ.کارگزار ساده جدید(name، "127.0.0.1")
    کارساز.درگاه = درگاه_یودی‌پی
    برگشت کارساز
پایان

تابع ریشه:
    start_mock()
    کارساز := mock_server("mock")
    سرچاپ کارساز.نوع برابر دی‌اوه‌اچ.نوع یو دی پی ساده، کارساز.درگاه برابر درگاه_یودی‌پی، کارساز.با تی ال اس، کارساز.نشانی‌های راه‌انداز.بگیر(0)

    ناپایا خوانده := دی‌اوه‌اچ.پرسش(کارساز، "a.test"، دی‌ان‌اس.نوع آ، 2000)
    سرچاپ خوانده.معتبر، خوانده.کارگزار، خوانده.پیام.کد نتیجه، خوانده.پیام.پاسخ‌ها.رکوردها.طول()، خوانده.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده
    سرچاپ خوانده.پاسخ خام.طول بزرگتر 12، خوانده.خطا.طول()
    دی‌اوه‌اچ.آزاد کردن پاسخ(خوانده)

    ناپایا متغیر_direct := دی‌اوه‌اچ.پرسش از نشانی(کارساز، "127.0.0.1"، "v6.test"، دی‌ان‌اس.نوع کواداِی، 2000)
    سرچاپ متغیر_direct.معتبر، متغیر_direct.پیام.پاسخ‌ها.رکوردها.بگیر(0).داده
    دی‌اوه‌اچ.آزاد کردن پاسخ(متغیر_direct)

    ناپایا گمشده := دی‌اوه‌اچ.پرسش(کارساز، "nothing.test"، دی‌ان‌اس.نوع آ، 2000)
    سرچاپ "missing name:"، گمشده.معتبر، گمشده.پیام.کد نتیجه، گمشده.پیام.پاسخ‌ها.رکوردها.طول()
    دی‌اوه‌اچ.آزاد کردن پاسخ(گمشده)

    متغیر_dead := دی‌اوه‌اچ.کارگزار جدید("dead"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ پست، "http://127.0.0.1:1/dns-query")
    متغیر_failed := دی‌اوه‌اچ.پرسش(متغیر_dead، "a.test"، دی‌ان‌اس.نوع آ، 500)
    سرچاپ "dead server:"، متغیر_failed.معتبر، متغیر_failed.خطا.طول() بزرگتر 0
پایان
