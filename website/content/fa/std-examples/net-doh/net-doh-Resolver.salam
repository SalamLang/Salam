// زبان: فارسی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.یو دی پی
واردسازی همگام سازی

ناپایا درگاه_یودی‌پی := 0
ناپایا پرس_وجوها := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع record(name: رشته، rtype: صحیح، ttl: صحیح، data: رشته): دی‌ان‌اس.رکورد:
    برگشت دی‌ان‌اس.رکورد { نام دامنه = name، نوع رکورد = rtype، رده = 1، زمان ماندگاری = ttl، داده = data }
پایان

تابع answer_for(p: تهی*، تعداد: صحیح): فشرده سازی.بافر بایت:
    پرس_وجوها++
    پرسش := دی‌ان‌اس.کدگشایی(p، تعداد)
    پرسیده := پرسش.پرسش‌ها.پرسش‌ها.بگیر(0)
    ناپایا رکوردها := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    ناپایا کد_بازگشت := 0
    اگر پرسیده.نام دامنه برابر "a.test" و پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع آ:
        رکوردها.بیفزا(record("a.test"، دی‌ان‌اس.نوع آ، 120، "10.0.0.1"))
        رکوردها.بیفزا(record("a.test"، دی‌ان‌اس.نوع آ، 300، "10.0.0.2"))
    وگرنه پرسیده.نام دامنه برابر "v6.test" و پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع کواداِی:
        رکوردها.بیفزا(record("v6.test"، دی‌ان‌اس.نوع کواداِی، 300، "2001:db8::5"))
    وگرنه پرسیده.نام دامنه برابر "txt.test" و پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع تی‌ایکس‌تی:
        رکوردها.بیفزا(record("txt.test"، دی‌ان‌اس.نوع تی‌ایکس‌تی، 60، "hello world"))
    وگرنه پرسیده.نام دامنه برابر "alias.test":
        رکوردها.بیفزا(record("alias.test"، دی‌ان‌اس.نوع سی‌نیم، 60، "target.test"))
        اگر پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع آ:
            رکوردها.بیفزا(record("target.test"، دی‌ان‌اس.نوع آ، 60، "10.9.9.9"))
        پایان
    وگرنه:
        کد_بازگشت = 3
    پایان
    برگشت دی‌اوه‌اچ.کدگذاری پاسخ(پرسش.شناسه، پرسیده.نام دامنه، پرسیده.نوع رکورد، کد_بازگشت، رکوردها)
پایان

تابع udp_server():
    متن_نمونه := یو دی پی.پیوند(0)
    درگاه_یودی‌پی = یو دی پی.درگاه(متن_نمونه)
    همگام سازی.اتمام(آماده)
    بافر := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    ناپایا از_میزبان := ""
    ناپایا از_درگاه := 0
    تا درست:
        تعداد := یو دی پی.دریافت بایت(متن_نمونه، بافر، 2048، از_میزبان، از_درگاه)
        اگر تعداد بزرگتر 0:
            پاسخ_متن := answer_for(بافر، تعداد)
            یو دی پی.ارسال بایت(متن_نمونه، از_میزبان، از_درگاه، پاسخ_متن.داده، پاسخ_متن.طول)
        پایان
    پایان
پایان

تابع start_mock():
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    متغیر__t := نخ‌ساز(udp_server)
    همگام سازی.انتظار(آماده)
پایان

تابع mock_server(name: رشته): دی‌اوه‌اچ.کارگزار:
    ناپایا کارساز := دی‌اوه‌اچ.کارگزار ساده جدید(name، "127.0.0.1")
    کارساز.درگاه = درگاه_یودی‌پی
    برگشت کارساز
پایان

تابع first(v: وکتور<رشته>): رشته:
    اگر v.طول() برابر 0:
        برگشت "none"
    پایان
    برگشت v.بگیر(0)
پایان

تابع ریشه:
    start_mock()
    ناپایا کارسازها := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    کارسازها.بیفزا(mock_server("mock"))
    حل_کننده := دی‌اوه‌اچ.حل‌کننده جدید(کارسازها)
    دی‌اوه‌اچ.تعیین مهلت(حل_کننده، 2000)
    دی‌اوه‌اچ.تعیین حدود ماندگاری(حل_کننده، 30، 3600، 15)

    ناپایا الف := دی‌اوه‌اچ.حل در زمان(حل_کننده، "a.test"، دی‌ان‌اس.نوع آ، 1000 برگردان صحیح۶۴)
    سرچاپ الف.معتبر، الف.از حافظه، الف.زمان ماندگاری، الف.منفی، الف.کد نتیجه، الف.پیام.پاسخ‌ها.رکوردها.طول()، پرس_وجوها
    ناپایا دوباره := دی‌اوه‌اچ.حل در زمان(حل_کننده، "a.test"، دی‌ان‌اس.نوع آ، 61000 برگردان صحیح۶۴)
    سرچاپ دوباره.از حافظه، دوباره.زمان ماندگاری، پرس_وجوها
    ناپایا متغیر_later := دی‌اوه‌اچ.حل در زمان(حل_کننده، "a.test"، دی‌ان‌اس.نوع آ، 200000 برگردان صحیح۶۴)
    سرچاپ متغیر_later.از حافظه، متغیر_later.زمان ماندگاری، پرس_وجوها
    دی‌اوه‌اچ.آزاد کردن پاسخ نهایی(الف)
    دی‌اوه‌اچ.آزاد کردن پاسخ نهایی(دوباره)
    دی‌اوه‌اچ.آزاد کردن پاسخ نهایی(متغیر_later)

    متغیر_n1 := دی‌اوه‌اچ.حل در زمان(حل_کننده، "nothing.test"، دی‌ان‌اس.نوع آ، 500000 برگردان صحیح۶۴)
    سرچاپ متغیر_n1.معتبر، متغیر_n1.منفی، متغیر_n1.کد نتیجه، متغیر_n1.زمان ماندگاری، متغیر_n1.از حافظه
    متغیر_n2 := دی‌اوه‌اچ.حل در زمان(حل_کننده، "nothing.test"، دی‌ان‌اس.نوع آ، 505000 برگردان صحیح۶۴)
    سرچاپ متغیر_n2.از حافظه، متغیر_n2.منفی، پرس_وجوها
    ناپایا متغیر_live := دی‌اوه‌اچ.حل(حل_کننده، "a.test"، دی‌ان‌اس.نوع آ)
    سرچاپ متغیر_live.معتبر، متغیر_live.از حافظه
    دی‌اوه‌اچ.آزاد کردن پاسخ نهایی(متغیر_live)

    سرچاپ first(دی‌اوه‌اچ.جستجوی آ(حل_کننده، "a.test"))، دی‌اوه‌اچ.جستجوی آ(حل_کننده، "a.test").طول()
    سرچاپ first(دی‌اوه‌اچ.جستجوی کواداِی(حل_کننده، "v6.test"))، first(دی‌اوه‌اچ.جستجوی تی‌ایکس‌تی(حل_کننده، "txt.test"))
    سرچاپ دی‌اوه‌اچ.جستجوی سی‌نیم(حل_کننده، "alias.test")، first(دی‌اوه‌اچ.جستجوی میزبان(حل_کننده، "alias.test"))، first(دی‌اوه‌اچ.جستجوی میزبان(حل_کننده، "5.6.7.8"))

    آمار := دی‌اوه‌اچ.آمار(حل_کننده)
    سرچاپ آمار.برخورد حافظه بزرگتر 0، آمار.ناکامی حافظه بزرگتر 0، آمار.پرسش بالادست بزرگتر 0، آمار.شکست‌ها
    سرچاپ دی‌اوه‌اچ.اندازه حافظه(حل_کننده) بزرگتر 0
    دی‌اوه‌اچ.پاک کردن حافظه(حل_کننده)
    سرچاپ دی‌اوه‌اچ.اندازه حافظه(حل_کننده)

    ناپایا متغیر_dead := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    متغیر_dead.بیفزا(دی‌اوه‌اچ.کارگزار جدید("dead"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ پست، "http://127.0.0.1:1/dns-query"))
    خراب := دی‌اوه‌اچ.حل‌کننده جدید(متغیر_dead)
    دی‌اوه‌اچ.تعیین مهلت(خراب، 300)
    متغیر_failed := دی‌اوه‌اچ.حل(خراب، "a.test"، دی‌ان‌اس.نوع آ)
    سرچاپ متغیر_failed.معتبر، متغیر_failed.خطا.طول() بزرگتر 0، دی‌اوه‌اچ.آمار(خراب).شکست‌ها
    سرچاپ first(دی‌اوه‌اچ.جستجوی آ(خراب، "a.test"))

    ناپایا متغیر_helper := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    متغیر_helper.بیفزا(mock_server("bootstrap"))
    دی‌اوه‌اچ.تعیین کارگزارهای راه‌انداز(خراب، متغیر_helper)
    سرچاپ "bootstrap set"
پایان
