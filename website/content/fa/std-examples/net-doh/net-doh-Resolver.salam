// زبان: فارسی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.یو دی پی
واردسازی همگام سازی

ناپایا udp_port := 0
ناپایا queries := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع record(name: رشته، rtype: صحیح، ttl: صحیح، data: رشته): دی‌ان‌اس.رکورد:
    برگشت دی‌ان‌اس.رکورد { نام دامنه = name، نوع رکورد = rtype، رده = 1، زمان ماندگاری = ttl، داده = data }
پایان

تابع answer_for(p: تهی*، n: صحیح): فشرده سازی.بافر بایت:
    queries++
    question := دی‌ان‌اس.کدگشایی(p، n)
    asked := question.پرسش‌ها.پرسش‌ها.بگیر(0)
    ناپایا records := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    ناپایا rcode := 0
    اگر asked.نام دامنه برابر "a.test" و asked.نوع رکورد برابر دی‌ان‌اس.نوع آ:
        records.بیفزا(record("a.test"، دی‌ان‌اس.نوع آ، 120، "10.0.0.1"))
        records.بیفزا(record("a.test"، دی‌ان‌اس.نوع آ، 300، "10.0.0.2"))
    وگرنه asked.نام دامنه برابر "v6.test" و asked.نوع رکورد برابر دی‌ان‌اس.نوع کواداِی:
        records.بیفزا(record("v6.test"، دی‌ان‌اس.نوع کواداِی، 300، "2001:db8::5"))
    وگرنه asked.نام دامنه برابر "txt.test" و asked.نوع رکورد برابر دی‌ان‌اس.نوع تی‌ایکس‌تی:
        records.بیفزا(record("txt.test"، دی‌ان‌اس.نوع تی‌ایکس‌تی، 60، "hello world"))
    وگرنه asked.نام دامنه برابر "alias.test":
        records.بیفزا(record("alias.test"، دی‌ان‌اس.نوع سی‌نیم، 60، "target.test"))
        اگر asked.نوع رکورد برابر دی‌ان‌اس.نوع آ:
            records.بیفزا(record("target.test"، دی‌ان‌اس.نوع آ، 60، "10.9.9.9"))
        پایان
    وگرنه:
        rcode = 3
    پایان
    برگشت دی‌اوه‌اچ.کدگذاری پاسخ(question.شناسه، asked.نام دامنه، asked.نوع رکورد، rcode، records)
پایان

تابع udp_server():
    s := یو دی پی.پیوند(0)
    udp_port = یو دی پی.درگاه(s)
    همگام سازی.اتمام(ready)
    buf := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    ناپایا from_host := ""
    ناپایا from_port := 0
    تا درست:
        n := یو دی پی.دریافت بایت(s، buf، 2048، from_host، from_port)
        اگر n بزرگتر 0:
            answer := answer_for(buf، n)
            یو دی پی.ارسال بایت(s، from_host، from_port، answer.داده، answer.طول)
        پایان
    پایان
پایان

تابع start_mock():
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(udp_server)
    همگام سازی.انتظار(ready)
پایان

تابع mock_server(name: رشته): دی‌اوه‌اچ.کارگزار:
    ناپایا server := دی‌اوه‌اچ.کارگزار ساده جدید(name، "127.0.0.1")
    server.درگاه = udp_port
    برگشت server
پایان

تابع first(v: وکتور<رشته>): رشته:
    اگر v.طول() برابر 0:
        برگشت "none"
    پایان
    برگشت v.بگیر(0)
پایان

تابع ریشه:
    start_mock()
    ناپایا servers := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    servers.بیفزا(mock_server("mock"))
    resolver := دی‌اوه‌اچ.حل‌کننده جدید(servers)
    دی‌اوه‌اچ.تعیین مهلت(resolver، 2000)
    دی‌اوه‌اچ.تعیین حدود ماندگاری(resolver، 30، 3600، 15)

    ناپایا a := دی‌اوه‌اچ.حل در زمان(resolver، "a.test"، دی‌ان‌اس.نوع آ، 1000 برگردان صحیح۶۴)
    سرچاپ a.معتبر، a.از حافظه، a.زمان ماندگاری، a.منفی، a.کد نتیجه، a.پیام.پاسخ‌ها.رکوردها.طول()، queries
    ناپایا again := دی‌اوه‌اچ.حل در زمان(resolver، "a.test"، دی‌ان‌اس.نوع آ، 61000 برگردان صحیح۶۴)
    سرچاپ again.از حافظه، again.زمان ماندگاری، queries
    ناپایا later := دی‌اوه‌اچ.حل در زمان(resolver، "a.test"، دی‌ان‌اس.نوع آ، 200000 برگردان صحیح۶۴)
    سرچاپ later.از حافظه، later.زمان ماندگاری، queries
    دی‌اوه‌اچ.آزاد کردن پاسخ نهایی(a)
    دی‌اوه‌اچ.آزاد کردن پاسخ نهایی(again)
    دی‌اوه‌اچ.آزاد کردن پاسخ نهایی(later)

    n1 := دی‌اوه‌اچ.حل در زمان(resolver، "nothing.test"، دی‌ان‌اس.نوع آ، 500000 برگردان صحیح۶۴)
    سرچاپ n1.معتبر، n1.منفی، n1.کد نتیجه، n1.زمان ماندگاری، n1.از حافظه
    n2 := دی‌اوه‌اچ.حل در زمان(resolver، "nothing.test"، دی‌ان‌اس.نوع آ، 505000 برگردان صحیح۶۴)
    سرچاپ n2.از حافظه، n2.منفی، queries
    ناپایا live := دی‌اوه‌اچ.حل(resolver، "a.test"، دی‌ان‌اس.نوع آ)
    سرچاپ live.معتبر، live.از حافظه
    دی‌اوه‌اچ.آزاد کردن پاسخ نهایی(live)

    سرچاپ first(دی‌اوه‌اچ.جستجوی آ(resolver، "a.test"))، دی‌اوه‌اچ.جستجوی آ(resolver، "a.test").طول()
    سرچاپ first(دی‌اوه‌اچ.جستجوی کواداِی(resolver، "v6.test"))، first(دی‌اوه‌اچ.جستجوی تی‌ایکس‌تی(resolver، "txt.test"))
    سرچاپ دی‌اوه‌اچ.جستجوی سی‌نیم(resolver، "alias.test")، first(دی‌اوه‌اچ.جستجوی میزبان(resolver، "alias.test"))، first(دی‌اوه‌اچ.جستجوی میزبان(resolver، "5.6.7.8"))

    stats := دی‌اوه‌اچ.آمار(resolver)
    سرچاپ stats.برخورد حافظه بزرگتر 0، stats.ناکامی حافظه بزرگتر 0، stats.پرسش بالادست بزرگتر 0، stats.شکست‌ها
    سرچاپ دی‌اوه‌اچ.اندازه حافظه(resolver) بزرگتر 0
    دی‌اوه‌اچ.پاک کردن حافظه(resolver)
    سرچاپ دی‌اوه‌اچ.اندازه حافظه(resolver)

    ناپایا dead := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    dead.بیفزا(دی‌اوه‌اچ.کارگزار جدید("dead"، دی‌اوه‌اچ.نوع دی‌اوه‌اچ پست، "http://127.0.0.1:1/dns-query"))
    broken := دی‌اوه‌اچ.حل‌کننده جدید(dead)
    دی‌اوه‌اچ.تعیین مهلت(broken، 300)
    failed := دی‌اوه‌اچ.حل(broken، "a.test"، دی‌ان‌اس.نوع آ)
    سرچاپ failed.معتبر، failed.خطا.طول() بزرگتر 0، دی‌اوه‌اچ.آمار(broken).شکست‌ها
    سرچاپ first(دی‌اوه‌اچ.جستجوی آ(broken، "a.test"))

    ناپایا helper := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    helper.بیفزا(mock_server("bootstrap"))
    دی‌اوه‌اچ.تعیین کارگزارهای راه‌انداز(broken، helper)
    سرچاپ "bootstrap set"
پایان
