// زبان: فارسی
واردسازی فشرده سازی
واردسازی حافظه
واردسازی شبکه.دی‌ان‌اس
واردسازی شبکه.دی‌اوه‌اچ
واردسازی شبکه.یو دی پی
واردسازی همگام سازی

ناپایا درگاه_یودی‌پی := 0
ناپایا پرس_وجوها := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع record(نام: رشته، rtype: صحیح، ttl: صحیح، data: رشته): دی‌ان‌اس.رکورد:
    برگشت دی‌ان‌اس.رکورد { نام دامنه = نام، نوع رکورد = rtype، رده = 1، زمان ماندگاری = ttl، داده = data }
پایان

تابع answer_for(p: تهی*، تعداد: صحیح): فشرده سازی.بافر بایت:
    پرس_وجوها++
    پرسش := دی‌ان‌اس.کدگشایی(p، تعداد)
    پرسیده := پرسش.پرسش‌ها.پرسش‌ها.بگیر(0)
    ناپایا رکوردها := وکتور {} برگردان وکتور<دی‌ان‌اس.رکورد>
    ناپایا کد_بازگشت := 0
    اگر پرسیده.نام دامنه برابر "a.test" و پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع آ:
        رکوردها.بیفزا(record("a.test"، دی‌ان‌اس.نوع آ، 120، "10.0.0.1"))
        رکوردها.بیفزا(record("a.test"، دی‌ان‌اس.نوع آ، 300، "10.0.0.2"))
    وگرنه پرسیده.نام دامنه برابر "v6.test" و پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع کواداِی:
        رکوردها.بیفزا(record("v6.test"، دی‌ان‌اس.نوع کواداِی، 300، "2001:db8::5"))
    وگرنه پرسیده.نام دامنه برابر "txt.test" و پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع تی‌ایکس‌تی:
        رکوردها.بیفزا(record("txt.test"، دی‌ان‌اس.نوع تی‌ایکس‌تی، 60، "hello world"))
    وگرنه پرسیده.نام دامنه برابر "alias.test":
        رکوردها.بیفزا(record("alias.test"، دی‌ان‌اس.نوع سی‌نیم، 60، "target.test"))
        اگر پرسیده.نوع رکورد برابر دی‌ان‌اس.نوع آ:
            رکوردها.بیفزا(record("target.test"، دی‌ان‌اس.نوع آ، 60، "10.9.9.9"))
        پایان
    وگرنه:
        کد_بازگشت = 3
    پایان
    برگشت دی‌اوه‌اچ.کدگذاری پاسخ(پرسش.شناسه، پرسیده.نام دامنه، پرسیده.نوع رکورد، کد_بازگشت، رکوردها)
پایان

تابع udp_server():
    متن_نمونه := یو دی پی.پیوند(0)
    درگاه_یودی‌پی = یو دی پی.درگاه(متن_نمونه)
    همگام سازی.اتمام(آماده)
    بافر := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    ناپایا از_میزبان := ""
    ناپایا از_درگاه := 0
    تا درست:
        تعداد := یو دی پی.دریافت بایت(متن_نمونه، بافر، 2048، از_میزبان، از_درگاه)
        اگر تعداد بزرگتر 0:
            پاسخ_متن := answer_for(بافر، تعداد)
            یو دی پی.ارسال بایت(متن_نمونه، از_میزبان، از_درگاه، پاسخ_متن.داده، پاسخ_متن.طول)
        پایان
    پایان
پایان

تابع start_mock():
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    متغیر__t := نخ‌ساز(udp_server)
    همگام سازی.انتظار(آماده)
پایان

تابع mock_server(نام: رشته): دی‌اوه‌اچ.کارگزار:
    ناپایا کارساز := دی‌اوه‌اچ.کارگزار ساده جدید(نام، "127.0.0.1")
    کارساز.درگاه = درگاه_یودی‌پی
    برگشت کارساز
پایان

تابع ریشه:
    start_mock()
    ناپایا کارسازها := وکتور {} برگردان وکتور<دی‌اوه‌اچ.کارگزار>
    کارسازها.بیفزا(mock_server("mock"))
    حل_کننده := دی‌اوه‌اچ.حل‌کننده جدید(کارسازها)
    متغیر_stub := دی‌اوه‌اچ.راه‌اندازی کارگزار محلی(حل_کننده، "127.0.0.1"، 0)
    سرچاپ "stub up:"، متغیر_stub.معتبر، متغیر_stub.درگاه بزرگتر 0

    سوکت := یو دی پی.باز کردن()
    یو دی پی.تنظیم زمان انتظار(سوکت، 3000)
    بافر := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    ناپایا از_میزبان := ""
    ناپایا از_درگاه := 0
    هر نام در ["a.test"، "a.test"، "nothing.test"]:
        ناپایا پرسیده := فشرده سازی.بافر بایت جدید()
        فشرده سازی.افزودن بایت(پرسیده، 0x12)
        فشرده سازی.افزودن بایت(پرسیده، 0x34)
        فشرده سازی.افزودن بایت(پرسیده، 0x01)
        فشرده سازی.افزودن بایت(پرسیده، 0x00)
        فشرده سازی.افزودن بایت(پرسیده، 0)
        فشرده سازی.افزودن بایت(پرسیده، 1)
        تکرار 6:
            فشرده سازی.افزودن بایت(پرسیده، 0)
        پایان
        هر برچسب در نام.بشکاف("."):
            فشرده سازی.افزودن بایت(پرسیده، برچسب.طول())
            فشرده سازی.افزودن بایت‌ها(پرسیده، برچسب برگردان تهی*، برچسب.طول())
        پایان
        فشرده سازی.افزودن بایت(پرسیده، 0)
        فشرده سازی.افزودن بایت(پرسیده، 0)
        فشرده سازی.افزودن بایت(پرسیده، 1)
        فشرده سازی.افزودن بایت(پرسیده، 0)
        فشرده سازی.افزودن بایت(پرسیده، 1)
        یو دی پی.ارسال بایت(سوکت، "127.0.0.1"، متغیر_stub.درگاه، پرسیده.داده، پرسیده.طول)
        تعداد := یو دی پی.دریافت بایت(سوکت، بافر، 2048، از_میزبان، از_درگاه)
        پاسخ_فرآیند := دی‌ان‌اس.کدگشایی(بافر، تعداد)
        سرچاپ نام، پاسخ_فرآیند.شناسه برابر 4660، پاسخ_فرآیند.کد نتیجه، پاسخ_فرآیند.پاسخ‌ها.رکوردها.طول()، پرس_وجوها
    پایان
    سرچاپ "served:"، دی‌اوه‌اچ.شمار پاسخ‌های کارگزار محلی(متغیر_stub)
    دی‌اوه‌اچ.توقف کارگزار محلی(متغیر_stub)
    یو دی پی.بستن(سوکت)
پایان
