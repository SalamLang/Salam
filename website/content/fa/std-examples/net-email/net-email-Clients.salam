واردسازی شبکه.پست الکترونیک شبکه

روال ریشه:
    ناپایا س := پست الکترونیک شبکه.اتصال امن اس‌ام‌تی‌پی("smtp.example.com"، ۴۶۵)
    اگر س.ok و پست الکترونیک شبکه.سلام(س، "example.com") و پست الکترونیک شبکه.ورود با احراز هویت(س، "ali"، "رمز"):
        _ := پست الکترونیک شبکه.فرستنده(س، "ali@example.com")
        _ := پست الکترونیک شبکه.گیرنده(س، "sara@example.com")
        _ := پست الکترونیک شبکه.داده(س، پست الکترونیک شبکه.ساخت پیام("ali@example.com"، "sara@example.com"، "سلام"، "متن"، ""))
    پایان
    پست الکترونیک شبکه.خروج اس‌ام‌تی‌پی(س)
    ناپایا س۲ := پست الکترونیک شبکه.اتصال اس‌ام‌تی‌پی("smtp.example.com"، ۵۸۷)
    _ := پست الکترونیک شبکه.شروع تی‌ال‌اس(س۲، "smtp.example.com")
    _ := پست الکترونیک شبکه.ورود ساده(س۲، "ali"، "رمز")
    _ := پست الکترونیک شبکه.احراز هویت ایکس‌اواث۲(س۲، "ali"، "token")
    سرچاپ س۲.last_reply
    _ := پست الکترونیک شبکه.ارسال("smtp.example.com"، ۴۶۵، درست، "ali"، "رمز"، "ali@example.com"، "sara@example.com"، "سلام"، "متن"، "")
    ناپایا ی := پست الکترونیک شبکه.اتصال امن آی‌مپ("imap.example.com"، ۹۹۳)
    _ := پست الکترونیک شبکه.ورود(ی، "ali"، "رمز")
    _ := پست الکترونیک شبکه.ورود ایکس‌اواث۲(ی، "ali"، "token")
    سرچاپ پست الکترونیک شبکه.فهرست صندوق‌ها(ی، ""، "*")
    _ := پست الکترونیک شبکه.انتخاب(ی، "INBOX")
    سرچاپ پست الکترونیک شبکه.دریافت پیام‌ها(ی، "1:5"، "(FLAGS BODY[HEADER.FIELDS (SUBJECT)])")
    پ := پست الکترونیک شبکه.دستور(ی، "NOOP")
    سرچاپ پ.ok، پ.status، پ.lines.طول()
    پست الکترونیک شبکه.خروج آی‌مپ(ی)
    _ := پست الکترونیک شبکه.اتصال آی‌مپ("imap.example.com"، ۱۴۳)
    ناپایا پاپ := پست الکترونیک شبکه.اتصال امن پاپ۳("pop.example.com"، ۹۹۵)
    _ := پست الکترونیک شبکه.کاربر(پاپ، "ali")
    _ := پست الکترونیک شبکه.گذرواژه(پاپ، "رمز")
    سرچاپ پست الکترونیک شبکه.وضعیت(پاپ)، پست الکترونیک شبکه.فهرست پیام‌های پاپ۳(پاپ)
    سرچاپ پست الکترونیک شبکه.دریافت پیام پاپ۳(پاپ، ۱)
    _ := پست الکترونیک شبکه.حذف(پاپ، ۱)
    پست الکترونیک شبکه.خروج پاپ۳(پاپ)
    _ := پست الکترونیک شبکه.اتصال پاپ۳("pop.example.com"، ۱۱۰)
پایان
