واردسازی شبکه.پست الکترونیک

تابع ریشه:
    ناپایا س := پست الکترونیک.اتصال امن اس‌ام‌تی‌پی("smtp.example.com"، ۴۶۵)
    اگر س.ok و پست الکترونیک.سلام(س، "example.com") و پست الکترونیک.ورود با احراز هویت(س، "ali"، "رمز"):
        _ := پست الکترونیک.فرستنده(س، "ali@example.com")
        _ := پست الکترونیک.گیرنده(س، "sara@example.com")
        _ := پست الکترونیک.داده(س، پست الکترونیک.ساخت پیام("ali@example.com"، "sara@example.com"، "سلام"، "متن"، ""))
    پایان
    پست الکترونیک.خروج اس‌ام‌تی‌پی(س)
    ناپایا س۲ := پست الکترونیک.اتصال اس‌ام‌تی‌پی("smtp.example.com"، ۵۸۷)
    _ := پست الکترونیک.شروع تی‌ال‌اس(س۲، "smtp.example.com")
    _ := پست الکترونیک.ورود ساده(س۲، "ali"، "رمز")
    _ := پست الکترونیک.احراز هویت ایکس‌اواث۲(س۲، "ali"، "token")
    سرچاپ س۲.last_reply
    _ := پست الکترونیک.ارسال("smtp.example.com"، ۴۶۵، درست، "ali"، "رمز"، "ali@example.com"، "sara@example.com"، "سلام"، "متن"، "")
    ناپایا ی := پست الکترونیک.اتصال امن آی‌مپ("imap.example.com"، ۹۹۳)
    _ := پست الکترونیک.ورود(ی، "ali"، "رمز")
    _ := پست الکترونیک.ورود ایکس‌اواث۲(ی، "ali"، "token")
    سرچاپ پست الکترونیک.فهرست صندوق‌ها(ی، ""، "*")
    _ := پست الکترونیک.انتخاب(ی، "INBOX")
    سرچاپ پست الکترونیک.دریافت پیام‌ها(ی، "1:5"، "(FLAGS BODY[HEADER.FIELDS (SUBJECT)])")
    پ := پست الکترونیک.دستور(ی، "NOOP")
    سرچاپ پ.ok، پ.status، پ.lines.طول()
    پست الکترونیک.خروج آی‌مپ(ی)
    _ := پست الکترونیک.اتصال آی‌مپ("imap.example.com"، ۱۴۳)
    ناپایا پاپ := پست الکترونیک.اتصال امن پاپ۳("pop.example.com"، ۹۹۵)
    _ := پست الکترونیک.کاربر(پاپ، "ali")
    _ := پست الکترونیک.گذرواژه(پاپ، "رمز")
    سرچاپ پست الکترونیک.وضعیت(پاپ)، پست الکترونیک.فهرست پیام‌های پاپ۳(پاپ)
    سرچاپ پست الکترونیک.دریافت پیام پاپ۳(پاپ، ۱)
    _ := پست الکترونیک.حذف(پاپ، ۱)
    پست الکترونیک.خروج پاپ۳(پاپ)
    _ := پست الکترونیک.اتصال پاپ۳("pop.example.com"، ۱۱۰)
پایان
