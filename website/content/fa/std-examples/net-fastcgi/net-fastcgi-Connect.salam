واردسازی شبکه.فست سی جی آی
واردسازی شبکه.تی سی پی

تابع ریشه:
    ناپایا ویژگی_محلی := فست سی جی آی.پارامترهای جدید()
    دیرکن فست سی جی آی.آزادسازی(ویژگی_محلی)
    فست سی جی آی.افزودن(ویژگی_محلی، "REQUEST_METHOD"، "GET")
    فست سی جی آی.افزودن(ویژگی_محلی، "SCRIPT_NAME"، "/index.php")
    فست سی جی آی.افزودن(ویژگی_محلی، "SCRIPT_FILENAME"، "/srv/app/index.php")

    نویسه := فست سی جی آی.اتصال("127.0.0.1"، 9000، 1000)
    اگر وارونه تی سی پی.اتصال معتبر(نویسه):
        سرچاپ "no FastCGI backend on 127.0.0.1:9000"
        برگشت 1
    پایان
    دیرکن تی سی پی.بستن(نویسه)

    ناپایا خوانده := فست سی جی آی.اجرا(نویسه، ویژگی_محلی، پوچ، 0، 5000)
    اگر وارونه خوانده.موفق:
        سرچاپ خوانده.خطا
        برگشت 1
    پایان
    سرچاپ خوانده.وضعیت، خوانده.اندازه
    فست سی جی آی.آزادسازی پاسخ(خوانده)
    برگشت 0
پایان
