واردسازی شبکه.فست سی جی آی
واردسازی شبکه.تی سی پی

تابع ریشه:
    p := فست سی جی آی.پارامترهای جدید()
    دیرکن فست سی جی آی.آزادسازی(p)
    فست سی جی آی.افزودن(p، "REQUEST_METHOD"، "GET")
    فست سی جی آی.افزودن(p، "SCRIPT_NAME"، "/index.php")
    فست سی جی آی.افزودن(p، "SCRIPT_FILENAME"، "/srv/app/index.php")

    c := فست سی جی آی.اتصال("127.0.0.1"، 9000، 1000)
    اگر وارونه تی سی پی.اتصال معتبر(c):
        سرچاپ "no FastCGI backend on 127.0.0.1:9000"
        برگشت 1
    پایان
    دیرکن تی سی پی.بستن(c)

    r := فست سی جی آی.اجرا(c، p، پوچ، 0، 5000)
    اگر وارونه r.موفق:
        سرچاپ r.خطا
        برگشت 1
    پایان
    سرچاپ r.وضعیت، r.اندازه
    فست سی جی آی.آزادسازی پاسخ(r)
    برگشت 0
پایان
