واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.میان افزار
واردسازی شبکه.مسیریاب

تابع خانه(ز: صحیح۶۴):
    میان افزار.ثبت رخداد(ز)
    میان افزار.اجازه به همه(ز)
    میان افزار.امن(ز)
    میان افزار.بدون کش(ز)
    اچ تی تی پی.متن زمینه(ز، "سلام")
پایان

تابع عکس(ز: صحیح۶۴):
    میان افزار.کش(ز، ۳۶۰۰)
    اچ تی تی پی.متن زمینه(ز، "png")
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/"، خانه)
    مسیریاب.دریافت(م، "/logo.png"، عکس)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۶۰۴)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پ := اچ تی تی پی.دریافت("http://127.0.0.1:19604/")
    هر نام در ["access-control-allow-origin"، "x-content-type-options"، "x-frame-options"، "cache-control"]:
        سرچاپ نام + ": " + اچ تی تی پی.دریافت سرصفحه(پ، نام)
    پایان
    سرچاپ اچ تی تی پی.دریافت سرصفحه(اچ تی تی پی.دریافت("http://127.0.0.1:19604/logo.png")، "cache-control")
پایان
