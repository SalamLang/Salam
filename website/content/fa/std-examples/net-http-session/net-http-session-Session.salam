واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.اچ تی تی پی.نشست
واردسازی شبکه.مسیریاب
واردسازی تبدیل

روال بازدید(ز: صحیح۶۴):
    ناپایا ن := نشست.شروع(ز)
    ناپایا شمار := ۱
    اگر نشست.مقدار دارد(ن، "visits"):
        شمار = تبدیل.رشته به عدد(نشست.مقدار(ن، "visits")) + ۱
    پایان
    نشست.تنظیم مقدار(ن، "visits"، "" + شمار)
    نشست.ذخیره(ن)
    اچ تی تی پی.متن زمینه(ز، "بازدید " + شمار)
پایان

روال ورود(ز: صحیح۶۴):
    ناپایا ن := نشست.شروع(ز)
    نشست.بازتولید(ز، ن)
    نشست.تنظیم مقدار(ن، "user"، "ali")
    توکن := نشست.توکن سی اس آر اف(ن)
    نشست.ذخیره(ن)
    اچ تی تی پی.متن زمینه(ز، "" + نشست.تایید سی اس آر اف(ن، توکن) + " " + نشست.تایید سی اس آر اف(ن، "x"))
پایان

روال خروج(ز: صحیح۶۴):
    نشست.پایان(ز)
    اچ تی تی پی.متن زمینه(ز، "خداحافظ")
پایان

روال ریشه:
    نشست.پیکربندی("sid"، ۳۶۰۰، نادرست، "Lax")
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/"، بازدید)
    مسیریاب.ارسال(م، "/login"، ورود)
    مسیریاب.ارسال(م، "/logout"، خروج)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۶۰۶)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    ناپایا ک := اچ تی تی پی.کارخواه جدید()
    پایه := "http://127.0.0.1:19606"
    سرچاپ اچ تی تی پی.بدنه(ک.دریافت(پایه + "/"))
    سرچاپ اچ تی تی پی.بدنه(ک.دریافت(پایه + "/"))
    سرچاپ اچ تی تی پی.بدنه(ک.ارسال(پایه + "/login"، ""))
    سرچاپ اچ تی تی پی.بدنه(ک.دریافت(پایه + "/"))
    سرچاپ اچ تی تی پی.بدنه(ک.ارسال(پایه + "/logout"، ""))
    سرچاپ اچ تی تی پی.بدنه(ک.دریافت(پایه + "/"))
    ناپایا ن := نشست.جدید()
    نشست.تنظیم مقدار(ن، "a"، "1")
    نشست.تنظیم مقدار(ن، "b"، "2")
    سرچاپ نشست.حذف مقدار(ن، "a")، ن.data.items.اندازه()
    نشست.ذخیره(ن)
    ناپایا یافت := نادرست
    ب := نشست.دریافت(ن.id، یافت)
    سرچاپ یافت، نشست.مقدار(ب، "b")، ب.max_age، ن.id.طول() > ۰
    نشست.پاک کردن مقادیر(ن)
    نشست.نابودسازی(ن.id)
    _ := نشست.دریافت(ن.id، یافت)
    سرچاپ یافت، نشست.پاکسازی منقضی شده ها() >= ۰
    سرچاپ نشست.نام پیش فرض کوکی، نشست.حداکثر عمر پیش فرض
پایان
