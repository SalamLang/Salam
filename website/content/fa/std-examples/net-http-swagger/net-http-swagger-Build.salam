واردسازی شبکه.اچ تی تی پی.سواگر
واردسازی کدگذاری.جیسون

ساختار کتاب:
    @json "id"
    همگانی شناسه: صحیح = ۰
    @json "title"
    همگانی عنوان: رشته = ""
پایان

روال ریشه:
    ناپایا س := سواگر.جدید("کتابخانه"، "1.2.0")
    سواگر.توضیح(س، "API نمونه برای کتاب‌ها")
    سواگر.سرور(س، "https://api.example.com"، "اصلی")
    سواگر.تماس(س، "تیم سلام"، "https://salamlang.ir"، "team@salamlang.ir")
    سواگر.پروانه(س، "MIT"، "https://opensource.org/licenses/MIT")
    سواگر.احراز هویت حامل(س، "token"، "JWT")
    سواگر.احراز هویت کلید(س، "key"، "header"، "X-API-Key")
    _ := سواگر.مسیر(س، "GET"، "/books/:id")
    سواگر.خلاصه(س، "یک کتاب")
    سواگر.جزئیات(س، "کتاب را با شناسه برمی‌گرداند.")
    سواگر.برچسب(س، "books")
    سواگر.شناسه عملیات(س، "getBook")
    سواگر.پارامتر مسیر(س، "id"، "شناسه‌ی کتاب")
    سواگر.پرسمان(س، "fields"، "فیلدهای خواسته‌شده"، نادرست)
    سواگر.پرسمان نوع دار(س، "limit"، "حداکثر"، نادرست، ۱۰)
    ناپایا ترتیب‌ها := وکتور {} برگردان وکتور<رشته>
    ترتیب‌ها.بیفزا("title")
    ترتیب‌ها.بیفزا("id")
    سواگر.پرسمان گزینه ای(س، "sort"، "ترتیب"، نادرست، ترتیب‌ها)
    سواگر.سرصفحه(س، "X-Trace"، "شناسه‌ی رهگیری"، نادرست)
    سواگر.کوکی(س، "sid"، "نشست"، نادرست)
    سواگر.امن(س، "token")
    سواگر.برمی گرداند(س، ۲۰۰، "کتاب"، کتاب {})
    سواگر.برمی گرداند سرصفحه(س، ۲۰۰، "ETag"، "نسخه")
    سواگر.بدون بدنه برمی گرداند(س، ۴۰۴، "پیدا نشد")
    _ := سواگر.مسیر(س، "POST"، "/books")
    سواگر.می پذیرد(س، "کتاب تازه"، کتاب {})
    سواگر.برمی گرداند(س، ۲۰۱، "ساخته شد"، کتاب {})
    _ := سواگر.مسیر(س، "PUT"، "/books/:id/cover")
    سواگر.می پذیرد خام(س، "تصویر جلد"، "image/png"، "{\"type\":\"string\",\"format\":\"binary\"}"، درست)
    سواگر.برمی گرداند متن(س، ۲۰۰، "انجام شد")
    _ := سواگر.مسیر(س، "POST"، "/books/:id/notes")
    سواگر.می پذیرد اختیاری(س، "یادداشت"، کتاب {})
    سواگر.می پذیرد فرم(س، "فرم"، کتاب {})
    سواگر.برمی گرداند خام(س، ۲۰۰، "خروجی"، "text/csv"، "{\"type\":\"string\"}")
    سواگر.برمی گرداند اچ تی ام ال(س، ۲۰۰، "صفحه")
    سواگر.برمی گرداند پرونده(س، ۲۰۰، "پرونده"، "application/pdf")
    سواگر.منسوخ(س)
    سرچاپ سواگر.انتخاب مسیر(س، "get"، "/books/:id")، سواگر.انتخاب مسیر(س، "GET"، "/nope")
    سرچاپ س.ops.طول()، س.ops[۰].params.طول()، س.ops[۰].replies.طول()، س.ops[۳].is_deprecated، س.schemes.طول()
    متن := سواگر.مشخصات(س)
    سرچاپ جیسون.معتبر(متن)، جیسون.دریافت(متن، "openapi")
    سرچاپ سواگر.مشخصات با تورفتگی(س).طول() > متن.طول()
    سرچاپ سواگر.مشکلات(س).طول()، سواگر.توضیح داده نشده(س)
    سرچاپ سواگر.نوشتن مشخصات(س، "openapi.json")، سواگر.مشخصات از پرونده("openapi.json").طول() > ۰، سواگر.مشخصات از پرونده("نیست.json")
    سرچاپ سواگر.طرحواره متن، سواگر.نوع جیسون
    سواگر.آزاد سازی(س)
پایان
