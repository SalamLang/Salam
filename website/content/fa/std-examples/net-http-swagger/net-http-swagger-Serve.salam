واردسازی شبکه.اچ تی تی پی شبکه
واردسازی شبکه.اچ تی تی پی شبکه.سواگر
واردسازی شبکه.مسیریاب شبکه
واردسازی رشته

روال فهرست(ز: صحیح۶۴):
    اچ تی تی پی شبکه.جیسون زمینه(ز، "[]")
پایان

روال ریشه:
    ناپایا م := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.دریافت(م، "/books"، فهرست)
    مسیریاب شبکه.ارسال(م، "/books"، فهرست)
    مسیریاب شبکه.دریافت(م، "/admin/stats"، فهرست)
    ناپایا س := سواگر.جدید("کتابخانه"، "1.0.0")
    سرچاپ سواگر.جا افتاده(س، م)
    سواگر.پویش با پیشوند(س، م، "/books")
    سرچاپ س.ops.طول()، سواگر.جا افتاده(س، م)
    سواگر.پویش(س، م)
    سرچاپ س.ops.طول()، سواگر.جا افتاده(س، م).طول()
    سواگر.نصب(س، م، "/docs")
    ناپایا سرور := اچ تی تی پی شبکه.سرور جدید(۱۹۶۰۷)
    اچ تی تی پی شبکه.استفاده(سرور، م)
    _ := اچ تی تی پی شبکه.اجرا در پس زمینه(سرور)
    پ := اچ تی تی پی شبکه.دریافت("http://127.0.0.1:19607/docs/openapi.json")
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ)، رشته.شامل است(اچ تی تی پی شبکه.بدنه(پ)، "/admin/stats")
    صفحه := اچ تی تی پی شبکه.دریافت("http://127.0.0.1:19607/docs")
    سرچاپ رشته.شامل است(اچ تی تی پی شبکه.بدنه(صفحه)، "<html")
    ناپایا م۲ := مسیریاب شبکه.مسیریاب جدید()
    سواگر.نصب مشخصات("{\"openapi\":\"3.1.0\"}"، "آماده"، م۲، "/spec")
    سرچاپ م۲.routes.طول()
    سرچاپ سواگر.سرو(س، ۱۹۶۰۸)، اچ تی تی پی شبکه.وضعیت(اچ تی تی پی شبکه.دریافت("http://127.0.0.1:19608/openapi.json"))
    سرچاپ سواگر.سرو مشخصات("{\"openapi\":\"3.1.0\"}"، "دیگر"، ۱۹۶۰۹)
    سرچاپ رشته.شامل است(سواگر.صفحه("API"، "/openapi.json")، "/openapi.json")
پایان
