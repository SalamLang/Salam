واردسازی شبکه.اچ تی تی پی شبکه
واردسازی شبکه.اچ تی تی پی شبکه.اعتبارسنجی
واردسازی شبکه.مسیریاب شبکه

روال نام‌نویسی(ز: صحیح۶۴):
    ایمیل := اچ تی تی پی شبکه.فرم زمینه(ز، "email")
    اعتبارسنجی.ادعا(ز، اعتبارسنجی.ایمیل است(ایمیل)، "invalid email")
    اگر اعتبارسنجی.ایمیل است(ایمیل):
        اچ تی تی پی شبکه.متن زمینه(ز، "خوش آمدید")
    پایان
پایان

روال ریشه:
    سرچاپ اعتبارسنجی.الزامی("")، اعتبارسنجی.الزامی("  ")، اعتبارسنجی.الزامی("علی")
    سرچاپ اعتبارسنجی.طول("سلام"، ۲، ۵)، اعتبارسنجی.طول("سلام دنیا"، ۲، ۵)
    سرچاپ اعتبارسنجی.ایمیل است("ali@example.com")، اعتبارسنجی.ایمیل است("ali@")
    سرچاپ اعتبارسنجی.تطابق دارد("09121234567"، "^09[0-9]{9}$")، اعتبارسنجی.تطابق دارد("12345"، "^09[0-9]{9}$")
    ناپایا م := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.ارسال(م، "/signup"، نام‌نویسی)
    ناپایا س := اچ تی تی پی شبکه.سرور جدید(۱۹۶۰۵)
    اچ تی تی پی شبکه.استفاده(س، م)
    _ := اچ تی تی پی شبکه.اجرا در پس زمینه(س)
    ناپایا سر := اچ تی تی پی شبکه.سرصفحه جدید()
    سر.درج("Content-Type"، "application/x-www-form-urlencoded")
    بد := اچ تی تی پی شبکه.ارسال با("http://127.0.0.1:19605/signup"، "email=x"، سر)
    سرچاپ اچ تی تی پی شبکه.وضعیت(بد)، اچ تی تی پی شبکه.بدنه(بد)
    خوب := اچ تی تی پی شبکه.ارسال با("http://127.0.0.1:19605/signup"، "email=a%40b.ir"، سر)
    سرچاپ اچ تی تی پی شبکه.وضعیت(خوب)، اچ تی تی پی شبکه.بدنه(خوب)
پایان
