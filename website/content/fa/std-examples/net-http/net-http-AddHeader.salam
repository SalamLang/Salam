واردسازی زمان

تابع show(ctx: صحیح۶۴):
    اچ تی تی پی.افزودن سرصفحه(ctx، "X-Test"، "one")
    اچ تی تی پی.افزودن سرصفحه(ctx، "X-Test"، "two")
    اچ تی تی پی.افزودن سرصفحه(ctx، "Set-Cookie"، "a=1; Path=/")
    اچ تی تی پی.افزودن سرصفحه(ctx، "Set-Cookie"، "b=2; Path=/")
    اچ تی تی پی.متن(ctx، "ok")
پایان

تابع ریشه:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/"، show)
    ناپایا s := اچ تی تی پی.سرور جدید(۱۹۵۲۱)
    اچ تی تی پی.تنظیم میزبان(s، "127.0.0.1")
    اچ تی تی پی.استفاده(s، r)
    اگر وارونه اچ تی تی پی.اجرا در پس زمینه(s):
        سرچاپ "cannot listen"
        برگشت ۱
