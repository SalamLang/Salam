واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی زمان

تابع نمایش(بافت: صحیح۶۴):
    اچ تی تی پی.افزودن سرصفحه(بافت، "X-Test"، "one")
    اچ تی تی پی.افزودن سرصفحه(بافت، "X-Test"، "two")
    اچ تی تی پی.افزودن سرصفحه(بافت، "Set-Cookie"، "a=1; Path=/")
    اچ تی تی پی.افزودن سرصفحه(بافت، "Set-Cookie"، "b=2; Path=/")
    اچ تی تی پی.متن(بافت، "ok")
پایان

تابع ریشه:
    ناپایا r := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(r، "/"، نمایش)
    ناپایا s := اچ تی تی پی.سرور جدید(۱۹۵۲۱)
    اچ تی تی پی.تنظیم میزبان(s، "127.0.0.1")
    اچ تی تی پی.استفاده(s، r)
    اگر وارونه اچ تی تی پی.اجرا در پس زمینه(s):
        سرچاپ "cannot listen"
        برگشت ۱
    پایان
    زمان.خواب(۳۰۰)
    پاسخ := اچ تی تی پی.دریافت("http://127.0.0.1:19521/")
    سرچاپ پاسخ.وضعیت
    هر v در اچ تی تی پی.مقادیر سرصفحه(پاسخ، "X-Test"):
        سرچاپ v
    پایان
    هر c در اچ تی تی پی.مقادیر سرصفحه(پاسخ، "Set-Cookie"):
        سرچاپ c
    پایان
    برگشت ۰
پایان
