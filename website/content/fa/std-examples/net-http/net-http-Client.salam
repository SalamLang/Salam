واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

روال پژواک(ز: صحیح۶۴):
    اچ تی تی پی.تنظیم سرصفحه زمینه(ز، "X-Tag"، "a")
    اچ تی تی پی.تنظیم کوکی زمینه(ز، اچ تی تی پی.کوکی جدید("sid"، "abc"))
    اچ تی تی پی.متن زمینه(ز، اچ تی تی پی.روش زمینه(ز) + " " + اچ تی تی پی.سرصفحه زمینه(ز، "X-Token") + " " + اچ تی تی پی.بدنه زمینه(ز))
پایان

روال کوکی‌ها(ز: صحیح۶۴):
    ه := اچ تی تی پی.کوکی های زمینه(ز)
    اچ تی تی پی.متن زمینه(ز، "" + ه.اندازه() + " " + اچ تی تی پی.کوکی زمینه(ز، "lang") + " " + اچ تی تی پی.زمینه کوکی دارد(ز، "sid"))
    اچ تی تی پی.پاک کردن کوکی زمینه(ز، "old")
    اچ تی تی پی.پاک کردن کوکی زمینه در مسیر(ز، "scoped"، "/admin"، "")
پایان

روال ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    هر روش در ["GET"، "POST"، "PUT"، "DELETE"، "PATCH"، "OPTIONS"، "HEAD"]:
        مسیریاب.روش(م، روش، "/echo"، پژواک)
    پایان
    مسیریاب.دریافت(م، "/cookies"، کوکی‌ها)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۶۰۳)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    ن := "http://127.0.0.1:19603/echo"
    ناپایا سر := اچ تی تی پی.سرصفحه جدید()
    سر.درج("X-Token"، "t1")
    پ := اچ تی تی پی.دریافت با(ن، سر)
    سرچاپ اچ تی تی پی.موفق(پ)، اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.بدنه(پ)، "[" + اچ تی تی پی.خطا(پ) + "]"
    سرچاپ اچ تی تی پی.سرصفحه ها(پ).دارد("X-Tag")، اچ تی تی پی.مقادیر سرصفحه(پ، "set-cookie")
    سرچاپ اچ تی تی پی.نگاشت کوکی(پ).دریافت("sid")، اچ تی تی پی.سرصفحه های خام(پ).طول() > ۰، اچ تی تی پی.خام(پ).طول() > ۰
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.ارسال(ن، "a"))، اچ تی تی پی.بدنه(اچ تی تی پی.قرار دادن با(ن، "b"، سر))
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.حذف(ن))، اچ تی تی پی.بدنه(اچ تی تی پی.حذف با(ن، سر))
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.وصله(ن، "c"))، اچ تی تی پی.بدنه(اچ تی تی پی.وصله با(ن، "d"، سر))
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.گزینه ها(ن))، اچ تی تی پی.بدنه(اچ تی تی پی.گزینه ها با(ن، سر))
    سرچاپ اچ تی تی پی.وضعیت(اچ تی تی پی.درخواست هد(ن))، اچ تی تی پی.وضعیت(اچ تی تی پی.سرصفحه با(ن، سر))
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.قرار دادن(ن، "e"))، اچ تی تی پی.بدنه(اچ تی تی پی.دریافت(ن))
    سرچاپ اچ تی تی پی.بدنه(اچ تی تی پی.درخواست خام("POST"، ن، "X-Token: raw\r\n"، "f"))
    ناپایا پارامترها := اچ تی تی پی.سرصفحه جدید()
    پارامترها.درج("q"، "سلام دنیا")
    سرچاپ اچ تی تی پی.کدگذاری فرم(پارامترها)، اچ تی تی پی.با پرسمان("http://x.ir/s"، پارامترها)
    ناپایا کوکی := اچ تی تی پی.سرصفحه جدید()
    کوکی.درج("lang"، "fa")
    کوکی.درج("sid"، "abc")
    سر.درج("Cookie"، اچ تی تی پی.سرصفحه کوکی(کوکی))
    پ۲ := اچ تی تی پی.دریافت با("http://127.0.0.1:19603/cookies"، سر)
    سرچاپ اچ تی تی پی.بدنه(پ۲)، اچ تی تی پی.خطوط کوکی(پ۲).طول()
    ناپایا ک := اچ تی تی پی.کارخواه جدید()
    ک.تنظیم کوکی("lang"، "en")
    سرچاپ اچ تی تی پی.بدنه(ک.دریافت("http://127.0.0.1:19603/cookies"))
    ک.پاک کردن کوکی ها()
    ناپایا اضافه := اچ تی تی پی.سرصفحه جدید()
    اضافه.درج("X-Token"، "c1")
    سرچاپ اچ تی تی پی.بدنه(ک.درخواست با("PUT"، ن، "g"، اضافه))، اچ تی تی پی.بدنه(ک.درخواست("PATCH"، ن، "h"))
    سرچاپ اچ تی تی پی.بدنه(ک.قرار دادن(ن، "i"))، اچ تی تی پی.بدنه(ک.حذف(ن))، اچ تی تی پی.بدنه(ک.وصله(ن، "j"))، اچ تی تی پی.بدنه(ک.گزینه ها(ن))، اچ تی تی پی.وضعیت(ک.درخواست هد(ن))
    خطا := اچ تی تی پی.دریافت("http://127.0.0.1:1/")
    سرچاپ اچ تی تی پی.موفق(خطا)، اچ تی تی پی.خطا(خطا) != ""
پایان
