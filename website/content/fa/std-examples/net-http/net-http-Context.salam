واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع سلام(ه: صحیح۶۴):
    ز := اچ تی تی پی.زمینه جدید(ه)
    نام := اچ تی تی پی.پرسمان(ز، "name")
    اگر اچ تی تی پی.کوکی دارد(ز، "seen"):
        اچ تی تی پی.متن(ز، "دوباره سلام " + نام + " (" + اچ تی تی پی.مقدار کوکی(ز، "seen") + ")")
    وگرنه:
        اچ تی تی پی.تنظیم کوکی(ز، اچ تی تی پی.کوکی با انقضا("seen"، "1"، ۳۶۰۰))
        اچ تی تی پی.متن(ز، "سلام " + نام + " (" + اچ تی تی پی.پرسمان خام(ز) + ")")
    پایان
پایان

تابع کتاب(ه: صحیح۶۴):
    ز := اچ تی تی پی.زمینه جدید(ه)
    اچ تی تی پی.تنظیم سرصفحه(ز، "X-Method"، اچ تی تی پی.روش(ز))
    اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۲)
    اچ تی تی پی.جیسون(ز، `{"id": "` + اچ تی تی پی.پارامتر(ز، "id") + `", "path": "` + اچ تی تی پی.مسیر(ز) + `"}`)
پایان

تابع فرم(ه: صحیح۶۴):
    ز := اچ تی تی پی.زمینه جدید(ه)
    اچ تی تی پی.متن(ز، اچ تی تی پی.فرم(ز، "a") + "|" + اچ تی تی پی.بدنه(ز) + "|" + اچ تی تی پی.سرصفحه(ز، "Content-Type"))
پایان

تابع خروج(ه: صحیح۶۴):
    ز := اچ تی تی پی.زمینه جدید(ه)
    اچ تی تی پی.پاک کردن کوکی(ز، "seen")
    اچ تی تی پی.تغییرمسیر(ز، "/hello")
پایان

تابع صفحه(ه: صحیح۶۴):
    ز := اچ تی تی پی.زمینه جدید(ه)
    ک := اچ تی تی پی.کوکی ها(ز)
    اچ تی تی پی.اچ تی ام ال(ز، "<p>" + ک.اندازه() + "</p>")
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/hello"، سلام)
    مسیریاب.دریافت(م، "/books/:id"، کتاب)
    مسیریاب.ارسال(م، "/form"، فرم)
    مسیریاب.دریافت(م، "/logout"، خروج)
    مسیریاب.دریافت(م، "/page"، صفحه)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۶۰۲)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19602"
    ناپایا ک := اچ تی تی پی.کارخواه جدید()
    سرچاپ اچ تی تی پی.بدنه(ک.دریافت(پایه + "/hello?name=%D9%85%D8%B1%DB%8C%D9%85"))
    سرچاپ اچ تی تی پی.بدنه(ک.دریافت(پایه + "/hello?name=%D9%85%D8%B1%DB%8C%D9%85"))
    سرچاپ اچ تی تی پی.بدنه(ک.دریافت(پایه + "/page"))
    پ := ک.دریافت(پایه + "/books/7")
    سرچاپ اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.بدنه(پ)، اچ تی تی پی.دریافت سرصفحه(پ، "x-method")
    ک.تنظیم سرصفحه("Content-Type"، "application/x-www-form-urlencoded")
    سرچاپ اچ تی تی پی.بدنه(ک.ارسال(پایه + "/form"، "a=1&b=2"))
    پ۲ := ک.دریافت(پایه + "/logout")
    سرچاپ اچ تی تی پی.وضعیت(پ۲)، اچ تی تی پی.خطوط کوکی(پ۲).طول() > ۰
پایان
