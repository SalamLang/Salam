واردسازی شبکه.اچ تی تی پی شبکه
واردسازی شبکه.مسیریاب شبکه

روال سلام(ه: صحیح۶۴):
    ز := اچ تی تی پی شبکه.زمینه جدید(ه)
    نام := اچ تی تی پی شبکه.پرسمان(ز، "name")
    اگر اچ تی تی پی شبکه.کوکی دارد(ز، "seen"):
        اچ تی تی پی شبکه.متن(ز، "دوباره سلام " + نام + " (" + اچ تی تی پی شبکه.مقدار کوکی(ز، "seen") + ")")
    وگرنه:
        اچ تی تی پی شبکه.تنظیم کوکی(ز، اچ تی تی پی شبکه.کوکی با انقضا("seen"، "1"، ۳۶۰۰))
        اچ تی تی پی شبکه.متن(ز، "سلام " + نام + " (" + اچ تی تی پی شبکه.پرسمان خام(ز) + ")")
    پایان
پایان

روال کتاب(ه: صحیح۶۴):
    ز := اچ تی تی پی شبکه.زمینه جدید(ه)
    اچ تی تی پی شبکه.تنظیم سرصفحه(ز، "X-Method"، اچ تی تی پی شبکه.روش(ز))
    اچ تی تی پی شبکه.تنظیم وضعیت(ز، ۲۰۲)
    اچ تی تی پی شبکه.جیسون(ز، `{"id": "` + اچ تی تی پی شبکه.پارامتر(ز، "id") + `", "path": "` + اچ تی تی پی شبکه.مسیر(ز) + `"}`)
پایان

روال فرم(ه: صحیح۶۴):
    ز := اچ تی تی پی شبکه.زمینه جدید(ه)
    اچ تی تی پی شبکه.متن(ز، اچ تی تی پی شبکه.فرم(ز، "a") + "|" + اچ تی تی پی شبکه.بدنه(ز) + "|" + اچ تی تی پی شبکه.سرصفحه(ز، "Content-Type"))
پایان

روال خروج(ه: صحیح۶۴):
    ز := اچ تی تی پی شبکه.زمینه جدید(ه)
    اچ تی تی پی شبکه.پاک کردن کوکی(ز، "seen")
    اچ تی تی پی شبکه.تغییرمسیر(ز، "/hello")
پایان

روال صفحه(ه: صحیح۶۴):
    ز := اچ تی تی پی شبکه.زمینه جدید(ه)
    ک := اچ تی تی پی شبکه.کوکی ها(ز)
    اچ تی تی پی شبکه.اچ تی ام ال(ز، "<p>" + ک.اندازه() + "</p>")
پایان

روال ریشه:
    ناپایا م := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.دریافت(م، "/hello"، سلام)
    مسیریاب شبکه.دریافت(م، "/books/:id"، کتاب)
    مسیریاب شبکه.ارسال(م، "/form"، فرم)
    مسیریاب شبکه.دریافت(م، "/logout"، خروج)
    مسیریاب شبکه.دریافت(م، "/page"، صفحه)
    ناپایا س := اچ تی تی پی شبکه.سرور جدید(۱۹۶۰۲)
    اچ تی تی پی شبکه.استفاده(س، م)
    _ := اچ تی تی پی شبکه.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19602"
    ناپایا ک := اچ تی تی پی شبکه.کارخواه جدید()
    سرچاپ اچ تی تی پی شبکه.بدنه(ک.دریافت(پایه + "/hello?name=%D9%85%D8%B1%DB%8C%D9%85"))
    سرچاپ اچ تی تی پی شبکه.بدنه(ک.دریافت(پایه + "/hello?name=%D9%85%D8%B1%DB%8C%D9%85"))
    سرچاپ اچ تی تی پی شبکه.بدنه(ک.دریافت(پایه + "/page"))
    پ := ک.دریافت(پایه + "/books/7")
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ)، اچ تی تی پی شبکه.بدنه(پ)، اچ تی تی پی شبکه.دریافت سرصفحه(پ، "x-method")
    ک.تنظیم سرصفحه("Content-Type"، "application/x-www-form-urlencoded")
    سرچاپ اچ تی تی پی شبکه.بدنه(ک.ارسال(پایه + "/form"، "a=1&b=2"))
    پ۲ := ک.دریافت(پایه + "/logout")
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ۲)، اچ تی تی پی شبکه.خطوط کوکی(پ۲).طول() > ۰
پایان
