واردسازی شبکه.اچ تی تی پی

تابع ریشه:
    ک := اچ تی تی پی.کوکی جدید("theme"، "dark")
    سرچاپ ک.نام، ک.مقدار، ک.مسیر، ک.فقط‌اچ‌تی‌تی‌پی، ک.سایت‌یکسان، ک.دارای‌حداکثر‌عمر
    ناپایا ا := اچ تی تی پی.کوکی با انقضا("sid"، "x1"، ۳۶۰۰)
    ا.امن = درست
    ا.دامنه = "salamlang.ir"
    سرچاپ ا.حداکثر‌عمر، ا.دارای‌حداکثر‌عمر، ا.امن، ا.دامنه
    م := اچ تی تی پی.کوکی منقضی شده("sid"، "/"، "salamlang.ir")
    سرچاپ م.حداکثر‌عمر، م.دارای‌حداکثر‌عمر
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("a%20b+c")
پایان
