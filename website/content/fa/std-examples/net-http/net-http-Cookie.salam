واردسازی شبکه.اچ تی تی پی

روال ریشه:
    ک := اچ تی تی پی.کوکی جدید("theme"، "dark")
    سرچاپ ک.name، ک.value، ک.path، ک.http_only، ک.same_site، ک.has_max_age
    ناپایا ا := اچ تی تی پی.کوکی با انقضا("sid"، "x1"، ۳۶۰۰)
    ا.secure = درست
    ا.domain = "salamlang.ir"
    سرچاپ ا.max_age، ا.has_max_age، ا.secure، ا.domain
    م := اچ تی تی پی.کوکی منقضی شده("sid"، "/"، "salamlang.ir")
    سرچاپ م.max_age، م.has_max_age
    سرچاپ اچ تی تی پی.رمزگشایی نشانی("a%20b+c")
پایان
