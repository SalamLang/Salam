واردسازی ورودی خروجی
واردسازی سیستم عامل
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع صفحه(ز: صحیح۶۴):
    پ := سیستم عامل.پوشه موقت() + "/salam_filebody_fa.txt"
    اگر اچ تی تی پی.ارسال پرونده(ز، پ، "text/plain"):
        اچ تی تی پی.تنظیم سرصفحه(ز، "X-Port"، اچ تی تی پی.مالکیت(ز، "" + اچ تی تی پی.درگاه محلی(ز)))
        اچ تی تی پی.تنظیم سرصفحه(ز، "X-Status"، اچ تی تی پی.مالکیت(ز، "" + اچ تی تی پی.وضعیت(ز)))
    وگرنه:
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۴)
        اچ تی تی پی.متن(ز، "پرونده نیست")
    پایان
پایان

تابع قطعه(ز: صحیح۶۴):
    پ := سیستم عامل.پوشه موقت() + "/salam_filebody_fa.txt"
    اگر اچ تی تی پی.ارسال بخشی از پرونده(ز، پ، "text/plain"، ۰، ۸):
        اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۶)
    وگرنه:
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۱۶)
        اچ تی تی پی.متن(ز، "بازه‌ی نادرست")
    پایان
پایان

تابع ریشه:
    پ := سیستم عامل.پوشه موقت() + "/salam_filebody_fa.txt"
    ورودی خروجی.نوشتن پرونده(پ، "سلام از پرونده")
    ناپایا اندازه := ۰ برگردان صحیح۶۴
    ناپایا زمان‌تغییر := ۰ برگردان صحیح۶۴
    سرچاپ اچ تی تی پی.وضعیت پرونده(پ، اندازه، زمان‌تغییر)، اندازه
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/file"، صفحه)
    مسیریاب.دریافت(م، "/part"، قطعه)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۶۲۴)
    اچ تی تی پی.استفاده(س، م)
    سرچاپ اچ تی تی پی.اجرا در پس زمینه(س)
    الف := اچ تی تی پی.دریافت("http://127.0.0.1:19624/file")
    سرچاپ اچ تی تی پی.وضعیت(الف)، اچ تی تی پی.بدنه(الف)
    سرچاپ اچ تی تی پی.دریافت سرصفحه(الف، "x-port")، اچ تی تی پی.دریافت سرصفحه(الف، "x-status")، اچ تی تی پی.دریافت سرصفحه(الف، "content-type")
    ب := اچ تی تی پی.دریافت("http://127.0.0.1:19624/part")
    سرچاپ اچ تی تی پی.وضعیت(ب)، اچ تی تی پی.بدنه(ب)
    سیستم عامل.حذف(پ)
پایان
