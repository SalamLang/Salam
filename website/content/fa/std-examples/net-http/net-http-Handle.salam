واردسازی شبکه.اچ تی تی پی شبکه
واردسازی شبکه.مسیریاب شبکه

روال خانه(ز: صحیح۶۴):
    اچ تی تی پی شبکه.متن زمینه(ز، "سلام از سرور")
پایان

روال کتاب(ز: صحیح۶۴):
    شناسه := اچ تی تی پی شبکه.پارامتر زمینه(ز، "id")
    قالب := اچ تی تی پی شبکه.پرسمان زمینه(ز، "format")
    اچ تی تی پی شبکه.تنظیم سرصفحه زمینه(ز، "X-Book"، شناسه)
    اچ تی تی پی شبکه.جیسون زمینه(ز، `{"id": "` + شناسه + `", "format": "` + قالب + `", "raw": "` + اچ تی تی پی شبکه.پرسمان خام زمینه(ز) + `"}`)
پایان

روال ساختن(ز: صحیح۶۴):
    نام := اچ تی تی پی شبکه.فرم زمینه(ز، "name")
    اچ تی تی پی شبکه.وضعیت زمینه(ز، ۲۰۱)
    اچ تی تی پی شبکه.متن زمینه(ز، اچ تی تی پی شبکه.روش زمینه(ز) + " " + اچ تی تی پی شبکه.مسیر زمینه(ز) + " " + نام + " " + اچ تی تی پی شبکه.سرصفحه زمینه(ز، "X-Client"))
پایان

روال خام(ز: صحیح۶۴):
    پاسخ := اچ تی تی پی شبکه.مالکیت زمینه(ز، "بدنه: " + اچ تی تی پی شبکه.بدنه زمینه(ز))
    اچ تی تی پی شبکه.متن زمینه(ز، پاسخ)
پایان

روال صفحه(ز: صحیح۶۴):
    اچ تی تی پی شبکه.اچ تی ام ال زمینه(ز، "<h1>سلام</h1>")
پایان

روال قدیمی(ز: صحیح۶۴):
    اچ تی تی پی شبکه.تغییرمسیر زمینه(ز، "/")
پایان

روال ریشه:
    ناپایا م := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.دریافت(م، "/"، خانه)
    مسیریاب شبکه.دریافت(م، "/books/:id"، کتاب)
    مسیریاب شبکه.ارسال(م، "/books"، ساختن)
    مسیریاب شبکه.قراردادن(م، "/raw"، خام)
    مسیریاب شبکه.دریافت(م، "/page"، صفحه)
    مسیریاب شبکه.دریافت(م، "/old"، قدیمی)
    ناپایا س := اچ تی تی پی شبکه.سرور جدید(۱۹۶۰۱)
    اچ تی تی پی شبکه.استفاده(س، م)
    سرچاپ اچ تی تی پی شبکه.اجرا در پس زمینه(س)
    پایه := "http://127.0.0.1:19601"
    پ := اچ تی تی پی شبکه.دریافت(پایه + "/")
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ)، اچ تی تی پی شبکه.بدنه(پ)
    پ۲ := اچ تی تی پی شبکه.دریافت(پایه + "/books/42?format=pdf")
    سرچاپ اچ تی تی پی شبکه.بدنه(پ۲)، اچ تی تی پی شبکه.دریافت سرصفحه(پ۲، "x-book")
    ناپایا سر := اچ تی تی پی شبکه.سرصفحه جدید()
    سر.درج("Content-Type"، "application/x-www-form-urlencoded")
    سر.درج("X-Client"، "salam")
    پ۳ := اچ تی تی پی شبکه.ارسال با(پایه + "/books"، "name=%D8%B3%D9%84%D8%A7%D9%85"، سر)
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ۳)، اچ تی تی پی شبکه.بدنه(پ۳)
    سرچاپ اچ تی تی پی شبکه.بدنه(اچ تی تی پی شبکه.قرار دادن(پایه + "/raw"، "داده"))
    پ۴ := اچ تی تی پی شبکه.دریافت(پایه + "/page")
    سرچاپ اچ تی تی پی شبکه.دریافت سرصفحه(پ۴، "content-type")، اچ تی تی پی شبکه.بدنه(پ۴)
    پ۵ := اچ تی تی پی شبکه.درخواست("GET"، پایه + "/old"، اچ تی تی پی شبکه.سرصفحه جدید()، "")
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ۵)، اچ تی تی پی شبکه.دریافت سرصفحه(پ۵، "location")
    سرچاپ اچ تی تی پی شبکه.وضعیت(اچ تی تی پی شبکه.دریافت(پایه + "/nope"))
پایان
