واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی شبکه.تی سی پی

تابع سلام(ه: صحیح۶۴):
    ز := اچ تی تی پی.زمینه جدید(ه)
    ا := اچ تی تی پی.اتصال مربوط به(ز)
    اچ تی تی پی.متن(ز، "سلام " + تی سی پی.اتصال معتبر(ا))
پایان

تابع ریشه:
    اچ تی تی پی.تنظیم بیکاری زنده نگه داشتن(۵۰۰۰)
    اچ تی تی پی.بیشینه درخواست زنده نگه داشتن(۱۰۰)
    اچ تی تی پی.بیشینه بایت سرایند(۱۶۳۸۴)
    اچ تی تی پی.بیشینه بایت بدنه(۱۰۴۸۵۷۶)
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/"، سلام)
    ناپایا س := اچ تی تی پی.سرور جدید(۸۰۸۰)
    اچ تی تی پی.تنظیم میزبان(س، "0.0.0.0")
    اچ تی تی پی.پنهان سازی توکن(س)
    اچ تی تی پی.فعال سازی گزارش دسترسی(س)
    اچ تی تی پی.استفاده(س، م)
    سرچاپ اچ تی تی پی.نسخه سرور، اچ تی تی پی.لبه است()
    اگر وارونه اچ تی تی پی.لبه است():
        اچ تی تی پی.اجرای امن(س، "cert.pem"، "key.pem")
    پایان
    اچ تی تی پی.اجرا(س)
پایان
