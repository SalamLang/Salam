واردسازی حافظه
واردسازی رشته
واردسازی فشرده سازی
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مایم
واردسازی شبکه.مسیریاب

تابع پژواک(ز: صحیح۶۴):
    اندازه := اچ تی تی پی.طول بدنه(ز)
    داده := اچ تی تی پی.بایت‌های بدنه(ز) برگردان طبیعی۸*
    ناپایا صفرها := ۰
    تکرار اندازه در ی:
        اگر داده[ی] برابر ۰ برگردان طبیعی۸: صفرها += ۱ پایان
    پایان
    اچ تی تی پی.تنظیم سرصفحه(ز، "X-Zeros"، اچ تی تی پی.مالکیت(ز، رشته.از عدد(صفرها برگردان صحیح۶۴)))
    اچ تی تی پی.بایت‌ها(ز، "application/octet-stream"، اچ تی تی پی.بایت‌های بدنه(ز)، اندازه)
پایان

تابع بارگذاری(ز: صحیح۶۴):
    ناپایا قطعه‌ها := اچ تی تی پی.چندبخشی(ز)
    دیرکن مایم.آزادسازی چندبخشی(قطعه‌ها)
    اگر قطعه‌ها.اقلام.طول() برابر ۰:
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۰)
        اچ تی تی پی.متن(ز، "چندبخشی نیست")
        برگشت
    پایان
    ناپایا پاسخ := ""
    هر قطعه در قطعه‌ها.اقلام:
        پاسخ = پاسخ + قطعه.نام + ":" + قطعه.نام پرونده + ":" + رشته.از عدد(قطعه.بدنه.طول برگردان صحیح۶۴) + " "
    پایان
    پاسخ = پاسخ + "note=" + مایم.مقدار بخش(قطعه‌ها، "note")
    اچ تی تی پی.متن(ز، اچ تی تی پی.مالکیت(ز، پاسخ))
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/echo"، پژواک)
    مسیریاب.ارسال(م، "/upload"، بارگذاری)
    ناپایا سرور := اچ تی تی پی.سرور جدید(۱۹۶۱۵)
    اچ تی تی پی.استفاده(سرور، م)
    سرچاپ اچ تی تی پی.اجرا در پس زمینه(سرور)
    نشانی := اچ تی تی پی.تجزیه نقطه پایانی("http://127.0.0.1:19615")

    داده := حافظه.تخصیص(۴ برگردان طبیعی۶۴)
    بایت‌ها := داده برگردان طبیعی۸*
    بایت‌ها[۰] = ۸۳ برگردان طبیعی۸
    بایت‌ها[۱] = ۰ برگردان طبیعی۸
    بایت‌ها[۲] = ۲۵۵ برگردان طبیعی۸
    بایت‌ها[۳] = ۰ برگردان طبیعی۸
    سر := "POST /echo HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Length: 4\r\nConnection: close\r\n\r\n"
    ناپایا الف := اچ تی تی پی.ارسال خام با مهلت(نشانی، سر، داده، ۴، ۲۰۰۰)
    برگشتی := الف.داده برگردان طبیعی۸*
    سرچاپ الف.وضعیت، الف.اندازه، اچ تی تی پی.مقدار سرصفحه(الف.سرصفحه، "x-zeros")، اچ تی تی پی.مقدار سرصفحه(الف.سرصفحه، "content-type")
    سرچاپ برگشتی[۰] برگردان صحیح، برگشتی[۱] برگردان صحیح، برگشتی[۲] برگردان صحیح، برگشتی[۳] برگردان صحیح
    اچ تی تی پی.آزادسازی پاسخ خام(الف)

    ناپایا نویسنده := مایم.نویسنده چندبخشی جدید()
    مایم.نوشتن فیلد(نویسنده، "note"، "سفر")
    مایم.نوشتن پرونده(نویسنده، "photo"، "pic.bin"، "image/png"، داده، ۴)
    ناپایا بدنه := مایم.بستن نویسنده(نویسنده)
    بالا := "POST /upload HTTP/1.1\r\nHost: 127.0.0.1\r\nContent-Type: " + مایم.سرآیند نوع محتوا(نویسنده) + "\r\nContent-Length: " + رشته.از عدد(بدنه.طول برگردان صحیح۶۴) + "\r\nConnection: close\r\n\r\n"
    ناپایا ب := اچ تی تی پی.ارسال خام با مهلت(نشانی، بالا، بدنه.داده، بدنه.طول، ۲۰۰۰)
    سرچاپ ب.وضعیت، اچ تی تی پی.متن پاسخ خام(ب)
    اچ تی تی پی.آزادسازی پاسخ خام(ب)
    فشرده سازی.آزادسازی بافر(بدنه)
    حافظه.آزادسازی(داده)

    ساده := اچ تی تی پی.ارسال("http://127.0.0.1:19615/upload"، "note=x")
    سرچاپ اچ تی تی پی.وضعیت(ساده)، اچ تی تی پی.بدنه(ساده)
پایان
