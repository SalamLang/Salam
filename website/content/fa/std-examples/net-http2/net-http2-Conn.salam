واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی شبکه
واردسازی فشرده سازی

ناپایا سرور := تی سی پی شبکه.سرور {}

روال پاسخ‌گو():
    ا := تی سی پی شبکه.پذیرش(سرور)
    ناپایا ک := اچ تی تی پی۲.اتصال جدید(اچ تی تی پی۲.ترابری ساده(ا.fd)، درست)
    اگر وارونه اچ تی تی پی۲.دست‌دهی سرور(ک):
        برگشت
    پایان
    شناسه := اچ تی تی پی۲.انتظار سرآیند(ک، ۲۰)
    ج := اچ تی تی پی۲.جریان با شناسه(ک، شناسه)
    ناپایا سر := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(سر، ":status"، "200")
    اچ تی تی پی۲.افزودن سرآیند(سر، "content-type"، "text/plain")
    _ := اچ تی تی پی۲.ارسال سرآیندها(ک، شناسه، سر، نادرست)
    _ := اچ تی تی پی۲.ارسال داده(ک، شناسه، فشرده سازی.بافر از رشته("سلام " + اچ تی تی پی۲.دریافت سرآیند(ج.headers، ":path"))، نادرست)
    ناپایا دنباله := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(دنباله، "x-done"، "1")
    _ := اچ تی تی پی۲.ارسال دنباله‌ها(ک، شناسه، دنباله)
    _ := اچ تی تی پی۲.انتظار اتمام جریان(ک، ۰، ۵)
    اچ تی تی پی۲.بستن اتصال(ک)
پایان

روال ریشه:
    سرور = تی سی پی شبکه.پیوند(۰)
    ن := spawn(پاسخ‌گو)
    ا := تی سی پی شبکه.شماره گیری("127.0.0.1"، تی سی پی شبکه.درگاه(سرور))
    ت := اچ تی تی پی۲.ترابری ساده(ا.fd)
    سرچاپ ت.ok، ت.kind == اچ تی تی پی۲.انتقال ساده
    ناپایا ک := اچ تی تی پی۲.اتصال جدید(ت، نادرست)
    سرچاپ اچ تی تی پی۲.دست‌دهی کارخواه(ک)، اچ تی تی پی۲.اتصال معتبر(ک)
    شناسه := اچ تی تی پی۲.شناسه جریان بعدی(ک)
    ناپایا سر := اچ تی تی پی۲.فهرست سرآیندها {}
    اچ تی تی پی۲.افزودن سرآیند(سر، ":method"، "GET")
    اچ تی تی پی۲.افزودن سرآیند(سر، ":scheme"، "http")
    اچ تی تی پی۲.افزودن سرآیند(سر، ":path"، "/books")
    اچ تی تی پی۲.افزودن سرآیند(سر، ":authority"، "127.0.0.1")
    سرچاپ شناسه، اچ تی تی پی۲.ارسال سرآیندها(ک، شناسه، سر، درست)
    سرچاپ اچ تی تی پی۲.انتظار اتمام جریان(ک، شناسه، ۲۰)
    ج := اچ تی تی پی۲.جریان با شناسه(ک، شناسه)
    سرچاپ اچ تی تی پی۲.دریافت سرآیند(ج.headers، ":status")، فشرده سازی.بافر به رشته(ج.data)، ج.got_trailers، اچ تی تی پی۲.دریافت سرآیند(ج.trailers، "x-done")، ج.end_stream
    سرچاپ اچ تی تی پی۲.تعداد جریان‌ها(ک) >= ۱، ک.remote.max_frame_size
    _ := اچ تی تی پی۲.ارسال پینگ(ک، فشرده سازی.بافر از رشته("abcdefgh"))
    سرچاپ اچ تی تی پی۲.دریافت رویداد(ک) >= اچ تی تی پی۲.نتیجه اتصال
    _ := اچ تی تی پی۲.ارسال بازنشانی جریان(ک، اچ تی تی پی۲.شناسه جریان بعدی(ک)، اچ تی تی پی۲.کد لغو)
    سرچاپ اچ تی تی پی۲.ارسال خداحافظی(ک، اچ تی تی پی۲.کد بدون خطا، "")
    اچ تی تی پی۲.بستن اتصال(ک)
    join(ن)
    تی سی پی شبکه.بستن سرور(سرور)
پایان
