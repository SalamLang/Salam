واردسازی شبکه.اچ تی تی پی۲
واردسازی شبکه.تی سی پی
واردسازی فشرده سازی

ناپایا سرور := تی سی پی.سرور {}

روال پاسخ‌گو():
    ا := تی سی پی.پذیرش(سرور)
    ناپایا ت := اچ تی تی پی۲.ترابری ساده(ا.fd)
    سرچاپ "سرور پیش‌درآمد:"، اچ تی تی پی۲.خواندن پیش‌درآمد(ت)
    ق := اچ تی تی پی۲.خواندن قاب(ت، اچ تی تی پی۲.اندازه پیش‌فرض قاب)
    سرچاپ "سرور قاب:"، ق.ok، اچ تی تی پی۲.نام نوع قاب(ق.kind)، ق.stream_id، فشرده سازی.بافر به رشته(ق.payload)
    اچ تی تی پی۲.بستن ترابری(ت)
پایان

روال ریشه:
    سرور = تی سی پی.پیوند(۰)
    ن := spawn(پاسخ‌گو)
    ا := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(سرور))
    ناپایا ت := اچ تی تی پی۲.ترابری ساده(ا.fd)
    _ := اچ تی تی پی۲.نوشتن پیش‌درآمد(ت)
    ناپایا د := اچ تی تی پی۲.قاب جدید(اچ تی تی پی۲.قاب داده، ۰، ۳)
    فشرده سازی.افزودن بافر(د.payload، فشرده سازی.بافر از رشته("hi"))
    _ := اچ تی تی پی۲.نوشتن قاب(ت، د)
    join(ن)
    اچ تی تی پی۲.بستن ترابری(ت)
    تی سی پی.بستن سرور(سرور)
    سرچاپ اچ تی تی پی۲.پیش‌درآمد اچ‌تی‌تی‌پی۲.طول()
پایان
