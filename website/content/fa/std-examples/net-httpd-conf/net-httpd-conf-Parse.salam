واردسازی شبکه.سرور وب.پیکربندی وب

تابع ریشه:
    متن := `
server:
    site:
        listen = 80 tls
        names = "a.test www.a.test"
        location "/api/": cache = 1h end
    end
end
`
    د := پیکربندی وب.تجزیه(متن)
    سرچاپ د.درست است، د.گره ها.طول()، پیکربندی وب.شمار فرزندان(د، پیکربندی وب.گره ریشه())
    سر := پیکربندی وب.یافتن فرزند(د، پیکربندی وب.گره ریشه()، "server")
    سا := پیکربندی وب.یافتن فرزند(د، سر، "site")
    سرچاپ پیکربندی وب.نام(د، سا)، پیکربندی وب.شمار فرزندان(د، سا)، د.گره ها.بگیر(سا).بلوک است
    ل := پیکربندی وب.یافتن فرزند(د، سا، "listen")
    م := د.گره ها.بگیر(ل).مقدارها.بگیر(۰)
    سرچاپ م.متن مقدار، م.نوع مقدار == پیکربندی وب.مقدار عددی، م.خط مقدار، م.ستون مقدار
    وا := د.گره ها.بگیر(ل).مقدارها.بگیر(۱)
    سرچاپ وا.متن مقدار، وا.نوع مقدار == پیکربندی وب.مقدار واژه، پیکربندی وب.متن مقدار گره(د، پیکربندی وب.یافتن فرزند(د، سا، "names")، ۰)
    ن := د.گره ها.بگیر(پیکربندی وب.یافتن فرزند(د، سا، "names")).مقدارها.بگیر(۰)
    سرچاپ ن.نوع مقدار == پیکربندی وب.مقدار رشته
    مس := پیکربندی وب.فرزند شماره(د، سا، ۲)
    ک := د.گره ها.بگیر(مس)
    سرچاپ پیکربندی وب.نام(د، مس)، ک.برچسب ها.بگیر(۰)، ک.بلوک است، ک.واژه های نام.طول()، ک.فرزندان.طول()، ک.خط گره، ک.ستون گره
    پیکربندی وب.آزاد سازی(د)
پایان
