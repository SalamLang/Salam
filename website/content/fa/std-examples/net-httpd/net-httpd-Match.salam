واردسازی شبکه.سرور وب

تابع ریشه:
    متن := `
server:
    site:
        listen = 8080
        names = "example.test *.example.test"
        location "/assets/": cache = 30d end
        location "= /health": return = 200 "ok" end
        location "^~ /static/": cache = 1h end
        location "~ \.php$": return = 403 "no" end
    end
    site:
        listen = 8080
        names = "other.test"
        default = true
    end
end
`
    سرچاپ سرور وب.بارگذاری متن پیکربندی(متن، "match.salam")، سرور وب.شمار مشکل ها()
    سرچاپ سرور وب.شمار سایت ها()، سرور وب.نام های سایت(۰)، سرور وب.نام های سایت(۱)
    سرچاپ سرور وب.سایت برای("example.test"، ۸۰۸۰)، سرور وب.سایت برای("API.Example.Test:8080"، ۸۰۸۰)، سرور وب.سایت برای("other.test."، ۸۰۸۰)
    سرچاپ سرور وب.سایت برای("unknown.test"، ۸۰۸۰)، سرور وب.سایت برای("example.test"، ۹۰۹۰)
    سرچاپ سرور وب.الگوی مسیر(سرور وب.مسیر برای(۰، "/health"))
    سرچاپ سرور وب.الگوی مسیر(سرور وب.مسیر برای(۰، "/assets/logo.png"))
    سرچاپ سرور وب.الگوی مسیر(سرور وب.مسیر برای(۰، "/static/a.php"))
    سرچاپ سرور وب.الگوی مسیر(سرور وب.مسیر برای(۰، "/x/index.php"))
    سرچاپ سرور وب.مسیر برای(۰، "/plain")، سرور وب.مسیر برای(۱، "/anything")
پایان
