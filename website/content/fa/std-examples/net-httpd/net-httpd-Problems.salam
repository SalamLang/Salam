واردسازی شبکه.سرور وب

تابع آزمون(متن: رشته):
    درست‌بود := سرور وب.بارگذاری متن پیکربندی(متن، "bad.salam")
    سرچاپ درست‌بود، سرور وب.شمار مشکل ها()
    تکرار سرور وب.شمار مشکل ها() در ای:
        سرچاپ سرور وب.مشکل شماره(ای)
    پایان
پایان

تابع ریشه:
    آزمون("server:\n    sit:\n    end\nend\n")
    آزمون("server:\n    site:\n        listen = 70000\n    end\nend\n")
    آزمون("server:\n    site:\n        names = \"a.test\"\n        root = \"/no/such/dir\"\n    end\nend\n")
    آزمون("server:\n    site:\n        names = \"a.test\"\n    end\n    site:\n        names = \"a.test\"\n    end\nend\n")
    آزمون("server:\n    site:\n        listen = 443 tls\n    end\nend\n")
    آزمون("server:\n    site:\n        names = \"a.test\"\n        location \"/x\": hedaer = \"A\" \"b\" end\n    end\nend\n")
    آزمون("server:\nend\n")
    آزمون("server:\n    site:\n        names = \"a.test\"\n        cache = soon\n    end\nend\n")
    آزمون("server:\n    site:\n        names = \"a.test\"\n        location \"/x\": alias = \"/tmp\" end\n        location \"~ x\": alias = \"/tmp\" end\n    end\nend\n")
