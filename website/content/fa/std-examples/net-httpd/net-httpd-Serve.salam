پایان

تابع بگیر(میزبان: رشته، مسیر: رشته): اچ تی تی پی.پاسخ:
    ج := اچ تی تی پی.انجام درخواست("GET"، "http://" + میزبان + ":19435" + مسیر، اچ تی تی پی.سرصفحه جدید()، ""، اچ تی تی پی.گزینه های درخواست {})
    برگشت ج
پایان

تابع ریشه:
    ریشه_پوشه := سیستم عامل.پوشه موقت() + "/salam_httpd_serve_fa"
    سیستم عامل.حذف همه(ریشه_پوشه)
    سیستم عامل.ساخت پوشه ها(ریشه_پوشه + "/shop")
    سیستم عامل.ساخت پوشه ها(ریشه_پوشه + "/blog")
    ورودی خروجی.نوشتن پرونده(ریشه_پوشه + "/shop/index.html"، "فروشگاه")
    ورودی خروجی.نوشتن پرونده(ریشه_پوشه + "/blog/index.html"، "وبلاگ")
    ورودی خروجی.نوشتن پرونده(ریشه_پوشه + "/blog/404.html"، "چنین نوشته‌ای نیست")
    متن := `
server:
    site:
        listen = 19435
        names = "localhost"
        root = "@ROOT@/shop"
        header = "X-Site" "shop"
        location "= /health": return = 200 "ok" end
        location "/old/": redirect = "http://$host/new$uri" code = 302 end
    end
    site:
        listen = 19435
        names = "127.0.0.1"
        root = "@ROOT@/blog"
        error page = 404 "404.html"
    end
end
`
    سرچاپ سرور وب.بارگذاری متن پیکربندی(رشته.جایگزینی(متن، "@ROOT@"، ریشه_پوشه)، "serve.salam")
    ن := نخ‌ساز(سرو)
    زمان.خواب(۳۰۰)
    الف := بگیر("localhost"، "/")
    سرچاپ الف.وضعیت، الف.بدنه، اچ تی تی پی.دریافت سرصفحه(الف، "x-site")
    ب := بگیر("127.0.0.1"، "/")
    سرچاپ ب.وضعیت، ب.بدنه
    سرچاپ بگیر("localhost"، "/health").بدنه
    پ := بگیر("localhost"، "/old/page")
    سرچاپ پ.وضعیت، اچ تی تی پی.دریافت سرصفحه(پ، "location")
    ت := بگیر("127.0.0.1"، "/missing")
    سرچاپ ت.وضعیت، ت.بدنه
    سرچاپ بگیر("localhost"، "/.git/config").وضعیت
    سرور وب.توقف()
    نخ‌پیوند(ن)
    سیستم عامل.حذف همه(ریشه_پوشه)
