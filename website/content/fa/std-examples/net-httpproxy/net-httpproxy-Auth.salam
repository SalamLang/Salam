// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا درگاه_مبدأ := 0
ناپایا درگاه_پژواک := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع origin():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_مبدأ = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        درخواست := تی سی پی.خواندن(نویسه، 4096)
        نخست := درخواست.زیررشته(0، درخواست.بیاب("\r\n"))
        بدنه := "origin saw: " + نخست
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: " + بدنه.طول() + "\r\nConnection: close\r\n\r\n" + بدنه)
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع echo():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        تی سی پی.نوشتن(نویسه، "echo:" + تی سی پی.خواندن(نویسه، 100))
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(origin)
    متغیر__b := نخ‌ساز(echo)
    همگام سازی.انتظار(آماده)
پایان

تابع ریشه:
    start_backends()
    ناپایا پیکربندی := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    پیکربندی.قلمرو = "demo"
    پراکسی اچ‌تی‌تی‌پی.افزودن کاربر(پیکربندی، "alice"، "s3cret")
    سرچاپ پیکربندی.نیاز به احراز هویت، پیکربندی.قلمرو
    کارساز := پراکسی اچ‌تی‌تی‌پی.شروع(پیکربندی)
    نشانی := "http://127.0.0.1:" + درگاه_مبدأ + "/"

    متغیر_anonymous := پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، کارساز.درگاه)، نشانی)
    سرچاپ "no login:"، متغیر_anonymous.وضعیت، پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(متغیر_anonymous.سرآیند، "proxy-authenticate")
    نادرست := پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، کارساز.درگاه، "alice"، "nope")، نشانی)
    سرچاپ "wrong password:"، نادرست.وضعیت
    راست := پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، کارساز.درگاه، "alice"، "s3cret")، نشانی)
    سرچاپ "right password:"، راست.وضعیت، راست.بدنه
    سرچاپ "connect without login:"، پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، کارساز.درگاه)، "127.0.0.1"، درگاه_پژواک).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(کارساز)

    ناپایا متغیر_custom := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(متغیر_custom، درست)
    پراکسی اچ‌تی‌تی‌پی.تعیین احراز هویت(متغیر_custom، (user: رشته، password: رشته): برگشت user برابر "bob" و password برابر "pw" پایان)
    سرچاپ متغیر_custom.دارای احراز هویت سفارشی
    دومی := پراکسی اچ‌تی‌تی‌پی.شروع(متغیر_custom)
    سرچاپ "callback good:"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، دومی.درگاه، "bob"، "pw")، نشانی).وضعیت
    سرچاپ "callback bad:"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، دومی.درگاه، "bob"، "x")، نشانی).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(دومی)
پایان
