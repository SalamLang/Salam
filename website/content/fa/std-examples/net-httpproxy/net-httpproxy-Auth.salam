// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا origin_port := 0
ناپایا echo_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع origin():
    srv := تی سی پی.پیوند(0)
    origin_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        request := تی سی پی.خواندن(c، 4096)
        first := request.زیررشته(0، request.بیاب("\r\n"))
        body := "origin saw: " + first
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: " + body.طول() + "\r\nConnection: close\r\n\r\n" + body)
        تی سی پی.بستن(c)
    پایان
پایان

تابع echo():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 100))
        تی سی پی.بستن(c)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _a := نخ‌ساز(origin)
    _b := نخ‌ساز(echo)
    همگام سازی.انتظار(ready)
پایان

تابع ریشه:
    start_backends()
    ناپایا config := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    config.قلمرو = "demo"
    پراکسی اچ‌تی‌تی‌پی.افزودن کاربر(config، "alice"، "s3cret")
    سرچاپ config.نیاز به احراز هویت، config.قلمرو
    server := پراکسی اچ‌تی‌تی‌پی.شروع(config)
    url := "http://127.0.0.1:" + origin_port + "/"

    anonymous := پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، server.درگاه)، url)
    سرچاپ "no login:"، anonymous.وضعیت، پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(anonymous.سرآیند، "proxy-authenticate")
    wrong := پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، server.درگاه، "alice"، "nope")، url)
    سرچاپ "wrong password:"، wrong.وضعیت
    right := پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، server.درگاه، "alice"، "s3cret")، url)
    سرچاپ "right password:"، right.وضعیت، right.بدنه
    سرچاپ "connect without login:"، پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، server.درگاه)، "127.0.0.1"، echo_port).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(server)

    ناپایا custom := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.تعیین احراز هویت(custom، (user: رشته، password: رشته): برگشت user برابر "bob" و password برابر "pw" پایان)
    سرچاپ custom.دارای احراز هویت سفارشی
    second := پراکسی اچ‌تی‌تی‌پی.شروع(custom)
    سرچاپ "callback good:"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، second.درگاه، "bob"، "pw")، url).وضعیت
    سرچاپ "callback bad:"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، second.درگاه، "bob"، "x")، url).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(second)
پایان
