// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا درگاه_مبدأ := 0
ناپایا درگاه_پژواک := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع origin():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_مبدأ = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        درخواست := تی سی پی.خواندن(نویسه، 4096)
        نخست := درخواست.زیررشته(0، درخواست.بیاب("\r\n"))
        بدنه := "origin saw: " + نخست
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: " + بدنه.طول() + "\r\nConnection: close\r\n\r\n" + بدنه)
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع echo():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        تی سی پی.نوشتن(نویسه، "echo:" + تی سی پی.خواندن(نویسه، 100))
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(origin)
    متغیر__b := نخ‌ساز(echo)
    همگام سازی.انتظار(آماده)
پایان

تابع ریشه:
    start_backends()
    ناپایا پیکربندی_کارساز := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(پیکربندی_کارساز، درست)
    کارساز := پراکسی اچ‌تی‌تی‌پی.شروع(پیکربندی_کارساز)
    کارخواه := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، کارساز.درگاه)

    تونل := پراکسی اچ‌تی‌تی‌پی.اتصال(کارخواه، "127.0.0.1"، درگاه_پژواک)
    سرچاپ "connect:"، تونل.موفق، تونل.وضعیت
    تونل.جریان.نوشتن("bytes pass through untouched")
    سرچاپ تونل.جریان.خواندن(100)
    تونل.جریان.بستن()

    اتصال := پراکسی اچ‌تی‌تی‌پی.شماره‌گیری اتصال(کارخواه، "127.0.0.1"، درگاه_پژواک)
    تی سی پی.نوشتن(اتصال، "plain conn")
    سرچاپ تی سی پی.خواندن(اتصال، 100)
    تی سی پی.بستن(اتصال)

    متغیر_refused := پراکسی اچ‌تی‌تی‌پی.اتصال(کارخواه، "127.0.0.1"، تی سی پی.درگاه آزاد())
    سرچاپ "refused:"، متغیر_refused.موفق، متغیر_refused.وضعیت، متغیر_refused.خطا
    پراکسی اچ‌تی‌تی‌پی.توقف(کارساز)

    ناپایا متغیر_first_cfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(متغیر_first_cfg، درست)
    نخست := پراکسی اچ‌تی‌تی‌پی.شروع(متغیر_first_cfg)
    ناپایا متغیر_second_cfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(متغیر_second_cfg، درست)
    دومی := پراکسی اچ‌تی‌تی‌پی.شروع(متغیر_second_cfg)
    گام := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، نخست.درگاه)، "127.0.0.1"، دومی.درگاه)
    متغیر_onward := پراکسی اچ‌تی‌تی‌پی.دست‌دهی کلاینت(گام.جریان، پراکسی اچ‌تی‌تی‌پی.کلاینت جدید(""، 0)، "127.0.0.1"، درگاه_پژواک)
    سرچاپ "second hop:"، متغیر_onward.موفق، متغیر_onward.وضعیت
    گام.جریان.نوشتن("two hops")
    سرچاپ گام.جریان.خواندن(100)
    گام.جریان.بستن()
    پراکسی اچ‌تی‌تی‌پی.توقف(نخست)
    پراکسی اچ‌تی‌تی‌پی.توقف(دومی)
پایان
