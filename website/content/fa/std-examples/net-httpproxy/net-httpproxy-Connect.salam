// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا origin_port := 0
ناپایا echo_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع origin():
    srv := تی سی پی.پیوند(0)
    origin_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        request := تی سی پی.خواندن(c، 4096)
        first := request.زیررشته(0، request.بیاب("\r\n"))
        body := "origin saw: " + first
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: " + body.طول() + "\r\nConnection: close\r\n\r\n" + body)
        تی سی پی.بستن(c)
    پایان
پایان

تابع echo():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 100))
        تی سی پی.بستن(c)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _a := نخ‌ساز(origin)
    _b := نخ‌ساز(echo)
    همگام سازی.انتظار(ready)
پایان

تابع ریشه:
    start_backends()
    server := پراکسی اچ‌تی‌تی‌پی.شروع(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0))
    client := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، server.درگاه)

    tunnel := پراکسی اچ‌تی‌تی‌پی.اتصال(client، "127.0.0.1"، echo_port)
    سرچاپ "connect:"، tunnel.موفق، tunnel.وضعیت
    tunnel.جریان.نوشتن("bytes pass through untouched")
    سرچاپ tunnel.جریان.خواندن(100)
    tunnel.جریان.بستن()

    conn := پراکسی اچ‌تی‌تی‌پی.شماره‌گیری اتصال(client، "127.0.0.1"، echo_port)
    تی سی پی.نوشتن(conn، "plain conn")
    سرچاپ تی سی پی.خواندن(conn، 100)
    تی سی پی.بستن(conn)

    refused := پراکسی اچ‌تی‌تی‌پی.اتصال(client، "127.0.0.1"، تی سی پی.درگاه آزاد())
    سرچاپ "refused:"، refused.موفق، refused.وضعیت، refused.خطا
    پراکسی اچ‌تی‌تی‌پی.توقف(server)

    first := پراکسی اچ‌تی‌تی‌پی.شروع(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0))
    second := پراکسی اچ‌تی‌تی‌پی.شروع(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0))
    hop := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، first.درگاه)، "127.0.0.1"، second.درگاه)
    onward := پراکسی اچ‌تی‌تی‌پی.دست‌دهی کلاینت(hop.جریان، پراکسی اچ‌تی‌تی‌پی.کلاینت جدید(""، 0)، "127.0.0.1"، echo_port)
    سرچاپ "second hop:"، onward.موفق، onward.وضعیت
    hop.جریان.نوشتن("two hops")
    سرچاپ hop.جریان.خواندن(100)
    hop.جریان.بستن()
    پراکسی اچ‌تی‌تی‌پی.توقف(first)
    پراکسی اچ‌تی‌تی‌پی.توقف(second)
پایان
