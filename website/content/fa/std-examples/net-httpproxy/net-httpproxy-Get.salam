// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا درگاه_مبدأ := 0
ناپایا درگاه_پژواک := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع origin():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_مبدأ = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        درخواست := تی سی پی.خواندن(نویسه، 4096)
        نخست := درخواست.زیررشته(0، درخواست.بیاب("\r\n"))
        بدنه := "origin saw: " + نخست
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: " + بدنه.طول() + "\r\nConnection: close\r\n\r\n" + بدنه)
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع echo():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        تی سی پی.نوشتن(نویسه، "echo:" + تی سی پی.خواندن(نویسه، 100))
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(origin)
    متغیر__b := نخ‌ساز(echo)
    همگام سازی.انتظار(آماده)
پایان

تابع ریشه:
    start_backends()
    ناپایا پیکربندی_کارساز := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(پیکربندی_کارساز، درست)
    کارساز := پراکسی اچ‌تی‌تی‌پی.شروع(پیکربندی_کارساز)
    سرچاپ "proxy up:"، کارساز.موفق
    کارخواه := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، کارساز.درگاه)
    سرچاپ کارخواه.مهلت میلی‌ثانیه، کارخواه.بیشترین اندازه بدنه، کارخواه.امن

    نشانی := "http://127.0.0.1:" + درگاه_مبدأ
    خوانده := پراکسی اچ‌تی‌تی‌پی.دریافت(کارخواه، نشانی + "/hello?x=1")
    سرچاپ خوانده.موفق، خوانده.وضعیت، خوانده.طول بدنه، خوانده.بدنه
    سرچاپ پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(خوانده.سرآیند، "content-length")، خوانده.سرآیند.دلیل

    ویژگی_محلی := پراکسی اچ‌تی‌تی‌پی.ارسال(کارخواه، نشانی + "/submit"، "text/plain"، "payload")
    سرچاپ ویژگی_محلی.موفق، ویژگی_محلی.وضعیت، ویژگی_محلی.بدنه
    متغیر_custom := پراکسی اچ‌تی‌تی‌پی.درخواست(کارخواه، "PUT"، نشانی + "/thing"، "X-Trace: 1\r\n"، "data")
    سرچاپ متغیر_custom.وضعیت، متغیر_custom.بدنه

    متغیر_https := پراکسی اچ‌تی‌تی‌پی.دریافت(کارخواه، "https://127.0.0.1/")
    سرچاپ متغیر_https.موفق، متغیر_https.خطا
    پراکسی اچ‌تی‌تی‌پی.توقف(کارساز)
پایان
