// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی همگام سازی

ناپایا origin_port := 0
ناپایا echo_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع origin():
    srv := تی سی پی.پیوند(0)
    origin_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        request := تی سی پی.خواندن(c، 4096)
        first := request.زیررشته(0، request.بیاب("\r\n"))
        body := "origin saw: " + first
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: " + body.طول() + "\r\nConnection: close\r\n\r\n" + body)
        تی سی پی.بستن(c)
    پایان
پایان

تابع echo():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 100))
        تی سی پی.بستن(c)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _a := نخ‌ساز(origin)
    _b := نخ‌ساز(echo)
    همگام سازی.انتظار(ready)
پایان

تابع ریشه:
    start_backends()
    ناپایا server_cfg := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(server_cfg، درست)
    server := پراکسی اچ‌تی‌تی‌پی.شروع(server_cfg)
    سرچاپ "proxy up:"، server.موفق
    client := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، server.درگاه)
    سرچاپ client.مهلت میلی‌ثانیه، client.بیشترین اندازه بدنه، client.امن

    url := "http://127.0.0.1:" + origin_port
    r := پراکسی اچ‌تی‌تی‌پی.دریافت(client، url + "/hello?x=1")
    سرچاپ r.موفق، r.وضعیت، r.طول بدنه، r.بدنه
    سرچاپ پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(r.سرآیند، "content-length")، r.سرآیند.دلیل

    p := پراکسی اچ‌تی‌تی‌پی.ارسال(client، url + "/submit"، "text/plain"، "payload")
    سرچاپ p.موفق، p.وضعیت، p.بدنه
    custom := پراکسی اچ‌تی‌تی‌پی.درخواست(client، "PUT"، url + "/thing"، "X-Trace: 1\r\n"، "data")
    سرچاپ custom.وضعیت، custom.بدنه

    https := پراکسی اچ‌تی‌تی‌پی.دریافت(client، "https://127.0.0.1/")
    سرچاپ https.موفق، https.خطا
    پراکسی اچ‌تی‌تی‌پی.توقف(server)
پایان
