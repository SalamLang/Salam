// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا proxy_port := 0

ناپایا origin_port := 0
ناپایا echo_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع origin():
    srv := تی سی پی.پیوند(0)
    origin_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        request := تی سی پی.خواندن(c، 4096)
        first := request.زیررشته(0، request.بیاب("\r\n"))
        body := "origin saw: " + first
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: " + body.طول() + "\r\nConnection: close\r\n\r\n" + body)
        تی سی پی.بستن(c)
    پایان
پایان

تابع echo():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 100))
        تی سی پی.بستن(c)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _a := نخ‌ساز(origin)
    _b := نخ‌ساز(echo)
    همگام سازی.انتظار(ready)
پایان

تابع serve_one():
    listener := تی سی پی.پیوند(0)
    proxy_port = تی سی پی.درگاه(listener)
    همگام سازی.اتمام(ready)
    c := تی سی پی.پذیرش(listener)
    پراکسی اچ‌تی‌تی‌پی.رسیدگی(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)، تونل.پوشاندن تی سی پی(c))
پایان

تابع ریشه:
    start_backends()
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(serve_one)
    همگام سازی.انتظار(ready)
    client := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، proxy_port)
    سرچاپ پراکسی اچ‌تی‌تی‌پی.دریافت(client، "http://127.0.0.1:" + origin_port + "/by-hand").بدنه
پایان
