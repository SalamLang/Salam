// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا متغیر_proxy_port := 0

ناپایا درگاه_مبدأ := 0
ناپایا درگاه_پژواک := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع origin():
    کارساز := تی سی پی.پیوند(0)
    درگاه_مبدأ = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        درخواست := تی سی پی.خواندن(نویسه، 4096)
        نخست := درخواست.زیررشته(0، درخواست.بیاب("\r\n"))
        بدنه := "origin saw: " + نخست
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: " + بدنه.طول() + "\r\nConnection: close\r\n\r\n" + بدنه)
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع echo():
    کارساز := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        تی سی پی.نوشتن(نویسه، "echo:" + تی سی پی.خواندن(نویسه، 100))
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(origin)
    متغیر__b := نخ‌ساز(echo)
    همگام سازی.انتظار(آماده)
پایان

تابع serve_one():
    شنونده := تی سی پی.پیوند(0)
    متغیر_proxy_port = تی سی پی.درگاه(شنونده)
    همگام سازی.اتمام(آماده)
    نویسه := تی سی پی.پذیرش(شنونده)
    پراکسی اچ‌تی‌تی‌پی.رسیدگی(پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)، تونل.پوشاندن تی سی پی(نویسه))
پایان

تابع ریشه:
    start_backends()
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    متغیر__t := نخ‌ساز(serve_one)
    همگام سازی.انتظار(آماده)
    کارخواه := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، متغیر_proxy_port)
    سرچاپ پراکسی اچ‌تی‌تی‌پی.دریافت(کارخواه، "http://127.0.0.1:" + درگاه_مبدأ + "/by-hand").بدنه
پایان
