// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا درگاه_مبدأ := 0
ناپایا درگاه_پژواک := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع origin():
    کارساز := تی سی پی.پیوند(0)
    درگاه_مبدأ = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        درخواست := تی سی پی.خواندن(نویسه، 4096)
        نخست := درخواست.زیررشته(0، درخواست.بیاب("\r\n"))
        بدنه := "origin saw: " + نخست
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: " + بدنه.طول() + "\r\nConnection: close\r\n\r\n" + بدنه)
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع echo():
    کارساز := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        تی سی پی.نوشتن(نویسه، "echo:" + تی سی پی.خواندن(نویسه، 100))
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(origin)
    متغیر__b := نخ‌ساز(echo)
    همگام سازی.انتظار(آماده)
پایان

تابع ریشه:
    start_backends()
    ناپایا پیکربندی := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.افزودن کاربر(پیکربندی، "u"، "p")
    متغیر_inbound_protocol := پراکسی اچ‌تی‌تی‌پی.ورودی جدید(پیکربندی)
    سرچاپ متغیر_inbound_protocol.نام()

    پیشرو := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، متغیر_inbound_protocol)
    شنونده := تونل.شنود تی سی پی(0)
    تونل.سرویس‌دهی پس‌زمینه(شنونده، متغیر_inbound_protocol، پیشرو)

    کارخواه := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، شنونده.درگاه، "u"، "p")
    سرچاپ پراکسی اچ‌تی‌تی‌پی.دریافت(کارخواه، "http://127.0.0.1:" + درگاه_مبدأ + "/page").بدنه
    متغیر_tunnel_result := پراکسی اچ‌تی‌تی‌پی.اتصال(کارخواه، "127.0.0.1"، درگاه_پژواک)
    متغیر_tunnel_result.جریان.نوشتن("connect through the inbound")
    سرچاپ متغیر_tunnel_result.وضعیت، متغیر_tunnel_result.جریان.خواندن(100)
    متغیر_tunnel_result.جریان.بستن()
    سرچاپ "without login:"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، شنونده.درگاه)، "http://127.0.0.1:" + درگاه_مبدأ + "/").وضعیت
    شنونده.توقف()

    گام := پراکسی اچ‌تی‌تی‌پی.رابط جدید(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، 3128))
    سرچاپ گام.نام()، گام.کارساز().متن()
    متغیر_via := تونل.از طریق(تونل.مستقیم()، گام)
    سرچاپ متغیر_via.نام()
پایان
