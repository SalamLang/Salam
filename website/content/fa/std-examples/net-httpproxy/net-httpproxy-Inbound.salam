// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا origin_port := 0
ناپایا echo_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع origin():
    srv := تی سی پی.پیوند(0)
    origin_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        request := تی سی پی.خواندن(c، 4096)
        first := request.زیررشته(0، request.بیاب("\r\n"))
        body := "origin saw: " + first
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: " + body.طول() + "\r\nConnection: close\r\n\r\n" + body)
        تی سی پی.بستن(c)
    پایان
پایان

تابع echo():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 100))
        تی سی پی.بستن(c)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _a := نخ‌ساز(origin)
    _b := نخ‌ساز(echo)
    همگام سازی.انتظار(ready)
پایان

تابع ریشه:
    start_backends()
    ناپایا config := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.افزودن کاربر(config، "u"، "p")
    inbound_protocol := پراکسی اچ‌تی‌تی‌پی.ورودی جدید(config)
    سرچاپ inbound_protocol.نام()

    forward := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، inbound_protocol)
    listener := تونل.شنود تی سی پی(0)
    تونل.سرویس‌دهی پس‌زمینه(listener، inbound_protocol، forward)

    client := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("127.0.0.1"، listener.درگاه، "u"، "p")
    سرچاپ پراکسی اچ‌تی‌تی‌پی.دریافت(client، "http://127.0.0.1:" + origin_port + "/page").بدنه
    tunnel_result := پراکسی اچ‌تی‌تی‌پی.اتصال(client، "127.0.0.1"، echo_port)
    tunnel_result.جریان.نوشتن("connect through the inbound")
    سرچاپ tunnel_result.وضعیت، tunnel_result.جریان.خواندن(100)
    tunnel_result.جریان.بستن()
    سرچاپ "without login:"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، listener.درگاه)، "http://127.0.0.1:" + origin_port + "/").وضعیت
    listener.توقف()

    hop := پراکسی اچ‌تی‌تی‌پی.رابط جدید(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، 3128))
    سرچاپ hop.نام()، hop.کارساز().متن()
    via := تونل.از طریق(تونل.مستقیم()، hop)
    سرچاپ via.نام()
پایان
