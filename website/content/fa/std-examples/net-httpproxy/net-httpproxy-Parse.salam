// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی رشته

تابع ریشه:
    درخواست := "GET http://example.com:8080/a/b?x=1 HTTP/1.1\r\nHost: example.com:8080\r\nProxy-Authorization: Basic dXNlcjpwYXNz\r\nConnection: keep-alive, X-Drop\r\nX-Drop: 1\r\n\r\n"
    سر := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست(درخواست)
    سرچاپ سر.معتبر، سر.روش، سر.هدف، سر.نسخه، سر.نام‌ها.طول()
    سرچاپ پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(سر، "HOST")، پراکسی اچ‌تی‌تی‌پی.سرآیند دارد(سر، "x-drop")، پراکسی اچ‌تی‌تی‌پی.تعداد سرآیند(سر، "host")
    سرچاپ پراکسی اچ‌تی‌تی‌پی.سرآیند توکن دارد(سر، "connection"، "KEEP-ALIVE")، پراکسی اچ‌تی‌تی‌پی.سرآیند توکن دارد(سر، "connection"، "close")
    سرچاپ سر.نام‌ها.بگیر(0)، سر.مقدارها.بگیر(0)

    هر متن در ["G@T / HTTP/1.1\r\n\r\n"، "GET /\r\n\r\n"، "GET / HTTP/1.1\r\nBroken header\r\n\r\n"، "GET / HTTP/1.1\r\nA: b\r\n c\r\n\r\n"]:
        بد := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست(متن)
        سرچاپ بد.معتبر، بد.خطا
    پایان
    سرچاپ پراکسی اچ‌تی‌تی‌پی.بیشترین اندازه سرآیند، پراکسی اچ‌تی‌تی‌پی.بیشترین تعداد سرآیند

    پاسخ := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند پاسخ("HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm=\"x\"\r\n\r\n")
    سرچاپ پاسخ.معتبر، پاسخ.وضعیت، پاسخ.دلیل، پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(پاسخ، "proxy-authenticate")

    هر یو در ["http://example.com"، "HTTP://Example.COM:81/p?q=1#frag"، "http://[::1]:8080/x"، "https://secure.example/a"، "ftp://example.com/"، "/relative"]:
        ایکس := پراکسی اچ‌تی‌تی‌پی.تجزیه نشانی وب(یو)
        اگر ایکس.معتبر:
            سرچاپ یو، "->"، ایکس.طرح، ایکس.میزبان، ایکس.درگاه، ایکس.مسیر
        وگرنه:
            سرچاپ یو، "-> invalid"
        پایان
    پایان
    هر موقت در ["example.com:443"، "example.com"، "[::1]:8443"، "::1"، "host:0"]:
        متغیر_hp := پراکسی اچ‌تی‌تی‌پی.جداسازی میزبان درگاه(موقت، 80)
        سرچاپ موقت، "->"، متغیر_hp.معتبر، متغیر_hp.میزبان، متغیر_hp.درگاه، متغیر_hp.درگاه دارد
    پایان

    سرصفحه := پراکسی اچ‌تی‌تی‌پی.سرآیند بیسیک("user"، "pass")
    سرچاپ سرصفحه
    ناپایا کاربر := ""
    ناپایا گذرواژه := ""
    سرچاپ پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک(سرصفحه، کاربر، گذرواژه)، کاربر، گذرواژه
    سرچاپ پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک("Bearer abc"، کاربر، گذرواژه)

    هر نام در ["Connection"، "Transfer-Encoding"، "Upgrade"، "Host"، "Content-Length"]:
        سرچاپ نام، پراکسی اچ‌تی‌تی‌پی.از نوع گام‌به‌گام(نام)
    پایان
    سرچاپ رشته.جایگزینی(پراکسی اچ‌تی‌تی‌پی.متن پاسخ(407، "Proxy-Authenticate: Basic realm=\"r\"\r\n"، ""، نادرست)، "\r\n"، "|")
    سرچاپ پراکسی اچ‌تی‌تی‌پی.دلیل وضعیت(403)، "|"، پراکسی اچ‌تی‌تی‌پی.دلیل وضعیت(502)، "|"، پراکسی اچ‌تی‌تی‌پی.دلیل وضعیت(999)
پایان
