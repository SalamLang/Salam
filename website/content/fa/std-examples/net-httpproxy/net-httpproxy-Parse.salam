// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی رشته

تابع ریشه:
    request := "GET http://example.com:8080/a/b?x=1 HTTP/1.1\r\nHost: example.com:8080\r\nProxy-Authorization: Basic dXNlcjpwYXNz\r\nConnection: keep-alive, X-Drop\r\nX-Drop: 1\r\n\r\n"
    head := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست(request)
    سرچاپ head.معتبر، head.روش، head.هدف، head.نسخه، head.نام‌ها.طول()
    سرچاپ پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(head، "HOST")، پراکسی اچ‌تی‌تی‌پی.سرآیند دارد(head، "x-drop")، پراکسی اچ‌تی‌تی‌پی.تعداد سرآیند(head، "host")
    سرچاپ پراکسی اچ‌تی‌تی‌پی.سرآیند توکن دارد(head، "connection"، "KEEP-ALIVE")، پراکسی اچ‌تی‌تی‌پی.سرآیند توکن دارد(head، "connection"، "close")
    سرچاپ head.نام‌ها.بگیر(0)، head.مقدارها.بگیر(0)

    هر text در ["G@T / HTTP/1.1\r\n\r\n"، "GET /\r\n\r\n"، "GET / HTTP/1.1\r\nBroken header\r\n\r\n"، "GET / HTTP/1.1\r\nA: b\r\n c\r\n\r\n"]:
        bad := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند درخواست(text)
        سرچاپ bad.معتبر، bad.خطا
    پایان
    سرچاپ پراکسی اچ‌تی‌تی‌پی.بیشترین اندازه سرآیند، پراکسی اچ‌تی‌تی‌پی.بیشترین تعداد سرآیند

    response := پراکسی اچ‌تی‌تی‌پی.تجزیه سرآیند پاسخ("HTTP/1.1 407 Proxy Authentication Required\r\nProxy-Authenticate: Basic realm=\"x\"\r\n\r\n")
    سرچاپ response.معتبر، response.وضعیت، response.دلیل، پراکسی اچ‌تی‌تی‌پی.گرفتن سرآیند(response، "proxy-authenticate")

    هر u در ["http://example.com"، "HTTP://Example.COM:81/p?q=1#frag"، "http://[::1]:8080/x"، "https://secure.example/a"، "ftp://example.com/"، "/relative"]:
        x := پراکسی اچ‌تی‌تی‌پی.تجزیه نشانی وب(u)
        اگر x.معتبر:
            سرچاپ u، "->"، x.طرح، x.میزبان، x.درگاه، x.مسیر
        وگرنه:
            سرچاپ u، "-> invalid"
        پایان
    پایان
    هر t در ["example.com:443"، "example.com"، "[::1]:8443"، "::1"، "host:0"]:
        hp := پراکسی اچ‌تی‌تی‌پی.جداسازی میزبان درگاه(t، 80)
        سرچاپ t، "->"، hp.معتبر، hp.میزبان، hp.درگاه، hp.درگاه دارد
    پایان

    header := پراکسی اچ‌تی‌تی‌پی.سرآیند بیسیک("user"، "pass")
    سرچاپ header
    ناپایا user := ""
    ناپایا password := ""
    سرچاپ پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک(header، user، password)، user، password
    سرچاپ پراکسی اچ‌تی‌تی‌پی.اعتبارنامه بیسیک("Bearer abc"، user، password)

    هر name در ["Connection"، "Transfer-Encoding"، "Upgrade"، "Host"، "Content-Length"]:
        سرچاپ name، پراکسی اچ‌تی‌تی‌پی.از نوع گام‌به‌گام(name)
    پایان
    سرچاپ رشته.جایگزینی(پراکسی اچ‌تی‌تی‌پی.متن پاسخ(407، "Proxy-Authenticate: Basic realm=\"r\"\r\n"، ""، نادرست)، "\r\n"، "|")
    سرچاپ پراکسی اچ‌تی‌تی‌پی.دلیل وضعیت(403)، "|"، پراکسی اچ‌تی‌تی‌پی.دلیل وضعیت(502)، "|"، پراکسی اچ‌تی‌تی‌پی.دلیل وضعیت(999)
پایان
