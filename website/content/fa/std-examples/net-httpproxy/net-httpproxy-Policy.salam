// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا origin_port := 0
ناپایا echo_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع origin():
    srv := تی سی پی.پیوند(0)
    origin_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        request := تی سی پی.خواندن(c، 4096)
        first := request.زیررشته(0، request.بیاب("\r\n"))
        body := "origin saw: " + first
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: " + body.طول() + "\r\nConnection: close\r\n\r\n" + body)
        تی سی پی.بستن(c)
    پایان
پایان

تابع echo():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 100))
        تی سی پی.بستن(c)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _a := نخ‌ساز(origin)
    _b := نخ‌ساز(echo)
    همگام سازی.انتظار(ready)
پایان

تابع ریشه:
    start_backends()
    url := "http://127.0.0.1:" + origin_port + "/"

    ناپایا acl := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    acl.اجازه = (method: رشته، _host: رشته، port: صحیح): برگشت method برابر "GET" و port نابرابر 25 پایان
    acl_server := پراکسی اچ‌تی‌تی‌پی.شروع(acl)
    acl_client := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، acl_server.درگاه)
    سرچاپ "GET:"، پراکسی اچ‌تی‌تی‌پی.دریافت(acl_client، url).وضعیت
    سرچاپ "POST:"، پراکسی اچ‌تی‌تی‌پی.ارسال(acl_client، url، "text/plain"، "x").وضعیت
    سرچاپ "port 25:"، پراکسی اچ‌تی‌تی‌پی.دریافت(acl_client، "http://127.0.0.1:25/").وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(acl_server)

    ناپایا no_connect := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    no_connect.اجازه کانکت = نادرست
    nc := پراکسی اچ‌تی‌تی‌پی.شروع(no_connect)
    سرچاپ "connect off:"، پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، nc.درگاه)، "127.0.0.1"، echo_port).وضعیت، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، nc.درگاه)، url).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(nc)

    ناپایا no_plain := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    no_plain.اجازه درخواست ساده = نادرست
    np := پراکسی اچ‌تی‌تی‌پی.شروع(no_plain)
    opened := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، np.درگاه)، "127.0.0.1"، echo_port)
    سرچاپ "plain off:"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، np.درگاه)، url).وضعیت، opened.وضعیت
    opened.جریان.بستن()
    پراکسی اچ‌تی‌تی‌پی.توقف(np)

    ناپایا routed := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.تعیین اتصال به مقصد(routed، (host: رشته، _port: صحیح): اگر host برابر "echo.internal": برگشت ساکس.اتصال مستقیم("127.0.0.1"، echo_port، 2000) پایان برگشت ساکس.خروجی { موفق = نادرست، کد = ساکس.پاسخ شبکه در دسترس نیست، خطا = "no route" } پایان)
    rs := پراکسی اچ‌تی‌تی‌پی.شروع(routed)
    named := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، rs.درگاه)، "echo.internal"، 1)
    named.جریان.نوشتن("by name")
    سرچاپ "routed:"، named.وضعیت، named.جریان.خواندن(100)
    سرچاپ "unknown:"، پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، rs.درگاه)، "other.internal"، 1).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(rs)

    ناپایا blocked := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.تعیین شماره‌گیر(blocked، تونل.مسدود())
    bs := پراکسی اچ‌تی‌تی‌پی.شروع(blocked)
    سرچاپ "block dialer:"، پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، bs.درگاه)، "127.0.0.1"، echo_port).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(bs)

    config := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    سرچاپ config.مهلت دست‌دهی میلی‌ثانیه، config.مهلت بی‌کاری میلی‌ثانیه، config.مهلت بی‌کاری رله، config.اجازه کانکت، config.اجازه درخواست ساده
پایان
