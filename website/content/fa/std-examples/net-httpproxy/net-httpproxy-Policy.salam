// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا درگاه_مبدأ := 0
ناپایا درگاه_پژواک := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع origin():
    کارساز := تی سی پی.پیوند(0)
    درگاه_مبدأ = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        درخواست := تی سی پی.خواندن(نویسه، 4096)
        نخست := درخواست.زیررشته(0، درخواست.بیاب("\r\n"))
        بدنه := "origin saw: " + نخست
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: " + بدنه.طول() + "\r\nConnection: close\r\n\r\n" + بدنه)
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع echo():
    کارساز := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        تی سی پی.نوشتن(نویسه، "echo:" + تی سی پی.خواندن(نویسه، 100))
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع start_backends():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(origin)
    متغیر__b := نخ‌ساز(echo)
    همگام سازی.انتظار(آماده)
پایان

تابع ریشه:
    start_backends()
    نشانی := "http://127.0.0.1:" + درگاه_مبدأ + "/"

    ناپایا متغیر_acl := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(متغیر_acl، درست)
    متغیر_acl.اجازه = (method: رشته، _host: رشته، port: صحیح): برگشت method برابر "GET" و port نابرابر 25 پایان
    متغیر_acl_server := پراکسی اچ‌تی‌تی‌پی.شروع(متغیر_acl)
    متغیر_acl_client := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، متغیر_acl_server.درگاه)
    سرچاپ "GET:"، پراکسی اچ‌تی‌تی‌پی.دریافت(متغیر_acl_client، نشانی).وضعیت
    سرچاپ "POST:"، پراکسی اچ‌تی‌تی‌پی.ارسال(متغیر_acl_client، نشانی، "text/plain"، "x").وضعیت
    سرچاپ "port 25:"، پراکسی اچ‌تی‌تی‌پی.دریافت(متغیر_acl_client، "http://127.0.0.1:25/").وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(متغیر_acl_server)

    ناپایا متغیر_no_connect := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(متغیر_no_connect، درست)
    متغیر_no_connect.اجازه کانکت = نادرست
    اتصال_نتس := پراکسی اچ‌تی‌تی‌پی.شروع(متغیر_no_connect)
    سرچاپ "connect off:"، پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، اتصال_نتس.درگاه)، "127.0.0.1"، درگاه_پژواک).وضعیت، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، اتصال_نتس.درگاه)، نشانی).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(اتصال_نتس)

    ناپایا متغیر_no_plain := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(متغیر_no_plain، درست)
    متغیر_no_plain.اجازه درخواست ساده = نادرست
    متغیر_np := پراکسی اچ‌تی‌تی‌پی.شروع(متغیر_no_plain)
    متغیر_opened := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، متغیر_np.درگاه)، "127.0.0.1"، درگاه_پژواک)
    سرچاپ "plain off:"، پراکسی اچ‌تی‌تی‌پی.دریافت(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، متغیر_np.درگاه)، نشانی).وضعیت، متغیر_opened.وضعیت
    متغیر_opened.جریان.بستن()
    پراکسی اچ‌تی‌تی‌پی.توقف(متغیر_np)

    ناپایا متغیر_routed := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(متغیر_routed، درست)
    پراکسی اچ‌تی‌تی‌پی.تعیین اتصال به مقصد(متغیر_routed، (host: رشته، _port: صحیح): اگر host برابر "echo.internal": برگشت ساکس.اتصال مستقیم("127.0.0.1"، درگاه_پژواک، 2000) پایان برگشت ساکس.خروجی { موفق = نادرست، کد = ساکس.کد شبکه در دسترس نیست، خطا = "no route" } پایان)
    متغیر_rs := پراکسی اچ‌تی‌تی‌پی.شروع(متغیر_routed)
    متغیر_named := پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، متغیر_rs.درگاه)، "echo.internal"، 1)
    متغیر_named.جریان.نوشتن("by name")
    سرچاپ "routed:"، متغیر_named.وضعیت، متغیر_named.جریان.خواندن(100)
    سرچاپ "unknown:"، پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، متغیر_rs.درگاه)، "other.internal"، 1).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(متغیر_rs)

    ناپایا متغیر_blocked := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(متغیر_blocked، درست)
    پراکسی اچ‌تی‌تی‌پی.تعیین شماره‌گیر(متغیر_blocked، تونل.مسدود())
    متغیر_bs := پراکسی اچ‌تی‌تی‌پی.شروع(متغیر_blocked)
    سرچاپ "block dialer:"، پراکسی اچ‌تی‌تی‌پی.اتصال(پراکسی اچ‌تی‌تی‌پی.کلاینت جدید("127.0.0.1"، متغیر_bs.درگاه)، "127.0.0.1"، درگاه_پژواک).وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(متغیر_bs)

    ناپایا پیکربندی := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(0)
    پراکسی اچ‌تی‌تی‌پی.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    سرچاپ پیکربندی.مهلت دست‌دهی میلی‌ثانیه، پیکربندی.مهلت بی‌کاری میلی‌ثانیه، پیکربندی.مهلت بی‌کاری رله، پیکربندی.اجازه کانکت، پیکربندی.اجازه درخواست ساده
پایان
