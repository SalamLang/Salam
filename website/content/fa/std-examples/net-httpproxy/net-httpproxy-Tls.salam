// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی

تابع ریشه:
    ناپایا config := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(8443)
    پراکسی اچ‌تی‌تی‌پی.افزودن کاربر(config، "alice"، "a long random password")
    اگر وارونه پراکسی اچ‌تی‌تی‌پی.تعیین تی ال اس(config، "proxy.crt"، "proxy.key"):
        سرچاپ "certificate or key could not be loaded"
        برگشت
    پایان
    سرچاپ config.استفاده از تی ال اس
    server := پراکسی اچ‌تی‌تی‌پی.شروع(config)
    سرچاپ "https proxy up:"، server.موفق

    ناپایا client := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("proxy.example.com"، 8443، "alice"، "a long random password")
    client.امن = درست
    client.نام سرور = "proxy.example.com"
    client.بدون اعتبارسنجی = نادرست
    tunnel := پراکسی اچ‌تی‌تی‌پی.اتصال(client، "example.com"، 443)
    سرچاپ tunnel.موفق، tunnel.وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(server)
پایان
