// زبان: فارسی
واردسازی شبکه.پراکسی اچ‌تی‌تی‌پی

تابع ریشه:
    ناپایا پیکربندی := پراکسی اچ‌تی‌تی‌پی.پیکربندی سرور جدید(8443)
    پراکسی اچ‌تی‌تی‌پی.افزودن کاربر(پیکربندی، "alice"، "a long random password")
    اگر وارونه پراکسی اچ‌تی‌تی‌پی.تعیین تی ال اس(پیکربندی، "proxy.crt"، "proxy.key"):
        سرچاپ "certificate or key could not be loaded"
        برگشت
    پایان
    سرچاپ پیکربندی.استفاده از تی ال اس
    کارساز := پراکسی اچ‌تی‌تی‌پی.شروع(پیکربندی)
    سرچاپ "https proxy up:"، کارساز.موفق

    ناپایا کارخواه := پراکسی اچ‌تی‌تی‌پی.کلاینت جدید با احراز هویت("proxy.example.com"، 8443، "alice"، "a long random password")
    کارخواه.امن = درست
    کارخواه.نام سرور = "proxy.example.com"
    کارخواه.بدون اعتبارسنجی = نادرست
    تونل := پراکسی اچ‌تی‌تی‌پی.اتصال(کارخواه، "example.com"، 443)
    سرچاپ تونل.موفق، تونل.وضعیت
    پراکسی اچ‌تی‌تی‌پی.توقف(کارساز)
پایان
