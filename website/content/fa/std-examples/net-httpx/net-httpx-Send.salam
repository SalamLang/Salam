واردسازی شبکه.اچ تی تی پی ساده
واردسازی شبکه.تی سی پی
واردسازی حافظه

ناپایا سرور := تی سی پی.سرور {}

روال پاسخ‌گو():
    تکرار ۲:
        ا := تی سی پی.پذیرش(سرور)
        _ := تی سی پی.خواندن(ا، ۴۰۹۶)
        تی سی پی.نوشتن اچ تی تی پی(ا، "200 OK"، "text/plain"، "سلام از سرور")
        تی سی پی.بستن(ا)
    پایان
پایان

روال ریشه:
    ن := اچ تی تی پی ساده.تجزیه نقطه پایانی("https://api.example.com:8443")
    سرچاپ ن.ok، ن.host، ن.port، ن.secure
    سرور = تی سی پی.پیوند(۰)
    ک := spawn(پاسخ‌گو)
    محلی := اچ تی تی پی ساده.تجزیه نقطه پایانی("http://127.0.0.1:" + تی سی پی.درگاه(سرور))
    سر := "GET / HTTP/1.1\r\nHost: 127.0.0.1\r\nConnection: close\r\n\r\n"
    پ := اچ تی تی پی ساده.ارسال متن(محلی، سر، "")
    سرچاپ پ.ok، پ.status، پ.body، "[" + پ.error + "]"
    سرچاپ اچ تی تی پی ساده.مقدار سرصفحه(پ.head، "content-type")
    ناپایا خ := اچ تی تی پی ساده.ارسال خام با مهلت(محلی، سر، پوچ، ۰، ۲۰۰۰)
    سرچاپ خ.ok، خ.status، خ.len، اچ تی تی پی ساده.متن پاسخ خام(خ)
    اچ تی تی پی ساده.آزادسازی پاسخ خام(خ)
    join(ک)
    تی سی پی.بستن سرور(سرور)
    سرچاپ اچ تی تی پی ساده.سقف پاسخ خام() > ۰
    اچ تی تی پی ساده.تنظیم سقف پاسخ خام(۱۰۲۴ * ۱۰۲۴)
    سرچاپ اچ تی تی پی ساده.سقف پاسخ خام()
    ناپایا طول := ۰
    ب := اچ تی تی پی ساده.رونوشت بیرونی("abc"، طول)
    سرچاپ طول
    حافظه.آزادسازی(ب)
    ب۲ := اچ تی تی پی ساده.ارسال(محلی، سر، پوچ، ۰)
    خ۲ := اچ تی تی پی ساده.ارسال خام(محلی، سر، پوچ، ۰)
    سرچاپ ب۲.ok، خ۲.ok
پایان
