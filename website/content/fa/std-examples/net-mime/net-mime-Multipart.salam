واردسازی شبکه.مایم
واردسازی فشرده سازی
واردسازی رشته

روال ریشه:
    ناپایا ن := مایم.نویسنده چندبخشی جدید()
    سرچاپ رشته.شروع با(مایم.سرآیند نوع محتوا(ن)، "multipart/form-data; boundary=")
    مایم.نوشتن فیلد(ن، "name"، "مریم")
    مایم.نوشتن پرونده متنی(ن، "note"، "note.txt"، "text/plain"، "سلام")
    داده := فشرده سازی.بافر از رشته("PNG")
    مایم.نوشتن پرونده(ن، "pic"، "a.png"، "image/png"، داده.data، داده.len)
    بدنه := مایم.بستن نویسنده(ن)
    سرچاپ ن.closed، بدنه.len > ۰
    بخش‌ها := مایم.تجزیه چندبخشی(بدنه.data، بدنه.len، ن.boundary)
    هر ب در بخش‌ها.items:
        سرچاپ ب.name، "[" + ب.filename + "]"، "[" + ب.content_type + "]"، فشرده سازی.بافر به رشته(ب.body)، ب.headers.items.طول()
    پایان
    سرچاپ بخش‌ها.items[۱].headers.items[۰].key
پایان
