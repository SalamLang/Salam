واردسازی شبکه.مایم
واردسازی فشرده سازی
واردسازی رشته

تابع ریشه:
    ناپایا ن := مایم.نویسنده چندبخشی جدید()
    سرچاپ رشته.شروع با(مایم.سرآیند نوع محتوا(ن)، "multipart/form-data; boundary=")
    مایم.نوشتن فیلد(ن، "name"، "مریم")
    مایم.نوشتن پرونده متنی(ن، "note"، "note.txt"، "text/plain"، "سلام")
    داده := فشرده سازی.بافر از رشته("PNG")
    مایم.نوشتن پرونده(ن، "pic"، "a.png"، "image/png"، داده.داده، داده.طول)
    بدنه := مایم.بستن نویسنده(ن)
    سرچاپ ن.بسته، بدنه.طول > ۰
    ناپایا بخش‌ها := مایم.تجزیه چندبخشی(بدنه.داده، بدنه.طول، ن.مرز)
    هر ب در بخش‌ها.اقلام:
        سرچاپ ب.نام، "[" + ب.نام پرونده + "]"، "[" + ب.نوع محتوا + "]"، فشرده سازی.بافر به رشته(ب.بدنه)، ب.سرآیندها.اقلام.طول()
    پایان
    سرچاپ بخش‌ها.اقلام[۱].سرآیندها.اقلام[۰].کلید
    سرچاپ مایم.اندیس بخش(بخش‌ها، "note")، مایم.اندیس بخش(بخش‌ها، "missing")
    سرچاپ مایم.مقدار بخش(بخش‌ها، "name")، "[" + مایم.مقدار بخش(بخش‌ها، "missing") + "]"
    مایم.آزادسازی چندبخشی(بخش‌ها)
پایان
