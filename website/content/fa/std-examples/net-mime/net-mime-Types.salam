واردسازی شبکه.مایم شبکه

روال ریشه:
    سرچاپ مایم شبکه.پسوند مایم("png")، مایم شبکه.پسوند مایم("json")، مایم شبکه.پسوند مایم(".png")
    سرچاپ مایم شبکه.رده مایم("/site/index.html")، مایم شبکه.رده مایم("style.css")
    سرچاپ مایم شبکه.متن وضعیت(۲۰۰)، مایم شبکه.متن وضعیت(۴۰۴)، مایم شبکه.متن وضعیت(۵۰۳)
    ن := مایم شبکه.تجزیه نوع محتوا("text/html; charset=UTF-8; q=0.9")
    سرچاپ ن.media_type، ن.params.items.طول()، مایم شبکه.دریافت پارامتر(ن، "charset")، ن.params.items[۱].key، ن.params.items[۱].value
