واردسازی شبکه.مایم

تابع ریشه:
    سرچاپ مایم.پسوند مایم("png")، مایم.پسوند مایم("json")، مایم.پسوند مایم(".png")
    سرچاپ مایم.رده مایم("/site/index.html")، مایم.رده مایم("style.css")
    سرچاپ مایم.متن وضعیت(۲۰۰)، مایم.متن وضعیت(۴۰۴)، مایم.متن وضعیت(۵۰۳)
    ن := مایم.تجزیه نوع محتوا("text/html; charset=UTF-8; q=0.9")
