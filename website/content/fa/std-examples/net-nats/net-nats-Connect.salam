// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا گزینه‌ها := نتس.گزینه های پیش‌فرض()
    گزینه‌ها.نام = "billing"
    گزینه‌ها.مهلت میلی‌ثانیه = 3000
    ناپایا اتصال_نتس := نتس.برقراری اتصال با گزینه("nats://127.0.0.1:4222"، گزینه‌ها)
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    سرچاپ "connected, largest payload"، نتس.بیشینه اندازه بار(اتصال_نتس)
    نتس.بستن(اتصال_نتس)
    سرچاپ نتس.بسته شده است(اتصال_نتس)
    برگشت 0
پایان
