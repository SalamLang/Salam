// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا opts := نتس.گزینه های پیش‌فرض()
    opts.نام = "billing"
    opts.مهلت میلی‌ثانیه = 3000
    ناپایا nc := نتس.برقراری اتصال با گزینه("nats://127.0.0.1:4222"، opts)
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    سرچاپ "connected, largest payload"، نتس.بیشینه اندازه بار(nc)
    نتس.بستن(nc)
    سرچاپ نتس.بسته شده است(nc)
    برگشت 0
پایان
