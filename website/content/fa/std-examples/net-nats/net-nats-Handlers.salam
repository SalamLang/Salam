// زبان: فارسی
واردسازی شبکه.نتس

ناپایا دیده := 0

تابع note(m: نتس.پیام):
    دیده++
    سرچاپ "event"، m.موضوع، m.داده
پایان

تابع shout(m: نتس.پیام): رشته:
    برگشت "HELLO " + m.داده
پایان

تابع ریشه(): صحیح:
    ناپایا اتصال_نتس := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    نتس.اشتراک با دستگیره(اتصال_نتس، "events.>"، ""، (m: نتس.پیام): note(m) پایان)
    نتس.اشتراک پاسخگو(اتصال_نتس، "greet"، ""، (m: نتس.پیام): برگشت shout(m) پایان)
    نتس.انتشار(اتصال_نتس، "events.a.b"، "started")

    ناپایا متغیر_fwd := نتس.پیام {}
    متغیر_fwd.موضوع = "events.copy"
    متغیر_fwd.داده = "forwarded"
    نتس.انتشار پیام(اتصال_نتس، متغیر_fwd)

    تکرار 20:
        نتس.پردازش(اتصال_نتس، 100)
    پایان
    سرچاپ "handled"، دیده
    نتس.بستن(اتصال_نتس)
    برگشت 0
پایان
