// زبان: فارسی
واردسازی شبکه.نتس

ناپایا seen := 0

تابع note(m: نتس.پیام):
    seen += 1
    سرچاپ "event"، m.موضوع، m.داده
پایان

تابع shout(m: نتس.پیام): رشته:
    برگشت "HELLO " + m.داده
پایان

تابع ریشه(): صحیح:
    ناپایا nc := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    نتس.اشتراک با دستگیره(nc، "events.>"، ""، (m: نتس.پیام): note(m) پایان)
    نتس.اشتراک پاسخگو(nc، "greet"، ""، (m: نتس.پیام): برگشت shout(m) پایان)
    نتس.انتشار(nc، "events.a.b"، "started")

    ناپایا fwd := نتس.پیام {}
    fwd.موضوع = "events.copy"
    fwd.داده = "forwarded"
    نتس.انتشار پیام(nc، fwd)

    تکرار 20:
        نتس.پردازش(nc، 100)
    پایان
    سرچاپ "handled"، seen
    نتس.بستن(nc)
    برگشت 0
پایان
