// زبان: فارسی
واردسازی شبکه.نتس
واردسازی رشته

تابع ریشه:
    ناپایا h := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(h، "Trace-Id"، "abc")
    نتس.افزودن سرآیند(h، "Tag"، "one")
    نتس.افزودن سرآیند(h، "Tag"، "two")
    سرچاپ نتس.گرفتن سرآیند(h، "trace-id")، نتس.مقدارهای سرآیند(h، "TAG").طول()، نتس.سرآیند دارد(h، "nope")
    نتس.تنظیم سرآیند(h، "Tag"، "only")
    نتس.حذف سرآیند(h، "Trace-Id")
    سرچاپ نتس.شمار سرآیند(h)
    سرچاپ رشته.جایگزینی(نتس.رمزگذاری سرآیند(h)، "\r\n"، "|")

    ناپایا code := 0
    ناپایا text := ""
    back := نتس.تجزیه سرآیند("NATS/1.0 503 No Responders\r\nA: 1\r\n\r\n"، code، text)
    سرچاپ code، text، نتس.گرفتن سرآیند(back، "a")
پایان
