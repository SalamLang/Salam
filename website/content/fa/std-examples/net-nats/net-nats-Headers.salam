// زبان: فارسی
واردسازی شبکه.نتس
واردسازی رشته

تابع ریشه:
    ناپایا اچ := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(اچ، "Trace-Id"، "abc")
    نتس.افزودن سرآیند(اچ، "Tag"، "one")
    نتس.افزودن سرآیند(اچ، "Tag"، "two")
    سرچاپ نتس.گرفتن سرآیند(اچ، "trace-id")، نتس.مقدارهای سرآیند(اچ، "TAG").طول()، نتس.سرآیند دارد(اچ، "nope")
    نتس.تنظیم سرآیند(اچ، "Tag"، "only")
    نتس.حذف سرآیند(اچ، "Trace-Id")
    سرچاپ نتس.شمار سرآیند(اچ)
    سرچاپ رشته.جایگزینی(نتس.رمزگذاری سرآیند(اچ)، "\r\n"، "|")

    ناپایا کد := 0
    ناپایا متن := ""
    بازگشت := نتس.تجزیه سرآیند("NATS/1.0 503 No Responders\r\nA: 1\r\n\r\n"، کد، متن)
    سرچاپ کد، متن، نتس.گرفتن سرآیند(بازگشت، "a")
پایان
