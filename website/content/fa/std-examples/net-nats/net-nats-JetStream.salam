// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا nc := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    ناپایا subjects := وکتور {} برگردان وکتور<رشته>
    دیرکن subjects.آزادکن()
    subjects.بیفزا("orders.*")
    made := نتس.افزودن جریان(nc، "ORDERS"، subjects، 2000)
    سرچاپ "stream:"، made.سالم، made.خطا
    ack := نتس.انتشار جت‌استریم(nc، "orders.new"، "order 1"، 2000)
    سرچاپ "stored at"، ack.جریان، ack.شماره

    ناپایا h := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(h، "Nats-Msg-Id"، "order-2")
    again := نتس.انتشار جت‌استریم با سرآیند(nc، "orders.new"، h، "order 2"، 2000)
    سرچاپ again.سالم، again.تکراری

    info := نتس.اطلاعات جریان(nc، "ORDERS"، 2000)
    سرچاپ info.پیام ها، info.نخستین شماره، info.واپسین شماره، info.مصرف‌کننده ها
    raw := نتس.درخواست جت‌استریم(nc، "STREAM.NAMES"، ""، 2000)
    سرچاپ raw.سالم

    نتس.افزودن مصرف‌کننده(nc، "ORDERS"، "worker"، "orders.*"، 2000)
    batch := نتس.واکشی(nc، "ORDERS"، "worker"، 10، 1000)
    هر m در batch.پیام ها:
        سرچاپ m.داده، "number"، نتس.شماره پیام جریان(m)
        اگر m.داده برابر "order 1":
            نتس.تایید(nc، m)
        وگرنه m.داده برابر "order 2":
            نتس.رد(nc، m)
        وگرنه:
            نتس.خاتمه(nc، m)
        پایان
    پایان
    اگر batch.پیام ها.طول() بزرگتر 0:
        نتس.ادامه کار(nc، batch.پیام ها.بگیر(0))
    پایان

    نتس.حذف مصرف‌کننده(nc، "ORDERS"، "worker"، 2000)
    نتس.پاکسازی جریان(nc، "ORDERS"، 2000)
    نتس.حذف جریان(nc، "ORDERS"، 2000)
    نتس.بستن(nc)
    برگشت 0
پایان
