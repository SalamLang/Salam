// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا اتصال_نتس := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    ناپایا متغیر_subjects := وکتور {} برگردان وکتور<رشته>
    دیرکن متغیر_subjects.آزادکن()
    متغیر_subjects.بیفزا("orders.*")
    ساخته := نتس.افزودن جریان(اتصال_نتس، "ORDERS"، متغیر_subjects، 2000)
    سرچاپ "stream:"، ساخته.سالم، ساخته.خطا
    متغیر_ack := نتس.انتشار جت‌استریم(اتصال_نتس، "orders.new"، "order 1"، 2000)
    سرچاپ "stored at"، متغیر_ack.جریان، متغیر_ack.شماره

    ناپایا اچ := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(اچ، "Nats-Msg-Id"، "order-2")
    دوباره := نتس.انتشار جت‌استریم با سرآیند(اتصال_نتس، "orders.new"، اچ، "order 2"، 2000)
    سرچاپ دوباره.سالم، دوباره.تکراری

    اطلاعات := نتس.اطلاعات جریان(اتصال_نتس، "ORDERS"، 2000)
    سرچاپ اطلاعات.پیام ها، اطلاعات.نخستین شماره، اطلاعات.واپسین شماره، اطلاعات.مصرف‌کننده ها
    خام := نتس.درخواست جت‌استریم(اتصال_نتس، "STREAM.NAMES"، ""، 2000)
    سرچاپ خام.سالم

    نتس.افزودن مصرف‌کننده(اتصال_نتس، "ORDERS"، "worker"، "orders.*"، 2000)
    متغیر_batch := نتس.واکشی(اتصال_نتس، "ORDERS"، "worker"، 10، 1000)
    هر تعداد۲ در متغیر_batch.پیام ها:
        سرچاپ تعداد۲.داده، "number"، نتس.شماره پیام جریان(تعداد۲)
        اگر تعداد۲.داده برابر "order 1":
            نتس.تایید(اتصال_نتس، تعداد۲)
        وگرنه تعداد۲.داده برابر "order 2":
            نتس.رد(اتصال_نتس، تعداد۲)
        وگرنه:
            نتس.خاتمه(اتصال_نتس، تعداد۲)
        پایان
    پایان
    اگر متغیر_batch.پیام ها.طول() بزرگتر 0:
        نتس.ادامه کار(اتصال_نتس، متغیر_batch.پیام ها.بگیر(0))
    پایان

    نتس.حذف مصرف‌کننده(اتصال_نتس، "ORDERS"، "worker"، 2000)
    نتس.پاکسازی جریان(اتصال_نتس، "ORDERS"، 2000)
    نتس.حذف جریان(اتصال_نتس، "ORDERS"، 2000)
    نتس.بستن(اتصال_نتس)
    برگشت 0
پایان
