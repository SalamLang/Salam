// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا nc := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    made := نتس.ساخت سطل کی‌وی(nc، "config"، 5، 2000)
    سرچاپ "bucket:"، made.سالم
    put := نتس.نوشتن کی‌وی(nc، "config"، "theme"، "dark"، 2000)
    سرچاپ "revision"، put.شماره
    got := نتس.خواندن کی‌وی(nc، "config"، "theme"، 2000)
    اگر got.یافت شد:
        سرچاپ got.کلید، got.مقدار، got.ویرایش
    پایان
    نتس.حذف کی‌وی(nc، "config"، "theme"، 2000)
    gone := نتس.خواندن کی‌وی(nc، "config"، "theme"، 2000)
    سرچاپ gone.یافت شد، gone.حذف شده
    نتس.حذف سطل کی‌وی(nc، "config"، 2000)
    نتس.بستن(nc)
    برگشت 0
پایان
