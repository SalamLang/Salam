// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا اتصال_نتس := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    ساخته := نتس.ساخت سطل کی‌وی(اتصال_نتس، "config"، 5، 2000)
    سرچاپ "bucket:"، ساخته.سالم
    متغیر_put := نتس.نوشتن کی‌وی(اتصال_نتس، "config"، "theme"، "dark"، 2000)
    سرچاپ "revision"، متغیر_put.شماره
    گرفته := نتس.خواندن کی‌وی(اتصال_نتس، "config"، "theme"، 2000)
    اگر گرفته.یافت شد:
        سرچاپ گرفته.کلید، گرفته.مقدار، گرفته.ویرایش
    پایان
    نتس.حذف کی‌وی(اتصال_نتس، "config"، "theme"، 2000)
    رفته := نتس.خواندن کی‌وی(اتصال_نتس، "config"، "theme"، 2000)
    سرچاپ رفته.یافت شد، رفته.حذف شده
    نتس.حذف سطل کی‌وی(اتصال_نتس، "config"، 2000)
    نتس.بستن(اتصال_نتس)
    برگشت 0
پایان
