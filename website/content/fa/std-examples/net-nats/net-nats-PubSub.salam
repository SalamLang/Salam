// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا nc := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    all := نتس.اشتراک(nc، "orders.*")
    first := نتس.اشتراک صف(nc، "jobs"، "workers")
    once := نتس.اشتراک(nc، "ping")
    نتس.لغو خودکار اشتراک(nc، once، 1)
    سرچاپ "subscriptions:"، نتس.شمار اشتراک(nc)

    نتس.انتشار(nc، "orders.new"، "order 1")
    نتس.انتشار(nc، "jobs"، "job 1")
    نتس.انتشار(nc، "ping"، "hello")
    نتس.تخلیه(nc، 1000)
    سرچاپ "waiting:"، نتس.صف مانده(nc، all)، نتس.صف مانده(nc، first)

    m := نتس.پیام بعدی(nc، all، 1000)
    اگر m.سالم:
        سرچاپ m.موضوع، m.داده
    پایان
    p := نتس.پیام بعدی(nc، once، 1000)
    سرچاپ p.داده، نتس.تحویل شده(nc، once)، نتس.اشتراک فعال است(nc، once)

    نتس.لغو اشتراک(nc، all)
    نتس.بستن(nc)
    برگشت 0
پایان
