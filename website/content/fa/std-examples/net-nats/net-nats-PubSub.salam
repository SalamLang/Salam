// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا اتصال_نتس := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    متغیر_all := نتس.اشتراک(اتصال_نتس، "orders.*")
    نخست := نتس.اشتراک صف(اتصال_نتس، "jobs"، "workers")
    متغیر_once := نتس.اشتراک(اتصال_نتس، "ping")
    نتس.لغو خودکار اشتراک(اتصال_نتس، متغیر_once، 1)
    سرچاپ "subscriptions:"، نتس.شمار اشتراک(اتصال_نتس)

    نتس.انتشار(اتصال_نتس، "orders.new"، "order 1")
    نتس.انتشار(اتصال_نتس، "jobs"، "job 1")
    نتس.انتشار(اتصال_نتس، "ping"، "hello")
    نتس.تخلیه(اتصال_نتس، 1000)
    سرچاپ "waiting:"، نتس.صف مانده(اتصال_نتس، متغیر_all)، نتس.صف مانده(اتصال_نتس، نخست)

    تعداد۲ := نتس.پیام بعدی(اتصال_نتس، متغیر_all، 1000)
    اگر تعداد۲.سالم:
        سرچاپ تعداد۲.موضوع، تعداد۲.داده
    پایان
    ویژگی_محلی := نتس.پیام بعدی(اتصال_نتس، متغیر_once، 1000)
    سرچاپ ویژگی_محلی.داده، نتس.تحویل شده(اتصال_نتس، متغیر_once)، نتس.اشتراک فعال است(اتصال_نتس، متغیر_once)

    نتس.لغو اشتراک(اتصال_نتس، متغیر_all)
    نتس.بستن(اتصال_نتس)
    برگشت 0
پایان
