// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا اتصال_نتس := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    اشتراک := نتس.اشتراک(اتصال_نتس، "deliver.orders")
    ساخته := نتس.افزودن مصرف‌کننده فشاری(اتصال_نتس، "ORDERS"، "pusher"، "orders.*"، "deliver.orders"، ""، 2000)
    اگر وارونه ساخته.سالم:
        سرچاپ "consumer:"، ساخته.خطا
        برگشت 1
    پایان
    تا درست:
        تعداد۲ := نتس.پیام فشاری بعدی(اتصال_نتس، اشتراک، 2000)
        اگر وارونه تعداد۲.سالم:
            بشکن
        پایان
        سرچاپ تعداد۲.داده، نتس.شماره پیام جریان(تعداد۲)
        نتس.تایید(اتصال_نتس، تعداد۲)
    پایان
    نتس.بستن(اتصال_نتس)
    برگشت 0
پایان
