// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا nc := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    sub := نتس.اشتراک(nc، "deliver.orders")
    made := نتس.افزودن مصرف‌کننده فشاری(nc، "ORDERS"، "pusher"، "orders.*"، "deliver.orders"، ""، 2000)
    اگر وارونه made.سالم:
        سرچاپ "consumer:"، made.خطا
        برگشت 1
    پایان
    تا درست:
        m := نتس.پیام فشاری بعدی(nc، sub، 2000)
        اگر وارونه m.سالم:
            بشکن
        پایان
        سرچاپ m.داده، نتس.شماره پیام جریان(m)
        نتس.تایید(nc، m)
    پایان
    نتس.بستن(nc)
    برگشت 0
پایان
