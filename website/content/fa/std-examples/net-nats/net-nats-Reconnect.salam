// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا گزینه‌ها := نتس.گزینه های پیش‌فرض()
    گزینه‌ها.کارگزارها.بیفزا("nats://10.0.0.2:4222")
    گزینه‌ها.کارگزارها.بیفزا("nats://10.0.0.3:4222")
    گزینه‌ها.بیشینه اتصال دوباره = 20
    گزینه‌ها.انتظار اتصال دوباره میلی‌ثانیه = 500
    گزینه‌ها.بافر اتصال دوباره = 1048576
    ناپایا اتصال_نتس := نتس.برقراری اتصال با گزینه("nats://10.0.0.1:4222"، گزینه‌ها)
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    اشتراک := نتس.اشتراک(اتصال_نتس، "metrics.>")
    تا وارونه نتس.بسته شده است(اتصال_نتس):
        تعداد۲ := نتس.پیام بعدی(اتصال_نتس، اشتراک، 1000)
        اگر تعداد۲.سالم:
            سرچاپ تعداد۲.موضوع، تعداد۲.داده
        پایان
        اگر نتس.در حال اتصال دوباره(اتصال_نتس):
            سرچاپ "link is down, buffered"، نتس.بایت‌های بافر شده(اتصال_نتس)، "bytes"
            نتس.انتشار(اتصال_نتس، "audit"، "waiting for the server")
        پایان
        اگر نتس.بسته شده است(اتصال_نتس):
            بشکن
        پایان
    پایان
    سرچاپ "reconnected"، نتس.شمار اتصال دوباره(اتصال_نتس)، "times"
    نتس.بستن(اتصال_نتس)
    برگشت 0
پایان
