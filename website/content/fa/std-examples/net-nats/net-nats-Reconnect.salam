// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا opts := نتس.گزینه های پیش‌فرض()
    opts.کارگزارها.بیفزا("nats://10.0.0.2:4222")
    opts.کارگزارها.بیفزا("nats://10.0.0.3:4222")
    opts.بیشینه اتصال دوباره = 20
    opts.انتظار اتصال دوباره میلی‌ثانیه = 500
    opts.بافر اتصال دوباره = 1048576
    ناپایا nc := نتس.برقراری اتصال با گزینه("nats://10.0.0.1:4222"، opts)
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    sub := نتس.اشتراک(nc، "metrics.>")
    تا وارونه نتس.بسته شده است(nc):
        m := نتس.پیام بعدی(nc، sub، 1000)
        اگر m.سالم:
            سرچاپ m.موضوع، m.داده
        پایان
        اگر نتس.در حال اتصال دوباره(nc):
            سرچاپ "link is down, buffered"، نتس.بایت‌های بافر شده(nc)، "bytes"
            نتس.انتشار(nc، "audit"، "waiting for the server")
        پایان
        اگر نتس.بسته شده است(nc):
            بشکن
        پایان
    پایان
    سرچاپ "reconnected"، نتس.شمار اتصال دوباره(nc)، "times"
    نتس.بستن(nc)
    برگشت 0
پایان
