// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا nc := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(nc):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(nc)
        برگشت 1
    پایان
    r := نتس.درخواست(nc، "time.now"، ""، 1000)
    اگر r.سالم:
        سرچاپ "answer:"، r.داده
    وگرنه:
        سرچاپ "no answer:"، r.خطا
    پایان

    ناپایا h := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(h، "Trace-Id"، "abc-123")
    r2 := نتس.درخواست با سرآیند(nc، "svc.echo"، h، "ping"، 1000)
    سرچاپ r2.سالم، r2.داده

    inbox := نتس.صندوق تازه(nc)
    نتس.انتشار درخواست(nc، "svc.echo"، inbox، "fire")
    reply := نتس.اشتراک(nc، inbox)
    سرچاپ نتس.پیام بعدی(nc، reply، 500).سالم

    سرچاپ "drained:"، نتس.تخلیه کامل(nc، 1000)
    برگشت 0
پایان
