// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه(): صحیح:
    ناپایا اتصال_نتس := نتس.برقراری اتصال("nats://127.0.0.1:4222")
    اگر وارونه نتس.وصل است(اتصال_نتس):
        سرچاپ "cannot connect:"، نتس.آخرین خطا(اتصال_نتس)
        برگشت 1
    پایان
    خوانده := نتس.درخواست(اتصال_نتس، "time.now"، ""، 1000)
    اگر خوانده.سالم:
        سرچاپ "answer:"، خوانده.داده
    وگرنه:
        سرچاپ "no answer:"، خوانده.خطا
    پایان

    ناپایا اچ := نتس.سرآیند تازه()
    نتس.افزودن سرآیند(اچ، "Trace-Id"، "abc-123")
    متغیر_r2 := نتس.درخواست با سرآیند(اتصال_نتس، "svc.echo"، اچ، "ping"، 1000)
    سرچاپ متغیر_r2.سالم، متغیر_r2.داده

    متغیر_inbox := نتس.صندوق تازه(اتصال_نتس)
    نتس.انتشار درخواست(اتصال_نتس، "svc.echo"، متغیر_inbox، "fire")
    پاسخ_فرآیند := نتس.اشتراک(اتصال_نتس، متغیر_inbox)
    سرچاپ نتس.پیام بعدی(اتصال_نتس، پاسخ_فرآیند، 500).سالم

    سرچاپ "drained:"، نتس.تخلیه کامل(اتصال_نتس، 1000)
    برگشت 0
پایان
