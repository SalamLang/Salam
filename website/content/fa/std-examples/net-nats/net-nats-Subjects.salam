// زبان: فارسی
واردسازی شبکه.نتس

تابع ریشه:
    سرچاپ نتس.موضوع معتبر("orders.eu.new")، نتس.موضوع معتبر("orders..new")، نتس.موضوع معتبر("a b")
    سرچاپ نتس.تطبیق موضوع("orders.*"، "orders.new")، نتس.تطبیق موضوع("orders.*"، "orders.eu.new")
    سرچاپ نتس.تطبیق موضوع("orders.>"، "orders.eu.new")، نتس.تطبیق موضوع("orders.>"، "orders")
پایان
