واردسازی شبکه.پراکسی شبکه

روال ریشه:
    الف := پراکسی شبکه.پراکسی اچ‌تی‌تی‌پی جدید("10.0.0.1:3128")
    سرچاپ الف.kind == پراکسی شبکه.نوع اچ‌تی‌تی‌پی، الف.host، الف.port
    ب := پراکسی شبکه.پراکسی اچ‌تی‌تی‌پی با احراز هویت("proxy.local:8080"، "ali"، "رمز")
    سرچاپ ب.username، ب.password
    ج := پراکسی شبکه.پراکسی ساکس۵ جدید("127.0.0.1:1080")
    د := پراکسی شبکه.پراکسی ساکس۵ با احراز هویت("socks.local:1080"، "u"، "p")
    سرچاپ ج.kind == پراکسی شبکه.نوع ساکس۵، د.port
    ناپایا ز := پراکسی شبکه.زنجیره جدید()
    پراکسی شبکه.افزودن(ز، ج)
    پراکسی شبکه.افزودن(ز، الف)
    سرچاپ ز.items.طول()
