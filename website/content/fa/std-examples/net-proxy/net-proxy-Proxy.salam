واردسازی شبکه.پراکسی

روال ریشه:
    الف := پراکسی.پراکسی اچ‌تی‌تی‌پی جدید("10.0.0.1:3128")
    سرچاپ الف.kind == پراکسی.نوع اچ‌تی‌تی‌پی، الف.host، الف.port
    ب := پراکسی.پراکسی اچ‌تی‌تی‌پی با احراز هویت("proxy.local:8080"، "ali"، "رمز")
    سرچاپ ب.username، ب.password
    ج := پراکسی.پراکسی ساکس۵ جدید("127.0.0.1:1080")
    د := پراکسی.پراکسی ساکس۵ با احراز هویت("socks.local:1080"، "u"، "p")
    سرچاپ ج.kind == پراکسی.نوع ساکس۵، د.port
    ناپایا ز := پراکسی.زنجیره جدید()
    پراکسی.افزودن(ز، ج)
    پراکسی.افزودن(ز، الف)
    سرچاپ ز.items.طول()
