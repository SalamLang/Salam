واردسازی شبکه.مسیریاب شبکه

ناپایا شمار := ۰

روال فهرست(_زمینه: صحیح۶۴):
    شمار += ۱
پایان

روال نمایش(_زمینه: صحیح۶۴):
    شمار += ۱
پایان

روال ساختن(_زمینه: صحیح۶۴):
    شمار += ۱
پایان

روال ریشه:
    ناپایا م := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.دریافت(م، "/books"، فهرست)
    مسیریاب شبکه.دریافت(م، "/books/:id"، نمایش)
    مسیریاب شبکه.ارسال(م، "/books"، ساختن)
    مسیریاب شبکه.قراردادن(م، "/books/:id"، ساختن)
    مسیریاب شبکه.حذف(م، "/books/:id"، ساختن)
    مسیریاب شبکه.وصله(م، "/books/:id"، ساختن)
    مسیریاب شبکه.سر(م، "/books"، فهرست)
    مسیریاب شبکه.گزینه ها(م، "/books"، فهرست)
    مسیریاب شبکه.روش(م، "PURGE"، "/cache"، ساختن)
    مسیریاب شبکه.روش(م، "GET"، "/files/*"، نمایش)
    مسیریاب شبکه.گروه(م، "/api/v1"، "GET"، "/users/:uid/books/:id"، نمایش)
    مسیریاب شبکه.ایستا(م، "/static"، "public")
    مسیریاب شبکه.فعال سازی فهرست پوشه(م)
    سرچاپ م.routes.طول()، م.has_static، م.static_prefix، م.static_listing
    ناپایا ت := مسیریاب شبکه.اعزام(م، "GET"، "/books/42")
    سرچاپ ت.matched، ت.fn == نمایش، مسیریاب شبکه.دریافت پارامتر(ت، "id")
    مسیریاب شبکه.آزادسازی تطابق(ت)
    ناپایا ت۲ := مسیریاب شبکه.اعزام(م، "GET"، "/api/v1/users/7/books/3")
    سرچاپ ت۲.matched، ت۲.params.items.طول()، ت۲.params.items[۰].key، ت۲.params.items[۰].value
    مسیریاب شبکه.آزادسازی تطابق(ت۲)
    ناپایا ت۳ := مسیریاب شبکه.اعزام(م، "GET"، "/files/a/b.txt")
    سرچاپ ت۳.matched، ت۳.params.items.طول()
    مسیریاب شبکه.آزادسازی تطابق(ت۳)
    ناپایا ت۴ := مسیریاب شبکه.اعزام(م، "DELETE"، "/books")
    سرچاپ ت۴.matched، م.routes[۰].method، م.routes[۰].pattern
    مسیریاب شبکه.آزادسازی تطابق(ت۴)
پایان
