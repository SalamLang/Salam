واردسازی شبکه.مسیریاب

ناپایا شمار := ۰

تابع فهرست(_زمینه: صحیح۶۴):
    شمار += ۱
پایان

تابع نمایش(_زمینه: صحیح۶۴):
    شمار += ۱
پایان

تابع ساختن(_زمینه: صحیح۶۴):
    شمار += ۱
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.دریافت(م، "/books"، فهرست)
    مسیریاب.دریافت(م، "/books/:id"، نمایش)
    مسیریاب.ارسال(م، "/books"، ساختن)
    مسیریاب.قراردادن(م، "/books/:id"، ساختن)
    مسیریاب.حذف(م، "/books/:id"، ساختن)
    مسیریاب.وصله(م، "/books/:id"، ساختن)
    مسیریاب.سر(م، "/books"، فهرست)
    مسیریاب.گزینه ها(م، "/books"، فهرست)
    مسیریاب.روش(م، "PURGE"، "/cache"، ساختن)
    مسیریاب.روش(م، "GET"، "/files/*"، نمایش)
    مسیریاب.گروه(م، "/api/v1"، "GET"، "/users/:uid/books/:id"، نمایش)
    مسیریاب.ایستا(م، "/static"، "public")
    مسیریاب.فعال سازی فهرست پوشه(م)
    سرچاپ م.مسیرها.طول()، م.ایستا فعال، م.پیشوند ایستا، م.فهرست ایستا
    ناپایا ت := مسیریاب.اعزام(م، "GET"، "/books/42")
    سرچاپ ت.پیدا شد، ت.گرداننده == نمایش، مسیریاب.دریافت پارامتر(ت، "id")
    مسیریاب.آزادسازی تطابق(ت)
    ناپایا ت۲ := مسیریاب.اعزام(م، "GET"، "/api/v1/users/7/books/3")
    سرچاپ ت۲.پیدا شد، ت۲.پارامترها.اقلام.طول()، ت۲.پارامترها.اقلام[۰].کلید، ت۲.پارامترها.اقلام[۰].مقدار
    مسیریاب.آزادسازی تطابق(ت۲)
    ناپایا ت۳ := مسیریاب.اعزام(م، "GET"، "/files/a/b.txt")
    سرچاپ ت۳.پیدا شد، ت۳.پارامترها.اقلام.طول()
    مسیریاب.آزادسازی تطابق(ت۳)
    ناپایا ت۴ := مسیریاب.اعزام(م، "DELETE"، "/books")
    سرچاپ ت۴.پیدا شد، م.مسیرها[۰].روش، م.مسیرها[۰].الگو
    مسیریاب.آزادسازی تطابق(ت۴)
پایان
