واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع خانه(ز: صحیح۶۴):
    اچ تی تی پی.متن(ز، "خانه")
پایان

تابع بقیه(ز: صحیح۶۴):
    اچ تی تی پی.تنظیم وضعیت(ز، ۲۰۲)
    اچ تی تی پی.متن(ز، "رسید " + اچ تی تی پی.روش(ز) + " " + اچ تی تی پی.مسیر(ز))
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    سرچاپ م.مدیر پیش‌فرض
    مسیریاب.دریافت(م، "/"، خانه)
    مسیریاب.تنظیم مدیر پیش‌فرض(م، بقیه)
    سرچاپ م.مدیر پیش‌فرض == بقیه
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۶۲۵)
    اچ تی تی پی.استفاده(س، م)
    سرچاپ اچ تی تی پی.اجرا در پس زمینه(س)
    الف := اچ تی تی پی.دریافت("http://127.0.0.1:19625/")
    سرچاپ اچ تی تی پی.وضعیت(الف)، اچ تی تی پی.بدنه(الف)
    ب := اچ تی تی پی.دریافت("http://127.0.0.1:19625/unknown/page")
    سرچاپ اچ تی تی پی.وضعیت(ب)، اچ تی تی پی.بدنه(ب)
پایان
