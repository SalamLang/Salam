واردسازی شبکه.شدوساکس

تابع ریشه:
    تعداد۲ := شدوساکس.یافتن روش("chacha20-ietf-poly1305")
    ناپایا کلید := شدوساکس.ساخت کلید(تعداد۲، "codec password")

    ناپایا متغیر_enc := شدوساکس.رمزگذار جدید تصادفی(تعداد۲، کلید.اشاره گر)
    ناپایا سیم := شدوساکس.بافر جدید(256)
    شدوساکس.ارسال نمک(متغیر_enc، سیم)
    شدوساکس.رمزگذاری جریان(متغیر_enc، "hello codec" برگردان تهی*، 11، سیم)
    سرچاپ "wire bytes"، سیم.طول، "salt"، تعداد۲.طول نمک، "overhead"، سیم.طول - 11 - تعداد۲.طول نمک

    ناپایا متغیر_dec := شدوساکس.رمزگشا جدید(تعداد۲، کلید.اشاره گر)
    ناپایا ساده := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.رمزگشایی همه(متغیر_dec، سیم.اشاره گر، سیم.طول، ساده)، شدوساکس.بافر به رشته(ساده)

    ناپایا سر := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.رمزگذاری مقصد("example.com"، 8443، سر)، سر.طول، شدوساکس.بافر به هگز(سر)
    ناپایا موقت := شدوساکس.مقصد {}
    استفاده_شده := شدوساکس.تجزیه مقصد(سر.اشاره گر، سر.طول، موقت)
    سرچاپ استفاده_شده، موقت.میزبان، موقت.درگاه

    ناپایا متغیر_packet := شدوساکس.بافر جدید(128)
    سرچاپ شدوساکس.بسته بندی یو دی پی(تعداد۲، کلید.اشاره گر، "10.0.0.7"، 53، "query" برگردان تهی*، 5، متغیر_packet)، متغیر_packet.طول
    ناپایا گرفته := شدوساکس.مقصد {}
    ناپایا بدنه := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.بازکردن یو دی پی(تعداد۲، کلید.اشاره گر، متغیر_packet.اشاره گر، متغیر_packet.طول، گرفته، بدنه)، گرفته.میزبان، گرفته.درگاه، شدوساکس.بافر به رشته(بدنه)

    شدوساکس.آزادسازی رمزگذار(متغیر_enc)
    شدوساکس.آزادسازی رمزگشا(متغیر_dec)
    شدوساکس.آزادسازی بافر(سیم)
    شدوساکس.آزادسازی بافر(ساده)
    شدوساکس.آزادسازی بافر(سر)
    شدوساکس.آزادسازی بافر(متغیر_packet)
    شدوساکس.آزادسازی بافر(بدنه)
    شدوساکس.پاکسازی بافر(کلید)
    شدوساکس.آزادسازی بافر(کلید)
پایان
