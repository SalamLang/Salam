واردسازی شبکه.شدوساکس

تابع ریشه:
    m := شدوساکس.یافتن روش("chacha20-ietf-poly1305")
    ناپایا key := شدوساکس.ساخت کلید(m، "codec password")

    ناپایا enc := شدوساکس.رمزگذار جدید تصادفی(m، key.اشاره گر)
    ناپایا wire := شدوساکس.بافر جدید(256)
    شدوساکس.ارسال نمک(enc، wire)
    شدوساکس.رمزگذاری جریان(enc، "hello codec" برگردان تهی*، 11، wire)
    سرچاپ "wire bytes"، wire.طول، "salt"، m.طول نمک، "overhead"، wire.طول - 11 - m.طول نمک

    ناپایا dec := شدوساکس.رمزگشا جدید(m، key.اشاره گر)
    ناپایا plain := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.رمزگشایی همه(dec، wire.اشاره گر، wire.طول، plain)، شدوساکس.بافر به رشته(plain)

    ناپایا head := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.رمزگذاری مقصد("example.com"، 8443، head)، head.طول، شدوساکس.بافر به هگز(head)
    ناپایا t := شدوساکس.مقصد {}
    used := شدوساکس.تجزیه مقصد(head.اشاره گر، head.طول، t)
    سرچاپ used، t.میزبان، t.درگاه

    ناپایا packet := شدوساکس.بافر جدید(128)
    سرچاپ شدوساکس.بسته بندی یو دی پی(m، key.اشاره گر، "10.0.0.7"، 53، "query" برگردان تهی*، 5، packet)، packet.طول
    ناپایا got := شدوساکس.مقصد {}
    ناپایا body := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.بازکردن یو دی پی(m، key.اشاره گر، packet.اشاره گر، packet.طول، got، body)، got.میزبان، got.درگاه، شدوساکس.بافر به رشته(body)

    شدوساکس.آزادسازی رمزگذار(enc)
    شدوساکس.آزادسازی رمزگشا(dec)
    شدوساکس.آزادسازی بافر(wire)
    شدوساکس.آزادسازی بافر(plain)
    شدوساکس.آزادسازی بافر(head)
    شدوساکس.آزادسازی بافر(packet)
    شدوساکس.آزادسازی بافر(body)
    شدوساکس.پاکسازی بافر(key)
    شدوساکس.آزادسازی بافر(key)
پایان
