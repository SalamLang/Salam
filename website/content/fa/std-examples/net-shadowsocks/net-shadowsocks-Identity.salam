// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.شدوساکس

تابع ریشه:
    سرچاپ شدوساکس.طول سرآیند هویت، شدوساکس.زمینه هویت

    تعداد۲ := شدوساکس.یافتن روش("2022-blake3-aes-128-gcm")
    ناپایا متغیر_chain := شدوساکس.زنجیره از(تعداد۲، "AAECAwQFBgcICQoLDA0ODw==:EBESExQVFhcYGRobHB0eHw==")
    سرچاپ متغیر_chain.معتبر، متغیر_chain.تعداد، متغیر_chain.طول کلید، متغیر_chain.کلیدها.طول
    سرچاپ شدوساکس.بافر به هگز(شدوساکس.بافر { اشاره گر = شدوساکس.کلید زنجیره(متغیر_chain، 1)، طول = 16، ظرفیت = 16 })
    بد := شدوساکس.زنجیره از(تعداد۲، "not a key")
    سرچاپ بد.معتبر، بد.تعداد

    متغیر_ipsk := شدوساکس.کلید زنجیره(متغیر_chain، 0)
    متغیر_upsk := شدوساکس.کلید زنجیره(متغیر_chain، 1)
    اچ := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    شدوساکس.هش هویت(متغیر_upsk، تعداد۲.طول کلید، اچ)
    سرچاپ شدوساکس.هگز از(اچ، 16)

    نمک := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    متغیر_ik := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    شدوساکس.کلید هویت(متغیر_ipsk، تعداد۲.طول کلید، نمک، تعداد۲.طول نمک، متغیر_ik)
    سرچاپ شدوساکس.هگز از(متغیر_ik، 16)

    متغیر_block := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    سرچاپ شدوساکس.مهر سرآیند هویت(متغیر_ipsk، تعداد۲.طول کلید، نمک، تعداد۲.طول نمک، متغیر_upsk، متغیر_block)
    سرچاپ شدوساکس.هگز از(متغیر_block، 16)
    متغیر_opened := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    سرچاپ شدوساکس.گشودن سرآیند هویت(متغیر_ipsk، تعداد۲.طول کلید، نمک، تعداد۲.طول نمک، متغیر_block، متغیر_opened)
    سرچاپ شدوساکس.هگز از(متغیر_opened، 16) برابر شدوساکس.هگز از(اچ، 16)

    شدوساکس.آزادسازی زنجیره(متغیر_chain)
    سرچاپ متغیر_chain.معتبر، متغیر_chain.تعداد
    حافظه.آزادسازی(اچ)
    حافظه.آزادسازی(نمک)
    حافظه.آزادسازی(متغیر_ik)
    حافظه.آزادسازی(متغیر_block)
    حافظه.آزادسازی(متغیر_opened)
پایان
