// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.شدوساکس

تابع ریشه:
    سرچاپ شدوساکس.طول سرآیند هویت، شدوساکس.زمینه هویت

    m := شدوساکس.یافتن روش("2022-blake3-aes-128-gcm")
    ناپایا chain := شدوساکس.زنجیره از(m، "AAECAwQFBgcICQoLDA0ODw==:EBESExQVFhcYGRobHB0eHw==")
    سرچاپ chain.معتبر، chain.تعداد، chain.طول کلید، chain.کلیدها.طول
    سرچاپ شدوساکس.بافر به هگز(شدوساکس.بافر { اشاره گر = شدوساکس.کلید زنجیره(chain، 1)، طول = 16، ظرفیت = 16 })
    bad := شدوساکس.زنجیره از(m، "not a key")
    سرچاپ bad.معتبر، bad.تعداد

    ipsk := شدوساکس.کلید زنجیره(chain، 0)
    upsk := شدوساکس.کلید زنجیره(chain، 1)
    h := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    شدوساکس.هش هویت(upsk، m.طول کلید، h)
    سرچاپ شدوساکس.هگز از(h، 16)

    salt := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    ik := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    شدوساکس.کلید هویت(ipsk، m.طول کلید، salt، m.طول نمک، ik)
    سرچاپ شدوساکس.هگز از(ik، 16)

    block := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    سرچاپ شدوساکس.مهر سرآیند هویت(ipsk، m.طول کلید، salt، m.طول نمک، upsk، block)
    سرچاپ شدوساکس.هگز از(block، 16)
    opened := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    سرچاپ شدوساکس.گشودن سرآیند هویت(ipsk، m.طول کلید، salt، m.طول نمک، block، opened)
    سرچاپ شدوساکس.هگز از(opened، 16) برابر شدوساکس.هگز از(h، 16)

    شدوساکس.آزادسازی زنجیره(chain)
    سرچاپ chain.معتبر، chain.تعداد
    حافظه.آزادسازی(h)
    حافظه.آزادسازی(salt)
    حافظه.آزادسازی(ik)
    حافظه.آزادسازی(block)
    حافظه.آزادسازی(opened)
پایان
