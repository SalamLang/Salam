// زبان: فارسی
واردسازی شبکه.شدوساکس

تابع ریشه:
    متغیر_method := "2022-blake3-aes-128-gcm"
    متغیر_ipsk := "AAECAwQFBgcICQoLDA0ODw=="
    کارساز := شدوساکس.گوش دادن روی نشانی("127.0.0.1"، 0، متغیر_method، متغیر_ipsk، "")
    سرچاپ شدوساکس.سرور معتبر(کارساز)، شدوساکس.درگاه سرور(کارساز) بزرگتر 0
    سرچاپ شدوساکس.افزودن کاربر(کارساز، "alice"، "EBESExQVFhcYGRobHB0eHw==")
    سرچاپ شدوساکس.افزودن کاربر(کارساز، "bob"، "ICEiIyQlJicoKSorLC0uLw==")
    سرچاپ شدوساکس.افزودن کاربر(کارساز، "bad"، "short")
    سرچاپ کارساز.وضعیت.تعداد کاربران، کارساز.وضعیت.کاربران.دارد("x")، کارساز.وضعیت.نام کاربران.اندازه()
    شدوساکس.نابودی سرور(کارساز)

    متغیر_classic := شدوساکس.گوش دادن روی نشانی("127.0.0.1"، 0، "chacha20-ietf-poly1305"، "password"، "")
    سرچاپ شدوساکس.افزودن کاربر(متغیر_classic، "carol"، "password")
    شدوساکس.نابودی سرور(متغیر_classic)

    ناپایا بازپخش := شدوساکس.گوش دادن یو دی پی روی نشانی("127.0.0.1"، 0، متغیر_method، متغیر_ipsk)
    سرچاپ بازپخش.معتبر، شدوساکس.درگاه سرور یو دی پی(بازپخش) بزرگتر 0
    سرچاپ شدوساکس.افزودن کاربر یو دی پی(بازپخش، "EBESExQVFhcYGRobHB0eHw==")
    سرچاپ شدوساکس.افزودن کاربر یو دی پی(بازپخش، "short")
    سرچاپ بازپخش.تعداد کاربران، بازپخش.کاربران.اندازه()، بازپخش.نشست ها.اندازه()
    شدوساکس.نابودی یو دی پی(بازپخش)
پایان
