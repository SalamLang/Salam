// زبان: فارسی
واردسازی شبکه.شدوساکس

تابع ریشه:
    method := "2022-blake3-aes-128-gcm"
    ipsk := "AAECAwQFBgcICQoLDA0ODw=="
    server := شدوساکس.گوش دادن روی نشانی("127.0.0.1"، 0، method، ipsk، "")
    سرچاپ شدوساکس.سرور معتبر(server)، شدوساکس.درگاه سرور(server) بزرگتر 0
    سرچاپ شدوساکس.افزودن کاربر(server، "alice"، "EBESExQVFhcYGRobHB0eHw==")
    سرچاپ شدوساکس.افزودن کاربر(server، "bob"، "ICEiIyQlJicoKSorLC0uLw==")
    سرچاپ شدوساکس.افزودن کاربر(server، "bad"، "short")
    سرچاپ server.وضعیت.تعداد کاربران، server.وضعیت.کاربران.دارد("x")، server.وضعیت.نام کاربران.اندازه()
    شدوساکس.نابودی سرور(server)

    classic := شدوساکس.گوش دادن روی نشانی("127.0.0.1"، 0، "chacha20-ietf-poly1305"، "password"، "")
    سرچاپ شدوساکس.افزودن کاربر(classic، "carol"، "password")
    شدوساکس.نابودی سرور(classic)

    ناپایا relay := شدوساکس.گوش دادن یو دی پی روی نشانی("127.0.0.1"، 0، method، ipsk)
    سرچاپ relay.معتبر، شدوساکس.درگاه سرور یو دی پی(relay) بزرگتر 0
    سرچاپ شدوساکس.افزودن کاربر یو دی پی(relay، "EBESExQVFhcYGRobHB0eHw==")
    سرچاپ شدوساکس.افزودن کاربر یو دی پی(relay، "short")
    سرچاپ relay.تعداد کاربران، relay.کاربران.اندازه()، relay.نشست ها.اندازه()
    شدوساکس.نابودی یو دی پی(relay)
پایان
