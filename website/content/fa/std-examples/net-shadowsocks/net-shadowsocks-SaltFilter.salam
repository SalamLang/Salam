// زبان: فارسی
واردسازی شبکه.شدوساکس

تابع ریشه:
    ناپایا f := شدوساکس.فیلتر نمک جدید(1000)
    a := "salt number one, 32 bytes long.."
    b := "salt number two, 32 bytes long.."
    سرچاپ f.ظرفیت، شدوساکس.نمک دیده شده(f، a برگردان تهی*، 32)
    سرچاپ شدوساکس.بررسی فیلتر(f، a برگردان تهی*، 32)، شدوساکس.نمک دیده شده(f، a برگردان تهی*، 32)
    سرچاپ شدوساکس.بررسی فیلتر(f، a برگردان تهی*، 32)، شدوساکس.بررسی فیلتر(f، b برگردان تهی*، 32)
    سرچاپ f.نسل جاری.اندازه()، f.نسل پیشین.اندازه()
    شدوساکس.آزادسازی فیلتر(f)
پایان
