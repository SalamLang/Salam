// زبان: فارسی
واردسازی شبکه.شدوساکس

تابع ریشه:
    ناپایا پرونده_محلی := شدوساکس.فیلتر نمک جدید(1000)
    الف := "salt number one, 32 bytes long.."
    بافر_محلی := "salt number two, 32 bytes long.."
    سرچاپ پرونده_محلی.ظرفیت، شدوساکس.نمک دیده شده(پرونده_محلی، الف برگردان تهی*، 32)
    سرچاپ شدوساکس.بررسی فیلتر(پرونده_محلی، الف برگردان تهی*، 32)، شدوساکس.نمک دیده شده(پرونده_محلی، الف برگردان تهی*، 32)
    سرچاپ شدوساکس.بررسی فیلتر(پرونده_محلی، الف برگردان تهی*، 32)، شدوساکس.بررسی فیلتر(پرونده_محلی، بافر_محلی برگردان تهی*، 32)
    سرچاپ پرونده_محلی.نسل جاری.اندازه()، پرونده_محلی.نسل پیشین.اندازه()
    شدوساکس.آزادسازی فیلتر(پرونده_محلی)
پایان
