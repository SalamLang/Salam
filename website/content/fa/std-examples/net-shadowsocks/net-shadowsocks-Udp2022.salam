// زبان: فارسی
واردسازی شبکه.شدوساکس

تابع ریشه:
    تعداد۲ := شدوساکس.یافتن روش("2022-blake3-aes-128-gcm")
    سرچاپ تعداد۲.معتبر، تعداد۲.نسخه۲۰۲۲، تعداد۲.طول کلید
    ناپایا کلید := شدوساکس.ساخت کلید(تعداد۲، "AAECAwQFBgcICQoLDA0ODw==")
    سرچاپ کلید.طول

    ناپایا کارخواه := شدوساکس.نشست یو دی پی جدید()
    ناپایا کارساز := شدوساکس.نشست یو دی پی {}
    سرچاپ کارخواه.شناسه نشست نابرابر 0، کارساز.بسته دریافت شد

    ناپایا متغیر_packet := شدوساکس.بافر جدید(256)
    سرچاپ شدوساکس.بسته بندی یو دی پی نسخه جدید(تعداد۲، کلید.اشاره گر، کلید.اشاره گر، شدوساکس.بافر {}، 0، کارخواه، درست، "10.0.0.7"، 53، "query" برگردان تهی*، 5، متغیر_packet)، متغیر_packet.طول بزرگتر 60

    ناپایا شناسه_نشست := 0 برگردان صحیح۶۴
    سرچاپ شدوساکس.نگاه به یو دی پی نسخه جدید(تعداد۲، کلید.اشاره گر، متغیر_packet.اشاره گر، متغیر_packet.طول، شناسه_نشست)، شناسه_نشست برابر کارخواه.شناسه نشست

    ناپایا هدف := شدوساکس.مقصد {}
    ناپایا بدنه := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.بازکردن یو دی پی نسخه جدید(تعداد۲، کلید.اشاره گر، کلید.اشاره گر، 0، نادرست، متغیر_packet.اشاره گر، متغیر_packet.طول، کارساز، هدف، بدنه)، هدف.میزبان، هدف.درگاه، شدوساکس.بافر به رشته(بدنه)
    سرچاپ کارساز.شناسه نشست همتا برابر کارخواه.شناسه نشست، کارساز.آخرین شناسه دریافتی

    سرچاپ شدوساکس.پذیرش شناسه بسته(کارساز، 5)، شدوساکس.پذیرش شناسه بسته(کارساز، 5)، شدوساکس.پذیرش شناسه بسته(کارساز، 3)، کارساز.بالاترین شناسه، کارساز.بسته دریافت شد

    ناپایا متغیر_chain := شدوساکس.زنجیره از(تعداد۲، "AAECAwQFBgcICQoLDA0ODw==:EBESExQVFhcYGRobHB0eHw==")
    متغیر_ipsk := شدوساکس.کلید زنجیره(متغیر_chain، 0)
    متغیر_upsk := شدوساکس.کلید زنجیره(متغیر_chain، 1)
    ناپایا متغیر_multi := شدوساکس.نشست یو دی پی { شناسه نشست = 7 برگردان صحیح۶۴ }
    ناپایا سیم := شدوساکس.بافر جدید(256)
    سرچاپ شدوساکس.بسته بندی یو دی پی نسخه جدید(تعداد۲، متغیر_upsk، متغیر_ipsk، متغیر_chain.کلیدها، 1، متغیر_multi، درست، "10.0.0.8"، 443، "hello" برگردان تهی*، 5، سیم)
    ناپایا متغیر_who := شدوساکس.بافر جدید(16)
    متغیر_who.طول = 16
    سرچاپ شدوساکس.هویت یو دی پی نسخه جدید(تعداد۲، متغیر_ipsk، سیم.اشاره گر، سیم.طول، متغیر_who.اشاره گر)
    ناپایا متغیر_expected := شدوساکس.بافر جدید(16)
    متغیر_expected.طول = 16
    شدوساکس.هش هویت(متغیر_upsk، تعداد۲.طول کلید، متغیر_expected.اشاره گر)
    سرچاپ شدوساکس.بافر به هگز(متغیر_who) برابر شدوساکس.بافر به هگز(متغیر_expected)
    ناپایا دیده := شدوساکس.نشست یو دی پی {}
    ناپایا درونی := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.بازکردن یو دی پی نسخه جدید(تعداد۲، متغیر_upsk، متغیر_ipsk، شدوساکس.طول سرآیند هویت، نادرست، سیم.اشاره گر، سیم.طول، دیده، هدف، درونی)، شدوساکس.بافر به رشته(درونی)
    شدوساکس.آزادسازی بافر(سیم)
    شدوساکس.آزادسازی بافر(متغیر_who)
    شدوساکس.آزادسازی بافر(متغیر_expected)
    شدوساکس.آزادسازی بافر(درونی)
    شدوساکس.آزادسازی زنجیره(متغیر_chain)

    شدوساکس.آزادسازی بافر(متغیر_packet)
    شدوساکس.آزادسازی بافر(بدنه)
    شدوساکس.پاکسازی بافر(کلید)
    شدوساکس.آزادسازی بافر(کلید)
