// زبان: فارسی
واردسازی شبکه.شدوساکس

تابع ریشه:
    m := شدوساکس.یافتن روش("2022-blake3-aes-128-gcm")
    سرچاپ m.معتبر، m.نسخه۲۰۲۲، m.طول کلید
    ناپایا key := شدوساکس.ساخت کلید(m، "AAECAwQFBgcICQoLDA0ODw==")
    سرچاپ key.طول

    ناپایا client := شدوساکس.نشست یو دی پی جدید()
    ناپایا server := شدوساکس.نشست یو دی پی {}
    سرچاپ client.شناسه نشست نابرابر 0، server.بسته دریافت شد

    ناپایا packet := شدوساکس.بافر جدید(256)
    سرچاپ شدوساکس.بسته بندی یو دی پی نسخه جدید(m، key.اشاره گر، key.اشاره گر، شدوساکس.بافر {}، 0، client، درست، "10.0.0.7"، 53، "query" برگردان تهی*، 5، packet)، packet.طول بزرگتر 60

    ناپایا sid := 0 برگردان صحیح۶۴
    سرچاپ شدوساکس.نگاه به یو دی پی نسخه جدید(m، key.اشاره گر، packet.اشاره گر، packet.طول، sid)، sid برابر client.شناسه نشست

    ناپایا target := شدوساکس.مقصد {}
    ناپایا body := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.بازکردن یو دی پی نسخه جدید(m، key.اشاره گر، key.اشاره گر، 0، نادرست، packet.اشاره گر، packet.طول، server، target، body)، target.میزبان، target.درگاه، شدوساکس.بافر به رشته(body)
    سرچاپ server.شناسه نشست همتا برابر client.شناسه نشست، server.آخرین شناسه دریافتی

    سرچاپ شدوساکس.پذیرش شناسه بسته(server، 5)، شدوساکس.پذیرش شناسه بسته(server، 5)، شدوساکس.پذیرش شناسه بسته(server، 3)، server.بالاترین شناسه، server.بسته دریافت شد

    ناپایا chain := شدوساکس.زنجیره از(m، "AAECAwQFBgcICQoLDA0ODw==:EBESExQVFhcYGRobHB0eHw==")
    ipsk := شدوساکس.کلید زنجیره(chain، 0)
    upsk := شدوساکس.کلید زنجیره(chain، 1)
    ناپایا multi := شدوساکس.نشست یو دی پی { شناسه نشست = 7 برگردان صحیح۶۴ }
    ناپایا wire := شدوساکس.بافر جدید(256)
    سرچاپ شدوساکس.بسته بندی یو دی پی نسخه جدید(m، upsk، ipsk، chain.کلیدها، 1، multi، درست، "10.0.0.8"، 443، "hello" برگردان تهی*، 5، wire)
    ناپایا who := شدوساکس.بافر جدید(16)
    who.طول = 16
    سرچاپ شدوساکس.هویت یو دی پی نسخه جدید(m، ipsk، wire.اشاره گر، wire.طول، who.اشاره گر)
    ناپایا expected := شدوساکس.بافر جدید(16)
    expected.طول = 16
    شدوساکس.هش هویت(upsk، m.طول کلید، expected.اشاره گر)
    سرچاپ شدوساکس.بافر به هگز(who) برابر شدوساکس.بافر به هگز(expected)
    ناپایا seen := شدوساکس.نشست یو دی پی {}
    ناپایا inner := شدوساکس.بافر جدید(64)
    سرچاپ شدوساکس.بازکردن یو دی پی نسخه جدید(m، upsk، ipsk، شدوساکس.طول سرآیند هویت، نادرست، wire.اشاره گر، wire.طول، seen، target، inner)، شدوساکس.بافر به رشته(inner)
    شدوساکس.آزادسازی بافر(wire)
    شدوساکس.آزادسازی بافر(who)
    شدوساکس.آزادسازی بافر(expected)
    شدوساکس.آزادسازی بافر(inner)
    شدوساکس.آزادسازی زنجیره(chain)

    شدوساکس.آزادسازی بافر(packet)
    شدوساکس.آزادسازی بافر(body)
    شدوساکس.پاکسازی بافر(key)
    شدوساکس.آزادسازی بافر(key)
پایان
