واردسازی شبکه.سوکت‌آیاو
واردسازی کدگذاری.مقدار

روال ریشه:
    ک := سوکت‌آیاو.اتصال("http://localhost:3000")
    اگر وارونه سوکت‌آیاو.متصل است(ک):
        سرچاپ سوکت‌آیاو.آخرین خطا(ک)
        برگشت
    پایان
    سوکت‌آیاو.روی دلخواه(ک، (ر: سوکت‌آیاو.رویداد):
        سرچاپ "رسید:"، ر.name، سوکت‌آیاو.شمار آرگومان رویداد(ر)
    پایان)
    سوکت‌آیاو.یک‌بار(ک، "welcome"، (ر: سوکت‌آیاو.رویداد):
        سرچاپ سوکت‌آیاو.آرگومان(ر، ۰)
    پایان)
    سوکت‌آیاو.روی دلخواه خروجی(ک، (ر: سوکت‌آیاو.رویداد):
        سرچاپ "فرستاده شد:"، ر.name
    پایان)

    سوکت‌آیاو.پیش‌افزودن دلخواه(ک، (ر: سوکت‌آیاو.رویداد):
        سرچاپ "پیش از همه:"، ر.name
    پایان)
    سوکت‌آیاو.پیش‌افزودن دلخواه خروجی(ک، (ر: سوکت‌آیاو.رویداد):
        سرچاپ "در حال فرستادن:"، ر.name
    پایان)
    سرچاپ سوکت‌آیاو.شمار شنونده دلخواه(ک)

    _ := سوکت‌آیاو.ارسال(ک، "ping")
    _ := سوکت‌آیاو.ارسال عدد(ک، "score"، ۱۲)
    _ := سوکت‌آیاو.ارسال اعشاری(ک، "temp"، ۲۱.۵)
    _ := سوکت‌آیاو.ارسال بولی(ک، "ready"، درست)
    _ := سوکت‌آیاو.ارسال جیسون(ک، "user"، `{"name":"علی"}`)
    _ := سوکت‌آیاو.ارسال بایت(ک، "file"، "abc" برگردان تهی*، ۳)
    _ := سوکت‌آیاو.فرستادن(ک، "یک پیام ساده")

    ناپایا آ := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن رشته(آ، "room-1")
    _ := سوکت‌آیاو.ارسال با آرگومان(ک، "join"، آ)
    _ := سوکت‌آیاو.ارسال ناپایدار(ک، "cursor"، آ)
    _ := سوکت‌آیاو.ارسال با تایید(ک، "join"، آ، ۲۰۰۰، (ت: سوکت‌آیاو.تایید):
        سرچاپ ت.ok، سوکت‌آیاو.شمار تایید(ت)، سوکت‌آیاو.رشته تایید(ت، ۰)
        سرچاپ سوکت‌آیاو.آرگومان تایید(ت، ۱)، سوکت‌آیاو.اعشار تایید(ت، ۱)، سوکت‌آیاو.بولی تایید(ت، ۲)
        اگر سوکت‌آیاو.تایید دودویی است(ت، ۳):
            سرچاپ سوکت‌آیاو.بایت تایید(ت، ۳).len
        پایان
        ناپایا م := سوکت‌آیاو.مقدار تایید(ت، ۰)
        مقدار.آزادسازی مقدار(م)
    پایان)
    سوکت‌آیاو.آزادسازی آرگومان(آ)

    ناپایا ر := سوکت‌آیاو.بعدی(ک، ۵۰۰۰)
    اگر ر.kind == سوکت‌آیاو.رویداد پیام:
        سرچاپ سوکت‌آیاو.آرگومان عددی(ر، ۰)، سوکت‌آیاو.آرگومان اعشاری(ر، ۱)، سوکت‌آیاو.آرگومان بولی(ر، ۲)
        اگر سوکت‌آیاو.آرگومان دودویی است(ر، ۳):
            ب := سوکت‌آیاو.آرگومان بایتی(ر، ۳)
            سرچاپ ب.len
        پایان
        اگر ر.ack_id >= ۰:
            _ := سوکت‌آیاو.پاسخ جیسون(ر، `{"ok":true}`)
        پایان
    وگرنه ر.kind == سوکت‌آیاو.رویداد قطع:
        سرچاپ "قطع شد:"، ر.message
    پایان
    سوکت‌آیاو.آزادسازی رویداد(ر)

    ناپایا ر۲ := سوکت‌آیاو.رویداد بعدی(ک، ۵۰۰۰)
    ناپایا م۲ := سوکت‌آیاو.مقدار آرگومان(ر۲، ۰)
    سرچاپ مقدار.عدد است(م۲)
    مقدار.آزادسازی مقدار(م۲)
    سوکت‌آیاو.آزادسازی رویداد(ر۲)

    _ := سوکت‌آیاو.پمپ(ک، ۱۰۰)
    سوکت‌آیاو.خاموش(ک، "welcome")
    سوکت‌آیاو.خاموش دلخواه(ک)
    سوکت‌آیاو.خاموش دلخواه خروجی(ک)
    سوکت‌آیاو.خاموش همه(ک)
    سوکت‌آیاو.اجرا(ک)
پایان
