    _ := سوکت‌آیاو شبکه.فرستادن(ک، "یک پیام ساده")

    ناپایا آ := سوکت‌آیاو شبکه.آرگومان جدید()
    سوکت‌آیاو شبکه.افزودن رشته(آ، "room-1")
