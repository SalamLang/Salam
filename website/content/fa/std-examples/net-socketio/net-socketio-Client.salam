واردسازی شبکه.سوکت‌آیاو
واردسازی شبکه.وب‌سوکت
واردسازی رشته

ناپایا سرور := وب‌سوکت.سرور {}
ناپایا گزارش := ""

روال سرور آزمایشی():
    ناپایا ا := وب‌سوکت.پذیرش(سرور)
    _ := وب‌سوکت.ارسال متن(ا، `0{"sid":"s1","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    ناپایا ادامه := درست
    تا ادامه:
        پ := وب‌سوکت.دریافت با مهلت(ا، ۳۰۰۰)
        اگر پ.kind != وب‌سوکت.متن:
            بشکن
        پایان
        بسته‌ی سوکت := پ.text.زیررشته(۱، پ.text.طول() - ۱)
        اگر بسته‌ی سوکت == "0":
            _ := وب‌سوکت.ارسال متن(ا، `40{"sid":"a1"}`)
        وگرنه رشته.شروع با(بسته‌ی سوکت، `2["chat"`):
            _ := وب‌سوکت.ارسال متن(ا، `42["chat","خوش آمدی"]`)
            _ := وب‌سوکت.ارسال متن(ا، `429["question","2+2"]`)
        وگرنه رشته.شامل است(بسته‌ی سوکت، `"add"`):
            شناسه := بسته‌ی سوکت.زیررشته(۱، رشته.یافتن(بسته‌ی سوکت، "[") - ۱)
            _ := وب‌سوکت.ارسال متن(ا، "43" + شناسه + "[5]")
        وگرنه رشته.شروع با(بسته‌ی سوکت، "39"):
            گزارش += "پاسخ: " + بسته‌ی سوکت.زیررشته(۲، بسته‌ی سوکت.طول() - ۲)
        وگرنه بسته‌ی سوکت == "1":
            ادامه = نادرست
        پایان
    پایان
    وب‌سوکت.بستن(ا)
پایان

روال ریشه:
    سرور = وب‌سوکت.شنود(۰)
    ن := spawn(سرور آزمایشی)
    ناپایا گ := سوکت‌آیاو.گزینه‌های جدید()
    گ.transports = سوکت‌آیاو.حمل‌ونقل وب‌سوکت
    گ.reconnection = نادرست
    ک := سوکت‌آیاو.اتصال با("http://127.0.0.1:" + وب‌سوکت.درگاه(سرور)، گ)
    سرچاپ سوکت‌آیاو.متصل است(ک)، سوکت‌آیاو.شناسه نشست(ک)، سوکت‌آیاو.شناسه(ک)، سوکت‌آیاو.فضای نام(ک)، سوکت‌آیاو.نام حمل‌ونقل(ک)

    سوکت‌آیاو.روی(ک، "chat"، (ر: سوکت‌آیاو.رویداد):
        سرچاپ "پیام:"، سوکت‌آیاو.آرگومان رشته(ر، ۰)
    پایان)
    سوکت‌آیاو.روی(ک، "question"، (ر: سوکت‌آیاو.رویداد):
        سرچاپ "پرسش:"، سوکت‌آیاو.آرگومان رشته(ر، ۰)، ر.ack_id >= ۰
        _ := سوکت‌آیاو.پاسخ رشته(ر، "چهار")
    پایان)
    سرچاپ سوکت‌آیاو.شمار شنونده(ک، "chat")، سوکت‌آیاو.شنونده دارد(ک، "news")
    _ := سوکت‌آیاو.ارسال رشته(ک، "chat"، "سلام")
    سوکت‌آیاو.اجرا برای(ک، ۵۰۰)

    ناپایا آ := سوکت‌آیاو.آرگومان جدید()
    سوکت‌آیاو.افزودن عدد(آ، ۲)
    سوکت‌آیاو.افزودن عدد(آ، ۳)
    ناپایا ت := سوکت‌آیاو.ارسال منتظر تایید(ک، "add"، آ، ۲۰۰۰)
    سرچاپ ت.ok، سوکت‌آیاو.عدد تایید(ت، ۰)
    سوکت‌آیاو.آزادسازی تایید(ت)
    سوکت‌آیاو.آزادسازی آرگومان(آ)

    سوکت‌آیاو.بستن(ک)
    join(ن)
    وب‌سوکت.بستن سرور(سرور)
    سرچاپ گزارش
پایان
