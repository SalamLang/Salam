واردسازی شبکه.سوکت‌آیاو شبکه
واردسازی شبکه.وب‌سوکت شبکه
واردسازی رشته

ناپایا سرور := وب‌سوکت شبکه.سرور {}
ناپایا گزارش := ""

روال سرور آزمایشی():
    ناپایا ا := وب‌سوکت شبکه.پذیرش(سرور)
    _ := وب‌سوکت شبکه.ارسال متن(ا، `0{"sid":"s1","upgrades":[],"pingInterval":20000,"pingTimeout":5000}`)
    ناپایا ادامه := درست
    تا ادامه:
        پ := وب‌سوکت شبکه.دریافت با مهلت(ا، ۳۰۰۰)
        اگر پ.kind != وب‌سوکت شبکه.متن:
            بشکن
        پایان
        بسته‌ی سوکت := پ.text.زیررشته(۱، پ.text.طول() - ۱)
        اگر بسته‌ی سوکت == "0":
            _ := وب‌سوکت شبکه.ارسال متن(ا، `40{"sid":"a1"}`)
        وگرنه رشته.شروع با(بسته‌ی سوکت، `2["chat"`):
            _ := وب‌سوکت شبکه.ارسال متن(ا، `42["chat","خوش آمدی"]`)
            _ := وب‌سوکت شبکه.ارسال متن(ا، `429["question","2+2"]`)
        وگرنه رشته.شامل است(بسته‌ی سوکت، `"add"`):
            شناسه := بسته‌ی سوکت.زیررشته(۱، رشته.یافتن(بسته‌ی سوکت، "[") - ۱)
            _ := وب‌سوکت شبکه.ارسال متن(ا، "43" + شناسه + "[5]")
        وگرنه رشته.شروع با(بسته‌ی سوکت، "39"):
            گزارش += "پاسخ: " + بسته‌ی سوکت.زیررشته(۲، بسته‌ی سوکت.طول() - ۲)
        وگرنه بسته‌ی سوکت == "1":
            ادامه = نادرست
        پایان
    پایان
    وب‌سوکت شبکه.بستن(ا)
پایان

روال ریشه:
    سرور = وب‌سوکت شبکه.شنود(۰)
    ن := spawn(سرور آزمایشی)
    ناپایا گ := سوکت‌آیاو شبکه.گزینه‌های جدید()
    گ.transports = سوکت‌آیاو شبکه.حمل‌ونقل وب‌سوکت
    گ.reconnection = نادرست
    ک := سوکت‌آیاو شبکه.اتصال با("http://127.0.0.1:" + وب‌سوکت شبکه.درگاه(سرور)، گ)
    سرچاپ سوکت‌آیاو شبکه.متصل است(ک)، سوکت‌آیاو شبکه.شناسه نشست(ک)، سوکت‌آیاو شبکه.شناسه(ک)، سوکت‌آیاو شبکه.فضای نام(ک)، سوکت‌آیاو شبکه.نام حمل‌ونقل(ک)

    سوکت‌آیاو شبکه.روی(ک، "chat"، (ر: سوکت‌آیاو شبکه.رویداد):
        سرچاپ "پیام:"، سوکت‌آیاو شبکه.آرگومان رشته(ر، ۰)
    پایان)
    سوکت‌آیاو شبکه.روی(ک، "question"، (ر: سوکت‌آیاو شبکه.رویداد):
        سرچاپ "پرسش:"، سوکت‌آیاو شبکه.آرگومان رشته(ر، ۰)، ر.ack_id >= ۰
        _ := سوکت‌آیاو شبکه.پاسخ رشته(ر، "چهار")
    پایان)
    سرچاپ سوکت‌آیاو شبکه.شمار شنونده(ک، "chat")، سوکت‌آیاو شبکه.شنونده دارد(ک، "news")
    _ := سوکت‌آیاو شبکه.ارسال رشته(ک، "chat"، "سلام")
    سوکت‌آیاو شبکه.اجرا برای(ک، ۵۰۰)

    ناپایا آ := سوکت‌آیاو شبکه.آرگومان جدید()
    سوکت‌آیاو شبکه.افزودن عدد(آ، ۲)
    سوکت‌آیاو شبکه.افزودن عدد(آ، ۳)
    ناپایا ت := سوکت‌آیاو شبکه.ارسال منتظر تایید(ک، "add"، آ، ۲۰۰۰)
    سرچاپ ت.ok، سوکت‌آیاو شبکه.عدد تایید(ت، ۰)
    سوکت‌آیاو شبکه.آزادسازی تایید(ت)
    سوکت‌آیاو شبکه.آزادسازی آرگومان(آ)

    سوکت‌آیاو شبکه.بستن(ک)
    join(ن)
    وب‌سوکت شبکه.بستن سرور(سرور)
    سرچاپ گزارش
پایان
