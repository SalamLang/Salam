واردسازی شبکه.سوکت‌آیاو شبکه

روال ریشه:
    ناپایا ب := سوکت‌آیاو شبکه.بسته {}
    ب.kind = سوکت‌آیاو شبکه.بسته رویداد
    ب.nsp = "/chat"
    ب.id = ۷
    ب.data = `["hi",1]`
    متن := سوکت‌آیاو شبکه.رمزگذاری بسته(ب)
    سرچاپ متن
    د := سوکت‌آیاو شبکه.رمزگشایی بسته(متن)
    سرچاپ د.ok، د.kind، د.nsp، د.id، د.data
    خطا := سوکت‌آیاو شبکه.رمزگشایی بسته("x")
    سرچاپ خطا.ok

    بار := سوکت‌آیاو شبکه.رمزگذاری موتور(سوکت‌آیاو شبکه.پیام موتور، متن)
    سرچاپ بار
    سرچاپ سوکت‌آیاو شبکه.نوع موتور(بار) == سوکت‌آیاو شبکه.پیام موتور
    سرچاپ سوکت‌آیاو شبکه.بدنه موتور(بار)

    ناپایا فهرست := وکتور {} برگردان وکتور<رشته>
    فهرست.افزودن("2")
    فهرست.افزودن(بار)
    بدنه := سوکت‌آیاو شبکه.پیوستن بارها(فهرست)
    تکه‌ها := سوکت‌آیاو شبکه.جداسازی بارها(بدنه)
    سرچاپ تکه‌ها.طول()، تکه‌ها.دریافت(۰)، تکه‌ها.دریافت(۱)

    آرایه := سوکت‌آیاو شبکه.جداسازی آرایه جیسون(`["a", {"b":[1,2]}, 3]`)
    سرچاپ آرایه.طول()، آرایه.دریافت(۱)

    ج := سوکت‌آیاو شبکه.جانگهدار(۰)
    سرچاپ ج
    سرچاپ سوکت‌آیاو شبکه.شماره جانگهدار(ج)، سوکت‌آیاو شبکه.شماره جانگهدار("12")
