واردسازی شبکه.سوکت‌آیاو

تابع ریشه:
    ناپایا ب := سوکت‌آیاو.بسته {}
    ب.kind = سوکت‌آیاو.بسته رویداد
    ب.nsp = "/chat"
    ب.id = ۷
    ب.data = `["hi",1]`
    متن := سوکت‌آیاو.رمزگذاری بسته(ب)
    سرچاپ متن
    د := سوکت‌آیاو.رمزگشایی بسته(متن)
    سرچاپ د.ok، د.kind، د.nsp، د.id، د.data
    خطا := سوکت‌آیاو.رمزگشایی بسته("x")
    سرچاپ خطا.ok

    بار := سوکت‌آیاو.رمزگذاری موتور(سوکت‌آیاو.پیام موتور، متن)
    سرچاپ بار
    سرچاپ سوکت‌آیاو.نوع موتور(بار) == سوکت‌آیاو.پیام موتور
    سرچاپ سوکت‌آیاو.بدنه موتور(بار)

    ناپایا فهرست := وکتور {} برگردان وکتور<رشته>
    فهرست.افزودن("2")
    فهرست.افزودن(بار)
    بدنه := سوکت‌آیاو.پیوستن بارها(فهرست)
    تکه‌ها := سوکت‌آیاو.جداسازی بارها(بدنه)
    سرچاپ تکه‌ها.طول()، تکه‌ها.دریافت(۰)، تکه‌ها.دریافت(۱)

    آرایه := سوکت‌آیاو.جداسازی آرایه جیسون(`["a", {"b":[1,2]}, 3]`)
    سرچاپ آرایه.طول()، آرایه.دریافت(۱)

    ج := سوکت‌آیاو.جانگهدار(۰)
    سرچاپ ج
    سرچاپ سوکت‌آیاو.شماره جانگهدار(ج)، سوکت‌آیاو.شماره جانگهدار("12")
پایان
