واردسازی شبکه.سوکت‌آیاو

تابع نمایش(نشانی: رشته):
    ن := سوکت‌آیاو.تجزیه نشانی(نشانی)
    اگر وارونه ن.معتبر:
        سرچاپ نشانی، "نامعتبر"
        برگشت
    پایان
    سرچاپ ن.میزبان، ن.درگاه، ن.امن، ن.فضای نام، "پرس‌وجو=" + ن.پرسمان
    سرچاپ سوکت‌آیاو.مبدا(ن)
پایان

تابع ریشه:
    نمایش("http://localhost:3000")
    نمایش("https://example.com/admin/?token=abc")
    نمایش("ws://[::1]:8080/chat")
    نمایش("ftp://example.com")
پایان
