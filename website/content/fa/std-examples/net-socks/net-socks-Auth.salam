// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        data := تی سی پی.خواندن(c، 4096)
        اگر data.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(c، data)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            بشکن
        پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    listener := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، listener.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(listener)
پایان

تابع say(label: رشته، r: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد + " " + r.خطا
پایان

تابع ریشه:
    echo := start_echo()

    ناپایا config := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(config، درست)
    ساکس.افزودن کاربر(config، "alice"، "s3cret")
    سرچاپ config.نیاز به احراز هویت
    server := ساکس.شروع(config)

    say("right password"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، server.درگاه، "alice"، "s3cret")، "127.0.0.1"، echo))
    say("wrong password"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، server.درگاه، "alice"، "nope")، "127.0.0.1"، echo))
    say("no credentials"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، server.درگاه)، "127.0.0.1"، echo))
    ساکس.توقف(server)

    ناپایا custom := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(custom، درست)
    ساکس.تعیین احراز هویت(custom، (user: رشته، password: رشته): برگشت user برابر "bob" و password برابر "pw" پایان)
    سرچاپ custom.دارای احراز هویت سفارشی
    second := ساکس.شروع(custom)
    say("callback accepts"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، second.درگاه، "bob"، "pw")، "127.0.0.1"، echo))
    say("callback refuses"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، second.درگاه، "bob"، "xx")، "127.0.0.1"، echo))
    ساکس.توقف(second)
پایان
