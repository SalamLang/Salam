// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع echo_conn(arg: صحیح۶۴):
    نویسه := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        داده := تی سی پی.خواندن(نویسه، 4096)
        اگر داده.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(نویسه، داده)
    پایان
    تی سی پی.بستن(نویسه)
پایان

تابع echo_accept(arg: صحیح۶۴):
    کارساز2 := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        اگر وارونه تی سی پی.اتصال معتبر(نویسه):
            بشکن
        پایان
        ساکس.برو(echo_conn، نویسه.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    شنونده := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، شنونده.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(شنونده)
پایان

تابع say(label: رشته، r: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد + " " + r.خطا
پایان

تابع ریشه:
    متغیر_echo := start_echo()

    ناپایا پیکربندی := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    ساکس.افزودن کاربر(پیکربندی، "alice"، "s3cret")
    سرچاپ پیکربندی.نیاز به احراز هویت
    کارساز := ساکس.شروع(پیکربندی)

    say("right password"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، کارساز.درگاه، "alice"، "s3cret")، "127.0.0.1"، متغیر_echo))
    say("wrong password"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، کارساز.درگاه، "alice"، "nope")، "127.0.0.1"، متغیر_echo))
    say("no credentials"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، کارساز.درگاه)، "127.0.0.1"، متغیر_echo))
    ساکس.توقف(کارساز)

    ناپایا متغیر_custom := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(متغیر_custom، درست)
    ساکس.تعیین احراز هویت(متغیر_custom، (user: رشته، password: رشته): برگشت user برابر "bob" و password برابر "pw" پایان)
    سرچاپ متغیر_custom.دارای احراز هویت سفارشی
    دومی := ساکس.شروع(متغیر_custom)
    say("callback accepts"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، دومی.درگاه، "bob"، "pw")، "127.0.0.1"، متغیر_echo))
    say("callback refuses"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، دومی.درگاه، "bob"، "xx")، "127.0.0.1"، متغیر_echo))
    ساکس.توقف(دومی)
پایان
