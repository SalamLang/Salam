// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع ریشه:
    ناپایا پیکربندی := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    پیکربندی.اجازه پیوند = درست
    کارساز := ساکس.شروع(پیکربندی)
    کارخواه := ساکس.کلاینت جدید("127.0.0.1"، کارساز.درگاه)

    نخست := ساکس.پیوند درخواست(کارخواه، "127.0.0.1"، 0)
    سرچاپ "bind accepted:"، نخست.موفق، نخست.کد، نخست.نشانی محلی.درگاه بزرگتر 0
    متغیر_peer := تی سی پی.شماره گیری("127.0.0.1"، نخست.نشانی محلی.درگاه)
    دومی := ساکس.پذیرش پیوند(نخست.جریان، کارخواه)
    سرچاپ "peer connected:"، دومی.موفق
    تی سی پی.نوشتن(متغیر_peer، "from the inbound peer")
    سرچاپ نخست.جریان.خواندن(100)
    نخست.جریان.نوشتن("reply to the peer")
    سرچاپ تی سی پی.خواندن(متغیر_peer، 100)
    تی سی پی.بستن(متغیر_peer)
    نخست.جریان.بستن()
    ساکس.توقف(کارساز)

    ناپایا متغیر_plain_cfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(متغیر_plain_cfg، درست)
    ساده := ساکس.شروع(متغیر_plain_cfg)
    متغیر_off := ساکس.پیوند درخواست(ساکس.کلاینت جدید("127.0.0.1"، ساده.درگاه)، "127.0.0.1"، 0)
    سرچاپ "bind not enabled:"، متغیر_off.موفق، متغیر_off.کد، متغیر_off.خطا
    ساکس.توقف(ساده)
پایان
