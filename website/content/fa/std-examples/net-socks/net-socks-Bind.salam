// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع ریشه:
    ناپایا config := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(config، درست)
    config.اجازه پیوند = درست
    server := ساکس.شروع(config)
    client := ساکس.کلاینت جدید("127.0.0.1"، server.درگاه)

    first := ساکس.پیوند درخواست(client، "127.0.0.1"، 0)
    سرچاپ "bind accepted:"، first.موفق، first.کد، first.نشانی محلی.درگاه بزرگتر 0
    peer := تی سی پی.شماره گیری("127.0.0.1"، first.نشانی محلی.درگاه)
    second := ساکس.پذیرش پیوند(first.جریان، client)
    سرچاپ "peer connected:"، second.موفق
    تی سی پی.نوشتن(peer، "from the inbound peer")
    سرچاپ first.جریان.خواندن(100)
    first.جریان.نوشتن("reply to the peer")
    سرچاپ تی سی پی.خواندن(peer، 100)
    تی سی پی.بستن(peer)
    first.جریان.بستن()
    ساکس.توقف(server)

    ناپایا plain_cfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(plain_cfg، درست)
    plain := ساکس.شروع(plain_cfg)
    off := ساکس.پیوند درخواست(ساکس.کلاینت جدید("127.0.0.1"، plain.درگاه)، "127.0.0.1"، 0)
    سرچاپ "bind not enabled:"، off.موفق، off.کد، off.خطا
    ساکس.توقف(plain)
پایان
