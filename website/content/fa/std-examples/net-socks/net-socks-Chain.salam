// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        data := تی سی پی.خواندن(c، 4096)
        اگر data.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(c، data)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            بشکن
        پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    listener := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، listener.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(listener)
پایان

تابع ریشه:
    echo := start_echo()
    first := ساکس.شروع(ساکس.پیکربندی سرور جدید(0))
    second := ساکس.شروع(ساکس.پیکربندی سرور جدید(0))

    hop := ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، first.درگاه)، "127.0.0.1"، second.درگاه)
    سرچاپ "first hop:"، hop.موفق
    onward := ساکس.دست‌دهی کلاینت(hop.جریان، ساکس.کلاینت جدید(""، 0)، ساکس.فرمان اتصال، "127.0.0.1"، echo)
    سرچاپ "second hop:"، onward.موفق
    hop.جریان.نوشتن("through two proxies")
    سرچاپ hop.جریان.خواندن(100)
    hop.جریان.بستن()

    ناپایا chain := تونل.زنجیره جدید(تونل.مستقیم())
    تونل.افزودن گام(chain، ساکس.رابط جدید(ساکس.کلاینت جدید("127.0.0.1"، first.درگاه)))
    تونل.افزودن گام(chain، ساکس.رابط جدید(ساکس.کلاینت جدید("127.0.0.1"، second.درگاه)))
    سرچاپ chain.نام()
    s := chain.اتصال(تونل.نشانی جدید("127.0.0.1"، echo))
    s.نوشتن("same thing with a chain")
    سرچاپ s.خواندن(100)
    s.بستن()

    connector := ساکس.رابط جدید(ساکس.کلاینت جدید("127.0.0.1"، first.درگاه))
    سرچاپ connector.نام()، connector.کارساز().متن() برابر "127.0.0.1:" + first.درگاه
    ساکس.توقف(first)
    ساکس.توقف(second)
پایان
