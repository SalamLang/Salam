// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

تابع echo_conn(arg: صحیح۶۴):
    نویسه := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        داده := تی سی پی.خواندن(نویسه، 4096)
        اگر داده.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(نویسه، داده)
    پایان
    تی سی پی.بستن(نویسه)
پایان

تابع echo_accept(arg: صحیح۶۴):
    کارساز := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        اگر وارونه تی سی پی.اتصال معتبر(نویسه):
            بشکن
        پایان
        ساکس.برو(echo_conn، نویسه.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    شنونده := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، شنونده.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(شنونده)
پایان

تابع ریشه:
    متغیر_echo := start_echo()
    ناپایا متغیر_first_cfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(متغیر_first_cfg، درست)
    نخست := ساکس.شروع(متغیر_first_cfg)
    ناپایا متغیر_second_cfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(متغیر_second_cfg، درست)
    دومی := ساکس.شروع(متغیر_second_cfg)

    گام := ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، نخست.درگاه)، "127.0.0.1"، دومی.درگاه)
    سرچاپ "first hop:"، گام.موفق
    متغیر_onward := ساکس.دست‌دهی کلاینت(گام.جریان، ساکس.کلاینت جدید(""، 0)، ساکس.فرمان اتصال، "127.0.0.1"، متغیر_echo)
    سرچاپ "second hop:"، متغیر_onward.موفق
    گام.جریان.نوشتن("through two proxies")
    سرچاپ گام.جریان.خواندن(100)
    گام.جریان.بستن()

    ناپایا متغیر_chain := تونل.زنجیره جدید(تونل.مستقیم())
    تونل.افزودن گام(متغیر_chain، ساکس.رابط جدید(ساکس.کلاینت جدید("127.0.0.1"، نخست.درگاه)))
    تونل.افزودن گام(متغیر_chain، ساکس.رابط جدید(ساکس.کلاینت جدید("127.0.0.1"، دومی.درگاه)))
    سرچاپ متغیر_chain.نام()
    متن_نمونه := متغیر_chain.اتصال(تونل.نشانی جدید("127.0.0.1"، متغیر_echo))
    متن_نمونه.نوشتن("same thing with a chain")
    سرچاپ متن_نمونه.خواندن(100)
    متن_نمونه.بستن()

    متغیر_connector := ساکس.رابط جدید(ساکس.کلاینت جدید("127.0.0.1"، نخست.درگاه))
    سرچاپ متغیر_connector.نام()، متغیر_connector.کارساز().متن() برابر "127.0.0.1:" + نخست.درگاه
    ساکس.توقف(نخست)
    ساکس.توقف(دومی)
پایان
