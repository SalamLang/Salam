// زبان: فارسی
واردسازی شبکه.ساکس

تابع ریشه:
    methods := وکتور {} برگردان وکتور<طبیعی۸>
    methods.بیفزا(0 برگردان طبیعی۸)
    methods.بیفزا(2 برگردان طبیعی۸)
    سرچاپ "greeting   "، ساکس.به هگز(ساکس.رمزگذاری سلام(methods))
    سرچاپ "choice     "، ساکس.به هگز(ساکس.رمزگذاری انتخاب روش(ساکس.احراز هویت نام کاربری))
    سرچاپ "auth       "، ساکس.به هگز(ساکس.رمزگذاری درخواست احراز هویت("alice"، "pw"))
    سرچاپ "auth ok    "، ساکس.به هگز(ساکس.رمزگذاری پاسخ احراز هویت(درست))

    target := ساکس.نشانی جدید("example.com"، 443)
    سرچاپ target.نوع برابر ساکس.نوع دامنه، ساکس.دسته‌بندی میزبان("10.1.2.3") برابر ساکس.نوع آی‌پی۴، ساکس.دسته‌بندی میزبان("::1") برابر ساکس.نوع آی‌پی۶
    request := ساکس.رمزگذاری درخواست(ساکس.فرمان اتصال، target)
    سرچاپ "request    "، ساکس.به هگز(request)
    ناپایا parsed := ساکس.درخواست {}
    سرچاپ ساکس.رمزگشایی درخواست(request، parsed)، parsed.فرمان برابر ساکس.فرمان اتصال، parsed.نشانی.میزبان، parsed.نشانی.درگاه
    ناپایا partial := وکتور {} برگردان وکتور<طبیعی۸>
    تکرار 5 در i:
        partial.بیفزا(request[i])
    پایان
    سرچاپ "short      "، ساکس.رمزگشایی درخواست(partial، parsed)

    reply := ساکس.رمزگذاری پاسخ(ساکس.پاسخ موفق، ساکس.نشانی جدید("10.0.0.1"، 1080))
    سرچاپ "reply      "، ساکس.به هگز(reply)
    ناپایا answer := ساکس.پاسخ {}
    سرچاپ ساکس.رمزگشایی پاسخ(reply، answer)، answer.کد، answer.نشانی.میزبان، ساکس.متن پاسخ(answer.کد)
    سرچاپ ساکس.متن پاسخ(ساکس.پاسخ اتصال رد شد)، "|"، ساکس.متن پاسخ(ساکس.پاسخ۴ رد شد)

    ناپایا ip := وکتور {} برگردان وکتور<طبیعی۸>
    سرچاپ ساکس.تجزیه آی‌پی۴("192.168.1.20"، ip)، ساکس.قالب آی‌پی۴(ip، 0)
    ناپایا ip6 := وکتور {} برگردان وکتور<طبیعی۸>
    سرچاپ ساکس.تجزیه آی‌پی۶("2001:db8::1"، ip6)، ساکس.قالب آی‌پی۶(ip6، 0)
    encoded := ساکس.رمزگذاری نشانی(target)
    ناپایا back := ساکس.نشانی {}
    سرچاپ ساکس.رمزگشایی نشانی(encoded، 0، back)، back.میزبان

    udp := ساکس.رمزگذاری سرآیند یو دی پی(target، 0)
    سرچاپ "udp header "، ساکس.به هگز(udp)
    ناپایا header := ساکس.سرآیند یو دی پی {}
    سرچاپ ساکس.رمزگشایی سرآیند یو دی پی(udp، header)، header.قطعه، header.نشانی.میزبان، header.طول سرآیند

    four := ساکس.رمزگذاری درخواست ساکس۴(ساکس.فرمان اتصال، "127.0.0.1"، 80، "bob")
    سرچاپ "socks4 req "، ساکس.به هگز(four)
    ناپایا four_req := ساکس.درخواست {}
    سرچاپ ساکس.رمزگشایی درخواست ساکس۴(four، four_req)، four_req.کاربر، four_req.نشانی.درگاه
    four_reply := ساکس.رمزگذاری پاسخ ساکس۴(ساکس.پاسخ۴ پذیرفته، "127.0.0.1"، 80)
    سرچاپ "socks4 rep "، ساکس.به هگز(four_reply)
    ناپایا four_ans := ساکس.پاسخ {}
    سرچاپ ساکس.رمزگشایی پاسخ ساکس۴(four_reply، four_ans)، four_ans.کد
    سرچاپ ساکس.نسخه ساکس۵، ساکس.نسخه ساکس۴، ساکس.بدون احراز هویت، ساکس.روش پذیرفتنی نیست، ساکس.فرمان پیوند، ساکس.فرمان یو دی پی، ساکس.نوع آی‌پی۴
    سرچاپ ساکس.پاسخ خطای کلی، ساکس.پاسخ غیرمجاز، ساکس.ساکس۴ای
پایان
