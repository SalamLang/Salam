// زبان: فارسی
واردسازی شبکه.ساکس

تابع ریشه:
    متغیر_methods := وکتور {} برگردان وکتور<طبیعی۸>
    متغیر_methods.بیفزا(0 برگردان طبیعی۸)
    متغیر_methods.بیفزا(2 برگردان طبیعی۸)
    سرچاپ "greeting   "، ساکس.به هگز(ساکس.رمزگذاری سلام(متغیر_methods))
    سرچاپ "choice     "، ساکس.به هگز(ساکس.رمزگذاری انتخاب روش(ساکس.احراز هویت نام کاربری))
    سرچاپ "auth       "، ساکس.به هگز(ساکس.رمزگذاری درخواست احراز هویت("alice"، "pw"))
    سرچاپ "auth ok    "، ساکس.به هگز(ساکس.رمزگذاری پاسخ احراز هویت(درست))

    هدف := ساکس.نشانی جدید("example.com"، 443)
    سرچاپ هدف.نوع برابر ساکس.نوع دامنه، ساکس.دسته‌بندی میزبان("10.1.2.3") برابر ساکس.نوع آی‌پی۴، ساکس.دسته‌بندی میزبان("::1") برابر ساکس.نوع آی‌پی۶
    درخواست := ساکس.رمزگذاری درخواست(ساکس.فرمان اتصال، هدف)
    سرچاپ "request    "، ساکس.به هگز(درخواست)
    ناپایا متغیر_parsed := ساکس.درخواست {}
    سرچاپ ساکس.رمزگشایی درخواست(درخواست، متغیر_parsed)، متغیر_parsed.فرمان برابر ساکس.فرمان اتصال، متغیر_parsed.نشانی.میزبان، متغیر_parsed.نشانی.درگاه
    ناپایا متغیر_partial := وکتور {} برگردان وکتور<طبیعی۸>
    تکرار 5 در شمارنده:
        متغیر_partial.بیفزا(درخواست[شمارنده])
    پایان
    سرچاپ "short      "، ساکس.رمزگشایی درخواست(متغیر_partial، متغیر_parsed)

    پاسخ_فرآیند := ساکس.رمزگذاری پاسخ(ساکس.کد موفق، ساکس.نشانی جدید("10.0.0.1"، 1080))
    سرچاپ "reply      "، ساکس.به هگز(پاسخ_فرآیند)
    ناپایا پاسخ_متن := ساکس.پاسخ {}
    سرچاپ ساکس.رمزگشایی پاسخ(پاسخ_فرآیند، پاسخ_متن)، پاسخ_متن.کد، پاسخ_متن.نشانی.میزبان، ساکس.متن پاسخ(پاسخ_متن.کد)
    سرچاپ ساکس.متن پاسخ(ساکس.کد اتصال رد شد)، "|"، ساکس.متن پاسخ(ساکس.کد ساکس۴ رد شد)

    ناپایا متغیر_ip := وکتور {} برگردان وکتور<طبیعی۸>
    سرچاپ ساکس.تجزیه آی‌پی۴("192.168.1.20"، متغیر_ip)، ساکس.قالب آی‌پی۴(متغیر_ip، 0)
    ناپایا متغیر_ip6 := وکتور {} برگردان وکتور<طبیعی۸>
    سرچاپ ساکس.تجزیه آی‌پی۶("2001:db8::1"، متغیر_ip6)، ساکس.قالب آی‌پی۶(متغیر_ip6، 0)
    متغیر_encoded := ساکس.رمزگذاری نشانی(هدف)
    ناپایا بازگشت := ساکس.نشانی {}
    سرچاپ ساکس.رمزگشایی نشانی(متغیر_encoded، 0، بازگشت)، بازگشت.میزبان

    متغیر_udp := ساکس.رمزگذاری سرآیند یو دی پی(هدف، 0)
    سرچاپ "udp header "، ساکس.به هگز(متغیر_udp)
    ناپایا سرصفحه := ساکس.سرآیند یو دی پی {}
    سرچاپ ساکس.رمزگشایی سرآیند یو دی پی(متغیر_udp، سرصفحه)، سرصفحه.قطعه، سرصفحه.نشانی.میزبان، سرصفحه.طول سرآیند

    متغیر_four := ساکس.رمزگذاری درخواست ساکس۴(ساکس.فرمان اتصال، "127.0.0.1"، 80، "bob")
    سرچاپ "socks4 req "، ساکس.به هگز(متغیر_four)
    ناپایا متغیر_four_req := ساکس.درخواست {}
    سرچاپ ساکس.رمزگشایی درخواست ساکس۴(متغیر_four، متغیر_four_req)، متغیر_four_req.کاربر، متغیر_four_req.نشانی.درگاه
    متغیر_four_reply := ساکس.رمزگذاری پاسخ ساکس۴(ساکس.کد ساکس۴ پذیرفته، "127.0.0.1"، 80)
    سرچاپ "socks4 rep "، ساکس.به هگز(متغیر_four_reply)
    ناپایا متغیر_four_ans := ساکس.پاسخ {}
    سرچاپ ساکس.رمزگشایی پاسخ ساکس۴(متغیر_four_reply، متغیر_four_ans)، متغیر_four_ans.کد
    سرچاپ ساکس.نسخه ساکس۵، ساکس.نسخه ساکس۴، ساکس.بدون احراز هویت، ساکس.روش پذیرفتنی نیست، ساکس.فرمان پیوند، ساکس.فرمان یو دی پی، ساکس.نوع آی‌پی۴
    سرچاپ ساکس.کد خطای کلی، ساکس.کد غیرمجاز، ساکس.ساکس۴ای
پایان
