// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        data := تی سی پی.خواندن(c، 4096)
        اگر data.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(c، data)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            بشکن
        پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    listener := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، listener.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(listener)
پایان

تابع say(label: رشته، r: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد + " " + r.خطا
پایان

تابع ریشه:
    echo := start_echo()
    ناپایا server_cfg := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(server_cfg، درست)
    server := ساکس.شروع(server_cfg)
    سرچاپ "server up:"، server.موفق

    client := ساکس.کلاینت جدید("127.0.0.1"، server.درگاه)
    سرچاپ client.نسخه برابر ساکس.ساکس۵، client.مهلت میلی‌ثانیه، client.امن
    r := ساکس.اتصال(client، "127.0.0.1"، echo)
    say("connect"، r)
    r.جریان.نوشتن("hello through socks5")
    سرچاپ r.جریان.خواندن(100)
    r.جریان.بستن()

    by_name := ساکس.اتصال(client، "localhost"، echo)
    by_name.جریان.نوشتن("by name")
    سرچاپ by_name.جریان.خواندن(100)
    by_name.جریان.بستن()

    conn := ساکس.شماره‌گیری اتصال(client، "127.0.0.1"، echo)
    تی سی پی.نوشتن(conn، "plain tcp conn")
    سرچاپ تی سی پی.خواندن(conn، 100)
    تی سی پی.بستن(conn)

    say("refused"، ساکس.اتصال(client، "127.0.0.1"، تی سی پی.درگاه آزاد()))
    say("no such host"، ساکس.اتصال(client، "no-such-host.invalid"، 80))
    ساکس.توقف(server)
پایان
