// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع echo_conn(arg: صحیح۶۴):
    نویسه := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        داده := تی سی پی.خواندن(نویسه، 4096)
        اگر داده.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(نویسه، داده)
    پایان
    تی سی پی.بستن(نویسه)
پایان

تابع echo_accept(arg: صحیح۶۴):
    کارساز2 := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        اگر وارونه تی سی پی.اتصال معتبر(نویسه):
            بشکن
        پایان
        ساکس.برو(echo_conn، نویسه.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    شنونده := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، شنونده.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(شنونده)
پایان

تابع say(label: رشته، خوانده: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + خوانده.موفق + " code=" + خوانده.کد + " " + خوانده.خطا
پایان

تابع ریشه:
    متغیر_echo := start_echo()
    ناپایا پیکربندی_کارساز := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(پیکربندی_کارساز، درست)
    کارساز := ساکس.شروع(پیکربندی_کارساز)
    سرچاپ "server up:"، کارساز.موفق

    کارخواه := ساکس.کلاینت جدید("127.0.0.1"، کارساز.درگاه)
    سرچاپ کارخواه.نسخه برابر ساکس.ساکس۵، کارخواه.مهلت میلی‌ثانیه، کارخواه.امن
    خوانده := ساکس.اتصال(کارخواه، "127.0.0.1"، متغیر_echo)
    say("connect"، خوانده)
    خوانده.جریان.نوشتن("hello through socks5")
    سرچاپ خوانده.جریان.خواندن(100)
    خوانده.جریان.بستن()

    متغیر_by_name := ساکس.اتصال(کارخواه، "localhost"، متغیر_echo)
    متغیر_by_name.جریان.نوشتن("by name")
    سرچاپ متغیر_by_name.جریان.خواندن(100)
    متغیر_by_name.جریان.بستن()

    اتصال := ساکس.شماره‌گیری اتصال(کارخواه، "127.0.0.1"، متغیر_echo)
    تی سی پی.نوشتن(اتصال، "plain tcp conn")
    سرچاپ تی سی پی.خواندن(اتصال، 100)
    تی سی پی.بستن(اتصال)

    say("refused"، ساکس.اتصال(کارخواه، "127.0.0.1"، تی سی پی.درگاه آزاد()))
    say("no such host"، ساکس.اتصال(کارخواه، "no-such-host.invalid"، 80))
    ساکس.توقف(کارساز)
پایان
