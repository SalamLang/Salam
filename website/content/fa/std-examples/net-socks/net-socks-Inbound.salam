// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

تابع echo_conn(arg: صحیح۶۴):
    نویسه := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        داده := تی سی پی.خواندن(نویسه، 4096)
        اگر داده.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(نویسه، داده)
    پایان
    تی سی پی.بستن(نویسه)
پایان

تابع echo_accept(arg: صحیح۶۴):
    کارساز := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        اگر وارونه تی سی پی.اتصال معتبر(نویسه):
            بشکن
        پایان
        ساکس.برو(echo_conn، نویسه.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    شنونده := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، شنونده.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(شنونده)
پایان

تابع ریشه:
    متغیر_echo := start_echo()
    ناپایا پیکربندی := ساکس.پیکربندی سرور جدید(0)
    ساکس.افزودن کاربر(پیکربندی، "u"، "p")
    متغیر_mixed_config := ساکس.پیکربندی سرور جدید(0)

    ناپایا ترکیبی := تونل.ترکیبی جدید()
    تونل.تنظیم ساکس۵ ترکیبی(ترکیبی، ساکس.ورودی جدید(پیکربندی))
    تونل.تنظیم ساکس۴ ترکیبی(ترکیبی، ساکس.ورودی جدید ساکس۴(متغیر_mixed_config))
    سرچاپ ساکس.ورودی جدید(پیکربندی).نام()، ساکس.ورودی جدید ساکس۴(متغیر_mixed_config).نام()

    پیشرو := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، ترکیبی)
    ورودی_شبکه := تونل.شنود تی سی پی(0)
    تونل.سرویس‌دهی پس‌زمینه(ورودی_شبکه، ترکیبی، پیشرو)

    متغیر_five := ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، ورودی_شبکه.درگاه، "u"، "p")، "127.0.0.1"، متغیر_echo)
    متغیر_five.جریان.نوشتن("five")
    سرچاپ متغیر_five.موفق، متغیر_five.جریان.خواندن(100)
    متغیر_five.جریان.بستن()
    سرچاپ "wrong password:"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، ورودی_شبکه.درگاه، "u"، "x")، "127.0.0.1"، متغیر_echo).موفق

    ناپایا متغیر_four := ساکس.کلاینت جدید("127.0.0.1"، ورودی_شبکه.درگاه)
    متغیر_four.نسخه = ساکس.ساکس۴
    سرچاپ "socks4 with auth required:"، ساکس.اتصال(متغیر_four، "127.0.0.1"، متغیر_echo).کد
    ورودی_شبکه.توقف()

    شنونده := تی سی پی.پیوند(0)
    درگاه := تی سی پی.درگاه(شنونده)
    ساکس.برو(serve_once، شنونده.توصیفگر برگردان تهی*)
    متغیر_direct := ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، درگاه)، "127.0.0.1"، متغیر_echo)
    متغیر_direct.جریان.نوشتن("handled by hand")
    سرچاپ متغیر_direct.جریان.خواندن(100)
    متغیر_direct.جریان.بستن()
پایان

تابع serve_once(arg: صحیح۶۴):
    شنونده := تی سی پی.سرور { توصیفگر = arg }
    نویسه := تی سی پی.پذیرش(شنونده)
    ساکس.رسیدگی(ساکس.پیکربندی سرور جدید(0)، تونل.پوشاندن تی سی پی(نویسه))
پایان
