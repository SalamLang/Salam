// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        data := تی سی پی.خواندن(c، 4096)
        اگر data.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(c، data)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            بشکن
        پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    listener := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، listener.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(listener)
پایان

تابع ریشه:
    echo := start_echo()
    ناپایا config := ساکس.پیکربندی سرور جدید(0)
    ساکس.افزودن کاربر(config، "u"، "p")
    mixed_config := ساکس.پیکربندی سرور جدید(0)

    ناپایا mixed := تونل.ترکیبی جدید()
    تونل.تنظیم ساکس۵ ترکیبی(mixed، ساکس.ورودی جدید(config))
    تونل.تنظیم ساکس۴ ترکیبی(mixed، ساکس.ورودی جدید ساکس۴(mixed_config))
    سرچاپ ساکس.ورودی جدید(config).نام()، ساکس.ورودی جدید ساکس۴(mixed_config).نام()

    forward := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، mixed)
    inbound := تونل.شنود تی سی پی(0)
    تونل.سرویس‌دهی پس‌زمینه(inbound، mixed، forward)

    five := ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، inbound.درگاه، "u"، "p")، "127.0.0.1"، echo)
    five.جریان.نوشتن("five")
    سرچاپ five.موفق، five.جریان.خواندن(100)
    five.جریان.بستن()
    سرچاپ "wrong password:"، ساکس.اتصال(ساکس.کلاینت جدید با احراز هویت("127.0.0.1"، inbound.درگاه، "u"، "x")، "127.0.0.1"، echo).موفق

    ناپایا four := ساکس.کلاینت جدید("127.0.0.1"، inbound.درگاه)
    four.نسخه = ساکس.ساکس۴
    سرچاپ "socks4 with auth required:"، ساکس.اتصال(four، "127.0.0.1"، echo).کد
    inbound.توقف()

    listener := تی سی پی.پیوند(0)
    port := تی سی پی.درگاه(listener)
    ساکس.برو(serve_once، listener.توصیفگر برگردان تهی*)
    direct := ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، port)، "127.0.0.1"، echo)
    direct.جریان.نوشتن("handled by hand")
    سرچاپ direct.جریان.خواندن(100)
    direct.جریان.بستن()
پایان

تابع serve_once(arg: صحیح۶۴):
    listener := تی سی پی.سرور { توصیفگر = arg }
    c := تی سی پی.پذیرش(listener)
    ساکس.رسیدگی(ساکس.پیکربندی سرور جدید(0)، تونل.پوشاندن تی سی پی(c))
پایان
