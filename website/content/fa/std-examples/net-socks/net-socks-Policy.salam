// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

تابع echo_conn(arg: صحیح۶۴):
    نویسه := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        داده := تی سی پی.خواندن(نویسه، 4096)
        اگر داده.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(نویسه، داده)
    پایان
    تی سی پی.بستن(نویسه)
پایان

تابع echo_accept(arg: صحیح۶۴):
    کارساز := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        اگر وارونه تی سی پی.اتصال معتبر(نویسه):
            بشکن
        پایان
        ساکس.برو(echo_conn، نویسه.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    شنونده := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، شنونده.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(شنونده)
پایان

تابع say(label: رشته، r: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد + " " + r.خطا
پایان

تابع ریشه:
    متغیر_echo := start_echo()

    ناپایا متغیر_routed := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(متغیر_routed، درست)
    ساکس.تعیین اتصال به مقصد(متغیر_routed، (host: رشته، _port: صحیح): اگر host برابر "echo.internal": برگشت ساکس.اتصال مستقیم("127.0.0.1"، متغیر_echo، 2000) پایان برگشت ساکس.خروجی { موفق = نادرست، کد = ساکس.کد شبکه در دسترس نیست، خطا = "no route" } پایان)
    متغیر_routed_server := ساکس.شروع(متغیر_routed)
    کارخواه := ساکس.کلاینت جدید("127.0.0.1"، متغیر_routed_server.درگاه)
    say("known name"، ساکس.اتصال(کارخواه، "echo.internal"، 1))
    say("unknown name"، ساکس.اتصال(کارخواه، "other.internal"، 1))
    ساکس.توقف(متغیر_routed_server)

    ناپایا متغیر_acl := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(متغیر_acl، درست)
    متغیر_acl.اجازه = (cmd: صحیح، _host: رشته، port: صحیح): برگشت وارونه (cmd برابر ساکس.فرمان اتصال و port برابر 25) پایان
    متغیر_acl_server := ساکس.شروع(متغیر_acl)
    متغیر_acl_client := ساکس.کلاینت جدید("127.0.0.1"، متغیر_acl_server.درگاه)
    say("allowed"، ساکس.اتصال(متغیر_acl_client، "127.0.0.1"، متغیر_echo))
    say("port 25"، ساکس.اتصال(متغیر_acl_client، "127.0.0.1"، 25))
    ساکس.توقف(متغیر_acl_server)

    ناپایا متغیر_blocked := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(متغیر_blocked، درست)
    ساکس.تعیین شماره‌گیر(متغیر_blocked، تونل.مسدود())
    متغیر_blocked_server := ساکس.شروع(متغیر_blocked)
    say("block dialer"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، متغیر_blocked_server.درگاه)، "127.0.0.1"، متغیر_echo))
    ساکس.توقف(متغیر_blocked_server)

    ناپایا متغیر_direct := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(متغیر_direct، درست)
    ساکس.تعیین شماره‌گیر(متغیر_direct، تونل.مستقیم())
    متغیر_direct_server := ساکس.شروع(متغیر_direct)
    say("direct dialer"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، متغیر_direct_server.درگاه)، "127.0.0.1"، متغیر_echo))
    ساکس.توقف(متغیر_direct_server)
پایان
