// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        data := تی سی پی.خواندن(c، 4096)
        اگر data.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(c، data)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            بشکن
        پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    listener := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، listener.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(listener)
پایان

تابع say(label: رشته، r: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد + " " + r.خطا
پایان

تابع ریشه:
    echo := start_echo()

    ناپایا routed := ساکس.پیکربندی سرور جدید(0)
    ساکس.تعیین اتصال به مقصد(routed، (host: رشته، _port: صحیح): اگر host برابر "echo.internal": برگشت ساکس.اتصال مستقیم("127.0.0.1"، echo، 2000) پایان برگشت ساکس.خروجی { موفق = نادرست، کد = ساکس.کد شبکه در دسترس نیست، خطا = "no route" } پایان)
    routed_server := ساکس.شروع(routed)
    client := ساکس.کلاینت جدید("127.0.0.1"، routed_server.درگاه)
    say("known name"، ساکس.اتصال(client، "echo.internal"، 1))
    say("unknown name"، ساکس.اتصال(client، "other.internal"، 1))
    ساکس.توقف(routed_server)

    ناپایا acl := ساکس.پیکربندی سرور جدید(0)
    acl.اجازه = (cmd: صحیح، _host: رشته، port: صحیح): برگشت وارونه (cmd برابر ساکس.فرمان اتصال و port برابر 25) پایان
    acl_server := ساکس.شروع(acl)
    acl_client := ساکس.کلاینت جدید("127.0.0.1"، acl_server.درگاه)
    say("allowed"، ساکس.اتصال(acl_client، "127.0.0.1"، echo))
    say("port 25"، ساکس.اتصال(acl_client، "127.0.0.1"، 25))
    ساکس.توقف(acl_server)

    ناپایا blocked := ساکس.پیکربندی سرور جدید(0)
    ساکس.تعیین شماره‌گیر(blocked، تونل.مسدود())
    blocked_server := ساکس.شروع(blocked)
    say("block dialer"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، blocked_server.درگاه)، "127.0.0.1"، echo))
    ساکس.توقف(blocked_server)

    ناپایا direct := ساکس.پیکربندی سرور جدید(0)
    ساکس.تعیین شماره‌گیر(direct، تونل.مستقیم())
    direct_server := ساکس.شروع(direct)
    say("direct dialer"، ساکس.اتصال(ساکس.کلاینت جدید("127.0.0.1"، direct_server.درگاه)، "127.0.0.1"، echo))
    ساکس.توقف(direct_server)
پایان
