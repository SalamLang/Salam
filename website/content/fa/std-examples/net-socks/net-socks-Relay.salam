// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تونل
واردسازی استخر

تابع job(a: پویا تونل.جریان، b: پویا تونل.جریان):
    stats := ساکس.رله(a، b، 2000)
    سرچاپ "relayed"، stats.از اول به دوم، stats.از دوم به اول
پایان

تابع ریشه:
    near := تونل.لوله جدید()
    far := تونل.لوله جدید()
    client := تونل.سر اول لوله(near)
    left := تونل.سر دوم لوله(near)
    right := تونل.سر اول لوله(far)
    server := تونل.سر دوم لوله(far)

    workers := استخر.جدید کشسان(1 برگردان صحیح۶۴، 2 برگردان صحیح۶۴، 2 برگردان صحیح۶۴)
    استخر.ارسال(workers، (): job(left، right) پایان)
    client.نوشتن("hello")
    سرچاپ server.خواندن(100)
    server.نوشتن("world!")
    سرچاپ client.خواندن(100)
    client.بستن()
    استخر.انتظار(workers)
    استخر.توقف(workers)
پایان
