// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع echo_conn(arg: صحیح۶۴):
    c := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        data := تی سی پی.خواندن(c، 4096)
        اگر data.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(c، data)
    پایان
    تی سی پی.بستن(c)
پایان

تابع echo_accept(arg: صحیح۶۴):
    srv := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        c := تی سی پی.پذیرش(srv)
        اگر وارونه تی سی پی.اتصال معتبر(c):
            بشکن
        پایان
        ساکس.برو(echo_conn، c.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    listener := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، listener.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(listener)
پایان

تابع say(label: رشته، r: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + r.موفق + " code=" + r.کد + " " + r.خطا
پایان

تابع ریشه:
    echo := start_echo()
    server := ساکس.شروع(ساکس.پیکربندی سرور جدید(0))

    ناپایا client := ساکس.کلاینت جدید("127.0.0.1"، server.درگاه)
    client.نسخه = ساکس.ساکس۴
    r := ساکس.اتصال(client، "127.0.0.1"، echo)
    say("socks4 by address"، r)
    r.جریان.نوشتن("four")
    سرچاپ r.جریان.خواندن(100)
    r.جریان.بستن()

    client.نسخه = ساکس.ساکس۴ای
    client.نام کاربری = "tester"
    named := ساکس.اتصال(client، "localhost"، echo)
    say("socks4a by name"، named)
    named.جریان.بستن()
    say("socks4 refused"، ساکس.اتصال(client، "127.0.0.1"، تی سی پی.درگاه آزاد()))
    ساکس.توقف(server)

    ناپایا config := ساکس.پیکربندی سرور جدید(0)
    config.اجازه ساکس۴ = نادرست
    off := ساکس.شروع(config)
    ناپایا four := ساکس.کلاینت جدید("127.0.0.1"، off.درگاه)
    four.نسخه = ساکس.ساکس۴
    سرچاپ "socks4 switched off:"، ساکس.اتصال(four، "127.0.0.1"، echo).موفق
    ساکس.توقف(off)
پایان
