// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی

تابع echo_conn(arg: صحیح۶۴):
    نویسه := تی سی پی.اتصال از توصیف‌گر(arg)
    تا درست:
        داده := تی سی پی.خواندن(نویسه، 4096)
        اگر داده.طول() برابر 0:
            بشکن
        پایان
        تی سی پی.نوشتن(نویسه، داده)
    پایان
    تی سی پی.بستن(نویسه)
پایان

تابع echo_accept(arg: صحیح۶۴):
    کارساز2 := تی سی پی.سرور { توصیفگر = arg }
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        اگر وارونه تی سی پی.اتصال معتبر(نویسه):
            بشکن
        پایان
        ساکس.برو(echo_conn، نویسه.توصیفگر برگردان تهی*)
    پایان
پایان

تابع start_echo(): صحیح:
    شنونده := تی سی پی.پیوند(0)
    ساکس.برو(echo_accept، شنونده.توصیفگر برگردان تهی*)
    برگشت تی سی پی.درگاه(شنونده)
پایان

تابع say(label: رشته، خوانده: ساکس.نتیجه اتصال):
    سرچاپ label + ": ok=" + خوانده.موفق + " code=" + خوانده.کد + " " + خوانده.خطا
پایان

تابع ریشه:
    متغیر_echo := start_echo()
    ناپایا پیکربندی_کارساز := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(پیکربندی_کارساز، درست)
    کارساز := ساکس.شروع(پیکربندی_کارساز)

    ناپایا کارخواه := ساکس.کلاینت جدید("127.0.0.1"، کارساز.درگاه)
    کارخواه.نسخه = ساکس.ساکس۴
    خوانده := ساکس.اتصال(کارخواه، "127.0.0.1"، متغیر_echo)
    say("socks4 by address"، خوانده)
    خوانده.جریان.نوشتن("four")
    سرچاپ خوانده.جریان.خواندن(100)
    خوانده.جریان.بستن()

    کارخواه.نسخه = ساکس.ساکس۴ای
    کارخواه.نام کاربری = "tester"
    متغیر_named := ساکس.اتصال(کارخواه، "localhost"، متغیر_echo)
    say("socks4a by name"، متغیر_named)
    متغیر_named.جریان.بستن()
    say("socks4 refused"، ساکس.اتصال(کارخواه، "127.0.0.1"، تی سی پی.درگاه آزاد()))
    ساکس.توقف(کارساز)

    ناپایا پیکربندی := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    پیکربندی.اجازه ساکس۴ = نادرست
    متغیر_off := ساکس.شروع(پیکربندی)
    ناپایا متغیر_four := ساکس.کلاینت جدید("127.0.0.1"، متغیر_off.درگاه)
    متغیر_four.نسخه = ساکس.ساکس۴
    سرچاپ "socks4 switched off:"، ساکس.اتصال(متغیر_four، "127.0.0.1"، متغیر_echo).موفق
    ساکس.توقف(متغیر_off)
پایان
