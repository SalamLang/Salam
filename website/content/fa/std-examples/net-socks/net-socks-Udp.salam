// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.ساکس
واردسازی شبکه.یو دی پی
واردسازی رشته

تابع udp_echo(arg: صحیح۶۴):
    s := یو دی پی.سوکت یو دی پی { توصیفگر = arg }
    buf := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    تا درست:
        ناپایا host := ""
        ناپایا port := 0
        n := یو دی پی.دریافت بایت(s، buf، 2048، host، port)
        اگر n کوچکتر 0:
            بشکن
        پایان
        یو دی پی.ارسال بایت(s، host، port، buf، n)
    پایان
پایان

تابع ریشه:
    echo := یو دی پی.پیوند(0)
    echo_port := یو دی پی.درگاه(echo)
    ساکس.برو(udp_echo، echo.توصیفگر برگردان تهی*)

    server := ساکس.شروع(ساکس.پیکربندی سرور جدید(0))
    client := ساکس.کلاینت جدید("127.0.0.1"، server.درگاه)
    session := ساکس.ایجاد نشست یو دی پی(client)
    سرچاپ "associated:"، session.موفق، session.میزبان رله
    ساکس.تنظیم مهلت یو دی پی(session، 2000)
    سرچاپ "sent:"، ساکس.ارسال یو دی پی(session، "127.0.0.1"، echo_port، "datagram one")

    buf := حافظه.تخصیص(1024 برگردان طبیعی۶۴)
    ناپایا from := ساکس.نشانی {}
    n := ساکس.دریافت بایت یو دی پی(session، buf، 1024، from)
    سرچاپ "received:"، n، "from"، from.میزبان، from.درگاه برابر echo_port
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    سرچاپ رشته.رونوشت(buf برگردان رشته)
    سرچاپ "bytes sent:"، ساکس.ارسال بایت یو دی پی(session، "127.0.0.1"، echo_port، "raw" برگردان تهی*، 3)
    حافظه.آزادسازی(buf)
    ساکس.بستن نشست یو دی پی(session)

    ناپایا four := ساکس.کلاینت جدید("127.0.0.1"، server.درگاه)
    four.نسخه = ساکس.ساکس۴
    سرچاپ "socks4 has no udp:"، ساکس.ایجاد نشست یو دی پی(four).موفق
    ساکس.توقف(server)
پایان
