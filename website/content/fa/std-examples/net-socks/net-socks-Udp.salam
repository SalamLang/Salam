// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.ساکس
واردسازی شبکه.یو دی پی
واردسازی رشته

تابع udp_echo(arg: صحیح۶۴):
    متن_نمونه := یو دی پی.سوکت یو دی پی { توصیفگر = arg }
    بافر := حافظه.تخصیص(2048 برگردان طبیعی۶۴)
    تا درست:
        ناپایا میزبان := ""
        ناپایا درگاه := 0
        تعداد := یو دی پی.دریافت بایت(متن_نمونه، بافر، 2048، میزبان، درگاه)
        اگر تعداد کوچکتر 0:
            بشکن
        پایان
        یو دی پی.ارسال بایت(متن_نمونه، میزبان، درگاه، بافر، تعداد)
    پایان
پایان

تابع ریشه:
    متغیر_echo := یو دی پی.پیوند(0)
    درگاه_پژواک := یو دی پی.درگاه(متغیر_echo)
    ساکس.برو(udp_echo، متغیر_echo.توصیفگر برگردان تهی*)

    ناپایا پیکربندی_کارساز := ساکس.پیکربندی سرور جدید(0)
    ساکس.اجازه آدرس‌های خصوصی(پیکربندی_کارساز، درست)
    کارساز := ساکس.شروع(پیکربندی_کارساز)
    کارخواه := ساکس.کلاینت جدید("127.0.0.1"، کارساز.درگاه)
    متغیر_session := ساکس.ایجاد نشست یو دی پی(کارخواه)
    سرچاپ "associated:"، متغیر_session.موفق، متغیر_session.میزبان رله
    ساکس.تنظیم مهلت یو دی پی(متغیر_session، 2000)
    سرچاپ "sent:"، ساکس.ارسال یو دی پی(متغیر_session، "127.0.0.1"، درگاه_پژواک، "datagram one")

    بافر := حافظه.تخصیص(1024 برگردان طبیعی۶۴)
    ناپایا متغیر_from := ساکس.نشانی {}
    تعداد := ساکس.دریافت بایت یو دی پی(متغیر_session، بافر، 1024، متغیر_from)
    سرچاپ "received:"، تعداد، "from"، متغیر_from.میزبان، متغیر_from.درگاه برابر درگاه_پژواک
    (بافر برگردان طبیعی۸*)[تعداد] = 0 برگردان طبیعی۸
    سرچاپ رشته.رونوشت(بافر برگردان رشته)
    سرچاپ "bytes sent:"، ساکس.ارسال بایت یو دی پی(متغیر_session، "127.0.0.1"، درگاه_پژواک، "raw" برگردان تهی*، 3)
    حافظه.آزادسازی(بافر)
    ساکس.بستن نشست یو دی پی(متغیر_session)

    ناپایا متغیر_four := ساکس.کلاینت جدید("127.0.0.1"، کارساز.درگاه)
    متغیر_four.نسخه = ساکس.ساکس۴
    سرچاپ "socks4 has no udp:"، ساکس.ایجاد نشست یو دی پی(متغیر_four).موفق
    ساکس.توقف(کارساز)
پایان
