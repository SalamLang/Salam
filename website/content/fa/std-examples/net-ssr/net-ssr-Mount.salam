واردسازی شبکه.مسیریاب
واردسازی شبکه.رندر‌سرور

تابع هیللو(ک: صحیح۶۴):
    رندر‌سرور.پاسخ موفق(ک، "{\"greeting\":\"salam\"}")
پایان

تابع صفحه(ک: صحیح۶۴):
    رندر‌سرور.پاسخ صفحه(ک، 200، "<h1>" + رندر‌سرور.مسیر صفحه(ک) + "</h1>"، "")
پایان

تابع ریشه:
    رندر‌سرور.تنظیم راز("a-secret-with-enough-length")
    رندر‌سرور.تنظیم حداکثر بدنه(2048)
    رندر‌سرور.تنظیم عمر توکن(600)
    رندر‌سرور.تنظیم پوشه ایستا("public")
    رندر‌سرور.تنظیم رندر(صفحه)
    رندر‌سرور.ثبت کارکرد("Hello"، هیللو)
    کنوون := رندر‌سرور.ثبت شده("Hello")
    ونکنوون := رندر‌سرور.ثبت شده("Other")
    سرچاپ کنوون، ونکنوون
    ناپایا ر := مسیریاب.مسیریاب جدید()
    رندر‌سرور.نصب(ر)
    اول := ر.مسیرها[0]
    سرچاپ ر.مسیرها.طول()، اول.روش، اول.الگو
    توکین := رندر‌سرور.توکن جدید()
    گوود := رندر‌سرور.بررسی توکن(توکین)
    باد := رندر‌سرور.بررسی توکن(توکین + "x")
    سرچاپ گوود، باد
    اکنون := رندر‌سرور.درخواست جاری()
    ینسیدی := رندر‌سرور.معتبر(اکنون)
    روش := رندر‌سرور.روش(اکنون)
    سرچاپ ینسیدی، روش برابر ""
    وپتس := رندر‌سرور.گزینه های بیرونی()
    زمان := وپتس.میلی‌ثانیه‌زمان‌انتظار
    سقف := وپتس.حداکثر‌بدنه
    تغییر := وپتس.حداکثر‌تغییرمسیر
    سرچاپ زمان، سقف، تغییر
پایان
