// زبان: فارسی
واردسازی شبکه.تی سی پی

تابع ریشه:
    کارساز := تی سی پی.پیوند روی("127.0.0.1"، 0)
    سرچاپ تی سی پی.معتبر(کارساز)
    درگاه := تی سی پی.درگاه(کارساز)
    سرچاپ درگاه بزرگتر 0
    کارخواه := تی سی پی.شماره گیری("127.0.0.1"، درگاه)
    سرچاپ تی سی پی.اتصال معتبر(کارخواه)
    تی سی پی.بستن(کارخواه)
    تی سی پی.بستن سرور(کارساز)
پایان
