// زبان: فارسی
واردسازی شبکه.تی سی پی

تابع ریشه:
    server := تی سی پی.پیوند روی("127.0.0.1"، 0)
    سرچاپ تی سی پی.معتبر(server)
    port := تی سی پی.درگاه(server)
    سرچاپ port بزرگتر 0
    client := تی سی پی.شماره گیری("127.0.0.1"، port)
    سرچاپ تی سی پی.اتصال معتبر(client)
    تی سی پی.بستن(client)
    تی سی پی.بستن سرور(server)
پایان
