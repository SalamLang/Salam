واردسازی شبکه.تی سی پی شبکه
واردسازی حافظه

ناپایا سرور := تی سی پی شبکه.سرور {}

روال پاسخ‌گو():
    ا := تی سی پی شبکه.پذیرش(سرور)
    تی سی پی شبکه.تنظیم مهلت خواندن(ا، ۲۰۰۰)
    تی سی پی شبکه.تنظیم مهلت نوشتن(ا، ۲۰۰۰)
    _ := تی سی پی شبکه.خواندن(ا، ۱۰۲۴)
    تی سی پی شبکه.نوشتن اچ تی تی پی(ا، "200 OK"، "text/plain"، "سلام")
    تی سی پی شبکه.بستن(ا)
پایان

روال ریشه:
    سرور = تی سی پی شبکه.پیوند(۰)
    ن := spawn(پاسخ‌گو)
    ا := تی سی پی شبکه.شماره گیری("127.0.0.1"، تی سی پی شبکه.درگاه(سرور))
    درخواست := "GET / HTTP/1.0\r\n\r\n"
    سرچاپ تی سی پی شبکه.نوشتن بایت(ا، درخواست برگردان تهی*، درخواست.طول())
    ب := حافظه.تخصیص صفرشده(۲۵۶ برگردان طبیعی۶۴)
    ناپایا جمع := ۰
    تا درست:
        ر := تی سی پی شبکه.خواندن بایت(ا، ب، ۲۵۵)
        اگر ر <= ۰:
            بشکن
        پایان
        جمع += ر
    پایان
    سرچاپ جمع > ۰
    دوباره := تی سی پی شبکه.اتصال از توصیف‌گر(ا.fd)
    سرچاپ دوباره.fd == ا.fd
    تی سی پی شبکه.بستن(ا)
    join(ن)
    تی سی پی شبکه.بستن سرور(سرور)
    حافظه.آزادسازی(ب)
پایان
