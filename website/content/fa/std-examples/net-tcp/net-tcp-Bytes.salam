واردسازی شبکه.تی سی پی
واردسازی حافظه

ناپایا سرور := تی سی پی.سرور {}

روال پاسخ‌گو():
    ا := تی سی پی.پذیرش(سرور)
    تی سی پی.تنظیم مهلت خواندن(ا، ۲۰۰۰)
    تی سی پی.تنظیم مهلت نوشتن(ا، ۲۰۰۰)
    _ := تی سی پی.خواندن(ا، ۱۰۲۴)
    تی سی پی.نوشتن اچ تی تی پی(ا، "200 OK"، "text/plain"، "سلام")
    تی سی پی.بستن(ا)
پایان

روال ریشه:
    سرور = تی سی پی.پیوند(۰)
    ن := نخ‌ساز(پاسخ‌گو)
    ا := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(سرور))
    درخواست := "GET / HTTP/1.0\r\n\r\n"
    سرچاپ تی سی پی.نوشتن بایت(ا، درخواست برگردان تهی*، درخواست.طول())
    ب := حافظه.تخصیص صفرشده(۲۵۶ برگردان طبیعی۶۴)
    ناپایا جمع := ۰
    تا درست:
        ر := تی سی پی.خواندن بایت(ا، ب، ۲۵۵)
        اگر ر <= ۰:
            بشکن
        پایان
        جمع += ر
    پایان
    سرچاپ جمع > ۰
    دوباره := تی سی پی.اتصال از توصیف‌گر(ا.fd)
    سرچاپ دوباره.fd == ا.fd
    تی سی پی.بستن(ا)
    نخ‌پیوند(ن)
    تی سی پی.بستن سرور(سرور)
    حافظه.آزادسازی(ب)
پایان
