واردسازی شبکه.تی سی پی

ناپایا سرور := تی سی پی.سرور {}

تابع پاسخ‌گو():
    ا := تی سی پی.پذیرش(سرور)
    پیام := تی سی پی.خواندن(ا، ۱۰۲۴)
    _ := تی سی پی.نوشتن(ا، "پژواک: " + پیام)
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    سرور = تی سی پی.پیوند(۰)
    سرچاپ تی سی پی.معتبر(سرور)، تی سی پی.درگاه(سرور) > ۰
    ن := نخ‌ساز(پاسخ‌گو)
    ا := تی سی پی.شماره گیری("127.0.0.1"، تی سی پی.درگاه(سرور))
    سرچاپ تی سی پی.اتصال معتبر(ا)
    تی سی پی.تنظیم مهلت(ا، ۲۰۰۰)
    تی سی پی.تنظیم زنده‌نگه‌داری(ا، درست)
    تی سی پی.غیرفعال‌سازی نگل(ا، درست)
    سرچاپ تی سی پی.نوشتن(ا، "سلام")
    سرچاپ تی سی پی.خواندن(ا، ۱۰۲۴)
    تی سی پی.بستن(ا)
    نخ‌پیوند(ن)
    تی سی پی.بستن سرور(سرور)
    سرچاپ تی سی پی.اتصال معتبر(تی سی پی.شماره گیری("127.0.0.1"، ۱))
پایان
