واردسازی شبکه.تی سی پی شبکه

ناپایا سرور := تی سی پی شبکه.سرور {}

روال پاسخ‌گو():
    ا := تی سی پی شبکه.پذیرش(سرور)
    پیام := تی سی پی شبکه.خواندن(ا، ۱۰۲۴)
    _ := تی سی پی شبکه.نوشتن(ا، "پژواک: " + پیام)
    تی سی پی شبکه.بستن(ا)
پایان

روال ریشه:
    سرور = تی سی پی شبکه.پیوند(۰)
    سرچاپ تی سی پی شبکه.معتبر(سرور)، تی سی پی شبکه.درگاه(سرور) > ۰
    ن := spawn(پاسخ‌گو)
    ا := تی سی پی شبکه.شماره گیری("127.0.0.1"، تی سی پی شبکه.درگاه(سرور))
    سرچاپ تی سی پی شبکه.اتصال معتبر(ا)
    تی سی پی شبکه.تنظیم مهلت(ا، ۲۰۰۰)
    تی سی پی شبکه.تنظیم زنده‌نگه‌داری(ا، درست)
    تی سی پی شبکه.غیرفعال‌سازی نگل(ا، درست)
    سرچاپ تی سی پی شبکه.نوشتن(ا، "سلام")
    سرچاپ تی سی پی شبکه.خواندن(ا، ۱۰۲۴)
    تی سی پی شبکه.بستن(ا)
    join(ن)
    تی سی پی شبکه.بستن سرور(سرور)
    سرچاپ تی سی پی شبکه.اتصال معتبر(تی سی پی شبکه.شماره گیری("127.0.0.1"، ۱))
پایان
