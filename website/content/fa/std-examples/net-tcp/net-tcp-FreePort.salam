واردسازی شبکه.تی سی پی

ناپایا سرور := تی سی پی.سرور {}

تابع خدمت():
    ا := تی سی پی.پذیرش(سرور)
    تی سی پی.بستن(ا)
پایان

تابع ریشه:
    درگاه := تی سی پی.درگاه آزاد()
    سرچاپ درگاه > ۰
    سرچاپ تی سی پی.انتظار شنود("127.0.0.1"، درگاه، ۲۰۰)
    سرور = تی سی پی.پیوند(درگاه)
    سرچاپ تی سی پی.معتبر(سرور)
    ن := نخ‌ساز(خدمت)
    سرچاپ تی سی پی.انتظار شنود("127.0.0.1"، درگاه، ۲۰۰۰)
    نخ‌پیوند(ن)
    تی سی پی.بستن سرور(سرور)
پایان
