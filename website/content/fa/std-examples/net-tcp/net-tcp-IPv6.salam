// زبان: فارسی
واردسازی شبکه.تی سی پی

تابع ریشه:
    کارساز := تی سی پی.پیوند دوگانه(0)
    سرچاپ تی سی پی.معتبر(کارساز)، تی سی پی.نشانی سرور(کارساز)
    درگاه := تی سی پی.درگاه(کارساز)
    متغیر_six := تی سی پی.پیوند آی‌پی۶("::1"، 0، درست)
    سرچاپ تی سی پی.معتبر(متغیر_six)
    کارخواه := تی سی پی.شماره گیری("::1"، درگاه)
    سرچاپ تی سی پی.اتصال معتبر(کارخواه)
    سرچاپ تی سی پی.نشانی همتای اتصال(کارخواه)، تی سی پی.درگاه همتای اتصال(کارخواه) برابر درگاه
    سرچاپ تی سی پی.نشانی محلی اتصال(کارخواه)
    سرچاپ تی سی پی.ساخت نشانی میزبان درگاه("::1"، درگاه) برابر "[::1]:" + درگاه
    ناپایا متغیر_hosts := وکتور {} برگردان وکتور<رشته>
    متغیر_hosts.بیفزا("::1")
    متغیر_hosts.بیفزا("127.0.0.1")
    متغیر_racing := تی سی پی.شماره گیری چند نشانی با مهلت(متغیر_hosts، درگاه، 2000)
    سرچاپ تی سی پی.اتصال معتبر(متغیر_racing)
    تی سی پی.بستن(متغیر_racing)
    تی سی پی.بستن(کارخواه)
    تی سی پی.بیدار کردن سرور("::"، درگاه)
    تی سی پی.بستن سرور(متغیر_six)
    تی سی پی.بستن سرور(کارساز)
پایان
