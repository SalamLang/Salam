// زبان: فارسی
واردسازی شبکه.تی سی پی

تابع ریشه:
    server := تی سی پی.پیوند دوگانه(0)
    سرچاپ تی سی پی.معتبر(server)، تی سی پی.نشانی سرور(server)
    port := تی سی پی.درگاه(server)
    six := تی سی پی.پیوند آی‌پی۶("::1"، 0، درست)
    سرچاپ تی سی پی.معتبر(six)
    client := تی سی پی.شماره گیری("::1"، port)
    سرچاپ تی سی پی.اتصال معتبر(client)
    سرچاپ تی سی پی.نشانی همتای اتصال(client)، تی سی پی.درگاه همتای اتصال(client) برابر port
    سرچاپ تی سی پی.نشانی محلی اتصال(client)
    سرچاپ تی سی پی.ساخت نشانی میزبان درگاه("::1"، port) برابر "[::1]:" + port
    ناپایا hosts := وکتور {} برگردان وکتور<رشته>
    hosts.بیفزا("::1")
    hosts.بیفزا("127.0.0.1")
    racing := تی سی پی.شماره گیری چند نشانی با مهلت(hosts، port، 2000)
    سرچاپ تی سی پی.اتصال معتبر(racing)
    تی سی پی.بستن(racing)
    تی سی پی.بستن(client)
    تی سی پی.بیدار کردن سرور("::"، port)
    تی سی پی.بستن سرور(six)
    تی سی پی.بستن سرور(server)
پایان
