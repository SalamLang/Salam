واردسازی شبکه.تی سی پی

روال ریشه:
    س := تی سی پی.پیوند(۰)
    درگاه := تی سی پی.درگاه(س)
    ناپایا استخر := تی سی پی.استخر جدید()
    ا := تی سی پی.دریافت اتصال(استخر، "127.0.0.1"، درگاه، ۱۰۰۰)
    سرچاپ تی سی پی.اتصال معتبر(ا)، تی سی پی.تعداد استخر(استخر)
    تی سی پی.بازگرداندن اتصال(استخر، "127.0.0.1"، درگاه، ا، ۱۰۰۰)
    سرچاپ تی سی پی.تعداد استخر(استخر)
    دوباره := تی سی پی.دریافت اتصال(استخر، "127.0.0.1"، درگاه، ۲۰۰۰)
    سرچاپ دوباره.fd == ا.fd، تی سی پی.تعداد استخر(استخر)
    تی سی پی.بازگرداندن اتصال(استخر، "127.0.0.1"، درگاه، دوباره، ۲۰۰۰)
    تازه := تی سی پی.دریافت اتصال(استخر، "127.0.0.1"، درگاه، ۲۰۰۰ + استخر.idle_ttl_ms + ۱)
    سرچاپ تی سی پی.اتصال معتبر(تازه)، تی سی پی.تعداد استخر(استخر)
    تی سی پی.بستن(تازه)
    تی سی پی.بستن سرور(س)
پایان
