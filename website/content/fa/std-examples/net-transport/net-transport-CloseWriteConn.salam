// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع count_then_answer():
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا c := انتقال شبکه.پذیرش(l)
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    ناپایا total := 0
    ناپایا n := انتقال شبکه.خواندن(c، buf، 4096)
    تا n بزرگتر 0:
        total += n
        n = انتقال شبکه.خواندن(c، buf، 4096)
    پایان
    حافظه.آزادسازی(buf)
    ناپایا reply := انتقال شبکه.از رشته("سرور " + total + " بایت خواند")
    انتقال شبکه.ارسال بایت ها(c، reply)
    انتقال شبکه.آزادسازی بایت‌ها(reply)
    انتقال شبکه.خاموش کردن اتصال(c)
    انتقال شبکه.بستن(c)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(count_then_answer)
    همگام سازی.انتظار(ready)

    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {})
    اگر وارونه انتقال شبکه.معتبر(c):
        سرچاپ "شماره‌گیری شکست خورد:"، c.خطا
        برگشت
    پایان
    ناپایا msg := انتقال شبکه.از رشته("first part, second part")
    انتقال شبکه.ارسال بایت ها(c، msg)
    انتقال شبکه.آزادسازی بایت‌ها(msg)
    انتقال شبکه.بستن نوشتن اتصال(c)
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    n := انتقال شبکه.خواندن(c، buf، 4096)
    سرچاپ (buf برگردان رشته).زیررشته(0، n)
    سرچاپ "بعد"، انتقال شبکه.خواندن(c، buf، 4096)
    حافظه.آزادسازی(buf)
    انتقال شبکه.بستن(c)
    نخ‌پیوند(t)
پایان
