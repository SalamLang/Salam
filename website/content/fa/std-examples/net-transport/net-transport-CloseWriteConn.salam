// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه

ناپایا درگاه := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع count_then_answer():
    ال := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    درگاه = انتقال شبکه.درگاه شنونده(ال)
    همگام سازی.اتمام(آماده)
    ناپایا نویسه := انتقال شبکه.پذیرش(ال)
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    ناپایا مجموع := 0
    ناپایا تعداد := انتقال شبکه.خواندن(نویسه، بافر، 4096)
    تا تعداد بزرگتر 0:
        مجموع += تعداد
        تعداد = انتقال شبکه.خواندن(نویسه، بافر، 4096)
    پایان
    حافظه.آزادسازی(بافر)
    ناپایا پاسخ_فرآیند := انتقال شبکه.از رشته("سرور " + مجموع + " بایت خواند")
    انتقال شبکه.ارسال بایت ها(نویسه، پاسخ_فرآیند)
    انتقال شبکه.آزادسازی بایت‌ها(پاسخ_فرآیند)
    انتقال شبکه.خاموش کردن اتصال(نویسه)
    انتقال شبکه.بستن(نویسه)
    انتقال شبکه.بستن شنونده(ال)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(count_then_answer)
    همگام سازی.انتظار(آماده)

    ناپایا نویسه := انتقال شبکه.شماره گیری("127.0.0.1"، درگاه، انتقال شبکه.تنظیمات {})
    اگر وارونه انتقال شبکه.معتبر(نویسه):
        سرچاپ "شماره‌گیری شکست خورد:"، نویسه.خطا
        برگشت
    پایان
    ناپایا پیام := انتقال شبکه.از رشته("first part, second part")
    انتقال شبکه.ارسال بایت ها(نویسه، پیام)
    انتقال شبکه.آزادسازی بایت‌ها(پیام)
    انتقال شبکه.بستن نوشتن اتصال(نویسه)
    بافر := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    تعداد := انتقال شبکه.خواندن(نویسه، بافر، 4096)
    سرچاپ (بافر برگردان رشته).زیررشته(0، تعداد)
    سرچاپ "بعد"، انتقال شبکه.خواندن(نویسه، بافر، 4096)
    حافظه.آزادسازی(بافر)
    انتقال شبکه.بستن(نویسه)
    نخ‌پیوند(موقت)
پایان
