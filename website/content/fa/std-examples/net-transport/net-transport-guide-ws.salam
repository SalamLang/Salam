// زبان: فارسی
واردسازی حافظه
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا seen_path := ""
ناپایا seen_host := ""

تابع settings(): انتقال شبکه.تنظیمات:
    ناپایا s := انتقال شبکه.تنظیمات {}
    s.شبکه = "ws"
    s.مسیر = "/tunnel"
    s.سربرگ میزبان = "cdn.example.com"
    برگشت s
پایان

تابع worker():
    s := settings()
    l := انتقال شبکه.شنود(0، s)
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا c := انتقال شبکه.پذیرش خام(l)
    اگر انتقال شبکه.ارتقا(c، s):
        seen_path = c.مسیر درخواست
        seen_host = c.میزبان درخواست
        buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
        n := انتقال شبکه.خواندن(c، buf، 4096)
        انتقال شبکه.نوشتن(c، buf، n)
        حافظه.آزادسازی(buf)
    پایان
    انتقال شبکه.بستن(c)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(worker)
    همگام سازی.انتظار(ready)

    ناپایا c := انتقال شبکه.شماره گیری("127.0.0.1"، port، settings())
    ناپایا msg := انتقال شبکه.از رشته("inside a websocket")
    انتقال شبکه.ارسال بایت ها(c، msg)
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    n := انتقال شبکه.خواندن(c، buf، 4096)
    سرچاپ (buf برگردان رشته).زیررشته(0، n)
    حافظه.آزادسازی(buf)
    انتقال شبکه.آزادسازی بایت‌ها(msg)
    انتقال شبکه.بستن(c)
    نخ‌پیوند(t)
    سرچاپ "server saw path"، seen_path، "and host"، seen_host

    ناپایا wrong := settings()
    wrong.مسیر = "/other"
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t2 := نخ‌ساز(worker)
    همگام سازی.انتظار(ready)
    bad := انتقال شبکه.شماره گیری("127.0.0.1"، port، wrong)
    سرچاپ "wrong path accepted:"، انتقال شبکه.معتبر(bad)
    سرچاپ bad.خطا
    نخ‌پیوند(t2)
پایان
