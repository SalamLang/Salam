// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تروجان
واردسازی شبکه.تونل
واردسازی فشرده سازی

تابع text_of(p: تهی*، تعداد: صحیح): رشته:
    بافر := حافظه.تخصیص((تعداد + 1) برگردان طبیعی۶۴)
    حافظه.کپی(بافر، p، تعداد برگردان طبیعی۶۴)
    (بافر برگردان طبیعی۸*)[تعداد] = 0 برگردان طبیعی۸
    برگشت بافر برگردان رشته
پایان

تابع ریشه:
    گام := تروجان.اتصال‌دهنده جدید("vpn.example.com"، 443، "password")
    سرچاپ گام.نام()، گام.کارساز().میزبان، گام.کارساز().درگاه

    متغیر_pair := تونل.لوله جدید()
    سرچاپ گام.دست‌دهی(تونل.سر اول لوله(متغیر_pair)، تونل.نشانی جدید("example.com"، 443))
    ناپایا متغیر_expected := تروجان.کدگذاری درخواست("password"، تروجان.فرمان اتصال، "example.com"، 443)
    بافر := حافظه.تخصیص(256 برگردان طبیعی۶۴)
    تعداد := تونل.سر دوم لوله(متغیر_pair).خواندن بایت(بافر، 256)
    سرچاپ تعداد، تعداد برابر متغیر_expected.طول، text_of(بافر، تعداد) برابر text_of(متغیر_expected.داده، متغیر_expected.طول)

    ناپایا ورودی_شبکه := تروجان.پذیرنده جدید()
    تروجان.افزودن گذرواژه به پذیرنده(ورودی_شبکه، "password")
    تروجان.افزودن گذرواژه به پذیرنده(ورودی_شبکه، "other")
    سرچاپ ورودی_شبکه.نام()، ورودی_شبکه.درهم گذرواژه‌ها.طول()، ورودی_شبکه.شمار پاسخ‌ها

    متغیر_good := تونل.لوله جدید()
    تونل.سر دوم لوله(متغیر_good).نوشتن(text_of(متغیر_expected.داده، متغیر_expected.طول) + "payload")
    متغیر_session := ورودی_شبکه.دست‌دهی(تونل.سر اول لوله(متغیر_good))
    سرچاپ متغیر_session.موفق، متغیر_session.مقصد.میزبان، متغیر_session.مقصد.درگاه، متغیر_session.پروتکل، متغیر_session.فرمان، متغیر_session.داده آغازین

    وب_مقدار := تونل.لوله جدید()
    تونل.سر دوم لوله(وب_مقدار).نوشتن("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    غریبه := ورودی_شبکه.دست‌دهی(تونل.سر اول لوله(وب_مقدار))
    سرچاپ غریبه.موفق، غریبه.خطا، غریبه.داده آغازین.طول()

    نادرست := تروجان.کدگذاری درخواست("nope"، تروجان.فرمان اتصال، "example.com"، 443)
    بد := تونل.لوله جدید()
    تونل.سر دوم لوله(بد).نوشتن(text_of(نادرست.داده، نادرست.طول))
    متغیر_rejected := ورودی_شبکه.دست‌دهی(تونل.سر اول لوله(بد))
    سرچاپ متغیر_rejected.موفق، متغیر_rejected.داده آغازین.طول() برابر نادرست.طول
    ورودی_شبکه.پاسخ(تونل.سر اول لوله(بد)، متغیر_rejected، نادرست)

    ناپایا متغیر_chain := تونل.زنجیره جدید(تونل.مستقیم())
    تونل.افزودن گام(متغیر_chain، گام)
    سرچاپ متغیر_chain.نام()
    فشرده سازی.آزادسازی بافر(متغیر_expected)
پایان
