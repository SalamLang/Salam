// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تروجان
واردسازی شبکه.تونل
واردسازی فشرده سازی

تابع text_of(p: تهی*، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، p، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع ریشه:
    hop := تروجان.اتصال‌دهنده جدید("vpn.example.com"، 443، "password")
    سرچاپ hop.نام()، hop.کارساز().میزبان، hop.کارساز().درگاه

    pair := تونل.لوله جدید()
    سرچاپ hop.دست‌دهی(تونل.سر اول لوله(pair)، تونل.نشانی جدید("example.com"، 443))
    ناپایا expected := تروجان.کدگذاری درخواست("password"، تروجان.فرمان اتصال، "example.com"، 443)
    buf := حافظه.تخصیص(256 برگردان طبیعی۶۴)
    n := تونل.سر دوم لوله(pair).خواندن بایت(buf، 256)
    سرچاپ n، n برابر expected.طول، text_of(buf، n) برابر text_of(expected.داده، expected.طول)

    ناپایا inbound := تروجان.پذیرنده جدید()
    تروجان.افزودن گذرواژه به پذیرنده(inbound، "password")
    تروجان.افزودن گذرواژه به پذیرنده(inbound، "other")
    سرچاپ inbound.نام()، inbound.درهم گذرواژه‌ها.طول()، inbound.شمار پاسخ‌ها

    good := تونل.لوله جدید()
    تونل.سر دوم لوله(good).نوشتن(text_of(expected.داده، expected.طول) + "payload")
    session := inbound.دست‌دهی(تونل.سر اول لوله(good))
    سرچاپ session.موفق، session.مقصد.میزبان، session.مقصد.درگاه، session.پروتکل، session.فرمان، session.داده آغازین

    web := تونل.لوله جدید()
    تونل.سر دوم لوله(web).نوشتن("GET / HTTP/1.1\r\nHost: x\r\n\r\n")
    stranger := inbound.دست‌دهی(تونل.سر اول لوله(web))
    سرچاپ stranger.موفق، stranger.خطا، stranger.داده آغازین.طول()

    wrong := تروجان.کدگذاری درخواست("nope"، تروجان.فرمان اتصال، "example.com"، 443)
    bad := تونل.لوله جدید()
    تونل.سر دوم لوله(bad).نوشتن(text_of(wrong.داده، wrong.طول))
    rejected := inbound.دست‌دهی(تونل.سر اول لوله(bad))
    سرچاپ rejected.موفق، rejected.داده آغازین.طول() برابر wrong.طول
    inbound.پاسخ(تونل.سر اول لوله(bad)، rejected، نادرست)

    ناپایا chain := تونل.زنجیره جدید(تونل.مستقیم())
    تونل.افزودن گام(chain، hop)
    سرچاپ chain.نام()
    فشرده سازی.آزادسازی بافر(expected)
پایان
