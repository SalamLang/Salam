// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.تروجان
واردسازی همگام سازی

ناپایا echo_port := 0
ناپایا web_port := 0
ناپایا web_seen := ""
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع echo_server():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تا درست:
            data := تی سی پی.خواندن(c، 4096)
            اگر data.طول() برابر 0:
                بشکن
            پایان
            تی سی پی.نوشتن(c، "echo:" + data)
        پایان
        تی سی پی.بستن(c)
    پایان
پایان

تابع web_server():
    srv := تی سی پی.پیوند(0)
    web_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        web_seen = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: 12\r\nConnection: close\r\n\r\nhello probes")
        تی سی پی.بستن(c)
    پایان
پایان

تابع start_servers():
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _a := نخ‌ساز(echo_server)
    _b := نخ‌ساز(web_server)
    همگام سازی.انتظار(ready)
پایان

تابع text_of(p: تهی*، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، p، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع read_text(l &: تروجان.پیوند، want: صحیح): رشته:
    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(buf)
    ناپایا out := ""
    تا out.طول() کوچکتر want:
        n := تروجان.خواندن پیوند(l، buf، 8192)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        out = out + text_of(buf، n)
    پایان
    برگشت out
پایان

تابع ریشه:
    start_servers()

    ناپایا config := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.افزودن گذرواژه(config، "secret")
    تروجان.افزودن درهم گذرواژه(config، تروجان.درهم گذرواژه("second"))
    سرچاپ config.درهم گذرواژه‌ها.طول()، config.مهلت دست‌دهی
    server := تروجان.سرویس‌دهی بدون رمز(config، 0)
    سرچاپ "server up:"، server.معتبر، تروجان.درگاه کارساز(server) برابر server.درگاه

    ناپایا client := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، server.درگاه، "secret")
    client.با تی ال اس = نادرست
    سرچاپ client.درگاه کارساز نابرابر 443، client.با وب‌سوکت، client.سرآیند همراه نخستین داده، client.مهلت اتصال
    ناپایا link := تروجان.شماره گیری(client، "127.0.0.1"، echo_port)
    سرچاپ "dial ok:"، تروجان.پیوند معتبر(link)، link.نوع برابر تروجان.پیوند تی سی پی
    سرچاپ تروجان.نوشتن متن پیوند(link، "hello trojan")
    سرچاپ read_text(link، 17)
    big := حافظه.تخصیص(30000 برگردان طبیعی۶۴)
    حافظه.تنظیم(big، 97، 30000 برگردان طبیعی۶۴)
    سرچاپ تروجان.نوشتن پیوند(link، big، 30000)
    ناپایا total := 0
    تا total کوچکتر 30005:
        buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
        n := تروجان.خواندن پیوند(link، buf، 8192)
        حافظه.آزادسازی(buf)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        total += n
    پایان
    سرچاپ "echoed"، total
    حافظه.آزادسازی(big)
    تروجان.تنظیم مهلت پیوند(link، 1000)
    تروجان.بستن پیوند(link)

    ناپایا second := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، server.درگاه، "second")
    second.با تی ال اس = نادرست
    second.سرآیند همراه نخستین داده = درست
    ناپایا lazy := تروجان.شماره گیری(second، "127.0.0.1"، echo_port)
    سرچاپ تروجان.نوشتن متن پیوند(lazy، "lazy header")
    سرچاپ read_text(lazy، 16)
    تروجان.بستن پیوند(lazy)

    همگام سازی.خواب میلی ثانیه(300)
    stats := تروجان.آمار(server)
    سرچاپ "stats:"، stats.پذیرفته‌شده، stats.احراز‌شده، stats.جایگزین‌شده
    تروجان.توقف(server)
پایان
