// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.تروجان
واردسازی همگام سازی

ناپایا درگاه_پژواک := 0
ناپایا درگاه_وب := 0
ناپایا وب_دیده := ""
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع echo_server():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        تا درست:
            داده := تی سی پی.خواندن(نویسه، 4096)
            اگر داده.طول() برابر 0:
                بشکن
            پایان
            تی سی پی.نوشتن(نویسه، "echo:" + داده)
        پایان
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع web_server():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_وب = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        وب_دیده = تی سی پی.خواندن(نویسه، 4096)
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: 12\r\nConnection: close\r\n\r\nhello probes")
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع start_servers():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(echo_server)
    متغیر__b := نخ‌ساز(web_server)
    همگام سازی.انتظار(آماده)
پایان

تابع text_of(p: تهی*، تعداد: صحیح): رشته:
    بافر := حافظه.تخصیص((تعداد + 1) برگردان طبیعی۶۴)
    حافظه.کپی(بافر، p، تعداد برگردان طبیعی۶۴)
    (بافر برگردان طبیعی۸*)[تعداد] = 0 برگردان طبیعی۸
    برگشت بافر برگردان رشته
پایان

تابع read_text(l &: تروجان.پیوند، want: صحیح): رشته:
    بافر := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(بافر)
    ناپایا خروجی_مقدار := ""
    تا خروجی_مقدار.طول() کوچکتر want:
        تعداد := تروجان.خواندن پیوند(l، بافر، 8192)
        اگر تعداد کوچکتربرابر 0:
            بشکن
        پایان
        خروجی_مقدار = خروجی_مقدار + text_of(بافر، تعداد)
    پایان
    برگشت خروجی_مقدار
پایان

تابع ریشه:
    start_servers()

    ناپایا پیکربندی := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    تروجان.افزودن گذرواژه(پیکربندی، "secret")
    تروجان.افزودن درهم گذرواژه(پیکربندی، تروجان.درهم گذرواژه("second"))
    سرچاپ پیکربندی.درهم گذرواژه‌ها.طول()، پیکربندی.مهلت دست‌دهی
    کارساز := تروجان.سرویس‌دهی بدون رمز(پیکربندی، 0)
    سرچاپ "server up:"، کارساز.معتبر، تروجان.درگاه کارساز(کارساز) برابر کارساز.درگاه

    ناپایا کارخواه := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، کارساز.درگاه، "secret")
    کارخواه.با تی ال اس = نادرست
    سرچاپ کارخواه.درگاه کارساز نابرابر 443، کارخواه.با وب‌سوکت، کارخواه.سرآیند همراه نخستین داده، کارخواه.مهلت اتصال
    ناپایا پیوند_محلی := تروجان.شماره گیری(کارخواه، "127.0.0.1"، درگاه_پژواک)
    سرچاپ "dial ok:"، تروجان.پیوند معتبر(پیوند_محلی)، پیوند_محلی.نوع برابر تروجان.پیوند تی سی پی
    سرچاپ تروجان.نوشتن متن پیوند(پیوند_محلی، "hello trojan")
    سرچاپ read_text(پیوند_محلی، 17)
    متغیر_big := حافظه.تخصیص(30000 برگردان طبیعی۶۴)
    حافظه.تنظیم(متغیر_big، 97، 30000 برگردان طبیعی۶۴)
    سرچاپ تروجان.نوشتن پیوند(پیوند_محلی، متغیر_big، 30000)
    ناپایا مجموع := 0
    تا مجموع کوچکتر 30005:
        بافر := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
        تعداد := تروجان.خواندن پیوند(پیوند_محلی، بافر، 8192)
        حافظه.آزادسازی(بافر)
        اگر تعداد کوچکتربرابر 0:
            بشکن
        پایان
        مجموع += تعداد
    پایان
    سرچاپ "echoed"، مجموع
    حافظه.آزادسازی(متغیر_big)
    تروجان.تنظیم مهلت پیوند(پیوند_محلی، 1000)
    تروجان.بستن پیوند(پیوند_محلی)

    ناپایا دومی := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، کارساز.درگاه، "second")
    دومی.با تی ال اس = نادرست
    دومی.سرآیند همراه نخستین داده = درست
    ناپایا متغیر_lazy := تروجان.شماره گیری(دومی، "127.0.0.1"، درگاه_پژواک)
    سرچاپ تروجان.نوشتن متن پیوند(متغیر_lazy، "lazy header")
    سرچاپ read_text(متغیر_lazy، 16)
    تروجان.بستن پیوند(متغیر_lazy)

    همگام سازی.خواب میلی ثانیه(300)
    آمار := تروجان.آمار(کارساز)
    سرچاپ "stats:"، آمار.پذیرفته‌شده، آمار.احراز‌شده، آمار.جایگزین‌شده
    تروجان.توقف(کارساز)
پایان
