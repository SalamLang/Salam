// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.تروجان
واردسازی همگام سازی

ناپایا echo_port := 0
ناپایا web_port := 0
ناپایا web_seen := ""
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع echo_server():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تا درست:
            data := تی سی پی.خواندن(c، 4096)
            اگر data.طول() برابر 0:
                بشکن
            پایان
            تی سی پی.نوشتن(c، "echo:" + data)
        پایان
        تی سی پی.بستن(c)
    پایان
پایان

تابع web_server():
    srv := تی سی پی.پیوند(0)
    web_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        web_seen = تی سی پی.خواندن(c، 4096)
        تی سی پی.نوشتن(c، "HTTP/1.1 200 OK\r\nContent-Length: 12\r\nConnection: close\r\n\r\nhello probes")
        تی سی پی.بستن(c)
    پایان
پایان

تابع start_servers():
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    _a := نخ‌ساز(echo_server)
    _b := نخ‌ساز(web_server)
    همگام سازی.انتظار(ready)
پایان

تابع text_of(p: تهی*، n: صحیح): رشته:
    buf := حافظه.تخصیص((n + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، p، n برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[n] = 0 برگردان طبیعی۸
    برگشت buf برگردان رشته
پایان

تابع read_text(l &: تروجان.پیوند، want: صحیح): رشته:
    buf := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(buf)
    ناپایا out := ""
    تا out.طول() کوچکتر want:
        n := تروجان.خواندن پیوند(l، buf، 8192)
        اگر n کوچکتربرابر 0:
            بشکن
        پایان
        out = out + text_of(buf، n)
    پایان
    برگشت out
پایان

تابع ریشه:
    start_servers()

    ناپایا config := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(config، درست)
    تروجان.افزودن گذرواژه(config، "secret")
    تروجان.تعیین جایگزین(config، "127.0.0.1"، web_port)
    سرچاپ config.میزبان جایگزین، config.درگاه جایگزین برابر web_port
    server := تروجان.سرویس‌دهی بدون رمز(config، 0)

    ناپایا wrong := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، server.درگاه، "not the password")
    wrong.با تی ال اس = نادرست
    ناپایا stranger := تروجان.شماره گیری(wrong، "127.0.0.1"، echo_port)
    answer := read_text(stranger، 40)
    سرچاپ "wrong password gets a web page:"، answer.شروع با("HTTP/1.1 200 OK")، answer.دربردارد("hello probes")
    تروجان.بستن پیوند(stranger)

    probe := تی سی پی.شماره گیری("127.0.0.1"، server.درگاه)
    تی سی پی.نوشتن(probe، "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
    page := تی سی پی.خواندن(probe، 4096)
    سرچاپ "plain web request gets the page too:"، page.دربردارد("hello probes")
    تی سی پی.بستن(probe)
    سرچاپ "the site saw:"، web_seen.زیررشته(0، 14)

    ناپایا right := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، server.درگاه، "secret")
    right.با تی ال اس = نادرست
    ناپایا member := تروجان.شماره گیری(right، "127.0.0.1"، echo_port)
    تروجان.نوشتن متن پیوند(member، "real client")
    سرچاپ read_text(member، 16)
    تروجان.بستن پیوند(member)

    همگام سازی.خواب میلی ثانیه(300)
    stats := تروجان.آمار(server)
    سرچاپ "accepted"، stats.پذیرفته‌شده، "authed"، stats.احراز‌شده، "fallbacks"، stats.جایگزین‌شده
    تروجان.توقف(server)
پایان
