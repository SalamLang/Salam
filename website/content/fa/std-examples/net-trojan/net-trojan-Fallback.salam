// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.تروجان
واردسازی همگام سازی

ناپایا درگاه_پژواک := 0
ناپایا درگاه_وب := 0
ناپایا وب_دیده := ""
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع echo_server():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        تا درست:
            داده := تی سی پی.خواندن(نویسه، 4096)
            اگر داده.طول() برابر 0:
                بشکن
            پایان
            تی سی پی.نوشتن(نویسه، "echo:" + داده)
        پایان
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع web_server():
    کارساز2 := تی سی پی.پیوند(0)
    درگاه_وب = تی سی پی.درگاه(کارساز2)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز2)
        وب_دیده = تی سی پی.خواندن(نویسه، 4096)
        تی سی پی.نوشتن(نویسه، "HTTP/1.1 200 OK\r\nContent-Length: 12\r\nConnection: close\r\n\r\nhello probes")
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع start_servers():
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__a := نخ‌ساز(echo_server)
    متغیر__b := نخ‌ساز(web_server)
    همگام سازی.انتظار(آماده)
پایان

تابع text_of(p: تهی*، تعداد: صحیح): رشته:
    بافر := حافظه.تخصیص((تعداد + 1) برگردان طبیعی۶۴)
    حافظه.کپی(بافر، p، تعداد برگردان طبیعی۶۴)
    (بافر برگردان طبیعی۸*)[تعداد] = 0 برگردان طبیعی۸
    برگشت بافر برگردان رشته
پایان

تابع read_text(l &: تروجان.پیوند، want: صحیح): رشته:
    بافر := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(بافر)
    ناپایا خروجی_مقدار := ""
    تا خروجی_مقدار.طول() کوچکتر want:
        تعداد := تروجان.خواندن پیوند(l، بافر، 8192)
        اگر تعداد کوچکتربرابر 0:
            بشکن
        پایان
        خروجی_مقدار = خروجی_مقدار + text_of(بافر، تعداد)
    پایان
    برگشت خروجی_مقدار
پایان

تابع ریشه:
    start_servers()

    ناپایا پیکربندی := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    تروجان.افزودن گذرواژه(پیکربندی، "secret")
    تروجان.تعیین جایگزین(پیکربندی، "127.0.0.1"، درگاه_وب)
    سرچاپ پیکربندی.میزبان جایگزین، پیکربندی.درگاه جایگزین برابر درگاه_وب
    کارساز := تروجان.سرویس‌دهی بدون رمز(پیکربندی، 0)

    ناپایا نادرست := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، کارساز.درگاه، "not the password")
    نادرست.با تی ال اس = نادرست
    ناپایا غریبه := تروجان.شماره گیری(نادرست، "127.0.0.1"، درگاه_پژواک)
    پاسخ_متن := read_text(غریبه، 40)
    سرچاپ "wrong password gets a web page:"، پاسخ_متن.شروع با("HTTP/1.1 200 OK")، پاسخ_متن.دربردارد("hello probes")
    تروجان.بستن پیوند(غریبه)

    متغیر_probe := تی سی پی.شماره گیری("127.0.0.1"، کارساز.درگاه)
    تی سی پی.نوشتن(متغیر_probe، "GET / HTTP/1.1\r\nHost: example.com\r\n\r\n")
    صفحه_مقدار := تی سی پی.خواندن(متغیر_probe، 4096)
    سرچاپ "plain web request gets the page too:"، صفحه_مقدار.دربردارد("hello probes")
    تی سی پی.بستن(متغیر_probe)
    سرچاپ "the site saw:"، وب_دیده.زیررشته(0، 14)

    ناپایا راست := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، کارساز.درگاه، "secret")
    راست.با تی ال اس = نادرست
    ناپایا متغیر_member := تروجان.شماره گیری(راست، "127.0.0.1"، درگاه_پژواک)
    تروجان.نوشتن متن پیوند(متغیر_member، "real client")
    سرچاپ read_text(متغیر_member، 16)
    تروجان.بستن پیوند(متغیر_member)

    همگام سازی.خواب میلی ثانیه(300)
    آمار := تروجان.آمار(کارساز)
    سرچاپ "accepted"، آمار.پذیرفته‌شده، "authed"، آمار.احراز‌شده، "fallbacks"، آمار.جایگزین‌شده
    تروجان.توقف(کارساز)
پایان
