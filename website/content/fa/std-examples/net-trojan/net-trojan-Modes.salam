واردسازی حافظه
واردسازی شبکه.تی سی پی
واردسازی شبکه.یو دی پی
واردسازی شبکه.تروجان
واردسازی شبکه.تونل
واردسازی فشرده سازی
واردسازی همگام سازی

ناپایا درگاه_پژواک := 0
ناپایا درگاه_یودی‌پی := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع text_of(ویژگی_محلی: تهی*، تعداد: صحیح): رشته:
    بافر := حافظه.تخصیص((تعداد + 1) برگردان طبیعی۶۴)
    حافظه.کپی(بافر، ویژگی_محلی، تعداد برگردان طبیعی۶۴)
    (بافر برگردان طبیعی۸*)[تعداد] = 0 برگردان طبیعی۸
    برگشت بافر برگردان رشته
پایان

تابع echo_server():
    کارساز := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        تا درست:
            متن_نمونه := تی سی پی.خواندن(نویسه، 4096)
            اگر متن_نمونه.طول() برابر 0:
                بشکن
            پایان
            متغیر__n := تی سی پی.نوشتن(نویسه، متن_نمونه)
        پایان
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع udp_server():
    متن_نمونه := یو دی پی.پیوند(0)
    درگاه_یودی‌پی = یو دی پی.درگاه(متن_نمونه)
    همگام سازی.اتمام(آماده)
    تا درست:
        ویژگی_محلی := یو دی پی.دریافت(متن_نمونه، 2048)
        اگر ویژگی_محلی.داده.طول() بزرگتر 0:
            متغیر__n := یو دی پی.ارسال(متن_نمونه، ویژگی_محلی.میزبان فرستنده، ویژگی_محلی.درگاه فرستنده، "echo:" + ویژگی_محلی.داده)
        پایان
    پایان
پایان

تابع read_all_text(l &: تروجان.پیوند، want: صحیح): رشته:
    بافر := حافظه.تخصیص(8192 برگردان طبیعی۶۴)
    دیرکن حافظه.آزادسازی(بافر)
    ناپایا خروجی_مقدار := ""
    تا خروجی_مقدار.طول() کوچکتر want:
        تعداد := تروجان.خواندن پیوند(l، بافر، 8192)
        اگر تعداد کوچکتربرابر 0:
            بشکن
        پایان
        خروجی_مقدار = خروجی_مقدار + text_of(بافر، تعداد)
    پایان
    برگشت خروجی_مقدار
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر__t1 := نخ‌ساز(echo_server)
    متغیر__t2 := نخ‌ساز(udp_server)
    همگام سازی.انتظار(آماده)

    ناپایا پیکربندی := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    تروجان.افزودن گذرواژه(پیکربندی، "secret")
    تروجان.تعیین حالت(پیکربندی، تروجان.حالت ساده)
    آمار := تونل.آمار جدید()
    تروجان.تعیین آمار ترافیک(پیکربندی، آمار)
    کارساز := تروجان.شنود(پیکربندی، 0)
    سرچاپ "listen ok"، کارساز.معتبر، کارساز.میزبان

    ناپایا متغیر_ccfg := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، کارساز.درگاه، "secret")
    متغیر_ccfg.با تی ال اس = نادرست

    ناپایا متغیر_ulink := تروجان.شماره گیری یو دی پی(متغیر_ccfg)
    سرچاپ تروجان.ارسال یو دی پی(متغیر_ulink، "127.0.0.1"، درگاه_یودی‌پی، "one" برگردان تهی*، 3)
    سرچاپ تروجان.ارسال یو دی پی(متغیر_ulink، "127.0.0.1"، درگاه_یودی‌پی، "two" برگردان تهی*، 3)
    ناپایا متغیر_pkt := تروجان.بسته یو دی پی جدید()
    ناپایا متغیر_payload := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.خواندن بسته یو دی پی(متغیر_ulink، متغیر_pkt، متغیر_payload)، text_of(متغیر_payload.داده، متغیر_payload.طول)
    سرچاپ تروجان.خواندن بسته یو دی پی(متغیر_ulink، متغیر_pkt، متغیر_payload)، text_of(متغیر_payload.داده، متغیر_payload.طول)
    تروجان.بستن پیوند(متغیر_ulink)

    ناپایا پیوند_محلی := تروجان.شماره گیری(متغیر_ccfg، "127.0.0.1"، درگاه_پژواک)
    سرچاپ تروجان.نوشتن متن پیوند(پیوند_محلی، "hello stats")
    سرچاپ read_all_text(پیوند_محلی، 11)
    تروجان.بستن پیوند(پیوند_محلی)
    همگام سازی.خواب میلی ثانیه(300)
    سرچاپ "up"، آمار.بایت بارگذاری() بزرگتربرابر 17، "down"، آمار.بایت دریافت() بزرگتربرابر 17، "total"، آمار.شمار کل()
    تروجان.توقف(کارساز)

    ناپایا متغیر_rt := تونل.مسیریاب جدید("direct")
    ناپایا قاعده := تونل.قاعده جدید("block")
    سرچاپ تونل.قاعده درگاه(قاعده، "" + درگاه_پژواک)
    تونل.افزودن قاعده(متغیر_rt، قاعده)
    ناپایا متغیر_rd := تونل.شماره‌گیر مسیریاب جدید(متغیر_rt)
    تونل.افزودن به شماره‌گیر مسیریاب(متغیر_rd، "block"، تونل.مسدود())
    ناپایا متغیر_cfg2 := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(متغیر_cfg2، درست)
    تروجان.افزودن گذرواژه(متغیر_cfg2، "secret")
    تروجان.تعیین مسیریاب(متغیر_cfg2، متغیر_rd)
    تروجان.تعیین میزبان شنود(متغیر_cfg2، "127.0.0.1")
    تروجان.تعیین حالت(متغیر_cfg2، تروجان.حالت ساده)
    کارساز۲ := تروجان.شنود(متغیر_cfg2، 0)
    ناپایا متغیر_c2 := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، کارساز۲.درگاه، "secret")
    متغیر_c2.با تی ال اس = نادرست
    ناپایا متغیر_blocked := تروجان.شماره گیری(متغیر_c2، "127.0.0.1"، درگاه_پژواک)
    سرچاپ تروجان.نوشتن متن پیوند(متغیر_blocked، "x")
    سرچاپ "blocked read"، read_all_text(متغیر_blocked، 1).طول()
    تروجان.بستن پیوند(متغیر_blocked)

    تروجان.توقف(کارساز۲)
پایان
