// زبان: فارسی
واردسازی شبکه.تروجان

تابع ریشه:
    ناپایا config := تروجان.پیکربندی کارساز جدید("fullchain.pem"، "privkey.pem")
    تروجان.افزودن گذرواژه(config، "a long random password")
    تروجان.تعیین جایگزین(config، "127.0.0.1"، 8080)
    server := تروجان.سرویس‌دهی(config، 443)
    سرچاپ "trojan up:"، server.معتبر

    ناپایا client := تروجان.پیکربندی کارخواه جدید("proxy.example.com"، 443، "a long random password")
    client.نام سرور = "proxy.example.com"
    client.پروتکل برنامه = "h2"
    client.سرآیند همراه نخستین داده = درست
    ناپایا link := تروجان.شماره گیری(client، "example.com"، 443)
    سرچاپ تروجان.پیوند معتبر(link)، link.نوع برابر تروجان.پیوند تی ال اس
    تروجان.بستن پیوند(link)
    تروجان.توقف(server)
پایان
