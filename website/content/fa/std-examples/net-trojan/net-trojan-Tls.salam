// زبان: فارسی
واردسازی شبکه.تروجان

تابع ریشه:
    ناپایا پیکربندی := تروجان.پیکربندی کارساز جدید("fullchain.pem"، "privkey.pem")
    تروجان.افزودن گذرواژه(پیکربندی، "a long random password")
    تروجان.تعیین جایگزین(پیکربندی، "127.0.0.1"، 8080)
    کارساز := تروجان.سرویس‌دهی(پیکربندی، 443)
    سرچاپ "trojan up:"، کارساز.معتبر

    ناپایا کارخواه := تروجان.پیکربندی کارخواه جدید("proxy.example.com"، 443، "a long random password")
    کارخواه.نام سرور = "proxy.example.com"
    کارخواه.پروتکل برنامه = "h2"
    کارخواه.سرآیند همراه نخستین داده = درست
    ناپایا پیوند_محلی := تروجان.شماره گیری(کارخواه، "example.com"، 443)
    سرچاپ تروجان.پیوند معتبر(پیوند_محلی)، پیوند_محلی.نوع برابر تروجان.پیوند تی ال اس
    تروجان.بستن پیوند(پیوند_محلی)
    تروجان.توقف(کارساز)
پایان
