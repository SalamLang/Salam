// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تروجان
واردسازی شبکه.یو دی پی
واردسازی همگام سازی
واردسازی فشرده سازی

ناپایا درگاه_یودی‌پی := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع udp_server():
    متن_نمونه := یو دی پی.پیوند(0)
    درگاه_یودی‌پی = یو دی پی.درگاه(متن_نمونه)
    همگام سازی.اتمام(آماده)
    تا درست:
        ویژگی_محلی := یو دی پی.دریافت(متن_نمونه، 2048)
        اگر ویژگی_محلی.داده.طول() بزرگتر 0:
            یو دی پی.ارسال(متن_نمونه، ویژگی_محلی.میزبان فرستنده، ویژگی_محلی.درگاه فرستنده، "echo:" + ویژگی_محلی.داده)
        پایان
    پایان
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    متغیر__t := نخ‌ساز(udp_server)
    همگام سازی.انتظار(آماده)

    ناپایا پیکربندی := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.اجازه آدرس‌های خصوصی(پیکربندی، درست)
    تروجان.افزودن گذرواژه(پیکربندی، "secret")
    کارساز := تروجان.سرویس‌دهی بدون رمز(پیکربندی، 0)

    ناپایا کارخواه := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، کارساز.درگاه، "secret")
    کارخواه.با تی ال اس = نادرست
    ناپایا پیوند_محلی := تروجان.شماره گیری یو دی پی(کارخواه)
    سرچاپ "udp session:"، تروجان.پیوند معتبر(پیوند_محلی)
    سرچاپ تروجان.نوشتن بسته یو دی پی(پیوند_محلی، "127.0.0.1"، درگاه_یودی‌پی، "ping" برگردان تهی*، 4)

    ناپایا متغیر_packet := تروجان.بسته یو دی پی جدید()
    ناپایا متغیر_payload := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.خواندن بسته یو دی پی(پیوند_محلی، متغیر_packet، متغیر_payload)
    سرچاپ متغیر_packet.میزبان، متغیر_packet.درگاه برابر درگاه_یودی‌پی، متغیر_packet.وضعیت
    بافر := حافظه.تخصیص((متغیر_payload.طول + 1) برگردان طبیعی۶۴)
    حافظه.کپی(بافر، متغیر_payload.داده، متغیر_payload.طول برگردان طبیعی۶۴)
    (بافر برگردان طبیعی۸*)[متغیر_payload.طول] = 0 برگردان طبیعی۸
    سرچاپ بافر برگردان رشته
    تروجان.بستن پیوند(پیوند_محلی)
    تروجان.توقف(کارساز)
پایان
