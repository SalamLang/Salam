// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تروجان
واردسازی شبکه.یو دی پی
واردسازی همگام سازی
واردسازی فشرده سازی

ناپایا udp_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع udp_server():
    s := یو دی پی.پیوند(0)
    udp_port = یو دی پی.درگاه(s)
    همگام سازی.اتمام(ready)
    تا درست:
        p := یو دی پی.دریافت(s، 2048)
        اگر p.داده.طول() بزرگتر 0:
            یو دی پی.ارسال(s، p.میزبان فرستنده، p.درگاه فرستنده، "echo:" + p.داده)
        پایان
    پایان
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(udp_server)
    همگام سازی.انتظار(ready)

    ناپایا config := تروجان.پیکربندی کارساز جدید(""، "")
    تروجان.افزودن گذرواژه(config، "secret")
    server := تروجان.سرویس‌دهی بدون رمز(config، 0)

    ناپایا client := تروجان.پیکربندی کارخواه جدید("127.0.0.1"، server.درگاه، "secret")
    client.با تی ال اس = نادرست
    ناپایا link := تروجان.شماره گیری یو دی پی(client)
    سرچاپ "udp session:"، تروجان.پیوند معتبر(link)
    سرچاپ تروجان.نوشتن بسته یو دی پی(link، "127.0.0.1"، udp_port، "ping" برگردان تهی*، 4)

    ناپایا packet := تروجان.بسته یو دی پی جدید()
    ناپایا payload := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.خواندن بسته یو دی پی(link، packet، payload)
    سرچاپ packet.میزبان، packet.درگاه برابر udp_port، packet.وضعیت
    buf := حافظه.تخصیص((payload.طول + 1) برگردان طبیعی۶۴)
    حافظه.کپی(buf، payload.داده، payload.طول برگردان طبیعی۶۴)
    (buf برگردان طبیعی۸*)[payload.طول] = 0 برگردان طبیعی۸
    سرچاپ buf برگردان رشته
    تروجان.بستن پیوند(link)
    تروجان.توقف(server)
پایان
