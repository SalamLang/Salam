// زبان: فارسی
واردسازی شبکه.تروجان
واردسازی فشرده سازی

تابع ریشه:
    سرچاپ تروجان.اس‌اچ‌ای۲۲۴ هگز("")
    سرچاپ تروجان.اس‌اچ‌ای۲۲۴ هگز("abc")
    سرچاپ تروجان.درهم گذرواژه("password")
    متغیر_digest := تروجان.اس‌اچ‌ای۲۲۴("abc" برگردان تهی*، 3)
    سرچاپ متغیر_digest.طول، تروجان.هگز(متغیر_digest) برابر تروجان.اس‌اچ‌ای۲۲۴ هگز("abc")

    درخواست := تروجان.کدگذاری درخواست("password"، تروجان.فرمان اتصال، "example.com"، 443)
    سرچاپ تروجان.هگز(درخواست)
    متغیر_parsed := تروجان.تجزیه درخواست(درخواست.داده، درخواست.طول)
    سرچاپ متغیر_parsed.وضعیت برابر تروجان.تجزیه موفق، متغیر_parsed.فرمان برابر تروجان.فرمان اتصال، متغیر_parsed.نوع نشانی برابر تروجان.نوع نشانی دامنه، متغیر_parsed.میزبان، متغیر_parsed.درگاه، متغیر_parsed.بایت‌های مصرف‌شده
    سرچاپ متغیر_parsed.درهم برابر تروجان.درهم گذرواژه("password")
    متغیر_same := تروجان.کدگذاری درخواست با درهم(تروجان.درهم گذرواژه("password")، تروجان.فرمان اتصال، "example.com"، 443)
    سرچاپ تروجان.هگز(متغیر_same) برابر تروجان.هگز(درخواست)

    سرچاپ "short:"، تروجان.تجزیه درخواست(درخواست.داده، درخواست.طول - 3).وضعیت برابر تروجان.تجزیه نیازمند داده بیشتر
    متغیر_junk := تروجان.تجزیه درخواست("GET / HTTP/1.1\r\nHost: a\r\n\r\n" برگردان تهی*، 28)
    سرچاپ "junk:"، متغیر_junk.وضعیت برابر تروجان.تجزیه نامعتبر

    متغیر_udp_request := تروجان.کدگذاری درخواست("password"، تروجان.فرمان یو دی پی، "2001:db8::1"، 53)
    متغیر_p6 := تروجان.تجزیه درخواست(متغیر_udp_request.داده، متغیر_udp_request.طول)
    سرچاپ متغیر_p6.فرمان برابر تروجان.فرمان یو دی پی، متغیر_p6.نوع نشانی برابر تروجان.نوع نشانی آی‌پی۶، متغیر_p6.میزبان، متغیر_p6.درگاه

    متغیر_packet := تروجان.کدگذاری بسته یو دی پی("8.8.8.8"، 53، "hi" برگردان تهی*، 2)
    سرچاپ تروجان.هگز(متغیر_packet)
    متغیر_up := تروجان.تجزیه بسته یو دی پی(متغیر_packet.داده، متغیر_packet.طول)
    سرچاپ متغیر_up.وضعیت برابر تروجان.تجزیه موفق، متغیر_up.نوع نشانی برابر تروجان.نوع نشانی آی‌پی۴، متغیر_up.میزبان، متغیر_up.درگاه، متغیر_up.آغاز داده، متغیر_up.طول داده، متغیر_up.بایت‌های مصرف‌شده

    نشانی_محلی := تروجان.کدگذاری نشانی("example.com"، 443)
    سرچاپ تروجان.هگز(نشانی_محلی)
    ناپایا متغیر_atyp := 0
    ناپایا میزبان := ""
    ناپایا درگاه := 0
    سرچاپ تروجان.تجزیه نشانی(نشانی_محلی.داده، نشانی_محلی.طول، 0، متغیر_atyp، میزبان، درگاه)، متغیر_atyp، میزبان، درگاه

    ناپایا متغیر_ip4 := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.تجزیه آی‌پی۴("192.168.1.20"، متغیر_ip4)، تروجان.قالب‌دهی آی‌پی۴(متغیر_ip4.داده، 0)
    ناپایا متغیر_ip6 := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.تجزیه آی‌پی۶("2001:db8::1"، متغیر_ip6)، تروجان.قالب‌دهی آی‌پی۶(متغیر_ip6.داده، 0)
    سرچاپ تروجان.فرمان اتصال، تروجان.فرمان یو دی پی، تروجان.نوع نشانی آی‌پی۴، تروجان.نوع نشانی آی‌پی۶، تروجان.تجزیه نیازمند داده بیشتر، تروجان.تجزیه نامعتبر
پایان
