// زبان: فارسی
واردسازی شبکه.تروجان
واردسازی فشرده سازی

تابع ریشه:
    سرچاپ تروجان.اس‌اچ‌ای۲۲۴ هگز("")
    سرچاپ تروجان.اس‌اچ‌ای۲۲۴ هگز("abc")
    سرچاپ تروجان.درهم گذرواژه("password")
    digest := تروجان.اس‌اچ‌ای۲۲۴("abc" برگردان تهی*، 3)
    سرچاپ digest.طول، تروجان.هگز(digest) برابر تروجان.اس‌اچ‌ای۲۲۴ هگز("abc")

    request := تروجان.کدگذاری درخواست("password"، تروجان.فرمان اتصال، "example.com"، 443)
    سرچاپ تروجان.هگز(request)
    parsed := تروجان.تجزیه درخواست(request.داده، request.طول)
    سرچاپ parsed.وضعیت برابر تروجان.تجزیه موفق، parsed.فرمان برابر تروجان.فرمان اتصال، parsed.نوع نشانی برابر تروجان.نوع نشانی دامنه، parsed.میزبان، parsed.درگاه، parsed.بایت‌های مصرف‌شده
    سرچاپ parsed.درهم برابر تروجان.درهم گذرواژه("password")
    same := تروجان.کدگذاری درخواست با درهم(تروجان.درهم گذرواژه("password")، تروجان.فرمان اتصال، "example.com"، 443)
    سرچاپ تروجان.هگز(same) برابر تروجان.هگز(request)

    سرچاپ "short:"، تروجان.تجزیه درخواست(request.داده، request.طول - 3).وضعیت برابر تروجان.تجزیه نیازمند داده بیشتر
    junk := تروجان.تجزیه درخواست("GET / HTTP/1.1\r\nHost: a\r\n\r\n" برگردان تهی*، 28)
    سرچاپ "junk:"، junk.وضعیت برابر تروجان.تجزیه نامعتبر

    udp_request := تروجان.کدگذاری درخواست("password"، تروجان.فرمان یو دی پی، "2001:db8::1"، 53)
    p6 := تروجان.تجزیه درخواست(udp_request.داده، udp_request.طول)
    سرچاپ p6.فرمان برابر تروجان.فرمان یو دی پی، p6.نوع نشانی برابر تروجان.نوع نشانی آی‌پی۶، p6.میزبان، p6.درگاه

    packet := تروجان.کدگذاری بسته یو دی پی("8.8.8.8"، 53، "hi" برگردان تهی*، 2)
    سرچاپ تروجان.هگز(packet)
    up := تروجان.تجزیه بسته یو دی پی(packet.داده، packet.طول)
    سرچاپ up.وضعیت برابر تروجان.تجزیه موفق، up.نوع نشانی برابر تروجان.نوع نشانی آی‌پی۴، up.میزبان، up.درگاه، up.آغاز داده، up.طول داده، up.بایت‌های مصرف‌شده

    addr := تروجان.کدگذاری نشانی("example.com"، 443)
    سرچاپ تروجان.هگز(addr)
    ناپایا atyp := 0
    ناپایا host := ""
    ناپایا port := 0
    سرچاپ تروجان.تجزیه نشانی(addr.داده، addr.طول، 0، atyp، host، port)، atyp، host، port

    ناپایا ip4 := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.تجزیه آی‌پی۴("192.168.1.20"، ip4)، تروجان.قالب‌دهی آی‌پی۴(ip4.داده، 0)
    ناپایا ip6 := فشرده سازی.بافر بایت جدید()
    سرچاپ تروجان.تجزیه آی‌پی۶("2001:db8::1"، ip6)، تروجان.قالب‌دهی آی‌پی۶(ip6.داده، 0)
    سرچاپ تروجان.فرمان اتصال، تروجان.فرمان یو دی پی، تروجان.نوع نشانی آی‌پی۴، تروجان.نوع نشانی آی‌پی۶، تروجان.تجزیه نیازمند داده بیشتر، تروجان.تجزیه نامعتبر
پایان
