// زبان: فارسی
واردسازی شبکه.تون

تابع ریشه():
    نات := تون.ترجمه نشانی تازه("172.19.0.1"، "172.19.0.2"، 7000، 0)
    ووت := تون.ساخت بسته‌ی تی سی پی(
        "172.19.0.1"،
        51000،
        "1.1.1.1"،
        443،
        1 برگردان صحیح۶۴،
        0 برگردان صحیح۶۴،
        تون.پرچم همگام‌سازی،
        پوچ،
        0
    )
    سرچاپ "forward"، نات.بازنویسی(ووت.داده، ووت.طول، 0 برگردان صحیح۶۴) برابر تون.کنش بازفرستادن
    سیین := تون.تجزیه‌بسته(ووت.داده، ووت.طول)
    سرچاپ "kernel sees"، سیین.مبدا، سیین.درگاه مبدا، سیین.مقصد، سیین.درگاه مقصد
    ی := نات.جستجو(سیین.درگاه مبدا)
    سرچاپ "original"، ی.درست، ی.مبدا، ی.درگاه مبدا، ی.مقصد، ی.درگاه مقصد
    عقب := تون.ساخت بسته‌ی تی سی پی(
        "172.19.0.1"،
        نات.درگاه شنونده()،
        "172.19.0.2"،
        سیین.درگاه مبدا،
        9 برگردان صحیح۶۴،
        2 برگردان صحیح۶۴،
        تون.پرچم همگام‌سازی | تون.پرچم تایید،
        پوچ،
        0
    )
    _ر := نات.بازنویسی(عقب.داده، عقب.طول، 1 برگردان صحیح۶۴)
    برنامه := تون.تجزیه‌بسته(عقب.داده، عقب.طول)
    سرچاپ "app sees"، برنامه.مبدا، برنامه.درگاه مبدا، برنامه.مقصد، برنامه.درگاه مقصد
    دنس := تون.ساخت بسته‌ی یو دی پی("172.19.0.1"، 5353، "172.19.0.2"، 53، پوچ، 0)
    سرچاپ "dns"، نات.بازنویسی(دنس.داده، دنس.طول، 2 برگردان صحیح۶۴) برابر تون.کنش نام‌یابی
    سرچاپ "drop"، تون.کنش دورریختن، "ipv6"، تون.کنش آی‌پی۶
    سرچاپ "active"،
        نات.فعال‌ها()،
        "expired"،
        نات.پاکسازی(3600000 برگردان صحیح۶۴)،
        "active"،
        نات.فعال‌ها()
    تون.آزادسازی‌بسته(ووت)
    تون.آزادسازی‌بسته(عقب)
    تون.آزادسازی‌بسته(دنس)
    تون.آزادسازی ترجمه(نات)
پایان
