// زبان: فارسی
واردسازی شبکه.تون

تابع ریشه():
    بودی := "hi"
    پک := تون.ساخت بسته‌ی تی سی پی("172.19.0.1"، 40000، "93.184.216.34"، 443، 1 برگردان صحیح۶۴، 0 برگردان صحیح۶۴، تون.پرچم همگام‌سازی، بودی برگردان تهی*، 2)
    اطلاعات := تون.تجزیه‌بسته(پک.داده، پک.طول)
    سرچاپ اطلاعات.معتبر، اطلاعات.نسخه، اطلاعات.پروتکل برابر تون.پروتکل تی سی پی، اطلاعات.مبدا، اطلاعات.درگاه مبدا، اطلاعات.مقصد، اطلاعات.درگاه مقصد
    سرچاپ "syn"، (اطلاعات.پرچم‌ها & تون.پرچم همگام‌سازی) نابرابر 0، "ack"، (اطلاعات.پرچم‌ها & تون.پرچم تایید) نابرابر 0، "payload"، اطلاعات.طول داده، "of"، اطلاعات.طول‌کل
    سرچاپ "checksums ok"، تون.درستی جمع آزماها(پک.داده، پک.طول)
    پ := پک.داده برگردان طبیعی۸*
    پ[8] = 32 برگردان طبیعی۸
    سرچاپ "after edit"، تون.درستی جمع آزماها(پک.داده، پک.طول)
    تون.تکمیل جمع آزماها(پک.داده، پک.طول)
    سرچاپ "after finish"، تون.درستی جمع آزماها(پک.داده، پک.طول)
    سرچاپ "header sum"، تون.جمع آزما(پک.داده، 20)
    سرچاپ "rfc 1624"، تون.به‌روزرسانی جمع آزما(56623، 21845، 12933)
    ودپ := تون.ساخت بسته‌ی یو دی پی("10.0.0.2"، 5000، "10.0.0.1"، 53، پوچ، 0)
    و_ := تون.تجزیه‌بسته(ودپ.داده، ودپ.طول)
    سرچاپ "udp"، و_.پروتکل برابر تون.پروتکل یو دی پی، و_.طول سرآیند، و_.آغاز داده، و_.تکه
    سرچاپ "other flags"، تون.پرچم پایان‌دادن، تون.پرچم بازنشانی، تون.پرچم فشار، تون.پروتکل آی سی ام پی، تون.پروتکل آی سی ام پی شش
    تون.آزادسازی‌بسته(پک)
    تون.آزادسازی‌بسته(ودپ)
پایان
