linux true 192.168.1.1 eth0 0
macos 10.0.0.1 en0
resolvers 1 192.168.1.1
name ok true next 172.19.0.2
defaults fdfe:dcba:9876::1 1.1.1.1:53
up   ip addr add 172.19.0.1/30 dev salamtun
up   ip link set dev salamtun mtu 1500 up
up   ip route replace 203.0.113.7/32 via 192.168.1.1 dev eth0 onlink
up   -ip route replace 192.168.1.1/32 dev salamtun
up   ip route replace 0.0.0.0/1 dev salamtun
up   ip route replace 128.0.0.0/1 dev salamtun
up   -ip -6 route replace unreachable ::/1
up   -ip -6 route replace unreachable 8000::/1
down -ip route del 203.0.113.7/32
down -ip -6 route del unreachable ::/1
down -ip -6 route del unreachable 8000::/1
argv 6 ip
