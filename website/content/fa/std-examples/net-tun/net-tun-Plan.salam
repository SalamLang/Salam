// زبان: فارسی
واردسازی شبکه.تون

تابع ریشه():
    گو := تون.تجزیه مسیرهای لینوکس("Iface\tDestination\tGateway\tFlags\tRefCnt\tUse\tMetric\tMask\neth0\t00000000\t0101A8C0\t0003\t0\t0\t100\t00000000\n")
    سرچاپ "linux"، گو.درست، گو.نشانی دروازه، گو.رابط، گو.شماره رابط
    ماک := تون.تجزیه مسیر مک("    gateway: 10.0.0.1\n  interface: en0\n")
    سرچاپ "macos"، ماک.نشانی دروازه، ماک.رابط
    دنس := تون.تجزیه نام‌یاب‌ها("nameserver 192.168.1.1\n")
    سرچاپ "resolvers"، دنس.طول()، دنس[0]
    سرچاپ "name ok"، تون.نام معتبر("salamtun")، "next"، تون.نشانی بعدی(تون.نشانی پیش‌فرض)
    سرچاپ "defaults"، تون.نشانی پیش‌فرض شش، تون.نام‌یاب بالادست پیش‌فرض
    ناپایا هوستس := وکتور {} برگردان وکتور<رشته>
    هوستس.افزودن("203.0.113.7")
    وپتس := تون.گزینه‌ها { نام = "salamtun"، تنظیم نام‌یاب سامانه = نادرست }
    پل := تون.ساخت نقشه("linux"، "salamtun"، وپتس، گو، هوستس، دنس، "")
    هر خط در پل.برپایی:
        سرچاپ "up  "، خط
    پایان
    هر خط در پل.برچیدن:
        سرچاپ "down"، خط
    پایان
    پارتس := تون.شکستن فرمان(پل.برپایی[0])
    سرچاپ "argv"، پارتس.طول()، پارتس[0]
پایان
