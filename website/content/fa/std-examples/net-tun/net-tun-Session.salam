// زبان: فارسی
واردسازی حافظه
واردسازی شبکه.تون
واردسازی شبکه.تونل

تابع ریشه():
    او := تون.در‌دسترس بودن()
    اگر وارونه او.درست:
        سرچاپ "full device mode is off:"، او.دلیل
        برگشت
    پایان
    سرچاپ "platform"، تون.سکو()
    گو := تون.دروازه پیش‌فرض()
    سرچاپ "gateway"، گو.نشانی دروازه، گو.رابط
    سرچاپ "resolvers"، تون.نام‌یاب‌های سامانه().طول()
    ناپایا سیرویرس := وکتور {} برگردان وکتور<رشته>
    سیرویرس.افزودن("vpn.example.com")
    س := تون.آغاز(تون.گزینه‌ها { شماره‌گیر = تونل.مستقیم()، استثناها = سیرویرس })
    اگر وارونه س.درست:
        سرچاپ "start failed:"، س.خطا، تون.آخرین خطا()
        برگشت
    پایان
    سرچاپ "up"، س.نام، س.نشانی، "dns"، س.نشانی نام‌یاب، تون.در‌حال اجرا()
    دیریکت := تون.شماره‌گیر دورزن تازه()
    ک := دیریکت.اتصال(تونل.نشانی جدید("example.com"، 80))
    سرچاپ دیریکت.نام()، ک.معتبر()
    ک.بستن()
    _د := تون.دورزن()
    ست := تون.آمار نشست(س)
    سرچاپ ست.بسته‌های‌ورودی، ست.بسته‌های‌خروجی، ست.اتصال‌ها، ست.اتصال‌های فعال، ست.پرسش‌های نام‌یابی، ست.دامنه‌های شناسایی‌شده، ست.اتصال‌های ناموفق، ست.دورریخته‌ها، ست.بایت‌های بالارو، ست.بایت‌های پایین‌رو
    تون.توقف(س)
    دیو := تون.باز کردن دستگاه("salamtest"، 1500)
    اگر دیو.درست:
        بوف := حافظه.تخصیص(65536 برگردان طبیعی۶۴)
        ن := دیو.خواندن(بوف، 65536، 100)
        اگر ن بزرگتر 0:
            _و := دیو.نوشتن(بوف، ن)
        پایان
        حافظه.آزادسازی(بوف)
        دیو.بستن()
    پایان
پایان
