واردسازی شبکه.تون

تابع ریشه():
    ریق := "GET / HTTP/1.1\r\nHost: Example.com:8080\r\n\r\n"
    سرچاپ "host"، تون.شناسایی میزبان(ریق برگردان تهی*، ریق.طول())
    ق := تون.ساخت پرسش نام‌یابی(42، "salamlang.ir"، 1)
    د := تون.تجزیه پرسش نام‌یابی(ق.داده، ق.طول)
    سرچاپ "question"، د.درست، د.شناسه، د.نام، د.نوع‌پرسش
    تون.آزادسازی‌بسته(ق)
پایان
