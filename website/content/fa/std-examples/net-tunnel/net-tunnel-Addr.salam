// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    الف := تونل.تجزیه نشانی("example.com:443")
    سرچاپ الف.معتبر، الف.نوع برابر تونل.نشانی دامنه، الف.میزبان، الف.درگاه، الف.متن()
    بافر_محلی := تونل.تجزیه نشانی("[2001:db8::5]:8080")
    سرچاپ بافر_محلی.معتبر، بافر_محلی.نوع برابر تونل.نشانی آی‌پی۶، بافر_محلی.متن()
    سرچاپ تونل.تجزیه نشانی("example.com").معتبر، تونل.تجزیه نشانی("a:99999").معتبر
    سرچاپ تونل.آی‌پی است("10.1.1.1")، تونل.آی‌پی است("example.com")
    متغیر_ip := تونل.تجزیه آی‌پی۴("192.168.1.20")
    سرچاپ متغیر_ip.طول()، تونل.قالب‌بندی آی‌پی(متغیر_ip)
    سرچاپ تونل.قالب‌بندی آی‌پی(تونل.تجزیه آی‌پی۶("2001:0db8:0000:0000:0000:0000:0000:0001"))
    سرچاپ تونل.قالب‌بندی آی‌پی(تونل.تجزیه آی‌پی("::ffff:1.2.3.4"))
    تعداد := تونل.نشانی جدید("1.2.3.4"، 80)
    سرچاپ تعداد.نوع برابر تونل.نشانی آی‌پی۴، تعداد.متن()
پایان
