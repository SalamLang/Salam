// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    a := تونل.تجزیه نشانی("example.com:443")
    سرچاپ a.معتبر، a.نوع برابر تونل.نشانی دامنه، a.میزبان، a.درگاه، a.متن()
    b := تونل.تجزیه نشانی("[2001:db8::5]:8080")
    سرچاپ b.معتبر، b.نوع برابر تونل.نشانی آی‌پی۶، b.متن()
    سرچاپ تونل.تجزیه نشانی("example.com").معتبر، تونل.تجزیه نشانی("a:99999").معتبر
    سرچاپ تونل.آی‌پی است("10.1.1.1")، تونل.آی‌پی است("example.com")
    ip := تونل.تجزیه آی‌پی۴("192.168.1.20")
    سرچاپ ip.طول()، تونل.قالب‌بندی آی‌پی(ip)
    سرچاپ تونل.قالب‌بندی آی‌پی(تونل.تجزیه آی‌پی۶("2001:0db8:0000:0000:0000:0000:0000:0001"))
    سرچاپ تونل.قالب‌بندی آی‌پی(تونل.تجزیه آی‌پی("::ffff:1.2.3.4"))
    n := تونل.نشانی جدید("1.2.3.4"، 80)
    سرچاپ n.نوع برابر تونل.نشانی آی‌پی۴، n.متن()
پایان
