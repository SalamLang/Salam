// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا متغیر_hop_port := 0
ناپایا متغیر_hop_log := ""
ناپایا آماده := همگام سازی.گروه انتظار جدید()

ساختار LineHop:
    همگانی host: رشته = ""
    همگانی port: صحیح = 0

    همگانی تابع Server(): تونل.نشانی:
        برگشت تونل.نشانی جدید(این.host، این.port)
    پایان

    همگانی تابع Handshake(متن_نمونه: پویا تونل.جریان، target: تونل.نشانی): منطقی:
        متن_نمونه.نوشتن("HOP " + target.متن() + "\n")
        برگشت تونل.خواندن با جداکننده(متن_نمونه، "\n"، 50) برابر "OK\n"
    پایان

    همگانی تابع Name(): رشته:
        برگشت "linehop"
    پایان
پایان

تابع hop_server():
    کارساز := تی سی پی.پیوند(0)
    متغیر_hop_port = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    نویسه := تی سی پی.پذیرش(کارساز)
    متن_نمونه := تونل.پوشاندن تی سی پی(نویسه)
    متغیر_hop_log = تونل.خواندن با جداکننده(متن_نمونه، "\n"، 200)
    متن_نمونه.نوشتن("OK\n")
    متن_نمونه.نوشتن("end:" + متن_نمونه.خواندن(100))
    متن_نمونه.بستن()
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(hop_server)
    همگام سازی.انتظار(آماده)
    گام := LineHop { host = "127.0.0.1"، port = متغیر_hop_port }

    ناپایا متغیر_chain := تونل.زنجیره جدید(تونل.مستقیم())
    تونل.افزودن گام(متغیر_chain، گام)
    سرچاپ متغیر_chain.نام()
    متن_نمونه := متغیر_chain.اتصال(تونل.نشانی جدید("service.internal"، 8080))
    سرچاپ متن_نمونه.معتبر()
    متن_نمونه.نوشتن("payload")
    سرچاپ متن_نمونه.خواندن(100)
    متن_نمونه.بستن()
    نخ‌پیوند(موقت)
    چاپ متغیر_hop_log

    متغیر_via := تونل.از طریق(تونل.مستقیم()، گام)
    سرچاپ متغیر_via.نام()
پایان
