// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا hop_port := 0
ناپایا hop_log := ""
ناپایا ready := همگام سازی.گروه انتظار جدید()

ساختار LineHop:
    همگانی host: رشته = ""
    همگانی port: صحیح = 0

    همگانی تابع Server(): تونل.نشانی:
        برگشت تونل.نشانی جدید(این.host، این.port)
    پایان

    همگانی تابع Handshake(s: پویا تونل.جریان، target: تونل.نشانی): منطقی:
        s.نوشتن("HOP " + target.متن() + "\n")
        برگشت تونل.خواندن با جداکننده(s، "\n"، 50) برابر "OK\n"
    پایان

    همگانی تابع Name(): رشته:
        برگشت "linehop"
    پایان
پایان

تابع hop_server():
    srv := تی سی پی.پیوند(0)
    hop_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    c := تی سی پی.پذیرش(srv)
    s := تونل.پوشاندن تی سی پی(c)
    hop_log = تونل.خواندن با جداکننده(s، "\n"، 200)
    s.نوشتن("OK\n")
    s.نوشتن("end:" + s.خواندن(100))
    s.بستن()
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(hop_server)
    همگام سازی.انتظار(ready)
    hop := LineHop { host = "127.0.0.1"، port = hop_port }

    ناپایا chain := تونل.زنجیره جدید(تونل.مستقیم())
    تونل.افزودن گام(chain، hop)
    سرچاپ chain.نام()
    s := chain.اتصال(تونل.نشانی جدید("service.internal"، 8080))
    سرچاپ s.معتبر()
    s.نوشتن("payload")
    سرچاپ s.خواندن(100)
    s.بستن()
    نخ‌پیوند(t)
    چاپ hop_log

    via := تونل.از طریق(تونل.مستقیم()، hop)
    سرچاپ via.نام()
پایان
