// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    متن := `{
  "inbounds": [{"tag": "in", "listen": "127.0.0.1", "port": 10808, "protocol": "mixed"}],
  "outbounds": [
    {"tag": "proxy", "protocol": "trojan", "settings": {"servers": [{"address": "t.example.org", "port": 443, "password": "pw"}]}},
    {"tag": "direct", "protocol": "freedom"},
    {"tag": "block", "protocol": "blackhole"}
  ],
  "routing": {"defaultOutbound": "proxy", "rules": [
    {"type": "field", "domain": ["domain:ir"], "outboundTag": "direct"},
    {"type": "field", "ip": ["geoip:private"], "outboundTag": "direct"},
    {"type": "field", "port": "25", "outboundTag": "block"}
  ]}
}`
    نویسه := تونل.تجزیه پیکربندی(متن)
    سرچاپ نویسه.خطاها.طول()، نویسه.درون‌سوها.طول()، نویسه.خروجی‌ها.طول()، نویسه.قاعده‌ها.طول()، نویسه.خروجی پیش‌فرض
    سرچاپ نویسه.درون‌سوها[0].درگاه، نویسه.خروجی‌ها[0].پروتکل، نویسه.قاعده‌ها[2].درگاه
    سرچاپ "problems:"، تونل.اعتبارسنجی پیکربندی(نویسه).طول()

    متغیر_rt := تونل.ساخت مسیریاب(نویسه)
    سرچاپ متغیر_rt.تطبیق میزبان("divar.ir"، 443)، متغیر_rt.تطبیق میزبان("192.168.1.1"، 80)، متغیر_rt.تطبیق میزبان("mail.example.com"، 25)، متغیر_rt.تطبیق میزبان("example.com"، 443)
    سرچاپ تونل.تجزیه پیکربندی(تونل.پیکربندی به جیسون(نویسه)).خروجی‌ها.طول()

    بد := تونل.تجزیه پیکربندی(`{"outbounds":[{"tag":"a","protocol":"freedom"},{"tag":"a","protocol":"freedom"}],"routing":{"rules":[{"outboundTag":"zzz","domain":["domain:x"]}]}}`)
    هر عنصر در تونل.اعتبارسنجی پیکربندی(بد):
        سرچاپ عنصر
    پایان
    سرچاپ تونل.بارگذاری پیکربندی("/nonexistent/config.json").خطاها.طول()

    گره := تونل.تجزیه لینک("trojan://pw@t.example.org:443?security=tls&sni=t.example.org#T")
    خروجی_مقدار := تونل.خروجی از گره(گره، "proxy")
    سرچاپ خروجی_مقدار.برچسب، خروجی_مقدار.پروتکل، تونل.گره به لینک(تونل.گره از خروجی(خروجی_مقدار)) برابر تونل.گره به لینک(گره)
    ناپایا متغیر_nodes := وکتور {} برگردان وکتور<تونل.گره>
    متغیر_nodes.بیفزا(گره)
    متغیر_gen := تونل.پیکربندی از گره‌ها(متغیر_nodes، 7890)
    سرچاپ متغیر_gen.درون‌سوها[0].درگاه، متغیر_gen.خروجی‌ها.طول()، متغیر_gen.خروجی پیش‌فرض، متغیر_gen.قاعده‌ها.طول()
پایان
