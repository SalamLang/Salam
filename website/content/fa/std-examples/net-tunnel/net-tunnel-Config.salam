// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    text := `{
  "inbounds": [{"tag": "in", "listen": "127.0.0.1", "port": 10808, "protocol": "mixed"}],
  "outbounds": [
    {"tag": "proxy", "protocol": "trojan", "settings": {"servers": [{"address": "t.example.org", "port": 443, "password": "pw"}]}},
    {"tag": "direct", "protocol": "freedom"},
    {"tag": "block", "protocol": "blackhole"}
  ],
  "routing": {"defaultOutbound": "proxy", "rules": [
    {"type": "field", "domain": ["domain:ir"], "outboundTag": "direct"},
    {"type": "field", "ip": ["geoip:private"], "outboundTag": "direct"},
    {"type": "field", "port": "25", "outboundTag": "block"}
  ]}
}`
    c := تونل.تجزیه پیکربندی(text)
    سرچاپ c.خطاها.طول()، c.درون‌سوها.طول()، c.خروجی‌ها.طول()، c.قاعده‌ها.طول()، c.خروجی پیش‌فرض
    سرچاپ c.درون‌سوها[0].درگاه، c.خروجی‌ها[0].پروتکل، c.قاعده‌ها[2].درگاه
    سرچاپ "problems:"، تونل.اعتبارسنجی پیکربندی(c).طول()

    rt := تونل.ساخت مسیریاب(c)
    سرچاپ rt.تطبیق میزبان("divar.ir"، 443)، rt.تطبیق میزبان("192.168.1.1"، 80)، rt.تطبیق میزبان("mail.example.com"، 25)، rt.تطبیق میزبان("example.com"، 443)
    سرچاپ تونل.تجزیه پیکربندی(تونل.پیکربندی به جیسون(c)).خروجی‌ها.طول()

    bad := تونل.تجزیه پیکربندی(`{"outbounds":[{"tag":"a","protocol":"freedom"},{"tag":"a","protocol":"freedom"}],"routing":{"rules":[{"outboundTag":"zzz","domain":["domain:x"]}]}}`)
    هر e در تونل.اعتبارسنجی پیکربندی(bad):
        سرچاپ e
    پایان
    سرچاپ تونل.بارگذاری پیکربندی("/nonexistent/config.json").خطاها.طول()

    node := تونل.تجزیه لینک("trojan://pw@t.example.org:443?security=tls&sni=t.example.org#T")
    out := تونل.خروجی از گره(node، "proxy")
    سرچاپ out.برچسب، out.پروتکل، تونل.گره به لینک(تونل.گره از خروجی(out)) برابر تونل.گره به لینک(node)
    ناپایا nodes := وکتور {} برگردان وکتور<تونل.گره>
    nodes.بیفزا(node)
    gen := تونل.پیکربندی از گره‌ها(nodes، 7890)
    سرچاپ gen.درون‌سوها[0].درگاه، gen.خروجی‌ها.طول()، gen.خروجی پیش‌فرض، gen.قاعده‌ها.طول()
پایان
