// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا درگاه := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع echo_once():
    کارساز := تی سی پی.پیوند(0)
    درگاه = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    نویسه := تی سی پی.پذیرش(کارساز)
    داده := تی سی پی.خواندن(نویسه، 64)
    تی سی پی.نوشتن(نویسه، "echo:" + داده)
    تی سی پی.بستن(نویسه)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(echo_once)
    همگام سازی.انتظار(آماده)
    هدف := تونل.نشانی جدید("127.0.0.1"، درگاه)

    متغیر_blocked := تونل.مسدود()
    سرچاپ متغیر_blocked.نام()، متغیر_blocked.اتصال(هدف).معتبر()

    ناپایا متغیر_backup := تونل.جایگزین جدید()
    تونل.افزودن جایگزین(متغیر_backup، تونل.مسدود())
    تونل.افزودن جایگزین(متغیر_backup، تونل.مستقیم())
    سرچاپ متغیر_backup.نام()
    متن_نمونه := متغیر_backup.اتصال(هدف)
    سرچاپ متن_نمونه.معتبر()
    متن_نمونه.نوشتن("hello")
    سرچاپ متن_نمونه.خواندن(100)
    متن_نمونه.بستن()
    نخ‌پیوند(موقت)

    متغیر_direct := تونل.شماره‌گیر مستقیم { مهلت اتصال = 500 }
    سرچاپ متغیر_direct.نام()، متغیر_direct.اتصال(تونل.نشانی جدید("127.0.0.1"، تی سی پی.درگاه آزاد())).معتبر()
    متغیر_stream := تونل.اتصال تی سی پی("127.0.0.1"، تی سی پی.درگاه آزاد()، 500)
    سرچاپ متغیر_stream.معتبر()
پایان
