// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع echo_once():
    srv := تی سی پی.پیوند(0)
    port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    c := تی سی پی.پذیرش(srv)
    data := تی سی پی.خواندن(c، 64)
    تی سی پی.نوشتن(c، "echo:" + data)
    تی سی پی.بستن(c)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(echo_once)
    همگام سازی.انتظار(ready)
    target := تونل.نشانی جدید("127.0.0.1"، port)

    blocked := تونل.مسدود()
    سرچاپ blocked.نام()، blocked.اتصال(target).معتبر()

    ناپایا backup := تونل.جایگزین جدید()
    تونل.افزودن جایگزین(backup، تونل.مسدود())
    تونل.افزودن جایگزین(backup، تونل.مستقیم())
    سرچاپ backup.نام()
    s := backup.اتصال(target)
    سرچاپ s.معتبر()
    s.نوشتن("hello")
    سرچاپ s.خواندن(100)
    s.بستن()
    نخ‌پیوند(t)

    direct := تونل.شماره‌گیر مستقیم { مهلت اتصال = 500 }
    سرچاپ direct.نام()، direct.اتصال(تونل.نشانی جدید("127.0.0.1"، تی سی پی.درگاه آزاد())).معتبر()
    stream := تونل.اتصال تی سی پی("127.0.0.1"، تی سی پی.درگاه آزاد()، 500)
    سرچاپ stream.معتبر()
پایان
