// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    سرچاپ تونل.کلید مبدا("::ffff:203.0.113.9")، تونل.کلید مبدا("2001:db8:1:2::7")
    local := تونل.شنود محلی آی‌پی۶(0)
    سرچاپ local.معتبر()
    local.توقف()
    dual := تونل.شنود تی سی پی دوگانه(0)
    سرچاپ dual.معتبر()
    dual.توقف()
    at := تونل.شنود تی سی پی در نشانی("::1"، 0)
    سرچاپ at.معتبر()، at.میزبان
    at.توقف()
    inbound := تونل.شنود تی سی پی دوگانه درون‌سو(0)
    سرچاپ inbound.معتبر()
    inbound.توقف()
پایان
