// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    سرچاپ تونل.کلید مبدا("::ffff:203.0.113.9")، تونل.کلید مبدا("2001:db8:1:2::7")
    متغیر_local := تونل.شنود محلی آی‌پی۶(0)
    سرچاپ متغیر_local.معتبر()
    متغیر_local.توقف()
    متغیر_dual := تونل.شنود تی سی پی دوگانه(0)
    سرچاپ متغیر_dual.معتبر()
    متغیر_dual.توقف()
    متغیر_at := تونل.شنود تی سی پی در نشانی("::1"، 0)
    سرچاپ متغیر_at.معتبر()، متغیر_at.میزبان
    متغیر_at.توقف()
    ورودی_شبکه := تونل.شنود تی سی پی دوگانه درون‌سو(0)
    سرچاپ ورودی_شبکه.معتبر()
    ورودی_شبکه.توقف()
پایان
