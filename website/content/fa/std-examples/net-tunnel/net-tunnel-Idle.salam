// زبان: فارسی
واردسازی شبکه.تونل
واردسازی همگام سازی

تابع ریشه:
    timer := تونل.زمان‌سنج بیکاری جدید(100 برگردان صحیح۶۴)
    سرچاپ timer.منقضی شده()
    همگام سازی.خواب میلی ثانیه(160)
    سرچاپ timer.منقضی شده()، timer.میلی‌ثانیه بیکاری() بزرگتربرابر 150
    timer.ثبت فعالیت()
    سرچاپ timer.منقضی شده()
    timer.آزادسازی()

    plain := تونل.زمان‌سنج بیکاری جدید(0 برگردان صحیح۶۴)
    همگام سازی.خواب میلی ثانیه(30)
    سرچاپ "no limit:"، plain.منقضی شده()
    plain.آزادسازی()
پایان
