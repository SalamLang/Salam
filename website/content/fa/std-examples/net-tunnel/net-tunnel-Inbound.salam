// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا echo_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

ساختار LineProtocol:
    همگانی unused: صحیح = 0

    همگانی تابع Name(): رشته:
        برگشت "line"
    پایان

    همگانی تابع Handshake(s: پویا تونل.جریان): تونل.نشست:
        line := تونل.خواندن با جداکننده(s، "\n"، 200)
        اگر وارونه line.شروع با("CONNECT "):
            برگشت تونل.نشست { خطا = "bad request" }
        پایان
        target := تونل.تجزیه نشانی(line.زیررشته(8، line.طول() - 9))
        اگر وارونه target.معتبر:
            برگشت تونل.نشست { خطا = "bad address" }
        پایان
        برگشت تونل.نشست { موفق = درست، مقصد = target، پروتکل = "line" }
    پایان

    همگانی تابع Reply(s: پویا تونل.جریان، _sess: تونل.نشست، ok: منطقی):
        اگر ok:
            s.نوشتن("OK\n")
        وگرنه:
            s.نوشتن("ERR\n")
        پایان
    پایان
پایان

تابع echo_server():
    srv := تی سی پی.پیوند(0)
    echo_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    تا درست:
        c := تی سی پی.پذیرش(srv)
        تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 100))
        تی سی پی.بستن(c)
    پایان
پایان

تابع ask(port: صحیح، request: رشته): رشته:
    c := تی سی پی.شماره گیری("127.0.0.1"، port)
    تی سی پی.نوشتن(c، request)
    answer := تی سی پی.خواندن(c، 100)
    rest := تی سی پی.خواندن(c، 100)
    تی سی پی.بستن(c)
    برگشت answer + rest
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    _t := نخ‌ساز(echo_server)
    همگام سازی.انتظار(ready)
    proto := LineProtocol {}
    forward := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، proto)
    inbound := تونل.شنود تی سی پی(0)
    سرچاپ inbound.معتبر()
    تونل.سرویس‌دهی پس‌زمینه(inbound، proto، forward)

    c := تی سی پی.شماره گیری("127.0.0.1"، inbound.درگاه)
    تی سی پی.نوشتن(c، "CONNECT 127.0.0.1:" + echo_port + "\n")
    سرچاپ تی سی پی.خواندن(c، 100)
    تی سی پی.نوشتن(c، "hello")
    سرچاپ تی سی پی.خواندن(c، 100)
    تی سی پی.بستن(c)

    سرچاپ ask(inbound.درگاه، "CONNECT 127.0.0.1:" + تی سی پی.درگاه آزاد() + "\n")
    سرچاپ ask(inbound.درگاه، "GET / HTTP/1.1\r\n\r\n").طول()
    inbound.توقف()
    سرچاپ forward.آمار.شمار کل()، forward.آمار.شمار ناموفق()
پایان
