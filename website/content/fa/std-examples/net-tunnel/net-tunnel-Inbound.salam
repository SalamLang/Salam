// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا درگاه_پژواک := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

ساختار LineProtocol:
    همگانی unused: صحیح = 0

    همگانی تابع Name(): رشته:
        برگشت "line"
    پایان

    همگانی تابع Handshake(s: پویا تونل.جریان): تونل.نشست:
        خط := تونل.خواندن با جداکننده(s، "\n"، 200)
        اگر وارونه خط.شروع با("CONNECT "):
            برگشت تونل.نشست { خطا = "bad request" }
        پایان
        هدف := تونل.تجزیه نشانی(خط.زیررشته(8، خط.طول() - 9))
        اگر وارونه هدف.معتبر:
            برگشت تونل.نشست { خطا = "bad address" }
        پایان
        برگشت تونل.نشست { موفق = درست، مقصد = هدف، پروتکل = "line" }
    پایان

    همگانی تابع Reply(s: پویا تونل.جریان، _sess: تونل.نشست، ok: منطقی):
        اگر ok:
            s.نوشتن("OK\n")
        وگرنه:
            s.نوشتن("ERR\n")
        پایان
    پایان
پایان

تابع echo_server():
    کارساز := تی سی پی.پیوند(0)
    درگاه_پژواک = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    تا درست:
        نویسه := تی سی پی.پذیرش(کارساز)
        تی سی پی.نوشتن(نویسه، "echo:" + تی سی پی.خواندن(نویسه، 100))
        تی سی پی.بستن(نویسه)
    پایان
پایان

تابع ask(port: صحیح، request: رشته): رشته:
    نویسه := تی سی پی.شماره گیری("127.0.0.1"، port)
    تی سی پی.نوشتن(نویسه، request)
    پاسخ_متن := تی سی پی.خواندن(نویسه، 100)
    آرام := تی سی پی.خواندن(نویسه، 100)
    تی سی پی.بستن(نویسه)
    برگشت پاسخ_متن + آرام
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    متغیر__t := نخ‌ساز(echo_server)
    همگام سازی.انتظار(آماده)
    متغیر_proto := LineProtocol {}
    پیشرو := تونل.انتقال‌دهنده جدید(تونل.مستقیم()، متغیر_proto)
    ورودی_شبکه := تونل.شنود تی سی پی(0)
    سرچاپ ورودی_شبکه.معتبر()
    تونل.سرویس‌دهی پس‌زمینه(ورودی_شبکه، متغیر_proto، پیشرو)

    نویسه := تی سی پی.شماره گیری("127.0.0.1"، ورودی_شبکه.درگاه)
    تی سی پی.نوشتن(نویسه، "CONNECT 127.0.0.1:" + درگاه_پژواک + "\n")
    سرچاپ تی سی پی.خواندن(نویسه، 100)
    تی سی پی.نوشتن(نویسه، "hello")
    سرچاپ تی سی پی.خواندن(نویسه، 100)
    تی سی پی.بستن(نویسه)

    سرچاپ ask(ورودی_شبکه.درگاه، "CONNECT 127.0.0.1:" + تی سی پی.درگاه آزاد() + "\n")
    سرچاپ ask(ورودی_شبکه.درگاه، "GET / HTTP/1.1\r\n\r\n").طول()
    ورودی_شبکه.توقف()
    سرچاپ پیشرو.آمار.شمار کل()، پیشرو.آمار.شمار ناموفق()
پایان
