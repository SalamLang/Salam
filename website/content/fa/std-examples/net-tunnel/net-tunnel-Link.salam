// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    پیوند_محلی := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@203.0.113.9:443?encryption=none&security=tls&sni=cdn.example.com&type=ws&host=cdn.example.com&path=%2Fws#Berlin%201"
    تعداد := تونل.تجزیه لینک(پیوند_محلی)
    سرچاپ تعداد.معتبر، تعداد.پروتکل، تونل.نشانی گره(تعداد).متن()، تعداد.شبکه، تعداد.امنیت، تعداد.نام سرور، تعداد.مسیر
    سرچاپ تونل.برچسب گره(تعداد)
    سرچاپ تونل.گره به لینک(تعداد) برابر پیوند_محلی

    سرچاپ تونل.تجزیه لینک("vless://@host:1").معتبر، تونل.تجزیه لینک("http://x").معتبر
    سرچاپ تونل.تجزیه لینک("ss://aes-128-gcm:secret@10.0.0.1:8388#ss").روش

    متن := پیوند_محلی + "\n# a comment\ntrojan://pw@t.example.org:443#T\nnot a link\n"
    اشتراک := تونل.تجزیه اشتراک(متن)
    سرچاپ اشتراک.گره‌ها.طول()، اشتراک.ردشده، تونل.برچسب گره(اشتراک.گره‌ها[1])

    سرچاپ تونل.رمزگذاری درصدی("a b/c")، تونل.رمزگشایی درصدی("%D8%B3%D9%84%D8%A7%D9%85")
    سرچاپ تونل.رمزگذاری پایه۶۴ نشانی("subjects?_d>>")، تونل.رمزگشایی پایه۶۴("c2FsYW0")
پایان
