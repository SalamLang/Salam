// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    link := "vless://b831381d-6324-4d53-ad4f-8cda48b30811@203.0.113.9:443?encryption=none&security=tls&sni=cdn.example.com&type=ws&host=cdn.example.com&path=%2Fws#Berlin%201"
    n := تونل.تجزیه لینک(link)
    سرچاپ n.معتبر، n.پروتکل، تونل.نشانی گره(n).متن()، n.شبکه، n.امنیت، n.نام سرور، n.مسیر
    سرچاپ تونل.برچسب گره(n)
    سرچاپ تونل.گره به لینک(n) برابر link

    سرچاپ تونل.تجزیه لینک("vless://@host:1").معتبر، تونل.تجزیه لینک("http://x").معتبر
    سرچاپ تونل.تجزیه لینک("ss://aes-128-gcm:secret@10.0.0.1:8388#ss").روش

    text := link + "\n# a comment\ntrojan://pw@t.example.org:443#T\nnot a link\n"
    sub := تونل.تجزیه اشتراک(text)
    سرچاپ sub.گره‌ها.طول()، sub.ردشده، تونل.برچسب گره(sub.گره‌ها[1])

    سرچاپ تونل.رمزگذاری درصدی("a b/c")، تونل.رمزگشایی درصدی("%D8%B3%D9%84%D8%A7%D9%85")
    سرچاپ تونل.رمزگذاری پایه۶۴ نشانی("subjects?_d>>")، تونل.رمزگشایی پایه۶۴("c2FsYW0")
پایان
