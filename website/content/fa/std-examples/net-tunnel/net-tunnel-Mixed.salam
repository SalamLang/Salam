// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    سرچاپ تونل.تشخیص ترکیبی(5) برابر تونل.ساکس۵، تونل.تشخیص ترکیبی(4) برابر تونل.ساکس۴
    سرچاپ تونل.تشخیص ترکیبی(71) برابر تونل.اچ تی تی پی، تونل.تشخیص ترکیبی(22) برابر تونل.ناشناخته
    سرچاپ تونل.متن بایت(65)، تونل.متن بایت(65).طول()

    ناپایا mixed := تونل.ترکیبی جدید()
    سرچاپ mixed.نام()، mixed.ساکس۵ دارد، mixed.اچ تی تی پی دارد
    تونل.تنظیم ساکس۵ ترکیبی(mixed، تونل.پروتکل خالی {})
    تونل.تنظیم ساکس۴ ترکیبی(mixed، تونل.پروتکل خالی {})
    تونل.تنظیم اچ تی تی پی ترکیبی(mixed، تونل.پروتکل خالی {})
    سرچاپ mixed.ساکس۵ دارد، mixed.ساکس۴ دارد، mixed.اچ تی تی پی دارد

    pair := تونل.لوله جدید()
    pair.سر اول.نوشتن("\x05\x01\x00")
    sess := mixed.دست‌دهی(تونل.سر دوم لوله(pair))
    سرچاپ sess.موفق، sess.پروتکل، sess.خطا
    سرچاپ تونل.فرمان اتصال، تونل.فرمان یو دی پی
پایان
