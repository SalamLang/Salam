// زبان: فارسی
واردسازی شبکه.تونل

ساختار LoopbackMaker:
    همگانی unused: صحیح = 0

    همگانی تابع Protocol(): رشته:
        برگشت "loopback"
    پایان

    همگانی تابع Make(_cfg: تونل.پیکربندی خروجی): پویا تونل.شماره‌گیر:
        برگشت تونل.مستقیم()
    پایان
پایان

ساختار SilentInbound:
    همگانی unused: صحیح = 0

    همگانی تابع Protocol(): رشته:
        برگشت "silent"
    پایان

    همگانی تابع Make(_cfg: تونل.پیکربندی درون‌سو): پویا تونل.پذیرنده:
        برگشت تونل.پروتکل خالی {}
    پایان
پایان

تابع ریشه:
    سرچاپ تونل.خروجی ثبت شده("freedom")، تونل.خروجی ثبت شده("loopback")
    تونل.ثبت خروجی(LoopbackMaker {})
    تونل.ثبت درون‌سو(SilentInbound {})
    سرچاپ تونل.خروجی ثبت شده("loopback")، تونل.درون‌سو ثبت شده("silent")
    سرچاپ تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = "loopback" }).نام()
    سرچاپ تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = "freedom" }).نام()
    سرچاپ تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = "nobody-registered-this" }).نام()
    سرچاپ تونل.ساخت درون‌سو(تونل.پیکربندی درون‌سو { پروتکل = "silent" }).نام()
    c := تونل.تجزیه پیکربندی(`{"outbounds":[{"tag":"lo","protocol":"loopback"},{"tag":"deny","protocol":"blackhole"}],"routing":{"defaultOutbound":"lo","rules":[{"domain":["full:blocked.test"],"outboundTag":"deny"}]}}`)
    rd := تونل.ساخت شماره‌گیر(c)
    سرچاپ rd.گزینش("lo").نام()، rd.گزینش("deny").نام()، rd.گزینش("missing").نام()
    سرچاپ rd.اتصال(تونل.نشانی جدید("blocked.test"، 80)).معتبر()، rd.آخرین برچسب
پایان
