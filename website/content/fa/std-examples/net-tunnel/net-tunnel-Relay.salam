// زبان: فارسی
واردسازی شبکه.تونل
واردسازی استخر

تابع relay_job(a: پویا تونل.جریان، b: پویا تونل.جریان، st: تونل.آمار):
    r := تونل.رله با آمار(a، b، st، 5000)
    سرچاپ "relayed"، r.بارگذاری، r.دریافت
پایان

تابع ریشه:
    near := تونل.لوله جدید()
    far := تونل.لوله جدید()
    client := تونل.سر اول لوله(near)
    left := تونل.سر دوم لوله(near)
    right := تونل.سر اول لوله(far)
    server := تونل.سر دوم لوله(far)
    stats := تونل.آمار جدید()

    workers := استخر.جدید کشسان(1 برگردان صحیح۶۴، 2 برگردان صحیح۶۴، 2 برگردان صحیح۶۴)
    استخر.ارسال(workers، (): relay_job(left، right، stats) پایان)

    client.نوشتن("ping from the client")
    سرچاپ server.خواندن(100)
    server.نوشتن("pong from the server")
    سرچاپ client.خواندن(100)
    client.بستن()
    استخر.انتظار(workers)
    استخر.توقف(workers)
    سرچاپ stats.خلاصه()
    سرچاپ stats.بایت بارگذاری()، stats.بایت دریافت()
    تونل.آزادسازی آمار(stats)
پایان
