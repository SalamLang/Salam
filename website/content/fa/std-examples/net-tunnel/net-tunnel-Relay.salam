// زبان: فارسی
واردسازی شبکه.تونل
واردسازی استخر

تابع relay_job(a: پویا تونل.جریان، b: پویا تونل.جریان، st: تونل.آمار):
    خوانده := تونل.رله با آمار(a، b، st، 5000)
    سرچاپ "relayed"، خوانده.بارگذاری، خوانده.دریافت
پایان

تابع ریشه:
    متغیر_near := تونل.لوله جدید()
    متغیر_far := تونل.لوله جدید()
    کارخواه := تونل.سر اول لوله(متغیر_near)
    چپ := تونل.سر دوم لوله(متغیر_near)
    راست := تونل.سر اول لوله(متغیر_far)
    کارساز := تونل.سر دوم لوله(متغیر_far)
    آمار := تونل.آمار جدید()

    متغیر_workers := استخر.جدید کشسان(1 برگردان صحیح۶۴، 2 برگردان صحیح۶۴، 2 برگردان صحیح۶۴)
    استخر.ارسال(متغیر_workers، (): relay_job(چپ، راست، آمار) پایان)

    کارخواه.نوشتن("ping from the client")
    سرچاپ کارساز.خواندن(100)
    کارساز.نوشتن("pong from the server")
    سرچاپ کارخواه.خواندن(100)
    کارخواه.بستن()
    استخر.انتظار(متغیر_workers)
    استخر.توقف(متغیر_workers)
    سرچاپ آمار.خلاصه()
    سرچاپ آمار.بایت بارگذاری()، آمار.بایت دریافت()
    تونل.آزادسازی آمار(آمار)
پایان
