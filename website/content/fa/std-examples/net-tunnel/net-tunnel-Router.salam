// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    متغیر_rt := تونل.مسیریاب ایران("direct"، "proxy")
    هر میزبان در ["divar.ir"، "WWW.Digikala.com"، "ایران.ir"، "notaparat.com"، "evilir"، "google.com"، "192.168.1.9"، "localhost"]:
        سرچاپ میزبان، متغیر_rt.تطبیق میزبان(میزبان، 443)
    پایان

    ناپایا متغیر_custom := تونل.مسیریاب جدید("proxy")
    ناپایا متغیر_mail := تونل.قاعده جدید("block")
    تونل.قاعده درگاه(متغیر_mail، "25,465,587")
    تونل.افزودن قاعده(متغیر_custom، متغیر_mail)
    ناپایا متغیر_ads := تونل.قاعده جدید("block")
    تونل.قاعده کلیدواژه(متغیر_ads، "tracker")
    تونل.قاعده عبارت باقاعده(متغیر_ads، "^ads[0-9]+\\.example\\.com$")
    تونل.افزودن قاعده(متغیر_custom، متغیر_ads)
    ناپایا متغیر_home := تونل.قاعده جدید("direct")
    تونل.قاعده پسوند(متغیر_home، "example.org")
    تونل.قاعده دامنه(متغیر_home، "printer.lan")
    تونل.قاعده سی‌آی‌دی‌آر(متغیر_home، "203.0.113.0/24")
    تونل.افزودن قاعده(متغیر_custom، متغیر_home)
    ناپایا متغیر_lan := تونل.قاعده جدید("direct")
    تونل.قاعده آدرس‌های خصوصی(متغیر_lan)
    تونل.افزودن قاعده(متغیر_custom، متغیر_lan)

    سرچاپ متغیر_custom.تطبیق میزبان("smtp.example.com"، 25)
    سرچاپ متغیر_custom.تطبیق میزبان("my-tracker.net"، 443)، متغیر_custom.تطبیق میزبان("ads42.example.com"، 443)
    سرچاپ متغیر_custom.تطبیق میزبان("a.b.example.org"، 443)، متغیر_custom.تطبیق میزبان("printer.lan"، 80)
    سرچاپ متغیر_custom.تطبیق میزبان("203.0.113.77"، 80)، متغیر_custom.تطبیق میزبان("10.0.0.5"، 22)، متغیر_custom.تطبیق میزبان("8.8.8.8"، 53)
    سرچاپ متغیر_custom.تطبیق(تونل.تجزیه نشانی("203.0.113.1:8080"))

    سرچاپ تونل.تجزیه سی‌آی‌دی‌آر("10.0.0.0/8").پیشوند، تونل.تجزیه سی‌آی‌دی‌آر("nonsense").نوع
    ناپایا خوانده := تونل.قاعده جدید("x")
    سرچاپ تونل.قاعده دامنه با پیشوند(خوانده، "full:a.example.com")، تونل.قاعده آی‌پی با پیشوند(خوانده، "geoip:private")، تونل.قاعده سی‌آی‌دی‌آر(خوانده، "1.2.3.4/40")
    سرچاپ تونل.قاعده مطابقت دارد(خوانده، تونل.تجزیه نشانی("a.example.com:80"))، تونل.قاعده مطابقت دارد(خوانده، تونل.تجزیه نشانی("b.example.com:80"))
پایان
