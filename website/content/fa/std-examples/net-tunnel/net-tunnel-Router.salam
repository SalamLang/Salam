// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    rt := تونل.مسیریاب ایران("direct"، "proxy")
    هر host در ["divar.ir"، "WWW.Digikala.com"، "ایران.ir"، "notaparat.com"، "evilir"، "google.com"، "192.168.1.9"، "localhost"]:
        سرچاپ host، rt.تطبیق میزبان(host، 443)
    پایان

    ناپایا custom := تونل.مسیریاب جدید("proxy")
    ناپایا mail := تونل.قاعده جدید("block")
    تونل.قاعده درگاه(mail، "25,465,587")
    تونل.افزودن قاعده(custom، mail)
    ناپایا ads := تونل.قاعده جدید("block")
    تونل.قاعده کلیدواژه(ads، "tracker")
    تونل.قاعده عبارت باقاعده(ads، "^ads[0-9]+\\.example\\.com$")
    تونل.افزودن قاعده(custom، ads)
    ناپایا home := تونل.قاعده جدید("direct")
    تونل.قاعده پسوند(home، "example.org")
    تونل.قاعده دامنه(home، "printer.lan")
    تونل.قاعده سی‌آی‌دی‌آر(home، "203.0.113.0/24")
    تونل.افزودن قاعده(custom، home)
    ناپایا lan := تونل.قاعده جدید("direct")
    تونل.قاعده آدرس‌های خصوصی(lan)
    تونل.افزودن قاعده(custom، lan)

    سرچاپ custom.تطبیق میزبان("smtp.example.com"، 25)
    سرچاپ custom.تطبیق میزبان("my-tracker.net"، 443)، custom.تطبیق میزبان("ads42.example.com"، 443)
    سرچاپ custom.تطبیق میزبان("a.b.example.org"، 443)، custom.تطبیق میزبان("printer.lan"، 80)
    سرچاپ custom.تطبیق میزبان("203.0.113.77"، 80)، custom.تطبیق میزبان("10.0.0.5"، 22)، custom.تطبیق میزبان("8.8.8.8"، 53)
    سرچاپ custom.تطبیق(تونل.تجزیه نشانی("203.0.113.1:8080"))

    سرچاپ تونل.تجزیه سی‌آی‌دی‌آر("10.0.0.0/8").پیشوند، تونل.تجزیه سی‌آی‌دی‌آر("nonsense").نوع
    ناپایا r := تونل.قاعده جدید("x")
    سرچاپ تونل.قاعده دامنه با پیشوند(r، "full:a.example.com")، تونل.قاعده آی‌پی با پیشوند(r، "geoip:private")، تونل.قاعده سی‌آی‌دی‌آر(r، "1.2.3.4/40")
    سرچاپ تونل.قاعده مطابقت دارد(r، تونل.تجزیه نشانی("a.example.com:80"))، تونل.قاعده مطابقت دارد(r، تونل.تجزیه نشانی("b.example.com:80"))
پایان
