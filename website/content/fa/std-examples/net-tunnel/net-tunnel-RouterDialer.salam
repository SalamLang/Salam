// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع echo_once():
    srv := تی سی پی.پیوند(0)
    port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    c := تی سی پی.پذیرش(srv)
    تی سی پی.نوشتن(c، "echo:" + تی سی پی.خواندن(c، 64))
    تی سی پی.بستن(c)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(echo_once)
    همگام سازی.انتظار(ready)
    ناپایا router := تونل.مسیریاب جدید("direct")
    ناپایا blocked := تونل.قاعده جدید("block")
    تونل.قاعده پسوند(blocked، "blocked.test")
    تونل.افزودن قاعده(router، blocked)

    ناپایا rd := تونل.شماره‌گیر مسیریاب جدید(router)
    تونل.افزودن به شماره‌گیر مسیریاب(rd، "direct"، تونل.مستقیم())
    تونل.افزودن به شماره‌گیر مسیریاب(rd، "block"، تونل.مسدود())
    سرچاپ rd.نام()، rd.برچسب‌ها.طول()، rd.شماره‌گیرها.طول()

    s := rd.اتصال(تونل.نشانی جدید("127.0.0.1"، port))
    سرچاپ rd.آخرین برچسب، s.معتبر()
    s.نوشتن("hi")
    سرچاپ s.خواندن(100)
    s.بستن()
    نخ‌پیوند(t)
    سرچاپ rd.اتصال(تونل.نشانی جدید("ads.blocked.test"، 80)).معتبر()، rd.آخرین برچسب
    سرچاپ rd.گزینش("direct").نام()، rd.گزینش("nothing").نام()
پایان
