// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی همگام سازی

ناپایا درگاه := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع echo_once():
    کارساز := تی سی پی.پیوند(0)
    درگاه = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    نویسه := تی سی پی.پذیرش(کارساز)
    تی سی پی.نوشتن(نویسه، "echo:" + تی سی پی.خواندن(نویسه، 64))
    تی سی پی.بستن(نویسه)
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 1 برگردان صحیح۶۴)
    موقت := نخ‌ساز(echo_once)
    همگام سازی.انتظار(آماده)
    ناپایا متغیر_router := تونل.مسیریاب جدید("direct")
    ناپایا متغیر_blocked := تونل.قاعده جدید("block")
    تونل.قاعده پسوند(متغیر_blocked، "blocked.test")
    تونل.افزودن قاعده(متغیر_router، متغیر_blocked)

    ناپایا متغیر_rd := تونل.شماره‌گیر مسیریاب جدید(متغیر_router)
    تونل.افزودن به شماره‌گیر مسیریاب(متغیر_rd، "direct"، تونل.مستقیم())
    تونل.افزودن به شماره‌گیر مسیریاب(متغیر_rd، "block"، تونل.مسدود())
    سرچاپ متغیر_rd.نام()، متغیر_rd.برچسب‌ها.طول()، متغیر_rd.شماره‌گیرها.طول()

    متن_نمونه := متغیر_rd.اتصال(تونل.نشانی جدید("127.0.0.1"، درگاه))
    سرچاپ متغیر_rd.آخرین برچسب، متن_نمونه.معتبر()
    متن_نمونه.نوشتن("hi")
    سرچاپ متن_نمونه.خواندن(100)
    متن_نمونه.بستن()
    نخ‌پیوند(موقت)
    سرچاپ متغیر_rd.اتصال(تونل.نشانی جدید("ads.blocked.test"، 80)).معتبر()، متغیر_rd.آخرین برچسب
    سرچاپ متغیر_rd.گزینش("direct").نام()، متغیر_rd.گزینش("nothing").نام()
پایان
