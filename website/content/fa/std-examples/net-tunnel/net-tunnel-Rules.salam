// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    text := "# send Iranian sites direct\nDOMAIN-SUFFIX,ir,direct\nDOMAIN-KEYWORD,tracker,block\nIP-CIDR,203.0.113.0/24,direct\nGEOIP,PRIVATE,direct\nDST-PORT,25,block\nthis line is broken\nFINAL,proxy\n"
    set := تونل.تجزیه قاعده‌ها(text، "proxy")
    سرچاپ "errors:"، set.خطاها.طول()
    هر e در set.خطاها:
        سرچاپ e
    پایان
    هر host در ["shop.ir"، "my-tracker.net"، "203.0.113.5"، "127.0.0.1"، "example.com"]:
        سرچاپ host، set.مسیریاب.تطبیق میزبان(host، 443)
    پایان
    سرچاپ set.مسیریاب.تطبیق میزبان("example.com"، 25)
    missing := تونل.بارگذاری قاعده‌ها("/nonexistent/rules.txt"، "direct")
    سرچاپ missing.خطاها.بگیر(0)
پایان
