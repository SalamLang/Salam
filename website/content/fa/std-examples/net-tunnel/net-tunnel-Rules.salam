// زبان: فارسی
واردسازی شبکه.تونل

تابع ریشه:
    متن := "# send Iranian sites direct\nDOMAIN-SUFFIX,ir,direct\nDOMAIN-KEYWORD,tracker,block\nIP-CIDR,203.0.113.0/24,direct\nGEOIP,PRIVATE,direct\nDST-PORT,25,block\nthis line is broken\nFINAL,proxy\n"
    متغیر_set := تونل.تجزیه قاعده‌ها(متن، "proxy")
    سرچاپ "errors:"، متغیر_set.خطاها.طول()
    هر عنصر در متغیر_set.خطاها:
        سرچاپ عنصر
    پایان
    هر میزبان در ["shop.ir"، "my-tracker.net"، "203.0.113.5"، "127.0.0.1"، "example.com"]:
        سرچاپ میزبان، متغیر_set.مسیریاب.تطبیق میزبان(میزبان، 443)
    پایان
    سرچاپ متغیر_set.مسیریاب.تطبیق میزبان("example.com"، 25)
    گمشده := تونل.بارگذاری قاعده‌ها("/nonexistent/rules.txt"، "direct")
    سرچاپ گمشده.خطاها.بگیر(0)
پایان
