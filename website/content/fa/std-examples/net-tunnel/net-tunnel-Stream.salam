// زبان: فارسی
واردسازی شبکه.تونل
واردسازی حافظه

تابع ریشه:
    pair := تونل.لوله جدید()
    a := تونل.سر اول لوله(pair)
    b := تونل.سر دوم لوله(pair)

    سرچاپ تونل.نوشتن همه(a، "HELLO world\nsecond line\n")
    سرچاپ تونل.خواندن یک بایت(b)
    سرچاپ تونل.خواندن با جداکننده(b، "\n"، 100).طول()
    سرچاپ تونل.خواندن با جداکننده(b، "\n"، 100)

    a.نوشتن("12345678")
    buf := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    سرچاپ تونل.خواندن کامل(b، buf، 8)، (buf برگردان طبیعی۸*)[0]، (buf برگردان طبیعی۸*)[7]
    حافظه.آزادسازی(buf)

    a.نوشتن بایت("abc" برگردان تهی*، 3)
    w := تونل.با پیشوند(b، "<")
    سرچاپ w.خواندن(4)
    سرچاپ w.خواندن(10)

    b.تنظیم مهلت(50)
    سرچاپ "nothing to read: [" + b.خواندن(10) + "]"

    سرچاپ a.معتبر()، b.معتبر()
    a.بستن()
    سرچاپ a.معتبر()، b.خواندن(10).طول()
    dead := تونل.جریان مسدود {}
    سرچاپ dead.معتبر()، dead.نوشتن("x") بزرگتر 0، dead.خواندن(10).طول()
پایان
