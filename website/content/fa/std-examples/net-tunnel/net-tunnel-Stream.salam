// زبان: فارسی
واردسازی شبکه.تونل
واردسازی حافظه

تابع ریشه:
    متغیر_pair := تونل.لوله جدید()
    الف := تونل.سر اول لوله(متغیر_pair)
    بافر_محلی := تونل.سر دوم لوله(متغیر_pair)

    سرچاپ تونل.نوشتن همه(الف، "HELLO world\nsecond line\n")
    سرچاپ تونل.خواندن یک بایت(بافر_محلی)
    سرچاپ تونل.خواندن با جداکننده(بافر_محلی، "\n"، 100).طول()
    سرچاپ تونل.خواندن با جداکننده(بافر_محلی، "\n"، 100)

    الف.نوشتن("12345678")
    بافر := حافظه.تخصیص(8 برگردان طبیعی۶۴)
    سرچاپ تونل.خواندن کامل(بافر_محلی، بافر، 8)، (بافر برگردان طبیعی۸*)[0]، (بافر برگردان طبیعی۸*)[7]
    حافظه.آزادسازی(بافر)

    الف.نوشتن بایت("abc" برگردان تهی*، 3)
    نویسنده := تونل.با پیشوند(بافر_محلی، "<")
    سرچاپ نویسنده.خواندن(4)
    سرچاپ نویسنده.خواندن(10)

    بافر_محلی.تنظیم مهلت(50)
    سرچاپ "nothing to read: [" + بافر_محلی.خواندن(10) + "]"

    سرچاپ الف.معتبر()، بافر_محلی.معتبر()
    الف.بستن()
    سرچاپ الف.معتبر()، بافر_محلی.خواندن(10).طول()
    متغیر_dead := تونل.جریان مسدود {}
    سرچاپ متغیر_dead.معتبر()، متغیر_dead.نوشتن("x") بزرگتر 0، متغیر_dead.خواندن(10).طول()
پایان
