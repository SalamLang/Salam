// زبان: فارسی
واردسازی شبکه.تونل
واردسازی حافظه

تابع hex(v: وکتور<طبیعی۸>): رشته:
    digits := "0123456789abcdef"
    ناپایا out := ""
    تکرار v.طول() در i:
        b := v[i] برگردان صحیح
        out += digits.زیررشته(b / 16، 1) + digits.زیررشته(b % 16، 1)
    پایان
    برگشت out
پایان

تابع ریشه:
    target := تونل.نشانی جدید("example.com"، 443)
    socks := تونل.کدگذاری ساکس(target)
    vless := تونل.کدگذاری ویلس(target)
    سرچاپ "socks5"، hex(socks)
    سرچاپ "vless "، hex(vless)
    p := تونل.بایت‌های بردار(socks)
    back := تونل.کدگشایی ساکس(p، socks.طول())
    سرچاپ back.معتبر، back.متن()، back.حجم برابر socks.طول()
    q := تونل.بایت‌های بردار(vless)
    again := تونل.کدگشایی ویلس(q، vless.طول())
    سرچاپ again.معتبر، again.متن()
    short := تونل.کدگشایی ساکس(p، 3)
    سرچاپ "short"، short.معتبر
    حافظه.آزادسازی(p)
    حافظه.آزادسازی(q)

    pair := تونل.لوله جدید()
    a := تونل.سر اول لوله(pair)
    b := تونل.سر دوم لوله(pair)
    تونل.نوشتن همه بایت‌ها(a، تونل.بایت‌های بردار(socks)، socks.طول())
    سرچاپ تونل.خواندن نشانی ساکس(b).متن()
    تونل.نوشتن همه بایت‌ها(a، تونل.بایت‌های بردار(vless)، vless.طول())
    سرچاپ تونل.خواندن نشانی ویلس(b).متن()
پایان
