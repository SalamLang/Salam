// زبان: فارسی
واردسازی شبکه.تونل
واردسازی حافظه

تابع hex(v: وکتور<طبیعی۸>): رشته:
    متغیر_digits := "0123456789abcdef"
    ناپایا خروجی_مقدار := ""
    تکرار v.طول() در شمارنده:
        بافر_محلی := v[شمارنده] برگردان صحیح
        خروجی_مقدار += متغیر_digits.زیررشته(بافر_محلی / 16، 1) + متغیر_digits.زیررشته(بافر_محلی % 16، 1)
    پایان
    برگشت خروجی_مقدار
پایان

تابع ریشه:
    هدف := تونل.نشانی جدید("example.com"، 443)
    متغیر_socks := تونل.کدگذاری ساکس(هدف)
    متغیر_vless := تونل.کدگذاری ویلس(هدف)
    سرچاپ "socks5"، hex(متغیر_socks)
    سرچاپ "vless "، hex(متغیر_vless)
    ویژگی_محلی := تونل.بایت‌های بردار(متغیر_socks)
    بازگشت := تونل.کدگشایی ساکس(ویژگی_محلی، متغیر_socks.طول())
    سرچاپ بازگشت.معتبر، بازگشت.متن()، بازگشت.حجم برابر متغیر_socks.طول()
    کیو := تونل.بایت‌های بردار(متغیر_vless)
    دوباره := تونل.کدگشایی ویلس(کیو، متغیر_vless.طول())
    سرچاپ دوباره.معتبر، دوباره.متن()
    متغیر_short := تونل.کدگشایی ساکس(ویژگی_محلی، 3)
    سرچاپ "short"، متغیر_short.معتبر
    حافظه.آزادسازی(ویژگی_محلی)
    حافظه.آزادسازی(کیو)

    متغیر_pair := تونل.لوله جدید()
    الف := تونل.سر اول لوله(متغیر_pair)
    بافر_محلی := تونل.سر دوم لوله(متغیر_pair)
    تونل.نوشتن همه بایت‌ها(الف، تونل.بایت‌های بردار(متغیر_socks)، متغیر_socks.طول())
    سرچاپ تونل.خواندن نشانی ساکس(بافر_محلی).متن()
    تونل.نوشتن همه بایت‌ها(الف، تونل.بایت‌های بردار(متغیر_vless)، متغیر_vless.طول())
    سرچاپ تونل.خواندن نشانی ویلس(بافر_محلی).متن()
پایان
