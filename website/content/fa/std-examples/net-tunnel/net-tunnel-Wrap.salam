// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی شبکه.وب‌سوکت
واردسازی همگام سازی

ناپایا متغیر_tcp_port := 0
ناپایا متغیر_ws_port := 0
ناپایا آماده := همگام سازی.گروه انتظار جدید()

تابع tcp_server():
    کارساز := تی سی پی.پیوند(0)
    متغیر_tcp_port = تی سی پی.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    نویسه := تی سی پی.پذیرش(کارساز)
    متن_نمونه := تونل.پوشاندن تی سی پی(نویسه)
    متن_نمونه.نوشتن("tcp:" + متن_نمونه.خواندن(100))
    متن_نمونه.بستن()
پایان

تابع ws_server():
    کارساز := وب‌سوکت.شنود(0)
    متغیر_ws_port = وب‌سوکت.درگاه(کارساز)
    همگام سازی.اتمام(آماده)
    نویسه := وب‌سوکت.پذیرش(کارساز)
    متن_نمونه := تونل.پوشاندن وب‌سوکت(نویسه)
    نخست := متن_نمونه.خواندن(5)
    آرام := متن_نمونه.خواندن(100)
    متن_نمونه.نوشتن("ws:" + نخست + آرام)
    متن_نمونه.بستن()
پایان

تابع ریشه:
    همگام سازی.افزودن(آماده، 2 برگردان صحیح۶۴)
    متغیر_t1 := نخ‌ساز(tcp_server)
    متغیر_t2 := نخ‌ساز(ws_server)
    همگام سازی.انتظار(آماده)

    ساده := تونل.اتصال تی سی پی("127.0.0.1"، متغیر_tcp_port، 2000)
    ساده.نوشتن("hello")
    سرچاپ ساده.خواندن(100)
    ساده.بستن()

    اتصال := وب‌سوکت.شماره گیری("127.0.0.1"، متغیر_ws_port، "/")
    متغیر_stream := تونل.پوشاندن وب‌سوکت(اتصال)
    تونل.نوشتن همه(متغیر_stream، "hello world")
    سرچاپ تونل.خواندن یک بایت(متغیر_stream)
    سرچاپ متغیر_stream.خواندن(100)
    متغیر_stream.بستن()
    نخ‌پیوند(متغیر_t1)
    نخ‌پیوند(متغیر_t2)
پایان
