// زبان: فارسی
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی شبکه.وب‌سوکت
واردسازی همگام سازی

ناپایا tcp_port := 0
ناپایا ws_port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()

تابع tcp_server():
    srv := تی سی پی.پیوند(0)
    tcp_port = تی سی پی.درگاه(srv)
    همگام سازی.اتمام(ready)
    c := تی سی پی.پذیرش(srv)
    s := تونل.پوشاندن تی سی پی(c)
    s.نوشتن("tcp:" + s.خواندن(100))
    s.بستن()
پایان

تابع ws_server():
    srv := وب‌سوکت.شنود(0)
    ws_port = وب‌سوکت.درگاه(srv)
    همگام سازی.اتمام(ready)
    c := وب‌سوکت.پذیرش(srv)
    s := تونل.پوشاندن وب‌سوکت(c)
    first := s.خواندن(5)
    rest := s.خواندن(100)
    s.نوشتن("ws:" + first + rest)
    s.بستن()
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 2 برگردان صحیح۶۴)
    t1 := نخ‌ساز(tcp_server)
    t2 := نخ‌ساز(ws_server)
    همگام سازی.انتظار(ready)

    plain := تونل.اتصال تی سی پی("127.0.0.1"، tcp_port، 2000)
    plain.نوشتن("hello")
    سرچاپ plain.خواندن(100)
    plain.بستن()

    conn := وب‌سوکت.شماره گیری("127.0.0.1"، ws_port، "/")
    stream := تونل.پوشاندن وب‌سوکت(conn)
    تونل.نوشتن همه(stream، "hello world")
    سرچاپ تونل.خواندن یک بایت(stream)
    سرچاپ stream.خواندن(100)
    stream.بستن()
    نخ‌پیوند(t1)
    نخ‌پیوند(t2)
پایان
