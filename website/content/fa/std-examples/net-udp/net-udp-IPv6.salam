// زبان: فارسی
واردسازی شبکه.یو دی پی

تابع ریشه:
    server := یو دی پی.پیوند دوگانه(0)
    سرچاپ یو دی پی.معتبر(server)، یو دی پی.نشانی محلی(server)
    port := یو دی پی.درگاه(server)
    six := یو دی پی.پیوند آی‌پی۶("::1"، 0، درست)
    سرچاپ یو دی پی.معتبر(six)، یو دی پی.تنظیم فقط آی‌پی۶(six، درست)
    client := یو دی پی.باز کردن همه خانواده()
    یو دی پی.تنظیم زمان انتظار(server، 1000)
    یو دی پی.ارسال به(client، "::1"، port، "hello six")
    packet := یو دی پی.دریافت(server، 100)
    سرچاپ packet.داده، packet.میزبان فرستنده
    wide := یو دی پی.باز کردن برای میزبان("::1")
    سرچاپ یو دی پی.معتبر(wide)
    linked := یو دی پی.شماره گیری("::1"، port)
    یو دی پی.نوشتن(linked، "connected")
    سرچاپ یو دی پی.خواندن(server، 100)
    یو دی پی.بستن(linked)
    یو دی پی.بستن(wide)
    یو دی پی.بستن(client)
    یو دی پی.بستن(six)
    یو دی پی.بستن(server)
پایان
