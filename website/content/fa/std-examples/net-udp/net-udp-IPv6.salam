// زبان: فارسی
واردسازی شبکه.یو دی پی

تابع ریشه:
    کارساز := یو دی پی.پیوند دوگانه(0)
    سرچاپ یو دی پی.معتبر(کارساز)، یو دی پی.نشانی محلی(کارساز)
    درگاه := یو دی پی.درگاه(کارساز)
    متغیر_six := یو دی پی.پیوند آی‌پی۶("::1"، 0، درست)
    سرچاپ یو دی پی.معتبر(متغیر_six)، یو دی پی.تنظیم فقط آی‌پی۶(متغیر_six، درست)
    کارخواه := یو دی پی.باز کردن همه خانواده()
    یو دی پی.تنظیم زمان انتظار(کارساز، 1000)
    یو دی پی.ارسال به(کارخواه، "::1"، درگاه، "hello six")
    متغیر_packet := یو دی پی.دریافت(کارساز، 100)
    سرچاپ متغیر_packet.داده، متغیر_packet.میزبان فرستنده
    متغیر_wide := یو دی پی.باز کردن برای میزبان("::1")
    سرچاپ یو دی پی.معتبر(متغیر_wide)
    متغیر_linked := یو دی پی.شماره گیری("::1"، درگاه)
    یو دی پی.نوشتن(متغیر_linked، "connected")
    سرچاپ یو دی پی.خواندن(کارساز، 100)
    یو دی پی.بستن(متغیر_linked)
    یو دی پی.بستن(متغیر_wide)
    یو دی پی.بستن(کارخواه)
    یو دی پی.بستن(متغیر_six)
    یو دی پی.بستن(کارساز)
پایان
