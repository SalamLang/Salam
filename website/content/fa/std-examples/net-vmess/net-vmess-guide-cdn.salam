// زبان: فارسی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی مس

تابع ریشه:
    ناپایا s := انتقال شبکه.تنظیمات {}
    s.شبکه = "ws"
    s.تی ال اس = درست
    s.نام سرور = "front.example.net"
    s.سربرگ میزبان = "vpn.example.org"
    s.مسیر = "/vm-31c9"
    s.الپن = "http/1.1"

    target := انتقال شبکه.نشانی جدید("example.com"، 80)
    ناپایا c := وی مس.شماره گیری("front.example.net"، 443، s، "b831381d-6324-4d53-ad4f-8cda48b30811"، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، وی مس.فرمان تی سی پی، target)
    اگر وارونه c.معتبر:
        سرچاپ "could not connect:"، c.خطا
        برگشت
    پایان
    ناپایا req := انتقال شبکه.از رشته("HEAD / HTTP/1.0\r\nHost: example.com\r\n\r\n")
    وی مس.نوشتن(c، req.نشانگر، req.طول)
    انتقال شبکه.آزادسازی بایت‌ها(req)
    وی مس.بستن(c)
پایان
