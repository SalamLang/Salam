// زبان: فارسی
واردسازی حافظه
واردسازی رشته
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی مس

پایا ID := "b831381d-6324-4d53-ad4f-8cda48b30811"

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا seen := ""

تابع server():
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا users := وکتور {} برگردان وکتور<وی مس.کاربر>
    users.بیفزا(وی مس.کاربر جدید(ID))
    ناپایا rf := وی مس.فیلتر بازپخش جدید()
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    تکرار 3:
        ناپایا c := وی مس.پذیرش(انتقال شبکه.پذیرش(l)، users، rf)
        اگر وارونه c.معتبر:
            seen += "refused(" + c.خطا + ") "
            گذر
        پایان
        seen += c.درخواست.نشانی.میزبان + " security " + رشته.از عدد(c.درخواست.امنیت برگردان صحیح۶۴) + "; "
        n := وی مس.خواندن(c، buf، 4096)
        وی مس.نوشتن(c، buf، n)
        وی مس.بستن(c)
    پایان
    حافظه.آزادسازی(buf)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع talk(security: صحیح):
    target := انتقال شبکه.نشانی جدید("example.com"، 443)
    ناپایا c := وی مس.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {}، ID، security، وی مس.فرمان تی سی پی، target)
    ناپایا msg := انتقال شبکه.از رشته("hello through vmess")
    وی مس.نوشتن(c، msg.نشانگر، msg.طول)
    buf := حافظه.تخصیص(4096 برگردان طبیعی۶۴)
    n := وی مس.خواندن(c، buf، 4096)
    سرچاپ security، (buf برگردان رشته).زیررشته(0، n)
    حافظه.آزادسازی(buf)
    انتقال شبکه.آزادسازی بایت‌ها(msg)
    وی مس.بستن(c)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
    talk(وی مس.امنیت ای ای اس۱۲۸ جی سی ام)
    talk(وی مس.امنیت چاچا۲۰ پلی۱۳۰۵)
    talk(وی مس.امنیت هیچ)
    نخ‌پیوند(t)
    سرچاپ seen
پایان
