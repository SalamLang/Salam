// زبان: فارسی
واردسازی همگام سازی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.وی مس

پایا GOOD := "b831381d-6324-4d53-ad4f-8cda48b30811"
پایا OTHER := "5783a3e7-e373-51cd-8642-c83782b807c5"

ناپایا port := 0
ناپایا ready := همگام سازی.گروه انتظار جدید()
ناپایا verdict := ""

تابع server():
    l := انتقال شبکه.شنود(0، انتقال شبکه.تنظیمات {})
    port = انتقال شبکه.درگاه شنونده(l)
    همگام سازی.اتمام(ready)
    ناپایا users := وکتور {} برگردان وکتور<وی مس.کاربر>
    users.بیفزا(وی مس.کاربر جدید(GOOD))
    ناپایا rf := وی مس.فیلتر بازپخش جدید()
    ناپایا c := وی مس.پذیرش(انتقال شبکه.پذیرش(l)، users، rf)
    verdict = c.معتبر ? "accepted " + c.کاربر : "refused: " + c.خطا
    وی مس.بستن(c)
    انتقال شبکه.بستن شنونده(l)
پایان

تابع ریشه:
    همگام سازی.افزودن(ready، 1 برگردان صحیح۶۴)
    t := نخ‌ساز(server)
    همگام سازی.انتظار(ready)
    ناپایا c := وی مس.شماره گیری("127.0.0.1"، port، انتقال شبکه.تنظیمات {}، OTHER، وی مس.امنیت ای ای اس۱۲۸ جی سی ام، وی مس.فرمان تی سی پی، انتقال شبکه.نشانی جدید("example.com"، 80))
    نخ‌پیوند(t)
    سرچاپ verdict
    وی مس.بستن(c)
پایان
