// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

ناپایا متغیر_echo_srv := تی سی پی.سرور {}

تابع echo_once():
    نویسه := تی سی پی.پذیرش(متغیر_echo_srv)
    متن_نمونه := تونل.پوشاندن تی سی پی(نویسه)
    داده := متن_نمونه.خواندن(100)
    متن_نمونه.نوشتن("echo:" + داده)
    متن_نمونه.بستن()
پایان

تابع ریشه:
    متغیر_echo_srv = تی سی پی.پیوند(0)
    متغیر__t := نخ‌ساز(echo_once)
    وی‌پی‌ان.ثبت()
    پیکربندی := تونل.تجزیه پیکربندی(`{"inbounds":[{"tag":"in","port":0,"protocol":"mixed"}],"outbounds":[{"tag":"direct","protocol":"freedom"}]}`)
    آمار := تونل.آمار جدید()
    شنونده‌ها := وی‌پی‌ان.شروع همه(پیکربندی، آمار)
    سرچاپ "listening:"، وی‌پی‌ان.معتبر(شنونده‌ها[0])
    متن_نمونه := تونل.اتصال تی سی پی("127.0.0.1"، شنونده‌ها[0].درگاه، 3000)
    خوانده := ساکس.دست‌دهی کلاینت(متن_نمونه، ساکس.کلاینت { نسخه = 5 }، ساکس.فرمان اتصال، "127.0.0.1"، تی سی پی.درگاه(متغیر_echo_srv))
    سرچاپ "socks handshake:"، خوانده.موفق
    متن_نمونه.نوشتن("hello")
    سرچاپ متن_نمونه.خواندن(100)
    متن_نمونه.بستن()
    وی‌پی‌ان.توقف(شنونده‌ها[0])
    تی سی پی.بستن سرور(متغیر_echo_srv)
پایان
