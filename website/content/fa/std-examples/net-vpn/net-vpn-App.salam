// زبان: فارسی
واردسازی شبکه.ساکس
واردسازی شبکه.تی سی پی
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

ناپایا echo_srv := تی سی پی.سرور {}

تابع echo_once():
    c := تی سی پی.پذیرش(echo_srv)
    s := تونل.پوشاندن تی سی پی(c)
    data := s.خواندن(100)
    s.نوشتن("echo:" + data)
    s.بستن()
پایان

تابع ریشه:
    echo_srv = تی سی پی.پیوند(0)
    _t := نخ‌ساز(echo_once)
    وی‌پی‌ان.ثبت()
    cfg := تونل.تجزیه پیکربندی(`{"inbounds":[{"tag":"in","port":0,"protocol":"mixed"}],"outbounds":[{"tag":"direct","protocol":"freedom"}]}`)
    stats := تونل.آمار جدید()
    listeners := وی‌پی‌ان.شروع همه(cfg، stats)
    سرچاپ "listening:"، وی‌پی‌ان.معتبر(listeners[0])
    s := تونل.اتصال تی سی پی("127.0.0.1"، listeners[0].درگاه، 3000)
    r := ساکس.دست‌دهی کلاینت(s، ساکس.کلاینت { نسخه = 5 }، ساکس.فرمان اتصال، "127.0.0.1"، تی سی پی.درگاه(echo_srv))
    سرچاپ "socks handshake:"، r.موفق
    s.نوشتن("hello")
    سرچاپ s.خواندن(100)
    s.بستن()
    وی‌پی‌ان.توقف(listeners[0])
    تی سی پی.بستن سرور(echo_srv)
پایان
