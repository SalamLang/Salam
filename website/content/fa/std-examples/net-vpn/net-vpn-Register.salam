// زبان: فارسی
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

تابع ریشه:
    وی‌پی‌ان.ثبت با گزینه‌ها(وی‌پی‌ان.گزینه‌ها { تکه‌تکه کردن = درست، کمینه تکه = 2، بیشینه تکه = 8 })
    هر proto در ["vless"، "vmess"، "trojan"، "socks"، "http"، "mixed"]:
        ib := تونل.ساخت درون‌سو(تونل.پیکربندی درون‌سو { پروتکل = proto، تنظیمات = `{"clients":[{"id":"0b3a8c6e-1f3d-4d7e-9a50-3f8e6a1c2b44","password":"secret"}],"method":"aes-128-gcm","password":"secret"}` })
        سرچاپ "inbound"، proto، ib.نام()
    پایان
    هر proto در ["vless"، "vmess"، "trojan"، "shadowsocks"، "ss"، "socks"، "http"، "freedom"]:
        ob := تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = proto، تنظیمات = `{"address":"vpn.example.com","port":443}` })
        سرچاپ "outbound"، proto، ob.نام()
    پایان

    cfg := تونل.تجزیه پیکربندی(`{"inbounds":[{"tag":"in","port":0,"protocol":"mixed"}],"outbounds":[{"tag":"direct","protocol":"freedom"},{"tag":"out","protocol":"socks","settings":{"address":"127.0.0.1","port":1080}}]}`)
    dialer := وی‌پی‌ان.ساخت شماره‌گیر(cfg)
    سرچاپ dialer.نام()

    وی‌پی‌ان.ثبت()
    سرچاپ تونل.ساخت درون‌سو(تونل.پیکربندی درون‌سو { پروتکل = "vless" }).نام()
پایان
