// زبان: فارسی
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

تابع ریشه:
    وی‌پی‌ان.ثبت با گزینه‌ها(وی‌پی‌ان.گزینه‌ها { تکه‌تکه کردن = درست، کمینه تکه = 2، بیشینه تکه = 8 })
    هر متغیر_proto در ["vless"، "vmess"، "trojan"، "socks"، "http"، "mixed"]:
        متغیر_ib := تونل.ساخت درون‌سو(تونل.پیکربندی درون‌سو { پروتکل = متغیر_proto، تنظیمات = `{"clients":[{"id":"0b3a8c6e-1f3d-4d7e-9a50-3f8e6a1c2b44","password":"secret"}],"method":"aes-128-gcm","password":"secret"}` })
        سرچاپ "inbound"، متغیر_proto، متغیر_ib.نام()
    پایان
    هر متغیر_proto در ["vless"، "vmess"، "trojan"، "shadowsocks"، "ss"، "socks"، "http"، "freedom"]:
        متغیر_ob := تونل.ساخت خروجی(تونل.پیکربندی خروجی { پروتکل = متغیر_proto، تنظیمات = `{"address":"vpn.example.com","port":443}` })
        سرچاپ "outbound"، متغیر_proto، متغیر_ob.نام()
    پایان

    پیکربندی := تونل.تجزیه پیکربندی(`{"inbounds":[{"tag":"in","port":0,"protocol":"mixed"}],"outbounds":[{"tag":"direct","protocol":"freedom"},{"tag":"out","protocol":"socks","settings":{"address":"127.0.0.1","port":1080}}]}`)
    شماره_گیر := وی‌پی‌ان.ساخت شماره‌گیر(پیکربندی)
    سرچاپ شماره_گیر.نام()

    وی‌پی‌ان.ثبت()
    سرچاپ تونل.ساخت درون‌سو(تونل.پیکربندی درون‌سو { پروتکل = "vless" }).نام()
پایان
