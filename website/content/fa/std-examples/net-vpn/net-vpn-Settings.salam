// زبان: فارسی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

تابع ریشه:
    raw := `{"network":"ws","security":"tls","tlsSettings":{"serverName":"cdn.example.com"},"wsSettings":{"path":"/chat","headers":{"Host":"front.example.com"}}}`
    s := وی‌پی‌ان.تنظیمات جریان(raw)
    سرچاپ s.شبکه، s.تی ال اس، s.نام سرور، s.مسیر، s.سربرگ میزبان

    node := تونل.گره { پروتکل = "vless"، میزبان = "vpn.example.com"، درگاه = 443، شبکه = "ws"، تی ال اس = درست، نام سرور = "vpn.example.com"، مسیر = "/ws" }
    n := وی‌پی‌ان.تنظیمات گره(node)
    سرچاپ n.شبکه، n.تی ال اس، n.نام سرور، n.مسیر

    هر proto در ["vless"، "vmess"، "shadowsocks"، "trojan"، "socks"، "http"، "wireguard"]:
        سرچاپ proto، وی‌پی‌ان.شماره‌گیر از گره(تونل.گره { پروتکل = proto، میزبان = "vpn.example.com"، درگاه = 443 }).نام()
    پایان

    t := وی‌پی‌ان.نشانی تونل از انتقال(انتقال شبکه.نشانی جدید("example.com"، 443))
    سرچاپ t.میزبان، t.درگاه
    back := وی‌پی‌ان.نشانی انتقال از تونل(تونل.نشانی جدید("example.org"، 80))
    سرچاپ back.میزبان، back.درگاه
پایان
