// زبان: فارسی
واردسازی شبکه.انتقال شبکه
واردسازی شبکه.تونل
واردسازی شبکه.وی‌پی‌ان

تابع ریشه:
    خام := `{"network":"ws","security":"tls","tlsSettings":{"serverName":"cdn.example.com"},"wsSettings":{"path":"/chat","headers":{"Host":"front.example.com"}}}`
    متن_نمونه := وی‌پی‌ان.تنظیمات جریان(خام)
    سرچاپ متن_نمونه.شبکه، متن_نمونه.تی ال اس، متن_نمونه.نام سرور، متن_نمونه.مسیر، متن_نمونه.سربرگ میزبان

    گره := تونل.گره { پروتکل = "vless"، میزبان = "vpn.example.com"، درگاه = 443، شبکه = "ws"، تی ال اس = درست، نام سرور = "vpn.example.com"، مسیر = "/ws" }
    تعداد := وی‌پی‌ان.تنظیمات گره(گره)
    سرچاپ تعداد.شبکه، تعداد.تی ال اس، تعداد.نام سرور، تعداد.مسیر

    هر متغیر_proto در ["vless"، "vmess"، "shadowsocks"، "trojan"، "socks"، "http"، "wireguard"]:
        سرچاپ متغیر_proto، وی‌پی‌ان.شماره‌گیر از گره(تونل.گره { پروتکل = متغیر_proto، میزبان = "vpn.example.com"، درگاه = 443 }).نام()
    پایان

    موقت := وی‌پی‌ان.نشانی تونل از انتقال(انتقال شبکه.نشانی جدید("example.com"، 443))
    سرچاپ موقت.میزبان، موقت.درگاه
    بازگشت := وی‌پی‌ان.نشانی انتقال از تونل(تونل.نشانی جدید("example.org"، 80))
    سرچاپ بازگشت.میزبان، بازگشت.درگاه
پایان
