واردسازی شبکه.وب‌سوکت

ناپایا سرور := وب‌سوکت.سرور {}

تابع پاسخ‌گو():
    ناپایا ا := وب‌سوکت.پذیرش(سرور)
    تا وب‌سوکت.باز است(ا):
        پ := وب‌سوکت.دریافت پیام(ا)
        اگر وب‌سوکت.متن است(پ):
            _ := وب‌سوکت.ارسال متن(ا، "پژواک: " + پ.text)
        وگرنه وب‌سوکت.دودویی است(پ):
            _ := وب‌سوکت.ارسال بایت دودویی(ا، پ.data، پ.len)
        وگرنه وب‌سوکت.بسته است(پ):
            بشکن
        پایان
    پایان
    وب‌سوکت.بستن(ا)
پایان

تابع ریشه:
    سرور = وب‌سوکت.شنود(۰)
    سرچاپ وب‌سوکت.معتبر(سرور)، وب‌سوکت.درگاه(سرور) > ۰
    ن := نخ‌ساز(پاسخ‌گو)
    ناپایا ک := وب‌سوکت.شماره گیری("127.0.0.1"، وب‌سوکت.درگاه(سرور)، "/chat")
    سرچاپ وب‌سوکت.باز است(ک)، ک.path، ک.client
    _ := وب‌سوکت.ارسال متن(ک، "سلام")
    سرچاپ وب‌سوکت.دریافت متن(ک)
    _ := وب‌سوکت.ارسال دودویی(ک، "abc")
    پ := وب‌سوکت.دریافت با مهلت(ک، ۲۰۰۰)
    سرچاپ پ.kind == وب‌سوکت.دودویی، پ.len
    _ := وب‌سوکت.پینگ فرست(ک، "p")
    پ۲ := وب‌سوکت.دریافت با مهلت(ک، ۲۰۰۰)
    سرچاپ وب‌سوکت.پونگ است(پ۲)، پ۲.kind == وب‌سوکت.پونگ
    پ۳ := وب‌سوکت.دریافت با مهلت(ک، ۵۰)
    سرچاپ پ۳.kind == وب‌سوکت.مهلت
    وب‌سوکت.بستن(ک)
    نخ‌پیوند(ن)
    وب‌سوکت.بستن سرور(سرور)
    سرچاپ وب‌سوکت.هیچ، وب‌سوکت.متن، وب‌سوکت.بسته، وب‌سوکت.پینگ
پایان
