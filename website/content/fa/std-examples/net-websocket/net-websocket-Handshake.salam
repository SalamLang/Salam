واردسازی شبکه.وب‌سوکت
واردسازی رشته

روال ریشه:
    سرچاپ وب‌سوکت.کلید پذیرش("dGhlIHNhbXBsZSBub25jZQ==")
    د := وب‌سوکت.درخواست دست دادن("example.com"، "/chat"، "dGhlIHNhbXBsZSBub25jZQ==")
    سرچاپ رشته.تفکیک کردن(د، "\r\n")[۰]
    د۲ := وب‌سوکت.درخواست دست دادن با سربرگ("example.com"، "/chat"، "dGhlIHNhbXBsZSBub25jZQ=="، "Authorization: Bearer x\r\n")
    سرچاپ رشته.شامل است(د۲، "Authorization: Bearer x")
    پ := وب‌سوکت.پاسخ دست دادن(د)
    سرچاپ رشته.تفکیک کردن(پ، "\r\n")[۰]
    سرچاپ رشته.شامل است(پ، "Sec-WebSocket-Accept: s3pPLMBiTxaQ9kYGzzhZRbK+xOo=")
پایان
