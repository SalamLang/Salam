واردسازی شبکه.وب‌سوکت

ناپایا سرور := وب‌سوکت.سرور {}
ناپایا طرف‌ها := وکتور {} برگردان وکتور<وب‌سوکت.اتصال وب>

روال پذیرنده():
    تکرار ۲:
        طرف‌ها.بیفزا(وب‌سوکت.پذیرش(سرور))
    پایان
پایان

روال ریشه:
    سرور = وب‌سوکت.شنود(۰)
    د := وب‌سوکت.درگاه(سرور)
    ن := نخ‌ساز(پذیرنده)
    ناپایا الف := وب‌سوکت.شماره گیری("127.0.0.1"، د، "/room")
    ناپایا ب := وب‌سوکت.شماره گیری با سربرگ("127.0.0.1"، د، "/room"، "X-Name: b\r\n")
    نخ‌پیوند(ن)
    ناپایا هاب := وب‌سوکت.هاب جدید()
    هر ط در طرف‌ها:
        وب‌سوکت.ثبت(هاب، "lobby"، ط)
    پایان
    سرچاپ وب‌سوکت.اندازه اتاق(هاب، "lobby")، هاب.rooms.اندازه()
    سرچاپ وب‌سوکت.پخش(هاب، "lobby"، "خوش آمدید")
    سرچاپ وب‌سوکت.دریافت متن(الف)، وب‌سوکت.دریافت متن(ب)
    سرچاپ وب‌سوکت.پخش دودویی(هاب، "lobby"، "xy")
    سرچاپ وب‌سوکت.دریافت پیام(الف).len
    وب‌سوکت.لغو ثبت(هاب، "lobby"، طرف‌ها[۰])
    سرچاپ وب‌سوکت.اندازه اتاق(هاب، "lobby")
    وب‌سوکت.توقف(الف)
    وب‌سوکت.بستن(ب)
    وب‌سوکت.بستن سرور(سرور)
پایان
