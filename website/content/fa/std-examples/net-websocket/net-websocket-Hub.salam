واردسازی شبکه.وب‌سوکت شبکه

ناپایا سرور := وب‌سوکت شبکه.سرور {}
ناپایا طرف‌ها := وکتور {} برگردان وکتور<وب‌سوکت شبکه.اتصال وب>

روال پذیرنده():
    تکرار ۲:
        طرف‌ها.بیفزا(وب‌سوکت شبکه.پذیرش(سرور))
    پایان
پایان

روال ریشه:
    سرور = وب‌سوکت شبکه.شنود(۰)
    د := وب‌سوکت شبکه.درگاه(سرور)
    ن := spawn(پذیرنده)
    ناپایا الف := وب‌سوکت شبکه.شماره گیری("127.0.0.1"، د، "/room")
    ناپایا ب := وب‌سوکت شبکه.شماره گیری با سربرگ("127.0.0.1"، د، "/room"، "X-Name: b\r\n")
    join(ن)
    ناپایا هاب := وب‌سوکت شبکه.هاب جدید()
    هر ط در طرف‌ها:
        وب‌سوکت شبکه.ثبت(هاب، "lobby"، ط)
    پایان
    سرچاپ وب‌سوکت شبکه.اندازه اتاق(هاب، "lobby")، هاب.rooms.اندازه()
    سرچاپ وب‌سوکت شبکه.پخش(هاب، "lobby"، "خوش آمدید")
    سرچاپ وب‌سوکت شبکه.دریافت متن(الف)، وب‌سوکت شبکه.دریافت متن(ب)
    سرچاپ وب‌سوکت شبکه.پخش دودویی(هاب، "lobby"، "xy")
    سرچاپ وب‌سوکت شبکه.دریافت پیام(الف).len
    وب‌سوکت شبکه.لغو ثبت(هاب، "lobby"، طرف‌ها[۰])
    سرچاپ وب‌سوکت شبکه.اندازه اتاق(هاب، "lobby")
    وب‌سوکت شبکه.توقف(الف)
    وب‌سوکت شبکه.بستن(ب)
    وب‌سوکت شبکه.بستن سرور(سرور)
پایان
