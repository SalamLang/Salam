واردسازی شبکه.وب‌سوکت شبکه

روال ریشه:
    ناپایا ک := وب‌سوکت شبکه.شماره گیری امن("echo.example.com"، ۴۴۳، "/")
    ناپایا ک۲ := وب‌سوکت شبکه.شماره گیری امن با سربرگ("echo.example.com"، ۴۴۳، "/"، "Origin: https://salamlang.ir\r\n")
    ناپایا ک۳ := وب‌سوکت شبکه.شماره گیری امن بدون بررسی("localhost"، ۸۴۴۳، "/"، "")
    سرچاپ وب‌سوکت شبکه.باز است(ک)، وب‌سوکت شبکه.باز است(ک۲)، وب‌سوکت شبکه.باز است(ک۳)
    وب‌سوکت شبکه.بارگذاری پیکربندی امن("cert.pem"، "key.pem")
    س := وب‌سوکت شبکه.شنود(۸۴۴۳)
    ناپایا ا := وب‌سوکت شبکه.پذیرش امن(س)
    _ := وب‌سوکت شبکه.ارسال متن(ا، "سلام")
    وب‌سوکت شبکه.بستن(ا)
پایان
