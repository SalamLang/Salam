واردسازی شبکه.وب‌سوکت

روال ریشه:
    ناپایا ک := وب‌سوکت.شماره گیری امن("echo.example.com"، ۴۴۳، "/")
    ناپایا ک۲ := وب‌سوکت.شماره گیری امن با سربرگ("echo.example.com"، ۴۴۳، "/"، "Origin: https://salamlang.ir\r\n")
    ناپایا ک۳ := وب‌سوکت.شماره گیری امن بدون بررسی("localhost"، ۸۴۴۳، "/"، "")
    سرچاپ وب‌سوکت.باز است(ک)، وب‌سوکت.باز است(ک۲)، وب‌سوکت.باز است(ک۳)
    وب‌سوکت.بارگذاری پیکربندی امن("cert.pem"، "key.pem")
    س := وب‌سوکت.شنود(۸۴۴۳)
    ناپایا ا := وب‌سوکت.پذیرش امن(س)
    _ := وب‌سوکت.ارسال متن(ا، "سلام")
    وب‌سوکت.بستن(ا)
پایان
