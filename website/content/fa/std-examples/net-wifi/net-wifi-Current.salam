// زبان: فارسی
واردسازی شبکه.وای‌فای

تابع ریشه:
    اگر وارونه وای‌فای.پشتیبانی می شود():
        سرچاپ "no Wi-Fi backend on this platform"
        برگشت
    پایان
    س := وای‌فای.وضعیت کنونی()
    سرچاپ "state:"، وای‌فای.نام وضعیت(س.حالت)
    سرچاپ "interface:"، س.رابط
    اگر س.نام شبکه معلوم:
        سرچاپ "network:"، س.نام شبکه
    وگرنه:
        سرچاپ "network name hidden:"، س.دلیل
    پایان
    سرچاپ "access point:"، س.نشانی نقطه دسترسی
    سرچاپ "security:"، وای‌فای.نام امنیت(س.امنیت)، "insecure:"، س.ناامن است()
    سرچاپ "signal:"، س.قدرت سیگنال، "backend:"، س.پشتوانه، "connected:"، س.وصل است()
پایان
