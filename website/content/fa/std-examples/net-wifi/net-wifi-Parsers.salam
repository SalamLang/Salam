// زبان: فارسی
واردسازی شبکه.وای‌فای

تابع ریشه:
    نامیس := وای‌فای.تجزیه فهرست آی دبلیو("phy#0\n\tInterface wlan0\n\t\ttype managed\n")
    سرچاپ نامیس.طول()، نامیس[0]
    نامیس.آزاد()
    لینک := وای‌فای.تجزیه پیوند آی دبلیو("Connected to aa:bb:cc:dd:ee:ff (on wlan0)\n\tSSID: Sal\\xc3\\xa1m\n\tsignal: -58 dBm\n"، "wlan0")
    سرچاپ وای‌فای.نام وضعیت(لینک.حالت)، لینک.نام شبکه، لینک.نشانی نقطه دسترسی، لینک.قدرت سیگنال
    سکان := "BSS aa:bb:cc:dd:ee:ff(on wlan0) -- associated\n\tcapability: ESS Privacy (0x0411)\n\tRSN:\t * Version: 1\n\t\t * Authentication suites: PSK\n"
    سرچاپ وای‌فای.نام امنیت(وای‌فای.تجزیه پویش آی دبلیو(سکان، لینک.نشانی نقطه دسترسی))
    سرچاپ وای‌فای.رمزگشایی نام شبکه("Office\\x20Guest")
پایان
