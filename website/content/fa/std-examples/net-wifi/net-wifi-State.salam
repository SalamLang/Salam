// زبان: فارسی
واردسازی شبکه.وای‌فای

تابع ریشه:
    هر ست در [
        وای‌فای.وضعیت اتصال.نامعلوم، وای‌فای.وضعیت اتصال.بدون وای فای، وای‌فای.وضعیت اتصال.قطع،
        وای‌فای.وضعیت اتصال.وصل
    ]:
        س := وای‌فای.وضعیت { حالت = ست }
        سرچاپ وای‌فای.نام وضعیت(ست)، س.وصل است()
    پایان
    سرچاپ وای‌فای.نام اعتماد(وای‌فای.اعتماد.روی وای فای نیست)،
        وای‌فای.نام اعتماد(وای‌فای.اعتماد.مورد اعتماد)،
        وای‌فای.نام اعتماد(وای‌فای.اعتماد.نامطمئن)
پایان
