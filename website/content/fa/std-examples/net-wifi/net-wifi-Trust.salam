// زبان: فارسی
واردسازی شبکه.وای‌فای

تابع ریشه:
    ناپایا تروستید := وکتور {} برگردان وکتور<رشته>
    دیرکن تروستید.آزاد()
    تروستید.افزودن("Home")
    تروستید.افزودن("de:ad:be:ef:00:01")
    هومی := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "Home"،
        نام شبکه معلوم = درست،
        امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو
    }
    کافی := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        نام شبکه = "Cafe"،
        نام شبکه معلوم = درست،
        امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای دو
    }
    پنهان := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل،
        امنیت = وای‌فای.امنیت شبکه.دبلیو پی ای سه،
        دلیل = "the system withheld the SSID"
    }
    پنهان بازکردن := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل، امنیت = وای‌فای.امنیت شبکه.باز
    }
    کنوون اپ := وای‌فای.وضعیت {
        حالت = وای‌فای.وضعیت اتصال.وصل، نشانی نقطه دسترسی = "DE:AD:BE:EF:00:01"
    }
    ویرید := وای‌فای.وضعیت { حالت = وای‌فای.وضعیت اتصال.قطع }
    هر س در [هومی، کافی، پنهان، پنهان بازکردن، کنوون اپ، ویرید]:
        ت := وای‌فای.سنجش اعتماد(س، تروستید)
        سرچاپ وای‌فای.نام اعتماد(ت)،
            وای‌فای.نامطمئن است(س، تروستید)،
            ت برابر وای‌فای.اعتماد.اعتماد نامعلوم
    پایان
پایان
