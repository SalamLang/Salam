واردسازی نود

روال ریشه:
    سرچاپ نود.سکو().طول() > ۰، نود.ویندوز است() == (نود.سکو() == "win32")
    پوشه := نود.ساخت پوشه موقت(نود.پیوستن مسیر(نود.پوشه موقت()، "salam-"))
    مسیر := نود.پیوستن مسیر سه(پوشه، "داده"، "یادداشت.txt")
    سرچاپ نود.پوشه مسیر(مسیر) == نود.پیوستن مسیر(پوشه، "داده")
    fs := نود.واردکردن("fs")
    _ := نود.فراخوان رشته یک(fs، "mkdirSync"، نود.پوشه مسیر(مسیر))
    نود.نوشتن فایل(مسیر، "سلام از نود")
    سرچاپ نود.خواندن فایل(مسیر)
    نود.حذف بازگشتی(پوشه)

    ش := نود.شیء تازه()
    نود.تنظیم خاصیت رشته ای(ش، "name"، "مریم")
    نود.تنظیم خاصیت عددی(ش، "age"، ۳۰)
    نود.تنظیم خاصیت منطقی(ش، "admin"، درست)
    آ := نود.آرایه تازه()
    نود.افزودن رشته به آرایه(آ، "a")
    نود.افزودن به آرایه(آ، ش)
    نود.تنظیم خاصیت(ش، "tags"، آ)
    سرچاپ نود.دریافت خاصیت رشته ای(ش، "name")، نود.دریافت خاصیت عددی(ش، "age")، نود.دریافت خاصیت منطقی(ش، "admin")
    سرچاپ نود.دریافت خاصیت عددی(نود.دریافت خاصیت(ش، "tags")، "length")
    جیسون := نود.سراسری("JSON")
    سرچاپ نود.تبدیل به رشته(نود.فراخوان رشته یک(جیسون، "stringify"، "x"))
    سرچاپ نود.بی‌مقدار است(نود.دریافت خاصیت(ش، "missing"))، نود.تبدیل به منطقی(نود.دریافت خاصیت(ش، "admin"))

    ریاضی := نود.سراسری("Math")
    سرچاپ نود.تبدیل به رشته(نود.فراخوان با دو مقدار(ریاضی، "max"، نود.دریافت خاصیت(ش، "age")، نود.دریافت خاصیت(ش، "age")))
    تاریخ := نود.ساخت با یک مقدار(نود.سراسری("Date")، نود.دریافت خاصیت(ش، "age"))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان(تاریخ، "getTime"))
    path := نود.واردکردن("path")
    سرچاپ نود.تبدیل به رشته(نود.فراخوان رشته دو(path، "join"، "a"، "b"))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان رشته سه(path، "join"، "a"، "b"، "c"))
    نود.تنظیم خاصیت به تابع بدون آرگومان(ش، "hello"، ():
        سرچاپ "سلام از تابع"
    پایان)
    _ := نود.فراخوان(ش، "hello")
    نود.تنظیم خاصیت به تابع یک آرگومانی بازگشتی(ش، "twice"، (x: صحیح۶۴) => نود.فراخوان با دو مقدار(ریاضی، "max"، x، x))
    سرچاپ نود.تبدیل به رشته(نود.فراخوان مقدار تابع با یک آرگومان(نود.دریافت خاصیت(ش، "twice")، نود.دریافت خاصیت(ش، "age")))
    سرچاپ نود.بی‌مقدار است(نود.صادرات())
