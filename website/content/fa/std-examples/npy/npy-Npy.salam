واردسازی ان‌پی‌وای
واردسازی ماتریس

تابع ریشه:
    ناپایا م := ماتریس.ماتریس { rows = ۲، cols = ۳ }
    تکرار ۶ در ای:
        م.a.بیفزا(ای برگردان اعشار۶۴)
    پایان
    ناپایا آ := ان‌پی‌وای.از ماتریس(م)
    سرچاپ آ.shape، آ.شمار بعد()، آ.شمار()، آ.dtype == ان‌پی‌وای.نوع اعشاری هشت
    ب := ان‌پی‌وای.نوشتن ان‌پی‌وای(آ)
    سرچاپ ب.len > ۶۴
    ناپایا خوب := نادرست
    ناپایا خوانده := ان‌پی‌وای.خواندن ان‌پی‌وای(ب.data، ب.len، خوب)
    سرچاپ خوب، خوانده.shape، خوانده.data
    م۲ := ان‌پی‌وای.به ماتریس(خوانده، خوب)
    سرچاپ خوب، م۲.عنصر(۱، ۲)
    سرچاپ ان‌پی‌وای.نوشتن پرونده ان‌پی‌وای(آ، "a.npy")
    ناپایا از پرونده := ان‌پی‌وای.خواندن پرونده ان‌پی‌وای("a.npy"، خوب)
    سرچاپ خوب، از پرونده.شمار()
    ناپایا کلیدها := وکتور {} برگردان وکتور<رشته>
    کلیدها.بیفزا("x")
    کلیدها.بیفزا("y")
    ناپایا آرایه‌ها := وکتور {} برگردان وکتور<ان‌پی‌وای.آرایه ان‌پی‌وای>
    آرایه‌ها.بیفزا(آ)
    آرایه‌ها.بیفزا(خوانده)
    سرچاپ ان‌پی‌وای.نوشتن ان‌پی‌زد("ab.npz"، کلیدها، آرایه‌ها)
    سرچاپ ان‌پی‌وای.فهرست ان‌پی‌زد("ab.npz"، خوب)، خوب
    ناپایا ی := ان‌پی‌وای.خواندن ان‌پی‌زد("ab.npz"، "y"، خوب)
    سرچاپ خوب، ی.shape
    سرچاپ ان‌پی‌وای.نوع اعشاری چهار، ان‌پی‌وای.نوع صحیح یک، ان‌پی‌وای.نوع صحیح دو، ان‌پی‌وای.نوع صحیح چهار، ان‌پی‌وای.نوع صحیح هشت، ان‌پی‌وای.نوع بی‌علامت یک، ان‌پی‌وای.نوع بی‌علامت دو، ان‌پی‌وای.نوع بی‌علامت چهار، ان‌پی‌وای.نوع دودویی
    ی.آزادسازی()
    از پرونده.آزادسازی()
    خوانده.آزادسازی()
    آ.آزادسازی()
پایان
