واردسازی ان‌پی‌وای
واردسازی ماتریس

تابع ریشه خطادار:
    ناپایا م := ماتریس.ماتریس { سطرها = ۲، ستون‌ها = ۳ }
    تکرار ۶ در ای:
        م.درایه‌ها.بیفزا(ای برگردان اعشار۶۴)
    پایان
    ناپایا آ := ان‌پی‌وای.از ماتریس(م)
    سرچاپ آ.شکل، آ.شمار بعد()، آ.شمار()، آ.نوع داده == ان‌پی‌وای.نوع اعشاری هشت
    ب := ان‌پی‌وای.نوشتن ان‌پی‌وای(آ)
    سرچاپ ب.طول > ۶۴
    ناپایا خوانده := تلاش ان‌پی‌وای.خواندن ان‌پی‌وای(ب.داده، ب.طول)
    سرچاپ خوانده.شکل، خوانده.عنصرها
    م۲ := تلاش ان‌پی‌وای.به ماتریس(خوانده)
    سرچاپ م۲.عنصر(۱، ۲)
    سرچاپ ان‌پی‌وای.نوشتن پرونده ان‌پی‌وای(آ، "a.npy")
    ناپایا از پرونده := تلاش ان‌پی‌وای.خواندن پرونده ان‌پی‌وای("a.npy")
    سرچاپ از پرونده.شمار()
    ناپایا کلیدها := وکتور {} برگردان وکتور<رشته>
    کلیدها.بیفزا("x")
    کلیدها.بیفزا("y")
    ناپایا آرایه‌ها := وکتور {} برگردان وکتور<ان‌پی‌وای.آرایه ان‌پی‌وای>
    آرایه‌ها.بیفزا(آ)
    آرایه‌ها.بیفزا(خوانده)
    سرچاپ ان‌پی‌وای.نوشتن ان‌پی‌زد("ab.npz"، کلیدها، آرایه‌ها)
    سرچاپ تلاش ان‌پی‌وای.فهرست ان‌پی‌زد("ab.npz")
    ناپایا ی := تلاش ان‌پی‌وای.خواندن ان‌پی‌زد("ab.npz"، "y")
    سرچاپ ی.شکل
    تلاش:
        ان‌پی‌وای.خواندن ان‌پی‌زد("ab.npz"، "z")
    گرفتن خطا خ:
        سرچاپ خ.کد
    پایان
    سرچاپ ان‌پی‌وای.نوع اعشاری چهار، ان‌پی‌وای.نوع صحیح یک، ان‌پی‌وای.نوع صحیح دو، ان‌پی‌وای.نوع صحیح چهار، ان‌پی‌وای.نوع صحیح هشت، ان‌پی‌وای.نوع بی‌علامت یک، ان‌پی‌وای.نوع بی‌علامت دو، ان‌پی‌وای.نوع بی‌علامت چهار، ان‌پی‌وای.نوع دودویی
    ی.آزادسازی()
    از پرونده.آزادسازی()
    خوانده.آزادسازی()
    آ.آزادسازی()
پایان
