واردسازی اپن‌سی‌وی

تابع ریشه:
    اگر وارونه اپن‌سی‌وی.در دسترس():
        سرچاپ "OpenCV در دسترس نیست:"، اپن‌سی‌وی.آخرین خطا()
        برگشت
    پایان
    سرچاپ اپن‌سی‌وی.نسخه()
    ناپایا عکس := اپن‌سی‌وی.خواندن("photo.jpg")
    اگر وارونه عکس.معتبر() یا عکس.خالی():
        عکس = اپن‌سی‌وی.بوم خالی(۳۲۰، ۲۴۰، ۳، اپن‌سی‌وی.سفید())
    پایان
    اندازه := عکس.اندازه()
    سرچاپ عکس.عرض()، عکس.ارتفاع()، عکس.کانال‌ها()، اندازه.width، اندازه.height، عکس.گام()، عکس.مجموع()، عکس.داده() != پوچ
    رنگ := عکس.عنصر(۱۰، ۱۰)
    سرچاپ رنگ.r، رنگ.g، رنگ.b
    عکس.تنظیم پیکسل(۰، ۰، اپن‌سی‌وی.آر‌جی‌بی(۲۵۵، ۱۲۸، ۰))
    سیاه := اپن‌سی‌وی.صفرها(۱۰، ۱۰، ۱)
    سرچاپ سیاه.کانال‌ها()، اپن‌سی‌وی.سیاه().r، اپن‌سی‌وی.قرمز().r، اپن‌سی‌وی.سبز().g، اپن‌سی‌وی.آبی().b

    خاکستری := عکس.به خاکستری()
    _ := عکس.به آر‌جی‌بی()
    اچ := عکس.به اچ‌اس‌وی()
    _ := اچ.اچ‌اس‌وی به آر‌جی‌بی()
    _ := عکس.تبدیل رنگ(اپن‌سی‌وی.بی‌جی‌آر به خاکستری)
    _ := خاکستری.تبدیل رنگ(اپن‌سی‌وی.خاکستری به بی‌جی‌آر)
    سرچاپ اپن‌سی‌وی.آر‌جی‌بی به خاکستری، اپن‌سی‌وی.خاکستری به آر‌جی‌بی، اپن‌سی‌وی.بی‌جی‌آر به آر‌جی‌بی، اپن‌سی‌وی.آر‌جی‌بی به بی‌جی‌آر، اپن‌سی‌وی.بی‌جی‌آر به اچ‌اس‌وی، اپن‌سی‌وی.اچ‌اس‌وی به بی‌جی‌آر، اپن‌سی‌وی.آر‌جی‌بی به اچ‌اس‌وی، اپن‌سی‌وی.اچ‌اس‌وی به آر‌جی‌بی

    کوچک := عکس.تغییر اندازه(۱۶۰، ۱۲۰، اپن‌سی‌وی.مساحتی)
    _ := عکس.تغییر اندازه با ضریب(۲.۰، ۲.۰)
    _ := عکس.برش(۱۰، ۱۰، ۱۰۰، ۸۰)
    _ := عکس.چرخش نود درجه(اپن‌سی‌وی.چرخش نود درجه ساعتگرد)
    _ := عکس.چرخش(۴۵.۰، ۱.۰)
    _ := عکس.بازتاب(اپن‌سی‌وی.بازتاب دوطرفه)
    _ := عکس.بازتاب افقی()
    _ := عکس.بازتاب عمودی()
    سرچاپ اپن‌سی‌وی.نزدیک‌ترین، اپن‌سی‌وی.خطی، اپن‌سی‌وی.مکعبی، اپن‌سی‌وی.لانچوس چهار، اپن‌سی‌وی.چرخش صدوهشتاد درجه، اپن‌سی‌وی.چرخش نود درجه پادساعتگرد، اپن‌سی‌وی.بازتاب عمودی، اپن‌سی‌وی.بازتاب افقی
    کپی := کوچک.کپی()
    سرچاپ کپی.ذخیره("small.png")، اپن‌سی‌وی.نوشتن("gray.png"، خاکستری)
    کپی.آزادسازی()
    عکس.آزادسازی()
پایان
