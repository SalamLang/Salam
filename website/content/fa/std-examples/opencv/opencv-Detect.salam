واردسازی اپن‌سی‌وی
واردسازی تصویر

روال ریشه:
    ناپایا آبشار := اپن‌سی‌وی.بارگذاری آبشار("haarcascade_frontalface_default.xml")
    ناپایا عکس := اپن‌سی‌وی.خواندن("people.jpg")
    اگر آبشار.معتبر():
        هر چهره در آبشار.شناسایی(عکس.به خاکستری()، ۱.۱، ۵، ۱۰۰):
            عکس.مستطیل(چهره.x، چهره.y، چهره.width، چهره.height، اپن‌سی‌وی.سبز()، ۲)
        پایان
    پایان
    آبشار.آزادسازی()

    ناپایا شبکه := اپن‌سی‌وی.بارگذاری شبکه("MobileNetSSD.caffemodel"، "MobileNetSSD.prototxt")
    ناپایا تک := اپن‌سی‌وی.بارگذاری شبکه تک‌فایل("model.onnx")
    اگر شبکه.معتبر():
        _ := شبکه.تنظیم ورودی(عکس، ۰.۰۰۷۸۴۳، اپن‌سی‌وی.آر‌جی‌بی(۱۲۷، ۱۲۷، ۱۲۷)، نادرست، اپن‌سی‌وی.اندازه { width = ۳۰۰، height = ۳۰۰ })
        خروجی := شبکه.پیش‌رو()
        _ := شبکه.پیش‌رو لایه("detection_out")
        هر شیء در اپن‌سی‌وی.تجزیه شناسایی‌های اس‌اس‌دی(خروجی، عکس.عرض()، عکس.ارتفاع()، ۰.۵):
            سرچاپ شیء.class_id، شیء.confidence، شیء.x، شیء.y، شیء.width، شیء.height
        پایان
    پایان
    شبکه.آزادسازی()
    تک.آزادسازی()

    ناپایا ویدیو := اپن‌سی‌وی.بازکردن ویدیو("clip.mp4")
    ناپایا دوربین := اپن‌سی‌وی.بازکردن دوربین(۰)
    ناپایا نویسنده := اپن‌سی‌وی.نویسنده ویدیو جدید("out.mp4"، "mp4v"، ویدیو.فریم در ثانیه()، ۶۴۰، ۴۸۰)
    سرچاپ ویدیو.معتبر()، ویدیو.تعداد فریم()، دوربین.معتبر()، نویسنده.معتبر()
    اپن‌سی‌وی.ایجاد نوار لغزنده("آستانه"، "پیش‌نمایش"، ۱۰۰، ۲۵۵)
    تا ویدیو.معتبر():
        فریم := ویدیو.خواندن()
        اگر فریم.خالی():
            بشکن
        پایان
        آستانه := اپن‌سی‌وی.موقعیت نوار لغزنده("آستانه"، "پیش‌نمایش")
        لبه := فریم.به خاکستری().لبه‌یابی کنی(آستانه برگردان اعشار۶۴، ۲۰۰.۰)
        _ := نویسنده.نوشتن(فریم)
        اپن‌سی‌وی.نمایش تصویر("پیش‌نمایش"، لبه)
        اگر اپن‌سی‌وی.انتظار کلید(۱) == ۲۷:
            بشکن
        پایان
    پایان
    اپن‌سی‌وی.تنظیم موقعیت نوار لغزنده("آستانه"، "پیش‌نمایش"، ۵۰)
    اپن‌سی‌وی.بستن پنجره("پیش‌نمایش")
    اپن‌سی‌وی.بستن همه پنجره‌ها()
    ویدیو.بستن()
    دوربین.بستن()
    نویسنده.بستن()

    تصویری := اپن‌سی‌وی.به تصویر(عکس)
    سرچاپ تصویری.width
    _ := اپن‌سی‌وی.از تصویر(تصویر.جدید(۸، ۸))
پایان
