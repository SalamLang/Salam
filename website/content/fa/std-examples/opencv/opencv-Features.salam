واردسازی اپن‌سی‌وی

تابع ریشه:
    ناپایا الف := اپن‌سی‌وی.خواندن("scene.jpg")
    ناپایا ب := اپن‌سی‌وی.خواندن("object.jpg")
    ناپایا پیرامون := الف.به خاکستری().آستانه اوتسو(۲۵۵.۰).یافتن پیرامون‌ها()
    سرچاپ پیرامون.معتبر()، پیرامون.تعداد()
    تکرار پیرامون.تعداد() در ش:
        کادر := پیرامون.مستطیل محاط(ش)
        سرچاپ پیرامون.مساحت(ش)، پیرامون.تعداد نقطه(ش)، پیرامون.نقطه(ش، ۰).x، کادر.x، کادر.y، کادر.width، کادر.height
        الف.رسم پیرامون(پیرامون، ش، اپن‌سی‌وی.سبز()، ۲)
    پایان
    پیرامون.آزادسازی()

    گوشه‌ها := الف.به خاکستری().ویژگی‌های خوب(۵۰، ۰.۰۱، ۱۰.۰)
    سرچاپ گوشه‌ها.طول()
    ناپایا کلیدی۱ := الف.شناسایی اور‌بی(۵۰۰)
    ناپایا کلیدی۲ := ب.شناسایی اور‌بی(۵۰۰)
    ناپایا سیفت := الف.شناسایی سیفت(۵۰۰)
    سرچاپ کلیدی۱.معتبر()، کلیدی۱.تعداد()، سیفت.تعداد()
    اگر کلیدی۱.تعداد() > ۰:
        نخست := کلیدی۱.دریافت(۰)
        سرچاپ نخست.x، نخست.y، نخست.size، نخست.angle، نخست.response
    پایان
    تطابق‌ها := اپن‌سی‌وی.تطبیق توصیف‌گرها(کلیدی۱.توصیف‌گرها()، کلیدی۲.توصیف‌گرها()، ۵۰، اپن‌سی‌وی.هنجار همینگ)
    هر ت در تطابق‌ها:
        سرچاپ ت.query_idx، ت.train_idx، ت.distance
    پایان
    سرچاپ اپن‌سی‌وی.هنجار ال۲
    کلیدی۱.آزادسازی()
    کلیدی۲.آزادسازی()
    سیفت.آزادسازی()

    یافته := الف.یافتن الگو(ب)
    سرچاپ یافته.found، یافته.x، یافته.y، یافته.score
    ناپایا گوشه := وکتور {} برگردان وکتور<اپن‌سی‌وی.نقطه>
    گوشه.بیفزا(اپن‌سی‌وی.نقطه { x = ۰، y = ۰ })
    گوشه.بیفزا(اپن‌سی‌وی.نقطه { x = ۴۰۰، y = ۱۰ })
    گوشه.بیفزا(اپن‌سی‌وی.نقطه { x = ۴۱۰، y = ۵۸۰ })
    گوشه.بیفزا(اپن‌سی‌وی.نقطه { x = ۵، y = ۵۹۰ })
    صاف := الف.تاب دیدگاهی(گوشه، ۴۲۰، ۵۹۴)
    _ := اپن‌سی‌وی.نوشتن("document.png"، صاف)
پایان
