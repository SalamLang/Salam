واردسازی اپن‌سی‌وی

تابع ریشه:
    ناپایا عکس := اپن‌سی‌وی.خواندن("photo.jpg")
    خاکستری := عکس.به خاکستری()
    _ := عکس.تاری(۵)
    _ := عکس.تاری گاوسی(۵، ۱.۵)
    _ := عکس.تاری میانه(۵)
    لبه := خاکستری.لبه‌یابی کنی(۵۰.۰، ۱۵۰.۰)
    _ := خاکستری.آستانه‌گذاری(۱۲۸.۰، ۲۵۵.۰، اپن‌سی‌وی.آستانه دودویی)
    _ := خاکستری.آستانه اوتسو(۲۵۵.۰)
    _ := خاکستری.آستانه تطبیقی(۲۵۵.۰، اپن‌سی‌وی.گاوسی تطبیقی، اپن‌سی‌وی.آستانه دودویی، ۱۱، ۲.۰)
    سرچاپ اپن‌سی‌وی.آستانه دودویی معکوس، اپن‌سی‌وی.آستانه برش، اپن‌سی‌وی.آستانه به صفر، اپن‌سی‌وی.آستانه به صفر معکوس، اپن‌سی‌وی.آستانه اوتسو، اپن‌سی‌وی.میانگین تطبیقی
    سرچاپ خاکستری.هیستوگرام خاکستری().طول()
    _ := لبه.فرسایش(۳، ۱)
    _ := لبه.اتساع(۳، ۲)
    _ := لبه.ریخت‌شناسی(اپن‌سی‌وی.بستن ریختی، ۵)
    سرچاپ اپن‌سی‌وی.باز کردن ریختی، اپن‌سی‌وی.گرادیان ریختی، اپن‌سی‌وی.کلاه بالایی ریختی، اپن‌سی‌وی.کلاه سیاه ریختی
    سفید := اپن‌سی‌وی.بوم خالی(عکس.عرض()، عکس.ارتفاع()، ۳، اپن‌سی‌وی.سفید())
    _ := عکس.ترکیب(سفید، ۰.۷، ۰.۳، ۰.۰)
    _ := عکس.بیتی(سفید، اپن‌سی‌وی.عطف بیتی)
    _ := عکس.بیتی(سفید، اپن‌سی‌وی.فصل بیتی)
    _ := عکس.بیتی(سفید، اپن‌سی‌وی.یای انحصاری بیتی)
    _ := عکس.نقیض بیتی()
    _ := عکس.تفاضل مطلق(سفید)
    عکس.خط(۰، ۰، ۱۰۰، ۱۰۰، اپن‌سی‌وی.قرمز()، ۲)
    عکس.مستطیل(۱۰، ۱۰، ۵۰، ۳۰، اپن‌سی‌وی.سبز()، ۱)
    عکس.دایره(۸۰، ۸۰، ۲۰، اپن‌سی‌وی.آبی()، -۱)
    عکس.بیضی(۱۰۰، ۵۰، ۴۰، ۲۰، ۳۰.۰، اپن‌سی‌وی.سیاه()، ۲)
    عکس.نوشتن متن("Salam"، ۱۰، ۲۰۰، ۱.۰، اپن‌سی‌وی.سفید()، ۲)
    ناپایا نقاط := وکتور {} برگردان وکتور<اپن‌سی‌وی.نقطه>
    نقاط.بیفزا(اپن‌سی‌وی.نقطه { x = ۰، y = ۰ })
    نقاط.بیفزا(اپن‌سی‌وی.نقطه { x = ۵۰، y = ۰ })
    نقاط.بیفزا(اپن‌سی‌وی.نقطه { x = ۲۵، y = ۴۰ })
    عکس.چندخطی(نقاط، درست، اپن‌سی‌وی.قرمز()، ۲)
    عکس.پر کردن چندضلعی(نقاط، اپن‌سی‌وی.سبز())
    _ := اپن‌سی‌وی.نوشتن("filtered.png"، عکس)
