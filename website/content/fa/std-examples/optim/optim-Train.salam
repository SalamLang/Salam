واردسازی بهینه‌سازی
واردسازی شبکه عصبی
واردسازی مشتق‌گیری خودکار
واردسازی تانسور

تابع آموزش(روش: صحیح، گام‌ها: صحیح، هدف &: تانسور.تانسور): اعشار۶۴:
    ناپایا مخزن := شبکه عصبی.مخزن پارامتر {}
    دستگیره := مخزن.افزودن("w"، تانسور.صفرها یک(۴))
    ناپایا آدام := بهینه‌سازی.آدام { lr = ۰.۱ }
    ناپایا آدام دبلیو := بهینه‌سازی.آدام دابلیو جدید(۰.۱، ۰.۰۱)
    ناپایا آر ام اس := بهینه‌سازی.آر ام اس پراپ { lr = ۰.۰۵ }
    ناپایا اس جی دی := بهینه‌سازی.گرادیان کاهشی تصادفی { lr = ۰.۰۵، momentum = ۰.۹ }
    ناپایا نوار := مشتق‌گیری خودکار.نوار جدید(۱)
    تکرار گام‌ها:
        نوار.بازنشانی()
        مخزن.صفر کردن گرادیان()
        و۱ := شبکه عصبی.پیوند(نوار، مخزن، دستگیره)
        ه := مشتق‌گیری خودکار.ورودی(نوار، هدف)
        زیان := مشتق‌گیری خودکار.مجموع(نوار، مشتق‌گیری خودکار.مربع(نوار، مشتق‌گیری خودکار.تفریق(نوار، و۱، ه)))
        مشتق‌گیری خودکار.پس‌انتشار(نوار، زیان)
        _ := بهینه‌سازی.برش نُرم گرادیان(مخزن، ۱۰.۰)
        بهینه‌سازی.برش مقدار گرادیان(مخزن، ۵.۰)
        اگر روش == ۰:
            آدام.گام(مخزن)
        وگرنه روش == ۱:
            آدام دبلیو.گام(مخزن)
        وگرنه روش == ۲:
            آر ام اس.گام(مخزن)
        وگرنه:
            اس جی دی.گام(مخزن)
        پایان
    پایان
    ناپایا پ := مخزن.عنصر(دستگیره)
    نتیجه := پ.value.عنصر(۳)
    نوار.آزادسازی()
    آدام.آزادسازی()
    آدام دبلیو.آزادسازی()
    آر ام اس.آزادسازی()
    اس جی دی.آزادسازی()
    مخزن.آزادسازی()
    برگشت نتیجه
پایان

تابع ریشه:
    ناپایا هدف := تانسور.بازه گام(۴)
    هر روش در [۰، ۱، ۲، ۳]:
        گرد := (آموزش(روش، ۴۰۰، هدف) * ۱۰۰.۰ + ۰.۵) برگردان صحیح
        سرچاپ روش، گرد
    پایان
    تانسور.آزادسازی(هدف)
    سرچاپ بهینه‌سازی.نرخ پله‌ای(۱.۰، ۲۵، ۱۰، ۰.۵)، بهینه‌سازی.نرخ کسینوسی(۱.۰، ۵۰، ۱۰۰، ۰.۰)، بهینه‌سازی.گرمایش سپس کسینوس(۱.۰، ۰، ۱۰، ۱۱۰، ۰.۰)
پایان
