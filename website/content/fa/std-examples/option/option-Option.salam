واردسازی اختیاری

روال جستجو(نام‌ها: وکتور<رشته>، دنبال: رشته): اختیاری.اختیاری<صحیح>:
    هر ش، ن در نام‌ها:
        اگر ن == دنبال:
            برگشت اختیاری.یک مقدار(ش)
        پایان
    پایان
    برگشت اختیاری.هیچ مقدار()
پایان

روال ریشه:
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن نام‌ها.آزادکن()
    نام‌ها.بیفزا("علی")
    نام‌ها.بیفزا("مریم")
    ی := جستجو(نام‌ها، "مریم")
    ن := جستجو(نام‌ها، "رضا")
    سرچاپ اختیاری.دارد(ی)، اختیاری.ندارد(ی)، ی.value، ی.present
    سرچاپ اختیاری.دارد(ن)، اختیاری.ندارد(ن)
    سرچاپ اختیاری.بازکن(ی)، اختیاری.انتظار(ی، "باید پیدا می‌شد")
    سرچاپ اختیاری.یابرگردان(ن، -۱)
پایان
