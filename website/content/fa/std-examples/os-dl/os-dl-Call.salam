واردسازی سیستم عامل.بارگذاری کتابخانه

تابع ریشه:
    اگر وارونه بارگذاری کتابخانه.پشتیبانی می شود():
        سرچاپ "not supported here"
        برگشت
    پایان
    lib := بارگذاری کتابخانه.باز کردن برنامه()
    دیرکن بارگذاری کتابخانه.بستن(lib)
    text := "hello, world"
    length := بارگذاری کتابخانه.فراخوانی(بارگذاری کتابخانه.نماد(lib، "strlen")، [(text برگردان تهی*) برگردان اندازه])
    سرچاپ "strlen:"، length
    سرچاپ "labs:"، بارگذاری کتابخانه.فراخوانی(بارگذاری کتابخانه.نماد(lib، "labs")، [(0 - 42) برگردان اندازه])
    سرچاپ "missing symbol:"، بارگذاری کتابخانه.نماد(lib، "no_such_function") برابر پوچ
    missing := بارگذاری کتابخانه.باز کردن("libno-such-library.so.9")
    سرچاپ "missing library:"، missing برابر پوچ، بارگذاری کتابخانه.خطا().طول() بزرگتر 0
پایان
