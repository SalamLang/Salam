واردسازی سیستم عامل.بارگذاری کتابخانه

تابع ریشه:
    اگر وارونه بارگذاری کتابخانه.پشتیبانی می شود():
        سرچاپ "not supported here"
        برگشت
    پایان
    متغیر_lib := بارگذاری کتابخانه.باز کردن برنامه()
    دیرکن بارگذاری کتابخانه.بستن(متغیر_lib)
    متن := "hello, world"
    درازا := بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(متغیر_lib، "strlen")، [(متن برگردان تهی*) برگردان اندازه])
    سرچاپ "strlen:"، درازا
    سرچاپ "labs:"، بارگذاری کتابخانه.فراخوان(بارگذاری کتابخانه.نماد(متغیر_lib، "labs")، [(0 - 42) برگردان اندازه])
    سرچاپ "missing symbol:"، بارگذاری کتابخانه.نماد(متغیر_lib، "no_such_function") برابر پوچ
    گمشده := بارگذاری کتابخانه.باز کردن("libno-such-library.so.9")
    سرچاپ "missing library:"، گمشده برابر پوچ، بارگذاری کتابخانه.خطا().طول() بزرگتر 0
پایان
