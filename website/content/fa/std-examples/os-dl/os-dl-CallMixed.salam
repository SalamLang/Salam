واردسازی سیستم عامل.بارگذاری کتابخانه

تابع ریشه:
    اگر وارونه بارگذاری کتابخانه.پشتیبانی می شود():
        سرچاپ "not supported here"
        برگشت
    پایان
    متغیر_lib := بارگذاری کتابخانه.باز کردن برنامه()
    دیرکن بارگذاری کتابخانه.بستن(متغیر_lib)
    ناپایا تعداد۲ := متغیر_lib
    اگر سلام سیستم لینوکس:
        تعداد۲ = بارگذاری کتابخانه.باز کردن("libm.so.6")
    پایان
    سرچاپ "pow:"، بارگذاری کتابخانه.فراخوانی ترکیبی اعشار(بارگذاری کتابخانه.نماد(تعداد۲، "pow")، [0 برگردان اندازه]، [2.0، 10.0])
    سرچاپ "ldexp:"، بارگذاری کتابخانه.فراخوانی ترکیبی اعشار(بارگذاری کتابخانه.نماد(تعداد۲، "ldexp")، [3 برگردان اندازه]، [1.5])
    سرچاپ "lround:"، بارگذاری کتابخانه.فراخوانی ترکیبی(بارگذاری کتابخانه.نماد(تعداد۲، "lround")، [0 برگردان اندازه]، [2.6])
پایان
