واردسازی سیستم عامل.بارگذاری کتابخانه

تابع ریشه:
    اگر وارونه بارگذاری کتابخانه.پشتیبانی می شود():
        سرچاپ "not supported here"
        برگشت
    پایان
    lib := بارگذاری کتابخانه.باز کردن برنامه()
    دیرکن بارگذاری کتابخانه.بستن(lib)
    ناپایا m := lib
    اگر سلام سیستم لینوکس:
        m = بارگذاری کتابخانه.باز کردن("libm.so.6")
    پایان
    سرچاپ "pow:"، بارگذاری کتابخانه.فراخوانی ترکیبی اعشار(بارگذاری کتابخانه.نماد(m، "pow")، [0 برگردان اندازه]، [2.0، 10.0])
    سرچاپ "ldexp:"، بارگذاری کتابخانه.فراخوانی ترکیبی اعشار(بارگذاری کتابخانه.نماد(m، "ldexp")، [3 برگردان اندازه]، [1.5])
    سرچاپ "lround:"، بارگذاری کتابخانه.فراخوانی ترکیبی(بارگذاری کتابخانه.نماد(m، "lround")، [0 برگردان اندازه]، [2.6])
پایان
