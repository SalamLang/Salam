// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان("echo $GREETING from $(pwd); echo trouble 1>&2")
    cmd.تنظیم محیط("GREETING"، "salam")
    cmd.پوشه کاری = "/"
    cmd.حالت خروجی = فرآیند.لوله
    cmd.حالت خطا = فرآیند.ادغام
    ناپایا child := فرآیند.اجرای فرزند(cmd)
    all := child.خواندن به مدت(2000)
    چاپ all.داده
    all.آزادسازی()
    سرچاپ "خروج:"، child.انتظار(2000).کد
    child.بستن()
    cmd.آزادسازی()
پایان
