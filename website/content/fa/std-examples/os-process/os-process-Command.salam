// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان("echo $GREETING from $(pwd); echo trouble 1>&2")
    فرمان.تنظیم محیط("GREETING"، "salam")
    فرمان.پوشه کاری = "/"
    فرمان.حالت خروجی = فرآیند.لوله
    فرمان.حالت خطا = فرآیند.ادغام
    ناپایا فرزند_فرآیند := فرآیند.اجرای فرزند(فرمان)
    متغیر_all := فرزند_فرآیند.خواندن به مدت(2000)
    چاپ متغیر_all.داده
    متغیر_all.آزادسازی()
    سرچاپ "خروج:"، فرزند_فرآیند.انتظار(2000).کد
    فرزند_فرآیند.بستن()
    فرمان.آزادسازی()
پایان
