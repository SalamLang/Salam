    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("30")
    ناپایا ف := فرآیند.شروع("/bin/sleep"، آرگ)
    سرچاپ فرآیند.در حال اجرا(ف)
