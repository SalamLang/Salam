// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("cat")
    فرمان.همه لوله()
    ناپایا فرزند_فرآیند := فرآیند.اجرای فرزند(فرمان)
    فرزند_فرآیند.نوشتن("hello child\n")
    خط := فرزند_فرآیند.خواندن خط(2000)
    سرچاپ "دریافت شد:"، خط.داده
    خط.آزادسازی()
    فرزند_فرآیند.بستن ورودی()
    وضعیت := فرزند_فرآیند.انتظار(2000)
    سرچاپ "کد خروج:"، وضعیت.کد
    فرزند_فرآیند.بستن()
    فرمان.آزادسازی()
پایان
