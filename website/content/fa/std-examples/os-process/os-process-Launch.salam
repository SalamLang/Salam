// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("cat")
    cmd.همه لوله()
    ناپایا child := فرآیند.اجرای فرزند(cmd)
    child.نوشتن("hello child\n")
    line := child.خواندن خط(2000)
    سرچاپ "دریافت شد:"، line.داده
    line.آزادسازی()
    child.بستن ورودی()
    status := child.انتظار(2000)
    سرچاپ "کد خروج:"، status.کد
    child.بستن()
    cmd.آزادسازی()
پایان
