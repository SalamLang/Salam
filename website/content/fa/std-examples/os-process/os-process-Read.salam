// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان("printf 'abcdef'; sleep 0.2; printf 'ghi:tail\\n'")
    فرمان.حالت خروجی = فرآیند.لوله
    ناپایا فرزند_فرآیند := فرآیند.اجرای فرزند(فرمان)
    نخست := فرزند_فرآیند.خواندن تعداد(4، 2000)
    سرچاپ "چهار بایت:"، نخست.داده
    متغیر_upto := فرزند_فرآیند.خواندن برای متن(":"، 2000)
    سرچاپ "تا دونقطه:"، متغیر_upto.داده
    آرام := فرزند_فرآیند.خواندن خط(2000)
    سرچاپ "باقی خط:"، آرام.داده
    متغیر_end_of := فرزند_فرآیند.خواندن موجود(2000)
    سرچاپ "تمام شد:"، متغیر_end_of.پایان
    نخست.آزادسازی()
    متغیر_upto.آزادسازی()
    آرام.آزادسازی()
    متغیر_end_of.آزادسازی()
    وضعیت := فرزند_فرآیند.انتظار(2000)
    سرچاپ "موفق:"، وضعیت.موفق()
    فرزند_فرآیند.بستن()
    فرمان.آزادسازی()
پایان
