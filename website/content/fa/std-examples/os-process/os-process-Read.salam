// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان("printf 'abcdef'; sleep 0.2; printf 'ghi:tail\\n'")
    cmd.حالت خروجی = فرآیند.لوله
    ناپایا child := فرآیند.اجرای فرزند(cmd)
    first := child.خواندن تعداد(4، 2000)
    سرچاپ "چهار بایت:"، first.داده
    upto := child.خواندن برای متن(":"، 2000)
    سرچاپ "تا دونقطه:"، upto.داده
    rest := child.خواندن خط(2000)
    سرچاپ "باقی خط:"، rest.داده
    end_of := child.خواندن موجود(2000)
    سرچاپ "تمام شد:"، end_of.پایان
    first.آزادسازی()
    upto.آزادسازی()
    rest.آزادسازی()
    end_of.آزادسازی()
    status := child.انتظار(2000)
    سرچاپ "موفق:"، status.موفق()
    child.بستن()
    cmd.آزادسازی()
پایان
