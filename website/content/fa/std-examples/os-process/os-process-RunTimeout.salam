// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا args := وکتور {} برگردان وکتور<رشته>
    دیرکن args.آزادکن()
    args.بیفزا("-c")
    args.بیفزا("echo fast output; echo warning 1>&2; exit 2")
    ناپایا quick := فرآیند.اجرا با مهلت("sh"، args، ""، 2000)
    سرچاپ "کد:"، quick.وضعیت.کد
    چاپ "خروجی:"، quick.خروجی
    چاپ "خطا:"، quick.خروجی خطا
    quick.آزادسازی()

    ناپایا slow_args := وکتور {} برگردان وکتور<رشته>
    دیرکن slow_args.آزادکن()
    slow_args.بیفزا("-c")
    slow_args.بیفزا("echo started; sleep 30")
    ناپایا slow := فرآیند.اجرا با مهلت("sh"، slow_args، ""، 300)
    سرچاپ "مهلت تمام شد:"، slow.مهلت تمام شد، "سیگنال:"، slow.وضعیت.سیگنال
    چاپ "بخشی از خروجی:"، slow.خروجی
    slow.آزادسازی()
پایان
