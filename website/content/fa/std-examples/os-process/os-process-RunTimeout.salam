// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا آرگومان‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگومان‌ها.آزادکن()
    آرگومان‌ها.بیفزا("-c")
    آرگومان‌ها.بیفزا("echo fast output; echo warning 1>&2; exit 2")
    ناپایا متغیر_quick := فرآیند.اجرا با مهلت("sh"، آرگومان‌ها، ""، 2000)
    سرچاپ "کد:"، متغیر_quick.وضعیت.کد
    چاپ "خروجی:"، متغیر_quick.خروجی
    چاپ "خطا:"، متغیر_quick.خروجی خطا
    متغیر_quick.آزادسازی()

    ناپایا متغیر_slow_args := وکتور {} برگردان وکتور<رشته>
    دیرکن متغیر_slow_args.آزادکن()
    متغیر_slow_args.بیفزا("-c")
    متغیر_slow_args.بیفزا("echo started; sleep 30")
    ناپایا کند := فرآیند.اجرا با مهلت("sh"، متغیر_slow_args، ""، 300)
    سرچاپ "مهلت تمام شد:"، کند.مهلت تمام شد، "سیگنال:"، کند.وضعیت.سیگنال
    چاپ "بخشی از خروجی:"، کند.خروجی
    کند.آزادسازی()
پایان
