// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sleep")
    cmd.افزودن آرگومان("30")
    ناپایا child := فرآیند.اجرای فرزند(cmd)
    سرچاپ "در حال اجرا:"، child.در حال اجرا()
    سرچاپ "فرستاده شد:"، child.پایان دادن()
    status := child.انتظار(2000)
    سرچاپ "سیگنال خورده:"، status.سیگنال خورد، "سیگنال:"، status.سیگنال
    سرچاپ "کد بازگشت:"، status.کد بازگشت()
    سرچاپ "در حال اجرا:"، child.در حال اجرا()
    child.بستن()
    cmd.آزادسازی()
پایان
