// زبان: فارسی
واردسازی سیستم عامل.فرآیند

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sleep")
    فرمان.افزودن آرگومان("30")
    ناپایا فرزند_فرآیند := فرآیند.اجرای فرزند(فرمان)
    سرچاپ "در حال اجرا:"، فرزند_فرآیند.در حال اجرا()
    سرچاپ "فرستاده شد:"، فرزند_فرآیند.پایان دادن()
    وضعیت := فرزند_فرآیند.انتظار(2000)
    سرچاپ "سیگنال خورده:"، وضعیت.سیگنال خورد، "سیگنال:"، وضعیت.سیگنال
    سرچاپ "کد بازگشت:"، وضعیت.کد بازگشت()
    سرچاپ "در حال اجرا:"، فرزند_فرآیند.در حال اجرا()
    فرزند_فرآیند.بستن()
    فرمان.آزادسازی()
پایان
