// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان("stty size")
    ناپایا term := پایانه مجازی.باز کردن(cmd، 30، 100)
    out := term.خواندن به مدت(1000)
    سرچاپ out.داده.پیراست()
    out.آزادسازی()
    سرچاپ "خروج:"، term.انتظار(2000).کد
    term.بستن()
    cmd.آزادسازی()
پایان
