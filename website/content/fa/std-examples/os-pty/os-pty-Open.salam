// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان("stty size")
    ناپایا پایانه := پایانه مجازی.باز کردن(فرمان، 30، 100)
    خروجی_مقدار := پایانه.خواندن به مدت(1000)
    سرچاپ خروجی_مقدار.داده.پیراست()
    خروجی_مقدار.آزادسازی()
    سرچاپ "خروج:"، پایانه.انتظار(2000).کد
    پایانه.بستن()
    فرمان.آزادسازی()
پایان
