// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا فرمان := فرآیند.فرمان تازه("sh")
    فرمان.افزودن آرگومان("-c")
    فرمان.افزودن آرگومان("read line; stty size")
    ناپایا پایانه := پایانه مجازی.باز کردن(فرمان، 24، 80)
    سرچاپ "آغاز:"، پایانه مجازی.گرفتن اندازه(پایانه).سطرها، پایانه مجازی.گرفتن اندازه(پایانه).ستون ها
    سرچاپ "تغییر اندازه:"، پایانه مجازی.تغییر اندازه(پایانه، 40، 120)
    سرچاپ "اکنون:"، پایانه مجازی.گرفتن اندازه(پایانه).سطرها، پایانه مجازی.گرفتن اندازه(پایانه).ستون ها
    پایانه.نوشتن("go\r")
    خروجی_مقدار := پایانه.خواندن برای متن("40 120"، 2000)
    سرچاپ "فرزند اندازه تازه را می‌بیند:"، وارونه خروجی_مقدار.مهلت تمام شد
    خروجی_مقدار.آزادسازی()
    سرچاپ "خروج:"، پایانه.انتظار(2000).کد
    پایانه.بستن()
    فرمان.آزادسازی()
پایان
