// زبان: فارسی
واردسازی سیستم عامل.فرآیند
واردسازی سیستم عامل.پایانه مجازی

تابع ریشه:
    ناپایا cmd := فرآیند.فرمان تازه("sh")
    cmd.افزودن آرگومان("-c")
    cmd.افزودن آرگومان("read line; stty size")
    ناپایا term := پایانه مجازی.باز کردن(cmd، 24، 80)
    سرچاپ "آغاز:"، پایانه مجازی.گرفتن اندازه(term).سطرها، پایانه مجازی.گرفتن اندازه(term).ستون ها
    سرچاپ "تغییر اندازه:"، پایانه مجازی.تغییر اندازه(term، 40، 120)
    سرچاپ "اکنون:"، پایانه مجازی.گرفتن اندازه(term).سطرها، پایانه مجازی.گرفتن اندازه(term).ستون ها
    term.نوشتن("go\r")
    out := term.خواندن برای متن("40 120"، 2000)
    سرچاپ "فرزند اندازه تازه را می‌بیند:"، وارونه out.مهلت تمام شد
    out.آزادسازی()
    سرچاپ "خروج:"، term.انتظار(2000).کد
    term.بستن()
    cmd.آزادسازی()
پایان
