واردسازی سیستم عامل.پوسته

تابع ریشه:
    ناپایا آرگ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ.آزادکن()
    آرگ.بیفزا("-n")
    آرگ.بیفزا("سلام")
    ن := پوسته.اجرا("echo"، آرگ)
    سرچاپ ن.code، "[" + ن.out + "]"
    ن۲ := پوسته.اجرا با متن فرمان("echo یک دو سه")
    سرچاپ ن۲.code، "[" + ن۲.out + "]"
    ناپایا آرگ۲ := وکتور {} برگردان وکتور<رشته>
    دیرکن آرگ۲.آزادکن()
    آرگ۲.بیفزا("-c")
    آرگ۲.بیفزا("echo خطا >&2; exit 3")
    ن۳ := پوسته.اجرا("sh"، آرگ۲)
    سرچاپ ن۳.code، "[" + ن۳.err + "]"
    سرچاپ پوسته.اجرای پوسته("true")، پوسته.اجرای پوسته("false") != ۰
پایان
