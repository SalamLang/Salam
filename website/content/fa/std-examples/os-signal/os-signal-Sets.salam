// زبان: فارسی
واردسازی حافظه
واردسازی سیستم عامل.سیگنال

تابع ریشه:
    سرچاپ "اندازه مجموعه به بایت:"، سیگنال.اندازه مجموعه سیگنال بزرگتر 0
    مجموعه := سیگنال.مجموعه جدید()
    _ := سیگنال.افزودن سیگنال(مجموعه، سیگنال.سیگنال کاربر۱)
    _ := سیگنال.افزودن سیگنال(مجموعه، سیگنال.سیگنال قطع)
    سرچاپ "SIGUSR1 دارد:"، سیگنال.عضو مجموعه است(مجموعه، سیگنال.سیگنال کاربر۱)
    _ := سیگنال.حذف سیگنال(مجموعه، سیگنال.سیگنال قطع)
    سرچاپ "SIGHUP دارد:"، سیگنال.عضو مجموعه است(مجموعه، سیگنال.سیگنال قطع)

    ذخیره := سیگنال.ماسک فعلی()
    _ := سیگنال.مسدود کردن(مجموعه)
    اکنون := سیگنال.ماسک فعلی()
    سرچاپ "SIGUSR1 مسدود است:"، سیگنال.عضو مجموعه است(اکنون، سیگنال.سیگنال کاربر۱)
    _ := سیگنال.رفع انسداد(مجموعه)
    _ := سیگنال.تنظیم ماسک(ذخیره)

    همه := سیگنال.مجموعه جدید()
    سیگنال.پر کردن مجموعه(همه)
    سرچاپ "مجموعه کامل SIGTERM دارد:"، سیگنال.عضو مجموعه است(همه، سیگنال.سیگنال خاتمه)

    حافظه.آزادسازی(همه)
    حافظه.آزادسازی(اکنون)
    حافظه.آزادسازی(ذخیره)
    حافظه.آزادسازی(مجموعه)
پایان
