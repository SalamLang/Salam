// زبان: فارسی
واردسازی حافظه
واردسازی سیستم عامل.سیگنال

تابع نادیده(_سیگ: صحیح):
    _ := _سیگ
پایان

تابع ریشه:
    سرچاپ "SIGINT"، سیگنال.سیگنال وقفه، "SIGTERM"، سیگنال.سیگنال خاتمه، "SIGKILL"، سیگنال.سیگنال کشتن
    سرچاپ "بقیه در هر سیستم فرق دارند:"، سیگنال.سیگنال کاربر۱ بزرگتر 0، سیگنال.سیگنال کاربر۲ بزرگتر 0، سیگنال.سیگنال فرزند بزرگتر 0
    سرچاپ "شماره‌های ثابت:"، سیگنال.سیگنال قطع، سیگنال.سیگنال خروج، سیگنال.سیگنال لوله، سیگنال.سیگنال زنگ، سیگنال.سیگنال اندازه پنجره
    سرچاپ "کنترل کار:"، سیگنال.سیگنال از سرگیری بزرگتر 0، سیگنال.سیگنال ایست بزرگتر 0، سیگنال.سیگنال توقف پایانه بزرگتر 0

    قبلی := سیگنال.نصب(سیگنال.سیگنال کاربر۱، &نادیده)
    مجموعه := سیگنال.مجموعه جدید()
    _ := سیگنال.افزودن سیگنال(مجموعه، سیگنال.سیگنال کاربر۱)
    خروجی := حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴)

    سرچاپ "مهلت تمام شد:"، سیگنال.انتظار با مهلت(مجموعه، خروجی، 50) برابر سیگنال.نتیجه اتمام مهلت
    _ := سیگنال.فرستادن به خود(سیگنال.سیگنال کاربر۱)
    سرچاپ "رسید:"، سیگنال.انتظار(مجموعه، خروجی) برابر سیگنال.نتیجه رسیدن
    _ := سیگنال.فرستادن به خود(سیگنال.سیگنال کاربر۱)
    سرچاپ "شماره:"، سیگنال.انتظار سیگنال(مجموعه) برابر سیگنال.سیگنال کاربر۱
    سرچاپ "آرگومان نادرست:"، سیگنال.انتظار(پوچ، خروجی) برابر سیگنال.نتیجه نامعتبر
    سرچاپ "وضعیت‌ها:"، سیگنال.نتیجه شکست کوچکتر 0، سیگنال.نتیجه مشغول کوچکتر 0

    حافظه.آزادسازی(خروجی)
    حافظه.آزادسازی(مجموعه)
    سرچاپ "بازگردانده شد:"، سیگنال.بازگردانی(سیگنال.سیگنال کاربر۱، قبلی)
    حافظه.آزادسازی(قبلی)
پایان
