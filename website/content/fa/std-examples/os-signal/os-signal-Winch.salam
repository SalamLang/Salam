// زبان: فارسی
واردسازی حافظه
واردسازی سیستم عامل.سیگنال

تابع ریشه:
    اگر وارونه سیگنال.تغییر اندازه پشتیبانی می شود():
        سرچاپ "ویندوز: اندازه پایانه را بپرسید"
        برگشت
    پایان
    قبلی := سیگنال.نصب گرداننده تغییر اندازه()
    _ := سیگنال.مسدود کردن تغییر اندازه()
    مجموعه := سیگنال.مجموعه تغییر اندازه جدید()
    _ := سیگنال.بیدار کردن تغییر اندازه()
    سرچاپ "بیدار شد با"، سیگنال.انتظار تغییر اندازه(مجموعه)، "که برابر است با"، سیگنال.سیگنال تغییر اندازه
    حافظه.آزادسازی(مجموعه)
    _ := سیگنال.بازگردانی(سیگنال.سیگنال تغییر اندازه، قبلی)
    حافظه.آزادسازی(قبلی)
پایان
