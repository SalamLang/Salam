واردسازی سیستم عامل

روال خروج با خطا(پیام: رشته):
    نادرست‌سرچاپ پیام
    سیستم عامل.خروج(۲)
پایان

روال خرابی جدی():
    سیستم عامل.توقف ناگهانی()
پایان

روال ریشه:
    آرگ‌ها := سیستم عامل.آرگومان ها()
    سرچاپ "تعداد آرگومان‌ها:", آرگ‌ها.طول()
    خانه := سیستم عامل.متغیر محیطی("HOME")
    سرچاپ خانه.طول() > ۰ یا سیستم عامل.متغیر محیطی("USERPROFILE").طول() > ۰
    اگر آرگ‌ها.طول() > ۱۰:
        خروج با خطا("آرگومان‌ها بیش از اندازه‌اند")
    پایان
    اگر آرگ‌ها.طول() > ۱۰۰:
        خرابی جدی()
    پایان
پایان
