واردسازی سیستم عامل

تابع ریشه:
    سیستم عامل.نوشتن پرونده("یادداشت.txt"، "سطر نخست\n")
    سیستم عامل.افزودن به پرونده("یادداشت.txt"، "سطر دوم\n")
    چاپ سیستم عامل.خواندن پرونده("یادداشت.txt")
    سرچاپ سیستم عامل.وجود دارد("یادداشت.txt")، سیستم عامل.اندازه پرونده("یادداشت.txt")
    و۱ := سیستم عامل.وضعیت پرونده("یادداشت.txt")
    سرچاپ و۱.exists، و۱.is_dir، و۱.size
    سیستم عامل.کپی("یادداشت.txt"، "رونوشت.txt")
    سیستم عامل.جابجایی("رونوشت.txt"، "نام تازه.txt")
    سرچاپ سیستم عامل.وجود دارد("رونوشت.txt")، سیستم عامل.وجود دارد("نام تازه.txt")
    سیستم عامل.حذف("نام تازه.txt")
    سرچاپ سیستم عامل.وجود دارد("نام تازه.txt")
    پ := سیستم عامل.بازکردن("یادداشت.txt"، "rb")
    سرچاپ پ.خواندن خط()
    پ.ببند()
پایان
