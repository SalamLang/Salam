واردسازی کانال
واردسازی حافظه
واردسازی استخر

ناپایا جعبه := کانال.کانال {} برگردان کانال.کانال<صحیح۶۴>
ناپایا گرفته := پوچ برگردان صحیح۶۴*

تابع waiter():
    ناپایا موفق := نادرست
    مقدار_محلی := جعبه.دریافت(موفق)
    اتمی‌بنویس(گرفته، مقدار_محلی)
پایان

تابع sender():
    جعبه.فرستادن(7 برگردان صحیح۶۴)
پایان

تابع ریشه:
    جعبه.مقداردهی(1 برگردان صحیح۶۴)
    گرفته = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    ویژگی_محلی := استخر.جدید کشسان(1 برگردان صحیح۶۴، 4 برگردان صحیح۶۴، 8 برگردان صحیح۶۴)
    سرچاپ "start: "، استخر.کارگرها(ویژگی_محلی)
    استخر.ارسال(ویژگی_محلی، (): waiter() پایان)
    استخر.ارسال(ویژگی_محلی، (): sender() پایان)
    استخر.انتظار(ویژگی_محلی)
    سرچاپ "received: "، اتمی‌بخوان(گرفته)
    سرچاپ "grew: "، استخر.کارگرها(ویژگی_محلی) بزرگتر 1
    سرچاپ "capped: "، استخر.کارگرها(ویژگی_محلی) کوچکتربرابر 4
    استخر.توقف(ویژگی_محلی)
    جعبه.آزادسازی()
    حافظه.آزادسازی(گرفته برگردان تهی*)
پایان
