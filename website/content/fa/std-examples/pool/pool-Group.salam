واردسازی استخر

تابع check(n: صحیح): رشته:
    اگر n برابر 7:
        برگشت "item 7 is bad"
    پایان
    برگشت ""
پایان

تابع ریشه:
    g := استخر.گروه کار جدید(3 برگردان صحیح۶۴)
    تکرار 20 در i:
        استخر.گروه برو(g، (): برگشت check(i) پایان)
    پایان
    سرچاپ استخر.گروه انتظار(g)
    سرچاپ استخر.گروه شکست خورده(g)
    استخر.گروه توقف(g)
پایان
