واردسازی حافظه
واردسازی استخر
واردسازی همگام سازی

ناپایا done := پوچ برگردان صحیح۶۴*
ناپایا gate := پوچ برگردان صحیح۶۴*

تابع work:
    همگام سازی.خواب میلی ثانیه(2)
    اتمی‌بیفزا(done، 1 برگردان صحیح۶۴)
پایان

تابع hold:
    تا اتمی‌بخوان(gate) نابرابر 0:
        همگام سازی.خواب میلی ثانیه(1)
    پایان
پایان

تابع ریشه:
    done = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    gate = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*

    p := استخر.جدید(4 برگردان صحیح۶۴، 8 برگردان صحیح۶۴)
    سرچاپ "workers: "، استخر.کارگرها(p)
    تکرار 100:
        استخر.ارسال(p، (): work() پایان)
    پایان
    استخر.انتظار(p)
    سرچاپ "finished: "، اتمی‌بخوان(done)
    استخر.توقف(p)

    q := استخر.جدید(1 برگردان صحیح۶۴، 1 برگردان صحیح۶۴)
    اتمی‌بنویس(gate، 1 برگردان صحیح۶۴)
    استخر.ارسال(q، (): hold() پایان)
    تا استخر.در حال اجرا(q) برابر 0:
        همگام سازی.خواب میلی ثانیه(1)
    پایان
    سرچاپ "queued: "، استخر.تلاش برای ارسال(q، (): work() پایان)
    سرچاپ "full: "، استخر.تلاش برای ارسال(q، (): work() پایان)
    سرچاپ "pending: "، استخر.در صف(q)
    اتمی‌بنویس(gate، 0 برگردان صحیح۶۴)
    استخر.توقف(q)
    سرچاپ "drained: "، اتمی‌بخوان(done)

    حافظه.آزادسازی(done برگردان تهی*)
    حافظه.آزادسازی(gate برگردان تهی*)
پایان
