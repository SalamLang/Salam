واردسازی تصادفی

تابع ریشه:
    ناپایا نام‌ها := وکتور {} برگردان وکتور<رشته>
    دیرکن نام‌ها.آزادکن()
    نام‌ها.بیفزا("علی")
    نام‌ها.بیفزا("سارا")
    نام‌ها.بیفزا("رضا")
    برنده := تصادفی.انتخاب رشته(نام‌ها)
    سرچاپ برنده == "علی" یا برنده == "سارا" یا برنده == "رضا"
    ناپایا عددها := وکتور {} برگردان وکتور<صحیح>
    دیرکن عددها.آزادکن()
    تکرار ۱ تا ۵ در ای:
        عددها.بیفزا(ای)
    پایان
    سرچاپ تصادفی.انتخاب عدد(عددها) <= ۵
    بهم := تصادفی.بهم ریختن عدد(عددها)
    ناپایا جمع := ۰
    هر ع در بهم:
        جمع += ع
    پایان
    سرچاپ بهم.طول()، جمع
    سرچاپ تصادفی.بهم ریختن رشته(نام‌ها).طول()
پایان
