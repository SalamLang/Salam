واردسازی تصادفی

تابع ریشه:
    تصادفی.بذر(۴۲)
    الف := تصادفی.عدد در بازه(۱، ۱۰۰)
    تصادفی.بذر(۴۲)
    ب := تصادفی.عدد در بازه(۱، ۱۰۰)
    سرچاپ الف == ب
    تصادفی.بذر خودکار()
    تاس := تصادفی.عدد۳۲بیتی در بازه(۱، ۶)
    سرچاپ تاس >= ۱ و تاس <= ۶
    ع := تصادفی.عدد تصادفی()
    ع۳۲ := تصادفی.عدد۳۲بیتی()
    سرچاپ تصادفی.عدد کمتر از ان(۱۰) < ۱۰، ع == ع، ع۳۲ == ع۳۲
    سرچاپ تصادفی.عدد با طول(۶) >= ۱۰۰۰۰۰
