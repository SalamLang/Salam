واردسازی نتیجه

روال سن(م: رشته): نتیجه.نتیجه<صحیح، رشته>:
    ع := م.به صحیح()
    اگر ع <= ۰ یا ع > ۱۵۰:
        برگشت نتیجه.نتیجه.خطا("سن نامعتبر: " + م)
    پایان
    برگشت نتیجه.نتیجه.موفق(ع)
پایان

روال ریشه:
    هر م در ["۳۰"، "۲۰۰"]:
        ن := سن(م)
        سرچاپ همخوان ن:
            موفق(س): "سن پذیرفته شد: " + س پایان
            خطا(پیام): پیام پایان
        پایان
    پایان
پایان
