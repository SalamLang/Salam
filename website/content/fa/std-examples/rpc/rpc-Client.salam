واردسازی فراخوان دور
واردسازی کدگذاری.مقدار
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب
واردسازی همگام سازی

ناپایا سرور := فراخوان دور.سرور جدید(۰، فراخوان دور.کدک جیسون)
ناپایا آماده := همگام سازی.گروه انتظار جدید()

روال جمع(ج: صحیح۶۴):
    فراخوان دور.پاسخ عددی(ج، فراخوان دور.پارامتر عددی فراخوان(ج، "a"، ۰) + فراخوان دور.پارامتر عددی فراخوان(ج، "b"، ۱))
پایان

روال زمان(ج: صحیح۶۴):
    فراخوان دور.پاسخ متنی(ج، "12:00")
پایان

روال یادداشت(ج: صحیح۶۴):
    فراخوان دور.پاسخ تهی(ج)
پایان

روال اجرای سرور():
    _ := فراخوان دور.گوش دادن(سرور)
    همگام سازی.اتمام(آماده)
    _ := فراخوان دور.خدمت به تعداد(سرور، ۱)
پایان

روال نقطه پایانی(ز: صحیح۶۴):
    اچ تی تی پی.جیسون زمینه(ز، فراخوان دور.پردازش متن(اچ تی تی پی.بدنه زمینه(ز)))
پایان

روال ریشه:
    فراخوان دور.ثبت متد("add"، جمع)
    فراخوان دور.ثبت متد("time"، زمان)
    فراخوان دور.ثبت متد("note"، یادداشت)
    فراخوان دور.تنظیم قاب‌بندی(سرور، فراخوان دور.قاب خطی)
    همگام سازی.افزودن(آماده، ۱)
    ن := spawn(اجرای سرور)
    همگام سازی.انتظار(آماده)
    سرچاپ فراخوان دور.درگاه سرور(سرور) > ۰

    ناپایا ک := فراخوان دور.اتصال کارخواه("127.0.0.1"، فراخوان دور.درگاه سرور(سرور)، فراخوان دور.کدک جیسون)
    فراخوان دور.تنظیم قاب‌بندی کارخواه(ک، فراخوان دور.قاب خطی)
    سرچاپ فراخوان دور.کارخواه معتبر(ک)
    ناپایا پ := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(پ، مقدار.مقدار صحیح(۲))
    مقدار.افزودن به آرایه(پ، مقدار.مقدار صحیح(۴۰))
    سرچاپ فراخوان دور.نتیجه عددی(فراخوان دور.فراخوان(ک، "add"، پ))
    سرچاپ فراخوان دور.نتیجه متنی(فراخوان دور.فراخوان بدون پارامتر(ک، "time"))
    ناپایا آرگ := وکتور {} برگردان وکتور<مقدار.مقدار>
    آرگ.افزودن(مقدار.مقدار صحیح(۱))
    آرگ.افزودن(مقدار.مقدار صحیح(۲))
    سرچاپ فراخوان دور.نتیجه عددی(فراخوان دور.فراخوان با آرگومان(ک، "add"، آرگ))
    سرچاپ فراخوان دور.اعلان(ک، "note"، مقدار.آرایه جدید())
    ناپایا دسته := وکتور {} برگردان وکتور<فراخوان دور.درخواست>
    دسته.افزودن(فراخوان دور.درخواست جدید("add"، پ، ۱۰))
    دسته.افزودن(فراخوان دور.درخواست جدید("missing"، مقدار.آرایه جدید()، ۱۱))
    پاسخ‌ها := فراخوان دور.فراخوان دسته‌ای(ک، دسته)
    سرچاپ پاسخ‌ها.items.طول()، فراخوان دور.نتیجه عددی(پاسخ‌ها.items[۰])
    سرچاپ فراخوان دور.پاسخ خطاست(پاسخ‌ها.items[۱])، فراخوان دور.کد خطا(پاسخ‌ها.items[۱])، فراخوان دور.پیام خطا(پاسخ‌ها.items[۱])
    فراخوان دور.بستن کارخواه(ک)
    سرچاپ فراخوان دور.کارخواه معتبر(ک)، فراخوان دور.خطای کارخواه(ک).طول() >= ۰
    join(ن)
    فراخوان دور.توقف سرور(سرور)

    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/rpc"، نقطه پایانی)
    ناپایا ه := اچ تی تی پی.سرور جدید(۱۹۶۱۱)
    اچ تی تی پی.استفاده(ه، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(ه)
    ر := فراخوان دور.فراخوان اچ تی تی پی("http://127.0.0.1:19611/rpc"، "add"، پ، ۷)
    سرچاپ فراخوان دور.نتیجه عددی(ر)
پایان
