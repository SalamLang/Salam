واردسازی فراخوان دور
واردسازی فشرده سازی

تابع ریشه:
    خط := فراخوان دور.قاب‌بندی متن(فراخوان دور.قاب خطی، `{"a":1}`)
    سرآیندی := فراخوان دور.قاب‌بندی متن(فراخوان دور.قاب سرآیندی، `{"b":2}`)
    طول‌دار := فراخوان دور.قاب‌بندی(فراخوان دور.قاب طول‌دار، فشرده سازی.بافر از رشته(`{"c":3}`))
    سرچاپ خط.len، سرآیندی.len، طول‌دار.len
    سرچاپ فشرده سازی.بافر به رشته(سرآیندی).طول() > ۰

    ناپایا ج := فراخوان دور.جریان حافظه()
    فراخوان دور.تغذیه متن(ج، `{"x":1}` + "\n" + `{"x":2}` + "\n")
    ناپایا سالم := نادرست
    سرچاپ فراخوان دور.خواندن قاب متنی(ج، فراخوان دور.قاب خطی، سالم)، سالم
    سرچاپ فراخوان دور.باقی‌مانده جریان(ج)
    سرچاپ فراخوان دور.خواندن قاب متنی(ج، فراخوان دور.قاب خطی، سالم)
    _ := فراخوان دور.خواندن قاب متنی(ج، فراخوان دور.قاب خطی، سالم)
    سرچاپ سالم، فراخوان دور.جریان بسته(ج)

    ناپایا ج۲ := فراخوان دور.جریان حافظه()
    فراخوان دور.تغذیه بافر(ج۲، سرآیندی)
    فراخوان دور.تغذیه بافر(ج۲، طول‌دار)
    سرچاپ فراخوان دور.خواندن قاب متنی(ج۲، فراخوان دور.قاب سرآیندی، سالم)
    ب := فراخوان دور.خواندن قاب(ج۲، فراخوان دور.قاب طول‌دار، سالم)
    سرچاپ فشرده سازی.بافر به رشته(ب)، سالم
    سرچاپ فراخوان دور.اندازه تکه خواندن، فراخوان دور.بیشینه اندازه قاب
    فراخوان دور.آزادسازی جریان(ج)
    فراخوان دور.آزادسازی جریان(ج۲)
پایان
