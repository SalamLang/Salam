واردسازی فراخوان دور
واردسازی کدگذاری.مقدار
واردسازی فشرده سازی

روال ریشه:
    ناپایا پ := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(پ، مقدار.مقدار صحیح(۲))
    مقدار.افزودن به آرایه(پ، مقدار.مقدار رشته("سلام"))
    مقدار.افزودن به آرایه(پ، مقدار.مقدار اعشاری(۱.۵))
    مقدار.افزودن به آرایه(پ، مقدار.مقدار منطقی(درست))
    د := فراخوان دور.درخواست جدید("calc"، پ، ۱)
    سرچاپ فراخوان دور.کدگذاری درخواست جیسون(د)
    سرچاپ فراخوان دور.تعداد پارامتر(د)، فراخوان دور.پارامتر عددی(د، "a"، ۰)، فراخوان دور.پارامتر متنی(د، "b"، ۱)
    سرچاپ فراخوان دور.پارامتر اعشاری(د، "c"، ۲)، فراخوان دور.پارامتر بولی(د، "d"، ۳)، فراخوان دور.پارامتر دارد(د، "e"، ۴)
    سرچاپ مقدار.به صحیح(فراخوان دور.پارامتر در جایگاه(د، ۰))، مقدار.به صحیح(فراخوان دور.پارامتر(د، "a"، ۰))
    ناپایا ش := مقدار.شیء جدید()
    مقدار.تنظیم کلید(ش، "name"، مقدار.مقدار رشته("علی"))
    د۲ := فراخوان دور.درخواست با شناسه متنی("greet"، ش، "req-1")
    سرچاپ فراخوان دور.کدگذاری درخواست جیسون(د۲)
    سرچاپ مقدار.به رشته(فراخوان دور.پارامتر نام‌دار(د۲، "name"))
    ا := فراخوان دور.اعلان جدید("tick"، مقدار.آرایه جدید())
    سرچاپ فراخوان دور.اعلان است(ا)، فراخوان دور.کدگذاری درخواست جیسون(ا)

    ناپایا سالم := نادرست
    خ := فراخوان دور.کدگشایی درخواست جیسون(`{"jsonrpc":"2.0","method":"add","params":{"a":1,"b":2},"id":9}`، سالم)
    سرچاپ سالم، خ.method، خ.msgid، فراخوان دور.پارامتر عددی(خ، "b"، ۱)

    پاسخ := فراخوان دور.پاسخ جدید(مقدار.مقدار صحیح(۱)، مقدار.مقدار رشته("ok"))
    سرچاپ فراخوان دور.کدگذاری پاسخ جیسون(پاسخ)
    خطا := فراخوان دور.خطای استاندارد(فراخوان دور.کد روش یافت نشد)
    سرچاپ خطا.code، خطا.message
    سرچاپ فراخوان دور.کدگذاری پاسخ جیسون(فراخوان دور.پاسخ خطا(مقدار.مقدار صحیح(۲)، فراخوان دور.خطای جدید(-۳۲۰۰۰، "سرور مشغول است")))
    با داده := فراخوان دور.خطا با داده(فراخوان دور.کد پارامترهای نامعتبر، "بد"، مقدار.مقدار رشته("x"))
    سرچاپ با داده.has_data، فراخوان دور.خطای سطح بالای جیسون(فراخوان دور.خطای استاندارد(فراخوان دور.کد خطای تجزیه))

    ر := فراخوان دور.کدگشایی پاسخ جیسون(`{"jsonrpc":"2.0","result":3.5,"id":1}`، سالم)
    سرچاپ سالم، فراخوان دور.نتیجه اعشاری(ر)، فراخوان دور.پاسخ خطاست(ر)
    ر۲ := فراخوان دور.کدگشایی پاسخ جیسون(`{"jsonrpc":"2.0","error":{"code":-32601,"message":"nope"},"id":2}`، سالم)
    سرچاپ فراخوان دور.پاسخ خطاست(ر۲)، فراخوان دور.کد خطا(ر۲)، فراخوان دور.پیام خطا(ر۲)
    همه := فراخوان دور.کدگشایی پاسخ‌های جیسون(`[{"jsonrpc":"2.0","result":true,"id":1},{"jsonrpc":"2.0","result":"x","id":2}]`، سالم)
    سرچاپ همه.is_batch، همه.items.طول()، فراخوان دور.نتیجه بولی(همه.items[۰])، فراخوان دور.نتیجه متنی(همه.items[۱])
    سرچاپ فراخوان دور.کدگذاری پاسخ‌های جیسون(همه)

    سرچاپ فراخوان دور.نام کدک(فراخوان دور.کدک جیسون)، فراخوان دور.نام کدک(فراخوان دور.کدک مسگ‌پک)
    سرچاپ فراخوان دور.قاب‌بندی پیش‌فرض کدک(فراخوان دور.کدک جیسون) == فراخوان دور.قاب خطی، فراخوان دور.قاب‌بندی پیش‌فرض کدک(فراخوان دور.کدک مسگ‌پک) == فراخوان دور.قاب طول‌دار
    م := فراخوان دور.کدگذاری درخواست(فراخوان دور.کدک مسگ‌پک، د)
    سرچاپ م.len، فشرده سازی.دریافت بایت(م، ۰)
    دسته := فراخوان دور.کدگشایی دسته(فراخوان دور.کدک مسگ‌پک، م)
    سرچاپ دسته.ok، دسته.items[۰].method، دسته.items[۰].msgid
    سرچاپ فراخوان دور.کدگشایی دسته مسگ‌پک(فراخوان دور.کدگذاری درخواست مسگ‌پک(د)).items[۰].method
    مپ := فراخوان دور.کدگذاری پاسخ مسگ‌پک(فراخوان دور.پاسخ جدید(مقدار.مقدار صحیح(۱)، مقدار.مقدار صحیح(۴۲)))
    سرچاپ فراخوان دور.نتیجه عددی(فراخوان دور.کدگشایی پاسخ مسگ‌پک(مپ، سالم))، سالم
    ج := فراخوان دور.کدگذاری درخواست(فراخوان دور.کدک جیسون، د)
    سرچاپ فراخوان دور.نتیجه عددی(فراخوان دور.کدگشایی پاسخ(فراخوان دور.کدک مسگ‌پک، مپ، سالم))، ج.len > ۰
    سرچاپ فشرده سازی.بافر به رشته(فراخوان دور.کدگذاری پاسخ‌ها(فراخوان دور.کدک جیسون، همه)).طول() > ۰
    سرچاپ فشرده سازی.بافر به رشته(فراخوان دور.کدگذاری خطای سطح بالا(فراخوان دور.کدک جیسون، خطا))
    سرچاپ فراخوان دور.نوع درخواست مسگ‌پک، فراخوان دور.نوع پاسخ مسگ‌پک، فراخوان دور.نوع اعلان مسگ‌پک
    سرچاپ فراخوان دور.کد درخواست نامعتبر، فراخوان دور.کد خطای داخلی، فراخوان دور.کد خطای کارساز
    سرچاپ فراخوان دور.نوع درخواست، فراخوان دور.نوع اعلان، فراخوان دور.نوع پاسخ
    سرچاپ فشرده سازی.بافر به رشته(فشرده سازی.بافر از رشته(فراخوان دور.کدگذاری درخواست جیسون(د))).طول() > ۰
