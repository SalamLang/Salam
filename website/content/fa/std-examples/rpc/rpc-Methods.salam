واردسازی فراخوان دور
واردسازی کدگذاری.مقدار

تابع جمع(ج: صحیح۶۴):
    الف := فراخوان دور.پارامتر عددی فراخوان(ج، "a"، ۰)
    ب := فراخوان دور.پارامتر عددی فراخوان(ج، "b"، ۱)
    فراخوان دور.پاسخ عددی(ج، الف + ب)
پایان

تابع تقسیم(ج: صحیح۶۴):
    مقسوم‌علیه := فراخوان دور.پارامتر اعشاری فراخوان(ج، "b"، ۱)
    اگر مقسوم‌علیه == ۰.۰:
        فراخوان دور.پارامتر نامعتبر(ج، "تقسیم بر صفر")
        برگشت
    پایان
    فراخوان دور.پاسخ اعشاری(ج، فراخوان دور.پارامتر اعشاری فراخوان(ج، "a"، ۰) / مقسوم‌علیه)
پایان

تابع سلام(ج: صحیح۶۴):
    نام := فراخوان دور.پارامتر متنی فراخوان(ج، "name"، ۰)
    اگر نام.طول() == ۰:
        فراخوان دور.شکست(ج، -۳۲۰۰۱، "نام لازم است")
        برگشت
    پایان
    فراخوان دور.پاسخ متنی(ج، "سلام " + نام)
پایان

تابع وضعیت(ج: صحیح۶۴):
    ناپایا ش := مقدار.آرایه جدید()
    مقدار.افزودن به آرایه(ش، مقدار.مقدار رشته(فراخوان دور.نام متد فراخوان(ج)))
    مقدار.افزودن به آرایه(ش، مقدار.مقدار صحیح(فراخوان دور.تعداد پارامتر فراخوان(ج)))
    مقدار.افزودن به آرایه(ش، مقدار.مقدار منطقی(فراخوان دور.پارامتر بولی فراخوان(ج، "verbose"، ۰)))
    فراخوان دور.پاسخ دادن(ج، ش)
پایان

تابع ثبت رویداد(ج: صحیح۶۴):
    سرچاپ "رویداد:"، مقدار.به رشته(فراخوان دور.پارامتر فراخوان(ج، "event"، ۰))، فراخوان دور.فراخوان اعلان است(ج)
    _ := فراخوان دور.پارامترهای فراخوان(ج)
    _ := فراخوان دور.درخواست فراخوان(ج)
    فراخوان دور.پاسخ تهی(ج)
پایان

تابع ممنوع(ج: صحیح۶۴):
    فراخوان دور.شکست با داده(ج، -۳۲۰۰۳، "دسترسی ندارید"، مقدار.مقدار رشته("admin"))
پایان

تابع همیشه(ج: صحیح۶۴):
    فراخوان دور.پاسخ بولی(ج، درست)
پایان

تابع ریشه:
    فراخوان دور.ثبت متد با توضیح("add"، جمع، "جمع دو عدد")
    فراخوان دور.ثبت متد("divide"، تقسیم)
    فراخوان دور.ثبت متد("hello"، سلام)
    فراخوان دور.ثبت متد("status"، وضعیت)
    فراخوان دور.ثبت متد("log"، ثبت رویداد)
    فراخوان دور.ثبت متد("admin"، ممنوع)
    فراخوان دور.ثبت متد("ping"، همیشه)
    سرچاپ فراخوان دور.تعداد متدها()، فراخوان دور.متد دارد("add")، فراخوان دور.توضیح متد("add")
    سرچاپ فراخوان دور.فهرست متدها().طول()

    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"add","params":[2,40],"id":1}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"add","params":{"a":5,"b":6},"id":2}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"divide","params":[1,0],"id":3}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"hello","params":["مریم"],"id":"x"}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"hello","params":[],"id":4}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"status","params":{"verbose":true},"id":5}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"admin","id":6}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"nope","id":7}`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":"2.0","method":"log","params":{"event":"start"}}`).طول()
    سرچاپ فراخوان دور.پردازش متن(`[{"jsonrpc":"2.0","method":"ping","id":8},{"jsonrpc":"2.0","method":"add","params":[1,1],"id":9}]`)
    سرچاپ فراخوان دور.پردازش متن(`{"jsonrpc":`)

    ناپایا سالم := نادرست
    د := فراخوان دور.کدگشایی درخواست جیسون(`{"jsonrpc":"2.0","method":"add","params":[20,22],"id":10}`، سالم)
    پ := فراخوان دور.اجرای درخواست(د)
    سرچاپ فراخوان دور.نتیجه عددی(پ)
    دسته := فراخوان دور.کدگشایی دسته جیسون(`[{"jsonrpc":"2.0","method":"ping","id":1}]`)
    سرچاپ فراخوان دور.اجرای دسته(دسته).items.طول()

    سرچاپ فراخوان دور.حذف متد("ping")، فراخوان دور.متد دارد("ping")
    فراخوان دور.بازنشانی ثبت()
    سرچاپ فراخوان دور.تعداد متدها()
پایان
