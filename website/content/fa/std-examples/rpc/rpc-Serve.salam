واردسازی فراخوان دور
واردسازی شبکه.تی سی پی
واردسازی فشرده سازی

تابع پژواک(ج: صحیح۶۴):
    فراخوان دور.پاسخ دادن(ج، فراخوان دور.پارامترهای فراخوان(ج))
پایان

تابع ریشه:
    فراخوان دور.ثبت متد("echo"، پژواک)
    اگر فراخوان دور.پردازش متن("").طول() == ۰:
        _ := فراخوان دور.خدمت ورودی خروجی(فراخوان دور.قاب سرآیندی)
        برگشت
    پایان

    ناپایا س := فراخوان دور.سرور جدید(۴۰۰۰، فراخوان دور.کدک مسگ‌پک)
    فراخوان دور.تنظیم قاب‌بندی(س، فراخوان دور.قاب طول‌دار)
    اگر فراخوان دور.گوش دادن(س):
        سرچاپ "روی درگاه"، فراخوان دور.درگاه سرور(س)، س.running
        فراخوان دور.خدمت(س)
    پایان

    ا := تی سی پی.شماره گیری("127.0.0.1"، ۴۰۰۱)
    _ := فراخوان دور.خدمت به اتصال(ا.fd، فراخوان دور.کدک جیسون، فراخوان دور.قاب خطی)

    ک := تی سی پی.شماره گیری("127.0.0.1"، ۴۰۰۲)
    ناپایا کارخواه := فراخوان دور.کارخواه از توصیف‌گر(ک.fd، فراخوان دور.کدک جیسون)
    سرچاپ فراخوان دور.نتیجه متنی(فراخوان دور.فراخوان بدون پارامتر(کارخواه، "version"))

    ناپایا ج := فراخوان دور.جریان جدید(ک.fd)
    _ := فراخوان دور.نوشتن قاب متنی(ک.fd، فراخوان دور.قاب خطی، `{"jsonrpc":"2.0","method":"echo","params":[1],"id":1}`)
    _ := فراخوان دور.نوشتن قاب(ک.fd، فراخوان دور.قاب خطی، فشرده سازی.بافر از رشته(`{"jsonrpc":"2.0","method":"echo","id":2}`))
    ناپایا سالم := نادرست
    سرچاپ فراخوان دور.خواندن قاب متنی(ج، فراخوان دور.قاب خطی، سالم)
    پاسخ := فراخوان دور.پردازش بار(فراخوان دور.کدک جیسون، فشرده سازی.بافر از رشته(`{"jsonrpc":"2.0","method":"echo","params":[3],"id":3}`))
    سرچاپ فشرده سازی.بافر به رشته(پاسخ)
    فراخوان دور.آزادسازی جریان(ج)
    فراخوان دور.توقف سرور(س)
پایان
