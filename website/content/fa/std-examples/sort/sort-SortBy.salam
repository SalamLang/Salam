واردسازی مرتب سازی

ساختار دانشجو:
    همگانی نام: رشته = ""
    همگانی نمره: صحیح = ۰
پایان

تابع ریشه:
    ناپایا کلاس := وکتور {} برگردان وکتور<دانشجو>
    دیرکن کلاس.آزادکن()
    کلاس.بیفزا(دانشجو { نام = "سارا"، نمره = ۱۸ })
    کلاس.بیفزا(دانشجو { نام = "علی"، نمره = ۱۵ })
    کلاس.بیفزا(دانشجو { نام = "رضا"، نمره = ۱۸ })
    کلاس.بیفزا(دانشجو { نام = "مریم"، نمره = ۲۰ })
    بیشتر := (الف: دانشجو، ب: دانشجو): برگشت الف.نمره > ب.نمره پایان
    مرتب سازی.مرتب سازی ترتیب‌نگه‌دار با(کلاس، بیشتر)
    هر د در کلاس:
        چاپ د.نام، ""
    پایان
    سرچاپ ""
    سرچاپ مرتب سازی.مرتب است با(کلاس، بیشتر)
    کمتر := (الف: دانشجو، ب: دانشجو): برگشت الف.نمره < ب.نمره پایان
    صعودی := مرتب سازی.مرتب شده با(کلاس، کمتر)
    سرچاپ صعودی.بگیر(۰).نام
