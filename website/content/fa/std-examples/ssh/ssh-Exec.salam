واردسازی اس اس اچ

تابع ریشه:
    ناپایا پ := اس اس اچ.پیکربندی جدید("server.example.com"، ۲۲، "deploy")
    _ := اس اس اچ.با فایل کلید(پ، "/home/deploy/.ssh/id_rsa")
    ناپایا ک := اس اس اچ.اتصال(پ)
    اگر وارونه اس اس اچ.معتبر(ک):
        سرچاپ "خطا:"، اس اس اچ.خطا(ک)
        برگشت
    پایان
    سرچاپ "کلید میزبان:"، اس اس اچ.اثر انگشت کلید میزبان(ک)

    ن := اس اس اچ.اجرا(ک، "uname -a")
    سرچاپ ن.ok، ن.exit_code، ن.stdout، ن.stderr
    ن۲ := اس اس اچ.اجرای دستور(ک، "df -h /")
    سرچاپ ن۲.stdout

    ناپایا ن‌ش := اس اس اچ.نشست جدید(ک)
    _ := اس اس اچ.درخواست پی تی وای(ن‌ش، ک، "xterm"، ۱۲۰، ۴۰)
    اگر اس اس اچ.شروع(ن‌ش، ک، "tail -f /var/log/app.log"):
        تکرار ۱۰:
            _ := اس اس اچ.گام خواندن(ن‌ش، ک)
            چاپ اس اس اچ.تخلیه خروجی(ن‌ش)
            چاپ اس اس اچ.تخلیه خروجی خطا(ن‌ش)
        پایان
    پایان
    اس اس اچ.بستن نشست(ن‌ش، ک)

    ناپایا پوسته := اس اس اچ.نشست جدید(ک)
    اگر اس اس اچ.پوسته(پوسته، ک):
        _ := اس اس اچ.نوشتن ورودی(پوسته، ک، "echo سلام\nexit\n")
        اس اس اچ.بستن ورودی(پوسته، ک)
        کد := اس اس اچ.انتظار(پوسته، ک)
        سرچاپ کد، اس اس اچ.کد خروج(پوسته)، اس اس اچ.نشست بسته شده(پوسته)
        سرچاپ اس اس اچ.خروجی(پوسته)، اس اس اچ.خروجی خطا(پوسته)
    پایان
    اس اس اچ.بستن نشست(پوسته، ک)

    ب := اس اس اچ.شماره گیری(پ)
    سرچاپ اس اس اچ.معتبر(ب)
    سرچاپ اس اس اچ.اتصال مجدد(ک)
    سرچاپ اس اس اچ.خودآزمایی()
    اس اس اچ.بستن(ک)
پایان
