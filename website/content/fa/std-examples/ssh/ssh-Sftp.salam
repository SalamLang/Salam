واردسازی اس اس اچ

روال ریشه:
    ناپایا پ := اس اس اچ.پیکربندی جدید("files.example.com"، ۲۲، "ali")
    اس اس اچ.با رمز عبور(پ، "s3cret")
    ناپایا ک := اس اس اچ.اتصال(پ)
    ناپایا ف := اس اس اچ.باز کردن اس اف تی پی(ک)
    اگر وارونه ف.ok:
        سرچاپ اس اس اچ.خطا(ک)
        برگشت
    پایان
    سرچاپ اس اس اچ.ساخت مسیر کامل(ک، ف، "/backup/2026/09")
    سرچاپ اس اس اچ.بارگذاری(ک، ف، "report.pdf"، "/backup/2026/09/report.pdf")
    سرچاپ اس اس اچ.ارسال پوشه(ک، ف، "site"، "/var/www/site")
    اگر اس اس اچ.وجود دارد(ک، ف، "/backup/2026/09/report.pdf"):
        ا := اس اس اچ.وضعیت(ک، ف، "/backup/2026/09/report.pdf")
        سرچاپ ا.name، ا.size، ا.is_dir، ا.permissions
    پایان
    هر ا در اس اس اچ.لیست پوشه(ک، ف، "/backup"):
        سرچاپ ا.name، ا.is_dir
    پایان
    سرچاپ اس اس اچ.پیوند است(ک، ف، "/current")، اس اس اچ.وضعیت پیوند(ک، ف، "/current").name
    _ := اس اس اچ.دانلود(ک، ف، "/etc/hostname"، "hostname.txt")
    _ := اس اس اچ.دریافت پوشه(ک، ف، "/var/log/app"، "logs")
    _ := اس اس اچ.تغییر نام(ک، ف، "/tmp/a"، "/tmp/b")
    _ := اس اس اچ.حذف(ک، ف، "/tmp/b")
    _ := اس اس اچ.ساخت پوشه(ک، ف، "/tmp/x")
    _ := اس اس اچ.حذف پوشه(ک، ف، "/tmp/x")
    _ := اس اس اچ.حذف همه(ک، ف، "/tmp/old")
    اس اس اچ.بستن اس اف تی پی(ک، ف)
    اس اس اچ.بستن(ک)
پایان
