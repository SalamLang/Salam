واردسازی اس اس اچ

روال ریشه:
    ناپایا ب := اس اس اچ.بافر جدید(۶۴)
    اس اس اچ.افزودن بایت(ب، ۲۰)
    اس اس اچ.افزودن یو۳۲(ب، ۷ برگردان طبیعی۳۲)
    اس اس اچ.افزودن یو۶۴(ب، ۹ برگردان طبیعی۶۴)
    اس اس اچ.افزودن بولی(ب، درست)
    اس اس اچ.افزودن رشته متن(ب، "ssh-ed25519,rsa-sha2-256")
    اس اس اچ.افزودن رشته(ب، "abc" برگردان تهی*، ۳)
    اس اس اچ.افزودن بایت ها(ب، "xy" برگردان تهی*، ۲)
    اس اس اچ.افزودن صفرها(ب، ۲)
    اس اس اچ.افزودن ام پی اینت(ب، "\x80" برگردان تهی*، ۱)
    سرچاپ ب.len

    ناپایا ر := اس اس اچ.خواننده از بافر(ب)
    سرچاپ اس اس اچ.دریافت بایت(ر)، اس اس اچ.دریافت یو۳۲(ر)، اس اس اچ.دریافت یو۶۴(ر)، اس اس اچ.دریافت بولی(ر)
    فهرست := اس اس اچ.دریافت لیست نام(ر)
    سرچاپ فهرست، اس اس اچ.شامل لیست نام(فهرست، "rsa-sha2-256")
    سرچاپ اس اس اچ.دریافت رشته متن(ر)
    اس اس اچ.رد شدن(ر، ۴)
    سرچاپ اس اس اچ.باقی مانده(ر)
    ن := اس اس اچ.خواندن ام پی اینت(ر)
    سرچاپ ن.len، اس اس اچ.باقی مانده(ر)

    سرچاپ اس اس اچ.توافق اولین تطابق("aes256-ctr,aes128-ctr"، "aes128-ctr,aes256-ctr")
    سرچاپ اس اس اچ.برابری زمان ثابت("abcd" برگردان تهی*، "abcd" برگردان تهی*، ۴)، اس اس اچ.برابری زمان ثابت("abcd" برگردان تهی*، "abce" برگردان تهی*، ۴)

    ناپایا ب۲ := اس اس اچ.بافر جدید(۱۶)
    اس اس اچ.افزودن رشته بافر(ب۲، ب)
    اس اس اچ.افزودن ام پی اینت بافر(ب۲، ب)
    اس اس اچ.افزودن بافر(ب۲، ب)
    ناپایا ر۲ := اس اس اچ.خواننده جدید(ب۲.p، ب۲.len)
    نما := اس اس اچ.دریافت نمای رشته(ر۲)
    سرچاپ نما.len == ب.len
    ناپایا کپی := اس اس اچ.کپی رشته(اس اس اچ.خواننده از بافر(ب۲))
    ناپایا عدد := اس اس اچ.کپی ام پی اینت(ر۲)
    سرچاپ کپی.len، عدد.len، اس اس اچ.باقی مانده(ر۲)
    اس اس اچ.پاک سازی بافر(ب)
    اس اس اچ.آزادسازی بافر(ب)
    اس اس اچ.آزادسازی بافر(ب۲)
    اس اس اچ.آزادسازی بافر(کپی)
    اس اس اچ.آزادسازی بافر(عدد)
