    ن := اس اس ال.نوشتن(ا، "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
    اگر ن <= ۰:
        سرچاپ "کد خطا:"، اس اس ال.کد خطا(ا، ن)
