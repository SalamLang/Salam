واردسازی رشته

تابع ریشه:
    نام := "Report-2026.TXT"
    سرچاپ نام.شروع با("Report")، نام.ختم با(".txt")، نام.دربردارد("2026")
    سرچاپ رشته.شروع با بدون حساسیت(نام، "report")، رشته.پایان با بدون حساسیت(نام، ".txt")
    ناپایا متغیر_exts := وکتور {} برگردان وکتور<رشته>
    متغیر_exts.بیفزا(".csv")
    متغیر_exts.بیفزا(".TXT")
    سرچاپ رشته.پایان با یکی از(نام، متغیر_exts)، رشته.شروع با یکی از(نام، متغیر_exts)
    ناپایا موفق := نادرست
    سرچاپ رشته.برش پیشوند(نام، "Report-"، موفق)، موفق
    سرچاپ رشته.برش پسوند(نام، ".md"، موفق)، موفق
