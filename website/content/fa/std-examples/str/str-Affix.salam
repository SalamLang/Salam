واردسازی رشته

تابع ریشه:
    name := "Report-2026.TXT"
    سرچاپ name.شروع با("Report")، name.ختم با(".txt")، name.دربردارد("2026")
    سرچاپ رشته.شروع با بدون حساسیت(name، "report")، رشته.پایان با بدون حساسیت(name، ".txt")
    ناپایا exts := وکتور {} برگردان وکتور<رشته>
    exts.بیفزا(".csv")
    exts.بیفزا(".TXT")
    سرچاپ رشته.پایان با یکی از(name، exts)، رشته.شروع با یکی از(name، exts)
    ناپایا ok := نادرست
    سرچاپ رشته.برش پیشوند(name، "Report-"، ok)، ok
    سرچاپ رشته.برش پسوند(name، ".md"، ok)، ok
پایان
