واردسازی رشته

روال ریشه:
    م := "سلام"
    سرچاپ رشته.طول(م)، رشته.شمارنویسه(م)
    سرچاپ رشته.نویسه شماره(م، ۱)، رشته.زیررشته نویسه(م، ۱، ۲)
    سرچاپ رشته.بیاب نویسه(م، "ام")، رشته.برعکس(م)
    سرچاپ رشته.نویسه در (م، ۲)
    ناپایا کد := ۰
    ط := رشته.کدنقطه در (م، ۰، کد)
    سرچاپ کد، ط، رشته.طول نویسه(۲۱۶)
    کدها := رشته.کدنقطه ها(م)
    سرچاپ کدها
    سرچاپ رشته.از کدنقطه ها(کدها)
    سرچاپ رشته.نویسه ها("ab۱")
    سرچاپ رشته.همه اسکی("salam")، رشته.همه اسکی("سلام")
پایان
