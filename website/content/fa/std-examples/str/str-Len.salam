واردسازی رشته

تابع ریشه:
    الف := "سیب"
    ب := "انار"
    سرچاپ رشته.طول(الف)، رشته.خالی است("")، رشته.خالی است(الف)
    سرچاپ رشته.پیوست(الف، ب)
    سرچاپ رشته.مقایسه(الف، ب)، رشته.مقایسه(ب، الف)، رشته.مقایسه(الف، "سیب")
    سرچاپ رشته.یکسان است(الف، "سیب")
    سرچاپ رشته.زیررشته("salam donya"، ۶، ۵)، رشته.زیررشته درون("salam"، ۳، ۱۰)
    سرچاپ رشته.یافتن("salam donya"، "donya")
    ر := رشته.رونوشت(الف)
    سرچاپ ر
پایان
