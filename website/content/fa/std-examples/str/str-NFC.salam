واردسازی رشته

روال ریشه:
    ترکیبی := "آ"
    تجزیه := رشته.تجزیه متعارف(ترکیبی)
    سرچاپ ترکیبی.طول()، تجزیه.طول()، ترکیبی == تجزیه
    سرچاپ رشته.ترکیب متعارف(تجزیه) == ترکیبی
    سرچاپ رشته.متعارف است(ترکیبی)، رشته.متعارف است(تجزیه)
    نمایشی := "ﻼ"
    سرچاپ رشته.تجزیه سازگاری(نمایشی)، رشته.ترکیب سازگاری(نمایشی)
پایان
