واردسازی همگام سازی

ناپایا آماده := نادرست
ناپایا قفل := همگام سازی.قفل {}
ناپایا شرط := همگام سازی.متغیر شرط {}

روال سازنده():
    همگام سازی.خواب میلی ثانیه(۲۰)
    همگام سازی.قفل کردن(قفل)
    آماده = درست
    همگام سازی.اعلام سراسری(شرط)
    همگام سازی.باز کردن قفل(قفل)
پایان

روال ریشه:
    قفل = همگام سازی.قفل جدید()
    شرط = همگام سازی.متغیر شرط جدید()
    آغاز := همگام سازی.اکنون میلی ثانیه()
    همگام سازی.قفل کردن(قفل)
    سرچاپ همگام سازی.انتظار شرط با مهلت(شرط، قفل، ۱۰)
    ن := spawn(سازنده)
    تا وارونه آماده:
        همگام سازی.انتظار شرط(شرط، قفل)
    پایان
    همگام سازی.باز کردن قفل(قفل)
    join(ن)
    سرچاپ آماده، همگام سازی.اکنون میلی ثانیه() - آغاز >= ۲۰
    همگام سازی.اعلام(شرط)
    همگام سازی.نابودسازی متغیر شرط(شرط)
    همگام سازی.نابودسازی(قفل)
پایان
