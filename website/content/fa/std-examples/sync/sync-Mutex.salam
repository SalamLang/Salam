واردسازی همگام سازی

ناپایا موجودی := ۰
ناپایا قفل := همگام سازی.قفل {}
ناپایا گروه := همگام سازی.گروه انتظار {}

روال واریز():
    تکرار ۵۰۰:
        همگام سازی.قفل کردن(قفل)
        موجودی += ۱
        همگام سازی.باز کردن قفل(قفل)
    پایان
    همگام سازی.اتمام(گروه)
پایان

روال ریشه:
    قفل = همگام سازی.قفل جدید()
    گروه = همگام سازی.گروه انتظار جدید()
    همگام سازی.انتظار(گروه)
    همگام سازی.افزودن(گروه، ۴)
    الف := spawn(واریز)
    ب := spawn(واریز)
    ج := spawn(واریز)
    د := spawn(واریز)
    همگام سازی.انتظار(گروه)
    join(الف)
    join(ب)
    join(ج)
    join(د)
    سرچاپ "موجودی:"، موجودی
    همگام سازی.نابودسازی گروه انتظار(گروه)
    همگام سازی.نابودسازی(قفل)
پایان
