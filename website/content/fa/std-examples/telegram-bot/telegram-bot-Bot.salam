    _ := بات.ارسال استیکر(بات، گفتگو، "CAACAgI")
    _ := بات.ارسال موقعیت(بات، گفتگو، ۳۵.۶۹۹۷، ۵۱.۳۳۸)
    _ := بات.ارسال مخاطب(بات، گفتگو، "+989120000000"، "علی")
    _ := بات.ارسال کنش گفتگو(بات، گفتگو، "typing")
    _ := بات.ویرایش متن پیام(بات، گفتگو، ۱۰، "ویرایش شد")
    _ := بات.ارسال دوباره پیام(بات، گفتگو، ۴۳، ۱۱)
    _ := بات.سنجاق کردن پیام(بات، گفتگو، ۱۰)
    _ := بات.برداشتن سنجاق پیام(بات، گفتگو، ۱۰)
    _ := بات.حذف پیام(بات، گفتگو، ۱۰)
    _ := بات.پاسخ به پرسمان بازخوان(بات، "cq1"، "ثبت شد")
    _ := بات.پاسخ به پرسمان درون خطی(بات، "iq1"، "[]")
    پرونده := بات.دریافت فایل(بات، "AgACAgQ")
    سرچاپ پرونده.result.طول() > ۰
    _ := بات.دریافت گفتگو(بات، گفتگو)
    _ := بات.تعداد اعضای گفتگو(بات، گفتگو)
    _ := بات.عضو گفتگو(بات، گفتگو، ۷)
    _ := بات.مسدود کردن عضو(بات، گفتگو، ۷)
    _ := بات.رفع مسدودیت عضو(بات، گفتگو، ۷)
    _ := بات.ترک گفتگو(بات، -۱۰۰)
    ناپایا دستورها := وکتور {} برگردان وکتور<رشته>
    دستورها.افزودن(بات.دستور بات("start"، "شروع"))
    _ := بات.تنظیم دستورات بات(بات، دستورها)
    _ := بات.تنظیم وب هوک(بات، "https://example.com/hook")
    _ := بات.تنظیم وب هوک با رمز(بات، "https://example.com/hook"، "راز-من")
    _ := بات.دریافت اطلاعات وب هوک(بات)
    _ := بات.حذف وب هوک(بات)
    ناپایا پارامتر := نگاشت {} برگردان نگاشت<رشته، رشته>
    پارامتر.درج("chat_id"، "42")
    _ := بات.فراخوان(بات، "getChatAdministrators"، پارامتر)
    ب := بات.دریافت بروزرسانی ها(بات، ۰، ۱۰، ۳۰)
    سرچاپ بات.تجزیه بروزرسانی ها(ب.result).طول()، بات.token.طول() > ۰
    بات.حلقه دریافت(بات، ۳۰، (ب: بات.بروزرسانی):
        رسیدگی(ب)
    پایان)
