روال ریشه:
    بات := بات.بات جدید(محیط.دریافت("TELEGRAM_TOKEN"))
    من := بات.دریافت من(بات)
    اگر وارونه بات.موفق(من):
        سرچاپ من.error_code، من.description، من.http_status، من.http_err
        برگشت
    پایان
    سرچاپ من.ok، من.result
    گفتگو := ۴۲ برگردان صحیح۶۴
    _ := بات.ارسال پیام(بات، گفتگو، "سلام")
    _ := بات.ارسال پیام(بات، "@my_channel"، "خبر تازه")
    ناپایا گ := بات.گزینه های ارسال {}
    گ.parse_mode = "Markdown"
    گ.reply_markup = بات.حذف صفحه کلید()
    _ := بات.ارسال پیام با گزینه ها(بات، گفتگو، "*مهم*"، گ)
    _ := بات.ارسال عکس(بات، گفتگو، "https://example.com/a.jpg"، "عکس")
