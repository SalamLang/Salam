واردسازی تلگرام.بات

روال ریشه:
    متن := `{"update_id":10,"message":{"message_id":5,"date":1700000000,"text":"/start hello","chat":{"id":42,"type":"private","first_name":"مریم","username":"maryam"},"from":{"id":42,"is_bot":false,"first_name":"مریم","language_code":"fa"},"reply_to_message":{"message_id":4,"from":{"id":7,"first_name":"علی"}}}}`
    ب := بات.تجزیه بروزرسانی(متن)
    سرچاپ ب.update_id، ب.has_message، ب.has_callback_query
    پ := ب.message
    سرچاپ پ.message_id، پ.date، پ.text، پ.chat.id، پ.chat.chat_type، پ.chat.first_name، پ.chat.username
    سرچاپ پ.from_user.id، پ.from_user.is_bot، پ.from_user.language_code، پ.reply_to.message_id، پ.reply_to.user_id، پ.reply_to.user_name
    سرچاپ بات.دستور است(پ.text)، بات.نام دستور(پ.text)، بات.آرگومان های دستور(پ.text)
    سرچاپ بات.دستور است("سلام")، بات.نام دستور("/help@my_bot")

    همه := بات.تجزیه بروزرسانی ها(`{"ok":true,"result":[{"update_id":11,"callback_query":{"id":"cq1","data":"yes","from":{"id":42,"first_name":"مریم"},"message":{"message_id":9,"chat":{"id":42,"type":"private"}}}},{"update_id":12,"inline_query":{"id":"iq1","query":"کتاب","offset":"","from":{"id":42,"first_name":"مریم"}}}]}`)
    سرچاپ همه.طول()
    ق := همه[۰].callback_query
    سرچاپ همه[۰].has_callback_query، ق.id، ق.data، ق.from_user.first_name، ق.has_message، ق.message.message_id
    د := همه[۱].inline_query
    سرچاپ همه[۱].has_inline_query، د.id، د.query، د.offset.طول()
    سرچاپ بات.تجزیه کاربر(`{"id":1,"first_name":"x","last_name":"y","is_bot":true}`).last_name
    سرچاپ بات.تجزیه گفتگو(`{"id":-100,"type":"supergroup","title":"گروه"}`).title
    سرچاپ بات.تجزیه پیام(`{"message_id":1,"caption":"عکس","chat":{"id":1}}`).caption
    سرچاپ بات.تجزیه پرسمان بازخوان(`{"id":"q","data":"d"}`).data، بات.تجزیه پرسمان درون خطی(`{"id":"i","query":"q"}`).query
    سرچاپ بات.تجزیه بروزرسانی(`{"update_id":13,"channel_post":{"message_id":1,"text":"خبر","chat":{"id":-5}}}`).channel_post.text

    ناپایا ردیف۱ := وکتور {} برگردان وکتور<رشته>
    ردیف۱.افزودن(بات.دکمه درون خطی("بله"، "yes"))
    ردیف۱.افزودن(بات.دکمه درون خطی("خیر"، "no"))
    ناپایا ردیف۲ := وکتور {} برگردان وکتور<رشته>
    ردیف۲.افزودن(بات.دکمه درون خطی با پیوند("سایت"، "https://salamlang.ir"))
    ناپایا ردیف‌ها := وکتور {} برگردان وکتور<رشته>
    ردیف‌ها.افزودن(بات.ردیف(ردیف۱))
    ردیف‌ها.افزودن(بات.ردیف(ردیف۲))
    سرچاپ بات.صفحه کلید درون خطی(ردیف‌ها)
    ناپایا ساده := وکتور {} برگردان وکتور<رشته>
    ساده.افزودن(بات.دکمه صفحه کلید("منو"))
    ناپایا ردیف‌های ساده := وکتور {} برگردان وکتور<رشته>
    ردیف‌های ساده.افزودن(بات.ردیف(ساده))
    سرچاپ بات.صفحه کلید پاسخ(ردیف‌های ساده)
    سرچاپ بات.حذف صفحه کلید()، بات.پاسخ اجباری()
    سرچاپ بات.دستور بات("start"، "شروع")

    ربات := بات.بات جدید("123:ABC")
    سرچاپ بات.پیوند فایل(ربات، "photos/file_1.jpg")
    سرچاپ بات.پاسخ پیام(۴۲، "سلام")
    ناپایا گ := بات.گزینه های ارسال {}
    گ.parse_mode = "HTML"
    گ.reply_to_message_id = ۵
    گ.disable_notification = درست
    سرچاپ بات.پاسخ پیام با گزینه ها(۴۲، "<b>سلام</b>"، گ)
    سرچاپ بات.پاسخ فوری پرسمان بازخوان("cq1"، "ثبت شد"، نادرست)
    سرچاپ بات.پاسخ کنش گفتگو(۴۲، "typing")
    سرچاپ بات.پاسخ ویرایش متن پیام(۴۲، ۹، "به‌روز شد"، بات.حذف صفحه کلید())
    سرچاپ بات.سرآیند راز
پایان
