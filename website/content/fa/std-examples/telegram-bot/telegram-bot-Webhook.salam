واردسازی تلگرام.بات تلگرام
واردسازی شبکه.اچ تی تی پی شبکه
واردسازی شبکه.مسیریاب شبکه

روال وب‌هوک(ز: صحیح۶۴):
    اگر اچ تی تی پی شبکه.سرصفحه زمینه(ز، بات تلگرام.سرآیند راز) != "راز-من":
        اچ تی تی پی شبکه.وضعیت زمینه(ز، ۴۰۳)
        اچ تی تی پی شبکه.متن زمینه(ز، "forbidden")
        برگشت
    پایان
    ب := بات تلگرام.تجزیه بروزرسانی(اچ تی تی پی شبکه.بدنه زمینه(ز))
    اگر ب.has_message و بات تلگرام.دستور است(ب.message.text):
        پاسخ := "دستور " + بات تلگرام.نام دستور(ب.message.text) + " رسید"
        اچ تی تی پی شبکه.جیسون زمینه(ز، بات تلگرام.پاسخ پیام(ب.message.chat.id، پاسخ))
    وگرنه ب.has_callback_query:
        اچ تی تی پی شبکه.جیسون زمینه(ز، بات تلگرام.پاسخ فوری پرسمان بازخوان(ب.callback_query.id، "باشه"، درست))
    وگرنه:
        اچ تی تی پی شبکه.متن زمینه(ز، "ok")
    پایان
پایان

روال ریشه:
    ناپایا م := مسیریاب شبکه.مسیریاب جدید()
    مسیریاب شبکه.ارسال(م، "/hook"، وب‌هوک)
    ناپایا س := اچ تی تی پی شبکه.سرور جدید(۱۹۶۱۲)
    اچ تی تی پی شبکه.استفاده(س، م)
    _ := اچ تی تی پی شبکه.اجرا در پس زمینه(س)

    ناپایا سر := اچ تی تی پی شبکه.سرصفحه جدید()
    سر.درج(بات تلگرام.سرآیند راز، "راز-من")
    سر.درج("Content-Type"، "application/json")
    پ := اچ تی تی پی شبکه.ارسال با("http://127.0.0.1:19612/hook"، `{"update_id":1,"message":{"message_id":2,"text":"/start","chat":{"id":42,"type":"private"}}}`، سر)
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ)، اچ تی تی پی شبکه.بدنه(پ)
    پ۲ := اچ تی تی پی شبکه.ارسال با("http://127.0.0.1:19612/hook"، `{"update_id":2,"callback_query":{"id":"cq9","data":"x","from":{"id":42}}}`، سر)
    سرچاپ اچ تی تی پی شبکه.بدنه(پ۲)
    پ۳ := اچ تی تی پی شبکه.ارسال("http://127.0.0.1:19612/hook"، "{}")
    سرچاپ اچ تی تی پی شبکه.وضعیت(پ۳)
پایان
