واردسازی تلگرام.بات
واردسازی شبکه.اچ تی تی پی
واردسازی شبکه.مسیریاب

تابع وب‌هوک(ز: صحیح۶۴):
    اگر اچ تی تی پی.سرصفحه(ز، بات.سرآیند راز) != "راز-من":
        اچ تی تی پی.تنظیم وضعیت(ز، ۴۰۳)
        اچ تی تی پی.متن(ز، "forbidden")
        برگشت
    پایان
    ب := بات.تجزیه بروزرسانی(اچ تی تی پی.بدنه(ز))
    اگر ب.پیام دارد و بات.دستور است(ب.پیام.متن):
        پاسخ := "دستور " + بات.نام دستور(ب.پیام.متن) + " رسید"
        اچ تی تی پی.جیسون(ز، بات.پاسخ پیام(ب.پیام.گفتگو.شناسه، پاسخ))
    وگرنه ب.فشردن دکمه دارد:
        اچ تی تی پی.جیسون(ز، بات.پاسخ فوری پرسمان بازخوان(ب.فشردن دکمه.شناسه، "باشه"، درست))
    وگرنه:
        اچ تی تی پی.متن(ز، "ok")
    پایان
پایان

تابع ریشه:
    ناپایا م := مسیریاب.مسیریاب جدید()
    مسیریاب.ارسال(م، "/hook"، وب‌هوک)
    ناپایا س := اچ تی تی پی.سرور جدید(۱۹۶۱۲)
    اچ تی تی پی.استفاده(س، م)
    _ := اچ تی تی پی.اجرا در پس زمینه(س)

    ناپایا سر := اچ تی تی پی.سرصفحه جدید()
    سر.درج(بات.سرآیند راز، "راز-من")
    سر.درج("Content-Type"، "application/json")
    پ := اچ تی تی پی.ارسال با("http://127.0.0.1:19612/hook"، `{"update_id":1,"message":{"message_id":2,"text":"/start","chat":{"id":42,"type":"private"}}}`، سر)
    سرچاپ اچ تی تی پی.وضعیت(پ)، اچ تی تی پی.بدنه(پ)
    پ۲ := اچ تی تی پی.ارسال با("http://127.0.0.1:19612/hook"، `{"update_id":2,"callback_query":{"id":"cq9","data":"x","from":{"id":42}}}`، سر)
    سرچاپ اچ تی تی پی.بدنه(پ۲)
    پ۳ := اچ تی تی پی.ارسال("http://127.0.0.1:19612/hook"، "{}")
    سرچاپ اچ تی تی پی.وضعیت(پ۳)
پایان
