واردسازی قالب

روال ریشه:
    ناپایا ز := قالب.زمینه جدید()
    دیرکن ز.آزادکن()
    ز.درج("نام"، "سارا")
    ز.درج("پیام"، "<سلام>")
    سرچاپ قالب.رندر("سلام {{نام}}! {{پیام}}"، ز)
    سرچاپ قالب.رندر اچ تی ام ال("<p>{{پیام}}</p>"، ز)
    سرچاپ قالب.گریز اچ تی ام ال("<a href=\"x\">&</a>")
    سرچاپ قالب.متغیر("نام")
پایان
