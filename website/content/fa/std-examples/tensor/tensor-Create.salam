واردسازی تانسور
واردسازی فشرده سازی

تابع ریشه:
    ناپایا شکل := تانسور.شکل دو(۲، ۳)
    ناپایا الف := تانسور.بازه گام(۶)
    ناپایا ب := تانسور.تغییر شکل(الف، شکل)
    سرچاپ تانسور.رشته شکل(ب)، ب.رتبه()، ب.شمار درایه‌ها()، ب.بعد(۰)، ب.بعد(۱)، ب.تهی است()
    سرچاپ تانسور.به رشته(ب)
    سرچاپ ب.در دو(۱، ۲)، ب.عنصر(۴)
    ب.تنظیم در دو(۰، ۰، ۹.۰)
    ب.تنظیم در(۱، ۸.۰)
    ب.افزودن در(۲، ۰.۵)
    تانسور.چاپ(ب)

    ناپایا ص := تانسور.صفرها(شکل)
    سرچاپ تانسور.رشته شکل(ص)، ص.هم‌شکل(ب)، تانسور.هم‌شکل(ص، ب)
    ناپایا ص۱ := تانسور.صفرها یک(۳)
    ناپایا ص۲ := تانسور.صفرها دو(۲، ۲)
    ناپایا ص۳ := تانسور.صفرها سه(۲، ۲، ۲)
    ناپایا ص۴ := تانسور.صفرها چهار(۱، ۲، ۲، ۲)
    سرچاپ ص۱.شمار درایه‌ها()، ص۲.شمار درایه‌ها()، ص۳.شمار درایه‌ها()، ص۴.رتبه()
    ناپایا یک := تانسور.یک‌ها(تانسور.شکل یک(۳))
    ناپایا پر := تانسور.پرشده(تانسور.شکل سه(۱، ۱، ۲)، ۷.۰)
    ناپایا اسک := تانسور.اسکالر(۲.۵)
    سرچاپ تانسور.به رشته(یک)، تانسور.به رشته(پر)، اسک.رتبه()، اسک.عنصر(۰)
    سرچاپ تانسور.شکل چهار(۱، ۲، ۳، ۴).طول()، تانسور.تهی().تهی است()

    ناپایا داده := وکتور {} برگردان وکتور<اعشار۳۲>
    داده.بیفزا(۱.۰ برگردان اعشار۳۲)
    داده.بیفزا(۲.۰ برگردان اعشار۳۲)
    ناپایا ا := تانسور.از آرایه(تانسور.شکل یک(۲)، داده)
    ناپایا رونوشت := تانسور.همانند(ا)
    تانسور.تنظیم همه(رونوشت، ۵.۰)
    تانسور.رونوشت در(ص۱، یک)
    سرچاپ تانسور.به رشته(ا)، تانسور.به رشته(رونوشت)، تانسور.به رشته(ص۱)

    ناپایا شکل۲ := تانسور.شکل سه(۳، ۱، ۲)
    سرچاپ ب.تغییر شکل درجا(شکل۲)، تانسور.رشته شکل(ب)
    تانسور.فشردن درجا(ب)
    سرچاپ تانسور.رشته شکل(ب)
    تانسور.گشودن درجا(ب، ۰)
    سرچاپ تانسور.رشته شکل(ب)
    ناپایا ترتیب := وکتور {} برگردان وکتور<صحیح>
    ترتیب.بیفزا(۲)
    ترتیب.بیفزا(۱)
    ترتیب.بیفزا(۰)
    ناپایا ج := تانسور.جایگشت(ب، ترتیب)
    سرچاپ تانسور.رشته شکل(ج)
    ناپایا م := تانسور.بازه گام(۶)
    ناپایا م۲ := تانسور.تغییر شکل(م، شکل)
    سرچاپ تانسور.به رشته(تانسور.برش محور صفر(م۲، ۱، ۱))، تانسور.به رشته(تانسور.باریک‌سازی(م۲، ۱، ۱، ۲))
    سرچاپ تانسور.رشته شکل(تانسور.پیوند دو(م۲، م۲، ۰))، تانسور.رشته شکل(تانسور.انباشت دو(م۲، م۲))
    سرچاپ تانسور.رشته شکل(تانسور.گسترش(تانسور.اسکالر(۱.۰)، شکل))

    ماتریسی := تانسور.به ماتریس(م۲)
    سرچاپ ماتریسی.rows، ماتریسی.cols، تانسور.رشته شکل(تانسور.از ماتریس(ماتریسی))

    ناپایا بافر := فشرده سازی.بافر بایت جدید()
    سرچاپ تانسور.نوشتن تانسور(بافر، "w"، م۲)
    ناپایا خواننده := فشرده سازی.خواننده از بافر(بافر)
    ناپایا نام := ""
    ناپایا خوانده := تانسور.تهی()
    سرچاپ تانسور.خواندن تانسور(خواننده، نام، خوانده)، نام، تانسور.یکسان(خوانده، م۲)
    فشرده سازی.آزادسازی بافر(بافر)
    سرچاپ تانسور.رواداری تانسور
    تانسور.آزادسازی(الف)
    ب.آزادسازی()
پایان
