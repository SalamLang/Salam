واردسازی تانسور

تابع نشان(نام: رشته، ت &: تانسور.تانسور):
    سرچاپ نام، تانسور.به رشته(ت)
پایان

تابع ریشه:
    ناپایا الف := تانسور.بازه گام(۴)
    ناپایا ب := تانسور.پرشده(تانسور.شکل یک(۴)، ۱.۵)
    نشان("بزرگتر"، تانسور.بزرگتر(الف، ب))
    نشان("بزرگتر مساوی"، تانسور.بزرگتر مساوی(الف، تانسور.همانند(الف)))
    نشان("کوچکتر"، تانسور.کوچکتر(الف، ب))
    نشان("کوچکتر مساوی"، تانسور.کوچکتر مساوی(الف، ب))
    نشان("برابری"، تانسور.ماسک برابری(الف، الف))
    نشان("نابرابری"، تانسور.ماسک نابرابری(الف، ب))
    نشان("از عدد"، تانسور.بزرگتر از عدد(الف، ۱.۰))
    نشان("کمتر از عدد"، تانسور.کوچکتر از عدد(الف، ۱.۰))
    نشان("یکسان با عدد"، تانسور.یکسان با عدد(الف، ۲.۰))
    ناپایا شرط := تانسور.بزرگتر(الف، ب)
    نشان("کجا"، تانسور.کجا(شرط، الف، تانسور.قرینه(الف)))
    نشان("پرکردن"، تانسور.پرکردن ماسک‌شده(الف، شرط، -۱.۰))

    ناپایا ماتریسی := تانسور.تغییر شکل(تانسور.بازه گام(۶)، تانسور.شکل دو(۳، ۲))
    ناپایا شماره‌ها := وکتور {} برگردان وکتور<صحیح>
    شماره‌ها.بیفزا(۲)
    شماره‌ها.بیفزا(۰)
    نشان("انتخاب"، تانسور.انتخاب نمایه(ماتریسی، ۰، شماره‌ها))
    نشان("ردیف‌ها"، تانسور.گرفتن ردیف‌ها(ماتریسی، شماره‌ها))
    ناپایا جاها := تانسور.صفرها دو(۳، ۱)
    جاها.تنظیم در(۰، ۱.۰)
    نشان("گردآوری"، تانسور.گردآوری(ماتریسی، ۱، جاها))
    ناپایا مقصد := تانسور.صفرها دو(۳، ۲)
    سرچاپ تانسور.پراکندن جمعی ردیف‌ها(مقصد، شماره‌ها، تانسور.یک‌ها(تانسور.شکل دو(۲، ۲)))
    نشان("پراکندن"، مقصد)
    نشان("یک‌داغ"، تانسور.یک‌داغ(شماره‌ها، ۳))

    ناپایا نمره := تانسور.تغییر شکل(تانسور.بازه گام(۵)، تانسور.شکل یک(۵))
    ناپایا برترین‌ها := تانسور.تهی()
    نشان("کی برتر"، تانسور.کِی برتر(نمره، ۲، درست، برترین‌ها))
    نشان("جای برترها"، برترین‌ها)
    ناپایا مربعی := تانسور.یک‌ها(تانسور.شکل دو(۳، ۳))
    نشان("مثلث پایین"، تانسور.مثلث پایین(مربعی، ۰))
    نشان("مثلث بالا"، تانسور.مثلث بالا(مربعی، ۱))
    ناپایا شکل پخش := وکتور {} برگردان وکتور<صحیح>
    سرچاپ تانسور.شکل پخش(ماتریسی، تانسور.یک‌ها(تانسور.شکل یک(۲))، شکل پخش)، شکل پخش.طول()، شکل پخش.دریافت(۰)
    نشان("لایه‌گذاری"، تانسور.لایه‌گذاری دوبعدی(تانسور.یک‌ها(تانسور.شکل چهار(۱، ۱، ۱، ۱))، ۱، ۰، ۰، ۱))
پایان
