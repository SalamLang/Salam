واردسازی تانسور

تابع نشان(نام: رشته، ت &: تانسور.تانسور):
    سرچاپ نام، تانسور.به رشته(ت)
پایان

تابع نشان گرد(نام: رشته، ت &: تانسور.تانسور):
    ناپایا متن := ""
    تکرار ت.شمار درایه‌ها() در ش:
        گرد := (ت.عنصر(ش) * ۱۰۰۰.۰ + ۰.۵) برگردان صحیح
        متن += " " + گرد
    پایان
    سرچاپ نام + " ×۱۰۰۰:" + متن
پایان

تابع ریشه:
    ناپایا الف := تانسور.بازه گام(۴)
    ناپایا ب := تانسور.پرشده(تانسور.شکل یک(۴)، ۲.۰)
    ناپایا ج := الف + ب
    نشان("+"، ج)
    ناپایا ج۲ := الف * ب - ب / ب
    نشان("*-/"، ج۲)
    ناپایا ج۳ := تانسور.جمع(الف، ب)
    ناپایا ج۴ := تانسور.تفریق(الف، ب)
    ناپایا ج۵ := تانسور.ضرب درایه‌ای(الف، ب)
    ناپایا ج۶ := تانسور.تقسیم درایه‌ای(الف، ب)
    نشان("جمع"، ج۳)
    نشان("تفریق"، ج۴)
    نشان("ضرب"، ج۵)
    نشان("تقسیم"، ج۶)
    ناپایا خ := تانسور.صفرها یک(۴)
    سرچاپ تانسور.جمع در(الف، ب، خ)، تانسور.تفریق در(الف، ب، خ)، تانسور.ضرب در(الف، ب، خ)، تانسور.تقسیم در(الف، ب، خ)
    نشان("تقسیم در"، خ)
    نشان("+۱"، تانسور.جمع با عدد(الف، ۱.۰))
    نشان("-۱"، تانسور.تفریق عدد(الف، ۱.۰))
    نشان("×۳"، تانسور.مقیاس(الف، ۳.۰))
    نشان("÷۲"، تانسور.تقسیم با عدد(الف، ۲.۰))
    نشان("قرینه"، تانسور.قرینه(الف))

    ناپایا د := تانسور.همانند(الف)
    تانسور.جمع درجا(د، ب)
    تانسور.تفریق درجا(د، الف)
    تانسور.ضرب درجا(د، ب)
    تانسور.مقیاس درجا(د، ۰.۵)
    تانسور.جمع عدد درجا(د، ۱.۰)
    تانسور.جمع مقیاس‌دار(د، الف، ۲.۰)
    نشان("درجا"، د)

    نشان گرد("نمایی"، تانسور.برش(تانسور.نمایی(الف)، ۰.۰، ۱۰.۰))
    نشان گرد("لگاریتم"، تانسور.لگاریتم(ب))
    نشان("تانژانت"، تانسور.تانژانت هذلولی(تانسور.صفرها یک(۲)))
    نشان گرد("سیگموئید"، تانسور.سیگموئید(تانسور.صفرها یک(۲)))
    نشان("یکسوساز"، تانسور.یکسوساز(تانسور.قرینه(الف)))
    نشان گرد("گلو"، تانسور.گلو(تانسور.صفرها یک(۲)))
    نشان گرد("سیلو"، تانسور.سیلو(تانسور.صفرها یک(۲)))
    نشان("ریشه"، تانسور.ریشه دوم(تانسور.ضرب درایه‌ای(ب، ب)))
    نشان("قدر مطلق"، تانسور.قدر مطلق(تانسور.قرینه(الف)))
    نشان("مربع"، تانسور.مربع(الف))
    نشان("توان"، تانسور.توان عددی(الف، ۳.۰))

    سرچاپ تانسور.مجموع همه(الف)، تانسور.میانگین همه(الف)، تانسور.بیشینه همه(الف)، تانسور.کمینه همه(الف)، تانسور.نمایه بیشینه همه(الف)
    ناپایا ماتریسی := تانسور.تغییر شکل(تانسور.بازه گام(۶)، تانسور.شکل دو(۲، ۳))
    نشان("مجموع محور"، تانسور.مجموع محور(ماتریسی، ۰، نادرست))
    نشان("میانگین محور"، تانسور.میانگین محور(ماتریسی، ۱، درست))
    نشان("بیشینه محور"، تانسور.بیشینه محور(ماتریسی، ۱، نادرست))
    نشان("نمایه بیشینه"، تانسور.نمایه بیشینه محور(ماتریسی، ۱، نادرست))
    نشان("جمع تجمعی"، تانسور.جمع تجمعی(ماتریسی، ۱))
    سرچاپ تانسور.مجموع همه(تانسور.بیشینه نرم(ماتریسی)) > ۱.۹۹، تانسور.بیشینه همه(تانسور.لگاریتم بیشینه نرم(الف)) < ۰.۰

    ناپایا ت := تانسور.ترانهاده دوبعدی(ماتریسی)
    نشان("ترانهاده"، ت)
    نشان("ضرب ماتریسی"، تانسور.ضرب ماتریسی(ماتریسی، ت))
    نشان("ضرب ترانهاده"، تانسور.ضرب ترانهاده(ماتریسی، ماتریسی))
    نشان("ضرب در ترانهاده"، تانسور.ضرب در ترانهاده(ماتریسی، ماتریسی))
    ناپایا حاصل := تانسور.صفرها دو(۲، ۲)
    سرچاپ تانسور.ضرب ماتریسی در(ماتریسی، ت، حاصل)، تانسور.ضرب ماتریسی انباشته(ماتریسی، ت، حاصل)
    نشان("انباشته"، حاصل)
    نشان("در بردار"، تانسور.ضرب در بردار(ماتریسی، تانسور.یک‌ها(تانسور.شکل یک(۳))))
    ناپایا دسته := تانسور.انباشت دو(ماتریسی، ماتریسی)
    ناپایا دسته ت := تانسور.انباشت دو(ت، ت)
    سرچاپ تانسور.رشته شکل(تانسور.ضرب ماتریسی دسته‌ای(دسته، دسته ت))، تانسور.ضرب داخلی(الف، ب)
    سرچاپ تانسور.بیشینه اختلاف مطلق(الف، ج۳)، تانسور.همه نزدیک(ج۳، ج، ۰.۰۰۱)
پایان
