واردسازی تانسور

روال گرد(ت &: تانسور.تانسور): رشته:
    ناپایا متن := ""
    تکرار ت.شمار درایه‌ها() در ش:
        اگر ش > ۰:
            متن += " "
        پایان
        متن += "" + ((ت.عنصر(ش) * ۱۰۰.۰ + ۱۰۰۰۰.۵) برگردان صحیح - ۱۰۰۰۰)
    پایان
    برگشت متن
پایان

روال ریشه:
    ناپایا مولد := تانسور.مولد تصادفی جدید(۴۲)
    سرچاپ مولد.بیت بعدی() > ۰، مولد.اعشاری بعدی() < ۱.۰، مولد.نرمال بعدی() < ۱۰.۰
    سرچاپ تانسور.بذر مشتق(۴۲، ۱) != تانسور.بذر مشتق(۴۲، ۲)
    ناپایا ی := تانسور.صفرها یک(۵)
    تانسور.پر کردن یکنواخت(ی، ۰.۰، ۱.۰، مولد)
    سرچاپ تانسور.کمینه همه(ی) >= ۰.۰، تانسور.بیشینه همه(ی) < ۱.۰
    تانسور.پر کردن نرمال(ی، ۰.۰، ۱.۰، مولد)
    تانسور.پر کردن برنولی(ی، ۰.۵، مولد)
    سرچاپ تانسور.مجموع همه(ی) <= ۵.۰
    ناپایا ت۱ := تانسور.تصادفی یکنواخت(تانسور.شکل یک(۳)، -۱.۰، ۱.۰، ۷)
    ناپایا ت۲ := تانسور.تصادفی یکنواخت(تانسور.شکل یک(۳)، -۱.۰، ۱.۰، ۷)
    سرچاپ تانسور.یکسان(ت۱، ت۲)، گرد(ت۱)
    ناپایا ن := تانسور.تصادفی نرمال(تانسور.شکل یک(۲)، ۷)
    سرچاپ ن.شمار درایه‌ها()

    تانسور.تنظیم نخ‌ها(۲)
    سرچاپ تانسور.نخ‌ها()

    سرچاپ تانسور.اندازه خروجی پیچش(۵، ۳، ۱، ۱)، تانسور.اندازه خروجی پیچش(۵، ۳، ۲، ۰)
    ناپایا تصویر := تانسور.تغییر شکل(تانسور.بازه گام(۱۶)، تانسور.شکل چهار(۱، ۱، ۴، ۴))
    ناپایا هسته := تانسور.یک‌ها(تانسور.شکل چهار(۱، ۱، ۲، ۲))
    ناپایا سوگیری := تانسور.صفرها یک(۱)
    ناپایا پیچش := تانسور.پیچش دوبعدی پیشرو(تصویر، هسته، سوگیری، ۲، ۲، ۰، ۰)
    سرچاپ تانسور.رشته شکل(پیچش)، گرد(پیچش)
    ناپایا جای بیشینه := تانسور.تهی()
    ناپایا بیشینه := تانسور.بیشینه‌گیری دوبعدی پیشرو(تصویر، ۲، ۲، ۲، ۲، جای بیشینه)
    سرچاپ گرد(بیشینه)، گرد(جای بیشینه)
    سرچاپ گرد(تانسور.میانگین‌گیری دوبعدی پیشرو(تصویر، ۲، ۲، ۲، ۲))
    ناپایا ستون‌ها := تانسور.تصویر به ستون(تصویر، ۰، ۲، ۲، ۲، ۲، ۰، ۰)
    سرچاپ تانسور.رشته شکل(ستون‌ها)
    ناپایا گرادیان := تانسور.صفرها چهار(۱، ۱، ۴، ۴)
    سرچاپ تانسور.ستون به تصویر انباشته(ستون‌ها، گرادیان، ۰، ۲، ۲، ۲، ۲، ۰، ۰)، تانسور.یکسان(گرادیان، تصویر)

    ناپایا م := تانسور.تغییر شکل(تانسور.بازه گام(۶)، تانسور.شکل دو(۲، ۳))
    ناپایا مت := تانسور.ترانهاده خام(م.data.ارجاع(۰)، ۲، ۳)
    سرچاپ تانسور.رشته شکل(مت)، گرد(مت)
    ناپایا حاصل := تانسور.صفرها دو(۲، ۲)
    تانسور.ضرب انباشته خام(م.data.ارجاع(۰)، مت.data.ارجاع(۰)، حاصل.data.ارجاع(۰)، ۲، ۳، ۲)
    سرچاپ گرد(حاصل)
پایان
