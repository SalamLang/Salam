واردسازی پایانه

روال ریشه:
    پایانه.تنظیم حالت رنگ(پایانه.بدون رنگ)
    ناپایا ن := پایانه.نوار جدید(۲۰۰، "دانلود")
    ن.width = ۲۰
    ن.fill = "█"
    ن.empty = "░"
    پایانه.تنظیم نوار(ن، ۵۰)
    سرچاپ پایانه.ترسیم نوار(ن)
    پایانه.افزودن به نوار(ن، ۱۰۰)
    ن.show_count = درست
    سرچاپ پایانه.ترسیم نوار(ن)
    ناپایا چ := پایانه.چرخنده جدید("در حال کار")
    دیرکن پایانه.آزادسازی چرخنده(چ)
    سرچاپ چ.label، چ.frames.طول() > ۰
    ناپایا قاب‌ها := وکتور {} برگردان وکتور<رشته>
    قاب‌ها.بیفزا("◐")
    قاب‌ها.بیفزا("◓")
    ناپایا چ۲ := پایانه.چرخنده با قاب‌ها("بارگذاری"، قاب‌ها)
    دیرکن پایانه.آزادسازی چرخنده(چ۲)
    تکرار ۳:
        سرچاپ پایانه.قاب چرخنده(چ۲)
        چ۲.idx = (چ۲.idx + ۱) % قاب‌ها.طول()
    پایان
پایان
