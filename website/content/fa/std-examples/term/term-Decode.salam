واردسازی پایانه

روال شرح(ک: پایانه.کلید): رشته:
    اگر ک.code == پایانه.کلید نویسه:
        برگشت "نویسه " + ک.ch + (ک.ctrl ? " با کنترل" : "") + (ک.alt ? " با آلت" : "")
    وگرنه ک.code == پایانه.کلید بالا:
        برگشت "بالا"
    وگرنه ک.code == پایانه.کلید ورود:
        برگشت "ورود"
    وگرنه ک.code == پایانه.کلید گریز:
        برگشت "گریز"
    وگرنه ک.code >= پایانه.کلید اف۱ و ک.code < پایانه.کلید اف۱ + ۱۲:
        برگشت "اف" + (ک.code - پایانه.کلید اف۱ + ۱)
    پایان
    برگشت "کد " + ک.code
پایان

روال ریشه:
    هر د در ["a"، "\u001b[A"، "\r"، "\u001b"، "\u0001"، "\u001bx"، "\u001bOQ"، "\u001b[3~"]:
        سرچاپ شرح(پایانه.رمزگشایی(د))
    پایان
    م := پایانه.رمزگشایی موشواره("\u001b[<0;12;5M")
    سرچاپ م.ok، م.button، م.col، م.row، م.pressed، م.motion
    سرچاپ پایانه.کلید حذف، پایانه.کلید تب، پایانه.کلید حذف عقب، پایانه.کلید فاصله، پایانه.کلید انتهای ورودی، پایانه.کلید ناشناخته
    سرچاپ پایانه.کلید پایین، پایانه.کلید راست، پایانه.کلید چپ، پایانه.کلید خانه، پایانه.کلید انتهای خط، پایانه.کلید صفحه بالا، پایانه.کلید صفحه پایین، پایانه.کلید درج، پایانه.کلید موشواره، پایانه.تاخیر گریز
پایان
