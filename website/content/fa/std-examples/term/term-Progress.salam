واردسازی پایانه
واردسازی زمان

روال ریشه:
    ناپایا ن := پایانه.نوار جدید(۵۰، "پردازش")
    تکرار ۵۰:
        پایانه.افزودن به نوار(ن، ۱)
        پایانه.کشیدن نوار(ن)
        زمان.خواب(۲۰)
    پایان
    پایانه.پایان نوار(ن)
    ناپایا چ := پایانه.چرخنده جدید("اتصال به سرور")
    تکرار ۲۰:
        پایانه.تیک چرخنده(چ)
        زمان.خواب(۵۰)
    پایان
    پایانه.توقف چرخنده(چ، "متصل شد")
    پایانه.آزادسازی چرخنده(چ)
پایان
