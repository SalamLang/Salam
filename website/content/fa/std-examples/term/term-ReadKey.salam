واردسازی پایانه

روال ریشه:
    اگر وارونه پایانه.پایانه است(پایانه.شناسه ورودی):
        نادرست‌سرچاپ "این برنامه باید در پایانه اجرا شود"
        برگشت ۱
    پایان
    ناپایا حالت := پایانه.حالت خام(پایانه.شناسه ورودی)
    دیرکن پایانه.بازگردانی(حالت)
    پایانه.نوشتن("کلیدی بزنید (q برای خروج)\r\n")
    تا درست:
        اگر وارونه پایانه.کلید آماده(۵۰۰):
            گذر
        پایان
        ک := پایانه.خواندن کلید()
        اگر ک.code == پایانه.کلید نویسه و ک.ch == "q":
            بشکن
        پایان
        پایانه.نوشتن("کد: " + ک.code + "\r\n")
    پایان
    ک۲ := پایانه.گرفتن کلید()
    بایت := پایانه.خواندن بایت()
    گذرواژه := پایانه.خواندن گذرواژه("گذرواژه: ")
    سرچاپ ک۲.code، بایت، گذرواژه.طول()
    ح۲ := پایانه.حالت نیمه‌خام(پایانه.شناسه ورودی)
    ناپایا ح۳ := ح۲
    پایانه.بازگردانی(ح۳)
    برگشت ۰
پایان
