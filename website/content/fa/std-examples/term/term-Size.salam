واردسازی پایانه

تابع ریشه:
    پ := پایانه.اندازه()
    سرچاپ پ.cols > ۰، پ.rows > ۰، پایانه.ستون ها() > ۰، پایانه.سطرها() > ۰
    ت := پایانه.پایانه دارد()
    سرچاپ ت == پایانه.پایانه است(پایانه.شناسه خروجی)
    سرچاپ پایانه.شناسه ورودی، پایانه.شناسه خروجی، پایانه.شناسه خطا
    پایانه.تنظیم حالت رنگ(پایانه.رنگ همیشه)
    سرچاپ پایانه.رنگ پشتیبانی می‌شود()
    ر۲۵۶ := پایانه.رنگ۲۵۶ پشتیبانی می‌شود()
    رکامل := پایانه.رنگ کامل پشتیبانی می‌شود()
    سرچاپ ر۲۵۶ یا وارونه ر۲۵۶، رکامل یا وارونه رکامل
پایان
