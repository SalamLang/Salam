واردسازی آزمایش

تابع جمع(الف: صحیح، ب: صحیح): صحیح:
    برگشت الف + ب
پایان

تابع ریشه:
    آزمایش.قالب گزارش("human")
    آزمایش.پالایه آزمون("add")
    آزمایش.شروع مجموعه("calc_test.salam")
    اگر آزمایش.انتخاب شده("test_add"):
        آزمایش.شروع آزمون("test_add"، ۷)
        آزمایش.ادعای برابری عدد(جمع(۲، ۲)، ۴)
        آزمایش.اتمام آزمون()
    پایان
    اگر آزمایش.انتخاب شده("test_add_zero"):
        آزمایش.شروع آزمون("test_add_zero"، ۱۱)
        آزمایش.ادعای برابری عدد(جمع(۵، ۰)، ۵)
        آزمایش.اتمام آزمون()
    پایان
    آزمایش.جمع‌بندی آزمون‌ها()
پایان
