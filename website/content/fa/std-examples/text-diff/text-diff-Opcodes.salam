واردسازی متن.تفاوت
واردسازی رشته

تابع name(tag: صحیح): رشته:
    ترابرد tag:
        تفاوت.همسان:
            برگشت "equal"
        پایان
        تفاوت.جایگزین:
            برگشت "replace"
        پایان
        تفاوت.حذف شده:
            برگشت "delete"
        پایان
        وگرنه:
            برگشت "insert"
        پایان
    پایان
پایان

تابع ریشه:
    الف := تفاوت.خط ها("one\ntwo\nthree\nfour\n")
    بافر_محلی := تفاوت.خط ها("one\n2\nthree\nfour\nfive\n")
    دیرکن الف.آزادکن()
    دیرکن بافر_محلی.آزادکن()
    متغیر_ops := تفاوت.دستورهای ویرایش(الف، بافر_محلی)
    دیرکن متغیر_ops.آزادکن()
    هر متغیر_op در متغیر_ops:
        سرچاپ name(متغیر_op.نوع)، "a[" + رشته.از عدد(متغیر_op.آغاز الف برگردان صحیح۶۴) + ":" + رشته.از عدد(متغیر_op.انتهای الف برگردان صحیح۶۴) + "]"، "b[" + رشته.از عدد(متغیر_op.آغاز ب برگردان صحیح۶۴) + ":" + رشته.از عدد(متغیر_op.انتهای ب برگردان صحیح۶۴) + "]"
    پایان
    متغیر_groups := تفاوت.دستورهای ویرایش گروه بندی شده(الف، بافر_محلی، 0)
    سرچاپ "hunks:"، متغیر_groups.طول()
    هر جی در متغیر_groups:
        جی.آزادکن()
    پایان
    متغیر_groups.آزادکن()
پایان
