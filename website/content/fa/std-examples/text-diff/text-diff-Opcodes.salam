واردسازی متن.تفاوت
واردسازی رشته

تابع name(tag: صحیح): رشته:
    ترابرد tag:
        تفاوت.همسان:
            برگشت "equal"
        پایان
        تفاوت.جایگزین:
            برگشت "replace"
        پایان
        تفاوت.حذف شده:
            برگشت "delete"
        پایان
        وگرنه:
            برگشت "insert"
        پایان
    پایان
پایان

تابع ریشه:
    a := تفاوت.خط ها("one\ntwo\nthree\nfour\n")
    b := تفاوت.خط ها("one\n2\nthree\nfour\nfive\n")
    دیرکن a.آزادکن()
    دیرکن b.آزادکن()
    ops := تفاوت.دستورهای ویرایش(a، b)
    دیرکن ops.آزادکن()
    هر op در ops:
        سرچاپ name(op.نوع)، "a[" + رشته.از عدد(op.آغاز الف برگردان صحیح۶۴) + ":" + رشته.از عدد(op.انتهای الف برگردان صحیح۶۴) + "]"، "b[" + رشته.از عدد(op.آغاز ب برگردان صحیح۶۴) + ":" + رشته.از عدد(op.انتهای ب برگردان صحیح۶۴) + "]"
    پایان
    groups := تفاوت.دستورهای ویرایش گروه بندی شده(a، b، 0)
    سرچاپ "hunks:"، groups.طول()
    هر g در groups:
        g.آزادکن()
    پایان
    groups.آزادکن()
پایان
