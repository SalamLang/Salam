واردسازی متن.تفاوت

تابع ریشه:
    سرچاپ تفاوت.نسبت شباهت متن("kitten"، "sitting")
    سرچاپ تفاوت.نسبت شباهت متن("same"، "same")، تفاوت.نسبت شباهت متن("abc"، "xyz")
    الف := تفاوت.خط ها("a\nb\nc\nd\n")
    بافر_محلی := تفاوت.خط ها("a\nb\nx\nd\n")
    دیرکن الف.آزادکن()
    دیرکن بافر_محلی.آزادکن()
    سرچاپ تفاوت.نسبت شباهت(الف، بافر_محلی)
پایان
