واردسازی متن.تفاوت

تابع ریشه:
    سرچاپ تفاوت.نسبت شباهت متن("kitten"، "sitting")
    سرچاپ تفاوت.نسبت شباهت متن("same"، "same")، تفاوت.نسبت شباهت متن("abc"، "xyz")
    a := تفاوت.خط ها("a\nb\nc\nd\n")
    b := تفاوت.خط ها("a\nb\nx\nd\n")
    دیرکن a.آزادکن()
    دیرکن b.آزادکن()
    سرچاپ تفاوت.نسبت شباهت(a، b)
پایان
