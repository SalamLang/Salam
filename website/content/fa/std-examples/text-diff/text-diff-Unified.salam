واردسازی متن.تفاوت

تابع ریشه:
    متغیر_old := تفاوت.خط ها("red\ngreen\nblue\n")
    متغیر_fresh := تفاوت.خط ها("red\nyellow\nblue\nblack\n")
    دیرکن متغیر_old.آزادکن()
    دیرکن متغیر_fresh.آزادکن()
    خط‌ها := تفاوت.تفاوت یکپارچه(متغیر_old، متغیر_fresh، "old.txt"، "new.txt"، 1)
    دیرکن خط‌ها.آزادکن()
    هر خط در خط‌ها:
        سرچاپ خط
    پایان
    چاپ تفاوت.تفاوت یکپارچه متن("a\nb\n"، "a\nc\n"، "x"، "y"، 0)
