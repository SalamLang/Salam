واردسازی متن.تفاوت

تابع ریشه:
    old := تفاوت.خط ها("red\ngreen\nblue\n")
    fresh := تفاوت.خط ها("red\nyellow\nblue\nblack\n")
    دیرکن old.آزادکن()
    دیرکن fresh.آزادکن()
    lines := تفاوت.تفاوت یکپارچه(old، fresh، "old.txt"، "new.txt"، 1)
    دیرکن lines.آزادکن()
    هر line در lines:
        سرچاپ line
    پایان
    چاپ تفاوت.تفاوت یکپارچه متن("a\nb\n"، "a\nc\n"، "x"، "y"، 0)
پایان
