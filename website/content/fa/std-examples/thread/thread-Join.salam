واردسازی نخ
واردسازی همگام سازی

ناپایا جمع := ۰
ناپایا قفل := همگام سازی.قفل {}

روال کارگر():
    تکرار ۱۰۰۰:
        همگام سازی.قفل کردن(قفل)
        جمع += ۱
        همگام سازی.باز کردن قفل(قفل)
    پایان
پایان

روال ریشه:
    قفل = همگام سازی.قفل جدید()
    اول := نخ.جدید(نخ‌ساز(کارگر))
    سرچاپ نخ.معتبر(اول)، نخ.دسته(اول) != ۰
    ناپایا گروه := وکتور {} برگردان وکتور<نخ.نخ>
    دیرکن گروه.آزادکن()
    تکرار ۳:
        گروه = نخ.جمع آوری(گروه، نخ‌ساز(کارگر))
    پایان
    نخ.پیوستن(اول)
    نخ.پیوستن به همه(گروه)
    سرچاپ گروه.طول()، جمع
    خالی := نخ.جدید(۰)
    سرچاپ نخ.معتبر(خالی)، خالی.handle
    نخ.پیوستن(خالی)
    همگام سازی.نابودسازی(قفل)
پایان
