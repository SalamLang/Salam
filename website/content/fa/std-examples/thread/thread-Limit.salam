واردسازی حافظه
واردسازی نخ

ناپایا متغیر_stop := پوچ برگردان صحیح۶۴*

تابع hold():
    تا اتمی‌بخوان(متغیر_stop) نابرابر 0:
        گذر
    پایان
پایان

تابع ریشه:
    متغیر_stop = حافظه.تخصیص صفرشده(8 برگردان طبیعی۶۴) برگردان صحیح۶۴*
    اتمی‌بنویس(متغیر_stop، 1 برگردان صحیح۶۴)
    نخ.تعیین سقف(2 برگردان صحیح۶۴)
    الف := نخ‌ساز(hold)
    بافر_محلی := نخ‌ساز(hold)
    نویسه := نخ‌ساز(hold)
    سرچاپ "live: "، نخ.نخ‌های زنده()
    سرچاپ "third refused: "، نویسه برابر 0
    اتمی‌بنویس(متغیر_stop، 0 برگردان صحیح۶۴)
    نخ‌پیوند(الف)
    نخ‌پیوند(بافر_محلی)
    نخ‌پیوند(نویسه)
    سرچاپ "after join: "، نخ.نخ‌های زنده()
    دال := نخ‌ساز(hold)
    سرچاپ "slot free again: "، دال نابرابر 0
    نخ‌پیوند(دال)
    نخ.تعیین سقف(0 برگردان صحیح۶۴)
    حافظه.آزادسازی(متغیر_stop برگردان تهی*)
پایان
