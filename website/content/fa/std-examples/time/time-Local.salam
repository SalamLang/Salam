واردسازی زمان
واردسازی رشته

تابع ریشه:
    ت := زمان.از اجزای محلی(۲۰۲۴، ۳، ۲۰، ۹، ۳۰، ۰)
    سرچاپ زمان.سال(ت)، زمان.ماه(ت)، زمان.روز(ت)، زمان.ساعت(ت)، زمان.دقیقه(ت)، زمان.ثانیه(ت)
    سرچاپ زمان.روز هفته(ت)، زمان.روز سال(ت)
    سرچاپ زمان.قالب تاریخ(ت)، زمان.قالب ساعت(ت)
    سرچاپ زمان.قالب بندی(ت)
    سرچاپ زمان.قالب ایزو(ت)
    ر := زمان.قالب آر‌اف‌سی۳۳۳۹(ت)
    اختلاف := زمان.اختلاف محلی در(ت)
    سرچاپ رشته.شروع با(ر، "2024-03-20T09:30:00")، (اختلاف == ۰) == رشته.پایان با(ر، "Z")
    ز := زمان.از مبدا(ت)
    سرچاپ زمان.مبدا(ز) == ت، ز.epoch == ت
    سرچاپ زمان.مبدا(زمان.تاریخ زمان اکنون()) >= ت
پایان
