واردسازی زمان

ناپایا شمار := ۰

روال ریشه:
    ناپایا ز := زمان.زمان‌سنج جدید(زمان.میلی‌ثانیه‌ها(۱۰۰))
    سرچاپ ز.منقضی شده()، ز.باقی‌مانده().میلی‌ثانیه() > ۰
    ز.انتظار()
    سرچاپ ز.منقضی شده()، ز.باقی‌مانده().صفر است()
    ز.بازنشانی(زمان.ثانیه‌ها(۱۰))
    ز.توقف()
    سرچاپ ز.منقضی شده()، ز.active
    ناپایا ت := زمان.تیک‌زن جدید(زمان.میلی‌ثانیه‌ها(۵۰))
    سرچاپ ت.رخ داده()
    ت.انتظار()
    زمان.خواب(۱۲۰)
    سرچاپ ت.رخ داده()، ت.dropped >= ۱
    ت.پیشروی()
    سرچاپ ت.باقی‌مانده().میلی‌ثانیه() <= ۱۰۰
    ت.بازنشانی(زمان.میلی‌ثانیه‌ها(۵))
    ت.توقف()
    سرچاپ ت.رخ داده()
    زمان.پس از(زمان.میلی‌ثانیه‌ها(۱۰)، (): سرچاپ "پس از ۱۰ میلی‌ثانیه" پایان)
    زمان.تکرار با فاصله(زمان.میلی‌ثانیه‌ها(۵)، ۲، (): سرچاپ "تیک" پایان)
    سرچاپ زمان.هر(زمان.میلی‌ثانیه‌ها(۵)، (): شمار += ۱ برگشت شمار < ۳ پایان)
    شمار = ۰
    سرچاپ زمان.صبر برای((): شمار += ۱ برگشت شمار >= ۳ پایان، زمان.میلی‌ثانیه‌ها(۵)، زمان.ثانیه‌ها(۵))
    سرچاپ زمان.صبر برای((): برگشت نادرست پایان، زمان.میلی‌ثانیه‌ها(۵)، زمان.میلی‌ثانیه‌ها(۲۰))
پایان
