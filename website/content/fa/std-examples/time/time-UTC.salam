واردسازی زمان

تابع ریشه:
    ت := زمان.از اجزای جهانی(۲۰۲۴، ۳، ۲۰، ۱۴، ۵، ۹)
    سرچاپ ت، زمان.قالب ایزو جهانی(ت)
    سرچاپ زمان.سال جهانی(ت)، زمان.ماه جهانی(ت)، زمان.روز جهانی(ت)، زمان.ساعت جهانی(ت)، زمان.دقیقه جهانی(ت)، زمان.ثانیه جهانی(ت)
    سرچاپ زمان.قالب تاریخ اچ‌تی‌تی‌پی(ت)
    سرچاپ زمان.تجزیه تاریخ اچ‌تی‌تی‌پی("Wed, 20 Mar 2024 14:05:09 GMT").epoch == ت
    ن := زمان.تجزیه ایزو("2024-03-20T17:35:09+03:30")
    سرچاپ ن.ok، ن.epoch == ت، ن.nanos
    سرچاپ زمان.تجزیه ایزو در("2024-03-20 17:35:09.25"، ۲۱۰).epoch == ت، زمان.تجزیه ایزو در("2024-03-20 17:35:09.25"، ۲۱۰).nanos
    ق := زمان.تجزیه با قالب("%d/%m/%Y %H:%M %z"، "20/03/2024 14:05 +0000")
    سرچاپ ق.ok، زمان.قالب ایزو جهانی(ق.epoch)
    سرچاپ زمان.تجزیه ایزو("فردا").ok، زمان.تجزیه ایزو با پیش فرض("فردا"، ۰)
    ب := زمان.افزودن مدت(ت، زمان.روزها(۱۰))
    سرچاپ زمان.قالب ایزو جهانی(ب)، زمان.اختلاف ثانیه(ب، ت)، زمان.مدت بین(ب، ت).به رشته()
    سرچاپ زمان.ثانیه در دقیقه، زمان.ثانیه در ساعت، زمان.ثانیه در روز
پایان
