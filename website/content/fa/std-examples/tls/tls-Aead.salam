// زبان: فارسی
واردسازی تی ال اس
واردسازی حافظه

پایا DIGITS := "0123456789abcdef"

تابع hex_of(ویژگی_محلی: تهی*، تعداد: صحیح): رشته:
    ناپایا خروجی_مقدار := ""
    تکرار تعداد در شمارنده:
        بافر_محلی := (ویژگی_محلی برگردان طبیعی۸*)[شمارنده] برگردان صحیح
        خروجی_مقدار += DIGITS.زیررشته(بافر_محلی / 16، 1) + DIGITS.زیررشته(بافر_محلی % 16، 1)
    پایان
    برگشت خروجی_مقدار
پایان

تابع filled(تعداد: صحیح، start: صحیح): تهی*:
    ویژگی_محلی := حافظه.تخصیص صفرشده(تعداد برگردان طبیعی۶۴)
    تکرار تعداد در شمارنده:
        (ویژگی_محلی برگردان طبیعی۸*)[شمارنده] = ((start + شمارنده) % 256) برگردان طبیعی۸
    پایان
    برگشت ویژگی_محلی
پایان

تابع ریشه:
    سرچاپ تی ال اس.ای ای دی ای ای اس۱۲۸ جی سی ام، تی ال اس.ای ای دی ای ای اس۲۵۶ جی سی ام، تی ال اس.ای ای دی چاچا۲۰ پلی۱۳۰۵
    سرچاپ تی ال اس.طول برچسب ای ای دی، تی ال اس.طول نانس ای ای دی
    سرچاپ تی ال اس.طول کلید ای ای دی(تی ال اس.ای ای دی ای ای اس۱۲۸ جی سی ام)، تی ال اس.طول کلید ای ای دی(تی ال اس.ای ای دی ای ای اس۲۵۶ جی سی ام)، تی ال اس.طول کلید ای ای دی(تی ال اس.ای ای دی چاچا۲۰ پلی۱۳۰۵)

    کلید := filled(32، 0)
    نانس := filled(12، 100)
    پیام_متن := "attack at dawn"
    تعداد := پیام_متن.طول()
    خروجی_مقدار := حافظه.تخصیص صفرشده((تعداد + تی ال اس.طول برچسب ای ای دی) برگردان طبیعی۶۴)
    بازگشت := حافظه.تخصیص صفرشده((تعداد + 1) برگردان طبیعی۶۴)

    هر گونه در [تی ال اس.ای ای دی ای ای اس۱۲۸ جی سی ام، تی ال اس.ای ای دی ای ای اس۲۵۶ جی سی ام، تی ال اس.ای ای دی چاچا۲۰ پلی۱۳۰۵]:
        زمینه := تی ال اس.ای ای دی جدید(گونه، کلید)
        تی ال اس.مهر ای ای دی(زمینه، نانس، پوچ، 0، پیام_متن برگردان تهی*، تعداد، خروجی_مقدار)
        سرچاپ گونه، hex_of(خروجی_مقدار، تعداد + تی ال اس.طول برچسب ای ای دی)
        سرچاپ تی ال اس.گشودن ای ای دی(زمینه، نانس، پوچ، 0، خروجی_مقدار، تعداد، بازگشت)، (بازگشت برگردان رشته).زیررشته(0، تعداد)
        (خروجی_مقدار برگردان طبیعی۸*)[0] = ((خروجی_مقدار برگردان طبیعی۸*)[0] برگردان صحیح ^ 1) برگردان طبیعی۸
        سرچاپ تی ال اس.گشودن ای ای دی(زمینه، نانس، پوچ، 0، خروجی_مقدار، تعداد، بازگشت)
        تی ال اس.آزادسازی ای ای دی(زمینه)
    پایان

    سرچاپ تی ال اس.مهر خام ای ای اس جی سی ام(کلید، 16، نانس، پوچ، 0، پیام_متن برگردان تهی*، تعداد، خروجی_مقدار)
    سرچاپ hex_of(خروجی_مقدار، تعداد + تی ال اس.طول برچسب ای ای دی)
    سرچاپ تی ال اس.گشودن خام ای ای اس جی سی ام(کلید، 16، نانس، پوچ، 0، خروجی_مقدار، تعداد + تی ال اس.طول برچسب ای ای دی، بازگشت)، (بازگشت برگردان رشته).زیررشته(0، تعداد)

    سرچاپ تی ال اس.مهر خام چاچا۲۰ پلی۱۳۰۵(کلید، نانس، پوچ، 0، پیام_متن برگردان تهی*، تعداد، خروجی_مقدار)
    سرچاپ hex_of(خروجی_مقدار، تعداد + تی ال اس.طول برچسب ای ای دی)
    سرچاپ تی ال اس.گشودن خام چاچا۲۰ پلی۱۳۰۵(کلید، نانس، پوچ، 0، خروجی_مقدار، تعداد + تی ال اس.طول برچسب ای ای دی، بازگشت)، (بازگشت برگردان رشته).زیررشته(0، تعداد)

    متغیر_nonce24 := filled(24، 100)
    سرچاپ تی ال اس.مهر خام ایکس چاچا۲۰ پلی۱۳۰۵(کلید، متغیر_nonce24، پوچ، 0، پیام_متن برگردان تهی*، تعداد، خروجی_مقدار)
    سرچاپ hex_of(خروجی_مقدار، تعداد + تی ال اس.طول برچسب ای ای دی)
    سرچاپ تی ال اس.گشودن خام ایکس چاچا۲۰ پلی۱۳۰۵(کلید، متغیر_nonce24، پوچ، 0، خروجی_مقدار، تعداد + تی ال اس.طول برچسب ای ای دی، بازگشت)، (بازگشت برگردان رشته).زیررشته(0، تعداد)

    ساده := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    تکرار 16 در شمارنده:
        (ساده برگردان طبیعی۸*)[شمارنده] = (شمارنده * 17) برگردان طبیعی۸
    پایان
    متغیر_cipher := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    متغیر_key16 := filled(16، 0)
    سرچاپ تی ال اس.بلوک ای ای اس ای سی بی(متغیر_key16، 16، ساده، متغیر_cipher، نادرست)، hex_of(متغیر_cipher، 16)
    سرچاپ تی ال اس.بلوک ای ای اس ای سی بی(متغیر_key16، 16، متغیر_cipher، بازگشت، درست)، hex_of(بازگشت، 16) برابر hex_of(ساده، 16)

    حافظه.آزادسازی(کلید)
    حافظه.آزادسازی(نانس)
    حافظه.آزادسازی(متغیر_nonce24)
    حافظه.آزادسازی(خروجی_مقدار)
    حافظه.آزادسازی(بازگشت)
    حافظه.آزادسازی(ساده)
    حافظه.آزادسازی(متغیر_cipher)
    حافظه.آزادسازی(متغیر_key16)
پایان
