// زبان: فارسی
واردسازی تی ال اس
واردسازی حافظه

پایا DIGITS := "0123456789abcdef"

تابع hex_of(p: تهی*، n: صحیح): رشته:
    ناپایا out := ""
    تکرار n در i:
        b := (p برگردان طبیعی۸*)[i] برگردان صحیح
        out += DIGITS.زیررشته(b / 16، 1) + DIGITS.زیررشته(b % 16، 1)
    پایان
    برگشت out
پایان

تابع filled(n: صحیح، start: صحیح): تهی*:
    p := حافظه.تخصیص صفرشده(n برگردان طبیعی۶۴)
    تکرار n در i:
        (p برگردان طبیعی۸*)[i] = ((start + i) % 256) برگردان طبیعی۸
    پایان
    برگشت p
پایان

تابع ریشه:
    سرچاپ تی ال اس.ای ای دی ای ای اس۱۲۸ جی سی ام، تی ال اس.ای ای دی ای ای اس۲۵۶ جی سی ام، تی ال اس.ای ای دی چاچا۲۰ پلی۱۳۰۵
    سرچاپ تی ال اس.طول برچسب ای ای دی، تی ال اس.طول نانس ای ای دی
    سرچاپ تی ال اس.طول کلید ای ای دی(تی ال اس.ای ای دی ای ای اس۱۲۸ جی سی ام)، تی ال اس.طول کلید ای ای دی(تی ال اس.ای ای دی ای ای اس۲۵۶ جی سی ام)، تی ال اس.طول کلید ای ای دی(تی ال اس.ای ای دی چاچا۲۰ پلی۱۳۰۵)

    key := filled(32، 0)
    nonce := filled(12، 100)
    message := "attack at dawn"
    n := message.طول()
    out := حافظه.تخصیص صفرشده((n + تی ال اس.طول برچسب ای ای دی) برگردان طبیعی۶۴)
    back := حافظه.تخصیص صفرشده((n + 1) برگردان طبیعی۶۴)

    هر kind در [تی ال اس.ای ای دی ای ای اس۱۲۸ جی سی ام، تی ال اس.ای ای دی ای ای اس۲۵۶ جی سی ام، تی ال اس.ای ای دی چاچا۲۰ پلی۱۳۰۵]:
        ctx := تی ال اس.ای ای دی جدید(kind، key)
        تی ال اس.مهر ای ای دی(ctx، nonce، پوچ، 0، message برگردان تهی*، n، out)
        سرچاپ kind، hex_of(out، n + تی ال اس.طول برچسب ای ای دی)
        سرچاپ تی ال اس.گشودن ای ای دی(ctx، nonce، پوچ، 0، out، n، back)، (back برگردان رشته).زیررشته(0، n)
        (out برگردان طبیعی۸*)[0] = ((out برگردان طبیعی۸*)[0] برگردان صحیح ^ 1) برگردان طبیعی۸
        سرچاپ تی ال اس.گشودن ای ای دی(ctx، nonce، پوچ، 0، out، n، back)
        تی ال اس.آزادسازی ای ای دی(ctx)
    پایان

    سرچاپ تی ال اس.مهر خام ای ای اس جی سی ام(key، 16، nonce، پوچ، 0، message برگردان تهی*، n، out)
    سرچاپ hex_of(out، n + تی ال اس.طول برچسب ای ای دی)
    سرچاپ تی ال اس.گشودن خام ای ای اس جی سی ام(key، 16، nonce، پوچ، 0، out، n + تی ال اس.طول برچسب ای ای دی، back)، (back برگردان رشته).زیررشته(0، n)

    سرچاپ تی ال اس.مهر خام چاچا۲۰ پلی۱۳۰۵(key، nonce، پوچ، 0، message برگردان تهی*، n، out)
    سرچاپ hex_of(out، n + تی ال اس.طول برچسب ای ای دی)
    سرچاپ تی ال اس.گشودن خام چاچا۲۰ پلی۱۳۰۵(key، nonce، پوچ، 0، out، n + تی ال اس.طول برچسب ای ای دی، back)، (back برگردان رشته).زیررشته(0، n)

    nonce24 := filled(24، 100)
    سرچاپ تی ال اس.مهر خام ایکس چاچا۲۰ پلی۱۳۰۵(key، nonce24، پوچ، 0، message برگردان تهی*، n، out)
    سرچاپ hex_of(out، n + تی ال اس.طول برچسب ای ای دی)
    سرچاپ تی ال اس.گشودن خام ایکس چاچا۲۰ پلی۱۳۰۵(key، nonce24، پوچ، 0، out، n + تی ال اس.طول برچسب ای ای دی، back)، (back برگردان رشته).زیررشته(0، n)

    plain := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    تکرار 16 در i:
        (plain برگردان طبیعی۸*)[i] = (i * 17) برگردان طبیعی۸
    پایان
    cipher := حافظه.تخصیص صفرشده(16 برگردان طبیعی۶۴)
    key16 := filled(16، 0)
    سرچاپ تی ال اس.بلوک ای ای اس ای سی بی(key16، 16، plain، cipher، نادرست)، hex_of(cipher، 16)
    سرچاپ تی ال اس.بلوک ای ای اس ای سی بی(key16، 16، cipher، back، درست)، hex_of(back، 16) برابر hex_of(plain، 16)

    حافظه.آزادسازی(key)
    حافظه.آزادسازی(nonce)
    حافظه.آزادسازی(nonce24)
    حافظه.آزادسازی(out)
    حافظه.آزادسازی(back)
    حافظه.آزادسازی(plain)
    حافظه.آزادسازی(cipher)
    حافظه.آزادسازی(key16)
پایان
