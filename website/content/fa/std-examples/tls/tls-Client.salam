واردسازی تی ال اس

تابع ریشه:
    ناپایا پ := تی ال اس.پیکربندی جدید("example.com")
    پ.alpn = "http/1.1"
    ناپایا ا := تی ال اس.اتصال امن("example.com"، ۴۴۳، پ)
    اگر وارونه تی ال اس.اتصال معتبر(ا):
        سرچاپ "خطا:"، تی ال اس.خطای اتصال(ا)
        برگشت
    پایان
    سرچاپ تی ال اس.نسخه(ا)، تی ال اس.نام رمز(ا)، تی ال اس.تعداد گواهی همتا(ا)
    _ := تی ال اس.نوشتن(ا، "GET / HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n")
    ناپایا پاسخ := ""
    تا تی ال اس.اتصال معتبر(ا):
        تکه := تی ال اس.خواندن(ا، ۴۰۹۶)
        اگر تکه.طول() == ۰:
            بشکن
        پایان
        پاسخ += تکه
    پایان
    سرچاپ پاسخ.طول() > ۰
    تی ال اس.بستن اتصال(ا)
پایان
