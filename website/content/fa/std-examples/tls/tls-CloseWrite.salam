// زبان: فارسی
واردسازی تی ال اس
واردسازی شبکه.تی سی پی

تابع ریشه:
    پیکربندی := تی ال اس.پیکربندی کارساز جدید("cert.pem"، "key.pem")
    اگر وارونه پیکربندی.سالم:
        سرچاپ "the certificate or key could not be read"
        برگشت
    پایان
    کارساز := تی سی پی.پیوند(8443)
    سوکت := تی سی پی.پذیرش(کارساز)
    ناپایا اتصال := تی ال اس.پوشش کارساز(سوکت.توصیفگر، پیکربندی)
    اگر تی ال اس.اتصال معتبر(اتصال):
        ناپایا درخواست := ""
        تا درست:
            بخش := تی ال اس.خواندن(اتصال، 1024)
            اگر بخش.طول() برابر 0:
                بشکن
            پایان
            درخواست += بخش
        پایان
        سرچاپ درخواست.طول()، اتصال.پایان خواندن
        _ := تی ال اس.نوشتن(اتصال، "received " + درخواست.طول() + " bytes")
        تی ال اس.بستن نوشتن(اتصال)
    پایان
    تی ال اس.بستن اتصال(اتصال)
    تی سی پی.بستن سرور(کارساز)
پایان
