// زبان: فارسی
واردسازی رشته
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا ثبت‌شده := ""
ناپایا برگزیده := -1
ناپایا شمار فشار := 0
ناپایا تغییر کرد := نادرست

تابع کلید(دنباله: رشته): رابط‌پایانه.رویداد:
    برگشت رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی(دنباله) }
پایان

تابع ظاهر وارون(): رابط‌پایانه.ظاهر:
    ناپایا ظاهر := رابط‌پایانه.ظاهر {}
    ظاهر.معکوس = درست
    برگشت ظاهر
پایان

تابع ریشه:
    ناپایا بافر := رابط‌پایانه.بافر جدید(24، 5)

    ناپایا گذرواژه := رابط‌پایانه.کادر متن جدید()
    گذرواژه.پوشانده = درست
    گذرواژه.نماد پوشش = "*"
    گذرواژه.حداکثر طول = 8
    گذرواژه.پالایه = (نامزد: رشته): برگشت وارونه رشته.شامل است(نامزد، " ") پایان
    گذرواژه.هنگام ثبت = (مقدار: رشته):
        ثبت‌شده = مقدار
        برگشت درست
    پایان
    گذرواژه.تنظیم متن راهنما("گذرواژه")
    گذرواژه.تنظیم مقدار("")
    گذرواژه.ظاهر = رابط‌پایانه.ظاهر پیش‌فرض
    گذرواژه.ظاهر مکان‌نما = ظاهر وارون()
    گذرواژه.ظاهر متن راهنما = رابط‌پایانه.ظاهر { کم‌رنگ = درست }
    گذرواژه.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 0، عرض = 12، ارتفاع = 1 })
    هر نویسه در ["s"، " "، "e"، "c"]:
        _ := گذرواژه.پردازش رویداد(کلید(نویسه))
    پایان
    _ := گذرواژه.پردازش رویداد(کلید("\r"))
    سرچاپ "ورودی تمرکزپذیر:"، گذرواژه.تمرکز‌پذیر است()، "مقدار:"، گذرواژه.مقدار()، "ثبت شد:"، ثبت‌شده

    ناپایا دکمه خب := رابط‌پایانه.دکمه جدید("خب")
    دکمه خب.هنگام کلیک = (): شمار فشار++ پایان
    دکمه خب.ظاهر تمرکز = رابط‌پایانه.ظاهر { پررنگ = درست }
    دکمه خب.ظاهر = رابط‌پایانه.ظاهر پیش‌فرض
    دکمه خب.غیرفعال = نادرست
    دکمه خب.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 1، عرض = 8، ارتفاع = 1 })
    _ := دکمه خب.پردازش رویداد(کلید(" "))
    سرچاپ "دکمه:"، دکمه خب.برچسب، دکمه خب.تمرکز‌پذیر است()، دکمه خب.اصابت‌پذیر است()، "فشار"، شمار فشار، "عرض"، دکمه خب.اندازه ترجیحی(20).عرض

    ناپایا شکستن := رابط‌پایانه.کادر انتخاب جدید("شکستن خطوط"، نادرست)
    شکستن.هنگام تغییر انتخاب = (روشن: منطقی): تغییر کرد = روشن پایان
    شکستن.ظاهر کادر = رابط‌پایانه.ظاهر پیش‌فرض
    شکستن.ظاهر برچسب = رابط‌پایانه.ظاهر پیش‌فرض
    شکستن.غیرفعال = نادرست
    شکستن.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 2، عرض = 14، ارتفاع = 1 })
    _ := شکستن.پردازش رویداد(کلید(" "))
    شکستن.تنظیم انتخاب(شکستن.انتخاب شده است())
    سرچاپ "کادر انتخاب:"، شکستن.برچسب، شکستن.انتخاب شده است()، تغییر کرد، شکستن.تمرکز‌پذیر است()، شکستن.اصابت‌پذیر است()، شکستن.اندازه ترجیحی(20).عرض

    ناپایا گزینه‌ها := وکتور {} برگردان وکتور<رشته>
    گزینه‌ها.بیفزا("قرمز")
    گزینه‌ها.بیفزا("سبز")
    ناپایا رنگ‌ها := رابط‌پایانه.فهرست جدید(گزینه‌ها)
    رنگ‌ها.هنگام انتخاب = (شماره: صحیح): برگزیده = شماره پایان
    رنگ‌ها.ظاهر = رابط‌پایانه.ظاهر پیش‌فرض
    رنگ‌ها.ظاهر انتخاب = ظاهر وارون()
    رنگ‌ها.ظاهر انتخاب بی‌تمرکز = رابط‌پایانه.ظاهر { زیرخط = درست }
    رنگ‌ها.تنظیم محدوده(رابط‌پایانه.مستطیل { ایکس = 14، ایگرگ = 0، عرض = 8، ارتفاع = 2 })
    _ := رنگ‌ها.پردازش رویداد(کلید("j"))
    _ := رنگ‌ها.پردازش رویداد(کلید("\r"))
    سرچاپ "فهرست:"، رنگ‌ها.نمایه انتخاب()، رنگ‌ها.گزینه انتخاب‌شده()، برگزیده، رنگ‌ها.تمرکز‌پذیر است()

    گذرواژه.ترسیم(بافر، گذرواژه.محدوده())
    دکمه خب.ترسیم(بافر، دکمه خب.محدوده())
    شکستن.ترسیم(بافر، شکستن.محدوده())
    رنگ‌ها.ترسیم(بافر، رنگ‌ها.محدوده())
    تکرار بافر.ارتفاع در سطر:
        سرچاپ "|" + بافر.متن ردیف(سطر) + "|"
    پایان
    بافر.آزادسازی()
پایان
