// زبان: فارسی
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا شمار خروج := 0
ناپایا شمار بالا := 0

تابع ریشه:
    خروج := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی("q") }
    سرچاپ "q است:"، خروج.نویسه است("q")، "Ctrl+C است:"، خروج.ترکیب کنترل است("c")، "اینتر است:"، خروج.کلید است(پایانه.کلید ورود)
    کلیک := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد ماوس، کلید = پایانه.کلید { خام = "\x1b[<0;5;3M" }، ماوس = پایانه.رمزگشایی موشواره("\x1b[<0;5;3M") }
    نقطه := کلیک.مختصات ماوس()
    سرچاپ "کلیک در"، نقطه.ایکس، نقطه.ایگرگ
    تغییر اندازه := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد تغییر اندازه، عرض = 100، ارتفاع = 30 }
    سرچاپ "انواع:"، رابط‌پایانه.بدون رویداد، رابط‌پایانه.رویداد کیبورد، رابط‌پایانه.رویداد ماوس، تغییر اندازه.نوع، رابط‌پایانه.رویداد تیک، "اندازه"، تغییر اندازه.عرض، تغییر اندازه.ارتفاع، "بالا رفته"، تغییر اندازه.بالا رفته

    ناپایا ص := رابط‌پایانه.صفحه جدید(رابط‌پایانه.ویجت‌پایه {}، 10، 2)
    دیرکن ص.بستن()
    ناپایا نگاشت := رابط‌پایانه.نگاشت کلید جدید()
    نگاشت.پیوند کلید(پایانه.رمزگشایی("q")، (_ص: رابط‌پایانه.صفحه*، _ر: رابط‌پایانه.رویداد):
        شمار خروج++
        برگشت درست
    پایان)
    نگاشت.پیوند توالی("gg"، (_ص: رابط‌پایانه.صفحه*، _ر: رابط‌پایانه.رویداد):
        شمار بالا++
        برگشت درست
    پایان)
    نگاشت.پیوند کلید برای ویجت(رابط‌پایانه.شناسه ریشه، پایانه.رمزگشایی("x")، (_ص: رابط‌پایانه.صفحه*، _ر: رابط‌پایانه.رویداد): برگشت درست پایان)
    نگاشت.پیوند توالی برای ویجت(رابط‌پایانه.شناسه ریشه، "dd"، (_ص: رابط‌پایانه.صفحه*، _ر: رابط‌پایانه.رویداد): برگشت درست پایان)
    نگاشت.مهلت توالی به میلی‌ثانیه = 1000
    ص.تنظیم نگاشت کلید(نگاشت)
    _ := ص.هدایت رویداد(خروج)
    _ := ص.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی("g") })
    سرچاپ "مهلت توالی:"، ص.نگاشت کلید.مهلت توالی به میلی‌ثانیه، "میلی‌ثانیه"
    _ := ص.نگاشت کلید.آغاز انتظار توالی به میلی‌ثانیه
    _ := ص.هدایت رویداد(رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی("g") })
    سرچاپ "q فشرده شد"، شمار خروج، "gg فشرده شد"، شمار بالا
    ص.نگاشت کلید.لغو پیوند کلید(پایانه.رمزگشایی("q"))
    ص.نگاشت کلید.لغو پیوند کلید برای ویجت(رابط‌پایانه.شناسه ریشه، پایانه.رمزگشایی("x"))
    ص.نگاشت کلید.لغو پیوند توالی برای ویجت(رابط‌پایانه.شناسه ریشه، "dd")
    ص.نگاشت کلید.لغو توالی در انتظار()
    سرچاپ "پس از لغو پیوند:"، ص.هدایت رویداد(خروج)

    ناپایا پیکان‌ها := رابط‌پایانه.نگاشت کلید پیش‌فرض()
    پیکان‌ها.آزادسازی()
    ناپایا ویم := رابط‌پایانه.نگاشت کلید ویم((_ص: رابط‌پایانه.صفحه*، _ر: رابط‌پایانه.رویداد): برگشت نادرست پایان)
    ویم.آزادسازی()
پایان
