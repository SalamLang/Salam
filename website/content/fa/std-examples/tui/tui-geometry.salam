// زبان: فارسی
واردسازی رابط‌پایانه

تابع ریشه:
    کادر := رابط‌پایانه.مستطیل { ایکس = 2، ایگرگ = 1، عرض = 10، ارتفاع = 4 }
    سرچاپ "راست"، کادر.راست()، "پایین"، کادر.پایین()، "خالی"، کادر.خالی است()
    سرچاپ "شامل 5,2:"، کادر.دربرمی‌گیرد(رابط‌پایانه.نقطه { ایکس = 5، ایگرگ = 2 })
    دیگری := رابط‌پایانه.مستطیل { ایکس = 8، ایگرگ = 3، عرض = 6، ارتفاع = 6 }
    سرچاپ "هم‌پوشانی دارد:"، کادر.هم‌پوشانی دارد(دیگری)
    مشترک := کادر.اشتراک(دیگری)
    سرچاپ "بخش مشترک"، مشترک.ایکس، مشترک.ایگرگ، مشترک.عرض، مشترک.ارتفاع
    میانه := کادر.مرکز()
    سرچاپ "مرکز"، میانه.ایکس، میانه.ایگرگ

    ناپایا جعبه‌ها := وکتور {} برگردان وکتور<رابط‌پایانه.مستطیل>
    جعبه‌ها.بیفزا(رابط‌پایانه.مستطیل { ایکس = 0، ایگرگ = 10، عرض = 4، ارتفاع = 1 })
    جعبه‌ها.بیفزا(رابط‌پایانه.مستطیل { ایکس = 20، ایگرگ = 1، عرض = 4، ارتفاع = 1 })
    سرچاپ "راست:"، رابط‌پایانه.نزدیک‌ترین(کادر، جعبه‌ها، رابط‌پایانه.جهت راست)، "پایین:"، رابط‌پایانه.نزدیک‌ترین(کادر، جعبه‌ها، رابط‌پایانه.جهت پایین)
    سرچاپ "بالا:"، رابط‌پایانه.نزدیک‌ترین(کادر، جعبه‌ها، رابط‌پایانه.جهت بالا)، "چپ:"، رابط‌پایانه.نزدیک‌ترین(کادر، جعبه‌ها، رابط‌پایانه.جهت چپ)
پایان
