// زبان: فارسی
واردسازی رشته
واردسازی رابط‌پایانه

تابع نمایش(دنباله: رشته): رشته:
    برگشت رشته.جایگزینی(دنباله، "\x1b"، "ESC")
پایان

تابع ریشه:
    سرچاپ نمایش(رابط‌پایانه.دنباله رنگ پیش‌زمینه(رابط‌پایانه.قرمز))، نمایش(رابط‌پایانه.دنباله رنگ پس‌زمینه(رابط‌پایانه.آبی))
    نارنجی := رابط‌پایانه.رنگ.آرجی‌بی(255، 128، 0)
    سرچاپ "رنگ حقیقی:"، نمایش(رابط‌پایانه.دنباله پیش‌زمینه در سطح(نارنجی، رابط‌پایانه.سطح‌رنگ.رنگ حقیقی))
    سرچاپ "256 رنگ:"، نمایش(رابط‌پایانه.دنباله پیش‌زمینه در سطح(نارنجی، رابط‌پایانه.سطح‌رنگ.نمایه‌ای۲۵۶))
    سرچاپ "16 رنگ:"، نمایش(رابط‌پایانه.دنباله پس‌زمینه در سطح(نارنجی، رابط‌پایانه.سطح‌رنگ.انسی۱۶))
    سرچاپ "بی‌رنگ:"، نمایش(رابط‌پایانه.دنباله پیش‌زمینه در سطح(نارنجی، رابط‌پایانه.سطح‌رنگ.خاموش))
    سرچاپ "کاهش‌یافته:"، رابط‌پایانه.کاهش سطح رنگ(رابط‌پایانه.رنگ.نمایه‌ای(196)، رابط‌پایانه.سطح‌رنگ.انسی۱۶) برابر رابط‌پایانه.قرمز روشن
    سرچاپ "رنگ‌ها:"، رابط‌پایانه.مشکی نابرابر رابط‌پایانه.سفید، رابط‌پایانه.سبز نابرابر رابط‌پایانه.سبز روشن، رابط‌پایانه.زرد نابرابر رابط‌پایانه.ارغوانی، رابط‌پایانه.فیروزه‌ای نابرابر رابط‌پایانه.فیروزه‌ای روشن
    سرچاپ "روشن‌ها:"، رابط‌پایانه.مشکی روشن نابرابر رابط‌پایانه.زرد روشن، رابط‌پایانه.آبی روشن نابرابر رابط‌پایانه.ارغوانی روشن، رابط‌پایانه.سفید روشن نابرابر رابط‌پایانه.رنگ.پیش‌فرض
    سرچاپ "سطح پایانه معلوم است:"، رابط‌پایانه.تشخیص سطح رنگ() برابر رابط‌پایانه.تشخیص سطح رنگ()

    پایه := رابط‌پایانه.ظاهر { رنگ پیش‌زمینه = رابط‌پایانه.سبز، پررنگ = درست }
    رویی := رابط‌پایانه.ظاهر { رنگ پس‌زمینه = رابط‌پایانه.مشکی، زیرخط = درست }
    هردو := رابط‌پایانه.ادغام ظاهر(پایه، رویی)
    سرچاپ "ادغام، پررنگ را نگه می‌دارد:"، هردو.پررنگ، "و زیرخط را:"، هردو.زیرخط
    سرچاپ "برابر پیش‌فرض:"، رابط‌پایانه.برابری ظاهر(رابط‌پایانه.ظاهر پیش‌فرض، رابط‌پایانه.ظاهر {})
    سرچاپ "روشن:"، نمایش(رابط‌پایانه.دنباله فعال‌سازی ظاهر(هردو، رابط‌پایانه.سطح‌رنگ.انسی۱۶))، "خاموش:"، نمایش(رابط‌پایانه.دنباله غیرفعال‌سازی ظاهر(هردو، رابط‌پایانه.سطح‌رنگ.انسی۱۶))
    سرچاپ "ضخامت قاب:"، رابط‌پایانه.ضخامت کادر(رابط‌پایانه.سبک‌کادر.تک خط)، رابط‌پایانه.ضخامت کادر(رابط‌پایانه.سبک‌کادر.بدون کادر)
    سرچاپ "ظاهرهای ساخته‌شده:"، رابط‌پایانه.شمار ساخت اس‌جی‌آر() بزرگتر 0
    ناپایا وارون := رابط‌پایانه.ظاهر { کم‌رنگ = درست، کج = درست }
    وارون.معکوس = درست
    _ := وارون
پایان
