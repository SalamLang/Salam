// زبان: فارسی
واردسازی پایانه
واردسازی رابط‌پایانه

ناپایا ثانیه‌ها := 0

ساختار ساعت:
    همگانی شامل رابط‌پایانه.ویجت‌پایه

    همگانی تابع ترسیم(بافر: رابط‌پایانه.بافر، مرز: رابط‌پایانه.مستطیل):
        بافر.نوشتن متن(مرز.ایکس + 1، مرز.ایگرگ، "در حال اجرا از " + ثانیه‌ها + " ثانیه پیش، q برای خروج"، رابط‌پایانه.ظاهر پیش‌فرض)
    پایان

    همگانی تابع پردازش رویداد(رویداد: رابط‌پایانه.رویداد): منطقی:
        اگر رویداد.نویسه است("q"):
            برگشت نادرست
        پایان
        برگشت رویداد.نوع برابر رابط‌پایانه.رویداد ماوس
    پایان
پایان

تابع ریشه:
    اگر وارونه پایانه.پایانه دارد():
        نادرست‌سرچاپ "به یک پایانه نیاز دارد"
        برگشت 1
    پایان
    ناپایا ص := رابط‌پایانه.صفحه ترمینال جدید(ساعت {})
    ص.بازه تیک به میلی‌ثانیه = 1000
    ص.گزارش ماوس = درست
    ص.گزارش حرکت ماوس = نادرست
    ص.تنظیم نویسه‌ها(رابط‌پایانه.سیاست‌نویسه‌ها.یونیکد)
    ص.آغاز()
    دیرکن ص.بستن()
    ص.اجرا با تیک((): ثانیه‌ها++ پایان)
    سرچاپ "پایش هر"، رابط‌پایانه.بازه پایش به میلی‌ثانیه، "میلی‌ثانیه، صف با ظرفیت"، رابط‌پایانه.ظرفیت رویداد، "در حال اجرا:"، ص.در حال اجرا
    برگشت 0
