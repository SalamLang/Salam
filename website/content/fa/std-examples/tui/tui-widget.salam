// زبان: فارسی
واردسازی پایانه
واردسازی رابط‌پایانه

ساختار شمارنده:
    همگانی شامل رابط‌پایانه.ویجت‌پایه
    همگانی شمار: صحیح = 0

    همگانی تابع تمرکز‌پذیر است(): منطقی:
        برگشت درست
    پایان

    همگانی تابع پردازش رویداد(رویداد: رابط‌پایانه.رویداد): منطقی:
        اگر رویداد.نویسه است("+"):
            این.شمار++
            برگشت درست
        پایان
        برگشت نادرست
    پایان

    همگانی تابع ترسیم(بافر: رابط‌پایانه.بافر، مرز: رابط‌پایانه.مستطیل):
        ناپایا ظاهر := رابط‌پایانه.ظاهر پیش‌فرض
        اگر بافر.در تمرکز:
            ظاهر.معکوس = درست
        پایان
        بافر.نوشتن متن(مرز.ایکس، مرز.ایگرگ، "شمار " + این.شمار، ظاهر)
    پایان
پایان

تابع ریشه:
    پایه := رابط‌پایانه.ویجت‌پایه {}
    سرچاپ "پیش‌فرض‌ها:"، پایه.تمرکز‌پذیر است()، پایه.اصابت‌پذیر است()، پایه.نمایان است()، پایه.اندازه ترجیحی(10).عرض
    سنجش := پایه.اندازه‌گیری(رابط‌پایانه.محور.محور افقی، 10)
    سرچاپ "اندازه‌گیری:"، سنجش.معتبر

    ناپایا درخت := رابط‌پایانه.درخت جدید(رابط‌پایانه.ویجت‌پایه {} برگردان پویا رابط‌پایانه.ویجت)
    شناسه := درخت.افزودن(رابط‌پایانه.شناسه ریشه، شمارنده {} برگردان پویا رابط‌پایانه.ویجت)
    سرچاپ "درخت:"، درخت.تعداد()، درخت.معتبر است(شناسه)، درخت.والد(شناسه) برابر رابط‌پایانه.شناسه ریشه، درخت.معتبر است(رابط‌پایانه.بدون ویجت)
    بعلاوه := رابط‌پایانه.رویداد { نوع = رابط‌پایانه.رویداد کیبورد، کلید = پایانه.رمزگشایی("+") }
    سرچاپ "پردازش توسط خودش:"، درخت.هدایت رویداد(شناسه، بعلاوه) برابر شناسه
    ویجت := درخت.دریافت(شناسه)
    ویجت.تنظیم محدوده(رابط‌پایانه.مستطیل { عرض = 10، ارتفاع = 1 })
    ناپایا بافر := رابط‌پایانه.بافر جدید(10، 1)
    ویجت.ترسیم(بافر، ویجت.محدوده())
    سرچاپ بافر.متن ردیف(0)
    بافر.آزادسازی()
    درخت.آزادسازی()
    _ := پایه.مستطیل
پایان
