واردسازی دام
واردسازی وب.مرورگر

ناپایا پاسخ := "در انتظار"
ناپایا شمار := ۰

تابع پاسخ رسید(وضعیت: صحیح، متن: رشته):
    اگر وضعیت برابر ۲۰۰:
        پاسخ = متن
    وگرنه:
        دام.تنظیم مهلت((): بپرس() پایان، ۲۰۰۰)
    پایان
پایان

تابع بپرس():
    شمار++
    مرورگر.دریافت("https://example.com/chat/latest"، ۵۰۰۰، (وضعیت: صحیح، متن: رشته): پاسخ رسید(وضعیت، متن) پایان)
پایان

تابع حذف شد(وضعیت: صحیح، متن: رشته):
    پاسخ = وضعیت + " " + متن
پایان

تابع پاک کن():
    مرورگر.درخواست("DELETE"، "https://example.com/chat/latest"، ""، ""، ۵۰۰۰، (وضعیت: صحیح، متن: رشته): حذف شد(وضعیت، متن) پایان)
پایان

تابع کپی پیوند():
    مرورگر.کپی متن("https://example.com/chat")
پایان

صفحه:
    عنوان = "گفتگو"
    جعبه:
        دکمه:
            محتوا = "شروع"
            کلیک = (): بپرس() پایان
        پایان
        دکمه:
            محتوا = "کپی پیوند"
            کلیک = (): کپی پیوند() پایان
        پایان
        دکمه:
            محتوا = "حذف"
            کلیک = (): پاک کن() پایان
        پایان
        پاراگراف:
            محتوا = شمار + ": " + پاسخ
        پایان
    پایان
پایان
