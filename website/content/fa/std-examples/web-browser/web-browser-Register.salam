واردسازی کدگذاری.جیسون
واردسازی وب.مرورگر

ناپایا نام := ""
ناپایا معرف := مرورگر.پارامتر نشانی("ref")
ناپایا پیام := ""
ناپایا مشغول := نادرست

تابع ثبت شد(وضعیت: صحیح، متن: رشته):
    مشغول = نادرست
    اگر وضعیت برابر ۰:
        پیام = "سرور در دسترس نبود"
    وگرنه وضعیت بزرگتربرابر ۲۰۰ و وضعیت کوچکتر ۳۰۰:
        پیام = "ثبت نام انجام شد"
    وگرنه:
        پیام = "درخواست با وضعیت " + وضعیت + " رد شد: " + متن
    پایان
پایان

تابع کپی شد(انجام شد: منطقی):
    اگر وارونه انجام شد:
        پیام = "کپی کردن این‌جا مجاز نیست"
    پایان
پایان

تابع ارسال():
    مشغول = درست
    پیام = "در حال ارسال"
    داده := "{\"name\": " + جیسون.رشته جیسون(نام) + ", \"ref\": " + جیسون.رشته جیسون(معرف) + "}"
    مرورگر.ارسال جیسون("https://example.com/registrations"، داده، ۱۵۰۰۰، (وضعیت: صحیح، متن: رشته): ثبت شد(وضعیت، متن) پایان)
پایان

صفحه:
    عنوان = "ثبت نام"
    جعبه:
        ورودی:
            نوع = «متن»
            جانگهدار = "نام شما"
            پیوند = نام
        پایان
        دکمه:
            محتوا = "ثبت نام"
            غیرفعال = مشغول
            کلیک = (): ارسال() پایان
        پایان
        دکمه:
            محتوا = "کپی پاسخ"
            کلیک = (): مرورگر.کپی متن(پیام، (انجام شد: منطقی): کپی شد(انجام شد) پایان) پایان
        پایان
        پاراگراف:
            محتوا = پیام
        پایان
    پایان
پایان
