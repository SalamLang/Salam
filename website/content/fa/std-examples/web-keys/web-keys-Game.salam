واردسازی دام
واردسازی وب.بوم
واردسازی وب.کلیدها

ناپایا ایکس := ۱۶۰.۰
ناپایا امتیاز := ۰

تابع ریشه:
    ب := دام.بساز("canvas")
    دام.تنظیم ویژگی(ب، "id"، "game")
    دام.افزودن(دام.بدنه()، ب)
    ز := بوم.دریافت بوم("game")
    کلیدها.آماده سازی()
    کلیدها.پیگیری("a")
    کلیدها.پیگیری("d")
    دام.چرخش فریم((زمان: اعشار۶۴):
        اگر کلیدها.نگه داشته("ArrowLeft") یا کلیدها.نگه داشته("a"):
            ایکس -= ۴
        پایان
        اگر کلیدها.نگه داشته("ArrowRight") یا کلیدها.نگه داشته("d"):
            ایکس += ۴
        پایان
        اگر کلیدها.فشرده شد(" "):
            امتیاز += ۱
        پایان
        بوم.پاک کردن مستطیل(ز، ۰، ۰، بوم.عرض(ز)، بوم.ارتفاع(ز))
        بوم.پرکردن مستطیل(ز، ایکس - ۱۰، ۱۰۰، ۲۰، ۲۰)
        بوم.پرکردن متن(ز، "امتیاز: " + امتیاز، ۱۰، ۲۰)
    پایان)
پایان
