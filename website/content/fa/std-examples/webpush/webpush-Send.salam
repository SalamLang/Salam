واردسازی اعلان وب

تابع ریشه:
    ک := اعلان وب.کلیدها از("BLmOwafYGSjiuCX_1RSCO_n0YmacxYMDqitMydKE4A1Wp2qmUuMXg2IM_hzcrmZLun4jEu_lKfVdtnAp0LMK4NE"، "Nhh4m4Va4yhL-53i302044iqeAeMtnOEYlIT2KWRJmg")
    ا := اعلان وب.اشتراک {
        endpoint = "https://fcm.googleapis.com/fcm/send/abc"،
        p256dh = "BCVxsr7N_eNgVRqvHtD0zTZsEc6-VV-JvLexhqUzORcxaOzi6-AYWXvTBHm4bjyPjs7Vd8pZGH6SRpkNtoIAiw4"،
        auth = "BTBZMqHH6r4Tts7J_aSIgg"
    }
    گ := اعلان وب.گزینه‌های جدید("mailto:ali@example.com")
    ن := اعلان وب.ارسال(ک، ا، `{"title":"سلام","body":"پیام تازه دارید"}`، گ)
    اگر ن.ok:
        سرچاپ "فرستاده شد"، ن.status
    وگرنه ن.gone:
        سرچاپ "اشتراک منقضی شده؛ آن را پاک کنید"
    وگرنه:
        سرچاپ "خطا:"، ن.status، ن.error
    پایان
