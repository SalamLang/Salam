واردسازی تزریق

ساختار Conn:
    همگانی id: صحیح = 0
پایان

تابع ریشه:
    c := تزریق.ساخت()
    تزریق.فراهم کردن(c، "Conn"، ""، Conn {}، (_c: تزریق.ظرف): برگشت Conn { id = 7 } پایان)
    تزریق.هنگام بستن(c، "Conn"، Conn {}، (v: Conn): سرچاپ "closing"، v.id پایان)
    ناپایا x := Conn {}
    _ok := تزریق.گرفتن(c، "Conn"، x)
    تزریق.بستن(c)
پایان
