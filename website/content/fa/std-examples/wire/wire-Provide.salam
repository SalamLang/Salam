واردسازی تزریق

تابع ریشه:
    c := تزریق.ساخت()
    تزریق.فراهم کردن(c، "Base"، ""، 0، (_c: تزریق.ظرف): برگشت 10 پایان)
    تزریق.فراهم کردن(c، "Double"، "Base"، 0، (cx: تزریق.ظرف):
        ناپایا b := 0
        _ok := تزریق.گرفتن(cx، "Base"، b)
        برگشت b * 2
    پایان)
    ناپایا d := 0
    اگر تزریق.گرفتن(c، "Double"، d):
        سرچاپ d
    پایان
    تزریق.بستن(c)
پایان
